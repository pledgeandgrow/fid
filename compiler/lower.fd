                            var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(ret_ty, Lowerer_current_region(self)));
                            call_args.insert(0, sret_ptr);
                            Lowerer_emit_inst(self, Inst::Call(callee, call_args, IrType::Void, EffectSet_new()));
                            Lowerer_rc_note_sret(self, sret_ptr, callee);
                            return sret_ptr;
                        }
                        IrType::Array(_, _) => {
                            var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(ret_ty, Lowerer_current_region(self)));
                            call_args.insert(0, sret_ptr);
                            Lowerer_emit_inst(self, Inst::Call(callee, call_args, IrType::Void, EffectSet_new()));
                            Lowerer_rc_note_sret(self, sret_ptr, callee);
                            return sret_ptr;
                        }
                        _ => {
                        }
                    }
                    return Lowerer_emit_inst(self, Inst::Call(callee, call_args, ret_ty, EffectSet_new()));
                }
                Expr::MethodCall(_, method, args) => {
                    // a |> obj.method(args) - a.method(args)  (reference §4.8):
                    // the piped value is the receiver, as the type checker
                    // reads the form. Before, the lowering kept `obj` as the
                    // receiver and added `a` as a first argument
                    return Lowerer_lower_expr(self, Expr::MethodCall(left, method, args));
                }
                Expr::Ident(name) => {
                    // x |> f  -  f(x)
                    var new_args: Vec<Expr> = Vec::new();
                    new_args.push(lw_box_expr_unbox(left));
                    var new_call: Expr = Expr::Call(name, new_args);
                    return Lowerer_lower_expr(self, new_call);
                }
                Expr::FieldAccess(receiver, field) => {
                    // x |> obj.field  -  obj.field(x)  (field is a method name)
                    var new_args: Vec<Expr> = Vec::new();
                    new_args.push(lw_box_expr_unbox(left));
                    var new_call: Expr = Expr::MethodCall(receiver, field, new_args);
                    return Lowerer_lower_expr(self, new_call);
                }
                _ => {
                    // Fallback: just lower left
                    return Lowerer_lower_expr(self, lw_box_expr_unbox(left));
                }
            }
        }
        Expr::QuantCast(e, ty) => {
            // Quantization cast - lower as a real cast to the target type
            var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            var src_ty: IrType = Lowerer_get_value_type(self, val);
            var dst_ir_ty: IrType = Lowerer_lower_type(self, ty);
            return Lowerer_lower_cast(self, val, src_ty, dst_ir_ty);
        }
        Expr::Await(e) => {
            // Await - call p_future_poll
            var fut_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            var args: Vec<i64> = Vec::new();
            args.push(fut_val);
            var polled: i64 = Lowerer_emit_inst(self, Inst::Call("p_future_poll", args, IrType::I64, EffectSet_new()));
            // A future holds a word: give a pointer, an f64 (its bits) or a
            // struct (a pointer to its heap copy) its type back
            var fut_of: OptType = OptType::None;
            // BG46: a future awaited more than once gives every await the
            // same result; each then takes an owner of its own (the task's
            // owner is left, a leak, instead of two owners of one value)
            var aw_again: bool = false;
            match lw_box_expr_unbox(e) {
                Expr::Ident(fut_var) => {
                    aw_again = self.own_on && lw_awaited_again(fut_var);
                }
                _ => {
                }
            }
            // BG200: the future's type for any operand (a call, a variable,
            // an element `fs.get(i)`, an if or a match), not only the first
            // three: anything else got the raw word
            fut_of = Lowerer_await_fut_type(self, lw_box_expr_unbox(e));
            match fut_of {
                OptType::Some(fut_ret) => {
                    match fut_ret {
                        Type::Generic(fname, fargs) => {
                            if fname == "Future" && fargs.len() > 0 {
                                var fut_ty: IrType = Lowerer_lower_type(self, fargs.get(0));
                                // LG14: a generic struct result (`Future<Cell<T>>`)
                                // comes back as a struct's does, in a heap block
                                var aw_gsn: str = Lowerer_task_gstruct(self, fargs.get(0));
                                if str_len(aw_gsn) > 0 {
                                    fut_ty = IrType::Struct(aw_gsn);
                                }
                                match fut_ty {
                                    IrType::Ptr(_) => {
                                        // CA5: the task's result (a str, Vec or map
                                        // its `return` took an owner of) is handed
                                        // to the awaiting statement: a temporary,
                                        // claimed by a let, dropped otherwise (was
                                        // duplicated by the let and leaked)
                                        var aw_v: i64 = Lowerer_lower_cast(self, polled, IrType::I64, fut_ty);
                                        if aw_again {
                                            aw_v = Lowerer_rc_dup(self, aw_v, fargs.get(0));
                                        }
                                        Lowerer_rc_temp(self, aw_v, fargs.get(0));
                                        return aw_v;
                                    }
                                    IrType::F64 => {
                                        var fb: Vec<i64> = Vec::new();
                                        fb.push(polled);
                                        return Lowerer_emit_inst(self, Inst::Call("p_f64_from_bits", fb, IrType::F64, EffectSet_new()));
                                    }
                                    // BG200: an f32 result travels as an f64's
                                    // bits (the async call's p_future_ready);
                                    // the word read as a number gave 2 for 2.5
                                    IrType::F32 => {
                                        var fb32: Vec<i64> = Vec::new();
                                        fb32.push(polled);
                                        var aw_f64: i64 = Lowerer_emit_inst(self, Inst::Call("p_f64_from_bits", fb32, IrType::F64, EffectSet_new()));
                                        return Lowerer_lower_cast(self, aw_f64, IrType::F64, IrType::F32);
                                    }
                                    // BG200: a narrow integer is the word's low
                                    // bits, sign-extended as its type says (an
                                    // i32 -15 read back as 4294967281)
                                    IrType::I8 => {
                                        return Lowerer_lower_cast(self, polled, IrType::I64, fut_ty);
                                    }
                                    IrType::I16 => {
                                        return Lowerer_lower_cast(self, polled, IrType::I64, fut_ty);
                                    }
                                    IrType::I32 => {
                                        return Lowerer_lower_cast(self, polled, IrType::I64, fut_ty);
                                    }
                                    IrType::U8 => {
                                        return Lowerer_lower_cast(self, polled, IrType::I64, fut_ty);
                                    }
                                    IrType::U16 => {
                                        return Lowerer_lower_cast(self, polled, IrType::I64, fut_ty);
                                    }
                                    IrType::U32 => {
                                        return Lowerer_lower_cast(self, polled, IrType::I64, fut_ty);
                                    }
                                    IrType::Struct(_) => {
                                        // Copied out of the task's heap block, which is then freed
                                        var heap: i64 = Lowerer_emit_inst(self, Inst::BitCast(polled, IrType::I64, IrType::Ptr(Box::new(fut_ty))));
                                        var local: i64 = Lowerer_emit_inst(self, Inst::Alloca(fut_ty, Lowerer_current_region(self)));
                                        Lowerer_emit_inst(self, Inst::StructCopy(local, heap, fut_ty));
                                        // BG46: a future awaited again keeps its
                                        // block for the next await (freed here,
                                        // the next one read freed memory)
                                        if !aw_again {
                                            var pf: Vec<i64> = Vec::new();
                                            pf.push(Lowerer_emit_inst(self, Inst::BitCast(polled, IrType::I64, lw_ptr_u8())));
                                            var pfe: EffectSet = EffectSet_new();
                                            EffectSet_add(& mut pfe, Effect::Alloc);
                                            Lowerer_emit_inst(self, Inst::Call("p_free", pf, IrType::Void, pfe));
                                        }
                                        return local;
                                    }
                                    // An array result is the task's heap
                                    // block itself: its pointer is the value
                                    IrType::Array(_, _) => {
                                        return Lowerer_emit_inst(self, Inst::BitCast(polled, IrType::I64, IrType::Ptr(Box::new(fut_ty))));
                                    }
                                    // BG156: a bool result is a bool (the word
                                    // typed i64 printed 1/0 on C)
                                    IrType::Bool => {
                                        var aw_bz: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                                        return Lowerer_emit_inst(self, Inst::BinOp(BinOp::Neq, polled, aw_bz, IrType::Bool));
                                    }
                                    _ => {
                                        // CA5: a Vec or map result (an i64 handle)
                                        // is the awaiting statement's, as above.
                                        // It gets its type back (the p_send_copy
                                        // form): as a plain i64 an unannotated
                                        // `val r = await t` had an i64 slot, and
                                        // `r.get(0)` of a Vec<str> read numbers
                                        var aw_k: i64 = Lowerer_rc_kind(self, fargs.get(0));
                                        if aw_k == RC_VEC || aw_k == RC_MAP {
                                            var aw_h: i64 = polled;
                                            match fut_ty {
                                                IrType::Generic(_, _) => {
                                                    aw_h = Lowerer_emit_inst(self, Inst::BitCast(polled, IrType::I64, fut_ty));
                                                }
                                                _ => {
                                                }
                                            }
                                            if aw_again {
                                                aw_h = Lowerer_rc_dup(self, aw_h, fargs.get(0));
                                            }
                                            Lowerer_rc_temp(self, aw_h, fargs.get(0));
                                            return aw_h;
                                        }
                                    }
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptType::None => {
                }
            }
            return polled;
        }
        Expr::Spawn(e) => {
            // spawn <expr> - create a concurrent task that runs in a real OS thread.
            // If the inner expression is a function call, extract the function name
            // and args, and call p_thread_spawn which creates an OS thread.
            // If it's not a call, fall back to eager evaluation.
            match lw_box_expr_unbox(e) {
                Expr::Call(callee, args) => {
                    // An async task with f64 or struct arguments starts
                    // through its word adapter, as a call to it does (H9)
                    if lw_c_str_vec_contains(self.async_adapted, callee) {
                        return Lowerer_lower_expr(self, lw_box_expr_unbox(e));
                    }
                    // spawn func(args) - p_thread_spawn(func_name, num_args, args...)
                    // BG388: named arguments in parameter order and the
                    // defaults of those left out, as a call has them (the
                    // thread got the arguments as written: a missing one
                    // was garbage, named ones were swapped)
                    var sargs: Vec<Expr> = Lowerer_resolve_call_args(self, callee, args);
                    var svals: Vec<i64> = Vec::new();
                    var ai: i64 = 0;
                    while ai < sargs.len() {
                        svals.push(Lowerer_lower_expr(self, sargs.get(ai)));
                        ai = ai + 1;
                    }
                    return Lowerer_spawn_call(self, callee, sargs, svals);
                }
                _ => {
                    // Non-call spawn - fall back to eager evaluation
                    return Lowerer_lower_expr(self, lw_box_expr_unbox(e));
                }
            }
        }
        Expr::Yield(e) => {
            // yield <expr> - evaluate the inner expression (no-op for now)
            return Lowerer_lower_expr(self, lw_box_expr_unbox(e));
        }
        Expr::NamedArg(name, e) => {
            return Lowerer_lower_expr(self, lw_box_expr_unbox(e));
        }
        Expr::ComptimeReflect(op, ty) => {
            return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        }
        Expr::Asm(template, operands) => {
            // Inline assembly lowering
            var inputs: Vec<StringValueId> = Vec::new();
            var outputs: Vec<StringValueId> = Vec::new();
            // Clobbered registers are passed as inputs with a "CL:" prefix
            // in the name field, and id=-1 (no actual value to load).
            var oi: i64 = 0;
            while oi < operands.len() {
                var op: AsmOperand = operands.get(oi);
                match op.direction {
                    AsmDir::In => {
                        var val: i64 = Lowerer_lower_expr(self, op.expr);
                        inputs.push(StringValueId_new(op.reg, val));
                    }
                    AsmDir::Out => {
                        var val: i64 = Lowerer_lower_expr(self, op.expr);
                        outputs.push(StringValueId_new(op.reg, val));
                    }
                    AsmDir::Clobber => {
                        // Pass clobber regs as inputs with special prefix
                        inputs.push(StringValueId_new("CL:" + op.reg, - 1));
                    }
                }
                oi = oi + 1;
            }
            var ret_ty: IrType = IrType::Void;
            if outputs.len() > 0 {
                ret_ty = IrType::I64;
            }
            return Lowerer_emit_inst(self, Inst::Asm(template, inputs, outputs, ret_ty));
        }
    }
    return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
}

// --- Closure helpers ------------------------------------------------------

/// Find free variables (captures) in a closure body.
/// Returns list of (name, type) tuples for variables that are used but not
/// declared locally or in the closure parameters. The type is looked up from
/// the enclosing scope's alloca types or falls back to I64.
pub fn Lowerer_find_captures(self: & Lowerer, body: Vec<Stmt>, param_names: Vec<str>) -> Vec<StringTypeEntry> {
    var free_vars: Vec<str> = Vec::new();
    var local_names: Vec<str> = Vec::new();
    // Start with param names as locals
    var pi: i64 = 0;
    while pi < param_names.len() {
        local_names.push(param_names.get(pi));
        pi = pi + 1;
    }
    Lowerer_collect_free_vars(self, body, & mut free_vars, & mut local_names);

    // For each free variable, look up its type from the enclosing scope
    var captures: Vec<StringTypeEntry> = Vec::new();
    var fi: i64 = 0;
    while fi < free_vars.len() {
        var name: str = free_vars.get(fi);
        var cap_ty: Type = Type::I64;
        var found: bool = false;
        // The declared type (a variable's, a parameter's)
        var declared: Type = Type::Infer;
        var has_declared: bool = false;
        match Lowerer_lookup_var_ast_type(self, name) {
            OptType::Some(dt) => {
                declared = dt;
                has_declared = true;
            }
            OptType::None => {
                match Lowerer_lookup_param_type(self, name) {
                    OptType::Some(pt) => {
                        declared = pt;
                        has_declared = true;
                    }
                    OptType::None => {
                    }
                }
            }
        }
        // Try to find the type from alloca types
        match Lowerer_lookup_alloca(self, name) {
            OptValueId::Some(alloca_id) => {
                found = true;
                var slot_ir: IrType = IrType::I64;
                match Lowerer_lookup_alloca_type(self, alloca_id) {
                    OptIrType::Some(ir_ty) => {
                        cap_ty = ir_type_to_ast_type(ir_ty);
                        slot_ir = ir_ty;
                    }
                    OptIrType::None => {
                        cap_ty = Type::I64;
                    }
                }
                // the declared type says more than the slot's (a function
                // value's signature, where the slot only says `func`; a str,
                // where the slot says *u8): a call through the capture, and
                // the closure's reads of it, need it. Taken when it is the
                // slot's type, or a function's.
                if has_declared {
                    match Lowerer_resolve_type(self, declared) {
                        Type::Func(_, _) => {
                            cap_ty = declared;
                        }
                        _ => {
                            if ir_type_eq(Lowerer_lower_type(self, declared), slot_ir) {
                                cap_ty = declared;
                            }
                        }
                    }
                }
            }
            OptValueId::None => {
                // A parameter (no slot): its declared type (stdlib-agent-bugs
                // 3: an f64 parameter was read back as an i64)
                match Lowerer_lookup_local(self, name) {
                    OptValueId::Some(lv) => {
                        found = true;
                        // when it is the value's type (a struct parameter is
                        // the struct's address), or a function's
                        if has_declared {
                            var lv_ir: IrType = Lowerer_get_value_type(self, lv);
                            var decl_ir: IrType = Lowerer_lower_type(self, declared);
                            match Lowerer_resolve_type(self, declared) {
                                Type::Func(_, _) => {
                                    cap_ty = declared;
                                }
                                _ => {
                                    if ir_type_eq(decl_ir, lv_ir) || ir_type_eq(IrType::Ptr(Box::new(decl_ir)), lv_ir) {
                                        cap_ty = declared;
                                    }
                                }
                            }
                        }
                    }
                    OptValueId::None => {
                    }
                }
            }
        }
        // What an enclosing closure captured: the type it has there
        if !found {
            var eci: i64 = 0;
            while eci < self.current_captures.len() {
                if self.current_captures.get(eci).name == name {
                    cap_ty = self.current_captures.get(eci).ty;
                    found = true;
                }
                eci = eci + 1;
            }
        }
        // A global is read and written where it is, never copied into the
        // env (stdlib-agent-bugs 37: a closure saw the value the global had
        // when it was made, and its writes were lost)
        var is_global: bool = false;
        if !found {
            match IrModule_get_global(& self.module, name) {
                OptGlobalLookup::Some(_, _) => {
                    is_global = true;
                }
                OptGlobalLookup::None => {
                }
            }
        }
        if !is_global {
            captures.push(StringTypeEntry_new(name, cap_ty));
        }
        fi = fi + 1;
    }
    return captures;
}

/// Whether `name` is a function value of the function being lowered (a
/// variable, a parameter, or one of its own captures, of a function type):
/// a closure that calls it captures it. A value of another type keeps the
/// call a call of the function of that name.
fn Lowerer_is_enclosing_value(self: & Lowerer, name: str) -> bool {
    var is_value: bool = false;
    match Lowerer_lookup_alloca(self, name) {
        OptValueId::Some(slot) => {
            is_value = true;
            match Lowerer_lookup_alloca_type(self, slot) {
                OptIrType::Some(st) => {
                    if ir_type_is_opaque_named(st, "func") || ir_type_is_opaque_named(st, "closure") {
                        return true;
                    }
                }
                OptIrType::None => {
                }
            }
        }
        OptValueId::None => {
        }
    }
    match Lowerer_lookup_local(self, name) {
        OptValueId::Some(_) => {
            is_value = true;
        }
        OptValueId::None => {
        }
    }
    var i: i64 = 0;
    while i < self.current_captures.len() {
        if self.current_captures.get(i).name == name {
            is_value = true;
        }
        i = i + 1;
    }
    if !is_value {
        return false;
    }
    match Lowerer_resolve_type(self, Lowerer_fn_value_type(self, name)) {
        Type::Func(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// The type of function value `name` (a variable, a parameter, or a
/// closure's capture): a Type::Func, or Infer when nothing says.
fn Lowerer_fn_value_type(self: & Lowerer, name: str) -> Type {
    match Lowerer_lookup_var_ast_type(self, name) {
        OptType::Some(vt) => {
            match Lowerer_resolve_type(self, vt) {
                Type::Func(_, _) => {
                    return vt;
                }
                _ => {
                }
            }
        }
        OptType::None => {
        }
    }
    match Lowerer_lookup_param_type(self, name) {
        OptType::Some(pt) => {
            match Lowerer_resolve_type(self, pt) {
                Type::Func(_, _) => {
                    return pt;
                }
                _ => {
                }
            }
        }
        OptType::None => {
        }
    }
    var i: i64 = 0;
    while i < self.current_captures.len() {
        if self.current_captures.get(i).name == name {
            match Lowerer_resolve_type(self, self.current_captures.get(i).ty) {
                Type::Func(_, _) => {
                    return self.current_captures.get(i).ty;
                }
                _ => {
                }
            }
        }
        i = i + 1;
    }
    return Type::Infer;
}

/// Collect free variables from a list of statements.
/// A match arm's free variables: the names its pattern binds are the arm's
/// own while its guard and body are read (stdlib-agent-bugs 28: `n` of
/// `Option::Some(n)` in a closure was taken as a capture, stored as 0 in
/// the env, and the arm read that 0 instead of the payload).
pub fn Lowerer_collect_free_vars_arm(self: & Lowerer, arm: MatchArm, free_vars: & mut Vec<str>, local_names: & mut Vec<str>) {
    var mark: i64 = local_names.len();
    lw_pattern_names(arm.pattern, local_names);
    match arm.guard {
        OptBoxExpr::Some(g) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(g), free_vars, local_names);
        }
        OptBoxExpr::None => {
        }
    }
    Lowerer_collect_free_vars(self, arm.body, free_vars, local_names);
    local_names.truncate(mark);
}

/// The names a pattern binds.
pub fn lw_pattern_names(pat: Pattern, out: & mut Vec<str>) {
    match pat {
        Pattern::Ident(n) => {
            out.push(n);
        }
        Pattern::EnumVariant(_en, _vn, bindings) => {
            var bi: i64 = 0;
            while bi < bindings.len() {
                out.push(bindings.get(bi).name);
                bi = bi + 1;
            }
        }
        _ => {
        }
    }
}

pub fn Lowerer_collect_free_vars(self: & Lowerer, stmts: Vec<Stmt>, free_vars: & mut Vec<str>, local_names: & mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        Lowerer_collect_free_vars_stmt(self, stmts.get(i), free_vars, local_names);
        i = i + 1;
    }
}

/// Collect free variables from a single statement.
pub fn Lowerer_collect_free_vars_stmt(self: & Lowerer, stmt: Stmt, free_vars: & mut Vec<str>, local_names: & mut Vec<str>) {
    match stmt {
        Stmt::Let(name, _ty, expr, _is_mut, _is_persist, _annotations, _line) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
            local_names.push(name);
        }
        Stmt::LetUninit(name, _ty, _annotations, _line) => {
            local_names.push(name);
        }
        Stmt::LetTuple(names, expr, _line, _) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
            var ni: i64 = 0;
            while ni < names.len() {
                local_names.push(names.get(ni));
                ni = ni + 1;
            }
        }
        Stmt::Assign(name, _op, expr, _line) => {
            if !lw_c_str_vec_contains(local_names, name) && !lw_c_str_vec_contains(free_vars, name) {
                free_vars.push(name);
            }
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::IndexAssign(array, index, _op, expr, _line) => {
            if !lw_c_str_vec_contains(local_names, array) && !lw_c_str_vec_contains(free_vars, array) {
                free_vars.push(array);
            }
            Lowerer_collect_free_vars_expr(self, index, free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::DerefAssign(ptr_expr, _op, expr, _line) => {
            Lowerer_collect_free_vars_expr(self, ptr_expr, free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::FieldAssign(object, _field, _op, expr, _line) => {
            Lowerer_collect_free_vars_expr(self, object, free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::Expr(expr, _line) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::Return(expr, _line) => {
            match expr {
                OptBoxExpr::Some(e) => {
                    Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _line) => {
            Lowerer_collect_free_vars_expr(self, cond, free_vars, local_names);
            Lowerer_collect_free_vars(self, then_block, free_vars, local_names);
            match else_block {
                OptStmts::Some(eb) => {
                    Lowerer_collect_free_vars(self, eb, free_vars, local_names);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(cond, body, _line) => {
            Lowerer_collect_free_vars_expr(self, cond, free_vars, local_names);
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
        }
        Stmt::For(fvar, iterator, body, _line) => {
            Lowerer_collect_free_vars_expr(self, iterator, free_vars, local_names);
            // the loop variable is the body's own, not a capture
            var for_mark: i64 = local_names.len();
            local_names.push(fvar);
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
            local_names.truncate(for_mark);
        }
        Stmt::Loop(body, _line) => {
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
        }
        Stmt::Break(expr, _line) => {
            match expr {
                OptBoxExpr::Some(e) => {
                    Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::Defer(body, _line) => {
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
        }
        Stmt::Match(expr, arms, _line) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
            var ai: i64 = 0;
            while ai < arms.len() {
                Lowerer_collect_free_vars_arm(self, arms.get(ai), free_vars, local_names);
                ai = ai + 1;
            }
        }
        _ => {
        }
    }
}

/// Collect free variables from an expression.
pub fn Lowerer_collect_free_vars_expr(self: & Lowerer, expr: Expr, free_vars: & mut Vec<str>, local_names: & mut Vec<str>) {
    match expr {
        Expr::Ident(name) => {
            if !lw_c_str_vec_contains(local_names, name) && !lw_c_str_vec_contains(free_vars, name) {
                free_vars.push(name);
            }
        }
        Expr::IntLit(_) => {
        }
        Expr::FloatLit(_) => {
        }
        Expr::BoolLit(_) => {
        }
        Expr::StringLit(_) => {
        }
        Expr::Binary(_op, left, right) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(right), free_vars, local_names);
        }
        Expr::Unary(_op, operand) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(operand), free_vars, local_names);
        }
        Expr::Call(_callee, args) => {
            // A call of a function value the enclosing function holds (a
            // variable, a parameter, or what it captured itself) captures
            // that value (stdlib-agent-bugs 27)
            if !lw_c_str_vec_contains(local_names, _callee) && !lw_c_str_vec_contains(free_vars, _callee) && Lowerer_is_enclosing_value(self, _callee) {
                free_vars.push(_callee);
            }
            var ai: i64 = 0;
            while ai < args.len() {
                Lowerer_collect_free_vars_expr(self, args.get(ai), free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::FieldAccess(obj, _field) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(obj), free_vars, local_names);
        }
        Expr::OptionalFieldAccess(obj, _field) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(obj), free_vars, local_names);
        }
        Expr::StructLit(_name, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                Lowerer_collect_free_vars_expr(self, fields.get(fi).value, free_vars, local_names);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(e) => {
                    Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::If(cond, then_block, else_block) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(cond), free_vars, local_names);
            Lowerer_collect_free_vars(self, then_block, free_vars, local_names);
            match else_block {
                OptStmts::Some(eb) => {
                    Lowerer_collect_free_vars(self, eb, free_vars, local_names);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Range(start, end, _inclusive) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(start), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(end), free_vars, local_names);
        }
        Expr::Block(stmts) => {
            Lowerer_collect_free_vars(self, stmts, free_vars, local_names);
        }
        Expr::MethodCall(receiver, _method, args) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(receiver), free_vars, local_names);
            var ai: i64 = 0;
            while ai < args.len() {
                Lowerer_collect_free_vars_expr(self, args.get(ai), free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::ArrayLit(_elem_ty, elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                Lowerer_collect_free_vars_expr(self, elements.get(ei), free_vars, local_names);
                ei = ei + 1;
            }
        }
        Expr::Index(arr, idx) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(arr), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(idx), free_vars, local_names);
        }
        Expr::FString(_parts) => {
        }
        Expr::Match(e, arms) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names);
            var ai: i64 = 0;
            while ai < arms.len() {
                Lowerer_collect_free_vars_arm(self, arms.get(ai), free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_enum_name, _variant, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                Lowerer_collect_free_vars_expr(self, args.get(ai), free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::Ref(expr, _is_mut) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(expr), free_vars, local_names);
        }
        Expr::Deref(expr) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(expr), free_vars, local_names);
        }
        Expr::StrConcat(left, right) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(right), free_vars, local_names);
        }
        Expr::Try(e) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names);
        }
        Expr::Coalesce(left, right) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(right), free_vars, local_names);
        }
        Expr::IsCheck(e, _) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names);
        }
        Expr::TryBlock(stmts) => {
            Lowerer_collect_free_vars(self, stmts, free_vars, local_names);
        }
        Expr::TupleLit(elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                Lowerer_collect_free_vars_expr(self, elements.get(ei), free_vars, local_names);
                ei = ei + 1;
            }
        }
        Expr::Closure(_params, _body, _ret_ty) => {
            // What a nested closure uses from outside it is captured here
            // too, so that the nested one can capture it in turn (a closure
            // in a closure calling the outer function's parameter:
            // stdlib-agent-bugs 27). Its own parameters are its locals.
            var inner_locals: Vec<str> = Vec::new();
            var ili: i64 = 0;
            while ili < local_names.len() {
                inner_locals.push(local_names.get(ili));
                ili = ili + 1;
            }
            var ipi: i64 = 0;
            while ipi < _params.len() {
                inner_locals.push(_params.get(ipi).name);
                ipi = ipi + 1;
            }
            Lowerer_collect_free_vars(self, _body, free_vars, & mut inner_locals);
        }
        Expr::Cast(expr, _ty) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(expr), free_vars, local_names);
        }
        Expr::Asm(_template, _args) => {
        }
        Expr::Comptime(e) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names);
        }
        Expr::ComptimeBlock(stmts) => {
            Lowerer_collect_free_vars(self, stmts, free_vars, local_names);
        }
        Expr::ComptimeReflect(_op, _ty) => {
        }
        Expr::PipeForward(left, right) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(right), free_vars, local_names);
        }
        Expr::QuantCast(e, _) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names);
        }
        Expr::Await(e) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names);
        }
        Expr::Spawn(e) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names);
        }
        Expr::Yield(e) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names);
        }
        Expr::NamedArg(name, e) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names);
        }
    }
}

/// Build the __env struct for a closure: malloc, store fn_name at [0],
/// store captures at [1..N], return the env pointer.
// A function value without captures uses one static env per function, the
// module global `__fnenv_<name>` (its field 0 the function, stored at each
// use): an 8-byte heap env that nothing freed was left over by every such
// value (12 one-time blocks in any program that uses `use http`, so none
// passed leak-check's "every block was freed"). iropt's closure
// devirtualization reads this form too (iro_cdev_env_size). false: the heap
// env of before.
const LOWER_STATIC_FN_ENVS: bool = true;

/// Whether `s` is a C identifier's letters (a global's name is used as is).
fn lw_ident_safe(s: str) -> bool {
    var n: i64 = str_len(s);
    if n == 0 {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(s, i);
        var ok: bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
        if !ok {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// --- BG431: the env of a closure variable that is only called -------------
//
// A closure's heap env keeps an owner of each captured str/Vec/map (and a
// heap copy of a captured struct or array), and nothing released an env:
// every capture leaked. A variable bound to a closure literal and then only
// called (no other use of its name in the rest of its block, cowcheck
// cow_uses_stmts: a call `c(..)` names it as the callee, not as a value)
// owns the env: at its scope's end (and on return, break, continue) the
// captures are dropped and the env freed, as an owned slot of the pseudo
// type `__clenv#<n>` (RC_CLOS), n indexing the capture types and how each
// env word is released (g_lw_clenv_tys / g_lw_clenv_modes). A closure that
// escapes (returned, stored, passed, captured) is left as before.
const RC_CLOS: i64 = 6;
/// The heap env made last (Lowerer_make_fn_env), its captures' types and
/// release modes: 0 nothing, 1 a drop of the owned value, 2 the drop of a
/// heap struct copy's fields and the copy freed, 3 the heap copy freed.
var g_lw_env_last: i64 = - 1;
var g_lw_env_fn: str = "";
var g_lw_env_tys: Vec<Type> = Vec::new();
var g_lw_env_modes: Vec<i64> = Vec::new();
var g_lw_clenv_tys: Vec<Vec<Type>> = Vec::new();
var g_lw_clenv_modes: Vec<Vec<i64>> = Vec::new();
var g_lw_clenv_ix: i64 = 0;

/// BG431: `val name = <closure>` lowered to env `v`, kept in `slot`: the
/// slot owns the env when the closure only gets called in the rest of its
/// block and some capture needs releasing.
fn Lowerer_rc_note_closure_var(self: & mut Lowerer, name: str, expr: Expr, v: i64, slot: i64) {
    if !self.own_on || g_lw_env_last < 0 || v != g_lw_env_last || g_lw_env_fn != self.current_func.name {
        return;
    }
    match expr {
        Expr::Closure(_, _, _) => {
        }
        _ => {
            return;
        }
    }
    var need: bool = false;
    var mi: i64 = 0;
    while mi < g_lw_env_modes.len() {
        if g_lw_env_modes.get(mi) != 0 {
            need = true;
        }
        mi = mi + 1;
    }
    if !need {
        return;
    }
    // the rest of the let's own statement list is known
    var fd: i64 = self.fr_lists.len();
    if fd == 0 || fd != self.fr_idx.len() {
        return;
    }
    var cur: Vec<Stmt> = self.fr_lists.get(fd - 1);
    var at: i64 = self.fr_idx.get(fd - 1);
    if at < 0 || at >= cur.len() {
        return;
    }
    match cur.get(at) {
        Stmt::Let(ln, _, _, _, _, _, _) => {
            if ln != name {
                return;
            }
        }
        _ => {
            return;
        }
    }
    if self.cur_has_defer {
        return;
    }
    var rest: Vec<Stmt> = Vec::new();
    var ri: i64 = at + 1;
    while ri < cur.len() {
        rest.push(cur.get(ri));
        ri = ri + 1;
    }
    if cow_uses_stmts(rest, name) != 0 {
        return;
    }
    if g_lw_clenv_ix == 0 {
        g_lw_clenv_ix = HashMap_new();
    }
    var key: str = "__clenv#" + int_to_str(g_lw_clenv_tys.len());
    HashMap_insert(g_lw_clenv_ix, key, g_lw_clenv_tys.len() + 1);
    g_lw_clenv_tys.push(g_lw_env_tys);
    g_lw_clenv_modes.push(g_lw_env_modes);
    g_lw_env_last = - 1;
    Lowerer_rc_add_slot(self, slot, Type::Named(key));
}

/// BG431: release closure env `v` of pseudo type `t` (`__clenv#<n>`): each
/// capture as its mode says, then the env block; nothing for a null env.
fn Lowerer_rc_drop_env(self: & mut Lowerer, v: i64, t: Type) {
    var key: str = "";
    match t {
        Type::Named(kn) => {
            key = kn;
        }
        _ => {
            return;
        }
    }
    if g_lw_clenv_ix == 0 {
        return;
    }
    var at: i64 = HashMap_get(g_lw_clenv_ix, key) - 1;
    if at < 0 || at >= g_lw_clenv_tys.len() {
        return;
    }
    var tys: Vec<Type> = g_lw_clenv_tys.get(at);
    var modes: Vec<i64> = g_lw_clenv_modes.get(at);
    var ev: i64 = Lowerer_rc_as_i64(self, v);
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var is_null: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, ev, zero, IrType::Bool));
    var free_b: i64 = Lowerer_new_block(self);
    var done_b: i64 = Lowerer_new_block(self);
    Lowerer_emit_terminator(self, Inst::Branch(is_null, done_b, free_b));
    Lowerer_set_current_block(self, free_b);
    var feff: EffectSet = EffectSet_new();
    EffectSet_add(& mut feff, Effect::Alloc);
    var i: i64 = 0;
    while i < modes.len() && i < tys.len() {
        var mode: i64 = modes.get(i);
        if mode != 0 {
            var wp: i64 = Lowerer_rc_word_ptr(self, ev, 8 * (i + 1));
            var w: i64 = Lowerer_emit_inst(self, Inst::Load(wp, IrType::I64));
            if mode == 1 {
                Lowerer_rc_drop(self, w, tys.get(i));
            } else {
                if mode == 2 {
                    Lowerer_rc_call_mem(self, "__own_drop_", w, tys.get(i));
                }
                var fa: Vec<i64> = Vec::new();
                fa.push(Lowerer_emit_inst(self, Inst::BitCast(w, IrType::I64, lw_ptr_u8())));
                Lowerer_emit_inst(self, Inst::Call("p_free", fa, IrType::Void, feff));
            }
        }
        i = i + 1;
    }
    var efa: Vec<i64> = Vec::new();
    efa.push(Lowerer_emit_inst(self, Inst::BitCast(ev, IrType::I64, lw_ptr_u8())));
    Lowerer_emit_inst(self, Inst::Call("p_free", efa, IrType::Void, feff));
    Lowerer_emit_terminator(self, Inst::Jump(done_b));
    Lowerer_set_current_block(self, done_b);
}

/// BG384: a heap copy of the fixed array `v` (its data's address, of array
/// type `aty`): the value a container keeps (closure env, enum payload,
/// struct field), so it outlives the frame the array was made in.
fn Lowerer_arr_heap_copy(self: & mut Lowerer, v: i64, aty: IrType) -> i64 {
    var size: i64 = IrModule_type_size(& self.module, aty);
    if size < 8 {
        size = 8;
    }
    var ma: Vec<i64> = Vec::new();
    ma.push(Lowerer_emit_inst(self, Inst::ConstInt(size, IrType::I64)));
    var aeff: EffectSet = EffectSet_new();
    EffectSet_add(& mut aeff, Effect::Alloc);
    var raw: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", ma, lw_ptr_u8(), aeff));
    var heap: i64 = Lowerer_emit_inst(self, Inst::BitCast(raw, lw_ptr_u8(), IrType::Ptr(Box::new(aty))));
    Lowerer_emit_inst(self, Inst::StructCopy(heap, v, aty));
    return heap;
}

/// BG384: whether `t` is a pointer to a fixed array (an array value).
fn lw_ir_is_array_ptr(t: IrType) -> bool {
    match t {
        IrType::Ptr(pin) => {
            match box_ir_type_unbox(pin) {
                IrType::Array(_, _) => {
                    return true;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// BG369: whether a value of IR type `t` is an array's elements' address:
/// a pointer to an array, or an array-typed word (a `[T; N]` field read).
fn lw_ir_is_array_val(t: IrType) -> bool {
    match t {
        IrType::Array(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return lw_ir_is_array_ptr(t);
}

/// What pointer type `t` points to (`t` itself when it is no pointer).
fn lw_ir_ptr_inner(t: IrType) -> IrType {
    match t {
        IrType::Ptr(pin) => {
            return box_ir_type_unbox(pin);
        }
        _ => {
        }
    }
    return t;
}

pub fn Lowerer_make_fn_env(self: & mut Lowerer, fn_name: str, captures: Vec<StringTypeEntry>) -> i64 {
    // BG431: no env of this call is known yet
    g_lw_env_last = - 1;
    if LOWER_STATIC_FN_ENVS && captures.len() == 0 && lw_ident_safe(fn_name) {
        val gname: str = "__fnenv_" + fn_name;
        if IrModule_global_pos(& self.module, gname) < 0 {
            self.module.globals.push(GlobalEntry_new(gname, IrType::I64, Expr::IntLit(0)));
        }
        var genv: i64 = Lowerer_emit_inst(self, Inst::GlobalAddr(gname, IrType::I64));
        var gfn: i64 = Lowerer_emit_inst(self, Inst::ConstFnRef(fn_name));
        var gzero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        var gfield0: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(genv, gzero, IrType::I64));
        var _gs: i64 = Lowerer_emit_inst(self, Inst::Store(gfield0, gfn, OptIrType::None));
        Lowerer_set_value_type(self, genv, IrType::Opaque("closure"));
        return genv;
    }
    var env_size: i64 = (1 + captures.len()) * 8;
    var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(env_size, IrType::I64));
    var malloc_args: Vec<i64> = Vec::new();
    malloc_args.push(size_val);
    var env_ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", malloc_args, IrType::Ptr(Box::new(IrType::U8)), EffectSet_new()));

    // Store function reference at field 0
    // ConstFnRef stores the function name; PE emitter resolves it to a code address,
    // interpreter/C codegen treat it as a string for name-based lookup.
    var fn_name_val: i64 = Lowerer_emit_inst(self, Inst::ConstFnRef(fn_name));
    var zero_idx: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var field0: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(env_ptr, zero_idx, IrType::I64));
    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(field0, fn_name_val, OptIrType::None));

    // BG431: how each env word is released (Lowerer_rc_note_closure_var)
    var env_tys: Vec<Type> = Vec::new();
    var env_modes: Vec<i64> = Vec::new();
    // Store captures at fields 1..N
    var ci: i64 = 0;
    while ci < captures.len() {
        var cap_name: str = captures.get(ci).key;
        var cap_mode: i64 = 0;
        // Lower the capture value from enclosing scope
        var cap_val: i64 = Lowerer_lower_expr(self, Expr::Ident(cap_name));
        // A closure may outlive the scope it was made in: it keeps an owner
        // of a captured string, Vec or map (proposal 0004)
        // S4: the declared type decides (the capture's type comes from its
        // slot, and a str slot reads back as a plain pointer, so a captured
        // str was not given an owner and was read after its scope freed it)
        var cap_own_ty: Type = captures.get(ci).val;
        match Lowerer_lookup_var_ast_type(self, cap_name) {
            OptType::Some(cdt) => {
                cap_own_ty = cdt;
            }
            OptType::None => {
            }
        }
        var cap_k: i64 = Lowerer_rc_kind(self, cap_own_ty);
        if self.own_on && cap_k != RC_NONE && cap_k != RC_MEM {
            cap_val = Lowerer_rc_dup(self, cap_val, cap_own_ty);
            cap_mode = 1;
        }
        // A struct (or enum) is kept by value: a copy on the heap whose
        // fields have one more owner each, as the closure may outlive the
        // struct it was made from (stdlib-agent-bugs 28: the env kept the
        // address of the maker's struct, and its Vec was read after it was
        // freed). The closure reads the capture as that struct's address.
        match Lowerer_lower_type(self, captures.get(ci).val) {
            IrType::Struct(csn) => {
                match IrModule_get_struct(& self.module, csn) {
                    OptStructLayout::Some(clay) => {
                        var csize: i64 = clay.size;
                        if csize < 8 {
                            csize = 8;
                        }
                        var cma: Vec<i64> = Vec::new();
                        cma.push(Lowerer_emit_inst(self, Inst::ConstInt(csize, IrType::I64)));
                        var ceff: EffectSet = EffectSet_new();
                        EffectSet_add(& mut ceff, Effect::Alloc);
                        var craw: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", cma, lw_ptr_u8(), ceff));
                        var cheap: i64 = Lowerer_emit_inst(self, Inst::BitCast(craw, lw_ptr_u8(), IrType::Ptr(Box::new(IrType::Struct(csn)))));
                        Lowerer_emit_inst(self, Inst::Store(cheap, cap_val, OptIrType::Some(IrType::Struct(csn))));
                        cap_mode = 3;
                        if self.own_on && cap_k == RC_MEM {
                            Lowerer_rc_call_mem(self, "__own_dup_", cheap, cap_own_ty);
                            cap_mode = 2;
                        }
                        cap_val = cheap;
                    }
                    OptStructLayout::None => {
                    }
                }
            }
            _ => {
            }
        }
        // BG384: a captured fixed array is kept by value too, a heap copy
        // (the env kept the address of the maker's array, read after the
        // maker returned: garbage on C and the native backends). The
        // closure reads the capture as the array's address, as before.
        match Lowerer_lower_type(self, cap_own_ty) {
            IrType::Array(_, _) => {
                cap_val = Lowerer_arr_heap_copy(self, cap_val, Lowerer_lower_type(self, cap_own_ty));
                cap_mode = 3;
            }
            _ => {
            }
        }
        env_tys.push(cap_own_ty);
        env_modes.push(cap_mode);
        var idx: i64 = Lowerer_emit_inst(self, Inst::ConstInt(ci + 1, IrType::I64));
        var field: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(env_ptr, idx, IrType::I64));
        // a float capture is stored as a float: an untyped store to the
        // i64 slot converted 3.0 to the integer 3 in C, and the closure
        // (which reads the slot as a double) got a denormal near 0
        var cap_store_ty: OptIrType = OptIrType::None;
        match Lowerer_lower_type(self, cap_own_ty) {
            IrType::F64 => {
                cap_store_ty = OptIrType::Some(IrType::F64);
            }
            IrType::F32 => {
                cap_store_ty = OptIrType::Some(IrType::F32);
            }
            _ => {
            }
        }
        var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(field, cap_val, cap_store_ty));
        ci = ci + 1;
    }

    Lowerer_set_value_type(self, env_ptr, IrType::Opaque("closure"));
    g_lw_env_last = env_ptr;
    g_lw_env_fn = self.current_func.name;
    g_lw_env_tys = env_tys;
    g_lw_env_modes = env_modes;
    return env_ptr;
}

// --- CA8: timeout blocks ---------------------------------------------------
//
// `timeout(ms) { body }` parses to `if __timeout_block(ms) { body }`
// (parser parse_timeout_stmt). The body always runs, with a token of its own
// installed in the running task's token slot (`p_task_token` /
// `p_task_set_token`: a word of the task in each runtime, the thread's own
// outside tasks), so the waits inside it that respect cancellation
// (stdlib/task.fd) find it without being handed it. The token is three
// words: [cancelled (0/1)][deadline, ms on p_clock_mono_ms's clock][the token
// the slot held before: the enclosing block's, or 0]. Leaving the block, at
// its end or by return, break, continue or `?`, puts the old token back and
// frees this one; the block's token is not to be kept past its block.

/// Is `cond` the marker of a timeout block?
fn lw_is_timeout_block(cond: Expr) -> bool {
    match cond {
        Expr::Call(cn, cargs) => {
            return cn == "__timeout_block" && cargs.len() == 1;
        }
        _ => {
        }
    }
    return false;
}

/// The time expression of a timeout block's marker.
fn lw_timeout_ms(cond: Expr) -> Expr {
    match cond {
        Expr::Call(_cn, cargs) => {
            if cargs.len() > 0 {
                return cargs.get(0);
            }
        }
        _ => {
        }
    }
    return Expr::IntLit(0);
}

/// A runtime call of the timeout blocks: never merged, moved or dropped
/// (it reads the clock or another task's writes, or changes the slot).
fn Lowerer_to_call(self: & mut Lowerer, name: str, args: Vec<i64>, ret: IrType) -> i64 {
    var eff: EffectSet = EffectSet_new();
    EffectSet_add(& mut eff, Effect::IO);
    EffectSet_add(& mut eff, Effect::Write);
    return Lowerer_emit_inst(self, Inst::Call(name, args, ret, eff));
}

/// The address of word `off` (bytes) of token `tok`.
fn Lowerer_to_word(self: & mut Lowerer, tok: i64, off: i64) -> i64 {
    var o: i64 = Lowerer_emit_inst(self, Inst::ConstInt(off, IrType::I64));
    return Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, tok, o, IrType::I64));
}

/// Make the block's token (deadline `ms` from now), install it, and keep
/// the token it replaces in its third word. Returns the token (i64).
fn Lowerer_to_enter(self: & mut Lowerer, ms_in: i64) -> i64 {
    var ms_ty: IrType = Lowerer_get_value_type(self, ms_in);
    var ms: i64 = Lowerer_lower_cast(self, ms_in, ms_ty, IrType::I64);
    var sz: i64 = Lowerer_emit_inst(self, Inst::ConstInt(24, IrType::I64));
    var raw: i64 = Lowerer_to_call(self, "p_malloc", lw_c_vec1_i64(sz), lw_ptr_u8());
    var tok: i64 = Lowerer_emit_inst(self, Inst::BitCast(raw, lw_ptr_u8(), IrType::I64));
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    Lowerer_to_call(self, "p_atomic_store", c_vec2_i64(tok, zero), IrType::Void);
    var no_args: Vec<i64> = Vec::new();
    var now: i64 = Lowerer_to_call(self, "p_clock_mono_ms", no_args, IrType::I64);
    var dl: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, now, ms, IrType::I64));
    var dl_at: i64 = Lowerer_to_word(self, tok, 8);
    Lowerer_to_call(self, "p_atomic_store", c_vec2_i64(dl_at, dl), IrType::Void);
    var prev: i64 = Lowerer_to_call(self, "p_task_set_token", lw_c_vec1_i64(tok), IrType::I64);
    var prev_at: i64 = Lowerer_to_word(self, tok, 16);
    Lowerer_to_call(self, "p_atomic_store", c_vec2_i64(prev_at, prev), IrType::Void);
    return tok;
}

/// Put back the token `tok` replaced and free `tok`.
fn Lowerer_to_restore(self: & mut Lowerer, tok: i64) {
    var prev_at: i64 = Lowerer_to_word(self, tok, 16);
    var parent: i64 = Lowerer_to_call(self, "p_atomic_load", lw_c_vec1_i64(prev_at), IrType::I64);
    Lowerer_to_call(self, "p_task_set_token", lw_c_vec1_i64(parent), IrType::I64);
    var fp: i64 = Lowerer_emit_inst(self, Inst::BitCast(tok, IrType::I64, lw_ptr_u8()));
    Lowerer_to_call(self, "p_free", lw_c_vec1_i64(fp), IrType::Void);
}

/// The end of the block: whether it ran past its deadline (or its token was
/// cancelled), as a bool; then the old token goes back.
fn Lowerer_to_leave(self: & mut Lowerer, tok: i64) -> i64 {
    var c: i64 = Lowerer_to_call(self, "p_atomic_load", lw_c_vec1_i64(tok), IrType::I64);
    var dl_at: i64 = Lowerer_to_word(self, tok, 8);
    var dl: i64 = Lowerer_to_call(self, "p_atomic_load", lw_c_vec1_i64(dl_at), IrType::I64);
    var no_args: Vec<i64> = Vec::new();
    var now: i64 = Lowerer_to_call(self, "p_clock_mono_ms", no_args, IrType::I64);
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var cancelled: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Neq, c, zero, IrType::Bool));
    var late: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::GtEq, now, dl, IrType::Bool));
    var hit: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Or, cancelled, late, IrType::Bool));
    Lowerer_to_restore(self, tok);
    return hit;
}

/// A jump out of timeout blocks (return, break, continue, `?`): the blocks
/// of this function opened at loop depth >= `loops` and try depth >= `trys`
/// put their old tokens back, innermost first.
fn Lowerer_to_unwind(self: & mut Lowerer, loops: i64, trys: i64) {
    var i: i64 = self.to_toks.len() - 1;
    while i >= self.to_base {
        if self.to_loops.get(i) >= loops && self.to_trys.get(i) >= trys {
            var t: i64 = self.to_toks.get(i);
            if t < 0 {
                // a `sandbox { }` block (Lowerer_lower_sandbox): lift its revocation
                Lowerer_sandbox_call(self, "p_sandbox_exit");
            } else {
                Lowerer_to_restore(self, t);
            }
        }
        i = i - 1;
    }
}

// --- run-time sandbox (roadmap Phase 12) -----------------------------------
// `sandbox { body }` is checked when the program is compiled (typechecker.fd
// sandbox_depth: nothing in it may use a capability). At run time the body
// also runs between p_sandbox_enter() and p_sandbox_exit(): the interpreter
// (compiler/interp.fd Interpreter_cap_builtin) revokes every capability in
// between, so what the checker cannot see through (a call through a function
// value or pointer, a C function) is stopped too. Every way out of the body
// lifts it: the normal end, `return`, `?`, and `break`/`continue` of a loop
// outside it. The block sits on the timeout blocks' unwind stack
// (`to_toks`) with the mark -1, so Lowerer_to_unwind reaches
// it on the same paths. Compiled programs call core's p_sandbox_enter /
// p_sandbox_exit, which do nothing (the compile-time check is what holds
// there); without them in core the block lowers as before.

/// Core has the run-time sandbox's entry points (p_sandbox_enter/exit).
fn Lowerer_sandbox_rt(self: & Lowerer) -> bool {
    return HashMap_get(self.func_info_at, "p_sandbox_enter") != 0 && HashMap_get(self.func_info_at, "p_sandbox_exit") != 0;
}

/// Call core's `name` (p_sandbox_enter or p_sandbox_exit, `fn() -> i64`,
/// with the environment word every Fides function takes first). It is
/// never moved, merged or dropped: the interpreter acts on it by name.
fn Lowerer_sandbox_call(self: & mut Lowerer, name: str) {
    var args: Vec<i64> = Vec::new();
    args.push(Lowerer_rc_env(self));
    var _c: i64 = Lowerer_to_call(self, name, args, IrType::I64);
}

/// `sandbox { body }` with the run-time revocation around the body.
fn Lowerer_lower_sandbox(self: & mut Lowerer, body: Vec<Stmt>) {
    self.sandbox_depth = self.sandbox_depth + 1;
    val rt: bool = Lowerer_sandbox_rt(self);
    var depth: i64 = self.to_toks.len();
    if rt {
        Lowerer_sandbox_call(self, "p_sandbox_enter");
        var loops_now: i64 = self.loop_stack.len();
        var trys_now: i64 = self.try_stack.len();
        // the mark of a sandbox block (a timeout token is a value id, >= 0)
        self.to_toks.push(0 - 1);
        self.to_loops.push(loops_now);
        self.to_trys.push(trys_now);
    }
    // the statements in the enclosing scope, as before the run-time sandbox
    var si: i64 = 0;
    while si < body.len() {
        Lowerer_lower_stmt(self, body.get(si));
        si = si + 1;
    }
    if !rt {
        self.sandbox_depth = self.sandbox_depth - 1;
        return;
    }
    self.to_toks.truncate(depth);
    self.to_loops.truncate(depth);
    self.to_trys.truncate(depth);
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_sandbox_call(self, "p_sandbox_exit");
    }
    self.sandbox_depth = self.sandbox_depth - 1;
}

/// `break` / `continue`: the timeout blocks opened inside the innermost loop.
fn Lowerer_to_unwind_loop(self: & mut Lowerer) {
    var n: i64 = self.loop_stack.len();
    Lowerer_to_unwind(self, n, 0);
}

/// `?` into an enclosing try: the timeout blocks opened inside that try.
fn Lowerer_to_unwind_try(self: & mut Lowerer) {
    var n: i64 = self.try_stack.len();
    Lowerer_to_unwind(self, 0, n);
}

/// `timeout(ms) { body }`: install the token, run the body, take the token
/// out; `self.to_hit` says whether the deadline passed (`else`).
fn Lowerer_lower_timeout(self: & mut Lowerer, ms_expr: Expr, body: Vec<Stmt>) {
    var ms: i64 = Lowerer_lower_expr(self, ms_expr);
    var tok: i64 = Lowerer_to_enter(self, ms);
    var depth: i64 = self.to_toks.len();
    var loops_now: i64 = self.loop_stack.len();
    var trys_now: i64 = self.try_stack.len();
    self.to_toks.push(tok);
    self.to_loops.push(loops_now);
    self.to_trys.push(trys_now);
    var body_block: i64 = Lowerer_new_block(self);
    var end_block: i64 = Lowerer_new_block(self);
    Lowerer_emit_terminator(self, Inst::Jump(body_block));
    var saved_allocas_len: i64 = self.allocas.len();
    var saved_alloca_types_len: i64 = self.alloca_types.len();
    var saved_var_ast_types_len: i64 = self.var_ast_types.len();
    var saved_locals_len: i64 = self.current_func.locals.len();
    Lowerer_set_current_block(self, body_block);
    Lowerer_lower_stmts(self, body);
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(end_block));
    }
    self.allocas.truncate(saved_allocas_len);
    self.alloca_types.truncate(saved_alloca_types_len);
    self.var_ast_types.truncate(saved_var_ast_types_len);
    self.current_func.locals.truncate(saved_locals_len);
    self.to_toks.truncate(depth);
    self.to_loops.truncate(depth);
    self.to_trys.truncate(depth);
    Lowerer_set_current_block(self, end_block);
    var hit: i64 = Lowerer_to_leave(self, tok);
    self.to_hit = hit;
}

pub fn Lowerer_lower_while(self: & mut Lowerer, cond: Expr, body: Vec<Stmt>) {
    var cond_block: i64 = Lowerer_new_block(self);
    var body_block: i64 = Lowerer_new_block(self);
    var exit_block: i64 = Lowerer_new_block(self);

    // Jump to condition block
    Lowerer_emit_terminator(self, Inst::Jump(cond_block));

    // Condition block: its temporaries end before the branch
    Lowerer_set_current_block(self, cond_block);
    var cmark: i64 = self.own_temps.len();
    var cond_val: i64 = Lowerer_lower_expr(self, cond);
    Lowerer_rc_flush(self, cmark);
    Lowerer_emit_terminator(self, Inst::Branch(cond_val, body_block, exit_block));

    // Body block
    Lowerer_set_current_block(self, body_block);
    Lowerer_rc_loop_open(self);
    self.loop_stack.push(LoopContext_new(cond_block, exit_block, OptValueId::None));
    Lowerer_lower_stmts(self, body);
    self.loop_stack.pop();
    Lowerer_rc_loop_close(self);
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(cond_block));
    }

    // Continue after loop
    Lowerer_set_current_block(self, exit_block);
}

/// BG131: whether a Vec's element type `t` is an instance of a generic enum
/// (`Option<str>`, `Result<i64, str>`): the loop variable is typed as it,
/// so a `match` on it binds the payloads with the type arguments (they were
/// i64 words: `"err " + e` on the `Result::Err(e)` of a loop variable gave
/// an empty line on run and a crash on C and emit).
fn Lowerer_for_generic_enum_elem(self: & Lowerer, t: Type) -> bool {
    match lw_rc_strip_ref(Lowerer_resolve_type(self, t)) {
        Type::Generic(gn, gargs) => {
            if gargs.len() == 0 {
                return false;
            }
            match Lowerer_lookup_enum(self, gn) {
                OptEnumDef::Some(ed) => {
                    return ed.type_params.len() > 0;
                }
                OptEnumDef::None => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

pub fn Lowerer_lower_for(self: & mut Lowerer, loop_var: str, iterator: Expr, body: Vec<Stmt>) {
    // For ranges: for x in start..end { body }
    match iterator {
        Expr::Range(start, end, inclusive) => {
            var start_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(start));
            var end_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(end));

            // Create alloca for loop variable
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, start_val, OptIrType::None));
            Lowerer_insert_alloca(self, loop_var, alloca);
            Lowerer_bind_local(self, loop_var, alloca);

            var cond_block: i64 = Lowerer_new_block(self);
            var body_block: i64 = Lowerer_new_block(self);
            var exit_block: i64 = Lowerer_new_block(self);

            Lowerer_emit_terminator(self, Inst::Jump(cond_block));

            // Condition: var < end (or var <= end for inclusive)
            Lowerer_set_current_block(self, cond_block);
            var var_val: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, IrType::I64));
            var cmp_op: BinOp = BinOp::Lt;
            if inclusive {
                cmp_op = BinOp::LtEq;
            }
            var cond_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(cmp_op, var_val, end_val, IrType::Bool));
            Lowerer_emit_terminator(self, Inst::Branch(cond_val, body_block, exit_block));

            // Body
            Lowerer_set_current_block(self, body_block);
            Lowerer_rc_loop_open(self);
            // M13: `continue` goes to the increment, not to the condition
            var inc_block: i64 = Lowerer_new_block(self);
            self.loop_stack.push(LoopContext_new(inc_block, exit_block, OptValueId::None));
            Lowerer_lower_stmts(self, body);
            self.loop_stack.pop();
            Lowerer_rc_loop_close(self);
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(inc_block));
            }

            // Increment: var += 1
            Lowerer_set_current_block(self, inc_block);
            var current: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, IrType::I64));
            var one: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
            var inc: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, current, one, IrType::I64));
            var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, inc, OptIrType::None));
            Lowerer_emit_terminator(self, Inst::Jump(cond_block));

            Lowerer_set_current_block(self, exit_block);
        }
        _ => {
            // Non-range iterator: lower the iterator expression and iterate
            var iter_val: i64 = Lowerer_lower_expr(self, iterator);
            var iter_ty: IrType = Lowerer_get_value_type(self, iter_val);
            // A borrowed Vec or HashMap (`v: &Vec<i64>`, `for x in &v`) is
            // the address of the slot holding it: iterate over what it
            // holds, as `*v` does (known-bugs 2g.56: the slot was read as
            // the Vec, giving its header words and a runaway length)
            match iter_ty {
                IrType::Ptr(bptr_inner) => {
                    var bpi: IrType = box_ir_type_unbox(bptr_inner);
                    if ir_type_is_opaque_named(bpi, "Vec") || ir_type_is_opaque_named(bpi, "HashMap") {
                        iter_val = Lowerer_emit_inst(self, Inst::Load(iter_val, bpi));
                        iter_ty = bpi;
                    }
                }
                _ => {
                }
            }

            // Check if Vec
            if ir_type_is_opaque_named(iter_ty, "Vec") {
                // a tuple element is read where the Vec holds it (its
                // address): its type, so `val (a, b) = t` reads its fields
                // at its layout's offsets and owns copies of them
                var for_et: Type = Lowerer_rc_vec_elem_ast(self, iterator);
                if Lowerer_rc_tuple_elems(self, for_et).len() > 0 || Lowerer_for_generic_enum_elem(self, for_et) {
                    Lowerer_insert_var_ast_type(self, loop_var, for_et);
                }
                Lowerer_lower_for_vec(self, loop_var, iter_val, body);
                return;
            }
            // Check if HashMap - get keys as Vec
            if ir_type_is_opaque_named(iter_ty, "HashMap") {
                // HashMap_keys is a Fides user function: it takes the env
                // pointer first (as src/lower.rs).
                var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var args: Vec<i64> = Vec::new();
                args.push(dummy_env);
                args.push(iter_val);
                // BG336: u64 keys in unsigned order
                var for_keys_fn: str = "HashMap_keys";
                if Lowerer_map_keys_u64(self, iterator, iter_ty) && Lowerer_has_function(self, "HashMap_keys_u64") {
                    for_keys_fn = "HashMap_keys_u64";
                }
                var keys_vec: i64 = Lowerer_emit_inst(self, Inst::Call(for_keys_fn, args, opaque_ty("Vec"), EffectSet_new()));
                Lowerer_lower_for_vec(self, loop_var, keys_vec, body);
                return;
            }
            // A str value (Ptr(U8)) is not iterated: src/lower.rs only
            // byte-iterates an i64 string handle, and a str takes its array
            // path with length 0 (`for c in "abc"` runs no iterations under
            // `fidesc run`).
            var iter_is_str: bool = false;
            if ir_type_is_ptr_like(iter_ty) {
                // Check if it's a string pointer (ptr to u8)
                match iter_ty {
                    IrType::Ptr(inner) => {
                        match box_ir_type_unbox(inner) {
                            IrType::U8 => {
                                iter_is_str = true;
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            // Default: treat as Vec iteration (most common case for opaque
            // types) - but an array (or pointer to one) takes the array
            // path below, as in src/lower.rs.
            var iter_is_array: bool = false;
            match iter_ty {
                IrType::Array(_, _) => {
                    iter_is_array = true;
                }
                IrType::Ptr(ainner) => {
                    match box_ir_type_unbox(ainner) {
                        IrType::Array(_, _) => {
                            iter_is_array = true;
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            if !iter_is_array && !iter_is_str && (ir_type_is_ptr_like(iter_ty) || ir_type_eq(iter_ty, IrType::I64)) {
                Lowerer_lower_for_vec(self, loop_var, iter_val, body);
                return;
            }

            // Array iterator
            var arr_val: i64 = iter_val;
            var arr_ty: IrType = Lowerer_get_value_type(self, arr_val);
            var elem_ty: IrType = IrType::I64;
            var arr_len: i64 = 0;
            match arr_ty {
                IrType::Array(inner, len) => {
                    elem_ty = box_ir_type_unbox(inner);
                    arr_len = len;
                }
                IrType::Ptr(inner2) => {
                    var inner_ty: IrType = box_ir_type_unbox(inner2);
                    match inner_ty {
                        IrType::Array(inner3, len3) => {
                            elem_ty = box_ir_type_unbox(inner3);
                            arr_len = len3;
                        }
                        _ => {
                            elem_ty = IrType::I64;
                            arr_len = 0;
                        }
                    }
                }
                _ => {
                    elem_ty = IrType::I64;
                    arr_len = 0;
                }
            }

            // Create alloca for loop variable
            var var_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(elem_ty, Lowerer_current_region(self)));
            Lowerer_insert_alloca_type(self, var_alloca, elem_ty);
            Lowerer_insert_alloca(self, loop_var, var_alloca);
            Lowerer_bind_local(self, loop_var, var_alloca);

            // Create index alloca
            var idx_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
            Lowerer_insert_alloca_type(self, idx_alloca, IrType::I64);
            var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, zero, OptIrType::None));

            var cond_block: i64 = Lowerer_new_block(self);
            var body_block: i64 = Lowerer_new_block(self);
            var exit_block: i64 = Lowerer_new_block(self);

            Lowerer_emit_terminator(self, Inst::Jump(cond_block));

            // Condition: i < arr_len
            Lowerer_set_current_block(self, cond_block);
            var idx_val: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
            var len_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(arr_len, IrType::I64));
            var cond_val2: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, idx_val, len_val, IrType::Bool));
            Lowerer_emit_terminator(self, Inst::Branch(cond_val2, body_block, exit_block));

            // Body
            Lowerer_set_current_block(self, body_block);
            Lowerer_rc_loop_open(self);
            // M13: `continue` goes to the increment
            var inc_block2: i64 = Lowerer_new_block(self);
            self.loop_stack.push(LoopContext_new(inc_block2, exit_block, OptValueId::None));

            // Load element: arr[i]
            var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(arr_val, idx_val, elem_ty));
            var elem_val: i64 = Lowerer_emit_inst(self, Inst::Load(elem_ptr, elem_ty));
            var _s4: i64 = Lowerer_emit_inst(self, Inst::Store(var_alloca, elem_val, OptIrType::None));

            Lowerer_lower_stmts(self, body);
            self.loop_stack.pop();
            Lowerer_rc_loop_close(self);
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(inc_block2));
            }

            // Increment index
            Lowerer_set_current_block(self, inc_block2);
            var idx_val2: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
            var one2: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
            var inc2: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, idx_val2, one2, IrType::I64));
            var _s5: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, inc2, OptIrType::None));
            Lowerer_emit_terminator(self, Inst::Jump(cond_block));

            Lowerer_set_current_block(self, exit_block);
        }
    }
}

/// Lower `for c in str_expr { body }` - iterate over string bytes.
/// Uses p_str_length for the loop bound and String_byte_at for element access.
pub fn Lowerer_lower_for_string(self: & mut Lowerer, loop_var: str, str_val: i64, body: Vec<Stmt>) {
    // Create alloca for loop variable (byte value as i64)
    var var_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
    Lowerer_insert_alloca_type(self, var_alloca, IrType::I64);
    Lowerer_insert_alloca(self, loop_var, var_alloca);
    Lowerer_bind_local(self, loop_var, var_alloca);

    // Create index alloca
    var idx_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
    Lowerer_insert_alloca_type(self, idx_alloca, IrType::I64);
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, zero, OptIrType::None));

    // Get string length once (hoist out of loop)
    // p_str_length is a user function - prepend dummy env_ptr
    var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var len_args: Vec<i64> = Vec::new();
    len_args.push(dummy_env);
    len_args.push(str_val);
    var len_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_length", len_args, IrType::I64, EffectSet_new()));

    var cond_block: i64 = Lowerer_new_block(self);
    var body_block: i64 = Lowerer_new_block(self);
    var exit_block: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Jump(cond_block));

    // Condition: i < len
    Lowerer_set_current_block(self, cond_block);
    var idx_val: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
    var cond_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, idx_val, len_val, IrType::Bool));
    Lowerer_emit_terminator(self, Inst::Branch(cond_val, body_block, exit_block));

    // Body: c = String_byte_at(str, i), store to var_alloca, lower body, increment
    Lowerer_set_current_block(self, body_block);
    var cur_idx: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
    var dummy_env2: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var byte_args: Vec<i64> = Vec::new();
    byte_args.push(dummy_env2);
    byte_args.push(str_val);
    byte_args.push(cur_idx);
    var byte_val: i64 = Lowerer_emit_inst(self, Inst::Call("String_byte_at", byte_args, IrType::I64, EffectSet_new()));
    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(var_alloca, byte_val, OptIrType::None));

    Lowerer_rc_loop_open(self);
    // M13: `continue` goes to the increment
    var inc_block: i64 = Lowerer_new_block(self);
    self.loop_stack.push(LoopContext_new(inc_block, exit_block, OptValueId::None));
    Lowerer_lower_stmts(self, body);
    self.loop_stack.pop();
    Lowerer_rc_loop_close(self);
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(inc_block));
    }

    Lowerer_set_current_block(self, inc_block);
    var cur: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
    var one: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
    var inc: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, cur, one, IrType::I64));
    var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, inc, OptIrType::None));
    Lowerer_emit_terminator(self, Inst::Jump(cond_block));

    Lowerer_set_current_block(self, exit_block);
}

pub fn Lowerer_lower_for_vec(self: & mut Lowerer, loop_var: str, vec_val: i64, body: Vec<Stmt>) {
    // Determine element type from Vec value type
    var vec_ty: IrType = Lowerer_get_value_type(self, vec_val);
    var elem_ty: IrType = IrType::I64;
    match vec_ty {
        IrType::Generic(gname, gargs) => {
            if gname == "Vec" && gargs.len() > 0 {
                elem_ty = gargs.get(0);
            }
        }
        _ => {
        }
    }

    // Create alloca for loop variable
    var var_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(elem_ty, Lowerer_current_region(self)));
    Lowerer_insert_alloca_type(self, var_alloca, elem_ty);
    Lowerer_insert_alloca(self, loop_var, var_alloca);
    Lowerer_bind_local(self, loop_var, var_alloca);

    // Create index alloca
    var idx_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
    Lowerer_insert_alloca_type(self, idx_alloca, IrType::I64);
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, zero, OptIrType::None));

    var cond_block: i64 = Lowerer_new_block(self);
    var body_block: i64 = Lowerer_new_block(self);
    var exit_block: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Jump(cond_block));

    // Condition: i < Vec_len(vec)
    Lowerer_set_current_block(self, cond_block);
    var idx_val: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
    var len_args: Vec<i64> = Vec::new();
    len_args.push(vec_val);
    var len_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_vec_len", len_args, IrType::I64, EffectSet_new()));
    var cond_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, idx_val, len_val, IrType::Bool));
    Lowerer_emit_terminator(self, Inst::Branch(cond_val, body_block, exit_block));

    // Body
    Lowerer_set_current_block(self, body_block);
    Lowerer_rc_loop_open(self);
    // M13: `continue` goes to the increment
    var inc_block: i64 = Lowerer_new_block(self);
    self.loop_stack.push(LoopContext_new(inc_block, exit_block, OptValueId::None));

    // Load element: Vec_get(vec, i) - use word_repr for struct elements
    var get_args: Vec<i64> = Vec::new();
    get_args.push(vec_val);
    get_args.push(idx_val);
    var get_ret_ty: IrType = word_repr(elem_ty);
    var elem_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_vec_get", get_args, get_ret_ty, EffectSet_new()));
    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(var_alloca, elem_val, OptIrType::None));

    Lowerer_lower_stmts(self, body);
    self.loop_stack.pop();
    Lowerer_rc_loop_close(self);
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(inc_block));
    }

    // Increment index
    Lowerer_set_current_block(self, inc_block);
    var idx_val2: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
    var one: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
    var inc: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, idx_val2, one, IrType::I64));
    var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, inc, OptIrType::None));
    Lowerer_emit_terminator(self, Inst::Jump(cond_block));

    Lowerer_set_current_block(self, exit_block);
}

pub fn Lowerer_lower_loop(self: & mut Lowerer, body: Vec<Stmt>) {
    var body_block: i64 = Lowerer_new_block(self);
    var exit_block: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Jump(body_block));

    // Body block
    Lowerer_set_current_block(self, body_block);
    Lowerer_rc_loop_open(self);
    self.loop_stack.push(LoopContext_new(body_block, exit_block, OptValueId::None));
    Lowerer_lower_stmts(self, body);
    self.loop_stack.pop();
    Lowerer_rc_loop_close(self);

    // If body doesn't end with terminator, jump back to body (infinite loop)
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(body_block));
    }

    Lowerer_set_current_block(self, exit_block);
}

pub fn Lowerer_lower_match(self: & mut Lowerer, expr: Expr, arms: Vec<MatchArm>) {
    // Full match lowering for statements.
    var match_val: i64 = Lowerer_lower_expr(self, expr);
    var scrutinee_ty: Type = Lowerer_infer_expr_ast_type(self, expr);
    var merge_block: i64 = Lowerer_new_block(self);

    var i: i64 = 0;
    while i < arms.len() {
        var arm: MatchArm = arms.get(i);
        var arm_block: i64 = Lowerer_new_block(self);
        var next_block: i64 = Lowerer_new_block(self);

        // Save variable binding lengths so arm-local bindings don't leak
        // into other arms or code after the match. Fides Vec is a reference
        // type (PVec*), so we use truncate-based save/restore instead of
        // pointer-copy assignment.
        var saved_allocas_len: i64 = self.allocas.len();
        var saved_alloca_types_len: i64 = self.alloca_types.len();
        var saved_var_ast_types_len: i64 = self.var_ast_types.len();
        var saved_locals_len: i64 = self.current_func.locals.len();

        // `None =>` on an Option is the variant (reference §6): lowered as
        // `Option::None =>` when it is one of the scrutinee's enum
        var pat: Pattern = arm.pattern;
        match pat {
            Pattern::Ident(pn) => {
                if Lowerer_bare_pattern_is_unit_variant(self, expr, pn) {
                    pat = Pattern::EnumVariant("", pn, Vec::new());
                }
            }
            _ => {
            }
        }
        match pat {
            Pattern::Wildcard => {
                Lowerer_emit_terminator(self, Inst::Jump(arm_block));
            }
            Pattern::IntLit(v) => {
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstInt(v, IrType::I64)), IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::BoolLit(v) => {
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstBool(v)), IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::Ident(name) => {
                Lowerer_insert_alloca(self, name, - 1);
                Lowerer_bind_local(self, name, match_val);
                Lowerer_emit_terminator(self, Inst::Jump(arm_block));
            }
            Pattern::StrLit(s) => {
                var const_str: i64 = Lowerer_emit_inst(self, Inst::ConstStr(s));
                var dummy_env_se2: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var str_eq_args: Vec<i64> = Vec::new();
                str_eq_args.push(dummy_env_se2);
                str_eq_args.push(match_val);
                str_eq_args.push(const_str);
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_equal", str_eq_args, IrType::Bool, EffectSet_new()));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::Range(start_pat, end_pat) => {
                var lo: i64 = 0;
                var hi: i64 = 0;
                var range_ok: bool = false;
                match start_pat {
                    Pattern::IntLit(s) => {
                        lo = s;
                        match end_pat {
                            Pattern::IntLit(e) => {
                                hi = e;
                                range_ok = true;
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                if range_ok {
                    var start_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(lo, IrType::I64));
                    var end_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(hi, IrType::I64));
                    var lo_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::LtEq, start_val, match_val, IrType::Bool));
                    var hi_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, match_val, end_val, IrType::Bool));
                    var in_range: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::And, lo_cmp, hi_cmp, IrType::Bool));
                    Lowerer_emit_terminator(self, Inst::Branch(in_range, arm_block, next_block));
                } else {
                    Lowerer_emit_terminator(self, Inst::Jump(next_block));
                }
            }
            Pattern::EnumVariant(enum_name, variant, bindings) => {
                // Load tag from offset 0 and compare with variant index
                var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, 0, IrType::I64));
                var tag_val: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));

                // Find variant index
                var variant_idx: i64 = 0;
                // BG11: the enum a bare variant names (`pen`) decides both
                // the tag and the payload types
                var pen: str = enum_name;
                if str_len(enum_name) > 0 {
                    match Lowerer_lookup_enum(self, enum_name) {
                        OptEnumDef::Some(def) => {
                            var vi: i64 = 0;
                            while vi < def.variants.len() {
                                if def.variants.get(vi).name == variant {
                                    variant_idx = vi;
                                }
                                vi = vi + 1;
                            }
                        }
                        OptEnumDef::None => {
                        }
                    }
                } else {
                    // BG11: the scrutinee's enum, not the last enum that
                    // has a variant of this name
                    pen = Lowerer_scrutinee_pattern_enum(self, Lowerer_rc_expr_type(self, expr), variant);
                    variant_idx = Lowerer_pattern_variant_index(self, pen, variant);
                }

                var expected: i64 = Lowerer_emit_inst(self, Inst::ConstInt(variant_idx, IrType::I64));
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag_val, expected, IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));

                // In arm block: bind payload fields
                Lowerer_set_current_block(self, arm_block);
                self.match_scrutinee_ty = scrutinee_ty;
                var binding_tys: Vec<IrType> = Lowerer_pattern_binding_ir_types(self, pen, variant, bindings);
                var binding_ast_tys: Vec<Type> = Lowerer_pattern_binding_ast_types(self, pen, variant, bindings);
                var binding_params: Vec<bool> = Lowerer_pattern_binding_params(self, pen, variant);
                // Compute field indices: struct-typed fields occupy multiple
                // slots (inline storage), so we accumulate the offset.
                var field_idx: i64 = 1;
                var mb_names: Vec<str> = Vec::new();
                var mb_tys: Vec<Type> = Vec::new();
                var bi: i64 = 0;
                while bi < bindings.len() {
                    var binding: Binding = bindings.get(bi);
                    var field_ty: IrType = IrType::I64;
                    if bi < binding_tys.len() {
                        field_ty = binding_tys.get(bi);
                    }
                    var is_param: bool = false;
                    if bi < binding_params.len() {
                        is_param = binding_params.get(bi);
                    }
                    var field_val: i64 = 0;
                    if is_param {
                        field_val = Lowerer_load_param_payload(self, match_val, field_idx, field_ty);
                    } else {
                        var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, field_idx, field_ty));
                        field_val = Lowerer_load_enum_field(self, field_ptr, field_ty);
                    }
                    Lowerer_insert_alloca(self, binding.name, - 1);
                    Lowerer_bind_local(self, binding.name, field_val);
                    // Register AST type so infer_expr_type can recover
                    // generic element types (e.g. Vec<FieldInit>).
                    if bi < binding_ast_tys.len() {
                        Lowerer_insert_var_ast_type(self, binding.name, binding_ast_tys.get(bi));
                        // A struct binding the arm changes becomes a copy of its own
                        // (below, after the guard)
                        if !is_param && Lowerer_mb_owns_copy(self, binding.name, binding_ast_tys.get(bi), arm.body) {
                            mb_names.push(binding.name);
                            mb_tys.push(binding_ast_tys.get(bi));
                        } else if Lowerer_mb_plain_assigned(self, binding.name, binding_ast_tys.get(bi), arm.body) {
                            // BG258: a number (or anything owning nothing)
                            // the arm assigns gets a slot too
                            mb_names.push(binding.name);
                            mb_tys.push(binding_ast_tys.get(bi));
                        }
                    }
                    // Advance field_idx by the number of slots this field occupies
                    if is_param {
                        field_idx = field_idx + 1;
                    } else {
                        field_idx = field_idx + Lowerer_enum_field_slots(self, field_ty);
                    }
                    bi = bi + 1;
                }
                // Arm guard: evaluated with the bindings in scope.
                match arm.guard {
                    OptBoxExpr::Some(guard_expr) => {
                        // A guard runs only for its arm: its temporaries end before the branch
                        var gmark: i64 = self.own_temps.len();
                        var guard_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(guard_expr));
                        Lowerer_rc_flush(self, gmark);
                        var guard_body_block: i64 = Lowerer_new_block(self);
                        Lowerer_emit_terminator(self, Inst::Branch(guard_val, guard_body_block, next_block));
                        Lowerer_set_current_block(self, guard_body_block);
                    }
                    OptBoxExpr::None => {
                    }
                }
                // A struct binding is a copy of the payload that owns nothing
                // (Lowerer_load_enum_field): replacing one of its fields
                // (`p.v = w`, through `& mut p` too) dropped the payload's
                // value, which the scrutinee dropped again (a double free: the
                // compiler itself crashed on test_cross_module_specialization,
                // parser.fd pd_cross_module_specializations through `& mut
                // user`), and `p = q` changed nothing. A binding the arm
                // changes is a variable of its own, as `var p: P = binding;`:
                // an owner of its copy, dropped when the arm ends.
                var mb_scope: bool = mb_names.len() > 0 && self.own_on;
                // BG258: the plain bindings' variables need no ownership
                // scope (with ownership off only they are in mb_names)
                if mb_names.len() > 0 {
                    if mb_scope {
                        Lowerer_rc_scope_open(self);
                    }
                    var mbi: i64 = 0;
                    while mbi < mb_names.len() {
                        Lowerer_lower_let_stmt(self, mb_names.get(mbi), OptType::Some(mb_tys.get(mbi)), Expr::Ident(mb_names.get(mbi)), true, false, Vec::new(), self.cur_line);
                        mbi = mbi + 1;
                    }
                }
                Lowerer_lower_stmts(self, arm.body);
                if mb_scope {
                    Lowerer_rc_scope_close(self);
                }
                if !Lowerer_current_block_has_terminator(self) {
                    Lowerer_emit_terminator(self, Inst::Jump(merge_block));
                }
                // Restore variable bindings (truncate arm-local additions)
                self.allocas.truncate(saved_allocas_len);
                self.alloca_types.truncate(saved_alloca_types_len);
                self.var_ast_types.truncate(saved_var_ast_types_len);
                self.current_func.locals.truncate(saved_locals_len);
                Lowerer_set_current_block(self, next_block);
                i = i + 1;
                continue;
            }
        }

        // Arm body (for non-EnumVariant patterns)
        Lowerer_set_current_block(self, arm_block);
        // Arm guard: evaluated with the bindings in scope.
        match arm.guard {
            OptBoxExpr::Some(guard_expr) => {
                // A guard runs only for its arm: its temporaries end before the branch
                var gmark: i64 = self.own_temps.len();
                var guard_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(guard_expr));
                Lowerer_rc_flush(self, gmark);
                var guard_body_block: i64 = Lowerer_new_block(self);
                Lowerer_emit_terminator(self, Inst::Branch(guard_val, guard_body_block, next_block));
                Lowerer_set_current_block(self, guard_body_block);
            }
            OptBoxExpr::None => {
            }
        }
        Lowerer_lower_stmts(self, arm.body);
        if !Lowerer_current_block_has_terminator(self) {
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));
        }
        // Restore variable bindings (truncate arm-local additions)
        self.allocas.truncate(saved_allocas_len);
        self.alloca_types.truncate(saved_alloca_types_len);
        self.var_ast_types.truncate(saved_var_ast_types_len);
        self.current_func.locals.truncate(saved_locals_len);

        Lowerer_set_current_block(self, next_block);
        i = i + 1;
    }

    // No arm matched - jump to merge
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(merge_block));
    }

    Lowerer_set_current_block(self, merge_block);
}

pub fn Lowerer_lower_compound_assign(self: & mut Lowerer, op: AssignOp, current: i64, rhs: i64) -> i64 {
    var binop: BinOp = BinOp::Add;
    match op {
        AssignOp::AddAssign => {
            binop = BinOp::Add;
        }
        AssignOp::SubAssign => {
            binop = BinOp::Sub;
        }
        AssignOp::MulAssign => {
            binop = BinOp::Mul;
        }
        AssignOp::DivAssign => {
            binop = BinOp::Div;
        }
        AssignOp::ModAssign => {
            binop = BinOp::Mod;
        }
        AssignOp::BitAndAssign => {
            binop = BinOp::BitAnd;
        }
        AssignOp::BitOrAssign => {
            binop = BinOp::BitOr;
        }
        AssignOp::BitXorAssign => {
            binop = BinOp::BitXor;
        }
        AssignOp::ShlAssign => {
            binop = BinOp::Shl;
        }
        AssignOp::ShrAssign => {
            binop = BinOp::Shr;
        }
        AssignOp::Assign => {
            return rhs;
        }
    }
    var ty: IrType = Lowerer_get_value_type(self, current);
    // BG30: `s += t` on two strings is their concatenation, as `s + t` is
    // (Lowerer_lower_binary); a BinOp added the two pointers. The new
    // string is a temporary of the statement (Lowerer_rc_note_call): the
    // place that keeps it claims it and drops its old string.
    match op {
        AssignOp::AddAssign => {
            if ir_type_eq(ty, lw_ptr_u8()) && ir_type_eq(Lowerer_get_value_type(self, rhs), lw_ptr_u8()) {
                var cargs: Vec<i64> = Vec::new();
                cargs.push(current);
                cargs.push(rhs);
                var ceff: EffectSet = EffectSet_new();
                EffectSet_add(& mut ceff, Effect::Alloc);
                return Lowerer_emit_inst(self, Inst::Call("p_str_concat", cargs, lw_ptr_u8(), ceff));
            }
        }
        _ => {
        }
    }
    return Lowerer_emit_inst(self, Inst::BinOp(binop, current, rhs, ty));
}

pub fn Lowerer_type_struct_name(self: & Lowerer, ty: Type) -> OptStringLower {
    match ty {
        Type::Named(n) => {
            // Check if it's a struct (not an enum or alias)
            match Lowerer_lookup_struct(self, n) {
                OptStructDef::Some(_) => {
                    return OptStringLower::Some(n);
                }
                OptStructDef::None => {
                }
            }
            // Check resolved alias
            match Lowerer_lookup_type_alias(self, n) {
                OptType::Some(alias) => {
                    return Lowerer_type_struct_name(self, alias);
                }
                OptType::None => {
                }
            }
            return OptStringLower::None;
        }
        Type::Generic(n, _) => {
            match Lowerer_lookup_struct(self, n) {
                OptStructDef::Some(_) => {
                    return OptStringLower::Some(n);
                }
                OptStructDef::None => {
                }
            }
            return OptStringLower::None;
        }
        _ => {
            return OptStringLower::None;
        }
    }
    return OptStringLower::None;
}

pub fn Lowerer_has_drop_impl(self: & Lowerer, struct_name: str) -> bool {
    // Check if there's a Drop_{struct_name} function
    match Lowerer_lookup_impl_method(self, struct_name, "drop") {
        OptFunc::Some(_) => {
            return true;
        }
        OptFunc::None => {
        }
    }
    // Also check for "Drop" trait impl
    match Lowerer_lookup_impl_method(self, struct_name, "Drop_drop") {
        OptFunc::Some(_) => {
            return true;
        }
        OptFunc::None => {
        }
    }
    return false;
}

pub fn Lowerer_emit_drops(self: & mut Lowerer) {
    // F88: @zeroize — emit memset(0) for zeroize_locals before drops
    Lowerer_emit_zeroize(self);
    // Emit drop calls for locals with Drop impls, in reverse order
    var i: i64 = self.current_func.drop_locals.len() - 1;
    while i >= 0 {
        var entry: ValueIdString = self.current_func.drop_locals.get(i);
        var drop_name: str = entry.name + "_drop";
        // Call drop function: drop(alloca_ptr)
        var args: Vec<i64> = Vec::new();
        args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
        // __env
        args.push(entry.id);
        var _v: i64 = Lowerer_emit_inst(self, Inst::Call(drop_name, args, IrType::Void, EffectSet_new()));
        i = i - 1;
    }
}

/// F88: Emit compiler-inserted memset(0) calls for all @zeroize locals.
/// Called before drops and returns. Wipes secrets from memory at scope exit.
/// Emits in reverse declaration order (LIFO — last declared wiped first).
/// J8: a @zeroize Vec keeps its contents in a heap buffer that growth
/// replaces — register the local with the runtime's sensitive-Vec table so
/// vec_sz_reserve wipes the old buffer before freeing it. The table key is
/// the alloca (the Vec header's address), which is what the Vec primitives
/// receive.
pub fn Lowerer_mark_sensitive(self: & mut Lowerer, alloca: i64, ir_ty: IrType) {
    if !ir_type_is_opaque_named(ir_ty, "Vec") {
        return;
    }
    var held: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, ir_ty));
    var args: Vec<i64> = Vec::new();
    args.push(held);
    var eff: EffectSet = EffectSet_new();
    EffectSet_add(eff, Effect::Write);
    var _c: i64 = Lowerer_emit_inst(self, Inst::Call("p_sensitive_mark", args, IrType::Void, eff));
}

pub fn Lowerer_emit_zeroize(self: & mut Lowerer) {
    var i: i64 = self.current_func.zeroize_locals.len() - 1;
    while i >= 0 {
        var entry: ValueIdU64 = self.current_func.zeroize_locals.get(i);
        // A str or Vec slot holds a pointer: wipe the bytes it points to too
        // (a string in the arena, a Vec's element buffer), not just the
        // 8-byte pointer.
        match Lowerer_lookup_alloca_type(self, entry.id) {
            OptIrType::Some(slot_ty) => {
                var wipe: str = "";
                match slot_ty {
                    IrType::Ptr(inner) => {
                        match box_ir_type_unbox(inner) {
                            IrType::U8 => {
                                wipe = "p_str_zeroize";
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                if ir_type_is_opaque_named(slot_ty, "Vec") {
                    wipe = "p_vec_zeroize";
                }
                if wipe != "" {
                    var held: i64 = Lowerer_emit_inst(self, Inst::Load(entry.id, slot_ty));
                    var wargs: Vec<i64> = Vec::new();
                    wargs.push(held);
                    var weff: EffectSet = EffectSet_new();
                    EffectSet_add(weff, Effect::Write);
                    var _w: i64 = Lowerer_emit_inst(self, Inst::Call(wipe, wargs, IrType::Void, weff));
                }
            }
            OptIrType::None => {
            }
        }
        // Emit: p_memset(alloca_ptr, 0, size)
        var zero_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I32));
        var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(entry.val, IrType::I64));
        var args: Vec<i64> = Vec::new();
        args.push(entry.id);
        args.push(zero_val);
        args.push(size_val);
        var eff: EffectSet = EffectSet_new();
        EffectSet_add(eff, Effect::Write);
        var _v: i64 = Lowerer_emit_inst(self, Inst::Call("p_memset", args, IrType::Void, eff));
        i = i - 1;
    }
}

pub fn Lowerer_infer_binop_type(self: & Lowerer, op: BinOp, left: Expr, right: Expr) -> IrType {
    // Comparison operators return bool
    if binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::GtEq) {
        return IrType::Bool;
    }
    // Logical operators return bool
    if binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
        return IrType::Bool;
    }
    // Arithmetic operators: infer from left operand. Inferred once: inferring
    // it again for CL10 below made nested `((1 + 2) + 3) + ...` exponential
    var left_ty: IrType = Lowerer_infer_expr_type(self, left);
    // CL10: an operator on a struct has its method's type (`a + b` is `a.add(b)`)
    var sop: str = Lowerer_struct_operator_ty(self, op, left_ty);
    if str_len(sop) > 0 {
        return Lowerer_lookup_func_ret_ty_ir(self, lw_ir_struct_name(left_ty) + "_" + sop);
    }
    var right_ty: IrType = Lowerer_infer_expr_type(self, right);
    // CL10: a unit's operator (the dimension rule), or `2.0 * m` (`m.rmul`)
    var sop_plan: i64 = Lowerer_binop_plan(self, op, left_ty, right_ty);
    if sop_plan == 1 {
        return Lowerer_lookup_func_ret_ty_ir(self, lw_ir_struct_name(left_ty) + "_" + binop_operator_method(op));
    }
    if sop_plan == 2 {
        return Lowerer_lookup_func_ret_ty_ir(self, lw_ir_struct_name(right_ty) + "_r" + binop_operator_method(op));
    }
    if sop_plan == 3 {
        return Lowerer_dim_result_ty(self, op, left_ty, right_ty);
    }
    if lw_plain_int(left_ty) && lw_plain_int(right_ty) {
        return lw_int_op_type(op, left, right, left_ty, right_ty);
    }
    if ir_type_eq(left_ty, IrType::Void) || ir_type_eq(left_ty, IrType::I64) {
        if ir_type_eq(right_ty, IrType::F64) {
            return IrType::F64;
        }
        return IrType::I64;
    }
    return left_ty;
}

fn lw_plain_int(t: IrType) -> bool {
    match t {
        IrType::I8 => {
            return true;
        }
        IrType::I16 => {
            return true;
        }
        IrType::I32 => {
            return true;
        }
        IrType::I64 => {
            return true;
        }
        IrType::U8 => {
            return true;
        }
        IrType::U16 => {
            return true;
        }
        IrType::U32 => {
            return true;
        }
        IrType::U64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

fn lw_int_size(t: IrType) -> i64 {
    match t {
        IrType::I8 => {
            return 1;
        }
        IrType::U8 => {
            return 1;
        }
        IrType::I16 => {
            return 2;
        }
        IrType::U16 => {
            return 2;
        }
        IrType::I32 => {
            return 4;
        }
        IrType::U32 => {
            return 4;
        }
        _ => {
            return 8;
        }
    }
}

fn lw_int_unsigned(t: IrType) -> bool {
    match t {
        IrType::U8 => {
            return true;
        }
        IrType::U16 => {
            return true;
        }
        IrType::U32 => {
            return true;
        }
        IrType::U64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

fn lw_lit_fits(v: i64, t: IrType) -> bool {
    match t {
        IrType::I8 => {
            return v >= - 128 && v <= 127;
        }
        IrType::I16 => {
            return v >= - 32768 && v <= 32767;
        }
        IrType::I32 => {
            return v >= - 2147483648 && v <= 2147483647;
        }
        IrType::U8 => {
            return v >= 0 && v <= 255;
        }
        IrType::U16 => {
            return v >= 0 && v <= 65535;
        }
        IrType::U32 => {
            return v >= 0 && v <= 4294967295;
        }
        IrType::U64 => {
            return v >= 0;
        }
        _ => {
            return true;
        }
    }
}

/// The integer type an operation runs in, and so the width it overflows at
/// (as src/lower.rs int_op_type): a bare literal takes the other operand's
/// type when it fits; else the wider type wins, and the unsigned one at
/// equal width. A shift has its left operand's type.
fn lw_int_op_type(op: BinOp, left: Expr, right: Expr, lt: IrType, rt: IrType) -> IrType {
    if binop_eq(op, BinOp::Shl) || binop_eq(op, BinOp::Shr) {
        return lt;
    }
    match right {
        Expr::IntLit(v) => {
            if lw_lit_fits(v, lt) {
                return lt;
            }
        }
        _ => {
        }
    }
    match left {
        Expr::IntLit(v) => {
            if lw_lit_fits(v, rt) {
                return rt;
            }
        }
        _ => {
        }
    }
    // V1e: an operator tree of literals (`(31 & 15) | 1`) is a literal too
    if lw_int_size(lt) < 8 && lw_lit_tree(right) {
        var rv: i64 = lw_lit_tree_val(right);
        if rv != lw_not_lit() && lw_lit_fits(rv, lt) {
            return lt;
        }
    }
    if lw_int_size(rt) < 8 && lw_lit_tree(left) {
        var lv: i64 = lw_lit_tree_val(left);
        if lv != lw_not_lit() && lw_lit_fits(lv, rt) {
            return rt;
        }
    }
    // V1a: so is a literal shifted (`(2 << a) - b`), next to an operand of
    // a narrow type (Lowerer_lower_expr gives the literal that type)
    if lw_int_size(rt) < 8 && lw_has_lit_shift(left) && !lw_lit_like(right) {
        return rt;
    }
    if lw_int_size(lt) < 8 && lw_has_lit_shift(right) && !lw_lit_like(left) {
        return lt;
    }
    var ls: i64 = lw_int_size(lt);
    var rs: i64 = lw_int_size(rt);
    if ls > rs || (ls == rs && lw_int_unsigned(lt)) {
        return lt;
    }
    return rt;
}

// --- V1a / V1e: literals typed by their context (§3.5, §4.1) -------------

/// Not the value of a literal tree (lw_lit_tree_val): every value it gives
/// otherwise is below 2^40 in size.
fn lw_not_lit() -> i64 {
    return 0 - 4611686018427387904;
}

/// The operators a context's integer type flows through: arithmetic and
/// bitwise (a comparison's result is bool, a shift's amount its own type).
fn lw_binop_ctx_flows(op: BinOp) -> bool {
    return binop_eq(op, BinOp::Add) || binop_eq(op, BinOp::Sub) || binop_eq(op, BinOp::Mul) || binop_eq(op, BinOp::Div) || binop_eq(op, BinOp::Mod) || binop_eq(op, BinOp::BitAnd) || binop_eq(op, BinOp::BitOr) || binop_eq(op, BinOp::BitXor);
}

/// V1e: an operator tree of integer literals (`(31 & 15) | 1`, `-(4 * 2)`),
/// not a bare literal (lw_int_op_type tests those itself).
fn lw_lit_tree(e: Expr) -> bool {
    match e {
        Expr::Binary(op, l, r) => {
            if !(lw_binop_ctx_flows(op) || binop_eq(op, BinOp::Shl) || binop_eq(op, BinOp::Shr)) {
                return false;
            }
            return lw_lit_leafy(lw_box_expr_unbox(l)) && lw_lit_leafy(lw_box_expr_unbox(r));
        }
        Expr::Unary(op, x) => {
            match op {
                UnaryOp::Neg => {
                    return lw_lit_leafy(lw_box_expr_unbox(x));
                }
                UnaryOp::BitNot => {
                    return lw_lit_leafy(lw_box_expr_unbox(x));
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

fn lw_lit_leafy(e: Expr) -> bool {
    match e {
        Expr::IntLit(_) => {
            return true;
        }
        _ => {
        }
    }
    return lw_lit_tree(e);
}

/// The value of a literal tree, or lw_not_lit() when it is not one or a step
/// leaves +-2^40 (so `*` cannot overflow), divides by zero or shifts by a
/// negative amount or one over 40.
fn lw_lit_tree_val(e: Expr) -> i64 {
    var lim: i64 = 1099511627776;
    match e {
        Expr::IntLit(v) => {
            if v >= lim || v <= 0 - lim {
                return lw_not_lit();
            }
            return v;
        }
        Expr::Unary(op, x) => {
            var xv: i64 = lw_lit_tree_val(lw_box_expr_unbox(x));
            if xv == lw_not_lit() {
                return lw_not_lit();
            }
            match op {
                UnaryOp::Neg => {
                    return 0 - xv;
                }
                UnaryOp::BitNot => {
                    return - 1 - xv;
                }
                _ => {
                }
            }
            return lw_not_lit();
        }
        Expr::Binary(op, l, r) => {
            var a: i64 = lw_lit_tree_val(lw_box_expr_unbox(l));
            var b: i64 = lw_lit_tree_val(lw_box_expr_unbox(r));
            if a == lw_not_lit() || b == lw_not_lit() {
                return lw_not_lit();
            }
            var res: i64 = lw_not_lit();
            if binop_eq(op, BinOp::Add) {
                res = a + b;
            } else if binop_eq(op, BinOp::Sub) {
                res = a - b;
            } else if binop_eq(op, BinOp::Mul) {
                res = a * b;
            } else if binop_eq(op, BinOp::Div) {
                if b != 0 {
                    res = a / b;
                }
            } else if binop_eq(op, BinOp::Mod) {
                if b != 0 {
                    res = a % b;
                }
            } else if binop_eq(op, BinOp::BitAnd) {
                res = a & b;
            } else if binop_eq(op, BinOp::BitOr) {
                res = a | b;
            } else if binop_eq(op, BinOp::BitXor) {
                res = a ^ b;
            } else if binop_eq(op, BinOp::Shl) {
                if b >= 0 && b <= 40 && a >= 0 - 65536 && a <= 65536 {
                    res = a << b;
                }
            } else if binop_eq(op, BinOp::Shr) {
                if b >= 0 && b <= 40 {
                    res = a >> b;
                }
            }
            if res == lw_not_lit() || res >= lim || res <= 0 - lim {
                return lw_not_lit();
            }
            return res;
        }
        _ => {
        }
    }
    return lw_not_lit();
}

/// V1a: a `<<`/`>>` whose left operand is an integer literal, reached
/// through arithmetic and bitwise operators (and a shift's left side).
fn lw_has_lit_shift(e: Expr) -> bool {
    match e {
        Expr::Binary(op, l, r) => {
            if binop_eq(op, BinOp::Shl) || binop_eq(op, BinOp::Shr) {
                match lw_box_expr_unbox(l) {
                    Expr::IntLit(_) => {
                        return true;
                    }
                    _ => {
                    }
                }
                return lw_has_lit_shift(lw_box_expr_unbox(l));
            }
            if lw_binop_ctx_flows(op) {
                return lw_has_lit_shift(lw_box_expr_unbox(l)) || lw_has_lit_shift(lw_box_expr_unbox(r));
            }
        }
        Expr::Unary(op, x) => {
            match op {
                UnaryOp::Not => {
                    return false;
                }
                _ => {
                }
            }
            return lw_has_lit_shift(lw_box_expr_unbox(x));
        }
        _ => {
        }
    }
    return false;
}

/// Whether `e`'s integer type is not fixed by itself: a literal, a tree of
/// literals, or one with a shifted literal (`(2 << a) - 62`) whose other
/// operands are such too.
fn lw_lit_like(e: Expr) -> bool {
    match e {
        Expr::IntLit(_) => {
            return true;
        }
        Expr::Binary(op, l, r) => {
            if binop_eq(op, BinOp::Shl) || binop_eq(op, BinOp::Shr) {
                return lw_lit_like(lw_box_expr_unbox(l));
            }
            if lw_binop_ctx_flows(op) {
                return lw_lit_like(lw_box_expr_unbox(l)) && lw_lit_like(lw_box_expr_unbox(r));
            }
        }
        Expr::Unary(op, x) => {
            match op {
                UnaryOp::Not => {
                    return false;
                }
                _ => {
                }
            }
            return lw_lit_like(lw_box_expr_unbox(x));
        }
        _ => {
        }
    }
    return false;
}

/// A narrow integer type (below 64 bits) as an AST type, else Type::Never.
fn lw_narrow_int_ast(t: IrType) -> Type {
    match t {
        IrType::I8 => {
            return Type::I8;
        }
        IrType::I16 => {
            return Type::I16;
        }
        IrType::I32 => {
            return Type::I32;
        }
        IrType::U8 => {
            return Type::U8;
        }
        IrType::U16 => {
            return Type::U16;
        }
        IrType::U32 => {
            return Type::U32;
        }
        _ => {
        }
    }
    return Type::Never;
}

fn lw_ast_narrow_int(t: Type) -> bool {
    match t {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::U8 => {
            return true;
        }
        Type::U16 => {
            return true;
        }
        Type::U32 => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// V1a: `e` with each literal on the left of a `<<`/`>>` (reached as
/// lw_has_lit_shift reaches it) written `lit as t` when it fits `t`
/// (`irt`, the same type lowered), so the shift and what uses it are done
/// at `t`'s width: `(2 << a) - 62` in a u16 context is `((2 as u16) << a) -
/// 62`. A shift's amount is left alone.
fn lw_ctx_type_literals(e: Expr, t: Type, irt: IrType) -> Expr {
    match e {
        Expr::Binary(op, l, r) => {
            var le: Expr = lw_box_expr_unbox(l);
            if binop_eq(op, BinOp::Shl) || binop_eq(op, BinOp::Shr) {
                match le {
                    Expr::IntLit(v) => {
                        if lw_lit_fits(v, irt) {
                            return Expr::Binary(op, Box::new(Expr::Cast(Box::new(Expr::IntLit(v)), t)), Box::new(lw_box_expr_unbox(r)));
                        }
                        return e;
                    }
                    _ => {
                    }
                }
                return Expr::Binary(op, Box::new(lw_ctx_type_literals(le, t, irt)), Box::new(lw_box_expr_unbox(r)));
            }
            if lw_binop_ctx_flows(op) {
                return Expr::Binary(op, Box::new(lw_ctx_type_literals(le, t, irt)), Box::new(lw_ctx_type_literals(lw_box_expr_unbox(r), t, irt)));
            }
        }
        Expr::Unary(op, x) => {
            match op {
                UnaryOp::Not => {
                    return e;
                }
                _ => {
                }
            }
            return Expr::Unary(op, Box::new(lw_ctx_type_literals(lw_box_expr_unbox(x), t, irt)));
        }
        _ => {
        }
    }
    return e;
}

/// `print` shows a u64 as unsigned, on every backend: through the Fides
/// formatter (no runtime has an unsigned printer).
fn Lowerer_emit_print(self: & mut Lowerer, value: i64, ty: IrType) -> i64 {
    if ir_type_eq(ty, IrType::U64) {
        match Lowerer_lookup_func_ret_type(self, "u64_to_str") {
            OptType::Some(_) => {
                var env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var args: Vec<i64> = Vec::new();
                args.push(env);
                args.push(value);
                var s: i64 = Lowerer_emit_inst(self, Inst::Call("u64_to_str", args, lw_ptr_u8(), EffectSet_new()));
                return Lowerer_emit_inst(self, Inst::Print(s, lw_ptr_u8()));
            }
            OptType::None => {
            }
        }
    }
    return Lowerer_emit_inst(self, Inst::Print(value, ty));
}

pub fn Lowerer_infer_unary_type(self: & Lowerer, op: UnaryOp, expr: Expr) -> IrType {
    // As src/lower.rs: a float operand keeps its type, anything else
    // (including `!bool`) is i64.
    var t: IrType = Lowerer_infer_expr_type(self, expr);
    if ir_type_is_float(t) || lw_plain_int(t) {
        return t;
    }
    // BG156: `!b` on a bool is a bool (typed i64, C printed 1/0)
    match op {
        UnaryOp::Not => {
            if ir_type_eq(t, IrType::Bool) {
                return IrType::Bool;
            }
        }
        _ => {
        }
    }
    // CL10: `-d` on a unit is the unit
    match op {
        UnaryOp::Neg => {
            var un: str = lw_ir_struct_name(t);
            if str_len(un) > 0 && Lowerer_struct_dim(self, un) != 0 {
                return IrType::Struct(un);
            }
        }
        _ => {
        }
    }
    return IrType::I64;
}

pub fn Lowerer_infer_expr_type(self: & Lowerer, expr: Expr) -> IrType {
    match expr {
        Expr::IntLit(_) => {
            return IrType::I64;
        }
        Expr::FloatLit(_) => {
            return IrType::F64;
        }
        Expr::BoolLit(_) => {
            return IrType::Bool;
        }
        Expr::StringLit(_) => {
            return lw_ptr_u8();
        }
        Expr::Ident(name) => {
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(alloca) => {
                    match Lowerer_lookup_alloca_type(self, alloca) {
                        OptIrType::Some(t) => {
                            return t;
                        }
                        OptIrType::None => {
                        }
                    }
                }
                OptValueId::None => {
                }
            }
            // Fall back to AST type (e.g. for function parameters)
            match Lowerer_lookup_var_ast_type(self, name) {
                OptType::Some(ast_ty) => {
                    return Lowerer_lower_type(self, ast_ty);
                }
                OptType::None => {
                }
            }
            // Check parameter AST types (for f64 params, Vec element type inference, etc.)
            match Lowerer_lookup_param_type(self, name) {
                OptType::Some(ast_ty) => {
                    return Lowerer_lower_type(self, ast_ty);
                }
                OptType::None => {
                }
            }
            // A module-level global: its declared type (known-bugs 2g.72:
            // `g >> 60` on a global u64 was an i64 shift, filling with the
            // sign bit; 2g.74: `g[i]` on a global Vec). A local of that
            // name hides it (typed as before), a local with a slot as
            // well (M26: an assignment to it writes the local)
            match Lowerer_lookup_local(self, name) {
                OptValueId::Some(_) => {
                    return IrType::I64;
                }
                OptValueId::None => {
                }
            }
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(_) => {
                    return IrType::I64;
                }
                OptValueId::None => {
                }
            }
            match IrModule_get_global(& self.module, name) {
                OptGlobalLookup::Some(gty, _) => {
                    return gty;
                }
                OptGlobalLookup::None => {
                }
            }
            // BG276: a typed numeric const (registered as `Cast(expr, T)`)
            // has its declared type, so `CB / 2` on a u64 const is a u64
            // division and `CU + CU` on a u8 const a u8 add (was i64)
            match Lowerer_lookup_constant(self, name) {
                OptExpr::Some(cx) => {
                    match cx {
                        Expr::Cast(_, cty) => {
                            return Lowerer_lower_type(self, cty);
                        }
                        _ => {
                        }
                    }
                }
                OptExpr::None => {
                }
            }
            return IrType::I64;
        }
        Expr::Index(iarr, _iidx) => {
            // As src/lower.rs: String slicing gives a String, Vec indexing
            // the element type, array indexing the array's element type.
            var iarr_ty: IrType = Lowerer_infer_expr_type(self, lw_box_expr_unbox(iarr));
            if ir_type_is_opaque_named(iarr_ty, "String") {
                return IrType::Opaque("String");
            }
            if ir_type_is_opaque_named(iarr_ty, "Vec") {
                match ir_type_generic_elem(iarr_ty) {
                    OptIrType::Some(et) => {
                        return et;
                    }
                    OptIrType::None => {
                        return IrType::I64;
                    }
                }
            }
            match iarr_ty {
                IrType::Ptr(pinner) => {
                    match box_ir_type_unbox(pinner) {
                        IrType::Array(aelem, _) => {
                            return box_ir_type_unbox(aelem);
                        }
                        _ => {
                        }
                    }
                }
                IrType::Array(aelem2, _) => {
                    return box_ir_type_unbox(aelem2);
                }
                _ => {
                }
            }
            return IrType::I64;
        }
        Expr::Binary(op, left, right) => {
            return Lowerer_infer_binop_type(self, op, lw_box_expr_unbox(left), lw_box_expr_unbox(right));
        }
        Expr::Unary(op, e) => {
            return Lowerer_infer_unary_type(self, op, lw_box_expr_unbox(e));
        }
        Expr::Call(callee, _) => {
            return Lowerer_lookup_func_ret_ty_ir(self, callee);
        }
        Expr::FieldAccess(obj, field) => {
            var obj_ty: IrType = Lowerer_infer_expr_type(self, lw_box_expr_unbox(obj));
            match obj_ty {
                IrType::Struct(name) => {
                    match IrModule_get_struct(& self.module, name) {
                        OptStructLayout::Some(layout) => {
                            var fi: i64 = 0;
                            while fi < layout.fields.len() {
                                if layout.fields.get(fi).name == field {
                                    return layout.fields.get(fi).ty;
                                }
                                fi = fi + 1;
                            }
                        }
                        OptStructLayout::None => {
                        }
                    }
                }
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(name2) => {
                            match IrModule_get_struct(& self.module, name2) {
                                OptStructLayout::Some(layout) => {
                                    var fi: i64 = 0;
                                    while fi < layout.fields.len() {
                                        if layout.fields.get(fi).name == field {
                                            return layout.fields.get(fi).ty;
                                        }
                                        fi = fi + 1;
                                    }
                                }
                                OptStructLayout::None => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            return IrType::I64;
        }
        Expr::Cast(_, ty) => {
            return Lowerer_lower_type(self, ty);
        }
        Expr::StructLit(name, _, _) => {
            return IrType::Struct(name);
        }
        Expr::EnumLit(enum_name, _, _) => {
            return IrType::Struct(enum_name);
        }
        Expr::TupleLit(_) => {
            return IrType::Opaque("tuple");
        }
        Expr::MethodCall(recv, method, _) => {
            // Check if this is Box::new(x), Vec::new(), etc.
            match lw_box_expr_unbox(recv) {
                Expr::Ident(name) => {
                    if name == "Box" && method == "new" {
                        return IrType::Ptr(Box::new(IrType::U8));
                    }
                    if name == "Vec" && method == "new" {
                        return IrType::Opaque("Vec");
                    }
                    if name == "HashMap" && method == "new" {
                        return IrType::Opaque("HashMap");
                    }
                    if name == "String" && method == "from" {
                        return IrType::Opaque("String");
                    }
                    // Check if it's an enum constructor
                    match Lowerer_lookup_enum(self, name) {
                        OptEnumDef::Some(_) => {
                            return IrType::Struct(name);
                        }
                        OptEnumDef::None => {
                        }
                    }
                }
                _ => {
                }
            }
            // Builtin Vec methods - infer from receiver type
            // First try IR type, then fall back to AST type
            var recv_ty: IrType = Lowerer_infer_expr_type(self, lw_box_expr_unbox(recv));
            // Through a `&mut Vec` / `&Vec` reference, as the dispatch does
            match recv_ty {
                IrType::Ptr(rin) => {
                    match box_ir_type_unbox(rin) {
                        IrType::Generic(rn, rargs) => {
                            if rn == "Vec" || rn == "HashMap" {
                                recv_ty = IrType::Generic(rn, rargs);
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            // If IR type is I64 or Opaque, try AST type for generic info
            var use_ast_elem: bool = false;
            var ast_elem_ty: IrType = IrType::I64;
            match recv_ty {
                IrType::Generic(name, gargs) => {
                    if name == "Vec" {
                        var elem_ty: IrType = IrType::I64;
                        if gargs.len() > 0 {
                            elem_ty = gargs.get(0);
                        }
                        if method == "push" || method == "set" || method == "clear" || method == "insert" || method == "reverse" || method == "extend" || method == "truncate" || method == "sort" || method == "for_each" {
                            return IrType::Void;
                        }
                        if method == "pop" || method == "get" || method == "remove" || method == "first" || method == "last" {
                            return word_repr(elem_ty);
                        }
                        if method == "len" || method == "find" || method == "position" {
                            return IrType::I64;
                        }
                        if method == "is_empty" || method == "contains" || method == "any" || method == "all" {
                            return IrType::Bool;
                        }
                        if method == "capacity" {
                            return IrType::I64;
                        }
                        if method == "clone" || method == "map" || method == "filter" {
                            var clone_args: Vec<IrType> = Vec::new();
                            clone_args.push(elem_ty);
                            return IrType::Generic("Vec", clone_args);
                        }
                        if method == "fold" {
                            return IrType::I64;
                        }
                    }
                }
                IrType::Opaque(oname) => {
                    if oname == "Vec" {
                        // Try to get element type from AST type annotation
                        match lw_box_expr_unbox(recv) {
                            Expr::Ident(vname) => {
                                match Lowerer_lookup_var_ast_type(self, vname) {
                                    OptType::Some(at) => {
                                        match at {
                                            Type::Generic(gname, gargs) => {
                                                if gname == "Vec" && gargs.len() > 0 {
                                                    ast_elem_ty = Lowerer_lower_type(self, gargs.get(0));
                                                    use_ast_elem = true;
                                                }
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                    OptType::None => {
                                    }
                                }
                            }
                            _ => {
                                // a field (of a generic instance too), an
                                // index, a call: its AST type
                                // (Lowerer_vec_elem_ir_of)
                                var fet: Type = Lowerer_rc_vec_elem_ast(self, lw_box_expr_unbox(recv));
                                match fet {
                                    Type::Infer => {
                                    }
                                    _ => {
                                        ast_elem_ty = Lowerer_lower_type(self, fet);
                                        use_ast_elem = true;
                                    }
                                }
                            }
                        }
                    }
                }
                _ => {
                }
            }
            // a receiver lowered as a plain word (a type-parameter field):
            // its AST type (Lowerer_rc_vec_elem_ast answers only for a Vec)
            if !use_ast_elem {
                var wet: Type = Lowerer_rc_vec_elem_ast(self, lw_box_expr_unbox(recv));
                match wet {
                    Type::Infer => {
                    }
                    _ => {
                        ast_elem_ty = Lowerer_lower_type(self, wet);
                        use_ast_elem = true;
                    }
                }
            }
            if use_ast_elem {
                if method == "pop" || method == "get" || method == "remove" || method == "first" || method == "last" {
                    return word_repr(ast_elem_ty);
                }
                if method == "clone" || method == "map" || method == "filter" {
                    var clone_args: Vec<IrType> = Vec::new();
                    clone_args.push(ast_elem_ty);
                    return IrType::Generic("Vec", clone_args);
                }
            }
            // Fallback: look up mangled function name
            var struct_name: str = "";
            match recv_ty {
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(n) => {
                            struct_name = n;
                        }
                        _ => {
                        }
                    }
                }
                IrType::Struct(n) => {
                    struct_name = n;
                }
                IrType::Generic(n, _) => {
                    struct_name = n;
                }
                IrType::Opaque(n) => {
                    struct_name = n;
                }
                _ => {
                }
            }
            if struct_name == "String" {
                var string_ret: IrType = lw_string_method_ret_ty(method);
                if !ir_type_eq(string_ret, IrType::I64) {
                    return string_ret;
                }
            }
            if struct_name == "HashMap" {
                var map_ret: IrType = lw_map_method_ret_ty(method, recv_ty);
                if !ir_type_eq(map_ret, IrType::I64) {
                    return map_ret;
                }
            }
            if str_len(struct_name) > 0 {
                return Lowerer_lookup_func_ret_ty_ir(self, struct_name + "_" + method);
            }
            return Lowerer_lookup_func_ret_ty_ir(self, method);
        }
        Expr::Yield(e) => {
            return Lowerer_infer_expr_type(self, lw_box_expr_unbox(e));
        }
        Expr::NamedArg(name, e) => {
            return Lowerer_infer_expr_type(self, lw_box_expr_unbox(e));
        }
        // An if-expression has its first branch's value type, a match its arms'
        Expr::If(_, then_block, else_block) => {
            match if_branch_tail_expr(lw_value_tail(then_block)) {
                OptExpr::Some(te) => {
                    return Lowerer_infer_expr_type(self, te);
                }
                OptExpr::None => {
                }
            }
            match else_block {
                OptStmts::Some(es) => {
                    match if_branch_tail_expr(lw_value_tail(es)) {
                        OptExpr::Some(ee) => {
                            return Lowerer_infer_expr_type(self, ee);
                        }
                        OptExpr::None => {
                        }
                    }
                }
                OptStmts::None => {
                }
            }
            return IrType::Void;
        }
        Expr::Match(_, arms) => {
            return Lowerer_infer_match_type(self, lw_value_arms(arms));
        }
        Expr::Coalesce(cl, cr) => {
            return Lowerer_coalesce_ir_type(self, lw_box_expr_unbox(cl), lw_box_expr_unbox(cr));
        }
        _ => {
            return IrType::I64;
        }
    }
    return IrType::I64;
}

/// BG230: the payload type of the Option `left` when it is a str, a Vec or
/// a map (`left ?? d` is then an owner of its own), else Infer.
fn Lowerer_coalesce_own_type(self: & mut Lowerer, left: Expr) -> Type {
    match lw_rc_strip_ref(Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, left))) {
        Type::Generic(gname, gargs) => {
            if gname == "Option" && gargs.len() == 1 {
                var pt: Type = gargs.get(0);
                var k: i64 = Lowerer_rc_kind(self, pt);
                if k == RC_STR || k == RC_VEC || k == RC_MAP {
                    return pt;
                }
            }
        }
        _ => {
        }
    }
    return Type::Infer;
}

/// The type of `opt ?? default` (known-bugs 2g.54): the Option's payload
/// type when it is a string or a float, else I64 (the payload word, as
/// before). An Option whose type is unknown here takes the type of a
/// string or float default.
pub fn Lowerer_coalesce_ir_type(self: & Lowerer, left: Expr, right: Expr) -> IrType {
    match Lowerer_infer_expr_ast_type(self, left) {
        Type::Generic(gname, gargs) => {
            if gname == "Option" && gargs.len() == 1 {
                var pt: IrType = Lowerer_lower_type(self, gargs.get(0));
                if ir_type_is_float(pt) || ir_type_eq(pt, lw_ptr_u8()) {
                    return pt;
                }
                // BG273: a narrow integer or a bool as its own type (the
                // payload's low bytes; the word's upper bytes are not
                // defined for it): `Some(-1i8) ?? 0` was 255
                if lw_narrow_word(pt) {
                    return pt;
                }
                return IrType::I64;
            }
        }
        _ => {
        }
    }
    var dt: IrType = Lowerer_infer_expr_type(self, right);
    if ir_type_is_float(dt) || ir_type_eq(dt, lw_ptr_u8()) {
        return dt;
    }
    return IrType::I64;
}

/// BG273/BG277: an integer type narrower than a word, or bool: an
/// Option/Result payload of it is read as that type (its low bytes).
fn lw_narrow_word(t: IrType) -> bool {
    return ir_type_is_int(t) && ir_type_size(t) < 8;
}

/// The result type of String method `method`. core's String_* functions
/// take and return a string as i64, so the kind of result comes from this
/// table (the same as in src/lower.rs): a string result then prints and
/// concatenates as a string. I64 for a method returning a number.
fn lw_string_method_ret_ty(method: str) -> IrType {
    if method == "push_str" || method == "to_string" || method == "trim" || method == "replace" || method == "char_at" || method == "to_uppercase" || method == "to_lowercase" || method == "repeat" || method == "clone" || method == "substring" {
        return IrType::Opaque("String");
    }
    if method == "is_empty" || method == "contains" || method == "starts_with" || method == "ends_with" {
        return IrType::Bool;
    }
    if method == "split" {
        var parts: Vec<IrType> = Vec::new();
        parts.push(IrType::Opaque("String"));
        return IrType::Generic("Vec", parts);
    }
    return IrType::I64;
}

/// The result type of HashMap method `method` on a receiver of type
/// `recv_ty`, for the methods whose core HashMap_* function returns the
/// result as i64 (as in src/lower.rs). I64 otherwise.
/// Are the values of the map `recv` (IR type `recv_ty`) f64s? From the IR
/// type's arguments (HashMap<K, f64>), else from its AST type.
fn Lowerer_map_values_f64(self: & Lowerer, recv: Expr, recv_ty: IrType) -> bool {
    var rt: IrType = recv_ty;
    match rt {
        IrType::Ptr(inner) => {
            rt = box_ir_type_unbox(inner);
        }
        _ => {
        }
    }
    match rt {
        IrType::Generic(gn, gargs) => {
            if gn == "HashMap" && gargs.len() == 2 {
                return ir_type_eq(gargs.get(1), IrType::F64);
            }
        }
        _ => {
        }
    }
    var kv: Vec<Type> = Lowerer_rc_map_kv_ast(self, recv);
    if kv.len() == 2 {
        match Lowerer_resolve_type(self, kv.get(1)) {
            Type::F64 => {
                return true;
            }
            _ => {
            }
        }
    }
    return false;
}

/// BG268: whether `recv` is a map of f32 values (Lowerer_map_values_f64's
/// test for f32).
fn Lowerer_map_values_f32(self: & Lowerer, recv: Expr, recv_ty: IrType) -> bool {
    var rt: IrType = recv_ty;
    match rt {
        IrType::Ptr(inner) => {
            rt = box_ir_type_unbox(inner);
        }
        _ => {
        }
    }
    match rt {
        IrType::Generic(gn, gargs) => {
            if gn == "HashMap" && gargs.len() == 2 {
                return ir_type_eq(gargs.get(1), IrType::F32);
            }
        }
        _ => {
        }
    }
    var kv: Vec<Type> = Lowerer_rc_map_kv_ast(self, recv);
    if kv.len() == 2 {
        match Lowerer_resolve_type(self, kv.get(1)) {
            Type::F32 => {
                return true;
            }
            _ => {
            }
        }
    }
    return false;
}

fn lw_map_method_ret_ty(method: str, recv_ty: IrType) -> IrType {
    if method == "clone" {
        match recv_ty {
            IrType::Ptr(inner) => {
                return box_ir_type_unbox(inner);
            }
            _ => {
                return recv_ty;
            }
        }
    }
    if method == "is_empty" || method == "contains" || method == "contains_key" {
        return IrType::Bool;
    }
    // A typed map (HashMap<K, V>) gives its key and value types (release
    // D14/RT: `.get` was always an i64 whatever V was)
    var kv: Vec<IrType> = Vec::new();
    var rt: IrType = recv_ty;
    match rt {
        IrType::Ptr(inner) => {
            rt = box_ir_type_unbox(inner);
        }
        _ => {
        }
    }
    match rt {
        IrType::Generic(gn, gargs) => {
            if gn == "HashMap" && gargs.len() == 2 {
                kv = gargs;
            }
        }
        _ => {
        }
    }
    if kv.len() == 2 && (method == "get" || method == "get_or" || method == "get_i" || method == "get_or_i") && !ir_type_is_float(kv.get(1)) {
        return word_repr(kv.get(1));
    }
    if method == "keys" {
        var key_args: Vec<IrType> = Vec::new();
        if kv.len() == 2 {
            key_args.push(kv.get(0));
        } else {
            key_args.push(IrType::Ptr(Box::new(IrType::U8)));
        }
        return IrType::Generic("Vec", key_args);
    }
    if method == "values" {
        var value_args: Vec<IrType> = Vec::new();
        if kv.len() == 2 {
            value_args.push(kv.get(1));
        } else {
            value_args.push(IrType::I64);
        }
        return IrType::Generic("Vec", value_args);
    }
    return IrType::I64;
}

pub fn Lowerer_lookup_func_ret_ty_ir(self: & Lowerer, name: str) -> IrType {
    // Check module functions (CS4: read in place, lw_fn_at)
    var fat: i64 = lw_fn_at(& self.module, name);
    if fat >= 0 {
        return self.module.functions.get(fat).func.ret_ty;
    }
    // Check extern functions (CS4: through extern_index)
    var xat: i64 = Lowerer_extern_at(self, name);
    if xat >= 0 {
        return self.module.extern_functions.get(xat).ret;
    }
    // roadmap L8F: a type's name (Lowerer_lower_call_expr); LG9: gensym
    if name == "type_name_of" || name == "p_type_name" || name == "gensym" {
        return lw_ptr_u8();
    }
    // Check impl methods (mangled name)
    // The name should already be mangled at this point
    return IrType::I64;
}

/// A function declared `-> f64`/`-> f32` may return an integer expression
/// (`return 1;`): convert it numerically, as `val x: f64 = 1;` does.
pub fn Lowerer_coerce_return(self: & mut Lowerer, val: i64) -> i64 {
    var ret_ty: IrType = self.current_func.ret_ty;
    var val_ty: IrType = Lowerer_get_value_type(self, val);
    if ir_type_is_float(ret_ty) && ir_type_is_int(val_ty) {
        return Lowerer_lower_cast(self, val, val_ty, ret_ty);
    }
    return val;
}

/// `val` as a value of the float type `want` when it is an integer: the
/// conversion written out (reference §3.3: an integer becomes a float). It is
/// made where a value enters a float slot or parameter: a declaration, an
/// assignment, a call. The C backend converted it by its own assignment and
/// the interpreter did not; the native backend read the integer's bits as the
/// float (`val f: f64 = n` printed 0.000..., `half(5)` got 0.0).
pub fn Lowerer_int_to_float_value(self: & mut Lowerer, val: i64, want: IrType) -> i64 {
    if !ir_type_is_float(want) {
        return val;
    }
    var vt: IrType = Lowerer_get_value_type(self, val);
    if !ir_type_is_int(vt) {
        return val;
    }
    return Lowerer_lower_cast(self, val, vt, want);
}

/// 2^n as a float (exact for 0 <= n <= 1023).
fn lw_f2i_pow2(n: i64) -> f64 {
    var r: f64 = 1.0;
    var i: i64 = 0;
    while i < n {
        r = r * 2.0;
        i = i + 1;
    }
    return r;
}

/// D21 (reference §4.6, decided Nov 17): `x as T` for a float x and an
/// integer type T truncates toward zero; a value below T's range (-inf
/// too) gives T's minimum, one above it (+inf too) T's maximum, NaN gives
/// 0, and it never panics. The backends' FloatToInt (C's cast, cvttsd2si,
/// fcvtzs, fcvt) is only defined in range, so it runs only there:
///   x >= lo ? (hi > x ? FloatToInt(x) : max) : (lo > x ? min : 0)
/// where [lo, hi) are the floats whose truncation fits T (both powers of
/// two, exact in f32 and f64). Every comparison is false for NaN on every
/// backend (only == and != look at "unordered"). u64 values from 2^63 on
/// are converted as x - 2^63 with the top bit put back, since the
/// backends convert to a signed word.
fn Lowerer_lower_f2i_sat(self: & mut Lowerer, val: i64, src_ty: IrType, dst_ty: IrType) -> i64 {
    var bits: i64 = ir_type_size(dst_ty) * 8;
    var unsigned: bool = ir_type_is_unsigned(dst_ty);
    var lo_f: f64 = 0.0;
    var hi_f: f64 = lw_f2i_pow2(bits);
    var lo_i: i64 = 0;
    // u64: every bit set
    var hi_i: i64 = - 1;
    if !unsigned {
        hi_f = lw_f2i_pow2(bits - 1);
        lo_f = 0.0 - hi_f;
        if bits >= 64 {
            hi_i = 9223372036854775807;
            lo_i = - 9223372036854775807 - 1;
        } else {
            hi_i = (1 << (bits - 1)) - 1;
            lo_i = 0 - (1 << (bits - 1));
        }
    } else if bits < 64 {
        hi_i = (1 << bits) - 1;
    }
    var slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(dst_ty, Lowerer_current_region(self)));
    var lo_c: i64 = Lowerer_emit_inst(self, Inst::ConstFloat(lo_f, src_ty));
    var ge_lo: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::GtEq, val, lo_c, IrType::Bool));
    var chk_hi: i64 = Lowerer_new_block(self);
    var below: i64 = Lowerer_new_block(self);
    var conv: i64 = Lowerer_new_block(self);
    var above: i64 = Lowerer_new_block(self);
    var at_lo: i64 = Lowerer_new_block(self);
    var at_nan: i64 = Lowerer_new_block(self);
    var merge: i64 = Lowerer_new_block(self);
    Lowerer_emit_terminator(self, Inst::Branch(ge_lo, chk_hi, below));

    // x >= lo: under the upper end?
    Lowerer_set_current_block(self, chk_hi);
    var hi_c: i64 = Lowerer_emit_inst(self, Inst::ConstFloat(hi_f, src_ty));
    var lt_hi: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Gt, hi_c, val, IrType::Bool));
    Lowerer_emit_terminator(self, Inst::Branch(lt_hi, conv, above));

    // in range
    Lowerer_set_current_block(self, conv);
    if unsigned && bits >= 64 {
        var top_c: i64 = Lowerer_emit_inst(self, Inst::ConstFloat(lw_f2i_pow2(63), src_ty));
        var ge_top: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::GtEq, val, top_c, IrType::Bool));
        var big_b: i64 = Lowerer_new_block(self);
        var small_b: i64 = Lowerer_new_block(self);
        Lowerer_emit_terminator(self, Inst::Branch(ge_top, big_b, small_b));
        Lowerer_set_current_block(self, big_b);
        var low_part: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Sub, val, top_c, src_ty));
        var low_i: i64 = Lowerer_emit_inst(self, Inst::FloatToInt(low_part, src_ty, IrType::I64));
        var top_bit: i64 = Lowerer_emit_inst(self, Inst::ConstInt(- 9223372036854775807 - 1, IrType::I64));
        var big_i: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::BitXor, low_i, top_bit, IrType::I64));
        var big_u: i64 = Lowerer_emit_inst(self, Inst::BitCast(big_i, IrType::I64, dst_ty));
        Lowerer_emit_inst(self, Inst::Store(slot, big_u, OptIrType::None));
        Lowerer_emit_terminator(self, Inst::Jump(merge));
        Lowerer_set_current_block(self, small_b);
    }
    var in_i: i64 = Lowerer_emit_inst(self, Inst::FloatToInt(val, src_ty, dst_ty));
    Lowerer_emit_inst(self, Inst::Store(slot, in_i, OptIrType::None));
    Lowerer_emit_terminator(self, Inst::Jump(merge));

    // x >= hi, +inf
    Lowerer_set_current_block(self, above);
    var hi_v: i64 = Lowerer_emit_inst(self, Inst::ConstInt(hi_i, dst_ty));
    Lowerer_emit_inst(self, Inst::Store(slot, hi_v, OptIrType::None));
    Lowerer_emit_terminator(self, Inst::Jump(merge));

    // not x >= lo: below the range (-inf), or NaN
    Lowerer_set_current_block(self, below);
    var lo_c2: i64 = Lowerer_emit_inst(self, Inst::ConstFloat(lo_f, src_ty));
    var lt_lo: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Gt, lo_c2, val, IrType::Bool));
    Lowerer_emit_terminator(self, Inst::Branch(lt_lo, at_lo, at_nan));
    Lowerer_set_current_block(self, at_lo);
    var lo_v: i64 = Lowerer_emit_inst(self, Inst::ConstInt(lo_i, dst_ty));
    Lowerer_emit_inst(self, Inst::Store(slot, lo_v, OptIrType::None));
    Lowerer_emit_terminator(self, Inst::Jump(merge));
    Lowerer_set_current_block(self, at_nan);
    var zero_v: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, dst_ty));
    Lowerer_emit_inst(self, Inst::Store(slot, zero_v, OptIrType::None));
    Lowerer_emit_terminator(self, Inst::Jump(merge));

    Lowerer_set_current_block(self, merge);
    return Lowerer_emit_inst(self, Inst::Load(slot, dst_ty));
}

pub fn Lowerer_lower_cast(self: & mut Lowerer, val: i64, src_ty: IrType, dst_ty: IrType) -> i64 {
    // If types are the same, no cast needed
    if ir_type_eq(src_ty, dst_ty) {
        return val;
    }

    // Int to Int (different sizes): extend or truncate
    if ir_type_is_int(src_ty) && ir_type_is_int(dst_ty) {
        var src_size: i64 = ir_type_size(src_ty);
        var dst_size: i64 = ir_type_size(dst_ty);
        // V1b: signed to an unsigned type of the same or a greater width
        // below 64 bits: the sign extension, then the bits above the target
        // width zeroed (`(0 - 64) as i8 as u16` is 65472; run, emit and
        // --nat kept the 64-bit sign-extended word, -64)
        if ir_type_is_signed(src_ty) && ir_type_is_unsigned(dst_ty) && dst_size < 8 && dst_size >= src_size {
            var su_mask: i64 = 255;
            if dst_size == 2 {
                su_mask = 65535;
            } else if dst_size == 4 {
                su_mask = 4294967295;
            }
            var su_wide: i64 = val;
            if dst_size > src_size {
                su_wide = Lowerer_emit_inst(self, Inst::IntExtend(val, src_ty, dst_ty));
            } else {
                su_wide = Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
            }
            var su_mask_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(su_mask, dst_ty));
            return Lowerer_emit_inst(self, Inst::BinOp(BinOp::BitAnd, su_wide, su_mask_val, dst_ty));
        }
        if dst_size > src_size {
            return Lowerer_emit_inst(self, Inst::IntExtend(val, src_ty, dst_ty));
        } else if dst_size < src_size {
            return Lowerer_emit_inst(self, Inst::IntTrunc(val, src_ty, dst_ty));
        } else {
            return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
        }
    }
    // Int to Float
    if ir_type_is_int(src_ty) && ir_type_is_float(dst_ty) {
        return Lowerer_emit_inst(self, Inst::IntToFloat(val, src_ty, dst_ty));
    }
    // Float to Int (D21, reference §4.6: saturating, Lowerer_lower_f2i_sat)
    if ir_type_is_float(src_ty) && ir_type_is_int(dst_ty) {
        if self.has_current_func && !ir_type_eq(dst_ty, IrType::Bool) {
            return Lowerer_lower_f2i_sat(self, val, src_ty, dst_ty);
        }
        return Lowerer_emit_inst(self, Inst::FloatToInt(val, src_ty, dst_ty));
    }
    // Float to Float (different sizes)
    if ir_type_is_float(src_ty) && ir_type_is_float(dst_ty) {
        return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
    }
    // Ptr to Ptr
    if ir_type_is_ptr(src_ty) && ir_type_is_ptr(dst_ty) {
        Lowerer_set_value_type(self, val, dst_ty);
        return val;
    }
    // Ptr to Bool (null check)
    if ir_type_is_ptr(src_ty) && ir_type_eq(dst_ty, IrType::Bool) {
        var null_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        return Lowerer_emit_inst(self, Inst::BinOp(BinOp::Neq, val, null_val, IrType::Bool));
    }
    // Bool to Int
    if ir_type_eq(src_ty, IrType::Bool) && ir_type_is_int(dst_ty) {
        return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
    }
    // Default: bitcast
    return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
}

/// The type of a value-form `match`: the join of its arms' values (their
/// last expressions, lw_join_value_ty). It took the first expression
/// statement of any arm, so `change(&mut b); b.len()` gave the match the
/// void call's type and the value was lost (0), and an arm of a narrower
/// integer type truncated the others.
pub fn Lowerer_infer_match_type(self: & Lowerer, arms: Vec<MatchArm>) -> IrType {
    var res: IrType = IrType::Void;
    var res_lit: bool = true;
    var any: bool = false;
    var i: i64 = 0;
    while i < arms.len() {
        match if_branch_tail_expr(arms.get(i).body) {
            OptExpr::Some(te) => {
                var tt: IrType = Lowerer_infer_expr_type(self, te);
                var tl: bool = lw_is_int_lit(te);
                if !any {
                    res = tt;
                    res_lit = tl;
                    any = true;
                } else {
                    res = lw_join_value_ty(res, res_lit, tt, tl);
                    res_lit = res_lit && tl;
                }
            }
            OptExpr::None => {
            }
        }
        i = i + 1;
    }
    if !any {
        return IrType::I64;
    }
    return res;
}

fn lw_is_int_lit(e: Expr) -> bool {
    match e {
        Expr::IntLit(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// The join of two branch value types of an `if`/`match` used as a value:
/// a branch that has no value (void, or one that leaves) gives way to the
/// other; of two integer types the wider wins, except that a bare integer
/// literal takes the other branch's type (`if c { x_u8 } else { 0 }` stays
/// u8). Otherwise the first.
fn lw_join_value_ty(a: IrType, a_lit: bool, b: IrType, b_lit: bool) -> IrType {
    if ir_type_eq(a, IrType::Void) || ir_type_eq(a, IrType::Never) {
        return b;
    }
    if ir_type_eq(b, IrType::Void) || ir_type_eq(b, IrType::Never) {
        return a;
    }
    if ir_type_is_int(a) && ir_type_is_int(b) {
        if a_lit && !b_lit {
            return b;
        }
        if b_lit && !a_lit {
            return a;
        }
        if ir_type_size(b) > ir_type_size(a) {
            return b;
        }
    }
    return a;
}

/// A branch's value converted to the integer type of the `if`/`match`
/// result slot (a narrower branch extended), so the slot is written whole.
fn Lowerer_branch_value_to(self: & mut Lowerer, v: i64, slot_ty: IrType) -> i64 {
    var vt: IrType = Lowerer_get_value_type(self, v);
    if ir_type_is_int(vt) && ir_type_is_int(slot_ty) && ir_type_size(vt) != ir_type_size(slot_ty) {
        return Lowerer_lower_cast(self, v, vt, slot_ty);
    }
    return v;
}

pub fn Lowerer_emit_sret_copy(self: & mut Lowerer, src_ptr: i64) {
    // Copy struct data from src_ptr to sret
    match self.current_sret {
        OptValueId::Some(sret) => {
            // Determine struct name from sret type
            var sret_ty: IrType = Lowerer_get_value_type(self, sret);
            var struct_name: str = "";
            var arr_copied: bool = false;
            match sret_ty {
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(n) => {
                            struct_name = n;
                        }
                        // An array sret is one flat copy of elem*count
                        // bytes (arrays hold no shareable fields)
                        IrType::Array(ae, an) => {
                            var _ac: i64 = Lowerer_emit_inst(self, Inst::StructCopy(sret, src_ptr, IrType::Array(ae, an)));
                            arr_copied = true;
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            if !arr_copied {
                Lowerer_emit_struct_copy(self, src_ptr, sret, struct_name);
            }
        }
        OptValueId::None => {
        }
    }
}

pub fn Lowerer_emit_struct_copy(self: & mut Lowerer, src_ptr: i64, dst_ptr: i64, struct_name: str) {
    // A temporary (a literal, a call's result) or a last use hands its Vec
    // fields over: they need no copy-on-write share
    var fresh_src: bool = Lowerer_fresh_struct(self, src_ptr);
    // Copy each field
    match IrModule_get_struct(& self.module, struct_name) {
        OptStructLayout::Some(layout) => {
            var fi: i64 = 0;
            while fi < layout.fields.len() {
                var field_ty: IrType = layout.fields.get(fi).ty;
                var src_field: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(src_ptr, fi, field_ty));
                var dst_field: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(dst_ptr, fi, field_ty));
                // For struct-typed fields (enums stored inline), use
                // load_enum_field to extract the full inline data, then Store
                // with explicit store_ty to memcpy it into the destination.
                // For scalar fields, use Load+Store as before.
                match field_ty {
                    IrType::Struct(_) => {
                        var val: i64 = Lowerer_load_enum_field(self, src_field, field_ty);
                        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(dst_field, val, OptIrType::Some(field_ty)));
                    }
                    _ => {
                        var fv: i64 = Lowerer_emit_inst(self, Inst::Load(src_field, field_ty));
                        // a Vec field is shared copy-on-write
                        var fvec: bool = false;
                        match field_ty {
                            IrType::Generic(gn, _) => {
                                fvec = gn == "Vec";
                            }
                            IrType::Opaque(oname) => {
                                fvec = oname == "Vec";
                            }
                            _ => {
                            }
                        }
                        if fvec && !fresh_src {
                            fv = Lowerer_emit_vec_share(self, fv, field_ty);
                        }
                        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(dst_field, fv, OptIrType::None));
                    }
                }
                fi = fi + 1;
            }
        }
        OptStructLayout::None => {
        }
    }
}

// --- f64 to bits conversion -----------------------------------------------

// B5: Convert f64 to IEEE 754 bit pattern via C runtime helper.
// This preserves NaN payloads, -0.0, and Inf bit patterns that are
// lost when converting to a decimal string. Used by ConstFloat codegen
// to emit union compound literals matching the Rust compiler's output.
pub fn f64_to_bits(f: f64) -> i64 {
    return p_f64_to_bits(f);
}

pub fn f32_to_bits(f: f64) -> i64 {
    return p_f32_to_bits(f);
}

pub fn Lowerer_emit_defers(self: & mut Lowerer) {
    // Emit defer blocks in reverse order (LIFO). One whose statement may not
    // have run (it is in a branch or a loop of this function) runs only if it
    // did: its flag says so (reference §5.5). An exit lowered before the
    // statement (a `return` ahead of it in the same block) has none to run.
    var i: i64 = self.defer_stack.len() - 1;
    while i >= 0 {
        var entry: DeferEntry = self.defer_stack.get(i);
        if entry.flag < 0 {
            Lowerer_lower_stmts(self, entry.body);
        } else {
            var flag_val: i64 = Lowerer_emit_inst(self, Inst::Load(entry.flag, IrType::I64));
            var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            var ran: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Neq, flag_val, zero, IrType::Bool));
            var run_block: i64 = Lowerer_new_block(self);
            var after_block: i64 = Lowerer_new_block(self);
            Lowerer_emit_terminator(self, Inst::Branch(ran, run_block, after_block));
            Lowerer_set_current_block(self, run_block);
            // BG198: with the names bound as at the `defer` statement
            Lowerer_defer_run(self, entry);
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(after_block));
            }
            Lowerer_set_current_block(self, after_block);
        }
        i = i - 1;
    }
}

/// BG198: the names `entry`'s block reads, bound as they are at its `defer`
/// statement (lowered now), for Lowerer_defer_run. The block was lowered at
/// each exit with the names in scope there: a variable of the block holding
/// the `defer` had been dropped (read after it was freed), and a variable of
/// the same name around the exit was read instead. A variable that owns its
/// value and is dropped before the function's end (§5.5: the blocks run at
/// function exit) gets `keep`, an entry-block slot the deferred block reads
/// and then drops: one declared in the `defer`'s own block moves its value
/// there and the rest of the block uses `keep` as the variable; one of an
/// enclosing inner block gives `keep` an owner of its value as it is now.
/// Any other variable keeps its slot, a parameter its value. `keep` is one
/// slot for every lowering of the statement; a run drops what it held.
fn Lowerer_defer_capture(self: & mut Lowerer, entry: DeferEntry) -> DeferEntry {
    var free: Vec<str> = Vec::new();
    var inner_names: Vec<str> = Vec::new();
    Lowerer_collect_free_vars(self, entry.body, & mut free, & mut inner_names);
    var out: DeferEntry = DeferEntry_new(entry.body, entry.flag, entry.line);
    var fi: i64 = 0;
    while fi < free.len() {
        var n: str = free.get(fi);
        var ast: Type = Type::Infer;
        match Lowerer_lookup_var_ast_type(self, n) {
            OptType::Some(vt) => {
                ast = vt;
            }
            OptType::None => {
            }
        }
        // the keep slot an earlier lowering of the statement made
        var prev_keep: i64 = - 1;
        var pk: i64 = 0;
        while pk < entry.names.len() {
            if entry.names.get(pk) == n && entry.keeps.get(pk) >= 0 {
                prev_keep = entry.keeps.get(pk);
            }
            pk = pk + 1;
        }
        var slot: i64 = - 1;
        match Lowerer_lookup_alloca(self, n) {
            OptValueId::Some(s) => {
                slot = s;
            }
            OptValueId::None => {
            }
        }
        if slot >= 0 {
            var sty: IrType = IrType::I64;
            match Lowerer_lookup_alloca_type(self, slot) {
                OptIrType::Some(st) => {
                    sty = st;
                }
                OptIrType::None => {
                }
            }
            var keep: i64 = - 1;
            var oty: Type = Type::Infer;
            // the scope that owns the variable (own_marks: 0 the function's)
            var oj: i64 = - 1;
            if self.own_on && self.own_marks.len() > 0 {
                var j: i64 = self.own_slots.len() - 1;
                while j >= 0 && oj < 0 {
                    if self.own_slots.get(j).slot == slot {
                        oj = j;
                    }
                    j = j - 1;
                }
            }
            if oj >= 0 {
                oty = self.own_slots.get(oj).ty;
                var kind: i64 = Lowerer_rc_kind(self, oty);
                var inner_m: i64 = self.own_marks.get(self.own_marks.len() - 1);
                var top_end: i64 = self.own_slots.len() + 1;
                if self.own_marks.len() > 1 {
                    top_end = self.own_marks.get(1);
                }
                var mem_ok: bool = kind != RC_MEM;
                match sty {
                    IrType::Struct(_) => {
                        mem_ok = true;
                    }
                    _ => {
                    }
                }
                // a variable of the function's own scope lives until the
                // deferred blocks ran (Lowerer_rc_drop_all comes after them)
                if mem_ok && oj >= top_end {
                    keep = prev_keep;
                    if keep < 0 {
                        keep = Lowerer_rc_new_slot(self, sty, oty);
                        Lowerer_defer_own_keep(self, keep, oty);
                    }
                    Lowerer_insert_alloca_type(self, keep, sty);
                    // what an earlier run of the statement left in it
                    Lowerer_rc_drop_slot(self, OwnSlot {
                        slot: keep, ty: oty
                    });
                    if kind == RC_MEM {
                        Lowerer_emit_inst(self, Inst::Store(keep, slot, OptIrType::Some(sty)));
                        if oj < inner_m {
                            Lowerer_rc_call_mem(self, "__own_dup_", keep, oty);
                        }
                    } else {
                        var kv: i64 = Lowerer_emit_inst(self, Inst::Load(slot, sty));
                        if oj < inner_m {
                            kv = Lowerer_rc_dup(self, kv, oty);
                        }
                        Lowerer_emit_inst(self, Inst::Store(keep, kv, OptIrType::None));
                    }
                    if oj >= inner_m {
                        // moved: the rest of the block uses `keep`
                        Lowerer_rc_clear_slot(self, slot, oty);
                        Lowerer_insert_alloca(self, n, keep);
                    }
                }
            }
            out.names.push(n);
            if keep >= 0 {
                out.slots.push(keep);
            } else {
                out.slots.push(slot);
            }
            out.irtys.push(sty);
            out.asts.push(ast);
            out.params.push(- 1);
            out.keeps.push(keep);
            out.otys.push(oty);
        } else {
            // a parameter (its value is the function's whole body long)
            match Lowerer_lookup_local(self, n) {
                OptValueId::Some(lv) => {
                    var is_param: bool = false;
                    var pi: i64 = 0;
                    while pi < self.current_func.params.len() {
                        if self.current_func.params.get(pi).id == lv {
                            is_param = true;
                        }
                        pi = pi + 1;
                    }
                    if is_param {
                        out.names.push(n);
                        out.slots.push(- 1);
                        out.irtys.push(IrType::I64);
                        out.asts.push(ast);
                        out.params.push(lv);
                        out.keeps.push(- 1);
                        out.otys.push(Type::Infer);
                    }
                }
                OptValueId::None => {
                }
            }
        }
        fi = fi + 1;
    }
    return out;
}

/// BG198: `keep` owns its value until the function ends: an owned slot of
/// the function's own scope, so an assignment to the variable it stands for
/// drops the old value and every exit drops it after the deferred blocks
/// ran (Lowerer_rc_drop_all). It goes first in own_slots: the marks of the
/// scopes, loops, transactions and handle blocks open in this function
/// (each the own_slots length at its start) move up by one.
fn Lowerer_defer_own_keep(self: & mut Lowerer, keep: i64, t: Type) {
    if !self.own_on || self.own_marks.len() == 0 || Lowerer_rc_kind(self, t) == RC_NONE {
        return;
    }
    var fresh: Vec<OwnSlot> = Vec::new();
    fresh.push(OwnSlot {
        slot: keep, ty: t
    });
    var i: i64 = 0;
    while i < self.own_slots.len() {
        fresh.push(self.own_slots.get(i));
        i = i + 1;
    }
    self.own_slots = fresh;
    // own_marks[0] is the function's own scope (0): keep is in it
    i = 1;
    while i < self.own_marks.len() {
        self.own_marks.set(i, self.own_marks.get(i) + 1);
        i = i + 1;
    }
    i = 0;
    while i < self.own_loop_slots.len() {
        self.own_loop_slots.set(i, self.own_loop_slots.get(i) + 1);
        i = i + 1;
    }
    i = 0;
    while i < self.txn_stack.len() {
        var tx: LwTxn = self.txn_stack.get(i);
        tx.mark = tx.mark + 1;
        self.txn_stack.set(i, tx);
        i = i + 1;
    }
    i = 0;
    while i < g_lw_hx_slots.len() && i < g_lw_hx_fn.len() {
        if g_lw_hx_fn.get(i) == self.current_func.name {
            g_lw_hx_slots.set(i, g_lw_hx_slots.get(i) + 1);
        }
        i = i + 1;
    }
    i = 0;
    while i < g_lw_hx_rx_slots.len() {
        if g_lw_hx_rx_fn.get(i) == self.current_func.name {
            g_lw_hx_rx_slots.set(i, g_lw_hx_rx_slots.get(i) + 1);
        }
        i = i + 1;
    }
}

/// BG198: lower a deferred block at an exit with its names bound as at its
/// `defer` statement (Lowerer_defer_capture), then drop the values kept for
/// it. The bindings end with it.
fn Lowerer_defer_run(self: & mut Lowerer, entry: DeferEntry) {
    var sa: i64 = self.allocas.len();
    var st: i64 = self.alloca_types.len();
    var sv: i64 = self.var_ast_types.len();
    var sl: i64 = self.current_func.locals.len();
    var k: i64 = 0;
    while k < entry.names.len() {
        var n: str = entry.names.get(k);
        if entry.slots.get(k) >= 0 {
            Lowerer_insert_alloca(self, n, entry.slots.get(k));
            Lowerer_insert_alloca_type(self, entry.slots.get(k), entry.irtys.get(k));
        } else {
            // hides a slot of the name around the exit
            Lowerer_insert_alloca(self, n, - 1);
            Lowerer_bind_local(self, n, entry.params.get(k));
        }
        match entry.asts.get(k) {
            Type::Infer => {
            }
            _ => {
                Lowerer_insert_var_ast_type(self, n, entry.asts.get(k));
            }
        }
        k = k + 1;
    }
    Lowerer_lower_stmts(self, entry.body);
    if self.own_on && !Lowerer_current_block_has_terminator(self) {
        k = 0;
        while k < entry.keeps.len() {
            if entry.keeps.get(k) >= 0 {
                Lowerer_rc_drop_slot(self, OwnSlot {
                    slot: entry.keeps.get(k), ty: entry.otys.get(k)
                });
            }
            k = k + 1;
        }
    }
    self.allocas.truncate(sa);
    self.alloca_types.truncate(st);
    self.var_ast_types.truncate(sv);
    self.current_func.locals.truncate(sl);
}

/// Emit PersistSave instructions for all @persist variables.
/// Called before every Return statement and at implicit function end.
pub fn Lowerer_emit_persist_saves(self: & mut Lowerer) {
    var n: i64 = self.current_func.persist_vars.len();
    var i: i64 = 0;
    while i < n {
        var entry: StringValueId = self.current_func.persist_vars.get(i);
        // Look up the actual type of the persist variable
        var load_ty: IrType = IrType::I64;
        match Lowerer_lookup_alloca_type(self, entry.id) {
            OptIrType::Some(ty) => {
                load_ty = ty;
            }
            OptIrType::None => {
            }
        }
        var loaded: i64 = Lowerer_emit_inst(self, Inst::Load(entry.id, load_ty));
        var _s: i64 = Lowerer_emit_inst(self, Inst::PersistSave(entry.name, loaded));
        i = i + 1;
    }
}

// --- ValueIdString helper -------------------------------------------------

pub struct ValueIdString {
    pub id: i64,
    pub name: str,
}

pub fn lw_ValueIdString_new(id: i64, name: str) -> ValueIdString {
    return ValueIdString {
        id: id, name: name
    };
}

// --- String parsing helpers -----------------------------------------------

pub fn str_parse_u64(s: str) -> OptU64 {
    // Simple parsing: trim whitespace, parse digits
    var trimmed: str = str_trim(s);
    if trimmed == "" {
        return OptU64::None;
    }
    var result: i64 = 0;
    var i: i64 = 0;
    var len: i64 = str_len(trimmed);
    while i < len {
        var c: i64 = str_byte_at(trimmed, i);
        if c < 48 || c > 57 {
            return OptU64::None;
        }
        // not a digit
        result = result * 10 + (c - 48);
        i = i + 1;
    }
    return OptU64::Some(result);
}

// --- Type inference helpers -----------------------------------------------

/// Infer Vec<T> element type from the let hint.
/// Returns IrType::I64 if no hint is available.
pub fn Lowerer_infer_vec_elem_type(self: & Lowerer) -> IrType {
    match self.let_hint {
        OptType::Some(ty) => {
            match ty {
                Type::Generic(name, args) => {
                    if name == "Vec" {
                        if args.len() > 0 {
                            return Lowerer_lower_type(self, args.get(0));
                        }
                    }
                    return IrType::I64;
                }
                _ => {
                    return IrType::I64;
                }
            }
        }
        OptType::None => {
            return IrType::I64;
        }
    }
    return IrType::I64;
}

/// Infer HashMap<K,V> key and value types from the let hint.
/// Returns (Opaque("String"), I64) if no hint is available.
pub fn Lowerer_infer_map_types(self: & Lowerer) -> MapTypes {
    match self.let_hint {
        OptType::Some(ty) => {
            match ty {
                Type::Generic(name, args) => {
                    if name == "HashMap" {
                        var key_ty: IrType = IrType::Opaque("String");
                        var val_ty: IrType = IrType::I64;
                        if args.len() > 0 {
                            key_ty = Lowerer_lower_type(self, args.get(0));
                        }
                        if args.len() > 1 {
                            val_ty = Lowerer_lower_type(self, args.get(1));
                        }
                        return MapTypes_new(key_ty, val_ty);
                    }
                    return MapTypes_new(IrType::Opaque("String"), IrType::I64);
                }
                _ => {
                    return MapTypes_new(IrType::Opaque("String"), IrType::I64);
                }
            }
        }
        OptType::None => {
            return MapTypes_new(IrType::Opaque("String"), IrType::I64);
        }
    }
    return MapTypes_new(IrType::Opaque("String"), IrType::I64);
}

pub struct MapTypes {
    pub key_ty: IrType,
    pub val_ty: IrType,
}

pub fn MapTypes_new(key_ty: IrType, val_ty: IrType) -> MapTypes {
    return MapTypes {
        key_ty: key_ty, val_ty: val_ty
    };
}

/// Infer a closure's return type from its body (last expression or return stmt).
/// Returns Type::I64 if no return expression is found.
pub fn Lowerer_infer_closure_ret_ty(self: & Lowerer, body: Vec<Stmt>) -> Type {
    var i: i64 = 0;
    while i < body.len() {
        match body.get(i) {
            Stmt::Return(expr, _) => {
                match expr {
                    OptBoxExpr::Some(e) => {
                        return Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(e));
                    }
                    OptBoxExpr::None => {
                        return Type::Void;
                    }
                }
            }
            Stmt::Expr(e, _) => {
                // Last expression in block (implicit return)
                return Lowerer_infer_expr_ast_type(self, e);
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return Type::I64;
}

/// Infer the AST type of an expression (for closure return type inference).
/// This is a simplified version - returns Type::I64 for most expressions.
pub fn Lowerer_infer_expr_ast_type(self: & Lowerer, expr: Expr) -> Type {
    match expr {
        Expr::IntLit(_) => {
            return Type::I64;
        }
        Expr::FloatLit(_) => {
            return Type::F64;
        }
        Expr::BoolLit(_) => {
            return Type::Bool;
        }
        Expr::StringLit(_) => {
            return Type::Str;
        }
        Expr::Cast(_, ty) => {
            return ty;
        }
        // As src/lower.rs infer_expr_ast_type: comparisons and logic are
        // bool, other binary ops and negation i64, a variable its recorded
        // AST type.
        Expr::Binary(op, _, _) => {
            if binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::GtEq) || binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
                return Type::Bool;
            }
            return Type::I64;
        }
        Expr::Ident(name) => {
            match Lowerer_lookup_var_ast_type(self, name) {
                OptType::Some(vt) => {
                    return vt;
                }
                OptType::None => {
                }
            }
            // or the parameter's (as src/lower.rs)
            match Lowerer_lookup_param_type(self, name) {
                OptType::Some(pt) => {
                    return pt;
                }
                OptType::None => {
                }
            }
            // or, in a closure, the type of what it captured
            var ici: i64 = 0;
            while ici < self.current_captures.len() {
                if self.current_captures.get(ici).name == name {
                    match self.current_captures.get(ici).ty {
                        Type::I64 => {
                        }
                        _ => {
                            return self.current_captures.get(ici).ty;
                        }
                    }
                }
                ici = ici + 1;
            }
            // A function's name used as a value: its signature, so a
            // variable holding it (`val g = cntr;`) calls it with the right
            // result type (stdlib-agent-bugs 22)
            var fat: i64 = HashMap_get(self.func_info_at, name);
            if fat > 0 && fat <= self.func_param_asts.len() {
                match Lowerer_lookup_func_ret_type(self, name) {
                    OptType::Some(frt) => {
                        return Type::Func(self.func_param_asts.get(fat - 1), Box::new(frt));
                    }
                    OptType::None => {
                    }
                }
            }
            return Type::I64;
        }
        Expr::Call(callee, _) => {
            // a call through a function value: the value's result type (a
            // variable or parameter is called before a function of that
            // name, as Lowerer_lower_call_expr_resolved does)
            match Lowerer_resolve_type(self, Lowerer_fn_value_type(self, callee)) {
                Type::Func(_, cfret) => {
                    return lw_box_type_unbox(cfret);
                }
                _ => {
                }
            }
            match Lowerer_lookup_func_ret_type(self, callee) {
                OptType::Some(ty) => {
                    return ty;
                }
                OptType::None => {
                    return Type::I64;
                }
            }
        }
        // A generic enum value knows its type arguments from its payload
        // (proposal 0002): `Option::Some(2.5)` is an Option<f64>, so a
        // match on it reads the payload as an f64.
        Expr::EnumLit(en, variant, args) => {
            return Lowerer_enum_lit_ast_type(self, en, variant, args);
        }
        Expr::StructLit(sln, slf, _) => {
            return Lowerer_struct_lit_ast_type(self, sln, slf);
        }
        // A tuple literal: the tuple of its elements' types (a
        // concatenation a string), so a variable holding it destructures
        // with its element types (its strings read as strings)
        Expr::TupleLit(tes) => {
            var tts: Vec<Type> = Vec::new();
            var tei: i64 = 0;
            while tei < tes.len() {
                tts.push(Lowerer_enum_arg_ast_type(self, tes.get(tei)));
                tei = tei + 1;
            }
            return Type::Tuple(tts);
        }
        // A field of a generic struct instance: its declared type with the
        // instance's type arguments
        Expr::FieldAccess(fobj, ffield) => {
            var ot: Type = Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(fobj));
            match ot {
                Type::Ref(inner, _) => {
                    ot = lw_box_type_unbox(inner);
                }
                _ => {
                }
            }
            match ot {
                Type::Generic(gn, gargs) => {
                    match Lowerer_lookup_struct(self, gn) {
                        OptStructDef::Some(sd) => {
                            var i: i64 = 0;
                            while i < sd.fields.len() {
                                if sd.fields.get(i).name == ffield {
                                    return lw_rc_subst(sd.fields.get(i).ty, sd.type_params, gargs);
                                }
                                i = i + 1;
                            }
                        }
                        OptStructDef::None => {
                        }
                    }
                }
                // A function-typed field of a plain struct: its signature
                // (stdlib-agent-bugs 30: `val f = c.h;` called f as an i64
                // function, and its str results were lost)
                Type::Named(pn) => {
                    match Lowerer_lookup_struct(self, pn) {
                        OptStructDef::Some(psd) => {
                            var pi: i64 = 0;
                            while pi < psd.fields.len() {
                                if psd.fields.get(pi).name == ffield {
                                    match Lowerer_resolve_type(self, psd.fields.get(pi).ty) {
                                        Type::Func(_, _) => {
                                            return psd.fields.get(pi).ty;
                                        }
                                        // a generic struct's instance (held
                                        // inline, Lowerer_held_ir): its
                                        // fields read with its type
                                        // arguments (`o.h.a` a string)
                                        Type::Generic(pgn, _) => {
                                            var pgk: bool = pgn != "Vec" && pgn != "HashMap" && pgn != "Box" && pgn != "Rc" && pgn != "Arc";
                                            match Lowerer_lookup_struct(self, pgn) {
                                                OptStructDef::Some(pgsd) => {
                                                    if pgk && pgsd.type_params.len() > 0 {
                                                        return psd.fields.get(pi).ty;
                                                    }
                                                }
                                                OptStructDef::None => {
                                                }
                                            }
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                pi = pi + 1;
                            }
                        }
                        OptStructDef::None => {
                        }
                    }
                }
                _ => {
                }
            }
            return Type::I64;
        }
        // `spawn f(..)` is a Future of what f returns; `await` gives it
        Expr::Spawn(sp) => {
            match lw_box_expr_unbox(sp) {
                Expr::Call(scallee, _) => {
                    match Lowerer_lookup_func_ret_type(self, scallee) {
                        OptType::Some(srt) => {
                            match srt {
                                Type::Generic(sgn, _) => {
                                    if sgn == "Future" {
                                        return srt;
                                    }
                                }
                                _ => {
                                }
                            }
                            var fa: Vec<Type> = Vec::new();
                            fa.push(srt);
                            return Type::Generic("Future", fa);
                        }
                        OptType::None => {
                        }
                    }
                }
                _ => {
                }
            }
            return Type::I64;
        }
        Expr::Await(aw) => {
            match Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(aw)) {
                Type::Generic(agn, aga) => {
                    if agn == "Future" && aga.len() == 1 {
                        return aga.get(0);
                    }
                }
                _ => {
                }
            }
            return Type::I64;
        }
        // What `unwrap` or `get` returns: the type argument of the receiver
        Expr::MethodCall(recv, m, margs) => {
            // `Rc::new(x)` and `Arc::new(x)` give an `Rc<T>` / `Arc<T>`
            // (BG275: T is x's type, so `get` on a variable bound without an
            // annotation reads the payload as Lowerer_lower_rc_new stored it)
            match lw_box_expr_unbox(recv) {
                Expr::Ident(rn) => {
                    if (rn == "Rc" || rn == "Arc") && m == "new" {
                        var ra: Vec<Type> = Vec::new();
                        var rpt: Type = Type::I64;
                        if margs.len() == 1 {
                            rpt = Lowerer_infer_expr_ast_type(self, margs.get(0));
                            match rpt {
                                Type::Infer => {
                                    rpt = Type::I64;
                                }
                                _ => {
                                }
                            }
                        }
                        ra.push(rpt);
                        return Type::Generic(rn, ra);
                    }
                }
                _ => {
                }
            }
            match Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(recv)) {
                Type::Generic(gn, gargs) => {
                    // BG275: `r.clone()` of an Rc/Arc is another handle of
                    // the same type, `r.get()` its payload, `r.count()` a
                    // number: a variable bound to one without an annotation
                    // (`val r2 = r.clone();`) keeps the Rc type, so its
                    // methods are lowered as Rc methods (Lowerer_lower_rc_method)
                    // instead of falling through to Vec_get / `count`
                    if (gn == "Rc" || gn == "Arc") && gargs.len() == 1 {
                        if m == "clone" {
                            return Type::Generic(gn, gargs);
                        }
                        if m == "get" {
                            return gargs.get(0);
                        }
                        if m == "count" {
                            return Type::I64;
                        }
                    }
                    if gargs.len() > 0 {
                        if (gn == "Option" || gn == "Result") && (m == "unwrap" || m == "unwrap_or" || m == "expect") {
                            return gargs.get(0);
                        }
                        // core's map/and_then/... keep the receiver's type
                        if (gn == "Option" || gn == "Result") && (m == "map" || m == "map_err" || m == "and_then" || m == "or" || m == "or_else" || m == "filter") {
                            return Type::Generic(gn, gargs);
                        }
                        // core's `ok`/`err` give an Option of that payload;
                        // `context`/`with_context` a Result whose error is a str
                        if gn == "Result" && gargs.len() > 1 && (m == "ok" || m == "err") {
                            var oargs: Vec<Type> = Vec::new();
                            if m == "err" {
                                oargs.push(gargs.get(1));
                            } else {
                                oargs.push(gargs.get(0));
                            }
                            return Type::Generic("Option", oargs);
                        }
                        if (gn == "Result" || gn == "Option") && (m == "context" || m == "with_context") {
                            var cargs: Vec<Type> = Vec::new();
                            cargs.push(gargs.get(0));
                            cargs.push(Type::Str);
                            return Type::Generic("Result", cargs);
                        }
                        if gn == "Vec" && (m == "get" || m == "pop" || m == "first" || m == "last") {
                            return gargs.get(0);
                        }
                    }
                }
                _ => {
                }
            }
            return Type::I64;
        }
        // `opt ?? default` is the Option's payload type (known-bugs 2g.54)
        Expr::Coalesce(cl, cr) => {
            match Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(cl)) {
                Type::Generic(cgn, cga) => {
                    if cgn == "Option" && cga.len() == 1 {
                        return cga.get(0);
                    }
                }
                _ => {
                }
            }
            return Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(cr));
        }
        // A closure: its signature (the result type as
        // Lowerer_lower_closure_expr gives the closure), so a variable
        // holding it calls it with the right result type
        Expr::Closure(clps, clbody, clret) => {
            var clpts: Vec<Type> = Vec::new();
            var clpi: i64 = 0;
            while clpi < clps.len() {
                clpts.push(clps.get(clpi).ty);
                clpi = clpi + 1;
            }
            match clret {
                OptType::Some(clrt) => {
                    return Type::Func(clpts, Box::new(clrt));
                }
                OptType::None => {
                    return Type::Func(clpts, Box::new(Lowerer_infer_closure_ret_ty(self, clbody)));
                }
            }
        }
        // `try { stmts; expr }` is a Result<T, i64>, T the type of its last
        // expression statement (reference §4.9). Before, it was typed i64:
        // `try { "a" + "b" }` gave `unwrap()` a string's address as a number
        Expr::TryBlock(tbs) => {
            var targs: Vec<Type> = Vec::new();
            targs.push(Lowerer_try_value_type(self, tbs));
            targs.push(Type::I64);
            return Type::Generic("Result", targs);
        }
        _ => {
            return Type::I64;
        }
    }
    return Type::I64;
}

/// BG183: the dyn type name of a generic instance (`Slot<i64> as dyn
/// Show`). mono names an instance's methods `Slot__show__i64`, which no
/// dispatch finds (every backend calls `<type name>_<method>`), so each
/// method of `trait_name` gets a forwarder `<D>_<method>` to the instance's
/// (Lowerer_dyn_forwarder): D is the impl's prefix (lw_tq_prefix: a
/// qualified impl's dyn values stay apart) and the instance's suffix,
/// `Slot__i64`, and D is listed among the trait's impls as a plain type is.
/// "" when `t` is no generic instance or a method has no instance (mono
/// makes one for each method called on the type).
fn Lowerer_dyn_generic_name(self: & mut Lowerer, t: Type, trait_name: str) -> str {
    var gname: str = "";
    match t {
        Type::Generic(gn, ga) => {
            if ga.len() > 0 {
                gname = gn;
            }
        }
        _ => {
        }
    }
    if str_len(gname) == 0 || gname == "Vec" || gname == "HashMap" || gname == "Box" || gname == "Rc" || gname == "Arc" {
        return "";
    }
    var methods: Vec<str> = Vec::new();
    var ti: i64 = 0;
    while ti < self.module.trait_methods.len() {
        if self.module.trait_methods.get(ti).name == trait_name {
            methods = self.module.trait_methods.get(ti).items;
        }
        ti = ti + 1;
    }
    if methods.len() == 0 {
        return "";
    }
    var tstr: str = type_to_str(t);
    var reals: Vec<i64> = Vec::new();
    var suffix: str = "";
    var mi: i64 = 0;
    while mi < methods.len() {
        var pre: str = gname + "__" + methods.get(mi) + "__";
        var at: i64 = - 1;
        var fi: i64 = 0;
        while fi < self.func_param_names.len() && fi < self.func_param_asts.len() {
            if at < 0 && str_starts_with(self.func_param_names.get(fi).key, pre) {
                var pas: Vec<Type> = self.func_param_asts.get(fi);
                if pas.len() > 0 && type_to_str(lw_rc_strip_ref(Lowerer_resolve_type(self, pas.get(0)))) == tstr {
                    at = fi;
                }
            }
            fi = fi + 1;
        }
        if at < 0 {
            return "";
        }
        reals.push(at);
        if mi == 0 {
            var r0: str = self.func_param_names.get(at).key;
            suffix = str_slice(r0, str_len(pre), str_len(r0));
        }
        mi = mi + 1;
    }
    var d: str = lw_tq_prefix(gname, trait_name) + "__" + suffix;
    mi = 0;
    while mi < methods.len() {
        Lowerer_dyn_forwarder(self, d, methods.get(mi), reals.get(mi));
        mi = mi + 1;
    }
    var found: bool = false;
    var j: i64 = 0;
    while j < self.module.trait_impls.len() {
        if self.module.trait_impls.get(j).name == trait_name {
            if !lw_c_str_vec_contains(self.module.trait_impls.get(j).items, d) {
                self.module.trait_impls.get(j).items.push(d);
            }
            found = true;
        }
        j = j + 1;
    }
    if !found {
        var types: Vec<str> = Vec::new();
        types.push(d);
        self.module.trait_impls.push(StringVecStr_new(trait_name, types));
    }
    // BG184: a method returning a struct is called through its wrapper
    mi = 0;
    while mi < methods.len() {
        match Lowerer_lookup_func_ret_type(self, "dyn:" + trait_name + "::" + methods.get(mi)) {
            OptType::Some(drt) => {
                Lowerer_dyn_sret_wrapper(self, d, methods.get(mi), Lowerer_lower_type(self, drt));
            }
            OptType::None => {
            }
        }
        mi = mi + 1;
    }
    return d;
}

/// BG183: `fn <d>_<method>(params..) -> R { return <instance>(params..); }`
/// for the function at `at` in func_param_names (the instance's), lowered
/// now as Lowerer_spawn_wrapper lowers its wrapper, and known as the
/// method `method` of type `d` (Lowerer_dyn_sret_wrapper reads it).
fn Lowerer_dyn_forwarder(self: & mut Lowerer, d: str, method: str, at: i64) {
    var fname: str = d + "_" + method;
    if lw_fn_at(& self.module, fname) >= 0 {
        return;
    }
    var real: str = self.func_param_names.get(at).key;
    var names: Vec<str> = self.func_param_names.get(at).val;
    var tys: Vec<Type> = self.func_param_asts.get(at);
    var ret: Type = Type::Void;
    match Lowerer_lookup_func_ret_type(self, real) {
        OptType::Some(rt) => {
            ret = rt;
        }
        OptType::None => {
        }
    }
    var params: Vec<Param> = Vec::new();
    var cargs: Vec<Expr> = Vec::new();
    var i: i64 = 0;
    while i < names.len() && i < tys.len() {
        params.push(Param_new(names.get(i), tys.get(i), false));
        cargs.push(Expr::Ident(names.get(i)));
        i = i + 1;
    }
    var call: Expr = Expr::Call(real, cargs);
    var body: Vec<Stmt> = Vec::new();
    var is_void: bool = false;
    match ret {
        Type::Void => {
            is_void = true;
        }
        _ => {
        }
    }
    if is_void {
        body.push(Stmt::Expr(call, 0));
    } else {
        body.push(Stmt::Return(OptBoxExpr::Some(Box::new(call)), 0));
    }
    var wf: Func = Func_new_full(fname, params, ret, body, false);
    var saved_func: IrFunction = self.current_func;
    var saved_has_func: bool = self.has_current_func;
    var saved_allocas: Vec<StringValueIdEntry> = self.allocas;
    var saved_alloca_types: Vec<I64IrTypeEntry> = self.alloca_types;
    var saved_var_ast_types: Vec<StringTypeEntry> = self.var_ast_types;
    var saved_block: i64 = self.current_block;
    var saved_sret: OptValueId = self.current_sret;
    var saved_captures: Vec<ClosureCapture> = self.current_captures;
    self.current_captures = Vec::new();
    Lowerer_insert_func_ret_type(self, fname, ret);
    Lowerer_insert_impl_method(self, d, method, wf);
    Lowerer_lower_func(self, wf);
    self.current_func = saved_func;
    self.has_current_func = saved_has_func;
    self.allocas = saved_allocas;
    self.alloca_types = saved_alloca_types;
    self.var_ast_types = saved_var_ast_types;
    Lowerer_ix_reset_tables(self);
    self.current_block = saved_block;
    self.current_sret = saved_sret;
    self.current_captures = saved_captures;
}

/// BG184: `<d>_<method>__dsret(env, receiver, args..) -> i64` when the
/// method returns a struct (or an enum): a dispatch calls `<type>_<method>(
/// env, receiver, args..)` on every backend, with no room for the result
/// pointer the method takes first, so a `dyn` call of it calls this, which
/// calls `<d>_<method>` with a heap block for the result and returns the
/// block's address (as Lowerer_emit_task_adapter does for a task). Made
/// once; nothing when `d` has no such method.
fn Lowerer_dyn_sret_wrapper(self: & mut Lowerer, d: str, method: str, ret_ty: IrType) {
    var sn: str = "";
    // BG387: a fixed-array result too (returned through a result pointer
    // since BG126, as a struct is)
    var arr_ret: bool = false;
    match ret_ty {
        IrType::Struct(rsn) => {
            sn = rsn;
        }
        IrType::Array(_, _) => {
            arr_ret = true;
        }
        _ => {
        }
    }
    if str_len(sn) == 0 && !arr_ret {
        return;
    }
    var wname: str = d + "_" + method + "__dsret";
    if lw_fn_at(& self.module, wname) >= 0 {
        return;
    }
    var mparams: Vec<Param> = Vec::new();
    match Lowerer_lookup_impl_method(self, d, method) {
        OptFunc::Some(mf) => {
            mparams = mf.params;
        }
        OptFunc::None => {
            return;
        }
    }
    if mparams.len() == 0 {
        return;
    }
    var w: IrFunction = IrFunction_new(wname, IrType::I64);
    var env_ty: IrType = lw_ptr_u8();
    var env_val: i64 = IrFunction_new_value(& mut w, ValueMeta_new(env_ty));
    w.params.push(ValueIdType_new(env_val, env_ty));
    var pvals: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < mparams.len() {
        // the receiver is the dyn value's pointer; the rest as the method
        // takes them (a struct by its address)
        var pty: IrType = lw_ptr_u8();
        if i > 0 {
            pty = Lowerer_lower_type(self, mparams.get(i).ty);
            match pty {
                IrType::Struct(_) => {
                    pty = IrType::Ptr(Box::new(pty));
                }
                IrType::Array(_, _) => {
                    pty = IrType::Ptr(Box::new(pty));
                }
                _ => {
                }
            }
        }
        var pv: i64 = IrFunction_new_value(& mut w, ValueMeta_new(pty));
        w.params.push(ValueIdType_new(pv, pty));
        pvals.push(pv);
        i = i + 1;
    }
    var prev_func: IrFunction = self.current_func;
    var prev_has: bool = self.has_current_func;
    var prev_block: i64 = self.current_block;
    self.current_func = w;
    self.current_func.name = wname;
    self.has_current_func = true;
    self.current_block = 0;
    self.current_func.current_block_idx = 0;
    var rsize: i64 = 8;
    if arr_ret {
        rsize = IrModule_type_size(& self.module, ret_ty);
    } else {
        match IrModule_get_struct(& self.module, sn) {
            OptStructLayout::Some(rl) => {
                rsize = rl.size;
            }
            OptStructLayout::None => {
            }
        }
    }
    if rsize < 8 {
        rsize = 8;
    }
    var rma: Vec<i64> = Vec::new();
    rma.push(Lowerer_emit_inst(self, Inst::ConstInt(rsize, IrType::I64)));
    var reff: EffectSet = EffectSet_new();
    EffectSet_add(& mut reff, Effect::Alloc);
    var rraw: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", rma, lw_ptr_u8(), reff));
    var heap: i64 = Lowerer_emit_inst(self, Inst::BitCast(rraw, lw_ptr_u8(), IrType::Ptr(Box::new(ret_ty))));
    var args: Vec<i64> = Vec::new();
    args.push(heap);
    args.push(env_val);
    i = 0;
    while i < pvals.len() {
        args.push(pvals.get(i));
        i = i + 1;
    }
    var eff: EffectSet = EffectSet_new();
    EffectSet_add(& mut eff, Effect::Read);
    EffectSet_add(& mut eff, Effect::Write);
    EffectSet_add(& mut eff, Effect::IO);
    EffectSet_add(& mut eff, Effect::Alloc);
    Lowerer_emit_inst(self, Inst::Call(d + "_" + method, args, IrType::Void, eff));
    var res: i64 = Lowerer_emit_inst(self, Inst::BitCast(heap, IrType::Ptr(Box::new(ret_ty)), IrType::I64));
    Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(res)));
    IrModule_add_function(& mut self.module, self.current_func);
    self.current_func = prev_func;
    self.has_current_func = prev_has;
    self.current_block = prev_block;
}

/// BG184: the wrappers of `method` (returning `ret_ty`) for every type a
/// `dyn <trait_name>` can hold.
fn Lowerer_dyn_sret_all(self: & mut Lowerer, trait_name: str, method: str, ret_ty: IrType) {
    var types: Vec<str> = Vec::new();
    var j: i64 = 0;
    while j < self.module.trait_impls.len() {
        if self.module.trait_impls.get(j).name == trait_name {
            var items: Vec<str> = self.module.trait_impls.get(j).items;
            var k: i64 = 0;
            while k < items.len() {
                types.push(items.get(k));
                k = k + 1;
            }
        }
        j = j + 1;
    }
    var i: i64 = 0;
    while i < types.len() {
        Lowerer_dyn_sret_wrapper(self, types.get(i), method, ret_ty);
        i = i + 1;
    }
}

/// BG181: the AST type `==` sees an operand as: a field's declared type
/// (with a generic instance's type arguments) and a Vec's element as
/// ownership finds them (Lowerer_rc_expr_type), an array's element, an
/// array literal's array, else the plain inference (I64 when unknown).
fn Lowerer_eq_ast_type(self: & Lowerer, e: Expr) -> Type {
    match e {
        Expr::Index(eqarr, _) => {
            match lw_rc_strip_ref(Lowerer_resolve_type(self, Lowerer_eq_ast_type(self, lw_box_expr_unbox(eqarr)))) {
                Type::Array(eqel, _) => {
                    return lw_box_type_unbox(eqel);
                }
                _ => {
                }
            }
        }
        Expr::ArrayLit(_, eqes) => {
            if eqes.len() > 0 {
                return Type::Array(Box::new(Lowerer_eq_ast_type(self, eqes.get(0))), eqes.len());
            }
        }
        _ => {
        }
    }
    var t: Type = Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, e));
    match t {
        Type::Infer => {
            return Lowerer_eq_ir_struct_type(self, e);
        }
        Type::I64 => {
            return Lowerer_eq_ir_struct_type(self, e);
        }
        _ => {
        }
    }
    return t;
}

/// BG181: an operand the AST types as i64 that is a struct by its IR type:
/// a variable bound to a plain struct literal (`val x = O { .. }`: such a
/// literal stays i64 for lowering, Lowerer_struct_lit_ast_type) as
/// Named(S), and a field of one as the field's declared type (`x.m`: an
/// Option<i64>). Else I64. Not a generic struct (its literal has its AST
/// type), a vecN or a unit (their own `==`).
fn Lowerer_eq_ir_struct_type(self: & Lowerer, e: Expr) -> Type {
    var fname: str = "";
    var on: str = "";
    match e {
        Expr::FieldAccess(eqfo, eqfn) => {
            fname = eqfn;
            on = lw_ir_struct_name(Lowerer_infer_expr_type(self, lw_box_expr_unbox(eqfo)));
        }
        _ => {
            on = lw_ir_struct_name(Lowerer_infer_expr_type(self, e));
        }
    }
    if str_len(on) == 0 || str_starts_with(on, "__") || is_vec_type_name(on) {
        return Type::I64;
    }
    match Lowerer_lookup_struct(self, on) {
        OptStructDef::Some(sd) => {
            if sd.type_params.len() > 0 || struct_dimension(sd.annotations) != 0 {
                return Type::I64;
            }
            if str_len(fname) == 0 {
                return Type::Named(on);
            }
            var i: i64 = 0;
            while i < sd.fields.len() {
                if sd.fields.get(i).name == fname {
                    return Lowerer_resolve_type(self, sd.fields.get(i).ty);
                }
                i = i + 1;
            }
        }
        OptStructDef::None => {
        }
    }
    return Type::I64;
}

fn lw_eq_is_ident(e: Expr) -> bool {
    match e {
        Expr::Ident(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

fn lw_eq_and(acc: Expr, first: bool, x: Expr) -> Expr {
    if first {
        return x;
    }
    return Expr::Binary(BinOp::And, Box::new(acc), Box::new(x));
}

fn lw_eq_of(a: Expr, b: Expr) -> Expr {
    return Expr::Binary(BinOp::Eq, Box::new(a), Box::new(b));
}

/// BG181: `match la { V(a..) => match ra { V(b..) => a0 == b0 && .., _ =>
/// false }, .. }` over every variant of enum `ed`, as `__eq_<Enum>`
/// (compiler.fd synthesize_enum_eq) compares a non-generic enum.
fn lw_eq_enum_match(ed: EnumDef, la: Expr, ra: Expr, tag: str) -> Expr {
    var arms: Vec<MatchArm> = Vec::new();
    var vi: i64 = 0;
    while vi < ed.variants.len() {
        var v: EnumVariant = ed.variants.get(vi);
        var n: i64 = 0;
        match v.data {
            OptParams::Some(ps) => {
                n = ps.len();
            }
            OptParams::None => {
            }
        }
        var abinds: Vec<Binding> = Vec::new();
        var bbinds: Vec<Binding> = Vec::new();
        var same: Expr = Expr::BoolLit(true);
        var i: i64 = 0;
        while i < n {
            var an: str = tag + "_a" + int_to_str(i);
            var bn: str = tag + "_b" + int_to_str(i);
            abinds.push(Binding_new(an, ""));
            bbinds.push(Binding_new(bn, ""));
            same = lw_eq_and(same, i == 0, lw_eq_of(Expr::Ident(an), Expr::Ident(bn)));
            i = i + 1;
        }
        var same_body: Vec<Stmt> = Vec::new();
        same_body.push(Stmt::Expr(same, 0));
        var inner: Vec<MatchArm> = Vec::new();
        inner.push(MatchArm_new(Pattern::EnumVariant(ed.name, v.name, bbinds), OptBoxExpr::None, same_body));
        if ed.variants.len() > 1 {
            var differ_body: Vec<Stmt> = Vec::new();
            differ_body.push(Stmt::Expr(Expr::BoolLit(false), 0));
            inner.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, differ_body));
        }
        var outer_body: Vec<Stmt> = Vec::new();
        outer_body.push(Stmt::Expr(Expr::Match(Box::new(ra), inner), 0));
        arms.push(MatchArm_new(Pattern::EnumVariant(ed.name, v.name, abinds), OptBoxExpr::None, outer_body));
        vi = vi + 1;
    }
    return Expr::Match(Box::new(la), arms);
}

/// BG181: `l == r` on values neither a word comparison nor a core function
/// decides, as an expression of comparisons that do: a generic enum
/// (`Option`, `Result`, ..: no `__eq_<Enum>` is made for one) by a match on
/// both, a tuple and an array element by element, a struct with no
/// `__eq_<S>` (one with an `Option` field, a generic struct's instance)
/// field by field; each part goes back through `==`. An operand read more
/// than once, or whose type a match would not see (a field), is bound
/// first, the whole then a block. None: compared as before.
fn Lowerer_eq_rewrite(self: & Lowerer, l: Expr, r: Expr) -> OptExpr {
    var t: Type = Lowerer_eq_ast_type(self, l);
    match t {
        Type::I64 => {
            t = Lowerer_eq_ast_type(self, r);
        }
        _ => {
        }
    }
    var tag: str = "__eqv" + int_to_str(self.var_ast_types.len());
    var pre: Vec<Stmt> = Vec::new();
    var la: Expr = l;
    var ra: Expr = r;
    var cmp: Expr = Expr::BoolLit(true);
    var kind: i64 = 0;
    var tname: str = "";
    match t {
        Type::Tuple(tts) => {
            if tts.len() == 0 {
                return OptExpr::None;
            }
            var an: Vec<str> = Vec::new();
            var bn: Vec<str> = Vec::new();
            var ti: i64 = 0;
            while ti < tts.len() {
                an.push(tag + "_a" + int_to_str(ti));
                bn.push(tag + "_b" + int_to_str(ti));
                cmp = lw_eq_and(cmp, ti == 0, lw_eq_of(Expr::Ident(tag + "_a" + int_to_str(ti)), Expr::Ident(tag + "_b" + int_to_str(ti))));
                ti = ti + 1;
            }
            pre.push(Stmt::LetTuple(an, l, 0, false));
            pre.push(Stmt::LetTuple(bn, r, 0, false));
            kind = 1;
        }
        Type::Array(_, alen) => {
            // (unrolled: a long array is left as it was)
            if alen <= 0 || alen > 64 {
                return OptExpr::None;
            }
            kind = 2;
        }
        Type::Named(nn) => {
            tname = nn;
        }
        Type::Generic(gn, _) => {
            tname = gn;
        }
        _ => {
        }
    }
    if str_len(tname) > 0 {
        match Lowerer_lookup_enum(self, tname) {
            OptEnumDef::Some(ed) => {
                // a non-generic enum has its __eq_<Enum>
                if ed.type_params.len() == 0 || ed.variants.len() == 0 {
                    return OptExpr::None;
                }
                // a scrutinee whose own type names the enum is matched in
                // place; any other (a field) is bound with the type found
                match lw_rc_strip_ref(Lowerer_resolve_type(self, Lowerer_infer_expr_ast_type(self, l))) {
                    Type::Generic(lgn, _) => {
                        if lgn != tname {
                            pre.push(Stmt::Let(tag + "_l", OptType::Some(t), l, false, false, Vec::new(), 0));
                            la = Expr::Ident(tag + "_l");
                        }
                    }
                    _ => {
                        pre.push(Stmt::Let(tag + "_l", OptType::Some(t), l, false, false, Vec::new(), 0));
                        la = Expr::Ident(tag + "_l");
                    }
                }
                match lw_rc_strip_ref(Lowerer_resolve_type(self, Lowerer_infer_expr_ast_type(self, r))) {
                    Type::Generic(rgn, _) => {
                        if rgn != tname {
                            pre.push(Stmt::Let(tag + "_r", OptType::Some(t), r, false, false, Vec::new(), 0));
                            ra = Expr::Ident(tag + "_r");
                        }
                    }
                    _ => {
                        pre.push(Stmt::Let(tag + "_r", OptType::Some(t), r, false, false, Vec::new(), 0));
                        ra = Expr::Ident(tag + "_r");
                    }
                }
                cmp = lw_eq_enum_match(ed, la, ra, tag);
                kind = 3;
            }
            OptEnumDef::None => {
                // a struct (not a tuple's layout, a vecN or a unit: those
                // have their own `==`) with no __eq_<S>
                if str_starts_with(tname, "__") || lw_fn_at(& self.module, "__eq_" + tname) >= 0 {
                    return OptExpr::None;
                }
                match Lowerer_lookup_struct(self, tname) {
                    OptStructDef::Some(_) => {
                        kind = 4;
                    }
                    OptStructDef::None => {
                        return OptExpr::None;
                    }
                }
            }
        }
    }
    if kind == 0 {
        return OptExpr::None;
    }
    // an array or a struct is read once for each element or field
    if kind == 2 || kind == 4 {
        if !lw_eq_is_ident(l) {
            pre.push(Stmt::Let(tag + "_l", OptType::Some(t), l, false, false, Vec::new(), 0));
            la = Expr::Ident(tag + "_l");
        }
        if !lw_eq_is_ident(r) {
            pre.push(Stmt::Let(tag + "_r", OptType::Some(t), r, false, false, Vec::new(), 0));
            ra = Expr::Ident(tag + "_r");
        }
    }
    if kind == 2 {
        match t {
            Type::Array(_, alen2) => {
                var ai: i64 = 0;
                while ai < alen2 {
                    cmp = lw_eq_and(cmp, ai == 0, lw_eq_of(Expr::Index(Box::new(la), Box::new(Expr::IntLit(ai))), Expr::Index(Box::new(ra), Box::new(Expr::IntLit(ai)))));
                    ai = ai + 1;
                }
            }
            _ => {
            }
        }
    }
    if kind == 4 {
        match Lowerer_lookup_struct(self, tname) {
            OptStructDef::Some(sd2) => {
                var fi: i64 = 0;
                while fi < sd2.fields.len() {
                    var fnm: str = sd2.fields.get(fi).name;
                    cmp = lw_eq_and(cmp, fi == 0, lw_eq_of(Expr::FieldAccess(Box::new(la), fnm), Expr::FieldAccess(Box::new(ra), fnm)));
                    fi = fi + 1;
                }
            }
            OptStructDef::None => {
            }
        }
    }
    if pre.len() == 0 {
        return OptExpr::Some(cmp);
    }
    pre.push(Stmt::Expr(cmp, 0));
    return OptExpr::Some(Expr::Block(pre));
}

/// BG423: the core function that compares two `HashMap<K, V>` by content
/// (proposal 0001 rule 5): keys of a string, integer or bool type, values
/// of a number, bool, string or float type; "" for any other map (its
/// handles are compared, as before).
fn lw_map_eq_fn(k: Type, v: Type) -> str {
    match k {
        Type::Str => {
        }
        _ => {
            if vec_eq_fn_for(Type::Generic("Vec", lw_va_one_type(k))) != "Vec_eq_words" {
                return "";
            }
        }
    }
    match v {
        Type::Str => {
            return "HashMap_eq_strs";
        }
        Type::F64 => {
            return "HashMap_eq_f64";
        }
        Type::F32 => {
            return "HashMap_eq_f32";
        }
        _ => {
        }
    }
    if vec_eq_fn_for(Type::Generic("Vec", lw_va_one_type(v))) == "Vec_eq_words" {
        return "HashMap_eq_words";
    }
    return "";
}

/// The core function that compares two values of the Vec type `t` by
/// content: Vec_eq_words for numbers and bools, Vec_eq_strs for strings,
/// Vec_eq_f64 / Vec_eq_f32 for floats (BG464: IEEE `==`, not the bits);
/// for a HashMap (BG423) HashMap_eq_*; "" for anything else (compared as
/// before).
pub fn vec_eq_fn_for(t: Type) -> str {
    match t {
        Type::Generic(gname, gargs) => {
            if gname == "HashMap" && gargs.len() == 2 {
                return lw_map_eq_fn(gargs.get(0), gargs.get(1));
            }
            if gname != "Vec" || gargs.len() != 1 {
                return "";
            }
            match gargs.get(0) {
                Type::Str => {
                    return "Vec_eq_strs";
                }
                Type::I8 => {
                    return "Vec_eq_words";
                }
                Type::I16 => {
                    return "Vec_eq_words";
                }
                Type::I32 => {
                    return "Vec_eq_words";
                }
                Type::I64 => {
                    return "Vec_eq_words";
                }
                Type::U8 => {
                    return "Vec_eq_words";
                }
                Type::U16 => {
                    return "Vec_eq_words";
                }
                Type::U32 => {
                    return "Vec_eq_words";
                }
                Type::U64 => {
                    return "Vec_eq_words";
                }
                Type::F64 => {
                    return "Vec_eq_f64";
                }
                Type::F32 => {
                    return "Vec_eq_f32";
                }
                Type::Bool => {
                    return "Vec_eq_words";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return "";
}

/// The type of `En::Variant(args)`: for a generic enum, its type parameters
/// bound from the payload arguments (i64 where none gives one).
/// The type an enum literal's argument binds its type parameter to: as
/// Lowerer_infer_expr_ast_type, except that `a + b` with a string on either
/// side is a string (that inference types every `+` as i64). Typed as an
/// integer, `Result::Err("bad: " + s)` was no temporary: a `return` then
/// took a second owner of its string and the literal was never dropped
/// (tests/leaks/regions.fd, Nov 16).
fn Lowerer_enum_arg_ast_type(self: & Lowerer, e: Expr) -> Type {
    match e {
        Expr::Binary(op, a, b) => {
            if binop_eq(op, BinOp::Add) {
                var ta: Type = Lowerer_enum_arg_ast_type(self, lw_box_expr_unbox(a));
                var tb: Type = Lowerer_enum_arg_ast_type(self, lw_box_expr_unbox(b));
                match ta {
                    Type::Str => {
                        return Type::Str;
                    }
                    _ => {
                    }
                }
                match tb {
                    Type::Str => {
                        return Type::Str;
                    }
                    _ => {
                    }
                }
            }
        }
        Expr::StrConcat(_, _) => {
            return Type::Str;
        }
        Expr::FString(_) => {
            return Type::Str;
        }
        _ => {
        }
    }
    return Lowerer_infer_expr_ast_type(self, e);
}

fn Lowerer_enum_lit_ast_type(self: & Lowerer, en: str, variant: str, args: Vec<Expr>) -> Type {
    match Lowerer_lookup_enum(self, en) {
        OptEnumDef::Some(ed) => {
            if ed.type_params.len() == 0 {
                return Type::Named(en);
            }
            var bound: Vec<Type> = Vec::new();
            var k: i64 = 0;
            while k < ed.type_params.len() {
                bound.push(Type::I64);
                k = k + 1;
            }
            var vi: i64 = 0;
            while vi < ed.variants.len() {
                if ed.variants.get(vi).name == variant {
                    match ed.variants.get(vi).data {
                        OptParams::Some(ps) => {
                            var pi: i64 = 0;
                            while pi < ps.len() && pi < args.len() {
                                match ps.get(pi).ty {
                                    Type::Named(pn) => {
                                        var ti: i64 = 0;
                                        while ti < ed.type_params.len() {
                                            if ed.type_params.get(ti) == pn {
                                                bound.set(ti, Lowerer_enum_arg_ast_type(self, args.get(pi)));
                                            }
                                            ti = ti + 1;
                                        }
                                    }
                                    _ => {
                                    }
                                }
                                pi = pi + 1;
                            }
                        }
                        OptParams::None => {
                        }
                    }
                }
                vi = vi + 1;
            }
            return Type::Generic(en, bound);
        }
        OptEnumDef::None => {
        }
    }
    return Type::I64;
}

/// BG203: the type the temporary of `En::Variant(args)` is dropped as. As
/// Lowerer_enum_lit_ast_type, except that a type parameter its AST type
/// leaves owning nothing is bound to the type its payload was owned as
/// (`owned`, one per argument): a `for x in v` variable over a Vec<str> has
/// no AST type, so `Option::Some(x)` was typed Option<i64> and its payload,
/// counted as a string from its IR type, was never dropped.
fn Lowerer_enum_lit_temp_type(self: & mut Lowerer, en: str, variant: str, args: Vec<Expr>, owned: Vec<Type>) -> Type {
    var t: Type = Lowerer_enum_lit_ast_type(self, en, variant, args);
    var bound: Vec<Type> = Vec::new();
    match t {
        Type::Generic(_, tb) => {
            bound = tb;
        }
        _ => {
            return t;
        }
    }
    match Lowerer_lookup_enum(self, en) {
        OptEnumDef::Some(ed) => {
            var vi: i64 = 0;
            while vi < ed.variants.len() {
                if ed.variants.get(vi).name == variant {
                    match ed.variants.get(vi).data {
                        OptParams::Some(ps) => {
                            var pi: i64 = 0;
                            while pi < ps.len() && pi < owned.len() {
                                var ok: i64 = Lowerer_rc_kind(self, owned.get(pi));
                                if ok == RC_STR || ok == RC_VEC || ok == RC_MAP {
                                    match ps.get(pi).ty {
                                        Type::Named(pn) => {
                                            var ti: i64 = 0;
                                            while ti < ed.type_params.len() && ti < bound.len() {
                                                if ed.type_params.get(ti) == pn && Lowerer_rc_kind(self, bound.get(ti)) == RC_NONE {
                                                    bound.set(ti, owned.get(pi));
                                                }
                                                ti = ti + 1;
                                            }
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                pi = pi + 1;
                            }
                        }
                        OptParams::None => {
                        }
                    }
                }
                vi = vi + 1;
            }
        }
        OptEnumDef::None => {
        }
    }
    return Type::Generic(en, bound);
}

/// Convert an IrType back to an AST Type (for capture type recovery).
pub fn ir_type_to_ast_type(ty: IrType) -> Type {
    match ty {
        IrType::I8 => {
            return Type::I8;
        }
        IrType::I16 => {
            return Type::I16;
        }
        IrType::I32 => {
            return Type::I32;
        }
        IrType::I64 => {
            return Type::I64;
        }
        IrType::U8 => {
            return Type::U8;
        }
        IrType::U16 => {
            return Type::U16;
        }
        IrType::U32 => {
            return Type::U32;
        }
        IrType::U64 => {
            return Type::U64;
        }
        IrType::F32 => {
            return Type::F32;
        }
        IrType::F64 => {
            return Type::F64;
        }
        IrType::Bool => {
            return Type::Bool;
        }
        IrType::Void => {
            return Type::Void;
        }
        IrType::Never => {
            return Type::Never;
        }
        IrType::Ptr(inner) => {
            return Type::Ref(Box::new(ir_type_to_ast_type(box_ir_type_unbox(inner))), false);
        }
        IrType::Struct(name) => {
            return Type::Named(name);
        }
        IrType::Array(elem, size) => {
            return Type::Array(Box::new(ir_type_to_ast_type(box_ir_type_unbox(elem))), size);
        }
        IrType::Opaque(name) => {
            return Type::Named(name);
        }
        IrType::Generic(name, args) => {
            var ast_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                ast_args.push(ir_type_to_ast_type(args.get(i)));
                i = i + 1;
            }
            return Type::Generic(name, ast_args);
        }
        _ => {
            return Type::I64;
        }
    }
    return Type::I64;
}

/// Lower a swizzle expression (e.g. v.xyx) by loading components and building a result vec.
pub fn Lowerer_lower_swizzle(self: & mut Lowerer, vec_name: str, struct_ptr: i64, swizzle: str) -> i64 {
    // Get the field indices from the swizzle pattern
    // swizzle_index supports xyzw, rgba, and stpq groups
    var indices: Vec<i64> = Vec::new();
    var si: i64 = 0;
    while si < str_len(swizzle) {
        var c: i64 = str_byte_at(swizzle, si);
        indices.push(swizzle_index(c));
        si = si + 1;
    }

    // Load each component from the source vec
    var components: Vec<i64> = Vec::new();
    var ci: i64 = 0;
    while ci < indices.len() {
        var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(struct_ptr, indices.get(ci), IrType::F64));
        components.push(Lowerer_emit_inst(self, Inst::Load(field_ptr, IrType::F64)));
        ci = ci + 1;
    }

    // Construct the result vec type
    var result_name: str = "vec3";
    var swizzle_len: i64 = str_len(swizzle);
    if swizzle_len == 2 {
        result_name = "vec2";
    } else if swizzle_len == 3 {
        result_name = "vec3";
    } else if swizzle_len == 4 {
        result_name = "vec4";
    }

    var result_ty: IrType = IrType::Struct(result_name);
    var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(result_ty, Lowerer_current_region(self)));

    // Store each component into the result struct
    var i: i64 = 0;
    while i < components.len() {
        var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(sret_ptr, i, IrType::F64));
        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, components.get(i), OptIrType::None));
        i = i + 1;
    }
    return sret_ptr;
}

/// CL10: the method `a op b` calls when `a` is a struct other than vecN that
/// has it (`Point_add`), or "".
pub fn Lowerer_struct_operator(self: & Lowerer, op: BinOp, left: Expr) -> str {
    if str_len(binop_operator_method(op)) == 0 {
        return "";
    }
    return Lowerer_struct_operator_ty(self, op, Lowerer_infer_expr_type(self, left));
}

/// Lowerer_struct_operator for a left operand whose type is known. A unit
/// (@dimension) is left to Lowerer_binop_plan: its method serves only an
/// operand it takes.
pub fn Lowerer_struct_operator_ty(self: & Lowerer, op: BinOp, left_ty: IrType) -> str {
    var m: str = binop_operator_method(op);
    if str_len(m) == 0 {
        return "";
    }
    var sname: str = lw_ir_struct_name(left_ty);
    if str_len(sname) == 0 || is_vec_type_name(sname) {
        return "";
    }
    if Lowerer_has_function(self, sname + "_" + m) && Lowerer_struct_dim(self, sname) == 0 {
        return m;
    }
    return "";
}

// ─── CL10: operators on units, and on a struct to the right ─────────────
// The same choices as the type checker (typechecker.fd section "units of
// measure"): the left struct's method; for a unit (a struct marked
// @dimension, ast.fd struct_dimension) the method only when it takes the
// operand, else the dimension rule; an f64 or integer on the left: the
// right struct's r-method (`rmul`), or for a unit the dimension rule.

/// The packed dimension of struct `name`, 0 when it is not a unit.
pub fn Lowerer_struct_dim(self: & Lowerer, name: str) -> i64 {
    match Lowerer_lookup_struct(self, name) {
        OptStructDef::Some(def) => {
            return struct_dimension(def.annotations);
        }
        OptStructDef::None => {
        }
    }
    return 0;
}

/// The unit whose dimension is `d` ("" when none: the type checker reported it).
fn Lowerer_dim_unit(self: & Lowerer, d: i64) -> str {
    var i: i64 = 0;
    while i < self.structs.len() {
        if struct_dimension(self.structs.get(i).val.annotations) == d {
            return self.structs.get(i).key;
        }
        i = i + 1;
    }
    return "";
}

/// The one field of unit `name` (the type checker requires exactly one f64).
fn Lowerer_dim_field(self: & Lowerer, name: str) -> str {
    match Lowerer_lookup_struct(self, name) {
        OptStructDef::Some(def) => {
            if def.fields.len() > 0 {
                return def.fields.get(0).name;
            }
        }
        OptStructDef::None => {
        }
    }
    return "value";
}

/// Whether an operand of IR type `ot` fits a method parameter of IR type `pt`.
fn lw_operand_fits(pt: IrType, ot: IrType) -> bool {
    if ir_type_is_float(pt) {
        return ir_type_is_float(ot);
    }
    if ir_type_is_int(pt) {
        return ir_type_is_int(ot);
    }
    var ps: str = lw_ir_struct_name(pt);
    var os: str = lw_ir_struct_name(ot);
    if str_len(ps) > 0 || str_len(os) > 0 {
        return ps == os;
    }
    return true;
}

/// Whether `sname.m` takes self and one operand of IR type `ot`.
fn Lowerer_operator_fits(self: & Lowerer, sname: str, m: str, ot: IrType) -> bool {
    if !Lowerer_has_function(self, sname + "_" + m) {
        return false;
    }
    match Lowerer_lookup_impl_method(self, sname, m) {
        OptFunc::Some(f) => {
            if f.params.len() != 2 {
                return false;
            }
            return lw_operand_fits(Lowerer_lower_type(self, f.params.get(1).ty), ot);
        }
        OptFunc::None => {
        }
    }
    // no AST of it (a generated method): as before, the method
    return true;
}

/// How `a op b` lowers: 0 as a plain operator (or vecN's own path), 1 the
/// left struct's method (`a.add(b)`), 2 the right struct's r-method
/// (`b.rmul(a)`), 3 the dimension rule on units (Lowerer_lower_dim_operator).
pub fn Lowerer_binop_plan(self: & Lowerer, op: BinOp, left_ty: IrType, right_ty: IrType) -> i64 {
    var m: str = binop_operator_method(op);
    if str_len(m) == 0 {
        return 0;
    }
    var lsn: str = lw_ir_struct_name(left_ty);
    if str_len(lsn) > 0 {
        if is_vec_type_name(lsn) {
            return 0;
        }
        var has_m: bool = Lowerer_has_function(self, lsn + "_" + m);
        if Lowerer_struct_dim(self, lsn) == 0 {
            if has_m {
                return 1;
            }
            return 0;
        }
        if has_m && Lowerer_operator_fits(self, lsn, m, right_ty) {
            return 1;
        }
        // the type checker rejected `unit + other` when the unit has `add`
        if has_m && (m == "add" || m == "sub" || m == "rem") {
            return 1;
        }
        return 3;
    }
    var rsn: str = lw_ir_struct_name(right_ty);
    if str_len(rsn) == 0 || is_vec_type_name(rsn) {
        return 0;
    }
    if Lowerer_operator_fits(self, rsn, "r" + m, left_ty) {
        return 2;
    }
    if Lowerer_struct_dim(self, rsn) != 0 && ir_type_is_float(left_ty) {
        return 3;
    }
    return 0;
}

/// Lowerer_binop_plan with the right operand's type inferred only when it
/// can matter (a literal on the right of a non-struct is never a struct).
pub fn Lowerer_binop_plan_exprs(self: & Lowerer, op: BinOp, left_ty: IrType, right: Expr) -> i64 {
    var lsn: str = lw_ir_struct_name(left_ty);
    if str_len(lsn) > 0 {
        if is_vec_type_name(lsn) {
            return 0;
        }
        if Lowerer_struct_dim(self, lsn) == 0 {
            if Lowerer_has_function(self, lsn + "_" + binop_operator_method(op)) {
                return 1;
            }
            return 0;
        }
    } else {
        match right {
            Expr::IntLit(_) => {
                return 0;
            }
            Expr::FloatLit(_) => {
                return 0;
            }
            Expr::StringLit(_) => {
                return 0;
            }
            Expr::BoolLit(_) => {
                return 0;
            }
            _ => {
            }
        }
    }
    return Lowerer_binop_plan(self, op, left_ty, Lowerer_infer_expr_type(self, right));
}

/// The struct name of a dimension-rule result ("" for an f64).
fn Lowerer_dim_result_name(self: & Lowerer, op: BinOp, left_ty: IrType, right_ty: IrType) -> str {
    var m: str = binop_operator_method(op);
    var lsn: str = lw_ir_struct_name(left_ty);
    var rsn: str = lw_ir_struct_name(right_ty);
    var ld: i64 = 0;
    if str_len(lsn) > 0 {
        ld = Lowerer_struct_dim(self, lsn);
    }
    var rd: i64 = 0;
    if str_len(rsn) > 0 {
        rd = Lowerer_struct_dim(self, rsn);
    }
    if ld != 0 && (m == "add" || m == "sub" || m == "rem") {
        return lsn;
    }
    if ld != 0 && rd == 0 {
        // a unit times / over an f64
        return lsn;
    }
    if ld == 0 && m == "mul" {
        return rsn;
    }
    if ld == 0 {
        ld = dim_dimensionless();
    }
    var sign: i64 = 1;
    if m == "div" {
        sign = 0 - 1;
    }
    var d: i64 = dim_combine(ld, rd, sign);
    if d < 0 || d == dim_dimensionless() {
        return "";
    }
    return Lowerer_dim_unit(self, d);
}

/// The IR type of a dimension-rule result.
pub fn Lowerer_dim_result_ty(self: & Lowerer, op: BinOp, left_ty: IrType, right_ty: IrType) -> IrType {
    var n: str = Lowerer_dim_result_name(self, op, left_ty, right_ty);
    if str_len(n) == 0 {
        return IrType::F64;
    }
    return IrType::Struct(n);
}

/// `<`, `<=`, `>` or `>=` (CL10: on a unit they compare its f64).
fn lw_binop_is_order(op: BinOp) -> bool {
    return binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::GtEq);
}

/// Whether `e` is an integer or float literal.
fn lw_expr_is_num_lit(e: Expr) -> bool {
    match e {
        Expr::IntLit(_) => {
            return true;
        }
        Expr::FloatLit(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// An operand of the dimension rule: a unit's f64 (`e.value`), or `e`.
fn Lowerer_dim_operand(self: & Lowerer, e: Expr, sname: str) -> Expr {
    if str_len(sname) > 0 && Lowerer_struct_dim(self, sname) != 0 {
        return Expr::FieldAccess(Box::new(e), Lowerer_dim_field(self, sname));
    }
    return e;
}

/// `a op b` by the dimension rule: the f64 of each unit operand combined,
/// in a struct literal of the result unit (`Joules { value: f.value *
/// d.value }`), or the bare f64 when the dimensions cancel. Operands are
/// evaluated left to right, once each.
pub fn Lowerer_lower_dim_operator(self: & mut Lowerer, op: BinOp, left: Expr, right: Expr, left_ty: IrType, right_ty: IrType) -> i64 {
    var lv: Expr = Lowerer_dim_operand(self, left, lw_ir_struct_name(left_ty));
    var rv: Expr = Lowerer_dim_operand(self, right, lw_ir_struct_name(right_ty));
    var value: Expr = Expr::Binary(op, Box::new(lv), Box::new(rv));
    var res: str = Lowerer_dim_result_name(self, op, left_ty, right_ty);
    if str_len(res) == 0 {
        return Lowerer_lower_expr(self, value);
    }
    var inits: Vec<FieldInit> = Vec::new();
    inits.push(FieldInit_new(Lowerer_dim_field(self, res), value));
    return Lowerer_lower_expr(self, Expr::StructLit(res, inits, OptBoxExpr::None));
}

/// BG149: `name = e` / `name op= e` in a closure, `name` one of its
/// captures (neither a slot nor a local of the closure): the closure's copy
/// in its env takes the value. Captures are by value (reference §4.10), so
/// the variable the closure was made from keeps its own; later reads in the
/// closure, and later calls of it, see the new value. The assignment was
/// dropped, its right-hand side not even run. false when `name` is not a
/// capture of the closure being lowered.
fn Lowerer_assign_capture(self: & mut Lowerer, name: str, op: AssignOp, expr: Expr) -> bool {
    var found: i64 = - 1;
    var ci: i64 = 0;
    while ci < self.current_captures.len() {
        if found < 0 && self.current_captures.get(ci).name == name {
            found = ci;
        }
        ci = ci + 1;
    }
    if found < 0 {
        return false;
    }
    // the env is the first parameter, after the result pointer of a closure
    // returning a struct (as Expr::Ident reads a capture)
    var env_at: i64 = 0;
    match self.current_sret {
        OptValueId::Some(_) => {
            env_at = 1;
        }
        OptValueId::None => {
        }
    }
    if self.current_func.params.len() <= env_at {
        return false;
    }
    var cap_ty: Type = self.current_captures.get(found).ty;
    var fidx: i64 = self.current_captures.get(found).field_index;
    var env_val: i64 = self.current_func.params.get(env_at).id;
    var idx_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(fidx, IrType::I64));
    var slot: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(env_val, idx_val, IrType::I64));
    var cap_ir_ty: IrType = Lowerer_lower_type(self, cap_ty);
    var kind: i64 = RC_NONE;
    if self.own_on {
        kind = Lowerer_rc_kind(self, cap_ty);
    }
    match cap_ir_ty {
        IrType::Struct(csn) => {
            // the env holds the address of its own copy of the struct
            // (Lowerer_make_fn_env): the new value is copied into it
            match op {
                AssignOp::Assign => {
                }
                _ => {
                    // an arithmetic `op=` on a struct was rewritten to
                    // `x = x op e` (Lowerer_compound_struct_assign)
                    return false;
                }
            }
            var sptr: i64 = Lowerer_emit_inst(self, Inst::Load(slot, IrType::Ptr(Box::new(IrType::Struct(csn)))));
            var srv: i64 = 0;
            if self.own_on {
                srv = Lowerer_lower_owned_new(self, expr, cap_ty);
            } else {
                srv = Lowerer_lower_let_value(self, expr, false);
            }
            if kind == RC_MEM {
                Lowerer_rc_call_mem(self, "__own_drop_", sptr, cap_ty);
            }
            Lowerer_emit_inst(self, Inst::Store(sptr, srv, OptIrType::Some(IrType::Struct(csn))));
            return true;
        }
        _ => {
        }
    }
    // a float capture is stored as a float (as Lowerer_make_fn_env does)
    var st_ty: OptIrType = OptIrType::None;
    match cap_ir_ty {
        IrType::F64 => {
            st_ty = OptIrType::Some(IrType::F64);
        }
        IrType::F32 => {
            st_ty = OptIrType::Some(IrType::F32);
        }
        _ => {
        }
    }
    // the env owns its copy of a string, Vec, map or Box (it took an owner
    // when the closure was made)
    var owns: bool = kind != RC_NONE && kind != RC_MEM;
    match op {
        AssignOp::Assign => {
            var rv: i64 = 0;
            if self.own_on {
                rv = Lowerer_lower_owned_new(self, expr, cap_ty);
            } else {
                rv = Lowerer_lower_let_value(self, expr, false);
            }
            rv = Lowerer_int_to_float_value(self, rv, cap_ir_ty);
            var old: i64 = - 1;
            if owns {
                old = Lowerer_emit_inst(self, Inst::Load(slot, cap_ir_ty));
            }
            Lowerer_emit_inst(self, Inst::Store(slot, rv, st_ty));
            if old >= 0 {
                Lowerer_rc_drop(self, old, cap_ty);
            }
        }
        _ => {
            var cur: i64 = Lowerer_emit_inst(self, Inst::Load(slot, cap_ir_ty));
            var rhs: i64 = Lowerer_lower_expr(self, expr);
            var res: i64 = Lowerer_lower_compound_assign(self, op, cur, rhs);
            Lowerer_emit_inst(self, Inst::Store(slot, res, st_ty));
            // `s += t`: the env keeps the new string and drops the old
            if Lowerer_rc_claim(self, res) && kind == RC_STR {
                Lowerer_rc_drop(self, cur, cap_ty);
            }
        }
    }
    return true;
}

/// CL10: `x op= e` (`+= -= *= /= %=`) on a struct variable lowered as
/// `x = x op e`, so the operator takes its struct path (the method, a
/// unit's dimension rule, vecN's operators) instead of arithmetic on the
/// struct's address. The type checker checks the same rewrite
/// (TypeChecker_compound_struct_expr). False when it does not apply.
fn Lowerer_compound_struct_assign(self: & mut Lowerer, name: str, op: AssignOp, expr: Expr, line: i64) -> bool {
    if !assign_op_is_arith(op) {
        return false;
    }
    var target: Expr = Expr::Ident(name);
    if str_len(lw_ir_struct_name(Lowerer_infer_expr_type(self, target))) == 0 {
        return false;
    }
    var value: Expr = Expr::Binary(assign_op_binop(op), Box::new(target), Box::new(expr));
    Lowerer_lower_stmt_inner(self, Stmt::Assign(name, AssignOp::Assign, value, line));
    return true;
}

/// CL10: `obj.f op= e` with field `f` a struct and `obj` a place path
/// (ast.fd expr_is_place_path: read twice, it runs nothing) lowered as
/// `obj.f = obj.f op e`, as TypeChecker_compound_field_expr checks it.
fn Lowerer_compound_field_assign(self: & mut Lowerer, object: Expr, field: str, op: AssignOp, expr: Expr, line: i64) -> bool {
    if !assign_op_is_arith(op) || !expr_is_place_path(object) {
        return false;
    }
    var place: Expr = Expr::FieldAccess(Box::new(object), field);
    if str_len(lw_ir_struct_name(Lowerer_infer_expr_type(self, place))) == 0 {
        return false;
    }
    var value: Expr = Expr::Binary(assign_op_binop(op), Box::new(place), Box::new(expr));
    Lowerer_lower_stmt_inner(self, Stmt::FieldAssign(object, field, AssignOp::Assign, value, line));
    return true;
}

/// The struct a type is or points to, or "".
fn lw_ir_struct_name(ty: IrType) -> str {
    match ty {
        IrType::Struct(n) => {
            return n;
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(n2) => {
                    return n2;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return "";
}

/// Operator overloading: `a op b` on vecN lowers to vecN_<method>(a, b).
pub fn Lowerer_lower_vec_method_call(self: & mut Lowerer, vec_name: str, method: str, receiver: Expr, arg: Expr) -> i64 {
    var recv_val: i64 = Lowerer_lower_expr(self, receiver);
    var arg_val: i64 = Lowerer_lower_expr(self, arg);
    return Lowerer_lower_vec_sret_call(self, vec_name + "_" + method, IrType::Struct(vec_name), recv_val, arg_val);
}

/// Emit an SRET-style call for vec-returning methods.
/// Allocates a struct slot, calls the function with sret_ptr as first arg, returns sret_ptr.
pub fn Lowerer_lower_vec_sret_call(self: & mut Lowerer, func_name: str, ret_ty: IrType, recv_val: i64, arg_val: i64) -> i64 {
    var struct_name: str = "";
    match ret_ty {
        IrType::Struct(n) => {
            struct_name = n;
        }
        _ => {
        }
    }
    var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct(struct_name), Lowerer_current_region(self)));
    var sret_args: Vec<i64> = Vec::new();
    sret_args.push(sret_ptr);
    // Prepend dummy env_ptr for user functions
    if !Lowerer_is_extern_func(self, func_name) {
        var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        sret_args.push(dummy_env);
    }
    sret_args.push(recv_val);
    sret_args.push(arg_val);
    // Look up the function's effects from the module's function effect table
    var effects: EffectSet = EffectSet_new();
    var fi: i64 = IrModule_effects_pos(self.module, func_name);
    if fi >= 0 {
        EffectSet_add_all(& mut effects, & self.module.function_effects.get(fi).effects);
    }
    var _call: i64 = Lowerer_emit_inst(self, Inst::Call(func_name, sret_args, IrType::Void, effects));
    Lowerer_rc_note_sret(self, sret_ptr, func_name);
    return sret_ptr;
}

/// -v of a literal (the literal i64::MIN is its own negation).
@wrapping fn lw_neg_lit(v: i64) -> i64 {
    return 0 - v;
}

// --- Ownership (proposal 0004) --------------------------------------------
// One rule for every managed value (str, Vec, HashMap, and the structs,
// enums, tuples and generic instances that hold them; a tuple is a struct
// of its shape, Lowerer_key_tuple_ir): a variable owns its value
// and drops it when its scope ends; reading a variable borrows it; a value
// kept somewhere (a variable, a field, an element, a return value) is
// counted again (dup) unless it is a temporary, which is handed over.
// Temporaries are dropped at the end of their statement, parameters are
// borrowed, and a function returns an owned value. This replaces the
// copy-on-write shares of LOWER_COW and the auto-drop passes.

const LOWER_RC: bool = true;  // Boxes are counted (proposal 0004): Box::new makes a block with a count
// word before what it holds, copies count one more owner, the last owner
// drops what the Box holds and frees it. Off: a Box is never freed.
const LOWER_BOX_RC: bool = true;  // Structs are stored in a Vec's buffer (release D15): push/insert/set of a
// struct call core's Vec_*_mem with its size and element type; an empty
// Vec takes that layout at its first struct, one already holding boxed
// structs keeps boxing them. Off: every struct element is a heap copy.
const LOWER_INLINE_STRUCTS: bool = true; const RC_NONE: i64 = 0; const RC_STR: i64 = 1; const RC_VEC: i64 = 2; const RC_MAP: i64 = 3; const RC_MEM: i64 = 4; const RC_BOX: i64 = 5;

/// A temporary the current statement owns; `claimed` once it was kept.
pub struct OwnTemp {
    pub val: i64,
    pub ty: Type,
    pub claimed: bool,
}

/// A struct or enum type with generated drop/dup functions
/// (__own_drop_<index>, __own_dup_<index>); its element type id is
/// index + 16.
pub struct OwnType {
    pub key: str,
    pub ty: Type,
}

fn lw_rc_eff() -> EffectSet {
    var e: EffectSet = EffectSet_new();
    EffectSet_add(& mut e, Effect::Write);
    EffectSet_add(& mut e, Effect::Alloc);
    return e;
}

/// `t` with each of `params` replaced by the argument at its position (a
/// parameter without one is unknown).
/// Whether field `field` of struct `sn` is declared as one of the struct's
/// type parameters (`first: A` in `struct Pair<A, B>`): such a field is
/// held as one word, whatever the instance's type for it.
/// The IR type of field `field` of generic struct `sn` read from `obj`:
/// its declared type with obj's type arguments when the field's type holds
/// a type parameter but is not one (that is Lowerer_field_is_type_param's)
/// and obj's instance type is known; a parameter left over is a word.
/// Otherwise `layout_ty`, the layout's (stdlib-agent-bugs 17).
fn Lowerer_generic_field_ir_type(self: & Lowerer, sn: str, field: str, obj: Expr, layout_ty: IrType) -> IrType {
    if str_len(sn) == 0 {
        return layout_ty;
    }
    match Lowerer_lookup_struct(self, sn) {
        OptStructDef::Some(sd) => {
            if sd.type_params.len() == 0 {
                return layout_ty;
            }
            var fty: Type = Type::Infer;
            var found: bool = false;
            var i: i64 = 0;
            while i < sd.fields.len() {
                if sd.fields.get(i).name == field {
                    fty = sd.fields.get(i).ty;
                    found = true;
                }
                i = i + 1;
            }
            if !found {
                return layout_ty;
            }
            match fty {
                Type::Generic(_, _) => {
                }
                _ => {
                    return layout_ty;
                }
            }
            var ot: Type = Lowerer_infer_expr_ast_type(self, obj);
            match ot {
                Type::Ref(rin, _) => {
                    ot = lw_box_type_unbox(rin);
                }
                _ => {
                }
            }
            match ot {
                Type::Generic(gn, gargs) => {
                    if gn != sn || gargs.len() != sd.type_params.len() {
                        return layout_ty;
                    }
                    var words: Vec<Type> = Vec::new();
                    var wi: i64 = 0;
                    while wi < sd.type_params.len() {
                        words.push(Type::I64);
                        wi = wi + 1;
                    }
                    var inst: Type = lw_rc_subst(lw_rc_subst(fty, sd.type_params, gargs), sd.type_params, words);
                    var want: IrType = Lowerer_lower_type(self, inst);
                    match want {
                        IrType::Struct(_) => {
                            return layout_ty;
                        }
                        _ => {
                        }
                    }
                    if IrModule_type_size(& self.module, want) == IrModule_type_size(& self.module, layout_ty) {
                        return want;
                    }
                }
                _ => {
                }
            }
        }
        OptStructDef::None => {
        }
    }
    return layout_ty;
}

/// BG145: value `v` as the word a type-parameter field (or payload) holds:
/// an f64 as its bits (p_f64_to_bits, as a struct literal stores it), any
/// other value as it is.
fn Lowerer_f64_word_bits(self: & mut Lowerer, v: i64) -> i64 {
    match Lowerer_get_value_type(self, v) {
        IrType::F64 => {
            return Lowerer_emit_inst(self, Inst::Call("p_f64_to_bits", lw_c_vec1_i64(v), IrType::I64, EffectSet_new()));
        }
        // BG270: an f32 as the bits of the f64 it widens to (the field's
        // read narrows it back, Lowerer_lower_field_access_expr)
        IrType::F32 => {
            var w64: i64 = Lowerer_lower_cast(self, v, IrType::F32, IrType::F64);
            return Lowerer_emit_inst(self, Inst::Call("p_f64_to_bits", lw_c_vec1_i64(w64), IrType::I64, EffectSet_new()));
        }
        _ => {
        }
    }
    return v;
}

fn Lowerer_field_is_type_param(self: & Lowerer, sn: str, field: str) -> bool {
    match Lowerer_lookup_struct(self, sn) {
        OptStructDef::Some(sd) => {
            if sd.type_params.len() == 0 {
                return false;
            }
            var i: i64 = 0;
            while i < sd.fields.len() {
                if sd.fields.get(i).name == field {
                    match sd.fields.get(i).ty {
                        Type::Named(n) => {
                            return lw_c_str_vec_contains(sd.type_params, n);
                        }
                        _ => {
                        }
                    }
                }
                i = i + 1;
            }
        }
        OptStructDef::None => {
        }
    }
    return false;
}

/// A generic struct literal's type: Pair<A, B> with the types of the
/// values given to its type-parameter fields (known-bugs 2f.11), a
/// concatenation a string (Lowerer_enum_arg_ast_type).
fn Lowerer_struct_lit_ast_type(self: & Lowerer, name: str, fields: Vec<FieldInit>) -> Type {
    match Lowerer_lookup_struct(self, name) {
        OptStructDef::Some(sd) => {
            // (a plain struct literal keeps the answer it always had: other
            // lowering decisions depend on it)
            if sd.type_params.len() == 0 {
                return Type::I64;
            }
            var args: Vec<Type> = Vec::new();
            var ti: i64 = 0;
            while ti < sd.type_params.len() {
                var found: Type = Type::I64;
                var fi: i64 = 0;
                while fi < sd.fields.len() {
                    match sd.fields.get(fi).ty {
                        Type::Named(n) => {
                            if n == sd.type_params.get(ti) {
                                var k: i64 = 0;
                                while k < fields.len() {
                                    if fields.get(k).name == sd.fields.get(fi).name {
                                        // `"k" + s` is a string (that
                                        // inference types every `+` as
                                        // i64: the field read as a number
                                        // and its string was never dropped)
                                        found = Lowerer_enum_arg_ast_type(self, fields.get(k).value);
                                    }
                                    k = k + 1;
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    fi = fi + 1;
                }
                args.push(found);
                ti = ti + 1;
            }
            return Type::Generic(name, args);
        }
        OptStructDef::None => {
        }
    }
    return Type::I64;
}

fn lw_rc_subst(t: Type, params: Vec<str>, args: Vec<Type>) -> Type {
    match t {
        Type::Named(n) => {
            var i: i64 = 0;
            while i < params.len() {
                if params.get(i) == n {
                    if i < args.len() {
                        return args.get(i);
                    }
                    return Type::Infer;
                }
                i = i + 1;
            }
            return t;
        }
        Type::Generic(n, a) => {
            var na: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < a.len() {
                na.push(lw_rc_subst(a.get(i), params, args));
                i = i + 1;
            }
            return Type::Generic(n, na);
        }
        Type::Tuple(es) => {
            var ne: Vec<Type> = Vec::new();
            var j: i64 = 0;
            while j < es.len() {
                ne.push(lw_rc_subst(es.get(j), params, args));
                j = j + 1;
            }
            return Type::Tuple(ne);
        }
        _ => {
            return t;
        }
    }
    return t;
}

/// The name and type arguments of a struct or enum type, or "".
fn lw_rc_type_name(t: Type) -> str {
    match t {
        Type::Named(n) => {
            return n;
        }
        Type::Generic(n, _) => {
            return n;
        }
        _ => {
        }
    }
    return "";
}

fn lw_rc_type_args(t: Type) -> Vec<Type> {
    match t {
        Type::Generic(_, a) => {
            return a;
        }
        _ => {
        }
    }
    var none: Vec<Type> = Vec::new();
    return none;
}

/// Whether `t` is a struct or an enum of the program, or a tuple (a
/// struct of its shape: it owns its elements, proposal 0004).
fn Lowerer_rc_is_mem_type(self: & Lowerer, t: Type) -> bool {
    match t {
        Type::Tuple(tes) => {
            return tes.len() > 0;
        }
        _ => {
        }
    }
    var name: str = lw_rc_type_name(t);
    if name == "" || name == "Vec" || name == "HashMap" || name == "Box" || name == "Rc" || name == "Arc" {
        return false;
    }
    match Lowerer_lookup_struct(self, name) {
        OptStructDef::Some(_) => {
            return true;
        }
        OptStructDef::None => {
        }
    }
    match Lowerer_lookup_enum(self, name) {
        OptEnumDef::Some(_) => {
            return true;
        }
        OptEnumDef::None => {
        }
    }
    return false;
}

/// The types of the fields of struct `t`, or of the payloads of every
/// variant of enum `t`, with its type parameters replaced by its arguments.
fn Lowerer_rc_field_types(self: & Lowerer, t: Type) -> Vec<Type> {
    var out: Vec<Type> = Vec::new();
    // a tuple's elements
    match t {
        Type::Tuple(tes) => {
            return tes;
        }
        _ => {
        }
    }
    var name: str = lw_rc_type_name(t);
    if name == "" {
        return out;
    }
    var args: Vec<Type> = lw_rc_type_args(t);
    match Lowerer_lookup_struct(self, name) {
        OptStructDef::Some(sd) => {
            var i: i64 = 0;
            while i < sd.fields.len() {
                out.push(lw_rc_subst(sd.fields.get(i).ty, sd.type_params, args));
                i = i + 1;
            }
            return out;
        }
        OptStructDef::None => {
        }
    }
    match Lowerer_lookup_enum(self, name) {
        OptEnumDef::Some(ed) => {
            var vi: i64 = 0;
            while vi < ed.variants.len() {
                match ed.variants.get(vi).data {
                    OptParams::Some(ps) => {
                        var pi: i64 = 0;
                        while pi < ps.len() {
                            out.push(lw_rc_subst(ps.get(pi).ty, ed.type_params, args));
                            pi = pi + 1;
                        }
                    }
                    OptParams::None => {
                    }
                }
                vi = vi + 1;
            }
        }
        OptEnumDef::None => {
        }
    }
    return out;
}

/// How values of type `t` are owned: RC_STR, RC_VEC, RC_MAP (a handle),
/// RC_MEM (a struct, enum or generic instance holding one), RC_NONE.
pub fn Lowerer_rc_kind(self: & mut Lowerer, t0: Type) -> i64 {
    if !LOWER_RC {
        return RC_NONE;
    }
    // BG431: a closure variable's env (Lowerer_rc_note_closure_var)
    match t0 {
        Type::Named(cln) => {
            if str_starts_with(cln, "__clenv#") {
                return RC_CLOS;
            }
        }
        _ => {
        }
    }
    var t: Type = Lowerer_resolve_type(self, t0);
    match t {
        Type::Str => {
            return RC_STR;
        }
        Type::Named(n) => {
            if n == "Vec" {
                return RC_VEC;
            }
            if n == "HashMap" {
                return RC_MAP;
            }
        }
        Type::Generic(n, _) => {
            if n == "Vec" {
                return RC_VEC;
            }
            if n == "HashMap" {
                return RC_MAP;
            }
            if n == "Box" {
                if LOWER_BOX_RC {
                    return RC_BOX;
                }
                return RC_NONE;
            }
        }
        // a tuple is a struct of its shape (its layout, Lowerer_key_tuple_ir)
        Type::Tuple(_) => {
        }
        _ => {
            return RC_NONE;
        }
    }
    if !Lowerer_rc_is_mem_type(self, t) {
        return RC_NONE;
    }
    var key: str = type_to_str(t);
    var cached: i64 = HashMap_get(self.own_kind_cache, key);
    if cached > 0 {
        return cached - 1;
    }
    // a tuple's layout is there for whatever owns it (its drop, its copies)
    match t {
        Type::Tuple(kes) => {
            var _kt: IrType = Lowerer_key_tuple_ir(self, kes);
        }
        _ => {
        }
    }
    // Plain while its fields are looked at: a type that holds itself does
    // so through a Box or a Vec, never inline
    HashMap_insert(self.own_kind_cache, key, RC_NONE + 1);
    var k: i64 = RC_NONE;
    var fields: Vec<Type> = Lowerer_rc_field_types(self, t);
    var i: i64 = 0;
    while i < fields.len() {
        if Lowerer_rc_kind(self, fields.get(i)) != RC_NONE {
            k = RC_MEM;
        }
        i = i + 1;
    }
    HashMap_insert(self.own_kind_cache, key, k + 1);
    return k;
}

/// The index of struct-like type `t` among those with generated functions.
pub fn Lowerer_rc_type_index(self: & mut Lowerer, t0: Type) -> i64 {
    var t: Type = Lowerer_resolve_type(self, t0);
    var key: str = type_to_str(t);
    var at: i64 = HashMap_get(self.own_type_index, key);
    if at > 0 {
        return at - 1;
    }
    // a tuple's glue reads it at its layout's offsets (Lowerer_rc_mem_ir)
    match t {
        Type::Tuple(tes) => {
            var _tl: IrType = Lowerer_key_tuple_ir(self, tes);
        }
        _ => {
        }
    }
    self.own_types.push(OwnType {
        key: key, ty: t
    });
    HashMap_insert(self.own_type_index, key, self.own_types.len());
    return self.own_types.len() - 1;
}

/// The element type id of values of type `t` kept in a Vec or a map
/// (core's P_TID_*): 1 str, 2 Vec, 3 HashMap, 16 + index for a struct or
/// enum (held by pointer to a heap copy), 0 for plain values.
pub fn Lowerer_rc_tid(self: & mut Lowerer, t: Type) -> i64 {
    var k: i64 = Lowerer_rc_kind(self, t);
    if k == RC_STR {
        return 1;
    }
    if k == RC_VEC {
        return 2;
    }
    if k == RC_MAP {
        return 3;
    }
    if k == RC_BOX {
        return 0x8000 + Lowerer_rc_box_inner_tid(self, t);
    }
    if Lowerer_rc_is_mem_type(self, Lowerer_resolve_type(self, t)) {
        return 16 + Lowerer_rc_type_index(self, t);
    }
    return 0;
}

/// The element type id of what a Box<T> holds (0: nothing to drop; a Box
/// of a Box keeps the inner one's content, which is then never dropped).
fn Lowerer_rc_box_inner_tid(self: & mut Lowerer, t: Type) -> i64 {
    var a: Vec<Type> = lw_rc_type_args(Lowerer_resolve_type(self, t));
    if a.len() != 1 {
        return 0;
    }
    var it: i64 = Lowerer_rc_tid(self, a.get(0));
    if it >= 0x8000 {
        return 0;
    }
    return it;
}

/// Box_dup_t(b, inner tid) or Box_drop_t(b, inner tid) for a Box<T> value
/// `b`: the Box to keep (a copy when it leaves its region, proposal 0005),
/// or -1 for a drop.
fn Lowerer_rc_box_call(self: & mut Lowerer, b: i64, t: Type, dup: bool) -> i64 {
    var a: Vec<i64> = Vec::new();
    a.push(Lowerer_rc_env(self));
    a.push(Lowerer_rc_as_i64(self, b));
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(Lowerer_rc_box_inner_tid(self, t), IrType::I64)));
    if dup {
        return Lowerer_emit_inst(self, Inst::Call("Box_dup_t", a, IrType::I64, lw_rc_eff()));
    }
    Lowerer_emit_inst(self, Inst::Call("Box_drop_t", a, IrType::Void, lw_rc_eff()));
    return - 1;
}

/// The IR struct type of a struct-like AST type (a tuple's: its shape's
/// layout, registered by Lowerer_rc_kind and Lowerer_rc_type_index).
fn Lowerer_rc_mem_ir(self: & Lowerer, t: Type) -> IrType {
    var rt: Type = Lowerer_resolve_type(self, t);
    match rt {
        Type::Tuple(tes) => {
            return IrType::Struct(Lowerer_tuple_name_ro(self, tes));
        }
        _ => {
        }
    }
    return IrType::Struct(lw_rc_type_name(rt));
}

fn Lowerer_rc_env(self: & mut Lowerer) -> i64 {
    return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
}

fn Lowerer_rc_as_i64(self: & mut Lowerer, v: i64) -> i64 {
    var vt: IrType = Lowerer_get_value_type(self, v);
    match vt {
        IrType::I64 => {
            return v;
        }
        _ => {
        }
    }
    return Lowerer_emit_inst(self, Inst::BitCast(v, vt, IrType::I64));
}

/// Call a generated function (`prefix` + the type's index) on the memory
/// of a struct-like value.
fn Lowerer_rc_call_mem(self: & mut Lowerer, prefix: str, ptr: i64, t: Type) {
    var idx: i64 = Lowerer_rc_type_index(self, t);
    var a: Vec<i64> = Vec::new();
    a.push(Lowerer_rc_env(self));
    a.push(Lowerer_rc_as_i64(self, ptr));
    Lowerer_emit_inst(self, Inst::Call(prefix + int_to_str(idx), a, IrType::Void, lw_rc_eff()));
}

/// One more owner of `v`: the value to keep (a new handle for a Vec or a
/// map; for a struct, a copy whose fields have one more owner each).
pub fn Lowerer_rc_dup(self: & mut Lowerer, v: i64, t: Type) -> i64 {
    var k: i64 = Lowerer_rc_kind(self, t);
    // A literal is never counted: nothing to do
    if k == RC_STR && Lowerer_rc_is_literal(self, v) {
        return v;
    }
    if k == RC_STR {
        var a: Vec<i64> = Vec::new();
        a.push(Lowerer_rc_env(self));
        a.push(Lowerer_rc_as_i64(self, v));
        var dv: i64 = Lowerer_emit_inst(self, Inst::Call("Str_dup", a, IrType::I64, lw_rc_eff()));
        // the same string, or its copy out of a region (proposal 0005)
        if !self.rg_on {
            return v;
        }
        return Lowerer_rg_as_type(self, dv, v);
    }
    if k == RC_VEC || k == RC_MAP {
        var a2: Vec<i64> = Vec::new();
        a2.push(Lowerer_rc_env(self));
        a2.push(v);
        var fname: str = "Vec_share";
        if k == RC_MAP {
            fname = "HashMap_share";
        }
        return Lowerer_emit_inst(self, Inst::Call(fname, a2, Lowerer_get_value_type(self, v), lw_rc_eff()));
    }
    if k == RC_BOX {
        var bv: i64 = Lowerer_rc_box_call(self, v, t, true);
        if !self.rg_on {
            return v;
        }
        return Lowerer_rg_as_type(self, bv, v);
    }
    if k == RC_MEM {
        var sty: IrType = Lowerer_rc_mem_ir(self, t);
        var copy: i64 = Lowerer_emit_inst(self, Inst::Alloca(sty, Region::Stack));
        // a tuple held as a word is its address
        v = Lowerer_rc_tuple_ptr(self, v, t);
        Lowerer_emit_inst(self, Inst::Store(copy, v, OptIrType::Some(sty)));
        Lowerer_rc_call_mem(self, "__own_dup_", copy, t);
        return copy;
    }
    return v;
}

/// Whether value `v` is a string literal (ConstStr) or null.
fn Lowerer_rc_is_literal(self: & Lowerer, v: i64) -> bool {
    // CS4: read in place (lw_inst_pos)
    var at: i64 = lw_inst_pos(& self.current_func, v);
    if at < 0 {
        return false;
    }
    match self.current_func.insts.get(at).inst {
        Inst::ConstStr(_) => {
            return true;
        }
        Inst::ConstNull(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Drop one owner of `v` (for a struct, of each of its fields).
pub fn Lowerer_rc_drop(self: & mut Lowerer, v: i64, t: Type) {
    var k: i64 = Lowerer_rc_kind(self, t);
    if k == RC_NONE {
        return;
    }
    if k == RC_STR && Lowerer_rc_is_literal(self, v) {
        return;
    }
    if k == RC_CLOS {
        Lowerer_rc_drop_env(self, v, t);
        return;
    }
    if k == RC_MEM {
        Lowerer_rc_call_mem(self, "__own_drop_", v, t);
        return;
    }
    if k == RC_BOX {
        Lowerer_rc_box_call(self, v, t, false);
        return;
    }
    var fname: str = "Str_drop";
    if k == RC_VEC {
        fname = "Vec_drop";
    }
    if k == RC_MAP {
        fname = "HashMap_drop";
    }
    var a: Vec<i64> = Vec::new();
    a.push(Lowerer_rc_env(self));
    if k == RC_STR {
        a.push(Lowerer_rc_as_i64(self, v));
    } else {
        a.push(v);
    }
    Lowerer_emit_inst(self, Inst::Call(fname, a, IrType::Void, lw_rc_eff()));
}

// --- Temporaries ---

/// `v` is a temporary of type `t` that the current statement owns.
pub fn Lowerer_rc_temp(self: & mut Lowerer, v: i64, t: Type) {
    if !self.own_on {
        return;
    }
    if Lowerer_rc_kind(self, t) == RC_NONE {
        return;
    }
    self.own_temps.push(OwnTemp {
        val: v, ty: t, claimed: false
    });
}

/// Hand temporary `v` over to whoever keeps it: true when it was one.
pub fn Lowerer_rc_claim(self: & mut Lowerer, v: i64) -> bool {
    var i: i64 = self.own_temps.len() - 1;
    while i >= 0 {
        // CS4: compared in place; only the one claimed is copied
        if self.own_temps.get(i).val == v && !self.own_temps.get(i).claimed {
            var tp: OwnTemp = self.own_temps.get(i);
            self.own_temps.set(i, OwnTemp {
                val: tp.val, ty: tp.ty, claimed: true
            });
            return true;
        }
        i = i - 1;
    }
    return false;
}

/// The type of temporary `v`, or Infer when it is none.
fn Lowerer_rc_temp_type(self: & Lowerer, v: i64) -> Type {
    var i: i64 = self.own_temps.len() - 1;
    while i >= 0 {
        if self.own_temps.get(i).val == v && !self.own_temps.get(i).claimed {
            return self.own_temps.get(i).ty;
        }
        i = i - 1;
    }
    return Type::Infer;
}

/// Drop the unclaimed temporaries from `from` on (newest first).
fn Lowerer_rc_drop_temps(self: & mut Lowerer, from: i64) {
    var i: i64 = self.own_temps.len() - 1;
    while i >= from {
        var tp: OwnTemp = self.own_temps.get(i);
        if !tp.claimed {
            Lowerer_rc_drop(self, tp.val, tp.ty);
        }
        i = i - 1;
    }
}

/// The end of the statement (or branch) whose temporaries start at `mark`.
pub fn Lowerer_rc_flush(self: & mut Lowerer, mark: i64) {
    if !self.own_on {
        return;
    }
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_rc_drop_temps(self, mark);
    } while self.own_temps.len() > mark {
        self.own_temps.pop();
    }
}

/// `v`, kept somewhere that will drop it as a `t`: a temporary is handed
/// over, anything else gets one more owner.
pub fn Lowerer_rc_own_value(self: & mut Lowerer, v: i64, t: Type) -> i64 {
    if !self.own_on {
        return v;
    }
    if Lowerer_rc_claim(self, v) {
        // kept outside the regions it may come from (proposal 0005)
        if self.rg_keep_out {
            return Lowerer_rg_keep_out(self, v, t);
        }
        // a tuple kept as a struct of its shape: its address (a popped
        // element is a word)
        if Lowerer_rc_kind(self, t) == RC_MEM {
            return Lowerer_rc_tuple_ptr(self, v, t);
        }
        return v;
    }
    if Lowerer_rc_kind(self, t) == RC_NONE {
        return v;
    }
    return Lowerer_rc_dup(self, v, t);
}

/// Lower `expr` for a place that keeps it, as whatever type it has.
pub fn Lowerer_rc_owned_any(self: & mut Lowerer, expr: Expr) -> i64 {
    var v: i64 = Lowerer_lower_keep(self, expr);
    if !self.own_on {
        return v;
    }
    return Lowerer_rc_own_value(self, v, Lowerer_rc_value_type(self, expr, v));
}

/// Lower `expr` for a place that keeps it as a `t` (proposal 0004).
pub fn Lowerer_lower_owned(self: & mut Lowerer, expr: Expr, t: Type) -> i64 {
    var v: i64 = Lowerer_lower_keep(self, expr);
    return Lowerer_rc_own_value(self, v, t);
}

// --- Owned slots and scopes ---

/// Zero instructions for a new owned slot, kept for the entry block.
fn Lowerer_rc_zero_detached(self: & mut Lowerer, slot: i64, ir_ty: IrType, t: Type) {
    if Lowerer_rc_kind(self, t) == RC_MEM {
        var size: i64 = IrModule_type_size(& self.module, Lowerer_rc_mem_ir(self, t));
        var env: i64 = lw_detached(& mut self.current_func, Inst::ConstInt(0, IrType::I64));
        var as_int: i64 = lw_detached(& mut self.current_func, Inst::BitCast(slot, IrType::Ptr(Box::new(ir_ty)), IrType::I64));
        var words: i64 = lw_detached(& mut self.current_func, Inst::ConstInt((size + 7) / 8, IrType::I64));
        var a: Vec<i64> = Vec::new();
        a.push(env);
        a.push(as_int);
        a.push(words);
        var call: i64 = lw_detached(& mut self.current_func, Inst::Call("p_zero_words", a, IrType::Void, lw_rc_eff()));
        self.own_prologue.push(env);
        self.own_prologue.push(as_int);
        self.own_prologue.push(words);
        self.own_prologue.push(call);
        return;
    }
    var zero: i64 = 0;
    match ir_ty {
        IrType::Ptr(_) => {
            zero = lw_detached(& mut self.current_func, Inst::ConstNull(ir_ty));
        }
        _ => {
            zero = lw_detached(& mut self.current_func, Inst::ConstInt(0, IrType::I64));
        }
    }
    var st: i64 = lw_detached(& mut self.current_func, Inst::Store(slot, zero, OptIrType::None));
    self.own_prologue.push(zero);
    self.own_prologue.push(st);
}

/// A slot for a variable that owns a `t`: allocated and zeroed in the entry
/// block, so a drop on a path where the variable was never set does nothing.
pub fn Lowerer_rc_new_slot(self: & mut Lowerer, ir_ty: IrType, t: Type) -> i64 {
    var a: i64 = lw_detached(& mut self.current_func, Inst::Alloca(ir_ty, Region::Stack));
    self.own_prologue.push(a);
    Lowerer_rc_zero_detached(self, a, ir_ty, t);
    return a;
}

/// `slot` owns its value until the current scope ends.
pub fn Lowerer_rc_add_slot(self: & mut Lowerer, slot: i64, t: Type) {
    if !self.own_on {
        return;
    }
    if Lowerer_rc_kind(self, t) == RC_NONE {
        return;
    }
    self.own_slots.push(OwnSlot {
        slot: slot, ty: t
    });
}

/// Zero `slot` after its value was dropped or moved out.
fn Lowerer_rc_clear_slot(self: & mut Lowerer, slot: i64, t: Type) {
    if Lowerer_rc_kind(self, t) == RC_MEM {
        var size: i64 = IrModule_type_size(& self.module, Lowerer_rc_mem_ir(self, t));
        var a: Vec<i64> = Vec::new();
        a.push(Lowerer_rc_env(self));
        a.push(Lowerer_rc_as_i64(self, slot));
        a.push(Lowerer_emit_inst(self, Inst::ConstInt((size + 7) / 8, IrType::I64)));
        Lowerer_emit_inst(self, Inst::Call("p_zero_words", a, IrType::Void, lw_rc_eff()));
        return;
    }
    var sty: IrType = IrType::I64;
    match Lowerer_lookup_alloca_type(self, slot) {
        OptIrType::Some(st) => {
            sty = st;
        }
        OptIrType::None => {
        }
    }
    var zero: i64 = 0;
    match sty {
        IrType::Ptr(_) => {
            zero = Lowerer_emit_inst(self, Inst::ConstNull(sty));
        }
        _ => {
            zero = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        }
    }
    Lowerer_emit_inst(self, Inst::Store(slot, zero, OptIrType::None));
}

/// `return x` of a variable that owns its value: the value is moved out
/// (the slot is cleared, so the drops that follow leave it alone) instead
/// of counted again and dropped. -1 when `e` is not such a variable, or when
/// something runs after the value is taken that may read the variable (a
/// defer, a persist save, a Drop impl).
fn Lowerer_rc_try_move(self: & mut Lowerer, e: Expr) -> i64 {
    if !self.own_on {
        return - 1;
    }
    if self.defer_stack.len() > 0 || self.current_func.persist_vars.len() > 0 || self.current_func.drop_locals.len() > 0 {
        return - 1;
    }
    var name: str = "";
    match e {
        Expr::Ident(n) => {
            name = n;
        }
        _ => {
            return - 1;
        }
    }
    // proposal 0005: a value kept outside its region is copied out, not
    // moved; a variable from outside a region keeps its value there
    if self.rg_keep_out || (self.rg_on && Lowerer_rg_open(self) > 0 && Lowerer_rg_levels_for(self, name) > 0) {
        return - 1;
    }
    var slot: i64 = - 1;
    match Lowerer_lookup_alloca(self, name) {
        OptValueId::Some(a) => {
            slot = a;
        }
        OptValueId::None => {
            return - 1;
        }
    }
    var i: i64 = self.own_slots.len() - 1;
    while i >= 0 {
        // CS4: compared in place; only the slot found is copied
        if self.own_slots.get(i).slot == slot {
            var os: OwnSlot = self.own_slots.get(i);
            var k: i64 = Lowerer_rc_kind(self, os.ty);
            if k == RC_MEM {
                var sty: IrType = Lowerer_rc_mem_ir(self, os.ty);
                var copy: i64 = Lowerer_emit_inst(self, Inst::Alloca(sty, Region::Stack));
                Lowerer_emit_inst(self, Inst::Store(copy, slot, OptIrType::Some(sty)));
                Lowerer_rc_clear_slot(self, slot, os.ty);
                return copy;
            }
            var lty: IrType = IrType::I64;
            match Lowerer_lookup_alloca_type(self, slot) {
                OptIrType::Some(st) => {
                    lty = st;
                }
                OptIrType::None => {
                }
            }
            var v: i64 = Lowerer_emit_inst(self, Inst::Load(slot, lty));
            Lowerer_rc_clear_slot(self, slot, os.ty);
            return v;
        }
        i = i - 1;
    }
    return - 1;
}

/// `expr` when it is a variable read for the last time that owns its value
/// (proposal 0004): the value is moved out (the slot cleared) and becomes a
/// temporary of the statement, which whoever keeps it claims. -1 otherwise.
fn Lowerer_rc_move_last(self: & mut Lowerer, expr: Expr) -> i64 {
    if !self.own_on {
        return - 1;
    }
    var name: str = "";
    match expr {
        Expr::Ident(n) => {
            name = n;
        }
        _ => {
            return - 1;
        }
    }
    // SP12: Lowerer_last_use (a scan of the rest of every enclosing
    // statement list) comes after the cheap checks below, which change
    // nothing: most kept variables own no slot (a number) and stop there
    if lw_c_str_vec_contains(self.own_nomove, name) {
        return - 1;
    }
    // Not in a loop's own condition or iterator: it runs again
    var fd: i64 = self.fr_lists.len();
    if fd > 0 && fd == self.fr_idx.len() {
        var cur: Vec<Stmt> = self.fr_lists.get(fd - 1);
        var cat: i64 = self.fr_idx.get(fd - 1);
        if cat >= 0 && cat < cur.len() {
            match cur.get(cat) {
                Stmt::While(_, _, _) => {
                    return - 1;
                }
                Stmt::For(_, _, _, _) => {
                    return - 1;
                }
                Stmt::Loop(_, _) => {
                    return - 1;
                }
                _ => {
                }
            }
        }
    }
    var slot: i64 = - 1;
    match Lowerer_lookup_alloca(self, name) {
        OptValueId::Some(a) => {
            slot = a;
        }
        OptValueId::None => {
            return - 1;
        }
    }
    var ty: Type = Type::Infer;
    var found: bool = false;
    var i: i64 = self.own_slots.len() - 1;
    while i >= 0 && !found {
        if self.own_slots.get(i).slot == slot {
            ty = self.own_slots.get(i).ty;
            found = true;
        }
        i = i - 1;
    }
    if !found {
        return - 1;
    }
    if !Lowerer_last_use(self, name) {
        return - 1;
    }
    var v: i64 = Lowerer_rc_try_move(self, expr);
    if v < 0 {
        return - 1;
    }
    Lowerer_rc_temp(self, v, ty);
    return v;
}

/// Lower `expr` where its value is kept: a variable on its last use is
/// moved, anything else lowered as usual.
fn Lowerer_lower_keep(self: & mut Lowerer, expr: Expr) -> i64 {
    var m: i64 = Lowerer_rc_move_last(self, expr);
    if m >= 0 {
        return m;
    }
    return Lowerer_lower_expr(self, expr);
}

/// Whether `var name = expr` may borrow instead of copy: `expr` is a place
/// whose root is a by-value parameter (the callee cannot change it) or a
/// variable that owns its value, and in the rest of the block neither the
/// new variable nor the root is assigned, changed or passed to change.
/// The root is then never moved out while the copy lives.
fn Lowerer_rc_borrow_copy_ok(self: & mut Lowerer, name: str, expr: Expr) -> bool {
    if !lw_is_place_expr(expr) {
        return false;
    }
    // The rest of the let's own list is known (not a branch lowered inline)
    var fd: i64 = self.fr_lists.len();
    if fd == 0 || fd != self.fr_idx.len() {
        return false;
    }
    var cur: Vec<Stmt> = self.fr_lists.get(fd - 1);
    var at: i64 = self.fr_idx.get(fd - 1);
    if at < 0 || at >= cur.len() {
        return false;
    }
    match cur.get(at) {
        Stmt::Let(ln, _, _, _, _, _, _) => {
            if ln != name {
                return false;
            }
        }
        _ => {
            return false;
        }
    }
    var root: str = cow_root(expr);
    if root == "" || root == name {
        return false;
    }
    // The root cannot change while the copy lives: a by-value parameter
    // (the type checker rejects changing one; a changed one is a local copy
    // and has a slot), or a string variable (only an assignment, which the
    // check below sees, changes a string). A method on a struct or Vec
    // variable could change it unseen.
    var root_ok: bool = false;
    match Lowerer_lookup_alloca(self, root) {
        OptValueId::Some(rs) => {
            root_ok = Lowerer_rc_owns_slot(self, rs) && Lowerer_rc_kind(self, Lowerer_rc_var_type(self, root)) == RC_STR;
        }
        OptValueId::None => {
            match Lowerer_lookup_param_type(self, root) {
                OptType::Some(pt) => {
                    match pt {
                        Type::Ref(_, _) => {
                        }
                        _ => {
                            root_ok = true;
                        }
                    }
                }
                OptType::None => {
                }
            }
        }
    }
    if !root_ok {
        return false;
    }
    if self.cur_has_defer {
        return false;
    }
    if !Lowerer_readonly_copy_in(self, name, expr, false) {
        return false;
    }
    self.own_nomove.push(root);
    return true;
}

/// Whether `slot` owns its value (an owned variable of an open scope).
pub fn Lowerer_rc_owns_slot(self: & Lowerer, slot: i64) -> bool {
    var i: i64 = self.own_slots.len() - 1;
    while i >= 0 {
        if self.own_slots.get(i).slot == slot {
            return true;
        }
        i = i - 1;
    }
    return false;
}

/// Drop what an owned slot holds, and zero it.
fn Lowerer_rc_drop_slot(self: & mut Lowerer, s: OwnSlot) {
    var k: i64 = Lowerer_rc_kind(self, s.ty);
    if k == RC_MEM {
        Lowerer_rc_call_mem(self, "__own_drop_", s.slot, s.ty);
        Lowerer_rc_clear_slot(self, s.slot, s.ty);
        return;
    }
    var sty: IrType = IrType::I64;
    match Lowerer_lookup_alloca_type(self, s.slot) {
        OptIrType::Some(st) => {
            sty = st;
        }
        OptIrType::None => {
        }
    }
    var v: i64 = Lowerer_emit_inst(self, Inst::Load(s.slot, sty));
    Lowerer_rc_drop(self, v, s.ty);
    Lowerer_rc_clear_slot(self, s.slot, s.ty);
}

/// Drop the owned slots from `from` on (newest first), keeping the list.
fn Lowerer_rc_drop_slots(self: & mut Lowerer, from: i64) {
    var i: i64 = self.own_slots.len() - 1;
    while i >= from {
        Lowerer_rc_drop_slot(self, self.own_slots.get(i));
        i = i - 1;
    }
}

pub fn Lowerer_rc_scope_open(self: & mut Lowerer) {
    self.own_marks.push(self.own_slots.len());
}

/// The end of a block: its variables are dropped.
pub fn Lowerer_rc_scope_close(self: & mut Lowerer) {
    if self.own_marks.len() == 0 {
        return;
    }
    var m: i64 = self.own_marks.get(self.own_marks.len() - 1);
    self.own_marks.pop();
    if self.own_on && !Lowerer_current_block_has_terminator(self) {
        Lowerer_rc_drop_slots(self, m);
    } while self.own_slots.len() > m {
        self.own_slots.pop();
    }
}

/// Leaving the function (a return, the `?` error path): every temporary
/// and owned variable is dropped.
pub fn Lowerer_rc_drop_all(self: & mut Lowerer) {
    if !self.own_on {
        return;
    }
    Lowerer_rc_drop_temps(self, 0);
    Lowerer_rc_drop_slots(self, 0);
}

/// A loop starts: `break` and `continue` drop what its body made.
pub fn Lowerer_rc_loop_open(self: & mut Lowerer) {
    self.rg_loop_marks.push(Lowerer_rg_open(self));
    self.own_loop_slots.push(self.own_slots.len());
    self.own_loop_temps.push(self.own_temps.len());
}

pub fn Lowerer_rc_loop_close(self: & mut Lowerer) {
    if self.rg_loop_marks.len() > 0 {
        self.rg_loop_marks.pop();
    }
    if self.own_loop_slots.len() > 0 {
        self.own_loop_slots.pop();
    }
    if self.own_loop_temps.len() > 0 {
        self.own_loop_temps.pop();
    }
}

/// Before `break`/`continue`: drop the innermost loop body's temporaries
/// and variables.
pub fn Lowerer_rc_loop_exit(self: & mut Lowerer) {
    if !self.own_on || self.own_loop_slots.len() == 0 {
        return;
    }
    Lowerer_rc_drop_temps(self, self.own_loop_temps.get(self.own_loop_temps.len() - 1));
    Lowerer_rc_drop_slots(self, self.own_loop_slots.get(self.own_loop_slots.len() - 1));
}

/// Put the owned slots' allocations and zeroing at the start of the entry
/// block of the function just lowered.
pub fn Lowerer_rc_finish_func(self: & mut Lowerer) {
    if self.own_prologue.len() == 0 {
        return;
    }
    if self.current_func.blocks.len() == 0 {
        return;
    }
    var blk: BasicBlock = self.current_func.blocks.get(0);
    var fresh: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < self.own_prologue.len() {
        fresh.push(self.own_prologue.get(i));
        i = i + 1;
    }
    var j: i64 = 0;
    while j < blk.instructions.len() {
        fresh.push(blk.instructions.get(j));
        j = j + 1;
    }
    blk.instructions = fresh;
    self.current_func.blocks.set(0, blk);
}

// --- Calls ---

/// Builtins whose result is a new string the caller owns.
fn lw_rc_fresh_builtin(name: str) -> bool {
    // CS4: every name below starts "p_": the program's own calls are
    // answered without 27 comparisons each
    if !str_starts_with(name, "p_") {
        return false;
    }
    return name == "p_str_concat" || name == "p_to_str" || name == "p_to_str_float" || name == "p_float_to_str" || name == "p_to_str_bool" || name == "p_bool_to_str" || name == "p_char_to_str" || name == "p_to_str_vec" || name == "p_vec_to_str" || name == "p_to_str_map" || name == "p_str_join_n" || name == "p_sb_to_str" || name == "p_json_dump" || name == "p_json_pretty" || name == "p_json_string" || name == "p_tensor_to_str" || name == "p_simd_to_str" || name == "p_str_from_ptr" || name == "p_str_take"  // The builtins that can fail give a counted copy, or null
    || name == "p_file_read" || name == "p_read_line" || name == "p_read_stdin" || name == "p_getenv" || name == "p_argv" || name == "p_process_stdout" || name == "p_process_stderr" || name == "p_dir_list";
}

/// BG204: a runtime function that makes a new JSON value: every runtime
/// gives a counted string (the value is its text), as for p_json_dump. Its
/// result is a temporary of the statement, typed i64 by the type checker:
/// a JSON reader's argument (`p_json_dump(p_json_parse(s))`) is dropped at
/// the statement's end, and `val j = p_json_parse(s)` keeps it (j owns a
/// string, dropped with its scope; it leaked one string per parse).
fn lw_json_fresh_call(name: str) -> bool {
    if !str_starts_with(name, "p_json_") {
        return false;
    }
    return name == "p_json_parse" || name == "p_json_get" || name == "p_json_at";
}

/// core functions that hand back a new Vec or map as an i64 handle.
fn lw_rc_fresh_handle_call(name: str) -> bool {
    // CS4: a quick no for every other call
    if !str_starts_with(name, "Vec_") && !str_starts_with(name, "HashMap_") && name != "String_split" && !str_starts_with(name, "p_file_read_") {
        return false;
    }
    // p_file_read_bytes / p_file_read_at: every runtime returns a new Vec
    // (taken as a share, its header and buffer leaked per call)
    return name == "Vec_new" || name == "Vec_new_sized" || name == "Vec_new_typed" || name == "Vec_clone" || name == "Vec_filled_typed" || name == "HashMap_new" || name == "HashMap_new_typed" || name == "HashMap_clone" || name == "HashMap_keys" || name == "HashMap_values" || name == "HashMap_keys_i" || name == "HashMap_values_i" || name == "HashMap_keys_u64" || name == "HashMap_values_u64" || name == "String_split" || name == "p_file_read_bytes" || name == "p_file_read_at";
}

/// The AST return type of function `name`, or Infer.
fn Lowerer_rc_ret_type(self: & Lowerer, name: str) -> Type {
    var at: i64 = HashMap_get(self.own_ret_index, name) - 1;
    if at >= 0 && at < self.func_ret_types.len() && self.func_ret_types.get(at).key == name {
        return self.func_ret_types.get(at).val;
    }
    return Type::Infer;
}

/// After a call is emitted: a function returning a string, a Vec or a map
/// returns one the caller owns, a temporary of the current statement.
fn Lowerer_rc_note_call(self: & mut Lowerer, id: i64, name: str, ir_ty: IrType) {
    if lw_rc_fresh_builtin(name) || lw_json_fresh_call(name) {
        Lowerer_rc_temp(self, id, Type::Str);
        return;
    }
    if lw_rc_fresh_handle_call(name) {
        match ir_ty {
            IrType::Generic(gn, _) => {
                if gn == "Vec" {
                    Lowerer_rc_temp(self, id, Type::Named("Vec"));
                }
                if gn == "HashMap" {
                    Lowerer_rc_temp(self, id, Type::Named("HashMap"));
                }
            }
            IrType::Opaque(onm) => {
                if onm == "Vec" {
                    Lowerer_rc_temp(self, id, Type::Named("Vec"));
                }
                if onm == "HashMap" {
                    Lowerer_rc_temp(self, id, Type::Named("HashMap"));
                }
            }
            _ => {
            }
        }
        return;
    }
    var rt: Type = Lowerer_rc_ret_type(self, name);
    var k: i64 = Lowerer_rc_kind(self, rt);
    if k == RC_STR || k == RC_VEC || k == RC_MAP || k == RC_BOX {
        Lowerer_rc_temp(self, id, rt);
    }
}

/// After a call that returns a struct through `sret`: the caller owns the
/// struct written there.
pub fn Lowerer_rc_note_sret(self: & mut Lowerer, sret: i64, name: str) {
    if !self.own_on {
        return;
    }
    var rt: Type = Lowerer_rc_ret_type(self, name);
    if Lowerer_rc_kind(self, rt) == RC_MEM {
        Lowerer_rc_temp(self, sret, rt);
    }
}

/// OW6: the struct `v` a Vec pop / remove gave (the address of the struct
/// taken out, whose fields are the caller's: core vec_sz_pop and
/// vec_sz_remove), a temporary of the statement. An empty Vec's pop gives
/// 0: then the address of a zeroed struct of the type (made zero in the
/// entry block, never written), whose drop does nothing and whose copy
/// owns nothing, instead of a drop through a null address.
fn Lowerer_rc_popped_mem(self: & mut Lowerer, v: i64, t: Type) -> i64 {
    var vty: IrType = Lowerer_get_value_type(self, v);
    var sty: IrType = Lowerer_rc_mem_ir(self, t);
    var zslot: i64 = Lowerer_rc_new_slot(self, sty, t);
    var hold: i64 = Lowerer_emit_inst(self, Inst::Alloca(vty, Region::Stack));
    Lowerer_emit_inst(self, Inst::Store(hold, v, OptIrType::None));
    var vi: i64 = Lowerer_rc_as_i64(self, v);
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var is_null: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, vi, zero, IrType::Bool));
    var empty_b: i64 = Lowerer_new_block(self);
    var cont_b: i64 = Lowerer_new_block(self);
    Lowerer_emit_terminator(self, Inst::Branch(is_null, empty_b, cont_b));
    Lowerer_set_current_block(self, empty_b);
    var zp: i64 = Lowerer_emit_inst(self, Inst::BitCast(zslot, IrType::Ptr(Box::new(sty)), vty));
    Lowerer_emit_inst(self, Inst::Store(hold, zp, OptIrType::None));
    Lowerer_emit_terminator(self, Inst::Jump(cont_b));
    Lowerer_set_current_block(self, cont_b);
    var r: i64 = Lowerer_emit_inst(self, Inst::Load(hold, vty));
    Lowerer_rc_temp(self, r, t);
    return r;
}

/// The argument positions (after env) of core functions that keep their
/// argument: those get an owned value.
fn lw_rc_consuming_arg(name: str, pos: i64) -> bool {
    if name == "Vec_push" || name == "p_vec_push" {
        return pos == 1;
    }
    if name == "Vec_set" || name == "Vec_insert" || name == "p_vec_set" || name == "p_vec_insert" {
        return pos == 2;
    }
    if name == "HashMap_insert" {
        return pos == 1 || pos == 2;
    }
    if name == "HashMap_insert_i" {
        return pos == 2;
    }
    return false;
}

// --- Generated drop/dup functions ---

/// Address `p + off` as a pointer to an i64 (in the function being built).
fn Lowerer_rc_word_ptr(self: & mut Lowerer, p: i64, off: i64) -> i64 {
    var o: i64 = Lowerer_emit_inst(self, Inst::ConstInt(off, IrType::I64));
    var a: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, p, o, IrType::I64));
    return Lowerer_emit_inst(self, Inst::BitCast(a, IrType::I64, IrType::Ptr(Box::new(IrType::I64))));
}

/// Drop (`dup` false) or count again (`dup` true) the value of type `t`
/// stored at `p + off` inline.
fn Lowerer_rc_gen_field(self: & mut Lowerer, p: i64, off: i64, t: Type, dup: bool) {
    var k: i64 = Lowerer_rc_kind(self, t);
    if k == RC_NONE {
        return;
    }
    if k == RC_MEM {
        var o: i64 = Lowerer_emit_inst(self, Inst::ConstInt(off, IrType::I64));
        var a: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, p, o, IrType::I64));
        var idx: i64 = Lowerer_rc_type_index(self, t);
        var args: Vec<i64> = Vec::new();
        args.push(Lowerer_rc_env(self));
        args.push(a);
        var prefix: str = "__own_drop_";
        if dup {
            prefix = "__own_dup_";
        }
        Lowerer_emit_inst(self, Inst::Call(prefix + int_to_str(idx), args, IrType::Void, lw_rc_eff()));
        return;
    }
    var wp: i64 = Lowerer_rc_word_ptr(self, p, off);
    var w: i64 = Lowerer_emit_inst(self, Inst::Load(wp, IrType::I64));
    if k == RC_BOX {
        // the same pointer counted again (or its copy out of a region,
        // proposal 0005), or dropped
        var nb: i64 = Lowerer_rc_box_call(self, w, t, dup);
        if dup {
            Lowerer_emit_inst(self, Inst::Store(wp, nb, OptIrType::None));
        }
        return;
    }
    var fargs: Vec<i64> = Vec::new();
    fargs.push(Lowerer_rc_env(self));
    fargs.push(w);
    if !dup {
        var dn: str = "Str_drop";
        if k == RC_VEC {
            dn = "Vec_drop";
        }
        if k == RC_MAP {
            dn = "HashMap_drop";
        }
        Lowerer_emit_inst(self, Inst::Call(dn, fargs, IrType::Void, lw_rc_eff()));
        return;
    }
    var un: str = "Str_dup";
    if k == RC_VEC {
        un = "Vec_share";
    }
    if k == RC_MAP {
        un = "HashMap_share";
    }
    var nw: i64 = Lowerer_emit_inst(self, Inst::Call(un, fargs, IrType::I64, lw_rc_eff()));
    // a string's copy out of a region too (proposal 0005)
    Lowerer_emit_inst(self, Inst::Store(wp, nw, OptIrType::None));
}

/// The same for a payload held as a word because its declared type is a
/// type parameter: a struct-like argument is a pointer to a heap copy.
fn Lowerer_rc_gen_param_payload(self: & mut Lowerer, p: i64, off: i64, t: Type, dup: bool) {
    if !Lowerer_rc_is_mem_type(self, Lowerer_resolve_type(self, t)) {
        Lowerer_rc_gen_field(self, p, off, t, dup);
        return;
    }
    var wp: i64 = Lowerer_rc_word_ptr(self, p, off);
    var bx: i64 = Lowerer_emit_inst(self, Inst::Load(wp, IrType::I64));
    var idx: i64 = Lowerer_rc_type_index(self, t);
    var tid: i64 = Lowerer_emit_inst(self, Inst::ConstInt(16 + idx, IrType::I64));
    var args: Vec<i64> = Vec::new();
    args.push(Lowerer_rc_env(self));
    args.push(tid);
    args.push(bx);
    if dup {
        var nb: i64 = Lowerer_emit_inst(self, Inst::Call("vec_elem_dup", args, IrType::I64, lw_rc_eff()));
        Lowerer_emit_inst(self, Inst::Store(wp, nb, OptIrType::None));
    } else {
        Lowerer_emit_inst(self, Inst::Call("vec_elem_drop", args, IrType::Void, lw_rc_eff()));
    }
}

/// Whether AST type `t` names one of `params` (a type parameter).
fn lw_rc_is_param(t: Type, params: Vec<str>) -> bool {
    match t {
        Type::Named(n) => {
            return lw_c_str_vec_contains(params, n);
        }
        _ => {
        }
    }
    return false;
}

/// The byte offset of field `name` in IR struct `sn`, or -1.
fn Lowerer_rc_field_offset(self: & Lowerer, sn: str, name: str) -> i64 {
    match IrModule_get_struct(& self.module, sn) {
        OptStructLayout::Some(layout) => {
            var i: i64 = 0;
            while i < layout.fields.len() {
                if layout.fields.get(i).name == name {
                    return layout.fields.get(i).offset;
                }
                i = i + 1;
            }
        }
        OptStructLayout::None => {
        }
    }
    return - 1;
}

/// The IR type of field `name` in IR struct `sn`'s layout, or I64.
fn Lowerer_rc_field_ir(self: & Lowerer, sn: str, name: str) -> IrType {
    match IrModule_get_struct(& self.module, sn) {
        OptStructLayout::Some(layout) => {
            var i: i64 = 0;
            while i < layout.fields.len() {
                if layout.fields.get(i).name == name {
                    return layout.fields.get(i).ty;
                }
                i = i + 1;
            }
        }
        OptStructLayout::None => {
        }
    }
    return IrType::I64;
}

/// Whether a field (or a payload) of AST type `t` held as IR type `held`
/// is what the glue reads there: a struct-like value inline (a struct),
/// anything else as its word. A tuple whose type names a type parameter
/// is a word (Lowerer_held_ir) the glue leaves alone.
fn Lowerer_rc_held_inline(self: & mut Lowerer, held: IrType, t: Type) -> bool {
    if Lowerer_rc_kind(self, t) != RC_MEM {
        return true;
    }
    match held {
        IrType::Struct(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// The body of __own_drop_<idx> / __own_dup_<idx> for struct or enum `t`
/// (or tuple), whose memory starts at `p` (an i64).
fn Lowerer_rc_gen_body(self: & mut Lowerer, p: i64, t: Type, dup: bool) {
    // A tuple: each element at its layout's offset (Lowerer_rc_mem_ir, as
    // a tuple literal stores them: a struct, an enum and a nested tuple
    // inline)
    match t {
        Type::Tuple(tes) => {
            var tn: str = Lowerer_tuple_name_ro(self, tes);
            match IrModule_get_struct(& self.module, tn) {
                OptStructLayout::Some(tlay) => {
                    var ti: i64 = 0;
                    while ti < tes.len() && ti < tlay.fields.len() {
                        if Lowerer_rc_held_inline(self, tlay.fields.get(ti).ty, tes.get(ti)) {
                            Lowerer_rc_gen_field(self, p, tlay.fields.get(ti).offset, tes.get(ti), dup);
                        }
                        ti = ti + 1;
                    }
                }
                OptStructLayout::None => {
                }
            }
            return;
        }
        _ => {
        }
    }
    var name: str = lw_rc_type_name(t);
    var args: Vec<Type> = lw_rc_type_args(t);
    match Lowerer_lookup_struct(self, name) {
        OptStructDef::Some(sd) => {
            var i: i64 = 0;
            while i < sd.fields.len() {
                var f: Param = sd.fields.get(i);
                var off: i64 = Lowerer_rc_field_offset(self, name, f.name);
                if off >= 0 {
                    var ft: Type = lw_rc_subst(f.ty, sd.type_params, args);
                    if lw_rc_is_param(f.ty, sd.type_params) {
                        Lowerer_rc_gen_param_payload(self, p, off, ft, dup);
                    } else if Lowerer_rc_held_inline(self, Lowerer_rc_field_ir(self, name, f.name), ft) {
                        Lowerer_rc_gen_field(self, p, off, ft, dup);
                    }
                }
                i = i + 1;
            }
            return;
        }
        OptStructDef::None => {
        }
    }
    match Lowerer_lookup_enum(self, name) {
        OptEnumDef::Some(ed) => {
            var tp: i64 = Lowerer_rc_word_ptr(self, p, 0);
            var tag: i64 = Lowerer_emit_inst(self, Inst::Load(tp, IrType::I64));
            var vi: i64 = 0;
            while vi < ed.variants.len() {
                match ed.variants.get(vi).data {
                    OptParams::Some(ps) => {
                        // Payloads that own something: test the tag
                        var any: bool = false;
                        var pi: i64 = 0;
                        while pi < ps.len() {
                            if Lowerer_rc_kind(self, lw_rc_subst(ps.get(pi).ty, ed.type_params, args)) != RC_NONE {
                                any = true;
                            }
                            pi = pi + 1;
                        }
                        if any {
                            var here: i64 = Lowerer_new_block(self);
                            var next: i64 = Lowerer_new_block(self);
                            var want: i64 = Lowerer_emit_inst(self, Inst::ConstInt(vi, IrType::I64));
                            var is_it: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag, want, IrType::Bool));
                            Lowerer_emit_terminator(self, Inst::Branch(is_it, here, next));
                            Lowerer_set_current_block(self, here);
                            var slot: i64 = 1;
                            var qi: i64 = 0;
                            while qi < ps.len() {
                                var decl: Type = ps.get(qi).ty;
                                var pt: Type = lw_rc_subst(decl, ed.type_params, args);
                                if lw_rc_is_param(decl, ed.type_params) {
                                    Lowerer_rc_gen_param_payload(self, p, slot * 8, pt, dup);
                                    slot = slot + 1;
                                } else {
                                    // as the enum's layout holds it (a tuple
                                    // and a generic instance inline)
                                    var held: IrType = Lowerer_held_ir(self, decl, ed.type_params);
                                    if Lowerer_rc_held_inline(self, held, pt) {
                                        Lowerer_rc_gen_field(self, p, slot * 8, pt, dup);
                                    }
                                    slot = slot + Lowerer_enum_field_slots(self, held);
                                }
                                qi = qi + 1;
                            }
                            Lowerer_emit_terminator(self, Inst::Jump(next));
                            Lowerer_set_current_block(self, next);
                        }
                    }
                    OptParams::None => {
                    }
                }
                vi = vi + 1;
            }
        }
        OptEnumDef::None => {
        }
    }
}

/// Build function `fname(env, p)` with the body Lowerer_rc_gen_body gives.
fn Lowerer_rc_gen_fn(self: & mut Lowerer, fname: str, t: Type, dup: bool) {
    var f: IrFunction = IrFunction_new(fname, IrType::Void);
    var env_ty: IrType = IrType::Ptr(Box::new(IrType::U8));
    var env_val: i64 = IrFunction_new_value(& mut f, ValueMeta_new(env_ty));
    f.params.push(ValueIdType_new(env_val, env_ty));
    var p: i64 = IrFunction_new_value(& mut f, ValueMeta_new(IrType::I64));
    f.params.push(ValueIdType_new(p, IrType::I64));
    var prev_func: IrFunction = self.current_func;
    var prev_has: bool = self.has_current_func;
    var prev_block: i64 = self.current_block;
    var prev_on: bool = self.own_on;
    self.own_on = false;
    self.current_func = f;
    self.current_func.name = fname;
    self.has_current_func = true;
    self.current_block = 0;
    self.current_func.current_block_idx = 0;
    Lowerer_rc_gen_body(self, p, t, dup);
    Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
    var eff: EffectSet = lw_rc_eff();
    self.current_func.effects = eff;
    self.module.function_effects.push(StringEffectSetEntry_new(fname, eff));
    IrModule_add_function(& mut self.module, self.current_func);
    self.current_func = prev_func;
    self.has_current_func = prev_has;
    self.current_block = prev_block;
    self.own_on = prev_on;
}

/// Replace the body of core's `__p_elem_drop(tid, e)` / `__p_elem_dup(tid,
/// e) -> i64` by a dispatch over the struct and enum types numbered here:
/// an element held in a Vec or a map is a pointer to a heap copy, so a drop
/// drops its fields and frees it, and a dup makes a copy whose fields have
/// one more owner each.
fn Lowerer_rc_gen_elem_fn(self: & mut Lowerer, dup: bool) {
    var fname: str = "__p_elem_drop";
    var ret: IrType = IrType::Void;
    if dup {
        fname = "__p_elem_dup";
        ret = IrType::I64;
    }
    if !Lowerer_has_function(self, fname) {
        return;
    }
    var f: IrFunction = IrFunction_new(fname, ret);
    var env_ty: IrType = IrType::Ptr(Box::new(IrType::U8));
    var env_val: i64 = IrFunction_new_value(& mut f, ValueMeta_new(env_ty));
    f.params.push(ValueIdType_new(env_val, env_ty));
    var tid: i64 = IrFunction_new_value(& mut f, ValueMeta_new(IrType::I64));
    f.params.push(ValueIdType_new(tid, IrType::I64));
    var e: i64 = IrFunction_new_value(& mut f, ValueMeta_new(IrType::I64));
    f.params.push(ValueIdType_new(e, IrType::I64));
    var prev_func: IrFunction = self.current_func;
    var prev_has: bool = self.has_current_func;
    var prev_block: i64 = self.current_block;
    var prev_on: bool = self.own_on;
    self.own_on = false;
    self.current_func = f;
    self.current_func.name = fname;
    self.has_current_func = true;
    self.current_block = 0;
    self.current_func.current_block_idx = 0;
    var i: i64 = 0;
    while i < self.own_types.len() {
        var ot: OwnType = self.own_types.get(i);
        var here: i64 = Lowerer_new_block(self);
        var next: i64 = Lowerer_new_block(self);
        var want: i64 = Lowerer_emit_inst(self, Inst::ConstInt(16 + i, IrType::I64));
        var is_it: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tid, want, IrType::Bool));
        Lowerer_emit_terminator(self, Inst::Branch(is_it, here, next));
        Lowerer_set_current_block(self, here);
        var sty: IrType = Lowerer_rc_mem_ir(self, ot.ty);
        if dup {
            var size: i64 = IrModule_type_size(& self.module, sty);
            if size < 8 {
                size = 8;
            }
            var sz: Vec<i64> = Vec::new();
            sz.push(Lowerer_emit_inst(self, Inst::ConstInt(size, IrType::I64)));
            var nb: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", sz, IrType::Ptr(Box::new(sty)), lw_rc_eff()));
            var src: i64 = Lowerer_emit_inst(self, Inst::BitCast(e, IrType::I64, IrType::Ptr(Box::new(sty))));
            Lowerer_emit_inst(self, Inst::Store(nb, src, OptIrType::Some(sty)));
            var nbi: i64 = Lowerer_emit_inst(self, Inst::BitCast(nb, IrType::Ptr(Box::new(sty)), IrType::I64));
            var da: Vec<i64> = Vec::new();
            da.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
            da.push(nbi);
            Lowerer_emit_inst(self, Inst::Call("__own_dup_" + int_to_str(i), da, IrType::Void, lw_rc_eff()));
            Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(nbi)));
        } else {
            var dr: Vec<i64> = Vec::new();
            dr.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
            dr.push(e);
            Lowerer_emit_inst(self, Inst::Call("__own_drop_" + int_to_str(i), dr, IrType::Void, lw_rc_eff()));
            var fr: Vec<i64> = Vec::new();
            fr.push(Lowerer_emit_inst(self, Inst::BitCast(e, IrType::I64, lw_ptr_u8())));
            Lowerer_emit_inst(self, Inst::Call("p_free", fr, IrType::Void, lw_rc_eff()));
            Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
        }
        Lowerer_set_current_block(self, next);
        i = i + 1;
    }
    if dup {
        Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(e)));
    } else {
        Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
    }
    var eff: EffectSet = lw_rc_eff();
    self.current_func.effects = eff;
    var done: str = self.current_func.name;
    IrModule_replace_function_named(& mut self.module, self.current_func, done);
    self.current_func = prev_func;
    self.has_current_func = prev_has;
    self.current_block = prev_block;
    self.own_on = prev_on;
}

/// After every function is lowered: the drop/dup function of each struct
/// and enum type used (the list grows while it is built: a type's fields
/// register theirs), then the element dispatchers.
pub fn Lowerer_rc_gen_types(self: & mut Lowerer) {
    if !LOWER_RC {
        return;
    }
    var i: i64 = 0;
    while i < self.own_types.len() {
        var ot: OwnType = self.own_types.get(i);
        Lowerer_rc_gen_fn(self, "__own_drop_" + int_to_str(i), ot.ty, false);
        Lowerer_rc_gen_fn(self, "__own_dup_" + int_to_str(i), ot.ty, true);
        i = i + 1;
    }
    Lowerer_rc_gen_elem_fn(self, false);
    Lowerer_rc_gen_elem_fn(self, true);
    Lowerer_rc_gen_mem_drop_fn(self, false);
    Lowerer_rc_gen_mem_drop_fn(self, true);
    Lowerer_rc_gen_key_strs_fn(self);
    Lowerer_rc_record_type_keys(self);
}

// inc-roadmap B6: the type key of own type i (__own_drop_<i>, __own_dup_<i>)
// of the last lowering, for `ccompile --inc` (compiler.fd
// incu_canon_own_names), which names those functions by their type so that
// a unit calling them keys the same in every program.
var g_lw_own_type_keys: Vec<str> = Vec::new();

fn Lowerer_rc_record_type_keys(self: & mut Lowerer) {
    var keys: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < self.own_types.len() {
        keys.push(self.own_types.get(i).key);
        i = i + 1;
    }
    g_lw_own_type_keys = keys;
}

/// The own types' keys of the last lowering, by index (B6).
pub fn lw_own_type_keys() -> Vec<str> {
    return g_lw_own_type_keys;
}

/// 1 << i for 0 <= i < 64 (bit 63 included).
@wrapping fn lw_key_bit(i: i64) -> i64 {
    return 1 << i;
}

/// Which words of struct `t`, laid out from byte `base`, hold strings: bit
/// (offset / 8) for each `str` field, the fields of an inline struct field
/// flattened (its offset added); enum fields and words from 64 on give
/// nothing (RT5: core's hm_fields_hash / hm_fields_eq read those words as
/// text).
fn Lowerer_rc_key_strs_mask(self: & mut Lowerer, t: Type, base: i64, depth: i64) -> i64 {
    var mask: i64 = 0;
    if depth > 16 {
        return mask;
    }
    var rt: Type = Lowerer_resolve_type(self, t);
    // a tuple (a map's tuple key, a tuple field): its elements' strings
    match rt {
        Type::Tuple(tes) => {
            if tes.len() > 0 {
                return Lowerer_key_tuple_mask(self, tes, base, depth + 1);
            }
            return mask;
        }
        _ => {
        }
    }
    var name: str = lw_rc_type_name(rt);
    if !Lowerer_rc_is_mem_type(self, rt) {
        return mask;
    }
    var args: Vec<Type> = lw_rc_type_args(rt);
    match Lowerer_lookup_struct(self, name) {
        OptStructDef::Some(sd) => {
            var i: i64 = 0;
            while i < sd.fields.len() {
                var f: Param = sd.fields.get(i);
                var off: i64 = Lowerer_rc_field_offset(self, name, f.name);
                if off >= 0 {
                    var ft: Type = lw_rc_subst(f.ty, sd.type_params, args);
                    var at: i64 = base + off;
                    if Lowerer_rc_kind(self, ft) == RC_STR {
                        if at % 8 == 0 && at / 8 < 64 {
                            mask = mask | lw_key_bit(at / 8);
                        }
                    } else if lw_rc_is_param(f.ty, sd.type_params) {
                        // a type parameter's field is one word: a struct
                        // argument is a pointer to a heap copy, not inline
                        // (Lowerer_rc_gen_param_payload)
                    } else {
                        var frt: Type = Lowerer_resolve_type(self, ft);
                        var ftes: Vec<Type> = Lowerer_rc_tuple_elems(self, frt);
                        if ftes.len() > 0 {
                            // a tuple field held inline (Lowerer_held_ir)
                            match Lowerer_rc_field_ir(self, name, f.name) {
                                IrType::Struct(_) => {
                                    mask = mask | Lowerer_key_tuple_mask(self, ftes, at, depth + 1);
                                }
                                _ => {
                                }
                            }
                        } else if Lowerer_rc_is_mem_type(self, frt) {
                            match Lowerer_lookup_struct(self, lw_rc_type_name(frt)) {
                                OptStructDef::Some(_) => {
                                    mask = mask | Lowerer_rc_key_strs_mask(self, frt, at, depth + 1);
                                }
                                OptStructDef::None => {
                                }
                            }
                        }
                    }
                }
                i = i + 1;
            }
        }
        OptStructDef::None => {
        }
    }
    return mask;
}

/// The body of core's `__p_key_strs(tid) -> i64`: for the struct (or
/// tuple) type numbered 16 + i, the words of it that hold strings
/// (Lowerer_rc_key_strs_mask); 0 for any other type. A struct or tuple key
/// of a map (HashMap_insert_k) then hashes and compares those words as
/// text.
fn Lowerer_rc_gen_key_strs_fn(self: & mut Lowerer) {
    var fname: str = "__p_key_strs";
    if !Lowerer_has_function(self, fname) {
        return;
    }
    var f: IrFunction = IrFunction_new(fname, IrType::I64);
    var env_ty: IrType = IrType::Ptr(Box::new(IrType::U8));
    var env_val: i64 = IrFunction_new_value(& mut f, ValueMeta_new(env_ty));
    f.params.push(ValueIdType_new(env_val, env_ty));
    var tid: i64 = IrFunction_new_value(& mut f, ValueMeta_new(IrType::I64));
    f.params.push(ValueIdType_new(tid, IrType::I64));
    var prev_func: IrFunction = self.current_func;
    var prev_has: bool = self.has_current_func;
    var prev_block: i64 = self.current_block;
    var prev_on: bool = self.own_on;
    self.own_on = false;
    self.current_func = f;
    self.current_func.name = fname;
    self.has_current_func = true;
    self.current_block = 0;
    self.current_func.current_block_idx = 0;
    var i: i64 = 0;
    while i < self.own_types.len() {
        var ot: OwnType = self.own_types.get(i);
        var mask: i64 = Lowerer_rc_key_strs_mask(self, ot.ty, 0, 0);
        if mask != 0 {
            var here: i64 = Lowerer_new_block(self);
            var next: i64 = Lowerer_new_block(self);
            var want: i64 = Lowerer_emit_inst(self, Inst::ConstInt(16 + i, IrType::I64));
            var is_it: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tid, want, IrType::Bool));
            Lowerer_emit_terminator(self, Inst::Branch(is_it, here, next));
            Lowerer_set_current_block(self, here);
            var mv: i64 = Lowerer_emit_inst(self, Inst::ConstInt(mask, IrType::I64));
            Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(mv)));
            Lowerer_set_current_block(self, next);
        }
        i = i + 1;
    }
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(zero)));
    self.current_func.effects = EffectSet_new();
    var done: str = self.current_func.name;
    IrModule_replace_function_named(& mut self.module, self.current_func, done);
    self.current_func = prev_func;
    self.has_current_func = prev_has;
    self.current_block = prev_block;
    self.own_on = prev_on;
}

/// The body of core's __p_mem_drop(tid, p): __own_drop_<i>(p) for the
/// struct or enum type numbered 16 + i, whose memory stays allocated (what
/// a counted Box holds inline).
fn Lowerer_rc_gen_mem_drop_fn(self: & mut Lowerer, dup: bool) {
    var fname: str = "__p_mem_drop";
    var each: str = "__own_drop_";
    if dup {
        fname = "__p_mem_dup";
        each = "__own_dup_";
    }
    if !Lowerer_has_function(self, fname) {
        return;
    }
    var f: IrFunction = IrFunction_new(fname, IrType::Void);
    var env_ty: IrType = IrType::Ptr(Box::new(IrType::U8));
    var env_val: i64 = IrFunction_new_value(& mut f, ValueMeta_new(env_ty));
    f.params.push(ValueIdType_new(env_val, env_ty));
    var tid: i64 = IrFunction_new_value(& mut f, ValueMeta_new(IrType::I64));
    f.params.push(ValueIdType_new(tid, IrType::I64));
    var p: i64 = IrFunction_new_value(& mut f, ValueMeta_new(IrType::I64));
    f.params.push(ValueIdType_new(p, IrType::I64));
    var prev_func: IrFunction = self.current_func;
    var prev_has: bool = self.has_current_func;
    var prev_block: i64 = self.current_block;
    var prev_on: bool = self.own_on;
    self.own_on = false;
    self.current_func = f;
    self.current_func.name = fname;
    self.has_current_func = true;
    self.current_block = 0;
    self.current_func.current_block_idx = 0;
    var i: i64 = 0;
    while i < self.own_types.len() {
        var here: i64 = Lowerer_new_block(self);
        var next: i64 = Lowerer_new_block(self);
        var want: i64 = Lowerer_emit_inst(self, Inst::ConstInt(16 + i, IrType::I64));
        var is_it: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tid, want, IrType::Bool));
        Lowerer_emit_terminator(self, Inst::Branch(is_it, here, next));
        Lowerer_set_current_block(self, here);
        var dr: Vec<i64> = Vec::new();
        dr.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
        dr.push(p);
        Lowerer_emit_inst(self, Inst::Call(each + int_to_str(i), dr, IrType::Void, lw_rc_eff()));
        Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
        Lowerer_set_current_block(self, next);
        i = i + 1;
    }
    Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
    self.current_func.effects = lw_rc_eff();
    var done: str = self.current_func.name;
    IrModule_replace_function_named(& mut self.module, self.current_func, done);
    self.current_func = prev_func;
    self.has_current_func = prev_has;
    self.current_block = prev_block;
    self.own_on = prev_on;
}

/// The element type ids of a Vec<T> or HashMap<K, V> AST type: [tid] or
/// [owns string keys (0/1), value tid]; empty when the type says nothing.
fn Lowerer_rc_coll_tids(self: & mut Lowerer, t0: Type) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var t: Type = Lowerer_resolve_type(self, t0);
    match t {
        Type::Generic(n, a) => {
            if n == "Vec" && a.len() == 1 {
                out.push(Lowerer_rc_tid(self, a.get(0)));
            }
            if n == "HashMap" && a.len() == 2 {
                var kstr: i64 = 0;
                if Lowerer_rc_kind(self, a.get(0)) == RC_STR {
                    kstr = 1;
                }
                out.push(kstr);
                out.push(Lowerer_rc_tid(self, a.get(1)));
            }
        }
        _ => {
        }
    }
    return out;
}

/// An empty collection of AST type `t` that owns its elements by their
/// type: Vec_new_typed(code, tid) or HashMap_new_typed(keys, vtid); -1 when
/// `t` says nothing about them (the caller makes it the old way).
pub fn Lowerer_rc_new_coll(self: & mut Lowerer, t: Type) -> i64 {
    if !LOWER_RC || !self.own_on {
        return - 1;
    }
    var tids: Vec<i64> = Lowerer_rc_coll_tids(self, t);
    if tids.len() == 1 {
        if !Lowerer_has_function(self, "Vec_new_typed") {
            return - 1;
        }
        var code: i64 = lw_vec_elem_code(t);
        var a: Vec<i64> = Vec::new();
        a.push(Lowerer_rc_env(self));
        a.push(Lowerer_emit_inst(self, Inst::ConstInt(code, IrType::I64)));
        a.push(Lowerer_emit_inst(self, Inst::ConstInt(tids.get(0), IrType::I64)));
        return Lowerer_emit_inst(self, Inst::Call("Vec_new_typed", a, Lowerer_lower_type(self, t), EffectSet_new()));
    }
    if tids.len() == 2 {
        if !Lowerer_has_function(self, "HashMap_new_typed") {
            return - 1;
        }
        var b: Vec<i64> = Vec::new();
        b.push(Lowerer_rc_env(self));
        b.push(Lowerer_emit_inst(self, Inst::ConstBool(tids.get(0) == 1)));
        b.push(Lowerer_emit_inst(self, Inst::ConstInt(tids.get(1), IrType::I64)));
        return Lowerer_emit_inst(self, Inst::Call("HashMap_new_typed", b, Lowerer_lower_type(self, t), EffectSet_new()));
    }
    return - 1;
}

// A local Vec that never leaves its function keeps its header on the stack
// (LF13): Vec_init_typed instead of Vec_new_typed, Vec_drop_inplace instead
// of Vec_drop.
const LOWER_STACK_VECS: bool = true;  /// Whether the module has function `name`.
fn lw_module_has_fn(module: & IrModule, name: str) -> bool {
    return lw_fn_at(module, name) >= 0;
}

/// LF13 over every function.
fn lw_rc_stack_vecs(module: & mut IrModule) {
    if !lw_module_has_fn(module, "Vec_init_typed") || !lw_module_has_fn(module, "Vec_drop_inplace") {
        return;
    }
    // OP27: the parameters of the program's own functions a stack header
    // may be passed to
    var safe: i64 = lw_rc_header_safe_params(module);
    // `Vec::filled(n, x)` too, where core can fill a header in place
    var filled_ok: bool = lw_module_has_fn(module, "Vec_init_filled");
    // LF13: a small `Vec::filled` whose buffer stays on the stack too, and
    // concatenated strings that stay in their frame, where core has the
    // entry points
    var vbuf_ok: bool = LOWER_STACK_VBUFS && lw_module_has_fn(module, "Vec_init_filled_at") && lw_module_has_fn(module, "Vec_drop_stackbuf");
    var strs_ok: bool = LOWER_STACK_STRS && (lw_module_has_fn(module, "Str_concat_into") || lw_module_has_fn(module, "Int_to_str_into") || lw_module_has_fn(module, "Bool_to_str_into"));
    // OP27: Boxes that stay in their frame, where core can drop what a
    // Box holds in place
    var boxes_ok: bool = LOWER_STACK_BOXES && lw_module_has_fn(module, "__p_mem_drop");
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var fentry: IrFunctionEntry = module.functions.get(fi);
        // core's own Vec functions keep their headers on the heap
        if !str_starts_with(fentry.name, "Vec_") && !str_starts_with(fentry.name, "vec_") {
            var f: IrFunction = fentry.func;
            if !lw_rg_has_region(& f) {
                var fch: bool = lw_rc_stack_vecs_fn(& mut f, safe, filled_ok, vbuf_ok);
                if boxes_ok && !str_starts_with(fentry.name, "Box_") && !str_starts_with(fentry.name, "rg_") && lw_rc_stack_boxes_fn(& mut f) {
                    fch = true;
                }
                if strs_ok && lw_rc_stack_str_candidate(fentry.name) && lw_rc_stack_strs_fn(& mut f) {
                    fch = true;
                }
                if fch {
                    module.functions.set(fi, IrFunctionEntry_new(fentry.name, f));
                }
            }
        }
        fi = fi + 1;
    }
}

/// A call whose argument 1 may be a Vec header on the stack: core's Vec
/// functions use the header in place and never free it (Vec_drop is turned
/// into Vec_drop_inplace).
fn lw_rc_header_safe_call(name: str) -> bool {
    if name == "Vec_share_deep" {
        return false;
    }
    return str_starts_with(name, "Vec_") || str_starts_with(name, "vec_") || str_starts_with(name, "p_vec_");
}

/// OP27: whether call `cn(cargs)` takes the Vec header `u` without keeping
/// or freeing it: as argument 1 of core's Vec functions (0 of the p_vec_*
/// builtins) and nowhere else, or only as parameters of the program's own
/// functions that `safe` (lw_rc_header_safe_params) found safe. `drops`:
/// whether Vec_drop counts (the creating function's drops become
/// Vec_drop_inplace; a callee must not drop what it borrows).
fn lw_rc_safe_vec_use(cn: str, cargs: Vec<i64>, u: i64, safe: i64, drops: bool) -> bool {
    if lw_rc_header_safe_call(cn) {
        if !drops && str_starts_with(cn, "Vec_drop") {
            return false;
        }
        // core's Vec_* take an env first; the p_vec_* builtins take the
        // Vec first
        var at: i64 = 1;
        if str_starts_with(cn, "p_vec_") {
            at = 0;
        }
        if cargs.len() <= at || cargs.get(at) != u {
            return false;
        }
        var a: i64 = 0;
        while a < cargs.len() {
            if a != at && cargs.get(a) == u {
                return false;
            }
            a = a + 1;
        }
        return true;
    }
    if safe == 0 || cargs.len() == 0 || HashMap_get(safe, cn + "#n") != cargs.len() {
        return false;
    }
    var seen: bool = false;
    var b: i64 = 0;
    while b < cargs.len() {
        if cargs.get(b) == u {
            if HashMap_get(safe, cn + "#" + int_to_str(b)) != 1 {
                return false;
            }
            seen = true;
        }
        b = b + 1;
    }
    return seen;
}

/// OP27: whether call `cn(cargs)` takes the address of slot `s` (which
/// holds a Vec header: `&mut v` / `&v`) only as parameters of the program's
/// own functions that `safe` found reference-safe ("name#r<i>"): they only
/// load the header from it and hand that to core's Vec functions (no drop,
/// no store through it), or pass the address on to such parameters.
fn lw_rc_safe_slot_arg(cn: str, cargs: Vec<i64>, s: i64, safe: i64) -> bool {
    if safe == 0 || cargs.len() == 0 || HashMap_get(safe, cn + "#n") != cargs.len() {
        return false;
    }
    var seen: bool = false;
    var b: i64 = 0;
    while b < cargs.len() {
        if cargs.get(b) == s {
            if HashMap_get(safe, cn + "#r" + int_to_str(b)) != 1 {
                return false;
            }
            seen = true;
        }
        b = b + 1;
    }
    return seen;
}

/// OP27: the parameters of the program's own functions that only hand the
/// Vec header they get to core's Vec functions or to such parameters,
/// directly or through one slot, so a caller may pass a header that lives
/// on its stack (LF13). A map: "name#i" -> 1 for a safe parameter i (0:
/// not), "name#r<i>" -> 1 when parameter i may get the address of a slot
/// holding such a header (`&mut Vec` / `&Vec`: it only loads the header
/// and hands that on the same way, or passes the address on to such
/// parameters), "name#n" -> the parameter count; 0 when it did not settle. A
/// greatest fixpoint: recursion keeps a parameter safe while nothing else
/// spoils it. After the first round only the callers of a function that
/// lost a parameter are looked at again.
fn lw_rc_header_safe_params(module: & IrModule) -> i64 {
    var safe: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var fe: IrFunctionEntry = module.functions.get(fi);
        if lw_rc_param_candidate(fe) {
            HashMap_insert(safe, fe.name + "#n", fe.func.params.len());
            var pi: i64 = 0;
            while pi < fe.func.params.len() {
                HashMap_insert(safe, fe.name + "#" + int_to_str(pi), 1);
                // `&mut Vec` / `&Vec`: the address of the caller's slot
                HashMap_insert(safe, fe.name + "#r" + int_to_str(pi), 1);
                pi = pi + 1;
            }
        }
        fi = fi + 1;
    }
    // the program's functions each one calls
    var callees: Vec<Vec<str>> = Vec::new();
    fi = 0;
    while fi < module.functions.len() {
        var cs: Vec<str> = Vec::new();
        var fe2: IrFunctionEntry = module.functions.get(fi);
        if lw_rc_param_candidate(fe2) {
            var ii: i64 = 0;
            while ii < fe2.func.insts.len() {
                match fe2.func.insts.get(ii).inst {
                    Inst::Call(cn, _, _, _) => {
                        if HashMap_contains(safe, cn + "#n") {
                            cs.push(cn);
                        }
                    }
                    _ => {
                    }
                }
                ii = ii + 1;
            }
        }
        callees.push(cs);
        fi = fi + 1;
    }
    var dirty: i64 = HashMap_new();
    var first: bool = true;
    var rounds: i64 = 0;
    while rounds < 10000 {
        var lost: i64 = HashMap_new();
        var any: bool = false;
        fi = 0;
        while fi < module.functions.len() {
            var fe3: IrFunctionEntry = module.functions.get(fi);
            if lw_rc_param_candidate(fe3) {
                var look: bool = first;
                if !look {
                    var cs2: Vec<str> = callees.get(fi);
                    var ci: i64 = 0;
                    while ci < cs2.len() && !look {
                        look = HashMap_contains(dirty, cs2.get(ci));
                        ci = ci + 1;
                    }
                }
                var ff: IrFunction = fe3.func;
                if look && lw_rc_check_params(& ff, fe3.name, safe) {
                    HashMap_insert(lost, fe3.name, 1);
                    any = true;
                }
            }
            fi = fi + 1;
        }
        if !any {
            return safe;
        }
        dirty = lost;
        first = false;
        rounds = rounds + 1;
    }
    return 0;
}

/// OP27: a function whose parameters lw_rc_header_safe_params looks at:
/// one with a body, not core's own Vec functions.
fn lw_rc_param_candidate(fe: IrFunctionEntry) -> bool {
    return fe.func.blocks.len() > 0 && fe.func.params.len() > 0 && !str_starts_with(fe.name, "Vec_") && !str_starts_with(fe.name, "vec_");
}

/// OP27: one function's still-safe parameters checked against `safe`; the
/// ones that are not are set to 0 there. True when one was.
fn lw_rc_check_params(f: & IrFunction, name: str, safe: i64) -> bool {
    var nv: i64 = f.next_value;
    var np: i64 = f.params.len();
    if nv <= 0 {
        return false;
    }
    // value id -> parameter index (-1: not a tracked parameter)
    var pidx: Vec<i64> = Vec::new();
    var is_alloca: Vec<i64> = Vec::new();
    var loaded_from: Vec<i64> = Vec::new();
    // slot -> the parameter stored in it (-1: none, -2: several)
    var slot_param: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        pidx.push(- 1);
        is_alloca.push(0);
        loaded_from.push(- 1);
        slot_param.push(- 1);
        i = i + 1;
    }
    var bad: Vec<i64> = Vec::new();
    // the same for the address use ("name#r<i>": `&mut Vec` / `&Vec`)
    var badr: Vec<i64> = Vec::new();
    var tracked: i64 = 0;
    var pi: i64 = 0;
    while pi < np {
        bad.push(0);
        badr.push(0);
        var pid: i64 = f.params.get(pi).id;
        var tv: bool = HashMap_get(safe, name + "#" + int_to_str(pi)) == 1;
        var tr: bool = HashMap_get(safe, name + "#r" + int_to_str(pi)) == 1;
        if (tv || tr) && pid >= 0 && pid < nv {
            pidx.set(pid, pi);
            tracked = tracked + 1;
        }
        pi = pi + 1;
    }
    if tracked == 0 {
        return false;
    }
    i = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        if ve.id >= 0 && ve.id < nv {
            match ve.inst {
                Inst::Alloca(_, _) => {
                    is_alloca.set(ve.id, 1);
                }
                Inst::Load(lp, _) => {
                    if lp >= 0 && lp < nv {
                        loaded_from.set(ve.id, lp);
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1;
    }
    // which parameter goes into which slot
    i = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Store(sp, sv, _) => {
                if sp >= 0 && sp < nv && sv >= 0 && sv < nv && pidx.get(sv) >= 0 && is_alloca.get(sp) == 1 {
                    var held: i64 = slot_param.get(sp);
                    if held == - 1 {
                        slot_param.set(sp, pidx.get(sv));
                    } else if held >= 0 && held != pidx.get(sv) {
                        bad.set(held, 1);
                        bad.set(pidx.get(sv), 1);
                        slot_param.set(sp, - 2);
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    // every use
    i = 0;
    while i < f.insts.len() {
        var ue: ValueIdInst = f.insts.get(i);
        var refs: Vec<i64> = inst_value_refs(& ue.inst);
        var r: i64 = 0;
        while r < refs.len() {
            var u: i64 = refs.get(r);
            if u >= 0 && u < nv {
                // the parameter: stored into its slot, or a safe argument
                var up: i64 = pidx.get(u);
                if up >= 0 {
                    var fine_p: bool = false;
                    match ue.inst {
                        Inst::Store(psp, psv, _) => {
                            fine_p = psv == u && psp != u && psp >= 0 && psp < nv && slot_param.get(psp) == up;
                        }
                        Inst::Call(pcn, pcargs, _, _) => {
                            fine_p = lw_rc_safe_vec_use(pcn, pcargs, u, safe, false);
                        }
                        _ => {
                        }
                    }
                    if !fine_p {
                        bad.set(up, 1);
                    }
                    // as the address of the caller's slot: loads of the
                    // header, or passed on to a reference-safe parameter
                    var fine_r: bool = false;
                    match ue.inst {
                        Inst::Load(rlp, _) => {
                            fine_r = rlp == u;
                        }
                        Inst::Call(rcn, rcargs, _, _) => {
                            fine_r = lw_rc_safe_slot_arg(rcn, rcargs, u, safe);
                        }
                        _ => {
                        }
                    }
                    if !fine_r {
                        badr.set(up, 1);
                    }
                }
                // a header loaded through the parameter's address: a safe
                // argument that is not dropped
                var lr: i64 = loaded_from.get(u);
                if lr >= 0 && pidx.get(lr) >= 0 {
                    var fine_lr: bool = false;
                    match ue.inst {
                        Inst::Call(lrcn, lrcargs, _, _) => {
                            fine_lr = lw_rc_safe_vec_use(lrcn, lrcargs, u, safe, false);
                        }
                        _ => {
                        }
                    }
                    if !fine_lr {
                        badr.set(pidx.get(lr), 1);
                    }
                }
                // its slot: loads, and stores of it or of a literal
                var sp2: i64 = slot_param.get(u);
                if sp2 >= 0 {
                    var fine_s: bool = false;
                    match ue.inst {
                        Inst::Load(lsp, _) => {
                            fine_s = lsp == u;
                        }
                        Inst::Store(ssp, ssv, _) => {
                            fine_s = ssp == u && ssv != u && ssv >= 0 && ssv < nv && (pidx.get(ssv) == sp2 || lw_rc_is_literal_value(f, ssv));
                        }
                        _ => {
                        }
                    }
                    if !fine_s {
                        bad.set(sp2, 1);
                    }
                }
                // a value loaded from that slot: a safe argument
                var ls: i64 = loaded_from.get(u);
                if ls >= 0 && slot_param.get(ls) >= 0 {
                    var fine_l: bool = false;
                    match ue.inst {
                        Inst::Call(lcn, lcargs, _, _) => {
                            fine_l = lw_rc_safe_vec_use(lcn, lcargs, u, safe, false);
                        }
                        _ => {
                        }
                    }
                    if !fine_l {
                        bad.set(slot_param.get(ls), 1);
                    }
                }
            }
            r = r + 1;
        }
        i = i + 1;
    }
    var changed: bool = false;
    pi = 0;
    while pi < np {
        if bad.get(pi) == 1 && HashMap_get(safe, name + "#" + int_to_str(pi)) == 1 {
            HashMap_insert(safe, name + "#" + int_to_str(pi), 0);
            changed = true;
        }
        if badr.get(pi) == 1 && HashMap_get(safe, name + "#r" + int_to_str(pi)) == 1 {
            HashMap_insert(safe, name + "#r" + int_to_str(pi), 0);
            changed = true;
        }
        pi = pi + 1;
    }
    return changed;
}

/// LF13 in one function: true when it changed. A `h = Vec_new_typed(...)`
/// (or Vec_new, Vec_new_sized, and Vec_filled_typed when `filled_ok`: core
/// has Vec_init_filled) qualifies when h is only stored into one slot S,
/// every other store to S is a zero, S is used only by those loads and
/// stores, and every value loaded from S is only argument 1 of core's Vec
/// functions. `vbuf_ok`: core has Vec_init_filled_at / Vec_drop_stackbuf, so
/// a small Vec_filled_typed whose buffer never grows or is shared puts the
/// buffer on the stack too (lw_rc_vbuf_fits).
pub fn lw_rc_stack_vecs_fn(f: & mut IrFunction, safe: i64, filled_ok: bool, vbuf_ok: bool) -> bool {
    var nv: i64 = f.next_value;
    if nv <= 0 || f.blocks.len() == 0 {
        return false;
    }
    var loaded_from: Vec<i64> = Vec::new();
    var created: Vec<i64> = Vec::new();
    // 1: a Vec_new_typed / Vec_new result
    var slot_of: Vec<i64> = Vec::new();
    // h -> the slot it is stored in
    var h_of: Vec<i64> = Vec::new();
    // S -> the h stored in it (-2: several)
    var ok_slot: Vec<i64> = Vec::new();
    // S -> 1 while it qualifies
    var i: i64 = 0;
    while i < nv {
        loaded_from.push(- 1);
        created.push(0);
        slot_of.push(- 1);
        h_of.push(- 1);
        ok_slot.push(0);
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        // CS4: read in place, not copied
        var ve_id: i64 = f.insts.get(i).id;
        match f.insts.get(i).inst {
            Inst::Call(cn, cargs, _, _) => {
                if (cn == "Vec_new_typed" && cargs.len() == 3) || (cn == "Vec_new" && cargs.len() == 1) || (cn == "Vec_new_sized" && cargs.len() == 2) || ((filled_ok || vbuf_ok) && cn == "Vec_filled_typed" && cargs.len() == 5) {
                    if ve_id >= 0 && ve_id < nv {
                        created.set(ve_id, 1);
                    }
                }
            }
            Inst::Alloca(_, _) => {
                if ve_id >= 0 && ve_id < nv {
                    ok_slot.set(ve_id, 1);
                }
            }
            Inst::Load(lp, _) => {
                if ve_id >= 0 && ve_id < nv && lp >= 0 && lp < nv {
                    loaded_from.set(ve_id, lp);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    // stores: which h goes into which slot
    i = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Store(sp, sv, _) => {
                if sp >= 0 && sp < nv && sv >= 0 && sv < nv && created.get(sv) == 1 {
                    if slot_of.get(sv) >= 0 && slot_of.get(sv) != sp {
                        created.set(sv, 0);
                    }
                    slot_of.set(sv, sp);
                    if h_of.get(sp) == - 1 {
                        h_of.set(sp, sv);
                    } else if h_of.get(sp) != sv {
                        h_of.set(sp, - 2);
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    // every use checked (CS4: f.insts.get(i).inst read in place, not copied)
    i = 0;
    while i < f.insts.len() {
        var refs: Vec<i64> = inst_value_refs(& f.insts.get(i).inst);
        var r: i64 = 0;
        while r < refs.len() {
            var u: i64 = refs.get(r);
            if u >= 0 && u < nv {
                // h: only its one store into a slot
                if created.get(u) == 1 {
                    var fine_h: bool = false;
                    match f.insts.get(i).inst {
                        Inst::Store(hsp, hsv, _) => {
                            fine_h = hsv == u && hsp != u;
                        }
                        _ => {
                        }
                    }
                    if !fine_h {
                        created.set(u, 0);
                    }
                }
                // S: loads, and stores of its h or of zero
                if ok_slot.get(u) == 1 {
                    var fine_s: bool = false;
                    match f.insts.get(i).inst {
                        Inst::Load(lsp, _) => {
                            fine_s = lsp == u;
                        }
                        Inst::Store(ssp, ssv, _) => {
                            fine_s = ssp == u && ssv != u && (ssv == h_of.get(u) || lw_rc_is_literal_value(f, ssv));
                        }
                        Inst::Call(scn, scargs, _, _) => {
                            // OP27: `&mut v` / `&v` to a reference-safe
                            // parameter of the program's own function
                            fine_s = lw_rc_safe_slot_arg(scn, scargs, u, safe);
                        }
                        _ => {
                        }
                    }
                    if !fine_s {
                        ok_slot.set(u, 0);
                    }
                }
                // a value loaded from S: argument 1 of core's Vec functions
                var ls: i64 = loaded_from.get(u);
                if ls >= 0 && ok_slot.get(ls) == 1 {
                    var fine_l: bool = false;
                    match f.insts.get(i).inst {
                        Inst::Call(lcn, lcargs, _, _) => {
                            fine_l = lw_rc_safe_vec_use(lcn, lcargs, u, safe, true);
                        }
                        _ => {
                        }
                    }
                    if !fine_l {
                        ok_slot.set(ls, 0);
                    }
                }
            }
            r = r + 1;
        }
        i = i + 1;
    }
    // the creations that qualify
    var changed: bool = false;
    var pro: Vec<i64> = Vec::new();
    // SP12: slot -> how its drops change (lw_rc_stack_drops; 0: they stay)
    var drop_kind: Vec<i64> = Vec::new();
    var dk: i64 = 0;
    while dk < nv {
        drop_kind.push(0);
        dk = dk + 1;
    }
    var any_drops: bool = false;
    var h: i64 = 0;
    while h < nv {
        if created.get(h) == 1 && slot_of.get(h) >= 0 {
            var sl: i64 = slot_of.get(h);
            if ok_slot.get(sl) == 1 && h_of.get(sl) == h {
                // LF13: Vec::filled's buffer too when it is small and never
                // grows; otherwise the header only, where core can fill one
                var filled: bool = lw_rc_call_name(f, h) == "Vec_filled_typed";
                if filled && vbuf_ok && lw_rc_vbuf_fits(f, h, sl) {
                    if lw_rc_stack_vbuf_rewrite(f, h, sl, & mut pro) {
                        drop_kind.set(sl, 2);
                        any_drops = true;
                    }
                    changed = true;
                } else if !filled || filled_ok {
                    if lw_rc_stack_vec_rewrite(f, h, sl, & mut pro) {
                        drop_kind.set(sl, 1);
                        any_drops = true;
                    }
                    changed = true;
                }
            }
        }
        h = h + 1;
    }
    if any_drops {
        lw_rc_stack_drops(f, & drop_kind);
    }
    if !changed {
        return false;
    }
    // the stack areas, at the start of the entry block
    var blk: BasicBlock = f.blocks.get(0);
    var fresh: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < pro.len() {
        fresh.push(pro.get(k));
        k = k + 1;
    }
    k = 0;
    while k < blk.instructions.len() {
        fresh.push(blk.instructions.get(k));
        k = k + 1;
    }
    blk.instructions = fresh;
    f.blocks.set(0, blk);
    return true;
}

/// Turn creation `h` (stored in slot `sl`) into Vec_init_typed on a stack
/// area made in `pro`. True when every Vec_drop of a value loaded from `sl`
/// is to become Vec_drop_inplace (SP12: lw_rc_stack_drops does that for
/// all slots in one pass; each candidate scanned the whole function).
fn lw_rc_stack_vec_rewrite(f: & mut IrFunction, h: i64, sl: i64, pro: & mut Vec<i64>) -> bool {
    var area: i64 = lw_detached(f, Inst::Alloca(IrType::Array(Box::new(IrType::I64), 5), Region::Stack));
    var ai: i64 = lw_detached(f, Inst::BitCast(area, IrType::Ptr(Box::new(IrType::Array(Box::new(IrType::I64), 5))), IrType::I64));
    pro.push(area);
    pro.push(ai);
    if h < 0 || h >= f.inst_at.len() {
        return false;
    }
    var pos: i64 = f.inst_at.get(h) - 1;
    if pos < 0 || pos >= f.insts.len() {
        return false;
    }
    var e: ValueIdInst = f.insts.get(pos);
    match e.inst {
        Inst::Call(cn, cargs, cty, ceff) => {
            var na: Vec<i64> = Vec::new();
            na.push(cargs.get(0));
            na.push(ai);
            var init_fn: str = "Vec_init_typed";
            if cn == "Vec_new_typed" {
                na.push(cargs.get(1));
                na.push(cargs.get(2));
            } else if cn == "Vec_new_sized" {
                // Vec_new_sized(code) is Vec_new_typed(code, 0)
                var zt: i64 = lw_detached(f, Inst::ConstInt(0, IrType::I64));
                pro.push(zt);
                na.push(cargs.get(1));
                na.push(zt);
            } else if cn == "Vec_filled_typed" {
                // Vec_filled_typed(n, x, code, tid) filling the stack header
                init_fn = "Vec_init_filled";
                na.push(cargs.get(1));
                na.push(cargs.get(2));
                na.push(cargs.get(3));
                na.push(cargs.get(4));
            } else {
                var z1: i64 = lw_detached(f, Inst::ConstInt(0, IrType::I64));
                var z2: i64 = lw_detached(f, Inst::ConstInt(0, IrType::I64));
                pro.push(z1);
                pro.push(z2);
                na.push(z1);
                na.push(z2);
            }
            e.inst = Inst::Call(init_fn, na, cty, ceff);
            f.insts.set(pos, e);
        }
        _ => {
        }
    }
    // its drops: lw_rc_stack_drops (kind 1)
    return true;
}

/// SP12: the drops of the slots lw_rc_stack_vecs_fn put on the stack, in
/// one pass over `f`: a Vec_drop / Vec_drop_strs / Vec_drop_vecs (the older
/// deep-drop names run Vec_drop too: they would free the stack header) of a
/// value loaded from a slot of kind 1 (`kind`, by slot id) becomes
/// Vec_drop_inplace; one of those or Vec_drop_inplace, from a slot of kind
/// 2 (a stack buffer too), Vec_drop_stackbuf. The same rewrites
/// lw_rc_stack_vec_rewrite and lw_rc_stack_vbuf_rewrite each made by a scan
/// of the whole function per slot: the slots differ, and a load has one.
fn lw_rc_stack_drops(f: & mut IrFunction, kind: & Vec<i64>) {
    var q: i64 = 0;
    while q < f.insts.len() {
        var nk: i64 = 0;
        match f.insts.get(q).inst {
            Inst::Call(dn, dargs, _, _) => {
                if (dn == "Vec_drop" || dn == "Vec_drop_inplace" || dn == "Vec_drop_strs" || dn == "Vec_drop_vecs") && dargs.len() == 2 {
                    var lat: i64 = lw_inst_pos(f, dargs.get(1));
                    if lat >= 0 && lat < f.insts.len() {
                        match f.insts.get(lat).inst {
                            Inst::Load(dp, _) => {
                                if dp >= 0 && dp < kind.len() {
                                    nk = kind.get(dp);
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    if nk == 1 && dn == "Vec_drop_inplace" {
                        nk = 0;
                    }
                }
            }
            _ => {
            }
        }
        if nk == 1 || nk == 2 {
            var de: ValueIdInst = f.insts.get(q);
            match de.inst {
                Inst::Call(_, dargs2, dty, deff) => {
                    var nn: str = "Vec_drop_inplace";
                    if nk == 2 {
                        nn = "Vec_drop_stackbuf";
                    }
                    de.inst = Inst::Call(nn, dargs2, dty, deff);
                    f.insts.set(q, de);
                }
                _ => {
                }
            }
        }
        q = q + 1;
    }
}

// LF13: a small `Vec::filled(n, x)` of plain values whose buffer never
// grows, is never shared and never leaves the function keeps its buffer on
// the stack next to its header (core's Vec_init_filled_at fills both;
// Vec_drop_stackbuf ends it without freeing anything).
const LOWER_STACK_VBUFS: bool = true;
/// The largest Vec buffer (bytes) made on the stack.
const LOWER_STACK_VBUF_MAX: i64 = 512;

/// The name of the function instruction `v` calls, or "".
fn lw_rc_call_name(f: & IrFunction, v: i64) -> str {
    match IrFunction_get_inst(f, v) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(cn, _, _, _) => {
                    return cn;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return "";
}

/// The size in bytes of an element of code `code` (core's vec_esz) when a
/// stack buffer may hold it: a plain value of at most a word; -1 for a
/// struct held inline or a code that is not known.
fn lw_rc_vbuf_esz(code: i64) -> i64 {
    if code == 0 {
        return 8;
    }
    if code < 0 && code >= 0 - 8 {
        return 0 - code;
    }
    if code > 0 && code <= 8 {
        return code;
    }
    return - 1;
}

/// The argument position of the Vec in a call that uses a Vec of plain
/// values in place and never grows, shares or frees its buffer (1 for
/// core's Vec_* functions, 0 for the p_vec_* builtins), or -1.
fn lw_rc_vbuf_call_at(cn: str) -> i64 {
    if cn == "Vec_get" || cn == "Vec_set" || cn == "Vec_len" || cn == "Vec_is_empty" || cn == "Vec_contains" || cn == "Vec_first" || cn == "Vec_last" || cn == "Vec_capacity" || cn == "Vec_reverse" || cn == "Vec_to_str" || cn == "Vec_clone" {
        return 1;
    }
    if cn == "p_vec_get" || cn == "p_vec_len" || cn == "p_vec_is_empty" {
        return 0;
    }
    return - 1;
}

/// Whether call `cn(cargs)` uses the Vec `u` whose buffer is on the stack
/// only as lw_rc_vbuf_call_at allows, or drops it.
fn lw_rc_vbuf_use(cn: str, cargs: Vec<i64>, u: i64) -> bool {
    var at: i64 = lw_rc_vbuf_call_at(cn);
    if cn == "Vec_drop" || cn == "Vec_drop_inplace" || cn == "Vec_drop_strs" || cn == "Vec_drop_vecs" {
        if cargs.len() != 2 {
            return false;
        }
        at = 1;
    }
    if at < 0 || cargs.len() <= at || cargs.get(at) != u {
        return false;
    }
    var a: i64 = 0;
    while a < cargs.len() {
        if a != at && cargs.get(a) == u {
            return false;
        }
        a = a + 1;
    }
    return true;
}

/// LF13: whether creation `h = Vec_filled_typed(env, n, x, code, tid)`,
/// stored in slot `sl` (lw_rc_stack_vecs_fn already found that it stays in
/// its function), may keep its buffer on the stack: n a constant above 0,
/// plain elements (tid 0, at most a word each), n elements within
/// LOWER_STACK_VBUF_MAX bytes, `sl` only loaded and stored, and every value
/// loaded from it used only by calls lw_rc_vbuf_use allows (no push,
/// insert, share or program function that could grow or keep the buffer).
fn lw_rc_vbuf_fits(f: & IrFunction, h: i64, sl: i64) -> bool {
    var n: i64 = - 1;
    var code: i64 = - 99;
    var tid: i64 = - 1;
    match IrFunction_get_inst(f, h) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(cn, cargs, _, _) => {
                    if cn == "Vec_filled_typed" && cargs.len() == 5 {
                        n = lw_rc_const_or(f, cargs.get(1), - 1);
                        code = lw_rc_const_or(f, cargs.get(3), - 99);
                        tid = lw_rc_const_or(f, cargs.get(4), - 1);
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    var esz: i64 = lw_rc_vbuf_esz(code);
    if n <= 0 || n > LOWER_STACK_VBUF_MAX || tid != 0 || esz <= 0 || n * esz > LOWER_STACK_VBUF_MAX {
        return false;
    }
    var nv: i64 = f.next_value;
    // the values loaded from sl
    var from_sl: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        from_sl.push(0);
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var lid: i64 = f.insts.get(i).id;
        match f.insts.get(i).inst {
            Inst::Load(lp, _) => {
                if lp == sl && lid >= 0 && lid < nv {
                    from_sl.set(lid, 1);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var refs: Vec<i64> = inst_value_refs(& f.insts.get(i).inst);
        var r: i64 = 0;
        while r < refs.len() {
            var u: i64 = refs.get(r);
            if u == sl {
                var fine_s: bool = false;
                match f.insts.get(i).inst {
                    Inst::Load(_, _) => {
                        fine_s = true;
                    }
                    Inst::Store(ssp, ssv, _) => {
                        fine_s = ssp == sl && ssv != sl;
                    }
                    _ => {
                    }
                }
                if !fine_s {
                    return false;
                }
            } else if u >= 0 && u < nv && from_sl.get(u) == 1 {
                var fine_l: bool = false;
                match f.insts.get(i).inst {
                    Inst::Call(lcn, lcargs, _, _) => {
                        fine_l = lw_rc_vbuf_use(lcn, lcargs, u);
                    }
                    _ => {
                    }
                }
                if !fine_l {
                    return false;
                }
            }
            r = r + 1;
        }
        i = i + 1;
    }
    return true;
}

/// LF13: turn creation `h = Vec_filled_typed(env, n, x, code, tid)` (stored
/// in slot `sl`, lw_rc_vbuf_fits said yes) into
/// Vec_init_filled_at(env, header, buffer, n, x, code, tid) on two stack
/// areas made in `pro`. True when every drop of a value loaded from `sl`
/// is to become Vec_drop_stackbuf (SP12: lw_rc_stack_drops, kind 2).
fn lw_rc_stack_vbuf_rewrite(f: & mut IrFunction, h: i64, sl: i64, pro: & mut Vec<i64>) -> bool {
    if h < 0 || h >= f.inst_at.len() {
        return false;
    }
    var pos: i64 = f.inst_at.get(h) - 1;
    if pos < 0 || pos >= f.insts.len() {
        return false;
    }
    var e: ValueIdInst = f.insts.get(pos);
    match e.inst {
        Inst::Call(cn, cargs, cty, ceff) => {
            if cn != "Vec_filled_typed" || cargs.len() != 5 {
                return false;
            }
            var n: i64 = lw_rc_const_or(f, cargs.get(1), 0);
            var esz: i64 = lw_rc_vbuf_esz(lw_rc_const_or(f, cargs.get(3), - 99));
            if n <= 0 || esz <= 0 {
                return false;
            }
            var words: i64 = (n * esz + 7) / 8;
            var area: i64 = lw_detached(f, Inst::Alloca(IrType::Array(Box::new(IrType::I64), 5), Region::Stack));
            var ai: i64 = lw_detached(f, Inst::BitCast(area, IrType::Ptr(Box::new(IrType::Array(Box::new(IrType::I64), 5))), IrType::I64));
            var barea: i64 = lw_detached(f, Inst::Alloca(IrType::Array(Box::new(IrType::I64), words), Region::Stack));
            var bi: i64 = lw_detached(f, Inst::BitCast(barea, IrType::Ptr(Box::new(IrType::Array(Box::new(IrType::I64), words))), IrType::I64));
            pro.push(area);
            pro.push(ai);
            pro.push(barea);
            pro.push(bi);
            var na: Vec<i64> = Vec::new();
            na.push(cargs.get(0));
            na.push(ai);
            na.push(bi);
            na.push(cargs.get(1));
            na.push(cargs.get(2));
            na.push(cargs.get(3));
            na.push(cargs.get(4));
            e.inst = Inst::Call("Vec_init_filled_at", na, cty, ceff);
            f.insts.set(pos, e);
        }
        _ => {
            return false;
        }
    }
    // its drops (nothing to free, the header cleared): lw_rc_stack_drops
    return true;
}

// LF13: a string made by `a + b` (p_str_concat) that never leaves its
// function is built in a stack area of LOWER_STACK_STR_BYTES bytes (core's
// Str_concat_into) as [P_STR_STATIC][len] bytes NUL, so the drops the
// lowering made leave it alone; a result that does not fit is a counted heap
// string as before, and those same drops free it. The string may only be
// read: printed, measured, compared, searched, or an operand of another
// `+`; anything that could keep it (a copy, a store, a return, a call of
// the program's own functions) leaves it on the heap.
const LOWER_STACK_STRS: bool = true;
/// The bytes of one stack string's area: 16 header bytes, up to 111 bytes
/// of text and the NUL.
const LOWER_STACK_STR_BYTES: i64 = 128;
/// At most this many stack strings in one function (512 bytes of frame:
/// deep recursion must not run out of stack).
const LOWER_STACK_STR_MAX: i64 = 8;

/// Whether LF13's stack strings look at function `name`: not core's own
/// string, Vec, map, Box or region functions.
fn lw_rc_stack_str_candidate(name: str) -> bool {
    return !str_starts_with(name, "Str_") && !str_starts_with(name, "str_") && !str_starts_with(name, "String_") && !str_starts_with(name, "p_") && !str_starts_with(name, "Vec_") && !str_starts_with(name, "vec_") && !str_starts_with(name, "HashMap_") && !str_starts_with(name, "Box_") && !str_starts_with(name, "rg_");
}

/// A call that only reads the strings it is given and returns nothing that
/// points into them (a count, a bool, an index, or a new string).
fn lw_rc_str_reader(cn: str) -> bool {
    return cn == "str_len" || cn == "p_str_length" || cn == "p_string_len" || cn == "String_len" || cn == "str_is_empty" || cn == "str_byte_at" || cn == "String_byte_at" || cn == "str_equal" || cn == "p_str_equal" || cn == "str_compare" || cn == "p_str_compare" || cn == "str_contains" || cn == "p_string_contains" || cn == "str_starts_with" || cn == "p_string_starts_with" || cn == "str_ends_with" || cn == "p_string_ends_with" || cn == "str_find" || cn == "str_rfind" || cn == "p_string_find" || cn == "str_parse_int" || cn == "p_str_concat" || cn == "p_print_str" || cn == "print" || cn == "println" || cn == "eprint" || cn == "eprintln" || cn == "p_eprint_str";
}

/// LF13 strings in one function: true when it changed. A
/// `h = p_str_concat(a, b)` qualifies when h is only stored into one slot
/// S, every other store to S is a literal (or null), S is only loaded and
/// stored, and every value loaded from S is only printed, an argument of
/// lw_rc_str_reader's calls, or cast and dropped (Str_drop).
pub fn lw_rc_stack_strs_fn(f: & mut IrFunction) -> bool {
    var nv: i64 = f.next_value;
    if nv <= 0 || f.blocks.len() == 0 {
        return false;
    }
    var created: Vec<i64> = Vec::new();
    var slot_of: Vec<i64> = Vec::new();
    var h_of: Vec<i64> = Vec::new();
    var ok_slot: Vec<i64> = Vec::new();
    var loaded_from: Vec<i64> = Vec::new();
    // a BitCast's source
    var cast_from: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        created.push(0);
        slot_of.push(- 1);
        h_of.push(- 1);
        ok_slot.push(0);
        loaded_from.push(- 1);
        cast_from.push(- 1);
        i = i + 1;
    }
    var any: bool = false;
    i = 0;
    while i < f.insts.len() {
        var ve_id: i64 = f.insts.get(i).id;
        if ve_id >= 0 && ve_id < nv {
            match f.insts.get(i).inst {
                Inst::Call(cn, cargs, _, _) => {
                    if (cn == "p_str_concat" && cargs.len() == 2) || (cn == "p_to_str" && cargs.len() == 1) || ((cn == "p_bool_to_str" || cn == "p_to_str_bool") && cargs.len() == 1) {
                        created.set(ve_id, 1);
                        any = true;
                    }
                }
                Inst::Alloca(_, _) => {
                    ok_slot.set(ve_id, 1);
                }
                Inst::Load(lp, _) => {
                    if lp >= 0 && lp < nv {
                        loaded_from.set(ve_id, lp);
                    }
                }
                Inst::BitCast(cx, _, _) => {
                    if cx >= 0 && cx < nv {
                        cast_from.set(ve_id, cx);
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1;
    }
    if !any {
        return false;
    }
    // stores: which h goes into which slot
    i = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Store(sp, sv, _) => {
                if sp >= 0 && sp < nv && sv >= 0 && sv < nv && created.get(sv) == 1 {
                    if slot_of.get(sv) >= 0 && slot_of.get(sv) != sp {
                        created.set(sv, 0);
                    }
                    slot_of.set(sv, sp);
                    if h_of.get(sp) == - 1 {
                        h_of.set(sp, sv);
                    } else if h_of.get(sp) != sv {
                        h_of.set(sp, - 2);
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    // every use checked
    i = 0;
    while i < f.insts.len() {
        var refs: Vec<i64> = inst_value_refs(& f.insts.get(i).inst);
        var r: i64 = 0;
        while r < refs.len() {
            var u: i64 = refs.get(r);
            if u >= 0 && u < nv {
                // h: only its one store into a slot, or — a temporary —
                // reader-call arguments, a print, or its drop (LF13
                // temporaries, Nov 22: an f-string's inner concats and
                // conversions are rewritten into their own areas; the drop
                // of a static area result is a no-op)
                if created.get(u) == 1 {
                    var fine_h: bool = false;
                    match f.insts.get(i).inst {
                        Inst::Store(hsp, hsv, _) => {
                            fine_h = hsv == u && hsp != u;
                        }
                        Inst::Print(_, _) => {
                            fine_h = true;
                        }
                        Inst::Call(hcn, hcargs, _, _) => {
                            fine_h = lw_rc_str_reader(hcn) || (hcn == "Str_drop" && hcargs.len() == 2 && hcargs.get(1) == u && hcargs.get(0) != u);
                        }
                        Inst::BitCast(bc_src, _, _) => {
                            // a cast of the temporary (the i64 word a call
                            // takes) is fine when the cast itself only
                            // feeds readers or the drop — checked where the
                            // cast's uses are, as for a loaded value
                            fine_h = bc_src == u;
                        }
                        _ => {
                        }
                    }
                    if !fine_h {
                        created.set(u, 0);
                    }
                }
                // S: loads, and stores of its h or of a literal
                if ok_slot.get(u) == 1 {
                    var fine_s: bool = false;
                    match f.insts.get(i).inst {
                        Inst::Load(lsp, _) => {
                            fine_s = lsp == u;
                        }
                        Inst::Store(ssp, ssv, _) => {
                            fine_s = ssp == u && ssv != u && ssv >= 0 && ssv < nv && (ssv == h_of.get(u) || lw_rc_is_literal_value(f, ssv));
                        }
                        _ => {
                        }
                    }
                    if !fine_s {
                        ok_slot.set(u, 0);
                    }
                }
                // a value loaded from S: read, or cast for its drop
                var ls: i64 = loaded_from.get(u);
                if ls >= 0 && ok_slot.get(ls) == 1 {
                    var fine_l: bool = false;
                    match f.insts.get(i).inst {
                        Inst::Print(_, _) => {
                            fine_l = true;
                        }
                        Inst::Call(lcn, lcargs, _, _) => {
                            fine_l = lw_rc_str_reader(lcn) || (lcn == "Str_drop" && lcargs.len() == 2 && lcargs.get(1) == u && lcargs.get(0) != u);
                        }
                        Inst::BitCast(_, _, _) => {
                            fine_l = true;
                        }
                        _ => {
                        }
                    }
                    if !fine_l {
                        ok_slot.set(ls, 0);
                    }
                }
                // a cast of such a value: only argument 1 of its Str_drop
                // (a cast of a created temporary is checked the same way,
                // LF13 temporaries, Nov 22)
                var cs: i64 = cast_from.get(u);
                if cs >= 0 {
                    var cls: i64 = loaded_from.get(cs);
                    var crt: i64 = -1;
                    if cls < 0 && created.get(cs) == 1 {
                        crt = cs;
                    }
                    if (cls >= 0 && ok_slot.get(cls) == 1) || crt >= 0 {
                        var fine_c: bool = false;
                        match f.insts.get(i).inst {
                            Inst::Call(dcn, dcargs, _, _) => {
                                // its drop, or a reader call the cast is an
                                // argument of (the i64 word p_str_concat and
                                // friends take; a reader never keeps it)
                                fine_c = (dcn == "Str_drop" && dcargs.len() == 2 && dcargs.get(1) == u && dcargs.get(0) != u) || lw_rc_str_reader(dcn);
                            }
                            _ => {
                            }
                        }
                        if !fine_c {
                            if cls >= 0 {
                                ok_slot.set(cls, 0);
                            }
                            if crt >= 0 {
                                created.set(crt, 0);
                            }
                        }
                    }
                }
            }
            r = r + 1;
        }
        i = i + 1;
    }
    // the creations that qualify
    var pro: Vec<i64> = Vec::new();
    var made: i64 = 0;
    var h: i64 = 0;
    while h < nv && made < LOWER_STACK_STR_MAX {
        if created.get(h) == 1 {
            var go: bool = false;
            var sl: i64 = slot_of.get(h);
            if sl >= 0 && ok_slot.get(sl) == 1 && h_of.get(sl) == h {
                go = true;
            }
            if sl < 0 {
                // a qualifying temporary: no slot, only readers, prints
                // and its drop (LF13 temporaries, Nov 22)
                go = true;
            }
            if go && lw_rc_stack_str_rewrite(f, h, & mut pro) {
                made = made + 1;
            }
        }
        h = h + 1;
    }
    if made == 0 {
        return false;
    }
    // the stack areas, at the start of the entry block
    var blk: BasicBlock = f.blocks.get(0);
    var fresh: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < pro.len() {
        fresh.push(pro.get(k));
        k = k + 1;
    }
    k = 0;
    while k < blk.instructions.len() {
        fresh.push(blk.instructions.get(k));
        k = k + 1;
    }
    blk.instructions = fresh;
    f.blocks.set(0, blk);
    return true;
}

/// Turn `h = p_str_concat(a, b)` into
/// `h = Str_concat_into(env, area, LOWER_STACK_STR_BYTES, a, b)` on a stack
/// area made in `pro`. False when h is not that call.
fn lw_rc_stack_str_rewrite(f: & mut IrFunction, h: i64, pro: & mut Vec<i64>) -> bool {
    if h < 0 || h >= f.inst_at.len() {
        return false;
    }
    var pos: i64 = f.inst_at.get(h) - 1;
    if pos < 0 || pos >= f.insts.len() {
        return false;
    }
    // the block the call is in (the operand casts go right before it)
    var hb: i64 = lw_rc_block_of(f, h);
    if hb < 0 {
        return false;
    }
    var e: ValueIdInst = f.insts.get(pos);
    match e.inst {
        Inst::Call(cn, cargs, cty, ceff) => {
            var to_str: bool = cn == "p_to_str" && cargs.len() == 1;
            var to_bool: bool = (cn == "p_bool_to_str" || cn == "p_to_str_bool") && cargs.len() == 1;
            if (cn != "p_str_concat" || cargs.len() != 2) && !to_str && !to_bool {
                return false;
            }
            var words: i64 = LOWER_STACK_STR_BYTES / 8;
            var area: i64 = lw_detached(f, Inst::Alloca(IrType::Array(Box::new(IrType::I64), words), Region::Stack));
            var ai: i64 = lw_detached(f, Inst::BitCast(area, IrType::Ptr(Box::new(IrType::Array(Box::new(IrType::I64), words))), IrType::I64));
            var env: i64 = lw_detached(f, Inst::ConstInt(0, IrType::I64));
            var capv: i64 = lw_detached(f, Inst::ConstInt(LOWER_STACK_STR_BYTES, IrType::I64));
            pro.push(area);
            pro.push(ai);
            pro.push(env);
            pro.push(capv);
            var na: Vec<i64> = Vec::new();
            na.push(env);
            na.push(ai);
            na.push(capv);
            if to_str {
                // LF13 (Nov 21): int_to_str of a local, into the area
                na.push(cargs.get(0));
                e.inst = Inst::Call("Int_to_str_into", na, cty, ceff);
            } else if to_bool {
                // LF13 (Nov 22): bool_to_str of a local, into the area
                na.push(cargs.get(0));
                e.inst = Inst::Call("Bool_to_str_into", na, cty, ceff);
            } else {
                // the operands as the words core takes (as p_str_append's
                // are), cast right before the call
                var ca: i64 = lw_detached(f, Inst::BitCast(cargs.get(0), IrType::Ptr(Box::new(IrType::U8)), IrType::I64));
                var cb: i64 = lw_detached(f, Inst::BitCast(cargs.get(1), IrType::Ptr(Box::new(IrType::U8)), IrType::I64));
                var casts: Vec<i64> = Vec::new();
                casts.push(ca);
                casts.push(cb);
                lw_rc_insert_before(f, hb, h, casts);
                na.push(ca);
                na.push(cb);
                e.inst = Inst::Call("Str_concat_into", na, cty, ceff);
            }
            f.insts.set(pos, e);
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Put instructions `ids` (made with lw_detached) into block index `bi` of
/// `f`, right before instruction `id` (at the block's end when `id` is not
/// in it).
fn lw_rc_insert_before(f: & mut IrFunction, bi: i64, id: i64, ids: Vec<i64>) {
    if bi < 0 || bi >= f.blocks.len() {
        return;
    }
    var blk: BasicBlock = f.blocks.get(bi);
    var fresh: Vec<i64> = Vec::new();
    var done: bool = false;
    var k: i64 = 0;
    while k < blk.instructions.len() {
        var x: i64 = blk.instructions.get(k);
        if !done && x == id {
            var j: i64 = 0;
            while j < ids.len() {
                fresh.push(ids.get(j));
                j = j + 1;
            }
            done = true;
        }
        fresh.push(x);
        k = k + 1;
    }
    if !done {
        var j2: i64 = 0;
        while j2 < ids.len() {
            fresh.push(ids.get(j2));
            j2 = j2 + 1;
        }
    }
    blk.instructions = fresh;
    f.blocks.set(bi, blk);
}

// A Box whose block never leaves its function is made on the stack (OP27):
// Box::new's block of [count word][value] becomes a stack area, and the
// Box's drops drop only what it holds (core's __p_mem_drop; the area is not
// freed). Only a Box of a struct, an enum or a plain value (one holding a
// str, Vec, map or another Box stays on the heap), made outside every loop,
// whose block is at most LOWER_STACK_BOX_MAX bytes.
const LOWER_STACK_BOXES: bool = true;
/// The largest Box block (count word included) made on the stack.
const LOWER_STACK_BOX_MAX: i64 = 1024;

/// The integer constant value `v` is, or `dflt`.
fn lw_rc_const_or(f: & IrFunction, v: i64, dflt: i64) -> i64 {
    match IrFunction_get_inst(f, v) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstInt(c, _) => {
                    return c;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return dflt;
}

/// Whether flag vector `v` is 1 at `x`.
fn lw_rc_in(v: Vec<i64>, x: i64) -> bool {
    return x >= 0 && x < v.len() && v.get(x) == 1;
}

/// The value `v` is a BitCast of, or -1.
fn lw_rc_cast_src(f: & IrFunction, v: i64) -> i64 {
    match IrFunction_get_inst(f, v) {
        OptInst::Some(inst) => {
            match inst {
                Inst::BitCast(x, _, _) => {
                    return x;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return - 1;
}

/// The size of the Box block `blk` makes: `blk = p_malloc(constant)`, or -1.
fn lw_rc_box_size(f: & IrFunction, blk: i64) -> i64 {
    match IrFunction_get_inst(f, blk) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(cn, cargs, _, _) => {
                    if cn == "p_malloc" && cargs.len() == 1 {
                        return lw_rc_const_or(f, cargs.get(0), - 1);
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return - 1;
}

/// Whether a Store of this type copies what its value points to (a struct
/// or an array) instead of storing the value's word.
fn lw_rc_store_copies(sty: OptIrType) -> bool {
    match sty {
        OptIrType::Some(t) => {
            match t {
                IrType::Struct(_) => {
                    return true;
                }
                IrType::Array(_, _) => {
                    return true;
                }
                _ => {
                }
            }
        }
        OptIrType::None => {
        }
    }
    return false;
}

/// Whether a Load of this type may give the address it loads from (an
/// aggregate is reached by address) instead of a word stored there: a Vec
/// or HashMap handle is a word; any other aggregate counts as the address.
fn lw_rc_load_aliases(t: IrType) -> bool {
    match t {
        IrType::Generic(gn, _) => {
            return gn != "Vec" && gn != "HashMap";
        }
        _ => {
        }
    }
    return ir_type_is_aggregate(t);
}

/// The index of the block holding instruction `id`, or -1.
fn lw_rc_block_of(f: & IrFunction, id: i64) -> i64 {
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ins: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ins.len() {
            if ins.get(k) == id {
                return b;
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return - 1;
}

/// Whether block index `bi` of `f` can be reached from itself again (is in
/// a loop). True for a block that is not there.
fn lw_rc_block_in_cycle(f: & IrFunction, bi: i64) -> bool {
    var nb: i64 = f.blocks.len();
    if bi < 0 || bi >= nb {
        return true;
    }
    // block id -> index (they are the same as the lowering makes them)
    var index: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < nb {
        var bid: i64 = f.blocks.get(b).id;
        while bid >= 0 && index.len() <= bid {
            index.push(- 1);
        }
        if bid >= 0 {
            index.set(bid, b);
        }
        b = b + 1;
    }
    var seen: Vec<i64> = Vec::new();
    b = 0;
    while b < nb {
        seen.push(0);
        b = b + 1;
    }
    var work: Vec<i64> = Vec::new();
    work.push(bi);
    while work.len() > 0 {
        var x: i64 = work.pop();
        var ins: Vec<i64> = f.blocks.get(x).instructions;
        var j: i64 = 0;
        while j < ins.len() {
            match IrFunction_get_inst(f, ins.get(j)) {
                OptInst::Some(inst) => {
                    var ts: Vec<i64> = lw_rc_inst_targets(inst);
                    var s: i64 = 0;
                    while s < ts.len() {
                        var t: i64 = ts.get(s);
                        if t >= 0 && t < index.len() && index.get(t) >= 0 {
                            var tb: i64 = index.get(t);
                            if tb == bi {
                                return true;
                            }
                            if seen.get(tb) == 0 {
                                seen.set(tb, 1);
                                work.push(tb);
                            }
                        }
                        s = s + 1;
                    }
                }
                OptInst::None => {
                }
            }
            j = j + 1;
        }
    }
    return false;
}

/// OP27 in one function: true when it changed. A Box block is Box::new's
/// `blk = p_malloc(n)` whose count word gets one owner (the store of
/// P_BOX_RC + 1 through BitCast(BitCast(blk))); the Box is
/// BitCast(BitCast(blk) + 8). It moves to the stack when the Box is not
/// stored as a word anywhere but a stack slot (a quick test first), its
/// block is in no loop (one Box per call: the area is never wanted twice
/// at once), and lw_rc_box_stays finds every use in the frame.
fn lw_rc_stack_boxes_fn(f: & mut IrFunction) -> bool {
    var nv: i64 = f.next_value;
    if nv <= 0 || f.blocks.len() == 0 {
        return false;
    }
    var cast_of: Vec<i64> = Vec::new();
    // x -> a BitCast of x
    var add_of: Vec<i64> = Vec::new();
    // x -> x + 8
    var word_out: Vec<i64> = Vec::new();
    // v -> 1: stored as a word somewhere other than a stack slot
    var is_alloca: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        cast_of.push(- 1);
        add_of.push(- 1);
        word_out.push(0);
        is_alloca.push(0);
        i = i + 1;
    }
    // the count words set to one owner
    var counts: Vec<i64> = Vec::new();
    i = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        if ve.id >= 0 && ve.id < nv {
            match ve.inst {
                Inst::Alloca(_, _) => {
                    is_alloca.set(ve.id, 1);
                }
                Inst::BitCast(x, _, _) => {
                    if x >= 0 && x < nv && cast_of.get(x) == - 1 {
                        cast_of.set(x, ve.id);
                    }
                }
                Inst::BinOp(op, x, y, _) => {
                    if binop_eq(op, BinOp::Add) && x >= 0 && x < nv && add_of.get(x) == - 1 && lw_rc_const_or(f, y, - 1) == 8 {
                        add_of.set(x, ve.id);
                    }
                }
                Inst::Store(p, v, _) => {
                    if lw_rc_const_or(f, v, 0) == 0x464944424F580001 {
                        counts.push(p);
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1;
    }
    if counts.len() == 0 {
        return false;
    }
    i = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Store(sp, sv, sty) => {
                if sv >= 0 && sv < nv && !lw_rc_store_copies(sty) && !lw_rc_in(is_alloca, sp) {
                    word_out.set(sv, 1);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    var changed: bool = false;
    var pro: Vec<i64> = Vec::new();
    var c: i64 = 0;
    while c < counts.len() {
        var blki: i64 = lw_rc_cast_src(f, counts.get(c));
        var blk: i64 = - 1;
        if blki >= 0 {
            blk = lw_rc_cast_src(f, blki);
        }
        var size: i64 = - 1;
        var bv: i64 = - 1;
        if blk >= 0 && blk < nv && cast_of.get(blk) == blki {
            size = lw_rc_box_size(f, blk);
            var bi: i64 = add_of.get(blki);
            if bi >= 0 {
                bv = cast_of.get(bi);
            }
        }
        if bv >= 0 && word_out.get(bv) == 0 && size >= 16 && size <= LOWER_STACK_BOX_MAX && !lw_rc_block_in_cycle(f, lw_rc_block_of(f, blk)) {
            var drops: Vec<i64> = Vec::new();
            if lw_rc_box_stays(f, blk, is_alloca, & mut drops) {
                lw_rc_stack_box_rewrite(f, blk, (size + 7) / 8, drops, & mut pro);
                changed = true;
            }
        }
        c = c + 1;
    }
    if !changed {
        return false;
    }
    // the stack areas, at the start of the entry block
    var blk0: BasicBlock = f.blocks.get(0);
    var fresh: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < pro.len() {
        fresh.push(pro.get(k));
        k = k + 1;
    }
    k = 0;
    while k < blk0.instructions.len() {
        fresh.push(blk0.instructions.get(k));
        k = k + 1;
    }
    blk0.instructions = fresh;
    f.blocks.set(0, blk0);
    return true;
}

/// OP27: whether the Box block `blk` stays in its frame. What points into
/// it: blk, its casts, constant offsets, field and element addresses,
/// loads from the stack slots it is kept in, and aggregate loads through
/// it. Each of those may only be a load or store address, the source of a
/// copy, kept in a stack slot that only loads it and stores it or a
/// literal, or argument 1 of Box_drop_t with the constant type of a value
/// held inline. `drops` gets the positions (in f.insts) of those drops.
fn lw_rc_box_stays(f: & IrFunction, blk: i64, is_alloca: Vec<i64>, drops: & mut Vec<i64>) -> bool {
    var nv: i64 = f.next_value;
    var in_a: Vec<i64> = Vec::new();
    var aslot: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        in_a.push(0);
        aslot.push(0);
        i = i + 1;
    }
    in_a.set(blk, 1);
    // what points into the block, to a fixpoint
    var grew: bool = true;
    var rounds: i64 = 0;
    while grew && rounds < 64 {
        grew = false;
        i = 0;
        while i < f.insts.len() {
            var ve: ValueIdInst = f.insts.get(i);
            var id: i64 = ve.id;
            if id >= 0 && id < nv && in_a.get(id) == 0 {
                var adds: bool = false;
                match ve.inst {
                    Inst::BitCast(x, _, _) => {
                        adds = lw_rc_in(in_a, x);
                    }
                    Inst::GetFieldPtr(x, _, _) => {
                        adds = lw_rc_in(in_a, x);
                    }
                    Inst::GetElemPtr(x, _, _) => {
                        adds = lw_rc_in(in_a, x);
                    }
                    Inst::BinOp(op, x, y, _) => {
                        if binop_eq(op, BinOp::Add) {
                            adds = (lw_rc_in(in_a, x) && lw_rc_const_or(f, y, - 1) >= 0) || (lw_rc_in(in_a, y) && lw_rc_const_or(f, x, - 1) >= 0);
                        }
                    }
                    Inst::Load(lp, lty) => {
                        adds = lw_rc_in(aslot, lp) || (lw_rc_in(in_a, lp) && lw_rc_load_aliases(lty));
                    }
                    _ => {
                    }
                }
                if adds {
                    in_a.set(id, 1);
                    grew = true;
                }
            }
            // a stack slot it is kept in
            match ve.inst {
                Inst::Store(sp, sv, sty) => {
                    if lw_rc_in(in_a, sv) && lw_rc_in(is_alloca, sp) && !lw_rc_in(aslot, sp) && !lw_rc_in(in_a, sp) && !lw_rc_store_copies(sty) {
                        aslot.set(sp, 1);
                        grew = true;
                    }
                }
                _ => {
                }
            }
            i = i + 1;
        }
        rounds = rounds + 1;
    }
    if grew {
        return false;
    }
    // every use
    i = 0;
    while i < f.insts.len() {
        var ue: ValueIdInst = f.insts.get(i);
        var refs: Vec<i64> = inst_value_refs(& ue.inst);
        var r: i64 = 0;
        while r < refs.len() {
            var u: i64 = refs.get(r);
            if lw_rc_in(in_a, u) && !lw_rc_box_use_ok(f, ue.inst, u, aslot) {
                return false;
            }
            if lw_rc_in(aslot, u) {
                var fine_s: bool = false;
                match ue.inst {
                    Inst::Load(lsp, _) => {
                        fine_s = lsp == u;
                    }
                    Inst::Store(ssp, ssv, _) => {
                        fine_s = ssp == u && ssv != u && (lw_rc_in(in_a, ssv) || lw_rc_is_literal_value(f, ssv));
                    }
                    _ => {
                    }
                }
                if !fine_s {
                    return false;
                }
            }
            r = r + 1;
        }
        match ue.inst {
            Inst::Call(cn, cargs, _, _) => {
                if cn == "Box_drop_t" && cargs.len() == 3 && lw_rc_in(in_a, cargs.get(1)) {
                    drops.push(i);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return true;
}

/// OP27: whether instruction `inst` uses `u`, a value pointing into a Box
/// block, in a way that keeps the block in its frame (lw_rc_box_stays).
fn lw_rc_box_use_ok(f: & IrFunction, inst: Inst, u: i64, aslot: Vec<i64>) -> bool {
    match inst {
        Inst::BitCast(x, _, _) => {
            return x == u;
        }
        Inst::GetFieldPtr(x, _, _) => {
            return x == u;
        }
        Inst::GetElemPtr(x, ix, _) => {
            return x == u && ix != u;
        }
        Inst::BinOp(op, x, y, _) => {
            if !binop_eq(op, BinOp::Add) {
                return false;
            }
            return (x == u && y != u && lw_rc_const_or(f, y, - 1) >= 0) || (y == u && x != u && lw_rc_const_or(f, x, - 1) >= 0);
        }
        Inst::Load(lp, _) => {
            return lp == u;
        }
        Inst::Store(sp, sv, sty) => {
            if sv != u {
                // the address stored to
                return sp == u;
            }
            // its word stored: a copy of what it points to, or kept in a
            // stack slot of its own
            if lw_rc_store_copies(sty) {
                return true;
            }
            return sp != u && lw_rc_in(aslot, sp);
        }
        Inst::StructCopy(_, _, _) => {
            return true;
        }
        Inst::Call(cn, cargs, _, _) => {
            if cn != "Box_drop_t" || cargs.len() != 3 || cargs.get(1) != u || cargs.get(0) == u || cargs.get(2) == u {
                return false;
            }
            // what Box_drop_t drops in place (core: anything but a str,
            // Vec or map handle or a Box, which it loads from the block)
            var tid: i64 = lw_rc_const_or(f, cargs.get(2), - 1);
            return tid == 0 || (tid >= 4 && tid < 0x8000);
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// OP27: Box block `blk` on a stack area of `words` words made in `pro`
/// (blk becomes the area's address), and its drops (positions in f.insts)
/// into __p_mem_drop(type, Box), which drops what the Box holds in place.
fn lw_rc_stack_box_rewrite(f: & mut IrFunction, blk: i64, words: i64, drops: Vec<i64>, pro: & mut Vec<i64>) {
    var area: i64 = lw_detached(f, Inst::Alloca(IrType::Array(Box::new(IrType::I64), words), Region::Stack));
    var ai: i64 = lw_detached(f, Inst::BitCast(area, IrType::Ptr(Box::new(IrType::Array(Box::new(IrType::I64), words))), IrType::I64));
    pro.push(area);
    pro.push(ai);
    if blk >= 0 && blk < f.inst_at.len() {
        var pos: i64 = f.inst_at.get(blk) - 1;
        if pos >= 0 && pos < f.insts.len() {
            var e: ValueIdInst = f.insts.get(pos);
            e.inst = Inst::BitCast(ai, IrType::I64, lw_ptr_u8());
            f.insts.set(pos, e);
        }
    }
    var k: i64 = 0;
    while k < drops.len() {
        var q: i64 = drops.get(k);
        if q >= 0 && q < f.insts.len() {
            var de: ValueIdInst = f.insts.get(q);
            match de.inst {
                Inst::Call(dn, dargs, dty, deff) => {
                    if dn == "Box_drop_t" && dargs.len() == 3 {
                        var na: Vec<i64> = Vec::new();
                        na.push(dargs.get(0));
                        na.push(dargs.get(2));
                        na.push(dargs.get(1));
                        de.inst = Inst::Call("__p_mem_drop", na, dty, deff);
                        f.insts.set(q, de);
                    }
                }
                _ => {
                }
            }
        }
        k = k + 1;
    }
}

// Share temporaries only read before their drop are not made (LF15).
const LOWER_CANCEL_SHARES: bool = true;  // String slots that only ever hold literals are not counted (LF17).
const LOWER_LITERAL_SLOTS: bool = true;  /// Calls that only read the Vec or map handle they get as argument 1.
fn lw_rc_read_only_call(name: str) -> bool {
    return name == "Vec_len" || name == "Vec_get" || name == "Vec_is_empty" || name == "Vec_contains" || name == "Vec_first" || name == "Vec_last" || name == "Vec_to_str" || name == "Vec_capacity" || name == "p_vec_len" || name == "p_vec_get" || name == "vec_get_or" || name == "HashMap_get" || name == "HashMap_get_i" || name == "HashMap_get_or" || name == "HashMap_get_or_i" || name == "HashMap_contains" || name == "HashMap_contains_i" || name == "HashMap_len" || name == "HashMap_is_empty" || name == "HashMap_to_str";
}

/// `x = Vec_share(v)` (or HashMap_share) at ins[i]: when, in this block,
/// every use of x up to `Vec_drop(x)` is argument 1 of a read-only call, and
/// nothing in between is any other call (which could change v), those reads
/// take v, and the share and the drop are marked dead. True when done.
fn lw_rc_cancel_share(f: & mut IrFunction, ins: Vec<i64>, i: i64, dead: & mut Vec<i64>, uses: & mut Vec<i64>) -> bool {
    var sid: i64 = ins.get(i);
    var v: i64 = - 1;
    var drop_name: str = "";
    // CS4: instructions read in place (lw_inst_pos)
    var sat: i64 = lw_inst_pos(f, sid);
    if sat < 0 {
        return false;
    }
    match f.insts.get(sat).inst {
        Inst::Call(n, args, _, _) => {
            if (n == "Vec_share" || n == "HashMap_share") && args.len() == 2 {
                v = args.get(1);
                if n == "Vec_share" {
                    drop_name = "Vec_drop";
                } else {
                    drop_name = "HashMap_drop";
                }
            }
        }
        _ => {
        }
    }
    if v < 0 {
        return false;
    }
    var reads: Vec<i64> = Vec::new();
    var drop_at: i64 = - 1;
    var j: i64 = i + 1;
    while j < ins.len() && drop_at < 0 {
        var jid: i64 = ins.get(j);
        var uses_x: bool = false;
        var other_call: bool = false;
        var is_drop: bool = false;
        var is_read: bool = false;
        var jat: i64 = lw_inst_pos(f, jid);
        if jat < 0 {
            other_call = true;
        } else {
            match f.insts.get(jat).inst {
                Inst::Call(cn, cargs, _, _) => {
                    var k: i64 = 0;
                    var at1: bool = false;
                    var elsewhere: bool = false;
                    while k < cargs.len() {
                        if cargs.get(k) == sid {
                            uses_x = true;
                            if k == 1 {
                                at1 = true;
                            } else {
                                elsewhere = true;
                            }
                        }
                        k = k + 1;
                    }
                    if uses_x && !elsewhere && at1 && cn == drop_name && cargs.len() == 2 {
                        is_drop = true;
                    } else if uses_x && !elsewhere && at1 && lw_rc_read_only_call(cn) {
                        is_read = true;
                    } else if !lw_rc_read_only_call(cn) && cn != "Str_dup" && cn != "Str_drop" {
                        other_call = true;
                    } else if uses_x {
                        other_call = true;
                    }
                }
                _ => {
                    var refs: Vec<i64> = inst_value_refs(& f.insts.get(jat).inst);
                    var r: i64 = 0;
                    while r < refs.len() {
                        if refs.get(r) == sid {
                            uses_x = true;
                        }
                        r = r + 1;
                    }
                    if inst_is_terminator(f.insts.get(jat).inst) {
                        other_call = true;
                    }
                }
            }
        }
        if is_drop {
            drop_at = j;
        } else if is_read {
            reads.push(jid);
        } else if uses_x || other_call {
            return false;
        }
        j = j + 1;
    }
    if drop_at < 0 {
        return false;
    }
    // x used nowhere else (another block, after the drop). SP12: from the
    // function's use counts (lw_rc_use_counts), not a scan per candidate
    if lw_rc_count_in(uses, f, sid) != reads.len() + 1 {
        return false;
    }
    var q: i64 = 0;
    while q < reads.len() {
        lw_rc_rewrite_arg(f, uses, reads.get(q), sid, v);
        q = q + 1;
    }
    dead.push(sid);
    dead.push(ins.get(drop_at));
    return true;
}

/// SP12: how many operands of each of `f`'s instructions are value v, for
/// every v below f.next_value: what lw_rc_use_count / lw_rc_value_used
/// find, counted in one pass. The cancel passes asked those per candidate,
/// each a scan of the whole function (quadratic in a long function). A
/// table stays exact only while every change to f.insts goes through
/// lw_rc_rewrite_arg, which keeps it up to date.
fn lw_rc_use_counts(f: & IrFunction) -> Vec<i64> {
    var nv: i64 = f.next_value;
    var uses: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        uses.push(0);
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var refs: Vec<i64> = inst_value_refs(& f.insts.get(i).inst);
        var j: i64 = 0;
        while j < refs.len() {
            var rv: i64 = refs.get(j);
            if rv >= 0 && rv < nv {
                uses.set(rv, uses.get(rv) + 1);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return uses;
}

/// SP12: lw_rc_use_count(f, v) from the table `uses` (lw_rc_use_counts); a
/// value outside it is counted by the scan.
fn lw_rc_count_in(uses: & Vec<i64>, f: & IrFunction, v: i64) -> i64 {
    if v >= 0 && v < uses.len() {
        return uses.get(v);
    }
    return lw_rc_use_count(f, v);
}

/// SP12: lw_rc_value_used(f, v) from the table `uses`.
fn lw_rc_used_in(uses: & Vec<i64>, f: & IrFunction, v: i64) -> bool {
    if v >= 0 && v < uses.len() {
        return uses.get(v) > 0;
    }
    return lw_rc_value_used(f, v);
}

/// How many operands of `f`'s instructions are value `v`.
fn lw_rc_use_count(f: & IrFunction, v: i64) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < f.insts.len() {
        var refs: Vec<i64> = inst_value_refs(& f.insts.get(i).inst);
        var j: i64 = 0;
        while j < refs.len() {
            if refs.get(j) == v {
                n = n + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return n;
}

/// In call `id`, argument `from` becomes `to`; `uses` (lw_rc_use_counts)
/// follows the change.
fn lw_rc_rewrite_arg(f: & mut IrFunction, uses: & mut Vec<i64>, id: i64, from: i64, to: i64) {
    if id < 0 || id >= f.inst_at.len() {
        return;
    }
    var pos: i64 = f.inst_at.get(id) - 1;
    if pos < 0 || pos >= f.insts.len() {
        return;
    }
    var e: ValueIdInst = f.insts.get(pos);
    match e.inst {
        Inst::Call(cn, cargs, cty, ceff) => {
            var na: Vec<i64> = Vec::new();
            var k: i64 = 0;
            while k < cargs.len() {
                if cargs.get(k) == from {
                    na.push(to);
                    if from != to {
                        if from >= 0 && from < uses.len() {
                            uses.set(from, uses.get(from) - 1);
                        }
                        if to >= 0 && to < uses.len() {
                            uses.set(to, uses.get(to) + 1);
                        }
                    }
                } else {
                    na.push(cargs.get(k));
                }
                k = k + 1;
            }
            e.inst = Inst::Call(cn, na, cty, ceff);
            f.insts.set(pos, e);
        }
        _ => {
        }
    }
}

/// LF17: string slots whose every store is a literal or zero (and that are
/// only loaded and stored) hold nothing counted: the Str_dup / Str_drop of a
/// value loaded from one is marked dead.
fn lw_rc_literal_slot_counts(f: & IrFunction, dead: & mut Vec<i64>) {
    var nv: i64 = f.next_value;
    if nv <= 0 {
        return;
    }
    var lit: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        lit.push(0);
        i = i + 1;
    }
    // candidates: allocas (CS4: each instruction read in place, not copied)
    i = 0;
    while i < f.insts.len() {
        var ve_id: i64 = f.insts.get(i).id;
        match f.insts.get(i).inst {
            Inst::Alloca(_, _) => {
                if ve_id >= 0 && ve_id < nv {
                    lit.set(ve_id, 1);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    var loaded_from: Vec<i64> = Vec::new();
    // SP12: each value's operand count, gathered in this pass (f does not
    // change here): lw_rc_value_used per candidate scanned the function
    var used: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        loaded_from.push(- 1);
        used.push(0);
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var ve2_id: i64 = f.insts.get(i).id;
        var refs: Vec<i64> = inst_value_refs(& f.insts.get(i).inst);
        var ur: i64 = 0;
        while ur < refs.len() {
            var urv: i64 = refs.get(ur);
            if urv >= 0 && urv < nv {
                used.set(urv, used.get(urv) + 1);
            }
            ur = ur + 1;
        }
        match f.insts.get(i).inst {
            Inst::Load(lp, _) => {
                if ve2_id >= 0 && ve2_id < nv && lp >= 0 && lp < nv {
                    loaded_from.set(ve2_id, lp);
                }
            }
            Inst::Store(sp, sv, _) => {
                if sp >= 0 && sp < nv && lit.get(sp) == 1 {
                    if !lw_rc_is_literal_value(f, sv) {
                        lit.set(sp, 0);
                    }
                }
                // the slot as a stored value: its address escapes
                if sv >= 0 && sv < nv {
                    lit.set(sv, 0);
                }
            }
            _ => {
                var r: i64 = 0;
                while r < refs.len() {
                    var rv: i64 = refs.get(r);
                    if rv >= 0 && rv < nv {
                        lit.set(rv, 0);
                    }
                    r = r + 1;
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var ve3_id: i64 = f.insts.get(i).id;
        var a1: i64 = lw_rc_str_count_arg(f, ve3_id, "Str_dup");
        var a2: i64 = lw_rc_str_count_arg(f, ve3_id, "Str_drop");
        var a: i64 = a1;
        if a < 0 {
            a = a2;
        }
        if a >= 0 && a < nv {
            var sl: i64 = loaded_from.get(a);
            if sl >= 0 && lit.get(sl) == 1 {
                if a2 >= 0 || !lw_rc_used_in(& used, f, ve3_id) {
                    dead.push(ve3_id);
                }
            }
        }
        i = i + 1;
    }
}

// LF17: a Vec or map dropped while provably empty (made by Vec_new* /
// HashMap_new*, nothing having seen it since) is neither made nor dropped.
const LOWER_EMPTY_DROPS: bool = true;

/// Instruction `id` makes an empty Vec or map (core's creators, env first).
fn lw_rc_empty_new(f: & IrFunction, id: i64) -> bool {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(n, _, _, _) => {
                    return n == "Vec_new" || n == "Vec_new_typed" || n == "Vec_new_sized" || n == "Vec_init_typed" || n == "HashMap_new" || n == "HashMap_new_typed";
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return false;
}

/// The Vec or map instruction `id` drops (a call of core's Vec_drop*,
/// HashMap_drop, env first), else -1.
fn lw_rc_empty_drop_arg(f: & IrFunction, id: i64) -> i64 {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(n, args, _, _) => {
                    if (n == "Vec_drop" || n == "Vec_drop_inplace" || n == "Vec_drop_strs" || n == "Vec_drop_vecs" || n == "HashMap_drop") && args.len() == 2 {
                        return args.get(1);
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return - 1;
}

/// Whether instruction `id` refers to value `v`.
fn lw_rc_inst_refs(f: & IrFunction, id: i64, v: i64) -> bool {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            var refs: Vec<i64> = inst_value_refs(& inst);
            var r: i64 = 0;
            while r < refs.len() {
                if refs.get(r) == v {
                    return true;
                }
                r = r + 1;
            }
        }
        OptInst::None => {
        }
    }
    return false;
}

/// The value instruction `id` stores into slot `s` (Store(s, x), x != s),
/// else -1.
fn lw_rc_store_into(f: & IrFunction, id: i64, s: i64) -> i64 {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Store(sp, sv, _) => {
                    if sp == s && sv != s {
                        return sv;
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return - 1;
}

/// LF17: drops of Vecs and maps known to be empty. `x = Vec_new..(); drop(x)`
/// with x used by nothing else, and, in one block, `Store(S, x = Vec_new..)
/// .. L = Load(S) .. Store(S, y) .. drop(L)` where S is a slot only loaded
/// and stored, nothing refers to S between the first store and L or between
/// L and the next store, and x and L have no other use: the creation, its
/// store, the load and the drop are marked dead (the slot's contents after
/// the block are those the next store gives it, as before). The creation
/// becomes a zero in `f.insts` so that later passes (stack Vecs) skip it.
fn lw_rc_empty_drops(f: & mut IrFunction, dead: & mut Vec<i64>) {
    var nv: i64 = f.next_value;
    if nv <= 0 {
        return;
    }
    var uses: Vec<i64> = Vec::new();
    var plain: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nv {
        uses.push(0);
        plain.push(0);
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        match ve.inst {
            Inst::Alloca(_, _) => {
                if ve.id >= 0 && ve.id < nv {
                    plain.set(ve.id, 1);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var ue: ValueIdInst = f.insts.get(i);
        var refs: Vec<i64> = inst_value_refs(& ue.inst);
        var r: i64 = 0;
        while r < refs.len() {
            var u: i64 = refs.get(r);
            if u >= 0 && u < nv {
                uses.set(u, uses.get(u) + 1);
                var fine: bool = false;
                match ue.inst {
                    Inst::Load(lp, _) => {
                        fine = lp == u;
                    }
                    Inst::Store(sp, sv, _) => {
                        fine = sp == u && sv != u;
                    }
                    _ => {
                    }
                }
                if !fine {
                    plain.set(u, 0);
                }
            }
            r = r + 1;
        }
        i = i + 1;
    }
    var made: Vec<i64> = Vec::new();
    // SP12: per block, on its first candidate, where each plain slot is
    // referred to (lw_rc_empty_block_refs): the searches below scanned the
    // block from L once per candidate, quadratic in a long block (a
    // function's end drops every variable's slot)
    var lastp: Vec<i64> = Vec::new();
    var bpos: Vec<i64> = Vec::new();
    i = 0;
    while i < nv {
        lastp.push(- 1);
        bpos.push(0);
        i = i + 1;
    }
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ins: Vec<i64> = f.blocks.get(b).instructions;
        var built: bool = false;
        var prevr: Vec<i64> = Vec::new();
        var nextr: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < ins.len() {
            var d: i64 = ins.get(k);
            var a: i64 = lw_rc_empty_drop_arg(f, d);
            if a >= 0 && a < nv && uses.get(a) == 1 {
                if lw_rc_empty_new(f, a) {
                    dead.push(a);
                    dead.push(d);
                    made.push(a);
                } else {
                    var s: i64 = - 1;
                    match IrFunction_get_inst(f, a) {
                        OptInst::Some(ainst) => {
                            match ainst {
                                Inst::Load(lp, _) => {
                                    s = lp;
                                }
                                _ => {
                                }
                            }
                        }
                        OptInst::None => {
                        }
                    }
                    if s >= 0 && s < nv && plain.get(s) == 1 && !built {
                        lw_rc_empty_block_refs(f, ins, plain, & mut lastp, & mut bpos, & mut prevr, & mut nextr);
                        built = true;
                    }
                    // L's position in the block: the last q < k holding a
                    // (bpos: 1 + its one position, -1 when it is there twice)
                    var j: i64 = - 1;
                    if s >= 0 && s < nv && plain.get(s) == 1 {
                        var bp: i64 = bpos.get(a);
                        if bp > 0 {
                            if bp - 1 < k {
                                j = bp - 1;
                            }
                        } else if bp < 0 {
                            var q: i64 = k - 1;
                            while q >= 0 && j < 0 {
                                if ins.get(q) == a {
                                    j = q;
                                }
                                q = q - 1;
                            }
                        }
                    }
                    // after L: the next reference to S is a store into it
                    // (L is Load(S): nextr[j] is the next position that
                    // refers to S)
                    var rewritten: bool = false;
                    if j >= 0 {
                        var m: i64 = nextr.get(j);
                        if m >= 0 {
                            rewritten = lw_rc_store_into(f, ins.get(m), s) >= 0;
                        }
                    }
                    // before L: the last reference to S stores a fresh empty one
                    if rewritten {
                        var p: i64 = prevr.get(j);
                        if p >= 0 {
                            var x: i64 = lw_rc_store_into(f, ins.get(p), s);
                            if x >= 0 && x < nv && uses.get(x) == 1 && lw_rc_empty_new(f, x) {
                                dead.push(x);
                                dead.push(ins.get(p));
                                dead.push(a);
                                dead.push(d);
                                made.push(x);
                            }
                        }
                    }
                }
            }
            k = k + 1;
        }
        // the per-value tables back to empty for the next block
        if built {
            var z: i64 = 0;
            while z < ins.len() {
                var zid: i64 = ins.get(z);
                if zid >= 0 && zid < nv {
                    bpos.set(zid, 0);
                }
                z = z + 1;
            }
        }
        b = b + 1;
    }
    var mi: i64 = 0;
    while mi < made.len() {
        var h: i64 = made.get(mi);
        if h < f.inst_at.len() {
            var pos: i64 = f.inst_at.get(h) - 1;
            if pos >= 0 && pos < f.insts.len() {
                var e: ValueIdInst = f.insts.get(pos);
                e.inst = Inst::ConstInt(0, IrType::I64);
                f.insts.set(pos, e);
            }
        }
        mi = mi + 1;
    }
}

/// SP12: for one block's instructions `ins` (lw_rc_empty_drops): bpos[id]
/// = 1 + the position of instruction id in the block (-1 when it is there
/// more than once); for each position k holding a Load of a plain slot S
/// (plain[S] == 1), prevr[k] / nextr[k] = the last position before / the
/// first after k whose instruction refers to S (lw_rc_inst_refs), or -1.
/// `lastp` (one entry per value, all -1) is left all -1 again; the caller
/// clears bpos for the block's ids after it.
fn lw_rc_empty_block_refs(f: & IrFunction, ins: Vec<i64>, plain: Vec<i64>, lastp: & mut Vec<i64>, bpos: & mut Vec<i64>, prevr: & mut Vec<i64>, nextr: & mut Vec<i64>) {
    var nv: i64 = plain.len();
    var n: i64 = ins.len();
    var k: i64 = 0;
    while k < n {
        prevr.push(- 1);
        nextr.push(- 1);
        k = k + 1;
    }
    var touched: Vec<i64> = Vec::new();
    // forward: positions, and the last earlier reference of each load's slot
    k = 0;
    while k < n {
        var id: i64 = ins.get(k);
        if id >= 0 && id < bpos.len() {
            if bpos.get(id) == 0 {
                bpos.set(id, k + 1);
            } else {
                bpos.set(id, - 1);
            }
        }
        var at: i64 = lw_inst_pos(f, id);
        if at >= 0 {
            match f.insts.get(at).inst {
                Inst::Load(lp, _) => {
                    if lp >= 0 && lp < nv && plain.get(lp) == 1 {
                        prevr.set(k, lastp.get(lp));
                    }
                }
                _ => {
                }
            }
            var refs: Vec<i64> = inst_value_refs(& f.insts.get(at).inst);
            var r: i64 = 0;
            while r < refs.len() {
                var u: i64 = refs.get(r);
                if u >= 0 && u < nv && plain.get(u) == 1 {
                    if lastp.get(u) < 0 {
                        touched.push(u);
                    }
                    lastp.set(u, k);
                }
                r = r + 1;
            }
        }
        k = k + 1;
    }
    var t: i64 = 0;
    while t < touched.len() {
        lastp.set(touched.get(t), - 1);
        t = t + 1;
    }
    // backward: the first later reference of each load's slot
    k = n - 1;
    while k >= 0 {
        var at2: i64 = lw_inst_pos(f, ins.get(k));
        if at2 >= 0 {
            match f.insts.get(at2).inst {
                Inst::Load(lp2, _) => {
                    if lp2 >= 0 && lp2 < nv && plain.get(lp2) == 1 {
                        nextr.set(k, lastp.get(lp2));
                    }
                }
                _ => {
                }
            }
            var refs2: Vec<i64> = inst_value_refs(& f.insts.get(at2).inst);
            var r2: i64 = 0;
            while r2 < refs2.len() {
                var u2: i64 = refs2.get(r2);
                if u2 >= 0 && u2 < nv && plain.get(u2) == 1 {
                    lastp.set(u2, k);
                }
                r2 = r2 + 1;
            }
        }
        k = k - 1;
    }
    t = 0;
    while t < touched.len() {
        lastp.set(touched.get(t), - 1);
        t = t + 1;
    }
}

/// A literal string, a null, a zero, or a cast of one of them.
fn lw_rc_is_literal_value(f: & IrFunction, v: i64) -> bool {
    var at: i64 = lw_inst_pos(f, v);
    if at < 0 {
        return false;
    }
    match f.insts.get(at).inst {
        Inst::ConstStr(_) => {
            return true;
        }
        Inst::ConstNull(_) => {
            return true;
        }
        Inst::ConstInt(c, _) => {
            return c == 0;
        }
        Inst::BitCast(x, _, _) => {
            return lw_rc_is_literal_value(f, x);
        }
        _ => {
        }
    }
    return false;
}

/// A string counted again and dropped in the same block with nothing in
/// between that could free or keep it (no call, store or terminator), and
/// the count's result unused: neither is needed (proposal 0004).
fn lw_rc_cancel_pairs(module: & mut IrModule) {
    // LF15 diamonds; FID_RC_SLOTS_OFF=1 keeps such copies counted (to compare)
    var ps_on: bool = LOWER_CANCEL_PARAM_SLOTS && !lw_ps_env_off();
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var fentry: IrFunctionEntry = module.functions.get(fi);
        var f: IrFunction = fentry.func;
        var changed: bool = false;
        var lit_dead: Vec<i64> = Vec::new();
        if LOWER_LITERAL_SLOTS {
            lw_rc_literal_slot_counts(& f, & mut lit_dead);
        }
        if LOWER_EMPTY_DROPS {
            lw_rc_empty_drops(& mut f, & mut lit_dead);
        }
        // LF15 across blocks: a block that ends in a jump to a block only
        // it reaches runs straight on into it, so a pair is looked for in
        // the block and the chain of such blocks after it (the jumps left
        // out: they free nothing). What goes is removed from every block.
        var chain: Vec<i64> = Vec::new();
        if LOWER_CANCEL_ACROSS {
            chain = lw_rc_chain_next(& f);
        }
        var dead: Vec<i64> = Vec::new();
        var ld: i64 = 0;
        while ld < lit_dead.len() {
            dead.push(lit_dead.get(ld));
            ld = ld + 1;
        }
        // LF15 diamonds: a copy of a parameter that is only read is not
        // counted, its drops on any paths (lw_rc_cancel_param_slots)
        if ps_on && !lw_rg_has_region(& f) {
            lw_rc_cancel_param_slots(& mut f, module, & mut dead);
        }
        // SP12: every value's use count, once; below, f.insts changes only
        // through lw_rc_rewrite_arg, which keeps the counts
        var uses: Vec<i64> = lw_rc_use_counts(& f);
        var b: i64 = 0;
        while b < f.blocks.len() {
            var blk: BasicBlock = f.blocks.get(b);
            var own_n: i64 = blk.instructions.len();
            var ins: Vec<i64> = blk.instructions;
            if LOWER_CANCEL_ACROSS && chain.get(b) >= 0 {
                ins = lw_rc_chain_insts(& f, chain, b);
                own_n = blk.instructions.len() - 1;
            }
            var i: i64 = 0;
            while i < own_n {
                // A string or a Box counted again, then dropped (LF15): both
                // calls give back / take the same pointer
                var pk: i64 = 0;
                while pk < 2 {
                    var dup_name: str = "Str_dup";
                    var drop_name: str = "Str_drop";
                    if pk == 1 {
                        dup_name = "Box_dup_t";
                        drop_name = "Box_drop_t";
                    }
                    var a: i64 = lw_rc_str_count_arg(& f, ins.get(i), dup_name);
                    if a >= 0 {
                        var j: i64 = i + 1;
                        var stop: bool = false;
                        while j < ins.len() && !stop {
                            var d: i64 = lw_rc_str_count_arg(& f, ins.get(j), drop_name);
                            if d == a {
                                if !lw_rc_used_in(& uses, & f, ins.get(i)) {
                                    dead.push(ins.get(i));
                                    dead.push(ins.get(j));
                                }
                                stop = true;
                            } else if lw_rc_may_free(& f, ins.get(j)) {
                                stop = true;
                            }
                            j = j + 1;
                        }
                    }
                    pk = pk + 1;
                }
                // A Vec or map shared for a temporary that is only read, then
                // dropped in the same block (LF15): the reads use the
                // original, the share and its drop go
                if LOWER_CANCEL_SHARES && lw_rc_cancel_share(& mut f, ins, i, & mut dead, & mut uses) {
                    changed = true;
                }
                i = i + 1;
            }
            b = b + 1;
        }
        if dead.len() > 0 {
            // one mark per value id: a function's dead list can be long
            var nmark: i64 = f.inst_at.len();
            var mark: Vec<bool> = Vec::new();
            var mz: i64 = 0;
            while mz < nmark {
                mark.push(false);
                mz = mz + 1;
            }
            var di: i64 = 0;
            while di < dead.len() {
                var dv: i64 = dead.get(di);
                if dv >= 0 && dv < nmark {
                    mark.set(dv, true);
                }
                di = di + 1;
            }
            var rb: i64 = 0;
            while rb < f.blocks.len() {
                var rblk: BasicBlock = f.blocks.get(rb);
                var rins: Vec<i64> = rblk.instructions;
                var kept: Vec<i64> = Vec::new();
                var any: bool = false;
                var k: i64 = 0;
                while k < rins.len() {
                    var kv: i64 = rins.get(k);
                    var gone: bool = false;
                    if kv >= 0 && kv < nmark {
                        gone = mark.get(kv);
                    } else {
                        gone = lw_c_vec_i64_has(dead, kv);
                    }
                    if gone {
                        any = true;
                    } else {
                        kept.push(kv);
                    }
                    k = k + 1;
                }
                if any {
                    rblk.instructions = kept;
                    f.blocks.set(rb, rblk);
                    changed = true;
                }
                rb = rb + 1;
            }
        }
        if changed {
            module.functions.set(fi, IrFunctionEntry_new(fentry.name, f));
        }
        fi = fi + 1;
    }
}

fn lw_c_vec_i64_has(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// LF15 across blocks (lw_rc_cancel_pairs): pairs looked for over a chain
/// of blocks joined by plain jumps. false: in one block only.
const LOWER_CANCEL_ACROSS: bool = true;
/// How many blocks after the first a chain takes in at most.
const LW_CHAIN_MAX: i64 = 4;

/// The block index of the instruction's jump targets (Jump, Branch,
/// Switch, TryUnwrap), each once per mention.
fn lw_rc_inst_targets(inst: Inst) -> Vec<i64> {
    var t: Vec<i64> = Vec::new();
    match inst {
        Inst::Jump(a) => {
            t.push(a);
        }
        Inst::Branch(_, a, b) => {
            t.push(a);
            t.push(b);
        }
        Inst::Switch(_, _, targets, d) => {
            var i: i64 = 0;
            while i < targets.len() {
                t.push(targets.get(i));
                i = i + 1;
            }
            t.push(d);
        }
        Inst::TryUnwrap(_, _, eb, ob) => {
            t.push(eb);
            t.push(ob);
        }
        _ => {
        }
    }
    return t;
}

/// For each block (by index): the index of the block it runs straight on
/// into, else -1. Block b qualifies when its last instruction is `Jump(t)`,
/// t is not the entry block nor b, t has no parameters, and nothing else
/// in the function names t as a target.
fn lw_rc_chain_next(f: & IrFunction) -> Vec<i64> {
    var nb: i64 = f.blocks.len();
    var maxid: i64 = 0;
    var b: i64 = 0;
    while b < nb {
        if f.blocks.get(b).id > maxid {
            maxid = f.blocks.get(b).id;
        }
        b = b + 1;
    }
    // block id -> index, and how often each id is a target
    var at: Vec<i64> = Vec::new();
    var preds: Vec<i64> = Vec::new();
    var z: i64 = 0;
    while z <= maxid {
        at.push(- 1);
        preds.push(0);
        z = z + 1;
    }
    b = 0;
    while b < nb {
        var bid: i64 = f.blocks.get(b).id;
        if bid >= 0 {
            at.set(bid, b);
        }
        b = b + 1;
    }
    b = 0;
    while b < nb {
        var ins: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ins.len() {
            match IrFunction_get_inst(f, ins.get(k)) {
                OptInst::Some(inst) => {
                    var ts: Vec<i64> = lw_rc_inst_targets(inst);
                    var q: i64 = 0;
                    while q < ts.len() {
                        var tid: i64 = ts.get(q);
                        if tid >= 0 && tid <= maxid {
                            preds.set(tid, preds.get(tid) + 1);
                        }
                        q = q + 1;
                    }
                }
                OptInst::None => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var next: Vec<i64> = Vec::new();
    b = 0;
    while b < nb {
        var n: i64 = - 1;
        var blk: BasicBlock = f.blocks.get(b);
        if blk.instructions.len() > 0 {
            match IrFunction_get_inst(f, blk.instructions.get(blk.instructions.len() - 1)) {
                OptInst::Some(last) => {
                    match last {
                        Inst::Jump(tid) => {
                            if tid >= 0 && tid <= maxid && preds.get(tid) == 1 {
                                var ti: i64 = at.get(tid);
                                if ti > 0 && ti != b && f.blocks.get(ti).params.len() == 0 {
                                    n = ti;
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptInst::None => {
                }
            }
        }
        next.push(n);
        b = b + 1;
    }
    return next;
}

/// The instructions block b runs, in order, through its chain (at most
/// LW_CHAIN_MAX more blocks): each chained block's closing jump left out.
fn lw_rc_chain_insts(f: & IrFunction, next: Vec<i64>, b: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var cur: i64 = b;
    var steps: i64 = 0;
    while cur >= 0 {
        var ins: Vec<i64> = f.blocks.get(cur).instructions;
        var nxt: i64 = next.get(cur);
        if steps >= LW_CHAIN_MAX || nxt == b {
            nxt = - 1;
        }
        var upto: i64 = ins.len();
        if nxt >= 0 {
            upto = ins.len() - 1;
        }
        var k: i64 = 0;
        while k < upto {
            out.push(ins.get(k));
            k = k + 1;
        }
        // (where the chain stops, the block's own terminator is kept and
        // ends every scan)
        cur = nxt;
        steps = steps + 1;
    }
    return out;
}

/// LF15 diamonds (lw_rc_cancel_pairs): a variable that copies a by-value
/// parameter and is only read is not counted, wherever its drops are
/// (lw_rc_cancel_param_slots). false: such copies keep their count.
const LOWER_CANCEL_PARAM_SLOTS: bool = true;
/// LF15 diamonds: the same for a copy of a local variable that owns its
/// value and is not dropped, reassigned, moved out or changed while the
/// copy can still be read (lw_ps_local_src_ok, lw_ps_reaches). false: only
/// copies of parameters.
const LOWER_CANCEL_LOCAL_SLOTS: bool = true;

/// FID_RC_SLOTS_OFF=1: lw_rc_cancel_param_slots does nothing (to compare).
fn lw_ps_env_off() -> bool {
    match env_var("FID_RC_SLOTS_OFF") {
        Option::Some(v) => {
            return v == "1";
        }
        Option::None => {
        }
    }
    return false;
}

/// LF15 diamonds: `var t = p`, p a by-value parameter (a string, a Vec or a
/// map), counts p again into t's slot (Str_dup, or Vec_share /
/// HashMap_share stored there) and every path out of t's scope drops what
/// the slot holds: in either arm of an if, at the join, on each return
/// path, at the end of each round of a loop. When the slot is a variable
/// only loaded and stored, holds p or a literal (null) only, is never moved
/// out (each later literal store clears it right after a drop of what it
/// held), and every load is only read (lw_ps_use_ok) or dropped, the slot
/// borrows p as the parameter itself does: the count and all the slot's
/// drops go (a Vec or map slot then holds p itself). p stays alive for the
/// whole call (its caller owns it), and nothing here changes it: a callee
/// that changes a by-value parameter copies it first, and the parameter is
/// never dropped or grown in place here. Not for a function with regions
/// (a count may copy out of a region there). `var t = v`, v a local
/// variable, the same when v owns its value and no load of t can run after
/// a drop, store, move or change of v (LOWER_CANCEL_LOCAL_SLOTS,
/// lw_ps_local_src_ok, lw_ps_reaches): t borrows v as the slot of a
/// parameter's copy borrows the parameter.
fn lw_rc_cancel_param_slots(f: & mut IrFunction, module: & IrModule, dead: & mut Vec<i64>) {
    if f.params.len() == 0 || f.blocks.len() == 0 {
        return;
    }
    g_lw_ps_fn = f.name;
    // the counts of a parameter or a variable at all (most functions have
    // none)
    var cands: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < f.insts.len() {
        var cid: i64 = f.insts.get(i).id;
        var ck: i64 = lw_ps_count_kind(f, cid);
        if ck > 0 {
            var carg: i64 = lw_ps_count_arg(f, cid, ck);
            if lw_ps_param_kind(f, carg) == ck || (LOWER_CANCEL_LOCAL_SLOTS && lw_ps_local_kind(f, carg) == ck) {
                cands.push(cid);
            }
        }
        i = i + 1;
    }
    if cands.len() == 0 {
        return;
    }
    var nv: i64 = f.next_value;
    if f.inst_at.len() > nv {
        nv = f.inst_at.len();
    }
    // where each instruction runs: block index and position (-1: in no
    // block, it never runs)
    var blk_of: Vec<i64> = Vec::new();
    var pos_of: Vec<i64> = Vec::new();
    var z: i64 = 0;
    while z < nv {
        blk_of.push(- 1);
        pos_of.push(- 1);
        z = z + 1;
    }
    var b: i64 = 0;
    while b < f.blocks.len() {
        var bins: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < bins.len() {
            var bid: i64 = bins.get(k);
            if bid >= 0 && bid < nv {
                blk_of.set(bid, b);
                pos_of.set(bid, k);
            }
            k = k + 1;
        }
        b = b + 1;
    }
    // the users of each value (instructions that run), packed: those of v
    // are ulist[ustart[v] .. ustart[v + 1]]
    var ustart: Vec<i64> = Vec::new();
    z = 0;
    while z <= nv {
        ustart.push(0);
        z = z + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var uid: i64 = f.insts.get(i).id;
        if uid >= 0 && uid < nv && blk_of.get(uid) >= 0 {
            var refs: Vec<i64> = inst_value_refs(& f.insts.get(i).inst);
            var r: i64 = 0;
            while r < refs.len() {
                var rv: i64 = refs.get(r);
                if rv >= 0 && rv < nv {
                    ustart.set(rv + 1, ustart.get(rv + 1) + 1);
                }
                r = r + 1;
            }
        }
        i = i + 1;
    }
    z = 0;
    while z < nv {
        ustart.set(z + 1, ustart.get(z + 1) + ustart.get(z));
        z = z + 1;
    }
    var ulist: Vec<i64> = Vec::new();
    var fill: Vec<i64> = Vec::new();
    z = 0;
    while z < ustart.get(nv) {
        ulist.push(- 1);
        z = z + 1;
    }
    z = 0;
    while z < nv {
        fill.push(ustart.get(z));
        z = z + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var uid2: i64 = f.insts.get(i).id;
        if uid2 >= 0 && uid2 < nv && blk_of.get(uid2) >= 0 {
            var refs2: Vec<i64> = inst_value_refs(& f.insts.get(i).inst);
            var r2: i64 = 0;
            while r2 < refs2.len() {
                var rv2: i64 = refs2.get(r2);
                if rv2 >= 0 && rv2 < nv {
                    ulist.set(fill.get(rv2), uid2);
                    fill.set(rv2, fill.get(rv2) + 1);
                }
                r2 = r2 + 1;
            }
        }
        i = i + 1;
    }
    // per slot: 1 it borrows now (a count went), 2 a slot that borrows
    // reads it (a local source). A slot takes one role: a copy of a copy
    // that no longer counts would borrow from a borrower, whose kills say
    // nothing of when the value goes.
    var roles: Vec<i64> = Vec::new();
    z = 0;
    while z < nv {
        roles.push(0);
        z = z + 1;
    }
    var ci: i64 = 0;
    while ci < cands.len() {
        var gone: Vec<i64> = lw_ps_try_slot(f, module, cands.get(ci), blk_of, pos_of, ustart, ulist, & mut roles);
        var gi: i64 = 0;
        while gi < gone.len() {
            dead.push(gone.get(gi));
            gi = gi + 1;
        }
        ci = ci + 1;
    }
}

/// One count `c` of a parameter (lw_rc_cancel_param_slots): when the slot
/// it goes into qualifies, `c` and the slot's drops, to be removed (a Vec
/// or map slot is then stored the parameter itself); else nothing. A copy
/// of a local variable the same (lw_ps_local_src_ok); `roles` records the
/// slots that borrow and those they borrow from.

/// LF15: FID_PS_WHY=1 prints why a count was not cancelled (a diagnostic
/// of lw_ps_try_slot, never a gate).
var g_lw_ps_fn: str = "";

fn lw_ps_why(why: str) {
    match env_var("FID_PS_WHY") {
        Option::Some(v) => {
            if str_len(v) > 0 {
                p_eprint_str("ps [" + g_lw_ps_fn + "]: " + why + "
");
            }
        }
        Option::None => {
        }
    }
}
fn lw_ps_try_slot(f: & mut IrFunction, module: & IrModule, c: i64, blk_of: Vec<i64>, pos_of: Vec<i64>, ustart: Vec<i64>, ulist: Vec<i64>, roles: & mut Vec<i64>) -> Vec<i64> {
    var none: Vec<i64> = Vec::new();
    var nv: i64 = blk_of.len();
    if c < 0 || c >= nv || blk_of.get(c) < 0 {
        lw_ps_why("1:none");
        return none;
    }
    var kind: i64 = lw_ps_count_kind(f, c);
    if kind == 0 {
        lw_ps_why("2:none");
        return none;
    }
    var a: i64 = lw_ps_count_arg(f, c, kind);
    if a < 0 || a >= nv {
        lw_ps_why("3:none");
        return none;
    }
    // the parameter itself is never dropped, freed or grown in place here;
    // a local source (a load of a variable that owns its value) keeps the
    // value the slot gets until one of the source's kills (src_kills:
    // drops, stores, moves, changes) runs
    var is_param: bool = lw_ps_param_kind(f, a) == kind;
    var src_kills: Vec<i64> = Vec::new();
    if is_param {
        if !lw_ps_param_untouched(f, a, ustart, ulist, 0) {
            lw_ps_why("4:drops, stores, moves, changes) runs");
            return none;
        }
    } else {
        if !LOWER_CANCEL_LOCAL_SLOTS || lw_ps_local_kind(f, a) != kind {
            lw_ps_why("5:drops, stores, moves, changes) runs");
            return none;
        }
        if !lw_ps_local_src_ok(f, module, kind, a, ustart, ulist, & mut src_kills) {
            lw_ps_why("6:none");
            return none;
        }
    }
    // the store that gives the slot its value
    var st: i64 = - 1;
    var slot: i64 = - 1;
    // LF15 (Nov 21): with region lowering on, the dup's result goes through
    // Lowerer_rg_as_type's BitCast before the store (`t = p` stores
    // BitCast(Str_dup(p))); a function that opens no region (checked by the
    // caller) still counts in place, so the pair can go. `wrap` is that
    // BitCast, deleted with the count.
    var wrap: i64 = - 1;
    var cb: i64 = blk_of.get(c);
    var cins: Vec<i64> = f.blocks.get(cb).instructions;
    if kind == 1 {
        // Str_dup counts in place: its result is not used, and the first
        // instruction after it that is more than a pure value stores the
        // parameter (so each store follows its own count) — or, when the
        // region wrapper took it, exactly one BitCast of it is that
        // store's value
        var wrap_shape: bool = ustart.get(c + 1) - ustart.get(c) == 1;
        if !wrap_shape && ustart.get(c + 1) != ustart.get(c) {
            lw_ps_why("7:store's value");
            return none;
        }
        if wrap_shape {
            var w: i64 = ulist.get(ustart.get(c));
            var wat: i64 = lw_inst_pos(f, w);
            var w_of_c: bool = false;
            if wat >= 0 {
                match f.insts.get(wat).inst {
                    Inst::BitCast(x, _, _) => {
                        w_of_c = x == c;
                    }
                    _ => {
                    }
                }
            }
            if !w_of_c {
                lw_ps_why("8:none");
                return none;
            }
            wrap = w;
        }
        var p: i64 = pos_of.get(c) + 1;
        var found: bool = false;
        while p < cins.len() && !found {
            var pid: i64 = cins.get(p);
            if lw_rc_may_free(f, pid) {
                found = true;
                var sv: i64 = lw_ps_store_val(f, pid);
                if wrap >= 0 {
                    if sv == wrap && ustart.get(wrap + 1) - ustart.get(wrap) == 1 {
                        st = pid;
                        slot = lw_ps_store_ptr(f, pid);
                    }
                } else {
                    if sv == a {
                        st = pid;
                        slot = lw_ps_store_ptr(f, pid);
                    }
                }
            }
            p = p + 1;
        }
    } else {
        // the share is used once: stored, later in its block
        if ustart.get(c + 1) - ustart.get(c) != 1 {
            lw_ps_why("9:the share is used once: stored, later in its block");
            return none;
        }
        var su: i64 = ulist.get(ustart.get(c));
        if lw_ps_store_val(f, su) == c && blk_of.get(su) == cb && pos_of.get(su) > pos_of.get(c) {
            st = su;
            slot = lw_ps_store_ptr(f, su);
        }
    }
    if st < 0 || slot < 0 || slot >= nv || slot == a || slot == c {
        lw_ps_why("10:the share is used once: stored, later in its block");
        return none;
    }
    // a local source: read just before the store, in its block, with no
    // kill of the source in between (the slot gets a live value)
    if !is_param {
        if slot == lw_ps_load_ptr(f, a) || blk_of.get(a) != cb || pos_of.get(a) >= pos_of.get(st) {
            lw_ps_why("11:kill of the source in between ");
            return none;
        }
        var sd: i64 = 0;
        while sd < src_kills.len() {
            var sdi: i64 = src_kills.get(sd);
            if blk_of.get(sdi) == cb && pos_of.get(sdi) > pos_of.get(a) && pos_of.get(sdi) < pos_of.get(st) {
                lw_ps_why("12:kill of the source in between ");
                return none;
            }
            sd = sd + 1;
        }
    }
    // the slot is a variable, only loaded and stored; besides our store it
    // is only stored literals (null, zero, a string literal)
    if !lw_ps_is_alloca(f, slot) {
        lw_ps_why("13:is only stored literals ");
        return none;
    }
    var loads: Vec<i64> = Vec::new();
    var lits: Vec<i64> = Vec::new();
    var q: i64 = ustart.get(slot);
    while q < ustart.get(slot + 1) {
        var u: i64 = ulist.get(q);
        if lw_ps_load_ptr(f, u) == slot {
            loads.push(u);
        } else if u != st {
            var sp: i64 = lw_ps_store_ptr(f, u);
            var sv: i64 = lw_ps_store_val(f, u);
            if sp != slot || sv == slot || !lw_rc_is_literal_value(f, sv) {
                lw_ps_why("14:none");
                return none;
            }
            lits.push(u);
        }
        q = q + 1;
    }
    // each load is dropped (its only use), or only read
    var dname: str = lw_ps_drop_name(kind);
    var drops: Vec<i64> = Vec::new();
    var li: i64 = 0;
    while li < loads.len() {
        var l: i64 = loads.get(li);
        var dr: i64 = lw_ps_exclusive_drop(f, l, dname, ustart, ulist);
        if dr >= 0 {
            drops.push(dr);
        } else {
            var q2: i64 = ustart.get(l);
            while q2 < ustart.get(l + 1) {
                if !lw_ps_use_ok(f, module, kind, ulist.get(q2), l, ustart, ulist, 0) {
                    lw_ps_why("15:none");
                    return none;
                }
                q2 = q2 + 1;
            }
        }
        li = li + 1;
    }
    // never moved out: a literal store is the slot's first value, or
    // clears it right after a drop of what it held
    var li2: i64 = 0;
    while li2 < lits.len() {
        if !lw_ps_lit_store_ok(f, lits.get(li2), st, loads, drops, blk_of, pos_of, ustart, ulist) {
            lw_ps_why("16:clears it right after a drop of what it held");
            return none;
        }
        li2 = li2 + 1;
    }
    // a local source keeps its value while the slot can still be read: no
    // load of the slot runs after a kill of the source (a drop, a store, a
    // move, a change) unless our store gave the slot a new value first
    var src: i64 = - 1;
    if !is_param {
        src = lw_ps_load_ptr(f, a);
        var rd: i64 = 0;
        while rd < src_kills.len() {
            if lw_ps_reaches(f, src_kills.get(rd), st, loads, blk_of, pos_of) {
                lw_ps_why("17:move, a change) unless our store gave the slot a new value f");
                return none;
            }
            rd = rd + 1;
        }
    }
    // one role per slot (lw_rc_cancel_param_slots)
    if slot >= roles.len() || roles.get(slot) != 0 {
        lw_ps_why("18:one role per slot ");
        return none;
    }
    if src >= 0 {
        if src >= roles.len() || roles.get(src) == 1 {
            lw_ps_why("19:one role per slot ");
            return none;
        }
        roles.set(src, 2);
    }
    roles.set(slot, 1);
    var gone: Vec<i64> = Vec::new();
    gone.push(c);
    if wrap >= 0 {
        gone.push(wrap);
    }
    var di: i64 = 0;
    while di < drops.len() {
        gone.push(drops.get(di));
        di = di + 1;
    }
    if kind != 1 || wrap >= 0 {
        lw_ps_set_store_val(f, st, a);
    }
    return gone;
}

/// What value `v` is when it is a load of a variable (an Alloca): 1 a
/// string, 2 a Vec, 3 a map (lw_ps_type_kind of the load), else 0.
fn lw_ps_local_kind(f: & IrFunction, v: i64) -> i64 {
    var at: i64 = lw_inst_pos(f, v);
    if at < 0 {
        return 0;
    }
    match f.insts.get(at).inst {
        Inst::Load(lp, lty) => {
            if lp >= 0 && lw_ps_is_alloca(f, lp) {
                return lw_ps_type_kind(lty);
            }
        }
        _ => {
        }
    }
    return 0;
}

/// LF15 diamonds, a copy of a local variable: `a` is a load of variable
/// `src`. True when src's slot is an Alloca only loaded and stored (its
/// address never taken) and src owns its values: it is dropped somewhere
/// (a variable that borrows, a loop variable or a binding, has no drops:
/// its value belongs to something else, which could go first). Every
/// instruction after which src may no longer hold the value it had is
/// added to `src_kills`: its drops, every store into it (a new value, or a
/// literal that clears it after a drop or a move), and every use of one of
/// its loads that does more than read it (lw_ps_use_ok: a change in place,
/// a hand-over, a free). The caller checks that no read of the copy can run
/// after one of them (lw_ps_reaches).
fn lw_ps_local_src_ok(f: & IrFunction, module: & IrModule, kind: i64, a: i64, ustart: Vec<i64>, ulist: Vec<i64>, src_kills: & mut Vec<i64>) -> bool {
    var nv: i64 = ustart.len() - 1;
    var src: i64 = lw_ps_load_ptr(f, a);
    if src < 0 || src >= nv || !lw_ps_is_alloca(f, src) {
        return false;
    }
    var loads: Vec<i64> = Vec::new();
    var kills: Vec<i64> = Vec::new();
    var q: i64 = ustart.get(src);
    while q < ustart.get(src + 1) {
        var u: i64 = ulist.get(q);
        if lw_ps_load_ptr(f, u) == src {
            loads.push(u);
        } else {
            var sp: i64 = lw_ps_store_ptr(f, u);
            var sv: i64 = lw_ps_store_val(f, u);
            if sp != src || sv < 0 || sv == src {
                return false;
            }
            kills.push(u);
        }
        q = q + 1;
    }
    var dname: str = lw_ps_drop_name(kind);
    var ndrops: i64 = 0;
    var li: i64 = 0;
    while li < loads.len() {
        var l: i64 = loads.get(li);
        var dr: i64 = lw_ps_exclusive_drop(f, l, dname, ustart, ulist);
        if dr >= 0 {
            kills.push(dr);
            ndrops = ndrops + 1;
        } else {
            var q2: i64 = ustart.get(l);
            while q2 < ustart.get(l + 1) {
                var lu: i64 = ulist.get(q2);
                if !lw_ps_use_ok(f, module, kind, lu, l, ustart, ulist, 0) {
                    kills.push(lu);
                }
                q2 = q2 + 1;
            }
        }
        li = li + 1;
    }
    if ndrops == 0 {
        return false;
    }
    var di: i64 = 0;
    while di < kills.len() {
        src_kills.push(kills.get(di));
        di = di + 1;
    }
    return true;
}

/// Whether an instruction of `targets` can run after instruction `from`
/// before `stop` runs again (stop -1: none): later in from's block, or in
/// a block reachable from it (from's own block again through a loop). The
/// walk ends at the block that holds `stop`: only what runs there before
/// it counts.
fn lw_ps_reaches(f: & IrFunction, from: i64, stop: i64, targets: Vec<i64>, blk_of: Vec<i64>, pos_of: Vec<i64>) -> bool {
    var nv: i64 = blk_of.len();
    if from < 0 || from >= nv || blk_of.get(from) < 0 {
        return true;
    }
    var nb: i64 = f.blocks.len();
    var fb: i64 = blk_of.get(from);
    var fpos: i64 = pos_of.get(from);
    var sb: i64 = - 1;
    var spos: i64 = - 1;
    if stop >= 0 && stop < nv && blk_of.get(stop) >= 0 {
        sb = blk_of.get(stop);
        spos = pos_of.get(stop);
    }
    // block id -> index
    var maxid: i64 = 0;
    var b: i64 = 0;
    while b < nb {
        if f.blocks.get(b).id > maxid {
            maxid = f.blocks.get(b).id;
        }
        b = b + 1;
    }
    var at: Vec<i64> = Vec::new();
    var z: i64 = 0;
    while z <= maxid {
        at.push(- 1);
        z = z + 1;
    }
    b = 0;
    while b < nb {
        var bid: i64 = f.blocks.get(b).id;
        if bid >= 0 {
            at.set(bid, b);
        }
        b = b + 1;
    }
    var seen: Vec<bool> = Vec::new();
    z = 0;
    while z < nb {
        seen.push(false);
        z = z + 1;
    }
    // the rest of from's block (up to stop when stop comes after from)
    var hi: i64 = - 1;
    if sb == fb && spos > fpos {
        hi = spos;
    }
    if lw_ps_hits(targets, blk_of, pos_of, fb, fpos, hi) {
        return true;
    }
    var work: Vec<i64> = Vec::new();
    if hi < 0 {
        lw_ps_push_succs(f, fb, at, & mut work);
    }
    var wi: i64 = 0;
    while wi < work.len() {
        var wb: i64 = work.get(wi);
        wi = wi + 1;
        if wb >= 0 && wb < nb && !seen.get(wb) {
            seen.set(wb, true);
            var whi: i64 = - 1;
            if wb == sb {
                whi = spos;
            }
            if lw_ps_hits(targets, blk_of, pos_of, wb, - 1, whi) {
                return true;
            }
            if wb != sb {
                lw_ps_push_succs(f, wb, at, & mut work);
            }
        }
    }
    return false;
}

/// Whether an instruction of `targets` is in block `blk` after position
/// `lo` and (hi >= 0) before position `hi`.
fn lw_ps_hits(targets: Vec<i64>, blk_of: Vec<i64>, pos_of: Vec<i64>, blk: i64, lo: i64, hi: i64) -> bool {
    var t: i64 = 0;
    while t < targets.len() {
        var tid: i64 = targets.get(t);
        if tid >= 0 && tid < blk_of.len() && blk_of.get(tid) == blk {
            var tp: i64 = pos_of.get(tid);
            if tp > lo && (hi < 0 || tp < hi) {
                return true;
            }
        }
        t = t + 1;
    }
    return false;
}

/// The blocks (by index; `at` maps a block id to its index) that block `b`
/// jumps to, added to `work`.
fn lw_ps_push_succs(f: & IrFunction, b: i64, at: Vec<i64>, work: & mut Vec<i64>) {
    var ins: Vec<i64> = f.blocks.get(b).instructions;
    var tids: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < ins.len() {
        var p: i64 = lw_inst_pos(f, ins.get(k));
        if p >= 0 {
            match f.insts.get(p).inst {
                Inst::Jump(j1) => {
                    tids.push(j1);
                }
                Inst::Branch(_, j1, j2) => {
                    tids.push(j1);
                    tids.push(j2);
                }
                Inst::Switch(_, _, jl, jd) => {
                    var s: i64 = 0;
                    while s < jl.len() {
                        tids.push(jl.get(s));
                        s = s + 1;
                    }
                    tids.push(jd);
                }
                Inst::TryUnwrap(_, _, je, jo) => {
                    tids.push(je);
                    tids.push(jo);
                }
                _ => {
                }
            }
        }
        k = k + 1;
    }
    var i: i64 = 0;
    while i < tids.len() {
        var tid: i64 = tids.get(i);
        if tid >= 0 && tid < at.len() && at.get(tid) >= 0 {
            work.push(at.get(tid));
        }
        i = i + 1;
    }
}

/// What a by-value parameter `v` of `f` is: 1 a string, 2 a Vec, 3 a map,
/// else 0 (also when `v` is no parameter). A reference parameter is a
/// pointer to the caller's slot: 0.
fn lw_ps_param_kind(f: & IrFunction, v: i64) -> i64 {
    if v < 0 {
        return 0;
    }
    var i: i64 = 0;
    while i < f.params.len() {
        if f.params.get(i).id == v {
            return lw_ps_type_kind(f.params.get(i).ty);
        }
        i = i + 1;
    }
    return 0;
}

/// 1 for a string (`*u8`), 2 for a Vec, 3 for a map, else 0.
fn lw_ps_type_kind(t: IrType) -> i64 {
    match t {
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::U8 => {
                    return 1;
                }
                _ => {
                }
            }
        }
        IrType::Generic(gn, _) => {
            if gn == "Vec" {
                return 2;
            }
            if gn == "HashMap" {
                return 3;
            }
        }
        IrType::Opaque(onm) => {
            if onm == "Vec" {
                return 2;
            }
            if onm == "HashMap" {
                return 3;
            }
        }
        _ => {
        }
    }
    return 0;
}

/// Instruction `id` counts a value again: 1 `Str_dup`, 2 `Vec_share`, 3
/// `HashMap_share` (env first, the value second), else 0.
fn lw_ps_count_kind(f: & IrFunction, id: i64) -> i64 {
    var at: i64 = lw_inst_pos(f, id);
    if at < 0 {
        return 0;
    }
    match f.insts.get(at).inst {
        Inst::Call(n, args, _, _) => {
            if args.len() == 2 {
                if n == "Str_dup" {
                    return 1;
                }
                if n == "Vec_share" {
                    return 2;
                }
                if n == "HashMap_share" {
                    return 3;
                }
            }
        }
        _ => {
        }
    }
    return 0;
}

/// The value count `id` (of kind `kind`, lw_ps_count_kind) counts: a
/// string through its cast to a word.
fn lw_ps_count_arg(f: & IrFunction, id: i64, kind: i64) -> i64 {
    if kind == 1 {
        return lw_rc_str_count_arg(f, id, "Str_dup");
    }
    var at: i64 = lw_inst_pos(f, id);
    if at < 0 {
        return - 1;
    }
    match f.insts.get(at).inst {
        Inst::Call(_, args, _, _) => {
            if args.len() == 2 {
                return args.get(1);
            }
        }
        _ => {
        }
    }
    return - 1;
}

/// The drop of a value of kind `kind` (lw_ps_count_kind).
fn lw_ps_drop_name(kind: i64) -> str {
    if kind == 2 {
        return "Vec_drop";
    }
    if kind == 3 {
        return "HashMap_drop";
    }
    return "Str_drop";
}

/// Calls that free or drop what they get.
fn lw_ps_frees(cn: str) -> bool {
    return str_starts_with(cn, "Str_drop") || str_starts_with(cn, "Vec_drop") || str_starts_with(cn, "HashMap_drop") || str_starts_with(cn, "Box_drop") || str_starts_with(cn, "__own_drop_") || cn == "p_free" || cn == "p_str_free" || cn == "free" || cn == "vec_buf_free" || cn == "vec_box_free";
}

/// The slot instruction `id` loads from, else -1.
fn lw_ps_load_ptr(f: & IrFunction, id: i64) -> i64 {
    var at: i64 = lw_inst_pos(f, id);
    if at < 0 {
        return - 1;
    }
    match f.insts.get(at).inst {
        Inst::Load(p, _) => {
            return p;
        }
        _ => {
        }
    }
    return - 1;
}

/// The slot instruction `id` stores into, else -1.
fn lw_ps_store_ptr(f: & IrFunction, id: i64) -> i64 {
    var at: i64 = lw_inst_pos(f, id);
    if at < 0 {
        return - 1;
    }
    match f.insts.get(at).inst {
        Inst::Store(sp, _, _) => {
            return sp;
        }
        _ => {
        }
    }
    return - 1;
}

/// The value instruction `id` stores, else -1.
fn lw_ps_store_val(f: & IrFunction, id: i64) -> i64 {
    var at: i64 = lw_inst_pos(f, id);
    if at < 0 {
        return - 1;
    }
    match f.insts.get(at).inst {
        Inst::Store(_, sv, _) => {
            return sv;
        }
        _ => {
        }
    }
    return - 1;
}

/// Store `id` stores `v` instead.
fn lw_ps_set_store_val(f: & mut IrFunction, id: i64, v: i64) {
    var pos: i64 = lw_inst_pos(f, id);
    if pos < 0 || pos >= f.insts.len() {
        return;
    }
    var e: ValueIdInst = f.insts.get(pos);
    match e.inst {
        Inst::Store(sp, _, sty) => {
            e.inst = Inst::Store(sp, v, sty);
            f.insts.set(pos, e);
        }
        _ => {
        }
    }
}

/// Whether instruction `id` is an Alloca (a variable's slot).
fn lw_ps_is_alloca(f: & IrFunction, id: i64) -> bool {
    var at: i64 = lw_inst_pos(f, id);
    if at < 0 {
        return false;
    }
    match f.insts.get(at).inst {
        Inst::Alloca(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// The value `id` drops when it is a call of `dname` (env first), else -1.
fn lw_ps_drop_of(f: & IrFunction, id: i64, dname: str) -> i64 {
    var at: i64 = lw_inst_pos(f, id);
    if at < 0 {
        return - 1;
    }
    match f.insts.get(at).inst {
        Inst::Call(n, args, _, _) => {
            if n == dname && args.len() == 2 {
                return args.get(1);
            }
        }
        _ => {
        }
    }
    return - 1;
}

/// The drop of load `l` when that drop (straight, or through a cast to a
/// word) is the load's one use, else -1.
fn lw_ps_exclusive_drop(f: & IrFunction, l: i64, dname: str, ustart: Vec<i64>, ulist: Vec<i64>) -> i64 {
    if ustart.get(l + 1) - ustart.get(l) != 1 {
        return - 1;
    }
    var u: i64 = ulist.get(ustart.get(l));
    if lw_ps_drop_of(f, u, dname) == l {
        return u;
    }
    var at: i64 = lw_inst_pos(f, u);
    if at < 0 {
        return - 1;
    }
    var is_cast: bool = false;
    match f.insts.get(at).inst {
        Inst::BitCast(x, _, _) => {
            is_cast = x == l;
        }
        _ => {
        }
    }
    if !is_cast || u + 1 >= ustart.len() || ustart.get(u + 1) - ustart.get(u) != 1 {
        return - 1;
    }
    var d: i64 = ulist.get(ustart.get(u));
    if lw_ps_drop_of(f, d, dname) == u {
        return d;
    }
    return - 1;
}

/// Whether parameter `a` (or a cast of it) is never dropped, freed, grown
/// in place (`p_str_append`'s argument 1) or stored through.
fn lw_ps_param_untouched(f: & IrFunction, a: i64, ustart: Vec<i64>, ulist: Vec<i64>, depth: i64) -> bool {
    var q: i64 = ustart.get(a);
    while q < ustart.get(a + 1) {
        var u: i64 = ulist.get(q);
        var at: i64 = lw_inst_pos(f, u);
        if at >= 0 {
            match f.insts.get(at).inst {
                Inst::Call(cn, cargs, _, _) => {
                    if lw_ps_frees(cn) {
                        return false;
                    }
                    if cn == "p_str_append" && cargs.len() > 1 && cargs.get(1) == a {
                        return false;
                    }
                }
                Inst::Store(sp, _, _) => {
                    if sp == a {
                        return false;
                    }
                }
                Inst::BitCast(_, _, _) => {
                    if depth >= 2 || !lw_ps_param_untouched(f, u, ustart, ulist, depth + 1) {
                        return false;
                    }
                }
                _ => {
                }
            }
        }
        q = q + 1;
    }
    return true;
}

/// Whether value `v` (a string) is counted again by a Str_dup, straight or
/// through a cast to a word.
fn lw_ps_has_dup(f: & IrFunction, v: i64, ustart: Vec<i64>, ulist: Vec<i64>) -> bool {
    var q: i64 = ustart.get(v);
    while q < ustart.get(v + 1) {
        var u: i64 = ulist.get(q);
        if lw_rc_str_count_arg(f, u, "Str_dup") == v {
            return true;
        }
        if lw_rc_str_count_arg(f, u, "Str_dup") < 0 {
            var at: i64 = lw_inst_pos(f, u);
            if at >= 0 {
                var cast_of_v: bool = false;
                match f.insts.get(at).inst {
                    Inst::BitCast(x, _, _) => {
                        cast_of_v = x == v;
                    }
                    _ => {
                    }
                }
                if cast_of_v {
                    var q2: i64 = ustart.get(u);
                    while q2 < ustart.get(u + 1) {
                        if lw_rc_str_count_arg(f, ulist.get(q2), "Str_dup") == v {
                            return true;
                        }
                        q2 = q2 + 1;
                    }
                }
            }
        }
        q = q + 1;
    }
    return false;
}

/// Whether instruction `u`'s use of `v` (a load of the slot, or a cast of
/// one) only reads the parameter it holds and keeps no uncounted copy of
/// it. A string (kind 1): any call reads it, but `p_str_append` (which
/// grows its argument 1 in place) and the frees; a comparison or a print
/// reads it; a store elsewhere is a keeper's only next to its own Str_dup.
/// A Vec or map (kinds 2, 3): lw_ps_handle_call_ok, or a comparison.
fn lw_ps_use_ok(f: & IrFunction, module: & IrModule, kind: i64, u: i64, v: i64, ustart: Vec<i64>, ulist: Vec<i64>, depth: i64) -> bool {
    var at: i64 = lw_inst_pos(f, u);
    if at < 0 {
        return false;
    }
    match f.insts.get(at).inst {
        Inst::BinOp(_, _, _, _) => {
            return true;
        }
        Inst::Print(_, _) => {
            return kind == 1;
        }
        Inst::BitCast(_, _, _) => {
            if depth >= 3 {
                return false;
            }
            var q: i64 = ustart.get(u);
            while q < ustart.get(u + 1) {
                if !lw_ps_use_ok(f, module, kind, ulist.get(q), u, ustart, ulist, depth + 1) {
                    return false;
                }
                q = q + 1;
            }
            return true;
        }
        Inst::Store(sp, sv, _) => {
            if sp == v || sv != v {
                return false;
            }
            return kind == 1 && lw_ps_has_dup(f, v, ustart, ulist);
        }
        Inst::Call(cn, cargs, _, _) => {
            if kind == 1 {
                if lw_ps_frees(cn) {
                    return false;
                }
                if cn == "p_str_append" && cargs.len() > 1 && cargs.get(1) == v {
                    return false;
                }
                return true;
            }
            return lw_ps_handle_call_ok(module, cn, cargs, v);
        }
        _ => {
        }
    }
    return false;
}

/// Whether call `cn(cargs)` only reads the Vec or map handle `v`: as
/// argument 1 of core's read-only calls (lw_rc_read_only_call) or of a
/// share (a counted copy for a keeper), or as by-value Vec / map
/// parameters of the program's own functions (borrowed: one the callee
/// changes it copies first).
fn lw_ps_handle_call_ok(module: & IrModule, cn: str, cargs: Vec<i64>, v: i64) -> bool {
    var k: i64 = 0;
    var at1: bool = false;
    var other: bool = false;
    while k < cargs.len() {
        if cargs.get(k) == v {
            if k == 1 {
                at1 = true;
            } else {
                other = true;
            }
        }
        k = k + 1;
    }
    if at1 && !other && (lw_rc_read_only_call(cn) || cn == "Vec_share" || cn == "HashMap_share") {
        return true;
    }
    // core and the runtime take raw handles they may change
    if str_starts_with(cn, "Vec_") || str_starts_with(cn, "vec_") || str_starts_with(cn, "HashMap_") || str_starts_with(cn, "p_") || str_starts_with(cn, "Str_") || str_starts_with(cn, "Box_") || str_starts_with(cn, "__") || str_starts_with(cn, "rg_") {
        return false;
    }
    var fp: i64 = IrModule_fn_pos(module, cn);
    if fp < 0 || fp >= module.functions.len() {
        return false;
    }
    if module.functions.get(fp).func.blocks.len() == 0 {
        return false;
    }
    var cps: Vec<ValueIdType> = module.functions.get(fp).func.params;
    if cps.len() != cargs.len() {
        return false;
    }
    var j: i64 = 0;
    while j < cargs.len() {
        if cargs.get(j) == v {
            var pk: i64 = lw_ps_type_kind(cps.get(j).ty);
            if pk != 2 && pk != 3 {
                return false;
            }
        }
        j = j + 1;
    }
    return true;
}

/// Whether literal store `ls` into the slot does not move the slot's value
/// out: it is the slot's first value (in the entry block, before our store
/// `st` and every load there), or it clears the slot right after one of
/// its drops (nothing between but pure values that are not its loads).
fn lw_ps_lit_store_ok(f: & IrFunction, ls: i64, st: i64, loads: Vec<i64>, drops: Vec<i64>, blk_of: Vec<i64>, pos_of: Vec<i64>, ustart: Vec<i64>, ulist: Vec<i64>) -> bool {
    var lb: i64 = blk_of.get(ls);
    var lpos: i64 = pos_of.get(ls);
    if lb < 0 || lpos < 0 {
        return false;
    }
    if lb == 0 {
        var init: bool = true;
        if blk_of.get(st) == 0 && pos_of.get(st) < lpos {
            init = false;
        }
        var k: i64 = 0;
        while k < loads.len() && init {
            if blk_of.get(loads.get(k)) == 0 && pos_of.get(loads.get(k)) < lpos {
                init = false;
            }
            k = k + 1;
        }
        if init {
            return true;
        }
    }
    var bins: Vec<i64> = f.blocks.get(lb).instructions;
    var p: i64 = lpos - 1;
    while p >= 0 {
        var pid: i64 = bins.get(p);
        if lw_c_vec_i64_has(drops, pid) {
            return true;
        }
        if lw_c_vec_i64_has(loads, pid) {
            // LF15 (Nov 21): a load whose only reader is (a cast and)
            // one of the drops is that drop's own operand — `load t;
            // drop(t); t = null` — and keeps nothing from the store
            var q2: i64 = ustart.get(pid);
            var ok2: bool = q2 < ustart.get(pid + 1);
            while q2 < ustart.get(pid + 1) && ok2 {
                var uu: i64 = ulist.get(q2);
                if !lw_c_vec_i64_has(drops, uu) {
                    var uat: i64 = lw_inst_pos(f, uu);
                    var cast_drop: bool = false;
                    if uat >= 0 {
                        match f.insts.get(uat).inst {
                            Inst::BitCast(bx, _, _) => {
                                if bx == pid && ustart.get(uu + 1) - ustart.get(uu) == 1 {
                                    cast_drop = lw_c_vec_i64_has(drops, ulist.get(ustart.get(uu)));
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    ok2 = cast_drop;
                }
                q2 = q2 + 1;
            }
            if !ok2 {
                return false;
            }
        } else {
            // LF15 (Nov 21): the null of the clearing store itself (`drop;
            // t = null`) is no barrier; anything else that may free is
            var nat: i64 = lw_inst_pos(f, pid);
            var is_null: bool = false;
            if nat >= 0 {
                match f.insts.get(nat).inst {
                    Inst::ConstNull(_) => {
                        is_null = true;
                    }
                    _ => {
                    }
                }
            }
            if !is_null && lw_rc_may_free(f, pid) {
                return false;
            }
        }
        p = p - 1;
    }
    return false;
}

/// The string argument of instruction `id` when it is a call of `fname`
/// (core's Str_dup/Str_drop, env first), else -1.
fn lw_rc_str_count_arg(f: & IrFunction, id: i64, fname: str) -> i64 {
    // CS4: read in place (IrFunction_get_inst copies the instruction)
    var at: i64 = lw_inst_pos(f, id);
    if at < 0 {
        return - 1;
    }
    match f.insts.get(at).inst {
        Inst::Call(n, args, _, _) => {
            if n == fname && args.len() >= 2 {
                // Through the cast to a word: the value itself
                var a: i64 = args.get(1);
                var aat: i64 = lw_inst_pos(f, a);
                if aat >= 0 {
                    match f.insts.get(aat).inst {
                        Inst::BitCast(x, _, _) => {
                            return x;
                        }
                        _ => {
                        }
                    }
                }
                return a;
            }
        }
        _ => {
        }
    }
    return - 1;
}

/// CS4: where instruction `id` is in `f.insts`, or -1 (as
/// IrFunction_get_inst finds it). A match on `f.insts.get(at).inst` reads
/// the instruction in place; IrFunction_get_inst hands back a copy (its
/// Vec operands shared, then dropped), which the post-lowering passes paid
/// for on every instruction they looked at.
fn lw_inst_pos(f: & IrFunction, id: i64) -> i64 {
    if id >= 0 && id < f.inst_at.len() {
        return f.inst_at.get(id) - 1;
    }
    return - 1;
}

/// Whether instruction `id` could free or keep a string (anything but a
/// pure computation).
fn lw_rc_may_free(f: & IrFunction, id: i64) -> bool {
    var at: i64 = lw_inst_pos(f, id);
    if at < 0 {
        return true;
    }
    match f.insts.get(at).inst {
        Inst::ConstInt(_, _) => {
            return false;
        }
        Inst::ConstBool(_) => {
            return false;
        }
        Inst::ConstStr(_) => {
            return false;
        }
        Inst::BinOp(_, _, _, _) => {
            return false;
        }
        Inst::BitCast(_, _, _) => {
            return false;
        }
        Inst::Load(_, _) => {
            return false;
        }
        Inst::GetFieldPtr(_, _, _) => {
            return false;
        }
        _ => {
            return true;
        }
    }
    return true;
}

/// Whether any instruction of `f` uses value `v`.
fn lw_rc_value_used(f: & IrFunction, v: i64) -> bool {
    var i: i64 = 0;
    while i < f.insts.len() {
        var refs: Vec<i64> = inst_value_refs(& f.insts.get(i).inst);
        var j: i64 = 0;
        while j < refs.len() {
            if refs.get(j) == v {
                return true;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return false;
}

// --- LG6: closure environments on the stack --------------------------------

// A closure env that never leaves the function that makes it lives in that
// function's frame (LG6), on every path (interpreter, C, native): the env's
// `p_malloc` becomes a stack `Alloca` in place. It was a heap block that
// nothing freed. The native mid-end did the same (iropt.fd
// `iro_closure_devirt`); it reads both forms.
const LOWER_STACK_ENVS: bool = true;  /// Whether `x` is in `v`.
fn lw_env_in(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// How many times `v` is in `refs`.
fn lw_env_count(refs: Vec<i64>, v: i64) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < refs.len() {
        if refs.get(i) == v {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// The byte size of a Lowerer_make_fn_env env, `p_malloc(ConstInt)`; 0 when
/// `id` is not such a call.
fn lw_env_size(f: & IrFunction, id: i64) -> i64 {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(inst) => {
            match inst {
                Inst::Call(nm, margs, _, _) => {
                    if nm == "p_malloc" && margs.len() == 1 {
                        match IrFunction_get_inst(f, margs.get(0)) {
                            OptInst::Some(si) => {
                                match si {
                                    Inst::ConstInt(sz, _) => {
                                        if sz >= 8 && sz % 8 == 0 && sz <= 4096 {
                                            return sz;
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                            OptInst::None => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return 0;
}

/// The constant index of GetElemPtr index `idx`, or -1.
fn lw_env_const(f: & IrFunction, idx: i64) -> i64 {
    match IrFunction_get_inst(f, idx) {
        OptInst::Some(inst) => {
            match inst {
                Inst::ConstInt(v, _) => {
                    return v;
                }
                _ => {
                }
            }
        }
        OptInst::None => {
        }
    }
    return - 1;
}

/// Whether the closure function `cf` uses its `__env` parameter only as the
/// base of field addresses that are loaded or stored through: it neither
/// keeps nor passes on the env, so the env may live in the caller's frame.
fn lw_env_callee_ok(cf: & IrFunction) -> bool {
    if cf.params.len() == 0 {
        return false;
    }
    var envp: i64 = cf.params.get(0).id;
    var geps: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < cf.insts.len() {
        var e: ValueIdInst = cf.insts.get(i);
        match e.inst {
            Inst::GetElemPtr(gb, gi, _) => {
                if gb == envp && gi != envp {
                    geps.push(e.id);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < cf.insts.len() {
        var ue: ValueIdInst = cf.insts.get(i);
        var refs: Vec<i64> = inst_value_refs(& ue.inst);
        var r: i64 = 0;
        while r < refs.len() {
            var v: i64 = refs.get(r);
            if v == envp {
                var fine: bool = false;
                match ue.inst {
                    Inst::GetElemPtr(gb2, gi2, _) => {
                        fine = gb2 == envp && gi2 != envp;
                    }
                    _ => {
                    }
                }
                if !fine {
                    return false;
                }
            }
            if lw_env_in(geps, v) {
                var fine2: bool = false;
                match ue.inst {
                    Inst::Load(lp, _) => {
                        fine2 = lp == v;
                    }
                    Inst::Store(sp, sv, _) => {
                        fine2 = sp == v && sv != v;
                    }
                    _ => {
                    }
                }
                if !fine2 {
                    return false;
                }
            }
            r = r + 1;
        }
        i = i + 1;
    }
    return true;
}

/// The function of closure env `e` of `f` when the env stays in `f`'s frame,
/// else "". Its uses must be the field stores Lowerer_make_fn_env made (a
/// ConstFnRef at field 0), calls through it (`CallPtr` with it as the
/// callee, never as an argument), and stores into local slots whose every
/// store is `e` and whose every load is only such a callee.
fn lw_env_target(f: & IrFunction, e: i64) -> str {
    var geps: Vec<i64> = Vec::new();
    var slots: Vec<i64> = Vec::new();
    var loads: Vec<i64> = Vec::new();
    var calls: i64 = 0;
    var fname: str = "";
    // 1: the env's own uses
    var i: i64 = 0;
    while i < f.insts.len() {
        var ue: ValueIdInst = f.insts.get(i);
        var refs: Vec<i64> = inst_value_refs(& ue.inst);
        if lw_env_in(refs, e) {
            var fine: bool = false;
            match ue.inst {
                Inst::GetElemPtr(gb, gi, _) => {
                    if gb == e && gi != e && lw_env_const(f, gi) >= 0 {
                        fine = true;
                        geps.push(ue.id);
                    }
                }
                Inst::Store(sp, sv, _) => {
                    if sv == e && sp != e {
                        match IrFunction_get_inst(f, sp) {
                            OptInst::Some(si) => {
                                match si {
                                    Inst::Alloca(_, _) => {
                                        fine = true;
                                        if !lw_env_in(slots, sp) {
                                            slots.push(sp);
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                            OptInst::None => {
                            }
                        }
                    }
                }
                Inst::CallPtr(callee, cargs, _, _, _) => {
                    if callee == e && lw_env_count(cargs, e) == 0 {
                        fine = true;
                        calls = calls + 1;
                    }
                }
                _ => {
                }
            }
            if !fine {
                return "";
            }
        }
        i = i + 1;
    }
    // 2: the field stores, and the slots' loads and stores
    i = 0;
    while i < f.insts.len() {
        var ue2: ValueIdInst = f.insts.get(i);
        var refs2: Vec<i64> = inst_value_refs(& ue2.inst);
        var r: i64 = 0;
        while r < refs2.len() {
            var v: i64 = refs2.get(r);
            if lw_env_in(geps, v) {
                var fine2: bool = false;
                match ue2.inst {
                    Inst::Store(sp2, sv2, _) => {
                        if sp2 == v && sv2 != v {
                            fine2 = true;
                            var gidx: i64 = - 1;
                            match IrFunction_get_inst(f, v) {
                                OptInst::Some(gi3) => {
                                    match gi3 {
                                        Inst::GetElemPtr(_, gix, _) => {
                                            gidx = lw_env_const(f, gix);
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                OptInst::None => {
                                }
                            }
                            if gidx == 0 {
                                var nm: str = "";
                                match IrFunction_get_inst(f, sv2) {
                                    OptInst::Some(fr) => {
                                        match fr {
                                            Inst::ConstFnRef(n) => {
                                                nm = n;
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                    OptInst::None => {
                                    }
                                }
                                if nm == "" {
                                    return "";
                                }
                                if fname != "" && fname != nm {
                                    return "";
                                }
                                fname = nm;
                            }
                        }
                    }
                    _ => {
                    }
                }
                if !fine2 {
                    return "";
                }
            }
            if lw_env_in(slots, v) {
                var fine3: bool = false;
                match ue2.inst {
                    Inst::Load(lp, _) => {
                        if lp == v {
                            fine3 = true;
                            loads.push(ue2.id);
                        }
                    }
                    Inst::Store(sp3, sv3, _) => {
                        fine3 = sp3 == v && sv3 == e;
                    }
                    _ => {
                    }
                }
                if !fine3 {
                    return "";
                }
            }
            r = r + 1;
        }
        i = i + 1;
    }
    // 3: what the slots' loads feed
    if loads.len() > 0 {
        i = 0;
        while i < f.insts.len() {
            var ue3: ValueIdInst = f.insts.get(i);
            var refs3: Vec<i64> = inst_value_refs(& ue3.inst);
            var q: i64 = 0;
            while q < refs3.len() {
                var lv: i64 = refs3.get(q);
                if lw_env_in(loads, lv) {
                    var fine4: bool = false;
                    match ue3.inst {
                        Inst::CallPtr(lcallee, lcargs, _, _, _) => {
                            if lcallee == lv && lw_env_count(lcargs, lv) == 0 {
                                fine4 = true;
                                calls = calls + 1;
                            }
                        }
                        _ => {
                        }
                    }
                    if !fine4 {
                        return "";
                    }
                }
                q = q + 1;
            }
            i = i + 1;
        }
    }
    if calls == 0 {
        return "";
    }
    return fname;
}

/// The envs of `f` that may live on the stack, as pairs (env id, byte size)
/// pushed onto `out`.
fn lw_stack_envs_find(module: & IrModule, f: & IrFunction, out: & mut Vec<i64>) {
    var i: i64 = 0;
    while i < f.insts.len() {
        var e: ValueIdInst = f.insts.get(i);
        var sz: i64 = 0;
        match e.inst {
            Inst::Call(nm, _, _, _) => {
                if nm == "p_malloc" {
                    sz = lw_env_size(f, e.id);
                }
            }
            _ => {
            }
        }
        if sz > 0 {
            var target: str = lw_env_target(f, e.id);
            if target != "" {
                match IrModule_get_function(module, target) {
                    OptIrFunction::Some(cf) => {
                        if lw_env_callee_ok(& cf) {
                            out.push(e.id);
                            out.push(sz);
                        }
                    }
                    OptIrFunction::None => {
                    }
                }
            }
        }
        i = i + 1;
    }
}

/// LG6 over every function.
fn lw_stack_envs(module: & mut IrModule) {
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var fentry: IrFunctionEntry = module.functions.get(fi);
        var f: IrFunction = fentry.func;
        // cheap pre-scan: most functions make no call through a closure
        var any: bool = false;
        var k: i64 = 0;
        while k < f.insts.len() && !any {
            match f.insts.get(k).inst {
                Inst::CallPtr(_, _, _, _, _) => {
                    any = true;
                }
                _ => {
                }
            }
            k = k + 1;
        }
        if any {
            var found: Vec<i64> = Vec::new();
            lw_stack_envs_find(module, & f, & mut found);
            if found.len() > 0 {
                var j: i64 = 0;
                while j + 1 < found.len() {
                    IrFunction_set_inst(& mut f, found.get(j), Inst::Alloca(IrType::Array(Box::new(IrType::I64), found.get(j + 1) / 8), Region::Stack));
                    j = j + 2;
                }
                module.functions.set(fi, IrFunctionEntry_new(fentry.name, f));
            }
        }
        fi = fi + 1;
    }
}

// --- LG14: async methods ----------------------------------------------------

// An `async fn` in an impl block (or a trait impl) is split in two before
// lowering: a free async function `<Type>__async__<method>` holding the body,
// with `self` as its first parameter, and the method itself, an ordinary
// function returning that function's future. So an async method runs as a
// task exactly as an async function does (with the same rules for what its
// parameters can be), and a call through `dyn` gets a future too, from
// every implementation. The free function is lowered with `Self` meaning
// the impl's type. Generic impls are left as they are.
const LOWER_ASYNC_METHODS: bool = true;  /// `ty` with `Self` replaced by the named type `sname`.
fn lw_async_self_ty(ty: Type, sname: str) -> Type {
    match ty {
        Type::Named(n) => {
            if n == "Self" {
                return Type::Named(sname);
            }
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(lw_async_self_ty(lw_box_type_unbox(inner), sname)), is_mut);
        }
        Type::Generic(gn, gargs) => {
            var na: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < gargs.len() {
                na.push(lw_async_self_ty(gargs.get(i), sname));
                i = i + 1;
            }
            return Type::Generic(gn, na);
        }
        _ => {
        }
    }
    return ty;
}

/// The name of the free function that holds async method `method` of type
/// `sname`.
fn lw_async_body_name(sname: str, method: str) -> str {
    return sname + "__async__" + method;
}

/// The type an async method's body function is lowered for (`Self`), when
/// `name` is one; "" otherwise.
fn lw_async_body_self(name: str) -> str {
    var at: i64 = str_find(name, "__async__");
    if at <= 0 {
        return "";
    }
    return str_slice(name, 0, at);
}

/// The body function of async method `m` of `sname`.
fn lw_async_body_fn(sname: str, m: Func) -> Func {
    var h: Func = m;
    h.name = lw_async_body_name(sname, m.name);
    var ps: Vec<Param> = Vec::new();
    var i: i64 = 0;
    while i < m.params.len() {
        var p: Param = m.params.get(i);
        p.ty = lw_async_self_ty(p.ty, sname);
        ps.push(p);
        i = i + 1;
    }
    h.params = ps;
    h.ret_ty = lw_async_self_ty(m.ret_ty, sname);
    h.is_async = true;
    return h;
}

/// Method `m` made an ordinary method that returns the future of its body
/// function.
fn lw_async_stub(sname: str, m: Func) -> Func {
    var s: Func = m;
    s.is_async = false;
    var args: Vec<Expr> = Vec::new();
    var i: i64 = 0;
    while i < m.params.len() {
        args.push(Expr::Ident(m.params.get(i).name));
        i = i + 1;
    }
    var body: Vec<Stmt> = Vec::new();
    body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::Call(lw_async_body_name(sname, m.name), args))), 0));
    s.body = body;
    // what the stub checked is checked in the body function
    s.preconditions = Vec::new();
    s.postconditions = Vec::new();
    return s;
}

/// Split one impl's async methods; `kept` says which methods are lowered.
/// Appends the body functions to `funcs`; true when a method changed.
fn lw_async_split_methods(sname: str, methods: Vec<Func>, out: & mut Vec<Func>, funcs: & mut Vec<Func>, trait_impl: bool) -> bool {
    var changed: bool = false;
    var j: i64 = 0;
    while j < methods.len() {
        var m: Func = methods.get(j);
        var kept: bool = trait_impl || lw_keep("impl:" + sname + ":" + m.name);
        if m.is_async && kept {
            funcs.push(lw_async_body_fn(sname, m));
            if g_lower_keep != 0 {
                HashMap_insert(g_lower_keep, "fn:" + lw_async_body_name(sname, m.name), 1);
            }
            out.push(lw_async_stub(sname, m));
            changed = true;
        } else {
            out.push(m);
        }
        j = j + 1;
    }
    return changed;
}

/// LG14 over the program (see LOWER_ASYNC_METHODS).
fn lw_split_async_methods(program: Program) -> Program {
    var p: Program = program;
    var funcs: Vec<Func> = p.funcs;
    var any: bool = false;
    var i: i64 = 0;
    while i < p.impls.len() {
        var imp: ImplDef = p.impls.get(i);
        if imp.type_params.len() == 0 {
            var ms: Vec<Func> = Vec::new();
            if lw_async_split_methods(imp.struct_name, imp.methods, & mut ms, & mut funcs, false) {
                imp.methods = ms;
                p.impls.set(i, imp);
                any = true;
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < p.trait_impls.len() {
        var ti: TraitImpl = p.trait_impls.get(i);
        if ti.type_params.len() == 0 {
            var tms: Vec<Func> = Vec::new();
            if lw_async_split_methods(ti.type_name, ti.methods, & mut tms, & mut funcs, true) {
                ti.methods = tms;
                p.trait_impls.set(i, ti);
                any = true;
            }
        }
        i = i + 1;
    }
    if any {
        p.funcs = funcs;
    }
    return p;
}

// --- B1: one IrModule per source module, and a link table ------------------

// The lowering is whole-program (ownership helpers, layouts and generic
// instances are made for the whole program); its result is cut into one
// IrModule per source module here (inc-roadmap B1), with a link table that
// says which unit defines each function, what each unit exports and
// imports, a content key per unit, and the hash of the layout table every
// unit shares (B2). `ir_units_link` puts the units back together, function
// for function in the original order, so a split and link is the identity.
// The caller says which module each function came from (compiler.fd
// `func_module_of`); FID_IR_UNITS=1 runs split, check and link on the C
// path, FID_IR_UNITS=<dir> also writes each unit (ir_ser format) and the
// table (`link.txt`) there.

/// One source module's part of the lowered program.
pub struct IrUnit {
    pub name: str,
    // its functions, with the whole program's layouts, strings, externs,
    // trait tables and globals
    pub module: IrModule,
    // position of each of its functions in the whole module
    pub positions: Vec<i64>,
    // the functions it defines
    pub exports: Vec<str>,
    // the functions it calls or names that another unit defines
    pub imports: Vec<str>,
    // a hash of the unit's IR (ir_ser bytes)
    pub key: i64,
    // B2: a hash of the layouts its functions use (lw_unit_layout_key):
    // a struct added or changed for another unit leaves it as it was
    pub layout_key: i64,
}

/// The units of a lowered program and what links them.
pub struct IrLinkTable {
    pub units: Vec<IrUnit>,
    // functions in the whole module
    pub count: i64,
    // hash of the struct layout table every unit carries
    pub layout_hash: i64,
    // function name -> its unit's index + 1 (HashMap)
    pub owner: i64,
    // what the split found wrong (a function named twice)
    pub errors: Vec<str>,
}

@wrapping
fn lw_unit_hash(v: Vec<i64>) -> i64 {
    var h: i64 = 1469598103934665603;
    var i: i64 = 0;
    while i < v.len() {
        h = (h ^ v.get(i)) * 1099511628211;
        i = i + 1;
    }
    return h;
}

/// A module with `m`'s tables (not its functions), with indexes of its own.
fn lw_unit_tables(m: & IrModule) -> IrModule {
    var u: IrModule = IrModule_new();
    var i: i64 = 0;
    while i < m.struct_layouts.len() {
        IrModule_add_struct(& mut u, m.struct_layouts.get(i).layout);
        i = i + 1;
    }
    i = 0;
    while i < m.string_constants.len() {
        var se: StringStringEntry = m.string_constants.get(i);
        u.string_constants.push(se);
        HashMap_insert(u.str_index, se.key, u.string_constants.len());
        i = i + 1;
    }
    u.extern_functions = m.extern_functions;
    u.function_effects = m.function_effects;
    u.extern_decls = m.extern_decls;
    u.c_callbacks = m.c_callbacks;
    u.trait_methods = m.trait_methods;
    u.trait_impls = m.trait_impls;
    u.linear_structs = m.linear_structs;
    u.globals = m.globals;
    return u;
}

/// The hash of `m`'s struct layout table.
fn lw_unit_layout_hash(m: & IrModule) -> i64 {
    var lm: IrModule = IrModule_new();
    lm.struct_layouts = m.struct_layouts;
    var h: i64 = lw_unit_hash(ir_module_bytes(& lm, "layouts"));
    HashMap_drop(lm.fn_index);
    HashMap_drop(lm.struct_index);
    HashMap_drop(lm.str_index);
    HashMap_drop(lm.global_index);
    HashMap_drop(lm.effects_index);
    return h;
}

/// B2: the struct names type `t` names (Struct, and Opaque, which lowering
/// resolves to a struct when one has that name), through pointers, arrays
/// and generic arguments.
fn lw_unit_type_structs(t: IrType, out: & mut Vec<str>) {
    match t {
        IrType::Struct(sn) => {
            out.push(sn);
        }
        IrType::Opaque(oname) => {
            out.push(oname);
        }
        IrType::Ptr(inner) => {
            lw_unit_type_structs(box_ir_type_unbox(inner), out);
        }
        IrType::Array(elem, _) => {
            lw_unit_type_structs(box_ir_type_unbox(elem), out);
        }
        IrType::Generic(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                lw_unit_type_structs(args.get(i), out);
                i = i + 1;
            }
        }
        _ => {
        }
    }
}

/// B2: the struct names function `f` uses: the types of its values, its
/// parameters and return, and the types its memory instructions name.
fn lw_unit_fn_structs(f: & IrFunction, out: & mut Vec<str>) {
    var i: i64 = 0;
    while i < f.params.len() {
        lw_unit_type_structs(f.params.get(i).ty, out);
        i = i + 1;
    }
    lw_unit_type_structs(f.ret_ty, out);
    i = 0;
    while i < f.value_metas.len() {
        lw_unit_type_structs(f.value_metas.get(i).meta.ty, out);
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Alloca(at, _) => {
                lw_unit_type_structs(at, out);
            }
            Inst::GetFieldPtr(_, _, ft) => {
                lw_unit_type_structs(ft, out);
            }
            Inst::GetElemPtr(_, _, et) => {
                lw_unit_type_structs(et, out);
            }
            Inst::Load(_, lt) => {
                lw_unit_type_structs(lt, out);
            }
            Inst::Store(_, _, ot) => {
                match ot {
                    OptIrType::Some(st) => {
                        lw_unit_type_structs(st, out);
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

/// Position of struct `name` in `m.struct_layouts`, or -1.
fn lw_unit_layout_at(m: & IrModule, name: str) -> i64 {
    var at: i64 = HashMap_get(m.struct_index, name) - 1;
    if at >= 0 && at < m.struct_layouts.len() && m.struct_layouts.get(at).name == name {
        return at;
    }
    var i: i64 = 0;
    while i < m.struct_layouts.len() {
        if m.struct_layouts.get(i).name == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// B2: the hash of the layouts `names` reach in `m` (closed over the
/// fields of each), in struct_layouts order, as lw_unit_layout_hash hashes
/// the whole table.
fn lw_unit_layout_key(m: & IrModule, names: Vec<str>) -> i64 {
    var used: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < m.struct_layouts.len() {
        used.push(0);
        i = i + 1;
    }
    // layouts marked whose fields are still to scan (positions)
    var todo: Vec<i64> = Vec::new();
    i = 0;
    while i < names.len() {
        var at0: i64 = lw_unit_layout_at(m, names.get(i));
        if at0 >= 0 && used.get(at0) == 0 {
            used.set(at0, 1);
            todo.push(at0);
        }
        i = i + 1;
    }
    var w: i64 = 0;
    while w < todo.len() {
        var fields: Vec<StringIrTypeOffset> = m.struct_layouts.get(todo.get(w)).layout.fields;
        var fnames: Vec<str> = Vec::new();
        var fi: i64 = 0;
        while fi < fields.len() {
            lw_unit_type_structs(fields.get(fi).ty, & mut fnames);
            fi = fi + 1;
        }
        var fj: i64 = 0;
        while fj < fnames.len() {
            var at: i64 = lw_unit_layout_at(m, fnames.get(fj));
            if at >= 0 && used.get(at) == 0 {
                used.set(at, 1);
                todo.push(at);
            }
            fj = fj + 1;
        }
        w = w + 1;
    }
    var lm: IrModule = IrModule_new();
    i = 0;
    while i < m.struct_layouts.len() {
        if used.get(i) != 0 {
            lm.struct_layouts.push(m.struct_layouts.get(i));
        }
        i = i + 1;
    }
    var h: i64 = lw_unit_hash(ir_module_bytes(& lm, "layouts"));
    HashMap_drop(lm.fn_index);
    HashMap_drop(lm.struct_index);
    HashMap_drop(lm.str_index);
    HashMap_drop(lm.global_index);
    HashMap_drop(lm.effects_index);
    return h;
}

/// The functions `f` calls or takes the address of, by name.
fn lw_unit_callees(f: & IrFunction, out: & mut Vec<str>) {
    var i: i64 = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Call(cn, _, _, _) => {
                out.push(cn);
            }
            Inst::ConstFnRef(rn) => {
                out.push(rn);
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

/// Cut `module` into one unit per source module; `unit_of` names the module
/// of each function, in order ("main" past its end).
pub fn ir_units_split(module: & IrModule, unit_of: Vec<str>) -> IrLinkTable {
    var n: i64 = module.functions.len();
    var names: Vec<str> = Vec::new();
    var slot_ix: i64 = HashMap_new();
    var slot_of: Vec<i64> = Vec::new();
    var owner: i64 = HashMap_new();
    var errors: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var un: str = "main";
        if i < unit_of.len() && str_len(unit_of.get(i)) > 0 {
            un = unit_of.get(i);
        }
        var s: i64 = HashMap_get(slot_ix, un) - 1;
        if s < 0 {
            names.push(un);
            s = names.len() - 1;
            HashMap_insert(slot_ix, un, s + 1);
        }
        slot_of.push(s);
        var fname: str = module.functions.get(i).name;
        if HashMap_get(owner, fname) != 0 {
            errors.push("function '" + fname + "' is defined twice (units " + names.get(HashMap_get(owner, fname) - 1) + " and " + un + ")\n    Fix: rename one of the two definitions, or keep it in one unit and `use` that unit from the other.");
        } else {
            HashMap_insert(owner, fname, s + 1);
        }
        i = i + 1;
    }
    HashMap_drop(slot_ix);
    var units: Vec<IrUnit> = Vec::new();
    var s2: i64 = 0;
    while s2 < names.len() {
        var um: IrModule = lw_unit_tables(module);
        var fns: Vec<IrFunctionEntry> = Vec::new();
        var positions: Vec<i64> = Vec::new();
        var exports: Vec<str> = Vec::new();
        var imports: Vec<str> = Vec::new();
        var seen: i64 = HashMap_new();
        // B2: the struct names the unit's functions use (lw_unit_layout_key)
        var unit_structs: Vec<str> = Vec::new();
        var k: i64 = 0;
        while k < n {
            if slot_of.get(k) == s2 {
                var fe: IrFunctionEntry = module.functions.get(k);
                fns.push(fe);
                positions.push(k);
                exports.push(fe.name);
                lw_unit_fn_structs(& fe.func, & mut unit_structs);
                var callees: Vec<str> = Vec::new();
                lw_unit_callees(& fe.func, & mut callees);
                var c: i64 = 0;
                while c < callees.len() {
                    var cn: str = callees.get(c);
                    var cu: i64 = HashMap_get(owner, cn);
                    if cu != 0 && cu - 1 != s2 && HashMap_get(seen, cn) == 0 {
                        HashMap_insert(seen, cn, 1);
                        imports.push(cn);
                    }
                    c = c + 1;
                }
            }
            k = k + 1;
        }
        HashMap_drop(seen);
        um.functions = fns;
        var key: i64 = lw_unit_hash(ir_module_bytes(& um, names.get(s2)));
        var layout_key: i64 = lw_unit_layout_key(module, unit_structs);
        units.push(IrUnit {
            name: names.get(s2), module: um, positions: positions, exports: exports, imports: imports, key: key, layout_key: layout_key
        });
        s2 = s2 + 1;
    }
    return IrLinkTable {
        units: units, count: n, layout_hash: lw_unit_layout_hash(module), owner: owner, errors: errors
    };
}

/// What is wrong with `t`: the split's errors, an import no unit defines,
/// a unit whose layout table differs from the others', a function lost.
pub fn ir_units_check(t: & IrLinkTable) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < t.errors.len() {
        errs.push(t.errors.get(i));
        i = i + 1;
    }
    var total: i64 = 0;
    var u: i64 = 0;
    while u < t.units.len() {
        var un: IrUnit = t.units.get(u);
        total = total + un.module.functions.len();
        var j: i64 = 0;
        while j < un.imports.len() {
            if HashMap_get(t.owner, un.imports.get(j)) == 0 {
                errs.push("unit " + un.name + " imports '" + un.imports.get(j) + "', which no unit defines");
            }
            j = j + 1;
        }
        if lw_unit_layout_hash(& un.module) != t.layout_hash {
            errs.push("unit " + un.name + " has a layout table of its own");
        }
        u = u + 1;
    }
    if total != t.count {
        errs.push("the units hold " + int_to_str(total) + " functions, the module " + int_to_str(t.count));
    }
    return errs;
}

/// The whole module again: every unit's functions at their positions, with
/// the first unit's tables.
pub fn ir_units_link(t: & IrLinkTable) -> IrModule {
    if t.units.len() == 0 {
        return IrModule_new();
    }
    var u0: IrUnit = t.units.get(0);
    var m: IrModule = lw_unit_tables(& u0.module);
    var unit_at: Vec<i64> = Vec::new();
    var idx_at: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < t.count {
        unit_at.push(- 1);
        idx_at.push(- 1);
        i = i + 1;
    }
    var u: i64 = 0;
    while u < t.units.len() {
        var ps: Vec<i64> = t.units.get(u).positions;
        var k: i64 = 0;
        while k < ps.len() {
            var p: i64 = ps.get(k);
            if p >= 0 && p < t.count {
                unit_at.set(p, u);
                idx_at.set(p, k);
            }
            k = k + 1;
        }
        u = u + 1;
    }
    var fns: Vec<IrFunctionEntry> = Vec::new();
    i = 0;
    while i < t.count {
        if unit_at.get(i) >= 0 {
            fns.push(t.units.get(unit_at.get(i)).module.functions.get(idx_at.get(i)));
        }
        i = i + 1;
    }
    m.functions = fns;
    HashMap_clear(m.fn_index);
    return m;
}

/// The link table as text: one line per unit (name, key, functions,
/// imports), then the layout hash.
pub fn ir_units_table_text(t: & IrLinkTable) -> str {
    var sb: StringBuilder = StringBuilder::new();
    var u: i64 = 0;
    while u < t.units.len() {
        var un: IrUnit = t.units.get(u);
        sb.append_str("unit " + un.name + " key " + int_to_str(un.key) + " functions " + int_to_str(un.exports.len()) + " imports");
        var j: i64 = 0;
        while j < un.imports.len() {
            sb.append_str(" " + un.imports.get(j));
            j = j + 1;
        }
        sb.append_str("\n");
        u = u + 1;
    }
    // B2: each unit's own layout key, then the whole table's hash (the
    // cross-unit consistency check, ir_units_check)
    u = 0;
    while u < t.units.len() {
        var lu: IrUnit = t.units.get(u);
        sb.append_str("layouts " + lu.name + " " + int_to_str(lu.layout_key) + "\n");
        u = u + 1;
    }
    sb.append_str("layouts " + int_to_str(t.layout_hash) + "\n");
    return sb.to_str();
}

/// FID_IR_UNITS: split `module` (`unit_of` as for ir_units_split), report
/// what ir_units_check finds, write the units and the table to `dir` when
/// it is not "1", and give the linked module back.
pub fn ir_units_roundtrip(module: IrModule, unit_of: Vec<str>, dir: str) -> IrModule {
    var t: IrLinkTable = ir_units_split(& module, unit_of);
    var errs: Vec<str> = ir_units_check(& t);
    var i: i64 = 0;
    while i < errs.len() {
        p_eprint_str("[ir-units] " + errs.get(i) + "\n");
        i = i + 1;
    }
    if str_len(dir) > 0 && dir != "1" {
        var u: i64 = 0;
        while u < t.units.len() {
            var un: IrUnit = t.units.get(u);
            var path: str = dir + "/" + int_to_str(u) + "_" + lw_unit_file_name(un.name) + ".fir";
            ir_module_save(path, & un.module, un.name);
            u = u + 1;
        }
        p_file_write(dir + "/link.txt", ir_units_table_text(& t));
    }
    p_eprint_str("[ir-units] " + int_to_str(t.units.len()) + " units, " + int_to_str(t.count) + " functions, " + int_to_str(errs.len()) + " problems\n");
    var linked: IrModule = ir_units_link(& t);
    HashMap_drop(t.owner);
    return linked;
}

/// A module name as a file name (`compiler::lexer` -> `compiler_lexer`).
fn lw_unit_file_name(name: str) -> str {
    var sb: StringBuilder = StringBuilder::new();
    var i: i64 = 0;
    while i < str_len(name) {
        var c: i64 = str_byte_at(name, i);
        var ok: bool = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 45;
        if ok {
            sb.append_str(str_slice(name, i, i + 1));
        } else {
            sb.append_str("_");
        }
        i = i + 1;
    }
    return sb.to_str();
}
