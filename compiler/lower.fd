    Lowerer_add_extern_1(self, "p_vec_clone", IrType::I64, IrType::I64);
    Lowerer_add_extern_2(self, "p_vec_resize", IrType::I64, IrType::I64, IrType::Void);
    Lowerer_add_extern_1(self, "p_vec_new_with", IrType::I64, IrType::I64);
