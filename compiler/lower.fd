/// A txn { } being lowered: a snapshot of each live local, restored by
/// `abort;`, which then jumps to `end_block`. `owned[i]`: the local owns
/// its value (the snapshot took an owner and is dropped on commit);
/// otherwise both copies are raw words or bytes. `mark`: own_slots at
/// entry, so abort drops what the body declared.
pub struct LwTxn {
    pub slots: Vec<i64>,
    pub snaps: Vec<i64>,
    pub tys: Vec<Type>,
    pub irtys: Vec<IrType>,
    pub aggs: Vec<bool>,
    pub owned: Vec<bool>,
    pub end_block: i64,
    pub mark: i64,
}

// Loop context: (continue_target, break_target, result_slot)
pub struct LoopContext {
    pub continue_target: i64,
    pub break_target: i64,
    pub result_slot: OptValueId,
}

pub fn LoopContext_new(continue_target: i64, break_target: i64, result_slot: OptValueId) -> LoopContext {
    return LoopContext {
        continue_target: continue_target, break_target: break_target, result_slot: result_slot,
    };
}

// Try context: (error_block, error_result_slot)
pub struct TryContext {
    pub error_block: i64,
    pub error_result_slot: i64,
}

pub fn TryContext_new(error_block: i64, error_result_slot: i64) -> TryContext {
    return TryContext {
        error_block: error_block, error_result_slot: error_result_slot,
    };
}

// A `defer` statement of the function being lowered (reference §5.5): its
// block, the entry-block slot that says whether the statement ran (1) or not
// (0), and its line (the copies a loop unrolled at compile time makes of a
// statement have the same one, and are the same statement). flag -1 and line
// -1: the block always runs (the audit exit log).
// BG198: the names the block reads, bound as at the `defer` statement
// (Lowerer_defer_capture): each one's slot (or -1), the slot's IR type, the
// variable's AST type, the parameter value of a parameter (or -1), and for
// a variable dropped before the function ends, the entry-block slot `keep`
// that holds its value until the block ran (or -1) and its owned type.
pub struct DeferEntry {
    pub body: Vec<Stmt>,
    pub flag: i64,
    pub line: i64,
    pub names: Vec<str>,
    pub slots: Vec<i64>,
    pub irtys: Vec<IrType>,
    pub asts: Vec<Type>,
    pub params: Vec<i64>,
    pub keeps: Vec<i64>,
    pub otys: Vec<Type>,
}

pub fn DeferEntry_new(body: Vec<Stmt>, flag: i64, line: i64) -> DeferEntry {
    return DeferEntry {
        body: body, flag: flag, line: line, names: Vec::new(), slots: Vec::new(), irtys: Vec::new(), asts: Vec::new(), params: Vec::new(), keeps: Vec::new(), otys: Vec::new(),
    };
}

// Closure capture: (name, env_field_index, type)
pub struct ClosureCapture {
    pub name: str,
    pub field_index: i64,
    pub ty: Type,
}

pub fn ClosureCapture_new(name: str, field_index: i64, ty: Type) -> ClosureCapture {
    return ClosureCapture {
        name: name, field_index: field_index, ty: ty
    };
}

