// lower.fd - AST - Fides IR lowering pass, rewritten from src/lower.rs (6198 LOC)
//
// This module lowers the typed AST into Fides IR (SSA form).
// It handles:
// - Function lowering with basic blocks and control flow
// - Expression lowering to SSA values
// - Statement lowering with proper block management
// - Struct layout computation
// - Effect propagation
//
// Adaptations from Rust:
// 1. HashMap<K,V> - Vec-based maps with helper structs (Fides HashMap is i64-i64)
// 2. HashSet<T> - Vec<T> with contains() helper
// 3. String - str, usize/u32/u64 - i64
// 4. Option<T> - Opt* enums
// 5. Box<Type>/Box<Expr> - box_* helper functions for recursive calls
// 6. &mut self methods - self: &mut Lowerer
// 7. format! - string concatenation with int_to_str/type_to_str
// 8. .clone() - not needed (Fides values are copied by value)
// 9. matches! macro - explicit match with _ => false
// 10. Option::map/and_then - explicit match
// 11. String::starts_with - str_starts_with
// 12. Vec::iter().map().collect() - explicit while loops with Vec::push
//
// Dependencies: compiler::ast, compiler::ir

module compiler::lower; use core; use vec; use string; use compiler::ast; use compiler::ir_ser; use compiler::cowcheck; use compiler::ir; use compiler::pe_ir; use compiler::pgo;  // --- Box unbox helpers ---------------------------------------------------

pub fn lw_box_type_unbox(b: Box<Type>) -> Type {
    match b {
        Type::I8 => {
            return Type::I8;
        }
        Type::I16 => {
            return Type::I16;
        }
        Type::I32 => {
            return Type::I32;
        }
        Type::I64 => {
            return Type::I64;
        }
        Type::I128 => {
            return Type::I128;
        }
        Type::U8 => {
            return Type::U8;
        }
        Type::U16 => {
            return Type::U16;
        }
        Type::U32 => {
            return Type::U32;
        }
        Type::U64 => {
            return Type::U64;
        }
        Type::U128 => {
            return Type::U128;
        }
        Type::F32 => {
            return Type::F32;
        }
        Type::F64 => {
            return Type::F64;
        }
        Type::Bool => {
            return Type::Bool;
        }
        Type::Str => {
            return Type::Str;
        }
        Type::Void => {
            return Type::Void;
        }
        Type::Never => {
            return Type::Never;
        }
        Type::Infer => {
            return Type::Infer;
        }
        Type::Named(n) => {
            return Type::Named(n);
        }
        Type::Array(e, s) => {
            return Type::Array(e, s);
        }
        Type::ArrayConst(e, s) => {
            return Type::ArrayConst(e, s);
        }
        Type::Ref(e, m) => {
            return Type::Ref(e, m);
        }
        Type::RawPtr(e, m) => {
            return Type::RawPtr(e, m);
        }
        Type::Generic(n, a) => {
            return Type::Generic(n, a);
        }
        Type::Tuple(a) => {
            return Type::Tuple(a);
        }
        Type::Func(a, r) => {
            return Type::Func(a, r);
        }
        Type::Assoc(a, b, c, d) => {
            return Type::Assoc(a, b, c, d);
        }
        Type::Dyn(n) => {
            return Type::Dyn(n);
        }
        Type::ShapedTensor(e, d) => {
            return Type::ShapedTensor(e, d);
        }
    }
    return Type::Void;
}

pub fn lw_box_expr_unbox(b: Box<Expr>) -> Expr {
    match b {
        Expr::IntLit(v) => {
            return Expr::IntLit(v);
        }
        Expr::FloatLit(v) => {
            return Expr::FloatLit(v);
        }
        Expr::StringLit(v) => {
            return Expr::StringLit(v);
        }
        Expr::BoolLit(v) => {
            return Expr::BoolLit(v);
        }
        Expr::Ident(n) => {
            return Expr::Ident(n);
        }
        Expr::Binary(op, l, r) => {
            return Expr::Binary(op, l, r);
        }
        Expr::Unary(op, e) => {
            return Expr::Unary(op, e);
        }
        Expr::Call(n, a) => {
            return Expr::Call(n, a);
        }
        Expr::FieldAccess(e, f) => {
            return Expr::FieldAccess(e, f);
        }
        Expr::OptionalFieldAccess(e, f) => {
            return Expr::OptionalFieldAccess(e, f);
        }
        Expr::StructLit(n, f, s) => {
            return Expr::StructLit(n, f, s);
        }
        Expr::If(c, t, e) => {
            return Expr::If(c, t, e);
        }
        Expr::Range(a, b, i) => {
            return Expr::Range(a, b, i);
        }
        Expr::Block(s) => {
            return Expr::Block(s);
        }
        Expr::MethodCall(r, m, a) => {
            return Expr::MethodCall(r, m, a);
        }
        Expr::ArrayLit(e, a) => {
            return Expr::ArrayLit(e, a);
        }
        Expr::Index(a, i) => {
            return Expr::Index(a, i);
        }
        Expr::FString(p) => {
            return Expr::FString(p);
        }
        Expr::Match(e, a) => {
            return Expr::Match(e, a);
        }
        Expr::EnumLit(en, v, a) => {
            return Expr::EnumLit(en, v, a);
        }
        Expr::Ref(e, m) => {
            return Expr::Ref(e, m);
        }
        Expr::Deref(e) => {
            return Expr::Deref(e);
        }
        Expr::StrConcat(l, r) => {
            return Expr::StrConcat(l, r);
        }
        Expr::Try(e) => {
            return Expr::Try(e);
        }
        Expr::Coalesce(l, r) => {
            return Expr::Coalesce(l, r);
        }
        Expr::IsCheck(e, n) => {
            return Expr::IsCheck(e, n);
        }
        Expr::TryBlock(s) => {
            return Expr::TryBlock(s);
        }
        Expr::TupleLit(e) => {
            return Expr::TupleLit(e);
        }
        Expr::Closure(p, b, r) => {
            return Expr::Closure(p, b, r);
        }
        Expr::Cast(e, ty) => {
            return Expr::Cast(e, ty);
        }
        Expr::Asm(s, o) => {
            return Expr::Asm(s, o);
        }
        Expr::Comptime(e) => {
            return Expr::Comptime(e);
        }
        Expr::ComptimeBlock(s) => {
            return Expr::ComptimeBlock(s);
        }
        Expr::ComptimeReflect(n, a) => {
            return Expr::ComptimeReflect(n, a);
        }
        Expr::PipeForward(l, r) => {
            return Expr::PipeForward(l, r);
        }
        Expr::QuantCast(e, ty) => {
            return Expr::QuantCast(e, ty);
        }
        Expr::Await(e) => {
            return Expr::Await(e);
        }
        Expr::Spawn(e) => {
            return Expr::Spawn(e);
        }
        Expr::Yield(e) => {
            return Expr::Yield(e);
        }
        Expr::NamedArg(name, e) => {
            return Expr::NamedArg(name, e);
        }
    }
    return Expr::IntLit(0);
}

