                                        var bty: IrType = Lowerer_rc_mem_ir(self, fast);
                                        var bsize: i64 = IrModule_type_size(& self.module, bty);
                                        if bsize < 8 {
                                            bsize = 8;
                                        }
                                        var bsz: i64 = Lowerer_emit_inst(self, Inst::ConstInt(bsize, IrType::I64));
                                        var bheap: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(bsz), IrType::Ptr(Box::new(bty)), EffectSet_new()));
                                        var bsrc: i64 = Lowerer_rc_tuple_ptr(self, fval, fast);
                                        var bvt: IrType = Lowerer_get_value_type(self, bsrc);
                                        match bvt {
                                            IrType::Ptr(_) => {
                                            }
                                            _ => {
                                                bsrc = Lowerer_emit_inst(self, Inst::BitCast(bsrc, bvt, IrType::Ptr(Box::new(bty))));
                                            }
                                        }
                                        Lowerer_emit_inst(self, Inst::Store(bheap, bsrc, OptIrType::Some(bty)));
                                        Lowerer_rc_gen_param_payload(self, Lowerer_rc_as_i64(self, field_ptr), 0, fast, false);
                                        var _sb: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, Lowerer_rc_as_i64(self, bheap), OptIrType::None));
                                        return;
                                    }
                                    // a tuple or a generic instance field is
                                    // held inline: the value's address
                                    fval = Lowerer_held_addr(self, fval, field_ty);
                                    if f_tparam {
                                        fval = Lowerer_f64_word_bits(self, fval);
                                    }
                                    // BG369: a `[T; N]` field keeps a heap
                                    // copy of the array assigned to it, as a
                                    // struct literal's (the address of the
                                    // variable's stack data was kept)
                                    match field_ty {
                                        IrType::Array(_, _) => {
                                            if lw_ir_is_array_val(Lowerer_get_value_type(self, fval)) {
                                                fval = Lowerer_arr_heap_copy(self, fval, field_ty);
                                            }
                                        }
                                        _ => {
                                        }
                                    }
                                    var fold: i64 = - 1;
                                    if fk == RC_MEM {
                                        Lowerer_rc_call_mem(self, "__own_drop_", field_ptr, fast);
                                    } else if fk != RC_NONE {
                                        fold = Lowerer_emit_inst(self, Inst::Load(field_ptr, field_ty));
                                    }
                                    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, fval, OptIrType::None));
                                    if fold >= 0 {
                                        Lowerer_rc_drop(self, fold, fast);
                                    }
                                }
                                _ => {
                                    var current: i64 = Lowerer_emit_inst(self, Inst::Load(field_ptr, field_ty));
                                    // BG145: an f64 type-parameter field's
                                    // word is the number's bits
                                    var f_bits: bool = false;
                                    if f_tparam {
                                        match Lowerer_lower_type(self, Lowerer_infer_expr_ast_type(self, Expr::FieldAccess(Box::new(object), field))) {
                                            IrType::F64 => {
                                                f_bits = true;
                                                current = Lowerer_emit_inst(self, Inst::Call("p_f64_from_bits", lw_c_vec1_i64(current), IrType::F64, EffectSet_new()));
                                            }
                                            // BG270: an f32 field's word is
                                            // its f64's bits as well
                                            IrType::F32 => {
                                                f_bits = true;
                                                current = Lowerer_emit_inst(self, Inst::Call("p_f64_from_bits", lw_c_vec1_i64(current), IrType::F64, EffectSet_new()));
                                                current = Lowerer_lower_cast(self, current, IrType::F64, IrType::F32);
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                    var rhs: i64 = Lowerer_lower_expr(self, expr);
                                    var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                                    if f_bits {
                                        new_val = Lowerer_f64_word_bits(self, new_val);
                                    }
                                    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, new_val, OptIrType::None));
                                    // (BG30: claimed whatever the field's
                                    // type, so the field never keeps a string
                                    // the statement's end frees)
                                    if Lowerer_rc_claim(self, new_val) && fk == RC_STR {
                                        Lowerer_rc_drop(self, current, fast);
                                    }
                                }
                            }
                        }
                    }
                    OptStructLayout::None => {
                    }
                }
            }
        }
        Stmt::Unsafe(body, _line) => {
            // F62: emit UnsafeBegin/UnsafeEnd so interpreter can skip bounds checks
            var _ub: i64 = Lowerer_emit_inst(self, Inst::UnsafeBegin);
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            if !Lowerer_current_block_has_terminator(self) {
                var _ue: i64 = Lowerer_emit_inst(self, Inst::UnsafeEnd);
            }
        }
        Stmt::RegionBlock(name, _budget, is_gpu, is_kv_cache, _window_size, body, _line) => {
            // Emit RegionBegin, push region, lower body, pop, emit RegionEnd
            var _rb: i64 = Lowerer_emit_inst(self, Inst::RegionBegin(name, is_gpu, is_kv_cache, OptU64::None));
            // An arena of its own (proposal 0005): its variables are a
            // scope, dropped before the arena goes
            var arena: bool = self.rg_on && self.own_on && !is_gpu && !is_kv_cache && !lw_rg_suspends(body);
            if arena {
                // `with budget(N)`: the arena's first chunk is sized for it
                var first: i64 = 0;
                match _budget {
                    OptI64::Some(bn) => {
                        first = bn;
                    }
                    OptI64::None => {
                    }
                }
                Lowerer_rg_call(self, 7, first);
                self.rg_fns.push(self.current_func.name);
                self.rg_ids.push(_rb);
                Lowerer_rc_scope_open(self);
            }
            self.region_stack.push(name);
            if is_gpu {
                self.gpu_region_stack.push(name);
            }
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            self.region_stack.pop();
            if is_gpu {
                self.gpu_region_stack.pop();
            }
            if arena {
                Lowerer_rc_scope_close(self);
                self.rg_fns.pop();
                self.rg_ids.pop();
            }
            if !Lowerer_current_block_has_terminator(self) {
                var _re: i64 = Lowerer_emit_inst(self, Inst::RegionEnd(name, is_gpu, is_kv_cache));
                if arena {
                    Lowerer_rg_call(self, 8, 0);
                }
            }
        }
        Stmt::Sandbox(body, _line) => {
            // Roadmap Phase 12: p_sandbox_enter/exit around the body (run-time
            // revocation in the interpreter); see Lowerer_lower_sandbox
            Lowerer_lower_sandbox(self, body);
        }
        Stmt::Txn(body, _line) => {
            // Every live local is snapshotted; `abort;` puts them back and
            // leaves the block, the normal end drops the snapshots (commit).
            // Same lowering for every backend: TxnBegin/TxnEnd only matter
            // to the interpreter.
            var tx: LwTxn = Lowerer_txn_open(self);
            var _tb: i64 = Lowerer_emit_inst(self, Inst::TxnBegin);
            self.txn_stack.push(tx);
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            self.txn_stack.pop();
            if !Lowerer_current_block_has_terminator(self) {
                var _te: i64 = Lowerer_emit_inst(self, Inst::TxnEnd);
            }
            Lowerer_rc_scope_close(self);
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(tx.end_block));
            }
            Lowerer_set_current_block(self, tx.end_block);
        }
        Stmt::ComptimeGen(_body, _line) => {  // Comptime gen blocks are processed before lowering - no-op here
        }
        Stmt::GradBlock(var_name, body, _line) => {
            var _gb: i64 = Lowerer_emit_inst(self, Inst::GradBegin(var_name));
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            if !Lowerer_current_block_has_terminator(self) {
                var _ge: i64 = Lowerer_emit_inst(self, Inst::GradEnd);
            }
        }
        Stmt::Backward(loss_expr, _line) => {
            var loss_val: i64 = Lowerer_lower_expr(self, loss_expr);
            var _b: i64 = Lowerer_emit_inst(self, Inst::Backward(loss_val));
        }
        Stmt::Query(_names, body, _line) => {
            // Query blocks lower as regular statements
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
        }
        Stmt::Select(cases, default, _line) => {
            Lowerer_lower_select_stmt(self, cases, default, _line);
        }
        Stmt::Parallel(branches, _line) => {
            // F13: parallel { | branch1 | branch2 | ... }
            // Fork-join parallelism: spawn each branch as a thread, then join all.
            // A branch that is one call is spawned as it is; `x = f(..)` is
            // spawned and x takes the result at the join; any other branch
            // runs as a function of its own (release H7) when it reads only
            // word-sized locals and assigns none of them. The rest run in
            // order on this thread. All threads are joined before continuing.
            var thread_handles: Vec<i64> = Vec::new();
            var result_handles: Vec<i64> = Vec::new();
            var result_slots: Vec<i64> = Vec::new();
            // BG99: whether the slot owns a string (its old one is dropped
            // when it takes the result)
            var result_drops: Vec<bool> = Vec::new();
            var result_tys: Vec<IrType> = Vec::new();
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                // Check if branch is a single expression statement that is a call
                var spawned: bool = false;
                if branch.len() == 1 {
                    match branch.get(0) {
                        Stmt::Expr(e, _l) => {
                            match e {
                                Expr::Call(callee, args0) => {
                                    // BG388: named arguments and defaults
                                    // resolved, as for a call
                                    var bargs: Vec<Expr> = Lowerer_resolve_call_args(self, callee, args0);
                                    // Spawn: p_thread_spawn(func_name, num_args, args...)
                                    // (a task block holds 8 argument words: a
                                    // call with more runs in place)
                                    if bargs.len() <= 8 {
                                        var pvals: Vec<i64> = Vec::new();
                                        var ai: i64 = 0;
                                        while ai < bargs.len() {
                                            pvals.push(Lowerer_lower_expr(self, bargs.get(ai)));
                                            ai = ai + 1;
                                        }
                                        var handle: i64 = Lowerer_spawn_call(self, callee, bargs, pvals);
                                        thread_handles.push(handle);
                                        spawned = true;
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                        Stmt::Assign(target, aop, rhs, _al) => {
                            var plain: bool = false;
                            match aop {
                                AssignOp::Assign => {
                                    plain = true;
                                }
                                _ => {
                                }
                            }
                            var slot: i64 = - 1;
                            var slot_ty: IrType = IrType::I64;
                            match Lowerer_lookup_alloca(self, target) {
                                OptValueId::Some(a) => {
                                    match Lowerer_lookup_alloca_type(self, a) {
                                        OptIrType::Some(aty) => {
                                            if lw_par_word(aty) {
                                                slot = a;
                                                slot_ty = aty;
                                            }
                                        }
                                        OptIrType::None => {
                                        }
                                    }
                                }
                                OptValueId::None => {
                                }
                            }
                            // BG99: a string variable that owns its value
                            // drops the old one when it takes the new
                            var par_drop: bool = slot >= 0 && self.own_on && Lowerer_rc_owns_slot(self, slot) && Lowerer_rc_kind(self, Lowerer_rc_var_type(self, target)) == RC_STR;
                            match rhs {
                                Expr::Call(acallee, aargs0) => {
                                    // BG388: named arguments and defaults
                                    // resolved, as for a call
                                    var aargs: Vec<Expr> = Lowerer_resolve_call_args(self, acallee, aargs0);
                                    if plain && slot >= 0 && aargs.len() <= 8 && Lowerer_is_user_func(self, acallee) && !Lowerer_is_async_func(self, acallee) {
                                        var avals: Vec<i64> = Vec::new();
                                        var words: bool = true;
                                        var aai: i64 = 0;
                                        while aai < aargs.len() {
                                            var av: i64 = Lowerer_lower_expr(self, aargs.get(aai));
                                            if !lw_par_word(Lowerer_get_value_type(self, av)) {
                                                words = false;
                                            }
                                            avals.push(av);
                                            aai = aai + 1;
                                        }
                                        if words && lw_par_word(Lowerer_lookup_func_ret_ty_ir(self, acallee)) {
                                            var rh: i64 = Lowerer_spawn_call(self, acallee, aargs, avals);
                                            result_handles.push(rh);
                                            result_slots.push(slot);
                                            result_drops.push(par_drop);
                                            result_tys.push(slot_ty);
                                            spawned = true;
                                        } else {
                                            // The arguments are already evaluated: finish the call here
                                            var cargs: Vec<i64> = Vec::new();
                                            cargs.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
                                            aai = 0;
                                            while aai < avals.len() {
                                                cargs.push(avals.get(aai));
                                                aai = aai + 1;
                                            }
                                            var cv: i64 = Lowerer_emit_inst(self, Inst::Call(acallee, cargs, Lowerer_lookup_func_ret_ty_ir(self, acallee), EffectSet_new()));
                                            // BG99: the variable keeps the call's
                                            // string (a temporary of the statement,
                                            // freed at its end) and drops its old one
                                            var cv_kept: bool = Lowerer_rc_claim(self, cv);
                                            var cold: i64 = - 1;
                                            if par_drop && cv_kept {
                                                cold = Lowerer_emit_inst(self, Inst::Load(slot, slot_ty));
                                            }
                                            Lowerer_emit_inst(self, Inst::Store(slot, cv, OptIrType::None));
                                            if cold >= 0 {
                                                Lowerer_rc_drop(self, cold, Type::Str);
                                            }
                                            spawned = true;
                                        }
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                if !spawned {
                    var lifted: i64 = Lowerer_lift_parallel_branch(self, branch);
                    if lifted >= 0 {
                        thread_handles.push(lifted);
                        spawned = true;
                    }
                }
                if !spawned {
                    // Complex branch — execute sequentially
                    var si: i64 = 0;
                    while si < branch.len() {
                        Lowerer_lower_stmt(self, branch.get(si));
                        si = si + 1;
                    }
                }
                bi = bi + 1;
            }
            // Join all spawned threads
            var ji: i64 = 0;
            while ji < thread_handles.len() {
                var join_args: Vec<i64> = Vec::new();
                join_args.push(thread_handles.get(ji));
                // p_future_poll waits for the thread on every backend (the
                // native runtime has no p_thread_join)
                var _v: i64 = Lowerer_emit_inst(self, Inst::Call("p_future_poll", join_args, IrType::I64, EffectSet_new()));
                ji = ji + 1;
            }
            // `x = f(..)` branches: wait for each result and store it
            var ri: i64 = 0;
            while ri < result_handles.len() {
                var poll_args: Vec<i64> = Vec::new();
                poll_args.push(result_handles.get(ri));
                var rv: i64 = Lowerer_emit_inst(self, Inst::Call("p_future_poll", poll_args, IrType::I64, EffectSet_new()));
                // BG99: the task's result is the variable's own (its
                // `return` took an owner); the old string is dropped
                var rold: i64 = - 1;
                if result_drops.get(ri) {
                    rold = Lowerer_emit_inst(self, Inst::Load(result_slots.get(ri), result_tys.get(ri)));
                }
                Lowerer_emit_inst(self, Inst::Store(result_slots.get(ri), rv, OptIrType::None));
                if rold >= 0 {
                    Lowerer_rc_drop(self, rold, Type::Str);
                }
                ri = ri + 1;
            }
        }
        Stmt::Handle(body, handlers, _line) => {
            // Effect handler: lower the body. When a `do Effect.op(args)` is
            // encountered inside, the matching handler is called.
            // Store handlers in a stack so Do statements can find them.
            self.effect_handler_stack.push(handlers);
            // a `do` below the block's own level may end the block early
            // (Lowerer_hx_abort): it jumps to hx_exit
            var hx_exit: i64 = - 1;
            if lw_hx_nested_do(body, true) {
                hx_exit = Lowerer_new_block(self);
            }
            g_lw_hx_fn.push(self.current_func.name);
            g_lw_hx_exit.push(hx_exit);
            g_lw_hx_slots.push(self.own_slots.len());
            g_lw_hx_temps.push(self.own_temps.len());
            g_lw_hx_rg.push(Lowerer_rg_open(self));
            g_lw_hx_to.push(self.to_toks.len());
            var hslot: i64 = Lowerer_handle_target(self);
            var has_do_in: bool = false;
            var hi: i64 = 0;
            while hi < body.len() {
                match body.get(hi) {
                    Stmt::Do(_, _, _, _) => {
                        has_do_in = true;
                    }
                    _ => {
                    }
                }
                hi = hi + 1;
            }
            var stored: bool = false;
            if hslot >= 0 && !has_do_in && body.len() > 0 {
                match body.get(body.len() - 1) {
                    Stmt::Expr(last, _) => {
                        var rest: Vec<Stmt> = Vec::new();
                        hi = 0;
                        while hi + 1 < body.len() {
                            rest.push(body.get(hi));
                            hi = hi + 1;
                        }
                        g_lw_hx_direct_next = true;
                        Lowerer_lower_stmts(self, rest);
                        var hval: i64 = Lowerer_lower_expr(self, last);
                        Lowerer_emit_inst(self, Inst::Store(hslot, hval, OptIrType::None));
                        stored = true;
                    }
                    _ => {
                    }
                }
            }
            if !stored {
                g_lw_hx_direct_next = true;
                Lowerer_lower_stmts(self, body);
            }
            g_lw_hx_direct_next = false;
            if hx_exit >= 0 {
                if !Lowerer_current_block_has_terminator(self) {
                    Lowerer_emit_terminator(self, Inst::Jump(hx_exit));
                }
                Lowerer_set_current_block(self, hx_exit);
            }
            g_lw_hx_fn.pop();
            g_lw_hx_exit.pop();
            g_lw_hx_slots.pop();
            g_lw_hx_temps.pop();
            g_lw_hx_rg.pop();
            g_lw_hx_to.pop();
            self.effect_handler_stack.pop();
        }
        Stmt::Do(effect, op, args, _line) => {
            // Look up the handler for this effect.op
            var handler_idx: i64 = - 1;
            var stack_idx: i64 = self.effect_handler_stack.len() - 1;
            while stack_idx >= 0 {
                var handlers: Vec<EffectHandler> = self.effect_handler_stack.get(stack_idx);
                var hi: i64 = 0;
                while hi < handlers.len() {
                    var h: EffectHandler = handlers.get(hi);
                    if h.effect == effect && h.op == op {
                        handler_idx = hi;
                        // Found - bind args to params and lower body
                        var ai: i64 = 0;
                        while ai < args.len() {
                            if ai < h.params.len() {
                                var arg_val: i64 = Lowerer_lower_expr(self, args.get(ai));
                                var slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
                                Lowerer_insert_alloca_type(self, slot, IrType::I64);
                                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(slot, arg_val, OptIrType::None));
                                Lowerer_insert_alloca(self, h.params.get(ai), slot);
                                Lowerer_bind_local(self, h.params.get(ai), slot);
                            }
                            ai = ai + 1;
                        }
                        Lowerer_lower_stmts(self, h.body);
                        // no continuation was captured here: a handler that
                        // does not resume ends the handle block
                        Lowerer_hx_abort(self, stack_idx, h.body);
                        // Done - break out of both loops
                        stack_idx = - 1;
                        hi = handlers.len();
                    }
                    hi = hi + 1;
                }
                if handler_idx >= 0 {
                    // Already handled - break
                    stack_idx = - 1;
                } else {
                    stack_idx = stack_idx - 1;
                }
            }
            if handler_idx < 0 {
                // No handler found - just lower the args (no-op)
                var ai2: i64 = 0;
                while ai2 < args.len() {
                    var _v: i64 = Lowerer_lower_expr(self, args.get(ai2));
                    ai2 = ai2 + 1;
                }
            }
        }
        Stmt::Use(_path, _items, _line) => {  // Use statements are resolved at import time - no-op in lowering
        }
        Stmt::Resume(cont, value, _line) => {
            // L3A: resume(cont, value) — call the continuation closure.
            // Closure ABI: (env: *u8, value: i64) -> i64; CallPtr passes the
            // env pointer as first arg automatically (has_env = true).
            // BG197: or the rest of the handle block lowered here
            if Lowerer_hx_resume_inline(self, cont, value) {
                return;
            }
            var cont_val: i64 = Lowerer_lower_expr(self, cont);
            var value_val: i64 = Lowerer_lower_expr(self, value);
            var rslot: i64 = Lowerer_handle_target(self);
            var _r: i64 = Lowerer_emit_inst(self, Inst::CallPtr(cont_val, lw_c_vec1_i64(value_val), IrType::I64, EffectSet_new(), true));
            if rslot >= 0 {
                Lowerer_emit_inst(self, Inst::Store(rslot, _r, OptIrType::None));
            }
        }
        Stmt::SpawnScope(body, _line) => {
            // L3B: spawn scope { body } — create an executor, lower the body
            // (spawn exprs use the top-of-stack executor), then join at exit.
            var exec: i64 = Lowerer_emit_inst(self, Inst::Call("p_executor_new", Vec::new(), IrType::I64, EffectSet_new()));
            self.scope_executor_stack.push(exec);
            // BG199: a return, break, continue or `?` that leaves the body
            // joins too (Lowerer_ss_join_exits)
            g_lw_ss_fn.push(self.current_func.name);
            g_lw_ss_loops.push(self.loop_stack.len());
            Lowerer_lower_stmts(self, body);
            g_lw_ss_fn.pop();
            g_lw_ss_loops.pop();
            self.scope_executor_stack.pop();
            // (a body that ended with a return has joined already)
            if !Lowerer_current_block_has_terminator(self) {
                var _j: i64 = Lowerer_emit_inst(self, Inst::Call("p_executor_run_all", lw_c_vec1_i64(exec), IrType::I64, EffectSet_new()));
            }
        }
        Stmt::CancelScope(_line) => {
            // L3E: cancel scope; — cancel all pending tasks in current scope
            if self.scope_executor_stack.len() > 0 {
                var exec2: i64 = self.scope_executor_stack.get(self.scope_executor_stack.len() - 1);
                var _c: i64 = Lowerer_emit_inst(self, Inst::Call("p_executor_cancel", lw_c_vec1_i64(exec2), IrType::I64, EffectSet_new()));
            }
        }
    }
}

// --- Stubs for functions implemented in later parts -----------------------

// MethodCall lowering extracted into a separate function to avoid the
// statement-dropping bug in long functions. Lowerer_lower_expr is ~16K lines
// of generated C, and statements in the MethodCall branch were being dropped.
/// The element AST type of a Vec<E..> receiver expression.
// --- 0008: the @sequential vars (their Vec method calls route to VecV_*) --
var g_lw_sequential_vars: Vec<str> = Vec::new();

/// Whether `e` (an Ident) names a var declared Vec<E..> (the parser's
/// sequential list, copied by Lowerer_lower_program).
fn lw_is_sequential_var(e: Expr) -> bool {
    match e {
        Expr::Ident(n) => {
            var i: i64 = 0;
            while i < g_lw_sequential_vars.len() {
                if g_lw_sequential_vars.get(i) == n {
                    return true;
                }
                i = i + 1;
            }
        }
        _ => {
        }
    }
    return false;
}

fn Lowerer_vecv_elem_ast(self: & Lowerer, receiver: Expr) -> Type {
    match receiver {
        Expr::Ident(vn) => {
            match Lowerer_lookup_var_ast_type(self, vn) {
                OptType::Some(at) => {
                    match at {
                        Type::Generic(gn, ga) => {
                            if gn == "Vec" && ga.len() == 1 {
                                return ga.get(0);
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptType::None => {
                }
            }
        }
        _ => {
        }
    }
    return Type::Infer;
}

/// A Vec<E..> method (0008): len/is_empty/get/last/push over core's
/// VecV_* functions. push's argument is the enum literal; its variant's
/// payload count and index come from the enum table.
pub fn Lowerer_vecv_method(self: & mut Lowerer, receiver: Box<Expr>, recv_val: i64, method: str, args: Vec<Expr>) -> i64 {
    val recv_e: Expr = lw_box_expr_unbox(receiver);
    val elem_ast: Type = Lowerer_vecv_elem_ast(self, recv_e);
    // the enum's IR shape (Struct(E)) is what get/last return a pointer to
    var elem_ir: IrType = Lowerer_lower_type(self, elem_ast);
    match elem_ir {
        IrType::Struct(_) => {
        }
        _ => {
            elem_ir = IrType::I64;
        }
    }
    val elem_ptr: IrType = IrType::Ptr(Box::new(elem_ir));
    if method == "len" {
        var la: Vec<i64> = Vec::new();
        la.push(recv_val);
        return Lowerer_emit_inst(self, Inst::Call("VecV_len", la, IrType::I64, EffectSet_new()));
    }
    if method == "is_empty" {
        var ea: Vec<i64> = Vec::new();
        ea.push(recv_val);
        val n: i64 = Lowerer_emit_inst(self, Inst::Call("VecV_len", ea, IrType::I64, EffectSet_new()));
        val z: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        return Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, n, z, IrType::Bool));
    }
    if method == "get" && args.len() == 1 {
        val i: i64 = Lowerer_lower_expr(self, args.get(0));
        var ga: Vec<i64> = Vec::new();
        ga.push(recv_val);
        ga.push(i);
        return Lowerer_emit_inst(self, Inst::Call("VecV_get", ga, elem_ptr, EffectSet_new()));
    }
    if method == "last" && args.len() == 0 {
        var ta: Vec<i64> = Vec::new();
        ta.push(recv_val);
        return Lowerer_emit_inst(self, Inst::Call("VecV_last", ta, elem_ptr, EffectSet_new()));
    }
    if method == "push" && args.len() == 1 {
        // the argument is the enum literal: lower it to its temp (a tag
        // word and the payload), then hand its payload words to VecV_push
        val et: Type = elem_ast;
        var en: str = "";
        match et {
            Type::Named(n2) => {
                en = n2;
            }
            _ => {
            }
        }
        var vi: i64 = 0 - 1;
        var nwords: i64 = 0;
        match Lowerer_lookup_enum(self, en) {
            OptEnumDef::Some(ed) => {
                var w: i64 = 0;
                while w < ed.variants.len() {
                    if ed.variants.get(w).name == lw_enum_lit_variant(args.get(0)) {
                        vi = w;
                        match ed.variants.get(w).data {
                            OptParams::Some(ps) => {
                                nwords = ps.len();
                            }
                            OptParams::None => {
                            }
                        }
                    }
                    w = w + 1;
                }
            }
            OptEnumDef::None => {
            }
        }
        if vi < 0 {
            // not a literal of this enum (the typechecker already spoke):
            // lower it anyway and push its words as a unit
            vi = 0;
        }
        val elem_val: i64 = Lowerer_lower_keep(self, args.get(0));
        var tid: i64 = 0;
        if self.own_on {
            tid = Lowerer_rc_tid(self, et);
        }
        if tid < 16 || tid >= 0x8000 {
            tid = 0;
        }
        var pa: Vec<i64> = Vec::new();
        pa.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
        pa.push(recv_val);
        pa.push(Lowerer_emit_inst(self, Inst::ConstInt(vi, IrType::I64)));
        pa.push(elem_val);
        pa.push(Lowerer_emit_inst(self, Inst::ConstInt(nwords, IrType::I64)));
        pa.push(Lowerer_emit_inst(self, Inst::ConstInt(tid, IrType::I64)));
        Lowerer_emit_inst(self, Inst::Call("VecV_push", pa, elem_ptr, lw_rc_eff()));
        // the element address is the call's value; statements drop it
        return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    }
    // the typechecker reports unknown Vec<E..> methods; here just 0
    return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
}

/// The variant name of an Expr::EnumLit argument ("" when it is not one).
fn lw_enum_lit_variant(e: Expr) -> str {
    match e {
        Expr::EnumLit(_, v, _) => {
            return v;
        }
        _ => {
        }
    }
    return "";
}

/// `Rc::new(x)` / `Arc::new(x)` (reference §13.3): core's Rc_new / Arc_new
/// make the block [count, x] and give its address, the handle an `Rc<T>` is.
/// The block holds x's word: a float or a pointer as its bits.
fn Lowerer_lower_rc_new(self: & mut Lowerer, name: str, arg_expr: Expr) -> i64 {
    // OW4: a payload that is not a plain word goes into a tagged block
    // [count, tid, payload] — the tid is how the last drop frees it
    var arg_ast: Type = Lowerer_infer_expr_ast_type(self, arg_expr);
    var tid: i64 = Lowerer_rc_tid(self, arg_ast);
    if tid != 0 {
        return Lowerer_lower_rc_new_t(self, name, arg_expr, arg_ast, tid);
    }
    var v_lw: i64 = Lowerer_lower_expr(self, arg_expr);
    var val_ty: IrType = Lowerer_get_value_type(self, v_lw);
    var as_word: bool = ir_type_is_float(val_ty);
    match val_ty {
        IrType::Ptr(_) => {
            as_word = true;
        }
        _ => {
        }
    }
    if ir_type_is_float(val_ty) {
        // BG274: a float as its bits (an f32 as its f64's): lower_cast
        // converted the number, so Rc::new(4.25).get() was 4
        v_lw = Lowerer_f64_word_bits(self, v_lw);
    } else if as_word {
        v_lw = Lowerer_lower_cast(self, v_lw, val_ty, IrType::I64);
    }
    var env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var cargs: Vec<i64> = Vec::new();
    cargs.push(env);
    cargs.push(v_lw);
    return Lowerer_emit_inst(self, Inst::Call(name + "_new", cargs, IrType::I64, EffectSet_new()));
}

/// `Rc::new(x)` / `Arc::new(x)` of a payload whose type tag `tid` is not 0:
/// core's Rc_new_t / Arc_new_t copies the owned value into a block
/// [count, tid, payload]. A struct or enum is copied in full; a handle (a
/// str, Vec, map or Box) is kept as its word, one more owner of it.
fn Lowerer_lower_rc_new_t(self: & mut Lowerer, name: str, arg_expr: Expr, arg_ast: Type, tid: i64) -> i64 {
    // an owned value: the block adopts the owners it carries (proposal 0004)
    var val: i64 = Lowerer_rc_owned_any(self, arg_expr);
    var paddr: i64 = 0;
    var words: i64 = 1;
    if tid >= 16 && tid < 0x8000 {
        var mem_ir: IrType = Lowerer_rc_mem_ir(self, arg_ast);
        words = (IrModule_type_size(& self.module, mem_ir) + 7) / 8;
        paddr = Lowerer_rc_as_i64(self, val);
    } else {
        var wslot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
        Lowerer_emit_inst(self, Inst::Store(wslot, Lowerer_rc_as_i64(self, val), OptIrType::None));
        paddr = Lowerer_rc_as_i64(self, wslot);
    }
    var nta: Vec<i64> = Vec::new();
    nta.push(Lowerer_rc_env(self));
    nta.push(paddr);
    nta.push(Lowerer_emit_inst(self, Inst::ConstInt(words, IrType::I64)));
    nta.push(Lowerer_emit_inst(self, Inst::ConstInt(tid, IrType::I64)));
    return Lowerer_emit_inst(self, Inst::Call(name + "_new_t", nta, IrType::I64, lw_rc_eff()));
}

/// `r.clone()`, `r.get()`, `r.count()` and `r.drop()` on an `Rc<T>` or an
/// `Arc<T>`: core's Rc_<method> / Arc_<method>. `get` gives T's word back as
/// its own type (a float's bits, a pointer's address).
fn Lowerer_lower_rc_method(self: & mut Lowerer, name: str, receiver: Expr, method: str, targs: Vec<Type>) -> i64 {
    var h: i64 = Lowerer_lower_expr(self, receiver);
    var env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var cargs: Vec<i64> = Vec::new();
    cargs.push(env);
    cargs.push(h);
    var res_ty: IrType = IrType::I64;
    if method == "drop" {
        res_ty = IrType::Void;
    }
    // OW4: a payload that is not a plain word sits in a tagged block
    // [count, tid, payload] — get reads past the tag, drop frees by it
    var ptid: i64 = 0;
    if targs.len() == 1 {
        ptid = Lowerer_rc_tid(self, targs.get(0));
    }
    var call_name: str = name + "_" + method;
    var get_mem: bool = false;
    if ptid != 0 {
        if method == "get" {
            get_mem = ptid >= 16 && ptid < 0x8000;
            call_name = name + "_get_t";
            if get_mem {
                call_name = name + "_get_p";
            }
        }
        if method == "drop" {
            call_name = name + "_drop_t";
        }
    }
    var res: i64 = Lowerer_emit_inst(self, Inst::Call(call_name, cargs, res_ty, EffectSet_new()));
    if method == "get" && get_mem {
        // the payload's address, as the struct (or enum) a place of T is
        var get_mem_ir: IrType = Lowerer_rc_mem_ir(self, targs.get(0));
        return Lowerer_emit_inst(self, Inst::BitCast(res, IrType::I64, IrType::Ptr(Box::new(get_mem_ir))));
    }
    if method == "get" && targs.len() == 1 {
        var t_ir: IrType = Lowerer_lower_type(self, targs.get(0));
        var from_word: bool = false;
        match t_ir {
            IrType::Ptr(_) => {
                from_word = true;
            }
            _ => {
            }
        }
        if ir_type_is_float(t_ir) {
            // BG274: the word is the f64's bits (Lowerer_lower_rc_new), an
            // f32 narrowed from it; a numeric conversion lost the fraction
            res = Lowerer_emit_inst(self, Inst::Call("p_f64_from_bits", lw_c_vec1_i64(res), IrType::F64, EffectSet_new()));
            res = Lowerer_lower_cast(self, res, IrType::F64, t_ir);
        } else if from_word {
            res = Lowerer_lower_cast(self, res, IrType::I64, t_ir);
        }
    }
    return res;
}

pub fn Lowerer_lower_method_call(self: & mut Lowerer, receiver: Box<Expr>, method: str, args_in: Vec<Expr>) -> i64 {
    // (a local: BG389/BG390 resolve the arguments below)
    var args: Vec<Expr> = args_in;
    // `v.get(i).items.push(x)`: the changing method owns its own receiver
    // (Vec_push calls vec_own); the Vecs it is reached through, here
    if LOWER_RC && lw_changing_method(method) {
        Lowerer_own_path(self, lw_box_expr_unbox(receiver));
    }
    // Check for associated function calls: Vec::new(), HashMap::new(), String::from()
    match lw_box_expr_unbox(receiver) {
        Expr::Ident(name) => {
            if name == "Vec" && method == "filled" && args.len() == 2 && Lowerer_has_function(self, "Vec_filled_typed") {
                return Lowerer_lower_vec_filled(self, args, Type::Infer);
            }
            if name == "Vec" && method == "new" {
                var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                return Lowerer_emit_inst(self, Inst::Call("Vec_new", lw_c_vec1_i64(dummy_env), IrType::Opaque("Vec"), EffectSet_new()));
            }
            if name == "HashMap" && method == "new" {
                var dummy_env2: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                return Lowerer_emit_inst(self, Inst::Call("HashMap_new", lw_c_vec1_i64(dummy_env2), IrType::Opaque("HashMap"), EffectSet_new()));
            }
            if name == "String" && method == "from" {
                var arg0: i64 = Lowerer_lower_expr(self, args.get(0));
                var dummy_env3: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var sargs: Vec<i64> = Vec::new();
                sargs.push(dummy_env3);
                sargs.push(arg0);
                return Lowerer_emit_inst(self, Inst::Call("String_from", sargs, IrType::Opaque("String"), EffectSet_new()));
            }
            if name == "Box" && method == "new" {
                return Lowerer_lower_box_new(self, args.get(0));
            }
            if (name == "Rc" || name == "Arc") && method == "new" && args.len() == 1 {
                return Lowerer_lower_rc_new(self, name, args.get(0));
            }
            // Struct associated function call: mangle as StructName_method
            if Lowerer_is_struct(self, name) {
                return Lowerer_lower_assoc_call(self, name, method, args);
            }
            // Check if name is a known enum - treat as EnumLit
            match Lowerer_lookup_enum(self, name) {
                OptEnumDef::Some(_) => {
                    return Lowerer_lower_expr(self, Expr::EnumLit(name, method, args));
                }
                OptEnumDef::None => {
                }
            }
        }
        _ => {
        }
    }

    // `r.clone()`, `r.get()`, `r.count()` and `r.drop()` on an `Rc<T>` or an
    // `Arc<T>` (reference §13.3) run core's Rc_<method> / Arc_<method> on the
    // handle. Before, nothing lowered them: the call went to a function that
    // does not exist (`Unknown function 'Rc_clone'`)
    if method == "clone" || method == "get" || method == "count" || method == "drop" {
        match Lowerer_resolve_type(self, Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(receiver))) {
            Type::Generic(rcn, rcg) => {
                if rcn == "Rc" || rcn == "Arc" {
                    return Lowerer_lower_rc_method(self, rcn, lw_box_expr_unbox(receiver), method, rcg);
                }
            }
            _ => {
            }
        }
    }

    // Lower receiver
    var recv_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(receiver));
    var recv_ty: IrType = Lowerer_get_value_type(self, recv_val);

    // 0008 (FID_CONTIGUOUS): a @sequential Vec<E>'s methods — the variant
    // stream's own core functions (the generic Vec_ path must not touch it)
    if lw_is_sequential_var(lw_box_expr_unbox(receiver)) {
        return Lowerer_vecv_method(self, receiver, recv_val, method, args);
    }

    // BG389/BG390: a user method's named arguments in parameter order, its
    // left-out defaults filled in, a variadic parameter's extra arguments
    // packed into its Vec (as a plain call does)
    args = Lowerer_method_call_args(self, method, recv_ty, receiver, args);

    // Lower arguments
    var arg_vals: Vec<i64> = Vec::new();
    var keeps_arg: bool = method == "push" || method == "insert" || method == "set";
    var ai: i64 = 0;
    while ai < args.len() {
        // BG433: `m.insert("g", Vec::new())`, `v.push(HashMap::new())`,
        // `p.take(Vec::new())`: an empty collection made with the element
        // types the parameter (or the receiver's element) gives it, as a
        // `let` with a declared type makes it; untyped, the strings later
        // pushed into it were never dropped
        var mnew: i64 = - 1;
        if self.own_on && (lw_is_vec_new_expr(args.get(ai)) || lw_rc_is_map_new_expr(args.get(ai))) {
            var mnt: Type = Lowerer_method_arg_ast(self, method, recv_ty, receiver, ai, args.len());
            match mnt {
                Type::Infer => {
                }
                _ => {
                    mnew = Lowerer_rc_new_coll(self, mnt);
                }
            }
        }
        if mnew >= 0 {
            arg_vals.push(mnew);
        } else if keeps_arg && ai + 1 == args.len() {
            // The element it keeps: a variable's last use is moved
            arg_vals.push(Lowerer_lower_keep(self, args.get(ai)));
        } else {
            arg_vals.push(Lowerer_lower_expr(self, args.get(ai)));
        }
        ai = ai + 1;
    }
    if method == "push" && arg_vals.len() == 1 {
        Lowerer_retype_untyped_vec(self, lw_box_expr_unbox(receiver), arg_vals.get(0));
    }

    // Receiver is a trait object (dyn Trait): dynamic dispatch.
    match recv_ty {
        IrType::Opaque(oname) => {
            if str_starts_with(oname, "dyn:") {
                var trait_name: str = str_slice(oname, 4, str_len(oname));
                var dyn_ret: IrType = IrType::I64;
                match Lowerer_lookup_func_ret_type(self, oname + "::" + method) {
                    OptType::Some(t) => {
                        dyn_ret = Lowerer_lower_type(self, t);
                    }
                    OptType::None => {
                    }
                }
                var dyn_args: Vec<i64> = Vec::new();
                dyn_args.push(recv_val);
                var di: i64 = 0;
                while di < arg_vals.len() {
                    dyn_args.push(arg_vals.get(di));
                    di = di + 1;
                }
                // Any implementation may run: assume every effect.
                var dyn_eff: EffectSet = EffectSet_new();
                EffectSet_add(& mut dyn_eff, Effect::Read);
                EffectSet_add(& mut dyn_eff, Effect::Write);
                EffectSet_add(& mut dyn_eff, Effect::IO);
                EffectSet_add(& mut dyn_eff, Effect::Alloc);
                // BG184: a struct (or enum) result comes back through the
                // method's wrapper as a heap block, copied out and freed
                // (no result pointer was passed: the method wrote through
                // its receiver as if it were one)
                match dyn_ret {
                    IrType::Struct(_) => {
                        Lowerer_dyn_sret_all(self, trait_name, method, dyn_ret);
                        var dsr: i64 = Lowerer_emit_inst(self, Inst::DynCall(trait_name, method + "__dsret", dyn_args, IrType::I64, dyn_eff));
                        var dsr_heap: i64 = Lowerer_emit_inst(self, Inst::BitCast(dsr, IrType::I64, IrType::Ptr(Box::new(dyn_ret))));
                        var dsr_local: i64 = Lowerer_emit_inst(self, Inst::Alloca(dyn_ret, Lowerer_current_region(self)));
                        Lowerer_emit_inst(self, Inst::StructCopy(dsr_local, dsr_heap, dyn_ret));
                        var dsr_fa: Vec<i64> = Vec::new();
                        dsr_fa.push(Lowerer_emit_inst(self, Inst::BitCast(dsr, IrType::I64, lw_ptr_u8())));
                        var dsr_feff: EffectSet = EffectSet_new();
                        EffectSet_add(& mut dsr_feff, Effect::Alloc);
                        Lowerer_emit_inst(self, Inst::Call("p_free", dsr_fa, IrType::Void, dsr_feff));
                        // (not made a temporary: the AST inference types a
                        // dyn call i64, so a `let` would not claim it and
                        // the statement's end would free what the let reads;
                        // what the struct owns is left, a leak)
                        return dsr_local;
                    }
                    // BG387: a fixed-array result the same way (the method
                    // takes a result pointer for it since BG126; a plain
                    // DynCall passed none and the method wrote through its
                    // receiver)
                    IrType::Array(_, _) => {
                        Lowerer_dyn_sret_all(self, trait_name, method, dyn_ret);
                        var dar: i64 = Lowerer_emit_inst(self, Inst::DynCall(trait_name, method + "__dsret", dyn_args, IrType::I64, dyn_eff));
                        var dar_heap: i64 = Lowerer_emit_inst(self, Inst::BitCast(dar, IrType::I64, IrType::Ptr(Box::new(dyn_ret))));
                        var dar_local: i64 = Lowerer_emit_inst(self, Inst::Alloca(dyn_ret, Lowerer_current_region(self)));
                        Lowerer_emit_inst(self, Inst::StructCopy(dar_local, dar_heap, dyn_ret));
                        var dar_fa: Vec<i64> = Vec::new();
                        dar_fa.push(Lowerer_emit_inst(self, Inst::BitCast(dar, IrType::I64, lw_ptr_u8())));
                        var dar_feff: EffectSet = EffectSet_new();
                        EffectSet_add(& mut dar_feff, Effect::Alloc);
                        Lowerer_emit_inst(self, Inst::Call("p_free", dar_fa, IrType::Void, dar_feff));
                        return dar_local;
                    }
                    _ => {
                    }
                }
                return Lowerer_emit_inst(self, Inst::DynCall(trait_name, method, dyn_args, dyn_ret, dyn_eff));
            }
        }
        _ => {
        }
    }

    // Determine mangled method name
    var mangled_name: str = Lowerer_mangle_method(self, method, recv_ty, receiver);
    // BG144: through a generic bound, the bound trait's method where the
    // type has another of that name
    mangled_name = lw_tq_resolve(mangled_name);

    // Fallback: if mangled_name is still just the method name, try common prefixes
    if mangled_name == method {
        if Lowerer_has_function(self, "Vec_" + method) {
            mangled_name = "Vec_" + method;
        } else if Lowerer_has_function(self, "HashMap_" + method) {
            mangled_name = "HashMap_" + method;
        } else if Lowerer_has_function(self, "String_" + method) {
            mangled_name = "String_" + method;
        } else if method == "substring" && ir_type_eq(recv_ty, IrType::Opaque("String")) {
            mangled_name = "String_slice";
        }
    }

    // BG179: `.sort()` of a Vec<f64> orders the words as doubles (core
    // Vec_sort compares them as i64: negative numbers came out backwards).
    // A Vec<f64>'s element code is a Vec<i64>'s, so the type says which.
    if mangled_name == "Vec_sort" && arg_vals.len() == 0 && Lowerer_has_function(self, "Vec_sort_f64") {
        var srt_f64: bool = false;
        // BG301: a Vec<f32> too (Vec_sort_f32 reads either word form)
        var srt_f32: bool = false;
        var srt_ty: IrType = recv_ty;
        match recv_ty {
            IrType::Ptr(srt_in) => {
                srt_ty = box_ir_type_unbox(srt_in);
            }
            _ => {
            }
        }
        if ir_type_is_opaque_named(srt_ty, "Vec") {
            match ir_type_generic_elem(srt_ty) {
                OptIrType::Some(srt_et) => {
                    srt_f64 = ir_type_eq(srt_et, IrType::F64);
                    srt_f32 = ir_type_eq(srt_et, IrType::F32);
                }
                OptIrType::None => {
                }
            }
        }
        if !srt_f64 && !srt_f32 {
            match lw_rc_strip_ref(Lowerer_eq_ast_type(self, lw_box_expr_unbox(receiver))) {
                Type::Generic(srt_gn, srt_ga) => {
                    if srt_gn == "Vec" && srt_ga.len() == 1 {
                        match Lowerer_resolve_type(self, srt_ga.get(0)) {
                            Type::F64 => {
                                srt_f64 = true;
                            }
                            Type::F32 => {
                                srt_f32 = true;
                            }
                            _ => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
        }
        if srt_f64 {
            mangled_name = "Vec_sort_f64";
        } else if srt_f32 && Lowerer_has_function(self, "Vec_sort_f32") {
            mangled_name = "Vec_sort_f32";
        }
    }

    // A HashMap with integer keys hashes and compares them as numbers:
    // HashMap_insert_i etc. (a string key's functions read the key as text)
    if str_starts_with(mangled_name, "HashMap_") && Lowerer_has_function(self, mangled_name + "_i") && Lowerer_map_has_int_keys(self, receiver, recv_ty) {
        mangled_name = mangled_name + "_i";
    }
    // BG336: keys()/values() of a map with u64 keys, in unsigned key order
    // (HashMap_keys sorts the words as i64: keys at or above 2^63 came
    // first)
    if (mangled_name == "HashMap_keys" || mangled_name == "HashMap_keys_i" || mangled_name == "HashMap_values" || mangled_name == "HashMap_values_i") && Lowerer_map_keys_u64(self, lw_box_expr_unbox(receiver), recv_ty) {
        var u64_fn: str = "HashMap_keys_u64";
        if str_starts_with(mangled_name, "HashMap_values") {
            u64_fn = "HashMap_values_u64";
        }
        if Lowerer_has_function(self, u64_fn) {
            mangled_name = u64_fn;
        }
    }

    // Ownership (proposal 0004): an element a Vec or a map keeps is an
    // owner of its own
    if self.own_on {
        var recv_e: Expr = lw_box_expr_unbox(receiver);
        if str_starts_with(mangled_name, "Vec_") && (method == "push" || method == "insert" || method == "set") && arg_vals.len() > 0 {
            var last: i64 = arg_vals.len() - 1;
            var et: Type = Lowerer_rc_vec_elem_ast(self, recv_e);
            if Lowerer_rc_kind(self, et) == RC_NONE {
                et = Lowerer_rc_value_type(self, args.get(last), arg_vals.get(last));
            }
            arg_vals.set(last, Lowerer_rc_own_value(self, arg_vals.get(last), et));
        }
        if str_starts_with(mangled_name, "HashMap_insert") && arg_vals.len() == 2 {
            var kv: Vec<Type> = Lowerer_rc_map_kv_ast(self, recv_e);
            var kt: Type = Type::Infer;
            var vt: Type = Type::Infer;
            if kv.len() == 2 {
                kt = kv.get(0);
                vt = kv.get(1);
            }
            if Lowerer_rc_kind(self, kt) == RC_NONE {
                kt = Lowerer_rc_value_type(self, args.get(0), arg_vals.get(0));
            }
            if Lowerer_rc_kind(self, vt) == RC_NONE {
                vt = Lowerer_rc_value_type(self, args.get(1), arg_vals.get(1));
            }
            if mangled_name == "HashMap_insert" {
                arg_vals.set(0, Lowerer_rc_own_value(self, arg_vals.get(0), kt));
            }
            arg_vals.set(1, Lowerer_rc_own_value(self, arg_vals.get(1), vt));
        }
    }

    // Determine return type
    var ret_ty: IrType = Lowerer_lookup_func_ret_ty_ir(self, mangled_name);
    if ir_type_eq(ret_ty, IrType::I64) {
        ret_ty = Lowerer_lookup_func_ret_ty_ir(self, method);
    }
    if str_starts_with(mangled_name, "String_") {
        var string_ret: IrType = lw_string_method_ret_ty(method);
        if !ir_type_eq(string_ret, IrType::I64) {
            ret_ty = string_ret;
        }
    }
    if str_starts_with(mangled_name, "HashMap_") {
        var map_ret: IrType = lw_map_method_ret_ty(method, recv_ty);
        if !ir_type_eq(map_ret, IrType::I64) {
            ret_ty = map_ret;
        }
    }
    // BG278: `a.clone()` of a Vec is a new Vec the caller owns, typed as the
    // receiver (as a map's clone, lw_map_method_ret_ty), so that
    // Lowerer_rc_note_call makes it a temporary of the statement: a `let`
    // claims it, anything else drops it. Core's Vec_clone returns an i64
    // handle, and with that type the clone was never dropped (and a `let`
    // took a second owner with Vec_share). A receiver held as a raw i64
    // word (core's own code) keeps the i64 result and stays unowned.
    if mangled_name == "Vec_clone" && arg_vals.len() == 0 {
        var vcl_ty: IrType = recv_ty;
        match recv_ty {
            IrType::Ptr(vcl_in) => {
                vcl_ty = box_ir_type_unbox(vcl_in);
            }
            _ => {
            }
        }
        if ir_type_is_opaque_named(vcl_ty, "Vec") {
            ret_ty = vcl_ty;
        }
    }

    // For Vec methods that return elements (get/pop/first/last/remove),
    // use word_repr(elem_ty) so struct elements get Ptr(Struct(...)) -
    // this lets the C codegen look up correct field offsets.
    if str_starts_with(mangled_name, "Vec_") {
        if method == "get" || method == "pop" || method == "first" || method == "last" || method == "remove" {
            var vec_elem_ty: IrType = IrType::I64;
            var effective_recv_ty: IrType = recv_ty;
            match recv_ty {
                IrType::Ptr(inner) => {
                    effective_recv_ty = box_ir_type_unbox(inner);
                }
                _ => {
                }
            }
            match effective_recv_ty {
                IrType::Generic(gname, gargs) => {
                    if (gname == "Vec" || gname == "VecV") && gargs.len() > 0 {
                        vec_elem_ty = gargs.get(0);
                    }
                }
                IrType::Opaque(oname) => {
                    if oname == "Vec" {
                        match lw_box_expr_unbox(receiver) {
                            Expr::Ident(vname) => {
                                match Lowerer_lookup_var_ast_type(self, vname) {
                                    OptType::Some(ast_ty) => {
                                        var inner_ty: Type = ast_ty;
                                        match ast_ty {
                                            Type::Ref(rinner, _) => {
                                                inner_ty = lw_box_type_unbox(rinner);
                                            }
                                            _ => {
                                            }
                                        }
                                        match inner_ty {
                                            Type::Generic(an, aargs) => {
                                                if an == "Vec" && aargs.len() > 0 {
                                                    vec_elem_ty = Lowerer_lower_type(self, aargs.get(0));
                                                }
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                    OptType::None => {
                                    }
                                }
                            }
                            _ => {
                                // Any other receiver (a field, an index, a
                                // call): its AST type, with a generic
                                // instance's type arguments put in
                                // (`p.a.get(0)` of a `Pair<Vec<str>, str>`
                                // is a str). Before, it was an i64 word:
                                // printed as a number, and a concatenation
                                // with it lost its statement.
                                vec_elem_ty = Lowerer_vec_elem_ir_of(self, lw_box_expr_unbox(receiver));
                            }
                        }
                    }
                }
                _ => {
                }
            }
            // A receiver lowered as a plain word: a field whose type is a
            // type parameter (`pv.a` of a `Pair<Vec<str>, str>` is an i64
            // word in the IR, neither Generic nor Opaque) keeps its element
            // type only in the AST (Lowerer_vec_elem_ir_of; I64 when it is
            // not a Vec or not known, as before)
            if ir_type_eq(vec_elem_ty, IrType::I64) {
                vec_elem_ty = Lowerer_vec_elem_ir_of(self, lw_box_expr_unbox(receiver));
            }
            ret_ty = word_repr(vec_elem_ty);
        }
    }

    // Build call args
    var call_args: Vec<i64> = Vec::new();
    var mangled_is_extern: bool = Lowerer_is_extern_func(self, mangled_name);
    var mangled_is_runtime: bool = str_starts_with(mangled_name, "p_") || str_starts_with(mangled_name, "__ecs_");
    if !mangled_is_extern && !mangled_is_runtime && mangled_name != "print" {
        call_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
    }
    // Auto-deref: for &mut Vec<T> etc, load the actual Vec pointer
    var effective_recv_val: i64 = Lowerer_auto_deref_recv(self, recv_val, recv_ty);
    // A stdlib impl method taking `self: & mut` on a word-repr collection
    // (v.dedup(), s.items.dedup(), (*p).dedup()) expects the slot address
    // like `& mut v` gives, not the Vec word: the impl forwards self to a
    // `& mut` free function which dereferences it once more. Ident, field
    // and deref receivers are place expressions with no side effects, so
    // lowering them as `& mut <place>` is safe.
    var mut_self: bool = false;
    match lw_box_expr_unbox(receiver) {
        Expr::Ident(_) => {
            mut_self = true;
        }
        Expr::FieldAccess(_, _) => {
            mut_self = true;
        }
        Expr::Deref(_) => {
            mut_self = true;
        }
        _ => {
        }
    }
    if mut_self && Lowerer_mut_self_impl(self, mangled_name) {
        effective_recv_val = Lowerer_lower_expr(self, Expr::Ref(receiver, true));
    }
    call_args.push(effective_recv_val);
    // core's collection methods take a collection argument as the word
    // itself (Vec_extend(v, other: i64)): a `&Vec` argument is loaded like
    // the receiver (stdlib-agent-bugs 8: v.extend(r) with r: &Vec<i64>
    // passed the address of r's slot and appended nothing)
    var core_coll: bool = str_starts_with(mangled_name, "Vec_") || str_starts_with(mangled_name, "HashMap_") || str_starts_with(mangled_name, "String_");
    // An integer passed where the parameter is a float is the number
    // (`p.move_by(5)`): Lowerer_int_to_float_value, as a call makes it
    var i2f_at: i64 = HashMap_get(self.func_info_at, mangled_name);
    if i2f_at != 0 {
        var i2f_ps: Vec<Type> = self.func_param_asts.get(i2f_at - 1);
        var i2f_off: i64 = i2f_ps.len() - args.len();
        if i2f_off == 1 || i2f_off == 0 {
            var i2f_i: i64 = 0;
            while i2f_i < arg_vals.len() && i2f_i + i2f_off < i2f_ps.len() {
                arg_vals.set(i2f_i, Lowerer_int_to_float_value(self, arg_vals.get(i2f_i), Lowerer_lower_type(self, i2f_ps.get(i2f_i + i2f_off))));
                i2f_i = i2f_i + 1;
            }
        }
    }
    // BG268: an f32 value given to a map of f32 values (insert, get_or's
    // default) is widened, so the map keeps an f64's bits on every backend
    // as an f64 map does (--nat kept the f32's bits, the others the f64's)
    if str_starts_with(mangled_name, "HashMap_") && Lowerer_map_values_f32(self, lw_box_expr_unbox(receiver), recv_ty) {
        var m32_i: i64 = 0;
        while m32_i < arg_vals.len() {
            arg_vals.set(m32_i, Lowerer_float_as(self, arg_vals.get(m32_i), IrType::F64));
            m32_i = m32_i + 1;
        }
    }
    ai = 0;
    while ai < arg_vals.len() {
        if core_coll {
            call_args.push(Lowerer_auto_deref_recv(self, arg_vals.get(ai), Lowerer_get_value_type(self, arg_vals.get(ai))));
        } else {
            call_args.push(arg_vals.get(ai));
        }
        ai = ai + 1;
    }

    // Box struct elements before pushing/inserting into Vec, or (release
    // D15) give core the struct's size to store it in the Vec's buffer
    if method == "push" || method == "insert" || method == "set" {
        var msize: i64 = Lowerer_box_vec_element(self, & mut call_args, recv_ty, receiver, mangled_name);
        if msize > 0 {
            mangled_name = mangled_name + "_mem";
            var etid: i64 = 0;
            if self.own_on {
                // a map's element type is its value type (RT5; core falls
                // back to the type HashMap_new_typed gave the map when 0)
                if str_starts_with(mangled_name, "HashMap_") {
                    var mkv: Vec<Type> = Lowerer_rc_map_kv_ast(self, lw_box_expr_unbox(receiver));
                    if mkv.len() == 2 {
                        etid = Lowerer_rc_tid(self, mkv.get(1));
                    }
                } else {
                    etid = Lowerer_rc_tid(self, Lowerer_rc_vec_elem_ast(self, lw_box_expr_unbox(receiver)));
                }
            }
            if etid < 16 || etid >= 0x8000 {
                etid = 0;
            }
            call_args.push(Lowerer_emit_inst(self, Inst::ConstInt(msize, IrType::I64)));
            call_args.push(Lowerer_emit_inst(self, Inst::ConstInt(etid, IrType::I64)));
        }
    }

    // RT5: a struct or tuple key is kept as a copy of its own and hashed
    // and compared field by field: HashMap_insert_k(m, kaddr, value, ksize,
    // ktid), HashMap_insert_k_mem(m, kaddr, x, ksize, ktid, size, tid). The
    // key argument is the struct's address (owned above); a lookup (get,
    // get_or, contains, remove) passes the key's address as it is.
    if mangled_name == "HashMap_insert" || mangled_name == "HashMap_insert_mem" {
        var ksize: i64 = 0;
        var ktid: i64 = 0;
        var kfn: str = "HashMap_insert_k";
        if mangled_name == "HashMap_insert_mem" {
            kfn = "HashMap_insert_k_mem";
        }
        var mkv2: Vec<Type> = Lowerer_rc_map_kv_ast(self, lw_box_expr_unbox(receiver));
        if mkv2.len() == 2 && Lowerer_has_function(self, kfn) {
            var kst: IrType = Lowerer_map_struct_key_ir(self, mkv2.get(0));
            match kst {
                IrType::Struct(_) => {
                    ksize = IrModule_type_size(& self.module, kst);
                }
                _ => {
                }
            }
            if ksize <= 0 || ksize % 8 != 0 || ksize > 2040 {
                ksize = 0;
            }
            if ksize > 0 && self.own_on {
                ktid = Lowerer_rc_tid(self, mkv2.get(0));
            }
            // (a tuple key too: a struct of its shape, whose drop and
            // copy are its own and whose strings __p_key_strs names)
            if ktid < 16 || ktid >= 0x8000 {
                ktid = 0;
            }
        }
        if ksize > 0 {
            var kconst: i64 = Lowerer_emit_inst(self, Inst::ConstInt(ksize, IrType::I64));
            var tconst: i64 = Lowerer_emit_inst(self, Inst::ConstInt(ktid, IrType::I64));
            if mangled_name == "HashMap_insert" {
                call_args.push(kconst);
                call_args.push(tconst);
                mangled_name = kfn;
            } else {
                // (env, m, key, x, size, tid) -> (env, m, key, x, ksize,
                // ktid, size, tid)
                var kargs: Vec<i64> = Vec::new();
                var ci: i64 = 0;
                while ci < call_args.len() {
                    if ci == call_args.len() - 2 {
                        kargs.push(kconst);
                        kargs.push(tconst);
                    }
                    kargs.push(call_args.get(ci));
                    ci = ci + 1;
                }
                call_args = kargs;
                mangled_name = kfn;
            }
        }
    }

    var eff: EffectSet = EffectSet_new();
    match runtime_effects(mangled_name) {
        OptEffectSet::Some(e) => {
            eff = e;
        }
        OptEffectSet::None => {
        }
    }

    // Handle struct return via SRET
    match ret_ty {
        IrType::Struct(sname) => {
            var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct(sname), Lowerer_current_region(self)));
            var sret_args: Vec<i64> = Vec::new();
            sret_args.push(sret_ptr);
            var si: i64 = 0;
            while si < call_args.len() {
                sret_args.push(call_args.get(si));
                si = si + 1;
            }
            Lowerer_emit_inst(self, Inst::Call(mangled_name, sret_args, IrType::Void, eff));
            Lowerer_rc_note_sret(self, sret_ptr, mangled_name);
            return sret_ptr;
        }
        // An array result the callee writes into the caller's buffer
        IrType::Array(_, _) => {
            var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(ret_ty, Lowerer_current_region(self)));
            var sret_args: Vec<i64> = Vec::new();
            sret_args.push(sret_ptr);
            var si: i64 = 0;
            while si < call_args.len() {
                sret_args.push(call_args.get(si));
                si = si + 1;
            }
            Lowerer_emit_inst(self, Inst::Call(mangled_name, sret_args, IrType::Void, eff));
            Lowerer_rc_note_sret(self, sret_ptr, mangled_name);
            return sret_ptr;
        }
        _ => {
        }
    }

    var mres: i64 = Lowerer_emit_inst(self, Inst::Call(mangled_name, call_args, ret_ty, eff));
    // A map of f64 values keeps each one's bits (insert passes them so):
    // get / get_or give that word, made the f64 here. Used directly it was
    // the raw word (stdlib-agent-bugs 40: `float_to_str(h.get(k))` printed
    // "", comparing it with an f64 panicked; C converted it as a number).
    if str_starts_with(mangled_name, "HashMap_get") && ir_type_eq(ret_ty, IrType::I64) && Lowerer_map_values_f64(self, lw_box_expr_unbox(receiver), recv_ty) {
        var gbits: Vec<i64> = Vec::new();
        gbits.push(mres);
        return Lowerer_emit_inst(self, Inst::Call("p_f64_from_bits", gbits, IrType::F64, EffectSet_new()));
    }
    // BG268: a map of f32 values keeps each one as an f64's bits too (the
    // arguments are widened above): get / get_or narrow it back. The word
    // was converted as an integer (3.5 printed 4615063718147915776)
    if str_starts_with(mangled_name, "HashMap_get") && ir_type_eq(ret_ty, IrType::I64) && Lowerer_map_values_f32(self, lw_box_expr_unbox(receiver), recv_ty) {
        var gbits32: Vec<i64> = Vec::new();
        gbits32.push(mres);
        var g64: i64 = Lowerer_emit_inst(self, Inst::Call("p_f64_from_bits", gbits32, IrType::F64, EffectSet_new()));
        return Lowerer_lower_cast(self, g64, IrType::F64, IrType::F32);
    }
    // BG308: a missing key of a map of Vecs, maps or structs gives an empty
    // or zeroed value, as `fid run` reads it, not a null word
    if (mangled_name == "HashMap_get" || mangled_name == "HashMap_get_i") && method == "get" {
        mres = Lowerer_map_get_or_zero(self, mres, ret_ty);
    }
    // pop/remove take the element out: the caller owns it (proposal 0004)
    if self.own_on && (mangled_name == "Vec_pop" || mangled_name == "Vec_remove") {
        var pet: Type = Lowerer_rc_vec_elem_ast(self, lw_box_expr_unbox(receiver));
        var pk: i64 = Lowerer_rc_kind(self, pet);
        // OW6: a struct holding a Vec, a string or a map too (RC_MEM): core
        // gives the caller the struct at the returned address with owners
        // of its own (vec_sz_pop / vec_sz_remove; from a shared buffer they
        // are dups), so it is a temporary the `let` takes over (its Store
        // copies the bytes) or the statement's end drops. Without it the
        // `let` took one more owner of each field and the popped
        // element's own blocks leaked.
        if pk == RC_MEM {
            return Lowerer_rc_popped_mem(self, mres, pet);
        }
        if pk == RC_STR || pk == RC_VEC || pk == RC_MAP || pk == RC_BOX {
            Lowerer_rc_temp(self, mres, pet);
        }
    }
    return mres;
}

// Helper: Box::new(x) lowering
pub fn Lowerer_lower_box_new(self: & mut Lowerer, arg_expr: Expr) -> i64 {
    // The box keeps an owner of what it holds (proposal 0004); a counted
    // Box (LOWER_BOX_RC) drops it with its last owner
    var val: i64 = Lowerer_rc_owned_any(self, arg_expr);
    if LOWER_BOX_RC && self.own_on {
        return Lowerer_lower_box_new_rc(self, arg_expr, val);
    }
    var val_ty: IrType = Lowerer_get_value_type(self, val);
    var alloc_size: i64 = 8;
    var store_ty: OptIrType = OptIrType::None;
    match val_ty {
        IrType::Ptr(inner) => {
            var inner_ty: IrType = box_ir_type_unbox(inner);
            if ir_type_is_aggregate(inner_ty) {
                alloc_size = IrModule_type_size(& self.module, inner_ty);
                store_ty = OptIrType::Some(inner_ty);
            } else {
                alloc_size = ir_type_size(val_ty);
            }
        }
        _ => {
            alloc_size = ir_type_size(val_ty);
        }
    }
    if alloc_size == 0 {
        alloc_size = 8;
    }
    var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(alloc_size, IrType::I64));
    var ptr_ty: IrType = IrType::Ptr(Box::new(val_ty));
    var ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(size_val), ptr_ty, EffectSet_new()));
    Lowerer_emit_inst(self, Inst::Store(ptr, val, store_ty));
    return ptr;
}

/// Box::new(x) as a counted Box: a block of [P_BOX_RC + 1][x], the Box the
/// address after the count, a temporary of the statement (whoever keeps it
/// claims it; nobody: it is dropped and freed).
fn Lowerer_lower_box_new_rc(self: & mut Lowerer, arg_expr: Expr, val: i64) -> i64 {
    var val_ty: IrType = Lowerer_get_value_type(self, val);
    var alloc_size: i64 = 8;
    var store_ty: OptIrType = OptIrType::None;
    var inner: Type = Lowerer_rc_value_type(self, arg_expr, val);
    match val_ty {
        IrType::Ptr(pinner) => {
            var inner_ty: IrType = box_ir_type_unbox(pinner);
            if ir_type_is_aggregate(inner_ty) {
                alloc_size = IrModule_type_size(& self.module, inner_ty);
                store_ty = OptIrType::Some(inner_ty);
                if Lowerer_rc_kind(self, inner) == RC_NONE {
                    match inner_ty {
                        IrType::Struct(sn) => {
                            inner = Type::Named(sn);
                        }
                        _ => {
                        }
                    }
                }
            } else {
                alloc_size = ir_type_size(val_ty);
            }
        }
        _ => {
            alloc_size = ir_type_size(val_ty);
        }
    }
    if alloc_size <= 0 {
        alloc_size = 8;
    }
    var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(alloc_size + 8, IrType::I64));
    var blk: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(size_val), lw_ptr_u8(), lw_rc_eff()));
    var blki: i64 = Lowerer_emit_inst(self, Inst::BitCast(blk, lw_ptr_u8(), IrType::I64));
    var hp: i64 = Lowerer_emit_inst(self, Inst::BitCast(blki, IrType::I64, IrType::Ptr(Box::new(IrType::I64))));
    var one: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0x464944424F580001, IrType::I64));
    Lowerer_emit_inst(self, Inst::Store(hp, one, OptIrType::None));
    var eight: i64 = Lowerer_emit_inst(self, Inst::ConstInt(8, IrType::I64));
    var bi: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, blki, eight, IrType::I64));
    var ptr_ty: IrType = IrType::Ptr(Box::new(val_ty));
    var ptr: i64 = Lowerer_emit_inst(self, Inst::BitCast(bi, IrType::I64, ptr_ty));
    Lowerer_emit_inst(self, Inst::Store(ptr, val, store_ty));
    var ia: Vec<Type> = Vec::new();
    match inner {
        Type::Infer => {
            ia.push(Type::I64);
        }
        _ => {
            ia.push(inner);
        }
    }
    Lowerer_rc_temp(self, ptr, Type::Generic("Box", ia));
    return ptr;
}

/// BG389/BG390: the arguments of `recv.method(args)` for the impl method
/// the call reaches (as Lowerer_mangle_method names it), as a plain call
/// gets them (Lowerer_lower_call_expr): named arguments in parameter order,
/// a parameter left out given its default (reference §2.1: "lowering
/// supplies the default"; a method call passed one argument too few), and
/// for a last `...xs: T` parameter the extra arguments packed into a Vec<T>
/// (a method call passed the raw words: `ns` was the first of them). `args`
/// as they are for any other method.
fn Lowerer_method_call_args(self: & mut Lowerer, method: str, recv_ty: IrType, receiver: Box<Expr>, args: Vec<Expr>) -> Vec<Expr> {
    var mname: str = lw_tq_resolve(Lowerer_mangle_method(self, method, recv_ty, receiver));
    var suffix: str = "_" + method;
    if mname == method || !str_ends_with(mname, suffix) {
        return args;
    }
    var tn: str = str_slice(mname, 0, str_len(mname) - str_len(suffix));
    var mf: Func = Func_new("", Type::Void);
    match Lowerer_lookup_impl_method(self, tn, method) {
        OptFunc::Some(f) => {
            mf = f;
        }
        OptFunc::None => {
            return args;
        }
    }
    var skip: i64 = 0;
    if mf.params.len() > 0 && mf.params.get(0).name == "self" {
        skip = 1;
    }
    return Lowerer_args_for_params(self, mf.params, skip, args, OptBoxExpr::Some(receiver));
}

/// BG433: the AST type argument `ai` (of `n`) of `recv.method(..)` is kept
/// as: a Vec's element for push / insert / set, a map's value for insert,
/// else the user method's parameter (Infer when not known; a reference's
/// referent).
fn Lowerer_method_arg_ast(self: & mut Lowerer, method: str, recv_ty: IrType, receiver: Box<Expr>, ai: i64, n: i64) -> Type {
    var mname: str = lw_tq_resolve(Lowerer_mangle_method(self, method, recv_ty, receiver));
    if mname == method {
        if Lowerer_has_function(self, "Vec_" + method) {
            mname = "Vec_" + method;
        } else if Lowerer_has_function(self, "HashMap_" + method) {
            mname = "HashMap_" + method;
        }
    }
    if str_starts_with(mname, "Vec_") && (method == "push" || method == "insert" || method == "set") {
        if ai + 1 == n {
            return Lowerer_rc_vec_elem_ast(self, lw_box_expr_unbox(receiver));
        }
        return Type::Infer;
    }
    if str_starts_with(mname, "HashMap_") {
        if method == "insert" && ai == 1 && n == 2 {
            var kv: Vec<Type> = Lowerer_rc_map_kv_ast(self, lw_box_expr_unbox(receiver));
            if kv.len() == 2 {
                return kv.get(1);
            }
        }
        return Type::Infer;
    }
    var suffix: str = "_" + method;
    if mname == method || !str_ends_with(mname, suffix) {
        return Type::Infer;
    }
    var tn: str = str_slice(mname, 0, str_len(mname) - str_len(suffix));
    match Lowerer_lookup_impl_method(self, tn, method) {
        OptFunc::Some(f) => {
            var skip: i64 = 0;
            if f.params.len() > 0 && f.params.get(0).name == "self" {
                skip = 1;
            }
            if ai + skip < f.params.len() {
                return lw_rc_strip_ref(f.params.get(ai + skip).ty);
            }
        }
        OptFunc::None => {
        }
    }
    return Type::Infer;
}

/// BG389/BG390: `args` for parameters `params` from `skip` on (1 past a
/// method's `self`): resolved (lw_resolve_args) when a named argument is
/// there or a parameter has a default, then a variadic last parameter's
/// extra arguments packed into one Vec (as Lowerer_pack_variadic does for
/// a function). `recv` stands for `self` in a default.
fn Lowerer_args_for_params(self: & mut Lowerer, params: Vec<Param>, skip: i64, args: Vec<Expr>, recv: OptBoxExpr) -> Vec<Expr> {
    var names: Vec<str> = Vec::new();
    var defaults: Vec<Expr> = Vec::new();
    var any_default: bool = false;
    var va: bool = false;
    var vty: Type = Type::Infer;
    var pi: i64 = skip;
    while pi < params.len() {
        var p: Param = params.get(pi);
        names.push(p.name);
        if p.has_default {
            defaults.push(p.default_expr);
            any_default = true;
        } else {
            defaults.push(Expr::IntLit(0));
        }
        if p.is_variadic && pi == params.len() - 1 {
            va = true;
            vty = p.ty;
        }
        pi = pi + 1;
    }
    var has_named: bool = false;
    var ai: i64 = 0;
    while ai < args.len() {
        match args.get(ai) {
            Expr::NamedArg(_, _) => {
                has_named = true;
            }
            _ => {
            }
        }
        ai = ai + 1;
    }
    if va {
        // named arguments are left as they are (as Lowerer_pack_variadic)
        if has_named || names.len() == 0 {
            return args;
        }
        var k: i64 = names.len() - 1;
        var vec_ty: Type = vty;
        var is_vec: bool = false;
        match vty {
            Type::Generic(gn, gargs) => {
                is_vec = gn == "Vec" && gargs.len() == 1;
            }
            _ => {
            }
        }
        if !is_vec {
            vec_ty = Type::Generic("Vec", lw_va_one_type(vty));
        }
        var out: Vec<Expr> = Vec::new();
        var i: i64 = 0;
        while i < k {
            if i < args.len() {
                out.push(args.get(i));
            } else {
                var dbv: Expr = lw_dflt_bind(defaults.get(i), names, out, recv);
                out.push(dbv);
            }
            i = i + 1;
        }
        var num: i64 = HashMap_get(self.func_info_at, "...#") + 1;
        HashMap_insert(self.func_info_at, "...#", num);
        var vname: str = "__va" + int_to_str(num);
        var stmts: Vec<Stmt> = Vec::new();
        var no_args: Vec<Expr> = Vec::new();
        stmts.push(Stmt::Let(vname, OptType::Some(vec_ty), Expr::MethodCall(Box::new(Expr::Ident("Vec")), "new", no_args), true, false, Vec::new(), self.cur_line));
        var j: i64 = k;
        while j < args.len() {
            var one: Vec<Expr> = Vec::new();
            one.push(args.get(j));
            stmts.push(Stmt::Expr(Expr::MethodCall(Box::new(Expr::Ident(vname)), "push", one), self.cur_line));
            j = j + 1;
        }
        stmts.push(Stmt::Expr(Expr::Ident(vname), self.cur_line));
        out.push(Expr::Block(stmts));
        return out;
    }
    if !has_named && !any_default {
        return args;
    }
    return lw_resolve_args(names, defaults, args, recv);
}

// Helper: associated function call (StructName::method)
pub fn Lowerer_lower_assoc_call(self: & mut Lowerer, struct_name: str, method: str, args_in: Vec<Expr>) -> i64 {
    // (a local: BG389 resolves the arguments below)
    var args: Vec<Expr> = args_in;
    // BG389: an associated function's (or `C::m(c, ..)`'s) named arguments,
    // defaults and variadic extras, as a plain call has them
    match Lowerer_lookup_impl_method(self, struct_name, method) {
        OptFunc::Some(af) => {
            args = Lowerer_args_for_params(self, af.params, 0, args, OptBoxExpr::None);
        }
        OptFunc::None => {
        }
    }
    var mangled: str = struct_name + "_" + method;
    var all_args: Vec<i64> = Vec::new();
    var si: i64 = 0;
    while si < args.len() {
        all_args.push(Lowerer_lower_expr(self, args.get(si)));
        si = si + 1;
    }
    var sret_ty: IrType = Lowerer_lookup_func_ret_ty_ir(self, mangled);
    var seff: EffectSet = EffectSet_new();
    match runtime_effects(mangled) {
        OptEffectSet::Some(e) => {
            seff = e;
        }
        OptEffectSet::None => {
        }
    }
    match sret_ty {
        IrType::Struct(sname) => {
            var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct(sname), Lowerer_current_region(self)));
            var sret_args: Vec<i64> = Vec::new();
            sret_args.push(sret_ptr);
            if Lowerer_is_user_func(self, mangled) && !Lowerer_is_extern_func(self, mangled) {
                var dummy_env4: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                sret_args.push(dummy_env4);
            }
            si = 0;
            while si < all_args.len() {
                sret_args.push(all_args.get(si));
                si = si + 1;
            }
            Lowerer_emit_inst(self, Inst::Call(mangled, sret_args, IrType::Void, seff));
            Lowerer_rc_note_sret(self, sret_ptr, mangled);
            return sret_ptr;
        }
        // An array result, as a struct's: written into the caller's buffer
        IrType::Array(_, _) => {
            var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(sret_ty, Lowerer_current_region(self)));
            var sret_args: Vec<i64> = Vec::new();
            sret_args.push(sret_ptr);
            if Lowerer_is_user_func(self, mangled) && !Lowerer_is_extern_func(self, mangled) {
                var dummy_env4: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                sret_args.push(dummy_env4);
            }
            si = 0;
            while si < all_args.len() {
                sret_args.push(all_args.get(si));
                si = si + 1;
            }
            Lowerer_emit_inst(self, Inst::Call(mangled, sret_args, IrType::Void, seff));
            Lowerer_rc_note_sret(self, sret_ptr, mangled);
            return sret_ptr;
        }
        _ => {
            if Lowerer_is_user_func(self, mangled) && !Lowerer_is_extern_func(self, mangled) {
                var dummy_env4: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                all_args.insert(0, dummy_env4);
            }
            return Lowerer_emit_inst(self, Inst::Call(mangled, all_args, sret_ty, seff));
        }
    }
}

// Helper: resolve a type alias name to its underlying type name for method mangling.
// e.g. "ScopeStack" (alias for Vec<ScopeEntry>) - "Vec"
// Returns the original name if no alias is found.
pub fn Lowerer_resolve_type_alias_name(self: & Lowerer, name: str) -> str {
    match Lowerer_lookup_type_alias(self, name) {
        OptType::Some(alias) => {
            match alias {
                Type::Named(inner) => {
                    return Lowerer_resolve_type_alias_name(self, inner);
                }
                Type::Generic(gname, _) => {
                    return gname;
                }
                _ => {
                    return name;
                }
            }
            return name;
        }
        OptType::None => {
            return name;
        }
    }
    return name;
}

// Helper: mangle method name based on receiver type
pub fn Lowerer_mangle_method(self: & mut Lowerer, method: str, recv_ty: IrType, receiver: Box<Expr>) -> str {
    var mangled_name: str = method;
    match recv_ty {
        IrType::Struct(struct_name) => {
            var resolved_name: str = Lowerer_resolve_type_alias_name(self, struct_name);
            // If resolved to a builtin collection name, use it directly
            if resolved_name == "Vec" || resolved_name == "HashMap" || resolved_name == "String" {
                return resolved_name + "_" + method;
            }
            mangled_name = resolved_name + "_" + method;
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(struct_name2) => {
                    var resolved_name2: str = Lowerer_resolve_type_alias_name(self, struct_name2);
                    if resolved_name2 == "Vec" || resolved_name2 == "HashMap" || resolved_name2 == "String" {
                        return resolved_name2 + "_" + method;
                    }
                    mangled_name = resolved_name2 + "_" + method;
                }
                IrType::Opaque(type_name2) => {
                    var resolved_name3: str = Lowerer_resolve_type_alias_name(self, type_name2);
                    if resolved_name3 == "Vec" || resolved_name3 == "HashMap" || resolved_name3 == "String" {
                        return resolved_name3 + "_" + method;
                    }
                    mangled_name = resolved_name3 + "_" + method;
                }
                IrType::Generic(gen_name2, _) => {
                    mangled_name = gen_name2 + "_" + method;
                }
                _ => {
                }
            }
        }
        IrType::Opaque(type_name) => {
            var resolved_name4: str = Lowerer_resolve_type_alias_name(self, type_name);
            if resolved_name4 == "Vec" || resolved_name4 == "HashMap" || resolved_name4 == "String" {
                return resolved_name4 + "_" + method;
            }
            mangled_name = resolved_name4 + "_" + method;
        }
        IrType::Generic(gen_name, _) => {
            mangled_name = gen_name + "_" + method;
        }
        _ => {
            match lw_box_expr_unbox(receiver) {
                Expr::Ident(var_name) => {
                    match Lowerer_lookup_var_ast_type(self, var_name) {
                        OptType::Some(ast_ty) => {
                            var resolved: Type = Lowerer_resolve_type(self, ast_ty);
                            match resolved {
                                Type::Ref(inner_ref, _) => {
                                    resolved = lw_box_type_unbox(inner_ref);
                                }
                                _ => {
                                }
                            }
                            match resolved {
                                Type::Generic(gname, _) => {
                                    mangled_name = gname + "_" + method;
                                }
                                Type::Named(nname) => {
                                    mangled_name = nname + "_" + method;
                                }
                                _ => {
                                }
                            }
                        }
                        OptType::None => {
                        }
                    }
                }
                _ => {
                }
            }
        }
    }
    return mangled_name;
}

// Helper: box struct elements before Vec push/insert/set
pub fn Lowerer_box_vec_element(self: & mut Lowerer, call_args: & mut Vec<i64>, recv_ty: IrType, receiver: Box<Expr>, mangled: str) -> i64 {
    var vec_elem_ty: IrType = IrType::I64;
    var found_elem: bool = false;
    var effective_recv_ty: IrType = recv_ty;
    match recv_ty {
        IrType::Ptr(inner) => {
            effective_recv_ty = box_ir_type_unbox(inner);
        }
        _ => {
        }
    }
    match effective_recv_ty {
        IrType::Generic(gname, gargs) => {
            if gname == "Vec" && gargs.len() > 0 {
                vec_elem_ty = gargs.get(0);
                found_elem = true;
            }
        }
        IrType::Opaque(oname) => {
            if oname == "Vec" {
                match lw_box_expr_unbox(receiver) {
                    Expr::Ident(vname) => {
                        match Lowerer_lookup_var_ast_type(self, vname) {
                            OptType::Some(at) => {
                                var inner_ty: Type = at;
                                match at {
                                    Type::Ref(inner, _) => {
                                        inner_ty = lw_box_type_unbox(inner);
                                    }
                                    _ => {
                                    }
                                }
                                match inner_ty {
                                    Type::Generic(an, aargs) => {
                                        if an == "Vec" && aargs.len() > 0 {
                                            vec_elem_ty = Lowerer_lower_type(self, aargs.get(0));
                                            found_elem = true;
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                            OptType::None => {
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
        }
        _ => {
        }
    }
    // A tuple element (of a Vec, or a map's value) is a struct of its
    // shape, stored as a struct is (in the buffer, or boxed): as a word the
    // Vec kept the address of a tuple on the stack, which its drop and
    // copies (by the element type, a tuple's own) then read
    var tuple_et: Type = Type::Infer;
    if str_starts_with(mangled, "HashMap_") {
        var bkv: Vec<Type> = Lowerer_rc_map_kv_ast(self, lw_box_expr_unbox(receiver));
        if bkv.len() == 2 {
            tuple_et = bkv.get(1);
        }
    } else {
        tuple_et = Lowerer_rc_vec_elem_ast(self, lw_box_expr_unbox(receiver));
    }
    var tuple_es: Vec<Type> = Lowerer_rc_tuple_elems(self, tuple_et);
    if tuple_es.len() > 0 {
        vec_elem_ty = Lowerer_key_tuple_ir(self, tuple_es);
        found_elem = true;
        // the value: the tuple's address
        var tvi: i64 = call_args.len() - 1;
        call_args.set(tvi, Lowerer_rc_tuple_ptr(self, call_args.get(tvi), tuple_et));
    } else {
        // A generic struct's instance (`Pair<Cell, i64>`) lowers as
        // IrType::Generic, not IrType::Struct, so it fell through as a word:
        // the Vec kept the address of the call's result slot, which the next
        // push reused (every element read as the last one pushed, and the
        // Vec's drop freed their one shared heap copy once per element:
        // "Double free"). It is stored as its struct, as a map key of that
        // type is (Lowerer_key_struct_layout_ir); its value is already the
        // struct's address.
        var gst: IrType = Lowerer_generic_inst_struct_ir(self, tuple_et);
        match gst {
            IrType::Struct(_) => {
                vec_elem_ty = gst;
                found_elem = true;
            }
            _ => {
            }
        }
    }
    if found_elem {
        match vec_elem_ty {
            IrType::Struct(_) => {
                var ms: i64 = Lowerer_vec_mem_size(self, mangled, vec_elem_ty);
                if ms > 0 {
                    return ms;
                }
                Lowerer_box_struct_arg(self, call_args, vec_elem_ty);
            }
            // BG384: a fixed array is kept by value, as a struct is: its
            // elements in the Vec's buffer (an element is then read by its
            // address there), or a heap copy when it is too big for that.
            // As a word the Vec kept the address of the local array, reused
            // by the next iteration or dead after the return.
            IrType::Array(_, _) => {
                var ams: i64 = Lowerer_vec_mem_size(self, mangled, vec_elem_ty);
                if ams > 0 {
                    return ams;
                }
                var avi: i64 = call_args.len() - 1;
                call_args.set(avi, Lowerer_arr_heap_copy(self, call_args.get(avi), vec_elem_ty));
            }
            _ => {
            }
        }
    } else {
        // Fallback: check the value's IR type directly
        var val_idx2: i64 = call_args.len() - 1;
        var val2: i64 = call_args.get(val_idx2);
        var val2_ty: IrType = Lowerer_get_value_type(self, val2);
        match val2_ty {
            IrType::Ptr(inner2) => {
                match box_ir_type_unbox(inner2) {
                    IrType::Struct(sname) => {
                        var ms2: i64 = Lowerer_vec_mem_size(self, mangled, IrType::Struct(sname));
                        if ms2 > 0 {
                            return ms2;
                        }
                        Lowerer_box_struct_arg(self, call_args, IrType::Struct(sname));
                    }
                    // BG384: an array value, as above
                    IrType::Array(_, _) => {
                        var aty2: IrType = box_ir_type_unbox(inner2);
                        var ams2: i64 = Lowerer_vec_mem_size(self, mangled, aty2);
                        if ams2 > 0 {
                            return ams2;
                        }
                        call_args.set(val_idx2, Lowerer_arr_heap_copy(self, val2, aty2));
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
    }
    return 0;
}

/// The size of struct `st` when `mangled` (Vec_push, Vec_insert, Vec_set,
/// HashMap_insert, HashMap_insert_i) should store it in the Vec's buffer
/// (release D15) or the map's values block (RT5), else 0 (box it).
fn Lowerer_vec_mem_size(self: & mut Lowerer, mangled: str, st: IrType) -> i64 {
    if !LOWER_INLINE_STRUCTS {
        return 0;
    }
    if mangled != "Vec_push" && mangled != "Vec_insert" && mangled != "Vec_set" && mangled != "HashMap_insert" && mangled != "HashMap_insert_i" {
        return 0;
    }
    if !Lowerer_has_function(self, mangled + "_mem") {
        return 0;
    }
    var size: i64 = IrModule_type_size(& self.module, st);
    if size <= 0 || size % 8 != 0 || size > 232 * 8 {
        return 0;
    }
    return size;
}

/// The IR struct type of a map key of AST type `t` when it is a struct of
/// the program (a generic one's instance too: `Pair<str, i64>` is laid out
/// as `Pair`) or a tuple (its shape's layout, registered here as a
/// tuple literal registers it, Lowerer_key_tuple_ir), else I64 (a word
/// key: number, str, ...).
fn Lowerer_map_struct_key_ir(self: & mut Lowerer, t: Type) -> IrType {
    var rt: Type = Lowerer_resolve_type(self, t);
    match rt {
        Type::Tuple(es) => {
            if es.len() == 0 {
                return IrType::I64;
            }
            return Lowerer_key_tuple_ir(self, es);
        }
        _ => {
        }
    }
    var name: str = lw_rc_type_name(rt);
    if name == "" || name == "Vec" || name == "HashMap" || name == "Box" || name == "Rc" || name == "Arc" {
        return IrType::I64;
    }
    match Lowerer_lookup_struct(self, name) {
        OptStructDef::Some(_) => {
        }
        OptStructDef::None => {
            return IrType::I64;
        }
    }
    var it: IrType = Lowerer_lower_type(self, rt);
    match it {
        IrType::Struct(_) => {
            return it;
        }
        _ => {
        }
    }
    // a generic struct's instance (lowered as IrType::Generic): the
    // struct's one layout, a type parameter's field a word
    return Lowerer_key_struct_layout_ir(self, rt);
}

/// IrType::Struct(name) of `t` when it is an instance of one of the
/// program's generic structs (`Pair<Cell, i64>`) whose layout the module
/// has, else I64. A non-generic struct, a tuple and the built-in
/// containers (Vec, HashMap, Box, Rc, Arc) give I64: their elements are
/// handled by their own paths.
fn Lowerer_generic_inst_struct_ir(self: & mut Lowerer, t: Type) -> IrType {
    var rt: Type = lw_rc_strip_ref(Lowerer_resolve_type(self, t));
    match rt {
        Type::Generic(gn, gargs) => {
            if gargs.len() == 0 {
                return IrType::I64;
            }
            // BG131: an instance of a generic enum (Option<T>, Result<T, E>,
            // the program's own) is stored as its layout too: as a word the
            // Vec kept the address of the literal's reused stack slot
            if gn != "Vec" && gn != "HashMap" && gn != "Box" && gn != "Rc" && gn != "Arc" {
                match Lowerer_lookup_enum(self, gn) {
                    OptEnumDef::Some(_) => {
                        match IrModule_get_struct(& self.module, gn) {
                            OptStructLayout::Some(_) => {
                                return IrType::Struct(gn);
                            }
                            OptStructLayout::None => {
                            }
                        }
                    }
                    OptEnumDef::None => {
                    }
                }
            }
            return Lowerer_key_struct_layout_ir(self, rt);
        }
        _ => {
        }
    }
    return IrType::I64;
}

/// IrType::Struct(name) of a struct-typed `t` (a generic instance too)
/// whose layout the module has, else I64.
fn Lowerer_key_struct_layout_ir(self: & mut Lowerer, t: Type) -> IrType {
    var name: str = lw_rc_type_name(t);
    if name == "" || name == "Vec" || name == "HashMap" || name == "Box" || name == "Rc" || name == "Arc" {
        return IrType::I64;
    }
    match Lowerer_lookup_struct(self, name) {
        OptStructDef::Some(_) => {
            match IrModule_get_struct(& self.module, name) {
                OptStructLayout::Some(_) => {
                    return IrType::Struct(name);
                }
                OptStructLayout::None => {
                }
            }
        }
        OptStructDef::None => {
        }
    }
    return IrType::I64;
}

/// The IR type a tuple key's element of AST type `t` is stored as, as a
/// tuple literal stores it (lw_tuple_field_ty of its value's type): a
/// nested tuple inline as its layout (registered), a struct of
/// the program (a generic one's instance too) inline as the struct,
/// anything else as Lowerer_lower_type gives it (RT5).
fn Lowerer_key_elem_ir(self: & mut Lowerer, t: Type) -> IrType {
    var rt: Type = Lowerer_resolve_type(self, t);
    match rt {
        Type::Tuple(es) => {
            if es.len() > 0 {
                return Lowerer_key_tuple_ir(self, es);
            }
        }
        _ => {
        }
    }
    return Lowerer_held_elem_ir(self, rt);
}

/// Lowerer_key_elem_ir without registering anything: a nested tuple is
/// its shape's layout by name (Lowerer_tuple_name_ro), a struct of the
/// program whose layout the module has (a generic one's instance too)
/// inline as the struct, anything else as Lowerer_lower_type gives it.
fn Lowerer_held_elem_ir(self: & Lowerer, t: Type) -> IrType {
    var rt: Type = Lowerer_resolve_type(self, t);
    match rt {
        Type::Tuple(es) => {
            if es.len() > 0 {
                return IrType::Struct(Lowerer_tuple_name_ro(self, es));
            }
        }
        _ => {
        }
    }
    var name: str = lw_rc_type_name(rt);
    if name != "" && name != "Vec" && name != "HashMap" && name != "Box" && name != "Rc" && name != "Arc" {
        match Lowerer_lookup_struct(self, name) {
            OptStructDef::Some(_) => {
                match IrModule_get_struct(& self.module, name) {
                    OptStructLayout::Some(_) => {
                        return IrType::Struct(name);
                    }
                    OptStructLayout::None => {
                    }
                }
            }
            OptStructDef::None => {
            }
        }
    }
    return Lowerer_lower_type(self, rt);
}

/// The name of the layout of a tuple of AST element types `es`, as
/// Lowerer_key_tuple_ir names (and registers) it (lw_tuple_layout_name of
/// the elements' Lowerer_held_elem_ir), without registering it.
fn Lowerer_tuple_name_ro(self: & Lowerer, es: Vec<Type>) -> str {
    var ftys: Vec<IrType> = Vec::new();
    var i: i64 = 0;
    while i < es.len() {
        ftys.push(lw_tuple_field_ty(Lowerer_held_elem_ir(self, es.get(i))));
        i = i + 1;
    }
    return lw_tuple_layout_name(ftys);
}

/// The element types of `t` when it is a non-empty tuple (an alias
/// resolved; not a reference to one), else an empty list.
fn Lowerer_rc_tuple_elems(self: & Lowerer, t: Type) -> Vec<Type> {
    match Lowerer_resolve_type(self, t) {
        Type::Tuple(es) => {
            return es;
        }
        _ => {
        }
    }
    var none: Vec<Type> = Vec::new();
    return none;
}

/// Whether AST type `t` names one of `params` anywhere in it.
fn lw_type_mentions(t: Type, params: Vec<str>) -> bool {
    if params.len() == 0 {
        return false;
    }
    match t {
        Type::Named(n) => {
            return lw_c_str_vec_contains(params, n);
        }
        Type::Generic(_, a) => {
            var i: i64 = 0;
            while i < a.len() {
                if lw_type_mentions(a.get(i), params) {
                    return true;
                }
                i = i + 1;
            }
        }
        Type::Tuple(es) => {
            var j: i64 = 0;
            while j < es.len() {
                if lw_type_mentions(es.get(j), params) {
                    return true;
                }
                j = j + 1;
            }
        }
        Type::Ref(inner, _) => {
            return lw_type_mentions(lw_box_type_unbox(inner), params);
        }
        _ => {
        }
    }
    return false;
}

/// The IR type a struct field or an enum payload (not a type parameter)
/// of AST type `t` is held as, `params` the type parameters of the struct
/// or enum: a tuple inline as its shape's layout (one that names a type
/// parameter stays a word: its layout depends on the instance), a generic
/// struct's instance inline as the struct (Lowerer_generic_struct_ir), as
/// a tuple literal and a variable hold them; anything else as
/// Lowerer_lower_type gives it. The layouts are registered before
/// (Lowerer_register_held_layouts): one that is not yet stays a word.
fn Lowerer_held_ir(self: & Lowerer, t: Type, params: Vec<str>) -> IrType {
    var rt: Type = Lowerer_resolve_type(self, t);
    var lowered: IrType = Lowerer_lower_type(self, rt);
    match rt {
        Type::Tuple(es) => {
            if es.len() > 0 && !lw_type_mentions(rt, params) {
                var tn: str = Lowerer_tuple_name_ro(self, es);
                match IrModule_get_struct(& self.module, tn) {
                    OptStructLayout::Some(_) => {
                        return IrType::Struct(tn);
                    }
                    OptStructLayout::None => {
                    }
                }
            }
            return lowered;
        }
        Type::Generic(_, _) => {
            return Lowerer_generic_struct_ir(self, lowered);
        }
        _ => {
        }
    }
    return lowered;
}

/// Register the layout of the tuple a struct field or an enum payload of
/// AST type `t` holds inline (Lowerer_held_ir), `params` the type
/// parameters of the struct or enum.
fn Lowerer_register_held_layouts(self: & mut Lowerer, t: Type, params: Vec<str>) {
    var rt: Type = Lowerer_resolve_type(self, t);
    match rt {
        Type::Tuple(es) => {
            if es.len() > 0 && !lw_type_mentions(rt, params) {
                var _r: IrType = Lowerer_key_tuple_ir(self, es);
            }
        }
        _ => {
        }
    }
}

/// Whether the tuple layouts `a` and `b` place their fields alike (as
/// many fields, at the same offsets, the same size): a value laid out as
/// one is read correctly as the other.
fn Lowerer_tuple_layouts_agree(self: & Lowerer, a: str, b: str) -> bool {
    if a == b {
        return true;
    }
    match IrModule_get_struct(& self.module, a) {
        OptStructLayout::Some(la) => {
            match IrModule_get_struct(& self.module, b) {
                OptStructLayout::Some(lb) => {
                    if la.size != lb.size || la.fields.len() != lb.fields.len() {
                        return false;
                    }
                    var i: i64 = 0;
                    while i < la.fields.len() {
                        if la.fields.get(i).offset != lb.fields.get(i).offset {
                            return false;
                        }
                        i = i + 1;
                    }
                    return true;
                }
                OptStructLayout::None => {
                }
            }
        }
        OptStructLayout::None => {
        }
    }
    return false;
}

/// `v` typed as a pointer to the struct `held` (an IR struct type) when it
/// is a word holding that struct's address (a tuple or a generic struct
/// instance a parameter or a Vec gives as a word: Opaque("tuple"), a
/// Generic), else `v` itself.
fn Lowerer_held_addr(self: & mut Lowerer, v: i64, held: IrType) -> i64 {
    match held {
        IrType::Struct(_) => {
        }
        _ => {
            return v;
        }
    }
    var vt: IrType = Lowerer_get_value_type(self, v);
    match vt {
        IrType::Ptr(_) => {
            return v;
        }
        IrType::Struct(_) => {
            return v;
        }
        IrType::Opaque(hon) => {
            if hon != "tuple" {
                return v;
            }
        }
        IrType::Generic(_, _) => {
        }
        _ => {
            return v;
        }
    }
    return Lowerer_emit_inst(self, Inst::BitCast(v, vt, IrType::Ptr(Box::new(held))));
}

/// `v` as the address of the tuple of AST type `t` it is (a word that
/// holds a tuple's address: a parameter, a Vec's or a map's element, ...),
/// typed as a pointer to its layout; `v` itself when it already is a
/// pointer to a struct, or `t` is no tuple.
fn Lowerer_rc_tuple_ptr(self: & mut Lowerer, v: i64, t: Type) -> i64 {
    var es: Vec<Type> = Lowerer_rc_tuple_elems(self, t);
    if es.len() == 0 {
        return v;
    }
    var vt: IrType = Lowerer_get_value_type(self, v);
    match vt {
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(_) => {
                    return v;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    var st: IrType = Lowerer_key_tuple_ir(self, es);
    return Lowerer_emit_inst(self, Inst::BitCast(v, vt, IrType::Ptr(Box::new(st))));
}

/// The IR struct of a tuple (a map key or any other) of AST element types `es`, its
/// layout (and its nested tuples') registered as a tuple literal of those
/// types registers it (RT5: Opaque("tuple"), what Lowerer_lower_type gives
/// a nested tuple, is one word where the literal keeps the tuple inline).
fn Lowerer_key_tuple_ir(self: & mut Lowerer, es: Vec<Type>) -> IrType {
    var tys: Vec<IrType> = Vec::new();
    var i: i64 = 0;
    while i < es.len() {
        tys.push(Lowerer_key_elem_ir(self, es.get(i)));
        i = i + 1;
    }
    return IrType::Struct(Lowerer_register_tuple_layout(self, tys));
}

/// Which words of a tuple of AST element types `es`, laid out from byte
/// `base` as Lowerer_key_tuple_ir lays it out, hold strings: bit
/// (offset / 8) for a `str` element, the strings of a struct element
/// (Lowerer_rc_key_strs_mask) and of a nested tuple; words from 64 on give
/// nothing (RT5: core's hm_fields_hash / hm_fields_eq read them as text).
fn Lowerer_key_tuple_mask(self: & mut Lowerer, es: Vec<Type>, base: i64, depth: i64) -> i64 {
    var mask: i64 = 0;
    if depth > 16 {
        return mask;
    }
    var off: i64 = 0;
    var i: i64 = 0;
    while i < es.len() {
        var et: Type = Lowerer_resolve_type(self, es.get(i));
        var fty: IrType = Lowerer_key_elem_ir(self, et);
        var at: i64 = base + off;
        var nested: bool = false;
        match et {
            Type::Tuple(ies) => {
                if ies.len() > 0 {
                    nested = true;
                    mask = mask | Lowerer_key_tuple_mask(self, ies, at, depth + 1);
                }
            }
            _ => {
            }
        }
        if !nested {
            if Lowerer_rc_kind(self, et) == RC_STR || lw_is_borrowed_str(et) {
                if at % 8 == 0 && at / 8 < 64 {
                    mask = mask | lw_key_bit(at / 8);
                }
            } else if Lowerer_rc_is_mem_type(self, et) {
                match Lowerer_lookup_struct(self, lw_rc_type_name(et)) {
                    OptStructDef::Some(_) => {
                        mask = mask | Lowerer_rc_key_strs_mask(self, et, at, depth + 1);
                    }
                    OptStructDef::None => {
                    }
                }
            }
        }
        off = off + IrModule_type_size(& self.module, fty);
        off = (off + 7) / 8 * 8;
        i = i + 1;
    }
    return mask;
}

/// `v[i] = x` for a struct element stored in the buffer: Vec_set_mem(v, i,
/// x, size, tid). False when it does not apply (the caller boxes it).
fn Lowerer_vec_set_mem(self: & mut Lowerer, arr: i64, idx: i64, val: i64, elem_ty: IrType, et: Type) -> bool {
    match elem_ty {
        IrType::Struct(_) => {
        }
        _ => {
            return false;
        }
    }
    var size: i64 = Lowerer_vec_mem_size(self, "Vec_set", elem_ty);
    if size == 0 {
        return false;
    }
    var tid: i64 = 0;
    if self.own_on {
        tid = Lowerer_rc_tid(self, et);
    }
    if tid < 16 || tid >= 0x8000 {
        tid = 0;
    }
    var a: Vec<i64> = Vec::new();
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
    a.push(arr);
    a.push(idx);
    a.push(val);
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(size, IrType::I64)));
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(tid, IrType::I64)));
    Lowerer_emit_inst(self, Inst::Call("Vec_set_mem", a, IrType::Void, lw_rc_eff()));
    return true;
}

/// Release D15: `&v[i]` / `&mut v[i]` refer to the element where it is
/// stored (core `Vec_elem_addr`, or the array element's address), so a write
/// through the reference changes the container. The borrow checker keeps the
/// container unchanged while the reference lives. Off: the element is copied
/// to a temporary and the reference points at the copy (writes are lost).
const LOWER_REF_INDEX: bool = true; fn Lowerer_ref_index_addr(self: & mut Lowerer, arr: Box<Expr>, idx: Box<Expr>, is_mut: bool) -> i64 {
    var et: Type = Lowerer_infer_expr_ast_type(self, Expr::Index(arr, idx));
    var arr_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(arr));
    // through a `&Vec` / `&mut Vec`: the Vec it refers to
    arr_val = Lowerer_auto_deref_recv(self, arr_val, Lowerer_get_value_type(self, arr_val));
    var idx_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(idx));
    var arr_ty: IrType = Lowerer_get_value_type(self, arr_val);
    if ir_type_is_opaque_named(arr_ty, "Vec") || ir_type_eq(arr_ty, IrType::I64) {
        var elem_ty: IrType = Lowerer_lower_type(self, et);
        var is_struct: i64 = 0;
        match elem_ty {
            IrType::Struct(_) => {
                is_struct = 1;
            }
            _ => {
            }
        }
        var w: i64 = 0;
        if is_mut {
            w = 1;
        }
        var a: Vec<i64> = Vec::new();
        a.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
        a.push(arr_val);
        a.push(idx_val);
        a.push(Lowerer_emit_inst(self, Inst::ConstInt(w, IrType::I64)));
        a.push(Lowerer_emit_inst(self, Inst::ConstInt(is_struct, IrType::I64)));
        var raw: i64 = Lowerer_emit_inst(self, Inst::Call("Vec_elem_addr", a, IrType::I64, lw_rc_eff()));
        return Lowerer_emit_inst(self, Inst::BitCast(raw, IrType::I64, IrType::Ptr(Box::new(elem_ty))));
    }
    // a fixed-size array: the element's address
    var aelem: IrType = IrType::I64;
    match arr_ty {
        IrType::Array(inner, _) => {
            aelem = box_ir_type_unbox(inner);
        }
        IrType::Ptr(inner2) => {
            match box_ir_type_unbox(inner2) {
                IrType::Array(inner3, _) => {
                    aelem = box_ir_type_unbox(inner3);
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    Lowerer_emit_array_bound_check(self, arr_ty, idx_val);
    return Lowerer_emit_inst(self, Inst::GetElemPtr(arr_val, idx_val, aelem));
}

/// M6 (miscompile-log; reference §3.2, §8.2): an index into a fixed-size
/// array of known length is checked, outside `unsafe`, on every backend:
/// `Panic: Array index out of bounds`. The interpreter checked it itself
/// and `fid wasm` too (CI5); `emit`, `--nat` and the C path read past the
/// end. -1 when `ty` is not `[T; N]` or a pointer to one with N known.
fn lw_fixed_array_len(ty: IrType) -> i64 {
    match ty {
        IrType::Array(_, n) => {
            return n;
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Array(_, n2) => {
                    return n2;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return 0 - 1;
}

/// Whether the instruction being emitted lies inside an `unsafe` block of
/// the current function (more UnsafeBegin than UnsafeEnd so far).
fn Lowerer_in_unsafe(self: & Lowerer) -> bool {
    var depth: i64 = 0;
    var i: i64 = 0;
    while i < self.current_func.insts.len() {
        match self.current_func.insts.get(i).inst {
            Inst::UnsafeBegin => {
                depth = depth + 1;
            }
            Inst::UnsafeEnd => {
                if depth > 0 {
                    depth = depth - 1;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return depth > 0;
}

/// M6: `if idx < 0 || idx >= N { p_panic("Array index out of bounds") }`
/// before a GetElemPtr into an array of `arr_ty` (lw_fixed_array_len).
pub fn Lowerer_emit_array_bound_check(self: & mut Lowerer, arr_ty: IrType, idx_val: i64) {
    var n: i64 = lw_fixed_array_len(arr_ty);
    if n < 0 || Lowerer_in_unsafe(self) {
        return;
    }
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var neg: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, idx_val, zero, IrType::Bool));
    var bad_bb: i64 = Lowerer_new_block(self);
    var hi_bb: i64 = Lowerer_new_block(self);
    var ok_bb: i64 = Lowerer_new_block(self);
    Lowerer_emit_terminator(self, Inst::Branch(neg, bad_bb, hi_bb));
    Lowerer_set_current_block(self, hi_bb);
    var len_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(n, IrType::I64));
    var over: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::GtEq, idx_val, len_val, IrType::Bool));
    Lowerer_emit_terminator(self, Inst::Branch(over, bad_bb, ok_bb));
    Lowerer_set_current_block(self, bad_bb);
    var msg: i64 = Lowerer_emit_inst(self, Inst::ConstStr("Array index out of bounds"));
    var pargs: Vec<i64> = Vec::new();
    pargs.push(msg);
    var peff: EffectSet = EffectSet_new();
    EffectSet_add(& mut peff, Effect::IO);
    var _p: i64 = Lowerer_emit_inst(self, Inst::Call("p_panic", pargs, IrType::Void, peff));
    Lowerer_emit_terminator(self, Inst::Jump(ok_bb));
    Lowerer_set_current_block(self, ok_bb);
}

// Helper: box a struct value at the last index of call_args
pub fn Lowerer_box_struct_arg(self: & mut Lowerer, call_args: & mut Vec<i64>, struct_ty: IrType) {
    var val_idx: i64 = call_args.len() - 1;
    var val: i64 = call_args.get(val_idx);
    var size: i64 = IrModule_type_size(& self.module, struct_ty);
    if size <= 0 {
        size = 8;
    }
    var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(size, IrType::I64));
    var heap_ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(size_val), IrType::Ptr(Box::new(struct_ty)), EffectSet_new()));
    Lowerer_emit_inst(self, Inst::Store(heap_ptr, val, OptIrType::Some(struct_ty)));
    call_args.set(val_idx, heap_ptr);
}

// --- Lowerer_lower_expr helper functions ----------------------------------
// These are split out from Lowerer_lower_expr to avoid the statement-dropping
// bug that affects very long functions in the self-hosted compiler.

fn Lowerer_resolve_call_args(self: & mut Lowerer, callee: str, args: Vec<Expr>) -> Vec<Expr> {
    // Look up param names and defaults for this function
    var param_names: Vec<str> = Lowerer_lookup_param_names(self, callee);
    var defaults: Vec<Expr> = Lowerer_lookup_defaults(self, callee);
    return lw_resolve_args(param_names, defaults, args, OptBoxExpr::None);
}

/// Arguments `args` of a call in parameter order (`param_names`): named
/// ones put at their parameter, a missing one given its default
/// (`defaults`, one per parameter; BG424: a default's helper call gets the
/// call's own arguments, lw_dflt_bind, and `recv` for a method's `self`).
/// Shared by plain calls (Lowerer_resolve_call_args) and, BG389, method
/// calls (Lowerer_method_call_args).
fn lw_resolve_args(param_names: Vec<str>, defaults: Vec<Expr>, args: Vec<Expr>, recv: OptBoxExpr) -> Vec<Expr> {
    var n_params: i64 = param_names.len();
    if n_params == 0 {
        // Unknown function — can't resolve, return as-is
        return args;
    }

    // Check if any args are named
    var has_named: bool = false;
    var ai: i64 = 0;
    while ai < args.len() {
        match args.get(ai) {
            Expr::NamedArg(_, _) => {
                has_named = true;
            }
            _ => {
            }
        }
        ai = ai + 1;
    }

    if !has_named {
        // No named args — fill in defaults for missing args
        if args.len() >= n_params {
            return args;
        }
        var result: Vec<Expr> = Vec::new();
        ai = 0;
        while ai < args.len() {
            result.push(args.get(ai));
            ai = ai + 1;
        }
        // Fill in defaults for remaining params
        ai = args.len();
        while ai < n_params {
            if ai < defaults.len() {
                var dbv: Expr = lw_dflt_bind(defaults.get(ai), param_names, result, recv);
                result.push(dbv);
            } else {
                result.push(Expr::IntLit(0));
            }
            ai = ai + 1;
        }
        return result;
    }

    // Named args present — resolve to positional order using param names
    // Build positional array — use a Vec<Expr> and a Vec<bool> to track filled slots
    var positional: Vec<Expr> = Vec::new();
    var filled: Vec<bool> = Vec::new();
    var pi: i64 = 0;
    while pi < n_params {
        positional.push(Expr::IntLit(0));
        filled.push(false);
        pi = pi + 1;
    }

    // Place positional args first, then named args by name
    var pos_idx: i64 = 0;
    ai = 0;
    while ai < args.len() {
        match args.get(ai) {
            Expr::NamedArg(name, e) => {
                // Find the param index by name
                var found_idx: i64 = - 1;
                var ni: i64 = 0;
                while ni < n_params {
                    if param_names.get(ni) == name {
                        found_idx = ni;
                    }
                    ni = ni + 1;
                }
                if found_idx >= 0 {
                    positional.set(found_idx, lw_box_expr_unbox(e));
                    filled.set(found_idx, true);
                }
            }
            other => {
                if pos_idx < n_params {
                    positional.set(pos_idx, other);
                    filled.set(pos_idx, true);
                    pos_idx = pos_idx + 1;
                }
            }
        }
        ai = ai + 1;
    }

    // Build result — filled slots get their value, unfilled get defaults
    var result: Vec<Expr> = Vec::new();
    pi = 0;
    while pi < n_params {
        if filled.get(pi) {
            result.push(positional.get(pi));
        } else if pi < defaults.len() {
            var dbv2: Expr = lw_dflt_bind(defaults.get(pi), param_names, result, recv);
            result.push(dbv2);
        } else {
            result.push(Expr::IntLit(0));
        }
        pi = pi + 1;
    }
    return result;
}

fn Lowerer_lookup_defaults(self: & mut Lowerer, callee: str) -> Vec<Expr> {
    var at: i64 = HashMap_get(self.func_info_at, callee);
    if at != 0 {
        return self.func_defaults.get(at - 1).val;
    }
    var result: Vec<Expr> = Vec::new();
    return result;
}

fn Lowerer_lookup_param_names(self: & mut Lowerer, callee: str) -> Vec<str> {
    // Look up function param names from the func_param_names table
    var at: i64 = HashMap_get(self.func_info_at, callee);
    if at != 0 {
        return self.func_param_names.get(at - 1).val;
    }
    var result: Vec<str> = Vec::new();
    return result;
}

fn Lowerer_extern_index(self: & Lowerer, name: str) -> i64 {
    // CS4: by the index, not a scan
    return Lowerer_extern_at(self, name);
}

// The Fides function argument `i` of an extern hands to C, or ""
fn Lowerer_c_callback(self: & Lowerer, ext_idx: i64, i: i64, arg: Expr) -> str {
    var params: Vec<IrType> = self.module.extern_functions.get(ext_idx).params;
    if i >= params.len() {
        return "";
    }
    match params.get(i) {
        IrType::Opaque(o) => {
            if o != "func" {
                return "";
            }
        }
        _ => {
            return "";
        }
    }
    match arg {
        Expr::Ident(name) => {
            if Lowerer_is_user_func(self, name) {
                return name;
            }
        }
        _ => {
        }
    }
    return "";
}

// CM3 (release M5, docs/proposals/0006-m5-ownership-replaces-cow.md): the
// copy-on-write lowering of proposal 0001 (`LOWER_COW`: a share inserted
// at each copy, passed argument and stored struct) is retired and its code
// removed. Ownership (proposal 0004, LOWER_RC below) is the one rule: a
// place that keeps a value takes an owner of its own, so `var b = a` then a
// change to b leaves a as it was (tests/conformance/s5_3_copy_then_change.fd).
// A write to a buffer two owners share still copies it first (core's
// vec_own); that is the runtime's copy-on-write, not this lowering's.

/// Whether callers pass a share of each by-value Vec argument (then a
/// callee could free the parameters it only borrows at its return). Off:
/// callers pass their own handle, so a by-value parameter is never the
/// callee's to hand over (Lowerer_last_use).
const LOWER_ARG_SHARE: bool = false;  /// Methods that change the Vec or HashMap they are called on.
fn lw_changing_method(m: str) -> bool {
    return m == "push" || m == "pop" || m == "set" || m == "insert" || m == "remove" || m == "clear" || m == "truncate" || m == "extend" || m == "sort" || m == "reverse" || m == "resize" || m == "swap" || m == "append" || m == "retain" || m == "dedup" || m == "push_str" || m == "drain" || m == "sort_by";
}

/// Copy-on-write before a write into an element (proposal 0001): every Vec
/// an element path goes through (`v.get(i)`, `v[i]`, `v.first()`) is made
/// this side's own, outermost first, so the element written is not one a
/// copy still shares. Reading the path again is harmless: a path is fields,
/// indexes and element reads.
fn Lowerer_own_path(self: & mut Lowerer, e: Expr) {
    match e {
        Expr::FieldAccess(obj, _) => {
            Lowerer_own_path(self, lw_box_expr_unbox(obj));
        }
        Expr::MethodCall(recv, m, _) => {
            if m == "get" || m == "first" || m == "last" {
                var r: Expr = lw_box_expr_unbox(recv);
                Lowerer_own_path(self, r);
                Lowerer_emit_vec_own(self, r);
            }
        }
        Expr::Index(arr, _) => {
            var a: Expr = lw_box_expr_unbox(arr);
            Lowerer_own_path(self, a);
            Lowerer_emit_vec_own(self, a);
        }
        _ => {
        }
    }
}

fn Lowerer_emit_vec_own(self: & mut Lowerer, e: Expr) {
    var v: i64 = Lowerer_lower_expr(self, e);
    var is_vec: bool = false;
    match Lowerer_get_value_type(self, v) {
        IrType::Generic(gn, _) => {
            is_vec = gn == "Vec";
        }
        IrType::Opaque(oname) => {
            is_vec = oname == "Vec";
        }
        _ => {
        }
    }
    if !is_vec {
        return;
    }
    var eff: EffectSet = EffectSet_new();
    EffectSet_add(& mut eff, Effect::Alloc);
    EffectSet_add(& mut eff, Effect::Write);
    var args: Vec<i64> = Vec::new();
    args.push(IrFunction_emit(& mut self.current_func, Inst::ConstInt(0, IrType::I64)));
    args.push(v);
    IrFunction_emit(& mut self.current_func, Inst::Call("vec_own", args, IrType::Void, eff));
}

/// A value about to be stored in a second place (a variable, a field, a struct
/// literal, a returned value). CM3: under the retired copy-on-write
/// (proposal 0001, LOWER_COW) a Vec or HashMap read from a place was shared
/// here; under ownership (proposal 0004) the place that keeps it takes an
/// owner of its own (Lowerer_rc_own_value), so this lowers the value.
fn Lowerer_lower_value(self: & mut Lowerer, expr: Expr) -> i64 {
    return Lowerer_lower_expr(self, expr);
}

fn lw_is_last_use(self: & Lowerer, expr: Expr) -> bool {
    match expr {
        Expr::Ident(n) => {
            return Lowerer_last_use(self, n);
        }
        _ => {
        }
    }
    return false;
}

/// OW7: the set (raw HashMap name -> 1; 0: none worked out) of the
/// variables the function being lowered takes a reference to anywhere,
/// worked out once per function where cur_has_defer is. Lowerer_last_use
/// does not move such a variable: a reference read after the move would
/// read the moved-out value (a null Vec handle on C:
/// tests/verify/bugs/ow7_copy_moves_while_borrowed.fd).
var g_lw_ref_taken: i64 = 0;
/// BG46: while lw_ref_roots walks a function body, the depth of the loop
/// the walk is inside — an `await x` there runs once per iteration, not
/// once, so it counts as awaited again (lw_ref_roots_expr).
var g_lw_roots_loop: i64 = 0;

/// OW7: the variables `stmts` takes a reference to (`&x`, `&mut x`, or of
/// a field or element path rooted at x: cow_root), into the set `m`.
fn lw_ref_roots_stmts(stmts: Vec<Stmt>, m: i64) {
    var i: i64 = 0;
    while i < stmts.len() {
        lw_ref_roots_stmt(stmts.get(i), m);
        i = i + 1;
    }
}

fn lw_ref_roots_opt(o: OptBoxExpr, m: i64) {
    match o {
        OptBoxExpr::Some(ob) => {
            lw_ref_roots_expr(box_expr_unbox(ob), m);
        }
        OptBoxExpr::None => {
        }
    }
}

fn lw_ref_roots_opt_stmts(o: OptStmts, m: i64) {
    match o {
        OptStmts::Some(os) => {
            lw_ref_roots_stmts(os, m);
        }
        OptStmts::None => {
        }
    }
}

fn lw_ref_roots_exprs(es: Vec<Expr>, m: i64) {
    var i: i64 = 0;
    while i < es.len() {
        lw_ref_roots_expr(es.get(i), m);
        i = i + 1;
    }
}

fn lw_ref_roots_arms(arms: Vec<MatchArm>, m: i64) {
    var a: i64 = 0;
    while a < arms.len() {
        var arm: MatchArm = arms.get(a);
        lw_ref_roots_opt(arm.guard, m);
        lw_ref_roots_stmts(arm.body, m);
        a = a + 1;
    }
}

fn lw_ref_roots_stmt(s: Stmt, m: i64) {
    match s {
        Stmt::Let(_, _, le, _, _, _, _) => {
            lw_ref_roots_expr(le, m);
        }
        Stmt::LetTuple(_, lte, _, _) => {
            lw_ref_roots_expr(lte, m);
        }
        Stmt::Assign(_, _, ae, _) => {
            lw_ref_roots_expr(ae, m);
        }
        Stmt::IndexAssign(_, iix, _, iae, _) => {
            lw_ref_roots_expr(iix, m);
            lw_ref_roots_expr(iae, m);
        }
        Stmt::DerefAssign(dpe, _, dae, _) => {
            lw_ref_roots_expr(dpe, m);
            lw_ref_roots_expr(dae, m);
        }
        Stmt::FieldAssign(fobj, _, _, fae, _) => {
            lw_ref_roots_expr(fobj, m);
            lw_ref_roots_expr(fae, m);
        }
        Stmt::Expr(xe, _) => {
            lw_ref_roots_expr(xe, m);
        }
        Stmt::Return(roe, _) => {
            lw_ref_roots_opt(roe, m);
        }
        Stmt::Break(boe, _) => {
            lw_ref_roots_opt(boe, m);
        }
        Stmt::If(ic, itb, ieb, _) => {
            lw_ref_roots_expr(ic, m);
            lw_ref_roots_stmts(itb, m);
            lw_ref_roots_opt_stmts(ieb, m);
        }
        Stmt::While(wc, wb, _) => {
            // the condition awaits again each round as the body does
            g_lw_roots_loop = g_lw_roots_loop + 1;
            lw_ref_roots_expr(wc, m);
            lw_ref_roots_stmts(wb, m);
            g_lw_roots_loop = g_lw_roots_loop - 1;
        }
        Stmt::For(_, fit, fb, _) => {
            lw_ref_roots_expr(fit, m);
            g_lw_roots_loop = g_lw_roots_loop + 1;
            lw_ref_roots_stmts(fb, m);
            g_lw_roots_loop = g_lw_roots_loop - 1;
        }
        Stmt::Loop(lb, _) => {
            g_lw_roots_loop = g_lw_roots_loop + 1;
            lw_ref_roots_stmts(lb, m);
            g_lw_roots_loop = g_lw_roots_loop - 1;
        }
        Stmt::Defer(db, _) => {
            lw_ref_roots_stmts(db, m);
        }
        Stmt::Match(me, marms, _) => {
            lw_ref_roots_expr(me, m);
            lw_ref_roots_arms(marms, m);
        }
        Stmt::Handle(hb, _, _) => {
            lw_ref_roots_stmts(hb, m);
        }
        Stmt::Do(_, _, dargs, _) => {
            lw_ref_roots_exprs(dargs, m);
        }
        Stmt::RegionBlock(_, _, _, _, _, rgb, _) => {
            lw_ref_roots_stmts(rgb, m);
        }
        Stmt::Sandbox(sbb, _) => {
            lw_ref_roots_stmts(sbb, m);
        }
        Stmt::Unsafe(ub, _) => {
            lw_ref_roots_stmts(ub, m);
        }
        Stmt::Txn(txb, _) => {
            lw_ref_roots_stmts(txb, m);
        }
        Stmt::ComptimeGen(cgb, _) => {
            lw_ref_roots_stmts(cgb, m);
        }
        Stmt::GradBlock(_, gb, _) => {
            lw_ref_roots_stmts(gb, m);
        }
        Stmt::Backward(bwe, _) => {
            lw_ref_roots_expr(bwe, m);
        }
        Stmt::Query(_, qb, _) => {
            lw_ref_roots_stmts(qb, m);
        }
        Stmt::Select(_, sdef, _) => {
            lw_ref_roots_opt_stmts(sdef, m);
        }
        Stmt::Parallel(pbrs, _) => {
            var pi: i64 = 0;
            while pi < pbrs.len() {
                var pbr: Vec<Stmt> = pbrs.get(pi);
                lw_ref_roots_stmts(pbr, m);
                pi = pi + 1;
            }
        }
        Stmt::Resume(rce, rve, _) => {
            lw_ref_roots_expr(rce, m);
            lw_ref_roots_expr(rve, m);
        }
        Stmt::SpawnScope(ssb, _) => {
            lw_ref_roots_stmts(ssb, m);
        }
        _ => {
        }
    }
}

fn lw_ref_roots_expr(e: Expr, m: i64) {
    match e {
        Expr::Ref(rx, _) => {
            var rinner: Expr = box_expr_unbox(rx);
            var root: str = cow_root(rinner);
            if root != "" {
                HashMap_insert(m, root, 1);
            }
            lw_ref_roots_expr(rinner, m);
        }
        Expr::Binary(_, bl, br) => {
            lw_ref_roots_expr(box_expr_unbox(bl), m);
            lw_ref_roots_expr(box_expr_unbox(br), m);
        }
        Expr::Unary(_, ux) => {
            lw_ref_roots_expr(box_expr_unbox(ux), m);
        }
        Expr::Call(_, cargs) => {
            lw_ref_roots_exprs(cargs, m);
        }
        Expr::FieldAccess(fo, _) => {
            lw_ref_roots_expr(box_expr_unbox(fo), m);
        }
        Expr::OptionalFieldAccess(ofo, _) => {
            lw_ref_roots_expr(box_expr_unbox(ofo), m);
        }
        Expr::StructLit(_, sfields, sspread) => {
            var sfi: i64 = 0;
            while sfi < sfields.len() {
                lw_ref_roots_expr(sfields.get(sfi).value, m);
                sfi = sfi + 1;
            }
            lw_ref_roots_opt(sspread, m);
        }
        Expr::If(eic, eitb, eieb) => {
            lw_ref_roots_expr(box_expr_unbox(eic), m);
            lw_ref_roots_stmts(eitb, m);
            lw_ref_roots_opt_stmts(eieb, m);
        }
        Expr::Range(rga, rgb2, _) => {
            lw_ref_roots_expr(box_expr_unbox(rga), m);
            lw_ref_roots_expr(box_expr_unbox(rgb2), m);
        }
        Expr::Block(bks) => {
            lw_ref_roots_stmts(bks, m);
        }
        Expr::MethodCall(mrc, _, margs) => {
            lw_ref_roots_expr(box_expr_unbox(mrc), m);
            lw_ref_roots_exprs(margs, m);
        }
        Expr::ArrayLit(_, aels) => {
            lw_ref_roots_exprs(aels, m);
        }
        Expr::Index(xa, xb) => {
            lw_ref_roots_expr(box_expr_unbox(xa), m);
            lw_ref_roots_expr(box_expr_unbox(xb), m);
        }
        Expr::FString(fparts) => {
            var fpi: i64 = 0;
            while fpi < fparts.len() {
                match fparts.get(fpi) {
                    FStringPart::Expr(fpe) => {
                        lw_ref_roots_expr(fpe, m);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                fpi = fpi + 1;
            }
        }
        Expr::Match(mme, mmarms) => {
            lw_ref_roots_expr(box_expr_unbox(mme), m);
            lw_ref_roots_arms(mmarms, m);
        }
        Expr::EnumLit(_, _, eargs) => {
            lw_ref_roots_exprs(eargs, m);
        }
        Expr::Deref(dx) => {
            lw_ref_roots_expr(box_expr_unbox(dx), m);
        }
        Expr::StrConcat(scl, scr) => {
            lw_ref_roots_expr(box_expr_unbox(scl), m);
            lw_ref_roots_expr(box_expr_unbox(scr), m);
        }
        Expr::Try(tx) => {
            lw_ref_roots_expr(box_expr_unbox(tx), m);
        }
        Expr::Coalesce(coa, cob) => {
            lw_ref_roots_expr(box_expr_unbox(coa), m);
            lw_ref_roots_expr(box_expr_unbox(cob), m);
        }
        Expr::IsCheck(isx, _) => {
            lw_ref_roots_expr(box_expr_unbox(isx), m);
        }
        Expr::TryBlock(tbs) => {
            lw_ref_roots_stmts(tbs, m);
        }
        Expr::TupleLit(tels) => {
            lw_ref_roots_exprs(tels, m);
        }
        Expr::Closure(_, clb, _) => {
            lw_ref_roots_stmts(clb, m);
        }
        Expr::Cast(cx, _) => {
            lw_ref_roots_expr(box_expr_unbox(cx), m);
        }
        Expr::Comptime(ctx) => {
            lw_ref_roots_expr(box_expr_unbox(ctx), m);
        }
        Expr::ComptimeBlock(ctb) => {
            lw_ref_roots_stmts(ctb, m);
        }
        Expr::PipeForward(ppa, ppb) => {
            lw_ref_roots_expr(box_expr_unbox(ppa), m);
            lw_ref_roots_expr(box_expr_unbox(ppb), m);
        }
        Expr::QuantCast(qx, _) => {
            lw_ref_roots_expr(box_expr_unbox(qx), m);
        }
        Expr::Await(awx) => {
            // BG46: how many `await x` the body has of each variable x,
            // under "#aw:x" (no variable's name: lw_awaited_again)
            match box_expr_unbox(awx) {
                Expr::Ident(awn) => {
                    var awk: str = "#aw:" + awn;
                    // one await inside a loop body is awaited again every
                    // iteration: each takes an owner of its own, as two
                    // awaits do
                    if g_lw_roots_loop > 0 {
                        HashMap_insert(m, awk, HashMap_get(m, awk) + 2);
                    } else {
                        HashMap_insert(m, awk, HashMap_get(m, awk) + 1);
                    }
                }
                _ => {
                }
            }
            lw_ref_roots_expr(box_expr_unbox(awx), m);
        }
        Expr::Spawn(spx) => {
            lw_ref_roots_expr(box_expr_unbox(spx), m);
        }
        Expr::Yield(yx) => {
            lw_ref_roots_expr(box_expr_unbox(yx), m);
        }
        Expr::NamedArg(_, nax) => {
            lw_ref_roots_expr(box_expr_unbox(nax), m);
        }
        _ => {
        }
    }
}

/// OW7: the set g_lw_ref_taken is for a function body.
fn lw_ref_taken_of(stmts: Vec<Stmt>) -> i64 {
    g_lw_roots_loop = 0;
    var m: i64 = HashMap_new();
    lw_ref_roots_stmts(stmts, m);
    g_lw_roots_loop = 0;
    return m;
}

/// BG46: whether the function being lowered awaits the future in variable
/// `n` more than once (lw_ref_roots_expr counts them). Every await of it
/// then polls the same result: each takes an owner of its own, where one
/// await alone is handed the task's.
fn lw_awaited_again(n: str) -> bool {
    if g_lw_ref_taken == 0 {
        return false;
    }
    return HashMap_get(g_lw_ref_taken, "#aw:" + n) > 1;
}

fn lw_has_defer(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Defer(_, _) => {
                return true;
            }
            Stmt::If(_, tb, eb, _) => {
                if lw_has_defer(tb) {
                    return true;
                }
                match eb {
                    OptStmts::Some(b) => {
                        if lw_has_defer(b) {
                            return true;
                        }
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(_, wb, _) => {
                if lw_has_defer(wb) {
                    return true;
                }
            }
            Stmt::For(_, _, fb, _) => {
                if lw_has_defer(fb) {
                    return true;
                }
            }
            Stmt::Loop(lb, _) => {
                if lw_has_defer(lb) {
                    return true;
                }
            }
            Stmt::Match(_, arms, _) => {
                var a: i64 = 0;
                while a < arms.len() {
                    if lw_has_defer(arms.get(a).body) {
                        return true;
                    }
                    a = a + 1;
                }
            }
            Stmt::RegionBlock(_, _, _, _, _, rb, _) => {
                if lw_has_defer(rb) {
                    return true;
                }
            }
            Stmt::Unsafe(ub, _) => {
                if lw_has_defer(ub) {
                    return true;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

/// Whether this read of the variable `n` is its last (move on last use,
/// proposal 0001): the statement being lowered uses it once, nothing after
/// it in any enclosing list does, no enclosing statement is a loop (its
/// next round would read it again), the function has no `defer`, and `n`
/// is a local or by-value parameter. Then the value can be handed over
/// without a copy of its own.
fn Lowerer_last_use(self: & Lowerer, n: str) -> bool {
    if !LOWER_RC {
        return false;
    }
    var depth: i64 = self.fr_lists.len();
    if depth == 0 || depth != self.fr_idx.len() {
        return false;
    }
    var is_local: bool = false;
    match Lowerer_lookup_alloca(self, n) {
        OptValueId::Some(_) => {
            is_local = true;
        }
        OptValueId::None => {
        }
    }
    if !is_local {
        match Lowerer_lookup_local(self, n) {
            OptValueId::Some(_) => {
                is_local = true;
            }
            OptValueId::None => {
            }
        }
    }
    if !is_local {
        return false;
    }
    match Lowerer_lookup_param_type(self, n) {
        OptType::Some(pt) => {
            match pt {
                Type::Ref(_, _) => {
                    return false;
                }
                _ => {
                }
            }
            // Without argument shares the caller passes its own handle: a
            // by-value parameter is not the callee's to hand over (`var w =
            // v; w.push(..)` changed the caller's Vec, and a spawned task's
            // raced with it: test_spawn_vec_copy)
            if !LOWER_ARG_SHARE {
                return false;
            }
        }
        OptType::None => {
        }
    }
    // SP12: lw_has_defer(self.cur_body), worked out once per function
    if self.cur_has_defer {
        return false;
    }
    // OW7: a variable the function takes a reference to anywhere is not
    // moved out: a reference read after the move would read the moved-out
    // value (tests/verify/bugs/ow7_copy_moves_while_borrowed.fd)
    if g_lw_ref_taken != 0 && HashMap_contains(g_lw_ref_taken, n) {
        return false;
    }
    var k: i64 = 0;
    while k < depth {
        var list: Vec<Stmt> = self.fr_lists.get(k);
        var at: i64 = self.fr_idx.get(k);
        if at < 0 || at >= list.len() {
            return false;
        }
        if k + 1 < depth {
            match list.get(at) {
                Stmt::While(_, _, _) => {
                    return false;
                }
                Stmt::For(_, _, _, _) => {
                    return false;
                }
                Stmt::Loop(_, _) => {
                    return false;
                }
                _ => {
                }
            }
        }
        // SP12: whether a later statement of the list uses `n`, from the
        // list's index (Lowerer_used_after) instead of a walk of the rest
        // of the list per kept variable
        if Lowerer_used_after(self, k, list, at, n) {
            return false;
        }
        k = k + 1;
    }
    // the statement itself uses it once (checked after the cheap index
    // lookups above, which only ever answer false sooner)
    if cow_uses_stmt(self.fr_lists.get(0).get(self.fr_idx.get(0)), n) != 1 {
        return false;
    }
    return true;
}

/// SP12: whether a statement of `list` (fr_lists level `k`) after `at` uses
/// `n`: what `cow_uses_stmt(list.get(r), n) != 0` for some r > at said. The
/// level's map (fr_lu) is filled on first use with cowcheck's
/// cow_names_stmt, one walk of the list; without a map for the level the
/// statements are walked as before.
fn Lowerer_used_after(self: & Lowerer, k: i64, list: Vec<Stmt>, at: i64, n: str) -> bool {
    if k < 0 || k >= self.fr_lu.len() || self.fr_lu.len() != self.fr_lists.len() {
        var r: i64 = at + 1;
        while r < list.len() {
            if cow_uses_stmt(list.get(r), n) != 0 {
                return true;
            }
            r = r + 1;
        }
        return false;
    }
    var m: i64 = self.fr_lu.get(k);
    lw_lu_fill(m, list);
    var last: i64 = HashMap_get(m, n);
    var la: i64 = HashMap_get(m, "#all");
    if la > last {
        last = la;
    }
    // `last` is 1 + the index of the last statement that uses n (0: none)
    return last - 1 > at;
}

/// SP12: fill a statement list's fr_lu map (once: "#built"). For every name
/// cowcheck's cow_names_stmt finds in a statement r of `list`, and "#all"
/// for a statement that counts for every name: name -> 1 + the last such
/// r, and "name@r" -> 1 + the one before r (0: none), so the statements
/// that mention a name are found without walking the others.
fn lw_lu_fill(m: i64, list: Vec<Stmt>) {
    if HashMap_get(m, "#built") != 0 {
        return;
    }
    var r: i64 = 0;
    while r < list.len() {
        var names: Vec<str> = Vec::new();
        if cow_names_stmt(list.get(r), & mut names) {
            names.push("#all");
        }
        var i: i64 = 0;
        while i < names.len() {
            var nm: str = names.get(i);
            var prev: i64 = HashMap_get(m, nm);
            // a name met twice in one statement is recorded once
            if prev != r + 1 {
                if prev > 0 {
                    HashMap_insert(m, nm + "@" + int_to_str(r), prev);
                }
                HashMap_insert(m, nm, r + 1);
            }
            i = i + 1;
        }
        r = r + 1;
    }
    HashMap_insert(m, "#built", 1);
}

/// SP12: the statements of a filled fr_lu map's list at `from` or later
/// that mention `nm` or count for every name ("#all"), in order.
fn lw_lu_from(m: i64, nm: str, from: i64) -> Vec<i64> {
    // both chains run from the last statement back
    var a: Vec<i64> = Vec::new();
    var p: i64 = HashMap_get(m, nm) - 1;
    while p >= from {
        a.push(p);
        p = HashMap_get(m, nm + "@" + int_to_str(p)) - 1;
    }
    var b: Vec<i64> = Vec::new();
    var q: i64 = HashMap_get(m, "#all") - 1;
    while q >= from {
        b.push(q);
        q = HashMap_get(m, "#all@" + int_to_str(q)) - 1;
    }
    // merged, first statement first, each once
    var out: Vec<i64> = Vec::new();
    var i: i64 = a.len() - 1;
    var j: i64 = b.len() - 1;
    while i >= 0 || j >= 0 {
        var x: i64 = 0;
        if j < 0 || (i >= 0 && a.get(i) <= b.get(j)) {
            x = a.get(i);
            i = i - 1;
        } else {
            x = b.get(j);
            j = j - 1;
        }
        if out.len() == 0 || out.get(out.len() - 1) != x {
            out.push(x);
        }
    }
    return out;
}

/// SP12: what Lowerer_readonly_copy_in (not `outer`) asks of `nm` over the
/// rest of its list (rest_of from rest_from): 1 when nothing there changes,
/// writes back or assigns it (cow_first_change == 0, !cow_written_back,
/// not among collect_assign_targets), 0 when something does, -1 when the
/// list's map cannot tell. Only the statements that mention nm, or that
/// cow_names_stmt does not look into, are asked, each alone: a statement
/// that mentions nm nowhere neither changes, writes back nor assigns it
/// (cow_first_change and cow_written_back need the name in what they walk,
/// which cow_names_stmt walks too; an assignment target is a name it
/// records). cow_first_change stops at the first statement that changes the
/// name and returns that statement's line: a statement of line 0 could stop
/// it with 0, so one in the way leaves the answer to the full check (-1).
fn lw_ro_rest_ok(list: Vec<Stmt>, m: i64, nm: str, from: i64) -> i64 {
    var ps: Vec<i64> = lw_lu_from(m, nm, from);
    var k: i64 = 0;
    while k < ps.len() {
        var p: i64 = ps.get(k);
        if p < 0 || p >= list.len() {
            return - 1;
        }
        var one: Vec<Stmt> = Vec::new();
        one.push(list.get(p));
        if cow_first_change(one, nm, 0) > 0 {
            return 0;
        }
        if stmt_line(list.get(p)) == 0 {
            return - 1;
        }
        if cow_written_back(one, nm) {
            return 0;
        }
        var targets: Vec<str> = Vec::new();
        collect_assign_targets(one, & mut targets);
        if lw_c_str_vec_contains(targets, nm) {
            return 0;
        }
        k = k + 1;
    }
    return 1;
}

/// SP12: Lowerer_readonly_copy_in's checks of the rest of the block (not
/// `outer`) from rest_of's fr_lu map: 1 true, 0 false, -1 not known here
/// (rest_of is no level's list any more, or a statement of line 0 is in the
/// way): then the rest is walked as before.
fn Lowerer_readonly_rest(self: & Lowerer, name: str, root: str) -> i64 {
    var lv: i64 = self.rest_lv;
    if lv < 0 || lv >= self.fr_lu.len() || self.fr_lu.len() != self.fr_lists.len() {
        return - 1;
    }
    if self.fr_lists.get(lv).len() != self.rest_of.len() {
        return - 1;
    }
    var m: i64 = self.fr_lu.get(lv);
    lw_lu_fill(m, self.rest_of);
    var a: i64 = lw_ro_rest_ok(self.rest_of, m, name, self.rest_from);
    if a != 1 {
        return a;
    }
    return lw_ro_rest_ok(self.rest_of, m, root, self.rest_from);
}

fn Lowerer_lower_let_value(self: & mut Lowerer, expr: Expr, plain: bool) -> i64 {
    if plain {
        return Lowerer_lower_expr(self, expr);
    }
    return Lowerer_lower_value(self, expr);
}

/// Whether the local `name` copied from the place `expr` can keep the
/// place's own handles (no copy-on-write share): nothing changes a Vec
/// through it, it is never stored, passed or returned whole, and the
/// variable the place starts from is neither changed nor passed in this
/// function. Then no write can tell the copy from the original. A place
/// read through `self` or another passed variable does not qualify: a
/// callee could change it.
fn Lowerer_readonly_copy(self: & Lowerer, name: str, expr: Expr) -> bool {
    return Lowerer_readonly_copy_in(self, name, expr, false);
}

/// `outer`: the variable may outlive the innermost block (an assignment to
/// a variable declared further out), so the rest of every enclosing list
/// counts, and no enclosing statement may be a loop.
fn Lowerer_readonly_copy_in(self: & Lowerer, name: str, expr: Expr, outer: bool) -> bool {
    if !lw_is_place_expr(expr) {
        return false;
    }
    var root: str = cow_root(expr);
    if root == "" || root == name {
        return false;
    }
    // The copy lives in the rest of its block: only what runs there matters
    var body: Vec<Stmt> = Vec::new();
    if outer {
        var depth: i64 = self.fr_lists.len();
        if depth == 0 || depth != self.fr_idx.len() {
            return false;
        }
        var k: i64 = 0;
        while k < depth {
            var list: Vec<Stmt> = self.fr_lists.get(k);
            var at: i64 = self.fr_idx.get(k);
            if k + 1 < depth {
                match list.get(at) {
                    Stmt::While(_, _, _) => {
                        return false;
                    }
                    Stmt::For(_, _, _, _) => {
                        return false;
                    }
                    Stmt::Loop(_, _) => {
                        return false;
                    }
                    _ => {
                    }
                }
            }
            var r: i64 = at + 1;
            while r < list.len() {
                body.push(list.get(r));
                r = r + 1;
            }
            k = k + 1;
        }
    } else {
        // SP12: from the list's name index when it can tell (each copy of
        // a place walked the rest of its block, several times)
        var fast: i64 = Lowerer_readonly_rest(self, name, root);
        if fast == 1 {
            return true;
        }
        if fast == 0 {
            return false;
        }
        var ri: i64 = self.rest_from;
        while ri < self.rest_of.len() {
            body.push(self.rest_of.get(ri));
            ri = ri + 1;
        }
    }
    if cow_first_change(body, name, 0) > 0 {
        return false;
    }
    if cow_written_back(body, name) {
        return false;
    }
    if cow_first_change(body, root, 0) > 0 {
        return false;
    }
    if cow_written_back(body, root) {
        return false;
    }
    var targets: Vec<str> = Vec::new();
    collect_assign_targets(body, & mut targets);
    if lw_c_str_vec_contains(targets, root) {
        return false;
    }
    if lw_c_str_vec_contains(targets, name) {
        return false;
    }
    return true;
}

fn lw_is_place_expr(expr: Expr) -> bool {
    match expr {
        Expr::Ident(_) => {
            return true;
        }
        Expr::FieldAccess(_, _) => {
            return true;
        }
        Expr::Index(_, _) => {
            return true;
        }
        Expr::MethodCall(_, m, _) => {
            return m == "get" || m == "first" || m == "last";
        }
        _ => {
        }
    }
    return false;
}

/// The Vec words of the struct at `ptr` (a fresh copy) become copy-on-write
/// shares of the Vecs they were copied from.
fn Lowerer_cow_share_fields(self: & mut Lowerer, ptr: i64, sname: str) {
    var mask: i64 = Lowerer_vec_field_mask(self, sname, 0);
    if mask == 0 {
        return;
    }
    var words: i64 = IrFunction_emit(& mut self.current_func, Inst::BitCast(ptr, IrType::Ptr(Box::new(IrType::Struct(sname))), IrType::Ptr(Box::new(IrType::I64))));
    var w: i64 = 0;
    while w < 63 {
        if (mask >> w) % 2 == 1 {
            var idx: i64 = IrFunction_emit(& mut self.current_func, Inst::ConstInt(w, IrType::I64));
            var slot: i64 = IrFunction_emit(& mut self.current_func, Inst::GetElemPtr(words, idx, IrType::I64));
            var old: i64 = IrFunction_emit(& mut self.current_func, Inst::Load(slot, IrType::I64));
            var eff: EffectSet = EffectSet_new();
            EffectSet_add(& mut eff, Effect::Alloc);
            EffectSet_add(& mut eff, Effect::Write);
            var args: Vec<i64> = Vec::new();
            args.push(IrFunction_emit(& mut self.current_func, Inst::ConstInt(0, IrType::I64)));
            args.push(old);
            var shared: i64 = IrFunction_emit(& mut self.current_func, Inst::Call("Vec_share", args, IrType::I64, eff));
            IrFunction_emit(& mut self.current_func, Inst::Store(slot, shared, OptIrType::None));
        }
        w = w + 1;
    }
}

/// CM3: the copy-on-write share of a stored Vec (proposal 0001, the retired
/// LOWER_COW) is gone: ownership (proposal 0004, LOWER_RC) gives the place
/// that keeps a value an owner of its own (Lowerer_rc_own_value), so `val`
/// is stored as it is. Kept as the identity for its callers.
fn Lowerer_emit_vec_share(self: & mut Lowerer, val: i64, ty: IrType) -> i64 {
    return val;
}

/// Bit i set: word i of the struct `name` (from word `base`) is a Vec.
fn Lowerer_vec_field_mask(self: & Lowerer, name: str, base: i64) -> i64 {
    var mask: i64 = 0;
    match IrModule_get_struct(& self.module, name) {
        OptStructLayout::Some(layout) => {
            var at: i64 = base;
            var fi: i64 = 0;
            while fi < layout.fields.len() {
                var fty: IrType = layout.fields.get(fi).ty;
                // The field's real word: an enum field is wider than the size
                // of its type says ((1 + payload) words), so count from the
                // layout's offsets, not by adding up sizes
                at = base + layout.fields.get(fi).offset / 8;
                match fty {
                    IrType::Generic(gn, _) => {
                        if gn == "Vec" && at < 63 {
                            mask = mask | (1 << at);
                        }
                    }
                    IrType::Opaque(oname) => {
                        if oname == "Vec" && at < 63 {
                            mask = mask | (1 << at);
                        }
                    }
                    IrType::Struct(sub) => {
                        var sub_enum: bool = false;
                        match Lowerer_lookup_enum(self, sub) {
                            OptEnumDef::Some(_) => {
                                sub_enum = true;
                            }
                            OptEnumDef::None => {
                            }
                        }
                        if !sub_enum && base < 32 {
                            mask = mask | Lowerer_vec_field_mask(self, sub, at);
                        }
                    }
                    _ => {
                    }
                }
                var fw: i64 = (IrModule_type_size(& self.module, fty) + 7) / 8;
                if fw < 1 {
                    fw = 1;
                }
                at = at + fw;
                fi = fi + 1;
            }
        }
        OptStructLayout::None => {
        }
    }
    return mask;
}

/// An argument, read through when it is a `&mut`/`&` parameter of the current
/// function holding a Vec, HashMap or str and the callee's parameter takes
/// the value (as src/lower.rs lower_expr_for_param).
fn Lowerer_lower_arg_for_param(self: & mut Lowerer, arg: Expr, callee: str, i: i64) -> i64 {
    // BG433: `fill(Vec::new())` makes the Vec with the element type the
    // parameter declares (as `var e: Vec<str> = Vec::new()` does): untyped,
    // its element type id was i64's, and the strings later pushed into it
    // (or into a Vec that shares its buffer) were never dropped
    if self.own_on && (lw_is_vec_new_expr(arg) || lw_rc_is_map_new_expr(arg)) {
        var nat: i64 = HashMap_get(self.func_info_at, callee);
        if nat > 0 && nat <= self.func_param_asts.len() {
            var nps: Vec<Type> = self.func_param_asts.get(nat - 1);
            if i < nps.len() {
                var nv: i64 = Lowerer_rc_new_coll(self, lw_rc_strip_ref(nps.get(i)));
                if nv >= 0 {
                    return nv;
                }
            }
        }
    }
    var v_lw: i64 = Lowerer_lower_expr(self, arg);
    // An integer passed where the parameter is a float is the number
    // (`half(5)`): Lowerer_int_to_float_value, as a declaration makes it
    var i2f_at: i64 = HashMap_get(self.func_info_at, callee);
    if i2f_at != 0 {
        var i2f_ps: Vec<Type> = self.func_param_asts.get(i2f_at - 1);
        if i < i2f_ps.len() {
            v_lw = Lowerer_int_to_float_value(self, v_lw, Lowerer_lower_type(self, i2f_ps.get(i)));
        }
    }
    var aname: str = "";
    match arg {
        Expr::Ident(n) => {
            aname = n;
        }
        _ => {
            return v_lw;
        }
    }
    var inner: Type = Type::I64;
    match Lowerer_lookup_param_type(self, aname) {
        OptType::Some(pt) => {
            // a `&str` parameter already holds the string (M11)
            if lw_is_borrowed_str(pt) {
                return v_lw;
            }
            match pt {
                Type::Ref(rin, _) => {
                    inner = box_type_unbox(rin);
                }
                _ => {
                    return v_lw;
                }
            }
        }
        OptType::None => {
            return v_lw;
        }
    }
    // (a runtime builtin p_* always takes the value)
    var at: i64 = HashMap_get(self.func_info_at, callee);
    if at == 0 && !str_starts_with(callee, "p_") {
        return v_lw;
    }
    if at != 0 {
        var cparams: Vec<Type> = self.func_param_asts.get(at - 1);
        if i >= cparams.len() {
            return v_lw;
        }
        match cparams.get(i) {
            Type::Ref(_, _) => {
                return v_lw;
            }
            Type::RawPtr(_, _) => {
                return v_lw;
            }
            _ => {
            }
        }
    }
    var is_handle: bool = false;
    match inner {
        Type::Generic(gn, _) => {
            is_handle = gn == "Vec" || gn == "HashMap";
        }
        Type::Named(nn) => {
            is_handle = nn == "Vec" || nn == "HashMap";
        }
        Type::Str => {
            is_handle = true;
        }
        _ => {
        }
    }
    if !is_handle {
        return v_lw;
    }
    return Lowerer_emit_inst(self, Inst::Load(v_lw, Lowerer_lower_type(self, inner)));
}

fn Lowerer_lower_call_expr(self: & mut Lowerer, callee: str, args: Vec<Expr>) -> i64 {
    // roadmap L8F: `type_name_of(x)` / `p_type_name(x)` is the name of x's
    // type as a string constant (after monomorphization, so inside a
    // generic function it names the instance's type). As C's sizeof, the
    // argument is not evaluated. A constant, so every backend (the
    // interpreter included) has it with no runtime support.
    // A function of the program's own by that name is called as written.
    if (callee == "type_name_of" || callee == "p_type_name") && args.len() == 1 && HashMap_get(self.func_info_at, callee) == 0 {
        return Lowerer_lower_expr(self, Expr::StringLit(Lowerer_type_name_of(self, args.get(0))));
    }
    // LG9: `gensym(prefix)` left in a comptime fn the program calls when it
    // runs (the evaluator answers the compile-time calls)
    if callee == "gensym" && args.len() == 1 && HashMap_get(self.func_info_at, callee) == 0 {
        return Lowerer_lower_gensym_rt(self, args.get(0));
    }
    // f"{e:spec}" (parser): per-type fstr_fmt_*(v, spec) — a float's
    // `.2` needs the number, not its text, so the value goes as it is
    if callee == "__fstr_fmt" && args.len() == 2 {
        return Lowerer_lower_fstr_fmt(self, args.get(0), args.get(1));
    }
    // A string, Vec or HashMap sent over a channel is copied whole first
    // (core p_send_copy), as for spawn: the receiver owns a value of its
    // own and the two threads share no buffer or owner count. A value
    // cast to a raw word (`v as i64`) is sent as it is, the caller's to
    // manage by hand.
    if (callee == "p_chan_send" || callee == "channel_send" || callee == "p_chan_try_send") && args.len() == 2 {
        var sk: i64 = Lowerer_rc_kind(self, Lowerer_rc_expr_type(self, args.get(1)));
        if sk == RC_STR || sk == RC_VEC || sk == RC_MAP {
            var wrapped: Vec<Expr> = Vec::new();
            wrapped.push(args.get(0));
            var one: Vec<Expr> = Vec::new();
            one.push(args.get(1));
            wrapped.push(Expr::Call("__send_copy", one));
            return Lowerer_lower_call_expr(self, callee, wrapped);
        }
    }
    // L8E: the extra arguments of a variadic function, packed into a Vec
    if HashMap_get(self.func_info_at, "...?") > 0 && HashMap_get(self.func_info_at, lw_va_key(callee)) > 0 {
        var packed: Vec<Expr> = Lowerer_pack_variadic(self, callee, args);
        if packed.len() > 0 {
            return Lowerer_lower_call_expr_resolved(self, callee, packed);
        }
    }
    return Lowerer_lower_call_expr_resolved(self, callee, args);
}

/// f"{e:spec}": the fstr_fmt_* of the value's type — fstr_fmt_f64 needs the
/// number itself for `.2`, so no early to-str here; a Vec first becomes its
/// text and is padded as a string
fn Lowerer_lower_fstr_fmt(self: & mut Lowerer, value_expr: Expr, spec_expr: Expr) -> i64 {
    var e_val: i64 = Lowerer_lower_expr(self, value_expr);
    var e_ty: IrType = Lowerer_get_value_type(self, e_val);
    var spec_val: i64 = Lowerer_lower_expr(self, spec_expr);
    var fn_name: str = "fstr_fmt_i64";
    var is_ptr: bool = false;
    match e_ty {
        IrType::Ptr(_) => {
            is_ptr = true;
        }
        _ => {
        }
    }
    if is_ptr {
        fn_name = "fstr_fmt_str";
    } else if ir_type_eq(e_ty, IrType::F64) {
        fn_name = "fstr_fmt_f64";
    } else if ir_type_eq(e_ty, IrType::F32) {
        // BG302: an f32 is widened to f64 (as BG157 does for `{x}`) and
        // formatted as a float; its word went to the integer formatter
        e_val = Lowerer_lower_cast(self, e_val, IrType::F32, IrType::F64);
        fn_name = "fstr_fmt_f64";
    } else if ir_type_eq(e_ty, IrType::Bool) {
        fn_name = "fstr_fmt_bool";
    } else if ir_type_is_opaque_named(e_ty, "Vec") {
        var vec_args: Vec<i64> = Vec::new();
        vec_args.push(Lowerer_rc_env(self));
        vec_args.push(e_val);
        // BG279: f64/f32/bool/u64 elements as their text
        var fv_txt: i64 = Lowerer_coll_to_str(self, e_val, e_ty, Lowerer_eq_ast_type(self, value_expr));
        if fv_txt < 0 {
            fv_txt = Lowerer_emit_inst(self, Inst::Call("Vec_to_str", vec_args, lw_ptr_u8(), EffectSet_new()));
        }
        e_val = fv_txt;
        fn_name = "fstr_fmt_str";
    } else if ir_type_is_opaque_named(e_ty, "HashMap") {
        // BG303: a map's text, as a plain `{m}` part shows it
        var map_args: Vec<i64> = Vec::new();
        map_args.push(Lowerer_rc_env(self));
        map_args.push(e_val);
        var fm_txt: i64 = Lowerer_coll_to_str(self, e_val, e_ty, Lowerer_eq_ast_type(self, value_expr));
        if fm_txt < 0 {
            fm_txt = Lowerer_emit_inst(self, Inst::Call("HashMap_to_str", map_args, lw_ptr_u8(), EffectSet_new()));
        }
        e_val = fm_txt;
        fn_name = "fstr_fmt_str";
    } else if Lowerer_u64_text(self, e_ty) {
        fn_name = "fstr_fmt_u64";
    }
    var args2: Vec<i64> = Vec::new();
    args2.push(Lowerer_rc_env(self));
    args2.push(e_val);
    args2.push(spec_val);
    return Lowerer_emit_inst(self, Inst::Call(fn_name, args2, lw_ptr_u8(), EffectSet_new()));
}

/// LG9: `gensym(prefix)` when the program runs: `<prefix>__gsr<n>`, n
/// counting this run's calls in the module global `__gensym_rt_n` (made the
/// first time one is lowered). At compile time the evaluator gives
/// `<prefix>__gs<n>`, a name no declaration uses (comptime_eval.fd
/// ct_gensym); at run time nothing is declared, so a fresh string is all
/// it can be.
fn Lowerer_lower_gensym_rt(self: & mut Lowerer, prefix: Expr) -> i64 {
    val gname: str = "__gensym_rt_n";
    if IrModule_global_pos(& self.module, gname) < 0 {
        self.module.globals.push(GlobalEntry_new(gname, IrType::I64, Expr::IntLit(0)));
    }
    var addr: i64 = Lowerer_emit_inst(self, Inst::GlobalAddr(gname, IrType::I64));
    var cur: i64 = Lowerer_emit_inst(self, Inst::Load(addr, IrType::I64));
    var one: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
    var nxt: i64 = Lowerer_lower_compound_assign(self, AssignOp::AddAssign, cur, one);
    var _st: i64 = Lowerer_emit_inst(self, Inst::Store(addr, nxt, OptIrType::None));
    var n_args: Vec<Expr> = Vec::new();
    n_args.push(Expr::Ident(gname));
    var named: Expr = Expr::Binary(BinOp::Add, Box::new(prefix), Box::new(Expr::StringLit("__gsr")));
    return Lowerer_lower_expr(self, Expr::Binary(BinOp::Add, Box::new(named), Box::new(Expr::Call("int_to_str", n_args))));
}

/// roadmap L8F: the source name of `e`'s type (`i64`, `str`, `Vec<f64>`,
/// a struct's or enum's name). Arithmetic, which the AST inference calls
/// i64, takes the float or bool type the IR inference sees.
fn Lowerer_type_name_of(self: & Lowerer, e: Expr) -> str {
    var t: Type = Lowerer_resolve_type(self, Lowerer_infer_expr_ast_type(self, e));
    match t {
        Type::I64 => {
            match Lowerer_infer_expr_type(self, e) {
                IrType::F64 => {
                    return "f64";
                }
                IrType::F32 => {
                    return "f32";
                }
                IrType::Bool => {
                    return "bool";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return type_to_str(t);
}

/// L8E: the key of a variadic function in `func_info_at` (its parameter
/// count); `...` cannot start a function name.
fn lw_va_key(name: str) -> str {
    return "...:" + name;
}

/// L8E: `f(a, b, c, d)` for `fn f(x: A, ...xs: T)` as
/// `f(a, { var __vaN: Vec<T> = Vec::new(); __vaN.push(b); ...; __vaN })`.
/// The block's Vec is a variable of the calling function, dropped with its
/// other variables; the callee borrows it as any parameter. Missing fixed
/// arguments take their defaults. Empty when the call is not packed (named
/// arguments are left to Lowerer_resolve_call_args as they are).
fn Lowerer_pack_variadic(self: & mut Lowerer, callee: str, args: Vec<Expr>) -> Vec<Expr> {
    var empty: Vec<Expr> = Vec::new();
    var n: i64 = HashMap_get(self.func_info_at, lw_va_key(callee));
    var at: i64 = HashMap_get(self.func_info_at, callee);
    if n <= 0 || at == 0 {
        return empty;
    }
    var ai: i64 = 0;
    while ai < args.len() {
        match args.get(ai) {
            Expr::NamedArg(_, _) => {
                return empty;
            }
            _ => {
            }
        }
        ai = ai + 1;
    }
    var k: i64 = n - 1;
    var ptys: Vec<Type> = self.func_param_asts.get(at - 1);
    // the parser gives `...xs: T` the type Vec<T>
    var pty: Type = ptys.get(k);
    var is_vec: bool = false;
    match pty {
        Type::Generic(gn, gargs) => {
            is_vec = gn == "Vec" && gargs.len() == 1;
        }
        _ => {
        }
    }
    var vec_ty: Type = pty;
    if !is_vec {
        vec_ty = Type::Generic("Vec", lw_va_one_type(pty));
    }
    var defaults: Vec<Expr> = Lowerer_lookup_defaults(self, callee);
    var va_names: Vec<str> = Lowerer_lookup_param_names(self, callee);
    var out: Vec<Expr> = Vec::new();
    var i: i64 = 0;
    while i < k {
        if i < args.len() {
            out.push(args.get(i));
        } else if i < defaults.len() {
            // BG424: a default's helper gets this call's arguments
            var dbv: Expr = lw_dflt_bind(defaults.get(i), va_names, out, OptBoxExpr::None);
            out.push(dbv);
        } else {
            out.push(Expr::IntLit(0));
        }
        i = i + 1;
    }
    var num: i64 = HashMap_get(self.func_info_at, "...#") + 1;
    HashMap_insert(self.func_info_at, "...#", num);
    var vname: str = "__va" + int_to_str(num);
    var stmts: Vec<Stmt> = Vec::new();
    var no_args: Vec<Expr> = Vec::new();
    stmts.push(Stmt::Let(vname, OptType::Some(vec_ty), Expr::MethodCall(Box::new(Expr::Ident("Vec")), "new", no_args), true, false, Vec::new(), self.cur_line));
    var j: i64 = k;
    while j < args.len() {
        var one: Vec<Expr> = Vec::new();
        one.push(args.get(j));
        stmts.push(Stmt::Expr(Expr::MethodCall(Box::new(Expr::Ident(vname)), "push", one), self.cur_line));
        j = j + 1;
    }
    stmts.push(Stmt::Expr(Expr::Ident(vname), self.cur_line));
    out.push(Expr::Block(stmts));
    return out;
}

fn lw_va_one_type(t: Type) -> Vec<Type> {
    var v: Vec<Type> = Vec::new();
    v.push(t);
    return v;
}

/// BG246: the arguments `vals` of a call through a function value whose
/// type declares `params`: an f64 given to an f32 parameter is narrowed and
/// an f32 given to an f64 one widened, as `x as f32` does (the conversion
/// a direct call's backend makes from its callee's parameters). Any other
/// argument is left as it is.
fn Lowerer_fnval_float_args(self: & mut Lowerer, vals: Vec<i64>, params: Vec<Type>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < vals.len() {
        var v: i64 = vals.get(i);
        if i < params.len() {
            var vt: IrType = Lowerer_get_value_type(self, v);
            match Lowerer_resolve_type(self, params.get(i)) {
                Type::F32 => {
                    if ir_type_eq(vt, IrType::F64) {
                        v = Lowerer_lower_cast(self, v, IrType::F64, IrType::F32);
                    }
                }
                Type::F64 => {
                    if ir_type_eq(vt, IrType::F32) {
                        v = Lowerer_lower_cast(self, v, IrType::F32, IrType::F64);
                    }
                }
                _ => {
                }
            }
        }
        out.push(v);
        i = i + 1;
    }
    return out;
}

/// BG267/BG269: value `v` as float type `want` when `v` is the other float
/// type (an f64 literal where an f32 is stored, as `x as f32` converts);
/// any other value, or a `want` that is not a float, is left as it is.
fn Lowerer_float_as(self: & mut Lowerer, v: i64, want: IrType) -> i64 {
    var vt: IrType = Lowerer_get_value_type(self, v);
    if ir_type_eq(want, IrType::F32) && ir_type_eq(vt, IrType::F64) {
        return Lowerer_lower_cast(self, v, IrType::F64, IrType::F32);
    }
    if ir_type_eq(want, IrType::F64) && ir_type_eq(vt, IrType::F32) {
        return Lowerer_lower_cast(self, v, IrType::F32, IrType::F64);
    }
    return v;
}

/// BG279: the text kind (core coll_word_text) of an element, key or value
/// type: 1 f64, 2 f32, 3 bool, 4 u64, 0 anything else (shown as before).
fn lw_text_kind(t: Type) -> i64 {
    match t {
        Type::F64 => {
            return 1;
        }
        Type::F32 => {
            return 2;
        }
        Type::Bool => {
            return 3;
        }
        Type::U64 => {
            return 4;
        }
        _ => {
        }
    }
    return 0;
}

fn lw_text_kind_ir(t: IrType) -> i64 {
    if ir_type_eq(t, IrType::F64) {
        return 1;
    }
    if ir_type_eq(t, IrType::F32) {
        return 2;
    }
    if ir_type_eq(t, IrType::Bool) {
        return 3;
    }
    if ir_type_eq(t, IrType::U64) {
        return 4;
    }
    return 0;
}

/// BG279: the text of a Vec or HashMap value `v` (IR type `ty`, AST type
/// `ast` when known, else Infer) whose elements, keys or values are f64,
/// f32, bool or u64: core Vec_to_str_k / HashMap_to_str_k with the kinds
/// the type says. -1 when no kind applies (the caller shows it as before:
/// Vec_to_str, HashMap_to_str or the backend's print).
fn Lowerer_coll_to_str(self: & mut Lowerer, v: i64, ty: IrType, ast: Type) -> i64 {
    var args: Vec<Type> = Vec::new();
    var name: str = "";
    match lw_rc_strip_ref(Lowerer_resolve_type(self, ast)) {
        Type::Generic(gn, ga) => {
            name = gn;
            args = ga;
        }
        _ => {
        }
    }
    var kinds: Vec<i64> = Vec::new();
    if (name == "Vec" && args.len() == 1) || (name == "HashMap" && args.len() == 2) {
        var ai: i64 = 0;
        while ai < args.len() {
            kinds.push(lw_text_kind(Lowerer_resolve_type(self, args.get(ai))));
            ai = ai + 1;
        }
    } else {
        var irt: IrType = ty;
        match ty {
            IrType::Ptr(pin) => {
                irt = box_ir_type_unbox(pin);
            }
            _ => {
            }
        }
        match irt {
            IrType::Generic(ign, iga) => {
                if (ign == "Vec" && iga.len() == 1) || (ign == "HashMap" && iga.len() == 2) {
                    name = ign;
                    var ii: i64 = 0;
                    while ii < iga.len() {
                        kinds.push(lw_text_kind_ir(iga.get(ii)));
                        ii = ii + 1;
                    }
                }
            }
            _ => {
            }
        }
    }
    var any: bool = false;
    var ki: i64 = 0;
    while ki < kinds.len() {
        if kinds.get(ki) != 0 {
            any = true;
        }
        ki = ki + 1;
    }
    if !any {
        return - 1;
    }
    var fname: str = "Vec_to_str_k";
    if name == "HashMap" {
        fname = "HashMap_to_str_k";
    }
    if !Lowerer_has_function(self, fname) {
        return - 1;
    }
    var cargs: Vec<i64> = Vec::new();
    cargs.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
    cargs.push(Lowerer_rc_as_i64(self, v));
    var kj: i64 = 0;
    while kj < kinds.len() {
        cargs.push(Lowerer_emit_inst(self, Inst::ConstInt(kinds.get(kj), IrType::I64)));
        kj = kj + 1;
    }
    return Lowerer_emit_inst(self, Inst::Call(fname, cargs, lw_ptr_u8(), EffectSet_new()));
}

/// BG336: whether `recv` is a map whose keys are u64 (as
/// Lowerer_map_values_f32 tests the values).
fn Lowerer_map_keys_u64(self: & Lowerer, recv: Expr, recv_ty: IrType) -> bool {
    var rt: IrType = recv_ty;
    match rt {
        IrType::Ptr(inner) => {
            rt = box_ir_type_unbox(inner);
        }
        _ => {
        }
    }
    match rt {
        IrType::Generic(gn, gargs) => {
            if gn == "HashMap" && gargs.len() == 2 {
                return ir_type_eq(gargs.get(0), IrType::U64);
            }
        }
        _ => {
        }
    }
    var kv: Vec<Type> = Lowerer_rc_map_kv_ast(self, recv);
    if kv.len() == 2 {
        match Lowerer_resolve_type(self, kv.get(0)) {
            Type::U64 => {
                return true;
            }
            _ => {
            }
        }
    }
    return false;
}

/// BG308: `m.get(k)` of a map whose values are Vecs, maps or structs (the
/// result `v`, of IR type `ret_ty`): a missing key's word 0 becomes the
/// address of a zeroed stack block (core hm_get_or_zero: an empty Vec or
/// map header, a struct of zeros), lent as the map's own value is, instead
/// of a null the caller reads through. Any other result is left as it is.
fn Lowerer_map_get_or_zero(self: & mut Lowerer, v: i64, ret_ty: IrType) -> i64 {
    var words: i64 = 0;
    var bty: IrType = IrType::Void;
    match ret_ty {
        IrType::Ptr(pin) => {
            match box_ir_type_unbox(pin) {
                IrType::Struct(_) => {
                    bty = box_ir_type_unbox(pin);
                    words = (IrModule_type_size(& self.module, bty) + 7) / 8;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    if ir_type_is_opaque_named(ret_ty, "Vec") {
        // the 40-byte header {data, len, cap, code, tid}
        words = 5;
    }
    if ir_type_is_opaque_named(ret_ty, "HashMap") {
        // the 56-byte header
        words = 7;
    }
    if words <= 0 || !Lowerer_has_function(self, "hm_get_or_zero") {
        return v;
    }
    var slot_ty: IrType = IrType::Array(Box::new(IrType::I64), words);
    var slot: i64 = lw_detached(& mut self.current_func, Inst::Alloca(slot_ty, Region::Stack));
    self.own_prologue.push(slot);
    var a: Vec<i64> = Vec::new();
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
    a.push(Lowerer_rc_as_i64(self, v));
    a.push(Lowerer_emit_inst(self, Inst::BitCast(slot, IrType::Ptr(Box::new(slot_ty)), IrType::I64)));
    a.push(Lowerer_emit_inst(self, Inst::ConstInt(words, IrType::I64)));
    var r: i64 = Lowerer_emit_inst(self, Inst::Call("hm_get_or_zero", a, IrType::I64, lw_rc_eff()));
    return Lowerer_emit_inst(self, Inst::BitCast(r, IrType::I64, ret_ty));
}

/// BG272: the IR types of the parameters of `entry`, the function a spawn
/// starts by name: the declared ones when it is the program's function
/// `callee` (an f64 literal given to an f32 parameter is still an f64
/// value), else `irtys` (a spawn wrapper takes the words as given).
fn Lowerer_spawn_entry_ptys(self: & Lowerer, entry: str, callee: str, irtys: Vec<IrType>) -> Vec<IrType> {
    if entry != callee {
        return irtys;
    }
    var at: i64 = HashMap_get(self.func_info_at, callee);
    if at <= 0 || at > self.func_param_asts.len() {
        return irtys;
    }
    var ps: Vec<Type> = self.func_param_asts.get(at - 1);
    if ps.len() != irtys.len() {
        return irtys;
    }
    var out: Vec<IrType> = Vec::new();
    var i: i64 = 0;
    while i < ps.len() {
        out.push(Lowerer_lower_type(self, ps.get(i)));
        i = i + 1;
    }
    return out;
}

/// BG272: whether a thread's entry with parameters `ptys` and result `ret`
/// needs Lowerer_spawn_float_wrapper: an f32 among them, and nothing that
/// is not a number, a bool or an f64 (those keep the path they had).
fn lw_spawn_needs_float_words(ptys: Vec<IrType>, ret: IrType) -> bool {
    var any32: bool = ir_type_eq(ret, IrType::F32);
    if !ir_type_eq(ret, IrType::Void) && !ir_type_is_int(ret) && !ir_type_is_float(ret) {
        return false;
    }
    var i: i64 = 0;
    while i < ptys.len() {
        var t: IrType = ptys.get(i);
        if ir_type_eq(t, IrType::F32) {
            any32 = true;
        } else if !ir_type_is_int(t) && !ir_type_is_float(t) {
            return false;
        }
        i = i + 1;
    }
    return any32;
}

/// BG272: argument `v` of a thread started through
/// Lowerer_spawn_float_wrapper, as the word its parameter of type `pty`
/// gets: a float as the bits of an f64 (an f32 widened first), a number
/// or bool extended to i64.
fn Lowerer_spawn_float_word(self: & mut Lowerer, v: i64, pty: IrType) -> i64 {
    if ir_type_is_float(pty) {
        var fv: i64 = Lowerer_float_as(self, v, pty);
        var vt: IrType = Lowerer_get_value_type(self, fv);
        if ir_type_is_int(vt) {
            fv = Lowerer_lower_cast(self, fv, vt, pty);
        }
        return Lowerer_f64_word_bits(self, fv);
    }
    var it: IrType = Lowerer_get_value_type(self, v);
    if ir_type_is_int(it) {
        return Lowerer_lower_cast(self, v, it, IrType::I64);
    }
    return v;
}

/// BG272: `__spawnw_N(env, w0, .., wn) -> i64` built as IR, the entry of a
/// thread whose function `entry` takes or returns an f32: each word is
/// turned back into its parameter (an f64's bits, narrowed for an f32; a
/// number truncated to its type) and the result into a word (a float as an
/// f64's bits, which `await` reads back, BG200). The runtimes handed an
/// f32 over as their own word: C's thunk as the f32's 32-bit pattern,
/// pe_ir in an integer register the callee did not read (an f32 argument
/// arrived as 0), so `await` of an f32 result gave 0. Its name.
fn Lowerer_spawn_float_wrapper(self: & mut Lowerer, entry: str, ptys: Vec<IrType>, ret_ir: IrType) -> str {
    self.continuation_counter = self.continuation_counter + 1;
    var wname: str = "__spawnw_" + int_to_str(self.continuation_counter);
    var w: IrFunction = IrFunction_new(wname, IrType::I64);
    var env_ty: IrType = lw_ptr_u8();
    var env_val: i64 = IrFunction_new_value(& mut w, ValueMeta_new(env_ty));
    w.params.push(ValueIdType_new(env_val, env_ty));
    var words: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < ptys.len() {
        var pv: i64 = IrFunction_new_value(& mut w, ValueMeta_new(IrType::I64));
        w.params.push(ValueIdType_new(pv, IrType::I64));
        words.push(pv);
        i = i + 1;
    }
    var prev_func: IrFunction = self.current_func;
    var prev_has: bool = self.has_current_func;
    var prev_block: i64 = self.current_block;
    var prev_own: bool = self.own_on;
    self.own_on = false;
    self.current_func = w;
    self.current_func.name = wname;
    self.has_current_func = true;
    self.current_block = 0;
    self.current_func.current_block_idx = 0;
    var args: Vec<i64> = Vec::new();
    args.push(env_val);
    i = 0;
    while i < words.len() {
        var pty: IrType = ptys.get(i);
        var a: i64 = words.get(i);
        if ir_type_is_float(pty) {
            a = Lowerer_emit_inst(self, Inst::Call("p_f64_from_bits", lw_c_vec1_i64(a), IrType::F64, EffectSet_new()));
            a = Lowerer_lower_cast(self, a, IrType::F64, pty);
        } else if ir_type_is_int(pty) && !ir_type_eq(pty, IrType::I64) {
            a = Lowerer_lower_cast(self, a, IrType::I64, pty);
        }
        args.push(a);
        i = i + 1;
    }
    var eff: EffectSet = EffectSet_new();
    EffectSet_add(& mut eff, Effect::IO);
    var r: i64 = Lowerer_emit_inst(self, Inst::Call(entry, args, ret_ir, eff));
    var result: i64 = r;
    if ir_type_eq(ret_ir, IrType::Void) {
        result = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    } else if ir_type_is_float(ret_ir) {
        result = Lowerer_f64_word_bits(self, r);
    } else if !ir_type_eq(ret_ir, IrType::I64) {
        result = Lowerer_lower_cast(self, r, ret_ir, IrType::I64);
    }
    Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(result)));
    IrModule_add_function(& mut self.module, self.current_func);
    self.current_func = prev_func;
    self.has_current_func = prev_has;
    self.current_block = prev_block;
    self.own_on = prev_own;
    return wname;
}

/// BG267/BG269: whether a returned expression takes the function's result
/// type as its hint: a tuple or enum literal (`(a, 2.5)`, `E::F(2.5)`,
/// `Option::Some(1.5)`) with a float literal among its own elements, the
/// one case the hint decides (an f64 literal stored as an f32).
/// BG434: an `if` or a `match` used as a value.
fn lw_is_branch_value_expr(e: Expr) -> bool {
    match e {
        Expr::If(_, _, _) => {
            return true;
        }
        Expr::Match(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

fn lw_ret_hint_expr(e: Expr) -> bool {
    var elems: Vec<Expr> = Vec::new();
    match e {
        Expr::TupleLit(te) => {
            elems = te;
        }
        Expr::EnumLit(_, _, ea) => {
            elems = ea;
        }
        Expr::MethodCall(recv, _, ma) => {
            match lw_box_expr_unbox(recv) {
                Expr::Ident(_) => {
                    elems = ma;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    var i: i64 = 0;
    while i < elems.len() {
        if lw_is_float_lit(elems.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// A float literal, or a negated one (`-2.5`).
fn lw_is_float_lit(e: Expr) -> bool {
    match e {
        Expr::FloatLit(_) => {
            return true;
        }
        Expr::Unary(_, inner) => {
            return lw_is_float_lit(lw_box_expr_unbox(inner));
        }
        _ => {
        }
    }
    return false;
}

/// BG267: the IR type the let being lowered (`val o: Option<f32> = ..`)
/// gives the type parameter `declared` (a payload's declared type) of enum
/// `enum_name`; Void when there is no such hint.
fn Lowerer_enum_param_hint_ir(self: & Lowerer, enum_name: str, params: Vec<str>, declared: Type) -> IrType {
    var pn: str = "";
    match declared {
        Type::Named(n) => {
            pn = n;
        }
        _ => {
            return IrType::Void;
        }
    }
    match self.let_hint {
        OptType::Some(h) => {
            match Lowerer_resolve_type(self, h) {
                Type::Generic(gn, gargs) => {
                    if gn != enum_name || gargs.len() != params.len() {
                        return IrType::Void;
                    }
                    var i: i64 = 0;
                    while i < params.len() {
                        if params.get(i) == pn {
                            return Lowerer_lower_type(self, gargs.get(i));
                        }
                        i = i + 1;
                    }
                }
                _ => {
                }
            }
        }
        OptType::None => {
        }
    }
    return IrType::Void;
}

fn Lowerer_lower_call_expr_resolved(self: & mut Lowerer, callee: str, args: Vec<Expr>) -> i64 {
    // Resolve named arguments to positional order and fill in defaults
    var resolved_args: Vec<Expr> = Lowerer_resolve_call_args(self, callee, args);
    var arg_vals: Vec<i64> = Vec::new();
    var ext_idx: i64 = - 1;
    if lw_c_str_vec_contains(self.fn_externs, callee) {
        ext_idx = Lowerer_extern_index(self, callee);
    }
    var ai: i64 = 0;
    while ai < resolved_args.len() {
        var c_fn: str = "";
        if ext_idx >= 0 {
            c_fn = Lowerer_c_callback(self, ext_idx, ai, resolved_args.get(ai));
        }
        if c_fn != "" {
            // C calls a Fides function through its adapter
            if !lw_c_str_vec_contains(self.module.c_callbacks, c_fn) {
                self.module.c_callbacks.push(c_fn);
            }
            arg_vals.push(Lowerer_emit_inst(self, Inst::ConstFnRef(c_fn_name(c_fn))));
        } else {
            var lav: i64 = Lowerer_lower_arg_for_param(self, resolved_args.get(ai), callee, ai);
            // core's Vec_push/HashMap_insert keep their element: an owner
            // of its own (proposal 0004)
            if self.own_on && lw_rc_consuming_arg(callee, ai) {
                lav = Lowerer_rc_own_value(self, lav, Lowerer_rc_value_type(self, resolved_args.get(ai), lav));
            }
            // BG204: a JSON value made for an argument
            // (`p_json_dump(p_json_parse(s))`) is a counted string of the
            // statement, dropped at its end: every p_json_parse/get/at
            // result is a temporary now (Lowerer_rc_note_call), so a
            // variable keeps it too (`val j = p_json_parse(s)`)
            arg_vals.push(lav);
        }
        ai = ai + 1;
    }

    // An async function runs on its own stack, until it first waits
    if lw_c_str_vec_contains(self.async_tasks, callee) {
        var adapted: bool = lw_c_str_vec_contains(self.async_adapted, callee);
        var co_args: Vec<i64> = Vec::new();
        var task_name: str = callee;
        // BG228: a task that owns an argument starts through its adapter,
        // which drops what it was given when the task function returns
        if adapted || (self.own_on && Lowerer_task_owns_args(self, callee)) {
            task_name = callee + "__task";
        }
        co_args.push(Lowerer_emit_inst(self, Inst::ConstStr(task_name)));
        co_args.push(Lowerer_emit_inst(self, Inst::ConstInt(resolved_args.len(), IrType::I64)));
        var cai: i64 = 0;
        while cai < arg_vals.len() {
            var av: i64 = arg_vals.get(cai);
            // The task runs on while its caller goes on: it keeps owners of
            // its own of what it was given (proposal 0004)
            if self.own_on && cai < resolved_args.len() {
                // BG228: as the parameter's type when the task owns it (its
                // adapter drops it as that), else as the value's
                var taty: Type = Lowerer_task_owned_param(self, callee, cai);
                match taty {
                    Type::Infer => {
                        taty = Lowerer_rc_value_type(self, resolved_args.get(cai), av);
                    }
                    _ => {
                    }
                }
                var tak: i64 = Lowerer_rc_kind(self, taty);
                if tak == RC_MEM {
                    av = Lowerer_rc_dup(self, av, taty);
                } else if tak != RC_NONE {
                    av = Lowerer_rc_own_value(self, av, taty);
                }
            }
            if adapted {
                // f64 as its bits; a struct as a heap copy, since the caller
                // goes on (and may return) while the task runs
                match Lowerer_get_value_type(self, av) {
                    IrType::F64 => {
                        var ba: Vec<i64> = Vec::new();
                        ba.push(av);
                        av = Lowerer_emit_inst(self, Inst::Call("p_f64_to_bits", ba, IrType::I64, EffectSet_new()));
                    }
                    IrType::Ptr(inner) => {
                        match box_ir_type_unbox(inner) {
                            IrType::Struct(sn) => {
                                var size: i64 = 8;
                                match IrModule_get_struct(& self.module, sn) {
                                    OptStructLayout::Some(layout) => {
                                        size = layout.size;
                                    }
                                    OptStructLayout::None => {
                                    }
                                }
                                var ma: Vec<i64> = Vec::new();
                                ma.push(Lowerer_emit_inst(self, Inst::ConstInt(size, IrType::I64)));
                                var aeff: EffectSet = EffectSet_new();
                                EffectSet_add(& mut aeff, Effect::Alloc);
                                var raw: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", ma, lw_ptr_u8(), aeff));
                                var heap: i64 = Lowerer_emit_inst(self, Inst::BitCast(raw, lw_ptr_u8(), IrType::Ptr(Box::new(IrType::Struct(sn)))));
                                Lowerer_emit_inst(self, Inst::StructCopy(heap, av, IrType::Struct(sn)));
                                av = heap;
                            }
                            _ => {
                            }
                        }
                    }
                    IrType::Struct(sn2) => {
                        var size2: i64 = 8;
                        match IrModule_get_struct(& self.module, sn2) {
                            OptStructLayout::Some(layout2) => {
                                size2 = layout2.size;
                            }
                            OptStructLayout::None => {
                            }
                        }
                        var ma2: Vec<i64> = Vec::new();
                        ma2.push(Lowerer_emit_inst(self, Inst::ConstInt(size2, IrType::I64)));
                        var aeff2: EffectSet = EffectSet_new();
                        EffectSet_add(& mut aeff2, Effect::Alloc);
                        var raw2: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", ma2, lw_ptr_u8(), aeff2));
                        var heap2: i64 = Lowerer_emit_inst(self, Inst::BitCast(raw2, lw_ptr_u8(), IrType::Ptr(Box::new(IrType::Struct(sn2)))));
                        Lowerer_emit_inst(self, Inst::StructCopy(heap2, av, IrType::Struct(sn2)));
                        av = heap2;
                    }
                    _ => {
                    }
                }
                // LG14: a generic struct (`self` of an instance of a generic
                // impl's async method) is copied to the heap the same way
                var co_vty: IrType = Lowerer_get_value_type(self, av);
                var co_gsn: str = Lowerer_task_gstruct_ir(self, co_vty);
                var co_copied: bool = false;
                match co_vty {
                    IrType::Struct(_) => {
                        co_copied = true;
                    }
                    IrType::Ptr(co_in) => {
                        match box_ir_type_unbox(co_in) {
                            IrType::Struct(_) => {
                                co_copied = true;
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                // a value whose type says no struct (a word read from a
                // field or element): the declared parameter's type says
                if str_len(co_gsn) == 0 && !co_copied {
                    var co_at: i64 = HashMap_get(self.func_info_at, callee);
                    if co_at != 0 {
                        var co_ps: Vec<Type> = self.func_param_asts.get(co_at - 1);
                        if cai < co_ps.len() {
                            co_gsn = Lowerer_task_gstruct(self, co_ps.get(cai));
                        }
                    }
                }
                if str_len(co_gsn) > 0 && !co_copied {
                    av = Lowerer_task_heap_copy(self, av, co_gsn);
                }
            }
            co_args.push(av);
            cai = cai + 1;
        }
        return Lowerer_emit_inst(self, Inst::Call("p_co_async", co_args, IrType::I64, EffectSet_new()));
    }

    if callee == "print" && arg_vals.len() > 0 {
        var arg_ty: IrType = Lowerer_get_value_type(self, arg_vals.get(0));
        // BG279: a Vec or map of f64/f32/bool/u64 as its text
        if resolved_args.len() > 0 {
            var pr_txt: i64 = Lowerer_coll_to_str(self, arg_vals.get(0), arg_ty, Lowerer_eq_ast_type(self, resolved_args.get(0)));
            if pr_txt >= 0 {
                return Lowerer_emit_inst(self, Inst::Print(pr_txt, lw_ptr_u8()));
            }
        }
        return Lowerer_emit_print(self, arg_vals.get(0), arg_ty);
    }

    if callee == "println" && arg_vals.len() > 0 {
        var arg_ty: IrType = Lowerer_get_value_type(self, arg_vals.get(0));
        // as `print`: a u64 prints unsigned (known-bugs 2g.72: println of
        // 18446744073709551615 printed -1)
        var pl_txt: i64 = - 1;
        if resolved_args.len() > 0 {
            pl_txt = Lowerer_coll_to_str(self, arg_vals.get(0), arg_ty, Lowerer_eq_ast_type(self, resolved_args.get(0)));
        }
        var _p1: i64 = 0;
        if pl_txt >= 0 {
            // BG279: a Vec or map of f64/f32/bool/u64 as its text
            _p1 = Lowerer_emit_inst(self, Inst::Print(pl_txt, lw_ptr_u8()));
        } else {
            _p1 = Lowerer_emit_print(self, arg_vals.get(0), arg_ty);
        }
        var newline: i64 = Lowerer_emit_inst(self, Inst::ConstStr("\n"));
        return Lowerer_emit_inst(self, Inst::Print(newline, lw_ptr_u8()));
    }

    if callee == "thread_id" || callee == "workgroup_size" || callee == "workgroup_id" || callee == "num_workgroups" {
        return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    }

    var is_local: bool = false;
    match Lowerer_lookup_local(self, callee) {
        OptValueId::Some(_) => {
            is_local = true;
        }
        OptValueId::None => {
        }
    }
    if !is_local {
        match Lowerer_lookup_alloca(self, callee) {
            OptValueId::Some(_) => {
                is_local = true;
            }
            OptValueId::None => {
            }
        }
    }
    // A function value a closure captured is called through the closure's
    // env (stdlib-agent-bugs 27: `nx(s)` was a call to an unknown `nx`)
    var is_capture: bool = false;
    if !is_local {
        var cci: i64 = 0;
        while cci < self.current_captures.len() {
            if self.current_captures.get(cci).name == callee {
                match Lowerer_resolve_type(self, self.current_captures.get(cci).ty) {
                    Type::Func(_, _) => {
                        is_capture = true;
                    }
                    // a slot's `func` / `closure` (no signature known)
                    Type::Named(cfn) => {
                        is_capture = cfn == "func" || cfn == "closure";
                    }
                    _ => {
                    }
                }
            }
            cci = cci + 1;
        }
    }
    if is_local || is_capture {
        var fn_val: i64 = 0;
        if is_capture {
            fn_val = Lowerer_lower_expr(self, Expr::Ident(callee));
        } else {
            match Lowerer_lookup_alloca(self, callee) {
                OptValueId::Some(alloca) => {
                    var load_ty: IrType = IrType::I64;
                    match Lowerer_lookup_alloca_type(self, alloca) {
                        OptIrType::Some(t) => {
                            load_ty = t;
                        }
                        OptIrType::None => {
                        }
                    }
                    fn_val = Lowerer_emit_inst(self, Inst::Load(alloca, load_ty));
                }
                OptValueId::None => {
                    match Lowerer_lookup_local(self, callee) {
                        OptValueId::Some(v) => {
                            fn_val = v;
                        }
                        OptValueId::None => {
                            fn_val = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                        }
                    }
                }
            }
        }
        // The function value's type (a parameter's, a variable's, a
        // capture's) gives the call's return type (bugs 10, 22, 29, 30:
        // only a parameter's was looked at, so a str or Vec result of a
        // variable read as a word)
        var ret_ty_local: IrType = IrType::I64;
        var ret_ast_local: Type = Type::Infer;
        match Lowerer_resolve_type(self, Lowerer_fn_value_type(self, callee)) {
            Type::Func(fparams, fret) => {
                ret_ast_local = lw_box_type_unbox(fret);
                // as a function's own result type (Lowerer_lower_func_body):
                // an enum, a tuple or a generic struct is a struct too
                ret_ty_local = Lowerer_lower_type_sret(self, ret_ast_local);
                // BG246: a float argument takes the width of the function
                // type's parameter (`f: fn(f32) -> f32` called with an f64):
                // a CallPtr has no callee whose parameters a backend could
                // look at, as a direct call has (pe_ir peir_callee_params)
                arg_vals = Lowerer_fnval_float_args(self, arg_vals, fparams);
            }
            _ => {
            }
        }
        var eff_local: EffectSet = EffectSet_new();
        EffectSet_add(& mut eff_local, Effect::IO);
        // A struct or enum result, as a direct call has it: the callee
        // writes it to the caller's memory, the pointer it takes first
        // (before the env). The CallPtr says so with its Struct result type:
        // args[0] is that pointer, and the call itself gives nothing
        // (bugs 2, 14, 18, 22, 46: the arguments were shifted by one).
        match ret_ty_local {
            IrType::Struct(rsn) => {
                var rptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct(rsn), Lowerer_current_region(self)));
                var pargs: Vec<i64> = Vec::new();
                pargs.push(rptr);
                var pai: i64 = 0;
                while pai < arg_vals.len() {
                    pargs.push(arg_vals.get(pai));
                    pai = pai + 1;
                }
                var seff: EffectSet = EffectSet_new();
                EffectSet_add(& mut seff, Effect::IO);
                Lowerer_emit_inst(self, Inst::CallPtr(fn_val, pargs, IrType::Struct(rsn), seff, true));
                // the caller owns the struct written there (as
                // Lowerer_rc_note_sret)
                if self.own_on && Lowerer_rc_kind(self, ret_ast_local) == RC_MEM {
                    Lowerer_rc_temp(self, rptr, ret_ast_local);
                }
                return rptr;
            }
            // An array result: the callee writes it into the caller's
            // buffer, taken first as for a struct (BG126)
            IrType::Array(_, _) => {
                var rptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(ret_ty_local, Lowerer_current_region(self)));
                var pargs: Vec<i64> = Vec::new();
                pargs.push(rptr);
                var pai: i64 = 0;
                while pai < arg_vals.len() {
                    pargs.push(arg_vals.get(pai));
                    pai = pai + 1;
                }
                var seff: EffectSet = EffectSet_new();
                EffectSet_add(& mut seff, Effect::IO);
                Lowerer_emit_inst(self, Inst::CallPtr(fn_val, pargs, ret_ty_local, seff, true));
                return rptr;
            }
            _ => {
            }
        }
        var pres: i64 = Lowerer_emit_inst(self, Inst::CallPtr(fn_val, arg_vals, ret_ty_local, eff_local, true));
        // A string, Vec or map result is the caller's, a temporary of the
        // statement (as Lowerer_rc_note_call for a direct call)
        if self.own_on {
            var prk: i64 = Lowerer_rc_kind(self, ret_ast_local);
            if prk == RC_STR || prk == RC_VEC || prk == RC_MAP || prk == RC_BOX {
                Lowerer_rc_temp(self, pres, ret_ast_local);
            }
        }
        return pres;
    }

    var ret_ty: IrType = Lowerer_lookup_func_ret_ty_ir(self, callee);

    var eff: EffectSet = EffectSet_new();
    match runtime_effects(callee) {
        OptEffectSet::Some(e) => {
            eff = e;
        }
        OptEffectSet::None => {
        }
    }

    var call_args: Vec<i64> = Vec::new();
    var is_user_func: bool = Lowerer_is_user_func(self, callee);
    var is_runtime: bool = !is_user_func && (str_starts_with(callee, "p_") || str_starts_with(callee, "__ecs_"));
    if is_user_func && !is_runtime {
        call_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
    }
    ai = 0;
    while ai < arg_vals.len() {
        call_args.push(arg_vals.get(ai));
        ai = ai + 1;
    }

    if Lowerer_is_async_func(self, callee) {
        var call_val: i64 = 0;
        match ret_ty {
            IrType::Struct(asn) => {
                var asize: i64 = 8;
                match IrModule_get_struct(& self.module, asn) {
                    OptStructLayout::Some(al) => {
                        asize = al.size;
                    }
                    OptStructLayout::None => {
                    }
                }
                var ama: Vec<i64> = Vec::new();
                ama.push(Lowerer_emit_inst(self, Inst::ConstInt(asize, IrType::I64)));
                var aeff: EffectSet = EffectSet_new();
                EffectSet_add(& mut aeff, Effect::Alloc);
                var araw: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", ama, lw_ptr_u8(), aeff));
                var aptr: i64 = Lowerer_emit_inst(self, Inst::BitCast(araw, lw_ptr_u8(), IrType::Ptr(Box::new(ret_ty))));
                var a_args: Vec<i64> = Vec::new();
                a_args.push(aptr);
                var aai: i64 = 0;
                while aai < call_args.len() {
                    a_args.push(call_args.get(aai));
                    aai = aai + 1;
                }
                Lowerer_emit_inst(self, Inst::Call(callee, a_args, IrType::Void, eff));
                call_val = Lowerer_emit_inst(self, Inst::BitCast(aptr, IrType::Ptr(Box::new(ret_ty)), IrType::I64));
            }
            // An array result: a heap block the callee writes through sret
            IrType::Array(_, _) => {
                var ama: Vec<i64> = Vec::new();
                ama.push(Lowerer_emit_inst(self, Inst::ConstInt(ir_type_size(ret_ty), IrType::I64)));
                var aeff: EffectSet = EffectSet_new();
                EffectSet_add(& mut aeff, Effect::Alloc);
                var araw: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", ama, lw_ptr_u8(), aeff));
                var aptr: i64 = Lowerer_emit_inst(self, Inst::BitCast(araw, lw_ptr_u8(), IrType::Ptr(Box::new(ret_ty))));
                var a_args: Vec<i64> = Vec::new();
                a_args.push(aptr);
                var aai: i64 = 0;
                while aai < call_args.len() {
                    a_args.push(call_args.get(aai));
                    aai = aai + 1;
                }
                Lowerer_emit_inst(self, Inst::Call(callee, a_args, IrType::Void, eff));
                call_val = Lowerer_emit_inst(self, Inst::BitCast(aptr, IrType::Ptr(Box::new(ret_ty)), IrType::I64));
            }
            IrType::F64 => {
                var fv: i64 = Lowerer_emit_inst(self, Inst::Call(callee, call_args, ret_ty, eff));
                var fba: Vec<i64> = Vec::new();
                fba.push(fv);
                call_val = Lowerer_emit_inst(self, Inst::Call("p_f64_to_bits", fba, IrType::I64, EffectSet_new()));
            }
            // BG200: an f32 result as an f64's bits (`await` turns it back);
            // the word took the value converted to an integer (2.5 gave 2)
            IrType::F32 => {
                var fv32: i64 = Lowerer_emit_inst(self, Inst::Call(callee, call_args, ret_ty, eff));
                var fba32: Vec<i64> = Vec::new();
                fba32.push(Lowerer_lower_cast(self, fv32, IrType::F32, IrType::F64));
                call_val = Lowerer_emit_inst(self, Inst::Call("p_f64_to_bits", fba32, IrType::I64, EffectSet_new()));
            }
            _ => {
                call_val = Lowerer_emit_inst(self, Inst::Call(callee, call_args, ret_ty, eff));
            }
        }
        var wrap_args: Vec<i64> = Vec::new();
        wrap_args.push(call_val);
        return Lowerer_emit_inst(self, Inst::Call("p_future_ready", wrap_args, IrType::I64, EffectSet_new()));
    }

    match ret_ty {
        IrType::Struct(sname) => {
            var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct(sname), Lowerer_current_region(self)));
            var sret_args: Vec<i64> = Vec::new();
            sret_args.push(sret_ptr);
            var si: i64 = 0;
            while si < call_args.len() {
                sret_args.push(call_args.get(si));
                si = si + 1;
            }
            Lowerer_emit_inst(self, Inst::Call(callee, sret_args, IrType::Void, eff));
            Lowerer_rc_note_sret(self, sret_ptr, callee);
            return sret_ptr;
        }
        // An array result the callee writes into the caller's buffer (BG126)
        IrType::Array(_, _) => {
            var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(ret_ty, Lowerer_current_region(self)));
            var sret_args: Vec<i64> = Vec::new();
            sret_args.push(sret_ptr);
            var si: i64 = 0;
            while si < call_args.len() {
                sret_args.push(call_args.get(si));
                si = si + 1;
            }
            Lowerer_emit_inst(self, Inst::Call(callee, sret_args, IrType::Void, eff));
            Lowerer_rc_note_sret(self, sret_ptr, callee);
            return sret_ptr;
        }
        _ => {
        }
    }

    var plain_call: i64 = Lowerer_emit_inst(self, Inst::Call(callee, call_args, ret_ty, eff));
    // A string from C is C's: the program gets a counted copy ("" for null).
    // Always a copy (p_str_from_ptr), never p_str_take's guess from the 16
    // bytes in front of the pointer: C memory has no string header, and
    // every str the program holds must have one (string header by
    // construction, Nov 22; core's Str_drop/Str_dup check it strictly)
    if self.own_on && lw_c_str_vec_contains(self.own_str_externs, callee) && Lowerer_has_function(self, "p_str_from_ptr") {
        var ta: Vec<i64> = Vec::new();
        ta.push(Lowerer_rc_env(self));
        ta.push(Lowerer_rc_as_i64(self, plain_call));
        return Lowerer_emit_inst(self, Inst::Call("p_str_from_ptr", ta, ret_ty, lw_rc_eff()));
    }
    return plain_call;
}

fn Lowerer_lower_field_access_expr(self: & mut Lowerer, obj: Box<Expr>, field: str) -> i64 {
    var obj_expr: Expr = lw_box_expr_unbox(obj);
    var obj_val: i64 = Lowerer_lower_expr(self, obj_expr);
    var obj_ty: IrType = Lowerer_get_value_type(self, obj_val);

    var struct_name: str = "";
    match obj_ty {
        IrType::Struct(n) => {
            struct_name = n;
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(n2) => {
                    struct_name = n2;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    if str_len(struct_name) == 0 {
        var inferred_ty: IrType = Lowerer_infer_expr_type(self, obj_expr);
        match inferred_ty {
            IrType::Struct(n) => {
                struct_name = n;
            }
            IrType::Ptr(inner) => {
                match box_ir_type_unbox(inner) {
                    IrType::Struct(n2) => {
                        struct_name = n2;
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
    }
    // `b.f` on a Box of a struct (a Box field, a Box variable): the Box is
    // the struct's address, as its AST type says
    if str_len(struct_name) == 0 {
        match Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, obj_expr)) {
            Type::Generic(bn, bargs) => {
                if bn == "Box" && bargs.len() == 1 && Lowerer_rc_is_mem_type(self, Lowerer_resolve_type(self, bargs.get(0))) {
                    struct_name = lw_rc_type_name(Lowerer_resolve_type(self, bargs.get(0)));
                    obj_val = Lowerer_emit_inst(self, Inst::BitCast(obj_val, obj_ty, IrType::Ptr(Box::new(IrType::Struct(struct_name)))));
                }
            }
            _ => {
            }
        }
    }

    // A generic struct instance held as a word (a `p: Pair<i64, i64>`
    // parameter or variable): the word is the struct's address, as its AST
    // type says. Without this every field read field 0 (2f.11).
    if str_len(struct_name) == 0 {
        var gat: Type = Lowerer_infer_expr_ast_type(self, obj_expr);
        match gat {
            Type::Ref(rin, _) => {
                gat = lw_box_type_unbox(rin);
            }
            _ => {
            }
        }
        match gat {
            Type::Generic(gsn, _) => {
                match Lowerer_lookup_struct(self, gsn) {
                    OptStructDef::Some(gsd) => {
                        if gsd.type_params.len() > 0 && gsn != "Vec" {
                            struct_name = gsn;
                            obj_val = Lowerer_emit_inst(self, Inst::BitCast(obj_val, obj_ty, IrType::Ptr(Box::new(IrType::Struct(gsn)))));
                        }
                    }
                    OptStructDef::None => {
                    }
                }
            }
            _ => {
            }
        }
    }

    // Swizzle access for vec types (Phase 8A): v.xyz / v.rgb / v.yx ...
    if is_vec_type_name(struct_name) && str_len(field) > 1 && is_valid_swizzle(field) {
        return Lowerer_lower_swizzle(self, struct_name, obj_val, field);
    }

    var field_idx: i64 = 0;
    var field_ty: IrType = IrType::I64;
    match IrModule_get_struct(& self.module, struct_name) {
        OptStructLayout::Some(layout) => {
            var fi: i64 = 0;
            while fi < layout.fields.len() {
                if layout.fields.get(fi).name == field {
                    field_idx = fi;
                    field_ty = layout.fields.get(fi).ty;
                }
                fi = fi + 1;
            }
        }
        OptStructLayout::None => {
        }
    }
    // A field whose type holds the struct's type parameters (`vals:
    // Vec<V>`) has the instance's type when it is known (Slot<str>: a
    // Vec<str>); the layout has a word for each parameter (bug 17)
    field_ty = Lowerer_generic_field_ir_type(self, struct_name, field, obj_expr, field_ty);

    var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(obj_val, field_idx, field_ty));
    match field_ty {
        IrType::Struct(_) => {
            return field_ptr;
        }
        _ => {
        }
    }
    // A type-parameter field of a generic struct: its word, read as the
    // instance's type (Pair<f64, str>: an f64 from its bits, a string as
    // the pointer it is)
    if Lowerer_field_is_type_param(self, struct_name, field) {
        var want: IrType = Lowerer_lower_type(self, Lowerer_infer_expr_ast_type(self, Expr::FieldAccess(obj, field)));
        match want {
            IrType::F64 => {
                var bits: i64 = Lowerer_emit_inst(self, Inst::Load(field_ptr, IrType::I64));
                var fa: Vec<i64> = Vec::new();
                fa.push(bits);
                return Lowerer_emit_inst(self, Inst::Call("p_f64_from_bits", fa, IrType::F64, EffectSet_new()));
            }
            // BG270: an f32 is kept as an f64's bits too (the struct
            // literal widens it), narrowed back here; the word was read as
            // an integer (every backend printed a different bit pattern)
            IrType::F32 => {
                var bits32: i64 = Lowerer_emit_inst(self, Inst::Load(field_ptr, IrType::I64));
                var f64v: i64 = Lowerer_emit_inst(self, Inst::Call("p_f64_from_bits", lw_c_vec1_i64(bits32), IrType::F64, EffectSet_new()));
                return Lowerer_lower_cast(self, f64v, IrType::F64, IrType::F32);
            }
            IrType::Ptr(_) => {
                return Lowerer_emit_inst(self, Inst::Load(field_ptr, want));
            }
            IrType::Bool => {
                return Lowerer_emit_inst(self, Inst::Load(field_ptr, want));
            }
            _ => {
            }
        }
        // a struct or an enum (a generic struct's instance too): the word
        // is the address of its heap copy, read as a pointer to it (so
        // `p.a.name` and `val c: Cell = p.a` read the struct)
        match Lowerer_generic_struct_ir(self, want) {
            IrType::Struct(wsn) => {
                match IrModule_get_struct(& self.module, wsn) {
                    OptStructLayout::Some(_) => {
                        return Lowerer_emit_inst(self, Inst::Load(field_ptr, IrType::Ptr(Box::new(IrType::Struct(wsn)))));
                    }
                    OptStructLayout::None => {
                    }
                }
            }
            _ => {
            }
        }
    }
    return Lowerer_emit_inst(self, Inst::Load(field_ptr, field_ty));
}

// &obj.field — the field's address (GetFieldPtr), used by Expr::Ref so a
// reference aliases the original storage instead of a copy in a dead stack
// slot. Returns None when the struct/field can't be resolved (caller falls
// back to the alloca path).
fn Lowerer_try_field_addr(self: & mut Lowerer, obj: Box<Expr>, field: str) -> OptValueId {
    var obj_expr: Expr = lw_box_expr_unbox(obj);
    var obj_val: i64 = Lowerer_lower_expr(self, obj_expr);
    var obj_ty: IrType = Lowerer_get_value_type(self, obj_val);

    var struct_name: str = "";
    match obj_ty {
        IrType::Struct(n) => {
            struct_name = n;
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(n2) => {
                    struct_name = n2;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    if str_len(struct_name) == 0 {
        var inferred_ty: IrType = Lowerer_infer_expr_type(self, obj_expr);
        match inferred_ty {
            IrType::Struct(n) => {
                struct_name = n;
            }
            IrType::Ptr(inner) => {
                match box_ir_type_unbox(inner) {
                    IrType::Struct(n2) => {
                        struct_name = n2;
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
    }
    if str_len(struct_name) == 0 {
        return OptValueId::None;
    }

    var field_idx: i64 = - 1;
    var field_ty: IrType = IrType::I64;
    match IrModule_get_struct(& self.module, struct_name) {
        OptStructLayout::Some(layout) => {
            var fi: i64 = 0;
            while fi < layout.fields.len() {
                if layout.fields.get(fi).name == field {
                    field_idx = fi;
                    field_ty = layout.fields.get(fi).ty;
                }
                fi = fi + 1;
            }
        }
        OptStructLayout::None => {
        }
    }
    if field_idx < 0 {
        return OptValueId::None;
    }

    var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(obj_val, field_idx, field_ty));
    return OptValueId::Some(field_ptr);
}

// The enum named by an IR type (`Struct(E)` or `Ptr(Struct(E))`), or "".
fn enum_name_of_ir_type(self: & Lowerer, t: IrType) -> str {
    var name: str = "";
    match t {
        IrType::Struct(n) => {
            name = n;
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(n2) => {
                    name = n2;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    if name == "" {
        return "";
    }
    match Lowerer_lookup_enum(self, name) {
        OptEnumDef::Some(_) => {
            return name;
        }
        OptEnumDef::None => {
        }
    }
    // R1.2b: structs have a synthesized __eq too
    match Lowerer_lookup_struct(self, name) {
        OptStructDef::Some(_) => {
            return name;
        }
        OptStructDef::None => {
        }
    }
    return "";
}

/// A block used for its value, with a trailing `if c { .. } else { .. }` or
/// `match` statement turned into the same expression, so the block's value
/// is that expression's value. A new list: the AST is left as it is.
fn lw_value_tail(stmts: Vec<Stmt>) -> Vec<Stmt> {
    if stmts.len() == 0 {
        return stmts;
    }
    var tail: Stmt = stmts.get(stmts.len() - 1);
    var tail_expr: OptExpr = OptExpr::None;
    var tail_line: i64 = 0;
    match tail {
        Stmt::If(c, t, e, line) => {
            match e {
                OptStmts::Some(_) => {
                    tail_expr = OptExpr::Some(Expr::If(Box::new(c), t, e));
                    tail_line = line;
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Match(m, arms, line) => {
            tail_expr = OptExpr::Some(Expr::Match(Box::new(m), arms));
            tail_line = line;
        }
        _ => {
        }
    }
    match tail_expr {
        OptExpr::Some(te) => {
            var out: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i + 1 < stmts.len() {
                out.push(stmts.get(i));
                i = i + 1;
            }
            out.push(Stmt::Expr(te, tail_line));
            return out;
        }
        OptExpr::None => {
        }
    }
    return stmts;
}

/// Match arms used for their value: each body as lw_value_tail makes it.
fn lw_value_arms(arms: Vec<MatchArm>) -> Vec<MatchArm> {
    var out: Vec<MatchArm> = Vec::new();
    var i: i64 = 0;
    while i < arms.len() {
        var a: MatchArm = arms.get(i);
        out.push(MatchArm_new(a.pattern, a.guard, lw_value_tail(a.body)));
        i = i + 1;
    }
    return out;
}

// The value of a branch is its trailing expression statement, if any.
fn if_branch_tail_expr(stmts: Vec<Stmt>) -> OptExpr {
    if stmts.len() == 0 {
        return OptExpr::None;
    }
    match stmts.get(stmts.len() - 1) {
        Stmt::Expr(e, _) => {
            return OptExpr::Some(e);
        }
        _ => {
        }
    }
    return OptExpr::None;
}

// if-expression: like src/lower.rs, each branch stores its value into a result
// slot allocated before the branch, and the merge block loads it. (The previous
// version jumped to a merge-block parameter that no jump ever filled, so the
// value of `val x = if c { a } else { b }` was always 0.)
/// Whether an IR type is a struct held by value (not its address).
fn lw_is_struct_ir(t: IrType) -> bool {
    match t {
        IrType::Struct(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

fn Lowerer_lower_if_expr(self: & mut Lowerer, cond: Box<Expr>, then_block0: Vec<Stmt>, else_block0: OptStmts) -> i64 {
    // A branch ending in `if .. else ..` or `match` (an else-if chain, a
    // nested if) has that expression's value
    var then_block: Vec<Stmt> = lw_value_tail(then_block0);
    var else_block: OptStmts = OptStmts::None;
    match else_block0 {
        OptStmts::Some(eb0) => {
            else_block = OptStmts::Some(lw_value_tail(eb0));
        }
        OptStmts::None => {
        }
    }
    var result_ty: IrType = IrType::Void;
    var then_lit: bool = false;
    var then_has: bool = false;
    match if_branch_tail_expr(then_block) {
        OptExpr::Some(te) => {
            result_ty = Lowerer_infer_expr_type(self, te);
            then_lit = lw_is_int_lit(te);
            then_has = true;
        }
        OptExpr::None => {
        }
    }
    // the else branch's value joins (lw_join_value_ty): an i64 branch
    // after a u8 one was truncated to a byte
    match else_block {
        OptStmts::Some(es) => {
            match if_branch_tail_expr(es) {
                OptExpr::Some(ee) => {
                    var else_ty: IrType = Lowerer_infer_expr_type(self, ee);
                    if then_has {
                        result_ty = lw_join_value_ty(result_ty, then_lit, else_ty, lw_is_int_lit(ee));
                    } else {
                        result_ty = else_ty;
                    }
                }
                OptExpr::None => {
                }
            }
        }
        OptStmts::None => {
        }
    }
    var has_value: bool = !ir_type_eq(result_ty, IrType::Void) && !ir_type_eq(result_ty, IrType::Never);
    var result_slot: i64 = 0;
    if has_value {
        result_slot = Lowerer_emit_inst(self, Inst::Alloca(result_ty, Lowerer_current_region(self)));
    }
    // Ownership (proposal 0004): each branch hands an owner of its value to
    // the result, a temporary of the statement
    var ires_ty: Type = Type::Infer;
    if self.own_on && has_value {
        var tails: Vec<Expr> = Vec::new();
        match if_branch_tail_expr(then_block) {
            OptExpr::Some(te2) => {
                tails.push(te2);
            }
            OptExpr::None => {
            }
        }
        match else_block {
            OptStmts::Some(es2) => {
                match if_branch_tail_expr(es2) {
                    OptExpr::Some(ee2) => {
                        tails.push(ee2);
                    }
                    OptExpr::None => {
                    }
                }
            }
            OptStmts::None => {
            }
        }
        ires_ty = Lowerer_rc_result_type(self, tails);
    }

    var cond_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(cond));
    var then_block_id: i64 = Lowerer_new_block(self);
    var else_block_id: i64 = Lowerer_new_block(self);
    var merge_block_id: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Branch(cond_val, then_block_id, else_block_id));

    var saved_allocas_len: i64 = self.allocas.len();
    var saved_alloca_types_len: i64 = self.alloca_types.len();
    var saved_var_ast_types_len: i64 = self.var_ast_types.len();
    var saved_locals_len: i64 = self.current_func.locals.len();

    Lowerer_set_current_block(self, then_block_id);
    var then_mark: i64 = self.own_temps.len();
    Lowerer_rc_scope_open(self);
    var ti: i64 = 0;
    while ti < then_block.len() {
        match then_block.get(ti) {
            Stmt::Expr(e, _) => {
                var tv: i64 = Lowerer_lower_expr(self, e);
                if has_value && ti + 1 == then_block.len() && !Lowerer_current_block_has_terminator(self) {
                    tv = Lowerer_branch_value_to(self, tv, result_ty);
                    tv = Lowerer_rc_own_value(self, tv, ires_ty);
                    Lowerer_emit_inst(self, Inst::Store(result_slot, tv, OptIrType::None));
                }
            }
            s => {
                Lowerer_lower_stmt(self, s);
            }
        }
        ti = ti + 1;
    }
    Lowerer_rc_flush(self, then_mark);
    Lowerer_rc_scope_close(self);
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(merge_block_id));
    }
    self.allocas.truncate(saved_allocas_len);
    self.alloca_types.truncate(saved_alloca_types_len);
    self.var_ast_types.truncate(saved_var_ast_types_len);
    self.current_func.locals.truncate(saved_locals_len);

    Lowerer_set_current_block(self, else_block_id);
    var else_mark: i64 = self.own_temps.len();
    Lowerer_rc_scope_open(self);
    match else_block {
        OptStmts::Some(else_stmts) => {
            var ei: i64 = 0;
            while ei < else_stmts.len() {
                match else_stmts.get(ei) {
                    Stmt::Expr(e2, _) => {
                        var ev: i64 = Lowerer_lower_expr(self, e2);
                        if has_value && ei + 1 == else_stmts.len() && !Lowerer_current_block_has_terminator(self) {
                            ev = Lowerer_branch_value_to(self, ev, result_ty);
                            ev = Lowerer_rc_own_value(self, ev, ires_ty);
                            Lowerer_emit_inst(self, Inst::Store(result_slot, ev, OptIrType::None));
                        }
                    }
                    s2 => {
                        Lowerer_lower_stmt(self, s2);
                    }
                }
                ei = ei + 1;
            }
        }
        OptStmts::None => {
        }
    }
    Lowerer_rc_flush(self, else_mark);
    Lowerer_rc_scope_close(self);
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(merge_block_id));
    }
    self.allocas.truncate(saved_allocas_len);
    self.alloca_types.truncate(saved_alloca_types_len);
    self.var_ast_types.truncate(saved_var_ast_types_len);
    self.current_func.locals.truncate(saved_locals_len);

    Lowerer_set_current_block(self, merge_block_id);
    if has_value {
        // A struct is held in the slot itself (each branch copied it in):
        // its value is the slot's address, as a struct value is everywhere.
        // Loading it read the struct's first word as its address (C:
        // `val m: W = if c { f() } else { g() }` crashed on m's fields).
        if lw_is_struct_ir(result_ty) {
            Lowerer_rc_temp(self, result_slot, ires_ty);
            return result_slot;
        }
        var ires: i64 = Lowerer_emit_inst(self, Inst::Load(result_slot, result_ty));
        Lowerer_rc_temp(self, ires, ires_ty);
        return ires;
    }
    return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
}

fn Lowerer_lower_match_expr(self: & mut Lowerer, e: Box<Expr>, arms0: Vec<MatchArm>) -> i64 {
    var arms: Vec<MatchArm> = lw_value_arms(arms0);
    var match_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
    var scrutinee_ty: Type = Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(e));
    var merge_block: i64 = Lowerer_new_block(self);
    var result_ty: IrType = Lowerer_infer_match_type(self, arms);
    // Each arm stores its value into a slot allocated before branching and the
    // merge block loads it (as src/lower.rs does). The previous version jumped
    // to a merge-block parameter that no jump ever filled.
    var has_value: bool = !ir_type_eq(result_ty, IrType::Void) && !ir_type_eq(result_ty, IrType::Never);
    var result_slot: i64 = 0;
    if has_value {
        result_slot = Lowerer_emit_inst(self, Inst::Alloca(result_ty, Lowerer_current_region(self)));
    }
    // Ownership (proposal 0004): each arm hands an owner of its value to
    // the result, a temporary of the statement
    var mres_ty: Type = Type::Infer;
    if self.own_on && has_value {
        var mtails: Vec<Expr> = Vec::new();
        var mi: i64 = 0;
        while mi < arms.len() {
            match if_branch_tail_expr(arms.get(mi).body) {
                OptExpr::Some(mt) => {
                    mtails.push(mt);
                }
                OptExpr::None => {
                }
            }
            mi = mi + 1;
        }
        mres_ty = Lowerer_rc_result_type(self, mtails);
    }

    var i: i64 = 0;
    while i < arms.len() {
        var arm: MatchArm = arms.get(i);
        var arm_block: i64 = Lowerer_new_block(self);
        var next_block: i64 = Lowerer_new_block(self);

        var saved_allocas_len: i64 = self.allocas.len();
        var saved_alloca_types_len: i64 = self.alloca_types.len();
        var saved_var_ast_types_len: i64 = self.var_ast_types.len();
        var saved_locals_len: i64 = self.current_func.locals.len();

        // `None =>` on an Option is the variant (reference §6): lowered as
        // `Option::None =>` when it is one of the scrutinee's enum
        var pat: Pattern = arm.pattern;
        match pat {
            Pattern::Ident(pn) => {
                if Lowerer_bare_pattern_is_unit_variant(self, lw_box_expr_unbox(e), pn) {
                    pat = Pattern::EnumVariant("", pn, Vec::new());
                }
            }
            _ => {
            }
        }
        match pat {
            Pattern::Wildcard => {
                Lowerer_emit_terminator(self, Inst::Jump(arm_block));
            }
            Pattern::IntLit(v) => {
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstInt(v, IrType::I64)), IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::BoolLit(v) => {
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstBool(v)), IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::Ident(name) => {
                Lowerer_insert_alloca(self, name, - 1);
                Lowerer_bind_local(self, name, match_val);
                Lowerer_emit_terminator(self, Inst::Jump(arm_block));
            }
            Pattern::StrLit(s) => {
                var const_str: i64 = Lowerer_emit_inst(self, Inst::ConstStr(s));
                var dummy_env_se: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var str_eq_args: Vec<i64> = Vec::new();
                str_eq_args.push(dummy_env_se);
                str_eq_args.push(match_val);
                str_eq_args.push(const_str);
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_equal", str_eq_args, IrType::Bool, EffectSet_new()));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::Range(start_pat, end_pat) => {
                var lo: i64 = 0;
                var hi: i64 = 0;
                var range_ok: bool = false;
                match start_pat {
                    Pattern::IntLit(s) => {
                        lo = s;
                        match end_pat {
                            Pattern::IntLit(e) => {
                                hi = e;
                                range_ok = true;
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                if range_ok {
                    var start_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(lo, IrType::I64));
                    var end_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(hi, IrType::I64));
                    var lo_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::LtEq, start_val, match_val, IrType::Bool));
                    var hi_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, match_val, end_val, IrType::Bool));
                    var in_range: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::And, lo_cmp, hi_cmp, IrType::Bool));
                    Lowerer_emit_terminator(self, Inst::Branch(in_range, arm_block, next_block));
                } else {
                    Lowerer_emit_terminator(self, Inst::Jump(next_block));
                }
            }
            Pattern::EnumVariant(enum_name, variant, bindings) => {
                var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, 0, IrType::I64));
                var tag_val: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));

                var variant_idx: i64 = 0;
                // BG11: the enum a bare variant names (`pen`) decides both
                // the tag and the payload types
                var pen: str = enum_name;
                if str_len(enum_name) > 0 {
                    match Lowerer_lookup_enum(self, enum_name) {
                        OptEnumDef::Some(def) => {
                            var vi: i64 = 0;
                            while vi < def.variants.len() {
                                if def.variants.get(vi).name == variant {
                                    variant_idx = vi;
                                }
                                vi = vi + 1;
                            }
                        }
                        OptEnumDef::None => {
                        }
                    }
                } else {
                    // BG11: the scrutinee's enum, not the last enum that
                    // has a variant of this name
                    pen = Lowerer_scrutinee_pattern_enum(self, Lowerer_rc_expr_type(self, lw_box_expr_unbox(e)), variant);
                    variant_idx = Lowerer_pattern_variant_index(self, pen, variant);
                }

                var expected: i64 = Lowerer_emit_inst(self, Inst::ConstInt(variant_idx, IrType::I64));
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag_val, expected, IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));

                Lowerer_set_current_block(self, arm_block);
                self.match_scrutinee_ty = scrutinee_ty;
                var binding_tys: Vec<IrType> = Lowerer_pattern_binding_ir_types(self, pen, variant, bindings);
                var binding_ast_tys: Vec<Type> = Lowerer_pattern_binding_ast_types(self, pen, variant, bindings);
                var binding_params: Vec<bool> = Lowerer_pattern_binding_params(self, pen, variant);
                var field_idx: i64 = 1;
                // BG32: the struct bindings the arm changes (as in
                // Lowerer_lower_match)
                var vmb_names: Vec<str> = Vec::new();
                var vmb_tys: Vec<Type> = Vec::new();
                var bi: i64 = 0;
                while bi < bindings.len() {
                    var binding: Binding = bindings.get(bi);
                    var field_ty: IrType = IrType::I64;
                    if bi < binding_tys.len() {
                        field_ty = binding_tys.get(bi);
                    }
                    var is_param: bool = false;
                    if bi < binding_params.len() {
                        is_param = binding_params.get(bi);
                    }
                    var field_val: i64 = 0;
                    if is_param {
                        field_val = Lowerer_load_param_payload(self, match_val, field_idx, field_ty);
                    } else {
                        var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, field_idx, field_ty));
                        field_val = Lowerer_load_enum_field(self, field_ptr, field_ty);
                    }
                    Lowerer_insert_alloca(self, binding.name, - 1);
                    Lowerer_bind_local(self, binding.name, field_val);
                    // Register AST type so infer_expr_type can recover
                    // generic element types (e.g. Vec<FieldInit>).
                    if bi < binding_ast_tys.len() {
                        Lowerer_insert_var_ast_type(self, binding.name, binding_ast_tys.get(bi));
                        // (not a binding that is the arm's value when the
                        // result's type is unknown: nothing would take an
                        // owner of it before its copy is dropped)
                        var vmb_is_value: bool = Lowerer_rc_kind(self, mres_ty) == RC_NONE && lw_arm_tail_is(arm.body, binding.name);
                        if !is_param && !vmb_is_value && Lowerer_mb_owns_copy(self, binding.name, binding_ast_tys.get(bi), arm.body) {
                            vmb_names.push(binding.name);
                            vmb_tys.push(binding_ast_tys.get(bi));
                        } else if Lowerer_mb_plain_assigned(self, binding.name, binding_ast_tys.get(bi), arm.body) {
                            // BG258: a number the arm assigns gets a slot
                            vmb_names.push(binding.name);
                            vmb_tys.push(binding_ast_tys.get(bi));
                        }
                    }
                    if is_param {
                        field_idx = field_idx + 1;
                    } else {
                        field_idx = field_idx + Lowerer_enum_field_slots(self, field_ty);
                    }
                    bi = bi + 1;
                }
                // Arm guard: evaluated with the bindings in scope.
                match arm.guard {
                    OptBoxExpr::Some(guard_expr) => {
                        // A guard runs only for its arm: its temporaries end before the branch
                        var gmark: i64 = self.own_temps.len();
                        var guard_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(guard_expr));
                        Lowerer_rc_flush(self, gmark);
                        var guard_body_block: i64 = Lowerer_new_block(self);
                        Lowerer_emit_terminator(self, Inst::Branch(guard_val, guard_body_block, next_block));
                        Lowerer_set_current_block(self, guard_body_block);
                    }
                    OptBoxExpr::None => {
                    }
                }

                var arm_result: i64 = 0;
                var arm_has_value: bool = false;
                var arm_mark: i64 = self.own_temps.len();
                Lowerer_rc_scope_open(self);
                // BG32: a struct binding is a copy of the payload that owns
                // nothing (Lowerer_load_enum_field); one the arm changes is
                // a variable of its own, an owner of its copy dropped when
                // the arm's scope closes, as the statement form makes it
                // (Lowerer_lower_match). Replacing its field dropped the
                // payload's value, which the scrutinee dropped again.
                // (BG258: with ownership off only plain bindings are here)
                if self.own_on || vmb_names.len() > 0 {
                    var vmbi: i64 = 0;
                    while vmbi < vmb_names.len() {
                        Lowerer_lower_let_stmt(self, vmb_names.get(vmbi), OptType::Some(vmb_tys.get(vmbi)), Expr::Ident(vmb_names.get(vmbi)), true, false, Vec::new(), self.cur_line);
                        vmbi = vmbi + 1;
                    }
                }
                var si: i64 = 0;
                while si < arm.body.len() {
                    match arm.body.get(si) {
                        Stmt::Expr(e2, _) => {
                            arm_result = Lowerer_lower_expr(self, e2);
                            arm_has_value = si + 1 == arm.body.len();
                        }
                        s => {
                            Lowerer_lower_stmt(self, s);
                            arm_has_value = false;
                        }
                    }
                    si = si + 1;
                }
                if !Lowerer_current_block_has_terminator(self) && has_value && arm_has_value {
                    arm_result = Lowerer_branch_value_to(self, arm_result, result_ty);
                    arm_result = Lowerer_rc_own_value(self, arm_result, mres_ty);
                }
                Lowerer_rc_flush(self, arm_mark);
                Lowerer_rc_scope_close(self);
                if !Lowerer_current_block_has_terminator(self) {
                    if has_value && arm_has_value {
                        Lowerer_emit_inst(self, Inst::Store(result_slot, arm_result, OptIrType::None));
                    }
                    Lowerer_emit_terminator(self, Inst::Jump(merge_block));
                }
                self.allocas.truncate(saved_allocas_len);
                self.alloca_types.truncate(saved_alloca_types_len);
                self.var_ast_types.truncate(saved_var_ast_types_len);
                self.current_func.locals.truncate(saved_locals_len);
                Lowerer_set_current_block(self, next_block);
                i = i + 1;
                continue;
            }
        }

        Lowerer_set_current_block(self, arm_block);
        // Arm guard: evaluated with the bindings in scope.
        match arm.guard {
            OptBoxExpr::Some(guard_expr) => {
                // A guard runs only for its arm: its temporaries end before the branch
                var gmark: i64 = self.own_temps.len();
                var guard_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(guard_expr));
                Lowerer_rc_flush(self, gmark);
                var guard_body_block: i64 = Lowerer_new_block(self);
                Lowerer_emit_terminator(self, Inst::Branch(guard_val, guard_body_block, next_block));
                Lowerer_set_current_block(self, guard_body_block);
            }
            OptBoxExpr::None => {
            }
        }
        var arm_result: i64 = 0;
        var arm_has_value: bool = false;
        var arm_mark: i64 = self.own_temps.len();
        Lowerer_rc_scope_open(self);
        var si: i64 = 0;
        while si < arm.body.len() {
            match arm.body.get(si) {
                Stmt::Expr(e2, _) => {
                    arm_result = Lowerer_lower_expr(self, e2);
                    arm_has_value = si + 1 == arm.body.len();
                }
                s => {
                    Lowerer_lower_stmt(self, s);
                    arm_has_value = false;
                }
            }
            si = si + 1;
        }
        if !Lowerer_current_block_has_terminator(self) && has_value && arm_has_value {
            arm_result = Lowerer_branch_value_to(self, arm_result, result_ty);
            arm_result = Lowerer_rc_own_value(self, arm_result, mres_ty);
        }
        Lowerer_rc_flush(self, arm_mark);
        Lowerer_rc_scope_close(self);
        if !Lowerer_current_block_has_terminator(self) {
            if has_value && arm_has_value {
                Lowerer_emit_inst(self, Inst::Store(result_slot, arm_result, OptIrType::None));
            }
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));
        }
        self.allocas.truncate(saved_allocas_len);
        self.alloca_types.truncate(saved_alloca_types_len);
        self.var_ast_types.truncate(saved_var_ast_types_len);
        self.current_func.locals.truncate(saved_locals_len);

        Lowerer_set_current_block(self, next_block);
        i = i + 1;
    }

    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(merge_block));
    }

    Lowerer_set_current_block(self, merge_block);
    if has_value {
        // a struct held in the slot: its value is the slot's address (as in
        // Lowerer_lower_if_expr)
        if lw_is_struct_ir(result_ty) {
            Lowerer_rc_temp(self, result_slot, mres_ty);
            return result_slot;
        }
        var mres: i64 = Lowerer_emit_inst(self, Inst::Load(result_slot, result_ty));
        Lowerer_rc_temp(self, mres, mres_ty);
        return mres;
    }
    return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
}

fn Lowerer_lower_try_expr(self: & mut Lowerer, e: Box<Expr>) -> i64 {
    var tval: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));

    var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(tval, 0, IrType::I64));
    var tag: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));

    var ok_block: i64 = Lowerer_new_block(self);
    var err_block: i64 = Lowerer_new_block(self);
    var merge_block: i64 = Lowerer_new_block(self);

    var zero_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var is_ok: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag, zero_val, IrType::Bool));

    Lowerer_emit_terminator(self, Inst::Branch(is_ok, ok_block, err_block));

    Lowerer_set_current_block(self, ok_block);
    Lowerer_emit_terminator(self, Inst::Jump(merge_block));

    Lowerer_set_current_block(self, err_block);
    if self.try_stack.len() > 0 {
        var ctx: TryContext = self.try_stack.get(self.try_stack.len() - 1);
        var try_err_block: i64 = ctx.error_block;
        var try_err_slot: i64 = ctx.error_result_slot;

        var src_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(tval, 0, IrType::I64));
        var src_tag: i64 = Lowerer_emit_inst(self, Inst::Load(src_tag_ptr, IrType::I64));
        var dst_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(try_err_slot, 0, IrType::I64));
        Lowerer_emit_inst(self, Inst::Store(dst_tag_ptr, src_tag, OptIrType::None));

        var src_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(tval, 1, IrType::I64));
        var src_val: i64 = Lowerer_emit_inst(self, Inst::Load(src_val_ptr, IrType::I64));
        var dst_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(try_err_slot, 1, IrType::I64));
        Lowerer_emit_inst(self, Inst::Store(dst_val_ptr, src_val, OptIrType::None));

        // CA8: the timeout blocks opened inside the try end here
        Lowerer_to_unwind_try(self);
        Lowerer_emit_terminator(self, Inst::Jump(try_err_block));
    } else {
        // BG199: the `spawn scope` blocks it leaves join their tasks
        Lowerer_ss_join_exits(self, false);
        Lowerer_to_unwind(self, 0, 0);
        Lowerer_emit_drops(self);
        Lowerer_emit_defers(self);
        // BG65: the @persist variables are saved, as at a `return`
        Lowerer_emit_persist_saves(self);
        // Ownership (proposal 0004): the error goes to the caller with an
        // owner of its own, then this function's values are dropped. A
        // Result whose type is unknown here drops nothing (it may borrow).
        var tty: Type = Lowerer_rc_value_type(self, lw_box_expr_unbox(e), tval);
        var eval_r: i64 = tval;
        // Leaving this function's regions (proposal 0005): the copy below
        // is made outside them; lw_rg_unwind ends them at the return
        if self.rg_on && Lowerer_rg_open(self) > 0 {
            Lowerer_rg_leave(self, Lowerer_rg_open(self), false);
            // A Result whose type is unknown here cannot be copied out: its
            // regions' memory is kept instead (never freed, no longer any
            // region's), so the error the caller gets stays valid
            if Lowerer_rc_kind(self, tty) != RC_MEM {
                Lowerer_rg_call(self, 11, Lowerer_rg_open(self));
            }
        }
        if self.own_on && Lowerer_rc_kind(self, tty) == RC_MEM {
            // a copy for the error path only: the Ok path after the merge
            // reads the original (the copy's block does not dominate it)
            eval_r = Lowerer_rc_dup(self, tval, tty);
            Lowerer_rc_drop_all(self);
        } else if self.own_on && lw_try_plain_result(Lowerer_resolve_type(self, tty)) {
            // BG65: a Result (or Option) of plain values borrows nothing:
            // this function's values are dropped as at a `return` (they
            // were all left)
            Lowerer_rc_drop_all(self);
        }
        match self.current_sret {
            OptValueId::Some(sret) => {
                // Struct return: the caller reads the result from its
                // out-param, so copy tag and payload there (as src/lower.rs);
                // a bare return left the caller's buffer as it was
                var e_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(eval_r, 0, IrType::I64));
                var e_tag: i64 = Lowerer_emit_inst(self, Inst::Load(e_tag_ptr, IrType::I64));
                var r_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(sret, 0, IrType::I64));
                Lowerer_emit_inst(self, Inst::Store(r_tag_ptr, e_tag, OptIrType::None));
                var e_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(eval_r, 1, IrType::I64));
                var e_val: i64 = Lowerer_emit_inst(self, Inst::Load(e_val_ptr, IrType::I64));
                var r_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(sret, 1, IrType::I64));
                Lowerer_emit_inst(self, Inst::Store(r_val_ptr, e_val, OptIrType::None));
                Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
            }
            OptValueId::None => {
                Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(eval_r)));
            }
        }
    }

    // The unwrapped value, as the float it is for a Result<f64, E> (an i64
    // load would be converted, not reread; as src/lower.rs)
    Lowerer_set_current_block(self, merge_block);
    var ok_ty: IrType = IrType::I64;
    match Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(e)) {
        Type::Generic(gname, gargs) => {
            if (gname == "Result" || gname == "Option") && gargs.len() > 0 {
                var first_ir: IrType = Lowerer_lower_type(self, gargs.get(0));
                if ir_type_is_float(first_ir) {
                    ok_ty = first_ir;
                }
                // BG277: a narrow integer or bool as its type (the word's
                // low bytes): `Some(-3i8)?` was 253, junk on native
                if lw_narrow_word(first_ir) {
                    ok_ty = first_ir;
                }
            }
        }
        _ => {
        }
    }
    var val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(tval, 1, ok_ty));
    return Lowerer_emit_inst(self, Inst::Load(val_ptr, ok_ty));
}

/// BG65: whether `t` is a Result or an Option whose type arguments are all
/// numbers or bools: its error holds nothing a local could own.
fn lw_try_plain_result(t: Type) -> bool {
    match t {
        Type::Generic(gn, gargs) => {
            if (gn != "Result" && gn != "Option") || gargs.len() == 0 {
                return false;
            }
            var i: i64 = 0;
            while i < gargs.len() {
                if !lw_try_plain_scalar(gargs.get(i)) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        _ => {
        }
    }
    return false;
}

fn lw_try_plain_scalar(t: Type) -> bool {
    match t {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::I64 => {
            return true;
        }
        Type::U8 => {
            return true;
        }
        Type::U16 => {
            return true;
        }
        Type::U32 => {
            return true;
        }
        Type::U64 => {
            return true;
        }
        Type::F32 => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        Type::Void => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

fn Lowerer_lower_try_block_expr(self: & mut Lowerer, stmts: Vec<Stmt>) -> i64 {
    var err_slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct("Result"), Lowerer_current_region(self)));
    var result_slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct("Result"), Lowerer_current_region(self)));

    var err_block: i64 = Lowerer_new_block(self);
    var cont_block: i64 = Lowerer_new_block(self);

    self.try_stack.push(TryContext_new(err_block, err_slot));

    var last_val: i64 = 0;
    var has_last: bool = false;
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Expr(e, _) => {
                last_val = Lowerer_lower_expr(self, e);
                has_last = true;
            }
            s => {
                Lowerer_lower_stmt(self, s);
                has_last = false;
            }
        }
        i = i + 1;
    }

    self.try_stack.pop();

    // T of the Result (reference §4.9): the type of the block's last expression
    var ok_ty: Type = Lowerer_try_value_type(self, stmts);
    var ok_val: i64 = 0;
    if has_last {
        // The Result keeps the value as its `T`: it is owned as a `let` would
        // own it (proposal 0004), so a string made in the block is the
        // Result's, as the value of an `if` is the `val`'s
        ok_val = Lowerer_rc_own_value(self, last_val, ok_ty);
    } else {
        ok_val = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    }

    var ok_tag: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(result_slot, 0, IrType::I64));
    var _s1: i64 = Lowerer_emit_inst(self, Inst::Store(tag_ptr, ok_tag, OptIrType::None));
    var val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(result_slot, 1, IrType::I64));
    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(val_ptr, ok_val, OptIrType::None));
    Lowerer_emit_terminator(self, Inst::Jump(cont_block));

    Lowerer_set_current_block(self, err_block);
    var err_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(err_slot, 0, IrType::I64));
    var err_tag: i64 = Lowerer_emit_inst(self, Inst::Load(err_tag_ptr, IrType::I64));
    var out_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(result_slot, 0, IrType::I64));
    var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(out_tag_ptr, err_tag, OptIrType::None));
    var err_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(err_slot, 1, IrType::I64));
    var err_val: i64 = Lowerer_emit_inst(self, Inst::Load(err_val_ptr, IrType::I64));
    var out_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(result_slot, 1, IrType::I64));
    var _s4: i64 = Lowerer_emit_inst(self, Inst::Store(out_val_ptr, err_val, OptIrType::None));
    Lowerer_emit_terminator(self, Inst::Jump(cont_block));

    Lowerer_set_current_block(self, cont_block);
    // The Result itself is a temporary of Result<T, i64> (one with a string
    // payload owns the string): a `val` takes it over, as the value of an `if`
    var tr_args: Vec<Type> = Vec::new();
    tr_args.push(ok_ty);
    tr_args.push(Type::I64);
    Lowerer_rc_temp(self, result_slot, Type::Generic("Result", tr_args));
    return result_slot;
}

/// T of `try { stmts; expr }`: the type of its last expression statement, as
/// the type checker takes it (reference §4.9); i64 when the block has none.
fn Lowerer_try_value_type(self: & Lowerer, stmts: Vec<Stmt>) -> Type {
    var last: Expr = Expr::IntLit(0);
    var si: i64 = 0;
    while si < stmts.len() {
        match stmts.get(si) {
            Stmt::Expr(e, _) => {
                last = e;
            }
            _ => {
            }
        }
        si = si + 1;
    }
    return Lowerer_enum_arg_ast_type(self, last);
}

// Closures being lowered right now, one inside another (the depth of the
// next one): see Lowerer_lower_closure_expr
var g_lw_closure_depth: i64 = 0;

fn Lowerer_lower_closure_expr(self: & mut Lowerer, params: Vec<Param>, body: Vec<Stmt>, ret_ty: OptType) -> i64 {
    var closure_id: i64 = self.module.functions.len();
    var closure_name: str = str_concat("__closure_", int_to_str(closure_id));
    // A closure joins module.functions once its body is lowered, so one
    // made inside it saw the same count and took the same name (a call
    // through the inner one, dispatched by name, ran the outer one). A
    // nested closure's name says its depth: siblings at one depth start
    // after the previous one joined, so the count differs between them.
    if g_lw_closure_depth > 0 {
        closure_name = closure_name + "_" + int_to_str(g_lw_closure_depth);
    }

    var param_names: Vec<str> = Vec::new();
    var pi: i64 = 0;
    while pi < params.len() {
        param_names.push(params.get(pi).name);
        pi = pi + 1;
    }
    var captures: Vec<StringTypeEntry> = Lowerer_find_captures(self, body, param_names);

    var saved_captures: Vec<ClosureCapture> = self.current_captures;
    var empty_captures: Vec<ClosureCapture> = Vec::new();
    self.current_captures = empty_captures;
    var ci: i64 = 0;
    while ci < captures.len() {
        var cap: StringTypeEntry = captures.get(ci);
        self.current_captures.push(ClosureCapture_new(cap.key, ci + 1, cap.val));
        ci = ci + 1;
    }

    var inferred_ret_ty: Type = Type::I64;
    match ret_ty {
        OptType::Some(rt) => {
            inferred_ret_ty = rt;
        }
        OptType::None => {
            inferred_ret_ty = Lowerer_infer_closure_ret_ty(self, body);
        }
    }

    var closure_func: Func = Func_new_full(closure_name, params, inferred_ret_ty, body, false);

    var saved_func: IrFunction = self.current_func;
    var saved_has_func: bool = self.has_current_func;
    var saved_allocas: Vec<StringValueIdEntry> = self.allocas;
    var saved_alloca_types: Vec<I64IrTypeEntry> = self.alloca_types;
    var saved_var_ast_types: Vec<StringTypeEntry> = self.var_ast_types;
    var saved_block: i64 = self.current_block;
    var saved_sret: OptValueId = self.current_sret;

    g_lw_closure_depth = g_lw_closure_depth + 1;
    Lowerer_lower_func(self, closure_func);
    g_lw_closure_depth = g_lw_closure_depth - 1;

    self.current_func = saved_func;
    self.has_current_func = saved_has_func;
    self.allocas = saved_allocas;
    self.alloca_types = saved_alloca_types;
    self.var_ast_types = saved_var_ast_types;
    Lowerer_ix_reset_tables(self);
    self.current_block = saved_block;
    self.current_sret = saved_sret;
    self.current_captures = saved_captures;

    return Lowerer_make_fn_env(self, closure_name, captures);
}

fn Lowerer_lower_struct_lit_expr(self: & mut Lowerer, name: str, fields: Vec<FieldInit>, spread: OptBoxExpr) -> i64 {
    // As src/lower.rs: resolve a type alias to the struct, copy every field
    // of a `..spread` source first, then store the explicit fields.
    var real_name: str = Lowerer_resolve_struct_name(self, name);
    var struct_ty: IrType = IrType::Struct(real_name);
    var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(struct_ty, Lowerer_current_region(self)));

    match spread {
        OptBoxExpr::Some(spread_expr) => {
            var src_ptr: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(spread_expr));
            match IrModule_get_struct(& self.module, real_name) {
                OptStructLayout::Some(slayout) => {
                    var si: i64 = 0;
                    while si < slayout.fields.len() {
                        var sfty: IrType = slayout.fields.get(si).ty;
                        var dst_fp: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, si, sfty));
                        var src_fp: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(src_ptr, si, sfty));
                        match sfty {
                            IrType::Struct(fsn) => {
                                Lowerer_emit_struct_copy(self, src_fp, dst_fp, fsn);
                            }
                            _ => {
                                var sv: i64 = Lowerer_emit_inst(self, Inst::Load(src_fp, sfty));
                                var _ss: i64 = Lowerer_emit_inst(self, Inst::Store(dst_fp, sv, OptIrType::None));
                            }
                        }
                        si = si + 1;
                    }
                }
                OptStructLayout::None => {
                }
            }
        }
        OptBoxExpr::None => {
        }
    }
    // Ownership (proposal 0004): the copied fields of a `..spread` get one
    // more owner each; an explicit field then replaces (drops) its copy
    var lit_ty: Type = Type::Named(real_name);
    var has_spread: bool = false;
    match spread {
        OptBoxExpr::Some(_) => {
            has_spread = true;
        }
        OptBoxExpr::None => {
        }
    }
    // A generic struct's literal is owned as its instance (Pair<str, i64>):
    // the let's declared type, the spread source's type, or the types of
    // what its type-parameter fields are given (owned as those types).
    // Owned as `Pair` it owned nothing (its parameters unknown), was no
    // temporary, and its strings were never dropped.
    var gen_params: Vec<str> = Vec::new();
    var gen_args: Vec<Type> = Vec::new();
    var gen_fixed: bool = false;
    if self.own_on && real_name != "Vec" && real_name != "HashMap" && real_name != "Box" && real_name != "Rc" && real_name != "Arc" {
        match Lowerer_lookup_struct(self, real_name) {
            OptStructDef::Some(gsd) => {
                gen_params = gsd.type_params;
            }
            OptStructDef::None => {
            }
        }
    }
    if gen_params.len() > 0 {
        match self.let_hint {
            OptType::Some(glh) => {
                var grt: Type = lw_rc_strip_ref(Lowerer_resolve_type(self, glh));
                if lw_rc_type_name(grt) == real_name && lw_rc_type_args(grt).len() == gen_params.len() {
                    lit_ty = grt;
                    gen_fixed = true;
                }
            }
            OptType::None => {
            }
        }
        if !gen_fixed {
            match spread {
                OptBoxExpr::Some(gse) => {
                    var gst: Type = lw_rc_strip_ref(Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, lw_box_expr_unbox(gse))));
                    if lw_rc_type_name(gst) == real_name && lw_rc_type_args(gst).len() == gen_params.len() {
                        lit_ty = gst;
                        gen_fixed = true;
                    }
                }
                OptBoxExpr::None => {
                }
            }
        }
        if gen_fixed {
            gen_args = lw_rc_type_args(lit_ty);
        } else if has_spread {
            // a copy of a source of unknown instance: owned as before
            gen_params = Vec::new();
        } else {
            gen_args = lw_rc_type_args(Lowerer_struct_lit_ast_type(self, real_name, fields));
            if gen_args.len() != gen_params.len() {
                gen_params = Vec::new();
            }
        }
    }
    if self.own_on && has_spread && Lowerer_rc_kind(self, lit_ty) == RC_MEM {
        Lowerer_rc_call_mem(self, "__own_dup_", alloca, lit_ty);
    }
    // The type-parameter fields: the field, its value and its parameter
    // (one given a struct or an enum is boxed below when the literal is
    // owned)
    var box_ptrs: Vec<i64> = Vec::new();
    var box_vals: Vec<i64> = Vec::new();
    var box_params: Vec<i64> = Vec::new();

    match IrModule_get_struct(& self.module, real_name) {
        OptStructLayout::Some(layout) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                var field_init: FieldInit = fields.get(fi);
                var field_val: i64 = 0;
                var lfty: Type = Type::Infer;
                if self.own_on {
                    lfty = Lowerer_rc_field_ast_type(self, real_name, field_init.name);
                    if lw_is_vec_new_expr(field_init.value) || lw_rc_is_map_new_expr(field_init.value) {
                        field_val = Lowerer_rc_new_coll(self, lfty);
                        if field_val < 0 {
                            field_val = Lowerer_lower_expr(self, field_init.value);
                        }
                    } else if lw_vec_filled_args(field_init.value).len() == 2 && Lowerer_has_function(self, "Vec_filled_typed") {
                        field_val = Lowerer_lower_vec_filled(self, lw_vec_filled_args(field_init.value), lfty);
                    } else {
                        field_val = Lowerer_lower_keep(self, field_init.value);
                    }
                    if Lowerer_rc_kind(self, lfty) == RC_NONE {
                        lfty = Lowerer_rc_value_type(self, field_init.value, field_val);
                    }
                    field_val = Lowerer_rc_own_value(self, field_val, lfty);
                } else {
                    field_val = Lowerer_lower_value(self, field_init.value);
                }
                // A type-parameter field of a generic literal: the instance
                // takes the type it is owned as; one the instance says owns
                // something that was not owned gets an owner of its own
                // (the instance's drop drops what it says)
                var gpi: i64 = - 1;
                if gen_params.len() > 0 {
                    gpi = lw_rc_param_index(Lowerer_rc_field_ast_type(self, real_name, field_init.name), gen_params);
                }
                if gpi >= 0 && gpi < gen_args.len() {
                    var vk: i64 = Lowerer_rc_kind(self, lfty);
                    if vk != RC_NONE {
                        // (a string, Vec or map the inference typed alike
                        // keeps its fuller type: its drop is the same)
                        var ak: i64 = Lowerer_rc_kind(self, gen_args.get(gpi));
                        var same: bool = ak == vk && (vk == RC_STR || vk == RC_VEC || vk == RC_MAP);
                        if !gen_fixed && !same {
                            gen_args.set(gpi, lfty);
                        }
                    } else if Lowerer_rc_kind(self, gen_args.get(gpi)) != RC_NONE {
                        lfty = gen_args.get(gpi);
                        field_val = Lowerer_rc_own_value(self, field_val, lfty);
                    }
                    if gen_fixed {
                        lfty = gen_args.get(gpi);
                    }
                }
                var field_idx: i64 = - 1;
                var fj: i64 = 0;
                while fj < layout.fields.len() && field_idx < 0 {
                    if layout.fields.get(fj).name == field_init.name {
                        field_idx = fj;
                    }
                    fj = fj + 1;
                }
                if field_idx >= 0 {
                    var field_ty: IrType = layout.fields.get(field_idx).ty;
                    var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, field_idx, field_ty));
                    if self.own_on && has_spread && gpi >= 0 {
                        // The spread's copy of a type-parameter field (a
                        // word: a struct is a pointer to its heap copy)
                        Lowerer_rc_gen_param_payload(self, Lowerer_rc_as_i64(self, field_ptr), 0, lfty, false);
                    } else if self.own_on && has_spread {
                        // The spread's copy of this field is replaced
                        var sk: i64 = Lowerer_rc_kind(self, lfty);
                        if sk == RC_MEM {
                            Lowerer_rc_call_mem(self, "__own_drop_", field_ptr, lfty);
                        } else if sk != RC_NONE {
                            Lowerer_rc_drop(self, Lowerer_emit_inst(self, Inst::Load(field_ptr, field_ty)), lfty);
                        }
                    }
                    // A type-parameter field holds the value's bits as a word
                    // (an f64 is not converted to an integer, a string's
                    // pointer is kept), as a generic enum's payload does
                    if Lowerer_field_is_type_param(self, real_name, field_init.name) {
                        var fvt: IrType = Lowerer_get_value_type(self, field_val);
                        match fvt {
                            IrType::F64 => {
                                var fb: Vec<i64> = Vec::new();
                                fb.push(field_val);
                                field_val = Lowerer_emit_inst(self, Inst::Call("p_f64_to_bits", fb, IrType::I64, EffectSet_new()));
                            }
                            // BG270: an f32 as its f64's bits (the backends
                            // each stored a different word: f64 bits, a
                            // number, f32 bits)
                            IrType::F32 => {
                                field_val = Lowerer_f64_word_bits(self, field_val);
                            }
                            _ => {
                            }
                        }
                        if gpi >= 0 {
                            box_ptrs.push(field_ptr);
                            box_vals.push(field_val);
                            box_params.push(gpi);
                        }
                    }
                    match field_ty {
                        IrType::Struct(field_struct_name) => {
                            // a tuple or a generic instance given as a word
                            // (a parameter's) is the address of its value
                            field_val = Lowerer_held_addr(self, field_val, field_ty);
                            Lowerer_emit_struct_copy(self, field_val, field_ptr, field_struct_name);
                        }
                        // BG369: a `[T; N]` field is one word, the address
                        // of the array's elements: the literal keeps a heap
                        // copy of its own (reference §8.1: arrays are
                        // values). It was the address of the literal's (or
                        // the variable's) stack data: dead after the
                        // function returned, shared by every copy.
                        IrType::Array(_, _) => {
                            if lw_ir_is_array_val(Lowerer_get_value_type(self, field_val)) {
                                field_val = Lowerer_arr_heap_copy(self, field_val, field_ty);
                            }
                            var _sa: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, field_val, OptIrType::None));
                        }
                        _ => {
                            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, field_val, OptIrType::None));
                        }
                    }
                }
                fi = fi + 1;
            }
        }
        OptStructLayout::None => {
            // Unknown struct: evaluate the field values for their effects.
            var ui: i64 = 0;
            while ui < fields.len() {
                var _uv: i64 = Lowerer_lower_expr(self, fields.get(ui).value);
                ui = ui + 1;
            }
        }
    }

    // A new struct: a temporary the statement owns
    if gen_params.len() > 0 {
        if !gen_fixed {
            lit_ty = Type::Generic(real_name, gen_args);
        }
        // A type-parameter field holds a struct (or an enum) as a pointer
        // to its heap copy, as a generic enum's payload does: what the
        // instance's drop frees and its dup copies
        // (Lowerer_rc_gen_param_payload, by the instance's type argument); a
        // pointer to the value itself was freed by that drop, and left
        // dangling by a return. BG185: so is one that owns nothing (no
        // glue frees that copy: a leak, where the address of a by-value
        // `self` or of a local was kept and read after its frame was gone,
        // `Slot { v: self, n: 42 }` in a generic method)
        if Lowerer_rc_kind(self, lit_ty) == RC_MEM || box_ptrs.len() > 0 {
            var largs: Vec<Type> = lw_rc_type_args(lit_ty);
            var bi: i64 = 0;
            while bi < box_ptrs.len() {
                var bp: i64 = box_params.get(bi);
                if bp < largs.len() && Lowerer_rc_is_mem_type(self, Lowerer_resolve_type(self, largs.get(bp))) {
                    var bty: IrType = Lowerer_rc_mem_ir(self, largs.get(bp));
                    var bsize: i64 = IrModule_type_size(& self.module, bty);
                    if bsize < 8 {
                        bsize = 8;
                    }
                    var bsz: i64 = Lowerer_emit_inst(self, Inst::ConstInt(bsize, IrType::I64));
                    var bheap: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(bsz), IrType::Ptr(Box::new(bty)), EffectSet_new()));
                    // the value is the address of the struct (a word too)
                    var bsrc: i64 = box_vals.get(bi);
                    var bvt: IrType = Lowerer_get_value_type(self, bsrc);
                    match bvt {
                        IrType::Ptr(_) => {
                        }
                        _ => {
                            bsrc = Lowerer_emit_inst(self, Inst::BitCast(bsrc, bvt, IrType::Ptr(Box::new(bty))));
                        }
                    }
                    Lowerer_emit_inst(self, Inst::Store(bheap, bsrc, OptIrType::Some(bty)));
                    Lowerer_emit_inst(self, Inst::Store(box_ptrs.get(bi), bheap, OptIrType::None));
                }
                bi = bi + 1;
            }
        }
    } else {
        match self.let_hint {
            OptType::Some(lh) => {
                if lw_rc_type_name(Lowerer_resolve_type(self, lh)) == real_name {
                    lit_ty = Lowerer_resolve_type(self, lh);
                }
            }
            OptType::None => {
            }
        }
    }
    Lowerer_rc_temp(self, alloca, lit_ty);
    return alloca;
}

/// The position of type parameter `t` (a Named type) among `params`, or -1.
fn lw_rc_param_index(t: Type, params: Vec<str>) -> i64 {
    match t {
        Type::Named(n) => {
            var i: i64 = 0;
            while i < params.len() {
                if params.get(i) == n {
                    return i;
                }
                i = i + 1;
            }
        }
        _ => {
        }
    }
    return - 1;
}


/// Whether a value of IR type `ty` shown as text goes through core's
/// u64_to_str, as `print` shows a u64 (Lowerer_emit_print): the runtimes'
/// p_to_str is signed. False when u64_to_str is not in the program (a build
/// without the core library).
fn Lowerer_u64_text(self: & mut Lowerer, ty: IrType) -> bool {
    if !ir_type_eq(ty, IrType::U64) {
        return false;
    }
    match Lowerer_lookup_func_ret_type(self, "u64_to_str") {
        OptType::Some(_) => {
            return true;
        }
        OptType::None => {
            return false;
        }
    }
}

fn Lowerer_lower_fstring_expr(self: & mut Lowerer, parts: Vec<FStringPart>) -> i64 {
    var result: i64 = Lowerer_emit_inst(self, Inst::ConstStr(""));
    var i: i64 = 0;
    while i < parts.len() {
        match parts.get(i) {
            FStringPart::Literal(s) => {
                var s_val: i64 = Lowerer_emit_inst(self, Inst::ConstStr(s));
                var args: Vec<i64> = Vec::new();
                args.push(result);
                args.push(s_val);
                result = Lowerer_emit_inst(self, Inst::Call("p_str_concat", args, lw_ptr_u8(), EffectSet_new()));
            }
            FStringPart::Expr(e) => {
                var e_val: i64 = Lowerer_lower_expr(self, e);
                var e_ty: IrType = Lowerer_get_value_type(self, e_val);
                var str_val: i64 = 0;
                var is_ptr: bool = false;
                match e_ty {
                    IrType::Ptr(_) => {
                        str_val = e_val;
                        is_ptr = true;
                    }
                    _ => {
                    }
                }
                if !is_ptr {
                    if ir_type_eq(e_ty, IrType::F64) {
                        var conv_args: Vec<i64> = Vec::new();
                        conv_args.push(e_val);
                        str_val = Lowerer_emit_inst(self, Inst::Call("p_float_to_str", conv_args, lw_ptr_u8(), EffectSet_new()));
                    } else if ir_type_eq(e_ty, IrType::F32) {
                        // BG157: an f32 is widened to f64 (`as f64`) and shown
                        // as a float (it went to p_to_str: its bits printed)
                        var conv_args: Vec<i64> = Vec::new();
                        conv_args.push(Lowerer_lower_cast(self, e_val, IrType::F32, IrType::F64));
                        str_val = Lowerer_emit_inst(self, Inst::Call("p_float_to_str", conv_args, lw_ptr_u8(), EffectSet_new()));
                    } else if ir_type_eq(e_ty, IrType::Bool) {
                        var conv_args: Vec<i64> = Vec::new();
                        conv_args.push(e_val);
                        str_val = Lowerer_emit_inst(self, Inst::Call("p_bool_to_str", conv_args, lw_ptr_u8(), EffectSet_new()));
                    } else if ir_type_is_opaque_named(e_ty, "Vec") {
                        var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                        var vec_args: Vec<i64> = Vec::new();
                        vec_args.push(dummy_env);
                        vec_args.push(e_val);
                        // BG279: f64/f32/bool/u64 elements as their text
                        str_val = Lowerer_coll_to_str(self, e_val, e_ty, Lowerer_eq_ast_type(self, e));
                        if str_val < 0 {
                            str_val = Lowerer_emit_inst(self, Inst::Call("Vec_to_str", vec_args, lw_ptr_u8(), EffectSet_new()));
                        }
                    } else if ir_type_is_opaque_named(e_ty, "HashMap") {
                        // BG303: a map shows as println shows it (`{5: 5}`);
                        // p_to_str printed the handle's address
                        var map_args: Vec<i64> = Vec::new();
                        map_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
                        map_args.push(e_val);
                        // BG279: f64/f32/bool/u64 keys and values as text
                        str_val = Lowerer_coll_to_str(self, e_val, e_ty, Lowerer_eq_ast_type(self, e));
                        if str_val < 0 {
                            str_val = Lowerer_emit_inst(self, Inst::Call("HashMap_to_str", map_args, lw_ptr_u8(), EffectSet_new()));
                        }
                    } else if Lowerer_u64_text(self, e_ty) {
                        // reference §3.5: a u64 is unsigned for printing, as
                        // `print` shows it. f"{a}" of 18446744073709551614 came
                        // out as -2: every runtime's p_to_str is signed
                        var conv_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                        var conv_args: Vec<i64> = Vec::new();
                        conv_args.push(conv_env);
                        conv_args.push(e_val);
                        str_val = Lowerer_emit_inst(self, Inst::Call("u64_to_str", conv_args, lw_ptr_u8(), EffectSet_new()));
                    } else {
                        var conv_args: Vec<i64> = Vec::new();
                        conv_args.push(e_val);
                        str_val = Lowerer_emit_inst(self, Inst::Call("p_to_str", conv_args, lw_ptr_u8(), EffectSet_new()));
                    }
                }
                var concat_args: Vec<i64> = Vec::new();
                concat_args.push(result);
                concat_args.push(str_val);
                result = Lowerer_emit_inst(self, Inst::Call("p_str_concat", concat_args, lw_ptr_u8(), EffectSet_new()));
            }
        }
        i = i + 1;
    }
    return result;
}

pub fn Lowerer_lower_expr(self: & mut Lowerer, expr: Expr) -> i64 {
    match expr {
        Expr::IntLit(n) => {
            return Lowerer_emit_inst(self, Inst::ConstInt(n, IrType::I64));
        }
        Expr::FloatLit(f) => {
            // ConstFloat now stores the f64 value directly
            return Lowerer_emit_inst(self, Inst::ConstFloat(f, IrType::F64));
        }
        Expr::BoolLit(b) => {
            return Lowerer_emit_inst(self, Inst::ConstBool(b));
        }
        Expr::StringLit(s) => {
            // Intern the string
            var _label: str = IrModule_intern_string(& mut self.module, s);
            return Lowerer_emit_inst(self, Inst::ConstStr(s));
        }
        Expr::Ident(name) => {
            // Check if this is a captured variable in a closure
            var ci: i64 = 0;
            while ci < self.current_captures.len() {
                if self.current_captures.get(ci).name == name {
                    var idx: i64 = self.current_captures.get(ci).field_index;
                    var cap_ir_ty: IrType = Lowerer_lower_type(self, self.current_captures.get(ci).ty);
                    // A struct capture is the address of the env's copy
                    // (Lowerer_make_fn_env)
                    match cap_ir_ty {
                        IrType::Struct(csn) => {
                            cap_ir_ty = IrType::Ptr(Box::new(IrType::Struct(csn)));
                        }
                        _ => {
                        }
                    }
                    // Load from env struct: env_ptr is the first param, after
                    // the result pointer of a closure returning a struct
                    var env_at: i64 = 0;
                    match self.current_sret {
                        OptValueId::Some(_) => {
                            env_at = 1;
                        }
                        OptValueId::None => {
                        }
                    }
                    if self.current_func.params.len() > env_at {
                        var env_val: i64 = self.current_func.params.get(env_at).id;
                        var idx_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(idx, IrType::I64));
                        var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(env_val, idx_val, IrType::I64));
                        return Lowerer_emit_inst(self, Inst::Load(elem_ptr, cap_ir_ty));
                    }
                }
                ci = ci + 1;
            }

            // Check if mutable variable with alloca
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(alloca) => {
                    var load_ty: IrType = IrType::I64;
                    match Lowerer_lookup_alloca_type(self, alloca) {
                        OptIrType::Some(t) => {
                            load_ty = t;
                        }
                        OptIrType::None => {
                            load_ty = IrType::I64;
                        }
                    }
                    // Gap 3 fix: If the alloca holds a struct pointer (SRET case),
                    // load the pointer.
                    match load_ty {
                        IrType::Ptr(inner) => {
                            match box_ir_type_unbox(inner) {
                                IrType::Struct(_) => {
                                    return Lowerer_emit_inst(self, Inst::Load(alloca, load_ty));
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    // Gap 3 fix: If the alloca holds an inline struct, return
                    // the alloca pointer directly - the alloca IS the struct
                    // data, so the pointer to it is the struct value.
                    match load_ty {
                        IrType::Struct(_) => {
                            return alloca;
                        }
                        _ => {
                        }
                    }
                    return Lowerer_emit_inst(self, Inst::Load(alloca, load_ty));
                }
                OptValueId::None => {
                }
            }

            // Check if local variable
            match Lowerer_lookup_local(self, name) {
                OptValueId::Some(local_val) => {
                    return local_val;
                }
                OptValueId::None => {
                }
            }

            // Check if constant (pc)
            match Lowerer_lookup_constant(self, name) {
                OptExpr::Some(const_expr) => {
                    return Lowerer_lower_expr(self, const_expr);
                }
                OptExpr::None => {
                }
            }

            // Check if module-level mutable global
            match IrModule_get_global(& self.module, name) {
                OptGlobalLookup::Some(ir_ty, _init) => {
                    var addr: i64 = Lowerer_emit_inst(self, Inst::GlobalAddr(name, ir_ty));
                    // For struct/enum types, the GlobalAddr already gives a
                    // pointer to the struct. Return it directly without a Load
                    // (matching the pattern for struct locals above).
                    match ir_ty {
                        IrType::Struct(_) => {
                            return addr;
                        }
                        _ => {
                        }
                    }
                    return Lowerer_emit_inst(self, Inst::Load(addr, ir_ty));
                }
                OptGlobalLookup::None => {
                }
            }

            // A function name used as a value: a closure env holding the
            // function reference (as in src/lower.rs). Previously this fell
            // through to the zero fallback, so `apply(twice, 21)` passed 0.
            var is_fn: bool = lw_fn_at(& self.module, name) >= 0;
            if !is_fn && Lowerer_extern_at(self, name) >= 0 {
                is_fn = true;
            }
            if is_fn {
                var no_captures: Vec<StringTypeEntry> = Vec::new();
                return Lowerer_make_fn_env(self, name, no_captures);
            }
            // Unknown - emit zero
            return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        }
        Expr::Binary(op, left, right) => {
            if binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
                // Short-circuit: the right operand runs only when it decides
                // the result (`i < n && v[i] == x` must not read v[n]).
                var slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Bool, Lowerer_current_region(self)));
                var lhs: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(left));
                Lowerer_emit_inst(self, Inst::Store(slot, lhs, OptIrType::None));
                var rhs_bb: i64 = Lowerer_new_block(self);
                var merge_bb: i64 = Lowerer_new_block(self);
                if binop_eq(op, BinOp::And) {
                    Lowerer_emit_terminator(self, Inst::Branch(lhs, rhs_bb, merge_bb));
                } else {
                    Lowerer_emit_terminator(self, Inst::Branch(lhs, merge_bb, rhs_bb));
                }
                Lowerer_set_current_block(self, rhs_bb);
                // The right side's temporaries end with it: it may not run
                // (proposal 0004)
                var rhs_mark: i64 = self.own_temps.len();
                var rhs: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(right));
                Lowerer_emit_inst(self, Inst::Store(slot, rhs, OptIrType::None));
                Lowerer_rc_flush(self, rhs_mark);
                Lowerer_emit_terminator(self, Inst::Jump(merge_bb));
                Lowerer_set_current_block(self, merge_bb);
                return Lowerer_emit_inst(self, Inst::Load(slot, IrType::Bool));
            }
            // V1a (miscompile-log): a literal on the left of `<<`/`>>`
            // (`(2 << a) - b`) takes the type of the other operand when
            // that one's is fixed and narrow, as a bare literal does (§3.5);
            // lw_int_op_type types the operation the same way
            if lw_binop_ctx_flows(op) {
                var v1a_l: Expr = lw_box_expr_unbox(left);
                var v1a_r: Expr = lw_box_expr_unbox(right);
                if lw_has_lit_shift(v1a_l) && !lw_lit_like(v1a_r) {
                    var v1a_rt: IrType = Lowerer_infer_expr_type(self, v1a_r);
                    var v1a_ra: Type = lw_narrow_int_ast(v1a_rt);
                    if lw_ast_narrow_int(v1a_ra) {
                        var v1a_nl: Expr = lw_ctx_type_literals(v1a_l, v1a_ra, v1a_rt);
                        if !lw_has_lit_shift(v1a_nl) {
                            return Lowerer_lower_expr(self, Expr::Binary(op, Box::new(v1a_nl), Box::new(v1a_r)));
                        }
                    }
                }
                if lw_has_lit_shift(v1a_r) && !lw_lit_like(v1a_l) {
                    var v1a_lt: IrType = Lowerer_infer_expr_type(self, v1a_l);
                    var v1a_la: Type = lw_narrow_int_ast(v1a_lt);
                    if lw_ast_narrow_int(v1a_la) {
                        var v1a_nr: Expr = lw_ctx_type_literals(v1a_r, v1a_la, v1a_lt);
                        if !lw_has_lit_shift(v1a_nr) {
                            return Lowerer_lower_expr(self, Expr::Binary(op, Box::new(v1a_l), Box::new(v1a_nr)));
                        }
                    }
                }
            }
            // CL10: `a < b` on a unit compares the f64 each holds (a number
            // literal on the right is never a unit: no inference then)
            if lw_binop_is_order(op) && !lw_expr_is_num_lit(lw_box_expr_unbox(right)) {
                var cmp_un: str = lw_ir_struct_name(Lowerer_infer_expr_type(self, lw_box_expr_unbox(left)));
                if str_len(cmp_un) > 0 && Lowerer_struct_dim(self, cmp_un) != 0 {
                    var cmp_l: Expr = Lowerer_dim_operand(self, lw_box_expr_unbox(left), cmp_un);
                    var cmp_r: Expr = Lowerer_dim_operand(self, lw_box_expr_unbox(right), cmp_un);
                    return Lowerer_lower_expr(self, Expr::Binary(op, Box::new(cmp_l), Box::new(cmp_r)));
                }
            }
            // CL10: `a op b` on a struct with an operator method (`add`,
            // `sub`, `mul`, `div`, `rem`) is `a.op(b)`; `2.0 * m` is
            // `m.rmul(2.0)`; on units (@dimension) the dimension rule
            // (typechecker section "units of measure", Lowerer_binop_plan)
            var sop: str = binop_operator_method(op);
            if str_len(sop) > 0 {
                var sop_lt: IrType = Lowerer_infer_expr_type(self, lw_box_expr_unbox(left));
                var sop_plan: i64 = Lowerer_binop_plan_exprs(self, op, sop_lt, lw_box_expr_unbox(right));
                if sop_plan == 1 {
                    var sop_args: Vec<Expr> = Vec::new();
                    sop_args.push(lw_box_expr_unbox(right));
                    return Lowerer_lower_expr(self, Expr::MethodCall(left, sop, sop_args));
                }
                if sop_plan == 2 {
                    // the right operand is evaluated first (it is the receiver)
                    var rop_args: Vec<Expr> = Vec::new();
                    rop_args.push(lw_box_expr_unbox(left));
                    return Lowerer_lower_expr(self, Expr::MethodCall(right, "r" + sop, rop_args));
                }
                if sop_plan == 3 {
                    return Lowerer_lower_dim_operator(self, op, lw_box_expr_unbox(left), lw_box_expr_unbox(right), sop_lt, Lowerer_infer_expr_type(self, lw_box_expr_unbox(right)));
                }
            }
            // Operator overloading for vec types (Phase 8A): vec +/- vec
            // calls vecN_add/vecN_sub, vec * scalar and scalar * vec call
            // vecN_scale, vec / scalar scales by 1/scalar.
            match get_vec_type_name(Lowerer_infer_expr_type(self, lw_box_expr_unbox(left))) {
                OptStringLower::Some(vn) => {
                    var same: bool = false;
                    match get_vec_type_name(Lowerer_infer_expr_type(self, lw_box_expr_unbox(right))) {
                        OptStringLower::Some(rvn) => {
                            same = rvn == vn;
                        }
                        OptStringLower::None => {
                        }
                    }
                    if same {
                        if binop_eq(op, BinOp::Add) {
                            return Lowerer_lower_vec_method_call(self, vn, "add", lw_box_expr_unbox(left), lw_box_expr_unbox(right));
                        }
                        if binop_eq(op, BinOp::Sub) {
                            return Lowerer_lower_vec_method_call(self, vn, "sub", lw_box_expr_unbox(left), lw_box_expr_unbox(right));
                        }
                    } else if binop_eq(op, BinOp::Mul) {
                        return Lowerer_lower_vec_method_call(self, vn, "scale", lw_box_expr_unbox(left), lw_box_expr_unbox(right));
                    } else if binop_eq(op, BinOp::Div) {
                        var vl: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(left));
                        var vr: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(right));
                        var one: i64 = Lowerer_emit_inst(self, Inst::ConstFloat(1.0, IrType::F64));
                        var inv: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Div, one, vr, IrType::F64));
                        return Lowerer_lower_vec_sret_call(self, vn + "_scale", IrType::Struct(vn), vl, inv);
                    }
                }
                OptStringLower::None => {
                    match get_vec_type_name(Lowerer_infer_expr_type(self, lw_box_expr_unbox(right))) {
                        OptStringLower::Some(rvn2) => {
                            if binop_eq(op, BinOp::Mul) {
                                return Lowerer_lower_vec_method_call(self, rvn2, "scale", lw_box_expr_unbox(right), lw_box_expr_unbox(left));
                            }
                        }
                        OptStringLower::None => {
                        }
                    }
                }
            }
            // BG181: `==` / `!=` on a generic enum, a tuple, an array or a
            // struct with no __eq_<S> compares the parts (it compared the
            // words: `Option::Some(3) == Option::Some(3)` was false). Its
            // bindings end with it.
            if binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) {
                match Lowerer_eq_rewrite(self, lw_box_expr_unbox(left), lw_box_expr_unbox(right)) {
                    OptExpr::Some(eqx) => {
                        var eqx_e: Expr = eqx;
                        if binop_eq(op, BinOp::Neq) {
                            eqx_e = Expr::Unary(UnaryOp::Not, Box::new(eqx));
                        }
                        Lowerer_rc_scope_open(self);
                        var eqx_v: i64 = Lowerer_lower_expr(self, eqx_e);
                        Lowerer_rc_scope_close(self);
                        return eqx_v;
                    }
                    OptExpr::None => {
                    }
                }
            }
            var left_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(left));
            var right_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(right));
            var result_ty: IrType = Lowerer_infer_binop_type(self, op, lw_box_expr_unbox(left), lw_box_expr_unbox(right));

            // String concatenation: str + str - p_str_concat
            var left_ir_ty: IrType = Lowerer_get_value_type(self, left_val);
            var right_ir_ty: IrType = Lowerer_get_value_type(self, right_val);

            // An integer operand next to a float one is converted to that
            // float type (C's usual arithmetic conversion): `f < 0`, `2 * f`.
            var numeric: bool = binop_eq(op, BinOp::Add) || binop_eq(op, BinOp::Sub) || binop_eq(op, BinOp::Mul) || binop_eq(op, BinOp::Div) || binop_eq(op, BinOp::Mod) || binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq);
            var left_int: bool = ir_type_is_int(left_ir_ty) && !ir_type_eq(left_ir_ty, IrType::Bool);
            var right_int: bool = ir_type_is_int(right_ir_ty) && !ir_type_eq(right_ir_ty, IrType::Bool);
            var result_is_bool: bool = ir_type_eq(result_ty, IrType::Bool);
            if numeric && ir_type_is_float(left_ir_ty) && right_int {
                right_val = Lowerer_emit_inst(self, Inst::IntToFloat(right_val, right_ir_ty, left_ir_ty));
                right_ir_ty = left_ir_ty;
                if !result_is_bool {
                    result_ty = left_ir_ty;
                }
            } else if numeric && left_int && ir_type_is_float(right_ir_ty) {
                left_val = Lowerer_emit_inst(self, Inst::IntToFloat(left_val, left_ir_ty, right_ir_ty));
                left_ir_ty = right_ir_ty;
                if !result_is_bool {
                    result_ty = right_ir_ty;
                }
            } else if numeric && ir_type_is_float(left_ir_ty) && ir_type_is_float(right_ir_ty) && !result_is_bool {
                result_ty = left_ir_ty;
            }
            if binop_eq(op, BinOp::Add) && ir_type_eq(left_ir_ty, lw_ptr_u8()) && ir_type_eq(right_ir_ty, lw_ptr_u8()) {
                // `s + int_to_str(n)`: one string, built at once (core's
                // p_str_concat_int); the number's own string is not used
                var fused: i64 = Lowerer_concat_int(self, left_val, right_val);
                if fused >= 0 {
                    return fused;
                }
                var args: Vec<i64> = Vec::new();
                args.push(left_val);
                args.push(right_val);
                var eff: EffectSet = EffectSet_new();
                EffectSet_add(& mut eff, Effect::Alloc);
                return Lowerer_emit_inst(self, Inst::Call("p_str_concat", args, lw_ptr_u8(), eff));
            }

            // String equality: str == str - p_str_equal. R1.1: either side
            // being str suffices (the typechecker forces both operands to the
            // same type); the other side may carry an erased i64 IR type
            // (Vec<str>.get(), enum payloads, fields), so also consult the
            // AST-level inference. p_str_equal checks identity and null first.
            var is_str_cmp: bool = false;
            if binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) {
                is_str_cmp = ir_type_eq(left_ir_ty, ptr_u8()) || ir_type_eq(right_ir_ty, ptr_u8()) || ir_type_eq(Lowerer_infer_expr_type(self, box_expr_unbox(left)), ptr_u8()) || ir_type_eq(Lowerer_infer_expr_type(self, box_expr_unbox(right)), ptr_u8());
            }
            // `==` / `!=` on Vecs compare element by element (proposal 0001)
            if !is_str_cmp && (binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq)) {
                // (BG181: a field's type too: `p.v == q.v` compared handles)
                var veq: str = vec_eq_fn_for(Lowerer_eq_ast_type(self, box_expr_unbox(left)));
                if veq == "" {
                    veq = vec_eq_fn_for(Lowerer_eq_ast_type(self, box_expr_unbox(right)));
                }
                if veq != "" {
                    var veq_args: Vec<i64> = Vec::new();
                    veq_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
                    veq_args.push(left_val);
                    veq_args.push(right_val);
                    var veq_val: i64 = Lowerer_emit_inst(self, Inst::Call(veq, veq_args, IrType::Bool, EffectSet_new()));
                    if binop_eq(op, BinOp::Neq) {
                        return Lowerer_emit_inst(self, Inst::UnaryOp(UnaryOp::Not, veq_val, IrType::Bool));
                    }
                    return veq_val;
                }
            }
            // R1.2: `==` / `!=` on enum values call the synthesized
            // `__eq_<Enum>` (tag + payload) instead of comparing pointers.
            if !is_str_cmp && (binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq)) {
                var eq_enum: str = enum_name_of_ir_type(self, left_ir_ty);
                if eq_enum == "" {
                    eq_enum = enum_name_of_ir_type(self, right_ir_ty);
                }
                if eq_enum == "" {
                    eq_enum = enum_name_of_ir_type(self, Lowerer_infer_expr_type(self, box_expr_unbox(left)));
                }
                if eq_enum == "" {
                    eq_enum = enum_name_of_ir_type(self, Lowerer_infer_expr_type(self, box_expr_unbox(right)));
                }
                if eq_enum != "" {
                    var eq_fn: str = "__eq_" + eq_enum;
                    var has_eq_fn: bool = lw_fn_at(& self.module, eq_fn) >= 0;
                    if has_eq_fn {
                        var enum_eq_args: Vec<i64> = Vec::new();
                        enum_eq_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
                        enum_eq_args.push(left_val);
                        enum_eq_args.push(right_val);
                        var enum_eq_val: i64 = Lowerer_emit_inst(self, Inst::Call(eq_fn, enum_eq_args, IrType::Bool, EffectSet_new()));
                        if binop_eq(op, BinOp::Neq) {
                            return Lowerer_emit_inst(self, Inst::UnaryOp(UnaryOp::Not, enum_eq_val, IrType::Bool));
                        }
                        return enum_eq_val;
                    }
                }
            }
            if is_str_cmp {
                var dummy_env_eq: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var args: Vec<i64> = Vec::new();
                args.push(dummy_env_eq);
                args.push(left_val);
                args.push(right_val);
                var eq_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_equal", args, IrType::Bool, EffectSet_new()));
                if binop_eq(op, BinOp::Neq) {
                    return Lowerer_emit_inst(self, Inst::UnaryOp(UnaryOp::Not, eq_val, IrType::Bool));
                }
                return eq_val;
            }

            return Lowerer_emit_inst(self, Inst::BinOp(op, left_val, right_val, result_ty));
        }
        Expr::Unary(op, e) => {
            // Integer negation is a checked 0 - x (-i64::MIN overflows).
            match op {
                UnaryOp::Neg => {
                    var inner: Expr = lw_box_expr_unbox(e);
                    match inner {
                        Expr::IntLit(v) => {
                            return Lowerer_emit_inst(self, Inst::ConstInt(lw_neg_lit(v), IrType::I64));
                        }
                        Expr::FloatLit(_) => {
                        }
                        _ => {
                            // CL10: `-d` on a unit: the unit holding its f64 negated
                            var neg_un: str = lw_ir_struct_name(Lowerer_infer_expr_type(self, inner));
                            if str_len(neg_un) > 0 && Lowerer_struct_dim(self, neg_un) != 0 {
                                var neg_inits: Vec<FieldInit> = Vec::new();
                                neg_inits.push(FieldInit_new(Lowerer_dim_field(self, neg_un), Expr::Unary(UnaryOp::Neg, Box::new(Lowerer_dim_operand(self, inner, neg_un)))));
                                return Lowerer_lower_expr(self, Expr::StructLit(neg_un, neg_inits, OptBoxExpr::None));
                            }
                        }
                    }
                    var neg_operand: i64 = Lowerer_lower_expr(self, inner);
                    var neg_ty: IrType = Lowerer_get_value_type(self, neg_operand);
                    if !ir_type_is_float(neg_ty) {
                        neg_ty = Lowerer_infer_unary_type(self, op, inner);
                    }
                    if lw_plain_int(neg_ty) {
                        var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, neg_ty));
                        return Lowerer_emit_inst(self, Inst::BinOp(BinOp::Sub, zero, neg_operand, neg_ty));
                    }
                    return Lowerer_emit_inst(self, Inst::UnaryOp(op, neg_operand, neg_ty));
                }
                _ => {
                }
            }
            var operand: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            var result_ty: IrType = Lowerer_infer_unary_type(self, op, lw_box_expr_unbox(e));
            // BG156: `!` of a value lowered as a bool is a bool
            match op {
                UnaryOp::Not => {
                    if ir_type_eq(Lowerer_get_value_type(self, operand), IrType::Bool) {
                        result_ty = IrType::Bool;
                    }
                }
                _ => {
                }
            }
            var un_val: i64 = Lowerer_emit_inst(self, Inst::UnaryOp(op, operand, result_ty));
            // M12: `~x` on a narrow unsigned type keeps its width (the 64-bit
            // complement of 3u8 is -4; it must be 252)
            match op {
                UnaryOp::BitNot => {
                    var un_mask: i64 = 0;
                    match result_ty {
                        IrType::U8 => {
                            un_mask = 255;
                        }
                        IrType::U16 => {
                            un_mask = 65535;
                        }
                        IrType::U32 => {
                            un_mask = 4294967295;
                        }
                        _ => {
                        }
                    }
                    if un_mask != 0 {
                        var mask_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(un_mask, result_ty));
                        return Lowerer_emit_inst(self, Inst::BinOp(BinOp::BitAnd, un_val, mask_val, result_ty));
                    }
                }
                _ => {
                }
            }
            return un_val;
        }
        Expr::Call(callee, args) => {
            if callee == "__txn_abort" {
                Lowerer_txn_abort(self);
                return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            }
            // CA8: whether the timeout block lowered just before ran past
            // its deadline (`timeout(ms) { } else { }`, Lowerer_lower_timeout)
            if callee == "__timeout_expired" {
                if self.to_hit >= 0 {
                    return self.to_hit;
                }
                return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::Bool));
            }
            // CA6: `spawn detached f(x)` (parser): start the task and let it go
            if callee == "__spawn_detached" && args.len() == 1 {
                return Lowerer_lower_spawn_detached(self, args.get(0));
            }
            // The whole copy a channel send hands over (raw word)
            if callee == "__send_copy" && args.len() == 1 {
                var sv: i64 = Lowerer_lower_expr(self, args.get(0));
                var sk2: i64 = Lowerer_rc_kind(self, Lowerer_rc_value_type(self, args.get(0), sv));
                var stid: i64 = 0;
                if sk2 == RC_STR {
                    stid = 1;
                }
                if sk2 == RC_VEC {
                    stid = 2;
                }
                if sk2 == RC_MAP {
                    stid = 3;
                }
                if stid == 0 {
                    return Lowerer_rc_as_i64(self, sv);
                }
                var sca: Vec<i64> = Vec::new();
                sca.push(Lowerer_rc_env(self));
                sca.push(Lowerer_rc_as_i64(self, sv));
                sca.push(Lowerer_emit_inst(self, Inst::ConstInt(stid, IrType::I64)));
                return Lowerer_emit_inst(self, Inst::Call("p_send_copy", sca, IrType::I64, lw_rc_eff()));
            }
            // A spawn wrapper frees the copy its thread was given
            if callee == "__thread_drop" && args.len() == 1 {
                match args.get(0) {
                    Expr::Ident(dn) => {
                        var dv: i64 = Lowerer_lower_expr(self, args.get(0));
                        Lowerer_rc_drop(self, dv, Lowerer_rc_var_type(self, dn));
                    }
                    _ => {
                    }
                }
                return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            }
            return Lowerer_lower_call_expr(self, callee, args);
        }
        Expr::MethodCall(receiver, method, args) => {
            return Lowerer_lower_method_call(self, receiver, method, args);
        }
        Expr::FieldAccess(obj, field) => {
            return Lowerer_lower_field_access_expr(self, obj, field);
        }
        Expr::Index(arr, idx) => {
            var arr_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(arr));
            // through a `&Vec` / `&mut Vec`: the Vec it refers to
            arr_val = Lowerer_auto_deref_recv(self, arr_val, Lowerer_get_value_type(self, arr_val));
            var idx_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(idx));
            var arr_ty: IrType = Lowerer_get_value_type(self, arr_val);

            // Vec indexing: Vec_get(vec, idx)
            if ir_type_is_opaque_named(arr_ty, "Vec") || ir_type_eq(arr_ty, IrType::I64) {
                // Determine element type for correct return type (word_repr for structs)
                var vec_elem_ty: IrType = IrType::I64;
                match arr_ty {
                    IrType::Generic(gname, gargs) => {
                        if gname == "Vec" && gargs.len() > 0 {
                            vec_elem_ty = gargs.get(0);
                        }
                    }
                    IrType::Opaque(_) => {
                        // Try AST type for generic info
                        match lw_box_expr_unbox(arr) {
                            Expr::Ident(vname) => {
                                match Lowerer_lookup_var_ast_type(self, vname) {
                                    OptType::Some(at) => {
                                        var inner_ty: Type = at;
                                        match at {
                                            Type::Ref(inner, _) => {
                                                inner_ty = lw_box_type_unbox(inner);
                                            }
                                            _ => {
                                            }
                                        }
                                        match inner_ty {
                                            Type::Generic(an, aargs) => {
                                                if an == "Vec" && aargs.len() > 0 {
                                                    vec_elem_ty = Lowerer_lower_type(self, aargs.get(0));
                                                }
                                            }
                                            _ => {
                                            }
                                        }
                                    }
                                    OptType::None => {
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                var args: Vec<i64> = Vec::new();
                args.push(arr_val);
                args.push(idx_val);
                var ret_ty: IrType = word_repr(vec_elem_ty);
                return Lowerer_emit_inst(self, Inst::Call("p_vec_get", args, ret_ty, EffectSet_new()));
            }

            // Array indexing: GetElemPtr + Load
            var elem_ty: IrType = IrType::I64;
            match arr_ty {
                IrType::Array(inner, _) => {
                    elem_ty = box_ir_type_unbox(inner);
                }
                IrType::Ptr(inner2) => {
                    match box_ir_type_unbox(inner2) {
                        IrType::Array(inner3, _) => {
                            elem_ty = box_ir_type_unbox(inner3);
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            // M6: the index is checked against the array's length
            Lowerer_emit_array_bound_check(self, arr_ty, idx_val);
            var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(arr_val, idx_val, elem_ty));
            return Lowerer_emit_inst(self, Inst::Load(elem_ptr, elem_ty));
        }
        Expr::StructLit(name, fields, spread) => {
            return Lowerer_lower_struct_lit_expr(self, name, fields, spread);
        }
        Expr::If(cond, then_block, else_block) => {
            return Lowerer_lower_if_expr(self, cond, then_block, else_block);
        }
        Expr::Block(stmts) => {
            // CF19 (§5.1): a block is a scope. Its declarations end with it,
            // so one that shadows an outer name leaves the outer variable
            // as it was (`val x = 1; { val x = 2; } println(x)` prints 1;
            // the outer `x` read the inner slot), as the branches of an
            // `if` are scoped
            var blk_allocas_len: i64 = self.allocas.len();
            var blk_alloca_types_len: i64 = self.alloca_types.len();
            var blk_var_ast_types_len: i64 = self.var_ast_types.len();
            var blk_locals_len: i64 = self.current_func.locals.len();
            var result: i64 = 0;
            var i: i64 = 0;
            while i < stmts.len() {
                match stmts.get(i) {
                    Stmt::Expr(e, _) => {
                        result = Lowerer_lower_expr(self, e);
                    }
                    s => {
                        Lowerer_lower_stmt(self, s);
                    }
                }
                i = i + 1;
            }
            self.allocas.truncate(blk_allocas_len);
            self.alloca_types.truncate(blk_alloca_types_len);
            self.var_ast_types.truncate(blk_var_ast_types_len);
            self.current_func.locals.truncate(blk_locals_len);
            if result == 0 {
                result = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            }
            return result;
        }
        Expr::Cast(e, ty) => {
            // Casting to a trait object (dyn Trait) creates a Dyn value
            match ty {
                Type::Dyn(trait_name) => {
                    var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
                    // BG183: a generic instance's dyn values name its
                    // forwarders (`Slot__i64`): its methods are mono's
                    // `Slot__show__i64`, and `Slot_show` is no function
                    var gdyn: str = Lowerer_dyn_generic_name(self, lw_rc_strip_ref(Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, lw_box_expr_unbox(e)))), trait_name);
                    // (typed as its trait, as a `dyn` variable is: a method
                    // called on the cast itself, `(q as dyn T).m()`, is a
                    // dynamic call, not a call of `dyn_m`; BG184's note)
                    if str_len(gdyn) > 0 {
                        var gdv: i64 = Lowerer_emit_inst(self, Inst::MakeDyn(val, gdyn, trait_name));
                        Lowerer_set_value_type(self, gdv, IrType::Opaque("dyn:" + trait_name));
                        return gdv;
                    }
                    var src_ir_ty: IrType = Lowerer_get_value_type(self, val);
                    var type_name: str = "Unknown";
                    match src_ir_ty {
                        IrType::Struct(n) => {
                            type_name = n;
                        }
                        IrType::Ptr(inner) => {
                            match box_ir_type_unbox(inner) {
                                IrType::Struct(n) => {
                                    type_name = n;
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    // BG144: a qualified impl's methods are
                    // `Type__Trait_method`, so its dyn values say `Type__Trait`
                    var dv: i64 = Lowerer_emit_inst(self, Inst::MakeDyn(val, lw_tq_prefix(type_name, trait_name), trait_name));
                    Lowerer_set_value_type(self, dv, IrType::Opaque("dyn:" + trait_name));
                    return dv;
                }
                // An address cast to a function type is a C function, called
                // through (stdlib-agent-bugs 45, 50): an env whose word 0 is
                // the marker name `__fid_c_fnptr` and word 1 the address.
                // codegen_c's CallPtr calls it with the call's C types; the
                // interpreter cannot. A function value stays what it is.
                Type::Func(_, _) => {
                    var fval: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
                    var fcty: IrType = Lowerer_get_value_type(self, fval);
                    if ir_type_is_opaque_named(fcty, "closure") || ir_type_is_opaque_named(fcty, "func") {
                        return fval;
                    }
                    var fma: Vec<i64> = Vec::new();
                    fma.push(Lowerer_emit_inst(self, Inst::ConstInt(16, IrType::I64)));
                    var feff: EffectSet = EffectSet_new();
                    EffectSet_add(& mut feff, Effect::Alloc);
                    var fenv: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", fma, lw_ptr_u8(), feff));
                    var fmark: i64 = Lowerer_emit_inst(self, Inst::ConstFnRef("__fid_c_fnptr"));
                    var fi0: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                    var fw0: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(fenv, fi0, IrType::I64));
                    Lowerer_emit_inst(self, Inst::Store(fw0, fmark, OptIrType::None));
                    var fi1: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
                    var fw1: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(fenv, fi1, IrType::I64));
                    Lowerer_emit_inst(self, Inst::Store(fw1, Lowerer_rc_as_i64(self, fval), OptIrType::None));
                    Lowerer_set_value_type(self, fenv, IrType::Opaque("closure"));
                    return fenv;
                }
                _ => {
                }
            }
            var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            // A new string, Vec or map made a raw word (`f() as i64`): the
            // word now holds it, so the statement does not drop it (code
            // that does this frees it by hand, proposal 0004)
            if self.own_on && Lowerer_rc_kind(self, ty) == RC_NONE {
                Lowerer_rc_claim(self, val);
            }
            var src_ty: IrType = Lowerer_get_value_type(self, val);
            var dst_ty: IrType = Lowerer_lower_type(self, ty);
            return Lowerer_lower_cast(self, val, src_ty, dst_ty);
        }
        Expr::TupleLit(elements) => {
            // As src/lower.rs: a tuple struct on the stack; struct
            // elements are stored inline (no dangling pointers when the
            // tuple is returned).
            // Ownership (proposal 0004): a tuple owns its elements, as a
            // struct its fields: each element is kept (a temporary handed
            // over, anything else counted again) as the type its value has
            // (Lowerer_rc_value_type), and
            // the tuple is a temporary of the statement. Before, a string or
            // a struct put in a tuple was a temporary dropped at the
            // statement's end while the tuple still held it.
            var n: i64 = elements.len();
            var elem_vals: Vec<i64> = Vec::new();
            var elem_tys: Vec<IrType> = Vec::new();
            var elem_asts: Vec<Type> = Vec::new();
            // BG269: the element types the let (or the function's result,
            // for a returned literal) gives the tuple; the hint is the
            // tuple's, not its elements', while they are lowered
            var tl_hint: Vec<Type> = Vec::new();
            var tl_saved_hint: OptType = self.let_hint;
            match self.let_hint {
                OptType::Some(tlh) => {
                    match Lowerer_resolve_type(self, tlh) {
                        Type::Tuple(tlts) => {
                            if tlts.len() == n {
                                tl_hint = tlts;
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptType::None => {
                }
            }
            self.let_hint = OptType::None;
            var i: i64 = 0;
            while i < n {
                var el: Expr = elements.get(i);
                // (a variable is counted again, not moved on its last use:
                // a tuple some place keeps without an owner, an array
                // literal's element, is dropped with its statement, and the
                // variable's value must outlive it as before)
                var ev: i64 = Lowerer_lower_expr(self, el);
                // BG269: an f64 literal where the tuple's type says f32 is
                // stored as an f32 (its f64 bits were read back as 0)
                if i < tl_hint.len() {
                    ev = Lowerer_float_as(self, ev, Lowerer_lower_type(self, tl_hint.get(i)));
                }
                var east: Type = Type::Infer;
                if self.own_on {
                    east = Lowerer_rc_value_type(self, el, ev);
                    if Lowerer_rc_kind(self, east) != RC_NONE {
                        ev = Lowerer_rc_own_value(self, ev, east);
                    }
                }
                // the element's type in the tuple's type: what it is owned
                // as (a struct its value's IR type names is kept: the
                // tuple's layout must place it as this literal does), else
                // the inferred one when that owns nothing either (a tuple
                // must not drop what it was not given an owner of)
                if Lowerer_rc_kind(self, east) == RC_NONE {
                    var vague: bool = false;
                    match east {
                        Type::Infer => {
                            vague = true;
                        }
                        Type::Named(vn) => {
                            vague = str_starts_with(vn, "__tuple_");
                        }
                        _ => {
                        }
                    }
                    if vague {
                        var inferred: Type = Lowerer_enum_arg_ast_type(self, el);
                        if Lowerer_rc_kind(self, inferred) == RC_NONE {
                            east = inferred;
                        }
                    }
                }
                // a nested tuple held as a word (a parameter's, a Vec's
                // element) is its address: kept inline, as the tuple's type
                // lays it out (Lowerer_key_elem_ir)
                ev = Lowerer_rc_tuple_ptr(self, ev, east);
                // BG369: a fixed-array element is one word, the address of
                // a heap copy of its own (the local array's address was
                // kept: `return (a, 5)` handed the caller a dead frame)
                if lw_ir_is_array_ptr(Lowerer_get_value_type(self, ev)) {
                    ev = Lowerer_arr_heap_copy(self, ev, lw_ir_ptr_inner(Lowerer_get_value_type(self, ev)));
                }
                elem_asts.push(east);
                elem_vals.push(ev);
                var evt: IrType = Lowerer_get_value_type(self, ev);
                // a generic struct instance held as a word (a parameter's
                // value) is the address of the struct: kept inline, as the
                // tuple's type lays it out (Lowerer_key_elem_ir)
                match evt {
                    IrType::Generic(_, _) => {
                        match Lowerer_generic_struct_ir(self, evt) {
                            IrType::Struct(egs) => {
                                evt = IrType::Ptr(Box::new(IrType::Struct(egs)));
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                elem_tys.push(evt);
                i = i + 1;
            }
            self.let_hint = tl_saved_hint;
            // the layout of its shape (lw_tuple_layout_name)
            var tuple_name: str = Lowerer_register_tuple_layout(self, elem_tys);
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct(tuple_name), Lowerer_current_region(self)));
            i = 0;
            while i < n {
                var vty: IrType = elem_tys.get(i);
                var fty: IrType = lw_tuple_field_ty(vty);
                var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, i, fty));
                var inline_struct: bool = false;
                match fty {
                    IrType::Struct(_) => {
                        match vty {
                            IrType::Ptr(_) => {
                                inline_struct = true;
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                if inline_struct {
                    var _c: i64 = Lowerer_emit_inst(self, Inst::StructCopy(elem_ptr, elem_vals.get(i), fty));
                } else {
                    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(elem_ptr, elem_vals.get(i), OptIrType::None));
                }
                i = i + 1;
            }
            // A new tuple: a temporary the statement owns, of the tuple of
            // its elements' types, when that type's layout (what its drop
            // and copies read) places the elements where this one does
            if self.own_on && n > 0 {
                var tty: Type = Type::Tuple(elem_asts);
                if Lowerer_rc_kind(self, tty) == RC_MEM && Lowerer_tuple_layouts_agree(self, tuple_name, Lowerer_tuple_name_ro(self, elem_asts)) {
                    Lowerer_rc_temp(self, alloca, tty);
                }
            }
            return alloca;
        }
        Expr::Range(start, end, inclusive) => {
            // Range expression - used in for loops, handled there
            var start_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(start));
            return start_val;
        }
        Expr::Ref(e, is_mut) => {
            // `&s` of a string: the borrowed string is its pointer (M11)
            if !is_mut && lw_is_str_type(Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(e))) {
                return Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            }
            // Take a reference - for alloca variables, return the alloca pointer.
            // For SRET struct allocas, load the stored struct pointer (avoid
            // double indirection). For all other expressions, create an alloca,
            // store the value, and return the pointer.
            match lw_box_expr_unbox(e) {
                Expr::Ident(name) => {
                    match Lowerer_lookup_alloca(self, name) {
                        OptValueId::Some(alloca) => {
                            // If the variable holds a pointer to a struct (SRET return),
                            // the alloca stores the struct pointer. &var should return
                            // the struct pointer (loaded from alloca), not the alloca
                            // address - otherwise we get an extra level of indirection.
                            match Lowerer_lookup_alloca_type(self, alloca) {
                                OptIrType::Some(alloca_ty) => {
                                    match alloca_ty {
                                        IrType::Ptr(inner) => {
                                            match box_ir_type_unbox(inner) {
                                                IrType::Struct(_) => {
                                                    return Lowerer_emit_inst(self, Inst::Load(alloca, alloca_ty));
                                                }
                                                _ => {
                                                }
                                            }
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                OptIrType::None => {
                                }
                            }
                            return alloca;
                        }
                        OptValueId::None => {
                        }
                    }
                }
                Expr::FieldAccess(obj, field) => {
                    // &obj.field — the field's real address, not a copy.
                    match Lowerer_try_field_addr(self, obj, field) {
                        OptValueId::Some(fp) => {
                            return fp;
                        }
                        OptValueId::None => {
                        }
                    }
                }
                Expr::Deref(inner) => {
                    // &*p — the pointer itself.
                    return Lowerer_lower_expr(self, lw_box_expr_unbox(inner));
                }
                Expr::Cast(ce, cty) => {
                    // CI3: `&mut st as *u8` (parsed `&mut (st as *u8)`) of a
                    // struct is the struct's address, the user data a C
                    // callback gets back: not the address of a temporary
                    // holding that address (`st as *u8` is already &st)
                    var raw: bool = false;
                    match cty {
                        Type::RawPtr(_, _) => {
                            raw = true;
                        }
                        _ => {
                        }
                    }
                    if raw && lw_ir_struct_or_ptr(Lowerer_infer_expr_type(self, lw_box_expr_unbox(ce))) {
                        return Lowerer_lower_expr(self, Expr::Cast(ce, cty));
                    }
                }
                Expr::Index(rarr, ridx) => {
                    // &v[i] / &mut v[i]: the element's address, not a copy (D15)
                    if LOWER_REF_INDEX {
                        return Lowerer_ref_index_addr(self, rarr, ridx, is_mut);
                    }
                }
                _ => {
                }
            }
            // Otherwise: lower the expression, alloca, store, return pointer.
            var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            var val_ty: IrType = Lowerer_get_value_type(self, val);
            // If the expression already evaluates to a pointer to a struct
            // (e.g. from a FieldAccess on a &mut parameter), the value IS
            // the pointer to the struct storage. &mut of this should return
            // it directly - wrapping it in another alloca creates a double
            // indirection (**struct instead of *struct) that breaks field
            // access through the mutable reference.
            match val_ty {
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(_) => {
                            return val;
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            var ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(val_ty, Lowerer_current_region(self)));
            Lowerer_emit_inst(self, Inst::Store(ptr, val, OptIrType::None));
            return ptr;
        }
        Expr::Deref(e) => {
            var ptr_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            var ptr_ty: IrType = Lowerer_get_value_type(self, ptr_val);
            // Load through the pointer
            var load_ty: IrType = IrType::I64;
            match ptr_ty {
                IrType::Ptr(inner) => {
                    load_ty = box_ir_type_unbox(inner);
                }
                _ => {
                }
            }
            // A struct is accessed through its pointer: `*p` is p itself
            // (src/lower.rs).
            match load_ty {
                IrType::Struct(_) => {
                    return ptr_val;
                }
                _ => {
                }
            }
            // A Box of a struct or enum whose IR type says nothing of it (a
            // binding of an enum payload is a plain pointer): its AST type
            // does, and the Box is the struct's address
            match Lowerer_resolve_type(self, Lowerer_rc_expr_type(self, lw_box_expr_unbox(e))) {
                Type::Generic(bn, bargs) => {
                    if bn == "Box" && bargs.len() == 1 && Lowerer_rc_is_mem_type(self, Lowerer_resolve_type(self, bargs.get(0))) {
                        var sty: IrType = Lowerer_rc_mem_ir(self, bargs.get(0));
                        return Lowerer_emit_inst(self, Inst::BitCast(ptr_val, ptr_ty, IrType::Ptr(Box::new(sty))));
                    }
                }
                _ => {
                }
            }
            return Lowerer_emit_inst(self, Inst::Load(ptr_val, load_ty));
        }
        Expr::StrConcat(left, right) => {
            var left_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(left));
            var right_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(right));
            var args: Vec<i64> = Vec::new();
            args.push(left_val);
            args.push(right_val);
            var eff: EffectSet = EffectSet_new();
            EffectSet_add(& mut eff, Effect::Alloc);
            return Lowerer_emit_inst(self, Inst::Call("p_str_concat", args, lw_ptr_u8(), eff));
        }
        Expr::EnumLit(enum_name, variant, args) => {
            // Allocate enum struct on stack
            var enum_ty: IrType = IrType::Struct(enum_name);
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(enum_ty, Lowerer_current_region(self)));

            // Store tag at offset 0
            var tag_idx: i64 = 0;
            // Also collect declared field types to determine inline storage
            var declared_field_tys: Vec<Type> = Vec::new();
            // Collect enum type params so we can detect type-param payloads
            var enum_type_params: Vec<str> = Vec::new();
            match Lowerer_lookup_enum(self, enum_name) {
                OptEnumDef::Some(def) => {
                    enum_type_params = def.type_params;
                    var vi: i64 = 0;
                    while vi < def.variants.len() {
                        if def.variants.get(vi).name == variant {
                            tag_idx = vi;
                            match def.variants.get(vi).data {
                                OptParams::Some(params) => {
                                    var pi: i64 = 0;
                                    while pi < params.len() {
                                        declared_field_tys.push(params.get(pi).ty);
                                        pi = pi + 1;
                                    }
                                }
                                OptParams::None => {
                                }
                            }
                        }
                        vi = vi + 1;
                    }
                }
                OptEnumDef::None => {
                }
            }

            var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, 0, IrType::I64));
            var tag_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(tag_idx, IrType::I64));
            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(tag_ptr, tag_val, OptIrType::None));

            // Store payload data at offsets 1..n
            // CRITICAL: struct/enum-typed fields must be stored INLINE (copied
            // from the arg's alloca) to avoid dangling pointers when the
            // creating function returns (C codegen uses stack alloca).
            // Box<T> fields are already pointers and stay as pointers.
            // We look at the DECLARED field type to distinguish.
            // NOTE: Type parameters (e.g. T in Option<T>) are NOT inline
            // structs — they are word-sized values (i64/ptr) at runtime.
            var field_idx: i64 = 1;
            // BG203: the type each payload was owned as, for the literal's
            // temporary type below
            var owned_tys: Vec<Type> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                var arg_val: i64 = Lowerer_lower_keep(self, args.get(ai));
                // Ownership (proposal 0004): the enum keeps an owner of its
                // payload
                if self.own_on {
                    var pty: Type = Type::Infer;
                    if ai < declared_field_tys.len() {
                        pty = declared_field_tys.get(ai);
                    }
                    if lw_rc_is_param(pty, enum_type_params) || Lowerer_rc_kind(self, pty) == RC_NONE {
                        pty = Lowerer_rc_value_type(self, args.get(ai), arg_val);
                    }
                    arg_val = Lowerer_rc_own_value(self, arg_val, pty);
                    owned_tys.push(pty);
                }
                var arg_ty: IrType = Lowerer_get_value_type(self, arg_val);

                // Check the declared field type to determine if this field
                // should be stored inline (struct/enum) or as a pointer.
                var is_inline_struct: bool = false;
                var declared_ir_ty: IrType = IrType::I64;
                if ai < declared_field_tys.len() {
                    var declared_ast_ty: Type = declared_field_tys.get(ai);
                    // Check if the declared type is a type parameter of this enum.
                    // Type params are word-sized at runtime, not inline structs.
                    var is_type_param: bool = false;
                    match declared_ast_ty {
                        Type::Named(n) => {
                            var tpi: i64 = 0;
                            while tpi < enum_type_params.len() {
                                if enum_type_params.get(tpi) == n {
                                    is_type_param = true;
                                    tpi = enum_type_params.len();
                                }
                                tpi = tpi + 1;
                            }
                        }
                        _ => {
                        }
                    }
                    if is_type_param {
                        // Type parameter: one word. A struct or enum value is
                        // copied to the heap and the word points at the copy
                        // (an Option<Pt> made in a function outlives its
                        // frame); a match copies it back out (proposal 0002).
                        var box_sn: str = "";
                        match arg_ty {
                            IrType::Struct(bn) => {
                                box_sn = bn;
                            }
                            IrType::Ptr(bin) => {
                                match box_ir_type_unbox(bin) {
                                    IrType::Struct(bn2) => {
                                        box_sn = bn2;
                                    }
                                    _ => {
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                        if box_sn != "" {
                            var box_size: i64 = IrModule_type_size(& self.module, IrType::Struct(box_sn));
                            if box_size < 8 {
                                box_size = 8;
                            }
                            var box_size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(box_size, IrType::I64));
                            var box_ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(box_size_val), IrType::Ptr(Box::new(IrType::Struct(box_sn))), EffectSet_new()));
                            Lowerer_emit_inst(self, Inst::Store(box_ptr, arg_val, OptIrType::Some(IrType::Struct(box_sn))));
                            arg_val = box_ptr;
                            arg_ty = IrType::Ptr(Box::new(IrType::Struct(box_sn)));
                        } else if lw_ir_is_array_ptr(arg_ty) {
                            // BG384: a fixed array as a type parameter's
                            // payload (`Option::Some(a)`), a heap copy too
                            arg_val = Lowerer_arr_heap_copy(self, arg_val, lw_ir_ptr_inner(arg_ty));
                            arg_ty = Lowerer_get_value_type(self, arg_val);
                        } else {
                            // BG267: `val o: Option<f32> = Option::Some(1.5)`:
                            // the literal as the type the let gives T (a
                            // match reads the payload as an f32)
                            arg_val = Lowerer_float_as(self, arg_val, Lowerer_enum_param_hint_ir(self, enum_name, enum_type_params, declared_ast_ty));
                            arg_ty = Lowerer_get_value_type(self, arg_val);
                        }
                        declared_ir_ty = word_repr(arg_ty);
                    } else {
                        // a tuple and a generic struct instance inline too,
                        // as the enum's layout holds them (Lowerer_held_ir)
                        declared_ir_ty = Lowerer_held_ir(self, declared_ast_ty, enum_type_params);
                        match declared_ir_ty {
                            IrType::Struct(_) => {
                                is_inline_struct = true;
                                // the value's address (a word holding it:
                                // a parameter's tuple or generic instance)
                                var held_word: bool = true;
                                match Lowerer_lower_type(self, declared_ast_ty) {
                                    IrType::Struct(_) => {
                                        held_word = false;
                                    }
                                    _ => {
                                    }
                                }
                                match arg_ty {
                                    IrType::Ptr(_) => {
                                        held_word = false;
                                    }
                                    IrType::Struct(_) => {
                                        held_word = false;
                                    }
                                    _ => {
                                    }
                                }
                                if held_word {
                                    arg_val = Lowerer_emit_inst(self, Inst::BitCast(arg_val, arg_ty, IrType::Ptr(Box::new(declared_ir_ty))));
                                    arg_ty = IrType::Ptr(Box::new(declared_ir_ty));
                                }
                            }
