    Lowerer_add_extern_1(self, "p_volatile_load32", IrType::I64, IrType::I64);
    Lowerer_add_extern_2(self, "p_volatile_store32", IrType::I64, IrType::I64, IrType::Void);

    // Environment/args/process
    Lowerer_add_extern_1(self, "p_getenv", lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_0(self, "p_argc", IrType::I64);
