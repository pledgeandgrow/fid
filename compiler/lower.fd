// --- Lower program --------------------------------------------------------

pub fn Lowerer_lower_program(self: &mut Lowerer, program: Program) -> IrModule {
    // Register constants
    var i: i64 = 0;
    while i < program.consts.len() {
        var c: ConstDef = program.consts.get(i);
        Lowerer_insert_constant(self, c.name, c.expr);
        i = i + 1;
    }

    // Register module-level mutable globals
    i = 0;
    while i < program.globals.len() {
        var g: GlobalVar = program.globals.get(i);
        var ir_ty: IrType = Lowerer_lower_type(self, g.ty);
        self.module.globals.push(GlobalEntry_new(g.name, ir_ty, g.init));
        i = i + 1;
    }

    // Register type aliases
    i = 0;
    while i < program.type_aliases.len() {
        var ta: TypeAlias = program.type_aliases.get(i);
        Lowerer_insert_type_alias(self, ta.name, ta.alias_for);
        i = i + 1;
    }

    // Register struct definitions
    i = 0;
    while i < program.structs.len() {
        var s: StructDef = program.structs.get(i);
        Lowerer_insert_struct(self, s.name, s);
        // Track @linear structs
        var j: i64 = 0;
        while j < s.annotations.len() {
            if s.annotations.get(j).name == "linear" {
                Lowerer_insert_linear_struct(self, s.name);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Register enum definitions
    i = 0;
    while i < program.enums.len() {
        var e: EnumDef = program.enums.get(i);
        Lowerer_insert_enum(self, e.name, e);
        i = i + 1;
    }

    // Register user-defined extern functions
    i = 0;
    while i < program.extern_decls.len() {
        var ext: ExternDecl = program.extern_decls.get(i);
        var param_types: Vec<IrType> = Vec::new();
        var j: i64 = 0;
        while j < ext.params.len() {
            param_types.push(Lowerer_lower_type(self, ext.params.get(j).ty));
            j = j + 1;
        }
        var ret_type: IrType = Lowerer_lower_type(self, ext.ret_ty);
        IrModule_add_extern(&mut self.module, ext.pledge_name, param_types, ret_type);
        self.module.extern_decls.push(ext);
        i = i + 1;
    }

    // Register impl methods
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var j: i64 = 0;
        while j < imp.methods.len() {
            var method: Func = imp.methods.get(j);
            Lowerer_insert_impl_method(self, imp.struct_name, method.name, method);
            Lowerer_insert_func_ret_type(self, method.name, method.ret_ty);
            // Pre-register mangled name in IR module so calls can look up return type
            var mangled_name: str = imp.struct_name + "_" + method.name;
            var mangled_ret_ty: IrType = Lowerer_lower_type(self, method.ret_ty);
            var ir_func: IrFunction = IrFunction_new(mangled_name, mangled_ret_ty);
            IrModule_add_function(&mut self.module, ir_func);
            j = j + 1;
        }
        i = i + 1;
    }

    // Register trait impl methods
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var j: i64 = 0;
        while j < ti.methods.len() {
            var method: Func = ti.methods.get(j);
            Lowerer_insert_impl_method(self, ti.type_name, method.name, method);
            Lowerer_insert_func_ret_type(self, method.name, method.ret_ty);
            // Pre-register mangled name in IR module so calls can look up return type
            var ti_mangled_name: str = ti.type_name + "_" + method.name;
            var ti_mangled_ret_ty: IrType = Lowerer_lower_type(self, method.ret_ty);
            var ti_ir_func: IrFunction = IrFunction_new(ti_mangled_name, ti_mangled_ret_ty);
            IrModule_add_function(&mut self.module, ti_ir_func);
            j = j + 1;
        }
        i = i + 1;
    }

    // Register trait method names
    i = 0;
    while i < program.traits.len() {
        var td: TraitDef = program.traits.get(i);
        var methods: Vec<str> = Vec::new();
        var j: i64 = 0;
        while j < td.methods.len() {
            methods.push(td.methods.get(j).name);
            j = j + 1;
        }
        self.module.trait_methods.push(StringVecStr_new(td.name, methods));
        i = i + 1;
    }

    // Register trait implementations
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        // Find or create entry for trait_name
        var found: bool = false;
        var j: i64 = 0;
        while j < self.module.trait_impls.len() {
            if self.module.trait_impls.get(j).name == ti.trait_name {
                self.module.trait_impls.get(j).items.push(ti.type_name);
                found = true;
            }
            j = j + 1;
        }
        if !found {
            var types: Vec<str> = Vec::new();
            types.push(ti.type_name);
            self.module.trait_impls.push(StringVecStr_new(ti.trait_name, types));
        }
        i = i + 1;
    }

    // Compute enum and struct layouts iteratively to a fixpoint.
    // Enums may contain structs, and structs may contain enums.
    // We interleave both passes until no size changes.
    var changed: bool = true;
    var iterations: i64 = 0;
    while changed && iterations < 20 {
        changed = false;
        i = 0;
        while i < program.enums.len() {
            var e: EnumDef = program.enums.get(i);
            var old_size: i64 = 0;
            match IrModule_get_struct(&self.module, e.name) {
                OptStructLayout::Some(old_layout) => { old_size = old_layout.size; }
                OptStructLayout::None => { old_size = 0; }
            }
            Lowerer_compute_enum_layout(self, e);
            var new_size: i64 = 0;
            match IrModule_get_struct(&self.module, e.name) {
                OptStructLayout::Some(new_layout) => { new_size = new_layout.size; }
                OptStructLayout::None => { new_size = 0; }
            }
            if new_size != old_size { changed = true; }
            i = i + 1;
        }
        i = 0;
        while i < program.structs.len() {
            var s: StructDef = program.structs.get(i);
            var old_size: i64 = 0;
            match IrModule_get_struct(&self.module, s.name) {
                OptStructLayout::Some(old_layout) => { old_size = old_layout.size; }
                OptStructLayout::None => { old_size = 0; }
            }
            Lowerer_compute_struct_layout(self, s);
            var new_size: i64 = 0;
            match IrModule_get_struct(&self.module, s.name) {
                OptStructLayout::Some(new_layout) => { new_size = new_layout.size; }
                OptStructLayout::None => { new_size = 0; }
            }
            if new_size != old_size { changed = true; }
            i = i + 1;
        }
        iterations = iterations + 1;
    }

    // Register runtime
    Lowerer_register_runtime(self);

    // Pre-register all function signatures
    i = 0;
    while i < program.funcs.len() {
        var func: Func = program.funcs.get(i);
        var ret_ty: IrType = Lowerer_lower_type_sret(self, func.ret_ty);
        var ir_func: IrFunction = IrFunction_new(func.name, ret_ty);
        IrModule_add_function(&mut self.module, ir_func);
        Lowerer_insert_func_ret_type(self, func.name, func.ret_ty);
        if func.is_async {
            Lowerer_insert_async_func(self, func.name);
        }
        // Store parameter names for named argument resolution
        var param_names: Vec<str> = Vec::new();
        var defaults: Vec<Expr> = Vec::new();
        var pi: i64 = 0;
        while pi < func.params.len() {
            param_names.push(func.params.get(pi).name);
            if func.params.get(pi).has_default {
                defaults.push(func.params.get(pi).default_expr);
            } else {
                defaults.push(Expr::IntLit(0));
            }
            pi = pi + 1;
        }
        self.func_param_names.push(StringVecStrEntry_new(func.name, param_names));
        self.func_defaults.push(StringVecExprEntry_new(func.name, defaults));
        i = i + 1;
    }

    // Lower each function
    i = 0;
    while i < program.funcs.len() {
        Lowerer_lower_func(self, program.funcs.get(i));
        i = i + 1;
    }

    // Lower impl methods (mangled as {StructName}_{method})
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var saved_self: OptStringLower = self.current_self_type;
        self.current_self_type = OptStringLower::Some(imp.struct_name);
        var j: i64 = 0;
        while j < imp.methods.len() {
            var method: Func = imp.methods.get(j);
            var mangled: Func = method;
            mangled.name = imp.struct_name + "_" + method.name;
            // Resolve Self in param types and return type
            var new_params: Vec<Param> = Vec::new();
            var k: i64 = 0;
            while k < mangled.params.len() {
                var p: Param = mangled.params.get(k);
                p.ty = Lowerer_resolve_self_in_type(self, p.ty);
                new_params.push(p);
                k = k + 1;
            }
            mangled.params = new_params;
            mangled.ret_ty = Lowerer_resolve_self_in_type(self, mangled.ret_ty);
            Lowerer_lower_func(self, mangled);
            j = j + 1;
        }
        self.current_self_type = saved_self;
        i = i + 1;
    }

    // Lower trait impl methods
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var saved_self: OptStringLower = self.current_self_type;
        self.current_self_type = OptStringLower::Some(ti.type_name);
        var j: i64 = 0;
        while j < ti.methods.len() {
            var method: Func = ti.methods.get(j);
            var mangled: Func = method;
            mangled.name = ti.type_name + "_" + method.name;
            var new_params: Vec<Param> = Vec::new();
            var k: i64 = 0;
            while k < mangled.params.len() {
                var p: Param = mangled.params.get(k);
                p.ty = Lowerer_resolve_self_in_type(self, p.ty);
                new_params.push(p);
                k = k + 1;
            }
            mangled.params = new_params;
            mangled.ret_ty = Lowerer_resolve_self_in_type(self, mangled.ret_ty);
            Lowerer_lower_func(self, mangled);
            j = j + 1;
        }
        self.current_self_type = saved_self;
        i = i + 1;
    }

    // Propagate linear_structs to IR module
    self.module.linear_structs = self.linear_structs;

    return self.module;
}

// --- Public entry point ---------------------------------------------------

pub fn lower(program: Program) -> IrModule {
    var l: Lowerer = Lowerer_new();
    return Lowerer_lower_program(&mut l, program);
}

// --- Lower function (stub - implemented in Part 3) ------------------------

// --- Annotation helpers ---------------------------------------------------

pub fn has_annotation(annotations: Vec<Annotation>, name: str) -> bool {
    var i: i64 = 0;
    while i < annotations.len() {
        if annotations.get(i).name == name { return true; }
        i = i + 1;
    }
    return false;
}

pub fn find_annotation(annotations: Vec<Annotation>, name: str) -> OptAnnotation {
    var i: i64 = 0;
    while i < annotations.len() {
        if annotations.get(i).name == name { return OptAnnotation::Some(annotations.get(i)); }
        i = i + 1;
    }
    return OptAnnotation::None;
}

pub enum OptAnnotation {
    Some(Annotation),
    None,
}

// --- Lower function -------------------------------------------------------

pub fn Lowerer_lower_func(self: &mut Lowerer, func: Func) {
    var ret_ty: IrType = Lowerer_lower_type_sret(self, func.ret_ty);
    var ir_func: IrFunction = IrFunction_new(func.name, ret_ty);
    ir_func.is_interrupt = func.is_interrupt;
    // F29: @interrupt(N) annotation — store the IDT vector number
    ir_func.interrupt_vector = -1;
    var ai: i64 = 0;
    while ai < func.annotations.len() {
        var ann: Annotation = func.annotations.get(ai);
        if ann.name == "interrupt" {
            if ann.args.len() > 0 {
                var vec_str: str = ann.args.get(0);
                var result: i64 = 0;
                var si: i64 = 0;
                // Check for 0x prefix (hex)
                if str_len(vec_str) >= 2 {
                    if str_byte_at(vec_str, 0) == 48 && (str_byte_at(vec_str, 1) == 120 || str_byte_at(vec_str, 1) == 88) {
                        si = 2;
                        while si < str_len(vec_str) {
                            var b: i64 = str_byte_at(vec_str, si);
                            if b >= 48 && b <= 57 { result = result * 16 + (b - 48); }
                            else if b >= 97 && b <= 102 { result = result * 16 + (b - 87); }
                            else if b >= 65 && b <= 70 { result = result * 16 + (b - 55); }
                            si = si + 1;
                        }
                    } else {
                        while si < str_len(vec_str) {
                            var b: i64 = str_byte_at(vec_str, si);
                            if b >= 48 && b <= 57 { result = result * 10 + (b - 48); }
                            si = si + 1;
                        }
                    }
                }
                ir_func.interrupt_vector = result;
            }
        }
        ai = ai + 1;
    }
    ir_func.is_wrapping = has_annotation(func.annotations, "wrapping");
    ir_func.is_deterministic = has_annotation(func.annotations, "deterministic");
    ir_func.is_crashfree = has_annotation(func.annotations, "crashfree");
    ir_func.is_no_alloc = has_annotation(func.annotations, "no-alloc") || has_annotation(func.annotations, "medical");
    ir_func.is_medical = has_annotation(func.annotations, "medical");
    ir_func.is_kernel = has_annotation(func.annotations, "kernel") || has_annotation(func.annotations, "shader");
    ir_func.is_simd = has_annotation(func.annotations, "simd");

    // Parse @gas(N) annotation
    match find_annotation(func.annotations, "gas") {
        OptAnnotation::Some(kann) => {
            if kann.args.len() > 0 {
                match str_parse_u64(kann.args.get(0)) {
                    OptU64::Some(v) => { ir_func.gas_limit = OptU64::Some(v); }
                    OptU64::None => {}
                }
            }
        }
        OptAnnotation::None => {}
    }

    // Parse @kernel/@shader workgroup size
    if ir_func.is_kernel {
        var kern_ann: OptAnnotation = find_annotation(func.annotations, "kernel");
        match kern_ann {
            OptAnnotation::Some(_) => {}
            OptAnnotation::None => { kern_ann = find_annotation(func.annotations, "shader"); }
        }
        match kern_ann {
            OptAnnotation::Some(kann) => {
                if kann.args.len() > 0 {
                    // Join args with "," and parse as [x,y,z] or x,y,z
                    var args_str: str = "";
                    var ai: i64 = 0;
                    while ai < kann.args.len() {
                        if ai > 0 { args_str = args_str + ","; }
                        args_str = args_str + kann.args.get(ai);
                        ai = ai + 1;
                    }
                    // Simple parsing: split by ',' and parse each part
                    var parts: Vec<str> = str_split_char(args_str, 44);  // 44 = ','
                    if parts.len() >= 3 {
                        match str_parse_u64(str_trim(parts.get(0))) {
                            OptU64::Some(x) => {
                                match str_parse_u64(str_trim(parts.get(1))) {
                                    OptU64::Some(y) => {
                                        match str_parse_u64(str_trim(parts.get(2))) {
                                            OptU64::Some(z) => {
                                                ir_func.workgroup_size = Vec::new();
                                                ir_func.workgroup_size.push(x);
                                                ir_func.workgroup_size.push(y);
                                                ir_func.workgroup_size.push(z);
                                            }
                                            OptU64::None => {}
                                        }
                                    }
                                    OptU64::None => {}
                                }
                            }
                            OptU64::None => {}
                        }
                    } else if parts.len() == 1 {
                        match str_parse_u64(str_trim(parts.get(0))) {
                            OptU64::Some(x) => {
                                ir_func.workgroup_size = Vec::new();
                                ir_func.workgroup_size.push(x);
                                ir_func.workgroup_size.push(1);
                                ir_func.workgroup_size.push(1);
                            }
                            OptU64::None => {}
                        }
                    }
                }
            }
            OptAnnotation::None => {}
        }
    }

    // SRET parameter for struct-returning functions
    var is_struct_ret: bool = false;
    match ret_ty {
        IrType::Struct(_) => { is_struct_ret = true; }
        _ => { is_struct_ret = false; }
    }

    if is_struct_ret {
        var sret_ty: IrType = IrType::Ptr(Box::new(ret_ty));
        var sret_meta: ValueMeta = ValueMeta_new(sret_ty);
        sret_meta.region = Lowerer_current_region(self);
        var sret_val: i64 = IrFunction_new_value(&mut ir_func, sret_meta);
        ir_func.params.push(ValueIdType_new(sret_val, sret_ty));
        self.current_sret = OptValueId::Some(sret_val);
    } else {
        self.current_sret = OptValueId::None;
    }

    // __env parameter (for uniform CallPtr calling convention)
    var env_meta: ValueMeta = ValueMeta_new(IrType::Ptr(Box::new(IrType::U8)));
    env_meta.region = Lowerer_current_region(self);
    var env_val: i64 = IrFunction_new_value(&mut ir_func, env_meta);
    ir_func.params.push(ValueIdType_new(env_val, IrType::Ptr(Box::new(IrType::U8))));
    IrFunction_bind_local(&mut ir_func, "__env", env_val);

    // User parameters
    var i: i64 = 0;
    while i < func.params.len() {
        var param: Param = func.params.get(i);
        var raw_ty: IrType = Lowerer_lower_type(self, param.ty);
        var is_linear: bool = Lowerer_is_linear_ir_type(self, raw_ty);
        // Struct params are passed as pointers (by-ref)
        var ir_ty: IrType = raw_ty;
        match raw_ty {
            IrType::Struct(_) => { ir_ty = IrType::Ptr(Box::new(raw_ty)); }
            _ => { ir_ty = raw_ty; }
        }
        var meta: ValueMeta = ValueMeta_new(ir_ty);
        meta.region = Lowerer_current_region(self);
        meta.is_linear = is_linear;
        var val: i64 = IrFunction_new_value(&mut ir_func, meta);
        ir_func.params.push(ValueIdType_new(val, ir_ty));
        IrFunction_bind_local(&mut ir_func, param.name, val);
        i = i + 1;
    }

    // Set as current function
    var prev_func: IrFunction = self.current_func;
    var prev_has_func: bool = self.has_current_func;
    // Save the name separately - struct assignment can corrupt string fields
    // in the Fides interpreter.
    var func_name_saved: str = func.name;
    self.current_func = ir_func;
    // Re-assign the name to ensure it's valid
    self.current_func.name = func_name_saved;
    self.has_current_func = true;
    self.current_block = 0;
    self.current_func.current_block_idx = 0;

    // Clear per-function state
    var empty_allocas: Vec<StringValueIdEntry> = Vec::new();
    self.allocas = empty_allocas;
    var empty_alloca_types: Vec<I64IrTypeEntry> = Vec::new();
    self.alloca_types = empty_alloca_types;
    var empty_var_ast_types: Vec<StringTypeEntry> = Vec::new();
    self.var_ast_types = empty_var_ast_types;
    var empty_defer_stack: Vec<Vec<Stmt>> = Vec::new();
    self.defer_stack = empty_defer_stack;
    var empty_param_types: Vec<StringTypeEntry> = Vec::new();
    self.current_func_param_types = empty_param_types;

    // Register parameter AST types (after clearing per-function state)
    var pi: i64 = 0;
    while pi < func.params.len() {
        var pparam: Param = func.params.get(pi);
        Lowerer_insert_var_ast_type(self, pparam.name, pparam.ty);
        pi = pi + 1;
    }

    // Save AST parameter types
    i = 0;
    while i < func.params.len() {
        var p: Param = func.params.get(i);
        Lowerer_insert_param_type(self, p.name, p.ty);
        i = i + 1;
    }

    // @audit annotation: emit log calls at function entry/exit
    var is_audited: bool = has_annotation(func.annotations, "audit");
    if is_audited {
        var entry_msg: i64 = Lowerer_emit_inst(self, Inst::ConstStr("[AUDIT] enter " + func.name + "\n"));
        var _p: i64 = Lowerer_emit_inst(self, Inst::Print(entry_msg, IrType::Ptr(Box::new(IrType::U8))));
        // Exit log via defer
        var exit_stmts: Vec<Stmt> = Vec::new();
        var exit_args: Vec<Expr> = Vec::new();
        exit_args.push(Expr::StringLit("[AUDIT] exit " + func.name + "\n"));
        exit_stmts.push(Stmt::Expr(Expr::Call("print", exit_args), 0));
        self.defer_stack.push(exit_stmts);
    }

    // Lower the function body
    var last_expr_val: OptValueId = OptValueId::None;
    i = 0;
    while i < func.body.len() {
        var stmt: Stmt = func.body.get(i);
        match stmt {
            Stmt::Expr(expr, _) => {
                var val: i64 = Lowerer_lower_expr(self, expr);
                last_expr_val = OptValueId::Some(val);
            }
            _ => {
                last_expr_val = OptValueId::None;
                Lowerer_lower_stmt(self, stmt);
            }
        }
        i = i + 1;
    }

    // Ensure the function ends with a return
    if !Lowerer_current_block_has_terminator(self) {
        // Emit drops, defers, and persist saves
        Lowerer_emit_drops(self);
        Lowerer_emit_defers(self);
        Lowerer_emit_persist_saves(self);

        match self.current_sret {
            OptValueId::Some(_) => {
                // Struct-returning function: copy struct data to sret, return void
                match last_expr_val {
                    OptValueId::Some(sret_val) => { Lowerer_emit_sret_copy(self, sret_val); }
                    OptValueId::None => {}
                }
                Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
            }
            OptValueId::None => {
                // Non-struct return
                if ir_type_eq(self.current_func.ret_ty, IrType::Void) {
                    Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
                } else {
                    match last_expr_val {
                        OptValueId::Some(ret_val) => {
                            var coerced: i64 = Lowerer_coerce_return(self, ret_val);
                            Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(coerced)));
                        }
                        OptValueId::None => {
                            // Implicit return of 0 for non-void functions
                            var ret_ty2: IrType = self.current_func.ret_ty;
                            var zero_meta: ValueMeta = ValueMeta_new(ret_ty2);
                            zero_meta.region = Lowerer_current_region(self);
                            var zid: i64 = IrFunction_new_value(&mut self.current_func, zero_meta);
                            var zero_inst: Inst;
                            match ret_ty2 {
                                IrType::F32 => { zero_inst = Inst::ConstFloat(0.0, ret_ty2); }
                                IrType::F64 => { zero_inst = Inst::ConstFloat(0.0, ret_ty2); }
                                IrType::Bool => { zero_inst = Inst::ConstBool(false); }
                                _ => { zero_inst = Inst::ConstInt(0, ret_ty2); }
                            }
                            IrFunction_set_inst(&mut self.current_func, zid, zero_inst);
                            // Add to current block
                            self.current_func.blocks.get(self.current_block).instructions.push(zid);
                            Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(zid)));
                        }
                    }
                }
            }
        }
    }

    // Compute function effects from all instructions
    var func_effects: EffectSet = EffectSet_new();
    var fi: i64 = 0;
    while fi < self.current_func.insts.len() {
        var inst: Inst = self.current_func.insts.get(fi).inst;
        var inst_eff: EffectSet = inst_effects(&inst);
        EffectSet_add_all(&mut func_effects, &inst_eff);
        fi = fi + 1;
    }
    self.current_func.effects = func_effects;

    // Store function effects in module
    self.module.function_effects.push(StringEffectSetEntry_new(func.name, func_effects));

    // Store the function in the module (replacing pre-registered entry)
    // Save the name first to avoid string corruption when moving the struct.
    var finished_name: str = self.current_func.name;
    IrModule_replace_function_named(&mut self.module, self.current_func, finished_name);
}

// --- Lower statements -----------------------------------------------------

pub fn Lowerer_lower_stmts(self: &mut Lowerer, stmts: Vec<Stmt>) {
    var i: i64 = 0;
    while i < stmts.len() {
        Lowerer_lower_stmt(self, stmts.get(i));
        i = i + 1;
    }
}

// --- Lowerer_lower_stmt helper functions ----------------------------------
// Split out to avoid the statement-dropping bug in long functions.

fn Lowerer_lower_let_stmt(self: &mut Lowerer, name: str, ty: OptType, expr: Expr, _is_mut: bool, is_persist: bool, annotations: Vec<Annotation>, _line: i64) {
    var saved_hint: OptType = self.let_hint;
    match ty {
        OptType::Some(t) => {
            self.let_hint = OptType::Some(Lowerer_resolve_self_in_type(self, t));
        }
        OptType::None => {}
    }

    var val: i64 = Lowerer_lower_expr(self, expr);
    self.let_hint = saved_hint;

    var val_ty: IrType = Lowerer_get_value_type(self, val);
    var ir_ty: IrType = val_ty;
    match ty {
        OptType::Some(t) => {
            var declared_ir: IrType = Lowerer_lower_type(self, t);
            if ir_type_is_aggregate(declared_ir) && ir_type_is_ptr(val_ty) {
                match val_ty {
                    IrType::Ptr(inner) => {
                        if ir_type_eq(box_ir_type_unbox(inner), declared_ir) {
                            ir_ty = declared_ir;
                        } else {
                            ir_ty = val_ty;
                        }
                    }
                    _ => { ir_ty = val_ty; }
                }
            } else {
                ir_ty = declared_ir;
            }
        }
        OptType::None => {
            // Bug 3.18 fix: When there's no declared type and the value is a
            // Ptr(Struct(...)) returned from a function (SRET pattern), use
            // the inner struct type for the alloca so it holds the full struct
            // data inline. Otherwise the alloca is only 8 bytes (pointer size),
            // and a later Assign with store_ty=Some(Struct) will memcpy the
            // full struct into an 8-byte buffer, causing a buffer overflow.
            match val_ty {
                IrType::Ptr(inner) => {
                    var inner_ty: IrType = box_ir_type_unbox(inner);
                    if ir_type_is_aggregate(inner_ty) {
                        ir_ty = inner_ty;
                    } else {
                        ir_ty = val_ty;
                    }
                }
                _ => { ir_ty = val_ty; }
            }
        }
    }

    var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(ir_ty, Lowerer_current_region(self)));
    Lowerer_insert_alloca_type(self, alloca, ir_ty);

    if is_persist {
        var loaded: i64 = Lowerer_emit_inst(self, Inst::PersistLoad(name, val, ir_ty));
        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, loaded, OptIrType::None));
        self.current_func.persist_vars.push(StringValueId_new(name, alloca));
    } else {
        var store_ty: OptIrType = OptIrType::None;
        match ir_ty {
            IrType::Struct(_) => { store_ty = OptIrType::Some(ir_ty); }
            _ => {}
        }
        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, val, store_ty));
    }

    Lowerer_insert_alloca(self, name, alloca);

    match ty {
        OptType::Some(ast_ty) => {
            Lowerer_insert_var_ast_type(self, name, ast_ty);
        }
        OptType::None => {
            var inferred: Type = Lowerer_infer_expr_ast_type(self, expr);
            match inferred {
                Type::I64 => {}
                _ => { Lowerer_insert_var_ast_type(self, name, inferred); }
            }
        }
    }

    var drop_struct: OptStringLower = OptStringLower::None;
    match ty {
        OptType::Some(t) => {
            var sn: OptStringLower = Lowerer_type_struct_name(self, t);
            match sn {
                OptStringLower::Some(name2) => {
                    if Lowerer_has_drop_impl(self, name2) {
                        drop_struct = OptStringLower::Some(name2);
                    }
                }
                OptStringLower::None => {}
            }
        }
        OptType::None => {}
    }

    Lowerer_bind_local(self, name, alloca);
    match drop_struct {
        OptStringLower::Some(struct_name) => {
            self.current_func.drop_locals.push(lw_ValueIdString_new(alloca, struct_name));
        }
        OptStringLower::None => {}
    }
    // F88: @zeroize — track locals to zero at scope exit
    if has_annotation(annotations, "zeroize") {
        var size: i64 = ir_type_size(ir_ty);
        if size > 0 {
            self.current_func.zeroize_locals.push(ValueIdU64_new(alloca, size));
        }
    }
}

fn Lowerer_lower_index_assign_stmt(self: &mut Lowerer, array_name: Box<Expr>, index: Expr, op: AssignOp, expr: Expr, _line: i64) {
    var arr_val: i64 = 0;
    match lw_box_expr_unbox(array_name) {
        Expr::Ident(name) => {
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(alloca) => {
                    var alloca_ty: IrType = IrType::I64;
                    match Lowerer_lookup_alloca_type(self, alloca) {
                        OptIrType::Some(t) => { alloca_ty = t; }
                        OptIrType::None => {}
                    }
                    arr_val = Lowerer_emit_inst(self, Inst::Load(alloca, alloca_ty));
                }
                OptValueId::None => {
                    match Lowerer_lookup_local(self, name) {
                        OptValueId::Some(local) => { arr_val = local; }
                        OptValueId::None => {
                            arr_val = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                        }
                    }
                }
            }
        }
        _ => {
            arr_val = Lowerer_lower_expr(self, lw_box_expr_unbox(array_name));
        }
    }

    var idx_val: i64 = Lowerer_lower_expr(self, index);
    var arr_ty: IrType = Lowerer_get_value_type(self, arr_val);

    if ir_type_is_opaque_named(arr_ty, "Vec") {
        var vec_elem_ty: IrType = IrType::I64;
        match arr_ty {
            IrType::Generic(gname, gargs) => {
                if gname == "Vec" && gargs.len() > 0 {
                    vec_elem_ty = gargs.get(0);
                }
            }
            IrType::Opaque(_) => {
                match lw_box_expr_unbox(array_name) {
                    Expr::Ident(vname) => {
                        match Lowerer_lookup_var_ast_type(self, vname) {
                            OptType::Some(at) => {
                                var inner_ty: Type = at;
                                match at {
                                    Type::Ref(inner, _) => { inner_ty = lw_box_type_unbox(inner); }
                                    _ => {}
                                }
                                match inner_ty {
                                    Type::Generic(an, aargs) => {
                                        if an == "Vec" && aargs.len() > 0 {
                                            vec_elem_ty = Lowerer_lower_type(self, aargs.get(0));
                                        }
                                    }
                                    _ => {}
                                }
                            }
                            OptType::None => {}
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        match op {
            AssignOp::Assign => {
                var set_val: i64 = Lowerer_lower_expr(self, expr);
                match vec_elem_ty {
                    IrType::Struct(_) => {
                        var size: i64 = IrModule_type_size(&self.module, vec_elem_ty);
                        if size <= 0 { size = 8; }
                        var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(size, IrType::I64));
                        var heap_ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(size_val), IrType::Ptr(Box::new(vec_elem_ty)), EffectSet_new()));
                        Lowerer_emit_inst(self, Inst::Store(heap_ptr, set_val, OptIrType::Some(vec_elem_ty)));
                        set_val = heap_ptr;
                    }
                    _ => {}
                }
                var args: Vec<i64> = Vec::new();
                args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));  // __env
                args.push(arr_val);
                args.push(idx_val);
                args.push(set_val);
                var _c: i64 = Lowerer_emit_inst(self, Inst::Call("Vec_set", args, IrType::Void, EffectSet_new()));
            }
            _ => {
                var get_args: Vec<i64> = Vec::new();
                get_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));  // __env
                get_args.push(arr_val);
                get_args.push(idx_val);
                var get_ret_ty: IrType = word_repr(vec_elem_ty);
                var current: i64 = Lowerer_emit_inst(self, Inst::Call("Vec_get", get_args, get_ret_ty, EffectSet_new()));
                var rhs: i64 = Lowerer_lower_expr(self, expr);
                var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                match vec_elem_ty {
                    IrType::Struct(_) => {
                        var size: i64 = IrModule_type_size(&self.module, vec_elem_ty);
                        if size <= 0 { size = 8; }
                        var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(size, IrType::I64));
                        var heap_ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(size_val), IrType::Ptr(Box::new(vec_elem_ty)), EffectSet_new()));
                        Lowerer_emit_inst(self, Inst::Store(heap_ptr, new_val, OptIrType::Some(vec_elem_ty)));
                        new_val = heap_ptr;
                    }
                    _ => {}
                }
                var set_args: Vec<i64> = Vec::new();
                set_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));  // __env
                set_args.push(arr_val);
                set_args.push(idx_val);
                set_args.push(new_val);
                var _c2: i64 = Lowerer_emit_inst(self, Inst::Call("Vec_set", set_args, IrType::Void, EffectSet_new()));
            }
        }
    } else {
        var elem_ty: IrType = IrType::I64;
        match arr_ty {
            IrType::Array(inner, _) => { elem_ty = inner; }
            _ => {}
        }
        var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(arr_val, idx_val, elem_ty));
        match op {
            AssignOp::Assign => {
                var val: i64 = Lowerer_lower_expr(self, expr);
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(elem_ptr, val, OptIrType::None));
            }
            _ => {
                var current: i64 = Lowerer_emit_inst(self, Inst::Load(elem_ptr, elem_ty));
                var rhs: i64 = Lowerer_lower_expr(self, expr);
                var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(elem_ptr, new_val, OptIrType::None));
            }
        }
    }
}

fn Lowerer_lower_select_stmt(self: &mut Lowerer, cases: Vec<SelectCase>, default: OptStmts, _line: i64) {
    var merge_block: i64 = Lowerer_new_block(self);

    if cases.len() == 0 {
        match default {
            OptStmts::Some(def_body) => {
                var di: i64 = 0;
                while di < def_body.len() {
                    Lowerer_lower_stmt(self, def_body.get(di));
                    di = di + 1;
                }
            }
            OptStmts::None => {}
        }
        if !Lowerer_current_block_has_terminator(self) {
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));
        }
        Lowerer_set_current_block(self, merge_block);
        return;
    }

    var chan_vals: Vec<i64> = Vec::new();
    var ci: i64 = 0;
    while ci < cases.len() {
        var case: SelectCase = cases.get(ci);
        chan_vals.push(Lowerer_lower_expr(self, case.channel));
        ci = ci + 1;
    }

    var recv_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));

    var case_blocks: Vec<i64> = Vec::new();
    var next_poll_blocks: Vec<i64> = Vec::new();
    ci = 0;
    while ci < cases.len() {
        case_blocks.push(Lowerer_new_block(self));
        next_poll_blocks.push(Lowerer_new_block(self));
        ci = ci + 1;
    }
    var default_block: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Jump(next_poll_blocks.get(0)));

    ci = 0;
    while ci < cases.len() {
        Lowerer_set_current_block(self, next_poll_blocks.get(ci));
        var try_recv_args: Vec<i64> = Vec::new();
        try_recv_args.push(chan_vals.get(ci));
        var try_recv: i64 = Lowerer_emit_inst(self, Inst::Call("p_chan_try_recv", try_recv_args, IrType::I64, EffectSet_new()));
        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(recv_alloca, try_recv, OptIrType::None));
        var sentinel: i64 = Lowerer_emit_inst(self, Inst::ConstInt(-9223372036854775807, IrType::I64));
        var is_ready: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Neq, try_recv, sentinel, IrType::Bool));
        var next_block: i64 = 0;
        if ci + 1 < cases.len() {
            next_block = next_poll_blocks.get(ci + 1);
        } else {
            next_block = default_block;
        }
        Lowerer_emit_terminator(self, Inst::Branch(is_ready, case_blocks.get(ci), next_block));
        ci = ci + 1;
    }

    ci = 0;
    while ci < cases.len() {
        Lowerer_set_current_block(self, case_blocks.get(ci));
        var recv_val: i64 = Lowerer_emit_inst(self, Inst::Load(recv_alloca, IrType::I64));
        var case: SelectCase = cases.get(ci);
        var existing: OptValueId = Lowerer_lookup_alloca(self, case.var_name);
        match existing {
            OptValueId::Some(alloca) => {
                var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, recv_val, OptIrType::None));
            }
            OptValueId::None => {
                var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
                Lowerer_insert_alloca_type(self, alloca, IrType::I64);
                var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, recv_val, OptIrType::None));
                Lowerer_insert_alloca(self, case.var_name, alloca);
                Lowerer_bind_local(self, case.var_name, alloca);
            }
        }
        var bi: i64 = 0;
        while bi < case.body.len() {
            Lowerer_lower_stmt(self, case.body.get(bi));
            bi = bi + 1;
        }
        if !Lowerer_current_block_has_terminator(self) {
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));
        }
        ci = ci + 1;
    }

    Lowerer_set_current_block(self, default_block);
    match default {
        OptStmts::Some(def_body) => {
            var di: i64 = 0;
            while di < def_body.len() {
                Lowerer_lower_stmt(self, def_body.get(di));
                di = di + 1;
            }
        }
        OptStmts::None => {}
    }
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(merge_block));
    }
    Lowerer_set_current_block(self, merge_block);
}

pub fn Lowerer_lower_stmt(self: &mut Lowerer, stmt: Stmt) {
    match stmt {
        Stmt::Let(name, ty, expr, _is_mut, is_persist, annotations, _line) => {
            Lowerer_lower_let_stmt(self, name, ty, expr, _is_mut, is_persist, annotations, _line);
        }
        Stmt::LetUninit(name, ty, annotations, _line) => {
            var ir_ty: IrType = Lowerer_lower_type(self, ty);
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(ir_ty, Lowerer_current_region(self)));
            Lowerer_insert_alloca_type(self, alloca, ir_ty);
            Lowerer_insert_alloca(self, name, alloca);
            Lowerer_bind_local(self, name, alloca);
            // F88: @zeroize — track locals to zero at scope exit
            if has_annotation(annotations, "zeroize") {
                var size: i64 = ir_type_size(ir_ty);
                if size > 0 {
                    self.current_func.zeroize_locals.push(ValueIdU64_new(alloca, size));
                }
            }
        }
        Stmt::LetTuple(names, expr, _line) => {
            var tuple_ptr: i64 = Lowerer_lower_expr(self, expr);
            var n: i64 = names.len();
            // Destructure tuple: each element is at offset i*8
            var ti: i64 = 0;
            while ti < n {
                var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(tuple_ptr, ti, IrType::I64));
                var elem_val: i64 = Lowerer_emit_inst(self, Inst::Load(elem_ptr, IrType::I64));
                var name: str = names.get(ti);
                var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
                Lowerer_insert_alloca_type(self, alloca, IrType::I64);
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, elem_val, OptIrType::None));
                Lowerer_insert_alloca(self, name, alloca);
                Lowerer_bind_local(self, name, alloca);
                ti = ti + 1;
            }
        }
        Stmt::Assign(name, op, expr, _line) => {
            // Check if target is a module-level mutable global
            match IrModule_get_global(&self.module, name) {
                OptGlobalLookup::Some(ir_ty, _init) => {
                    var addr: i64 = Lowerer_emit_inst(self, Inst::GlobalAddr(name, ir_ty));
                    match op {
                        AssignOp::Assign => {
                            var val: i64 = Lowerer_lower_expr(self, expr);
                            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(addr, val, OptIrType::None));
                        }
                        _ => {
                            // Compound assignment: load current, apply op, store
                            var current: i64 = Lowerer_emit_inst(self, Inst::Load(addr, ir_ty));
                            var rhs: i64 = Lowerer_lower_expr(self, expr);
                            var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                            var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(addr, new_val, OptIrType::None));
                        }
                    }
                    return;
                }
                OptGlobalLookup::None => {}
            }
            // Look up alloca for mutable variable
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(alloca) => {
                    var val: i64 = Lowerer_lower_expr(self, expr);
                    match op {
                        AssignOp::Assign => {
                            // For struct-typed variables, use store_ty to
                            // emit memcpy (full struct copy). Without this,
                            // only 8 bytes (the pointer) are copied.
                            var val_ty: IrType = Lowerer_get_value_type(self, val);
                            var store_ty: OptIrType = OptIrType::None;
                            match val_ty {
                                IrType::Ptr(inner) => {
                                    var inner_ty: IrType = box_ir_type_unbox(inner);
                                    if ir_type_is_aggregate(inner_ty) {
                                        store_ty = OptIrType::Some(inner_ty);
                                    }
                                }
                                _ => {}
                            }
                            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, val, store_ty));
                        }
                        _ => {
                            // Compound assignment: load current, apply op, store
                            var alloca_ty: IrType = IrType::I64;
                            match Lowerer_lookup_alloca_type(self, alloca) {
                                OptIrType::Some(t) => { alloca_ty = t; }
                                OptIrType::None => {}
                            }
                            var current: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, alloca_ty));
                            var result: i64 = Lowerer_lower_compound_assign(self, op, current, val);
                            var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, result, OptIrType::None));
                        }
                    }
                }
                OptValueId::None => {
                    // Not an alloca - try local binding
                    match Lowerer_lookup_local(self, name) {
                        OptValueId::Some(local) => {
                            var val: i64 = Lowerer_lower_expr(self, expr);
                            // Direct assignment to local ( SSA - but we support it)
                            Lowerer_set_value_type(self, local, Lowerer_get_value_type(self, val));
                        }
                        OptValueId::None => {}
                    }
                }
            }
        }
        Stmt::Expr(expr, _line) => {
            var _v: i64 = Lowerer_lower_expr(self, expr);
        }
        Stmt::Return(expr, _line) => {
            // Evaluate the returned value first. Drops, @zeroize wipes,
            // defers and persist saves then run, as at the closing brace;
            // running them first made `return f(key)` read a wiped key and
            // `defer { x = 0 } return x` return 0.
            var ret_val: OptValueId = OptValueId::None;
            match expr {
                OptBoxExpr::Some(e) => {
                    match self.current_sret {
                        OptValueId::Some(sret) => {
                            var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
                            Lowerer_emit_sret_copy(self, val);
                        }
                        OptValueId::None => {
                            var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
                            ret_val = OptValueId::Some(Lowerer_coerce_return(self, val));
                        }
                    }
                }
                OptBoxExpr::None => {}
            }
            Lowerer_emit_drops(self);
            Lowerer_emit_defers(self);
            Lowerer_emit_persist_saves(self);
            Lowerer_emit_terminator(self, Inst::Return(ret_val));
        }
        Stmt::If(cond, then_block, else_block, _line) => {
            var cond_val: i64 = Lowerer_lower_expr(self, cond);
            var then_block_id: i64 = Lowerer_new_block(self);
            var else_block_id: i64 = Lowerer_new_block(self);
            var merge_block_id: i64 = Lowerer_new_block(self);
            Lowerer_emit_terminator(self, Inst::Branch(cond_val, then_block_id, else_block_id));

            // Save variable binding lengths so then/else-local bindings
            // don't leak across branches or into the merge block.
            // Fides Vec is a reference type (PVec*), so we use truncate-based
            // save/restore instead of pointer-copy assignment.
            var saved_allocas_len: i64 = self.allocas.len();
            var saved_alloca_types_len: i64 = self.alloca_types.len();
            var saved_var_ast_types_len: i64 = self.var_ast_types.len();
            var saved_locals_len: i64 = self.current_func.locals.len();

            // Then block
            Lowerer_set_current_block(self, then_block_id);
            Lowerer_lower_stmts(self, then_block);
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(merge_block_id));
            }
            // Restore for else block
            self.allocas.truncate(saved_allocas_len);
            self.alloca_types.truncate(saved_alloca_types_len);
            self.var_ast_types.truncate(saved_var_ast_types_len);
            self.current_func.locals.truncate(saved_locals_len);

            // Else block
            Lowerer_set_current_block(self, else_block_id);
            match else_block {
                OptStmts::Some(else_stmts) => { Lowerer_lower_stmts(self, else_stmts); }
                OptStmts::None => {}
            }
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(merge_block_id));
            }
            // Restore for merge block
            self.allocas.truncate(saved_allocas_len);
            self.alloca_types.truncate(saved_alloca_types_len);
            self.var_ast_types.truncate(saved_var_ast_types_len);
            self.current_func.locals.truncate(saved_locals_len);

            Lowerer_set_current_block(self, merge_block_id);
        }
        Stmt::While(cond, body, _line) => {
            Lowerer_lower_while(self, cond, body);
        }
        Stmt::For(loop_var, iterator, body, _line) => {
            Lowerer_lower_for(self, loop_var, iterator, body);
        }
        Stmt::Loop(body, _line) => {
            Lowerer_lower_loop(self, body);
        }
        Stmt::Break(expr, _line) => {
            // Set break value if in loop-as-expression context
            match expr {
                OptBoxExpr::Some(e) => {
                    var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
                    if self.loop_stack.len() > 0 {
                        var ctx: LoopContext = self.loop_stack.get(self.loop_stack.len() - 1);
                        match ctx.result_slot {
                            OptValueId::Some(slot) => {
                                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(slot, val, OptIrType::None));
                            }
                            OptValueId::None => {}
                        }
                    }
                }
                OptBoxExpr::None => {}
            }
            // Jump to break target
            if self.loop_stack.len() > 0 {
                var ctx2: LoopContext = self.loop_stack.get(self.loop_stack.len() - 1);
                Lowerer_emit_terminator(self, Inst::Jump(ctx2.break_target));
            }
        }
        Stmt::Continue(_line) => {
            if self.loop_stack.len() > 0 {
                var ctx: LoopContext = self.loop_stack.get(self.loop_stack.len() - 1);
                Lowerer_emit_terminator(self, Inst::Jump(ctx.continue_target));
            }
        }
        Stmt::Defer(body, _line) => {
            self.defer_stack.push(body);
        }
        Stmt::Match(expr, arms, _line) => {
            Lowerer_lower_match(self, expr, arms);
        }
        Stmt::IndexAssign(array_name, index, op, expr, _line) => {
            Lowerer_lower_index_assign_stmt(self, box_expr_new(Expr::Ident(array_name)), index, op, expr, _line);
        }
        Stmt::DerefAssign(ptr_expr, op, expr, _line) => {
            var ptr_val: i64 = Lowerer_lower_expr(self, ptr_expr);
            var pointee_ty: IrType = IrType::I64;
            match Lowerer_get_value_type(self, ptr_val) {
                IrType::Ptr(inner) => { pointee_ty = inner; }
                _ => {}
            }
            match op {
                AssignOp::Assign => {
                    var val: i64 = Lowerer_lower_expr(self, expr);
                    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(ptr_val, val, OptIrType::Some(pointee_ty)));
                }
                _ => {
                    var current: i64 = Lowerer_emit_inst(self, Inst::Load(ptr_val, pointee_ty));
                    var rhs: i64 = Lowerer_lower_expr(self, expr);
                    var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(ptr_val, new_val, OptIrType::Some(pointee_ty)));
                }
            }
        }
        Stmt::FieldAssign(object, field, op, expr, _line) => {
            var struct_ptr: i64 = Lowerer_lower_expr(self, object);
            var struct_ty: IrType = Lowerer_get_value_type(self, struct_ptr);
            var struct_name: str = "";
            match struct_ty {
                IrType::Ptr(inner) => {
                    match inner {
                        IrType::Struct(n) => { struct_name = n; }
                        _ => {}
                    }
                }
                IrType::Struct(n) => { struct_name = n; }
                _ => {}
            }

            if str_len(struct_name) > 0 {
                match IrModule_get_struct(&self.module, struct_name) {
                    OptStructLayout::Some(layout) => {
                        // Find field index and type
                        var field_idx: i64 = 0;
                        var field_ty: IrType = IrType::I64;
                        var found_field: bool = false;
                        var fi: i64 = 0;
                        while fi < layout.fields.len() {
                            if layout.fields.get(fi).name == field {
                                field_idx = fi;
                                field_ty = layout.fields.get(fi).ty;
                                found_field = true;
                            }
                            fi = fi + 1;
                        }

                        if found_field {
                            var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(struct_ptr, field_idx, field_ty));
                            match op {
                                AssignOp::Assign => {
                                    var val: i64 = Lowerer_lower_expr(self, expr);
                                    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, val, OptIrType::None));
                                }
                                _ => {
                                    var current: i64 = Lowerer_emit_inst(self, Inst::Load(field_ptr, field_ty));
                                    var rhs: i64 = Lowerer_lower_expr(self, expr);
                                    var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                                    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, new_val, OptIrType::None));
                                }
                            }
                        }
                    }
                    OptStructLayout::None => {}
                }
            }
        }
        Stmt::Unsafe(body, _line) => {
            // F62: emit UnsafeBegin/UnsafeEnd so interpreter can skip bounds checks
            var _ub: i64 = Lowerer_emit_inst(self, Inst::UnsafeBegin);
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            if !Lowerer_current_block_has_terminator(self) {
                var _ue: i64 = Lowerer_emit_inst(self, Inst::UnsafeEnd);
            }
        }
        Stmt::RegionBlock(name, _budget, is_gpu, is_kv_cache, _window_size, body, _line) => {
            // Emit RegionBegin, push region, lower body, pop, emit RegionEnd
            var _rb: i64 = Lowerer_emit_inst(self, Inst::RegionBegin(name, is_gpu, is_kv_cache, OptU64::None));
            self.region_stack.push(name);
            if is_gpu { self.gpu_region_stack.push(name); }
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            self.region_stack.pop();
            if is_gpu { self.gpu_region_stack.pop(); }
            if !Lowerer_current_block_has_terminator(self) {
                var _re: i64 = Lowerer_emit_inst(self, Inst::RegionEnd(name, is_gpu, is_kv_cache));
            }
        }
        Stmt::Sandbox(body, _line) => {
            // Track sandbox context for optimizer
            self.sandbox_depth = self.sandbox_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            self.sandbox_depth = self.sandbox_depth - 1;
        }
        Stmt::Txn(body, _line) => {
            var _tb: i64 = Lowerer_emit_inst(self, Inst::TxnBegin);
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            if !Lowerer_current_block_has_terminator(self) {
                var _te: i64 = Lowerer_emit_inst(self, Inst::TxnEnd);
            }
        }
        Stmt::ComptimeGen(_body, _line) => {
            // Comptime gen blocks are processed before lowering - no-op here
        }
        Stmt::GradBlock(var_name, body, _line) => {
            var _gb: i64 = Lowerer_emit_inst(self, Inst::GradBegin(var_name));
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            if !Lowerer_current_block_has_terminator(self) {
                var _ge: i64 = Lowerer_emit_inst(self, Inst::GradEnd);
            }
        }
        Stmt::Backward(loss_expr, _line) => {
            var loss_val: i64 = Lowerer_lower_expr(self, loss_expr);
            var _b: i64 = Lowerer_emit_inst(self, Inst::Backward(loss_val));
        }
        Stmt::Query(_names, body, _line) => {
            // Query blocks lower as regular statements
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
        }
        Stmt::Select(cases, default, _line) => {
            Lowerer_lower_select_stmt(self, cases, default, _line);
        }
        Stmt::Parallel(branches, _line) => {
            // F13: parallel { | branch1 | branch2 | ... }
            // Fork-join parallelism: spawn each branch as a thread, then join all.
            // For branches that are a single call expression, spawn via p_thread_spawn.
            // For complex branches, execute sequentially (semantics preserved).
            // All spawned threads are joined before continuing.
            var thread_handles: Vec<i64> = Vec::new();
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                // Check if branch is a single expression statement that is a call
                var spawned: bool = false;
                if branch.len() == 1 {
                    match branch.get(0) {
                        Stmt::Expr(e, _l) => {
                            match e {
                                Expr::Call(callee, args) => {
                                    // Spawn: p_thread_spawn(func_name, num_args, args...)
                                    var func_name_val: i64 = Lowerer_emit_inst(self, Inst::ConstStr(callee));
                                    var num_args_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(args.len(), IrType::I64));
                                    var all_args: Vec<i64> = Vec::new();
                                    all_args.push(func_name_val);
                                    all_args.push(num_args_val);
                                    var ai: i64 = 0;
                                    while ai < args.len() {
                                        all_args.push(Lowerer_lower_expr(self, args.get(ai)));
                                        ai = ai + 1;
                                    }
                                    var handle: i64 = Lowerer_emit_inst(self, Inst::Call("p_thread_spawn", all_args, IrType::I64, EffectSet_new()));
                                    thread_handles.push(handle);
                                    spawned = true;
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                }
                if !spawned {
                    // Complex branch — execute sequentially
                    var si: i64 = 0;
                    while si < branch.len() {
                        Lowerer_lower_stmt(self, branch.get(si));
                        si = si + 1;
                    }
                }
                bi = bi + 1;
            }
            // Join all spawned threads
            var ji: i64 = 0;
            while ji < thread_handles.len() {
                var join_args: Vec<i64> = Vec::new();
                join_args.push(thread_handles.get(ji));
                var _v: i64 = Lowerer_emit_inst(self, Inst::Call("p_thread_join", join_args, IrType::Void, EffectSet_new()));
                ji = ji + 1;
            }
        }
        Stmt::Handle(body, handlers, _line) => {
            // Effect handler: lower the body. When a `do Effect.op(args)` is
            // encountered inside, the matching handler is called.
            // Store handlers in a stack so Do statements can find them.
            self.effect_handler_stack.push(handlers);
            Lowerer_lower_stmts(self, body);
            self.effect_handler_stack.pop();
        }
        Stmt::Do(effect, op, args, _line) => {
            // Look up the handler for this effect.op
            var handler_idx: i64 = -1;
            var stack_idx: i64 = self.effect_handler_stack.len() - 1;
            while stack_idx >= 0 {
                var handlers: Vec<EffectHandler> = self.effect_handler_stack.get(stack_idx);
                var hi: i64 = 0;
                while hi < handlers.len() {
                    var h: EffectHandler = handlers.get(hi);
                    if h.effect == effect && h.op == op {
                        handler_idx = hi;
                        // Found - bind args to params and lower body
                        var ai: i64 = 0;
                        while ai < args.len() {
                            if ai < h.params.len() {
                                var arg_val: i64 = Lowerer_lower_expr(self, args.get(ai));
                                var slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
                                Lowerer_insert_alloca_type(self, slot, IrType::I64);
                                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(slot, arg_val, OptIrType::None));
                                Lowerer_insert_alloca(self, h.params.get(ai), slot);
                                Lowerer_bind_local(self, h.params.get(ai), slot);
                            }
                            ai = ai + 1;
                        }
                        Lowerer_lower_stmts(self, h.body);
                        // Done - break out of both loops
                        stack_idx = -1;
                        hi = handlers.len();
                    }
                    hi = hi + 1;
                }
                if handler_idx >= 0 {
                    // Already handled - break
                    stack_idx = -1;
                } else {
                    stack_idx = stack_idx - 1;
                }
            }
            if handler_idx < 0 {
                // No handler found - just lower the args (no-op)
                var ai2: i64 = 0;
                while ai2 < args.len() {
                    var _v: i64 = Lowerer_lower_expr(self, args.get(ai2));
                    ai2 = ai2 + 1;
                }
            }
        }
        Stmt::Use(_path, _items, _line) => {
            // Use statements are resolved at import time - no-op in lowering
        }
        Stmt::Resume(cont, value, _line) => {
            // L3A: resume(cont, value) — call the continuation closure.
            // Closure ABI: (env: *u8, value: i64) -> i64; CallPtr passes the
            // env pointer as first arg automatically (has_env = true).
            var cont_val: i64 = Lowerer_lower_expr(self, cont);
            var value_val: i64 = Lowerer_lower_expr(self, value);
            var _r: i64 = Lowerer_emit_inst(self, Inst::CallPtr(cont_val, lw_c_vec1_i64(value_val), IrType::I64, EffectSet_new(), true));
        }
        Stmt::SpawnScope(body, _line) => {
            // L3B: spawn scope { body } — create an executor, lower the body
            // (spawn exprs use the top-of-stack executor), then join at exit.
            var exec: i64 = Lowerer_emit_inst(self, Inst::Call("p_executor_new", Vec::new(), IrType::I64, EffectSet_new()));
            self.scope_executor_stack.push(exec);
            Lowerer_lower_stmts(self, body);
            self.scope_executor_stack.pop();
            var _j: i64 = Lowerer_emit_inst(self, Inst::Call("p_executor_run_all", lw_c_vec1_i64(exec), IrType::I64, EffectSet_new()));
        }
        Stmt::CancelScope(_line) => {
            // L3E: cancel scope; — cancel all pending tasks in current scope
            if self.scope_executor_stack.len() > 0 {
                var exec2: i64 = self.scope_executor_stack.get(self.scope_executor_stack.len() - 1);
                var _c: i64 = Lowerer_emit_inst(self, Inst::Call("p_executor_cancel", lw_c_vec1_i64(exec2), IrType::I64, EffectSet_new()));
            }
        }
    }
}

// --- Stubs for functions implemented in later parts -----------------------

// MethodCall lowering extracted into a separate function to avoid the
// statement-dropping bug in long functions. Lowerer_lower_expr is ~16K lines
// of generated C, and statements in the MethodCall branch were being dropped.
pub fn Lowerer_lower_method_call(self: &mut Lowerer, receiver: Box<Expr>, method: str, args: Vec<Expr>) -> i64 {
    // Check for associated function calls: Vec::new(), HashMap::new(), String::from()
    match lw_box_expr_unbox(receiver) {
        Expr::Ident(name) => {
            if name == "Vec" && method == "new" {
                var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                return Lowerer_emit_inst(self, Inst::Call("Vec_new", lw_c_vec1_i64(dummy_env), IrType::Opaque("Vec"), EffectSet_new()));
            }
            if name == "HashMap" && method == "new" {
                var dummy_env2: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                return Lowerer_emit_inst(self, Inst::Call("HashMap_new", lw_c_vec1_i64(dummy_env2), IrType::Opaque("HashMap"), EffectSet_new()));
            }
            if name == "String" && method == "from" {
                var arg0: i64 = Lowerer_lower_expr(self, args.get(0));
                var dummy_env3: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var sargs: Vec<i64> = Vec::new();
                sargs.push(dummy_env3);
                sargs.push(arg0);
                return Lowerer_emit_inst(self, Inst::Call("String_from", sargs, IrType::Opaque("String"), EffectSet_new()));
            }
            if name == "Box" && method == "new" {
                return Lowerer_lower_box_new(self, args.get(0));
            }
            // Struct associated function call: mangle as StructName_method
            if Lowerer_is_struct(self, name) {
                return Lowerer_lower_assoc_call(self, name, method, args);
            }
            // Check if name is a known enum - treat as EnumLit
            match Lowerer_lookup_enum(self, name) {
                OptEnumDef::Some(_) => {
                    return Lowerer_lower_expr(self, Expr::EnumLit(name, method, args));
                }
                OptEnumDef::None => {}
            }
        }
        _ => {}
    }

    // Lower receiver
    var recv_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(receiver));
    var recv_ty: IrType = Lowerer_get_value_type(self, recv_val);

    // Lower arguments
    var arg_vals: Vec<i64> = Vec::new();
    var ai: i64 = 0;
    while ai < args.len() {
        arg_vals.push(Lowerer_lower_expr(self, args.get(ai)));
        ai = ai + 1;
    }

    // Determine mangled method name
    var mangled_name: str = Lowerer_mangle_method(self, method, recv_ty, receiver);

    // Fallback: if mangled_name is still just the method name, try common prefixes
    if mangled_name == method {
        if Lowerer_has_function(self, "Vec_" + method) {
            mangled_name = "Vec_" + method;
        } else if Lowerer_has_function(self, "HashMap_" + method) {
            mangled_name = "HashMap_" + method;
        } else if Lowerer_has_function(self, "String_" + method) {
            mangled_name = "String_" + method;
        }
    }

    // Determine return type
    var ret_ty: IrType = Lowerer_lookup_func_ret_ty_ir(self, mangled_name);
    if ir_type_eq(ret_ty, IrType::I64) {
        ret_ty = Lowerer_lookup_func_ret_ty_ir(self, method);
    }

    // For Vec methods that return elements (get/pop/first/last/remove),
    // use word_repr(elem_ty) so struct elements get Ptr(Struct(...)) -
    // this lets the C codegen look up correct field offsets.
    if str_starts_with(mangled_name, "Vec_") {
        if method == "get" || method == "pop" || method == "first" || method == "last" || method == "remove" {
            var vec_elem_ty: IrType = IrType::I64;
            var effective_recv_ty: IrType = recv_ty;
            match recv_ty {
                IrType::Ptr(inner) => { effective_recv_ty = box_ir_type_unbox(inner); }
                _ => {}
            }
            match effective_recv_ty {
                IrType::Generic(gname, gargs) => {
                    if gname == "Vec" && gargs.len() > 0 {
                        vec_elem_ty = gargs.get(0);
                    }
                }
                IrType::Opaque(oname) => {
                    if oname == "Vec" {
                        match lw_box_expr_unbox(receiver) {
                            Expr::Ident(vname) => {
                                match Lowerer_lookup_var_ast_type(self, vname) {
                                    OptType::Some(ast_ty) => {
                                        var inner_ty: Type = ast_ty;
                                        match ast_ty {
                                            Type::Ref(rinner, _) => { inner_ty = lw_box_type_unbox(rinner); }
                                            _ => {}
                                        }
                                        match inner_ty {
                                            Type::Generic(an, aargs) => {
                                                if an == "Vec" && aargs.len() > 0 {
                                                    vec_elem_ty = Lowerer_lower_type(self, aargs.get(0));
                                                }
                                            }
                                            _ => {}
                                        }
                                    }
                                    OptType::None => {}
                                }
                            }
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
            ret_ty = word_repr(vec_elem_ty);
        }
    }

    // Build call args
    var call_args: Vec<i64> = Vec::new();
    var mangled_is_extern: bool = Lowerer_is_extern_func(self, mangled_name);
    var mangled_is_runtime: bool = str_starts_with(mangled_name, "p_") || str_starts_with(mangled_name, "__ecs_");
    if !mangled_is_extern && !mangled_is_runtime && mangled_name != "print" {
        call_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
    }
    // Auto-deref: for &mut Vec<T> etc, load the actual Vec pointer
    var effective_recv_val: i64 = Lowerer_auto_deref_recv(self, recv_val, recv_ty);
    call_args.push(effective_recv_val);
    ai = 0;
    while ai < arg_vals.len() {
        call_args.push(arg_vals.get(ai));
        ai = ai + 1;
    }

    // Box struct elements before pushing/inserting into Vec
    if method == "push" || method == "insert" || method == "set" {
        Lowerer_box_vec_element(self, call_args, recv_ty, receiver);
    }

    var eff: EffectSet = EffectSet_new();
    match runtime_effects(mangled_name) {
        OptEffectSet::Some(e) => { eff = e; }
        OptEffectSet::None => {}
    }

    // Handle struct return via SRET
    match ret_ty {
        IrType::Struct(sname) => {
            var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct(sname), Lowerer_current_region(self)));
            var sret_args: Vec<i64> = Vec::new();
            sret_args.push(sret_ptr);
            var si: i64 = 0;
            while si < call_args.len() {
                sret_args.push(call_args.get(si));
                si = si + 1;
            }
            Lowerer_emit_inst(self, Inst::Call(mangled_name, sret_args, IrType::Void, eff));
            return sret_ptr;
        }
        _ => {}
    }

    return Lowerer_emit_inst(self, Inst::Call(mangled_name, call_args, ret_ty, eff));
}

// Helper: Box::new(x) lowering
pub fn Lowerer_lower_box_new(self: &mut Lowerer, arg_expr: Expr) -> i64 {
    var val: i64 = Lowerer_lower_expr(self, arg_expr);
    var val_ty: IrType = Lowerer_get_value_type(self, val);
    var alloc_size: i64 = 8;
    var store_ty: OptIrType = OptIrType::None;
    match val_ty {
        IrType::Ptr(inner) => {
            var inner_ty: IrType = box_ir_type_unbox(inner);
            if ir_type_is_aggregate(inner_ty) {
                alloc_size = IrModule_type_size(&self.module, inner_ty);
                store_ty = OptIrType::Some(inner_ty);
            } else {
                alloc_size = ir_type_size(val_ty);
            }
        }
        _ => {
            alloc_size = ir_type_size(val_ty);
        }
    }
    if alloc_size == 0 { alloc_size = 8; }
    var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(alloc_size, IrType::I64));
    var ptr_ty: IrType = IrType::Ptr(Box::new(val_ty));
    var ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(size_val), ptr_ty, EffectSet_new()));
    Lowerer_emit_inst(self, Inst::Store(ptr, val, store_ty));
    return ptr;
}

// Helper: associated function call (StructName::method)
pub fn Lowerer_lower_assoc_call(self: &mut Lowerer, struct_name: str, method: str, args: Vec<Expr>) -> i64 {
    var mangled: str = struct_name + "_" + method;
    var all_args: Vec<i64> = Vec::new();
    var si: i64 = 0;
    while si < args.len() {
        all_args.push(Lowerer_lower_expr(self, args.get(si)));
        si = si + 1;
    }
    var sret_ty: IrType = Lowerer_lookup_func_ret_ty_ir(self, mangled);
    var seff: EffectSet = EffectSet_new();
    match runtime_effects(mangled) {
        OptEffectSet::Some(e) => { seff = e; }
        OptEffectSet::None => {}
    }
    match sret_ty {
        IrType::Struct(sname) => {
            var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct(sname), Lowerer_current_region(self)));
            var sret_args: Vec<i64> = Vec::new();
            sret_args.push(sret_ptr);
            if Lowerer_is_user_func(self, mangled) && !Lowerer_is_extern_func(self, mangled) {
                var dummy_env4: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                sret_args.push(dummy_env4);
            }
            si = 0;
            while si < all_args.len() {
                sret_args.push(all_args.get(si));
                si = si + 1;
            }
            Lowerer_emit_inst(self, Inst::Call(mangled, sret_args, IrType::Void, seff));
            return sret_ptr;
        }
        _ => {
            if Lowerer_is_user_func(self, mangled) && !Lowerer_is_extern_func(self, mangled) {
                var dummy_env4: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                all_args.insert(0, dummy_env4);
            }
            return Lowerer_emit_inst(self, Inst::Call(mangled, all_args, sret_ty, seff));
        }
    }
}

// Helper: resolve a type alias name to its underlying type name for method mangling.
// e.g. "ScopeStack" (alias for Vec<ScopeEntry>) - "Vec"
// Returns the original name if no alias is found.
pub fn Lowerer_resolve_type_alias_name(self: &Lowerer, name: str) -> str {
    match Lowerer_lookup_type_alias(self, name) {
        OptType::Some(alias) => {
            match alias {
                Type::Named(inner) => { return Lowerer_resolve_type_alias_name(self, inner); }
                Type::Generic(gname, _) => { return gname; }
                _ => { return name; }
            }
            return name;
        }
        OptType::None => { return name; }
    }
    return name;
}

// Helper: mangle method name based on receiver type
pub fn Lowerer_mangle_method(self: &mut Lowerer, method: str, recv_ty: IrType, receiver: Box<Expr>) -> str {
    var mangled_name: str = method;
    match recv_ty {
        IrType::Struct(struct_name) => {
            var resolved_name: str = Lowerer_resolve_type_alias_name(self, struct_name);
            // If resolved to a builtin collection name, use it directly
            if resolved_name == "Vec" || resolved_name == "HashMap" || resolved_name == "String" {
                return resolved_name + "_" + method;
            }
            mangled_name = resolved_name + "_" + method;
        }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(struct_name2) => {
                    var resolved_name2: str = Lowerer_resolve_type_alias_name(self, struct_name2);
                    if resolved_name2 == "Vec" || resolved_name2 == "HashMap" || resolved_name2 == "String" {
                        return resolved_name2 + "_" + method;
                    }
                    mangled_name = resolved_name2 + "_" + method;
                }
                IrType::Opaque(type_name2) => {
                    var resolved_name3: str = Lowerer_resolve_type_alias_name(self, type_name2);
                    if resolved_name3 == "Vec" || resolved_name3 == "HashMap" || resolved_name3 == "String" {
                        return resolved_name3 + "_" + method;
                    }
                    mangled_name = resolved_name3 + "_" + method;
                }
                IrType::Generic(gen_name2, _) => {
                    mangled_name = gen_name2 + "_" + method;
                }
                _ => {}
            }
        }
        IrType::Opaque(type_name) => {
            var resolved_name4: str = Lowerer_resolve_type_alias_name(self, type_name);
            if resolved_name4 == "Vec" || resolved_name4 == "HashMap" || resolved_name4 == "String" {
                return resolved_name4 + "_" + method;
            }
            mangled_name = resolved_name4 + "_" + method;
        }
        IrType::Generic(gen_name, _) => {
            mangled_name = gen_name + "_" + method;
        }
        _ => {
            match lw_box_expr_unbox(receiver) {
                Expr::Ident(var_name) => {
                    match Lowerer_lookup_var_ast_type(self, var_name) {
                        OptType::Some(ast_ty) => {
                            var resolved: Type = Lowerer_resolve_type(self, ast_ty);
                            match resolved {
                                Type::Ref(inner_ref, _) => {
                                    resolved = lw_box_type_unbox(inner_ref);
                                }
                                _ => {}
                            }
                            match resolved {
                                Type::Generic(gname, _) => {
                                    mangled_name = gname + "_" + method;
                                }
                                Type::Named(nname) => {
                                    mangled_name = nname + "_" + method;
                                }
                                _ => {}
                            }
                        }
                        OptType::None => {}
                    }
                }
                _ => {}
            }
        }
    }
    return mangled_name;
}

// Helper: box struct elements before Vec push/insert/set
pub fn Lowerer_box_vec_element(self: &mut Lowerer, call_args: Vec<i64>, recv_ty: IrType, receiver: Box<Expr>) {
    var vec_elem_ty: IrType = IrType::I64;
    var found_elem: bool = false;
    var effective_recv_ty: IrType = recv_ty;
    match recv_ty {
        IrType::Ptr(inner) => { effective_recv_ty = box_ir_type_unbox(inner); }
        _ => {}
    }
    match effective_recv_ty {
        IrType::Generic(gname, gargs) => {
            if gname == "Vec" && gargs.len() > 0 {
                vec_elem_ty = gargs.get(0);
                found_elem = true;
            }
        }
        IrType::Opaque(oname) => {
            if oname == "Vec" {
                match lw_box_expr_unbox(receiver) {
                    Expr::Ident(vname) => {
                        match Lowerer_lookup_var_ast_type(self, vname) {
                            OptType::Some(at) => {
                                var inner_ty: Type = at;
                                match at {
                                    Type::Ref(inner, _) => { inner_ty = lw_box_type_unbox(inner); }
                                    _ => {}
                                }
                                match inner_ty {
                                    Type::Generic(an, aargs) => {
                                        if an == "Vec" && aargs.len() > 0 {
                                            vec_elem_ty = Lowerer_lower_type(self, aargs.get(0));
                                            found_elem = true;
                                        }
                                    }
                                    _ => {}
                                }
                            }
                            OptType::None => {}
                        }
                    }
                    _ => {}
                }
            }
        }
        _ => {}
    }
    if found_elem {
        match vec_elem_ty {
            IrType::Struct(_) => {
                Lowerer_box_struct_arg(self, call_args, vec_elem_ty);
            }
            _ => {}
        }
    } else {
        // Fallback: check the value's IR type directly
        var val_idx2: i64 = call_args.len() - 1;
        var val2: i64 = call_args.get(val_idx2);
        var val2_ty: IrType = Lowerer_get_value_type(self, val2);
        match val2_ty {
            IrType::Ptr(inner2) => {
                match box_ir_type_unbox(inner2) {
                    IrType::Struct(sname) => {
                        Lowerer_box_struct_arg(self, call_args, IrType::Struct(sname));
                    }
                    _ => {}
                }
            }
            _ => {}
        }
    }
}

// Helper: box a struct value at the last index of call_args
pub fn Lowerer_box_struct_arg(self: &mut Lowerer, call_args: Vec<i64>, struct_ty: IrType) {
    var val_idx: i64 = call_args.len() - 1;
    var val: i64 = call_args.get(val_idx);
    var size: i64 = IrModule_type_size(&self.module, struct_ty);
    if size <= 0 { size = 8; }
    var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(size, IrType::I64));
    var heap_ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", lw_c_vec1_i64(size_val), IrType::Ptr(Box::new(struct_ty)), EffectSet_new()));
    Lowerer_emit_inst(self, Inst::Store(heap_ptr, val, OptIrType::Some(struct_ty)));
    call_args.set(val_idx, heap_ptr);
}

// --- Lowerer_lower_expr helper functions ----------------------------------
// These are split out from Lowerer_lower_expr to avoid the statement-dropping
// bug that affects very long functions in the self-hosted compiler.

fn Lowerer_resolve_call_args(self: &mut Lowerer, callee: str, args: Vec<Expr>) -> Vec<Expr> {
    // Look up param names and defaults for this function
    var param_names: Vec<str> = Lowerer_lookup_param_names(self, callee);
    var defaults: Vec<Expr> = Lowerer_lookup_defaults(self, callee);
    var n_params: i64 = param_names.len();
    if n_params == 0 {
        // Unknown function — can't resolve, return as-is
        return args;
    }

    // Check if any args are named
    var has_named: bool = false;
    var ai: i64 = 0;
    while ai < args.len() {
        match args.get(ai) {
            Expr::NamedArg(_, _) => { has_named = true; }
            _ => {}
        }
        ai = ai + 1;
    }

    if !has_named {
        // No named args — fill in defaults for missing args
        if args.len() >= n_params {
            return args;
        }
        var result: Vec<Expr> = Vec::new();
        ai = 0;
        while ai < args.len() {
            result.push(args.get(ai));
            ai = ai + 1;
        }
        // Fill in defaults for remaining params
        ai = args.len();
        while ai < n_params {
            if ai < defaults.len() {
                result.push(defaults.get(ai));
            } else {
                result.push(Expr::IntLit(0));
            }
            ai = ai + 1;
        }
        return result;
    }

    // Named args present — resolve to positional order using param names
    // Build positional array — use a Vec<Expr> and a Vec<bool> to track filled slots
    var positional: Vec<Expr> = Vec::new();
    var filled: Vec<bool> = Vec::new();
    var pi: i64 = 0;
    while pi < n_params {
        positional.push(Expr::IntLit(0));
        filled.push(false);
        pi = pi + 1;
    }

    // Place positional args first, then named args by name
    var pos_idx: i64 = 0;
    ai = 0;
    while ai < args.len() {
        match args.get(ai) {
            Expr::NamedArg(name, e) => {
                // Find the param index by name
                var found_idx: i64 = -1;
                var ni: i64 = 0;
                while ni < n_params {
                    if param_names.get(ni) == name {
                        found_idx = ni;
                    }
                    ni = ni + 1;
                }
                if found_idx >= 0 {
                    positional.set(found_idx, lw_box_expr_unbox(e));
                    filled.set(found_idx, true);
                }
            }
            other => {
                if pos_idx < n_params {
                    positional.set(pos_idx, other);
                    filled.set(pos_idx, true);
                    pos_idx = pos_idx + 1;
                }
            }
        }
        ai = ai + 1;
    }

    // Build result — filled slots get their value, unfilled get defaults
    var result: Vec<Expr> = Vec::new();
    pi = 0;
    while pi < n_params {
        if filled.get(pi) {
            result.push(positional.get(pi));
        } else if pi < defaults.len() {
            result.push(defaults.get(pi));
        } else {
            result.push(Expr::IntLit(0));
        }
        pi = pi + 1;
    }
    return result;
}

fn Lowerer_lookup_defaults(self: &mut Lowerer, callee: str) -> Vec<Expr> {
    var result: Vec<Expr> = Vec::new();
    var fi: i64 = 0;
    while fi < self.func_defaults.len() {
        var entry: StringVecExprEntry = self.func_defaults.get(fi);
        if entry.key == callee {
            return entry.val;
        }
        fi = fi + 1;
    }
    return result;
}

fn Lowerer_lookup_param_names(self: &mut Lowerer, callee: str) -> Vec<str> {
    // Look up function param names from the func_param_names table
    var result: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < self.func_param_names.len() {
        var entry: StringVecStrEntry = self.func_param_names.get(fi);
        if entry.key == callee {
            return entry.val;
        }
        fi = fi + 1;
    }
    return result;
}

fn Lowerer_lower_call_expr(self: &mut Lowerer, callee: str, args: Vec<Expr>) -> i64 {
    // Resolve named arguments to positional order and fill in defaults
    var resolved_args: Vec<Expr> = Lowerer_resolve_call_args(self, callee, args);
    var arg_vals: Vec<i64> = Vec::new();
    var ai: i64 = 0;
    while ai < resolved_args.len() {
        arg_vals.push(Lowerer_lower_expr(self, resolved_args.get(ai)));
        ai = ai + 1;
    }

    if callee == "print" && arg_vals.len() > 0 {
        var arg_ty: IrType = Lowerer_get_value_type(self, arg_vals.get(0));
        return Lowerer_emit_inst(self, Inst::Print(arg_vals.get(0), arg_ty));
    }

    if callee == "println" && arg_vals.len() > 0 {
        var arg_ty: IrType = Lowerer_get_value_type(self, arg_vals.get(0));
        var _p1: i64 = Lowerer_emit_inst(self, Inst::Print(arg_vals.get(0), arg_ty));
        var newline: i64 = Lowerer_emit_inst(self, Inst::ConstStr("\n"));
        return Lowerer_emit_inst(self, Inst::Print(newline, lw_ptr_u8()));
    }

    if callee == "thread_id" || callee == "workgroup_size" || callee == "workgroup_id" || callee == "num_workgroups" {
        return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    }

    var is_local: bool = false;
    match Lowerer_lookup_local(self, callee) {
        OptValueId::Some(_) => { is_local = true; }
        OptValueId::None => {}
    }
    if !is_local {
        match Lowerer_lookup_alloca(self, callee) {
            OptValueId::Some(_) => { is_local = true; }
            OptValueId::None => {}
        }
    }
    if is_local {
        var fn_val: i64 = 0;
        match Lowerer_lookup_alloca(self, callee) {
            OptValueId::Some(alloca) => {
                var load_ty: IrType = IrType::I64;
                match Lowerer_lookup_alloca_type(self, alloca) {
                    OptIrType::Some(t) => { load_ty = t; }
                    OptIrType::None => {}
                }
                fn_val = Lowerer_emit_inst(self, Inst::Load(alloca, load_ty));
            }
            OptValueId::None => {
                match Lowerer_lookup_local(self, callee) {
                    OptValueId::Some(v) => { fn_val = v; }
                    OptValueId::None => { fn_val = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)); }
                }
            }
        }
        var ret_ty_local: IrType = IrType::I64;
        var eff_local: EffectSet = EffectSet_new();
        EffectSet_add(&mut eff_local, Effect::IO);
        return Lowerer_emit_inst(self, Inst::CallPtr(fn_val, arg_vals, ret_ty_local, eff_local, true));
    }

    var ret_ty: IrType = Lowerer_lookup_func_ret_ty_ir(self, callee);

    var eff: EffectSet = EffectSet_new();
    match runtime_effects(callee) {
        OptEffectSet::Some(e) => { eff = e; }
        OptEffectSet::None => {}
    }

    var call_args: Vec<i64> = Vec::new();
    var is_user_func: bool = Lowerer_is_user_func(self, callee);
    var is_runtime: bool = !is_user_func && (str_starts_with(callee, "p_") || str_starts_with(callee, "__ecs_"));
    if is_user_func && !is_runtime {
        call_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
    }
    ai = 0;
    while ai < arg_vals.len() {
        call_args.push(arg_vals.get(ai));
        ai = ai + 1;
    }

    if Lowerer_is_async_func(self, callee) {
        var call_val: i64 = Lowerer_emit_inst(self, Inst::Call(callee, call_args, ret_ty, eff));
        var wrap_args: Vec<i64> = Vec::new();
        wrap_args.push(call_val);
        return Lowerer_emit_inst(self, Inst::Call("p_future_ready", wrap_args, IrType::I64, EffectSet_new()));
    }

    match ret_ty {
        IrType::Struct(sname) => {
            var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct(sname), Lowerer_current_region(self)));
            var sret_args: Vec<i64> = Vec::new();
            sret_args.push(sret_ptr);
            var si: i64 = 0;
            while si < call_args.len() {
                sret_args.push(call_args.get(si));
                si = si + 1;
            }
            Lowerer_emit_inst(self, Inst::Call(callee, sret_args, IrType::Void, eff));
            return sret_ptr;
        }
        _ => {}
    }

    return Lowerer_emit_inst(self, Inst::Call(callee, call_args, ret_ty, eff));
}

fn Lowerer_lower_field_access_expr(self: &mut Lowerer, obj: Box<Expr>, field: str) -> i64 {
    var obj_expr: Expr = lw_box_expr_unbox(obj);
    var obj_val: i64 = Lowerer_lower_expr(self, obj_expr);
    var obj_ty: IrType = Lowerer_get_value_type(self, obj_val);

    var struct_name: str = "";
    match obj_ty {
        IrType::Struct(n) => { struct_name = n; }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(n2) => { struct_name = n2; }
                _ => {}
            }
        }
        _ => {}
    }
    if str_len(struct_name) == 0 {
        var inferred_ty: IrType = Lowerer_infer_expr_type(self, obj_expr);
        match inferred_ty {
            IrType::Struct(n) => { struct_name = n; }
            IrType::Ptr(inner) => {
                match box_ir_type_unbox(inner) {
                    IrType::Struct(n2) => { struct_name = n2; }
                    _ => {}
                }
            }
            _ => {}
        }
    }

    var field_idx: i64 = 0;
    var field_ty: IrType = IrType::I64;
    match IrModule_get_struct(&self.module, struct_name) {
        OptStructLayout::Some(layout) => {
            var fi: i64 = 0;
            while fi < layout.fields.len() {
                if layout.fields.get(fi).name == field {
                    field_idx = fi;
                    field_ty = layout.fields.get(fi).ty;
                }
                fi = fi + 1;
            }
        }
        OptStructLayout::None => {}
    }

    var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(obj_val, field_idx, field_ty));
    match field_ty {
        IrType::Struct(_) => { return field_ptr; }
        _ => {}
    }
    return Lowerer_emit_inst(self, Inst::Load(field_ptr, field_ty));
}

// The enum named by an IR type (`Struct(E)` or `Ptr(Struct(E))`), or "".
fn enum_name_of_ir_type(self: &Lowerer, t: IrType) -> str {
    var name: str = "";
    match t {
        IrType::Struct(n) => { name = n; }
        IrType::Ptr(inner) => {
            match box_ir_type_unbox(inner) {
                IrType::Struct(n2) => { name = n2; }
                _ => {}
            }
        }
        _ => {}
    }
    if name == "" { return ""; }
    match Lowerer_lookup_enum(self, name) {
        OptEnumDef::Some(_) => { return name; }
        OptEnumDef::None => {}
    }
    return "";
}

// The value of a branch is its trailing expression statement, if any.
fn if_branch_tail_expr(stmts: Vec<Stmt>) -> OptExpr {
    if stmts.len() == 0 { return OptExpr::None; }
    match stmts.get(stmts.len() - 1) {
        Stmt::Expr(e, _) => { return OptExpr::Some(e); }
        _ => {}
    }
    return OptExpr::None;
}

// if-expression: like src/lower.rs, each branch stores its value into a result
// slot allocated before the branch, and the merge block loads it. (The previous
// version jumped to a merge-block parameter that no jump ever filled, so the
// value of `val x = if c { a } else { b }` was always 0.)
fn Lowerer_lower_if_expr(self: &mut Lowerer, cond: Box<Expr>, then_block: Vec<Stmt>, else_block: OptStmts) -> i64 {
    var result_ty: IrType = IrType::Void;
    match if_branch_tail_expr(then_block) {
        OptExpr::Some(te) => { result_ty = Lowerer_infer_expr_type(self, te); }
        OptExpr::None => {
            match else_block {
                OptStmts::Some(es) => {
                    match if_branch_tail_expr(es) {
                        OptExpr::Some(ee) => { result_ty = Lowerer_infer_expr_type(self, ee); }
                        OptExpr::None => {}
                    }
                }
                OptStmts::None => {}
            }
        }
    }
    var has_value: bool = !ir_type_eq(result_ty, IrType::Void) && !ir_type_eq(result_ty, IrType::Never);
    var result_slot: i64 = 0;
    if has_value {
        result_slot = Lowerer_emit_inst(self, Inst::Alloca(result_ty, Lowerer_current_region(self)));
    }

    var cond_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(cond));
    var then_block_id: i64 = Lowerer_new_block(self);
    var else_block_id: i64 = Lowerer_new_block(self);
    var merge_block_id: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Branch(cond_val, then_block_id, else_block_id));

    var saved_allocas_len: i64 = self.allocas.len();
    var saved_alloca_types_len: i64 = self.alloca_types.len();
    var saved_var_ast_types_len: i64 = self.var_ast_types.len();
    var saved_locals_len: i64 = self.current_func.locals.len();

    Lowerer_set_current_block(self, then_block_id);
    var ti: i64 = 0;
    while ti < then_block.len() {
        match then_block.get(ti) {
            Stmt::Expr(e, _) => {
                var tv: i64 = Lowerer_lower_expr(self, e);
                if has_value && ti + 1 == then_block.len() && !Lowerer_current_block_has_terminator(self) {
                    Lowerer_emit_inst(self, Inst::Store(result_slot, tv, OptIrType::None));
                }
            }
            s => { Lowerer_lower_stmt(self, s); }
        }
        ti = ti + 1;
    }
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(merge_block_id));
    }
    self.allocas.truncate(saved_allocas_len);
    self.alloca_types.truncate(saved_alloca_types_len);
    self.var_ast_types.truncate(saved_var_ast_types_len);
    self.current_func.locals.truncate(saved_locals_len);

    Lowerer_set_current_block(self, else_block_id);
    match else_block {
        OptStmts::Some(else_stmts) => {
            var ei: i64 = 0;
            while ei < else_stmts.len() {
                match else_stmts.get(ei) {
                    Stmt::Expr(e2, _) => {
                        var ev: i64 = Lowerer_lower_expr(self, e2);
                        if has_value && ei + 1 == else_stmts.len() && !Lowerer_current_block_has_terminator(self) {
                            Lowerer_emit_inst(self, Inst::Store(result_slot, ev, OptIrType::None));
                        }
                    }
                    s2 => { Lowerer_lower_stmt(self, s2); }
                }
                ei = ei + 1;
            }
        }
        OptStmts::None => {}
    }
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(merge_block_id));
    }
    self.allocas.truncate(saved_allocas_len);
    self.alloca_types.truncate(saved_alloca_types_len);
    self.var_ast_types.truncate(saved_var_ast_types_len);
    self.current_func.locals.truncate(saved_locals_len);

    Lowerer_set_current_block(self, merge_block_id);
    if has_value {
        return Lowerer_emit_inst(self, Inst::Load(result_slot, result_ty));
    }
    return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
}

fn Lowerer_lower_match_expr(self: &mut Lowerer, e: Box<Expr>, arms: Vec<MatchArm>) -> i64 {
    var match_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
    var merge_block: i64 = Lowerer_new_block(self);
    var result_ty: IrType = Lowerer_infer_match_type(self, arms);
    // Each arm stores its value into a slot allocated before branching and the
    // merge block loads it (as src/lower.rs does). The previous version jumped
    // to a merge-block parameter that no jump ever filled.
    var has_value: bool = !ir_type_eq(result_ty, IrType::Void) && !ir_type_eq(result_ty, IrType::Never);
    var result_slot: i64 = 0;
    if has_value {
        result_slot = Lowerer_emit_inst(self, Inst::Alloca(result_ty, Lowerer_current_region(self)));
    }

    var i: i64 = 0;
    while i < arms.len() {
        var arm: MatchArm = arms.get(i);
        var arm_block: i64 = Lowerer_new_block(self);
        var next_block: i64 = Lowerer_new_block(self);

        var saved_allocas_len: i64 = self.allocas.len();
        var saved_alloca_types_len: i64 = self.alloca_types.len();
        var saved_var_ast_types_len: i64 = self.var_ast_types.len();
        var saved_locals_len: i64 = self.current_func.locals.len();

        match arm.pattern {
            Pattern::Wildcard => {
                Lowerer_emit_terminator(self, Inst::Jump(arm_block));
            }
            Pattern::IntLit(v) => {
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstInt(v, IrType::I64)), IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::BoolLit(v) => {
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstBool(v)), IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::Ident(name) => {
                Lowerer_bind_local(self, name, match_val);
                Lowerer_emit_terminator(self, Inst::Jump(arm_block));
            }
            Pattern::StrLit(s) => {
                var const_str: i64 = Lowerer_emit_inst(self, Inst::ConstStr(s));
                var dummy_env_se: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var str_eq_args: Vec<i64> = Vec::new();
                str_eq_args.push(dummy_env_se);
                str_eq_args.push(match_val);
                str_eq_args.push(const_str);
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_equal", str_eq_args, IrType::Bool, EffectSet_new()));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::Range(start_pat, end_pat) => {
                var lo: i64 = 0;
                var hi: i64 = 0;
                var range_ok: bool = false;
                match start_pat {
                    Pattern::IntLit(s) => { lo = s; match end_pat { Pattern::IntLit(e) => { hi = e; range_ok = true; } _ => {} } }
                    _ => {}
                }
                if range_ok {
                    var start_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(lo, IrType::I64));
                    var end_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(hi, IrType::I64));
                    var lo_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::LtEq, start_val, match_val, IrType::Bool));
                    var hi_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, match_val, end_val, IrType::Bool));
                    var in_range: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::And, lo_cmp, hi_cmp, IrType::Bool));
                    Lowerer_emit_terminator(self, Inst::Branch(in_range, arm_block, next_block));
                } else {
                    Lowerer_emit_terminator(self, Inst::Jump(next_block));
                }
            }
            Pattern::EnumVariant(enum_name, variant, bindings) => {
                var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, 0, IrType::I64));
                var tag_val: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));

                var variant_idx: i64 = 0;
                if str_len(enum_name) > 0 {
                    match Lowerer_lookup_enum(self, enum_name) {
                        OptEnumDef::Some(def) => {
                            var vi: i64 = 0;
                            while vi < def.variants.len() {
                                if def.variants.get(vi).name == variant {
                                    variant_idx = vi;
                                }
                                vi = vi + 1;
                            }
                        }
                        OptEnumDef::None => {}
                    }
                } else {
                    var ei: i64 = 0;
                    while ei < self.enums.len() {
                        var def2: EnumDef = self.enums.get(ei).val;
                        var vi: i64 = 0;
                        while vi < def2.variants.len() {
                            if def2.variants.get(vi).name == variant {
                                variant_idx = vi;
                            }
                            vi = vi + 1;
                        }
                        ei = ei + 1;
                    }
                }

                var expected: i64 = Lowerer_emit_inst(self, Inst::ConstInt(variant_idx, IrType::I64));
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag_val, expected, IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));

                Lowerer_set_current_block(self, arm_block);
                var binding_tys: Vec<IrType> = Lowerer_pattern_binding_ir_types(self, enum_name, variant, bindings);
                var binding_ast_tys: Vec<Type> = Lowerer_pattern_binding_ast_types(self, enum_name, variant, bindings);
                var field_idx: i64 = 1;
                var bi: i64 = 0;
                while bi < bindings.len() {
                    var binding: Binding = bindings.get(bi);
                    var field_ty: IrType = IrType::I64;
                    if bi < binding_tys.len() {
                        field_ty = binding_tys.get(bi);
                    }
                    var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, field_idx, field_ty));
                    var field_val: i64 = Lowerer_load_enum_field(self, field_ptr, field_ty);
                    Lowerer_bind_local(self, binding.name, field_val);
                    // Register AST type so infer_expr_type can recover
                    // generic element types (e.g. Vec<FieldInit>).
                    if bi < binding_ast_tys.len() {
                        Lowerer_insert_var_ast_type(self, binding.name, binding_ast_tys.get(bi));
                    }
                    field_idx = field_idx + Lowerer_enum_field_slots(self, field_ty);
                    bi = bi + 1;
                }

                var arm_result: i64 = 0;
                var arm_has_value: bool = false;
                var si: i64 = 0;
                while si < arm.body.len() {
                    match arm.body.get(si) {
                        Stmt::Expr(e2, _) => { arm_result = Lowerer_lower_expr(self, e2); arm_has_value = si + 1 == arm.body.len(); }
                        s => { Lowerer_lower_stmt(self, s); arm_has_value = false; }
                    }
                    si = si + 1;
                }
                if !Lowerer_current_block_has_terminator(self) {
                    if has_value && arm_has_value {
                        Lowerer_emit_inst(self, Inst::Store(result_slot, arm_result, OptIrType::None));
                    }
                    Lowerer_emit_terminator(self, Inst::Jump(merge_block));
                }
                self.allocas.truncate(saved_allocas_len);
                self.alloca_types.truncate(saved_alloca_types_len);
                self.var_ast_types.truncate(saved_var_ast_types_len);
                self.current_func.locals.truncate(saved_locals_len);
                Lowerer_set_current_block(self, next_block);
                i = i + 1;
                continue;
            }
        }

        Lowerer_set_current_block(self, arm_block);
        var arm_result: i64 = 0;
        var arm_has_value: bool = false;
        var si: i64 = 0;
        while si < arm.body.len() {
            match arm.body.get(si) {
                Stmt::Expr(e2, _) => { arm_result = Lowerer_lower_expr(self, e2); arm_has_value = si + 1 == arm.body.len(); }
                s => { Lowerer_lower_stmt(self, s); arm_has_value = false; }
            }
            si = si + 1;
        }
        if !Lowerer_current_block_has_terminator(self) {
            if has_value && arm_has_value {
                Lowerer_emit_inst(self, Inst::Store(result_slot, arm_result, OptIrType::None));
            }
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));
        }
        self.allocas.truncate(saved_allocas_len);
        self.alloca_types.truncate(saved_alloca_types_len);
        self.var_ast_types.truncate(saved_var_ast_types_len);
        self.current_func.locals.truncate(saved_locals_len);

        Lowerer_set_current_block(self, next_block);
        i = i + 1;
    }

    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(merge_block));
    }

    Lowerer_set_current_block(self, merge_block);
    if has_value {
        return Lowerer_emit_inst(self, Inst::Load(result_slot, result_ty));
    }
    return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
}

fn Lowerer_lower_try_expr(self: &mut Lowerer, e: Box<Expr>) -> i64 {
    var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));

    var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 0, IrType::I64));
    var tag: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));

    var ok_block: i64 = Lowerer_new_block(self);
    var err_block: i64 = Lowerer_new_block(self);
    var merge_block: i64 = Lowerer_new_block(self);

    var zero_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var is_ok: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag, zero_val, IrType::Bool));

    Lowerer_emit_terminator(self, Inst::Branch(is_ok, ok_block, err_block));

    Lowerer_set_current_block(self, ok_block);
    Lowerer_emit_terminator(self, Inst::Jump(merge_block));

    Lowerer_set_current_block(self, err_block);
    if self.try_stack.len() > 0 {
        var ctx: TryContext = self.try_stack.get(self.try_stack.len() - 1);
        var try_err_block: i64 = ctx.error_block;
        var try_err_slot: i64 = ctx.error_result_slot;

        var src_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 0, IrType::I64));
        var src_tag: i64 = Lowerer_emit_inst(self, Inst::Load(src_tag_ptr, IrType::I64));
        var dst_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(try_err_slot, 0, IrType::I64));
        Lowerer_emit_inst(self, Inst::Store(dst_tag_ptr, src_tag, OptIrType::None));

        var src_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 1, IrType::I64));
        var src_val: i64 = Lowerer_emit_inst(self, Inst::Load(src_val_ptr, IrType::I64));
        var dst_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(try_err_slot, 1, IrType::I64));
        Lowerer_emit_inst(self, Inst::Store(dst_val_ptr, src_val, OptIrType::None));

        Lowerer_emit_terminator(self, Inst::Jump(try_err_block));
    } else {
        Lowerer_emit_drops(self);
        Lowerer_emit_defers(self);
        match self.current_sret {
            OptValueId::Some(_) => {
                Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
            }
            OptValueId::None => {
                Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(val)));
            }
        }
    }

    Lowerer_set_current_block(self, merge_block);
    var val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 1, IrType::I64));
    return Lowerer_emit_inst(self, Inst::Load(val_ptr, IrType::I64));
}

fn Lowerer_lower_try_block_expr(self: &mut Lowerer, stmts: Vec<Stmt>) -> i64 {
    var err_slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct("Result"), Lowerer_current_region(self)));
    var result_slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct("Result"), Lowerer_current_region(self)));

    var err_block: i64 = Lowerer_new_block(self);
    var cont_block: i64 = Lowerer_new_block(self);

    self.try_stack.push(TryContext_new(err_block, err_slot));

    var last_val: i64 = 0;
    var has_last: bool = false;
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Expr(e, _) => {
                last_val = Lowerer_lower_expr(self, e);
                has_last = true;
            }
            s => {
                Lowerer_lower_stmt(self, s);
                has_last = false;
            }
        }
        i = i + 1;
    }

    self.try_stack.pop();

    var ok_val: i64 = 0;
    if has_last {
        ok_val = last_val;
    } else {
        ok_val = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    }

    var ok_tag: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(result_slot, 0, IrType::I64));
    var _s1: i64 = Lowerer_emit_inst(self, Inst::Store(tag_ptr, ok_tag, OptIrType::None));
    var val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(result_slot, 1, IrType::I64));
    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(val_ptr, ok_val, OptIrType::None));
    Lowerer_emit_terminator(self, Inst::Jump(cont_block));

    Lowerer_set_current_block(self, err_block);
    var err_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(err_slot, 0, IrType::I64));
    var err_tag: i64 = Lowerer_emit_inst(self, Inst::Load(err_tag_ptr, IrType::I64));
    var out_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(result_slot, 0, IrType::I64));
    var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(out_tag_ptr, err_tag, OptIrType::None));
    var err_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(err_slot, 1, IrType::I64));
    var err_val: i64 = Lowerer_emit_inst(self, Inst::Load(err_val_ptr, IrType::I64));
    var out_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(result_slot, 1, IrType::I64));
    var _s4: i64 = Lowerer_emit_inst(self, Inst::Store(out_val_ptr, err_val, OptIrType::None));
    Lowerer_emit_terminator(self, Inst::Jump(cont_block));

    Lowerer_set_current_block(self, cont_block);
    return result_slot;
}

fn Lowerer_lower_closure_expr(self: &mut Lowerer, params: Vec<Param>, body: Vec<Stmt>, ret_ty: OptType) -> i64 {
    var closure_id: i64 = self.module.functions.len();
    var closure_name: str = str_concat("__closure_", int_to_str(closure_id));

    var param_names: Vec<str> = Vec::new();
    var pi: i64 = 0;
    while pi < params.len() {
        param_names.push(params.get(pi).name);
        pi = pi + 1;
    }
    var captures: Vec<StringTypeEntry> = Lowerer_find_captures(self, body, param_names);

    var saved_captures: Vec<ClosureCapture> = self.current_captures;
    var empty_captures: Vec<ClosureCapture> = Vec::new();
    self.current_captures = empty_captures;
    var ci: i64 = 0;
    while ci < captures.len() {
        var cap: StringTypeEntry = captures.get(ci);
        self.current_captures.push(ClosureCapture_new(cap.key, ci + 1, cap.val));
        ci = ci + 1;
    }

    var inferred_ret_ty: Type = Type::I64;
    match ret_ty {
        OptType::Some(rt) => { inferred_ret_ty = rt; }
        OptType::None => { inferred_ret_ty = Type::I64; }
    }

    var closure_func: Func = Func_new_full(closure_name, params, inferred_ret_ty, body, false);

    var saved_func: IrFunction = self.current_func;
    var saved_has_func: bool = self.has_current_func;
    var saved_allocas: Vec<StringValueIdEntry> = self.allocas;
    var saved_alloca_types: Vec<I64IrTypeEntry> = self.alloca_types;
    var saved_var_ast_types: Vec<StringTypeEntry> = self.var_ast_types;
    var saved_block: i64 = self.current_block;
    var saved_sret: OptValueId = self.current_sret;

    Lowerer_lower_func(self, closure_func);

    self.current_func = saved_func;
    self.has_current_func = saved_has_func;
    self.allocas = saved_allocas;
    self.alloca_types = saved_alloca_types;
    self.var_ast_types = saved_var_ast_types;
    self.current_block = saved_block;
    self.current_sret = saved_sret;
    self.current_captures = saved_captures;

    return Lowerer_make_fn_env(self, closure_name, captures);
}

fn Lowerer_lower_struct_lit_expr(self: &mut Lowerer, name: str, fields: Vec<FieldInit>, spread: OptBoxExpr) -> i64 {
    var struct_ty: IrType = IrType::Struct(name);
    var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(struct_ty, Lowerer_current_region(self)));

    var fi: i64 = 0;
    while fi < fields.len() {
        var field_init: FieldInit = fields.get(fi);
        var field_val: i64 = Lowerer_lower_expr(self, field_init.value);

        var field_idx: i64 = fi;
        var field_ty: IrType = IrType::I64;
        match IrModule_get_struct(&self.module, name) {
            OptStructLayout::Some(layout) => {
                var fj: i64 = 0;
                while fj < layout.fields.len() {
                    if layout.fields.get(fj).name == field_init.name {
                        field_idx = fj;
                        field_ty = layout.fields.get(fj).ty;
                    }
                    fj = fj + 1;
                }
            }
            OptStructLayout::None => {}
        }

        var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, field_idx, field_ty));
        match field_ty {
            IrType::Struct(field_struct_name) => {
                Lowerer_emit_struct_copy(self, field_val, field_ptr, field_struct_name);
            }
            _ => {
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, field_val, OptIrType::None));
            }
        }
        fi = fi + 1;
    }

    return alloca;
}

fn Lowerer_lower_fstring_expr(self: &mut Lowerer, parts: Vec<FStringPart>) -> i64 {
    var result: i64 = Lowerer_emit_inst(self, Inst::ConstStr(""));
    var i: i64 = 0;
    while i < parts.len() {
        match parts.get(i) {
            FStringPart::Literal(s) => {
                var s_val: i64 = Lowerer_emit_inst(self, Inst::ConstStr(s));
                var args: Vec<i64> = Vec::new();
                args.push(result);
                args.push(s_val);
                result = Lowerer_emit_inst(self, Inst::Call("p_str_concat", args, lw_ptr_u8(), EffectSet_new()));
            }
            FStringPart::Expr(e) => {
                var e_val: i64 = Lowerer_lower_expr(self, e);
                var e_ty: IrType = Lowerer_get_value_type(self, e_val);
                var str_val: i64 = 0;
                var is_ptr: bool = false;
                match e_ty {
                    IrType::Ptr(_) => {
                        str_val = e_val;
                        is_ptr = true;
                    }
                    _ => {}
                }
                if !is_ptr {
                    if ir_type_eq(e_ty, IrType::F64) {
                        var conv_args: Vec<i64> = Vec::new();
                        conv_args.push(e_val);
                        str_val = Lowerer_emit_inst(self, Inst::Call("p_float_to_str", conv_args, lw_ptr_u8(), EffectSet_new()));
                    } else if ir_type_eq(e_ty, IrType::Bool) {
                        var conv_args: Vec<i64> = Vec::new();
                        conv_args.push(e_val);
                        str_val = Lowerer_emit_inst(self, Inst::Call("p_bool_to_str", conv_args, lw_ptr_u8(), EffectSet_new()));
                    } else if ir_type_is_opaque_named(e_ty, "Vec") {
                        var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                        var vec_args: Vec<i64> = Vec::new();
                        vec_args.push(dummy_env);
                        vec_args.push(e_val);
                        str_val = Lowerer_emit_inst(self, Inst::Call("Vec_to_str", vec_args, lw_ptr_u8(), EffectSet_new()));
                    } else {
                        var conv_args: Vec<i64> = Vec::new();
                        conv_args.push(e_val);
                        str_val = Lowerer_emit_inst(self, Inst::Call("p_to_str", conv_args, lw_ptr_u8(), EffectSet_new()));
                    }
                }
                var concat_args: Vec<i64> = Vec::new();
                concat_args.push(result);
                concat_args.push(str_val);
                result = Lowerer_emit_inst(self, Inst::Call("p_str_concat", concat_args, lw_ptr_u8(), EffectSet_new()));
            }
        }
        i = i + 1;
    }
    return result;
}

pub fn Lowerer_lower_expr(self: &mut Lowerer, expr: Expr) -> i64 {
    match expr {
        Expr::IntLit(n) => {
            return Lowerer_emit_inst(self, Inst::ConstInt(n, IrType::I64));
        }
        Expr::FloatLit(f) => {
            // ConstFloat now stores the f64 value directly
            return Lowerer_emit_inst(self, Inst::ConstFloat(f, IrType::F64));
        }
        Expr::BoolLit(b) => {
            return Lowerer_emit_inst(self, Inst::ConstBool(b));
        }
        Expr::StringLit(s) => {
            // Intern the string
            var _label: str = IrModule_intern_string(&mut self.module, s);
            return Lowerer_emit_inst(self, Inst::ConstStr(s));
        }
        Expr::Ident(name) => {
            // Check if this is a captured variable in a closure
            var ci: i64 = 0;
            while ci < self.current_captures.len() {
                if self.current_captures.get(ci).name == name {
                    var idx: i64 = self.current_captures.get(ci).field_index;
                    var cap_ir_ty: IrType = Lowerer_lower_type(self, self.current_captures.get(ci).ty);
                    // Load from env struct: env_ptr is the first param
                    if self.current_func.params.len() > 0 {
                        var env_val: i64 = self.current_func.params.get(0).id;
                        var idx_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(idx, IrType::I64));
                        var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(env_val, idx_val, IrType::I64));
                        return Lowerer_emit_inst(self, Inst::Load(elem_ptr, cap_ir_ty));
                    }
                }
                ci = ci + 1;
            }

            // Check if mutable variable with alloca
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(alloca) => {
                    var load_ty: IrType = IrType::I64;
                    match Lowerer_lookup_alloca_type(self, alloca) {
                        OptIrType::Some(t) => { load_ty = t; }
                        OptIrType::None => { load_ty = IrType::I64; }
                    }
                    // Gap 3 fix: If the alloca holds a struct pointer (SRET case),
                    // load the pointer.
                    match load_ty {
                        IrType::Ptr(inner) => {
                            match box_ir_type_unbox(inner) {
                                IrType::Struct(_) => {
                                    return Lowerer_emit_inst(self, Inst::Load(alloca, load_ty));
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                    // Gap 3 fix: If the alloca holds an inline struct, return
                    // the alloca pointer directly - the alloca IS the struct
                    // data, so the pointer to it is the struct value.
                    match load_ty {
                        IrType::Struct(_) => { return alloca; }
                        _ => {}
                    }
                    return Lowerer_emit_inst(self, Inst::Load(alloca, load_ty));
                }
                OptValueId::None => {}
            }

            // Check if local variable
            match Lowerer_lookup_local(self, name) {
                OptValueId::Some(local_val) => { return local_val; }
                OptValueId::None => {}
            }

            // Check if constant (pc)
            match Lowerer_lookup_constant(self, name) {
                OptExpr::Some(const_expr) => { return Lowerer_lower_expr(self, const_expr); }
                OptExpr::None => {}
            }

            // Check if module-level mutable global
            match IrModule_get_global(&self.module, name) {
                OptGlobalLookup::Some(ir_ty, _init) => {
                    var addr: i64 = Lowerer_emit_inst(self, Inst::GlobalAddr(name, ir_ty));
                    // For struct/enum types, the GlobalAddr already gives a
                    // pointer to the struct. Return it directly without a Load
                    // (matching the pattern for struct locals above).
                    match ir_ty {
                        IrType::Struct(_) => { return addr; }
                        _ => {}
                    }
                    return Lowerer_emit_inst(self, Inst::Load(addr, ir_ty));
                }
                OptGlobalLookup::None => {}
            }

            // A function name used as a value: a closure env holding the
            // function reference (as in src/lower.rs). Previously this fell
            // through to the zero fallback, so `apply(twice, 21)` passed 0.
            var is_fn: bool = false;
            match IrModule_get_function(&self.module, name) {
                OptIrFunction::Some(_) => { is_fn = true; }
                OptIrFunction::None => {}
            }
            var xi: i64 = 0;
            while !is_fn && xi < self.module.extern_functions.len() {
                if self.module.extern_functions.get(xi).name == name { is_fn = true; }
                xi = xi + 1;
            }
            if is_fn {
                var no_captures: Vec<StringTypeEntry> = Vec::new();
                return Lowerer_make_fn_env(self, name, no_captures);
            }
            // Unknown - emit zero
            return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        }
        Expr::Binary(op, left, right) => {
            var left_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(left));
            var right_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(right));
            var result_ty: IrType = Lowerer_infer_binop_type(self, op, lw_box_expr_unbox(left), lw_box_expr_unbox(right));

            // String concatenation: str + str - p_str_concat
            var left_ir_ty: IrType = Lowerer_get_value_type(self, left_val);
            var right_ir_ty: IrType = Lowerer_get_value_type(self, right_val);
            if binop_eq(op, BinOp::Add) && ir_type_eq(left_ir_ty, lw_ptr_u8()) && ir_type_eq(right_ir_ty, lw_ptr_u8()) {
                var args: Vec<i64> = Vec::new();
                args.push(left_val);
                args.push(right_val);
                var eff: EffectSet = EffectSet_new();
                EffectSet_add(&mut eff, Effect::Alloc);
                return Lowerer_emit_inst(self, Inst::Call("p_str_concat", args, lw_ptr_u8(), eff));
            }

            // String equality: str == str - p_str_equal. R1.1: either side
            // being str suffices (the typechecker forces both operands to the
            // same type); the other side may carry an erased i64 IR type
            // (Vec<str>.get(), enum payloads, fields), so also consult the
            // AST-level inference. p_str_equal checks identity and null first.
            var is_str_cmp: bool = false;
            if binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) {
                is_str_cmp = ir_type_eq(left_ir_ty, ptr_u8()) || ir_type_eq(right_ir_ty, ptr_u8())
                    || ir_type_eq(Lowerer_infer_expr_type(self, box_expr_unbox(left)), ptr_u8())
                    || ir_type_eq(Lowerer_infer_expr_type(self, box_expr_unbox(right)), ptr_u8());
            }
            // R1.2: `==` / `!=` on enum values call the synthesized
            // `__eq_<Enum>` (tag + payload) instead of comparing pointers.
            if !is_str_cmp && (binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq)) {
                var eq_enum: str = enum_name_of_ir_type(self, left_ir_ty);
                if eq_enum == "" { eq_enum = enum_name_of_ir_type(self, right_ir_ty); }
                if eq_enum == "" { eq_enum = enum_name_of_ir_type(self, Lowerer_infer_expr_type(self, box_expr_unbox(left))); }
                if eq_enum == "" { eq_enum = enum_name_of_ir_type(self, Lowerer_infer_expr_type(self, box_expr_unbox(right))); }
                if eq_enum != "" {
                    var eq_fn: str = "__eq_" + eq_enum;
                    var has_eq_fn: bool = false;
                    match IrModule_get_function(&self.module, eq_fn) {
                        OptIrFunction::Some(_) => { has_eq_fn = true; }
                        OptIrFunction::None => {}
                    }
                    if has_eq_fn {
                        var enum_eq_args: Vec<i64> = Vec::new();
                        enum_eq_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));
                        enum_eq_args.push(left_val);
                        enum_eq_args.push(right_val);
                        var enum_eq_val: i64 = Lowerer_emit_inst(self, Inst::Call(eq_fn, enum_eq_args, IrType::Bool, EffectSet_new()));
                        if binop_eq(op, BinOp::Neq) {
                            return Lowerer_emit_inst(self, Inst::UnaryOp(UnaryOp::Not, enum_eq_val, IrType::Bool));
                        }
                        return enum_eq_val;
                    }
                }
            }
            if is_str_cmp {
                var dummy_env_eq: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var args: Vec<i64> = Vec::new();
                args.push(dummy_env_eq);
                args.push(left_val);
                args.push(right_val);
                var eq_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_equal", args, IrType::Bool, EffectSet_new()));
                if binop_eq(op, BinOp::Neq) {
                    return Lowerer_emit_inst(self, Inst::UnaryOp(UnaryOp::Not, eq_val, IrType::Bool));
                }
                return eq_val;
            }

            return Lowerer_emit_inst(self, Inst::BinOp(op, left_val, right_val, result_ty));
        }
        Expr::Unary(op, e) => {
            var operand: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            var result_ty: IrType = Lowerer_infer_unary_type(self, op, lw_box_expr_unbox(e));
            return Lowerer_emit_inst(self, Inst::UnaryOp(op, operand, result_ty));
        }
        Expr::Call(callee, args) => {
            return Lowerer_lower_call_expr(self, callee, args);
        }
        Expr::MethodCall(receiver, method, args) => {
            return Lowerer_lower_method_call(self, receiver, method, args);
        }
        Expr::FieldAccess(obj, field) => {
            return Lowerer_lower_field_access_expr(self, obj, field);
        }
        Expr::Index(arr, idx) => {
            var arr_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(arr));
            var idx_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(idx));
            var arr_ty: IrType = Lowerer_get_value_type(self, arr_val);

            // Vec indexing: Vec_get(vec, idx)
            if ir_type_is_opaque_named(arr_ty, "Vec") || ir_type_eq(arr_ty, IrType::I64) {
                // Determine element type for correct return type (word_repr for structs)
                var vec_elem_ty: IrType = IrType::I64;
                match arr_ty {
                    IrType::Generic(gname, gargs) => {
                        if gname == "Vec" && gargs.len() > 0 {
                            vec_elem_ty = gargs.get(0);
                        }
                    }
                    IrType::Opaque(_) => {
                        // Try AST type for generic info
                        match lw_box_expr_unbox(arr) {
                            Expr::Ident(vname) => {
                                match Lowerer_lookup_var_ast_type(self, vname) {
                                    OptType::Some(at) => {
                                        var inner_ty: Type = at;
                                        match at {
                                            Type::Ref(inner, _) => { inner_ty = lw_box_type_unbox(inner); }
                                            _ => {}
                                        }
                                        match inner_ty {
                                            Type::Generic(an, aargs) => {
                                                if an == "Vec" && aargs.len() > 0 {
                                                    vec_elem_ty = Lowerer_lower_type(self, aargs.get(0));
                                                }
                                            }
                                            _ => {}
                                        }
                                    }
                                    OptType::None => {}
                                }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                var args: Vec<i64> = Vec::new();
                args.push(arr_val);
                args.push(idx_val);
                var ret_ty: IrType = word_repr(vec_elem_ty);
                return Lowerer_emit_inst(self, Inst::Call("p_vec_get", args, ret_ty, EffectSet_new()));
            }

            // Array indexing: GetElemPtr + Load
            var elem_ty: IrType = IrType::I64;
            match arr_ty {
                IrType::Array(inner, _) => { elem_ty = box_ir_type_unbox(inner); }
                IrType::Ptr(inner2) => {
                    match box_ir_type_unbox(inner2) {
                        IrType::Array(inner3, _) => { elem_ty = box_ir_type_unbox(inner3); }
                        _ => {}
                    }
                }
                _ => {}
            }
            var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(arr_val, idx_val, elem_ty));
            return Lowerer_emit_inst(self, Inst::Load(elem_ptr, elem_ty));
        }
        Expr::StructLit(name, fields, spread) => {
            return Lowerer_lower_struct_lit_expr(self, name, fields, spread);
        }
        Expr::If(cond, then_block, else_block) => {
            return Lowerer_lower_if_expr(self, cond, then_block, else_block);
        }
        Expr::Block(stmts) => {
            var result: i64 = 0;
            var i: i64 = 0;
            while i < stmts.len() {
                match stmts.get(i) {
                    Stmt::Expr(e, _) => { result = Lowerer_lower_expr(self, e); }
                    s => { Lowerer_lower_stmt(self, s); }
                }
                i = i + 1;
            }
            if result == 0 {
                result = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            }
            return result;
        }
        Expr::Cast(e, ty) => {
            // Casting to a trait object (dyn Trait) creates a Dyn value
            match ty {
                Type::Dyn(trait_name) => {
                    var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
                    var src_ir_ty: IrType = Lowerer_get_value_type(self, val);
                    var type_name: str = "Unknown";
                    match src_ir_ty {
                        IrType::Struct(n) => { type_name = n; }
                        IrType::Ptr(inner) => {
                            match box_ir_type_unbox(inner) {
                                IrType::Struct(n) => { type_name = n; }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                    return Lowerer_emit_inst(self, Inst::MakeDyn(val, type_name, trait_name));
                }
                _ => {}
            }
            var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            var src_ty: IrType = Lowerer_get_value_type(self, val);
            var dst_ty: IrType = Lowerer_lower_type(self, ty);
            return Lowerer_lower_cast(self, val, src_ty, dst_ty);
        }
        Expr::TupleLit(elements) => {
            // Allocate a tuple struct on stack
            var n: i64 = elements.len();
            var tuple_ty: IrType = IrType::Opaque("tuple");
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(tuple_ty, Lowerer_current_region(self)));

            // Store each element at offset i*8
            var i: i64 = 0;
            while i < n {
                var elem_val: i64 = Lowerer_lower_expr(self, elements.get(i));
                var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, i, IrType::I64));
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(elem_ptr, elem_val, OptIrType::None));
                i = i + 1;
            }

            return alloca;
        }
        Expr::Range(start, end, inclusive) => {
            // Range expression - used in for loops, handled there
            var start_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(start));
            return start_val;
        }
        Expr::Ref(e, is_mut) => {
            // Take a reference - for alloca variables, return the alloca pointer.
            // For SRET struct allocas, load the stored struct pointer (avoid
            // double indirection). For all other expressions, create an alloca,
            // store the value, and return the pointer.
            match lw_box_expr_unbox(e) {
                Expr::Ident(name) => {
                    match Lowerer_lookup_alloca(self, name) {
                        OptValueId::Some(alloca) => {
                            // If the variable holds a pointer to a struct (SRET return),
                            // the alloca stores the struct pointer. &var should return
                            // the struct pointer (loaded from alloca), not the alloca
                            // address - otherwise we get an extra level of indirection.
                            match Lowerer_lookup_alloca_type(self, alloca) {
                                OptIrType::Some(alloca_ty) => {
                                    match alloca_ty {
                                        IrType::Ptr(inner) => {
                                            match box_ir_type_unbox(inner) {
                                                IrType::Struct(_) => {
                                                    return Lowerer_emit_inst(self, Inst::Load(alloca, alloca_ty));
                                                }
                                                _ => {}
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                                OptIrType::None => {}
                            }
                            return alloca;
                        }
                        OptValueId::None => {}
                    }
                }
                _ => {}
            }
            // Otherwise: lower the expression, alloca, store, return pointer.
            var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            var val_ty: IrType = Lowerer_get_value_type(self, val);
            // If the expression already evaluates to a pointer to a struct
            // (e.g. from a FieldAccess on a &mut parameter), the value IS
            // the pointer to the struct storage. &mut of this should return
            // it directly - wrapping it in another alloca creates a double
            // indirection (**struct instead of *struct) that breaks field
            // access through the mutable reference.
            match val_ty {
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(_) => { return val; }
                        _ => {}
                    }
                }
                _ => {}
            }
            var ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(val_ty, Lowerer_current_region(self)));
            Lowerer_emit_inst(self, Inst::Store(ptr, val, OptIrType::None));
            return ptr;
        }
        Expr::Deref(e) => {
            var ptr_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            var ptr_ty: IrType = Lowerer_get_value_type(self, ptr_val);
            // Load through the pointer
            var load_ty: IrType = IrType::I64;
            match ptr_ty {
                IrType::Ptr(inner) => { load_ty = box_ir_type_unbox(inner); }
                _ => {}
            }
            return Lowerer_emit_inst(self, Inst::Load(ptr_val, load_ty));
        }
        Expr::StrConcat(left, right) => {
            var left_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(left));
            var right_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(right));
            var args: Vec<i64> = Vec::new();
            args.push(left_val);
            args.push(right_val);
            var eff: EffectSet = EffectSet_new();
            EffectSet_add(&mut eff, Effect::Alloc);
            return Lowerer_emit_inst(self, Inst::Call("p_str_concat", args, lw_ptr_u8(), eff));
        }
        Expr::EnumLit(enum_name, variant, args) => {
            // Allocate enum struct on stack
            var enum_ty: IrType = IrType::Struct(enum_name);
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(enum_ty, Lowerer_current_region(self)));

            // Store tag at offset 0
            var tag_idx: i64 = 0;
            // Also collect declared field types to determine inline storage
            var declared_field_tys: Vec<Type> = Vec::new();
            // Collect enum type params so we can detect type-param payloads
            var enum_type_params: Vec<str> = Vec::new();
            match Lowerer_lookup_enum(self, enum_name) {
                OptEnumDef::Some(def) => {
                    enum_type_params = def.type_params;
                    var vi: i64 = 0;
                    while vi < def.variants.len() {
                        if def.variants.get(vi).name == variant {
                            tag_idx = vi;
                            match def.variants.get(vi).data {
                                OptParams::Some(params) => {
                                    var pi: i64 = 0;
                                    while pi < params.len() {
                                        declared_field_tys.push(params.get(pi).ty);
                                        pi = pi + 1;
                                    }
                                }
                                OptParams::None => {}
                            }
                        }
                        vi = vi + 1;
                    }
                }
                OptEnumDef::None => {}
            }

            var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, 0, IrType::I64));
            var tag_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(tag_idx, IrType::I64));
            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(tag_ptr, tag_val, OptIrType::None));

            // Store payload data at offsets 1..n
            // CRITICAL: struct/enum-typed fields must be stored INLINE (copied
            // from the arg's alloca) to avoid dangling pointers when the
            // creating function returns (C codegen uses stack alloca).
            // Box<T> fields are already pointers and stay as pointers.
            // We look at the DECLARED field type to distinguish.
            // NOTE: Type parameters (e.g. T in Option<T>) are NOT inline
            // structs — they are word-sized values (i64/ptr) at runtime.
            var field_idx: i64 = 1;
            var ai: i64 = 0;
            while ai < args.len() {
                var arg_val: i64 = Lowerer_lower_expr(self, args.get(ai));
                var arg_ty: IrType = Lowerer_get_value_type(self, arg_val);

                // Check the declared field type to determine if this field
                // should be stored inline (struct/enum) or as a pointer.
                var is_inline_struct: bool = false;
                var declared_ir_ty: IrType = IrType::I64;
                if ai < declared_field_tys.len() {
                    var declared_ast_ty: Type = declared_field_tys.get(ai);
                    // Check if the declared type is a type parameter of this enum.
                    // Type params are word-sized at runtime, not inline structs.
                    var is_type_param: bool = false;
                    match declared_ast_ty {
                        Type::Named(n) => {
                            var tpi: i64 = 0;
                            while tpi < enum_type_params.len() {
                                if enum_type_params.get(tpi) == n {
                                    is_type_param = true;
                                    tpi = enum_type_params.len();
                                }
                                tpi = tpi + 1;
                            }
                        }
                        _ => {}
                    }
                    if is_type_param {
                        // Type parameter: treat as word-sized value, not inline struct
                        declared_ir_ty = word_repr(arg_ty);
                    } else {
                        declared_ir_ty = Lowerer_lower_type(self, declared_ast_ty);
                        match declared_ir_ty {
                            IrType::Struct(_) => { is_inline_struct = true; }
                            _ => { is_inline_struct = false; }
                        }
                    }
                }

                // Determine how many 8-byte slots this field occupies.
                var field_slots: i64 = 1;
                if is_inline_struct {
                    field_slots = Lowerer_enum_field_slots(self, declared_ir_ty);
                }

                if is_inline_struct {
                    // Struct/enum-typed field: copy data inline from the
                    // arg's alloca into the parent enum's data slots.
                    // We use a single memcpy (Inst::Store with store_ty) to
                    // copy the full struct data into the enum's inline slots.
                    var dst_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, field_idx, IrType::I64));
                    var struct_name: str = "";
                    match declared_ir_ty {
                        IrType::Struct(n) => { struct_name = n; }
                        _ => {}
                    }
                    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(dst_ptr, arg_val, OptIrType::Some(IrType::Struct(struct_name))));
                } else {
                    // Non-struct field (Box/Ptr/Vec/str/scalar): store the
                    // value (which is already a pointer or scalar) directly.
                    var data_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, field_idx, arg_ty));
                    var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(data_ptr, arg_val, OptIrType::None));
                }

                field_idx = field_idx + field_slots;
                ai = ai + 1;
            }

            return alloca;
        }
        Expr::Match(e, arms) => {
            return Lowerer_lower_match_expr(self, e, arms);
        }
        Expr::Try(e) => {
            return Lowerer_lower_try_expr(self, e);
        }
        Expr::Coalesce(left, right) => {
            // a ?? b - if a is not null, return a, else return b
            var left_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(left));
            var null_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Neq, left_val, null_val, IrType::Bool));

            var then_block: i64 = Lowerer_new_block(self);
            var else_block: i64 = Lowerer_new_block(self);
            var merge_block: i64 = Lowerer_new_block(self);

            Lowerer_emit_terminator(self, Inst::Branch(cmp_val, then_block, else_block));

            Lowerer_set_current_block(self, then_block);
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(merge_block));
            }

            Lowerer_set_current_block(self, else_block);
            var right_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(right));
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(merge_block));
            }

            Lowerer_set_current_block(self, merge_block);
            var result_val: i64 = Lowerer_add_block_param(self, merge_block, IrType::I64);
            return result_val;
        }
        Expr::IsCheck(e, variant) => {
            // Check if enum value is of a specific variant
            var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            // Load tag from offset 0
            var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 0, IrType::I64));
            var tag_val: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));
            // Find variant index by searching all enums
            var variant_idx: i64 = 0;
            var ei: i64 = 0;
            while ei < self.enums.len() {
                var def: EnumDef = self.enums.get(ei).val;
                var vi: i64 = 0;
                while vi < def.variants.len() {
                    if def.variants.get(vi).name == variant {
                        variant_idx = vi;
                    }
                    vi = vi + 1;
                }
                ei = ei + 1;
            }
            var expected: i64 = Lowerer_emit_inst(self, Inst::ConstInt(variant_idx, IrType::I64));
            return Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag_val, expected, IrType::Bool));
        }
        Expr::TryBlock(stmts) => {
            return Lowerer_lower_try_block_expr(self, stmts);
        }
        Expr::Closure(params, body, ret_ty) => {
            return Lowerer_lower_closure_expr(self, params, body, ret_ty);
        }
        Expr::OptionalFieldAccess(obj, field) => {
            // `expr?.field` - if expr is None, return 0; else unwrap and access field.
            // The expression is an Option (struct { tag: i64, value: i64 }).
            // If Some (tag 0), the value (field 1) is a pointer to the struct.
            // If None (tag 1), return 0.
            var option_ptr: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(obj));

            // Allocate result slot
            var result_slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));

            // Load the tag (field 0)
            var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(option_ptr, 0, IrType::I64));
            var tag: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));

            var some_block: i64 = Lowerer_new_block(self);
            var none_block: i64 = Lowerer_new_block(self);
            var merge_block: i64 = Lowerer_new_block(self);

            var zero_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            var is_some: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag, zero_val, IrType::Bool));
            Lowerer_emit_terminator(self, Inst::Branch(is_some, some_block, none_block));

            // Some: load the value (field 1 = struct pointer), then access field
            Lowerer_set_current_block(self, some_block);
            var val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(option_ptr, 1, IrType::I64));
            var struct_ptr: i64 = Lowerer_emit_inst(self, Inst::Load(val_ptr, IrType::I64));

            // Search for a struct that has this field
            var found_struct_name: str = "";
            var si: i64 = 0;
            while si < self.module.struct_layouts.len() {
                var layout_name: str = self.module.struct_layouts.get(si).name;
                match IrModule_get_struct(&self.module, layout_name) {
                    OptStructLayout::Some(layout) => {
                        var fi: i64 = 0;
                        while fi < layout.fields.len() {
                            if layout.fields.get(fi).name == field {
                                found_struct_name = layout_name;
                            }
                            fi = fi + 1;
                        }
                    }
                    OptStructLayout::None => {}
                }
                si = si + 1;
            }

            var field_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            if str_len(found_struct_name) > 0 {
                match IrModule_get_struct(&self.module, found_struct_name) {
                    OptStructLayout::Some(layout) => {
                        var fi: i64 = 0;
                        while fi < layout.fields.len() {
                            if layout.fields.get(fi).name == field {
                                var f_idx: i64 = fi;
                                var f_ty: IrType = layout.fields.get(fi).ty;
                                var f_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(struct_ptr, f_idx, f_ty));
                                match f_ty {
                                    IrType::Struct(_) => { field_val = f_ptr; }
                                    _ => { field_val = Lowerer_emit_inst(self, Inst::Load(f_ptr, f_ty)); }
                                }
                            }
                            fi = fi + 1;
                        }
                    }
                    OptStructLayout::None => {}
                }
            }

            var _s1: i64 = Lowerer_emit_inst(self, Inst::Store(result_slot, field_val, OptIrType::None));
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));

            // None: store 0 to result
            Lowerer_set_current_block(self, none_block);
            var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(result_slot, zero_val, OptIrType::None));
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));

            // Merge: load result
            Lowerer_set_current_block(self, merge_block);
            return Lowerer_emit_inst(self, Inst::Load(result_slot, IrType::I64));
        }
        Expr::ArrayLit(elem_ty, elements) => {
            // Allocate array on stack
            var n: i64 = elements.len();
            var ir_elem_ty: IrType = Lowerer_lower_type(self, lw_box_type_unbox(elem_ty));
            var arr_ty: IrType = IrType::Array(Box::new(ir_elem_ty), n);
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(arr_ty, Lowerer_current_region(self)));

            // Store each element
            var i: i64 = 0;
            while i < n {
                var elem_val: i64 = Lowerer_lower_expr(self, elements.get(i));
                var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(alloca, i, ir_elem_ty));
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(elem_ptr, elem_val, OptIrType::None));
                i = i + 1;
            }

            return alloca;
        }
        Expr::FString(parts) => {
            return Lowerer_lower_fstring_expr(self, parts);
        }
        Expr::Comptime(e) => {
            // Comptime expression - just lower it normally
            return Lowerer_lower_expr(self, lw_box_expr_unbox(e));
        }
        Expr::ComptimeBlock(stmts) => {
            var result: i64 = 0;
            var i: i64 = 0;
            while i < stmts.len() {
                match stmts.get(i) {
                    Stmt::Expr(e, _) => { result = Lowerer_lower_expr(self, e); }
                    s => { Lowerer_lower_stmt(self, s); }
                }
                i = i + 1;
            }
            if result == 0 {
                result = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            }
            return result;
        }
        Expr::PipeForward(left, right) => {
            // a |> f - f(a)  - desugar pipe forward into call/method call
            match lw_box_expr_unbox(right) {
                Expr::Call(callee, args) => {
                    // a |> f(args) - f(a, args...)
                    var left_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(left));
                    var arg_vals: Vec<i64> = Vec::new();
                    arg_vals.push(left_val);
                    var i: i64 = 0;
                    while i < args.len() {
                        arg_vals.push(Lowerer_lower_expr(self, args.get(i)));
                        i = i + 1;
                    }
                    var ret_ty: IrType = Lowerer_lookup_func_ret_ty_ir(self, callee);
                    var call_args: Vec<i64> = Vec::new();
                    var pipe_is_user: bool = Lowerer_is_user_func(self, callee);
                    var pipe_is_extern: bool = Lowerer_is_extern_func(self, callee);
                    if pipe_is_user && !pipe_is_extern {
                        call_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));  // __env
                    }
                    i = 0;
                    while i < arg_vals.len() {
                        call_args.push(arg_vals.get(i));
                        i = i + 1;
                    }
                    return Lowerer_emit_inst(self, Inst::Call(callee, call_args, ret_ty, EffectSet_new()));
                }
                Expr::MethodCall(receiver, method, args) => {
                    // a |> obj.method(args) - obj.method(a, args...)
                    // left becomes the first arg, receiver stays the receiver
                    var new_args: Vec<Expr> = Vec::new();
                    new_args.push(lw_box_expr_unbox(left));
                    var ai: i64 = 0;
                    while ai < args.len() {
                        new_args.push(args.get(ai));
                        ai = ai + 1;
                    }
                    var new_call: Expr = Expr::MethodCall(receiver, method, new_args);
                    return Lowerer_lower_expr(self, new_call);
                }
                Expr::Ident(name) => {
                    // x |> f  -  f(x)
                    var new_args: Vec<Expr> = Vec::new();
                    new_args.push(lw_box_expr_unbox(left));
                    var new_call: Expr = Expr::Call(name, new_args);
                    return Lowerer_lower_expr(self, new_call);
                }
                Expr::FieldAccess(receiver, field) => {
                    // x |> obj.field  -  obj.field(x)  (field is a method name)
                    var new_args: Vec<Expr> = Vec::new();
                    new_args.push(lw_box_expr_unbox(left));
                    var new_call: Expr = Expr::MethodCall(receiver, field, new_args);
                    return Lowerer_lower_expr(self, new_call);
                }
                _ => {
                    // Fallback: just lower left
                    return Lowerer_lower_expr(self, lw_box_expr_unbox(left));
                }
            }
        }
        Expr::QuantCast(e, ty) => {
            // Quantization cast - lower as a real cast to the target type
            var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            var src_ty: IrType = Lowerer_get_value_type(self, val);
            var dst_ir_ty: IrType = Lowerer_lower_type(self, ty);
            return Lowerer_lower_cast(self, val, src_ty, dst_ir_ty);
        }
        Expr::Await(e) => {
            // Await - call p_future_poll
            var fut_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(e));
            var args: Vec<i64> = Vec::new();
            args.push(fut_val);
            return Lowerer_emit_inst(self, Inst::Call("p_future_poll", args, IrType::I64, EffectSet_new()));
        }
        Expr::Spawn(e) => {
            // spawn <expr> - create a concurrent task that runs in a real OS thread.
            // If the inner expression is a function call, extract the function name
            // and args, and call p_thread_spawn which creates an OS thread.
            // If it's not a call, fall back to eager evaluation.
            match lw_box_expr_unbox(e) {
                Expr::Call(callee, args) => {
                    // spawn func(args) - p_thread_spawn(func_name, num_args, args...)
                    var func_name_val: i64 = Lowerer_emit_inst(self, Inst::ConstStr(callee));
                    var num_args_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(args.len(), IrType::I64));
                    var all_args: Vec<i64> = Vec::new();
                    all_args.push(func_name_val);
                    all_args.push(num_args_val);
                    var ai: i64 = 0;
                    while ai < args.len() {
                        all_args.push(Lowerer_lower_expr(self, args.get(ai)));
                        ai = ai + 1;
                    }
                    return Lowerer_emit_inst(self, Inst::Call("p_thread_spawn", all_args, IrType::I64, EffectSet_new()));
                }
                _ => {
                    // Non-call spawn - fall back to eager evaluation
                    return Lowerer_lower_expr(self, lw_box_expr_unbox(e));
                }
            }
        }
        Expr::Yield(e) => {
            // yield <expr> - evaluate the inner expression (no-op for now)
            return Lowerer_lower_expr(self, lw_box_expr_unbox(e));
        }
        Expr::NamedArg(name, e) => {
            return Lowerer_lower_expr(self, lw_box_expr_unbox(e));
        }
        Expr::ComptimeReflect(op, ty) => {
            return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        }
        Expr::Asm(template, operands) => {
            // Inline assembly lowering
            var inputs: Vec<StringValueId> = Vec::new();
            var outputs: Vec<StringValueId> = Vec::new();
            // Clobbered registers are passed as inputs with a "CL:" prefix
            // in the name field, and id=-1 (no actual value to load).
            var oi: i64 = 0;
            while oi < operands.len() {
                var op: AsmOperand = operands.get(oi);
                match op.direction {
                    AsmDir::In => {
                        var val: i64 = Lowerer_lower_expr(self, op.expr);
                        inputs.push(StringValueId_new(op.reg, val));
                    }
                    AsmDir::Out => {
                        var val: i64 = Lowerer_lower_expr(self, op.expr);
                        outputs.push(StringValueId_new(op.reg, val));
                    }
                    AsmDir::Clobber => {
                        // Pass clobber regs as inputs with special prefix
                        inputs.push(StringValueId_new("CL:" + op.reg, -1));
                    }
                }
                oi = oi + 1;
            }
            var ret_ty: IrType = IrType::Void;
            if outputs.len() > 0 {
                ret_ty = IrType::I64;
            }
            return Lowerer_emit_inst(self, Inst::Asm(template, inputs, outputs, ret_ty));
        }
    }
    return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
}

// --- Closure helpers ------------------------------------------------------

/// Find free variables (captures) in a closure body.
/// Returns list of (name, type) tuples for variables that are used but not
/// declared locally or in the closure parameters. The type is looked up from
/// the enclosing scope's alloca types or falls back to I64.
pub fn Lowerer_find_captures(self: &Lowerer, body: Vec<Stmt>, param_names: Vec<str>) -> Vec<StringTypeEntry> {
    var free_vars: Vec<str> = Vec::new();
    var local_names: Vec<str> = Vec::new();
    // Start with param names as locals
    var pi: i64 = 0;
    while pi < param_names.len() {
        local_names.push(param_names.get(pi));
        pi = pi + 1;
    }
    Lowerer_collect_free_vars(self, body, free_vars, local_names);

    // For each free variable, look up its type from the enclosing scope
    var captures: Vec<StringTypeEntry> = Vec::new();
    var fi: i64 = 0;
    while fi < free_vars.len() {
        var name: str = free_vars.get(fi);
        var cap_ty: Type = Type::I64;
        // Try to find the type from alloca types
        match Lowerer_lookup_alloca(self, name) {
            OptValueId::Some(alloca_id) => {
                match Lowerer_lookup_alloca_type(self, alloca_id) {
                    OptIrType::Some(ir_ty) => { cap_ty = ir_type_to_ast_type(ir_ty); }
                    OptIrType::None => { cap_ty = Type::I64; }
                }
            }
            OptValueId::None => {
                // Fall back to I64 for non-alloca variables
                cap_ty = Type::I64;
            }
        }
        captures.push(StringTypeEntry_new(name, cap_ty));
        fi = fi + 1;
    }
    return captures;
}

/// Collect free variables from a list of statements.
pub fn Lowerer_collect_free_vars(self: &Lowerer, stmts: Vec<Stmt>, free_vars: Vec<str>, local_names: Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        Lowerer_collect_free_vars_stmt(self, stmts.get(i), free_vars, local_names);
        i = i + 1;
    }
}

/// Collect free variables from a single statement.
pub fn Lowerer_collect_free_vars_stmt(self: &Lowerer, stmt: Stmt, free_vars: Vec<str>, local_names: Vec<str>) {
    match stmt {
        Stmt::Let(name, _ty, expr, _is_mut, _is_persist, _annotations, _line) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
            local_names.push(name);
        }
        Stmt::LetUninit(name, _ty, _annotations, _line) => {
            local_names.push(name);
        }
        Stmt::LetTuple(names, expr, _line) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
            var ni: i64 = 0;
            while ni < names.len() {
                local_names.push(names.get(ni));
                ni = ni + 1;
            }
        }
        Stmt::Assign(name, _op, expr, _line) => {
            if !lw_c_str_vec_contains(local_names, name) && !lw_c_str_vec_contains(free_vars, name) {
                free_vars.push(name);
            }
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::IndexAssign(array, index, _op, expr, _line) => {
            if !lw_c_str_vec_contains(local_names, array) && !lw_c_str_vec_contains(free_vars, array) {
                free_vars.push(array);
            }
            Lowerer_collect_free_vars_expr(self, index, free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::DerefAssign(ptr_expr, _op, expr, _line) => {
            Lowerer_collect_free_vars_expr(self, ptr_expr, free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::FieldAssign(object, _field, _op, expr, _line) => {
            Lowerer_collect_free_vars_expr(self, object, free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::Expr(expr, _line) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::Return(expr, _line) => {
            match expr {
                OptBoxExpr::Some(e) => { Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _line) => {
            Lowerer_collect_free_vars_expr(self, cond, free_vars, local_names);
            Lowerer_collect_free_vars(self, then_block, free_vars, local_names);
            match else_block {
                OptStmts::Some(eb) => { Lowerer_collect_free_vars(self, eb, free_vars, local_names); }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, _line) => {
            Lowerer_collect_free_vars_expr(self, cond, free_vars, local_names);
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
        }
        Stmt::For(_var, iterator, body, _line) => {
            Lowerer_collect_free_vars_expr(self, iterator, free_vars, local_names);
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
        }
        Stmt::Loop(body, _line) => {
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
        }
        Stmt::Break(expr, _line) => {
            match expr {
                OptBoxExpr::Some(e) => { Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::Defer(body, _line) => {
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
        }
        Stmt::Match(expr, arms, _line) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
            var ai: i64 = 0;
            while ai < arms.len() {
                Lowerer_collect_free_vars(self, arms.get(ai).body, free_vars, local_names);
                ai = ai + 1;
            }
        }
        _ => {}
    }
}

/// Collect free variables from an expression.
pub fn Lowerer_collect_free_vars_expr(self: &Lowerer, expr: Expr, free_vars: Vec<str>, local_names: Vec<str>) {
    match expr {
        Expr::Ident(name) => {
            if !lw_c_str_vec_contains(local_names, name) && !lw_c_str_vec_contains(free_vars, name) {
                free_vars.push(name);
            }
        }
        Expr::IntLit(_) => {}
        Expr::FloatLit(_) => {}
        Expr::BoolLit(_) => {}
        Expr::StringLit(_) => {}
        Expr::Binary(_op, left, right) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(right), free_vars, local_names);
        }
        Expr::Unary(_op, operand) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(operand), free_vars, local_names);
        }
        Expr::Call(_callee, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                Lowerer_collect_free_vars_expr(self, args.get(ai), free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::FieldAccess(obj, _field) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(obj), free_vars, local_names);
        }
        Expr::OptionalFieldAccess(obj, _field) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(obj), free_vars, local_names);
        }
        Expr::StructLit(_name, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                Lowerer_collect_free_vars_expr(self, fields.get(fi).value, free_vars, local_names);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(e) => { Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names); }
                OptBoxExpr::None => {}
            }
        }
        Expr::If(cond, then_block, else_block) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(cond), free_vars, local_names);
            Lowerer_collect_free_vars(self, then_block, free_vars, local_names);
            match else_block {
                OptStmts::Some(eb) => { Lowerer_collect_free_vars(self, eb, free_vars, local_names); }
                OptStmts::None => {}
            }
        }
        Expr::Range(start, end, _inclusive) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(start), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(end), free_vars, local_names);
        }
        Expr::Block(stmts) => {
            Lowerer_collect_free_vars(self, stmts, free_vars, local_names);
        }
        Expr::MethodCall(receiver, _method, args) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(receiver), free_vars, local_names);
            var ai: i64 = 0;
            while ai < args.len() {
                Lowerer_collect_free_vars_expr(self, args.get(ai), free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::ArrayLit(_elem_ty, elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                Lowerer_collect_free_vars_expr(self, elements.get(ei), free_vars, local_names);
                ei = ei + 1;
            }
        }
        Expr::Index(arr, idx) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(arr), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(idx), free_vars, local_names);
        }
        Expr::FString(_parts) => {}
        Expr::Match(e, arms) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names);
            var ai: i64 = 0;
            while ai < arms.len() {
                Lowerer_collect_free_vars(self, arms.get(ai).body, free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_enum_name, _variant, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                Lowerer_collect_free_vars_expr(self, args.get(ai), free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::Ref(expr, _is_mut) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(expr), free_vars, local_names);
        }
        Expr::Deref(expr) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(expr), free_vars, local_names);
        }
        Expr::StrConcat(left, right) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(right), free_vars, local_names);
        }
        Expr::Try(e) => { Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names); }
        Expr::Coalesce(left, right) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(right), free_vars, local_names);
        }
        Expr::IsCheck(e, _) => { Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names); }
        Expr::TryBlock(stmts) => { Lowerer_collect_free_vars(self, stmts, free_vars, local_names); }
        Expr::TupleLit(elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                Lowerer_collect_free_vars_expr(self, elements.get(ei), free_vars, local_names);
                ei = ei + 1;
            }
        }
        Expr::Closure(_params, _body, _ret_ty) => {
            // Don't recurse into nested closures
        }
        Expr::Cast(expr, _ty) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(expr), free_vars, local_names);
        }
        Expr::Asm(_template, _args) => {}
        Expr::Comptime(e) => { Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(e), free_vars, local_names); }
        Expr::ComptimeBlock(stmts) => { Lowerer_collect_free_vars(self, stmts, free_vars, local_names); }
        Expr::ComptimeReflect(_op, _ty) => {}
        Expr::PipeForward(left, right) => {
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, lw_box_expr_unbox(right), free_vars, local_names);
        }
        Expr::QuantCast(e, _) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
        Expr::Await(e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
        Expr::Spawn(e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
        Expr::Yield(e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
        Expr::NamedArg(name, e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
    }
}

/// Build the __env struct for a closure: malloc, store fn_name at [0],
/// store captures at [1..N], return the env pointer.
pub fn Lowerer_make_fn_env(self: &mut Lowerer, fn_name: str, captures: Vec<StringTypeEntry>) -> i64 {
    var env_size: i64 = (1 + captures.len()) * 8;
    var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(env_size, IrType::I64));
    var malloc_args: Vec<i64> = Vec::new();
    malloc_args.push(size_val);
    var env_ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", malloc_args, IrType::Ptr(Box::new(IrType::U8)), EffectSet_new()));

    // Store function reference at field 0
    // ConstFnRef stores the function name; PE emitter resolves it to a code address,
    // interpreter/C codegen treat it as a string for name-based lookup.
    var fn_name_val: i64 = Lowerer_emit_inst(self, Inst::ConstFnRef(fn_name));
    var zero_idx: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var field0: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(env_ptr, zero_idx, IrType::I64));
    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(field0, fn_name_val, OptIrType::None));

    // Store captures at fields 1..N
    var ci: i64 = 0;
    while ci < captures.len() {
        var cap_name: str = captures.get(ci).key;
        // Lower the capture value from enclosing scope
        var cap_val: i64 = Lowerer_lower_expr(self, Expr::Ident(cap_name));
        var idx: i64 = Lowerer_emit_inst(self, Inst::ConstInt(ci + 1, IrType::I64));
        var field: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(env_ptr, idx, IrType::I64));
        var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(field, cap_val, OptIrType::None));
        ci = ci + 1;
    }

    Lowerer_set_value_type(self, env_ptr, IrType::Opaque("closure"));
    return env_ptr;
}

pub fn Lowerer_lower_while(self: &mut Lowerer, cond: Expr, body: Vec<Stmt>) {
    var cond_block: i64 = Lowerer_new_block(self);
    var body_block: i64 = Lowerer_new_block(self);
    var exit_block: i64 = Lowerer_new_block(self);

    // Jump to condition block
    Lowerer_emit_terminator(self, Inst::Jump(cond_block));

    // Condition block
    Lowerer_set_current_block(self, cond_block);
    var cond_val: i64 = Lowerer_lower_expr(self, cond);
    Lowerer_emit_terminator(self, Inst::Branch(cond_val, body_block, exit_block));

    // Body block
    Lowerer_set_current_block(self, body_block);
    self.loop_stack.push(LoopContext_new(cond_block, exit_block, OptValueId::None));
    Lowerer_lower_stmts(self, body);
    self.loop_stack.pop();
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(cond_block));
    }

    // Continue after loop
    Lowerer_set_current_block(self, exit_block);
}

pub fn Lowerer_lower_for(self: &mut Lowerer, loop_var: str, iterator: Expr, body: Vec<Stmt>) {
    // For ranges: for x in start..end { body }
    match iterator {
        Expr::Range(start, end, inclusive) => {
            var start_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(start));
            var end_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(end));

            // Create alloca for loop variable
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, start_val, OptIrType::None));
            Lowerer_insert_alloca(self, loop_var, alloca);
            Lowerer_bind_local(self, loop_var, alloca);

            var cond_block: i64 = Lowerer_new_block(self);
            var body_block: i64 = Lowerer_new_block(self);
            var exit_block: i64 = Lowerer_new_block(self);

            Lowerer_emit_terminator(self, Inst::Jump(cond_block));

            // Condition: var < end (or var <= end for inclusive)
            Lowerer_set_current_block(self, cond_block);
            var var_val: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, IrType::I64));
            var cmp_op: BinOp = BinOp::Lt;
            if inclusive { cmp_op = BinOp::LtEq; }
            var cond_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(cmp_op, var_val, end_val, IrType::Bool));
            Lowerer_emit_terminator(self, Inst::Branch(cond_val, body_block, exit_block));

            // Body
            Lowerer_set_current_block(self, body_block);
            self.loop_stack.push(LoopContext_new(cond_block, exit_block, OptValueId::None));
            Lowerer_lower_stmts(self, body);
            self.loop_stack.pop();

            // Increment: var += 1
            if !Lowerer_current_block_has_terminator(self) {
                var current: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, IrType::I64));
                var one: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
                var inc: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, current, one, IrType::I64));
                var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, inc, OptIrType::None));
                Lowerer_emit_terminator(self, Inst::Jump(cond_block));
            }

            Lowerer_set_current_block(self, exit_block);
        }
        _ => {
            // Non-range iterator: lower the iterator expression and iterate
            var iter_val: i64 = Lowerer_lower_expr(self, iterator);
            var iter_ty: IrType = Lowerer_get_value_type(self, iter_val);

            // Check if Vec
            if ir_type_is_opaque_named(iter_ty, "Vec") {
                Lowerer_lower_for_vec(self, loop_var, iter_val, body);
                return;
            }
            // Check if HashMap - get keys as Vec
            if ir_type_is_opaque_named(iter_ty, "HashMap") {
                var args: Vec<i64> = Vec::new();
                args.push(iter_val);
                var keys_vec: i64 = Lowerer_emit_inst(self, Inst::Call("HashMap_keys", args, opaque_ty("Vec"), EffectSet_new()));
                Lowerer_lower_for_vec(self, loop_var, keys_vec, body);
                return;
            }
            // Check if String (ptr_u8) - iterate bytes
            if ir_type_is_ptr_like(iter_ty) {
                // Check if it's a string pointer (ptr to u8)
                match iter_ty {
                    IrType::Ptr(inner) => {
                        match box_ir_type_unbox(inner) {
                            IrType::U8 => {
                                Lowerer_lower_for_string(self, loop_var, iter_val, body);
                                return;
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }
            // Default: treat as Vec iteration (most common case for opaque types)
            if ir_type_is_ptr_like(iter_ty) || ir_type_eq(iter_ty, IrType::I64) {
                Lowerer_lower_for_vec(self, loop_var, iter_val, body);
                return;
            }

            // Array iterator
            var arr_val: i64 = iter_val;
            var arr_ty: IrType = Lowerer_get_value_type(self, arr_val);
            var elem_ty: IrType = IrType::I64;
            var arr_len: i64 = 0;
            match arr_ty {
                IrType::Array(inner, len) => {
                    elem_ty = box_ir_type_unbox(inner);
                    arr_len = len;
                }
                IrType::Ptr(inner2) => {
                    var inner_ty: IrType = box_ir_type_unbox(inner2);
                    match inner_ty {
                        IrType::Array(inner3, len3) => {
                            elem_ty = box_ir_type_unbox(inner3);
                            arr_len = len3;
                        }
                        _ => { elem_ty = IrType::I64; arr_len = 0; }
                    }
                }
                _ => { elem_ty = IrType::I64; arr_len = 0; }
            }

            // Create alloca for loop variable
            var var_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(elem_ty, Lowerer_current_region(self)));
            Lowerer_insert_alloca_type(self, var_alloca, elem_ty);
            Lowerer_insert_alloca(self, loop_var, var_alloca);
            Lowerer_bind_local(self, loop_var, var_alloca);

            // Create index alloca
            var idx_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
            Lowerer_insert_alloca_type(self, idx_alloca, IrType::I64);
            var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, zero, OptIrType::None));

            var cond_block: i64 = Lowerer_new_block(self);
            var body_block: i64 = Lowerer_new_block(self);
            var exit_block: i64 = Lowerer_new_block(self);

            Lowerer_emit_terminator(self, Inst::Jump(cond_block));

            // Condition: i < arr_len
            Lowerer_set_current_block(self, cond_block);
            var idx_val: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
            var len_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(arr_len, IrType::I64));
            var cond_val2: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, idx_val, len_val, IrType::Bool));
            Lowerer_emit_terminator(self, Inst::Branch(cond_val2, body_block, exit_block));

            // Body
            Lowerer_set_current_block(self, body_block);
            self.loop_stack.push(LoopContext_new(cond_block, exit_block, OptValueId::None));

            // Load element: arr[i]
            var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(arr_val, idx_val, elem_ty));
            var elem_val: i64 = Lowerer_emit_inst(self, Inst::Load(elem_ptr, elem_ty));
            var _s4: i64 = Lowerer_emit_inst(self, Inst::Store(var_alloca, elem_val, OptIrType::None));

            Lowerer_lower_stmts(self, body);
            self.loop_stack.pop();

            // Increment index
            if !Lowerer_current_block_has_terminator(self) {
                var idx_val2: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
                var one2: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
                var inc2: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, idx_val2, one2, IrType::I64));
                var _s5: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, inc2, OptIrType::None));
                Lowerer_emit_terminator(self, Inst::Jump(cond_block));
            }

            Lowerer_set_current_block(self, exit_block);
        }
    }
}

/// Lower `for c in str_expr { body }` - iterate over string bytes.
/// Uses p_str_length for the loop bound and String_byte_at for element access.
pub fn Lowerer_lower_for_string(self: &mut Lowerer, loop_var: str, str_val: i64, body: Vec<Stmt>) {
    // Create alloca for loop variable (byte value as i64)
    var var_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
    Lowerer_insert_alloca_type(self, var_alloca, IrType::I64);
    Lowerer_insert_alloca(self, loop_var, var_alloca);
    Lowerer_bind_local(self, loop_var, var_alloca);

    // Create index alloca
    var idx_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
    Lowerer_insert_alloca_type(self, idx_alloca, IrType::I64);
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, zero, OptIrType::None));

    // Get string length once (hoist out of loop)
    // p_str_length is a user function - prepend dummy env_ptr
    var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var len_args: Vec<i64> = Vec::new();
    len_args.push(dummy_env);
    len_args.push(str_val);
    var len_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_length", len_args, IrType::I64, EffectSet_new()));

    var cond_block: i64 = Lowerer_new_block(self);
    var body_block: i64 = Lowerer_new_block(self);
    var exit_block: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Jump(cond_block));

    // Condition: i < len
    Lowerer_set_current_block(self, cond_block);
    var idx_val: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
    var cond_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, idx_val, len_val, IrType::Bool));
    Lowerer_emit_terminator(self, Inst::Branch(cond_val, body_block, exit_block));

    // Body: c = String_byte_at(str, i), store to var_alloca, lower body, increment
    Lowerer_set_current_block(self, body_block);
    var cur_idx: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
    var dummy_env2: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var byte_args: Vec<i64> = Vec::new();
    byte_args.push(dummy_env2);
    byte_args.push(str_val);
    byte_args.push(cur_idx);
    var byte_val: i64 = Lowerer_emit_inst(self, Inst::Call("String_byte_at", byte_args, IrType::I64, EffectSet_new()));
    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(var_alloca, byte_val, OptIrType::None));

    self.loop_stack.push(LoopContext_new(cond_block, exit_block, OptValueId::None));
    Lowerer_lower_stmts(self, body);
    self.loop_stack.pop();

    if !Lowerer_current_block_has_terminator(self) {
        var cur: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
        var one: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
        var inc: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, cur, one, IrType::I64));
        var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, inc, OptIrType::None));
        Lowerer_emit_terminator(self, Inst::Jump(cond_block));
    }

    Lowerer_set_current_block(self, exit_block);
}

pub fn Lowerer_lower_for_vec(self: &mut Lowerer, loop_var: str, vec_val: i64, body: Vec<Stmt>) {
    // Determine element type from Vec value type
    var vec_ty: IrType = Lowerer_get_value_type(self, vec_val);
    var elem_ty: IrType = IrType::I64;
    match vec_ty {
        IrType::Generic(gname, gargs) => {
            if gname == "Vec" && gargs.len() > 0 {
                elem_ty = gargs.get(0);
            }
        }
        _ => {}
    }

    // Create alloca for loop variable
    var var_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(elem_ty, Lowerer_current_region(self)));
    Lowerer_insert_alloca_type(self, var_alloca, elem_ty);
    Lowerer_insert_alloca(self, loop_var, var_alloca);
    Lowerer_bind_local(self, loop_var, var_alloca);

    // Create index alloca
    var idx_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
    Lowerer_insert_alloca_type(self, idx_alloca, IrType::I64);
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, zero, OptIrType::None));

    var cond_block: i64 = Lowerer_new_block(self);
    var body_block: i64 = Lowerer_new_block(self);
    var exit_block: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Jump(cond_block));

    // Condition: i < Vec_len(vec)
    Lowerer_set_current_block(self, cond_block);
    var idx_val: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
    var len_args: Vec<i64> = Vec::new();
    len_args.push(vec_val);
    var len_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_vec_len", len_args, IrType::I64, EffectSet_new()));
    var cond_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, idx_val, len_val, IrType::Bool));
    Lowerer_emit_terminator(self, Inst::Branch(cond_val, body_block, exit_block));

    // Body
    Lowerer_set_current_block(self, body_block);
    self.loop_stack.push(LoopContext_new(cond_block, exit_block, OptValueId::None));

    // Load element: Vec_get(vec, i) - use word_repr for struct elements
    var get_args: Vec<i64> = Vec::new();
    get_args.push(vec_val);
    get_args.push(idx_val);
    var get_ret_ty: IrType = word_repr(elem_ty);
    var elem_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_vec_get", get_args, get_ret_ty, EffectSet_new()));
    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(var_alloca, elem_val, OptIrType::None));

    Lowerer_lower_stmts(self, body);
    self.loop_stack.pop();

    // Increment index
    if !Lowerer_current_block_has_terminator(self) {
        var idx_val2: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
        var one: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
        var inc: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, idx_val2, one, IrType::I64));
        var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, inc, OptIrType::None));
        Lowerer_emit_terminator(self, Inst::Jump(cond_block));
    }

    Lowerer_set_current_block(self, exit_block);
}

pub fn Lowerer_lower_loop(self: &mut Lowerer, body: Vec<Stmt>) {
    var body_block: i64 = Lowerer_new_block(self);
    var exit_block: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Jump(body_block));

    // Body block
    Lowerer_set_current_block(self, body_block);
    self.loop_stack.push(LoopContext_new(body_block, exit_block, OptValueId::None));
    Lowerer_lower_stmts(self, body);
    self.loop_stack.pop();

    // If body doesn't end with terminator, jump back to body (infinite loop)
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(body_block));
    }

    Lowerer_set_current_block(self, exit_block);
}

pub fn Lowerer_lower_match(self: &mut Lowerer, expr: Expr, arms: Vec<MatchArm>) {
    // Full match lowering for statements.
    var match_val: i64 = Lowerer_lower_expr(self, expr);
    var merge_block: i64 = Lowerer_new_block(self);

    var i: i64 = 0;
    while i < arms.len() {
        var arm: MatchArm = arms.get(i);
        var arm_block: i64 = Lowerer_new_block(self);
        var next_block: i64 = Lowerer_new_block(self);

        // Save variable binding lengths so arm-local bindings don't leak
        // into other arms or code after the match. Fides Vec is a reference
        // type (PVec*), so we use truncate-based save/restore instead of
        // pointer-copy assignment.
        var saved_allocas_len: i64 = self.allocas.len();
        var saved_alloca_types_len: i64 = self.alloca_types.len();
        var saved_var_ast_types_len: i64 = self.var_ast_types.len();
        var saved_locals_len: i64 = self.current_func.locals.len();

        match arm.pattern {
            Pattern::Wildcard => {
                Lowerer_emit_terminator(self, Inst::Jump(arm_block));
            }
            Pattern::IntLit(v) => {
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstInt(v, IrType::I64)), IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::BoolLit(v) => {
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstBool(v)), IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::Ident(name) => {
                Lowerer_bind_local(self, name, match_val);
                Lowerer_emit_terminator(self, Inst::Jump(arm_block));
            }
            Pattern::StrLit(s) => {
                var const_str: i64 = Lowerer_emit_inst(self, Inst::ConstStr(s));
                var dummy_env_se2: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var str_eq_args: Vec<i64> = Vec::new();
                str_eq_args.push(dummy_env_se2);
                str_eq_args.push(match_val);
                str_eq_args.push(const_str);
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_equal", str_eq_args, IrType::Bool, EffectSet_new()));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::Range(start_pat, end_pat) => {
                var lo: i64 = 0;
                var hi: i64 = 0;
                var range_ok: bool = false;
                match start_pat {
                    Pattern::IntLit(s) => { lo = s; match end_pat { Pattern::IntLit(e) => { hi = e; range_ok = true; } _ => {} } }
                    _ => {}
                }
                if range_ok {
                    var start_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(lo, IrType::I64));
                    var end_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(hi, IrType::I64));
                    var lo_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::LtEq, start_val, match_val, IrType::Bool));
                    var hi_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, match_val, end_val, IrType::Bool));
                    var in_range: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::And, lo_cmp, hi_cmp, IrType::Bool));
                    Lowerer_emit_terminator(self, Inst::Branch(in_range, arm_block, next_block));
                } else {
                    Lowerer_emit_terminator(self, Inst::Jump(next_block));
                }
            }
            Pattern::EnumVariant(enum_name, variant, bindings) => {
                // Load tag from offset 0 and compare with variant index
                var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, 0, IrType::I64));
                var tag_val: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));

                // Find variant index
                var variant_idx: i64 = 0;
                if str_len(enum_name) > 0 {
                    match Lowerer_lookup_enum(self, enum_name) {
                        OptEnumDef::Some(def) => {
                            var vi: i64 = 0;
                            while vi < def.variants.len() {
                                if def.variants.get(vi).name == variant {
                                    variant_idx = vi;
                                }
                                vi = vi + 1;
                            }
                        }
                        OptEnumDef::None => {}
                    }
                } else {
                    var ei: i64 = 0;
                    while ei < self.enums.len() {
                        var def2: EnumDef = self.enums.get(ei).val;
                        var vi: i64 = 0;
                        while vi < def2.variants.len() {
                            if def2.variants.get(vi).name == variant {
                                variant_idx = vi;
                            }
                            vi = vi + 1;
                        }
                        ei = ei + 1;
                    }
                }

                var expected: i64 = Lowerer_emit_inst(self, Inst::ConstInt(variant_idx, IrType::I64));
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag_val, expected, IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));

                // In arm block: bind payload fields
                Lowerer_set_current_block(self, arm_block);
                var binding_tys: Vec<IrType> = Lowerer_pattern_binding_ir_types(self, enum_name, variant, bindings);
                var binding_ast_tys: Vec<Type> = Lowerer_pattern_binding_ast_types(self, enum_name, variant, bindings);
                // Compute field indices: struct-typed fields occupy multiple
                // slots (inline storage), so we accumulate the offset.
                var field_idx: i64 = 1;
                var bi: i64 = 0;
                while bi < bindings.len() {
                    var binding: Binding = bindings.get(bi);
                    var field_ty: IrType = IrType::I64;
                    if bi < binding_tys.len() {
                        field_ty = binding_tys.get(bi);
                    }
                    var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, field_idx, field_ty));
                    var field_val: i64 = Lowerer_load_enum_field(self, field_ptr, field_ty);
                    Lowerer_bind_local(self, binding.name, field_val);
                    // Register AST type so infer_expr_type can recover
                    // generic element types (e.g. Vec<FieldInit>).
                    if bi < binding_ast_tys.len() {
                        Lowerer_insert_var_ast_type(self, binding.name, binding_ast_tys.get(bi));
                    }
                    // Advance field_idx by the number of slots this field occupies
                    field_idx = field_idx + Lowerer_enum_field_slots(self, field_ty);
                    bi = bi + 1;
                }
                Lowerer_lower_stmts(self, arm.body);
                if !Lowerer_current_block_has_terminator(self) {
                    Lowerer_emit_terminator(self, Inst::Jump(merge_block));
                }
                // Restore variable bindings (truncate arm-local additions)
                self.allocas.truncate(saved_allocas_len);
                self.alloca_types.truncate(saved_alloca_types_len);
                self.var_ast_types.truncate(saved_var_ast_types_len);
                self.current_func.locals.truncate(saved_locals_len);
                Lowerer_set_current_block(self, next_block);
                i = i + 1;
                continue;
            }
        }

        // Arm body (for non-EnumVariant patterns)
        Lowerer_set_current_block(self, arm_block);
        Lowerer_lower_stmts(self, arm.body);
        if !Lowerer_current_block_has_terminator(self) {
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));
        }
        // Restore variable bindings (truncate arm-local additions)
        self.allocas.truncate(saved_allocas_len);
        self.alloca_types.truncate(saved_alloca_types_len);
        self.var_ast_types.truncate(saved_var_ast_types_len);
        self.current_func.locals.truncate(saved_locals_len);

        Lowerer_set_current_block(self, next_block);
        i = i + 1;
    }

    // No arm matched - jump to merge
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(merge_block));
    }

    Lowerer_set_current_block(self, merge_block);
}

pub fn Lowerer_lower_compound_assign(self: &mut Lowerer, op: AssignOp, current: i64, rhs: i64) -> i64 {
    var binop: BinOp = BinOp::Add;
    match op {
        AssignOp::AddAssign => { binop = BinOp::Add; }
        AssignOp::SubAssign => { binop = BinOp::Sub; }
        AssignOp::MulAssign => { binop = BinOp::Mul; }
        AssignOp::DivAssign => { binop = BinOp::Div; }
        AssignOp::ModAssign => { binop = BinOp::Mod; }
        AssignOp::BitAndAssign => { binop = BinOp::BitAnd; }
        AssignOp::BitOrAssign => { binop = BinOp::BitOr; }
        AssignOp::BitXorAssign => { binop = BinOp::BitXor; }
        AssignOp::ShlAssign => { binop = BinOp::Shl; }
        AssignOp::ShrAssign => { binop = BinOp::Shr; }
        AssignOp::Assign => { return rhs; }
    }
    var ty: IrType = Lowerer_get_value_type(self, current);
    return Lowerer_emit_inst(self, Inst::BinOp(binop, current, rhs, ty));
}

pub fn Lowerer_type_struct_name(self: &Lowerer, ty: Type) -> OptStringLower {
    match ty {
        Type::Named(n) => {
            // Check if it's a struct (not an enum or alias)
            match Lowerer_lookup_struct(self, n) {
                OptStructDef::Some(_) => { return OptStringLower::Some(n); }
                OptStructDef::None => {}
            }
            // Check resolved alias
            match Lowerer_lookup_type_alias(self, n) {
                OptType::Some(alias) => { return Lowerer_type_struct_name(self, alias); }
                OptType::None => {}
            }
            return OptStringLower::None;
        }
        Type::Generic(n, _) => {
            match Lowerer_lookup_struct(self, n) {
                OptStructDef::Some(_) => { return OptStringLower::Some(n); }
                OptStructDef::None => {}
            }
            return OptStringLower::None;
        }
        _ => { return OptStringLower::None; }
    }
    return OptStringLower::None;
}

pub fn Lowerer_has_drop_impl(self: &Lowerer, struct_name: str) -> bool {
    // Check if there's a Drop_{struct_name} function
    match Lowerer_lookup_impl_method(self, struct_name, "drop") {
        OptFunc::Some(_) => { return true; }
        OptFunc::None => {}
    }
    // Also check for "Drop" trait impl
    match Lowerer_lookup_impl_method(self, struct_name, "Drop_drop") {
        OptFunc::Some(_) => { return true; }
        OptFunc::None => {}
    }
    return false;
}

pub fn Lowerer_emit_drops(self: &mut Lowerer) {
    // F88: @zeroize — emit memset(0) for zeroize_locals before drops
    Lowerer_emit_zeroize(self);
    // Emit drop calls for locals with Drop impls, in reverse order
    var i: i64 = self.current_func.drop_locals.len() - 1;
    while i >= 0 {
        var entry: ValueIdString = self.current_func.drop_locals.get(i);
        var drop_name: str = entry.name + "_drop";
        // Call drop function: drop(alloca_ptr)
        var args: Vec<i64> = Vec::new();
        args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));  // __env
        args.push(entry.id);
        var _v: i64 = Lowerer_emit_inst(self, Inst::Call(drop_name, args, IrType::Void, EffectSet_new()));
        i = i - 1;
    }
}

/// F88: Emit compiler-inserted memset(0) calls for all @zeroize locals.
/// Called before drops and returns. Wipes secrets from memory at scope exit.
/// Emits in reverse declaration order (LIFO — last declared wiped first).
pub fn Lowerer_emit_zeroize(self: &mut Lowerer) {
    var i: i64 = self.current_func.zeroize_locals.len() - 1;
    while i >= 0 {
        var entry: ValueIdU64 = self.current_func.zeroize_locals.get(i);
        // Emit: p_memset(alloca_ptr, 0, size)
        var zero_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I32));
        var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(entry.val, IrType::I64));
        var args: Vec<i64> = Vec::new();
        args.push(entry.id);
        args.push(zero_val);
        args.push(size_val);
        var eff: EffectSet = EffectSet_new();
        EffectSet_add(eff, Effect::Write);
        var _v: i64 = Lowerer_emit_inst(self, Inst::Call("p_memset", args, IrType::Void, eff));
        i = i - 1;
    }
}

pub fn Lowerer_infer_binop_type(self: &Lowerer, op: BinOp, left: Expr, right: Expr) -> IrType {
    // Comparison operators return bool
    if binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::LtEq) ||
       binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::GtEq) {
        return IrType::Bool;
    }
    // Logical operators return bool
    if binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
        return IrType::Bool;
    }
    // Arithmetic operators: infer from left operand
    var left_ty: IrType = Lowerer_infer_expr_type(self, left);
    if ir_type_eq(left_ty, IrType::Void) || ir_type_eq(left_ty, IrType::I64) {
        var right_ty: IrType = Lowerer_infer_expr_type(self, right);
        if ir_type_eq(right_ty, IrType::F64) { return IrType::F64; }
        return IrType::I64;
    }
    return left_ty;
}

pub fn Lowerer_infer_unary_type(self: &Lowerer, op: UnaryOp, expr: Expr) -> IrType {
    if unaryop_eq(op, UnaryOp::Not) {
        return IrType::Bool;
    }
    return Lowerer_infer_expr_type(self, expr);
}

pub fn Lowerer_infer_expr_type(self: &Lowerer, expr: Expr) -> IrType {
    match expr {
        Expr::IntLit(_) => { return IrType::I64; }
        Expr::FloatLit(_) => { return IrType::F64; }
        Expr::BoolLit(_) => { return IrType::Bool; }
        Expr::StringLit(_) => { return lw_ptr_u8(); }
        Expr::Ident(name) => {
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(alloca) => {
                    match Lowerer_lookup_alloca_type(self, alloca) {
                        OptIrType::Some(t) => { return t; }
                        OptIrType::None => {}
                    }
                }
                OptValueId::None => {}
            }
            // Fall back to AST type (e.g. for function parameters)
            match Lowerer_lookup_var_ast_type(self, name) {
                OptType::Some(ast_ty) => { return Lowerer_lower_type(self, ast_ty); }
                OptType::None => {}
            }
            // Check parameter AST types (for f64 params, Vec element type inference, etc.)
            match Lowerer_lookup_param_type(self, name) {
                OptType::Some(ast_ty) => { return Lowerer_lower_type(self, ast_ty); }
                OptType::None => {}
            }
            return IrType::I64;
        }
        Expr::Binary(op, left, right) => {
            return Lowerer_infer_binop_type(self, op, lw_box_expr_unbox(left), lw_box_expr_unbox(right));
        }
        Expr::Unary(op, e) => {
            return Lowerer_infer_unary_type(self, op, lw_box_expr_unbox(e));
        }
        Expr::Call(callee, _) => {
            return Lowerer_lookup_func_ret_ty_ir(self, callee);
        }
        Expr::FieldAccess(obj, field) => {
            var obj_ty: IrType = Lowerer_infer_expr_type(self, lw_box_expr_unbox(obj));
            match obj_ty {
                IrType::Struct(name) => {
                    match IrModule_get_struct(&self.module, name) {
                        OptStructLayout::Some(layout) => {
                            var fi: i64 = 0;
                            while fi < layout.fields.len() {
                                if layout.fields.get(fi).name == field {
                                    return layout.fields.get(fi).ty;
                                }
                                fi = fi + 1;
                            }
                        }
                        OptStructLayout::None => {}
                    }
                }
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(name2) => {
                            match IrModule_get_struct(&self.module, name2) {
                                OptStructLayout::Some(layout) => {
                                    var fi: i64 = 0;
                                    while fi < layout.fields.len() {
                                        if layout.fields.get(fi).name == field {
                                            return layout.fields.get(fi).ty;
                                        }
                                        fi = fi + 1;
                                    }
                                }
                                OptStructLayout::None => {}
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            return IrType::I64;
        }
        Expr::Cast(_, ty) => { return Lowerer_lower_type(self, ty); }
        Expr::StructLit(name, _, _) => { return IrType::Struct(name); }
        Expr::EnumLit(enum_name, _, _) => { return IrType::Struct(enum_name); }
        Expr::TupleLit(_) => { return IrType::Opaque("tuple"); }
        Expr::MethodCall(recv, method, _) => {
            // Check if this is Box::new(x), Vec::new(), etc.
            match lw_box_expr_unbox(recv) {
                Expr::Ident(name) => {
                    if name == "Box" && method == "new" { return IrType::Ptr(Box::new(IrType::U8)); }
                    if name == "Vec" && method == "new" { return IrType::Opaque("Vec"); }
                    if name == "HashMap" && method == "new" { return IrType::Opaque("HashMap"); }
                    if name == "String" && method == "from" { return IrType::Opaque("String"); }
                    // Check if it's an enum constructor
                    match Lowerer_lookup_enum(self, name) {
                        OptEnumDef::Some(_) => { return IrType::Struct(name); }
                        OptEnumDef::None => {}
                    }
                }
                _ => {}
            }
            // Builtin Vec methods - infer from receiver type
            // First try IR type, then fall back to AST type
            var recv_ty: IrType = Lowerer_infer_expr_type(self, lw_box_expr_unbox(recv));
            // If IR type is I64 or Opaque, try AST type for generic info
            var use_ast_elem: bool = false;
            var ast_elem_ty: IrType = IrType::I64;
            match recv_ty {
                IrType::Generic(name, gargs) => {
                    if name == "Vec" {
                        var elem_ty: IrType = IrType::I64;
                        if gargs.len() > 0 { elem_ty = gargs.get(0); }
                        if method == "push" || method == "set" || method == "clear" || method == "insert" || method == "reverse" || method == "extend" || method == "truncate" || method == "sort" || method == "for_each" { return IrType::Void; }
                        if method == "pop" || method == "get" || method == "remove" || method == "first" || method == "last" { return word_repr(elem_ty); }
                        if method == "len" || method == "find" || method == "position" { return IrType::I64; }
                        if method == "is_empty" || method == "contains" || method == "any" || method == "all" { return IrType::Bool; }
                        if method == "capacity" { return IrType::I64; }
                        if method == "clone" || method == "map" || method == "filter" {
                            var clone_args: Vec<IrType> = Vec::new();
                            clone_args.push(elem_ty);
                            return IrType::Generic("Vec", clone_args);
                        }
                        if method == "fold" { return IrType::I64; }
                    }
                }
                IrType::Opaque(oname) => {
                    if oname == "Vec" {
                        // Try to get element type from AST type annotation
                        match lw_box_expr_unbox(recv) {
                            Expr::Ident(vname) => {
                                match Lowerer_lookup_var_ast_type(self, vname) {
                                    OptType::Some(at) => {
                                        match at {
                                            Type::Generic(gname, gargs) => {
                                                if gname == "Vec" && gargs.len() > 0 {
                                                    ast_elem_ty = Lowerer_lower_type(self, gargs.get(0));
                                                    use_ast_elem = true;
                                                }
                                            }
                                            _ => {}
                                        }
                                    }
                                    OptType::None => {}
                                }
                            }
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
            if use_ast_elem {
                if method == "pop" || method == "get" || method == "remove" || method == "first" || method == "last" { return word_repr(ast_elem_ty); }
                if method == "clone" || method == "map" || method == "filter" {
                    var clone_args: Vec<IrType> = Vec::new();
                    clone_args.push(ast_elem_ty);
                    return IrType::Generic("Vec", clone_args);
                }
            }
            // Fallback: look up mangled function name
            var struct_name: str = "";
            match recv_ty {
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(n) => { struct_name = n; }
                        _ => {}
                    }
                }
                IrType::Struct(n) => { struct_name = n; }
                IrType::Generic(n, _) => { struct_name = n; }
                IrType::Opaque(n) => { struct_name = n; }
                _ => {}
            }
            if str_len(struct_name) > 0 {
                return Lowerer_lookup_func_ret_ty_ir(self, struct_name + "_" + method);
            }
            return Lowerer_lookup_func_ret_ty_ir(self, method);
        }
        Expr::Yield(e) => { return Lowerer_infer_expr_type(self, lw_box_expr_unbox(e)); }
        Expr::NamedArg(name, e) => { return Lowerer_infer_expr_type(self, lw_box_expr_unbox(e)); }
        _ => { return IrType::I64; }
    }
    return IrType::I64;
}

pub fn Lowerer_lookup_func_ret_ty_ir(self: &Lowerer, name: str) -> IrType {
    // Check module functions
    match IrModule_get_function(&self.module, name) {
        OptIrFunction::Some(f) => { return f.ret_ty; }
        OptIrFunction::None => {}
    }
    // Check extern functions
    var i: i64 = 0;
    while i < self.module.extern_functions.len() {
        if self.module.extern_functions.get(i).name == name {
            return self.module.extern_functions.get(i).ret;
        }
        i = i + 1;
    }
    // Check impl methods (mangled name)
    // The name should already be mangled at this point
    return IrType::I64;
}

/// A function declared `-> f64`/`-> f32` may return an integer expression
/// (`return 1;`): convert it numerically, as `val x: f64 = 1;` does.
pub fn Lowerer_coerce_return(self: &mut Lowerer, val: i64) -> i64 {
    var ret_ty: IrType = self.current_func.ret_ty;
    var val_ty: IrType = Lowerer_get_value_type(self, val);
    if ir_type_is_float(ret_ty) && ir_type_is_int(val_ty) {
        return Lowerer_lower_cast(self, val, val_ty, ret_ty);
    }
    return val;
}

pub fn Lowerer_lower_cast(self: &mut Lowerer, val: i64, src_ty: IrType, dst_ty: IrType) -> i64 {
    // If types are the same, no cast needed
    if ir_type_eq(src_ty, dst_ty) { return val; }

    // Int to Int (different sizes): extend or truncate
    if ir_type_is_int(src_ty) && ir_type_is_int(dst_ty) {
        var src_size: i64 = ir_type_size(src_ty);
        var dst_size: i64 = ir_type_size(dst_ty);
        if dst_size > src_size {
            return Lowerer_emit_inst(self, Inst::IntExtend(val, src_ty, dst_ty));
        } else if dst_size < src_size {
            return Lowerer_emit_inst(self, Inst::IntTrunc(val, src_ty, dst_ty));
        } else {
            return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
        }
    }
    // Int to Float
    if ir_type_is_int(src_ty) && ir_type_is_float(dst_ty) {
        return Lowerer_emit_inst(self, Inst::IntToFloat(val, src_ty, dst_ty));
    }
    // Float to Int
    if ir_type_is_float(src_ty) && ir_type_is_int(dst_ty) {
        return Lowerer_emit_inst(self, Inst::FloatToInt(val, src_ty, dst_ty));
    }
    // Float to Float (different sizes)
    if ir_type_is_float(src_ty) && ir_type_is_float(dst_ty) {
        return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
    }
    // Ptr to Ptr
    if ir_type_is_ptr(src_ty) && ir_type_is_ptr(dst_ty) {
        Lowerer_set_value_type(self, val, dst_ty);
        return val;
    }
    // Ptr to Bool (null check)
    if ir_type_is_ptr(src_ty) && ir_type_eq(dst_ty, IrType::Bool) {
        var null_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        return Lowerer_emit_inst(self, Inst::BinOp(BinOp::Neq, val, null_val, IrType::Bool));
    }
    // Bool to Int
    if ir_type_eq(src_ty, IrType::Bool) && ir_type_is_int(dst_ty) {
        return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
    }
    // Default: bitcast
    return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
}

pub fn Lowerer_infer_match_type(self: &Lowerer, arms: Vec<MatchArm>) -> IrType {
    var i: i64 = 0;
    while i < arms.len() {
        var si: i64 = 0;
        while si < arms.get(i).body.len() {
            match arms.get(i).body.get(si) {
                Stmt::Expr(e, _) => { return Lowerer_infer_expr_type(self, e); }
                _ => {}
            }
            si = si + 1;
        }
        i = i + 1;
    }
    return IrType::I64;
}

pub fn Lowerer_emit_sret_copy(self: &mut Lowerer, src_ptr: i64) {
    // Copy struct data from src_ptr to sret
    match self.current_sret {
        OptValueId::Some(sret) => {
            // Determine struct name from sret type
            var sret_ty: IrType = Lowerer_get_value_type(self, sret);
            var struct_name: str = "";
            match sret_ty {
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(n) => { struct_name = n; }
                        _ => {}
                    }
                }
                _ => {}
            }
            Lowerer_emit_struct_copy(self, src_ptr, sret, struct_name);
        }
        OptValueId::None => {}
    }
}

pub fn Lowerer_emit_struct_copy(self: &mut Lowerer, src_ptr: i64, dst_ptr: i64, struct_name: str) {
    // Copy each field
    match IrModule_get_struct(&self.module, struct_name) {
        OptStructLayout::Some(layout) => {
            var fi: i64 = 0;
            while fi < layout.fields.len() {
                var field_ty: IrType = layout.fields.get(fi).ty;
                var src_field: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(src_ptr, fi, field_ty));
                var dst_field: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(dst_ptr, fi, field_ty));
                // For struct-typed fields (enums stored inline), use
                // load_enum_field to extract the full inline data, then Store
                // with explicit store_ty to memcpy it into the destination.
                // For scalar fields, use Load+Store as before.
                match field_ty {
                    IrType::Struct(_) => {
                        var val: i64 = Lowerer_load_enum_field(self, src_field, field_ty);
                        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(dst_field, val, OptIrType::Some(field_ty)));
                    }
                    _ => {
                        var val: i64 = Lowerer_emit_inst(self, Inst::Load(src_field, field_ty));
                        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(dst_field, val, OptIrType::None));
                    }
                }
                fi = fi + 1;
            }
        }
        OptStructLayout::None => {}
    }
}

// --- f64 to bits conversion -----------------------------------------------

// B5: Convert f64 to IEEE 754 bit pattern via C runtime helper.
// This preserves NaN payloads, -0.0, and Inf bit patterns that are
// lost when converting to a decimal string. Used by ConstFloat codegen
// to emit union compound literals matching the Rust compiler's output.
pub fn f64_to_bits(f: f64) -> i64 {
    return p_f64_to_bits(f);
}

pub fn f32_to_bits(f: f64) -> i64 {
    return p_f32_to_bits(f);
}

pub fn Lowerer_emit_defers(self: &mut Lowerer) {
    // Emit defer blocks in reverse order (LIFO)
    var i: i64 = self.defer_stack.len() - 1;
    while i >= 0 {
        var stmts: Vec<Stmt> = self.defer_stack.get(i);
        Lowerer_lower_stmts(self, stmts);
        i = i - 1;
    }
}

/// Emit PersistSave instructions for all @persist variables.
/// Called before every Return statement and at implicit function end.
pub fn Lowerer_emit_persist_saves(self: &mut Lowerer) {
    var n: i64 = self.current_func.persist_vars.len();
    var i: i64 = 0;
    while i < n {
        var entry: StringValueId = self.current_func.persist_vars.get(i);
        // Look up the actual type of the persist variable
        var load_ty: IrType = IrType::I64;
        match Lowerer_lookup_alloca_type(self, entry.id) {
            OptIrType::Some(ty) => { load_ty = ty; }
            OptIrType::None => {}
        }
        var loaded: i64 = Lowerer_emit_inst(self, Inst::Load(entry.id, load_ty));
        var _s: i64 = Lowerer_emit_inst(self, Inst::PersistSave(entry.name, loaded));
        i = i + 1;
    }
}

// --- ValueIdString helper -------------------------------------------------

pub struct ValueIdString {
    pub id: i64,
    pub name: str,
}

pub fn lw_ValueIdString_new(id: i64, name: str) -> ValueIdString {
    return ValueIdString { id: id, name: name };
}

// --- String parsing helpers -----------------------------------------------

pub fn str_parse_u64(s: str) -> OptU64 {
    // Simple parsing: trim whitespace, parse digits
    var trimmed: str = str_trim(s);
    if trimmed == "" { return OptU64::None; }
    var result: i64 = 0;
    var i: i64 = 0;
    var len: i64 = str_len(trimmed);
    while i < len {
        var c: i64 = str_byte_at(trimmed, i);
        if c < 48 || c > 57 { return OptU64::None; }  // not a digit
        result = result * 10 + (c - 48);
        i = i + 1;
    }
    return OptU64::Some(result);
}

// --- Type inference helpers -----------------------------------------------

/// Infer Vec<T> element type from the let hint.
/// Returns IrType::I64 if no hint is available.
pub fn Lowerer_infer_vec_elem_type(self: &Lowerer) -> IrType {
    match self.let_hint {
        OptType::Some(ty) => {
            match ty {
                Type::Generic(name, args) => {
                    if name == "Vec" {
                        if args.len() > 0 {
                            return Lowerer_lower_type(self, args.get(0));
                        }
                    }
                    return IrType::I64;
                }
                _ => { return IrType::I64; }
            }
        }
        OptType::None => { return IrType::I64; }
    }
    return IrType::I64;
}

/// Infer HashMap<K,V> key and value types from the let hint.
/// Returns (Opaque("String"), I64) if no hint is available.
pub fn Lowerer_infer_map_types(self: &Lowerer) -> MapTypes {
    match self.let_hint {
        OptType::Some(ty) => {
            match ty {
                Type::Generic(name, args) => {
                    if name == "HashMap" {
                        var key_ty: IrType = IrType::Opaque("String");
                        var val_ty: IrType = IrType::I64;
                        if args.len() > 0 {
                            key_ty = Lowerer_lower_type(self, args.get(0));
                        }
                        if args.len() > 1 {
                            val_ty = Lowerer_lower_type(self, args.get(1));
                        }
                        return MapTypes_new(key_ty, val_ty);
                    }
                    return MapTypes_new(IrType::Opaque("String"), IrType::I64);
                }
                _ => { return MapTypes_new(IrType::Opaque("String"), IrType::I64); }
            }
        }
        OptType::None => { return MapTypes_new(IrType::Opaque("String"), IrType::I64); }
    }
    return MapTypes_new(IrType::Opaque("String"), IrType::I64);
}

pub struct MapTypes {
    pub key_ty: IrType,
    pub val_ty: IrType,
}

pub fn MapTypes_new(key_ty: IrType, val_ty: IrType) -> MapTypes {
    return MapTypes { key_ty: key_ty, val_ty: val_ty };
}

/// Infer a closure's return type from its body (last expression or return stmt).
/// Returns Type::I64 if no return expression is found.
pub fn Lowerer_infer_closure_ret_ty(self: &Lowerer, body: Vec<Stmt>) -> Type {
    var i: i64 = 0;
    while i < body.len() {
        match body.get(i) {
            Stmt::Return(expr, _) => {
                match expr {
                    OptBoxExpr::Some(e) => {
                        return Lowerer_infer_expr_ast_type(self, lw_box_expr_unbox(e));
                    }
                    OptBoxExpr::None => { return Type::Void; }
                }
            }
            Stmt::Expr(e, _) => {
                // Last expression in block (implicit return)
                return Lowerer_infer_expr_ast_type(self, e);
            }
            _ => {}
        }
        i = i + 1;
    }
    return Type::I64;
}

/// Infer the AST type of an expression (for closure return type inference).
/// This is a simplified version - returns Type::I64 for most expressions.
pub fn Lowerer_infer_expr_ast_type(self: &Lowerer, expr: Expr) -> Type {
    match expr {
        Expr::IntLit(_) => { return Type::I64; }
        Expr::FloatLit(_) => { return Type::F64; }
        Expr::BoolLit(_) => { return Type::Bool; }
        Expr::StringLit(_) => { return Type::Ref(Box::new(Type::U8), false); }
        Expr::Cast(_, ty) => { return ty; }
        Expr::Call(callee, _) => {
            match Lowerer_lookup_func_ret_type(self, callee) {
                OptType::Some(ty) => { return ty; }
                OptType::None => { return Type::I64; }
            }
        }
        _ => { return Type::I64; }
    }
    return Type::I64;
}

/// Convert an IrType back to an AST Type (for capture type recovery).
pub fn ir_type_to_ast_type(ty: IrType) -> Type {
    match ty {
        IrType::I8 => { return Type::I8; }
        IrType::I16 => { return Type::I16; }
        IrType::I32 => { return Type::I32; }
        IrType::I64 => { return Type::I64; }
        IrType::U8 => { return Type::U8; }
        IrType::U16 => { return Type::U16; }
        IrType::U32 => { return Type::U32; }
        IrType::U64 => { return Type::U64; }
        IrType::F32 => { return Type::F32; }
        IrType::F64 => { return Type::F64; }
        IrType::Bool => { return Type::Bool; }
        IrType::Void => { return Type::Void; }
        IrType::Never => { return Type::Never; }
        IrType::Ptr(inner) => { return Type::Ref(Box::new(ir_type_to_ast_type(box_ir_type_unbox(inner))), false); }
        IrType::Struct(name) => { return Type::Named(name); }
        IrType::Array(elem, size) => { return Type::Array(Box::new(ir_type_to_ast_type(box_ir_type_unbox(elem))), size); }
        IrType::Opaque(name) => { return Type::Named(name); }
        IrType::Generic(name, args) => {
            var ast_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                ast_args.push(ir_type_to_ast_type(args.get(i)));
                i = i + 1;
            }
            return Type::Generic(name, ast_args);
        }
        _ => { return Type::I64; }
    }
    return Type::I64;
}

/// Lower a swizzle expression (e.g. v.xyx) by loading components and building a result vec.
pub fn Lowerer_lower_swizzle(self: &mut Lowerer, vec_name: str, struct_ptr: i64, swizzle: str) -> i64 {
    // Get the field indices from the swizzle pattern
    // swizzle_index supports xyzw, rgba, and stpq groups
    var indices: Vec<i64> = Vec::new();
    var si: i64 = 0;
    while si < str_len(swizzle) {
        var c: i64 = str_byte_at(swizzle, si);
        indices.push(swizzle_index(c));
        si = si + 1;
    }

    // Load each component from the source vec
    var components: Vec<i64> = Vec::new();
    var ci: i64 = 0;
    while ci < indices.len() {
        var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(struct_ptr, indices.get(ci), IrType::F64));
        components.push(Lowerer_emit_inst(self, Inst::Load(field_ptr, IrType::F64)));
        ci = ci + 1;
    }

    // Construct the result vec type
    var result_name: str = "vec3";
    var swizzle_len: i64 = str_len(swizzle);
    if swizzle_len == 2 { result_name = "vec2"; }
    else if swizzle_len == 3 { result_name = "vec3"; }
    else if swizzle_len == 4 { result_name = "vec4"; }

    var result_ty: IrType = IrType::Struct(result_name);
    var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(result_ty, Lowerer_current_region(self)));

    // Store each component into the result struct
    var i: i64 = 0;
    while i < components.len() {
        var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(sret_ptr, i, IrType::F64));
        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, components.get(i), OptIrType::None));
        i = i + 1;
    }
    return sret_ptr;
}

/// Emit an SRET-style call for vec-returning methods.
/// Allocates a struct slot, calls the function with sret_ptr as first arg, returns sret_ptr.
pub fn Lowerer_lower_vec_sret_call(self: &mut Lowerer, func_name: str, ret_ty: IrType, recv_val: i64, arg_val: i64) -> i64 {
    var struct_name: str = "";
    match ret_ty {
        IrType::Struct(n) => { struct_name = n; }
        _ => {}
    }
    var sret_ptr: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::Struct(struct_name), Lowerer_current_region(self)));
    var sret_args: Vec<i64> = Vec::new();
    sret_args.push(sret_ptr);
    // Prepend dummy env_ptr for user functions
    if !Lowerer_is_extern_func(self, func_name) {
        var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        sret_args.push(dummy_env);
    }
    sret_args.push(recv_val);
    sret_args.push(arg_val);
    // Look up the function's effects from the module's function effect table
    var effects: EffectSet = EffectSet_new();
    var fi: i64 = 0;
    while fi < self.module.function_effects.len() {
        if self.module.function_effects.get(fi).name == func_name {
            EffectSet_add_all(&mut effects, &self.module.function_effects.get(fi).effects);
            break;
        }
        fi = fi + 1;
    }
    var _call: i64 = Lowerer_emit_inst(self, Inst::Call(func_name, sret_args, IrType::Void, effects));
    return sret_ptr;
}
