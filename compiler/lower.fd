        }
        Expr::Match(e, arms) => {
            return Lowerer_lower_match_expr(self, e, arms);
        }
        Expr::Try(e) => {
            return Lowerer_lower_try_expr(self, e);
        }
        Expr::Coalesce(left, right) => {
            // `opt ?? default` (src/lower.rs): Option is { tag, value } with
            // tag 0 = Some; Some yields the value, None evaluates default.
            // The result has the payload's type when it is a string or a
            // float (known-bugs 2g.54: an i64 word printed a pointer and
            // broke `"a" + (o ?? "b")`; an f64 printed its bits)
            var cty: IrType = Lowerer_coalesce_ir_type(self, lw_box_expr_unbox(left), lw_box_expr_unbox(right));
            var c_is_str: bool = ir_type_eq(cty, lw_ptr_u8());
            var c_is_float: bool = ir_type_is_float(cty);
            // BG230: a payload that owns something (str, Vec, map): the
            // result is a new owner on either path, a temporary of the
            // statement (whoever keeps it claims it). The default's owner
            // was claimed and the kept result counted once more, so a new
            // default leaked.
            var c_own: Type = Type::Infer;
            if self.own_on {
                c_own = Lowerer_coalesce_own_type(self, lw_box_expr_unbox(left));
            }
            var c_owned: bool = Lowerer_rc_kind(self, c_own) != RC_NONE;
            var val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(left));
            var result_slot: i64 = Lowerer_emit_inst(self, Inst::Alloca(cty, Lowerer_current_region(self)));
            var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 0, IrType::I64));
            var tag: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));
            var some_block: i64 = Lowerer_new_block(self);
            var none_block: i64 = Lowerer_new_block(self);
            var merge_block: i64 = Lowerer_new_block(self);
            var zero_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            var is_some: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag, zero_val, IrType::Bool));
            Lowerer_emit_terminator(self, Inst::Branch(is_some, some_block, none_block));

            Lowerer_set_current_block(self, some_block);
            var some_val: i64 = 0;
            // BG273: a narrow integer or bool payload is read as its type
            var c_is_narrow: bool = lw_narrow_word(cty);
            if c_is_float || c_is_narrow {
                // the payload word holds the float's bits (as the `?` path)
                var fval_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 1, cty));
                some_val = Lowerer_emit_inst(self, Inst::Load(fval_ptr, cty));
            } else {
                var val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 1, IrType::I64));
                some_val = Lowerer_emit_inst(self, Inst::Load(val_ptr, IrType::I64));
                if c_is_str {
                    some_val = Lowerer_emit_inst(self, Inst::BitCast(some_val, IrType::I64, cty));
                }
                // BG230: the result's own owner of the borrowed payload
                if c_owned {
                    some_val = Lowerer_rc_dup(self, some_val, c_own);
                }
            }
            var _s1: i64 = Lowerer_emit_inst(self, Inst::Store(result_slot, some_val, OptIrType::None));
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));

            Lowerer_set_current_block(self, none_block);
            // The default runs only when the option is None: its temporaries
            // end here, and a new default value is the result's (BG230: an
            // owning result takes an owner of the default: a new one is
            // handed over, anything else counted once more)
            var dmark: i64 = self.own_temps.len();
            var default_val: i64 = Lowerer_lower_expr(self, lw_box_expr_unbox(right));
            if c_owned {
                default_val = Lowerer_rc_own_value(self, default_val, c_own);
            } else {
                Lowerer_rc_claim(self, default_val);
            }
            Lowerer_rc_flush(self, dmark);
            var dty: IrType = Lowerer_get_value_type(self, default_val);
