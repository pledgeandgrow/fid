            }
            var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(result_slot, default_val, OptIrType::None));
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));

            Lowerer_set_current_block(self, merge_block);
            var c_res: i64 = Lowerer_emit_inst(self, Inst::Load(result_slot, cty));
