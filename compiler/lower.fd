                var is_match: bool = false;
                match ety {
                    IrType::I64 => {
                        is_match = variant == "i64";
                    }
                    IrType::I32 => {
                        is_match = variant == "i32";
                    }
                    IrType::I8 => {
                        is_match = variant == "i8";
                    }
                    IrType::I16 => {
                        is_match = variant == "i16";
                    }
                    IrType::U64 => {
                        is_match = variant == "u64";
                    }
                    IrType::U32 => {
                        is_match = variant == "u32";
                    }
                    IrType::U8 => {
                        is_match = variant == "u8";
                    }
                    IrType::U16 => {
                        is_match = variant == "u16";
                    }
                    IrType::F64 => {
                        is_match = variant == "f64";
                    }
                    IrType::F32 => {
                        is_match = variant == "f32";
                    }
                    IrType::Bool => {
                        is_match = variant == "bool";
                    }
                    IrType::Void => {
                        is_match = variant == "void";
