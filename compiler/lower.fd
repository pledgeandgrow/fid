    Lowerer_add_extern_2(self, "p_simd_scale", simd_ty, IrType::F64, simd_ty);
    Lowerer_add_extern_1(self, "p_simd_from_vec", vec_i64_ty, simd_ty);
    Lowerer_add_extern_1(self, "p_simd_to_str", simd_ty, lw_ptr_u8());

    // HTTP/Socket
    Lowerer_add_extern_1(self, "p_socket_listen", IrType::I64, IrType::I64);
    Lowerer_add_extern_1(self, "p_socket_accept", IrType::I64, IrType::I64);
    Lowerer_add_extern_2(self, "p_socket_read", IrType::I64, vec_i64_ty, IrType::I64);
    Lowerer_add_extern_2(self, "p_socket_write", IrType::I64, vec_i64_ty, IrType::I64);
    Lowerer_add_extern_1(self, "p_socket_close", IrType::I64, IrType::Void);
    Lowerer_add_extern_1(self, "p_socket_recv_str", IrType::I64, lw_ptr_u8());
