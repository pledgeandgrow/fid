// ─── Lower program ────────────────────────────────────────────────────────

pub fn Lowerer_lower_program(self: &mut Lowerer, program: Program) -> IrModule {
    // Register constants
    var i: i64 = 0;
    while i < program.consts.len() {
        var c: ConstDef = program.consts.get(i);
        Lowerer_insert_constant(self, c.name, c.expr);
        i = i + 1;
    }

    // Register type aliases
    i = 0;
    while i < program.type_aliases.len() {
        var ta: TypeAlias = program.type_aliases.get(i);
        Lowerer_insert_type_alias(self, ta.name, ta.alias_for);
        i = i + 1;
    }

    // Register struct definitions
    i = 0;
    while i < program.structs.len() {
        var s: StructDef = program.structs.get(i);
        Lowerer_insert_struct(self, s.name, s);
        // Track @linear structs
        var j: i64 = 0;
        while j < s.annotations.len() {
            if str_equal(s.annotations.get(j).name, "linear") {
                Lowerer_insert_linear_struct(self, s.name);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Register enum definitions
    i = 0;
    while i < program.enums.len() {
        var e: EnumDef = program.enums.get(i);
        Lowerer_insert_enum(self, e.name, e);
        i = i + 1;
    }

    // Register user-defined extern functions
    i = 0;
    while i < program.extern_decls.len() {
        var ext: ExternDecl = program.extern_decls.get(i);
        var param_types: Vec<IrType> = Vec::new();
        var j: i64 = 0;
        while j < ext.params.len() {
            param_types.push(Lowerer_lower_type(self, ext.params.get(j).ty));
            j = j + 1;
        }
        var ret_type: IrType = Lowerer_lower_type(self, ext.ret_ty);
        IrModule_add_extern(&mut self.module, ext.pledge_name, param_types, ret_type);
        self.module.extern_decls.push(ext);
        i = i + 1;
    }

    // Register impl methods
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var j: i64 = 0;
        while j < imp.methods.len() {
            var method: Func = imp.methods.get(j);
            Lowerer_insert_impl_method(self, imp.struct_name, method.name, method);
            Lowerer_insert_func_ret_type(self, method.name, method.ret_ty);
            j = j + 1;
        }
        i = i + 1;
    }

    // Register trait impl methods
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var j: i64 = 0;
        while j < ti.methods.len() {
            var method: Func = ti.methods.get(j);
            Lowerer_insert_impl_method(self, ti.type_name, method.name, method);
            Lowerer_insert_func_ret_type(self, method.name, method.ret_ty);
            j = j + 1;
        }
        i = i + 1;
    }

    // Register trait method names
    i = 0;
    while i < program.traits.len() {
        var td: TraitDef = program.traits.get(i);
        var methods: Vec<str> = Vec::new();
        var j: i64 = 0;
        while j < td.methods.len() {
            methods.push(td.methods.get(j).name);
            j = j + 1;
        }
        self.module.trait_methods.push(StringVecStr_new(td.name, methods));
        i = i + 1;
    }

    // Register trait implementations
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        // Find or create entry for trait_name
        var found: bool = false;
        var j: i64 = 0;
        while j < self.module.trait_impls.len() {
            if str_equal(self.module.trait_impls.get(j).name, ti.trait_name) {
                self.module.trait_impls.get(j).items.push(ti.type_name);
                found = true;
            }
            j = j + 1;
        }
        if !found {
            var types: Vec<str> = Vec::new();
            types.push(ti.type_name);
            self.module.trait_impls.push(StringVecStr_new(ti.trait_name, types));
        }
        i = i + 1;
    }

    // Compute enum layouts first
    i = 0;
    while i < program.enums.len() {
        Lowerer_compute_enum_layout(self, program.enums.get(i));
        i = i + 1;
    }

    // Compute struct layouts
    i = 0;
    while i < program.structs.len() {
        Lowerer_compute_struct_layout(self, program.structs.get(i));
        i = i + 1;
    }

    // Register runtime
    Lowerer_register_runtime(self);

    // Pre-register all function signatures
    i = 0;
    while i < program.funcs.len() {
        var func: Func = program.funcs.get(i);
        var ret_ty: IrType = Lowerer_lower_type(self, func.ret_ty);
        var ir_func: IrFunction = IrFunction_new(func.name, ret_ty);
        IrModule_add_function(&mut self.module, ir_func);
        Lowerer_insert_func_ret_type(self, func.name, func.ret_ty);
        if func.is_async {
            Lowerer_insert_async_func(self, func.name);
        }
        i = i + 1;
    }

    // Lower each function
    i = 0;
    while i < program.funcs.len() {
        Lowerer_lower_func(self, program.funcs.get(i));
        i = i + 1;
    }

    // Lower impl methods (mangled as {StructName}_{method})
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var saved_self: OptStringLower = self.current_self_type;
        self.current_self_type = OptStringLower::Some(imp.struct_name);
        var j: i64 = 0;
        while j < imp.methods.len() {
            var method: Func = imp.methods.get(j);
            var mangled: Func = method;
            mangled.name = imp.struct_name + "_" + method.name;
            // Resolve Self in param types and return type
            var new_params: Vec<Param> = Vec::new();
            var k: i64 = 0;
            while k < mangled.params.len() {
                var p: Param = mangled.params.get(k);
                p.ty = Lowerer_resolve_self_in_type(self, p.ty);
                new_params.push(p);
                k = k + 1;
            }
            mangled.params = new_params;
            mangled.ret_ty = Lowerer_resolve_self_in_type(self, mangled.ret_ty);
            Lowerer_lower_func(self, mangled);
            j = j + 1;
        }
        self.current_self_type = saved_self;
        i = i + 1;
    }

    // Lower trait impl methods
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var saved_self: OptStringLower = self.current_self_type;
        self.current_self_type = OptStringLower::Some(ti.type_name);
        var j: i64 = 0;
        while j < ti.methods.len() {
            var method: Func = ti.methods.get(j);
            var mangled: Func = method;
            mangled.name = ti.type_name + "_" + method.name;
            var new_params: Vec<Param> = Vec::new();
            var k: i64 = 0;
            while k < mangled.params.len() {
                var p: Param = mangled.params.get(k);
                p.ty = Lowerer_resolve_self_in_type(self, p.ty);
                new_params.push(p);
                k = k + 1;
            }
            mangled.params = new_params;
            mangled.ret_ty = Lowerer_resolve_self_in_type(self, mangled.ret_ty);
            Lowerer_lower_func(self, mangled);
            j = j + 1;
        }
        self.current_self_type = saved_self;
        i = i + 1;
    }

    // Propagate linear_structs to IR module
    self.module.linear_structs = self.linear_structs;

    return self.module;
}

// ─── Public entry point ───────────────────────────────────────────────────

pub fn lower(program: Program) -> IrModule {
    var l: Lowerer = Lowerer_new();
    return Lowerer_lower_program(&mut l, program);
}

// ─── Lower function (stub — implemented in Part 3) ────────────────────────

// ─── Annotation helpers ───────────────────────────────────────────────────

pub fn has_annotation(annotations: Vec<Annotation>, name: str) -> bool {
    var i: i64 = 0;
    while i < annotations.len() {
        if str_equal(annotations.get(i).name, name) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn find_annotation(annotations: Vec<Annotation>, name: str) -> OptAnnotation {
    var i: i64 = 0;
    while i < annotations.len() {
        if str_equal(annotations.get(i).name, name) { return OptAnnotation::Some(annotations.get(i)); }
        i = i + 1;
    }
    return OptAnnotation::None;
}

pub enum OptAnnotation {
    Some(Annotation),
    None,
}

// ─── Lower function ───────────────────────────────────────────────────────

pub fn Lowerer_lower_func(self: &mut Lowerer, func: Func) {
    var ret_ty: IrType = Lowerer_lower_type(self, func.ret_ty);
    var ir_func: IrFunction = IrFunction_new(func.name, ret_ty);
    ir_func.is_interrupt = func.is_interrupt;
    ir_func.is_wrapping = has_annotation(func.annotations, "wrapping");
    ir_func.is_deterministic = has_annotation(func.annotations, "deterministic");
    ir_func.is_crashfree = has_annotation(func.annotations, "crashfree");
    ir_func.is_no_alloc = has_annotation(func.annotations, "no-alloc") || has_annotation(func.annotations, "medical");
    ir_func.is_medical = has_annotation(func.annotations, "medical");
    ir_func.is_kernel = has_annotation(func.annotations, "kernel");

    // Parse @gas(N) annotation
    match find_annotation(func.annotations, "gas") {
        OptAnnotation::Some(kann) => {
            if kann.args.len() > 0 {
                match str_parse_u64(kann.args.get(0)) {
                    OptU64::Some(v) => { ir_func.gas_limit = OptU64::Some(v); }
                    OptU64::None => {}
                }
            }
        }
        OptAnnotation::None => {}
    }

    // Parse @kernel workgroup size
    if ir_func.is_kernel {
        match find_annotation(func.annotations, "kernel") {
            OptAnnotation::Some(kann) => {
                if kann.args.len() > 0 {
                    // Join args with "," and parse as [x,y,z] or x,y,z
                    var args_str: str = "";
                    var ai: i64 = 0;
                    while ai < kann.args.len() {
                        if ai > 0 { args_str = args_str + ","; }
                        args_str = args_str + kann.args.get(ai);
                        ai = ai + 1;
                    }
                    // Simple parsing: split by ',' and parse each part
                    var parts: Vec<str> = str_split_char(args_str, 44);  // 44 = ','
                    if parts.len() >= 3 {
                        match str_parse_u64(str_trim(parts.get(0))) {
                            OptU64::Some(x) => {
                                match str_parse_u64(str_trim(parts.get(1))) {
                                    OptU64::Some(y) => {
                                        match str_parse_u64(str_trim(parts.get(2))) {
                                            OptU64::Some(z) => {
                                                ir_func.workgroup_size = Vec::new();
                                                ir_func.workgroup_size.push(x);
                                                ir_func.workgroup_size.push(y);
                                                ir_func.workgroup_size.push(z);
                                            }
                                            OptU64::None => {}
                                        }
                                    }
                                    OptU64::None => {}
                                }
                            }
                            OptU64::None => {}
                        }
                    } else if parts.len() == 1 {
                        match str_parse_u64(str_trim(parts.get(0))) {
                            OptU64::Some(x) => {
                                ir_func.workgroup_size = Vec::new();
                                ir_func.workgroup_size.push(x);
                                ir_func.workgroup_size.push(1);
                                ir_func.workgroup_size.push(1);
                            }
                            OptU64::None => {}
                        }
                    }
                }
            }
            OptAnnotation::None => {}
        }
    }

    // SRET parameter for struct-returning functions
    var is_struct_ret: bool = false;
    match ret_ty {
        IrType::Struct(_) => { is_struct_ret = true; }
        _ => { is_struct_ret = false; }
    }

    if is_struct_ret {
        var sret_ty: IrType = IrType::Ptr(Box::new(ret_ty));
        var sret_meta: ValueMeta = ValueMeta_new(sret_ty);
        sret_meta.region = Lowerer_current_region(self);
        var sret_val: i64 = IrFunction_new_value(&mut ir_func, sret_meta);
        ir_func.params.push(ValueIdType_new(sret_val, sret_ty));
        self.current_sret = OptValueId::Some(sret_val);
    } else {
        self.current_sret = OptValueId::None;
    }

    // __env parameter (for uniform CallPtr calling convention)
    var env_meta: ValueMeta = ValueMeta_new(IrType::Ptr(Box::new(IrType::U8)));
    env_meta.region = Lowerer_current_region(self);
    var env_val: i64 = IrFunction_new_value(&mut ir_func, env_meta);
    ir_func.params.push(ValueIdType_new(env_val, IrType::Ptr(Box::new(IrType::U8))));
    IrFunction_bind_local(&mut ir_func, "__env", env_val);

    // User parameters
    var i: i64 = 0;
    while i < func.params.len() {
        var param: Param = func.params.get(i);
        var raw_ty: IrType = Lowerer_lower_type(self, param.ty);
        var is_linear: bool = Lowerer_is_linear_ir_type(self, raw_ty);
        // Struct params are passed as pointers (by-ref)
        var ir_ty: IrType = raw_ty;
        match raw_ty {
            IrType::Struct(_) => { ir_ty = IrType::Ptr(Box::new(raw_ty)); }
            _ => { ir_ty = raw_ty; }
        }
        var meta: ValueMeta = ValueMeta_new(ir_ty);
        meta.region = Lowerer_current_region(self);
        meta.is_linear = is_linear;
        var val: i64 = IrFunction_new_value(&mut ir_func, meta);
        ir_func.params.push(ValueIdType_new(val, ir_ty));
        IrFunction_bind_local(&mut ir_func, param.name, val);
        i = i + 1;
    }

    // Set as current function
    var prev_func: IrFunction = self.current_func;
    var prev_has_func: bool = self.has_current_func;
    // Save the name separately — struct assignment can corrupt string fields
    // in the Fides interpreter.
    var func_name_saved: str = func.name;
    self.current_func = ir_func;
    // Re-assign the name to ensure it's valid
    self.current_func.name = func_name_saved;
    self.has_current_func = true;
    self.current_block = 0;

    // Clear per-function state
    var empty_allocas: Vec<StringValueIdEntry> = Vec::new();
    self.allocas = empty_allocas;
    var empty_alloca_types: Vec<I64IrTypeEntry> = Vec::new();
    self.alloca_types = empty_alloca_types;
    var empty_var_ast_types: Vec<StringTypeEntry> = Vec::new();
    self.var_ast_types = empty_var_ast_types;
    var empty_defer_stack: Vec<StmtVec> = Vec::new();
    self.defer_stack = empty_defer_stack;
    var empty_param_types: Vec<StringTypeEntry> = Vec::new();
    self.current_func_param_types = empty_param_types;

    // Register parameter AST types (after clearing per-function state)
    var pi: i64 = 0;
    while pi < func.params.len() {
        var pparam: Param = func.params.get(pi);
        Lowerer_insert_var_ast_type(self, pparam.name, pparam.ty);
        pi = pi + 1;
    }

    // Save AST parameter types
    i = 0;
    while i < func.params.len() {
        var p: Param = func.params.get(i);
        Lowerer_insert_param_type(self, p.name, p.ty);
        i = i + 1;
    }

    // @audit annotation: emit log calls at function entry/exit
    var is_audited: bool = has_annotation(func.annotations, "audit");
    if is_audited {
        var entry_msg: i64 = Lowerer_emit_inst(self, Inst::ConstStr("[AUDIT] enter " + func.name + "\n"));
        var _p: i64 = Lowerer_emit_inst(self, Inst::Print(entry_msg, IrType::Ptr(Box::new(IrType::U8))));
        // Exit log via defer
        var exit_stmts: Vec<Stmt> = Vec::new();
        var exit_args: Vec<Expr> = Vec::new();
        exit_args.push(Expr::StringLit("[AUDIT] exit " + func.name + "\n"));
        exit_stmts.push(Stmt::Expr(Expr::Call("print", exit_args), 0));
        self.defer_stack.push(StmtVec_from(exit_stmts));
    }

    // Lower the function body
    var last_expr_val: OptValueId = OptValueId::None;
    i = 0;
    while i < func.body.len() {
        var stmt: Stmt = func.body.get(i);
        match stmt {
            Stmt::Expr(expr, _) => {
                var val: i64 = Lowerer_lower_expr(self, expr);
                last_expr_val = OptValueId::Some(val);
            }
            _ => {
                last_expr_val = OptValueId::None;
                Lowerer_lower_stmt(self, stmt);
            }
        }
        i = i + 1;
    }

    // Ensure the function ends with a return
    if !Lowerer_current_block_has_terminator(self) {
        // Emit drops and defers
        Lowerer_emit_drops(self);
        Lowerer_emit_defers(self);

        match self.current_sret {
            OptValueId::Some(_) => {
                // Struct-returning function: copy struct data to sret, return void
                match last_expr_val {
                    OptValueId::Some(sret_val) => { Lowerer_emit_sret_copy(self, sret_val); }
                    OptValueId::None => {}
                }
                Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
            }
            OptValueId::None => {
                // Non-struct return
                if ir_type_eq(self.current_func.ret_ty, IrType::Void) {
                    Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
                } else {
                    match last_expr_val {
                        OptValueId::Some(ret_val) => {
                            Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(ret_val)));
                        }
                        OptValueId::None => {
                            // Implicit return of 0 for non-void functions
                            var ret_ty2: IrType = self.current_func.ret_ty;
                            var zero_meta: ValueMeta = ValueMeta_new(ret_ty2);
                            zero_meta.region = Lowerer_current_region(self);
                            var zid: i64 = IrFunction_new_value(&mut self.current_func, zero_meta);
                            var zero_inst: Inst;
                            match ret_ty2 {
                                IrType::F32 => { zero_inst = Inst::ConstFloat(0.0, ret_ty2); }
                                IrType::F64 => { zero_inst = Inst::ConstFloat(0.0, ret_ty2); }
                                IrType::Bool => { zero_inst = Inst::ConstBool(false); }
                                _ => { zero_inst = Inst::ConstInt(0, ret_ty2); }
                            }
                            IrFunction_set_inst(&mut self.current_func, zid, zero_inst);
                            // Add to current block
                            self.current_func.blocks.get(self.current_block).instructions.push(zid);
                            Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(zid)));
                        }
                    }
                }
            }
        }
    }

    // Compute function effects from all instructions
    var func_effects: EffectSet = EffectSet_new();
    var fi: i64 = 0;
    while fi < self.current_func.insts.len() {
        var inst: Inst = self.current_func.insts.get(fi).inst;
        var inst_eff: EffectSet = inst_effects(&inst);
        EffectSet_add_all(&mut func_effects, &inst_eff);
        fi = fi + 1;
    }
    self.current_func.effects = func_effects;

    // Store function effects in module
    self.module.function_effects.push(StringEffectSetEntry_new(func.name, func_effects));

    // Store the function in the module (replacing pre-registered entry)
    // Save the name first to avoid string corruption when moving the struct.
    var finished_name: str = self.current_func.name;
    IrModule_replace_function_named(&mut self.module, self.current_func, finished_name);
}

// ─── Lower statements ─────────────────────────────────────────────────────

pub fn Lowerer_lower_stmts(self: &mut Lowerer, stmts: Vec<Stmt>) {
    var i: i64 = 0;
    while i < stmts.len() {
        Lowerer_lower_stmt(self, stmts.get(i));
        i = i + 1;
    }
}

pub fn Lowerer_lower_stmt(self: &mut Lowerer, stmt: Stmt) {
    match stmt {
        Stmt::Let(name, ty, expr, _is_mut, is_persist, _line) => {
            // Set let hint
            var saved_hint: OptType = self.let_hint;
            match ty {
                OptType::Some(t) => {
                    self.let_hint = OptType::Some(Lowerer_resolve_self_in_type(self, t));
                }
                OptType::None => {}
            }

            var val: i64 = Lowerer_lower_expr(self, expr);
            self.let_hint = saved_hint;

            // Determine IR type for alloca
            var val_ty: IrType = Lowerer_get_value_type(self, val);
            var ir_ty: IrType = val_ty;
            match ty {
                OptType::Some(t) => {
                    var declared_ir: IrType = Lowerer_lower_type(self, t);
                    if ir_type_is_aggregate(declared_ir) && ir_type_is_ptr(val_ty) {
                        ir_ty = val_ty;
                    } else {
                        ir_ty = declared_ir;
                    }
                }
                OptType::None => { ir_ty = val_ty; }
            }

            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(ir_ty, Lowerer_current_region(self)));
            Lowerer_insert_alloca_type(self, alloca, ir_ty);

            if is_persist {
                var loaded: i64 = Lowerer_emit_inst(self, Inst::PersistLoad(name, val, ir_ty));
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, loaded, OptIrType::None));
                self.current_func.persist_vars.push(StringValueId_new(name, alloca));
            } else {
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, val, OptIrType::None));
            }

            Lowerer_insert_alloca(self, name, alloca);

            // Record AST type
            match ty {
                OptType::Some(ast_ty) => {
                    Lowerer_insert_var_ast_type(self, name, ast_ty);
                }
                OptType::None => {
                    var inferred: Type = Lowerer_infer_expr_ast_type(self, expr);
                    match inferred {
                        Type::I64 => {}
                        _ => { Lowerer_insert_var_ast_type(self, name, inferred); }
                    }
                }
            }

            // Drop trait: check if the declared type has a Drop impl
            var drop_struct: OptStringLower = OptStringLower::None;
            match ty {
                OptType::Some(t) => {
                    var sn: OptStringLower = Lowerer_type_struct_name(self, t);
                    match sn {
                        OptStringLower::Some(name2) => {
                            if Lowerer_has_drop_impl(self, name2) {
                                drop_struct = OptStringLower::Some(name2);
                            }
                        }
                        OptStringLower::None => {}
                    }
                }
                OptType::None => {}
            }

            Lowerer_bind_local(self, name, alloca);
            match drop_struct {
                OptStringLower::Some(struct_name) => {
                    self.current_func.drop_locals.push(ValueIdString_new(alloca, struct_name));
                }
                OptStringLower::None => {}
            }
        }
        Stmt::LetUninit(name, ty, _line) => {
            var ir_ty: IrType = Lowerer_lower_type(self, ty);
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(ir_ty, Lowerer_current_region(self)));
            Lowerer_insert_alloca_type(self, alloca, ir_ty);
            Lowerer_insert_alloca(self, name, alloca);
            Lowerer_bind_local(self, name, alloca);
        }
        Stmt::LetTuple(names, expr, _line) => {
            var tuple_ptr: i64 = Lowerer_lower_expr(self, expr);
            var n: i64 = names.len();
            // Destructure tuple: each element is at offset i*8
            var ti: i64 = 0;
            while ti < n {
                var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(tuple_ptr, ti, IrType::I64));
                var elem_val: i64 = Lowerer_emit_inst(self, Inst::Load(elem_ptr, IrType::I64));
                var name: str = names.get(ti);
                var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
                Lowerer_insert_alloca_type(self, alloca, IrType::I64);
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, elem_val, OptIrType::None));
                Lowerer_insert_alloca(self, name, alloca);
                Lowerer_bind_local(self, name, alloca);
                ti = ti + 1;
            }
        }
        Stmt::Assign(name, op, expr, _line) => {
            // Look up alloca for mutable variable
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(alloca) => {
                    var val: i64 = Lowerer_lower_expr(self, expr);
                    match op {
                        AssignOp::Assign => {
                            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, val, OptIrType::None));
                        }
                        _ => {
                            // Compound assignment: load current, apply op, store
                            var alloca_ty: IrType = IrType::I64;
                            match Lowerer_lookup_alloca_type(self, alloca) {
                                OptIrType::Some(t) => { alloca_ty = t; }
                                OptIrType::None => {}
                            }
                            var current: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, alloca_ty));
                            var result: i64 = Lowerer_lower_compound_assign(self, op, current, val);
                            var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, result, OptIrType::None));
                        }
                    }
                }
                OptValueId::None => {
                    // Not an alloca — try local binding
                    match Lowerer_lookup_local(self, name) {
                        OptValueId::Some(local) => {
                            var val: i64 = Lowerer_lower_expr(self, expr);
                            // Direct assignment to local ( SSA — but we support it)
                            Lowerer_set_value_type(self, local, Lowerer_get_value_type(self, val));
                        }
                        OptValueId::None => {}
                    }
                }
            }
        }
        Stmt::Expr(expr, _line) => {
            var _v: i64 = Lowerer_lower_expr(self, expr);
        }
        Stmt::Return(expr, _line) => {
            // Emit drops and defers before return
            Lowerer_emit_drops(self);
            Lowerer_emit_defers(self);

            match expr {
                OptBoxExpr::Some(e) => {
                    match self.current_sret {
                        OptValueId::Some(sret) => {
                            var val: i64 = Lowerer_lower_expr(self, box_expr_unbox(e));
                            Lowerer_emit_sret_copy(self, val);
                            Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
                        }
                        OptValueId::None => {
                            var val: i64 = Lowerer_lower_expr(self, box_expr_unbox(e));
                            Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(val)));
                        }
                    }
                }
                OptBoxExpr::None => {
                    Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _line) => {
            var cond_val: i64 = Lowerer_lower_expr(self, cond);
            var then_block_id: i64 = Lowerer_new_block(self);
            var else_block_id: i64 = Lowerer_new_block(self);
            var merge_block_id: i64 = Lowerer_new_block(self);
            Lowerer_emit_terminator(self, Inst::Branch(cond_val, then_block_id, else_block_id));
            Lowerer_set_current_block(self, then_block_id);
            Lowerer_lower_stmts(self, then_block);
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(merge_block_id));
            }
            Lowerer_set_current_block(self, else_block_id);
            match else_block {
                OptStmts::Some(else_stmts) => { Lowerer_lower_stmts(self, else_stmts); }
                OptStmts::None => {}
            }
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(merge_block_id));
            }
            Lowerer_set_current_block(self, merge_block_id);
        }
        Stmt::While(cond, body, _line) => {
            Lowerer_lower_while(self, cond, body);
        }
        Stmt::For(loop_var, iterator, body, _line) => {
            Lowerer_lower_for(self, loop_var, iterator, body);
        }
        Stmt::Loop(body, _line) => {
            Lowerer_lower_loop(self, body);
        }
        Stmt::Break(expr, _line) => {
            // Set break value if in loop-as-expression context
            match expr {
                OptBoxExpr::Some(e) => {
                    var val: i64 = Lowerer_lower_expr(self, box_expr_unbox(e));
                    if self.loop_stack.len() > 0 {
                        var ctx: LoopContext = self.loop_stack.get(self.loop_stack.len() - 1);
                        match ctx.result_slot {
                            OptValueId::Some(slot) => {
                                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(slot, val, OptIrType::None));
                            }
                            OptValueId::None => {}
                        }
                    }
                }
                OptBoxExpr::None => {}
            }
            // Jump to break target
            if self.loop_stack.len() > 0 {
                var ctx2: LoopContext = self.loop_stack.get(self.loop_stack.len() - 1);
                Lowerer_emit_terminator(self, Inst::Jump(ctx2.break_target));
            }
        }
        Stmt::Continue(_line) => {
            if self.loop_stack.len() > 0 {
                var ctx: LoopContext = self.loop_stack.get(self.loop_stack.len() - 1);
                Lowerer_emit_terminator(self, Inst::Jump(ctx.continue_target));
            }
        }
        Stmt::Defer(body, _line) => {
            self.defer_stack.push(StmtVec_from(body));
        }
        Stmt::Match(expr, arms, _line) => {
            Lowerer_lower_match(self, expr, arms);
        }
        Stmt::IndexAssign(array_name, index, op, expr, _line) => {
            // Look up the array variable — alloca or local
            var arr_val: i64 = 0;
            match Lowerer_lookup_alloca(self, array_name) {
                OptValueId::Some(alloca) => {
                    var alloca_ty: IrType = IrType::I64;
                    match Lowerer_lookup_alloca_type(self, alloca) {
                        OptIrType::Some(t) => { alloca_ty = t; }
                        OptIrType::None => {}
                    }
                    arr_val = Lowerer_emit_inst(self, Inst::Load(alloca, alloca_ty));
                }
                OptValueId::None => {
                    match Lowerer_lookup_local(self, array_name) {
                        OptValueId::Some(local) => { arr_val = local; }
                        OptValueId::None => {
                            arr_val = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                        }
                    }
                }
            }

            var idx_val: i64 = Lowerer_lower_expr(self, index);
            var arr_ty: IrType = Lowerer_get_value_type(self, arr_val);

            // Vec indexing — call Vec_set / Vec_get
            if ir_type_is_opaque_named(arr_ty, "Vec") {
                var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                match op {
                    AssignOp::Assign => {
                        var val: i64 = Lowerer_lower_expr(self, expr);
                        var args: Vec<i64> = Vec::new();
                        args.push(dummy_env);
                        args.push(arr_val);
                        args.push(idx_val);
                        args.push(val);
                        var _c: i64 = Lowerer_emit_inst(self, Inst::Call("Vec_set", args, IrType::Void, EffectSet_new()));
                    }
                    _ => {
                        // Compound: Vec_get, binop, Vec_set
                        var get_args: Vec<i64> = Vec::new();
                        get_args.push(dummy_env);
                        get_args.push(arr_val);
                        get_args.push(idx_val);
                        var current: i64 = Lowerer_emit_inst(self, Inst::Call("Vec_get", get_args, IrType::I64, EffectSet_new()));
                        var rhs: i64 = Lowerer_lower_expr(self, expr);
                        var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                        var set_args: Vec<i64> = Vec::new();
                        set_args.push(dummy_env);
                        set_args.push(arr_val);
                        set_args.push(idx_val);
                        set_args.push(new_val);
                        var _c2: i64 = Lowerer_emit_inst(self, Inst::Call("Vec_set", set_args, IrType::Void, EffectSet_new()));
                    }
                }
            } else {
                // Raw array indexing
                var elem_ty: IrType = IrType::I64;
                match arr_ty {
                    IrType::Array(inner, _) => { elem_ty = inner; }
                    _ => {}
                }
                var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(arr_val, idx_val, elem_ty));
                match op {
                    AssignOp::Assign => {
                        var val: i64 = Lowerer_lower_expr(self, expr);
                        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(elem_ptr, val, OptIrType::None));
                    }
                    _ => {
                        var current: i64 = Lowerer_emit_inst(self, Inst::Load(elem_ptr, elem_ty));
                        var rhs: i64 = Lowerer_lower_expr(self, expr);
                        var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                        var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(elem_ptr, new_val, OptIrType::None));
                    }
                }
            }
        }
        Stmt::DerefAssign(ptr_expr, op, expr, _line) => {
            var ptr_val: i64 = Lowerer_lower_expr(self, ptr_expr);
            var pointee_ty: IrType = IrType::I64;
            match Lowerer_get_value_type(self, ptr_val) {
                IrType::Ptr(inner) => { pointee_ty = inner; }
                _ => {}
            }
            match op {
                AssignOp::Assign => {
                    var val: i64 = Lowerer_lower_expr(self, expr);
                    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(ptr_val, val, OptIrType::Some(pointee_ty)));
                }
                _ => {
                    var current: i64 = Lowerer_emit_inst(self, Inst::Load(ptr_val, pointee_ty));
                    var rhs: i64 = Lowerer_lower_expr(self, expr);
                    var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(ptr_val, new_val, OptIrType::Some(pointee_ty)));
                }
            }
        }
        Stmt::FieldAssign(object, field, op, expr, _line) => {
            var struct_ptr: i64 = Lowerer_lower_expr(self, object);
            var struct_ty: IrType = Lowerer_get_value_type(self, struct_ptr);
            var struct_name: str = "";
            match struct_ty {
                IrType::Ptr(inner) => {
                    match inner {
                        IrType::Struct(n) => { struct_name = n; }
                        _ => {}
                    }
                }
                IrType::Struct(n) => { struct_name = n; }
                _ => {}
            }

            if str_len(struct_name) > 0 {
                match IrModule_get_struct(&self.module, struct_name) {
                    OptStructLayout::Some(layout) => {
                        // Find field index and type
                        var field_idx: i64 = 0;
                        var field_ty: IrType = IrType::I64;
                        var found_field: bool = false;
                        var fi: i64 = 0;
                        while fi < layout.fields.len() {
                            if str_equal(layout.fields.get(fi).name, field) {
                                field_idx = fi;
                                field_ty = layout.fields.get(fi).ty;
                                found_field = true;
                            }
                            fi = fi + 1;
                        }

                        if found_field {
                            var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(struct_ptr, field_idx, field_ty));
                            match op {
                                AssignOp::Assign => {
                                    var val: i64 = Lowerer_lower_expr(self, expr);
                                    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, val, OptIrType::None));
                                }
                                _ => {
                                    var current: i64 = Lowerer_emit_inst(self, Inst::Load(field_ptr, field_ty));
                                    var rhs: i64 = Lowerer_lower_expr(self, expr);
                                    var new_val: i64 = Lowerer_lower_compound_assign(self, op, current, rhs);
                                    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, new_val, OptIrType::None));
                                }
                            }
                        }
                    }
                    OptStructLayout::None => {}
                }
            }
        }
        Stmt::Unsafe(body, _line) => {
            // F62: emit UnsafeBegin/UnsafeEnd so interpreter can skip bounds checks
            var _ub: i64 = Lowerer_emit_inst(self, Inst::UnsafeBegin);
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            if !Lowerer_current_block_has_terminator(self) {
                var _ue: i64 = Lowerer_emit_inst(self, Inst::UnsafeEnd);
            }
        }
        Stmt::RegionBlock(name, _budget, is_gpu, is_kv_cache, _window_size, body, _line) => {
            // Emit RegionBegin, push region, lower body, pop, emit RegionEnd
            var _rb: i64 = Lowerer_emit_inst(self, Inst::RegionBegin(name, is_gpu, is_kv_cache, OptU64::None));
            self.region_stack.push(name);
            if is_gpu { self.gpu_region_stack.push(name); }
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            self.region_stack.pop();
            if is_gpu { self.gpu_region_stack.pop(); }
            if !Lowerer_current_block_has_terminator(self) {
                var _re: i64 = Lowerer_emit_inst(self, Inst::RegionEnd(name, is_gpu, is_kv_cache));
            }
        }
        Stmt::Sandbox(body, _line) => {
            // Track sandbox context for optimizer
            self.sandbox_depth = self.sandbox_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            self.sandbox_depth = self.sandbox_depth - 1;
        }
        Stmt::Txn(body, _line) => {
            var _tb: i64 = Lowerer_emit_inst(self, Inst::TxnBegin);
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            if !Lowerer_current_block_has_terminator(self) {
                var _te: i64 = Lowerer_emit_inst(self, Inst::TxnEnd);
            }
        }
        Stmt::ComptimeGen(_body, _line) => {
            // Comptime gen blocks are processed before lowering — no-op here
        }
        Stmt::GradBlock(var_name, body, _line) => {
            var _gb: i64 = Lowerer_emit_inst(self, Inst::GradBegin(var_name));
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
            if !Lowerer_current_block_has_terminator(self) {
                var _ge: i64 = Lowerer_emit_inst(self, Inst::GradEnd);
            }
        }
        Stmt::Backward(loss_expr, _line) => {
            var loss_val: i64 = Lowerer_lower_expr(self, loss_expr);
            var _b: i64 = Lowerer_emit_inst(self, Inst::Backward(loss_val));
        }
        Stmt::Query(_names, body, _line) => {
            // Query blocks lower as regular statements
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
        }
        Stmt::Select(cases, default, _line) => {
            // Simplified select: lower all case bodies sequentially
            var ci: i64 = 0;
            while ci < cases.len() {
                var case: SelectCase = cases.get(ci);
                // Lower the channel expression (side effects)
                var _chan: i64 = Lowerer_lower_expr(self, case.channel);
                var bi: i64 = 0;
                while bi < case.body.len() {
                    Lowerer_lower_stmt(self, case.body.get(bi));
                    bi = bi + 1;
                }
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(def_body) => {
                    var di: i64 = 0;
                    while di < def_body.len() {
                        Lowerer_lower_stmt(self, def_body.get(di));
                        di = di + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Stmt::Handle(body, _handlers, _line) => {
            // Handle blocks: lower body, handlers are type-checked but no runtime effect
            var si: i64 = 0;
            while si < body.len() {
                Lowerer_lower_stmt(self, body.get(si));
                si = si + 1;
            }
        }
        Stmt::Do(_effect, _op, _args, _line) => {
            // Do expressions are handled by the typechecker; no runtime lowering
            // (Would need effect handler dispatch at runtime)
        }
        Stmt::Use(_path, _items, _line) => {
            // Use statements are resolved at import time — no-op in lowering
        }
    }
}

// ─── Stubs for functions implemented in later parts ───────────────────────

pub fn Lowerer_lower_expr(self: &mut Lowerer, expr: Expr) -> i64 {
    match expr {
        Expr::IntLit(n) => {
            return Lowerer_emit_inst(self, Inst::ConstInt(n, IrType::I64));
        }
        Expr::FloatLit(f) => {
            // ConstFloat now stores the f64 value directly
            return Lowerer_emit_inst(self, Inst::ConstFloat(f, IrType::F64));
        }
        Expr::BoolLit(b) => {
            return Lowerer_emit_inst(self, Inst::ConstBool(b));
        }
        Expr::StringLit(s) => {
            // Intern the string
            var _label: str = IrModule_intern_string(&mut self.module, s);
            return Lowerer_emit_inst(self, Inst::ConstStr(s));
        }
        Expr::Ident(name) => {
            // Check if this is a captured variable in a closure
            var ci: i64 = 0;
            while ci < self.current_captures.len() {
                if str_equal(self.current_captures.get(ci).name, name) {
                    var idx: i64 = self.current_captures.get(ci).field_index;
                    var cap_ir_ty: IrType = Lowerer_lower_type(self, self.current_captures.get(ci).ty);
                    // Load from env struct: env_ptr is the first param
                    if self.current_func.params.len() > 0 {
                        var env_val: i64 = self.current_func.params.get(0).id;
                        var idx_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(idx, IrType::I64));
                        var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(env_val, idx_val, IrType::I64));
                        return Lowerer_emit_inst(self, Inst::Load(elem_ptr, cap_ir_ty));
                    }
                }
                ci = ci + 1;
            }

            // Check if mutable variable with alloca
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(alloca) => {
                    var load_ty: IrType = IrType::I64;
                    match Lowerer_lookup_alloca_type(self, alloca) {
                        OptIrType::Some(t) => { load_ty = t; }
                        OptIrType::None => { load_ty = IrType::I64; }
                    }
                    return Lowerer_emit_inst(self, Inst::Load(alloca, load_ty));
                }
                OptValueId::None => {}
            }

            // Check if local variable
            match Lowerer_lookup_local(self, name) {
                OptValueId::Some(local_val) => { return local_val; }
                OptValueId::None => {}
            }

            // Check if constant (pc)
            match Lowerer_lookup_constant(self, name) {
                OptExpr::Some(const_expr) => { return Lowerer_lower_expr(self, const_expr); }
                OptExpr::None => {}
            }

            // Unknown — emit zero
            return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        }
        Expr::Binary(op, left, right) => {
            var left_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(left));
            var right_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(right));
            var result_ty: IrType = Lowerer_infer_binop_type(self, op, box_expr_unbox(left), box_expr_unbox(right));

            // String concatenation: str + str → p_str_concat
            var left_ir_ty: IrType = Lowerer_get_value_type(self, left_val);
            var right_ir_ty: IrType = Lowerer_get_value_type(self, right_val);
            if binop_eq(op, BinOp::Add) && ir_type_eq(left_ir_ty, ptr_u8()) && ir_type_eq(right_ir_ty, ptr_u8()) {
                var args: Vec<i64> = Vec::new();
                args.push(left_val);
                args.push(right_val);
                var eff: EffectSet = EffectSet_new();
                EffectSet_add(&mut eff, Effect::Alloc);
                return Lowerer_emit_inst(self, Inst::Call("p_str_concat", args, ptr_u8(), eff));
            }

            // String equality: str == str → p_str_equal
            if (binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq)) && ir_type_eq(left_ir_ty, ptr_u8()) && ir_type_eq(right_ir_ty, ptr_u8()) {
                var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var args: Vec<i64> = Vec::new();
                args.push(dummy_env);
                args.push(left_val);
                args.push(right_val);
                var eq_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_equal", args, IrType::Bool, EffectSet_new()));
                if binop_eq(op, BinOp::Neq) {
                    return Lowerer_emit_inst(self, Inst::UnaryOp(UnaryOp::Not, eq_val, IrType::Bool));
                }
                return eq_val;
            }

            return Lowerer_emit_inst(self, Inst::BinOp(op, left_val, right_val, result_ty));
        }
        Expr::Unary(op, e) => {
            var operand: i64 = Lowerer_lower_expr(self, box_expr_unbox(e));
            var result_ty: IrType = Lowerer_infer_unary_type(self, op, box_expr_unbox(e));
            return Lowerer_emit_inst(self, Inst::UnaryOp(op, operand, result_ty));
        }
        Expr::Call(callee, args) => {
            // Lower all arguments
            var arg_vals: Vec<i64> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                arg_vals.push(Lowerer_lower_expr(self, args.get(ai)));
                ai = ai + 1;
            }

            // Special case: print() builtin
            if callee == "print" && arg_vals.len() > 0 {
                var arg_ty: IrType = Lowerer_get_value_type(self, arg_vals.get(0));
                return Lowerer_emit_inst(self, Inst::Print(arg_vals.get(0), arg_ty));
            }

            // Special case: println() builtin
            if callee == "println" && arg_vals.len() > 0 {
                var arg_ty: IrType = Lowerer_get_value_type(self, arg_vals.get(0));
                var _p1: i64 = Lowerer_emit_inst(self, Inst::Print(arg_vals.get(0), arg_ty));
                var newline: i64 = Lowerer_emit_inst(self, Inst::ConstStr("\n"));
                return Lowerer_emit_inst(self, Inst::Print(newline, ptr_u8()));
            }

            // GPU builtins — return 0 on CPU
            if callee == "thread_id" || callee == "workgroup_size" || callee == "workgroup_id" || callee == "num_workgroups" {
                return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            }

            // Determine return type
            var ret_ty: IrType = Lowerer_lookup_func_ret_ty_ir(self, callee);

            // Determine effects
            var eff: EffectSet = EffectSet_new();
            match runtime_effects(callee) {
                OptEffectSet::Some(e) => { eff = e; }
                OptEffectSet::None => {}
            }

            // Add dummy __env as first argument for user functions only.
            // Runtime functions (p_*, __ecs_*) and externs don't take __env.
            var call_args: Vec<i64> = Vec::new();
            var is_user_func: bool = Lowerer_is_user_func(self, callee);
            var is_runtime: bool = !is_user_func && (str_starts_with(callee, "p_") || str_starts_with(callee, "__ecs_"));
            if is_user_func && !is_runtime {
                call_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));  // __env
            }
            ai = 0;
            while ai < arg_vals.len() {
                call_args.push(arg_vals.get(ai));
                ai = ai + 1;
            }

            // Async function wrapping
            if Lowerer_is_async_func(self, callee) {
                var call_val: i64 = Lowerer_emit_inst(self, Inst::Call(callee, call_args, ret_ty, eff));
                var wrap_args: Vec<i64> = Vec::new();
                wrap_args.push(call_val);
                return Lowerer_emit_inst(self, Inst::Call("p_future_ready", wrap_args, IrType::I64, EffectSet_new()));
            }

            return Lowerer_emit_inst(self, Inst::Call(callee, call_args, ret_ty, eff));
        }
        Expr::MethodCall(receiver, method, args) => {
            // Lower receiver
            var recv_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(receiver));
            var recv_ty: IrType = Lowerer_get_value_type(self, recv_val);

            // Lower arguments
            var arg_vals: Vec<i64> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                arg_vals.push(Lowerer_lower_expr(self, args.get(ai)));
                ai = ai + 1;
            }

            // Determine mangled method name
            // For struct methods: {StructName}_{method}
            // For Vec/HashMap methods: use Fides function name directly
            var mangled_name: str = method;
            match recv_ty {
                IrType::Struct(struct_name) => {
                    mangled_name = struct_name + "_" + method;
                }
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(struct_name2) => {
                            mangled_name = struct_name2 + "_" + method;
                        }
                        _ => {}
                    }
                }
                _ => {}
            }

            // Determine return type
            var ret_ty: IrType = Lowerer_lookup_func_ret_ty_ir(self, mangled_name);
            if ir_type_eq(ret_ty, IrType::I64) {
                // Try unmangled name
                ret_ty = Lowerer_lookup_func_ret_ty_ir(self, method);
            }

            // Build call args: __env, receiver, args...
            var call_args: Vec<i64> = Vec::new();
            call_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));  // __env
            call_args.push(recv_val);
            ai = 0;
            while ai < arg_vals.len() {
                call_args.push(arg_vals.get(ai));
                ai = ai + 1;
            }

            var eff: EffectSet = EffectSet_new();
            match runtime_effects(mangled_name) {
                OptEffectSet::Some(e) => { eff = e; }
                OptEffectSet::None => {}
            }

            return Lowerer_emit_inst(self, Inst::Call(mangled_name, call_args, ret_ty, eff));
        }
        Expr::FieldAccess(obj, field) => {
            var obj_expr: Expr = box_expr_unbox(obj);
            var obj_val: i64 = Lowerer_lower_expr(self, obj_expr);
            var obj_ty: IrType = Lowerer_get_value_type(self, obj_val);

            // Get struct name from value type, falling back to infer_expr_type
            // (needed when obj_val comes from Vec_get which returns I64)
            var struct_name: str = "";
            match obj_ty {
                IrType::Struct(n) => { struct_name = n; }
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(n2) => { struct_name = n2; }
                        _ => {}
                    }
                }
                _ => {}
            }
            // Fallback: try infer_expr_type if get_value_type didn't find a struct
            if str_len(struct_name) == 0 {
                var inferred_ty: IrType = Lowerer_infer_expr_type(self, obj_expr);
                match inferred_ty {
                    IrType::Struct(n) => { struct_name = n; }
                    IrType::Ptr(inner) => {
                        match box_ir_type_unbox(inner) {
                            IrType::Struct(n2) => { struct_name = n2; }
                            _ => {}
                        }
                    }
                    _ => {}
                }
            }

            // Look up field index
            var field_idx: i64 = 0;
            var field_ty: IrType = IrType::I64;
            match IrModule_get_struct(&self.module, struct_name) {
                OptStructLayout::Some(layout) => {
                    var fi: i64 = 0;
                    while fi < layout.fields.len() {
                        if str_equal(layout.fields.get(fi).name, field) {
                            field_idx = fi;
                            field_ty = layout.fields.get(fi).ty;
                        }
                        fi = fi + 1;
                    }
                }
                OptStructLayout::None => {}
            }

            // Emit GetFieldPtr + Load (or just GetFieldPtr for struct-typed fields)
            var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(obj_val, field_idx, field_ty));
            // If the field is a struct, return the pointer (not a load)
            // — structs can't be loaded as scalar values
            match field_ty {
                IrType::Struct(_) => { return field_ptr; }
                _ => {}
            }
            return Lowerer_emit_inst(self, Inst::Load(field_ptr, field_ty));
        }
        Expr::Index(arr, idx) => {
            var arr_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(arr));
            var idx_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(idx));
            var arr_ty: IrType = Lowerer_get_value_type(self, arr_val);

            // Vec indexing: Vec_get(vec, idx)
            if ir_type_is_opaque_named(arr_ty, "Vec") || ir_type_eq(arr_ty, IrType::I64) {
                var args: Vec<i64> = Vec::new();
                args.push(arr_val);
                args.push(idx_val);
                return Lowerer_emit_inst(self, Inst::Call("p_vec_get", args, IrType::I64, EffectSet_new()));
            }

            // Array indexing: GetElemPtr + Load
            var elem_ty: IrType = IrType::I64;
            match arr_ty {
                IrType::Array(inner, _) => { elem_ty = box_ir_type_unbox(inner); }
                IrType::Ptr(inner2) => {
                    match box_ir_type_unbox(inner2) {
                        IrType::Array(inner3, _) => { elem_ty = box_ir_type_unbox(inner3); }
                        _ => {}
                    }
                }
                _ => {}
            }
            var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(arr_val, idx_val, elem_ty));
            return Lowerer_emit_inst(self, Inst::Load(elem_ptr, elem_ty));
        }
        Expr::StructLit(name, fields, spread) => {
            // Allocate struct on stack
            var struct_ty: IrType = IrType::Struct(name);
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(struct_ty, Lowerer_current_region(self)));

            // Store each field
            var fi: i64 = 0;
            while fi < fields.len() {
                var field_init: FieldInit = fields.get(fi);
                var field_val: i64 = Lowerer_lower_expr(self, field_init.value);

                // Look up field index and type
                var field_idx: i64 = fi;
                var field_ty: IrType = IrType::I64;
                match IrModule_get_struct(&self.module, name) {
                    OptStructLayout::Some(layout) => {
                        var fj: i64 = 0;
                        while fj < layout.fields.len() {
                            if str_equal(layout.fields.get(fj).name, field_init.name) {
                                field_idx = fj;
                                field_ty = layout.fields.get(fj).ty;
                            }
                            fj = fj + 1;
                        }
                    }
                    OptStructLayout::None => {}
                }

                var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, field_idx, field_ty));
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(field_ptr, field_val, OptIrType::None));
                fi = fi + 1;
            }

            return alloca;
        }
        Expr::If(cond, then_block, else_block) => {
            // If-as-expression: allocate result slot, lower as if with result
            var cond_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(cond));
            var then_block_id: i64 = Lowerer_new_block(self);
            var else_block_id: i64 = Lowerer_new_block(self);
            var merge_block_id: i64 = Lowerer_new_block(self);

            Lowerer_emit_terminator(self, Inst::Branch(cond_val, then_block_id, else_block_id));

            // Then block
            Lowerer_set_current_block(self, then_block_id);
            var then_result: i64 = 0;
            var ti: i64 = 0;
            while ti < then_block.len() {
                match then_block.get(ti) {
                    Stmt::Expr(e, _) => { then_result = Lowerer_lower_expr(self, e); }
                    s => { Lowerer_lower_stmt(self, s); }
                }
                ti = ti + 1;
            }
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(merge_block_id));
            }

            // Else block
            Lowerer_set_current_block(self, else_block_id);
            var else_result: i64 = 0;
            match else_block {
                OptStmts::Some(else_stmts) => {
                    var ei: i64 = 0;
                    while ei < else_stmts.len() {
                        match else_stmts.get(ei) {
                            Stmt::Expr(e2, _) => { else_result = Lowerer_lower_expr(self, e2); }
                            s2 => { Lowerer_lower_stmt(self, s2); }
                        }
                        ei = ei + 1;
                    }
                }
                OptStmts::None => {}
            }
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(merge_block_id));
            }

            // Merge block — add block params for the result
            Lowerer_set_current_block(self, merge_block_id);
            var result_ty: IrType = Lowerer_get_value_type(self, then_result);
            var result_val: i64 = Lowerer_add_block_param(self, merge_block_id, result_ty);
            return result_val;
        }
        Expr::Block(stmts) => {
            var result: i64 = 0;
            var i: i64 = 0;
            while i < stmts.len() {
                match stmts.get(i) {
                    Stmt::Expr(e, _) => { result = Lowerer_lower_expr(self, e); }
                    s => { Lowerer_lower_stmt(self, s); }
                }
                i = i + 1;
            }
            if result == 0 {
                result = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            }
            return result;
        }
        Expr::Cast(e, ty) => {
            var val: i64 = Lowerer_lower_expr(self, box_expr_unbox(e));
            var src_ty: IrType = Lowerer_get_value_type(self, val);
            var dst_ty: IrType = Lowerer_lower_type(self, ty);
            return Lowerer_lower_cast(self, val, src_ty, dst_ty);
        }
        Expr::TupleLit(elements) => {
            // Allocate a tuple struct on stack
            var n: i64 = elements.len();
            var tuple_ty: IrType = IrType::Opaque("tuple");
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(tuple_ty, Lowerer_current_region(self)));

            // Store each element at offset i*8
            var i: i64 = 0;
            while i < n {
                var elem_val: i64 = Lowerer_lower_expr(self, elements.get(i));
                var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, i, IrType::I64));
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(elem_ptr, elem_val, OptIrType::None));
                i = i + 1;
            }

            return alloca;
        }
        Expr::Range(start, end, inclusive) => {
            // Range expression — used in for loops, handled there
            var start_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(start));
            return start_val;
        }
        Expr::Ref(e, is_mut) => {
            // Take a reference — for alloca variables, return the alloca pointer
            match box_expr_unbox(e) {
                Expr::Ident(name) => {
                    match Lowerer_lookup_alloca(self, name) {
                        OptValueId::Some(alloca) => { return alloca; }
                        OptValueId::None => {}
                    }
                }
                _ => {}
            }
            return Lowerer_lower_expr(self, box_expr_unbox(e));
        }
        Expr::Deref(e) => {
            var ptr_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(e));
            var ptr_ty: IrType = Lowerer_get_value_type(self, ptr_val);
            // Load through the pointer
            var load_ty: IrType = IrType::I64;
            match ptr_ty {
                IrType::Ptr(inner) => { load_ty = box_ir_type_unbox(inner); }
                _ => {}
            }
            return Lowerer_emit_inst(self, Inst::Load(ptr_val, load_ty));
        }
        Expr::StrConcat(left, right) => {
            var left_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(left));
            var right_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(right));
            var args: Vec<i64> = Vec::new();
            args.push(left_val);
            args.push(right_val);
            var eff: EffectSet = EffectSet_new();
            EffectSet_add(&mut eff, Effect::Alloc);
            return Lowerer_emit_inst(self, Inst::Call("p_str_concat", args, ptr_u8(), eff));
        }
        Expr::EnumLit(enum_name, variant, args) => {
            // Allocate enum struct on stack
            var enum_ty: IrType = IrType::Struct(enum_name);
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(enum_ty, Lowerer_current_region(self)));

            // Store tag at offset 0
            var tag_idx: i64 = 0;
            match Lowerer_lookup_enum(self, enum_name) {
                OptEnumDef::Some(def) => {
                    var vi: i64 = 0;
                    while vi < def.variants.len() {
                        if str_equal(def.variants.get(vi).name, variant) {
                            tag_idx = vi;
                        }
                        vi = vi + 1;
                    }
                }
                OptEnumDef::None => {}
            }

            var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, 0, IrType::I64));
            var tag_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(tag_idx, IrType::I64));
            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(tag_ptr, tag_val, OptIrType::None));

            // Store payload data at offsets 1..n
            var ai: i64 = 0;
            while ai < args.len() {
                var arg_val: i64 = Lowerer_lower_expr(self, args.get(ai));
                var data_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(alloca, ai + 1, IrType::I64));
                var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(data_ptr, arg_val, OptIrType::None));
                ai = ai + 1;
            }

            return alloca;
        }
        Expr::Match(e, arms) => {
            // Match-as-expression — full pattern matching
            var match_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(e));
            var merge_block: i64 = Lowerer_new_block(self);
            var result_ty: IrType = Lowerer_infer_match_type(self, arms);

            var i: i64 = 0;
            while i < arms.len() {
                var arm: MatchArm = arms.get(i);
                var arm_block: i64 = Lowerer_new_block(self);
                var next_block: i64 = Lowerer_new_block(self);

                // Check pattern
                match arm.pattern {
                    Pattern::Wildcard => {
                        Lowerer_emit_terminator(self, Inst::Jump(arm_block));
                    }
                    Pattern::IntLit(v) => {
                        var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstInt(v, IrType::I64)), IrType::Bool));
                        Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
                    }
                    Pattern::BoolLit(v) => {
                        var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstBool(v)), IrType::Bool));
                        Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
                    }
                    Pattern::Ident(name) => {
                        Lowerer_bind_local(self, name, match_val);
                        Lowerer_emit_terminator(self, Inst::Jump(arm_block));
                    }
                    Pattern::StrLit(s) => {
                        var const_str: i64 = Lowerer_emit_inst(self, Inst::ConstStr(s));
                        var str_eq_args: Vec<i64> = Vec::new();
                        str_eq_args.push(match_val);
                        str_eq_args.push(const_str);
                        var cmp_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_equal", str_eq_args, IrType::Bool, EffectSet_new()));
                        Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
                    }
                    Pattern::Range(start_pat, end_pat) => {
                        // Range pattern: start..end
                        var lo: i64 = 0;
                        var hi: i64 = 0;
                        var range_ok: bool = false;
                        match start_pat {
                            Pattern::IntLit(s) => { lo = s; match end_pat { Pattern::IntLit(e) => { hi = e; range_ok = true; } _ => {} } }
                            _ => {}
                        }
                        if range_ok {
                            var start_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(lo, IrType::I64));
                            var end_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(hi, IrType::I64));
                            var lo_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::LtEq, start_val, match_val, IrType::Bool));
                            var hi_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, match_val, end_val, IrType::Bool));
                            var in_range: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::And, lo_cmp, hi_cmp, IrType::Bool));
                            Lowerer_emit_terminator(self, Inst::Branch(in_range, arm_block, next_block));
                        } else {
                            Lowerer_emit_terminator(self, Inst::Jump(next_block));
                        }
                    }
                    Pattern::EnumVariant(enum_name, variant, bindings) => {
                        // Load tag from offset 0 and compare with variant index
                        var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, 0, IrType::I64));
                        var tag_val: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));

                        // Find variant index
                        var variant_idx: i64 = 0;
                        if str_len(enum_name) > 0 {
                            match Lowerer_lookup_enum(self, enum_name) {
                                OptEnumDef::Some(def) => {
                                    var vi: i64 = 0;
                                    while vi < def.variants.len() {
                                        if str_equal(def.variants.get(vi).name, variant) {
                                            variant_idx = vi;
                                        }
                                        vi = vi + 1;
                                    }
                                }
                                OptEnumDef::None => {}
                            }
                        } else {
                            // Search all enums for matching variant name
                            var ei: i64 = 0;
                            while ei < self.enums.len() {
                                var def2: EnumDef = self.enums.get(ei).val;
                                var vi: i64 = 0;
                                while vi < def2.variants.len() {
                                    if str_equal(def2.variants.get(vi).name, variant) {
                                        variant_idx = vi;
                                    }
                                    vi = vi + 1;
                                }
                                ei = ei + 1;
                            }
                        }

                        var expected: i64 = Lowerer_emit_inst(self, Inst::ConstInt(variant_idx, IrType::I64));
                        var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag_val, expected, IrType::Bool));
                        Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));

                        // In the arm block: bind payload fields
                        Lowerer_set_current_block(self, arm_block);
                        var bi: i64 = 0;
                        while bi < bindings.len() {
                            var binding: Binding = bindings.get(bi);
                            var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, bi + 1, IrType::I64));
                            var field_val: i64 = Lowerer_emit_inst(self, Inst::Load(field_ptr, IrType::I64));
                            Lowerer_bind_local(self, binding.name, field_val);
                            bi = bi + 1;
                        }

                        // Lower arm body — the last Expr stmt is the result
                        var arm_result: i64 = 0;
                        var si: i64 = 0;
                        while si < arm.body.len() {
                            match arm.body.get(si) {
                                Stmt::Expr(e2, _) => { arm_result = Lowerer_lower_expr(self, e2); }
                                s => { Lowerer_lower_stmt(self, s); }
                            }
                            si = si + 1;
                        }
                        if !Lowerer_current_block_has_terminator(self) {
                            Lowerer_emit_terminator(self, Inst::Jump(merge_block));
                        }
                        Lowerer_set_current_block(self, next_block);
                        i = i + 1;
                        continue;
                    }
                }

                // Arm body (for non-EnumVariant patterns)
                Lowerer_set_current_block(self, arm_block);
                var arm_result: i64 = 0;
                var si: i64 = 0;
                while si < arm.body.len() {
                    match arm.body.get(si) {
                        Stmt::Expr(e2, _) => { arm_result = Lowerer_lower_expr(self, e2); }
                        s => { Lowerer_lower_stmt(self, s); }
                    }
                    si = si + 1;
                }
                if !Lowerer_current_block_has_terminator(self) {
                    Lowerer_emit_terminator(self, Inst::Jump(merge_block));
                }

                Lowerer_set_current_block(self, next_block);
                i = i + 1;
            }

            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Unreachable);
            }

            Lowerer_set_current_block(self, merge_block);
            var result_val: i64 = Lowerer_add_block_param(self, merge_block, result_ty);
            return result_val;
        }
        Expr::Try(e) => {
            // ? operator — evaluate expression, check if it's Ok/Err
            // Result is modeled as a struct with (tag, value)
            // tag 0 = Ok, tag 1 = Err
            // If Err, propagate the error to the caller (or to the nearest try block)
            var val: i64 = Lowerer_lower_expr(self, box_expr_unbox(e));

            // Load the tag (field 0)
            var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 0, IrType::I64));
            var tag: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));

            var ok_block: i64 = Lowerer_new_block(self);
            var err_block: i64 = Lowerer_new_block(self);
            var merge_block: i64 = Lowerer_new_block(self);

            var zero_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            var is_ok: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag, zero_val, IrType::Bool));

            Lowerer_emit_terminator(self, Inst::Branch(is_ok, ok_block, err_block));

            // Ok: jump to merge
            Lowerer_set_current_block(self, ok_block);
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));

            // Err: propagate the error
            Lowerer_set_current_block(self, err_block);
            if self.try_stack.len() > 0 {
                // Inside a try block: copy the Result struct field-by-field into err_slot
                var ctx: TryContext = self.try_stack.get(self.try_stack.len() - 1);
                var try_err_block: i64 = ctx.error_block;
                var try_err_slot: i64 = ctx.error_result_slot;

                // Copy tag
                var src_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 0, IrType::I64));
                var src_tag: i64 = Lowerer_emit_inst(self, Inst::Load(src_tag_ptr, IrType::I64));
                var dst_tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(try_err_slot, 0, IrType::I64));
                Lowerer_emit_inst(self, Inst::Store(dst_tag_ptr, src_tag, OptIrType::None));

                // Copy value
                var src_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 1, IrType::I64));
                var src_val: i64 = Lowerer_emit_inst(self, Inst::Load(src_val_ptr, IrType::I64));
                var dst_val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(try_err_slot, 1, IrType::I64));
                Lowerer_emit_inst(self, Inst::Store(dst_val_ptr, src_val, OptIrType::None));

                Lowerer_emit_terminator(self, Inst::Jump(try_err_block));
            } else {
                // Not inside a try block: return the error from the current function
                Lowerer_emit_drops(self);
                Lowerer_emit_defers(self);
                match self.current_sret {
                    OptValueId::Some(_) => {
                        Lowerer_emit_terminator(self, Inst::Return(OptValueId::None));
                    }
                    OptValueId::None => {
                        Lowerer_emit_terminator(self, Inst::Return(OptValueId::Some(val)));
                    }
                }
            }

            // Merge: load the unwrapped value (field 1)
            Lowerer_set_current_block(self, merge_block);
            var val_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 1, IrType::I64));
            return Lowerer_emit_inst(self, Inst::Load(val_ptr, IrType::I64));
        }
        Expr::Coalesce(left, right) => {
            // a ?? b — if a is not null, return a, else return b
            var left_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(left));
            var null_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Neq, left_val, null_val, IrType::Bool));

            var then_block: i64 = Lowerer_new_block(self);
            var else_block: i64 = Lowerer_new_block(self);
            var merge_block: i64 = Lowerer_new_block(self);

            Lowerer_emit_terminator(self, Inst::Branch(cmp_val, then_block, else_block));

            Lowerer_set_current_block(self, then_block);
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(merge_block));
            }

            Lowerer_set_current_block(self, else_block);
            var right_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(right));
            if !Lowerer_current_block_has_terminator(self) {
                Lowerer_emit_terminator(self, Inst::Jump(merge_block));
            }

            Lowerer_set_current_block(self, merge_block);
            var result_val: i64 = Lowerer_add_block_param(self, merge_block, IrType::I64);
            return result_val;
        }
        Expr::IsCheck(e, variant) => {
            // Check if enum value is of a specific variant
            var val: i64 = Lowerer_lower_expr(self, box_expr_unbox(e));
            // Load tag from offset 0
            var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(val, 0, IrType::I64));
            var tag_val: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));
            // Find variant index by searching all enums
            var variant_idx: i64 = 0;
            var ei: i64 = 0;
            while ei < self.enums.len() {
                var def: EnumDef = self.enums.get(ei).val;
                var vi: i64 = 0;
                while vi < def.variants.len() {
                    if str_equal(def.variants.get(vi).name, variant) {
                        variant_idx = vi;
                    }
                    vi = vi + 1;
                }
                ei = ei + 1;
            }
            var expected: i64 = Lowerer_emit_inst(self, Inst::ConstInt(variant_idx, IrType::I64));
            return Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag_val, expected, IrType::Bool));
        }
        Expr::TryBlock(stmts) => {
            // Simplified: just lower the block
            var result: i64 = 0;
            var i: i64 = 0;
            while i < stmts.len() {
                match stmts.get(i) {
                    Stmt::Expr(e, _) => { result = Lowerer_lower_expr(self, e); }
                    s => { Lowerer_lower_stmt(self, s); }
                }
                i = i + 1;
            }
            if result == 0 {
                result = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            }
            return result;
        }
        Expr::Closure(params, body, ret_ty) => {
            // Lambda lifting with environment struct:
            // 1. Find free variables (captures) in the closure body
            // 2. Create lifted function: (env_ptr: *u8, ...own_params) -> ret
            //    Inside, load captures from env struct fields
            // 3. At creation site: alloca env struct, store captures, return struct ptr
            // 4. CallPtr passes env_ptr as first arg

            var closure_id: i64 = self.module.functions.len();
            var closure_name: str = str_concat("__closure_", int_to_str(closure_id));

            // Find free variables
            var param_names: Vec<str> = Vec::new();
            var pi: i64 = 0;
            while pi < params.len() {
                param_names.push(params.get(pi).name);
                pi = pi + 1;
            }
            var captures: Vec<str> = Lowerer_find_captures(self, body, param_names);

            // Save current captures and set new ones for this closure
            var saved_captures: Vec<ClosureCapture> = self.current_captures;
            var empty_captures: Vec<ClosureCapture> = Vec::new();
            self.current_captures = empty_captures;
            var ci: i64 = 0;
            while ci < captures.len() {
                // Capture field index in env struct is ci+1 (field 0 is fn_name)
                self.current_captures.push(ClosureCapture_new(captures.get(ci), ci + 1, Type::I64));
                ci = ci + 1;
            }

            // Infer return type if not specified
            var inferred_ret_ty: Type = Type::I64;
            match ret_ty {
                OptType::Some(rt) => { inferred_ret_ty = rt; }
                OptType::None => { inferred_ret_ty = Type::I64; }
            }

            // Build the lifted function
            var closure_func: Func = Func_new_full(closure_name, params, inferred_ret_ty, body, false);

            // Save current function context
            var saved_func: IrFunction = self.current_func;
            var saved_has_func: bool = self.has_current_func;
            var saved_allocas: Vec<StringValueIdEntry> = self.allocas;
            var saved_alloca_types: Vec<I64IrTypeEntry> = self.alloca_types;
            var saved_var_ast_types: Vec<StringTypeEntry> = self.var_ast_types;
            var saved_block: i64 = self.current_block;
            var saved_sret: OptValueId = self.current_sret;

            // Lower the closure function
            Lowerer_lower_func(self, closure_func);

            // Restore context
            self.current_func = saved_func;
            self.has_current_func = saved_has_func;
            self.allocas = saved_allocas;
            self.alloca_types = saved_alloca_types;
            self.var_ast_types = saved_var_ast_types;
            self.current_block = saved_block;
            self.current_sret = saved_sret;
            self.current_captures = saved_captures;

            // At creation site: build env struct with captures
            return Lowerer_make_fn_env(self, closure_name, captures);
        }
        Expr::OptionalFieldAccess(obj, field) => {
            // Simplified: same as FieldAccess
            return Lowerer_lower_expr(self, Expr::FieldAccess(obj, field));
        }
        Expr::ArrayLit(elem_ty, elements) => {
            // Allocate array on stack
            var n: i64 = elements.len();
            var ir_elem_ty: IrType = Lowerer_lower_type(self, box_type_unbox(elem_ty));
            var arr_ty: IrType = IrType::Array(Box::new(ir_elem_ty), n);
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(arr_ty, Lowerer_current_region(self)));

            // Store each element
            var i: i64 = 0;
            while i < n {
                var elem_val: i64 = Lowerer_lower_expr(self, elements.get(i));
                var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(alloca, i, ir_elem_ty));
                var _s: i64 = Lowerer_emit_inst(self, Inst::Store(elem_ptr, elem_val, OptIrType::None));
                i = i + 1;
            }

            return alloca;
        }
        Expr::FString(parts) => {
            // Simplified: concatenate all parts
            var result: i64 = Lowerer_emit_inst(self, Inst::ConstStr(""));
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Str(s) => {
                        var s_val: i64 = Lowerer_emit_inst(self, Inst::ConstStr(s));
                        var args: Vec<i64> = Vec::new();
                        args.push(result);
                        args.push(s_val);
                        result = Lowerer_emit_inst(self, Inst::Call("p_str_concat", args, ptr_u8(), EffectSet_new()));
                    }
                    FStringPart::Expr(e) => {
                        var e_val: i64 = Lowerer_lower_expr(self, e);
                        var e_ty: IrType = Lowerer_get_value_type(self, e_val);
                        // Convert to string
                        var to_str_name: str = "p_to_str";
                        if ir_type_eq(e_ty, IrType::F64) { to_str_name = "p_float_to_str"; }
                        if ir_type_eq(e_ty, IrType::Bool) { to_str_name = "p_bool_to_str"; }
                        var conv_args: Vec<i64> = Vec::new();
                        conv_args.push(e_val);
                        var str_val: i64 = Lowerer_emit_inst(self, Inst::Call(to_str_name, conv_args, ptr_u8(), EffectSet_new()));
                        var concat_args: Vec<i64> = Vec::new();
                        concat_args.push(result);
                        concat_args.push(str_val);
                        result = Lowerer_emit_inst(self, Inst::Call("p_str_concat", concat_args, ptr_u8(), EffectSet_new()));
                    }
                }
                i = i + 1;
            }
            return result;
        }
        Expr::Comptime(e) => {
            // Comptime expression — just lower it normally
            return Lowerer_lower_expr(self, box_expr_unbox(e));
        }
        Expr::ComptimeBlock(stmts) => {
            var result: i64 = 0;
            var i: i64 = 0;
            while i < stmts.len() {
                match stmts.get(i) {
                    Stmt::Expr(e, _) => { result = Lowerer_lower_expr(self, e); }
                    s => { Lowerer_lower_stmt(self, s); }
                }
                i = i + 1;
            }
            if result == 0 {
                result = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            }
            return result;
        }
        Expr::PipeForward(left, right) => {
            // a |> f → f(a)
            var left_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(left));
            match box_expr_unbox(right) {
                Expr::Call(callee, args) => {
                    // Prepend left_val to args
                    var new_args: Vec<Expr> = Vec::new();
                    new_args.push(Expr::IntLit(0));  // Placeholder — will be replaced
                    var i: i64 = 0;
                    while i < args.len() {
                        new_args.push(args.get(i));
                        i = i + 1;
                    }
                    // Actually lower as Call with left_val as first arg
                    var arg_vals: Vec<i64> = Vec::new();
                    arg_vals.push(left_val);
                    i = 0;
                    while i < args.len() {
                        arg_vals.push(Lowerer_lower_expr(self, args.get(i)));
                        i = i + 1;
                    }
                    var ret_ty: IrType = Lowerer_lookup_func_ret_ty_ir(self, callee);
                    var call_args: Vec<i64> = Vec::new();
                    call_args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));  // __env
                    i = 0;
                    while i < arg_vals.len() {
                        call_args.push(arg_vals.get(i));
                        i = i + 1;
                    }
                    return Lowerer_emit_inst(self, Inst::Call(callee, call_args, ret_ty, EffectSet_new()));
                }
                _ => { return left_val; }
            }
            return left_val;
        }
        Expr::QuantCast(e, ty) => {
            // Quantization cast — just lower the expression
            return Lowerer_lower_expr(self, box_expr_unbox(e));
        }
        Expr::Await(e) => {
            // Await — call p_future_poll
            var fut_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(e));
            var args: Vec<i64> = Vec::new();
            args.push(fut_val);
            return Lowerer_emit_inst(self, Inst::Call("p_future_poll", args, IrType::I64, EffectSet_new()));
        }
        Expr::Spawn(e) => {
            // Spawn — simplified
            return Lowerer_lower_expr(self, box_expr_unbox(e));
        }
        Expr::ComptimeReflect(op, ty) => {
            return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        }
    }
    return Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
}

// ─── Closure helpers ──────────────────────────────────────────────────────

/// Find free variables (captures) in a closure body.
/// Returns list of variable names that are used but not declared locally
/// or in the closure parameters.
pub fn Lowerer_find_captures(self: &Lowerer, body: Vec<Stmt>, param_names: Vec<str>) -> Vec<str> {
    var free_vars: Vec<str> = Vec::new();
    var local_names: Vec<str> = Vec::new();
    // Start with param names as locals
    var pi: i64 = 0;
    while pi < param_names.len() {
        local_names.push(param_names.get(pi));
        pi = pi + 1;
    }
    Lowerer_collect_free_vars(self, body, &mut free_vars, &mut local_names);
    return free_vars;
}

/// Collect free variables from a list of statements.
pub fn Lowerer_collect_free_vars(self: &Lowerer, stmts: Vec<Stmt>, free_vars: &mut Vec<str>, local_names: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        Lowerer_collect_free_vars_stmt(self, stmts.get(i), free_vars, local_names);
        i = i + 1;
    }
}

/// Collect free variables from a single statement.
pub fn Lowerer_collect_free_vars_stmt(self: &Lowerer, stmt: Stmt, free_vars: &mut Vec<str>, local_names: &mut Vec<str>) {
    match stmt {
        Stmt::Let(name, _ty, expr, _is_mut, _is_persist, _line) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
            local_names.push(name);
        }
        Stmt::LetUninit(name, _ty, _line) => {
            local_names.push(name);
        }
        Stmt::LetTuple(names, expr, _line) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
            var ni: i64 = 0;
            while ni < names.len() {
                local_names.push(names.get(ni));
                ni = ni + 1;
            }
        }
        Stmt::Assign(name, _op, expr, _line) => {
            if !c_str_vec_contains(*local_names, name) && !c_str_vec_contains(*free_vars, name) {
                free_vars.push(name);
            }
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::IndexAssign(array, index, _op, expr, _line) => {
            if !c_str_vec_contains(*local_names, array) && !c_str_vec_contains(*free_vars, array) {
                free_vars.push(array);
            }
            Lowerer_collect_free_vars_expr(self, index, free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::DerefAssign(ptr_expr, _op, expr, _line) => {
            Lowerer_collect_free_vars_expr(self, ptr_expr, free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::FieldAssign(object, _field, _op, expr, _line) => {
            Lowerer_collect_free_vars_expr(self, object, free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::Expr(expr, _line) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
        }
        Stmt::Return(expr, _line) => {
            match expr {
                OptBoxExpr::Some(e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _line) => {
            Lowerer_collect_free_vars_expr(self, cond, free_vars, local_names);
            Lowerer_collect_free_vars(self, then_block, free_vars, local_names);
            match else_block {
                OptStmts::Some(eb) => { Lowerer_collect_free_vars(self, eb, free_vars, local_names); }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, _line) => {
            Lowerer_collect_free_vars_expr(self, cond, free_vars, local_names);
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
        }
        Stmt::For(_var, iterator, body, _line) => {
            Lowerer_collect_free_vars_expr(self, iterator, free_vars, local_names);
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
        }
        Stmt::Loop(body, _line) => {
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
        }
        Stmt::Break(expr, _line) => {
            match expr {
                OptBoxExpr::Some(e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::Defer(body, _line) => {
            Lowerer_collect_free_vars(self, body, free_vars, local_names);
        }
        Stmt::Match(expr, arms, _line) => {
            Lowerer_collect_free_vars_expr(self, expr, free_vars, local_names);
            var ai: i64 = 0;
            while ai < arms.len() {
                Lowerer_collect_free_vars(self, arms.get(ai).body, free_vars, local_names);
                ai = ai + 1;
            }
        }
        _ => {}
    }
}

/// Collect free variables from an expression.
pub fn Lowerer_collect_free_vars_expr(self: &Lowerer, expr: Expr, free_vars: &mut Vec<str>, local_names: &Vec<str>) {
    match expr {
        Expr::Ident(name) => {
            if !c_str_vec_contains(*local_names, name) && !c_str_vec_contains(*free_vars, name) {
                free_vars.push(name);
            }
        }
        Expr::IntLit(_) => {}
        Expr::FloatLit(_) => {}
        Expr::BoolLit(_) => {}
        Expr::StringLit(_) => {}
        Expr::Binary(_op, left, right) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(right), free_vars, local_names);
        }
        Expr::Unary(_op, operand) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(operand), free_vars, local_names);
        }
        Expr::Call(_callee, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                Lowerer_collect_free_vars_expr(self, args.get(ai), free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::FieldAccess(obj, _field) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(obj), free_vars, local_names);
        }
        Expr::OptionalFieldAccess(obj, _field) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(obj), free_vars, local_names);
        }
        Expr::StructLit(_name, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                Lowerer_collect_free_vars_expr(self, fields.get(fi).value, free_vars, local_names);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
                OptBoxExpr::None => {}
            }
        }
        Expr::If(cond, then_block, else_block) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(cond), free_vars, local_names);
            Lowerer_collect_free_vars(self, then_block, free_vars, local_names);
            match else_block {
                OptStmts::Some(eb) => { Lowerer_collect_free_vars(self, eb, free_vars, local_names); }
                OptStmts::None => {}
            }
        }
        Expr::Range(start, end, _inclusive) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(start), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(end), free_vars, local_names);
        }
        Expr::Block(stmts) => {
            Lowerer_collect_free_vars(self, stmts, free_vars, local_names);
        }
        Expr::MethodCall(receiver, _method, args) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(receiver), free_vars, local_names);
            var ai: i64 = 0;
            while ai < args.len() {
                Lowerer_collect_free_vars_expr(self, args.get(ai), free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::ArrayLit(_elem_ty, elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                Lowerer_collect_free_vars_expr(self, elements.get(ei), free_vars, local_names);
                ei = ei + 1;
            }
        }
        Expr::Index(arr, idx) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(arr), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(idx), free_vars, local_names);
        }
        Expr::FString(_parts) => {}
        Expr::Match(e, arms) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names);
            var ai: i64 = 0;
            while ai < arms.len() {
                Lowerer_collect_free_vars(self, arms.get(ai).body, free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_enum_name, _variant, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                Lowerer_collect_free_vars_expr(self, args.get(ai), free_vars, local_names);
                ai = ai + 1;
            }
        }
        Expr::Ref(expr, _is_mut) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(expr), free_vars, local_names);
        }
        Expr::Deref(expr) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(expr), free_vars, local_names);
        }
        Expr::StrConcat(left, right) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(right), free_vars, local_names);
        }
        Expr::Try(e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
        Expr::Coalesce(left, right) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(right), free_vars, local_names);
        }
        Expr::IsCheck(e, _) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
        Expr::TryBlock(stmts) => { Lowerer_collect_free_vars(self, stmts, free_vars, local_names); }
        Expr::TupleLit(elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                Lowerer_collect_free_vars_expr(self, elements.get(ei), free_vars, local_names);
                ei = ei + 1;
            }
        }
        Expr::Closure(_params, _body, _ret_ty) => {
            // Don't recurse into nested closures
        }
        Expr::Cast(expr, _ty) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(expr), free_vars, local_names);
        }
        Expr::Asm(_template, _args) => {}
        Expr::Comptime(e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
        Expr::ComptimeBlock(stmts) => { Lowerer_collect_free_vars(self, stmts, free_vars, local_names); }
        Expr::ComptimeReflect(_op, _ty) => {}
        Expr::PipeForward(left, right) => {
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(left), free_vars, local_names);
            Lowerer_collect_free_vars_expr(self, box_expr_unbox(right), free_vars, local_names);
        }
        Expr::QuantCast(e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
        Expr::Await(e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
        Expr::Spawn(e) => { Lowerer_collect_free_vars_expr(self, box_expr_unbox(e), free_vars, local_names); }
    }
}

/// Build the __env struct for a closure: malloc, store fn_name at [0],
/// store captures at [1..N], return the env pointer.
pub fn Lowerer_make_fn_env(self: &mut Lowerer, fn_name: str, captures: Vec<str>) -> i64 {
    var env_size: i64 = (1 + captures.len()) * 8;
    var size_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(env_size, IrType::I64));
    var malloc_args: Vec<i64> = Vec::new();
    malloc_args.push(size_val);
    var env_ptr: i64 = Lowerer_emit_inst(self, Inst::Call("p_malloc", malloc_args, IrType::Ptr(Box::new(IrType::U8)), EffectSet_new()));

    // Store function name at field 0
    var fn_name_val: i64 = Lowerer_emit_inst(self, Inst::ConstStr(fn_name));
    var zero_idx: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var field0: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(env_ptr, zero_idx, IrType::I64));
    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(field0, fn_name_val, OptIrType::None));

    // Store captures at fields 1..N
    var ci: i64 = 0;
    while ci < captures.len() {
        var cap_name: str = captures.get(ci);
        // Lower the capture value from enclosing scope
        var cap_val: i64 = Lowerer_lower_expr(self, Expr::Ident(cap_name));
        var idx: i64 = Lowerer_emit_inst(self, Inst::ConstInt(ci + 1, IrType::I64));
        var field: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(env_ptr, idx, IrType::I64));
        var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(field, cap_val, OptIrType::None));
        ci = ci + 1;
    }

    Lowerer_set_value_type(self, env_ptr, IrType::Opaque("closure"));
    return env_ptr;
}

pub fn Lowerer_lower_while(self: &mut Lowerer, cond: Expr, body: Vec<Stmt>) {
    var cond_block: i64 = Lowerer_new_block(self);
    var body_block: i64 = Lowerer_new_block(self);
    var exit_block: i64 = Lowerer_new_block(self);

    // Jump to condition block
    Lowerer_emit_terminator(self, Inst::Jump(cond_block));

    // Condition block
    Lowerer_set_current_block(self, cond_block);
    var cond_val: i64 = Lowerer_lower_expr(self, cond);
    Lowerer_emit_terminator(self, Inst::Branch(cond_val, body_block, exit_block));

    // Body block
    Lowerer_set_current_block(self, body_block);
    self.loop_stack.push(LoopContext_new(cond_block, exit_block, OptValueId::None));
    Lowerer_lower_stmts(self, body);
    self.loop_stack.pop();
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(cond_block));
    }

    // Continue after loop
    Lowerer_set_current_block(self, exit_block);
}

pub fn Lowerer_lower_for(self: &mut Lowerer, loop_var: str, iterator: Expr, body: Vec<Stmt>) {
    // For ranges: for x in start..end { body }
    match iterator {
        Expr::Range(start, end, inclusive) => {
            var start_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(start));
            var end_val: i64 = Lowerer_lower_expr(self, box_expr_unbox(end));

            // Create alloca for loop variable
            var alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
            var _s: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, start_val, OptIrType::None));
            Lowerer_insert_alloca(self, loop_var, alloca);
            Lowerer_bind_local(self, loop_var, alloca);

            var cond_block: i64 = Lowerer_new_block(self);
            var body_block: i64 = Lowerer_new_block(self);
            var exit_block: i64 = Lowerer_new_block(self);

            Lowerer_emit_terminator(self, Inst::Jump(cond_block));

            // Condition: var < end (or var <= end for inclusive)
            Lowerer_set_current_block(self, cond_block);
            var var_val: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, IrType::I64));
            var cmp_op: BinOp = BinOp::Lt;
            if inclusive { cmp_op = BinOp::LtEq; }
            var cond_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(cmp_op, var_val, end_val, IrType::Bool));
            Lowerer_emit_terminator(self, Inst::Branch(cond_val, body_block, exit_block));

            // Body
            Lowerer_set_current_block(self, body_block);
            self.loop_stack.push(LoopContext_new(cond_block, exit_block, OptValueId::None));
            Lowerer_lower_stmts(self, body);
            self.loop_stack.pop();

            // Increment: var += 1
            if !Lowerer_current_block_has_terminator(self) {
                var current: i64 = Lowerer_emit_inst(self, Inst::Load(alloca, IrType::I64));
                var one: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
                var inc: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, current, one, IrType::I64));
                var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(alloca, inc, OptIrType::None));
                Lowerer_emit_terminator(self, Inst::Jump(cond_block));
            }

            Lowerer_set_current_block(self, exit_block);
        }
        _ => {
            // Non-range iterator: lower the iterator expression and iterate
            var iter_val: i64 = Lowerer_lower_expr(self, iterator);
            var iter_ty: IrType = Lowerer_get_value_type(self, iter_val);

            // Check if Vec
            if ir_type_is_opaque_named(iter_ty, "Vec") {
                Lowerer_lower_for_vec(self, loop_var, iter_val, body);
                return;
            }
            // Check if HashMap — get keys as Vec
            if ir_type_is_opaque_named(iter_ty, "HashMap") {
                var dummy_env: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
                var args: Vec<i64> = Vec::new();
                args.push(dummy_env);
                args.push(iter_val);
                var keys_vec: i64 = Lowerer_emit_inst(self, Inst::Call("HashMap_keys", args, opaque_ty("Vec"), EffectSet_new()));
                Lowerer_lower_for_vec(self, loop_var, keys_vec, body);
                return;
            }
            // Default: treat as Vec iteration (most common case for opaque types)
            if ir_type_is_ptr_like(iter_ty) || ir_type_eq(iter_ty, IrType::I64) {
                Lowerer_lower_for_vec(self, loop_var, iter_val, body);
                return;
            }

            // Array iterator
            var arr_val: i64 = iter_val;
            var arr_ty: IrType = Lowerer_get_value_type(self, arr_val);
            var elem_ty: IrType = IrType::I64;
            var arr_len: i64 = 0;
            match arr_ty {
                IrType::Array(inner, len) => {
                    elem_ty = box_ir_type_unbox(inner);
                    arr_len = len;
                }
                IrType::Ptr(inner2) => {
                    var inner_ty: IrType = box_ir_type_unbox(inner2);
                    match inner_ty {
                        IrType::Array(inner3, len3) => {
                            elem_ty = box_ir_type_unbox(inner3);
                            arr_len = len3;
                        }
                        _ => { elem_ty = IrType::I64; arr_len = 0; }
                    }
                }
                _ => { elem_ty = IrType::I64; arr_len = 0; }
            }

            // Create alloca for loop variable
            var var_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(elem_ty, Lowerer_current_region(self)));
            Lowerer_insert_alloca_type(self, var_alloca, elem_ty);
            Lowerer_insert_alloca(self, loop_var, var_alloca);
            Lowerer_bind_local(self, loop_var, var_alloca);

            // Create index alloca
            var idx_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
            Lowerer_insert_alloca_type(self, idx_alloca, IrType::I64);
            var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
            var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, zero, OptIrType::None));

            var cond_block: i64 = Lowerer_new_block(self);
            var body_block: i64 = Lowerer_new_block(self);
            var exit_block: i64 = Lowerer_new_block(self);

            Lowerer_emit_terminator(self, Inst::Jump(cond_block));

            // Condition: i < arr_len
            Lowerer_set_current_block(self, cond_block);
            var idx_val: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
            var len_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(arr_len, IrType::I64));
            var cond_val2: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, idx_val, len_val, IrType::Bool));
            Lowerer_emit_terminator(self, Inst::Branch(cond_val2, body_block, exit_block));

            // Body
            Lowerer_set_current_block(self, body_block);
            self.loop_stack.push(LoopContext_new(cond_block, exit_block, OptValueId::None));

            // Load element: arr[i]
            var elem_ptr: i64 = Lowerer_emit_inst(self, Inst::GetElemPtr(arr_val, idx_val, elem_ty));
            var elem_val: i64 = Lowerer_emit_inst(self, Inst::Load(elem_ptr, elem_ty));
            var _s4: i64 = Lowerer_emit_inst(self, Inst::Store(var_alloca, elem_val, OptIrType::None));

            Lowerer_lower_stmts(self, body);
            self.loop_stack.pop();

            // Increment index
            if !Lowerer_current_block_has_terminator(self) {
                var idx_val2: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
                var one2: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
                var inc2: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, idx_val2, one2, IrType::I64));
                var _s5: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, inc2, OptIrType::None));
                Lowerer_emit_terminator(self, Inst::Jump(cond_block));
            }

            Lowerer_set_current_block(self, exit_block);
        }
    }
}

pub fn Lowerer_lower_for_vec(self: &mut Lowerer, loop_var: str, vec_val: i64, body: Vec<Stmt>) {
    // Create alloca for loop variable
    var var_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
    Lowerer_insert_alloca_type(self, var_alloca, IrType::I64);
    Lowerer_insert_alloca(self, loop_var, var_alloca);
    Lowerer_bind_local(self, loop_var, var_alloca);

    // Create index alloca
    var idx_alloca: i64 = Lowerer_emit_inst(self, Inst::Alloca(IrType::I64, Lowerer_current_region(self)));
    Lowerer_insert_alloca_type(self, idx_alloca, IrType::I64);
    var zero: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
    var _s: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, zero, OptIrType::None));

    var cond_block: i64 = Lowerer_new_block(self);
    var body_block: i64 = Lowerer_new_block(self);
    var exit_block: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Jump(cond_block));

    // Condition: i < Vec_len(vec)
    Lowerer_set_current_block(self, cond_block);
    var idx_val: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
    var len_args: Vec<i64> = Vec::new();
    len_args.push(vec_val);
    var len_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_vec_len", len_args, IrType::I64, EffectSet_new()));
    var cond_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, idx_val, len_val, IrType::Bool));
    Lowerer_emit_terminator(self, Inst::Branch(cond_val, body_block, exit_block));

    // Body
    Lowerer_set_current_block(self, body_block);
    self.loop_stack.push(LoopContext_new(cond_block, exit_block, OptValueId::None));

    // Load element: Vec_get(vec, i)
    var get_args: Vec<i64> = Vec::new();
    get_args.push(vec_val);
    get_args.push(idx_val);
    var elem_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_vec_get", get_args, IrType::I64, EffectSet_new()));
    var _s2: i64 = Lowerer_emit_inst(self, Inst::Store(var_alloca, elem_val, OptIrType::None));

    Lowerer_lower_stmts(self, body);
    self.loop_stack.pop();

    // Increment index
    if !Lowerer_current_block_has_terminator(self) {
        var idx_val2: i64 = Lowerer_emit_inst(self, Inst::Load(idx_alloca, IrType::I64));
        var one: i64 = Lowerer_emit_inst(self, Inst::ConstInt(1, IrType::I64));
        var inc: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Add, idx_val2, one, IrType::I64));
        var _s3: i64 = Lowerer_emit_inst(self, Inst::Store(idx_alloca, inc, OptIrType::None));
        Lowerer_emit_terminator(self, Inst::Jump(cond_block));
    }

    Lowerer_set_current_block(self, exit_block);
}

pub fn Lowerer_lower_loop(self: &mut Lowerer, body: Vec<Stmt>) {
    var body_block: i64 = Lowerer_new_block(self);
    var exit_block: i64 = Lowerer_new_block(self);

    Lowerer_emit_terminator(self, Inst::Jump(body_block));

    // Body block
    Lowerer_set_current_block(self, body_block);
    self.loop_stack.push(LoopContext_new(body_block, exit_block, OptValueId::None));
    Lowerer_lower_stmts(self, body);
    self.loop_stack.pop();

    // If body doesn't end with terminator, jump back to body (infinite loop)
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Jump(body_block));
    }

    Lowerer_set_current_block(self, exit_block);
}

pub fn Lowerer_lower_match(self: &mut Lowerer, expr: Expr, arms: Vec<MatchArm>) {
    // Full match lowering for statements.
    var match_val: i64 = Lowerer_lower_expr(self, expr);
    var merge_block: i64 = Lowerer_new_block(self);

    var i: i64 = 0;
    while i < arms.len() {
        var arm: MatchArm = arms.get(i);
        var arm_block: i64 = Lowerer_new_block(self);
        var next_block: i64 = Lowerer_new_block(self);

        match arm.pattern {
            Pattern::Wildcard => {
                Lowerer_emit_terminator(self, Inst::Jump(arm_block));
            }
            Pattern::IntLit(v) => {
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstInt(v, IrType::I64)), IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::BoolLit(v) => {
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, match_val, Lowerer_emit_inst(self, Inst::ConstBool(v)), IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::Ident(name) => {
                Lowerer_bind_local(self, name, match_val);
                Lowerer_emit_terminator(self, Inst::Jump(arm_block));
            }
            Pattern::StrLit(s) => {
                var const_str: i64 = Lowerer_emit_inst(self, Inst::ConstStr(s));
                var str_eq_args: Vec<i64> = Vec::new();
                str_eq_args.push(match_val);
                str_eq_args.push(const_str);
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::Call("p_str_equal", str_eq_args, IrType::Bool, EffectSet_new()));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));
            }
            Pattern::Range(start_pat, end_pat) => {
                var lo: i64 = 0;
                var hi: i64 = 0;
                var range_ok: bool = false;
                match start_pat {
                    Pattern::IntLit(s) => { lo = s; match end_pat { Pattern::IntLit(e) => { hi = e; range_ok = true; } _ => {} } }
                    _ => {}
                }
                if range_ok {
                    var start_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(lo, IrType::I64));
                    var end_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(hi, IrType::I64));
                    var lo_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::LtEq, start_val, match_val, IrType::Bool));
                    var hi_cmp: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Lt, match_val, end_val, IrType::Bool));
                    var in_range: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::And, lo_cmp, hi_cmp, IrType::Bool));
                    Lowerer_emit_terminator(self, Inst::Branch(in_range, arm_block, next_block));
                } else {
                    Lowerer_emit_terminator(self, Inst::Jump(next_block));
                }
            }
            Pattern::EnumVariant(enum_name, variant, bindings) => {
                // Load tag from offset 0 and compare with variant index
                var tag_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, 0, IrType::I64));
                var tag_val: i64 = Lowerer_emit_inst(self, Inst::Load(tag_ptr, IrType::I64));

                // Find variant index
                var variant_idx: i64 = 0;
                if str_len(enum_name) > 0 {
                    match Lowerer_lookup_enum(self, enum_name) {
                        OptEnumDef::Some(def) => {
                            var vi: i64 = 0;
                            while vi < def.variants.len() {
                                if str_equal(def.variants.get(vi).name, variant) {
                                    variant_idx = vi;
                                }
                                vi = vi + 1;
                            }
                        }
                        OptEnumDef::None => {}
                    }
                } else {
                    var ei: i64 = 0;
                    while ei < self.enums.len() {
                        var def2: EnumDef = self.enums.get(ei).val;
                        var vi: i64 = 0;
                        while vi < def2.variants.len() {
                            if str_equal(def2.variants.get(vi).name, variant) {
                                variant_idx = vi;
                            }
                            vi = vi + 1;
                        }
                        ei = ei + 1;
                    }
                }

                var expected: i64 = Lowerer_emit_inst(self, Inst::ConstInt(variant_idx, IrType::I64));
                var cmp_val: i64 = Lowerer_emit_inst(self, Inst::BinOp(BinOp::Eq, tag_val, expected, IrType::Bool));
                Lowerer_emit_terminator(self, Inst::Branch(cmp_val, arm_block, next_block));

                // In arm block: bind payload fields
                Lowerer_set_current_block(self, arm_block);
                var bi: i64 = 0;
                while bi < bindings.len() {
                    var binding: Binding = bindings.get(bi);
                    var field_ptr: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(match_val, bi + 1, IrType::I64));
                    var field_val: i64 = Lowerer_emit_inst(self, Inst::Load(field_ptr, IrType::I64));
                    Lowerer_bind_local(self, binding.name, field_val);
                    bi = bi + 1;
                }
                Lowerer_lower_stmts(self, arm.body);
                if !Lowerer_current_block_has_terminator(self) {
                    Lowerer_emit_terminator(self, Inst::Jump(merge_block));
                }
                Lowerer_set_current_block(self, next_block);
                i = i + 1;
                continue;
            }
        }

        // Arm body (for non-EnumVariant patterns)
        Lowerer_set_current_block(self, arm_block);
        Lowerer_lower_stmts(self, arm.body);
        if !Lowerer_current_block_has_terminator(self) {
            Lowerer_emit_terminator(self, Inst::Jump(merge_block));
        }

        Lowerer_set_current_block(self, next_block);
        i = i + 1;
    }

    // No arm matched — jump to merge (or unreachable)
    if !Lowerer_current_block_has_terminator(self) {
        Lowerer_emit_terminator(self, Inst::Unreachable);
    }

    Lowerer_set_current_block(self, merge_block);
}

pub fn Lowerer_lower_compound_assign(self: &mut Lowerer, op: AssignOp, current: i64, rhs: i64) -> i64 {
    var binop: BinOp = BinOp::Add;
    match op {
        AssignOp::AddAssign => { binop = BinOp::Add; }
        AssignOp::SubAssign => { binop = BinOp::Sub; }
        AssignOp::MulAssign => { binop = BinOp::Mul; }
        AssignOp::DivAssign => { binop = BinOp::Div; }
        AssignOp::ModAssign => { binop = BinOp::Mod; }
        AssignOp::BitAndAssign => { binop = BinOp::BitAnd; }
        AssignOp::BitOrAssign => { binop = BinOp::BitOr; }
        AssignOp::BitXorAssign => { binop = BinOp::BitXor; }
        AssignOp::ShlAssign => { binop = BinOp::Shl; }
        AssignOp::ShrAssign => { binop = BinOp::Shr; }
        AssignOp::Assign => { return rhs; }
    }
    var ty: IrType = Lowerer_get_value_type(self, current);
    return Lowerer_emit_inst(self, Inst::BinOp(binop, current, rhs, ty));
}

pub fn Lowerer_infer_expr_ast_type(self: &Lowerer, expr: Expr) -> Type {
    match expr {
        Expr::IntLit(_) => { return Type::I64; }
        Expr::FloatLit(_) => { return Type::F64; }
        Expr::BoolLit(_) => { return Type::Bool; }
        Expr::StringLit(_) => { return Type::Str; }
        Expr::Call(callee, _) => {
            match Lowerer_lookup_func_ret_type(self, callee) {
                OptType::Some(t) => { return t; }
                OptType::None => { return Type::I64; }
            }
            return Type::I64;
        }
        Expr::MethodCall(recv, method, _) => {
            match box_expr_unbox(recv) {
                Expr::Ident(name) => {
                    match Lowerer_lookup_var_ast_type(self, name) {
                        OptType::Some(t) => {
                            match t {
                                Type::Named(struct_name) => {
                                    match Lowerer_lookup_impl_method(self, struct_name, method) {
                                        OptFunc::Some(f) => { return f.ret_ty; }
                                        OptFunc::None => {}
                                    }
                                }
                                _ => {}
                            }
                        }
                        OptType::None => {}
                    }
                }
                _ => {}
            }
            return Type::I64;
        }
        Expr::Ident(name) => {
            match Lowerer_lookup_var_ast_type(self, name) {
                OptType::Some(t) => { return t; }
                OptType::None => {}
            }
            return Type::I64;
        }
        _ => { return Type::I64; }
    }
    return Type::I64;
}

pub fn Lowerer_type_struct_name(self: &Lowerer, ty: Type) -> OptStringLower {
    match ty {
        Type::Named(n) => {
            // Check if it's a struct (not an enum or alias)
            match Lowerer_lookup_struct(self, n) {
                OptStructDef::Some(_) => { return OptStringLower::Some(n); }
                OptStructDef::None => {}
            }
            // Check resolved alias
            match Lowerer_lookup_type_alias(self, n) {
                OptType::Some(alias) => { return Lowerer_type_struct_name(self, alias); }
                OptType::None => {}
            }
            return OptStringLower::None;
        }
        Type::Generic(n, _) => {
            match Lowerer_lookup_struct(self, n) {
                OptStructDef::Some(_) => { return OptStringLower::Some(n); }
                OptStructDef::None => {}
            }
            return OptStringLower::None;
        }
        _ => { return OptStringLower::None; }
    }
    return OptStringLower::None;
}

pub fn Lowerer_has_drop_impl(self: &Lowerer, struct_name: str) -> bool {
    // Check if there's a Drop_{struct_name} function
    match Lowerer_lookup_impl_method(self, struct_name, "drop") {
        OptFunc::Some(_) => { return true; }
        OptFunc::None => {}
    }
    // Also check for "Drop" trait impl
    match Lowerer_lookup_impl_method(self, struct_name, "Drop_drop") {
        OptFunc::Some(_) => { return true; }
        OptFunc::None => {}
    }
    return false;
}

pub fn Lowerer_emit_drops(self: &mut Lowerer) {
    // Emit drop calls for locals with Drop impls, in reverse order
    var i: i64 = self.current_func.drop_locals.len() - 1;
    while i >= 0 {
        var entry: ValueIdString = self.current_func.drop_locals.get(i);
        var drop_name: str = entry.name + "_drop";
        // Call drop function: drop(alloca_ptr)
        var args: Vec<i64> = Vec::new();
        args.push(Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64)));  // __env
        args.push(entry.id);
        var _v: i64 = Lowerer_emit_inst(self, Inst::Call(drop_name, args, IrType::Void, EffectSet_new()));
        i = i - 1;
    }
}

pub fn Lowerer_infer_binop_type(self: &Lowerer, op: BinOp, left: Expr, right: Expr) -> IrType {
    // Comparison operators return bool
    if binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::LtEq) ||
       binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::GtEq) {
        return IrType::Bool;
    }
    // Logical operators return bool
    if binop_eq(op, BinOp::And) || binop_eq(op, BinOp::Or) {
        return IrType::Bool;
    }
    // Arithmetic operators: infer from left operand
    var left_ty: IrType = Lowerer_infer_expr_type(self, left);
    if ir_type_eq(left_ty, IrType::Void) || ir_type_eq(left_ty, IrType::I64) {
        var right_ty: IrType = Lowerer_infer_expr_type(self, right);
        if ir_type_eq(right_ty, IrType::F64) { return IrType::F64; }
        return IrType::I64;
    }
    return left_ty;
}

pub fn Lowerer_infer_unary_type(self: &Lowerer, op: UnaryOp, expr: Expr) -> IrType {
    if unaryop_eq(op, UnaryOp::Not) {
        return IrType::Bool;
    }
    return Lowerer_infer_expr_type(self, expr);
}

pub fn Lowerer_infer_expr_type(self: &Lowerer, expr: Expr) -> IrType {
    match expr {
        Expr::IntLit(_) => { return IrType::I64; }
        Expr::FloatLit(_) => { return IrType::F64; }
        Expr::BoolLit(_) => { return IrType::Bool; }
        Expr::StringLit(_) => { return ptr_u8(); }
        Expr::Ident(name) => {
            match Lowerer_lookup_alloca(self, name) {
                OptValueId::Some(alloca) => {
                    match Lowerer_lookup_alloca_type(self, alloca) {
                        OptIrType::Some(t) => { return t; }
                        OptIrType::None => {}
                    }
                }
                OptValueId::None => {}
            }
            // Fall back to AST type (e.g. for function parameters)
            match Lowerer_lookup_var_ast_type(self, name) {
                OptType::Some(ast_ty) => { return Lowerer_lower_type(self, ast_ty); }
                OptType::None => {}
            }
            return IrType::I64;
        }
        Expr::Binary(op, left, right) => {
            return Lowerer_infer_binop_type(self, op, box_expr_unbox(left), box_expr_unbox(right));
        }
        Expr::Unary(op, e) => {
            return Lowerer_infer_unary_type(self, op, box_expr_unbox(e));
        }
        Expr::Call(callee, _) => {
            return Lowerer_lookup_func_ret_ty_ir(self, callee);
        }
        Expr::FieldAccess(obj, field) => {
            var obj_ty: IrType = Lowerer_infer_expr_type(self, box_expr_unbox(obj));
            match obj_ty {
                IrType::Struct(name) => {
                    match IrModule_get_struct(&self.module, name) {
                        OptStructLayout::Some(layout) => {
                            var fi: i64 = 0;
                            while fi < layout.fields.len() {
                                if str_equal(layout.fields.get(fi).name, field) {
                                    return layout.fields.get(fi).ty;
                                }
                                fi = fi + 1;
                            }
                        }
                        OptStructLayout::None => {}
                    }
                }
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(name2) => {
                            match IrModule_get_struct(&self.module, name2) {
                                OptStructLayout::Some(layout) => {
                                    var fi: i64 = 0;
                                    while fi < layout.fields.len() {
                                        if str_equal(layout.fields.get(fi).name, field) {
                                            return layout.fields.get(fi).ty;
                                        }
                                        fi = fi + 1;
                                    }
                                }
                                OptStructLayout::None => {}
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
            return IrType::I64;
        }
        Expr::Cast(_, ty) => { return Lowerer_lower_type(self, ty); }
        Expr::StructLit(name, _, _) => { return IrType::Struct(name); }
        Expr::EnumLit(enum_name, _, _) => { return IrType::Struct(enum_name); }
        Expr::TupleLit(_) => { return IrType::Opaque("tuple"); }
        Expr::MethodCall(recv, method, _) => {
            // Check if this is Box::new(x), Vec::new(), etc.
            match box_expr_unbox(recv) {
                Expr::Ident(name) => {
                    if name == "Box" && method == "new" { return IrType::Ptr(Box::new(IrType::U8)); }
                    if name == "Vec" && method == "new" { return IrType::Opaque("Vec"); }
                    if name == "HashMap" && method == "new" { return IrType::Opaque("HashMap"); }
                    if name == "String" && method == "from" { return IrType::Opaque("String"); }
                }
                _ => {}
            }
            // Builtin Vec methods — infer from receiver type
            // First try IR type, then fall back to AST type
            var recv_ty: IrType = Lowerer_infer_expr_type(self, box_expr_unbox(recv));
            // If IR type is I64 or Opaque, try AST type for generic info
            var use_ast_elem: bool = false;
            var ast_elem_ty: IrType = IrType::I64;
            match recv_ty {
                IrType::Generic(name, gargs) => {
                    if name == "Vec" {
                        var elem_ty: IrType = IrType::I64;
                        if gargs.len() > 0 { elem_ty = gargs.get(0); }
                        if method == "push" || method == "set" || method == "clear" || method == "insert" || method == "reverse" || method == "extend" || method == "truncate" || method == "sort" || method == "for_each" { return IrType::Void; }
                        if method == "pop" || method == "get" || method == "remove" || method == "first" || method == "last" { return elem_ty; }
                        if method == "len" || method == "find" || method == "position" { return IrType::I64; }
                        if method == "is_empty" || method == "contains" || method == "any" || method == "all" { return IrType::Bool; }
                        if method == "capacity" { return IrType::I64; }
                        if method == "clone" || method == "map" || method == "filter" {
                            var clone_args: Vec<IrType> = Vec::new();
                            clone_args.push(elem_ty);
                            return IrType::Generic("Vec", clone_args);
                        }
                        if method == "fold" { return IrType::I64; }
                    }
                }
                IrType::Opaque(oname) => {
                    if oname == "Vec" {
                        // Try to get element type from AST type annotation
                        match box_expr_unbox(recv) {
                            Expr::Ident(vname) => {
                                match Lowerer_lookup_var_ast_type(self, vname) {
                                    OptType::Some(at) => {
                                        match at {
                                            Type::Generic(gname, gargs) => {
                                                if gname == "Vec" && gargs.len() > 0 {
                                                    ast_elem_ty = Lowerer_lower_type(self, gargs.get(0));
                                                    use_ast_elem = true;
                                                }
                                            }
                                            _ => {}
                                        }
                                    }
                                    OptType::None => {}
                                }
                            }
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
            if use_ast_elem {
                if method == "pop" || method == "get" || method == "remove" || method == "first" || method == "last" { return ast_elem_ty; }
                if method == "clone" || method == "map" || method == "filter" {
                    var clone_args: Vec<IrType> = Vec::new();
                    clone_args.push(ast_elem_ty);
                    return IrType::Generic("Vec", clone_args);
                }
            }
            // Fallback: look up mangled function name
            var struct_name: str = "";
            match recv_ty {
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(n) => { struct_name = n; }
                        _ => {}
                    }
                }
                IrType::Struct(n) => { struct_name = n; }
                IrType::Generic(n, _) => { struct_name = n; }
                IrType::Opaque(n) => { struct_name = n; }
                _ => {}
            }
            if str_len(struct_name) > 0 {
                return Lowerer_lookup_func_ret_ty_ir(self, struct_name + "_" + method);
            }
            return Lowerer_lookup_func_ret_ty_ir(self, method);
        }
        _ => { return IrType::I64; }
    }
    return IrType::I64;
}

pub fn Lowerer_lookup_func_ret_ty_ir(self: &Lowerer, name: str) -> IrType {
    // Check module functions
    match IrModule_get_function(&self.module, name) {
        OptIrFunction::Some(f) => { return f.ret_ty; }
        OptIrFunction::None => {}
    }
    // Check extern functions
    var i: i64 = 0;
    while i < self.module.extern_functions.len() {
        if str_equal(self.module.extern_functions.get(i).name, name) {
            return self.module.extern_functions.get(i).ret;
        }
        i = i + 1;
    }
    // Check impl methods (mangled name)
    // The name should already be mangled at this point
    return IrType::I64;
}

pub fn Lowerer_lower_cast(self: &mut Lowerer, val: i64, src_ty: IrType, dst_ty: IrType) -> i64 {
    // If types are the same, no cast needed
    if ir_type_eq(src_ty, dst_ty) { return val; }

    // Int to Int (different sizes): extend or truncate
    if ir_type_is_int(src_ty) && ir_type_is_int(dst_ty) {
        var src_size: i64 = ir_type_size(src_ty);
        var dst_size: i64 = ir_type_size(dst_ty);
        if dst_size > src_size {
            return Lowerer_emit_inst(self, Inst::IntExtend(val, src_ty, dst_ty));
        } else if dst_size < src_size {
            return Lowerer_emit_inst(self, Inst::IntTrunc(val, src_ty, dst_ty));
        } else {
            return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
        }
    }
    // Int to Float
    if ir_type_is_int(src_ty) && ir_type_is_float(dst_ty) {
        return Lowerer_emit_inst(self, Inst::IntToFloat(val, src_ty, dst_ty));
    }
    // Float to Int
    if ir_type_is_float(src_ty) && ir_type_is_int(dst_ty) {
        return Lowerer_emit_inst(self, Inst::FloatToInt(val, src_ty, dst_ty));
    }
    // Float to Float (different sizes)
    if ir_type_is_float(src_ty) && ir_type_is_float(dst_ty) {
        return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
    }
    // Ptr to Ptr
    if ir_type_is_ptr(src_ty) && ir_type_is_ptr(dst_ty) {
        Lowerer_set_value_type(self, val, dst_ty);
        return val;
    }
    // Ptr to Bool (null check)
    if ir_type_is_ptr(src_ty) && ir_type_eq(dst_ty, IrType::Bool) {
        var null_val: i64 = Lowerer_emit_inst(self, Inst::ConstInt(0, IrType::I64));
        return Lowerer_emit_inst(self, Inst::BinOp(BinOp::Neq, val, null_val, IrType::Bool));
    }
    // Bool to Int
    if ir_type_eq(src_ty, IrType::Bool) && ir_type_is_int(dst_ty) {
        return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
    }
    // Default: bitcast
    return Lowerer_emit_inst(self, Inst::BitCast(val, src_ty, dst_ty));
}

pub fn Lowerer_infer_match_type(self: &Lowerer, arms: Vec<MatchArm>) -> IrType {
    var i: i64 = 0;
    while i < arms.len() {
        var si: i64 = 0;
        while si < arms.get(i).body.len() {
            match arms.get(i).body.get(si) {
                Stmt::Expr(e, _) => { return Lowerer_infer_expr_type(self, e); }
                _ => {}
            }
            si = si + 1;
        }
        i = i + 1;
    }
    return IrType::I64;
}

pub fn Lowerer_emit_sret_copy(self: &mut Lowerer, src_ptr: i64) {
    // Copy struct data from src_ptr to sret
    match self.current_sret {
        OptValueId::Some(sret) => {
            // Determine struct name from sret type
            var sret_ty: IrType = Lowerer_get_value_type(self, sret);
            var struct_name: str = "";
            match sret_ty {
                IrType::Ptr(inner) => {
                    match box_ir_type_unbox(inner) {
                        IrType::Struct(n) => { struct_name = n; }
                        _ => {}
                    }
                }
                _ => {}
            }
            Lowerer_emit_struct_copy(self, src_ptr, sret, struct_name);
        }
        OptValueId::None => {}
    }
}

pub fn Lowerer_emit_struct_copy(self: &mut Lowerer, src_ptr: i64, dst_ptr: i64, struct_name: str) {
    // Copy each field
    match IrModule_get_struct(&self.module, struct_name) {
        OptStructLayout::Some(layout) => {
            var fi: i64 = 0;
            while fi < layout.fields.len() {
                var field_ty: IrType = layout.fields.get(fi).ty;
                var src_field: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(src_ptr, fi, field_ty));
                var dst_field: i64 = Lowerer_emit_inst(self, Inst::GetFieldPtr(dst_ptr, fi, field_ty));
                // For struct-typed fields, use memcpy-like copy (load+store pointer)
                // For scalar fields, use Load+Store
                match field_ty {
                    IrType::Struct(_) => {
                        // Struct fields are stored as pointers — load and store the pointer
                        var val: i64 = Lowerer_emit_inst(self, Inst::Load(src_field, field_ty));
                        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(dst_field, val, OptIrType::None));
                    }
                    _ => {
                        var val: i64 = Lowerer_emit_inst(self, Inst::Load(src_field, field_ty));
                        var _s: i64 = Lowerer_emit_inst(self, Inst::Store(dst_field, val, OptIrType::None));
                    }
                }
                fi = fi + 1;
            }
        }
        OptStructLayout::None => {}
    }
}

// ─── f64 to bits conversion ───────────────────────────────────────────────

// f64_to_bits is no longer needed — ConstFloat now stores f64 directly.
// Kept as a stub for backward compatibility.
pub fn f64_to_bits(f: f64) -> i64 {
    return 0;
}

pub fn Lowerer_emit_defers(self: &mut Lowerer) {
    // Emit defer blocks in reverse order (LIFO)
    var i: i64 = self.defer_stack.len() - 1;
    while i >= 0 {
        var stmts: Vec<Stmt> = self.defer_stack.get(i).stmts;
        Lowerer_lower_stmts(self, stmts);
        i = i - 1;
    }
}

// ─── ValueIdString helper ─────────────────────────────────────────────────

pub struct ValueIdString {
    pub id: i64,
    pub name: str,
}

pub fn ValueIdString_new(id: i64, name: str) -> ValueIdString {
    return ValueIdString { id: id, name: name };
}

// ─── String parsing helpers ───────────────────────────────────────────────

pub fn str_parse_u64(s: str) -> OptU64 {
    // Simple parsing: trim whitespace, parse digits
    var trimmed: str = str_trim(s);
    if trimmed == "" { return OptU64::None; }
    var result: i64 = 0;
    var i: i64 = 0;
    var len: i64 = str_len(trimmed);
    while i < len {
        var c: i64 = str_byte_at(trimmed, i);
        if c < 48 || c > 57 { return OptU64::None; }  // not a digit
        result = result * 10 + (c - 48);
        i = i + 1;
    }
    return OptU64::Some(result);
}
