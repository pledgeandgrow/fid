// --- Utility functions ----------------------------------------------------

/// Check if a string is contained in a Vec<str>.
pub fn lw_c_str_vec_contains(vec: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if vec.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

pub fn is_vec_type_name(name: str) -> bool {
    if name == "vec2" { return true; }
    if name == "vec3" { return true; }
    if name == "vec4" { return true; }
    return false;
}

pub fn get_vec_type_name(ty: IrType) -> OptStringLower {
    match ty {
        IrType::Struct(name) => {
            if is_vec_type_name(name) { return OptStringLower::Some(name); }
            return OptStringLower::None;
        }
        IrType::Ptr(inner) => { return get_vec_type_name(box_ir_type_unbox(inner)); }
        _ => { return OptStringLower::None; }
    }
    return OptStringLower::None;
}

pub fn is_valid_swizzle(field: str) -> bool {
    var len: i64 = str_len(field);
    if len < 2 { return false; }
    if len > 4 { return false; }
    // Check all chars are valid swizzle components
    var i: i64 = 0;
    while i < len {
        var c: i64 = str_byte_at(field, i);
        if c != 120 && c != 121 && c != 122 && c != 119 &&  // x y z w
           c != 114 && c != 103 && c != 98 && c != 97 &&     // r g b a
           c != 115 && c != 116 && c != 112 && c != 113 {    // s t p q
            return false;
        }
        i = i + 1;
    }
    // Check consistent group
    var first: i64 = str_byte_at(field, 0);
    var group: i64 = 0;  // 0=xyzw, 1=rgba, 2=stpq
    if first == 120 || first == 121 || first == 122 || first == 119 { group = 0; }
    else if first == 114 || first == 103 || first == 98 || first == 97 { group = 1; }
    else { group = 2; }

    i = 0;
    while i < len {
        var c: i64 = str_byte_at(field, i);
        if group == 0 {
            if c != 120 && c != 121 && c != 122 && c != 119 { return false; }
        } else if group == 1 {
            if c != 114 && c != 103 && c != 98 && c != 97 { return false; }
        } else {
            if c != 115 && c != 116 && c != 112 && c != 113 { return false; }
        }
        i = i + 1;
    }
    return true;
}

pub fn swizzle_index(c: i64) -> i64 {
    // x|r|s => 0, y|g|t => 1, z|b|p => 2, w|a|q => 3
    if c == 120 || c == 114 || c == 115 { return 0; }
    if c == 121 || c == 103 || c == 116 { return 1; }
    if c == 122 || c == 98 || c == 112 { return 2; }
    if c == 119 || c == 97 || c == 113 { return 3; }
    return 0;
}

// --- Runtime effects ------------------------------------------------------

pub fn runtime_effects(name: str) -> OptEffectSet {
    var effects: EffectSet = EffectSet_new();

    // Mutating vec operations
    if name == "p_vec_push" || name == "p_vec_push_str" || name == "p_vec_set" ||
       name == "p_vec_clear" || name == "p_vec_insert" || name == "p_vec_remove" ||
       name == "p_vec_reverse" || name == "p_vec_extend" || name == "p_vec_truncate" ||
       name == "p_vec_sort" || name == "p_vec_resize" {
        EffectSet_add(&mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Allocating functions
    if name == "p_vec_new" || name == "p_vec_new_with" || name == "p_vec_clone" ||
       name == "p_malloc" || name == "p_alloc" || name == "p_free" ||
       name == "p_str_concat" || name == "p_to_str" || name == "p_char_to_str" ||
       name == "p_float_to_str" || name == "p_bool_to_str" || name == "p_str_to_float" ||
       name == "p_string_replace" || name == "p_string_split" || name == "p_string_trim" ||
       name == "p_string_to_uppercase" || name == "p_string_to_lowercase" {
        EffectSet_add(&mut effects, Effect::Alloc);
        return OptEffectSet::Some(effects);
    }
    // IO functions
    if str_starts_with(name, "p_print") || str_starts_with(name, "p_eprint") || name == "p_panic" || str_starts_with(name, "p_write") {
        EffectSet_add(&mut effects, Effect::IO);
        return OptEffectSet::Some(effects);
    }
    // Map mutation
    if name == "p_map_insert" || name == "p_map_remove" || name == "p_map_clear" || name == "p_map_set" {
        EffectSet_add(&mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // String mutation
    if name == "p_string_copy" || name == "p_str_copy" || name == "p_str_free" {
        EffectSet_add(&mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Atomic operations
    if str_starts_with(name, "p_atomic_") {
        EffectSet_add(&mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Channel operations
    if str_starts_with(name, "p_chan_") {
        EffectSet_add(&mut effects, Effect::IO);
        return OptEffectSet::Some(effects);
    }
    // Mutex operations
    if str_starts_with(name, "p_mutex_") {
        EffectSet_add(&mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // RC operations
    if str_starts_with(name, "p_rc_") {
        EffectSet_add(&mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Tensor operations
    if str_starts_with(name, "p_tensor_") {
        EffectSet_add(&mut effects, Effect::Alloc);
        return OptEffectSet::Some(effects);
    }
    // File/IO operations
    if str_starts_with(name, "p_file_") || str_starts_with(name, "p_fs_") || str_starts_with(name, "p_socket_") {
        EffectSet_add(&mut effects, Effect::IO);
        return OptEffectSet::Some(effects);
    }
    // DL operations
    if str_starts_with(name, "p_dl_") {
        EffectSet_add(&mut effects, Effect::IO);
        return OptEffectSet::Some(effects);
    }
    // KV cache, quantization
    if str_starts_with(name, "p_kv_cache_") || str_starts_with(name, "p_quantize") || str_starts_with(name, "p_dequantize") {
        EffectSet_add(&mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Noise operations
    if str_starts_with(name, "p_dp_") || str_starts_with(name, "p_gaussian_") || str_starts_with(name, "p_dropout") {
        EffectSet_add(&mut effects, Effect::Write);
        return OptEffectSet::Some(effects);
    }
    // Comm operations
    if name == "p_all_reduce" || name == "p_broadcast" || name == "p_all_gather" ||
       name == "p_scatter" || name == "p_send_tensor" || name == "p_recv_tensor" {
        EffectSet_add(&mut effects, Effect::IO);
        return OptEffectSet::Some(effects);
    }
    return OptEffectSet::None;
}

// --- OptEffectSet ---------------------------------------------------------

pub enum OptEffectSet {
    Some(EffectSet),
    None,
}

// --- Lowerer struct -------------------------------------------------------

pub struct Lowerer {
    pub module: IrModule,
    pub current_func: IrFunction,
    pub has_current_func: bool,
    pub current_block: i64,
    pub loop_stack: Vec<LoopContext>,
    pub structs: Vec<StringStructDefEntry>,
    pub allocas: Vec<StringValueIdEntry>,
    pub alloca_types: Vec<I64IrTypeEntry>,
    pub var_ast_types: Vec<StringTypeEntry>,
    pub constants: Vec<StringExprEntry>,
    pub current_sret: OptValueId,
    pub enums: Vec<StringEnumDefEntry>,
    pub impl_methods: Vec<StringStringFuncEntry>,
    pub defer_stack: Vec<Vec<Stmt>>,
    pub current_captures: Vec<ClosureCapture>,
    pub try_stack: Vec<TryContext>,
    pub effect_handler_stack: Vec<Vec<EffectHandler>>,
    pub scope_executor_stack: Vec<i64>,
    pub current_line: OptU64,
    pub type_aliases: Vec<StringTypeEntry>,
    pub current_self_type: OptStringLower,
    pub region_stack: Vec<str>,
    pub gpu_region_stack: Vec<str>,
    pub sandbox_depth: i64,
    pub func_ret_types: Vec<StringTypeEntry>,
    pub async_funcs: Vec<str>,
    pub current_func_param_types: Vec<StringTypeEntry>,
    pub vec_allocas: Vec<i64>,
    pub linear_structs: Vec<str>,
    pub let_hint: OptType,
    pub func_param_names: Vec<StringVecStrEntry>,
    pub func_defaults: Vec<StringVecExprEntry>,
}

// --- Lowerer methods ------------------------------------------------------


pub fn lw_c_vec1_i64(x: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(x);
    return v;
}

pub fn c_vec2_i64(x: i64, y: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(x);
    v.push(y);
    return v;
}

pub fn Lowerer_new() -> Lowerer {
    return Lowerer {
        module: IrModule_new(),
        current_func: IrFunction_new("", IrType::Void),
        has_current_func: false,
        current_block: 0,
        loop_stack: Vec::new(),
        structs: Vec::new(),
        allocas: Vec::new(),
        alloca_types: Vec::new(),
        var_ast_types: Vec::new(),
        constants: Vec::new(),
        current_sret: OptValueId::None,
        enums: Vec::new(),
        impl_methods: Vec::new(),
        defer_stack: Vec::new(),
        current_captures: Vec::new(),
        try_stack: Vec::new(),
        effect_handler_stack: Vec::new(),
        scope_executor_stack: Vec::new(),
        current_line: OptU64::None,
        type_aliases: Vec::new(),
        current_self_type: OptStringLower::None,
        region_stack: Vec::new(),
        gpu_region_stack: Vec::new(),
        sandbox_depth: 0,
        func_ret_types: Vec::new(),
        async_funcs: Vec::new(),
        current_func_param_types: Vec::new(),
        vec_allocas: Vec::new(),
        linear_structs: Vec::new(),
        let_hint: OptType::None,
        func_param_names: Vec::new(),
        func_defaults: Vec::new(),
    };
}

pub fn Lowerer_current_region(self: &Lowerer) -> Region {
    if self.region_stack.len() > 0 {
        return Region::Named(self.region_stack.get(self.region_stack.len() - 1));
    }
    return Region::Stack;
}

// Load a field from an enum variant's inline storage.
// When the field type is a struct (enum), the data is stored inline within
// the parent enum. A plain Inst::Load with a struct type only reads 8 bytes
// (a pointer) because the C codegen treats IrType::Struct as a pointer type.
// To correctly extract the full struct, we allocate a new buffer and use
// Inst::Store with the explicit store_ty to emit a memcpy in the C backend.
pub fn Lowerer_load_enum_field(self: &mut Lowerer, field_ptr: i64, field_ty: IrType) -> i64 {
    match field_ty {
        IrType::Struct(_) => {
            var buf: i64 = Lowerer_emit_inst(self, Inst::Alloca(field_ty, Lowerer_current_region(self)));
            Lowerer_emit_inst(self, Inst::Store(buf, field_ptr, OptIrType::Some(field_ty)));
            return buf;
        }
        _ => {
            return Lowerer_emit_inst(self, Inst::Load(field_ptr, field_ty));
        }
    }
}

/// If `val` is a Box<T> (Ptr(Ptr(Struct(..))) or Generic("Box", [Struct(..)])),
/// load through it once so enum/struct pattern matching sees the inner struct
/// pointer directly. Otherwise return `val` unchanged.
///
/// NOTE: Box::new stores the struct data directly in the heap allocation (via
/// memcpy), so the Box pointer already points to the struct data. This function
/// is a no-op - the match code can read the tag/fields directly from the Box
/// pointer.
pub fn Lowerer_maybe_deref_box(self: &mut Lowerer, val: i64) -> i64 {
    // Box::new copies the full struct data into the heap allocation via
    // memcpy, so the Box pointer already points to the struct data.
    // No dereference needed - return val unchanged.
    return val;
}

/// Compute the number of 8-byte slots a field occupies in an enum layout.
/// Struct/enum types use their full layout size (rounded up to 8);
/// all other types use 1 slot.
pub fn Lowerer_enum_field_slots(self: &Lowerer, ty: IrType) -> i64 {
    match ty {
        IrType::Struct(name) => {
            match IrModule_get_struct(&self.module, name) {
                OptStructLayout::Some(layout) => { return (layout.size + 7) / 8; }
                OptStructLayout::None => { return 1; }
            }
        }
        _ => { return 1; }
    }
    return 1;
}

pub fn Lowerer_set_linear_structs(self: &mut Lowerer, structs: Vec<str>) {
    var i: i64 = 0;
    while i < structs.len() {
        self.linear_structs.push(structs.get(i));
        i = i + 1;
    }
}

pub fn Lowerer_is_linear_ir_type(self: &Lowerer, ty: IrType) -> bool {
    match ty {
        IrType::Struct(name) => {
            var i: i64 = 0;
            while i < self.linear_structs.len() {
                if self.linear_structs.get(i) == name { return true; }
                i = i + 1;
            }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

// --- Map lookup helpers ---------------------------------------------------

pub fn Lowerer_lookup_struct(self: &Lowerer, name: str) -> OptStructDef {
    var i: i64 = 0;
    while i < self.structs.len() {
        if self.structs.get(i).key == name { return OptStructDef::Some(self.structs.get(i).val); }
        i = i + 1;
    }
    return OptStructDef::None;
}

pub fn Lowerer_lookup_enum(self: &Lowerer, name: str) -> OptEnumDef {
    var i: i64 = 0;
    while i < self.enums.len() {
        if self.enums.get(i).key == name { return OptEnumDef::Some(self.enums.get(i).val); }
        i = i + 1;
    }
    return OptEnumDef::None;
}

/// Look up the EnumDef a variant pattern refers to. `enum_name` may be
/// empty for shorthand patterns like `Some(x)`, in which case we search
/// all enums for a variant with that name.
pub fn Lowerer_lookup_pattern_enum(self: &Lowerer, enum_name: str, variant: str) -> OptEnumDef {
    if str_len(enum_name) > 0 {
        match Lowerer_lookup_enum(self, enum_name) {
            OptEnumDef::Some(def) => { return OptEnumDef::Some(def); }
            OptEnumDef::None => {}
        }
    }
    var i: i64 = 0;
    while i < self.enums.len() {
        var def: EnumDef = self.enums.get(i).val;
        var vi: i64 = 0;
        while vi < def.variants.len() {
            if def.variants.get(vi).name == variant {
                return OptEnumDef::Some(def);
            }
            vi = vi + 1;
        }
        i = i + 1;
    }
    return OptEnumDef::None;
}

/// IR types for the values bound by an enum-variant pattern.
/// Enum-typed fields (structs/enums declared directly, not Box/Ptr) are
/// stored INLINE in the parent enum (per Lowerer_make_enum_layout). Returning
/// `Struct(name)` for these lets `load_enum_field` copy the full inline data
/// via alloca+memcpy.
/// Box/Ptr/Vec/str fields are one machine word wide (a pointer) and pass
/// through `word_repr` unchanged.
pub fn Lowerer_pattern_binding_ir_types(self: &Lowerer, enum_name: str, variant: str, bindings: Vec<Binding>) -> Vec<IrType> {
    var payload_tys: Vec<Type> = Vec::new();
    var enum_type_params: Vec<str> = Vec::new();
    match Lowerer_lookup_pattern_enum(self, enum_name, variant) {
        OptEnumDef::Some(def) => {
            enum_type_params = def.type_params;
            var vi: i64 = 0;
            while vi < def.variants.len() {
                if def.variants.get(vi).name == variant {
                    match def.variants.get(vi).data {
                        OptParams::Some(params) => {
                            var pi: i64 = 0;
                            while pi < params.len() {
                                payload_tys.push(params.get(pi).ty);
                                pi = pi + 1;
                            }
                        }
                        OptParams::None => {}
                    }
                    break;
                }
                vi = vi + 1;
            }
        }
        OptEnumDef::None => {}
    }
    var result: Vec<IrType> = Vec::new();
    var bi: i64 = 0;
    while bi < bindings.len() {
        var binding: Binding = bindings.get(bi);
        var ir_ty: IrType = IrType::I64;
        if bi < payload_tys.len() {
            var payload_ty: Type = payload_tys.get(bi);
            // Check if the payload type is an unsubstituted type parameter
            // (e.g. T in Option<T>). If so, fall back to i64 or use the
            // binding's type annotation.
            var is_type_param: bool = false;
            match payload_ty {
                Type::Named(n) => {
                    var tpi: i64 = 0;
                    while tpi < enum_type_params.len() {
                        if enum_type_params.get(tpi) == n {
                            is_type_param = true;
                            tpi = enum_type_params.len();
                        }
                        tpi = tpi + 1;
                    }
                }
                _ => {}
            }
            if is_type_param {
                // Type parameter: use binding annotation or i64 fallback
                var binding_annot: str = binding.ty;
                if !str_is_empty(binding_annot) {
                    ir_ty = Lowerer_lower_type(self, Type::Named(binding_annot));
                } else {
                    ir_ty = IrType::I64;
                }
            } else {
                // Keep struct/enum types as-is so load_enum_field copies the
                // full inline data. Box<T> lowers to Ptr(Struct(T)) which is
                // already a word - word_repr leaves it unchanged.
                var lowered: IrType = Lowerer_lower_type(self, payload_ty);
                match lowered {
                    IrType::Struct(_) => { ir_ty = lowered; }
                    _ => { ir_ty = word_repr(lowered); }
                }
            }
        }
        result.push(ir_ty);
        bi = bi + 1;
    }
    return result;
}

/// Like `pattern_binding_ir_types` but returns the AST types, which
/// we need to register in `var_ast_types` so that `infer_expr_type`
/// can recover generic element types (e.g. `Vec<FieldInit>`).
pub fn Lowerer_pattern_binding_ast_types(self: &Lowerer, enum_name: str, variant: str, bindings: Vec<Binding>) -> Vec<Type> {
    var payload_tys: Vec<Type> = Vec::new();
    match Lowerer_lookup_pattern_enum(self, enum_name, variant) {
        OptEnumDef::Some(def) => {
            var vi: i64 = 0;
            while vi < def.variants.len() {
                if def.variants.get(vi).name == variant {
                    match def.variants.get(vi).data {
                        OptParams::Some(params) => {
                            var pi: i64 = 0;
                            while pi < params.len() {
                                payload_tys.push(params.get(pi).ty);
                                pi = pi + 1;
                            }
                        }
                        OptParams::None => {}
                    }
                    break;
                }
                vi = vi + 1;
            }
        }
        OptEnumDef::None => {}
    }
    var result: Vec<Type> = Vec::new();
    var bi: i64 = 0;
    while bi < bindings.len() {
        var binding: Binding = bindings.get(bi);
        var ast_ty: Type = Type::I64;
        if bi < payload_tys.len() {
            var declared: Type = payload_tys.get(bi);
            if !Lowerer_is_opaque_type_param(self, declared) {
                ast_ty = declared;
            } else {
                match Lowerer_ast_type_from_name(self, binding.ty) {
                    OptType::Some(t) => { ast_ty = t; }
                    OptType::None => { ast_ty = Type::I64; }
                }
            }
        } else {
            match Lowerer_ast_type_from_name(self, binding.ty) {
                OptType::Some(t) => { ast_ty = t; }
                OptType::None => { ast_ty = Type::I64; }
            }
        }
        result.push(ast_ty);
        bi = bi + 1;
    }
    return result;
}

pub fn Lowerer_lookup_alloca(self: &Lowerer, name: str) -> OptValueId {
    // Search from the end so shadowed variables find the most recent binding.
    var i: i64 = self.allocas.len() - 1;
    while i >= 0 {
        if self.allocas.get(i).key == name { return OptValueId::Some(self.allocas.get(i).val); }
        i = i - 1;
    }
    return OptValueId::None;
}

pub fn Lowerer_lookup_alloca_type(self: &Lowerer, id: i64) -> OptIrType {
    var i: i64 = 0;
    while i < self.alloca_types.len() {
        if self.alloca_types.get(i).key == id { return OptIrType::Some(self.alloca_types.get(i).val); }
        i = i + 1;
    }
    return OptIrType::None;
}

pub fn Lowerer_lookup_var_ast_type(self: &Lowerer, name: str) -> OptType {
    // Search from the end so shadowed variables find the most recent binding.
    var i: i64 = self.var_ast_types.len() - 1;
    while i >= 0 {
        if self.var_ast_types.get(i).key == name { return OptType::Some(self.var_ast_types.get(i).val); }
        i = i - 1;
    }
    return OptType::None;
}

pub fn Lowerer_lookup_constant(self: &Lowerer, name: str) -> OptExpr {
    var i: i64 = 0;
    while i < self.constants.len() {
        if self.constants.get(i).key == name { return OptExpr::Some(self.constants.get(i).val); }
        i = i + 1;
    }
    return OptExpr::None;
}

pub fn Lowerer_lookup_impl_method(self: &Lowerer, struct_name: str, method_name: str) -> OptFunc {
    var i: i64 = 0;
    while i < self.impl_methods.len() {
        var entry: StringStringFuncEntry = self.impl_methods.get(i);
        if entry.key1 == struct_name && entry.key2 == method_name {
            return OptFunc::Some(entry.val);
        }
        i = i + 1;
    }
    return OptFunc::None;
}

pub fn Lowerer_lookup_func_ret_type(self: &Lowerer, name: str) -> OptType {
    var i: i64 = 0;
    while i < self.func_ret_types.len() {
        if self.func_ret_types.get(i).key == name { return OptType::Some(self.func_ret_types.get(i).val); }
        i = i + 1;
    }
    return OptType::None;
}

pub fn Lowerer_lookup_type_alias(self: &Lowerer, name: str) -> OptType {
    var i: i64 = 0;
    while i < self.type_aliases.len() {
        if self.type_aliases.get(i).key == name { return OptType::Some(self.type_aliases.get(i).val); }
        i = i + 1;
    }
    return OptType::None;
}

pub fn Lowerer_is_async_func(self: &Lowerer, name: str) -> bool {
    var i: i64 = 0;
    while i < self.async_funcs.len() {
        if self.async_funcs.get(i) == name { return true; }
        i = i + 1;
    }
    return false;
}

// Check if a function is an extern (declared, not defined).
pub fn Lowerer_is_extern_func(self: &Lowerer, name: str) -> bool {
    var i: i64 = 0;
    while i < self.module.extern_functions.len() {
        if self.module.extern_functions.get(i).name == name { return true; }
        i = i + 1;
    }
    return false;
}

pub fn Lowerer_lookup_param_type(self: &Lowerer, name: str) -> OptType {
    var i: i64 = 0;
    while i < self.current_func_param_types.len() {
        if self.current_func_param_types.get(i).key == name { return OptType::Some(self.current_func_param_types.get(i).val); }
        i = i + 1;
    }
    return OptType::None;
}

pub fn Lowerer_is_vec_alloca(self: &Lowerer, id: i64) -> bool {
    var i: i64 = 0;
    while i < self.vec_allocas.len() {
        if self.vec_allocas.get(i) == id { return true; }
        i = i + 1;
    }
    return false;
}

// --- Map insert helpers ---------------------------------------------------

pub fn Lowerer_insert_struct(self: &mut Lowerer, name: str, val: StructDef) {
    self.structs.push(StringStructDefEntry_new(name, val));
}

pub fn Lowerer_insert_enum(self: &mut Lowerer, name: str, val: EnumDef) {
    self.enums.push(StringEnumDefEntry_new(name, val));
}

pub fn Lowerer_insert_alloca(self: &mut Lowerer, name: str, val: i64) {
    self.allocas.push(StringValueIdEntry_new(name, val));
}

pub fn Lowerer_insert_alloca_type(self: &mut Lowerer, id: i64, ty: IrType) {
    self.alloca_types.push(I64IrTypeEntry_new(id, ty));
}

pub fn Lowerer_insert_var_ast_type(self: &mut Lowerer, name: str, ty: Type) {
    self.var_ast_types.push(StringTypeEntry_new(name, ty));
}

pub fn Lowerer_insert_constant(self: &mut Lowerer, name: str, expr: Expr) {
    self.constants.push(StringExprEntry_new(name, expr));
}

pub fn Lowerer_insert_impl_method(self: &mut Lowerer, struct_name: str, method_name: str, val: Func) {
    self.impl_methods.push(StringStringFuncEntry_new(struct_name, method_name, val));
}

pub fn Lowerer_insert_func_ret_type(self: &mut Lowerer, name: str, ty: Type) {
    self.func_ret_types.push(StringTypeEntry_new(name, ty));
}

pub fn Lowerer_insert_type_alias(self: &mut Lowerer, name: str, ty: Type) {
    self.type_aliases.push(StringTypeEntry_new(name, ty));
}

pub fn Lowerer_insert_param_type(self: &mut Lowerer, name: str, ty: Type) {
    self.current_func_param_types.push(StringTypeEntry_new(name, ty));
}

pub fn Lowerer_insert_async_func(self: &mut Lowerer, name: str) {
    self.async_funcs.push(name);
}

pub fn Lowerer_insert_linear_struct(self: &mut Lowerer, name: str) {
    self.linear_structs.push(name);
}

pub fn Lowerer_insert_vec_alloca(self: &mut Lowerer, id: i64) {
    self.vec_allocas.push(id);
}

// --- Emit helpers ---------------------------------------------------------

/// Check if a function name is a user-defined function (not a runtime builtin).
/// User functions get __env as first argument; runtime functions (p_*, __ecs_*) don't.
pub fn Lowerer_is_user_func(self: &Lowerer, name: str) -> bool {
    match IrModule_get_function(&self.module, name) {
        OptIrFunction::Some(_) => { return true; }
        OptIrFunction::None => { return false; }
    }
}

/// Check if a function exists in the module (user functions only).
pub fn Lowerer_has_function(self: &Lowerer, name: str) -> bool {
    return Lowerer_is_user_func(self, name);
}

pub fn Lowerer_is_struct(self: &Lowerer, name: str) -> bool {
    var i: i64 = 0;
    while i < self.structs.len() {
        if self.structs.get(i).key == name { return true; }
        i = i + 1;
    }
    return false;
}

pub fn Lowerer_emit_inst(self: &mut Lowerer, inst: Inst) -> i64 {
    return IrFunction_emit(&mut self.current_func, inst);
}

pub fn Lowerer_new_value(self: &mut Lowerer, meta: ValueMeta) -> i64 {
    return IrFunction_new_value(&mut self.current_func, meta);
}

pub fn Lowerer_new_block(self: &mut Lowerer) -> i64 {
    var bb: i64 = IrFunction_new_block(&mut self.current_func);
    return bb;
}

pub fn Lowerer_set_current_block(self: &mut Lowerer, block: i64) {
    self.current_block = block;
    self.current_func.current_block_idx = block;
}

pub fn Lowerer_current_block_has_terminator(self: &Lowerer) -> bool {
    if !self.has_current_func { return false; }
    if self.current_block < 0 { return false; }
    if self.current_block >= self.current_func.blocks.len() { return false; }
    var blk: BasicBlock = self.current_func.blocks.get(self.current_block);
    if blk.instructions.len() == 0 { return false; }
    var last_id: i64 = blk.instructions.get(blk.instructions.len() - 1);
    match IrFunction_get_inst(&self.current_func, last_id) {
        OptInst::Some(inst) => { return inst_is_terminator(inst); }
        OptInst::None => { return false; }
    }
    return false;
}

pub fn Lowerer_set_value_type(self: &mut Lowerer, id: i64, ty: IrType) {
    match IrFunction_get_meta(&self.current_func, id) {
        OptValueMeta::Some(meta) => {
            IrFunction_set_meta(&mut self.current_func, id, ValueMeta_with_type(meta, ty));
        }
        OptValueMeta::None => {}
    }
}

pub fn Lowerer_get_value_type(self: &Lowerer, val: i64) -> IrType {
    match IrFunction_get_meta(&self.current_func, val) {
        OptValueMeta::Some(meta) => { return meta.ty; }
        OptValueMeta::None => { return IrType::I64; }
    }
    return IrType::I64;
}

pub fn Lowerer_emit_terminator(self: &mut Lowerer, inst: Inst) {
    var _v: i64 = Lowerer_emit_inst(self, inst);
}

pub fn Lowerer_bind_local(self: &mut Lowerer, name: str, val: i64) {
    IrFunction_bind_local(&mut self.current_func, name, val);
}

pub fn Lowerer_lookup_local(self: &Lowerer, name: str) -> OptValueId {
    return IrFunction_lookup_local(&self.current_func, name);
}

pub fn Lowerer_add_block_param(self: &mut Lowerer, block: i64, ty: IrType) -> i64 {
    return IrFunction_add_block_param(&mut self.current_func, block, ty);
}

// --- Extern registration helpers ------------------------------------------
// These avoid creating temporary Vec<IrType> for each add_extern call.

pub fn Lowerer_add_extern_0(self: &mut Lowerer, name: str, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    IrModule_add_extern(&mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_1(self: &mut Lowerer, name: str, p1: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    IrModule_add_extern(&mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_2(self: &mut Lowerer, name: str, p1: IrType, p2: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    params.push(p2);
    IrModule_add_extern(&mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_3(self: &mut Lowerer, name: str, p1: IrType, p2: IrType, p3: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    params.push(p2);
    params.push(p3);
    IrModule_add_extern(&mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_4(self: &mut Lowerer, name: str, p1: IrType, p2: IrType, p3: IrType, p4: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    params.push(p2);
    params.push(p3);
    params.push(p4);
    IrModule_add_extern(&mut self.module, name, params, ret);
}

pub fn Lowerer_add_extern_5(self: &mut Lowerer, name: str, p1: IrType, p2: IrType, p3: IrType, p4: IrType, p5: IrType, ret: IrType) {
    var params: Vec<IrType> = Vec::new();
    params.push(p1);
    params.push(p2);
    params.push(p3);
    params.push(p4);
    params.push(p5);
    IrModule_add_extern(&mut self.module, name, params, ret);
}

// Common type aliases
pub fn lw_ptr_u8() -> IrType { return IrType::Ptr(Box::new(IrType::U8)); }
pub fn opaque_ty(name: str) -> IrType { return IrType::Opaque(name); }

// --- Type resolution ------------------------------------------------------

pub fn Lowerer_resolve_type(self: &Lowerer, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            match Lowerer_lookup_type_alias(self, name) {
                OptType::Some(alias) => { return Lowerer_resolve_type(self, alias); }
                OptType::None => { return Type::Named(name); }
            }
            return Type::Named(name);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(Lowerer_resolve_type(self, lw_box_type_unbox(inner))), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(Box::new(Lowerer_resolve_type(self, lw_box_type_unbox(inner))), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(Lowerer_resolve_type(self, lw_box_type_unbox(elem))), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(Lowerer_resolve_type(self, lw_box_type_unbox(elem))), size_param);
        }
        Type::Generic(name, args) => {
            var resolved_args: Vec<Type> = Vec::new();
            var gi: i64 = 0;
            while gi < args.len() {
                resolved_args.push(Lowerer_resolve_type(self, args.get(gi)));
                gi = gi + 1;
            }
            return Type::Generic(name, resolved_args);
        }
        other => { return other; }
    }
    return ty;
}

pub fn Lowerer_lower_type(self: &Lowerer, ty: Type) -> IrType {
    var resolved: Type = Lowerer_resolve_type(self, ty);
    return lower_type(resolved);
}

/// Like lower_type, but converts enum types (e.g. Result<T,E>, Option<T>)
/// from Generic("Result", ...) to Struct("Result") so that SRET calling
/// convention treats them as aggregate types.
/// Used only at function signature boundaries (return type + call sites).
pub fn Lowerer_lower_type_sret(self: &Lowerer, ty: Type) -> IrType {
    var ir_ty: IrType = Lowerer_lower_type(self, ty);
    match ir_ty {
        IrType::Generic(name, _args) => {
            var resolved_name: str = Lowerer_resolve_struct_name(self, name);
            match Lowerer_lookup_enum(self, resolved_name) {
                OptEnumDef::Some(_def) => { return IrType::Struct(resolved_name); }
                OptEnumDef::None => {}
            }
        }
        _ => {}
    }
    return ir_ty;
}

pub fn Lowerer_resolve_struct_name(self: &Lowerer, name: str) -> str {
    match Lowerer_lookup_type_alias(self, name) {
        OptType::Some(alias) => {
            match alias {
                Type::Named(inner) => { return Lowerer_resolve_struct_name(self, inner); }
                _ => { return name; }
            }
            return name;
        }
        OptType::None => { return name; }
    }
    return name;
}

pub fn Lowerer_is_opaque_type_param(self: &Lowerer, ty: Type) -> bool {
    match ty {
        Type::Named(n) => {
            match Lowerer_lookup_enum(self, n) {
                OptEnumDef::Some(_) => { return false; }
                OptEnumDef::None => {}
            }
            match IrModule_get_struct(&self.module, n) {
                OptStructLayout::Some(_) => { return false; }
                OptStructLayout::None => {}
            }
            match Lowerer_lookup_type_alias(self, n) {
                OptType::Some(_) => { return false; }
                OptType::None => {}
            }
            if n == "Vec" { return false; }
            if n == "HashMap" { return false; }
            if n == "Tensor" { return false; }
            if n == "Allocator" { return false; }
            return true;
        }
        _ => { return false; }
    }
    return false;
}

// Auto-deref helper: for &mut Vec<T> / &mut HashMap<K,V> / &mut String,
// the receiver is Ptr(Opaque("Vec")) - a pointer to the Vec pointer.
// Vec_len/Vec_get/Vec_push expect the Vec pointer directly, so we
// must Load the actual value from the reference before passing it.
// Returns the dereferenced value if needed, or the original value otherwise.
pub fn Lowerer_auto_deref_recv(self: &mut Lowerer, recv_val: i64, recv_ty: IrType) -> i64 {
    match recv_ty {
        IrType::Ptr(inner) => {
            var inner_ty: IrType = box_ir_type_unbox(inner);
            var is_collection: bool = false;
            match inner_ty {
                IrType::Opaque(oname) => {
                    if oname == "Vec" || oname == "HashMap" || oname == "String" {
                        is_collection = true;
                    }
                }
                IrType::Generic(gname, _) => {
                    if gname == "Vec" || gname == "HashMap" || gname == "String" {
                        is_collection = true;
                    }
                }
                _ => {}
            }
            if is_collection {
                return Lowerer_emit_inst(self, Inst::Load(recv_val, inner_ty));
            }
        }
        _ => {}
    }
    return recv_val;
}

pub fn word_repr(ty: IrType) -> IrType {
    match ty {
        IrType::Struct(_) => { return IrType::Ptr(Box::new(ty)); }
        IrType::Array(_, _) => { return IrType::Ptr(Box::new(ty)); }
        other => { return other; }
    }
    return ty;
}

pub fn ir_types_repr_compatible(a: IrType, b: IrType) -> bool {
    if ir_type_eq(a, b) { return true; }
    if ir_type_is_scalar(a) && ir_type_is_scalar(b) { return true; }
    if ir_type_is_ptr_like(a) && ir_type_is_ptr_like(b) { return true; }
    return false;
}

pub fn Lowerer_ast_type_from_name(self: &Lowerer, name: str) -> OptType {
    if name == "" { return OptType::None; }
    var ty: Type = Type::Named(name);
    if name == "i8" { ty = Type::I8; }
    if name == "i16" { ty = Type::I16; }
    if name == "i32" { ty = Type::I32; }
    if name == "i64" { ty = Type::I64; }
    if name == "i128" { ty = Type::I128; }
    if name == "u8" { ty = Type::U8; }
    if name == "u16" { ty = Type::U16; }
    if name == "u32" { ty = Type::U32; }
    if name == "u64" { ty = Type::U64; }
    if name == "u128" { ty = Type::U128; }
    if name == "f32" { ty = Type::F32; }
    if name == "f64" { ty = Type::F64; }
    if name == "bool" { ty = Type::Bool; }
    if name == "str" { ty = Type::Str; }

    if Lowerer_is_opaque_type_param(self, ty) { return OptType::None; }
    return OptType::Some(ty);
}

pub fn Lowerer_resolve_self_in_type(self: &Lowerer, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            if name == "Self" {
                var saved_self: OptStringLower = self.current_self_type;
                match saved_self {
                    OptStringLower::Some(self_name) => { return Type::Named(self_name); }
                    OptStringLower::None => { return Type::Named(name); }
                }
                return Type::Named(name);
            }
            return Type::Named(name);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(Lowerer_resolve_self_in_type(self, lw_box_type_unbox(inner))), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(Box::new(Lowerer_resolve_self_in_type(self, lw_box_type_unbox(inner))), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(Lowerer_resolve_self_in_type(self, lw_box_type_unbox(elem))), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(Lowerer_resolve_self_in_type(self, lw_box_type_unbox(elem))), size_param);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(Lowerer_resolve_self_in_type(self, args.get(i)));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(Lowerer_resolve_self_in_type(self, types.get(i)));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        other => { return other; }
    }
    return ty;
}

// --- Struct/Enum layout computation ---------------------------------------

pub fn Lowerer_compute_struct_layout(self: &mut Lowerer, def: StructDef) {
    var layout: StructLayout = Lowerer_make_struct_layout(self, def);
    // Workaround: extract module, modify, put back (nested borrow issue)
    var mod: IrModule = self.module;
    IrModule_add_struct(&mut mod, layout);
    self.module = mod;
}

// Build a StructLayout from a StructDef (without modifying the Lowerer)
pub fn Lowerer_make_struct_layout(self: &Lowerer, def: StructDef) -> StructLayout {
    var struct_name: str = def.name;
    var fields: Vec<StringIrTypeOffset> = Vec::new();
    var offset: i64 = 0;

    // Check for @repr(C) annotation
    var repr_c: bool = false;
    var packed_layout: bool = false;
    var ai: i64 = 0;
    while ai < def.annotations.len() {
        var ann: Annotation = def.annotations.get(ai);
        if ann.name == "repr" {
            var bi: i64 = 0;
            while bi < ann.args.len() {
                if ann.args.get(bi) == "C" {
                    repr_c = true;
                }
                bi = bi + 1;
            }
        }
        if ann.name == "packed" {
            packed_layout = true;
        }
        ai = ai + 1;
    }

    var max_align: i64 = 8;
    if repr_c {
        max_align = 1;
    }
    if packed_layout {
        max_align = 1;
    }

    var i: i64 = 0;
    while i < def.fields.len() {
        var field: Param = def.fields.get(i);
        var ir_ty: IrType = Lowerer_lower_type(self, field.ty);

        if repr_c || packed_layout {
            // C-compatible or packed layout: use natural type sizes and alignment
            var field_size: i64 = 8;
            var field_align: i64 = 8;
            match ir_ty {
                IrType::I8 => { field_size = 1; field_align = 1; }
                IrType::U8 => { field_size = 1; field_align = 1; }
                IrType::Bool => { field_size = 1; field_align = 1; }
                IrType::I16 => { field_size = 2; field_align = 2; }
                IrType::U16 => { field_size = 2; field_align = 2; }
                IrType::I32 => { field_size = 4; field_align = 4; }
                IrType::U32 => { field_size = 4; field_align = 4; }
                IrType::F32 => { field_size = 4; field_align = 4; }
                IrType::I64 => { field_size = 8; field_align = 8; }
                IrType::U64 => { field_size = 8; field_align = 8; }
                IrType::F64 => { field_size = 8; field_align = 8; }
                IrType::Ptr(_) => { field_size = 8; field_align = 8; }
                IrType::Struct(name) => {
                    match IrModule_get_struct(&self.module, name) {
                        OptStructLayout::Some(layout) => {
                            field_size = layout.size;
                            field_align = layout.align;
                        }
                        OptStructLayout::None => { field_size = 8; field_align = 8; }
                    }
                }
                _ => { field_size = 8; field_align = 8; }
            }
            if packed_layout {
                // Packed: no alignment padding between fields
                field_align = 1;
            }
            // Align offset to field's natural alignment
            offset = (offset + field_align - 1) & (0 - field_align);
            fields.push(StringIrTypeOffset_new(field.name, ir_ty, offset));
            offset = offset + field_size;
            if field_align > max_align {
                max_align = field_align;
            }
        } else {
            // Default Fides layout: uniform 8-byte slots
            var field_size: i64 = 8;
            match ir_ty {
                IrType::Struct(name) => {
                    match IrModule_get_struct(&self.module, name) {
                        OptStructLayout::Some(layout) => { field_size = layout.size; }
                        OptStructLayout::None => { field_size = 8; }
                    }
                }
                _ => { field_size = 8; }
            }
            fields.push(StringIrTypeOffset_new(field.name, ir_ty, offset));
            offset = offset + field_size;
        }
        i = i + 1;
    }

    // Align struct size to its alignment
    var size: i64 = (offset + max_align - 1) & (0 - max_align);

    var layout: StructLayout = StructLayout_new(struct_name);
    layout.size = size;
    if repr_c {
        layout.align = max_align;
    } else {
        layout.align = 8;
    }
    layout.fields = fields;
    layout.repr_c = repr_c;
    layout.packed_layout = packed_layout;
    return layout;
}

pub fn Lowerer_compute_enum_layout(self: &mut Lowerer, def: EnumDef) {
    var layout: StructLayout = Lowerer_make_enum_layout(self, def);
    var mod: IrModule = self.module;
    IrModule_add_struct(&mut mod, layout);
    self.module = mod;
}

pub fn Lowerer_make_enum_layout(self: &Lowerer, def: EnumDef) -> StructLayout {
    // Compute the max payload size across all variants.
    // Each field in a variant gets at least 8 bytes, but struct/enum-typed
    // fields need their full size (looked up from the module's struct layouts).
    var max_payload_size: i64 = 0;
    var i: i64 = 0;
    while i < def.variants.len() {
        var variant: EnumVariant = def.variants.get(i);
        match variant.data {
            OptParams::Some(data) => {
                var variant_size: i64 = 0;
                var fi: i64 = 0;
                while fi < data.len() {
                    var ir_ty: IrType = Lowerer_lower_type(self, data.get(fi).ty);
                    var field_size: i64 = 8;
                    match ir_ty {
                        IrType::Struct(sname) => {
                            match IrModule_get_struct(&self.module, sname) {
                                OptStructLayout::Some(layout) => { field_size = layout.size; }
                                OptStructLayout::None => { field_size = 8; }
                            }
                        }
                        _ => { field_size = 8; }
                    }
                    variant_size = variant_size + field_size;
                    fi = fi + 1;
                }
                if variant_size > max_payload_size { max_payload_size = variant_size; }
            }
            OptParams::None => {}
        }
        i = i + 1;
    }

    // Round up to a multiple of 8 and count how many 8-byte slots we need.
    var payload_slots: i64 = (max_payload_size + 7) / 8;

    var fields: Vec<StringIrTypeOffset> = Vec::new();
    fields.push(StringIrTypeOffset_new("__tag", IrType::I64, 0));
    var j: i64 = 0;
    while j < payload_slots {
        fields.push(StringIrTypeOffset_new("__data" + int_to_str(j), IrType::I64, (j + 1) * 8));
        j = j + 1;
    }

    var size: i64 = (1 + payload_slots) * 8;
    var layout: StructLayout = StructLayout_new(def.name);
    layout.size = size;
    layout.align = 8;
    layout.fields = fields;
    return layout;
}

// --- Register runtime functions -------------------------------------------

pub fn Lowerer_register_runtime(self: &mut Lowerer) {
    // Print/panic
    Lowerer_add_extern_1(self, "p_print_int", IrType::I64, IrType::Void);
    Lowerer_add_extern_1(self, "p_print_str", lw_ptr_u8(), IrType::Void);
    Lowerer_add_extern_1(self, "p_eprint_str", lw_ptr_u8(), IrType::Void);
    Lowerer_add_extern_1(self, "p_print_bool", IrType::Bool, IrType::Void);
    Lowerer_add_extern_1(self, "p_print_float", IrType::F64, IrType::Void);
    Lowerer_add_extern_0(self, "p_print_newline", IrType::Void);
    Lowerer_add_extern_1(self, "p_panic", lw_ptr_u8(), IrType::Void);

    // Alloc/free
    Lowerer_add_extern_1(self, "p_alloc", IrType::I64, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_malloc", IrType::I64, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_free", lw_ptr_u8(), IrType::Void);

    // String conversions
    Lowerer_add_extern_2(self, "p_str_concat", lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_str_join_n", lw_ptr_u8(), lw_ptr_u8());
    // Mutable string builder (avoids O(n^2) memory from string concat)
    Lowerer_add_extern_0(self, "p_sb_new", IrType::I64);
    Lowerer_add_extern_2(self, "p_sb_append", IrType::I64, lw_ptr_u8(), IrType::Void);
    Lowerer_add_extern_1(self, "p_sb_to_str", IrType::I64, lw_ptr_u8());  // (sb_ptr) -> str
    Lowerer_add_extern_1(self, "p_to_str", IrType::I64, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_char_to_str", IrType::I64, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_float_to_str", IrType::F64, lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_str_to_float", lw_ptr_u8(), IrType::F64);
    Lowerer_add_extern_1(self, "p_bool_to_str", IrType::Bool, lw_ptr_u8());
    // B5: Float bit-pattern conversion for ConstFloat codegen
    Lowerer_add_extern_1(self, "p_f64_to_bits", IrType::F64, IrType::I64);
    Lowerer_add_extern_1(self, "p_f32_to_bits", IrType::F32, IrType::I64);

    // String operations
    Lowerer_add_extern_2(self, "p_string_contains", lw_ptr_u8(), lw_ptr_u8(), IrType::Bool);
    Lowerer_add_extern_3(self, "p_string_replace", lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_2(self, "p_string_starts_with", lw_ptr_u8(), lw_ptr_u8(), IrType::Bool);
    Lowerer_add_extern_2(self, "p_string_ends_with", lw_ptr_u8(), lw_ptr_u8(), IrType::Bool);
    Lowerer_add_extern_2(self, "p_string_find", lw_ptr_u8(), lw_ptr_u8(), IrType::I64);
    Lowerer_add_extern_1(self, "p_string_len", lw_ptr_u8(), IrType::I64);
    Lowerer_add_extern_2(self, "p_string_copy", lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_2(self, "p_str_copy", lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_str_free", lw_ptr_u8(), IrType::Void);
    Lowerer_add_extern_2(self, "p_string_split", lw_ptr_u8(), lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_string_trim", lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_string_to_uppercase", lw_ptr_u8(), lw_ptr_u8());
    Lowerer_add_extern_1(self, "p_string_to_lowercase", lw_ptr_u8(), lw_ptr_u8());

    // JSON
