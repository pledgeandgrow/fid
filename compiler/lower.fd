                    if self.own_on {
                        dty = lw_rc_handle_of_ir(pointee_ty);
                    }
                    // `*p = s` through a `&mut S` of a struct holding owned
                    // values: the place takes an owner of the new value and
                    // drops its old one, as a field assignment does
                    // (stdlib-agent-bugs 34: the struct was copied word for
                    // word, so the caller's variable and `s` shared their
                    // strings and Vecs and both freed them)
                    var dmem: Type = Type::Infer;
                    if self.own_on {
                        match pointee_ty {
                            IrType::Struct(_) => {
                                dmem = lw_rc_strip_ref(Lowerer_rc_expr_type(self, ptr_expr));
                                if Lowerer_rc_kind(self, dmem) != RC_MEM {
                                    dmem = Type::Infer;
                                }
