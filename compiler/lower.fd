                        // comptime pass (aggressive_comptime_expr, `*expr =
                        // ...` on bodies whose copies do not all hold owners
                        // of their parts). Taking an owner of the new value
                        // alone fixes the double free of bug 34.
                        var _ms: i64 = Lowerer_emit_inst(self, Inst::Store(ptr_val, mval, OptIrType::Some(pointee_ty)));
