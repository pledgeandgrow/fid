    Lowerer_add_extern_1(self, "p_vec_first", IrType::I64, IrType::I64);
    Lowerer_add_extern_1(self, "p_vec_last", IrType::I64, IrType::I64);
    Lowerer_add_extern_2(self, "p_vec_extend", IrType::I64, IrType::I64, IrType::Void);
    Lowerer_add_extern_2(self, "p_vec_truncate", IrType::I64, IrType::I64, IrType::Void);
