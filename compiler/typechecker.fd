            // OPTIMIZATION: use cached lookup instead of O(n) linear scan
            match TypeChecker_lookup_func_cache(self, callee) {
                OptFuncSig::Some(sig) => {
                    TypeChecker_check_visibility(self, callee);
                    if has_named {
                        // CL4: named arguments are matched to parameters by
                        // name, which also decides the count
                        TypeChecker_check_named_args(self, callee, sig, args, named_tys);
