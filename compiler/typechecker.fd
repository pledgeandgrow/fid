}

// FuncSig stored in funcs map — we need a different wrapper
pub struct StringFuncSig {
    pub key: str,
    pub val: FuncSig,
}

pub fn StringFuncSig_new(key: str, val: FuncSig) -> StringFuncSig {
    return StringFuncSig { key: key, val: val };
}

// ─── TypeChecker implementation ──────────────────────────────────────────

impl TypeChecker {

    pub fn new() -> TypeChecker {
        var tc: TypeChecker = TypeChecker {
            scopes: Vec::new(),
            funcs: Vec::new(),
            structs: Vec::new(),
            enums: Vec::new(),
            enum_variants: Vec::new(),
            enum_type_params: Vec::new(),
            consts: Vec::new(),
            type_aliases: Vec::new(),
            methods: Vec::new(),
            current_type_params: Vec::new(),
            current_type_param_bounds: Vec::new(),
            traits: Vec::new(),
            trait_assoc_types: Vec::new(),
            trait_impl_assoc_bindings: Vec::new(),
            item_modules: Vec::new(),
            item_visibility: Vec::new(),
            field_visibility: Vec::new(),
            struct_modules: Vec::new(),
            current_module: "",
            errors: Vec::new(),
            warnings: Vec::new(),
            granted_caps: Vec::new(),
            strict_caps: false,
            func_effects: Vec::new(),
            region_stack: Vec::new(),
            var_regions: Vec::new(),
            freed_regions: Vec::new(),
            cap_verified: Vec::new(),
            current_func_name: OptString::None,
            current_return_types: Vec::new(),
            current_self_type: OptString::None,
            sandbox_depth: 0,
            gpu_region_depth: 0,
            region_budgets: Vec::new(),
            region_lines: Vec::new(),
            var_alloc_lines: Vec::new(),
            linear_structs: Vec::new(),
            send_structs: Vec::new(),
            sync_structs: Vec::new(),
            consumed_vars: Vec::new(),
            scope_linear_vars: Vec::new(),
            loop_depth: 0,
            unsafe_depth: 0,
            uninit_vars: Vec::new(),
            current_line: 0,
            val_vars_per_scope: Vec::new(),
        };
        // Push initial scope
        tc.scopes.push(Vec::new());
        tc.scope_linear_vars.push(Vec::new());
        tc.val_vars_per_scope.push(Vec::new());
        return tc;
    }

    pub fn check(self: &mut TypeChecker, program: Program) -> bool {
        var module: str = "main";
        match program.module {
            OptString::Some(m) => { module = m; }
            OptString::None => { module = "main"; }
        }
        TypeChecker_register_program(self, program, module);
        TypeChecker_check_bodies(self, program);
        // Run lints (only generate warnings, never errors)
        TypeChecker_lint_unused_functions(self, program);
        TypeChecker_lint_unused_imports(self, program);
        return self.errors.len() == 0;
    }

    pub fn run_lints(self: &mut TypeChecker, program: Program) {
        TypeChecker_lint_unused_functions(self, program);
        TypeChecker_lint_unused_imports(self, program);
    }

    // ──── CHUNK_MARKER ────
}

// ─── Registration functions (free functions taking &mut TypeChecker) ─────

pub fn TypeChecker_register_program(self: &mut TypeChecker, program: Program, module: str) {
    self.current_module = module;

    // Register structs
    var si: i64 = 0;
    while si < program.structs.len() {
        var s: StructDef = program.structs.get(si);
        var fields: Vec<StructField> = Vec::new();
        var fi: i64 = 0;
        while fi < s.fields.len() {
            var f: Param = s.fields.get(fi);
            fields.push(StructField_new(f.name, f.ty));
            fi = fi + 1;
        }
        self.structs.push(StringStructFields_new(s.name, fields));
        map_str_str_set(&mut self.item_modules, s.name, module);
        map_str_bool_set(&mut self.item_visibility, s.name, s.is_pub);
        map_str_str_set(&mut self.struct_modules, s.name, module);
        // Field-level visibility
        var fi2: i64 = 0;
        while fi2 < s.fields.len() {
            var f2: Param = s.fields.get(fi2);
            self.field_visibility.push(FieldVisEntry_new(FieldVisKey_new(s.name, f2.name), f2.is_pub));
            fi2 = fi2 + 1;
        }
        // Check for @linear, @send, @sync annotations
        var ai: i64 = 0;
        while ai < s.annotations.len() {
            var ann: Annotation = s.annotations.get(ai);
            if ann.name == "linear" { self.linear_structs.push(s.name); }
            if ann.name == "send" { self.send_structs.push(s.name); }
            if ann.name == "sync" { self.sync_structs.push(s.name); }
            ai = ai + 1;
        }
        si = si + 1;
    }

    // Register enums
    var ei: i64 = 0;
    while ei < program.enums.len() {
        var e: EnumDef = program.enums.get(ei);
        self.enums.push(e.name);
        map_str_str_set(&mut self.item_modules, e.name, module);
        map_str_bool_set(&mut self.item_visibility, e.name, e.is_pub);
        var variants: Vec<EnumVariantEntry> = Vec::new();
        var vi: i64 = 0;
        while vi < e.variants.len() {
            var v: EnumVariant = e.variants.get(vi);
            var tys: Vec<Type> = Vec::new();
            match v.data {
                OptParams::Some(params) => {
                    var pi: i64 = 0;
                    while pi < params.len() {
                        tys.push(params.get(pi).ty);
                        pi = pi + 1;
                    }
                }
                OptParams::None => {}
            }
            variants.push(EnumVariantEntry_new(v.name, tys));
            vi = vi + 1;
        }
        self.enum_variants.push(StringEnumVariants_new(e.name, variants));
        self.enum_type_params.push(StringVecString_new(e.name, e.type_params));
        ei = ei + 1;
    }

    // Register consts
    var ci: i64 = 0;
    while ci < program.consts.len() {
        var c: ConstDef = program.consts.get(ci);
        map_str_type_set(&mut self.consts, c.name, c.ty);
        map_str_str_set(&mut self.item_modules, c.name, module);
        map_str_bool_set(&mut self.item_visibility, c.name, c.is_pub);
        ci = ci + 1;
    }

    // Register type aliases
    var tai: i64 = 0;
    while tai < program.type_aliases.len() {
        var ta: TypeAlias = program.type_aliases.get(tai);
        map_str_type_set(&mut self.type_aliases, ta.name, ta.alias_for);
        map_str_str_set(&mut self.item_modules, ta.name, module);
        map_str_bool_set(&mut self.item_visibility, ta.name, ta.is_pub);
        tai = tai + 1;
    }

    // Register functions
    var fi3: i64 = 0;
    while fi3 < program.funcs.len() {
        var func: Func = program.funcs.get(fi3);
        var param_types: Vec<Type> = Vec::new();
        var pi: i64 = 0;
        while pi < func.params.len() {
            param_types.push(TypeChecker_resolve_type(self, func.params.get(pi).ty));
            pi = pi + 1;
        }
        var ret_ty: Type = TypeChecker_resolve_type(self, func.ret_ty);
        self.funcs.push(StringFuncSig_new(func.name, FuncSig_new(param_types, ret_ty)));
        map_str_str_set(&mut self.item_modules, func.name, module);
        map_str_bool_set(&mut self.item_visibility, func.name, func.is_pub);
        fi3 = fi3 + 1;
    }

    // Register extern function declarations
    var exti: i64 = 0;
    while exti < program.extern_decls.len() {
        var ext: ExternDecl = program.extern_decls.get(exti);
        var param_types: Vec<Type> = Vec::new();
        var pi: i64 = 0;
        while pi < ext.params.len() {
            param_types.push(TypeChecker_resolve_type(self, ext.params.get(pi).ty));
            pi = pi + 1;
        }
        var ret_ty: Type = TypeChecker_resolve_type(self, ext.ret_ty);
        self.funcs.push(StringFuncSig_new(ext.pledge_name, FuncSig_new(param_types, ret_ty)));
        map_str_str_set(&mut self.item_modules, ext.pledge_name, module);
        map_str_bool_set(&mut self.item_visibility, ext.pledge_name, true);
        exti = exti + 1;
    }

    // Register impl methods
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var struct_name: str = imp.struct_name;
        var method_entries: Vec<MethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            var has_self: bool = false;
            if method.params.len() > 0 {
                if method.params.get(0).name == "self" { has_self = true; }
            }
            method_entries.push(MethodMapEntry_new(method.name, MethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), has_self, method.is_pub)));
            map_str_str_set(&mut self.item_modules, method.name, self.current_module);
            var mangled: str = struct_name + "_" + method.name;
            map_str_str_set(&mut self.item_modules, mangled, module);
            mi = mi + 1;
        }
        // Don't overwrite if struct already has methods from another module
        var existing: OptMethodMap = map_methods_get(self.methods, struct_name);
        match existing {
            OptMethodMap::Some(_) => {
                // Merge — add new methods to existing map
                // (simplified: just push the new map if not present)
            }
            OptMethodMap::None => {
                self.methods.push(StringMethodMap_new(struct_name, method_entries));
            }
        }
        impi = impi + 1;
    }

    // Register trait impl methods
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        var type_name: str = ti.type_name;
        var new_methods: Vec<MethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < ti.methods.len() {
            var method: Func = ti.methods.get(mi);
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            var has_self: bool = false;
            if method.params.len() > 0 {
                if method.params.get(0).name == "self" { has_self = true; }
            }
            new_methods.push(MethodMapEntry_new(method.name, MethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), has_self, method.is_pub)));
            map_str_str_set(&mut self.item_modules, method.name, self.current_module);
            mi = mi + 1;
        }
        // Merge into existing method map or create new
        var found: bool = false;
        var mi2: i64 = 0;
        while mi2 < self.methods.len() {
            if self.methods.get(mi2).key == type_name {
                var existing_val: Vec<MethodMapEntry> = self.methods.get(mi2).val;
                var ni: i64 = 0;
                while ni < new_methods.len() {
                    method_map_set_entry(&mut existing_val, new_methods.get(ni).key, new_methods.get(ni).val);
                    ni = ni + 1;
                }
                var m_entry: StringMethodMap = self.methods.get(mi2);
                m_entry.val = existing_val;
                self.methods.set(mi2, m_entry);
                found = true;
                break;
            }
            mi2 = mi2 + 1;
        }
        if !found {
            self.methods.push(StringMethodMap_new(type_name, new_methods));
        }
        tii = tii + 1;
    }

    // Register trait definitions
    var tdi: i64 = 0;
    while tdi < program.traits.len() {
        var trait_def: TraitDef = program.traits.get(tdi);
        var method_entries: Vec<TraitMethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < trait_def.methods.len() {
            var method: TraitMethod = trait_def.methods.get(mi);
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            method_entries.push(TraitMethodMapEntry_new(method.name, TraitMethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), method.has_self)));
            mi = mi + 1;
        }
        self.traits.push(StringTraitMethodMap_new(trait_def.name, method_entries));
        // Register associated type declarations
        var assoc_names: Vec<str> = Vec::new();
        var ai: i64 = 0;
        while ai < trait_def.associated_types.len() {
            assoc_names.push(trait_def.associated_types.get(ai).name);
            ai = ai + 1;
        }
        self.trait_assoc_types.push(StringVecString_new(trait_def.name, assoc_names));
        tdi = tdi + 1;
    }
}

pub fn TypeChecker_register_trait_impls(self: &mut TypeChecker, program: Program) {
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        var type_name: str = ti.type_name;
        var new_methods: Vec<MethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < ti.methods.len() {
            var method: Func = ti.methods.get(mi);
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            var has_self: bool = false;
            if method.params.len() > 0 {
                if method.params.get(0).name == "self" { has_self = true; }
            }
            new_methods.push(MethodMapEntry_new(method.name, MethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), has_self, method.is_pub)));
            mi = mi + 1;
        }
        // Merge into existing method map or create new
        var found: bool = false;
        var mi2: i64 = 0;
        while mi2 < self.methods.len() {
            if self.methods.get(mi2).key == type_name {
                var existing_val: Vec<MethodMapEntry> = self.methods.get(mi2).val;
                var ni: i64 = 0;
                while ni < new_methods.len() {
                    method_map_set_entry(&mut existing_val, new_methods.get(ni).key, new_methods.get(ni).val);
                    ni = ni + 1;
                }
                var m_entry: StringMethodMap = self.methods.get(mi2);
                m_entry.val = existing_val;
                self.methods.set(mi2, m_entry);
                found = true;
                break;
            }
            mi2 = mi2 + 1;
        }
        if !found {
            self.methods.push(StringMethodMap_new(type_name, new_methods));
        }
        // Register associated type bindings
        if ti.associated_types.len() > 0 {
            var bindings: Vec<StringType> = Vec::new();
            var ai: i64 = 0;
            while ai < ti.associated_types.len() {
                var b: AssocTypeBinding = ti.associated_types.get(ai);
                bindings.push(StringType_new(b.name, b.ty));
                ai = ai + 1;
            }
            self.trait_impl_assoc_bindings.push(TraitImplAssocEntry_new(TraitImplKey_new(ti.trait_name, ti.type_name), bindings));
        }
        tii = tii + 1;
    }
}

pub fn TypeChecker_verify_trait_impls(self: &mut TypeChecker, program: Program) {
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        // Find trait definition
        var trait_def: OptTraitDef = OptTraitDef::None;
        var tdi: i64 = 0;
        while tdi < program.traits.len() {
            if program.traits.get(tdi).name == ti.trait_name {
                trait_def = OptTraitDef::Some(program.traits.get(tdi));
                break;
            }
            tdi = tdi + 1;
        }
        match trait_def {
            OptTraitDef::Some(td) => {
                // Check all required methods are implemented
                var implemented: Vec<str> = Vec::new();
                var mi: i64 = 0;
                while mi < ti.methods.len() {
                    implemented.push(ti.methods.get(mi).name);
                    mi = mi + 1;
                }
                var tmi: i64 = 0;
                while tmi < td.methods.len() {
                    var tm: TraitMethod = td.methods.get(tmi);
                    if !str_vec_contains(implemented, tm.name) {
                        var has_default: bool = false;
                        match tm.default_body {
                            OptStmts::Some(_) => { has_default = true; }
                            OptStmts::None => { has_default = false; }
                        }
                        if !has_default {
                            self.errors.push("Type error: impl " + ti.trait_name + " for " + ti.type_name + " is missing method '" + tm.name + "'");
                        }
                    }
                    tmi = tmi + 1;
                }
                // Check associated types
                var provided_assoc: Vec<str> = Vec::new();
                var ai: i64 = 0;
                while ai < ti.associated_types.len() {
                    provided_assoc.push(ti.associated_types.get(ai).name);
                    ai = ai + 1;
                }
                var ai2: i64 = 0;
                while ai2 < td.associated_types.len() {
                    var assoc_name: str = td.associated_types.get(ai2).name;
                    if !str_vec_contains(provided_assoc, assoc_name) {
                        self.errors.push("Type error: impl " + ti.trait_name + " for " + ti.type_name + " is missing associated type '" + assoc_name + "'");
                    }
                    ai2 = ai2 + 1;
                }
            }
            OptTraitDef::None => {
                self.errors.push("Type error: trait '" + ti.trait_name + "' is not defined (in impl for " + ti.type_name + ")");
            }
        }
        tii = tii + 1;
    }
}

pub enum OptTraitDef {
    Some(TraitDef),
    None,
}

// ─── check_bodies and verification passes ────────────────────────────────

pub fn TypeChecker_check_bodies(self: &mut TypeChecker, program: Program) {
    // Pre-pass: compute direct effects of each function
    TypeChecker_compute_func_effects(self, program);
    // Verify declared effects match inferred effects
    TypeChecker_verify_declared_effects(self, program);
    // Verify safety annotations (simplified — just check @deterministic)
    TypeChecker_verify_deterministic(self, program);
    // Additional verification passes (stubs — permissive, don't reject)
    // These are not needed for self-hosting since the compiler's own code
    // doesn't use these annotations.
    TypeChecker_verify_conserve(self, program);
    TypeChecker_verify_gas(self, program);
    TypeChecker_verify_safety_annotations(self, program);
    TypeChecker_verify_constant_time(self, program);
    TypeChecker_verify_realtime(self, program);
    TypeChecker_verify_differentiable(self, program);
    TypeChecker_verify_quantized(self, program);
    TypeChecker_verify_checkpoint(self, program);
    TypeChecker_verify_dp(self, program);
    TypeChecker_verify_shard(self, program);
    TypeChecker_verify_adapter(self, program);
    TypeChecker_verify_tainted(self, program);
    TypeChecker_verify_contracts(self, program);
    TypeChecker_verify_allocator_params(self, program);
    // Mark all functions as capability-verified before checking
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        self.cap_verified.push(program.funcs.get(fi).name);
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            self.cap_verified.push(imp.methods.get(mi).name);
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    // Check function bodies
    var fi2: i64 = 0;
    while fi2 < program.funcs.len() {
        TypeChecker_check_func(self, program.funcs.get(fi2));
        fi2 = fi2 + 1;
    }
    // Check impl method bodies
    var impi2: i64 = 0;
    while impi2 < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi2);
        var saved_tp: Vec<str> = self.current_type_params;
        var saved_self: OptString = self.current_self_type;
        if imp.type_params.len() > 0 {
            self.current_type_params = imp.type_params;
        }
        self.current_self_type = OptString::Some(imp.struct_name);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            TypeChecker_check_func(self, imp.methods.get(mi));
            mi = mi + 1;
        }
        self.current_type_params = saved_tp;
        self.current_self_type = saved_self;
        impi2 = impi2 + 1;
    }
    // Check trait impl method bodies
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        var saved_tp: Vec<str> = self.current_type_params;
        var saved_self: OptString = self.current_self_type;
        if ti.type_params.len() > 0 {
            self.current_type_params = ti.type_params;
        }
        self.current_self_type = OptString::Some(ti.type_name);
        var mi: i64 = 0;
        while mi < ti.methods.len() {
            TypeChecker_check_func(self, ti.methods.get(mi));
            mi = mi + 1;
        }
        self.current_type_params = saved_tp;
        self.current_self_type = saved_self;
        tii = tii + 1;
    }
}

pub fn TypeChecker_compute_func_effects(self: &mut TypeChecker, program: Program) {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var effects: Vec<str> = Vec::new();
        TypeChecker_scan_stmts_for_effects(self, func.body, &mut effects);
        self.func_effects.push(StringVecStrTc_new(func.name, effects));
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            var effects: Vec<str> = Vec::new();
            TypeChecker_scan_stmts_for_effects(self, method.body, &mut effects);
            self.func_effects.push(StringVecStrTc_new(method.name, effects));
            mi = mi + 1;
        }
        impi = impi + 1;
    }
}

pub fn TypeChecker_verify_declared_effects(self: &mut TypeChecker, program: Program) {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if !func.has_effect_annotation { fi = fi + 1; continue; }
        // Get inferred effects
        var inferred: Vec<str> = Vec::new();
        var fei: i64 = 0;
        while fei < self.func_effects.len() {
            if self.func_effects.get(fei).key == func.name {
                inferred = self.func_effects.get(fei).val;
                break;
            }
            fei = fei + 1;
        }
        if inferred.len() == 0 { fi = fi + 1; continue; }
        // Check that all inferred effects are declared
        var ii: i64 = 0;
        while ii < inferred.len() {
            var eff: str = inferred.get(ii);
            if !str_vec_contains(func.declared_effects, eff) {
                self.errors.push("Effect error: function '" + func.name + "' has inferred effect '!" + eff + "' but only declared effects not including it");
            }
            ii = ii + 1;
        }
        fi = fi + 1;
    }
}

pub fn TypeChecker_verify_deterministic(self: &mut TypeChecker, program: Program) {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_det: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "deterministic" { is_det = true; }
            ai = ai + 1;
        }
        if is_det {
            // Check for forbidden effects: IO, Net, Spawn, Diverge
            var inferred: Vec<str> = Vec::new();
            var fei: i64 = 0;
            while fei < self.func_effects.len() {
                if self.func_effects.get(fei).key == func.name {
                    inferred = self.func_effects.get(fei).val;
                    break;
                }
                fei = fei + 1;
            }
            var ei: i64 = 0;
            while ei < inferred.len() {
                var eff: str = inferred.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Deterministic error: function '" + func.name + "' is @deterministic but has !" + eff + " effect");
                }
                ei = ei + 1;
            }
            // Check for floating-point operations
            var floats: Vec<str> = scan_for_floats(func.body);
            if floats.len() > 0 {
                self.errors.push("Deterministic error: function '" + func.name + "' is @deterministic but contains floating-point operations");
            }
        }
        fi = fi + 1;
    }
}

