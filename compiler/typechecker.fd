// --- Type aliases for nested Vec types (Fides can't parse Vec<Vec<...>>) -

pub type ScopeStack = Vec<ScopeEntry>;
pub type LinearVarStack = Vec<LinearVar>;
pub type StrStack = Vec<str>;
pub type StmtList = Vec<Stmt>;
pub type AnnList = Vec<Annotation>;

// --- TypeChecker struct --------------------------------------------------

pub struct TypeChecker {
    // Symbol tables
    scopes: Vec<ScopeStack>,                         // var_name -> Type (per scope)
    funcs: Vec<StringFuncSig>,                       // func_name -> (params, box_type_unbox(ret)) -- stored as FuncSig in a wrapper
    structs: Vec<StringStructFields>,                // struct_name -> fields
    enums: Vec<str>,                                 // enum names
    enum_variants: Vec<StringEnumVariants>,          // enum_name -> variants
    enum_type_params: Vec<StringVecString>,          // enum_name -> type params
    enum_tp_set: i64,  // every name in enum_type_params (HashMap set, D10)
    consts: Vec<StringType>,                         // const_name -> Type
    globals: Vec<StringType>,                         // global_name -> Type (module-level mutable globals)
    type_aliases: Vec<StringType>,                   // alias_name -> Type
    methods: Vec<StringMethodMap>,                   // struct_name -> method map
    current_type_params: Vec<str>,                   // current function's type params
    current_type_param_bounds: Vec<StringString>,    // type_param -> trait_name
    // Bodies not to check: "fn:name", "impl:Type:method", "trait:Type:method"
    // (core, when an earlier build checked the same core clean; release D9).
    // 0 = check everything.
    pub skip_bodies: i64,
    /// `@scoped` structs: their str fields read as borrowed `&str` (M11)
    pub scoped_structs: Vec<str>,
    // struct name -> index in methods + 1, filled lazily (release D10: a
    // method call scanned every struct's method table by name)
    methods_index: i64,
    methods_indexed: i64,
    // Struct and enum name -> 1 + position, filled as entries are added
    // (TypeChecker_struct_pos, TypeChecker_enum_pos): a lookup by name
    // used to scan every struct and enum (D10)
    sname_index: i64,
    sname_indexed: i64,
    ename_index: i64,
    ename_indexed: i64,
    // Generic functions (proposal 0002): name, type parameters, bounds
    func_generic_names: Vec<str>,
    func_generic_tps: Vec<Vec<str>>,
    func_generic_bounds: Vec<Vec<StrPair>>,
    // "Trait:Type" for every `impl Trait for Type`
    impl_pairs: Vec<str>,
    // Type parameters of each generic impl: `impl<T> Slot` -> Slot, [T]
    impl_tp_names: Vec<str>,
    impl_tp_lists: Vec<Vec<str>>,
    // The current function's by-value parameters holding a Vec, HashMap or
    // struct, with their types: they are read-only (proposal 0001)
    value_param_names: Vec<str>,
    value_param_types: Vec<Type>,
    traits: Vec<StringTraitMethodMap>,               // trait_name -> methods
    trait_assoc_types: Vec<StringVecString>,         // trait_name -> assoc type names
    trait_impl_assoc_bindings: Vec<TraitImplAssocEntry>, // (trait,type) -> bindings
    item_modules: Vec<StringString>,                 // item_name -> module_name
    item_visibility: Vec<StringBool>,                // item_name -> is_pub
    field_visibility: Vec<FieldVisEntry>,            // (struct,field) -> is_pub
    struct_modules: Vec<StringString>,               // struct_name -> module_name

    // State
    pub current_module: str,
    pub errors: Vec<str>,
    pub warnings: Vec<str>,
    granted_caps: Vec<str>,
    strict_caps: bool,
    func_effects: Vec<StringVecStrTc>,                 // func_name -> effect names
    ho_param_effects: Vec<StringVecStrTc>,              // param_name -> conservative effects (effect polymorphism)
    region_stack: Vec<str>,
    var_regions: Vec<StringString>,                  // var_name -> region_name
    freed_regions: Vec<str>,
    cap_verified: Vec<str>,
    current_func_name: OptString,
    // CE6: "fn:name" for each undefined name already reported, so that later
    // uses of it in the same function add no error
    reported_undefined: Vec<str>,
    // HashMaps: name -> slot + 1 in the table of the same name
    func_effects_index: i64,
    // Functions that allocate on the heap, themselves or through what they
    // call (name, and Type.method / Type_method for methods) -> 1. Computed
    // only for programs with a `region .. with budget(N)`.
    heap_alloc_index: i64,
    ho_param_effects_index: i64,
    /// Effect polymorphism: the function-typed parameters of the function
    /// whose body is being scanned (calls through them add no effect there),
    /// and per higher-order function its function-typed parameters' indexes.
    cur_ho_params: Vec<str>,
    ho_fn_index: i64,
    ho_fn_idx: Vec<Vec<i64>>,
    ho_fn_pnames: Vec<Vec<str>>,
    item_modules_index: i64,
    item_visibility_index: i64,
    struct_modules_index: i64,
    // Method calls resolved to a user impl while bodies are checked:
    // calling function, type, method. See verify_method_calls.
    method_call_callers: Vec<str>,
    method_call_owners: Vec<str>,
    method_call_names: Vec<str>,
    current_return_types: Vec<Type>,
    current_ret_ty: OptType,                         // declared return type of the body being checked
    extern_fns: Vec<str>,                            // extern "C" function names (FFI boundary)
    current_self_type: OptString,
    sandbox_depth: i64,
    gpu_region_depth: i64,
    region_budgets: Vec<RegionBudget>,
    region_lines: Vec<StringString>,
    var_alloc_lines: Vec<StringString>,
    linear_structs: Vec<str>,
    send_structs: Vec<str>,
    sync_structs: Vec<str>,
    consumed_vars: Vec<str>,
    scope_linear_vars: Vec<LinearVarStack>,
    loop_depth: i64,
    unsafe_depth: i64,
    // The function being checked, the functions started on another thread,
    // and each write to a global in the program (three parallel lists)
    checking_fn: str,
    thread_entries: Vec<str>,
    write_funcs: Vec<str>,
    write_globals: Vec<str>,
    write_lines: Vec<i64>,
    uninit_vars: Vec<str>,
    current_line: i64,
    val_vars_per_scope: Vec<StrStack>,
    check_depth: i64,

    // Memoization caches — HashMap-based index caches for O(1) lookups.
    // These are populated during register_program and used during check_bodies.
    // They convert O(n) linear scans of the Vec<StringXxx> tables into O(1)
    // hash lookups. With 100K+ LOC of compiler code, there are thousands of
    // functions/structs/enums, making each linear scan expensive.
    func_cache: i64,       // HashMap: func_name → index in funcs Vec (-1 = not found)
    struct_cache: i64,     // HashMap: struct_name → index in structs Vec (-1 = not found)
    enum_cache: i64,       // HashMap: enum_name → index in enums Vec (-1 = not found)
    const_cache: i64,      // HashMap: const_name → index in consts Vec (-1 = not found)
    global_cache: i64,     // HashMap: global_name → index in globals Vec (-1 = not found)
    alias_cache: i64,      // HashMap: alias_name → index in type_aliases Vec (-1 = not found)
    caches_built: bool,    // whether index caches have been populated
    // "Struct.field" -> 1 + index into private_field_modules, for fields
    // not marked pub (field privacy, src/typechecker.rs).
    private_fields: i64,
    private_field_modules: Vec<str>,
}

// Additional helper structs for TypeChecker fields

pub struct StringStructFields {
    pub key: str,
    pub val: Vec<StructField>,
}

pub fn StringStructFields_new(key: str, val: Vec<StructField>) -> StringStructFields {
    return StringStructFields { key: key, val: val };
}

pub struct StringEnumVariants {
    pub key: str,
    pub val: Vec<EnumVariantEntry>,
}

pub fn StringEnumVariants_new(key: str, val: Vec<EnumVariantEntry>) -> StringEnumVariants {
    return StringEnumVariants { key: key, val: val };
}

pub struct StringVecStrTc {
    pub key: str,
    pub val: Vec<str>,
}

pub fn StringVecStrTc_new(key: str, val: Vec<str>) -> StringVecStrTc {
    return StringVecStrTc { key: key, val: val };
}

pub struct StringI64 {
    pub key: str,
    pub val: i64,
}

pub fn StringI64_new(key: str, val: i64) -> StringI64 {
    return StringI64 { key: key, val: val };
}

pub struct TraitImplAssocEntry {
    pub key: TraitImplKey,
    pub val: Vec<StringType>,
}

pub fn TraitImplAssocEntry_new(key: TraitImplKey, val: Vec<StringType>) -> TraitImplAssocEntry {
    return TraitImplAssocEntry { key: key, val: val };
}

// FuncSig stored in funcs map -- we need a different wrapper
pub struct StringFuncSig {
    pub key: str,
    pub val: FuncSig,
}

pub fn StringFuncSig_new(key: str, val: FuncSig) -> StringFuncSig {
    return StringFuncSig { key: key, val: val };
}

// --- TypeChecker implementation ------------------------------------------

/// Free the typechecker's index maps (raw handles, which ownership does
/// not drop) once checking is over; nothing reads them after.
pub fn TypeChecker_free_maps(self: &mut TypeChecker) {
    HashMap_drop(self.enum_tp_set); self.enum_tp_set = HashMap_new();
    HashMap_drop(self.methods_index); self.methods_index = HashMap_new();
    HashMap_drop(self.sname_index); self.sname_index = HashMap_new();
    HashMap_drop(self.ename_index); self.ename_index = HashMap_new();
    HashMap_drop(self.func_effects_index); self.func_effects_index = HashMap_new();
    HashMap_drop(self.heap_alloc_index); self.heap_alloc_index = HashMap_new();
    HashMap_drop(self.ho_param_effects_index); self.ho_param_effects_index = HashMap_new();
    HashMap_drop(self.ho_fn_index); self.ho_fn_index = HashMap_new();
    HashMap_drop(self.item_modules_index); self.item_modules_index = HashMap_new();
    HashMap_drop(self.item_visibility_index); self.item_visibility_index = HashMap_new();
    HashMap_drop(self.struct_modules_index); self.struct_modules_index = HashMap_new();
    HashMap_drop(self.func_cache); self.func_cache = HashMap_new();
    HashMap_drop(self.private_fields); self.private_fields = HashMap_new();
    HashMap_drop(self.struct_cache); self.struct_cache = HashMap_new();
    HashMap_drop(self.enum_cache); self.enum_cache = HashMap_new();
    HashMap_drop(self.const_cache); self.const_cache = HashMap_new();
    HashMap_drop(self.global_cache); self.global_cache = HashMap_new();
    HashMap_drop(self.alias_cache); self.alias_cache = HashMap_new();
    self.ename_indexed = 0;
}

impl TypeChecker {

    pub fn new() -> TypeChecker {
        var tc: TypeChecker = TypeChecker {
            scopes: Vec::new(),
            funcs: Vec::new(),
            structs: Vec::new(),
            enums: Vec::new(),
            enum_variants: Vec::new(),
            enum_type_params: Vec::new(),
            enum_tp_set: HashMap_new(),
            consts: Vec::new(),
            globals: Vec::new(),
            type_aliases: Vec::new(),
            methods: Vec::new(),
            current_type_params: Vec::new(),
            current_type_param_bounds: Vec::new(),
            skip_bodies: 0,
            scoped_structs: Vec::new(),
            methods_index: HashMap_new(),
            methods_indexed: 0,
            sname_index: HashMap_new(),
            sname_indexed: 0,
            ename_index: HashMap_new(),
            ename_indexed: 0,
            func_generic_names: Vec::new(),
            func_generic_tps: Vec::new(),
            func_generic_bounds: Vec::new(),
            impl_pairs: Vec::new(),
            impl_tp_names: Vec::new(),
            impl_tp_lists: Vec::new(),
            value_param_names: Vec::new(),
            value_param_types: Vec::new(),
            traits: Vec::new(),
            trait_assoc_types: Vec::new(),
            trait_impl_assoc_bindings: Vec::new(),
            item_modules: Vec::new(),
            item_visibility: Vec::new(),
            field_visibility: Vec::new(),
            struct_modules: Vec::new(),
            current_module: "",
            errors: Vec::new(),
            warnings: Vec::new(),
            granted_caps: Vec::new(),
            strict_caps: false,
            func_effects: Vec::new(),
            ho_param_effects: Vec::new(),
            region_stack: Vec::new(),
            var_regions: Vec::new(),
            freed_regions: Vec::new(),
            cap_verified: Vec::new(),
            current_func_name: OptString::None,
            reported_undefined: Vec::new(),
            func_effects_index: HashMap_new(),
            heap_alloc_index: HashMap_new(),
            ho_param_effects_index: HashMap_new(),
            cur_ho_params: Vec::new(),
            ho_fn_index: HashMap_new(),
            ho_fn_idx: Vec::new(),
            ho_fn_pnames: Vec::new(),
            item_modules_index: HashMap_new(),
            item_visibility_index: HashMap_new(),
            struct_modules_index: HashMap_new(),
            method_call_callers: Vec::new(),
            method_call_owners: Vec::new(),
            method_call_names: Vec::new(),
            current_return_types: Vec::new(),
            current_ret_ty: OptType::None,
            extern_fns: Vec::new(),
            current_self_type: OptString::None,
            sandbox_depth: 0,
            gpu_region_depth: 0,
            region_budgets: Vec::new(),
            region_lines: Vec::new(),
            var_alloc_lines: Vec::new(),
            linear_structs: Vec::new(),
            send_structs: Vec::new(),
            sync_structs: Vec::new(),
            consumed_vars: Vec::new(),
            scope_linear_vars: Vec::new(),
            loop_depth: 0,
            unsafe_depth: 0,
            checking_fn: "",
            thread_entries: Vec::new(),
            write_funcs: Vec::new(),
            write_globals: Vec::new(),
            write_lines: Vec::new(),
            uninit_vars: Vec::new(),
            current_line: 0,
            val_vars_per_scope: Vec::new(),
            check_depth: 0,
            func_cache: HashMap_new(),
            private_fields: HashMap_new(),
            private_field_modules: Vec::new(),
            struct_cache: HashMap_new(),
            enum_cache: HashMap_new(),
            const_cache: HashMap_new(),
            global_cache: HashMap_new(),
            alias_cache: HashMap_new(),
            caches_built: false,
        };
        // Push initial scope
        tc.scopes.push(Vec::new());
        tc.scope_linear_vars.push(Vec::new());
        tc.val_vars_per_scope.push(Vec::new());
        return tc;
    }

    pub fn check(self: &mut TypeChecker, program: Program) -> bool {
        var module: str = "main";
        match program.module {
            OptString::Some(m) => { module = m; }
            OptString::None => { module = "main"; }
        }
        TypeChecker_register_program(self, program, module);
        TypeChecker_check_bodies(self, program);
        // Run lints (only generate warnings, never errors)
        TypeChecker_lint_unused_functions(self, program);
        TypeChecker_lint_unused_imports(self, program);
        return self.errors.len() == 0;
    }

    pub fn run_lints(self: &mut TypeChecker, program: Program) {
        TypeChecker_lint_unused_functions(self, program);
        TypeChecker_lint_unused_imports(self, program);
    }

    // ---- CHUNK_MARKER ----
}

// --- Registration functions (free functions taking &mut TypeChecker) -----

pub fn TypeChecker_register_program(self: &mut TypeChecker, program: Program, module: str) {
    self.current_module = module;

    // Register structs
    var si: i64 = 0;
    while si < program.structs.len() {
        var s: StructDef = program.structs.get(si);
        var fields: Vec<StructField> = Vec::new();
        var fi: i64 = 0;
        while fi < s.fields.len() {
            var f: Param = s.fields.get(fi);
            fields.push(StructField_new(f.name, f.ty));
            fi = fi + 1;
        }
        self.structs.push(StringStructFields_new(s.name, fields));
        if tc_has_annotation(s.annotations, "scoped") { self.scoped_structs.push(s.name); }
        TypeChecker_set_item_module(self, s.name, module);
        TypeChecker_set_item_visibility(self, s.name, s.is_pub);
        TypeChecker_set_struct_module(self, s.name, module);
        // Field-level visibility
        var fi2: i64 = 0;
        while fi2 < s.fields.len() {
            var f2: Param = s.fields.get(fi2);
            self.field_visibility.push(FieldVisEntry_new(FieldVisKey_new(s.name, f2.name), f2.is_pub));
            // The first module to register the struct owns it (as
            // struct_modules: a later program may repeat the definition).
            if !f2.is_pub && HashMap_get(self.private_fields, s.name + "." + f2.name) == 0 {
                self.private_field_modules.push(module);
                HashMap_insert(self.private_fields, s.name + "." + f2.name, self.private_field_modules.len());
            }
            fi2 = fi2 + 1;
        }
        // Check for @linear, @send, @sync annotations
        var ai: i64 = 0;
        while ai < s.annotations.len() {
            var ann: Annotation = s.annotations.get(ai);
            if ann.name == "linear" { self.linear_structs.push(s.name); }
            if ann.name == "send" { self.send_structs.push(s.name); }
            if ann.name == "sync" { self.sync_structs.push(s.name); }
            ai = ai + 1;
        }
        si = si + 1;
    }

    // Register enums
    var ei: i64 = 0;
    while ei < program.enums.len() {
        var e: EnumDef = program.enums.get(ei);
        self.enums.push(e.name);
        TypeChecker_set_item_module(self, e.name, module);
        TypeChecker_set_item_visibility(self, e.name, e.is_pub);
        var variants: Vec<EnumVariantEntry> = Vec::new();
        var vi: i64 = 0;
        while vi < e.variants.len() {
            var v: EnumVariant = e.variants.get(vi);
            var tys: Vec<Type> = Vec::new();
            match v.data {
                OptParams::Some(params) => {
                    var pi: i64 = 0;
                    while pi < params.len() {
                        tys.push(params.get(pi).ty);
                        pi = pi + 1;
                    }
                }
                OptParams::None => {}
            }
            variants.push(EnumVariantEntry_new(v.name, tys));
            vi = vi + 1;
        }
        self.enum_variants.push(StringEnumVariants_new(e.name, variants));
        self.enum_type_params.push(StringVecString_new(e.name, e.type_params));
        var etp: i64 = 0;
        while etp < e.type_params.len() {
            HashMap_insert(self.enum_tp_set, e.type_params.get(etp), 1);
            etp = etp + 1;
        }
        ei = ei + 1;
    }

    // Register consts
    var ci: i64 = 0;
    while ci < program.consts.len() {
        var c: ConstDef = program.consts.get(ci);
        map_str_type_set(&mut self.consts, c.name, c.ty);
        TypeChecker_set_item_module(self, c.name, module);
        TypeChecker_set_item_visibility(self, c.name, c.is_pub);
        ci = ci + 1;
    }

    // Register module-level mutable globals
    var gi: i64 = 0;
    while gi < program.globals.len() {
        var g: GlobalVar = program.globals.get(gi);
        map_str_type_set(&mut self.globals, g.name, g.ty);
        TypeChecker_set_item_module(self, g.name, module);
        TypeChecker_set_item_visibility(self, g.name, g.is_pub);
        gi = gi + 1;
    }

    // Register type aliases
    var tai: i64 = 0;
    while tai < program.type_aliases.len() {
        var ta: TypeAlias = program.type_aliases.get(tai);
        map_str_type_set(&mut self.type_aliases, ta.name, ta.alias_for);
        TypeChecker_set_item_module(self, ta.name, module);
        TypeChecker_set_item_visibility(self, ta.name, ta.is_pub);
        tai = tai + 1;
    }

    // Register functions
    var fi3: i64 = 0;
    while fi3 < program.funcs.len() {
        var func: Func = program.funcs.get(fi3);
        var param_types: Vec<Type> = Vec::new();
        var min_args: i64 = 0;
        var pi: i64 = 0;
        while pi < func.params.len() {
            param_types.push(TypeChecker_resolve_type(self, func.params.get(pi).ty));
            // Count required params (those without defaults)
            if !func.params.get(pi).has_default {
                min_args = min_args + 1;
            }
            pi = pi + 1;
        }
        var ret_ty: Type = TypeChecker_resolve_type(self, func.ret_ty);
        self.funcs.push(StringFuncSig_new(func.name, FuncSig_new_with_min(param_types, ret_ty, min_args)));
        if func.type_params.len() > 0 {
            self.func_generic_names.push(func.name);
            self.func_generic_tps.push(func.type_params);
            self.func_generic_bounds.push(func.type_param_bounds);
        }
        TypeChecker_set_item_module(self, func.name, module);
        TypeChecker_set_item_visibility(self, func.name, func.is_pub);
        fi3 = fi3 + 1;
    }

    // Register extern function declarations
    var exti: i64 = 0;
    while exti < program.extern_decls.len() {
        var ext: ExternDecl = program.extern_decls.get(exti);
        var param_types: Vec<Type> = Vec::new();
        var pi: i64 = 0;
        while pi < ext.params.len() {
            param_types.push(TypeChecker_resolve_type(self, ext.params.get(pi).ty));
            pi = pi + 1;
        }
        var ret_ty: Type = TypeChecker_resolve_type(self, ext.ret_ty);
        self.funcs.push(StringFuncSig_new(ext.pledge_name, FuncSig_new(param_types, ret_ty)));
        TypeChecker_set_item_module(self, ext.pledge_name, module);
        self.extern_fns.push(ext.pledge_name);
        TypeChecker_set_item_visibility(self, ext.pledge_name, true);
        exti = exti + 1;
    }

    // Register impl methods
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var struct_name: str = imp.struct_name;
        if imp.type_params.len() > 0 && !str_vec_contains(self.impl_tp_names, struct_name) {
            self.impl_tp_names.push(struct_name);
            self.impl_tp_lists.push(imp.type_params);
        }
        var method_entries: Vec<MethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            var has_self: bool = false;
            if method.params.len() > 0 {
                if method.params.get(0).name == "self" { has_self = true; }
            }
            method_entries.push(MethodMapEntry_new(method.name, MethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), has_self, method.is_pub)));
            // A method is an item under its struct's name (Vec_take), never
            // under its bare one: that would make a program's own `take`
            // the private item of whichever module had a `take` method
            var mangled: str = struct_name + "_" + method.name;
            TypeChecker_set_item_module(self, mangled, module);
            mi = mi + 1;
        }
        // A second `impl` block for the struct adds its methods to the
        // existing map (a method already there keeps its first definition).
        var found: bool = false;
        var mi2: i64 = 0;
        while mi2 < self.methods.len() {
            if self.methods.get(mi2).key == struct_name {
                var existing_val: Vec<MethodMapEntry> = self.methods.get(mi2).val;
                var ni: i64 = 0;
                while ni < method_entries.len() {
                    var have: bool = false;
                    var ei: i64 = 0;
                    while ei < existing_val.len() {
                        if existing_val.get(ei).key == method_entries.get(ni).key { have = true; }
                        ei = ei + 1;
                    }
                    if !have { existing_val.push(method_entries.get(ni)); }
                    ni = ni + 1;
                }
                var m_entry: StringMethodMap = self.methods.get(mi2);
                m_entry.val = existing_val;
                self.methods.set(mi2, m_entry);
                found = true;
                break;
            }
            mi2 = mi2 + 1;
        }
        if !found {
            self.methods.push(StringMethodMap_new(struct_name, method_entries));
        }
        impi = impi + 1;
    }

    // Register trait impl methods
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        var type_name: str = ti.type_name;
        var new_methods: Vec<MethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < ti.methods.len() {
            var method: Func = ti.methods.get(mi);
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            var has_self: bool = false;
            if method.params.len() > 0 {
                if method.params.get(0).name == "self" { has_self = true; }
            }
            new_methods.push(MethodMapEntry_new(method.name, MethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), has_self, method.is_pub)));
            // under the type's name, as an impl method (not the bare name)
            TypeChecker_set_item_module(self, type_name + "_" + method.name, module);
            mi = mi + 1;
        }
        // Merge into existing method map or create new
        var found: bool = false;
        var mi2: i64 = 0;
        while mi2 < self.methods.len() {
            if self.methods.get(mi2).key == type_name {
                var existing_val: Vec<MethodMapEntry> = self.methods.get(mi2).val;
                var ni: i64 = 0;
                while ni < new_methods.len() {
                    method_map_set_entry(&mut existing_val, new_methods.get(ni).key, new_methods.get(ni).val);
                    ni = ni + 1;
                }
                var m_entry: StringMethodMap = self.methods.get(mi2);
                m_entry.val = existing_val;
                self.methods.set(mi2, m_entry);
                found = true;
                break;
            }
            mi2 = mi2 + 1;
        }
        if !found {
            self.methods.push(StringMethodMap_new(type_name, new_methods));
        }
        tii = tii + 1;
    }

    // Register trait definitions
    var tdi: i64 = 0;
    while tdi < program.traits.len() {
        var trait_def: TraitDef = program.traits.get(tdi);
        var method_entries: Vec<TraitMethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < trait_def.methods.len() {
            var method: TraitMethod = trait_def.methods.get(mi);
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            method_entries.push(TraitMethodMapEntry_new(method.name, TraitMethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), method.has_self)));
            mi = mi + 1;
        }
        self.traits.push(StringTraitMethodMap_new(trait_def.name, method_entries));
        // Register associated type declarations
        var assoc_names: Vec<str> = Vec::new();
        var ai: i64 = 0;
        while ai < trait_def.associated_types.len() {
            assoc_names.push(trait_def.associated_types.get(ai).name);
            ai = ai + 1;
        }
        self.trait_assoc_types.push(StringVecString_new(trait_def.name, assoc_names));
        tdi = tdi + 1;
    }
}

pub fn TypeChecker_register_trait_impls(self: &mut TypeChecker, program: Program) {
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        self.impl_pairs.push(ti.trait_name + ":" + ti.type_name);
        var type_name: str = ti.type_name;
        var new_methods: Vec<MethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < ti.methods.len() {
            var method: Func = ti.methods.get(mi);
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            var has_self: bool = false;
            if method.params.len() > 0 {
                if method.params.get(0).name == "self" { has_self = true; }
            }
            new_methods.push(MethodMapEntry_new(method.name, MethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), has_self, method.is_pub)));
            mi = mi + 1;
        }
        // Merge into existing method map or create new
        var found: bool = false;
        var mi2: i64 = 0;
        while mi2 < self.methods.len() {
            if self.methods.get(mi2).key == type_name {
                var existing_val: Vec<MethodMapEntry> = self.methods.get(mi2).val;
                var ni: i64 = 0;
                while ni < new_methods.len() {
                    method_map_set_entry(&mut existing_val, new_methods.get(ni).key, new_methods.get(ni).val);
                    ni = ni + 1;
                }
                var m_entry: StringMethodMap = self.methods.get(mi2);
                m_entry.val = existing_val;
                self.methods.set(mi2, m_entry);
                found = true;
                break;
            }
            mi2 = mi2 + 1;
        }
        if !found {
            self.methods.push(StringMethodMap_new(type_name, new_methods));
        }
        // Register associated type bindings
        if ti.associated_types.len() > 0 {
            var bindings: Vec<StringType> = Vec::new();
            var ai: i64 = 0;
            while ai < ti.associated_types.len() {
                var b: AssocTypeBinding = ti.associated_types.get(ai);
                bindings.push(StringType_new(b.name, b.ty));
                ai = ai + 1;
            }
            self.trait_impl_assoc_bindings.push(TraitImplAssocEntry_new(TraitImplKey_new(ti.trait_name, ti.type_name), bindings));
        }
        tii = tii + 1;
    }
}

pub fn TypeChecker_verify_trait_impls(self: &mut TypeChecker, program: Program) {
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        // Find trait definition
        var trait_def: OptTraitDef = OptTraitDef::None;
        var tdi: i64 = 0;
        while tdi < program.traits.len() {
            if program.traits.get(tdi).name == ti.trait_name {
                trait_def = OptTraitDef::Some(program.traits.get(tdi));
                break;
            }
            tdi = tdi + 1;
        }
        match trait_def {
            OptTraitDef::Some(td) => {
                // Check all required methods are implemented
                var implemented: Vec<str> = Vec::new();
                var mi: i64 = 0;
                while mi < ti.methods.len() {
                    implemented.push(ti.methods.get(mi).name);
                    mi = mi + 1;
                }
                var tmi: i64 = 0;
                while tmi < td.methods.len() {
                    var tm: TraitMethod = td.methods.get(tmi);
                    if !tc_str_vec_contains(implemented, tm.name) {
                        var has_default: bool = false;
                        match tm.default_body {
                            OptStmts::Some(_) => { has_default = true; }
                            OptStmts::None => { has_default = false; }
                        }
                        if !has_default {
                            self.errors.push("Type error: impl " + ti.trait_name + " for " + ti.type_name + " is missing method '" + tm.name + "'");
                        }
                    }
                    tmi = tmi + 1;
                }
                // Check associated types
                var provided_assoc: Vec<str> = Vec::new();
                var ai: i64 = 0;
                while ai < ti.associated_types.len() {
                    provided_assoc.push(ti.associated_types.get(ai).name);
                    ai = ai + 1;
                }
                var ai2: i64 = 0;
                while ai2 < td.associated_types.len() {
                    var assoc_name: str = td.associated_types.get(ai2).name;
                    if !tc_str_vec_contains(provided_assoc, assoc_name) {
                        self.errors.push("Type error: impl " + ti.trait_name + " for " + ti.type_name + " is missing associated type '" + assoc_name + "'");
                    }
                    ai2 = ai2 + 1;
                }
            }
            OptTraitDef::None => {
                self.errors.push("Type error: trait '" + ti.trait_name + "' is not defined (in impl for " + ti.type_name + ")");
            }
        }
        tii = tii + 1;
    }
}

pub enum OptTraitDef {
    Some(TraitDef),
    None,
}

// --- check_bodies and verification passes --------------------------------

/// Build O(1) index caches for the typechecker's symbol tables.
/// Called after all modules are registered, before checking bodies.
/// This converts O(n) linear scans into O(1) HashMap lookups for the
/// hottest paths: function signature lookup, struct field lookup,
/// enum variant lookup, const/global/type_alias resolution.
/// With 100K+ LOC, there are thousands of entries in each table.
/// Register the functions, structs and impl methods of the merged program
/// that the per-module registration did not see (src/typechecker.rs
/// register_generated_decls): comptime-generated or desugared items, and
/// the methods of a second `impl T` block for a type.
pub fn TypeChecker_register_generated_decls(self: &mut TypeChecker, program: Program) {
    var known_structs: i64 = HashMap_new();
    var ki: i64 = 0;
    while ki < self.structs.len() {
        HashMap_insert(known_structs, self.structs.get(ki).key, 1);
        ki = ki + 1;
    }
    var known_funcs: i64 = HashMap_new();
    ki = 0;
    while ki < self.funcs.len() {
        HashMap_insert(known_funcs, self.funcs.get(ki).key, 1);
        ki = ki + 1;
    }
    var si: i64 = 0;
    while si < program.structs.len() {
        var s: StructDef = program.structs.get(si);
        if HashMap_get(known_structs, s.name) == 0 {
            var fields: Vec<StructField> = Vec::new();
            var fi: i64 = 0;
            while fi < s.fields.len() {
                fields.push(StructField_new(s.fields.get(fi).name, TypeChecker_resolve_type(self, s.fields.get(fi).ty)));
                fi = fi + 1;
            }
            self.structs.push(StringStructFields_new(s.name, fields));
        }
        si = si + 1;
    }
    var fni: i64 = 0;
    while fni < program.funcs.len() {
        var func: Func = program.funcs.get(fni);
        if HashMap_get(known_funcs, func.name) == 0 {
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < func.params.len() {
                param_types.push(TypeChecker_resolve_type(self, func.params.get(pi).ty));
                pi = pi + 1;
            }
            self.funcs.push(StringFuncSig_new(func.name, FuncSig_new(param_types, TypeChecker_resolve_type(self, func.ret_ty))));
        }
        fni = fni + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var idx: i64 = -1;
        var k3: i64 = 0;
        while k3 < self.methods.len() && idx < 0 {
            if self.methods.get(k3).key == imp.struct_name { idx = k3; }
            k3 = k3 + 1;
        }
        var existing_val: Vec<MethodMapEntry> = Vec::new();
        if idx >= 0 { existing_val = self.methods.get(idx).val; }
        var to_add: Vec<MethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            var mknown: bool = false;
            var ek: i64 = 0;
            while ek < existing_val.len() && !mknown {
                if existing_val.get(ek).key == method.name { mknown = true; }
                ek = ek + 1;
            }
            if !mknown {
                var mparams: Vec<Type> = Vec::new();
                var mpi: i64 = 0;
                while mpi < method.params.len() {
                    mparams.push(TypeChecker_resolve_type(self, method.params.get(mpi).ty));
                    mpi = mpi + 1;
                }
                var has_self: bool = false;
                if method.params.len() > 0 {
                    if method.params.get(0).name == "self" { has_self = true; }
                }
                to_add.push(MethodMapEntry_new(method.name, MethodInfo_new(mparams, TypeChecker_resolve_type(self, method.ret_ty), has_self, method.is_pub)));
            }
            mi = mi + 1;
        }
        if idx < 0 {
            self.methods.push(StringMethodMap_new(imp.struct_name, to_add));
        } else if to_add.len() > 0 {
            var ai: i64 = 0;
            while ai < to_add.len() {
                method_map_set_entry(&mut existing_val, to_add.get(ai).key, to_add.get(ai).val);
                ai = ai + 1;
            }
            var m_entry: StringMethodMap = self.methods.get(idx);
            m_entry.val = existing_val;
            self.methods.set(idx, m_entry);
        }
        impi = impi + 1;
    }
}

pub fn TypeChecker_build_caches(self: &mut TypeChecker) -> void {
    if self.caches_built { return; }

    // Build func name → index cache
    var fi: i64 = 0;
    while fi < self.funcs.len() {
        HashMap_insert(self.func_cache, self.funcs.get(fi).key, fi + 1);  // +1 so 0 = not found
        fi = fi + 1;
    }

    // Build struct name → index cache
    var si: i64 = 0;
    while si < self.structs.len() {
        HashMap_insert(self.struct_cache, self.structs.get(si).key, si + 1);
        si = si + 1;
    }

    // Build enum name → index cache
    var ei: i64 = 0;
    while ei < self.enums.len() {
        HashMap_insert(self.enum_cache, self.enums.get(ei), ei + 1);
        ei = ei + 1;
    }

    // Build const name → index cache
    var ci: i64 = 0;
    while ci < self.consts.len() {
        HashMap_insert(self.const_cache, self.consts.get(ci).key, ci + 1);
        ci = ci + 1;
    }

    // Build global name → index cache
    var gi: i64 = 0;
    while gi < self.globals.len() {
        HashMap_insert(self.global_cache, self.globals.get(gi).key, gi + 1);
        gi = gi + 1;
    }

    // Build type_alias name → index cache
    var ai: i64 = 0;
    while ai < self.type_aliases.len() {
        HashMap_insert(self.alias_cache, self.type_aliases.get(ai).key, ai + 1);
        ai = ai + 1;
    }

    self.caches_built = true;
}

// ─── Annotation whitelist + placement ────────────────────────────────────
// Mirrors src/typechecker.rs::check_annotation_validity. The parser accepts
// any `@name`; without this pass a typo is a silent no-op.
// Target bits: fn=1, struct=2, param=4, local=8, global=16.

fn annotation_target_mask(name: str) -> i64 {
    if name == "deterministic" || name == "conserve" || name == "gas"
        || name == "no-alloc" || name == "no-recursion" || name == "no-unbounded"
        || name == "no-indirect" || name == "requires-audit" || name == "bounded"
        || name == "bounded-stack" || name == "firmware" || name == "no-panic"
        || name == "crashfree" || name == "medical" || name == "safety-critical"
        || name == "autosar" || name == "dal-a" || name == "constant_time"
        || name == "realtime" || name == "differentiable" || name == "quantized"
        || name == "checkpoint" || name == "dp" || name == "shard" || name == "adapter"
        || name == "audit" || name == "simd" || name == "interrupt" || name == "kernel"
        || name == "shader" || name == "unsafe" || name == "test" || name == "allocator"
        || name == "sanitizer" || name == "sink" || name == "declassify"
        || name == "wrapping" || name == "panic_handler" {
        return 1;
    }
    if name == "linear" || name == "send" || name == "sync" || name == "repr"
        || name == "packed" || name == "derive" || name == "scoped" {
        return 2;
    }
    if name == "cfg" { return 3; }                 // fn + struct
    if name == "tainted" || name == "public" { return 4; }
    if name == "secret" || name == "sensitive" { return 13; } // fn + param + local
    if name == "zeroize" { return 8; }
    if name == "cpu_local" { return 16; }
    return 0;
}

fn annotation_targets_str(mask: i64) -> str {
    var s: str = "";
    if mask % 2 == 1 { s = s + "fn/"; }
    if (mask / 2) % 2 == 1 { s = s + "struct/"; }
    if (mask / 4) % 2 == 1 { s = s + "param/"; }
    if (mask / 8) % 2 == 1 { s = s + "local/"; }
    if (mask / 16) % 2 == 1 { s = s + "global/"; }
    if str_len(s) > 0 { s = str_slice(s, 0, str_len(s) - 1); }
    return s;
}

fn check_one_annotation_fd(self: &mut TypeChecker, a: Annotation, target: str, what: str) {
    var mask: i64 = annotation_target_mask(a.name);
    if mask == 0 {
        self.errors.push("Unknown annotation '@" + a.name + "' on '" + what
            + "': no compiler pass consumes this name\n    and it will be silently ignored. Check the spelling.");
        return;
    }
    var bit: i64 = 0;
    if target == "fn" { bit = 1; }
    if target == "struct" { bit = 2; }
    if target == "param" { bit = 4; }
    if target == "local" { bit = 8; }
    if target == "global" { bit = 16; }
    if bit > 0 && (mask / bit) % 2 == 0 {
        self.errors.push("Misplaced annotation '@" + a.name + "' on '" + what
            + "': valid on " + annotation_targets_str(mask) + ", not " + target + ".");
    }
}

fn check_ann_list_fd(self: &mut TypeChecker, anns: Vec<Annotation>, target: str, fname: str) {
    var i: i64 = 0;
    while i < anns.len() {
        check_one_annotation_fd(self, anns.get(i), target, fname);
        i = i + 1;
    }
}

fn check_local_annotations_fd(self: &mut TypeChecker, stmts: Vec<Stmt>, fname: str) {
    var i: i64 = 0;
    while i < stmts.len() {
        var s: Stmt = stmts.get(i);
        match s {
            Stmt::Let(_, _, _, _, _, anns, _) => { check_ann_list_fd(self, anns, "local", fname); }
            Stmt::LetUninit(_, _, anns, _) => { check_ann_list_fd(self, anns, "local", fname); }
            Stmt::If(_, then_b, else_b, _) => {
                check_local_annotations_fd(self, then_b, fname);
                match else_b {
                    OptStmts::Some(eb) => { check_local_annotations_fd(self, eb, fname); }
                    OptStmts::None => {}
                }
            }
            Stmt::While(_, body, _) => { check_local_annotations_fd(self, body, fname); }
            Stmt::For(_, _, body, _) => { check_local_annotations_fd(self, body, fname); }
            Stmt::Loop(body, _) => { check_local_annotations_fd(self, body, fname); }
            Stmt::Defer(body, _) => { check_local_annotations_fd(self, body, fname); }
            Stmt::Match(_, arms, _) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    check_local_annotations_fd(self, arms.get(ai).body, fname);
                    ai = ai + 1;
                }
            }
            Stmt::Handle(body, handlers, _) => {
                check_local_annotations_fd(self, body, fname);
                var hi: i64 = 0;
                while hi < handlers.len() {
                    check_local_annotations_fd(self, handlers.get(hi).body, fname);
                    hi = hi + 1;
                }
            }
            Stmt::RegionBlock(_, _, _, _, _, body, _) => { check_local_annotations_fd(self, body, fname); }
            Stmt::Sandbox(body, _) => { check_local_annotations_fd(self, body, fname); }
            Stmt::Unsafe(body, _) => { check_local_annotations_fd(self, body, fname); }
            Stmt::Txn(body, _) => { check_local_annotations_fd(self, body, fname); }
            Stmt::ComptimeGen(body, _) => { check_local_annotations_fd(self, body, fname); }
            Stmt::GradBlock(_, body, _) => { check_local_annotations_fd(self, body, fname); }
            Stmt::Query(_, body, _) => { check_local_annotations_fd(self, body, fname); }
            Stmt::Select(cases, def, _) => {
                var ci: i64 = 0;
                while ci < cases.len() {
                    check_local_annotations_fd(self, cases.get(ci).body, fname);
                    ci = ci + 1;
                }
                match def {
                    OptStmts::Some(db) => { check_local_annotations_fd(self, db, fname); }
                    OptStmts::None => {}
                }
            }
            Stmt::Parallel(branches, _) => {
                var bi: i64 = 0;
                while bi < branches.len() {
                    check_local_annotations_fd(self, branches.get(bi), fname);
                    bi = bi + 1;
                }
            }
            Stmt::SpawnScope(body, _) => { check_local_annotations_fd(self, body, fname); }
            _ => {}
        }
        i = i + 1;
    }
}

fn check_fn_annotations_fd(self: &mut TypeChecker, func: Func) {
    check_ann_list_fd(self, func.annotations, "fn", func.name);
    var pi: i64 = 0;
    while pi < func.params.len() {
        check_ann_list_fd(self, func.params.get(pi).annotations, "param", func.name);
        pi = pi + 1;
    }
    check_local_annotations_fd(self, func.body, func.name);
}

pub fn TypeChecker_check_annotation_validity(self: &mut TypeChecker, program: Program) {
    var i: i64 = 0;
    while i < program.funcs.len() {
        check_fn_annotations_fd(self, program.funcs.get(i));
        i = i + 1;
    }
    i = 0;
    while i < program.impls.len() {
        var impl_: ImplDef = program.impls.get(i);
        var mi: i64 = 0;
        while mi < impl_.methods.len() {
            check_fn_annotations_fd(self, impl_.methods.get(mi));
            mi = mi + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var tmi: i64 = 0;
        while tmi < ti.methods.len() {
            check_fn_annotations_fd(self, ti.methods.get(tmi));
            tmi = tmi + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < program.structs.len() {
        var sd: StructDef = program.structs.get(i);
        check_ann_list_fd(self, sd.annotations, "struct", sd.name);
        var fi: i64 = 0;
        while fi < sd.fields.len() {
            check_ann_list_fd(self, sd.fields.get(fi).annotations, "param", sd.name);
            fi = fi + 1;
        }
        i = i + 1;
    }
}

pub fn TypeChecker_check_bodies(self: &mut TypeChecker, program: Program) {
    // Reject unknown / misplaced annotations before any pass consumes them —
    // otherwise a typo is a silent no-op.
    TypeChecker_check_annotation_validity(self, program);
    // Build O(1) lookup caches before checking (memoize type lookups)
    TypeChecker_build_caches(self);
    // Pre-pass: compute direct effects of each function
    TypeChecker_compute_func_effects(self, program);
    // Verify declared effects match inferred effects
    TypeChecker_verify_declared_effects(self, program);
    // Verify safety annotations (simplified -- just check @deterministic)
    TypeChecker_verify_deterministic(self, program);
    // Additional verification passes (stubs -- permissive, don't reject)
    // These are not needed for self-hosting since the compiler's own code
    // doesn't use these annotations.
    TypeChecker_verify_conserve(self, program);
    TypeChecker_verify_gas(self, program);
    TypeChecker_verify_safety_annotations(self, program);
    TypeChecker_verify_constant_time(self, program);
    TypeChecker_verify_realtime(self, program);
    TypeChecker_verify_differentiable(self, program);
    TypeChecker_verify_quantized(self, program);
    TypeChecker_verify_checkpoint(self, program);
    TypeChecker_verify_dp(self, program);
    TypeChecker_verify_shard(self, program);
    TypeChecker_verify_adapter(self, program);
    TypeChecker_verify_tainted(self, program);
    TypeChecker_verify_scoped(self, program);
    // (@secret is checked by compiler::secrecy.)
    TypeChecker_verify_contracts(self, program);
    TypeChecker_verify_allocator_params(self, program);
    // Mark all functions as capability-verified before checking
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        self.cap_verified.push(program.funcs.get(fi).name);
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            self.cap_verified.push(imp.methods.get(mi).name);
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    // Check function bodies
    var fi2: i64 = 0;
    while fi2 < program.funcs.len() {
        if !tc_skips(self, "fn:" + program.funcs.get(fi2).name) { TypeChecker_check_func(self, program.funcs.get(fi2)); }
        fi2 = fi2 + 1;
    }
    // Check impl method bodies
    var impi2: i64 = 0;
    while impi2 < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi2);
        var saved_tp: Vec<str> = self.current_type_params;
        var saved_self: OptString = self.current_self_type;
        if imp.type_params.len() > 0 {
            self.current_type_params = imp.type_params;
        }
        self.current_self_type = OptString::Some(imp.struct_name);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            if !tc_skips(self, "impl:" + imp.struct_name + ":" + imp.methods.get(mi).name) {
                TypeChecker_check_func(self, imp.methods.get(mi));
            }
            mi = mi + 1;
        }
        self.current_type_params = saved_tp;
        self.current_self_type = saved_self;
        impi2 = impi2 + 1;
    }
    // Check trait impl method bodies
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        var saved_tp: Vec<str> = self.current_type_params;
        var saved_self: OptString = self.current_self_type;
        if ti.type_params.len() > 0 {
            self.current_type_params = ti.type_params;
        }
        self.current_self_type = OptString::Some(ti.type_name);
        var mi: i64 = 0;
        while mi < ti.methods.len() {
            if !tc_skips(self, "trait:" + ti.type_name + ":" + ti.methods.get(mi).name) {
                TypeChecker_check_func(self, ti.methods.get(mi));
            }
            mi = mi + 1;
        }
        self.current_type_params = saved_tp;
        self.current_self_type = saved_self;
        tii = tii + 1;
    }
    TypeChecker_verify_method_calls(self, program);
    TypeChecker_verify_no_races(self, program);
}

/// Whether `key` names a body this check leaves out (see skip_bodies).
pub fn tc_skips(self: &TypeChecker, key: str) -> bool {
    if self.skip_bodies == 0 { return false; }
    return HashMap_contains(self.skip_bodies, key);
}

/// The keys of every body in `core` that `others` does not redefine: what a
/// build may skip once this core has been checked clean (release D9).
pub fn tc_core_skip_set(core: Program, others: Vec<Program>) -> i64 {
    var redefined: i64 = HashMap_new();
    var oi: i64 = 0;
    while oi < others.len() {
        var o: Program = others.get(oi);
        var k: i64 = 0;
        while k < o.funcs.len() {
            HashMap_insert(redefined, "fn:" + o.funcs.get(k).name, 1);
            k = k + 1;
        }
        k = 0;
        while k < o.impls.len() {
            var im: ImplDef = o.impls.get(k);
            var m: i64 = 0;
            while m < im.methods.len() {
                HashMap_insert(redefined, "impl:" + im.struct_name + ":" + im.methods.get(m).name, 1);
                m = m + 1;
            }
            k = k + 1;
        }
        oi = oi + 1;
    }
    var skip: i64 = HashMap_new();
    var i: i64 = 0;
    while i < core.funcs.len() {
        var key: str = "fn:" + core.funcs.get(i).name;
        if !HashMap_contains(redefined, key) { HashMap_insert(skip, key, 1); }
        i = i + 1;
    }
    i = 0;
    while i < core.impls.len() {
        var imp: ImplDef = core.impls.get(i);
        var m: i64 = 0;
        while m < imp.methods.len() {
            var key: str = "impl:" + imp.struct_name + ":" + imp.methods.get(m).name;
            if !HashMap_contains(redefined, key) { HashMap_insert(skip, key, 1); }
            m = m + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < core.trait_impls.len() {
        var ti: TraitImpl = core.trait_impls.get(i);
        var m: i64 = 0;
        while m < ti.methods.len() {
            HashMap_insert(skip, "trait:" + ti.type_name + ":" + ti.methods.get(m).name, 1);
            m = m + 1;
        }
        i = i + 1;
    }
    return skip;
}

/// Where `name`'s methods are in self.methods (self.methods.len() when it
/// has none). Entries keep their position once added, so the index only
/// grows: what was pushed since the last call is indexed first.
/// As TypeChecker_methods_at, without filling the index: what was added
/// since the last fill is scanned.
fn TypeChecker_methods_at_ro(self: &TypeChecker, name: str) -> i64 {
    if HashMap_contains(self.methods_index, name) { return HashMap_get(self.methods_index, name) - 1; }
    var i: i64 = self.methods_indexed;
    while i < self.methods.len() {
        if self.methods.get(i).key == name { return i; }
        i = i + 1;
    }
    return self.methods.len();
}

fn TypeChecker_methods_at(self: &mut TypeChecker, name: str) -> i64 {
    while self.methods_indexed < self.methods.len() {
        var key: str = self.methods.get(self.methods_indexed).key;
        if !HashMap_contains(self.methods_index, key) {
            HashMap_insert(self.methods_index, key, self.methods_indexed + 1);
        }
        self.methods_indexed = self.methods_indexed + 1;
    }
    if !HashMap_contains(self.methods_index, name) { return self.methods.len(); }
    return HashMap_get(self.methods_index, name) - 1;
}

/// Position of struct `name` in self.structs, or -1 (the first one, as a
/// scan would find).
fn TypeChecker_struct_pos(self: &mut TypeChecker, name: str) -> i64 {
    while self.sname_indexed < self.structs.len() {
        var key: str = self.structs.get(self.sname_indexed).key;
        if !HashMap_contains(self.sname_index, key) {
            HashMap_insert(self.sname_index, key, self.sname_indexed + 1);
        }
        self.sname_indexed = self.sname_indexed + 1;
    }
    return HashMap_get(self.sname_index, name) - 1;
}

/// As TypeChecker_struct_pos, without filling the index: what was added
/// since the last fill is scanned.
fn TypeChecker_struct_pos_ro(self: &TypeChecker, name: str) -> i64 {
    if HashMap_contains(self.sname_index, name) { return HashMap_get(self.sname_index, name) - 1; }
    var i: i64 = self.sname_indexed;
    while i < self.structs.len() {
        if self.structs.get(i).key == name { return i; }
        i = i + 1;
    }
    return -1;
}

/// Position of enum `name` in self.enums, or -1.
fn TypeChecker_enum_pos(self: &mut TypeChecker, name: str) -> i64 {
    while self.ename_indexed < self.enums.len() {
        var key: str = self.enums.get(self.ename_indexed);
        if !HashMap_contains(self.ename_index, key) {
            HashMap_insert(self.ename_index, key, self.ename_indexed + 1);
        }
        self.ename_indexed = self.ename_indexed + 1;
    }
    return HashMap_get(self.ename_index, name) - 1;
}

fn tc_find_func(program: Program, name: str) -> i64 {
    var i: i64 = 0;
    while i < program.funcs.len() {
        if program.funcs.get(i).name == name { return i; }
        i = i + 1;
    }
    return -1;
}

/// src/typechecker.rs verify_no_races: a function that runs on another thread
/// may not write a global of the program unless it takes a lock.
fn TypeChecker_verify_no_races(self: &mut TypeChecker, program: Program) {
    if self.thread_entries.len() == 0 || self.write_funcs.len() == 0 { return; }
    var reached: Vec<str> = Vec::new();
    var work: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < self.thread_entries.len() {
        work.push(self.thread_entries.get(i));
        i = i + 1;
    }
    while work.len() > 0 {
        var name: str = work.pop();
        if !str_vec_contains(reached, name) {
            reached.push(name);
            var at: i64 = tc_find_func(program, name);
            if at >= 0 {
                var called: Vec<str> = Vec::new();
                TypeChecker_collect_called_funcs(self, program.funcs.get(at).body, &mut called);
                called = tc_dedupe_strs(called);
                var c: i64 = 0;
                while c < called.len() {
                    work.push(called.get(c));
                    c = c + 1;
                }
            }
        }
    }
    i = 0;
    while i < self.write_funcs.len() {
        var func: str = self.write_funcs.get(i);
        if str_vec_contains(reached, func) {
            var called: Vec<str> = Vec::new();
            var at: i64 = tc_find_func(program, func);
            if at >= 0 { TypeChecker_collect_called_funcs(self, program.funcs.get(at).body, &mut called); }
            called = tc_dedupe_strs(called);
            var locked: bool = false;
            var c: i64 = 0;
            while c < called.len() {
                if str_ends_with(called.get(c), "mutex_lock") || str_ends_with(called.get(c), "write_lock") { locked = true; }
                c = c + 1;
            }
            if !locked {
                self.errors.push("Race error (line " + int_to_str(self.write_lines.get(i)) + "): '" + func
                    + "' runs on another thread and writes the global '" + self.write_globals.get(i)
                    + "' with no lock.\n    Fix: hold a mutex around the write, or use p_shared_alloc and the p_atomic_ functions.");
            }
        }
        i = i + 1;
    }
}

// `name` is declared with `val` in the innermost scope that declares it.
fn TypeChecker_is_val(self: &TypeChecker, name: str) -> bool {
    var shadow: str = "!" + name;
    var i: i64 = self.val_vars_per_scope.len() - 1;
    while i >= 0 {
        var scope: Vec<str> = self.val_vars_per_scope.get(i);
        if tc_str_vec_contains(scope, name) { return true; }
        if tc_str_vec_contains(scope, shadow) { return false; }
        i = i - 1;
    }
    return false;
}

fn TypeChecker_record_method_call(self: &mut TypeChecker, owner: str, method: str) {
    match self.current_func_name {
        OptString::Some(caller) => {
            var from: str = caller;
            match self.current_self_type {
                OptString::Some(t) => { from = t + "." + caller; }
                OptString::None => {}
            }
            self.method_call_callers.push(from);
            self.method_call_owners.push(owner);
            self.method_call_names.push(method);
        }
        OptString::None => {}
    }
}

fn tc_has_annotation(anns: Vec<Annotation>, name: str) -> bool {
    var i: i64 = 0;
    while i < anns.len() {
        if anns.get(i).name == name { return true; }
        i = i + 1;
    }
    return false;
}

// A match on an enum or bool covers every case, or has a catch-all arm.
fn TypeChecker_check_exhaustive(self: &mut TypeChecker, match_ty: Type, arms: Vec<MatchArm>, line: i64) {
    var covered: Vec<str> = Vec::new();
    var has_true: bool = false;
    var has_false: bool = false;
    var i: i64 = 0;
    while i < arms.len() {
        match arms.get(i).pattern {
            Pattern::Wildcard => { return; }
            Pattern::Ident(_) => { return; }
            Pattern::EnumVariant(_, variant, _) => { covered.push(variant); }
            Pattern::BoolLit(b) => {
                if b { has_true = true; } else { has_false = true; }
            }
            _ => {}
        }
        i = i + 1;
    }
    match match_ty {
        Type::Named(enum_name) => {
            var ei: i64 = 0;
            while ei < self.enum_variants.len() {
                if self.enum_variants.get(ei).key == enum_name {
                    var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
                    var missing: str = "";
                    var vi: i64 = 0;
                    while vi < variants.len() {
                        var v: str = variants.get(vi).name;
                        if !tc_str_vec_contains(covered, v) {
                            if str_len(missing) > 0 { missing = missing + ", "; }
                            missing = missing + enum_name + "::" + v;
                        }
                        vi = vi + 1;
                    }
                    if str_len(missing) > 0 {
                        self.errors.push("Type error: non-exhaustive match at line " + int_to_str(line) + " in " + self.current_module + " — missing variant(s): " + missing);
                    }
                    return;
                }
                ei = ei + 1;
            }
        }
        Type::Bool => {
            if !has_true || !has_false {
                self.errors.push("Type error: non-exhaustive match on bool at line " + int_to_str(line) + " in " + self.current_module);
            }
        }
        _ => {}
    }
}

// What the name-based scans cannot see: a method call's target depends on
// its receiver's type, known only once bodies are checked. A call to a user
// method is held to the same rules as a call to a function.
fn TypeChecker_verify_method_calls(self: &mut TypeChecker, program: Program) {
    var index: i64 = HashMap_new();
    var funcs: Vec<Func> = Vec::new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        HashMap_insert(index, program.funcs.get(i).name, funcs.len());
        funcs.push(program.funcs.get(i));
        i = i + 1;
    }
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            HashMap_insert(index, imp.struct_name + "." + imp.methods.get(mi).name, funcs.len());
            funcs.push(imp.methods.get(mi));
            mi = mi + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < self.method_call_callers.len() {
        var caller: str = self.method_call_callers.get(i);
        var target: str = self.method_call_owners.get(i) + "." + self.method_call_names.get(i);
        if HashMap_contains(index, caller) && HashMap_contains(index, target) {
            TypeChecker_check_method_call_rules(self, caller, funcs.get(HashMap_get(index, caller)), target, funcs.get(HashMap_get(index, target)));
        }
        i = i + 1;
    }
}

fn TypeChecker_check_method_call_rules(self: &mut TypeChecker, caller: str, from: Func, target: str, to: Func) {
    var prims: Vec<str> = expand_safety_primitives(from.annotations);
    if prims.len() > 0 {
        var to_prims: Vec<str> = expand_safety_primitives(to.annotations);
        var pi: i64 = 0;
        while pi < prims.len() {
            if !has_primitive(to_prims, prims.get(pi)) {
                self.errors.push("Safety error: function '" + caller + "' is safety-annotated but calls method '" + target + "',\n    which lacks the '" + prims.get(pi) + "' primitive.\n    Fix: add the missing safety annotation to '" + target + "', or remove the call.");
                pi = prims.len();
            }
            pi = pi + 1;
        }
    }
    if tc_has_annotation(from.annotations, "deterministic") && !tc_has_annotation(to.annotations, "deterministic") {
        self.errors.push("Safety error: @deterministic function '" + caller + "' calls method '" + target + "', which is not @deterministic.");
    }
    if tc_has_annotation(from.annotations, "conserve") && !tc_has_annotation(to.annotations, "conserve") {
        self.errors.push("Conservation error: function '" + caller + "' is @conserve but calls method '" + target + "', which is not @conserve.");
    }
    if tc_has_annotation(from.annotations, "constant_time") && !tc_has_annotation(to.annotations, "constant_time") {
        self.errors.push("Safety error: @constant_time function '" + caller + "' calls method '" + target + "', which is not @constant_time.");
    }
    if from.has_effect_annotation {
        var di: i64 = 0;
        while di < to.declared_effects.len() {
            if !tc_str_vec_contains(from.declared_effects, to.declared_effects.get(di)) {
                self.errors.push("Effect error: function '" + caller + "' calls method '" + target + "', which has effect " + to.declared_effects.get(di) + ", not declared by '" + caller + "'.");
            }
            di = di + 1;
        }
    }
}

// Helper: set func_effects entry (insert or update)
fn TypeChecker_set_func_effects(self: &mut TypeChecker, name: str, effects: Vec<str>) {
    var slot: i64 = HashMap_get(self.func_effects_index, name);
    if slot != 0 {
        var entry: StringVecStrTc = self.func_effects.get(slot - 1);
        entry.val = effects;
        self.func_effects.set(slot - 1, entry);
        return;
    }
    self.func_effects.push(StringVecStrTc_new(name, effects));
    HashMap_insert(self.func_effects_index, name, self.func_effects.len());
}

// Helper: get func_effects entry (returns empty Vec if not found)
fn TypeChecker_get_func_effects(self: &TypeChecker, name: str) -> Vec<str> {
    var slot: i64 = HashMap_get(self.func_effects_index, name);
    if slot != 0 {
        return self.func_effects.get(slot - 1).val;
    }
    return Vec::new();
}

// Indexed tables of item metadata: set once per item, read per use.
fn TypeChecker_set_item_module(self: &mut TypeChecker, key: str, val: str) {
    // First registration wins: the first module to define an item owns it.
    if HashMap_get(self.item_modules_index, key) != 0 { return; }
    self.item_modules.push(StringString_new(key, val));
    HashMap_insert(self.item_modules_index, key, self.item_modules.len());
}

fn TypeChecker_get_item_module(self: &TypeChecker, key: str) -> OptString {
    var slot: i64 = HashMap_get(self.item_modules_index, key);
    if slot != 0 { return OptString::Some(self.item_modules.get(slot - 1).val); }
    return OptString::None;
}

fn TypeChecker_set_struct_module(self: &mut TypeChecker, key: str, val: str) {
    // First registration wins: the first module to define an item owns it.
    if HashMap_get(self.struct_modules_index, key) != 0 { return; }
    self.struct_modules.push(StringString_new(key, val));
    HashMap_insert(self.struct_modules_index, key, self.struct_modules.len());
}

fn TypeChecker_get_struct_module(self: &TypeChecker, key: str) -> OptString {
    var slot: i64 = HashMap_get(self.struct_modules_index, key);
    if slot != 0 { return OptString::Some(self.struct_modules.get(slot - 1).val); }
    return OptString::None;
}

fn TypeChecker_set_item_visibility(self: &mut TypeChecker, key: str, val: bool) {
    // First registration wins: the first module to define an item decides.
    if HashMap_get(self.item_visibility_index, key) != 0 { return; }
    self.item_visibility.push(StringBool_new(key, val));
    HashMap_insert(self.item_visibility_index, key, self.item_visibility.len());
}

fn TypeChecker_get_item_visibility(self: &TypeChecker, key: str) -> bool {
    var slot: i64 = HashMap_get(self.item_visibility_index, key);
    if slot != 0 { return self.item_visibility.get(slot - 1).val; }
    return false;
}

/// Record a function's function-typed parameters (effect polymorphism) and
/// make them the current ones for the scan of its body.
fn TypeChecker_register_ho(self: &mut TypeChecker, fname: str, params: Vec<Param>) {
    var idx: Vec<i64> = Vec::new();
    var pnames: Vec<str> = Vec::new();
    var pi: i64 = 0;
    while pi < params.len() {
        match params.get(pi).ty {
            Type::Func(_, _) => {
                idx.push(pi);
                pnames.push(params.get(pi).name);
            }
            _ => {}
        }
        pi = pi + 1;
    }
    self.cur_ho_params = pnames;
    if idx.len() == 0 { return; }
    if HashMap_get(self.ho_fn_index, fname) == 0 {
        self.ho_fn_idx.push(idx);
        self.ho_fn_pnames.push(pnames);
        HashMap_insert(self.ho_fn_index, fname, self.ho_fn_idx.len());
    }
}

fn TypeChecker_ho_pnames(self: &TypeChecker, fname: str) -> Vec<str> {
    var at: i64 = HashMap_get(self.ho_fn_index, fname);
    if at == 0 { return Vec::new(); }
    return self.ho_fn_pnames.get(at - 1);
}

/// The effects of a function value passed to a higher-order function: a named
/// function's, a closure's body's, nothing for the caller's own polymorphic
/// parameter (its call sites add them), and every effect for anything else.
fn TypeChecker_passed_fn_effects(self: &TypeChecker, arg: Expr, effects: &mut Vec<str>) {
    match arg {
        Expr::Ident(n) => {
            if tc_str_vec_contains(self.cur_ho_params, n) { return; }
            var slot: i64 = HashMap_get(self.func_effects_index, n);
            if slot != 0 {
                var fe: Vec<str> = self.func_effects.get(slot - 1).val;
                var i: i64 = 0;
                while i < fe.len() {
                    if !str_vec_contains_ref(effects, fe.get(i)) { effects.push(fe.get(i)); }
                    i = i + 1;
                }
                return;
            }
        }
        Expr::Closure(_, cbody, _) => {
            TypeChecker_scan_stmts_for_effects(self, cbody, effects);
            return;
        }
        _ => {}
    }
    var all: Vec<str> = Vec::new();
    all.push("IO"); all.push("Net"); all.push("Spawn"); all.push("Diverge"); all.push("Alloc");
    all.push("Read"); all.push("Write"); all.push("Diff"); all.push("Noise"); all.push("Comm");
    var j: i64 = 0;
    while j < all.len() {
        if !str_vec_contains_ref(effects, all.get(j)) { effects.push(all.get(j)); }
        j = j + 1;
    }
}

// Helper: set ho_param_effects entry (insert or update)
fn TypeChecker_set_ho_param_effects(self: &mut TypeChecker, name: str, effects: Vec<str>) {
    var i: i64 = 0;
    while i < self.ho_param_effects.len() {
        if self.ho_param_effects.get(i).key == name {
            var entry: StringVecStrTc = self.ho_param_effects.get(i);
            entry.val = effects;
            self.ho_param_effects.set(i, entry);
            return;
        }
        i = i + 1;
    }
    self.ho_param_effects.push(StringVecStrTc_new(name, effects));
    HashMap_insert(self.ho_param_effects_index, name, self.ho_param_effects.len());
}

// Helper: get ho_param_effects entry (returns empty Vec if not found)
fn TypeChecker_get_ho_param_effects(self: &TypeChecker, name: str) -> Vec<str> {
    var i: i64 = 0;
    while i < self.ho_param_effects.len() {
        if self.ho_param_effects.get(i).key == name {
            return self.ho_param_effects.get(i).val;
        }
        i = i + 1;
    }
    return Vec::new();
}

pub fn TypeChecker_compute_func_effects(self: &mut TypeChecker, program: Program) {
    // First pass: collect direct effects (print calls, allocations, etc.)
    // Store only names (not bodies) to avoid boxing Vec<Stmt> into a Vec.
    var names: Vec<str> = Vec::new();

    // Effect polymorphism: identify function-typed parameters.
    // When a function has a param of type Func(...), calling that param
    // may produce any effect. We conservatively register all effects.
    var all_effs: Vec<str> = Vec::new();
    all_effs.push("IO");
    all_effs.push("Net");
    all_effs.push("Spawn");
    all_effs.push("Diverge");
    all_effs.push("Alloc");
    all_effs.push("Read");
    all_effs.push("Write");
    all_effs.push("Diff");
    all_effs.push("Noise");
    all_effs.push("Comm");

    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        names.push(func.name);
        // Effect polymorphism: a call through a function-typed parameter adds
        // nothing here; each call site adds the effects of what it passes.
        TypeChecker_register_ho(self, func.name, func.params);
        var effects: Vec<str> = Vec::new();
        TypeChecker_scan_stmts_for_effects(self, func.body, &mut effects);
        self.cur_ho_params = Vec::new();
        TypeChecker_set_func_effects(self, func.name, effects);
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            names.push(method.name);
            TypeChecker_register_ho(self, method.name, method.params);
            var effects: Vec<str> = Vec::new();
            TypeChecker_scan_stmts_for_effects(self, method.body, &mut effects);
            self.cur_ho_params = Vec::new();
            TypeChecker_set_func_effects(self, method.name, effects);
            mi = mi + 1;
        }
        impi = impi + 1;
    }

    // Fixpoint iteration: propagate transitive effects through call graph
    // (if A calls B and B has IO, then A has IO too)
    // Look up bodies by name from program, matching the Rust compiler.
    var changed: bool = true;
    var body_idx: i64 = tc_body_index(program);
    while changed {
        changed = false;
        var ri2: i64 = 0;
        while ri2 < names.len() {
            var fname: str = names.get(ri2);
            // Find the body for this name
            var body_opt: OptStmtList = tc_find_body_indexed(program, body_idx, fname);
            match body_opt {
                OptStmtList::Some(body) => {
                    var new_effects: Vec<str> = Vec::new();
                    self.cur_ho_params = TypeChecker_ho_pnames(self, fname);
                    TypeChecker_scan_stmts_for_effects(self, body, &mut new_effects);
                    self.cur_ho_params = Vec::new();
                    // Check if new_effects has any effect not already in func_effects for this name
                    var existing: Vec<str> = TypeChecker_get_func_effects(self, fname);
                    var has_new: bool = false;
                    var ni: i64 = 0;
                    while ni < new_effects.len() {
                        if !tc_str_vec_contains(existing, new_effects.get(ni)) {
                            has_new = true;
                            ni = new_effects.len();
                        }
                        ni = ni + 1;
                    }
                    if has_new {
                        TypeChecker_set_func_effects(self, fname, new_effects);
                        changed = true;
                    }
                }
                OptStmtList::None => {}
            }
            ri2 = ri2 + 1;
        }
    }
    // Each method under `Type.method` too: the bare names above can be
    // shared by functions and other types' methods (sandbox looks a method
    // call up by its receiver's type).
    impi = 0;
    while impi < program.impls.len() {
        var imp2: ImplDef = program.impls.get(impi);
        var mi2: i64 = 0;
        while mi2 < imp2.methods.len() {
            var m2: Func = imp2.methods.get(mi2);
            var meffs: Vec<str> = Vec::new();
            self.cur_ho_params = TypeChecker_ho_pnames(self, m2.name);
            TypeChecker_scan_stmts_for_effects(self, m2.body, &mut meffs);
            self.cur_ho_params = Vec::new();
            TypeChecker_set_func_effects(self, imp2.struct_name + "." + m2.name, meffs);
            mi2 = mi2 + 1;
        }
        impi = impi + 1;
    }
    TypeChecker_compute_heap_alloc(self, program);
}

/// Find the StmtList body for a function by name, searching funcs then impls.
/// Matches the Rust compiler's `program.funcs.iter().find()` + `program.impls` lookup.
/// name -> 1 + function index, or -(1 + impl * 65536 + method) for an impl
/// method; the first of a name wins, as TypeChecker_find_body's scan.
pub fn tc_body_index(program: Program) -> i64 {
    var idx: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        if !HashMap_contains(idx, program.funcs.get(fi).name) { HashMap_insert(idx, program.funcs.get(fi).name, fi + 1); }
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            if !HashMap_contains(idx, imp.methods.get(mi).name) {
                HashMap_insert(idx, imp.methods.get(mi).name, 0 - (1 + impi * 65536 + mi));
            }
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    return idx;
}

/// TypeChecker_find_body through an index from tc_body_index.
pub fn tc_find_body_indexed(program: Program, idx: i64, name: str) -> OptStmtList {
    if !HashMap_contains(idx, name) { return OptStmtList::None; }
    var at: i64 = HashMap_get(idx, name);
    if at > 0 { return OptStmtList::Some(program.funcs.get(at - 1).body); }
    var code: i64 = 0 - at - 1;
    var impi: i64 = code / 65536;
    var mi: i64 = code % 65536;
    return OptStmtList::Some(program.impls.get(impi).methods.get(mi).body);
}

pub fn TypeChecker_find_body(self: &mut TypeChecker, program: Program, name: str) -> OptStmtList {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if func.name == name {
            return OptStmtList::Some(func.body);
        }
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            if method.name == name {
                return OptStmtList::Some(method.body);
            }
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    return OptStmtList::None;
}

pub fn TypeChecker_verify_declared_effects(self: &mut TypeChecker, program: Program) {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if !func.has_effect_annotation { fi = fi + 1; continue; }
        // Get inferred effects
        var inferred: Vec<str> = Vec::new();
        var fei: i64 = 0;
        while fei < self.func_effects.len() {
            if self.func_effects.get(fei).key == func.name {
                inferred = self.func_effects.get(fei).val;
                break;
            }
            fei = fei + 1;
        }
        if inferred.len() == 0 { fi = fi + 1; continue; }
        // Check that all inferred effects are declared
        var ii: i64 = 0;
        while ii < inferred.len() {
            var eff: str = inferred.get(ii);
            if !tc_str_vec_contains(func.declared_effects, eff) {
                self.errors.push("Effect error: function '" + func.name + "' has inferred effect '!" + eff + "' but only declared effects not including it");
            }
            ii = ii + 1;
        }
        fi = fi + 1;
    }
}

pub fn TypeChecker_verify_deterministic(self: &mut TypeChecker, program: Program) {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_det: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "deterministic" { is_det = true; }
            ai = ai + 1;
        }
        if is_det {
            // Check for forbidden effects: IO, Net, Spawn, Diverge
            var inferred: Vec<str> = Vec::new();
            var fei: i64 = 0;
            while fei < self.func_effects.len() {
                if self.func_effects.get(fei).key == func.name {
                    inferred = self.func_effects.get(fei).val;
                    break;
                }
                fei = fei + 1;
            }
            var ei: i64 = 0;
            while ei < inferred.len() {
                var eff: str = inferred.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Determinism error: function '" + func.name + "' is @deterministic but has effect '!" + eff + "'."
                        + "\n    @deterministic functions must be reproducible — same inputs → same outputs."
                        + "\n    Effect '!" + eff + "' introduces nondeterminism (IO/Net depend on external state,"
                        + "\n    Spawn introduces concurrency, Diverge introduces control flow uncertainty)."
                        + "\n    Fix: remove the @deterministic annotation, or remove the operation that\n    produces the '!" + eff + "' effect.");
                }
                ei = ei + 1;
            }
            // Check for floating-point operations
            var floats: Vec<str> = scan_for_floats(func.body);
            if floats.len() > 0 {
                self.errors.push("Determinism error: function '" + func.name + "' is @deterministic but uses floating-point."
                    + "\n    Floating-point results vary across CPUs (different rounding, FMA contraction, etc.)."
                    + "\n    Fix: use integer arithmetic (e.g., fixed-point with i64) instead of f32/f64,\n    or remove the @deterministic annotation.");
            }
        }
        fi = fi + 1;
    }
}

// --- Verification stubs (permissive -- don't reject code) ------------------
// These are placeholder implementations for advanced annotation verification.
// They are no-ops, ensuring the self-hosted compiler can compile code that
// uses these annotations without false rejections.

pub fn TypeChecker_verify_conserve(self: &mut TypeChecker, program: Program) {
    // @conserve: money conservation (src/typechecker.rs verify_conserve).
    // A @conserve function has no IO/Net/Spawn/Diverge effect, no floats,
    // calls only @conserve functions and never a mint function.
    var conserve_funcs: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var f: Func = program.funcs.get(fi);
        if tc_has_conserve(f) { conserve_funcs.push(f.name); }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            if tc_has_conserve(m) { conserve_funcs.push(imp.struct_name + "::" + m.name); }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(ti);
        var mi: i64 = 0;
        while mi < timp.methods.len() {
            var m: Func = timp.methods.get(mi);
            if tc_has_conserve(m) { conserve_funcs.push(timp.trait_name + "::" + m.name); }
            mi = mi + 1;
        }
        ti = ti + 1;
    }

    fi = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if tc_has_conserve(func) {
            // 1. Effects
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Conservation error: function '" + func.name + "' is @conserve but has effect '!" + eff + "'.\n    @conserve functions must not interact with external state —\n    IO/Net can bring in external money, Spawn introduces concurrency,\n    Diverge introduces control flow uncertainty.\n    Fix: remove the @conserve annotation, or remove the '!" + eff + "' effect.");
                }
                ei = ei + 1;
            }
            // 2. No floating-point
            var fp: Vec<str> = tc_conserve_floats(func);
            if fp.len() > 0 {
                self.errors.push("Conservation error: function '" + func.name + "' is @conserve but uses floating-point.\n    Floating-point arithmetic is not exact — money could be lost\n    to rounding errors, violating conservation.\n    Found float in: " + tc_join(fp, ", ") + ".\n    Fix: use integer arithmetic (fixed-point with i64) instead.");
            }
            // 3. Every called function is @conserve
            var called: Vec<str> = tc_conserve_calls(func);
            var ci: i64 = 0;
            while ci < called.len() {
                var c: str = called.get(ci);
                if !tc_vec_contains_str(conserve_funcs, c) && TypeChecker_has_func(self, c) && !tc_is_mint_call(c) {
                    self.errors.push("Conservation error: function '" + func.name + "' is @conserve but calls '" + c + "',\n    which is not @conserve.\n    A @conserve function can only call other @conserve functions —\n    otherwise the callee could create or destroy money.\n    Fix: add @conserve to '" + c + "', or remove the call from '" + func.name + "'.");
                }
                ci = ci + 1;
            }
            // 4. No mint function
            ci = 0;
            while ci < called.len() {
                var c: str = called.get(ci);
                if tc_is_mint_call(c) {
                    self.errors.push("Conservation error: function '" + func.name + "' is @conserve but calls '" + c + "',\n    which creates new Money. @conserve functions cannot mint money —\n    they can only move, split, and merge existing Money.\n    Fix: remove the @conserve annotation, or remove the mint call.");
                }
                ci = ci + 1;
            }
            // 5. No `Money { .. }` literal (outside stdlib/money.fd)
            if tc_conserve_money_lits(func) > 0 && !TypeChecker_in_money_module(self, func.name) {
                self.errors.push("Conservation error: function '" + func.name + "' is @conserve but builds a 'Money { .. }' literal,\n    which creates new Money from a number. @conserve functions cannot mint money —\n    they can only move and merge (Money_add) existing Money.\n    Fix: remove the @conserve annotation, or use the money module's operations.");
            }
        }
        fi = fi + 1;
    }

    ii = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            if tc_has_conserve(method) {
                var qname: str = imp.struct_name + "::" + method.name;
                var effects: Vec<str> = TypeChecker_get_func_effects(self, qname);
                var ei: i64 = 0;
                while ei < effects.len() {
                    var eff: str = effects.get(ei);
                    if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                        self.errors.push("Conservation error: method '" + qname + "' is @conserve but has effect '!" + eff + "'.");
                    }
                    ei = ei + 1;
                }
                var fp: Vec<str> = tc_conserve_floats(method);
                if fp.len() > 0 {
                    self.errors.push("Conservation error: method '" + qname + "' is @conserve but uses floating-point. Found: " + tc_join(fp, ", ") + ".");
                }
                var called: Vec<str> = tc_conserve_calls(method);
                var ci: i64 = 0;
                while ci < called.len() {
                    var c: str = called.get(ci);
                    if tc_is_mint_call(c) {
                        self.errors.push("Conservation error: method '" + qname + "' is @conserve but calls mint function '" + c + "'.");
                    } else if TypeChecker_has_func(self, c) && !tc_vec_contains_str(conserve_funcs, c) {
                        self.errors.push("Conservation error: method '" + qname + "' is @conserve but calls '" + c + "', which is not @conserve.");
                    }
                    ci = ci + 1;
                }
                if tc_conserve_money_lits(method) > 0 {
                    self.errors.push("Conservation error: method '" + qname + "' is @conserve but builds a 'Money { .. }' literal, which mints money.");
                }
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
}

fn tc_join(v: Vec<str>, sep: str) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 { out = out + sep; }
        out = out + v.get(i);
        i = i + 1;
    }
    return out;
}

fn tc_has_conserve(f: Func) -> bool {
    var ai: i64 = 0;
    while ai < f.annotations.len() {
        if f.annotations.get(ai).name == "conserve" { return true; }
        ai = ai + 1;
    }
    return false;
}

fn TypeChecker_has_func(self: &TypeChecker, name: str) -> bool {
    match TypeChecker_lookup_func_cache(self, name) {
        OptFuncSig::Some(_) => { return true; }
        OptFuncSig::None => { return false; }
    }
    return false;
}

// The functions a @conserve body calls, each once, minus runtime builtins
// (p_*) and printing.
fn tc_conserve_calls(f: Func) -> Vec<str> {
    var raw: Vec<str> = Vec::new();
    scan_stmts_for_calls(f.body, &mut raw);
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < raw.len() {
        var c: str = raw.get(i);
        var skip: bool = str_starts_with(c, "p_") || c == "print" || c == "println" || c == "print_str" || c == "print_nl" || c == "print_int" || c == "print_map" || c == "print_vec";
        if !skip && !tc_vec_contains_str(out, c) { out.push(c); }
        i = i + 1;
    }
    return out;
}

fn tc_is_mint_call(c: str) -> bool {
    if c == "Money::new" || c == "Money::from_cents" || c == "Money::from_dollars" { return true; }
    if c == "Money_new" || c == "Money_from_cents" || c == "Money_from_dollars" { return true; }
    return str_ends_with(c, "::Money::new") || str_ends_with(c, "::Money::from_cents") || str_ends_with(c, "::Money::from_dollars")
        || str_ends_with(c, "::Money_new") || str_ends_with(c, "::Money_from_cents") || str_ends_with(c, "::Money_from_dollars");
}

/// `Money { .. }` literals in a @conserve function: each makes Money from
/// a number, i.e. mints it. Only stdlib/money.fd's own operations (add,
/// sub), which build their result from their inputs, may.
fn tc_conserve_money_lits(f: Func) -> i64 {
    var raw: Vec<str> = Vec::new();
    g_scan_struct_lits = true;
    scan_stmts_for_calls(f.body, &mut raw);
    g_scan_struct_lits = false;
    var n: i64 = 0;
    var i: i64 = 0;
    while i < raw.len() {
        var c: str = raw.get(i);
        if c == "{Money" || (str_starts_with(c, "{") && str_ends_with(c, "::Money")) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// The function is one of stdlib/money.fd's own (module money).
fn TypeChecker_in_money_module(self: &TypeChecker, name: str) -> bool {
    match TypeChecker_get_item_module(self, name) {
        OptString::Some(m) => { return m == "money"; }
        OptString::None => {}
    }
    return false;
}

// Where a @conserve function uses floating point: its body, parameters
// and return type.
fn tc_conserve_floats(f: Func) -> Vec<str> {
    var found: Vec<str> = scan_for_floats(f.body);
    var pi: i64 = 0;
    while pi < f.params.len() {
        var p: Param = f.params.get(pi);
        if tc_type_contains_float(p.ty) {
            found.push("parameter '" + p.name + ": " + type_to_str(p.ty) + "'");
        }
        pi = pi + 1;
    }
    if tc_type_contains_float(f.ret_ty) {
        found.push("return type '" + type_to_str(f.ret_ty) + "'");
    }
    return found;
}

fn tc_type_contains_float(ty: Type) -> bool {
    match ty {
        Type::F32 => { return true; }
        Type::F64 => { return true; }
        Type::Generic(_, args) => { return tc_types_contain_float(args); }
        Type::Tuple(types) => { return tc_types_contain_float(types); }
        Type::Func(params, ret) => {
            return tc_types_contain_float(params) || tc_type_contains_float(box_type_unbox(ret));
        }
        _ => { return false; }
    }
    return false;
}

fn tc_types_contain_float(types: Vec<Type>) -> bool {
    var i: i64 = 0;
    while i < types.len() {
        if tc_type_contains_float(types.get(i)) { return true; }
        i = i + 1;
    }
    return false;
}

pub fn TypeChecker_verify_gas(self: &mut TypeChecker, program: Program) {
    // @gas(N): the function's cost (AST node count of its body) plus the
    // cost of everything it calls must not exceed N (src/typechecker.rs
    // verify_gas). Impl methods are named Type_method.
    var names: Vec<str> = Vec::new();
    var bodies: Vec<StmtList> = Vec::new();
    var limit_names: Vec<str> = Vec::new();
    var limits: Vec<i64> = Vec::new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        gas_collect(func, func.name, &mut names, &mut bodies, &mut limit_names, &mut limits);
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            gas_collect(imp.methods.get(mi), imp.struct_name + "_" + imp.methods.get(mi).name, &mut names, &mut bodies, &mut limit_names, &mut limits);
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(ti);
        var tmi: i64 = 0;
        while tmi < timp.methods.len() {
            gas_collect(timp.methods.get(tmi), timp.type_name + "_" + timp.methods.get(tmi).name, &mut names, &mut bodies, &mut limit_names, &mut limits);
            tmi = tmi + 1;
        }
        ti = ti + 1;
    }
    var cache_names: Vec<str> = Vec::new();
    var cache_vals: Vec<i64> = Vec::new();
    var li: i64 = 0;
    while li < limit_names.len() {
        var lname: str = limit_names.get(li);
        var visited: Vec<str> = Vec::new();
        var total: i64 = gas_total(lname, names, bodies, &mut visited, &mut cache_names, &mut cache_vals);
        if total > limits.get(li) {
            var own: i64 = gas_own(lname, names, bodies);
            self.errors.push("Gas error: function '" + lname + "' has @gas(" + int_to_str(limits.get(li)) + ") but total gas cost is " + int_to_str(total) + " (own: " + int_to_str(own) + " + callees: " + int_to_str(total - own) + ").");
        }
        li = li + 1;
    }
}

fn gas_collect(func: Func, name: str, names: &mut Vec<str>, bodies: &mut Vec<StmtList>, limit_names: &mut Vec<str>, limits: &mut Vec<i64>) {
    names.push(name);
    bodies.push(func.body);
    var ai: i64 = 0;
    while ai < func.annotations.len() {
        var ann: Annotation = func.annotations.get(ai);
        if ann.name == "gas" && ann.args.len() > 0 {
            var lim: i64 = str_parse_int(ann.args.get(0));
            if lim >= 0 && ann.args.get(0) != "" {
                limit_names.push(name);
                limits.push(lim);
            }
        }
        ai = ai + 1;
    }
}

fn gas_index(name: str, names: Vec<str>) -> i64 {
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == name { return i; }
        i = i + 1;
    }
    return -1;
}

fn gas_own(name: str, names: Vec<str>, bodies: Vec<StmtList>) -> i64 {
    var idx: i64 = gas_index(name, names);
    if idx < 0 { return 0; }
    return gas_cost_stmts(bodies.get(idx));
}

/// Own cost plus the (memoized) totals of the distinct callees; a callee
/// already on the current path counts only its own cost (cycles).
fn gas_total(name: str, names: Vec<str>, bodies: Vec<StmtList>, visited: &mut Vec<str>, cache_names: &mut Vec<str>, cache_vals: &mut Vec<i64>) -> i64 {
    var ci: i64 = gas_index(name, cache_names);
    if ci >= 0 { return cache_vals.get(ci); }
    if gas_index(name, visited) >= 0 { return gas_own(name, names, bodies); }
    visited.push(name);
    var own: i64 = gas_own(name, names, bodies);
    var callee_total: i64 = 0;
    var idx: i64 = gas_index(name, names);
    if idx >= 0 {
        var calls: Vec<str> = Vec::new();
        scan_stmts_for_calls(bodies.get(idx), &mut calls);
        var seen: Vec<str> = Vec::new();
        var k: i64 = 0;
        while k < calls.len() {
            var c: str = calls.get(k);
            if gas_index(c, seen) < 0 {
                seen.push(c);
                callee_total = callee_total + gas_total(c, names, bodies, visited, cache_names, cache_vals);
            }
            k = k + 1;
        }
    }
    var total: i64 = own + callee_total;
    cache_names.push(name);
    cache_vals.push(total);
    return total;
}

fn gas_cost_stmts(stmts: Vec<Stmt>) -> i64 {
    var c: i64 = 0;
    var i: i64 = 0;
    while i < stmts.len() {
        c = c + gas_cost_stmt(stmts.get(i));
        i = i + 1;
    }
    return c;
}

fn gas_cost_opt_stmts(o: OptStmts) -> i64 {
    match o {
        OptStmts::Some(b) => { return gas_cost_stmts(b); }
        OptStmts::None => {}
    }
    return 0;
}

fn gas_cost_arms(arms: Vec<MatchArm>) -> i64 {
    var c: i64 = 0;
    var i: i64 = 0;
    while i < arms.len() {
        c = c + gas_cost_stmts(arms.get(i).body);
        i = i + 1;
    }
    return c;
}

fn gas_cost_exprs(es: Vec<Expr>) -> i64 {
    var c: i64 = 0;
    var i: i64 = 0;
    while i < es.len() {
        c = c + gas_cost_expr(es.get(i));
        i = i + 1;
    }
    return c;
}

fn gas_cost_stmt(stmt: Stmt) -> i64 {
    var cost: i64 = 1;
    match stmt {
        Stmt::Let(_, _, e, _, _, _, _) => { cost = cost + gas_cost_expr(e); }
        Stmt::LetTuple(_, e, _) => { cost = cost + gas_cost_expr(e); }
        Stmt::Expr(e, _) => { cost = cost + gas_cost_expr(e); }
        Stmt::Assign(_, _, e, _) => { cost = cost + gas_cost_expr(e); }
        Stmt::IndexAssign(_, idx, _, e, _) => { cost = cost + gas_cost_expr(idx) + gas_cost_expr(e); }
        Stmt::DerefAssign(pe, _, e, _) => { cost = cost + gas_cost_expr(pe) + gas_cost_expr(e); }
        Stmt::FieldAssign(obj, _, _, e, _) => { cost = cost + gas_cost_expr(obj) + gas_cost_expr(e); }
        Stmt::Return(oe, _) => {
            match oe {
                OptBoxExpr::Some(re) => { cost = cost + gas_cost_expr(box_expr_unbox(re)); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(c, tb, eb, _) => { cost = cost + gas_cost_expr(c) + gas_cost_stmts(tb) + gas_cost_opt_stmts(eb); }
        Stmt::While(c, b, _) => { cost = cost + gas_trips_while(c) * (gas_cost_expr(c) + gas_cost_stmts(b)); }
        Stmt::Loop(b, _) => { cost = cost + gas_cost_stmts(b); }
        Stmt::For(_, it, b, _) => { cost = cost + gas_cost_expr(it) + gas_trips_for(it) * gas_cost_stmts(b); }
        Stmt::Defer(b, _) => { cost = cost + gas_cost_stmts(b); }
        Stmt::Match(e, arms, _) => { cost = cost + gas_cost_expr(e) + gas_cost_arms(arms); }
        Stmt::RegionBlock(_, _, _, _, _, b, _) => { cost = cost + gas_cost_stmts(b); }
        Stmt::Sandbox(b, _) => { cost = cost + gas_cost_stmts(b); }
        Stmt::Unsafe(b, _) => { cost = cost + gas_cost_stmts(b); }
        Stmt::Txn(b, _) => { cost = cost + gas_cost_stmts(b); }
        Stmt::GradBlock(_, b, _) => { cost = cost + gas_cost_stmts(b); }
        Stmt::ComptimeGen(b, _) => { cost = cost + gas_cost_stmts(b); }
        _ => {}
    }
    return cost;
}

/// Trip count of `for x in a..b` with literal bounds (release L1: a loop
/// counted its body once whatever its bounds). Other loops count one trip;
/// the runtime gas meter (IrFunction.gas_limit) bounds them.
fn gas_trips_for(it: Expr) -> i64 {
    match it {
        Expr::Range(st, en, inclusive) => {
            match box_expr_unbox(st) {
                Expr::IntLit(a) => {
                    match box_expr_unbox(en) {
                        Expr::IntLit(b) => {
                            var n: i64 = b - a;
                            if inclusive { n = n + 1; }
                            if n < 1 { return 1; }
                            return n;
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    return 1;
}

/// Trip count of `while i < N` / `while i <= N` with a literal bound.
fn gas_trips_while(c: Expr) -> i64 {
    match c {
        Expr::Binary(op, _, r) => {
            match box_expr_unbox(r) {
                Expr::IntLit(n) => {
                    if binop_eq(op, BinOp::Lt) && n > 0 { return n; }
                    if binop_eq(op, BinOp::LtEq) && n >= 0 { return n + 1; }
                }
                _ => {}
            }
        }
        _ => {}
    }
    return 1;
}

fn gas_cost_expr(expr: Expr) -> i64 {
    var cost: i64 = 1;
    match expr {
        Expr::Binary(_, l, r) => { cost = cost + gas_cost_expr(box_expr_unbox(l)) + gas_cost_expr(box_expr_unbox(r)); }
        Expr::Unary(_, e) => { cost = cost + gas_cost_expr(box_expr_unbox(e)); }
        Expr::Call(_, args) => { cost = cost + gas_cost_exprs(args); }
        Expr::MethodCall(recv, _, args) => { cost = cost + gas_cost_expr(box_expr_unbox(recv)) + gas_cost_exprs(args); }
        Expr::FieldAccess(e, _) => { cost = cost + gas_cost_expr(box_expr_unbox(e)); }
        Expr::Index(_, idx) => { cost = cost + gas_cost_expr(box_expr_unbox(idx)); }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                cost = cost + gas_cost_expr(fields.get(fi).value);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(sp) => { cost = cost + gas_cost_expr(box_expr_unbox(sp)); }
                OptBoxExpr::None => {}
            }
        }
        Expr::ArrayLit(_, elements) => { cost = cost + gas_cost_exprs(elements); }
        Expr::TupleLit(elems) => { cost = cost + gas_cost_exprs(elems); }
        Expr::Ref(e, _) => { cost = cost + gas_cost_expr(box_expr_unbox(e)); }
        Expr::Deref(e) => { cost = cost + gas_cost_expr(box_expr_unbox(e)); }
        Expr::Cast(e, _) => { cost = cost + gas_cost_expr(box_expr_unbox(e)); }
        Expr::If(c, tb, eb) => { cost = cost + gas_cost_expr(box_expr_unbox(c)) + gas_cost_stmts(tb) + gas_cost_opt_stmts(eb); }
        Expr::Block(b) => { cost = cost + gas_cost_stmts(b); }
        Expr::Match(e, arms) => { cost = cost + gas_cost_expr(box_expr_unbox(e)) + gas_cost_arms(arms); }
        Expr::Coalesce(e, d) => { cost = cost + gas_cost_expr(box_expr_unbox(e)) + gas_cost_expr(box_expr_unbox(d)); }
        Expr::Try(e) => { cost = cost + gas_cost_expr(box_expr_unbox(e)); }
        Expr::StrConcat(l, r) => { cost = cost + gas_cost_expr(box_expr_unbox(l)) + gas_cost_expr(box_expr_unbox(r)); }
        Expr::Range(st, en, _) => { cost = cost + gas_cost_expr(box_expr_unbox(st)) + gas_cost_expr(box_expr_unbox(en)); }
        _ => {}
    }
    return cost;
}

pub fn TypeChecker_verify_safety_annotations(self: &mut TypeChecker, program: Program) {
    // Domain presets: annotation name → list of primitives
    // @no-panic is internal-only — users write @crashfree instead.
    // @crashfree = no-panic + no-unbounded
    // @medical = no-alloc + no-recursion + no-unbounded + no-panic + requires-audit
    // @safety-critical = no-alloc + no-recursion + no-unbounded + no-panic + no-indirect
    // @autosar = no-alloc + no-recursion + no-unbounded + no-panic

    // Build func_name → list of active primitives
    var func_names: Vec<str> = Vec::new();
    var func_prim_lists: Vec<StrStack> = Vec::new();
    var func_bodies: Vec<StmtList> = Vec::new();
    var func_anns: Vec<AnnList> = Vec::new();
    var func_fn_params: Vec<StrStack> = Vec::new();
    // Methods of user types (core's Option/Result methods count as builtin)
    var method_names: Vec<str> = Vec::new();

    // Collect from top-level functions
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var prims: Vec<str> = expand_safety_primitives(func.annotations);
        func_names.push(func.name);
        func_prim_lists.push(prims);
        func_bodies.push(func.body);
        func_anns.push(func.annotations);
        func_fn_params.push(safety_fn_params(func.params));
        fi = fi + 1;
    }
    // Collect from impl methods (qualified as StructName_method)
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            var prims: Vec<str> = expand_safety_primitives(method.annotations);
            var qname: str = imp.struct_name + "_" + method.name;
            if imp.struct_name != "Option" && imp.struct_name != "Result" { method_names.push(qname); }
            func_names.push(qname);
            func_prim_lists.push(prims);
            func_bodies.push(method.body);
            func_anns.push(method.annotations);
            func_fn_params.push(safety_fn_params(method.params));
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    // Collect from trait impl methods
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timpl: TraitImpl = program.trait_impls.get(ti);
        var mi: i64 = 0;
        while mi < timpl.methods.len() {
            var method: Func = timpl.methods.get(mi);
            var prims: Vec<str> = expand_safety_primitives(method.annotations);
            var qname: str = timpl.type_name + "_" + method.name;
            method_names.push(qname);
            func_names.push(qname);
            func_prim_lists.push(prims);
            func_bodies.push(method.body);
            func_anns.push(method.annotations);
            func_fn_params.push(safety_fn_params(method.params));
            mi = mi + 1;
        }
        ti = ti + 1;
    }

    // Check each function
    var ci: i64 = 0;
    while ci < func_names.len() {
        var prims: Vec<str> = func_prim_lists.get(ci);
        if prims.len() > 0 {
            var fname: str = func_names.get(ci);
            var body: Vec<Stmt> = func_bodies.get(ci);
            var anns: Vec<Annotation> = func_anns.get(ci);
            var errs: Vec<str> = check_safety_body(fname, body, prims, anns, func_names, func_prim_lists, func_fn_params.get(ci), method_names);
            var ei: i64 = 0;
            while ei < errs.len() {
                self.errors.push(errs.get(ei));
                ei = ei + 1;
            }
        }
        ci = ci + 1;
    }

    // Post-pass: indirect recursion detection for @no-recursion functions.
    // The direct self-call check in check_safety_body only catches A → A.
    // This catches A → B → A (and longer cycles) using a call graph.
    // Build call graph: func_name → Vec of called names.
    var cg_names: Vec<str> = Vec::new();
    var cg_calls: Vec<str> = Vec::new();  // flat: all calls, indexed by cg_offsets
    var cg_offsets: Vec<i64> = Vec::new(); // cg_offsets[i] = start index in cg_calls for cg_names[i]
    var cgi: i64 = 0;
    while cgi < func_names.len() {
        var body: Vec<Stmt> = func_bodies.get(cgi);
        var calls: Vec<str> = Vec::new();
        scan_stmts_for_calls(body, &mut calls);
        cg_names.push(func_names.get(cgi));
        cg_offsets.push(cg_calls.len());
        var cli: i64 = 0;
        while cli < calls.len() {
            cg_calls.push(calls.get(cli));
            cli = cli + 1;
        }
        cgi = cgi + 1;
    }
    // Check each @no-recursion function for cycle membership.
    var nri: i64 = 0;
    while nri < func_names.len() {
        var prims: Vec<str> = func_prim_lists.get(nri);
        if tc_vec_contains_str(prims, "no-recursion") {
            var target: str = func_names.get(nri);
            if is_in_call_cycle_fd(target, cg_names, cg_calls, cg_offsets) {
                self.errors.push("Safety error (no-recursion): function '" + target + "' is @no-recursion but is part of\n    an indirect recursion cycle (A → B → ... → A).\n    Indirect recursion has the same unbounded stack depth risk as direct\n    recursion — it just hides the cycle across multiple functions.\n    Fix: break the cycle by making one function in the loop iterative,\n    or remove the @no-recursion annotation.");
            }
        }
        nri = nri + 1;
    }
    // @bounded-stack: no recursion and no call to an unknown target in
    // anything the function can reach, so its stack depth has a bound.
    var leaves: Vec<str> = Vec::new();
    var lei: i64 = 0;
    while lei < program.extern_decls.len() {
        leaves.push(program.extern_decls.get(lei).pledge_name);
        lei = lei + 1;
    }
    var bsi: i64 = 0;
    while bsi < func_names.len() {
        if tc_vec_contains_str(func_prim_lists.get(bsi), "bounded-stack") {
            var why: str = bounded_stack_violation_fd(func_names.get(bsi), cg_names, cg_calls, cg_offsets, leaves);
            if str_len(why) > 0 {
                self.errors.push("Safety error (bounded-stack): function '" + func_names.get(bsi)
                    + "' is @bounded-stack but " + why + ".\n    Its stack depth has no bound: every function it can reach must be\n    non-recursive and called directly.");
            } else {
                // @bounded-stack(N): the acyclicity check above proved the
                // reachable call graph is a DAG — now measure the longest
                // call chain (in stack frames) against the declared budget.
                var bound: i64 = -1;
                var fas: Vec<Annotation> = func_anns.get(bsi);
                var fai: i64 = 0;
                while fai < fas.len() {
                    var fa: Annotation = fas.get(fai);
                    if fa.name == "bounded-stack" && fa.args.len() > 0 {
                        bound = str_parse_int(fa.args.get(0));
                    }
                    fai = fai + 1;
                }
                if bound >= 0 {
                    var index2: i64 = HashMap_new();
                    var ii2: i64 = 0;
                    while ii2 < cg_names.len() {
                        HashMap_insert(index2, cg_names.get(ii2), ii2 + 1);
                        ii2 = ii2 + 1;
                    }
                    var root_i: i64 = HashMap_get(index2, func_names.get(bsi)) - 1;
                    var memo_names: Vec<str> = Vec::new();
                    var memo_vals: Vec<i64> = Vec::new();
                    var depth: i64 = bs_depth(root_i, cg_names, cg_calls, cg_offsets, index2, leaves, &mut memo_names, &mut memo_vals);
                    if depth > bound {
                        self.errors.push("Safety error (bounded-stack): function '" + func_names.get(bsi)
                            + "' is @bounded-stack(" + int_to_str(bound) + ") but its deepest static call chain is "
                            + int_to_str(depth) + " frames — it exceeds the declared\n    frame budget. Reduce call depth or raise the bound.");
                    }
                }
            }
        }
        bsi = bsi + 1;
    }
}

/// Longest static call-chain depth from `node`, in stack frames (the node
/// itself counts as 1). Only called on graphs that passed
/// bounded_stack_violation_fd — i.e. proven acyclic — so a memoized DFS is
/// safe. Mirrors src/typechecker.rs::safety_call_depth.
fn bs_depth(node: i64, cg_names: Vec<str>, cg_calls: Vec<str>, cg_offsets: Vec<i64>,
            index: i64, leaves: Vec<str>, memo_names: &mut Vec<str>, memo_vals: &mut Vec<i64>) -> i64 {
    var name: str = cg_names.get(node);
    var mi: i64 = 0;
    while mi < memo_names.len() {
        if memo_names.get(mi) == name { return memo_vals.get(mi); }
        mi = mi + 1;
    }
    var err: Vec<str> = Vec::new();
    var edges: Vec<i64> = bs_edges(node, cg_names, cg_calls, cg_offsets, index, leaves, &mut err);
    var best: i64 = 0;
    var i: i64 = 0;
    while i < edges.len() {
        var d: i64 = bs_depth(edges.get(i), cg_names, cg_calls, cg_offsets, index, leaves, memo_names, memo_vals);
        if d > best { best = d; }
        i = i + 1;
    }
    memo_names.push(name);
    memo_vals.push(best + 1);
    return best + 1;
}

/// The functions a call to `name` from `node` can reach (a method call,
/// recorded by its bare name, reaches every method of that name), as indexes.
/// An indirect call or an unknown target goes into `err`.
fn bs_edges(node: i64, cg_names: Vec<str>, cg_calls: Vec<str>, cg_offsets: Vec<i64>, index: i64,
            leaves: Vec<str>, err: &mut Vec<str>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var end: i64 = cg_calls.len();
    if node + 1 < cg_offsets.len() { end = cg_offsets.get(node + 1); }
    var ci: i64 = cg_offsets.get(node);
    while ci < end {
        var c: str = cg_calls.get(ci);
        var j: i64 = HashMap_get(index, c);
        if j != 0 {
            out.push(j - 1);
        } else if c == "p_make_dyn" || c == "p_call_ptr" || c == "p_dyn_call" {
            err.push("makes an indirect call ('" + c + "')");
            return out;
        } else if !(str_starts_with(c, "p_") || tc_vec_contains_str(leaves, c) || c == "print" || c == "println"
                    || c == "print_str" || c == "print_nl" || c == "print_int") {
            var suffix: str = "_" + c;
            var found: bool = false;
            var k: i64 = 0;
            while k < cg_names.len() {
                if str_ends_with(cg_names.get(k), suffix) {
                    out.push(k);
                    found = true;
                }
                k = k + 1;
            }
            if !found {
                err.push("calls '" + c + "', whose target is not a known function");
                return out;
            }
        }
        ci = ci + 1;
    }
    return out;
}

/// As src/typechecker.rs bounded_stack_violation: why the stack depth of
/// `root` has no bound (a cycle it can reach, or a call with no known
/// target), or "" when it has one.
fn bounded_stack_violation_fd(root: str, cg_names: Vec<str>, cg_calls: Vec<str>, cg_offsets: Vec<i64>,
                              leaves: Vec<str>) -> str {
    var index: i64 = HashMap_new();
    var state: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < cg_names.len() {
        HashMap_insert(index, cg_names.get(i), i + 1);
        state.push(0);
        i = i + 1;
    }
    var root_i: i64 = HashMap_get(index, root) - 1;
    if root_i < 0 { return ""; }
    var err: Vec<str> = Vec::new();
    var path_node: Vec<i64> = Vec::new();
    var path_edges: Vec<Vec<i64>> = Vec::new();
    var path_pos: Vec<i64> = Vec::new();
    var first: Vec<i64> = bs_edges(root_i, cg_names, cg_calls, cg_offsets, index, leaves, &mut err);
    if err.len() > 0 { return err.get(0) + " (in '" + root + "')"; }
    // Depth first: a function on the current path, reached again, is a cycle
    state.set(root_i, 1);
    path_node.push(root_i);
    path_edges.push(first);
    path_pos.push(0);
    while path_node.len() > 0 {
        var top: i64 = path_node.len() - 1;
        var es: Vec<i64> = path_edges.get(top);
        var pos: i64 = path_pos.get(top);
        if pos < es.len() {
            path_pos.set(top, pos + 1);
            var nx: i64 = es.get(pos);
            if state.get(nx) == 1 { return "can recurse through '" + cg_names.get(nx) + "'"; }
            if state.get(nx) == 0 {
                var next_edges: Vec<i64> = bs_edges(nx, cg_names, cg_calls, cg_offsets, index, leaves, &mut err);
                if err.len() > 0 { return err.get(0) + " (in '" + cg_names.get(nx) + "')"; }
                state.set(nx, 1);
                path_node.push(nx);
                path_edges.push(next_edges);
                path_pos.push(0);
            }
        } else {
            state.set(path_node.get(top), 2);
            path_node.pop();
            path_edges.pop();
            path_pos.pop();
        }
    }
    return "";
}

// Detect if `target` is reachable from itself via a non-trivial path in the
// call graph (i.e., participates in a cycle). Catches indirect recursion.
// cg_names/cg_calls/cg_offsets encode the call graph as a CSR structure.
fn is_in_call_cycle_fd(target: str, cg_names: Vec<str>, cg_calls: Vec<str>, cg_offsets: Vec<i64>) -> bool {
    // Find target's index and its callees.
    var target_idx: i64 = -1;
    var ni: i64 = 0;
    while ni < cg_names.len() {
        if cg_names.get(ni) == target { target_idx = ni; }
        ni = ni + 1;
    }
    if target_idx < 0 { return false; }
    var start: i64 = cg_offsets.get(target_idx);
    var end: i64 = 0;
    if target_idx + 1 < cg_offsets.len() {
        end = cg_offsets.get(target_idx + 1);
    } else {
        end = cg_calls.len();
    }
    // For each callee (not target itself), DFS to see if we reach target.
    var ci: i64 = start;
    while ci < end {
        var callee: str = cg_calls.get(ci);
        if callee != target {
            // DFS from callee to target
            var visited: Vec<str> = Vec::new();
            if dfs_reaches_fd(callee, target, cg_names, cg_calls, cg_offsets, &mut visited) {
                return true;
            }
        }
        ci = ci + 1;
    }
    return false;
}

fn dfs_reaches_fd(node: str, target: str, cg_names: Vec<str>, cg_calls: Vec<str>, cg_offsets: Vec<i64>, visited: &mut Vec<str>) -> bool {
    if node == target { return true; }
    // Check visited
    var vi: i64 = 0;
    while vi < visited.len() {
        if visited.get(vi) == node { return false; }
        vi = vi + 1;
    }
    visited.push(node);
    // Find node's callees
    var node_idx: i64 = -1;
    var ni: i64 = 0;
    while ni < cg_names.len() {
        if cg_names.get(ni) == node { node_idx = ni; }
        ni = ni + 1;
    }
    if node_idx < 0 { return false; }
    var start: i64 = cg_offsets.get(node_idx);
    var end: i64 = 0;
    if node_idx + 1 < cg_offsets.len() {
        end = cg_offsets.get(node_idx + 1);
    } else {
        end = cg_calls.len();
    }
    var ci: i64 = start;
    while ci < end {
        var callee: str = cg_calls.get(ci);
        if dfs_reaches_fd(callee, target, cg_names, cg_calls, cg_offsets, visited) {
            return true;
        }
        ci = ci + 1;
    }
    return false;
}

// Expand safety annotations into a list of primitive names.
// Direct primitives: no-alloc, no-recursion, no-unbounded, no-indirect,
//                    requires-audit, bounded-stack
// Domain presets: crashfree, medical, safety-critical, autosar
pub fn expand_safety_primitives(annotations: Vec<Annotation>) -> Vec<str> {
    var prims: Vec<str> = Vec::new();
    var ai: i64 = 0;
    while ai < annotations.len() {
        var ann: Annotation = annotations.get(ai);
        var name: str = ann.name;
        // Direct primitives
        if name == "no-alloc" { prims.push("no-alloc"); }
        if name == "no-recursion" { prims.push("no-recursion"); }
        if name == "no-unbounded" { prims.push("no-unbounded"); }
        if name == "no-indirect" { prims.push("no-indirect"); }
        if name == "requires-audit" { prims.push("requires-audit"); }
        if name == "bounded-stack" { prims.push("bounded-stack"); }
        // @no-panic is a real primitive — usable directly, not only via presets.
        if name == "no-panic" { prims.push("no-panic"); }
        // F30: @firmware — bare-metal firmware (no OS-dependent calls)
        if name == "firmware" { prims.push("firmware"); }
        // F23: @simd — recognized but no safety primitives
        // F88: @zeroize — recognized but no safety primitives
        // F29: @interrupt — recognized but no safety primitives
        // F74: @secret — recognized but no safety primitives (handled in verify_secret)
        // CO7: @sensitive — recognized but no safety primitives (secrecy.fd)
        // @shader/@kernel — GPU shader entry point (handled in lowerer as is_kernel)
        // (These are recognized so the typechecker doesn't reject them as unknown)
        // Domain presets — expand to their primitives
        if name == "crashfree" {
            prims.push("no-panic");
            prims.push("no-unbounded");
        }
        if name == "medical" || name == "dal-a" {
            // @dal-a is the old spelling of @medical (DO-178C DAL-A); kept as
            // an alias instead of silently doing nothing.
            prims.push("no-alloc");
            prims.push("no-recursion");
            prims.push("no-unbounded");
            prims.push("no-panic");
            prims.push("requires-audit");
        }
        if name == "safety-critical" {
            prims.push("no-alloc");
            prims.push("no-recursion");
            prims.push("no-unbounded");
            prims.push("no-panic");
            prims.push("no-indirect");
        }
        if name == "autosar" {
            prims.push("no-alloc");
            prims.push("no-recursion");
            prims.push("no-unbounded");
            prims.push("no-panic");
        }
        ai = ai + 1;
    }
    return prims;
}

// Check if a primitive is in the list
pub fn has_primitive(prims: Vec<str>, name: str) -> bool {
    var i: i64 = 0;
    while i < prims.len() {
        if prims.get(i) == name { return true; }
        i = i + 1;
    }
    return false;
}

// Get the domain label for error messages
pub fn safety_domain_label(prims: Vec<str>) -> str {
    if has_primitive(prims, "firmware") {
        return "firmware (bare-metal)";
    }
    if has_primitive(prims, "requires-audit") && has_primitive(prims, "no-indirect") {
        return "safety-critical (ISO 26262 / DO-178C)";
    }
    if has_primitive(prims, "requires-audit") {
        return "medical (IEC 62304 / DAL-A)";
    }
    if has_primitive(prims, "no-indirect") {
        return "safety-critical";
    }
    if has_primitive(prims, "no-panic") && has_primitive(prims, "no-unbounded") && prims.len() == 2 {
        return "crashfree";
    }
    return "safety-annotated";
}

// F30: Check if a function is OS-dependent (forbidden in @firmware code)
pub fn is_os_dependent_func(name: str) -> bool {
    // Families that all need a hosted OS (release L1)
    if str_starts_with(name, "p_file_") || str_starts_with(name, "p_dir_") || str_starts_with(name, "p_socket_") || str_starts_with(name, "p_process_") || str_starts_with(name, "p_tls_") || str_starts_with(name, "p_dns_") { return true; }
    if name == "p_getenv" || name == "p_mkdir" || name == "p_rename" || name == "p_remove" || name == "p_read_line" || name == "p_read_stdin" || name == "p_argv" || name == "p_argc" { return true; }
    // File I/O
    if name == "p_file_read" { return true; }
    if name == "p_file_write" { return true; }
    if name == "p_file_append" { return true; }
    if name == "p_file_delete" { return true; }
    if name == "p_file_exists" { return true; }
    if name == "p_file_size" { return true; }
    if name == "p_file_hash" { return true; }
    if name == "p_file_write_bin" { return true; }
    if name == "p_file_write_vec" { return true; }
    if name == "p_file_read_bytes" { return true; }
    if name == "p_dir_list" { return true; }
    if name == "p_is_dir" { return true; }
    if name == "p_mkdir" { return true; }
    if name == "p_rmdir" { return true; }
    if name == "p_rename" { return true; }
    if name == "p_process_run" { return true; }
    if name == "p_process_stdout" { return true; }
    if name == "p_process_stderr" { return true; }
    if name == "p_process_code" { return true; }
    if name == "p_process_close" { return true; }
    if name == "p_getpid" { return true; }
    if name == "p_system" { return true; }
    if name == "p_exit" { return true; }
    // Sockets / networking
    if name == "p_socket_create" { return true; }
    if name == "p_socket_connect" { return true; }
    if name == "p_socket_send" { return true; }
    if name == "p_socket_recv" { return true; }
    if name == "p_socket_recv_str" { return true; }
    if name == "p_socket_close" { return true; }
    if name == "p_socket_listen" { return true; }
    if name == "p_socket_accept" { return true; }
    // HTTP
    if name == "p_http_get" { return true; }
    if name == "p_http_post" { return true; }
    if name == "p_http_send_response" { return true; }
    // Threads / mutexes
    if name == "p_thread_create" { return true; }
    if name == "p_thread_join" { return true; }
    if name == "p_mutex_create" { return true; }
    if name == "p_mutex_lock" { return true; }
    if name == "p_mutex_unlock" { return true; }
    // Environment / args
    if name == "p_env_get" { return true; }
    if name == "p_env_set" { return true; }
    if name == "p_args_count" { return true; }
    if name == "p_args_get" { return true; }
    // SQLite
    if name == "p_sqlite_open" { return true; }
    if name == "p_sqlite_exec" { return true; }
    if name == "p_sqlite_query" { return true; }
    return false;
}

/// Parameters of function or `dyn` type: a call through one is indirect.
pub fn safety_fn_params(params: Vec<Param>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < params.len() {
        match params.get(i).ty {
            Type::Func(_, _) => { out.push(params.get(i).name); }
            Type::Dyn(_) => { out.push(params.get(i).name); }
            _ => {}
        }
        i = i + 1;
    }
    return out;
}

/// The user method a ".m" call can name: the first `Type_m` among the
/// methods of user types, or "" (a builtin method of Vec, HashMap, str,
/// Option or Result).
fn safety_resolve_method(m: str, method_names: Vec<str>) -> str {
    var suffix: str = "_" + m;
    var i: i64 = 0;
    while i < method_names.len() {
        if str_ends_with(method_names.get(i), suffix) { return method_names.get(i); }
        i = i + 1;
    }
    return "";
}

// Check a function body for safety violations
pub fn check_safety_body(
    func_name: str,
    body: Vec<Stmt>,
    prims: Vec<str>,
    anns: Vec<Annotation>,
    all_func_names: Vec<str>,
    all_func_prims: Vec<StrStack>,
    fn_params: Vec<str>,
    method_names: Vec<str>
) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    var label: str = safety_domain_label(prims);

    // @requires-audit: must have @audit
    if has_primitive(prims, "requires-audit") {
        var has_audit: bool = false;
        var ai: i64 = 0;
        while ai < anns.len() {
            if anns.get(ai).name == "audit" { has_audit = true; ai = anns.len(); }
            ai = ai + 1;
        }
        if !has_audit {
            errs.push("Safety error (" + label + "): function '" + func_name + "' is @requires-audit but not @audit.\n    Safety-critical functions must have @audit for regulatory traceability.\n    Fix: add @audit to '" + func_name + "', or remove the safety annotation.");
        }
    }

    // Collect all calls in the body
    var calls: Vec<str> = Vec::new();
    g_scan_dot_methods = true;
    scan_stmts_for_calls(body, &mut calls);
    g_scan_dot_methods = false;

    // Builtin methods that allocate (Vec, HashMap, str), and "+" for `a + b`
    // on strings.
    var alloc_methods: Vec<str> = tc_alloc_method_names();

    // Alloc functions (forbidden by @no-alloc)
    var alloc_funcs: Vec<str> = tc_alloc_func_names();

    // Panic functions (forbidden by @no-panic)
    var panic_funcs: Vec<str> = Vec::new();
    panic_funcs.push("p_panic"); panic_funcs.push("Option_unwrap"); panic_funcs.push("Result_unwrap");

    // Indirect call functions (forbidden by @no-indirect)
    var indirect_funcs: Vec<str> = Vec::new();
    indirect_funcs.push("p_make_dyn"); indirect_funcs.push("p_call_ptr"); indirect_funcs.push("p_dyn_call");

    var ci: i64 = 0;
    while ci < calls.len() {
        var called: str = calls.get(ci);

        // A method call: a user method is checked as the function it names;
        // a builtin one only for allocation and unwrap.
        if str_starts_with(called, ".") {
            var m: str = str_slice(called, 1, str_len(called));
            var user_fn: str = safety_resolve_method(m, method_names);
            if user_fn == "" {
                if has_primitive(prims, "no-alloc") && tc_vec_contains_str(alloc_methods, m) {
                    var what: str = "." + m + "()";
                    if m == "+" { what = "string `+`"; }
                    errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-alloc but uses " + what + ", which allocates.\n    Dynamic allocation is forbidden — deterministic memory usage required.\n    Fix: use a fixed-size array or a buffer passed in, or remove the safety annotation.");
                }
                if has_primitive(prims, "no-panic") && (m == "unwrap" || m == "expect") {
                    errs.push("Safety error (" + label + "): function '" + func_name + "' calls '." + m + "()'.\n    " + m + "() panics on None/Err — crashfree functions must never panic.\n    Fix: use match, unwrap_or, or the ? operator instead.");
                }
                ci = ci + 1;
                continue;
            }
            called = user_fn;
        }

        // @no-indirect: a call through a parameter of function type
        if has_primitive(prims, "no-indirect") && tc_vec_contains_str(fn_params, called) {
            errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-indirect but calls its parameter '" + called + "', a function value.\n    Indirect calls (function pointers, closures, dynamic dispatch) are forbidden.\n    Fix: call the function directly, or remove the safety annotation.");
            ci = ci + 1;
            continue;
        }

        // Skip built-in runtime functions (p_print_*, etc.) unless they're in a forbidden list
        if str_starts_with(called, "p_") {
            var fw_forbidden: bool = has_primitive(prims, "firmware") && is_os_dependent_func(called);
            if !fw_forbidden && !tc_vec_contains_str(panic_funcs, called) && !tc_vec_contains_str(alloc_funcs, called) && !tc_vec_contains_str(indirect_funcs, called) {
                ci = ci + 1;
                continue;
            }
        }
        if called == "print" || called == "println" || called == "print_str" || called == "print_nl" || called == "print_int" {
            ci = ci + 1;
            continue;
        }

        // @no-alloc: check for dynamic allocation
        if has_primitive(prims, "no-alloc") {
            if tc_vec_contains_str(alloc_funcs, called) {
                errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-alloc but calls '" + called + "'.\n    Dynamic allocation is forbidden — deterministic memory usage required.\n    Fix: use stack-allocated arrays, or remove the safety annotation.");
                ci = ci + 1;
                continue;
            }
        }

        // @no-panic: check for panic risk
        if has_primitive(prims, "no-panic") {
            if tc_vec_contains_str(panic_funcs, called) {
                errs.push("Safety error (" + label + "): function '" + func_name + "' calls '" + called + "', which can panic.\n    '" + called + "' can panic at runtime — crashfree functions must never panic.\n    Fix: use match/unwrap_or instead of unwrap, or remove the safety annotation.");
                ci = ci + 1;
                continue;
            }
            if called == "unwrap" {
                errs.push("Safety error (" + label + "): function '" + func_name + "' calls 'unwrap'.\n    unwrap() panics on None/Err — crashfree functions must never panic.\n    Fix: use match, unwrap_or, or the ? operator instead.");
                ci = ci + 1;
                continue;
            }
        }

        // @no-indirect: check for function pointers / dynamic dispatch
        if has_primitive(prims, "no-indirect") {
            if tc_vec_contains_str(indirect_funcs, called) {
                errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-indirect but calls '" + called + "'.\n    Indirect calls (function pointers, dynamic dispatch) are forbidden.\n    Fix: use direct calls only, or remove the safety annotation.");
                ci = ci + 1;
                continue;
            }
        }

        // F30: @firmware — check for OS-dependent function calls
        if has_primitive(prims, "firmware") {
            if is_os_dependent_func(called) {
                errs.push("Safety error (" + label + "): function '" + func_name + "' is @firmware but calls '" + called + "'.\n    OS-dependent functions (file I/O, sockets, threads, env vars) are forbidden\n    in bare-metal firmware — they require a hosted OS environment.\n    Fix: use bare-metal alternatives (port I/O, memory-mapped I/O),\n    or remove the @firmware annotation.");
                ci = ci + 1;
                continue;
            }
        }

        // @no-recursion: check for direct self-call
        if has_primitive(prims, "no-recursion") && called == func_name {
            errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-recursion but calls itself.\n    Recursion is forbidden — stack overflow is a safety risk.\n    Fix: convert to an iterative loop, or remove the safety annotation.");
            ci = ci + 1;
            continue;
        }

        // Core's collection and Option/Result functions were checked
        // against the forbidden lists above; they carry no annotations.
        if str_starts_with(called, "Vec_") || str_starts_with(called, "HashMap_") || str_starts_with(called, "Option_") || str_starts_with(called, "Result_") || str_starts_with(called, "Box_") {
            ci = ci + 1;
            continue;
        }

        // Transitive: can only call other safety-annotated functions
        // (with compatible or superset primitives)
        var is_known_func: bool = false;
        var callee_prims: Vec<str> = Vec::new();
        var fi: i64 = 0;
        while fi < all_func_names.len() {
            if all_func_names.get(fi) == called {
                is_known_func = true;
                callee_prims = all_func_prims.get(fi);
                fi = all_func_names.len();
            }
            fi = fi + 1;
        }
        if !is_known_func {
            // Unknown — might be builtin, skip
            ci = ci + 1;
            continue;
        }
        if callee_prims.len() > 0 {
            // Callee has safety annotations — check it has all required primitives
            var pi: i64 = 0;
            while pi < prims.len() {
                var required: str = prims.get(pi);
                if !has_primitive(callee_prims, required) {
                    errs.push("Safety error (" + label + "): function '" + func_name + "' is safety-annotated but calls '" + called + "',\n    which lacks the '" + required + "' primitive.\n    A safety-annotated function can only call functions with compatible safety guarantees.\n    Fix: add the missing safety annotation to '" + called + "', or remove the call.");
                    pi = prims.len();  // break
                }
                pi = pi + 1;
            }
        } else {
            // Callee has no safety annotations
            errs.push("Safety error (" + label + "): function '" + func_name + "' is safety-annotated but calls '" + called + "',\n    which has no safety annotations.\n    A safety-annotated function can only call other safety-annotated functions.\n    Fix: add safety annotations to '" + called + "', or remove the call from '" + func_name + "'.");
        }
        ci = ci + 1;
    }

    // @no-panic: check for division/modulo (division by zero risk)
    if has_primitive(prims, "no-panic") {
        var div_sites: Vec<str> = Vec::new();
        scan_for_division(body, &mut div_sites);
        var di: i64 = 0;
        while di < div_sites.len() {
            errs.push("Safety error (" + label + "): function '" + func_name + "' uses '" + div_sites.get(di) + "'.\n    Division/modulo by zero aborts at runtime.\n    Crashfree functions cannot use '" + div_sites.get(di) + "' unless the divisor is proven non-zero.\n    Fix: use a checked-divide helper, or remove the safety annotation.");
            di = di + 1;
        }
    }

    // @no-panic: indexing (out of bounds) and integer arithmetic (overflow)
    // panic too.
    if has_primitive(prims, "no-panic") {
        var wrapping: bool = false;
        var wai: i64 = 0;
        while wai < anns.len() {
            if anns.get(wai).name == "wrapping" { wrapping = true; }
            wai = wai + 1;
        }
        var risk_lines: Vec<i64> = Vec::new();
        var risk_msgs: Vec<str> = Vec::new();
        scan_for_panic_risks(body, wrapping, &mut risk_lines, &mut risk_msgs);
        var rk: i64 = 0;
        while rk < risk_lines.len() {
            errs.push("Safety error (" + label + ") (line " + int_to_str(risk_lines.get(rk)) + "): function '" + func_name + "' " + risk_msgs.get(rk) + ".\n    Crashfree functions must never panic.");
            rk = rk + 1;
        }
    }

    // @no-unbounded: check for while loops
    if has_primitive(prims, "no-unbounded") {
        var while_sites: Vec<i64> = Vec::new();
        scan_for_while_loops(body, &mut while_sites);
        var wi: i64 = 0;
        while wi < while_sites.len() {
            errs.push("Safety error (" + label + ") (line " + int_to_str(while_sites.get(wi)) + "): function '" + func_name + "' is @no-unbounded but uses a 'while' loop.\n    While loops are unbounded — use 'for' loops over finite ranges/arrays.\n    Fix: replace 'while cond { ... }' with 'for i in 0..N { ... }', or remove the safety annotation.");
            wi = wi + 1;
        }
    }

    return errs;
}

// --- Helper: check if a Vec<str> contains a string ---
pub fn tc_vec_contains_str(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

// --- Call scanning helpers ---

pub fn scan_stmts_for_calls(stmts: Vec<Stmt>, calls: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_calls(stmts.get(i), calls);
        i = i + 1;
    }
}

pub fn scan_stmt_for_calls(stmt: Stmt, calls: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => { scan_expr_for_calls(expr, calls); }
        Stmt::LetTuple(_, expr, _) => { scan_expr_for_calls(expr, calls); }
        Stmt::Expr(e, _) => { scan_expr_for_calls(e, calls); }
        Stmt::Assign(_, _, expr, _) => { scan_expr_for_calls(expr, calls); }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            scan_expr_for_calls(index, calls);
            scan_expr_for_calls(expr, calls);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            scan_expr_for_calls(ptr_expr, calls);
            scan_expr_for_calls(expr, calls);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            scan_expr_for_calls(object, calls);
            scan_expr_for_calls(expr, calls);
        }
        Stmt::Return(opt_e, _) => {
            match opt_e {
                OptBoxExpr::Some(e) => { scan_expr_for_calls(box_expr_unbox(e), calls); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            scan_expr_for_calls(cond, calls);
            scan_stmts_for_calls(then_block, calls);
            match else_block {
                OptStmts::Some(eb) => { scan_stmts_for_calls(eb, calls); }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, _) => {
            scan_expr_for_calls(cond, calls);
            scan_stmts_for_calls(body, calls);
        }
        Stmt::For(_, iterator, body, _) => {
            scan_expr_for_calls(iterator, calls);
            scan_stmts_for_calls(body, calls);
        }
        Stmt::Loop(body, _) => { scan_stmts_for_calls(body, calls); }
        Stmt::Break(opt_e, _) => {
            match opt_e {
                OptBoxExpr::Some(e) => { scan_expr_for_calls(box_expr_unbox(e), calls); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::Defer(stmts, _) => { scan_stmts_for_calls(stmts, calls); }
        Stmt::Match(expr, arms, _) => {
            scan_expr_for_calls(expr, calls);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_calls(arms.get(ai).body, calls);
                ai = ai + 1;
            }
        }
        Stmt::Handle(body, handlers, _) => {
            scan_stmts_for_calls(body, calls);
            var hi: i64 = 0;
            while hi < handlers.len() {
                scan_stmts_for_calls(handlers.get(hi).body, calls);
                hi = hi + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { scan_stmts_for_calls(body, calls); }
        Stmt::Sandbox(body, _) => { scan_stmts_for_calls(body, calls); }
        Stmt::Unsafe(body, _) => { scan_stmts_for_calls(body, calls); }
        Stmt::Txn(body, _) => { scan_stmts_for_calls(body, calls); }
        Stmt::ComptimeGen(block, _) => { scan_stmts_for_calls(block, calls); }
        Stmt::GradBlock(_, body, _) => { scan_stmts_for_calls(body, calls); }
        Stmt::Backward(loss, _) => { scan_expr_for_calls(loss, calls); }
        Stmt::Do(_, _, args, _) => {
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_calls(args.get(ai), calls);
                ai = ai + 1;
            }
        }
        _ => {}
    }
}

/// Set by check_safety_body: method calls are recorded as ".method",
/// `Type::f` calls as "Type_f" and string concatenation as ".+" (release
/// L1: the safety checks saw only free-function names, so `v.push(x)` and
/// `Vec::new()` passed @no-alloc).
var g_scan_dot_methods: bool = false;
// When set, scan_expr_for_calls also records each struct literal as
// "{Name" (the @conserve check looks for `Money { .. }`).
var g_scan_struct_lits: bool = false;

pub fn scan_expr_for_calls(expr: Expr, calls: &mut Vec<str>) {
    match expr {
        Expr::Call(callee, args) => {
            calls.push(callee);
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_calls(args.get(ai), calls);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(receiver, method, args) => {
            if g_scan_dot_methods {
                // `Type::f(..)` parses as a method call on the type name:
                // record it as the function it names, `Type_f`.
                var static_name: str = "";
                match box_expr_unbox(receiver) {
                    Expr::Ident(rn) => {
                        if str_len(rn) > 0 && str_byte_at(rn, 0) >= 65 && str_byte_at(rn, 0) <= 90 { static_name = rn + "_" + method; }
                    }
                    _ => {}
                }
                if static_name != "" { calls.push(static_name); } else { calls.push("." + method); }
            } else {
                calls.push(method);
            }
            scan_expr_for_calls(box_expr_unbox(receiver), calls);
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_calls(args.get(ai), calls);
                ai = ai + 1;
            }
        }
        Expr::Binary(_, left, right) => {
            scan_expr_for_calls(box_expr_unbox(left), calls);
            scan_expr_for_calls(box_expr_unbox(right), calls);
        }
        Expr::Unary(_, e) => { scan_expr_for_calls(box_expr_unbox(e), calls); }
        Expr::FieldAccess(e, _) => { scan_expr_for_calls(box_expr_unbox(e), calls); }
        Expr::OptionalFieldAccess(e, _) => { scan_expr_for_calls(box_expr_unbox(e), calls); }
        Expr::StructLit(sl_name, fields, spread) => {
            if g_scan_struct_lits { calls.push("{" + sl_name); }
            var fi: i64 = 0;
            while fi < fields.len() {
                scan_expr_for_calls(fields.get(fi).value, calls);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { scan_expr_for_calls(box_expr_unbox(s), calls); }
                OptBoxExpr::None => {}
            }
        }
        Expr::If(cond, then_block, else_block) => {
            scan_expr_for_calls(box_expr_unbox(cond), calls);
            scan_stmts_for_calls(then_block, calls);
            match else_block {
                OptStmts::Some(eb) => { scan_stmts_for_calls(eb, calls); }
                OptStmts::None => {}
            }
        }
        Expr::ArrayLit(_, elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                scan_expr_for_calls(elements.get(ei), calls);
                ei = ei + 1;
            }
        }
        Expr::Index(array, index) => {
            scan_expr_for_calls(box_expr_unbox(array), calls);
            scan_expr_for_calls(box_expr_unbox(index), calls);
        }
        Expr::TupleLit(elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                scan_expr_for_calls(elements.get(ei), calls);
                ei = ei + 1;
            }
        }
        Expr::Ref(e, _) => { scan_expr_for_calls(box_expr_unbox(e), calls); }
        Expr::Deref(e) => { scan_expr_for_calls(box_expr_unbox(e), calls); }
        Expr::Cast(e, _) => { scan_expr_for_calls(box_expr_unbox(e), calls); }
        Expr::Coalesce(expr, default) => {
            scan_expr_for_calls(box_expr_unbox(expr), calls);
            scan_expr_for_calls(box_expr_unbox(default), calls);
        }
        Expr::Try(e) => { scan_expr_for_calls(box_expr_unbox(e), calls); }
        Expr::StrConcat(left, right) => {
            if g_scan_dot_methods { calls.push(".+"); }
            scan_expr_for_calls(box_expr_unbox(left), calls);
            scan_expr_for_calls(box_expr_unbox(right), calls);
        }
        Expr::Range(start, end, _) => {
            scan_expr_for_calls(box_expr_unbox(start), calls);
            scan_expr_for_calls(box_expr_unbox(end), calls);
        }
        Expr::Match(expr, arms) => {
            scan_expr_for_calls(box_expr_unbox(expr), calls);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_calls(arms.get(ai).body, calls);
                ai = ai + 1;
            }
        }
        Expr::TryBlock(body) => { scan_stmts_for_calls(body, calls); }
        Expr::Block(stmts) => { scan_stmts_for_calls(stmts, calls); }
        Expr::Closure(_, body, _) => { scan_stmts_for_calls(body, calls); }
        Expr::Comptime(e) => { scan_expr_for_calls(box_expr_unbox(e), calls); }
        Expr::ComptimeBlock(stmts) => { scan_stmts_for_calls(stmts, calls); }
        Expr::PipeForward(left, right) => {
            scan_expr_for_calls(box_expr_unbox(left), calls);
            scan_expr_for_calls(box_expr_unbox(right), calls);
        }
        Expr::QuantCast(e, _) => { scan_expr_for_calls(box_expr_unbox(e), calls); }
        _ => {}
    }
}

// --- Division scanning helpers ---

// Panic risks the no-panic primitive rejects besides panicking calls and
// division: indexing (out of bounds) and, unless `wrapping`, integer
// arithmetic (overflow). One (line, what) per site. Inside
// `for i in 0..v.len()`, `v[i]` / `v.get(i)` / `v.set(i, ..)` are in bounds
// (unless the body reassigns `i` or resizes `v`).
pub fn scan_for_panic_risks(stmts: Vec<Stmt>, wrapping: bool, lines: &mut Vec<i64>, msgs: &mut Vec<str>) {
    var safe_idx: Vec<str> = Vec::new();
    var safe_vec: Vec<str> = Vec::new();
    pr_stmts(stmts, wrapping, &mut safe_idx, &mut safe_vec, lines, msgs);
}

// `a`, `a.b.c`: the textual path of a place ("" if it is not one).
fn pr_place(e: Expr) -> str {
    match e {
        Expr::Ident(n) => { return n; }
        Expr::FieldAccess(x, field) => {
            var p: str = pr_place(box_expr_deref(x));
            if p == "" { return ""; }
            return p + "." + field;
        }
        _ => { return ""; }
    }
    return "";
}

// `for i in 0..v.len()` -> the path of `v` ("" otherwise).
fn pr_len_bound(iterator: Expr) -> str {
    match iterator {
        Expr::Range(start, end, inclusive) => {
            if inclusive { return ""; }
            match box_expr_deref(start) {
                Expr::IntLit(z) => { if z != 0 { return ""; } }
                _ => { return ""; }
            }
            match box_expr_deref(end) {
                Expr::MethodCall(recv, method, args) => {
                    if method == "len" && args.len() == 0 { return pr_place(box_expr_deref(recv)); }
                }
                _ => {}
            }
        }
        _ => {}
    }
    return "";
}

// Whether `body` reassigns `i` or resizes the Vec at path `v`.
fn pr_disturbs(body: Vec<Stmt>, i: str, v: str) -> bool {
    var k: i64 = 0;
    while k < body.len() {
        if pr_disturbs_stmt(body.get(k), i, v) { return true; }
        k = k + 1;
    }
    return false;
}

fn pr_disturbs_stmt(s: Stmt, i: str, v: str) -> bool {
    match s {
        Stmt::Assign(target, _, expr, _) => { return target == i || target == v || pr_disturbs_expr(expr, i, v); }
        Stmt::Let(_, _, expr, _, _, _, _) => { return pr_disturbs_expr(expr, i, v); }
        Stmt::Expr(expr, _) => { return pr_disturbs_expr(expr, i, v); }
        Stmt::If(_, then_block, else_block, _) => {
            if pr_disturbs(then_block, i, v) { return true; }
            match else_block {
                OptStmts::Some(b) => { return pr_disturbs(b, i, v); }
                OptStmts::None => {}
            }
            return false;
        }
        Stmt::While(_, body, _) => { return pr_disturbs(body, i, v); }
        Stmt::For(_, _, body, _) => { return pr_disturbs(body, i, v); }
        Stmt::Loop(body, _) => { return pr_disturbs(body, i, v); }
        Stmt::Unsafe(body, _) => { return pr_disturbs(body, i, v); }
        Stmt::Match(_, arms, _) => {
            var a: i64 = 0;
            while a < arms.len() {
                if pr_disturbs(arms.get(a).body, i, v) { return true; }
                a = a + 1;
            }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

fn pr_disturbs_expr(e: Expr, i: str, v: str) -> bool {
    match e {
        Expr::MethodCall(recv, method, args) => {
            var r: Expr = box_expr_deref(recv);
            var resizes: bool = method == "pop" || method == "remove" || method == "clear" || method == "truncate" || method == "drain";
            if resizes && pr_place(r) == v { return true; }
            if pr_disturbs_expr(r, i, v) { return true; }
            var a: i64 = 0;
            while a < args.len() {
                if pr_disturbs_expr(args.get(a), i, v) { return true; }
                a = a + 1;
            }
            return false;
        }
        Expr::Call(_, args) => {
            var c: i64 = 0;
            while c < args.len() {
                if pr_disturbs_expr(args.get(c), i, v) { return true; }
                c = c + 1;
            }
            return false;
        }
        Expr::Binary(_, l, r) => { return pr_disturbs_expr(box_expr_deref(l), i, v) || pr_disturbs_expr(box_expr_deref(r), i, v); }
        _ => { return false; }
    }
    return false;
}

fn pr_in_bounds(safe_idx: Vec<str>, safe_vec: Vec<str>, vec: Expr, index: Expr) -> bool {
    var vp: str = pr_place(vec);
    if vp == "" { return false; }
    match index {
        Expr::Ident(i) => {
            var k: i64 = 0;
            while k < safe_idx.len() {
                if safe_idx.get(k) == i && safe_vec.get(k) == vp { return true; }
                k = k + 1;
            }
        }
        _ => {}
    }
    return false;
}

fn pr_push(lines: &mut Vec<i64>, msgs: &mut Vec<str>, line: i64, what: str) {
    var k: i64 = 0;
    while k < lines.len() {
        if lines.get(k) == line && msgs.get(k) == what { return; }
        k = k + 1;
    }
    lines.push(line);
    msgs.push(what);
}

fn pr_stmts(stmts: Vec<Stmt>, wrapping: bool, safe_idx: &mut Vec<str>, safe_vec: &mut Vec<str>, lines: &mut Vec<i64>, msgs: &mut Vec<str>) {
    var k: i64 = 0;
    while k < stmts.len() {
        var s: Stmt = stmts.get(k);
        var line: i64 = stmt_line(s);
        match s {
            Stmt::IndexAssign(array, index, _, expr, _) => {
                if !pr_in_bounds(safe_idx, safe_vec, Expr::Ident(array), index) {
                    pr_push(lines, msgs, line, "assigns through `[...]`, which panics when the index is out of bounds");
                }
                pr_expr(index, wrapping, safe_idx, safe_vec, line, lines, msgs);
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            }
            Stmt::Let(_, _, expr, _, _, _, _) => { pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs); }
            Stmt::LetTuple(_, expr, _) => { pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs); }
            Stmt::Assign(_, _, expr, _) => { pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs); }
            Stmt::Expr(expr, _) => { pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs); }
            Stmt::Return(value, _) => {
                match value {
                    OptBoxExpr::Some(e) => { pr_expr(box_expr_deref(e), wrapping, safe_idx, safe_vec, line, lines, msgs); }
                    OptBoxExpr::None => {}
                }
            }
            Stmt::Break(value, _) => {
                match value {
                    OptBoxExpr::Some(e) => { pr_expr(box_expr_deref(e), wrapping, safe_idx, safe_vec, line, lines, msgs); }
                    OptBoxExpr::None => {}
                }
            }
            Stmt::FieldAssign(object, _, _, expr, _) => {
                pr_expr(object, wrapping, safe_idx, safe_vec, line, lines, msgs);
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            }
            Stmt::DerefAssign(ptr_expr, _, expr, _) => {
                pr_expr(ptr_expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            }
            Stmt::If(cond, then_block, else_block, _) => {
                pr_expr(cond, wrapping, safe_idx, safe_vec, line, lines, msgs);
                pr_stmts(then_block, wrapping, safe_idx, safe_vec, lines, msgs);
                match else_block {
                    OptStmts::Some(b) => { pr_stmts(b, wrapping, safe_idx, safe_vec, lines, msgs); }
                    OptStmts::None => {}
                }
            }
            Stmt::While(cond, body, _) => {
                pr_expr(cond, wrapping, safe_idx, safe_vec, line, lines, msgs);
                pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs);
            }
            Stmt::For(var_name, iterator, body, _) => {
                pr_expr(iterator, wrapping, safe_idx, safe_vec, line, lines, msgs);
                var bound: str = pr_len_bound(iterator);
                if bound != "" && pr_disturbs(body, var_name, bound) { bound = ""; }
                if bound != "" {
                    safe_idx.push(var_name);
                    safe_vec.push(bound);
                }
                pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs);
                if bound != "" {
                    safe_idx.pop();
                    safe_vec.pop();
                }
            }
            Stmt::Match(expr, arms, _) => {
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
                var a: i64 = 0;
                while a < arms.len() {
                    pr_stmts(arms.get(a).body, wrapping, safe_idx, safe_vec, lines, msgs);
                    a = a + 1;
                }
            }
            Stmt::Loop(body, _) => { pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs); }
            Stmt::Unsafe(body, _) => { pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs); }
            Stmt::Sandbox(body, _) => { pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs); }
            Stmt::Txn(body, _) => { pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs); }
            Stmt::RegionBlock(_, _, _, _, _, body, _) => { pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs); }
            Stmt::Defer(body, _) => { pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs); }
            _ => {}
        }
        k = k + 1;
    }
}

// Whether `e` is plainly not an integer (string or float), so `+` cannot overflow-panic.
fn pr_non_integer(e: Expr) -> bool {
    match e {
        Expr::StringLit(_) => { return true; }
        Expr::FloatLit(_) => { return true; }
        Expr::StrConcat(_, _) => { return true; }
        Expr::FString(_) => { return true; }
        _ => { return false; }
    }
    return false;
}

fn pr_is_int_lit(e: Expr) -> bool {
    match e {
        Expr::IntLit(_) => { return true; }
        _ => { return false; }
    }
    return false;
}

fn pr_exprs(es: Vec<Expr>, wrapping: bool, safe_idx: &mut Vec<str>, safe_vec: &mut Vec<str>, line: i64, lines: &mut Vec<i64>, msgs: &mut Vec<str>) {
    var k: i64 = 0;
    while k < es.len() {
        pr_expr(es.get(k), wrapping, safe_idx, safe_vec, line, lines, msgs);
        k = k + 1;
    }
}

fn pr_expr(e: Expr, wrapping: bool, safe_idx: &mut Vec<str>, safe_vec: &mut Vec<str>, line: i64, lines: &mut Vec<i64>, msgs: &mut Vec<str>) {
    match e {
        Expr::Index(a, x) => {
            var arr: Expr = box_expr_deref(a);
            var index: Expr = box_expr_deref(x);
            if !pr_in_bounds(safe_idx, safe_vec, arr, index) {
                pr_push(lines, msgs, line, "indexes with `[...]`, which panics when the index is out of bounds");
            }
            pr_expr(arr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(index, wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::MethodCall(recv, method, args) => {
            var r: Expr = box_expr_deref(recv);
            var in_bounds: bool = false;
            if (method == "get" || method == "set") && args.len() > 0 {
                in_bounds = pr_in_bounds(safe_idx, safe_vec, r, args.get(0));
            }
            var panics: bool = method == "get" || method == "set" || method == "remove" || method == "pop" || method == "insert";
            if panics && !in_bounds {
                pr_push(lines, msgs, line, "calls `." + method + "()`, which panics when the index is out of bounds (or the Vec is empty); use `.get_or(i, default)` or loop over `0..v.len()`");
            }
            pr_expr(r, wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_exprs(args, wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Binary(op, l, r) => {
            var left: Expr = box_expr_deref(l);
            var right: Expr = box_expr_deref(r);
            var arith: bool = false;
            match op {
                BinOp::Add => { arith = true; }
                BinOp::Sub => { arith = true; }
                BinOp::Mul => { arith = true; }
                _ => {}
            }
            var constant: bool = pr_is_int_lit(left) && pr_is_int_lit(right);
            if arith && !wrapping && !constant && !pr_non_integer(left) && !pr_non_integer(right) {
                pr_push(lines, msgs, line, "uses integer `+`/`-`/`*`, which panics on overflow (mark the function @wrapping for two's-complement arithmetic)");
            }
            pr_expr(left, wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(right, wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Unary(_, x) => { pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::FieldAccess(x, _) => { pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::OptionalFieldAccess(x, _) => { pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::Ref(x, _) => { pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::Deref(x) => { pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::Try(x) => { pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::IsCheck(x, _) => { pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::Cast(x, _) => { pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::QuantCast(x, _) => { pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::Await(x) => { pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::Spawn(x) => { pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::StrConcat(l, r) => {
            pr_expr(box_expr_deref(l), wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(box_expr_deref(r), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Range(l, r, _) => {
            pr_expr(box_expr_deref(l), wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(box_expr_deref(r), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Coalesce(l, r) => {
            pr_expr(box_expr_deref(l), wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(box_expr_deref(r), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::PipeForward(l, r) => {
            pr_expr(box_expr_deref(l), wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(box_expr_deref(r), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Call(_, args) => { pr_exprs(args, wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::EnumLit(_, _, args) => { pr_exprs(args, wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::TupleLit(args) => { pr_exprs(args, wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::ArrayLit(_, args) => { pr_exprs(args, wrapping, safe_idx, safe_vec, line, lines, msgs); }
        Expr::StructLit(_, fields, _) => {
            var f: i64 = 0;
            while f < fields.len() {
                pr_expr(fields.get(f).value, wrapping, safe_idx, safe_vec, line, lines, msgs);
                f = f + 1;
            }
        }
        Expr::If(cond, then_block, else_block) => {
            pr_expr(box_expr_deref(cond), wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_stmts(then_block, wrapping, safe_idx, safe_vec, lines, msgs);
            match else_block {
                OptStmts::Some(b) => { pr_stmts(b, wrapping, safe_idx, safe_vec, lines, msgs); }
                OptStmts::None => {}
            }
        }
        Expr::Match(x, arms) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
            var a: i64 = 0;
            while a < arms.len() {
                pr_stmts(arms.get(a).body, wrapping, safe_idx, safe_vec, lines, msgs);
                a = a + 1;
            }
        }
        Expr::Block(b) => { pr_stmts(b, wrapping, safe_idx, safe_vec, lines, msgs); }
        Expr::TryBlock(b) => { pr_stmts(b, wrapping, safe_idx, safe_vec, lines, msgs); }
        Expr::Closure(_, b, _) => { pr_stmts(b, wrapping, safe_idx, safe_vec, lines, msgs); }
        _ => {}
    }
}

pub fn scan_for_division(stmts: Vec<Stmt>, sites: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_division(stmts.get(i), sites);
        i = i + 1;
    }
}

pub fn scan_stmt_for_division(stmt: Stmt, sites: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => { scan_expr_for_division(expr, sites); }
        Stmt::LetTuple(_, expr, _) => { scan_expr_for_division(expr, sites); }
        Stmt::Expr(e, _) => { scan_expr_for_division(e, sites); }
        Stmt::Assign(_, _, expr, _) => { scan_expr_for_division(expr, sites); }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            scan_expr_for_division(index, sites);
            scan_expr_for_division(expr, sites);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            scan_expr_for_division(ptr_expr, sites);
            scan_expr_for_division(expr, sites);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            scan_expr_for_division(object, sites);
            scan_expr_for_division(expr, sites);
        }
        Stmt::Return(opt_e, _) => {
            match opt_e {
                OptBoxExpr::Some(e) => { scan_expr_for_division(box_expr_unbox(e), sites); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            scan_expr_for_division(cond, sites);
            scan_stmts_for_division(then_block, sites);
            match else_block {
                OptStmts::Some(eb) => { scan_stmts_for_division(eb, sites); }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, _) => {
            scan_expr_for_division(cond, sites);
            scan_stmts_for_division(body, sites);
        }
        Stmt::For(_, iterator, body, _) => {
            scan_expr_for_division(iterator, sites);
            scan_stmts_for_division(body, sites);
        }
        Stmt::Loop(body, _) => { scan_stmts_for_division(body, sites); }
        Stmt::Defer(stmts, _) => { scan_stmts_for_division(stmts, sites); }
        Stmt::Match(expr, arms, _) => {
            scan_expr_for_division(expr, sites);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_division(arms.get(ai).body, sites);
                ai = ai + 1;
            }
        }
        Stmt::Handle(body, handlers, _) => {
            scan_stmts_for_division(body, sites);
            var hi: i64 = 0;
            while hi < handlers.len() {
                scan_stmts_for_division(handlers.get(hi).body, sites);
                hi = hi + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { scan_stmts_for_division(body, sites); }
        Stmt::Sandbox(body, _) => { scan_stmts_for_division(body, sites); }
        Stmt::Unsafe(body, _) => { scan_stmts_for_division(body, sites); }
        Stmt::Txn(body, _) => { scan_stmts_for_division(body, sites); }
        Stmt::ComptimeGen(block, _) => { scan_stmts_for_division(block, sites); }
        Stmt::GradBlock(_, body, _) => { scan_stmts_for_division(body, sites); }
        Stmt::Backward(loss, _) => { scan_expr_for_division(loss, sites); }
        _ => {}
    }
}

pub fn scan_stmts_for_division(stmts: Vec<Stmt>, sites: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_division(stmts.get(i), sites);
        i = i + 1;
    }
}

pub fn scan_expr_for_division(expr: Expr, sites: &mut Vec<str>) {
    match expr {
        Expr::Binary(op, left, right) => {
            var is_div: bool = false;
            var op_str: str = "";
            match op {
                BinOp::Div => { is_div = true; op_str = "/"; }
                BinOp::Mod => { is_div = true; op_str = "%"; }
                _ => {}
            }
            if is_div {
                // Check if divisor is a non-zero constant — if so, it's safe
                var is_safe: bool = false;
                match box_expr_unbox(right) {
                    Expr::IntLit(n) => { if n != 0 { is_safe = true; } }
                    _ => {}
                }
                if !is_safe {
                    sites.push(op_str);
                }
            }
            scan_expr_for_division(box_expr_unbox(left), sites);
            scan_expr_for_division(box_expr_unbox(right), sites);
        }
        Expr::Unary(_, e) => { scan_expr_for_division(box_expr_unbox(e), sites); }
        Expr::Call(_, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_division(args.get(ai), sites);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            scan_expr_for_division(box_expr_unbox(receiver), sites);
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_division(args.get(ai), sites);
                ai = ai + 1;
            }
        }
        Expr::FieldAccess(e, _) => { scan_expr_for_division(box_expr_unbox(e), sites); }
        Expr::OptionalFieldAccess(e, _) => { scan_expr_for_division(box_expr_unbox(e), sites); }
        Expr::Index(array, index) => {
            scan_expr_for_division(box_expr_unbox(array), sites);
            scan_expr_for_division(box_expr_unbox(index), sites);
        }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                scan_expr_for_division(fields.get(fi).value, sites);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { scan_expr_for_division(box_expr_unbox(s), sites); }
                OptBoxExpr::None => {}
            }
        }
        Expr::ArrayLit(_, elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                scan_expr_for_division(elements.get(ei), sites);
                ei = ei + 1;
            }
        }
        Expr::TupleLit(elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                scan_expr_for_division(elements.get(ei), sites);
                ei = ei + 1;
            }
        }
        Expr::Ref(e, _) => { scan_expr_for_division(box_expr_unbox(e), sites); }
        Expr::Deref(e) => { scan_expr_for_division(box_expr_unbox(e), sites); }
        Expr::Cast(e, _) => { scan_expr_for_division(box_expr_unbox(e), sites); }
        Expr::If(cond, then_block, else_block) => {
            scan_expr_for_division(box_expr_unbox(cond), sites);
            scan_stmts_for_division(then_block, sites);
            match else_block {
                OptStmts::Some(eb) => { scan_stmts_for_division(eb, sites); }
                OptStmts::None => {}
            }
        }
        Expr::Block(stmts) => { scan_stmts_for_division(stmts, sites); }
        Expr::Match(expr, arms) => {
            scan_expr_for_division(box_expr_unbox(expr), sites);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_division(arms.get(ai).body, sites);
                ai = ai + 1;
            }
        }
        Expr::StrConcat(left, right) => {
            scan_expr_for_division(box_expr_unbox(left), sites);
            scan_expr_for_division(box_expr_unbox(right), sites);
        }
        Expr::Try(e) => { scan_expr_for_division(box_expr_unbox(e), sites); }
        Expr::Coalesce(expr, default) => {
            scan_expr_for_division(box_expr_unbox(expr), sites);
            scan_expr_for_division(box_expr_unbox(default), sites);
        }
        Expr::IsCheck(e, _) => { scan_expr_for_division(box_expr_unbox(e), sites); }
        Expr::TryBlock(body) => { scan_stmts_for_division(body, sites); }
        Expr::Closure(_, body, _) => { scan_stmts_for_division(body, sites); }
        Expr::Comptime(e) => { scan_expr_for_division(box_expr_unbox(e), sites); }
        Expr::ComptimeBlock(stmts) => { scan_stmts_for_division(stmts, sites); }
        Expr::PipeForward(left, right) => {
            scan_expr_for_division(box_expr_unbox(left), sites);
            scan_expr_for_division(box_expr_unbox(right), sites);
        }
        Expr::QuantCast(e, _) => { scan_expr_for_division(box_expr_unbox(e), sites); }
        _ => {}
    }
}

// --- While loop scanning helpers ---

pub fn scan_for_while_loops(stmts: Vec<Stmt>, sites: &mut Vec<i64>) {
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_while(stmts.get(i), sites);
        i = i + 1;
    }
}

pub fn scan_stmt_for_while(stmt: Stmt, sites: &mut Vec<i64>) {
    match stmt {
        Stmt::While(cond, body, line) => {
            sites.push(line);
            scan_expr_for_while(cond, sites);
            scan_stmts_for_while(body, sites);
        }
        Stmt::If(cond, then_block, else_block, _) => {
            scan_expr_for_while(cond, sites);
            scan_stmts_for_while(then_block, sites);
            match else_block {
                OptStmts::Some(eb) => { scan_stmts_for_while(eb, sites); }
                OptStmts::None => {}
            }
        }
        Stmt::For(_, iterator, body, _) => {
            scan_expr_for_while(iterator, sites);
            scan_stmts_for_while(body, sites);
        }
        Stmt::Loop(body, _) => { scan_stmts_for_while(body, sites); }
        Stmt::Defer(stmts, _) => { scan_stmts_for_while(stmts, sites); }
        Stmt::Match(expr, arms, _) => {
            scan_expr_for_while(expr, sites);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_while(arms.get(ai).body, sites);
                ai = ai + 1;
            }
        }
        Stmt::Handle(body, handlers, _) => {
            scan_stmts_for_while(body, sites);
            var hi: i64 = 0;
            while hi < handlers.len() {
                scan_stmts_for_while(handlers.get(hi).body, sites);
                hi = hi + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { scan_stmts_for_while(body, sites); }
        Stmt::Sandbox(body, _) => { scan_stmts_for_while(body, sites); }
        Stmt::Unsafe(body, _) => { scan_stmts_for_while(body, sites); }
        Stmt::Txn(body, _) => { scan_stmts_for_while(body, sites); }
        Stmt::ComptimeGen(block, _) => { scan_stmts_for_while(block, sites); }
        Stmt::GradBlock(_, body, _) => { scan_stmts_for_while(body, sites); }
        _ => {}
    }
}

pub fn scan_stmts_for_while(stmts: Vec<Stmt>, sites: &mut Vec<i64>) {
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_while(stmts.get(i), sites);
        i = i + 1;
    }
}

pub fn scan_expr_for_while(expr: Expr, sites: &mut Vec<i64>) {
    match expr {
        Expr::Binary(_, left, right) => {
            scan_expr_for_while(box_expr_unbox(left), sites);
            scan_expr_for_while(box_expr_unbox(right), sites);
        }
        Expr::Unary(_, e) => { scan_expr_for_while(box_expr_unbox(e), sites); }
        Expr::Call(_, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_while(args.get(ai), sites);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            scan_expr_for_while(box_expr_unbox(receiver), sites);
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_while(args.get(ai), sites);
                ai = ai + 1;
            }
        }
        Expr::FieldAccess(e, _) => { scan_expr_for_while(box_expr_unbox(e), sites); }
        Expr::OptionalFieldAccess(e, _) => { scan_expr_for_while(box_expr_unbox(e), sites); }
        Expr::Index(array, index) => {
            scan_expr_for_while(box_expr_unbox(array), sites);
            scan_expr_for_while(box_expr_unbox(index), sites);
        }
        Expr::If(cond, then_block, else_block) => {
            scan_expr_for_while(box_expr_unbox(cond), sites);
            scan_stmts_for_while(then_block, sites);
            match else_block {
                OptStmts::Some(eb) => { scan_stmts_for_while(eb, sites); }
                OptStmts::None => {}
            }
        }
        Expr::Block(stmts) => { scan_stmts_for_while(stmts, sites); }
        Expr::Match(expr, arms) => {
            scan_expr_for_while(box_expr_unbox(expr), sites);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_while(arms.get(ai).body, sites);
                ai = ai + 1;
            }
        }
        Expr::TryBlock(body) => { scan_stmts_for_while(body, sites); }
        Expr::Closure(_, body, _) => { scan_stmts_for_while(body, sites); }
        Expr::Comptime(e) => { scan_expr_for_while(box_expr_unbox(e), sites); }
        Expr::ComptimeBlock(stmts) => { scan_stmts_for_while(stmts, sites); }
        _ => {}
    }
}

pub fn TypeChecker_verify_constant_time(self: &mut TypeChecker, program: Program) {
    // @constant_time: constant-time execution (side-channel resistance).
    // Rejects IO/Net effects, calls to non-constant-time functions, early
    // returns, and branches, loops, short-circuits, memory indexing or
    // division that depend on secret data (every parameter not @public).
    var ct_names: Vec<str> = Vec::new();
    var ci: i64 = 0;
    while ci < program.funcs.len() {
        if ct_has_annotation(program.funcs.get(ci).annotations, "constant_time") { ct_names.push(program.funcs.get(ci).name); }
        ci = ci + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            if ct_has_annotation(imp.methods.get(mi).annotations, "constant_time") { ct_names.push(imp.struct_name + "_" + imp.methods.get(mi).name); }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if ct_has_annotation(func.annotations, "constant_time") {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Constant-time error: function '" + func.name + "' is @constant_time but has effect '!" + eff + "'");
                }
                ei = ei + 1;
            }
            // Only other @constant_time functions (and runtime builtins) may be called.
            var calls: Vec<str> = Vec::new();
            scan_stmts_for_calls(func.body, &mut calls);
            var ki: i64 = 0;
            while ki < calls.len() {
                var called: str = calls.get(ki);
                var is_user: bool = false;
                match TypeChecker_lookup_func_cache(self, called) {
                    OptFuncSig::Some(_) => { is_user = true; }
                    OptFuncSig::None => {}
                }
                if is_user && !str_vec_contains(ct_names, called) && !str_starts_with(called, "p_") && !str_starts_with(called, "__") {
                    self.errors.push("Security error (constant_time): function '" + func.name + "' calls '" + called + "', which is not @constant_time.");
                }
                ki = ki + 1;
            }
            var ret_lines: Vec<i64> = Vec::new();
            ct_scan_early_returns(func.body, &mut ret_lines);
            var ri: i64 = 0;
            while ri < ret_lines.len() {
                self.errors.push("Security error (constant_time) (line " + int_to_str(ret_lines.get(ri)) + "): function '" + func.name + "' has an early return.");
                ri = ri + 1;
            }
            var out_lines: Vec<i64> = Vec::new();
            var out_msgs: Vec<str> = Vec::new();
            ct_secret_dependence(func, &mut out_lines, &mut out_msgs);
            var oi: i64 = 0;
            while oi < out_lines.len() {
                self.errors.push("Security error (constant_time) (line " + int_to_str(out_lines.get(oi)) + "): function '" + func.name + "' " + out_msgs.get(oi) + ".");
                oi = oi + 1;
            }
        }
        fi = fi + 1;
    }
}

fn ct_has_annotation(anns: Vec<Annotation>, name: str) -> bool {
    var i: i64 = 0;
    while i < anns.len() {
        if anns.get(i).name == name { return true; }
        i = i + 1;
    }
    return false;
}

// Any `return` inside a branch or loop, or before the last statement.
fn ct_scan_early_returns(stmts: Vec<Stmt>, lines: &mut Vec<i64>) {
    var i: i64 = 0;
    while i < stmts.len() {
        var s: Stmt = stmts.get(i);
        match s {
            Stmt::Return(_, line) => {
                if i < stmts.len() - 1 { lines.push(line); }
            }
            _ => { ct_scan_nested_returns(s, lines); }
        }
        i = i + 1;
    }
}

fn ct_scan_nested_returns(s: Stmt, lines: &mut Vec<i64>) {
    match s {
        Stmt::Return(_, line) => { lines.push(line); }
        Stmt::If(_, then_block, else_block, _) => {
            ct_scan_nested_returns_all(then_block, lines);
            match else_block {
                OptStmts::Some(b) => { ct_scan_nested_returns_all(b, lines); }
                OptStmts::None => {}
            }
        }
        Stmt::Match(_, arms, _) => {
            var ai: i64 = 0;
            while ai < arms.len() {
                ct_scan_nested_returns_all(arms.get(ai).body, lines);
                ai = ai + 1;
            }
        }
        Stmt::For(_, _, body, _) => { ct_scan_nested_returns_all(body, lines); }
        Stmt::While(_, body, _) => { ct_scan_nested_returns_all(body, lines); }
        Stmt::Loop(body, _) => { ct_scan_nested_returns_all(body, lines); }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { ct_scan_nested_returns_all(body, lines); }
        Stmt::Sandbox(body, _) => { ct_scan_nested_returns_all(body, lines); }
        Stmt::Unsafe(body, _) => { ct_scan_nested_returns_all(body, lines); }
        Stmt::Txn(body, _) => { ct_scan_nested_returns_all(body, lines); }
        _ => {}
    }
}

fn ct_scan_nested_returns_all(stmts: Vec<Stmt>, lines: &mut Vec<i64>) {
    var i: i64 = 0;
    while i < stmts.len() {
        ct_scan_nested_returns(stmts.get(i), lines);
        i = i + 1;
    }
}

// Secret-dependent timing: one (line, what) per branch, loop, short-circuit,
// memory index or division whose operand depends on a parameter not marked
// @public. Lengths (`x.len()`) are public.
fn ct_secret_dependence(func: Func, out_lines: &mut Vec<i64>, out_msgs: &mut Vec<str>) {
    var secret: Vec<str> = Vec::new();
    var pi: i64 = 0;
    while pi < func.params.len() {
        var p: Param = func.params.get(pi);
        if !ct_has_annotation(p.annotations, "public") { secret.push(p.name); }
        pi = pi + 1;
    }
    // Values computed from secrets are secret (flow-insensitive, to a fixpoint).
    var before: i64 = -1;
    while before != secret.len() {
        before = secret.len();
        ct_propagate(func.body, &mut secret);
    }
    ct_check_stmts(func.body, secret, out_lines, out_msgs);
}

fn ct_mark(secret: &mut Vec<str>, name: str) {
    if !str_vec_contains(secret, name) { secret.push(name); }
}

// Whether `e` mentions a secret variable outside a length query.
fn ct_secret(e: Expr, secret: Vec<str>) -> bool {
    match e {
        Expr::Ident(n) => { return str_vec_contains(secret, n); }
        Expr::MethodCall(recv, method, args) => {
            if method == "len" { return false; }
            return ct_secret(box_expr_deref(recv), secret) || ct_any_secret(args, secret);
        }
        Expr::Call(callee, args) => {
            if callee == "len" || str_ends_with(callee, "_len") { return false; }
            return ct_any_secret(args, secret);
        }
        Expr::Binary(_, l, r) => { return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret); }
        Expr::StrConcat(l, r) => { return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret); }
        Expr::Range(l, r, _) => { return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret); }
        Expr::Coalesce(l, r) => { return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret); }
        Expr::PipeForward(l, r) => { return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret); }
        Expr::Index(l, r) => { return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret); }
        Expr::Unary(_, x) => { return ct_secret(box_expr_deref(x), secret); }
        Expr::FieldAccess(x, _) => { return ct_secret(box_expr_deref(x), secret); }
        Expr::OptionalFieldAccess(x, _) => { return ct_secret(box_expr_deref(x), secret); }
        Expr::Ref(x, _) => { return ct_secret(box_expr_deref(x), secret); }
        Expr::Deref(x) => { return ct_secret(box_expr_deref(x), secret); }
        Expr::Try(x) => { return ct_secret(box_expr_deref(x), secret); }
        Expr::IsCheck(x, _) => { return ct_secret(box_expr_deref(x), secret); }
        Expr::Cast(x, _) => { return ct_secret(box_expr_deref(x), secret); }
        Expr::QuantCast(x, _) => { return ct_secret(box_expr_deref(x), secret); }
        Expr::Await(x) => { return ct_secret(box_expr_deref(x), secret); }
        Expr::Spawn(x) => { return ct_secret(box_expr_deref(x), secret); }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                if ct_secret(fields.get(fi).value, secret) { return true; }
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(sp) => { return ct_secret(box_expr_deref(sp), secret); }
                OptBoxExpr::None => {}
            }
            return false;
        }
        Expr::EnumLit(_, _, args) => { return ct_any_secret(args, secret); }
        Expr::TupleLit(args) => { return ct_any_secret(args, secret); }
        Expr::ArrayLit(_, args) => { return ct_any_secret(args, secret); }
        Expr::If(cond, then_block, else_block) => {
            if ct_secret(box_expr_deref(cond), secret) || ct_stmts_secret(then_block, secret) { return true; }
            match else_block {
                OptStmts::Some(b) => { return ct_stmts_secret(b, secret); }
                OptStmts::None => {}
            }
            return false;
        }
        Expr::Match(x, arms) => {
            if ct_secret(box_expr_deref(x), secret) { return true; }
            var ai: i64 = 0;
            while ai < arms.len() {
                if ct_stmts_secret(arms.get(ai).body, secret) { return true; }
                ai = ai + 1;
            }
            return false;
        }
        Expr::Block(b) => { return ct_stmts_secret(b, secret); }
        Expr::TryBlock(b) => { return ct_stmts_secret(b, secret); }
        Expr::Closure(_, b, _) => { return ct_stmts_secret(b, secret); }
        Expr::FString(parts) => {
            var pi: i64 = 0;
            while pi < parts.len() {
                var part: FStringPart = parts.get(pi);
                match part {
                    FStringPart::Expr(x2) => { if ct_secret(x2, secret) { return true; } }
                    FStringPart::Literal(_) => {}
                }
                pi = pi + 1;
            }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

fn ct_any_secret(es: Vec<Expr>, secret: Vec<str>) -> bool {
    var i: i64 = 0;
    while i < es.len() {
        if ct_secret(es.get(i), secret) { return true; }
        i = i + 1;
    }
    return false;
}

// Whether the value of `stmts` (their last expression) mentions a secret.
fn ct_stmts_secret(stmts: Vec<Stmt>, secret: Vec<str>) -> bool {
    if stmts.len() == 0 { return false; }
    match stmts.get(stmts.len() - 1) {
        Stmt::Expr(e, _) => { return ct_secret(e, secret); }
        _ => { return false; }
    }
    return false;
}

// The variable a place expression writes into ("" for none).
fn ct_base(e: Expr) -> str {
    match e {
        Expr::Ident(n) => { return n; }
        Expr::FieldAccess(x, _) => { return ct_base(box_expr_deref(x)); }
        Expr::Deref(x) => { return ct_base(box_expr_deref(x)); }
        Expr::Index(x, _) => { return ct_base(box_expr_deref(x)); }
        _ => { return ""; }
    }
    return "";
}

fn ct_propagate(stmts: Vec<Stmt>, secret: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        var s: Stmt = stmts.get(i);
        match s {
            Stmt::Let(name, _, expr, _, _, _, _) => { if ct_secret(expr, secret) { ct_mark(secret, name); } }
            Stmt::LetTuple(names, expr, _) => {
                if ct_secret(expr, secret) {
                    var ni: i64 = 0;
                    while ni < names.len() {
                        ct_mark(secret, names.get(ni));
                        ni = ni + 1;
                    }
                }
            }
            Stmt::Assign(target, _, expr, _) => { if ct_secret(expr, secret) { ct_mark(secret, target); } }
            Stmt::IndexAssign(array, index, _, expr, _) => {
                if ct_secret(expr, secret) || ct_secret(index, secret) { ct_mark(secret, array); }
            }
            Stmt::FieldAssign(object, _, _, expr, _) => {
                if ct_secret(expr, secret) && ct_base(object) != "" { ct_mark(secret, ct_base(object)); }
            }
            Stmt::DerefAssign(ptr_expr, _, expr, _) => {
                if ct_secret(expr, secret) && ct_base(ptr_expr) != "" { ct_mark(secret, ct_base(ptr_expr)); }
            }
            Stmt::Expr(e, _) => {
                // A mutating method stores its arguments in its receiver.
                match e {
                    Expr::MethodCall(recv, method, args) => {
                        var rb: str = ct_base(box_expr_deref(recv));
                        if method != "len" && ct_any_secret(args, secret) && rb != "" { ct_mark(secret, rb); }
                    }
                    _ => {}
                }
            }
            Stmt::For(var_name, iterator, body, _) => {
                if ct_secret(iterator, secret) { ct_mark(secret, var_name); }
                ct_propagate(body, secret);
            }
            Stmt::Match(expr, arms, _) => {
                var sm: bool = ct_secret(expr, secret);
                var ai: i64 = 0;
                while ai < arms.len() {
                    var arm: MatchArm = arms.get(ai);
                    if sm {
                        match arm.pattern {
                            Pattern::Ident(n) => { ct_mark(secret, n); }
                            Pattern::EnumVariant(_, _, bindings) => {
                                var bi: i64 = 0;
                                while bi < bindings.len() {
                                    ct_mark(secret, bindings.get(bi).name);
                                    bi = bi + 1;
                                }
                            }
                            _ => {}
                        }
                    }
                    ct_propagate(arm.body, secret);
                    ai = ai + 1;
                }
            }
            Stmt::If(_, then_block, else_block, _) => {
                ct_propagate(then_block, secret);
                match else_block {
                    OptStmts::Some(b) => { ct_propagate(b, secret); }
                    OptStmts::None => {}
                }
            }
            Stmt::While(_, body, _) => { ct_propagate(body, secret); }
            Stmt::Loop(body, _) => { ct_propagate(body, secret); }
            Stmt::Unsafe(body, _) => { ct_propagate(body, secret); }
            Stmt::Sandbox(body, _) => { ct_propagate(body, secret); }
            Stmt::Txn(body, _) => { ct_propagate(body, secret); }
            Stmt::RegionBlock(_, _, _, _, _, body, _) => { ct_propagate(body, secret); }
            Stmt::Defer(body, _) => { ct_propagate(body, secret); }
            _ => {}
        }
        i = i + 1;
    }
}

fn ct_push(out_lines: &mut Vec<i64>, out_msgs: &mut Vec<str>, line: i64, what: str) {
    var i: i64 = 0;
    while i < out_lines.len() {
        if out_lines.get(i) == line && out_msgs.get(i) == what { return; }
        i = i + 1;
    }
    out_lines.push(line);
    out_msgs.push(what);
}

fn ct_check_stmts(stmts: Vec<Stmt>, secret: Vec<str>, out_lines: &mut Vec<i64>, out_msgs: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        var s: Stmt = stmts.get(i);
        var line: i64 = stmt_line(s);
        match s {
            Stmt::If(cond, then_block, else_block, _) => {
                if ct_secret(cond, secret) { ct_push(out_lines, out_msgs, line, "branches on secret data (`if`)"); }
                ct_check_expr(cond, secret, line, out_lines, out_msgs);
                ct_check_stmts(then_block, secret, out_lines, out_msgs);
                match else_block {
                    OptStmts::Some(b) => { ct_check_stmts(b, secret, out_lines, out_msgs); }
                    OptStmts::None => {}
                }
            }
            Stmt::While(cond, body, _) => {
                if ct_secret(cond, secret) { ct_push(out_lines, out_msgs, line, "loops on secret data (`while` condition)"); }
                ct_check_expr(cond, secret, line, out_lines, out_msgs);
                ct_check_stmts(body, secret, out_lines, out_msgs);
            }
            Stmt::For(_, iterator, body, _) => {
                if ct_secret(iterator, secret) { ct_push(out_lines, out_msgs, line, "loops over secret data (`for`)"); }
                ct_check_expr(iterator, secret, line, out_lines, out_msgs);
                ct_check_stmts(body, secret, out_lines, out_msgs);
            }
            Stmt::Match(expr, arms, _) => {
                if ct_secret(expr, secret) { ct_push(out_lines, out_msgs, line, "branches on secret data (`match`)"); }
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
                var ai: i64 = 0;
                while ai < arms.len() {
                    ct_check_stmts(arms.get(ai).body, secret, out_lines, out_msgs);
                    ai = ai + 1;
                }
            }
            Stmt::IndexAssign(_, index, _, expr, _) => {
                if ct_secret(index, secret) { ct_push(out_lines, out_msgs, line, "indexes memory with secret data"); }
                ct_check_expr(index, secret, line, out_lines, out_msgs);
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
            }
            Stmt::Let(_, _, expr, _, _, _, _) => { ct_check_expr(expr, secret, line, out_lines, out_msgs); }
            Stmt::LetTuple(_, expr, _) => { ct_check_expr(expr, secret, line, out_lines, out_msgs); }
            Stmt::Assign(_, _, expr, _) => { ct_check_expr(expr, secret, line, out_lines, out_msgs); }
            Stmt::Expr(expr, _) => { ct_check_expr(expr, secret, line, out_lines, out_msgs); }
            Stmt::Return(value, _) => {
                match value {
                    OptBoxExpr::Some(e) => { ct_check_expr(box_expr_deref(e), secret, line, out_lines, out_msgs); }
                    OptBoxExpr::None => {}
                }
            }
            Stmt::Break(value, _) => {
                match value {
                    OptBoxExpr::Some(e) => { ct_check_expr(box_expr_deref(e), secret, line, out_lines, out_msgs); }
                    OptBoxExpr::None => {}
                }
            }
            Stmt::FieldAssign(object, _, _, expr, _) => {
                ct_check_expr(object, secret, line, out_lines, out_msgs);
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
            }
            Stmt::DerefAssign(ptr_expr, _, expr, _) => {
                ct_check_expr(ptr_expr, secret, line, out_lines, out_msgs);
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
            }
            Stmt::Loop(body, _) => { ct_check_stmts(body, secret, out_lines, out_msgs); }
            Stmt::Unsafe(body, _) => { ct_check_stmts(body, secret, out_lines, out_msgs); }
            Stmt::Sandbox(body, _) => { ct_check_stmts(body, secret, out_lines, out_msgs); }
            Stmt::Txn(body, _) => { ct_check_stmts(body, secret, out_lines, out_msgs); }
            Stmt::RegionBlock(_, _, _, _, _, body, _) => { ct_check_stmts(body, secret, out_lines, out_msgs); }
            Stmt::Defer(body, _) => { ct_check_stmts(body, secret, out_lines, out_msgs); }
            _ => {}
        }
        i = i + 1;
    }
}

fn ct_check_exprs(es: Vec<Expr>, secret: Vec<str>, line: i64, out_lines: &mut Vec<i64>, out_msgs: &mut Vec<str>) {
    var i: i64 = 0;
    while i < es.len() {
        ct_check_expr(es.get(i), secret, line, out_lines, out_msgs);
        i = i + 1;
    }
}

fn ct_check_expr(e: Expr, secret: Vec<str>, line: i64, out_lines: &mut Vec<i64>, out_msgs: &mut Vec<str>) {
    match e {
        Expr::Binary(op, l, r) => {
            var left: Expr = box_expr_deref(l);
            var right: Expr = box_expr_deref(r);
            var either: bool = ct_secret(left, secret) || ct_secret(right, secret);
            if either {
                match op {
                    BinOp::And => { ct_push(out_lines, out_msgs, line, "short-circuits on secret data (`&&`/`||`; use `&`/`|`)"); }
                    BinOp::Or => { ct_push(out_lines, out_msgs, line, "short-circuits on secret data (`&&`/`||`; use `&`/`|`)"); }
                    BinOp::Div => { ct_push(out_lines, out_msgs, line, "divides secret data (`/` or `%` take variable time on most CPUs)"); }
                    BinOp::Mod => { ct_push(out_lines, out_msgs, line, "divides secret data (`/` or `%` take variable time on most CPUs)"); }
                    _ => {}
                }
            }
            ct_check_expr(left, secret, line, out_lines, out_msgs);
            ct_check_expr(right, secret, line, out_lines, out_msgs);
        }
        Expr::Index(a, x) => {
            var index: Expr = box_expr_deref(x);
            if ct_secret(index, secret) { ct_push(out_lines, out_msgs, line, "indexes memory with secret data"); }
            ct_check_expr(box_expr_deref(a), secret, line, out_lines, out_msgs);
            ct_check_expr(index, secret, line, out_lines, out_msgs);
        }
        Expr::MethodCall(recv, method, args) => {
            var indexes: bool = method == "get" || method == "set" || method == "remove" || method == "insert" || method == "get_or";
            if indexes && args.len() > 0 && ct_secret(args.get(0), secret) {
                ct_push(out_lines, out_msgs, line, "indexes memory with secret data");
            }
            ct_check_expr(box_expr_deref(recv), secret, line, out_lines, out_msgs);
            ct_check_exprs(args, secret, line, out_lines, out_msgs);
        }
        Expr::If(cond, then_block, else_block) => {
            var c: Expr = box_expr_deref(cond);
            if ct_secret(c, secret) { ct_push(out_lines, out_msgs, line, "branches on secret data (`if`)"); }
            ct_check_expr(c, secret, line, out_lines, out_msgs);
            ct_check_stmts(then_block, secret, out_lines, out_msgs);
            match else_block {
                OptStmts::Some(b) => { ct_check_stmts(b, secret, out_lines, out_msgs); }
                OptStmts::None => {}
            }
        }
        Expr::Match(x, arms) => {
            var scrut: Expr = box_expr_deref(x);
            if ct_secret(scrut, secret) { ct_push(out_lines, out_msgs, line, "branches on secret data (`match`)"); }
            ct_check_expr(scrut, secret, line, out_lines, out_msgs);
            var ai: i64 = 0;
            while ai < arms.len() {
                ct_check_stmts(arms.get(ai).body, secret, out_lines, out_msgs);
                ai = ai + 1;
            }
        }
        Expr::Unary(_, x) => { ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs); }
        Expr::FieldAccess(x, _) => { ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs); }
        Expr::OptionalFieldAccess(x, _) => { ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs); }
        Expr::Ref(x, _) => { ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs); }
        Expr::Deref(x) => { ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs); }
        Expr::Try(x) => { ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs); }
        Expr::IsCheck(x, _) => { ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs); }
        Expr::Cast(x, _) => { ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs); }
        Expr::QuantCast(x, _) => { ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs); }
        Expr::Await(x) => { ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs); }
        Expr::Spawn(x) => { ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs); }
        Expr::StrConcat(l, r) => {
            ct_check_expr(box_expr_deref(l), secret, line, out_lines, out_msgs);
            ct_check_expr(box_expr_deref(r), secret, line, out_lines, out_msgs);
        }
        Expr::Range(l, r, _) => {
            ct_check_expr(box_expr_deref(l), secret, line, out_lines, out_msgs);
            ct_check_expr(box_expr_deref(r), secret, line, out_lines, out_msgs);
        }
        Expr::Coalesce(l, r) => {
            ct_check_expr(box_expr_deref(l), secret, line, out_lines, out_msgs);
            ct_check_expr(box_expr_deref(r), secret, line, out_lines, out_msgs);
        }
        Expr::PipeForward(l, r) => {
            ct_check_expr(box_expr_deref(l), secret, line, out_lines, out_msgs);
            ct_check_expr(box_expr_deref(r), secret, line, out_lines, out_msgs);
        }
        Expr::Call(_, args) => { ct_check_exprs(args, secret, line, out_lines, out_msgs); }
        Expr::EnumLit(_, _, args) => { ct_check_exprs(args, secret, line, out_lines, out_msgs); }
        Expr::TupleLit(args) => { ct_check_exprs(args, secret, line, out_lines, out_msgs); }
        Expr::ArrayLit(_, args) => { ct_check_exprs(args, secret, line, out_lines, out_msgs); }
        Expr::StructLit(_, fields, _) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                ct_check_expr(fields.get(fi).value, secret, line, out_lines, out_msgs);
                fi = fi + 1;
            }
        }
        Expr::Block(b) => { ct_check_stmts(b, secret, out_lines, out_msgs); }
        Expr::TryBlock(b) => { ct_check_stmts(b, secret, out_lines, out_msgs); }
        Expr::Closure(_, b, _) => { ct_check_stmts(b, secret, out_lines, out_msgs); }
        _ => {}
    }
}

/// Calls forbidden in @realtime code: allocation, blocking IO, spawning,
/// dynamic dispatch (the lists of src/typechecker.rs verify_realtime).
fn tc_rt_forbidden_call(c: str) -> bool {
    var names: str = " p_malloc p_free p_realloc p_alloc p_vec_new p_vec_push p_vec_push_str p_vec_insert p_vec_resize p_vec_extend p_hashmap_new p_hashmap_insert p_string_new p_string_push p_string_concat p_arena_new p_arena_alloc Vec_new Vec_push Vec_insert Vec_resize HashMap_new HashMap_insert String_new String_push push insert resize extend push_str p_file_read p_file_write p_file_open p_file_close p_socket_listen p_socket_accept p_socket_read p_socket_write p_socket_connect p_socket_close p_net_connect p_net_listen p_net_accept p_fs_read_async p_fs_write_async p_print p_print_int p_print_str p_eprint_str p_print_nl print println print_str print_nl print_int p_db_open p_db_query p_db_exec p_sleep p_usleep p_thread_spawn p_chan_send p_chan_recv p_executor_submit p_future_ready spawn p_make_dyn p_call_ptr p_dyn_call ";
    return str_contains(names, " " + c + " ");
}

pub fn TypeChecker_verify_realtime(self: &mut TypeChecker, program: Program) {
    // @realtime: real-time deadline guarantee
    // Rejects IO/Net/Spawn effects that could block indefinitely.
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_rt: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "realtime" { is_rt = true; }
            ai = ai + 1;
        }
        if is_rt {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" {
                    self.errors.push("Realtime error: function '" + func.name + "' is @realtime but has effect '!" + eff + "' which may block");
                }
                ei = ei + 1;
            }
            // Calls that allocate, block, spawn, dispatch dynamically or
            // recurse (src/typechecker.rs verify_realtime rules 1-5).
            var calls: Vec<str> = Vec::new();
            scan_stmts_for_calls(func.body, &mut calls);
            var while_sites: Vec<i64> = Vec::new();
            scan_for_while_loops(func.body, &mut while_sites);
            if while_sites.len() > 0 {
                self.errors.push("Real-time error: function '" + func.name + "' contains a 'while' loop. While loops have unbounded iteration counts.");
            }
            var reported: Vec<str> = Vec::new();
            var ci: i64 = 0;
            while ci < calls.len() {
                var c: str = calls.get(ci);
                if !tc_str_vec_contains(reported, c) && (tc_rt_forbidden_call(c) || c == func.name) {
                    reported.push(c);
                    if c == func.name {
                        self.errors.push("Real-time error: function '" + func.name + "' calls itself. Recursion has unbounded stack depth.");
                    } else {
                        self.errors.push("Real-time error: function '" + func.name + "' calls '" + c + "'.");
                    }
                }
                ci = ci + 1;
            }
        }
        fi = fi + 1;
    }
}

pub fn TypeChecker_verify_differentiable(self: &mut TypeChecker, program: Program) {
    // @differentiable: autodiff compatibility
    // Rejects IO/Net/Spawn/Diverge effects that break the computation graph.
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_diff: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "differentiable" { is_diff = true; }
            ai = ai + 1;
        }
        if is_diff {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Differentiability error: function '" + func.name + "' is @differentiable but has effect '!" + eff + "'");
                }
                ei = ei + 1;
            }
        }
        fi = fi + 1;
    }
}

/// The body of the function or (unmangled) method `name`, if any.
fn tc_body_by_name(program: Program, name: str, out: &mut Vec<StmtList>) -> bool {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        if program.funcs.get(fi).name == name { out.push(program.funcs.get(fi).body); return true; }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            if imp.methods.get(mi).name == name { out.push(imp.methods.get(mi).body); return true; }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(ti);
        var tmi: i64 = 0;
        while tmi < timp.methods.len() {
            if timp.methods.get(tmi).name == name { out.push(timp.methods.get(tmi).body); return true; }
            tmi = tmi + 1;
        }
        ti = ti + 1;
    }
    return false;
}

/// Whether `start` reaches dequantize_q8 through calls (src/typechecker.rs).
fn tc_transitively_calls_dequant(program: Program, start: str) -> bool {
    var visited: Vec<str> = Vec::new();
    var stack: Vec<str> = Vec::new();
    stack.push(start);
    while stack.len() > 0 {
        var cur: str = stack.pop();
        if !tc_str_vec_contains(visited, cur) {
            visited.push(cur);
            var body: Vec<StmtList> = Vec::new();
            if tc_body_by_name(program, cur, &mut body) {
                var calls: Vec<str> = Vec::new();
                scan_stmts_for_calls(body.get(0), &mut calls);
                var ci: i64 = 0;
                while ci < calls.len() {
                    var c: str = calls.get(ci);
                    if c == "dequantize_q8" || c == "p_dequantize_q8" { return true; }
                    stack.push(c);
                    ci = ci + 1;
                }
            }
        }
    }
    return false;
}

pub fn TypeChecker_verify_quantized(self: &mut TypeChecker, program: Program) {
    // @quantized: quantization annotation
    // Rejects IO/Net/Spawn/Diverge effects (same as @differentiable).
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_quant: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "quantized" { is_quant = true; }
            ai = ai + 1;
        }
        if is_quant {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Quantization error: function '" + func.name + "' is @quantized but has effect '!" + eff + "'");
                }
                ei = ei + 1;
            }
            // Dequantizing inside a @quantized function defeats it.
            if tc_transitively_calls_dequant(program, func.name) {
                self.errors.push("Quantization error: function '" + func.name + "' is @quantized but (transitively) calls dequantize_q8.");
            }
        }
        fi = fi + 1;
    }
}

fn tc_anns_have(anns: Vec<Annotation>, name: str) -> bool {
    var i: i64 = 0;
    while i < anns.len() {
        if anns.get(i).name == name { return true; }
        i = i + 1;
    }
    return false;
}

pub fn TypeChecker_verify_checkpoint(self: &mut TypeChecker, program: Program) {
    // @checkpoint: gradient checkpointing
    // A @checkpoint function must also be @differentiable.
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_checkpoint: bool = false;
        var is_differentiable: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            var ann_name: str = func.annotations.get(ai).name;
            if ann_name == "checkpoint" { is_checkpoint = true; }
            if ann_name == "differentiable" { is_differentiable = true; }
            ai = ai + 1;
        }
        if is_checkpoint && !is_differentiable {
            self.errors.push("Checkpoint error: function '" + func.name + "' is @checkpoint but not @differentiable");
        }
        // Recompute in the backward pass must give the same values.
        if is_checkpoint && !tc_anns_have(func.annotations, "deterministic") {
            self.errors.push("Checkpoint error: function '" + func.name + "' is @checkpoint but not @deterministic. Fix: add @deterministic annotation to '" + func.name + "'.");
        }
        fi = fi + 1;
    }
}

pub fn TypeChecker_verify_dp(self: &mut TypeChecker, program: Program) {
    // @dp: differential privacy
    // Rejects IO/Net/Spawn/Diverge effects.
    // Also validates epsilon values and composes epsilon across @dp callees.

    // Parse epsilon from @dp(epsilon=N) annotation.
    var dp_names: Vec<str> = Vec::new();
    var dp_epsilons: Vec<f64> = Vec::new();
    var dp_call_names: Vec<str> = Vec::new();
    var dp_call_offsets: Vec<i64> = Vec::new();
    var dp_call_flat: Vec<str> = Vec::new();

    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_dp: bool = false;
        var epsilon: f64 = 0.0;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            var ann: Annotation = func.annotations.get(ai);
            if ann.name == "dp" {
                is_dp = true;
                // Parse epsilon=N from args (simple parser — handles N.M format)
                var argi: i64 = 0;
                while argi < ann.args.len() {
                    var arg: str = ann.args.get(argi);
                    if str_starts_with(arg, "epsilon=") {
                        var val_str: str = str_slice(arg, 8, str_len(arg));
                        epsilon = dp_parse_float(val_str);
                    }
                    argi = argi + 1;
                }
            }
            ai = ai + 1;
        }
        if is_dp {
            // Validate epsilon is positive
            if epsilon <= 0.0 {
                self.errors.push("Differential privacy error: function '" + func.name + "' has @dp(epsilon=" + float_to_str(epsilon) + ") — epsilon must be positive");
            }
            dp_names.push(func.name);
            dp_epsilons.push(epsilon);
        }
        // Build call graph entry for this function
        var calls: Vec<str> = Vec::new();
        scan_stmts_for_calls(func.body, &mut calls);
        dp_call_names.push(func.name);
        dp_call_offsets.push(dp_call_flat.len());
        var ci: i64 = 0;
        while ci < calls.len() {
            dp_call_flat.push(calls.get(ci));
            ci = ci + 1;
        }

        // Check effects
        if is_dp {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            // DP needs noise added to the data/gradients.
            if !str_vec_contains_ref(effects, "Noise") {
                self.errors.push("Differential privacy error: function '" + func.name + "' is @dp but has no '!Noise' effect.");
            }
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("DP error: function '" + func.name + "' is @dp but has effect '!" + eff + "'");
                }
                ei = ei + 1;
            }
        }
        fi = fi + 1;
    }

    // Epsilon composition: for each @dp function, compute total epsilon
    // (own + transitive @dp callees) and reject if it exceeds declared.
    var nri: i64 = 0;
    while nri < dp_names.len() {
        var target: str = dp_names.get(nri);
        var declared: f64 = dp_epsilons.get(nri);
        // DFS to sum epsilon of all @dp callees reachable from target
        var visited: Vec<str> = Vec::new();
        var total: f64 = dp_compute_total_epsilon(target, dp_names, dp_epsilons, dp_call_names, dp_call_offsets, dp_call_flat, &mut visited);
        if total > declared {
            self.errors.push("Differential privacy error: function '" + target + "' declares @dp(epsilon=" + float_to_str(declared) + ") but total epsilon across @dp callees is " + float_to_str(total));
        }
        nri = nri + 1;
    }
}

// Simple float parser for DP epsilon values (handles N.M format).
fn dp_parse_float(s: str) -> f64 {
    var result: f64 = 0.0;
    var i: i64 = 0;
    var negative: bool = false;
    if str_len(s) > 0 && str_byte_at(s, 0) == 45 {
        negative = true;
        i = 1;
    }
    var int_part: f64 = 0.0;
    while i < str_len(s) {
        var b: i64 = str_byte_at(s, i);
        if b >= 48 && b <= 57 {
            int_part = int_part * 10.0 + (b - 48) as f64;
        } else {
            i = i + 1;
            break;
        }
        i = i + 1;
    }
    var frac_part: f64 = 0.0;
    var frac_div: f64 = 10.0;
    while i < str_len(s) {
        var b: i64 = str_byte_at(s, i);
        if b >= 48 && b <= 57 {
            frac_part = frac_part + (b - 48) as f64 / frac_div;
            frac_div = frac_div * 10.0;
        } else {
            break;
        }
        i = i + 1;
    }
    result = int_part + frac_part;
    if negative { result = -result; }
    return result;
}

// Compute total epsilon (own + transitive @dp callees) via DFS.
fn dp_compute_total_epsilon(target: str, dp_names: Vec<str>, dp_epsilons: Vec<f64>, cg_names: Vec<str>, cg_offsets: Vec<i64>, cg_calls: Vec<str>, visited: &mut Vec<str>) -> f64 {
    // Check if already visited (cycle)
    var vi: i64 = 0;
    while vi < visited.len() {
        if visited.get(vi) == target { return 0.0; }
        vi = vi + 1;
    }
    visited.push(target);

    // Find target's epsilon
    var own: f64 = 0.0;
    var found: bool = false;
    var ni: i64 = 0;
    while ni < dp_names.len() {
        if dp_names.get(ni) == target {
            own = dp_epsilons.get(ni);
            found = true;
            ni = dp_names.len();
        }
        ni = ni + 1;
    }

    // Find target's callees in the call graph
    var target_idx: i64 = -1;
    ni = 0;
    while ni < cg_names.len() {
        if cg_names.get(ni) == target { target_idx = ni; }
        ni = ni + 1;
    }
    if target_idx < 0 { return own; }

    var start: i64 = cg_offsets.get(target_idx);
    var end: i64 = 0;
    if target_idx + 1 < cg_offsets.len() {
        end = cg_offsets.get(target_idx + 1);
    } else {
        end = cg_calls.len();
    }

    var callee_eps: f64 = 0.0;
    var ci: i64 = start;
    while ci < end {
        var callee: str = cg_calls.get(ci);
        // Only sum if callee is a @dp function
        var is_dp: bool = false;
        ni = 0;
        while ni < dp_names.len() {
            if dp_names.get(ni) == callee { is_dp = true; }
            ni = ni + 1;
        }
        if is_dp {
            callee_eps = callee_eps + dp_compute_total_epsilon(callee, dp_names, dp_epsilons, cg_names, cg_offsets, cg_calls, visited);
        }
        ci = ci + 1;
    }

    return own + callee_eps;
}

pub fn TypeChecker_verify_shard(self: &mut TypeChecker, program: Program) {
    // @shard: tensor parallelism
    // Rejects IO/Net/Spawn/Diverge effects.
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_shard: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "shard" { is_shard = true; }
            ai = ai + 1;
        }
        if is_shard {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            if !str_vec_contains_ref(effects, "Comm") {
                self.errors.push("Shard error: function '" + func.name + "' is @shard but has no '!Comm' effect.");
            }
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Shard error: function '" + func.name + "' is @shard but has effect '!" + eff + "'");
                }
                ei = ei + 1;
            }
        }
        fi = fi + 1;
    }
}

pub fn TypeChecker_verify_adapter(self: &mut TypeChecker, program: Program) {
    // @adapter: adapter pattern (ML model adaptation)
    // A @adapter function must have at least one parameter (the base model).
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_adapter: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "adapter" { is_adapter = true; }
            ai = ai + 1;
        }
        if is_adapter {
            if func.params.len() == 0 {
                self.errors.push("Adapter error: function '" + func.name + "' is @adapter but has no parameters");
            }
        }
        fi = fi + 1;
    }
}

/// Whether a type is, or holds, a @scoped struct (release M11).
pub fn TypeChecker_mentions_scoped(self: &TypeChecker, t: Type) -> bool {
    match t {
        Type::Named(n) => { return str_vec_contains(self.scoped_structs, n); }
        Type::Generic(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                if TypeChecker_mentions_scoped(self, args.get(i)) { return true; }
                i = i + 1;
            }
        }
        Type::Ref(inner, _) => { return TypeChecker_mentions_scoped(self, box_type_unbox(inner)); }
        Type::Array(e, _) => { return TypeChecker_mentions_scoped(self, box_type_unbox(e)); }
        Type::Tuple(ts) => {
            var j: i64 = 0;
            while j < ts.len() {
                if TypeChecker_mentions_scoped(self, ts.get(j)) { return true; }
                j = j + 1;
            }
        }
        _ => {}
    }
    return false;
}

/// A @scoped struct lives only for its scope (release M11): it may be a
/// parameter or a local, never a field, a global, an element type or a
/// function result, so nothing keeps it (or the strings it borrows) longer.
pub fn TypeChecker_verify_scoped(self: &mut TypeChecker, program: Program) {
    if self.scoped_structs.len() == 0 { return; }
    var si: i64 = 0;
    while si < program.structs.len() {
        var sd: StructDef = program.structs.get(si);
        var fi: i64 = 0;
        while fi < sd.fields.len() {
            if TypeChecker_mentions_scoped(self, sd.fields.get(fi).ty) {
                self.errors.push("Borrow error: field '" + sd.fields.get(fi).name + "' of struct '" + sd.name + "' holds a @scoped struct, which cannot be kept.");
            }
            fi = fi + 1;
        }
        si = si + 1;
    }
    var gi: i64 = 0;
    while gi < program.globals.len() {
        if TypeChecker_mentions_scoped(self, program.globals.get(gi).ty) {
            self.errors.push("Borrow error: global '" + program.globals.get(gi).name + "' holds a @scoped struct, which cannot be kept.");
        }
        gi = gi + 1;
    }
    var fni: i64 = 0;
    while fni < program.funcs.len() {
        var f: Func = program.funcs.get(fni);
        if TypeChecker_mentions_scoped(self, f.ret_ty) {
            self.errors.push("Borrow error: function '" + f.name + "' returns a @scoped struct, which cannot outlive its scope.");
        }
        var pi: i64 = 0;
        while pi < f.params.len() {
            match f.params.get(pi).ty {
                Type::Generic(_, _) => {
                    if TypeChecker_mentions_scoped(self, f.params.get(pi).ty) {
                        self.errors.push("Borrow error: parameter '" + f.params.get(pi).name + "' of '" + f.name + "' holds @scoped structs in a collection, which cannot be kept.");
                    }
                }
                _ => {}
            }
            pi = pi + 1;
        }
        fni = fni + 1;
    }
}

pub fn TypeChecker_verify_tainted(self: &mut TypeChecker, program: Program) {
    // @tainted: taint tracking
    // Rejects IO effects that could leak tainted data.
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_tainted: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "tainted" { is_tainted = true; }
            ai = ai + 1;
        }
        // A @tainted parameter taints the function (release L1: only the
        // function's own annotations were read).
        var pi: i64 = 0;
        while pi < func.params.len() {
            var pa: Vec<Annotation> = func.params.get(pi).annotations;
            var pj: i64 = 0;
            while pj < pa.len() {
                if pa.get(pj).name == "tainted" { is_tainted = true; }
                pj = pj + 1;
            }
            pi = pi + 1;
        }
        if is_tainted {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" {
                    self.errors.push("Taint error: function '" + func.name + "' is @tainted but has effect '!" + eff + "' which could leak tainted data");
                }
                ei = ei + 1;
            }
        }
        fi = fi + 1;
    }
}

pub fn TypeChecker_verify_contracts(self: &mut TypeChecker, program: Program) {
    // `given` preconditions (F10): a call whose constant arguments make a
    // precondition false is rejected at compile time (src/typechecker.rs
    // verify_contracts; non-constant arguments are left to runtime).
    var pre_names: Vec<str> = Vec::new();
    var pre_funcs: Vec<Func> = Vec::new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if func.preconditions.len() > 0 {
            pre_names.push(func.name);
            pre_funcs.push(func);
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            if imp.methods.get(mi).preconditions.len() > 0 {
                pre_names.push(imp.struct_name + "_" + imp.methods.get(mi).name);
                pre_funcs.push(imp.methods.get(mi));
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    if pre_names.len() == 0 { return; }
    var bodies: Vec<StmtList> = Vec::new();
    var bi: i64 = 0;
    while bi < program.funcs.len() {
        bodies.push(program.funcs.get(bi).body);
        bi = bi + 1;
    }
    var ii2: i64 = 0;
    while ii2 < program.impls.len() {
        var imp2: ImplDef = program.impls.get(ii2);
        var mi2: i64 = 0;
        while mi2 < imp2.methods.len() {
            bodies.push(imp2.methods.get(mi2).body);
            mi2 = mi2 + 1;
        }
        ii2 = ii2 + 1;
    }
    var k: i64 = 0;
    while k < bodies.len() {
        var callees: Vec<str> = Vec::new();
        var argss: Vec<Vec<Expr>> = Vec::new();
        cs_stmts(bodies.get(k), &mut callees, &mut argss);
        var ci: i64 = 0;
        while ci < callees.len() {
            var pi: i64 = 0;
            while pi < pre_names.len() {
                if pre_names.get(pi) == callees.get(ci) {
                    var pf: Func = pre_funcs.get(pi);
                    var bnames: Vec<str> = Vec::new();
                    var bvals: Vec<i64> = Vec::new();
                    var args: Vec<Expr> = argss.get(ci);
                    var ai: i64 = 0;
                    while ai < pf.params.len() && ai < args.len() {
                        var cv: Vec<i64> = Vec::new();
                        if ct_eval_int(args.get(ai), Vec::new(), Vec::new(), &mut cv) {
                            bnames.push(pf.params.get(ai).name);
                            bvals.push(cv.get(0));
                        }
                        ai = ai + 1;
                    }
                    var qi: i64 = 0;
                    while qi < pf.preconditions.len() {
                        // 1 = true, 0 = false, -1 = unknown
                        if ct_eval_bool(pf.preconditions.get(qi), bnames, bvals) == 0 {
                            self.errors.push("Contract error (F10): precondition violated in call to '" + callees.get(ci) + "'. The 'given' contract is not satisfied with the provided arguments.");
                        }
                        qi = qi + 1;
                    }
                }
                pi = pi + 1;
            }
            ci = ci + 1;
        }
        k = k + 1;
    }
}

/// Collect the direct calls (callee, args) in statements, at any depth.
fn cs_stmts(stmts: Vec<Stmt>, callees: &mut Vec<str>, argss: &mut Vec<Vec<Expr>>) {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Let(_, _, e, _, _, _, _) => { cs_expr(e, callees, argss); }
            Stmt::LetTuple(_, e, _) => { cs_expr(e, callees, argss); }
            Stmt::Expr(e, _) => { cs_expr(e, callees, argss); }
            Stmt::Assign(_, _, e, _) => { cs_expr(e, callees, argss); }
            Stmt::IndexAssign(_, ix, _, e, _) => { cs_expr(ix, callees, argss); cs_expr(e, callees, argss); }
            Stmt::DerefAssign(pe, _, e, _) => { cs_expr(pe, callees, argss); cs_expr(e, callees, argss); }
            Stmt::FieldAssign(o, _, _, e, _) => { cs_expr(o, callees, argss); cs_expr(e, callees, argss); }
            Stmt::Return(oe, _) => {
                match oe {
                    OptBoxExpr::Some(re) => { cs_expr(box_expr_unbox(re), callees, argss); }
                    OptBoxExpr::None => {}
                }
            }
            Stmt::If(c, tb, eb, _) => {
                cs_expr(c, callees, argss);
                cs_stmts(tb, callees, argss);
                match eb {
                    OptStmts::Some(e2) => { cs_stmts(e2, callees, argss); }
                    OptStmts::None => {}
                }
            }
            Stmt::While(c, b, _) => { cs_expr(c, callees, argss); cs_stmts(b, callees, argss); }
            Stmt::For(_, it, b, _) => { cs_expr(it, callees, argss); cs_stmts(b, callees, argss); }
            Stmt::Loop(b, _) => { cs_stmts(b, callees, argss); }
            Stmt::Defer(b, _) => { cs_stmts(b, callees, argss); }
            Stmt::Match(e, arms, _) => {
                cs_expr(e, callees, argss);
                var ai: i64 = 0;
                while ai < arms.len() {
                    cs_stmts(arms.get(ai).body, callees, argss);
                    ai = ai + 1;
                }
            }
            _ => {}
        }
        i = i + 1;
    }
}

fn cs_exprs(es: Vec<Expr>, callees: &mut Vec<str>, argss: &mut Vec<Vec<Expr>>) {
    var i: i64 = 0;
    while i < es.len() {
        cs_expr(es.get(i), callees, argss);
        i = i + 1;
    }
}

fn cs_expr(expr: Expr, callees: &mut Vec<str>, argss: &mut Vec<Vec<Expr>>) {
    match expr {
        Expr::Call(callee, args) => {
            callees.push(callee);
            argss.push(args);
            cs_exprs(args, callees, argss);
        }
        Expr::MethodCall(recv, _, args) => { cs_expr(box_expr_unbox(recv), callees, argss); cs_exprs(args, callees, argss); }
        Expr::Binary(_, l, r) => { cs_expr(box_expr_unbox(l), callees, argss); cs_expr(box_expr_unbox(r), callees, argss); }
        Expr::Unary(_, e) => { cs_expr(box_expr_unbox(e), callees, argss); }
        Expr::FieldAccess(e, _) => { cs_expr(box_expr_unbox(e), callees, argss); }
        Expr::Index(a, ix) => { cs_expr(box_expr_unbox(a), callees, argss); cs_expr(box_expr_unbox(ix), callees, argss); }
        Expr::If(c, tb, eb) => {
            cs_expr(box_expr_unbox(c), callees, argss);
            cs_stmts(tb, callees, argss);
            match eb {
                OptStmts::Some(e2) => { cs_stmts(e2, callees, argss); }
                OptStmts::None => {}
            }
        }
        Expr::Block(b) => { cs_stmts(b, callees, argss); }
        _ => {}
    }
}

/// Constant integer value of `expr` under the bindings (pushed to `out`).
fn ct_eval_int(expr: Expr, bnames: Vec<str>, bvals: Vec<i64>, out: &mut Vec<i64>) -> bool {
    match expr {
        Expr::IntLit(n) => { out.push(n); return true; }
        Expr::Ident(name) => {
            var i: i64 = 0;
            while i < bnames.len() {
                if bnames.get(i) == name { out.push(bvals.get(i)); return true; }
                i = i + 1;
            }
            return false;
        }
        Expr::Unary(op, e) => {
            if unaryop_eq(op, UnaryOp::Neg) {
                var v: Vec<i64> = Vec::new();
                if ct_eval_int(box_expr_unbox(e), bnames, bvals, &mut v) { out.push(0 - v.get(0)); return true; }
            }
            return false;
        }
        Expr::Binary(op, l, r) => {
            var lv: Vec<i64> = Vec::new();
            var rv: Vec<i64> = Vec::new();
            if !ct_eval_int(box_expr_unbox(l), bnames, bvals, &mut lv) { return false; }
            if !ct_eval_int(box_expr_unbox(r), bnames, bvals, &mut rv) { return false; }
            var a: i64 = lv.get(0);
            var b: i64 = rv.get(0);
            if binop_eq(op, BinOp::Add) { out.push(a + b); return true; }
            if binop_eq(op, BinOp::Sub) { out.push(a - b); return true; }
            if binop_eq(op, BinOp::Mul) { out.push(a * b); return true; }
            if binop_eq(op, BinOp::Div) && b != 0 { out.push(a / b); return true; }
            if binop_eq(op, BinOp::Mod) && b != 0 { out.push(a % b); return true; }
            return false;
        }
        _ => {}
    }
    return false;
}

/// 1 = true, 0 = false, -1 = unknown.
fn ct_eval_bool(expr: Expr, bnames: Vec<str>, bvals: Vec<i64>) -> i64 {
    match expr {
        Expr::BoolLit(bv) => { if bv { return 1; } return 0; }
        Expr::Binary(op, l, r) => {
            if binop_eq(op, BinOp::And) {
                var lb: i64 = ct_eval_bool(box_expr_unbox(l), bnames, bvals);
                if lb < 0 { return -1; }
                if lb == 0 { return 0; }
                return ct_eval_bool(box_expr_unbox(r), bnames, bvals);
            }
            if binop_eq(op, BinOp::Or) {
                var lb2: i64 = ct_eval_bool(box_expr_unbox(l), bnames, bvals);
                if lb2 < 0 { return -1; }
                if lb2 == 1 { return 1; }
                return ct_eval_bool(box_expr_unbox(r), bnames, bvals);
            }
            var lv: Vec<i64> = Vec::new();
            var rv: Vec<i64> = Vec::new();
            if !ct_eval_int(box_expr_unbox(l), bnames, bvals, &mut lv) { return -1; }
            if !ct_eval_int(box_expr_unbox(r), bnames, bvals, &mut rv) { return -1; }
            var a: i64 = lv.get(0);
            var b: i64 = rv.get(0);
            var res: bool = false;
            if binop_eq(op, BinOp::Lt) { res = a < b; }
            else if binop_eq(op, BinOp::Gt) { res = a > b; }
            else if binop_eq(op, BinOp::LtEq) { res = a <= b; }
            else if binop_eq(op, BinOp::GtEq) { res = a >= b; }
            else if binop_eq(op, BinOp::Eq) { res = a == b; }
            else if binop_eq(op, BinOp::Neq) { res = a != b; }
            else { return -1; }
            if res { return 1; }
            return 0;
        }
        _ => {}
    }
    return -1;
}

pub fn TypeChecker_verify_allocator_params(self: &mut TypeChecker, program: Program) {
    // @allocator: custom allocator parameters
    // Verifies that @allocator annotated functions have valid allocator params.
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            var ann: Annotation = func.annotations.get(ai);
            if ann.name == "allocator" {
                // @allocator requires at least one arg (the allocator name or type)
                if ann.args.len() == 0 {
                    self.errors.push("Allocator error: function '" + func.name + "' has @allocator but no allocator parameter specified");
                }
            }
            ai = ai + 1;
        }
        fi = fi + 1;
    }
}

// --- check_func ----------------------------------------------------------

/// `@unsafe fn` is one `unsafe` block around the whole body.
/// CE6: true the first time an undefined `name` is met in this function.
fn TypeChecker_first_report(self: &mut TypeChecker, name: str) -> bool {
    val key: str = self.checking_fn + ":" + name;
    if str_vec_contains(self.reported_undefined, key) { return false; }
    self.reported_undefined.push(key);
    return true;
}

pub fn TypeChecker_check_func(self: &mut TypeChecker, func: Func) {
    var whole: bool = false;
    var ai: i64 = 0;
    while ai < func.annotations.len() {
        if func.annotations.get(ai).name == "unsafe" { whole = true; }
        ai = ai + 1;
    }
    self.checking_fn = func.name;
    if whole { self.unsafe_depth = self.unsafe_depth + 1; }
    TypeChecker_check_func_body(self, func);
    if whole { self.unsafe_depth = self.unsafe_depth - 1; }
}

fn TypeChecker_check_func_body(self: &mut TypeChecker, func: Func) {
    self.current_func_name = OptString::Some(func.name);
    var empty_ret: Vec<Type> = Vec::new();
    self.current_return_types = empty_ret;
    var saved_ret_ty: OptType = self.current_ret_ty;
    self.current_ret_ty = OptType::None;
    match func.ret_ty {
        Type::Infer => {}
        _ => {
            var declared_ret: Type = TypeChecker_resolve_self_type(self, func.ret_ty);
            // async fn: the body returns T for a declared Future<T>
            if func.is_async {
                match declared_ret {
                    Type::Generic(gname, gargs) => {
                        if gname == "Future" && gargs.len() == 1 { declared_ret = gargs.get(0); }
                    }
                    _ => {}
                }
            }
            self.current_ret_ty = OptType::Some(declared_ret);
        }
    }
    // Set current_module to the module where this function was defined
    var saved_module: str = self.current_module;
    var mangled: str = "";
    match self.current_self_type {
        OptString::Some(s) => { mangled = s + "_" + func.name; }
        OptString::None => { mangled = ""; }
    }
    if mangled != "" {
        match TypeChecker_get_item_module(self, mangled) {
            OptString::Some(mod_name) => { self.current_module = mod_name; }
            OptString::None => {
                match TypeChecker_get_item_module(self, func.name) {
                    OptString::Some(mod_name) => { self.current_module = mod_name; }
                    OptString::None => {}
                }
            }
        }
    } else {
        match TypeChecker_get_item_module(self, func.name) {
            OptString::Some(mod_name) => { self.current_module = mod_name; }
            OptString::None => {}
        }
        // A synthesized __eq_S belongs to S's module (as a derive expands in
        // place), so it may read S's private fields
        if str_starts_with(func.name, "__eq_") {
            match TypeChecker_get_item_module(self, str_slice(func.name, 5, str_len(func.name))) {
                OptString::Some(eq_mod) => { self.current_module = eq_mod; }
                OptString::None => {}
            }
        }
    }
    // Reset linear tracking
    var saved_consumed: Vec<str> = self.consumed_vars;
    var empty_consumed: Vec<str> = Vec::new();
    self.consumed_vars = empty_consumed;
    TypeChecker_push_scope(self);
    // Track type parameters
    var saved_vp_names: Vec<str> = self.value_param_names;
    var saved_vp_types: Vec<Type> = self.value_param_types;
    var vp_names: Vec<str> = Vec::new();
    var vp_types: Vec<Type> = Vec::new();
    var vpi: i64 = 0;
    while vpi < func.params.len() {
        var vpt: Type = TypeChecker_resolve_type(self, func.params.get(vpi).ty);
        var aggregate: bool = false;
        match vpt {
            Type::Generic(gn, _) => { aggregate = gn == "Vec" || gn == "HashMap"; }
            Type::Named(nn) => { aggregate = nn == "Vec" || nn == "HashMap" || tc_is_struct(self, nn); }
            _ => {}
        }
        if aggregate && func.params.get(vpi).name != "self" {
            vp_names.push(func.params.get(vpi).name);
            vp_types.push(func.params.get(vpi).ty);
        }
        vpi = vpi + 1;
    }
    self.value_param_names = vp_names;
    self.value_param_types = vp_types;
    // (an impl method also sees its impl's: `impl<T> Slot` puts T in scope)
    var saved_tp: Vec<str> = self.current_type_params;
    var tps: Vec<str> = Vec::new();
    var tpi0: i64 = 0;
    while tpi0 < saved_tp.len() {
        tps.push(saved_tp.get(tpi0));
        tpi0 = tpi0 + 1;
    }
    tpi0 = 0;
    while tpi0 < func.type_params.len() {
        tps.push(func.type_params.get(tpi0));
        tpi0 = tpi0 + 1;
    }
    self.current_type_params = tps;
    // Track trait bounds
    var saved_bounds: Vec<StringString> = self.current_type_param_bounds;
    var empty_bounds: Vec<StringString> = Vec::new();
    self.current_type_param_bounds = empty_bounds;
    var bi: i64 = 0;
    while bi < func.type_param_bounds.len() {
        var bound: StrPair = func.type_param_bounds.get(bi);
        self.current_type_param_bounds.push(StringString_new(bound.a, bound.b));
        bi = bi + 1;
    }
    // Declare const generic params
    var cpi: i64 = 0;
    while cpi < func.const_params.len() {
        var cp: StrPair = func.const_params.get(cpi);
        var ty: Type = Type::I64;
        var ty_name: str = cp.b;
        if ty_name == "i8" { ty = Type::I8; }
        else if ty_name == "i16" { ty = Type::I16; }
        else if ty_name == "i32" { ty = Type::I32; }
        else if ty_name == "i64" { ty = Type::I64; }
        else if ty_name == "u8" { ty = Type::U8; }
        else if ty_name == "u16" { ty = Type::U16; }
        else if ty_name == "u32" { ty = Type::U32; }
        else if ty_name == "u64" { ty = Type::U64; }
        else { ty = Type::I64; }
        TypeChecker_declare(self, cp.a, ty);
        cpi = cpi + 1;
    }
    // Declare parameters
    var pi: i64 = 0;
    while pi < func.params.len() {
        var resolved_ty: Type = TypeChecker_resolve_self_type(self, func.params.get(pi).ty);
        TypeChecker_declare(self, func.params.get(pi).name, resolved_ty);
        pi = pi + 1;
    }
    // Check body statements
    var si: i64 = 0;
    while si < func.body.len() {
        TypeChecker_check_stmt(self, func.body.get(si));
        si = si + 1;
    }
    // Bidirectional type inference: if return type is _, infer from body
    if type_eq(func.ret_ty, Type::Infer) {
        var inferred: Type = Type::Void;
        var ri: i64 = 0;
        while ri < self.current_return_types.len() {
            var rt: Type = self.current_return_types.get(ri);
            if !type_eq(rt, Type::Void) && !type_eq(rt, Type::Never) {
                inferred = rt;
                break;
            }
            ri = ri + 1;
        }
        // Update function signature in symbol table
        var fi: i64 = 0;
        while fi < self.funcs.len() {
            if self.funcs.get(fi).key == func.name {
                var f_entry: StringFuncSig = self.funcs.get(fi);
                f_entry.val.ret_ty = inferred;
                self.funcs.set(fi, f_entry);
                break;
            }
            fi = fi + 1;
        }
    }
    // Restore state
    self.current_type_params = saved_tp;
    self.value_param_names = saved_vp_names;
    self.value_param_types = saved_vp_types;
    self.current_type_param_bounds = saved_bounds;
    TypeChecker_pop_scope(self);
    // A function declared to return a value must not fall off the end of its
    // body (mirrors src/typechecker.rs).
    match self.current_ret_ty {
        OptType::Some(declared) => {
            var returns_value: bool = true;
            match declared {
                Type::Void => { returns_value = false; }
                Type::Never => { returns_value = false; }
                Type::Infer => { returns_value = false; }
                _ => {}
            }
            if returns_value && func.name != "main" && !stmts_always_leave(func.body) {
                self.errors.push("Type error: '" + func.name + "' is declared to return " + type_to_str(declared) + " but can reach the end of its body without returning");
            }
        }
        OptType::None => {}
    }
    self.consumed_vars = saved_consumed;
    self.current_module = saved_module;
    self.current_ret_ty = saved_ret_ty;
    self.current_func_name = OptString::None;
}

// Whether control can never reach the end of `stmts`: it ends in `return`, a
// trailing expression (the block's value), an if/else or match whose branches
// all leave, an infinite loop without `break`, or a block that always leaves.
pub fn stmts_always_leave(stmts: Vec<Stmt>) -> bool {
    if stmts.len() == 0 { return false; }
    match stmts.get(stmts.len() - 1) {
        Stmt::Return(_, _) => { return true; }
        Stmt::Expr(_, _) => { return true; }
        Stmt::If(_, then_block, else_block, _) => {
            match else_block {
                OptStmts::Some(eb) => { return stmts_always_leave(then_block) && stmts_always_leave(eb); }
                OptStmts::None => { return false; }
            }
        }
        Stmt::Match(_, arms, _) => {
            if arms.len() == 0 { return false; }
            var ai: i64 = 0;
            while ai < arms.len() {
                if !stmts_always_leave(arms.get(ai).body) { return false; }
                ai = ai + 1;
            }
            return true;
        }
        Stmt::Loop(body, _) => { return !stmts_have_break(body); }
        Stmt::While(cond, body, _) => {
            match cond {
                Expr::BoolLit(b) => { return b && !stmts_have_break(body); }
                _ => { return false; }
            }
        }
        Stmt::Unsafe(body, _) => { return stmts_always_leave(body); }
        Stmt::Sandbox(body, _) => { return stmts_always_leave(body); }
        Stmt::Txn(body, _) => { return stmts_always_leave(body); }
        Stmt::Handle(body, _, _) => { return stmts_always_leave(body); }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { return stmts_always_leave(body); }
        _ => { return false; }
    }
    return false;
}

// A `break` that exits the loop whose body is `stmts` (breaks inside nested
// loops belong to those loops).
pub fn stmts_have_break(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Break(_, _) => { return true; }
            Stmt::If(_, then_block, else_block, _) => {
                if stmts_have_break(then_block) { return true; }
                match else_block {
                    OptStmts::Some(eb) => { if stmts_have_break(eb) { return true; } }
                    OptStmts::None => {}
                }
            }
            Stmt::Match(_, arms, _) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    if stmts_have_break(arms.get(ai).body) { return true; }
                    ai = ai + 1;
                }
            }
            Stmt::Unsafe(body, _) => { if stmts_have_break(body) { return true; } }
            Stmt::Sandbox(body, _) => { if stmts_have_break(body) { return true; } }
            Stmt::Txn(body, _) => { if stmts_have_break(body) { return true; } }
            Stmt::Handle(body, _, _) => { if stmts_have_break(body) { return true; } }
            Stmt::RegionBlock(_, _, _, _, _, body, _) => { if stmts_have_break(body) { return true; } }
            Stmt::SpawnScope(body, _) => { if stmts_have_break(body) { return true; } }
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

// --- Scope operations ----------------------------------------------------

pub fn TypeChecker_push_scope(self: &mut TypeChecker) {
    self.scopes.push(Vec::new());
    self.scope_linear_vars.push(Vec::new());
    self.val_vars_per_scope.push(Vec::new());
}

pub fn TypeChecker_pop_scope(self: &mut TypeChecker) {
    // Clean up val_vars for this scope
    if self.val_vars_per_scope.len() > 0 {
        self.val_vars_per_scope.pop();
    }
    // Check that all linear variables in this scope were consumed
    if self.scope_linear_vars.len() > 0 {
        var linear_vars: Vec<LinearVar> = self.scope_linear_vars.pop();
        var i: i64 = 0;
        while i < linear_vars.len() {
            var lv: LinearVar = linear_vars.get(i);
            if !tc_str_vec_contains(self.consumed_vars, lv.name) {
                self.errors.push("Linear type error (line " + int_to_str(lv.line) + "): variable '" + lv.name + "' is linear but was never consumed.");
            }
            i = i + 1;
        }
    }
    if self.scopes.len() > 0 {
        self.scopes.pop();
    }
}

pub fn TypeChecker_declare(self: &mut TypeChecker, name: str, ty: Type) {
    if self.scopes.len() > 0 {
        var scope: Vec<ScopeEntry> = self.scopes.pop();
        scope.push(ScopeEntry_new(name, ty));
        self.scopes.push(scope);
    } else {
        var scope: Vec<ScopeEntry> = Vec::new();
        scope.push(ScopeEntry_new(name, ty));
        self.scopes.push(scope);
    }
}

pub fn TypeChecker_lookup(self: &TypeChecker, name: str) -> OptType {
    var i: i64 = self.scopes.len() - 1;
    while i >= 0 {
        var scope: Vec<ScopeEntry> = self.scopes.get(i);
        var j: i64 = 0;
        while j < scope.len() {
            if scope.get(j).key == name {
                return OptType::Some(scope.get(j).val);
            }
            j = j + 1;
        }
        i = i - 1;
    }
    return OptType::None;
}

// --- Type utilities ------------------------------------------------------

pub fn TypeChecker_resolve_type(self: &TypeChecker, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            // OPTIMIZATION: use cached alias lookup instead of O(n) linear scan
            match TypeChecker_lookup_alias_cache(self, name) {
                OptType::Some(alias) => { return TypeChecker_resolve_type(self, alias); }
                OptType::None => { return ty; }
            }
            return ty;
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(TypeChecker_resolve_type(self, box_type_unbox(inner))), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(Box::new(TypeChecker_resolve_type(self, box_type_unbox(inner))), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(TypeChecker_resolve_type(self, box_type_unbox(elem))), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(TypeChecker_resolve_type(self, box_type_unbox(elem))), size_param);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(TypeChecker_resolve_type(self, args.get(i)));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(TypeChecker_resolve_type(self, types.get(i)));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        _ => { return ty; }
    }
    return ty;
}

pub fn TypeChecker_subst_type_params(ty: Type, subst: Vec<StringType>) -> Type {
    match ty {
        Type::Named(name) => {
            var i: i64 = 0;
            while i < subst.len() {
                if subst.get(i).key == name {
                    return subst.get(i).val;
                }
                i = i + 1;
            }
            return ty;
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(TypeChecker_subst_type_params(box_type_unbox(elem), subst)), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(TypeChecker_subst_type_params(box_type_unbox(elem), subst)), size_param);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(TypeChecker_subst_type_params(box_type_unbox(inner), subst)), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(Box::new(TypeChecker_subst_type_params(box_type_unbox(inner), subst)), is_mut);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(TypeChecker_subst_type_params(args.get(i), subst));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(TypeChecker_subst_type_params(types.get(i), subst));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        _ => { return ty; }
    }
    return ty;
}

pub fn TypeChecker_resolve_self_type(self: &TypeChecker, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            if name == "Self" {
                match self.current_self_type {
                    OptString::Some(s) => { return Type::Named(s); }
                    OptString::None => { return ty; }
                }
            }
            return ty;
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(TypeChecker_resolve_self_type(self, box_type_unbox(inner))), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(TypeChecker_resolve_self_type(self, box_type_unbox(elem))), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(TypeChecker_resolve_self_type(self, box_type_unbox(elem))), size_param);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(TypeChecker_resolve_self_type(self, args.get(i)));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(TypeChecker_resolve_self_type(self, types.get(i)));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        _ => { return ty; }
    }
    return ty;
}

pub fn TypeChecker_resolve_assoc_in_type(self: &TypeChecker, ty: Type, type_param: str, trait_name: str) -> Type {
    match ty {
        Type::Named(name) => {
            // Check if this name is an associated type of the trait
            match map_str_vecstr_get(self.trait_assoc_types, trait_name) {
                OptVecStr::Some(assoc_types) => {
                    if tc_str_vec_contains(assoc_types, name) {
                        return Type::Assoc(type_param, trait_name, name, Vec::new());
                    }
                }
                OptVecStr::None => {}
            }
            return ty;
        }
        Type::Assoc(_, _, name, args) => {
            return Type::Assoc(type_param, trait_name, name, args);
        }
        _ => { return ty; }
    }
    return ty;
}

pub fn TypeChecker_resolve_struct_name(self: &TypeChecker, name: str) -> str {
    // OPTIMIZATION: use cached alias lookup
    match TypeChecker_lookup_alias_cache(self, name) {
        OptType::Some(alias) => {
            match alias {
                Type::Named(inner) => { return TypeChecker_resolve_struct_name(self, inner); }
                _ => { return name; }
            }
            return name;
        }
        OptType::None => { return name; }
    }
    return name;
}

pub fn TypeChecker_is_numeric(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::Infer => { return true; }
        Type::I8 => { return true; }
        Type::I16 => { return true; }
        Type::I32 => { return true; }
        Type::I64 => { return true; }
        Type::I128 => { return true; }
        Type::U8 => { return true; }
        Type::U16 => { return true; }
        Type::U32 => { return true; }
        Type::U64 => { return true; }
        Type::U128 => { return true; }
        Type::F32 => { return true; }
        Type::F64 => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn TypeChecker_is_integer(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::Infer => { return true; }
        Type::I8 => { return true; }
        Type::I16 => { return true; }
        Type::I32 => { return true; }
        Type::I64 => { return true; }
        Type::I128 => { return true; }
        Type::U8 => { return true; }
        Type::U16 => { return true; }
        Type::U32 => { return true; }
        Type::U64 => { return true; }
        Type::U128 => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn TypeChecker_is_float(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::F32 => { return true; }
        Type::F64 => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn TypeChecker_is_typed_string(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::Named(name) => {
            if name == "SQLString" { return true; }
            if name == "ShellString" { return true; }
            if name == "HTMLString" { return true; }
            if name == "JSONString" { return true; }
            if name == "PathString" { return true; }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

pub fn infer_int_type(value: i64) -> Type {
    if value >= -128 && value <= 127 { return Type::I8; }
    if value >= -32768 && value <= 32767 { return Type::I16; }
    if value >= -2147483648 && value <= 2147483647 { return Type::I32; }
    return Type::I64;
}

pub fn int_rank(ty: Type) -> i64 {
    match ty {
        Type::I8 => { return 0; }
        Type::U8 => { return 0; }
        Type::I16 => { return 1; }
        Type::U16 => { return 1; }
        Type::I32 => { return 2; }
        Type::U32 => { return 2; }
        Type::I64 => { return 3; }
        Type::U64 => { return 3; }
        Type::I128 => { return 4; }
        Type::U128 => { return 4; }
        _ => { return 255; }
    }
    return 255;
}

pub fn wider_type(a: Type, b: Type) -> Type {
    if int_rank(a) >= int_rank(b) { return a; }
    return b;
}

pub fn can_implicitly_widen(from: Type, to: Type) -> bool {
    if type_eq(from, to) { return true; }
    // Any integer can widen to any wider integer
    var from_rank: i64 = int_rank(from);
    var to_rank: i64 = int_rank(to);
    if from_rank < 255 && to_rank < 255 {
        return to_rank >= from_rank;
    }
    // Int can widen to float
    var from_is_int: bool = false;
    match from {
        Type::I8 => { from_is_int = true; }
        Type::I16 => { from_is_int = true; }
        Type::I32 => { from_is_int = true; }
        Type::I64 => { from_is_int = true; }
        Type::U8 => { from_is_int = true; }
        Type::U16 => { from_is_int = true; }
        Type::U32 => { from_is_int = true; }
        Type::U64 => { from_is_int = true; }
        _ => { from_is_int = false; }
    }
    var to_is_float: bool = false;
    match to {
        Type::F32 => { to_is_float = true; }
        Type::F64 => { to_is_float = true; }
        _ => { to_is_float = false; }
    }
    if from_is_int && to_is_float { return true; }
    return false;
}

// Type equality (structural)
pub fn type_eq(a: Type, b: Type) -> bool {
    match a {
        Type::I8 => { match b { Type::I8 => { return true; }, _ => { return false; } } }
        Type::I16 => { match b { Type::I16 => { return true; }, _ => { return false; } } }
        Type::I32 => { match b { Type::I32 => { return true; }, _ => { return false; } } }
        Type::I64 => { match b { Type::I64 => { return true; }, _ => { return false; } } }
        Type::I128 => { match b { Type::I128 => { return true; }, _ => { return false; } } }
        Type::U8 => { match b { Type::U8 => { return true; }, _ => { return false; } } }
        Type::U16 => { match b { Type::U16 => { return true; }, _ => { return false; } } }
        Type::U32 => { match b { Type::U32 => { return true; }, _ => { return false; } } }
        Type::U64 => { match b { Type::U64 => { return true; }, _ => { return false; } } }
        Type::U128 => { match b { Type::U128 => { return true; }, _ => { return false; } } }
        Type::F32 => { match b { Type::F32 => { return true; }, _ => { return false; } } }
        Type::F64 => { match b { Type::F64 => { return true; }, _ => { return false; } } }
        Type::Bool => { match b { Type::Bool => { return true; }, _ => { return false; } } }
        Type::Str => { match b { Type::Str => { return true; }, _ => { return false; } } }
        Type::Void => { match b { Type::Void => { return true; }, _ => { return false; } } }
        Type::Never => { match b { Type::Never => { return true; }, _ => { return false; } } }
        Type::Infer => { match b { Type::Infer => { return true; }, _ => { return false; } } }
        Type::Named(n1) => {
            match b {
                Type::Named(n2) => { return n1 == n2; }
                _ => { return false; }
            }
            return false;
        }
        Type::Generic(n1, a1) => {
            match b {
                Type::Generic(n2, a2) => {
                    if n1 != n2 { return false; }
                    if a1.len() != a2.len() { return false; }
                    var i: i64 = 0;
                    while i < a1.len() {
                        if !type_eq(a1.get(i), a2.get(i)) { return false; }
                        i = i + 1;
                    }
                    return true;
                }
                _ => { return false; }
            }
            return false;
        }
        Type::Ref(inner1, mut1) => {
            match b {
                Type::Ref(inner2, mut2) => {
                    if mut1 != mut2 { return false; }
                    return type_eq(box_type_unbox(inner1), box_type_unbox(inner2));
                }
                _ => { return false; }
            }
            return false;
        }
        Type::RawPtr(inner1, mut1) => {
            match b {
                Type::RawPtr(inner2, mut2) => {
                    if mut1 != mut2 { return false; }
                    return type_eq(box_type_unbox(inner1), box_type_unbox(inner2));
                }
                _ => { return false; }
            }
            return false;
        }
        Type::Array(elem1, sz1) => {
            match b {
                Type::Array(elem2, sz2) => {
                    if sz1 != sz2 { return false; }
                    return type_eq(box_type_unbox(elem1), box_type_unbox(elem2));
                }
                _ => { return false; }
            }
            return false;
        }
        Type::ArrayConst(elem1, sp1) => {
            match b {
                Type::ArrayConst(elem2, sp2) => {
                    if sp1 != sp2 { return false; }
                    return type_eq(box_type_unbox(elem1), box_type_unbox(elem2));
                }
                _ => { return false; }
            }
            return false;
        }
        Type::Tuple(t1) => {
            match b {
                Type::Tuple(t2) => {
                    if t1.len() != t2.len() { return false; }
                    var i: i64 = 0;
                    while i < t1.len() {
                        if !type_eq(t1.get(i), t2.get(i)) { return false; }
                        i = i + 1;
                    }
                    return true;
                }
                _ => { return false; }
            }
            return false;
        }
        Type::Func(p1, r1) => {
            match b {
                Type::Func(p2, r2) => {
                    if p1.len() != p2.len() { return false; }
                    var i: i64 = 0;
                    while i < p1.len() {
                        if !type_eq(p1.get(i), p2.get(i)) { return false; }
                        i = i + 1;
                    }
                    return type_eq(box_type_unbox(r1), box_type_unbox(r2));
                }
                _ => { return false; }
            }
            return false;
        }
        Type::Dyn(n1) => {
            match b {
                Type::Dyn(n2) => { return n1 == n2; }
                _ => { return false; }
            }
            return false;
        }
        Type::Assoc(t1, n1, f1, a1) => {
            match b {
                Type::Assoc(t2, n2, f2, a2) => {
                    if t1 != t2 { return false; }
                    if n1 != n2 { return false; }
                    if f1 != f2 { return false; }
                    if a1.len() != a2.len() { return false; }
                    var i: i64 = 0;
                    while i < a1.len() {
                        if !type_eq(a1.get(i), a2.get(i)) { return false; }
                        i = i + 1;
                    }
                    return true;
                }
                _ => { return false; }
            }
            return false;
        }
        Type::ShapedTensor(elem1, dims1) => {
            match b {
                Type::ShapedTensor(elem2, dims2) => {
                    if !type_eq(box_type_unbox(elem1), box_type_unbox(elem2)) { return false; }
                    if dims1.len() != dims2.len() { return false; }
                    return true;
                }
                _ => { return false; }
            }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

// ---- CHUNK_MARKER_5 ----

// --- types_compatible ----------------------------------------------------

/// Raw memory is `unsafe` in the program itself. Imported modules are not
/// checked yet: their `unsafe` blocks are not complete (roadmap M10).
fn TypeChecker_require_unsafe(self: &mut TypeChecker, what: str) {
    if self.current_module == "main" && self.unsafe_depth == 0 {
        self.errors.push("Safety error (line " + int_to_str(self.current_line) + "): " + what + " needs an `unsafe` block.");
    }
}

/// The bits of an integer type, 0 for anything else.
fn tc_int_bits(ty: Type) -> i64 {
    match ty {
        Type::I8 => { return 8; }
        Type::I16 => { return 16; }
        Type::I32 => { return 32; }
        Type::I64 => { return 64; }
        Type::I128 => { return 128; }
        Type::U8 => { return 8; }
        Type::U16 => { return 16; }
        Type::U32 => { return 32; }
        Type::U64 => { return 64; }
        Type::U128 => { return 128; }
        _ => { return 0; }
    }
    return 0;
}

fn tc_int_signed(ty: Type) -> bool {
    match ty {
        Type::I8 => { return true; }
        Type::I16 => { return true; }
        Type::I32 => { return true; }
        Type::I64 => { return true; }
        Type::I128 => { return true; }
        _ => { return false; }
    }
    return false;
}

fn tc_is_constant_expr(expr: Expr) -> bool {
    match expr {
        Expr::IntLit(_) => { return true; }
        Expr::Unary(_, e) => { return tc_is_constant_expr(box_expr_unbox(e)); }
        Expr::Binary(_, l, r) => { return tc_is_constant_expr(box_expr_unbox(l)) && tc_is_constant_expr(box_expr_unbox(r)); }
        _ => { return false; }
    }
    return false;
}

fn tc_literal_fits(v: i64, negative: bool, bits: i64, signed: bool) -> bool {
    if negative {
        return signed && (bits >= 64 || v <= (1 << (bits - 1)));
    }
    if bits >= 64 { return true; }
    if signed { return v >= 0 && v < (1 << (bits - 1)); }
    return v >= 0 && v < (1 << bits);
}

/// src/typechecker.rs check_value_fits: a value given to an integer type
/// must fit it.
fn TypeChecker_check_value_fits(self: &mut TypeChecker, declared0: Type, actual0: Type, expr: Expr, line: i64) {
    var declared: Type = TypeChecker_resolve_type(self, declared0);
    var bits: i64 = tc_int_bits(declared);
    if bits == 0 { return; }
    var signed: bool = tc_int_signed(declared);
    var checked: bool = false;
    var fits: bool = true;
    match expr {
        Expr::IntLit(v) => {
            checked = true;
            fits = tc_literal_fits(v, false, bits, signed);
        }
        Expr::Unary(op, e) => {
            match op {
                UnaryOp::Neg => {
                    match box_expr_unbox(e) {
                        Expr::IntLit(v) => {
                            checked = true;
                            fits = tc_literal_fits(v, true, bits, signed);
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    if checked {
        if !fits {
            self.errors.push("Type error (line " + int_to_str(line) + "): the literal does not fit in " + type_to_str(declared) + ".");
        }
        return;
    }
    if self.current_module != "main" || tc_is_constant_expr(expr) { return; }
    // `x & 0xFF`: the literal takes the other operand's type
    match expr {
        Expr::Binary(_, l, r) => {
            if tc_is_constant_expr(box_expr_unbox(l)) || tc_is_constant_expr(box_expr_unbox(r)) { return; }
        }
        _ => {}
    }
    var actual: Type = TypeChecker_resolve_type(self, actual0);
    if tc_int_bits(actual) > bits || TypeChecker_is_float(self, actual) {
        self.errors.push("Type error (line " + int_to_str(line) + "): a " + type_to_str(actual) + " may not fit in "
            + type_to_str(declared) + ".\n    Fix: convert it with `as " + type_to_str(declared) + "`.");
    }
}

pub fn TypeChecker_types_compatible(self: &TypeChecker, declared: Type, actual: Type) -> bool {
    var decl: Type = TypeChecker_resolve_type(self, declared);
    var act: Type = TypeChecker_resolve_type(self, actual);
    if type_eq(decl, act) { return true; }
    if type_eq(act, Type::Never) { return true; }
    if type_eq(decl, Type::Infer) || type_eq(act, Type::Infer) { return true; }
    // Associated types are compatible with anything
    match decl {
        Type::Assoc(_, _, _, _) => { return true; }
        _ => {}
    }
    match act {
        Type::Assoc(_, _, _, _) => { return true; }
        _ => {}
    }
    // Dyn types are compatible with anything
    match decl {
        Type::Dyn(_) => { return true; }
        _ => {}
    }
    match act {
        Type::Dyn(_) => { return true; }
        _ => {}
    }
    // Type parameters are compatible with anything
    match decl {
        Type::Named(name) => {
            if tc_str_vec_contains(self.current_type_params, name) { return true; }
        }
        _ => {}
    }
    match act {
        Type::Named(name) => {
            if tc_str_vec_contains(self.current_type_params, name) { return true; }
        }
        _ => {}
    }
    // Generic enum/struct: Named("Option") compatible with Generic("Option", ...)
    match decl {
        Type::Named(decl_name) => {
            match act {
                Type::Generic(gen_name, _) => {
                    if decl_name == gen_name { return true; }
                }
                _ => {}
            }
        }
        _ => {}
    }
    match decl {
        Type::Generic(gen_name, _) => {
            match act {
                Type::Named(decl_name) => {
                    if gen_name == decl_name { return true; }
                }
                _ => {}
            }
        }
        _ => {}
    }
    // Vec<T> and HashMap<K,V> are opaque -- any two instantiations compatible
    match decl {
        Type::Generic(dn, _) => {
            match act {
                Type::Generic(an, _) => {
                    if (dn == "Vec" && an == "Vec") || (dn == "HashMap" && an == "HashMap") { return true; }
                    if (dn == "Rc" && an == "Rc") || (dn == "Arc" && an == "Arc") { return true; }
                }
                _ => {}
            }
        }
        _ => {}
    }
    // ArrayConst compatible with any array
    match decl {
        Type::ArrayConst(_, _) => { return true; }
        _ => {}
    }
    match act {
        Type::ArrayConst(_, _) => { return true; }
        _ => {}
    }
    // str <-> i64 (str is a pointer internally)
    // str is a pointer, but only the runtime layer and the self-hosted compiler
    // treat it as an integer
    if (is_runtime_layer(self.current_module) || str_starts_with(self.current_module, "compiler"))
        && ((type_eq(decl, Type::I64) && type_eq(act, Type::Str)) || (type_eq(decl, Type::Str) && type_eq(act, Type::I64))) {
        return true;
    }
    // Implicit widening
    if can_implicitly_widen(act, decl) { return true; }
    // Tuple element-wise compatibility
    match decl {
        Type::Tuple(decl_elems) => {
            match act {
                Type::Tuple(actual_elems) => {
                    if decl_elems.len() != actual_elems.len() { return false; }
                    var i: i64 = 0;
                    while i < decl_elems.len() {
                        if !TypeChecker_types_compatible(self, decl_elems.get(i), actual_elems.get(i)) { return false; }
                        i = i + 1;
                    }
                    return true;
                }
                _ => { return false; }
            }
            return false;
        }
        _ => {}
    }
    // Raw pointers compatible with each other
    match decl {
        Type::RawPtr(d_inner, d_mut) => {
            match act {
                Type::RawPtr(a_inner, a_mut) => {
                    if d_mut == a_mut {
                        return TypeChecker_types_compatible(self, box_type_unbox(d_inner), box_type_unbox(a_inner));
                    }
                    return false;
                }
                _ => {}
            }
        }
        _ => {}
    }
    // i64 <-> *mut T / *const T (pointers are i64 inside). Making a pointer
    // from an integer is for `unsafe` code in the program itself.
    match decl {
        Type::RawPtr(_, _) => {
            if TypeChecker_is_numeric(self, act) { return self.current_module != "main" || self.unsafe_depth > 0; }
        }
        _ => {}
    }
    match act {
        Type::RawPtr(_, _) => {
            if TypeChecker_is_numeric(self, decl) { return true; }
        }
        _ => {}
    }
    // &T -> *mut T / *const T
    match decl {
        Type::RawPtr(d_inner, _) => {
            match act {
                Type::Ref(a_inner, _) => {
                    return TypeChecker_types_compatible(self, box_type_unbox(d_inner), box_type_unbox(a_inner));
                }
                _ => {}
            }
        }
        _ => {}
    }
    // Numbers: integers mix (narrowing a value is checked where it is
    // assigned), an integer becomes a float, but a float never silently
    // becomes an integer (proposal 0002: `as` says so)
    if TypeChecker_is_float(self, act) && !TypeChecker_is_float(self, decl) && !type_eq(decl, Type::Infer) { return false; }
    if TypeChecker_is_numeric(self, decl) && TypeChecker_is_numeric(self, act) { return true; }
    return false;
}

// --- Generic calls (proposal 0002) ----------------------------------------

/// A call to a generic function, as src/typechecker.rs check_generic_call:
/// type arguments inferred from the arguments (and the expected type for one
/// only the result mentions), arguments and bounds checked, the call typed
/// with the instantiated return type.
fn TypeChecker_check_generic_call(self: &mut TypeChecker, callee: str, tps: Vec<str>, bounds: Vec<StrPair>,
                                  params: Vec<Type>, ret: Type, arg_types: Vec<Type>, hint: Type) -> Type {
    var names: Vec<str> = Vec::new();
    var types: Vec<Type> = Vec::new();
    var i: i64 = 0;
    while i < params.len() && i < arg_types.len() {
        tc_bind_type_params(params.get(i), arg_types.get(i), tps, &mut names, &mut types);
        i = i + 1;
    }
    if !type_eq(hint, Type::Never) && !type_eq(hint, Type::Infer) {
        tc_bind_type_params(ret, hint, tps, &mut names, &mut types);
    }
    var in_fn: str = "";
    match self.current_func_name {
        OptString::Some(fname) => { in_fn = ", in '" + fname + "'"; }
        OptString::None => {}
    }
    // An argument of unknown type binds nothing: monomorphization infers from
    // the values; only a parameter no argument mentions is an error
    var unknown_arg: bool = false;
    i = 0;
    while i < arg_types.len() {
        if type_eq(arg_types.get(i), Type::Infer) || type_eq(arg_types.get(i), Type::Never) { unknown_arg = true; }
        i = i + 1;
    }
    i = 0;
    while i < tps.len() && !unknown_arg {
        if !str_vec_contains(names, tps.get(i)) {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): cannot infer the type parameter '"
                + tps.get(i) + "' of '" + callee + "': no argument gives it.\n    Fix: give the result a type, as in `val x: i64 = "
                + callee + "(...)`.");
            return Type::Never;
        }
        i = i + 1;
    }
    i = 0;
    while i < params.len() && i < arg_types.len() {
        var pt: Type = tc_subst_type_params(params.get(i), names, types);
        var a: Type = arg_types.get(i);
        if !TypeChecker_type_contains_param(self, pt) && !type_eq(a, Type::Infer) && !type_eq(a, Type::Never)
            && !TypeChecker_arg_compatible(self, pt, a) {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): function '" + callee + "' parameter "
                + int_to_str(i + 1) + " expects '" + type_to_str(pt) + "', got '" + type_to_str(a) + "'");
        }
        i = i + 1;
    }
    var bi: i64 = 0;
    while bi < bounds.len() {
        var tp: str = bounds.get(bi).a;
        var tr: str = bounds.get(bi).b;
        bi = bi + 1;
        var k: i64 = 0;
        var found: bool = false;
        var bty: Type = Type::Infer;
        while k < names.len() {
            if names.get(k) == tp { bty = types.get(k); found = true; }
            k = k + 1;
        }
        if !found || !TypeChecker_is_trait_name(self, tr) || TypeChecker_satisfies_bound(self, bty, tr) { continue; }
        self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): " + type_to_str(bty) + " does not implement "
            + tr + " (required by " + tp + ": " + tr + " in '" + callee + "').\n    Fix: add `impl " + tr + " for " + type_to_str(bty)
            + " { ... }`, or pass a value whose type implements it.");
    }
    var r: Type = tc_subst_type_params(ret, names, types);
    if TypeChecker_type_contains_param(self, r) { return Type::Never; }
    return r;
}

fn tc_is_str(t: Type) -> bool {
    match t {
        Type::Str => { return true; }
        Type::Named(n) => { return n == "str"; }
        _ => {}
    }
    return false;
}

/// `&str`: a borrowed string (release M11).
fn tc_is_borrowed_str(t: Type) -> bool {
    match t {
        Type::Ref(inner, is_mut) => { return !is_mut && tc_is_str(box_type_unbox(inner)); }
        _ => {}
    }
    return false;
}

/// Calls that read a string and keep nothing of it, or return a new one:
/// a borrowed string may be passed to them as a str (release M11).
fn tc_borrow_safe_callee(callee: str) -> bool {
    if str_starts_with(callee, "p_") { return true; }
    return callee == "str_len" || callee == "str_find" || callee == "str_contains"
        || callee == "str_starts_with" || callee == "str_ends_with" || callee == "str_byte_at"
        || callee == "str_equal" || callee == "str_eq" || callee == "str_parse_int"
        || callee == "str_to_int" || callee == "str_hash" || callee == "str_clone"
        || callee == "str_compare" || callee == "str_count" || callee == "print"
        || callee == "println" || callee == "eprint" || callee == "eprintln";
}

/// A reference is read through where its value is wanted: the referenced type.
fn tc_read_through(t: Type) -> Type {
    match t {
        Type::Ref(inner, _) => { return box_type_unbox(inner); }
        _ => { return t; }
    }
    return t;
}

fn tc_is_struct(self: &TypeChecker, name: str) -> bool {
    match TypeChecker_lookup_struct_cache(self, name) {
        OptVecStructField::Some(_) => { return true; }
        OptVecStructField::None => { return false; }
    }
    return false;
}

/// Methods that change their receiver (Vec, HashMap, String).
fn tc_changing_method(m: str) -> bool {
    return m == "push" || m == "pop" || m == "set" || m == "insert" || m == "remove" || m == "clear" || m == "extend" || m == "truncate" || m == "reverse" || m == "sort" || m == "resize" || m == "swap" || m == "push_str" || m == "append" || m == "retain" || m == "dedup" || m == "fill" || m == "drain" || m == "sort_by" || m == "push_front" || m == "pop_front";
}

/// The variable a place expression is part of: `p` for `p`, `p.items`,
/// `p.items.get(i).name` or `p[i]` ("" for anything else).
fn tc_place_root(e: Expr) -> str {
    match e {
        Expr::Ident(n) => { return n; }
        Expr::FieldAccess(inner, _) => { return tc_place_root(box_expr_unbox(inner)); }
        Expr::Index(arr, _) => { return tc_place_root(box_expr_unbox(arr)); }
        Expr::MethodCall(recv, m, _) => {
            if m == "get" { return tc_place_root(box_expr_unbox(recv)); }
            return "";
        }
        _ => { return ""; }
    }
    return "";
}

fn TypeChecker_forget_value_param(self: &mut TypeChecker, name: str) {
    var i: i64 = 0;
    while i < self.value_param_names.len() {
        if self.value_param_names.get(i) == name {
            self.value_param_names.remove(i);
            self.value_param_types.remove(i);
            return;
        }
        i = i + 1;
    }
}

/// A by-value Vec/HashMap/struct parameter changed: an error, since the
/// caller would not see the change (as src/typechecker.rs).
fn TypeChecker_check_param_change(self: &mut TypeChecker, root: str) {
    var i: i64 = 0;
    while i < self.value_param_names.len() {
        if self.value_param_names.get(i) == root {
            var ty: Type = self.value_param_types.get(i);
            var in_fn: str = "";
            match self.current_func_name {
                OptString::Some(fname) => { in_fn = " of '" + fname + "'"; }
                OptString::None => {}
            }
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): '" + root + "' is a by-value parameter" + in_fn
                + " and cannot be changed: the caller would not see the change.\n    Fix: take `" + root + ": &mut " + type_to_str(ty)
                + "` and pass `&mut ...`, or change a copy: `var " + root + " = " + root + ";`.");
            // one error per parameter
            TypeChecker_forget_value_param(self, root);
            return;
        }
        i = i + 1;
    }
}

/// Whether `receiver.method(..)` calls a user method taking `self: &mut T`.
fn TypeChecker_method_takes_mut_self(self: &TypeChecker, receiver: Expr, method: str) -> bool {
    var root: str = tc_place_root(receiver);
    if str_len(root) == 0 { return false; }
    var i: i64 = 0;
    while i < self.value_param_names.len() {
        if self.value_param_names.get(i) == root {
            match TypeChecker_resolve_type(self, self.value_param_types.get(i)) {
                Type::Named(sn) => {
                    var mi: i64 = TypeChecker_methods_at_ro(self, sn);
                    while mi < self.methods.len() {
                        if self.methods.get(mi).key == sn {
                            var mm: Vec<MethodMapEntry> = self.methods.get(mi).val;
                            var k: i64 = 0;
                            while k < mm.len() {
                                if mm.get(k).key == method && mm.get(k).val.has_self && mm.get(k).val.param_types.len() > 0 {
                                    match mm.get(k).val.param_types.get(0) {
                                        Type::Ref(_, is_mut) => { return is_mut; }
                                        _ => { return false; }
                                    }
                                }
                                k = k + 1;
                            }
                        }
                        mi = mi + 1;
                    }
                }
                _ => {}
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

fn TypeChecker_impl_type_params(self: &TypeChecker, name: str) -> Vec<str> {
    var i: i64 = 0;
    while i < self.impl_tp_names.len() {
        if self.impl_tp_names.get(i) == name { return self.impl_tp_lists.get(i); }
        i = i + 1;
    }
    return Vec::new();
}

fn TypeChecker_is_trait_name(self: &TypeChecker, name: str) -> bool {
    var i: i64 = 0;
    while i < self.traits.len() {
        if self.traits.get(i).key == name { return true; }
        i = i + 1;
    }
    return false;
}

/// Whether `ty` implements `tr`: an impl, or a type parameter of the current
/// function bound by it.
fn TypeChecker_satisfies_bound(self: &TypeChecker, ty: Type, tr: str) -> bool {
    var name: str = type_to_str(ty);
    match ty {
        Type::Named(n) => { name = n; }
        Type::Generic(gn, _) => { name = gn; }
        Type::Infer => { return true; }
        Type::Never => { return true; }
        _ => {}
    }
    if str_vec_contains(self.impl_pairs, tr + ":" + name) { return true; }
    var i: i64 = 0;
    while i < self.current_type_param_bounds.len() {
        if self.current_type_param_bounds.get(i).key == name && self.current_type_param_bounds.get(i).val == tr { return true; }
        i = i + 1;
    }
    return false;
}

/// Bind the type parameters `tps` that `param` mentions from `arg` (the first
/// binding of each wins), as mono.fd infer_from_pair.
fn tc_bind_type_params(param: Type, arg: Type, tps: Vec<str>, names: &mut Vec<str>, types: &mut Vec<Type>) {
    match param {
        Type::Named(n) => {
            if str_vec_contains(tps, n) && !str_vec_contains(names, n) && !type_eq(arg, Type::Infer) && !type_eq(arg, Type::Never) {
                names.push(n);
                types.push(arg);
            }
        }
        Type::Generic(gn, gargs) => {
            match arg {
                Type::Generic(an, aargs) => {
                    if gn == an {
                        var i: i64 = 0;
                        while i < gargs.len() && i < aargs.len() {
                            tc_bind_type_params(gargs.get(i), aargs.get(i), tps, names, types);
                            i = i + 1;
                        }
                    }
                }
                _ => {}
            }
        }
        Type::Ref(inner, _) => {
            match arg {
                Type::Ref(ainner, _) => { tc_bind_type_params(box_type_unbox(inner), box_type_unbox(ainner), tps, names, types); }
                _ => {}
            }
        }
        Type::Array(elem, _) => {
            match arg {
                Type::Array(aelem, _) => { tc_bind_type_params(box_type_unbox(elem), box_type_unbox(aelem), tps, names, types); }
                _ => {}
            }
        }
        // A const parameter `[T; N]` takes the array's length (as mono.fd)
        Type::ArrayConst(celem, size_param) => {
            match arg {
                Type::Array(aelem, size) => {
                    if str_vec_contains(tps, size_param) && !str_vec_contains(names, size_param) {
                        names.push(size_param);
                        types.push(Type::Named("__const_" + int_to_str(size)));
                    }
                    tc_bind_type_params(box_type_unbox(celem), box_type_unbox(aelem), tps, names, types);
                }
                _ => {}
            }
        }
        Type::Tuple(ps) => {
            match arg {
                Type::Tuple(aps) => {
                    var i: i64 = 0;
                    while i < ps.len() && i < aps.len() {
                        tc_bind_type_params(ps.get(i), aps.get(i), tps, names, types);
                        i = i + 1;
                    }
                }
                _ => {}
            }
        }
        Type::Func(fps, fret) => {
            match arg {
                Type::Func(aps, aret) => {
                    var i: i64 = 0;
                    while i < fps.len() && i < aps.len() {
                        tc_bind_type_params(fps.get(i), aps.get(i), tps, names, types);
                        i = i + 1;
                    }
                    tc_bind_type_params(box_type_unbox(fret), box_type_unbox(aret), tps, names, types);
                }
                _ => {}
            }
        }
        _ => {}
    }
}

/// `ty` with its bound type parameters replaced.
fn tc_subst_type_params(ty: Type, names: Vec<str>, types: Vec<Type>) -> Type {
    match ty {
        Type::Named(n) => {
            var i: i64 = 0;
            while i < names.len() {
                if names.get(i) == n { return types.get(i); }
                i = i + 1;
            }
            return ty;
        }
        Type::Generic(gn, gargs) => {
            var out: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < gargs.len() {
                out.push(tc_subst_type_params(gargs.get(i), names, types));
                i = i + 1;
            }
            return Type::Generic(gn, out);
        }
        Type::Ref(inner, m) => { return Type::Ref(Box::new(tc_subst_type_params(box_type_unbox(inner), names, types)), m); }
        Type::RawPtr(inner, m) => { return Type::RawPtr(Box::new(tc_subst_type_params(box_type_unbox(inner), names, types)), m); }
        Type::Array(elem, n) => { return Type::Array(Box::new(tc_subst_type_params(box_type_unbox(elem), names, types)), n); }
        Type::Tuple(ts) => {
            var out2: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < ts.len() {
                out2.push(tc_subst_type_params(ts.get(i), names, types));
                i = i + 1;
            }
            return Type::Tuple(out2);
        }
        Type::Func(fps, fret) => {
            var out3: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < fps.len() {
                out3.push(tc_subst_type_params(fps.get(i), names, types));
                i = i + 1;
            }
            return Type::Func(out3, Box::new(tc_subst_type_params(box_type_unbox(fret), names, types)));
        }
        _ => { return ty; }
    }
    return ty;
}

// --- type_contains_param -------------------------------------------------

pub fn TypeChecker_type_contains_param(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        // A named type that is neither a struct nor an enum is a type
        // parameter (of the callee: src/typechecker.rs type_contains_param);
        // the caller's own type params are not the ones to look at.
        Type::Named(name) => {
            match TypeChecker_lookup_struct_cache(self, name) {
                OptVecStructField::Some(_) => { return false; }
                OptVecStructField::None => {}
            }
            return !TypeChecker_is_known_enum(self, name);
        }
        Type::Func(fparams, fret) => {
            var fi: i64 = 0;
            while fi < fparams.len() {
                if TypeChecker_type_contains_param(self, fparams.get(fi)) { return true; }
                fi = fi + 1;
            }
            return TypeChecker_type_contains_param(self, box_type_unbox(fret));
        }
        Type::Ref(inner, _) => { return TypeChecker_type_contains_param(self, box_type_unbox(inner)); }
        Type::RawPtr(inner, _) => { return TypeChecker_type_contains_param(self, box_type_unbox(inner)); }
        Type::Array(elem, _) => { return TypeChecker_type_contains_param(self, box_type_unbox(elem)); }
        Type::ArrayConst(elem, _) => { return TypeChecker_type_contains_param(self, box_type_unbox(elem)); }
        Type::Generic(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                if TypeChecker_type_contains_param(self, args.get(i)) { return true; }
                i = i + 1;
            }
            return false;
        }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if TypeChecker_type_contains_param(self, types.get(i)) { return true; }
                i = i + 1;
            }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

// --- is_known_enum -------------------------------------------------------

pub fn TypeChecker_is_known_enum(self: &TypeChecker, name: str) -> bool {
    return tc_str_vec_contains(self.enums, name);
}

// --- type_size -----------------------------------------------------------

pub fn TypeChecker_type_size(self: &TypeChecker, ty: Type) -> i64 {
    match ty {
        Type::I8 => { return 1; }
        Type::U8 => { return 1; }
        Type::Bool => { return 1; }
        Type::I16 => { return 2; }
        Type::U16 => { return 2; }
        Type::I32 => { return 4; }
        Type::U32 => { return 4; }
        Type::F32 => { return 4; }
        Type::I64 => { return 8; }
        Type::U64 => { return 8; }
        Type::F64 => { return 8; }
        Type::I128 => { return 16; }
        Type::U128 => { return 16; }
        Type::Str => { return 16; }
        Type::Named(name) => {
            var i: i64 = TypeChecker_struct_pos_ro(self, name);
            var i_lim: i64 = i + 1;
            if i < 0 { i = 0; i_lim = 0; }
            while i < i_lim {
                if self.structs.get(i).key == name {
                    return self.structs.get(i).val.len() * 8;
                }
                i = i + 1;
            }
            if name == "String" { return 16; }
            return 8;
        }
        Type::Generic(name, _) => {
            if name == "Vec" { return 24; }
            if name == "HashMap" { return 48; }
            if name == "Option" { return 16; }
            if name == "Result" { return 16; }
            return 8;
        }
        Type::Ref(_, _) => { return 8; }
        Type::RawPtr(_, _) => { return 8; }
        _ => { return 8; }
    }
    return 8;
}

// --- heap allocation: @no-alloc and region budgets ---------------------------

/// Builtin methods that allocate (Vec, HashMap, str), and "+" for `a + b`
/// on strings.
fn tc_alloc_method_names() -> Vec<str> {
    var alloc_methods: Vec<str> = Vec::new();
    alloc_methods.push("push"); alloc_methods.push("push_str"); alloc_methods.push("insert");
    alloc_methods.push("extend"); alloc_methods.push("resize"); alloc_methods.push("reserve");
    alloc_methods.push("clone"); alloc_methods.push("to_str"); alloc_methods.push("to_string");
    alloc_methods.push("concat"); alloc_methods.push("split"); alloc_methods.push("keys");
    alloc_methods.push("values"); alloc_methods.push("append"); alloc_methods.push("collect");
    alloc_methods.push("map"); alloc_methods.push("filter"); alloc_methods.push("+");
    return alloc_methods;
}

/// Functions that allocate on the heap.
fn tc_alloc_func_names() -> Vec<str> {
    var alloc_funcs: Vec<str> = Vec::new();
    alloc_funcs.push("p_vec_new"); alloc_funcs.push("p_vec_push"); alloc_funcs.push("p_vec_push_str");
    alloc_funcs.push("p_vec_insert"); alloc_funcs.push("p_vec_resize"); alloc_funcs.push("p_vec_extend");
    alloc_funcs.push("p_hashmap_new"); alloc_funcs.push("p_hashmap_insert");
    alloc_funcs.push("p_string_new"); alloc_funcs.push("p_string_push"); alloc_funcs.push("p_string_concat");
    alloc_funcs.push("p_malloc"); alloc_funcs.push("p_alloc"); alloc_funcs.push("p_realloc");
    alloc_funcs.push("p_arena_new"); alloc_funcs.push("p_arena_alloc");
    alloc_funcs.push("Vec_new"); alloc_funcs.push("Vec_push"); alloc_funcs.push("Vec_insert"); alloc_funcs.push("Vec_resize");
    alloc_funcs.push("HashMap_new"); alloc_funcs.push("HashMap_insert");
    alloc_funcs.push("String_new"); alloc_funcs.push("String_push");
    alloc_funcs.push("Vec_with_capacity"); alloc_funcs.push("Vec_filled_typed"); alloc_funcs.push("Vec_clone"); alloc_funcs.push("Box_new");
    alloc_funcs.push("StringBuilder_new"); alloc_funcs.push("int_to_str"); alloc_funcs.push("float_to_str");
    alloc_funcs.push("p_str_concat"); alloc_funcs.push("p_to_str"); alloc_funcs.push("p_str_alloc");
    return alloc_funcs;
}

/// Charge a heap allocation to the innermost region with a budget: `bytes`
/// when its size is known at compile time, else (bytes < 0) record it as
/// one the budget cannot bound.
fn TypeChecker_budget_heap(self: &mut TypeChecker, what: str, bytes: i64) {
    if self.region_budgets.len() == 0 { return; }
    var rb: RegionBudget = self.region_budgets.pop();
    match rb.budget {
        OptI64::Some(_) => {
            var n: i64 = bytes;
            var desc: str = what;
            if n >= 0 && self.loop_depth > rb.loop0 { n = -1; desc = what + " in a loop"; }
            if n >= 0 { rb.usage = rb.usage + n; }
            else if rb.heap == "" { rb.heap = desc; }
        }
        OptI64::None => {}
    }
    self.region_budgets.push(rb);
}

/// A call inside a region with a budget: p_malloc(N) with a constant N
/// and Vec::new() have a known size; any other allocating builtin, or a
/// function that allocates (itself or through its callees), has none.
fn TypeChecker_budget_call(self: &mut TypeChecker, callee: str, args: Vec<Expr>) {
    if callee == "p_malloc" || callee == "p_alloc" {
        if args.len() == 1 {
            match args.get(0) {
                Expr::IntLit(n) => {
                    TypeChecker_budget_heap(self, callee + "(" + int_to_str(n) + ")", n);
                    return;
                }
                _ => {}
            }
        }
        TypeChecker_budget_heap(self, callee + "() of a size not known at compile time", -1);
        return;
    }
    if callee == "Vec_new" || callee == "p_vec_new" {
        TypeChecker_budget_heap(self, "Vec::new()", 32);
        return;
    }
    if tc_vec_contains_str(tc_alloc_func_names(), callee) {
        TypeChecker_budget_heap(self, "'" + callee + "()'", -1);
        return;
    }
    if HashMap_get(self.heap_alloc_index, callee) != 0 {
        TypeChecker_budget_heap(self, "'" + callee + "()', which allocates", -1);
    }
}

/// A method call on a value inside a region with a budget: a growing
/// builtin method (push, insert, clone, ...) on a Vec, HashMap or string,
/// or a user method that allocates.
fn TypeChecker_budget_method(self: &mut TypeChecker, recv_ty: Type, method: str) {
    var builtin: bool = false;
    var owner: str = "";
    match recv_ty {
        Type::Str => { builtin = true; }
        Type::Generic(gn, _) => { builtin = gn == "Vec" || gn == "HashMap" || gn == "Option" || gn == "Result"; owner = gn; }
        Type::Named(nn) => {
            if nn == "Vec" || nn == "HashMap" || nn == "String" || nn == "StringBuilder" { builtin = true; }
            owner = nn;
        }
        _ => {}
    }
    if owner != "" && HashMap_get(self.heap_alloc_index, owner + "." + method) != 0 {
        TypeChecker_budget_heap(self, "'." + method + "()' on " + owner + ", which allocates", -1);
        return;
    }
    if builtin && tc_vec_contains_str(tc_alloc_method_names(), method) {
        TypeChecker_budget_heap(self, "'." + method + "()'", -1);
    }
}

/// A name bound in a scope (a variable, not a type name).
fn TypeChecker_is_local_var(self: &TypeChecker, name: str) -> bool {
    match TypeChecker_lookup(self, name) {
        OptType::Some(_) => { return true; }
        OptType::None => {}
    }
    return false;
}

/// Some statement of `stmts` (or of a block in them) is a region with a
/// budget.
fn tc_stmts_have_budget(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::RegionBlock(_, budget, _, _, _, body, _) => {
                match budget {
                    OptI64::Some(_) => { return true; }
                    OptI64::None => {}
                }
                if tc_stmts_have_budget(body) { return true; }
            }
            Stmt::If(_, then_b, else_b, _) => {
                if tc_stmts_have_budget(then_b) { return true; }
                match else_b {
                    OptStmts::Some(eb) => { if tc_stmts_have_budget(eb) { return true; } }
                    OptStmts::None => {}
                }
            }
            Stmt::While(_, body, _) => { if tc_stmts_have_budget(body) { return true; } }
            Stmt::For(_, _, body, _) => { if tc_stmts_have_budget(body) { return true; } }
            Stmt::Loop(body, _) => { if tc_stmts_have_budget(body) { return true; } }
            Stmt::Defer(body, _) => { if tc_stmts_have_budget(body) { return true; } }
            Stmt::Sandbox(body, _) => { if tc_stmts_have_budget(body) { return true; } }
            Stmt::Unsafe(body, _) => { if tc_stmts_have_budget(body) { return true; } }
            Stmt::Txn(body, _) => { if tc_stmts_have_budget(body) { return true; } }
            Stmt::SpawnScope(body, _) => { if tc_stmts_have_budget(body) { return true; } }
            Stmt::Match(_, arms, _) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    if tc_stmts_have_budget(arms.get(ai).body) { return true; }
                    ai = ai + 1;
                }
            }
            _ => {}
        }
        i = i + 1;
    }
    return false;
}

/// heap_alloc_index: every function or method that allocates on the heap,
/// directly (an allocating builtin, a growing method, string `+`) or
/// through a function it calls. Printing does not count.
fn TypeChecker_compute_heap_alloc(self: &mut TypeChecker, program: Program) {
    var any: bool = false;
    var fi: i64 = 0;
    while fi < program.funcs.len() && !any {
        if tc_stmts_have_budget(program.funcs.get(fi).body) { any = true; }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() && !any {
        var imp0: ImplDef = program.impls.get(ii);
        var m0: i64 = 0;
        while m0 < imp0.methods.len() {
            if tc_stmts_have_budget(imp0.methods.get(m0).body) { any = true; }
            m0 = m0 + 1;
        }
        ii = ii + 1;
    }
    if !any { return; }
    var afuncs: Vec<str> = tc_alloc_func_names();
    var ameths: Vec<str> = tc_alloc_method_names();
    var names: Vec<str> = Vec::new();
    var aliases: Vec<str> = Vec::new();
    var bodies_calls: Vec<Vec<str>> = Vec::new();
    fi = 0;
    while fi < program.funcs.len() {
        var f: Func = program.funcs.get(fi);
        names.push(f.name);
        aliases.push("");
        var raw: Vec<str> = Vec::new();
        g_scan_dot_methods = true;
        scan_stmts_for_calls(f.body, &mut raw);
        g_scan_dot_methods = false;
        bodies_calls.push(raw);
        fi = fi + 1;
    }
    ii = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            names.push(imp.struct_name + "." + m.name);
            aliases.push(imp.struct_name + "_" + m.name);
            var raw2: Vec<str> = Vec::new();
            g_scan_dot_methods = true;
            scan_stmts_for_calls(m.body, &mut raw2);
            g_scan_dot_methods = false;
            bodies_calls.push(raw2);
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var done: Vec<bool> = Vec::new();
    var k: i64 = 0;
    while k < names.len() {
        var nm: str = names.get(k);
        var direct: bool = false;
        if !str_starts_with(nm, "print") && !str_starts_with(nm, "eprint") {
            var calls: Vec<str> = bodies_calls.get(k);
            var ci: i64 = 0;
            while ci < calls.len() && !direct {
                var c: str = calls.get(ci);
                if str_starts_with(c, ".") {
                    if tc_vec_contains_str(ameths, str_slice(c, 1, str_len(c))) { direct = true; }
                } else if tc_vec_contains_str(afuncs, c) {
                    direct = true;
                }
                ci = ci + 1;
            }
        }
        done.push(direct);
        if direct {
            HashMap_insert(self.heap_alloc_index, nm, 1);
            if aliases.get(k) != "" { HashMap_insert(self.heap_alloc_index, aliases.get(k), 1); }
        }
        k = k + 1;
    }
    var changed: bool = true;
    while changed {
        changed = false;
        k = 0;
        while k < names.len() {
            var nm2: str = names.get(k);
            if !done.get(k) && !str_starts_with(nm2, "print") && !str_starts_with(nm2, "eprint") {
                var calls2: Vec<str> = bodies_calls.get(k);
                var cj: i64 = 0;
                while cj < calls2.len() {
                    var c2: str = calls2.get(cj);
                    if !str_starts_with(c2, ".") && HashMap_get(self.heap_alloc_index, c2) != 0 {
                        done.set(k, true);
                        HashMap_insert(self.heap_alloc_index, nm2, 1);
                        if aliases.get(k) != "" { HashMap_insert(self.heap_alloc_index, aliases.get(k), 1); }
                        changed = true;
                        cj = calls2.len();
                    }
                    cj = cj + 1;
                }
            }
            k = k + 1;
        }
    }
}

// --- sandbox: effects of what a call runs ----------------------------------

/// The first IO/Net/Spawn effect in `effs`, or "" when there is none:
/// what a call inside `sandbox { }` may not have.
fn tc_sandbox_forbidden(effs: Vec<str>) -> str {
    var i: i64 = 0;
    while i < effs.len() {
        var e: str = effs.get(i);
        if e == "IO" || e == "Net" || e == "Spawn" { return e; }
        i = i + 1;
    }
    return "";
}

fn TypeChecker_sandbox_reject(self: &mut TypeChecker, what: str, effs: Vec<str>) {
    var e: str = tc_sandbox_forbidden(effs);
    if e == "" { return; }
    self.errors.push("Sandbox error: '" + what + "' has effect '!" + e + "' -- all capabilities are revoked inside sandbox, including in the functions it calls");
}

/// A call inside sandbox: the builtin's effect (p_file_read is IO, ...),
/// the inferred effects of a user function (transitive), and for a
/// higher-order callee the effects of the functions passed to it. A call
/// through a function value of unknown effects is rejected too.
fn TypeChecker_check_sandbox_call(self: &mut TypeChecker, callee: str, args: Vec<Expr>) {
    var effs: Vec<str> = Vec::new();
    var no_args: Vec<Expr> = Vec::new();
    TypeChecker_scan_expr_for_effects(self, Expr::Call(callee, no_args), &mut effs);
    var ho_at: i64 = HashMap_get(self.ho_fn_index, callee);
    if ho_at != 0 {
        var hidx: Vec<i64> = self.ho_fn_idx.get(ho_at - 1);
        var hk: i64 = 0;
        while hk < hidx.len() {
            if hidx.get(hk) < args.len() {
                TypeChecker_passed_fn_effects(self, args.get(hidx.get(hk)), &mut effs);
            }
            hk = hk + 1;
        }
    }
    if tc_sandbox_forbidden(effs) == "" && HashMap_get(self.func_effects_index, callee) == 0 {
        match TypeChecker_lookup(self, callee) {
            OptType::Some(t) => {
                match t {
                    Type::Func(_, _) => {
                        self.errors.push("Sandbox error: '" + callee + "()' calls a function value whose effects are not known -- all capabilities are revoked inside sandbox");
                        return;
                    }
                    _ => {}
                }
            }
            OptType::None => {}
        }
    }
    TypeChecker_sandbox_reject(self, callee + "()", effs);
}

// --- check_capability ----------------------------------------------------

pub fn TypeChecker_check_capability(self: &mut TypeChecker, cap: str, context: str) {
    if self.sandbox_depth > 0 {
        self.errors.push("Sandbox error: '" + context + "' requires '" + cap + "' capability -- all capabilities are revoked inside sandbox");
        match self.current_func_name {
            OptString::Some(fname) => {
                var ci: i64 = 0;
                while ci < self.cap_verified.len() {
                    if self.cap_verified.get(ci) == fname {
                        self.cap_verified.remove(ci);
                        ci = self.cap_verified.len();
                    }
                    ci = ci + 1;
                }
            }
            OptString::None => {}
        }
        return;
    }
    if self.current_module == "core" { return; }
    if self.strict_caps && !tc_str_vec_contains(self.granted_caps, cap) {
        self.errors.push("Capability error: '" + context + "' requires '" + cap + "' capability (not granted to module '" + self.current_module + "')");
        match self.current_func_name {
            OptString::Some(fname) => {
                var ci2: i64 = 0;
                while ci2 < self.cap_verified.len() {
                    if self.cap_verified.get(ci2) == fname {
                        self.cap_verified.remove(ci2);
                        ci2 = self.cap_verified.len();
                    }
                    ci2 = ci2 + 1;
                }
            }
            OptString::None => {}
        }
    }
}

// --- check_visibility ----------------------------------------------------

pub fn TypeChecker_check_visibility(self: &mut TypeChecker, name: str) {
    // Check if the item is defined in a different module
    match TypeChecker_get_item_module(self, name) {
        OptString::Some(item_module) => {
            if item_module != self.current_module {
                // Cross-module access: check if item is pub
                var is_pub: bool = TypeChecker_get_item_visibility(self, name);
                if !is_pub {
                    self.errors.push("Visibility error: '" + name + "' is private to module '" + item_module + "' (not accessible from '" + self.current_module + "')");
                }
            }
        }
        OptString::None => {}
    }
}

// --- collect_capabilities ------------------------------------------------

pub fn TypeChecker_collect_capabilities(self: &mut TypeChecker, program: Program) {
    var i: i64 = 0;
    while i < program.imports.len() {
        var imp: ImportDef = program.imports.get(i);
        if imp.capabilities.len() > 0 {
            self.strict_caps = true;
            var j: i64 = 0;
            while j < imp.capabilities.len() {
                self.granted_caps.push(imp.capabilities.get(j));
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

// --- Linear type checks --------------------------------------------------

pub fn TypeChecker_is_linear_type(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::Named(name) => { return tc_str_vec_contains(self.linear_structs, name); }
        Type::Generic(name, _) => { return tc_str_vec_contains(self.linear_structs, name); }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if TypeChecker_is_linear_type(self, types.get(i)) { return true; }
                i = i + 1;
            }
            return false;
        }
        Type::Array(elem, _) => { return TypeChecker_is_linear_type(self, box_type_unbox(elem)); }
        Type::ArrayConst(elem, _) => { return TypeChecker_is_linear_type(self, box_type_unbox(elem)); }
        Type::Ref(inner, _) => { return TypeChecker_is_linear_type(self, box_type_unbox(inner)); }
        _ => { return false; }
    }
    return false;
}

/// Result type of a swizzle (src/typechecker.rs swizzle_result_type):
/// 2-4 components, all from one of xyzw / rgba / stpq.
fn tc_str_has_byte(chars: str, ch: i64) -> bool {
    var i: i64 = 0;
    while i < str_len(chars) {
        if str_byte_at(chars, i) == ch { return true; }
        i = i + 1;
    }
    return false;
}

pub fn tc_swizzle_result_type(field: str) -> OptType {
    var n: i64 = str_len(field);
    if n <= 1 || n > 4 { return OptType::None; }
    var xyzw: str = "xyzw";
    var rgba: str = "rgba";
    var stpq: str = "stpq";
    var group: str = "";
    var first: i64 = str_byte_at(field, 0);
    if tc_str_has_byte(xyzw, first) { group = xyzw; }
    else if tc_str_has_byte(rgba, first) { group = rgba; }
    else if tc_str_has_byte(stpq, first) { group = stpq; }
    else { return OptType::None; }
    var i: i64 = 0;
    while i < n {
        if !tc_str_has_byte(group, str_byte_at(field, i)) { return OptType::None; }
        i = i + 1;
    }
    if n == 2 { return OptType::Some(Type::Named("vec2")); }
    if n == 3 { return OptType::Some(Type::Named("vec3")); }
    return OptType::Some(Type::Named("vec4"));
}

pub fn tc_is_vec_type(name: str) -> bool {
    return name == "vec2" || name == "vec3" || name == "vec4";
}

pub fn TypeChecker_is_send_type(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::I64 => { return true; }
        Type::I32 => { return true; }
        Type::I8 => { return true; }
        Type::F64 => { return true; }
        Type::F32 => { return true; }
        Type::Bool => { return true; }
        Type::Str => { return true; }
        Type::Void => { return true; }
        Type::Never => { return true; }
        Type::Named(name) => {
            if tc_str_vec_contains(self.send_structs, name) { return true; }
            // A @scoped struct borrows strings freed when its scope ends (M11)
            if str_vec_contains(self.scoped_structs, name) { return false; }
            // A struct whose fields are all @send is @send itself (release
            // H4): it is copied to the other thread, and nothing in it is
            // shared. An enum carries values the same way.
            if tc_str_vec_contains(self.enums, name) { return true; }
            match TypeChecker_lookup_struct_cache(self, name) {
                OptVecStructField::Some(fields) => {
                    var fi: i64 = 0;
                    while fi < fields.len() {
                        var fty: Type = fields.get(fi).ty;
                        var direct_self: bool = false;
                        match fty {
                            Type::Named(fname) => { direct_self = fname == name; }
                            _ => {}
                        }
                        if !direct_self && !TypeChecker_is_send_type(self, fty) { return false; }
                        fi = fi + 1;
                    }
                    return true;
                }
                OptVecStructField::None => {}
            }
            return false;
        }
        Type::Generic(name, args) => {
            if tc_str_vec_contains(self.send_structs, name) { return true; }
            if name == "Vec" || name == "HashMap" || name == "String" || name == "Channel" || name == "Mutex" || name == "Future" || name == "Option" || name == "Result" || name == "Box" {
                var i: i64 = 0;
                while i < args.len() {
                    if !TypeChecker_is_send_type(self, args.get(i)) { return false; }
                    i = i + 1;
                }
                return true;
            }
            return false;
        }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if !TypeChecker_is_send_type(self, types.get(i)) { return false; }
                i = i + 1;
            }
            return true;
        }
        Type::Array(elem, _) => { return TypeChecker_is_send_type(self, box_type_unbox(elem)); }
        Type::ArrayConst(elem, _) => { return TypeChecker_is_send_type(self, box_type_unbox(elem)); }
        Type::Ref(_, _) => { return false; }
        Type::RawPtr(_, _) => { return false; }
        Type::Infer => { return true; }
        _ => { return true; }
    }
    return true;
}

pub fn TypeChecker_is_sync_type(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::I64 => { return true; }
        Type::I32 => { return true; }
        Type::I8 => { return true; }
        Type::F64 => { return true; }
        Type::F32 => { return true; }
        Type::Bool => { return true; }
        Type::Str => { return true; }
        Type::Void => { return true; }
        Type::Never => { return true; }
        Type::Named(name) => { return tc_str_vec_contains(self.sync_structs, name); }
        Type::Generic(name, args) => {
            if tc_str_vec_contains(self.sync_structs, name) { return true; }
            if name == "Mutex" || name == "Channel" { return true; }
            if name == "Vec" || name == "HashMap" || name == "String" || name == "Option" || name == "Result" || name == "Future" {
                var i: i64 = 0;
                while i < args.len() {
                    if !TypeChecker_is_sync_type(self, args.get(i)) { return false; }
                    i = i + 1;
                }
                return true;
            }
            return false;
        }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if !TypeChecker_is_sync_type(self, types.get(i)) { return false; }
                i = i + 1;
            }
            return true;
        }
        Type::Array(elem, _) => { return TypeChecker_is_sync_type(self, box_type_unbox(elem)); }
        Type::ArrayConst(elem, _) => { return TypeChecker_is_sync_type(self, box_type_unbox(elem)); }
        Type::Ref(inner, is_mut) => {
            if !is_mut { return TypeChecker_is_sync_type(self, box_type_unbox(inner)); }
            return false;
        }
        Type::RawPtr(_, _) => { return false; }
        Type::Infer => { return true; }
        _ => { return true; }
    }
    return true;
}

// --- consume_var ---------------------------------------------------------

pub fn TypeChecker_consume_var(self: &mut TypeChecker, name: str, line: i64) {
    if self.loop_depth > 0 {
        self.errors.push("Linear type error (line " + int_to_str(line) + "): variable '" + name + "' cannot be consumed inside a loop."
            + "\n    Linear values can only be used once — consuming them inside a loop\n    would fail on the second iteration. Move the consumption outside"
            + "\n    the loop, or use a non-linear type.");
    }
    if tc_str_vec_contains(self.consumed_vars, name) {
        self.errors.push("Linear type error (line " + int_to_str(line) + "): variable '" + name + "' was already consumed (moved)."
            + "\n    Linear values can only be used once. After being passed to a function,\n    returned, or moved, they cannot be used again."
            + "\n    Fix: use a different variable, or restructure the code so '" + name + "' is only used once.");
    } else {
        self.consumed_vars.push(name);
    }
}

// --- consume_linear_in_expr ----------------------------------------------

pub fn TypeChecker_consume_linear_in_expr(self: &mut TypeChecker, expr: Expr, line: i64) {
    match expr {
        Expr::Ident(name) => {
            var lk: OptType = TypeChecker_lookup(self, name);
            match lk {
                OptType::Some(ty) => {
                    if TypeChecker_is_linear_type(self, ty) {
                        TypeChecker_consume_var(self, name, line);
                    }
                }
                OptType::None => { }
            }
        }
        Expr::Binary(_, left, right) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(left), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(right), line);
        }
        Expr::Unary(_, e) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        Expr::Call(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_consume_linear_in_expr(self, args.get(i), line);
                i = i + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(receiver), line);
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_consume_linear_in_expr(self, args.get(i), line);
                i = i + 1;
            }
        }
        Expr::StructLit(_, fields, spread) => {
            var i: i64 = 0;
            while i < fields.len() {
                TypeChecker_consume_linear_in_expr(self, fields.get(i).value, line);
                i = i + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { TypeChecker_consume_linear_in_expr(self, box_expr_unbox(s), line); }
                OptBoxExpr::None => {}
            }
        }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_consume_linear_in_expr(self, elements.get(i), line);
                i = i + 1;
            }
        }
        Expr::TupleLit(elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_consume_linear_in_expr(self, elements.get(i), line);
                i = i + 1;
            }
        }
        Expr::Deref(e) => { TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line); }
        Expr::Cast(e, _) => { TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line); }
        Expr::Coalesce(e, d) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(d), line);
        }
        Expr::Try(e) => { TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line); }
        Expr::StrConcat(l, r) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(l), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(r), line);
        }
        Expr::Range(s, e, _) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(s), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        Expr::Closure(params, body, _) => {
            // A closure can be called any number of times, so it must not
            // capture a linear value (each call could use it again).
            var used: Vec<str> = Vec::new();
            esc_idents_stmts(body, &mut used);
            var captured: Vec<str> = Vec::new();
            var ui: i64 = 0;
            while ui < used.len() {
                var name: str = used.get(ui);
                var is_param: bool = false;
                var pi: i64 = 0;
                while pi < params.len() {
                    if params.get(pi).name == name { is_param = true; }
                    pi = pi + 1;
                }
                if !is_param {
                    match TypeChecker_lookup(self, name) {
                        OptType::Some(t) => { if TypeChecker_is_linear_type(self, t) { captured = tc_insert_sorted(captured, name); } }
                        OptType::None => {}
                    }
                }
                ui = ui + 1;
            }
            var ci: i64 = 0;
            while ci < captured.len() {
                var cn: str = captured.get(ci);
                self.errors.push("Linear type error (line " + int_to_str(line) + "): a closure captures linear variable '" + cn + "'.
    A closure can be called more than once, so it could use '" + cn + "' twice.
    Fix: pass '" + cn + "' to the closure as an argument instead.");
                ci = ci + 1;
            }
        }
        _ => {}
    }
}

// A new Vec with `s` inserted in byte order (as Rust sorts Strings).
fn tc_insert_sorted(v: Vec<str>, s: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var placed: bool = false;
    var i: i64 = 0;
    while i < v.len() {
        if !placed && str_compare(s, v.get(i)) < 0 {
            out.push(s);
            placed = true;
        }
        out.push(v.get(i));
        i = i + 1;
    }
    if !placed { out.push(s); }
    return out;
}

// ---- CHUNK_MARKER_6 ----

// --- check_stmt ----------------------------------------------------------

pub fn TypeChecker_check_stmt(self: &mut TypeChecker, stmt: Stmt) {
    // Recursion depth guard -- prevents stack overflow on deeply nested statements
    self.check_depth = self.check_depth + 1;
    if self.check_depth > 512 {
        self.errors.push("Error: typechecker recursion limit exceeded (512) -- statement too deeply nested");
        self.check_depth = self.check_depth - 1;
        return;
    }

    TypeChecker_check_stmt_inner(self, stmt);
    self.check_depth = self.check_depth - 1;
}

fn TypeChecker_check_stmt_inner(self: &mut TypeChecker, stmt: Stmt) {
    // Track current line for error messages
    self.current_line = stmt_line(stmt);
    match stmt {
        Stmt::Let(name, ty, expr, is_mut, _, annotations, line) => {
            // `var v = v;` makes a local copy that may be changed
            TypeChecker_forget_value_param(self, name);
            // Bidirectional type inference: pass declared type as hint
            var hint: Type = Type::Never;
            match ty {
                OptType::Some(t) => { hint = t; }
                OptType::None => { hint = Type::Never; }
            }
            var expr_ty: Type = TypeChecker_check_expr_with_hint(self, expr, hint);
            TypeChecker_consume_linear_in_expr(self, expr, line);
            var final_ty: Type = expr_ty;
            match ty {
                OptType::Some(declared) => {
                    TypeChecker_check_value_fits(self, declared, expr_ty, expr, line);
                    if !TypeChecker_types_compatible(self, declared, expr_ty) && !(is_runtime_layer(self.current_module) && is_handle_int_pair(declared, expr_ty)) {
                        self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign " + type_to_str(expr_ty) + " to variable '" + name + "' of type " + type_to_str(declared) + "."
                            + "\n    Expected: " + type_to_str(declared) + "\n    Found:    " + type_to_str(expr_ty)
                            + "\n    Fix: change the type annotation or the expression.");
                    }
                    final_ty = declared;
                }
                OptType::None => {
                    final_ty = expr_ty;
                    // `var i = 0` is an i64: the literal's size says nothing
                    // about what the variable will hold
                    if tc_is_constant_expr(expr) && tc_int_bits(expr_ty) > 0 && tc_int_bits(expr_ty) < 64 {
                        final_ty = Type::I64;
                    }
                }
            }
            // Track val (immutable) bindings. A `var` of the same name is
            // recorded as `!name`: it shadows an outer `val`.
            if self.val_vars_per_scope.len() > 0 {
                var scope: Vec<str> = self.val_vars_per_scope.pop();
                if is_mut {
                    str_vec_remove(&mut scope, name);
                    scope.push("!" + name);
                } else {
                    str_vec_remove(&mut scope, "!" + name);
                    scope.push(name);
                }
                self.val_vars_per_scope.push(scope);
            }
            // Track region: if inside a region block, record the allocation region
            if self.region_stack.len() > 0 {
                var region: str = self.region_stack.get(self.region_stack.len() - 1);
                map_str_str_set(&mut self.var_regions, name, region);
                map_str_str_set(&mut self.var_alloc_lines, name, int_to_str(line));
                var size: i64 = TypeChecker_type_size(self, final_ty);
                if self.region_budgets.len() > 0 {
                    var budget: RegionBudget = self.region_budgets.pop();
                    budget.usage = budget.usage + size;
                    self.region_budgets.push(budget);
                }
            }
            // Track linear variables
            if TypeChecker_is_linear_type(self, final_ty) {
                if self.scope_linear_vars.len() > 0 {
                    var scope: Vec<LinearVar> = self.scope_linear_vars.pop();
                    scope.push(LinearVar_new(name, line));
                    self.scope_linear_vars.push(scope);
                }
            }
            TypeChecker_declare(self, name, final_ty);
        }
        Stmt::LetTuple(names, expr, line) => {
            var expr_ty: Type = TypeChecker_check_expr(self, expr);
            TypeChecker_consume_linear_in_expr(self, expr, line);
            match expr_ty {
                Type::Tuple(elem_types) => {
                    if names.len() != elem_types.len() {
                        self.errors.push("Type error (line " + int_to_str(line) + "): tuple destructuring expects " + int_to_str(names.len()) + " names but expression has " + int_to_str(elem_types.len()) + " elements");
                    }
                    var i: i64 = 0;
                    while i < names.len() && i < elem_types.len() {
                        var elem_ty: Type = elem_types.get(i);
                        if TypeChecker_is_linear_type(self, elem_ty) {
                            if self.scope_linear_vars.len() > 0 {
                                var scope: Vec<LinearVar> = self.scope_linear_vars.pop();
                                scope.push(LinearVar_new(names.get(i), line));
                                self.scope_linear_vars.push(scope);
                            }
                        }
                        TypeChecker_declare(self, names.get(i), elem_ty);
                        i = i + 1;
                    }
                }
                _ => {
                    self.errors.push("Type error (line " + int_to_str(line) + "): cannot destructure " + type_to_str(expr_ty) + " as a tuple");
                }
            }
        }
        Stmt::LetUninit(name, ty, _annotations, line) => {
            var resolved_ty: Type = TypeChecker_resolve_type(self, ty);
            TypeChecker_declare(self, name, resolved_ty);
            self.uninit_vars.push(name);
            if TypeChecker_is_linear_type(self, resolved_ty) {
                if self.scope_linear_vars.len() > 0 {
                    var scope: Vec<LinearVar> = self.scope_linear_vars.pop();
                    scope.push(LinearVar_new(name, line));
                    self.scope_linear_vars.push(scope);
                }
            }
        }
        Stmt::Expr(expr, line) => {
            TypeChecker_check_expr(self, expr);
            TypeChecker_consume_linear_in_expr(self, expr, line);
        }
        Stmt::Return(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => {
                    // The declared return type is the expected type
                    var ret_hint: Type = Type::Never;
                    match self.current_ret_ty {
                        OptType::Some(rt) => { ret_hint = TypeChecker_resolve_self_type(self, rt); }
                        OptType::None => {}
                    }
                    var ret_ty: Type = TypeChecker_check_expr_with_hint(self, box_expr_unbox(e), ret_hint);
                    TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), self.current_line);
                    TypeChecker_check_return_type(self, ret_ty);
                    self.current_return_types.push(ret_ty);
                }
                OptBoxExpr::None => {
                    TypeChecker_check_return_type(self, Type::Void);
                    self.current_return_types.push(Type::Void);
                }
            }
        }
        Stmt::If(cond, then_block, else_block, line) => {
            var cond_ty: Type = TypeChecker_check_expr(self, cond);
            TypeChecker_consume_linear_in_expr(self, cond, line);
            if !type_eq(cond_ty, Type::Bool) && !type_eq(cond_ty, Type::I32) && !type_eq(cond_ty, Type::I64) {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): if condition must be bool, got " + type_to_str(cond_ty));
            }
            var consumed_before: Vec<str> = self.consumed_vars.clone();
            var uninit_before: Vec<str> = self.uninit_vars.clone();
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < then_block.len() {
                TypeChecker_check_stmt(self, then_block.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            var consumed_after_then: Vec<str> = self.consumed_vars.clone();
            var uninit_after_then: Vec<str> = self.uninit_vars.clone();
            // Restore to before-then state for else branch
            self.consumed_vars = consumed_before;
            self.uninit_vars = uninit_before;
            match else_block {
                OptStmts::Some(else_b) => {
                    TypeChecker_push_scope(self);
                    var si2: i64 = 0;
                    while si2 < else_b.len() {
                        TypeChecker_check_stmt(self, else_b.get(si2));
                        si2 = si2 + 1;
                    }
                    TypeChecker_pop_scope(self);
                }
                OptStmts::None => {}
            }
            // Merge: intersection of consumed_vars (consumed in BOTH branches)
            var merged: Vec<str> = Vec::new();
            var ci: i64 = 0;
            while ci < consumed_after_then.len() {
                if tc_str_vec_contains(self.consumed_vars, consumed_after_then.get(ci)) {
                    merged.push(consumed_after_then.get(ci));
                }
                ci = ci + 1;
            }
            self.consumed_vars = merged;
            // Merge: union of uninit_vars (uninit in either branch)
            var merged_uninit: Vec<str> = uninit_after_then.clone();
            var ui: i64 = 0;
            while ui < self.uninit_vars.len() {
                if !tc_str_vec_contains(merged_uninit, self.uninit_vars.get(ui)) {
                    merged_uninit.push(self.uninit_vars.get(ui));
                }
                ui = ui + 1;
            }
            self.uninit_vars = merged_uninit;
        }
        Stmt::Assign(target, _, expr, line) => {
            var assigned_ty: Type = TypeChecker_check_expr(self, expr);
            match TypeChecker_lookup(self, target) {
                OptType::Some(target_ty) => { TypeChecker_check_value_fits(self, target_ty, assigned_ty, expr, line); }
                OptType::None => {
                    if self.current_module == "main" {
                        match TypeChecker_lookup_global_cache(self, target) {
                            OptType::Some(_) => {
                                self.write_funcs.push(self.checking_fn);
                                self.write_globals.push(target);
                                self.write_lines.push(line);
                            }
                            OptType::None => {}
                        }
                    }
                }
            }
            TypeChecker_consume_linear_in_expr(self, expr, line);
            // Inline str_vec_remove to avoid &mut self.field issues
            var ri: i64 = 0;
            while ri < self.uninit_vars.len() {
                if self.uninit_vars.get(ri) == target {
                    self.uninit_vars.remove(ri);
                    ri = self.uninit_vars.len();
                }
                ri = ri + 1;
            }
            // `val` bindings are immutable; the innermost declaration decides.
            if TypeChecker_is_val(self, target) {
                self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign to '" + target + "': it is declared with `val`.\n    Fix: declare it with `var` if you need to mutate it.");
            }
            // Check target exists
            match TypeChecker_lookup(self, target) {
                OptType::Some(ty) => {
                    // Re-assigning a linear variable: old value must have been consumed
                    if TypeChecker_is_linear_type(self, ty) && !tc_str_vec_contains(self.consumed_vars, target) {
                        self.errors.push("Linear type error (line " + int_to_str(line) + "): cannot reassign '" + target + "' -- the old value would be silently destroyed");
                    }
                    if TypeChecker_is_linear_type(self, ty) {
                        var ci: i64 = 0;
                        while ci < self.consumed_vars.len() {
                            if self.consumed_vars.get(ci) == target {
                                self.consumed_vars.remove(ci);
                                ci = self.consumed_vars.len();
                            }
                            ci = ci + 1;
                        }
                    }
                }
                OptType::None => {
                    // A constant has no storage to assign to
                    if map_str_type_contains(self.consts, target) {
                        self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign to constant '" + target + "'");
                    }
                    if !map_str_type_contains(self.consts, target) && !map_str_type_contains(self.globals, target) {
                        self.errors.push("Type error: cannot assign to undefined variable '" + target + "'");
                    }
                }
            }
        }
        Stmt::IndexAssign(array, index, _, expr, _) => {
            TypeChecker_check_param_change(self, array);
            TypeChecker_check_expr(self, index);
            TypeChecker_check_expr(self, expr);
            match TypeChecker_lookup(self, array) {
                OptType::Some(_) => {}
                OptType::None => {
                    self.errors.push("Type error: cannot index undefined variable '" + array + "'");
                }
            }
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            match TypeChecker_check_expr(self, ptr_expr) {
                Type::RawPtr(_, _) => { TypeChecker_require_unsafe(self, "writing through a raw pointer"); }
                _ => {}
            }
            TypeChecker_check_expr(self, expr);
        }
        Stmt::FieldAssign(object, field, op, expr, line) => {
            self.current_line = line;
            TypeChecker_check_param_change(self, tc_place_root(object));
            var obj_ty: Type = TypeChecker_check_expr(self, object);
            self.current_line = line;
            // Unwrap references
            var effective_ty: Type = obj_ty;
            match obj_ty {
                Type::Ref(inner, _) => { effective_ty = unbox_ty(box_type_unbox(inner)); }
                _ => { effective_ty = unbox_ty(obj_ty); }
            }
            match effective_ty {
                Type::Named(name) => {
                    // Find field type
                    var field_ty: OptType = OptType::None;
                    var si: i64 = TypeChecker_struct_pos(self, name);
                    var si_lim: i64 = si + 1;
                    if si < 0 { si = 0; si_lim = 0; }
                    while si < si_lim {
                        if self.structs.get(si).key == name {
                            var fields: Vec<StructField> = self.structs.get(si).val;
                            var fi: i64 = 0;
                            while fi < fields.len() {
                                if fields.get(fi).name == field {
                                    field_ty = OptType::Some(fields.get(fi).ty);
                                    break;
                                }
                                fi = fi + 1;
                            }
                            break;
                        }
                        si = si + 1;
                    }
                    match field_ty {
                        OptType::Some(fty) => {
                            var expr_ty: Type = TypeChecker_check_expr(self, expr);
                            TypeChecker_consume_linear_in_expr(self, expr, line);
                            var compatible: bool = type_eq(expr_ty, fty) || type_eq(expr_ty, Type::Never) || (TypeChecker_is_integer(self, expr_ty) && TypeChecker_is_integer(self, fty)) || TypeChecker_types_compatible(self, fty, expr_ty);
                            if !compatible {
                                self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign " + type_to_str(expr_ty) + " to field '" + field + "' of type " + type_to_str(fty));
                            }
                        }
                        OptType::None => {
                            self.errors.push("Type error (line " + int_to_str(line) + "): struct '" + name + "' has no field '" + field + "'");
                            TypeChecker_check_expr(self, expr);
                        }
                    }
                }
                _ => {
                    self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign field '" + field + "' on type " + type_to_str(obj_ty));
                    TypeChecker_check_expr(self, expr);
                }
            }
        }
        Stmt::While(cond, body, _) => {
            var cond_ty: Type = TypeChecker_check_expr(self, cond);
            if !type_eq(cond_ty, Type::Bool) && !type_eq(cond_ty, Type::I32) && !type_eq(cond_ty, Type::I64) {
                self.errors.push("Type error: while condition must be bool, got " + type_to_str(cond_ty));
            }
            TypeChecker_push_scope(self);
            self.loop_depth = self.loop_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.loop_depth = self.loop_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::For(var_name, iterator, body, _) => {
            var iter_ty: Type = TypeChecker_check_expr(self, iterator);
            // Extract element type
            var elem_ty: Type = iter_ty;
            match iter_ty {
                Type::Generic(name, args) => {
                    if name == "Vec" {
                        if args.len() > 0 { elem_ty = args.get(0); } else { elem_ty = Type::I64; }
                    } else if name == "HashMap" {
                        if args.len() > 0 { elem_ty = args.get(0); } else { elem_ty = Type::Str; }
                    }
                }
                Type::Named(name) => {
                    if name == "Vec" { elem_ty = Type::I64; }
                }
                Type::Array(elem, _) => { elem_ty = elem; }
                _ => { elem_ty = iter_ty; }
            }
            TypeChecker_push_scope(self);
            TypeChecker_declare(self, var_name, elem_ty);
            self.loop_depth = self.loop_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.loop_depth = self.loop_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::Loop(body, _) => {
            TypeChecker_push_scope(self);
            self.loop_depth = self.loop_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.loop_depth = self.loop_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::Break(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => { TypeChecker_check_expr(self, box_expr_unbox(e)); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::Continue(_) => {}
        Stmt::Defer(body, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::Match(expr, arms, line) => {
            var match_ty: Type = unbox_ty(TypeChecker_check_expr(self, expr));
            TypeChecker_check_exhaustive(self, match_ty, arms, line);
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                TypeChecker_push_scope(self);
                // Bind pattern variables
                match arm.pattern {
                    Pattern::Ident(name) => {
                        TypeChecker_declare(self, name, match_ty);
                    }
                    Pattern::EnumVariant(enum_name, variant, bindings) => {
                        TypeChecker_check_enum_pattern(self, match_ty, enum_name, variant, bindings);
                        var tys: Vec<Type> = TypeChecker_pattern_binding_types(self, match_ty, enum_name, variant, bindings);
                        var bi: i64 = 0;
                        while bi < bindings.len() && bi < tys.len() {
                            TypeChecker_declare(self, bindings.get(bi).name, tys.get(bi));
                            bi = bi + 1;
                        }
                    }
                    Pattern::StrLit(_) => {}
                    Pattern::Range(_, _) => {}
                    _ => {}
                }
                // Check guard
                match arm.guard {
                    OptBoxExpr::Some(g) => { TypeChecker_check_expr(self, box_expr_unbox(g)); }
                    OptBoxExpr::None => {}
                }
                // Check body
                var si: i64 = 0;
                while si < arm.body.len() {
                    TypeChecker_check_stmt(self, arm.body.get(si));
                    si = si + 1;
                }
                TypeChecker_pop_scope(self);
                ai = ai + 1;
            }
        }
        Stmt::Use(_, _, _) => {}
        Stmt::Handle(body, handlers, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            var hi: i64 = 0;
            while hi < handlers.len() {
                var handler: EffectHandler = handlers.get(hi);
                TypeChecker_push_scope(self);
                var pi: i64 = 0;
                while pi < handler.params.len() {
                    TypeChecker_declare(self, handler.params.get(pi), Type::I64);
                    pi = pi + 1;
                }
                // L3A: `cont`, the continuation, is in scope in handler
                // bodies for resume(cont, value).
                TypeChecker_declare(self, "cont", Type::I64);
                var si2: i64 = 0;
                while si2 < handler.body.len() {
                    TypeChecker_check_stmt(self, handler.body.get(si2));
                    si2 = si2 + 1;
                }
                TypeChecker_pop_scope(self);
                hi = hi + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_check_expr(self, args.get(ai));
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(name, budget, is_gpu, is_kv_cache, _, body, line) => {
            self.region_stack.push(name);
            TypeChecker_push_scope(self);
            var new_rb: RegionBudget = RegionBudget_new(name, budget, 0);
            new_rb.kv = is_kv_cache;
            new_rb.loop0 = self.loop_depth;
            self.region_budgets.push(new_rb);
            map_str_str_set(&mut self.region_lines, name, int_to_str(line));
            if is_gpu { self.gpu_region_depth = self.gpu_region_depth + 1; }
            if is_kv_cache {
                match budget {
                    OptI64::None => {
                        self.errors.push("KV cache region error (line " + int_to_str(line) + "): 'region kv_cache " + name + "' must have a budget."
                            + "\n    KV cache regions exist to prevent OOM in LLM serving.\n    Without a budget, the cache can grow unboundedly and crash."
                            + "\n    Fix: add a budget: `region kv_cache " + name + " with budget(N) { ... }`.");
                    }
                    OptI64::Some(_) => {}
                }
            }
            // Track variables reassigned inside the region (flow-sensitive).
            var reassigned_in_region: Vec<str> = Vec::new();
            var si: i64 = 0;
            while si < body.len() {
                var s: Stmt = body.get(si);
                match s {
                    Stmt::Assign(target, _, _, _) => {
                        if !tc_vec_contains_str(reassigned_in_region, target) {
                            reassigned_in_region.push(target);
                        }
                    }
                    Stmt::FieldAssign(object, _, _, _, _) => {
                        match object {
                            Expr::Ident(n) => {
                                if !tc_vec_contains_str(reassigned_in_region, n) {
                                    reassigned_in_region.push(n);
                                }
                            }
                            _ => {}
                        }
                    }
                    _ => {}
                }
                TypeChecker_check_stmt(self, s);
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            self.region_stack.pop();
            if is_gpu { self.gpu_region_depth = self.gpu_region_depth - 1; }
            self.freed_regions.push(name);
            // Check memory budget
            if self.region_budgets.len() > 0 {
                var rb: RegionBudget = self.region_budgets.pop();
                match rb.budget {
                    OptI64::Some(b) => {
                        if rb.usage > b {
                            var rkind: str = "";
                            var rkw: str = "";
                            if is_gpu { rkind = "GPU "; rkw = " gpu"; } else if is_kv_cache { rkind = "KV cache "; rkw = " kv_cache"; }
                            self.errors.push("Budget error (line " + int_to_str(line) + "): " + rkind + "region '" + name + "' used " + int_to_str(rb.usage)
                                + " bytes but budget is " + int_to_str(b) + " bytes (" + int_to_str(rb.usage - b) + " bytes over)."
                                + "\n    Hint: reduce allocations inside the " + rkind + "region block, or increase the budget in `region"
                                + rkw + " " + name + " with budget(" + int_to_str(b) + ") { ... }`.");
                        }
                        if rb.heap != "" && !rb.kv {
                            var hkind: str = "";
                            if is_gpu { hkind = "GPU "; }
                            self.errors.push("Budget error (line " + int_to_str(line) + "): " + hkind + "region '" + name + "' with budget(" + int_to_str(b)
                                + ") allocates on the heap: " + rb.heap + ".\n    The budget is checked at compile time. It counts the region's locals and heap allocations"
                                + "\n    of a size known at compile time (p_malloc(N), Vec::new(), an f-string of numbers),"
                                + "\n    not ones that can grow (push, insert, string `+`, an allocation in a loop, a call that allocates)."
                                + "\n    Fix: allocate before the region, or use a fixed-size buffer.");
                        }
                    }
                    OptI64::None => {}
                }
            }
        }
        Stmt::Sandbox(body, _) => {
            TypeChecker_push_scope(self);
            self.sandbox_depth = self.sandbox_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.sandbox_depth = self.sandbox_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::Unsafe(body, _) => {
            TypeChecker_push_scope(self);
            self.unsafe_depth = self.unsafe_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.unsafe_depth = self.unsafe_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::Txn(body, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::ComptimeGen(_, _) => {}
        Stmt::GradBlock(_, body, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::Backward(loss, _) => {
            var loss_ty: Type = TypeChecker_check_expr(self, loss);
            var is_f64: bool = type_eq(loss_ty, Type::F64);
            var is_tensor: bool = false;
            match loss_ty {
                Type::Named(name) => { if name == "Tensor" { is_tensor = true; } }
                Type::Generic(name, _) => { if name == "Tensor" { is_tensor = true; } }
                Type::ShapedTensor(_, _) => { is_tensor = true; }
                _ => {}
            }
            if !is_f64 && !is_tensor {
                self.errors.push("Type error: backward() loss must be F64 or Tensor, got " + type_to_str(loss_ty));
            }
        }
        Stmt::Query(_, body, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                var case: SelectCase = cases.get(ci);
                TypeChecker_check_expr(self, case.channel);
                TypeChecker_push_scope(self);
                TypeChecker_declare(self, case.var_name, Type::I64);
                var si: i64 = 0;
                while si < case.body.len() {
                    TypeChecker_check_stmt(self, case.body.get(si));
                    si = si + 1;
                }
                TypeChecker_pop_scope(self);
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(def_body) => {
                    TypeChecker_push_scope(self);
                    var si: i64 = 0;
                    while si < def_body.len() {
                        TypeChecker_check_stmt(self, def_body.get(si));
                        si = si + 1;
                    }
                    TypeChecker_pop_scope(self);
                }
                OptStmts::None => {}
            }
        }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                TypeChecker_push_scope(self);
                var si: i64 = 0;
                while si < branch.len() {
                    TypeChecker_check_stmt(self, branch.get(si));
                    si = si + 1;
                }
                TypeChecker_pop_scope(self);
                bi = bi + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            TypeChecker_check_expr(self, cont);
            TypeChecker_check_expr(self, value);
        }
        Stmt::SpawnScope(body, _) => {
            TypeChecker_push_scope(self);
            var si5: i64 = 0;
            while si5 < body.len() {
                TypeChecker_check_stmt(self, body.get(si5));
                si5 = si5 + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::CancelScope(_) => {}
    }
}

// ---- CHUNK_MARKER_7 ----

// --- collect_captured_vars ----------------------------------------------
// Walks an expression tree and collects (name, type) pairs for all
// in-scope variables referenced (Idents that resolve to local vars).
// Used by the @send check on spawn expressions.

// Names and types are kept in two parallel Vecs: a Vec of tuples held
// pointers to stack temporaries (crash in is_send_type).
pub fn TypeChecker_collect_captured_vars(self: &TypeChecker, expr: Expr, cap_names: &mut Vec<str>, cap_types: &mut Vec<Type>) {
    match expr {
        Expr::Ident(name) => {
            var ty_opt: OptType = TypeChecker_lookup(self, name);
            match ty_opt {
                OptType::Some(ty) => {
                    var found: bool = false;
                    var i: i64 = 0;
                    while i < cap_names.len() {
                        if cap_names.get(i) == name { found = true; }
                        i = i + 1;
                    }
                    if !found {
                        cap_names.push(name);
                        cap_types.push(ty);
                    }
                }
                OptType::None => {} // not a local var
            }
        }
        Expr::Call(callee, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_collect_captured_vars(self, args.get(ai), cap_names, cap_types);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(recv, _method, args) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(recv), cap_names, cap_types);
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_collect_captured_vars(self, args.get(ai), cap_names, cap_types);
                ai = ai + 1;
            }
        }
        Expr::Binary(_op, left, right) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(left), cap_names, cap_types);
            TypeChecker_collect_captured_vars(self, box_expr_unbox(right), cap_names, cap_types);
        }
        Expr::Unary(_op, e) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        Expr::Index(arr, idx) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(arr), cap_names, cap_types);
            TypeChecker_collect_captured_vars(self, box_expr_unbox(idx), cap_names, cap_types);
        }
        Expr::FieldAccess(e, _field) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        Expr::OptionalFieldAccess(e, _field) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        Expr::Ref(e, _is_mut) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        Expr::Deref(e) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        Expr::Try(e) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        Expr::Coalesce(e, def) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
            TypeChecker_collect_captured_vars(self, box_expr_unbox(def), cap_names, cap_types);
        }
        Expr::Cast(e, _ty) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        Expr::Await(e) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        Expr::StrConcat(left, right) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(left), cap_names, cap_types);
            TypeChecker_collect_captured_vars(self, box_expr_unbox(right), cap_names, cap_types);
        }
        Expr::PipeForward(left, right) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(left), cap_names, cap_types);
            TypeChecker_collect_captured_vars(self, box_expr_unbox(right), cap_names, cap_types);
        }
        Expr::ArrayLit(_ty, elems) => {
            var ei: i64 = 0;
            while ei < elems.len() {
                TypeChecker_collect_captured_vars(self, elems.get(ei), cap_names, cap_types);
                ei = ei + 1;
            }
        }
        Expr::TupleLit(elems) => {
            var ei: i64 = 0;
            while ei < elems.len() {
                TypeChecker_collect_captured_vars(self, elems.get(ei), cap_names, cap_types);
                ei = ei + 1;
            }
        }
        Expr::StructLit(_name, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                TypeChecker_collect_captured_vars(self, fields.get(fi).value, cap_names, cap_types);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(s), cap_names, cap_types); }
                OptBoxExpr::None => {}
            }
        }
        Expr::Spawn(e) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        Expr::Yield(e) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        Expr::NamedArg(name, e) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        Expr::Comptime(e) => { TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types); }
        _ => {}
    }
}

// --- check_expr ----------------------------------------------------------

pub fn TypeChecker_check_expr(self: &mut TypeChecker, expr: Expr) -> Type {
    return TypeChecker_check_expr_with_hint(self, expr, Type::Never);
}

pub fn TypeChecker_check_expr_with_hint(self: &mut TypeChecker, expr: Expr, hint: Type) -> Type {
    // Recursion depth guard -- prevents stack overflow on deeply nested expressions
    self.check_depth = self.check_depth + 1;
    if self.check_depth > 512 {
        self.errors.push("Error: typechecker recursion limit exceeded (512) -- expression too deeply nested");
        self.check_depth = self.check_depth - 1;
        return Type::Never;
    }

    var result: Type = TypeChecker_check_expr_inner(self, expr, hint);
    self.check_depth = self.check_depth - 1;
    return result;
}

fn TypeChecker_check_expr_inner(self: &mut TypeChecker, expr: Expr, hint: Type) -> Type {
    match expr {
        Expr::IntLit(v) => {
            // Bidirectional: if hint is an integer type, use it directly
            match hint {
                Type::I8 => { return Type::I8; }
                Type::I16 => { return Type::I16; }
                Type::I32 => { return Type::I32; }
                Type::I64 => { return Type::I64; }
                Type::U8 => { return Type::U8; }
                Type::U16 => { return Type::U16; }
                Type::U32 => { return Type::U32; }
                Type::U64 => { return Type::U64; }
                _ => { return infer_int_type(v); }
            }
            return infer_int_type(v);
        }
        Expr::FloatLit(_) => {
            match hint {
                Type::F32 => { return Type::F32; }
                _ => { return Type::F64; }
            }
            return Type::F64;
        }
        Expr::StringLit(_) => { return Type::Str; }
        Expr::BoolLit(_) => { return Type::Bool; }
        Expr::Ident(name) => {
            // F63: init guarantee -- check if variable is read before assignment
            if tc_str_vec_contains(self.uninit_vars, name) {
                self.errors.push("Init error: variable '" + name + "' is used before being assigned a value."
                    + "\n    It was declared with `var` (uninitialized mutable)."
                    + "\n    Fix: assign a value to '" + name + "' before reading it, or use `val " + name + " = ...` to initialize at declaration.");
            }
            match TypeChecker_lookup(self, name) {
                OptType::Some(ty) => { return ty; }
                OptType::None => {}
            }
            match TypeChecker_lookup_const_cache(self, name) {
                OptType::Some(ty) => {
                    TypeChecker_check_visibility(self, name);
                    return ty;
                }
                OptType::None => {}
            }
            // Check module-level mutable globals
            match TypeChecker_lookup_global_cache(self, name) {
                OptType::Some(ty) => {
                    TypeChecker_check_visibility(self, name);
                    return ty;
                }
                OptType::None => {}
            }
            // Check if it's a function name -- return function type
            // OPTIMIZATION: use cached lookup instead of O(n) linear scan
            match TypeChecker_lookup_func_cache(self, name) {
                OptFuncSig::Some(sig) => {
                    TypeChecker_check_visibility(self, name);
                    return Type::Func(sig.param_types, Box::new(sig.ret_ty));
                }
                OptFuncSig::None => {}
            }
            if TypeChecker_first_report(self, name) {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): undefined variable '" + name + "'");
            }
            return Type::Never;
        }
        Expr::Binary(op, left, right) => {
            var lt: Type = TypeChecker_check_expr_with_hint(self, box_expr_unbox(left), hint);
            var rt: Type = TypeChecker_check_expr_with_hint(self, box_expr_unbox(right), hint);
            var lt_r: Type = TypeChecker_resolve_type(self, lt);
            var rt_r: Type = TypeChecker_resolve_type(self, rt);
            // An element of a bare Vec has no declared type: it takes the
            // other operand's.
            if type_eq(lt_r, Type::Infer) && type_eq(rt_r, Type::Infer) {
                lt_r = Type::I64;
                rt_r = Type::I64;
            } else if type_eq(lt_r, Type::Infer) {
                lt_r = rt_r;
            } else if type_eq(rt_r, Type::Infer) {
                rt_r = lt_r;
            }
            lt = lt_r;
            rt = rt_r;
            // A borrowed string reads as a string: `+` makes a new, owned one (M11)
            if tc_is_borrowed_str(lt) { lt = Type::Str; lt_r = Type::Str; }
            if tc_is_borrowed_str(rt) { rt = Type::Str; rt_r = Type::Str; }
            if self.region_budgets.len() > 0 && binop_eq(op, BinOp::Add)
                && (type_eq(lt_r, Type::Str) || type_eq(rt_r, Type::Str) || type_eq(lt_r, Type::Named("String"))) {
                TypeChecker_budget_heap(self, "string `+`", -1);
            }
            // A str is text: comparing it with a number has no meaning outside
            // the runtime layer and the compiler, where a str is a word
            var is_cmp: bool = binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt)
                || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq);
            if is_cmp && !is_runtime_layer(self.current_module) && !str_starts_with(self.current_module, "compiler")
                && ((type_eq(lt_r, Type::Str) && TypeChecker_is_numeric(self, rt_r))
                    || (type_eq(rt_r, Type::Str) && TypeChecker_is_numeric(self, lt_r))) {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): cannot compare a str with a number (" + type_to_str(lt_r)
                    + " with " + type_to_str(rt_r) + ").\n    `==` on a str compares text, and a str is never null: a builtin that can fail gives an Option (read_file, env_var, arg_at, read_line). To compare with a number, convert one side with `as` or int_to_str.");
                return Type::Bool;
            }
            match op {
                BinOp::Add => {}
                BinOp::Sub => {}
                BinOp::Mul => {}
                BinOp::Div => {}
                BinOp::Mod => {}
                BinOp::Eq => { return Type::Bool; }
                BinOp::Neq => { return Type::Bool; }
                BinOp::Lt => { return Type::Bool; }
                BinOp::Gt => { return Type::Bool; }
                BinOp::LtEq => { return Type::Bool; }
                BinOp::GtEq => { return Type::Bool; }
                BinOp::And => {
                    if !type_eq(lt_r, Type::Bool) || !type_eq(rt_r, Type::Bool) {
                        self.errors.push("Type error: logical operators require bool, got " + type_to_str(lt_r) + " and " + type_to_str(rt_r));
                    }
                    return Type::Bool;
                }
                BinOp::Or => {
                    if !type_eq(lt_r, Type::Bool) || !type_eq(rt_r, Type::Bool) {
                        self.errors.push("Type error: logical operators require bool, got " + type_to_str(lt_r) + " and " + type_to_str(rt_r));
                    }
                    return Type::Bool;
                }
                BinOp::BitAnd => {}
                BinOp::BitOr => {}
                BinOp::BitXor => {}
                BinOp::Shl => {}
                BinOp::Shr => {}
            }
            // Operator overloading for vec types (Phase 8A): vec +/- vec of
            // one shape, vec * scalar, vec / scalar and scalar * vec.
            var is_addsub: bool = binop_eq(op, BinOp::Add) || binop_eq(op, BinOp::Sub);
            var is_arith: bool = is_addsub || binop_eq(op, BinOp::Mul) || binop_eq(op, BinOp::Div) || binop_eq(op, BinOp::Mod);
            if is_arith {
                match lt_r {
                    Type::Named(ln) => {
                        match rt_r {
                            Type::Named(rn) => {
                                if tc_is_vec_type(ln) && tc_is_vec_type(rn) {
                                    if ln == rn {
                                        if is_addsub { return lt_r; }
                                    } else {
                                        self.errors.push("Type error: shape mismatch in binary operation. Left operand: " + ln + ", Right operand: " + rn);
                                        return Type::Never;
                                    }
                                }
                            }
                            _ => {}
                        }
                        if tc_is_vec_type(ln) && TypeChecker_is_float(self, rt_r) {
                            if binop_eq(op, BinOp::Mul) || binop_eq(op, BinOp::Div) { return lt_r; }
                        }
                    }
                    _ => {}
                }
                match rt_r {
                    Type::Named(rn2) => {
                        if tc_is_vec_type(rn2) && TypeChecker_is_float(self, lt_r) && binop_eq(op, BinOp::Mul) { return rt_r; }
                    }
                    _ => {}
                }
            }
            // Arithmetic/bitwise ops
            // String concatenation with +
            if binop_eq(op, BinOp::Add) {
                if type_eq(lt_r, Type::Str) && type_eq(rt_r, Type::Str) {
                    return Type::Str;
                }
                // F68: reject typed string concatenation
                if TypeChecker_is_typed_string(self, lt_r) || TypeChecker_is_typed_string(self, rt_r) {
                    var typed: Type = rt_r;
                    if TypeChecker_is_typed_string(self, lt_r) { typed = lt_r; }
                    self.errors.push("Injection error (F68): cannot use + to concatenate typed string '" + type_to_str(typed) + "'."
                        + "\n    Typed strings prevent injection — use bind/escape methods instead."
                        + "\n    For SQLString: use sql_query() + sql_bind() instead of string +."
                        + "\n    For ShellString: use shell_cmd() + shell_escape() instead of string +.");
                    return Type::Never;
                }
            }
            // Treat str as i64 for arithmetic
            var lt_eff: Type = lt_r;
            if type_eq(lt_eff, Type::Str) { lt_eff = Type::I64; }
            var rt_eff: Type = rt_r;
            if type_eq(rt_eff, Type::Str) { rt_eff = Type::I64; }
            if TypeChecker_is_numeric(self, lt_eff) && TypeChecker_is_numeric(self, rt_eff) {
                if TypeChecker_is_integer(self, lt_eff) && TypeChecker_is_integer(self, rt_eff) {
                    return wider_type(lt_eff, rt_eff);
                }
                if type_eq(lt_eff, Type::F64) || type_eq(rt_eff, Type::F64) {
                    return Type::F64;
                }
                return Type::F32;
            }
            // never: an operand whose error is already reported (CE6)
            if !type_eq(lt_r, Type::Never) && !type_eq(rt_r, Type::Never) {
                self.errors.push("Type error: arithmetic requires numeric types. Left: " + type_to_str(lt_r) + ", Right: " + type_to_str(rt_r));
            }
            return Type::Never;
        }
        Expr::Unary(op, e) => {
            var ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
            match op {
                UnaryOp::Neg => {
                    if !TypeChecker_is_numeric(self, ty) {
                        self.errors.push("Type error: cannot negate " + type_to_str(ty));
                    }
                    return ty;
                }
                UnaryOp::Not => {
                    if !type_eq(ty, Type::Bool) {
                        self.errors.push("Type error: cannot logically negate " + type_to_str(ty));
                    }
                    return Type::Bool;
                }
                UnaryOp::BitNot => {
                    if !TypeChecker_is_integer(self, ty) {
                        self.errors.push("Type error: cannot bitwise negate " + type_to_str(ty) + " (expected integer type)");
                    }
                    return ty;
                }
            }
            return ty;
        }
        Expr::Call(callee, args) => {
            if callee == "p_thread_spawn" && args.len() > 0 {
                match args.get(0) {
                    Expr::StringLit(entry) => { self.thread_entries.push(entry); }
                    _ => {}
                }
            }
            if callee == "p_malloc" || callee == "p_alloc" || callee == "p_free" || callee == "p_realloc"
                || callee == "p_memcpy" || callee == "p_memset" {
                TypeChecker_require_unsafe(self, callee + "()");
            } else if str_vec_contains(self.extern_fns, callee) && !str_starts_with(callee, "p_") {
                TypeChecker_require_unsafe(self, "calling the C function " + callee + "()");
            }
            // Check capabilities for built-in functions
            var sb_errs0: i64 = self.errors.len();
            if callee == "print" || callee == "println" || callee == "print_int" || callee == "print_float" || callee == "print_str" {
                TypeChecker_check_capability(self, "IO", callee + "()");
            }
            if callee == "read_file" || callee == "write_file" || callee == "file_open" || callee == "file_read" || callee == "file_write" {
                TypeChecker_check_capability(self, "FS", callee + "()");
            }
            if callee == "http_get" || callee == "http_post" || callee == "socket_connect" || callee == "socket_send" || callee == "socket_recv" {
                TypeChecker_check_capability(self, "Net", callee + "()");
            }
            if callee == "spawn" || callee == "exec" || callee == "system" || callee == "p_thread_spawn" {
                TypeChecker_check_capability(self, "Spawn", callee + "()");
            }
            if callee == "p_malloc" || callee == "p_free" || callee == "p_malloc_persistent" || callee == "p_arena_save" || callee == "p_arena_restore" {
                TypeChecker_check_capability(self, "Alloc", callee + "()");
            }
            // Inside sandbox, what the callee does counts too: an IO builtin
            // (p_file_read, ...) or a function whose inferred effects
            // include IO/Net/Spawn
            if self.sandbox_depth > 0 && self.errors.len() == sb_errs0 {
                TypeChecker_check_sandbox_call(self, callee, args);
            }
            if self.region_budgets.len() > 0 { TypeChecker_budget_call(self, callee, args); }
            // GPU kernel builtins
            if callee == "thread_id" || callee == "workgroup_size" || callee == "workgroup_id" || callee == "num_workgroups" {
                return Type::I64;
            }
            if callee == "print" {
                var i: i64 = 0;
                while i < args.len() {
                    TypeChecker_check_expr(self, args.get(i));
                    i = i + 1;
                }
                return Type::Void;
            }
            // Check all arguments
            var arg_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                arg_types.push(TypeChecker_check_expr(self, args.get(i)));
                i = i + 1;
            }
            // @send check for p_thread_spawn and p_chan_send
            if callee == "p_thread_spawn" || callee == "p_chan_send" {
                if arg_types.len() >= 2 {
                    if !TypeChecker_is_send_type(self, arg_types.get(1)) {
                        var what: str = " argument of type ";
                        var where_to: str = "across threads";
                        var send_only: str = "pass only";
                        if callee == "p_chan_send" { what = " value of type "; where_to = "through channels"; send_only = "send only"; }
                        self.errors.push("Thread safety error: " + callee + what + type_to_str(arg_types.get(1))
                            + "\n             is not @send.\n             Only @send types can be safely sent " + where_to + "."
                            + "\n             Fix: add @send to the struct definition, or " + send_only
                            + "\n             @send types (primitives, @send structs, Vec, HashMap).");
                    }
                }
            }
            // Locals shadow globals: a parameter or variable holding a function
            // value wins over a global function of the same name.
            match TypeChecker_lookup(self, callee) {
                OptType::Some(local_ty) => {
                    match TypeChecker_resolve_type(self, local_ty) {
                        Type::Func(lparams, lret) => {
                            if lparams.len() != arg_types.len() {
                                self.errors.push("Type error: function variable '" + callee + "' expects " + int_to_str(lparams.len()) + " args, got " + int_to_str(arg_types.len()));
                            }
                            return box_type_unbox(lret);
                        }
                        _ => {}
                    }
                }
                OptType::None => {}
            }
            // Check if callee is a known function
            // OPTIMIZATION: use cached lookup instead of O(n) linear scan
            match TypeChecker_lookup_func_cache(self, callee) {
                OptFuncSig::Some(sig) => {
                    TypeChecker_check_visibility(self, callee);
                    if arg_types.len() < sig.min_args || arg_types.len() > sig.param_types.len() {
                        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): function '" + callee + "' expects " + int_to_str(sig.min_args) + "-" + int_to_str(sig.param_types.len()) + " args, got " + int_to_str(arg_types.len()));
                    }
                    var gi: i64 = 0;
                    while gi < self.func_generic_names.len() {
                        if self.func_generic_names.get(gi) == callee {
                            // An integer literal given for a type parameter is an
                            // i64, not the smallest type that holds it
                            var gen_args: Vec<Type> = Vec::new();
                            var gai: i64 = 0;
                            while gai < arg_types.len() {
                                var gat: Type = arg_types.get(gai);
                                if gai < args.len() {
                                    match args.get(gai) {
                                        Expr::IntLit(_) => { gat = Type::I64; }
                                        _ => {}
                                    }
                                }
                                gen_args.push(gat);
                                gai = gai + 1;
                            }
                            return TypeChecker_check_generic_call(self, callee, self.func_generic_tps.get(gi),
                                self.func_generic_bounds.get(gi), sig.param_types, sig.ret_ty, gen_args, hint);
                        }
                        gi = gi + 1;
                    }
                    // Check every argument (generic parameters are resolved by
                    // monomorphization).
                    var pi: i64 = 0;
                    while pi < sig.param_types.len() && pi < arg_types.len() {
                        var raw_param: Type = sig.param_types.get(pi);
                        var param: Type = TypeChecker_resolve_type(self, raw_param);
                        var arg: Type = arg_types.get(pi);
                        if !TypeChecker_type_contains_param(self, raw_param) && !is_single_upper_name(raw_param)
                            && !(callee == "print" || callee == "println" || callee == "eprint" || callee == "eprintln")
                            && !TypeChecker_arg_compatible(self, param, arg)
                            && !(is_handle_int_pair(param, tc_read_through(arg)) && TypeChecker_is_runtime_call(self, callee))
                            && !(str_vec_contains(self.extern_fns, callee) && is_ffi_pointer_pair(param, arg)) {
                            var in_fn: str = "";
                            match self.current_func_name {
                                OptString::Some(fname) => { in_fn = ", in '" + fname + "'"; }
                                OptString::None => {}
                            }
                            self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): function '" + callee + "' parameter " + int_to_str(pi + 1) + " expects '" + type_to_str(param) + "', got '" + type_to_str(arg) + "'");
                        } else if tc_is_str(param) && tc_is_borrowed_str(arg) && !tc_borrow_safe_callee(callee) {
                            // A borrowed string given where an owned one is taken:
                            // the callee could keep it past its owner (M11)
                            self.errors.push("Borrow error (line " + int_to_str(self.current_line) + "): '" + callee + "' parameter " + int_to_str(pi + 1)
                                + " takes an owned str, and it is given a borrowed string (&str) it could keep after the owner frees it.\n    Fix: pass str_clone(s), or declare the parameter &str.");
                        }
                        pi = pi + 1;
                    }
                    if str_vec_contains(self.extern_fns, callee) {
                        TypeChecker_check_c_callbacks(self, callee, sig, args);
                    }
                    // For generic functions, return Never (compatible with any type)
                    if TypeChecker_type_contains_param(self, sig.ret_ty) {
                        return Type::Never;
                    }
                    return sig.ret_ty;
                }
                OptFuncSig::None => {}
            }
            // Check for ECS runtime functions
            if str_starts_with(callee, "__ecs_") {
                if callee == "__ecs_create_entity" || callee == "__ecs_entity_count" || callee == "__ecs_has" || callee == "__ecs_get" {
                    return Type::I64;
                }
                if callee == "__ecs_add" || callee == "__ecs_remove" {
                    return Type::Void;
                }
                return Type::I64;
            }
            // Check for event handler functions
            if str_starts_with(callee, "__on_") {
                return Type::Void;
            }
            // Check for runtime builtin functions (p_*)
            if str_starts_with(callee, "p_") {
                if callee == "p_json_dump" || callee == "p_json_type" || callee == "p_json_pretty" || callee == "p_json_string" || callee == "p_tensor_to_str" || callee == "p_tensor_to_json" || callee == "p_simd_to_str" || callee == "p_socket_recv_str" || callee == "p_http_build_response" || callee == "p_db_mem_query" || callee == "p_process_stdout" || callee == "p_process_stderr" || callee == "p_dir_list" || callee == "p_intern_str" || callee == "p_str_join_n" {
                    return Type::Str;
                }
                if callee == "p_str_concat" || callee == "p_to_str" || callee == "p_float_to_str" || callee == "p_string_replace" || callee == "p_string_trim" || callee == "p_string_to_uppercase" || callee == "p_string_to_lowercase" || callee == "p_string_char_at" || callee == "p_string_repeat" || callee == "p_char_to_str" || callee == "p_bool_to_str" || callee == "p_sb_to_str" {
                    return Type::Str;
                }
                if callee == "p_string_contains" || callee == "p_string_starts_with" || callee == "p_string_ends_with" || callee == "p_string_is_empty" {
                    return Type::Bool;
                }
                if callee == "p_vec_new" || callee == "p_vec_clone" || callee == "p_file_read_bytes" {
                    return Type::Named("Vec");
                }
                if callee == "p_vec_is_empty" || callee == "p_vec_contains" {
                    return Type::Bool;
                }
                // Green threads (as lower.fd declares it)
                if callee == "p_gt_is_done" {
                    return Type::Bool;
                }
                if (callee == "p_all_reduce" || callee == "p_all_gather") && arg_types.len() > 0 {
                    return arg_types.get(0);
                }
                if callee == "p_string_len" || callee == "p_string_find" || callee == "p_string_rfind" || callee == "p_string_bytes" || callee == "p_string_parse_int" {
                    return Type::I64;
                }
                return Type::I64;
            }
            // Check if callee is a local variable with function type (closure call)
            match TypeChecker_lookup(self, callee) {
                OptType::Some(var_ty) => {
                    // Resolve type aliases before checking for Func type
                    // (e.g. type InterruptHandler = fn() -> void)
                    var resolved_ty: Type = TypeChecker_resolve_type(self, var_ty);
                    match resolved_ty {
                        Type::Func(params, ret) => {
                            if params.len() != arg_types.len() {
                                self.errors.push("Type error: function variable '" + callee + "' expects " + int_to_str(params.len()) + " args, got " + int_to_str(arg_types.len()));
                            }
                            return box_type_unbox(ret);
                        }
                        _ => {}
                    }
                }
                OptType::None => {}
            }
            if TypeChecker_first_report(self, callee + "()") {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): undefined function '" + callee + "'");
            }
            return Type::Never;
        }
        Expr::FieldAccess(obj_expr, field) => {
            var obj_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(obj_expr));
            // Unwrap references
            var effective_ty: Type = obj_ty;
            match obj_ty {
                Type::Ref(inner, _) => { effective_ty = unbox_ty(box_type_unbox(inner)); }
                _ => { effective_ty = unbox_ty(obj_ty); }
            }
            // Swizzle access for vec types (Phase 8A): .xyz/.rgb/.yzx/.xxx
            // on vecN gives the vec type of the swizzle's length.
            match effective_ty {
                Type::Named(vname) => {
                    if tc_is_vec_type(vname) {
                        match tc_swizzle_result_type(field) {
                            OptType::Some(sw) => { return sw; }
                            OptType::None => {}
                        }
                    }
                }
                _ => {}
            }
            match effective_ty {
                Type::Named(name) => {
                    // Find struct fields
                    var si: i64 = TypeChecker_struct_pos(self, name);
                    var si_lim: i64 = si + 1;
                    if si < 0 { si = 0; si_lim = 0; }
                    while si < si_lim {
                        if self.structs.get(si).key == name {
                            var fields: Vec<StructField> = self.structs.get(si).val;
                            var fi: i64 = 0;
                            while fi < fields.len() {
                                if fields.get(fi).name == field {
                                    // Field privacy: a private field is only
                                    // accessible from its defining module.
                                    var pidx: i64 = HashMap_get(self.private_fields, name + "." + field);
                                    if pidx > 0 {
                                        var struct_module: str = self.private_field_modules.get(pidx - 1);
                                        if struct_module != self.current_module {
                                            self.errors.push("Privacy error: field '" + field + "' of struct '" + name + "' is private. It was defined in module '" + struct_module + "', which is not the current module '" + self.current_module + "'.");
                                        }
                                    }
                                    // A string held by a @scoped struct is borrowed: it
                                    // is freed with the struct (release M11)
                                    if tc_is_str(fields.get(fi).ty) && str_vec_contains(self.scoped_structs, name) {
                                        return Type::Ref(Box::new(Type::Str), false);
                                    }
                                    return fields.get(fi).ty;
                                }
                                fi = fi + 1;
                            }
                            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): struct '" + name + "' has no field '" + field + "'");
                            si = self.structs.len(); // break
                        }
                        si = si + 1;
                    }
                }
                _ => {
                    self.errors.push("Type error: cannot access field '" + field + "' on type " + type_to_str(obj_ty));
                }
            }
            return Type::Never;
        }
        Expr::OptionalFieldAccess(obj_expr, field) => {
            var obj_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(obj_expr));
            match obj_ty {
                Type::Named(name) => {
                    var si: i64 = TypeChecker_struct_pos(self, name);
                    var si_lim: i64 = si + 1;
                    if si < 0 { si = 0; si_lim = 0; }
                    while si < si_lim {
                        if self.structs.get(si).key == name {
                            var fields: Vec<StructField> = self.structs.get(si).val;
                            var fi: i64 = 0;
                            while fi < fields.len() {
                                if fields.get(fi).name == field {
                                    return fields.get(fi).ty;
                                }
                                fi = fi + 1;
                            }
                            si = self.structs.len();
                        }
                        si = si + 1;
                    }
                }
                _ => {}
            }
            return Type::I64;
        }
        Expr::StructLit(name, fields, spread) => {
            var real_name: str = TypeChecker_resolve_struct_name(self, name);
            // Find struct definition
            var si: i64 = TypeChecker_struct_pos(self, real_name);
            var si_lim: i64 = si + 1;
            if si < 0 { si = 0; si_lim = 0; }
            while si < si_lim {
                if self.structs.get(si).key == real_name {
                    var struct_fields: Vec<StructField> = self.structs.get(si).val;
                    // Check spread source type
                    match spread {
                        OptBoxExpr::Some(spread_expr) => {
                            var spread_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(spread_expr));
                            if !TypeChecker_types_compatible(self, Type::Named(real_name), spread_ty) {
                                self.errors.push("Type error: spread source expected " + real_name + ", got " + type_to_str(spread_ty));
                            }
                        }
                        OptBoxExpr::None => {}
                    }
                    // Check each field
                    var fi: i64 = 0;
                    while fi < fields.len() {
                        var fname: str = fields.get(fi).name;
                        var fexpr: Expr = fields.get(fi).value;
                        var fty: Type = TypeChecker_check_expr(self, fexpr);
                        var found: bool = false;
                        var sfi: i64 = 0;
                        while sfi < struct_fields.len() {
                            if struct_fields.get(sfi).name == fname {
                                if !TypeChecker_types_compatible(self, struct_fields.get(sfi).ty, fty) {
                                    self.errors.push("Type error: field '" + fname + "' expected " + type_to_str(struct_fields.get(sfi).ty) + ", got " + type_to_str(fty));
                                }
                                found = true;
                                sfi = struct_fields.len();
                            }
                            sfi = sfi + 1;
                        }
                        if !found {
                            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): struct '" + name + "' has no field '" + fname + "'");
                        }
                        fi = fi + 1;
                    }
                    return Type::Named(real_name);
                }
                si = si + 1;
            }
            self.errors.push("Type error: unknown struct '" + name + "'");
            return Type::Never;
        }
        Expr::If(cond, then_block, else_block) => {
            TypeChecker_check_expr(self, box_expr_unbox(cond));
            var then_ty: Type = TypeChecker_check_block_value(self, then_block);
            match else_block {
                OptStmts::Some(else_b) => {
                    // `if c { a } else { b }` has the type of its branches;
                    // a diverging branch takes the other branch's type.
                    var else_ty: Type = TypeChecker_check_block_value(self, else_b);
                    match then_ty {
                        Type::Never => { return else_ty; }
                        _ => { return then_ty; }
                    }
                }
                OptStmts::None => {}
            }
            return Type::Void;
        }
        Expr::Range(start, end, _) => {
            var st: Type = TypeChecker_check_expr(self, box_expr_unbox(start));
            var et: Type = TypeChecker_check_expr(self, box_expr_unbox(end));
            if !TypeChecker_is_numeric(self, st) || !TypeChecker_is_numeric(self, et) {
                self.errors.push("Type error: range bounds must be numeric, got " + type_to_str(st) + " and " + type_to_str(et));
            }
            return st;
        }
        Expr::Block(stmts) => {
            TypeChecker_push_scope(self);
            var last_ty: Type = Type::Void;
            var si: i64 = 0;
            while si < stmts.len() {
                match stmts.get(si) {
                    Stmt::Expr(e, _) => { last_ty = TypeChecker_check_expr(self, e); }
                    _ => { TypeChecker_check_stmt(self, stmts.get(si)); last_ty = Type::Void; }
                }
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            return last_ty;
        }
        Expr::MethodCall(receiver, method, args) => {
            if tc_changing_method(method) || TypeChecker_method_takes_mut_self(self, box_expr_unbox(receiver), method) {
                TypeChecker_check_param_change(self, tc_place_root(box_expr_unbox(receiver)));
            }
            return TypeChecker_check_method_call(self, box_expr_unbox(receiver), method, args, hint);
        }
        Expr::ArrayLit(elem_type, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                var et: Type = TypeChecker_check_expr(self, elements.get(i));
                if !TypeChecker_types_compatible(self, box_type_unbox(elem_type), et) {
                    self.errors.push("Type error: array element type mismatch, expected " + type_to_str(box_type_unbox(elem_type)) + ", got " + type_to_str(et));
                }
                i = i + 1;
            }
            return Type::Array(elem_type, elements.len());
        }
        Expr::Index(array, index) => {
            var arr_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(array));
            // `v[i]` through a reference indexes what it refers to (as
            // `v[i] = x` does)
            match arr_ty {
                Type::Ref(rinner, _) => { arr_ty = box_type_unbox(rinner); }
                _ => {}
            }
            // String slicing
            match arr_ty {
                Type::Named(name) => {
                    if name == "String" { return Type::Named("String"); }
                }
                _ => {}
            }
            var idx_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(index));
            if !TypeChecker_is_numeric(self, idx_ty) {
                self.errors.push("Type error: array index must be numeric, got " + type_to_str(idx_ty));
            }
            match arr_ty {
                Type::Array(elem, _) => { return box_type_unbox(elem); }
                Type::ArrayConst(elem, _) => { return box_type_unbox(elem); }
                Type::Generic(name, args) => {
                    if name == "Vec" {
                        if args.len() > 0 { return args.get(0); }
                        return Type::I64;
                    }
                }
                Type::Named(name) => {
                    if name == "Vec" { return Type::I64; }
                }
                _ => {
                    self.errors.push("Type error: cannot index type " + type_to_str(arr_ty));
                }
            }
            return Type::Never;
        }
        Expr::FString(parts) => {
            // Its size, when every part has a bound (text, numbers, bools)
            var fs_bytes: i64 = 1;
            var fs_known: bool = true;
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(e) => {
                        var pt: Type = TypeChecker_resolve_type(self, TypeChecker_check_expr(self, e));
                        if type_eq(pt, Type::Bool) { fs_bytes = fs_bytes + 5; }
                        else if TypeChecker_is_integer(self, pt) { fs_bytes = fs_bytes + 20; }
                        else { fs_known = false; }
                    }
                    FStringPart::Literal(lit) => { fs_bytes = fs_bytes + str_len(lit); }
                }
                i = i + 1;
            }
            if self.region_budgets.len() > 0 {
                if fs_known { TypeChecker_budget_heap(self, "an f-string", fs_bytes); }
                else { TypeChecker_budget_heap(self, "an f-string of a value whose length is not known at compile time", -1); }
            }
            return Type::Str;
        }
        Expr::Match(expr, arms) => {
            var match_ty: Type = unbox_ty(TypeChecker_check_expr(self, box_expr_unbox(expr)));
            TypeChecker_check_exhaustive(self, match_ty, arms, self.current_line);
            var match_value_ty: Type = Type::Never;
            var match_has_value: bool = false;
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                TypeChecker_push_scope(self);
                match arm.pattern {
                    Pattern::Ident(name) => { TypeChecker_declare(self, name, match_ty); }
                    Pattern::EnumVariant(enum_name, variant, bindings) => {
                        TypeChecker_check_enum_pattern(self, match_ty, enum_name, variant, bindings);
                        var tys: Vec<Type> = TypeChecker_pattern_binding_types(self, match_ty, enum_name, variant, bindings);
                        var bi: i64 = 0;
                        while bi < bindings.len() && bi < tys.len() {
                            TypeChecker_declare(self, bindings.get(bi).name, tys.get(bi));
                            bi = bi + 1;
                        }
                    }
                    Pattern::StrLit(_) => {}
                    Pattern::Range(_, _) => {}
                    _ => {}
                }
                match arm.guard {
                    OptBoxExpr::Some(g) => { TypeChecker_check_expr(self, box_expr_unbox(g)); }
                    OptBoxExpr::None => {}
                }
                // `match` as a value: the first non-diverging arm's type.
                var arm_ty: Type = TypeChecker_check_stmts_value(self, arm.body);
                match arm_ty {
                    Type::Never => {}
                    _ => {
                        if !match_has_value { match_value_ty = arm_ty; match_has_value = true; }
                    }
                }
                TypeChecker_pop_scope(self);
                ai = ai + 1;
            }
            if arms.len() == 0 { return Type::Void; }
            return match_value_ty;
        }
        Expr::EnumLit(enum_name, variant, args) => {
            var ctor_arg_tys: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                ctor_arg_tys.push(TypeChecker_check_expr(self, args.get(i)));
                i = i + 1;
            }
            TypeChecker_check_enum_constructor(self, enum_name, variant, ctor_arg_tys);
            return Type::Named(enum_name);
        }
        Expr::Ref(e, is_mut) => {
            if is_mut { TypeChecker_check_param_change(self, tc_place_root(box_expr_unbox(e))); }
            var inner_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
            return Type::Ref(Box::new(inner_ty), is_mut);
        }
        Expr::Deref(e) => {
            var ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
            match ty {
                Type::Ref(inner, _) => { var t: Type = box_type_unbox(inner); return t; }
                Type::RawPtr(inner, _) => {
                    TypeChecker_require_unsafe(self, "reading through a raw pointer");
                    var t: Type = box_type_unbox(inner);
                    return t;
                }
                Type::Generic(gname, gargs) => {
                    if gname == "Box" && gargs.len() == 1 { return gargs.get(0); }
                    self.errors.push("Type error: cannot dereference non-reference type " + type_to_str(ty));
                    return Type::Never;
                }
                _ => {
                    self.errors.push("Type error: cannot dereference non-reference type " + type_to_str(ty));
                    return Type::Never;
                }
            }
            return Type::Never;
        }
        Expr::StrConcat(left, right) => {
            if self.region_budgets.len() > 0 { TypeChecker_budget_heap(self, "string `+`", -1); }
            var lt: Type = TypeChecker_check_expr(self, box_expr_unbox(left));
            var rt: Type = TypeChecker_check_expr(self, box_expr_unbox(right));
            if !type_eq(lt, Type::Str) && !type_eq(lt, Type::Named("String")) {
                self.errors.push("Type error: string concat requires str or String. Left: " + type_to_str(lt));
            }
            if !type_eq(rt, Type::Str) && !type_eq(rt, Type::Named("String")) {
                self.errors.push("Type error: string concat requires str or String. Right: " + type_to_str(rt));
            }
            return Type::Str;
        }
        Expr::Try(e) => {
            var ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
            match ty {
                Type::Generic(name, args) => {
                    if name == "Result" && args.len() == 2 { return args.get(0); }
                    if name == "Option" && args.len() == 1 { return args.get(0); }
                }
                Type::Named(name) => {
                    if name == "Result" || name == "Option" { return Type::I64; }
                }
                _ => {}
            }
            self.errors.push("Type error: ? operator requires Option<T> or Result<T, E>. Found: " + type_to_str(ty));
            return Type::Never;
        }
        Expr::Coalesce(e, default) => {
            var ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
            var default_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(default));
            match ty {
                Type::Generic(name, args) => {
                    if name == "Option" && args.len() == 1 {
                        if !TypeChecker_types_compatible(self, args.get(0), default_ty) {
                            self.errors.push("Type error: ?? default value type mismatch");
                        }
                        return args.get(0);
                    }
                }
                Type::Named(name) => {
                    if name == "Option" { return Type::I64; }
                }
                _ => {}
            }
            self.errors.push("Type error: ?? operator requires Option<T>. Found: " + type_to_str(ty));
            return Type::Never;
        }
        Expr::TryBlock(body) => {
            var last_ty: Type = Type::I64;
            var si: i64 = 0;
            while si < body.len() {
                match body.get(si) {
                    Stmt::Expr(e, _) => { last_ty = TypeChecker_check_expr(self, e); }
                    _ => { TypeChecker_check_stmt(self, body.get(si)); }
                }
                si = si + 1;
            }
            var result_args: Vec<Type> = Vec::new();
            result_args.push(last_ty);
            result_args.push(Type::I64);
            return Type::Generic("Result", result_args);
        }
        Expr::IsCheck(e, type_name) => {
            TypeChecker_check_expr(self, box_expr_unbox(e));
            return Type::Bool;
        }
        Expr::TupleLit(elems) => {
            var types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < elems.len() {
                types.push(TypeChecker_check_expr(self, elems.get(i)));
                i = i + 1;
            }
            return Type::Tuple(types);
        }
        Expr::Closure(params, body, ret_ty) => {
            TypeChecker_push_scope(self);
            var pi: i64 = 0;
            while pi < params.len() {
                TypeChecker_declare(self, params.get(pi).name, TypeChecker_resolve_type(self, params.get(pi).ty));
                pi = pi + 1;
            }
            var saved_closure_ret: OptType = self.current_ret_ty;
            self.current_ret_ty = ret_ty;
            var outer_returns: i64 = self.current_return_types.len();
            var body_ty: Type = TypeChecker_check_stmts_value(self, body);
            // The closure's own `return`s belong to it, not the enclosing fn;
            // unannotated closures infer their return type from them.
            var inferred_ret: Type = body_ty;
            match body_ty {
                Type::Never => { inferred_ret = Type::Void; }
                _ => {}
            }
            var cri: i64 = self.current_return_types.len() - 1;
            while cri >= outer_returns {
                var crt: Type = self.current_return_types.get(cri);
                match crt {
                    Type::Void => {}
                    Type::Never => {}
                    _ => { inferred_ret = crt; }
                }
                cri = cri - 1;
            }
            self.current_return_types.truncate(outer_returns);
            self.current_ret_ty = saved_closure_ret;
            TypeChecker_pop_scope(self);
            var closure_params: Vec<Type> = Vec::new();
            var cpi: i64 = 0;
            while cpi < params.len() {
                closure_params.push(TypeChecker_resolve_type(self, params.get(cpi).ty));
                cpi = cpi + 1;
            }
            var closure_ret: Type = inferred_ret;
            match ret_ty {
                OptType::Some(t) => { closure_ret = t; }
                OptType::None => {}
            }
            return Type::Func(closure_params, Box::new(closure_ret));
        }
        Expr::Cast(e, target_ty) => {
            TypeChecker_check_expr(self, box_expr_unbox(e));
            return TypeChecker_resolve_type(self, target_ty);
        }
        Expr::Asm(_, operands) => {
            var has_out: bool = false;
            var i: i64 = 0;
            while i < operands.len() {
                var op: AsmOperand = operands.get(i);
                TypeChecker_check_expr(self, op.expr);
                match op.direction {
                    AsmDir::In => {}
                    AsmDir::Out => { has_out = true; }
                    _ => {}
                }
                i = i + 1;
            }
            if has_out { return Type::I64; }
            return Type::Void;
        }
        Expr::Comptime(inner) => { return TypeChecker_check_expr(self, box_expr_unbox(inner)); }
        Expr::ComptimeBlock(stmts) => {
            var si: i64 = 0;
            while si < stmts.len() {
                TypeChecker_check_stmt(self, stmts.get(si));
                si = si + 1;
            }
            return Type::I64;
        }
        Expr::ComptimeReflect(op, _) => {
            match op {
                ReflectOp::TypeName => { return Type::Str; }
                ReflectOp::IsStruct => { return Type::Bool; }
                ReflectOp::IsEnum => { return Type::Bool; }
                ReflectOp::FieldCount => { return Type::I64; }
                ReflectOp::FieldNames => { return Type::Array(Box::new(Type::Str), 0); }
                ReflectOp::FieldTypes => { return Type::Array(Box::new(Type::Str), 0); }
                ReflectOp::EnumVariants => { return Type::Array(Box::new(Type::Str), 0); }
                ReflectOp::StructSize => { return Type::I64; }
                ReflectOp::FieldOffset => { return Type::I64; }
                ReflectOp::EnumDiscriminant => { return Type::I64; }
                ReflectOp::FunctionEffects => { return Type::Array(Box::new(Type::Str), 0); }
                ReflectOp::FunctionCapabilities => { return Type::Array(Box::new(Type::Str), 0); }
            }
            return Type::I64;
        }
        Expr::PipeForward(left, right) => {
            var left_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(left));
            // Desugar: if right is a Call, typecheck as call with left prepended
            match right {
                Expr::Call(callee, args) => {
                    var all_args: Vec<Expr> = Vec::new();
                    all_args.push(box_expr_unbox(left));
                    var i: i64 = 0;
                    while i < args.len() {
                        all_args.push(args.get(i));
                        i = i + 1;
                    }
                    return TypeChecker_check_expr(self, Expr::Call(callee, all_args));
                }
                Expr::MethodCall(receiver, method, args) => {
                    return TypeChecker_check_expr(self, Expr::MethodCall(left, method, args));
                }
                Expr::Ident(name) => {
                    var call_args: Vec<Expr> = Vec::new();
                    call_args.push(box_expr_unbox(left));
                    return TypeChecker_check_expr(self, Expr::Call(name, call_args));
                }
                _ => {
                    return TypeChecker_check_expr(self, box_expr_unbox(right));
                }
            }
            return Type::Never;
        }
        Expr::QuantCast(e, target_ty) => {
            TypeChecker_check_expr(self, box_expr_unbox(e));
            return TypeChecker_resolve_type(self, target_ty);
        }
        Expr::Await(inner) => {
            var inner_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(inner));
            match inner_ty {
                Type::Generic(name, args) => {
                    if name == "Future" && args.len() == 1 { return args.get(0); }
                }
                Type::Named(name) => {
                    if name == "Future" { return Type::I64; }
                }
                _ => {}
            }
            self.errors.push("Type error: await requires a Future<T> operand, got " + type_to_str(inner_ty) + "."
                + "\n    Hint: async fn functions return Future<T>.\n         spawn <expr> also returns Future<T>.");
            return Type::I64;
        }
        Expr::Spawn(inner) => {
            var inner_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(inner));
            match box_expr_unbox(inner) {
                Expr::Call(spawned, _) => { self.thread_entries.push(spawned); }
                _ => {}
            }
            // @send check: any variables captured in the spawn expression
            // must be @send (safe to send across threads).
            var cap_names: Vec<str> = Vec::new();
            var cap_types: Vec<Type> = Vec::new();
            TypeChecker_collect_captured_vars(self, box_expr_unbox(inner), &mut cap_names, &mut cap_types);
            // Every argument of the spawned call too, not only the variables
            // it names (release H4): `spawn work(make_ref())`. The types are
            // taken again with the errors of that second look discarded.
            match box_expr_unbox(inner) {
                Expr::Call(_, sargs) => {
                    var ai: i64 = 0;
                    while ai < sargs.len() {
                        var saved_errs: i64 = self.errors.len();
                        var aty: Type = TypeChecker_check_expr(self, sargs.get(ai));
                        self.errors.truncate(saved_errs);
                        if !TypeChecker_is_send_type(self, aty) {
                            self.errors.push("Thread safety error (line " + int_to_str(self.current_line) + "): argument "
                                + int_to_str(ai + 1) + " of the spawned call has type " + type_to_str(aty)
                                + ", which is not @send.
    Fix: pass a value (numbers, strings, structs of such values) or mark the struct @send.");
                        }
                        ai = ai + 1;
                    }
                }
                _ => {}
            }
            var ci: i64 = 0;
            while ci < cap_types.len() {
                var var_ty: Type = cap_types.get(ci);
                if !TypeChecker_is_send_type(self, var_ty) {
                    self.errors.push("Thread safety error: spawn captures variable of type " + type_to_str(var_ty) + " which is not @send. Only @send types can be safely sent across threads.");
                }
                ci = ci + 1;
            }
            match inner_ty {
                Type::Generic(name, args) => {
                    if name == "Future" { return inner_ty; }
                }
                Type::Named(name) => {
                    if name == "Future" { return inner_ty; }
                }
                _ => {}
            }
            // Wrap non-Future in Future<T>
            var future_args: Vec<Type> = Vec::new();
            future_args.push(inner_ty);
            return Type::Generic("Future", future_args);
        }
        Expr::Yield(inner) => {
            TypeChecker_check_expr(self, box_expr_unbox(inner));
            return Type::Never;
        }
        Expr::NamedArg(name, e) => {
            TypeChecker_check_expr(self, box_expr_unbox(e));
            return Type::Never;
        }
    }
    return Type::Never;
}

// ---- CHUNK_MARKER_8 ----

// --- check_method_call ---------------------------------------------------

pub fn TypeChecker_check_method_call(self: &mut TypeChecker, receiver: Expr, method: str, args: Vec<Expr>, hint: Type) -> Type {
    // Check if this is Box::new(x), Rc::new(x), Arc::new(x), Vec::new(), HashMap::new()
    match receiver {
        Expr::Ident(name) => {
            if self.region_budgets.len() > 0 && str_len(name) > 0 && str_byte_at(name, 0) >= 65 && str_byte_at(name, 0) <= 90
                && !TypeChecker_is_local_var(self, name) {
                TypeChecker_budget_call(self, name + "_" + method, args);
            }
            if name == "Box" && method == "new" {
                if args.len() > 0 {
                    var arg_ty: Type = TypeChecker_check_expr(self, args.get(0));
                    var box_args: Vec<Type> = Vec::new();
                    box_args.push(arg_ty);
                    return Type::Generic("Box", box_args);
                }
            }
            if name == "Rc" && method == "new" {
                if args.len() > 0 {
                    var arg_ty: Type = TypeChecker_check_expr(self, args.get(0));
                    var rc_args: Vec<Type> = Vec::new();
                    rc_args.push(arg_ty);
                    return Type::Generic("Rc", rc_args);
                }
            }
            if name == "Arc" && method == "new" {
                if args.len() > 0 {
                    var arg_ty: Type = TypeChecker_check_expr(self, args.get(0));
                    var arc_args: Vec<Type> = Vec::new();
                    arc_args.push(arg_ty);
                    return Type::Generic("Arc", arc_args);
                }
            }
            if name == "Vec" && method == "new" {
                match hint {
                    Type::Generic(hn, hargs) => {
                        if hn == "Vec" { return Type::Generic("Vec", hargs); }
                    }
                    _ => {}
                }
                // No declared element type: a bare Vec
                return Type::Named("Vec");
            }
            // `Vec::filled(n, x)`: n elements, each x (Rust's vec![x; n])
            if name == "Vec" && method == "filled" && args.len() == 2 {
                var fn_ty: Type = TypeChecker_check_expr(self, args.get(0));
                if !TypeChecker_is_integer(self, fn_ty) {
                    self.errors.push("Type error: Vec::filled takes a length (an integer) first, got " + type_to_str(fn_ty));
                }
                var fe_hint: Type = Type::Infer;
                match hint {
                    Type::Generic(fhn, fhargs) => {
                        if fhn == "Vec" && fhargs.len() == 1 { fe_hint = fhargs.get(0); }
                    }
                    _ => {}
                }
                var fx_ty: Type = TypeChecker_check_expr_with_hint(self, args.get(1), fe_hint);
                var felem: Type = fx_ty;
                match fe_hint {
                    Type::Infer => {}
                    _ => { felem = fe_hint; }
                }
                // Struct and enum elements are boxed one by one: push them
                var fen: str = "";
                match felem {
                    Type::Named(fnn) => { fen = fnn; }
                    Type::Generic(fgn, _) => { if fgn != "Vec" && fgn != "HashMap" { fen = fgn; } }
                    _ => {}
                }
                if fen != "" && fen != "Vec" && fen != "HashMap" && fen != "String" && (tc_is_struct(self, fen) || TypeChecker_enum_pos(self, fen) >= 0) {
                    self.errors.push("Type error: Vec::filled makes Vecs of numbers, bools, strings, Vecs or maps; a Vec of " + fen + " is made with push");
                }
                var fargs: Vec<Type> = Vec::new();
                fargs.push(felem);
                return Type::Generic("Vec", fargs);
            }
            if name == "HashMap" && method == "new" {
                match hint {
                    Type::Generic(hn, hargs) => {
                        if hn == "HashMap" && hargs.len() == 2 { return Type::Generic("HashMap", hargs); }
                    }
                    _ => {}
                }
                var default_args: Vec<Type> = Vec::new();
                default_args.push(Type::Str);
                default_args.push(Type::I64);
                return Type::Generic("HashMap", default_args);
            }
            if name == "String" && method == "from" {
                if args.len() > 0 { TypeChecker_check_expr(self, args.get(0)); }
                return Type::Named("String");
            }
            // Check if it's an associated function call (e.g. Point::new(x, y))
            // Check if name is a known struct
            var si: i64 = TypeChecker_struct_pos(self, name);
            var si_lim: i64 = si + 1;
            if si < 0 { si = 0; si_lim = 0; }
            while si < si_lim {
                if self.structs.get(si).key == name {
                    var arg_types: Vec<Type> = Vec::new();
                    var ai: i64 = 0;
                    while ai < args.len() {
                        arg_types.push(TypeChecker_check_expr(self, args.get(ai)));
                        ai = ai + 1;
                    }
                    // Find method in method map
                    var mi: i64 = TypeChecker_methods_at(self, name);
                    while mi < self.methods.len() {
                        if self.methods.get(mi).key == name {
                            var method_map: Vec<MethodMapEntry> = self.methods.get(mi).val;
                            var mei: i64 = 0;
                            while mei < method_map.len() {
                                if method_map.get(mei).key == method {
                                    var info: MethodInfo = method_map.get(mei).val;
                                    if info.param_types.len() != arg_types.len() {
                                        self.errors.push("Type error: associated function '" + name + "::" + method + "' expects " + int_to_str(info.param_types.len()) + " args, got " + int_to_str(arg_types.len()));
                                    }
                                    return info.ret_ty;
                                }
                                mei = mei + 1;
                            }
                            mi = self.methods.len();
                        }
                        mi = mi + 1;
                    }
                    self.errors.push("Type error: no associated function '" + method + "' on struct '" + name + "'");
                    return Type::Never;
                }
                si = si + 1;
            }
            // Check if name is a known enum -- treat MethodCall as EnumLit
            // This handles cases where the parser didn't know the enum was
            // an enum at parse time (e.g. cross-module enums not yet imported).
            var ei: i64 = TypeChecker_enum_pos(self, name);
            var ei_lim: i64 = ei + 1;
            if ei < 0 { ei = 0; ei_lim = 0; }
            while ei < ei_lim {
                if self.enums.get(ei) == name {
                    // It's an enum constructor -- check args and return enum type
                    var ai2: i64 = 0;
                    while ai2 < args.len() {
                        TypeChecker_check_expr(self, args.get(ai2));
                        ai2 = ai2 + 1;
                    }
                    return Type::Named(name);
                }
                ei = ei + 1;
            }
        }
        _ => {}
    }
    // Check receiver type and dispatch method
    var recv_ty_raw: Type = TypeChecker_check_expr(self, receiver);
    var arg_types: Vec<Type> = Vec::new();
    var ai: i64 = 0;
    while ai < args.len() {
        arg_types.push(TypeChecker_check_expr(self, args.get(ai)));
        ai = ai + 1;
    }
    // Auto-deref &T / &mut T
    var recv_ty: Type = recv_ty_raw;
    match recv_ty_raw {
        Type::Ref(inner, _) => { recv_ty = box_type_unbox(inner); }
        _ => { recv_ty = recv_ty_raw; }
    }
    if self.region_budgets.len() > 0 { TypeChecker_budget_method(self, recv_ty, method); }
    // Builtin Vec methods
    match recv_ty {
        Type::Generic(name, gargs) => {
            if name == "Vec" {
                var elem_ty: Type = Type::I64;
                if gargs.len() > 0 { elem_ty = gargs.get(0); }
                var stored: i64 = -1;
                if method == "push" { stored = 0; }
                if method == "set" { stored = 1; }
                if stored >= 0 && stored < arg_types.len() && TypeChecker_mentions_scoped(self, arg_types.get(stored)) {
                    self.errors.push("Borrow error (line " + int_to_str(self.current_line) + "): a @scoped value (" + type_to_str(arg_types.get(stored)) + ") cannot be stored in a Vec: its strings are freed when its scope ends.
    Fix: copy what you need out of it (str_clone).");
                }
                if stored >= 0 && gargs.len() > 0 && stored < arg_types.len() {
                    if !TypeChecker_types_compatible(self, elem_ty, arg_types.get(stored)) {
                        self.errors.push("Type error: cannot store " + type_to_str(arg_types.get(stored)) + " in a Vec<" + type_to_str(elem_ty) + "> (" + method + ") in '" + self.checking_fn + "'");
                    }
                }
                if method == "push" { return Type::Void; }
                if method == "pop" { return elem_ty; }
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "get" { return elem_ty; }
                if method == "set" { return Type::Void; }
                if method == "clear" { return Type::Void; }
                if method == "capacity" { return Type::I64; }
                if method == "insert" { return Type::Void; }
                if method == "remove" { return elem_ty; }
                if method == "contains" { return Type::Bool; }
                if method == "reverse" { return Type::Void; }
                if method == "first" { return elem_ty; }
                if method == "last" { return elem_ty; }
                if method == "extend" { return Type::Void; }
                if method == "truncate" { return Type::Void; }
                if method == "sort" { return Type::Void; }
                if method == "for_each" { return Type::Void; }
                if method == "fold" { return Type::I64; }
                if method == "any" { return Type::Bool; }
                if method == "all" { return Type::Bool; }
                if method == "find" { return Type::I64; }
                if method == "position" { return Type::I64; }
                if method == "clone" {
                    var clone_args: Vec<Type> = Vec::new();
                    clone_args.push(elem_ty);
                    return Type::Generic("Vec", clone_args);
                }
                if method == "map" {
                    var map_args: Vec<Type> = Vec::new();
                    map_args.push(elem_ty);
                    return Type::Generic("Vec", map_args);
                }
                if method == "filter" {
                    var filter_args: Vec<Type> = Vec::new();
                    filter_args.push(elem_ty);
                    return Type::Generic("Vec", filter_args);
                }
                self.errors.push("Type error: no method '" + method + "' on Vec");
                return Type::Never;
            }
            if name == "HashMap" {
                var key_ty: Type = Type::Str;
                if gargs.len() > 0 { key_ty = gargs.get(0); }
                var val_ty: Type = Type::I64;
                if gargs.len() > 1 { val_ty = gargs.get(1); }
                if method == "insert" { return Type::Void; }
                if method == "get" { return val_ty; }
                if method == "contains" { return Type::Bool; }
                if method == "remove" { return Type::Void; }
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "clear" { return Type::Void; }
                if method == "get_or" { return val_ty; }
                if method == "keys" {
                    var keys_args: Vec<Type> = Vec::new();
                    keys_args.push(key_ty);
                    return Type::Generic("Vec", keys_args);
                }
                if method == "values" {
                    var values_args: Vec<Type> = Vec::new();
                    values_args.push(val_ty);
                    return Type::Generic("Vec", values_args);
                }
                if method == "clone" { return Type::Generic("HashMap", gargs); }
                self.errors.push("Type error: no method '" + method + "' on HashMap");
                return Type::Never;
            }
            if name == "Rc" {
                var elem_ty: Type = Type::I64;
                if gargs.len() > 0 { elem_ty = gargs.get(0); }
                if method == "clone" { return Type::Generic("Rc", gargs); }
                if method == "drop" { return Type::Void; }
                if method == "get" { return elem_ty; }
                if method == "count" { return Type::I64; }
                self.errors.push("Type error: no method '" + method + "' on Rc");
                return Type::Never;
            }
            if name == "Arc" {
                var elem_ty: Type = Type::I64;
                if gargs.len() > 0 { elem_ty = gargs.get(0); }
                if method == "clone" { return Type::Generic("Arc", gargs); }
                if method == "drop" { return Type::Void; }
                if method == "get" { return elem_ty; }
                if method == "count" { return Type::I64; }
                self.errors.push("Type error: no method '" + method + "' on Arc");
                return Type::Never;
            }
        }
        Type::Named(n) => {
            if n == "String" {
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "push_str" { return Type::Named("String"); }
                if method == "to_string" { return Type::Named("String"); }
                if method == "contains" { return Type::Bool; }
                if method == "starts_with" { return Type::Bool; }
                if method == "ends_with" { return Type::Bool; }
                if method == "trim" { return Type::Named("String"); }
                if method == "replace" { return Type::Named("String"); }
                if method == "to_uppercase" { return Type::Named("String"); }
                if method == "to_lowercase" { return Type::Named("String"); }
                if method == "parse_int" { return Type::I64; }
                if method == "find" { return Type::I64; }
                if method == "rfind" { return Type::I64; }
                if method == "repeat" { return Type::Named("String"); }
                if method == "bytes" { return Type::I64; }
                if method == "clone" { return Type::Named("String"); }
                if method == "split" {
                    var split_args: Vec<Type> = Vec::new();
                    split_args.push(Type::Named("String"));
                    return Type::Generic("Vec", split_args);
                }
                self.errors.push("Type error: no method '" + method + "' on String");
                return Type::Never;
            }
            // Named("Vec") without generic args says nothing about its elements
            if n == "Vec" {
                var elem_ty: Type = Type::Infer;
                if method == "push" { return Type::Void; }
                if method == "pop" { return elem_ty; }
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "get" { return elem_ty; }
                if method == "set" { return Type::Void; }
                if method == "clear" { return Type::Void; }
                if method == "capacity" { return Type::I64; }
                if method == "insert" { return Type::Void; }
                if method == "remove" { return elem_ty; }
                if method == "contains" { return Type::Bool; }
                if method == "reverse" { return Type::Void; }
                if method == "first" { return elem_ty; }
                if method == "last" { return elem_ty; }
                if method == "extend" { return Type::Void; }
                if method == "truncate" { return Type::Void; }
                if method == "sort" { return Type::Void; }
                if method == "clone" {
                    var clone_args: Vec<Type> = Vec::new();
                    clone_args.push(elem_ty);
                    return Type::Generic("Vec", clone_args);
                }
                if method == "map" {
                    var map_args: Vec<Type> = Vec::new();
                    map_args.push(elem_ty);
                    return Type::Generic("Vec", map_args);
                }
                if method == "filter" {
                    var filter_args: Vec<Type> = Vec::new();
                    filter_args.push(elem_ty);
                    return Type::Generic("Vec", filter_args);
                }
                if method == "for_each" { return Type::Void; }
                if method == "fold" { return Type::I64; }
                if method == "any" { return Type::Bool; }
                if method == "all" { return Type::Bool; }
                if method == "find" { return Type::I64; }
                if method == "position" { return Type::I64; }
                self.errors.push("Type error: no method '" + method + "' on Vec");
                return Type::Never;
            }
            // Named("HashMap") without generic args -- treat as HashMap<str, i64>
            if n == "HashMap" {
                var key_ty: Type = Type::Str;
                var val_ty: Type = Type::I64;
                if method == "insert" { return Type::Void; }
                if method == "get" { return val_ty; }
                if method == "contains" { return Type::Bool; }
                if method == "remove" { return Type::Void; }
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "clear" { return Type::Void; }
                if method == "get_or" { return val_ty; }
                if method == "keys" {
                    var keys_args: Vec<Type> = Vec::new();
                    keys_args.push(key_ty);
                    return Type::Generic("Vec", keys_args);
                }
                if method == "values" {
                    var values_args: Vec<Type> = Vec::new();
                    values_args.push(val_ty);
                    return Type::Generic("Vec", values_args);
                }
                self.errors.push("Type error: no method '" + method + "' on HashMap");
                return Type::Never;
            }
        }
        _ => {}
    }
    // Check if receiver is a trait object (dyn Trait)
    match recv_ty {
        Type::Dyn(trait_name) => {
            match map_traits_get(self.traits, trait_name) {
                OptTraitMethodMap::Some(trait_methods) => {
                    match trait_method_map_get(trait_methods, method) {
                        OptTraitMethodInfo::Some(info) => {
                            return info.ret_ty;
                        }
                        OptTraitMethodInfo::None => {}
                    }
                }
                OptTraitMethodMap::None => {}
            }
            self.errors.push("Type error: no method '" + method + "' on trait '" + trait_name + "'");
            return Type::Never;
        }
        _ => {}
    }
    // Auto-deref for method lookup
    var effective_recv_ty: Type = recv_ty;
    match recv_ty {
        Type::Ref(inner, _) => { effective_recv_ty = box_type_unbox(inner); }
        _ => { effective_recv_ty = recv_ty; }
    }
    // Handle Type::Named("Vec") -- Vec without type params
    match effective_recv_ty {
        Type::Named(n) => {
            if n == "Vec" {
                var elem_ty: Type = Type::I64;
                if method == "push" { return Type::Void; }
                if method == "pop" { return elem_ty; }
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "get" { return elem_ty; }
                if method == "set" { return Type::Void; }
                if method == "clear" { return Type::Void; }
                if method == "capacity" { return Type::I64; }
                if method == "insert" { return Type::Void; }
                if method == "remove" { return elem_ty; }
                if method == "contains" { return Type::Bool; }
                if method == "reverse" { return Type::Void; }
                if method == "first" { return elem_ty; }
                if method == "last" { return elem_ty; }
                if method == "extend" { return Type::Void; }
                if method == "truncate" { return Type::Void; }
                if method == "sort" { return Type::Void; }
                if method == "for_each" { return Type::Void; }
                if method == "fold" { return Type::I64; }
                if method == "any" { return Type::Bool; }
                if method == "all" { return Type::Bool; }
                if method == "find" { return Type::I64; }
                if method == "position" { return Type::I64; }
                if method == "clone" {
                    var clone_args: Vec<Type> = Vec::new();
                    clone_args.push(elem_ty);
                    return Type::Generic("Vec", clone_args);
                }
                if method == "map" {
                    var map_args: Vec<Type> = Vec::new();
                    map_args.push(elem_ty);
                    return Type::Generic("Vec", map_args);
                }
                if method == "filter" {
                    var filter_args: Vec<Type> = Vec::new();
                    filter_args.push(elem_ty);
                    return Type::Generic("Vec", filter_args);
                }
                self.errors.push("Type error: no method '" + method + "' on Vec");
                return Type::Never;
            }
        }
        _ => {}
    }
    match effective_recv_ty {
        Type::Named(struct_name) => {
            // Find method in method map
            var mi: i64 = TypeChecker_methods_at(self, struct_name);
            while mi < self.methods.len() {
                if self.methods.get(mi).key == struct_name {
                    var method_map: Vec<MethodMapEntry> = self.methods.get(mi).val;
                    var mei: i64 = 0;
                    while mei < method_map.len() {
                        if method_map.get(mei).key == method {
                            TypeChecker_record_method_call(self, struct_name, method);
                            if self.sandbox_depth > 0 {
                                TypeChecker_sandbox_reject(self, struct_name + "." + method + "()",
                                    TypeChecker_get_func_effects(self, struct_name + "." + method));
                            }
                            // A generic impl's method on a value without type
                            // arguments (a bare `Option`): the i64 instance, as
                            // monomorphization picks
                            var btps: Vec<str> = TypeChecker_impl_type_params(self, struct_name);
                            if btps.len() > 0 && !tc_str_vec_contains(self.current_type_params, struct_name) {
                                var bnames: Vec<str> = Vec::new();
                                var btypes: Vec<Type> = Vec::new();
                                var bk: i64 = 0;
                                while bk < btps.len() {
                                    bnames.push(btps.get(bk));
                                    btypes.push(Type::I64);
                                    bk = bk + 1;
                                }
                                return tc_subst_type_params(method_map.get(mei).val.ret_ty, bnames, btypes);
                            }
                            return method_map.get(mei).val.ret_ty;
                        }
                        mei = mei + 1;
                    }
                    mi = self.methods.len();
                }
                mi = mi + 1;
            }
            // Check if this is a type param with a trait bound
            if tc_str_vec_contains(self.current_type_params, struct_name) {
                // Any of the parameter's bounds (`T: A + B`) may give the method
                var bi: i64 = 0;
                while bi < self.current_type_param_bounds.len() {
                    if self.current_type_param_bounds.get(bi).key == struct_name {
                        match map_traits_get(self.traits, self.current_type_param_bounds.get(bi).val) {
                            OptTraitMethodMap::Some(trait_methods) => {
                                match trait_method_map_get(trait_methods, method) {
                                    OptTraitMethodInfo::Some(info) => { return info.ret_ty; }
                                    OptTraitMethodInfo::None => {}
                                }
                            }
                            OptTraitMethodMap::None => {}
                        }
                    }
                    bi = bi + 1;
                }
            }
            self.errors.push("Type error: no method '" + method + "' on struct '" + struct_name + "'");
        }
        Type::Generic(gen_name, recv_args) => {
            // Generic type: look up methods by base name
            var mi: i64 = TypeChecker_methods_at(self, gen_name);
            while mi < self.methods.len() {
                if self.methods.get(mi).key == gen_name {
                    var method_map: Vec<MethodMapEntry> = self.methods.get(mi).val;
                    var mei: i64 = 0;
                    while mei < method_map.len() {
                        if method_map.get(mei).key == method {
                            // `impl<T> Slot` on a Slot<f64>: the method's type with T=f64
                            var gtps: Vec<str> = TypeChecker_impl_type_params(self, gen_name);
                            if gtps.len() > 0 {
                                var gnames: Vec<str> = Vec::new();
                                var gtypes: Vec<Type> = Vec::new();
                                var gk: i64 = 0;
                                while gk < gtps.len() && gk < recv_args.len() {
                                    gnames.push(gtps.get(gk));
                                    gtypes.push(recv_args.get(gk));
                                    gk = gk + 1;
                                }
                                var gret: Type = tc_subst_type_params(method_map.get(mei).val.ret_ty, gnames, gtypes);
                                if TypeChecker_type_contains_param(self, gret) { return Type::Never; }
                                return gret;
                            }
                            return method_map.get(mei).val.ret_ty;
                        }
                        mei = mei + 1;
                    }
                    mi = self.methods.len();
                }
                mi = mi + 1;
            }
            self.errors.push("Type error: no method '" + method + "' on generic type '" + gen_name + "'");
        }
        _ => {
            self.errors.push("Type error: cannot call method '" + method + "' on type " + type_to_str(recv_ty));
        }
    }
    return Type::Never;
}

// --- resolve_pattern_enum -------------------------------------------------

pub fn TypeChecker_resolve_pattern_enum(self: &TypeChecker, match_ty: Type, enum_name: str, variant: str) -> OptString {
    // If enum_name is non-empty, try resolving it directly
    if enum_name != "" {
        var resolved: str = TypeChecker_resolve_struct_name(self, enum_name);
        // Check if resolved name is a known enum
        var ei: i64 = 0;
        while ei < self.enum_variants.len() {
            if self.enum_variants.get(ei).key == resolved {
                return OptString::Some(resolved);
            }
            ei = ei + 1;
        }
        // Check original name
        ei = 0;
        while ei < self.enum_variants.len() {
            if self.enum_variants.get(ei).key == enum_name {
                return OptString::Some(enum_name);
            }
            ei = ei + 1;
        }
    }
    // Try to infer from the scrutinee type
    var from_scrutinee: OptString = OptString::None;
    match match_ty {
        Type::Named(n) => { from_scrutinee = OptString::Some(n); }
        Type::Generic(n, _) => { from_scrutinee = OptString::Some(n); }
        _ => {}
    }
    match from_scrutinee {
        OptString::Some(n) => {
            var resolved: str = TypeChecker_resolve_struct_name(self, n);
            var ei: i64 = 0;
            while ei < self.enum_variants.len() {
                if self.enum_variants.get(ei).key == resolved {
                    return OptString::Some(resolved);
                }
                ei = ei + 1;
            }
        }
        OptString::None => {}
    }
    // Last resort: a variant name unique across all enums
    var found: OptString = OptString::None;
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
        var vi: i64 = 0;
        while vi < variants.len() {
            if variants.get(vi).name == variant {
                match found {
                    OptString::Some(_) => {
                        // Ambiguous -- more than one enum has this variant
                        return OptString::None;
                    }
                    OptString::None => {
                        found = OptString::Some(self.enum_variants.get(ei).key);
                    }
                }
                vi = variants.len();
            }
            vi = vi + 1;
        }
        ei = ei + 1;
    }
    return found;
}

// --- soundness helpers (mirror src/typechecker.rs) -------------------------

// A type written by name in a pattern binding (`Some(v: i64)`): primitive names
// map to primitive types (as in Rust's type_from_name), others stay Named.
pub fn type_from_annotation(name: str) -> Type {
    if name == "i8" { return Type::I8; }
    if name == "i16" { return Type::I16; }
    if name == "i32" { return Type::I32; }
    if name == "i64" { return Type::I64; }
    if name == "i128" { return Type::I128; }
    if name == "u8" { return Type::U8; }
    if name == "u16" { return Type::U16; }
    if name == "u32" { return Type::U32; }
    if name == "u64" { return Type::U64; }
    if name == "u128" { return Type::U128; }
    if name == "f32" { return Type::F32; }
    if name == "f64" { return Type::F64; }
    if name == "bool" { return Type::Bool; }
    if name == "str" { return Type::Str; }
    if name == "void" { return Type::Void; }
    return Type::Named(name);
}

// The stdlib modules that implement the runtime handles themselves (Vec/HashMap
// are raw pointers manipulated as i64 there).
pub fn is_runtime_layer(module: str) -> bool {
    return module == "core" || module == "vec";
}

fn is_handle_type(t: Type) -> bool {
    match t {
        Type::Named(n) => { return n == "Vec" || n == "HashMap" || n == "Allocator" || n == "Tensor"; }
        Type::Generic(n, _) => { return n == "Vec" || n == "HashMap" || n == "Allocator" || n == "Tensor"; }
        _ => { return false; }
    }
    return false;
}

fn is_i64_type(t: Type) -> bool {
    match t {
        Type::I64 => { return true; }
        _ => { return false; }
    }
    return false;
}

// An opaque runtime handle paired with i64 -- interchangeable only inside the
// runtime layer (TODO R1.4: a layout-aware Vec removes the need for this).
pub fn is_handle_int_pair(a: Type, b: Type) -> bool {
    return (is_handle_type(a) && is_i64_type(b)) || (is_handle_type(b) && is_i64_type(a));
}

// `T` written as a single uppercase letter is a generic parameter.
fn is_single_upper_name(t: Type) -> bool {
    match t {
        Type::Named(n) => {
            if str_len(n) == 1 {
                var c: i64 = str_byte_at(n, 0);
                return c >= 'A' && c <= 'Z';
            }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

pub fn TypeChecker_is_runtime_call(self: &TypeChecker, callee: str) -> bool {
    if is_runtime_layer(self.current_module) { return true; }
    if str_vec_contains(self.extern_fns, callee) { return true; }
    match TypeChecker_get_item_module(self, callee) {
        OptString::Some(m) => { return is_runtime_layer(m); }
        OptString::None => {}
    }
    return false;
}

fn strip_box(t: Type) -> Type {
    match t {
        Type::Generic(n, args) => {
            if n == "Box" && args.len() == 1 { return args.get(0); }
            return t;
        }
        _ => { return t; }
    }
    return t;
}

// Argument passing: types_compatible plus the call-site coercions Fides
// performs -- a `&mut T` reborrows as `&T`, a value `T` is auto-borrowed for a
// `&T` / `&mut T` parameter, and aggregates share a representation with their
// Box. Passing `&T` where `&mut T` is required stays an error.
pub fn TypeChecker_arg_compatible(self: &TypeChecker, param: Type, arg: Type) -> bool {
    if TypeChecker_types_compatible(self, param, arg) { return true; }
    var p: Type = TypeChecker_resolve_type(self, param);
    var a: Type = TypeChecker_resolve_type(self, arg);
    // A Box owns a heap copy made by Box::new; storing a bare value (often a
    // pointer into the caller's stack frame) dangles.
    var a_boxed: bool = is_box_type(a);
    match a {
        Type::Ref(inner, _) => { if is_box_type(box_type_unbox(inner)) { a_boxed = true; } }
        _ => {}
    }
    if is_box_type(p) && !a_boxed { return false; }
    // Function types compare structurally.
    match p {
        Type::Func(pp, pr) => {
            match a {
                Type::Func(ap, ar) => {
                    if pp.len() != ap.len() { return false; }
                    var fi: i64 = 0;
                    while fi < pp.len() {
                        if !TypeChecker_arg_compatible(self, pp.get(fi), ap.get(fi)) { return false; }
                        fi = fi + 1;
                    }
                    return TypeChecker_arg_compatible(self, box_type_unbox(pr), box_type_unbox(ar))
                        || (type_eq(box_type_unbox(pr), Type::Void) && type_eq(box_type_unbox(ar), Type::Void));
                }
                _ => {}
            }
        }
        _ => {}
    }
    var p_is_ref: bool = false;
    var p_mut: bool = false;
    var p_inner: Type = p;
    match p {
        Type::Ref(inner, m) => { p_is_ref = true; p_mut = m; p_inner = box_type_unbox(inner); }
        _ => {}
    }
    var a_is_ref: bool = false;
    var a_mut: bool = false;
    var a_inner: Type = a;
    match a {
        Type::Ref(inner, m) => { a_is_ref = true; a_mut = m; a_inner = box_type_unbox(inner); }
        _ => {}
    }
    if p_is_ref && p_mut && a_is_ref && !a_mut { return false; }
    var ps: Type = TypeChecker_resolve_type(self, strip_box(p_inner));
    var as2: Type = TypeChecker_resolve_type(self, strip_box(a_inner));
    // Only user structs and enums are represented as a pointer to their data,
    // so only for them is `T` interchangeable with `&T` / `Box<T>`. A Vec,
    // HashMap, str or number value is itself the handle or value, and `&v` is
    // a pointer to the variable holding it (mirrors src/typechecker.rs).
    var stripped_any: bool = (p_is_ref != a_is_ref) || is_box_type(p_inner) || is_box_type(a_inner);
    // A reference where the value is wanted is read through (the lowering
    // loads a Vec/HashMap/str handle from it); not the other way round
    var read_through: bool = a_is_ref && !p_is_ref && !is_box_type(p_inner) && !is_box_type(a_inner);
    if stripped_any && !read_through && !TypeChecker_shares_repr(self, ps) { return false; }
    return TypeChecker_types_compatible(self, ps, as2);
}

pub fn TypeChecker_shares_repr(self: &TypeChecker, t: Type) -> bool {
    var n: str = "";
    match t {
        Type::Named(nm) => { n = nm; }
        Type::Generic(nm, _) => { n = nm; }
        _ => { return false; }
    }
    if n == "Vec" || n == "HashMap" || n == "String" || n == "Box" { return false; }
    if str_vec_contains(self.enums, n) { return true; }
    match TypeChecker_lookup_struct_cache(self, n) {
        OptVecStructField::Some(_) => { return true; }
        OptVecStructField::None => {}
    }
    return false;
}

// `return e` must match the declared return type of the enclosing function or
// closure.
pub fn TypeChecker_check_return_type(self: &mut TypeChecker, actual: Type) {
    var declared: Type = Type::Infer;
    match self.current_ret_ty {
        OptType::Some(t) => { declared = TypeChecker_resolve_self_type(self, t); }
        OptType::None => { return; }
    }
    var decl_void: bool = false;
    match declared {
        Type::Void => { decl_void = true; }
        _ => {}
    }
    var act_void: bool = false;
    match actual {
        Type::Void => { act_void = true; }
        _ => {}
    }
    if tc_is_str(declared) && tc_is_borrowed_str(actual) {
        self.errors.push("Borrow error (line " + int_to_str(self.current_line) + "): returns a borrowed string (&str) as an owned str; the string belongs to its owner and may be freed after this returns.\n    Fix: return str_clone(s) (an owned copy), or declare the result &str.");
        return;
    }
    var ok: bool = false;
    var is_main: bool = false;
    match self.current_func_name {
        OptString::Some(n) => { is_main = n == "main"; }
        OptString::None => {}
    }
    if decl_void && is_main && TypeChecker_is_numeric(self, actual) {
        ok = true;   // main may return an integer exit status
    } else if decl_void || act_void {
        ok = decl_void && act_void;
    } else {
        ok = TypeChecker_arg_compatible(self, declared, actual)
            || (is_runtime_layer(self.current_module) && is_handle_int_pair(declared, actual));
    }
    if !ok {
        var fname: str = "<closure>";
        match self.current_func_name {
            OptString::Some(n) => { fname = n; }
            OptString::None => {}
        }
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): '" + fname + "' returns " + type_to_str(actual) + " but is declared to return " + type_to_str(declared));
    }
}

// `Enum::Variant(args)` must name an existing variant with matching arity.
pub fn TypeChecker_check_enum_constructor(self: &mut TypeChecker, enum_name: str, variant: str, arg_tys: Vec<Type>) {
    var n_args: i64 = arg_tys.len();
    var resolved: str = TypeChecker_resolve_struct_name(self, enum_name);
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        var key: str = self.enum_variants.get(ei).key;
        if key == resolved || key == enum_name {
            var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
            var vi: i64 = 0;
            while vi < variants.len() {
                if variants.get(vi).name == variant {
                    var payload: Vec<Type> = variants.get(vi).payload_types;
                    var n: i64 = payload.len();
                    if n != n_args {
                        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + key + "::" + variant + " takes " + int_to_str(n) + " value(s), got " + int_to_str(n_args));
                        return;
                    }
                    var fi: i64 = 0;
                    while fi < n {
                        var expected: Type = payload.get(fi);
                        // Generic payloads are checked after monomorphization.
                        if !TypeChecker_type_contains_param(self, expected) && !TypeChecker_is_enum_type_param(self, expected)
                            && !type_mentions_any(expected, TypeChecker_enum_params_of(self, key))
                            && !TypeChecker_arg_compatible(self, expected, arg_tys.get(fi)) {
                            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + key + "::" + variant + " field " + int_to_str(fi + 1) + " expects '" + type_to_str(expected) + "', got '" + type_to_str(arg_tys.get(fi)) + "'");
                        }
                        fi = fi + 1;
                    }
                    return;
                }
                vi = vi + 1;
            }
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): enum '" + key + "' has no variant '" + variant + "'");
            return;
        }
        ei = ei + 1;
    }
}

// Check a block in its own scope and return the type of its trailing
// expression statement (Void if it has none).
pub fn TypeChecker_check_block_value(self: &mut TypeChecker, stmts: Vec<Stmt>) -> Type {
    TypeChecker_push_scope(self);
    var last: Type = TypeChecker_check_stmts_value(self, stmts);
    TypeChecker_pop_scope(self);
    return last;
}

// Check statements in the current scope; the value is the trailing
// expression's type, Never if the list ends by leaving the block
// (return/break/continue), else Void.
pub fn TypeChecker_check_stmts_value(self: &mut TypeChecker, stmts: Vec<Stmt>) -> Type {
    var last: Type = Type::Void;
    var i: i64 = 0;
    while i < stmts.len() {
        var st: Stmt = stmts.get(i);
        var handled: bool = false;
        if i + 1 == stmts.len() {
            match st {
                Stmt::Expr(e, line) => {
                    last = TypeChecker_check_expr(self, e);
                    TypeChecker_consume_linear_in_expr(self, e, line);
                    handled = true;
                }
                _ => {}
            }
        }
        if !handled {
            TypeChecker_check_stmt(self, st);
            if i + 1 == stmts.len() {
                match st {
                    Stmt::Return(_, _) => { last = Type::Never; }
                    Stmt::Break(_, _) => { last = Type::Never; }
                    Stmt::Continue(_) => { last = Type::Never; }
                    _ => {}
                }
            }
        }
        i = i + 1;
    }
    return last;
}

fn is_box_type(t: Type) -> bool {
    match t {
        Type::Generic(n, args) => { return n == "Box" && args.len() == 1; }
        _ => { return false; }
    }
    return false;
}

// Box<T> auto-derefs to T for field access, `*`, and `match`.
pub fn unbox_ty(t: Type) -> Type {
    match t {
        Type::Generic(n, args) => {
            if n == "Box" && args.len() == 1 { return args.get(0); }
            return t;
        }
        _ => { return t; }
    }
    return t;
}

// At the C FFI boundary a reference, str, raw pointer or runtime handle is
// passed as a pointer-sized integer or raw pointer.
/// A function handed to C must be a named one: C calls it through an adapter
/// made at compile time, with no captures and no struct result.
fn TypeChecker_check_c_callbacks(self: &mut TypeChecker, callee: str, sig: FuncSig, args: Vec<Expr>) -> void {
    var i: i64 = 0;
    while i < sig.param_types.len() && i < args.len() {
        var ok: bool = true;
        match TypeChecker_resolve_type(self, sig.param_types.get(i)) {
            Type::Func(_, _) => { ok = TypeChecker_is_c_callable(self, args.get(i)); }
            _ => {}
        }
        if !ok {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): C function '" + callee + "' parameter " + int_to_str(i + 1) + " needs a named function that returns no struct");
        }
        i = i + 1;
    }
}

fn TypeChecker_is_c_callable(self: &mut TypeChecker, arg: Expr) -> bool {
    match arg {
        Expr::Ident(name) => {
            match TypeChecker_lookup(self, name) {
                OptType::Some(_) => { return false; }
                OptType::None => {}
            }
            match TypeChecker_lookup_func_cache(self, name) {
                OptFuncSig::Some(sig) => {
                    match sig.ret_ty {
                        Type::Named(n) => {
                            match TypeChecker_lookup_struct_cache(self, n) {
                                OptVecStructField::Some(_) => { return false; }
                                OptVecStructField::None => {}
                            }
                        }
                        _ => {}
                    }
                    return true;
                }
                OptFuncSig::None => {}
            }
        }
        _ => {}
    }
    return false;
}

pub fn is_ffi_pointer_pair(param: Type, arg: Type) -> bool {
    var param_is_ptr: bool = false;
    match param {
        Type::I64 => { param_is_ptr = true; }
        Type::RawPtr(_, _) => { param_is_ptr = true; }
        _ => {}
    }
    var arg_is_ptr: bool = is_handle_type(arg);
    match arg {
        Type::Ref(_, _) => { arg_is_ptr = true; }
        Type::Str => { arg_is_ptr = true; }
        Type::RawPtr(_, _) => { arg_is_ptr = true; }
        _ => {}
    }
    return param_is_ptr && arg_is_ptr;
}

// The type parameters declared by enum `name` (empty if not generic).
pub fn TypeChecker_enum_params_of(self: &TypeChecker, name: str) -> Vec<str> {
    var ti: i64 = 0;
    while ti < self.enum_type_params.len() {
        if self.enum_type_params.get(ti).key == name { return self.enum_type_params.get(ti).val; }
        ti = ti + 1;
    }
    return Vec::new();
}

// Whether `t` names any of `params` anywhere (e.g. `E`, `Vec<E>`, `&E`).
pub fn type_mentions_any(t: Type, params: Vec<str>) -> bool {
    match t {
        Type::Named(n) => { return str_vec_contains(params, n); }
        Type::Generic(n, args) => {
            if str_vec_contains(params, n) { return true; }
            var i: i64 = 0;
            while i < args.len() {
                if type_mentions_any(args.get(i), params) { return true; }
                i = i + 1;
            }
            return false;
        }
        Type::Ref(inner, _) => { return type_mentions_any(box_type_unbox(inner), params); }
        Type::RawPtr(inner, _) => { return type_mentions_any(box_type_unbox(inner), params); }
        _ => { return false; }
    }
    return false;
}

// A bare type-parameter name of some generic enum (e.g. T in Option<T>).
pub fn TypeChecker_is_enum_type_param(self: &TypeChecker, t: Type) -> bool {
    match t {
        Type::Named(n) => {
            if HashMap_contains(self.enum_tp_set, n) { return true; }
            return str_vec_contains(self.current_type_params, n);
        }
        _ => { return false; }
    }
    return false;
}

// --- check_enum_pattern --------------------------------------------------
// Reject enum patterns naming a variant the enum does not have, or binding a
// different number of payload fields than the variant carries. Without this,
// `match op { BinOp::Ne => .. }` (no such variant) type-checked and silently
// never matched.

pub fn TypeChecker_check_enum_pattern(self: &mut TypeChecker, match_ty: Type, enum_name: str, variant: str, bindings: Vec<Binding>) {
    var ename: str = "";
    match TypeChecker_resolve_pattern_enum(self, match_ty, enum_name, variant) {
        OptString::Some(n) => { ename = n; }
        OptString::None => { return; }
    }
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        if self.enum_variants.get(ei).key == ename {
            var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
            var vi: i64 = 0;
            while vi < variants.len() {
                if variants.get(vi).name == variant {
                    var n_payload: i64 = variants.get(vi).payload_types.len();
                    if bindings.len() > 0 && bindings.len() != n_payload {
                        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): pattern " + ename + "::" + variant + " binds " + int_to_str(bindings.len()) + " field(s) but the variant has " + int_to_str(n_payload));
                    }
                    return;
                }
                vi = vi + 1;
            }
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): enum '" + ename + "' has no variant '" + variant + "'");
            return;
        }
        ei = ei + 1;
    }
}

// --- pattern_binding_types -----------------------------------------------

pub fn TypeChecker_pattern_binding_types(self: &TypeChecker, match_ty: Type, enum_name: str, variant: str, bindings: Vec<Binding>) -> Vec<Type> {
    var result: Vec<Type> = Vec::new();
    // Find enum variant payload types
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        if self.enum_variants.get(ei).key == enum_name {
            var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
            var vi: i64 = 0;
            while vi < variants.len() {
                if variants.get(vi).name == variant {
                    var payload_types: Vec<Type> = variants.get(vi).payload_types;
                    // Build type-param substitution from scrutinee's generic args.
                    // This allows Option<T> with Some(T) to substitute T with the
                    // actual type from the match expression.
                    var type_params: Vec<str> = Vec::new();
                    var ti: i64 = 0;
                    while ti < self.enum_type_params.len() {
                        if self.enum_type_params.get(ti).key == enum_name {
                            type_params = self.enum_type_params.get(ti).val;
                            ti = self.enum_type_params.len();
                        }
                        ti = ti + 1;
                    }
                    // Extract generic args from match_ty
                    var generic_args: Vec<Type> = Vec::new();
                    match match_ty {
                        Type::Generic(name, args) => {
                            if name == enum_name {
                                generic_args = args;
                            }
                        }
                        _ => {}
                    }
                    // Build substitution: type_params[i] -> generic_args[i]
                    var subst: Vec<StringType> = Vec::new();
                    var si: i64 = 0;
                    while si < type_params.len() && si < generic_args.len() {
                        subst.push(StringType_new(type_params.get(si), generic_args.get(si)));
                        si = si + 1;
                    }
                    // Apply substitution to each payload type
                    var pi: i64 = 0;
                    while pi < payload_types.len() && pi < bindings.len() {
                        var payload_ty: Type = payload_types.get(pi);
                        // Check if this is an unsubstituted type param (no substitution available)
                        var is_type_param: bool = false;
                        match payload_ty {
                            Type::Named(n) => {
                                // Check if n is a type param of this enum
                                var tpi: i64 = 0;
                                while tpi < type_params.len() {
                                    if type_params.get(tpi) == n {
                                        is_type_param = true;
                                        tpi = type_params.len();
                                    }
                                    tpi = tpi + 1;
                                }
                            }
                            _ => {}
                        }
                        var binding_ann: str = bindings.get(pi).ty;
                        var subst_ty: Type = TypeChecker_subst_type_params(payload_ty, subst);
                        // A type parameter in scope (inside `impl<T> Slot`) is the
                        // type, unless the binding names one (`Err(e: str)`)
                        var in_scope_param: bool = false;
                        match subst_ty {
                            Type::Named(sn) => { in_scope_param = tc_str_vec_contains(self.current_type_params, sn); }
                            _ => {}
                        }
                        if is_type_param && subst.len() > 0 && in_scope_param && !str_is_empty(binding_ann) {
                            result.push(type_from_annotation(binding_ann));
                        } else if is_type_param && subst.len() > 0 {
                            // Substitute the type param with the actual type
                            result.push(subst_ty);
                        } else if is_type_param {
                            // Unsubstituted type param: use binding annotation or i64 fallback
                            var binding_annot: str = bindings.get(pi).ty;
                            if !str_is_empty(binding_annot) {
                                result.push(type_from_annotation(binding_annot));
                            } else {
                                result.push(Type::I64);
                            }
                        } else {
                            result.push(payload_ty);
                        }
                        pi = pi + 1;
                    }
                    return result;
                }
                vi = vi + 1;
            }
            ei = self.enum_variants.len();
        }
        ei = ei + 1;
    }
    // Default: all i64
    var bi: i64 = 0;
    while bi < bindings.len() {
        result.push(Type::I64);
        bi = bi + 1;
    }
    return result;
}

// ---- CHUNK_MARKER_9 ----

// --- scan_stmts_for_effects ----------------------------------------------

pub fn TypeChecker_scan_stmts_for_effects(self: &TypeChecker, stmts: Vec<Stmt>, effects: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        TypeChecker_scan_stmt_for_effects(self, stmts.get(i), effects);
        i = i + 1;
    }
}

pub fn TypeChecker_scan_stmt_for_effects(self: &TypeChecker, stmt: Stmt, effects: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => { TypeChecker_scan_expr_for_effects(self, expr, effects); }
        Stmt::LetTuple(_, expr, _) => { TypeChecker_scan_expr_for_effects(self, expr, effects); }
        Stmt::Expr(expr, _) => { TypeChecker_scan_expr_for_effects(self, expr, effects); }
        Stmt::Assign(_, _, expr, _) => { TypeChecker_scan_expr_for_effects(self, expr, effects); }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            TypeChecker_scan_expr_for_effects(self, index, effects);
            TypeChecker_scan_expr_for_effects(self, expr, effects);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            TypeChecker_scan_expr_for_effects(self, ptr_expr, effects);
            TypeChecker_scan_expr_for_effects(self, expr, effects);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            TypeChecker_scan_expr_for_effects(self, object, effects);
            TypeChecker_scan_expr_for_effects(self, expr, effects);
        }
        Stmt::Return(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            TypeChecker_scan_expr_for_effects(self, cond, effects);
            TypeChecker_scan_stmts_for_effects(self, then_block, effects);
            match else_block {
                OptStmts::Some(eb) => { TypeChecker_scan_stmts_for_effects(self, eb, effects); }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, _) => {
            TypeChecker_scan_expr_for_effects(self, cond, effects);
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::For(_, iterator, body, _) => {
            TypeChecker_scan_expr_for_effects(self, iterator, effects);
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::Loop(body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Defer(body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Match(expr, arms, _) => {
            TypeChecker_scan_expr_for_effects(self, expr, effects);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_scan_stmts_for_effects(self, arms.get(ai).body, effects);
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Sandbox(body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Unsafe(body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Txn(body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::GradBlock(_, body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Backward(loss, _) => { TypeChecker_scan_expr_for_effects(self, loss, effects); }
        Stmt::Query(_, body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                TypeChecker_scan_stmts_for_effects(self, branch, effects);
                bi = bi + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            TypeChecker_scan_expr_for_effects(self, cont, effects);
            TypeChecker_scan_expr_for_effects(self, value, effects);
        }
        Stmt::SpawnScope(body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::CancelScope(_) => {}
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                TypeChecker_scan_expr_for_effects(self, cases.get(ci).channel, effects);
                TypeChecker_scan_stmts_for_effects(self, cases.get(ci).body, effects);
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(db) => { TypeChecker_scan_stmts_for_effects(self, db, effects); }
                OptStmts::None => {}
            }
        }
        Stmt::Handle(body, handlers, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
            var hi: i64 = 0;
            while hi < handlers.len() {
                TypeChecker_scan_stmts_for_effects(self, handlers.get(hi).body, effects);
                hi = hi + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(ai), effects);
                ai = ai + 1;
            }
        }
        _ => {}
    }
}

pub fn TypeChecker_scan_expr_for_effects(self: &TypeChecker, expr: Expr, effects: &mut Vec<str>) {
    match expr {
        Expr::IntLit(_) => {}
        Expr::FloatLit(_) => {}
        Expr::StringLit(_) => {}
        Expr::BoolLit(_) => {}
        Expr::Ident(_) => {}
        Expr::Binary(_, left, right) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(left), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(right), effects);
        }
        Expr::Unary(_, e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Call(callee, args) => {
            // Map builtin calls to effects (the table of src/typechecker.rs
            // scan_expr_for_effects).
            // (every name there starts with `p`: skip the comparisons otherwise).
            if str_byte_at(callee, 0) == 112 {
                var ce: str = "";
                if callee == "print" || callee == "println" || callee == "print_int" || callee == "print_float" || callee == "print_str"
                    || callee == "p_print_str" || callee == "p_eprint_str" || callee == "p_print_int" || callee == "p_println_str" || callee == "p_println_int"
                    || callee == "p_fs_read" || callee == "p_fs_write" { ce = "IO"; }
                // Files, directories, processes, the clock and the
                // environment are IO; sockets and HTTP are Net (release K7:
                // @deterministic, @crashfree and sandbox missed them inside
                // methods)
                else if str_starts_with(callee, "p_file_") || str_starts_with(callee, "p_dir_") || str_starts_with(callee, "p_process_")
                    || callee == "p_system" || callee == "p_mkdir" || callee == "p_rename" || callee == "p_remove"
                    || str_starts_with(callee, "p_clock_") || callee == "p_time_now" || callee == "p_getenv" || callee == "p_env_get"
                    || callee == "p_read_line" || callee == "p_read_stdin" || callee == "p_os_random_u64" { ce = "IO"; }
                else if str_starts_with(callee, "p_socket_") || str_starts_with(callee, "p_net_")
                    || (str_starts_with(callee, "p_http_") && !str_contains(callee, "build") && !str_contains(callee, "parse"))
                    || str_starts_with(callee, "p_tls_") || str_starts_with(callee, "p_dns_") { ce = "Net"; }
                else if callee == "p_spawn_process" || callee == "p_spawn_thread" || callee == "p_thread_spawn" { ce = "Spawn"; }
                else if callee == "p_panic" { ce = "Diverge"; }
                else if callee == "p_vec_new" || callee == "p_map_new" || callee == "p_vec_push" || callee == "p_vec_insert"
                    || callee == "p_map_insert" || callee == "p_string_concat" || callee == "p_vec_clone"
                    || callee == "p_map_clone" || callee == "p_string_clone" || callee == "p_vec_new_with"
                    || callee == "p_alloc_new" { ce = "Alloc"; }
                else if callee == "p_tensor_matmul" || callee == "p_tensor_add" || callee == "p_tensor_sub"
                    || callee == "p_tensor_mul" || callee == "p_tensor_scale" || callee == "p_tensor_relu"
                    || callee == "p_tensor_sigmoid" || callee == "p_tensor_softmax" || callee == "p_tensor_dot"
                    || callee == "p_tensor_sum" || callee == "p_tensor_mean" || callee == "p_tensor_transpose"
                    || callee == "p_tensor_reshape" || callee == "p_tensor_zeros" || callee == "p_tensor_ones"
                    || callee == "p_tensor_from_vec" || callee == "p_tensor_filled"
                    || callee == "p_quantize_q8" || callee == "p_dequantize_q8" || callee == "p_qmatmul"
                    || callee == "p_find_quant_params" { ce = "Diff"; }
                else if callee == "p_dp_noise" || callee == "p_dropout" || callee == "p_gaussian_noise" { ce = "Noise"; }
                else if callee == "p_all_reduce" || callee == "p_broadcast" || callee == "p_all_gather" || callee == "p_scatter"
                    || callee == "p_send_tensor" || callee == "p_recv_tensor" { ce = "Comm"; }
                if ce != "" {
                    if !str_vec_contains_ref(effects, ce) { effects.push(ce); }
                }
                if callee == "p_kv_cache_new" || callee == "p_kv_cache_append" || callee == "p_kv_cache_get"
                    || callee == "p_kv_cache_len" || callee == "p_kv_cache_clear" || callee == "p_kv_cache_evict" {
                    if !str_vec_contains_ref(effects, "Alloc") { effects.push("Alloc"); }
                    if !str_vec_contains_ref(effects, "Read") { effects.push("Read"); }
                    if !str_vec_contains_ref(effects, "Write") { effects.push("Write"); }
                }
            }
            // Check user-defined function effects
            var slot: i64 = HashMap_get(self.func_effects_index, callee);
            if slot != 0 {
                var func_effs: Vec<str> = self.func_effects.get(slot - 1).val;
                var ei: i64 = 0;
                while ei < func_effs.len() {
                    if !str_vec_contains_ref(effects, func_effs.get(ei)) {
                        effects.push(func_effs.get(ei));
                    }
                    ei = ei + 1;
                }
            }
            // Effect polymorphism: a higher-order callee takes on the effects
            // of the functions passed to its function-typed parameters here
            var ho_at: i64 = HashMap_get(self.ho_fn_index, callee);
            if ho_at != 0 {
                var hidx: Vec<i64> = self.ho_fn_idx.get(ho_at - 1);
                var hk: i64 = 0;
                while hk < hidx.len() {
                    if hidx.get(hk) < args.len() {
                        TypeChecker_passed_fn_effects(self, args.get(hidx.get(hk)), effects);
                    }
                    hk = hk + 1;
                }
            }
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(ai), effects);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(receiver), effects);
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(ai), effects);
                ai = ai + 1;
            }
        }
        Expr::FieldAccess(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::OptionalFieldAccess(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                TypeChecker_scan_expr_for_effects(self, fields.get(fi).value, effects);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(s), effects); }
                OptBoxExpr::None => {}
            }
        }
        Expr::If(cond, then_block, else_block) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(cond), effects);
            TypeChecker_scan_stmts_for_effects(self, then_block, effects);
            match else_block {
                OptStmts::Some(eb) => { TypeChecker_scan_stmts_for_effects(self, eb, effects); }
                OptStmts::None => {}
            }
        }
        Expr::Range(start, end, _) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(start), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(end), effects);
        }
        Expr::Block(stmts) => { TypeChecker_scan_stmts_for_effects(self, stmts, effects); }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_scan_expr_for_effects(self, elements.get(i), effects);
                i = i + 1;
            }
        }
        Expr::Index(array, index) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(array), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(index), effects);
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(e) => { TypeChecker_scan_expr_for_effects(self, e, effects); }
                    FStringPart::Literal(_) => {}
                }
                i = i + 1;
            }
        }
        Expr::Match(expr, arms) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(expr), effects);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_scan_stmts_for_effects(self, arms.get(ai).body, effects);
                match arms.get(ai).guard {
                    OptBoxExpr::Some(g) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(g), effects); }
                    OptBoxExpr::None => {}
                }
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(i), effects);
                i = i + 1;
            }
        }
        Expr::Ref(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Deref(e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::StrConcat(l, r) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(l), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(r), effects);
        }
        Expr::Try(e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Coalesce(e, d) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(d), effects);
        }
        Expr::TryBlock(body) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Expr::IsCheck(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::TupleLit(elems) => {
            var i: i64 = 0;
            while i < elems.len() {
                TypeChecker_scan_expr_for_effects(self, elems.get(i), effects);
                i = i + 1;
            }
        }
        Expr::Closure(_, body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Expr::Cast(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Asm(_, operands) => {
            if !str_vec_contains_ref(effects, "Read") { effects.push("Read"); }
            if !str_vec_contains_ref(effects, "Write") { effects.push("Write"); }
            var i: i64 = 0;
            while i < operands.len() {
                TypeChecker_scan_expr_for_effects(self, operands.get(i).expr, effects);
                i = i + 1;
            }
        }
        Expr::Comptime(e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::ComptimeBlock(stmts) => { TypeChecker_scan_stmts_for_effects(self, stmts, effects); }
        Expr::ComptimeReflect(_, _) => {}
        Expr::PipeForward(left, right) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(left), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(right), effects);
        }
        Expr::QuantCast(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Await(e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Spawn(e) => {
            // As src/typechecker.rs: a `spawn` expression contributes no
            // effect to the spawning function (the task runs elsewhere);
            // only explicit p_thread_spawn/p_spawn_* calls are !Spawn.
        }
        Expr::Yield(e) => {
            if !str_vec_contains_ref(effects, "Yield") { effects.push("Yield"); }
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::NamedArg(name, e) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
    }
}

// ---- CHUNK_MARKER_10 ----

// --- Lint functions ------------------------------------------------------

pub fn TypeChecker_lint_unused_functions(self: &mut TypeChecker, program: Program) {
    var called: Vec<str> = Vec::new();
    called.push("main");
    // Collect all called functions
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        TypeChecker_collect_called_funcs(self, program.funcs.get(fi).body, &mut called);
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            TypeChecker_collect_called_funcs(self, imp.methods.get(mi).body, &mut called);
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    var timpi: i64 = 0;
    while timpi < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(timpi);
        var tmi: i64 = 0;
        while tmi < timp.methods.len() {
            TypeChecker_collect_called_funcs(self, timp.methods.get(tmi).body, &mut called);
            tmi = tmi + 1;
        }
        timpi = timpi + 1;
    }
    called = tc_dedupe_strs(called);
    // Report unused functions (skip main, pub, __ prefixed, comptime)
    var fi2: i64 = 0;
    while fi2 < program.funcs.len() {
        var func: Func = program.funcs.get(fi2);
        if !tc_str_vec_contains(called, func.name) && !func.is_pub && !func.is_comptime && !str_starts_with(func.name, "__") && func.name != "main" {
            self.warnings.push("unused function '" + func.name + "' — defined but never called");
        }
        fi2 = fi2 + 1;
    }
}

pub fn TypeChecker_collect_called_funcs(self: &TypeChecker, stmts: Vec<Stmt>, called: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        TypeChecker_collect_called_funcs_stmt(self, stmts.get(i), called);
        i = i + 1;
    }
}

pub fn TypeChecker_collect_called_funcs_stmt(self: &TypeChecker, stmt: Stmt, called: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => { TypeChecker_collect_called_funcs_expr(self, expr, called); }
        Stmt::LetTuple(_, expr, _) => { TypeChecker_collect_called_funcs_expr(self, expr, called); }
        Stmt::Expr(expr, _) => { TypeChecker_collect_called_funcs_expr(self, expr, called); }
        Stmt::Assign(_, _, expr, _) => { TypeChecker_collect_called_funcs_expr(self, expr, called); }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, index, called);
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, ptr_expr, called);
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, object, called);
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::Return(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            TypeChecker_collect_called_funcs_expr(self, cond, called);
            TypeChecker_collect_called_funcs(self, then_block, called);
            match else_block {
                OptStmts::Some(eb) => { TypeChecker_collect_called_funcs(self, eb, called); }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, _) => {
            TypeChecker_collect_called_funcs_expr(self, cond, called);
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::For(_, iterator, body, _) => {
            TypeChecker_collect_called_funcs_expr(self, iterator, called);
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::Loop(body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Defer(body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Match(expr, arms, _) => {
            TypeChecker_collect_called_funcs_expr(self, expr, called);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_collect_called_funcs(self, arms.get(ai).body, called);
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Sandbox(body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Unsafe(body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Txn(body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::GradBlock(_, body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Backward(loss, _) => { TypeChecker_collect_called_funcs_expr(self, loss, called); }
        Stmt::Query(_, body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                TypeChecker_collect_called_funcs(self, branch, called);
                bi = bi + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            TypeChecker_collect_called_funcs_expr(self, cont, called);
            TypeChecker_collect_called_funcs_expr(self, value, called);
        }
        Stmt::SpawnScope(body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::CancelScope(_) => {}
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                TypeChecker_collect_called_funcs_expr(self, cases.get(ci).channel, called);
                TypeChecker_collect_called_funcs(self, cases.get(ci).body, called);
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(db) => { TypeChecker_collect_called_funcs(self, db, called); }
                OptStmts::None => {}
            }
        }
        Stmt::Handle(body, handlers, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
            var hi: i64 = 0;
            while hi < handlers.len() {
                TypeChecker_collect_called_funcs(self, handlers.get(hi).body, called);
                hi = hi + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(ai), called);
                ai = ai + 1;
            }
        }
        _ => {}
    }
}

pub fn TypeChecker_collect_called_funcs_expr(self: &TypeChecker, expr: Expr, called: &mut Vec<str>) {
    match expr {
        Expr::IntLit(_) => {}
        Expr::FloatLit(_) => {}
        Expr::StringLit(_) => {}
        Expr::BoolLit(_) => {}
        Expr::Ident(_) => {}
        Expr::Binary(_, left, right) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(left), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(right), called);
        }
        Expr::Unary(_, e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Call(callee, args) => {
            called.push(callee); // deduplicated by the caller (tc_dedupe_strs)
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(i), called);
                i = i + 1;
            }
        }
        Expr::MethodCall(receiver, method, args) => {
            // "#unwrap" (no function has that name) marks a call that panics on
            // None or Err, for the lint in lint_unwraps
            if method == "unwrap" || method == "expect" {
                called.push("#unwrap");
            }
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(receiver), called);
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(i), called);
                i = i + 1;
            }
        }
        Expr::FieldAccess(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::OptionalFieldAccess(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                TypeChecker_collect_called_funcs_expr(self, fields.get(fi).value, called);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(s), called); }
                OptBoxExpr::None => {}
            }
        }
        Expr::If(cond, then_block, else_block) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(cond), called);
            TypeChecker_collect_called_funcs(self, then_block, called);
            match else_block {
                OptStmts::Some(eb) => { TypeChecker_collect_called_funcs(self, eb, called); }
                OptStmts::None => {}
            }
        }
        Expr::Range(start, end, _) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(start), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(end), called);
        }
        Expr::Block(stmts) => { TypeChecker_collect_called_funcs(self, stmts, called); }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_collect_called_funcs_expr(self, elements.get(i), called);
                i = i + 1;
            }
        }
        Expr::Index(array, index) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(array), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(index), called);
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(e) => { TypeChecker_collect_called_funcs_expr(self, e, called); }
                    FStringPart::Literal(_) => {}
                }
                i = i + 1;
            }
        }
        Expr::Match(expr, arms) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(expr), called);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_collect_called_funcs(self, arms.get(ai).body, called);
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(i), called);
                i = i + 1;
            }
        }
        Expr::Ref(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Deref(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::StrConcat(l, r) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(l), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(r), called);
        }
        Expr::Try(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Coalesce(e, d) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(d), called);
        }
        Expr::TryBlock(body) => { TypeChecker_collect_called_funcs(self, body, called); }
        Expr::IsCheck(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::TupleLit(elems) => {
            var i: i64 = 0;
            while i < elems.len() {
                TypeChecker_collect_called_funcs_expr(self, elems.get(i), called);
                i = i + 1;
            }
        }
        Expr::Closure(_, body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Expr::Cast(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Asm(_, operands) => {
            var i: i64 = 0;
            while i < operands.len() {
                TypeChecker_collect_called_funcs_expr(self, operands.get(i).expr, called);
                i = i + 1;
            }
        }
        Expr::Comptime(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::ComptimeBlock(stmts) => { TypeChecker_collect_called_funcs(self, stmts, called); }
        Expr::ComptimeReflect(_, _) => {}
        Expr::PipeForward(left, right) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(left), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(right), called);
        }
        Expr::QuantCast(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Await(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Spawn(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Yield(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::NamedArg(name, e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
    }
}

pub fn TypeChecker_lint_unused_imports(self: &mut TypeChecker, program: Program) {
    if program.imports.len() == 0 { return; }

    // Collect all function names called in the program
    var called: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        TypeChecker_collect_called_funcs(self, program.funcs.get(fi).body, &mut called);
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            TypeChecker_collect_called_funcs(self, imp.methods.get(mi).body, &mut called);
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    var timpi: i64 = 0;
    while timpi < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(timpi);
        var tmi: i64 = 0;
        while tmi < timp.methods.len() {
            TypeChecker_collect_called_funcs(self, timp.methods.get(tmi).body, &mut called);
            tmi = tmi + 1;
        }
        timpi = timpi + 1;
    }
    called = tc_dedupe_strs(called);

    // For each import, check if any called function starts with the module name
    var i: i64 = 0;
    while i < program.imports.len() {
        var imp: ImportDef = program.imports.get(i);
        if imp.path == "core" { i = i + 1; continue; }
        var module_prefix: str = str_replace(imp.path, "::", "_") + "_";
        var any_used: bool = false;
        var ci: i64 = 0;
        while ci < called.len() {
            if str_starts_with(called.get(ci), module_prefix) {
                any_used = true;
                ci = called.len();
            }
            ci = ci + 1;
        }
        if !any_used {
            self.warnings.push("unused import: '" + imp.path + "' — module is imported but none of its functions are called");
        }
        i = i + 1;
    }
}

// ---- CHUNK_MARKER_11 ----

// --- scan_for_floats -----------------------------------------------------

pub fn scan_for_floats(stmts: Vec<Stmt>) -> Vec<str> {
    var found: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_floats(stmts.get(i), &mut found);
        i = i + 1;
    }
    return found;
}

pub fn scan_stmt_for_floats(stmt: Stmt, found: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => { scan_expr_for_floats(expr, found); }
        Stmt::LetTuple(_, expr, _) => { scan_expr_for_floats(expr, found); }
        Stmt::Expr(expr, _) => { scan_expr_for_floats(expr, found); }
        Stmt::Assign(_, _, expr, _) => { scan_expr_for_floats(expr, found); }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            scan_expr_for_floats(index, found);
            scan_expr_for_floats(expr, found);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            scan_expr_for_floats(ptr_expr, found);
            scan_expr_for_floats(expr, found);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            scan_expr_for_floats(object, found);
            scan_expr_for_floats(expr, found);
        }
        Stmt::Return(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            scan_expr_for_floats(cond, found);
            var i: i64 = 0;
            while i < then_block.len() {
                scan_stmt_for_floats(then_block.get(i), found);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        scan_stmt_for_floats(eb.get(j), found);
                        j = j + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, _) => {
            scan_expr_for_floats(cond, found);
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::For(_, iterator, body, _) => {
            scan_expr_for_floats(iterator, found);
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Loop(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Defer(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Match(expr, arms, _) => {
            scan_expr_for_floats(expr, found);
            var ai: i64 = 0;
            while ai < arms.len() {
                var i: i64 = 0;
                while i < arms.get(ai).body.len() {
                    scan_stmt_for_floats(arms.get(ai).body.get(i), found);
                    i = i + 1;
                }
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Sandbox(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Unsafe(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Txn(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::GradBlock(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Backward(loss, _) => { scan_expr_for_floats(loss, found); }
        Stmt::Query(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                var si: i64 = 0;
                while si < branch.len() {
                    scan_stmt_for_floats(branch.get(si), found);
                    si = si + 1;
                }
                bi = bi + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            scan_expr_for_floats(cont, found);
            scan_expr_for_floats(value, found);
        }
        Stmt::SpawnScope(body, _) => {
            var si6: i64 = 0;
            while si6 < body.len() {
                scan_stmt_for_floats(body.get(si6), found);
                si6 = si6 + 1;
            }
        }
        Stmt::CancelScope(_) => {}
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                scan_expr_for_floats(cases.get(ci).channel, found);
                var i: i64 = 0;
                while i < cases.get(ci).body.len() {
                    scan_stmt_for_floats(cases.get(ci).body.get(i), found);
                    i = i + 1;
                }
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(db) => {
                    var i: i64 = 0;
                    while i < db.len() {
                        scan_stmt_for_floats(db.get(i), found);
                        i = i + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Stmt::Handle(body, _, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        _ => {}
    }
}

pub fn scan_expr_for_floats(expr: Expr, found: &mut Vec<str>) {
    match expr {
        Expr::FloatLit(_) => { found.push("float_literal"); }
        Expr::IntLit(_) => {}
        Expr::StringLit(_) => {}
        Expr::BoolLit(_) => {}
        Expr::Ident(_) => {}
        Expr::Binary(_, left, right) => {
            scan_expr_for_floats(box_expr_unbox(left), found);
            scan_expr_for_floats(box_expr_unbox(right), found);
        }
        Expr::Unary(_, e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Call(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            scan_expr_for_floats(box_expr_unbox(receiver), found);
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        Expr::FieldAccess(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::OptionalFieldAccess(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                scan_expr_for_floats(fields.get(fi).value, found);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { scan_expr_for_floats(box_expr_unbox(s), found); }
                OptBoxExpr::None => {}
            }
        }
        Expr::If(cond, then_block, else_block) => {
            scan_expr_for_floats(box_expr_unbox(cond), found);
            var i: i64 = 0;
            while i < then_block.len() {
                scan_stmt_for_floats(then_block.get(i), found);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        scan_stmt_for_floats(eb.get(j), found);
                        j = j + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Expr::Range(start, end, _) => {
            scan_expr_for_floats(box_expr_unbox(start), found);
            scan_expr_for_floats(box_expr_unbox(end), found);
        }
        Expr::Block(stmts) => {
            var i: i64 = 0;
            while i < stmts.len() {
                scan_stmt_for_floats(stmts.get(i), found);
                i = i + 1;
            }
        }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                scan_expr_for_floats(elements.get(i), found);
                i = i + 1;
            }
        }
        Expr::Index(array, index) => {
            scan_expr_for_floats(box_expr_unbox(array), found);
            scan_expr_for_floats(box_expr_unbox(index), found);
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(e) => { scan_expr_for_floats(e, found); }
                    FStringPart::Literal(_) => {}
                }
                i = i + 1;
            }
        }
        Expr::Match(expr, arms) => {
            scan_expr_for_floats(box_expr_unbox(expr), found);
            var ai: i64 = 0;
            while ai < arms.len() {
                var i: i64 = 0;
                while i < arms.get(ai).body.len() {
                    scan_stmt_for_floats(arms.get(ai).body.get(i), found);
                    i = i + 1;
                }
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        Expr::Ref(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Deref(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::StrConcat(l, r) => {
            scan_expr_for_floats(box_expr_unbox(l), found);
            scan_expr_for_floats(box_expr_unbox(r), found);
        }
        Expr::Try(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Coalesce(e, d) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
            scan_expr_for_floats(box_expr_unbox(d), found);
        }
        Expr::TryBlock(body) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Expr::IsCheck(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::TupleLit(elems) => {
            var i: i64 = 0;
            while i < elems.len() {
                scan_expr_for_floats(elems.get(i), found);
                i = i + 1;
            }
        }
        Expr::Closure(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Expr::Cast(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Asm(_, operands) => {
            var i: i64 = 0;
            while i < operands.len() {
                scan_expr_for_floats(operands.get(i).expr, found);
                i = i + 1;
            }
        }
        Expr::Comptime(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::ComptimeBlock(stmts) => {
            var i: i64 = 0;
            while i < stmts.len() {
                scan_stmt_for_floats(stmts.get(i), found);
                i = i + 1;
            }
        }
        Expr::ComptimeReflect(_, _) => {}
        Expr::PipeForward(left, right) => {
            scan_expr_for_floats(box_expr_unbox(left), found);
            scan_expr_for_floats(box_expr_unbox(right), found);
        }
        Expr::QuantCast(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Await(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Spawn(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Yield(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::NamedArg(name, e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
    }
}

// ---- END ----
