                        if self.func_generic_names.get(gi) == callee {
                            // An integer literal given for a type parameter is an
                            // i64, not the smallest type that holds it
                            var gen_args: Vec<Type> = Vec::new();
                            var gai: i64 = 0;
                            while gai < arg_types.len() {
                                var gat: Type = arg_types.get(gai);
                                if gai < args.len() {
                                    match args.get(gai) {
                                        Expr::IntLit(_) => {
                                            gat = Type::I64;
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                gen_args.push(gat);
                                gai = gai + 1;
                            }
                            return TypeChecker_check_generic_call(self, callee, self.func_generic_tps.get(gi), self.func_generic_bounds.get(gi), sig.param_types, sig.ret_ty, gen_args, hint);
                        }
                        gi = gi + 1;
                    }
                    // Check every argument (generic parameters are resolved by
                    // monomorphization).
                    var pi: i64 = 0;
                    while pi < sig.param_types.len() && pi < arg_types.len() {
                        var raw_param: Type = sig.param_types.get(pi);
                        var param: Type = TypeChecker_resolve_type(self, raw_param);
                        var arg: Type = arg_types.get(pi);
                        if !TypeChecker_type_contains_param(self, raw_param) && !is_single_upper_name(raw_param) && !(callee == "print" || callee == "println" || callee == "eprint" || callee == "eprintln") && !TypeChecker_arg_compatible(self, param, arg) && !(is_handle_int_pair(param, tc_read_through(arg)) && TypeChecker_is_runtime_call(self, callee)) && !(str_vec_contains(self.extern_fns, callee) && is_ffi_pointer_pair(param, arg)) {
                            var in_fn: str = "";
                            match self.current_func_name {
                                OptString::Some(fname) => {
                                    in_fn = ", in '" + fname + "'";
                                }
                                OptString::None => {
                                }
                            }
                            self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): function '" + callee + "' parameter " + int_to_str(pi + 1) + " expects '" + type_to_str(param) + "', got '" + type_to_str(arg) + "'");
                        } else if tc_is_str(param) && tc_is_borrowed_str(arg) && !tc_borrow_safe_callee(callee) {
                            // A borrowed string given where an owned one is taken:
                            // the callee could keep it past its owner (M11)
                            self.errors.push("Borrow error (line " + int_to_str(self.current_line) + "): '" + callee + "' parameter " + int_to_str(pi + 1) + " takes an owned str, and it is given a borrowed string (&str) it could keep after the owner frees it.\n    Fix: pass str_clone(s), or declare the parameter &str.");
                        }
