// typechecker.fd — Fides typechecker, rewritten from src/typechecker.rs (7424 LOC)
//
// This is the largest compiler module. It handles:
// - Type inference and checking (check_expr, check_stmt)
// - Region checking (use-after-free, budget enforcement)
// - Effect checking (declared vs inferred effects)
// - Capability checking (sandbox, strict caps)
// - Safety annotation verification (@deterministic, @crashfree, @gas, etc.)
// - Trait resolution and impl verification
// - Generic instantiation and type parameter bounds
// - Linear type checking (@linear structs must be consumed)
// - @send/@sync checks for thread safety
//
// Adaptations from Rust:
// 1. HashMap<K,V> → Vec-based maps with helper structs (Fides HashMap is i64→i64)
// 2. HashSet<T> → Vec<T> with contains() helper
// 3. String → str, usize/u32/u64 → i64
// 4. Option<T> → Opt* enums
// 5. Box<Type>/Box<Expr> → box_* helper functions for recursive calls
// 6. &mut self methods → self: &mut TypeChecker
// 7. format! → string concatenation with int_to_str/type_to_str
// 8. .clone() → not needed (Fides values are copied by value)
// 9. matches! macro → explicit match with _ => false
//
// Dependencies: compiler::ast, compiler::ir

module compiler::typechecker;

use core;
use vec;
use string;
use compiler::ast;

// ─── Box unbox helpers ───────────────────────────────────────────────────
// Fides match patterns on Box<T> auto-unbox for matching, but the extracted
// fields are still Box<T>. These helpers convert Box<Type>/Box<Expr> back to
// Type/Expr for passing to functions that expect unboxed values.

pub fn box_type_unbox(b: Box<Type>) -> Type {
    match b {
        Type::I8 => { return Type::I8; }
        Type::I16 => { return Type::I16; }
        Type::I32 => { return Type::I32; }
        Type::I64 => { return Type::I64; }
        Type::I128 => { return Type::I128; }
        Type::U8 => { return Type::U8; }
        Type::U16 => { return Type::U16; }
        Type::U32 => { return Type::U32; }
        Type::U64 => { return Type::U64; }
        Type::U128 => { return Type::U128; }
        Type::F32 => { return Type::F32; }
        Type::F64 => { return Type::F64; }
        Type::Bool => { return Type::Bool; }
        Type::Str => { return Type::Str; }
        Type::Void => { return Type::Void; }
        Type::Never => { return Type::Never; }
        Type::Infer => { return Type::Infer; }
        Type::Named(n) => { return Type::Named(n); }
        Type::Generic(n, args) => { return Type::Generic(n, args); }
        Type::Ref(inner, is_mut) => { return Type::Ref(inner, is_mut); }
        Type::RawPtr(inner, is_mut) => { return Type::RawPtr(inner, is_mut); }
        Type::Array(elem, size) => { return Type::Array(elem, size); }
        Type::ArrayConst(elem, sp) => { return Type::ArrayConst(elem, sp); }
        Type::Tuple(types) => { return Type::Tuple(types); }
        Type::Func(params, ret) => { return Type::Func(params, ret); }
        Type::Dyn(tn) => { return Type::Dyn(tn); }
        Type::Assoc(tn, tn2, an, at) => { return Type::Assoc(tn, tn2, an, at); }
        Type::ShapedTensor(shape, dtype) => { return Type::ShapedTensor(shape, dtype); }
    }
    return Type::Never;
}

pub fn box_expr_unbox(b: Box<Expr>) -> Expr {
    match b {
        Expr::IntLit(v) => { return Expr::IntLit(v); }
        Expr::FloatLit(v) => { return Expr::FloatLit(v); }
        Expr::StringLit(v) => { return Expr::StringLit(v); }
        Expr::BoolLit(v) => { return Expr::BoolLit(v); }
        Expr::Ident(n) => { return Expr::Ident(n); }
        Expr::Binary(op, l, r) => { return Expr::Binary(op, l, r); }
        Expr::Unary(op, e) => { return Expr::Unary(op, e); }
        Expr::Call(c, args) => { return Expr::Call(c, args); }
        Expr::MethodCall(recv, m, args) => { return Expr::MethodCall(recv, m, args); }
        Expr::FieldAccess(e, f) => { return Expr::FieldAccess(e, f); }
        Expr::OptionalFieldAccess(e, f) => { return Expr::OptionalFieldAccess(e, f); }
        Expr::StructLit(n, fields, spread) => { return Expr::StructLit(n, fields, spread); }
        Expr::If(c, t, e) => { return Expr::If(c, t, e); }
        Expr::Range(s, e, inclusive) => { return Expr::Range(s, e, inclusive); }
        Expr::Block(stmts) => { return Expr::Block(stmts); }
        Expr::ArrayLit(et, elems) => { return Expr::ArrayLit(et, elems); }
        Expr::Index(arr, idx) => { return Expr::Index(arr, idx); }
        Expr::FString(parts) => { return Expr::FString(parts); }
        Expr::Match(e, arms) => { return Expr::Match(e, arms); }
        Expr::EnumLit(en, vn, args) => { return Expr::EnumLit(en, vn, args); }
        Expr::Ref(e, is_mut) => { return Expr::Ref(e, is_mut); }
        Expr::Deref(e) => { return Expr::Deref(e); }
        Expr::StrConcat(l, r) => { return Expr::StrConcat(l, r); }
        Expr::Try(e) => { return Expr::Try(e); }
        Expr::Coalesce(e, d) => { return Expr::Coalesce(e, d); }
        Expr::TryBlock(body) => { return Expr::TryBlock(body); }
        Expr::IsCheck(e, tn) => { return Expr::IsCheck(e, tn); }
        Expr::TupleLit(elems) => { return Expr::TupleLit(elems); }
        Expr::Closure(params, body, ret) => { return Expr::Closure(params, body, ret); }
        Expr::Cast(e, t) => { return Expr::Cast(e, t); }
        Expr::Asm(asm, operands) => { return Expr::Asm(asm, operands); }
        Expr::Comptime(e) => { return Expr::Comptime(e); }
        Expr::ComptimeBlock(stmts) => { return Expr::ComptimeBlock(stmts); }
        Expr::ComptimeReflect(op, tn) => { return Expr::ComptimeReflect(op, tn); }
        Expr::PipeForward(l, r) => { return Expr::PipeForward(l, r); }
        Expr::QuantCast(e, t) => { return Expr::QuantCast(e, t); }
        Expr::Await(e) => { return Expr::Await(e); }
        Expr::Spawn(e) => { return Expr::Spawn(e); }
    }
    return Expr::IntLit(0);
}

