                if method == "to_string" {
                    return Type::Named("String");
                }
                if method == "contains" {
                    return Type::Bool;
                }
                if method == "starts_with" {
                    return Type::Bool;
                }
                if method == "ends_with" {
                    return Type::Bool;
                }
