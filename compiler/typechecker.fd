            // the instance's type arguments (known-bugs 2f.11)
            match effective_ty {
                Type::Generic(gsn, gsargs) => {
                    var gtps: Vec<str> = TypeChecker_struct_type_params(self, gsn);
                    if gtps.len() > 0 {
                        match TypeChecker_lookup_struct_cache(self, gsn) {
                            OptVecStructField::Some(gfields) => {
                                var gfi: i64 = 0;
                                while gfi < gfields.len() {
                                    if gfields.get(gfi).name == field {
                                        return tc_subst_type_params(gfields.get(gfi).ty, gtps, gsargs);
                                    }
                                    gfi = gfi + 1;
                                }
                                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): struct '" + gsn + "' has no field '" + field + "'");
                                return Type::Never;
                            }
                            OptVecStructField::None => {
                            }
                        }
                    }
                }
                _ => {
                }
            }
            match effective_ty {
                Type::Named(name) => {
                    // Find struct fields
                    var si: i64 = TypeChecker_struct_pos(self, name);
                    var si_lim: i64 = si + 1;
                    if si < 0 {
                        // CE9: a field read on a value of the function's
                        // own type parameter is checked at each call, with
                        // the type the call chooses
                        TypeChecker_note_tp_field_read(self, name, field);
                        si = 0;
                        si_lim = 0;
                    }
                    while si < si_lim {
                        if self.structs.get(si).key == name {
                            var fields: Vec<StructField> = self.structs.get(si).val;
                            var fi: i64 = 0;
                            while fi < fields.len() {
                                if fields.get(fi).name == field {
                                    // Field privacy: a private field is only
                                    // accessible from its defining module.
                                    var pidx: i64 = HashMap_get(self.private_fields, name + "." + field);
                                    if pidx > 0 {
                                        var struct_module: str = self.private_field_modules.get(pidx - 1);
