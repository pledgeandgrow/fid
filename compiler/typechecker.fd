                var vec_i64_args: Vec<Type> = Vec::new();
                vec_i64_args.push(Type::I64);
                return Type::Generic("Vec", vec_i64_args);
            }
            if callee == "compile_error" {
                if g_tc_comptime_depth == 0 {
                    self.errors.push("Comptime error (line " + int_to_str(self.current_line) + "): compile_error() reports while compiling: call it in comptime code (a `comptime fn`, a `comptime { }` block, a `comptime if` condition).
    Fix: move the call into comptime code.");
                    return Type::Never;
