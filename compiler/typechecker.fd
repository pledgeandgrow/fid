pub fn TypeChecker_is_typed_string(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::Named(name) => {
            if name == "SQLString" {
                return true;
            }
            if name == "ShellString" {
                return true;
            }
            if name == "HTMLString" {
                return true;
            }
            if name == "JSONString" {
                return true;
            }
            if name == "PathString" {
                return true;
            }
            return false;
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// 2g.87: the type a message names for operand `e` of type `t`. An
/// unsuffixed integer literal is an i64 in the language; the checker types
/// one with no integer hint by the narrowest type that holds it
/// (infer_int_type: `2` is an i8 inside), which a message must not show
/// ("got i8" for `2 * d`).
pub fn tc_operand_type_str(e: Expr, t: Type) -> str {
    match e {
        Expr::IntLit(v) => {
            if type_eq(t, infer_int_type(v)) {
                return "i64";
            }
        }
        Expr::Unary(uop, inner) => {
            match uop {
                UnaryOp::Neg => {
                    match box_expr_unbox(inner) {
                        Expr::IntLit(nv) => {
                            if type_eq(t, infer_int_type(nv)) || type_eq(t, infer_int_type(0 - nv)) {
                                return "i64";
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return type_to_str(t);
}

pub fn infer_int_type(value: i64) -> Type {
    if value >= -128 && value <= 127 {
        return Type::I8;
    }
    if value >= -32768 && value <= 32767 {
        return Type::I16;
    }
    if value >= -2147483648 && value <= 2147483647 {
        return Type::I32;
    }
    return Type::I64;
}

pub fn int_rank(ty: Type) -> i64 {
    match ty {
        Type::I8 => {
            return 0;
        }
        Type::U8 => {
            return 0;
        }
        Type::I16 => {
            return 1;
        }
        Type::U16 => {
            return 1;
        }
        Type::I32 => {
            return 2;
        }
        Type::U32 => {
            return 2;
        }
        Type::I64 => {
            return 3;
        }
        Type::U64 => {
            return 3;
        }
        Type::I128 => {
            return 4;
        }
        Type::U128 => {
            return 4;
        }
        _ => {
            return 255;
        }
    }
    return 255;
}

pub fn wider_type(a: Type, b: Type) -> Type {
    if int_rank(a) >= int_rank(b) {
        return a;
    }
    return b;
}

pub fn can_implicitly_widen(from: Type, to: Type) -> bool {
    if type_eq(from, to) {
        return true;
    }
    // Any integer can widen to any wider integer
    var from_rank: i64 = int_rank(from);
    var to_rank: i64 = int_rank(to);
    if from_rank < 255 && to_rank < 255 {
        return to_rank >= from_rank;
    }
    // Int can widen to float
    var from_is_int: bool = false;
    match from {
        Type::I8 => {
            from_is_int = true;
        }
        Type::I16 => {
            from_is_int = true;
        }
        Type::I32 => {
            from_is_int = true;
        }
        Type::I64 => {
            from_is_int = true;
        }
        Type::U8 => {
            from_is_int = true;
        }
        Type::U16 => {
            from_is_int = true;
        }
        Type::U32 => {
            from_is_int = true;
        }
        Type::U64 => {
            from_is_int = true;
        }
        _ => {
            from_is_int = false;
        }
    }
    var to_is_float: bool = false;
    match to {
        Type::F32 => {
            to_is_float = true;
        }
        Type::F64 => {
            to_is_float = true;
        }
        _ => {
            to_is_float = false;
        }
    }
    if from_is_int && to_is_float {
        return true;
    }
    return false;
}

// Type equality (structural)
pub fn type_eq(a: Type, b: Type) -> bool {
    match a {
        Type::I8 => {
            match b {
                Type::I8 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::I16 => {
            match b {
                Type::I16 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::I32 => {
            match b {
                Type::I32 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::I64 => {
            match b {
                Type::I64 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::I128 => {
            match b {
                Type::I128 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::U8 => {
            match b {
                Type::U8 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::U16 => {
            match b {
                Type::U16 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::U32 => {
            match b {
                Type::U32 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::U64 => {
            match b {
                Type::U64 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::U128 => {
            match b {
                Type::U128 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::F32 => {
            match b {
                Type::F32 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::F64 => {
            match b {
                Type::F64 => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::Bool => {
            match b {
                Type::Bool => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::Str => {
            match b {
                Type::Str => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::Void => {
            match b {
                Type::Void => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::Never => {
            match b {
                Type::Never => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::Infer => {
            match b {
                Type::Infer => {
                    return true;
                }, _ => {
                    return false;
                }
            }
        }
        Type::Named(n1) => {
            match b {
                Type::Named(n2) => {
                    return n1 == n2;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        Type::Generic(n1, a1) => {
            match b {
                Type::Generic(n2, a2) => {
                    if n1 != n2 {
                        return false;
                    }
                    if a1.len() != a2.len() {
                        return false;
                    }
                    var i: i64 = 0;
                    while i < a1.len() {
                        if !type_eq(a1.get(i), a2.get(i)) {
                            return false;
                        }
                        i = i + 1;
                    }
                    return true;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        Type::Ref(inner1, mut1) => {
            match b {
                Type::Ref(inner2, mut2) => {
                    if mut1 != mut2 {
                        return false;
                    }
                    return type_eq(box_type_unbox(inner1), box_type_unbox(inner2));
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        Type::RawPtr(inner1, mut1) => {
            match b {
                Type::RawPtr(inner2, mut2) => {
                    if mut1 != mut2 {
                        return false;
                    }
                    return type_eq(box_type_unbox(inner1), box_type_unbox(inner2));
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        Type::Array(elem1, sz1) => {
            match b {
                Type::Array(elem2, sz2) => {
                    if sz1 != sz2 {
                        return false;
                    }
                    return type_eq(box_type_unbox(elem1), box_type_unbox(elem2));
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        Type::ArrayConst(elem1, sp1) => {
            match b {
                Type::ArrayConst(elem2, sp2) => {
                    if sp1 != sp2 {
                        return false;
                    }
                    return type_eq(box_type_unbox(elem1), box_type_unbox(elem2));
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        Type::Tuple(t1) => {
            match b {
                Type::Tuple(t2) => {
                    if t1.len() != t2.len() {
                        return false;
                    }
                    var i: i64 = 0;
                    while i < t1.len() {
                        if !type_eq(t1.get(i), t2.get(i)) {
                            return false;
                        }
                        i = i + 1;
                    }
                    return true;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        Type::Func(p1, r1) => {
            match b {
                Type::Func(p2, r2) => {
                    if p1.len() != p2.len() {
                        return false;
                    }
                    var i: i64 = 0;
                    while i < p1.len() {
                        if !type_eq(p1.get(i), p2.get(i)) {
                            return false;
                        }
                        i = i + 1;
                    }
                    return type_eq(box_type_unbox(r1), box_type_unbox(r2));
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        Type::Dyn(n1) => {
            match b {
                Type::Dyn(n2) => {
                    return n1 == n2;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        Type::Assoc(t1, n1, f1, a1) => {
            match b {
                Type::Assoc(t2, n2, f2, a2) => {
                    if t1 != t2 {
                        return false;
                    }
                    if n1 != n2 {
                        return false;
                    }
                    if f1 != f2 {
                        return false;
                    }
                    if a1.len() != a2.len() {
                        return false;
                    }
                    var i: i64 = 0;
                    while i < a1.len() {
                        if !type_eq(a1.get(i), a2.get(i)) {
                            return false;
                        }
                        i = i + 1;
                    }
                    return true;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        Type::ShapedTensor(elem1, dims1) => {
            match b {
                Type::ShapedTensor(elem2, dims2) => {
                    if !type_eq(box_type_unbox(elem1), box_type_unbox(elem2)) {
                        return false;
                    }
                    if dims1.len() != dims2.len() {
                        return false;
                    }
                    return true;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        _ => {
            return false;
        }
    }
    return false;
}

// ---- CHUNK_MARKER_5 ----

// --- types_compatible ----------------------------------------------------

/// Raw memory is `unsafe` in the program itself and in every module it
/// imports, the standard library's included (release M2; M10, Nov 22). Only
/// the compiler's own modules and the trusted base (core and the runtimes)
/// are exempt: see tc_module_needs_unsafe.
fn TypeChecker_require_unsafe(self: &mut TypeChecker, what: str) {
    if self.unsafe_depth == 0 && tc_module_needs_unsafe(self.current_module) {
        self.errors.push("Safety error (line " + int_to_str(self.current_line) + "): " + what + " needs an `unsafe` block.");
    }
}

/// `x as str` (string header by construction, Nov 22): a str always
/// carries its string header (counted or literal; core's Str_drop and
/// Str_dup check it strictly). Casting a number or a pointer to str only
/// reinterprets the word, so the code doing it vouches that the word holds
/// such a string: it needs `unsafe`, as reading through a raw pointer does.
/// A C string becomes a str through p_str_from_ptr (a counted copy). `0 as
/// str`, the null str (no string at all, which every string function takes
/// as ""), stays allowed: tools/c2fd writes it for a C NULL.
fn TypeChecker_check_str_cast(self: &mut TypeChecker, e: Expr, src: Type, dst: Type) {
    match e {
        Expr::IntLit(n) => {
            if n == 0 {
                return;
            }
        }
        _ => {
        }
    }
    match dst {
        Type::Str => {
            if tc_cast_makes_raw_str(self, src) {
                var src_text: str = type_to_str(src);
                match e {
                    Expr::IntLit(_) => {
                        src_text = "an integer";
                    }
                    _ => {
                    }
                }
                TypeChecker_require_unsafe(self, "casting " + src_text + " to str");
            }
        }
        _ => {
        }
    }
}

/// Whether `x as str` with x of type `src` makes a str out of a raw word: a
/// number (an integer of any width, a float: a literal is typed by its size,
/// so `5 as str` has src i8) or a raw pointer. A str (or a borrowed one), an
/// unknown type and an error type do not.
fn tc_cast_makes_raw_str(self: &TypeChecker, src: Type) -> bool {
    if TypeChecker_is_integer(self, src) || TypeChecker_is_float(self, src) {
        return true;
    }
    match src {
        Type::RawPtr(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// `x as T` between types that have no conversion (reference §4.6). What the
/// cast makes from a word is then read without `unsafe` as what it is not: a
/// reference (`128 as &i64`, `p as &T`: `*r` of a reference is not checked),
/// a str (TypeChecker_check_str_cast), or a struct, an enum, a collection, a
/// tuple, an array or a tensor (`7 as Vec<i64>`: a push writes through the
/// word). Each needs `unsafe`, as making a pointer from an integer without a
/// cast does (types_compatible). What stays allowed in safe code: the numeric
/// conversions; str, a reference or a pointer to an integer; a reference to a
/// raw pointer; an integer to a raw pointer (it cannot be read or written
/// without `unsafe`); any value to `dyn`; a struct, enum, collection, tuple,
/// array or function to an integer (its handle); a cast to the value's own
/// type. What is not known yet (inferred, a type parameter, `!`) is not
/// checked: the compiler's own modules and the trusted base are not either
/// (tc_module_needs_unsafe).
fn TypeChecker_check_cast(self: &mut TypeChecker, e: Expr, src: Type, dst: Type) {
    if !tc_module_needs_unsafe(self.current_module) || self.unsafe_depth > 0 {
        return;
    }
    if tc_cast_type_unknown(src) || tc_cast_type_unknown(dst) {
        return;
    }
    // A literal is typed by its size (`5` is an i8): the message says what
    // the value is
    var src_text: str = type_to_str(src);
    match e {
        Expr::IntLit(_) => {
            src_text = "an integer";
        }
        _ => {
        }
    }
    // A reference made from anything that is not one
    match dst {
        Type::Ref(_, _) => {
            match src {
                Type::Ref(_, _) => {
                    return;
                }
                _ => {
                    TypeChecker_require_unsafe(self, "casting " + src_text + " to " + type_to_str(dst));
                    return;
                }
            }
        }
        _ => {
        }
    }
    // A struct, enum, collection, tuple, array or tensor made from a value
    // that is not already one of its own type
    if tc_cast_dst_is_value(self, dst) && !TypeChecker_types_compatible(self, dst, src) {
        TypeChecker_require_unsafe(self, "casting " + src_text + " to " + type_to_str(dst));
    }
}

/// A type the cast rule cannot reason about yet.
fn tc_cast_type_unknown(t: Type) -> bool {
    match t {
        Type::Infer => {
            return true;
        }
        Type::Never => {
            return true;
        }
        Type::Void => {
            return true;
        }
        Type::Assoc(_, _, _, _) => {
            return true;
        }
        Type::Dyn(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// What is held as a value of its own (not a word that converts): a struct, an
/// enum, a generic instance (Vec, HashMap, Box, Rc, Arc, Option, Result, a
/// user's), a tuple, an array, a shaped tensor. A type parameter is not: a
/// cast to one says nothing until the function is instantiated.
fn tc_cast_dst_is_value(self: &TypeChecker, t: Type) -> bool {
    match t {
        Type::Generic(_, _) => {
            return true;
        }
        Type::Tuple(_) => {
            return true;
        }
        Type::Array(_, _) => {
            return true;
        }
        Type::ArrayConst(_, _) => {
            return true;
        }
        Type::ShapedTensor(_, _) => {
            return true;
        }
        Type::Named(n) => {
            if tc_str_vec_contains(self.current_type_params, n) {
                return false;
            }
            return TypeChecker_shares_repr(self, t);
        }
        _ => {
        }
    }
    return false;
}

/// Release M10: a call of an @unsafe function (`key` as tc_note_unsafe_fns
/// records it, `shown` as the message names it) needs an `unsafe` block or
/// an @unsafe caller, in the code raw memory does (TypeChecker_require_unsafe).
fn TypeChecker_require_unsafe_call(self: &mut TypeChecker, key: str, shown: str) {
    if self.unsafe_depth == 0 && tc_is_unsafe_fn(key) {
        TypeChecker_require_unsafe(self, "calling the @unsafe function " + shown + "()");
    }
}

/// The bits of an integer type, 0 for anything else.
fn tc_int_bits(ty: Type) -> i64 {
    match ty {
        Type::I8 => {
            return 8;
        }
        Type::I16 => {
            return 16;
        }
        Type::I32 => {
            return 32;
        }
        Type::I64 => {
            return 64;
        }
        Type::I128 => {
            return 128;
        }
        Type::U8 => {
            return 8;
        }
        Type::U16 => {
            return 16;
        }
        Type::U32 => {
            return 32;
        }
        Type::U64 => {
            return 64;
        }
        Type::U128 => {
            return 128;
        }
        _ => {
            return 0;
        }
    }
    return 0;
}

fn tc_int_signed(ty: Type) -> bool {
    match ty {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::I64 => {
            return true;
        }
        Type::I128 => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn tc_is_constant_expr(expr: Expr) -> bool {
    match expr {
        Expr::IntLit(_) => {
            return true;
        }
        Expr::Unary(_, e) => {
            return tc_is_constant_expr(box_expr_unbox(e));
        }
        Expr::Binary(_, l, r) => {
            return tc_is_constant_expr(box_expr_unbox(l)) && tc_is_constant_expr(box_expr_unbox(r));
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn tc_literal_fits(v: i64, negative: bool, bits: i64, signed: bool) -> bool {
    if negative {
        return signed && (bits >= 64 || v <= (1 << (bits - 1)));
    }
    if bits >= 64 {
        return true;
    }
    if signed {
        return v >= 0 && v < (1 << (bits - 1));
    }
    return v >= 0 && v < (1 << bits);
}

/// The literal a comptime expression computes (comptime_eval.fd evaluate;
/// consts resolve there), or the expression back when it does not fold —
/// the substitution pass reports evaluation errors, the checker only folds.
fn tc_comptime_fold(e: Expr) -> Expr {
    if g_tc_program_copy.len() == 0 {
        return e;
    }
    var prog: Program = g_tc_program_copy.get(0);
    match evaluate(& e, & prog) {
        ResultExpr::Ok(v) => {
            match v {
                Expr::IntLit(_) => {
                    return v;
                }
                _ => {
                }
            }
        }
        ResultExpr::Err(_) => {
        }
    }
    return e;
}

/// src/typechecker.rs check_value_fits: a value given to an integer type
/// must fit it.
/// Whether an `Rc<T>` or an `Arc<T>` can hold a `T` today: a number or a
/// bool, as one word (lower.fd Lowerer_lower_rc_new). A type not known yet
/// (inferred, a type parameter, `!`) is not decided here.
fn TypeChecker_rc_holds(self: &TypeChecker, t: Type) -> bool {
    if tc_int_bits(t) > 0 {
        return true;
    }
    match t {
        Type::F32 => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        Type::Infer => {
            return true;
        }
        Type::Never => {
            return true;
        }
        Type::Assoc(_, _, _, _) => {
            return true;
        }
        Type::Dyn(_) => {
            return true;
        }
        Type::Named(n) => {
            return tc_str_vec_contains(self.current_type_params, n);
        }
        _ => {
        }
    }
    return false;
}

/// `x = e` (reference §3.4): e has x's type, as a declaration's initialiser
/// has the declared type. Before, an assignment checked only that an integer
/// literal fit, so `var s: str = "a"; s = 42;` was accepted and failed at run
/// time. The runtime layer keeps its handle pairs, as a declaration does.
fn TypeChecker_check_assign_type(self: &mut TypeChecker, declared: Type, actual: Type, name: str, line: i64) {
    if TypeChecker_types_compatible(self, declared, actual) {
        return;
    }
    if TypeChecker_is_integer(self, declared) && TypeChecker_is_integer(self, actual) {
        return;
    }
    // `x = b` with b a Box<T> and x a T that is held as the address of its
    // data (a struct or an enum): the Box is that address, as `*b` reads it
    match actual {
        Type::Generic(ban, bargs) => {
            if ban == "Box" && bargs.len() == 1 && TypeChecker_shares_repr(self, TypeChecker_resolve_type(self, declared)) && TypeChecker_types_compatible(self, declared, bargs.get(0)) {
                return;
            }
        }
        _ => {
        }
    }
    if is_runtime_layer(self.current_module) && is_handle_int_pair(declared, actual) {
        return;
    }
    self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign " + type_to_str(actual) + " to variable '" + name + "' of type " + type_to_str(declared) + "." + "\n    Expected: " + type_to_str(declared) + "\n    Found:    " + type_to_str(actual) + "\n    Fix: change the type annotation or the expression.");
}

fn TypeChecker_check_value_fits(self: &mut TypeChecker, declared0: Type, actual0: Type, expr: Expr, line: i64) {
    var declared: Type = TypeChecker_resolve_type(self, declared0);
    var bits: i64 = tc_int_bits(declared);
    if bits == 0 {
        return;
    }
    var signed: bool = tc_int_signed(declared);
    var checked: bool = false;
    var fits: bool = true;
    var ct_fold_val: i64 = 0;
    var ct_fold_named: bool = false;
    match expr {
        Expr::IntLit(v) => {
            checked = true;
            fits = tc_literal_fits(v, false, bits, signed);
        }
        // §4.11: what comptime computes is a literal at run time — fold it
        // here, so its value is range-checked and named in the error
        Expr::Comptime(ct_inner) => {
            var ct_folded: Expr = tc_comptime_fold(box_expr_unbox(ct_inner));
            match ct_folded {
                Expr::IntLit(ct_v) => {
                    checked = true;
                    ct_fold_val = ct_v;
                    ct_fold_named = true;
                    if ct_v < 0 {
                        fits = tc_literal_fits(0 - ct_v, true, bits, signed);
                    } else {
                        fits = tc_literal_fits(ct_v, false, bits, signed);
                    }
                }
                _ => {
                }
            }
        }
        Expr::Unary(op, e) => {
            match op {
                UnaryOp::Neg => {
                    match box_expr_unbox(e) {
                        Expr::IntLit(v) => {
                            checked = true;
                            fits = tc_literal_fits(v, true, bits, signed);
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    if checked {
        if !fits {
            if ct_fold_named {
                self.errors.push("Type error (line " + int_to_str(line) + "): the comptime value " + int_to_str(ct_fold_val) + " does not fit in " + type_to_str(declared) + ".");
            } else {
                self.errors.push("Type error (line " + int_to_str(line) + "): the literal does not fit in " + type_to_str(declared) + ".");
            }
        }
        return;
    }
    if self.current_module != "main" || tc_is_constant_expr(expr) {
        return;
    }
    // `x & 0xFF`: the literal takes the other operand's type
    match expr {
        Expr::Binary(_, l, r) => {
            if tc_is_constant_expr(box_expr_unbox(l)) || tc_is_constant_expr(box_expr_unbox(r)) {
                return;
            }
        }
        _ => {
        }
    }
    var actual: Type = TypeChecker_resolve_type(self, actual0);
    if tc_int_bits(actual) > bits || TypeChecker_is_float(self, actual) {
        self.errors.push("Type error (line " + int_to_str(line) + "): a " + type_to_str(actual) + " may not fit in " + type_to_str(declared) + ".\n    Fix: convert it with `as " + type_to_str(declared) + "`.");
    }
}

/// LG4: whether a value of type `t` can never stand for a `dyn Trait` (or
/// be read from one): a user struct or enum (a reference to one included),
/// a string, a bool or a number. Type parameters, `dyn` types and types not
/// yet inferred are not decided here (they stay compatible).
fn TypeChecker_dyn_incompatible(self: &TypeChecker, t: Type) -> bool {
    match t {
        Type::Named(n) => {
            if tc_str_vec_contains(self.current_type_params, n) {
                return false;
            }
            return TypeChecker_shares_repr(self, t);
        }
        Type::Generic(_, _) => {
            return TypeChecker_shares_repr(self, t);
        }
        Type::Ref(inner, _) => {
            return TypeChecker_dyn_incompatible(self, TypeChecker_resolve_type(self, box_type_unbox(inner)));
        }
        Type::Str => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        Type::Infer => {
            return false;
        }
        _ => {
        }
    }
    return TypeChecker_is_numeric(self, t);
}

/// L8A: whether `a` and `b` are the same generic type with two different
/// numbers for a const parameter (`__const_3` against `__const_2`), at any
/// depth of type arguments.
fn tc_const_args_differ(a: Type, b: Type) -> bool {
    match a {
        Type::Generic(an, aargs) => {
            match b {
                Type::Generic(bn, bargs) => {
                    if an != bn || aargs.len() != bargs.len() {
                        return false;
                    }
                    var i: i64 = 0;
                    while i < aargs.len() {
                        match aargs.get(i) {
                            Type::Named(x) => {
                                match bargs.get(i) {
                                    Type::Named(y) => {
                                        if x != y && Type_const_value(Type::Named(x)) >= 0 && Type_const_value(Type::Named(y)) >= 0 {
                                            return true;
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                        if tc_const_args_differ(aargs.get(i), bargs.get(i)) {
                            return true;
                        }
                        i = i + 1;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// Two instances of one of Vec, HashMap, Rc and Arc (reference §3.3): the same
/// type when each pair of type arguments is (by types_compatible). A side that
/// names no arguments is a type that does not name them (`Vec`), and
/// `HashMap<str, i64>` is what `HashMap::new()` is typed where no declared type
/// says otherwise: each stands for any instance of its type. Two other
/// instances with different arguments are different types. Before, any two
/// instances were compatible, so a `Vec<str>` passed as a `Vec<i64>`
/// type-checked and its words were read as integers.
fn tc_collection_instances_compatible(self: &TypeChecker, name: str, a: Vec<Type>, b: Vec<Type>) -> bool {
    if a.len() == 0 || b.len() == 0 {
        return true;
    }
    if name == "HashMap" && b.len() == 2 && tc_is_default_hashmap_args(b) {
        return true;
    }
    if a.len() != b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < a.len() {
        if !TypeChecker_types_compatible(self, a.get(i), b.get(i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// `<str, i64>`: the type arguments of `HashMap::new()` with no declared type.
fn tc_is_default_hashmap_args(args: Vec<Type>) -> bool {
    return type_eq(args.get(0), Type::Str) && type_eq(args.get(1), Type::I64);
}

pub fn TypeChecker_types_compatible(self: &TypeChecker, declared: Type, actual: Type) -> bool {
    var decl: Type = TypeChecker_resolve_type(self, declared);
    var act: Type = TypeChecker_resolve_type(self, actual);
    if type_eq(decl, act) {
        return true;
    }
    // L8A: Matrix<i64, 3> is not a Matrix<i64, 2>
    if tc_const_args_differ(decl, act) {
        return false;
    }
    if type_eq(act, Type::Never) {
        return true;
    }
    if type_eq(decl, Type::Infer) || type_eq(act, Type::Infer) {
        return true;
    }
    // Associated types are compatible with anything
    match decl {
        Type::Assoc(_, _, _, _) => {
            return true;
        }
        _ => {
        }
    }
    match act {
        Type::Assoc(_, _, _, _) => {
            return true;
        }
        _ => {
        }
    }
    // Trait objects (LG4). A `dyn T` value exists only where `v as dyn T`
    // made it (the lowering emits MakeDyn at that cast and nowhere else), so
    // a struct, enum, string, bool or number given where a `dyn T` is wanted
    // -- or a `dyn T` where one of those is wanted -- would be read as the
    // wrong representation: an error. Another `dyn`, a type parameter and
    // anything not yet known stay compatible, as before.
    match decl {
        Type::Dyn(_) => {
            return !TypeChecker_dyn_incompatible(self, act);
        }
        _ => {
        }
    }
    match act {
        Type::Dyn(_) => {
            return !TypeChecker_dyn_incompatible(self, decl);
        }
        _ => {
        }
    }
    // Type parameters are compatible with anything
    match decl {
        Type::Named(name) => {
            if tc_str_vec_contains(self.current_type_params, name) {
                return true;
            }
        }
        _ => {
        }
    }
    match act {
        Type::Named(name) => {
            if tc_str_vec_contains(self.current_type_params, name) {
                return true;
            }
        }
        _ => {
        }
    }
    // Generic enum/struct: Named("Option") compatible with Generic("Option", ...)
    match decl {
        Type::Named(decl_name) => {
            match act {
                Type::Generic(gen_name, _) => {
                    if decl_name == gen_name {
                        return true;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    match decl {
        Type::Generic(gen_name, _) => {
            match act {
                Type::Named(decl_name) => {
                    if gen_name == decl_name {
                        return true;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    // Two instances of Vec, HashMap, Rc or Arc are the same type only when
    // their type arguments are: a `Vec<str>` read as a `Vec<i64>` printed
    // addresses and freed words as strings. What names no arguments stands
    // for any instance (tc_collection_instances_compatible).
    match decl {
        Type::Generic(dn, dargs) => {
            match act {
                Type::Generic(an, aargs) => {
                    if (dn == "Vec" && an == "Vec") || (dn == "HashMap" && an == "HashMap") || (dn == "Rc" && an == "Rc") || (dn == "Arc" && an == "Arc") {
                        return tc_collection_instances_compatible(self, dn, dargs, aargs);
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    // ArrayConst compatible with any array
    match decl {
        Type::ArrayConst(_, _) => {
            return true;
        }
        _ => {
        }
    }
    match act {
        Type::ArrayConst(_, _) => {
            return true;
        }
        _ => {
        }
    }
    // str <-> i64 (str is a pointer internally)
    // str is a pointer, but only the runtime layer and the self-hosted compiler
    // treat it as an integer
    if (is_runtime_layer(self.current_module) || str_starts_with(self.current_module, "compiler")) && ((type_eq(decl, Type::I64) && type_eq(act, Type::Str)) || (type_eq(decl, Type::Str) && type_eq(act, Type::I64))) {
        return true;
    }
    // Implicit widening
    if can_implicitly_widen(act, decl) {
        return true;
    }
    // Tuple element-wise compatibility
    match decl {
        Type::Tuple(decl_elems) => {
            match act {
                Type::Tuple(actual_elems) => {
                    if decl_elems.len() != actual_elems.len() {
                        return false;
                    }
                    var i: i64 = 0;
                    while i < decl_elems.len() {
                        if !TypeChecker_types_compatible(self, decl_elems.get(i), actual_elems.get(i)) {
                            return false;
                        }
                        i = i + 1;
                    }
                    return true;
                }
                _ => {
                    return false;
                }
            }
            return false;
        }
        _ => {
        }
    }
    // Raw pointers compatible with each other
    match decl {
        Type::RawPtr(d_inner, d_mut) => {
            match act {
                Type::RawPtr(a_inner, a_mut) => {
                    if d_mut == a_mut {
                        return TypeChecker_types_compatible(self, box_type_unbox(d_inner), box_type_unbox(a_inner));
                    }
                    return false;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    // i64 <-> *mut T / *const T (pointers are i64 inside). Making a pointer
    // from an integer is for `unsafe` code in the program itself (and in
    // the modules it imports from outside the stdlib, release M2).
    // BG80: an address is an integer of 64 bits: a float is none (in either
    // direction), and a narrower integer would cut the address (an integer
    // literal is typed by its size, so any integer still becomes a pointer).
    // The runtime layer and the compiler's own modules keep the old rule.
    val bg80_words: bool = is_runtime_layer(self.current_module) || str_starts_with(self.current_module, "compiler");
    match decl {
        Type::RawPtr(_, _) => {
            if TypeChecker_is_numeric(self, act) {
                if !bg80_words && TypeChecker_is_float(self, act) {
                    return false;
                }
                return !tc_module_needs_unsafe(self.current_module) || self.unsafe_depth > 0;
            }
        }
        _ => {
        }
    }
    match act {
        Type::RawPtr(_, _) => {
            if TypeChecker_is_numeric(self, decl) {
                if !bg80_words && (TypeChecker_is_float(self, decl) || (tc_int_bits(decl) > 0 && tc_int_bits(decl) < 64)) {
                    return false;
                }
                return true;
            }
        }
        _ => {
        }
    }
    // &T -> *mut T / *const T
    match decl {
        Type::RawPtr(d_inner, _) => {
            match act {
                Type::Ref(a_inner, _) => {
                    return TypeChecker_types_compatible(self, box_type_unbox(d_inner), box_type_unbox(a_inner));
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    // Numbers: integers mix (narrowing a value is checked where it is
    // assigned), an integer becomes a float, but a float never silently
    // becomes an integer (proposal 0002: `as` says so)
    if TypeChecker_is_float(self, act) && !TypeChecker_is_float(self, decl) && !type_eq(decl, Type::Infer) {
        return false;
    }
    if TypeChecker_is_numeric(self, decl) && TypeChecker_is_numeric(self, act) {
        return true;
    }
    return false;
}

// --- CE9: an instantiation's error at the call that chose the types -------
//
// A generic body is checked once, with its type parameters abstract. What
// it does to a T that no bound describes, reading a field (`v.x` with
// v: T), holds only for some types: each call that picks T is checked
// against it, and the error names that call's line and the type it chose.
// Before, the instantiation read a field its type does not have
// (`first_field(7)` gave 0). Recorded while the bodies are checked and
// matched once all are, since a call can come before the callee's body.
// The error's place is the call (the user's line); where the body needs
// the field follows as "note: at line N, in 'f': ..." lines, the module
// named for a body of another module ("at module 'm', line N"), which
// compiler.fd enrich_note_locations turns into "<file>:N".

/// What a generic free function's body needs of a type parameter: the
/// function, the type parameter, the field, and how the body needs it (the
/// "\n    note: at ..." lines of the error, innermost last).
var g_tc_req_fns: Vec<str> = Vec::new();
var g_tc_req_tps: Vec<str> = Vec::new();
var g_tc_req_fields: Vec<str> = Vec::new();
var g_tc_req_how: Vec<str> = Vec::new();
/// Each call of a generic function: the callee; the caller, when it is a
/// generic free function itself ("" otherwise), and its type parameters;
/// the type parameters the call binds and their types; its line, the
/// "(line N, in 'f')" of its error, and the module to name in it ("" for
/// the program's own, TypeChecker_ce9_module).
var g_tc_gc_callees: Vec<str> = Vec::new();
var g_tc_gc_callers: Vec<str> = Vec::new();
var g_tc_gc_caller_tps: Vec<Vec<str>> = Vec::new();
var g_tc_gc_names: Vec<Vec<str>> = Vec::new();
var g_tc_gc_types: Vec<Vec<Type>> = Vec::new();
var g_tc_gc_lines: Vec<i64> = Vec::new();
var g_tc_gc_where: Vec<str> = Vec::new();
var g_tc_gc_mods: Vec<str> = Vec::new();

fn tc_ce9_reset() {
    g_tc_req_fns = Vec::new();
    g_tc_req_tps = Vec::new();
    g_tc_req_fields = Vec::new();
    g_tc_req_how = Vec::new();
    g_tc_gc_callees = Vec::new();
    g_tc_gc_callers = Vec::new();
    g_tc_gc_caller_tps = Vec::new();
    g_tc_gc_names = Vec::new();
    g_tc_gc_types = Vec::new();
    g_tc_gc_lines = Vec::new();
    g_tc_gc_where = Vec::new();
    g_tc_gc_mods = Vec::new();
}

/// The module a CE9 location names: the one of the body being checked when
/// it is not the program's own (as tc_tag_module_errors names it), else "".
fn TypeChecker_ce9_module(self: &mut TypeChecker) -> str {
    var fname: str = "";
    match self.current_func_name {
        OptString::Some(cf) => {
            fname = cf;
        }
        OptString::None => {
        }
    }
    var own_key: str = fname;
    match self.current_self_type {
        OptString::Some(st) => {
            own_key = st + "_" + fname;
        }
        OptString::None => {
        }
    }
    if str_len(self.current_module) > 0 && self.current_module != "main" && !HashMap_contains(self.last_fn_names, own_key) {
        return self.current_module;
    }
    return "";
}

/// "line N", or "module 'm', line N" for a line of another module.
fn tc_ce9_loc(module: str, line: i64) -> str {
    if str_len(module) > 0 {
        return "module '" + module + "', line " + int_to_str(line);
    }
    return "line " + int_to_str(line);
}

/// Record that `f` needs a field `field` of its type parameter `tp`; false
/// when that was already recorded.
fn tc_ce9_add_req(f: str, tp: str, field: str, how: str) -> bool {
    var i: i64 = 0;
    while i < g_tc_req_fns.len() {
        if g_tc_req_fns.get(i) == f && g_tc_req_tps.get(i) == tp && g_tc_req_fields.get(i) == field {
            return false;
        }
        i = i + 1;
    }
    g_tc_req_fns.push(f);
    g_tc_req_tps.push(tp);
    g_tc_req_fields.push(field);
    g_tc_req_how.push(how);
    return true;
}

/// The name of the function being checked when it is a free function with
/// type parameters, else "".
fn TypeChecker_ce9_generic_fn(self: &TypeChecker) -> str {
    match self.current_self_type {
        OptString::Some(_) => {
            return "";
        }
        OptString::None => {
        }
    }
    if self.current_type_params.len() == 0 {
        return "";
    }
    return self.checking_fn;
}

/// `x.field` where x is a value of type parameter `tp` of the generic free
/// function being checked.
fn TypeChecker_note_tp_field_read(self: &mut TypeChecker, tp: str, field: str) {
    var f: str = TypeChecker_ce9_generic_fn(self);
    if str_len(f) == 0 || !str_vec_contains(self.current_type_params, tp) {
        return;
    }
    tc_ce9_add_req(f, tp, field, "\n    note: at " + tc_ce9_loc(TypeChecker_ce9_module(self), self.current_line) + ", in '" + f + "': its body reads the field '" + field + "' of a " + tp);
}

/// A call of the generic `callee` binding `names` to `types`.
fn TypeChecker_ce9_note_call(self: &mut TypeChecker, callee: str, names: Vec<str>, types: Vec<Type>) {
    if names.len() == 0 {
        return;
    }
    var fname: str = "";
    match self.current_func_name {
        OptString::Some(cf) => {
            fname = cf;
        }
        OptString::None => {
        }
    }
    var call_mod: str = TypeChecker_ce9_module(self);
    var where_at: str = "(line " + int_to_str(self.current_line);
    // 2g.27: a call in an imported module names the module, as the errors
    // of that module's bodies do (tc_tag_module_errors)
    if str_len(call_mod) > 0 {
        where_at = "(module '" + call_mod + "', line " + int_to_str(self.current_line);
    }
    if str_len(fname) > 0 {
        where_at = where_at + ", in '" + fname + "'";
    }
    where_at = where_at + ")";
    g_tc_gc_callees.push(callee);
    g_tc_gc_callers.push(TypeChecker_ce9_generic_fn(self));
    g_tc_gc_caller_tps.push(self.current_type_params.clone());
    g_tc_gc_names.push(names);
    g_tc_gc_types.push(types);
    g_tc_gc_lines.push(self.current_line);
    g_tc_gc_where.push(where_at);
    g_tc_gc_mods.push(call_mod);
}

/// The type `names`/`types` give type parameter `tp` (Infer when none).
fn tc_ce9_chosen(names: Vec<str>, types: Vec<Type>, tp: str) -> Type {
    var k: i64 = 0;
    while k < names.len() && k < types.len() {
        if names.get(k) == tp {
            return types.get(k);
        }
        k = k + 1;
    }
    return Type::Infer;
}

/// `t` (through a reference or a Box) as a plain named type, else "".
fn tc_ce9_named(t: Type) -> str {
    var u: Type = unbox_ty(t);
    match t {
        Type::Ref(inner, _) => {
            u = unbox_ty(box_type_unbox(inner));
        }
        _ => {
        }
    }
    match u {
        Type::Named(n) => {
            return n;
        }
        _ => {
        }
    }
    return "";
}

/// Whether a value of type `t` certainly has no field `field`: a struct
/// without it, or a number, bool or string. Anything else (a type
/// parameter, a type this check does not know, a tuple) is let through.
fn TypeChecker_ce9_lacks_field(self: &TypeChecker, t: Type, field: str) -> bool {
    var u: Type = unbox_ty(t);
    match t {
        Type::Ref(inner, _) => {
            u = unbox_ty(box_type_unbox(inner));
        }
        _ => {
        }
    }
    var sname: str = "";
    match u {
        Type::Named(n) => {
            sname = n;
        }
        Type::Generic(gn, _) => {
            sname = gn;
        }
        _ => {
        }
    }
    if str_len(sname) > 0 {
        match TypeChecker_lookup_struct_cache(self, sname) {
            OptVecStructField::Some(fields) => {
                var fi: i64 = 0;
                while fi < fields.len() {
                    if fields.get(fi).name == field {
                        return false;
                    }
                    fi = fi + 1;
                }
                return true;
            }
            OptVecStructField::None => {
            }
        }
        return false;
    }
    return TypeChecker_is_numeric(self, u) || type_eq(u, Type::Bool) || tc_is_str(u);
}

/// Match every recorded generic call against what its callee needs; a
/// generic caller that passes its own type parameter on needs the same of
/// it (repeated until nothing changes). Run once all bodies are checked.
fn TypeChecker_ce9_check_calls(self: &mut TypeChecker) {
    if g_tc_req_fns.len() == 0 {
        return;
    }
    var changed: bool = true;
    var rounds: i64 = 0;
    while changed && rounds < 16 {
        changed = false;
        rounds = rounds + 1;
        var ci: i64 = 0;
        while ci < g_tc_gc_callees.len() {
            var caller: str = g_tc_gc_callers.get(ci);
            if str_len(caller) > 0 {
                var callee: str = g_tc_gc_callees.get(ci);
                var ri: i64 = 0;
                while ri < g_tc_req_fns.len() {
                    if g_tc_req_fns.get(ri) == callee {
                        var ctp: str = tc_ce9_named(tc_ce9_chosen(g_tc_gc_names.get(ci), g_tc_gc_types.get(ci), g_tc_req_tps.get(ri)));
                        if str_len(ctp) > 0 && str_vec_contains(g_tc_gc_caller_tps.get(ci), ctp) {
                            var fld: str = g_tc_req_fields.get(ri);
                            if tc_ce9_add_req(caller, ctp, fld, "\n    note: at " + tc_ce9_loc(g_tc_gc_mods.get(ci), g_tc_gc_lines.get(ci)) + ", in '" + caller + "': it passes its " + ctp + " to '" + callee + "' as " + g_tc_req_tps.get(ri) + g_tc_req_how.get(ri)) {
                                changed = true;
                            }
                        }
                    }
                    ri = ri + 1;
                }
            }
            ci = ci + 1;
        }
    }
    var cj: i64 = 0;
    while cj < g_tc_gc_callees.len() {
        var callee2: str = g_tc_gc_callees.get(cj);
        var rj: i64 = 0;
        while rj < g_tc_req_fns.len() {
            if g_tc_req_fns.get(rj) == callee2 {
                var tp: str = g_tc_req_tps.get(rj);
                var t: Type = tc_ce9_chosen(g_tc_gc_names.get(cj), g_tc_gc_types.get(cj), tp);
                var field: str = g_tc_req_fields.get(rj);
                if TypeChecker_ce9_lacks_field(self, t, field) {
                    var ts: str = type_to_str(t);
                    // the call that chose the type is the error's place;
                    // the body's lines that need the field are its notes
                    self.errors.push("Type error " + g_tc_gc_where.get(cj) + ": '" + callee2 + "' is called with " + tp + " = " + ts + ", but " + ts + " has no field '" + field + "', which the body of '" + callee2 + "' needs." + g_tc_req_how.get(rj) + "\n    Fix: pass a value whose type has a field '" + field + "', or change '" + callee2 + "' so that it does not need one.");
                }
            }
            rj = rj + 1;
        }
        cj = cj + 1;
    }
}

// --- L8H: specialization ---------------------------------------------------
// The specializations `name__spec<k>` the parser made (ast.fd
// spec_base_name), with their parameter and result types resolved. A call
// of `name` is typed against the general definition; here the definitions
// that take the instantiation's types are compared: two as specific as each
// other are an error, and the one chosen must return what the general one
// does for these types. Monomorphization makes the same choice (mono.fd
// instantiate).

var g_tc_specs: Vec<Func> = Vec::new();
var g_tc_spec_seen: i64 = 0;

fn TypeChecker_note_spec(self: &mut TypeChecker, func: Func) {
    if g_tc_spec_seen == 0 {
        g_tc_spec_seen = HashMap_new();
    }
    if HashMap_get(g_tc_spec_seen, func.name) != 0 {
        return;
    }
    HashMap_insert(g_tc_spec_seen, func.name, 1);
    var r: Func = Func_new(func.name, TypeChecker_resolve_type(self, func.ret_ty));
    r.type_params = func.type_params;
    var ps: Vec<Param> = Vec::new();
    var i: i64 = 0;
    while i < func.params.len() {
        ps.push(Param_new(func.params.get(i).name, TypeChecker_resolve_type(self, func.params.get(i).ty), false));
        i = i + 1;
    }
    r.params = ps;
    g_tc_specs.push(r);
}

/// `name(T1, T2)` for a message.
fn tc_spec_sig(name: str, f: Func) -> str {
    var s: str = name;
    if f.type_params.len() > 0 {
        s = s + "<" + str_join(f.type_params, ", ") + ">";
    }
    s = s + "(";
    var i: i64 = 0;
    while i < f.params.len() {
        if i > 0 {
            s = s + ", ";
        }
        s = s + type_to_str(f.params.get(i).ty);
        i = i + 1;
    }
    return s + ")";
}

fn TypeChecker_check_spec_call(self: &mut TypeChecker, callee: str, tps: Vec<str>, params: Vec<Type>, ret: Type, names: Vec<str>, types: Vec<Type>, in_fn: str) {
    var cands: Vec<Func> = Vec::new();
    var base: Func = Func_new(callee, ret);
    base.type_params = tps;
    var bps: Vec<Param> = Vec::new();
    var i: i64 = 0;
    while i < params.len() {
        bps.push(Param_new("p" + int_to_str(i), params.get(i), false));
        i = i + 1;
    }
    base.params = bps;
    cands.push(base);
    i = 0;
    while i < g_tc_specs.len() {
        if spec_base_name(g_tc_specs.get(i).name) == callee {
            cands.push(g_tc_specs.get(i));
        }
        i = i + 1;
    }
    if cands.len() < 2 {
        return;
    }
    // the instantiation's parameter types (none chosen yet inside a generic
    // body, where they still mention its type parameters)
    var args: Vec<Type> = Vec::new();
    i = 0;
    while i < params.len() {
        var pt: Type = tc_subst_type_params(params.get(i), names, types);
        if TypeChecker_type_contains_param(self, pt) || tc_mentions_any(pt, tps) {
            return;
        }
        args.push(pt);
        i = i + 1;
    }
    var tie: Vec<i64> = Vec::new();
    val chosen: i64 = spec_choose(cands, args, &mut tie);
    var arg_s: str = "";
    i = 0;
    while i < args.len() {
        if i > 0 {
            arg_s = arg_s + ", ";
        }
        arg_s = arg_s + type_to_str(args.get(i));
        i = i + 1;
    }
    if tie.len() > 0 && chosen >= 0 {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): the call of '" + callee + "' with (" + arg_s + ") is taken by two definitions, neither more specific than the other: " + tc_spec_sig(callee, cands.get(chosen)) + " and " + tc_spec_sig(callee, cands.get(tie.get(0))) + ".\n    Fix: add a definition of '" + callee + "' for exactly (" + arg_s + "), or make one of the two more specific.");
        return;
    }
    if chosen > 0 {
        var sf: Func = cands.get(chosen);
        var snames: Vec<str> = Vec::new();
        var stypes: Vec<Type> = Vec::new();
        var j: i64 = 0;
        while j < sf.params.len() && j < args.len() {
            if !spec_match(sf.params.get(j).ty, args.get(j), sf.type_params, &mut snames, &mut stypes) {
                return;
            }
            j = j + 1;
        }
        val want: str = type_to_str(tc_subst_type_params(ret, names, types));
        val got: str = type_to_str(tc_subst_type_params(sf.ret_ty, snames, stypes));
        if want != got {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): the specialization " + tc_spec_sig(callee, sf) + " of '" + callee + "' returns " + got + ", and the general definition returns " + want + " for (" + arg_s + ").\n    Fix: give the specialization the result type of the general definition.");
        }
    }
}

// L8H: methods of narrower impls (`impl Wrap<i64> { fn show(self) }` next
// to `impl<T> Wrap<T> { fn show(self) }`), renamed `show__spec<k>` with
// `self` typed as the narrower impl's type (parser.fd
// pd_impl_specializations): each with its impl's type parameters, its
// resolved self type (without a reference) and result type, and the struct.
// A call `w.show()` is typed against the generic impl's method; here the
// impls whose type takes the receiver's are compared, as for functions.
var g_tc_mspecs: Vec<Func> = Vec::new();
var g_tc_mspec_structs: Vec<str> = Vec::new();

fn TypeChecker_note_mspec(self: &mut TypeChecker, imp: ImplDef, m: Func) {
    var i: i64 = 0;
    while i < g_tc_mspecs.len() {
        if g_tc_mspec_structs.get(i) == imp.struct_name && g_tc_mspecs.get(i).name == m.name {
            return;
        }
        i = i + 1;
    }
    var st: Type = TypeChecker_resolve_type(self, m.params.get(0).ty);
    match st {
        Type::Ref(inner, _) => {
            st = box_type_unbox(inner);
        }
        _ => {
        }
    }
    var r: Func = Func_new(m.name, TypeChecker_resolve_type(self, m.ret_ty));
    r.type_params = imp.type_params;
    var ps: Vec<Param> = Vec::new();
    ps.push(Param_new("self", st, false));
    r.params = ps;
    g_tc_mspecs.push(r);
    g_tc_mspec_structs.push(imp.struct_name);
}

/// `impl<A> Pair<A, i64>` for a message.
fn tc_mspec_sig(f: Func) -> str {
    var s: str = "impl";
    if f.type_params.len() > 0 {
        s = s + "<" + str_join(f.type_params, ", ") + ">";
    }
    if f.params.len() > 0 {
        s = s + " " + type_to_str(f.params.get(0).ty);
    }
    return s;
}

/// The call of method `method` on a `struct_name<recv_args>`, typed against
/// the generic impl's method (impl parameters `gtps`, declared result
/// `decl_ret`, `ret` for this receiver): two impls with the method that
/// take the receiver's type, neither more specific than the other, are an
/// error, and the one chosen must return `ret`.
fn TypeChecker_check_mspec_call(self: &mut TypeChecker, struct_name: str, method: str, gtps: Vec<str>, recv_args: Vec<Type>, decl_ret: Type, ret: Type) {
    if gtps.len() == 0 || recv_args.len() != gtps.len() || spec_base_name(method) != "" {
        return;
    }
    // inside a generic body the receiver's type is decided per instantiation
    var i: i64 = 0;
    while i < recv_args.len() {
        if TypeChecker_type_contains_param(self, recv_args.get(i)) || tc_type_has_infer(recv_args.get(i)) {
            return;
        }
        i = i + 1;
    }
    var cands: Vec<Func> = Vec::new();
    var base: Func = Func_new(method, decl_ret);
    base.type_params = gtps;
    var gargs: Vec<Type> = Vec::new();
    i = 0;
    while i < gtps.len() {
        gargs.push(Type::Named(gtps.get(i)));
        i = i + 1;
    }
    var bps: Vec<Param> = Vec::new();
    bps.push(Param_new("self", Type::Generic(struct_name, gargs), false));
    base.params = bps;
    cands.push(base);
    i = 0;
    while i < g_tc_mspecs.len() {
        if g_tc_mspec_structs.get(i) == struct_name && spec_base_name(g_tc_mspecs.get(i).name) == method {
            cands.push(g_tc_mspecs.get(i));
        }
        i = i + 1;
    }
    if cands.len() < 2 {
        return;
    }
    var args: Vec<Type> = Vec::new();
    args.push(Type::Generic(struct_name, recv_args));
    var tie: Vec<i64> = Vec::new();
    val chosen: i64 = spec_choose(cands, args, &mut tie);
    val recv_s: str = type_to_str(args.get(0));
    var in_fn: str = "";
    if self.checking_fn != "" {
        in_fn = ", in '" + self.checking_fn + "'";
    }
    if tie.len() > 0 && chosen >= 0 {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): the call of method '" + method + "' on " + recv_s + " is taken by two impls, neither more specific than the other: " + tc_mspec_sig(cands.get(chosen)) + " and " + tc_mspec_sig(cands.get(tie.get(0))) + ".\n    Fix: add an `impl " + recv_s + "` with '" + method + "', or make one of the two more specific.");
        return;
    }
    if chosen > 0 {
        var sf: Func = cands.get(chosen);
        var snames: Vec<str> = Vec::new();
        var stypes: Vec<Type> = Vec::new();
        if !spec_match(sf.params.get(0).ty, args.get(0), sf.type_params, &mut snames, &mut stypes) {
            return;
        }
        val got: str = type_to_str(tc_subst_type_params(sf.ret_ty, snames, stypes));
        val want: str = type_to_str(ret);
        if got != want {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): the method '" + method + "' of " + tc_mspec_sig(sf) + " returns " + got + ", and the generic impl's returns " + want + " for " + recv_s + ".\n    Fix: give the specialization the result type of the generic impl's method.");
        }
    }
}

/// L8H: whether `imp` is a generic impl over the whole struct (`impl<T>
/// Wrap<T>`), not a narrower one (`impl<U> Wrap<Vec<U>>`, `impl<N: i64>
/// Matrix<i64, N>`): parser.fd pd_impl_specializations typed each `self` of
/// a narrower impl as that impl's type; a generic impl's `self` is the
/// struct over the impl's own parameters (pd_generic_self) or `Self`.
fn tc_impl_is_general(imp: ImplDef) -> bool {
    var i: i64 = 0;
    while i < imp.methods.len() {
        val m: Func = imp.methods.get(i);
        if m.params.len() > 0 && m.params.get(0).name == "self" {
            var st: Type = m.params.get(0).ty;
            match st {
                Type::Ref(inner, _) => {
                    st = box_type_unbox(inner);
                }
                _ => {
                }
            }
            match st {
                Type::Generic(gn, gargs) => {
                    if gn != imp.struct_name || gargs.len() != imp.type_params.len() {
                        return false;
                    }
                    var k: i64 = 0;
                    while k < gargs.len() {
                        match gargs.get(k) {
                            Type::Named(an) => {
                                if an != imp.type_params.get(k) {
                                    return false;
                                }
                            }
                            _ => {
                                return false;
                            }
                        }
                        k = k + 1;
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1;
    }
    return true;
}

/// The names in `t` that are type parameters (no struct, enum or number
/// given for a const parameter), each once, added to `out`.
fn TypeChecker_param_names_in(self: &TypeChecker, t: Type, out: &mut Vec<str>) {
    match t {
        Type::Named(n) => {
            if n != "Self" && TypeChecker_type_contains_param(self, t) && !str_vec_contains(out, n) {
                out.push(n);
            }
        }
        Type::Generic(_, gargs) => {
            var i: i64 = 0;
            while i < gargs.len() {
                TypeChecker_param_names_in(self, gargs.get(i), out);
                i = i + 1;
            }
        }
        Type::Ref(inner, _) => {
            TypeChecker_param_names_in(self, box_type_unbox(inner), out);
        }
        Type::Array(e, _) => {
            TypeChecker_param_names_in(self, box_type_unbox(e), out);
        }
        Type::Tuple(ts) => {
            var j: i64 = 0;
            while j < ts.len() {
                TypeChecker_param_names_in(self, ts.get(j), out);
                j = j + 1;
            }
        }
        _ => {
        }
    }
}

/// L8H: the call of `method` on a `gen_name<recv_args>` when the method is
/// one of a narrower impl (`impl Wrap<i64> { fn twice(self) }`, `impl<U>
/// Wrap<Vec<U>> { fn first(self) -> U }`, `impl<N: i64> Matrix<i64, N>`):
/// its `self` is the struct with other arguments than the generic impl's
/// parameters `gtps`. The receiver must have that type (a Wrap<bool> has no
/// `twice`), and the result type takes the impl's parameters from it.
/// False when the method is not one of those (or the receiver's type is
/// decided per instantiation); else true, with the result type pushed to
/// `out` (nothing when an error was reported).
fn TypeChecker_narrow_method_call(self: &mut TypeChecker, gen_name: str, method: str, info: MethodInfo, gtps: Vec<str>, recv_args: Vec<Type>, out: &mut Vec<Type>) -> bool {
    if !info.has_self || info.param_types.len() == 0 || spec_base_name(method) != "" {
        return false;
    }
    var st: Type = info.param_types.get(0);
    match st {
        Type::Ref(inner, _) => {
            st = box_type_unbox(inner);
        }
        _ => {
        }
    }
    var sargs: Vec<Type> = Vec::new();
    var is_struct_self: bool = false;
    match st {
        Type::Generic(sn, sa) => {
            if sn == gen_name {
                sargs = sa;
                is_struct_self = true;
            }
        }
        _ => {
        }
    }
    if !is_struct_self || sargs.len() != recv_args.len() {
        return false;
    }
    // the generic impl's own `self` (`Wrap<T>`)
    if sargs.len() == gtps.len() {
        var same: bool = true;
        var k: i64 = 0;
        while k < sargs.len() {
            match sargs.get(k) {
                Type::Named(an) => {
                    if an != gtps.get(k) {
                        same = false;
                    }
                }
                _ => {
                    same = false;
                }
            }
            k = k + 1;
        }
        if same {
            return false;
        }
    }
    // inside a generic body the receiver's type is decided per instantiation
    var i: i64 = 0;
    while i < recv_args.len() {
        if TypeChecker_type_contains_param(self, recv_args.get(i)) || tc_type_has_infer(recv_args.get(i)) || type_eq(recv_args.get(i), Type::Never) {
            return false;
        }
        i = i + 1;
    }
    // the narrower impl's parameters: the names in `self`'s arguments
    var tps: Vec<str> = Vec::new();
    i = 0;
    while i < sargs.len() {
        TypeChecker_param_names_in(self, sargs.get(i), &mut tps);
        i = i + 1;
    }
    var names: Vec<str> = Vec::new();
    var types: Vec<Type> = Vec::new();
    val recv: Type = Type::Generic(gen_name, recv_args);
    if !spec_match(st, recv, tps, &mut names, &mut types) {
        var in_fn: str = "";
        if self.checking_fn != "" {
            in_fn = ", in '" + self.checking_fn + "'";
        }
        var imp_s: str = "impl";
        if tps.len() > 0 {
            imp_s = imp_s + "<" + str_join(tps, ", ") + ">";
        }
        imp_s = imp_s + " " + type_to_str(st);
        self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): no method '" + method + "' on " + type_to_str(recv) + ": '" + method + "' is a method of `" + imp_s + "` only.\n    Fix: call it on a " + type_to_str(st) + ", or add '" + method + "' to the generic impl of " + gen_name + ".");
        return true;
    }
    val nres: Type = tc_subst_type_params(info.ret_ty, names, types);
    // L8H: `self` over the whole struct, of an impl whose parameters are not
    // the recorded ones (a generic trait impl, `impl<T> Show for Wrap<T>`):
    // the narrower impls that specialize its method (parser.fd
    // pd_trait_impl_specializations) are compared as for a generic impl's
    if g_tc_mspecs.len() > 0 && tps.len() == sargs.len() {
        var whole: bool = true;
        var wk: i64 = 0;
        while wk < sargs.len() {
            match sargs.get(wk) {
                Type::Named(wn) => {
                    if wn != tps.get(wk) {
                        whole = false;
                    }
                }
                _ => {
                    whole = false;
                }
            }
            wk = wk + 1;
        }
        if whole {
            TypeChecker_check_mspec_call(self, gen_name, method, tps, recv_args, info.ret_ty, nres);
        }
    }
    out.push(nres);
    return true;
}

/// Whether `t` names one of the type parameters `tps`.
fn tc_mentions_any(t: Type, tps: Vec<str>) -> bool {
    match t {
        Type::Named(n) => {
            return str_vec_contains(tps, n);
        }
        Type::Generic(_, gargs) => {
            var i: i64 = 0;
            while i < gargs.len() {
                if tc_mentions_any(gargs.get(i), tps) {
                    return true;
                }
                i = i + 1;
            }
        }
        Type::Ref(inner, _) => {
            return tc_mentions_any(box_type_unbox(inner), tps);
        }
        Type::Array(e, _) => {
            return tc_mentions_any(box_type_unbox(e), tps);
        }
        Type::Tuple(ts) => {
            var j: i64 = 0;
            while j < ts.len() {
                if tc_mentions_any(ts.get(j), tps) {
                    return true;
                }
                j = j + 1;
            }
        }
        _ => {
        }
    }
    return false;
}

// --- Generic calls (proposal 0002) ----------------------------------------

/// A call to a generic function, as src/typechecker.rs check_generic_call:
/// type arguments inferred from the arguments (and the expected type for one
/// only the result mentions), arguments and bounds checked, the call typed
/// with the instantiated return type.
fn TypeChecker_check_generic_call(self: &mut TypeChecker, callee: str, tps: Vec<str>, bounds: Vec<StrPair>, params: Vec<Type>, ret: Type, arg_types: Vec<Type>, hint: Type) -> Type {
    var names: Vec<str> = Vec::new();
    var types: Vec<Type> = Vec::new();
    var i: i64 = 0;
    while i < params.len() && i < arg_types.len() {
        tc_bind_type_params(params.get(i), arg_types.get(i), tps, &mut names, &mut types);
        i = i + 1;
    }
    if !type_eq(hint, Type::Never) && !type_eq(hint, Type::Infer) {
        tc_bind_type_params(ret, hint, tps, &mut names, &mut types);
    }
    var in_fn: str = "";
    match self.current_func_name {
        OptString::Some(fname) => {
            in_fn = ", in '" + fname + "'";
        }
        OptString::None => {
        }
    }
    // An argument of unknown type binds nothing: monomorphization infers from
    // the values; only a parameter no argument mentions is an error
    var unknown_arg: bool = false;
    i = 0;
    while i < arg_types.len() {
        if type_eq(arg_types.get(i), Type::Infer) || type_eq(arg_types.get(i), Type::Never) {
            unknown_arg = true;
        }
        i = i + 1;
    }
    i = 0;
    while i < tps.len() && !unknown_arg {
        if !str_vec_contains(names, tps.get(i)) {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): cannot infer the type parameter '" + tps.get(i) + "' of '" + callee + "': no argument gives it.\n    Fix: give the result a type, as in `val x: i64 = " + callee + "(...)`.");
            return Type::Never;
        }
        i = i + 1;
    }
    i = 0;
    while i < params.len() && i < arg_types.len() {
        var pt: Type = tc_subst_type_params(params.get(i), names, types);
        var a: Type = arg_types.get(i);
        if !TypeChecker_type_contains_param(self, pt) && !type_eq(a, Type::Infer) && !type_eq(a, Type::Never) && !TypeChecker_arg_compatible(self, pt, a) {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): function '" + callee + "' parameter " + int_to_str(i + 1) + " expects '" + type_to_str(pt) + "', got '" + type_to_str(a) + "'");
        }
        i = i + 1;
    }
    // L8H: which definition of the name an instantiation takes
    if g_tc_specs.len() > 0 && !unknown_arg {
        TypeChecker_check_spec_call(self, callee, tps, params, ret, names, types, in_fn);
    }
    var bi: i64 = 0;
    while bi < bounds.len() {
        var tp: str = bounds.get(bi).a;
        var tr: str = bounds.get(bi).b;
        bi = bi + 1;
        var k: i64 = 0;
        var found: bool = false;
        var bty: Type = Type::Infer;
        while k < names.len() {
            if names.get(k) == tp {
                bty = types.get(k);
                found = true;
            }
            k = k + 1;
        }
        if !found || !TypeChecker_is_trait_name(self, tr) || TypeChecker_satisfies_bound(self, bty, tr) {
            continue;
        }
        self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): " + type_to_str(bty) + " does not implement " + tr + " (required by " + tp + ": " + tr + " in '" + callee + "').\n    Fix: add `impl " + tr + " for " + type_to_str(bty) + " { ... }`, or pass a value whose type implements it.");
    }
    // CE9: what the body needs of the chosen types, checked once every body
    // has been (TypeChecker_ce9_check_calls)
    TypeChecker_ce9_note_call(self, callee, names, types);
    var r: Type = tc_subst_type_params(ret, names, types);
    if TypeChecker_type_contains_param(self, r) {
        return Type::Never;
    }
    return r;
}

fn tc_is_str(t: Type) -> bool {
    match t {
        Type::Str => {
            return true;
        }
        Type::Named(n) => {
            return n == "str";
        }
        _ => {
        }
    }
    return false;
}

/// `&str`: a borrowed string (release M11).
fn tc_is_borrowed_str(t: Type) -> bool {
    match t {
        Type::Ref(inner, is_mut) => {
            return !is_mut && tc_is_str(box_type_unbox(inner));
        }
        _ => {
        }
    }
    return false;
}

/// Calls that read a string and keep nothing of it, or return a new one:
/// a borrowed string may be passed to them as a str (release M11).
fn tc_borrow_safe_callee(callee: str) -> bool {
    if str_starts_with(callee, "p_") {
        return true;
    }
    return callee == "str_len" || callee == "str_find" || callee == "str_contains" || callee == "str_starts_with" || callee == "str_ends_with" || callee == "str_byte_at" || callee == "str_equal" || callee == "str_eq" || callee == "str_parse_int" || callee == "str_to_int" || callee == "str_hash" || callee == "str_clone" || callee == "str_compare" || callee == "str_count" || callee == "print" || callee == "println" || callee == "eprint" || callee == "eprintln";
}

/// A reference is read through where its value is wanted: the referenced type.
fn tc_read_through(t: Type) -> Type {
    match t {
        Type::Ref(inner, _) => {
            return box_type_unbox(inner);
        }
        _ => {
            return t;
        }
    }
    return t;
}

fn tc_is_struct(self: &TypeChecker, name: str) -> bool {
    match TypeChecker_lookup_struct_cache(self, name) {
        OptVecStructField::Some(_) => {
            return true;
        }
        OptVecStructField::None => {
            return false;
        }
    }
    return false;
}

/// Methods that change their receiver (Vec, HashMap, String).
fn tc_changing_method(m: str) -> bool {
    return m == "push" || m == "pop" || m == "set" || m == "insert" || m == "remove" || m == "clear" || m == "extend" || m == "truncate" || m == "reverse" || m == "sort" || m == "resize" || m == "swap" || m == "push_str" || m == "append" || m == "retain" || m == "dedup" || m == "fill" || m == "drain" || m == "sort_by" || m == "push_front" || m == "pop_front";
}

/// The variable a place expression is part of: `p` for `p`, `p.items`,
/// `p.items.get(i).name` or `p[i]` ("" for anything else).
fn tc_place_root(e: Expr) -> str {
    match e {
        Expr::Ident(n) => {
            return n;
        }
        Expr::FieldAccess(inner, _) => {
            return tc_place_root(box_expr_unbox(inner));
        }
        Expr::Index(arr, _) => {
            return tc_place_root(box_expr_unbox(arr));
        }
        Expr::MethodCall(recv, m, _) => {
            if m == "get" {
                return tc_place_root(box_expr_unbox(recv));
            }
            return "";
        }
        _ => {
            return "";
        }
    }
    return "";
}

fn TypeChecker_forget_value_param(self: &mut TypeChecker, name: str) {
    var i: i64 = 0;
    while i < self.value_param_names.len() {
        if self.value_param_names.get(i) == name {
            self.value_param_names.remove(i);
            self.value_param_types.remove(i);
            return;
        }
        i = i + 1;
    }
}

/// A by-value Vec/HashMap/struct parameter changed: an error, since the
/// caller would not see the change (as src/typechecker.rs).
fn TypeChecker_check_param_change(self: &mut TypeChecker, root: str) {
    var i: i64 = 0;
    while i < self.value_param_names.len() {
        if self.value_param_names.get(i) == root {
            var ty: Type = self.value_param_types.get(i);
            var in_fn: str = "";
            match self.current_func_name {
                OptString::Some(fname) => {
                    in_fn = " of '" + fname + "'";
                }
                OptString::None => {
                }
            }
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): '" + root + "' is a by-value parameter" + in_fn + " and cannot be changed: the caller would not see the change.\n    Fix: take `" + root + ": &mut " + type_to_str(ty) + "` and pass `&mut ...`, or change a copy: `var " + root + " = " + root + ";`.");
            // one error per parameter
            TypeChecker_forget_value_param(self, root);
            return;
        }
        i = i + 1;
    }
}

/// OW1: the text of a place for a message: `p.kids` for `p.kids`, the
/// root's name for anything else (`p[i]`, `p.kids.get(i)`).
fn tc_place_text(e: Expr) -> str {
    match e {
        Expr::Ident(n) => {
            return n;
        }
        Expr::FieldAccess(inner, f) => {
            var base: str = tc_place_text(box_expr_unbox(inner));
            if str_len(base) == 0 {
                return "";
            }
            return base + "." + f;
        }
        _ => {
            return tc_place_root(e);
        }
    }
    return "";
}

/// OW1 (reference §8.4): `place` is changed through `root`. A `&T` root
/// (a parameter or a local) is a shared borrow: only `&mut` may change
/// what it points to (a write through `&T` would change a value another
/// owner shares without copying it).
fn TypeChecker_check_shared_change(self: &mut TypeChecker, root: str, place: str) {
    if str_len(root) == 0 {
        return;
    }
    match TypeChecker_lookup(self, root) {
        OptType::Some(rt) => {
            match rt {
                Type::Ref(rin, is_mut) => {
                    if !is_mut {
                        var tn: str = type_to_str(box_type_unbox(rin));
                        var what: str = place;
                        if str_len(what) == 0 {
                            what = root;
                        }
                        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): cannot change '" + what + "' through a shared reference '" + root + ": &" + tn + "' (take '&mut " + tn + "')");
                    }
                }
                _ => {
                }
            }
        }
        OptType::None => {
        }
    }
}

/// Whether `receiver.method(..)` calls a user method taking `self: &mut T`.
fn TypeChecker_method_takes_mut_self(self: &TypeChecker, receiver: Expr, method: str) -> bool {
    var root: str = tc_place_root(receiver);
    if str_len(root) == 0 {
        return false;
    }
    var i: i64 = 0;
    while i < self.value_param_names.len() {
        if self.value_param_names.get(i) == root {
            match TypeChecker_resolve_type(self, self.value_param_types.get(i)) {
                Type::Named(sn) => {
                    var mei: i64 = TypeChecker_method_find_ro(self, sn, method);
                    if mei >= 0 {
                        var mi: i64 = TypeChecker_methods_at_ro(self, sn);
                        var mm: Vec<MethodMapEntry> = self.methods.get(mi).val;
                        if mm.get(mei).val.has_self && mm.get(mei).val.param_types.len() > 0 {
                            match mm.get(mei).val.param_types.get(0) {
                                Type::Ref(_, is_mut) => {
                                    return is_mut;
                                }
                                _ => {
                                    return false;
                                }
                            }
                        }
                    }
                }
                _ => {
                }
            }
            return false;
        }
        i = i + 1;
    }
    return false;
}

/// The type parameters of struct `name` (`struct Pair<A, B>`), or none.
fn TypeChecker_struct_type_params(self: &TypeChecker, name: str) -> Vec<str> {
    var i: i64 = 0;
    while i < self.struct_tp_names.len() {
        if self.struct_tp_names.get(i) == name {
            return self.struct_tp_lists.get(i);
        }
        i = i + 1;
    }
    return Vec::new();
}

/// The type a value gives a type parameter it is bound to: an integer or
/// float literal is i64 or f64 (a literal is typed by the smallest type
/// that holds it).
fn tc_bind_type(e: Expr, t: Type) -> Type {
    match e {
        Expr::IntLit(_) => {
            return Type::I64;
        }
        Expr::FloatLit(_) => {
            return Type::F64;
        }
        Expr::Unary(_, inner) => {
            return tc_bind_type(box_expr_unbox(inner), t);
        }
        _ => {
        }
    }
    return t;
}

fn tc_type_has_infer(t: Type) -> bool {
    match t {
        Type::Infer => {
            return true;
        }
        Type::Generic(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                if tc_type_has_infer(args.get(i)) {
                    return true;
                }
                i = i + 1;
            }
        }
        Type::Ref(inner, _) => {
            return tc_type_has_infer(box_type_unbox(inner));
        }
        Type::Array(inner, _) => {
            return tc_type_has_infer(box_type_unbox(inner));
        }
        _ => {
        }
    }
    return false;
}

fn TypeChecker_impl_type_params(self: &TypeChecker, name: str) -> Vec<str> {
    var i: i64 = 0;
    while i < self.impl_tp_names.len() {
        if self.impl_tp_names.get(i) == name {
            return self.impl_tp_lists.get(i);
        }
        i = i + 1;
    }
    return Vec::new();
}

fn TypeChecker_is_trait_name(self: &TypeChecker, name: str) -> bool {
    var i: i64 = 0;
    while i < self.traits.len() {
        if self.traits.get(i).key == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Whether `ty` implements `tr`: an impl, or a type parameter of the current
/// function bound by it.
fn TypeChecker_satisfies_bound(self: &TypeChecker, ty: Type, tr: str) -> bool {
    var name: str = type_to_str(ty);
    match ty {
        Type::Named(n) => {
            name = n;
        }
        Type::Generic(gn, _) => {
            name = gn;
        }
        Type::Infer => {
            return true;
        }
        Type::Never => {
            return true;
        }
        _ => {
        }
    }
    if str_vec_contains(self.impl_pairs, tr + ":" + name) {
        return true;
    }
    var i: i64 = 0;
    while i < self.current_type_param_bounds.len() {
        if self.current_type_param_bounds.get(i).key == name && self.current_type_param_bounds.get(i).val == tr {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Bind the type parameters `tps` that `param` mentions from `arg` (the first
/// binding of each wins), as mono.fd infer_from_pair.
fn tc_bind_type_params(param: Type, arg: Type, tps: Vec<str>, names: &mut Vec<str>, types: &mut Vec<Type>) {
    match param {
        Type::Named(n) => {
            if str_vec_contains(tps, n) && !str_vec_contains(names, n) && !type_eq(arg, Type::Infer) && !type_eq(arg, Type::Never) {
                names.push(n);
                types.push(arg);
            }
        }
        Type::Generic(gn, gargs) => {
            match arg {
                Type::Generic(an, aargs) => {
                    if gn == an {
                        var i: i64 = 0;
                        while i < gargs.len() && i < aargs.len() {
                            tc_bind_type_params(gargs.get(i), aargs.get(i), tps, names, types);
                            i = i + 1;
                        }
                    }
                }
                _ => {
                }
            }
        }
        Type::Ref(inner, _) => {
            match arg {
                Type::Ref(ainner, _) => {
                    tc_bind_type_params(box_type_unbox(inner), box_type_unbox(ainner), tps, names, types);
                }
                _ => {
                }
            }
        }
        Type::Array(elem, _) => {
            match arg {
                Type::Array(aelem, _) => {
                    tc_bind_type_params(box_type_unbox(elem), box_type_unbox(aelem), tps, names, types);
                }
                _ => {
                }
            }
        }
        // A const parameter `[T; N]` takes the array's length (as mono.fd)
        Type::ArrayConst(celem, size_param) => {
            match arg {
                Type::Array(aelem, size) => {
                    if str_vec_contains(tps, size_param) && !str_vec_contains(names, size_param) {
                        names.push(size_param);
                        types.push(Type_const_of(size));
                    }
                    tc_bind_type_params(box_type_unbox(celem), box_type_unbox(aelem), tps, names, types);
                }
                _ => {
                }
            }
        }
        Type::Tuple(ps) => {
            match arg {
                Type::Tuple(aps) => {
                    var i: i64 = 0;
                    while i < ps.len() && i < aps.len() {
                        tc_bind_type_params(ps.get(i), aps.get(i), tps, names, types);
                        i = i + 1;
                    }
                }
                _ => {
                }
            }
        }
        Type::Func(fps, fret) => {
            match arg {
                Type::Func(aps, aret) => {
                    var i: i64 = 0;
                    while i < fps.len() && i < aps.len() {
                        tc_bind_type_params(fps.get(i), aps.get(i), tps, names, types);
                        i = i + 1;
                    }
                    tc_bind_type_params(box_type_unbox(fret), box_type_unbox(aret), tps, names, types);
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
}

/// `ty` with its bound type parameters replaced.
fn tc_subst_type_params(ty: Type, names: Vec<str>, types: Vec<Type>) -> Type {
    match ty {
        Type::Named(n) => {
            var i: i64 = 0;
            while i < names.len() {
                if names.get(i) == n {
                    return types.get(i);
                }
                i = i + 1;
            }
            return ty;
        }
        Type::Generic(gn, gargs) => {
            var out: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < gargs.len() {
                out.push(tc_subst_type_params(gargs.get(i), names, types));
                i = i + 1;
            }
            return Type::Generic(gn, out);
        }
        Type::Ref(inner, m) => {
            return Type::Ref(Box::new(tc_subst_type_params(box_type_unbox(inner), names, types)), m);
        }
        Type::RawPtr(inner, m) => {
            return Type::RawPtr(Box::new(tc_subst_type_params(box_type_unbox(inner), names, types)), m);
        }
        Type::Array(elem, n) => {
            return Type::Array(Box::new(tc_subst_type_params(box_type_unbox(elem), names, types)), n);
        }
        Type::Tuple(ts) => {
            var out2: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < ts.len() {
                out2.push(tc_subst_type_params(ts.get(i), names, types));
                i = i + 1;
            }
            return Type::Tuple(out2);
        }
        Type::Func(fps, fret) => {
            var out3: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < fps.len() {
                out3.push(tc_subst_type_params(fps.get(i), names, types));
                i = i + 1;
            }
            return Type::Func(out3, Box::new(tc_subst_type_params(box_type_unbox(fret), names, types)));
        }
        _ => {
            return ty;
        }
    }
    return ty;
}

// --- type_contains_param -------------------------------------------------

pub fn TypeChecker_type_contains_param(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        // A named type that is neither a struct nor an enum is a type
        // parameter (of the callee: src/typechecker.rs type_contains_param);
        // the caller's own type params are not the ones to look at.
        Type::Named(name) => {
            // L8A: a number given for a const parameter (ast.fd
            // Type_const_of: the wire form) is a fixed type: a call
            // returning a Matrix<i64, 3> is typed so (it was Never, and a
            // Matrix<i64, 3> passed for a Matrix<i64, 2> was not checked)
            if Type_const_value(Type::Named(name)) >= 0 {
                return false;
            }
            match TypeChecker_lookup_struct_cache(self, name) {
                OptVecStructField::Some(_) => {
                    return false;
                }
                OptVecStructField::None => {
                }
            }
            return !TypeChecker_is_known_enum(self, name);
        }
        Type::Func(fparams, fret) => {
            var fi: i64 = 0;
            while fi < fparams.len() {
                if TypeChecker_type_contains_param(self, fparams.get(fi)) {
                    return true;
                }
                fi = fi + 1;
            }
            return TypeChecker_type_contains_param(self, box_type_unbox(fret));
        }
        Type::Ref(inner, _) => {
            return TypeChecker_type_contains_param(self, box_type_unbox(inner));
        }
        Type::RawPtr(inner, _) => {
            return TypeChecker_type_contains_param(self, box_type_unbox(inner));
        }
        Type::Array(elem, _) => {
            return TypeChecker_type_contains_param(self, box_type_unbox(elem));
        }
        Type::ArrayConst(elem, _) => {
            return TypeChecker_type_contains_param(self, box_type_unbox(elem));
        }
        Type::Generic(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                if TypeChecker_type_contains_param(self, args.get(i)) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if TypeChecker_type_contains_param(self, types.get(i)) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        _ => {
            return false;
        }
    }
    return false;
}

// --- is_known_enum -------------------------------------------------------

pub fn TypeChecker_is_known_enum(self: &TypeChecker, name: str) -> bool {
    return tc_str_vec_contains(self.enums, name);
}

// --- type_size -----------------------------------------------------------

pub fn TypeChecker_type_size(self: &TypeChecker, ty: Type) -> i64 {
    match ty {
        Type::I8 => {
            return 1;
        }
        Type::U8 => {
            return 1;
        }
        Type::Bool => {
            return 1;
        }
        Type::I16 => {
            return 2;
        }
        Type::U16 => {
            return 2;
        }
        Type::I32 => {
            return 4;
        }
        Type::U32 => {
            return 4;
        }
        Type::F32 => {
            return 4;
        }
        Type::I64 => {
            return 8;
        }
        Type::U64 => {
            return 8;
        }
        Type::F64 => {
            return 8;
        }
        Type::I128 => {
            return 16;
        }
        Type::U128 => {
            return 16;
        }
        Type::Str => {
            return 16;
        }
        Type::Named(name) => {
            var i: i64 = TypeChecker_struct_pos_ro(self, name);
            var i_lim: i64 = i + 1;
            if i < 0 {
                i = 0;
                i_lim = 0;
            }
            while i < i_lim {
                if self.structs.get(i).key == name {
                    return self.structs.get(i).val.len() * 8;
                }
                i = i + 1;
            }
            if name == "String" {
                return 16;
            }
            return 8;
        }
        Type::Generic(name, _) => {
            if name == "Vec" {
                return 24;
            }
            if name == "HashMap" {
                return 48;
            }
            if name == "Option" {
                return 16;
            }
            if name == "Result" {
                return 16;
            }
            return 8;
        }
        Type::Ref(_, _) => {
            return 8;
        }
        Type::RawPtr(_, _) => {
            return 8;
        }
        _ => {
            return 8;
        }
    }
    return 8;
}

// --- heap allocation: @no-alloc and region budgets ---------------------------

/// Builtin methods that allocate (Vec, HashMap, str), and "+" for `a + b`
/// on strings.
fn tc_alloc_method_names() -> Vec<str> {
    var alloc_methods: Vec<str> = Vec::new();
    alloc_methods.push("push");
    alloc_methods.push("push_str");
    alloc_methods.push("insert");
    alloc_methods.push("extend");
    alloc_methods.push("resize");
    alloc_methods.push("reserve");
    alloc_methods.push("clone");
    alloc_methods.push("to_str");
    alloc_methods.push("to_string");
    alloc_methods.push("concat");
    alloc_methods.push("split");
    alloc_methods.push("keys");
    alloc_methods.push("values");
    alloc_methods.push("append");
    alloc_methods.push("collect");
    alloc_methods.push("map");
    alloc_methods.push("filter");
    alloc_methods.push("+");
    return alloc_methods;
}

/// Functions that allocate on the heap.
fn tc_alloc_func_names() -> Vec<str> {
    var alloc_funcs: Vec<str> = Vec::new();
    alloc_funcs.push("p_vec_new");
    alloc_funcs.push("p_vec_push");
    alloc_funcs.push("p_vec_push_str");
    alloc_funcs.push("p_vec_insert");
    alloc_funcs.push("p_vec_resize");
    alloc_funcs.push("p_vec_extend");
    alloc_funcs.push("p_hashmap_new");
    alloc_funcs.push("p_hashmap_insert");
    alloc_funcs.push("p_string_new");
    alloc_funcs.push("p_string_push");
    alloc_funcs.push("p_string_concat");
    alloc_funcs.push("p_malloc");
    alloc_funcs.push("p_malloc_uninit");
    alloc_funcs.push("p_str_alloc_uninit");
    alloc_funcs.push("p_alloc");
    alloc_funcs.push("p_realloc");
    alloc_funcs.push("p_arena_new");
    alloc_funcs.push("p_arena_alloc");
    alloc_funcs.push("Vec_new");
    alloc_funcs.push("Vec_push");
    alloc_funcs.push("Vec_insert");
    alloc_funcs.push("Vec_resize");
    alloc_funcs.push("HashMap_new");
    alloc_funcs.push("HashMap_insert");
    alloc_funcs.push("String_new");
    alloc_funcs.push("String_push");
    alloc_funcs.push("Vec_with_capacity");
    alloc_funcs.push("Vec_filled_typed");
    alloc_funcs.push("Vec_clone");
    alloc_funcs.push("Box_new");
    alloc_funcs.push("StringBuilder_new");
    alloc_funcs.push("int_to_str");
    alloc_funcs.push("float_to_str");
    alloc_funcs.push("p_str_concat");
    alloc_funcs.push("p_to_str");
    alloc_funcs.push("p_str_alloc");
    return alloc_funcs;
}

/// Charge a heap allocation to the innermost region with a budget: `bytes`
/// when its size is known at compile time, else (bytes < 0) record it as
/// one the budget cannot bound.
fn TypeChecker_budget_heap(self: &mut TypeChecker, what: str, bytes: i64) {
    if self.region_budgets.len() == 0 {
        return;
    }
    var rb: RegionBudget = self.region_budgets.pop();
    match rb.budget {
        OptI64::Some(_) => {
            var n: i64 = bytes;
            var desc: str = what;
            if n >= 0 && self.loop_depth > rb.loop0 {
                n = -1;
                desc = what + " in a loop";
            }
            if n >= 0 {
                rb.usage = rb.usage + n;
            } else if rb.heap == "" {
                rb.heap = desc;
            }
        }
        OptI64::None => {
        }
    }
    self.region_budgets.push(rb);
}

/// RT8: builtins only core (and the runtimes merged into it) may call:
/// p_malloc_uninit (a p_malloc block whose bytes are not zeroed) and core's
/// p_str_alloc_uninit (a counted string whose bytes are not zeroed).
pub fn tc_core_only_builtin(callee: str) -> bool {
    return callee == "p_malloc_uninit" || callee == "p_str_alloc_uninit";
}

/// RT8: an allocation whose bytes are not zeroed is core's and the
/// runtimes' (merged into core): they write every byte they hand out.
/// Memory any other code gets reads as zero.
fn TypeChecker_check_core_only(self: &mut TypeChecker, callee: str) {
    if tc_core_only_builtin(callee) && self.current_module != "core" {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + callee + "() is internal to the core library: it returns memory whose bytes are not zeroed, and only stdlib/core.fd and the runtimes may call it.\n    Fix: use p_malloc(), whose block reads as zero.");
    }
}

/// The raw-memory builtins whose calls need an `unsafe` block.
fn tc_raw_memory_builtin(callee: str) -> bool {
    return callee == "p_malloc" || callee == "p_alloc" || callee == "p_free" || callee == "p_realloc" || callee == "p_memcpy" || callee == "p_memset" || callee == "p_malloc_uninit" || tc_core_raw_memory_fn(callee);
}

/// BG10: core's own functions (stdlib/core.fd, `pub fn p_*`) that write or
/// free memory at addresses their caller passes as plain integers, so a
/// call is as unsafe as p_memcpy or p_free: p_mem_copy, p_copy_words and
/// p_str_copy_n copy into `dst`, p_zero_words clears `p`, p_str_free frees
/// `s` whatever owns it, p_str_append appends to `s` in place and drops it,
/// and p_str_adopt takes over (or frees) the block `buf` names, so adopting
/// a str's word that still has its owner (`p_str_adopt(s as i64)`) frees it
/// twice. They were callable in safe code (`p_mem_copy(4096, 8192, 64)`).
/// Core and the runtimes call them freely (the trusted base,
/// tc_module_needs_unsafe); the lowering's own calls do not pass here.
/// Core's read-only helpers (p_str_hash, p_str_equal, p_bytes_eq,
/// p_mem_find_byte, p_str_cstr_len, p_str_hdr_len) and those that give a
/// str of its own (p_str_from_ptr copies, p_str_take copies or adds an
/// owner to a counted string) or a new block (p_str_alloc, p_str_buf) stay
/// as they are.
fn tc_core_raw_memory_fn(callee: str) -> bool {
    return callee == "p_mem_copy" || callee == "p_copy_words" || callee == "p_zero_words" || callee == "p_str_copy_n" || callee == "p_str_free" || callee == "p_str_append" || callee == "p_str_adopt" || tc_core_raw_writer_fn(callee);
}

/// BG113: core's functions without the `p_` prefix that write, free or
/// change the owner count at an address their caller passes as an i64
/// (stdlib/core.fd): vec_st stores an element into a buffer, vec_fill_at
/// fills one, Vec_init_typed / Vec_init_filled / Vec_init_filled_at write a
/// Vec header at `p`, vec_buf_free / vec_box_free / vec_elem_drop /
/// Str_drop / Box_drop_t free or drop what the word names, Str_dup /
/// Box_dup / Box_dup_t / vec_elem_dup add an owner (a write of its count),
/// vec_own, vec_sz_push / vec_sz_set and vec_raw_reverse / _extend /
/// _insert / _remove / _sort change a Vec given as a raw word, and
/// Str_concat_into writes into `buf`. BG10 gated only the `p_` ones, so
/// `Str_drop(4096)` was callable in safe code. The lowering's own calls do
/// not pass here; core and the runtimes call them freely.
fn tc_core_raw_writer_fn(callee: str) -> bool {
    if str_len(callee) < 5 {
        return false;
    }
    val c0: i64 = str_byte_at(callee, 0);
    if c0 != 118 && c0 != 86 && c0 != 83 && c0 != 66 {
        return false;
    }
    return callee == "vec_st" || callee == "vec_fill_at" || callee == "Vec_init_typed" || callee == "Vec_init_filled" || callee == "Vec_init_filled_at" || callee == "vec_buf_free" || callee == "vec_box_free" || callee == "vec_elem_drop" || callee == "Str_drop" || callee == "Box_drop_t" || callee == "Str_dup" || callee == "Box_dup" || callee == "Box_dup_t" || callee == "vec_elem_dup" || callee == "vec_own" || callee == "vec_sz_push" || callee == "vec_sz_set" || callee == "vec_raw_reverse" || callee == "vec_raw_extend" || callee == "vec_raw_insert" || callee == "vec_raw_remove" || callee == "vec_raw_sort" || callee == "Str_concat_into";
}

/// The allocation builtins that need the Alloc capability.
fn tc_alloc_cap_builtin(callee: str) -> bool {
    return callee == "p_malloc" || callee == "p_free" || callee == "p_malloc_persistent" || callee == "p_arena_save" || callee == "p_arena_restore" || callee == "p_malloc_uninit";
}

/// A call inside a region with a budget: p_malloc(N) with a constant N
/// and Vec::new() have a known size; any other allocating builtin, or a
/// function that allocates (itself or through its callees), has none.
fn TypeChecker_budget_call(self: &mut TypeChecker, callee: str, args: Vec<Expr>) {
    if callee == "p_malloc" || callee == "p_alloc" || callee == "p_malloc_uninit" {
        if args.len() == 1 {
            match args.get(0) {
                Expr::IntLit(n) => {
                    TypeChecker_budget_heap(self, callee + "(" + int_to_str(n) + ")", n);
                    return;
                }
                _ => {
                }
            }
        }
        TypeChecker_budget_heap(self, callee + "() of a size not known at compile time", -1);
        return;
    }
    if callee == "Vec_new" || callee == "p_vec_new" {
        TypeChecker_budget_heap(self, "Vec::new()", 24);
        return;
    }
    if tc_vec_contains_str(tc_alloc_func_names(), callee) {
        TypeChecker_budget_heap(self, "'" + callee + "()'", -1);
        return;
    }
    if HashMap_get(self.heap_alloc_index, callee) != 0 {
        TypeChecker_budget_heap(self, "'" + callee + "()', which allocates", -1);
    }
}

/// A method call on a value inside a region with a budget: a growing
/// builtin method (push, insert, clone, ...) on a Vec, HashMap or string,
/// or a user method that allocates.
fn TypeChecker_budget_method(self: &mut TypeChecker, recv_ty: Type, method: str) {
    var builtin: bool = false;
    var owner: str = "";
    match recv_ty {
        Type::Str => {
            builtin = true;
        }
        Type::Generic(gn, _) => {
            builtin = gn == "Vec" || gn == "HashMap" || gn == "Option" || gn == "Result";
            owner = gn;
        }
        Type::Named(nn) => {
            if nn == "Vec" || nn == "HashMap" || nn == "String" || nn == "StringBuilder" {
                builtin = true;
            }
            owner = nn;
        }
        _ => {
        }
    }
    if owner != "" && HashMap_get(self.heap_alloc_index, owner + "." + method) != 0 {
        TypeChecker_budget_heap(self, "'." + method + "()' on " + owner + ", which allocates", -1);
        return;
    }
    if builtin && tc_vec_contains_str(tc_alloc_method_names(), method) {
        TypeChecker_budget_heap(self, "'." + method + "()'", -1);
    }
}

/// A name bound in a scope (a variable, not a type name).
fn TypeChecker_is_local_var(self: &TypeChecker, name: str) -> bool {
    match TypeChecker_lookup(self, name) {
        OptType::Some(_) => {
            return true;
        }
        OptType::None => {
        }
    }
    return false;
}

/// Some statement of `stmts` (or of a block in them) is a region with a
/// budget.
fn tc_stmts_have_budget(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::RegionBlock(_, budget, _, _, _, body, _) => {
                match budget {
                    OptI64::Some(_) => {
                        return true;
                    }
                    OptI64::None => {
                    }
                }
                if tc_stmts_have_budget(body) {
                    return true;
                }
            }
            Stmt::If(_, then_b, else_b, _) => {
                if tc_stmts_have_budget(then_b) {
                    return true;
                }
                match else_b {
                    OptStmts::Some(eb) => {
                        if tc_stmts_have_budget(eb) {
                            return true;
                        }
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(_, body, _) => {
                if tc_stmts_have_budget(body) {
                    return true;
                }
            }
            Stmt::For(_, _, body, _) => {
                if tc_stmts_have_budget(body) {
                    return true;
                }
            }
            Stmt::Loop(body, _) => {
                if tc_stmts_have_budget(body) {
                    return true;
                }
            }
            Stmt::Defer(body, _) => {
                if tc_stmts_have_budget(body) {
                    return true;
                }
            }
            Stmt::Sandbox(body, _) => {
                if tc_stmts_have_budget(body) {
                    return true;
                }
            }
            Stmt::Unsafe(body, _) => {
                if tc_stmts_have_budget(body) {
                    return true;
                }
            }
            Stmt::Txn(body, _) => {
                if tc_stmts_have_budget(body) {
                    return true;
                }
            }
            Stmt::SpawnScope(body, _) => {
                if tc_stmts_have_budget(body) {
                    return true;
                }
            }
            Stmt::Match(_, arms, _) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    if tc_stmts_have_budget(arms.get(ai).body) {
                        return true;
                    }
                    ai = ai + 1;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

/// Some statement of `stmts` (or of a block in them) is `sandbox { }`.
fn tc_stmts_have_sandbox(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Sandbox(_, _) => {
                return true;
            }
            Stmt::RegionBlock(_, _, _, _, _, body, _) => {
                if tc_stmts_have_sandbox(body) {
                    return true;
                }
            }
            Stmt::If(_, then_b, else_b, _) => {
                if tc_stmts_have_sandbox(then_b) {
                    return true;
                }
                match else_b {
                    OptStmts::Some(eb) => {
                        if tc_stmts_have_sandbox(eb) {
                            return true;
                        }
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(_, body, _) => {
                if tc_stmts_have_sandbox(body) {
                    return true;
                }
            }
            Stmt::For(_, _, body, _) => {
                if tc_stmts_have_sandbox(body) {
                    return true;
                }
            }
            Stmt::Loop(body, _) => {
                if tc_stmts_have_sandbox(body) {
                    return true;
                }
            }
            Stmt::Defer(body, _) => {
                if tc_stmts_have_sandbox(body) {
                    return true;
                }
            }
            Stmt::Unsafe(body, _) => {
                if tc_stmts_have_sandbox(body) {
                    return true;
                }
            }
            Stmt::Txn(body, _) => {
                if tc_stmts_have_sandbox(body) {
                    return true;
                }
            }
            Stmt::SpawnScope(body, _) => {
                if tc_stmts_have_sandbox(body) {
                    return true;
                }
            }
            Stmt::Match(_, arms, _) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    if tc_stmts_have_sandbox(arms.get(ai).body) {
                        return true;
                    }
                    ai = ai + 1;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

/// A call that runs code the effect system cannot see: a C function
/// declared `extern "C"`, a function loaded at run time (`p_dl_*`), a raw
/// system call, or inline assembly (recorded as "asm!").
fn TypeChecker_is_opaque_call(self: &TypeChecker, c: str) -> bool {
    if c == "asm!" {
        return true;
    }
    if str_starts_with(c, "p_dl_") || str_starts_with(c, "p_syscall") {
        return true;
    }
    return str_vec_contains(self.extern_fns, c) && !str_starts_with(c, "p_");
}

/// ffi_reach_index: every function or method that runs opaque code
/// (TypeChecker_is_opaque_call), itself or through a function it calls.
/// A method is also recorded as ".name", so a call `x.name()` whose
/// receiver type is not known here counts when any method of that name
/// does (an over-approximation: sandbox may reject, never wrongly accept).
/// Computed only when the program has a sandbox.
fn TypeChecker_compute_ffi_reach(self: &mut TypeChecker, program: Program) {
    var any: bool = false;
    var fi: i64 = 0;
    while fi < program.funcs.len() && !any {
        if tc_stmts_have_sandbox(program.funcs.get(fi).body) {
            any = true;
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() && !any {
        var imp0: ImplDef = program.impls.get(ii);
        var m0: i64 = 0;
        while m0 < imp0.methods.len() {
            if tc_stmts_have_sandbox(imp0.methods.get(m0).body) {
                any = true;
            }
            m0 = m0 + 1;
        }
        ii = ii + 1;
    }
    if !any {
        return;
    }
    var names: Vec<str> = Vec::new();
    var aliases: Vec<str> = Vec::new();
    var dots: Vec<str> = Vec::new();
    var bodies_calls: Vec<Vec<str>> = Vec::new();
    fi = 0;
    while fi < program.funcs.len() {
        var f: Func = program.funcs.get(fi);
        names.push(f.name);
        aliases.push("");
        dots.push("");
        var raw: Vec<str> = Vec::new();
        g_scan_dot_methods = true;
        g_scan_asm = true;
        scan_stmts_for_calls(f.body, &mut raw);
        g_scan_asm = false;
        g_scan_dot_methods = false;
        bodies_calls.push(raw);
        fi = fi + 1;
    }
    ii = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            names.push(imp.struct_name + "." + m.name);
            aliases.push(imp.struct_name + "_" + m.name);
            dots.push("." + m.name);
            var raw2: Vec<str> = Vec::new();
            g_scan_dot_methods = true;
            g_scan_asm = true;
            scan_stmts_for_calls(m.body, &mut raw2);
            g_scan_asm = false;
            g_scan_dot_methods = false;
            bodies_calls.push(raw2);
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var done: Vec<bool> = Vec::new();
    var k: i64 = 0;
    while k < names.len() {
        done.push(false);
        k = k + 1;
    }
    var changed: bool = true;
    while changed {
        changed = false;
        k = 0;
        while k < names.len() {
            if !done.get(k) {
                var calls: Vec<str> = bodies_calls.get(k);
                var cj: i64 = 0;
                while cj < calls.len() {
                    var c: str = calls.get(cj);
                    if TypeChecker_is_opaque_call(self, c) || HashMap_get(self.ffi_reach_index, c) != 0 {
                        done.set(k, true);
                        HashMap_insert(self.ffi_reach_index, names.get(k), 1);
                        if aliases.get(k) != "" {
                            HashMap_insert(self.ffi_reach_index, aliases.get(k), 1);
                        }
                        if dots.get(k) != "" {
                            HashMap_insert(self.ffi_reach_index, dots.get(k), 1);
                        }
                        changed = true;
                        cj = calls.len();
                    }
                    cj = cj + 1;
                }
            }
            k = k + 1;
        }
    }
}

/// heap_alloc_index: every function or method that allocates on the heap,
/// directly (an allocating builtin, a growing method, string `+`) or
/// through a function it calls. Printing does not count.
fn TypeChecker_compute_heap_alloc(self: &mut TypeChecker, program: Program) {
    var any: bool = false;
    var fi: i64 = 0;
    while fi < program.funcs.len() && !any {
        if tc_stmts_have_budget(program.funcs.get(fi).body) {
            any = true;
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() && !any {
        var imp0: ImplDef = program.impls.get(ii);
        var m0: i64 = 0;
        while m0 < imp0.methods.len() {
            if tc_stmts_have_budget(imp0.methods.get(m0).body) {
                any = true;
            }
            m0 = m0 + 1;
        }
        ii = ii + 1;
    }
    if !any {
        return;
    }
    var afuncs: Vec<str> = tc_alloc_func_names();
    var ameths: Vec<str> = tc_alloc_method_names();
    var names: Vec<str> = Vec::new();
    var aliases: Vec<str> = Vec::new();
    var dots: Vec<str> = Vec::new();
    var bodies_calls: Vec<Vec<str>> = Vec::new();
    fi = 0;
    while fi < program.funcs.len() {
        var f: Func = program.funcs.get(fi);
        names.push(f.name);
        aliases.push("");
        dots.push("");
        var raw: Vec<str> = Vec::new();
        g_scan_dot_methods = true;
        scan_stmts_for_calls(f.body, &mut raw);
        g_scan_dot_methods = false;
        bodies_calls.push(raw);
        fi = fi + 1;
    }
    ii = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            names.push(imp.struct_name + "." + m.name);
            aliases.push(imp.struct_name + "_" + m.name);
            dots.push("." + m.name);
            var raw2: Vec<str> = Vec::new();
            g_scan_dot_methods = true;
            scan_stmts_for_calls(m.body, &mut raw2);
            g_scan_dot_methods = false;
            bodies_calls.push(raw2);
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var done: Vec<bool> = Vec::new();
    var k: i64 = 0;
    while k < names.len() {
        var nm: str = names.get(k);
        var direct: bool = false;
        if !str_starts_with(nm, "print") && !str_starts_with(nm, "eprint") {
            var calls: Vec<str> = bodies_calls.get(k);
            var ci: i64 = 0;
            while ci < calls.len() && !direct {
                var c: str = calls.get(ci);
                if str_starts_with(c, ".") {
                    if tc_vec_contains_str(ameths, str_slice(c, 1, str_len(c))) {
                        direct = true;
                    }
                } else if tc_vec_contains_str(afuncs, c) {
                    direct = true;
                }
                ci = ci + 1;
            }
        }
        done.push(direct);
        if direct {
            HashMap_insert(self.heap_alloc_index, nm, 1);
            if aliases.get(k) != "" {
                HashMap_insert(self.heap_alloc_index, aliases.get(k), 1);
            }
            if dots.get(k) != "" {
                HashMap_insert(self.heap_alloc_index, dots.get(k), 1);
            }
        }
        k = k + 1;
    }
    var changed: bool = true;
    while changed {
        changed = false;
        k = 0;
        while k < names.len() {
            var nm2: str = names.get(k);
            if !done.get(k) && !str_starts_with(nm2, "print") && !str_starts_with(nm2, "eprint") {
                var calls2: Vec<str> = bodies_calls.get(k);
                var cj: i64 = 0;
                while cj < calls2.len() {
                    var c2: str = calls2.get(cj);
                    // ".m": a call `x.m()` of a user method; it allocates
                    // when some method named m does (receiver types are
                    // not known here: an over-approximation)
                    if HashMap_get(self.heap_alloc_index, c2) != 0 {
                        done.set(k, true);
                        HashMap_insert(self.heap_alloc_index, nm2, 1);
                        if aliases.get(k) != "" {
                            HashMap_insert(self.heap_alloc_index, aliases.get(k), 1);
                        }
                        if dots.get(k) != "" {
                            HashMap_insert(self.heap_alloc_index, dots.get(k), 1);
                        }
                        changed = true;
                        cj = calls2.len();
                    }
                    cj = cj + 1;
                }
            }
            k = k + 1;
        }
    }
}

// --- sandbox: effects of what a call runs ----------------------------------

/// The first IO/Net/Spawn effect in `effs`, or "" when there is none:
/// what a call inside `sandbox { }` may not have.
fn tc_sandbox_forbidden(effs: Vec<str>) -> str {
    var i: i64 = 0;
    while i < effs.len() {
        var e: str = effs.get(i);
        if e == "IO" || e == "Net" || e == "Spawn" {
            return e;
        }
        i = i + 1;
    }
    return "";
}

fn TypeChecker_sandbox_reject(self: &mut TypeChecker, what: str, effs: Vec<str>) {
    var e: str = tc_sandbox_forbidden(effs);
    if e == "" {
        return;
    }
    self.errors.push("Sandbox error: '" + what + "' has effect '!" + e + "' -- all capabilities are revoked inside sandbox, including in the functions it calls");
}

/// A call inside sandbox: the builtin's effect (p_file_read is IO, ...),
/// the inferred effects of a user function (transitive), and for a
/// higher-order callee the effects of the functions passed to it. A call
/// through a function value of unknown effects is rejected too.
fn TypeChecker_check_sandbox_call(self: &mut TypeChecker, callee: str, args: Vec<Expr>) {
    // C code, run-time loaded code and assembly have effects the checker
    // cannot see: inside sandbox they are rejected, also through a helper.
    if TypeChecker_is_opaque_call(self, callee) {
        self.errors.push("Sandbox error: '" + callee + "()' runs code outside Fides (C, a loaded library or a system call) whose effects are not known -- all capabilities are revoked inside sandbox");
        return;
    }
    if HashMap_get(self.ffi_reach_index, callee) != 0 {
        self.errors.push("Sandbox error: '" + callee + "()' calls C code, a loaded library or inline assembly (directly or through the functions it calls), whose effects are not known -- all capabilities are revoked inside sandbox");
        return;
    }
    var effs: Vec<str> = Vec::new();
    var no_args: Vec<Expr> = Vec::new();
    TypeChecker_scan_expr_for_effects(self, Expr::Call(callee, no_args), &mut effs);
    var ho_at: i64 = HashMap_get(self.ho_fn_index, callee);
    if ho_at != 0 {
        var hidx: Vec<i64> = self.ho_fn_idx.get(ho_at - 1);
        var hk: i64 = 0;
        while hk < hidx.len() {
            if hidx.get(hk) < args.len() {
                TypeChecker_passed_fn_effects(self, args.get(hidx.get(hk)), &mut effs);
            }
            hk = hk + 1;
        }
    }
    if tc_sandbox_forbidden(effs) == "" && HashMap_get(self.func_effects_index, callee) == 0 {
        match TypeChecker_lookup(self, callee) {
            OptType::Some(t) => {
                match t {
                    Type::Func(_, _) => {
                        self.errors.push("Sandbox error: '" + callee + "()' calls a function value whose effects are not known -- all capabilities are revoked inside sandbox");
                        return;
                    }
                    _ => {
                    }
                }
            }
            OptType::None => {
            }
        }
    }
    TypeChecker_sandbox_reject(self, callee + "()", effs);
}

// --- comptime has no I/O (CD8) -------------------------------------------

/// How deep the checker is inside `comptime <expr>`, `comptime { }` or the
/// body of a `comptime fn`.
var g_tc_comptime_depth: i64 = 0;

/// How deep the checker is inside `try { }` blocks of the function being
/// checked: there `e?` goes to the block's error, not to the function's
/// return (known-bugs 2g.55).
var g_tc_try_depth: i64 = 0;

/// The index in scope_linear_vars of the scope of the function (or closure)
/// whose body is being checked: a `return` leaves the scopes from there on,
/// so their linear variables must be consumed by then.
var g_tc_linear_base: i64 = 0;

/// A `return` ends the function on its path: every linear variable still
/// live there (a parameter or a local of the function's scopes, not yet
/// consumed) is lost on that path. `if a.id == 2 { return 5; }` before the
/// only consumption of `a` was accepted, as the end-of-scope check sees the
/// path that consumes it. A variable reported here is marked consumed so
/// the end of its scope does not report it again.
fn TypeChecker_linear_check_return(self: &mut TypeChecker, line: i64) {
    var si: i64 = g_tc_linear_base;
    if si < 0 {
        si = 0;
    }
    while si < self.scope_linear_vars.len() {
        var lvs: Vec<LinearVar> = self.scope_linear_vars.get(si);
        var i: i64 = 0;
        while i < lvs.len() {
            var lv: LinearVar = lvs.get(i);
            var lv_done: bool = tc_str_vec_contains(self.consumed_vars, lv.name);
            if !lv_done {
                match TypeChecker_lookup(self, lv.name) {
                    OptType::Some(lty) => {
                        lv_done = TypeChecker_linear_fields_moved(self, lv.name, lty);
                    }
                    OptType::None => {
                    }
                }
            }
            if !lv_done {
                self.errors.push("Linear type error (line " + int_to_str(lv.line) + "): variable '" + lv.name + "' is linear but was never consumed.\n    It is lost on the path through the `return` on line " + int_to_str(line) + ".\n    Fix: consume it (pass it on or return it) before that return.");
                self.consumed_vars.push(lv.name);
            }
            i = i + 1;
        }
        si = si + 1;
    }
}

/// known-bugs 2g.55: `e?` returns `None`/`Err` from the enclosing function,
/// so that function must return an Option or a Result (a closure without a
/// declared type, or a `try { }` block, takes it as it is). "" when it may,
/// else the error.
fn TypeChecker_try_ret_error(self: &TypeChecker) -> str {
    if g_tc_try_depth > 0 {
        return "";
    }
    match self.current_ret_ty {
        OptType::Some(rt0) => {
            var rt: Type = TypeChecker_resolve_type(self, TypeChecker_resolve_self_type(self, rt0));
            match rt {
                Type::Generic(gname, _) => {
                    if gname == "Option" || gname == "Result" {
                        return "";
                    }
                }
                Type::Named(nname) => {
                    if nname == "Option" || nname == "Result" {
                        return "";
                    }
                    // a type parameter of a generic function: its instances
                    // are checked where they are made
                    var tpi: i64 = 0;
                    while tpi < self.current_type_params.len() {
                        if self.current_type_params.get(tpi) == nname {
                            return "";
                        }
                        tpi = tpi + 1;
                    }
                }
                Type::Infer => {
                    return "";
                }
                Type::Never => {
                    return "";
                }
                _ => {
                }
            }
            var fname: str = "this function";
            match self.current_func_name {
                OptString::Some(cfn) => {
                    fname = "'" + cfn + "'";
                }
                OptString::None => {
                }
            }
            return "Type error: the ? operator returns None or Err from the enclosing function, but " + fname + " returns " + type_to_str(rt) + " (it must return Option or Result; use match, ?? or a try { } block)";
        }
        OptType::None => {
        }
    }
    return "";
}

/// CD8 (complaint-roadmap): comptime code runs inside the compiler. It may
/// compute, not touch the world: a call that does I/O (files, the console,
/// the clock, the environment), uses the network, starts processes or runs
/// C code is a compile error. Before, such a comptime could not be
/// evaluated and quietly ran when the program did.
fn TypeChecker_check_comptime_call(self: &mut TypeChecker, callee: str) {
    var what: str = "";
    if TypeChecker_is_opaque_call(self, callee) || HashMap_get(self.ffi_reach_index, callee) != 0 {
        what = "runs C code, a loaded library or a system call";
    } else if callee == "p_argv" || callee == "p_argc" || callee == "p_env_set" || str_starts_with(callee, "p_co_") || callee == "p_chan_send" || callee == "p_chan_recv" {
        what = "talks to the running program's environment (arguments, environment, tasks or channels)";
    } else {
        var effs: Vec<str> = Vec::new();
        var no_args: Vec<Expr> = Vec::new();
        TypeChecker_scan_expr_for_effects(self, Expr::Call(callee, no_args), &mut effs);
        var e: str = tc_sandbox_forbidden(effs);
        if e == "IO" {
            what = "does I/O (files, the console, the clock, random numbers or the environment)";
        } else if e == "Net" {
            what = "uses the network";
        } else if e == "Spawn" {
            what = "starts processes or threads";
        }
    }
    if what != "" {
        self.errors.push("Comptime error (line " + int_to_str(self.current_line) + "): '" + callee + "()' " + what + ". Comptime code runs inside the compiler with no I/O: it may only compute.\n    Fix: do this when the program runs (drop `comptime`), or write the data into the source as a literal.");
    }
}

// --- Crypto capability (roadmap L4F) -------------------------------------

/// The standard library's cryptography modules. Calling into one of them
/// (or p_os_random_u64) needs the Crypto capability; their own calls to
/// each other do not.
fn tc_crypto_module(m: str) -> bool {
    var base: str = m;
    var k: i64 = str_len(m) - 1;
    while k > 0 {
        if str_byte_at(m, k) == 58 && str_byte_at(m, k - 1) == 58 {
            base = str_slice(m, k + 1, str_len(m));
            k = 0;
        }
        k = k - 1;
    }
    return base == "crypto" || base == "crypto_bind" || base == "crypto_bind_unix" || base == "sha512" || base == "ed25519" || base == "x25519" || base == "tls_crypto";
}

fn TypeChecker_check_crypto_call(self: &mut TypeChecker, callee: str) {
    // A capability is checked only with `use .. with { .. }` or in sandbox
    if !self.strict_caps && self.sandbox_depth == 0 {
        return;
    }
    if tc_crypto_module(self.current_module) {
        return;
    }
    var is_crypto: bool = callee == "p_os_random_u64";
    if !is_crypto {
        match TypeChecker_get_item_module(self, callee) {
            OptString::Some(m) => {
                is_crypto = tc_crypto_module(m);
            }
            OptString::None => {
            }
        }
    }
    if is_crypto {
        TypeChecker_check_capability(self, "Crypto", callee + "()");
    }
}

// --- L4E: regex patterns checked at compile time ---------------------------
// A string literal given as the pattern of a stdlib/regex.fd function is
// parsed here the way regex_compile parses it: the same scan as rv_bars,
// rv_alt, rv_seq, rv_atom, rv_atom_end, rv_class_end, rx_parse_class and
// rx_parse_brace, with the same limits (RV_MAX_REPEAT = 1000 copies, groups
// 200 deep). A pattern regex_compile would reject is then found before the
// program runs: an error for regex_compile (its Regex could never match),
// a warning for the functions that compile their pattern themselves and
// answer false / -1 / nothing for a bad one (regex_match, regex_search,
// regex_find_re, regex_find_span, regex_captures, regex_capture_spans(_from),
// regex_group, regex_replace, regex_split). Keep this in step with
// stdlib/regex.fd when its syntax grows.

/// Why the last tc_rx_compile_ok said no.
var g_tc_rx_why: str = "";

/// Which argument of a stdlib/regex.fd function is the pattern it
/// compiles, or -1.
fn tc_rx_pattern_arg(name: str) -> i64 {
    if name == "regex_compile" {
        return 0;
    }
    if name == "regex_match" || name == "regex_search" || name == "regex_find_re" || name == "regex_find_span" || name == "regex_capture_spans_from" || name == "regex_capture_spans" || name == "regex_captures" || name == "regex_group" || name == "regex_replace" || name == "regex_split" {
        return 1;
    }
    return -1;
}

/// rv_class_end: index past the ']' of the class whose body starts at j0.
fn tc_rx_class_end(re: str, j0: i64, n: i64) -> i64 {
    var j: i64 = j0;
    if j < n && str_byte_at(re, j) == 94 {
        j = j + 1;
    }
    var first: bool = true;
    while j < n {
        val c: i64 = str_byte_at(re, j);
        if c == 93 && !first {
            return j + 1;
        }
        first = false;
        if c == 92 {
            j = j + 2;
        } else {
            j = j + 1;
        }
    }
    return -1;
}

/// rx_parse_class without the bitmap: index past the ']' or -1.
fn tc_rx_class_scan(re: str, i: i64) -> i64 {
    val n: i64 = str_len(re);
    var j: i64 = i;
    if j < n && str_byte_at(re, j) == 94 {
        j = j + 1;
    }
    var first: bool = true;
    while j < n {
        val c: i64 = str_byte_at(re, j);
        if c == 93 && !first {
            return j + 1;
        }
        first = false;
        if c == 92 {
            if j + 1 >= n {
                return -1;
            }
            j = j + 2;
        } else if j + 2 < n && str_byte_at(re, j + 1) == 45 && str_byte_at(re, j + 2) != 93 {
            j = j + 3;
        } else {
            j = j + 1;
        }
    }
    return -1;
}

/// rv_atom_end: index past the atom at i (before its quantifier), or -1
/// with the reason in g_tc_rx_why.
fn tc_rx_atom_end(re: str, i: i64, n: i64) -> i64 {
    if i >= n {
        g_tc_rx_why = "it ends where an atom is expected";
        return -1;
    }
    val c: i64 = str_byte_at(re, i);
    if c == 40 {
        var j: i64 = i + 1;
        var d: i64 = 1;
        while j < n {
            val ch: i64 = str_byte_at(re, j);
            if ch == 92 {
                j = j + 2;
            } else if ch == 91 {
                j = tc_rx_class_end(re, j + 1, n);
                if j < 0 {
                    g_tc_rx_why = "a '[' is not closed by ']'";
                    return -1;
                }
            } else {
                if ch == 40 {
                    d = d + 1;
                }
                if ch == 41 {
                    d = d - 1;
                    if d == 0 {
                        return j + 1;
                    }
                }
                j = j + 1;
            }
        }
        g_tc_rx_why = "the '(' at offset " + int_to_str(i) + " is not closed by ')'";
        return -1;
    }
    if c == 91 {
        val ce: i64 = tc_rx_class_end(re, i + 1, n);
        if ce < 0 {
            g_tc_rx_why = "the '[' at offset " + int_to_str(i) + " is not closed by ']'";
        }
        return ce;
    }
    if c == 92 {
        if i + 1 < n {
            return i + 2;
        }
        g_tc_rx_why = "it ends with a lone '\\'";
        return -1;
    }
    if c == 41 {
        g_tc_rx_why = "the ')' at offset " + int_to_str(i) + " closes no group";
        return -1;
    }
    if c == 124 {
        g_tc_rx_why = "the '|' at offset " + int_to_str(i) + " is out of place";
        return -1;
    }
    if c == 42 || c == 43 || c == 63 {
        g_tc_rx_why = "the '" + byte_to_str(c) + "' at offset " + int_to_str(i) + " has nothing before it to repeat";
        return -1;
    }
    return i + 1;
}

/// rv_bars: the '|' at the top level of re[i..end).
fn tc_rx_bars(re: str, i: i64, end: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var j: i64 = i;
    var d: i64 = 0;
    while j < end {
        val c: i64 = str_byte_at(re, j);
        if c == 92 {
            j = j + 2;
        } else if c == 91 {
            val k: i64 = tc_rx_class_end(re, j + 1, end);
            if k < 0 {
                return out;
            }
            j = k;
        } else {
            if c == 40 {
                d = d + 1;
            }
            if c == 41 {
                d = d - 1;
            }
            if c == 124 && d == 0 {
                out.push(j);
            }
            j = j + 1;
        }
    }
    return out;
}

/// rx_parse_brace at i (after '{'): [min, max (-1: none), end] in out3, or
/// false. Counts stop growing past 1000001 (all over RV_MAX_REPEAT alike),
/// so a count longer than an i64 does not overflow here.
fn tc_rx_brace(re: str, i: i64, out3: &mut Vec<i64>) -> bool {
    val n: i64 = str_len(re);
    var j: i64 = i;
    var mn: i64 = 0;
    var mx: i64 = -1;
    var has: bool = false;
    while j < n && str_byte_at(re, j) >= 48 && str_byte_at(re, j) <= 57 {
        if mn <= 100000 {
            mn = mn * 10 + (str_byte_at(re, j) - 48);
        }
        j = j + 1;
        has = true;
    }
    if !has {
        return false;
    }
    if j < n && str_byte_at(re, j) == 44 {
        j = j + 1;
        if j < n && str_byte_at(re, j) >= 48 && str_byte_at(re, j) <= 57 {
            mx = 0;
            while j < n && str_byte_at(re, j) >= 48 && str_byte_at(re, j) <= 57 {
                if mx <= 100000 {
                    mx = mx * 10 + (str_byte_at(re, j) - 48);
                }
                j = j + 1;
            }
        }
    } else {
        mx = mn;
    }
    if j >= n || str_byte_at(re, j) != 125 {
        return false;
    }
    out3.push(mn);
    out3.push(mx);
    out3.push(j + 1);
    return true;
}

/// rv_atom: the atom re[j..aj).
fn tc_rx_atom(re: str, j: i64, aj: i64, depth: i64) -> bool {
    if depth > 200 {
        g_tc_rx_why = "its groups are nested more than 200 deep";
        return false;
    }
    val c: i64 = str_byte_at(re, j);
    if c == 40 {
        if j + 2 < str_len(re) && str_byte_at(re, j + 1) == 63 && str_byte_at(re, j + 2) == 58 {
            return tc_rx_alt(re, j + 3, aj - 1, depth + 1);
        }
        return tc_rx_alt(re, j + 1, aj - 1, depth + 1);
    }
    if c == 91 {
        if tc_rx_class_scan(re, j + 1) < 0 {
            g_tc_rx_why = "the class '[' at offset " + int_to_str(j) + " is not closed by ']'";
            return false;
        }
    }
    return true;
}

/// rv_seq: atoms and their quantifiers in re[i..end).
fn tc_rx_seq(re: str, i: i64, end: i64, depth: i64) -> bool {
    var j: i64 = i;
    var b3: Vec<i64> = Vec::new();
    while j < end {
        val aj: i64 = tc_rx_atom_end(re, j, end);
        if aj < 0 {
            return false;
        }
        var q: i64 = aj;
        var mn: i64 = 1;
        var mx: i64 = 1;
        if aj < end {
            val qc: i64 = str_byte_at(re, aj);
            if qc == 42 {
                mn = 0;
                mx = -1;
                q = aj + 1;
            } else if qc == 43 {
                mn = 1;
                mx = -1;
                q = aj + 1;
            } else if qc == 63 {
                mn = 0;
                mx = 1;
                q = aj + 1;
            } else if qc == 123 {
                b3.clear();
                if tc_rx_brace(re, aj + 1, &mut b3) && b3.get(2) <= end {
                    mn = b3.get(0);
                    mx = b3.get(1);
                    q = b3.get(2);
                }
            }
        }
        if mn > 1000 || mx > 1000 {
            g_tc_rx_why = "the repeat count at offset " + int_to_str(aj) + " is over 1000";
            return false;
        }
        if mx >= 0 && mx < mn {
            g_tc_rx_why = "the repeat {" + int_to_str(mn) + "," + int_to_str(mx) + "} at offset " + int_to_str(aj) + " has its maximum below its minimum";
            return false;
        }
        // rv_seq emits the atom only when some copy of it is wanted
        if mn > 0 || mx < 0 || mx > mn {
            if !tc_rx_atom(re, j, aj, depth) {
                return false;
            }
        }
        j = q;
    }
    return true;
}

/// rv_alt: alternatives of re[i..end).
fn tc_rx_alt(re: str, i: i64, end: i64, depth: i64) -> bool {
    val bars: Vec<i64> = tc_rx_bars(re, i, end);
    var s0: i64 = i;
    var k: i64 = 0;
    while k < bars.len() {
        if !tc_rx_seq(re, s0, bars.get(k), depth) {
            return false;
        }
        s0 = bars.get(k) + 1;
        k = k + 1;
    }
    return tc_rx_seq(re, s0, end, depth);
}

/// Whether regex_compile(re) gives a Regex with `ok` set.
pub fn tc_rx_compile_ok(re: str) -> bool {
    g_tc_rx_why = "";
    return tc_rx_alt(re, 0, str_len(re), 0);
}

fn TypeChecker_check_regex_literal(self: &mut TypeChecker, callee: str, args: Vec<Expr>) {
    var name: str = callee;
    val sep: i64 = str_rfind(callee, "::");
    if sep >= 0 {
        name = str_slice(callee, sep + 2, str_len(callee));
    }
    val pa: i64 = tc_rx_pattern_arg(name);
    if pa < 0 || args.len() <= pa {
        return;
    }
    // only stdlib/regex.fd's functions: a program may have its own
    var from_regex: bool = false;
    match TypeChecker_get_item_module(self, name) {
        OptString::Some(m) => {
            var base: str = m;
            val ms: i64 = str_rfind(m, "::");
            if ms >= 0 {
                base = str_slice(m, ms + 2, str_len(m));
            }
            from_regex = base == "regex";
        }
        OptString::None => {
        }
    }
    if !from_regex {
        return;
    }
    match args.get(pa) {
        Expr::StringLit(pat) => {
            if tc_rx_compile_ok(pat) {
                return;
            }
            val what: str = "the pattern \"" + pat + "\" given to " + name + "() is not a valid regular expression: " + g_tc_rx_why;
            if name == "regex_compile" {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + what + ".\n    Fix: correct the pattern (escape a literal '(' ')' '[' '*' '+' '?' '|' with '\\\\'), or build it at run time if it is meant to be rejected.");
            } else {
                self.warnings.push("line " + int_to_str(self.current_line) + ": " + what + "; " + name + "() treats it as matching nothing.\n    Fix: correct the pattern (escape a literal '(' ')' '[' '*' '+' '?' '|' with '\\\\').");
            }
        }
        _ => {
        }
    }
}

// --- Blocking calls in tasks (CA10) --------------------------------------

/// The functions started as green tasks (p_co_go, task_go, task_scope_go,
/// task_timeout, async_spawn with a string literal name), as the checker
/// meets the calls. Read and cleared by TypeChecker_lint_blocking_in_tasks.
var g_tc_task_entries: Vec<str> = Vec::new();

/// Which argument of a task-starting call names the function, or -1.
fn tc_task_entry_arg(callee: str) -> i64 {
    if callee == "p_co_go" || callee == "task_go" || callee == "task_timeout" {
        return 0;
    }
    if callee == "task_scope_go" || callee == "async_spawn" {
        return 1;
    }
    return -1;
}

/// CA10: a call that blocks the OS thread it runs on instead of parking
/// the task (the runtime routes file I/O, DNS and sockets through the
/// poller or the blocking pool; these it does not). Returns the fix to
/// suggest, or "" when the call does not block a worker.
pub fn tc_blocking_call_fix(c: str) -> str {
    if c == "p_sleep" || c == "p_usleep" || c == "Sleep" || c == "usleep" || c == "nanosleep" {
        return "use task_sleep(ms): the worker runs other tasks meanwhile.";
    }
    if c == "p_chan_recv" || c == "p_chan_send" {
        return "use task_recv_cancellable, or p_chan_try_recv/p_chan_try_send with task_yield(), or run the call on the blocking pool with task_pool_call.";
    }
    if c == "p_thread_join" || c == "p_mutex_lock" || c == "p_executor_block_on" || c == "p_read_line" || c == "p_read_stdin" || c == "p_process_run" || c == "p_system" || c == "WaitForSingleObject" {
        return "run it on the blocking pool: move the call into its own function and call task_pool_call(\"<that function>\", nargs, args).";
    }
    return "";
}

/// CA10 (complaint-roadmap): warn when code a green task runs (its entry
/// function and every function that reaches) makes a call that blocks the
/// worker thread. A call run through task_pool_call names its function as
/// a string, so it is not followed: pool-wrapped calls do not warn.
pub fn TypeChecker_lint_blocking_in_tasks(self: &mut TypeChecker, program: Program) {
    if g_tc_task_entries.len() == 0 {
        return;
    }
    var entries: Vec<str> = g_tc_task_entries;
    g_tc_task_entries = Vec::new();
    var fn_at: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        HashMap_insert(fn_at, program.funcs.get(fi).name, fi + 1);
        fi = fi + 1;
    }
    var reported: i64 = HashMap_new();
    var ei: i64 = 0;
    while ei < entries.len() {
        var entry: str = entries.get(ei);
        if HashMap_get(fn_at, entry) != 0 && HashMap_get(reported, "@" + entry) == 0 {
            HashMap_insert(reported, "@" + entry, 1);
            var seen: i64 = HashMap_new();
            var work: Vec<str> = Vec::new();
            work.push(entry);
            HashMap_insert(seen, entry, 1);
            var wi: i64 = 0;
            while wi < work.len() && wi < 4096 {
                var fname: str = work.get(wi);
                var calls: Vec<str> = Vec::new();
                scan_stmts_for_calls(program.funcs.get(HashMap_get(fn_at, fname) - 1).body, &mut calls);
                var ci: i64 = 0;
                while ci < calls.len() {
                    var c: str = calls.get(ci);
                    var at: i64 = HashMap_get(fn_at, c);
                    var fix: str = tc_blocking_call_fix(c);
                    var has_body: bool = at != 0 && program.funcs.get(at - 1).body.len() > 0;
                    if fix != "" && !has_body {
                        var key: str = entry + "|" + c;
                        if HashMap_get(reported, key) == 0 {
                            HashMap_insert(reported, key, 1);
                            var via: str = "";
                            if fname != entry {
                                via = " (in '" + fname + "', which it calls)";
                            }
                            self.warnings.push("task '" + entry + "' calls '" + c + "'" + via + ", which blocks the worker thread the task runs on: the other tasks on that worker wait too.\n    Fix: " + fix);
                        }
                    } else if has_body && HashMap_get(seen, c) == 0 {
                        HashMap_insert(seen, c, 1);
                        work.push(c);
                    }
                    ci = ci + 1;
                }
                wi = wi + 1;
            }
            HashMap_drop(seen);
        }
        ei = ei + 1;
    }
    HashMap_drop(fn_at);
    HashMap_drop(reported);
}

// --- Type-safe function values (roadmap L6C) -----------------------------

/// The arguments of a call through a function value (a parameter or
/// variable of type fn(..)): each one must fit its parameter, as for a
/// call of a named function. Before, only the count was checked.
fn TypeChecker_check_fn_value_args(self: &mut TypeChecker, callee: str, params: Vec<Type>, arg_types: Vec<Type>) {
    var i: i64 = 0;
    while i < params.len() && i < arg_types.len() {
        var raw: Type = params.get(i);
        var arg: Type = arg_types.get(i);
        var skip: bool = TypeChecker_type_contains_param(self, raw) || is_single_upper_name(raw) || TypeChecker_is_reported(self, arg);
        match raw {
            Type::Infer => {
                skip = true;
            }
            Type::Never => {
                skip = true;
            }
            _ => {
            }
        }
        match arg {
            Type::Infer => {
                skip = true;
            }
            Type::Never => {
                skip = true;
            }
            _ => {
            }
        }
        if !skip {
            var param: Type = TypeChecker_resolve_type(self, raw);
            if !TypeChecker_arg_compatible(self, param, arg) {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): function value '" + callee + "' parameter " + int_to_str(i + 1) + " expects '" + type_to_str(param) + "', got '" + type_to_str(arg) + "'");
            }
        }
        i = i + 1;
    }
}

/// A type a C function can take or return through a looked-up symbol.
fn tc_c_abi_type(t: Type) -> bool {
    match t {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::I64 => {
            return true;
        }
        Type::U8 => {
            return true;
        }
        Type::U16 => {
            return true;
        }
        Type::U32 => {
            return true;
        }
        Type::U64 => {
            return true;
        }
        Type::F32 => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        Type::Str => {
            return true;
        }
        Type::Void => {
            return true;
        }
        Type::RawPtr(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// roadmap L6C: `val f: fn(f64) -> f64 = p_dl_sym(lib, "sqrt");` gives the
/// looked-up symbol that function type, so each call through `f` has its
/// arguments checked. Its parameters and result must be C types.
/// `callee` is p_dl_sym (handle from p_dl_open) or p_dl_find (the OS
/// loader's handle from p_dl_load); lower.fd Lowerer_dl_fn_let_type makes
/// such a binding a C function pointer, called without an env.
fn TypeChecker_check_dl_sym(self: &mut TypeChecker, callee: str, arg_types: Vec<Type>, hint: Type) -> Type {
    var opener: str = "p_dl_open";
    if callee == "p_dl_find" {
        opener = "p_dl_load";
    }
    if arg_types.len() != 2 {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + callee + " expects 2 args (a library handle and a symbol name), got " + int_to_str(arg_types.len()));
        return Type::I64;
    }
    if !TypeChecker_is_integer(self, arg_types.get(0)) && !TypeChecker_is_reported(self, arg_types.get(0)) {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + callee + " parameter 1 expects a library handle (i64 from " + opener + "), got '" + type_to_str(arg_types.get(0)) + "'");
    }
    if !tc_is_str(arg_types.get(1)) && !TypeChecker_is_reported(self, arg_types.get(1)) {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + callee + " parameter 2 expects the symbol name (str), got '" + type_to_str(arg_types.get(1)) + "'");
    }
    match TypeChecker_resolve_type(self, hint) {
        Type::Func(fparams, fret) => {
            var pi: i64 = 0;
            while pi < fparams.len() {
                var pt: Type = TypeChecker_resolve_type(self, fparams.get(pi));
                if !tc_c_abi_type(pt) {
                    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): a symbol looked up with " + callee + " is a C function: its parameter " + int_to_str(pi + 1) + " cannot be '" + type_to_str(pt) + "'.\n    Fix: use integer, float, bool, str or raw pointer types.");
                }
                pi = pi + 1;
            }
            var rt: Type = TypeChecker_resolve_type(self, box_type_unbox(fret));
            if !tc_c_abi_type(rt) {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): a symbol looked up with " + callee + " is a C function: it cannot return '" + type_to_str(rt) + "'.\n    Fix: use an integer, float, bool, str, raw pointer or void result.");
            }
            return Type::Func(fparams, fret);
        }
        _ => {
        }
    }
    return Type::I64;
}

// --- check_capability ----------------------------------------------------

pub fn TypeChecker_check_capability(self: &mut TypeChecker, cap: str, context: str) {
    if self.sandbox_depth > 0 {
        self.errors.push("Sandbox error: '" + context + "' requires '" + cap + "' capability -- all capabilities are revoked inside sandbox");
        match self.current_func_name {
            OptString::Some(fname) => {
                var ci: i64 = 0;
                while ci < self.cap_verified.len() {
                    if self.cap_verified.get(ci) == fname {
                        self.cap_verified.remove(ci);
                        ci = self.cap_verified.len();
                    }
                    ci = ci + 1;
                }
            }
            OptString::None => {
            }
        }
        return;
    }
    if self.current_module == "core" {
        return;
    }
    if self.strict_caps && !tc_str_vec_contains(self.granted_caps, cap) {
        self.errors.push("Capability error: '" + context + "' requires '" + cap + "' capability (not granted to module '" + self.current_module + "')");
        match self.current_func_name {
            OptString::Some(fname) => {
                var ci2: i64 = 0;
                while ci2 < self.cap_verified.len() {
                    if self.cap_verified.get(ci2) == fname {
                        self.cap_verified.remove(ci2);
                        ci2 = self.cap_verified.len();
                    }
                    ci2 = ci2 + 1;
                }
            }
            OptString::None => {
            }
        }
    }
}

// --- check_visibility ----------------------------------------------------

pub fn TypeChecker_check_visibility(self: &mut TypeChecker, name: str) {
    // Check if the item is defined in a different module
    match TypeChecker_get_item_module(self, name) {
        OptString::Some(item_module) => {
            if item_module != self.current_module {
                // Cross-module access: check if item is pub
                var is_pub: bool = TypeChecker_get_item_visibility(self, name);
                if !is_pub {
                    self.errors.push("Visibility error: '" + name + "' is private to module '" + item_module + "' (not accessible from '" + self.current_module + "')");
                }
            }
        }
        OptString::None => {
        }
    }
}

// --- collect_capabilities ------------------------------------------------

/// stdlib-agent-bugs 1: a method `m` of `T` is compiled as the function
/// `T_m`, so a free function of that name in the same program was silently
/// replaced by the method (or the method by it). Reported instead. Checked
/// on the program being compiled (collect_capabilities runs on it): the
/// identical duplicates that modules already have (parser.fd `Parser_new`
/// and `Parser::new`, math.fd `vec3_sub` and `vec3.sub`) are left alone.
fn TypeChecker_check_fn_method_clash(self: &mut TypeChecker, program: Program) {
    if program.impls.len() == 0 && program.trait_impls.len() == 0 {
        return;
    }
    var free_names: i64 = HashMap_new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        HashMap_insert(free_names, program.funcs.get(i).name, 1);
        i = i + 1;
    }
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var mname: str = imp.methods.get(mi).name;
            var mangled: str = imp.struct_name + "_" + mname;
            if HashMap_contains(free_names, mangled) {
                self.errors.push("Type error: function '" + mangled + "' has the name of method '" + imp.struct_name + "." + mname + "' (a method of " + imp.struct_name + " is compiled as the function " + mangled + "): one would replace the other.\n    Fix: rename the function, or make it the method.");
            }
            mi = mi + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var tmi: i64 = 0;
        while tmi < ti.methods.len() {
            var tname: str = ti.methods.get(tmi).name;
            var tmangled: str = ti.type_name + "_" + tname;
            if HashMap_contains(free_names, tmangled) {
                self.errors.push("Type error: function '" + tmangled + "' has the name of method '" + ti.type_name + "." + tname + "' (a method of " + ti.type_name + " is compiled as the function " + tmangled + "): one would replace the other.\n    Fix: rename the function, or make it the method.");
            }
            tmi = tmi + 1;
        }
        i = i + 1;
    }
    HashMap_drop(free_names);
}

pub fn TypeChecker_collect_capabilities(self: &mut TypeChecker, program: Program) {
    TypeChecker_check_fn_method_clash(self, program);
    var i: i64 = 0;
    while i < program.imports.len() {
        var imp: ImportDef = program.imports.get(i);
        if imp.capabilities.len() > 0 {
            self.strict_caps = true;
            var j: i64 = 0;
            while j < imp.capabilities.len() {
                self.granted_caps.push(imp.capabilities.get(j));
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

// --- Linear type checks --------------------------------------------------

pub fn TypeChecker_is_linear_type(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::Named(name) => {
            return tc_str_vec_contains(self.linear_structs, name);
        }
        Type::Generic(name, _) => {
            return tc_str_vec_contains(self.linear_structs, name);
        }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if TypeChecker_is_linear_type(self, types.get(i)) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        Type::Array(elem, _) => {
            return TypeChecker_is_linear_type(self, box_type_unbox(elem));
        }
        Type::ArrayConst(elem, _) => {
            return TypeChecker_is_linear_type(self, box_type_unbox(elem));
        }
        Type::Ref(inner, _) => {
            return TypeChecker_is_linear_type(self, box_type_unbox(inner));
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// Result type of a swizzle (src/typechecker.rs swizzle_result_type):
/// 2-4 components, all from one of xyzw / rgba / stpq.
fn tc_str_has_byte(chars: str, ch: i64) -> bool {
    var i: i64 = 0;
    while i < str_len(chars) {
        if str_byte_at(chars, i) == ch {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn tc_swizzle_result_type(field: str) -> OptType {
    var n: i64 = str_len(field);
    if n <= 1 || n > 4 {
        return OptType::None;
    }
    var xyzw: str = "xyzw";
    var rgba: str = "rgba";
    var stpq: str = "stpq";
    var group: str = "";
    var first: i64 = str_byte_at(field, 0);
    if tc_str_has_byte(xyzw, first) {
        group = xyzw;
    } else if tc_str_has_byte(rgba, first) {
        group = rgba;
    } else if tc_str_has_byte(stpq, first) {
        group = stpq;
    } else {
        return OptType::None;
    }
    var i: i64 = 0;
    while i < n {
        if !tc_str_has_byte(group, str_byte_at(field, i)) {
            return OptType::None;
        }
        i = i + 1;
    }
    if n == 2 {
        return OptType::Some(Type::Named("vec2"));
    }
    if n == 3 {
        return OptType::Some(Type::Named("vec3"));
    }
    return OptType::Some(Type::Named("vec4"));
}

pub fn tc_is_vec_type(name: str) -> bool {
    return name == "vec2" || name == "vec3" || name == "vec4";
}

/// Types made to be shared between threads (their operations synchronize).
fn tc_is_sync_handle(name: str) -> bool {
    return name == "Channel" || name == "Mutex" || name == "Future" || name == "Arc" || name == "RwLock" || name == "AtomicI64" || name == "AtomicBool" || name == "Atomic";
}

/// `ty` holds something with an owner count (a string, Vec, HashMap or
/// Box, also inside a struct, enum or tuple).
fn TypeChecker_has_owned(self: &TypeChecker, ty: Type, depth: i64) -> bool {
    if depth > 16 {
        return false;
    }
    match ty {
        Type::Str => {
            return true;
        }
        Type::Generic(name, args) => {
            if name == "Vec" || name == "HashMap" || name == "Box" || name == "String" {
                return true;
            }
            if tc_is_sync_handle(name) {
                return false;
            }
            var i: i64 = 0;
            while i < args.len() {
                if TypeChecker_has_owned(self, args.get(i), depth + 1) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        Type::Named(name) => {
            if name == "Vec" || name == "HashMap" || name == "String" || name == "StringBuilder" {
                return true;
            }
            if tc_is_sync_handle(name) {
                return false;
            }
            match TypeChecker_lookup_struct_cache(self, name) {
                OptVecStructField::Some(fields) => {
                    var fi: i64 = 0;
                    while fi < fields.len() {
                        if TypeChecker_has_owned(self, fields.get(fi).ty, depth + 1) {
                            return true;
                        }
                        fi = fi + 1;
                    }
                    return false;
                }
                OptVecStructField::None => {
                }
            }
            var ei: i64 = 0;
            while ei < self.enum_variants.len() {
                if self.enum_variants.get(ei).key == name {
                    var vs: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
                    var vi: i64 = 0;
                    while vi < vs.len() {
                        var pts: Vec<Type> = vs.get(vi).payload_types;
                        var pi: i64 = 0;
                        while pi < pts.len() {
                            if TypeChecker_has_owned(self, pts.get(pi), depth + 1) {
                                return true;
                            }
                            pi = pi + 1;
                        }
                        vi = vi + 1;
                    }
                    return false;
                }
                ei = ei + 1;
            }
            return false;
        }
        Type::Tuple(types) => {
            var ti: i64 = 0;
            while ti < types.len() {
                if TypeChecker_has_owned(self, types.get(ti), depth + 1) {
                    return true;
                }
                ti = ti + 1;
            }
            return false;
        }
        Type::Array(elem, _) => {
            return TypeChecker_has_owned(self, box_type_unbox(elem), depth + 1);
        }
        Type::ArrayConst(elem, _) => {
            return TypeChecker_has_owned(self, box_type_unbox(elem), depth + 1);
        }
        _ => {
        }
    }
    return false;
}

/// "" when a value of `ty` can be handed to a spawned thread: it is then
/// copied whole for the thread (core p_send_copy), so the two threads share
/// nothing. Otherwise why not. A string, a Vec or HashMap whose elements
/// are such values, or a value with no owned part at all can be copied;
/// a Box, or a struct, enum or tuple that holds owned parts, cannot.
fn TypeChecker_thread_copy_err(self: &TypeChecker, ty: Type, depth: i64) -> str {
    if depth > 16 {
        return "";
    }
    match ty {
        Type::Str => {
            return "";
        }
        Type::Generic(name, args) => {
            if tc_is_sync_handle(name) {
                return "";
            }
            if name == "Vec" && args.len() == 1 {
                return TypeChecker_thread_copy_err(self, args.get(0), depth + 1);
            }
            if name == "HashMap" && args.len() == 2 {
                var ke: str = TypeChecker_thread_copy_err(self, args.get(0), depth + 1);
                if ke != "" {
                    return ke;
                }
                return TypeChecker_thread_copy_err(self, args.get(1), depth + 1);
            }
            if name == "Box" {
                return "a Box is shared by its copies";
            }
        }
        Type::Named(name) => {
            if tc_is_sync_handle(name) {
                return "";
            }
            if name == "Vec" || name == "HashMap" {
                return "";
            }
        }
        _ => {
        }
    }
    if TypeChecker_has_owned(self, ty, 0) {
        return type_to_str(ty) + " holds strings or collections inside a struct, enum or tuple, which are shared by its copies";
    }
    return "";
}

pub fn TypeChecker_is_send_type(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::I64 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::I8 => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        Type::F32 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        Type::Str => {
            return true;
        }
        Type::Void => {
            return true;
        }
        Type::Never => {
            return true;
        }
        Type::Named(name) => {
            if tc_str_vec_contains(self.send_structs, name) {
                return true;
            }
            // A @scoped struct borrows strings freed when its scope ends (M11)
            if str_vec_contains(self.scoped_structs, name) {
                return false;
            }
            // A struct whose fields are all @send is @send itself (release
            // H4): it is copied to the other thread, and nothing in it is
            // shared. An enum carries values the same way: BG188, it is
            // @send when every variant's payload is (it was any enum).
            if tc_str_vec_contains(self.enums, name) {
                var no_args: Vec<Type> = Vec::new();
                return TypeChecker_enum_is_send(self, name, no_args);
            }
            match TypeChecker_lookup_struct_cache(self, name) {
                OptVecStructField::Some(fields) => {
                    // BG188: a struct reached again through its own fields
                    // (`next: Option<Box<Node>>`) is @send if the rest is
                    if tc_str_vec_contains(g_tc_send_visiting, name) {
                        return true;
                    }
                    g_tc_send_visiting.push(name);
                    var fi: i64 = 0;
                    while fi < fields.len() {
                        var fty: Type = fields.get(fi).ty;
                        var direct_self: bool = false;
                        match fty {
                            Type::Named(fname) => {
                                direct_self = fname == name;
                            }
                            _ => {
                            }
                        }
                        if !direct_self && !TypeChecker_is_send_type(self, fty) {
                            g_tc_send_visiting.pop();
                            return false;
                        }
                        fi = fi + 1;
                    }
                    g_tc_send_visiting.pop();
                    return true;
                }
                OptVecStructField::None => {
                }
            }
            return false;
        }
        Type::Generic(name, args) => {
            if tc_str_vec_contains(self.send_structs, name) {
                return true;
            }
            if name == "Vec" || name == "HashMap" || name == "String" || name == "Channel" || name == "Mutex" || name == "Future" || name == "Option" || name == "Result" || name == "Box" {
                var i: i64 = 0;
                while i < args.len() {
                    if !TypeChecker_is_send_type(self, args.get(i)) {
                        return false;
                    }
                    i = i + 1;
                }
                return true;
            }
            // BG188: a user generic enum, its payloads with the type
            // arguments put in; BG220: a generic struct whose fields are
            // all @send (with them put in) is @send, as a plain one is
            if tc_str_vec_contains(self.enums, name) {
                return TypeChecker_enum_is_send(self, name, args);
            }
            if !str_vec_contains(self.scoped_structs, name) {
                match TypeChecker_lookup_struct_cache(self, name) {
                    OptVecStructField::Some(gfields) => {
                        if tc_str_vec_contains(g_tc_send_visiting, name) {
                            return true;
                        }
                        var gtps: Vec<str> = TypeChecker_struct_type_params(self, name);
                        g_tc_send_visiting.push(name);
                        var gok: bool = true;
                        var gfi: i64 = 0;
                        while gfi < gfields.len() && gok {
                            if !TypeChecker_is_send_type(self, tc_subst_type_params(gfields.get(gfi).ty, gtps, args)) {
                                gok = false;
                            }
                            gfi = gfi + 1;
                        }
                        g_tc_send_visiting.pop();
                        return gok;
                    }
                    OptVecStructField::None => {
                    }
                }
            }
            return false;
        }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if !TypeChecker_is_send_type(self, types.get(i)) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        Type::Array(elem, _) => {
            return TypeChecker_is_send_type(self, box_type_unbox(elem));
        }
        Type::ArrayConst(elem, _) => {
            return TypeChecker_is_send_type(self, box_type_unbox(elem));
        }
        Type::Ref(_, _) => {
            return false;
        }
        Type::RawPtr(_, _) => {
            return false;
        }
        // BG75: a trait object points at its value's data, which the two
        // threads would share (the `_` below counted it as @send)
        Type::Dyn(_) => {
            return false;
        }
        // BG75: a `fn` value may be a closure whose captured state the two
        // threads would share; only a closure literal's captures are
        // checked directly (TypeChecker_check_spawn_closure)
        Type::Func(_, _) => {
            return false;
        }
        Type::Infer => {
            return true;
        }
        _ => {
            return true;
        }
    }
    return true;
}

/// BG188: the enums and generic structs whose @send check is under way
/// (a recursive type, `enum L { Cons(i64, Box<L>), Nil }`, is @send when
/// the rest of it is).
var g_tc_send_visiting: Vec<str> = Vec::new();

/// BG188: enum `name` is @send when every variant's payload is, with the
/// enum's type parameters replaced by `args`. A payload naming a type
/// parameter `args` does not give (a bare `Option`) is not known: it is
/// taken as @send, as before.
fn TypeChecker_enum_is_send(self: &TypeChecker, name: str, args: Vec<Type>) -> bool {
    if tc_str_vec_contains(g_tc_send_visiting, name) {
        return true;
    }
    var tps: Vec<str> = TypeChecker_enum_params_of(self, name);
    var bound: Vec<str> = Vec::new();
    var bound_tys: Vec<Type> = Vec::new();
    var ti: i64 = 0;
    while ti < tps.len() && ti < args.len() {
        bound.push(tps.get(ti));
        bound_tys.push(args.get(ti));
        ti = ti + 1;
    }
    var unbound: Vec<str> = Vec::new();
    while ti < tps.len() {
        unbound.push(tps.get(ti));
        ti = ti + 1;
    }
    var ok: bool = true;
    g_tc_send_visiting.push(name);
    var ei: i64 = 0;
    while ei < self.enum_variants.len() && ok {
        if self.enum_variants.get(ei).key == name {
            var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
            var vi: i64 = 0;
            while vi < variants.len() && ok {
                var payload: Vec<Type> = variants.get(vi).payload_types;
                var pi: i64 = 0;
                while pi < payload.len() && ok {
                    var pt: Type = payload.get(pi);
                    if unbound.len() == 0 || !type_mentions_any(pt, unbound) {
                        if !TypeChecker_is_send_type(self, tc_subst_type_params(pt, bound, bound_tys)) {
                            ok = false;
                        }
                    }
                    pi = pi + 1;
                }
                vi = vi + 1;
            }
            ei = self.enum_variants.len();
        }
        ei = ei + 1;
    }
    g_tc_send_visiting.pop();
    return ok;
}

pub fn TypeChecker_is_sync_type(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::I64 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::I8 => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        Type::F32 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        Type::Str => {
            return true;
        }
        Type::Void => {
            return true;
        }
        Type::Never => {
            return true;
        }
        Type::Named(name) => {
            return tc_str_vec_contains(self.sync_structs, name);
        }
        Type::Generic(name, args) => {
            if tc_str_vec_contains(self.sync_structs, name) {
                return true;
            }
            if name == "Mutex" || name == "Channel" {
                return true;
            }
            if name == "Vec" || name == "HashMap" || name == "String" || name == "Option" || name == "Result" || name == "Future" {
                var i: i64 = 0;
                while i < args.len() {
                    if !TypeChecker_is_sync_type(self, args.get(i)) {
                        return false;
                    }
                    i = i + 1;
                }
                return true;
            }
            return false;
        }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if !TypeChecker_is_sync_type(self, types.get(i)) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        Type::Array(elem, _) => {
            return TypeChecker_is_sync_type(self, box_type_unbox(elem));
        }
        Type::ArrayConst(elem, _) => {
            return TypeChecker_is_sync_type(self, box_type_unbox(elem));
        }
        Type::Ref(inner, is_mut) => {
            if !is_mut {
                return TypeChecker_is_sync_type(self, box_type_unbox(inner));
            }
            return false;
        }
        Type::RawPtr(_, _) => {
            return false;
        }
        Type::Infer => {
            return true;
        }
        _ => {
            return true;
        }
    }
    return true;
}

// --- consume_var ---------------------------------------------------------

pub fn TypeChecker_consume_var(self: &mut TypeChecker, name: str, line: i64) {
    if self.loop_depth > 0 {
        self.errors.push("Linear type error (line " + int_to_str(line) + "): variable '" + name + "' cannot be consumed inside a loop." + "\n    Linear values can only be used once — consuming them inside a loop\n    would fail on the second iteration. Move the consumption outside" + "\n    the loop, or use a non-linear type.");
    }
    // A path `a.f` (a linear field moved out): `a` itself, or the path,
    // may not have been moved already; moving `a` after one of its fields
    // would use the moved field again.
    var moved_before: bool = tc_str_vec_contains(self.consumed_vars, name);
    var ci: i64 = 0;
    while ci < self.consumed_vars.len() && !moved_before {
        var prev: str = self.consumed_vars.get(ci);
        if str_starts_with(name, prev + ".") || str_starts_with(prev, name + ".") {
            moved_before = true;
        }
        ci = ci + 1;
    }
    if moved_before {
        self.errors.push("Linear type error (line " + int_to_str(line) + "): variable '" + name + "' was already consumed (moved), or a part of it was." + "\n    Linear values can only be used once. After being passed to a function,\n    returned, or moved, they cannot be used again." + "\n    Fix: use a different variable, or restructure the code so '" + name + "' is only used once.");
    } else {
        self.consumed_vars.push(name);
    }
}

/// "a.b.c" for a chain of field reads on a variable, or "".
fn tc_field_path(e: Expr) -> str {
    match e {
        Expr::Ident(n) => {
            return n;
        }
        Expr::FieldAccess(x, f) => {
            var base: str = tc_field_path(box_expr_unbox(x));
            if base == "" {
                return "";
            }
            return base + "." + f;
        }
        _ => {
        }
    }
    return "";
}

/// A linear value `path` of type `ty` counts as consumed when it was moved
/// whole, or when it is a struct with linear fields and each of them was
/// moved (a struct with no linear field must be moved whole).
fn TypeChecker_linear_fields_moved(self: &TypeChecker, path: str, ty: Type) -> bool {
    if tc_str_vec_contains(self.consumed_vars, path) {
        return true;
    }
    var sname: str = "";
    match ty {
        Type::Named(n) => {
            sname = n;
        }
        Type::Generic(n, _) => {
            sname = n;
        }
        _ => {
        }
    }
    if sname == "" {
        return false;
    }
    var any: bool = false;
    match TypeChecker_lookup_struct_cache(self, sname) {
        OptVecStructField::Some(fields) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                var fty: Type = fields.get(fi).ty;
                if TypeChecker_is_linear_type(self, fty) {
                    any = true;
                    if !TypeChecker_linear_fields_moved(self, path + "." + fields.get(fi).name, fty) {
                        return false;
                    }
                }
                fi = fi + 1;
            }
        }
        OptVecStructField::None => {
        }
    }
    return any;
}

// --- consume_linear_in_expr ----------------------------------------------

pub fn TypeChecker_consume_linear_in_expr(self: &mut TypeChecker, expr: Expr, line: i64) {
    match expr {
        Expr::FieldAccess(_, _) => {
            // Moving a linear field out (`acc.balance`) consumes that path.
            // Reading a plain field (`acc.id`) moves nothing.
            var path: str = tc_field_path(expr);
            if path != "" {
                var saved_errs: i64 = self.errors.len();
                var fty: Type = TypeChecker_check_expr(self, expr);
                self.errors.truncate(saved_errs);
                if TypeChecker_is_linear_type(self, fty) {
                    var by_ref: bool = false;
                    match fty {
                        Type::Ref(_, _) => {
                            by_ref = true;
                        }
                        _ => {
                        }
                    }
                    if !by_ref {
                        TypeChecker_consume_var(self, path, line);
                    }
                }
            }
        }
        Expr::Ident(name) => {
            var lk: OptType = TypeChecker_lookup(self, name);
            match lk {
                OptType::Some(ty) => {
                    if TypeChecker_is_linear_type(self, ty) {
                        TypeChecker_consume_var(self, name, line);
                    }
                }
                OptType::None => {
                }
            }
        }
        Expr::Binary(_, left, right) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(left), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(right), line);
        }
        Expr::Unary(_, e) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        Expr::Call(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_consume_linear_in_expr(self, args.get(i), line);
                i = i + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(receiver), line);
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_consume_linear_in_expr(self, args.get(i), line);
                i = i + 1;
            }
        }
        Expr::StructLit(_, fields, spread) => {
            var i: i64 = 0;
            while i < fields.len() {
                TypeChecker_consume_linear_in_expr(self, fields.get(i).value, line);
                i = i + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => {
                    TypeChecker_consume_linear_in_expr(self, box_expr_unbox(s), line);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_consume_linear_in_expr(self, elements.get(i), line);
                i = i + 1;
            }
        }
        Expr::TupleLit(elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_consume_linear_in_expr(self, elements.get(i), line);
                i = i + 1;
            }
        }
        Expr::Deref(e) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        Expr::Cast(e, _) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        Expr::Coalesce(e, d) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(d), line);
        }
        Expr::Try(e) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        Expr::StrConcat(l, r) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(l), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(r), line);
        }
        Expr::Range(s, e, _) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(s), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        // BG186: an enum literal's payload, an f-string's parts, a spawned
        // or awaited call, a piped value and a named argument move what
        // they hold, as a call's arguments do. (An if/match/block value's
        // branches are consumed while they are checked, and joined there.)
        Expr::EnumLit(_, _, eargs) => {
            var i: i64 = 0;
            while i < eargs.len() {
                TypeChecker_consume_linear_in_expr(self, eargs.get(i), line);
                i = i + 1;
            }
        }
        Expr::FString(fparts) => {
            var i: i64 = 0;
            while i < fparts.len() {
                match fparts.get(i) {
                    FStringPart::Expr(fe) => {
                        TypeChecker_consume_linear_in_expr(self, fe, line);
                    }
                    _ => {
                    }
                }
                i = i + 1;
            }
        }
        Expr::Spawn(e) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        Expr::Await(e) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        Expr::Yield(e) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        Expr::NamedArg(_, e) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        Expr::PipeForward(l, r) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(l), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(r), line);
        }
        Expr::Closure(params, body, _) => {
            // A closure can be called any number of times, so it must not
            // capture a linear value (each call could use it again).
            var used: Vec<str> = Vec::new();
            esc_idents_stmts(body, &mut used);
            var captured: Vec<str> = Vec::new();
            var ui: i64 = 0;
            while ui < used.len() {
                var name: str = used.get(ui);
                var is_param: bool = false;
                var pi: i64 = 0;
                while pi < params.len() {
                    if params.get(pi).name == name {
                        is_param = true;
                    }
                    pi = pi + 1;
                }
                if !is_param {
                    match TypeChecker_lookup(self, name) {
                        OptType::Some(t) => {
                            if TypeChecker_is_linear_type(self, t) {
                                captured = tc_insert_sorted(captured, name);
                            }
                        }
                        OptType::None => {
                        }
                    }
                }
                ui = ui + 1;
            }
            var ci: i64 = 0;
            while ci < captured.len() {
                var cn: str = captured.get(ci);
                self.errors.push("Linear type error (line " + int_to_str(line) + "): a closure captures linear variable '" + cn + "'.
    A closure can be called more than once, so it could use '" + cn + "' twice.
    Fix: pass '" + cn + "' to the closure as an argument instead.");
                ci = ci + 1;
            }
        }
        _ => {
        }
    }
}

// BG186: a type whose value holds a linear value: a linear struct (not a
// reference to one), or an Option / Result / tuple of one.
fn TypeChecker_holds_linear(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::Ref(_, _) => {
            return false;
        }
        Type::RawPtr(_, _) => {
            return false;
        }
        Type::Generic(gn, gargs) => {
            if gn == "Option" || gn == "Result" {
                var i: i64 = 0;
                while i < gargs.len() {
                    if TypeChecker_holds_linear(self, gargs.get(i)) {
                        return true;
                    }
                    i = i + 1;
                }
                return false;
            }
        }
        _ => {
        }
    }
    return TypeChecker_is_linear_type(self, ty);
}

// BG186: an expression statement whose value holds a linear value throws
// it away (`mk();`, `id(t);`, `Option::Some(t);`): the value is lost. (A
// function's last expression is its value: one of the type the function
// returns is not counted.)
fn TypeChecker_linear_check_discard(self: &mut TypeChecker, ty: Type, line: i64) {
    if !TypeChecker_holds_linear(self, ty) {
        return;
    }
    match self.current_ret_ty {
        OptType::Some(rt) => {
            if TypeChecker_types_compatible(self, TypeChecker_resolve_self_type(self, rt), ty) {
                return;
            }
        }
        OptType::None => {
            return;
        }
    }
    self.errors.push("Linear type error (line " + int_to_str(line) + "): the result of this expression (" + type_to_str(ty) + ") holds a linear value and is thrown away.\n    Linear values must be used exactly once: a discarded one is lost.\n    Fix: bind it (`val x = ...;`) and consume it, or pass it on.");
}

// BG186: `val t = ...` of a linear type when a linear `t` is already
// declared. An earlier `t` still unconsumed would be lost (the new binding
// hides it): an error. Either way the new `t` starts unconsumed: before, a
// consumed earlier `t` made the new one look consumed too, and an
// unconsumed one was dropped silently.
fn TypeChecker_linear_rebind(self: &mut TypeChecker, name: str, line: i64) {
    var si: i64 = g_tc_linear_base;
    if si < 0 {
        si = 0;
    }
    while si < self.scope_linear_vars.len() {
        var lvs: Vec<LinearVar> = self.scope_linear_vars.get(si);
        var i: i64 = 0;
        while i < lvs.len() {
            var lv: LinearVar = lvs.get(i);
            if lv.name == name {
                var done: bool = tc_str_vec_contains(self.consumed_vars, name);
                if !done {
                    match TypeChecker_lookup(self, name) {
                        OptType::Some(lty) => {
                            done = TypeChecker_linear_fields_moved(self, name, lty);
                        }
                        OptType::None => {
                        }
                    }
                }
                if !done {
                    self.errors.push("Linear type error (line " + int_to_str(line) + "): linear variable '" + name + "' (declared on line " + int_to_str(lv.line) + ") is declared again before it was consumed.\n    The new '" + name + "' hides the first one, which is lost.\n    Fix: consume the first '" + name + "' before, or give the new value another name.");
                }
                lvs.remove(i);
                self.scope_linear_vars.set(si, lvs);
                i = lvs.len();
            }
            i = i + 1;
        }
        si = si + 1;
    }
    // the new `t` (and its fields) start unconsumed
    var kept: Vec<str> = Vec::new();
    var ci: i64 = 0;
    while ci < self.consumed_vars.len() {
        var c: str = self.consumed_vars.get(ci);
        if c != name && !str_starts_with(c, name + ".") {
            kept.push(c);
        }
        ci = ci + 1;
    }
    self.consumed_vars = kept;
}

// A new Vec with `s` inserted in byte order (as Rust sorts Strings).
fn tc_insert_sorted(v: Vec<str>, s: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var placed: bool = false;
    var i: i64 = 0;
    while i < v.len() {
        if !placed && str_compare(s, v.get(i)) < 0 {
            out.push(s);
            placed = true;
        }
        out.push(v.get(i));
        i = i + 1;
    }
    if !placed {
        out.push(s);
    }
    return out;
}

// ---- CHUNK_MARKER_6 ----

// --- check_stmt ----------------------------------------------------------

pub fn TypeChecker_check_stmt(self: &mut TypeChecker, stmt: Stmt) {
    // Recursion depth guard -- prevents stack overflow on deeply nested statements
    self.check_depth = self.check_depth + 1;
    if self.check_depth > 512 {
        // TL2: a type error (E079), not a lexer "Error:" (classify_error
        // took that for E004, an unexpected character)
        self.errors.push("Type error: typechecker recursion limit exceeded (512) -- statement too deeply nested.\n    Fix: move the inner blocks into a function of their own.");
        self.check_depth = self.check_depth - 1;
        return;
    }

    var first_err: i64 = self.errors.len();
    TypeChecker_check_stmt_inner(self, stmt);
    tc_add_stmt_line(self, first_err, stmt_line(stmt));
    self.check_depth = self.check_depth - 1;
}

/// Bugs 5/41: an error an expression gave without a place ("Type error:
/// msg", as E079 "cannot dereference non-reference type f64" was) gets the
/// line of the statement it is in: "Type error (line N): msg". Errors from
/// index `from` on; a nested statement has given its own errors its line
/// already, and an error naming a line ("... at line N") keeps it.
/// TL2: so does any other error without a place ("Visibility error: ...",
/// "Thread safety error: ..."), see tc_err_at_line.
fn tc_add_stmt_line(self: &mut TypeChecker, from: i64, line: i64) {
    if line <= 0 {
        return;
    }
    var i: i64 = from;
    while i < self.errors.len() {
        var e: str = self.errors.get(i);
        if !tc_err_has_place(e) {
            self.errors.set(i, tc_err_at_line(e, line));
        }
        i = i + 1;
    }
}

/// TL2: whether an error already says where it is: "(line N)", "at line
/// N", another module's "(module 'm'...)", or a lexer's or parser's
/// "L:C". compiler.fd's enrich_errors draws the caret from "(line N)".
fn tc_err_has_place(e: str) -> bool {
    if str_find(e, "(line ") >= 0 || str_find(e, " line ") >= 0 || str_find(e, "(module '") >= 0 {
        return true;
    }
    return str_starts_with(e, "Parse error") || str_starts_with(e, "Error:");
}

/// TL2: `e` placed at `line`. "Type error: m" becomes "Type error (line
/// N): m" (the form of the other type errors); any other error gets
/// " (line N)" at the end of its first line, so every part of the message
/// a test or a reader looks for stays as it was.
fn tc_err_at_line(e: str, line: i64) -> str {
    if line <= 0 {
        return e;
    }
    if str_starts_with(e, "Type error: ") {
        return "Type error (line " + int_to_str(line) + "): " + str_slice(e, 12, str_len(e));
    }
    var at: str = " (line " + int_to_str(line) + ")";
    var nl: i64 = str_find(e, "\n");
    if nl < 0 {
        return e + at;
    }
    return str_slice(e, 0, nl) + at + str_slice(e, nl, str_len(e));
}

/// TL2: errors from index `from` on that have no place and name a
/// function of the program being compiled get the line of that function's
/// `fn`. The name is the error's first quoted one ("Effect error: function
/// 'f' ...", "Event error: @event 'E' ...", "Conservation error: method
/// 'S::m' ..."), or for an annotation error the one after "on" ("Unknown
/// annotation '@x' on 'f'"). The whole-program checks (effects, safety
/// annotations, @redundant, @event, contracts) report a function, not a
/// statement. Functions of other modules are left out: their lines are
/// lines of another file.
fn tc_place_fn_errors(self: &mut TypeChecker, from: i64, program: Program) {
    if from >= self.errors.len() {
        return;
    }
    var lines: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        val f: Func = program.funcs.get(fi);
        if f.line > 0 && HashMap_contains(self.last_fn_names, f.name) && !HashMap_contains(lines, f.name) {
            HashMap_insert(lines, f.name, f.line);
        }
        fi = fi + 1;
    }
    // methods, as messages write them: 'S.m' and 'S::m'
    var ii: i64 = 0;
    while ii < program.impls.len() {
        val imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            val m: Func = imp.methods.get(mi);
            if m.line > 0 && HashMap_contains(self.last_fn_names, imp.struct_name + "_" + m.name) {
                HashMap_insert(lines, imp.struct_name + "." + m.name, m.line);
                HashMap_insert(lines, imp.struct_name + "::" + m.name, m.line);
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var i: i64 = from;
    while i < self.errors.len() {
        var e: str = self.errors.get(i);
        if !tc_err_has_place(e) {
            var first: str = e;
            var nl: i64 = str_find(e, "\n");
            if nl >= 0 {
                first = str_slice(e, 0, nl);
            }
            var start: i64 = str_find(first, "'");
            if str_starts_with(first, "Unknown annotation") || str_starts_with(first, "Misplaced annotation") {
                start = str_find(first, " on '");
                if start >= 0 {
                    start = start + 4;
                }
            }
            if start >= 0 {
                var rest: str = str_slice(first, start + 1, str_len(first));
                var q2: i64 = str_find(rest, "'");
                if q2 > 0 {
                    var line: i64 = HashMap_get(lines, str_slice(rest, 0, q2));
                    if line > 0 {
                        self.errors.set(i, tc_err_at_line(e, line));
                    }
                }
            }
        }
        i = i + 1;
    }
    HashMap_drop(lines);
}

// --- Assignments through an index or a `*` (BG1, BG2) --------------------

/// BG1: `name[i] = v` and `name[i] op= v`, with `target_ty` the type of
/// `name`. The lowering (lower.fd Lowerer_lower_index_assign_stmt) stores
/// with Vec_set into a Vec and with GetElemPtr + Store into anything else,
/// so this statement once checked only that `name` exists: `p[0] = 7` with
/// p: i64 (or a str, a HashMap, a struct) was a store to an arbitrary
/// address in safe code, and `v[0] = 42` with v: Vec<str> stored a number
/// where the Vec keeps the owner of a string. As the read side
/// (Expr::Index) and reference §4.4/§5.3 say: what is indexed is a Vec or
/// an array (also through a reference), the index is an integer, and the
/// value fits the element type (as a `val x: T = v` checks it). A type not
/// known here (an inferred one, or an error already reported) is not
/// checked further.
fn TypeChecker_check_index_assign(self: &mut TypeChecker, array: str, target_ty: Type, idx_ty: Type, val_ty: Type, line: i64) {
    var t: Type = TypeChecker_resolve_type(self, target_ty);
    match t {
        Type::Ref(rin, _) => {
            t = TypeChecker_resolve_type(self, box_type_unbox(rin));
        }
        _ => {
        }
    }
    var elem: Type = Type::Infer;
    var indexable: bool = false;
    match t {
        Type::Array(ae, _) => {
            elem = box_type_unbox(ae);
            indexable = true;
        }
        Type::ArrayConst(ace, _) => {
            elem = box_type_unbox(ace);
            indexable = true;
        }
        Type::Generic(gn, gargs) => {
            if gn == "Vec" {
                indexable = true;
                if gargs.len() > 0 {
                    elem = gargs.get(0);
                }
            }
        }
        Type::Named(nn) => {
            // a Vec whose element type is not written
            if nn == "Vec" {
                indexable = true;
            }
        }
        Type::Infer => {
            return;
        }
        Type::Never => {
            return;
        }
        _ => {
        }
    }
    if !indexable {
        self.errors.push("Type error (line " + int_to_str(line) + "): cannot index type " + type_to_str(t) + " in the assignment to '" + array + "[..]': only an element of a Vec or of an array can be assigned.\n    Fix: index a Vec or an array; write through a raw pointer with `*p = v` inside `unsafe`.");
        return;
    }
    var it: Type = TypeChecker_resolve_type(self, idx_ty);
    if !TypeChecker_is_integer(self, it) && !type_eq(it, Type::Never) {
        self.errors.push("Type error (line " + int_to_str(line) + "): array index must be an integer, got " + type_to_str(it) + " (in the assignment to '" + array + "[..]').");
    }
    var et: Type = TypeChecker_resolve_self_type(self, elem);
    var vt: Type = TypeChecker_resolve_self_type(self, val_ty);
    if !TypeChecker_types_compatible(self, et, vt) && !(is_runtime_layer(self.current_module) && is_handle_int_pair(et, vt)) {
        self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign " + type_to_str(vt) + " to an element of '" + array + "', whose elements are " + type_to_str(et) + ".\n    Expected: " + type_to_str(et) + "\n    Found:    " + type_to_str(vt));
    }
}

/// BG2: the value of `*r = v` through `r: &mut T` (`pointee` is T) must fit
/// T, as a `val x: T = v` checks it: `*r = "text"` with r: &mut i64 stored a
/// string's address in an integer the caller reads.
fn TypeChecker_check_deref_value(self: &mut TypeChecker, ptr_expr: Expr, pointee: Type, val_ty: Type, line: i64) {
    var pt: Type = TypeChecker_resolve_self_type(self, pointee);
    var vt: Type = TypeChecker_resolve_self_type(self, val_ty);
    if TypeChecker_types_compatible(self, pt, vt) || (is_runtime_layer(self.current_module) && is_handle_int_pair(pt, vt)) {
        return;
    }
    var what: str = tc_place_text(ptr_expr);
    if str_len(what) == 0 {
        what = "a value";
    }
    self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign " + type_to_str(vt) + " to '*" + what + "' of type " + type_to_str(pt) + ".\n    Expected: " + type_to_str(pt) + "\n    Found:    " + type_to_str(vt));
}

/// BG2: `*x = v` where x is neither a raw pointer nor a reference (those two
/// are checked by the statement itself). Before, any such x was accepted and
/// the lowering stored through its value: `var a: i64 = 4096; *a = 5;` wrote
/// to address 4096 in safe code. As the read side (Expr::Deref) says, only a
/// reference, a raw pointer (in `unsafe`) or a Box can be dereferenced; an
/// alias of one of them is resolved first. A type not known here (inferred,
/// or an error already reported) is not checked further.
///
/// One exception: in the compiler's own modules a struct or enum value (one
/// held as a pointer to its data, TypeChecker_shares_repr) is accepted, as
/// before. There a binding of a payload matched through a `&mut` is written
/// in place (comptime_eval.fd aggressive_comptime_stmt: `*else_block =
/// OptStmts::None`); the language does not have that rule for programs.
fn TypeChecker_check_deref_other(self: &mut TypeChecker, ptr_expr: Expr, ptr_ty: Type, val_ty: Type, line: i64) {
    var t: Type = TypeChecker_resolve_type(self, ptr_ty);
    match t {
        Type::RawPtr(_, _) => {
            TypeChecker_require_unsafe(self, "writing through a raw pointer");
            return;
        }
        Type::Ref(rin, rmut) => {
            if rmut {
                TypeChecker_check_deref_value(self, ptr_expr, box_type_unbox(rin), val_ty, line);
            } else {
                // OW1, as the statement says it for a `&T` not behind an alias
                var sn: str = type_to_str(box_type_unbox(rin));
                self.errors.push("Type error (line " + int_to_str(line) + "): cannot change '*" + tc_place_text(ptr_expr) + "' through a shared reference '&" + sn + "' (take '&mut " + sn + "')");
            }
            return;
        }
        Type::Generic(gn, gargs) => {
            if gn == "Box" && gargs.len() == 1 {
                TypeChecker_check_deref_value(self, ptr_expr, gargs.get(0), val_ty, line);
                return;
            }
        }
        Type::Infer => {
            return;
        }
        Type::Never => {
            return;
        }
        _ => {
        }
    }
    if str_starts_with(self.current_module, "compiler") && TypeChecker_shares_repr(self, t) {
        return;
    }
    var what: str = tc_place_text(ptr_expr);
    if str_len(what) == 0 {
        what = "a value";
    }
    self.errors.push("Type error (line " + int_to_str(line) + "): cannot dereference non-reference type " + type_to_str(t) + " to assign to '*" + what + "'.\n    Fix: take a `&mut` to the place and assign through it; write through a raw pointer (`*mut T`) inside `unsafe`.");
}

fn TypeChecker_check_stmt_inner(self: &mut TypeChecker, stmt: Stmt) {
    // Track current line for error messages
    self.current_line = stmt_line(stmt);
    match stmt {
        Stmt::Let(name, ty, expr, is_mut, _, annotations, line) => {
            // `var v = v;` makes a local copy that may be changed
            TypeChecker_forget_value_param(self, name);
            // Bidirectional type inference: pass declared type as hint
            var hint: Type = Type::Never;
            match ty {
                OptType::Some(t) => {
                    hint = t;
                }
                OptType::None => {
                    hint = Type::Never;
                }
            }
            var expr_ty: Type = TypeChecker_check_expr_with_hint(self, expr, hint);
            TypeChecker_consume_linear_in_expr(self, expr, line);
            var final_ty: Type = expr_ty;
            match ty {
                OptType::Some(declared) => {
                    TypeChecker_check_value_fits(self, declared, expr_ty, expr, line);
                    var ce6_never: bool = false;
                    if !TypeChecker_types_compatible(self, declared, expr_ty) && !(is_runtime_layer(self.current_module) && is_handle_int_pair(declared, expr_ty)) {
                        // CE6: an annotation naming no type is that one
                        // error (once per function and name), not also a
                        // mismatch; the variable takes the error's type so
                        // its uses add none
                        val unknown_ty: str = TypeChecker_ce6_unknown_type(self, declared);
                        if str_len(unknown_ty) > 0 {
                            if TypeChecker_first_report(self, "type " + unknown_ty) {
                                self.errors.push("Type error (line " + int_to_str(line) + "): unknown type '" + unknown_ty + "' in the type of variable '" + name + "'.\n    Fix: declare the type, import the module that defines it, or correct its name.");
                            }
                            ce6_never = true;
                        } else {
                            self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign " + type_to_str(expr_ty) + " to variable '" + name + "' of type " + type_to_str(declared) + "." + "\n    Expected: " + type_to_str(declared) + "\n    Found:    " + type_to_str(expr_ty) + "\n    Fix: change the type annotation or the expression.");
                        }
                    }
                    final_ty = declared;
                    if ce6_never {
                        final_ty = Type::Never;
                    }
                }
                OptType::None => {
                    final_ty = expr_ty;
                    // `var i = 0` is an i64: the literal's size says nothing
                    // about what the variable will hold
                    if tc_is_constant_expr(expr) && tc_int_bits(expr_ty) > 0 && tc_int_bits(expr_ty) < 64 {
                        final_ty = Type::I64;
                    }
                }
            }
            // Track val (immutable) bindings. A `var` of the same name is
            // recorded as `!name`: it shadows an outer `val`.
            if self.val_vars_per_scope.len() > 0 {
                var scope: Vec<str> = self.val_vars_per_scope.pop();
                if is_mut {
                    str_vec_remove(&mut scope, name);
                    scope.push("!" + name);
                } else {
                    str_vec_remove(&mut scope, "!" + name);
                    scope.push(name);
                }
                self.val_vars_per_scope.push(scope);
            }
            // Track region: if inside a region block, record the allocation region
            if self.region_stack.len() > 0 {
                var region: str = self.region_stack.get(self.region_stack.len() - 1);
                map_str_str_set(&mut self.var_regions, name, region);
                map_str_str_set(&mut self.var_alloc_lines, name, int_to_str(line));
                var size: i64 = TypeChecker_type_size(self, final_ty);
                if self.region_budgets.len() > 0 {
                    var budget: RegionBudget = self.region_budgets.pop();
                    budget.usage = budget.usage + size;
                    self.region_budgets.push(budget);
                }
            }
            // Track linear variables
            if TypeChecker_is_linear_type(self, final_ty) {
                // BG186: a second `val t` while the first is unconsumed
                TypeChecker_linear_rebind(self, name, line);
                if self.scope_linear_vars.len() > 0 {
                    var scope: Vec<LinearVar> = self.scope_linear_vars.pop();
                    scope.push(LinearVar_new(name, line));
                    self.scope_linear_vars.push(scope);
                }
            }
            TypeChecker_declare(self, name, final_ty);
            // CA6: the handle of a task started outside a spawn scope must
            // be read (awaited, joined, passed on) later in the function
            if self.ca6_scope_depth == 0 && tc_ca6_is_spawn(expr) {
                self.ca6_names.push(name);
                self.ca6_lines.push(line);
            }
            // RT6: a bare Vec may be typed by its first push
            match final_ty {
                Type::Named(fvn) => {
                    if fvn == "Vec" {
                        var typable: bool = false;
                        match ty {
                            OptType::None => {
                                typable = tc_rt6_is_vec_new(expr);
                            }
                            OptType::Some(_) => {
                            }
                        }
                        TypeChecker_rt6_note_let(self, name, typable, line);
                    }
                    if fvn == "HashMap" {
                        TypeChecker_rt5_note_map_let(self, name, ty, expr, line);
                    }
                }
                Type::Generic(fgn, _) => {
                    // RT5: an untyped `HashMap::new()` (HashMap<str, i64>
                    // until its first insert says otherwise)
                    if fgn == "HashMap" {
                        TypeChecker_rt5_note_map_let(self, name, ty, expr, line);
                    }
                }
                _ => {
                }
            }
        }
        Stmt::LetTuple(names, expr, line) => {
            var expr_ty: Type = TypeChecker_check_expr(self, expr);
            TypeChecker_consume_linear_in_expr(self, expr, line);
            match expr_ty {
                Type::Tuple(elem_types) => {
                    if names.len() != elem_types.len() {
                        self.errors.push("Type error (line " + int_to_str(line) + "): tuple destructuring expects " + int_to_str(names.len()) + " names but expression has " + int_to_str(elem_types.len()) + " elements");
                    }
                    var i: i64 = 0;
                    while i < names.len() && i < elem_types.len() {
                        var elem_ty: Type = elem_types.get(i);
                        if TypeChecker_is_linear_type(self, elem_ty) {
                            if self.scope_linear_vars.len() > 0 {
                                var scope: Vec<LinearVar> = self.scope_linear_vars.pop();
                                scope.push(LinearVar_new(names.get(i), line));
                                self.scope_linear_vars.push(scope);
                            }
                        }
                        TypeChecker_declare(self, names.get(i), elem_ty);
                        i = i + 1;
                    }
                }
                _ => {
                    // CE6: an error already reported is not also a bad
                    // tuple; the names are declared (as that error's type)
                    // so their uses are not undefined variables
                    if !TypeChecker_is_reported(self, expr_ty) {
                        self.errors.push("Type error (line " + int_to_str(line) + "): cannot destructure " + type_to_str(expr_ty) + " as a tuple");
                    }
                    var ni: i64 = 0;
                    while ni < names.len() {
                        TypeChecker_declare(self, names.get(ni), Type::Never);
                        ni = ni + 1;
                    }
                }
            }
        }
        Stmt::LetUninit(name, ty, _annotations, line) => {
            var resolved_ty: Type = TypeChecker_resolve_type(self, ty);
            TypeChecker_declare(self, name, resolved_ty);
            self.uninit_vars.push(name);
            if TypeChecker_is_linear_type(self, resolved_ty) {
                if self.scope_linear_vars.len() > 0 {
                    var scope: Vec<LinearVar> = self.scope_linear_vars.pop();
                    scope.push(LinearVar_new(name, line));
                    self.scope_linear_vars.push(scope);
                }
            }
        }
        Stmt::Expr(expr, line) => {
            var se_ty: Type = TypeChecker_check_expr(self, expr);
            TypeChecker_consume_linear_in_expr(self, expr, line);
            TypeChecker_linear_check_discard(self, se_ty, line);
            // CA6: `spawn f(x);` drops the task's handle
            if self.ca6_scope_depth == 0 && tc_ca6_is_spawn(expr) {
                TypeChecker_ca6_unjoined(self, line, "the task started here");
            }
        }
        Stmt::Return(opt_expr, ret_line) => {
            var lin_ret_line: i64 = ret_line;
            if lin_ret_line <= 0 {
                lin_ret_line = self.current_line;
            }
            match opt_expr {
                OptBoxExpr::Some(e) => {
                    // The declared return type is the expected type
                    var ret_hint: Type = Type::Never;
                    match self.current_ret_ty {
                        OptType::Some(rt) => {
                            ret_hint = TypeChecker_resolve_self_type(self, rt);
                        }
                        OptType::None => {
                        }
                    }
                    var ret_ty: Type = TypeChecker_check_expr_with_hint(self, box_expr_unbox(e), ret_hint);
                    TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), self.current_line);
                    // BG117: a literal returned for a narrower declared type
                    // (`-> u8 { return 300; }`) narrowed it silently
                    if !type_eq(ret_hint, Type::Never) {
                        TypeChecker_check_value_fits(self, ret_hint, ret_ty, box_expr_unbox(e), ret_line);
                    }
                    TypeChecker_check_return_type(self, ret_ty);
                    self.current_return_types.push(ret_ty);
                }
                OptBoxExpr::None => {
                    TypeChecker_check_return_type(self, Type::Void);
                    self.current_return_types.push(Type::Void);
                }
            }
            // the linear values still live are lost on this path
            TypeChecker_linear_check_return(self, lin_ret_line);
        }
        Stmt::If(cond, then_block, else_block, line) => {
            var cond_ty: Type = TypeChecker_check_expr(self, cond);
            TypeChecker_consume_linear_in_expr(self, cond, line);
            if !type_eq(cond_ty, Type::Bool) && !type_eq(cond_ty, Type::I32) && !type_eq(cond_ty, Type::I64) && !TypeChecker_is_reported(self, cond_ty) {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): if condition must be bool, got " + type_to_str(cond_ty));
            }
            var consumed_before: Vec<str> = self.consumed_vars.clone();
            var lin_before: Vec<str> = self.consumed_vars.clone();
            var uninit_before: Vec<str> = self.uninit_vars.clone();
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < then_block.len() {
                TypeChecker_check_stmt(self, then_block.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            var consumed_after_then: Vec<str> = self.consumed_vars.clone();
            var uninit_after_then: Vec<str> = self.uninit_vars.clone();
            // Restore to before-then state for else branch
            self.consumed_vars = consumed_before;
            self.uninit_vars = uninit_before;
            match else_block {
                OptStmts::Some(else_b) => {
                    TypeChecker_push_scope(self);
                    var si2: i64 = 0;
                    while si2 < else_b.len() {
                        TypeChecker_check_stmt(self, else_b.get(si2));
                        si2 = si2 + 1;
                    }
                    TypeChecker_pop_scope(self);
                }
                OptStmts::None => {
                }
            }
            // Merge (BG187): consumed after the if when every branch that
            // reaches its end consumed it; consumed by one branch only is
            // an error (no else: the missing branch consumes nothing)
            var lin_else_live: bool = true;
            match else_block {
                OptStmts::Some(lin_eb) => {
                    lin_else_live = !tc_lin_diverge(lin_eb);
                }
                OptStmts::None => {
                }
            }
            self.consumed_vars = TypeChecker_linear_join2(self, lin_before, consumed_after_then, !tc_lin_diverge(then_block), self.consumed_vars.clone(), lin_else_live, "if", line);
            // Merge: union of uninit_vars (uninit in either branch that
            // reaches the end of the if; BG20: a branch that leaves with
            // return, break, continue or panic does not)
            var else_leaves: bool = false;
            match else_block {
                OptStmts::Some(else_b2) => {
                    else_leaves = tc_stmts_diverge(else_b2);
                }
                OptStmts::None => {
                }
            }
            self.uninit_vars = tc_uninit_join(uninit_after_then, tc_stmts_diverge(then_block), self.uninit_vars.clone(), else_leaves);
        }
        Stmt::Assign(target, cl10_aop, expr, line) => {
            // An assignment to a by-value Vec, HashMap or struct parameter
            // changes it as an index or a field assignment does (reference §5.3)
            TypeChecker_check_param_change(self, target);
            // CL10: `x += e` on a struct is `x = x + e` (its operator method,
            // or a unit's dimension rule): the result must fit x
            // BG128: an enum literal assigned takes the variable's type
            var assigned_ty: Type = TypeChecker_check_expr_with_hint(self, TypeChecker_compound_struct_expr(self, target, cl10_aop, expr), TypeChecker_assign_enum_hint(self, target, expr));
            if rt6_count() > 0 {
                TypeChecker_rt6_assigned(self, target, expr);
            }
            match TypeChecker_lookup(self, target) {
                OptType::Some(target_ty) => {
                    TypeChecker_check_value_fits(self, target_ty, assigned_ty, expr, line);
                    TypeChecker_check_assign_type(self, target_ty, assigned_ty, target, line);
                }
                OptType::None => {
                    // txn { } rolls back the function's local variables
                    // only: a global changed inside it would stay changed
                    if self.txn_depth > 0 {
                        match TypeChecker_lookup_global_cache(self, target) {
                            OptType::Some(_) => {
                                self.errors.push("Transaction error (line " + int_to_str(line) + "): global '" + target + "' is assigned inside txn { }." + "
    abort; rolls back the local variables of the function, not globals." + "
    Fix: assign a local inside the txn and copy it to the global after it.");
                            }
                            OptType::None => {
                            }
                        }
                    }
                    if tc_module_race_checked(self.current_module) {
                        match TypeChecker_lookup_global_cache(self, target) {
                            OptType::Some(_) => {
                                var as_writer: str = TypeChecker_race_writer(self);
                                self.write_funcs.push(as_writer);
                                self.write_globals.push(target);
                                self.write_lines.push(line);
                            }
                            OptType::None => {
                            }
                        }
                    }
                    // A global's value has its declared type, as a local's has
                    match TypeChecker_lookup_global_cache(self, target) {
                        OptType::Some(asg_gty) => {
                            TypeChecker_check_assign_type(self, asg_gty, assigned_ty, target, line);
                        }
                        OptType::None => {
                        }
                    }
                }
            }
            TypeChecker_consume_linear_in_expr(self, expr, line);
            // Inline str_vec_remove to avoid &mut self.field issues
            var ri: i64 = 0;
            while ri < self.uninit_vars.len() {
                if self.uninit_vars.get(ri) == target {
                    self.uninit_vars.remove(ri);
                    ri = self.uninit_vars.len();
                }
                ri = ri + 1;
            }
            // `val` bindings are immutable; the innermost declaration decides.
            if TypeChecker_is_val(self, target) {
                self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign to '" + target + "': it is declared with `val`.\n    Fix: declare it with `var` if you need to mutate it.");
            }
            // Check target exists
            match TypeChecker_lookup(self, target) {
                OptType::Some(ty) => {
                    // Re-assigning a linear variable: old value must have been consumed
                    if TypeChecker_is_linear_type(self, ty) && !tc_str_vec_contains(self.consumed_vars, target) {
                        self.errors.push("Linear type error (line " + int_to_str(line) + "): cannot reassign '" + target + "' -- the old value would be silently destroyed");
                    }
                    if TypeChecker_is_linear_type(self, ty) {
                        var ci: i64 = 0;
                        while ci < self.consumed_vars.len() {
                            if self.consumed_vars.get(ci) == target {
                                self.consumed_vars.remove(ci);
                                ci = self.consumed_vars.len();
                            }
                            ci = ci + 1;
                        }
                    }
                }
                OptType::None => {
                    // A constant has no storage to assign to
                    if map_str_type_contains(self.consts, target) {
                        self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign to constant '" + target + "'");
                    }
                    if !map_str_type_contains(self.consts, target) && !map_str_type_contains(self.globals, target) {
                        self.errors.push("Type error: cannot assign to undefined variable '" + target + "'");
                    }
                }
            }
        }
        Stmt::IndexAssign(array, index, _, expr, ia_line) => {
            TypeChecker_check_param_change(self, array);
            // OW1: `r[i] = v` with r: &T changes through a shared borrow
            self.current_line = ia_line;
            TypeChecker_check_shared_change(self, array, array + "[..]");
            var ia_idx_ty: Type = TypeChecker_check_expr(self, index);
            // BG128: an enum literal stored takes the element type
            var ia_val_ty: Type = TypeChecker_check_expr_with_hint(self, expr, TypeChecker_index_enum_hint(self, array, expr));
            self.current_line = ia_line;
            match TypeChecker_lookup(self, array) {
                OptType::Some(ia_ty) => {
                    TypeChecker_check_index_assign(self, array, ia_ty, ia_idx_ty, ia_val_ty, ia_line);
                }
                OptType::None => {
                    // A module-level global Vec or array (known-bugs 2g.74):
                    // writing an element is a write of the global, as an
                    // assignment to it is
                    match TypeChecker_lookup_global_cache(self, array) {
                        OptType::Some(ia_gty) => {
                            TypeChecker_check_index_assign(self, array, ia_gty, ia_idx_ty, ia_val_ty, ia_line);
                            if self.txn_depth > 0 {
                                self.errors.push("Transaction error (line " + int_to_str(ia_line) + "): an element of global '" + array + "' is assigned inside txn { }." + "
    abort; rolls back the local variables of the function, not globals." + "
    Fix: assign a local inside the txn and copy it to the global after it.");
                            }
                            if tc_module_race_checked(self.current_module) {
                                var ia_writer: str = TypeChecker_race_writer(self);
                                self.write_funcs.push(ia_writer);
                                self.write_globals.push(array);
                                self.write_lines.push(ia_line);
                            }
                        }
                        OptType::None => {
                            self.errors.push("Type error: cannot index undefined variable '" + array + "'");
                        }
                    }
                }
            }
        }
        Stmt::DerefAssign(ptr_expr, _, expr, da_line) => {
            var da_ptr_ty: Type = TypeChecker_check_expr(self, ptr_expr);
            self.current_line = da_line;
            match da_ptr_ty {
                Type::RawPtr(_, _) => {
                    TypeChecker_require_unsafe(self, "writing through a raw pointer");
                    TypeChecker_check_expr(self, expr);
                }
                Type::Ref(da_in, da_mut) => {
                    // OW1: `*r = v` with r: &T (reference §8.4)
                    if !da_mut {
                        var da_tn: str = type_to_str(box_type_unbox(da_in));
                        var da_what: str = tc_place_text(ptr_expr);
                        if str_len(da_what) == 0 {
                            da_what = "a value";
                        }
                        self.errors.push("Type error (line " + int_to_str(da_line) + "): cannot change '*" + da_what + "' through a shared reference '&" + da_tn + "' (take '&mut " + da_tn + "')");
                        TypeChecker_check_expr(self, expr);
                    } else {
                        var da_val_ty: Type = TypeChecker_check_expr(self, expr);
                        self.current_line = da_line;
                        TypeChecker_check_deref_value(self, ptr_expr, box_type_unbox(da_in), da_val_ty, da_line);
                    }
                }
                _ => {
                    var da_oval_ty: Type = TypeChecker_check_expr(self, expr);
                    self.current_line = da_line;
                    TypeChecker_check_deref_other(self, ptr_expr, da_ptr_ty, da_oval_ty, da_line);
                }
            }
        }
        Stmt::FieldAssign(object, field, op, expr, line) => {
            self.current_line = line;
            TypeChecker_check_param_change(self, tc_place_root(object));
            // BG25: `G.n = v` writes the global G
            TypeChecker_note_global_change(self, tc_place_root(object), line);
            // OW1: `r.f = v` with r: &T changes through a shared borrow
            var ow1_base: str = tc_place_text(object);
            if str_len(ow1_base) > 0 {
                ow1_base = ow1_base + "." + field;
            }
            TypeChecker_check_shared_change(self, tc_place_root(object), ow1_base);
            var obj_ty: Type = TypeChecker_check_expr(self, object);
            self.current_line = line;
            // Unwrap references
            var effective_ty: Type = obj_ty;
            match obj_ty {
                Type::Ref(inner, _) => {
                    effective_ty = unbox_ty(box_type_unbox(inner));
                }
                _ => {
                    effective_ty = unbox_ty(obj_ty);
                }
            }
            match effective_ty {
                Type::Named(name) => {
                    // Find field type
                    var field_ty: OptType = OptType::None;
                    var si: i64 = TypeChecker_struct_pos(self, name);
                    var si_lim: i64 = si + 1;
                    if si < 0 {
                        si = 0;
                        si_lim = 0;
                    }
                    while si < si_lim {
                        if self.structs.get(si).key == name {
                            var fields: Vec<StructField> = self.structs.get(si).val;
                            var fi: i64 = 0;
                            while fi < fields.len() {
                                if fields.get(fi).name == field {
                                    field_ty = OptType::Some(fields.get(fi).ty);
                                    break;
                                }
                                fi = fi + 1;
                            }
                            break;
                        }
                        si = si + 1;
                    }
                    match field_ty {
                        OptType::Some(fty) => {
                            // CL10: `obj.f += e` on a struct field is `obj.f = obj.f + e`
                            // BG128: an enum literal takes the field's type
                            var expr_ty: Type = TypeChecker_check_expr_with_hint(self, TypeChecker_compound_field_expr(self, object, field, op, fty, expr), tc_enum_lit_hint(expr, fty));
                            TypeChecker_consume_linear_in_expr(self, expr, line);
                            var compatible: bool = type_eq(expr_ty, fty) || type_eq(expr_ty, Type::Never) || (TypeChecker_is_integer(self, expr_ty) && TypeChecker_is_integer(self, fty)) || TypeChecker_types_compatible(self, fty, expr_ty);
                            if !compatible {
                                self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign " + type_to_str(expr_ty) + " to field '" + field + "' of type " + type_to_str(fty));
                            }
                        }
                        OptType::None => {
                            self.errors.push("Type error (line " + int_to_str(line) + "): struct '" + name + "' has no field '" + field + "'");
                            TypeChecker_check_expr(self, expr);
                        }
                    }
                }
                Type::Generic(gsn, gsargs) => {
                    // BG6: a field of a generic struct instance (`h.v = s`
                    // with h: H<str>): the declared field type with the
                    // instance's type arguments, as a field read does
                    var gtps: Vec<str> = TypeChecker_struct_type_params(self, gsn);
                    var gfty: OptType = OptType::None;
                    var gknown: bool = false;
                    match TypeChecker_lookup_struct_cache(self, gsn) {
                        OptVecStructField::Some(gfields) => {
                            var gfi: i64 = 0;
                            while gfi < gfields.len() {
                                if gfields.get(gfi).name == field {
                                    gfty = OptType::Some(tc_subst_type_params(gfields.get(gfi).ty, gtps, gsargs));
                                    break;
                                }
                                gfi = gfi + 1;
                            }
                            gknown = gtps.len() > 0;
                        }
                        OptVecStructField::None => {
                        }
                    }
                    if !gknown {
                        self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign field '" + field + "' on type " + type_to_str(obj_ty));
                        TypeChecker_check_expr(self, expr);
                    }
                    if gknown {
                    match gfty {
                        OptType::Some(fty) => {
                            var gexpr_ty: Type = TypeChecker_check_expr(self, TypeChecker_compound_field_expr(self, object, field, op, fty, expr));
                            TypeChecker_consume_linear_in_expr(self, expr, line);
                            var gok: bool = type_eq(gexpr_ty, fty) || type_eq(gexpr_ty, Type::Never) || (TypeChecker_is_integer(self, gexpr_ty) && TypeChecker_is_integer(self, fty)) || TypeChecker_types_compatible(self, fty, gexpr_ty);
                            if !gok {
                                self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign " + type_to_str(gexpr_ty) + " to field '" + field + "' of type " + type_to_str(fty));
                            }
                        }
                        OptType::None => {
                            self.errors.push("Type error (line " + int_to_str(line) + "): struct '" + gsn + "' has no field '" + field + "'");
                            TypeChecker_check_expr(self, expr);
                        }
                    }
                    }
                }
                _ => {
                    // CE9 (Nov 22): when the object is a generic type
                    // parameter, say what to do instead of just "cannot"
                    var is_generic: bool = false;
                    match obj_ty {
                        Type::Generic(_, _) => {
                            is_generic = true;
                        }
                        Type::Named(nname) => {
                            is_generic = str_len(nname) == 1;
                        }
                        _ => {
                        }
                    }
                    if is_generic {
                        self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign field '" + field + "' on the generic type parameter " + type_to_str(obj_ty) + ".\n    When <T> is instantiated with a struct that has this field, the call site reports it (the body is checked per instantiation for field accesses).\n    Fix: constrain the type — a trait with a field, or pass the field's setter as a parameter.");
                    } else {
                        self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign field '" + field + "' on type " + type_to_str(obj_ty));
                    }
                    TypeChecker_check_expr(self, expr);
                }
            }
        }
        Stmt::While(cond, body, _) => {
            var cond_ty: Type = TypeChecker_check_expr(self, cond);
            if !type_eq(cond_ty, Type::Bool) && !type_eq(cond_ty, Type::I32) && !type_eq(cond_ty, Type::I64) && !TypeChecker_is_reported(self, cond_ty) {
                self.errors.push("Type error: while condition must be bool, got " + type_to_str(cond_ty));
            }
            // BG20: the body may run zero times: what it assigns may not be
            var wu_before: Vec<str> = self.uninit_vars.clone();
            TypeChecker_push_scope(self);
            self.loop_depth = self.loop_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.loop_depth = self.loop_depth - 1;
            TypeChecker_pop_scope(self);
            self.uninit_vars = wu_before;
        }
        Stmt::For(var_name, iterator, body, _) => {
            var iter_ty: Type = TypeChecker_check_expr(self, iterator);
            // A borrowed collection (`v: &Vec<i64>`, `&mut [T; N]`) iterates
            // over its elements, as `*v` does (known-bugs 2g.56: `x` was
            // typed `&Vec<i64>`)
            match iter_ty {
                Type::Ref(rinner, _) => {
                    var rin: Type = box_type_unbox(rinner);
                    match rin {
                        Type::Generic(_, _) => {
                            iter_ty = rin;
                        }
                        Type::Named(_) => {
                            iter_ty = rin;
                        }
                        Type::Array(_, _) => {
                            iter_ty = rin;
                        }
                        Type::ArrayConst(_, _) => {
                            iter_ty = rin;
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            // Extract element type
            var elem_ty: Type = iter_ty;
            match iter_ty {
                Type::Generic(name, args) => {
                    if name == "Vec" {
                        if args.len() > 0 {
                            elem_ty = args.get(0);
                        } else {
                            elem_ty = Type::I64;
                        }
                    } else if name == "HashMap" {
                        if args.len() > 0 {
                            elem_ty = args.get(0);
                        } else {
                            elem_ty = Type::Str;
                        }
                    }
                }
                Type::Named(name) => {
                    if name == "Vec" {
                        elem_ty = Type::I64;
                    }
                }
                Type::Array(elem, _) => {
                    elem_ty = elem;
                }
                // `[T; N]` in a generic function: N is a const parameter
                // (mono gives it a number when the function is instantiated)
                Type::ArrayConst(elem, _) => {
                    elem_ty = elem;
                }
                _ => {
                    elem_ty = iter_ty;
                }
            }
            // BG20: the body may run zero times: what it assigns may not be
            var fu_before: Vec<str> = self.uninit_vars.clone();
            TypeChecker_push_scope(self);
            TypeChecker_declare(self, var_name, elem_ty);
            self.loop_depth = self.loop_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.loop_depth = self.loop_depth - 1;
            TypeChecker_pop_scope(self);
            self.uninit_vars = fu_before;
        }
        Stmt::Loop(body, _) => {
            TypeChecker_push_scope(self);
            self.loop_depth = self.loop_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.loop_depth = self.loop_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::Break(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => {
                    TypeChecker_check_expr(self, box_expr_unbox(e));
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::Continue(_) => {
        }
        Stmt::Defer(body, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::Match(expr, arms, line) => {
            var match_ty: Type = unbox_ty(TypeChecker_check_expr(self, expr));
            TypeChecker_check_exhaustive(self, match_ty, arms, line);
            // BG20: a variable is assigned after the match only when every
            // arm that reaches its end assigns it (as for if/else).
            var mu_before: Vec<str> = self.uninit_vars.clone();
            var mu_out: Vec<str> = Vec::new();
            var mu_flows: bool = false;
            // BG187: each arm starts from what was consumed before the
            // match; the arms are joined after it (TypeChecker_linear_join)
            var ml_before: Vec<str> = self.consumed_vars.clone();
            var ml_outs: Vec<Vec<str>> = Vec::new();
            var ml_live: Vec<bool> = Vec::new();
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                self.uninit_vars = mu_before.clone();
                self.consumed_vars = ml_before.clone();
                TypeChecker_push_scope(self);
                // BG129: a literal pattern of the scrutinee's type
                TypeChecker_check_literal_pattern(self, match_ty, arm.pattern);
                // Bind pattern variables
                match arm.pattern {
                    Pattern::Ident(name) => {
                        // `None =>` on an Option is the variant, as `Some(x)`
                        // is (reference §6): it binds nothing
                        if !TypeChecker_bare_pattern_is_unit_variant(self, match_ty, name) {
                            TypeChecker_declare(self, name, match_ty);
                        }
                    }
                    Pattern::EnumVariant(enum_name, variant, bindings) => {
                        TypeChecker_check_enum_pattern(self, match_ty, enum_name, variant, bindings);
                        var tys: Vec<Type> = TypeChecker_pattern_binding_types(self, match_ty, enum_name, variant, bindings);
                        var bi: i64 = 0;
                        while bi < bindings.len() && bi < tys.len() {
                            TypeChecker_declare(self, bindings.get(bi).name, tys.get(bi));
                            bi = bi + 1;
                        }
                    }
                    Pattern::StrLit(_) => {
                    }
                    Pattern::Range(_, _) => {
                    }
                    _ => {
                    }
                }
                // Check guard
                match arm.guard {
                    OptBoxExpr::Some(g) => {
                        TypeChecker_check_expr(self, box_expr_unbox(g));
                    }
                    OptBoxExpr::None => {
                    }
                }
                // Check body
                var si: i64 = 0;
                while si < arm.body.len() {
                    TypeChecker_check_stmt(self, arm.body.get(si));
                    si = si + 1;
                }
                TypeChecker_pop_scope(self);
                if !tc_stmts_diverge(arm.body) {
                    mu_out = tc_uninit_join(mu_out, false, self.uninit_vars.clone(), false);
                    mu_flows = true;
                }
                ml_outs.push(self.consumed_vars.clone());
                ml_live.push(!tc_lin_diverge(arm.body));
                ai = ai + 1;
            }
            if mu_flows {
                self.uninit_vars = mu_out;
            } else {
                self.uninit_vars = mu_before;
            }
            if arms.len() > 0 {
                self.consumed_vars = TypeChecker_linear_join(self, ml_before, ml_outs, ml_live, "match", line);
            }
        }
        Stmt::Use(_, _, _) => {
        }
        Stmt::Handle(body, handlers, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            var hi: i64 = 0;
            while hi < handlers.len() {
                var handler: EffectHandler = handlers.get(hi);
                TypeChecker_push_scope(self);
                var pi: i64 = 0;
                while pi < handler.params.len() {
                    TypeChecker_declare(self, handler.params.get(pi), Type::I64);
                    pi = pi + 1;
                }
                // L3A: `cont`, the continuation, is in scope in handler
                // bodies for resume(cont, value).
                TypeChecker_declare(self, "cont", Type::I64);
                var si2: i64 = 0;
                while si2 < handler.body.len() {
                    TypeChecker_check_stmt(self, handler.body.get(si2));
                    si2 = si2 + 1;
                }
                TypeChecker_pop_scope(self);
                hi = hi + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_check_expr(self, args.get(ai));
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(name, budget, is_gpu, is_kv_cache, _, body, line) => {
            self.region_stack.push(name);
            TypeChecker_push_scope(self);
            var new_rb: RegionBudget = RegionBudget_new(name, budget, 0);
            new_rb.kv = is_kv_cache;
            new_rb.loop0 = self.loop_depth;
            self.region_budgets.push(new_rb);
            map_str_str_set(&mut self.region_lines, name, int_to_str(line));
            if is_gpu {
                self.gpu_region_depth = self.gpu_region_depth + 1;
            }
            if is_kv_cache {
                match budget {
                    OptI64::None => {
                        self.errors.push("KV cache region error (line " + int_to_str(line) + "): 'region kv_cache " + name + "' must have a budget." + "\n    KV cache regions exist to prevent OOM in LLM serving.\n    Without a budget, the cache can grow unboundedly and crash." + "\n    Fix: add a budget: `region kv_cache " + name + " with budget(N) { ... }`.");
                    }
                    OptI64::Some(_) => {
                    }
                }
            }
            // `region gpu` needs a budget as `region kv_cache` does (§8.6)
            if is_gpu {
                match budget {
                    OptI64::None => {
                        self.errors.push("Budget error (line " + int_to_str(line) + "): 'region gpu " + name + "' must have a budget." + "\n    A GPU region's memory is bounded at compile time; without a budget it could grow unboundedly." + "\n    Fix: add a budget: `region gpu " + name + " with budget(N) { ... }`.");
                    }
                    OptI64::Some(_) => {
                    }
                }
            }
            // Track variables reassigned inside the region (flow-sensitive).
            var reassigned_in_region: Vec<str> = Vec::new();
            var si: i64 = 0;
            while si < body.len() {
                var s: Stmt = body.get(si);
                match s {
                    Stmt::Assign(target, _, _, _) => {
                        if !tc_vec_contains_str(reassigned_in_region, target) {
                            reassigned_in_region.push(target);
                        }
                    }
                    Stmt::FieldAssign(object, _, _, _, _) => {
                        match object {
                            Expr::Ident(n) => {
                                if !tc_vec_contains_str(reassigned_in_region, n) {
                                    reassigned_in_region.push(n);
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                TypeChecker_check_stmt(self, s);
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            self.region_stack.pop();
            if is_gpu {
                self.gpu_region_depth = self.gpu_region_depth - 1;
            }
            self.freed_regions.push(name);
            // Check memory budget
            if self.region_budgets.len() > 0 {
                var rb: RegionBudget = self.region_budgets.pop();
                match rb.budget {
                    OptI64::Some(b) => {
                        if rb.usage > b {
                            var rkind: str = "";
                            var rkw: str = "";
                            if is_gpu {
                                rkind = "GPU ";
                                rkw = " gpu";
                            } else if is_kv_cache {
                                rkind = "KV cache ";
                                rkw = " kv_cache";
                            }
                            self.errors.push("Budget error (line " + int_to_str(line) + "): " + rkind + "region '" + name + "' used " + int_to_str(rb.usage) + " bytes but budget is " + int_to_str(b) + " bytes (" + int_to_str(rb.usage - b) + " bytes over)." + "\n    Hint: reduce allocations inside the " + rkind + "region block, or increase the budget in `region" + rkw + " " + name + " with budget(" + int_to_str(b) + ") { ... }`.");
                        }
                        if rb.heap != "" && !rb.kv {
                            var hkind: str = "";
                            if is_gpu {
                                hkind = "GPU ";
                            }
                            self.errors.push("Budget error (line " + int_to_str(line) + "): " + hkind + "region '" + name + "' with budget(" + int_to_str(b) + ") allocates on the heap: " + rb.heap + ".\n    The budget is checked at compile time. It counts the region's locals and heap allocations" + "\n    of a size known at compile time (p_malloc(N), Vec::new(), an f-string of numbers)," + "\n    not ones that can grow (push, insert, string `+`, an allocation in a loop, a call that allocates)." + "\n    Fix: allocate before the region, or use a fixed-size buffer.");
                        }
                    }
                    OptI64::None => {
                    }
                }
            }
        }
        Stmt::Sandbox(body, _) => {
            TypeChecker_push_scope(self);
            self.sandbox_depth = self.sandbox_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.sandbox_depth = self.sandbox_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::Unsafe(body, _) => {
            TypeChecker_push_scope(self);
            self.unsafe_depth = self.unsafe_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.unsafe_depth = self.unsafe_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::Txn(body, _) => {
            TypeChecker_push_scope(self);
            self.txn_depth = self.txn_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.txn_depth = self.txn_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::ComptimeGen(_, _) => {
        }
        Stmt::GradBlock(_, body, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::Backward(loss, _) => {
            var loss_ty: Type = TypeChecker_check_expr(self, loss);
            var is_f64: bool = type_eq(loss_ty, Type::F64);
            var is_tensor: bool = false;
            match loss_ty {
                Type::Named(name) => {
                    if name == "Tensor" {
                        is_tensor = true;
                    }
                }
                Type::Generic(name, _) => {
                    if name == "Tensor" {
                        is_tensor = true;
                    }
                }
                Type::ShapedTensor(_, _) => {
                    is_tensor = true;
                }
                _ => {
                }
            }
            if !is_f64 && !is_tensor {
                self.errors.push("Type error: backward() loss must be F64 or Tensor, got " + type_to_str(loss_ty));
            }
        }
        Stmt::Query(_, body, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                var case: SelectCase = cases.get(ci);
                TypeChecker_check_expr(self, case.channel);
                TypeChecker_push_scope(self);
                TypeChecker_declare(self, case.var_name, Type::I64);
                var si: i64 = 0;
                while si < case.body.len() {
                    TypeChecker_check_stmt(self, case.body.get(si));
                    si = si + 1;
                }
                TypeChecker_pop_scope(self);
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(def_body) => {
                    TypeChecker_push_scope(self);
                    var si: i64 = 0;
                    while si < def_body.len() {
                        TypeChecker_check_stmt(self, def_body.get(si));
                        si = si + 1;
                    }
                    TypeChecker_pop_scope(self);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                // BG24: each branch runs on a thread of its own: what it
                // reads must be @send, and the race check takes it as a
                // thread (TypeChecker_par_begin)
                var par_saved: str = TypeChecker_par_begin(self, branch);
                TypeChecker_push_scope(self);
                var si: i64 = 0;
                while si < branch.len() {
                    TypeChecker_check_stmt(self, branch.get(si));
                    si = si + 1;
                }
                TypeChecker_pop_scope(self);
                g_tc_par_writer = par_saved;
                bi = bi + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            TypeChecker_check_expr(self, cont);
            TypeChecker_check_expr(self, value);
        }
        Stmt::SpawnScope(body, _) => {
            TypeChecker_push_scope(self);
            // CA6: the scope joins the tasks its body starts
            self.ca6_scope_depth = self.ca6_scope_depth + 1;
            var si5: i64 = 0;
            while si5 < body.len() {
                TypeChecker_check_stmt(self, body.get(si5));
                si5 = si5 + 1;
            }
            self.ca6_scope_depth = self.ca6_scope_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::CancelScope(_) => {
        }
    }
}

// ---- CHUNK_MARKER_7 ----

// --- collect_captured_vars ----------------------------------------------
// Walks an expression tree and collects (name, type) pairs for all
// in-scope variables referenced (Idents that resolve to local vars).
// Used by the @send check on spawn expressions.

// Names and types are kept in two parallel Vecs: a Vec of tuples held
// pointers to stack temporaries (crash in is_send_type).
pub fn TypeChecker_collect_captured_vars(self: &TypeChecker, expr: Expr, cap_names: &mut Vec<str>, cap_types: &mut Vec<Type>) {
    match expr {
        Expr::Ident(name) => {
            var ty_opt: OptType = TypeChecker_lookup(self, name);
            match ty_opt {
                OptType::Some(ty) => {
                    var found: bool = false;
                    var i: i64 = 0;
                    while i < cap_names.len() {
                        if cap_names.get(i) == name {
                            found = true;
                        }
                        i = i + 1;
                    }
                    if !found {
                        cap_names.push(name);
                        cap_types.push(ty);
                    }
                }
                OptType::None => {
                }
                // not a local var
            }
        }
        Expr::Call(callee, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_collect_captured_vars(self, args.get(ai), cap_names, cap_types);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(recv, _method, args) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(recv), cap_names, cap_types);
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_collect_captured_vars(self, args.get(ai), cap_names, cap_types);
                ai = ai + 1;
            }
        }
        Expr::Binary(_op, left, right) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(left), cap_names, cap_types);
            TypeChecker_collect_captured_vars(self, box_expr_unbox(right), cap_names, cap_types);
        }
        Expr::Unary(_op, e) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        Expr::Index(arr, idx) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(arr), cap_names, cap_types);
            TypeChecker_collect_captured_vars(self, box_expr_unbox(idx), cap_names, cap_types);
        }
        Expr::FieldAccess(e, _field) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        Expr::OptionalFieldAccess(e, _field) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        Expr::Ref(e, _is_mut) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        Expr::Deref(e) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        Expr::Try(e) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        Expr::Coalesce(e, def) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
            TypeChecker_collect_captured_vars(self, box_expr_unbox(def), cap_names, cap_types);
        }
        Expr::Cast(e, _ty) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        Expr::Await(e) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        Expr::StrConcat(left, right) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(left), cap_names, cap_types);
            TypeChecker_collect_captured_vars(self, box_expr_unbox(right), cap_names, cap_types);
        }
        Expr::PipeForward(left, right) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(left), cap_names, cap_types);
            TypeChecker_collect_captured_vars(self, box_expr_unbox(right), cap_names, cap_types);
        }
        Expr::ArrayLit(_ty, elems) => {
            var ei: i64 = 0;
            while ei < elems.len() {
                TypeChecker_collect_captured_vars(self, elems.get(ei), cap_names, cap_types);
                ei = ei + 1;
            }
        }
        Expr::TupleLit(elems) => {
            var ei: i64 = 0;
            while ei < elems.len() {
                TypeChecker_collect_captured_vars(self, elems.get(ei), cap_names, cap_types);
                ei = ei + 1;
            }
        }
        Expr::StructLit(_name, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                TypeChecker_collect_captured_vars(self, fields.get(fi).value, cap_names, cap_types);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => {
                    TypeChecker_collect_captured_vars(self, box_expr_unbox(s), cap_names, cap_types);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::Spawn(e) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        Expr::Yield(e) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        Expr::NamedArg(name, e) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        Expr::Comptime(e) => {
            TypeChecker_collect_captured_vars(self, box_expr_unbox(e), cap_names, cap_types);
        }
        _ => {
        }
    }
}

// --- check_expr ----------------------------------------------------------

pub fn TypeChecker_check_expr(self: &mut TypeChecker, expr: Expr) -> Type {
    return TypeChecker_check_expr_with_hint(self, expr, Type::Never);
}

pub fn TypeChecker_check_expr_with_hint(self: &mut TypeChecker, expr: Expr, hint: Type) -> Type {
    // Recursion depth guard -- prevents stack overflow on deeply nested expressions
    self.check_depth = self.check_depth + 1;
    if self.check_depth > 512 {
        self.errors.push("Type error: typechecker recursion limit exceeded (512) -- expression too deeply nested.\n    Fix: split the expression with `val` steps.");
        self.check_depth = self.check_depth - 1;
        return Type::Never;
    }

    var result: Type = TypeChecker_check_expr_inner(self, expr, hint);
    self.check_depth = self.check_depth - 1;
    return result;
}

/// The type of a struct literal `name { fields, ..spread }` (out of line:
/// TypeChecker_check_expr_inner's C is at zig cc's limit, -O2 fails on it).
fn TypeChecker_check_struct_lit(self: &mut TypeChecker, name: str, fields: Vec<FieldInit>, spread: OptBoxExpr, hint: Type) -> Type {
    var real_name: str = TypeChecker_resolve_struct_name(self, name);
    // Find struct definition
    var si: i64 = TypeChecker_struct_pos(self, real_name);
    var si_lim: i64 = si + 1;
    if si < 0 {
        si = 0;
        si_lim = 0;
    }
    while si < si_lim {
        if self.structs.get(si).key == real_name {
            var struct_fields: Vec<StructField> = self.structs.get(si).val;
            // A generic struct (known-bugs 2f.11): its type
            // arguments are those of the field values, as for a
            // generic function's arguments; the literal has type
            // Pair<A, B> with them
            var stps: Vec<str> = TypeChecker_struct_type_params(self, real_name);
            var sargs: Vec<Type> = Vec::new();
            var sk: i64 = 0;
            while sk < stps.len() {
                var given: Type = Type::Infer;
                match hint {
                    Type::Generic(hn, hargs) => {
                        if hn == real_name && sk < hargs.len() {
                            given = hargs.get(sk);
                        }
                    }
                    _ => {
                    }
                }
                sargs.push(given);
                sk = sk + 1;
            }
            // Check spread source type
            match spread {
                OptBoxExpr::Some(spread_expr) => {
                    var spread_e: Expr = box_expr_unbox(spread_expr);
                    if ast_is_spread_defaults(spread_e) {
                        // CL5: `S { a: 1, .. }`, every field left out
                        // takes its declared default
                        TypeChecker_check_struct_defaults(self, real_name, struct_fields, fields);
                    } else {
                        var spread_ty: Type = TypeChecker_check_expr(self, spread_e);
                        if !TypeChecker_types_compatible(self, Type::Named(real_name), spread_ty) {
                            self.errors.push("Type error: spread source expected " + real_name + ", got " + type_to_str(spread_ty));
                        }
                    }
                }
                OptBoxExpr::None => {
                }
            }
            // Check each field
            var fi: i64 = 0;
            while fi < fields.len() {
                var fname: str = fields.get(fi).name;
                var fexpr: Expr = fields.get(fi).value;
                // BG128: an enum literal takes the field's type
                var fty: Type = TypeChecker_check_expr_with_hint(self, fexpr, tc_field_enum_hint(struct_fields, fname, fexpr, stps));
                var found: bool = false;
                var sfi: i64 = 0;
                while sfi < struct_fields.len() {
                    if struct_fields.get(sfi).name == fname {
                        var want: Type = struct_fields.get(sfi).ty;
                        if stps.len() > 0 {
                            match want {
                                Type::Named(wn) => {
                                    var tk: i64 = 0;
                                    while tk < stps.len() {
                                        if stps.get(tk) == wn && tc_type_has_infer(sargs.get(tk)) {
                                            sargs.set(tk, tc_bind_type(fexpr, fty));
                                        }
                                        tk = tk + 1;
                                    }
                                }
                                _ => {
                                }
                            }
                            want = tc_subst_type_params(want, stps, sargs);
                        }
                        if !tc_type_has_infer(want) && !TypeChecker_types_compatible(self, want, fty) {
                            self.errors.push("Type error: field '" + fname + "' expected " + type_to_str(want) + ", got " + type_to_str(fty));
                        }
                        // BG117: a literal must fit the field's type —
                        // `S { b: 300 }` for `b: u8` narrowed it
                        TypeChecker_check_value_fits(self, want, fty, fexpr, self.current_line);
                        found = true;
                        sfi = struct_fields.len();
                    }
                    sfi = sfi + 1;
                }
                if !found {
                    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): struct '" + name + "' has no field '" + fname + "'");
                }
                fi = fi + 1;
            }
            if stps.len() > 0 {
                var ak: i64 = 0;
                while ak < sargs.len() {
                    // A parameter only nested in a field type (`items:
                    // Vec<T>` given `Vec::new()`) stays open: the type
                    // the literal is used as (a return type, an
                    // annotated variable) decides it. Only a bare `T`
                    // field the literal does not determine is an error.
                    var bare_t: bool = false;
                    var bf: i64 = 0;
                    while bf < struct_fields.len() {
                        match struct_fields.get(bf).ty {
                            Type::Named(bn) => {
                                if bn == stps.get(ak) {
                                    bare_t = true;
                                }
                            }
                            _ => {
                            }
                        }
                        bf = bf + 1;
                    }
                    if tc_type_has_infer(sargs.get(ak)) && bare_t {
                        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): cannot infer type parameter '" + stps.get(ak) + "' of struct '" + real_name + "' from the literal. Fix: give the variable a type, e.g. `var p: " + real_name + "<...> = ...`");
                        sargs.set(ak, Type::I64);
                    }
                    ak = ak + 1;
                }
                return Type::Generic(real_name, sargs);
            }
            return Type::Named(real_name);
        }
        si = si + 1;
    }
    // CE6: once per function, as an undefined name is (a misspelt
    // struct is usually written several times)
    if TypeChecker_first_report(self, "struct " + name) {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): unknown struct '" + name + "'");
    }
    return Type::Never;
}

fn TypeChecker_check_expr_inner(self: &mut TypeChecker, expr: Expr, hint: Type) -> Type {
    match expr {
        Expr::IntLit(v) => {
            // Bidirectional: if hint is an integer type, use it directly
            match hint {
                Type::I8 => {
                    return Type::I8;
                }
                Type::I16 => {
                    return Type::I16;
                }
                Type::I32 => {
                    return Type::I32;
                }
                Type::I64 => {
                    return Type::I64;
                }
                Type::U8 => {
                    return Type::U8;
                }
                Type::U16 => {
                    return Type::U16;
                }
                Type::U32 => {
                    return Type::U32;
                }
                Type::U64 => {
                    return Type::U64;
                }
                _ => {
                    return infer_int_type(v);
                }
            }
            return infer_int_type(v);
        }
        Expr::FloatLit(_) => {
            match hint {
                Type::F32 => {
                    return Type::F32;
                }
                _ => {
                    return Type::F64;
                }
            }
            return Type::F64;
        }
        Expr::StringLit(_) => {
            return Type::Str;
        }
        Expr::BoolLit(_) => {
            return Type::Bool;
        }
        Expr::Ident(name) => {
            // F63: init guarantee -- check if variable is read before assignment
            if tc_str_vec_contains(self.uninit_vars, name) {
                self.errors.push("Init error: variable '" + name + "' is used before being assigned a value." + "\n    It was declared with `var` (uninitialized mutable)." + "\n    Fix: assign a value to '" + name + "' before reading it, or use `val " + name + " = ...` to initialize at declaration.");
            }
            // CA6: a task handle read (awaited, joined, passed on, kept)
            if self.ca6_names.len() > 0 {
                TypeChecker_ca6_note_read(self, name);
            }
            match TypeChecker_lookup(self, name) {
                OptType::Some(ty) => {
                    return ty;
                }
                OptType::None => {
                }
            }
            match TypeChecker_lookup_const_cache(self, name) {
                OptType::Some(ty) => {
                    TypeChecker_check_visibility(self, name);
                    return ty;
                }
                OptType::None => {
                }
            }
            // Check module-level mutable globals
            match TypeChecker_lookup_global_cache(self, name) {
                OptType::Some(ty) => {
                    TypeChecker_check_visibility(self, name);
                    return ty;
                }
                OptType::None => {
                }
            }
            // Check if it's a function name -- return function type
            // OPTIMIZATION: use cached lookup instead of O(n) linear scan
            match TypeChecker_lookup_func_cache(self, name) {
                OptFuncSig::Some(sig) => {
                    TypeChecker_check_visibility(self, name);
                    return Type::Func(sig.param_types, Box::new(sig.ret_ty));
                }
                OptFuncSig::None => {
                }
            }
            if TypeChecker_first_report(self, name) {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): undefined variable '" + name + "'");
            }
            return Type::Never;
        }
        Expr::Binary(op, left, right) => {
            var is_cmp_op: bool = binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq);
            var lt: Type = Type::Never;
            var rt: Type = Type::Never;
            if is_cmp_op && tc_expr_all_num_lits(box_expr_unbox(left)) && !tc_expr_all_num_lits(box_expr_unbox(right)) {
                // `49 + 55 != s`: check the typed side first, then give the
                // literal side its type so the literals infer to it.
                rt = TypeChecker_check_expr_with_hint(self, box_expr_unbox(right), hint);
                lt = TypeChecker_check_expr_with_hint(self, box_expr_unbox(left), TypeChecker_resolve_type(self, rt));
            } else if is_cmp_op {
                // `s != 49 + 55`: right's literals infer to left's type.
                lt = TypeChecker_check_expr_with_hint(self, box_expr_unbox(left), hint);
                rt = TypeChecker_check_expr_with_hint(self, box_expr_unbox(right), TypeChecker_resolve_type(self, lt));
            } else {
                lt = TypeChecker_check_expr_with_hint(self, box_expr_unbox(left), hint);
                rt = TypeChecker_check_expr_with_hint(self, box_expr_unbox(right), hint);
            }
            var lt_r: Type = TypeChecker_resolve_type(self, lt);
            var rt_r: Type = TypeChecker_resolve_type(self, rt);
            // An element of a bare Vec has no declared type: it takes the
            // other operand's.
            if type_eq(lt_r, Type::Infer) && type_eq(rt_r, Type::Infer) {
                lt_r = Type::I64;
                rt_r = Type::I64;
            } else if type_eq(lt_r, Type::Infer) {
                lt_r = rt_r;
            } else if type_eq(rt_r, Type::Infer) {
                rt_r = lt_r;
            }
            lt = lt_r;
            rt = rt_r;
            // A borrowed string reads as a string: `+` makes a new, owned one (M11)
            if tc_is_borrowed_str(lt) {
                lt = Type::Str;
                lt_r = Type::Str;
            }
            if tc_is_borrowed_str(rt) {
                rt = Type::Str;
                rt_r = Type::Str;
            }
            if self.region_budgets.len() > 0 && binop_eq(op, BinOp::Add) && (type_eq(lt_r, Type::Str) || type_eq(rt_r, Type::Str) || type_eq(lt_r, Type::Named("String"))) {
                TypeChecker_budget_heap(self, "string `+`", -1);
            }
            // @no-alloc: `a + b` on strings allocates (it is the function a
            // scan for calls cannot see: `+` is not a call)
            if self.in_no_alloc && binop_eq(op, BinOp::Add) && (type_eq(lt_r, Type::Str) || type_eq(rt_r, Type::Str)) {
                self.errors.push("Safety error (" + self.checking_fn + "): function '" + self.checking_fn + "' is @no-alloc but uses string `+`, which allocates.\n    Dynamic allocation is forbidden — deterministic memory usage required.\n    Fix: use a fixed-size array or a buffer passed in, or remove the safety annotation.");
            }
            // A str is text: comparing it with a number has no meaning outside
            // the runtime layer and the compiler, where a str is a word
            var is_cmp: bool = is_cmp_op;
            if is_cmp && !is_runtime_layer(self.current_module) && !str_starts_with(self.current_module, "compiler") && ((type_eq(lt_r, Type::Str) && TypeChecker_is_numeric(self, rt_r)) || (type_eq(rt_r, Type::Str) && TypeChecker_is_numeric(self, lt_r))) {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): cannot compare a str with a number (" + type_to_str(lt_r) + " with " + type_to_str(rt_r) + ").\n    `==` on a str compares text, and a str is never null: a builtin that can fail gives an Option (read_file, env_var, arg_at, read_line). To compare with a number, convert one side with `as` or int_to_str.");
                return Type::Bool;
            }
            // BG60: what else a comparison's operands must be (out of line)
            if is_cmp && TypeChecker_check_comparison(self, op, box_expr_unbox(left), box_expr_unbox(right), lt_r, rt_r) {
                return Type::Bool;
            }
            // CL10: `<` `<=` `>` `>=` on a unit (@dimension) compare its f64
            // with another value of the same unit (lower.fd does the same)
            if is_cmp && !binop_eq(op, BinOp::Eq) && !binop_eq(op, BinOp::Neq) {
                var cmp_un: str = tc_dim_struct_name(self, lt_r);
                if str_len(cmp_un) > 0 && tc_struct_dim(cmp_un) != 0 {
                    if !type_eq(rt_r, lt_r) && !type_eq(rt_r, Type::Never) {
                        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `" + cmp_un + " " + tc_cmp_symbol(op) + " " + type_to_str(rt_r) + "`: a unit compares only with a value of its own unit (" + cmp_un + ").");
                    }
                    return Type::Bool;
                }
            }
            match op {
                BinOp::Add => {
                }
                BinOp::Sub => {
                }
                BinOp::Mul => {
                }
                BinOp::Div => {
                }
                BinOp::Mod => {
                }
                BinOp::Eq => {
                    return Type::Bool;
                }
                BinOp::Neq => {
                    return Type::Bool;
                }
                BinOp::Lt => {
                    return Type::Bool;
                }
                BinOp::Gt => {
                    return Type::Bool;
                }
                BinOp::LtEq => {
                    return Type::Bool;
                }
                BinOp::GtEq => {
                    return Type::Bool;
                }
                BinOp::And => {
                    // CE6: an operand whose error is already reported adds none
                    if (!type_eq(lt_r, Type::Bool) && !TypeChecker_is_reported(self, lt_r)) || (!type_eq(rt_r, Type::Bool) && !TypeChecker_is_reported(self, rt_r)) {
                        self.errors.push("Type error: logical operators require bool, got " + type_to_str(lt_r) + " and " + type_to_str(rt_r));
                    }
                    return Type::Bool;
                }
                BinOp::Or => {
                    if (!type_eq(lt_r, Type::Bool) && !TypeChecker_is_reported(self, lt_r)) || (!type_eq(rt_r, Type::Bool) && !TypeChecker_is_reported(self, rt_r)) {
                        self.errors.push("Type error: logical operators require bool, got " + type_to_str(lt_r) + " and " + type_to_str(rt_r));
                    }
                    return Type::Bool;
                }
                BinOp::BitAnd => {
                }
                BinOp::BitOr => {
                }
                BinOp::BitXor => {
                }
                BinOp::Shl => {
                }
                BinOp::Shr => {
                }
            }
            // Operator overloading for vec types (Phase 8A): vec +/- vec of
            // one shape, vec * scalar, vec / scalar and scalar * vec.
            var is_addsub: bool = binop_eq(op, BinOp::Add) || binop_eq(op, BinOp::Sub);
            var is_arith: bool = is_addsub || binop_eq(op, BinOp::Mul) || binop_eq(op, BinOp::Div) || binop_eq(op, BinOp::Mod);
            if is_arith {
                match lt_r {
                    Type::Named(ln) => {
                        match rt_r {
                            Type::Named(rn) => {
                                if tc_is_vec_type(ln) && tc_is_vec_type(rn) {
                                    if ln == rn {
                                        if is_addsub {
                                            return lt_r;
                                        }
                                    } else {
                                        self.errors.push("Type error: shape mismatch in binary operation. Left operand: " + ln + ", Right operand: " + rn);
                                        return Type::Never;
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                        if tc_is_vec_type(ln) && TypeChecker_is_float(self, rt_r) {
                            if binop_eq(op, BinOp::Mul) || binop_eq(op, BinOp::Div) {
                                return lt_r;
                            }
                        }
                    }
                    _ => {
                    }
                }
                match rt_r {
                    Type::Named(rn2) => {
                        if tc_is_vec_type(rn2) && TypeChecker_is_float(self, lt_r) && binop_eq(op, BinOp::Mul) {
                            return rt_r;
                        }
                    }
                    _ => {
                    }
                }
            }
            // CL10: `a op b` on a struct with an operator method (`add`,
            // `sub`, `mul`, `div`, `rem`, taking the right operand) is
            // `a.op(b)`; the lowering makes the same call
            if is_arith {
                var cl10_left_struct: bool = false;
                match lt_r {
                    Type::Named(oln) => {
                        if !tc_is_vec_type(oln) && tc_is_struct(self, oln) && !TypeChecker_is_typed_string(self, lt_r) {
                            // and on units, the dimension rule (CL10, section "units of measure")
                            return TypeChecker_check_struct_or_dim_operator(self, op, oln, lt_r, rt_r, box_expr_unbox(right));
                        }
                        cl10_left_struct = tc_is_struct(self, oln);
                    }
                    _ => {
                    }
                }
                // CL10: `2.0 * m`: the right struct's `rmul` (`radd`, ...),
                // or for a unit the dimension rule
                if !cl10_left_struct {
                    match rt_r {
                        Type::Named(orn) => {
                            if !tc_is_vec_type(orn) && tc_is_struct(self, orn) && !TypeChecker_is_typed_string(self, rt_r) {
                                var rres: Type = TypeChecker_check_right_struct_operator(self, op, lt_r, orn, rt_r, box_expr_unbox(left));
                                if !type_eq(rres, Type::Infer) {
                                    return rres;
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
            }
            // Arithmetic/bitwise ops
            // String concatenation with +
            if binop_eq(op, BinOp::Add) {
                if type_eq(lt_r, Type::Str) && type_eq(rt_r, Type::Str) {
                    return Type::Str;
                }
                // F68: reject typed string concatenation
                if TypeChecker_is_typed_string(self, lt_r) || TypeChecker_is_typed_string(self, rt_r) {
                    var typed: Type = rt_r;
                    if TypeChecker_is_typed_string(self, lt_r) {
                        typed = lt_r;
                    }
                    self.errors.push("Injection error (F68): cannot use + to concatenate typed string '" + type_to_str(typed) + "'." + "\n    Typed strings prevent injection — use bind/escape methods instead." + "\n    For SQLString: use sql_query() + sql_bind() instead of string +." + "\n    For ShellString: use shell_cmd() + shell_escape() instead of string +.");
                    return Type::Never;
                }
            }
            // Treat str as i64 for arithmetic
            var lt_eff: Type = lt_r;
            if type_eq(lt_eff, Type::Str) {
                lt_eff = Type::I64;
            }
            var rt_eff: Type = rt_r;
            if type_eq(rt_eff, Type::Str) {
                rt_eff = Type::I64;
            }
            if TypeChecker_is_numeric(self, lt_eff) && TypeChecker_is_numeric(self, rt_eff) {
                if TypeChecker_is_integer(self, lt_eff) && TypeChecker_is_integer(self, rt_eff) {
                    return wider_type(lt_eff, rt_eff);
                }
                if type_eq(lt_eff, Type::F64) || type_eq(rt_eff, Type::F64) {
                    return Type::F64;
                }
                return Type::F32;
            }
            // never: an operand whose error is already reported (CE6)
            if !type_eq(lt_r, Type::Never) && !type_eq(rt_r, Type::Never) {
                // 2g.64: with the line (extract_line_col reads "(line N)")
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): arithmetic requires numeric types. Left: " + type_to_str(lt_r) + ", Right: " + type_to_str(rt_r));
            }
            return Type::Never;
        }
        Expr::Unary(op, e) => {
            var ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
            match op {
                UnaryOp::Neg => {
                    // CL10: `-d` on a unit is the same unit, its f64 negated
                    var neg_un: str = tc_dim_struct_name(self, TypeChecker_resolve_type(self, ty));
                    if str_len(neg_un) > 0 && tc_struct_dim(neg_un) != 0 {
                        return ty;
                    }
                    if !TypeChecker_is_numeric(self, ty) && !TypeChecker_is_reported(self, ty) {
                        self.errors.push("Type error: cannot negate " + type_to_str(ty));
                    }
                    return ty;
                }
                UnaryOp::Not => {
                    if !type_eq(ty, Type::Bool) && !TypeChecker_is_reported(self, ty) {
                        self.errors.push("Type error: cannot logically negate " + type_to_str(ty));
                    }
                    return Type::Bool;
                }
                UnaryOp::BitNot => {
                    if !TypeChecker_is_integer(self, ty) && !TypeChecker_is_reported(self, ty) {
                        self.errors.push("Type error: cannot bitwise negate " + type_to_str(ty) + " (expected integer type)");
                    }
                    return ty;
                }
            }
            return ty;
        }
        Expr::Call(callee, args) => {
            // CA6: `spawn detached f(x)` (parser): the task is let go by
            // name, so no handle is kept; its spawn is checked as any other
            if callee == "__spawn_detached" {
                var dai: i64 = 0;
                while dai < args.len() {
                    TypeChecker_check_expr(self, args.get(dai));
                    dai = dai + 1;
                }
                return Type::Void;
            }
            // CA8: `timeout(ms) { .. } else { .. }` (parser
            // parse_timeout_stmt): `if __timeout_block(ms) { body }` and
            // `if __timeout_expired() { late }`; lower.fd runs the body
            // with the block's token installed
            if callee == "__timeout_block" {
                if args.len() != 1 {
                    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): timeout takes one value, the time in milliseconds: `timeout(ms) { .. }`");
                    return Type::Bool;
                }
                var tbt: Type = TypeChecker_check_expr(self, args.get(0));
                if !TypeChecker_is_integer(self, tbt) && !TypeChecker_is_reported(self, tbt) {
                    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): timeout(ms) takes the time in milliseconds, an integer; got " + type_to_str(tbt));
                }
                return Type::Bool;
            }
            if callee == "__timeout_expired" {
                return Type::Bool;
            }
            if callee == "__txn_abort" {
                if self.txn_depth == 0 {
                    self.errors.push("Transaction error (line " + int_to_str(self.current_line) + "): 'abort;' is only allowed inside txn { }.");
                }
                return Type::Void;
            }
            // LG9: process_gen (comptime_eval.fd ct_expand_splices) replaces
            // every `comptime splice` it reaches; one left here stands where
            // it does not look
            if callee == "__comptime_splice" {
                self.errors.push("Comptime error (line " + int_to_str(self.current_line) + "): this `comptime splice { }` was not expanded. A splice may stand in the body of a function or method and in a constant's initializer, not inside a closure or a trait's default method.");
                return Type::Never;
            }
            // f"{e:spec}" (parser): the value and the spec text; the value
            // has the same rule as a plain part — no struct's text form
            if callee == "__fstr_fmt" {
                if args.len() != 2 {
                    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): __fstr_fmt takes the value and the spec text.");
                    return Type::Never;
                }
                var ft: Type = TypeChecker_check_expr(self, args.get(0));
                TypeChecker_check_fstring_part(self, TypeChecker_resolve_type(self, ft));
                TypeChecker_check_expr(self, args.get(1));
                return Type::Str;
            }
            if callee == "p_thread_spawn" && args.len() > 0 {
                match args.get(0) {
                    Expr::StringLit(entry) => {
                        self.thread_entries.push(entry);
                    }
                    _ => {
                    }
                }
            }
            // RT8: p_malloc_uninit is core's (TypeChecker_check_core_only).
            // Kept out of line: this function's C is at the size where one
            // more inline check made zig cc 0.16 exit 5 with no message
            if str_starts_with(callee, "p_") {
                TypeChecker_check_core_only(self, callee);
            }
            if tc_raw_memory_builtin(callee) {
                TypeChecker_require_unsafe(self, callee + "()");
            } else if str_vec_contains(self.extern_fns, callee) && !str_starts_with(callee, "p_") && tc_is_trusted_extern(callee) == false {
                TypeChecker_require_unsafe(self, "calling the C function " + callee + "()");
            } else if g_tc_unsafe_fns != 0 && self.unsafe_depth == 0 && !TypeChecker_is_local_var(self, callee) {
                // Release M10: an @unsafe function's contract is the caller's
                TypeChecker_require_unsafe_call(self, tc_unsafe_call_key(callee), callee);
            }
            // Check capabilities for built-in functions
            var sb_errs0: i64 = self.errors.len();
            if callee == "print" || callee == "println" || callee == "print_int" || callee == "print_float" || callee == "print_str" {
                TypeChecker_check_capability(self, "IO", callee + "()");
            }
            if callee == "read_file" || callee == "write_file" || callee == "file_open" || callee == "file_read" || callee == "file_write" {
