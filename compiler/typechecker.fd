            // BG182 (out of line: this function's C is at zig cc's size limit)
            var ofa_ty: Type = TypeChecker_option_field_type(self, obj_ty, field);
            if !type_eq(ofa_ty, Type::Infer) {
                return ofa_ty;
            }
