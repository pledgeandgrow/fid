// Method info: (param_types, ret_ty, has_self, is_pub)
pub struct MethodInfo {
    pub param_types: Vec<Type>,
    pub ret_ty: Type,
    pub has_self: bool,
    pub is_pub: bool,
    // LG4: a generic method's own type parameters and their bounds
    // (`fn m<U: Show>`), bound at each call (TypeChecker_lg4_method_call)
    pub type_params: Vec<str>,
    pub type_param_bounds: Vec<StrPair>,
    // BG18: how many parameters (self included) have no default, and
    // whether the last one is variadic (`...xs: T`)
    pub min_args: i64,
    pub variadic: bool,
}

pub fn MethodInfo_new(param_types: Vec<Type>, ret_ty: Type, has_self: bool, is_pub: bool) -> MethodInfo {
    return MethodInfo {
        param_types: param_types, ret_ty: ret_ty, has_self: has_self, is_pub: is_pub, type_params: Vec::new(), type_param_bounds: Vec::new(), min_args: param_types.len(), variadic: false,
    };
}

/// LG4: `info` with a method's own type parameters and bounds.
pub fn MethodInfo_with_tps(info: MethodInfo, tps: Vec<str>, bounds: Vec<StrPair>) -> MethodInfo {
    var r: MethodInfo = info;
    r.type_params = tps;
    r.type_param_bounds = bounds;
    return r;
}

/// BG18: `info` with what a call needs of the method's parameters: how many
/// have no default (a call may leave the others out) and whether the last
/// one is variadic.
pub fn MethodInfo_with_params(info: MethodInfo, params: Vec<Param>) -> MethodInfo {
    var r: MethodInfo = info;
    var req: i64 = 0;
    var va: bool = false;
    var i: i64 = 0;
    while i < params.len() {
        if !params.get(i).has_default {
            req = req + 1;
        }
        if params.get(i).is_variadic {
            va = true;
        }
        i = i + 1;
    }
    r.min_args = req;
    r.variadic = va;
    return r;
}

// Trait method info: (param_types, ret_ty, has_self)
pub struct TraitMethodInfo {
    pub param_types: Vec<Type>,
    pub ret_ty: Type,
    pub has_self: bool,
    // LG4: a generic trait method's own type parameters and bounds
    pub type_params: Vec<str>,
    pub type_param_bounds: Vec<StrPair>,
}

pub fn TraitMethodInfo_new(param_types: Vec<Type>, ret_ty: Type, has_self: bool) -> TraitMethodInfo {
    return TraitMethodInfo {
        param_types: param_types, ret_ty: ret_ty, has_self: has_self, type_params: Vec::new(), type_param_bounds: Vec::new(),
    };
}

