}

// --- Vec lookup helpers --------------------------------------------------

pub fn tc_str_vec_contains(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

/// Same as str_vec_contains but takes a &mut Vec<str> reference.
/// This is needed because the codegen doesn't auto-deref &mut T to T
/// for function call arguments.
/// `v` without repeats, in first-seen order: a list of called functions is
/// gathered with repeats and made a set once (D10: checking it before each
/// push was quadratic in the size of a function).
pub fn tc_dedupe_strs(v: Vec<str>) -> Vec<str> {
    var seen: i64 = HashMap_new();
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        if !HashMap_contains(seen, v.get(i)) {
            HashMap_insert(seen, v.get(i), 1);
            out.push(v.get(i));
        }
        i = i + 1;
    }
    return out;
}

pub fn str_vec_contains_ref(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

fn str_vec_remove(v: &mut Vec<str>, s: str) {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            v.remove(i);
            return;
        }
        i = i + 1;
    }
}

fn str_vec_index(v: Vec<str>, s: str) -> i64 {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s { return i; }
        i = i + 1;
    }
    return -1;
}

// --- String-to-Type map operations ---------------------------------------

fn map_str_type_get(m: Vec<StringType>, key: str) -> OptType {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == key {
            return OptType::Some(m.get(i).val);
        }
        i = i + 1;
    }
    return OptType::None;
}

fn map_str_type_set(m: &mut Vec<StringType>, key: str, val: Type) {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == key {
            var entry: StringType = m.get(i);
            entry.val = val;
            m.set(i, entry);
            return;
        }
        i = i + 1;
    }
    m.push(StringType_new(key, val));
}

fn map_str_type_contains(m: Vec<StringType>, key: str) -> bool {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == key { return true; }
        i = i + 1;
    }
    return false;
}

// --- String-to-VecType map operations ------------------------------------

fn map_str_vectype_get(m: Vec<StringVecType>, key: str) -> OptVecType {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == key {
            return OptVecType::Some(m.get(i).val);
        }
        i = i + 1;
    }
    return OptVecType::None;
}

pub enum OptVecType {
    Some(Vec<Type>),
    None,
}

// --- String-to-VecString map operations ----------------------------------

fn map_str_vecstr_get(m: Vec<StringVecString>, key: str) -> OptVecStr {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == key {
            return OptVecStr::Some(m.get(i).val);
        }
        i = i + 1;
    }
    return OptVecStr::None;
}

pub enum OptVecStr {
    Some(Vec<str>),
    None,
}

// --- String-to-Bool map operations ---------------------------------------

fn map_str_bool_get(m: Vec<StringBool>, key: str) -> bool {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == key {
            return m.get(i).val;
        }
        i = i + 1;
    }
    return false;
}

fn map_str_bool_set(m: &mut Vec<StringBool>, key: str, val: bool) {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == key {
            // First registration wins -- don't overwrite.
            // This ensures the first module to define a function
            // determines its visibility.
            return;
        }
        i = i + 1;
    }
    m.push(StringBool_new(key, val));
}

// --- String-to-String map operations -------------------------------------

fn map_str_str_get(m: Vec<StringString>, key: str) -> OptString {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == key {
            return OptString::Some(m.get(i).val);
        }
        i = i + 1;
    }
    return OptString::None;
}

fn map_str_str_set(m: &mut Vec<StringString>, key: str, val: str) {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == key {
            // First registration wins -- don't overwrite.
            // This ensures the first module to define a function
            // is considered its owner for visibility checks.
            return;
        }
        i = i + 1;
    }
    m.push(StringString_new(key, val));
}

// --- FieldVis map operations ---------------------------------------------

fn map_fieldvis_get(m: Vec<FieldVisEntry>, struct_name: str, field_name: str) -> bool {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key.struct_name == struct_name && m.get(i).key.field_name == field_name {
            return m.get(i).val;
        }
        i = i + 1;
    }
    return true; // default to pub
}

// --- Cached lookups using HashMap index caches ---------------------------
// These use the func_cache/struct_cache/etc. HashMaps built by
// TypeChecker_build_caches to convert O(n) linear scans into O(1) lookups.
// On cache miss (cache not built or key not in cache), they fall back to
// the linear scan. This is safe because the caches are built after all
// modules are registered, so they contain all entries.

/// Cached function signature lookup. Returns the FuncSig for `name` or
/// OptFuncSig::None if not found. Uses func_cache for O(1) lookup.
pub fn TypeChecker_lookup_func_cache(self: &TypeChecker, name: str) -> OptFuncSig {
    if self.caches_built {
        var idx: i64 = HashMap_get(self.func_cache, name);
        if idx > 0 {
            return OptFuncSig::Some(self.funcs.get(idx - 1).val);
        }
        return OptFuncSig::None;
    }
    // Fallback: linear scan
    var i: i64 = 0;
    while i < self.funcs.len() {
        if self.funcs.get(i).key == name {
            return OptFuncSig::Some(self.funcs.get(i).val);
        }
        i = i + 1;
    }
    return OptFuncSig::None;
}

/// Cached const lookup. Uses const_cache for O(1) lookup.
pub fn TypeChecker_lookup_const_cache(self: &TypeChecker, name: str) -> OptType {
    if self.caches_built {
        var idx: i64 = HashMap_get(self.const_cache, name);
        if idx > 0 {
            return OptType::Some(self.consts.get(idx - 1).val);
        }
        return OptType::None;
    }
    return map_str_type_get(self.consts, name);
}

/// Cached global lookup. Uses global_cache for O(1) lookup.
pub fn TypeChecker_lookup_global_cache(self: &TypeChecker, name: str) -> OptType {
    if self.caches_built {
        var idx: i64 = HashMap_get(self.global_cache, name);
        if idx > 0 {
            return OptType::Some(self.globals.get(idx - 1).val);
        }
        return OptType::None;
    }
    return map_str_type_get(self.globals, name);
}

/// Cached type alias lookup. Uses alias_cache for O(1) lookup.
pub fn TypeChecker_lookup_alias_cache(self: &TypeChecker, name: str) -> OptType {
    if self.caches_built {
        var idx: i64 = HashMap_get(self.alias_cache, name);
        if idx > 0 {
            return OptType::Some(self.type_aliases.get(idx - 1).val);
        }
        return OptType::None;
    }
    return map_str_type_get(self.type_aliases, name);
}

/// Cached struct field lookup. Uses struct_cache for O(1) index resolution.
pub fn TypeChecker_lookup_struct_cache(self: &TypeChecker, name: str) -> OptVecStructField {
    if self.caches_built {
        var idx: i64 = HashMap_get(self.struct_cache, name);
        if idx > 0 {
            return OptVecStructField::Some(self.structs.get(idx - 1).val);
        }
        return OptVecStructField::None;
    }
    // Fallback: linear scan
    var i: i64 = TypeChecker_struct_pos_ro(self, name);
    var i_lim: i64 = i + 1;
    if i < 0 { i = 0; i_lim = 0; }
    while i < i_lim {
        if self.structs.get(i).key == name {
            return OptVecStructField::Some(self.structs.get(i).val);
        }
        i = i + 1;
    }
    return OptVecStructField::None;
}

// --- Method map operations (struct_name -> method entries) ----------------

fn map_methods_get(m: Vec<StringMethodMap>, key: str) -> OptMethodMap {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == key {
            return OptMethodMap::Some(m.get(i).val);
        }
        i = i + 1;
    }
    return OptMethodMap::None;
}

pub struct StringMethodMap {
    pub key: str,
    pub val: Vec<MethodMapEntry>,
}

pub fn StringMethodMap_new(key: str, val: Vec<MethodMapEntry>) -> StringMethodMap {
    return StringMethodMap { key: key, val: val };
}

pub enum OptMethodMap {
    Some(Vec<MethodMapEntry>),
    None,
}

pub enum OptFuncSig {
    Some(FuncSig),
    None,
}

pub enum OptVecStructField {
    Some(Vec<StructField>),
    None,
}

fn method_map_get_entry(m: Vec<MethodMapEntry>, method_name: str) -> OptMethodInfo {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == method_name {
            return OptMethodInfo::Some(m.get(i).val);
        }
        i = i + 1;
    }
    return OptMethodInfo::None;
}

pub enum OptMethodInfo {
    Some(MethodInfo),
    None,
}

fn method_map_set_entry(m: &mut Vec<MethodMapEntry>, method_name: str, info: MethodInfo) {
    var i: i64 = 0;
    while i < m.len() {
        if m.get(i).key == method_name {
            var entry: MethodMapEntry = m.get(i);
            entry.val = info;
            m.set(i, entry);
            return;
        }
        i = i + 1;
    }
    m.push(MethodMapEntry_new(method_name, info));
}

