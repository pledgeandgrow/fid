                }
                ReflectOp::FieldTypes => {
                    return Type::Array(Box::new(Type::Str), 0);
                }
                ReflectOp::EnumVariants => {
                    return Type::Array(Box::new(Type::Str), 0);
                }
                ReflectOp::StructSize => {
                    return Type::I64;
                }
                ReflectOp::FieldOffset => {
                    return Type::I64;
                }
                ReflectOp::EnumDiscriminant => {
                    return Type::I64;
                }
                ReflectOp::FunctionEffects => {
                    return Type::Array(Box::new(Type::Str), 0);
                }
                ReflectOp::FunctionCapabilities => {
                    return Type::Array(Box::new(Type::Str), 0);
                }
            }
            return Type::I64;
        }
        Expr::PipeForward(left, right) => {
            var left_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(left));
            // Desugar: if right is a Call, typecheck as call with left prepended
            match right {
                Expr::Call(callee, args) => {
                    var all_args: Vec<Expr> = Vec::new();
                    all_args.push(box_expr_unbox(left));
                    var i: i64 = 0;
                    while i < args.len() {
                        all_args.push(args.get(i));
                        i = i + 1;
                    }
                    return TypeChecker_check_expr(self, Expr::Call(callee, all_args));
                }
                Expr::MethodCall(receiver, method, args) => {
                    return TypeChecker_check_expr(self, Expr::MethodCall(left, method, args));
                }
                Expr::Ident(name) => {
                    var call_args: Vec<Expr> = Vec::new();
                    call_args.push(box_expr_unbox(left));
                    return TypeChecker_check_expr(self, Expr::Call(name, call_args));
                }
                _ => {
                    return TypeChecker_check_expr(self, box_expr_unbox(right));
                }
            }
            return Type::Never;
        }
        Expr::QuantCast(e, target_ty) => {
            TypeChecker_check_expr(self, box_expr_unbox(e));
            return TypeChecker_resolve_type(self, target_ty);
        }
        Expr::Await(inner) => {
            var inner_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(inner));
            match inner_ty {
                Type::Generic(name, args) => {
                    if name == "Future" && args.len() == 1 {
                        return args.get(0);
                    }
                }
                Type::Named(name) => {
                    if name == "Future" {
                        return Type::I64;
                    }
                }
                _ => {
                }
            }
            self.errors.push("Type error: await requires a Future<T> operand, got " + type_to_str(inner_ty) + "." + "\n    Hint: async fn functions return Future<T>.\n         spawn <expr> also returns Future<T>.");
            return Type::I64;
        }
        Expr::Spawn(inner) => {
            var inner_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(inner));
            match box_expr_unbox(inner) {
                Expr::Call(spawned, _) => {
                    self.thread_entries.push(spawned);
                }
                _ => {
                }
            }
            // @send check: any variables captured in the spawn expression
            // must be @send (safe to send across threads).
            var cap_names: Vec<str> = Vec::new();
            var cap_types: Vec<Type> = Vec::new();
            TypeChecker_collect_captured_vars(self, box_expr_unbox(inner), &mut cap_names, &mut cap_types);
            // Every argument of the spawned call too, not only the variables
            // it names (release H4): `spawn work(make_ref())`. The types are
            // taken again with the errors of that second look discarded.
            match box_expr_unbox(inner) {
                Expr::Call(_, sargs) => {
                    var ai: i64 = 0;
                    while ai < sargs.len() {
                        var saved_errs: i64 = self.errors.len();
                        var aty: Type = TypeChecker_check_expr(self, sargs.get(ai));
                        self.errors.truncate(saved_errs);
                        // BG75: a closure's captures are shared, not copied
                        TypeChecker_check_spawn_closure(self, sargs.get(ai), ai);
                        if !TypeChecker_is_send_type(self, aty) {
                            self.errors.push("Thread safety error (line " + int_to_str(self.current_line) + "): argument " + int_to_str(ai + 1) + " of the spawned call has type " + type_to_str(aty) + ", which is not @send.
    Fix: pass a value (numbers, strings, structs of such values) or mark the struct @send.");
                        } else {
                            // The thread gets a whole copy of the argument;
                            // what cannot be copied that way would be
                            // shared, and its owner counts are not atomic
                            var ce: str = TypeChecker_thread_copy_err(self, aty, 0);
                            if ce != "" {
                                self.errors.push("Thread safety error (line " + int_to_str(self.current_line) + "): argument " + int_to_str(ai + 1) + " of the spawned call cannot be copied for the new thread: " + ce + "." + "\n    A spawned thread gets its own copy of each argument, so the two threads never share memory." + "\n    Fix: pass the strings and Vecs as arguments of their own, send the value over a Channel, or share it through a Mutex.");
                            }
                        }
                        ai = ai + 1;
                    }
                }
                _ => {
                }
            }
            var ci: i64 = 0;
            while ci < cap_types.len() {
                var var_ty: Type = cap_types.get(ci);
                if !TypeChecker_is_send_type(self, var_ty) {
                    self.errors.push("Thread safety error: spawn captures variable of type " + type_to_str(var_ty) + " which is not @send. Only @send types can be safely sent across threads.");
                }
                ci = ci + 1;
            }
            match inner_ty {
                Type::Generic(name, args) => {
                    if name == "Future" {
                        return inner_ty;
                    }
                }
                Type::Named(name) => {
                    if name == "Future" {
                        return inner_ty;
                    }
                }
                _ => {
                }
            }
            // Wrap non-Future in Future<T>
            var future_args: Vec<Type> = Vec::new();
            future_args.push(inner_ty);
            return Type::Generic("Future", future_args);
        }
        Expr::Yield(inner) => {
            TypeChecker_check_expr(self, box_expr_unbox(inner));
            return Type::Never;
        }
        Expr::NamedArg(name, e) => {
            TypeChecker_check_expr(self, box_expr_unbox(e));
            return Type::Never;
        }
    }
    return Type::Never;
}

// ---- CHUNK_MARKER_8 ----

// --- check_method_call ---------------------------------------------------

// 2g.66: `map`, `filter`, `for_each`, `fold`, `any`, `all`, `find` and
// `position` on a Vec are not builtins: core's `impl Vec` defines them (the
// prelude, reference §13.3; they were stdlib/vec.fd's, and a call without
// `use vec;` type-checked, then `fid run` panicked with "Unknown function
// 'Vec_map'"). stdlib/vec.fd's `impl Vec` defines the other names below, so
// those need `use vec;`. They all pass every element and result as a 64-bit
// word in an integer register, so an element or a function result that is a
// float, a struct or an enum is not carried either. Reports the error and
// returns false when the call cannot run.
fn TypeChecker_vec_lib_method_ok(self: &mut TypeChecker, method: str, elem_ty: Type, arg_types: Vec<Type>) -> bool {
    var lib: bool = method == "map" || method == "filter" || method == "for_each" || method == "fold" || method == "any" || method == "all" || method == "find" || method == "position" || method == "find_opt" || method == "position_opt" || method == "take" || method == "skip" || method == "zip" || method == "enumerate" || method == "flat_map" || method == "chunk" || method == "window" || method == "dedup" || method == "sort_by" || method == "contains_val";
    if !lib {
        return true;
    }
    if TypeChecker_method_find(self, "Vec", method) < 0 {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): Vec has no method '" + method + "' in this program: `" + method + "` is defined by stdlib/vec.fd.\n    Fix: add `use vec;` to the file, or write the loop (`for i in 0..v.len() { ... }`).");
        return false;
    }
    var bad: str = "";
    if !TypeChecker_vec_word_type(self, elem_ty) {
        bad = "a Vec<" + type_to_str(elem_ty) + ">";
    }
    if bad == "" && method == "map" && arg_types.len() > 0 {
        match arg_types.get(arg_types.len() - 1) {
            Type::Func(_, fret) => {
                var rt: Type = box_type_unbox(fret);
                if !TypeChecker_vec_word_type(self, rt) {
                    bad = "a function that returns " + type_to_str(rt);
                }
            }
            _ => {
            }
        }
    }
    if bad != "" {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): Vec." + method + " (stdlib/vec.fd) carries each element as an integer word, so it cannot take " + bad + ".\n    Fix: build the result with a loop and `push` (`for i in 0..v.len() { out.push(f(v.get(i))); }`).");
        return false;
    }
    return true;
}

// Whether a value of type `t` is passed and returned in an integer register
// (an integer, bool, char, str, Vec or HashMap handle), as stdlib/vec.fd's
// `fn(i64) -> i64` calls need. Unknown types (Infer, a type parameter) pass.
fn TypeChecker_vec_word_type(self: &mut TypeChecker, t: Type) -> bool {
    match t {
        Type::F32 => {
            return false;
        }
        Type::F64 => {
            return false;
        }
        Type::Tuple(_) => {
            return false;
        }
        Type::Named(n) => {
            if n == "Vec" || n == "HashMap" || n == "String" {
                return true;
            }
            if tc_is_struct(self, n) || TypeChecker_enum_pos(self, n) >= 0 {
                return false;
            }
        }
        Type::Generic(gn, _) => {
            if gn == "Vec" || gn == "HashMap" || gn == "Box" {
                return true;
            }
            return false;
        }
        _ => {
        }
    }
    return true;
}

/// LG4: a call of the generic method `owner.method` (`fn m<U: B>(..)`):
/// its type parameters `tps` bound from the arguments (`params` are the
/// method's parameter types without `self`, `ret` its result, both with the
/// impl's own parameters already replaced), then from the expected type;
/// each argument checked against its instantiated parameter and each bound
/// against the type it binds. The call's type is the instantiated result,
/// as monomorphization makes it (mono.fd: `Owner__method__T`).
fn TypeChecker_lg4_method_call(self: &mut TypeChecker, owner: str, method: str, tps: Vec<str>, bounds: Vec<StrPair>, params: Vec<Type>, ret: Type, arg_types: Vec<Type>, hint: Type) -> Type {
    var names: Vec<str> = Vec::new();
    var types: Vec<Type> = Vec::new();
    var i: i64 = 0;
    while i < params.len() && i < arg_types.len() {
        tc_bind_type_params(params.get(i), arg_types.get(i), tps, &mut names, &mut types);
        i = i + 1;
    }
    if !type_eq(hint, Type::Never) && !type_eq(hint, Type::Infer) {
        tc_bind_type_params(ret, hint, tps, &mut names, &mut types);
    }
    var in_fn: str = "";
    match self.current_func_name {
        OptString::Some(fname) => {
            in_fn = ", in '" + fname + "'";
        }
        OptString::None => {
        }
    }
    var callee: str = owner + "." + method;
    // (the argument count is not checked here: as for any method call, the
    // arguments are paired with the parameters they reach)
    var unknown_arg: bool = false;
    i = 0;
    while i < arg_types.len() {
        if type_eq(arg_types.get(i), Type::Infer) || type_eq(arg_types.get(i), Type::Never) {
            unknown_arg = true;
        }
        i = i + 1;
    }
    i = 0;
    while i < tps.len() && !unknown_arg {
        if !str_vec_contains(names, tps.get(i)) {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): cannot infer the type parameter '" + tps.get(i) + "' of method '" + callee + "': no argument gives it.\n    Fix: give the result a type, as in `val x: i64 = v." + method + "(...)`.");
            return Type::Never;
        }
        i = i + 1;
    }
    i = 0;
    while i < params.len() && i < arg_types.len() {
        var pt: Type = tc_subst_type_params(params.get(i), names, types);
        var a: Type = arg_types.get(i);
        if !TypeChecker_type_contains_param(self, pt) && !type_eq(a, Type::Infer) && !type_eq(a, Type::Never) && !TypeChecker_arg_compatible(self, pt, a) {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): method '" + callee + "' parameter " + int_to_str(i + 1) + " expects '" + type_to_str(pt) + "', got '" + type_to_str(a) + "'");
        }
        i = i + 1;
    }
    var bi: i64 = 0;
    while bi < bounds.len() {
        var tp: str = bounds.get(bi).a;
        var tr: str = bounds.get(bi).b;
        bi = bi + 1;
        var k: i64 = 0;
        var found: bool = false;
        var bty: Type = Type::Infer;
        while k < names.len() {
            if names.get(k) == tp {
                bty = types.get(k);
                found = true;
            }
            k = k + 1;
        }
        if !found || !TypeChecker_is_trait_name(self, tr) || TypeChecker_satisfies_bound(self, bty, tr) {
            continue;
        }
        self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): " + type_to_str(bty) + " does not implement " + tr + " (required by " + tp + ": " + tr + " in method '" + callee + "').\n    Fix: add `impl " + tr + " for " + type_to_str(bty) + " { ... }`, or pass a value whose type implements it.");
    }
    var r: Type = tc_subst_type_params(ret, names, types);
    if TypeChecker_type_contains_param(self, r) {
        return Type::Never;
    }
    return r;
}

/// BG18: the arguments of a call of a user method or associated function
/// against its parameters from `first` on (1 skips the receiver of
/// `x.m(..)`, 0 checks all of an `S::f(..)`). Before, a method call checked
/// neither: `p.set()` and `p.set("a", 1, 2)` were accepted (the lowering
/// passed what was given, the callee read garbage), and so was
/// `P::make("str")` for `fn make(n: i64)` (only the count was checked
/// there). The number must lie between the parameters without a default
/// and all of them; each type is checked as a function call's is
/// (TypeChecker_arg_compatible), with the impl's type parameters replaced
/// by `names` -> `types` (a receiver's type arguments). A parameter still
/// naming a type parameter (or `Self`), an argument whose type is not known
/// (an error already reported, an untyped value), named arguments and a
/// variadic method are not checked further; `check_types` false checks the
/// number only (a generic method, whose types are bound at the call
/// elsewhere). `what` names the callee in the message ("method 'P.set'"),
/// `key` is its item name (`P_set`), for the runtime layer's i64 handles.
fn TypeChecker_check_method_args(self: &mut TypeChecker, what: str, key: str, info: MethodInfo, first: i64, args: Vec<Expr>, arg_types: Vec<Type>, names: Vec<str>, types: Vec<Type>, check_types: bool) {
    if info.variadic {
        return;
    }
    var ai: i64 = 0;
    while ai < args.len() {
        match args.get(ai) {
            Expr::NamedArg(_, _) => {
                return;
            }
            _ => {
            }
        }
        ai = ai + 1;
    }
    var max_n: i64 = info.param_types.len() - first;
    var min_n: i64 = info.min_args - first;
    if min_n < 0 {
        min_n = 0;
    }
    if max_n < 0 {
        max_n = 0;
    }
    var in_fn: str = "";
    match self.current_func_name {
        OptString::Some(fname) => {
            in_fn = ", in '" + fname + "'";
        }
        OptString::None => {
        }
    }
    if arg_types.len() < min_n || arg_types.len() > max_n {
        var want: str = int_to_str(max_n);
        if min_n < max_n {
            want = int_to_str(min_n) + "-" + int_to_str(max_n);
        }
        self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): " + what + " expects " + want + " args, got " + int_to_str(arg_types.len()));
        return;
    }
    if !check_types {
        return;
    }
    var i: i64 = 0;
    while i < arg_types.len() && i + first < info.param_types.len() {
        var raw: Type = info.param_types.get(i + first);
        var pt: Type = TypeChecker_resolve_type(self, tc_subst_type_params(raw, names, types));
        var a: Type = arg_types.get(i);
        // BG153: a bare type parameter (`x: T`) is checked once the receiver
        // gives it a type (`Cell<i64>.put("oops")`); one left unbound (a
        // method's own `U`) is not
        if !TypeChecker_type_contains_param(self, pt) && !tc_bare_param_unbound(raw, names) && !type_eq(a, Type::Infer) && !type_eq(a, Type::Never) && !TypeChecker_arg_compatible(self, pt, a) && !(is_handle_int_pair(pt, tc_read_through(a)) && TypeChecker_is_runtime_call(self, key)) {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + in_fn + "): " + what + " parameter " + int_to_str(i + 1) + " expects '" + type_to_str(pt) + "', got '" + type_to_str(a) + "'");
        }
        i = i + 1;
    }
}

/// LG4: the parameter types of a method after `self` (all of them for an
/// associated function).
fn tc_lg4_args_of(param_types: Vec<Type>, has_self: bool) -> Vec<Type> {
    var out: Vec<Type> = Vec::new();
    var i: i64 = 0;
    if has_self {
        i = 1;
    }
    while i < param_types.len() {
        out.push(param_types.get(i));
        i = i + 1;
    }
    return out;
}

pub fn TypeChecker_check_method_call(self: &mut TypeChecker, receiver: Expr, method: str, args: Vec<Expr>, hint: Type) -> Type {
    // Check if this is Box::new(x), Rc::new(x), Arc::new(x), Vec::new(), HashMap::new()
    match receiver {
        Expr::Ident(name) => {
            if self.region_budgets.len() > 0 && str_len(name) > 0 && str_byte_at(name, 0) >= 65 && str_byte_at(name, 0) <= 90 && !TypeChecker_is_local_var(self, name) {
                TypeChecker_budget_call(self, name + "_" + method, args);
            }
            if (name == "Box" || name == "Rc" || name == "Arc") && method == "new" {
                if args.len() > 0 {
                    // The declared element type says what the argument is
                    // (`val b: Box<i64> = Box::new(41)`); a literal that
                    // names no type is an i64 (reference §7.2)
                    var bn_hint: Type = Type::Never;
                    match hint {
                        Type::Generic(bhn, bhargs) => {
                            if bhn == name && bhargs.len() == 1 {
                                bn_hint = bhargs.get(0);
                            }
                        }
                        _ => {
                        }
                    }
                    var arg_ty: Type = TypeChecker_check_expr_with_hint(self, args.get(0), bn_hint);
                    // ... the rule is for a call that names no type: a
                    // declared `Box<i8>` keeps its literal an i8
                    if type_eq(bn_hint, Type::Never) && tc_int_bits(arg_ty) > 0 && tc_int_bits(arg_ty) < 64 && tc_is_constant_expr(args.get(0)) {
                        arg_ty = Type::I64;
                    }
                    var box_args: Vec<Type> = Vec::new();
                    box_args.push(arg_ty);
                    // OW4 fixed: an Rc or an Arc holds any T — a counted cell
                    // that owns what it holds (the lowerer's tagged block).
                    // Not a fixed array: a [T; N] value is the pointer to its
                    // data (no cell of its own to count owners of)
                    var rc_is_array: bool = false;
                    match arg_ty {
                        Type::Array(_, _) => {
                            rc_is_array = true;
                        }
                        Type::ArrayConst(_, _) => {
                            rc_is_array = true;
                        }
                        _ => {
                        }
                    }
                    if (name == "Rc" || name == "Arc") && rc_is_array {
                        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + name + "<T> does not hold a fixed array ([T; N] is the address of its data).\n    Fix: hold the values in a Vec<T>, or hold a struct that has the array.");
                    }
                    return Type::Generic(name, box_args);
                }
            }
            if name == "Vec" && method == "new" {
                match hint {
                    Type::Generic(hn, hargs) => {
                        if hn == "Vec" {
                            return Type::Generic("Vec", hargs);
                        }
                    }
                    _ => {
                    }
                }
                // No declared element type: a bare Vec
                return Type::Named("Vec");
            }
            // `Vec::filled(n, x)`: n elements, each x (Rust's vec![x; n])
            if name == "Vec" && method == "filled" && args.len() == 2 {
                var fn_ty: Type = TypeChecker_check_expr(self, args.get(0));
                if !TypeChecker_is_integer(self, fn_ty) {
                    self.errors.push("Type error: Vec::filled takes a length (an integer) first, got " + type_to_str(fn_ty));
                }
                var fe_hint: Type = Type::Infer;
                match hint {
                    Type::Generic(fhn, fhargs) => {
                        if fhn == "Vec" && fhargs.len() == 1 {
                            fe_hint = fhargs.get(0);
                        }
                    }
                    _ => {
                    }
                }
                var fx_ty: Type = TypeChecker_check_expr_with_hint(self, args.get(1), fe_hint);
                var felem: Type = fx_ty;
                match fe_hint {
                    Type::Infer => {
                    }
                    _ => {
                        felem = fe_hint;
                    }
                }
                // Struct and enum elements are boxed one by one: push them
                var fen: str = "";
                match felem {
                    Type::Named(fnn) => {
                        fen = fnn;
                    }
                    Type::Generic(fgn, _) => {
                        if fgn != "Vec" && fgn != "HashMap" {
                            fen = fgn;
                        }
                    }
                    _ => {
                    }
                }
                if fen != "" && fen != "Vec" && fen != "HashMap" && fen != "String" && (tc_is_struct(self, fen) || TypeChecker_enum_pos(self, fen) >= 0) {
                    self.errors.push("Type error: Vec::filled makes Vecs of numbers, bools, strings, Vecs or maps; a Vec of " + fen + " is made with push");
                }
                var fargs: Vec<Type> = Vec::new();
                fargs.push(felem);
                return Type::Generic("Vec", fargs);
            }
            if name == "HashMap" && method == "new" {
                match hint {
                    Type::Generic(hn, hargs) => {
                        if hn == "HashMap" && hargs.len() == 2 {
                            return Type::Generic("HashMap", hargs);
                        }
                    }
                    _ => {
                    }
                }
                var default_args: Vec<Type> = Vec::new();
                default_args.push(Type::Str);
                default_args.push(Type::I64);
                return Type::Generic("HashMap", default_args);
            }
            if name == "String" && method == "from" {
                if args.len() > 0 {
                    TypeChecker_check_expr(self, args.get(0));
                }
                return Type::Named("String");
            }
            // Check if it's an associated function call (e.g. Point::new(x, y))
            // Check if name is a known struct
            var si: i64 = TypeChecker_struct_pos(self, name);
            var si_lim: i64 = si + 1;
            if si < 0 {
                si = 0;
                si_lim = 0;
            }
            while si < si_lim {
                if self.structs.get(si).key == name {
                    var arg_types: Vec<Type> = Vec::new();
                    var ai: i64 = 0;
                    while ai < args.len() {
                        arg_types.push(TypeChecker_check_expr(self, args.get(ai)));
                        ai = ai + 1;
                    }
                    // Find method in method map
                    var mei: i64 = TypeChecker_method_find(self, name, method);
                    if mei >= 0 {
                        var info: MethodInfo = self.methods.get(TypeChecker_methods_at(self, name)).val.get(mei).val;
                        TypeChecker_warn_deprecated_method(self, name, method);
                        // Release M10: `S::f(..)` of an @unsafe f
                        TypeChecker_require_unsafe_call(self, name + "_" + method, name + "::" + method);
