// Region budget: (name, budget, usage)
pub struct RegionBudget {
    pub name: str,
    pub budget: OptI64,
    pub usage: i64,
    // The first heap allocation whose size is not known at compile time
    // ("" when there is none)
    pub heap: str,
    // A kv_cache region: its budget is the cache's, bounded by its window
    pub kv: bool,
    // The loop depth at the region's start: a constant-size allocation in a
    // loop inside the region has no constant total
    pub loop0: i64,
}

pub fn RegionBudget_new(name: str, budget: OptI64, usage: i64) -> RegionBudget {
    return RegionBudget { name: name, budget: budget, usage: usage, heap: "", kv: false, loop0: 0 };
}

