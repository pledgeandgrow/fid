// --- Type aliases for nested Vec types (Fides can't parse Vec<Vec<...>>) -

pub type ScopeStack = Vec<ScopeEntry>;
pub type LinearVarStack = Vec<LinearVar>;
pub type StrStack = Vec<str>;
pub type StmtList = Vec<Stmt>;
pub type AnnList = Vec<Annotation>;
// --- TypeChecker struct --------------------------------------------------

pub struct TypeChecker {
    // Symbol tables
    scopes: Vec<ScopeStack>,
    // var_name -> Type (per scope)
    funcs: Vec<StringFuncSig>,
    // func_name -> (params, box_type_unbox(ret)) -- stored as FuncSig in a wrapper
    structs: Vec<StringStructFields>,
    // struct_name -> fields
    enums: Vec<str>,
    // enum names
    enum_variants: Vec<StringEnumVariants>,
    // enum_name -> variants
    enum_type_params: Vec<StringVecString>,
    // enum_name -> type params
    enum_tp_set: i64,
    // every name in enum_type_params (HashMap set, D10)
    consts: Vec<StringType>,
    // const_name -> Type
    globals: Vec<StringType>,
    // global_name -> Type (module-level mutable globals)
    type_aliases: Vec<StringType>,
    // alias_name -> Type
    methods: Vec<StringMethodMap>,
    // struct_name -> method map
    current_type_params: Vec<str>,
    // current function's type params
    current_type_param_bounds: Vec<StringString>,
    // type_param -> trait_name
    // Bodies not to check: "fn:name", "impl:Type:method", "trait:Type:method"
    // (core, when an earlier build checked the same core clean; release D9).
    // 0 = check everything.
    pub skip_bodies: i64,
    /// `@scoped` structs: their str fields read as borrowed `&str` (M11)
    pub scoped_structs: Vec<str>,
    // struct name -> index in methods + 1, filled lazily (release D10: a
    // method call scanned every struct's method table by name)
    methods_index: i64,
    methods_indexed: i64,
    // methods[i] -> HashMap(method name -> inner index + 1), 0 = not built.
    // A method call used to scan the type's whole method Vec by name (CS8).
    // Dropped (set to 0) when methods[i] is rewritten.
    methods_hm: Vec<i64>,
    // Struct and enum name -> 1 + position, filled as entries are added
    // (TypeChecker_struct_pos, TypeChecker_enum_pos): a lookup by name
    // used to scan every struct and enum (D10)
    sname_index: i64,
    sname_indexed: i64,
    ename_index: i64,
    ename_indexed: i64,
    // Generic functions (proposal 0002): name, type parameters, bounds
    func_generic_names: Vec<str>,
    func_generic_tps: Vec<Vec<str>>,
    func_generic_bounds: Vec<Vec<StrPair>>,
    // "Trait:Type" for every `impl Trait for Type`
    impl_pairs: Vec<str>,
    // Type parameters of each generic impl: `impl<T> Slot` -> Slot, [T]
    impl_tp_names: Vec<str>,
    impl_tp_lists: Vec<Vec<str>>,
    // The current function's by-value parameters holding a Vec, HashMap or
    // struct, with their types: they are read-only (proposal 0001)
    value_param_names: Vec<str>,
    value_param_types: Vec<Type>,
    traits: Vec<StringTraitMethodMap>,
    // trait_name -> methods
    trait_assoc_types: Vec<StringVecString>,
    // trait_name -> assoc type names
    trait_impl_assoc_bindings: Vec<TraitImplAssocEntry>,
    // (trait,type) -> bindings
    item_modules: Vec<StringString>,
    // item_name -> module_name
    item_visibility: Vec<StringBool>,
    // item_name -> is_pub
    field_visibility: Vec<FieldVisEntry>,
    // (struct,field) -> is_pub
    struct_modules: Vec<StringString>,
    // struct_name -> module_name

    // State
    pub current_module: str,
    pub errors: Vec<str>,
    pub warnings: Vec<str>,
    granted_caps: Vec<str>,
    strict_caps: bool,
    func_effects: Vec<StringVecStrTc>,
    // func_name -> effect names
    ho_param_effects: Vec<StringVecStrTc>,
    // param_name -> conservative effects (effect polymorphism)
    region_stack: Vec<str>,
    var_regions: Vec<StringString>,
    // var_name -> region_name
    freed_regions: Vec<str>,
    cap_verified: Vec<str>,
    current_func_name: OptString,
    // CE6: "fn:name" for each undefined name already reported, so that later
    // uses of it in the same function add no error
    reported_undefined: Vec<str>,
    // CA6: how many `spawn scope { }` bodies enclose the statement being
    // checked, and the handles of tasks started by `val t = spawn f(..)`
    // outside a scope not read yet in this function (name, line)
    ca6_scope_depth: i64,
    ca6_names: Vec<str>,
    ca6_lines: Vec<i64>,
    // HashMaps: name -> slot + 1 in the table of the same name
    func_effects_index: i64,
    // Functions that allocate on the heap, themselves or through what they
    // call (name, and Type.method / Type_method for methods) -> 1. Computed
    // only for programs with a `region .. with budget(N)`.
    heap_alloc_index: i64,
    ffi_reach_index: i64,
    ho_param_effects_index: i64,
    /// Effect polymorphism: the function-typed parameters of the function
    /// whose body is being scanned (calls through them add no effect there),
    /// and per higher-order function its function-typed parameters' indexes.
    cur_ho_params: Vec<str>,
    ho_fn_index: i64,
    ho_fn_idx: Vec<Vec<i64>>,
    ho_fn_pnames: Vec<Vec<str>>,
    item_modules_index: i64,
    item_visibility_index: i64,
    struct_modules_index: i64,
    // Method calls resolved to a user impl while bodies are checked:
    // calling function, type, method. See verify_method_calls.
    method_call_callers: Vec<str>,
    method_call_owners: Vec<str>,
    method_call_names: Vec<str>,
    current_return_types: Vec<Type>,
    current_ret_ty: OptType,
    // declared return type of the body being checked
    extern_fns: Vec<str>,
    // extern "C" function names (FFI boundary)
    current_self_type: OptString,
    sandbox_depth: i64,
    in_conserve: bool,
    // checking a @conserve function
    in_no_alloc: bool,
    // checking a @no-alloc function (or a composite that expands to it)
    txn_depth: i64,
    // inside txn { } blocks
    struct_tp_names: Vec<str>,
    // generic structs ...
    struct_tp_lists: Vec<Vec<str>>,
    // ... and their type parameters
    gpu_region_depth: i64,
    region_budgets: Vec<RegionBudget>,
    region_lines: Vec<StringString>,
    var_alloc_lines: Vec<StringString>,
    linear_structs: Vec<str>,
    send_structs: Vec<str>,
    sync_structs: Vec<str>,
    consumed_vars: Vec<str>,
    scope_linear_vars: Vec<LinearVarStack>,
    loop_depth: i64,
    unsafe_depth: i64,
    // The function being checked, the functions started on another thread,
    // and each write to a global in the program (three parallel lists)
    checking_fn: str,
    thread_entries: Vec<str>,
    write_funcs: Vec<str>,
    write_globals: Vec<str>,
    write_lines: Vec<i64>,
    uninit_vars: Vec<str>,
    current_line: i64,
    val_vars_per_scope: Vec<StrStack>,
    check_depth: i64,

    // Memoization caches — HashMap-based index caches for O(1) lookups.
    // These are populated during register_program and used during check_bodies.
    // They convert O(n) linear scans of the Vec<StringXxx> tables into O(1)
    // hash lookups. With 100K+ LOC of compiler code, there are thousands of
    // functions/structs/enums, making each linear scan expensive.
    func_cache: i64,
    // HashMap: func_name → index in funcs Vec (-1 = not found)
    struct_cache: i64,
    // HashMap: struct_name → index in structs Vec (-1 = not found)
    enum_cache: i64,
    // HashMap: enum_name → index in enums Vec (-1 = not found)
    const_cache: i64,
    // HashMap: const_name → index in consts Vec (-1 = not found)
    global_cache: i64,
    // HashMap: global_name → index in globals Vec (-1 = not found)
    alias_cache: i64,
    // HashMap: alias_name → index in type_aliases Vec (-1 = not found)
    caches_built: bool,
    // whether index caches have been populated
    // "Struct.field" -> 1 + index into private_field_modules, for fields
    // not marked pub (field privacy, src/typechecker.rs).
    private_fields: i64,
    private_field_modules: Vec<str>,
    // CL5: "Struct.field" -> 1 + index into field_default_exprs, for a
    // field declared with a default (`port: i64 = 8080`)
    field_default_at: i64,
    field_default_exprs: Vec<Expr>,
    // CL4: function name -> 1 + index into fn_pnames / fn_pdefaults: its
    // parameter names and which have a default, for named arguments
    fn_pnames_at: i64,
    fn_pnames: Vec<Vec<str>>,
    fn_pdefaults: Vec<Vec<bool>>,
    // CU3: function name -> 1 + index into deprecated_msgs, for a
    // function marked @deprecated (the message: what to use instead)
    deprecated_at: i64,
    deprecated_msgs: Vec<str>,
    // 2g.27: the functions (and `Type_method`s) of the program registered
    // last, the one being compiled: a body of one of them is never tagged
    // with another module, even when an import or core defines the same
    // name first (item_modules keeps the first)
    last_fn_names: i64,
}

// Additional helper structs for TypeChecker fields

pub struct StringStructFields {
    pub key: str,
    pub val: Vec<StructField>,
}

pub fn StringStructFields_new(key: str, val: Vec<StructField>) -> StringStructFields {
    return StringStructFields {
        key: key, val: val
    };
}

pub struct StringEnumVariants {
    pub key: str,
    pub val: Vec<EnumVariantEntry>,
}

pub fn StringEnumVariants_new(key: str, val: Vec<EnumVariantEntry>) -> StringEnumVariants {
    return StringEnumVariants {
        key: key, val: val
    };
}

pub struct StringVecStrTc {
    pub key: str,
    pub val: Vec<str>,
}

pub fn StringVecStrTc_new(key: str, val: Vec<str>) -> StringVecStrTc {
    return StringVecStrTc {
        key: key, val: val
    };
}

pub struct StringI64 {
    pub key: str,
    pub val: i64,
}

pub fn StringI64_new(key: str, val: i64) -> StringI64 {
    return StringI64 {
        key: key, val: val
    };
}

pub struct TraitImplAssocEntry {
    pub key: TraitImplKey,
    pub val: Vec<StringType>,
}

pub fn TraitImplAssocEntry_new(key: TraitImplKey, val: Vec<StringType>) -> TraitImplAssocEntry {
    return TraitImplAssocEntry {
        key: key, val: val
    };
}

// FuncSig stored in funcs map -- we need a different wrapper
pub struct StringFuncSig {
    pub key: str,
    pub val: FuncSig,
}

pub fn StringFuncSig_new(key: str, val: FuncSig) -> StringFuncSig {
    return StringFuncSig {
        key: key, val: val
    };
}

// --- TypeChecker implementation ------------------------------------------

/// Free the typechecker's index maps (raw handles, which ownership does
/// not drop) once checking is over; nothing reads them after.
pub fn TypeChecker_free_maps(self: &mut TypeChecker) {
    HashMap_drop(self.enum_tp_set);
    self.enum_tp_set = HashMap_new();
    HashMap_drop(self.methods_index);
    self.methods_index = HashMap_new();
    var hm_i: i64 = 0;
    while hm_i < self.methods_hm.len() {
        var hm: i64 = self.methods_hm.get(hm_i);
        if hm != 0 {
            HashMap_drop(hm);
        }
        hm_i = hm_i + 1;
    }
    self.methods_hm = Vec::new();
    HashMap_drop(self.sname_index);
    self.sname_index = HashMap_new();
    HashMap_drop(self.ename_index);
    self.ename_index = HashMap_new();
    HashMap_drop(self.func_effects_index);
    self.func_effects_index = HashMap_new();
    HashMap_drop(self.heap_alloc_index);
    self.heap_alloc_index = HashMap_new();
    HashMap_drop(self.ffi_reach_index);
    self.ffi_reach_index = HashMap_new();
    HashMap_drop(self.ho_param_effects_index);
    self.ho_param_effects_index = HashMap_new();
    HashMap_drop(self.ho_fn_index);
    self.ho_fn_index = HashMap_new();
    HashMap_drop(self.item_modules_index);
    self.item_modules_index = HashMap_new();
    HashMap_drop(self.item_visibility_index);
    self.item_visibility_index = HashMap_new();
    HashMap_drop(self.struct_modules_index);
    self.struct_modules_index = HashMap_new();
    HashMap_drop(self.func_cache);
    self.func_cache = HashMap_new();
    HashMap_drop(self.private_fields);
    self.private_fields = HashMap_new();
    HashMap_drop(self.struct_cache);
    self.struct_cache = HashMap_new();
    HashMap_drop(self.enum_cache);
    self.enum_cache = HashMap_new();
    HashMap_drop(self.const_cache);
    self.const_cache = HashMap_new();
    HashMap_drop(self.global_cache);
    self.global_cache = HashMap_new();
    HashMap_drop(self.alias_cache);
    self.alias_cache = HashMap_new();
    HashMap_drop(self.field_default_at);
    self.field_default_at = HashMap_new();
    HashMap_drop(self.fn_pnames_at);
    self.fn_pnames_at = HashMap_new();
    HashMap_drop(self.deprecated_at);
    self.deprecated_at = HashMap_new();
    self.ename_indexed = 0;
}

impl TypeChecker {

    pub fn new() -> TypeChecker {
        // L8H: the specializations of an earlier check are not this one's
        g_tc_specs = Vec::new();
        g_tc_spec_seen = 0;
        g_tc_mspecs = Vec::new();
        g_tc_mspec_structs = Vec::new();
        // RT6: nor are the untyped Vecs it typed
        rt6_reset();
        // M2/M10: nor its program's module and @unsafe functions
        g_tc_program_module = "";
        g_tc_unsafe_fns = 0;
        var tc: TypeChecker = TypeChecker {
            scopes: Vec::new(), funcs: Vec::new(), structs: Vec::new(), enums: Vec::new(), enum_variants: Vec::new(), enum_type_params: Vec::new(), enum_tp_set: HashMap_new(), consts: Vec::new(), globals: Vec::new(), type_aliases: Vec::new(), methods: Vec::new(), current_type_params: Vec::new(), current_type_param_bounds: Vec::new(), skip_bodies: 0, scoped_structs: Vec::new(), methods_index: HashMap_new(), methods_indexed: 0, methods_hm: Vec::new(), sname_index: HashMap_new(), sname_indexed: 0, ename_index: HashMap_new(), ename_indexed: 0, func_generic_names: Vec::new(), func_generic_tps: Vec::new(), func_generic_bounds: Vec::new(), impl_pairs: Vec::new(), impl_tp_names: Vec::new(), impl_tp_lists: Vec::new(), value_param_names: Vec::new(), value_param_types: Vec::new(), traits: Vec::new(), trait_assoc_types: Vec::new(), trait_impl_assoc_bindings: Vec::new(), item_modules: Vec::new(), item_visibility: Vec::new(), field_visibility: Vec::new(), struct_modules: Vec::new(), current_module: "", errors: Vec::new(), warnings: Vec::new(), granted_caps: Vec::new(), strict_caps: false, func_effects: Vec::new(), ho_param_effects: Vec::new(), region_stack: Vec::new(), var_regions: Vec::new(), freed_regions: Vec::new(), cap_verified: Vec::new(), current_func_name: OptString::None, reported_undefined: Vec::new(), ca6_scope_depth: 0, ca6_names: Vec::new(), ca6_lines: Vec::new(), func_effects_index: HashMap_new(), heap_alloc_index: HashMap_new(), ffi_reach_index: HashMap_new(), ho_param_effects_index: HashMap_new(), cur_ho_params: Vec::new(), ho_fn_index: HashMap_new(), ho_fn_idx: Vec::new(), ho_fn_pnames: Vec::new(), item_modules_index: HashMap_new(), item_visibility_index: HashMap_new(), struct_modules_index: HashMap_new(), method_call_callers: Vec::new(), method_call_owners: Vec::new(), method_call_names: Vec::new(), current_return_types: Vec::new(), current_ret_ty: OptType::None, extern_fns: Vec::new(), current_self_type: OptString::None, sandbox_depth: 0, in_conserve: false, in_no_alloc: false, txn_depth: 0, struct_tp_names: Vec::new(), struct_tp_lists: Vec::new(), gpu_region_depth: 0, region_budgets: Vec::new(), region_lines: Vec::new(), var_alloc_lines: Vec::new(), linear_structs: Vec::new(), send_structs: Vec::new(), sync_structs: Vec::new(), consumed_vars: Vec::new(), scope_linear_vars: Vec::new(), loop_depth: 0, unsafe_depth: 0, checking_fn: "", thread_entries: Vec::new(), write_funcs: Vec::new(), write_globals: Vec::new(), write_lines: Vec::new(), uninit_vars: Vec::new(), current_line: 0, val_vars_per_scope: Vec::new(), check_depth: 0, func_cache: HashMap_new(), private_fields: HashMap_new(), private_field_modules: Vec::new(), struct_cache: HashMap_new(), enum_cache: HashMap_new(), const_cache: HashMap_new(), global_cache: HashMap_new(), alias_cache: HashMap_new(), caches_built: false, field_default_at: HashMap_new(), field_default_exprs: Vec::new(), fn_pnames_at: HashMap_new(), fn_pnames: Vec::new(), fn_pdefaults: Vec::new(), deprecated_at: HashMap_new(), deprecated_msgs: Vec::new(), last_fn_names: HashMap_new(),
        };
        // Push initial scope
        tc.scopes.push(Vec::new());
        tc.scope_linear_vars.push(Vec::new());
        tc.val_vars_per_scope.push(Vec::new());
        return tc;
    }

    pub fn check(self: &mut TypeChecker, program: Program) -> bool {
        var module: str = "main";
        match program.module {
            OptStr::Some(m) => {
                module = m;
            }
            OptStr::None => {
                module = "main";
            }
        }
        TypeChecker_register_program(self, program, module);
        TypeChecker_check_bodies(self, program);
        // Run lints (only generate warnings, never errors)
        TypeChecker_lint_unused_functions(self, program);
        TypeChecker_lint_unused_imports(self, program);
        return self.errors.len() == 0;
    }

    pub fn run_lints(self: &mut TypeChecker, program: Program) {
        TypeChecker_lint_unused_functions(self, program);
        TypeChecker_lint_unused_imports(self, program);
        TypeChecker_lint_blocking_in_tasks(self, program);
    }

    // ---- CHUNK_MARKER ----
}

// --- Registration functions (free functions taking &mut TypeChecker) -----

/// One enum's name, variants and type parameters (register_program, and
/// register_generated_decls for an enum `comptime gen` adds).
fn TypeChecker_register_enum(self: &mut TypeChecker, e: EnumDef, module: str) {
    self.enums.push(e.name);
    TypeChecker_set_item_module(self, e.name, module);
    TypeChecker_set_item_visibility(self, e.name, e.is_pub);
    var variants: Vec<EnumVariantEntry> = Vec::new();
    var vi: i64 = 0;
    while vi < e.variants.len() {
        var v: EnumVariant = e.variants.get(vi);
        var tys: Vec<Type> = Vec::new();
        match v.data {
            OptParams::Some(params) => {
                var pi: i64 = 0;
                while pi < params.len() {
                    tys.push(params.get(pi).ty);
                    pi = pi + 1;
                }
            }
            OptParams::None => {
            }
        }
        variants.push(EnumVariantEntry_new(v.name, tys));
        vi = vi + 1;
    }
    self.enum_variants.push(StringEnumVariants_new(e.name, variants));
    self.enum_type_params.push(StringVecString_new(e.name, e.type_params));
    var etp: i64 = 0;
    while etp < e.type_params.len() {
        HashMap_insert(self.enum_tp_set, e.type_params.get(etp), 1);
        etp = etp + 1;
    }
}

/// CL5: the defaults a struct's fields declare (`port: i64 = 8080`), for a
/// literal ending in `..`. The first struct of a name wins, as for its
/// fields (TypeChecker_struct_pos).
fn TypeChecker_register_field_defaults(self: &mut TypeChecker, s: StructDef) {
    var fi: i64 = 0;
    while fi < s.fields.len() {
        var f: Param = s.fields.get(fi);
        if f.has_default {
            var key: str = s.name + "." + f.name;
            if HashMap_get(self.field_default_at, key) == 0 {
                self.field_default_exprs.push(f.default_expr);
                HashMap_insert(self.field_default_at, key, self.field_default_exprs.len());
            }
        }
        fi = fi + 1;
    }
}

/// Forget the generic-function entry of `name`, if any (a later declaration
/// of the name replaces it; see TypeChecker_register_program).
fn tc_drop_generic_entry(self: &mut TypeChecker, name: str) {
    var at: i64 = -1;
    var i: i64 = 0;
    while i < self.func_generic_names.len() {
        if self.func_generic_names.get(i) == name {
            at = i;
        }
        i = i + 1;
    }
    if at < 0 {
        return;
    }
    var names: Vec<str> = Vec::new();
    var tps: Vec<Vec<str>> = Vec::new();
    var bounds: Vec<Vec<StrPair>> = Vec::new();
    i = 0;
    while i < self.func_generic_names.len() {
        if self.func_generic_names.get(i) != name {
            names.push(self.func_generic_names.get(i));
            tps.push(self.func_generic_tps.get(i));
            bounds.push(self.func_generic_bounds.get(i));
        }
        i = i + 1;
    }
    self.func_generic_names = names;
    self.func_generic_tps = tps;
    self.func_generic_bounds = bounds;
}

/// L8E: the type a parameter is registered with: `...xs: T` of a
/// non-generic function is a Vec<T> (mono_desugar_variadics gives the body
/// that type and packs each call's extra arguments into one Vec).
fn tc_variadic_param_ty(p: Param, packed: bool) -> Type {
    if p.is_variadic && packed {
        var ta: Vec<Type> = Vec::new();
        ta.push(p.ty);
        return Type::Generic("Vec", ta);
    }
    return p.ty;
}

/// CL4 and CU3: a function's parameter names and defaults (for named
/// arguments), and its @deprecated message. A later declaration of the name
/// replaces an earlier one, as in the function cache (the user's program is
/// registered last).
fn TypeChecker_register_fn_params(self: &mut TypeChecker, func: Func) {
    var names: Vec<str> = Vec::new();
    var defs: Vec<bool> = Vec::new();
    var pi: i64 = 0;
    while pi < func.params.len() {
        names.push(func.params.get(pi).name);
        defs.push(func.params.get(pi).has_default);
        pi = pi + 1;
    }
    self.fn_pnames.push(names);
    self.fn_pdefaults.push(defs);
    HashMap_insert(self.fn_pnames_at, func.name, self.fn_pnames.len());
    var ai: i64 = 0;
    while ai < func.annotations.len() {
        var a: Annotation = func.annotations.get(ai);
        if a.name == "deprecated" {
            self.deprecated_msgs.push(tc_deprecated_message(a.args));
            HashMap_insert(self.deprecated_at, func.name, self.deprecated_msgs.len());
        }
        ai = ai + 1;
    }
}

/// CU3: what a @deprecated warning says to do instead. `@deprecated(use =
/// "new_fn")` names the replacement (the parser keeps it as `use="new_fn"`);
/// `@deprecated("text")` is a free message; bare `@deprecated` says nothing
/// more.
fn tc_deprecated_message(args: Vec<str>) -> str {
    var msg: str = "";
    var i: i64 = 0;
    while i < args.len() {
        var a: str = args.get(i);
        if str_starts_with(a, "use=") {
            var repl: str = tc_unquote(str_slice(a, 4, str_len(a)));
            msg = "use `" + repl + "` instead.\n    Fix: call " + repl + "(...) here (`fid fix` can apply it).";
        } else if str_starts_with(a, "\"") && str_len(msg) == 0 {
            msg = tc_unquote(a);
        }
        i = i + 1;
    }
    return msg;
}

/// CL8: what `{x}` in an f-string can hold. The lowering
/// (Lowerer_lower_fstring_expr) turns text, numbers, bools and Vecs into
/// text; it has no conversion for a struct, whose address it read as the
/// bytes of a string (or printed as a number). A struct, or a reference to
/// one, is an error that says how to show it.
fn TypeChecker_check_fstring_part(self: &mut TypeChecker, t: Type) {
    var name: str = "";
    match t {
        Type::Named(n) => {
            name = n;
        }
        Type::Generic(gn, _) => {
            name = gn;
        }
        Type::Ref(inner, _) => {
            TypeChecker_check_fstring_part(self, TypeChecker_resolve_type(self, box_type_unbox(inner)));
            return;
        }
        _ => {
            return;
        }
    }
    if name == "Vec" || name == "HashMap" || str_len(name) == 0 {
        return;
    }
    if TypeChecker_struct_pos(self, name) < 0 {
        return;
    }
    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): an f-string cannot show a value of struct type '" + name + "': it has no text form.\n    Fix: interpolate its fields (`{v.field}`), or a function that gives its text (with @derive(Debug), `{" + name + "_debug_str(v)}`).");
}

/// CL5: a literal `S { a: 1, .. }`: each field of S it leaves out must have
/// a default in S (`b: i64 = 2`), and the default must have the field's
/// type (checked where it is used, as monomorphization writes it there:
/// mono.fd `mn_fill_struct_defaults`).
fn TypeChecker_check_struct_defaults(self: &mut TypeChecker, sname: str, struct_fields: Vec<StructField>, fields: Vec<FieldInit>) {
    var generic: bool = TypeChecker_struct_type_params(self, sname).len() > 0;
    var sfi: i64 = 0;
    while sfi < struct_fields.len() {
        var fname: str = struct_fields.get(sfi).name;
        var written: bool = false;
        var fi: i64 = 0;
        while fi < fields.len() {
            if fields.get(fi).name == fname {
                written = true;
            }
            fi = fi + 1;
        }
        if !written {
            var at: i64 = HashMap_get(self.field_default_at, sname + "." + fname);
            if at == 0 {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): the literal of struct '" + sname + "' leaves out field '" + fname + "', which has no default.\n    Fix: give it a value (`" + fname + ": ...`), or a default in the struct (`" + fname + ": " + type_to_str(struct_fields.get(sfi).ty) + " = ...`).");
            } else if TypeChecker_first_report(self, "default:" + sname + "." + fname) {
                var dexpr: Expr = self.field_default_exprs.get(at - 1);
                var dty: Type = TypeChecker_check_expr(self, dexpr);
                var want: Type = TypeChecker_resolve_type(self, struct_fields.get(sfi).ty);
                if !generic && !TypeChecker_types_compatible(self, want, dty) {
                    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): the default of field '" + sname + "." + fname + "' is " + type_to_str(dty) + ", the field is " + type_to_str(want) + ".");
                }
            }
        }
        sfi = sfi + 1;
    }
}

// LG15: functions of trusted C headers (no `unsafe` needed to call them)
var g_trusted_externs: i64 = 0;

fn tc_mark_trusted_extern(name: str) {
    if g_trusted_externs == 0 {
        g_trusted_externs = HashMap_new();
    }
    HashMap_insert(g_trusted_externs, name, 1);
}

fn tc_is_trusted_extern(name: str) -> bool {
    if g_trusted_externs == 0 {
        return false;
    }
    return HashMap_contains(g_trusted_externs, name);
}

// TG15: C functions of `extern "C"` blocks whose last parameter is
// `...rest: T` (printf, snprintf): a call gives the fixed parameters, then
// any number of arguments, each passed as it is (C's `...`; no Vec is
// packed for an extern). Name -> 1.
var g_c_variadic_externs: i64 = 0;

fn tc_mark_c_variadic(name: str) {
    if g_c_variadic_externs == 0 {
        g_c_variadic_externs = HashMap_new();
    }
    HashMap_insert(g_c_variadic_externs, name, 1);
}

fn tc_is_c_variadic(name: str) -> bool {
    if g_c_variadic_externs == 0 {
        return false;
    }
    return HashMap_contains(g_c_variadic_externs, name);
}

// Release M2: the imported modules held to the `unsafe` rule as the program
// itself is (module name -> 1): those not loaded from the standard library
// directory. The stdlib waits for its audit (M10), and so do the compiler's
// own modules (`compiler::*`, loaded from compiler/ when fid compiles
// itself). Filled by tc_note_module_file, which compiler.fd's
// record_module_file calls for every imported module.
var g_tc_unsafe_checked: i64 = 0;

/// `path` with `\` as `/` and without a leading `./`.
fn tc_norm_path(path: str) -> str {
    var p: str = str_replace(path, "\\", "/");
    while str_starts_with(p, "./") {
        p = str_slice(p, 2, str_len(p));
    }
    return p;
}

/// Whether the file at `path` is in the standard library directory
/// `std_dir` (or any directory named stdlib).
fn tc_path_in_stdlib(path: str, std_dir: str) -> bool {
    var p: str = tc_norm_path(path);
    var d: str = tc_norm_path(std_dir);
    if str_len(d) > 0 && !str_ends_with(d, "/") {
        d = d + "/";
    }
    if str_len(d) > 0 && str_starts_with(str_to_lower(p), str_to_lower(d)) {
        return true;
    }
    return str_starts_with(p, "stdlib/") || str_find(p, "/stdlib/") >= 0;
}

/// Whether `path` is part of the trusted base: core (stdlib/core.fd) or a
/// runtime (stdlib/pe_runtime/, stdlib/linux_runtime/). They are merged
/// into every program by the compiler, not imported, and stay exempt from
/// the `unsafe` rule (their raw memory is audited by its `// SAFETY:`
/// comments, roadmap M10); every other stdlib module is held to it.
fn tc_path_is_trusted_base(path: str) -> bool {
    var p: str = str_replace(path, "\\", "/");
    return str_ends_with(p, "/core.fd") || p == "core.fd" || str_find(p, "pe_runtime/") >= 0 || str_find(p, "linux_runtime/") >= 0;
}

/// Record that `module` was loaded from `path`; `std_dir` is the standard
/// library directory. Every module but the compiler's own and the trusted
/// base (tc_path_is_trusted_base) has its raw memory, integer-to-pointer
/// casts and C calls checked for `unsafe`: user modules since release M2,
/// the stdlib's modules since M10 (Nov 22).
pub fn tc_note_module_file(module: str, path: str, std_dir: str) {
    if str_len(path) == 0 || str_starts_with(module, "compiler::") {
        return;
    }
    if tc_path_in_stdlib(path, std_dir) && tc_path_is_trusted_base(path) {
        return;
    }
    if g_tc_unsafe_checked == 0 {
        g_tc_unsafe_checked = HashMap_new();
    }
    HashMap_insert(g_tc_unsafe_checked, module, 1);
}

// Release M2: the module the program being compiled declares (`module x;`),
// "" before any program is registered. TypeChecker_register_program sets it
// on every call, and every caller registers the stdlib and the imports
// first and the program last, so after registration it names the program.
// A program file that declares a module is held to the `unsafe` rule as one
// without a declaration ("main") is.
var g_tc_program_module: str = "";
// Release M2: true when the program being compiled is itself a file of the
// trusted base (core or a runtime: tc_note_program_file), which stays
// exempt; since M10 any other stdlib file compiled as a program is checked.
var g_tc_program_in_std: bool = false;

/// Record the file of the program being compiled (release M2): a program
/// that is core or a runtime file keeps the trusted base's exemption from
/// the `unsafe` rule (M10: any other stdlib file does not).
pub fn tc_note_program_file(path: str, std_dir: str) {
    g_tc_program_in_std = str_len(path) > 0 && tc_path_in_stdlib(path, std_dir) && tc_path_is_trusted_base(path);
}

/// Whether code of `module` needs `unsafe` for raw memory (release M2): the
/// program itself (also when its file declares `module x;`), and the
/// imported modules tc_note_module_file recorded: user modules and, since
/// M10, the stdlib's. The compiler's own modules (`compiler::*`) and the
/// trusted base (core, the runtimes: merged, not imported, so never
/// recorded) are exempt.
fn tc_module_needs_unsafe(module: str) -> bool {
    if module == "main" {
        return true;
    }
    if str_len(module) > 0 && module == g_tc_program_module && !g_tc_program_in_std && !str_starts_with(module, "compiler::") {
        return true;
    }
    if g_tc_unsafe_checked == 0 {
        return false;
    }
    return HashMap_contains(g_tc_unsafe_checked, module);
}

/// Whether the global writes of code in `module` count for the race check
/// (TypeChecker_verify_no_races): the program itself ("main", or the module
/// its file declares), the compiler's own modules (`compiler::*`: their
/// worker threads, borrowck bc_par_worker, nat_ir ng_par_thread, ...) and
/// every imported module from outside the standard library
/// (tc_note_module_file). The stdlib's own globals are left out, as before.
fn tc_module_race_checked(module: str) -> bool {
    if module == "main" || str_starts_with(module, "compiler::") {
        return true;
    }
    if str_len(module) > 0 && module == g_tc_program_module {
        return true;
    }
    if g_tc_unsafe_checked == 0 {
        return false;
    }
    return HashMap_contains(g_tc_unsafe_checked, module);
}

// Release M10: functions marked @unsafe, by the name a call names them
// (`f`, and `Struct_method` for a method or associated function) -> 1, or 2
// when a later program defines the same name without @unsafe (the program
// being compiled is registered last, so its own definition wins). Filled by
// TypeChecker_register_program (tc_note_unsafe_fns); a call to one needs an
// `unsafe` block or an @unsafe caller (TypeChecker_require_unsafe_call).
var g_tc_unsafe_fns: i64 = 0;

/// Whether `annots` holds @unsafe.
fn tc_annots_unsafe(annots: Vec<Annotation>) -> bool {
    var i: i64 = 0;
    while i < annots.len() {
        if annots.get(i).name == "unsafe" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Record whether the function `key` is @unsafe (release M10).
fn tc_note_unsafe_fn(key: str, is_unsafe: bool) {
    if g_tc_unsafe_fns == 0 {
        if !is_unsafe {
            return;
        }
        g_tc_unsafe_fns = HashMap_new();
    }
    if is_unsafe {
        HashMap_insert(g_tc_unsafe_fns, key, 1);
    } else if HashMap_get(g_tc_unsafe_fns, key) == 1 {
        HashMap_insert(g_tc_unsafe_fns, key, 2);
    }
}

/// Record the @unsafe functions and methods `program` defines (release M10).
fn tc_note_unsafe_fns(program: Program) {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var f: Func = program.funcs.get(fi);
        tc_note_unsafe_fn(f.name, tc_annots_unsafe(f.annotations));
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            tc_note_unsafe_fn(imp.struct_name + "_" + m.name, tc_annots_unsafe(m.annotations));
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(ti);
        var tm: i64 = 0;
        while tm < timp.methods.len() {
            var tf: Func = timp.methods.get(tm);
            tc_note_unsafe_fn(timp.type_name + "_" + tf.name, tc_annots_unsafe(tf.annotations));
            tm = tm + 1;
        }
        ti = ti + 1;
    }
}

/// The name an @unsafe function is recorded under for a call of `callee`:
/// a module path (`volatile::ptr_read`) and turbofish (`f::<#3>`) dropped.
fn tc_unsafe_call_key(callee: str) -> str {
    var c: str = callee;
    val tf: i64 = str_find(c, "::<");
    if tf >= 0 {
        c = str_slice(c, 0, tf);
    }
    val sep: i64 = str_rfind(c, "::");
    if sep >= 0 {
        c = str_slice(c, sep + 2, str_len(c));
    }
    return c;
}

/// Whether the function recorded as `key` is @unsafe (release M10).
fn tc_is_unsafe_fn(key: str) -> bool {
    if g_tc_unsafe_fns == 0 {
        return false;
    }
    return HashMap_get(g_tc_unsafe_fns, key) == 1;
}

/// CL10: the method an arithmetic operator calls on a struct.
pub fn tc_operator_method(op: BinOp) -> str {
    return binop_operator_method(op);
}

fn tc_operator_symbol(m: str) -> str {
    if m == "add" {
        return "+";
    }
    if m == "sub" {
        return "-";
    }
    if m == "mul" {
        return "*";
    }
    if m == "div" {
        return "/";
    }
    return "%";
}

/// The symbol of an ordering comparison (CL10 unit comparisons).
fn tc_cmp_symbol(op: BinOp) -> str {
    match op {
        BinOp::Lt => {
            return "<";
        }
        BinOp::LtEq => {
            return "<=";
        }
        BinOp::Gt => {
            return ">";
        }
        _ => {
        }
    }
    return ">=";
}

/// CL10: `a op b` with `a` of struct type `sname`: the type of
/// `a.<op method>(b)`, or an error naming the method to write.
fn TypeChecker_check_struct_operator(self: &mut TypeChecker, op: BinOp, sname: str, rt: Type) -> Type {
    var m: str = tc_operator_method(op);
    var mei: i64 = TypeChecker_method_find(self, sname, m);
    if mei < 0 {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): no operator `" + tc_operator_symbol(m) + "` on struct '" + sname + "': it has no method `" + m + "`.\n    Fix: give it one, `impl " + sname + " { fn " + m + "(self: " + sname + ", other: " + sname + ") -> " + sname + " { ... } }`; `a " + tc_operator_symbol(m) + " b` then calls `a." + m + "(b)`.");
        return Type::Never;
    }
    var info: MethodInfo = self.methods.get(TypeChecker_methods_at(self, sname)).val.get(mei).val;
    var first: i64 = 1;
    if info.has_self == false || info.param_types.len() != 2 {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `" + sname + "." + m + "` cannot serve `" + tc_operator_symbol(m) + "`: it must take self and one operand, it takes " + int_to_str(info.param_types.len()) + " parameters");
        return Type::Never;
    }
    if !TypeChecker_types_compatible(self, info.param_types.get(first), rt) {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `" + sname + " " + tc_operator_symbol(m) + " " + type_to_str(rt) + "`: `" + sname + "." + m + "` takes " + type_to_str(info.param_types.get(first)) + ", got " + type_to_str(rt));
        return Type::Never;
    }
    TypeChecker_record_method_call(self, sname, m);
    TypeChecker_warn_deprecated_method(self, sname, m);
    return info.ret_ty;
}

// ─── CL10: units of measure ──────────────────────────────────────────────
// A struct marked `@dimension(...)` (ast.fd struct_dimension) is a unit. On
// units, `*` and `/` need no method: the result is the unit whose dimension
// is the sum / difference of the operands' (Newtons * Meters is Joules), an
// f64 when the dimensions cancel; a unit times or over an f64 is the same
// unit, an f64 over a unit the inverse unit. `+ - %` keep one unit. A
// method that takes the operand still wins (Meters.mul(k: f64)). A left
// operand that is not a struct calls the right one's `radd`, `rsub`,
// `rmul`, `rdiv` or `rrem` (`2.0 * m` is `m.rmul(2.0)`). lower.fd makes the
// same choices (Lowerer_binop_plan).

// Struct name -> its packed dimension. A struct registered without
// @dimension is removed: the name of an earlier check in the same process.
var g_tc_dims: i64 = 0;

fn tc_note_struct_dimension(s: StructDef) {
    var d: i64 = struct_dimension(s.annotations);
    if g_tc_dims == 0 {
        if d == 0 {
            return;
        }
        g_tc_dims = HashMap_new();
    }
    if d == 0 {
        if HashMap_contains(g_tc_dims, s.name) {
            HashMap_remove(g_tc_dims, s.name);
        }
        return;
    }
    HashMap_insert(g_tc_dims, s.name, d);
}

/// The packed dimension of struct `name`, 0 when it is not a unit.
pub fn tc_struct_dim(name: str) -> i64 {
    if g_tc_dims == 0 {
        return 0;
    }
    return HashMap_get(g_tc_dims, name);
}

/// A malformed `@dimension(...)`, or a unit that does not hold exactly one
/// f64 (the operators read and make that one field).
fn TypeChecker_check_dimension_struct(self: &mut TypeChecker, sd: StructDef) {
    var err: str = dimension_annotation_error(sd.annotations);
    if str_len(err) > 0 {
        self.errors.push("Type error: @dimension on struct '" + sd.name + "': " + err + ".");
        return;
    }
    if struct_dimension(sd.annotations) == 0 {
        return;
    }
    var ok: bool = sd.fields.len() == 1 && sd.type_params.len() == 0;
    if ok {
        ok = type_eq(TypeChecker_resolve_type(self, sd.fields.get(0).ty), Type::F64);
    }
    if !ok {
        self.errors.push("Type error: struct '" + sd.name + "' is a unit (@dimension): it must hold exactly one f64 field and no type parameters, e.g. `struct " + sd.name + " { value: f64 }`.\n    Fix: keep one f64 field (name it `value`) and move type parameters to a plain struct.");
    }
}

/// The units (structs marked @dimension) whose dimension is `d`.
fn TypeChecker_dim_units(self: &TypeChecker, d: i64) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < self.structs.len() {
        var k: str = self.structs.get(i).key;
        if tc_struct_dim(k) == d && !tc_str_vec_contains(out, k) {
            out.push(k);
        }
        i = i + 1;
    }
    return out;
}

/// The struct a type names ("" when it is not a struct).
fn tc_dim_struct_name(self: &TypeChecker, t: Type) -> str {
    match t {
        Type::Named(n) => {
            if tc_is_struct(self, n) {
                return n;
            }
        }
        _ => {
        }
    }
    return "";
}

/// Whether `sname.m` can serve an operator whose other operand is `ot`:
/// it takes self and one parameter that accepts `ot`.
fn TypeChecker_struct_operator_fits(self: &mut TypeChecker, sname: str, m: str, ot: Type) -> bool {
    var mei: i64 = TypeChecker_method_find(self, sname, m);
    if mei < 0 {
        return false;
    }
    var info: MethodInfo = self.methods.get(TypeChecker_methods_at(self, sname)).val.get(mei).val;
    if !info.has_self || info.param_types.len() != 2 {
        return false;
    }
    // 2g.112: an integer is no operand of a method taking a float, nor a
    // float of one taking an integer: the operator's call passes the word
    // as it is (`2 * v` with `rmul(self, k: f64)` multiplied by the bits
    // of 2), and types_compatible lets the literal through
    val pt: Type = info.param_types.get(1);
    if (TypeChecker_is_float(self, pt) && TypeChecker_is_integer(self, ot)) || (TypeChecker_is_integer(self, pt) && TypeChecker_is_float(self, ot)) {
        return false;
    }
    return TypeChecker_types_compatible(self, pt, ot);
}

/// `a op b` with `a` of struct type `sname`: its operator method, or for a
/// unit the dimension rule (see the section comment).
fn TypeChecker_check_struct_or_dim_operator(self: &mut TypeChecker, op: BinOp, sname: str, lt: Type, rt: Type, rexpr: Expr) -> Type {
    var m: str = tc_operator_method(op);
    if tc_struct_dim(sname) == 0 || TypeChecker_struct_operator_fits(self, sname, m, rt) {
        return TypeChecker_check_struct_operator(self, op, sname, rt);
    }
    // a unit's own `add` taking something else keeps its error
    if (m == "add" || m == "sub" || m == "rem") && TypeChecker_method_find(self, sname, m) >= 0 {
        return TypeChecker_check_struct_operator(self, op, sname, rt);
    }
    return TypeChecker_check_dim_operator(self, m, sname, lt, rt, tc_operand_type_str(rexpr, rt));
}

/// The dimension rule with a unit `lname` on the left; `rtn` names the
/// right operand's type in messages (tc_operand_type_str).
fn TypeChecker_check_dim_operator(self: &mut TypeChecker, m: str, lname: str, lt: Type, rt: Type, rtn: str) -> Type {
    if type_eq(rt, Type::Never) {
        return Type::Never;
    }
    var sym: str = tc_operator_symbol(m);
    var rname: str = tc_dim_struct_name(self, rt);
    var rd: i64 = 0;
    if str_len(rname) > 0 {
        rd = tc_struct_dim(rname);
    }
    if m == "add" || m == "sub" || m == "rem" {
        if rname == lname {
            return lt;
        }
        if rd != 0 {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `" + lname + " " + sym + " " + rname + "`: units of different dimensions (" + dim_to_str(tc_struct_dim(lname)) + " and " + dim_to_str(rd) + ") do not add; a unit adds only to itself.");
        } else {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `" + lname + " " + sym + " " + rtn + "`: a unit adds only to a value of its own unit (" + lname + ").");
        }
        return Type::Never;
    }
    if type_eq(rt, Type::F64) {
        return lt;
    }
    if rd != 0 {
        return TypeChecker_dim_result(self, m, lname, tc_struct_dim(lname), rname, rd);
    }
    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `" + lname + " " + sym + " " + rtn + "`: a unit multiplies and divides by an f64 or by another unit (a struct marked @dimension), got " + rtn + ".");
    return Type::Never;
}

/// The dimension rule with an f64 on the left and a unit `rname` on the
/// right: `k * u` is u's unit, `k / u` the inverse unit.
fn TypeChecker_check_dim_scalar_left(self: &mut TypeChecker, m: str, lt: Type, rname: str, rt: Type) -> Type {
    if m == "mul" {
        return rt;
    }
    if m == "div" {
        return TypeChecker_dim_result(self, m, type_to_str(lt), dim_dimensionless(), rname, tc_struct_dim(rname));
    }
    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `" + type_to_str(lt) + " " + tc_operator_symbol(m) + " " + rname + "`: a unit adds only to a value of its own unit (" + rname + ").");
    return Type::Never;
}

/// The type of `l * r` / `l / r` (dimensions `ld`, `rd`): the unit of the
/// combined dimension, f64 when it cancels, an error when no unit or more
/// than one declares it.
fn TypeChecker_dim_result(self: &mut TypeChecker, m: str, lname: str, ld: i64, rname: str, rd: i64) -> Type {
    var sign: i64 = 1;
    if m == "div" {
        sign = 0 - 1;
    }
    var text: str = "`" + lname + " " + tc_operator_symbol(m) + " " + rname + "`";
    var d: i64 = dim_combine(ld, rd, sign);
    if d < 0 {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + text + ": an exponent of the result leaves -8..7.");
        return Type::Never;
    }
    if d == dim_dimensionless() {
        return Type::F64;
    }
    var units: Vec<str> = TypeChecker_dim_units(self, d);
    if units.len() == 1 {
        return Type::Named(units.get(0));
    }
    if units.len() == 0 {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + text + " has dimension " + dim_to_str(d) + ", and no unit declares it.\n    Fix: declare one, `" + dim_annotation_text(d) + " struct Name { value: f64 }`.");
        return Type::Never;
    }
    var names: str = "";
    var i: i64 = 0;
    while i < units.len() {
        if i > 0 {
            names = names + ", ";
        }
        names = names + units.get(i);
        i = i + 1;
    }
    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + text + " has dimension " + dim_to_str(d) + ", which more than one unit declares (" + names + "): the result is ambiguous.\n    Fix: give " + lname + " a `" + m + "` method that says which one it makes.");
    return Type::Never;
}

/// `a op b` with `a` not a struct and `b` of struct type `rname`: the type
/// of `b.r<op>(a)`, the dimension rule when `b` is a unit and `a` an f64,
/// or Type::Infer when neither applies (the plain rules then decide).
fn TypeChecker_check_right_struct_operator(self: &mut TypeChecker, op: BinOp, lt: Type, rname: str, rt: Type, lexpr: Expr) -> Type {
    if type_eq(lt, Type::Never) {
        return Type::Infer;
    }
    var m: str = tc_operator_method(op);
    var rm: str = "r" + m;
    if TypeChecker_struct_operator_fits(self, rname, rm, lt) {
        var mei: i64 = TypeChecker_method_find(self, rname, rm);
        var info: MethodInfo = self.methods.get(TypeChecker_methods_at(self, rname)).val.get(mei).val;
        TypeChecker_record_method_call(self, rname, rm);
        TypeChecker_warn_deprecated_method(self, rname, rm);
        return info.ret_ty;
    }
    if tc_struct_dim(rname) != 0 {
        if type_eq(lt, Type::F64) {
            return TypeChecker_check_dim_scalar_left(self, m, lt, rname, rt);
        }
        val ltn: str = tc_operand_type_str(lexpr, lt);
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `" + ltn + " " + tc_operator_symbol(m) + " " + rname + "`: a unit combines with an f64 or another unit, got " + ltn + ".");
        return Type::Never;
    }
    if TypeChecker_method_find(self, rname, rm) >= 0 {
        // it has the method, for another operand type
        return TypeChecker_check_struct_operator_named(self, rname, rm, m, tc_operand_type_str(lexpr, lt));
    }
    return Type::Infer;
}

/// `rname.rm` exists but does not take an operand of type `ltn` (as a
/// message names it, tc_operand_type_str): the error naming both.
fn TypeChecker_check_struct_operator_named(self: &mut TypeChecker, rname: str, rm: str, m: str, ltn: str) -> Type {
    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `" + ltn + " " + tc_operator_symbol(m) + " " + rname + "`: `" + rname + "." + rm + "` must take self and one operand of type " + ltn + ".");
    return Type::Never;
}

/// CL10: the expression `x op= e` assigns. On a struct variable it is
/// `x op e`, checked as the operator is: the struct's method, a unit's
/// dimension rule, vecN's operators, or the error naming the method to
/// write (lower.fd Lowerer_compound_struct_assign makes the same rewrite;
/// before, `p += q` compiled to arithmetic on the struct's address).
/// Otherwise `e`.
fn TypeChecker_compound_struct_expr(self: &TypeChecker, target: str, op: AssignOp, e: Expr) -> Expr {
    if !assign_op_is_arith(op) {
        return e;
    }
    match TypeChecker_lookup(self, target) {
        OptType::Some(t) => {
            match TypeChecker_resolve_type(self, t) {
                Type::Named(n) => {
                    if tc_is_struct(self, n) && !TypeChecker_is_typed_string(self, Type::Named(n)) {
                        return Expr::Binary(assign_op_binop(op), Box::new(Expr::Ident(target)), Box::new(e));
                    }
                }
                _ => {
                }
            }
        }
        OptType::None => {
        }
    }
    return e;
}

/// CL10: the expression `obj.f op= e` assigns when field `f` (of type
/// `fty`) is a struct and `obj` a place path (ast.fd expr_is_place_path):
/// `obj.f op e`, checked as the operator is (lower.fd makes the same
/// rewrite). Otherwise `e`.
fn TypeChecker_compound_field_expr(self: &TypeChecker, object: Expr, field: str, op: AssignOp, fty: Type, e: Expr) -> Expr {
    if !assign_op_is_arith(op) || !expr_is_place_path(object) {
        return e;
    }
    match TypeChecker_resolve_type(self, fty) {
        Type::Named(n) => {
            if tc_is_struct(self, n) && !TypeChecker_is_typed_string(self, Type::Named(n)) {
                return Expr::Binary(assign_op_binop(op), Box::new(Expr::FieldAccess(Box::new(object), field)), Box::new(e));
            }
        }
        _ => {
        }
    }
    return e;
}

/// CU3: a call of a method marked @deprecated (`v.old()`, `T::old()`):
/// the warning names it `T.old` (so `fid fix` leaves it to the author: the
/// rename applies to plain calls only). The method's own body stays quiet.
fn TypeChecker_warn_deprecated_method(self: &mut TypeChecker, type_name: str, method: str) {
    var key: str = type_name + "_" + method;
    var dep_at: i64 = HashMap_get(self.deprecated_at, key);
    if dep_at <= 0 {
        return;
    }
    match self.current_func_name {
        OptString::Some(fname) => {
            if fname == key || fname == type_name + "::" + method || fname == type_name + "." + method {
                return;
            }
        }
        OptString::None => {
        }
    }
    TypeChecker_warn_deprecated(self, type_name + "." + method, self.deprecated_msgs.get(dep_at - 1));
}

/// CU3: the warning at a call of a @deprecated function.
fn TypeChecker_warn_deprecated(self: &mut TypeChecker, callee: str, msg: str) {
    var in_fn: str = "";
    match self.current_func_name {
        OptString::Some(fname) => {
            // the deprecated function's own (recursive) calls stay quiet
            if fname == callee {
                return;
            }
            in_fn = ", in '" + fname + "'";
        }
        OptString::None => {
        }
    }
    var w: str = "Warning (line " + int_to_str(self.current_line) + in_fn + "): '" + callee + "' is deprecated";
    if str_len(msg) > 0 {
        w = w + ": " + msg;
    } else {
        w = w + ".";
    }
    // ST3: from edition 2027 a call of a deprecated function is an error
    // (the file's own edition: code of both editions builds together)
    if edition_of(self.current_module) >= 2027 {
        var e: str = "Type error (line " + int_to_str(self.current_line) + in_fn + "): '" + callee + "' is deprecated, and edition 2027 does not call deprecated functions";
        if str_len(msg) > 0 {
            e = e + ": " + msg;
        }
        self.errors.push(e);
        return;
    }
    self.warnings.push(w);
}

/// CL4: a call with named arguments (`connect(port: 80, host: h)`), checked
/// the way the lowering places them (lower.fd, the named-argument resolver
/// before each call): positional arguments fill the first parameters, a
/// named one the parameter of its name, a parameter left out takes its
/// default. Errors: a name the function has no parameter for, a parameter
/// given twice, a positional argument after a named one, too many
/// arguments, a parameter without a default left out, a named argument of
/// the wrong type. Positional arguments are type-checked by the caller's
/// loop as before (a named one is Never there, so it passes).
fn TypeChecker_check_named_args(self: &mut TypeChecker, callee: str, sig: FuncSig, args: Vec<Expr>, named_tys: Vec<Type>) {
    var at: i64 = HashMap_get(self.fn_pnames_at, callee);
    if at == 0 {
        return;
    }
    var names: Vec<str> = self.fn_pnames.get(at - 1);
    var defs: Vec<bool> = self.fn_pdefaults.get(at - 1);
    var where_s: str = "Type error (line " + int_to_str(self.current_line) + "): ";
    var given: Vec<bool> = Vec::new();
    var gi: i64 = 0;
    while gi < names.len() {
        given.push(false);
        gi = gi + 1;
    }
    var seen_named: bool = false;
    var pos: i64 = 0;
    var i: i64 = 0;
    while i < args.len() {
        match args.get(i) {
            Expr::NamedArg(an, _) => {
                seen_named = true;
                var k: i64 = -1;
                var ni: i64 = 0;
                while ni < names.len() {
                    if names.get(ni) == an {
                        k = ni;
                    }
                    ni = ni + 1;
                }
                if k < 0 {
                    self.errors.push(where_s + "function '" + callee + "' has no parameter '" + an + "'.\n    Fix: name one of its parameters: " + str_join(names, ", ") + ".");
                } else if given.get(k) {
                    self.errors.push(where_s + "parameter '" + an + "' of '" + callee + "' is given twice.\n    Fix: give each parameter once, by position or by name.");
                } else {
                    given.set(k, true);
                    if k < sig.param_types.len() {
                        var raw_param: Type = sig.param_types.get(k);
                        var param: Type = TypeChecker_resolve_type(self, raw_param);
                        var arg: Type = named_tys.get(i);
                        if !TypeChecker_type_contains_param(self, raw_param) && !is_single_upper_name(raw_param) && !TypeChecker_arg_compatible(self, param, arg) {
                            self.errors.push(where_s + "function '" + callee + "' parameter '" + an + "' expects '" + type_to_str(param) + "', got '" + type_to_str(arg) + "'");
                        }
                    }
                }
            }
            _ => {
                if seen_named {
                    self.errors.push(where_s + "a positional argument after a named one in the call to '" + callee + "'.\n    Fix: put the positional arguments first, or name this one too.");
                } else if pos < given.len() {
                    given.set(pos, true);
                }
                pos = pos + 1;
            }
        }
        i = i + 1;
    }
    if pos > names.len() {
        self.errors.push(where_s + "function '" + callee + "' takes " + int_to_str(names.len()) + " parameter(s), the call gives " + int_to_str(pos) + " by position.");
        return;
    }
    var mi: i64 = 0;
    while mi < names.len() {
        if !given.get(mi) && !(mi < defs.len() && defs.get(mi)) {
            self.errors.push(where_s + "the call to '" + callee + "' leaves out parameter '" + names.get(mi) + "', which has no default.\n    Fix: pass it, e.g. `" + names.get(mi) + ": ...`.");
        }
        mi = mi + 1;
    }
}

/// The text of a quoted annotation argument (`"x"` -> `x`).
fn tc_unquote(s: str) -> str {
    var n: i64 = str_len(s);
    if n >= 2 && str_byte_at(s, 0) == 34 && str_byte_at(s, n - 1) == 34 {
        return str_slice(s, 1, n - 1);
    }
    return s;
}

/// The program being compiled (register_program's last), for the comptime
/// fold (§4.11): what a comptime expression computes is checked as the
/// literal it will become. A copy — one Vec element, set per registration.
var g_tc_program_copy: Vec<Program> = Vec::new();

pub fn TypeChecker_register_program(self: &mut TypeChecker, program: Program, module: str) {
    g_tc_program_copy = Vec::new();
    g_tc_program_copy.push(program);
    self.current_module = module;
    // Release M2: the program being compiled is registered last
    g_tc_program_module = module;
    // Release M10: calls to its @unsafe functions need `unsafe`
    tc_note_unsafe_fns(program);
    // 2g.27: the names this program defines (the last one registered is
    // the program being compiled; see tc_tag_module_errors)
    HashMap_drop(self.last_fn_names);
    self.last_fn_names = HashMap_new();
    var lfi: i64 = 0;
    while lfi < program.funcs.len() {
        HashMap_insert(self.last_fn_names, program.funcs.get(lfi).name, 1);
        lfi = lfi + 1;
    }
    var lii: i64 = 0;
    while lii < program.impls.len() {
        var limp: ImplDef = program.impls.get(lii);
        var lmi: i64 = 0;
        while lmi < limp.methods.len() {
            HashMap_insert(self.last_fn_names, limp.struct_name + "_" + limp.methods.get(lmi).name, 1);
            lmi = lmi + 1;
        }
        lii = lii + 1;
    }
    var lti: i64 = 0;
    while lti < program.trait_impls.len() {
        var ltimp: TraitImpl = program.trait_impls.get(lti);
        var ltm: i64 = 0;
        while ltm < ltimp.methods.len() {
            HashMap_insert(self.last_fn_names, ltimp.type_name + "_" + ltimp.methods.get(ltm).name, 1);
            ltm = ltm + 1;
        }
        lti = lti + 1;
    }

    // Register structs
    var si: i64 = 0;
    while si < program.structs.len() {
        var s: StructDef = program.structs.get(si);
        var fields: Vec<StructField> = Vec::new();
        var fi: i64 = 0;
        while fi < s.fields.len() {
            var f: Param = s.fields.get(fi);
            fields.push(StructField_new(f.name, f.ty));
            fi = fi + 1;
        }
        self.structs.push(StringStructFields_new(s.name, fields));
        TypeChecker_register_field_defaults(self, s);
        tc_note_struct_dimension(s);
        if s.type_params.len() > 0 && !tc_str_vec_contains(self.struct_tp_names, s.name) {
            self.struct_tp_names.push(s.name);
            self.struct_tp_lists.push(s.type_params);
        }
        if tc_has_annotation(s.annotations, "scoped") {
            self.scoped_structs.push(s.name);
        }
        TypeChecker_set_item_module(self, s.name, module);
        TypeChecker_set_item_visibility(self, s.name, s.is_pub);
        TypeChecker_set_struct_module(self, s.name, module);
        // Field-level visibility
        var fi2: i64 = 0;
        while fi2 < s.fields.len() {
            var f2: Param = s.fields.get(fi2);
            self.field_visibility.push(FieldVisEntry_new(FieldVisKey_new(s.name, f2.name), f2.is_pub));
            // The first module to register the struct owns it (as
            // struct_modules: a later program may repeat the definition).
            if !f2.is_pub && HashMap_get(self.private_fields, s.name + "." + f2.name) == 0 {
                self.private_field_modules.push(module);
                HashMap_insert(self.private_fields, s.name + "." + f2.name, self.private_field_modules.len());
            }
            fi2 = fi2 + 1;
        }
        // Check for @linear, @send, @sync annotations
        var ai: i64 = 0;
        while ai < s.annotations.len() {
            var ann: Annotation = s.annotations.get(ai);
            if ann.name == "linear" {
                self.linear_structs.push(s.name);
            }
            if ann.name == "send" {
                self.send_structs.push(s.name);
            }
            if ann.name == "sync" {
                self.sync_structs.push(s.name);
            }
            ai = ai + 1;
        }
        si = si + 1;
    }

    // Register enums
    var ei: i64 = 0;
    while ei < program.enums.len() {
        TypeChecker_register_enum(self, program.enums.get(ei), module);
        ei = ei + 1;
    }

    // Register consts
    var ci: i64 = 0;
    while ci < program.consts.len() {
        var c: ConstDef = program.consts.get(ci);
        map_str_type_set(&mut self.consts, c.name, c.ty);
        TypeChecker_set_item_module(self, c.name, module);
        TypeChecker_set_item_visibility(self, c.name, c.is_pub);
        ci = ci + 1;
    }

    // Register module-level mutable globals
    var gi: i64 = 0;
    while gi < program.globals.len() {
        var g: GlobalVar = program.globals.get(gi);
        map_str_type_set(&mut self.globals, g.name, g.ty);
        TypeChecker_set_item_module(self, g.name, module);
        TypeChecker_set_item_visibility(self, g.name, g.is_pub);
        gi = gi + 1;
    }

    // Register type aliases
    var tai: i64 = 0;
    while tai < program.type_aliases.len() {
        var ta: TypeAlias = program.type_aliases.get(tai);
        map_str_type_set(&mut self.type_aliases, ta.name, ta.alias_for);
        TypeChecker_set_item_module(self, ta.name, module);
        TypeChecker_set_item_visibility(self, ta.name, ta.is_pub);
        tai = tai + 1;
    }

    // Register functions
    var fi3: i64 = 0;
    while fi3 < program.funcs.len() {
        var func: Func = program.funcs.get(fi3);
        if spec_base_name(func.name) != "" {
            TypeChecker_note_spec(self, func);
        }
        var param_types: Vec<Type> = Vec::new();
        var min_args: i64 = 0;
        var pi: i64 = 0;
        while pi < func.params.len() {
            // L8E: a variadic parameter `...xs: T` is a Vec<T> (calls pass
            // the extra arguments packed into one: mono_desugar_variadics)
            param_types.push(TypeChecker_resolve_type(self, tc_variadic_param_ty(func.params.get(pi), func.type_params.len() == 0)));
            // Count required params (those without defaults)
            if !func.params.get(pi).has_default {
                min_args = min_args + 1;
            }
            pi = pi + 1;
        }
        var ret_ty: Type = TypeChecker_resolve_type(self, func.ret_ty);
        self.funcs.push(StringFuncSig_new(func.name, FuncSig_new_with_min(param_types, ret_ty, min_args)));
        TypeChecker_register_fn_params(self, func);
        // A later declaration replaces an earlier one (the user's program
        // is registered last): a program's own `fn assert_eq(a: str, b: str,
        // label: str)` shadows core's generic assert_eq<T>, so the earlier
        // entry's type parameters must not apply to it (release A11)
        tc_drop_generic_entry(self, func.name);
        if func.type_params.len() > 0 {
            self.func_generic_names.push(func.name);
            self.func_generic_tps.push(func.type_params);
            self.func_generic_bounds.push(func.type_param_bounds);
        }
        TypeChecker_set_item_module(self, func.name, module);
        TypeChecker_set_item_visibility(self, func.name, func.is_pub);
        fi3 = fi3 + 1;
    }

    // Register extern function declarations
    // LG15: the bindings of an @import("x.h", trusted) header (compiler.fd
    // marks them `trusted_c`) are called without `unsafe`
    var trusted_c: bool = false;
    var tai: i64 = 0;
    while tai < program.attributes.len() {
        if program.attributes.get(tai).name == "trusted_c" {
            trusted_c = true;
        }
        tai = tai + 1;
    }
    var exti: i64 = 0;
    while exti < program.extern_decls.len() {
        var ext: ExternDecl = program.extern_decls.get(exti);
        if trusted_c {
            tc_mark_trusted_extern(ext.pledge_name);
        }
        var param_types: Vec<Type> = Vec::new();
        var pi: i64 = 0;
        while pi < ext.params.len() {
            // TG15: a C `...rest: T` is not a parameter of its own: the
            // fixed ones are checked, any arguments after them pass as
            // they are (tc_is_c_variadic)
            if pi == ext.params.len() - 1 && ext.params.get(pi).is_variadic {
                tc_mark_c_variadic(ext.pledge_name);
            } else {
                param_types.push(TypeChecker_resolve_type(self, ext.params.get(pi).ty));
            }
            pi = pi + 1;
        }
        var ret_ty: Type = TypeChecker_resolve_type(self, ext.ret_ty);
        self.funcs.push(StringFuncSig_new(ext.pledge_name, FuncSig_new(param_types, ret_ty)));
        TypeChecker_set_item_module(self, ext.pledge_name, module);
        self.extern_fns.push(ext.pledge_name);
        TypeChecker_set_item_visibility(self, ext.pledge_name, true);
        exti = exti + 1;
    }

    // Register impl methods
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var struct_name: str = imp.struct_name;
        // (the generic impl's: a narrower `impl<U> Wrap<Vec<U>>` does not
        // name the struct's parameters, L8H)
        if imp.type_params.len() > 0 && !str_vec_contains(self.impl_tp_names, struct_name) && tc_impl_is_general(imp) {
            self.impl_tp_names.push(struct_name);
            self.impl_tp_lists.push(imp.type_params);
        }
        var method_entries: Vec<MethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            // L8H: a narrower impl's specialization of a generic impl's method
            if spec_base_name(method.name) != "" && method.params.len() > 0 && method.params.get(0).name == "self" {
                TypeChecker_note_mspec(self, imp, method);
            }
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            var has_self: bool = false;
            if method.params.len() > 0 {
                if method.params.get(0).name == "self" {
                    has_self = true;
                }
            }
            method_entries.push(MethodMapEntry_new(method.name, MethodInfo_with_params(MethodInfo_with_tps(MethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), has_self, method.is_pub), method.type_params, method.type_param_bounds), method.params)));
            // A method is an item under its struct's name (Vec_take), never
            // under its bare one: that would make a program's own `take`
            // the private item of whichever module had a `take` method
            var mangled: str = struct_name + "_" + method.name;
            TypeChecker_set_item_module(self, mangled, module);
            // CU3: a method marked @deprecated, under its mangled name
            var mdi: i64 = 0;
            while mdi < method.annotations.len() {
                if method.annotations.get(mdi).name == "deprecated" {
                    self.deprecated_msgs.push(tc_deprecated_message(method.annotations.get(mdi).args));
                    HashMap_insert(self.deprecated_at, mangled, self.deprecated_msgs.len());
                }
                mdi = mdi + 1;
            }
            mi = mi + 1;
        }
        // A second `impl` block for the struct adds its methods to the
        // existing map (a method already there keeps its first definition).
        var mi2: i64 = TypeChecker_methods_at(self, struct_name);
        if mi2 >= 0 && mi2 < self.methods.len() {
            var existing_val: Vec<MethodMapEntry> = self.methods.get(mi2).val;
            var ni: i64 = 0;
            while ni < method_entries.len() {
                var have: bool = false;
                var ei: i64 = 0;
                while ei < existing_val.len() {
                    if existing_val.get(ei).key == method_entries.get(ni).key {
                        have = true;
                    }
                    ei = ei + 1;
                }
                if !have {
                    existing_val.push(method_entries.get(ni));
                }
                ni = ni + 1;
            }
            var m_entry: StringMethodMap = self.methods.get(mi2);
            m_entry.val = existing_val;
            self.methods.set(mi2, m_entry);
            TypeChecker_methods_hm_clear(self, mi2);
        } else {
            self.methods.push(StringMethodMap_new(struct_name, method_entries));
        }
        impi = impi + 1;
    }

    // Register trait impl methods
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        var type_name: str = ti.type_name;
        var new_methods: Vec<MethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < ti.methods.len() {
            var method: Func = ti.methods.get(mi);
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            var has_self: bool = false;
            if method.params.len() > 0 {
                if method.params.get(0).name == "self" {
                    has_self = true;
                }
            }
            new_methods.push(MethodMapEntry_new(method.name, MethodInfo_with_params(MethodInfo_with_tps(MethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), has_self, method.is_pub), method.type_params, method.type_param_bounds), method.params)));
            // under the type's name, as an impl method (not the bare name)
            TypeChecker_set_item_module(self, type_name + "_" + method.name, module);
            mi = mi + 1;
        }
        // Merge into existing method map or create new
        var mi2: i64 = TypeChecker_methods_at(self, type_name);
        if mi2 >= 0 && mi2 < self.methods.len() {
            var existing_val: Vec<MethodMapEntry> = self.methods.get(mi2).val;
            var ni: i64 = 0;
            while ni < new_methods.len() {
                method_map_set_entry(&mut existing_val, new_methods.get(ni).key, new_methods.get(ni).val);
                ni = ni + 1;
            }
            var m_entry: StringMethodMap = self.methods.get(mi2);
            m_entry.val = existing_val;
            self.methods.set(mi2, m_entry);
            TypeChecker_methods_hm_clear(self, mi2);
        } else {
            self.methods.push(StringMethodMap_new(type_name, new_methods));
        }
        tii = tii + 1;
    }

    // Register trait definitions
    var tdi: i64 = 0;
    while tdi < program.traits.len() {
        var trait_def: TraitDef = program.traits.get(tdi);
        var method_entries: Vec<TraitMethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < trait_def.methods.len() {
            var method: TraitMethod = trait_def.methods.get(mi);
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            var tmi_info: TraitMethodInfo = TraitMethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), method.has_self);
            tmi_info.type_params = method.type_params;
            tmi_info.type_param_bounds = method.type_param_bounds;
            method_entries.push(TraitMethodMapEntry_new(method.name, tmi_info));
            mi = mi + 1;
        }
        self.traits.push(StringTraitMethodMap_new(trait_def.name, method_entries));
        // Register associated type declarations
        var assoc_names: Vec<str> = Vec::new();
        var ai: i64 = 0;
        while ai < trait_def.associated_types.len() {
            assoc_names.push(trait_def.associated_types.get(ai).name);
            ai = ai + 1;
        }
        self.trait_assoc_types.push(StringVecString_new(trait_def.name, assoc_names));
        tdi = tdi + 1;
    }
}

pub fn TypeChecker_register_trait_impls(self: &mut TypeChecker, program: Program) {
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        self.impl_pairs.push(ti.trait_name + ":" + ti.type_name);
        var type_name: str = ti.type_name;
        var new_methods: Vec<MethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < ti.methods.len() {
            var method: Func = ti.methods.get(mi);
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < method.params.len() {
                param_types.push(TypeChecker_resolve_type(self, method.params.get(pi).ty));
                pi = pi + 1;
            }
            var has_self: bool = false;
            if method.params.len() > 0 {
                if method.params.get(0).name == "self" {
                    has_self = true;
                }
            }
            new_methods.push(MethodMapEntry_new(method.name, MethodInfo_with_params(MethodInfo_with_tps(MethodInfo_new(param_types, TypeChecker_resolve_type(self, method.ret_ty), has_self, method.is_pub), method.type_params, method.type_param_bounds), method.params)));
            mi = mi + 1;
        }
        // Merge into existing method map or create new
        var mi2: i64 = TypeChecker_methods_at(self, type_name);
        if mi2 >= 0 && mi2 < self.methods.len() {
            var existing_val: Vec<MethodMapEntry> = self.methods.get(mi2).val;
            var ni: i64 = 0;
            while ni < new_methods.len() {
                method_map_set_entry(&mut existing_val, new_methods.get(ni).key, new_methods.get(ni).val);
                ni = ni + 1;
            }
            var m_entry: StringMethodMap = self.methods.get(mi2);
            m_entry.val = existing_val;
            self.methods.set(mi2, m_entry);
            TypeChecker_methods_hm_clear(self, mi2);
        } else {
            self.methods.push(StringMethodMap_new(type_name, new_methods));
        }
        // Register associated type bindings
        if ti.associated_types.len() > 0 {
            var bindings: Vec<StringType> = Vec::new();
            var ai: i64 = 0;
            while ai < ti.associated_types.len() {
                var b: AssocTypeBinding = ti.associated_types.get(ai);
                bindings.push(StringType_new(b.name, b.ty));
                ai = ai + 1;
            }
            self.trait_impl_assoc_bindings.push(TraitImplAssocEntry_new(TraitImplKey_new(ti.trait_name, ti.type_name), bindings));
        }
        tii = tii + 1;
    }
}

pub fn TypeChecker_verify_trait_impls(self: &mut TypeChecker, program: Program) {
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        // Find trait definition
        var trait_def: OptTraitDef = OptTraitDef::None;
        var tdi: i64 = 0;
        while tdi < program.traits.len() {
            if program.traits.get(tdi).name == ti.trait_name {
                trait_def = OptTraitDef::Some(program.traits.get(tdi));
                break;
            }
            tdi = tdi + 1;
        }
        match trait_def {
            OptTraitDef::Some(td) => {
                // Check all required methods are implemented
                var implemented: Vec<str> = Vec::new();
                var mi: i64 = 0;
                while mi < ti.methods.len() {
                    implemented.push(ti.methods.get(mi).name);
                    mi = mi + 1;
                }
                var tmi: i64 = 0;
                while tmi < td.methods.len() {
                    var tm: TraitMethod = td.methods.get(tmi);
                    if !tc_str_vec_contains(implemented, tm.name) {
                        var has_default: bool = false;
                        match tm.default_body {
                            OptStmts::Some(_) => {
                                has_default = true;
                            }
                            OptStmts::None => {
                                has_default = false;
                            }
                        }
                        if !has_default {
                            self.errors.push("Type error: impl " + ti.trait_name + " for " + ti.type_name + " is missing method '" + tm.name + "'");
                        }
                    }
                    tmi = tmi + 1;
                }
                // The signature of each impl method against the trait's: the
                // number of parameters, then each type the trait writes out
                // in concrete types (one naming Self, an associated type or a
                // type parameter is not compared)
                var assoc_names: Vec<str> = Vec::new();
                var an: i64 = 0;
                while an < td.associated_types.len() {
                    assoc_names.push(td.associated_types.get(an).name);
                    an = an + 1;
                }
                var smi: i64 = 0;
                while smi < ti.methods.len() {
                    var im: Func = ti.methods.get(smi);
                    var stj: i64 = 0;
                    while stj < td.methods.len() {
                        var stm: TraitMethod = td.methods.get(stj);
                        if stm.name == im.name {
                            TypeChecker_check_impl_sig(self, ti, stm, im, assoc_names);
                        }
                        stj = stj + 1;
                    }
                    smi = smi + 1;
                }
                // Check associated types
                var provided_assoc: Vec<str> = Vec::new();
                var ai: i64 = 0;
                while ai < ti.associated_types.len() {
                    provided_assoc.push(ti.associated_types.get(ai).name);
                    ai = ai + 1;
                }
                var ai2: i64 = 0;
                while ai2 < td.associated_types.len() {
                    var assoc_name: str = td.associated_types.get(ai2).name;
                    if !tc_str_vec_contains(provided_assoc, assoc_name) {
                        self.errors.push("Type error: impl " + ti.trait_name + " for " + ti.type_name + " is missing associated type '" + assoc_name + "'");
                    }
                    ai2 = ai2 + 1;
                }
            }
            OptTraitDef::None => {
                self.errors.push("Type error: trait '" + ti.trait_name + "' is not defined (in impl for " + ti.type_name + ")");
            }
        }
        tii = tii + 1;
    }
}

pub enum OptTraitDef {
    Some(TraitDef),
    None,
}

/// Whether a trait's type `ts` (as type_to_str writes it) is concrete enough
/// to compare with an impl's: no `Self`, associated type, type parameter
/// (a capitalised name of one or two letters) or trait object.
fn tc_trait_ty_concrete(ts: str, assoc_names: Vec<str>) -> bool {
    var n: i64 = str_len(ts);
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(ts, i);
        var is_start: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
        if is_start {
            var j: i64 = i;
            while j < n {
                var d: i64 = str_byte_at(ts, j);
                var word: bool = (d >= 65 && d <= 90) || (d >= 97 && d <= 122) || (d >= 48 && d <= 57) || d == 95;
                if !word {
                    break;
                }
                j = j + 1;
            }
            var w: str = str_slice(ts, i, j);
            if w == "Self" || w == "dyn" || w == "impl" {
                return false;
            }
            if tc_str_vec_contains(assoc_names, w) {
                return false;
            }
            if c >= 65 && c <= 90 && j - i <= 2 {
                return false;
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    return true;
}

/// LG4: tc_trait_ty_concrete, where the method's own type parameters `own`
/// (renamed to the impl's) count as concrete: the impl must write them
/// where the trait does (`Vec<U>` stays `Vec<U>`).
fn tc_lg4_ty_concrete(ts: str, assoc_names: Vec<str>, own: Vec<str>) -> bool {
    if own.len() == 0 {
        return tc_trait_ty_concrete(ts, assoc_names);
    }
    var n: i64 = str_len(ts);
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(ts, i);
        var is_start: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
        if is_start {
            var j: i64 = i;
            while j < n {
                var d: i64 = str_byte_at(ts, j);
                var word: bool = (d >= 65 && d <= 90) || (d >= 97 && d <= 122) || (d >= 48 && d <= 57) || d == 95;
                if !word {
                    break;
                }
                j = j + 1;
            }
            var w: str = str_slice(ts, i, j);
            if !tc_str_vec_contains(own, w) {
                if w == "Self" || w == "dyn" || w == "impl" {
                    return false;
                }
                if tc_str_vec_contains(assoc_names, w) {
                    return false;
                }
                if c >= 65 && c <= 90 && j - i <= 2 {
                    return false;
                }
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    return true;
}

/// LG4: `<U, V>` (empty for none), for messages.
fn tc_lg4_tps_str(tps: Vec<str>) -> str {
    if tps.len() == 0 {
        return "";
    }
    var s: str = "<";
    var i: i64 = 0;
    while i < tps.len() {
        if i > 0 {
            s = s + ", ";
        }
        s = s + tps.get(i);
        i = i + 1;
    }
    return s + ">";
}

fn tc_lg4_index_of(v: Vec<str>, s: str) -> i64 {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// 2g.112: `own` and the names in `ts` that tc_trait_ty_concrete's rule
/// would take for type parameters (a capitalised name of one or two
/// letters) but that name a declared struct or enum and no type parameter
/// of the impl (`impl_tps`): with them in the list tc_lg4_ty_concrete
/// counts them concrete. `fn make(self) -> Self` in `impl Make for Pt`
/// reads `Pt`, which was taken for a parameter, so an impl returning i64
/// was accepted.
fn TypeChecker_lg4_declared_short(self: &TypeChecker, ts: str, own: Vec<str>, impl_tps: Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var oi: i64 = 0;
    while oi < own.len() {
        out.push(own.get(oi));
        oi = oi + 1;
    }
    var n: i64 = str_len(ts);
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(ts, i);
        var is_start: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
        if is_start {
            var j: i64 = i;
            while j < n {
                var d: i64 = str_byte_at(ts, j);
                if !((d >= 65 && d <= 90) || (d >= 97 && d <= 122) || (d >= 48 && d <= 57) || d == 95) {
                    break;
                }
                j = j + 1;
            }
            if c >= 65 && c <= 90 && j - i <= 2 {
                val w: str = str_slice(ts, i, j);
                if !tc_str_vec_contains(impl_tps, w) && !tc_str_vec_contains(out, w) && (tc_is_struct(self, w) || TypeChecker_is_known_enum(self, w)) {
                    out.push(w);
                }
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    return out;
}

/// An impl method `im` against the trait's method `tm` (LG4): the same
/// number of parameters after `self`, and the same parameter and return
/// types wherever the trait writes a concrete type.
fn TypeChecker_check_impl_sig(self: &mut TypeChecker, ti: TraitImpl, tm: TraitMethod, im: Func, assoc_names: Vec<str>) {
    var t0: i64 = 0;
    if tm.has_self {
        t0 = 1;
    }
    var i0: i64 = 0;
    if im.params.len() > 0 {
        if im.params.get(0).name == "self" {
            i0 = 1;
        }
    }
    var where_s: str = "method '" + im.name + "' of impl " + ti.trait_name + " for " + ti.type_name;
    if tm.has_self != (i0 == 1) {
        if tm.has_self {
            self.errors.push("Type error: " + where_s + " has no self parameter; the trait's method takes self");
        } else {
            self.errors.push("Type error: " + where_s + " takes self; the trait's method does not");
        }
        return;
    }
    var tn: i64 = tm.params.len() - t0;
    var inn: i64 = im.params.len() - i0;
    if tn != inn {
        self.errors.push("Type error: " + where_s + " takes " + int_to_str(inn) + " parameter(s); the trait's method takes " + int_to_str(tn));
        return;
    }
    // LG4: a generic method's own type parameters: as many as the trait's,
    // no bound the trait's does not have, and the trait's types read with
    // the impl's names for them (`fn m<U>` in the trait, `fn m<V>` in the
    // impl). A method filled in from the trait's default body
    // (compiler.fd fill_default_trait_methods) may come without them.
    var lg4_from: Vec<str> = Vec::new();
    var lg4_to: Vec<Type> = Vec::new();
    var lg4_own: Vec<str> = Vec::new();
    var lg4_default: bool = false;
    match tm.default_body {
        OptStmts::Some(_) => {
            lg4_default = im.type_params.len() == 0;
        }
        OptStmts::None => {
        }
    }
    if tm.type_params.len() != im.type_params.len() && !lg4_default {
        self.errors.push("Type error: " + where_s + " has " + int_to_str(im.type_params.len()) + " type parameter(s); the trait's method has " + int_to_str(tm.type_params.len()) + " (fn " + tm.name + tc_lg4_tps_str(tm.type_params) + ")");
        return;
    }
    if tm.type_params.len() == im.type_params.len() {
        var gk: i64 = 0;
        while gk < tm.type_params.len() {
            lg4_from.push(tm.type_params.get(gk));
            lg4_to.push(Type::Named(im.type_params.get(gk)));
            lg4_own.push(im.type_params.get(gk));
            gk = gk + 1;
        }
        var bk: i64 = 0;
        while bk < im.type_param_bounds.len() {
            var ib: StrPair = im.type_param_bounds.get(bk);
            var ipos: i64 = tc_lg4_index_of(im.type_params, ib.a);
            var allowed_b: bool = false;
            if ipos >= 0 {
                var tbk: i64 = 0;
                while tbk < tm.type_param_bounds.len() {
                    var tb: StrPair = tm.type_param_bounds.get(tbk);
                    if tb.a == tm.type_params.get(ipos) && tb.b == ib.b {
                        allowed_b = true;
                    }
                    tbk = tbk + 1;
                }
            }
            if !allowed_b {
                self.errors.push("Type error: " + where_s + " requires " + ib.a + ": " + ib.b + "; the trait's method does not, so a call through the trait could pass a type without it.\n    Fix: write the bound on the trait's method too, or drop it from the impl's.");
            }
            bk = bk + 1;
        }
    }
    // `Self` and the impl's associated types, as this impl must write them
    // (LG4: a type naming one of them was not compared)
    var view: Vec<StringType> = tc_impl_view_subst(ti);
    var k: i64 = 0;
    while k < tn {
        var ts: str = type_to_str(TypeChecker_resolve_type(self, tc_impl_view_type(tc_subst_type_params(tm.params.get(t0 + k).ty, lg4_from, lg4_to), view)));
        var ist: str = type_to_str(TypeChecker_resolve_type(self, tc_impl_view_type(im.params.get(i0 + k).ty, view)));
        if tc_lg4_ty_concrete(ts, assoc_names, TypeChecker_lg4_declared_short(self, ts, lg4_own, ti.type_params)) && ts != ist {
            self.errors.push("Type error: " + where_s + ": parameter '" + im.params.get(i0 + k).name + "' is " + ist + "; the trait's method says " + ts);
        }
        k = k + 1;
    }
    var tr: str = type_to_str(TypeChecker_resolve_type(self, tc_impl_view_type(tc_subst_type_params(tm.ret_ty, lg4_from, lg4_to), view)));
    var ir: str = type_to_str(TypeChecker_resolve_type(self, tc_impl_view_type(im.ret_ty, view)));
    if tc_lg4_ty_concrete(tr, assoc_names, TypeChecker_lg4_declared_short(self, tr, lg4_own, ti.type_params)) && tr != ir {
        self.errors.push("Type error: " + where_s + " returns " + ir + "; the trait's method returns " + tr);
    }
    TypeChecker_check_impl_lifetimes(self, where_s, tm, im);
}

/// LG3: the parameters (by index) a signature ties its result to: those
/// carrying one of the result's lifetimes `ret_lts`, or, with none written,
/// every reference parameter when the result is a reference.
fn tc_sig_ties(ret_lts: Vec<str>, params: Vec<Param>, ret_ty: Type) -> Vec<i64> {
    if ret_lts.len() > 0 {
        return lifetime_ties(ret_lts, params);
    }
    var out: Vec<i64> = Vec::new();
    if !tc_is_ref_ty(ret_ty) {
        return out;
    }
    var i: i64 = 0;
    while i < params.len() {
        if tc_is_ref_ty(params.get(i).ty) {
            out.push(i);
        }
        i = i + 1;
    }
    return out;
}

fn tc_is_ref_ty(t: Type) -> bool {
    match t {
        Type::Ref(_, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// LG3: when the trait's method or the impl's writes lifetimes, the impl's
/// result may borrow only from parameters the trait's ties it to: a call
/// through the trait (`dyn Tr`, a bound) relies on the trait's signature,
/// so an impl returning a borrow of another argument would outlive it.
fn TypeChecker_check_impl_lifetimes(self: &mut TypeChecker, where_s: str, tm: TraitMethod, im: Func) {
    var tlts: Vec<str> = ann_lifetimes(tm.annotations);
    var ilts: Vec<str> = ann_lifetimes(im.annotations);
    if tlts.len() == 0 && ilts.len() == 0 {
        return;
    }
    var tt: Vec<i64> = tc_sig_ties(tlts, tm.params, tm.ret_ty);
    var it: Vec<i64> = tc_sig_ties(ilts, im.params, im.ret_ty);
    var allowed: str = "";
    var a: i64 = 0;
    while a < tt.len() {
        if tt.get(a) < tm.params.len() {
            if allowed != "" {
                allowed = allowed + ", ";
            }
            allowed = allowed + "'" + tm.params.get(tt.get(a)).name + "'";
        }
        a = a + 1;
    }
    if allowed == "" {
        allowed = "no parameter";
    }
    var k: i64 = 0;
    while k < it.len() {
        var p: i64 = it.get(k);
        if !vec_contains_i64(tt, p) && p < im.params.len() {
            self.errors.push("Type error: " + where_s + " ties its result to parameter '" + im.params.get(p).name + "', but the trait's method ties it to " + allowed + "; write the trait's lifetimes on the impl's method");
        }
        k = k + 1;
    }
}

/// What `Self` and each associated type stand for in the impl `ti`: the
/// implementing type, and the impl's `type Item = ...` bindings. Empty for
/// a generic impl (its `Self` has type arguments; such types stay
/// uncompared, as before).
fn tc_impl_view_subst(ti: TraitImpl) -> Vec<StringType> {
    var out: Vec<StringType> = Vec::new();
    if ti.type_params.len() > 0 {
        return out;
    }
    out.push(StringType_new("Self", Type::Named(ti.type_name)));
    var i: i64 = 0;
    while i < ti.associated_types.len() {
        var b: AssocTypeBinding = ti.associated_types.get(i);
        out.push(StringType_new(b.name, b.ty));
        i = i + 1;
    }
    return out;
}

/// `t` with `Self`, `Item` and `Self::Item` replaced as `view` says (an
/// associated type with type arguments -- a GAT -- is left as it is, so it
/// stays uncompared).
fn tc_impl_view_type(t: Type, view: Vec<StringType>) -> Type {
    if view.len() == 0 {
        return t;
    }
    match t {
        Type::Named(n) => {
            var i: i64 = 0;
            while i < view.len() {
                if view.get(i).key == n {
                    return view.get(i).val;
                }
                i = i + 1;
            }
            return t;
        }
        Type::Assoc(tp, _, an, aargs) => {
            if tp == "Self" && aargs.len() == 0 {
                var j: i64 = 1;
                while j < view.len() {
                    if view.get(j).key == an {
                        return view.get(j).val;
                    }
                    j = j + 1;
                }
            }
            return t;
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(tc_impl_view_type(box_type_unbox(inner), view)), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(tc_impl_view_type(box_type_unbox(elem), view)), size);
        }
        Type::Generic(gname, gargs) => {
            var ga: Vec<Type> = Vec::new();
            var gi: i64 = 0;
            while gi < gargs.len() {
                ga.push(tc_impl_view_type(gargs.get(gi), view));
                gi = gi + 1;
            }
            return Type::Generic(gname, ga);
        }
        Type::Tuple(tts) => {
            var tt: Vec<Type> = Vec::new();
            var ti2: i64 = 0;
            while ti2 < tts.len() {
                tt.push(tc_impl_view_type(tts.get(ti2), view));
                ti2 = ti2 + 1;
            }
            return Type::Tuple(tt);
        }
        _ => {
        }
    }
    return t;
}

// --- check_bodies and verification passes --------------------------------

/// Build O(1) index caches for the typechecker's symbol tables.
/// Called after all modules are registered, before checking bodies.
/// This converts O(n) linear scans into O(1) HashMap lookups for the
/// hottest paths: function signature lookup, struct field lookup,
/// enum variant lookup, const/global/type_alias resolution.
/// With 100K+ LOC, there are thousands of entries in each table.
/// Register the functions, structs and impl methods of the merged program
/// that the per-module registration did not see (src/typechecker.rs
/// register_generated_decls): comptime-generated or desugared items, and
/// the methods of a second `impl T` block for a type.
pub fn TypeChecker_register_generated_decls(self: &mut TypeChecker, program: Program) {
    var known_structs: i64 = HashMap_new();
    var ki: i64 = 0;
    while ki < self.structs.len() {
        HashMap_insert(known_structs, self.structs.get(ki).key, 1);
        ki = ki + 1;
    }
    var known_funcs: i64 = HashMap_new();
    ki = 0;
    while ki < self.funcs.len() {
        HashMap_insert(known_funcs, self.funcs.get(ki).key, 1);
        ki = ki + 1;
    }
    var si: i64 = 0;
    while si < program.structs.len() {
        var s: StructDef = program.structs.get(si);
        if HashMap_get(known_structs, s.name) == 0 {
            var fields: Vec<StructField> = Vec::new();
            var fi: i64 = 0;
            while fi < s.fields.len() {
                fields.push(StructField_new(s.fields.get(fi).name, TypeChecker_resolve_type(self, s.fields.get(fi).ty)));
                fi = fi + 1;
            }
            self.structs.push(StringStructFields_new(s.name, fields));
            TypeChecker_register_field_defaults(self, s);
            tc_note_struct_dimension(s);
        }
        si = si + 1;
    }
    // Enums and constants `comptime gen` adds (LG9: they were dropped
    // before, so nothing registered them)
    var known_enums: i64 = HashMap_new();
    ki = 0;
    while ki < self.enums.len() {
        HashMap_insert(known_enums, self.enums.get(ki), 1);
        ki = ki + 1;
    }
    var gei: i64 = 0;
    while gei < program.enums.len() {
        var ge: EnumDef = program.enums.get(gei);
        if HashMap_get(known_enums, ge.name) == 0 {
            TypeChecker_register_enum(self, ge, self.current_module);
            HashMap_insert(known_enums, ge.name, 1);
        }
        gei = gei + 1;
    }
    var known_consts: i64 = HashMap_new();
    ki = 0;
    while ki < self.consts.len() {
        HashMap_insert(known_consts, self.consts.get(ki).key, 1);
        ki = ki + 1;
    }
    var gci: i64 = 0;
    while gci < program.consts.len() {
        var gc: ConstDef = program.consts.get(gci);
        if HashMap_get(known_consts, gc.name) == 0 {
            map_str_type_set(&mut self.consts, gc.name, gc.ty);
            TypeChecker_set_item_module(self, gc.name, self.current_module);
            TypeChecker_set_item_visibility(self, gc.name, gc.is_pub);
            HashMap_insert(known_consts, gc.name, 1);
        }
        gci = gci + 1;
    }
    HashMap_drop(known_enums);
    HashMap_drop(known_consts);
    var fni: i64 = 0;
    while fni < program.funcs.len() {
        var func: Func = program.funcs.get(fni);
        if HashMap_get(known_funcs, func.name) == 0 {
            var param_types: Vec<Type> = Vec::new();
            var pi: i64 = 0;
            while pi < func.params.len() {
                param_types.push(TypeChecker_resolve_type(self, func.params.get(pi).ty));
                pi = pi + 1;
            }
            self.funcs.push(StringFuncSig_new(func.name, FuncSig_new(param_types, TypeChecker_resolve_type(self, func.ret_ty))));
            TypeChecker_register_fn_params(self, func);
        }
        fni = fni + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var idx: i64 = TypeChecker_methods_at(self, imp.struct_name);
        if idx >= self.methods.len() {
            idx = -1;
        }
        var existing_val: Vec<MethodMapEntry> = Vec::new();
        if idx >= 0 {
            existing_val = self.methods.get(idx).val;
        }
        var to_add: Vec<MethodMapEntry> = Vec::new();
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            var mknown: bool = false;
            var ek: i64 = 0;
            while ek < existing_val.len() && !mknown {
                if existing_val.get(ek).key == method.name {
                    mknown = true;
                }
                ek = ek + 1;
            }
            if !mknown {
                var mparams: Vec<Type> = Vec::new();
                var mpi: i64 = 0;
                while mpi < method.params.len() {
                    mparams.push(TypeChecker_resolve_type(self, method.params.get(mpi).ty));
                    mpi = mpi + 1;
                }
                var has_self: bool = false;
                if method.params.len() > 0 {
                    if method.params.get(0).name == "self" {
                        has_self = true;
                    }
                }
                to_add.push(MethodMapEntry_new(method.name, MethodInfo_with_params(MethodInfo_with_tps(MethodInfo_new(mparams, TypeChecker_resolve_type(self, method.ret_ty), has_self, method.is_pub), method.type_params, method.type_param_bounds), method.params)));
            }
            mi = mi + 1;
        }
        if idx < 0 {
            self.methods.push(StringMethodMap_new(imp.struct_name, to_add));
        } else if to_add.len() > 0 {
            var ai: i64 = 0;
            while ai < to_add.len() {
                method_map_set_entry(&mut existing_val, to_add.get(ai).key, to_add.get(ai).val);
                ai = ai + 1;
            }
            var m_entry: StringMethodMap = self.methods.get(idx);
            m_entry.val = existing_val;
            self.methods.set(idx, m_entry);
            TypeChecker_methods_hm_clear(self, idx);
        }
        impi = impi + 1;
    }
}

pub fn TypeChecker_build_caches(self: &mut TypeChecker) -> void {
    if self.caches_built {
        return;
    }

    // Build func name → index cache
    var fi: i64 = 0;
    while fi < self.funcs.len() {
        HashMap_insert(self.func_cache, self.funcs.get(fi).key, fi + 1);
        // +1 so 0 = not found
        fi = fi + 1;
    }

    // Build struct name → index cache
    var si: i64 = 0;
    while si < self.structs.len() {
        HashMap_insert(self.struct_cache, self.structs.get(si).key, si + 1);
        si = si + 1;
    }

    // Build enum name → index cache
    var ei: i64 = 0;
    while ei < self.enums.len() {
        HashMap_insert(self.enum_cache, self.enums.get(ei), ei + 1);
        ei = ei + 1;
    }

    // Build const name → index cache
    var ci: i64 = 0;
    while ci < self.consts.len() {
        HashMap_insert(self.const_cache, self.consts.get(ci).key, ci + 1);
        ci = ci + 1;
    }

    // Build global name → index cache
    var gi: i64 = 0;
    while gi < self.globals.len() {
        HashMap_insert(self.global_cache, self.globals.get(gi).key, gi + 1);
        gi = gi + 1;
    }

    // Build type_alias name → index cache
    var ai: i64 = 0;
    while ai < self.type_aliases.len() {
        HashMap_insert(self.alias_cache, self.type_aliases.get(ai).key, ai + 1);
        ai = ai + 1;
    }

    self.caches_built = true;
}

// ─── Annotation whitelist + placement ────────────────────────────────────
// Mirrors src/typechecker.rs::check_annotation_validity. The parser accepts
// any `@name`; without this pass a typo is a silent no-op.
// Target bits: fn=1, struct=2, param=4, local=8, global=16.

fn annotation_target_mask(name: str) -> i64 {
    // F59: @grid-safe (IEC 61850 protection code) and its @no-blocking
    if name == "grid-safe" || name == "no-blocking" {
        return 1;
    }
    // rm-P9: F45 @redundant, F47 @partitioned(name), F32 @serverless
    if name == "redundant" || name == "partitioned" || name == "serverless" {
        return 1;
    }
    // CT1: @hermetic (a test reaches the world only through stdlib/world)
    if name == "hermetic" {
        return 1;
    }
    // rm-P9: F34 @event, @emit(E, ...) and @contract (blockchain)
    if name == "event" || name == "emit" || name == "contract" {
        return 1;
    }
    if name == "deterministic" || name == "conserve" || name == "gas" || name == "no-alloc" || name == "no-recursion" || name == "no-unbounded" || name == "no-indirect" || name == "requires-audit" || name == "bounded" || name == "bounded-stack" || name == "firmware" || name == "no-panic" || name == "crashfree" || name == "medical" || name == "safety-critical" || name == "autosar" || name == "dal-a" || name == "constant_time" || name == "realtime" || name == "differentiable" || name == "quantized" || name == "checkpoint" || name == "dp" || name == "shard" || name == "adapter" || name == "audit" || name == "simd" || name == "interrupt" || name == "kernel" || name == "shader" || name == "unsafe" || name == "test" || name == "allocator" || name == "sanitizer" || name == "sink" || name == "declassify" || name == "wrapping" || name == "panic_handler" || name == "deprecated" || name == "export" || name == "cold" {
        return 1;
    }
    if name == "linear" || name == "send" || name == "sync" || name == "repr" || name == "packed" || name == "derive" || name == "scoped" {
        return 2;
    }
    // CL10: a unit of measure (`@dimension(m = 1, s = -1)`, ast.fd)
    if name == "dimension" {
        return 2;
    }
    if name == "cfg" {
        return 3;
    }
    // fn + struct
    if name == "tainted" || name == "public" {
        return 4;
    }
    if name == "secret" || name == "sensitive" {
        return 13;
    }
    // fn + param + local
    if name == "zeroize" {
        return 8;
    }
    if name == "cpu_local" {
        return 16;
    }
    // fn + struct + param: the parser writes it for `&'a T` lifetimes and
    // `struct View<'a>` (LG3); the reference escape check and the borrow
    // checker read it (compiler/escape.fd, compiler/borrowck.fd)
    if name == "lifetime" {
        return 7;
    }
    return 0;
}

fn annotation_targets_str(mask: i64) -> str {
    var s: str = "";
    if mask % 2 == 1 {
        s = s + "fn/";
    }
    if (mask / 2) % 2 == 1 {
        s = s + "struct/";
    }
    if (mask / 4) % 2 == 1 {
        s = s + "param/";
    }
    if (mask / 8) % 2 == 1 {
        s = s + "local/";
    }
    if (mask / 16) % 2 == 1 {
        s = s + "global/";
    }
    if str_len(s) > 0 {
        s = str_slice(s, 0, str_len(s) - 1);
    }
    return s;
}

fn check_one_annotation_fd(self: &mut TypeChecker, a: Annotation, target: str, what: str) {
    var mask: i64 = annotation_target_mask(a.name);
    if mask == 0 {
        self.errors.push("Unknown annotation '@" + a.name + "' on '" + what + "': no compiler pass consumes this name\n    and it will be silently ignored. Check the spelling.");
        return;
    }
    var bit: i64 = 0;
    if target == "fn" {
        bit = 1;
    }
    if target == "struct" {
        bit = 2;
    }
    if target == "param" {
        bit = 4;
    }
    if target == "local" {
        bit = 8;
    }
    if target == "global" {
        bit = 16;
    }
    if bit > 0 && (mask / bit) % 2 == 0 {
        self.errors.push("Misplaced annotation '@" + a.name + "' on '" + what + "': valid on " + annotation_targets_str(mask) + ", not " + target + ".");
    }
}

fn check_ann_list_fd(self: &mut TypeChecker, anns: Vec<Annotation>, target: str, fname: str) {
    var i: i64 = 0;
    while i < anns.len() {
        check_one_annotation_fd(self, anns.get(i), target, fname);
        i = i + 1;
    }
}

fn check_local_annotations_fd(self: &mut TypeChecker, stmts: Vec<Stmt>, fname: str) {
    var i: i64 = 0;
    while i < stmts.len() {
        var s: Stmt = stmts.get(i);
        match s {
            Stmt::Let(_, _, _, _, _, anns, _) => {
                check_ann_list_fd(self, anns, "local", fname);
            }
            Stmt::LetUninit(_, _, anns, _) => {
                check_ann_list_fd(self, anns, "local", fname);
            }
            Stmt::If(_, then_b, else_b, _) => {
                check_local_annotations_fd(self, then_b, fname);
                match else_b {
                    OptStmts::Some(eb) => {
                        check_local_annotations_fd(self, eb, fname);
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(_, body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            Stmt::For(_, _, body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            Stmt::Loop(body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            Stmt::Defer(body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            Stmt::Match(_, arms, _) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    check_local_annotations_fd(self, arms.get(ai).body, fname);
                    ai = ai + 1;
                }
            }
            Stmt::Handle(body, handlers, _) => {
                check_local_annotations_fd(self, body, fname);
                var hi: i64 = 0;
                while hi < handlers.len() {
                    check_local_annotations_fd(self, handlers.get(hi).body, fname);
                    hi = hi + 1;
                }
            }
            Stmt::RegionBlock(_, _, _, _, _, body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            Stmt::Sandbox(body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            Stmt::Unsafe(body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            Stmt::Txn(body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            Stmt::ComptimeGen(body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            Stmt::GradBlock(_, body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            Stmt::Query(_, body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            Stmt::Select(cases, def, _) => {
                var ci: i64 = 0;
                while ci < cases.len() {
                    check_local_annotations_fd(self, cases.get(ci).body, fname);
                    ci = ci + 1;
                }
                match def {
                    OptStmts::Some(db) => {
                        check_local_annotations_fd(self, db, fname);
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::Parallel(branches, _) => {
                var bi: i64 = 0;
                while bi < branches.len() {
                    check_local_annotations_fd(self, branches.get(bi), fname);
                    bi = bi + 1;
                }
            }
            Stmt::SpawnScope(body, _) => {
                check_local_annotations_fd(self, body, fname);
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

fn check_fn_annotations_fd(self: &mut TypeChecker, func: Func) {
    check_ann_list_fd(self, func.annotations, "fn", func.name);
    var pi: i64 = 0;
    while pi < func.params.len() {
        check_ann_list_fd(self, func.params.get(pi).annotations, "param", func.name);
        pi = pi + 1;
    }
    check_local_annotations_fd(self, func.body, func.name);
}

/// Reference §11: an annotated top-level function cannot also be `async`.
/// The parser takes `@ann async fn` (TL2) so that @event and @redundant
/// reject it with their own reasons (em_check_event,
/// TypeChecker_verify_redundant); any other annotation is refused here
/// (s11_annotation_on_async_rejected.fd). `@lifetime` is the parser's own
/// (LG3, from `fn f<'a>`), not one the program wrote.
fn check_async_annotations_fd(self: &mut TypeChecker, func: Func) {
    if !func.is_async {
        return;
    }
    var i: i64 = 0;
    while i < func.annotations.len() {
        val an: str = func.annotations.get(i).name;
        if an != "event" && an != "redundant" && an != "lifetime" {
            self.errors.push("Misplaced annotation '@" + an + "' on '" + func.name + "': an annotated function cannot also be async (reference §11).\n    Fix: remove `async`, or move the annotation to a plain function the async one calls.");
            return;
        }
        i = i + 1;
    }
}

pub fn TypeChecker_check_annotation_validity(self: &mut TypeChecker, program: Program) {
    var i: i64 = 0;
    while i < program.funcs.len() {
        check_fn_annotations_fd(self, program.funcs.get(i));
        check_async_annotations_fd(self, program.funcs.get(i));
        i = i + 1;
    }
    i = 0;
    while i < program.impls.len() {
        var impl_: ImplDef = program.impls.get(i);
        var mi: i64 = 0;
        while mi < impl_.methods.len() {
            check_fn_annotations_fd(self, impl_.methods.get(mi));
            mi = mi + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var tmi: i64 = 0;
        while tmi < ti.methods.len() {
            check_fn_annotations_fd(self, ti.methods.get(tmi));
            tmi = tmi + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < program.structs.len() {
        var sd: StructDef = program.structs.get(i);
        check_ann_list_fd(self, sd.annotations, "struct", sd.name);
        TypeChecker_check_dimension_struct(self, sd);
        var fi: i64 = 0;
        while fi < sd.fields.len() {
            check_ann_list_fd(self, sd.fields.get(fi).annotations, "param", sd.name);
            fi = fi + 1;
        }
        i = i + 1;
    }
}

pub fn TypeChecker_check_bodies(self: &mut TypeChecker, program: Program) {
    // TL2: the errors of this check (placed at their function at the end)
    val tl2_from: i64 = self.errors.len();
    // Reject unknown / misplaced annotations before any pass consumes them —
    // otherwise a typo is a silent no-op.
    TypeChecker_check_annotation_validity(self, program);
    // Build O(1) lookup caches before checking (memoize type lookups)
    TypeChecker_build_caches(self);
    // CE9: generic calls and what generic bodies need, of this check only
    tc_ce9_reset();
    // BG24: no thread entry of this checker names a parallel branch yet
    if self.thread_entries.len() == 0 {
        tc_par_reset();
    }
    // Pre-pass: compute direct effects of each function
    TypeChecker_compute_func_effects(self, program);
    // Verify declared effects match inferred effects
    TypeChecker_verify_declared_effects(self, program);
    // Verify safety annotations (simplified -- just check @deterministic)
    TypeChecker_verify_deterministic(self, program);
    // Additional verification passes (stubs -- permissive, don't reject)
    // These are not needed for self-hosting since the compiler's own code
    // doesn't use these annotations.
    TypeChecker_verify_conserve(self, program);
    TypeChecker_verify_gas(self, program);
    TypeChecker_verify_safety_annotations(self, program);
    TypeChecker_verify_constant_time(self, program);
    TypeChecker_verify_realtime(self, program);
    TypeChecker_verify_differentiable(self, program);
    TypeChecker_verify_quantized(self, program);
    TypeChecker_verify_checkpoint(self, program);
    TypeChecker_verify_dp(self, program);
    TypeChecker_verify_shard(self, program);
    TypeChecker_verify_adapter(self, program);
    TypeChecker_verify_tainted(self, program);
    // CA4: lock order across the call graph (a cycle is a deadlock)
    TypeChecker_verify_lock_order(self, program);
    // (CT1 @hermetic: after the bodies, below)
    // rm-P9: @redundant (F45), @partitioned (F47), @serverless (F32)
    TypeChecker_verify_redundant(self, program);
    TypeChecker_verify_partitioned(self, program);
    TypeChecker_verify_serverless(self, program);
    // rm-P9: F34 @event/@emit event logging and @contract verification
    TypeChecker_verify_emit(self, program);
    TypeChecker_verify_scoped(self, program);
    // (@secret is checked by compiler::secrecy.)
    TypeChecker_verify_contracts(self, program);
    TypeChecker_verify_allocator_params(self, program);
    // Mark all functions as capability-verified before checking
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        self.cap_verified.push(program.funcs.get(fi).name);
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            self.cap_verified.push(imp.methods.get(mi).name);
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    // Check function bodies
    var fi2: i64 = 0;
    while fi2 < program.funcs.len() {
        if !tc_skips(self, "fn:" + program.funcs.get(fi2).name) {
            TypeChecker_check_func(self, program.funcs.get(fi2));
        }
        fi2 = fi2 + 1;
    }
    // BG117: a const's literal must fit its declared type — the initializer
    // is folded at use sites and no earlier pass type-checked it
    var cci: i64 = 0;
    while cci < program.consts.len() {
        var cdef: ConstDef = program.consts.get(cci);
        TypeChecker_check_value_fits(self, cdef.ty, cdef.ty, cdef.expr, self.current_line);
        cci = cci + 1;
    }
    // Check impl method bodies
    var impi2: i64 = 0;
    while impi2 < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi2);
        var saved_tp: Vec<str> = self.current_type_params;
        var saved_self: OptString = self.current_self_type;
        if imp.type_params.len() > 0 {
            self.current_type_params = imp.type_params;
        }
        self.current_self_type = OptString::Some(imp.struct_name);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            if !tc_skips(self, "impl:" + imp.struct_name + ":" + imp.methods.get(mi).name) {
                TypeChecker_check_func(self, imp.methods.get(mi));
            }
            mi = mi + 1;
        }
        self.current_type_params = saved_tp;
        self.current_self_type = saved_self;
        impi2 = impi2 + 1;
    }
    // Check trait impl method bodies
    var tii: i64 = 0;
    while tii < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(tii);
        var saved_tp: Vec<str> = self.current_type_params;
        var saved_self: OptString = self.current_self_type;
        if ti.type_params.len() > 0 {
            self.current_type_params = ti.type_params;
        }
        self.current_self_type = OptString::Some(ti.type_name);
        var mi: i64 = 0;
        while mi < ti.methods.len() {
            if !tc_skips(self, "trait:" + ti.type_name + ":" + ti.methods.get(mi).name) {
                TypeChecker_check_func(self, ti.methods.get(mi));
            }
            mi = mi + 1;
        }
        self.current_type_params = saved_tp;
        self.current_self_type = saved_self;
        tii = tii + 1;
    }
    TypeChecker_ce9_check_calls(self);
    TypeChecker_verify_method_calls(self, program);
    // BG22, BG59: the effect rules and recursion through the method calls
    // checking the bodies recorded
    TypeChecker_verify_effects_through_methods(self, program);
    TypeChecker_verify_method_recursion(self, program);
    // CT1: a @hermetic test reaches the world only through stdlib/world.
    // After the bodies (2g.112): its search follows the method calls
    // `x.m(..)` that checking the bodies recorded
    // (TypeChecker_record_method_call); run with the other annotation
    // checks before them, it saw none, so a test reaching the clock
    // through `t.elapsed()` was accepted
    TypeChecker_verify_hermetic(self, program);
    TypeChecker_verify_no_races(self, program);
    tc_place_fn_errors(self, tl2_from, program);
}

/// Whether `key` names a body this check leaves out (see skip_bodies).
pub fn tc_skips(self: &TypeChecker, key: str) -> bool {
    if self.skip_bodies == 0 {
        return false;
    }
    return HashMap_contains(self.skip_bodies, key);
}

/// The keys of every body in `core` that `others` does not redefine: what a
/// build may skip once this core has been checked clean (release D9).
pub fn tc_core_skip_set(core: Program, others: Vec<Program>) -> i64 {
    var redefined: i64 = HashMap_new();
    var oi: i64 = 0;
    while oi < others.len() {
        var o: Program = others.get(oi);
        var k: i64 = 0;
        while k < o.funcs.len() {
            HashMap_insert(redefined, "fn:" + o.funcs.get(k).name, 1);
            k = k + 1;
        }
        k = 0;
        while k < o.impls.len() {
            var im: ImplDef = o.impls.get(k);
            var m: i64 = 0;
            while m < im.methods.len() {
                HashMap_insert(redefined, "impl:" + im.struct_name + ":" + im.methods.get(m).name, 1);
                m = m + 1;
            }
            k = k + 1;
        }
        oi = oi + 1;
    }
    var skip: i64 = HashMap_new();
    var i: i64 = 0;
    while i < core.funcs.len() {
        var key: str = "fn:" + core.funcs.get(i).name;
        if !HashMap_contains(redefined, key) {
            HashMap_insert(skip, key, 1);
        }
        i = i + 1;
    }
    i = 0;
    while i < core.impls.len() {
        var imp: ImplDef = core.impls.get(i);
        var m: i64 = 0;
        while m < imp.methods.len() {
            var key: str = "impl:" + imp.struct_name + ":" + imp.methods.get(m).name;
            if !HashMap_contains(redefined, key) {
                HashMap_insert(skip, key, 1);
            }
            m = m + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < core.trait_impls.len() {
        var ti: TraitImpl = core.trait_impls.get(i);
        var m: i64 = 0;
        while m < ti.methods.len() {
            HashMap_insert(skip, "trait:" + ti.type_name + ":" + ti.methods.get(m).name, 1);
            m = m + 1;
        }
        i = i + 1;
    }
    return skip;
}

/// Where `name`'s methods are in self.methods (self.methods.len() when it
/// has none). Entries keep their position once added, so the index only
/// grows: what was pushed since the last call is indexed first.
/// As TypeChecker_methods_at, without filling the index: what was added
/// since the last fill is scanned.
fn TypeChecker_methods_at_ro(self: &TypeChecker, name: str) -> i64 {
    if HashMap_contains(self.methods_index, name) {
        return HashMap_get(self.methods_index, name) - 1;
    }
    var i: i64 = self.methods_indexed;
    while i < self.methods.len() {
        if self.methods.get(i).key == name {
            return i;
        }
        i = i + 1;
    }
    return self.methods.len();
}

fn TypeChecker_methods_at(self: &mut TypeChecker, name: str) -> i64 {
    while self.methods_indexed < self.methods.len() {
        var key: str = self.methods.get(self.methods_indexed).key;
        if !HashMap_contains(self.methods_index, key) {
            HashMap_insert(self.methods_index, key, self.methods_indexed + 1);
        }
        self.methods_indexed = self.methods_indexed + 1;
    }
    if !HashMap_contains(self.methods_index, name) {
        return self.methods.len();
    }
    return HashMap_get(self.methods_index, name) - 1;
}

/// Position of method `mname` in type `tname`'s method Vec, or -1.
/// Builds a per-type HashMap on first use (CS8: every x.m() call scanned
/// the type's method Vec by name — Vec has ~40 methods and the compiler
/// calls methods thousands of times).
fn TypeChecker_method_find(self: &mut TypeChecker, tname: str, mname: str) -> i64 {
    var mi: i64 = TypeChecker_methods_at(self, tname);
    if mi < 0 || mi >= self.methods.len() {
        return -1;
    }
    while self.methods_hm.len() <= mi {
        self.methods_hm.push(0);
    }
    var hm: i64 = self.methods_hm.get(mi);
    if hm == 0 {
        hm = HashMap_new();
        var mm: Vec<MethodMapEntry> = self.methods.get(mi).val;
        var i: i64 = 0;
        while i < mm.len() {
            var k: str = mm.get(i).key;
            if !HashMap_contains(hm, k) {
                HashMap_insert(hm, k, i + 1);
            }
            i = i + 1;
        }
        self.methods_hm.set(mi, hm);
    }
    if !HashMap_contains(hm, mname) {
        return -1;
    }
    return HashMap_get(hm, mname) - 1;
}

/// methods[i] was rewritten: forget its method index.
fn TypeChecker_methods_hm_clear(self: &mut TypeChecker, mi: i64) {
    if mi < 0 || mi >= self.methods_hm.len() {
        return;
    }
    var hm: i64 = self.methods_hm.get(mi);
    if hm != 0 {
        HashMap_drop(hm);
        self.methods_hm.set(mi, 0);
    }
}

/// Read-only TypeChecker_method_find: uses the per-type index when it is
/// built, scans the type's method Vec when it is not. -1 on miss.
fn TypeChecker_method_find_ro(self: &TypeChecker, tname: str, mname: str) -> i64 {
    var mi: i64 = TypeChecker_methods_at_ro(self, tname);
    if mi < 0 || mi >= self.methods.len() {
        return -1;
    }
    if mi < self.methods_hm.len() {
        var hm: i64 = self.methods_hm.get(mi);
        if hm != 0 {
            if !HashMap_contains(hm, mname) {
                return -1;
            }
            return HashMap_get(hm, mname) - 1;
        }
    }
    var mm: Vec<MethodMapEntry> = self.methods.get(mi).val;
    var i: i64 = 0;
    while i < mm.len() {
        if mm.get(i).key == mname {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Position of struct `name` in self.structs, or -1 (the first one, as a
/// scan would find).
fn TypeChecker_struct_pos(self: &mut TypeChecker, name: str) -> i64 {
    while self.sname_indexed < self.structs.len() {
        var key: str = self.structs.get(self.sname_indexed).key;
        if !HashMap_contains(self.sname_index, key) {
            HashMap_insert(self.sname_index, key, self.sname_indexed + 1);
        }
        self.sname_indexed = self.sname_indexed + 1;
    }
    return HashMap_get(self.sname_index, name) - 1;
}

/// As TypeChecker_struct_pos, without filling the index: what was added
/// since the last fill is scanned.
fn TypeChecker_struct_pos_ro(self: &TypeChecker, name: str) -> i64 {
    if HashMap_contains(self.sname_index, name) {
        return HashMap_get(self.sname_index, name) - 1;
    }
    var i: i64 = self.sname_indexed;
    while i < self.structs.len() {
        if self.structs.get(i).key == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Position of enum `name` in self.enums, or -1.
fn TypeChecker_enum_pos(self: &mut TypeChecker, name: str) -> i64 {
    while self.ename_indexed < self.enums.len() {
        var key: str = self.enums.get(self.ename_indexed);
        if !HashMap_contains(self.ename_index, key) {
            HashMap_insert(self.ename_index, key, self.ename_indexed + 1);
        }
        self.ename_indexed = self.ename_indexed + 1;
    }
    return HashMap_get(self.ename_index, name) - 1;
}

fn tc_find_func(program: Program, name: str) -> i64 {
    var i: i64 = 0;
    while i < program.funcs.len() {
        if program.funcs.get(i).name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// The name the race check knows the function `name` by: a call or spawn
/// may name it with its module (`nat_ir::f`, `compiler::nat_ir::f`); the
/// functions of `fpos` (name -> index + 1) are by their plain name.
fn tc_race_fn_name(fpos: i64, name: str) -> str {
    if HashMap_contains(fpos, name) {
        return name;
    }
    var k: i64 = str_rfind(name, "::");
    if k >= 0 {
        var tail: str = str_slice(name, k + 2, str_len(name));
        if HashMap_contains(fpos, tail) {
            return tail;
        }
    }
    return name;
}

/// src/typechecker.rs verify_no_races: a function that runs on another thread
/// may not write a global of the program unless it takes a lock. The spawns
/// and writes of every module tc_module_race_checked admits count (the
/// program's, the compiler's own, imported non-stdlib ones), so a worker an
/// imported module spawns is checked as one of the main file is.
fn TypeChecker_verify_no_races(self: &mut TypeChecker, program: Program) {
    if self.thread_entries.len() == 0 || self.write_funcs.len() == 0 {
        return;
    }
    // SP10: functions by name and the reached set are tables (first function
    // of a name wins, as tc_find_func's scan); both were scans per name
    var fpos: i64 = HashMap_new();
    var fk: i64 = 0;
    while fk < program.funcs.len() {
        if !HashMap_contains(fpos, program.funcs.get(fk).name) {
            HashMap_insert(fpos, program.funcs.get(fk).name, fk + 1);
        }
        fk = fk + 1;
    }
    // BG26: the methods too (`Type.method`, TypeChecker_hm_graph), with the
    // method calls checking the bodies recorded; BG24: a `parallel { }`
    // branch by the name TypeChecker_par_begin gave it
    var rg: HmGraph = TypeChecker_hm_graph(self, &program);
    var reached: i64 = HashMap_new();
    var work: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < self.thread_entries.len() {
        work.push(self.thread_entries.get(i));
        i = i + 1;
    }
    while work.len() > 0 {
        var name: str = tc_race_fn_name(fpos, work.pop());
        if !HashMap_contains(reached, name) {
            HashMap_insert(reached, name, 1);
            var called: Vec<str> = TypeChecker_race_calls(self, &program, fpos, &rg, name);
            var c: i64 = 0;
            while c < called.len() {
                work.push(called.get(c));
                c = c + 1;
            }
        }
    }
    i = 0;
    while i < self.write_funcs.len() {
        var func: str = self.write_funcs.get(i);
        if HashMap_contains(reached, func) {
            var called: Vec<str> = TypeChecker_race_calls(self, &program, fpos, &rg, func);
            var locked: bool = false;
            var c: i64 = 0;
            while c < called.len() {
                if str_ends_with(called.get(c), "mutex_lock") || str_ends_with(called.get(c), "write_lock") || str_ends_with(called.get(c), ".lock") {
                    locked = true;
                }
                c = c + 1;
            }
            if !locked {
                // the module, when the write is not in the program's own file
                var where_mod: str = "";
                match TypeChecker_get_item_module(self, func) {
                    OptString::Some(fm) => {
                        if fm != "main" && fm != g_tc_program_module {
                            where_mod = " (module " + fm + ")";
                        }
                    }
                    OptString::None => {
                    }
                }
                var who: str = "'" + func + "'" + where_mod;
                var par_at: i64 = tc_par_index(func);
                if par_at >= 0 {
                    who = "a branch of `parallel { }` in '" + g_tc_par_fns.get(par_at) + "'";
                }
                var race_msg: str = "Race error (line " + int_to_str(self.write_lines.get(i)) + "): " + who + " runs on another thread and writes the global '" + self.write_globals.get(i) + "' with no lock.\n    Fix: hold a mutex around the write, or use p_shared_alloc and the p_atomic_ functions.";
                // a build that checks an imported module's bodies again
                // (the no-std path) runs this check again: one error each
                var dup: bool = false;
                var ek: i64 = 0;
                while ek < self.errors.len() && !dup {
                    if self.errors.get(ek) == race_msg {
                        dup = true;
                    }
                    ek = ek + 1;
                }
                if !dup {
                    self.errors.push(race_msg);
                }
            }
        }
        i = i + 1;
    }
    HashMap_drop(fpos);
    HashMap_drop(reached);
    HashMap_drop(rg.index);
    HashMap_drop(rg.mc_head);
}

// `name` is declared with `val` in the innermost scope that declares it.
fn TypeChecker_is_val(self: &TypeChecker, name: str) -> bool {
    var shadow: str = "!" + name;
    var i: i64 = self.val_vars_per_scope.len() - 1;
    while i >= 0 {
        var scope: Vec<str> = self.val_vars_per_scope.get(i);
        if tc_str_vec_contains(scope, name) {
            return true;
        }
        if tc_str_vec_contains(scope, shadow) {
            return false;
        }
        i = i - 1;
    }
    return false;
}

fn TypeChecker_record_method_call(self: &mut TypeChecker, owner: str, method: str) {
    match self.current_func_name {
        OptString::Some(caller) => {
            var from: str = caller;
            match self.current_self_type {
                OptString::Some(t) => {
                    from = t + "." + caller;
                }
                OptString::None => {
                }
            }
            self.method_call_callers.push(from);
            self.method_call_owners.push(owner);
            self.method_call_names.push(method);
            // BG24/BG26: inside a `parallel { }` branch the call is also the
            // branch's (the race check follows it from the branch)
            if str_len(g_tc_par_writer) > 0 {
                self.method_call_callers.push(g_tc_par_writer);
                self.method_call_owners.push(owner);
                self.method_call_names.push(method);
            }
        }
        OptString::None => {
        }
    }
}

fn tc_has_annotation(anns: Vec<Annotation>, name: str) -> bool {
    var i: i64 = 0;
    while i < anns.len() {
        if anns.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 2g.64: where a match error points: the function being checked (and its
// module when that is not the program's own), not just the module, whose
// name is `main` for the user's file whatever function holds the match.
fn TypeChecker_match_where(self: &mut TypeChecker) -> str {
    var module: str = self.current_module;
    match self.current_func_name {
        OptString::Some(fname) => {
            if module == "" || module == "main" {
                return "function '" + fname + "'";
            }
            return "function '" + fname + "' of " + module;
        }
        OptString::None => {
        }
    }
    if module == "" {
        return "main";
    }
    return module;
}

// A match on an enum or bool covers every case, or has a catch-all arm.
// An arm with a guard covers nothing (the guard may be false); a generic
// enum (`Option<T>`, `Result<T, E>`, a user `E<T>`) is checked by its
// variants as a plain one is; a bare name that is one of the enum's
// variants (`None`) covers that variant, not everything (known-bugs 2g.7).
fn TypeChecker_check_exhaustive(self: &mut TypeChecker, match_ty: Type, arms: Vec<MatchArm>, line: i64) {
    var enum_name: str = "";
    match match_ty {
        Type::Named(n) => {
            enum_name = n;
        }
        Type::Generic(gn, _) => {
            enum_name = gn;
        }
        Type::Ref(inner, _) => {
            match box_type_unbox(inner) {
                Type::Named(rn) => {
                    enum_name = rn;
                }
                Type::Generic(rgn, _) => {
                    enum_name = rgn;
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    var variants: Vec<EnumVariantEntry> = Vec::new();
    var is_enum: bool = false;
    if enum_name != "" {
        var ei: i64 = 0;
        while ei < self.enum_variants.len() {
            if self.enum_variants.get(ei).key == enum_name {
                variants = self.enum_variants.get(ei).val;
                is_enum = true;
                ei = self.enum_variants.len();
            }
            ei = ei + 1;
        }
    }
    var covered: Vec<str> = Vec::new();
    var has_true: bool = false;
    var has_false: bool = false;
    var any_guard: bool = false;
    var i: i64 = 0;
    while i < arms.len() {
        var guarded: bool = false;
        match arms.get(i).guard {
            OptBoxExpr::Some(_) => {
                guarded = true;
                any_guard = true;
            }
            OptBoxExpr::None => {
            }
        }
        if !guarded {
            match arms.get(i).pattern {
                Pattern::Wildcard => {
                    return;
                }
                Pattern::Ident(pn) => {
                    var is_variant: bool = false;
                    if is_enum {
                        var vk: i64 = 0;
                        while vk < variants.len() {
                            if variants.get(vk).name == pn {
                                is_variant = true;
                            }
                            vk = vk + 1;
                        }
                    }
                    if !is_variant {
                        return;
                    }
                    covered.push(pn);
                }
                Pattern::EnumVariant(_, variant, _) => {
                    covered.push(variant);
                }
                Pattern::BoolLit(b) => {
                    if b {
                        has_true = true;
                    } else {
                        has_false = true;
                    }
                }
                _ => {
                }
            }
        }
        i = i + 1;
    }
    if is_enum {
        var missing: str = "";
        var vi: i64 = 0;
        while vi < variants.len() {
            var v: str = variants.get(vi).name;
            if !tc_str_vec_contains(covered, v) {
                if str_len(missing) > 0 {
                    missing = missing + ", ";
                }
                missing = missing + enum_name + "::" + v;
            }
            vi = vi + 1;
        }
        if str_len(missing) > 0 {
            var ghint: str = "";
            if any_guard {
                ghint = "
    (an arm with a guard `if ...` covers nothing: add an arm without one, or `_ =>`)";
            }
            self.errors.push("Type error: non-exhaustive match at line " + int_to_str(line) + " in " + TypeChecker_match_where(self) + " — missing variant(s): " + missing + ghint);
        }
        return;
    }
    match match_ty {
        Type::Bool => {
            if !has_true || !has_false {
                self.errors.push("Type error: non-exhaustive match on bool at line " + int_to_str(line) + " in " + TypeChecker_match_where(self));
            }
        }
        _ => {
        }
    }
}

// What the name-based scans cannot see: a method call's target depends on
// its receiver's type, known only once bodies are checked. A call to a user
// method is held to the same rules as a call to a function.
fn TypeChecker_verify_method_calls(self: &mut TypeChecker, program: Program) {
    var index: i64 = HashMap_new();
    var funcs: Vec<Func> = Vec::new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        HashMap_insert(index, program.funcs.get(i).name, funcs.len());
        funcs.push(program.funcs.get(i));
        i = i + 1;
    }
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            HashMap_insert(index, imp.struct_name + "." + imp.methods.get(mi).name, funcs.len());
            funcs.push(imp.methods.get(mi));
            mi = mi + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < self.method_call_callers.len() {
        var caller: str = self.method_call_callers.get(i);
        var target: str = self.method_call_owners.get(i) + "." + self.method_call_names.get(i);
        if HashMap_contains(index, caller) && HashMap_contains(index, target) {
            TypeChecker_check_method_call_rules(self, caller, funcs.get(HashMap_get(index, caller)), target, funcs.get(HashMap_get(index, target)));
        }
        i = i + 1;
    }
}

fn TypeChecker_check_method_call_rules(self: &mut TypeChecker, caller: str, from: Func, target: str, to: Func) {
    var prims: Vec<str> = expand_safety_primitives(from.annotations);
    if prims.len() > 0 {
        var to_prims: Vec<str> = expand_safety_primitives(to.annotations);
        var pi: i64 = 0;
        while pi < prims.len() {
            if !has_primitive(to_prims, prims.get(pi)) {
                self.errors.push("Safety error: function '" + caller + "' is safety-annotated but calls method '" + target + "',\n    which lacks the '" + prims.get(pi) + "' primitive.\n    Fix: add the missing safety annotation to '" + target + "', or remove the call.");
                pi = prims.len();
            }
            pi = pi + 1;
        }
    }
    if tc_has_annotation(from.annotations, "deterministic") && !tc_has_annotation(to.annotations, "deterministic") {
        self.errors.push("Safety error: @deterministic function '" + caller + "' calls method '" + target + "', which is not @deterministic.");
    }
    if tc_has_annotation(from.annotations, "conserve") && !tc_has_annotation(to.annotations, "conserve") {
        self.errors.push("Conservation error: function '" + caller + "' is @conserve but calls method '" + target + "', which is not @conserve.");
    }
    if tc_has_annotation(from.annotations, "constant_time") && !tc_has_annotation(to.annotations, "constant_time") {
        self.errors.push("Safety error: @constant_time function '" + caller + "' calls method '" + target + "', which is not @constant_time.");
    }
    if from.has_effect_annotation {
        var di: i64 = 0;
        while di < to.declared_effects.len() {
            if !tc_str_vec_contains(from.declared_effects, to.declared_effects.get(di)) {
                self.errors.push("Effect error: function '" + caller + "' calls method '" + target + "', which has effect " + to.declared_effects.get(di) + ", not declared by '" + caller + "'.");
            }
            di = di + 1;
        }
    }
}

// Helper: set func_effects entry (insert or update)
fn TypeChecker_set_func_effects(self: &mut TypeChecker, name: str, effects: Vec<str>) {
    var slot: i64 = HashMap_get(self.func_effects_index, name);
    if slot != 0 {
        var entry: StringVecStrTc = self.func_effects.get(slot - 1);
        entry.val = effects;
        self.func_effects.set(slot - 1, entry);
        return;
    }
    self.func_effects.push(StringVecStrTc_new(name, effects));
    HashMap_insert(self.func_effects_index, name, self.func_effects.len());
}

// Helper: get func_effects entry (returns empty Vec if not found)
fn TypeChecker_get_func_effects(self: &TypeChecker, name: str) -> Vec<str> {
    var slot: i64 = HashMap_get(self.func_effects_index, name);
    if slot != 0 {
        return self.func_effects.get(slot - 1).val;
    }
    return Vec::new();
}

/// L7G (`:effects` in fid repl): the effects inferred for function `name`
/// in the language's terms (reference §9.1: IO, Net, Spawn, Diverge,
/// Alloc, ...), read after TypeChecker_check_bodies. Empty when it has none
/// (unlike the IR's set, a stack local is no Alloc/Read/Write effect).
pub fn TypeChecker_effects_of(self: &TypeChecker, name: str) -> Vec<str> {
    return TypeChecker_get_func_effects(self, name);
}

/// L7G: whether the checker registered a function called `name`.
pub fn TypeChecker_knows_fn(self: &TypeChecker, name: str) -> bool {
    return TypeChecker_has_func(self, name);
}

// Indexed tables of item metadata: set once per item, read per use.
fn TypeChecker_set_item_module(self: &mut TypeChecker, key: str, val: str) {
    // First registration wins: the first module to define an item owns it.
    if HashMap_get(self.item_modules_index, key) != 0 {
        return;
    }
    self.item_modules.push(StringString_new(key, val));
    HashMap_insert(self.item_modules_index, key, self.item_modules.len());
}

fn TypeChecker_get_item_module(self: &TypeChecker, key: str) -> OptString {
    var slot: i64 = HashMap_get(self.item_modules_index, key);
    if slot != 0 {
        return OptString::Some(self.item_modules.get(slot - 1).val);
    }
    return OptString::None;
}

fn TypeChecker_set_struct_module(self: &mut TypeChecker, key: str, val: str) {
    // First registration wins: the first module to define an item owns it.
    if HashMap_get(self.struct_modules_index, key) != 0 {
        return;
    }
    self.struct_modules.push(StringString_new(key, val));
    HashMap_insert(self.struct_modules_index, key, self.struct_modules.len());
}

fn TypeChecker_get_struct_module(self: &TypeChecker, key: str) -> OptString {
    var slot: i64 = HashMap_get(self.struct_modules_index, key);
    if slot != 0 {
        return OptString::Some(self.struct_modules.get(slot - 1).val);
    }
    return OptString::None;
}

fn TypeChecker_set_item_visibility(self: &mut TypeChecker, key: str, val: bool) {
    // First registration wins: the first module to define an item decides.
    if HashMap_get(self.item_visibility_index, key) != 0 {
        return;
    }
    self.item_visibility.push(StringBool_new(key, val));
    HashMap_insert(self.item_visibility_index, key, self.item_visibility.len());
}

fn TypeChecker_get_item_visibility(self: &TypeChecker, key: str) -> bool {
    var slot: i64 = HashMap_get(self.item_visibility_index, key);
    if slot != 0 {
        return self.item_visibility.get(slot - 1).val;
    }
    return false;
}

/// Record a function's function-typed parameters (effect polymorphism) and
/// make them the current ones for the scan of its body.
fn TypeChecker_register_ho(self: &mut TypeChecker, fname: str, params: Vec<Param>) {
    var idx: Vec<i64> = Vec::new();
    var pnames: Vec<str> = Vec::new();
    var pi: i64 = 0;
    while pi < params.len() {
        match params.get(pi).ty {
            Type::Func(_, _) => {
                idx.push(pi);
                pnames.push(params.get(pi).name);
            }
            _ => {
            }
        }
        pi = pi + 1;
    }
    self.cur_ho_params = pnames;
    if idx.len() == 0 {
        return;
    }
    if HashMap_get(self.ho_fn_index, fname) == 0 {
        self.ho_fn_idx.push(idx);
        self.ho_fn_pnames.push(pnames);
        HashMap_insert(self.ho_fn_index, fname, self.ho_fn_idx.len());
    }
}

fn TypeChecker_ho_pnames(self: &TypeChecker, fname: str) -> Vec<str> {
    var at: i64 = HashMap_get(self.ho_fn_index, fname);
    if at == 0 {
        return Vec::new();
    }
    return self.ho_fn_pnames.get(at - 1);
}

/// The effects of a function value passed to a higher-order function: a named
/// function's, a closure's body's, nothing for the caller's own polymorphic
/// parameter (its call sites add them), and every effect for anything else.
fn TypeChecker_passed_fn_effects(self: &TypeChecker, arg: Expr, effects: &mut Vec<str>) {
    match arg {
        Expr::Ident(n) => {
            if tc_str_vec_contains(self.cur_ho_params, n) {
                return;
            }
            var slot: i64 = HashMap_get(self.func_effects_index, n);
            if slot != 0 {
                var fe: Vec<str> = self.func_effects.get(slot - 1).val;
                var i: i64 = 0;
                while i < fe.len() {
                    if !str_vec_contains_ref(effects, fe.get(i)) {
                        effects.push(fe.get(i));
                    }
                    i = i + 1;
                }
                return;
            }
        }
        Expr::Closure(_, cbody, _) => {
            TypeChecker_scan_stmts_for_effects(self, cbody, effects);
            return;
        }
        _ => {
        }
    }
    var all: Vec<str> = Vec::new();
    all.push("IO");
    all.push("Net");
    all.push("Spawn");
    all.push("Diverge");
    all.push("Alloc");
    all.push("Read");
    all.push("Write");
    all.push("Diff");
    all.push("Noise");
    all.push("Comm");
    var j: i64 = 0;
    while j < all.len() {
        if !str_vec_contains_ref(effects, all.get(j)) {
            effects.push(all.get(j));
        }
        j = j + 1;
    }
}

// Helper: set ho_param_effects entry (insert or update)
fn TypeChecker_set_ho_param_effects(self: &mut TypeChecker, name: str, effects: Vec<str>) {
    var i: i64 = 0;
    while i < self.ho_param_effects.len() {
        if self.ho_param_effects.get(i).key == name {
            var entry: StringVecStrTc = self.ho_param_effects.get(i);
            entry.val = effects;
            self.ho_param_effects.set(i, entry);
            return;
        }
        i = i + 1;
    }
    self.ho_param_effects.push(StringVecStrTc_new(name, effects));
    HashMap_insert(self.ho_param_effects_index, name, self.ho_param_effects.len());
}

// Helper: get ho_param_effects entry (returns empty Vec if not found)
fn TypeChecker_get_ho_param_effects(self: &TypeChecker, name: str) -> Vec<str> {
    var i: i64 = 0;
    while i < self.ho_param_effects.len() {
        if self.ho_param_effects.get(i).key == name {
            return self.ho_param_effects.get(i).val;
        }
        i = i + 1;
    }
    return Vec::new();
}

pub fn TypeChecker_compute_func_effects(self: &mut TypeChecker, program: Program) {
    // First pass: collect direct effects (print calls, allocations, etc.)
    // Store only names (not bodies) to avoid boxing Vec<Stmt> into a Vec.
    var names: Vec<str> = Vec::new();

    // Effect polymorphism: identify function-typed parameters.
    // When a function has a param of type Func(...), calling that param
    // may produce any effect. We conservatively register all effects.
    var all_effs: Vec<str> = Vec::new();
    all_effs.push("IO");
    all_effs.push("Net");
    all_effs.push("Spawn");
    all_effs.push("Diverge");
    all_effs.push("Alloc");
    all_effs.push("Read");
    all_effs.push("Write");
    all_effs.push("Diff");
    all_effs.push("Noise");
    all_effs.push("Comm");
    // 2g.65: method names of the program's impls (see tc_eff_method_allocs)
    tc_eff_collect_mnames(program);

    // BG58: the program's free functions by name; a method of the same bare
    // name must not take over the function's entry
    var free_names: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        HashMap_insert(free_names, func.name, 1);
        names.push(func.name);
        // Effect polymorphism: a call through a function-typed parameter adds
        // nothing here; each call site adds the effects of what it passes.
        TypeChecker_register_ho(self, func.name, func.params);
        var effects: Vec<str> = Vec::new();
        tc_eff_begin(func.params);
        TypeChecker_scan_stmts_for_effects(self, func.body, &mut effects);
        tc_eff_end();
        self.cur_ho_params = Vec::new();
        TypeChecker_set_func_effects(self, func.name, effects);
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            // BG58: `impl G { fn update(..) { println(..) } }` set the bare
            // name `update`, which is also the free function `update`'s
            // entry: the function took the method's IO and a @deterministic
            // caller of it was rejected. The method keeps its `G.update`
            // entry (below); the bare one is left to the function.
            if HashMap_contains(free_names, method.name) {
                mi = mi + 1;
                continue;
            }
            names.push(method.name);
            TypeChecker_register_ho(self, method.name, method.params);
            var effects: Vec<str> = Vec::new();
            tc_eff_begin(method.params);
            TypeChecker_scan_stmts_for_effects(self, method.body, &mut effects);
            tc_eff_end();
            self.cur_ho_params = Vec::new();
            TypeChecker_set_func_effects(self, method.name, effects);
            mi = mi + 1;
        }
        impi = impi + 1;
    }

    // Fixpoint iteration: propagate transitive effects through call graph
    // (if A calls B and B has IO, then A has IO too)
    // Look up bodies by name from program, matching the Rust compiler.
    var changed: bool = true;
    var body_idx: i64 = tc_body_index(program);
    while changed {
        changed = false;
        var ri2: i64 = 0;
        while ri2 < names.len() {
            var fname: str = names.get(ri2);
            // Find the body for this name
            var body_opt: OptStmtList = tc_find_body_indexed(program, body_idx, fname);
            match body_opt {
                OptStmtList::Some(body) => {
                    var new_effects: Vec<str> = Vec::new();
                    self.cur_ho_params = TypeChecker_ho_pnames(self, fname);
                    tc_eff_begin(tc_find_params_indexed(program, body_idx, fname));
                    TypeChecker_scan_stmts_for_effects(self, body, &mut new_effects);
                    tc_eff_end();
                    self.cur_ho_params = Vec::new();
                    // Check if new_effects has any effect not already in func_effects for this name
                    var existing: Vec<str> = TypeChecker_get_func_effects(self, fname);
                    var has_new: bool = false;
                    var ni: i64 = 0;
                    while ni < new_effects.len() {
                        if !tc_str_vec_contains(existing, new_effects.get(ni)) {
                            has_new = true;
                            ni = new_effects.len();
                        }
                        ni = ni + 1;
                    }
                    if has_new {
                        TypeChecker_set_func_effects(self, fname, new_effects);
                        changed = true;
                    }
                }
                OptStmtList::None => {
                }
            }
            ri2 = ri2 + 1;
        }
    }
    // Each method under `Type.method` too: the bare names above can be
    // shared by functions and other types' methods (sandbox looks a method
    // call up by its receiver's type).
    impi = 0;
    while impi < program.impls.len() {
        var imp2: ImplDef = program.impls.get(impi);
        var mi2: i64 = 0;
        while mi2 < imp2.methods.len() {
            var m2: Func = imp2.methods.get(mi2);
            var meffs: Vec<str> = Vec::new();
            self.cur_ho_params = TypeChecker_ho_pnames(self, m2.name);
            tc_eff_begin(m2.params);
            TypeChecker_scan_stmts_for_effects(self, m2.body, &mut meffs);
            tc_eff_end();
            self.cur_ho_params = Vec::new();
            TypeChecker_set_func_effects(self, imp2.struct_name + "." + m2.name, meffs);
            mi2 = mi2 + 1;
        }
        impi = impi + 1;
    }
    // BG22: a trait impl's methods under `Type.method` too (a call `x.m()`
    // on such a type is recorded under that name; they had no entry)
    var tii3: i64 = 0;
    while tii3 < program.trait_impls.len() {
        var ti3: TraitImpl = program.trait_impls.get(tii3);
        var tmi3: i64 = 0;
        while tmi3 < ti3.methods.len() {
            var tm3: Func = ti3.methods.get(tmi3);
            var tkey: str = ti3.type_name + "." + tm3.name;
            if HashMap_get(self.func_effects_index, tkey) == 0 {
                var teffs: Vec<str> = Vec::new();
                tc_eff_begin(tm3.params);
                TypeChecker_scan_stmts_for_effects(self, tm3.body, &mut teffs);
                tc_eff_end();
                TypeChecker_set_func_effects(self, tkey, teffs);
            }
            tmi3 = tmi3 + 1;
        }
        tii3 = tii3 + 1;
    }
    HashMap_drop(free_names);
    TypeChecker_compute_heap_alloc(self, program);
    TypeChecker_compute_ffi_reach(self, program);
}

/// Find the StmtList body for a function by name, searching funcs then impls.
/// Matches the Rust compiler's `program.funcs.iter().find()` + `program.impls` lookup.
/// name -> 1 + function index, or -(1 + impl * 65536 + method) for an impl
/// method; the first of a name wins, as TypeChecker_find_body's scan.
pub fn tc_body_index(program: Program) -> i64 {
    var idx: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        if !HashMap_contains(idx, program.funcs.get(fi).name) {
            HashMap_insert(idx, program.funcs.get(fi).name, fi + 1);
        }
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            if !HashMap_contains(idx, imp.methods.get(mi).name) {
                HashMap_insert(idx, imp.methods.get(mi).name, 0 - (1 + impi * 65536 + mi));
            }
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    return idx;
}

/// TypeChecker_find_body through an index from tc_body_index.
pub fn tc_find_body_indexed(program: Program, idx: i64, name: str) -> OptStmtList {
    if !HashMap_contains(idx, name) {
        return OptStmtList::None;
    }
    var at: i64 = HashMap_get(idx, name);
    if at > 0 {
        return OptStmtList::Some(program.funcs.get(at - 1).body);
    }
    var code: i64 = 0 - at - 1;
    var impi: i64 = code / 65536;
    var mi: i64 = code % 65536;
    return OptStmtList::Some(program.impls.get(impi).methods.get(mi).body);
}

/// The parameters of the body tc_find_body_indexed finds (2g.65).
pub fn tc_find_params_indexed(program: Program, idx: i64, name: str) -> Vec<Param> {
    if !HashMap_contains(idx, name) {
        return Vec::new();
    }
    var at: i64 = HashMap_get(idx, name);
    if at > 0 {
        return program.funcs.get(at - 1).params;
    }
    var code: i64 = 0 - at - 1;
    var impi: i64 = code / 65536;
    var mi: i64 = code % 65536;
    return program.impls.get(impi).methods.get(mi).params;
}

pub fn TypeChecker_find_body(self: &mut TypeChecker, program: Program, name: str) -> OptStmtList {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if func.name == name {
            return OptStmtList::Some(func.body);
        }
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            if method.name == name {
                return OptStmtList::Some(method.body);
            }
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    return OptStmtList::None;
}

pub fn TypeChecker_verify_declared_effects(self: &mut TypeChecker, program: Program) {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if !func.has_effect_annotation {
            fi = fi + 1;
            continue;
        }
        // Get inferred effects
        var inferred: Vec<str> = Vec::new();
        var fei: i64 = 0;
        while fei < self.func_effects.len() {
            if self.func_effects.get(fei).key == func.name {
                inferred = self.func_effects.get(fei).val;
                break;
            }
            fei = fei + 1;
        }
        if inferred.len() == 0 {
            fi = fi + 1;
            continue;
        }
        // Check that all inferred effects are declared
        var ii: i64 = 0;
        while ii < inferred.len() {
            var eff: str = inferred.get(ii);
            if !tc_str_vec_contains(func.declared_effects, eff) {
                self.errors.push("Effect error: function '" + func.name + "' has inferred effect '!" + eff + "' but only declared effects not including it");
            }
            ii = ii + 1;
        }
        fi = fi + 1;
    }
    // BG22: an impl method's declared effects too (its inferred ones are
    // kept under `Type.method`); only free functions were checked
    var mii: i64 = 0;
    while mii < program.impls.len() {
        var mimp: ImplDef = program.impls.get(mii);
        var mmi: i64 = 0;
        while mmi < mimp.methods.len() {
            var mf: Func = mimp.methods.get(mmi);
            if mf.has_effect_annotation {
                var mlabel: str = mimp.struct_name + "." + mf.name;
                var minf: Vec<str> = TypeChecker_get_func_effects(self, mlabel);
                var mk: i64 = 0;
                while mk < minf.len() {
                    if !tc_str_vec_contains(mf.declared_effects, minf.get(mk)) {
                        self.errors.push("Effect error: function '" + mlabel + "' has inferred effect '!" + minf.get(mk) + "' but only declared effects not including it");
                    }
                    mk = mk + 1;
                }
            }
            mmi = mmi + 1;
        }
        mii = mii + 1;
    }
}

pub fn TypeChecker_verify_deterministic(self: &mut TypeChecker, program: Program) {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_det: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "deterministic" {
                is_det = true;
            }
            ai = ai + 1;
        }
        if is_det {
            // Check for forbidden effects: IO, Net, Spawn, Diverge
            var inferred: Vec<str> = Vec::new();
            var fei: i64 = 0;
            while fei < self.func_effects.len() {
                if self.func_effects.get(fei).key == func.name {
                    inferred = self.func_effects.get(fei).val;
                    break;
                }
                fei = fei + 1;
            }
            var ei: i64 = 0;
            while ei < inferred.len() {
                var eff: str = inferred.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Determinism error: function '" + func.name + "' is @deterministic but has effect '!" + eff + "'." + "\n    @deterministic functions must be reproducible — same inputs → same outputs." + "\n    Effect '!" + eff + "' introduces nondeterminism (IO/Net depend on external state," + "\n    Spawn introduces concurrency, Diverge introduces control flow uncertainty)." + "\n    Fix: remove the @deterministic annotation, or remove the operation that\n    produces the '!" + eff + "' effect.");
                }
                ei = ei + 1;
            }
            // Check for floating-point operations: float literals, casts to
            // a float type, float-typed lets, parameters and return type
            var floats: Vec<str> = tc_conserve_floats(func);
            if floats.len() > 0 {
                self.errors.push("Determinism error: function '" + func.name + "' is @deterministic but uses floating-point." + "\n    Floating-point results vary across CPUs (different rounding, FMA contraction, etc.)." + "\n    Fix: use integer arithmetic (e.g., fixed-point with i64) instead of f32/f64,\n    or remove the @deterministic annotation.");
            }
        }
        fi = fi + 1;
    }
    // BG22: an impl method marked @deterministic, by its `Type.method`
    // effects; only free functions were checked
    var dii: i64 = 0;
    while dii < program.impls.len() {
        var dimp: ImplDef = program.impls.get(dii);
        var dmi: i64 = 0;
        while dmi < dimp.methods.len() {
            var dm: Func = dimp.methods.get(dmi);
            if tc_has_annotation(dm.annotations, "deterministic") {
                var dlabel: str = dimp.struct_name + "." + dm.name;
                var deffs: Vec<str> = TypeChecker_get_func_effects(self, dlabel);
                var dk: i64 = 0;
                while dk < deffs.len() {
                    var deff: str = deffs.get(dk);
                    if deff == "IO" || deff == "Net" || deff == "Spawn" || deff == "Diverge" {
                        self.errors.push("Determinism error: function '" + dlabel + "' is @deterministic but has effect '!" + deff + "'." + "\n    @deterministic functions must be reproducible — same inputs → same outputs." + "\n    Fix: remove the @deterministic annotation, or remove the operation that\n    produces the '!" + deff + "' effect.");
                    }
                    dk = dk + 1;
                }
                var dfloats: Vec<str> = tc_conserve_floats(dm);
                if dfloats.len() > 0 {
                    self.errors.push("Determinism error: function '" + dlabel + "' is @deterministic but uses floating-point." + "\n    Floating-point results vary across CPUs (different rounding, FMA contraction, etc.)." + "\n    Fix: use integer arithmetic (e.g., fixed-point with i64) instead of f32/f64,\n    or remove the @deterministic annotation.");
                }
            }
            dmi = dmi + 1;
        }
        dii = dii + 1;
    }
}

// --- Verification stubs (permissive -- don't reject code) ------------------
// These are placeholder implementations for advanced annotation verification.
// They are no-ops, ensuring the self-hosted compiler can compile code that
// uses these annotations without false rejections.

pub fn TypeChecker_verify_conserve(self: &mut TypeChecker, program: Program) {
    // @conserve: money conservation (src/typechecker.rs verify_conserve).
    // A @conserve function has no IO/Net/Spawn/Diverge effect, no floats,
    // calls only @conserve functions and never a mint function.
    var conserve_funcs: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var f: Func = program.funcs.get(fi);
        if tc_has_conserve(f) {
            conserve_funcs.push(f.name);
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            if tc_has_conserve(m) {
                conserve_funcs.push(imp.struct_name + "::" + m.name);
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(ti);
        var mi: i64 = 0;
        while mi < timp.methods.len() {
            var m: Func = timp.methods.get(mi);
            if tc_has_conserve(m) {
                conserve_funcs.push(timp.trait_name + "::" + m.name);
            }
            mi = mi + 1;
        }
        ti = ti + 1;
    }

    fi = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if tc_has_conserve(func) {
            // 1. Effects
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Conservation error: function '" + func.name + "' is @conserve but has effect '!" + eff + "'.\n    @conserve functions must not interact with external state —\n    IO/Net can bring in external money, Spawn introduces concurrency,\n    Diverge introduces control flow uncertainty.\n    Fix: remove the @conserve annotation, or remove the '!" + eff + "' effect.");
                }
                ei = ei + 1;
            }
            // 2. No floating-point
            var fp: Vec<str> = tc_conserve_floats(func);
            if fp.len() > 0 {
                self.errors.push("Conservation error: function '" + func.name + "' is @conserve but uses floating-point.\n    Floating-point arithmetic is not exact — money could be lost\n    to rounding errors, violating conservation.\n    Found float in: " + tc_join(fp, ", ") + ".\n    Fix: use integer arithmetic (fixed-point with i64) instead.");
            }
            // 3. Every called function is @conserve
            var called: Vec<str> = tc_conserve_calls(func);
            var ci: i64 = 0;
            while ci < called.len() {
                var c: str = called.get(ci);
                if !tc_vec_contains_str(conserve_funcs, c) && TypeChecker_has_func(self, c) && !tc_is_mint_call(c) {
                    self.errors.push("Conservation error: function '" + func.name + "' is @conserve but calls '" + c + "',\n    which is not @conserve.\n    A @conserve function can only call other @conserve functions —\n    otherwise the callee could create or destroy money.\n    Fix: add @conserve to '" + c + "', or remove the call from '" + func.name + "'.");
                }
                ci = ci + 1;
            }
            // 4. No mint function
            ci = 0;
            while ci < called.len() {
                var c: str = called.get(ci);
                if tc_is_mint_call(c) {
                    self.errors.push("Conservation error: function '" + func.name + "' is @conserve but calls '" + c + "',\n    which creates new Money. @conserve functions cannot mint money —\n    they can only move, split, and merge existing Money.\n    Fix: remove the @conserve annotation, or remove the mint call.");
                }
                ci = ci + 1;
            }
            // 5. No `Money { .. }` literal (outside stdlib/money.fd)
            if tc_conserve_money_lits(func) > 0 && !TypeChecker_in_money_module(self, func.name) {
                self.errors.push("Conservation error: function '" + func.name + "' is @conserve but builds a 'Money { .. }' literal,\n    which creates new Money from a number. @conserve functions cannot mint money —\n    they can only move and merge (Money_add) existing Money.\n    Fix: remove the @conserve annotation, or use the money module's operations.");
            }
        }
        fi = fi + 1;
    }

    ii = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            if tc_has_conserve(method) {
                var qname: str = imp.struct_name + "::" + method.name;
                // TL2: a method's effects are recorded under its bare name
                // (TypeChecker_compute_func_effects); under "S::m" none was
                // found, so a @conserve method's print went unreported
                var effects: Vec<str> = TypeChecker_get_func_effects(self, method.name);
                var ei: i64 = 0;
                while ei < effects.len() {
                    var eff: str = effects.get(ei);
                    if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                        self.errors.push("Conservation error: method '" + qname + "' is @conserve but has effect '!" + eff + "'.");
                    }
                    ei = ei + 1;
                }
                var fp: Vec<str> = tc_conserve_floats(method);
                if fp.len() > 0 {
                    self.errors.push("Conservation error: method '" + qname + "' is @conserve but uses floating-point. Found: " + tc_join(fp, ", ") + ".");
                }
                var called: Vec<str> = tc_conserve_calls(method);
                var ci: i64 = 0;
                while ci < called.len() {
                    var c: str = called.get(ci);
                    if tc_is_mint_call(c) {
                        self.errors.push("Conservation error: method '" + qname + "' is @conserve but calls mint function '" + c + "'.");
                    } else if TypeChecker_has_func(self, c) && !tc_vec_contains_str(conserve_funcs, c) {
                        self.errors.push("Conservation error: method '" + qname + "' is @conserve but calls '" + c + "', which is not @conserve.");
                    }
                    ci = ci + 1;
                }
                if tc_conserve_money_lits(method) > 0 {
                    self.errors.push("Conservation error: method '" + qname + "' is @conserve but builds a 'Money { .. }' literal, which mints money.");
                }
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
}

fn tc_join(v: Vec<str>, sep: str) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 {
            out = out + sep;
        }
        out = out + v.get(i);
        i = i + 1;
    }
    return out;
}

fn tc_has_conserve(f: Func) -> bool {
    var ai: i64 = 0;
    while ai < f.annotations.len() {
        if f.annotations.get(ai).name == "conserve" {
            return true;
        }
        ai = ai + 1;
    }
    return false;
}

fn TypeChecker_has_func(self: &TypeChecker, name: str) -> bool {
    match TypeChecker_lookup_func_cache(self, name) {
        OptFuncSig::Some(_) => {
            return true;
        }
        OptFuncSig::None => {
            return false;
        }
    }
    return false;
}

// The functions a @conserve body calls, each once, minus runtime builtins
// (p_*) and printing.
fn tc_conserve_calls(f: Func) -> Vec<str> {
    var raw: Vec<str> = Vec::new();
    scan_stmts_for_calls(f.body, &mut raw);
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < raw.len() {
        var c: str = raw.get(i);
        var skip: bool = str_starts_with(c, "p_") || c == "print" || c == "println" || c == "print_str" || c == "print_nl" || c == "print_int" || c == "print_map" || c == "print_vec";
        if !skip && !tc_vec_contains_str(out, c) {
            out.push(c);
        }
        i = i + 1;
    }
    return out;
}

fn tc_is_mint_call(c: str) -> bool {
    if c == "Money::new" || c == "Money::from_cents" || c == "Money::from_dollars" {
        return true;
    }
    if c == "Money_new" || c == "Money_from_cents" || c == "Money_from_dollars" {
        return true;
    }
    return str_ends_with(c, "::Money::new") || str_ends_with(c, "::Money::from_cents") || str_ends_with(c, "::Money::from_dollars") || str_ends_with(c, "::Money_new") || str_ends_with(c, "::Money_from_cents") || str_ends_with(c, "::Money_from_dollars");
}

/// `Money { .. }` literals in a @conserve function: each makes Money from
/// a number, i.e. mints it. Only stdlib/money.fd's own operations (add,
/// sub), which build their result from their inputs, may.
fn tc_conserve_money_lits(f: Func) -> i64 {
    var raw: Vec<str> = Vec::new();
    g_scan_struct_lits = true;
    scan_stmts_for_calls(f.body, &mut raw);
    g_scan_struct_lits = false;
    var n: i64 = 0;
    var i: i64 = 0;
    while i < raw.len() {
        var c: str = raw.get(i);
        if c == "{Money" || (str_starts_with(c, "{") && str_ends_with(c, "::Money")) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// The function is one of stdlib/money.fd's own (module money).
fn TypeChecker_in_money_module(self: &TypeChecker, name: str) -> bool {
    match TypeChecker_get_item_module(self, name) {
        OptString::Some(m) => {
            return m == "money";
        }
        OptString::None => {
        }
    }
    return false;
}

// Where a @conserve function uses floating point: its body, parameters
// and return type.
fn tc_conserve_floats(f: Func) -> Vec<str> {
    var found: Vec<str> = scan_for_floats(f.body);
    var pi: i64 = 0;
    while pi < f.params.len() {
        var p: Param = f.params.get(pi);
        if tc_type_contains_float(p.ty) {
            found.push("parameter '" + p.name + ": " + type_to_str(p.ty) + "'");
        }
        pi = pi + 1;
    }
    if tc_type_contains_float(f.ret_ty) {
        found.push("return type '" + type_to_str(f.ret_ty) + "'");
    }
    return found;
}

fn tc_type_contains_float(ty: Type) -> bool {
    match ty {
        Type::F32 => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        Type::Generic(_, args) => {
            return tc_types_contain_float(args);
        }
        Type::Tuple(types) => {
            return tc_types_contain_float(types);
        }
        Type::Func(params, ret) => {
            return tc_types_contain_float(params) || tc_type_contains_float(box_type_unbox(ret));
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn tc_types_contain_float(types: Vec<Type>) -> bool {
    var i: i64 = 0;
    while i < types.len() {
        if tc_type_contains_float(types.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn TypeChecker_verify_gas(self: &mut TypeChecker, program: Program) {
    // @gas(N): the function's cost (AST node count of its body) plus the
    // cost of everything it calls must not exceed N (src/typechecker.rs
    // verify_gas). Impl methods are named Type_method.
    var names: Vec<str> = Vec::new();
    var bodies: Vec<StmtList> = Vec::new();
    var limit_names: Vec<str> = Vec::new();
    var limits: Vec<i64> = Vec::new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        gas_collect(func, func.name, &mut names, &mut bodies, &mut limit_names, &mut limits);
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            gas_collect(imp.methods.get(mi), imp.struct_name + "_" + imp.methods.get(mi).name, &mut names, &mut bodies, &mut limit_names, &mut limits);
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(ti);
        var tmi: i64 = 0;
        while tmi < timp.methods.len() {
            gas_collect(timp.methods.get(tmi), timp.type_name + "_" + timp.methods.get(tmi).name, &mut names, &mut bodies, &mut limit_names, &mut limits);
            tmi = tmi + 1;
        }
        ti = ti + 1;
    }
    var cache_names: Vec<str> = Vec::new();
    var cache_vals: Vec<i64> = Vec::new();
    var li: i64 = 0;
    while li < limit_names.len() {
        var lname: str = limit_names.get(li);
        var visited: Vec<str> = Vec::new();
        var total: i64 = gas_total(lname, names, bodies, &mut visited, &mut cache_names, &mut cache_vals);
        if total > limits.get(li) {
            var own: i64 = gas_own(lname, names, bodies);
            self.errors.push("Gas error: function '" + lname + "' has @gas(" + int_to_str(limits.get(li)) + ") but total gas cost is " + int_to_str(total) + " (own: " + int_to_str(own) + " + callees: " + int_to_str(total - own) + ").");
        }
        li = li + 1;
    }
}

fn gas_collect(func: Func, name: str, names: &mut Vec<str>, bodies: &mut Vec<StmtList>, limit_names: &mut Vec<str>, limits: &mut Vec<i64>) {
    names.push(name);
    bodies.push(func.body);
    var ai: i64 = 0;
    while ai < func.annotations.len() {
        var ann: Annotation = func.annotations.get(ai);
        if ann.name == "gas" && ann.args.len() > 0 {
            var lim: i64 = str_parse_int(ann.args.get(0));
            if lim >= 0 && ann.args.get(0) != "" {
                limit_names.push(name);
                limits.push(lim);
            }
        }
        ai = ai + 1;
    }
}

fn gas_index(name: str, names: Vec<str>) -> i64 {
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn gas_own(name: str, names: Vec<str>, bodies: Vec<StmtList>) -> i64 {
    var idx: i64 = gas_index(name, names);
    if idx < 0 {
        return 0;
    }
    return gas_cost_stmts(bodies.get(idx));
}

/// Own cost plus the (memoized) totals of the distinct callees; a callee
/// already on the current path counts only its own cost (cycles).
fn gas_total(name: str, names: Vec<str>, bodies: Vec<StmtList>, visited: &mut Vec<str>, cache_names: &mut Vec<str>, cache_vals: &mut Vec<i64>) -> i64 {
    var ci: i64 = gas_index(name, cache_names);
    if ci >= 0 {
        return cache_vals.get(ci);
    }
    if gas_index(name, visited) >= 0 {
        return gas_own(name, names, bodies);
    }
    visited.push(name);
    var own: i64 = gas_own(name, names, bodies);
    var callee_total: i64 = 0;
    var idx: i64 = gas_index(name, names);
    if idx >= 0 {
        var calls: Vec<str> = Vec::new();
        scan_stmts_for_calls(bodies.get(idx), &mut calls);
        var seen: Vec<str> = Vec::new();
        var k: i64 = 0;
        while k < calls.len() {
            var c: str = calls.get(k);
            if gas_index(c, seen) < 0 {
                seen.push(c);
                callee_total = callee_total + gas_total(c, names, bodies, visited, cache_names, cache_vals);
            }
            k = k + 1;
        }
    }
    var total: i64 = own + callee_total;
    cache_names.push(name);
    cache_vals.push(total);
    return total;
}

fn gas_cost_stmts(stmts: Vec<Stmt>) -> i64 {
    var c: i64 = 0;
    var i: i64 = 0;
    while i < stmts.len() {
        c = c + gas_cost_stmt(stmts.get(i));
        i = i + 1;
    }
    return c;
}

fn gas_cost_opt_stmts(o: OptStmts) -> i64 {
    match o {
        OptStmts::Some(b) => {
            return gas_cost_stmts(b);
        }
        OptStmts::None => {
        }
    }
    return 0;
}

fn gas_cost_arms(arms: Vec<MatchArm>) -> i64 {
    var c: i64 = 0;
    var i: i64 = 0;
    while i < arms.len() {
        c = c + gas_cost_stmts(arms.get(i).body);
        i = i + 1;
    }
    return c;
}

fn gas_cost_exprs(es: Vec<Expr>) -> i64 {
    var c: i64 = 0;
    var i: i64 = 0;
    while i < es.len() {
        c = c + gas_cost_expr(es.get(i));
        i = i + 1;
    }
    return c;
}

fn gas_cost_stmt(stmt: Stmt) -> i64 {
    var cost: i64 = 1;
    match stmt {
        Stmt::Let(_, _, e, _, _, _, _) => {
            cost = cost + gas_cost_expr(e);
        }
        Stmt::LetTuple(_, e, _) => {
            cost = cost + gas_cost_expr(e);
        }
        Stmt::Expr(e, _) => {
            cost = cost + gas_cost_expr(e);
        }
        Stmt::Assign(_, _, e, _) => {
            cost = cost + gas_cost_expr(e);
        }
        Stmt::IndexAssign(_, idx, _, e, _) => {
            cost = cost + gas_cost_expr(idx) + gas_cost_expr(e);
        }
        Stmt::DerefAssign(pe, _, e, _) => {
            cost = cost + gas_cost_expr(pe) + gas_cost_expr(e);
        }
        Stmt::FieldAssign(obj, _, _, e, _) => {
            cost = cost + gas_cost_expr(obj) + gas_cost_expr(e);
        }
        Stmt::Return(oe, _) => {
            match oe {
                OptBoxExpr::Some(re) => {
                    cost = cost + gas_cost_expr(box_expr_unbox(re));
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(c, tb, eb, _) => {
            cost = cost + gas_cost_expr(c) + gas_cost_stmts(tb) + gas_cost_opt_stmts(eb);
        }
        Stmt::While(c, b, _) => {
            cost = cost + gas_trips_while(c) * (gas_cost_expr(c) + gas_cost_stmts(b));
        }
        Stmt::Loop(b, _) => {
            cost = cost + gas_cost_stmts(b);
        }
        Stmt::For(_, it, b, _) => {
            cost = cost + gas_cost_expr(it) + gas_trips_for(it) * gas_cost_stmts(b);
        }
        Stmt::Defer(b, _) => {
            cost = cost + gas_cost_stmts(b);
        }
        Stmt::Match(e, arms, _) => {
            cost = cost + gas_cost_expr(e) + gas_cost_arms(arms);
        }
        Stmt::RegionBlock(_, _, _, _, _, b, _) => {
            cost = cost + gas_cost_stmts(b);
        }
        Stmt::Sandbox(b, _) => {
            cost = cost + gas_cost_stmts(b);
        }
        Stmt::Unsafe(b, _) => {
            cost = cost + gas_cost_stmts(b);
        }
        Stmt::Txn(b, _) => {
            cost = cost + gas_cost_stmts(b);
        }
        Stmt::GradBlock(_, b, _) => {
            cost = cost + gas_cost_stmts(b);
        }
        Stmt::ComptimeGen(b, _) => {
            cost = cost + gas_cost_stmts(b);
        }
        _ => {
        }
    }
    return cost;
}

/// Trip count of `for x in a..b` with literal bounds (release L1: a loop
/// counted its body once whatever its bounds). Other loops count one trip;
/// the runtime gas meter (IrFunction.gas_limit) bounds them.
fn gas_trips_for(it: Expr) -> i64 {
    match it {
        Expr::Range(st, en, inclusive) => {
            match box_expr_unbox(st) {
                Expr::IntLit(a) => {
                    match box_expr_unbox(en) {
                        Expr::IntLit(b) => {
                            var n: i64 = b - a;
                            if inclusive {
                                n = n + 1;
                            }
                            if n < 1 {
                                return 1;
                            }
                            return n;
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return 1;
}

/// Trip count of `while i < N` / `while i <= N` with a literal bound.
fn gas_trips_while(c: Expr) -> i64 {
    match c {
        Expr::Binary(op, _, r) => {
            match box_expr_unbox(r) {
                Expr::IntLit(n) => {
                    if binop_eq(op, BinOp::Lt) && n > 0 {
                        return n;
                    }
                    if binop_eq(op, BinOp::LtEq) && n >= 0 {
                        return n + 1;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return 1;
}

fn gas_cost_expr(expr: Expr) -> i64 {
    var cost: i64 = 1;
    match expr {
        Expr::Binary(_, l, r) => {
            cost = cost + gas_cost_expr(box_expr_unbox(l)) + gas_cost_expr(box_expr_unbox(r));
        }
        Expr::Unary(_, e) => {
            cost = cost + gas_cost_expr(box_expr_unbox(e));
        }
        Expr::Call(_, args) => {
            cost = cost + gas_cost_exprs(args);
        }
        Expr::MethodCall(recv, _, args) => {
            cost = cost + gas_cost_expr(box_expr_unbox(recv)) + gas_cost_exprs(args);
        }
        Expr::FieldAccess(e, _) => {
            cost = cost + gas_cost_expr(box_expr_unbox(e));
        }
        Expr::Index(_, idx) => {
            cost = cost + gas_cost_expr(box_expr_unbox(idx));
        }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                cost = cost + gas_cost_expr(fields.get(fi).value);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(sp) => {
                    cost = cost + gas_cost_expr(box_expr_unbox(sp));
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::ArrayLit(_, elements) => {
            cost = cost + gas_cost_exprs(elements);
        }
        Expr::TupleLit(elems) => {
            cost = cost + gas_cost_exprs(elems);
        }
        Expr::Ref(e, _) => {
            cost = cost + gas_cost_expr(box_expr_unbox(e));
        }
        Expr::Deref(e) => {
            cost = cost + gas_cost_expr(box_expr_unbox(e));
        }
        Expr::Cast(e, _) => {
            cost = cost + gas_cost_expr(box_expr_unbox(e));
        }
        Expr::If(c, tb, eb) => {
            cost = cost + gas_cost_expr(box_expr_unbox(c)) + gas_cost_stmts(tb) + gas_cost_opt_stmts(eb);
        }
        Expr::Block(b) => {
            cost = cost + gas_cost_stmts(b);
        }
        Expr::Match(e, arms) => {
            cost = cost + gas_cost_expr(box_expr_unbox(e)) + gas_cost_arms(arms);
        }
        Expr::Coalesce(e, d) => {
            cost = cost + gas_cost_expr(box_expr_unbox(e)) + gas_cost_expr(box_expr_unbox(d));
        }
        Expr::Try(e) => {
            cost = cost + gas_cost_expr(box_expr_unbox(e));
        }
        Expr::StrConcat(l, r) => {
            cost = cost + gas_cost_expr(box_expr_unbox(l)) + gas_cost_expr(box_expr_unbox(r));
        }
        Expr::Range(st, en, _) => {
            cost = cost + gas_cost_expr(box_expr_unbox(st)) + gas_cost_expr(box_expr_unbox(en));
        }
        _ => {
        }
    }
    return cost;
}

pub fn TypeChecker_verify_safety_annotations(self: &mut TypeChecker, program: Program) {
    // Domain presets: annotation name → list of primitives
    // @no-panic is internal-only — users write @crashfree instead.
    // @crashfree = no-panic + no-unbounded
    // @medical = no-alloc + no-recursion + no-unbounded + no-panic + requires-audit
    // @safety-critical = no-alloc + no-recursion + no-unbounded + no-panic + no-indirect
    // @autosar = no-alloc + no-recursion + no-unbounded + no-panic

    // Build func_name → list of active primitives
    var func_names: Vec<str> = Vec::new();
    var func_prim_lists: Vec<StrStack> = Vec::new();
    var func_bodies: Vec<StmtList> = Vec::new();
    var func_anns: Vec<AnnList> = Vec::new();
    var func_fn_params: Vec<StrStack> = Vec::new();
    // Methods of user types (core's Option/Result methods count as builtin)
    var method_names: Vec<str> = Vec::new();

    // Collect from top-level functions
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var prims: Vec<str> = expand_safety_primitives(func.annotations);
        func_names.push(func.name);
        func_prim_lists.push(prims);
        func_bodies.push(func.body);
        func_anns.push(func.annotations);
        func_fn_params.push(safety_fn_params(func.params));
        fi = fi + 1;
    }
    // Collect from impl methods (qualified as StructName_method)
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var method: Func = imp.methods.get(mi);
            var prims: Vec<str> = expand_safety_primitives(method.annotations);
            var qname: str = imp.struct_name + "_" + method.name;
            if imp.struct_name != "Option" && imp.struct_name != "Result" {
                method_names.push(qname);
            }
            func_names.push(qname);
            func_prim_lists.push(prims);
            func_bodies.push(method.body);
            func_anns.push(method.annotations);
            func_fn_params.push(safety_fn_params(method.params));
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    // Collect from trait impl methods
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timpl: TraitImpl = program.trait_impls.get(ti);
        var mi: i64 = 0;
        while mi < timpl.methods.len() {
            var method: Func = timpl.methods.get(mi);
            var prims: Vec<str> = expand_safety_primitives(method.annotations);
            var qname: str = timpl.type_name + "_" + method.name;
            method_names.push(qname);
            func_names.push(qname);
            func_prim_lists.push(prims);
            func_bodies.push(method.body);
            func_anns.push(method.annotations);
            func_fn_params.push(safety_fn_params(method.params));
            mi = mi + 1;
        }
        ti = ti + 1;
    }

    // Check each function
    var ci: i64 = 0;
    while ci < func_names.len() {
        var prims: Vec<str> = func_prim_lists.get(ci);
        if prims.len() > 0 {
            var fname: str = func_names.get(ci);
            var body: Vec<Stmt> = func_bodies.get(ci);
            var anns: Vec<Annotation> = func_anns.get(ci);
            var errs: Vec<str> = check_safety_body(fname, body, prims, anns, func_names, func_prim_lists, func_fn_params.get(ci), method_names);
            var ei: i64 = 0;
            while ei < errs.len() {
                self.errors.push(errs.get(ei));
                ei = ei + 1;
            }
        }
        ci = ci + 1;
    }

    // Post-pass: indirect recursion detection for @no-recursion functions.
    // The direct self-call check in check_safety_body only catches A → A.
    // This catches A → B → A (and longer cycles) using a call graph.
    // Build call graph: func_name → Vec of called names.
    var cg_names: Vec<str> = Vec::new();
    var cg_calls: Vec<str> = Vec::new();
    // flat: all calls, indexed by cg_offsets
    var cg_offsets: Vec<i64> = Vec::new();
    // cg_offsets[i] = start index in cg_calls for cg_names[i]
    var cgi: i64 = 0;
    while cgi < func_names.len() {
        var body: Vec<Stmt> = func_bodies.get(cgi);
        var calls: Vec<str> = Vec::new();
        scan_stmts_for_calls(body, &mut calls);
        cg_names.push(func_names.get(cgi));
        cg_offsets.push(cg_calls.len());
        var cli: i64 = 0;
        while cli < calls.len() {
            cg_calls.push(calls.get(cli));
            cli = cli + 1;
        }
        cgi = cgi + 1;
    }
    // Check each @no-recursion function for cycle membership.
    var nri: i64 = 0;
    while nri < func_names.len() {
        var prims: Vec<str> = func_prim_lists.get(nri);
        if tc_vec_contains_str(prims, "no-recursion") {
            var target: str = func_names.get(nri);
            if is_in_call_cycle_fd(target, cg_names, cg_calls, cg_offsets) {
                self.errors.push("Safety error (no-recursion): function '" + target + "' is @no-recursion but is part of\n    an indirect recursion cycle (A → B → ... → A).\n    Indirect recursion has the same unbounded stack depth risk as direct\n    recursion — it just hides the cycle across multiple functions.\n    Fix: break the cycle by making one function in the loop iterative,\n    or remove the @no-recursion annotation.");
            }
        }
        nri = nri + 1;
    }
    // @bounded-stack: no recursion and no call to an unknown target in
    // anything the function can reach, so its stack depth has a bound.
    var leaves: Vec<str> = Vec::new();
    var lei: i64 = 0;
    while lei < program.extern_decls.len() {
        leaves.push(program.extern_decls.get(lei).pledge_name);
        lei = lei + 1;
    }
    var bsi: i64 = 0;
    while bsi < func_names.len() {
        if tc_vec_contains_str(func_prim_lists.get(bsi), "bounded-stack") {
            var why: str = bounded_stack_violation_fd(func_names.get(bsi), cg_names, cg_calls, cg_offsets, leaves);
            if str_len(why) > 0 {
                self.errors.push("Safety error (bounded-stack): function '" + func_names.get(bsi) + "' is @bounded-stack but " + why + ".\n    Its stack depth has no bound: every function it can reach must be\n    non-recursive and called directly.");
            } else {
                // @bounded-stack(N): the acyclicity check above proved the
                // reachable call graph is a DAG — now measure the longest
                // call chain (in stack frames) against the declared budget.
                var bound: i64 = -1;
                var fas: Vec<Annotation> = func_anns.get(bsi);
                var fai: i64 = 0;
                while fai < fas.len() {
                    var fa: Annotation = fas.get(fai);
                    if fa.name == "bounded-stack" && fa.args.len() > 0 {
                        bound = str_parse_int(fa.args.get(0));
                    }
                    fai = fai + 1;
                }
                if bound >= 0 {
                    var index2: i64 = HashMap_new();
                    var ii2: i64 = 0;
                    while ii2 < cg_names.len() {
                        HashMap_insert(index2, cg_names.get(ii2), ii2 + 1);
                        ii2 = ii2 + 1;
                    }
                    var root_i: i64 = HashMap_get(index2, func_names.get(bsi)) - 1;
                    var memo_names: Vec<str> = Vec::new();
                    var memo_vals: Vec<i64> = Vec::new();
                    var depth: i64 = bs_depth(root_i, cg_names, cg_calls, cg_offsets, index2, leaves, &mut memo_names, &mut memo_vals);
                    if depth > bound {
                        self.errors.push("Safety error (bounded-stack): function '" + func_names.get(bsi) + "' is @bounded-stack(" + int_to_str(bound) + ") but its deepest static call chain is " + int_to_str(depth) + " frames — it exceeds the declared\n    frame budget. Reduce call depth or raise the bound.");
                    }
                }
            }
        }
        bsi = bsi + 1;
    }
}

/// Longest static call-chain depth from `node`, in stack frames (the node
/// itself counts as 1). Only called on graphs that passed
/// bounded_stack_violation_fd — i.e. proven acyclic — so a memoized DFS is
/// safe. Mirrors src/typechecker.rs::safety_call_depth.
fn bs_depth(node: i64, cg_names: Vec<str>, cg_calls: Vec<str>, cg_offsets: Vec<i64>, index: i64, leaves: Vec<str>, memo_names: &mut Vec<str>, memo_vals: &mut Vec<i64>) -> i64 {
    var name: str = cg_names.get(node);
    var mi: i64 = 0;
    while mi < memo_names.len() {
        if memo_names.get(mi) == name {
            return memo_vals.get(mi);
        }
        mi = mi + 1;
    }
    var err: Vec<str> = Vec::new();
    var edges: Vec<i64> = bs_edges(node, cg_names, cg_calls, cg_offsets, index, leaves, &mut err);
    var best: i64 = 0;
    var i: i64 = 0;
    while i < edges.len() {
        var d: i64 = bs_depth(edges.get(i), cg_names, cg_calls, cg_offsets, index, leaves, memo_names, memo_vals);
        if d > best {
            best = d;
        }
        i = i + 1;
    }
    memo_names.push(name);
    memo_vals.push(best + 1);
    return best + 1;
}

/// The functions a call to `name` from `node` can reach (a method call,
/// recorded by its bare name, reaches every method of that name), as indexes.
/// An indirect call or an unknown target goes into `err`.
fn bs_edges(node: i64, cg_names: Vec<str>, cg_calls: Vec<str>, cg_offsets: Vec<i64>, index: i64, leaves: Vec<str>, err: &mut Vec<str>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var end: i64 = cg_calls.len();
    if node + 1 < cg_offsets.len() {
        end = cg_offsets.get(node + 1);
    }
    var ci: i64 = cg_offsets.get(node);
    while ci < end {
        var c: str = cg_calls.get(ci);
        var j: i64 = HashMap_get(index, c);
        if j != 0 {
            out.push(j - 1);
        } else if c == "p_make_dyn" || c == "p_call_ptr" || c == "p_dyn_call" {
            err.push("makes an indirect call ('" + c + "')");
            return out;
        } else if !(str_starts_with(c, "p_") || tc_vec_contains_str(leaves, c) || c == "print" || c == "println" || c == "print_str" || c == "print_nl" || c == "print_int") {
            var suffix: str = "_" + c;
            var found: bool = false;
            var k: i64 = 0;
            while k < cg_names.len() {
                if str_ends_with(cg_names.get(k), suffix) {
                    out.push(k);
                    found = true;
                }
                k = k + 1;
            }
            if !found {
                err.push("calls '" + c + "', whose target is not a known function");
                return out;
            }
        }
        ci = ci + 1;
    }
    return out;
}

/// As src/typechecker.rs bounded_stack_violation: why the stack depth of
/// `root` has no bound (a cycle it can reach, or a call with no known
/// target), or "" when it has one.
fn bounded_stack_violation_fd(root: str, cg_names: Vec<str>, cg_calls: Vec<str>, cg_offsets: Vec<i64>, leaves: Vec<str>) -> str {
    var index: i64 = HashMap_new();
    var state: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < cg_names.len() {
        HashMap_insert(index, cg_names.get(i), i + 1);
        state.push(0);
        i = i + 1;
    }
    var root_i: i64 = HashMap_get(index, root) - 1;
    if root_i < 0 {
        return "";
    }
    var err: Vec<str> = Vec::new();
    var path_node: Vec<i64> = Vec::new();
    var path_edges: Vec<Vec<i64>> = Vec::new();
    var path_pos: Vec<i64> = Vec::new();
    var first: Vec<i64> = bs_edges(root_i, cg_names, cg_calls, cg_offsets, index, leaves, &mut err);
    if err.len() > 0 {
        return err.get(0) + " (in '" + root + "')";
    }
    // Depth first: a function on the current path, reached again, is a cycle
    state.set(root_i, 1);
    path_node.push(root_i);
    path_edges.push(first);
    path_pos.push(0);
    while path_node.len() > 0 {
        var top: i64 = path_node.len() - 1;
        var es: Vec<i64> = path_edges.get(top);
        var pos: i64 = path_pos.get(top);
        if pos < es.len() {
            path_pos.set(top, pos + 1);
            var nx: i64 = es.get(pos);
            if state.get(nx) == 1 {
                return "can recurse through '" + cg_names.get(nx) + "'";
            }
            if state.get(nx) == 0 {
                var next_edges: Vec<i64> = bs_edges(nx, cg_names, cg_calls, cg_offsets, index, leaves, &mut err);
                if err.len() > 0 {
                    return err.get(0) + " (in '" + cg_names.get(nx) + "')";
                }
                state.set(nx, 1);
                path_node.push(nx);
                path_edges.push(next_edges);
                path_pos.push(0);
            }
        } else {
            state.set(path_node.get(top), 2);
            path_node.pop();
            path_edges.pop();
            path_pos.pop();
        }
    }
    return "";
}

// Detect if `target` is reachable from itself via a non-trivial path in the
// call graph (i.e., participates in a cycle). Catches indirect recursion.
// cg_names/cg_calls/cg_offsets encode the call graph as a CSR structure.
fn is_in_call_cycle_fd(target: str, cg_names: Vec<str>, cg_calls: Vec<str>, cg_offsets: Vec<i64>) -> bool {
    // Find target's index and its callees.
    var target_idx: i64 = -1;
    var ni: i64 = 0;
    while ni < cg_names.len() {
        if cg_names.get(ni) == target {
            target_idx = ni;
        }
        ni = ni + 1;
    }
    if target_idx < 0 {
        return false;
    }
    var start: i64 = cg_offsets.get(target_idx);
    var end: i64 = 0;
    if target_idx + 1 < cg_offsets.len() {
        end = cg_offsets.get(target_idx + 1);
    } else {
        end = cg_calls.len();
    }
    // For each callee (not target itself), DFS to see if we reach target.
    var ci: i64 = start;
    while ci < end {
        var callee: str = cg_calls.get(ci);
        if callee != target {
            // DFS from callee to target
            var visited: Vec<str> = Vec::new();
            if dfs_reaches_fd(callee, target, cg_names, cg_calls, cg_offsets, &mut visited) {
                return true;
            }
        }
        ci = ci + 1;
    }
    return false;
}

fn dfs_reaches_fd(node: str, target: str, cg_names: Vec<str>, cg_calls: Vec<str>, cg_offsets: Vec<i64>, visited: &mut Vec<str>) -> bool {
    if node == target {
        return true;
    }
    // Check visited
    var vi: i64 = 0;
    while vi < visited.len() {
        if visited.get(vi) == node {
            return false;
        }
        vi = vi + 1;
    }
    visited.push(node);
    // Find node's callees
    var node_idx: i64 = -1;
    var ni: i64 = 0;
    while ni < cg_names.len() {
        if cg_names.get(ni) == node {
            node_idx = ni;
        }
        ni = ni + 1;
    }
    if node_idx < 0 {
        return false;
    }
    var start: i64 = cg_offsets.get(node_idx);
    var end: i64 = 0;
    if node_idx + 1 < cg_offsets.len() {
        end = cg_offsets.get(node_idx + 1);
    } else {
        end = cg_calls.len();
    }
    var ci: i64 = start;
    while ci < end {
        var callee: str = cg_calls.get(ci);
        if dfs_reaches_fd(callee, target, cg_names, cg_calls, cg_offsets, visited) {
            return true;
        }
        ci = ci + 1;
    }
    return false;
}

// Expand safety annotations into a list of primitive names.
// Direct primitives: no-alloc, no-recursion, no-unbounded, no-indirect,
//                    requires-audit, bounded-stack
// Domain presets: crashfree, medical, safety-critical, autosar
pub fn expand_safety_primitives(annotations: Vec<Annotation>) -> Vec<str> {
    var prims: Vec<str> = Vec::new();
    var ai: i64 = 0;
    while ai < annotations.len() {
        var ann: Annotation = annotations.get(ai);
        var name: str = ann.name;
        // Direct primitives
        if name == "no-alloc" {
            prims.push("no-alloc");
        }
        if name == "no-recursion" {
            prims.push("no-recursion");
        }
        if name == "no-unbounded" {
            prims.push("no-unbounded");
        }
        if name == "no-indirect" {
            prims.push("no-indirect");
        }
        if name == "requires-audit" {
            prims.push("requires-audit");
        }
        if name == "bounded-stack" {
            prims.push("bounded-stack");
        }
        // @no-panic is a real primitive — usable directly, not only via presets.
        if name == "no-panic" {
            prims.push("no-panic");
        }
        // F30: @firmware — bare-metal firmware (no OS-dependent calls)
        if name == "firmware" {
            prims.push("firmware");
        }
        // F23: @simd — recognized but no safety primitives
        // F88: @zeroize — recognized but no safety primitives
        // F29: @interrupt — recognized but no safety primitives
        // F74: @secret — recognized but no safety primitives (handled in verify_secret)
        // CO7: @sensitive — recognized but no safety primitives (secrecy.fd)
        // @shader/@kernel — GPU shader entry point (handled in lowerer as is_kernel)
        // (These are recognized so the typechecker doesn't reject them as unknown)
        // Domain presets — expand to their primitives
        if name == "crashfree" {
            prims.push("no-panic");
            prims.push("no-unbounded");
        }
        if name == "medical" || name == "dal-a" {
            // @dal-a is the old spelling of @medical (DO-178C DAL-A); kept as
            // an alias instead of silently doing nothing.
            prims.push("no-alloc");
            prims.push("no-recursion");
            prims.push("no-unbounded");
            prims.push("no-panic");
            prims.push("requires-audit");
        }
        if name == "safety-critical" {
            prims.push("no-alloc");
            prims.push("no-recursion");
            prims.push("no-unbounded");
            prims.push("no-panic");
            prims.push("no-indirect");
        }
        if name == "autosar" {
            prims.push("no-alloc");
            prims.push("no-recursion");
            prims.push("no-unbounded");
            prims.push("no-panic");
        }
        // CA10 / F59: @no-blocking — no call that waits (sleep, locks,
        // channels, sockets, files, processes, task joins)
        if name == "no-blocking" {
            prims.push("no-blocking");
        }
        // F59: @grid-safe — IEC 61850 protection path: bounded response
        // (no unbounded loop, no recursion), no blocking operation,
        // deterministic dispatch (no function values or dyn calls) and no
        // heap allocation
        if name == "grid-safe" {
            prims.push("no-alloc");
            prims.push("no-recursion");
            prims.push("no-unbounded");
            prims.push("no-indirect");
            prims.push("no-blocking");
        }
        ai = ai + 1;
    }
    return prims;
}

// Check if a primitive is in the list
pub fn has_primitive(prims: Vec<str>, name: str) -> bool {
    var i: i64 = 0;
    while i < prims.len() {
        if prims.get(i) == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Get the domain label for error messages
pub fn safety_domain_label(prims: Vec<str>) -> str {
    if has_primitive(prims, "no-blocking") && has_primitive(prims, "no-indirect") && has_primitive(prims, "no-alloc") && !has_primitive(prims, "requires-audit") {
        return "grid-safe (IEC 61850)";
    }
    if has_primitive(prims, "firmware") {
        return "firmware (bare-metal)";
    }
    if has_primitive(prims, "requires-audit") && has_primitive(prims, "no-indirect") {
        return "safety-critical (ISO 26262 / DO-178C)";
    }
    if has_primitive(prims, "requires-audit") {
        return "medical (IEC 62304 / DAL-A)";
    }
    if has_primitive(prims, "no-indirect") {
        return "safety-critical";
    }
    if has_primitive(prims, "no-panic") && has_primitive(prims, "no-unbounded") && prims.len() == 2 {
        return "crashfree";
    }
    return "safety-annotated";
}

/// F59 / CA10: a builtin that can wait (forbidden in @no-blocking and so in
/// @grid-safe code): what blocks a worker thread (tc_blocking_call_fix),
/// the task waits that park a task (sleep, fd waits, join, yield), and
/// sockets, HTTP, DNS, TLS, files, directories and processes.
pub fn is_blocking_func(name: str) -> bool {
    if tc_blocking_call_fix(name) != "" {
        return true;
    }
    if str_starts_with(name, "p_co_") {
        return name != "p_co_done" && name != "p_co_result" && name != "p_co_detach";
    }
    if str_starts_with(name, "p_socket_") || str_starts_with(name, "p_net_") {
        return name != "p_socket_close" && name != "p_net_close" && name != "p_socket_nonblock";
    }
    // rm-L4B-net-unix: Unix-domain sockets (connect waits for the peer)
    if name == "p_unix_listen" || name == "p_unix_connect" {
        return true;
    }
    if str_starts_with(name, "p_http_") {
        return !str_contains(name, "build") && !str_contains(name, "parse");
    }
    if str_starts_with(name, "p_dns_") || str_starts_with(name, "p_tls_") || str_starts_with(name, "p_file_") || str_starts_with(name, "p_dir_") || str_starts_with(name, "p_process_") {
        return true;
    }
    return name == "p_task_join" || name == "p_future_await" || name == "p_executor_run" || name == "p_fs_read" || name == "p_fs_write" || name == "p_fs_read_async" || name == "p_fs_write_async";
}

// F30: Check if a function is OS-dependent (forbidden in @firmware code)
pub fn is_os_dependent_func(name: str) -> bool {
    // Families that all need a hosted OS (release L1)
    if str_starts_with(name, "p_file_") || str_starts_with(name, "p_dir_") || str_starts_with(name, "p_socket_") || str_starts_with(name, "p_unix_") || str_starts_with(name, "p_process_") || str_starts_with(name, "p_tls_") || str_starts_with(name, "p_dns_") {
        return true;
    }
    if name == "p_getenv" || name == "p_mkdir" || name == "p_rename" || name == "p_remove" || name == "p_read_line" || name == "p_read_stdin" || name == "p_argv" || name == "p_argc" {
        return true;
    }
    // File I/O
    if name == "p_file_read" {
        return true;
    }
    if name == "p_file_write" {
        return true;
    }
    if name == "p_file_append" {
        return true;
    }
    if name == "p_file_delete" {
        return true;
    }
    if name == "p_file_exists" {
        return true;
    }
    if name == "p_file_size" {
        return true;
    }
    if name == "p_file_hash" {
        return true;
    }
    if name == "p_file_write_bin" {
        return true;
    }
    if name == "p_file_write_vec" {
        return true;
    }
    if name == "p_file_read_bytes" {
        return true;
    }
    if name == "p_dir_list" {
        return true;
    }
    if name == "p_is_dir" {
        return true;
    }
    if name == "p_mkdir" {
        return true;
    }
    if name == "p_rmdir" {
        return true;
    }
    if name == "p_rename" {
        return true;
    }
    if name == "p_process_run" {
        return true;
    }
    if name == "p_process_stdout" {
        return true;
    }
    if name == "p_process_stderr" {
        return true;
    }
    if name == "p_process_code" {
        return true;
    }
    if name == "p_process_close" {
        return true;
    }
    if name == "p_getpid" {
        return true;
    }
    if name == "p_system" {
        return true;
    }
    if name == "p_exit" {
        return true;
    }
    // Sockets / networking
    if name == "p_socket_create" {
        return true;
    }
    if name == "p_socket_connect" {
        return true;
    }
    if name == "p_socket_send" {
        return true;
    }
    if name == "p_socket_recv" {
        return true;
    }
    if name == "p_socket_recv_str" {
        return true;
    }
    if name == "p_socket_close" {
        return true;
    }
    if name == "p_socket_listen" {
        return true;
    }
    if name == "p_socket_accept" {
        return true;
    }
    // HTTP
    if name == "p_http_get" {
        return true;
    }
    if name == "p_http_post" {
        return true;
    }
    if name == "p_http_send_response" {
        return true;
    }
    // Threads / mutexes
    if name == "p_thread_create" {
        return true;
    }
    if name == "p_thread_join" {
        return true;
    }
    if name == "p_mutex_create" {
        return true;
    }
    if name == "p_mutex_lock" {
        return true;
    }
    if name == "p_mutex_unlock" {
        return true;
    }
    // Environment / args
    if name == "p_env_get" {
        return true;
    }
    if name == "p_env_set" {
        return true;
    }
    if name == "p_args_count" {
        return true;
    }
    if name == "p_args_get" {
        return true;
    }
    // SQLite
    if name == "p_sqlite_open" {
        return true;
    }
    if name == "p_sqlite_exec" {
        return true;
    }
    if name == "p_sqlite_query" {
        return true;
    }
    return false;
}

/// Parameters of function or `dyn` type: a call through one is indirect.
pub fn safety_fn_params(params: Vec<Param>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < params.len() {
        match params.get(i).ty {
            Type::Func(_, _) => {
                out.push(params.get(i).name);
            }
            Type::Dyn(_) => {
                out.push(params.get(i).name);
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return out;
}

/// The user method a ".m" call can name: the first `Type_m` among the
/// methods of user types, or "" (a builtin method of Vec, HashMap, str,
/// Option or Result).
fn safety_resolve_method(m: str, method_names: Vec<str>) -> str {
    var suffix: str = "_" + m;
    var i: i64 = 0;
    while i < method_names.len() {
        if str_ends_with(method_names.get(i), suffix) {
            return method_names.get(i);
        }
        i = i + 1;
    }
    return "";
}

/// The methods of the builtin Vec, HashMap and str (as the checker's
/// method dispatch knows them): a `.m()` of one of these names may be on a
/// builtin value, whatever user type also has a method `m`.
fn safety_builtin_method(m: str) -> bool {
    return m == "len" || m == "get" || m == "set" || m == "push" || m == "pop" || m == "is_empty" || m == "clear" || m == "clone" || m == "contains" || m == "contains_key" || m == "insert" || m == "remove" || m == "keys" || m == "values" || m == "first" || m == "last" || m == "get_or" || m == "capacity" || m == "count" || m == "drop" || m == "extend" || m == "truncate" || m == "reverse" || m == "sort" || m == "find" || m == "rfind" || m == "position" || m == "map" || m == "filter" || m == "fold" || m == "for_each" || m == "any" || m == "all" || m == "bytes" || m == "split" || m == "trim" || m == "replace" || m == "repeat" || m == "starts_with" || m == "ends_with" || m == "to_lowercase" || m == "to_uppercase" || m == "to_string" || m == "to_str" || m == "push_str" || m == "parse_int" || m == "find_opt" || m == "position_opt" || m == "take" || m == "skip" || m == "zip" || m == "enumerate" || m == "flat_map" || m == "chunk" || m == "window" || m == "dedup" || m == "sort_by" || m == "contains_val";
}

// Check a function body for safety violations
pub fn check_safety_body(func_name: str, body: Vec<Stmt>, prims: Vec<str>, anns: Vec<Annotation>, all_func_names: Vec<str>, all_func_prims: Vec<StrStack>, fn_params: Vec<str>, method_names: Vec<str>) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    var label: str = safety_domain_label(prims);

    // @requires-audit: must have @audit
    if has_primitive(prims, "requires-audit") {
        var has_audit: bool = false;
        var ai: i64 = 0;
        while ai < anns.len() {
            if anns.get(ai).name == "audit" {
                has_audit = true;
                ai = anns.len();
            }
            ai = ai + 1;
        }
        if !has_audit {
            errs.push("Safety error (" + label + "): function '" + func_name + "' is @requires-audit but not @audit.\n    Safety-critical functions must have @audit for regulatory traceability.\n    Fix: add @audit to '" + func_name + "', or remove the safety annotation.");
        }
    }

    // Collect all calls in the body
    var calls: Vec<str> = Vec::new();
    g_scan_dot_methods = true;
    scan_stmts_for_calls(body, &mut calls);
    g_scan_dot_methods = false;
    // BG152: the body's locals and what they are bound to, for calls
    // through a local function value
    var let_names: Vec<str> = Vec::new();
    var let_inits: Vec<Expr> = Vec::new();
    tc_collect_lets(body, &mut let_names, &mut let_inits);

    // Builtin methods that allocate (Vec, HashMap, str), and "+" for `a + b`
    // on strings.
    var alloc_methods: Vec<str> = tc_alloc_method_names();

    // Alloc functions (forbidden by @no-alloc)
    var alloc_funcs: Vec<str> = tc_alloc_func_names();

    // Panic functions (forbidden by @no-panic)
    var panic_funcs: Vec<str> = Vec::new();
    panic_funcs.push("p_panic");
    panic_funcs.push("Option_unwrap");
    panic_funcs.push("Result_unwrap");

    // Indirect call functions (forbidden by @no-indirect)
    var indirect_funcs: Vec<str> = Vec::new();
    indirect_funcs.push("p_make_dyn");
    indirect_funcs.push("p_call_ptr");
    indirect_funcs.push("p_dyn_call");

    var ci: i64 = 0;
    while ci < calls.len() {
        var called: str = calls.get(ci);

        // A method call: a user method is checked as the function it names;
        // a builtin one only for allocation and unwrap.
        if str_starts_with(called, ".") {
            var m: str = str_slice(called, 1, str_len(called));
            // A name that Vec, HashMap or str also has (`data.len()`) cannot
            // be told apart from a user method here, before types are known:
            // guessing by name took a Vec's .len() for StringBuilder_len.
            // It is checked as a builtin here; a call of a user method of
            // that name is held to the rules by TypeChecker_verify_method_calls,
            // which knows the receiver's type.
            var user_fn: str = "";
            if !safety_builtin_method(m) {
                user_fn = safety_resolve_method(m, method_names);
            }
            if user_fn == "" {
                if has_primitive(prims, "no-alloc") && tc_vec_contains_str(alloc_methods, m) {
                    var what: str = "." + m + "()";
                    if m == "+" {
                        // StrConcat or (BG130) an f-string that interpolates
                        what = "an f-string or string `+`";
                    }
                    errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-alloc but uses " + what + ", which allocates.\n    Dynamic allocation is forbidden — deterministic memory usage required.\n    Fix: use a fixed-size array or a buffer passed in, or remove the safety annotation.");
                }
                if has_primitive(prims, "no-panic") && (m == "unwrap" || m == "expect") {
                    errs.push("Safety error (" + label + "): function '" + func_name + "' calls '." + m + "()'.\n    " + m + "() panics on None/Err — crashfree functions must never panic.\n    Fix: use match, unwrap_or, or the ? operator instead.");
                }
                ci = ci + 1;
                continue;
            }
            called = user_fn;
        }

        // BG152: a call through a local function value (`val f = inc;
        // f(n)`, `val g = s.f; g(n)`) is an indirect call; a local bound
        // to a named function is then checked as a call of that function
        // (so `val f = r; f(n - 1)` inside `r` is recursion). A name that
        // is a function of the program calls that function, and a local
        // bound to a plain name that is no function (`val max = MAX`) is
        // no function value.
        var local_at: i64 = -1;
        if !tc_vec_contains_str(all_func_names, called) && !tc_vec_contains_str(fn_params, called) {
            local_at = tc_last_index_of(let_names, called);
        }
        var local_target: str = "";
        var local_closure: bool = false;
        if local_at >= 0 {
            match let_inits.get(local_at) {
                Expr::Ident(tn) => {
                    if tn == func_name || tc_vec_contains_str(all_func_names, tn) {
                        local_target = tn;
                    } else if !tc_vec_contains_str(fn_params, tn) && tc_last_index_of(let_names, tn) < 0 {
                        local_at = -1;
                    }
                }
                Expr::Closure(_, _, _) => {
                    // its body's calls are in `calls` already
                    local_closure = true;
                }
                _ => {
                }
            }
        }
        if local_at >= 0 {
            if has_primitive(prims, "no-indirect") {
                errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-indirect but calls the local '" + called + "', a function value.\n    Indirect calls (function pointers, closures, dynamic dispatch) are forbidden.\n    Fix: call the function directly, or remove the safety annotation.");
                ci = ci + 1;
                continue;
            }
            if str_len(local_target) == 0 {
                if !local_closure && has_primitive(prims, "no-recursion") {
                    errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-recursion but calls the local '" + called + "', a function value whose target is not known.\n    Recursion through it cannot be ruled out.\n    Fix: call the function directly, or remove the safety annotation.");
                }
                ci = ci + 1;
                continue;
            }
            called = local_target;
        }

        // @no-indirect: a call through a parameter of function type
        if has_primitive(prims, "no-indirect") && tc_vec_contains_str(fn_params, called) {
            errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-indirect but calls its parameter '" + called + "', a function value.\n    Indirect calls (function pointers, closures, dynamic dispatch) are forbidden.\n    Fix: call the function directly, or remove the safety annotation.");
            ci = ci + 1;
            continue;
        }

        // Skip built-in runtime functions (p_print_*, etc.) unless they're in a forbidden list
        if str_starts_with(called, "p_") {
            var fw_forbidden: bool = (has_primitive(prims, "firmware") && is_os_dependent_func(called)) || (has_primitive(prims, "no-blocking") && is_blocking_func(called));
            if !fw_forbidden && !tc_vec_contains_str(panic_funcs, called) && !tc_vec_contains_str(alloc_funcs, called) && !tc_vec_contains_str(indirect_funcs, called) {
                ci = ci + 1;
                continue;
            }
        }
        if called == "print" || called == "println" || called == "print_str" || called == "print_nl" || called == "print_int" {
            ci = ci + 1;
            continue;
        }

        // @no-alloc: check for dynamic allocation
        if has_primitive(prims, "no-alloc") {
            if tc_vec_contains_str(alloc_funcs, called) {
                errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-alloc but calls '" + called + "'.\n    Dynamic allocation is forbidden — deterministic memory usage required.\n    Fix: use stack-allocated arrays, or remove the safety annotation.");
                ci = ci + 1;
                continue;
            }
        }

        // @no-panic: check for panic risk
        if has_primitive(prims, "no-panic") {
            if tc_vec_contains_str(panic_funcs, called) {
                errs.push("Safety error (" + label + "): function '" + func_name + "' calls '" + called + "', which can panic.\n    '" + called + "' can panic at runtime — crashfree functions must never panic.\n    Fix: use match/unwrap_or instead of unwrap, or remove the safety annotation.");
                ci = ci + 1;
                continue;
            }
            if called == "unwrap" {
                errs.push("Safety error (" + label + "): function '" + func_name + "' calls 'unwrap'.\n    unwrap() panics on None/Err — crashfree functions must never panic.\n    Fix: use match, unwrap_or, or the ? operator instead.");
                ci = ci + 1;
                continue;
            }
        }

        // @no-indirect: check for function pointers / dynamic dispatch
        if has_primitive(prims, "no-indirect") {
            if tc_vec_contains_str(indirect_funcs, called) {
                errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-indirect but calls '" + called + "'.\n    Indirect calls (function pointers, dynamic dispatch) are forbidden.\n    Fix: use direct calls only, or remove the safety annotation.");
                ci = ci + 1;
                continue;
            }
        }

        // F30: @firmware — check for OS-dependent function calls
        if has_primitive(prims, "firmware") {
            if is_os_dependent_func(called) {
                errs.push("Safety error (" + label + "): function '" + func_name + "' is @firmware but calls '" + called + "'.\n    OS-dependent functions (file I/O, sockets, threads, env vars) are forbidden\n    in bare-metal firmware — they require a hosted OS environment.\n    Fix: use bare-metal alternatives (port I/O, memory-mapped I/O),\n    or remove the @firmware annotation.");
                ci = ci + 1;
                continue;
            }
        }

        // F59 / CA10: @no-blocking (part of @grid-safe) — no call that waits
        if has_primitive(prims, "no-blocking") && is_blocking_func(called) {
            errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-blocking but calls '" + called + "', which can wait (a sleep, lock, channel, socket, file, process or task).\n    A protection path must answer in bounded time: it may not block.\n    Fix: move the call out of the protection path (hand the work to another task), or remove the annotation.");
            ci = ci + 1;
            continue;
        }

        // @no-recursion: check for direct self-call
        if has_primitive(prims, "no-recursion") && called == func_name {
            errs.push("Safety error (" + label + "): function '" + func_name + "' is @no-recursion but calls itself.\n    Recursion is forbidden — stack overflow is a safety risk.\n    Fix: convert to an iterative loop, or remove the safety annotation.");
            ci = ci + 1;
            continue;
        }

        // Core's collection and Option/Result functions were checked
        // against the forbidden lists above; they carry no annotations.
        if str_starts_with(called, "Vec_") || str_starts_with(called, "HashMap_") || str_starts_with(called, "Option_") || str_starts_with(called, "Result_") || str_starts_with(called, "Box_") {
            ci = ci + 1;
            continue;
        }

        // Transitive: can only call other safety-annotated functions
        // (with compatible or superset primitives)
        var is_known_func: bool = false;
        var callee_prims: Vec<str> = Vec::new();
        var fi: i64 = 0;
        while fi < all_func_names.len() {
            if all_func_names.get(fi) == called {
                is_known_func = true;
                callee_prims = all_func_prims.get(fi);
                fi = all_func_names.len();
            }
            fi = fi + 1;
        }
        if !is_known_func {
            // Unknown — might be builtin, skip
            ci = ci + 1;
            continue;
        }
        if callee_prims.len() > 0 {
            // Callee has safety annotations — check it has all required primitives
            var pi: i64 = 0;
            while pi < prims.len() {
                var required: str = prims.get(pi);
                if !has_primitive(callee_prims, required) {
                    errs.push("Safety error (" + label + "): function '" + func_name + "' is safety-annotated but calls '" + called + "',\n    which lacks the '" + required + "' primitive.\n    A safety-annotated function can only call functions with compatible safety guarantees.\n    Fix: add the missing safety annotation to '" + called + "', or remove the call.");
                    pi = prims.len();
                    // break
                }
                pi = pi + 1;
            }
        } else {
            // Callee has no safety annotations
            errs.push("Safety error (" + label + "): function '" + func_name + "' is safety-annotated but calls '" + called + "',\n    which has no safety annotations.\n    A safety-annotated function can only call other safety-annotated functions.\n    Fix: add safety annotations to '" + called + "', or remove the call from '" + func_name + "'.");
        }
        ci = ci + 1;
    }

    // @no-panic: check for division/modulo (division by zero risk)
    if has_primitive(prims, "no-panic") {
        var div_sites: Vec<str> = Vec::new();
        scan_for_division(body, &mut div_sites);
        var di: i64 = 0;
        while di < div_sites.len() {
            errs.push("Safety error (" + label + "): function '" + func_name + "' uses '" + div_sites.get(di) + "'.\n    Division/modulo by zero aborts at runtime.\n    Crashfree functions cannot use '" + div_sites.get(di) + "' unless the divisor is proven non-zero.\n    Fix: use a checked-divide helper, or remove the safety annotation.");
            di = di + 1;
        }
    }

    // @no-panic: indexing (out of bounds) and integer arithmetic (overflow)
    // panic too.
    if has_primitive(prims, "no-panic") {
        var wrapping: bool = false;
        var wai: i64 = 0;
        while wai < anns.len() {
            if anns.get(wai).name == "wrapping" {
                wrapping = true;
            }
            wai = wai + 1;
        }
        var risk_lines: Vec<i64> = Vec::new();
        var risk_msgs: Vec<str> = Vec::new();
        scan_for_panic_risks(body, wrapping, &mut risk_lines, &mut risk_msgs);
        var rk: i64 = 0;
        while rk < risk_lines.len() {
            errs.push("Safety error (" + label + ") (line " + int_to_str(risk_lines.get(rk)) + "): function '" + func_name + "' " + risk_msgs.get(rk) + ".\n    Crashfree functions must never panic.");
            rk = rk + 1;
        }
    }

    // @no-unbounded: check for while loops
    if has_primitive(prims, "no-unbounded") {
        var while_sites: Vec<i64> = Vec::new();
        scan_for_while_loops(body, &mut while_sites);
        var wi: i64 = 0;
        while wi < while_sites.len() {
            errs.push("Safety error (" + label + ") (line " + int_to_str(while_sites.get(wi)) + "): function '" + func_name + "' is @no-unbounded but uses a 'while' loop.\n    While loops are unbounded — use 'for' loops over finite ranges/arrays.\n    Fix: replace 'while cond { ... }' with 'for i in 0..N { ... }', or remove the safety annotation.");
            wi = wi + 1;
        }
    }

    return errs;
}

// BG151/BG152: whether a `val`/`var` looks bound to a function value: a
// declared function type, or a name, closure, field or element (a local
// bound to a call's result, `val sum = sum(v)`, is not taken for one).
fn tc_let_is_fn_value(lty: OptType, init: Expr) -> bool {
    match lty {
        OptType::Some(t) => {
            match t {
                Type::Func(_, _) => {
                    return true;
                }
                _ => {
                    return false;
                }
            }
        }
        OptType::None => {
        }
    }
    match init {
        Expr::Ident(_) => {
            return true;
        }
        Expr::Closure(_, _, _) => {
            return true;
        }
        Expr::FieldAccess(_, _) => {
            return true;
        }
        Expr::Index(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

// BG151/BG152: the names `val`/`var` bind to a function value in `stmts`
// (nested blocks too, not closures) and the expression each is bound to, in
// order (tc_let_is_fn_value).
fn tc_collect_lets(stmts: Vec<Stmt>, names: &mut Vec<str>, inits: &mut Vec<Expr>) {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Let(ln, lty, init, _, _, _, _) => {
                if tc_let_is_fn_value(lty, init) {
                    names.push(ln);
                    inits.push(init);
                }
            }
            Stmt::If(_, tb, eb, _) => {
                tc_collect_lets(tb, names, inits);
                match eb {
                    OptStmts::Some(b) => {
                        tc_collect_lets(b, names, inits);
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(_, b, _) => {
                tc_collect_lets(b, names, inits);
            }
            Stmt::For(_, _, b, _) => {
                tc_collect_lets(b, names, inits);
            }
            Stmt::Loop(b, _) => {
                tc_collect_lets(b, names, inits);
            }
            Stmt::Match(_, arms, _) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    tc_collect_lets(arms.get(ai).body, names, inits);
                    ai = ai + 1;
                }
            }
            Stmt::Unsafe(b, _) => {
                tc_collect_lets(b, names, inits);
            }
            Stmt::Sandbox(b, _) => {
                tc_collect_lets(b, names, inits);
            }
            Stmt::Txn(b, _) => {
                tc_collect_lets(b, names, inits);
            }
            Stmt::Defer(b, _) => {
                tc_collect_lets(b, names, inits);
            }
            Stmt::RegionBlock(_, _, _, _, _, b, _) => {
                tc_collect_lets(b, names, inits);
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

// The index of the last `s` in `v`, or -1.
fn tc_last_index_of(v: Vec<str>, s: str) -> i64 {
    var i: i64 = v.len() - 1;
    while i >= 0 {
        if v.get(i) == s {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

// --- Helper: check if a Vec<str> contains a string ---
pub fn tc_vec_contains_str(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// --- Call scanning helpers ---

pub fn scan_stmts_for_calls(stmts: Vec<Stmt>, calls: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_calls(stmts.get(i), calls);
        i = i + 1;
    }
}

pub fn scan_stmt_for_calls(stmt: Stmt, calls: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => {
            scan_expr_for_calls(expr, calls);
        }
        Stmt::LetTuple(_, expr, _) => {
            scan_expr_for_calls(expr, calls);
        }
        Stmt::Expr(e, _) => {
            scan_expr_for_calls(e, calls);
        }
        Stmt::Assign(_, _, expr, _) => {
            scan_expr_for_calls(expr, calls);
        }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            scan_expr_for_calls(index, calls);
            scan_expr_for_calls(expr, calls);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            scan_expr_for_calls(ptr_expr, calls);
            scan_expr_for_calls(expr, calls);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            scan_expr_for_calls(object, calls);
            scan_expr_for_calls(expr, calls);
        }
        Stmt::Return(opt_e, _) => {
            match opt_e {
                OptBoxExpr::Some(e) => {
                    scan_expr_for_calls(box_expr_unbox(e), calls);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            scan_expr_for_calls(cond, calls);
            scan_stmts_for_calls(then_block, calls);
            match else_block {
                OptStmts::Some(eb) => {
                    scan_stmts_for_calls(eb, calls);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(cond, body, _) => {
            scan_expr_for_calls(cond, calls);
            scan_stmts_for_calls(body, calls);
        }
        Stmt::For(_, iterator, body, _) => {
            scan_expr_for_calls(iterator, calls);
            scan_stmts_for_calls(body, calls);
        }
        Stmt::Loop(body, _) => {
            scan_stmts_for_calls(body, calls);
        }
        Stmt::Break(opt_e, _) => {
            match opt_e {
                OptBoxExpr::Some(e) => {
                    scan_expr_for_calls(box_expr_unbox(e), calls);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::Defer(stmts, _) => {
            scan_stmts_for_calls(stmts, calls);
        }
        Stmt::Match(expr, arms, _) => {
            scan_expr_for_calls(expr, calls);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_calls(arms.get(ai).body, calls);
                ai = ai + 1;
            }
        }
        Stmt::Handle(body, handlers, _) => {
            scan_stmts_for_calls(body, calls);
            var hi: i64 = 0;
            while hi < handlers.len() {
                scan_stmts_for_calls(handlers.get(hi).body, calls);
                hi = hi + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            scan_stmts_for_calls(body, calls);
        }
        Stmt::Sandbox(body, _) => {
            scan_stmts_for_calls(body, calls);
        }
        Stmt::Unsafe(body, _) => {
            scan_stmts_for_calls(body, calls);
        }
        Stmt::Txn(body, _) => {
            scan_stmts_for_calls(body, calls);
        }
        Stmt::ComptimeGen(block, _) => {
            scan_stmts_for_calls(block, calls);
        }
        Stmt::GradBlock(_, body, _) => {
            scan_stmts_for_calls(body, calls);
        }
        Stmt::Backward(loss, _) => {
            scan_expr_for_calls(loss, calls);
        }
        Stmt::Do(_, _, args, _) => {
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_calls(args.get(ai), calls);
                ai = ai + 1;
            }
        }
        _ => {
        }
    }
}

/// Set by check_safety_body: method calls are recorded as ".method",
/// `Type::f` calls as "Type_f" and string concatenation as ".+" (release
/// L1: the safety checks saw only free-function names, so `v.push(x)` and
/// `Vec::new()` passed @no-alloc).
var g_scan_dot_methods: bool = false;  // When set, scan_expr_for_calls records inline assembly as "asm!" (the
// sandbox check treats it as code the effect system cannot see).
var g_scan_asm: bool = false;  // When set, scan_expr_for_calls also records each struct literal as
// "{Name" (the @conserve check looks for `Money { .. }`).
var g_scan_struct_lits: bool = false;
pub fn scan_expr_for_calls(expr: Expr, calls: &mut Vec<str>) {
    match expr {
        Expr::Call(callee, args) => {
            calls.push(callee);
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_calls(args.get(ai), calls);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(receiver, method, args) => {
            if g_scan_dot_methods {
                // `Type::f(..)` parses as a method call on the type name:
                // record it as the function it names, `Type_f`.
                var static_name: str = "";
                match box_expr_unbox(receiver) {
                    Expr::Ident(rn) => {
                        if str_len(rn) > 0 && str_byte_at(rn, 0) >= 65 && str_byte_at(rn, 0) <= 90 {
                            static_name = rn + "_" + method;
                        }
                    }
                    _ => {
                    }
                }
                if static_name != "" {
                    calls.push(static_name);
                } else {
                    calls.push("." + method);
                }
            } else {
                calls.push(method);
            }
            scan_expr_for_calls(box_expr_unbox(receiver), calls);
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_calls(args.get(ai), calls);
                ai = ai + 1;
            }
        }
        Expr::Binary(_, left, right) => {
            scan_expr_for_calls(box_expr_unbox(left), calls);
            scan_expr_for_calls(box_expr_unbox(right), calls);
        }
        Expr::Unary(_, e) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::FieldAccess(e, _) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::OptionalFieldAccess(e, _) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::StructLit(sl_name, fields, spread) => {
            if g_scan_struct_lits {
                calls.push("{" + sl_name);
            }
            var fi: i64 = 0;
            while fi < fields.len() {
                scan_expr_for_calls(fields.get(fi).value, calls);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => {
                    scan_expr_for_calls(box_expr_unbox(s), calls);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::If(cond, then_block, else_block) => {
            scan_expr_for_calls(box_expr_unbox(cond), calls);
            scan_stmts_for_calls(then_block, calls);
            match else_block {
                OptStmts::Some(eb) => {
                    scan_stmts_for_calls(eb, calls);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::ArrayLit(_, elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                scan_expr_for_calls(elements.get(ei), calls);
                ei = ei + 1;
            }
        }
        Expr::Index(array, index) => {
            scan_expr_for_calls(box_expr_unbox(array), calls);
            scan_expr_for_calls(box_expr_unbox(index), calls);
        }
        Expr::TupleLit(elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                scan_expr_for_calls(elements.get(ei), calls);
                ei = ei + 1;
            }
        }
        Expr::Ref(e, _) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::Deref(e) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::Cast(e, _) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::Coalesce(expr, default) => {
            scan_expr_for_calls(box_expr_unbox(expr), calls);
            scan_expr_for_calls(box_expr_unbox(default), calls);
        }
        Expr::Try(e) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::StrConcat(left, right) => {
            if g_scan_dot_methods {
                calls.push(".+");
            }
            scan_expr_for_calls(box_expr_unbox(left), calls);
            scan_expr_for_calls(box_expr_unbox(right), calls);
        }
        Expr::Range(start, end, _) => {
            scan_expr_for_calls(box_expr_unbox(start), calls);
            scan_expr_for_calls(box_expr_unbox(end), calls);
        }
        Expr::Match(expr, arms) => {
            scan_expr_for_calls(box_expr_unbox(expr), calls);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_calls(arms.get(ai).body, calls);
                ai = ai + 1;
            }
        }
        Expr::TryBlock(body) => {
            scan_stmts_for_calls(body, calls);
        }
        Expr::Block(stmts) => {
            scan_stmts_for_calls(stmts, calls);
        }
        Expr::Closure(_, body, _) => {
            scan_stmts_for_calls(body, calls);
        }
        Expr::Comptime(e) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::ComptimeBlock(stmts) => {
            scan_stmts_for_calls(stmts, calls);
        }
        Expr::PipeForward(left, right) => {
            scan_expr_for_calls(box_expr_unbox(left), calls);
            scan_expr_for_calls(box_expr_unbox(right), calls);
        }
        Expr::QuantCast(e, _) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::Asm(_, operands) => {
            if g_scan_asm {
                calls.push("asm!");
            }
            var oi: i64 = 0;
            while oi < operands.len() {
                scan_expr_for_calls(operands.get(oi).expr, calls);
                oi = oi + 1;
            }
        }
        // BG130: f-string parts, enum payloads, named arguments, await,
        // spawn, yield and `is` were skipped, so a call (or an allocating
        // f-string) inside them escaped @crashfree, @no-alloc, @no-recursion,
        // @gas and @conserve.
        Expr::FString(parts) => {
            var has_expr: bool = false;
            var pi: i64 = 0;
            while pi < parts.len() {
                match parts.get(pi) {
                    FStringPart::Expr(px) => {
                        has_expr = true;
                        scan_expr_for_calls(px, calls);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                pi = pi + 1;
            }
            // An f-string with an interpolated part builds a new string,
            // like string `+`.
            if has_expr && g_scan_dot_methods {
                calls.push(".+");
            }
        }
        Expr::EnumLit(_, _, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_calls(args.get(ai), calls);
                ai = ai + 1;
            }
        }
        Expr::NamedArg(_, e) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::Await(e) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::Spawn(e) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::Yield(e) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        Expr::IsCheck(e, _) => {
            scan_expr_for_calls(box_expr_unbox(e), calls);
        }
        _ => {
        }
    }
}

// --- Division scanning helpers ---

// Panic risks the no-panic primitive rejects besides panicking calls and
// division: indexing (out of bounds) and, unless `wrapping`, integer
// arithmetic (overflow). One (line, what) per site. Inside
// `for i in 0..v.len()`, `v[i]` / `v.get(i)` / `v.set(i, ..)` are in bounds
// (unless the body reassigns `i` or resizes `v`).
pub fn scan_for_panic_risks(stmts: Vec<Stmt>, wrapping: bool, lines: &mut Vec<i64>, msgs: &mut Vec<str>) {
    var safe_idx: Vec<str> = Vec::new();
    var safe_vec: Vec<str> = Vec::new();
    pr_stmts(stmts, wrapping, &mut safe_idx, &mut safe_vec, lines, msgs);
}

// `a`, `a.b.c`: the textual path of a place ("" if it is not one).
fn pr_place(e: Expr) -> str {
    match e {
        Expr::Ident(n) => {
            return n;
        }
        Expr::FieldAccess(x, field) => {
            var p: str = pr_place(box_expr_deref(x));
            if p == "" {
                return "";
            }
            return p + "." + field;
        }
        _ => {
            return "";
        }
    }
    return "";
}

// `for i in 0..v.len()` -> the path of `v` ("" otherwise).
fn pr_len_bound(iterator: Expr) -> str {
    match iterator {
        Expr::Range(start, end, inclusive) => {
            if inclusive {
                return "";
            }
            match box_expr_deref(start) {
                Expr::IntLit(z) => {
                    if z != 0 {
                        return "";
                    }
                }
                _ => {
                    return "";
                }
            }
            match box_expr_deref(end) {
                Expr::MethodCall(recv, method, args) => {
                    if method == "len" && args.len() == 0 {
                        return pr_place(box_expr_deref(recv));
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return "";
}

// Whether `body` reassigns `i` or resizes the Vec at path `v`.
fn pr_disturbs(body: Vec<Stmt>, i: str, v: str) -> bool {
    var k: i64 = 0;
    while k < body.len() {
        if pr_disturbs_stmt(body.get(k), i, v) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

fn pr_disturbs_stmt(s: Stmt, i: str, v: str) -> bool {
    match s {
        Stmt::Assign(target, _, expr, _) => {
            return target == i || target == v || pr_disturbs_expr(expr, i, v);
        }
        Stmt::Let(_, _, expr, _, _, _, _) => {
            return pr_disturbs_expr(expr, i, v);
        }
        Stmt::Expr(expr, _) => {
            return pr_disturbs_expr(expr, i, v);
        }
        Stmt::If(_, then_block, else_block, _) => {
            if pr_disturbs(then_block, i, v) {
                return true;
            }
            match else_block {
                OptStmts::Some(b) => {
                    return pr_disturbs(b, i, v);
                }
                OptStmts::None => {
                }
            }
            return false;
        }
        Stmt::While(_, body, _) => {
            return pr_disturbs(body, i, v);
        }
        Stmt::For(_, _, body, _) => {
            return pr_disturbs(body, i, v);
        }
        Stmt::Loop(body, _) => {
            return pr_disturbs(body, i, v);
        }
        Stmt::Unsafe(body, _) => {
            return pr_disturbs(body, i, v);
        }
        Stmt::Match(_, arms, _) => {
            var a: i64 = 0;
            while a < arms.len() {
                if pr_disturbs(arms.get(a).body, i, v) {
                    return true;
                }
                a = a + 1;
            }
            return false;
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn pr_disturbs_expr(e: Expr, i: str, v: str) -> bool {
    match e {
        Expr::MethodCall(recv, method, args) => {
            var r: Expr = box_expr_deref(recv);
            var resizes: bool = method == "pop" || method == "remove" || method == "clear" || method == "truncate" || method == "drain";
            if resizes && pr_place(r) == v {
                return true;
            }
            if pr_disturbs_expr(r, i, v) {
                return true;
            }
            var a: i64 = 0;
            while a < args.len() {
                if pr_disturbs_expr(args.get(a), i, v) {
                    return true;
                }
                a = a + 1;
            }
            return false;
        }
        Expr::Call(_, args) => {
            var c: i64 = 0;
            while c < args.len() {
                if pr_disturbs_expr(args.get(c), i, v) {
                    return true;
                }
                c = c + 1;
            }
            return false;
        }
        Expr::Binary(_, l, r) => {
            return pr_disturbs_expr(box_expr_deref(l), i, v) || pr_disturbs_expr(box_expr_deref(r), i, v);
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn pr_in_bounds(safe_idx: Vec<str>, safe_vec: Vec<str>, vec: Expr, index: Expr) -> bool {
    var vp: str = pr_place(vec);
    if vp == "" {
        return false;
    }
    match index {
        Expr::Ident(i) => {
            var k: i64 = 0;
            while k < safe_idx.len() {
                if safe_idx.get(k) == i && safe_vec.get(k) == vp {
                    return true;
                }
                k = k + 1;
            }
        }
        _ => {
        }
    }
    return false;
}

fn pr_push(lines: &mut Vec<i64>, msgs: &mut Vec<str>, line: i64, what: str) {
    var k: i64 = 0;
    while k < lines.len() {
        if lines.get(k) == line && msgs.get(k) == what {
            return;
        }
        k = k + 1;
    }
    lines.push(line);
    msgs.push(what);
}

fn pr_stmts(stmts: Vec<Stmt>, wrapping: bool, safe_idx: &mut Vec<str>, safe_vec: &mut Vec<str>, lines: &mut Vec<i64>, msgs: &mut Vec<str>) {
    var k: i64 = 0;
    while k < stmts.len() {
        var s: Stmt = stmts.get(k);
        var line: i64 = stmt_line(s);
        match s {
            Stmt::IndexAssign(array, index, aop, expr, _) => {
                if !pr_in_bounds(safe_idx, safe_vec, Expr::Ident(array), index) {
                    pr_push(lines, msgs, line, "assigns through `[...]`, which panics when the index is out of bounds");
                }
                pr_compound(aop, expr, wrapping, line, lines, msgs);
                pr_expr(index, wrapping, safe_idx, safe_vec, line, lines, msgs);
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            }
            Stmt::Let(_, _, expr, _, _, _, _) => {
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            }
            Stmt::LetTuple(_, expr, _) => {
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            }
            Stmt::Assign(_, aop, expr, _) => {
                pr_compound(aop, expr, wrapping, line, lines, msgs);
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            }
            Stmt::Expr(expr, _) => {
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            }
            Stmt::Return(value, _) => {
                match value {
                    OptBoxExpr::Some(e) => {
                        pr_expr(box_expr_deref(e), wrapping, safe_idx, safe_vec, line, lines, msgs);
                    }
                    OptBoxExpr::None => {
                    }
                }
            }
            Stmt::Break(value, _) => {
                match value {
                    OptBoxExpr::Some(e) => {
                        pr_expr(box_expr_deref(e), wrapping, safe_idx, safe_vec, line, lines, msgs);
                    }
                    OptBoxExpr::None => {
                    }
                }
            }
            Stmt::FieldAssign(object, _, aop, expr, _) => {
                pr_compound(aop, expr, wrapping, line, lines, msgs);
                pr_expr(object, wrapping, safe_idx, safe_vec, line, lines, msgs);
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            }
            Stmt::DerefAssign(ptr_expr, aop, expr, _) => {
                pr_compound(aop, expr, wrapping, line, lines, msgs);
                pr_expr(ptr_expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            }
            Stmt::If(cond, then_block, else_block, _) => {
                pr_expr(cond, wrapping, safe_idx, safe_vec, line, lines, msgs);
                pr_stmts(then_block, wrapping, safe_idx, safe_vec, lines, msgs);
                match else_block {
                    OptStmts::Some(b) => {
                        pr_stmts(b, wrapping, safe_idx, safe_vec, lines, msgs);
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(cond, body, _) => {
                pr_expr(cond, wrapping, safe_idx, safe_vec, line, lines, msgs);
                pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs);
            }
            Stmt::For(var_name, iterator, body, _) => {
                pr_expr(iterator, wrapping, safe_idx, safe_vec, line, lines, msgs);
                var bound: str = pr_len_bound(iterator);
                if bound != "" && pr_disturbs(body, var_name, bound) {
                    bound = "";
                }
                if bound != "" {
                    safe_idx.push(var_name);
                    safe_vec.push(bound);
                }
                pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs);
                if bound != "" {
                    safe_idx.pop();
                    safe_vec.pop();
                }
            }
            Stmt::Match(expr, arms, _) => {
                pr_expr(expr, wrapping, safe_idx, safe_vec, line, lines, msgs);
                var a: i64 = 0;
                while a < arms.len() {
                    pr_stmts(arms.get(a).body, wrapping, safe_idx, safe_vec, lines, msgs);
                    a = a + 1;
                }
            }
            Stmt::Loop(body, _) => {
                pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs);
            }
            Stmt::Unsafe(body, _) => {
                pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs);
            }
            Stmt::Sandbox(body, _) => {
                pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs);
            }
            Stmt::Txn(body, _) => {
                pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs);
            }
            Stmt::RegionBlock(_, _, _, _, _, body, _) => {
                pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs);
            }
            Stmt::Defer(body, _) => {
                pr_stmts(body, wrapping, safe_idx, safe_vec, lines, msgs);
            }
            _ => {
            }
        }
        k = k + 1;
    }
}

// `x += e`, `x -= e`, `x *= e` panic on overflow like `x + e` (the target is
// never a constant, so only a plainly non-integer right side is exempt).
fn pr_compound(aop: AssignOp, rhs: Expr, wrapping: bool, line: i64, lines: &mut Vec<i64>, msgs: &mut Vec<str>) {
    var arith: bool = false;
    match aop {
        AssignOp::AddAssign => {
            arith = true;
        }
        AssignOp::SubAssign => {
            arith = true;
        }
        AssignOp::MulAssign => {
            arith = true;
        }
        _ => {
        }
    }
    if arith && !wrapping && !pr_non_integer(rhs) {
        pr_push(lines, msgs, line, "uses integer `+=`/`-=`/`*=`, which panics on overflow (mark the function @wrapping for two's-complement arithmetic)");
    }
}

// Whether `e` is plainly not an integer (string or float), so `+` cannot overflow-panic.
fn pr_non_integer(e: Expr) -> bool {
    match e {
        Expr::StringLit(_) => {
            return true;
        }
        Expr::FloatLit(_) => {
            return true;
        }
        Expr::StrConcat(_, _) => {
            return true;
        }
        Expr::FString(_) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn pr_is_int_lit(e: Expr) -> bool {
    match e {
        Expr::IntLit(_) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn pr_exprs(es: Vec<Expr>, wrapping: bool, safe_idx: &mut Vec<str>, safe_vec: &mut Vec<str>, line: i64, lines: &mut Vec<i64>, msgs: &mut Vec<str>) {
    var k: i64 = 0;
    while k < es.len() {
        pr_expr(es.get(k), wrapping, safe_idx, safe_vec, line, lines, msgs);
        k = k + 1;
    }
}

fn pr_expr(e: Expr, wrapping: bool, safe_idx: &mut Vec<str>, safe_vec: &mut Vec<str>, line: i64, lines: &mut Vec<i64>, msgs: &mut Vec<str>) {
    match e {
        Expr::Index(a, x) => {
            var arr: Expr = box_expr_deref(a);
            var index: Expr = box_expr_deref(x);
            if !pr_in_bounds(safe_idx, safe_vec, arr, index) {
                pr_push(lines, msgs, line, "indexes with `[...]`, which panics when the index is out of bounds");
            }
            pr_expr(arr, wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(index, wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::MethodCall(recv, method, args) => {
            var r: Expr = box_expr_deref(recv);
            var in_bounds: bool = false;
            if (method == "get" || method == "set") && args.len() > 0 {
                in_bounds = pr_in_bounds(safe_idx, safe_vec, r, args.get(0));
            }
            var panics: bool = method == "get" || method == "set" || method == "remove" || method == "pop" || method == "insert";
            if panics && !in_bounds {
                // 2g.64: Vec has no `get_or`; the accepted forms are an index
                // from `for i in 0..v.len()` (pr_len_bound) or the access in a
                // helper without @crashfree.
                var pr_fix: str = "index with `i` from `for i in 0..v.len()` (known in bounds), or move the call into a function without @crashfree";
                if method == "pop" || method == "remove" || method == "insert" {
                    pr_fix = "move the call into a function without @crashfree (a Vec has no non-panicking `" + method + "`)";
                }
                pr_push(lines, msgs, line, "calls `." + method + "()`, which panics when the index is out of bounds (or the Vec is empty); " + pr_fix);
            }
            pr_expr(r, wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_exprs(args, wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Binary(op, l, r) => {
            var left: Expr = box_expr_deref(l);
            var right: Expr = box_expr_deref(r);
            var arith: bool = false;
            match op {
                BinOp::Add => {
                    arith = true;
                }
                BinOp::Sub => {
                    arith = true;
                }
                BinOp::Mul => {
                    arith = true;
                }
                _ => {
                }
            }
            var constant: bool = pr_is_int_lit(left) && pr_is_int_lit(right);
            if arith && !wrapping && !constant && !pr_non_integer(left) && !pr_non_integer(right) {
                pr_push(lines, msgs, line, "uses integer `+`/`-`/`*`, which panics on overflow (mark the function @wrapping for two's-complement arithmetic)");
            }
            pr_expr(left, wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(right, wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Unary(uop, x) => {
            var operand: Expr = box_expr_deref(x);
            var neg: bool = false;
            match uop {
                UnaryOp::Neg => {
                    neg = true;
                }
                _ => {
                }
            }
            // `-x` panics for the minimum integer (`-MIN` overflows)
            if neg && !wrapping && !pr_is_int_lit(operand) && !pr_non_integer(operand) {
                pr_push(lines, msgs, line, "uses integer unary `-`, which panics on overflow for the minimum value (mark the function @wrapping for two's-complement arithmetic)");
            }
            pr_expr(operand, wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::FieldAccess(x, _) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::OptionalFieldAccess(x, _) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Ref(x, _) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Deref(x) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Try(x) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::IsCheck(x, _) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Cast(x, _) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::QuantCast(x, _) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Await(x) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Spawn(x) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::StrConcat(l, r) => {
            pr_expr(box_expr_deref(l), wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(box_expr_deref(r), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Range(l, r, _) => {
            pr_expr(box_expr_deref(l), wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(box_expr_deref(r), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Coalesce(l, r) => {
            pr_expr(box_expr_deref(l), wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(box_expr_deref(r), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::PipeForward(l, r) => {
            pr_expr(box_expr_deref(l), wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_expr(box_expr_deref(r), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Call(_, args) => {
            pr_exprs(args, wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::EnumLit(_, _, args) => {
            pr_exprs(args, wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::TupleLit(args) => {
            pr_exprs(args, wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::ArrayLit(_, args) => {
            pr_exprs(args, wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::StructLit(_, fields, _) => {
            var f: i64 = 0;
            while f < fields.len() {
                pr_expr(fields.get(f).value, wrapping, safe_idx, safe_vec, line, lines, msgs);
                f = f + 1;
            }
        }
        Expr::If(cond, then_block, else_block) => {
            pr_expr(box_expr_deref(cond), wrapping, safe_idx, safe_vec, line, lines, msgs);
            pr_stmts(then_block, wrapping, safe_idx, safe_vec, lines, msgs);
            match else_block {
                OptStmts::Some(b) => {
                    pr_stmts(b, wrapping, safe_idx, safe_vec, lines, msgs);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Match(x, arms) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
            var a: i64 = 0;
            while a < arms.len() {
                pr_stmts(arms.get(a).body, wrapping, safe_idx, safe_vec, lines, msgs);
                a = a + 1;
            }
        }
        Expr::Block(b) => {
            pr_stmts(b, wrapping, safe_idx, safe_vec, lines, msgs);
        }
        Expr::TryBlock(b) => {
            pr_stmts(b, wrapping, safe_idx, safe_vec, lines, msgs);
        }
        Expr::Closure(_, b, _) => {
            pr_stmts(b, wrapping, safe_idx, safe_vec, lines, msgs);
        }
        // BG130: f-string parts (`f"{v[i]}"`), named arguments and yield.
        Expr::FString(parts) => {
            var pi: i64 = 0;
            while pi < parts.len() {
                match parts.get(pi) {
                    FStringPart::Expr(px) => {
                        pr_expr(px, wrapping, safe_idx, safe_vec, line, lines, msgs);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                pi = pi + 1;
            }
        }
        Expr::NamedArg(_, x) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        Expr::Yield(x) => {
            pr_expr(box_expr_deref(x), wrapping, safe_idx, safe_vec, line, lines, msgs);
        }
        _ => {
        }
    }
}

pub fn scan_for_division(stmts: Vec<Stmt>, sites: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_division(stmts.get(i), sites);
        i = i + 1;
    }
}

// BG150: `x /= d` and `x %= d` divide like `x / d`; a non-zero integer
// literal divisor is safe, as for the binary operator
fn scan_assign_op_for_division(op: AssignOp, expr: Expr, sites: &mut Vec<str>) {
    var op_str: str = "";
    match op {
        AssignOp::DivAssign => {
            op_str = "/";
        }
        AssignOp::ModAssign => {
            op_str = "%";
        }
        _ => {
        }
    }
    if str_len(op_str) == 0 {
        return;
    }
    match expr {
        Expr::IntLit(n) => {
            if n != 0 {
                return;
            }
        }
        _ => {
        }
    }
    sites.push(op_str);
}

pub fn scan_stmt_for_division(stmt: Stmt, sites: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => {
            scan_expr_for_division(expr, sites);
        }
        Stmt::LetTuple(_, expr, _) => {
            scan_expr_for_division(expr, sites);
        }
        Stmt::Expr(e, _) => {
            scan_expr_for_division(e, sites);
        }
        Stmt::Assign(_, aop, expr, _) => {
            scan_assign_op_for_division(aop, expr, sites);
            scan_expr_for_division(expr, sites);
        }
        Stmt::IndexAssign(_, index, aop, expr, _) => {
            scan_expr_for_division(index, sites);
            scan_assign_op_for_division(aop, expr, sites);
            scan_expr_for_division(expr, sites);
        }
        Stmt::DerefAssign(ptr_expr, aop, expr, _) => {
            scan_expr_for_division(ptr_expr, sites);
            scan_assign_op_for_division(aop, expr, sites);
            scan_expr_for_division(expr, sites);
        }
        Stmt::FieldAssign(object, _, aop, expr, _) => {
            scan_expr_for_division(object, sites);
            scan_assign_op_for_division(aop, expr, sites);
            scan_expr_for_division(expr, sites);
        }
        Stmt::Return(opt_e, _) => {
            match opt_e {
                OptBoxExpr::Some(e) => {
                    scan_expr_for_division(box_expr_unbox(e), sites);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            scan_expr_for_division(cond, sites);
            scan_stmts_for_division(then_block, sites);
            match else_block {
                OptStmts::Some(eb) => {
                    scan_stmts_for_division(eb, sites);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(cond, body, _) => {
            scan_expr_for_division(cond, sites);
            scan_stmts_for_division(body, sites);
        }
        Stmt::For(_, iterator, body, _) => {
            scan_expr_for_division(iterator, sites);
            scan_stmts_for_division(body, sites);
        }
        Stmt::Loop(body, _) => {
            scan_stmts_for_division(body, sites);
        }
        Stmt::Defer(stmts, _) => {
            scan_stmts_for_division(stmts, sites);
        }
        Stmt::Match(expr, arms, _) => {
            scan_expr_for_division(expr, sites);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_division(arms.get(ai).body, sites);
                ai = ai + 1;
            }
        }
        Stmt::Handle(body, handlers, _) => {
            scan_stmts_for_division(body, sites);
            var hi: i64 = 0;
            while hi < handlers.len() {
                scan_stmts_for_division(handlers.get(hi).body, sites);
                hi = hi + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            scan_stmts_for_division(body, sites);
        }
        Stmt::Sandbox(body, _) => {
            scan_stmts_for_division(body, sites);
        }
        Stmt::Unsafe(body, _) => {
            scan_stmts_for_division(body, sites);
        }
        Stmt::Txn(body, _) => {
            scan_stmts_for_division(body, sites);
        }
        Stmt::ComptimeGen(block, _) => {
            scan_stmts_for_division(block, sites);
        }
        Stmt::GradBlock(_, body, _) => {
            scan_stmts_for_division(body, sites);
        }
        Stmt::Backward(loss, _) => {
            scan_expr_for_division(loss, sites);
        }
        _ => {
        }
    }
}

pub fn scan_stmts_for_division(stmts: Vec<Stmt>, sites: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_division(stmts.get(i), sites);
        i = i + 1;
    }
}

pub fn scan_expr_for_division(expr: Expr, sites: &mut Vec<str>) {
    match expr {
        Expr::Binary(op, left, right) => {
            var is_div: bool = false;
            var op_str: str = "";
            match op {
                BinOp::Div => {
                    is_div = true;
                    op_str = "/";
                }
                BinOp::Mod => {
                    is_div = true;
                    op_str = "%";
                }
                _ => {
                }
            }
            if is_div {
                // Check if divisor is a non-zero constant — if so, it's safe
                var is_safe: bool = false;
                match box_expr_unbox(right) {
                    Expr::IntLit(n) => {
                        if n != 0 {
                            is_safe = true;
                        }
                    }
                    _ => {
                    }
                }
                if !is_safe {
                    sites.push(op_str);
                }
            }
            scan_expr_for_division(box_expr_unbox(left), sites);
            scan_expr_for_division(box_expr_unbox(right), sites);
        }
        Expr::Unary(_, e) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::Call(_, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_division(args.get(ai), sites);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            scan_expr_for_division(box_expr_unbox(receiver), sites);
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_division(args.get(ai), sites);
                ai = ai + 1;
            }
        }
        Expr::FieldAccess(e, _) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::OptionalFieldAccess(e, _) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::Index(array, index) => {
            scan_expr_for_division(box_expr_unbox(array), sites);
            scan_expr_for_division(box_expr_unbox(index), sites);
        }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                scan_expr_for_division(fields.get(fi).value, sites);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => {
                    scan_expr_for_division(box_expr_unbox(s), sites);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::ArrayLit(_, elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                scan_expr_for_division(elements.get(ei), sites);
                ei = ei + 1;
            }
        }
        Expr::TupleLit(elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                scan_expr_for_division(elements.get(ei), sites);
                ei = ei + 1;
            }
        }
        Expr::Ref(e, _) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::Deref(e) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::Cast(e, _) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::If(cond, then_block, else_block) => {
            scan_expr_for_division(box_expr_unbox(cond), sites);
            scan_stmts_for_division(then_block, sites);
            match else_block {
                OptStmts::Some(eb) => {
                    scan_stmts_for_division(eb, sites);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Block(stmts) => {
            scan_stmts_for_division(stmts, sites);
        }
        Expr::Match(expr, arms) => {
            scan_expr_for_division(box_expr_unbox(expr), sites);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_division(arms.get(ai).body, sites);
                ai = ai + 1;
            }
        }
        Expr::StrConcat(left, right) => {
            scan_expr_for_division(box_expr_unbox(left), sites);
            scan_expr_for_division(box_expr_unbox(right), sites);
        }
        Expr::Try(e) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::Coalesce(expr, default) => {
            scan_expr_for_division(box_expr_unbox(expr), sites);
            scan_expr_for_division(box_expr_unbox(default), sites);
        }
        Expr::IsCheck(e, _) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::TryBlock(body) => {
            scan_stmts_for_division(body, sites);
        }
        Expr::Closure(_, body, _) => {
            scan_stmts_for_division(body, sites);
        }
        Expr::Comptime(e) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::ComptimeBlock(stmts) => {
            scan_stmts_for_division(stmts, sites);
        }
        Expr::PipeForward(left, right) => {
            scan_expr_for_division(box_expr_unbox(left), sites);
            scan_expr_for_division(box_expr_unbox(right), sites);
        }
        Expr::QuantCast(e, _) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        // BG130: enum payloads (`Option::Some(a / b)`), f-string parts,
        // named arguments, await, spawn and yield.
        Expr::EnumLit(_, _, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_division(args.get(ai), sites);
                ai = ai + 1;
            }
        }
        Expr::FString(parts) => {
            var pi: i64 = 0;
            while pi < parts.len() {
                match parts.get(pi) {
                    FStringPart::Expr(px) => {
                        scan_expr_for_division(px, sites);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                pi = pi + 1;
            }
        }
        Expr::NamedArg(_, e) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::Await(e) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::Spawn(e) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        Expr::Yield(e) => {
            scan_expr_for_division(box_expr_unbox(e), sites);
        }
        _ => {
        }
    }
}

// --- While loop scanning helpers ---

pub fn scan_for_while_loops(stmts: Vec<Stmt>, sites: &mut Vec<i64>) {
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_while(stmts.get(i), sites);
        i = i + 1;
    }
}

pub fn scan_stmt_for_while(stmt: Stmt, sites: &mut Vec<i64>) {
    match stmt {
        Stmt::While(cond, body, line) => {
            sites.push(line);
            scan_expr_for_while(cond, sites);
            scan_stmts_for_while(body, sites);
        }
        Stmt::If(cond, then_block, else_block, _) => {
            scan_expr_for_while(cond, sites);
            scan_stmts_for_while(then_block, sites);
            match else_block {
                OptStmts::Some(eb) => {
                    scan_stmts_for_while(eb, sites);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::For(_, iterator, body, _) => {
            scan_expr_for_while(iterator, sites);
            scan_stmts_for_while(body, sites);
        }
        Stmt::Loop(body, _) => {
            scan_stmts_for_while(body, sites);
        }
        Stmt::Defer(stmts, _) => {
            scan_stmts_for_while(stmts, sites);
        }
        Stmt::Match(expr, arms, _) => {
            scan_expr_for_while(expr, sites);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_while(arms.get(ai).body, sites);
                ai = ai + 1;
            }
        }
        Stmt::Handle(body, handlers, _) => {
            scan_stmts_for_while(body, sites);
            var hi: i64 = 0;
            while hi < handlers.len() {
                scan_stmts_for_while(handlers.get(hi).body, sites);
                hi = hi + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            scan_stmts_for_while(body, sites);
        }
        Stmt::Sandbox(body, _) => {
            scan_stmts_for_while(body, sites);
        }
        Stmt::Unsafe(body, _) => {
            scan_stmts_for_while(body, sites);
        }
        Stmt::Txn(body, _) => {
            scan_stmts_for_while(body, sites);
        }
        Stmt::ComptimeGen(block, _) => {
            scan_stmts_for_while(block, sites);
        }
        Stmt::GradBlock(_, body, _) => {
            scan_stmts_for_while(body, sites);
        }
        _ => {
        }
    }
}

pub fn scan_stmts_for_while(stmts: Vec<Stmt>, sites: &mut Vec<i64>) {
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_while(stmts.get(i), sites);
        i = i + 1;
    }
}

pub fn scan_expr_for_while(expr: Expr, sites: &mut Vec<i64>) {
    match expr {
        Expr::Binary(_, left, right) => {
            scan_expr_for_while(box_expr_unbox(left), sites);
            scan_expr_for_while(box_expr_unbox(right), sites);
        }
        Expr::Unary(_, e) => {
            scan_expr_for_while(box_expr_unbox(e), sites);
        }
        Expr::Call(_, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_while(args.get(ai), sites);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            scan_expr_for_while(box_expr_unbox(receiver), sites);
            var ai: i64 = 0;
            while ai < args.len() {
                scan_expr_for_while(args.get(ai), sites);
                ai = ai + 1;
            }
        }
        Expr::FieldAccess(e, _) => {
            scan_expr_for_while(box_expr_unbox(e), sites);
        }
        Expr::OptionalFieldAccess(e, _) => {
            scan_expr_for_while(box_expr_unbox(e), sites);
        }
        Expr::Index(array, index) => {
            scan_expr_for_while(box_expr_unbox(array), sites);
            scan_expr_for_while(box_expr_unbox(index), sites);
        }
        Expr::If(cond, then_block, else_block) => {
            scan_expr_for_while(box_expr_unbox(cond), sites);
            scan_stmts_for_while(then_block, sites);
            match else_block {
                OptStmts::Some(eb) => {
                    scan_stmts_for_while(eb, sites);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Block(stmts) => {
            scan_stmts_for_while(stmts, sites);
        }
        Expr::Match(expr, arms) => {
            scan_expr_for_while(box_expr_unbox(expr), sites);
            var ai: i64 = 0;
            while ai < arms.len() {
                scan_stmts_for_while(arms.get(ai).body, sites);
                ai = ai + 1;
            }
        }
        Expr::TryBlock(body) => {
            scan_stmts_for_while(body, sites);
        }
        Expr::Closure(_, body, _) => {
            scan_stmts_for_while(body, sites);
        }
        Expr::Comptime(e) => {
            scan_expr_for_while(box_expr_unbox(e), sites);
        }
        Expr::ComptimeBlock(stmts) => {
            scan_stmts_for_while(stmts, sites);
        }
        _ => {
        }
    }
}

pub fn TypeChecker_verify_constant_time(self: &mut TypeChecker, program: Program) {
    // @constant_time: constant-time execution (side-channel resistance).
    // Rejects IO/Net effects, calls to non-constant-time functions, early
    // returns, and branches, loops, short-circuits, memory indexing or
    // division that depend on secret data (every parameter not @public).
    var ct_names: Vec<str> = Vec::new();
    var ci: i64 = 0;
    while ci < program.funcs.len() {
        if ct_has_annotation(program.funcs.get(ci).annotations, "constant_time") {
            ct_names.push(program.funcs.get(ci).name);
        }
        ci = ci + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            if ct_has_annotation(imp.methods.get(mi).annotations, "constant_time") {
                ct_names.push(imp.struct_name + "_" + imp.methods.get(mi).name);
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if ct_has_annotation(func.annotations, "constant_time") {
            TypeChecker_ct_check_one(self, func, func.name, func.name, ct_names);
        }
        fi = fi + 1;
    }
    // BG21: an impl method marked @constant_time is held to the same rules
    // (its name `S.m`, its effects as compute_func_effects keeps them under
    // that name); before, only program.funcs were checked, so a method with
    // an early return on a secret was accepted
    var cii: i64 = 0;
    while cii < program.impls.len() {
        var cimp: ImplDef = program.impls.get(cii);
        var cmi: i64 = 0;
        while cmi < cimp.methods.len() {
            var cm: Func = cimp.methods.get(cmi);
            if ct_has_annotation(cm.annotations, "constant_time") {
                TypeChecker_ct_check_one(self, cm, cimp.struct_name + "." + cm.name, cimp.struct_name + "." + cm.name, ct_names);
            }
            cmi = cmi + 1;
        }
        cii = cii + 1;
    }
}

/// The @constant_time rules for one function or method: `label` names it in
/// the messages, `eff_key` is where its inferred effects are kept.
fn TypeChecker_ct_check_one(self: &mut TypeChecker, func: Func, label: str, eff_key: str, ct_names: Vec<str>) {
    var effects: Vec<str> = TypeChecker_get_func_effects(self, eff_key);
    var ei: i64 = 0;
    while ei < effects.len() {
        var eff: str = effects.get(ei);
        if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
            self.errors.push("Constant-time error: function '" + label + "' is @constant_time but has effect '!" + eff + "'");
        }
        ei = ei + 1;
    }
    // Only other @constant_time functions (and runtime builtins) may be called.
    var calls: Vec<str> = Vec::new();
    scan_stmts_for_calls(func.body, &mut calls);
    var ki: i64 = 0;
    while ki < calls.len() {
        var called: str = calls.get(ki);
        var is_user: bool = false;
        match TypeChecker_lookup_func_cache(self, called) {
            OptFuncSig::Some(_) => {
                is_user = true;
            }
            OptFuncSig::None => {
            }
        }
        if is_user && !str_vec_contains(ct_names, called) && !str_starts_with(called, "p_") && !str_starts_with(called, "__") {
            self.errors.push("Security error (constant_time): function '" + label + "' calls '" + called + "', which is not @constant_time.");
        }
        ki = ki + 1;
    }
    var ret_lines: Vec<i64> = Vec::new();
    ct_scan_early_returns(func.body, &mut ret_lines);
    var ri: i64 = 0;
    while ri < ret_lines.len() {
        self.errors.push("Security error (constant_time) (line " + int_to_str(ret_lines.get(ri)) + "): function '" + label + "' has an early return.");
        ri = ri + 1;
    }
    var out_lines: Vec<i64> = Vec::new();
    var out_msgs: Vec<str> = Vec::new();
    ct_secret_dependence(func, &mut out_lines, &mut out_msgs);
    var oi: i64 = 0;
    while oi < out_lines.len() {
        self.errors.push("Security error (constant_time) (line " + int_to_str(out_lines.get(oi)) + "): function '" + label + "' " + out_msgs.get(oi) + ".");
        oi = oi + 1;
    }
}

fn ct_has_annotation(anns: Vec<Annotation>, name: str) -> bool {
    var i: i64 = 0;
    while i < anns.len() {
        if anns.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Any `return` inside a branch or loop, or before the last statement.
fn ct_scan_early_returns(stmts: Vec<Stmt>, lines: &mut Vec<i64>) {
    var i: i64 = 0;
    while i < stmts.len() {
        var s: Stmt = stmts.get(i);
        match s {
            Stmt::Return(_, line) => {
                if i < stmts.len() - 1 {
                    lines.push(line);
                }
            }
            _ => {
                ct_scan_nested_returns(s, lines);
            }
        }
        i = i + 1;
    }
}

fn ct_scan_nested_returns(s: Stmt, lines: &mut Vec<i64>) {
    match s {
        Stmt::Return(_, line) => {
            lines.push(line);
        }
        Stmt::If(_, then_block, else_block, _) => {
            ct_scan_nested_returns_all(then_block, lines);
            match else_block {
                OptStmts::Some(b) => {
                    ct_scan_nested_returns_all(b, lines);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Match(_, arms, _) => {
            var ai: i64 = 0;
            while ai < arms.len() {
                ct_scan_nested_returns_all(arms.get(ai).body, lines);
                ai = ai + 1;
            }
        }
        Stmt::For(_, _, body, _) => {
            ct_scan_nested_returns_all(body, lines);
        }
        Stmt::While(_, body, _) => {
            ct_scan_nested_returns_all(body, lines);
        }
        Stmt::Loop(body, _) => {
            ct_scan_nested_returns_all(body, lines);
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            ct_scan_nested_returns_all(body, lines);
        }
        Stmt::Sandbox(body, _) => {
            ct_scan_nested_returns_all(body, lines);
        }
        Stmt::Unsafe(body, _) => {
            ct_scan_nested_returns_all(body, lines);
        }
        Stmt::Txn(body, _) => {
            ct_scan_nested_returns_all(body, lines);
        }
        _ => {
        }
    }
}

fn ct_scan_nested_returns_all(stmts: Vec<Stmt>, lines: &mut Vec<i64>) {
    var i: i64 = 0;
    while i < stmts.len() {
        ct_scan_nested_returns(stmts.get(i), lines);
        i = i + 1;
    }
}

// Secret-dependent timing: one (line, what) per branch, loop, short-circuit,
// memory index or division whose operand depends on a parameter not marked
// @public. Lengths (`x.len()`) are public.
fn ct_secret_dependence(func: Func, out_lines: &mut Vec<i64>, out_msgs: &mut Vec<str>) {
    var secret: Vec<str> = Vec::new();
    var pi: i64 = 0;
    while pi < func.params.len() {
        var p: Param = func.params.get(pi);
        if !ct_has_annotation(p.annotations, "public") {
            secret.push(p.name);
        }
        pi = pi + 1;
    }
    // Values computed from secrets are secret (flow-insensitive, to a fixpoint).
    var before: i64 = -1;
    while before != secret.len() {
        before = secret.len();
        ct_propagate(func.body, &mut secret);
    }
    ct_check_stmts(func.body, secret, out_lines, out_msgs);
}

fn ct_mark(secret: &mut Vec<str>, name: str) {
    if !str_vec_contains(secret, name) {
        secret.push(name);
    }
}

// Whether `e` mentions a secret variable outside a length query.
fn ct_secret(e: Expr, secret: Vec<str>) -> bool {
    match e {
        Expr::Ident(n) => {
            return str_vec_contains(secret, n);
        }
        Expr::MethodCall(recv, method, args) => {
            if method == "len" {
                return false;
            }
            return ct_secret(box_expr_deref(recv), secret) || ct_any_secret(args, secret);
        }
        Expr::Call(callee, args) => {
            if callee == "len" || str_ends_with(callee, "_len") {
                return false;
            }
            return ct_any_secret(args, secret);
        }
        Expr::Binary(_, l, r) => {
            return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret);
        }
        Expr::StrConcat(l, r) => {
            return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret);
        }
        Expr::Range(l, r, _) => {
            return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret);
        }
        Expr::Coalesce(l, r) => {
            return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret);
        }
        Expr::PipeForward(l, r) => {
            return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret);
        }
        Expr::Index(l, r) => {
            return ct_secret(box_expr_deref(l), secret) || ct_secret(box_expr_deref(r), secret);
        }
        Expr::Unary(_, x) => {
            return ct_secret(box_expr_deref(x), secret);
        }
        Expr::FieldAccess(x, _) => {
            return ct_secret(box_expr_deref(x), secret);
        }
        Expr::OptionalFieldAccess(x, _) => {
            return ct_secret(box_expr_deref(x), secret);
        }
        Expr::Ref(x, _) => {
            return ct_secret(box_expr_deref(x), secret);
        }
        Expr::Deref(x) => {
            return ct_secret(box_expr_deref(x), secret);
        }
        Expr::Try(x) => {
            return ct_secret(box_expr_deref(x), secret);
        }
        Expr::IsCheck(x, _) => {
            return ct_secret(box_expr_deref(x), secret);
        }
        Expr::Cast(x, _) => {
            return ct_secret(box_expr_deref(x), secret);
        }
        Expr::QuantCast(x, _) => {
            return ct_secret(box_expr_deref(x), secret);
        }
        Expr::Await(x) => {
            return ct_secret(box_expr_deref(x), secret);
        }
        Expr::Spawn(x) => {
            return ct_secret(box_expr_deref(x), secret);
        }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                if ct_secret(fields.get(fi).value, secret) {
                    return true;
                }
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(sp) => {
                    return ct_secret(box_expr_deref(sp), secret);
                }
                OptBoxExpr::None => {
                }
            }
            return false;
        }
        Expr::EnumLit(_, _, args) => {
            return ct_any_secret(args, secret);
        }
        Expr::TupleLit(args) => {
            return ct_any_secret(args, secret);
        }
        Expr::ArrayLit(_, args) => {
            return ct_any_secret(args, secret);
        }
        Expr::If(cond, then_block, else_block) => {
            if ct_secret(box_expr_deref(cond), secret) || ct_stmts_secret(then_block, secret) {
                return true;
            }
            match else_block {
                OptStmts::Some(b) => {
                    return ct_stmts_secret(b, secret);
                }
                OptStmts::None => {
                }
            }
            return false;
        }
        Expr::Match(x, arms) => {
            if ct_secret(box_expr_deref(x), secret) {
                return true;
            }
            var ai: i64 = 0;
            while ai < arms.len() {
                if ct_stmts_secret(arms.get(ai).body, secret) {
                    return true;
                }
                ai = ai + 1;
            }
            return false;
        }
        Expr::Block(b) => {
            return ct_stmts_secret(b, secret);
        }
        Expr::TryBlock(b) => {
            return ct_stmts_secret(b, secret);
        }
        Expr::Closure(_, b, _) => {
            return ct_stmts_secret(b, secret);
        }
        Expr::FString(parts) => {
            var pi: i64 = 0;
            while pi < parts.len() {
                var part: FStringPart = parts.get(pi);
                match part {
                    FStringPart::Expr(x2) => {
                        if ct_secret(x2, secret) {
                            return true;
                        }
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                pi = pi + 1;
            }
            return false;
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn ct_any_secret(es: Vec<Expr>, secret: Vec<str>) -> bool {
    var i: i64 = 0;
    while i < es.len() {
        if ct_secret(es.get(i), secret) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Whether the value of `stmts` (their last expression) mentions a secret.
fn ct_stmts_secret(stmts: Vec<Stmt>, secret: Vec<str>) -> bool {
    if stmts.len() == 0 {
        return false;
    }
    match stmts.get(stmts.len() - 1) {
        Stmt::Expr(e, _) => {
            return ct_secret(e, secret);
        }
        _ => {
            return false;
        }
    }
    return false;
}

// The variable a place expression writes into ("" for none).
fn ct_base(e: Expr) -> str {
    match e {
        Expr::Ident(n) => {
            return n;
        }
        Expr::FieldAccess(x, _) => {
            return ct_base(box_expr_deref(x));
        }
        Expr::Deref(x) => {
            return ct_base(box_expr_deref(x));
        }
        Expr::Index(x, _) => {
            return ct_base(box_expr_deref(x));
        }
        _ => {
            return "";
        }
    }
    return "";
}

fn ct_propagate(stmts: Vec<Stmt>, secret: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        var s: Stmt = stmts.get(i);
        match s {
            Stmt::Let(name, _, expr, _, _, _, _) => {
                if ct_secret(expr, secret) {
                    ct_mark(secret, name);
                }
            }
            Stmt::LetTuple(names, expr, _) => {
                if ct_secret(expr, secret) {
                    var ni: i64 = 0;
                    while ni < names.len() {
                        ct_mark(secret, names.get(ni));
                        ni = ni + 1;
                    }
                }
            }
            Stmt::Assign(target, _, expr, _) => {
                if ct_secret(expr, secret) {
                    ct_mark(secret, target);
                }
            }
            Stmt::IndexAssign(array, index, _, expr, _) => {
                if ct_secret(expr, secret) || ct_secret(index, secret) {
                    ct_mark(secret, array);
                }
            }
            Stmt::FieldAssign(object, _, _, expr, _) => {
                if ct_secret(expr, secret) && ct_base(object) != "" {
                    ct_mark(secret, ct_base(object));
                }
            }
            Stmt::DerefAssign(ptr_expr, _, expr, _) => {
                if ct_secret(expr, secret) && ct_base(ptr_expr) != "" {
                    ct_mark(secret, ct_base(ptr_expr));
                }
            }
            Stmt::Expr(e, _) => {
                // A mutating method stores its arguments in its receiver.
                match e {
                    Expr::MethodCall(recv, method, args) => {
                        var rb: str = ct_base(box_expr_deref(recv));
                        if method != "len" && ct_any_secret(args, secret) && rb != "" {
                            ct_mark(secret, rb);
                        }
                    }
                    _ => {
                    }
                }
            }
            Stmt::For(var_name, iterator, body, _) => {
                if ct_secret(iterator, secret) {
                    ct_mark(secret, var_name);
                }
                ct_propagate(body, secret);
            }
            Stmt::Match(expr, arms, _) => {
                var sm: bool = ct_secret(expr, secret);
                var ai: i64 = 0;
                while ai < arms.len() {
                    var arm: MatchArm = arms.get(ai);
                    if sm {
                        match arm.pattern {
                            Pattern::Ident(n) => {
                                ct_mark(secret, n);
                            }
                            Pattern::EnumVariant(_, _, bindings) => {
                                var bi: i64 = 0;
                                while bi < bindings.len() {
                                    ct_mark(secret, bindings.get(bi).name);
                                    bi = bi + 1;
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    ct_propagate(arm.body, secret);
                    ai = ai + 1;
                }
            }
            Stmt::If(_, then_block, else_block, _) => {
                ct_propagate(then_block, secret);
                match else_block {
                    OptStmts::Some(b) => {
                        ct_propagate(b, secret);
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(_, body, _) => {
                ct_propagate(body, secret);
            }
            Stmt::Loop(body, _) => {
                ct_propagate(body, secret);
            }
            Stmt::Unsafe(body, _) => {
                ct_propagate(body, secret);
            }
            Stmt::Sandbox(body, _) => {
                ct_propagate(body, secret);
            }
            Stmt::Txn(body, _) => {
                ct_propagate(body, secret);
            }
            Stmt::RegionBlock(_, _, _, _, _, body, _) => {
                ct_propagate(body, secret);
            }
            Stmt::Defer(body, _) => {
                ct_propagate(body, secret);
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

fn ct_push(out_lines: &mut Vec<i64>, out_msgs: &mut Vec<str>, line: i64, what: str) {
    var i: i64 = 0;
    while i < out_lines.len() {
        if out_lines.get(i) == line && out_msgs.get(i) == what {
            return;
        }
        i = i + 1;
    }
    out_lines.push(line);
    out_msgs.push(what);
}

fn ct_check_stmts(stmts: Vec<Stmt>, secret: Vec<str>, out_lines: &mut Vec<i64>, out_msgs: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        var s: Stmt = stmts.get(i);
        var line: i64 = stmt_line(s);
        match s {
            Stmt::If(cond, then_block, else_block, _) => {
                if ct_secret(cond, secret) {
                    ct_push(out_lines, out_msgs, line, "branches on secret data (`if`)");
                }
                ct_check_expr(cond, secret, line, out_lines, out_msgs);
                ct_check_stmts(then_block, secret, out_lines, out_msgs);
                match else_block {
                    OptStmts::Some(b) => {
                        ct_check_stmts(b, secret, out_lines, out_msgs);
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(cond, body, _) => {
                if ct_secret(cond, secret) {
                    ct_push(out_lines, out_msgs, line, "loops on secret data (`while` condition)");
                }
                ct_check_expr(cond, secret, line, out_lines, out_msgs);
                ct_check_stmts(body, secret, out_lines, out_msgs);
            }
            Stmt::For(_, iterator, body, _) => {
                if ct_secret(iterator, secret) {
                    ct_push(out_lines, out_msgs, line, "loops over secret data (`for`)");
                }
                ct_check_expr(iterator, secret, line, out_lines, out_msgs);
                ct_check_stmts(body, secret, out_lines, out_msgs);
            }
            Stmt::Match(expr, arms, _) => {
                if ct_secret(expr, secret) {
                    ct_push(out_lines, out_msgs, line, "branches on secret data (`match`)");
                }
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
                var ai: i64 = 0;
                while ai < arms.len() {
                    ct_check_stmts(arms.get(ai).body, secret, out_lines, out_msgs);
                    ai = ai + 1;
                }
            }
            Stmt::IndexAssign(target, index, aop, expr, _) => {
                if ct_secret(index, secret) {
                    ct_push(out_lines, out_msgs, line, "indexes memory with secret data");
                }
                if ct_assign_divides(aop, ct_secret(Expr::Ident(target), secret), expr, secret) {
                    ct_push(out_lines, out_msgs, line, "divides secret data (`/` or `%` take variable time on most CPUs)");
                }
                ct_check_expr(index, secret, line, out_lines, out_msgs);
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
            }
            Stmt::Let(_, _, expr, _, _, _, _) => {
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
            }
            Stmt::LetTuple(_, expr, _) => {
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
            }
            Stmt::Assign(target, aop, expr, _) => {
                if ct_assign_divides(aop, ct_secret(Expr::Ident(target), secret), expr, secret) {
                    ct_push(out_lines, out_msgs, line, "divides secret data (`/` or `%` take variable time on most CPUs)");
                }
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
            }
            Stmt::Expr(expr, _) => {
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
            }
            Stmt::Return(value, _) => {
                match value {
                    OptBoxExpr::Some(e) => {
                        ct_check_expr(box_expr_deref(e), secret, line, out_lines, out_msgs);
                    }
                    OptBoxExpr::None => {
                    }
                }
            }
            Stmt::Break(value, _) => {
                match value {
                    OptBoxExpr::Some(e) => {
                        ct_check_expr(box_expr_deref(e), secret, line, out_lines, out_msgs);
                    }
                    OptBoxExpr::None => {
                    }
                }
            }
            Stmt::FieldAssign(object, _, aop, expr, _) => {
                if ct_assign_divides(aop, ct_secret(object, secret), expr, secret) {
                    ct_push(out_lines, out_msgs, line, "divides secret data (`/` or `%` take variable time on most CPUs)");
                }
                ct_check_expr(object, secret, line, out_lines, out_msgs);
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
            }
            Stmt::DerefAssign(ptr_expr, aop, expr, _) => {
                if ct_assign_divides(aop, ct_secret(ptr_expr, secret), expr, secret) {
                    ct_push(out_lines, out_msgs, line, "divides secret data (`/` or `%` take variable time on most CPUs)");
                }
                ct_check_expr(ptr_expr, secret, line, out_lines, out_msgs);
                ct_check_expr(expr, secret, line, out_lines, out_msgs);
            }
            Stmt::Loop(body, _) => {
                ct_check_stmts(body, secret, out_lines, out_msgs);
            }
            Stmt::Unsafe(body, _) => {
                ct_check_stmts(body, secret, out_lines, out_msgs);
            }
            Stmt::Sandbox(body, _) => {
                ct_check_stmts(body, secret, out_lines, out_msgs);
            }
            Stmt::Txn(body, _) => {
                ct_check_stmts(body, secret, out_lines, out_msgs);
            }
            Stmt::RegionBlock(_, _, _, _, _, body, _) => {
                ct_check_stmts(body, secret, out_lines, out_msgs);
            }
            Stmt::Defer(body, _) => {
                ct_check_stmts(body, secret, out_lines, out_msgs);
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

// BG150: `x /= k` / `x %= k` divide the target by `k`, as `x = x / k` does
fn ct_assign_divides(op: AssignOp, target_secret: bool, expr: Expr, secret: Vec<str>) -> bool {
    var div: bool = false;
    match op {
        AssignOp::DivAssign => {
            div = true;
        }
        AssignOp::ModAssign => {
            div = true;
        }
        _ => {
        }
    }
    return div && (target_secret || ct_secret(expr, secret));
}

fn ct_check_exprs(es: Vec<Expr>, secret: Vec<str>, line: i64, out_lines: &mut Vec<i64>, out_msgs: &mut Vec<str>) {
    var i: i64 = 0;
    while i < es.len() {
        ct_check_expr(es.get(i), secret, line, out_lines, out_msgs);
        i = i + 1;
    }
}

fn ct_check_expr(e: Expr, secret: Vec<str>, line: i64, out_lines: &mut Vec<i64>, out_msgs: &mut Vec<str>) {
    match e {
        Expr::Binary(op, l, r) => {
            var left: Expr = box_expr_deref(l);
            var right: Expr = box_expr_deref(r);
            var either: bool = ct_secret(left, secret) || ct_secret(right, secret);
            if either {
                match op {
                    BinOp::And => {
                        ct_push(out_lines, out_msgs, line, "short-circuits on secret data (`&&`/`||`; use `&`/`|`)");
                    }
                    BinOp::Or => {
                        ct_push(out_lines, out_msgs, line, "short-circuits on secret data (`&&`/`||`; use `&`/`|`)");
                    }
                    BinOp::Div => {
                        ct_push(out_lines, out_msgs, line, "divides secret data (`/` or `%` take variable time on most CPUs)");
                    }
                    BinOp::Mod => {
                        ct_push(out_lines, out_msgs, line, "divides secret data (`/` or `%` take variable time on most CPUs)");
                    }
                    _ => {
                    }
                }
            }
            ct_check_expr(left, secret, line, out_lines, out_msgs);
            ct_check_expr(right, secret, line, out_lines, out_msgs);
        }
        Expr::Index(a, x) => {
            var index: Expr = box_expr_deref(x);
            if ct_secret(index, secret) {
                ct_push(out_lines, out_msgs, line, "indexes memory with secret data");
            }
            ct_check_expr(box_expr_deref(a), secret, line, out_lines, out_msgs);
            ct_check_expr(index, secret, line, out_lines, out_msgs);
        }
        Expr::MethodCall(recv, method, args) => {
            var indexes: bool = method == "get" || method == "set" || method == "remove" || method == "insert" || method == "get_or";
            if indexes && args.len() > 0 && ct_secret(args.get(0), secret) {
                ct_push(out_lines, out_msgs, line, "indexes memory with secret data");
            }
            ct_check_expr(box_expr_deref(recv), secret, line, out_lines, out_msgs);
            ct_check_exprs(args, secret, line, out_lines, out_msgs);
        }
        Expr::If(cond, then_block, else_block) => {
            var c: Expr = box_expr_deref(cond);
            if ct_secret(c, secret) {
                ct_push(out_lines, out_msgs, line, "branches on secret data (`if`)");
            }
            ct_check_expr(c, secret, line, out_lines, out_msgs);
            ct_check_stmts(then_block, secret, out_lines, out_msgs);
            match else_block {
                OptStmts::Some(b) => {
                    ct_check_stmts(b, secret, out_lines, out_msgs);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Match(x, arms) => {
            var scrut: Expr = box_expr_deref(x);
            if ct_secret(scrut, secret) {
                ct_push(out_lines, out_msgs, line, "branches on secret data (`match`)");
            }
            ct_check_expr(scrut, secret, line, out_lines, out_msgs);
            var ai: i64 = 0;
            while ai < arms.len() {
                ct_check_stmts(arms.get(ai).body, secret, out_lines, out_msgs);
                ai = ai + 1;
            }
        }
        Expr::Unary(_, x) => {
            ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs);
        }
        Expr::FieldAccess(x, _) => {
            ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs);
        }
        Expr::OptionalFieldAccess(x, _) => {
            ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs);
        }
        Expr::Ref(x, _) => {
            ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs);
        }
        Expr::Deref(x) => {
            ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs);
        }
        Expr::Try(x) => {
            ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs);
        }
        Expr::IsCheck(x, _) => {
            ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs);
        }
        Expr::Cast(x, _) => {
            ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs);
        }
        Expr::QuantCast(x, _) => {
            ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs);
        }
        Expr::Await(x) => {
            ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs);
        }
        Expr::Spawn(x) => {
            ct_check_expr(box_expr_deref(x), secret, line, out_lines, out_msgs);
        }
        Expr::StrConcat(l, r) => {
            ct_check_expr(box_expr_deref(l), secret, line, out_lines, out_msgs);
            ct_check_expr(box_expr_deref(r), secret, line, out_lines, out_msgs);
        }
        Expr::Range(l, r, _) => {
            ct_check_expr(box_expr_deref(l), secret, line, out_lines, out_msgs);
            ct_check_expr(box_expr_deref(r), secret, line, out_lines, out_msgs);
        }
        Expr::Coalesce(l, r) => {
            ct_check_expr(box_expr_deref(l), secret, line, out_lines, out_msgs);
            ct_check_expr(box_expr_deref(r), secret, line, out_lines, out_msgs);
        }
        Expr::PipeForward(l, r) => {
            ct_check_expr(box_expr_deref(l), secret, line, out_lines, out_msgs);
            ct_check_expr(box_expr_deref(r), secret, line, out_lines, out_msgs);
        }
        Expr::Call(_, args) => {
            ct_check_exprs(args, secret, line, out_lines, out_msgs);
        }
        Expr::EnumLit(_, _, args) => {
            ct_check_exprs(args, secret, line, out_lines, out_msgs);
        }
        Expr::TupleLit(args) => {
            ct_check_exprs(args, secret, line, out_lines, out_msgs);
        }
        Expr::ArrayLit(_, args) => {
            ct_check_exprs(args, secret, line, out_lines, out_msgs);
        }
        Expr::StructLit(_, fields, _) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                ct_check_expr(fields.get(fi).value, secret, line, out_lines, out_msgs);
                fi = fi + 1;
            }
        }
        Expr::Block(b) => {
            ct_check_stmts(b, secret, out_lines, out_msgs);
        }
        Expr::TryBlock(b) => {
            ct_check_stmts(b, secret, out_lines, out_msgs);
        }
        Expr::Closure(_, b, _) => {
            ct_check_stmts(b, secret, out_lines, out_msgs);
        }
        _ => {
        }
    }
}

/// Calls forbidden in @realtime code: allocation, blocking IO, spawning,
/// dynamic dispatch (the lists of src/typechecker.rs verify_realtime).
fn tc_rt_forbidden_call(c: str) -> bool {
    var names: str = " p_malloc p_malloc_uninit p_str_alloc_uninit p_free p_realloc p_alloc p_vec_new p_vec_push p_vec_push_str p_vec_insert p_vec_resize p_vec_extend p_hashmap_new p_hashmap_insert p_string_new p_string_push p_string_concat p_arena_new p_arena_alloc Vec_new Vec_push Vec_insert Vec_resize HashMap_new HashMap_insert String_new String_push push insert resize extend push_str p_file_read p_file_write p_file_open p_file_close p_socket_listen p_socket_accept p_socket_read p_socket_write p_socket_connect p_socket_close p_net_connect p_net_listen p_net_accept p_fs_read_async p_fs_write_async p_print p_print_int p_print_str p_eprint_str p_print_nl print println print_str print_nl print_int p_db_open p_db_query p_db_exec p_sleep p_usleep p_thread_spawn p_chan_send p_chan_recv p_executor_submit p_future_ready spawn p_make_dyn p_call_ptr p_dyn_call ";
    return str_contains(names, " " + c + " ");
}

pub fn TypeChecker_verify_realtime(self: &mut TypeChecker, program: Program) {
    // @realtime: real-time deadline guarantee
    // Rejects IO/Net/Spawn effects that could block indefinitely.
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_rt: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "realtime" {
                is_rt = true;
            }
            ai = ai + 1;
        }
        if is_rt {
            TypeChecker_realtime_one(self, func, func.name);
        }
        fi = fi + 1;
    }
    // BG22: an impl method marked @realtime (its effects under
    // `Type.method`); only free functions were checked
    var rii: i64 = 0;
    while rii < program.impls.len() {
        var rimp: ImplDef = program.impls.get(rii);
        var rmi: i64 = 0;
        while rmi < rimp.methods.len() {
            var rm: Func = rimp.methods.get(rmi);
            if tc_has_annotation(rm.annotations, "realtime") {
                TypeChecker_realtime_one(self, rm, rimp.struct_name + "." + rm.name);
            }
            rmi = rmi + 1;
        }
        rii = rii + 1;
    }
}

/// The @realtime rules for one function or method, named `label` (also
/// where its effects are kept).
fn TypeChecker_realtime_one(self: &mut TypeChecker, func: Func, label: str) {
    var effects: Vec<str> = TypeChecker_get_func_effects(self, label);
    var ei: i64 = 0;
    while ei < effects.len() {
        var eff: str = effects.get(ei);
        if eff == "IO" || eff == "Net" || eff == "Spawn" {
            self.errors.push("Realtime error: function '" + label + "' is @realtime but has effect '!" + eff + "' which may block");
        }
        ei = ei + 1;
    }
    // Calls that allocate, block, spawn, dispatch dynamically or
    // recurse (src/typechecker.rs verify_realtime rules 1-5).
    var calls: Vec<str> = Vec::new();
    scan_stmts_for_calls(func.body, &mut calls);
    var while_sites: Vec<i64> = Vec::new();
    scan_for_while_loops(func.body, &mut while_sites);
    if while_sites.len() > 0 {
        self.errors.push("Real-time error: function '" + label + "' contains a 'while' loop. While loops have unbounded iteration counts.");
    }
    var reported: Vec<str> = Vec::new();
    var ci: i64 = 0;
    while ci < calls.len() {
        var c: str = calls.get(ci);
        if !tc_str_vec_contains(reported, c) && (tc_rt_forbidden_call(c) || c == func.name) {
            reported.push(c);
            if c == func.name {
                self.errors.push("Real-time error: function '" + label + "' calls itself. Recursion has unbounded stack depth.");
            } else {
                self.errors.push("Real-time error: function '" + label + "' calls '" + c + "'.");
            }
        }
        ci = ci + 1;
    }
}

pub fn TypeChecker_verify_differentiable(self: &mut TypeChecker, program: Program) {
    // @differentiable: autodiff compatibility
    // Rejects IO/Net/Spawn/Diverge effects that break the computation graph.
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_diff: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "differentiable" {
                is_diff = true;
            }
            ai = ai + 1;
        }
        if is_diff {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Differentiability error: function '" + func.name + "' is @differentiable but has effect '!" + eff + "'");
                }
                ei = ei + 1;
            }
        }
        fi = fi + 1;
    }
}

/// The body of the function or (unmangled) method `name`, if any.
fn tc_body_by_name(program: Program, name: str, out: &mut Vec<StmtList>) -> bool {
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        if program.funcs.get(fi).name == name {
            out.push(program.funcs.get(fi).body);
            return true;
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            if imp.methods.get(mi).name == name {
                out.push(imp.methods.get(mi).body);
                return true;
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(ti);
        var tmi: i64 = 0;
        while tmi < timp.methods.len() {
            if timp.methods.get(tmi).name == name {
                out.push(timp.methods.get(tmi).body);
                return true;
            }
            tmi = tmi + 1;
        }
        ti = ti + 1;
    }
    return false;
}

/// Whether `start` reaches dequantize_q8 through calls (src/typechecker.rs).
fn tc_transitively_calls_dequant(program: Program, start: str) -> bool {
    var visited: Vec<str> = Vec::new();
    var stack: Vec<str> = Vec::new();
    stack.push(start);
    while stack.len() > 0 {
        var cur: str = stack.pop();
        if !tc_str_vec_contains(visited, cur) {
            visited.push(cur);
            var body: Vec<StmtList> = Vec::new();
            if tc_body_by_name(program, cur, &mut body) {
                var calls: Vec<str> = Vec::new();
                scan_stmts_for_calls(body.get(0), &mut calls);
                var ci: i64 = 0;
                while ci < calls.len() {
                    var c: str = calls.get(ci);
                    if c == "dequantize_q8" || c == "p_dequantize_q8" {
                        return true;
                    }
                    stack.push(c);
                    ci = ci + 1;
                }
            }
        }
    }
    return false;
}

pub fn TypeChecker_verify_quantized(self: &mut TypeChecker, program: Program) {
    // @quantized: quantization annotation
    // Rejects IO/Net/Spawn/Diverge effects (same as @differentiable).
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_quant: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "quantized" {
                is_quant = true;
            }
            ai = ai + 1;
        }
        if is_quant {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Quantization error: function '" + func.name + "' is @quantized but has effect '!" + eff + "'");
                }
                ei = ei + 1;
            }
            // Dequantizing inside a @quantized function defeats it.
            if tc_transitively_calls_dequant(program, func.name) {
                self.errors.push("Quantization error: function '" + func.name + "' is @quantized but (transitively) calls dequantize_q8.");
            }
        }
        fi = fi + 1;
    }
}

fn tc_anns_have(anns: Vec<Annotation>, name: str) -> bool {
    var i: i64 = 0;
    while i < anns.len() {
        if anns.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn TypeChecker_verify_checkpoint(self: &mut TypeChecker, program: Program) {
    // @checkpoint: gradient checkpointing
    // A @checkpoint function must also be @differentiable.
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_checkpoint: bool = false;
        var is_differentiable: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            var ann_name: str = func.annotations.get(ai).name;
            if ann_name == "checkpoint" {
                is_checkpoint = true;
            }
            if ann_name == "differentiable" {
                is_differentiable = true;
            }
            ai = ai + 1;
        }
        if is_checkpoint && !is_differentiable {
            self.errors.push("Checkpoint error: function '" + func.name + "' is @checkpoint but not @differentiable");
        }
        // Recompute in the backward pass must give the same values.
        if is_checkpoint && !tc_anns_have(func.annotations, "deterministic") {
            self.errors.push("Checkpoint error: function '" + func.name + "' is @checkpoint but not @deterministic. Fix: add @deterministic annotation to '" + func.name + "'.");
        }
        fi = fi + 1;
    }
}

pub fn TypeChecker_verify_dp(self: &mut TypeChecker, program: Program) {
    // @dp: differential privacy
    // Rejects IO/Net/Spawn/Diverge effects.
    // Also validates epsilon values and composes epsilon across @dp callees.

    // Parse epsilon from @dp(epsilon=N) annotation.
    var dp_names: Vec<str> = Vec::new();
    var dp_epsilons: Vec<f64> = Vec::new();
    var dp_call_names: Vec<str> = Vec::new();
    var dp_call_offsets: Vec<i64> = Vec::new();
    var dp_call_flat: Vec<str> = Vec::new();

    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_dp: bool = false;
        var epsilon: f64 = 0.0;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            var ann: Annotation = func.annotations.get(ai);
            if ann.name == "dp" {
                is_dp = true;
                // Parse epsilon=N from args (simple parser — handles N.M format)
                var argi: i64 = 0;
                while argi < ann.args.len() {
                    var arg: str = ann.args.get(argi);
                    if str_starts_with(arg, "epsilon=") {
                        var val_str: str = str_slice(arg, 8, str_len(arg));
                        epsilon = dp_parse_float(val_str);
                    }
                    argi = argi + 1;
                }
            }
            ai = ai + 1;
        }
        if is_dp {
            // Validate epsilon is positive
            if epsilon <= 0.0 {
                self.errors.push("Differential privacy error: function '" + func.name + "' has @dp(epsilon=" + float_to_str(epsilon) + ") — epsilon must be positive");
            }
            dp_names.push(func.name);
            dp_epsilons.push(epsilon);
        }
        // Build call graph entry for this function
        var calls: Vec<str> = Vec::new();
        scan_stmts_for_calls(func.body, &mut calls);
        dp_call_names.push(func.name);
        dp_call_offsets.push(dp_call_flat.len());
        var ci: i64 = 0;
        while ci < calls.len() {
            dp_call_flat.push(calls.get(ci));
            ci = ci + 1;
        }

        // Check effects
        if is_dp {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            // DP needs noise added to the data/gradients.
            if !str_vec_contains_ref(effects, "Noise") {
                self.errors.push("Differential privacy error: function '" + func.name + "' is @dp but has no '!Noise' effect.");
            }
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("DP error: function '" + func.name + "' is @dp but has effect '!" + eff + "'");
                }
                ei = ei + 1;
            }
        }
        fi = fi + 1;
    }

    // Epsilon composition: for each @dp function, compute total epsilon
    // (own + transitive @dp callees) and reject if it exceeds declared.
    var nri: i64 = 0;
    while nri < dp_names.len() {
        var target: str = dp_names.get(nri);
        var declared: f64 = dp_epsilons.get(nri);
        // DFS to sum epsilon of all @dp callees reachable from target
        var visited: Vec<str> = Vec::new();
        var total: f64 = dp_compute_total_epsilon(target, dp_names, dp_epsilons, dp_call_names, dp_call_offsets, dp_call_flat, &mut visited);
        if total > declared {
            self.errors.push("Differential privacy error: function '" + target + "' declares @dp(epsilon=" + float_to_str(declared) + ") but total epsilon across @dp callees is " + float_to_str(total));
        }
        nri = nri + 1;
    }
}

// Simple float parser for DP epsilon values (handles N.M format).
fn dp_parse_float(s: str) -> f64 {
    var result: f64 = 0.0;
    var i: i64 = 0;
    var negative: bool = false;
    if str_len(s) > 0 && str_byte_at(s, 0) == 45 {
        negative = true;
        i = 1;
    }
    var int_part: f64 = 0.0;
    while i < str_len(s) {
        var b: i64 = str_byte_at(s, i);
        if b >= 48 && b <= 57 {
            int_part = int_part * 10.0 + (b - 48) as f64;
        } else {
            i = i + 1;
            break;
        }
        i = i + 1;
    }
    var frac_part: f64 = 0.0;
    var frac_div: f64 = 10.0;
    while i < str_len(s) {
        var b: i64 = str_byte_at(s, i);
        if b >= 48 && b <= 57 {
            frac_part = frac_part + (b - 48) as f64 / frac_div;
            frac_div = frac_div * 10.0;
        } else {
            break;
        }
        i = i + 1;
    }
    result = int_part + frac_part;
    if negative {
        result = -result;
    }
    return result;
}

// Compute total epsilon (own + transitive @dp callees) via DFS.
fn dp_compute_total_epsilon(target: str, dp_names: Vec<str>, dp_epsilons: Vec<f64>, cg_names: Vec<str>, cg_offsets: Vec<i64>, cg_calls: Vec<str>, visited: &mut Vec<str>) -> f64 {
    // Check if already visited (cycle)
    var vi: i64 = 0;
    while vi < visited.len() {
        if visited.get(vi) == target {
            return 0.0;
        }
        vi = vi + 1;
    }
    visited.push(target);

    // Find target's epsilon
    var own: f64 = 0.0;
    var found: bool = false;
    var ni: i64 = 0;
    while ni < dp_names.len() {
        if dp_names.get(ni) == target {
            own = dp_epsilons.get(ni);
            found = true;
            ni = dp_names.len();
        }
        ni = ni + 1;
    }

    // Find target's callees in the call graph
    var target_idx: i64 = -1;
    ni = 0;
    while ni < cg_names.len() {
        if cg_names.get(ni) == target {
            target_idx = ni;
        }
        ni = ni + 1;
    }
    if target_idx < 0 {
        return own;
    }

    var start: i64 = cg_offsets.get(target_idx);
    var end: i64 = 0;
    if target_idx + 1 < cg_offsets.len() {
        end = cg_offsets.get(target_idx + 1);
    } else {
        end = cg_calls.len();
    }

    var callee_eps: f64 = 0.0;
    var ci: i64 = start;
    while ci < end {
        var callee: str = cg_calls.get(ci);
        // Only sum if callee is a @dp function
        var is_dp: bool = false;
        ni = 0;
        while ni < dp_names.len() {
            if dp_names.get(ni) == callee {
                is_dp = true;
            }
            ni = ni + 1;
        }
        if is_dp {
            callee_eps = callee_eps + dp_compute_total_epsilon(callee, dp_names, dp_epsilons, cg_names, cg_offsets, cg_calls, visited);
        }
        ci = ci + 1;
    }

    return own + callee_eps;
}

pub fn TypeChecker_verify_shard(self: &mut TypeChecker, program: Program) {
    // @shard: tensor parallelism
    // Rejects IO/Net/Spawn/Diverge effects.
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_shard: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "shard" {
                is_shard = true;
            }
            ai = ai + 1;
        }
        if is_shard {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            if !str_vec_contains_ref(effects, "Comm") {
                self.errors.push("Shard error: function '" + func.name + "' is @shard but has no '!Comm' effect.");
            }
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Diverge" {
                    self.errors.push("Shard error: function '" + func.name + "' is @shard but has effect '!" + eff + "'");
                }
                ei = ei + 1;
            }
        }
        fi = fi + 1;
    }
}

pub fn TypeChecker_verify_adapter(self: &mut TypeChecker, program: Program) {
    // @adapter: adapter pattern (ML model adaptation)
    // A @adapter function must have at least one parameter (the base model).
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_adapter: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "adapter" {
                is_adapter = true;
            }
            ai = ai + 1;
        }
        if is_adapter {
            if func.params.len() == 0 {
                self.errors.push("Adapter error: function '" + func.name + "' is @adapter but has no parameters");
            }
        }
        fi = fi + 1;
    }
}

/// Whether a type is, or holds, a @scoped struct (release M11).
pub fn TypeChecker_mentions_scoped(self: &TypeChecker, t: Type) -> bool {
    match t {
        Type::Named(n) => {
            return str_vec_contains(self.scoped_structs, n);
        }
        Type::Generic(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                if TypeChecker_mentions_scoped(self, args.get(i)) {
                    return true;
                }
                i = i + 1;
            }
        }
        Type::Ref(inner, _) => {
            return TypeChecker_mentions_scoped(self, box_type_unbox(inner));
        }
        Type::Array(e, _) => {
            return TypeChecker_mentions_scoped(self, box_type_unbox(e));
        }
        Type::Tuple(ts) => {
            var j: i64 = 0;
            while j < ts.len() {
                if TypeChecker_mentions_scoped(self, ts.get(j)) {
                    return true;
                }
                j = j + 1;
            }
        }
        _ => {
        }
    }
    return false;
}

/// A @scoped struct lives only for its scope (release M11): it may be a
/// parameter or a local, never a field, a global, an element type or a
/// function result, so nothing keeps it (or the strings it borrows) longer.
pub fn TypeChecker_verify_scoped(self: &mut TypeChecker, program: Program) {
    if self.scoped_structs.len() == 0 {
        return;
    }
    var si: i64 = 0;
    while si < program.structs.len() {
        var sd: StructDef = program.structs.get(si);
        var fi: i64 = 0;
        while fi < sd.fields.len() {
            if TypeChecker_mentions_scoped(self, sd.fields.get(fi).ty) {
                self.errors.push("Borrow error: field '" + sd.fields.get(fi).name + "' of struct '" + sd.name + "' holds a @scoped struct, which cannot be kept.");
            }
            fi = fi + 1;
        }
        si = si + 1;
    }
    var gi: i64 = 0;
    while gi < program.globals.len() {
        if TypeChecker_mentions_scoped(self, program.globals.get(gi).ty) {
            self.errors.push("Borrow error: global '" + program.globals.get(gi).name + "' holds a @scoped struct, which cannot be kept.");
        }
        gi = gi + 1;
    }
    var fni: i64 = 0;
    while fni < program.funcs.len() {
        var f: Func = program.funcs.get(fni);
        if TypeChecker_mentions_scoped(self, f.ret_ty) {
            self.errors.push("Borrow error: function '" + f.name + "' returns a @scoped struct, which cannot outlive its scope.");
        }
        var pi: i64 = 0;
        while pi < f.params.len() {
            match f.params.get(pi).ty {
                Type::Generic(_, _) => {
                    if TypeChecker_mentions_scoped(self, f.params.get(pi).ty) {
                        self.errors.push("Borrow error: parameter '" + f.params.get(pi).name + "' of '" + f.name + "' holds @scoped structs in a collection, which cannot be kept.");
                    }
                }
                _ => {
                }
            }
            pi = pi + 1;
        }
        fni = fni + 1;
    }
}

pub fn TypeChecker_verify_tainted(self: &mut TypeChecker, program: Program) {
    // @tainted on a function: taint tracking by effect (the function must
    // not do IO or Net at all). @tainted on a parameter: data-flow taint
    // tracking (rm-P12, tf_* below): the parameter's value must not reach a
    // sink before a sanitizer. (Release L1 made a @tainted parameter taint
    // the whole function; the data-flow check rejects only real flows.)
    // tf_global_empty, not a TfGlobal literal: TfGlobal is declared below,
    // and the stage-0 compiler (fidesc) parses a struct literal only of a
    // type it has already seen (release A4)
    var gl: TfGlobal = tf_global_empty();
    var gl_made: bool = false;
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var is_tainted: bool = false;
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            if func.annotations.get(ai).name == "tainted" {
                is_tainted = true;
            }
            ai = ai + 1;
        }
        if is_tainted {
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" {
                    self.errors.push("Taint error: function '" + func.name + "' is @tainted but has effect '!" + eff + "' which could leak tainted data");
                }
                ei = ei + 1;
            }
        } else {
            var pi: i64 = 0;
            while pi < func.params.len() {
                if tf_has_ann(func.params.get(pi).annotations, "tainted") {
                    if !gl_made {
                        gl = tf_global_new(program);
                        gl_made = true;
                    }
                    var ts: Vec<bool> = Vec::new();
                    var pj: i64 = 0;
                    while pj < func.params.len() {
                        ts.push(pj == pi);
                        pj = pj + 1;
                    }
                    var r: TfResult = tf_analyze(&mut gl, func, ts);
                    var pname: str = func.params.get(pi).name;
                    var hi: i64 = 0;
                    while hi < r.hits.len() {
                        self.errors.push("Taint error: function '" + func.name + "' is @tainted: its parameter '" + pname + "' reaches the sink " + r.hits.get(hi) + " without passing through a sanitizer.\n    Untrusted input must be cleaned before it reaches output, files, the network,\n    processes, SQL/shell/HTML builders or a @sink function.\n    Fix: pass it through a @sanitizer function (or sql_escape, html_escape,\n    shell_escape, path_normalize) first.");
                        hi = hi + 1;
                    }
                    if r.ret {
                        self.errors.push("Taint error: function '" + func.name + "' is @tainted: it returns a value derived from its parameter '" + pname + "' without a sanitizer.\n    The caller would receive untrusted data that looks clean.\n    Fix: sanitize the value before returning it, or mark the function @tainted.");
                    }
                }
                pi = pi + 1;
            }
        }
        fi = fi + 1;
    }
}

// ─── rm-P12: data-flow taint propagation ─────────────────────────────────
// Port of src/typechecker.rs verify_taint_propagation. A @tainted parameter
// starts tainted. Taint flows through let and assignment (a plain
// assignment outside any branch or loop replaces the variable's taint;
// inside one it adds to it), through every expression form, into a
// variable that a tainted value is stored in (`v.push(t)`, `o.f = t`,
// `a[i] = t`), and through calls: a user function is analysed with the
// taint of its arguments (memoised per function and argument mask) and its
// result is tainted if a tainted parameter reaches its return. A sanitizer
// (a function marked @sanitizer, or sql_escape, html_escape, shell_escape,
// path_normalize, sanitize, ...) returns a clean value. A tainted value
// passed to a sink (output, files, the network, processes, SQL/shell/HTML
// builders, or a function marked @sink) is an error, also when the sink is
// reached inside a callee. Branching on a tainted value does not taint
// what the branch does (taint is about integrity, not secrecy: @secret is
// compiler/secrecy.fd). A call to a function marked @tainted is a source.

pub struct TfResult {
    pub ret: bool,
    pub hits: Vec<str>,
}

pub struct TfGlobal {
    pub funcs: Vec<Func>,
    pub index: i64,
    // HashMap: function name -> index + 1 into funcs
    pub memo: i64,
    // HashMap: "name:mask" -> index + 1 into memo_ret / memo_hits
    pub memo_ret: Vec<bool>,
    pub memo_hits: Vec<Vec<str>>,
}

pub struct TfCtx {
    pub func: str,
    pub names: Vec<str>,
    pub taint: Vec<bool>,
    pub depth: i64,
    pub ret: bool,
    pub hits: Vec<str>,
}

fn tf_global_new(program: Program) -> TfGlobal {
    var index: i64 = HashMap_new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        if HashMap_get(index, program.funcs.get(i).name) == 0 {
            HashMap_insert(index, program.funcs.get(i).name, i + 1);
        }
        i = i + 1;
    }
    return TfGlobal {
        funcs: program.funcs, index: index, memo: HashMap_new(), memo_ret: Vec::new(), memo_hits: Vec::new()
    };
}

/// A TfGlobal with no functions, maps or memo (TypeChecker_verify_tainted
/// makes the real one only when a function needs it).
fn tf_global_empty() -> TfGlobal {
    return TfGlobal {
        funcs: Vec::new(), index: 0, memo: 0, memo_ret: Vec::new(), memo_hits: Vec::new()
    };
}

fn tf_has_ann(anns: Vec<Annotation>, name: str) -> bool {
    var i: i64 = 0;
    while i < anns.len() {
        if anns.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn tf_is_sanitizer_name(name: str) -> bool {
    return name == "sql_escape" || name == "shell_escape" || name == "html_escape" || name == "path_normalize" || name == "sanitize" || name == "sanitize_input" || name == "escape_html" || name == "escape_sql" || name == "escape_shell" || name == "normalize_path";
}

/// A builtin or library call that must not receive a tainted value.
fn tf_is_sink_name(name: str) -> bool {
    if name == "print" || name == "println" || name == "eprint" || name == "eprintln" || name == "print_int" || name == "print_str" || name == "print_float" || name == "write_file" || name == "append_file" || name == "log_info" || name == "log_warn" || name == "log_error" || name == "log_debug" {
        return true;
    }
    if name == "sql_query" || name == "sql_literal" || name == "db_query" || name == "db_exec" || name == "process_system" || name == "shell_cmd" || name == "html_literal" || name == "file_read" || name == "file_write" || name == "file_append" {
        return true;
    }
    if str_starts_with(name, "p_") {
        return str_starts_with(name, "p_print") || str_starts_with(name, "p_eprint") || str_starts_with(name, "p_println") || str_starts_with(name, "p_write") || str_starts_with(name, "p_file_") || str_starts_with(name, "p_fs_write") || str_starts_with(name, "p_dir_") || str_starts_with(name, "p_socket_") || str_starts_with(name, "p_unix_") || str_starts_with(name, "p_net_") || str_starts_with(name, "p_http_") || str_starts_with(name, "p_tls_") || str_starts_with(name, "p_dns_") || str_starts_with(name, "p_process_") || name == "p_system" || name == "p_spawn_process" || name == "p_mkdir" || name == "p_rename" || name == "p_remove" || name == "p_chan_send" || name == "p_dlopen" || name == "p_dlsym";
    }
    return false;
}

/// Methods that read their receiver without storing their arguments in it.
fn tf_read_only_method(name: str) -> bool {
    return name == "get" || name == "len" || name == "is_empty" || name == "contains" || name == "index_of" || name == "find" || name == "starts_with" || name == "ends_with" || name == "first" || name == "last" || name == "eq" || name == "cmp" || name == "compare" || name == "to_str" || name == "to_string" || name == "clone" || name == "get_or" || name == "contains_key" || name == "find_opt" || name == "position_opt" || name == "take" || name == "skip" || name == "zip" || name == "enumerate" || name == "flat_map" || name == "chunk" || name == "window" || name == "contains_val";
}

fn tf_lookup(ctx: &TfCtx, name: str) -> i64 {
    var i: i64 = ctx.names.len() - 1;
    while i >= 0 {
        if ctx.names.get(i) == name {
            return i;
        }
        i = i - 1;
    }
    return 0 - 1;
}

fn tf_var(ctx: &TfCtx, name: str) -> bool {
    var i: i64 = tf_lookup(ctx, name);
    if i < 0 {
        return false;
    }
    return ctx.taint.get(i);
}

fn tf_bind(ctx: &mut TfCtx, name: str, t: bool) {
    ctx.names.push(name);
    ctx.taint.push(t);
}

/// `name = <t>`: a plain assignment at the top level of the function
/// replaces the taint; under a branch or loop (or for `+=` and the like)
/// it can only add to it.
fn tf_assign(ctx: &mut TfCtx, name: str, t: bool, strong: bool) {
    var i: i64 = tf_lookup(ctx, name);
    if i < 0 {
        if t {
            tf_bind(ctx, name, true);
        }
        return;
    }
    if strong && ctx.depth == 0 {
        ctx.taint.set(i, t);
    } else if t {
        ctx.taint.set(i, true);
    }
}

fn tf_truncate(ctx: &mut TfCtx, mark: i64) {
    while ctx.names.len() > mark {
        ctx.names.pop();
        ctx.taint.pop();
    }
}

fn tf_hit(ctx: &mut TfCtx, what: str) {
    if !str_vec_contains(ctx.hits, what) {
        ctx.hits.push(what);
    }
}

/// The variable a place expression stores into (`v`, `v.f`, `v[i]`, `*v`).
fn tf_base_var(e: Expr) -> str {
    match e {
        Expr::Ident(n) => {
            return n;
        }
        Expr::FieldAccess(b, _) => {
            return tf_base_var(box_expr_unbox(b));
        }
        Expr::Index(b, _) => {
            return tf_base_var(box_expr_unbox(b));
        }
        Expr::Deref(b) => {
            return tf_base_var(box_expr_unbox(b));
        }
        _ => {
            return "";
        }
    }
}

/// Analyse `f` with the taint `ts` of its arguments.
fn tf_analyze(gl: &mut TfGlobal, f: Func, ts: Vec<bool>) -> TfResult {
    var key: str = f.name + ":";
    var i: i64 = 0;
    while i < f.params.len() {
        if i < ts.len() && ts.get(i) {
            key = key + "1";
        } else {
            key = key + "0";
        }
        i = i + 1;
    }
    var slot: i64 = HashMap_get(gl.memo, key);
    if slot != 0 {
        return TfResult {
            ret: gl.memo_ret.get(slot - 1), hits: gl.memo_hits.get(slot - 1)
        };
    }
    // While `f` is being analysed (recursion), a call to it with the same
    // mask is assumed to return its taint and to reach no sink itself.
    gl.memo_ret.push(true);
    gl.memo_hits.push(Vec::new());
    HashMap_insert(gl.memo, key, gl.memo_ret.len());
    var my: i64 = gl.memo_ret.len() - 1;
    var ctx: TfCtx = TfCtx {
        func: f.name, names: Vec::new(), taint: Vec::new(), depth: 0, ret: false, hits: Vec::new()
    };
    i = 0;
    while i < f.params.len() {
        tf_bind(&mut ctx, f.params.get(i).name, i < ts.len() && ts.get(i));
        i = i + 1;
    }
    if tf_stmts_last(gl, &mut ctx, f.body) {
        ctx.ret = true;
    }
    gl.memo_ret.set(my, ctx.ret);
    gl.memo_hits.set(my, ctx.hits);
    return TfResult {
        ret: ctx.ret, hits: ctx.hits
    };
}

fn tf_stmts(gl: &mut TfGlobal, ctx: &mut TfCtx, stmts: Vec<Stmt>) {
    var i: i64 = 0;
    while i < stmts.len() {
        tf_stmt(gl, ctx, stmts.get(i));
        i = i + 1;
    }
}

/// Walk statements; the taint of the last one if it is an expression (a
/// block's value).
fn tf_stmts_last(gl: &mut TfGlobal, ctx: &mut TfCtx, stmts: Vec<Stmt>) -> bool {
    var v: bool = false;
    var i: i64 = 0;
    while i < stmts.len() {
        var s: Stmt = stmts.get(i);
        if i == stmts.len() - 1 {
            match s {
                Stmt::Expr(e, _) => {
                    v = tf_expr(gl, ctx, e);
                }
                _ => {
                    tf_stmt(gl, ctx, s);
                }
            }
        } else {
            tf_stmt(gl, ctx, s);
        }
        i = i + 1;
    }
    return v;
}

/// A nested block (branch, loop body): its bindings end with it.
fn tf_block(gl: &mut TfGlobal, ctx: &mut TfCtx, stmts: Vec<Stmt>) -> bool {
    var mark: i64 = ctx.names.len();
    ctx.depth = ctx.depth + 1;
    var v: bool = tf_stmts_last(gl, ctx, stmts);
    ctx.depth = ctx.depth - 1;
    tf_truncate(ctx, mark);
    return v;
}

fn tf_opt_block(gl: &mut TfGlobal, ctx: &mut TfCtx, ob: OptStmts) -> bool {
    match ob {
        OptStmts::Some(b) => {
            return tf_block(gl, ctx, b);
        }
        OptStmts::None => {
            return false;
        }
    }
}

fn tf_bind_pattern(ctx: &mut TfCtx, p: Pattern, t: bool) {
    match p {
        Pattern::Ident(n) => {
            tf_bind(ctx, n, t);
        }
        Pattern::EnumVariant(_, _, bs) => {
            var i: i64 = 0;
            while i < bs.len() {
                tf_bind(ctx, bs.get(i).name, t);
                i = i + 1;
            }
        }
        _ => {
        }
    }
}

fn tf_arms(gl: &mut TfGlobal, ctx: &mut TfCtx, arms: Vec<MatchArm>, t: bool) -> bool {
    var v: bool = false;
    var ai: i64 = 0;
    while ai < arms.len() {
        var arm: MatchArm = arms.get(ai);
        var mark: i64 = ctx.names.len();
        ctx.depth = ctx.depth + 1;
        tf_bind_pattern(ctx, arm.pattern, t);
        match arm.guard {
            OptBoxExpr::Some(g) => {
                tf_expr(gl, ctx, box_expr_unbox(g));
            }
            OptBoxExpr::None => {
            }
        }
        if tf_stmts_last(gl, ctx, arm.body) {
            v = true;
        }
        ctx.depth = ctx.depth - 1;
        tf_truncate(ctx, mark);
        ai = ai + 1;
    }
    return v;
}

fn tf_stmt(gl: &mut TfGlobal, ctx: &mut TfCtx, s: Stmt) {
    match s {
        Stmt::Let(n, _, e, _, _, _, _) => {
            var t: bool = tf_expr(gl, ctx, e);
            tf_bind(ctx, n, t);
        }
        Stmt::LetTuple(ns, e, _) => {
            var t: bool = tf_expr(gl, ctx, e);
            var i: i64 = 0;
            while i < ns.len() {
                tf_bind(ctx, ns.get(i), t);
                i = i + 1;
            }
        }
        Stmt::LetUninit(n, _, _, _) => {
            tf_bind(ctx, n, false);
        }
        Stmt::Assign(n, op, e, _) => {
            var t: bool = tf_expr(gl, ctx, e);
            var strong: bool = false;
            match op {
                AssignOp::Assign => {
                    strong = true;
                }
                _ => {
                }
            }
            tf_assign(ctx, n, t, strong);
        }
        Stmt::IndexAssign(n, ix, _, e, _) => {
            var ti: bool = tf_expr(gl, ctx, ix);
            var t: bool = tf_expr(gl, ctx, e);
            if t || ti {
                tf_assign(ctx, n, true, false);
            }
        }
        Stmt::DerefAssign(pe, _, e, _) => {
            tf_expr(gl, ctx, pe);
            var t: bool = tf_expr(gl, ctx, e);
            var b: str = tf_base_var(pe);
            if t && b != "" {
                tf_assign(ctx, b, true, false);
            }
        }
        Stmt::FieldAssign(o, _, _, e, _) => {
            tf_expr(gl, ctx, o);
            var t: bool = tf_expr(gl, ctx, e);
            var b: str = tf_base_var(o);
            if t && b != "" {
                tf_assign(ctx, b, true, false);
            }
        }
        Stmt::Expr(e, _) => {
            tf_expr(gl, ctx, e);
        }
        Stmt::Return(oe, _) => {
            match oe {
                OptBoxExpr::Some(re) => {
                    if tf_expr(gl, ctx, box_expr_unbox(re)) {
                        ctx.ret = true;
                    }
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::Break(oe, _) => {
            match oe {
                OptBoxExpr::Some(be) => {
                    tf_expr(gl, ctx, box_expr_unbox(be));
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(c, tb, eb, _) => {
            tf_expr(gl, ctx, c);
            tf_block(gl, ctx, tb);
            tf_opt_block(gl, ctx, eb);
        }
        Stmt::While(c, b, _) => {
            // Twice: what one iteration taints, the next one reads.
            tf_expr(gl, ctx, c);
            tf_block(gl, ctx, b);
            tf_expr(gl, ctx, c);
            tf_block(gl, ctx, b);
        }
        Stmt::For(n, it, b, _) => {
            var t: bool = tf_expr(gl, ctx, it);
            var round: i64 = 0;
            while round < 2 {
                var mark: i64 = ctx.names.len();
                ctx.depth = ctx.depth + 1;
                tf_bind(ctx, n, t);
                tf_stmts(gl, ctx, b);
                ctx.depth = ctx.depth - 1;
                tf_truncate(ctx, mark);
                round = round + 1;
            }
        }
        Stmt::Loop(b, _) => {
            tf_block(gl, ctx, b);
            tf_block(gl, ctx, b);
        }
        Stmt::Defer(b, _) => {
            tf_block(gl, ctx, b);
        }
        Stmt::Match(e, arms, _) => {
            var t: bool = tf_expr(gl, ctx, e);
            tf_arms(gl, ctx, arms, t);
        }
        Stmt::Handle(b, _, _) => {
            tf_block(gl, ctx, b);
        }
        Stmt::Do(_, _, args, _) => {
            var i: i64 = 0;
            while i < args.len() {
                tf_expr(gl, ctx, args.get(i));
                i = i + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, b, _) => {
            tf_block(gl, ctx, b);
        }
        Stmt::Sandbox(b, _) => {
            tf_block(gl, ctx, b);
        }
        Stmt::Unsafe(b, _) => {
            tf_block(gl, ctx, b);
        }
        Stmt::Txn(b, _) => {
            tf_block(gl, ctx, b);
        }
        Stmt::GradBlock(_, b, _) => {
            tf_block(gl, ctx, b);
        }
        Stmt::SpawnScope(b, _) => {
            tf_block(gl, ctx, b);
        }
        Stmt::Parallel(bs, _) => {
            var i: i64 = 0;
            while i < bs.len() {
                tf_block(gl, ctx, bs.get(i));
                i = i + 1;
            }
        }
        _ => {
        }
    }
}

fn tf_exprs_any(gl: &mut TfGlobal, ctx: &mut TfCtx, es: Vec<Expr>) -> bool {
    var v: bool = false;
    var i: i64 = 0;
    while i < es.len() {
        if tf_expr(gl, ctx, es.get(i)) {
            v = true;
        }
        i = i + 1;
    }
    return v;
}

fn tf_expr2(gl: &mut TfGlobal, ctx: &mut TfCtx, a: Box<Expr>, b: Box<Expr>) -> bool {
    var ta: bool = tf_expr(gl, ctx, box_expr_unbox(a));
    var tb: bool = tf_expr(gl, ctx, box_expr_unbox(b));
    return ta || tb;
}

fn tf_expr(gl: &mut TfGlobal, ctx: &mut TfCtx, e: Expr) -> bool {
    match e {
        Expr::Ident(n) => {
            return tf_var(ctx, n);
        }
        Expr::Binary(_, l, r) => {
            return tf_expr2(gl, ctx, l, r);
        }
        Expr::StrConcat(l, r) => {
            return tf_expr2(gl, ctx, l, r);
        }
        Expr::Coalesce(l, r) => {
            return tf_expr2(gl, ctx, l, r);
        }
        Expr::Range(l, r, _) => {
            return tf_expr2(gl, ctx, l, r);
        }
        Expr::Index(l, r) => {
            return tf_expr2(gl, ctx, l, r);
        }
        Expr::Unary(_, x) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::FieldAccess(x, _) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::OptionalFieldAccess(x, _) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Ref(x, _) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Deref(x) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Try(x) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Cast(x, _) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::QuantCast(x, _) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Await(x) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::IsCheck(x, _) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Yield(x) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::NamedArg(_, x) => {
            return tf_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Spawn(x) => {
            // The spawned call's sinks are still checked; the task handle
            // carries no data.
            tf_expr(gl, ctx, box_expr_unbox(x));
            return false;
        }
        Expr::Call(callee, args) => {
            var ts: Vec<bool> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                ts.push(tf_expr(gl, ctx, args.get(i)));
                i = i + 1;
            }
            return tf_call(gl, ctx, callee, ts);
        }
        Expr::PipeForward(l, r) => {
            // `x |> f(a)` is `f(x, a)`
            var tl: bool = tf_expr(gl, ctx, box_expr_unbox(l));
            match box_expr_unbox(r) {
                Expr::Ident(f) => {
                    var ts: Vec<bool> = Vec::new();
                    ts.push(tl);
                    return tf_call(gl, ctx, f, ts);
                }
                Expr::Call(f, args) => {
                    var ts: Vec<bool> = Vec::new();
                    ts.push(tl);
                    var i: i64 = 0;
                    while i < args.len() {
                        ts.push(tf_expr(gl, ctx, args.get(i)));
                        i = i + 1;
                    }
                    return tf_call(gl, ctx, f, ts);
                }
                _ => {
                    var tr: bool = tf_expr(gl, ctx, box_expr_unbox(r));
                    return tl || tr;
                }
            }
        }
        Expr::MethodCall(recv, m, args) => {
            var rexpr: Expr = box_expr_unbox(recv);
            var rt: bool = tf_expr(gl, ctx, rexpr);
            var at: bool = tf_exprs_any(gl, ctx, args);
            if at && !tf_read_only_method(m) {
                // `v.push(t)`, `m.insert(k, t)`: the receiver now holds it
                var b: str = tf_base_var(rexpr);
                if b != "" {
                    tf_assign(ctx, b, true, false);
                }
            }
            return rt || at;
        }
        Expr::StructLit(_, fields, base) => {
            var v: bool = false;
            var i: i64 = 0;
            while i < fields.len() {
                if tf_expr(gl, ctx, fields.get(i).value) {
                    v = true;
                }
                i = i + 1;
            }
            match base {
                OptBoxExpr::Some(be) => {
                    if tf_expr(gl, ctx, box_expr_unbox(be)) {
                        v = true;
                    }
                }
                OptBoxExpr::None => {
                }
            }
            return v;
        }
        Expr::If(c, tb, eb) => {
            tf_expr(gl, ctx, box_expr_unbox(c));
            var a: bool = tf_block(gl, ctx, tb);
            var b: bool = tf_opt_block(gl, ctx, eb);
            return a || b;
        }
        Expr::Block(b) => {
            return tf_block(gl, ctx, b);
        }
        Expr::TryBlock(b) => {
            return tf_block(gl, ctx, b);
        }
        Expr::ArrayLit(_, es) => {
            return tf_exprs_any(gl, ctx, es);
        }
        Expr::TupleLit(es) => {
            return tf_exprs_any(gl, ctx, es);
        }
        Expr::EnumLit(_, _, es) => {
            return tf_exprs_any(gl, ctx, es);
        }
        Expr::FString(parts) => {
            var v: bool = false;
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(x) => {
                        if tf_expr(gl, ctx, x) {
                            v = true;
                        }
                    }
                    _ => {
                    }
                }
                i = i + 1;
            }
            return v;
        }
        Expr::Match(x, arms) => {
            var t: bool = tf_expr(gl, ctx, box_expr_unbox(x));
            return tf_arms(gl, ctx, arms, t);
        }
        _ => {
            return false;
        }
    }
}

/// A call with arguments of taint `ts`: the taint of its result.
fn tf_call(gl: &mut TfGlobal, ctx: &mut TfCtx, callee: str, ts: Vec<bool>) -> bool {
    var any: bool = false;
    var i: i64 = 0;
    while i < ts.len() {
        if ts.get(i) {
            any = true;
        }
        i = i + 1;
    }
    // A local function value: its result carries its arguments' taint.
    if tf_lookup(ctx, callee) >= 0 {
        return any;
    }
    var slot: i64 = HashMap_get(gl.index, callee);
    if slot != 0 {
        var anns: Vec<Annotation> = gl.funcs.get(slot - 1).annotations;
        if tf_has_ann(anns, "sanitizer") {
            return false;
        }
        if tf_has_ann(anns, "sink") {
            if any {
                var where1: str = "'" + callee + "' (in '" + ctx.func + "')";
                tf_hit(ctx, where1);
            }
            return false;
        }
    }
    if tf_is_sanitizer_name(callee) {
        return false;
    }
    if tf_is_sink_name(callee) {
        if any {
            var where2: str = "'" + callee + "' (in '" + ctx.func + "')";
            tf_hit(ctx, where2);
        }
        return false;
    }
    if slot == 0 {
        // A builtin that is not a sink: its result is derived from its
        // arguments.
        return any;
    }
    var f: Func = gl.funcs.get(slot - 1);
    if tf_has_ann(f.annotations, "tainted") {
        return true;
    }
    if !any {
        return false;
    }
    var r: TfResult = tf_analyze(gl, f, ts);
    var hi: i64 = 0;
    while hi < r.hits.len() {
        tf_hit(ctx, r.hits.get(hi));
        hi = hi + 1;
    }
    return r.ret;
}

// ─── CA4: lock order checked across the call graph ───────────────────────
// Every function gets a summary: the locks it takes (directly or through
// what it calls) and the order edges "holding A, it takes B". A lock is
// named by what the lock call receives: a global (`g:NAME`), a parameter
// (`p:i`, replaced by the caller's argument when the summary is applied at a
// call site) or a local (`l:fn:name`), with `.field` for a field of one. A
// lock taken while others are held adds an edge from each held lock. The
// edges between named locks of the whole program form a graph; a cycle in
// it (two paths that take the same locks in opposite orders) is a deadlock
// two threads can reach, and is a compile error naming the cycle.
// Lock calls: p_mutex_lock / sync_mutex_lock / sync_rwlock_read_lock /
// sync_rwlock_write_lock and their unlocks; with_lock(m, f) (and the
// rwlock forms) take m around the function f. A `spawn`ed call starts with
// no lock held. A branch or loop body that takes a lock without releasing
// it does not leave it held after the branch (the walk is per path).
// Summaries are recomputed round by round until none changes (a call uses
// the callee's summary as it stands); summaries only grow, a program
// without locks takes one round, and each round is linear in program size.

pub struct LoSum {
    pub acq: Vec<str>,
    pub efrom: Vec<str>,
    pub eto: Vec<str>,
    pub ewhere: Vec<str>,
}

pub struct LoGlobal {
    pub funcs: Vec<Func>,
    pub index: i64,
    // HashMap: function name -> index + 1 into funcs
    pub globals: i64,
    // HashMap: global or const name -> 1
    pub memo: i64,
    // (unused)
    pub sums: Vec<LoSum>,
    // one per function of funcs, by index
}

pub struct LoCtx {
    pub fname: str,
    pub params: Vec<str>,
    pub held: Vec<str>,
    pub line: i64,
    pub acq: Vec<str>,
    pub efrom: Vec<str>,
    pub eto: Vec<str>,
    pub ewhere: Vec<str>,
}

fn lo_acquire_name(c: str) -> bool {
    return c == "p_mutex_lock" || c == "sync_mutex_lock" || c == "sync_rwlock_write_lock" || c == "sync_rwlock_read_lock";
}

fn lo_release_name(c: str) -> bool {
    return c == "p_mutex_unlock" || c == "sync_mutex_unlock" || c == "sync_rwlock_write_unlock" || c == "sync_rwlock_read_unlock";
}

fn lo_with_lock_name(c: str) -> bool {
    return c == "with_lock" || c == "with_write_lock" || c == "with_read_lock";
}

fn lo_copy(v: Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(v.get(i));
        i = i + 1;
    }
    return out;
}

/// The name of the lock expression `e` in the current function ("" when it
/// is not a variable, a parameter, a global or a field of one).
fn lo_ref(gl: &LoGlobal, ctx: &LoCtx, e: Expr) -> str {
    match e {
        Expr::Ident(n) => {
            var i: i64 = 0;
            while i < ctx.params.len() {
                if ctx.params.get(i) == n {
                    return "p:" + int_to_str(i);
                }
                i = i + 1;
            }
            if HashMap_get(gl.globals, n) != 0 {
                return "g:" + n;
            }
            return "l:" + ctx.fname + ":" + n;
        }
        Expr::FieldAccess(b, f) => {
            var r: str = lo_ref(gl, ctx, box_expr_unbox(b));
            if r == "" {
                return "";
            }
            return r + "." + f;
        }
        Expr::Ref(b, _) => {
            return lo_ref(gl, ctx, box_expr_unbox(b));
        }
        _ => {
            return "";
        }
    }
}

/// A summary's lock name at a call site: `p:i...` becomes argument i's.
fn lo_inst(r: str, argrefs: Vec<str>) -> str {
    if !str_starts_with(r, "p:") {
        return r;
    }
    var len: i64 = str_len(r);
    var i: i64 = 2;
    var n: i64 = 0;
    while i < len {
        var c: i64 = str_byte_at(r, i);
        if c < 48 || c > 57 {
            break;
        }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if n >= argrefs.len() {
        return "";
    }
    var a: str = argrefs.get(n);
    if a == "" {
        return "";
    }
    return a + str_slice(r, i, len);
}

/// How a lock name reads in a message.
fn lo_show(r: str) -> str {
    if str_starts_with(r, "g:") {
        return "'" + str_slice(r, 2, str_len(r)) + "'";
    }
    if str_starts_with(r, "l:") {
        var rest: str = str_slice(r, 2, str_len(r));
        var k: i64 = str_find(rest, ":");
        if k >= 0 {
            return "'" + str_slice(rest, k + 1, str_len(rest)) + "' (a local of '" + str_slice(rest, 0, k) + "')";
        }
    }
    return "'" + r + "'";
}

fn lo_add_acq(ctx: &mut LoCtx, a: str) {
    if a != "" && !str_vec_contains(ctx.acq, a) {
        ctx.acq.push(a);
    }
}

fn lo_add_edge(ctx: &mut LoCtx, a: str, b: str, wh: str) {
    if a == "" || b == "" || a == b {
        return;
    }
    var i: i64 = 0;
    while i < ctx.efrom.len() {
        if ctx.efrom.get(i) == a && ctx.eto.get(i) == b {
            return;
        }
        i = i + 1;
    }
    ctx.efrom.push(a);
    ctx.eto.push(b);
    ctx.ewhere.push(wh);
}

fn lo_here(ctx: &LoCtx) -> str {
    return "'" + ctx.fname + "' (line " + int_to_str(ctx.line) + ")";
}

/// Taking lock `l`: an edge from every lock held.
fn lo_take(ctx: &mut LoCtx, l: str) {
    var wh: str = lo_here(ctx);
    var i: i64 = 0;
    while i < ctx.held.len() {
        var h: str = ctx.held.get(i);
        lo_add_edge(ctx, h, l, wh);
        i = i + 1;
    }
    lo_add_acq(ctx, l);
}

fn lo_release(ctx: &mut LoCtx, l: str) {
    var k: i64 = ctx.held.len() - 1;
    while k >= 0 {
        if ctx.held.get(k) == l {
            break;
        }
        k = k - 1;
    }
    if k < 0 {
        return;
    }
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < ctx.held.len() {
        if i != k {
            out.push(ctx.held.get(i));
        }
        i = i + 1;
    }
    ctx.held = out;
}

/// Recompute function fi's summary from its body and its callees' current
/// summaries; the number of locks and edges it now has.
fn lo_summary(gl: &mut LoGlobal, fi: i64) -> i64 {
    var f: Func = gl.funcs.get(fi);
    var params: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < f.params.len() {
        params.push(f.params.get(i).name);
        i = i + 1;
    }
    var ctx: LoCtx = LoCtx {
        fname: f.name, params: params, held: Vec::new(), line: 0, acq: Vec::new(), efrom: Vec::new(), eto: Vec::new(), ewhere: Vec::new()
    };
    lo_stmts(gl, &mut ctx, f.body);
    var size: i64 = ctx.acq.len() + ctx.efrom.len();
    gl.sums.set(fi, LoSum {
        acq: ctx.acq, efrom: ctx.efrom, eto: ctx.eto, ewhere: ctx.ewhere
    });
    return size;
}

/// Apply function fi's (current) summary at a call site with arguments
/// `args`.
fn lo_apply(gl: &mut LoGlobal, ctx: &mut LoCtx, fi: i64, args: Vec<Expr>, spawned: bool) {
    var sum: LoSum = gl.sums.get(fi);
    if sum.acq.len() == 0 && sum.efrom.len() == 0 {
        return;
    }
    var argrefs: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < args.len() {
        argrefs.push(lo_ref(gl, ctx, args.get(i)));
        i = i + 1;
    }
    var saved: Vec<str> = lo_copy(ctx.held);
    if spawned {
        ctx.held = Vec::new();
    }
    i = 0;
    while i < sum.acq.len() {
        var a: str = lo_inst(sum.acq.get(i), argrefs);
        if a != "" {
            lo_take(ctx, a);
        }
        i = i + 1;
    }
    var via: str = " called from " + lo_here(ctx);
    i = 0;
    while i < sum.efrom.len() {
        var x: str = lo_inst(sum.efrom.get(i), argrefs);
        var y: str = lo_inst(sum.eto.get(i), argrefs);
        var wh: str = sum.ewhere.get(i);
        if str_starts_with(sum.efrom.get(i), "p:") || str_starts_with(sum.eto.get(i), "p:") {
            // the locks are the caller's arguments: say which call
            wh = wh + via;
        }
        lo_add_edge(ctx, x, y, wh);
        i = i + 1;
    }
    ctx.held = saved;
}

fn lo_call(gl: &mut LoGlobal, ctx: &mut LoCtx, callee: str, args: Vec<Expr>, spawned: bool) {
    if lo_acquire_name(callee) {
        if args.len() > 0 && !spawned {
            var r: str = lo_ref(gl, ctx, args.get(0));
            if r != "" {
                lo_take(ctx, r);
                ctx.held.push(r);
            }
        }
        return;
    }
    if lo_release_name(callee) {
        if args.len() > 0 && !spawned {
            var r: str = lo_ref(gl, ctx, args.get(0));
            if r != "" {
                lo_release(ctx, r);
            }
        }
        return;
    }
    if lo_with_lock_name(callee) && args.len() >= 2 && !spawned {
        var r: str = lo_ref(gl, ctx, args.get(0));
        match args.get(1) {
            Expr::Ident(fname) => {
                var fs: i64 = HashMap_get(gl.index, fname);
                if r != "" && fs != 0 {
                    lo_take(ctx, r);
                    ctx.held.push(r);
                    lo_apply(gl, ctx, fs - 1, Vec::new(), false);
                    lo_release(ctx, r);
                }
            }
            _ => {
            }
        }
        return;
    }
    var slot: i64 = HashMap_get(gl.index, callee);
    if slot == 0 {
        return;
    }
    lo_apply(gl, ctx, slot - 1, args, spawned);
}

fn lo_stmts(gl: &mut LoGlobal, ctx: &mut LoCtx, stmts: Vec<Stmt>) {
    var i: i64 = 0;
    while i < stmts.len() {
        lo_stmt(gl, ctx, stmts.get(i));
        i = i + 1;
    }
}

/// A branch or loop body: what it leaves held does not outlive it.
fn lo_block(gl: &mut LoGlobal, ctx: &mut LoCtx, stmts: Vec<Stmt>) {
    var saved: Vec<str> = lo_copy(ctx.held);
    lo_stmts(gl, ctx, stmts);
    ctx.held = saved;
}

fn lo_opt_block(gl: &mut LoGlobal, ctx: &mut LoCtx, ob: OptStmts) {
    match ob {
        OptStmts::Some(b) => {
            lo_block(gl, ctx, b);
        }
        OptStmts::None => {
        }
    }
}

fn lo_opt_expr(gl: &mut LoGlobal, ctx: &mut LoCtx, oe: OptBoxExpr) {
    match oe {
        OptBoxExpr::Some(e) => {
            lo_expr(gl, ctx, box_expr_unbox(e));
        }
        OptBoxExpr::None => {
        }
    }
}

fn lo_stmt(gl: &mut LoGlobal, ctx: &mut LoCtx, s: Stmt) {
    ctx.line = stmt_line(s);
    match s {
        Stmt::Let(_, _, e, _, _, _, _) => {
            lo_expr(gl, ctx, e);
        }
        Stmt::LetTuple(_, e, _) => {
            lo_expr(gl, ctx, e);
        }
        Stmt::Assign(_, _, e, _) => {
            lo_expr(gl, ctx, e);
        }
        Stmt::IndexAssign(_, ix, _, e, _) => {
            lo_expr(gl, ctx, ix);
            lo_expr(gl, ctx, e);
        }
        Stmt::DerefAssign(pe, _, e, _) => {
            lo_expr(gl, ctx, pe);
            lo_expr(gl, ctx, e);
        }
        Stmt::FieldAssign(o, _, _, e, _) => {
            lo_expr(gl, ctx, o);
            lo_expr(gl, ctx, e);
        }
        Stmt::Expr(e, _) => {
            lo_expr(gl, ctx, e);
        }
        Stmt::Return(oe, _) => {
            lo_opt_expr(gl, ctx, oe);
        }
        Stmt::Break(oe, _) => {
            lo_opt_expr(gl, ctx, oe);
        }
        Stmt::If(c, tb, eb, _) => {
            lo_expr(gl, ctx, c);
            lo_block(gl, ctx, tb);
            lo_opt_block(gl, ctx, eb);
        }
        Stmt::While(c, b, _) => {
            lo_expr(gl, ctx, c);
            lo_block(gl, ctx, b);
        }
        Stmt::For(_, it, b, _) => {
            lo_expr(gl, ctx, it);
            lo_block(gl, ctx, b);
        }
        Stmt::Loop(b, _) => {
            lo_block(gl, ctx, b);
        }
        Stmt::Defer(b, _) => {
            lo_block(gl, ctx, b);
        }
        Stmt::Match(e, arms, _) => {
            lo_expr(gl, ctx, e);
            var ai: i64 = 0;
            while ai < arms.len() {
                lo_block(gl, ctx, arms.get(ai).body);
                ai = ai + 1;
            }
        }
        Stmt::Handle(b, _, _) => {
            lo_stmts(gl, ctx, b);
        }
        Stmt::RegionBlock(_, _, _, _, _, b, _) => {
            lo_stmts(gl, ctx, b);
        }
        Stmt::Sandbox(b, _) => {
            lo_stmts(gl, ctx, b);
        }
        Stmt::Unsafe(b, _) => {
            lo_stmts(gl, ctx, b);
        }
        Stmt::Txn(b, _) => {
            lo_stmts(gl, ctx, b);
        }
        Stmt::GradBlock(_, b, _) => {
            lo_stmts(gl, ctx, b);
        }
        Stmt::SpawnScope(b, _) => {
            lo_stmts(gl, ctx, b);
        }
        Stmt::Parallel(bs, _) => {
            // Each branch is its own thread: it starts with no lock held.
            var saved: Vec<str> = lo_copy(ctx.held);
            var i: i64 = 0;
            while i < bs.len() {
                ctx.held = Vec::new();
                lo_stmts(gl, ctx, bs.get(i));
                i = i + 1;
            }
            ctx.held = saved;
        }
        _ => {
        }
    }
}

fn lo_exprs(gl: &mut LoGlobal, ctx: &mut LoCtx, es: Vec<Expr>) {
    var i: i64 = 0;
    while i < es.len() {
        lo_expr(gl, ctx, es.get(i));
        i = i + 1;
    }
}

fn lo_expr(gl: &mut LoGlobal, ctx: &mut LoCtx, e: Expr) {
    match e {
        Expr::Call(c, args) => {
            lo_exprs(gl, ctx, args);
            lo_call(gl, ctx, c, args, false);
        }
        Expr::Spawn(x) => {
            match box_expr_unbox(x) {
                Expr::Call(c, args) => {
                    lo_exprs(gl, ctx, args);
                    lo_call(gl, ctx, c, args, true);
                }
                _ => {
                    lo_expr(gl, ctx, box_expr_unbox(x));
                }
            }
        }
        Expr::MethodCall(r, _, args) => {
            lo_expr(gl, ctx, box_expr_unbox(r));
            lo_exprs(gl, ctx, args);
        }
        Expr::Binary(_, l, r) => {
            lo_expr(gl, ctx, box_expr_unbox(l));
            lo_expr(gl, ctx, box_expr_unbox(r));
        }
        Expr::StrConcat(l, r) => {
            lo_expr(gl, ctx, box_expr_unbox(l));
            lo_expr(gl, ctx, box_expr_unbox(r));
        }
        Expr::Coalesce(l, r) => {
            lo_expr(gl, ctx, box_expr_unbox(l));
            lo_expr(gl, ctx, box_expr_unbox(r));
        }
        Expr::Index(l, r) => {
            lo_expr(gl, ctx, box_expr_unbox(l));
            lo_expr(gl, ctx, box_expr_unbox(r));
        }
        Expr::PipeForward(l, r) => {
            lo_expr(gl, ctx, box_expr_unbox(l));
            lo_expr(gl, ctx, box_expr_unbox(r));
        }
        Expr::Unary(_, x) => {
            lo_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::FieldAccess(x, _) => {
            lo_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Ref(x, _) => {
            lo_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Deref(x) => {
            lo_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Try(x) => {
            lo_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Cast(x, _) => {
            lo_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::Await(x) => {
            lo_expr(gl, ctx, box_expr_unbox(x));
        }
        Expr::StructLit(_, fields, _) => {
            var i: i64 = 0;
            while i < fields.len() {
                lo_expr(gl, ctx, fields.get(i).value);
                i = i + 1;
            }
        }
        Expr::If(c, tb, eb) => {
            lo_expr(gl, ctx, box_expr_unbox(c));
            lo_block(gl, ctx, tb);
            lo_opt_block(gl, ctx, eb);
        }
        Expr::Block(b) => {
            lo_stmts(gl, ctx, b);
        }
        Expr::Match(x, arms) => {
            lo_expr(gl, ctx, box_expr_unbox(x));
            var ai: i64 = 0;
            while ai < arms.len() {
                lo_block(gl, ctx, arms.get(ai).body);
                ai = ai + 1;
            }
        }
        Expr::ArrayLit(_, es) => {
            lo_exprs(gl, ctx, es);
        }
        Expr::TupleLit(es) => {
            lo_exprs(gl, ctx, es);
        }
        Expr::EnumLit(_, _, es) => {
            lo_exprs(gl, ctx, es);
        }
        _ => {
        }
    }
}

/// Depth-first search for a cycle among the order edges; the cycle's edge
/// indices go to `found`.
fn lo_dfs(n: i64, efrom: Vec<i64>, eto: Vec<i64>, color: &mut Vec<i64>, stack: &mut Vec<i64>, found: &mut Vec<i64>) -> bool {
    color.set(n, 1);
    var e: i64 = 0;
    while e < efrom.len() {
        if efrom.get(e) == n {
            var m: i64 = eto.get(e);
            if color.get(m) == 1 {
                stack.push(e);
                var k: i64 = stack.len() - 1;
                while k > 0 && efrom.get(stack.get(k)) != m {
                    k = k - 1;
                }
                while k < stack.len() {
                    found.push(stack.get(k));
                    k = k + 1;
                }
                return true;
            }
            if color.get(m) == 0 {
                stack.push(e);
                if lo_dfs(m, efrom, eto, color, stack, found) {
                    return true;
                }
                stack.pop();
            }
        }
        e = e + 1;
    }
    color.set(n, 2);
    return false;
}

pub fn TypeChecker_verify_lock_order(self: &mut TypeChecker, program: Program) {
    var index: i64 = HashMap_new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        if HashMap_get(index, program.funcs.get(i).name) == 0 {
            HashMap_insert(index, program.funcs.get(i).name, i + 1);
        }
        i = i + 1;
    }
    var globals: i64 = HashMap_new();
    i = 0;
    while i < program.globals.len() {
        HashMap_insert(globals, program.globals.get(i).name, 1);
        i = i + 1;
    }
    i = 0;
    while i < program.consts.len() {
        HashMap_insert(globals, program.consts.get(i).name, 1);
        i = i + 1;
    }
    var gl: LoGlobal = LoGlobal {
        funcs: program.funcs, index: index, globals: globals, memo: 0, sums: Vec::new()
    };
    var sizes: Vec<i64> = Vec::new();
    i = 0;
    while i < program.funcs.len() {
        gl.sums.push(LoSum {
            acq: Vec::new(), efrom: Vec::new(), eto: Vec::new(), ewhere: Vec::new()
        });
        sizes.push(0);
        i = i + 1;
    }
    // Summaries only grow, so this reaches a fixpoint; a program without
    // locks takes one round. (No recursion over the call graph: a long
    // call chain cannot overflow the stack.)
    var round: i64 = 0;
    var changed: bool = true;
    while changed && round < 64 {
        changed = false;
        i = 0;
        while i < program.funcs.len() {
            var sz: i64 = lo_summary(&mut gl, i);
            if sz != sizes.get(i) {
                sizes.set(i, sz);
                changed = true;
            }
            i = i + 1;
        }
        round = round + 1;
    }
    // The graph over named locks (parameters are the callers' business).
    var nodes: Vec<str> = Vec::new();
    var node_ix: i64 = HashMap_new();
    var gfrom: Vec<i64> = Vec::new();
    var gto: Vec<i64> = Vec::new();
    var gwhere: Vec<str> = Vec::new();
    var seen: i64 = HashMap_new();
    var si: i64 = 0;
    while si < gl.sums.len() {
        var sum: LoSum = gl.sums.get(si);
        var ei: i64 = 0;
        while ei < sum.efrom.len() {
            var a: str = sum.efrom.get(ei);
            var b: str = sum.eto.get(ei);
            if !str_starts_with(a, "p:") && !str_starts_with(b, "p:") && HashMap_get(seen, a + " > " + b) == 0 {
                HashMap_insert(seen, a + " > " + b, 1);
                if HashMap_get(node_ix, a) == 0 {
                    nodes.push(a);
                    HashMap_insert(node_ix, a, nodes.len());
                }
                if HashMap_get(node_ix, b) == 0 {
                    nodes.push(b);
                    HashMap_insert(node_ix, b, nodes.len());
                }
                gfrom.push(HashMap_get(node_ix, a) - 1);
                gto.push(HashMap_get(node_ix, b) - 1);
                gwhere.push(sum.ewhere.get(ei));
            }
            ei = ei + 1;
        }
        si = si + 1;
    }
    if gfrom.len() < 2 {
        return;
    }
    var color: Vec<i64> = Vec::new();
    i = 0;
    while i < nodes.len() {
        color.push(0);
        i = i + 1;
    }
    var n: i64 = 0;
    while n < nodes.len() {
        if color.get(n) == 0 {
            var stack: Vec<i64> = Vec::new();
            var found: Vec<i64> = Vec::new();
            if lo_dfs(n, gfrom, gto, &mut color, &mut stack, &mut found) {
                var chain: str = "";
                var k: i64 = 0;
                while k < found.len() {
                    var e: i64 = found.get(k);
                    if k > 0 {
                        chain = chain + ", ";
                    }
                    chain = chain + lo_show(nodes.get(gfrom.get(e))) + " then " + lo_show(nodes.get(gto.get(e))) + " in " + gwhere.get(e);
                    k = k + 1;
                }
                var who: str = "Two threads on these paths can each hold one lock and wait forever for the other.";
                if found.len() > 2 {
                    who = int_to_str(found.len()) + " threads, one on each path, can each hold one lock and wait forever for the next.";
                }
                self.errors.push("Deadlock error: locks are taken in an inconsistent order: " + chain + ".\n    " + who + "\n    Fix: take these locks in one fixed order everywhere (release each before taking\n    one that comes earlier in that order).");
                return;
            }
        }
        n = n + 1;
    }
}

// ─── CT1: @hermetic — a test reaches the world only through stdlib/world ──
// stdlib/world replaces the file system, the clock and the network for the
// stdlib functions that consult it. Such a function is a "gate": its body
// asks world_files_faked / world_clock_faked / world_network_faked (fs's
// fs_read_text and the like, time's clock_now_*, datetime's dt_now,
// http_client's http_request, io's Reader::open and file Writers). A
// function marked @hermetic (a test) may reach the world only through
// gates. Its calls are followed breadth-first, stopping at gates, and a
// callee is entered only when its inferred effects (reference §9.1) have
// IO or Net: the effects say what the code touches, so a pure helper is
// never searched. A direct call of a runtime builtin that touches files,
// the clock or the network (hm_world_builtin) on the way is an error that
// names the builtin, its effect and the shortest call path to it. Calls
// are found by name (scan_stmts_for_calls; a method by its bare name, as
// the effect inference finds it); a function passed as a value is not
// followed.

/// What runtime builtin `c` touches ("files", "the clock", "the network"),
/// "" when none of the three.
fn hm_world_builtin(c: str) -> str {
    if str_starts_with(c, "p_file_") || str_starts_with(c, "p_dir_") || c == "p_mkdir" || c == "p_rmdir" || c == "p_remove" || c == "p_rename" || c == "p_is_dir" {
        return "files";
    }
    if str_starts_with(c, "p_clock") || c == "p_time_now" {
        return "the clock";
    }
    if str_starts_with(c, "p_socket_") || str_starts_with(c, "p_net_") || str_starts_with(c, "p_tcp_") || str_starts_with(c, "p_udp_") || str_starts_with(c, "p_dns_") || str_starts_with(c, "pledge_net_") {
        // pledge_net_*: stdlib/net.fd's own C externs (its functions are
        // gates once they call world_sockets_faked)
        return "the network";
    }
    if str_starts_with(c, "p_http_") && str_find(c, "build") < 0 && str_find(c, "parse") < 0 {
        return "the network";
    }
    return "";
}

/// Whether a function calling `calls` consults stdlib/world (a gate).
fn hm_is_gate(calls: Vec<str>) -> bool {
    var i: i64 = 0;
    while i < calls.len() {
        var c: str = calls.get(i);
        if str_starts_with(c, "world_") && str_ends_with(c, "_faked") {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Whether function `name`'s inferred effects have IO or Net.
fn TypeChecker_hm_touches(self: &TypeChecker, name: str) -> bool {
    var effs: Vec<str> = TypeChecker_get_func_effects(self, name);
    return tc_str_vec_contains(effs, "IO") || tc_str_vec_contains(effs, "Net");
}

/// The call graph @hermetic searches. A node is a free function (its name)
/// or an impl method (`Type.method`); `index` maps a name, and a static
/// call's `Type_method` (scan_expr_for_calls with g_scan_dot_methods),
/// to its body code: fi + 1 for program.funcs[fi], -(1 + impl * 65536 +
/// method) for a method. Instance method calls come from what the type
/// checker recorded while checking bodies (TypeChecker_record_method_call:
/// caller, receiver type, method), chained by caller: `mc_head` maps a
/// caller to 1 + its last recorded call, `mc_next[i]` is 1 + the one
/// before it (0: none).
pub struct HmGraph {
    pub index: i64,
    pub mc_head: i64,
    pub mc_next: Vec<i64>,
}

fn hm_body(program: &Program, code: i64) -> Vec<Stmt> {
    if code > 0 {
        return program.funcs.get(code - 1).body;
    }
    var c: i64 = 0 - code - 1;
    return program.impls.get(c / 65536).methods.get(c % 65536).body;
}

fn hm_node_name(program: &Program, code: i64) -> str {
    if code > 0 {
        return program.funcs.get(code - 1).name;
    }
    var c: i64 = 0 - code - 1;
    var imp: ImplDef = program.impls.get(c / 65536);
    return imp.struct_name + "." + imp.methods.get(c % 65536).name;
}

fn TypeChecker_hm_graph(self: &TypeChecker, program: &Program) -> HmGraph {
    var index: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        if !HashMap_contains(index, program.funcs.get(fi).name) {
            HashMap_insert(index, program.funcs.get(fi).name, fi + 1);
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var code: i64 = 0 - (1 + ii * 65536 + mi);
            var dotted: str = imp.struct_name + "." + imp.methods.get(mi).name;
            if !HashMap_contains(index, dotted) {
                HashMap_insert(index, dotted, code);
            }
            // a static call `Type::m(..)` scans as `Type_m`; a free function
            // of that name (core's Vec_new) comes first
            var flat: str = imp.struct_name + "_" + imp.methods.get(mi).name;
            if !HashMap_contains(index, flat) {
                HashMap_insert(index, flat, code);
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    var mc_head: i64 = HashMap_new();
    var mc_next: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < self.method_call_callers.len() {
        var caller: str = self.method_call_callers.get(k);
        mc_next.push(HashMap_get(mc_head, caller));
        HashMap_insert(mc_head, caller, k + 1);
        k = k + 1;
    }
    return HmGraph {
        index: index, mc_head: mc_head, mc_next: mc_next
    };
}

/// Search what @hermetic function `start` reaches; at most one error.
fn TypeChecker_hermetic_check(self: &mut TypeChecker, program: &Program, g: &HmGraph, start: str) {
    var names: Vec<str> = Vec::new();
    var codes: Vec<i64> = Vec::new();
    var parent: Vec<i64> = Vec::new();
    var seen: i64 = HashMap_new();
    names.push(start);
    codes.push(HashMap_get(g.index, start));
    parent.push(-1);
    HashMap_insert(seen, start, 1);
    var saved_dot: bool = g_scan_dot_methods;
    var at: i64 = 0;
    while at < names.len() {
        var cur: str = names.get(at);
        var cur_code: i64 = codes.get(at);
        if cur_code != 0 {
            var calls: Vec<str> = Vec::new();
            // `Type::f(..)` as `Type_f`, `x.m(..)` as `.m` (see below)
            g_scan_dot_methods = true;
            scan_stmts_for_calls(hm_body(program, cur_code), &mut calls);
            g_scan_dot_methods = saved_dot;
            // the test itself turns the fakes on: it is never a gate
            if at == 0 || !hm_is_gate(calls) {
                // the methods the checker saw this body call on a value
                var j: i64 = HashMap_get(g.mc_head, cur);
                while j != 0 {
                    calls.push(self.method_call_owners.get(j - 1) + "." + self.method_call_names.get(j - 1));
                    j = g.mc_next.get(j - 1);
                }
                var ci: i64 = 0;
                while ci < calls.len() {
                    var c: str = calls.get(ci);
                    var what: str = hm_world_builtin(c);
                    if what != "" {
                        var path: str = cur;
                        var p: i64 = parent.get(at);
                        while p >= 0 {
                            path = names.get(p) + " -> " + path;
                            p = parent.get(p);
                        }
                        var eff: str = "IO";
                        if what == "the network" {
                            eff = "Net";
                        }
                        self.errors.push("Hermetic error: '" + start + "' is @hermetic but reaches " + what + " directly: '" + cur + "' calls '" + c + "' (effect " + eff + "), on the path " + path + ".\n    stdlib/world's fakes cannot replace a direct runtime call, so the test would touch the real " + str_replace(what, "the ", "") + ".\n    Fix: use files through fs (fs_read_text, fs_write_text, ...) or io (Reader::open, Writer::create),\n    the clock through time (clock_now_ms) or datetime (dt_now), HTTP through http_client:\n    they consult stdlib/world. Or drop @hermetic.");
                        HashMap_drop(seen);
                        return;
                    }
                    var code: i64 = 0;
                    if !str_starts_with(c, ".") {
                        code = HashMap_get(g.index, c);
                    }
                    if code != 0 {
                        var node: str = hm_node_name(program, code);
                        // a free function is searched only when its effects
                        // have IO or Net (a method's are kept by bare name,
                        // shared between types: it is always searched)
                        if HashMap_get(seen, node) == 0 && (code < 0 || TypeChecker_hm_touches(self, node)) {
                            HashMap_insert(seen, node, 1);
                            names.push(node);
                            codes.push(code);
                            parent.push(at);
                        }
                    }
                    ci = ci + 1;
                }
            }
        }
        at = at + 1;
    }
    HashMap_drop(seen);
}

pub fn TypeChecker_verify_hermetic(self: &mut TypeChecker, program: Program) {
    var any: bool = false;
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        if tf_has_ann(program.funcs.get(fi).annotations, "hermetic") {
            any = true;
        }
        fi = fi + 1;
    }
    if !any {
        return;
    }
    var g: HmGraph = TypeChecker_hm_graph(self, &program);
    fi = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if tf_has_ann(func.annotations, "hermetic") {
            TypeChecker_hermetic_check(self, &program, &g, func.name);
        }
        fi = fi + 1;
    }
    HashMap_drop(g.index);
    HashMap_drop(g.mc_head);
}

// ─── rm-P9: @redundant (F45), @partitioned (F47), @serverless (F32) ──────
// What a function does that these three care about: the user functions it
// calls, the variables it assigns, the names it binds, and whether it
// starts a task.

pub struct PfFacts {
    pub calls: Vec<str>,
    pub writes: Vec<str>,
    pub lets: Vec<str>,
    pub spawns: bool,
    /// F47: memory a call may hand on, one entry per argument that is a
    /// variable or a reference or address taken of one: the callee, the
    /// argument's index, the variable, and whether a reference was taken
    /// (`&x`); read by TypeChecker_verify_partitioned.
    pub hand_callee: Vec<str>,
    pub hand_arg: Vec<i64>,
    pub hand_var: Vec<str>,
    pub hand_ref: Vec<bool>,
}

pub struct PfReach {
    pub fis: Vec<i64>,
    pub facts: Vec<PfFacts>,
}

fn pf_add_call(f: &mut PfFacts, n: str) {
    if !str_vec_contains(f.calls, n) {
        f.calls.push(n);
    }
}

fn pf_add_write(f: &mut PfFacts, n: str) {
    if n != "" && !str_vec_contains(f.writes, n) {
        f.writes.push(n);
    }
}

fn pf_add_let(f: &mut PfFacts, n: str) {
    if !str_vec_contains(f.lets, n) {
        f.lets.push(n);
    }
}

/// F47: the variable a reference argument is taken of (`&x`, `&mut x.f`,
/// `&x as i64`); "" when the argument takes no reference.
fn pf_ref_base(e: Expr) -> str {
    match e {
        Expr::Ref(x, _) => {
            return tf_base_var(box_expr_unbox(x));
        }
        Expr::Cast(x, _) => {
            return pf_ref_base(box_expr_unbox(x));
        }
        _ => {
            return "";
        }
    }
}

/// F47: record each argument of a call to `c` that hands on a variable's
/// memory: a reference taken of it, or the variable itself (that hands
/// memory on only when the callee's parameter is a reference or pointer,
/// which TypeChecker_verify_partitioned checks).
fn pf_add_hands(f: &mut PfFacts, c: str, args: Vec<Expr>) {
    var ai: i64 = 0;
    while ai < args.len() {
        val a: Expr = args.get(ai);
        val rb: str = pf_ref_base(a);
        var name: str = rb;
        var is_ref: bool = rb != "";
        if !is_ref {
            match a {
                Expr::Ident(n) => {
                    name = n;
                }
                _ => {
                }
            }
        }
        if name != "" {
            f.hand_callee.push(c);
            f.hand_arg.push(ai);
            f.hand_var.push(name);
            f.hand_ref.push(is_ref);
        }
        ai = ai + 1;
    }
}

fn pf_is_spawn_call(c: str) -> bool {
    return c == "p_spawn_thread" || c == "p_thread_spawn" || c == "p_spawn_process" || c == "sync_spawn" || c == "task_spawn" || c == "p_task_spawn";
}

fn pf_opt_stmts(ob: OptStmts, f: &mut PfFacts) {
    match ob {
        OptStmts::Some(b) => {
            pf_stmts(b, f);
        }
        OptStmts::None => {
        }
    }
}

fn pf_opt_expr(oe: OptBoxExpr, f: &mut PfFacts) {
    match oe {
        OptBoxExpr::Some(e) => {
            pf_expr(box_expr_unbox(e), f);
        }
        OptBoxExpr::None => {
        }
    }
}

fn pf_stmts(stmts: Vec<Stmt>, f: &mut PfFacts) {
    var i: i64 = 0;
    while i < stmts.len() {
        pf_stmt(stmts.get(i), f);
        i = i + 1;
    }
}

fn pf_stmt(s: Stmt, f: &mut PfFacts) {
    match s {
        Stmt::Let(n, _, e, _, _, _, _) => {
            pf_add_let(f, n);
            pf_expr(e, f);
        }
        Stmt::LetTuple(ns, e, _) => {
            var i: i64 = 0;
            while i < ns.len() {
                pf_add_let(f, ns.get(i));
                i = i + 1;
            }
            pf_expr(e, f);
        }
        Stmt::LetUninit(n, _, _, _) => {
            pf_add_let(f, n);
        }
        Stmt::Assign(n, _, e, _) => {
            pf_add_write(f, n);
            pf_expr(e, f);
        }
        Stmt::IndexAssign(n, ix, _, e, _) => {
            pf_add_write(f, n);
            pf_expr(ix, f);
            pf_expr(e, f);
        }
        Stmt::DerefAssign(pe, _, e, _) => {
            pf_add_write(f, tf_base_var(pe));
            pf_expr(pe, f);
            pf_expr(e, f);
        }
        Stmt::FieldAssign(o, _, _, e, _) => {
            pf_add_write(f, tf_base_var(o));
            pf_expr(o, f);
            pf_expr(e, f);
        }
        Stmt::Expr(e, _) => {
            pf_expr(e, f);
        }
        Stmt::Return(oe, _) => {
            pf_opt_expr(oe, f);
        }
        Stmt::Break(oe, _) => {
            pf_opt_expr(oe, f);
        }
        Stmt::If(c, tb, eb, _) => {
            pf_expr(c, f);
            pf_stmts(tb, f);
            pf_opt_stmts(eb, f);
        }
        Stmt::While(c, b, _) => {
            pf_expr(c, f);
            pf_stmts(b, f);
        }
        Stmt::For(n, it, b, _) => {
            pf_add_let(f, n);
            pf_expr(it, f);
            pf_stmts(b, f);
        }
        Stmt::Loop(b, _) => {
            pf_stmts(b, f);
        }
        Stmt::Defer(b, _) => {
            pf_stmts(b, f);
        }
        Stmt::Match(e, arms, _) => {
            pf_expr(e, f);
            var ai: i64 = 0;
            while ai < arms.len() {
                pf_stmts(arms.get(ai).body, f);
                ai = ai + 1;
            }
        }
        Stmt::Handle(b, _, _) => {
            pf_stmts(b, f);
        }
        Stmt::RegionBlock(_, _, _, _, _, b, _) => {
            pf_stmts(b, f);
        }
        Stmt::Sandbox(b, _) => {
            pf_stmts(b, f);
        }
        Stmt::Unsafe(b, _) => {
            pf_stmts(b, f);
        }
        Stmt::Txn(b, _) => {
            pf_stmts(b, f);
        }
        Stmt::GradBlock(_, b, _) => {
            pf_stmts(b, f);
        }
        Stmt::SpawnScope(b, _) => {
            // structured: its tasks end with the scope
            pf_stmts(b, f);
        }
        Stmt::Parallel(bs, _) => {
            var i: i64 = 0;
            while i < bs.len() {
                pf_stmts(bs.get(i), f);
                i = i + 1;
            }
        }
        _ => {
        }
    }
}

fn pf_exprs(es: Vec<Expr>, f: &mut PfFacts) {
    var i: i64 = 0;
    while i < es.len() {
        pf_expr(es.get(i), f);
        i = i + 1;
    }
}

fn pf_expr(e: Expr, f: &mut PfFacts) {
    match e {
        Expr::Call(c, args) => {
            pf_add_call(f, c);
            if pf_is_spawn_call(c) {
                f.spawns = true;
            }
            pf_add_hands(f, c, args);
            pf_exprs(args, f);
        }
        Expr::Spawn(x) => {
            f.spawns = true;
            pf_expr(box_expr_unbox(x), f);
        }
        Expr::MethodCall(r, _, args) => {
            pf_expr(box_expr_unbox(r), f);
            pf_exprs(args, f);
        }
        Expr::Binary(_, l, r) => {
            pf_expr(box_expr_unbox(l), f);
            pf_expr(box_expr_unbox(r), f);
        }
        Expr::StrConcat(l, r) => {
            pf_expr(box_expr_unbox(l), f);
            pf_expr(box_expr_unbox(r), f);
        }
        Expr::Coalesce(l, r) => {
            pf_expr(box_expr_unbox(l), f);
            pf_expr(box_expr_unbox(r), f);
        }
        Expr::Index(l, r) => {
            pf_expr(box_expr_unbox(l), f);
            pf_expr(box_expr_unbox(r), f);
        }
        Expr::PipeForward(l, r) => {
            pf_expr(box_expr_unbox(l), f);
            match box_expr_unbox(r) {
                Expr::Ident(fname) => {
                    pf_add_call(f, fname);
                }
                _ => {
                    pf_expr(box_expr_unbox(r), f);
                }
            }
        }
        Expr::Unary(_, x) => {
            pf_expr(box_expr_unbox(x), f);
        }
        Expr::FieldAccess(x, _) => {
            pf_expr(box_expr_unbox(x), f);
        }
        Expr::Ref(x, _) => {
            pf_expr(box_expr_unbox(x), f);
        }
        Expr::Deref(x) => {
            pf_expr(box_expr_unbox(x), f);
        }
        Expr::Try(x) => {
            pf_expr(box_expr_unbox(x), f);
        }
        Expr::Cast(x, _) => {
            pf_expr(box_expr_unbox(x), f);
        }
        Expr::Await(x) => {
            pf_expr(box_expr_unbox(x), f);
        }
        Expr::StructLit(_, fields, _) => {
            var i: i64 = 0;
            while i < fields.len() {
                pf_expr(fields.get(i).value, f);
                i = i + 1;
            }
        }
        Expr::If(c, tb, eb) => {
            pf_expr(box_expr_unbox(c), f);
            pf_stmts(tb, f);
            pf_opt_stmts(eb, f);
        }
        Expr::Block(b) => {
            pf_stmts(b, f);
        }
        Expr::TryBlock(b) => {
            pf_stmts(b, f);
        }
        Expr::Closure(_, b, _) => {
            pf_stmts(b, f);
        }
        Expr::Match(x, arms) => {
            pf_expr(box_expr_unbox(x), f);
            var ai: i64 = 0;
            while ai < arms.len() {
                pf_stmts(arms.get(ai).body, f);
                ai = ai + 1;
            }
        }
        Expr::ArrayLit(_, es) => {
            pf_exprs(es, f);
        }
        Expr::TupleLit(es) => {
            pf_exprs(es, f);
        }
        Expr::EnumLit(_, _, es) => {
            pf_exprs(es, f);
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(x) => {
                        pf_expr(x, f);
                    }
                    _ => {
                    }
                }
                i = i + 1;
            }
        }
        _ => {
        }
    }
}

fn pf_facts(func: Func) -> PfFacts {
    var f: PfFacts = PfFacts {
        calls: Vec::new(), writes: Vec::new(), lets: Vec::new(), spawns: false, hand_callee: Vec::new(), hand_arg: Vec::new(), hand_var: Vec::new(), hand_ref: Vec::new()
    };
    var i: i64 = 0;
    while i < func.params.len() {
        pf_add_let(&mut f, func.params.get(i).name);
        i = i + 1;
    }
    pf_stmts(func.body, &mut f);
    return f;
}

fn pf_func_index(program: Program) -> i64 {
    var index: i64 = HashMap_new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        if HashMap_get(index, program.funcs.get(i).name) == 0 {
            HashMap_insert(index, program.funcs.get(i).name, i + 1);
        }
        i = i + 1;
    }
    return index;
}

/// Mutable globals: name -> index + 1 into program.globals.
fn pf_global_index(program: Program) -> i64 {
    var g: i64 = HashMap_new();
    var i: i64 = 0;
    while i < program.globals.len() {
        HashMap_insert(g, program.globals.get(i).name, i + 1);
        i = i + 1;
    }
    return g;
}

/// The user functions reachable from `root` (root first), with their facts.
fn pf_reach(program: Program, index: i64, root: i64) -> PfReach {
    var out: PfReach = PfReach {
        fis: Vec::new(), facts: Vec::new()
    };
    var seen: i64 = HashMap_new();
    out.fis.push(root);
    HashMap_insert(seen, program.funcs.get(root).name, 1);
    var k: i64 = 0;
    while k < out.fis.len() {
        var facts: PfFacts = pf_facts(program.funcs.get(out.fis.get(k)));
        var ci: i64 = 0;
        while ci < facts.calls.len() {
            var c: str = facts.calls.get(ci);
            var slot: i64 = HashMap_get(index, c);
            if slot != 0 && HashMap_get(seen, c) == 0 {
                HashMap_insert(seen, c, 1);
                out.fis.push(slot - 1);
            }
            ci = ci + 1;
        }
        out.facts.push(facts);
        k = k + 1;
    }
    return out;
}

/// The name is the global (not a local or parameter of the same name).
fn pf_is_global(globals: i64, facts: PfFacts, name: str) -> bool {
    return HashMap_get(globals, name) != 0 && !str_vec_contains(facts.lets, name);
}

/// The first argument of annotation `name` (the function's own name when
/// it has none); "" when the function does not have it.
fn pf_ann_arg(func: Func, name: str) -> str {
    var i: i64 = 0;
    while i < func.annotations.len() {
        var a: Annotation = func.annotations.get(i);
        if a.name == name {
            if a.args.len() > 0 {
                return a.args.get(0);
            }
            return func.name;
        }
        i = i + 1;
    }
    return "";
}

/// F45 @redundant: the voter compares the channels' results, so the result
/// must be a scalar.
fn rdn_scalar_type(t: Type) -> bool {
    match t {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::I64 => {
            return true;
        }
        Type::U8 => {
            return true;
        }
        Type::U16 => {
            return true;
        }
        Type::U32 => {
            return true;
        }
        Type::U64 => {
            return true;
        }
        Type::F32 => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

fn rdn_mut_ref(t: Type) -> bool {
    match t {
        Type::Ref(_, m) => {
            return m;
        }
        Type::RawPtr(_, m) => {
            return m;
        }
        _ => {
            return false;
        }
    }
}

/// F45 @redundant — dual-channel execution. compiler/mono.fd turns the
/// function into two channels (`<f>_chan_a`, `<f>_chan_b`) and a voter `f`
/// that runs both on the same arguments, compares the results and stops
/// the program (fail-safe) when they differ. For that to be sound the
/// function must be one the voter can run twice: a scalar result, no
/// generics, no `async`, no `&mut`/`*mut` parameter (channel A's writes
/// would be channel B's input), and nothing it reaches may act outside
/// (IO, Net, Spawn, Write, Noise, Comm effects; a write to a global; a
/// task): the side effect would happen twice, and a voter cannot compare it.
pub fn TypeChecker_verify_redundant(self: &mut TypeChecker, program: Program) {
    var index: i64 = 0;
    var globals: i64 = 0;
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if tf_has_ann(func.annotations, "redundant") {
            if index == 0 {
                index = pf_func_index(program);
                globals = pf_global_index(program);
            }
            var head: str = "Redundancy error: @redundant function '" + func.name + "' ";
            if func.type_params.len() > 0 {
                self.errors.push(head + "is generic.\n    Each channel and the voter are generated for one signature.\n    Fix: make a non-generic wrapper and mark that @redundant.");
            }
            if func.is_async {
                self.errors.push(head + "is async.\n    The voter must have both channels' results at once.\n    Fix: make it a plain function.");
            }
            if !rdn_scalar_type(func.ret_ty) {
                self.errors.push(head + "does not return a scalar.\n    The voter compares the two channels' results: it needs an integer, a float or a bool.\n    Fix: return a scalar (a checksum or a status of a larger result).");
            }
            var pi: i64 = 0;
            while pi < func.params.len() {
                if rdn_mut_ref(func.params.get(pi).ty) {
                    self.errors.push(head + "takes '" + func.params.get(pi).name + "' by mutable reference.\n    Both channels run on the same arguments: what channel A writes, channel B would read.\n    Fix: take the value, and return what changes.");
                }
                pi = pi + 1;
            }
            var effects: Vec<str> = TypeChecker_get_func_effects(self, func.name);
            var ei: i64 = 0;
            while ei < effects.len() {
                var eff: str = effects.get(ei);
                if eff == "IO" || eff == "Net" || eff == "Spawn" || eff == "Write" || eff == "Noise" || eff == "Comm" {
                    self.errors.push(head + "has effect '!" + eff + "'.\n    Each channel runs it: the effect would happen twice, and the voter cannot compare it.\n    Fix: compute the result in the @redundant function and act on it in its caller.");
                }
                ei = ei + 1;
            }
            var reach: PfReach = pf_reach(program, index, fi);
            var k: i64 = 0;
            while k < reach.fis.len() {
                var facts: PfFacts = reach.facts.get(k);
                var fname: str = program.funcs.get(reach.fis.get(k)).name;
                var wi: i64 = 0;
                while wi < facts.writes.len() {
                    if pf_is_global(globals, facts, facts.writes.get(wi)) {
                        self.errors.push(head + "writes the global '" + facts.writes.get(wi) + "' (in '" + fname + "').\n    Each channel would write it: the second channel would see the first one's write.\n    Fix: return the new value and store it in the caller.");
                    }
                    wi = wi + 1;
                }
                if facts.spawns {
                    self.errors.push(head + "starts a task (in '" + fname + "').\n    Each channel would start it.\n    Fix: start it in the caller, from the voted result.");
                }
                k = k + 1;
            }
        }
        fi = fi + 1;
    }
}

/// F47 @partitioned(name) — spatial partitioning (ARINC 653) checked at
/// compile time. A function marked @partitioned(P) is an entry of
/// partition P (the name defaults to the function's). The code of a
/// partition is its entries and every function they reach that is not
/// itself an entry of a partition (shared library code). A mutable global
/// reached by the code of two partitions is shared memory between them: an
/// error. A partition calling an entry of another one directly is an error:
/// partitions communicate only through ports (stdlib/arinc.fd queuing and
/// sampling ports, passed in as values).
pub fn TypeChecker_verify_partitioned(self: &mut TypeChecker, program: Program) {
    var part_of: i64 = HashMap_new();
    var part_names: Vec<str> = Vec::new();
    var roots: Vec<i64> = Vec::new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var p: str = pf_ann_arg(program.funcs.get(fi), "partitioned");
        if p != "" {
            part_names.push(p);
            HashMap_insert(part_of, program.funcs.get(fi).name, part_names.len());
            roots.push(fi);
        }
        fi = fi + 1;
    }
    if roots.len() == 0 {
        return;
    }
    var index: i64 = pf_func_index(program);
    var globals: i64 = pf_global_index(program);
    var owner: i64 = HashMap_new();
    var owner_part: Vec<str> = Vec::new();
    var owner_via: Vec<str> = Vec::new();
    var reported: i64 = HashMap_new();
    var ri: i64 = 0;
    while ri < roots.len() {
        var root: i64 = roots.get(ri);
        var part: str = part_names.get(ri);
        // Reach the partition's code; stop at another partition's entry.
        var queue: Vec<i64> = Vec::new();
        var seen: i64 = HashMap_new();
        queue.push(root);
        HashMap_insert(seen, program.funcs.get(root).name, 1);
        var k: i64 = 0;
        while k < queue.len() {
            var func: Func = program.funcs.get(queue.get(k));
            var facts: PfFacts = pf_facts(func);
            var reads: Vec<str> = Vec::new();
            esc_idents_stmts(func.body, &mut reads);
            var wi: i64 = 0;
            while wi < facts.writes.len() {
                if !str_vec_contains(reads, facts.writes.get(wi)) {
                    reads.push(facts.writes.get(wi));
                }
                wi = wi + 1;
            }
            var gi: i64 = 0;
            while gi < reads.len() {
                var g: str = reads.get(gi);
                if pf_is_global(globals, facts, g) {
                    var os: i64 = HashMap_get(owner, g);
                    if os == 0 {
                        owner_part.push(part);
                        owner_via.push(func.name);
                        HashMap_insert(owner, g, owner_part.len());
                    } else if owner_part.get(os - 1) != part && HashMap_get(reported, "g:" + g) == 0 {
                        HashMap_insert(reported, "g:" + g, 1);
                        self.errors.push("Partition error: the global '" + g + "' is shared by partition '" + owner_part.get(os - 1) + "' (in '" + owner_via.get(os - 1) + "') and partition '" + part + "' (in '" + func.name + "').\n    @partitioned components have separate memory (ARINC 653 spatial partitioning):\n    a mutable global reached from two partitions is memory they share.\n    Fix: give each partition its own state, and pass data between them through an\n    ARINC queuing or sampling port (stdlib/arinc.fd).");
                    }
                }
                gi = gi + 1;
            }
            var ci: i64 = 0;
            while ci < facts.calls.len() {
                var c: str = facts.calls.get(ci);
                var slot: i64 = HashMap_get(index, c);
                if slot != 0 {
                    var cp: i64 = HashMap_get(part_of, c);
                    if cp != 0 && part_names.get(cp - 1) != part {
                        if HashMap_get(reported, "c:" + func.name + ">" + c) == 0 {
                            HashMap_insert(reported, "c:" + func.name + ">" + c, 1);
                            self.errors.push("Partition error: '" + func.name + "' (partition '" + part + "') calls '" + c + "', an entry of partition '" + part_names.get(cp - 1) + "'.\n    Partitions run in their own time and memory and communicate only through ports.\n    Fix: send the data through an ARINC queuing or sampling port (stdlib/arinc.fd).");
                        }
                    } else if HashMap_get(seen, c) == 0 {
                        HashMap_insert(seen, c, 1);
                        queue.push(slot - 1);
                    }
                }
                ci = ci + 1;
            }
            k = k + 1;
        }
        ri = ri + 1;
    }
    // Memory handed to two partitions. The scheduler (any function that
    // calls partition entries, usually `main`) must not give the same
    // variable to two partitions by reference or pointer: through it the
    // partitions would share memory. A port (stdlib/arinc.fd SamplingPort,
    // QueuingPort) is how they communicate, so handing one is allowed. A
    // global handed by reference counts as reached by that partition.
    var handed: i64 = HashMap_new();
    var hand_part: Vec<str> = Vec::new();
    var hand_entry: Vec<str> = Vec::new();
    var hfi: i64 = 0;
    while hfi < program.funcs.len() {
        var hfunc: Func = program.funcs.get(hfi);
        var hf: PfFacts = pf_facts(hfunc);
        var hi: i64 = 0;
        while hi < hf.hand_callee.len() {
            var c: str = hf.hand_callee.get(hi);
            var cp: i64 = HashMap_get(part_of, c);
            if cp != 0 {
                var part: str = part_names.get(cp - 1);
                var entry: Func = program.funcs.get(roots.get(cp - 1));
                var ai: i64 = hf.hand_arg.get(hi);
                var hands_mem: bool = hf.hand_ref.get(hi);
                if ai < entry.params.len() {
                    var pt: Type = entry.params.get(ai).ty;
                    if pf_ptr_param(pt) {
                        hands_mem = true;
                    }
                    if pf_port_param(pt) {
                        hands_mem = false;
                    }
                }
                if hands_mem {
                    var v: str = hf.hand_var.get(hi);
                    if pf_is_global(globals, hf, v) {
                        var os: i64 = HashMap_get(owner, v);
                        if os == 0 {
                            owner_part.push(part);
                            owner_via.push(entry.name);
                            HashMap_insert(owner, v, owner_part.len());
                        } else if owner_part.get(os - 1) != part && HashMap_get(reported, "g:" + v) == 0 {
                            HashMap_insert(reported, "g:" + v, 1);
                            self.errors.push("Partition error: the global '" + v + "' is shared by partition '" + owner_part.get(os - 1) + "' (in '" + owner_via.get(os - 1) + "') and partition '" + part + "' ('" + hfunc.name + "' hands it by reference to '" + entry.name + "').\n    @partitioned components have separate memory (ARINC 653 spatial partitioning):\n    a mutable global reached from two partitions is memory they share.\n    Fix: give each partition its own state, and pass data between them through an\n    ARINC queuing or sampling port (stdlib/arinc.fd).");
                        }
                    } else {
                        var key: str = hfunc.name + "." + v;
                        var hs: i64 = HashMap_get(handed, key);
                        if hs == 0 {
                            hand_part.push(part);
                            hand_entry.push(entry.name);
                            HashMap_insert(handed, key, hand_part.len());
                        } else if hand_part.get(hs - 1) != part && HashMap_get(reported, "h:" + key) == 0 {
                            HashMap_insert(reported, "h:" + key, 1);
                            self.errors.push("Partition error: '" + hfunc.name + "' hands '" + v + "' by reference to partition '" + hand_part.get(hs - 1) + "' (entry '" + hand_entry.get(hs - 1) + "') and to partition '" + part + "' (entry '" + entry.name + "').\n    @partitioned components have separate memory (ARINC 653 spatial partitioning):\n    memory both partitions reach through a reference or pointer is memory they share.\n    Fix: give each partition its own copy, and pass data between them through an\n    ARINC queuing or sampling port (stdlib/arinc.fd).");
                        }
                    }
                }
            }
            hi = hi + 1;
        }
        hfi = hfi + 1;
    }
}

/// F47: a parameter that receives memory: a reference or a raw pointer.
fn pf_ptr_param(t: Type) -> bool {
    match t {
        Type::Ref(_, _) => {
            return true;
        }
        Type::RawPtr(_, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// F47: an ARINC port (stdlib/arinc.fd), or a reference or pointer to one:
/// the way partitions are meant to communicate.
fn pf_port_param(t: Type) -> bool {
    match t {
        Type::Ref(inner, _) => {
            return pf_port_param(box_type_unbox(inner));
        }
        Type::RawPtr(inner, _) => {
            return pf_port_param(box_type_unbox(inner));
        }
        Type::Named(n) => {
            return n == "SamplingPort" || n == "QueuingPort";
        }
        _ => {
            return false;
        }
    }
}

/// A global initializer that costs nothing at start-up: literals, constants
/// and what is built from them, empty collections, comptime values.
fn pf_cheap_init(e: Expr) -> bool {
    match e {
        Expr::IntLit(_) => {
            return true;
        }
        Expr::FloatLit(_) => {
            return true;
        }
        Expr::StringLit(_) => {
            return true;
        }
        Expr::BoolLit(_) => {
            return true;
        }
        Expr::Ident(_) => {
            return true;
        }
        Expr::Comptime(_) => {
            return true;
        }
        Expr::ComptimeBlock(_) => {
            return true;
        }
        Expr::Unary(_, x) => {
            return pf_cheap_init(box_expr_unbox(x));
        }
        Expr::Cast(x, _) => {
            return pf_cheap_init(box_expr_unbox(x));
        }
        Expr::Binary(_, l, r) => {
            return pf_cheap_init(box_expr_unbox(l)) && pf_cheap_init(box_expr_unbox(r));
        }
        Expr::Call(c, args) => {
            return args.len() == 0 && str_ends_with(c, "_new");
        }
        Expr::ArrayLit(_, es) => {
            var i: i64 = 0;
            while i < es.len() {
                if !pf_cheap_init(es.get(i)) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        Expr::EnumLit(_, _, es) => {
            var i: i64 = 0;
            while i < es.len() {
                if !pf_cheap_init(es.get(i)) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        Expr::StructLit(_, fields, _) => {
            var i: i64 = 0;
            while i < fields.len() {
                if !pf_cheap_init(fields.get(i).value) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// F32 @serverless — a request handler of a serverless function. Its
/// instance can be frozen after a response, recycled for the next request,
/// run many times in parallel, or started cold for one request. So the
/// handler and everything it reaches: writes no module global (state does
/// not reliably survive between requests), starts no task (it may never
/// finish once the instance is frozen), and reads no global whose
/// initializer runs code at start-up (every cold start pays for it before
/// the first request: make it a constant or a `comptime` value).
pub fn TypeChecker_verify_serverless(self: &mut TypeChecker, program: Program) {
    var index: i64 = 0;
    var globals: i64 = 0;
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if tf_has_ann(func.annotations, "serverless") {
            if index == 0 {
                index = pf_func_index(program);
                globals = pf_global_index(program);
            }
            var head: str = "Serverless error: @serverless handler '" + func.name + "' ";
            var reported: i64 = HashMap_new();
            var reach: PfReach = pf_reach(program, index, fi);
            var k: i64 = 0;
            while k < reach.fis.len() {
                var f: Func = program.funcs.get(reach.fis.get(k));
                var facts: PfFacts = reach.facts.get(k);
                var wi: i64 = 0;
                while wi < facts.writes.len() {
                    var w: str = facts.writes.get(wi);
                    if pf_is_global(globals, facts, w) && HashMap_get(reported, "w:" + w) == 0 {
                        HashMap_insert(reported, "w:" + w, 1);
                        self.errors.push(head + "writes the global '" + w + "' (in '" + f.name + "').\n    A serverless instance can be recycled, frozen or run many times at once:\n    module state does not reliably survive from one request to the next.\n    Fix: keep request state in locals, and lasting state in a store outside the instance.");
                    }
                    wi = wi + 1;
                }
                if facts.spawns && HashMap_get(reported, "s:" + f.name) == 0 {
                    HashMap_insert(reported, "s:" + f.name, 1);
                    self.errors.push(head + "starts a background task (in '" + f.name + "').\n    Once the handler returns, the instance can be frozen: the task may never finish.\n    Fix: finish the work before returning, or hand it to a queue.");
                }
                var reads: Vec<str> = Vec::new();
                esc_idents_stmts(f.body, &mut reads);
                var ri: i64 = 0;
                while ri < reads.len() {
                    var g: str = reads.get(ri);
                    if pf_is_global(globals, facts, g) && HashMap_get(reported, "r:" + g) == 0 {
                        var gv: GlobalVar = program.globals.get(HashMap_get(globals, g) - 1);
                        if !pf_cheap_init(gv.init) {
                            HashMap_insert(reported, "r:" + g, 1);
                            self.errors.push(head + "reads the global '" + g + "' (in '" + f.name + "'), whose initializer runs code at start-up.\n    Every cold start runs it before the first request is served.\n    Fix: make it a constant or a `comptime` value, or compute it in the handler.");
                        }
                    }
                    ri = ri + 1;
                }
                k = k + 1;
            }
        }
        fi = fi + 1;
    }
}

// ─── rm-P9: F34 @event / @emit(E, ...) and @contract (blockchain) ─────────
// `@event fn Transfer(from: i64, to: i64, amount: i64) {}` declares an
// event; the compiler writes its body (compiler/mono.fd mn_event_body: one
// numbered record in the event log, with the signature's topic). A
// function that emits events lists them: `@emit(Transfer, Approval)`. A
// `@contract` function is a smart-contract entry point the compiler
// verifies. Rules (docs/reference/events-and-contracts.md):
//   E1 an event is a free, non-generic, non-async function with no result,
//      an empty body and parameters of types the log encodes (integers,
//      bool, str); no two events share a signature topic
//   E2 each name @emit lists is an @event function, and the list is not empty
//   E3 a function without @emit/@contract emits no event directly
//   E4 a function with @emit/@contract emits, through everything it calls,
//      exactly the events it lists (none undeclared, none listed in vain)
//   C1 a @contract is @deterministic and has @gas(N)
//   C2 a @contract cannot call itself again before it returns (reentrancy)
//   C3 a @contract makes no call through a function value

/// The type's name in an event signature; "" when an event cannot carry it.
fn em_type_name(t: Type) -> str {
    match t {
        Type::I8 => {
            return "i8";
        }
        Type::I16 => {
            return "i16";
        }
        Type::I32 => {
            return "i32";
        }
        Type::I64 => {
            return "i64";
        }
        Type::U8 => {
            return "u8";
        }
        Type::U16 => {
            return "u16";
        }
        Type::U32 => {
            return "u32";
        }
        Type::U64 => {
            return "u64";
        }
        Type::Bool => {
            return "bool";
        }
        Type::Str => {
            return "str";
        }
        _ => {
            return "";
        }
    }
}

/// FNV-1a (32 bits) of the canonical signature `Name(t1,...)`: the event's
/// topic, as compiler/mono.fd mn_fnv32 computes it.
fn em_topic(func: Func) -> i64 {
    var s: str = func.name + "(";
    var i: i64 = 0;
    while i < func.params.len() {
        if i > 0 {
            s = s + ",";
        }
        s = s + em_type_name(func.params.get(i).ty);
        i = i + 1;
    }
    s = s + ")";
    var h: i64 = 2166136261;
    var k: i64 = 0;
    while k < str_len(s) {
        h = h ^ (str_byte_at(s, k) & 255);
        h = (h * 16777619) & 4294967295;
        k = k + 1;
    }
    return h;
}

fn em_is_void(t: Type) -> bool {
    match t {
        Type::Void => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// The events a function's @emit lists (none: empty).
fn em_declared(func: Func) -> Vec<str> {
    var i: i64 = 0;
    while i < func.annotations.len() {
        if func.annotations.get(i).name == "emit" {
            return func.annotations.get(i).args;
        }
        i = i + 1;
    }
    return Vec::new();
}

/// E1: the event declaration itself.
fn em_check_event(self: &mut TypeChecker, func: Func) {
    var head: str = "Event error: @event '" + func.name + "' ";
    if func.type_params.len() > 0 {
        self.errors.push(head + "is generic.\n    An event's signature (its topic) is fixed: one name, one list of parameter types.\n    Fix: declare one event per payload type.");
    }
    if func.is_async {
        self.errors.push(head + "is async.\n    Emitting an event appends to the log at once; there is nothing to await.\n    Fix: remove `async`.");
    }
    if !em_is_void(func.ret_ty) {
        self.errors.push(head + "has a result type.\n    An event only records its arguments; it returns nothing.\n    Fix: remove `-> " + type_to_str(func.ret_ty) + "`.");
    }
    if func.body.len() > 0 {
        self.errors.push(head + "has a body.\n    The compiler writes an event's body: it appends the event to the log, in emission order.\n    Fix: declare it with an empty body: `@event fn " + func.name + "(...) {}`.");
    }
    var i: i64 = 0;
    while i < func.params.len() {
        var p: Param = func.params.get(i);
        if em_type_name(p.ty) == "" {
            self.errors.push(head + "has parameter '" + p.name + "' of type " + type_to_str(p.ty) + ", which an event cannot carry.\n    The log encodes integers, bool and str: floating point is not reproducible across nodes,\n    and references, collections and structs have no fixed encoding.\n    Fix: pass the fields as separate integer, bool or str parameters.");
        }
        i = i + 1;
    }
}

pub fn TypeChecker_verify_emit(self: &mut TypeChecker, program: Program) {
    var events: i64 = 0;
    var any: bool = false;
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if tf_has_ann(func.annotations, "event") {
            if events == 0 {
                events = HashMap_new();
            }
            HashMap_insert(events, func.name, fi + 1);
            any = true;
        }
        if tf_has_ann(func.annotations, "emit") || tf_has_ann(func.annotations, "contract") {
            any = true;
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            if tf_has_ann(m.annotations, "event") {
                self.errors.push("Event error: method '" + imp.struct_name + "." + m.name + "' is an @event.\n    An event is a free function: `@event fn " + m.name + "(...) {}` at module level.");
            }
            if tf_has_ann(m.annotations, "contract") {
                self.errors.push("Contract error: method '" + imp.struct_name + "." + m.name + "' is a @contract.\n    A contract entry point is a free function (its calls are followed by the verifier).\n    Fix: make it a module-level function taking the state as a parameter.");
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    if !any {
        return;
    }
    if events == 0 {
        events = HashMap_new();
    }
    // E1, and topics: name -> index + 1 of the event that has it
    var topics: i64 = HashMap_new();
    fi = 0;
    while fi < program.funcs.len() {
        var ev: Func = program.funcs.get(fi);
        if HashMap_get(events, ev.name) == fi + 1 {
            em_check_event(self, ev);
            var tkey: str = int_to_str(em_topic(ev));
            var other: i64 = HashMap_get(topics, tkey);
            if other != 0 {
                self.errors.push("Event error: events '" + program.funcs.get(other - 1).name + "' and '" + ev.name + "' have the same signature topic (" + tkey + ").\n    A log reader tells events apart by their signature's topic.\n    Fix: rename one of them.");
            } else {
                HashMap_insert(topics, tkey, fi + 1);
            }
        }
        fi = fi + 1;
    }
    // Impl methods: events they emit directly must be listed (E3/E2)
    ii = 0;
    while ii < program.impls.len() {
        var imp2: ImplDef = program.impls.get(ii);
        var mj: i64 = 0;
        while mj < imp2.methods.len() {
            var m2: Func = imp2.methods.get(mj);
            var mdecl: Vec<str> = em_declared(m2);
            var mfacts: PfFacts = pf_facts(m2);
            var ci: i64 = 0;
            while ci < mfacts.calls.len() {
                var c: str = mfacts.calls.get(ci);
                if HashMap_get(events, c) != 0 && !str_vec_contains(mdecl, c) && !str_vec_contains(mfacts.lets, c) {
                    self.errors.push("Event error: method '" + imp2.struct_name + "." + m2.name + "' emits '" + c + "' without declaring it.\n    The compiler tracks which events each function can emit.\n    Fix: write @emit(" + c + ") on it.");
                }
                ci = ci + 1;
            }
            mj = mj + 1;
        }
        ii = ii + 1;
    }
    var index: i64 = pf_func_index(program);
    fi = 0;
    while fi < program.funcs.len() {
        var f: Func = program.funcs.get(fi);
        if HashMap_get(events, f.name) == fi + 1 {
            fi = fi + 1;
            continue;
        }
        var has_emit: bool = tf_has_ann(f.annotations, "emit");
        var is_contract: bool = tf_has_ann(f.annotations, "contract");
        var declared: Vec<str> = em_declared(f);
        // E2: what @emit lists
        if has_emit {
            if declared.len() == 0 {
                self.errors.push("Event error: '" + f.name + "' has @emit with no events.\n    Fix: list the events it emits: @emit(Transfer, Approval).");
            }
            var di: i64 = 0;
            while di < declared.len() {
                if HashMap_get(events, declared.get(di)) == 0 {
                    self.errors.push("Event error: '" + f.name + "' declares @emit(" + declared.get(di) + "), but '" + declared.get(di) + "' is not an @event function.\n    Fix: declare it: `@event fn " + declared.get(di) + "(...) {}`, or correct the name.");
                }
                di = di + 1;
            }
        }
        if !has_emit && !is_contract {
            // E3: a direct emission must be declared
            var facts: PfFacts = pf_facts(f);
            var ci2: i64 = 0;
            while ci2 < facts.calls.len() {
                var c2: str = facts.calls.get(ci2);
                if HashMap_get(events, c2) != 0 && !str_vec_contains(facts.lets, c2) {
                    self.errors.push("Event error: '" + f.name + "' emits '" + c2 + "' without declaring it.\n    The compiler tracks which events each function can emit.\n    Fix: write @emit(" + c2 + ") on '" + f.name + "'.");
                }
                ci2 = ci2 + 1;
            }
            fi = fi + 1;
            continue;
        }
        // E4 (and C2, C3): everything f reaches
        var reach: PfReach = pf_reach(program, index, fi);
        var emitted: Vec<str> = Vec::new();
        var via: Vec<str> = Vec::new();
        var reentry: str = "";
        var reported: i64 = HashMap_new();
        var k: i64 = 0;
        while k < reach.fis.len() {
            var g: Func = program.funcs.get(reach.fis.get(k));
            var gf: PfFacts = reach.facts.get(k);
            var gi: i64 = 0;
            while gi < gf.calls.len() {
                var c3: str = gf.calls.get(gi);
                var is_value: bool = str_vec_contains(gf.lets, c3);
                if !is_value && HashMap_get(events, c3) != 0 && !str_vec_contains(emitted, c3) {
                    emitted.push(c3);
                    via.push(g.name);
                }
                if is_contract && !is_value && c3 == f.name && reentry == "" {
                    reentry = g.name;
                }
                if is_contract && is_value && HashMap_get(reported, g.name + "." + c3) == 0 {
                    HashMap_insert(reported, g.name + "." + c3, 1);
                    self.errors.push("Contract error: @contract '" + f.name + "' calls '" + c3 + "', a function value (in '" + g.name + "').\n    The verifier must know every call a contract makes: a function value can be any code,\n    including code that calls back into the contract.\n    Fix: call a named function, or choose among named functions with `match`.");
                }
                gi = gi + 1;
            }
            k = k + 1;
        }
        var ei: i64 = 0;
        while ei < emitted.len() {
            var e: str = emitted.get(ei);
            if !str_vec_contains(declared, e) {
                var thru: str = "";
                if via.get(ei) != f.name {
                    thru = " (through '" + via.get(ei) + "')";
                }
                self.errors.push("Event error: '" + f.name + "' can emit '" + e + "'" + thru + ", which its @emit does not list.\n    A function's @emit is the set of events it can emit, through everything it calls.\n    Fix: add " + e + " to its @emit(...).");
            }
            ei = ei + 1;
        }
        var dj: i64 = 0;
        while dj < declared.len() {
            var d: str = declared.get(dj);
            if HashMap_get(events, d) != 0 && !str_vec_contains(emitted, d) {
                self.errors.push("Event error: '" + f.name + "' declares @emit(" + d + ") but never emits it.\n    No path through '" + f.name + "' or what it calls reaches " + d + "(...): a log reader waiting for it would wait forever.\n    Fix: remove " + d + " from its @emit(...), or emit it.");
            }
            dj = dj + 1;
        }
        if is_contract {
            var head: str = "Contract error: @contract '" + f.name + "' ";
            if !tf_has_ann(f.annotations, "deterministic") {
                self.errors.push(head + "is not @deterministic.\n    Every node of the chain runs the contract and must reach the same state.\n    Fix: add @deterministic (no IO, Net, Spawn or floating point).");
            }
            if !tf_has_ann(f.annotations, "gas") {
                self.errors.push(head + "has no gas limit.\n    A contract's cost must be bounded before it runs, or one call could stall every node.\n    Fix: add @gas(N) with the most it may cost.");
            }
            if reentry != "" {
                var through: str = "";
                if reentry != f.name {
                    through = " (through '" + reentry + "')";
                }
                self.errors.push(head + "can call itself again before it returns" + through + ": reentrancy.\n    A second entry runs while the first has not finished updating the state, and sees it half-changed.\n    Fix: finish the state change in one pass, without a call path back into '" + f.name + "'.");
            }
        }
        fi = fi + 1;
    }
}

pub fn TypeChecker_verify_contracts(self: &mut TypeChecker, program: Program) {
    // `given` preconditions (F10): a call whose constant arguments make a
    // precondition false is rejected at compile time (src/typechecker.rs
    // verify_contracts; non-constant arguments are left to runtime).
    var pre_names: Vec<str> = Vec::new();
    var pre_funcs: Vec<Func> = Vec::new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        if func.preconditions.len() > 0 {
            pre_names.push(func.name);
            pre_funcs.push(func);
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            if imp.methods.get(mi).preconditions.len() > 0 {
                pre_names.push(imp.struct_name + "_" + imp.methods.get(mi).name);
                pre_funcs.push(imp.methods.get(mi));
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    if pre_names.len() == 0 {
        return;
    }
    var bodies: Vec<StmtList> = Vec::new();
    var bi: i64 = 0;
    while bi < program.funcs.len() {
        bodies.push(program.funcs.get(bi).body);
        bi = bi + 1;
    }
    var ii2: i64 = 0;
    while ii2 < program.impls.len() {
        var imp2: ImplDef = program.impls.get(ii2);
        var mi2: i64 = 0;
        while mi2 < imp2.methods.len() {
            bodies.push(imp2.methods.get(mi2).body);
            mi2 = mi2 + 1;
        }
        ii2 = ii2 + 1;
    }
    var k: i64 = 0;
    while k < bodies.len() {
        var callees: Vec<str> = Vec::new();
        var argss: Vec<Vec<Expr>> = Vec::new();
        cs_stmts(bodies.get(k), &mut callees, &mut argss);
        var ci: i64 = 0;
        while ci < callees.len() {
            var pi: i64 = 0;
            while pi < pre_names.len() {
                if pre_names.get(pi) == callees.get(ci) {
                    var pf: Func = pre_funcs.get(pi);
                    var bnames: Vec<str> = Vec::new();
                    var bvals: Vec<i64> = Vec::new();
                    var args: Vec<Expr> = argss.get(ci);
                    var ai: i64 = 0;
                    while ai < pf.params.len() && ai < args.len() {
                        var cv: Vec<i64> = Vec::new();
                        if ct_eval_int(args.get(ai), Vec::new(), Vec::new(), &mut cv) {
                            bnames.push(pf.params.get(ai).name);
                            bvals.push(cv.get(0));
                        }
                        ai = ai + 1;
                    }
                    var qi: i64 = 0;
                    while qi < pf.preconditions.len() {
                        // 1 = true, 0 = false, -1 = unknown
                        if ct_eval_bool(pf.preconditions.get(qi), bnames, bvals) == 0 {
                            self.errors.push("Contract error (F10): precondition violated in call to '" + callees.get(ci) + "'. The 'given' contract is not satisfied with the provided arguments.");
                        }
                        qi = qi + 1;
                    }
                }
                pi = pi + 1;
            }
            ci = ci + 1;
        }
        k = k + 1;
    }
}

/// Collect the direct calls (callee, args) in statements, at any depth.
fn cs_stmts(stmts: Vec<Stmt>, callees: &mut Vec<str>, argss: &mut Vec<Vec<Expr>>) {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Let(_, _, e, _, _, _, _) => {
                cs_expr(e, callees, argss);
            }
            Stmt::LetTuple(_, e, _) => {
                cs_expr(e, callees, argss);
            }
            Stmt::Expr(e, _) => {
                cs_expr(e, callees, argss);
            }
            Stmt::Assign(_, _, e, _) => {
                cs_expr(e, callees, argss);
            }
            Stmt::IndexAssign(_, ix, _, e, _) => {
                cs_expr(ix, callees, argss);
                cs_expr(e, callees, argss);
            }
            Stmt::DerefAssign(pe, _, e, _) => {
                cs_expr(pe, callees, argss);
                cs_expr(e, callees, argss);
            }
            Stmt::FieldAssign(o, _, _, e, _) => {
                cs_expr(o, callees, argss);
                cs_expr(e, callees, argss);
            }
            Stmt::Return(oe, _) => {
                match oe {
                    OptBoxExpr::Some(re) => {
                        cs_expr(box_expr_unbox(re), callees, argss);
                    }
                    OptBoxExpr::None => {
                    }
                }
            }
            Stmt::If(c, tb, eb, _) => {
                cs_expr(c, callees, argss);
                cs_stmts(tb, callees, argss);
                match eb {
                    OptStmts::Some(e2) => {
                        cs_stmts(e2, callees, argss);
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(c, b, _) => {
                cs_expr(c, callees, argss);
                cs_stmts(b, callees, argss);
            }
            Stmt::For(_, it, b, _) => {
                cs_expr(it, callees, argss);
                cs_stmts(b, callees, argss);
            }
            Stmt::Loop(b, _) => {
                cs_stmts(b, callees, argss);
            }
            Stmt::Defer(b, _) => {
                cs_stmts(b, callees, argss);
            }
            Stmt::Match(e, arms, _) => {
                cs_expr(e, callees, argss);
                var ai: i64 = 0;
                while ai < arms.len() {
                    cs_stmts(arms.get(ai).body, callees, argss);
                    ai = ai + 1;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

fn cs_exprs(es: Vec<Expr>, callees: &mut Vec<str>, argss: &mut Vec<Vec<Expr>>) {
    var i: i64 = 0;
    while i < es.len() {
        cs_expr(es.get(i), callees, argss);
        i = i + 1;
    }
}

fn cs_expr(expr: Expr, callees: &mut Vec<str>, argss: &mut Vec<Vec<Expr>>) {
    match expr {
        Expr::Call(callee, args) => {
            callees.push(callee);
            argss.push(args);
            cs_exprs(args, callees, argss);
        }
        Expr::MethodCall(recv, _, args) => {
            cs_expr(box_expr_unbox(recv), callees, argss);
            cs_exprs(args, callees, argss);
        }
        Expr::Binary(_, l, r) => {
            cs_expr(box_expr_unbox(l), callees, argss);
            cs_expr(box_expr_unbox(r), callees, argss);
        }
        Expr::Unary(_, e) => {
            cs_expr(box_expr_unbox(e), callees, argss);
        }
        Expr::FieldAccess(e, _) => {
            cs_expr(box_expr_unbox(e), callees, argss);
        }
        Expr::Index(a, ix) => {
            cs_expr(box_expr_unbox(a), callees, argss);
            cs_expr(box_expr_unbox(ix), callees, argss);
        }
        Expr::If(c, tb, eb) => {
            cs_expr(box_expr_unbox(c), callees, argss);
            cs_stmts(tb, callees, argss);
            match eb {
                OptStmts::Some(e2) => {
                    cs_stmts(e2, callees, argss);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Block(b) => {
            cs_stmts(b, callees, argss);
        }
        _ => {
        }
    }
}

/// Constant integer value of `expr` under the bindings (pushed to `out`).
fn ct_eval_int(expr: Expr, bnames: Vec<str>, bvals: Vec<i64>, out: &mut Vec<i64>) -> bool {
    match expr {
        Expr::IntLit(n) => {
            out.push(n);
            return true;
        }
        Expr::Ident(name) => {
            var i: i64 = 0;
            while i < bnames.len() {
                if bnames.get(i) == name {
                    out.push(bvals.get(i));
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        Expr::Unary(op, e) => {
            if unaryop_eq(op, UnaryOp::Neg) {
                var v: Vec<i64> = Vec::new();
                if ct_eval_int(box_expr_unbox(e), bnames, bvals, &mut v) {
                    out.push(0 - v.get(0));
                    return true;
                }
            }
            return false;
        }
        Expr::Binary(op, l, r) => {
            var lv: Vec<i64> = Vec::new();
            var rv: Vec<i64> = Vec::new();
            if !ct_eval_int(box_expr_unbox(l), bnames, bvals, &mut lv) {
                return false;
            }
            if !ct_eval_int(box_expr_unbox(r), bnames, bvals, &mut rv) {
                return false;
            }
            var a: i64 = lv.get(0);
            var b: i64 = rv.get(0);
            if binop_eq(op, BinOp::Add) {
                out.push(a + b);
                return true;
            }
            if binop_eq(op, BinOp::Sub) {
                out.push(a - b);
                return true;
            }
            if binop_eq(op, BinOp::Mul) {
                out.push(a * b);
                return true;
            }
            if binop_eq(op, BinOp::Div) && b != 0 {
                out.push(a / b);
                return true;
            }
            if binop_eq(op, BinOp::Mod) && b != 0 {
                out.push(a % b);
                return true;
            }
            return false;
        }
        _ => {
        }
    }
    return false;
}

/// 1 = true, 0 = false, -1 = unknown.
fn ct_eval_bool(expr: Expr, bnames: Vec<str>, bvals: Vec<i64>) -> i64 {
    match expr {
        Expr::BoolLit(bv) => {
            if bv {
                return 1;
            }
            return 0;
        }
        Expr::Binary(op, l, r) => {
            if binop_eq(op, BinOp::And) {
                var lb: i64 = ct_eval_bool(box_expr_unbox(l), bnames, bvals);
                if lb < 0 {
                    return -1;
                }
                if lb == 0 {
                    return 0;
                }
                return ct_eval_bool(box_expr_unbox(r), bnames, bvals);
            }
            if binop_eq(op, BinOp::Or) {
                var lb2: i64 = ct_eval_bool(box_expr_unbox(l), bnames, bvals);
                if lb2 < 0 {
                    return -1;
                }
                if lb2 == 1 {
                    return 1;
                }
                return ct_eval_bool(box_expr_unbox(r), bnames, bvals);
            }
            var lv: Vec<i64> = Vec::new();
            var rv: Vec<i64> = Vec::new();
            if !ct_eval_int(box_expr_unbox(l), bnames, bvals, &mut lv) {
                return -1;
            }
            if !ct_eval_int(box_expr_unbox(r), bnames, bvals, &mut rv) {
                return -1;
            }
            var a: i64 = lv.get(0);
            var b: i64 = rv.get(0);
            var res: bool = false;
            if binop_eq(op, BinOp::Lt) {
                res = a < b;
            } else if binop_eq(op, BinOp::Gt) {
                res = a > b;
            } else if binop_eq(op, BinOp::LtEq) {
                res = a <= b;
            } else if binop_eq(op, BinOp::GtEq) {
                res = a >= b;
            } else if binop_eq(op, BinOp::Eq) {
                res = a == b;
            } else if binop_eq(op, BinOp::Neq) {
                res = a != b;
            } else {
                return -1;
            }
            if res {
                return 1;
            }
            return 0;
        }
        _ => {
        }
    }
    return -1;
}

pub fn TypeChecker_verify_allocator_params(self: &mut TypeChecker, program: Program) {
    // @allocator: custom allocator parameters
    // Verifies that @allocator annotated functions have valid allocator params.
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var func: Func = program.funcs.get(fi);
        var ai: i64 = 0;
        while ai < func.annotations.len() {
            var ann: Annotation = func.annotations.get(ai);
            if ann.name == "allocator" {
                // @allocator requires at least one arg (the allocator name or type)
                if ann.args.len() == 0 {
                    self.errors.push("Allocator error: function '" + func.name + "' has @allocator but no allocator parameter specified");
                }
            }
            ai = ai + 1;
        }
        fi = fi + 1;
    }
}

// --- check_func ----------------------------------------------------------

/// `@unsafe fn` is one `unsafe` block around the whole body.
/// CE6: true the first time an undefined `name` is met in this function.
fn TypeChecker_first_report(self: &mut TypeChecker, name: str) -> bool {
    val key: str = self.checking_fn + ":" + name;
    if str_vec_contains(self.reported_undefined, key) {
        return false;
    }
    self.reported_undefined.push(key);
    return true;
}

/// CE6: whether `ty` stands for an error already reported: `never` is what
/// a failed expression gives (an undefined name, a missing field, a failed
/// call), so negating it, testing it, indexing it or reading its fields or
/// methods is a dependent error and is not reported again. Only once some
/// error has been reported: a `never` met without one still gets its error,
/// so nothing wrong is accepted.
fn TypeChecker_is_reported(self: &TypeChecker, ty: Type) -> bool {
    return self.errors.len() > 0 && type_eq(ty, Type::Never);
}

/// CE6: whether `n` names a type the program can mean: a struct, an enum,
/// an alias, a trait, a type parameter in scope (or any declared one), a
/// qualified or generated name, or a type the checker knows without a
/// declaration.
fn TypeChecker_ce6_type_name_known(self: &TypeChecker, n: str) -> bool {
    if str_len(n) == 0 || n == "Self" || str_starts_with(n, "__") || str_find(n, ".") >= 0 || str_find(n, "::") >= 0 {
        return true;
    }
    if str_len(n) == 1 {
        return true;
    }
    if n == "Vec" || n == "HashMap" || n == "Option" || n == "Result" || n == "Box" || n == "Rc" || n == "Arc" || n == "Weak" || n == "Tensor" || n == "Channel" || n == "Task" || n == "Future" || n == "Mutex" || n == "RwLock" || n == "Cell" || n == "RefCell" || n == "String" || n == "usize" || n == "isize" || n == "char" || n == "f16" || n == "Any" || n == "Set" || n == "HashSet" || n == "Sender" || n == "Receiver" || n == "Region" || n == "Ptr" || n == "Slice" || n == "Range" || n == "Iterator" || n == "Fn" || n == "FnMut" || n == "FnOnce" {
        return true;
    }
    match self.current_self_type {
        OptString::Some(st) => {
            if st == n {
                return true;
            }
        }
        OptString::None => {
        }
    }
    if tc_str_vec_contains(self.current_type_params, n) {
        return true;
    }
    match TypeChecker_lookup_struct_cache(self, n) {
        OptVecStructField::Some(_) => {
            return true;
        }
        OptVecStructField::None => {
        }
    }
    if TypeChecker_is_known_enum(self, n) {
        return true;
    }
    match TypeChecker_lookup_alias_cache(self, n) {
        OptType::Some(_) => {
            return true;
        }
        OptType::None => {
        }
    }
    match map_traits_get(self.traits, n) {
        OptTraitMethodMap::Some(_) => {
            return true;
        }
        OptTraitMethodMap::None => {
        }
    }
    if HashMap_get(self.enum_tp_set, n) > 0 {
        return true;
    }
    var i: i64 = 0;
    while i < self.impl_tp_lists.len() {
        if tc_str_vec_contains(self.impl_tp_lists.get(i), n) {
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while i < self.struct_tp_lists.len() {
        if tc_str_vec_contains(self.struct_tp_lists.get(i), n) {
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while i < self.func_generic_tps.len() {
        if tc_str_vec_contains(self.func_generic_tps.get(i), n) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// CA6: whether `e` starts a task whose handle must be kept: `spawn f(..)`
/// (`spawn detached f(..)` parses to `__spawn_detached(spawn f(..))`, and
/// `spawn scope { }` is a statement of its own).
fn tc_ca6_is_spawn(e: Expr) -> bool {
    match e {
        Expr::Spawn(_) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

/// CA6: `name` was read, so the task handle of that name (if one is
/// pending) is awaited, joined or passed on, not left behind.
fn TypeChecker_ca6_note_read(self: &mut TypeChecker, name: str) {
    var keep_n: Vec<str> = Vec::new();
    var keep_l: Vec<i64> = Vec::new();
    var hit: bool = false;
    var i: i64 = 0;
    while i < self.ca6_names.len() {
        if self.ca6_names.get(i) == name {
            hit = true;
        } else {
            keep_n.push(self.ca6_names.get(i));
            keep_l.push(self.ca6_lines.get(i));
        }
        i = i + 1;
    }
    if hit {
        self.ca6_names = keep_n;
        self.ca6_lines = keep_l;
    }
}

/// CA6: a task started outside any `spawn scope { }` whose handle is
/// dropped could outlive the function that started it.
fn TypeChecker_ca6_unjoined(self: &mut TypeChecker, line: i64, what: str) {
    var where_fn: str = "";
    if str_len(self.checking_fn) > 0 {
        where_fn = " in '" + self.checking_fn + "'";
    }
    self.errors.push("Concurrency error (line " + int_to_str(line) + "): " + what + where_fn + " is never awaited, joined or detached, so it could outlive the function that started it." + "\n    Fix: keep its handle and await it (`val t = spawn f(x); ... await t`), start it inside `spawn scope { ... }` (the scope joins its tasks), or detach it by name: `spawn detached f(x)`.");
}

/// CE6: the first name in the type `ty` that names no type, or "" when
/// every name is known.
fn TypeChecker_ce6_unknown_type(self: &TypeChecker, ty: Type) -> str {
    match ty {
        Type::Named(n) => {
            if TypeChecker_ce6_type_name_known(self, n) {
                return "";
            }
            return n;
        }
        Type::Generic(gn, args) => {
            if !TypeChecker_ce6_type_name_known(self, gn) {
                return gn;
            }
            var i: i64 = 0;
            while i < args.len() {
                val u: str = TypeChecker_ce6_unknown_type(self, args.get(i));
                if str_len(u) > 0 {
                    return u;
                }
                i = i + 1;
            }
            return "";
        }
        Type::Ref(inner, _) => {
            return TypeChecker_ce6_unknown_type(self, box_type_unbox(inner));
        }
        Type::RawPtr(inner, _) => {
            return TypeChecker_ce6_unknown_type(self, box_type_unbox(inner));
        }
        Type::Array(elem, _) => {
            return TypeChecker_ce6_unknown_type(self, box_type_unbox(elem));
        }
        Type::ArrayConst(elem, _) => {
            return TypeChecker_ce6_unknown_type(self, box_type_unbox(elem));
        }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                val u: str = TypeChecker_ce6_unknown_type(self, types.get(i));
                if str_len(u) > 0 {
                    return u;
                }
                i = i + 1;
            }
            return "";
        }
        _ => {
            return "";
        }
    }
    return "";
}

pub fn TypeChecker_check_func(self: &mut TypeChecker, func: Func) {
    var whole: bool = false;
    var ai: i64 = 0;
    while ai < func.annotations.len() {
        if func.annotations.get(ai).name == "unsafe" {
            whole = true;
        }
        ai = ai + 1;
    }
    self.checking_fn = func.name;
    var saved_conserve: bool = self.in_conserve;
    self.in_conserve = tc_has_conserve(func);
    // Whether this body is @no-alloc (directly or through a composite like
    // @medical): string `+` allocates, so the typed check below reports it
    var saved_no_alloc: bool = self.in_no_alloc;
    self.in_no_alloc = has_primitive(expand_safety_primitives(func.annotations), "no-alloc");
    if whole {
        self.unsafe_depth = self.unsafe_depth + 1;
    }
    TypeChecker_check_func_body(self, func);
    if whole {
        self.unsafe_depth = self.unsafe_depth - 1;
    }
    self.in_conserve = saved_conserve;
    self.in_no_alloc = saved_no_alloc;
}

fn TypeChecker_check_func_body(self: &mut TypeChecker, func: Func) {
    self.current_func_name = OptString::Some(func.name);
    // CD8: a `comptime fn` body is comptime code: no I/O
    var saved_ct_depth: i64 = g_tc_comptime_depth;
    if func.is_comptime {
        g_tc_comptime_depth = g_tc_comptime_depth + 1;
    }
    // the errors this body adds (2g.27: tagged with its module below)
    var err_from: i64 = self.errors.len();
    var empty_ret: Vec<Type> = Vec::new();
    self.current_return_types = empty_ret;
    var saved_ret_ty: OptType = self.current_ret_ty;
    self.current_ret_ty = OptType::None;
    // `?` here returns from this function (2g.55)
    g_tc_try_depth = 0;
    match func.ret_ty {
        Type::Infer => {
        }
        _ => {
            var declared_ret: Type = TypeChecker_resolve_self_type(self, func.ret_ty);
            // async fn: the body returns T for a declared Future<T>
            if func.is_async {
                match declared_ret {
                    Type::Generic(gname, gargs) => {
                        if gname == "Future" && gargs.len() == 1 {
                            declared_ret = gargs.get(0);
                        }
                    }
                    _ => {
                    }
                }
            }
            self.current_ret_ty = OptType::Some(declared_ret);
        }
    }
    // Set current_module to the module where this function was defined
    var saved_module: str = self.current_module;
    var mangled: str = "";
    match self.current_self_type {
        OptString::Some(s) => {
            mangled = s + "_" + func.name;
        }
        OptString::None => {
            mangled = "";
        }
    }
    if mangled != "" {
        match TypeChecker_get_item_module(self, mangled) {
            OptString::Some(mod_name) => {
                self.current_module = mod_name;
            }
            OptString::None => {
                match TypeChecker_get_item_module(self, func.name) {
                    OptString::Some(mod_name) => {
                        self.current_module = mod_name;
                    }
                    OptString::None => {
                    }
                }
            }
        }
    } else {
        match TypeChecker_get_item_module(self, func.name) {
            OptString::Some(mod_name) => {
                self.current_module = mod_name;
            }
            OptString::None => {
            }
        }
        // A synthesized __eq_S belongs to S's module (as a derive expands in
        // place), so it may read S's private fields
        if str_starts_with(func.name, "__eq_") {
            match TypeChecker_get_item_module(self, str_slice(func.name, 5, str_len(func.name))) {
                OptString::Some(eq_mod) => {
                    self.current_module = eq_mod;
                }
                OptString::None => {
                }
            }
        }
    }
    // Reset linear tracking
    var saved_consumed: Vec<str> = self.consumed_vars;
    var empty_consumed: Vec<str> = Vec::new();
    self.consumed_vars = empty_consumed;
    // a `return` of this body checks the linear variables of its scopes
    var saved_linear_base: i64 = g_tc_linear_base;
    g_tc_linear_base = self.scope_linear_vars.len();
    TypeChecker_push_scope(self);
    // Track type parameters
    var saved_vp_names: Vec<str> = self.value_param_names;
    var saved_vp_types: Vec<Type> = self.value_param_types;
    var vp_names: Vec<str> = Vec::new();
    var vp_types: Vec<Type> = Vec::new();
    var vpi: i64 = 0;
    while vpi < func.params.len() {
        var vpt: Type = TypeChecker_resolve_type(self, func.params.get(vpi).ty);
        var aggregate: bool = false;
        match vpt {
            Type::Generic(gn, _) => {
                aggregate = gn == "Vec" || gn == "HashMap";
            }
            Type::Named(nn) => {
                aggregate = nn == "Vec" || nn == "HashMap" || tc_is_struct(self, nn);
            }
            _ => {
            }
        }
        if aggregate && func.params.get(vpi).name != "self" {
            vp_names.push(func.params.get(vpi).name);
            vp_types.push(func.params.get(vpi).ty);
        }
        vpi = vpi + 1;
    }
    self.value_param_names = vp_names;
    self.value_param_types = vp_types;
    // (an impl method also sees its impl's: `impl<T> Slot` puts T in scope)
    var saved_tp: Vec<str> = self.current_type_params;
    var tps: Vec<str> = Vec::new();
    var tpi0: i64 = 0;
    while tpi0 < saved_tp.len() {
        tps.push(saved_tp.get(tpi0));
        tpi0 = tpi0 + 1;
    }
    tpi0 = 0;
    while tpi0 < func.type_params.len() {
        tps.push(func.type_params.get(tpi0));
        tpi0 = tpi0 + 1;
    }
    self.current_type_params = tps;
    // Track trait bounds
    var saved_bounds: Vec<StringString> = self.current_type_param_bounds;
    var empty_bounds: Vec<StringString> = Vec::new();
    self.current_type_param_bounds = empty_bounds;
    var bi: i64 = 0;
    while bi < func.type_param_bounds.len() {
        var bound: StrPair = func.type_param_bounds.get(bi);
        self.current_type_param_bounds.push(StringString_new(bound.a, bound.b));
        bi = bi + 1;
    }
    // Declare const generic params
    var cpi: i64 = 0;
    while cpi < func.const_params.len() {
        var cp: StrPair = func.const_params.get(cpi);
        var ty: Type = Type::I64;
        var ty_name: str = cp.b;
        if ty_name == "i8" {
            ty = Type::I8;
        } else if ty_name == "i16" {
            ty = Type::I16;
        } else if ty_name == "i32" {
            ty = Type::I32;
        } else if ty_name == "i64" {
            ty = Type::I64;
        } else if ty_name == "u8" {
            ty = Type::U8;
        } else if ty_name == "u16" {
            ty = Type::U16;
        } else if ty_name == "u32" {
            ty = Type::U32;
        } else if ty_name == "u64" {
            ty = Type::U64;
        } else {
            ty = Type::I64;
        }
        TypeChecker_declare(self, cp.a, ty);
        cpi = cpi + 1;
    }
    // Declare parameters
    var pi: i64 = 0;
    while pi < func.params.len() {
        var resolved_ty: Type = TypeChecker_resolve_self_type(self, func.params.get(pi).ty);
        TypeChecker_declare(self, func.params.get(pi).name, resolved_ty);
        // @conserve: a linear value taken by value (Money, or a struct
        // holding it) must leave the function -- returned or passed on --
        // or the money in it is destroyed. A borrow (&Money) is not owned.
        // (stdlib/money.fd's operations are the trusted base: they build
        // their result from the amounts they read)
        if self.in_conserve && TypeChecker_is_linear_type(self, resolved_ty) && !TypeChecker_in_money_module(self, func.name) {
            var by_ref: bool = false;
            match resolved_ty {
                Type::Ref(_, _) => {
                    by_ref = true;
                }
                _ => {
                }
            }
            if !by_ref && self.scope_linear_vars.len() > 0 {
                var pscope: Vec<LinearVar> = self.scope_linear_vars.pop();
                pscope.push(LinearVar_new(func.params.get(pi).name, self.current_line));
                self.scope_linear_vars.push(pscope);
            }
        }
        pi = pi + 1;
    }
    // CA6: the task handles this body leaves behind (a nested body has its own)
    var saved_ca6_names: Vec<str> = self.ca6_names;
    var saved_ca6_lines: Vec<i64> = self.ca6_lines;
    var saved_ca6_depth: i64 = self.ca6_scope_depth;
    var empty_ca6_names: Vec<str> = Vec::new();
    var empty_ca6_lines: Vec<i64> = Vec::new();
    self.ca6_names = empty_ca6_names;
    self.ca6_lines = empty_ca6_lines;
    self.ca6_scope_depth = 0;
    // Check body statements
    var si: i64 = 0;
    while si < func.body.len() {
        TypeChecker_check_stmt(self, func.body.get(si));
        si = si + 1;
    }
    var cai: i64 = 0;
    while cai < self.ca6_names.len() {
        val ca6_line: i64 = self.ca6_lines.get(cai);
        val ca6_what: str = "the task whose handle is '" + self.ca6_names.get(cai) + "'";
        TypeChecker_ca6_unjoined(self, ca6_line, ca6_what);
        cai = cai + 1;
    }
    self.ca6_names = saved_ca6_names;
    self.ca6_lines = saved_ca6_lines;
    self.ca6_scope_depth = saved_ca6_depth;
    // Bidirectional type inference: if return type is _, infer from body
    if type_eq(func.ret_ty, Type::Infer) {
        var inferred: Type = Type::Void;
        var ri: i64 = 0;
        while ri < self.current_return_types.len() {
            var rt: Type = self.current_return_types.get(ri);
            if !type_eq(rt, Type::Void) && !type_eq(rt, Type::Never) {
                inferred = rt;
                break;
            }
            ri = ri + 1;
        }
        // Update function signature in symbol table
        var fi: i64 = 0;
        while fi < self.funcs.len() {
            if self.funcs.get(fi).key == func.name {
                var f_entry: StringFuncSig = self.funcs.get(fi);
                f_entry.val.ret_ty = inferred;
                self.funcs.set(fi, f_entry);
                // and for the lowering, which reads the Program (ast.fd)
                infer_ret_note(func.name, inferred);
                break;
            }
            fi = fi + 1;
        }
    }
    // Restore state
    self.current_type_params = saved_tp;
    self.value_param_names = saved_vp_names;
    self.value_param_types = saved_vp_types;
    self.current_type_param_bounds = saved_bounds;
    TypeChecker_pop_scope(self);
    // A function declared to return a value must not fall off the end of its
    // body (mirrors src/typechecker.rs).
    match self.current_ret_ty {
        OptType::Some(declared) => {
            var returns_value: bool = true;
            match declared {
                Type::Void => {
                    returns_value = false;
                }
                Type::Never => {
                    returns_value = false;
                }
                Type::Infer => {
                    returns_value = false;
                }
                _ => {
                }
            }
            if returns_value && func.name != "main" && !stmts_always_leave(func.body) {
                self.errors.push("Type error: '" + func.name + "' is declared to return " + type_to_str(declared) + " but can reach the end of its body without returning");
            }
        }
        OptType::None => {
        }
    }
    self.consumed_vars = saved_consumed;
    // TL2: an error about the function as a whole (no statement gave it a
    // line: "'f' is declared to return i64 but can reach the end ...")
    // is placed at its `fn`
    if func.line > 0 {
        var pi: i64 = err_from;
        while pi < self.errors.len() {
            var pe: str = self.errors.get(pi);
            if !tc_err_has_place(pe) {
                self.errors.set(pi, tc_err_at_line(pe, func.line));
            }
            pi = pi + 1;
        }
    }
    // 2g.27: a body of another module than the one being compiled (an
    // import, core) has its errors say so; their "(line N)" is a line of
    // that module's file, not of the importing file
    var own_key: str = func.name;
    if mangled != "" {
        own_key = mangled;
    }
    if self.current_module != saved_module && str_len(self.current_module) > 0 && !HashMap_contains(self.last_fn_names, own_key) {
        tc_tag_module_errors(self, err_from, self.current_module);
    }
    self.current_module = saved_module;
    self.current_ret_ty = saved_ret_ty;
    self.current_func_name = OptString::None;
    g_tc_comptime_depth = saved_ct_depth;
    g_tc_linear_base = saved_linear_base;
}

/// 2g.37: the modules (written `a::b`) of the functions renamed
/// `<module>__<name>` because more than one imported module defines `name`
/// (compiler.fd cc_qualify_shadowed_imports). Only a function the
/// typechecker registered under that module counts, so a name that merely
/// ends in `__<name>` is not taken for one. Run on the error path only.
fn tc_ambiguous_modules(self: &TypeChecker, name: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var suffix: str = "__" + name;
    var sl: i64 = str_len(suffix);
    var i: i64 = 0;
    while i < self.funcs.len() {
        var k: str = self.funcs.get(i).key;
        var kl: i64 = str_len(k);
        if kl > sl && str_ends_with(k, suffix) {
            var m: str = str_replace(str_slice(k, 0, kl - sl), "__", "::");
            match TypeChecker_get_item_module(self, k) {
                OptString::Some(km) => {
                    if km == m && !str_vec_contains(out, m) {
                        out.push(m);
                    }
                }
                OptString::None => {
                }
            }
        }
        i = i + 1;
    }
    return out;
}

/// 2g.27: name `module` in the errors from index `from` on. "(line N)"
/// becomes "(module 'm', line N)": compiler.fd's enrich_errors no longer
/// finds "(line " in it, so the error is not shown against line N of the
/// importing file (the line is the module file's). An error without a line
/// gets " (module 'm')" before its first ": ". An error that already names
/// a module is left as it is.
fn tc_tag_module_errors(self: &mut TypeChecker, from: i64, module: str) {
    var i: i64 = from;
    while i < self.errors.len() {
        var e: str = self.errors.get(i);
        if str_find(e, "(module '") < 0 && str_find(e, " in " + module) < 0 {
            var at: i64 = str_find(e, "(line ");
            if at >= 0 {
                e = str_slice(e, 0, at) + "(module '" + module + "', line " + str_slice(e, at + 6, str_len(e));
            } else {
                var colon: i64 = str_find(e, ": ");
                if colon > 0 {
                    e = str_slice(e, 0, colon) + " (module '" + module + "')" + str_slice(e, colon, str_len(e));
                } else {
                    e = e + " (module '" + module + "')";
                }
            }
            self.errors.set(i, e);
        }
        i = i + 1;
    }
}

// Whether control can never reach the end of `stmts`: it ends in `return`, a
// trailing expression (the block's value), an if/else or match whose branches
// all leave, an infinite loop without `break`, or a block that always leaves.
pub fn stmts_always_leave(stmts: Vec<Stmt>) -> bool {
    if stmts.len() == 0 {
        return false;
    }
    match stmts.get(stmts.len() - 1) {
        Stmt::Return(_, _) => {
            return true;
        }
        Stmt::Expr(_, _) => {
            return true;
        }
        Stmt::If(cond, then_block, else_block, _) => {
            match cond {
                Expr::BoolLit(cb) => {
                    if cb {
                        return stmts_always_leave(then_block);
                    }
                    match else_block {
                        OptStmts::Some(eb) => {
                            return stmts_always_leave(eb);
                        }
                        OptStmts::None => {
                            return false;
                        }
                    }
                }
                _ => {
                }
            }
            match else_block {
                OptStmts::Some(eb) => {
                    return stmts_always_leave(then_block) && stmts_always_leave(eb);
                }
                OptStmts::None => {
                    return false;
                }
            }
        }
        Stmt::Match(_, arms, _) => {
            if arms.len() == 0 {
                return false;
            }
            var ai: i64 = 0;
            while ai < arms.len() {
                if !stmts_always_leave(arms.get(ai).body) {
                    return false;
                }
                ai = ai + 1;
            }
            return true;
        }
        Stmt::Loop(body, _) => {
            return !stmts_have_break(body);
        }
        Stmt::While(cond, body, _) => {
            match cond {
                Expr::BoolLit(b) => {
                    return b && !stmts_have_break(body);
                }
                _ => {
                    return false;
                }
            }
        }
        Stmt::Unsafe(body, _) => {
            return stmts_always_leave(body);
        }
        Stmt::Sandbox(body, _) => {
            return stmts_always_leave(body);
        }
        Stmt::Txn(body, _) => {
            return stmts_always_leave(body);
        }
        Stmt::Handle(body, _, _) => {
            return stmts_always_leave(body);
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            return stmts_always_leave(body);
        }
        _ => {
            return false;
        }
    }
    return false;
}

// A `break` that exits the loop whose body is `stmts` (breaks inside nested
// loops belong to those loops).
pub fn stmts_have_break(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Break(_, _) => {
                return true;
            }
            Stmt::If(_, then_block, else_block, _) => {
                if stmts_have_break(then_block) {
                    return true;
                }
                match else_block {
                    OptStmts::Some(eb) => {
                        if stmts_have_break(eb) {
                            return true;
                        }
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::Match(_, arms, _) => {
                var ai: i64 = 0;
                while ai < arms.len() {
                    if stmts_have_break(arms.get(ai).body) {
                        return true;
                    }
                    ai = ai + 1;
                }
            }
            Stmt::Unsafe(body, _) => {
                if stmts_have_break(body) {
                    return true;
                }
            }
            Stmt::Sandbox(body, _) => {
                if stmts_have_break(body) {
                    return true;
                }
            }
            Stmt::Txn(body, _) => {
                if stmts_have_break(body) {
                    return true;
                }
            }
            Stmt::Handle(body, _, _) => {
                if stmts_have_break(body) {
                    return true;
                }
            }
            Stmt::RegionBlock(_, _, _, _, _, body, _) => {
                if stmts_have_break(body) {
                    return true;
                }
            }
            Stmt::SpawnScope(body, _) => {
                if stmts_have_break(body) {
                    return true;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    return false;
}

// --- Scope operations ----------------------------------------------------

pub fn TypeChecker_push_scope(self: &mut TypeChecker) {
    self.scopes.push(Vec::new());
    self.scope_linear_vars.push(Vec::new());
    self.val_vars_per_scope.push(Vec::new());
}

pub fn TypeChecker_pop_scope(self: &mut TypeChecker) {
    // Clean up val_vars for this scope
    if self.val_vars_per_scope.len() > 0 {
        self.val_vars_per_scope.pop();
    }
    // Check that all linear variables in this scope were consumed
    if self.scope_linear_vars.len() > 0 {
        var linear_vars: Vec<LinearVar> = self.scope_linear_vars.pop();
        var i: i64 = 0;
        while i < linear_vars.len() {
            var lv: LinearVar = linear_vars.get(i);
            var lv_done: bool = tc_str_vec_contains(self.consumed_vars, lv.name);
            if !lv_done {
                match TypeChecker_lookup(self, lv.name) {
                    OptType::Some(lty) => {
                        lv_done = TypeChecker_linear_fields_moved(self, lv.name, lty);
                    }
                    OptType::None => {
                    }
                }
            }
            if !lv_done {
                self.errors.push("Linear type error (line " + int_to_str(lv.line) + "): variable '" + lv.name + "' is linear but was never consumed.");
            }
            i = i + 1;
        }
    }
    if self.scopes.len() > 0 {
        self.scopes.pop();
    }
    // RT6: the bare Vecs declared in this scope are out of it
    if rt6_count() > 0 {
        rt6_close(TypeChecker_rt6_fn_key(self), self.scopes.len());
    }
}

pub fn TypeChecker_declare(self: &mut TypeChecker, name: str, ty: Type) {
    if self.scopes.len() > 0 {
        var scope: Vec<ScopeEntry> = self.scopes.pop();
        scope.push(ScopeEntry_new(name, ty));
        self.scopes.push(scope);
    } else {
        var scope: Vec<ScopeEntry> = Vec::new();
        scope.push(ScopeEntry_new(name, ty));
        self.scopes.push(scope);
    }
}

pub fn TypeChecker_lookup(self: &TypeChecker, name: str) -> OptType {
    var i: i64 = self.scopes.len() - 1;
    while i >= 0 {
        var scope: Vec<ScopeEntry> = self.scopes.get(i);
        var j: i64 = 0;
        while j < scope.len() {
            if scope.get(j).key == name {
                return OptType::Some(scope.get(j).val);
            }
            j = j + 1;
        }
        i = i - 1;
    }
    return OptType::None;
}

// --- RT6: an untyped `Vec::new()` typed by its first push -----------------
//
// `var v = Vec::new()` written without a type is a bare Vec. The first push
// (or insert) onto it of a value whose type is a float, bool, string, struct
// or enum (not generic), or a Vec, map or Box of such, makes it a Vec of
// that type: here (the variable is retyped in its scope, so later pushes are
// checked against it and `v.get(i)` is that type) and in the lowering
// (Lowerer_rt6_let_type gives the `let` that type, so the Vec is made with
// that element type and owns its strings, Vecs and structs). The parser
// (pd_infer_vec_lets) already types it from pushed literals; this covers
// calls and variables whose type only the type checker knows. The records
// (one per `let` whose value is a bare Vec) are kept in ast.fd (rt6_add,
// rt6_find, rt6_close, rt6_elem_at), where the lowering reads them.

/// The function being checked as the lowering names it: `S_m` for a method
/// of S (or of a trait impl for S), the function's name otherwise.
fn TypeChecker_rt6_fn_key(self: &TypeChecker) -> str {
    match self.current_self_type {
        OptString::Some(st) => {
            return st + "_" + self.checking_fn;
        }
        OptString::None => {
        }
    }
    return self.checking_fn;
}

fn tc_rt6_is_vec_new(e: Expr) -> bool {
    match e {
        Expr::MethodCall(recv, m, args) => {
            if m != "new" || args.len() != 0 {
                return false;
            }
            match box_expr_unbox(recv) {
                Expr::Ident(rn) => {
                    return rn == "Vec";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// Note a `let` of `name` whose value is a bare Vec. Only an untyped
/// `var v = Vec::new()` (`typable`) can be typed by a push; any other one
/// is noted too, so a push onto it does not type an outer `v` it hides.
fn TypeChecker_rt6_note_let(self: &mut TypeChecker, name: str, typable: bool, line: i64) {
    var state: i64 = 2;
    if typable {
        state = 0;
    }
    rt6_add(TypeChecker_rt6_fn_key(self), name, line, self.scopes.len(), state);
}

/// `name = expr`: a bare Vec given another value than a new empty one (which
/// the lowering makes with the variable's type) is not typed by a later push.
fn TypeChecker_rt6_assigned(self: &TypeChecker, name: str, expr: Expr) {
    if tc_rt6_is_vec_new(expr) || tc_rt5_is_map_new(expr) {
        return;
    }
    var k: i64 = rt6_find(TypeChecker_rt6_fn_key(self), name);
    if k >= 0 && rt6_state(k) == 0 {
        rt6_set_state(k, 2);
    }
}

/// Whether `t` is a concrete type a Vec can hold as written: a number, bool
/// or string, a struct or enum that is not generic, or a Vec, HashMap or Box
/// of such.
fn TypeChecker_rt6_type_ok(self: &mut TypeChecker, t: Type) -> bool {
    if tc_is_str(t) || TypeChecker_is_integer(self, t) {
        return true;
    }
    match t {
        Type::F64 => {
            return true;
        }
        Type::F32 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        Type::Named(n) => {
            if n == "String" || n == "Vec" || n == "HashMap" || n == "Box" || str_vec_contains(self.current_type_params, n) {
                return false;
            }
            if tc_is_struct(self, n) {
                return !tc_str_vec_contains(self.struct_tp_names, n);
            }
            if TypeChecker_enum_pos(self, n) >= 0 {
                return TypeChecker_enum_params_of(self, n).len() == 0;
            }
            return false;
        }
        Type::Generic(gn, gargs) => {
            var want: i64 = 0;
            if gn == "Vec" || gn == "Box" {
                want = 1;
            }
            if gn == "HashMap" {
                want = 2;
            }
            if want == 0 || gargs.len() != want {
                return false;
            }
            var i: i64 = 0;
            while i < gargs.len() {
                if !TypeChecker_rt6_type_ok(self, gargs.get(i)) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// The element type a first push of a `t` gives a bare Vec, or Infer: an
/// integer (the i64 the Vec already is) or a type it cannot take as written.
fn TypeChecker_rt6_elem(self: &mut TypeChecker, t: Type) -> Type {
    if tc_is_str(t) {
        return Type::Str;
    }
    if TypeChecker_is_integer(self, t) || TypeChecker_type_contains_param(self, t) {
        return Type::Infer;
    }
    if TypeChecker_rt6_type_ok(self, t) {
        return t;
    }
    return Type::Infer;
}

/// `receiver.method(args)` on a `recv_ty`: the first push (or insert) onto
/// an untyped `var v = Vec::new()` types it (see above). Returns the
/// receiver's type from here on.
fn TypeChecker_rt6_note_push(self: &mut TypeChecker, receiver: Expr, recv_ty: Type, method: str, arg_types: Vec<Type>) -> Type {
    if rt6_count() == 0 {
        return recv_ty;
    }
    if method == "insert" && arg_types.len() == 2 {
        var on_map: bool = false;
        match recv_ty {
            Type::Named(mn) => {
                on_map = mn == "HashMap";
            }
            Type::Generic(mgn, _) => {
                on_map = mgn == "HashMap";
            }
            _ => {
            }
        }
        if on_map {
            return TypeChecker_rt5_note_insert(self, receiver, recv_ty, arg_types);
        }
    }
    var bare: bool = false;
    match recv_ty {
        Type::Named(bn) => {
            bare = bn == "Vec";
        }
        _ => {
        }
    }
    if !bare {
        return recv_ty;
    }
    var at: i64 = -1;
    if method == "push" && arg_types.len() == 1 {
        at = 0;
    }
    if method == "insert" && arg_types.len() == 2 {
        at = 1;
    }
    if at < 0 {
        return recv_ty;
    }
    var rn: str = "";
    match receiver {
        Expr::Ident(n) => {
            rn = n;
        }
        _ => {
            return recv_ty;
        }
    }
    var k: i64 = rt6_find(TypeChecker_rt6_fn_key(self), rn);
    if k < 0 || rt6_state(k) != 0 {
        return recv_ty;
    }
    var et: Type = TypeChecker_rt6_elem(self, arg_types.get(at));
    if type_eq(et, Type::Infer) {
        rt6_set_state(k, 2);
        return recv_ty;
    }
    rt6_set_typed(k, et);
    var ga: Vec<Type> = Vec::new();
    ga.push(et);
    var vt: Type = Type::Generic("Vec", ga);
    TypeChecker_rt6_retype(self, rn, vt);
    return vt;
}

/// Give the variable `name` (the declaration TypeChecker_lookup finds) the
/// type `ty`.
fn TypeChecker_rt6_retype(self: &mut TypeChecker, name: str, ty: Type) {
    var i: i64 = self.scopes.len() - 1;
    while i >= 0 {
        var scope: Vec<ScopeEntry> = self.scopes.get(i);
        var j: i64 = 0;
        while j < scope.len() {
            if scope.get(j).key == name {
                scope.set(j, ScopeEntry_new(name, ty));
                self.scopes.set(i, scope);
                return;
            }
            j = j + 1;
        }
        i = i - 1;
    }
}

// --- RT5: an untyped `HashMap::new()` typed by its first insert ----------
//
// `var m = HashMap::new()` written without a type is a HashMap<str, i64>
// here, and a map of word keys to the lowering. Its first insert of a
// struct or tuple key (`m.insert((s, 1), 2)`, `m.insert(Cell { .. }, v)`)
// makes it a HashMap<K, V> of that key and value type: here (the variable
// is retyped, so `m.keys()` is a Vec<K> and `m.get(k)` a V) and in the
// lowering (Lowerer_rt6_let_type gives the `let` that type, so the map
// takes the path a written `HashMap<K, V>` takes: a struct or tuple key is
// hashed and compared field by field, a string in it as text). A first
// insert of any other key leaves it as it was. The records are RT6's
// (ast.fd rt6_add_map, rt6_map_at).

fn tc_rt5_is_map_new(e: Expr) -> bool {
    match e {
        Expr::MethodCall(recv, m, args) => {
            if m != "new" || args.len() != 0 {
                return false;
            }
            match box_expr_unbox(recv) {
                Expr::Ident(rn) => {
                    return rn == "HashMap";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// Note a `let` of `name` whose value is a map. Only an untyped `var m =
/// HashMap::new()` can be typed by an insert; any other one is noted when
/// it hides such a variable of the same name (so an insert into it does
/// not type the outer one), and not otherwise (records are looked up by
/// a scan: a program of typed maps adds none).
fn TypeChecker_rt5_note_map_let(self: &mut TypeChecker, name: str, ty: OptType, expr: Expr, line: i64) {
    var state: i64 = 2;
    match ty {
        OptType::None => {
            if tc_rt5_is_map_new(expr) {
                state = 0;
            }
        }
        OptType::Some(_) => {
        }
    }
    var key: str = TypeChecker_rt6_fn_key(self);
    if state != 0 && (rt6_count() == 0 || rt6_find(key, name) < 0) {
        return;
    }
    rt6_add_map(key, name, line, self.scopes.len(), state);
}

/// Whether `t` is a struct or tuple key a map can take as written: a tuple
/// of numbers, bools, strings, such structs and such tuples; a struct that
/// is not generic; an instance of a generic struct whose arguments are such
/// types.
fn TypeChecker_rt5_key_ok(self: &mut TypeChecker, t: Type, depth: i64) -> bool {
    if depth > 8 || TypeChecker_type_contains_param(self, t) {
        return false;
    }
    match t {
        Type::Tuple(es) => {
            if es.len() == 0 {
                return false;
            }
            var i: i64 = 0;
            while i < es.len() {
                if !TypeChecker_rt5_part_ok(self, es.get(i), depth + 1) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        Type::Named(n) => {
            if n == "String" || n == "Vec" || n == "HashMap" || n == "Box" || str_vec_contains(self.current_type_params, n) {
                return false;
            }
            return tc_is_struct(self, n) && !tc_str_vec_contains(self.struct_tp_names, n);
        }
        Type::Generic(gn, gargs) => {
            if !tc_is_struct(self, gn) || !tc_str_vec_contains(self.struct_tp_names, gn) || gargs.len() == 0 {
                return false;
            }
            var j: i64 = 0;
            while j < gargs.len() {
                if !TypeChecker_rt5_part_ok(self, gargs.get(j), depth + 1) {
                    return false;
                }
                j = j + 1;
            }
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// A part of a struct or tuple key: a number, bool or string, or a key
/// TypeChecker_rt5_key_ok takes.
fn TypeChecker_rt5_part_ok(self: &mut TypeChecker, t: Type, depth: i64) -> bool {
    if tc_is_str(t) || TypeChecker_is_integer(self, t) {
        return true;
    }
    match t {
        Type::Bool => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        _ => {
        }
    }
    return TypeChecker_rt5_key_ok(self, t, depth);
}

/// `receiver.insert(key, value)` on a map of type `recv_ty`: the first
/// insert into an untyped `var m = HashMap::new()` types it when the key is
/// a struct or tuple (see above). Returns the receiver's type from here on.
fn TypeChecker_rt5_note_insert(self: &mut TypeChecker, receiver: Expr, recv_ty: Type, arg_types: Vec<Type>) -> Type {
    var rn: str = "";
    match receiver {
        Expr::Ident(n) => {
            rn = n;
        }
        _ => {
            return recv_ty;
        }
    }
    var k: i64 = rt6_find(TypeChecker_rt6_fn_key(self), rn);
    if k < 0 || !rt6_is_map(k) || rt6_state(k) != 0 {
        return recv_ty;
    }
    var kt: Type = arg_types.get(0);
    if !TypeChecker_rt5_key_ok(self, kt, 0) {
        rt6_set_state(k, 2);
        return recv_ty;
    }
    var vt: Type = arg_types.get(1);
    if tc_is_str(vt) {
        vt = Type::Str;
    } else if !TypeChecker_is_integer(self, vt) && !TypeChecker_rt6_type_ok(self, vt) {
        rt6_set_state(k, 2);
        return recv_ty;
    }
    var ga: Vec<Type> = Vec::new();
    ga.push(kt);
    ga.push(vt);
    var mt: Type = Type::Generic("HashMap", ga);
    rt6_set_typed(k, mt);
    TypeChecker_rt6_retype(self, rn, mt);
    return mt;
}

// --- Type utilities ------------------------------------------------------

pub fn TypeChecker_resolve_type(self: &TypeChecker, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            // OPTIMIZATION: use cached alias lookup instead of O(n) linear scan
            match TypeChecker_lookup_alias_cache(self, name) {
                OptType::Some(alias) => {
                    return TypeChecker_resolve_type(self, alias);
                }
                OptType::None => {
                    return ty;
                }
            }
            return ty;
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(TypeChecker_resolve_type(self, box_type_unbox(inner))), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(Box::new(TypeChecker_resolve_type(self, box_type_unbox(inner))), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(TypeChecker_resolve_type(self, box_type_unbox(elem))), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(TypeChecker_resolve_type(self, box_type_unbox(elem))), size_param);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(TypeChecker_resolve_type(self, args.get(i)));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(TypeChecker_resolve_type(self, types.get(i)));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        _ => {
            return ty;
        }
    }
    return ty;
}

pub fn TypeChecker_subst_type_params(ty: Type, subst: Vec<StringType>) -> Type {
    match ty {
        Type::Named(name) => {
            var i: i64 = 0;
            while i < subst.len() {
                if subst.get(i).key == name {
                    return subst.get(i).val;
                }
                i = i + 1;
            }
            return ty;
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(TypeChecker_subst_type_params(box_type_unbox(elem), subst)), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(TypeChecker_subst_type_params(box_type_unbox(elem), subst)), size_param);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(TypeChecker_subst_type_params(box_type_unbox(inner), subst)), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(Box::new(TypeChecker_subst_type_params(box_type_unbox(inner), subst)), is_mut);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(TypeChecker_subst_type_params(args.get(i), subst));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(TypeChecker_subst_type_params(types.get(i), subst));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        _ => {
            return ty;
        }
    }
    return ty;
}

pub fn TypeChecker_resolve_self_type(self: &TypeChecker, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            if name == "Self" {
                match self.current_self_type {
                    OptString::Some(s) => {
                        return Type::Named(s);
                    }
                    OptString::None => {
                        return ty;
                    }
                }
            }
            return ty;
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(TypeChecker_resolve_self_type(self, box_type_unbox(inner))), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(TypeChecker_resolve_self_type(self, box_type_unbox(elem))), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(TypeChecker_resolve_self_type(self, box_type_unbox(elem))), size_param);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(TypeChecker_resolve_self_type(self, args.get(i)));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(TypeChecker_resolve_self_type(self, types.get(i)));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        _ => {
            return ty;
        }
    }
    return ty;
}

pub fn TypeChecker_resolve_assoc_in_type(self: &TypeChecker, ty: Type, type_param: str, trait_name: str) -> Type {
    match ty {
        Type::Named(name) => {
            // Check if this name is an associated type of the trait
            match map_str_vecstr_get(self.trait_assoc_types, trait_name) {
                OptVecStr::Some(assoc_types) => {
                    if tc_str_vec_contains(assoc_types, name) {
                        return Type::Assoc(type_param, trait_name, name, Vec::new());
                    }
                }
                OptVecStr::None => {
                }
            }
            return ty;
        }
        Type::Assoc(_, _, name, args) => {
            return Type::Assoc(type_param, trait_name, name, args);
        }
        _ => {
            return ty;
        }
    }
    return ty;
}

pub fn TypeChecker_resolve_struct_name(self: &TypeChecker, name: str) -> str {
    // OPTIMIZATION: use cached alias lookup
    match TypeChecker_lookup_alias_cache(self, name) {
        OptType::Some(alias) => {
            match alias {
                Type::Named(inner) => {
                    return TypeChecker_resolve_struct_name(self, inner);
                }
                _ => {
                    return name;
                }
            }
            return name;
        }
        OptType::None => {
            return name;
        }
    }
    return name;
}

