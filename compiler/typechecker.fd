                if arg_types.len() != 1 || !type_eq(arg_types.get(0), Type::Str) {
                    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): embed takes one argument, the file's path (a str)
    Fix: embed(\"path/file.txt\") — a str literal relative to the source file.");
                    return Type::Never;
