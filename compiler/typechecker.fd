// ─── check_func ──────────────────────────────────────────────────────────

pub fn TypeChecker_check_func(self: &mut TypeChecker, func: Func) {
    self.current_func_name = OptString::Some(func.name);
    var empty_ret: Vec<Type> = Vec::new();
    self.current_return_types = empty_ret;
    // Set current_module to the module where this function was defined
    var saved_module: str = self.current_module;
    var mangled: str = "";
    match self.current_self_type {
        OptString::Some(s) => { mangled = s + "_" + func.name; }
        OptString::None => { mangled = ""; }
    }
    if mangled != "" {
        match map_str_str_get(self.item_modules, mangled) {
            OptString::Some(mod_name) => { self.current_module = mod_name; }
            OptString::None => {
                match map_str_str_get(self.item_modules, func.name) {
                    OptString::Some(mod_name) => { self.current_module = mod_name; }
                    OptString::None => {}
                }
            }
        }
    } else {
        match map_str_str_get(self.item_modules, func.name) {
            OptString::Some(mod_name) => { self.current_module = mod_name; }
            OptString::None => {}
        }
    }
    // Reset linear tracking
    var saved_consumed: Vec<str> = self.consumed_vars;
    var empty_consumed: Vec<str> = Vec::new();
    self.consumed_vars = empty_consumed;
    TypeChecker_push_scope(self);
    // Track type parameters
    var saved_tp: Vec<str> = self.current_type_params;
    self.current_type_params = func.type_params;
    // Track trait bounds
    var saved_bounds: Vec<StringString> = self.current_type_param_bounds;
    var empty_bounds: Vec<StringString> = Vec::new();
    self.current_type_param_bounds = empty_bounds;
    var bi: i64 = 0;
    while bi < func.type_param_bounds.len() {
        self.current_type_param_bounds.push(func.type_param_bounds.get(bi));
        bi = bi + 1;
    }
    // Declare const generic params
    var cpi: i64 = 0;
    while cpi < func.const_params.len() {
        var cp: StrPair = func.const_params.get(cpi);
        var ty: Type = Type::I64;
        var ty_name: str = cp.b;
        if ty_name == "i8" { ty = Type::I8; }
        else if ty_name == "i16" { ty = Type::I16; }
        else if ty_name == "i32" { ty = Type::I32; }
        else if ty_name == "i64" { ty = Type::I64; }
        else if ty_name == "u8" { ty = Type::U8; }
        else if ty_name == "u16" { ty = Type::U16; }
        else if ty_name == "u32" { ty = Type::U32; }
        else if ty_name == "u64" { ty = Type::U64; }
        else { ty = Type::I64; }
        TypeChecker_declare(self, cp.a, ty);
        cpi = cpi + 1;
    }
    // Declare parameters
    var pi: i64 = 0;
    while pi < func.params.len() {
        var resolved_ty: Type = TypeChecker_resolve_self_type(self, func.params.get(pi).ty);
        TypeChecker_declare(self, func.params.get(pi).name, resolved_ty);
        pi = pi + 1;
    }
    // Check body statements
    var si: i64 = 0;
    while si < func.body.len() {
        TypeChecker_check_stmt(self, func.body.get(si));
        si = si + 1;
    }
    // Bidirectional type inference: if return type is _, infer from body
    if type_eq(func.ret_ty, Type::Infer) {
        var inferred: Type = Type::Void;
        var ri: i64 = 0;
        while ri < self.current_return_types.len() {
            var rt: Type = self.current_return_types.get(ri);
            if !type_eq(rt, Type::Void) && !type_eq(rt, Type::Never) {
                inferred = rt;
                break;
            }
            ri = ri + 1;
        }
        // Update function signature in symbol table
        var fi: i64 = 0;
        while fi < self.funcs.len() {
            if self.funcs.get(fi).key == func.name {
                var f_entry: StringFuncSig = self.funcs.get(fi);
                f_entry.val.ret_ty = inferred;
                self.funcs.set(fi, f_entry);
                break;
            }
            fi = fi + 1;
        }
    }
    // Restore state
    self.current_type_params = saved_tp;
    self.current_type_param_bounds = saved_bounds;
    TypeChecker_pop_scope(self);
    self.consumed_vars = saved_consumed;
    self.current_module = saved_module;
    self.current_func_name = OptString::None;
}

// ─── Scope operations ────────────────────────────────────────────────────

pub fn TypeChecker_push_scope(self: &mut TypeChecker) {
    self.scopes.push(Vec::new());
    self.scope_linear_vars.push(Vec::new());
    self.val_vars_per_scope.push(Vec::new());
}

pub fn TypeChecker_pop_scope(self: &mut TypeChecker) {
    // Clean up val_vars for this scope
    if self.val_vars_per_scope.len() > 0 {
        self.val_vars_per_scope.pop();
    }
    // Check that all linear variables in this scope were consumed
    if self.scope_linear_vars.len() > 0 {
        var linear_vars: Vec<LinearVar> = self.scope_linear_vars.pop();
        var i: i64 = 0;
        while i < linear_vars.len() {
            var lv: LinearVar = linear_vars.get(i);
            if !str_vec_contains(self.consumed_vars, lv.name) {
                self.errors.push("Linear type error (line " + int_to_str(lv.line) + "): variable '" + lv.name + "' is linear but was never consumed.");
            }
            i = i + 1;
        }
    }
    if self.scopes.len() > 0 {
        self.scopes.pop();
    }
}

pub fn TypeChecker_declare(self: &mut TypeChecker, name: str, ty: Type) {
    if self.scopes.len() > 0 {
        var scope: Vec<ScopeEntry> = self.scopes.pop();
        scope.push(ScopeEntry_new(name, ty));
        self.scopes.push(scope);
    } else {
        var scope: Vec<ScopeEntry> = Vec::new();
        scope.push(ScopeEntry_new(name, ty));
        self.scopes.push(scope);
    }
}

pub fn TypeChecker_lookup(self: &TypeChecker, name: str) -> OptType {
    var i: i64 = self.scopes.len() - 1;
    while i >= 0 {
        var scope: Vec<ScopeEntry> = self.scopes.get(i);
        var j: i64 = 0;
        while j < scope.len() {
            if scope.get(j).key == name {
                return OptType::Some(scope.get(j).val);
            }
            j = j + 1;
        }
        i = i - 1;
    }
    return OptType::None;
}

// ─── Type utilities ──────────────────────────────────────────────────────

pub fn TypeChecker_resolve_type(self: &TypeChecker, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            match map_str_type_get(self.type_aliases, name) {
                OptType::Some(alias) => { return TypeChecker_resolve_type(self, alias); }
                OptType::None => { return ty; }
            }
            return ty;
        }
        _ => { return ty; }
    }
    return ty;
}

pub fn TypeChecker_resolve_self_type(self: &TypeChecker, ty: Type) -> Type {
    match ty {
        Type::Named(name) => {
            if name == "Self" {
                match self.current_self_type {
                    OptString::Some(s) => { return Type::Named(s); }
                    OptString::None => { return ty; }
                }
            }
            return ty;
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(Box::new(TypeChecker_resolve_self_type(self, box_type_unbox(inner))), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(Box::new(TypeChecker_resolve_self_type(self, box_type_unbox(elem))), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(Box::new(TypeChecker_resolve_self_type(self, box_type_unbox(elem))), size_param);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(TypeChecker_resolve_self_type(self, args.get(i)));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(TypeChecker_resolve_self_type(self, types.get(i)));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        _ => { return ty; }
    }
    return ty;
}

pub fn TypeChecker_resolve_struct_name(self: &TypeChecker, name: str) -> str {
    match map_str_type_get(self.type_aliases, name) {
        OptType::Some(alias) => {
            match alias {
                Type::Named(inner) => { return TypeChecker_resolve_struct_name(self, box_type_unbox(inner)); }
                _ => { return name; }
            }
            return name;
        }
        OptType::None => { return name; }
    }
    return name;
}

pub fn TypeChecker_is_numeric(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::I8 => { return true; }
        Type::I16 => { return true; }
        Type::I32 => { return true; }
        Type::I64 => { return true; }
        Type::I128 => { return true; }
        Type::U8 => { return true; }
        Type::U16 => { return true; }
        Type::U32 => { return true; }
        Type::U64 => { return true; }
        Type::U128 => { return true; }
        Type::F32 => { return true; }
        Type::F64 => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn TypeChecker_is_integer(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::I8 => { return true; }
        Type::I16 => { return true; }
        Type::I32 => { return true; }
        Type::I64 => { return true; }
        Type::I128 => { return true; }
        Type::U8 => { return true; }
        Type::U16 => { return true; }
        Type::U32 => { return true; }
        Type::U64 => { return true; }
        Type::U128 => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn TypeChecker_is_float(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::F32 => { return true; }
        Type::F64 => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn TypeChecker_is_typed_string(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::Named(name) => {
            if name == "SQLString" { return true; }
            if name == "ShellString" { return true; }
            if name == "HTMLString" { return true; }
            if name == "JSONString" { return true; }
            if name == "PathString" { return true; }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

pub fn infer_int_type(value: i64) -> Type {
    if value >= -128 && value <= 127 { return Type::I8; }
    if value >= -32768 && value <= 32767 { return Type::I16; }
    if value >= -2147483648 && value <= 2147483647 { return Type::I32; }
    return Type::I64;
}

pub fn int_rank(ty: Type) -> i64 {
    match ty {
        Type::I8 => { return 0; }
        Type::U8 => { return 0; }
        Type::I16 => { return 1; }
        Type::U16 => { return 1; }
        Type::I32 => { return 2; }
        Type::U32 => { return 2; }
        Type::I64 => { return 3; }
        Type::U64 => { return 3; }
        Type::I128 => { return 4; }
        Type::U128 => { return 4; }
        _ => { return 255; }
    }
    return 255;
}

pub fn wider_type(a: Type, b: Type) -> Type {
    if int_rank(a) >= int_rank(b) { return a; }
    return b;
}

pub fn can_implicitly_widen(from: Type, to: Type) -> bool {
    if type_eq(from, to) { return true; }
    // Any integer can widen to any wider integer
    var from_rank: i64 = int_rank(from);
    var to_rank: i64 = int_rank(to);
    if from_rank < 255 && to_rank < 255 {
        return to_rank >= from_rank;
    }
    // Int can widen to float
    var from_is_int: bool = false;
    match from {
        Type::I8 => { from_is_int = true; }
        Type::I16 => { from_is_int = true; }
        Type::I32 => { from_is_int = true; }
        Type::I64 => { from_is_int = true; }
        Type::U8 => { from_is_int = true; }
        Type::U16 => { from_is_int = true; }
        Type::U32 => { from_is_int = true; }
        Type::U64 => { from_is_int = true; }
        _ => { from_is_int = false; }
    }
    var to_is_float: bool = false;
    match to {
        Type::F32 => { to_is_float = true; }
        Type::F64 => { to_is_float = true; }
        _ => { to_is_float = false; }
    }
    if from_is_int && to_is_float { return true; }
    return false;
}

// Type equality (structural)
pub fn type_eq(a: Type, b: Type) -> bool {
    match a {
        Type::I8 => { match b { Type::I8 => { return true; }, _ => { return false; } } }
        Type::I16 => { match b { Type::I16 => { return true; }, _ => { return false; } } }
        Type::I32 => { match b { Type::I32 => { return true; }, _ => { return false; } } }
        Type::I64 => { match b { Type::I64 => { return true; }, _ => { return false; } } }
        Type::I128 => { match b { Type::I128 => { return true; }, _ => { return false; } } }
        Type::U8 => { match b { Type::U8 => { return true; }, _ => { return false; } } }
        Type::U16 => { match b { Type::U16 => { return true; }, _ => { return false; } } }
        Type::U32 => { match b { Type::U32 => { return true; }, _ => { return false; } } }
        Type::U64 => { match b { Type::U64 => { return true; }, _ => { return false; } } }
        Type::U128 => { match b { Type::U128 => { return true; }, _ => { return false; } } }
        Type::F32 => { match b { Type::F32 => { return true; }, _ => { return false; } } }
        Type::F64 => { match b { Type::F64 => { return true; }, _ => { return false; } } }
        Type::Bool => { match b { Type::Bool => { return true; }, _ => { return false; } } }
        Type::Str => { match b { Type::Str => { return true; }, _ => { return false; } } }
        Type::Void => { match b { Type::Void => { return true; }, _ => { return false; } } }
        Type::Never => { match b { Type::Never => { return true; }, _ => { return false; } } }
        Type::Infer => { match b { Type::Infer => { return true; }, _ => { return false; } } }
        Type::Named(n1) => {
            match b {
                Type::Named(n2) => { return n1 == n2; }
                _ => { return false; }
            }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

// ──── CHUNK_MARKER_5 ────

// ─── types_compatible ────────────────────────────────────────────────────

pub fn TypeChecker_types_compatible(self: &TypeChecker, declared: Type, actual: Type) -> bool {
    var decl: Type = TypeChecker_resolve_type(self, declared);
    var act: Type = TypeChecker_resolve_type(self, actual);
    if type_eq(decl, act) { return true; }
    if type_eq(act, Type::Never) { return true; }
    if type_eq(decl, Type::Infer) || type_eq(act, Type::Infer) { return true; }
    // Associated types are compatible with anything
    match decl {
        Type::Assoc(_, _, _, _) => { return true; }
        _ => {}
    }
    match act {
        Type::Assoc(_, _, _, _) => { return true; }
        _ => {}
    }
    // Dyn types are compatible with anything
    match decl {
        Type::Dyn(_) => { return true; }
        _ => {}
    }
    match act {
        Type::Dyn(_) => { return true; }
        _ => {}
    }
    // Type parameters are compatible with anything
    match decl {
        Type::Named(name) => {
            if str_vec_contains(self.current_type_params, name) { return true; }
        }
        _ => {}
    }
    match act {
        Type::Named(name) => {
            if str_vec_contains(self.current_type_params, name) { return true; }
        }
        _ => {}
    }
    // Generic enum/struct: Named("Option") compatible with Generic("Option", ...)
    match decl {
        Type::Named(decl_name) => {
            match act {
                Type::Generic(gen_name, _) => {
                    if decl_name == gen_name { return true; }
                }
                _ => {}
            }
        }
        _ => {}
    }
    match decl {
        Type::Generic(gen_name, _) => {
            match act {
                Type::Named(decl_name) => {
                    if gen_name == decl_name { return true; }
                }
                _ => {}
            }
        }
        _ => {}
    }
    // Vec<T> and HashMap<K,V> are opaque — any two instantiations compatible
    match decl {
        Type::Generic(dn, _) => {
            match act {
                Type::Generic(an, _) => {
                    if (dn == "Vec" && an == "Vec") || (dn == "HashMap" && an == "HashMap") { return true; }
                    if (dn == "Rc" && an == "Rc") || (dn == "Arc" && an == "Arc") { return true; }
                }
                _ => {}
            }
        }
        _ => {}
    }
    // ArrayConst compatible with any array
    match decl {
        Type::ArrayConst(_, _) => { return true; }
        _ => {}
    }
    match act {
        Type::ArrayConst(_, _) => { return true; }
        _ => {}
    }
    // str ↔ i64 (str is a pointer internally)
    if (type_eq(decl, Type::I64) && type_eq(act, Type::Str)) || (type_eq(decl, Type::Str) && type_eq(act, Type::I64)) {
        return true;
    }
    // Implicit widening
    if can_implicitly_widen(act, decl) { return true; }
    // Tuple element-wise compatibility
    match decl {
        Type::Tuple(decl_elems) => {
            match act {
                Type::Tuple(actual_elems) => {
                    if decl_elems.len() != actual_elems.len() { return false; }
                    var i: i64 = 0;
                    while i < decl_elems.len() {
                        if !TypeChecker_types_compatible(self, decl_elems.get(i), actual_elems.get(i)) { return false; }
                        i = i + 1;
                    }
                    return true;
                }
                _ => { return false; }
            }
            return false;
        }
        _ => {}
    }
    // Raw pointers compatible with each other
    match decl {
        Type::RawPtr(d_inner, d_mut) => {
            match act {
                Type::RawPtr(a_inner, a_mut) => {
                    if d_mut == a_mut {
                        return TypeChecker_types_compatible(self, box_type_unbox(d_inner), box_type_unbox(a_inner));
                    }
                    return false;
                }
                _ => {}
            }
        }
        _ => {}
    }
    // i64 ↔ *mut T / *const T
    match decl {
        Type::RawPtr(_, _) => {
            if TypeChecker_is_numeric(self, act) { return true; }
        }
        _ => {}
    }
    match act {
        Type::RawPtr(_, _) => {
            if TypeChecker_is_numeric(self, decl) { return true; }
        }
        _ => {}
    }
    // &T → *mut T / *const T
    match decl {
        Type::RawPtr(d_inner, _) => {
            match act {
                Type::Ref(a_inner, _) => {
                    return TypeChecker_types_compatible(self, box_type_unbox(d_inner), box_type_unbox(a_inner));
                }
                _ => {}
            }
        }
        _ => {}
    }
    // Numeric compatibility fallback
    if TypeChecker_is_numeric(self, decl) && TypeChecker_is_numeric(self, act) { return true; }
    return false;
}

// ─── type_contains_param ─────────────────────────────────────────────────

pub fn TypeChecker_type_contains_param(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::Named(name) => {
            return str_vec_contains(self.current_type_params, name);
        }
        Type::Ref(inner, _) => { return TypeChecker_type_contains_param(self, box_type_unbox(inner)); }
        Type::RawPtr(inner, _) => { return TypeChecker_type_contains_param(self, box_type_unbox(inner)); }
        Type::Array(elem, _) => { return TypeChecker_type_contains_param(self, box_type_unbox(elem)); }
        Type::ArrayConst(elem, _) => { return TypeChecker_type_contains_param(self, box_type_unbox(elem)); }
        Type::Generic(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                if TypeChecker_type_contains_param(self, args.get(i)) { return true; }
                i = i + 1;
            }
            return false;
        }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if TypeChecker_type_contains_param(self, types.get(i)) { return true; }
                i = i + 1;
            }
            return false;
        }
        _ => { return false; }
    }
    return false;
}

// ─── is_known_enum ───────────────────────────────────────────────────────

pub fn TypeChecker_is_known_enum(self: &TypeChecker, name: str) -> bool {
    return str_vec_contains(self.enums, name);
}

// ─── type_size ───────────────────────────────────────────────────────────

pub fn TypeChecker_type_size(self: &TypeChecker, ty: Type) -> i64 {
    match ty {
        Type::I8 => { return 1; }
        Type::U8 => { return 1; }
        Type::Bool => { return 1; }
        Type::I16 => { return 2; }
        Type::U16 => { return 2; }
        Type::I32 => { return 4; }
        Type::U32 => { return 4; }
        Type::F32 => { return 4; }
        Type::I64 => { return 8; }
        Type::U64 => { return 8; }
        Type::F64 => { return 8; }
        Type::I128 => { return 16; }
        Type::U128 => { return 16; }
        Type::Str => { return 16; }
        Type::Named(name) => {
            var i: i64 = 0;
            while i < self.structs.len() {
                if self.structs.get(i).key == name {
                    return self.structs.get(i).val.len() * 8;
                }
                i = i + 1;
            }
            if name == "String" { return 16; }
            return 8;
        }
        Type::Generic(name, _) => {
            if name == "Vec" { return 24; }
            if name == "HashMap" { return 48; }
            if name == "Option" { return 16; }
            if name == "Result" { return 16; }
            return 8;
        }
        Type::Ref(_, _) => { return 8; }
        Type::RawPtr(_, _) => { return 8; }
        _ => { return 8; }
    }
    return 8;
}

// ─── check_capability ────────────────────────────────────────────────────

pub fn TypeChecker_check_capability(self: &mut TypeChecker, cap: str, context: str) {
    if self.sandbox_depth > 0 {
        self.errors.push("Sandbox error: '" + context + "' requires '" + cap + "' capability — all capabilities are revoked inside sandbox");
        match self.current_func_name {
            OptString::Some(fname) => {
                var ci: i64 = 0;
                while ci < self.cap_verified.len() {
                    if self.cap_verified.get(ci) == fname {
                        self.cap_verified.remove(ci);
                        ci = self.cap_verified.len();
                    }
                    ci = ci + 1;
                }
            }
            OptString::None => {}
        }
        return;
    }
    if self.current_module == "core" { return; }
    if self.strict_caps && !str_vec_contains(self.granted_caps, cap) {
        self.errors.push("Capability error: '" + context + "' requires '" + cap + "' capability (not granted to module '" + self.current_module + "')");
        match self.current_func_name {
            OptString::Some(fname) => {
                var ci2: i64 = 0;
                while ci2 < self.cap_verified.len() {
                    if self.cap_verified.get(ci2) == fname {
                        self.cap_verified.remove(ci2);
                        ci2 = self.cap_verified.len();
                    }
                    ci2 = ci2 + 1;
                }
            }
            OptString::None => {}
        }
    }
}

// ─── check_visibility ────────────────────────────────────────────────────

pub fn TypeChecker_check_visibility(self: &mut TypeChecker, name: str) {
    match map_str_str_get(self.item_modules, name) {
        OptString::Some(item_module) => {
            if item_module != self.current_module {
                var is_pub: bool = map_str_bool_get(self.item_visibility, name);
                if !is_pub {
                    self.errors.push("Visibility error: '" + name + "' is private to module '" + item_module + "' (not accessible from '" + self.current_module + "')");
                }
            }
        }
        OptString::None => {}
    }
}

// ─── collect_capabilities ────────────────────────────────────────────────

pub fn TypeChecker_collect_capabilities(self: &mut TypeChecker, program: Program) {
    var i: i64 = 0;
    while i < program.imports.len() {
        var imp: ImportDef = program.imports.get(i);
        if imp.capabilities.len() > 0 {
            self.strict_caps = true;
            var j: i64 = 0;
            while j < imp.capabilities.len() {
                self.granted_caps.push(imp.capabilities.get(j));
                j = j + 1;
            }
        }
        i = i + 1;
    }
}

// ─── Linear type checks ──────────────────────────────────────────────────

pub fn TypeChecker_is_linear_type(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::Named(name) => { return str_vec_contains(self.linear_structs, name); }
        Type::Generic(name, _) => { return str_vec_contains(self.linear_structs, name); }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if TypeChecker_is_linear_type(self, types.get(i)) { return true; }
                i = i + 1;
            }
            return false;
        }
        Type::Array(elem, _) => { return TypeChecker_is_linear_type(self, box_type_unbox(elem)); }
        Type::ArrayConst(elem, _) => { return TypeChecker_is_linear_type(self, box_type_unbox(elem)); }
        Type::Ref(inner, _) => { return TypeChecker_is_linear_type(self, box_type_unbox(inner)); }
        _ => { return false; }
    }
    return false;
}

pub fn TypeChecker_is_send_type(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::I64 => { return true; }
        Type::I32 => { return true; }
        Type::I8 => { return true; }
        Type::F64 => { return true; }
        Type::F32 => { return true; }
        Type::Bool => { return true; }
        Type::Str => { return true; }
        Type::Void => { return true; }
        Type::Never => { return true; }
        Type::Named(name) => { return str_vec_contains(self.send_structs, name); }
        Type::Generic(name, args) => {
            if str_vec_contains(self.send_structs, name) { return true; }
            if name == "Vec" || name == "HashMap" || name == "String" || name == "Channel" || name == "Mutex" || name == "Future" || name == "Option" || name == "Result" {
                var i: i64 = 0;
                while i < args.len() {
                    if !TypeChecker_is_send_type(self, args.get(i)) { return false; }
                    i = i + 1;
                }
                return true;
            }
            return false;
        }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if !TypeChecker_is_send_type(self, types.get(i)) { return false; }
                i = i + 1;
            }
            return true;
        }
        Type::Array(elem, _) => { return TypeChecker_is_send_type(self, box_type_unbox(elem)); }
        Type::ArrayConst(elem, _) => { return TypeChecker_is_send_type(self, box_type_unbox(elem)); }
        Type::Ref(_, _) => { return false; }
        Type::RawPtr(_, _) => { return false; }
        Type::Infer => { return true; }
        _ => { return true; }
    }
    return true;
}

pub fn TypeChecker_is_sync_type(self: &TypeChecker, ty: Type) -> bool {
    match ty {
        Type::I64 => { return true; }
        Type::I32 => { return true; }
        Type::I8 => { return true; }
        Type::F64 => { return true; }
        Type::F32 => { return true; }
        Type::Bool => { return true; }
        Type::Str => { return true; }
        Type::Void => { return true; }
        Type::Never => { return true; }
        Type::Named(name) => { return str_vec_contains(self.sync_structs, name); }
        Type::Generic(name, args) => {
            if str_vec_contains(self.sync_structs, name) { return true; }
            if name == "Mutex" || name == "Channel" { return true; }
            if name == "Vec" || name == "HashMap" || name == "String" || name == "Option" || name == "Result" || name == "Future" {
                var i: i64 = 0;
                while i < args.len() {
                    if !TypeChecker_is_sync_type(self, args.get(i)) { return false; }
                    i = i + 1;
                }
                return true;
            }
            return false;
        }
        Type::Tuple(types) => {
            var i: i64 = 0;
            while i < types.len() {
                if !TypeChecker_is_sync_type(self, types.get(i)) { return false; }
                i = i + 1;
            }
            return true;
        }
        Type::Array(elem, _) => { return TypeChecker_is_sync_type(self, box_type_unbox(elem)); }
        Type::ArrayConst(elem, _) => { return TypeChecker_is_sync_type(self, box_type_unbox(elem)); }
        Type::Ref(inner, is_mut) => {
            if !is_mut { return TypeChecker_is_sync_type(self, box_type_unbox(inner)); }
            return false;
        }
        Type::RawPtr(_, _) => { return false; }
        Type::Infer => { return true; }
        _ => { return true; }
    }
    return true;
}

// ─── consume_var ─────────────────────────────────────────────────────────

pub fn TypeChecker_consume_var(self: &mut TypeChecker, name: str, line: i64) {
    if self.loop_depth > 0 {
        self.errors.push("Linear type error (line " + int_to_str(line) + "): variable '" + name + "' cannot be consumed inside a loop");
    }
    if str_vec_contains(self.consumed_vars, name) {
        self.errors.push("Linear type error (line " + int_to_str(line) + "): variable '" + name + "' was already consumed (moved)");
    } else {
        self.consumed_vars.push(name);
    }
}

// ─── consume_linear_in_expr ──────────────────────────────────────────────

pub fn TypeChecker_consume_linear_in_expr(self: &mut TypeChecker, expr: Expr, line: i64) {
    match expr {
        Expr::Ident(name) => {
            var lk: OptType = TypeChecker_lookup(self, name);
            match lk {
                OptType::Some(ty) => {
                    if TypeChecker_is_linear_type(self, ty) {
                        TypeChecker_consume_var(self, name, line);
                    }
                }
                OptType::None => { }
            }
        }
        Expr::Binary(_, left, right) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(left), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(right), line);
        }
        Expr::Unary(_, e) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        Expr::Call(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_consume_linear_in_expr(self, args.get(i), line);
                i = i + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(receiver), line);
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_consume_linear_in_expr(self, args.get(i), line);
                i = i + 1;
            }
        }
        Expr::StructLit(_, fields, spread) => {
            var i: i64 = 0;
            while i < fields.len() {
                TypeChecker_consume_linear_in_expr(self, fields.get(i).value, line);
                i = i + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { TypeChecker_consume_linear_in_expr(self, box_expr_unbox(s), line); }
                OptBoxExpr::None => {}
            }
        }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_consume_linear_in_expr(self, elements.get(i), line);
                i = i + 1;
            }
        }
        Expr::TupleLit(elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_consume_linear_in_expr(self, elements.get(i), line);
                i = i + 1;
            }
        }
        Expr::Deref(e) => { TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line); }
        Expr::Cast(e, _) => { TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line); }
        Expr::Coalesce(e, d) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(d), line);
        }
        Expr::Try(e) => { TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line); }
        Expr::StrConcat(l, r) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(l), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(r), line);
        }
        Expr::Range(s, e, _) => {
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(s), line);
            TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), line);
        }
        _ => {}
    }
}

// ──── CHUNK_MARKER_6 ────

// ─── check_stmt ──────────────────────────────────────────────────────────

pub fn TypeChecker_check_stmt(self: &mut TypeChecker, stmt: Stmt) {
    // Track current line for error messages
    self.current_line = stmt_line(stmt);
    match stmt {
        Stmt::Let(name, ty, expr, is_mut, _, line) => {
            // Bidirectional type inference: pass declared type as hint
            var hint: Type = Type::Never;
            match ty {
                OptType::Some(t) => { hint = t; }
                OptType::None => { hint = Type::Never; }
            }
            var expr_ty: Type = TypeChecker_check_expr_with_hint(self, expr, hint);
            TypeChecker_consume_linear_in_expr(self, expr, line);
            var final_ty: Type = expr_ty;
            match ty {
                OptType::Some(declared) => {
                    if !TypeChecker_types_compatible(self, declared, expr_ty) {
                        self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign " + type_to_str(expr_ty) + " to variable '" + name + "' of type " + type_to_str(declared));
                    }
                    final_ty = declared;
                }
                OptType::None => { final_ty = expr_ty; }
            }
            // Track val (immutable) bindings
            if !is_mut {
                if self.val_vars_per_scope.len() > 0 {
                    var scope: Vec<str> = self.val_vars_per_scope.pop();
                    scope.push(name);
                    self.val_vars_per_scope.push(scope);
                }
            } else {
                if self.val_vars_per_scope.len() > 0 {
                    var scope: Vec<str> = self.val_vars_per_scope.pop();
                    str_vec_remove(&mut scope, name);
                    self.val_vars_per_scope.push(scope);
                }
            }
            // Track region: if inside a region block, record the allocation region
            if self.region_stack.len() > 0 {
                var region: str = self.region_stack.get(self.region_stack.len() - 1);
                map_str_str_set(&mut self.var_regions, name, region);
                map_str_str_set(&mut self.var_alloc_lines, name, int_to_str(line));
                var size: i64 = TypeChecker_type_size(self, final_ty);
                if self.region_budgets.len() > 0 {
                    var budget: RegionBudget = self.region_budgets.pop();
                    budget.usage = budget.usage + size;
                    self.region_budgets.push(budget);
                }
            }
            // Track linear variables
            if TypeChecker_is_linear_type(self, final_ty) {
                if self.scope_linear_vars.len() > 0 {
                    var scope: Vec<LinearVar> = self.scope_linear_vars.pop();
                    scope.push(LinearVar_new(name, line));
                    self.scope_linear_vars.push(scope);
                }
            }
            TypeChecker_declare(self, name, final_ty);
        }
        Stmt::LetTuple(names, expr, line) => {
            var expr_ty: Type = TypeChecker_check_expr(self, expr);
            TypeChecker_consume_linear_in_expr(self, expr, line);
            match expr_ty {
                Type::Tuple(elem_types) => {
                    if names.len() != elem_types.len() {
                        self.errors.push("Type error (line " + int_to_str(line) + "): tuple destructuring expects " + int_to_str(names.len()) + " names but expression has " + int_to_str(elem_types.len()) + " elements");
                    }
                    var i: i64 = 0;
                    while i < names.len() && i < elem_types.len() {
                        var elem_ty: Type = elem_types.get(i);
                        if TypeChecker_is_linear_type(self, elem_ty) {
                            if self.scope_linear_vars.len() > 0 {
                                var scope: Vec<LinearVar> = self.scope_linear_vars.pop();
                                scope.push(LinearVar_new(names.get(i), line));
                                self.scope_linear_vars.push(scope);
                            }
                        }
                        TypeChecker_declare(self, names.get(i), elem_ty);
                        i = i + 1;
                    }
                }
                _ => {
                    self.errors.push("Type error (line " + int_to_str(line) + "): cannot destructure " + type_to_str(expr_ty) + " as a tuple");
                }
            }
        }
        Stmt::LetUninit(name, ty, line) => {
            var resolved_ty: Type = TypeChecker_resolve_type(self, ty);
            TypeChecker_declare(self, name, resolved_ty);
            self.uninit_vars.push(name);
            if TypeChecker_is_linear_type(self, resolved_ty) {
                if self.scope_linear_vars.len() > 0 {
                    var scope: Vec<LinearVar> = self.scope_linear_vars.pop();
                    scope.push(LinearVar_new(name, line));
                    self.scope_linear_vars.push(scope);
                }
            }
        }
        Stmt::Expr(expr, line) => {
            TypeChecker_check_expr(self, expr);
            TypeChecker_consume_linear_in_expr(self, expr, line);
        }
        Stmt::Return(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => {
                    var ret_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
                    TypeChecker_consume_linear_in_expr(self, box_expr_unbox(e), self.current_line);
                    self.current_return_types.push(ret_ty);
                }
                OptBoxExpr::None => {
                    self.current_return_types.push(Type::Void);
                }
            }
        }
        Stmt::If(cond, then_block, else_block, line) => {
            var cond_ty: Type = TypeChecker_check_expr(self, cond);
            TypeChecker_consume_linear_in_expr(self, cond, line);
            if !type_eq(cond_ty, Type::Bool) && !type_eq(cond_ty, Type::I32) && !type_eq(cond_ty, Type::I64) {
                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): if condition must be bool, got " + type_to_str(cond_ty));
            }
            var consumed_before: Vec<str> = self.consumed_vars.clone();
            var uninit_before: Vec<str> = self.uninit_vars.clone();
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < then_block.len() {
                TypeChecker_check_stmt(self, then_block.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            var consumed_after_then: Vec<str> = self.consumed_vars.clone();
            var uninit_after_then: Vec<str> = self.uninit_vars.clone();
            // Restore to before-then state for else branch
            self.consumed_vars = consumed_before;
            self.uninit_vars = uninit_before;
            match else_block {
                OptStmts::Some(else_b) => {
                    TypeChecker_push_scope(self);
                    var si2: i64 = 0;
                    while si2 < else_b.len() {
                        TypeChecker_check_stmt(self, else_b.get(si2));
                        si2 = si2 + 1;
                    }
                    TypeChecker_pop_scope(self);
                }
                OptStmts::None => {}
            }
            // Merge: intersection of consumed_vars (consumed in BOTH branches)
            var merged: Vec<str> = Vec::new();
            var ci: i64 = 0;
            while ci < consumed_after_then.len() {
                if str_vec_contains(self.consumed_vars, consumed_after_then.get(ci)) {
                    merged.push(consumed_after_then.get(ci));
                }
                ci = ci + 1;
            }
            self.consumed_vars = merged;
            // Merge: union of uninit_vars (uninit in either branch)
            var merged_uninit: Vec<str> = uninit_after_then.clone();
            var ui: i64 = 0;
            while ui < self.uninit_vars.len() {
                if !str_vec_contains(merged_uninit, self.uninit_vars.get(ui)) {
                    merged_uninit.push(self.uninit_vars.get(ui));
                }
                ui = ui + 1;
            }
            self.uninit_vars = merged_uninit;
        }
        Stmt::Assign(target, _, expr, line) => {
            TypeChecker_check_expr(self, expr);
            TypeChecker_consume_linear_in_expr(self, expr, line);
            // Inline str_vec_remove to avoid &mut self.field issues
            var ri: i64 = 0;
            while ri < self.uninit_vars.len() {
                if self.uninit_vars.get(ri) == target {
                    self.uninit_vars.remove(ri);
                    ri = self.uninit_vars.len();
                }
                ri = ri + 1;
            }
            // Check target exists
            match TypeChecker_lookup(self, target) {
                OptType::Some(ty) => {
                    // Re-assigning a linear variable: old value must have been consumed
                    if TypeChecker_is_linear_type(self, ty) && !str_vec_contains(self.consumed_vars, target) {
                        self.errors.push("Linear type error (line " + int_to_str(line) + "): cannot reassign '" + target + "' — the old value would be silently destroyed");
                    }
                    if TypeChecker_is_linear_type(self, ty) {
                        var ci: i64 = 0;
                        while ci < self.consumed_vars.len() {
                            if self.consumed_vars.get(ci) == target {
                                self.consumed_vars.remove(ci);
                                ci = self.consumed_vars.len();
                            }
                            ci = ci + 1;
                        }
                    }
                }
                OptType::None => {
                    if !map_str_type_contains(self.consts, target) {
                        self.errors.push("Type error: cannot assign to undefined variable '" + target + "'");
                    }
                }
            }
        }
        Stmt::IndexAssign(array, index, _, expr, _) => {
            TypeChecker_check_expr(self, index);
            TypeChecker_check_expr(self, expr);
            match TypeChecker_lookup(self, array) {
                OptType::Some(_) => {}
                OptType::None => {
                    self.errors.push("Type error: cannot index undefined variable '" + array + "'");
                }
            }
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            TypeChecker_check_expr(self, ptr_expr);
            TypeChecker_check_expr(self, expr);
        }
        Stmt::FieldAssign(object, field, op, expr, line) => {
            var obj_ty: Type = TypeChecker_check_expr(self, object);
            self.current_line = line;
            // Unwrap references
            var effective_ty: Type = obj_ty;
            match obj_ty {
                Type::Ref(inner, _) => { effective_ty = box_type_unbox(inner); }
                _ => { effective_ty = obj_ty; }
            }
            match effective_ty {
                Type::Named(name) => {
                    // Find field type
                    var field_ty: OptType = OptType::None;
                    var si: i64 = 0;
                    while si < self.structs.len() {
                        if self.structs.get(si).key == name {
                            var fields: Vec<StructField> = self.structs.get(si).val;
                            var fi: i64 = 0;
                            while fi < fields.len() {
                                if fields.get(fi).name == field {
                                    field_ty = OptType::Some(fields.get(fi).ty);
                                    break;
                                }
                                fi = fi + 1;
                            }
                            break;
                        }
                        si = si + 1;
                    }
                    match field_ty {
                        OptType::Some(fty) => {
                            var expr_ty: Type = TypeChecker_check_expr(self, expr);
                            TypeChecker_consume_linear_in_expr(self, expr, line);
                            var compatible: bool = type_eq(expr_ty, fty) || type_eq(expr_ty, Type::Never) || (TypeChecker_is_integer(self, expr_ty) && TypeChecker_is_integer(self, fty));
                            if !compatible {
                                self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign " + type_to_str(expr_ty) + " to field '" + field + "' of type " + type_to_str(fty));
                            }
                        }
                        OptType::None => {
                            self.errors.push("Type error (line " + int_to_str(line) + "): struct '" + name + "' has no field '" + field + "'");
                            TypeChecker_check_expr(self, expr);
                        }
                    }
                }
                _ => {
                    self.errors.push("Type error (line " + int_to_str(line) + "): cannot assign field '" + field + "' on type " + type_to_str(obj_ty));
                    TypeChecker_check_expr(self, expr);
                }
            }
        }
        Stmt::While(cond, body, _) => {
            var cond_ty: Type = TypeChecker_check_expr(self, cond);
            if !type_eq(cond_ty, Type::Bool) && !type_eq(cond_ty, Type::I32) && !type_eq(cond_ty, Type::I64) {
                self.errors.push("Type error: while condition must be bool, got " + type_to_str(cond_ty));
            }
            TypeChecker_push_scope(self);
            self.loop_depth = self.loop_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.loop_depth = self.loop_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::For(var_name, iterator, body, _) => {
            var iter_ty: Type = TypeChecker_check_expr(self, iterator);
            // Extract element type
            var elem_ty: Type = iter_ty;
            match iter_ty {
                Type::Generic(name, args) => {
                    if name == "Vec" {
                        if args.len() > 0 { elem_ty = args.get(0); } else { elem_ty = Type::I64; }
                    } else if name == "HashMap" {
                        if args.len() > 0 { elem_ty = args.get(0); } else { elem_ty = Type::Str; }
                    }
                }
                Type::Named(name) => {
                    if name == "Vec" { elem_ty = Type::I64; }
                }
                Type::Array(elem, _) => { elem_ty = elem; }
                _ => { elem_ty = iter_ty; }
            }
            TypeChecker_push_scope(self);
            TypeChecker_declare(self, var_name, elem_ty);
            self.loop_depth = self.loop_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.loop_depth = self.loop_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::Loop(body, _) => {
            TypeChecker_push_scope(self);
            self.loop_depth = self.loop_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.loop_depth = self.loop_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::Break(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => { TypeChecker_check_expr(self, box_expr_unbox(e)); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::Continue(_) => {}
        Stmt::Defer(body, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::Match(expr, arms, _) => {
            var match_ty: Type = TypeChecker_check_expr(self, expr);
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                TypeChecker_push_scope(self);
                // Bind pattern variables
                match arm.pattern {
                    Pattern::Ident(name) => {
                        TypeChecker_declare(self, name, match_ty);
                    }
                    Pattern::EnumVariant(enum_name, variant, bindings) => {
                        var tys: Vec<Type> = TypeChecker_pattern_binding_types(self, match_ty, enum_name, variant, bindings);
                        var bi: i64 = 0;
                        while bi < bindings.len() && bi < tys.len() {
                            TypeChecker_declare(self, bindings.get(bi).name, tys.get(bi));
                            bi = bi + 1;
                        }
                    }
                    Pattern::StrLit(_) => {}
                    Pattern::Range(_, _) => {}
                    _ => {}
                }
                // Check guard
                match arm.guard {
                    OptBoxExpr::Some(g) => { TypeChecker_check_expr(self, box_expr_unbox(g)); }
                    OptBoxExpr::None => {}
                }
                // Check body
                var si: i64 = 0;
                while si < arm.body.len() {
                    TypeChecker_check_stmt(self, arm.body.get(si));
                    si = si + 1;
                }
                TypeChecker_pop_scope(self);
                ai = ai + 1;
            }
        }
        Stmt::Use(_, _, _) => {}
        Stmt::Handle(body, handlers, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            var hi: i64 = 0;
            while hi < handlers.len() {
                var handler: EffectHandler = handlers.get(hi);
                TypeChecker_push_scope(self);
                var pi: i64 = 0;
                while pi < handler.params.len() {
                    TypeChecker_declare(self, handler.params.get(pi), Type::I64);
                    pi = pi + 1;
                }
                var si2: i64 = 0;
                while si2 < handler.body.len() {
                    TypeChecker_check_stmt(self, handler.body.get(si2));
                    si2 = si + 1;
                }
                TypeChecker_pop_scope(self);
                hi = hi + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_check_expr(self, args.get(ai));
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(name, budget, is_gpu, is_kv_cache, _, body, line) => {
            self.region_stack.push(name);
            TypeChecker_push_scope(self);
            self.region_budgets.push(RegionBudget_new(name, budget, 0));
            map_str_str_set(&mut self.region_lines, name, int_to_str(line));
            if is_gpu { self.gpu_region_depth = self.gpu_region_depth + 1; }
            if is_kv_cache {
                match budget {
                    OptI64::None => {
                        self.errors.push("KV cache region error (line " + int_to_str(line) + "): 'region kv_cache " + name + "' must have a budget");
                    }
                    OptI64::Some(_) => {}
                }
            }
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            self.region_stack.pop();
            if is_gpu { self.gpu_region_depth = self.gpu_region_depth - 1; }
            self.freed_regions.push(name);
            // Check memory budget
            if self.region_budgets.len() > 0 {
                var rb: RegionBudget = self.region_budgets.pop();
                match rb.budget {
                    OptI64::Some(b) => {
                        if rb.usage > b {
                            self.errors.push("Budget error: region '" + name + "' used " + int_to_str(rb.usage) + " bytes but budget is " + int_to_str(b) + " bytes");
                        }
                    }
                    OptI64::None => {}
                }
            }
        }
        Stmt::Sandbox(body, _) => {
            TypeChecker_push_scope(self);
            self.sandbox_depth = self.sandbox_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.sandbox_depth = self.sandbox_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::Unsafe(body, _) => {
            TypeChecker_push_scope(self);
            self.unsafe_depth = self.unsafe_depth + 1;
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            self.unsafe_depth = self.unsafe_depth - 1;
            TypeChecker_pop_scope(self);
        }
        Stmt::Txn(body, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::ComptimeGen(_, _) => {}
        Stmt::GradBlock(_, body, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::Backward(loss, _) => {
            var loss_ty: Type = TypeChecker_check_expr(self, loss);
            var is_f64: bool = type_eq(loss_ty, Type::F64);
            var is_tensor: bool = false;
            match loss_ty {
                Type::Named(name) => { if name == "Tensor" { is_tensor = true; } }
                Type::Generic(name, _) => { if name == "Tensor" { is_tensor = true; } }
                Type::ShapedTensor(_, _) => { is_tensor = true; }
                _ => {}
            }
            if !is_f64 && !is_tensor {
                self.errors.push("Type error: backward() loss must be F64 or Tensor, got " + type_to_str(loss_ty));
            }
        }
        Stmt::Query(_, body, _) => {
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
        }
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                var case: SelectCase = cases.get(ci);
                TypeChecker_check_expr(self, case.channel);
                TypeChecker_push_scope(self);
                TypeChecker_declare(self, case.var_name, Type::I64);
                var si: i64 = 0;
                while si < case.body.len() {
                    TypeChecker_check_stmt(self, case.body.get(si));
                    si = si + 1;
                }
                TypeChecker_pop_scope(self);
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(def_body) => {
                    TypeChecker_push_scope(self);
                    var si: i64 = 0;
                    while si < def_body.len() {
                        TypeChecker_check_stmt(self, def_body.get(si));
                        si = si + 1;
                    }
                    TypeChecker_pop_scope(self);
                }
                OptStmts::None => {}
            }
        }
    }
}

// ──── CHUNK_MARKER_7 ────

// ─── check_expr ──────────────────────────────────────────────────────────

pub fn TypeChecker_check_expr(self: &mut TypeChecker, expr: Expr) -> Type {
    return TypeChecker_check_expr_with_hint(self, expr, Type::Never);
}

pub fn TypeChecker_check_expr_with_hint(self: &mut TypeChecker, expr: Expr, hint: Type) -> Type {
    match expr {
        Expr::IntLit(v) => {
            // Bidirectional: if hint is an integer type, use it directly
            match hint {
                Type::I8 => { return Type::I8; }
                Type::I16 => { return Type::I16; }
                Type::I32 => { return Type::I32; }
                Type::I64 => { return Type::I64; }
                Type::U8 => { return Type::U8; }
                Type::U16 => { return Type::U16; }
                Type::U32 => { return Type::U32; }
                Type::U64 => { return Type::U64; }
                _ => { return infer_int_type(v); }
            }
            return infer_int_type(v);
        }
        Expr::FloatLit(_) => {
            match hint {
                Type::F32 => { return Type::F32; }
                _ => { return Type::F64; }
            }
            return Type::F64;
        }
        Expr::StringLit(_) => { return Type::Str; }
        Expr::BoolLit(_) => { return Type::Bool; }
        Expr::Ident(name) => {
            // F63: init guarantee — check if variable is read before assignment
            if str_vec_contains(self.uninit_vars, name) {
                self.errors.push("Init error: variable '" + name + "' is used before being assigned a value");
            }
            match TypeChecker_lookup(self, name) {
                OptType::Some(ty) => { return ty; }
                OptType::None => {}
            }
            match map_str_type_get(self.consts, name) {
                OptType::Some(ty) => {
                    TypeChecker_check_visibility(self, name);
                    return ty;
                }
                OptType::None => {}
            }
            // Check if it's a function name — return function type
            var fi: i64 = 0;
            while fi < self.funcs.len() {
                if self.funcs.get(fi).key == name {
                    TypeChecker_check_visibility(self, name);
                    return Type::Func(self.funcs.get(fi).val.param_types, Box::new(self.funcs.get(fi).val.ret_ty));
                }
                fi = fi + 1;
            }
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): undefined variable '" + name + "'");
            return Type::Never;
        }
        Expr::Binary(op, left, right) => {
            var lt: Type = TypeChecker_check_expr_with_hint(self, box_expr_unbox(left), hint);
            var rt: Type = TypeChecker_check_expr_with_hint(self, box_expr_unbox(right), hint);
            var lt_r: Type = TypeChecker_resolve_type(self, lt);
            var rt_r: Type = TypeChecker_resolve_type(self, rt);
            match op {
                BinOp::Add => {}
                BinOp::Sub => {}
                BinOp::Mul => {}
                BinOp::Div => {}
                BinOp::Mod => {}
                BinOp::Eq => { return Type::Bool; }
                BinOp::Neq => { return Type::Bool; }
                BinOp::Lt => { return Type::Bool; }
                BinOp::Gt => { return Type::Bool; }
                BinOp::LtEq => { return Type::Bool; }
                BinOp::GtEq => { return Type::Bool; }
                BinOp::And => {
                    if !type_eq(lt_r, Type::Bool) || !type_eq(rt_r, Type::Bool) {
                        self.errors.push("Type error: logical operators require bool, got " + type_to_str(lt_r) + " and " + type_to_str(rt_r));
                    }
                    return Type::Bool;
                }
                BinOp::Or => {
                    if !type_eq(lt_r, Type::Bool) || !type_eq(rt_r, Type::Bool) {
                        self.errors.push("Type error: logical operators require bool, got " + type_to_str(lt_r) + " and " + type_to_str(rt_r));
                    }
                    return Type::Bool;
                }
                BinOp::BitAnd => {}
                BinOp::BitOr => {}
                BinOp::BitXor => {}
                BinOp::Shl => {}
                BinOp::Shr => {}
            }
            // Arithmetic/bitwise ops
            // String concatenation with +
            if op == BinOp::Add {
                if type_eq(lt_r, Type::Str) && type_eq(rt_r, Type::Str) {
                    return Type::Str;
                }
                // F68: reject typed string concatenation
                if TypeChecker_is_typed_string(self, lt_r) || TypeChecker_is_typed_string(self, rt_r) {
                    self.errors.push("Injection error (F68): cannot use + to concatenate typed string");
                    return Type::Never;
                }
            }
            // Treat str as i64 for arithmetic
            var lt_eff: Type = lt_r;
            if type_eq(lt_eff, Type::Str) { lt_eff = Type::I64; }
            var rt_eff: Type = rt_r;
            if type_eq(rt_eff, Type::Str) { rt_eff = Type::I64; }
            if TypeChecker_is_numeric(self, lt_eff) && TypeChecker_is_numeric(self, rt_eff) {
                if TypeChecker_is_integer(self, lt_eff) && TypeChecker_is_integer(self, rt_eff) {
                    return wider_type(lt_eff, rt_eff);
                }
                if type_eq(lt_eff, Type::F64) || type_eq(rt_eff, Type::F64) {
                    return Type::F64;
                }
                return Type::F32;
            }
            self.errors.push("Type error: arithmetic requires numeric types. Left: " + type_to_str(lt_r) + ", Right: " + type_to_str(rt_r));
            return Type::Never;
        }
        Expr::Unary(op, e) => {
            var ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
            match op {
                UnaryOp::Neg => {
                    if !TypeChecker_is_numeric(self, ty) {
                        self.errors.push("Type error: cannot negate " + type_to_str(ty));
                    }
                    return ty;
                }
                UnaryOp::Not => {
                    if !type_eq(ty, Type::Bool) {
                        self.errors.push("Type error: cannot logically negate " + type_to_str(ty));
                    }
                    return Type::Bool;
                }
                UnaryOp::BitNot => {
                    if !TypeChecker_is_numeric(self, ty) {
                        self.errors.push("Type error: cannot bitwise negate " + type_to_str(ty));
                    }
                    return ty;
                }
            }
            return ty;
        }
        Expr::Call(callee, args) => {
            // Check capabilities for built-in functions
            if callee == "print" || callee == "println" || callee == "print_int" || callee == "print_float" || callee == "print_str" {
                TypeChecker_check_capability(self, "IO", callee + "()");
            }
            if callee == "read_file" || callee == "write_file" || callee == "file_open" || callee == "file_read" || callee == "file_write" {
                TypeChecker_check_capability(self, "FS", callee + "()");
            }
            if callee == "http_get" || callee == "http_post" || callee == "socket_connect" || callee == "socket_send" || callee == "socket_recv" {
                TypeChecker_check_capability(self, "Net", callee + "()");
            }
            if callee == "spawn" || callee == "exec" || callee == "system" || callee == "p_thread_spawn" {
                TypeChecker_check_capability(self, "Spawn", callee + "()");
            }
            // GPU kernel builtins
            if callee == "thread_id" || callee == "workgroup_size" || callee == "workgroup_id" || callee == "num_workgroups" {
                return Type::I64;
            }
            if callee == "print" {
                var i: i64 = 0;
                while i < args.len() {
                    TypeChecker_check_expr(self, args.get(i));
                    i = i + 1;
                }
                return Type::Void;
            }
            // Check all arguments
            var arg_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                arg_types.push(TypeChecker_check_expr(self, args.get(i)));
                i = i + 1;
            }
            // @send check for p_thread_spawn and p_chan_send
            if callee == "p_thread_spawn" || callee == "p_chan_send" {
                if arg_types.len() >= 2 {
                    if !TypeChecker_is_send_type(self, arg_types.get(1)) {
                        self.errors.push("Thread safety error: " + callee + " argument is not @send");
                    }
                }
            }
            // Check if callee is a known function
            var fi: i64 = 0;
            while fi < self.funcs.len() {
                if self.funcs.get(fi).key == callee {
                    TypeChecker_check_visibility(self, callee);
                    var sig: FuncSig = self.funcs.get(fi).val;
                    if sig.param_types.len() != arg_types.len() {
                        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): function '" + callee + "' expects " + int_to_str(sig.param_types.len()) + " args, got " + int_to_str(arg_types.len()));
                    }
                    // Check argument types (loose for primitives, strict for named)
                    var pi: i64 = 0;
                    while pi < sig.param_types.len() && pi < arg_types.len() {
                        var param: Type = TypeChecker_resolve_type(self, sig.param_types.get(pi));
                        var arg: Type = arg_types.get(pi);
                        var param_is_named: bool = false;
                        match param {
                            Type::Named(_) => { param_is_named = true; }
                            _ => { param_is_named = false; }
                        }
                        if param_is_named && !TypeChecker_types_compatible(self, param, arg) {
                            self.errors.push("Type error: function '" + callee + "' parameter " + int_to_str(pi + 1) + " expects '" + type_to_str(param) + "', got '" + type_to_str(arg) + "'");
                        }
                        pi = pi + 1;
                    }
                    // For generic functions, return Never (compatible with any type)
                    if TypeChecker_type_contains_param(self, sig.ret_ty) {
                        return Type::Never;
                    }
                    return sig.ret_ty;
                }
                fi = fi + 1;
            }
            // Check for ECS runtime functions
            if str_starts_with(callee, "__ecs_") {
                if callee == "__ecs_create_entity" || callee == "__ecs_entity_count" || callee == "__ecs_has" || callee == "__ecs_get" {
                    return Type::I64;
                }
                if callee == "__ecs_add" || callee == "__ecs_remove" {
                    return Type::Void;
                }
                return Type::I64;
            }
            // Check for event handler functions
            if str_starts_with(callee, "__on_") {
                return Type::Void;
            }
            // Check for runtime builtin functions (p_*)
            if str_starts_with(callee, "p_") {
                if callee == "p_str_concat" || callee == "p_to_str" || callee == "p_float_to_str" || callee == "p_string_replace" || callee == "p_string_trim" || callee == "p_string_to_uppercase" || callee == "p_string_to_lowercase" || callee == "p_string_char_at" || callee == "p_string_repeat" || callee == "p_char_to_str" || callee == "p_bool_to_str" {
                    return Type::Str;
                }
                if callee == "p_string_contains" || callee == "p_string_starts_with" || callee == "p_string_ends_with" || callee == "p_string_is_empty" {
                    return Type::Bool;
                }
                if callee == "p_string_len" || callee == "p_string_find" || callee == "p_string_rfind" || callee == "p_string_bytes" || callee == "p_string_parse_int" {
                    return Type::I64;
                }
                return Type::I64;
            }
            // Check if callee is a local variable with function type (closure call)
            match TypeChecker_lookup(self, callee) {
                OptType::Some(var_ty) => {
                    match var_ty {
                        Type::Func(params, ret) => {
                            if params.len() != arg_types.len() {
                                self.errors.push("Type error: function variable '" + callee + "' expects " + int_to_str(params.len()) + " args, got " + int_to_str(arg_types.len()));
                            }
                            return box_type_unbox(ret);
                        }
                        _ => {}
                    }
                }
                OptType::None => {}
            }
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): undefined function '" + callee + "'");
            return Type::Never;
        }
        Expr::FieldAccess(obj_expr, field) => {
            var obj_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(obj_expr));
            // Unwrap references
            var effective_ty: Type = obj_ty;
            match obj_ty {
                Type::Ref(inner, _) => { effective_ty = box_type_unbox(inner); }
                _ => { effective_ty = obj_ty; }
            }
            match effective_ty {
                Type::Named(name) => {
                    // Find struct fields
                    var si: i64 = 0;
                    while si < self.structs.len() {
                        if self.structs.get(si).key == name {
                            var fields: Vec<StructField> = self.structs.get(si).val;
                            var fi: i64 = 0;
                            while fi < fields.len() {
                                if fields.get(fi).name == field {
                                    // Check field privacy
                                    var is_pub: bool = map_fieldvis_get(self.field_visibility, name, field);
                                    if !is_pub {
                                        var struct_module: str = "";
                                        match map_str_str_get(self.struct_modules, name) {
                                            OptString::Some(m) => { struct_module = m; }
                                            OptString::None => { struct_module = ""; }
                                        }
                                        if struct_module != self.current_module {
                                            self.errors.push("Privacy error: field '" + field + "' of struct '" + name + "' is private");
                                        }
                                    }
                                    return fields.get(fi).ty;
                                }
                                fi = fi + 1;
                            }
                            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): struct '" + name + "' has no field '" + field + "'");
                            si = self.structs.len(); // break
                        }
                        si = si + 1;
                    }
                }
                _ => {
                    self.errors.push("Type error: cannot access field '" + field + "' on type " + type_to_str(obj_ty));
                }
            }
            return Type::Never;
        }
        Expr::OptionalFieldAccess(obj_expr, field) => {
            var obj_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(obj_expr));
            match obj_ty {
                Type::Named(name) => {
                    var si: i64 = 0;
                    while si < self.structs.len() {
                        if self.structs.get(si).key == name {
                            var fields: Vec<StructField> = self.structs.get(si).val;
                            var fi: i64 = 0;
                            while fi < fields.len() {
                                if fields.get(fi).name == field {
                                    return fields.get(fi).ty;
                                }
                                fi = fi + 1;
                            }
                            si = self.structs.len();
                        }
                        si = si + 1;
                    }
                }
                _ => {}
            }
            return Type::I64;
        }
        Expr::StructLit(name, fields, spread) => {
            var real_name: str = TypeChecker_resolve_struct_name(self, name);
            // Find struct definition
            var si: i64 = 0;
            while si < self.structs.len() {
                if self.structs.get(si).key == real_name {
                    var struct_fields: Vec<StructField> = self.structs.get(si).val;
                    // Check spread source type
                    match spread {
                        OptBoxExpr::Some(spread_expr) => {
                            var spread_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(spread_expr));
                            if !TypeChecker_types_compatible(self, Type::Named(real_name), spread_ty) {
                                self.errors.push("Type error: spread source expected " + real_name + ", got " + type_to_str(spread_ty));
                            }
                        }
                        OptBoxExpr::None => {}
                    }
                    // Check each field
                    var fi: i64 = 0;
                    while fi < fields.len() {
                        var fname: str = fields.get(fi).name;
                        var fexpr: Expr = fields.get(fi).value;
                        var fty: Type = TypeChecker_check_expr(self, fexpr);
                        var found: bool = false;
                        var sfi: i64 = 0;
                        while sfi < struct_fields.len() {
                            if struct_fields.get(sfi).name == fname {
                                if !TypeChecker_types_compatible(self, struct_fields.get(sfi).ty, fty) {
                                    self.errors.push("Type error: field '" + fname + "' expected " + type_to_str(struct_fields.get(sfi).ty) + ", got " + type_to_str(fty));
                                }
                                found = true;
                                sfi = struct_fields.len();
                            }
                            sfi = sfi + 1;
                        }
                        if !found {
                            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): struct '" + name + "' has no field '" + fname + "'");
                        }
                        fi = fi + 1;
                    }
                    return Type::Named(real_name);
                }
                si = si + 1;
            }
            self.errors.push("Type error: unknown struct '" + name + "'");
            return Type::Never;
        }
        Expr::If(cond, then_block, else_block) => {
            TypeChecker_check_expr(self, box_expr_unbox(cond));
            TypeChecker_push_scope(self);
            var si: i64 = 0;
            while si < then_block.len() {
                TypeChecker_check_stmt(self, then_block.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            match else_block {
                OptStmts::Some(else_b) => {
                    TypeChecker_push_scope(self);
                    var si2: i64 = 0;
                    while si2 < else_b.len() {
                        TypeChecker_check_stmt(self, else_b.get(si2));
                        si2 = si2 + 1;
                    }
                    TypeChecker_pop_scope(self);
                }
                OptStmts::None => {}
            }
            return Type::Void;
        }
        Expr::Range(start, end, _) => {
            var st: Type = TypeChecker_check_expr(self, box_expr_unbox(start));
            var et: Type = TypeChecker_check_expr(self, box_expr_unbox(end));
            if !TypeChecker_is_numeric(self, st) || !TypeChecker_is_numeric(self, et) {
                self.errors.push("Type error: range bounds must be numeric, got " + type_to_str(st) + " and " + type_to_str(et));
            }
            return st;
        }
        Expr::Block(stmts) => {
            TypeChecker_push_scope(self);
            var last_ty: Type = Type::Void;
            var si: i64 = 0;
            while si < stmts.len() {
                match stmts.get(si) {
                    Stmt::Expr(e, _) => { last_ty = TypeChecker_check_expr(self, e); }
                    _ => { TypeChecker_check_stmt(self, stmts.get(si)); last_ty = Type::Void; }
                }
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            return last_ty;
        }
        Expr::MethodCall(receiver, method, args) => {
            return TypeChecker_check_method_call(self, box_expr_unbox(receiver), method, args, hint);
        }
        Expr::ArrayLit(elem_type, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                var et: Type = TypeChecker_check_expr(self, elements.get(i));
                if !TypeChecker_types_compatible(self, box_type_unbox(elem_type), et) {
                    self.errors.push("Type error: array element type mismatch, expected " + type_to_str(box_type_unbox(elem_type)) + ", got " + type_to_str(et));
                }
                i = i + 1;
            }
            return Type::Array(elem_type, elements.len());
        }
        Expr::Index(array, index) => {
            var arr_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(array));
            // String slicing
            match arr_ty {
                Type::Named(name) => {
                    if name == "String" { return Type::Named("String"); }
                }
                _ => {}
            }
            var idx_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(index));
            if !TypeChecker_is_numeric(self, idx_ty) {
                self.errors.push("Type error: array index must be numeric, got " + type_to_str(idx_ty));
            }
            match arr_ty {
                Type::Array(elem, _) => { return box_type_unbox(elem); }
                Type::ArrayConst(elem, _) => { return box_type_unbox(elem); }
                Type::Generic(name, args) => {
                    if name == "Vec" {
                        if args.len() > 0 { return args.get(0); }
                        return Type::I64;
                    }
                }
                Type::Named(name) => {
                    if name == "Vec" { return Type::I64; }
                }
                _ => {
                    self.errors.push("Type error: cannot index type " + type_to_str(arr_ty));
                }
            }
            return Type::Never;
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(e) => { TypeChecker_check_expr(self, e); }
                    FStringPart::Literal(_) => {}
                }
                i = i + 1;
            }
            return Type::Str;
        }
        Expr::Match(expr, arms) => {
            var match_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(expr));
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                TypeChecker_push_scope(self);
                match arm.pattern {
                    Pattern::Ident(name) => { TypeChecker_declare(self, name, match_ty); }
                    Pattern::EnumVariant(enum_name, variant, bindings) => {
                        var tys: Vec<Type> = TypeChecker_pattern_binding_types(self, match_ty, enum_name, variant, bindings);
                        var bi: i64 = 0;
                        while bi < bindings.len() && bi < tys.len() {
                            TypeChecker_declare(self, bindings.get(bi).name, tys.get(bi));
                            bi = bi + 1;
                        }
                    }
                    Pattern::StrLit(_) => {}
                    Pattern::Range(_, _) => {}
                    _ => {}
                }
                match arm.guard {
                    OptBoxExpr::Some(g) => { TypeChecker_check_expr(self, box_expr_unbox(g)); }
                    OptBoxExpr::None => {}
                }
                var si: i64 = 0;
                while si < arm.body.len() {
                    TypeChecker_check_stmt(self, arm.body.get(si));
                    si = si + 1;
                }
                TypeChecker_pop_scope(self);
                ai = ai + 1;
            }
            return Type::Void;
        }
        Expr::EnumLit(enum_name, _, args) => {
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_check_expr(self, args.get(i));
                i = i + 1;
            }
            return Type::Named(enum_name);
        }
        Expr::Ref(e, is_mut) => {
            var inner_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
            return Type::Ref(Box::new(inner_ty), is_mut);
        }
        Expr::Deref(e) => {
            var ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
            match ty {
                Type::Ref(inner, _) => { var t: Type = box_type_unbox(inner); return t; }
                Type::RawPtr(inner, _) => { var t: Type = box_type_unbox(inner); return t; }
                _ => {
                    self.errors.push("Type error: cannot dereference non-reference type " + type_to_str(ty));
                    return Type::Never;
                }
            }
            return Type::Never;
        }
        Expr::StrConcat(left, right) => {
            var lt: Type = TypeChecker_check_expr(self, box_expr_unbox(left));
            var rt: Type = TypeChecker_check_expr(self, box_expr_unbox(right));
            if !type_eq(lt, Type::Str) && !type_eq(lt, Type::Named("String")) {
                self.errors.push("Type error: string concat requires str or String. Left: " + type_to_str(lt));
            }
            if !type_eq(rt, Type::Str) && !type_eq(rt, Type::Named("String")) {
                self.errors.push("Type error: string concat requires str or String. Right: " + type_to_str(rt));
            }
            return Type::Str;
        }
        Expr::Try(e) => {
            var ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
            match ty {
                Type::Generic(name, args) => {
                    if name == "Result" && args.len() == 2 { return args.get(0); }
                    if name == "Option" && args.len() == 1 { return args.get(0); }
                }
                Type::Named(name) => {
                    if name == "Result" || name == "Option" { return Type::I64; }
                }
                _ => {}
            }
            self.errors.push("Type error: ? operator requires Option<T> or Result<T, E>. Found: " + type_to_str(ty));
            return Type::Never;
        }
        Expr::Coalesce(e, default) => {
            var ty: Type = TypeChecker_check_expr(self, box_expr_unbox(e));
            var default_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(default));
            match ty {
                Type::Generic(name, args) => {
                    if name == "Option" && args.len() == 1 {
                        if !TypeChecker_types_compatible(self, args.get(0), default_ty) {
                            self.errors.push("Type error: ?? default value type mismatch");
                        }
                        return args.get(0);
                    }
                }
                Type::Named(name) => {
                    if name == "Option" { return Type::I64; }
                }
                _ => {}
            }
            self.errors.push("Type error: ?? operator requires Option<T>. Found: " + type_to_str(ty));
            return Type::Never;
        }
        Expr::TryBlock(body) => {
            var last_ty: Type = Type::I64;
            var si: i64 = 0;
            while si < body.len() {
                match body.get(si) {
                    Stmt::Expr(e, _) => { last_ty = TypeChecker_check_expr(self, e); }
                    _ => { TypeChecker_check_stmt(self, body.get(si)); }
                }
                si = si + 1;
            }
            var result_args: Vec<Type> = Vec::new();
            result_args.push(last_ty);
            result_args.push(Type::I64);
            return Type::Generic("Result", result_args);
        }
        Expr::IsCheck(e, type_name) => {
            TypeChecker_check_expr(self, box_expr_unbox(e));
            return Type::Bool;
        }
        Expr::TupleLit(elems) => {
            var types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < elems.len() {
                types.push(TypeChecker_check_expr(self, elems.get(i)));
                i = i + 1;
            }
            return Type::Tuple(types);
        }
        Expr::Closure(params, body, ret_ty) => {
            TypeChecker_push_scope(self);
            var pi: i64 = 0;
            while pi < params.len() {
                TypeChecker_declare(self, params.get(pi).name, TypeChecker_resolve_type(self, params.get(pi).ty));
                pi = pi + 1;
            }
            var si: i64 = 0;
            while si < body.len() {
                TypeChecker_check_stmt(self, body.get(si));
                si = si + 1;
            }
            TypeChecker_pop_scope(self);
            match ret_ty {
                OptType::Some(t) => { return t; }
                OptType::None => { return Type::Void; }
            }
            return Type::Void;
        }
        Expr::Cast(e, target_ty) => {
            TypeChecker_check_expr(self, box_expr_unbox(e));
            return TypeChecker_resolve_type(self, target_ty);
        }
        Expr::Asm(_, operands) => {
            var has_out: bool = false;
            var i: i64 = 0;
            while i < operands.len() {
                var op: AsmOperand = operands.get(i);
                TypeChecker_check_expr(self, op.expr);
                match op.direction {
                    AsmDir::In => {}
                    AsmDir::Out => { has_out = true; }
                }
                i = i + 1;
            }
            if has_out { return Type::I64; }
            return Type::Void;
        }
        Expr::Comptime(inner) => { return TypeChecker_check_expr(self, box_expr_unbox(inner)); }
        Expr::ComptimeBlock(stmts) => {
            var si: i64 = 0;
            while si < stmts.len() {
                TypeChecker_check_stmt(self, stmts.get(si));
                si = si + 1;
            }
            return Type::I64;
        }
        Expr::ComptimeReflect(op, _) => {
            match op {
                ReflectOp::TypeName => { return Type::Str; }
                ReflectOp::IsStruct => { return Type::Bool; }
                ReflectOp::IsEnum => { return Type::Bool; }
                ReflectOp::FieldCount => { return Type::I64; }
                ReflectOp::FieldNames => { return Type::Array(Box::new(Type::Str), 0); }
                ReflectOp::FieldTypes => { return Type::Array(Box::new(Type::Str), 0); }
                ReflectOp::EnumVariants => { return Type::Array(Box::new(Type::Str), 0); }
            }
            return Type::I64;
        }
        Expr::PipeForward(left, right) => {
            var left_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(left));
            // Desugar: if right is a Call, typecheck as call with left prepended
            match right {
                Expr::Call(callee, args) => {
                    var all_args: Vec<Expr> = Vec::new();
                    all_args.push(left);
                    var i: i64 = 0;
                    while i < args.len() {
                        all_args.push(args.get(i));
                        i = i + 1;
                    }
                    return TypeChecker_check_expr(self, Expr::Call(callee, all_args));
                }
                Expr::MethodCall(receiver, method, args) => {
                    return TypeChecker_check_expr(self, Expr::MethodCall(left, method, args));
                }
                Expr::Ident(name) => {
                    var call_args: Vec<Expr> = Vec::new();
                    call_args.push(left);
                    return TypeChecker_check_expr(self, Expr::Call(name, call_args));
                }
                _ => {
                    return TypeChecker_check_expr(self, box_expr_unbox(right));
                }
            }
            return Type::Never;
        }
        Expr::QuantCast(e, target_ty) => {
            TypeChecker_check_expr(self, box_expr_unbox(e));
            return TypeChecker_resolve_type(self, target_ty);
        }
        Expr::Await(inner) => {
            var inner_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(inner));
            match inner_ty {
                Type::Generic(name, args) => {
                    if name == "Future" && args.len() == 1 { return args.get(0); }
                }
                Type::Named(name) => {
                    if name == "Future" { return Type::I64; }
                }
                _ => {}
            }
            self.errors.push("Type error: await requires a Future<T> operand, got " + type_to_str(inner_ty));
            return Type::I64;
        }
        Expr::Spawn(inner) => {
            var inner_ty: Type = TypeChecker_check_expr(self, box_expr_unbox(inner));
            match inner_ty {
                Type::Generic(name, args) => {
                    if name == "Future" { return inner_ty; }
                }
                Type::Named(name) => {
                    if name == "Future" { return inner_ty; }
                }
                _ => {}
            }
            // Wrap non-Future in Future<T>
            var future_args: Vec<Type> = Vec::new();
            future_args.push(inner_ty);
            return Type::Generic("Future", future_args);
        }
    }
    return Type::Never;
}

// ──── CHUNK_MARKER_8 ────

// ─── check_method_call ───────────────────────────────────────────────────

pub fn TypeChecker_check_method_call(self: &mut TypeChecker, receiver: Expr, method: str, args: Vec<Expr>, hint: Type) -> Type {
    // Check if this is Box::new(x), Rc::new(x), Arc::new(x), Vec::new(), HashMap::new()
    match receiver {
        Expr::Ident(name) => {
            if name == "Box" && method == "new" {
                if args.len() > 0 {
                    var arg_ty: Type = TypeChecker_check_expr(self, args.get(0));
                    return Type::Ref(Box::new(arg_ty), true);
                }
            }
            if name == "Rc" && method == "new" {
                if args.len() > 0 {
                    var arg_ty: Type = TypeChecker_check_expr(self, args.get(0));
                    var rc_args: Vec<Type> = Vec::new();
                    rc_args.push(arg_ty);
                    return Type::Generic("Rc", rc_args);
                }
            }
            if name == "Arc" && method == "new" {
                if args.len() > 0 {
                    var arg_ty: Type = TypeChecker_check_expr(self, args.get(0));
                    var arc_args: Vec<Type> = Vec::new();
                    arc_args.push(arg_ty);
                    return Type::Generic("Arc", arc_args);
                }
            }
            if name == "Vec" && method == "new" {
                match hint {
                    Type::Generic(hn, hargs) => {
                        if hn == "Vec" { return Type::Generic("Vec", hargs); }
                    }
                    _ => {}
                }
                var default_args: Vec<Type> = Vec::new();
                default_args.push(Type::I64);
                return Type::Generic("Vec", default_args);
            }
            if name == "HashMap" && method == "new" {
                match hint {
                    Type::Generic(hn, hargs) => {
                        if hn == "HashMap" && hargs.len() == 2 { return Type::Generic("HashMap", hargs); }
                    }
                    _ => {}
                }
                var default_args: Vec<Type> = Vec::new();
                default_args.push(Type::Str);
                default_args.push(Type::I64);
                return Type::Generic("HashMap", default_args);
            }
            if name == "String" && method == "from" {
                if args.len() > 0 { TypeChecker_check_expr(self, args.get(0)); }
                return Type::Named("String");
            }
            // Check if it's an associated function call (e.g. Point::new(x, y))
            // Check if name is a known struct
            var si: i64 = 0;
            while si < self.structs.len() {
                if self.structs.get(si).key == name {
                    var arg_types: Vec<Type> = Vec::new();
                    var ai: i64 = 0;
                    while ai < args.len() {
                        arg_types.push(TypeChecker_check_expr(self, args.get(ai)));
                        ai = ai + 1;
                    }
                    // Find method in method map
                    var mi: i64 = 0;
                    while mi < self.methods.len() {
                        if self.methods.get(mi).key == name {
                            var method_map: Vec<MethodMapEntry> = self.methods.get(mi).val;
                            var mei: i64 = 0;
                            while mei < method_map.len() {
                                if method_map.get(mei).key == method {
                                    var info: MethodInfo = method_map.get(mei).val;
                                    if info.param_types.len() != arg_types.len() {
                                        self.errors.push("Type error: associated function '" + name + "::" + method + "' expects " + int_to_str(info.param_types.len()) + " args, got " + int_to_str(arg_types.len()));
                                    }
                                    return info.ret_ty;
                                }
                                mei = mei + 1;
                            }
                            mi = self.methods.len();
                        }
                        mi = mi + 1;
                    }
                    self.errors.push("Type error: no associated function '" + method + "' on struct '" + name + "'");
                    return Type::Never;
                }
                si = si + 1;
            }
        }
        _ => {}
    }
    // Check receiver type and dispatch method
    var recv_ty_raw: Type = TypeChecker_check_expr(self, receiver);
    var arg_types: Vec<Type> = Vec::new();
    var ai: i64 = 0;
    while ai < args.len() {
        arg_types.push(TypeChecker_check_expr(self, args.get(ai)));
        ai = ai + 1;
    }
    // Auto-deref &T / &mut T
    var recv_ty: Type = recv_ty_raw;
    match recv_ty_raw {
        Type::Ref(inner, _) => { recv_ty = box_type_unbox(inner); }
        _ => { recv_ty = recv_ty_raw; }
    }
    // Builtin Vec methods
    match recv_ty {
        Type::Generic(name, gargs) => {
            if name == "Vec" {
                var elem_ty: Type = Type::I64;
                if gargs.len() > 0 { elem_ty = gargs.get(0); }
                if method == "push" { return Type::Void; }
                if method == "pop" { return elem_ty; }
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "get" { return elem_ty; }
                if method == "set" { return Type::Void; }
                if method == "clear" { return Type::Void; }
                if method == "capacity" { return Type::I64; }
                if method == "insert" { return Type::Void; }
                if method == "remove" { return elem_ty; }
                if method == "contains" { return Type::Bool; }
                if method == "reverse" { return Type::Void; }
                if method == "first" { return elem_ty; }
                if method == "last" { return elem_ty; }
                if method == "extend" { return Type::Void; }
                if method == "truncate" { return Type::Void; }
                if method == "sort" { return Type::Void; }
                if method == "for_each" { return Type::Void; }
                if method == "fold" { return Type::I64; }
                if method == "any" { return Type::Bool; }
                if method == "all" { return Type::Bool; }
                if method == "find" { return Type::I64; }
                if method == "position" { return Type::I64; }
                if method == "clone" {
                    var clone_args: Vec<Type> = Vec::new();
                    clone_args.push(elem_ty);
                    return Type::Generic("Vec", clone_args);
                }
                if method == "map" {
                    var map_args: Vec<Type> = Vec::new();
                    map_args.push(elem_ty);
                    return Type::Generic("Vec", map_args);
                }
                if method == "filter" {
                    var filter_args: Vec<Type> = Vec::new();
                    filter_args.push(elem_ty);
                    return Type::Generic("Vec", filter_args);
                }
                self.errors.push("Type error: no method '" + method + "' on Vec");
                return Type::Never;
            }
            if name == "HashMap" {
                var key_ty: Type = Type::Str;
                if gargs.len() > 0 { key_ty = gargs.get(0); }
                var val_ty: Type = Type::I64;
                if gargs.len() > 1 { val_ty = gargs.get(1); }
                if method == "insert" { return Type::Void; }
                if method == "get" { return val_ty; }
                if method == "contains" { return Type::Bool; }
                if method == "remove" { return Type::Void; }
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "clear" { return Type::Void; }
                if method == "get_or" { return val_ty; }
                if method == "keys" {
                    var keys_args: Vec<Type> = Vec::new();
                    keys_args.push(key_ty);
                    return Type::Generic("Vec", keys_args);
                }
                if method == "values" {
                    var values_args: Vec<Type> = Vec::new();
                    values_args.push(val_ty);
                    return Type::Generic("Vec", values_args);
                }
                if method == "clone" { return Type::Generic("HashMap", gargs); }
                self.errors.push("Type error: no method '" + method + "' on HashMap");
                return Type::Never;
            }
            if name == "Rc" {
                var elem_ty: Type = Type::I64;
                if gargs.len() > 0 { elem_ty = gargs.get(0); }
                if method == "clone" { return Type::Generic("Rc", gargs); }
                if method == "drop" { return Type::Void; }
                if method == "get" { return elem_ty; }
                if method == "count" { return Type::I64; }
                self.errors.push("Type error: no method '" + method + "' on Rc");
                return Type::Never;
            }
            if name == "Arc" {
                var elem_ty: Type = Type::I64;
                if gargs.len() > 0 { elem_ty = gargs.get(0); }
                if method == "clone" { return Type::Generic("Arc", gargs); }
                if method == "drop" { return Type::Void; }
                if method == "get" { return elem_ty; }
                if method == "count" { return Type::I64; }
                self.errors.push("Type error: no method '" + method + "' on Arc");
                return Type::Never;
            }
        }
        Type::Named(n) => {
            if n == "String" {
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "push_str" { return Type::Named("String"); }
                if method == "to_string" { return Type::Named("String"); }
                if method == "contains" { return Type::Bool; }
                if method == "starts_with" { return Type::Bool; }
                if method == "ends_with" { return Type::Bool; }
                if method == "trim" { return Type::Named("String"); }
                if method == "replace" { return Type::Named("String"); }
                if method == "to_uppercase" { return Type::Named("String"); }
                if method == "to_lowercase" { return Type::Named("String"); }
                if method == "parse_int" { return Type::I64; }
                if method == "find" { return Type::I64; }
                if method == "rfind" { return Type::I64; }
                if method == "repeat" { return Type::Named("String"); }
                if method == "bytes" { return Type::I64; }
                if method == "clone" { return Type::Named("String"); }
                if method == "split" {
                    var split_args: Vec<Type> = Vec::new();
                    split_args.push(Type::Named("String"));
                    return Type::Generic("Vec", split_args);
                }
                self.errors.push("Type error: no method '" + method + "' on String");
                return Type::Never;
            }
            // Named("Vec") without generic args — treat as Vec<i64>
            if n == "Vec" {
                var elem_ty: Type = Type::I64;
                if method == "push" { return Type::Void; }
                if method == "pop" { return elem_ty; }
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "get" { return elem_ty; }
                if method == "set" { return Type::Void; }
                if method == "clear" { return Type::Void; }
                if method == "capacity" { return Type::I64; }
                if method == "insert" { return Type::Void; }
                if method == "remove" { return elem_ty; }
                if method == "contains" { return Type::Bool; }
                if method == "reverse" { return Type::Void; }
                if method == "first" { return elem_ty; }
                if method == "last" { return elem_ty; }
                if method == "extend" { return Type::Void; }
                if method == "truncate" { return Type::Void; }
                if method == "sort" { return Type::Void; }
                if method == "clone" {
                    var clone_args: Vec<Type> = Vec::new();
                    clone_args.push(elem_ty);
                    return Type::Generic("Vec", clone_args);
                }
                if method == "map" {
                    var map_args: Vec<Type> = Vec::new();
                    map_args.push(elem_ty);
                    return Type::Generic("Vec", map_args);
                }
                if method == "filter" {
                    var filter_args: Vec<Type> = Vec::new();
                    filter_args.push(elem_ty);
                    return Type::Generic("Vec", filter_args);
                }
                if method == "for_each" { return Type::Void; }
                if method == "fold" { return Type::I64; }
                if method == "any" { return Type::Bool; }
                if method == "all" { return Type::Bool; }
                if method == "find" { return Type::I64; }
                if method == "position" { return Type::I64; }
                self.errors.push("Type error: no method '" + method + "' on Vec");
                return Type::Never;
            }
            // Named("HashMap") without generic args — treat as HashMap<str, i64>
            if n == "HashMap" {
                var key_ty: Type = Type::Str;
                var val_ty: Type = Type::I64;
                if method == "insert" { return Type::Void; }
                if method == "get" { return val_ty; }
                if method == "contains" { return Type::Bool; }
                if method == "remove" { return Type::Void; }
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "clear" { return Type::Void; }
                if method == "get_or" { return val_ty; }
                if method == "keys" {
                    var keys_args: Vec<Type> = Vec::new();
                    keys_args.push(key_ty);
                    return Type::Generic("Vec", keys_args);
                }
                if method == "values" {
                    var values_args: Vec<Type> = Vec::new();
                    values_args.push(val_ty);
                    return Type::Generic("Vec", values_args);
                }
                self.errors.push("Type error: no method '" + method + "' on HashMap");
                return Type::Never;
            }
        }
        _ => {}
    }
    // Check if receiver is a trait object (dyn Trait)
    match recv_ty {
        Type::Dyn(trait_name) => {
            match map_traits_get(self.traits, trait_name) {
                OptTraitMethodMap::Some(trait_methods) => {
                    match trait_method_map_get(trait_methods, method) {
                        OptTraitMethodInfo::Some(info) => {
                            return info.ret_ty;
                        }
                        OptTraitMethodInfo::None => {}
                    }
                }
                OptTraitMethodMap::None => {}
            }
            self.errors.push("Type error: no method '" + method + "' on trait '" + trait_name + "'");
            return Type::Never;
        }
        _ => {}
    }
    // Auto-deref for method lookup
    var effective_recv_ty: Type = recv_ty;
    match recv_ty {
        Type::Ref(inner, _) => { effective_recv_ty = box_type_unbox(inner); }
        _ => { effective_recv_ty = recv_ty; }
    }
    // Handle Type::Named("Vec") — Vec without type params (same as Generic("Vec", [I64]))
    match effective_recv_ty {
        Type::Named(n) => {
            if n == "Vec" {
                var elem_ty: Type = Type::I64;
                if method == "push" { return Type::Void; }
                if method == "pop" { return elem_ty; }
                if method == "len" { return Type::I64; }
                if method == "is_empty" { return Type::Bool; }
                if method == "get" { return elem_ty; }
                if method == "set" { return Type::Void; }
                if method == "clear" { return Type::Void; }
                if method == "capacity" { return Type::I64; }
                if method == "insert" { return Type::Void; }
                if method == "remove" { return elem_ty; }
                if method == "contains" { return Type::Bool; }
                if method == "reverse" { return Type::Void; }
                if method == "first" { return elem_ty; }
                if method == "last" { return elem_ty; }
                if method == "extend" { return Type::Void; }
                if method == "truncate" { return Type::Void; }
                if method == "sort" { return Type::Void; }
                if method == "for_each" { return Type::Void; }
                if method == "fold" { return Type::I64; }
                if method == "any" { return Type::Bool; }
                if method == "all" { return Type::Bool; }
                if method == "find" { return Type::I64; }
                if method == "position" { return Type::I64; }
                if method == "clone" {
                    var clone_args: Vec<Type> = Vec::new();
                    clone_args.push(elem_ty);
                    return Type::Generic("Vec", clone_args);
                }
                if method == "map" {
                    var map_args: Vec<Type> = Vec::new();
                    map_args.push(elem_ty);
                    return Type::Generic("Vec", map_args);
                }
                if method == "filter" {
                    var filter_args: Vec<Type> = Vec::new();
                    filter_args.push(elem_ty);
                    return Type::Generic("Vec", filter_args);
                }
                self.errors.push("Type error: no method '" + method + "' on Vec");
                return Type::Never;
            }
        }
        _ => {}
    }
    match effective_recv_ty {
        Type::Named(struct_name) => {
            // Find method in method map
            var mi: i64 = 0;
            while mi < self.methods.len() {
                if self.methods.get(mi).key == struct_name {
                    var method_map: Vec<MethodMapEntry> = self.methods.get(mi).val;
                    var mei: i64 = 0;
                    while mei < method_map.len() {
                        if method_map.get(mei).key == method {
                            return method_map.get(mei).val.ret_ty;
                        }
                        mei = mei + 1;
                    }
                    mi = self.methods.len();
                }
                mi = mi + 1;
            }
            // Check if this is a type param with a trait bound
            if str_vec_contains(self.current_type_params, struct_name) {
                var bound_trait: OptString = OptString::None;
                var bi: i64 = 0;
                while bi < self.current_type_param_bounds.len() {
                    if self.current_type_param_bounds.get(bi).key == struct_name {
                        bound_trait = OptString::Some(self.current_type_param_bounds.get(bi).val);
                        bi = self.current_type_param_bounds.len();
                    }
                    bi = bi + 1;
                }
                match bound_trait {
                    OptString::Some(trait_name) => {
                        match map_traits_get(self.traits, trait_name) {
                            OptTraitMethodMap::Some(trait_methods) => {
                                match trait_method_map_get(trait_methods, method) {
                                    OptTraitMethodInfo::Some(info) => { return info.ret_ty; }
                                    OptTraitMethodInfo::None => {}
                                }
                            }
                            OptTraitMethodMap::None => {}
                        }
                    }
                    OptString::None => {}
                }
            }
            self.errors.push("Type error: no method '" + method + "' on struct '" + struct_name + "'");
        }
        Type::Generic(gen_name, _) => {
            // Generic type: look up methods by base name
            var mi: i64 = 0;
            while mi < self.methods.len() {
                if self.methods.get(mi).key == gen_name {
                    var method_map: Vec<MethodMapEntry> = self.methods.get(mi).val;
                    var mei: i64 = 0;
                    while mei < method_map.len() {
                        if method_map.get(mei).key == method {
                            return method_map.get(mei).val.ret_ty;
                        }
                        mei = mei + 1;
                    }
                    mi = self.methods.len();
                }
                mi = mi + 1;
            }
            self.errors.push("Type error: no method '" + method + "' on generic type '" + gen_name + "'");
        }
        _ => {
            self.errors.push("Type error: cannot call method '" + method + "' on type " + type_to_str(recv_ty));
        }
    }
    return Type::Never;
}

// ─── pattern_binding_types ───────────────────────────────────────────────

pub fn TypeChecker_pattern_binding_types(self: &TypeChecker, match_ty: Type, enum_name: str, variant: str, bindings: Vec<Binding>) -> Vec<Type> {
    var result: Vec<Type> = Vec::new();
    // Find enum variant payload types
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        if self.enum_variants.get(ei).key == enum_name {
            var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
            var vi: i64 = 0;
            while vi < variants.len() {
                if variants.get(vi).name == variant {
                    var payload_types: Vec<Type> = variants.get(vi).payload_types;
                    var pi: i64 = 0;
                    while pi < payload_types.len() && pi < bindings.len() {
                        result.push(payload_types.get(pi));
                        pi = pi + 1;
                    }
                    return result;
                }
                vi = vi + 1;
            }
            ei = self.enum_variants.len();
        }
        ei = ei + 1;
    }
    // Default: all i64
    var bi: i64 = 0;
    while bi < bindings.len() {
        result.push(Type::I64);
        bi = bi + 1;
    }
    return result;
}

// ──── CHUNK_MARKER_9 ────

// ─── scan_stmts_for_effects ──────────────────────────────────────────────

pub fn TypeChecker_scan_stmts_for_effects(self: &TypeChecker, stmts: Vec<Stmt>, effects: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        TypeChecker_scan_stmt_for_effects(self, stmts.get(i), effects);
        i = i + 1;
    }
}

pub fn TypeChecker_scan_stmt_for_effects(self: &TypeChecker, stmt: Stmt, effects: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _) => { TypeChecker_scan_expr_for_effects(self, expr, effects); }
        Stmt::LetTuple(_, expr, _) => { TypeChecker_scan_expr_for_effects(self, expr, effects); }
        Stmt::Expr(expr, _) => { TypeChecker_scan_expr_for_effects(self, expr, effects); }
        Stmt::Assign(_, _, expr, _) => { TypeChecker_scan_expr_for_effects(self, expr, effects); }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            TypeChecker_scan_expr_for_effects(self, index, effects);
            TypeChecker_scan_expr_for_effects(self, expr, effects);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            TypeChecker_scan_expr_for_effects(self, ptr_expr, effects);
            TypeChecker_scan_expr_for_effects(self, expr, effects);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            TypeChecker_scan_expr_for_effects(self, object, effects);
            TypeChecker_scan_expr_for_effects(self, expr, effects);
        }
        Stmt::Return(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            TypeChecker_scan_expr_for_effects(self, cond, effects);
            TypeChecker_scan_stmts_for_effects(self, then_block, effects);
            match else_block {
                OptStmts::Some(eb) => { TypeChecker_scan_stmts_for_effects(self, eb, effects); }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, _) => {
            TypeChecker_scan_expr_for_effects(self, cond, effects);
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::For(_, iterator, body, _) => {
            TypeChecker_scan_expr_for_effects(self, iterator, effects);
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::Loop(body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Defer(body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Match(expr, arms, _) => {
            TypeChecker_scan_expr_for_effects(self, expr, effects);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_scan_stmts_for_effects(self, arms.get(ai).body, effects);
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Sandbox(body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Unsafe(body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Txn(body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::GradBlock(_, body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Backward(loss, _) => { TypeChecker_scan_expr_for_effects(self, loss, effects); }
        Stmt::Query(_, body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                TypeChecker_scan_expr_for_effects(self, cases.get(ci).channel, effects);
                TypeChecker_scan_stmts_for_effects(self, cases.get(ci).body, effects);
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(db) => { TypeChecker_scan_stmts_for_effects(self, db, effects); }
                OptStmts::None => {}
            }
        }
        Stmt::Handle(body, handlers, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
            var hi: i64 = 0;
            while hi < handlers.len() {
                TypeChecker_scan_stmts_for_effects(self, handlers.get(hi).body, effects);
                hi = hi + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(ai), effects);
                ai = ai + 1;
            }
        }
        _ => {}
    }
}

pub fn TypeChecker_scan_expr_for_effects(self: &TypeChecker, expr: Expr, effects: &mut Vec<str>) {
    match expr {
        Expr::IntLit(_) => {}
        Expr::FloatLit(_) => {}
        Expr::StringLit(_) => {}
        Expr::BoolLit(_) => {}
        Expr::Ident(_) => {}
        Expr::Binary(_, left, right) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(left), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(right), effects);
        }
        Expr::Unary(_, e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Call(callee, args) => {
            // Map builtin calls to effects
            if callee == "print" || callee == "println" || callee == "print_int" || callee == "print_float" || callee == "print_str" {
                if !str_vec_contains_ref(effects, "IO") { effects.push("IO"); }
            }
            if callee == "read_file" || callee == "write_file" || callee == "file_open" || callee == "file_read" || callee == "file_write" {
                if !str_vec_contains_ref(effects, "FS") { effects.push("FS"); }
            }
            if callee == "http_get" || callee == "http_post" || callee == "socket_connect" || callee == "socket_send" || callee == "socket_recv" {
                if !str_vec_contains_ref(effects, "Net") { effects.push("Net"); }
            }
            if callee == "spawn" || callee == "exec" || callee == "system" || callee == "p_thread_spawn" {
                if !str_vec_contains_ref(effects, "Spawn") { effects.push("Spawn"); }
            }
            // Check p_* builtins
            if str_starts_with(callee, "p_") {
                if callee == "p_vec_new" || callee == "p_vec_push" || callee == "p_hashmap_new" || callee == "p_alloc" {
                    if !str_vec_contains_ref(effects, "Alloc") { effects.push("Alloc"); }
                }
                if callee == "p_panic" || callee == "p_unreachable" {
                    if !str_vec_contains_ref(effects, "Diverge") { effects.push("Diverge"); }
                }
                if callee == "p_print" || callee == "p_println" || callee == "p_print_int" || callee == "p_print_float" || callee == "p_print_str" {
                    if !str_vec_contains_ref(effects, "IO") { effects.push("IO"); }
                    if !str_vec_contains_ref(effects, "Read") { effects.push("Read"); }
                }
                if callee == "p_vec_get" || callee == "p_hashmap_get" || callee == "p_string_contains" {
                    if !str_vec_contains_ref(effects, "Read") { effects.push("Read"); }
                }
                if callee == "p_vec_set" || callee == "p_hashmap_insert" || callee == "p_string_replace" {
                    if !str_vec_contains_ref(effects, "Write") { effects.push("Write"); }
                }
            }
            // Check user-defined function effects
            var fi: i64 = 0;
            while fi < self.func_effects.len() {
                if self.func_effects.get(fi).key == callee {
                    var func_effs: Vec<str> = self.func_effects.get(fi).val;
                    var ei: i64 = 0;
                    while ei < func_effs.len() {
                        if !str_vec_contains_ref(effects, func_effs.get(ei)) {
                            effects.push(func_effs.get(ei));
                        }
                        ei = ei + 1;
                    }
                    fi = self.func_effects.len();
                }
                fi = fi + 1;
            }
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(ai), effects);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(receiver), effects);
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(ai), effects);
                ai = ai + 1;
            }
        }
        Expr::FieldAccess(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::OptionalFieldAccess(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                TypeChecker_scan_expr_for_effects(self, fields.get(fi).value, effects);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(s), effects); }
                OptBoxExpr::None => {}
            }
        }
        Expr::If(cond, then_block, else_block) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(cond), effects);
            TypeChecker_scan_stmts_for_effects(self, then_block, effects);
            match else_block {
                OptStmts::Some(eb) => { TypeChecker_scan_stmts_for_effects(self, eb, effects); }
                OptStmts::None => {}
            }
        }
        Expr::Range(start, end, _) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(start), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(end), effects);
        }
        Expr::Block(stmts) => { TypeChecker_scan_stmts_for_effects(self, stmts, effects); }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_scan_expr_for_effects(self, elements.get(i), effects);
                i = i + 1;
            }
        }
        Expr::Index(array, index) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(array), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(index), effects);
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(e) => { TypeChecker_scan_expr_for_effects(self, e, effects); }
                    FStringPart::Literal(_) => {}
                }
                i = i + 1;
            }
        }
        Expr::Match(expr, arms) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(expr), effects);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_scan_stmts_for_effects(self, arms.get(ai).body, effects);
                match arms.get(ai).guard {
                    OptBoxExpr::Some(g) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(g), effects); }
                    OptBoxExpr::None => {}
                }
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(i), effects);
                i = i + 1;
            }
        }
        Expr::Ref(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Deref(e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::StrConcat(l, r) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(l), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(r), effects);
        }
        Expr::Try(e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Coalesce(e, d) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(d), effects);
        }
        Expr::TryBlock(body) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Expr::IsCheck(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::TupleLit(elems) => {
            var i: i64 = 0;
            while i < elems.len() {
                TypeChecker_scan_expr_for_effects(self, elems.get(i), effects);
                i = i + 1;
            }
        }
        Expr::Closure(_, body, _) => { TypeChecker_scan_stmts_for_effects(self, body, effects); }
        Expr::Cast(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Asm(_, operands) => {
            if !str_vec_contains_ref(effects, "Read") { effects.push("Read"); }
            if !str_vec_contains_ref(effects, "Write") { effects.push("Write"); }
            var i: i64 = 0;
            while i < operands.len() {
                TypeChecker_scan_expr_for_effects(self, operands.get(i).expr, effects);
                i = i + 1;
            }
        }
        Expr::Comptime(e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::ComptimeBlock(stmts) => { TypeChecker_scan_stmts_for_effects(self, stmts, effects); }
        Expr::ComptimeReflect(_, _) => {}
        Expr::PipeForward(left, right) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(left), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(right), effects);
        }
        Expr::QuantCast(e, _) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Await(e) => { TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects); }
        Expr::Spawn(e) => {
            if !str_vec_contains_ref(effects, "Spawn") { effects.push("Spawn"); }
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
    }
}

// ──── CHUNK_MARKER_10 ────

// ─── Lint functions ──────────────────────────────────────────────────────

pub fn TypeChecker_lint_unused_functions(self: &mut TypeChecker, program: Program) {
    var called: Vec<str> = Vec::new();
    called.push("main");
    // Collect all called functions
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        TypeChecker_collect_called_funcs(self, program.funcs.get(fi).body, &mut called);
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            TypeChecker_collect_called_funcs(self, imp.methods.get(mi).body, &mut called);
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    // Report unused functions (skip main, pub, __ prefixed)
    var fi2: i64 = 0;
    while fi2 < program.funcs.len() {
        var func: Func = program.funcs.get(fi2);
        if !str_vec_contains(called, func.name) && !func.is_pub && !str_starts_with(func.name, "__") && func.name != "main" {
            self.warnings.push("Warning: function '" + func.name + "' is defined but never called");
        }
        fi2 = fi2 + 1;
    }
}

pub fn TypeChecker_collect_called_funcs(self: &TypeChecker, stmts: Vec<Stmt>, called: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        TypeChecker_collect_called_funcs_stmt(self, stmts.get(i), called);
        i = i + 1;
    }
}

pub fn TypeChecker_collect_called_funcs_stmt(self: &TypeChecker, stmt: Stmt, called: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _) => { TypeChecker_collect_called_funcs_expr(self, expr, called); }
        Stmt::LetTuple(_, expr, _) => { TypeChecker_collect_called_funcs_expr(self, expr, called); }
        Stmt::Expr(expr, _) => { TypeChecker_collect_called_funcs_expr(self, expr, called); }
        Stmt::Assign(_, _, expr, _) => { TypeChecker_collect_called_funcs_expr(self, expr, called); }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, index, called);
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, ptr_expr, called);
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, object, called);
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::Return(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            TypeChecker_collect_called_funcs_expr(self, cond, called);
            TypeChecker_collect_called_funcs(self, then_block, called);
            match else_block {
                OptStmts::Some(eb) => { TypeChecker_collect_called_funcs(self, eb, called); }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, _) => {
            TypeChecker_collect_called_funcs_expr(self, cond, called);
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::For(_, iterator, body, _) => {
            TypeChecker_collect_called_funcs_expr(self, iterator, called);
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::Loop(body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Defer(body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Match(expr, arms, _) => {
            TypeChecker_collect_called_funcs_expr(self, expr, called);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_collect_called_funcs(self, arms.get(ai).body, called);
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Sandbox(body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Unsafe(body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Txn(body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::GradBlock(_, body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Backward(loss, _) => { TypeChecker_collect_called_funcs_expr(self, loss, called); }
        Stmt::Query(_, body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                TypeChecker_collect_called_funcs_expr(self, cases.get(ci).channel, called);
                TypeChecker_collect_called_funcs(self, cases.get(ci).body, called);
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(db) => { TypeChecker_collect_called_funcs(self, db, called); }
                OptStmts::None => {}
            }
        }
        Stmt::Handle(body, handlers, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
            var hi: i64 = 0;
            while hi < handlers.len() {
                TypeChecker_collect_called_funcs(self, handlers.get(hi).body, called);
                hi = hi + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(ai), called);
                ai = ai + 1;
            }
        }
        _ => {}
    }
}

pub fn TypeChecker_collect_called_funcs_expr(self: &TypeChecker, expr: Expr, called: &mut Vec<str>) {
    match expr {
        Expr::IntLit(_) => {}
        Expr::FloatLit(_) => {}
        Expr::StringLit(_) => {}
        Expr::BoolLit(_) => {}
        Expr::Ident(_) => {}
        Expr::Binary(_, left, right) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(left), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(right), called);
        }
        Expr::Unary(_, e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Call(callee, args) => {
            if !str_vec_contains_ref(called, callee) { called.push(callee); }
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(i), called);
                i = i + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(receiver), called);
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(i), called);
                i = i + 1;
            }
        }
        Expr::FieldAccess(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::OptionalFieldAccess(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                TypeChecker_collect_called_funcs_expr(self, fields.get(fi).value, called);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(s), called); }
                OptBoxExpr::None => {}
            }
        }
        Expr::If(cond, then_block, else_block) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(cond), called);
            TypeChecker_collect_called_funcs(self, then_block, called);
            match else_block {
                OptStmts::Some(eb) => { TypeChecker_collect_called_funcs(self, eb, called); }
                OptStmts::None => {}
            }
        }
        Expr::Range(start, end, _) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(start), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(end), called);
        }
        Expr::Block(stmts) => { TypeChecker_collect_called_funcs(self, stmts, called); }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_collect_called_funcs_expr(self, elements.get(i), called);
                i = i + 1;
            }
        }
        Expr::Index(array, index) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(array), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(index), called);
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(e) => { TypeChecker_collect_called_funcs_expr(self, e, called); }
                    FStringPart::Literal(_) => {}
                }
                i = i + 1;
            }
        }
        Expr::Match(expr, arms) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(expr), called);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_collect_called_funcs(self, arms.get(ai).body, called);
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(i), called);
                i = i + 1;
            }
        }
        Expr::Ref(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Deref(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::StrConcat(l, r) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(l), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(r), called);
        }
        Expr::Try(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Coalesce(e, d) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(d), called);
        }
        Expr::TryBlock(body) => { TypeChecker_collect_called_funcs(self, body, called); }
        Expr::IsCheck(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::TupleLit(elems) => {
            var i: i64 = 0;
            while i < elems.len() {
                TypeChecker_collect_called_funcs_expr(self, elems.get(i), called);
                i = i + 1;
            }
        }
        Expr::Closure(_, body, _) => { TypeChecker_collect_called_funcs(self, body, called); }
        Expr::Cast(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Asm(_, operands) => {
            var i: i64 = 0;
            while i < operands.len() {
                TypeChecker_collect_called_funcs_expr(self, operands.get(i).expr, called);
                i = i + 1;
            }
        }
        Expr::Comptime(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::ComptimeBlock(stmts) => { TypeChecker_collect_called_funcs(self, stmts, called); }
        Expr::ComptimeReflect(_, _) => {}
        Expr::PipeForward(left, right) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(left), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(right), called);
        }
        Expr::QuantCast(e, _) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Await(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
        Expr::Spawn(e) => { TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called); }
    }
}

pub fn TypeChecker_lint_unused_imports(self: &mut TypeChecker, program: Program) {
    // Simplified: just check for imports with no items used
    // Full implementation would track which imported names are referenced
    var i: i64 = 0;
    while i < program.imports.len() {
        var imp: ImportDef = program.imports.get(i);
        if !imp.is_glob && imp.items.len() == 0 {
            self.warnings.push("Warning: empty import from '" + imp.path + "'");
        }
        i = i + 1;
    }
}

// ──── CHUNK_MARKER_11 ────

// ─── stmt_line ───────────────────────────────────────────────────────────

pub fn stmt_line(stmt: Stmt) -> i64 {
    match stmt {
        Stmt::Let(_, _, _, _, _, line) => { return line; }
        Stmt::LetTuple(_, _, line) => { return line; }
        Stmt::LetUninit(_, _, line) => { return line; }
        Stmt::Assign(_, _, _, line) => { return line; }
        Stmt::IndexAssign(_, _, _, _, line) => { return line; }
        Stmt::DerefAssign(_, _, _, line) => { return line; }
        Stmt::FieldAssign(_, _, _, _, line) => { return line; }
        Stmt::Expr(_, line) => { return line; }
        Stmt::Return(_, line) => { return line; }
        Stmt::If(_, _, _, line) => { return line; }
        Stmt::While(_, _, line) => { return line; }
        Stmt::For(_, _, _, line) => { return line; }
        Stmt::Loop(_, line) => { return line; }
        Stmt::Break(_, line) => { return line; }
        Stmt::Continue(line) => { return line; }
        Stmt::Defer(_, line) => { return line; }
        Stmt::Match(_, _, line) => { return line; }
        Stmt::Use(_, _, line) => { return line; }
        Stmt::Handle(_, _, line) => { return line; }
        Stmt::Do(_, _, _, line) => { return line; }
        Stmt::RegionBlock(_, _, _, _, _, _, line) => { return line; }
        Stmt::Sandbox(_, line) => { return line; }
        Stmt::Unsafe(_, line) => { return line; }
        Stmt::Txn(_, line) => { return line; }
        Stmt::ComptimeGen(_, line) => { return line; }
        Stmt::GradBlock(_, _, line) => { return line; }
        Stmt::Backward(_, line) => { return line; }
        Stmt::Query(_, _, line) => { return line; }
        Stmt::Select(_, _, line) => { return line; }
    }
    return 0;
}

// ─── scan_for_floats ─────────────────────────────────────────────────────

pub fn scan_for_floats(stmts: Vec<Stmt>) -> Vec<str> {
    var found: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_floats(stmts.get(i), &mut found);
        i = i + 1;
    }
    return found;
}

pub fn scan_stmt_for_floats(stmt: Stmt, found: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _) => { scan_expr_for_floats(expr, found); }
        Stmt::LetTuple(_, expr, _) => { scan_expr_for_floats(expr, found); }
        Stmt::Expr(expr, _) => { scan_expr_for_floats(expr, found); }
        Stmt::Assign(_, _, expr, _) => { scan_expr_for_floats(expr, found); }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            scan_expr_for_floats(index, found);
            scan_expr_for_floats(expr, found);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            scan_expr_for_floats(ptr_expr, found);
            scan_expr_for_floats(expr, found);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            scan_expr_for_floats(object, found);
            scan_expr_for_floats(expr, found);
        }
        Stmt::Return(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            scan_expr_for_floats(cond, found);
            var i: i64 = 0;
            while i < then_block.len() {
                scan_stmt_for_floats(then_block.get(i), found);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        scan_stmt_for_floats(eb.get(j), found);
                        j = j + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, _) => {
            scan_expr_for_floats(cond, found);
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::For(_, iterator, body, _) => {
            scan_expr_for_floats(iterator, found);
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Loop(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Defer(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Match(expr, arms, _) => {
            scan_expr_for_floats(expr, found);
            var ai: i64 = 0;
            while ai < arms.len() {
                var i: i64 = 0;
                while i < arms.get(ai).body.len() {
                    scan_stmt_for_floats(arms.get(ai).body.get(i), found);
                    i = i + 1;
                }
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Sandbox(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Unsafe(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Txn(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::GradBlock(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Backward(loss, _) => { scan_expr_for_floats(loss, found); }
        Stmt::Query(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                scan_expr_for_floats(cases.get(ci).channel, found);
                var i: i64 = 0;
                while i < cases.get(ci).body.len() {
                    scan_stmt_for_floats(cases.get(ci).body.get(i), found);
                    i = i + 1;
                }
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(db) => {
                    var i: i64 = 0;
                    while i < db.len() {
                        scan_stmt_for_floats(db.get(i), found);
                        i = i + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Stmt::Handle(body, _, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        _ => {}
    }
}

pub fn scan_expr_for_floats(expr: Expr, found: &mut Vec<str>) {
    match expr {
        Expr::FloatLit(_) => { found.push("float_literal"); }
        Expr::IntLit(_) => {}
        Expr::StringLit(_) => {}
        Expr::BoolLit(_) => {}
        Expr::Ident(_) => {}
        Expr::Binary(_, left, right) => {
            scan_expr_for_floats(box_expr_unbox(left), found);
            scan_expr_for_floats(box_expr_unbox(right), found);
        }
        Expr::Unary(_, e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Call(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            scan_expr_for_floats(box_expr_unbox(receiver), found);
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        Expr::FieldAccess(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::OptionalFieldAccess(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                scan_expr_for_floats(fields.get(fi).value, found);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => { scan_expr_for_floats(box_expr_unbox(s), found); }
                OptBoxExpr::None => {}
            }
        }
        Expr::If(cond, then_block, else_block) => {
            scan_expr_for_floats(box_expr_unbox(cond), found);
            var i: i64 = 0;
            while i < then_block.len() {
                scan_stmt_for_floats(then_block.get(i), found);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        scan_stmt_for_floats(eb.get(j), found);
                        j = j + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Expr::Range(start, end, _) => {
            scan_expr_for_floats(box_expr_unbox(start), found);
            scan_expr_for_floats(box_expr_unbox(end), found);
        }
        Expr::Block(stmts) => {
            var i: i64 = 0;
            while i < stmts.len() {
                scan_stmt_for_floats(stmts.get(i), found);
                i = i + 1;
            }
        }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                scan_expr_for_floats(elements.get(i), found);
                i = i + 1;
            }
        }
        Expr::Index(array, index) => {
            scan_expr_for_floats(box_expr_unbox(array), found);
            scan_expr_for_floats(box_expr_unbox(index), found);
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(e) => { scan_expr_for_floats(e, found); }
                    FStringPart::Literal(_) => {}
                }
                i = i + 1;
            }
        }
        Expr::Match(expr, arms) => {
            scan_expr_for_floats(box_expr_unbox(expr), found);
            var ai: i64 = 0;
            while ai < arms.len() {
                var i: i64 = 0;
                while i < arms.get(ai).body.len() {
                    scan_stmt_for_floats(arms.get(ai).body.get(i), found);
                    i = i + 1;
                }
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        Expr::Ref(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Deref(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::StrConcat(l, r) => {
            scan_expr_for_floats(box_expr_unbox(l), found);
            scan_expr_for_floats(box_expr_unbox(r), found);
        }
        Expr::Try(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Coalesce(e, d) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
            scan_expr_for_floats(box_expr_unbox(d), found);
        }
        Expr::TryBlock(body) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Expr::IsCheck(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::TupleLit(elems) => {
            var i: i64 = 0;
            while i < elems.len() {
                scan_expr_for_floats(elems.get(i), found);
                i = i + 1;
            }
        }
        Expr::Closure(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Expr::Cast(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Asm(_, operands) => {
            var i: i64 = 0;
            while i < operands.len() {
                scan_expr_for_floats(operands.get(i).expr, found);
                i = i + 1;
            }
        }
        Expr::Comptime(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::ComptimeBlock(stmts) => {
            var i: i64 = 0;
            while i < stmts.len() {
                scan_stmt_for_floats(stmts.get(i), found);
                i = i + 1;
            }
        }
        Expr::ComptimeReflect(_, _) => {}
        Expr::PipeForward(left, right) => {
            scan_expr_for_floats(box_expr_unbox(left), found);
            scan_expr_for_floats(box_expr_unbox(right), found);
        }
        Expr::QuantCast(e, _) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Await(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
        Expr::Spawn(e) => { scan_expr_for_floats(box_expr_unbox(e), found); }
    }
}

// ──── END ────
