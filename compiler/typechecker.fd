                if method == "pop" {
                    return elem_ty;
                }
                if method == "len" {
                    return Type::I64;
                }
                if method == "is_empty" {
                    return Type::Bool;
                }
                if method == "get" {
                    return elem_ty;
                }
                if method == "set" {
                    return Type::Void;
                }
                if method == "clear" {
                    return Type::Void;
                }
                if method == "capacity" {
                    return Type::I64;
                }
                if method == "insert" {
                    return Type::Void;
                }
                if method == "remove" {
                    return elem_ty;
                }
                if method == "contains" {
                    return Type::Bool;
                }
                if method == "reverse" {
                    return Type::Void;
                }
                if method == "first" {
                    return elem_ty;
                }
                if method == "last" {
                    return elem_ty;
                }
                if method == "extend" {
                    return Type::Void;
                }
                if method == "truncate" {
                    return Type::Void;
                }
                if method == "sort" {
