            // roadmap L6C: loading a shared library reads a file (and runs
            // its initialisers): it needs the FS capability, and inside
            // sandbox it is rejected with every other capability
            if callee == "p_dl_open" || callee == "p_dl_load" {
                TypeChecker_check_capability(self, "FS", callee + "()");
            }
            // roadmap L4F: the cryptography modules (and the OS random
            // source) need the Crypto capability
            TypeChecker_check_crypto_call(self, callee);
            // L4E: a literal regex pattern is parsed now, not at run time
            TypeChecker_check_regex_literal(self, callee, args);
            // CD8: comptime code may not do I/O
            if g_tc_comptime_depth > 0 {
                TypeChecker_check_comptime_call(self, callee);
            }
            // CA10: remember what is started as a green task
            var te_at: i64 = tc_task_entry_arg(callee);
            if te_at >= 0 && args.len() > te_at {
                match args.get(te_at) {
                    Expr::StringLit(te_name) => {
                        g_tc_task_entries.push(te_name);
                    }
                    _ => {
                    }
                }
            }
            if callee == "http_get" || callee == "http_post" || callee == "socket_connect" || callee == "socket_send" || callee == "socket_recv" {
                TypeChecker_check_capability(self, "Net", callee + "()");
            }
            if callee == "spawn" || callee == "exec" || callee == "system" || callee == "p_thread_spawn" {
                TypeChecker_check_capability(self, "Spawn", callee + "()");
            }
            if tc_alloc_cap_builtin(callee) {
                TypeChecker_check_capability(self, "Alloc", callee + "()");
            }
            // Inside sandbox, what the callee does counts too: an IO builtin
            // (p_file_read, ...) or a function whose inferred effects
            // include IO/Net/Spawn
            if self.sandbox_depth > 0 && self.errors.len() == sb_errs0 {
                TypeChecker_check_sandbox_call(self, callee, args);
            }
            // Runtime sandbox: lowering puts p_sandbox_enter/p_sandbox_exit
            // around `sandbox { }` (lower.fd Lowerer_lower_sandbox). A program
            // may not call them itself: a function reached from inside a
            // sandbox through a function value could otherwise lift the
            // sandbox it runs in. p_cap_revoke stays callable (it only takes
            // capabilities away).
            if callee == "p_sandbox_enter" || callee == "p_sandbox_exit" {
                if self.sandbox_depth > 0 {
                    self.errors.push("Capability error (line " + int_to_str(self.current_line) + "): " + callee + "() cannot be called inside sandbox: the sandbox's revocation is managed by the compiler");
                } else {
                    self.errors.push("Capability error (line " + int_to_str(self.current_line) + "): " + callee + "() cannot be called directly: `sandbox { }` enters and leaves the run-time sandbox (the compiler emits these calls); use p_cap_revoke to give up a capability");
                }
            }
            if self.region_budgets.len() > 0 {
                TypeChecker_budget_call(self, callee, args);
            }
            // GPU kernel builtins
            if callee == "thread_id" || callee == "workgroup_size" || callee == "workgroup_id" || callee == "num_workgroups" {
                return Type::I64;
            }
            if callee == "print" {
                var i: i64 = 0;
                while i < args.len() {
                    TypeChecker_check_expr(self, args.get(i));
                    i = i + 1;
                }
                return Type::Void;
            }
            // Check all arguments. A named argument (`port: 80`) counts as
            // Never by position; its own type is kept in named_tys for
            // TypeChecker_check_named_args (CL4).
            var arg_types: Vec<Type> = Vec::new();
            var named_tys: Vec<Type> = Vec::new();
            var has_named: bool = false;
            var i: i64 = 0;
            while i < args.len() {
                match args.get(i) {
                    Expr::NamedArg(_, nae) => {
                        has_named = true;
                        named_tys.push(TypeChecker_check_expr(self, box_expr_unbox(nae)));
                        arg_types.push(Type::Never);
                    }
                    other_arg => {
                        // BG128: an enum literal argument takes the parameter's type
                        arg_types.push(TypeChecker_check_expr_with_hint(self, other_arg, TypeChecker_enum_arg_hint(self, callee, other_arg, i)));
                        named_tys.push(Type::Never);
                    }
                }
                i = i + 1;
            }
