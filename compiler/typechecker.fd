pub enum OptTraitMethodInfo {
    Some(TraitMethodInfo),
    None,
}

// --- Type aliases for nested Vec types (Fides can't parse Vec<Vec<...>>) -

pub type ScopeStack = Vec<ScopeEntry>;
pub type LinearVarStack = Vec<LinearVar>;
pub type StrStack = Vec<str>;
pub type StmtList = Vec<Stmt>;
pub type AnnList = Vec<Annotation>;

// --- TypeChecker struct --------------------------------------------------

pub struct TypeChecker {
    // Symbol tables
    scopes: Vec<ScopeStack>,                         // var_name -> Type (per scope)
    funcs: Vec<StringFuncSig>,                       // func_name -> (params, box_type_unbox(ret)) -- stored as FuncSig in a wrapper
    structs: Vec<StringStructFields>,                // struct_name -> fields
    enums: Vec<str>,                                 // enum names
    enum_variants: Vec<StringEnumVariants>,          // enum_name -> variants
    enum_type_params: Vec<StringVecString>,          // enum_name -> type params
    consts: Vec<StringType>,                         // const_name -> Type
    globals: Vec<StringType>,                         // global_name -> Type (module-level mutable globals)
    type_aliases: Vec<StringType>,                   // alias_name -> Type
    methods: Vec<StringMethodMap>,                   // struct_name -> method map
    current_type_params: Vec<str>,                   // current function's type params
    current_type_param_bounds: Vec<StringString>,    // type_param -> trait_name
    traits: Vec<StringTraitMethodMap>,               // trait_name -> methods
    trait_assoc_types: Vec<StringVecString>,         // trait_name -> assoc type names
    trait_impl_assoc_bindings: Vec<TraitImplAssocEntry>, // (trait,type) -> bindings
    item_modules: Vec<StringString>,                 // item_name -> module_name
    item_visibility: Vec<StringBool>,                // item_name -> is_pub
    field_visibility: Vec<FieldVisEntry>,            // (struct,field) -> is_pub
    struct_modules: Vec<StringString>,               // struct_name -> module_name

    // State
    pub current_module: str,
    pub errors: Vec<str>,
    pub warnings: Vec<str>,
    granted_caps: Vec<str>,
    strict_caps: bool,
    func_effects: Vec<StringVecStrTc>,                 // func_name -> effect names
    ho_param_effects: Vec<StringVecStrTc>,              // param_name -> conservative effects (effect polymorphism)
    region_stack: Vec<str>,
    var_regions: Vec<StringString>,                  // var_name -> region_name
    freed_regions: Vec<str>,
    cap_verified: Vec<str>,
    current_func_name: OptString,
    current_return_types: Vec<Type>,
    current_self_type: OptString,
    sandbox_depth: i64,
    gpu_region_depth: i64,
    region_budgets: Vec<RegionBudget>,
    region_lines: Vec<StringI64>,
    var_alloc_lines: Vec<StringI64>,
    linear_structs: Vec<str>,
    send_structs: Vec<str>,
    sync_structs: Vec<str>,
    consumed_vars: Vec<str>,
    scope_linear_vars: Vec<LinearVarStack>,
    loop_depth: i64,
    unsafe_depth: i64,
    uninit_vars: Vec<str>,
    current_line: i64,
    val_vars_per_scope: Vec<StrStack>,
    check_depth: i64,
}

