                    self.errors.push("Comptime error (line " + int_to_str(self.current_line) + "): gensym() names what compile-time code generates: call it in a `comptime fn`, a `comptime { }` block, or a `comptime gen` / `comptime splice` block.");
                    return Type::Never;
