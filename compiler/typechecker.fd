                    self.errors.push("Comptime error (line " + int_to_str(self.current_line) + "): " + callee + "() reads the program's declarations while compiling: call it in comptime code.
    Fix: wrap the call in a `comptime { }` block, a `comptime fn` or a `comptime` declaration.");
                    return Type::Never;
