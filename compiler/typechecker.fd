                        // out) and types, `self` included when it is passed
                        var assoc_names: Vec<str> = Vec::new();
                        var assoc_types: Vec<Type> = Vec::new();
                        TypeChecker_check_method_args(self, "associated function '" + name + "::" + method + "'", name + "_" + method, info, 0, args, arg_types, assoc_names, assoc_types, true);
                        return info.ret_ty;
                    }
