                    var bg18_types: Vec<Type> = Vec::new();
                    val bg18_typed: bool = btps.len() == 0 && bg18_info.type_params.len() == 0;
                    TypeChecker_check_method_args(self, "method '" + struct_name + "." + method + "'", struct_name + "_" + method, bg18_info, 1, args, arg_types, bg18_names, bg18_types, bg18_typed);
                }
                if btps.len() > 0 && !tc_str_vec_contains(self.current_type_params, struct_name) {
                    var bnames: Vec<str> = Vec::new();
                    var btypes: Vec<Type> = Vec::new();
                    var bk: i64 = 0;
                    while bk < btps.len() {
                        bnames.push(btps.get(bk));
                        btypes.push(Type::I64);
                        bk = bk + 1;
                    }
                    return tc_subst_type_params(method_map.get(mei).val.ret_ty, bnames, btypes);
                }
                // LG4: a generic method (`fn m<U>(self, ..)`), bound at the call
                var lg4_info: MethodInfo = method_map.get(mei).val;
                if lg4_info.type_params.len() > 0 && lg4_info.has_self {
                    return TypeChecker_lg4_method_call(self, struct_name, method, lg4_info.type_params, lg4_info.type_param_bounds, tc_lg4_args_of(lg4_info.param_types, true), lg4_info.ret_ty, arg_types, hint);
                }
                return method_map.get(mei).val.ret_ty;
            }
            // Check if this is a type param with a trait bound
            if tc_str_vec_contains(self.current_type_params, struct_name) {
                // Any of the parameter's bounds (`T: A + B`) may give the method
                var bi: i64 = 0;
                while bi < self.current_type_param_bounds.len() {
                    if self.current_type_param_bounds.get(bi).key == struct_name {
                        match map_traits_get(self.traits, self.current_type_param_bounds.get(bi).val) {
                            OptTraitMethodMap::Some(trait_methods) => {
                                match trait_method_map_get(trait_methods, method) {
                                    OptTraitMethodInfo::Some(info) => {
                                        // LG4: a generic trait method, bound at the call
                                        if info.type_params.len() > 0 {
                                            return TypeChecker_lg4_method_call(self, struct_name, method, info.type_params, info.type_param_bounds, tc_lg4_args_of(info.param_types, info.has_self), info.ret_ty, arg_types, hint);
                                        }
                                        return info.ret_ty;
                                    }
                                    OptTraitMethodInfo::None => {
                                    }
                                }
                            }
                            OptTraitMethodMap::None => {
                            }
                        }
                    }
                    bi = bi + 1;
                }
            }
            self.errors.push("Type error: no method '" + method + "' on struct '" + struct_name + "'");
        }
        Type::Generic(gen_name, recv_args) => {
            // Generic type: look up methods by base name
            var mi: i64 = TypeChecker_methods_at(self, gen_name);
            var mei: i64 = -1;
            if mi < self.methods.len() {
                mei = TypeChecker_method_find(self, gen_name, method);
            }
            if mei >= 0 {
                var method_map: Vec<MethodMapEntry> = self.methods.get(mi).val;
                TypeChecker_warn_deprecated_method(self, gen_name, method);
                // `impl<T> Slot` on a Slot<f64>: the method's type with T=f64
                var gtps: Vec<str> = TypeChecker_impl_type_params(self, gen_name);
                // L8H: a method of a narrower impl (`impl Wrap<i64>`,
                // `impl<U> Wrap<Vec<U>>`): the receiver must have its type,
                // and its parameters come from the receiver's
                var nret: Vec<Type> = Vec::new();
                // BG18: the arguments after the receiver, with the impl's
                // type parameters taken from the receiver's type arguments
                var bg18g_info: MethodInfo = method_map.get(mei).val;
                var bg18g_names: Vec<str> = Vec::new();
                var bg18g_types: Vec<Type> = Vec::new();
                var bg18g_k: i64 = 0;
                while bg18g_k < gtps.len() && bg18g_k < recv_args.len() {
                    bg18g_names.push(gtps.get(bg18g_k));
                    bg18g_types.push(recv_args.get(bg18g_k));
                    bg18g_k = bg18g_k + 1;
                }
                if TypeChecker_narrow_method_call(self, gen_name, method, method_map.get(mei).val, gtps, recv_args, &mut nret) {
                    // (a narrower impl's method: its number of arguments)
                    if bg18g_info.has_self {
                        TypeChecker_check_method_args(self, "method '" + gen_name + "." + method + "'", gen_name + "_" + method, bg18g_info, 1, args, arg_types, bg18g_names, bg18g_types, false);
                    }
                    if nret.len() == 0 {
                        return Type::Never;
                    }
                    if TypeChecker_type_contains_param(self, nret.get(0)) {
                        return Type::Never;
                    }
                    return nret.get(0);
                }
                if bg18g_info.has_self {
                    val bg18g_typed: bool = bg18g_info.type_params.len() == 0;
                    TypeChecker_check_method_args(self, "method '" + gen_name + "." + method + "'", gen_name + "_" + method, bg18g_info, 1, args, arg_types, bg18g_names, bg18g_types, bg18g_typed);
                }
                if gtps.len() > 0 {
                    var gnames: Vec<str> = Vec::new();
                    var gtypes: Vec<Type> = Vec::new();
                    var gk: i64 = 0;
                    while gk < gtps.len() && gk < recv_args.len() {
                        gnames.push(gtps.get(gk));
                        gtypes.push(recv_args.get(gk));
                        gk = gk + 1;
                    }
                    var gret: Type = tc_subst_type_params(method_map.get(mei).val.ret_ty, gnames, gtypes);
                    // LG4: a generic method of a generic impl: the impl's
                    // parameters from the receiver, the method's at the call
                    var glg4: MethodInfo = method_map.get(mei).val;
                    if glg4.type_params.len() > 0 && glg4.has_self {
                        var glg4_ps: Vec<Type> = Vec::new();
                        var glg4_all: Vec<Type> = tc_lg4_args_of(glg4.param_types, true);
                        var glk: i64 = 0;
                        while glk < glg4_all.len() {
                            glg4_ps.push(tc_subst_type_params(glg4_all.get(glk), gnames, gtypes));
                            glk = glk + 1;
                        }
                        return TypeChecker_lg4_method_call(self, gen_name, method, glg4.type_params, glg4.type_param_bounds, glg4_ps, gret, arg_types, hint);
                    }
                    // L8H: which impl's method this receiver's instantiation runs
                    if g_tc_mspecs.len() > 0 {
                        TypeChecker_check_mspec_call(self, gen_name, method, gtps, recv_args, method_map.get(mei).val.ret_ty, gret);
                    }
                    if TypeChecker_type_contains_param(self, gret) {
                        return Type::Never;
                    }
                    return gret;
                }
                // LG4: (an impl whose parameters are not recorded: a
                // generic trait impl only) the method's own, at the call
                var glg4b: MethodInfo = method_map.get(mei).val;
                if glg4b.type_params.len() > 0 && glg4b.has_self {
                    return TypeChecker_lg4_method_call(self, gen_name, method, glg4b.type_params, glg4b.type_param_bounds, tc_lg4_args_of(glg4b.param_types, true), glg4b.ret_ty, arg_types, hint);
                }
                return method_map.get(mei).val.ret_ty;
            }
            self.errors.push("Type error: no method '" + method + "' on generic type '" + gen_name + "'");
        }
        _ => {
            if !TypeChecker_is_reported(self, recv_ty) {
                self.errors.push("Type error: cannot call method '" + method + "' on type " + type_to_str(recv_ty));
            }
        }
    }
    return Type::Never;
}

// A bare name in a match arm that is a unit variant of the scrutinee's enum
// (`None =>` on an `Option`) is that variant, as `Some(x)` is (reference
// §6; the exhaustiveness check reads it so, known-bugs 2g.7). Before, the
// binding declared it a variable that matched every value: with `None =>`
// written first, the arms after it could never run, and nothing said so.
// Any other bare name binds the value. What is not an enum of the program
// (a type parameter, an unknown type) decides nothing here.
pub fn TypeChecker_bare_pattern_is_unit_variant(self: &TypeChecker, match_ty: Type, name: str) -> bool {
    var ename: str = "";
    match match_ty {
        Type::Named(n) => {
            ename = n;
        }
        Type::Generic(n, _) => {
            ename = n;
        }
        _ => {
            return false;
        }
    }
    ename = TypeChecker_resolve_struct_name(self, ename);
    if str_len(ename) == 0 {
        return false;
    }
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        if self.enum_variants.get(ei).key == ename {
            var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
            var vi: i64 = 0;
            while vi < variants.len() {
                if variants.get(vi).name == name {
                    return variants.get(vi).payload_types.len() == 0;
                }
                vi = vi + 1;
            }
            return false;
        }
        ei = ei + 1;
    }
    return false;
}

// --- resolve_pattern_enum -------------------------------------------------

pub fn TypeChecker_resolve_pattern_enum(self: &TypeChecker, match_ty: Type, enum_name: str, variant: str) -> OptString {
    // If enum_name is non-empty, try resolving it directly
    if enum_name != "" {
        var resolved: str = TypeChecker_resolve_struct_name(self, enum_name);
        // Check if resolved name is a known enum
        var ei: i64 = 0;
        while ei < self.enum_variants.len() {
            if self.enum_variants.get(ei).key == resolved {
                return OptString::Some(resolved);
            }
            ei = ei + 1;
        }
        // Check original name
        ei = 0;
        while ei < self.enum_variants.len() {
            if self.enum_variants.get(ei).key == enum_name {
                return OptString::Some(enum_name);
            }
            ei = ei + 1;
        }
    }
    // Try to infer from the scrutinee type
    var from_scrutinee: OptString = OptString::None;
    match match_ty {
        Type::Named(n) => {
            from_scrutinee = OptString::Some(n);
        }
        Type::Generic(n, _) => {
            from_scrutinee = OptString::Some(n);
        }
        _ => {
        }
    }
    match from_scrutinee {
        OptString::Some(n) => {
            var resolved: str = TypeChecker_resolve_struct_name(self, n);
            var ei: i64 = 0;
            while ei < self.enum_variants.len() {
                if self.enum_variants.get(ei).key == resolved {
                    return OptString::Some(resolved);
                }
                ei = ei + 1;
            }
        }
        OptString::None => {
        }
    }
    // Last resort: a variant name unique across all enums
    var found: OptString = OptString::None;
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
        var vi: i64 = 0;
        while vi < variants.len() {
            if variants.get(vi).name == variant {
                match found {
                    OptString::Some(_) => {
                        // Ambiguous -- more than one enum has this variant
                        return OptString::None;
                    }
                    OptString::None => {
                        found = OptString::Some(self.enum_variants.get(ei).key);
                    }
                }
                vi = variants.len();
            }
            vi = vi + 1;
        }
        ei = ei + 1;
    }
    return found;
}

// --- soundness helpers (mirror src/typechecker.rs) -------------------------

// A type written by name in a pattern binding (`Some(v: i64)`): primitive names
// map to primitive types (as in Rust's type_from_name), others stay Named.
pub fn type_from_annotation(name: str) -> Type {
    if name == "i8" {
        return Type::I8;
    }
    if name == "i16" {
        return Type::I16;
    }
    if name == "i32" {
        return Type::I32;
    }
    if name == "i64" {
        return Type::I64;
    }
    if name == "i128" {
        return Type::I128;
    }
    if name == "u8" {
        return Type::U8;
    }
    if name == "u16" {
        return Type::U16;
    }
    if name == "u32" {
        return Type::U32;
    }
    if name == "u64" {
        return Type::U64;
    }
    if name == "u128" {
        return Type::U128;
    }
    if name == "f32" {
        return Type::F32;
    }
    if name == "f64" {
        return Type::F64;
    }
    if name == "bool" {
        return Type::Bool;
    }
    if name == "str" {
        return Type::Str;
    }
    if name == "void" {
        return Type::Void;
    }
    return Type::Named(name);
}

// The stdlib modules that implement the runtime handles themselves (Vec/HashMap
// are raw pointers manipulated as i64 there).
pub fn is_runtime_layer(module: str) -> bool {
    return module == "core" || module == "vec";
}

fn is_handle_type(t: Type) -> bool {
    match t {
        Type::Named(n) => {
            return n == "Vec" || n == "HashMap" || n == "Allocator" || n == "Tensor";
        }
        Type::Generic(n, _) => {
            return n == "Vec" || n == "HashMap" || n == "Allocator" || n == "Tensor";
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn is_i64_type(t: Type) -> bool {
    match t {
        Type::I64 => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

// An opaque runtime handle paired with i64 -- interchangeable only inside the
// runtime layer (TODO R1.4: a layout-aware Vec removes the need for this).
pub fn is_handle_int_pair(a: Type, b: Type) -> bool {
    return (is_handle_type(a) && is_i64_type(b)) || (is_handle_type(b) && is_i64_type(a));
}

// `T` written as a single uppercase letter is a generic parameter.
// BG153: `t` is a one-letter type parameter that `names` does not bind.
fn tc_bare_param_unbound(t: Type, names: Vec<str>) -> bool {
    if !is_single_upper_name(t) {
        return false;
    }
    match t {
        Type::Named(n) => {
            return !tc_str_vec_contains(names, n);
        }
        _ => {
        }
    }
    return true;
}

fn is_single_upper_name(t: Type) -> bool {
    match t {
        Type::Named(n) => {
            if str_len(n) == 1 {
                var c: i64 = str_byte_at(n, 0);
                return c >= 'A' && c <= 'Z';
            }
            return false;
        }
        _ => {
            return false;
        }
    }
    return false;
}

pub fn TypeChecker_is_runtime_call(self: &TypeChecker, callee: str) -> bool {
    if is_runtime_layer(self.current_module) {
        return true;
    }
    if str_vec_contains(self.extern_fns, callee) {
        return true;
    }
    match TypeChecker_get_item_module(self, callee) {
        OptString::Some(m) => {
            return is_runtime_layer(m);
        }
        OptString::None => {
        }
    }
    return false;
}

fn strip_box(t: Type) -> Type {
    match t {
        Type::Generic(n, args) => {
            if n == "Box" && args.len() == 1 {
                return args.get(0);
            }
            return t;
        }
        _ => {
            return t;
        }
    }
    return t;
}

// Argument passing: types_compatible plus the call-site coercions Fides
// performs -- a `&mut T` reborrows as `&T`, a value `T` is auto-borrowed for a
// `&T` / `&mut T` parameter, and aggregates share a representation with their
// Box. Passing `&T` where `&mut T` is required stays an error.
pub fn TypeChecker_arg_compatible(self: &TypeChecker, param: Type, arg: Type) -> bool {
    if TypeChecker_types_compatible(self, param, arg) {
        return true;
    }
    var p: Type = TypeChecker_resolve_type(self, param);
    var a: Type = TypeChecker_resolve_type(self, arg);
    if tc_const_args_differ(p, tc_read_through(a)) {
        return false;
    }
    // A Box owns a heap copy made by Box::new; storing a bare value (often a
    // pointer into the caller's stack frame) dangles.
    var a_boxed: bool = is_box_type(a);
    match a {
        Type::Ref(inner, _) => {
            if is_box_type(box_type_unbox(inner)) {
                a_boxed = true;
            }
        }
        _ => {
        }
    }
    if is_box_type(p) && !a_boxed {
        return false;
    }
    // Function types compare structurally.
    match p {
        Type::Func(pp, pr) => {
            match a {
                Type::Func(ap, ar) => {
                    if pp.len() != ap.len() {
                        return false;
                    }
                    var fi: i64 = 0;
                    while fi < pp.len() {
                        if !TypeChecker_fn_param_compatible(self, pp.get(fi), ap.get(fi)) {
                            return false;
                        }
                        fi = fi + 1;
                    }
                    return TypeChecker_arg_compatible(self, box_type_unbox(pr), box_type_unbox(ar)) || (type_eq(box_type_unbox(pr), Type::Void) && type_eq(box_type_unbox(ar), Type::Void));
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    var p_is_ref: bool = false;
    var p_mut: bool = false;
    var p_inner: Type = p;
    match p {
        Type::Ref(inner, m) => {
            p_is_ref = true;
            p_mut = m;
            p_inner = box_type_unbox(inner);
        }
        _ => {
        }
    }
    var a_is_ref: bool = false;
    var a_mut: bool = false;
    var a_inner: Type = a;
    match a {
        Type::Ref(inner, m) => {
            a_is_ref = true;
            a_mut = m;
            a_inner = box_type_unbox(inner);
        }
        _ => {
        }
    }
    if p_is_ref && p_mut && a_is_ref && !a_mut {
        return false;
    }
    var ps: Type = TypeChecker_resolve_type(self, strip_box(p_inner));
    var as2: Type = TypeChecker_resolve_type(self, strip_box(a_inner));
    // Only user structs and enums are represented as a pointer to their data,
    // so only for them is `T` interchangeable with `&T` / `Box<T>`. A Vec,
    // HashMap, str or number value is itself the handle or value, and `&v` is
    // a pointer to the variable holding it (mirrors src/typechecker.rs).
    var stripped_any: bool = (p_is_ref != a_is_ref) || is_box_type(p_inner) || is_box_type(a_inner);
    // A reference where the value is wanted is read through (the lowering
    // loads a Vec/HashMap/str handle from it); not the other way round
    var read_through: bool = a_is_ref && !p_is_ref && !is_box_type(p_inner) && !is_box_type(a_inner);
    if stripped_any && !read_through && !TypeChecker_shares_repr(self, ps) {
        return false;
    }
    return TypeChecker_types_compatible(self, ps, as2);
}

/// BG17: whether a function whose parameter has type `got` may be passed
/// where a function type's parameter is `want`. Parameters go the other way
/// from arguments (contravariance): the function is handed what a caller
/// of the function type passes, a `want`. So a function taking `&T` may
/// stand for a `fn(&mut T)` (a `&mut` reborrows as `&`), but a function
/// taking `&mut T` may not stand for a `fn(&T)` or a `fn(T)`: it would
/// change what its caller only lends it. Before, the parameters were
/// compared as arguments are (TypeChecker_arg_compatible(want, got)), which
/// accepted the second and refused the first. Everything else is compared
/// as before: equal types, type parameters and types not yet known first,
/// then the argument rules.
fn TypeChecker_fn_param_compatible(self: &TypeChecker, want: Type, got: Type) -> bool {
    if TypeChecker_types_compatible(self, want, got) {
        return true;
    }
    var w: Type = TypeChecker_resolve_type(self, want);
    var g: Type = TypeChecker_resolve_type(self, got);
    var w_mut_ref: bool = false;
    var w_ref: bool = false;
    var w_in: Type = w;
    match w {
        Type::Ref(wi, wm) => {
            w_ref = true;
            w_mut_ref = wm;
            w_in = box_type_unbox(wi);
        }
        _ => {
        }
    }
    match g {
        Type::Ref(gi, gm) => {
            if gm && !w_mut_ref {
                return false;
            }
            if w_ref && w_mut_ref && !gm {
                // a `&mut T` handed to a function that reads through `&T`:
                // the referred-to types are compared as for two `&`
                return TypeChecker_arg_compatible(self, Type::Ref(Box::new(w_in), false), Type::Ref(Box::new(box_type_unbox(gi)), false));
            }
        }
        _ => {
        }
    }
    return TypeChecker_arg_compatible(self, want, got);
}

pub fn TypeChecker_shares_repr(self: &TypeChecker, t: Type) -> bool {
    var n: str = "";
    match t {
        Type::Named(nm) => {
            n = nm;
        }
        Type::Generic(nm, _) => {
            n = nm;
        }
        _ => {
            return false;
        }
    }
    if n == "Vec" || n == "HashMap" || n == "String" || n == "Box" {
        return false;
    }
    if str_vec_contains(self.enums, n) {
        return true;
    }
    match TypeChecker_lookup_struct_cache(self, n) {
        OptVecStructField::Some(_) => {
            return true;
        }
        OptVecStructField::None => {
        }
    }
    return false;
}

// `return e` must match the declared return type of the enclosing function or
// closure.
pub fn TypeChecker_check_return_type(self: &mut TypeChecker, actual: Type) {
    var declared: Type = Type::Infer;
    match self.current_ret_ty {
        OptType::Some(t) => {
            declared = TypeChecker_resolve_self_type(self, t);
        }
        OptType::None => {
            return;
        }
    }
    var decl_void: bool = false;
    match declared {
        Type::Void => {
            decl_void = true;
        }
        _ => {
        }
    }
    var act_void: bool = false;
    match actual {
        Type::Void => {
            act_void = true;
        }
        _ => {
        }
    }
    if tc_is_str(declared) && tc_is_borrowed_str(actual) {
        self.errors.push("Borrow error (line " + int_to_str(self.current_line) + "): returns a borrowed string (&str) as an owned str; the string belongs to its owner and may be freed after this returns.\n    Fix: return str_clone(s) (an owned copy), or declare the result &str.");
        return;
    }
    var ok: bool = false;
    var is_main: bool = false;
    match self.current_func_name {
        OptString::Some(n) => {
            is_main = n == "main";
        }
        OptString::None => {
        }
    }
    if decl_void && is_main && TypeChecker_is_numeric(self, actual) {
        ok = true;
        // main may return an integer exit status
    } else if decl_void || act_void {
        ok = decl_void && act_void;
    } else {
        ok = TypeChecker_arg_compatible(self, declared, actual) || (is_runtime_layer(self.current_module) && is_handle_int_pair(declared, actual));
    }
    if !ok {
        var fname: str = "<closure>";
        match self.current_func_name {
            OptString::Some(n) => {
                fname = n;
            }
            OptString::None => {
            }
        }
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): '" + fname + "' returns " + type_to_str(actual) + " but is declared to return " + type_to_str(declared));
    }
}

// `Enum::Variant(args)` must name an existing variant with matching arity.
pub fn TypeChecker_check_enum_constructor(self: &mut TypeChecker, enum_name: str, variant: str, arg_tys: Vec<Type>, args: Vec<Expr>) {
    var n_args: i64 = arg_tys.len();
    var resolved: str = TypeChecker_resolve_struct_name(self, enum_name);
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        var key: str = self.enum_variants.get(ei).key;
        if key == resolved || key == enum_name {
            var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
            var vi: i64 = 0;
            while vi < variants.len() {
                if variants.get(vi).name == variant {
                    var payload: Vec<Type> = variants.get(vi).payload_types;
                    var n: i64 = payload.len();
                    if n != n_args {
                        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + key + "::" + variant + " takes " + int_to_str(n) + " value(s), got " + int_to_str(n_args));
                        return;
                    }
                    var fi: i64 = 0;
                    while fi < n {
                        var expected: Type = payload.get(fi);
                        // Generic payloads are checked after monomorphization.
                        if !TypeChecker_type_contains_param(self, expected) && !TypeChecker_is_enum_type_param(self, expected) && !type_mentions_any(expected, TypeChecker_enum_params_of(self, key)) && !TypeChecker_arg_compatible(self, expected, arg_tys.get(fi)) {
                            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + key + "::" + variant + " field " + int_to_str(fi + 1) + " expects '" + type_to_str(expected) + "', got '" + type_to_str(arg_tys.get(fi)) + "'");
                        }
                        // BG117: a literal must fit the field's type —
                        // `E::V(300)` for a u8 field narrowed it silently
                        if fi < args.len() {
                            TypeChecker_check_value_fits(self, expected, arg_tys.get(fi), args.get(fi), self.current_line);
                        }
                        fi = fi + 1;
                    }
                    return;
                }
                vi = vi + 1;
            }
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): enum '" + key + "' has no variant '" + variant + "'");
            return;
        }
        ei = ei + 1;
    }
}

// BG128: `Enum::Variant(args)` of a generic enum. Its payload was never
// checked (check_enum_constructor skips a field that names a type
// parameter) and the literal was typed `Enum` with no type arguments, so
// `val o: Option<str> = Option::Some(5)` and `return Result::Ok("no")` from
// a `-> Result<i64, str>` passed. Where the expected type (`hint`: a
// declared variable, return or parameter type, a Vec's element) is an
// instance of this enum, each payload is checked against its arguments and
// the literal has that type; else the arguments the payloads bind are the
// literal's (`Option::Some(5)` is an Option<i64>), when they bind all of
// them to types that are fully known.
fn TypeChecker_check_enum_lit(self: &mut TypeChecker, enum_name: str, variant: str, args: Vec<Expr>, hint: Type) -> Type {
    var key: str = "";
    var resolved: str = TypeChecker_resolve_struct_name(self, enum_name);
    var payload: Vec<Type> = Vec::new();
    var has_variant: bool = false;
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        var ek: str = self.enum_variants.get(ei).key;
        if ek == resolved || ek == enum_name {
            key = ek;
            var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
            var vi: i64 = 0;
            while vi < variants.len() {
                if variants.get(vi).name == variant {
                    payload = variants.get(vi).payload_types;
                    has_variant = true;
                    vi = variants.len();
                }
                vi = vi + 1;
            }
            ei = self.enum_variants.len();
        }
        ei = ei + 1;
    }
    var params: Vec<str> = Vec::new();
    if key != "" {
        params = TypeChecker_enum_params_of(self, key);
    }
    // The expected type's arguments, when it is an instance of this enum
    var from_hint: bool = false;
    var hint_ty: Type = Type::Never;
    var subst: Vec<StringType> = Vec::new();
    if params.len() > 0 && has_variant {
        hint_ty = TypeChecker_resolve_type(self, hint);
        match hint_ty {
            Type::Generic(hn, hargs) => {
                if (hn == key || hn == enum_name || TypeChecker_resolve_struct_name(self, hn) == key) && hargs.len() == params.len() {
                    from_hint = true;
                    var si: i64 = 0;
                    while si < params.len() {
                        subst.push(StringType_new(params.get(si), hargs.get(si)));
                        si = si + 1;
                    }
                }
            }
            _ => {
            }
        }
    }
    var arg_tys: Vec<Type> = Vec::new();
    var i: i64 = 0;
    while i < args.len() {
        var ahint: Type = Type::Never;
        if from_hint && i < payload.len() {
            ahint = TypeChecker_subst_type_params(payload.get(i), subst);
        }
        arg_tys.push(TypeChecker_check_expr_with_hint(self, args.get(i), ahint));
        i = i + 1;
    }
    TypeChecker_check_enum_constructor(self, enum_name, variant, arg_tys, args);
    if params.len() == 0 || !has_variant || payload.len() != args.len() {
        return Type::Named(enum_name);
    }
    if from_hint {
        var fi: i64 = 0;
        while fi < payload.len() {
            if type_mentions_any(payload.get(fi), params) {
                var want: Type = TypeChecker_subst_type_params(payload.get(fi), subst);
                var got: Type = arg_tys.get(fi);
                if !TypeChecker_type_contains_param(self, want) && !type_eq(got, Type::Never) && !type_eq(got, Type::Infer) {
                    if !TypeChecker_arg_compatible(self, want, got) && !TypeChecker_is_reported(self, got) {
                        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + key + "::" + variant + " field " + int_to_str(fi + 1) + " expects '" + type_to_str(want) + "', got '" + type_to_str(got) + "' (the expected type is " + type_to_str(hint_ty) + ")");
                    } else {
                        TypeChecker_check_value_fits(self, want, got, args.get(fi), self.current_line);
                    }
                }
            }
            fi = fi + 1;
        }
        return hint_ty;
    }
    // No expected type: what the payloads bind
    var names: Vec<str> = Vec::new();
    var tys: Vec<Type> = Vec::new();
    var bi: i64 = 0;
    while bi < payload.len() {
        var at: Type = arg_tys.get(bi);
        // a literal is an i64 (as `var i = 0` is), a borrowed string a str
        if tc_is_constant_expr(args.get(bi)) && tc_int_bits(at) > 0 && tc_int_bits(at) < 64 {
            at = Type::I64;
        }
        if tc_is_borrowed_str(at) {
            at = Type::Str;
        }
        TypeChecker_bind_enum_params(self, payload.get(bi), at, params, &mut names, &mut tys);
        bi = bi + 1;
    }
    if names.len() != params.len() {
        return Type::Named(enum_name);
    }
    var targs: Vec<Type> = Vec::new();
    var pi: i64 = 0;
    while pi < params.len() {
        var ni: i64 = 0;
        while ni < names.len() {
            if names.get(ni) == params.get(pi) {
                targs.push(tys.get(ni));
                ni = names.len();
            }
            ni = ni + 1;
        }
        pi = pi + 1;
    }
    if targs.len() != params.len() {
        return Type::Named(enum_name);
    }
    return Type::Generic(enum_name, targs);
}

// BG128: bind the type parameters `pattern` (a payload type) names to the
// parts of `actual` they stand for. Only a type known in full binds one: a
// bare Vec, an unknown, a type parameter or an error leaves it unbound.
fn TypeChecker_bind_enum_params(self: &TypeChecker, pattern: Type, actual: Type, params: Vec<str>, names: &mut Vec<str>, tys: &mut Vec<Type>) {
    match pattern {
        Type::Named(pn) => {
            if str_vec_contains(params, pn) && !str_vec_contains(names, pn) && TypeChecker_enum_bindable(self, actual) {
                names.push(pn);
                tys.push(actual);
            }
        }
        Type::Generic(pgn, pargs) => {
            match actual {
                Type::Generic(agn, aargs) => {
                    if pgn == agn && pargs.len() == aargs.len() {
                        var i: i64 = 0;
                        while i < pargs.len() {
                            TypeChecker_bind_enum_params(self, pargs.get(i), aargs.get(i), params, names, tys);
                            i = i + 1;
                        }
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
}

// BG128: a type an enum literal's type argument may be taken from: numbers,
// bool, str, a struct or enum with no type parameters, or an instance of a
// generic type whose arguments are all such types.
fn TypeChecker_enum_bindable(self: &TypeChecker, t: Type) -> bool {
    match t {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::I64 => {
            return true;
        }
        Type::U8 => {
            return true;
        }
        Type::U16 => {
            return true;
        }
        Type::U32 => {
            return true;
        }
        Type::U64 => {
            return true;
        }
        Type::F32 => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        Type::Str => {
            return true;
        }
        Type::Named(n) => {
            if n == "Vec" || n == "HashMap" || n == "Option" || n == "Result" || n == "Box" || n == "Rc" || n == "Arc" {
                return false;
            }
            if TypeChecker_type_contains_param(self, t) {
                return false;
            }
            return TypeChecker_enum_params_of(self, n).len() == 0 && TypeChecker_struct_type_params(self, n).len() == 0;
        }
        Type::Generic(_, gargs) => {
            if gargs.len() == 0 {
                return false;
            }
            var i: i64 = 0;
            while i < gargs.len() {
                if !TypeChecker_enum_bindable(self, gargs.get(i)) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn tc_is_enum_lit(e: Expr) -> bool {
    match e {
        Expr::EnumLit(_, _, _) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

// BG128: the expected type of argument `at` of a call of `callee`, for an
// enum literal argument: the parameter's type. Not for a generic function
// (its parameter types name its own type parameters) or a function value.
fn TypeChecker_enum_arg_hint(self: &mut TypeChecker, callee: str, arg: Expr, at: i64) -> Type {
    if !tc_is_enum_lit(arg) {
        return Type::Never;
    }
    match TypeChecker_lookup(self, callee) {
        OptType::Some(_) => {
            return Type::Never;
        }
        OptType::None => {
        }
    }
    if tc_str_vec_contains(self.func_generic_names, callee) {
        return Type::Never;
    }
    match TypeChecker_lookup_func_cache(self, callee) {
        OptFuncSig::Some(sig) => {
            if at < sig.param_types.len() {
                var pt: Type = sig.param_types.get(at);
                if !TypeChecker_type_contains_param(self, pt) {
                    return pt;
                }
            }
        }
        OptFuncSig::None => {
        }
    }
    return Type::Never;
}

// BG154: argument `at` of a collection method (`what`, e.g. "Vec.contains")
// must fit `want`; `role` names it in the message.
fn TypeChecker_check_coll_arg(self: &mut TypeChecker, what: str, role: str, at: i64, want: Type, arg_types: Vec<Type>) {
    if at >= arg_types.len() {
        return;
    }
    var a: Type = arg_types.get(at);
    if type_eq(a, Type::Infer) || type_eq(a, Type::Never) || TypeChecker_type_contains_param(self, want) || TypeChecker_type_contains_param(self, a) {
        return;
    }
    if TypeChecker_arg_compatible(self, want, a) {
        return;
    }
    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + what + " " + role + " expects '" + type_to_str(want) + "', got '" + type_to_str(a) + "' in '" + self.checking_fn + "'");
}

// BG154: the index of `v.get(i)`, `v.set(i, x)`, `v.insert(i, x)`,
// `v.remove(i)` must be an integer.
fn TypeChecker_check_index_arg(self: &mut TypeChecker, what: str, arg_types: Vec<Type>) {
    if arg_types.len() == 0 {
        return;
    }
    var a: Type = arg_types.get(0);
    var ra: Type = TypeChecker_resolve_type(self, tc_read_through(a));
    if type_eq(a, Type::Never) || TypeChecker_is_integer(self, ra) || TypeChecker_type_contains_param(self, ra) || TypeChecker_types_compatible(self, Type::I64, a) {
        return;
    }
    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): " + what + " index expects an integer, got '" + type_to_str(a) + "' in '" + self.checking_fn + "'");
}

// BG154: whether `receiver` is a map variable declared without a type
// (`var m = HashMap::new()`) that no insert has typed (RT5): its
// HashMap<str, i64> is the default, not what the program says.
fn TypeChecker_rt5_untyped_map(self: &mut TypeChecker, receiver: Expr) -> bool {
    match receiver {
        Expr::Ident(rn) => {
            if rt6_count() == 0 {
                return false;
            }
            var k: i64 = rt6_find(TypeChecker_rt6_fn_key(self), rn);
            return k >= 0 && rt6_is_map(k) && rt6_state(k) != 1;
        }
        _ => {
        }
    }
    return false;
}

// BG154: HashMap<K, V> methods: `insert(k, v)`, `get(k)`, `contains(k)`,
// `contains_key(k)`, `remove(k)`, `get_or(k, d)`.
fn TypeChecker_check_map_args(self: &mut TypeChecker, method: str, key_ty: Type, val_ty: Type, arg_types: Vec<Type>) {
    var want_n: i64 = -1;
    if method == "insert" || method == "get_or" {
        want_n = 2;
    }
    if method == "get" || method == "contains" || method == "contains_key" || method == "remove" {
        want_n = 1;
    }
    if want_n < 0 {
        return;
    }
    if arg_types.len() != want_n {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): HashMap." + method + " expects " + int_to_str(want_n) + " args, got " + int_to_str(arg_types.len()) + " in '" + self.checking_fn + "'");
        return;
    }
    TypeChecker_check_coll_arg(self, "HashMap." + method, "key", 0, key_ty, arg_types);
    if want_n == 2 {
        TypeChecker_check_coll_arg(self, "HashMap." + method, "value", 1, val_ty, arg_types);
    }
}

// BG128: the expected type of an enum literal stored by `v.push(x)`,
// `v.set(i, x)` or `v.insert(i, x)` on a Vec<T>: T.
fn TypeChecker_vec_store_hint(self: &mut TypeChecker, recv_ty: Type, method: str, arg: Expr, at: i64) -> Type {
    if !tc_is_enum_lit(arg) {
        return Type::Never;
    }
    var stores: bool = (method == "push" && at == 0) || ((method == "set" || method == "insert" || method == "get_or") && at == 1);
    if !stores {
        return Type::Never;
    }
    var rt: Type = recv_ty;
    match recv_ty {
        Type::Ref(inner, _) => {
            rt = box_type_unbox(inner);
        }
        _ => {
        }
    }
    match TypeChecker_resolve_type(self, rt) {
        Type::Generic(vn, vargs) => {
            if vn == "Vec" && vargs.len() == 1 && method != "get_or" {
                return vargs.get(0);
            }
            // BG154: a HashMap<K, V>'s `insert(k, v)` / `get_or(k, d)`: V
            if vn == "HashMap" && vargs.len() == 2 && (method == "insert" || method == "get_or") {
                return vargs.get(1);
            }
        }
        _ => {
        }
    }
    return Type::Never;
}

// BG128: the expected type of an enum literal given for field `fname` of a
// struct literal: the field's type, unless it names the struct's own type
// parameters `stps`.
fn tc_field_enum_hint(fields: Vec<StructField>, fname: str, e: Expr, stps: Vec<str>) -> Type {
    if !tc_is_enum_lit(e) {
        return Type::Never;
    }
    var i: i64 = 0;
    while i < fields.len() {
        if fields.get(i).name == fname {
            var ft: Type = fields.get(i).ty;
            if stps.len() > 0 && type_mentions_any(ft, stps) {
                return Type::Never;
            }
            return ft;
        }
        i = i + 1;
    }
    return Type::Never;
}

// BG128: `t` as the expected type of `e` when it is an enum literal.
fn tc_enum_lit_hint(e: Expr, t: Type) -> Type {
    if tc_is_enum_lit(e) {
        return t;
    }
    return Type::Never;
}

// BG128: the expected type of an enum literal stored by `v[i] = x`: the
// element type of the Vec v.
fn TypeChecker_index_enum_hint(self: &mut TypeChecker, array: str, expr: Expr) -> Type {
    if !tc_is_enum_lit(expr) {
        return Type::Never;
    }
    match TypeChecker_lookup(self, array) {
        OptType::Some(t) => {
            return TypeChecker_vec_store_hint(self, t, "set", expr, 1);
        }
        OptType::None => {
        }
    }
    return Type::Never;
}

// BG128: the expected type of an enum literal assigned to `target`: the
// variable's (or global's) type.
fn TypeChecker_assign_enum_hint(self: &mut TypeChecker, target: str, expr: Expr) -> Type {
    if !tc_is_enum_lit(expr) {
        return Type::Never;
    }
    match TypeChecker_lookup(self, target) {
        OptType::Some(t) => {
            return t;
        }
        OptType::None => {
        }
    }
    match TypeChecker_lookup_global_cache(self, target) {
        OptType::Some(gt) => {
            return gt;
        }
        OptType::None => {
        }
    }
    return Type::Never;
}

// M2: the statements of an `if` branch with a trailing `if c { .. } else
// { .. }` or `match` statement made the branch's value, as lowering does
// (lower.fd lw_value_tail): `if a { if b { 1 } else { 2 } } else { 3 }`.
fn tc_value_tail(stmts: Vec<Stmt>) -> Vec<Stmt> {
    if stmts.len() == 0 {
        return stmts;
    }
    var out: Vec<Stmt> = Vec::new();
    var i: i64 = 0;
    while i + 1 < stmts.len() {
        out.push(stmts.get(i));
        i = i + 1;
    }
    match stmts.get(stmts.len() - 1) {
        Stmt::If(c, t, e, line) => {
            match e {
                OptStmts::Some(_) => {
                    out.push(Stmt::Expr(Expr::If(Box::new(c), t, e), line));
                    return out;
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Match(m, arms, line) => {
            out.push(Stmt::Expr(Expr::Match(Box::new(m), arms), line));
            return out;
        }
        _ => {
        }
    }
    return stmts;
}

// Check a block in its own scope and return the type of its trailing
// expression statement (Void if it has none).
pub fn TypeChecker_check_block_value(self: &mut TypeChecker, stmts: Vec<Stmt>) -> Type {
    TypeChecker_push_scope(self);
    var last: Type = TypeChecker_check_stmts_value(self, stmts);
    TypeChecker_pop_scope(self);
    return last;
}

// Check statements in the current scope; the value is the trailing
// expression's type, Never if the list ends by leaving the block
// (return/break/continue), else Void.
pub fn TypeChecker_check_stmts_value(self: &mut TypeChecker, stmts: Vec<Stmt>) -> Type {
    var last: Type = Type::Void;
    var i: i64 = 0;
    while i < stmts.len() {
        var st: Stmt = stmts.get(i);
        var handled: bool = false;
        if i + 1 == stmts.len() {
            match st {
                Stmt::Expr(e, line) => {
                    last = TypeChecker_check_expr(self, e);
                    TypeChecker_consume_linear_in_expr(self, e, line);
                    handled = true;
                }
                _ => {
                }
            }
        }
        if !handled {
            TypeChecker_check_stmt(self, st);
            if i + 1 == stmts.len() {
                match st {
                    Stmt::Return(_, _) => {
                        last = Type::Never;
                    }
                    Stmt::Break(_, _) => {
                        last = Type::Never;
                    }
                    Stmt::Continue(_) => {
                        last = Type::Never;
                    }
                    _ => {
                    }
                }
            }
        }
        i = i + 1;
    }
    return last;
}

fn is_box_type(t: Type) -> bool {
    match t {
        Type::Generic(n, args) => {
            return n == "Box" && args.len() == 1;
        }
        _ => {
            return false;
        }
    }
    return false;
}

// Box<T> auto-derefs to T for field access, `*`, and `match`.
pub fn unbox_ty(t: Type) -> Type {
    match t {
        Type::Generic(n, args) => {
            if n == "Box" && args.len() == 1 {
                return args.get(0);
            }
            return t;
        }
        _ => {
            return t;
        }
    }
    return t;
}

// At the C FFI boundary a reference, str, raw pointer or runtime handle is
// passed as a pointer-sized integer or raw pointer.
/// A function handed to C must be a named one: C calls it through an adapter
/// made at compile time, with no captures and no struct result.
fn TypeChecker_check_c_callbacks(self: &mut TypeChecker, callee: str, sig: FuncSig, args: Vec<Expr>) -> void {
    var i: i64 = 0;
    while i < sig.param_types.len() && i < args.len() {
        var ok: bool = true;
        match TypeChecker_resolve_type(self, sig.param_types.get(i)) {
            Type::Func(_, _) => {
                ok = TypeChecker_is_c_callable(self, args.get(i));
            }
            _ => {
            }
        }
        if !ok {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): C function '" + callee + "' parameter " + int_to_str(i + 1) + " needs a named function that returns no struct" + TypeChecker_c_callback_fix(self, sig, args.get(i), i));
        }
        i = i + 1;
    }
}

/// CI3: why a closure or a function value is no C callback, and the fix.
/// C calls a plain function pointer: there is no place for what a closure
/// captures. Its state goes through the C function's user data pointer (a
/// raw pointer C hands back to the callback), or a global when C has none.
fn TypeChecker_c_callback_fix(self: &mut TypeChecker, sig: FuncSig, arg: Expr, at: i64) -> str {
    var why: str = "";
    match arg {
        Expr::Closure(params, body, _) => {
            var used: Vec<str> = Vec::new();
            esc_idents_stmts(body, &mut used);
            var captured: Vec<str> = Vec::new();
            var ui: i64 = 0;
            while ui < used.len() {
                var name: str = used.get(ui);
                var is_param: bool = false;
                var pi: i64 = 0;
                while pi < params.len() {
                    if params.get(pi).name == name {
                        is_param = true;
                    }
                    pi = pi + 1;
                }
                if !is_param {
                    match TypeChecker_lookup(self, name) {
                        OptType::Some(_) => {
                            captured = tc_insert_sorted(captured, name);
                        }
                        OptType::None => {
                        }
                    }
                }
                ui = ui + 1;
            }
            if captured.len() > 0 {
                why = "a closure that captures " + tc_join(captured, ", ") + " cannot be a C callback: C calls a plain function pointer, with no place for the captures";
            } else {
                why = "a closure is no C callback: C calls a plain function pointer";
            }
        }
        Expr::Ident(name) => {
            match TypeChecker_lookup(self, name) {
                OptType::Some(_) => {
                    why = "'" + name + "' is a variable: the function value it holds can be a closure with captures, and C calls a plain function pointer";
                }
                OptType::None => {
                    match TypeChecker_lookup_func_cache(self, name) {
                        OptFuncSig::Some(_) => {
                            // a named function: its result is a struct
                            return ".\n    '" + name + "' returns a struct, which the adapter C calls cannot give back.\n    Fix: return the result through a pointer parameter instead.";
                        }
                        OptFuncSig::None => {
                            return "";
                        }
                    }
                }
            }
        }
        _ => {
            why = "C calls a plain function pointer, known at compile time";
        }
    }
    var has_ptr: bool = false;
    var pi2: i64 = 0;
    while pi2 < sig.param_types.len() {
        if pi2 != at {
            match TypeChecker_resolve_type(self, sig.param_types.get(pi2)) {
                Type::RawPtr(_, _) => {
                    has_ptr = true;
                }
                _ => {
                }
            }
        }
        pi2 = pi2 + 1;
    }
    var fix: str = "write it as a named function and keep its state in a global (this C function takes no pointer to hand back)";
    if has_ptr {
        fix = "write it as a named function and pass its state through the C function's user data pointer, the raw pointer C hands back to the callback (if it takes one; else keep the state in a global): `&mut state as *u8` in the call, `val s: *State = ctx as *State;` in the callback";
    }
    return ".\n    " + why + ".\n    Fix: " + fix + ".";
}

fn TypeChecker_is_c_callable(self: &mut TypeChecker, arg: Expr) -> bool {
    match arg {
        Expr::Ident(name) => {
            match TypeChecker_lookup(self, name) {
                OptType::Some(_) => {
                    return false;
                }
                OptType::None => {
                }
            }
            match TypeChecker_lookup_func_cache(self, name) {
                OptFuncSig::Some(sig) => {
                    match sig.ret_ty {
                        Type::Named(n) => {
                            match TypeChecker_lookup_struct_cache(self, n) {
                                OptVecStructField::Some(_) => {
                                    return false;
                                }
                                OptVecStructField::None => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    return true;
                }
                OptFuncSig::None => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

pub fn is_ffi_pointer_pair(param: Type, arg: Type) -> bool {
    var param_is_ptr: bool = false;
    match param {
        Type::I64 => {
            param_is_ptr = true;
        }
        Type::RawPtr(_, _) => {
            param_is_ptr = true;
        }
        _ => {
        }
    }
    var arg_is_ptr: bool = is_handle_type(arg);
    match arg {
        Type::Ref(_, _) => {
            arg_is_ptr = true;
        }
        Type::Str => {
            arg_is_ptr = true;
        }
        Type::RawPtr(_, _) => {
            arg_is_ptr = true;
        }
        _ => {
        }
    }
    return param_is_ptr && arg_is_ptr;
}

// The type parameters declared by enum `name` (empty if not generic).
pub fn TypeChecker_enum_params_of(self: &TypeChecker, name: str) -> Vec<str> {
    var ti: i64 = 0;
    while ti < self.enum_type_params.len() {
        if self.enum_type_params.get(ti).key == name {
            return self.enum_type_params.get(ti).val;
        }
        ti = ti + 1;
    }
    return Vec::new();
}

// Whether `t` names any of `params` anywhere (e.g. `E`, `Vec<E>`, `&E`).
pub fn type_mentions_any(t: Type, params: Vec<str>) -> bool {
    match t {
        Type::Named(n) => {
            return str_vec_contains(params, n);
        }
        Type::Generic(n, args) => {
            if str_vec_contains(params, n) {
                return true;
            }
            var i: i64 = 0;
            while i < args.len() {
                if type_mentions_any(args.get(i), params) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        Type::Ref(inner, _) => {
            return type_mentions_any(box_type_unbox(inner), params);
        }
        Type::RawPtr(inner, _) => {
            return type_mentions_any(box_type_unbox(inner), params);
        }
        _ => {
            return false;
        }
    }
    return false;
}

// A bare type-parameter name of some generic enum (e.g. T in Option<T>).
pub fn TypeChecker_is_enum_type_param(self: &TypeChecker, t: Type) -> bool {
    match t {
        Type::Named(n) => {
            if HashMap_contains(self.enum_tp_set, n) {
                return true;
            }
            return str_vec_contains(self.current_type_params, n);
        }
        _ => {
            return false;
        }
    }
    return false;
}

// --- check_enum_pattern --------------------------------------------------
// Reject enum patterns naming a variant the enum does not have, or binding a
// different number of payload fields than the variant carries. Without this,
// `match op { BinOp::Ne => .. }` (no such variant) type-checked and silently
// never matched.

pub fn TypeChecker_check_enum_pattern(self: &mut TypeChecker, match_ty: Type, enum_name: str, variant: str, bindings: Vec<Binding>) {
    var ename: str = "";
    match TypeChecker_resolve_pattern_enum(self, match_ty, enum_name, variant) {
        OptString::Some(n) => {
            ename = n;
        }
        OptString::None => {
            return;
        }
    }
    // BG129: a pattern naming an enum must name the scrutinee's (`B::P(s)`
    // against an A matched on the tag number and bound A's payload as B's)
    if enum_name != "" {
        var scrut: str = TypeChecker_scrutinee_enum(self, match_ty);
        if scrut != "" && scrut != ename {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): pattern " + enum_name + "::" + variant + " is a variant of enum '" + ename + "', but the value matched is a '" + type_to_str(match_ty) + "'.\n    Fix: match the variants of '" + scrut + "'.");
            return;
        }
    }
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        if self.enum_variants.get(ei).key == ename {
            var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
            var vi: i64 = 0;
            while vi < variants.len() {
                if variants.get(vi).name == variant {
                    var n_payload: i64 = variants.get(vi).payload_types.len();
                    if bindings.len() > 0 && bindings.len() != n_payload {
                        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): pattern " + ename + "::" + variant + " binds " + int_to_str(bindings.len()) + " field(s) but the variant has " + int_to_str(n_payload));
                    }
                    return;
                }
                vi = vi + 1;
            }
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): enum '" + ename + "' has no variant '" + variant + "'");
            return;
        }
        ei = ei + 1;
    }
}

// BG129: the enum a match's scrutinee is ("" if it is no enum of the
// program: a type parameter, an unknown, a number).
fn TypeChecker_scrutinee_enum(self: &TypeChecker, match_ty: Type) -> str {
    var t: Type = match_ty;
    match match_ty {
        Type::Ref(inner, _) => {
            t = box_type_unbox(inner);
        }
        _ => {
        }
    }
    t = unbox_ty(TypeChecker_resolve_type(self, t));
    var n: str = "";
    match t {
        Type::Named(nn) => {
            n = nn;
        }
        Type::Generic(gn, _) => {
            n = gn;
        }
        _ => {
            return "";
        }
    }
    var resolved: str = TypeChecker_resolve_struct_name(self, n);
    var found: str = "";
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        var k: str = self.enum_variants.get(ei).key;
        if k == resolved {
            return resolved;
        }
        if k == n {
            found = n;
        }
        ei = ei + 1;
    }
    return found;
}

// BG146: `x is V` tests x's tag against variant V of x's own enum. It
// checked only x, so `e is Zzz` (no such variant) and `5 is A` (no enum:
// a tag loaded from address 5) were accepted. `x is i64` (a primitive) and
// a name that is a type (`d is Circle`) are type tests, left as they are.
fn TypeChecker_check_is_variant(self: &mut TypeChecker, operand_ty: Type, name: str) {
    if name == "i8" || name == "i16" || name == "i32" || name == "i64" || name == "i128" || name == "u8" || name == "u16" || name == "u32" || name == "u64" || name == "u128" || name == "f32" || name == "f64" || name == "bool" || name == "str" || name == "void" {
        return;
    }
    if TypeChecker_is_known_enum(self, name) {
        return;
    }
    match TypeChecker_lookup_struct_cache(self, name) {
        OptVecStructField::Some(_) => {
            return;
        }
        OptVecStructField::None => {
        }
    }
    var t: Type = operand_ty;
    match operand_ty {
        Type::Ref(inner, _) => {
            t = box_type_unbox(inner);
        }
        _ => {
        }
    }
    t = unbox_ty(TypeChecker_resolve_type(self, t));
    if type_eq(t, Type::Never) || type_eq(t, Type::Infer) || TypeChecker_is_reported(self, t) {
        return;
    }
    var ename: str = TypeChecker_scrutinee_enum(self, t);
    if ename == "" {
        if TypeChecker_type_contains_param(self, t) {
            return;
        }
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `is " + name + "` tests an enum's variant, but the value is a '" + type_to_str(operand_ty) + "', which is no enum.\n    Fix: test a value of an enum that has a variant '" + name + "', or a type (`x is i64`).");
        return;
    }
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        if self.enum_variants.get(ei).key == ename {
            var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
            var vi: i64 = 0;
            while vi < variants.len() {
                if variants.get(vi).name == name {
                    return;
                }
                vi = vi + 1;
            }
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `is " + name + "`: enum '" + ename + "' has no variant '" + name + "'.");
            return;
        }
        ei = ei + 1;
    }
}

// BG129: a literal pattern must be a value of the scrutinee's type: `"a"`
// against an i64 was accepted and never matched.
fn TypeChecker_check_literal_pattern(self: &mut TypeChecker, match_ty: Type, pat: Pattern) {
    var lit_ty: Type = Type::Never;
    var shown: str = "";
    match pat {
        Pattern::IntLit(v) => {
            lit_ty = Type::I64;
            shown = int_to_str(v);
        }
        Pattern::StrLit(s) => {
            lit_ty = Type::Str;
            shown = "\"" + s + "\"";
        }
        Pattern::BoolLit(b) => {
            lit_ty = Type::Bool;
            shown = "false";
            if b {
                shown = "true";
            }
        }
        Pattern::Range(lo, hi) => {
            TypeChecker_check_literal_pattern(self, match_ty, box_pattern_unbox(lo));
            TypeChecker_check_literal_pattern(self, match_ty, box_pattern_unbox(hi));
            return;
        }
        _ => {
            return;
        }
    }
    var mt: Type = match_ty;
    match match_ty {
        Type::Ref(inner, _) => {
            mt = box_type_unbox(inner);
        }
        _ => {
        }
    }
    mt = TypeChecker_resolve_type(self, mt);
    if type_eq(mt, Type::Never) || type_eq(mt, Type::Infer) || TypeChecker_is_reported(self, mt) || TypeChecker_type_contains_param(self, mt) {
        return;
    }
    if TypeChecker_types_compatible(self, mt, lit_ty) || (type_eq(lit_ty, Type::Str) && type_eq(mt, Type::Named("String"))) {
        return;
    }
    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): pattern " + shown + " is a " + type_to_str(lit_ty) + ", but the value matched is a '" + type_to_str(match_ty) + "': the arm can never match.\n    Fix: match values of type " + type_to_str(match_ty) + ".");
}

// --- pattern_binding_types -----------------------------------------------

pub fn TypeChecker_pattern_binding_types(self: &TypeChecker, match_ty: Type, enum_name: str, variant: str, bindings: Vec<Binding>) -> Vec<Type> {
    var result: Vec<Type> = Vec::new();
    // A bare `Some(v)` carries enum_name "": resolve it from the scrutinee
    // (or a unique variant) exactly as check_enum_pattern does, else the
    // binding is undeclared and reads as i64.
    var ename: str = enum_name;
    match TypeChecker_resolve_pattern_enum(self, match_ty, enum_name, variant) {
        OptString::Some(n) => {
            ename = n;
        }
        OptString::None => {
        }
    }
    // Find enum variant payload types
    var ei: i64 = 0;
    while ei < self.enum_variants.len() {
        if self.enum_variants.get(ei).key == ename {
            var variants: Vec<EnumVariantEntry> = self.enum_variants.get(ei).val;
            var vi: i64 = 0;
            while vi < variants.len() {
                if variants.get(vi).name == variant {
                    var payload_types: Vec<Type> = variants.get(vi).payload_types;
                    // Build type-param substitution from scrutinee's generic args.
                    // This allows Option<T> with Some(T) to substitute T with the
                    // actual type from the match expression.
                    var type_params: Vec<str> = Vec::new();
                    var ti: i64 = 0;
                    while ti < self.enum_type_params.len() {
                        if self.enum_type_params.get(ti).key == ename {
                            type_params = self.enum_type_params.get(ti).val;
                            ti = self.enum_type_params.len();
                        }
                        ti = ti + 1;
                    }
                    // Extract generic args from match_ty
                    var generic_args: Vec<Type> = Vec::new();
                    match match_ty {
                        Type::Generic(name, args) => {
                            if name == ename || name == enum_name {
                                generic_args = args;
                            }
                        }
                        _ => {
                        }
                    }
                    // Build substitution: type_params[i] -> generic_args[i]
                    var subst: Vec<StringType> = Vec::new();
                    var si: i64 = 0;
                    while si < type_params.len() && si < generic_args.len() {
                        subst.push(StringType_new(type_params.get(si), generic_args.get(si)));
                        si = si + 1;
                    }
                    // Apply substitution to each payload type
                    var pi: i64 = 0;
                    while pi < payload_types.len() && pi < bindings.len() {
                        var payload_ty: Type = payload_types.get(pi);
                        // Check if this is an unsubstituted type param (no substitution available)
                        var is_type_param: bool = false;
                        match payload_ty {
                            Type::Named(n) => {
                                // Check if n is a type param of this enum
                                var tpi: i64 = 0;
                                while tpi < type_params.len() {
                                    if type_params.get(tpi) == n {
                                        is_type_param = true;
                                        tpi = type_params.len();
                                    }
                                    tpi = tpi + 1;
                                }
                            }
                            _ => {
                            }
                        }
                        var binding_ann: str = bindings.get(pi).ty;
                        var subst_ty: Type = TypeChecker_subst_type_params(payload_ty, subst);
                        // A type parameter in scope (inside `impl<T> Slot`) is the
                        // type, unless the binding names one (`Err(e: str)`)
                        var in_scope_param: bool = false;
                        match subst_ty {
                            Type::Named(sn) => {
                                in_scope_param = tc_str_vec_contains(self.current_type_params, sn);
                            }
                            _ => {
                            }
                        }
                        if is_type_param && subst.len() > 0 && in_scope_param && !str_is_empty(binding_ann) {
                            result.push(type_from_annotation(binding_ann));
                        } else if is_type_param && subst.len() > 0 {
                            // Substitute the type param with the actual type
                            result.push(subst_ty);
                        } else if is_type_param {
                            // Unsubstituted type param: use binding annotation or i64 fallback
                            var binding_annot: str = bindings.get(pi).ty;
                            if !str_is_empty(binding_annot) {
                                result.push(type_from_annotation(binding_annot));
                            } else {
                                result.push(Type::I64);
                            }
                        } else {
                            result.push(payload_ty);
                        }
                        pi = pi + 1;
                    }
                    return result;
                }
                vi = vi + 1;
            }
            ei = self.enum_variants.len();
        }
        ei = ei + 1;
    }
    // Default: all i64
    var bi: i64 = 0;
    while bi < bindings.len() {
        result.push(Type::I64);
        bi = bi + 1;
    }
    return result;
}

// ---- CHUNK_MARKER_9 ----

// --- scan_stmts_for_effects ----------------------------------------------

// ---- 2g.65: Alloc from the language's own allocating forms ----
// The effect scan runs before bodies are type-checked, so it keeps what it
// can tell from declarations: the str and Vec/HashMap names of the function
// being scanned (parameters, then `var`/`val` as they come), and the method
// names some impl of the program defines (`x.push(..)` on a value of unknown
// type is a Vec push unless a user type has a `push` of its own).
var g_tc_eff_strs: Vec<str> = Vec::new();
var g_tc_eff_colls: Vec<str> = Vec::new();
var g_tc_eff_mnames: i64 = 0;
// BG151: whether `n` names a function (of the program, core or a builtin).
fn TypeChecker_tc_is_fn_name(self: &TypeChecker, n: str) -> bool {
    match TypeChecker_lookup_func_cache(self, n) {
        OptFuncSig::Some(_) => {
            return true;
        }
        OptFuncSig::None => {
        }
    }
    return HashMap_get(self.func_effects_index, n) != 0;
}

// BG151: the function's locals bound to a function value and what each is
// bound to (tc_let_is_fn_value), for a call through one
var g_tc_eff_fvars: Vec<str> = Vec::new();
var g_tc_eff_finits: Vec<Expr> = Vec::new();

fn tc_eff_add(effects: &mut Vec<str>, eff: str) {
    if !str_vec_contains_ref(effects, eff) {
        effects.push(eff);
    }
}

// 1 for a string type, 2 for Vec / HashMap (through a reference too), else 0.
fn tc_eff_type_kind(t: Type) -> i64 {
    match t {
        Type::Str => {
            return 1;
        }
        Type::Generic(gn, _) => {
            if gn == "Vec" || gn == "HashMap" {
                return 2;
            }
        }
        Type::Ref(inner, _) => {
            return tc_eff_type_kind(box_type_unbox(inner));
        }
        _ => {
        }
    }
    return 0;
}

fn tc_eff_note(name: str, kind: i64) {
    if kind == 1 && !tc_str_vec_contains(g_tc_eff_strs, name) {
        g_tc_eff_strs.push(name);
    }
    if kind == 2 && !tc_str_vec_contains(g_tc_eff_colls, name) {
        g_tc_eff_colls.push(name);
    }
}

// Start scanning a function: its parameters' kinds.
fn tc_eff_begin(params: Vec<Param>) {
    g_tc_eff_strs = Vec::new();
    g_tc_eff_colls = Vec::new();
    g_tc_eff_fvars = Vec::new();
    g_tc_eff_finits = Vec::new();
    var i: i64 = 0;
    while i < params.len() {
        tc_eff_note(params.get(i).name, tc_eff_type_kind(params.get(i).ty));
        i = i + 1;
    }
}

fn tc_eff_end() {
    g_tc_eff_strs = Vec::new();
    g_tc_eff_colls = Vec::new();
    g_tc_eff_fvars = Vec::new();
    g_tc_eff_finits = Vec::new();
}

// The method names the program's impls define.
fn tc_eff_collect_mnames(program: Program) {
    if g_tc_eff_mnames != 0 {
        HashMap_drop(g_tc_eff_mnames);
    }
    g_tc_eff_mnames = HashMap_new();
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            HashMap_insert(g_tc_eff_mnames, imp.methods.get(mi).name, 1);
            mi = mi + 1;
        }
        impi = impi + 1;
    }
}

// What an expression is, as far as the scan can tell: 1 a string, 2 a Vec or
// HashMap, 0 unknown.
fn tc_eff_expr_kind(e: Expr) -> i64 {
    match e {
        Expr::StringLit(_) => {
            return 1;
        }
        Expr::FString(_) => {
            return 1;
        }
        Expr::StrConcat(_, _) => {
            return 1;
        }
        Expr::Ident(n) => {
            if tc_str_vec_contains(g_tc_eff_strs, n) {
                return 1;
            }
            if tc_str_vec_contains(g_tc_eff_colls, n) {
                return 2;
            }
        }
        Expr::Binary(op, l, r) => {
            if binop_eq(op, BinOp::Add) && (tc_eff_expr_kind(box_expr_unbox(l)) == 1 || tc_eff_expr_kind(box_expr_unbox(r)) == 1) {
                return 1;
            }
        }
        Expr::MethodCall(recv, m, _) => {
            var mrecv: Expr = box_expr_unbox(recv);
            match mrecv {
                Expr::Ident(t) => {
                    if (t == "Vec" || t == "HashMap") && !tc_str_vec_contains(g_tc_eff_strs, t) && !tc_str_vec_contains(g_tc_eff_colls, t) {
                        return 2;
                    }
                }
                _ => {
                }
            }
            if m == "clone" || m == "map" || m == "filter" || m == "keys" || m == "values" || m == "split" {
                var rk: i64 = tc_eff_expr_kind(mrecv);
                if rk == 2 || m == "split" || m == "keys" || m == "values" {
                    return 2;
                }
                return rk;
            }
            if m == "to_str" || m == "to_string" || m == "to_upper" || m == "to_lower" || m == "replace" || m == "repeat" || m == "join" || m == "trim" || m == "substr" {
                return 1;
            }
        }
        _ => {
        }
    }
    return 0;
}

// Whether `recv.method(..)` allocates: a constructor of a builtin collection
// (`Vec::new`, `HashMap::new`, `Box::new`, `Vec::with_capacity`, ...), or a
// growing / copying method on a str, Vec or HashMap. A receiver of unknown
// type counts for the unambiguous collection methods unless an impl of the
// program defines a method of that name.
fn tc_eff_method_allocs(recv: Expr, method: str) -> bool {
    match recv {
        Expr::Ident(t) => {
            if (t == "Vec" || t == "HashMap" || t == "Box") && !tc_str_vec_contains(g_tc_eff_strs, t) && !tc_str_vec_contains(g_tc_eff_colls, t) {
                return method == "new" || method == "with_capacity" || method == "filled" || method == "from" || method == "new_sized" || method == "new_typed" || method == "clone";
            }
        }
        _ => {
        }
    }
    var kind: i64 = tc_eff_expr_kind(recv);
    if kind == 2 {
        return method == "push" || method == "insert" || method == "extend" || method == "clone" || method == "map" || method == "filter" || method == "keys" || method == "values" || method == "to_str" || method == "push_mem" || method == "insert_mem";
    }
    if kind == 1 {
        return method == "split" || method == "replace" || method == "repeat" || method == "to_upper" || method == "to_lower" || method == "clone" || method == "concat" || method == "to_str" || method == "to_string";
    }
    var grows: bool = method == "push" || method == "insert" || method == "extend" || method == "keys" || method == "values" || method == "split" || method == "join";
    if !grows {
        return false;
    }
    if g_tc_eff_mnames != 0 && HashMap_get(g_tc_eff_mnames, method) != 0 {
        return false;
    }
    return true;
}

pub fn TypeChecker_scan_stmts_for_effects(self: &TypeChecker, stmts: Vec<Stmt>, effects: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        TypeChecker_scan_stmt_for_effects(self, stmts.get(i), effects);
        i = i + 1;
    }
}

pub fn TypeChecker_scan_stmt_for_effects(self: &TypeChecker, stmt: Stmt, effects: &mut Vec<str>) {
    match stmt {
        Stmt::Let(let_name, let_ty, expr, _, _, _, _) => {
            TypeChecker_scan_expr_for_effects(self, expr, effects);
            // 2g.65: remember str / Vec / HashMap locals for `+` and methods
            var let_kind: i64 = tc_eff_expr_kind(expr);
            match let_ty {
                OptType::Some(lt) => {
                    var lt_kind: i64 = tc_eff_type_kind(lt);
                    if lt_kind != 0 {
                        let_kind = lt_kind;
                    }
                }
                OptType::None => {
                }
            }
            tc_eff_note(let_name, let_kind);
            if tc_let_is_fn_value(let_ty, expr) {
                g_tc_eff_fvars.push(let_name);
                g_tc_eff_finits.push(expr);
            }
        }
        Stmt::LetTuple(_, expr, _) => {
            TypeChecker_scan_expr_for_effects(self, expr, effects);
        }
        Stmt::Expr(expr, _) => {
            TypeChecker_scan_expr_for_effects(self, expr, effects);
        }
        Stmt::Assign(as_name, as_op, expr, _) => {
            TypeChecker_scan_expr_for_effects(self, expr, effects);
            // 2g.65: `s += t` on a string builds a new string
            match as_op {
                AssignOp::AddAssign => {
                    if tc_str_vec_contains(g_tc_eff_strs, as_name) || tc_eff_expr_kind(expr) == 1 {
                        tc_eff_add(effects, "Alloc");
                    }
                }
                _ => {
                }
            }
        }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            TypeChecker_scan_expr_for_effects(self, index, effects);
            TypeChecker_scan_expr_for_effects(self, expr, effects);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            TypeChecker_scan_expr_for_effects(self, ptr_expr, effects);
            TypeChecker_scan_expr_for_effects(self, expr, effects);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            TypeChecker_scan_expr_for_effects(self, object, effects);
            TypeChecker_scan_expr_for_effects(self, expr, effects);
        }
        Stmt::Return(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => {
                    TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            TypeChecker_scan_expr_for_effects(self, cond, effects);
            TypeChecker_scan_stmts_for_effects(self, then_block, effects);
            match else_block {
                OptStmts::Some(eb) => {
                    TypeChecker_scan_stmts_for_effects(self, eb, effects);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(cond, body, _) => {
            TypeChecker_scan_expr_for_effects(self, cond, effects);
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::For(_, iterator, body, _) => {
            TypeChecker_scan_expr_for_effects(self, iterator, effects);
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::Loop(body, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::Defer(body, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::Match(expr, arms, _) => {
            TypeChecker_scan_expr_for_effects(self, expr, effects);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_scan_stmts_for_effects(self, arms.get(ai).body, effects);
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::Sandbox(body, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::Unsafe(body, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::Txn(body, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::GradBlock(_, body, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::Backward(loss, _) => {
            TypeChecker_scan_expr_for_effects(self, loss, effects);
        }
        Stmt::Query(_, body, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                TypeChecker_scan_stmts_for_effects(self, branch, effects);
                bi = bi + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            TypeChecker_scan_expr_for_effects(self, cont, effects);
            TypeChecker_scan_expr_for_effects(self, value, effects);
        }
        Stmt::SpawnScope(body, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Stmt::CancelScope(_) => {
        }
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                TypeChecker_scan_expr_for_effects(self, cases.get(ci).channel, effects);
                TypeChecker_scan_stmts_for_effects(self, cases.get(ci).body, effects);
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(db) => {
                    TypeChecker_scan_stmts_for_effects(self, db, effects);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Handle(body, handlers, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
            var hi: i64 = 0;
            while hi < handlers.len() {
                TypeChecker_scan_stmts_for_effects(self, handlers.get(hi).body, effects);
                hi = hi + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(ai), effects);
                ai = ai + 1;
            }
        }
        _ => {
        }
    }
}

pub fn TypeChecker_scan_expr_for_effects(self: &TypeChecker, expr: Expr, effects: &mut Vec<str>) {
    match expr {
        Expr::IntLit(_) => {
        }
        Expr::FloatLit(_) => {
        }
        Expr::StringLit(_) => {
        }
        Expr::BoolLit(_) => {
        }
        Expr::Ident(_) => {
        }
        Expr::Binary(bin_op, left, right) => {
            var bin_l: Expr = box_expr_unbox(left);
            var bin_r: Expr = box_expr_unbox(right);
            // 2g.65: string `+` allocates the result
            if binop_eq(bin_op, BinOp::Add) && (tc_eff_expr_kind(bin_l) == 1 || tc_eff_expr_kind(bin_r) == 1) {
                tc_eff_add(effects, "Alloc");
            }
            TypeChecker_scan_expr_for_effects(self, bin_l, effects);
            TypeChecker_scan_expr_for_effects(self, bin_r, effects);
        }
        Expr::Unary(_, e) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::Call(callee, args) => {
            // Map builtin calls to effects (the table of src/typechecker.rs
            // scan_expr_for_effects).
            // (every name there starts with `p`: skip the comparisons otherwise).
            if str_byte_at(callee, 0) == 112 {
                var ce: str = "";
                if callee == "print" || callee == "println" || callee == "print_int" || callee == "print_float" || callee == "print_str" || callee == "p_print_str" || callee == "p_eprint_str" || callee == "p_print_int" || callee == "p_println_str" || callee == "p_println_int" || callee == "p_fs_read" || callee == "p_fs_write" {
                    ce = "IO";
                }  // Files, directories, processes, the clock and the
                // environment are IO; sockets and HTTP are Net (release K7:
                // @deterministic, @crashfree and sandbox missed them inside
                // methods)
                else if str_starts_with(callee, "p_file_") || str_starts_with(callee, "p_dir_") || str_starts_with(callee, "p_process_") || callee == "p_system" || callee == "p_mkdir" || callee == "p_rename" || callee == "p_remove" || str_starts_with(callee, "p_clock_") || callee == "p_time_now" || callee == "p_getenv" || callee == "p_env_get" || callee == "p_read_line" || callee == "p_read_stdin" || callee == "p_os_random_u64" {
                    ce = "IO";
                } else if str_starts_with(callee, "p_socket_") || str_starts_with(callee, "p_unix_") || str_starts_with(callee, "p_net_") || (str_starts_with(callee, "p_http_") && !str_contains(callee, "build") && !str_contains(callee, "parse")) || str_starts_with(callee, "p_tls_") || str_starts_with(callee, "p_dns_") {
                    ce = "Net";
                } else if callee == "p_spawn_process" || callee == "p_spawn_thread" || callee == "p_thread_spawn" {
                    ce = "Spawn";
                } else if callee == "p_panic" {
                    ce = "Diverge";
                } else if callee == "p_vec_new" || callee == "p_map_new" || callee == "p_vec_push" || callee == "p_vec_insert" || callee == "p_map_insert" || callee == "p_string_concat" || callee == "p_vec_clone" || callee == "p_map_clone" || callee == "p_string_clone" || callee == "p_vec_new_with" || callee == "p_alloc_new" {
                    ce = "Alloc";
                } else if callee == "p_tensor_matmul" || callee == "p_tensor_add" || callee == "p_tensor_sub" || callee == "p_tensor_mul" || callee == "p_tensor_scale" || callee == "p_tensor_relu" || callee == "p_tensor_sigmoid" || callee == "p_tensor_softmax" || callee == "p_tensor_dot" || callee == "p_tensor_sum" || callee == "p_tensor_mean" || callee == "p_tensor_transpose" || callee == "p_tensor_reshape" || callee == "p_tensor_zeros" || callee == "p_tensor_ones" || callee == "p_tensor_from_vec" || callee == "p_tensor_filled" || callee == "p_quantize_q8" || callee == "p_dequantize_q8" || callee == "p_qmatmul" || callee == "p_find_quant_params" {
                    ce = "Diff";
                } else if callee == "p_dp_noise" || callee == "p_dropout" || callee == "p_gaussian_noise" {
                    ce = "Noise";
                } else if callee == "p_all_reduce" || callee == "p_broadcast" || callee == "p_all_gather" || callee == "p_scatter" || callee == "p_send_tensor" || callee == "p_recv_tensor" || callee == "p_tp_init" {
                    ce = "Comm";
                }
                if ce != "" {
                    if !str_vec_contains_ref(effects, ce) {
                        effects.push(ce);
                    }
                }
                if callee == "p_kv_cache_new" || callee == "p_kv_cache_append" || callee == "p_kv_cache_get" || callee == "p_kv_cache_len" || callee == "p_kv_cache_clear" || callee == "p_kv_cache_evict" {
                    if !str_vec_contains_ref(effects, "Alloc") {
                        effects.push("Alloc");
                    }
                    if !str_vec_contains_ref(effects, "Read") {
                        effects.push("Read");
                    }
                    if !str_vec_contains_ref(effects, "Write") {
                        effects.push("Write");
                    }
                }
            }
            // BG151: a call through a local function value takes the effects
            // of what it is bound to: a named function's, a closure body's,
            // nothing for the caller's own function parameter, and every
            // effect for any other value (`val g = s.f; g(3)`), as for a
            // function passed to a higher-order call (reference §9.1)
            // (a name that is a function calls that function; a local bound
            // to a plain name that is no function, `val max = MAX`, is no
            // function value)
            if !tc_str_vec_contains(self.cur_ho_params, callee) && !TypeChecker_tc_is_fn_name(self, callee) {
                var fv_at: i64 = tc_last_index_of(g_tc_eff_fvars, callee);
                if fv_at >= 0 {
                    var fv_init: Expr = g_tc_eff_finits.get(fv_at);
                    match fv_init {
                        Expr::Ident(fv_n) => {
                            if TypeChecker_tc_is_fn_name(self, fv_n) {
                                // the named function's (or builtin's) effects
                                var fv_args: Vec<Expr> = Vec::new();
                                TypeChecker_scan_expr_for_effects(self, Expr::Call(fv_n, fv_args), effects);
                            } else if tc_str_vec_contains(self.cur_ho_params, fv_n) || tc_last_index_of(g_tc_eff_fvars, fv_n) >= 0 {
                                TypeChecker_passed_fn_effects(self, fv_init, effects);
                            }
                        }
                        _ => {
                            TypeChecker_passed_fn_effects(self, fv_init, effects);
                        }
                    }
                }
            }
            // Check user-defined function effects
            var slot: i64 = HashMap_get(self.func_effects_index, callee);
            if slot != 0 {
                var func_effs: Vec<str> = self.func_effects.get(slot - 1).val;
                var ei: i64 = 0;
                while ei < func_effs.len() {
                    if !str_vec_contains_ref(effects, func_effs.get(ei)) {
                        effects.push(func_effs.get(ei));
                    }
                    ei = ei + 1;
                }
            }
            // Effect polymorphism: a higher-order callee takes on the effects
            // of the functions passed to its function-typed parameters here
            var ho_at: i64 = HashMap_get(self.ho_fn_index, callee);
            if ho_at != 0 {
                var hidx: Vec<i64> = self.ho_fn_idx.get(ho_at - 1);
                var hk: i64 = 0;
                while hk < hidx.len() {
                    if hidx.get(hk) < args.len() {
                        TypeChecker_passed_fn_effects(self, args.get(hidx.get(hk)), effects);
                    }
                    hk = hk + 1;
                }
            }
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(ai), effects);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(receiver, mc_method, args) => {
            var mc_recv: Expr = box_expr_unbox(receiver);
            // 2g.65: `Vec::new()`, `v.push(x)`, `s.split(",")`, ... allocate
            if tc_eff_method_allocs(mc_recv, mc_method) {
                tc_eff_add(effects, "Alloc");
            }
            TypeChecker_scan_expr_for_effects(self, mc_recv, effects);
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(ai), effects);
                ai = ai + 1;
            }
        }
        Expr::FieldAccess(e, _) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::OptionalFieldAccess(e, _) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                TypeChecker_scan_expr_for_effects(self, fields.get(fi).value, effects);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => {
                    TypeChecker_scan_expr_for_effects(self, box_expr_unbox(s), effects);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::If(cond, then_block, else_block) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(cond), effects);
            TypeChecker_scan_stmts_for_effects(self, then_block, effects);
            match else_block {
                OptStmts::Some(eb) => {
                    TypeChecker_scan_stmts_for_effects(self, eb, effects);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Range(start, end, _) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(start), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(end), effects);
        }
        Expr::Block(stmts) => {
            TypeChecker_scan_stmts_for_effects(self, stmts, effects);
        }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_scan_expr_for_effects(self, elements.get(i), effects);
                i = i + 1;
            }
        }
        Expr::Index(array, index) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(array), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(index), effects);
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(e) => {
                        // 2g.65: an f-string with a value builds a string
                        tc_eff_add(effects, "Alloc");
                        TypeChecker_scan_expr_for_effects(self, e, effects);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                i = i + 1;
            }
        }
        Expr::Match(expr, arms) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(expr), effects);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_scan_stmts_for_effects(self, arms.get(ai).body, effects);
                match arms.get(ai).guard {
                    OptBoxExpr::Some(g) => {
                        TypeChecker_scan_expr_for_effects(self, box_expr_unbox(g), effects);
                    }
                    OptBoxExpr::None => {
                    }
                }
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_scan_expr_for_effects(self, args.get(i), effects);
                i = i + 1;
            }
        }
        Expr::Ref(e, _) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::Deref(e) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::StrConcat(l, r) => {
            tc_eff_add(effects, "Alloc");
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(l), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(r), effects);
        }
        Expr::Try(e) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::Coalesce(e, d) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(d), effects);
        }
        Expr::TryBlock(body) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Expr::IsCheck(e, _) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::TupleLit(elems) => {
            var i: i64 = 0;
            while i < elems.len() {
                TypeChecker_scan_expr_for_effects(self, elems.get(i), effects);
                i = i + 1;
            }
        }
        Expr::Closure(_, body, _) => {
            TypeChecker_scan_stmts_for_effects(self, body, effects);
        }
        Expr::Cast(e, _) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::Asm(_, operands) => {
            if !str_vec_contains_ref(effects, "Read") {
                effects.push("Read");
            }
            if !str_vec_contains_ref(effects, "Write") {
                effects.push("Write");
            }
            var i: i64 = 0;
            while i < operands.len() {
                TypeChecker_scan_expr_for_effects(self, operands.get(i).expr, effects);
                i = i + 1;
            }
        }
        Expr::Comptime(e) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::ComptimeBlock(stmts) => {
            TypeChecker_scan_stmts_for_effects(self, stmts, effects);
        }
        Expr::ComptimeReflect(_, _) => {
        }
        Expr::PipeForward(left, right) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(left), effects);
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(right), effects);
        }
        Expr::QuantCast(e, _) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::Await(e) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::Spawn(e) => {  // As src/typechecker.rs: a `spawn` expression contributes no
        // effect to the spawning function (the task runs elsewhere);
        // only explicit p_thread_spawn/p_spawn_* calls are !Spawn.
        }
        Expr::Yield(e) => {
            if !str_vec_contains_ref(effects, "Yield") {
                effects.push("Yield");
            }
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
        Expr::NamedArg(name, e) => {
            TypeChecker_scan_expr_for_effects(self, box_expr_unbox(e), effects);
        }
    }
}

// ---- CHUNK_MARKER_10 ----

// --- Lint functions ------------------------------------------------------

pub fn TypeChecker_lint_unused_functions(self: &mut TypeChecker, program: Program) {
    var called: Vec<str> = Vec::new();
    called.push("main");
    // Collect all called functions
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        TypeChecker_collect_called_funcs(self, program.funcs.get(fi).body, &mut called);
        fi = fi + 1;
    }
    // CS4: the impls read in place (a copy of each was a copy of its methods)
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var mi: i64 = 0;
        while mi < program.impls.get(impi).methods.len() {
            TypeChecker_collect_called_funcs(self, program.impls.get(impi).methods.get(mi).body, &mut called);
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    var timpi: i64 = 0;
    while timpi < program.trait_impls.len() {
        var tmi: i64 = 0;
        while tmi < program.trait_impls.get(timpi).methods.len() {
            TypeChecker_collect_called_funcs(self, program.trait_impls.get(timpi).methods.get(tmi).body, &mut called);
            tmi = tmi + 1;
        }
        timpi = timpi + 1;
    }
    // N5: calls in the initializers of consts and globals
    // (`pub const shape_2x3 = vec_lit(2, 3)`, `var trace_st = trace_state_new()`)
    var cdi: i64 = 0;
    while cdi < program.consts.len() {
        TypeChecker_collect_called_funcs_expr(self, program.consts.get(cdi).expr, &mut called);
        cdi = cdi + 1;
    }
    var gvi: i64 = 0;
    while gvi < program.globals.len() {
        TypeChecker_collect_called_funcs_expr(self, program.globals.get(gvi).init, &mut called);
        gvi = gvi + 1;
    }
    called = tc_dedupe_strs(called);
    // CS4: the called names as a set (a scan of `called` for every function
    // was quadratic in the program's size)
    var called_set: i64 = HashMap_new();
    var csi: i64 = 0;
    while csi < called.len() {
        HashMap_insert(called_set, called.get(csi), 1);
        csi = csi + 1;
    }
    // Report unused functions (skip main, pub, __ prefixed, comptime)
    var fi2: i64 = 0;
    while fi2 < program.funcs.len() {
        // L8H: a specialization `name__spec<k>` is called through `name`
        var used_as: str = program.funcs.get(fi2).name;
        if spec_base_name(program.funcs.get(fi2).name) != "" {
            used_as = spec_base_name(program.funcs.get(fi2).name);
        }
        if !HashMap_contains(called_set, used_as) && !program.funcs.get(fi2).is_pub && !program.funcs.get(fi2).is_comptime && !str_starts_with(program.funcs.get(fi2).name, "__") && program.funcs.get(fi2).name != "main" {
            self.warnings.push("unused function '" + program.funcs.get(fi2).name + "' — defined but never called");
        }
        fi2 = fi2 + 1;
    }
    HashMap_drop(called_set);
}

pub fn TypeChecker_collect_called_funcs(self: &TypeChecker, stmts: Vec<Stmt>, called: &mut Vec<str>) {
    var i: i64 = 0;
    while i < stmts.len() {
        TypeChecker_collect_called_funcs_stmt(self, stmts.get(i), called);
        i = i + 1;
    }
}

pub fn TypeChecker_collect_called_funcs_stmt(self: &TypeChecker, stmt: Stmt, called: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => {
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::LetTuple(_, expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::Expr(expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::Assign(_, _, expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, index, called);
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, ptr_expr, called);
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            TypeChecker_collect_called_funcs_expr(self, object, called);
            TypeChecker_collect_called_funcs_expr(self, expr, called);
        }
        Stmt::Return(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => {
                    TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            TypeChecker_collect_called_funcs_expr(self, cond, called);
            TypeChecker_collect_called_funcs(self, then_block, called);
            match else_block {
                OptStmts::Some(eb) => {
                    TypeChecker_collect_called_funcs(self, eb, called);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(cond, body, _) => {
            TypeChecker_collect_called_funcs_expr(self, cond, called);
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::For(_, iterator, body, _) => {
            TypeChecker_collect_called_funcs_expr(self, iterator, called);
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::Loop(body, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::Defer(body, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::Match(expr, arms, _) => {
            TypeChecker_collect_called_funcs_expr(self, expr, called);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_collect_called_funcs(self, arms.get(ai).body, called);
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::Sandbox(body, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::Unsafe(body, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::Txn(body, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::GradBlock(_, body, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::Backward(loss, _) => {
            TypeChecker_collect_called_funcs_expr(self, loss, called);
        }
        Stmt::Query(_, body, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                TypeChecker_collect_called_funcs(self, branch, called);
                bi = bi + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            TypeChecker_collect_called_funcs_expr(self, cont, called);
            TypeChecker_collect_called_funcs_expr(self, value, called);
        }
        Stmt::SpawnScope(body, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Stmt::CancelScope(_) => {
        }
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                TypeChecker_collect_called_funcs_expr(self, cases.get(ci).channel, called);
                TypeChecker_collect_called_funcs(self, cases.get(ci).body, called);
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(db) => {
                    TypeChecker_collect_called_funcs(self, db, called);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Handle(body, handlers, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
            var hi: i64 = 0;
            while hi < handlers.len() {
                TypeChecker_collect_called_funcs(self, handlers.get(hi).body, called);
                hi = hi + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var ai: i64 = 0;
            while ai < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(ai), called);
                ai = ai + 1;
            }
        }
        _ => {
        }
    }
}

pub fn TypeChecker_collect_called_funcs_expr(self: &TypeChecker, expr: Expr, called: &mut Vec<str>) {
    match expr {
        Expr::IntLit(_) => {
        }
        Expr::FloatLit(_) => {
        }
        Expr::StringLit(_) => {
        }
        Expr::BoolLit(_) => {
        }
        Expr::Ident(name) => {
            // N5: a function (or const/global) named as a value is used
            // (`resolver: x_no_resolver`, a callback passed by name)
            match TypeChecker_get_item_module(self, name) {
                OptString::Some(_) => {
                    called.push(name);
                }
                OptString::None => {
                }
            }
        }
        Expr::Binary(_, left, right) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(left), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(right), called);
        }
        Expr::Unary(_, e) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::Call(callee, args) => {
            called.push(callee);
            // deduplicated by the caller (tc_dedupe_strs)
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(i), called);
                i = i + 1;
            }
        }
        Expr::MethodCall(receiver, method, args) => {
            // "#unwrap" (no function has that name) marks a call that panics on
            // None or Err, for the lint in lint_unwraps
            if method == "unwrap" || method == "expect" {
                called.push("#unwrap");
            }
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(receiver), called);
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(i), called);
                i = i + 1;
            }
        }
        Expr::FieldAccess(e, _) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::OptionalFieldAccess(e, _) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                TypeChecker_collect_called_funcs_expr(self, fields.get(fi).value, called);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => {
                    TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(s), called);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::If(cond, then_block, else_block) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(cond), called);
            TypeChecker_collect_called_funcs(self, then_block, called);
            match else_block {
                OptStmts::Some(eb) => {
                    TypeChecker_collect_called_funcs(self, eb, called);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Range(start, end, _) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(start), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(end), called);
        }
        Expr::Block(stmts) => {
            TypeChecker_collect_called_funcs(self, stmts, called);
        }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                TypeChecker_collect_called_funcs_expr(self, elements.get(i), called);
                i = i + 1;
            }
        }
        Expr::Index(array, index) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(array), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(index), called);
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(e) => {
                        TypeChecker_collect_called_funcs_expr(self, e, called);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                i = i + 1;
            }
        }
        Expr::Match(expr, arms) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(expr), called);
            var ai: i64 = 0;
            while ai < arms.len() {
                TypeChecker_collect_called_funcs(self, arms.get(ai).body, called);
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            var i: i64 = 0;
            while i < args.len() {
                TypeChecker_collect_called_funcs_expr(self, args.get(i), called);
                i = i + 1;
            }
        }
        Expr::Ref(e, _) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::Deref(e) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::StrConcat(l, r) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(l), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(r), called);
        }
        Expr::Try(e) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::Coalesce(e, d) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(d), called);
        }
        Expr::TryBlock(body) => {
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Expr::IsCheck(e, _) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::TupleLit(elems) => {
            var i: i64 = 0;
            while i < elems.len() {
                TypeChecker_collect_called_funcs_expr(self, elems.get(i), called);
                i = i + 1;
            }
        }
        Expr::Closure(_, body, _) => {
            TypeChecker_collect_called_funcs(self, body, called);
        }
        Expr::Cast(e, _) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::Asm(_, operands) => {
            var i: i64 = 0;
            while i < operands.len() {
                TypeChecker_collect_called_funcs_expr(self, operands.get(i).expr, called);
                i = i + 1;
            }
        }
        Expr::Comptime(e) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::ComptimeBlock(stmts) => {
            TypeChecker_collect_called_funcs(self, stmts, called);
        }
        Expr::ComptimeReflect(_, _) => {
        }
        Expr::PipeForward(left, right) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(left), called);
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(right), called);
        }
        Expr::QuantCast(e, _) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::Await(e) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::Spawn(e) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::Yield(e) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
        Expr::NamedArg(name, e) => {
            TypeChecker_collect_called_funcs_expr(self, box_expr_unbox(e), called);
        }
    }
}

pub fn TypeChecker_lint_unused_imports(self: &mut TypeChecker, program: Program) {
    if program.imports.len() == 0 {
        return;
    }

    // Collect all function names called in the program
    var called: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        TypeChecker_collect_called_funcs(self, program.funcs.get(fi).body, &mut called);
        fi = fi + 1;
    }
    var impi: i64 = 0;
    while impi < program.impls.len() {
        var imp: ImplDef = program.impls.get(impi);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            TypeChecker_collect_called_funcs(self, imp.methods.get(mi).body, &mut called);
            mi = mi + 1;
        }
        impi = impi + 1;
    }
    var timpi: i64 = 0;
    while timpi < program.trait_impls.len() {
        var timp: TraitImpl = program.trait_impls.get(timpi);
        var tmi: i64 = 0;
        while tmi < timp.methods.len() {
            TypeChecker_collect_called_funcs(self, timp.methods.get(tmi).body, &mut called);
            tmi = tmi + 1;
        }
        timpi = timpi + 1;
    }
    // N5: calls in the initializers of consts and globals
    var cdi: i64 = 0;
    while cdi < program.consts.len() {
        TypeChecker_collect_called_funcs_expr(self, program.consts.get(cdi).expr, &mut called);
        cdi = cdi + 1;
    }
    var gvi: i64 = 0;
    while gvi < program.globals.len() {
        TypeChecker_collect_called_funcs_expr(self, program.globals.get(gvi).init, &mut called);
        gvi = gvi + 1;
    }
    called = tc_dedupe_strs(called);

    // For each import, check if any called function starts with the module name
    var i: i64 = 0;
    while i < program.imports.len() {
        var imp: ImportDef = program.imports.get(i);
        if imp.path == "core" {
            i = i + 1;
            continue;
        }
        var module_prefix: str = str_replace(imp.path, "::", "_") + "_";
        var any_used: bool = false;
        var ci: i64 = 0;
        while ci < called.len() {
            if str_starts_with(called.get(ci), module_prefix) {
                any_used = true;
                ci = called.len();
            } else {
                // N5: a module's functions need not carry its name as a
                // prefix (string's str_pad): the module that defines it
                match TypeChecker_get_item_module(self, called.get(ci)) {
                    OptString::Some(defined_in) => {
                        if defined_in == imp.path || defined_in == str_replace(imp.path, "::", "_") {
                            any_used = true;
                            ci = called.len();
                        }
                    }
                    OptString::None => {
                    }
                }
            }
            ci = ci + 1;
        }
        if !any_used {
            self.warnings.push("unused import: '" + imp.path + "' — module is imported but none of its functions are called");
        }
        i = i + 1;
    }
}

// ---- CHUNK_MARKER_11 ----

// --- scan_for_floats -----------------------------------------------------

pub fn scan_for_floats(stmts: Vec<Stmt>) -> Vec<str> {
    var found: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < stmts.len() {
        scan_stmt_for_floats(stmts.get(i), &mut found);
        i = i + 1;
    }
    return found;
}

pub fn scan_stmt_for_floats(stmt: Stmt, found: &mut Vec<str>) {
    match stmt {
        Stmt::Let(_, let_ty, expr, _, _, _, _) => {
            match let_ty {
                OptType::Some(lt) => {
                    if tc_type_contains_float(lt) {
                        found.push("float_let");
                    }
                }
                OptType::None => {
                }
            }
            scan_expr_for_floats(expr, found);
        }
        Stmt::LetTuple(_, expr, _) => {
            scan_expr_for_floats(expr, found);
        }
        Stmt::Expr(expr, _) => {
            scan_expr_for_floats(expr, found);
        }
        Stmt::Assign(_, _, expr, _) => {
            scan_expr_for_floats(expr, found);
        }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            scan_expr_for_floats(index, found);
            scan_expr_for_floats(expr, found);
        }
        Stmt::DerefAssign(ptr_expr, _, expr, _) => {
            scan_expr_for_floats(ptr_expr, found);
            scan_expr_for_floats(expr, found);
        }
        Stmt::FieldAssign(object, _, _, expr, _) => {
            scan_expr_for_floats(object, found);
            scan_expr_for_floats(expr, found);
        }
        Stmt::Return(opt_expr, _) => {
            match opt_expr {
                OptBoxExpr::Some(e) => {
                    scan_expr_for_floats(box_expr_unbox(e), found);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            scan_expr_for_floats(cond, found);
            var i: i64 = 0;
            while i < then_block.len() {
                scan_stmt_for_floats(then_block.get(i), found);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        scan_stmt_for_floats(eb.get(j), found);
                        j = j + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(cond, body, _) => {
            scan_expr_for_floats(cond, found);
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::For(_, iterator, body, _) => {
            scan_expr_for_floats(iterator, found);
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Loop(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Defer(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Match(expr, arms, _) => {
            scan_expr_for_floats(expr, found);
            var ai: i64 = 0;
            while ai < arms.len() {
                var i: i64 = 0;
                while i < arms.get(ai).body.len() {
                    scan_stmt_for_floats(arms.get(ai).body.get(i), found);
                    i = i + 1;
                }
                ai = ai + 1;
            }
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Sandbox(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Unsafe(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Txn(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::GradBlock(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Backward(loss, _) => {
            scan_expr_for_floats(loss, found);
        }
        Stmt::Query(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                var si: i64 = 0;
                while si < branch.len() {
                    scan_stmt_for_floats(branch.get(si), found);
                    si = si + 1;
                }
                bi = bi + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            scan_expr_for_floats(cont, found);
            scan_expr_for_floats(value, found);
        }
        Stmt::SpawnScope(body, _) => {
            var si6: i64 = 0;
            while si6 < body.len() {
                scan_stmt_for_floats(body.get(si6), found);
                si6 = si6 + 1;
            }
        }
        Stmt::CancelScope(_) => {
        }
        Stmt::Select(cases, default, _) => {
            var ci: i64 = 0;
            while ci < cases.len() {
                scan_expr_for_floats(cases.get(ci).channel, found);
                var i: i64 = 0;
                while i < cases.get(ci).body.len() {
                    scan_stmt_for_floats(cases.get(ci).body.get(i), found);
                    i = i + 1;
                }
                ci = ci + 1;
            }
            match default {
                OptStmts::Some(db) => {
                    var i: i64 = 0;
                    while i < db.len() {
                        scan_stmt_for_floats(db.get(i), found);
                        i = i + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Handle(body, _, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Stmt::Do(_, _, args, _) => {
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        _ => {
        }
    }
}

pub fn scan_expr_for_floats(expr: Expr, found: &mut Vec<str>) {
    match expr {
        Expr::FloatLit(_) => {
            found.push("float_literal");
        }
        Expr::IntLit(_) => {
        }
        Expr::StringLit(_) => {
        }
        Expr::BoolLit(_) => {
        }
        Expr::Ident(_) => {
        }
        Expr::Binary(_, left, right) => {
            scan_expr_for_floats(box_expr_unbox(left), found);
            scan_expr_for_floats(box_expr_unbox(right), found);
        }
        Expr::Unary(_, e) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::Call(_, args) => {
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        Expr::MethodCall(receiver, _, args) => {
            scan_expr_for_floats(box_expr_unbox(receiver), found);
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        Expr::FieldAccess(e, _) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::OptionalFieldAccess(e, _) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::StructLit(_, fields, spread) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                scan_expr_for_floats(fields.get(fi).value, found);
                fi = fi + 1;
            }
            match spread {
                OptBoxExpr::Some(s) => {
                    scan_expr_for_floats(box_expr_unbox(s), found);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::If(cond, then_block, else_block) => {
            scan_expr_for_floats(box_expr_unbox(cond), found);
            var i: i64 = 0;
            while i < then_block.len() {
                scan_stmt_for_floats(then_block.get(i), found);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        scan_stmt_for_floats(eb.get(j), found);
                        j = j + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Range(start, end, _) => {
            scan_expr_for_floats(box_expr_unbox(start), found);
            scan_expr_for_floats(box_expr_unbox(end), found);
        }
        Expr::Block(stmts) => {
            var i: i64 = 0;
            while i < stmts.len() {
                scan_stmt_for_floats(stmts.get(i), found);
                i = i + 1;
            }
        }
        Expr::ArrayLit(_, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                scan_expr_for_floats(elements.get(i), found);
                i = i + 1;
            }
        }
        Expr::Index(array, index) => {
            scan_expr_for_floats(box_expr_unbox(array), found);
            scan_expr_for_floats(box_expr_unbox(index), found);
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Expr(e) => {
                        scan_expr_for_floats(e, found);
                    }
                    FStringPart::Literal(_) => {
                    }
                }
                i = i + 1;
            }
        }
        Expr::Match(expr, arms) => {
            scan_expr_for_floats(box_expr_unbox(expr), found);
            var ai: i64 = 0;
            while ai < arms.len() {
                var i: i64 = 0;
                while i < arms.get(ai).body.len() {
                    scan_stmt_for_floats(arms.get(ai).body.get(i), found);
                    i = i + 1;
                }
                ai = ai + 1;
            }
        }
        Expr::EnumLit(_, _, args) => {
            var i: i64 = 0;
            while i < args.len() {
                scan_expr_for_floats(args.get(i), found);
                i = i + 1;
            }
        }
        Expr::Ref(e, _) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::Deref(e) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::StrConcat(l, r) => {
            scan_expr_for_floats(box_expr_unbox(l), found);
            scan_expr_for_floats(box_expr_unbox(r), found);
        }
        Expr::Try(e) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::Coalesce(e, d) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
            scan_expr_for_floats(box_expr_unbox(d), found);
        }
        Expr::TryBlock(body) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Expr::IsCheck(e, _) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::TupleLit(elems) => {
            var i: i64 = 0;
            while i < elems.len() {
                scan_expr_for_floats(elems.get(i), found);
                i = i + 1;
            }
        }
        Expr::Closure(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                scan_stmt_for_floats(body.get(i), found);
                i = i + 1;
            }
        }
        Expr::Cast(e, cast_ty) => {
            // `x as f64` makes a float from integers without any float literal
            if tc_type_contains_float(cast_ty) {
                found.push("float_cast");
            }
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::Asm(_, operands) => {
            var i: i64 = 0;
            while i < operands.len() {
                scan_expr_for_floats(operands.get(i).expr, found);
                i = i + 1;
            }
        }
        Expr::Comptime(e) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::ComptimeBlock(stmts) => {
            var i: i64 = 0;
            while i < stmts.len() {
                scan_stmt_for_floats(stmts.get(i), found);
                i = i + 1;
            }
        }
        Expr::ComptimeReflect(_, _) => {
        }
        Expr::PipeForward(left, right) => {
            scan_expr_for_floats(box_expr_unbox(left), found);
            scan_expr_for_floats(box_expr_unbox(right), found);
        }
        Expr::QuantCast(e, _) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::Await(e) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::Spawn(e) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::Yield(e) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
        Expr::NamedArg(name, e) => {
            scan_expr_for_floats(box_expr_unbox(e), found);
        }
    }
}

// --- Bugs roadmap, Nov 22: `if` and `match` as values (BG19), the init
// guarantee through branches and loops (BG20) ------------------------------

/// BG20: whether a block leaves by its last statement (return, break,
/// continue, a call of panic/exit, or an if/else whose two branches leave),
/// so that what follows the statement holding it is not reached from it.
fn tc_stmts_diverge(stmts: Vec<Stmt>) -> bool {
    if stmts.len() == 0 {
        return false;
    }
    match stmts.get(stmts.len() - 1) {
        Stmt::Return(_, _) => {
            return true;
        }
        Stmt::Break(_, _) => {
            return true;
        }
        Stmt::Continue(_) => {
            return true;
        }
        Stmt::Expr(e, _) => {
            match e {
                Expr::Call(callee, _) => {
                    return callee == "panic" || callee == "p_panic" || callee == "exit" || callee == "p_exit" || callee == "unreachable";
                }
                _ => {
                }
            }
        }
        Stmt::If(_, tb, eb, _) => {
            match eb {
                OptStmts::Some(eb2) => {
                    return tc_stmts_diverge(tb) && tc_stmts_diverge(eb2);
                }
                OptStmts::None => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// BG182: `a?.f` on an Option<P> (P a struct) has the type of P's field
/// f, and a field P lacks is an error (Never then); before, only a bare
/// struct receiver was looked at and anything else was i64. Infer when the
/// receiver is no Option of a known struct.
fn TypeChecker_option_field_type(self: &mut TypeChecker, obj_ty: Type, field: str) -> Type {
    match TypeChecker_resolve_type(self, tc_read_through(obj_ty)) {
        Type::Generic(ogn, oargs) => {
            if ogn == "Option" && oargs.len() == 1 {
                match TypeChecker_resolve_type(self, oargs.get(0)) {
                    Type::Named(sn) => {
                        var real: str = TypeChecker_resolve_struct_name(self, sn);
                        match TypeChecker_lookup_struct_cache(self, real) {
                            OptVecStructField::Some(fields) => {
                                var fi: i64 = 0;
                                while fi < fields.len() {
                                    if fields.get(fi).name == field {
                                        return fields.get(fi).ty;
                                    }
                                    fi = fi + 1;
                                }
                                self.errors.push("Type error (line " + int_to_str(self.current_line) + "): no field '" + field + "' on struct '" + sn + "' (in `?." + field + "` on " + type_to_str(obj_ty) + ")");
                                return Type::Never;
                            }
                            OptVecStructField::None => {
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
        }
        _ => {
        }
    }
    return Type::Infer;
}

/// BG155: the value of a closure body. An expression body (`fn(x: i64) ->
/// str => x`) is the closure's result: with a declared return type it is
/// checked against it (as the expected type), as a `return` of it would
/// be; before, its type was only used to infer and the declared one won.
/// Any other body is checked as statements (TypeChecker_check_stmts_value).
fn TypeChecker_check_closure_body(self: &mut TypeChecker, body: Vec<Stmt>, ret_ty: OptType) -> Type {
    if body.len() == 1 {
        match body.get(0) {
            Stmt::Expr(be, bl) => {
                match ret_ty {
                    OptType::Some(brt) => {
                        var hint: Type = TypeChecker_resolve_self_type(self, brt);
                        if !type_eq(hint, Type::Void) {
                            var body_ty: Type = TypeChecker_check_expr_with_hint(self, be, hint);
                            TypeChecker_consume_linear_in_expr(self, be, bl);
                            // (a body that is Void, Never or already an error
                            // has no value to compare: an `if`/`match` whose
                            // arms `return`)
                            if !type_eq(body_ty, Type::Void) && !type_eq(body_ty, Type::Never) && !type_eq(body_ty, Type::Infer) && !TypeChecker_is_reported(self, body_ty) {
                                TypeChecker_check_value_fits(self, hint, body_ty, be, bl);
                                TypeChecker_check_return_type(self, body_ty);
                            }
                            return body_ty;
                        }
                    }
                    OptType::None => {
                    }
                }
            }
            _ => {
            }
        }
    }
    return TypeChecker_check_stmts_value(self, body);
}

/// BG187: whether a branch leaves (as tc_stmts_diverge, and a `match`
/// every arm of which leaves, or an if/else of such branches).
fn tc_lin_diverge(stmts: Vec<Stmt>) -> bool {
    if tc_stmts_diverge(stmts) {
        return true;
    }
    if stmts.len() == 0 {
        return false;
    }
    match stmts.get(stmts.len() - 1) {
        Stmt::Match(_, arms, _) => {
            if arms.len() == 0 {
                return false;
            }
            var ai: i64 = 0;
            while ai < arms.len() {
                if !tc_lin_diverge(arms.get(ai).body) {
                    return false;
                }
                ai = ai + 1;
            }
            return true;
        }
        Stmt::If(_, tb, eb, _) => {
            match eb {
                OptStmts::Some(eb2) => {
                    return tc_lin_diverge(tb) && tc_lin_diverge(eb2);
                }
                OptStmts::None => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// BG187: whether consumed name `n` ("t" or a path "t.f") is a variable
/// still in scope (declared before the branches, not inside one).
fn TypeChecker_linear_name_visible(self: &TypeChecker, n: str) -> bool {
    var base: str = n;
    var i: i64 = 0;
    while i < str_len(n) {
        if str_byte_at(n, i) == 46 {
            base = str_slice(n, 0, i);
            i = str_len(n);
        }
        i = i + 1;
    }
    match TypeChecker_lookup(self, base) {
        OptType::Some(_) => {
            return true;
        }
        OptType::None => {
        }
    }
    return false;
}

/// BG187: the consumed set after the branches of an if or a match: `outs`
/// holds each branch's consumed set at its end, `live` whether it reaches
/// the end (a branch that returns, breaks or panics does not). A linear
/// variable is consumed after them when every live branch consumed it; one
/// consumed by some live branches only would be used twice on one path or
/// lost on another: an error (it then counts as consumed, so it is not
/// reported again). Before, only `if` statements were merged (match arms
/// accumulated), and a variable consumed in one branch only was taken as
/// not consumed, so using it again after the `if` was accepted.
fn TypeChecker_linear_join(self: &mut TypeChecker, before: Vec<str>, outs: Vec<Vec<str>>, live: Vec<bool>, what: str, line: i64) -> Vec<str> {
    var any_live: bool = false;
    var k: i64 = 0;
    while k < live.len() {
        if live.get(k) {
            any_live = true;
        }
        k = k + 1;
    }
    var result: Vec<str> = before.clone();
    var bi: i64 = 0;
    while bi < outs.len() {
        if !any_live || live.get(bi) {
            var o: Vec<str> = outs.get(bi);
            var oi: i64 = 0;
            while oi < o.len() {
                var n: str = o.get(oi);
                if !tc_str_vec_contains(result, n) {
                    var in_all: bool = true;
                    var bj: i64 = 0;
                    while bj < outs.len() {
                        if any_live && live.get(bj) && !tc_str_vec_contains(outs.get(bj), n) {
                            in_all = false;
                        }
                        bj = bj + 1;
                    }
                    if in_all {
                        result.push(n);
                    } else if TypeChecker_linear_name_visible(self, n) {
                        self.errors.push("Linear type error (line " + int_to_str(line) + "): variable '" + n + "' is consumed in some branches of this `" + what + "` but not in others.\n    After the " + what + ", '" + n + "' would be used twice on one path or lost on another.\n    Fix: consume it in every branch (or in none of them).");
                        result.push(n);
                    }
                }
                oi = oi + 1;
            }
        }
        bi = bi + 1;
    }
    return result;
}

/// BG187: TypeChecker_linear_join for two branches.
fn TypeChecker_linear_join2(self: &mut TypeChecker, before: Vec<str>, a: Vec<str>, a_live: bool, b: Vec<str>, b_live: bool, what: str, line: i64) -> Vec<str> {
    var outs: Vec<Vec<str>> = Vec::new();
    outs.push(a);
    outs.push(b);
    var live: Vec<bool> = Vec::new();
    live.push(a_live);
    live.push(b_live);
    return TypeChecker_linear_join(self, before, outs, live, what, line);
}

/// BG20: the variables still unassigned where two paths join: those
/// unassigned on either path that reaches the join (a path that leaves,
/// `a_leaves` / `b_leaves`, does not).
fn tc_uninit_join(a: Vec<str>, a_leaves: bool, b: Vec<str>, b_leaves: bool) -> Vec<str> {
    if a_leaves && !b_leaves {
        return b.clone();
    }
    if b_leaves && !a_leaves {
        return a.clone();
    }
    var out: Vec<str> = a.clone();
    var i: i64 = 0;
    while i < b.len() {
        if !tc_str_vec_contains(out, b.get(i)) {
            out.push(b.get(i));
        }
        i = i + 1;
    }
    return out;
}

/// BG19: a type that says nothing to compare a branch's type with: a
/// branch that leaves (Never), one with no value (Void), one not known yet,
/// a function value or trait object (compared where they are used).
fn tc_branch_type_open(t: Type) -> bool {
    match t {
        Type::Never => {
            return true;
        }
        Type::Infer => {
            return true;
        }
        Type::Void => {
            return true;
        }
        Type::Func(_, _) => {
            return true;
        }
        Type::Dyn(_) => {
            return true;
        }
        Type::Assoc(_, _, _, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// BG19: the branches of an `if` (or the arms of a `match`) used as a value
/// give one type. Before, the first branch's type was the value's and the
/// others were not looked at: `val n: i64 = if c { 5 } else { "five" };`
/// was accepted and n held the string's address. Two types fit when either
/// is accepted where the other is wanted (as a `val x: T = e` or an
/// argument checks it), and numbers of any width fit each other (the value
/// is checked against what it is assigned to). The runtime layer and the
/// compiler's own modules (where a str is a word) are left as they were.
fn TypeChecker_check_branch_types(self: &mut TypeChecker, first: Type, other: Type, what: str) {
    if is_runtime_layer(self.current_module) || str_starts_with(self.current_module, "compiler") {
        return;
    }
    var a: Type = TypeChecker_resolve_type(self, first);
    var b: Type = TypeChecker_resolve_type(self, other);
    if tc_branch_type_open(a) || tc_branch_type_open(b) {
        return;
    }
    if TypeChecker_is_numeric(self, a) && TypeChecker_is_numeric(self, b) {
        return;
    }
    if TypeChecker_type_contains_param(self, a) || TypeChecker_type_contains_param(self, b) {
        return;
    }
    if TypeChecker_types_compatible(self, a, b) || TypeChecker_types_compatible(self, b, a) || TypeChecker_arg_compatible(self, a, b) || TypeChecker_arg_compatible(self, b, a) {
        return;
    }
    var parts: str = "branches of this `if`";
    if what == "match" {
        parts = "arms of this `match`";
    }
    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): the " + parts + " have different types: " + type_to_str(a) + " and " + type_to_str(b) + ".\n    An `" + what + "` used as a value has one type: every branch gives a value of it (or leaves with return, break or panic).\n    Fix: convert one branch's value (`as`, int_to_str, ...), or use the `" + what + "` as a statement.");
}

/// BG19/BG20: `if c { a } else { b }` as a value (Expr::If; out of
/// TypeChecker_check_expr_inner, whose C is at zig cc's size limit). The
/// condition is checked as an `if` statement's is (it was not checked at
/// all), the branches' types are compared (TypeChecker_check_branch_types),
/// and a variable declared without a value is assigned after it only when
/// both branches that reach its end assign it (before, an assignment in
/// either branch counted: the init guarantee F63 was bypassed).
fn TypeChecker_check_if_value(self: &mut TypeChecker, cond: Expr, then_block: Vec<Stmt>, else_block: OptStmts) -> Type {
    var cond_ty: Type = TypeChecker_resolve_type(self, TypeChecker_check_expr(self, cond));
    if !type_eq(cond_ty, Type::Bool) && !type_eq(cond_ty, Type::I32) && !type_eq(cond_ty, Type::I64) && !type_eq(cond_ty, Type::Infer) && !type_eq(cond_ty, Type::Never) {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): if condition must be bool, got " + type_to_str(cond_ty));
    }
    var uninit_before: Vec<str> = self.uninit_vars.clone();
    // BG187: each branch starts from what was consumed before the if; the
    // two are joined after it (TypeChecker_linear_join)
    var il_line: i64 = self.current_line;
    var il_before: Vec<str> = self.consumed_vars.clone();
    // M2: a branch that ends in an if/else or a match has that
    // statement's value, as lowering lowers it (lw_value_tail)
    var then_ty: Type = TypeChecker_check_block_value(self, tc_value_tail(then_block));
    var il_then: Vec<str> = self.consumed_vars.clone();
    self.consumed_vars = il_before.clone();
    match else_block {
        OptStmts::Some(else_b) => {
            var uninit_then: Vec<str> = self.uninit_vars.clone();
            self.uninit_vars = uninit_before.clone();
            // `if c { a } else { b }` has the type of its branches;
            // a diverging branch takes the other branch's type.
            var else_ty: Type = TypeChecker_check_block_value(self, tc_value_tail(else_b));
            self.consumed_vars = TypeChecker_linear_join2(self, il_before, il_then, !tc_lin_diverge(then_block), self.consumed_vars.clone(), !tc_lin_diverge(else_b), "if", il_line);
            var uninit_else: Vec<str> = self.uninit_vars.clone();
            self.uninit_vars = tc_uninit_join(uninit_then, tc_stmts_diverge(then_block), uninit_else, tc_stmts_diverge(else_b));
            TypeChecker_check_branch_types(self, then_ty, else_ty, "if");
            match then_ty {
                Type::Never => {
                    return else_ty;
                }
                _ => {
                    return then_ty;
                }
            }
        }
        OptStmts::None => {
        }
    }
    // no else: what the branch assigns may not be assigned
    self.uninit_vars = uninit_before;
    self.consumed_vars = TypeChecker_linear_join2(self, il_before, il_then, !tc_lin_diverge(then_block), self.consumed_vars.clone(), true, "if", il_line);
    return Type::Void;
}

/// BG19/BG20: `match e { .. }` as a value (Expr::Match, out of line as
/// TypeChecker_check_if_value). The value's type is the first arm's that
/// does not leave; every other such arm's is compared with it. The init
/// guarantee joins the arms as Stmt::Match does.
fn TypeChecker_check_match_value(self: &mut TypeChecker, expr: Expr, arms: Vec<MatchArm>) -> Type {
    var match_ty: Type = unbox_ty(TypeChecker_check_expr(self, expr));
    TypeChecker_check_exhaustive(self, match_ty, arms, self.current_line);
    var match_value_ty: Type = Type::Never;
    var match_has_value: bool = false;
    var mu_before: Vec<str> = self.uninit_vars.clone();
    var mu_out: Vec<str> = Vec::new();
    var mu_flows: bool = false;
    // BG187: the arms' consumption is joined, as for Stmt::Match
    var ml_line: i64 = self.current_line;
    var ml_before: Vec<str> = self.consumed_vars.clone();
    var ml_outs: Vec<Vec<str>> = Vec::new();
    var ml_live: Vec<bool> = Vec::new();
    var ai: i64 = 0;
    while ai < arms.len() {
        var arm: MatchArm = arms.get(ai);
        self.uninit_vars = mu_before.clone();
        self.consumed_vars = ml_before.clone();
        TypeChecker_push_scope(self);
        // BG129: a literal pattern of the scrutinee's type
        TypeChecker_check_literal_pattern(self, match_ty, arm.pattern);
        match arm.pattern {
            Pattern::Ident(name) => {
                // `None =>` on an Option is the variant, as `Some(x)` is
                // (reference §6): it binds nothing
                if !TypeChecker_bare_pattern_is_unit_variant(self, match_ty, name) {
                    TypeChecker_declare(self, name, match_ty);
                }
            }
            Pattern::EnumVariant(enum_name, variant, bindings) => {
                TypeChecker_check_enum_pattern(self, match_ty, enum_name, variant, bindings);
                var tys: Vec<Type> = TypeChecker_pattern_binding_types(self, match_ty, enum_name, variant, bindings);
                var bi: i64 = 0;
                while bi < bindings.len() && bi < tys.len() {
                    TypeChecker_declare(self, bindings.get(bi).name, tys.get(bi));
                    bi = bi + 1;
                }
            }
            Pattern::StrLit(_) => {
            }
            Pattern::Range(_, _) => {
            }
            _ => {
            }
        }
        match arm.guard {
            OptBoxExpr::Some(g) => {
                TypeChecker_check_expr(self, box_expr_unbox(g));
            }
            OptBoxExpr::None => {
            }
        }
        // `match` as a value: the first non-diverging arm's type.
        var arm_ty: Type = TypeChecker_check_stmts_value(self, arm.body);
        match arm_ty {
            Type::Never => {
            }
            _ => {
                if !match_has_value {
                    match_value_ty = arm_ty;
                    match_has_value = true;
                } else {
                    TypeChecker_check_branch_types(self, match_value_ty, arm_ty, "match");
                }
            }
        }
        TypeChecker_pop_scope(self);
        if !tc_stmts_diverge(arm.body) {
            mu_out = tc_uninit_join(mu_out, false, self.uninit_vars.clone(), false);
            mu_flows = true;
        }
        ml_outs.push(self.consumed_vars.clone());
        ml_live.push(!tc_lin_diverge(arm.body));
        ai = ai + 1;
    }
    if arms.len() > 0 {
        self.consumed_vars = TypeChecker_linear_join(self, ml_before, ml_outs, ml_live, "match", ml_line);
    }
    if mu_flows {
        self.uninit_vars = mu_out;
    } else {
        self.uninit_vars = mu_before;
    }
    if arms.len() == 0 {
        return Type::Void;
    }
    return match_value_ty;
}

// --- Bugs roadmap, Nov 22: effects and recursion through method calls
// (BG22, BG59) -------------------------------------------------------------

/// BG22: whether `f` carries a rule about its effects (@deterministic,
/// @realtime, @constant_time, or a declared effect list such as `!{IO}`).
fn tc_has_effect_rule(f: Func) -> bool {
    return f.has_effect_annotation || tc_has_annotation(f.annotations, "deterministic") || tc_has_annotation(f.annotations, "realtime") || tc_has_annotation(f.annotations, "constant_time");
}

/// BG22: add `effs` to the effects kept for `name`; whether one was new.
fn TypeChecker_add_func_effects(self: &mut TypeChecker, name: str, effs: Vec<str>) -> bool {
    if effs.len() == 0 {
        return false;
    }
    var cur: Vec<str> = TypeChecker_get_func_effects(self, name);
    var out: Vec<str> = cur.clone();
    var grew: bool = false;
    var i: i64 = 0;
    while i < effs.len() {
        if !tc_str_vec_contains(out, effs.get(i)) {
            out.push(effs.get(i));
            grew = true;
        }
        i = i + 1;
    }
    if grew {
        TypeChecker_set_func_effects(self, name, out);
    }
    return grew;
}

/// BG22: scan a body again (its callees' effects may have grown) and add
/// what it finds to `name`'s effects; `ho_name` is the name its
/// function-typed parameters were registered under (TypeChecker_register_ho).
fn TypeChecker_rescan_effects(self: &mut TypeChecker, name: str, ho_name: str, params: Vec<Param>, body: Vec<Stmt>) -> bool {
    var effs: Vec<str> = Vec::new();
    self.cur_ho_params = TypeChecker_ho_pnames(self, ho_name);
    tc_eff_begin(params);
    TypeChecker_scan_stmts_for_effects(self, body, &mut effs);
    tc_eff_end();
    self.cur_ho_params = Vec::new();
    return TypeChecker_add_func_effects(self, name, effs);
}

/// BG22: the effect rules of one function or method (`label`, whose effects
/// are `effs`), for the effects not in `skip` (those the checks before the
/// bodies saw and reported).
fn TypeChecker_effect_rules_one(self: &mut TypeChecker, func: Func, label: str, effs: Vec<str>, skip: Vec<str>) {
    val is_det: bool = tc_has_annotation(func.annotations, "deterministic");
    val is_rt: bool = tc_has_annotation(func.annotations, "realtime");
    val is_ct: bool = tc_has_annotation(func.annotations, "constant_time");
    var i: i64 = 0;
    while i < effs.len() {
        var eff: str = effs.get(i);
        if !tc_str_vec_contains(skip, eff) {
            val blocks: bool = eff == "IO" || eff == "Net" || eff == "Spawn";
            if is_det && (blocks || eff == "Diverge") {
                self.errors.push("Determinism error: function '" + label + "' is @deterministic but has effect '!" + eff + "' through a method it calls (directly or through the functions it calls)." + "\n    @deterministic functions must be reproducible — same inputs → same outputs." + "\n    Fix: remove the @deterministic annotation, or the call that produces the '!" + eff + "' effect.");
            }
            if func.has_effect_annotation && !tc_str_vec_contains(func.declared_effects, eff) {
                self.errors.push("Effect error: function '" + label + "' has inferred effect '!" + eff + "' (through a method it calls) but only declared effects not including it");
            }
            if is_rt && blocks {
                self.errors.push("Realtime error: function '" + label + "' is @realtime but has effect '!" + eff + "' which may block (through a method it calls)");
            }
            if is_ct && (blocks || eff == "Diverge") {
                self.errors.push("Constant-time error: function '" + label + "' is @constant_time but has effect '!" + eff + "' (through a method it calls)");
            }
        }
        i = i + 1;
    }
}

/// BG22: effect inference after the bodies are checked. The pre-pass
/// (TypeChecker_compute_func_effects) scans names: a call `x.log()` adds no
/// effect, since which `log` it calls depends on x's type, known only once
/// the bodies are checked. So a @deterministic (or @realtime,
/// @constant_time, `!{..}`) function was accepted when it reached IO
/// through a helper that calls a method doing it (a direct call of such a
/// method is TypeChecker_verify_method_calls'). Checking the bodies
/// recorded each method call with its receiver's type
/// (TypeChecker_record_method_call): here a caller takes on its methods'
/// effects, the bodies are scanned again so that their callers take on
/// those, until nothing changes, and the effect rules are checked again for
/// the effects that were not there before. Nothing is done when no
/// function or method has such a rule.
fn TypeChecker_verify_effects_through_methods(self: &mut TypeChecker, program: Program) {
    if self.method_call_callers.len() == 0 {
        return;
    }
    var rule_funcs: Vec<Func> = Vec::new();
    var rule_keys: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var f: Func = program.funcs.get(fi);
        if tc_has_effect_rule(f) {
            rule_funcs.push(f);
            rule_keys.push(f.name);
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            if tc_has_effect_rule(m) {
                rule_funcs.push(m);
                rule_keys.push(imp.struct_name + "." + m.name);
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    if rule_funcs.len() == 0 {
        return;
    }
    // what the checks before the bodies saw (and reported)
    var before: Vec<Vec<str>> = Vec::new();
    var bi: i64 = 0;
    while bi < rule_keys.len() {
        var bk: str = rule_keys.get(bi);
        var bcur: Vec<str> = TypeChecker_get_func_effects(self, bk);
        before.push(bcur.clone());
        bi = bi + 1;
    }
    var changed: bool = true;
    var rounds: i64 = 0;
    while changed && rounds < 100 {
        changed = false;
        var k: i64 = 0;
        while k < self.method_call_callers.len() {
            var caller: str = self.method_call_callers.get(k);
            var target: str = self.method_call_owners.get(k) + "." + self.method_call_names.get(k);
            var te: Vec<str> = TypeChecker_get_func_effects(self, target);
            if TypeChecker_add_func_effects(self, caller, te) {
                changed = true;
            }
            k = k + 1;
        }
        var f2: i64 = 0;
        while f2 < program.funcs.len() {
            var ff: Func = program.funcs.get(f2);
            if TypeChecker_rescan_effects(self, ff.name, ff.name, ff.params, ff.body) {
                changed = true;
            }
            f2 = f2 + 1;
        }
        var i2: i64 = 0;
        while i2 < program.impls.len() {
            var imp2: ImplDef = program.impls.get(i2);
            var m2: i64 = 0;
            while m2 < imp2.methods.len() {
                var mf: Func = imp2.methods.get(m2);
                if TypeChecker_rescan_effects(self, imp2.struct_name + "." + mf.name, mf.name, mf.params, mf.body) {
                    changed = true;
                }
                m2 = m2 + 1;
            }
            i2 = i2 + 1;
        }
        var t2: i64 = 0;
        while t2 < program.trait_impls.len() {
            var ti2: TraitImpl = program.trait_impls.get(t2);
            var tm2: i64 = 0;
            while tm2 < ti2.methods.len() {
                var tf: Func = ti2.methods.get(tm2);
                if TypeChecker_rescan_effects(self, ti2.type_name + "." + tf.name, tf.name, tf.params, tf.body) {
                    changed = true;
                }
                tm2 = tm2 + 1;
            }
            t2 = t2 + 1;
        }
        rounds = rounds + 1;
    }
    var ri: i64 = 0;
    while ri < rule_funcs.len() {
        var rk: str = rule_keys.get(ri);
        TypeChecker_effect_rules_one(self, rule_funcs.get(ri), rk, TypeChecker_get_func_effects(self, rk), before.get(ri));
        ri = ri + 1;
    }
}

/// BG59: the nodes `node` (a function's name or a method's `Type.method`,
/// as TypeChecker_hm_graph names them) calls: the functions and the
/// `Type::f(..)` its body names, and the methods checking it saw it call on
/// a value (TypeChecker_record_method_call).
fn TypeChecker_rec_callees(self: &TypeChecker, program: &Program, g: &HmGraph, node: str, out: &mut Vec<str>) {
    var code: i64 = HashMap_get(g.index, node);
    if code != 0 {
        var calls: Vec<str> = Vec::new();
        var saved_dot: bool = g_scan_dot_methods;
        g_scan_dot_methods = true;
        scan_stmts_for_calls(hm_body(program, code), &mut calls);
        g_scan_dot_methods = saved_dot;
        var ci: i64 = 0;
        while ci < calls.len() {
            var c: str = calls.get(ci);
            if !str_starts_with(c, ".") {
                var cc: i64 = HashMap_get(g.index, c);
                if cc != 0 {
                    out.push(hm_node_name(program, cc));
                }
            }
            ci = ci + 1;
        }
    }
    var j: i64 = HashMap_get(g.mc_head, node);
    while j != 0 {
        out.push(self.method_call_owners.get(j - 1) + "." + self.method_call_names.get(j - 1));
        j = g.mc_next.get(j - 1);
    }
}

/// BG59: whether `start` can call itself again, its method calls counted.
fn TypeChecker_rec_reaches_self(self: &TypeChecker, program: &Program, g: &HmGraph, start: str) -> bool {
    var queue: Vec<str> = Vec::new();
    TypeChecker_rec_callees(self, program, g, start, &mut queue);
    var seen: i64 = HashMap_new();
    var found: bool = false;
    var at: i64 = 0;
    while at < queue.len() && !found {
        var cur: str = queue.get(at);
        if cur == start {
            found = true;
        } else if HashMap_get(seen, cur) == 0 {
            HashMap_insert(seen, cur, 1);
            TypeChecker_rec_callees(self, program, g, cur, &mut queue);
        }
        at = at + 1;
    }
    HashMap_drop(seen);
    return found;
}

/// Whether an error already reported contains `part`.
fn TypeChecker_errors_mention(self: &TypeChecker, part: str) -> bool {
    var i: i64 = 0;
    while i < self.errors.len() {
        if str_contains(self.errors.get(i), part) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// BG59: @no-recursion and @bounded-stack (also through @medical,
/// @autosar, @safety-critical) through method calls. The check before the
/// bodies (TypeChecker_verify_safety_annotations) builds its call graph from
/// names: `x.walk(n)` is the name `walk`, which is no function, so `count`
/// calling `t.walk(n)` calling `count` was not a cycle (and a method calling
/// itself through `self.m()` was not a self-call: its node is `Tree_walk`).
/// Here the graph has the methods checking the bodies saw each body call
/// (TypeChecker_hm_graph); a function the earlier check already reported
/// is not reported again.
fn TypeChecker_verify_method_recursion(self: &mut TypeChecker, program: Program) {
    if self.method_call_callers.len() == 0 {
        return;
    }
    var nodes: Vec<str> = Vec::new();
    var flats: Vec<str> = Vec::new();
    var kinds: Vec<i64> = Vec::new();
    var fi: i64 = 0;
    while fi < program.funcs.len() {
        var f: Func = program.funcs.get(fi);
        var prims: Vec<str> = expand_safety_primitives(f.annotations);
        var kind: i64 = 0;
        if tc_vec_contains_str(prims, "no-recursion") {
            kind = kind + 1;
        }
        if tc_vec_contains_str(prims, "bounded-stack") {
            kind = kind + 2;
        }
        if kind > 0 {
            nodes.push(f.name);
            flats.push(f.name);
            kinds.push(kind);
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < program.impls.len() {
        var imp: ImplDef = program.impls.get(ii);
        var mi: i64 = 0;
        while mi < imp.methods.len() {
            var m: Func = imp.methods.get(mi);
            var mprims: Vec<str> = expand_safety_primitives(m.annotations);
            var mkind: i64 = 0;
            if tc_vec_contains_str(mprims, "no-recursion") {
                mkind = mkind + 1;
            }
            if tc_vec_contains_str(mprims, "bounded-stack") {
                mkind = mkind + 2;
            }
            if mkind > 0 {
                nodes.push(imp.struct_name + "." + m.name);
                flats.push(imp.struct_name + "_" + m.name);
                kinds.push(mkind);
            }
            mi = mi + 1;
        }
        ii = ii + 1;
    }
    if nodes.len() == 0 {
        return;
    }
    var g: HmGraph = TypeChecker_hm_graph(self, &program);
    var ni: i64 = 0;
    while ni < nodes.len() {
        var node: str = nodes.get(ni);
        var flat: str = flats.get(ni);
        var kind2: i64 = kinds.get(ni);
        if TypeChecker_rec_reaches_self(self, &program, &g, node) {
            if (kind2 == 1 || kind2 == 3) && !TypeChecker_errors_mention(self, "function '" + flat + "' is @no-recursion") && !TypeChecker_errors_mention(self, "function '" + node + "' is @no-recursion") {
                self.errors.push("Safety error (no-recursion): function '" + node + "' is @no-recursion but can call itself again through a method call (`x.m(..)`).\n    Recursion through a method has the same unbounded stack depth as direct\n    recursion.\n    Fix: make one function on the cycle iterative, or remove the @no-recursion annotation.");
            }
            if kind2 >= 2 && !TypeChecker_errors_mention(self, "function '" + flat + "' is @bounded-stack") && !TypeChecker_errors_mention(self, "function '" + node + "' is @bounded-stack") {
                self.errors.push("Safety error (bounded-stack): function '" + node + "' is @bounded-stack but can call itself again through a method call (`x.m(..)`).\n    Its stack depth has no bound: every function it can reach must be\n    non-recursive and called directly.");
            }
        }
        ni = ni + 1;
    }
    HashMap_drop(g.index);
    HashMap_drop(g.mc_head);
}

// --- Bugs roadmap, Nov 22: threads (BG24, BG25, BG26, BG75) ---------------

/// BG24: the branches of `parallel { }` that the race check takes as
/// threads: a name for each (also one of the checker's thread entries), the
/// function the branch is in, and the functions the branch calls. While a
/// branch is checked, g_tc_par_writer is its name: the global writes and
/// method calls in it are the branch's.
var g_tc_par_names: Vec<str> = Vec::new();
var g_tc_par_fns: Vec<str> = Vec::new();
var g_tc_par_calls: Vec<Vec<str>> = Vec::new();
var g_tc_par_writer: str = "";
var g_tc_par_count: i64 = 0;

fn tc_par_reset() {
    g_tc_par_names = Vec::new();
    g_tc_par_fns = Vec::new();
    g_tc_par_calls = Vec::new();
    g_tc_par_writer = "";
}

/// Where `name` is in g_tc_par_names, or -1.
fn tc_par_index(name: str) -> i64 {
    if !str_contains(name, "#parallel") {
        return -1;
    }
    var i: i64 = 0;
    while i < g_tc_par_names.len() {
        if g_tc_par_names.get(i) == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// The name the race check records a global write under: the `parallel`
/// branch being checked, else the function, a method as `Type.method`
/// (BG26: a method was recorded by its bare name, which is a free
/// function's when one has it). The compiler's own modules keep the bare
/// name, as before.
fn TypeChecker_race_writer(self: &TypeChecker) -> str {
    if str_len(g_tc_par_writer) > 0 {
        return g_tc_par_writer;
    }
    if !str_starts_with(self.current_module, "compiler::") {
        match self.current_self_type {
            OptString::Some(st) => {
                return st + "." + self.checking_fn;
            }
            OptString::None => {
            }
        }
    }
    return self.checking_fn;
}

/// BG25: a change of the variable `root` that is not an assignment to it:
/// `G.n = v`, `G.items.push(x)`, `G.bump()` (a method taking `&mut self`).
/// When `root` is a global (no local of that name), it is a write of the
/// global for the race check, as `G = v` is; before, only assignments and
/// `G[i] = v` were recorded. The compiler's own modules are left as they
/// were (their worker threads are checked by the assignments they make).
fn TypeChecker_note_global_change(self: &mut TypeChecker, root: str, line: i64) {
    if str_len(root) == 0 || str_starts_with(self.current_module, "compiler::") || !tc_module_race_checked(self.current_module) {
        return;
    }
    match TypeChecker_lookup(self, root) {
        OptType::Some(_) => {
            return;
        }
        OptType::None => {
        }
    }
    match TypeChecker_lookup_global_cache(self, root) {
        OptType::Some(_) => {
            var w: str = TypeChecker_race_writer(self);
            self.write_funcs.push(w);
            self.write_globals.push(root);
            self.write_lines.push(line);
        }
        OptType::None => {
        }
    }
}

/// BG26: what the race check follows from `name`: the functions its body
/// calls (a free function's, a `parallel` branch's as recorded, a method's
/// `Type.method` body), and the methods checking the bodies saw it call on
/// a value (TypeChecker_record_method_call), but not the compiler's own
/// methods (as before; their writes are recorded by bare name).
fn TypeChecker_race_calls(self: &TypeChecker, program: &Program, fpos: i64, g: &HmGraph, name: str) -> Vec<str> {
    var called: Vec<str> = Vec::new();
    var at: i64 = HashMap_get(fpos, name) - 1;
    if at >= 0 {
        TypeChecker_collect_called_funcs(self, program.funcs.get(at).body, &mut called);
    } else {
        var pk: i64 = tc_par_index(name);
        if pk >= 0 {
            var pcalls: Vec<str> = g_tc_par_calls.get(pk);
            var pi: i64 = 0;
            while pi < pcalls.len() {
                called.push(pcalls.get(pi));
                pi = pi + 1;
            }
        } else {
            var code: i64 = HashMap_get(g.index, name);
            if code < 0 {
                TypeChecker_collect_called_funcs(self, hm_body(program, code), &mut called);
            }
        }
    }
    var j: i64 = HashMap_get(g.mc_head, name);
    while j != 0 {
        var owner: str = self.method_call_owners.get(j - 1);
        var mname: str = self.method_call_names.get(j - 1);
        var own_compiler: bool = false;
        match TypeChecker_get_item_module(self, owner + "_" + mname) {
            OptString::Some(mm) => {
                own_compiler = str_starts_with(mm, "compiler::");
            }
            OptString::None => {
            }
        }
        if !own_compiler {
            called.push(owner + "." + mname);
        }
        j = g.mc_next.get(j - 1);
    }
    return tc_dedupe_strs(called);
}

/// BG24 (and BG75): the variables of the enclosing scopes that `stmts`
/// read, with their types, as TypeChecker_collect_captured_vars finds them
/// in an expression (declared after this point, a name is not found).
fn TypeChecker_collect_captured_stmts(self: &TypeChecker, stmts: Vec<Stmt>, names: &mut Vec<str>, types: &mut Vec<Type>) {
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Let(_, _, e, _, _, _, _) => {
                TypeChecker_collect_captured_vars(self, e, names, types);
            }
            Stmt::LetTuple(_, e, _) => {
                TypeChecker_collect_captured_vars(self, e, names, types);
            }
            Stmt::Expr(e, _) => {
                TypeChecker_collect_captured_vars(self, e, names, types);
            }
            Stmt::Assign(_, _, e, _) => {
                TypeChecker_collect_captured_vars(self, e, names, types);
            }
            Stmt::IndexAssign(_, ix, _, e, _) => {
                TypeChecker_collect_captured_vars(self, ix, names, types);
                TypeChecker_collect_captured_vars(self, e, names, types);
            }
            Stmt::FieldAssign(o, _, _, e, _) => {
                TypeChecker_collect_captured_vars(self, o, names, types);
                TypeChecker_collect_captured_vars(self, e, names, types);
            }
            Stmt::Return(oe, _) => {
                match oe {
                    OptBoxExpr::Some(re) => {
                        TypeChecker_collect_captured_vars(self, box_expr_unbox(re), names, types);
                    }
                    OptBoxExpr::None => {
                    }
                }
            }
            Stmt::If(c, tb, eb, _) => {
                TypeChecker_collect_captured_vars(self, c, names, types);
                TypeChecker_collect_captured_stmts(self, tb, names, types);
                match eb {
                    OptStmts::Some(eb2) => {
                        TypeChecker_collect_captured_stmts(self, eb2, names, types);
                    }
                    OptStmts::None => {
                    }
                }
            }
            Stmt::While(c, b, _) => {
                TypeChecker_collect_captured_vars(self, c, names, types);
                TypeChecker_collect_captured_stmts(self, b, names, types);
            }
            Stmt::For(_, iter_e, b, _) => {
                TypeChecker_collect_captured_vars(self, iter_e, names, types);
                TypeChecker_collect_captured_stmts(self, b, names, types);
            }
            Stmt::Loop(b, _) => {
                TypeChecker_collect_captured_stmts(self, b, names, types);
            }
            Stmt::Match(e, arms, _) => {
                TypeChecker_collect_captured_vars(self, e, names, types);
                var ai: i64 = 0;
                while ai < arms.len() {
                    TypeChecker_collect_captured_stmts(self, arms.get(ai).body, names, types);
                    ai = ai + 1;
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
}

/// BG24: start checking one branch of `parallel { }`. The branches run on
/// threads of their own (lower.fd Lowerer_lift_parallel_branch), and were
/// checked as code of the enclosing function: a branch writing a global
/// with no lock, or calling a function that does, was not a race, and a
/// variable it reads was not held to @send, as for `spawn`. Here what the
/// branch reads of the enclosing scopes must be @send, and the branch is a
/// thread entry of the race check under a name of its own (its writes and
/// method calls are recorded under it while it is checked). Returns the
/// writer to restore after the branch.
fn TypeChecker_par_begin(self: &mut TypeChecker, branch: Vec<Stmt>) -> str {
    var saved: str = g_tc_par_writer;
    var cap_names: Vec<str> = Vec::new();
    var cap_types: Vec<Type> = Vec::new();
    TypeChecker_collect_captured_stmts(self, branch, &mut cap_names, &mut cap_types);
    var ci: i64 = 0;
    while ci < cap_names.len() {
        if !TypeChecker_is_send_type(self, cap_types.get(ci)) {
            self.errors.push("Thread safety error (line " + int_to_str(self.current_line) + "): a branch of `parallel { }` uses '" + cap_names.get(ci) + "' of type " + type_to_str(cap_types.get(ci)) + ", which is not @send: each branch runs on a thread of its own.\n    Fix: give the branch values (numbers, strings, @send structs), or share through a Mutex or a Channel.");
        }
        ci = ci + 1;
    }
    if str_starts_with(self.current_module, "compiler::") || !tc_module_race_checked(self.current_module) {
        return saved;
    }
    g_tc_par_count = g_tc_par_count + 1;
    var outer: str = TypeChecker_race_writer(self);
    var name: str = outer + "#parallel" + int_to_str(g_tc_par_count);
    var calls: Vec<str> = Vec::new();
    TypeChecker_collect_called_funcs(self, branch, &mut calls);
    var shown: str = outer;
    var po: i64 = tc_par_index(outer);
    if po >= 0 {
        shown = g_tc_par_fns.get(po);
    }
    g_tc_par_names.push(name);
    g_tc_par_fns.push(shown);
    g_tc_par_calls.push(calls);
    self.thread_entries.push(name);
    g_tc_par_writer = name;
    return saved;
}

/// BG75: a closure given to a spawned call (`spawn work(|x| x + n)`)
/// shares what it captures with the thread that runs it: its captures are
/// not copied as the call's other arguments are. A capture must be @send
/// and hold no owner count (a string, Vec, HashMap or Box: two threads
/// would change the count without a lock).
fn TypeChecker_check_spawn_closure(self: &mut TypeChecker, arg: Expr, ai: i64) {
    match arg {
        Expr::Closure(params, body, _) => {
            var names: Vec<str> = Vec::new();
            var types: Vec<Type> = Vec::new();
            TypeChecker_collect_captured_stmts(self, body, &mut names, &mut types);
            var i: i64 = 0;
            while i < names.len() {
                var is_param: bool = false;
                var pk: i64 = 0;
                while pk < params.len() {
                    if params.get(pk).name == names.get(i) {
                        is_param = true;
                    }
                    pk = pk + 1;
                }
                if !is_param {
                    var t: Type = types.get(i);
                    var why: str = "";
                    if !TypeChecker_is_send_type(self, t) {
                        why = "it is not @send";
                    } else if TypeChecker_has_owned(self, t, 0) {
                        why = "the closure and the new thread would share its owner count";
                    }
                    if why != "" {
                        self.errors.push("Thread safety error (line " + int_to_str(self.current_line) + "): argument " + int_to_str(ai + 1) + " of the spawned call is a closure that captures '" + names.get(i) + "' of type " + type_to_str(t) + ": " + why + ".\n    A closure's captures are shared with the thread that runs it, not copied.\n    Fix: pass the value as an argument of the spawned call (it is copied for the thread), or send it over a Channel.");
                    }
                }
                i = i + 1;
            }
        }
        _ => {
        }
    }
}

// --- Bugs roadmap, Nov 22: `?` (BG23), comparisons (BG60), indexing
// (BG112) -------------------------------------------------------------------

/// A type that says nothing to compare with yet (unknown, an error already
/// reported, a function value or trait object).
fn tc_type_unknown_here(t: Type) -> bool {
    match t {
        Type::Infer => {
            return true;
        }
        Type::Never => {
            return true;
        }
        Type::Assoc(_, _, _, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// BG23: `e?` with e a Result<T, E1> in a function returning Result<U, E2>
/// returns e's error as the function's: the lowering copies the payload
/// word as it is (lower.fd Lowerer_lower_try_expr). With E1 not an E2 the
/// caller read it as the wrong type: `g()?` with g: Result<i64, i64> in a
/// Result<i64, str> function gave the caller a str whose address was the
/// number. The two error types must fit (as an assignment checks them); a
/// type parameter, an unknown type and a `try { }` block (which takes any
/// error) are not checked.
fn TypeChecker_check_try_error_type(self: &mut TypeChecker, ty: Type) {
    if g_tc_try_depth > 0 {
        return;
    }
    var from_err: Type = Type::Infer;
    match TypeChecker_resolve_type(self, ty) {
        Type::Generic(n, a) => {
            if n == "Result" && a.len() == 2 {
                from_err = a.get(1);
            }
        }
        _ => {
        }
    }
    if tc_type_unknown_here(from_err) {
        return;
    }
    var to_err: Type = Type::Infer;
    match self.current_ret_ty {
        OptType::Some(rt0) => {
            match TypeChecker_resolve_type(self, TypeChecker_resolve_self_type(self, rt0)) {
                Type::Generic(rn, ra) => {
                    if rn == "Result" && ra.len() == 2 {
                        to_err = ra.get(1);
                    }
                }
                _ => {
                }
            }
        }
        OptType::None => {
        }
    }
    if tc_type_unknown_here(to_err) {
        return;
    }
    var fe: Type = TypeChecker_resolve_type(self, from_err);
    var te: Type = TypeChecker_resolve_type(self, to_err);
    if TypeChecker_type_contains_param(self, fe) || TypeChecker_type_contains_param(self, te) {
        return;
    }
    if TypeChecker_types_compatible(self, te, fe) || (is_runtime_layer(self.current_module) && is_handle_int_pair(te, fe)) {
        return;
    }
    var fname: str = "this function";
    match self.current_func_name {
        OptString::Some(cfn) => {
            fname = "'" + cfn + "'";
        }
        OptString::None => {
        }
    }
    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): the ? operator passes on the error of a Result<_, " + type_to_str(fe) + ">, but " + fname + " returns Result<_, " + type_to_str(te) + ">: the error types differ.\n    `?` returns the error as it is; it does not convert it.\n    Fix: convert the error first (match, or .map_err), or change the function's error type.");
}

/// The text of a comparison operator.
fn tc_cmp_text(op: BinOp) -> str {
    if binop_eq(op, BinOp::Eq) {
        return "==";
    }
    if binop_eq(op, BinOp::Neq) {
        return "!=";
    }
    return tc_cmp_symbol(op);
}

/// Whether `op` compares (== != < > <= >=).
fn tc_is_cmp_op(op: BinOp) -> bool {
    return binop_eq(op, BinOp::Eq) || binop_eq(op, BinOp::Neq) || binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq);
}

/// The struct or enum a comparison operand is (through a reference), or ""
/// for anything else (numbers, strings, Vec, HashMap, String, unknown).
fn tc_cmp_user_type(self: &TypeChecker, t: Type) -> str {
    var n: str = "";
    match t {
        Type::Named(nn) => {
            n = nn;
        }
        Type::Generic(gn, _) => {
            n = gn;
        }
        Type::Ref(inner, _) => {
            return tc_cmp_user_type(self, box_type_unbox(inner));
        }
        _ => {
        }
    }
    if n == "" || n == "Vec" || n == "HashMap" || n == "String" {
        return "";
    }
    if tc_is_struct(self, n) || TypeChecker_is_known_enum(self, n) {
        return n;
    }
    return "";
}

/// BG60: a comparison's operands (`lt`, `rt` resolved; `left` the left
/// operand) beyond the str-with-number rule: `a < b < c` (parsed as
/// `(a < b) < c`: a bool ordered against c, always true or always false),
/// ordering bools at all, a bool compared with a str, and two different
/// structs or enums. Before, only a str compared with a number was an
/// error. The runtime layer and the compiler's own modules are left as
/// they were. True when it reported an error.
/// BG60: a bare literal is not a type mismatch — it takes the other
/// operand's type (a checked fit), as `x & 0xFF` does for `&`.
fn tc_cmp_is_literal(e: Expr) -> bool {
    match e {
        Expr::IntLit(_) => {
            return true;
        }
        Expr::FloatLit(_) => {
            return true;
        }
        Expr::Unary(uop, uinner) => {
            match uop {
                UnaryOp::Neg => {
                    return tc_cmp_is_literal(box_expr_unbox(uinner));
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// BG60: whether literal `e` can stand for a value of type `t` in a
/// comparison: an int literal into an int type must fit it (tc_literal_fits);
/// an int literal into a float type converts; a float literal pairs only
/// with a float.
fn tc_cmp_lit_fits(e: Expr, t: Type) -> bool {
    var neg: bool = false;
    var x: Expr = e;
    match e {
        Expr::Unary(uop, uinner) => {
            match uop {
                UnaryOp::Neg => {
                    neg = true;
                    x = box_expr_unbox(uinner);
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    match x {
        Expr::IntLit(v) => {
            var b: i64 = tc_int_bits(t);
            if b > 0 {
                return tc_literal_fits(v, neg, b, tc_int_signed(t));
            }
            return type_eq(t, Type::F32) || type_eq(t, Type::F64);
        }
        Expr::FloatLit(_) => {
            return type_eq(t, Type::F32) || type_eq(t, Type::F64);
        }
        _ => {
        }
    }
    return false;
}

// An expression made only of numeric literals (and unary minus): its parts
// can still infer to whatever integer/float type a comparison's other side
// has, so that side is checked first and gives them its type as the hint.
fn tc_expr_all_num_lits(e: Expr) -> bool {
    match e {
        Expr::IntLit(_) => {
            return true;
        }
        Expr::FloatLit(_) => {
            return true;
        }
        Expr::Unary(uop, inner) => {
            match uop {
                UnaryOp::Neg => {
                    return tc_expr_all_num_lits(box_expr_unbox(inner));
                }
                _ => {
                    return false;
                }
            }
        }
        Expr::Binary(_, l, r) => {
            return tc_expr_all_num_lits(box_expr_unbox(l)) && tc_expr_all_num_lits(box_expr_unbox(r));
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn TypeChecker_check_comparison(self: &mut TypeChecker, op: BinOp, left: Expr, right: Expr, lt: Type, rt: Type) -> bool {
    if is_runtime_layer(self.current_module) || str_starts_with(self.current_module, "compiler") {
        return false;
    }
    val ordering: bool = binop_eq(op, BinOp::Lt) || binop_eq(op, BinOp::Gt) || binop_eq(op, BinOp::LtEq) || binop_eq(op, BinOp::GtEq);
    var sym: str = tc_cmp_text(op);
    if ordering {
        match left {
            Expr::Binary(lop, _, _) => {
                if tc_is_cmp_op(lop) {
                    var lsym: str = tc_cmp_text(lop);
                    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): comparisons do not chain: `a " + lsym + " b " + sym + " c` is `(a " + lsym + " b) " + sym + " c`, which orders the bool `a " + lsym + " b` against c.\n    Fix: write `a " + lsym + " b && b " + sym + " c`.");
                    return true;
                }
            }
            _ => {
            }
        }
        if type_eq(lt, Type::Bool) || type_eq(rt, Type::Bool) {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): `" + sym + "` orders numbers and strings, not bools (" + type_to_str(lt) + " with " + type_to_str(rt) + ").");
            return true;
        }
    }
    if (type_eq(lt, Type::Bool) && type_eq(rt, Type::Str)) || (type_eq(lt, Type::Str) && type_eq(rt, Type::Bool)) {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): cannot compare " + type_to_str(lt) + " with " + type_to_str(rt) + " (`" + sym + "` takes two values of one type).");
        return true;
    }
    var ln: str = tc_cmp_user_type(self, lt);
    var rn: str = tc_cmp_user_type(self, rt);
    if ln != "" && rn != "" && ln != rn {
        self.errors.push("Type error (line " + int_to_str(self.current_line) + "): cannot compare " + ln + " with " + rn + " (`" + sym + "` takes two values of one type).");
        return true;
    }
    // BG60: numbers of different types — `i64 < f64` orders an int's bits
    // against a float's, `u8 == i64` widens one side silently. A bare
    // literal adapts to the other side's type, so it is no mismatch — one
    // that cannot fit it still is.
    var ltr: Type = TypeChecker_resolve_type(self, lt);
    var rtr: Type = TypeChecker_resolve_type(self, rt);
    if TypeChecker_is_numeric(self, ltr) && TypeChecker_is_numeric(self, rtr) && !type_eq(ltr, rtr) {
        var lit_ok: bool = false;
        if tc_cmp_is_literal(left) && tc_cmp_lit_fits(left, rtr) {
            lit_ok = true;
        }
        if tc_cmp_is_literal(right) && tc_cmp_lit_fits(right, ltr) {
            lit_ok = true;
        }
        if !lit_ok {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): cannot compare " + type_to_str(lt) + " with " + type_to_str(rt) + " (`" + sym + "` takes two values of one type).\n    Fix: convert one side with `as` so both have the same type.");
            return true;
        }
    }
    // A literal that took the other side's type as its hint still must fit
    // it: `x: u8 == 300` types the 300 u8 but 300 is no u8.
    if TypeChecker_is_numeric(self, ltr) && type_eq(ltr, rtr) {
        var bad_lit: bool = false;
        if tc_cmp_is_literal(right) && !tc_cmp_lit_fits(right, ltr) {
            bad_lit = true;
        }
        if tc_cmp_is_literal(left) && !tc_cmp_lit_fits(left, ltr) {
            bad_lit = true;
        }
        if bad_lit {
            self.errors.push("Type error (line " + int_to_str(self.current_line) + "): the literal does not fit in " + type_to_str(ltr) + ".");
            return true;
        }
    }
    return false;
}

/// BG112: `x[i]` where x is neither a Vec, an array nor a String (those
/// return before this): a HashMap, a struct, an enum or a type parameter.
/// The read gave the type `never` and no error, while the lowering emitted
/// a load from x's word plus the index; the write side (BG1,
/// TypeChecker_check_index_assign) already rejects them. A type alias of a
/// Vec or an array, an opaque runtime type and an unknown type are left as
/// they were.
fn TypeChecker_check_index_read_other(self: &mut TypeChecker, arr_ty: Type) {
    var t: Type = TypeChecker_resolve_type(self, arr_ty);
    var n: str = "";
    match t {
        Type::Named(nn) => {
            n = nn;
        }
        Type::Generic(gn, _) => {
            n = gn;
        }
        _ => {
            return;
        }
    }
    if n == "Vec" || n == "String" {
        return;
    }
    var bad: bool = n == "HashMap" || tc_is_struct(self, n) || TypeChecker_is_known_enum(self, n) || tc_str_vec_contains(self.current_type_params, n);
    if !bad {
        return;
    }
    var hint: str = "";
    if n == "HashMap" {
        hint = "\n    Fix: read a map with .get(key) (or .get_or(key, default)).";
    }
    self.errors.push("Type error (line " + int_to_str(self.current_line) + "): cannot index type " + type_to_str(arr_ty) + ": only a Vec, an array or a String can be indexed with `[..]`." + hint);
}

// ---- END ----
