            // stdlib/money.fd's operations, so that each of them can be
            // checked to keep the total. Reading `m.cents` of a Money held
            // by value would also consume it (linear) and so destroy it.
            if self.in_conserve && field == "cents" && !TypeChecker_in_money_module(self, self.checking_fn) {
                match effective_ty {
                    Type::Named(mname) => {
                        if mname == "Money" || str_ends_with(mname, "::Money") {
                            self.errors.push("Conservation error: function '" + self.checking_fn + "' is @conserve but reads or changes the amount of a Money directly ('.cents')." + "
    Changing it creates or destroys money; reading it from a Money held by value consumes, and so destroys, that Money." + "
    Fix: read it with Money_cents(&m), move part of it with Money_take(&mut m, cents), or remove @conserve.");
                        }
                    }
                    _ => {
                    }
                }
            }
