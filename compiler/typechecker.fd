// typechecker.fd -- Fides typechecker, rewritten from src/typechecker.rs (7424 LOC)
//
// This is the largest compiler module. It handles:
// - Type inference and checking (check_expr, check_stmt)
// - Region checking (use-after-free, budget enforcement)
// - Effect checking (declared vs inferred effects)
// - Capability checking (sandbox, strict caps)
// - Safety annotation verification (@deterministic, @crashfree, @gas, etc.)
// - Trait resolution and impl verification
// - Generic instantiation and type parameter bounds
// - Linear type checking (@linear structs must be consumed)
// - @send/@sync checks for thread safety
//
// Adaptations from Rust:
// 1. HashMap<K,V> -> Vec-based maps with helper structs (Fides HashMap is i64->i64)
// 2. HashSet<T> -> Vec<T> with contains() helper
// 3. String -> str, usize/u32/u64 -> i64
// 4. Option<T> -> Opt* enums
// 5. Box<Type>/Box<Expr> -> box_* helper functions for recursive calls
// 6. &mut self methods -> self: &mut TypeChecker
// 7. format! -> string concatenation with int_to_str/type_to_str
// 8. .clone() -> not needed (Fides values are copied by value)
// 9. matches! macro -> explicit match with _ => false
//
// Dependencies: compiler::ast, compiler::ir

module compiler::typechecker;

use core;
use vec;
use string;
use compiler::ast;
use compiler::escape;

// --- Box unbox helpers ---------------------------------------------------
// box_type_unbox / box_expr_unbox / stmt_line are provided by compiler::ast
// (pub). They used to be duplicated here; the duplicates were removed so that
// importing compiler::ast and compiler::typechecker together does not trigger
// the bootstrap compiler's duplicate-definition check.

// --- Helper map/set types ------------------------------------------------
// Fides HashMap is i64->i64 only, so we use Vec-based storage with lookup helpers.

