// mono.fd — Monomorphization for the Fides compiler
// Rewritten from src/mono.rs (1475 LOC Rust)
//
// Monomorphization clones generic functions for each concrete type
// instantiation, resolves const generics, and handles trait dispatch.
//
// Adaptations from Rust:
// 1. HashMap<K,V> → Vec-based maps with helper structs (Fides HashMap is i64→i64)
// 2. HashSet<T> → Vec<T> with contains() helper
// 3. Box<Type>/Box<Expr> → box_* helper functions for recursive calls
// 4. Option::map/and_then → explicit match patterns
// 5. Vec::iter().map().collect() → explicit while loops with Vec::push
// 6. &str → str, String → str, usize → i64

module compiler::mono;

use core;
use vec;
use string;
use compiler::ast;

// ─── Re-declared Opt enums (Fides doesn't import enums from other modules) ─

pub enum OptType {
    Some(Type),
    None,
}

pub enum OptStr {
    Some(str),
    None,
}

// ─── Substitution map types ──────────────────────────────────────────────
// Rust: type Subst = HashMap<String, Type>
// Fides: Vec<SubstEntry> with linear search helpers

pub struct SubstEntry {
    pub key: str,
    pub val: Type,
}

pub fn SubstEntry_new(key: str, val: Type) -> SubstEntry {
    return SubstEntry { key: key, val: val };
}

pub fn subst_get(map: Vec<SubstEntry>, key: str) -> OptType {
    // Return the last match (supports overwrite via push)
    var result: OptType = OptType::None;
    var i: i64 = 0;
    while i < map.len() {
        if str_equal(map.get(i).key, key) {
            result = OptType::Some(map.get(i).val);
        }
        i = i + 1;
    }
    return result;
}

pub fn subst_set(map: &mut Vec<SubstEntry>, key: str, val: Type) {
    // Fides Vec::get returns a copy, so we can't mutate in place.
    // Just push — subst_get returns the last match.
    map.push(SubstEntry_new(key, val));
}

pub fn subst_contains(map: Vec<SubstEntry>, key: str) -> bool {
    var i: i64 = 0;
    while i < map.len() {
        if str_equal(map.get(i).key, key) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn subst_new() -> Vec<SubstEntry> {
    return Vec::new();
}

// ─── String set helpers (replaces HashSet<String>) ───────────────────────

pub fn str_vec_contains(vec: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < vec.len() {
        if str_equal(vec.get(i), s) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ─── Trait assoc binding map ─────────────────────────────────────────────
// Rust: HashMap<(String, String), HashMap<String, Type>>
// Fides: Vec<TraitAssocEntry> where each entry has (trait_name, type_name, assoc_map)

pub struct AssocBindingEntry {
    pub assoc_name: str,
    pub ty: Type,
}

pub fn AssocBindingEntry_new(assoc_name: str, ty: Type) -> AssocBindingEntry {
    return AssocBindingEntry { assoc_name: assoc_name, ty: ty };
}

pub struct TraitAssocEntry {
    pub trait_name: str,
    pub type_name: str,
    pub bindings: Vec<AssocBindingEntry>,
}

pub fn TraitAssocEntry_new(trait_name: str, type_name: str) -> TraitAssocEntry {
    return TraitAssocEntry {
        trait_name: trait_name,
        type_name: type_name,
        bindings: Vec::new(),
    };
}

pub enum OptVecAssocBinding {
    Some(Vec<AssocBindingEntry>),
    None,
}

pub fn trait_assoc_get(map: Vec<TraitAssocEntry>, trait_name: str, type_name: str) -> OptVecAssocBinding {
    var i: i64 = 0;
    while i < map.len() {
        var entry: TraitAssocEntry = map.get(i);
        if str_equal(entry.trait_name, trait_name) && str_equal(entry.type_name, type_name) {
            return OptVecAssocBinding::Some(entry.bindings);
        }
        i = i + 1;
    }
    return OptVecAssocBinding::None;
}

pub fn trait_assoc_get_by_type(map: Vec<TraitAssocEntry>, type_name: str) -> OptVecAssocBinding {
    var i: i64 = 0;
    while i < map.len() {
        var entry: TraitAssocEntry = map.get(i);
        if str_equal(entry.type_name, type_name) {
            return OptVecAssocBinding::Some(entry.bindings);
        }
        i = i + 1;
    }
    return OptVecAssocBinding::None;
}

pub fn assoc_bindings_get(bindings: Vec<AssocBindingEntry>, name: str) -> OptType {
    var i: i64 = 0;
    while i < bindings.len() {
        if str_equal(bindings.get(i).assoc_name, name) {
            return OptType::Some(bindings.get(i).ty);
        }
        i = i + 1;
    }
    return OptType::None;
}

// ─── Generic function info ───────────────────────────────────────────────
// Rust: HashMap<String, (Func, Vec<String>)>
// Fides: Vec<GenericFuncEntry>

pub struct GenericFuncEntry {
    pub name: str,
    pub func: Func,
    pub type_params: Vec<str>,
}

pub fn GenericFuncEntry_new(name: str, func: Func, type_params: Vec<str>) -> GenericFuncEntry {
    return GenericFuncEntry {
        name: name,
        func: func,
        type_params: type_params,
    };
}

pub enum OptGenericFunc {
    Some(GenericFuncEntry),
    None,
}

pub fn generic_funcs_get(map: Vec<GenericFuncEntry>, name: str) -> OptGenericFunc {
    var i: i64 = 0;
    while i < map.len() {
        if str_equal(map.get(i).name, name) {
            return OptGenericFunc::Some(map.get(i));
        }
        i = i + 1;
    }
    return OptGenericFunc::None;
}

pub fn generic_funcs_contains(map: Vec<GenericFuncEntry>, name: str) -> bool {
    var i: i64 = 0;
    while i < map.len() {
        if str_equal(map.get(i).name, name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ─── Generic method info ─────────────────────────────────────────────────
// Rust: HashMap<(String, String), (Func, Vec<String>)>
// Fides: Vec<GenericMethodEntry>

pub struct GenericMethodEntry {
    pub struct_name: str,
    pub method_name: str,
    pub func: Func,
    pub type_params: Vec<str>,
}

pub fn GenericMethodEntry_new(struct_name: str, method_name: str, func: Func, type_params: Vec<str>) -> GenericMethodEntry {
    return GenericMethodEntry {
        struct_name: struct_name,
        method_name: method_name,
        func: func,
        type_params: type_params,
    };
}

pub enum OptGenericMethod {
    Some(GenericMethodEntry),
    None,
}

pub fn generic_methods_get(map: Vec<GenericMethodEntry>, struct_name: str, method_name: str) -> OptGenericMethod {
    var i: i64 = 0;
    while i < map.len() {
        var entry: GenericMethodEntry = map.get(i);
        if str_equal(entry.struct_name, struct_name) && str_equal(entry.method_name, method_name) {
            return OptGenericMethod::Some(entry);
        }
        i = i + 1;
    }
    return OptGenericMethod::None;
}

pub fn generic_methods_contains(map: Vec<GenericMethodEntry>, struct_name: str, method_name: str) -> bool {
    var i: i64 = 0;
    while i < map.len() {
        var entry: GenericMethodEntry = map.get(i);
        if str_equal(entry.struct_name, struct_name) && str_equal(entry.method_name, method_name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ─── Rename maps ─────────────────────────────────────────────────────────
// Rust: HashMap<String, String>
// Fides: Vec<RenameEntry>

pub struct RenameEntry {
    pub from: str,
    pub to: str,
}

pub fn RenameEntry_new(from: str, to: str) -> RenameEntry {
    return RenameEntry { from: from, to: to };
}

pub fn rename_get(map: Vec<RenameEntry>, key: str) -> OptStr {
    // Return the last match (supports overwrite via push)
    var result: OptStr = OptStr::None;
    var i: i64 = 0;
    while i < map.len() {
        if str_equal(map.get(i).from, key) {
            result = OptStr::Some(map.get(i).to);
        }
        i = i + 1;
    }
    return result;
}

pub fn rename_set(map: &mut Vec<RenameEntry>, from: str, to: str) {
    // Fides Vec::get returns a copy, so we can't mutate in place.
    // Just push — rename_get returns the last match.
    map.push(RenameEntry_new(from, to));
}

pub fn rename_new() -> Vec<RenameEntry> {
    return Vec::new();
}

// ─── Call collection types ───────────────────────────────────────────────
// Rust: Vec<(String, Vec<Type>)> for generic calls
// Fides: Vec<GenericCallEntry>

pub struct GenericCallEntry {
    pub callee: str,
    pub arg_types: Vec<Type>,
}

pub fn GenericCallEntry_new(callee: str, arg_types: Vec<Type>) -> GenericCallEntry {
    return GenericCallEntry { callee: callee, arg_types: arg_types };
}

// Rust: Vec<(String, String, Vec<Type>)> for generic method calls
// Fides: Vec<GenericMethodCallEntry>

pub struct GenericMethodCallEntry {
    pub struct_name: str,
    pub method_name: str,
    pub arg_types: Vec<Type>,
}

pub fn GenericMethodCallEntry_new(struct_name: str, method_name: str, arg_types: Vec<Type>) -> GenericMethodCallEntry {
    return GenericMethodCallEntry {
        struct_name: struct_name,
        method_name: method_name,
        arg_types: arg_types,
    };
}

// ─── Mangled name for a monomorphized function: name__T1_T2 ──────────────

pub fn mangle(name: str, subst: Vec<SubstEntry>, type_params: Vec<str>) -> str {
    var type_strs: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < type_params.len() {
        var tp: str = type_params.get(i);
        var ty: Type = Type::Named(tp);
        // Inline lookup to avoid potential parameter passing issues
        var j: i64 = 0;
        while j < subst.len() {
            if str_equal(subst.get(j).key, tp) {
                ty = subst.get(j).val;
            }
            j = j + 1;
        }
        type_strs.push(mangle_type(ty));
        i = i + 1;
    }
    return name + "__" + str_join(type_strs, "_");
}

/// Mangled name for a monomorphized generic method: StructName__methodName__T1_T2
pub fn mangle_method(struct_name: str, method_name: str, subst: Vec<SubstEntry>, type_params: Vec<str>) -> str {
    var type_strs: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < type_params.len() {
        var tp: str = type_params.get(i);
        var ty: Type = Type::Named(tp);
        var j: i64 = 0;
        while j < subst.len() {
            if str_equal(subst.get(j).key, tp) {
                ty = subst.get(j).val;
            }
            j = j + 1;
        }
        type_strs.push(mangle_type(ty));
        i = i + 1;
    }
    return struct_name + "__" + method_name + "__" + str_join(type_strs, "_");
}

// ─── str_join helper (joins Vec<str> with separator) ─────────────────────

fn str_join(parts: Vec<str>, sep: str) -> str {
    if parts.len() == 0 { return ""; }
    var result: str = parts.get(0);
    var i: i64 = 1;
    while i < parts.len() {
        result = result + sep + parts.get(i);
        i = i + 1;
    }
    return result;
}

// ─── Short type name for mangling ────────────────────────────────────────

pub fn mangle_type(ty: Type) -> str {
    match ty {
        Type::I8 => { return "i8"; }
        Type::I16 => { return "i16"; }
        Type::I32 => { return "i32"; }
        Type::I64 => { return "i64"; }
        Type::I128 => { return "i128"; }
        Type::U8 => { return "u8"; }
        Type::U16 => { return "u16"; }
        Type::U32 => { return "u32"; }
        Type::U64 => { return "u64"; }
        Type::U128 => { return "u128"; }
        Type::F32 => { return "f32"; }
        Type::F64 => { return "f64"; }
        Type::Bool => { return "bool"; }
        Type::Str => { return "str"; }
        Type::Void => { return "void"; }
        Type::Never => { return "never"; }
        Type::Infer => { return "infer"; }
        Type::Named(s) => { return s; }
        Type::Generic(name, args) => {
            var args_str: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                args_str.push(mangle_type(args.get(i)));
                i = i + 1;
            }
            return name + "__" + str_join(args_str, "_");
        }
        Type::Ref(inner, is_mut) => {
            var mut_str: str = "const";
            if is_mut { mut_str = "mut"; }
            return "ref_" + mut_str + "_" + mangle_type(box_type_deref(inner));
        }
        Type::RawPtr(inner, is_mut) => {
            var mut_str: str = "const";
            if is_mut { mut_str = "mut"; }
            return "rawptr_" + mut_str + "_" + mangle_type(box_type_deref(inner));
        }
        Type::Array(elem, _) => {
            return "arr_" + mangle_type(box_type_deref(elem));
        }
        Type::ArrayConst(elem, size_param) => {
            return "arrc_" + mangle_type(box_type_deref(elem)) + "_" + size_param;
        }
        Type::Tuple(types) => {
            var parts: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                parts.push(mangle_type(types.get(i)));
                i = i + 1;
            }
            return "tup_" + str_join(parts, "_");
        }
        Type::Func(params, ret) => {
            var p: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < params.len() {
                p.push(mangle_type(params.get(i)));
                i = i + 1;
            }
            return "fn_" + str_join(p, "_") + "_" + mangle_type(box_type_deref(ret));
        }
        Type::Assoc(_, trait_name, name, _) => {
            return "assoc_" + trait_name + "_" + name;
        }
        Type::Dyn(name) => {
            return "dyn_" + name;
        }
        Type::ShapedTensor(elem, shape) => {
            var shape_str: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < shape.len() {
                match shape.get(i) {
                    ShapeDim::Known(n) => { shape_str.push(int_to_str(n)); }
                    ShapeDim::Symbolic(s) => { shape_str.push(s); }
                }
                i = i + 1;
            }
            return "tensor_" + mangle_type(box_type_deref(elem)) + "_" + str_join(shape_str, "_");
        }
    }
    return "unknown";
}

// ─── Box<Type> deref helper ──────────────────────────────────────────────

fn box_type_deref(b: Box<Type>) -> Type {
    match b {
        Type::I8 => { return Type::I8; }
        Type::I16 => { return Type::I16; }
        Type::I32 => { return Type::I32; }
        Type::I64 => { return Type::I64; }
        Type::I128 => { return Type::I128; }
        Type::U8 => { return Type::U8; }
        Type::U16 => { return Type::U16; }
        Type::U32 => { return Type::U32; }
        Type::U64 => { return Type::U64; }
        Type::U128 => { return Type::U128; }
        Type::F32 => { return Type::F32; }
        Type::F64 => { return Type::F64; }
        Type::Bool => { return Type::Bool; }
        Type::Str => { return Type::Str; }
        Type::Void => { return Type::Void; }
        Type::Never => { return Type::Never; }
        Type::Infer => { return Type::Infer; }
        Type::Named(n) => { return Type::Named(n); }
        Type::Array(e, s) => { return Type::Array(e, s); }
        Type::ArrayConst(e, s) => { return Type::ArrayConst(e, s); }
        Type::Ref(e, m) => { return Type::Ref(e, m); }
        Type::RawPtr(e, m) => { return Type::RawPtr(e, m); }
        Type::Generic(n, a) => { return Type::Generic(n, a); }
        Type::Tuple(a) => { return Type::Tuple(a); }
        Type::Func(a, r) => { return Type::Func(a, r); }
        Type::Assoc(a, b2, c, d) => { return Type::Assoc(a, b2, c, d); }
        Type::Dyn(n) => { return Type::Dyn(n); }
        Type::ShapedTensor(e, d) => { return Type::ShapedTensor(e, d); }
    }
    return Type::Void;
}

// ─── Apply a substitution to a type ──────────────────────────────────────

pub fn subst_type(ty: Type, subst: Vec<SubstEntry>) -> Type {
    match ty {
        Type::Named(name) => {
            match subst_get(subst, name) {
                OptType::Some(replacement) => { return replacement; }
                OptType::None => { return ty; }
            }
            return ty;
        }
        Type::Array(elem, size) => {
            return Type::Array(box_type_new(subst_type(box_type_deref(elem), subst)), size);
        }
        Type::ArrayConst(elem, size_param) => {
            // If the const param is in the substitution, resolve it to a concrete size
            match subst_get(subst, size_param) {
                OptType::Some(replacement) => {
                    match replacement {
                        Type::Named(name) => {
                            // Check for __const_ prefix
                            if str_starts_with(name, "__const_") {
                                var size_str: str = str_slice(name, 8, str_len(name));
                                var size: i64 = str_parse_int(size_str);
                                if size >= 0 {
                                    return Type::Array(box_type_new(subst_type(box_type_deref(elem), subst)), size);
                                }
                            }
                        }
                        _ => {}
                    }
                }
                OptType::None => {}
            }
            return Type::ArrayConst(box_type_new(subst_type(box_type_deref(elem), subst)), size_param);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(box_type_new(subst_type(box_type_deref(inner), subst)), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(box_type_new(subst_type(box_type_deref(inner), subst)), is_mut);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(subst_type(args.get(i), subst));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(subst_type(types.get(i), subst));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        Type::Func(params, ret) => {
            var new_params: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < params.len() {
                new_params.push(subst_type(params.get(i), subst));
                i = i + 1;
            }
            return Type::Func(new_params, box_type_new(subst_type(box_type_deref(ret), subst)));
        }
        _ => { return ty; }
    }
    return ty;
}

// ─── Box<Type> constructor helper ────────────────────────────────────────

fn box_type_new(ty: Type) -> Box<Type> {
    return Box::new(ty);
}

// ─── Box<Expr> constructor/deref helpers ─────────────────────────────────

fn box_expr_new(e: Expr) -> Box<Expr> {
    return Box::new(e);
}

fn box_expr_deref(b: Box<Expr>) -> Expr {
    match b {
        Expr::IntLit(v) => { return Expr::IntLit(v); }
        Expr::FloatLit(v) => { return Expr::FloatLit(v); }
        Expr::StringLit(v) => { return Expr::StringLit(v); }
        Expr::BoolLit(v) => { return Expr::BoolLit(v); }
        Expr::Ident(n) => { return Expr::Ident(n); }
        Expr::Binary(op, l, r) => { return Expr::Binary(op, l, r); }
        Expr::Unary(op, e) => { return Expr::Unary(op, e); }
        Expr::Call(n, a) => { return Expr::Call(n, a); }
        Expr::FieldAccess(e, f) => { return Expr::FieldAccess(e, f); }
        Expr::OptionalFieldAccess(e, f) => { return Expr::OptionalFieldAccess(e, f); }
        Expr::StructLit(n, f, s) => { return Expr::StructLit(n, f, s); }
        Expr::If(c, t, e) => { return Expr::If(c, t, e); }
        Expr::Range(s, e2, i) => { return Expr::Range(s, e2, i); }
        Expr::Block(s) => { return Expr::Block(s); }
        Expr::MethodCall(r, m, a) => { return Expr::MethodCall(r, m, a); }
        Expr::ArrayLit(t, e) => { return Expr::ArrayLit(t, e); }
        Expr::Index(a, i) => { return Expr::Index(a, i); }
        Expr::FString(p) => { return Expr::FString(p); }
        Expr::Match(e, a) => { return Expr::Match(e, a); }
        Expr::EnumLit(en, v, a) => { return Expr::EnumLit(en, v, a); }
        Expr::Ref(e, m) => { return Expr::Ref(e, m); }
        Expr::Deref(e) => { return Expr::Deref(e); }
        Expr::StrConcat(l, r) => { return Expr::StrConcat(l, r); }
        Expr::Try(e) => { return Expr::Try(e); }
        Expr::Coalesce(e, d) => { return Expr::Coalesce(e, d); }
        Expr::IsCheck(e, t) => { return Expr::IsCheck(e, t); }
        Expr::TryBlock(b) => { return Expr::TryBlock(b); }
        Expr::TupleLit(e) => { return Expr::TupleLit(e); }
        Expr::Closure(p, b, r) => { return Expr::Closure(p, b, r); }
        Expr::Cast(e, t) => { return Expr::Cast(e, t); }
        Expr::Asm(t, o) => { return Expr::Asm(t, o); }
        Expr::Comptime(e) => { return Expr::Comptime(e); }
        Expr::ComptimeBlock(s) => { return Expr::ComptimeBlock(s); }
        Expr::ComptimeReflect(op, t) => { return Expr::ComptimeReflect(op, t); }
        Expr::PipeForward(l, r) => { return Expr::PipeForward(l, r); }
        Expr::QuantCast(e, t) => { return Expr::QuantCast(e, t); }
        Expr::Await(e) => { return Expr::Await(e); }
        Expr::Spawn(e) => { return Expr::Spawn(e); }
    }
    return Expr::IntLit(0);
}

// ─── Substitute GAT type arguments into a resolved associated type ───────

fn subst_gat_type_args(ty: Type, args: Vec<Type>, subst: Vec<SubstEntry>) -> Type {
    match ty {
        Type::Named(_) => {
            return ty;
        }
        Type::Generic(name, inner_args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < inner_args.len() {
                var a: Type = inner_args.get(i);
                match a {
                    Type::Named(n) => {
                        // Check if it's a single-char uppercase type param
                        if str_len(n) == 1 {
                            var c: i64 = str_byte_at(n, 0);
                            // 'A'..'Z' = 65..90
                            if c >= 65 && c <= 90 {
                                if args.len() > 0 {
                                    new_args.push(args.get(0));
                                } else {
                                    new_args.push(a);
                                }
                            } else {
                                new_args.push(subst_gat_type_args(a, args, subst));
                            }
                        } else {
                            new_args.push(subst_gat_type_args(a, args, subst));
                        }
                    }
                    _ => { new_args.push(subst_gat_type_args(a, args, subst)); }
                }
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Array(elem, size) => {
            return Type::Array(box_type_new(subst_gat_type_args(box_type_deref(elem), args, subst)), size);
        }
        Type::ArrayConst(elem, size_param) => {
            if args.len() > 0 {
                match args.get(0) {
                    Type::Named(n) => {
                        if str_equal(n, size_param) {
                            return Type::ArrayConst(box_type_new(subst_gat_type_args(box_type_deref(elem), args, subst)), size_param);
                        }
                    }
                    _ => {}
                }
            }
            return Type::ArrayConst(box_type_new(subst_gat_type_args(box_type_deref(elem), args, subst)), size_param);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(box_type_new(subst_gat_type_args(box_type_deref(inner), args, subst)), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(box_type_new(subst_gat_type_args(box_type_deref(inner), args, subst)), is_mut);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(subst_gat_type_args(types.get(i), args, subst));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        _ => { return ty; }
    }
    return ty;
}

// ─── Resolve Type::Assoc using substitution and trait impl bindings ──────

fn resolve_assoc_types(ty: Type, subst: Vec<SubstEntry>, bindings: Vec<TraitAssocEntry>) -> Type {
    match ty {
        Type::Assoc(type_param, trait_name, assoc_name, type_args) => {
            match subst_get(subst, type_param) {
                OptType::Some(concrete) => {
                    var concrete_name: str = "";
                    match concrete {
                        Type::Named(n) => { concrete_name = n; }
                        _ => { return Type::I64; }
                    }
                    // If trait_name is empty, search all bindings for this type+assoc_name
                    if str_len(trait_name) == 0 {
                        var i: i64 = 0;
                        while i < bindings.len() {
                            var entry: TraitAssocEntry = bindings.get(i);
                            if str_equal(entry.type_name, concrete_name) {
                                match assoc_bindings_get(entry.bindings, assoc_name) {
                                    OptType::Some(resolved) => {
                                        if type_args.len() > 0 {
                                            return subst_gat_type_args(resolved, type_args, subst);
                                        }
                                        return resolved;
                                    }
                                    OptType::None => {}
                                }
                            }
                            i = i + 1;
                        }
                    } else {
                        match trait_assoc_get(bindings, trait_name, concrete_name) {
                            OptVecAssocBinding::Some(assoc_map) => {
                                match assoc_bindings_get(assoc_map, assoc_name) {
                                    OptType::Some(resolved) => {
                                        if type_args.len() > 0 {
                                            return subst_gat_type_args(resolved, type_args, subst);
                                        }
                                        return resolved;
                                    }
                                    OptType::None => {}
                                }
                            }
                            OptVecAssocBinding::None => {}
                        }
                    }
                }
                OptType::None => {}
            }
            return Type::I64;
        }
        Type::Array(elem, size) => {
            return Type::Array(box_type_new(resolve_assoc_types(box_type_deref(elem), subst, bindings)), size);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(box_type_new(resolve_assoc_types(box_type_deref(inner), subst, bindings)), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(box_type_new(resolve_assoc_types(box_type_deref(inner), subst, bindings)), is_mut);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(resolve_assoc_types(args.get(i), subst, bindings));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(resolve_assoc_types(types.get(i), subst, bindings));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        Type::Func(params, ret) => {
            var new_params: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < params.len() {
                new_params.push(resolve_assoc_types(params.get(i), subst, bindings));
                i = i + 1;
            }
            return Type::Func(new_params, box_type_new(resolve_assoc_types(box_type_deref(ret), subst, bindings)));
        }
        _ => { return ty; }
    }
    return ty;
}

// ─── Apply substitution to an expression ─────────────────────────────────
// Rewrites call sites (using renames) and type annotations (using subst)

pub fn subst_expr(
    expr: Expr,
    subst: Vec<SubstEntry>,
    renames: Vec<RenameEntry>,
    method_renames: Vec<RenameEntry>,
) -> Expr {
    match expr {
        Expr::Call(callee, args) => {
            var new_args: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(subst_expr(args.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            var new_callee: str = callee;
            match rename_get(renames, callee) {
                OptStr::Some(r) => { new_callee = r; }
                OptStr::None => {}
            }
            return Expr::Call(new_callee, new_args);
        }
        Expr::Ident(s) => {
            // Check if this is a const generic param being substituted
            match subst_get(subst, s) {
                OptType::Some(replacement) => {
                    match replacement {
                        Type::Named(name) => {
                            if str_starts_with(name, "__const_") {
                                var size_str: str = str_slice(name, 8, str_len(name));
                                var val: i64 = str_parse_int(size_str);
                                return Expr::IntLit(val);
                            }
                        }
                        _ => {}
                    }
                }
                OptType::None => {}
            }
            return Expr::Ident(s);
        }
        Expr::IntLit(n) => { return Expr::IntLit(n); }
        Expr::FloatLit(f) => { return Expr::FloatLit(f); }
        Expr::BoolLit(b) => { return Expr::BoolLit(b); }
        Expr::StringLit(s) => { return Expr::StringLit(s); }
        Expr::Binary(op, left, right) => {
            return Expr::Binary(op,
                box_expr_new(subst_expr(box_expr_deref(left), subst, renames, method_renames)),
                box_expr_new(subst_expr(box_expr_deref(right), subst, renames, method_renames)));
        }
        Expr::Unary(op, operand) => {
            return Expr::Unary(op, box_expr_new(subst_expr(box_expr_deref(operand), subst, renames, method_renames)));
        }
        Expr::If(cond, then_block, else_block) => {
            var new_then: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < then_block.len() {
                new_then.push(subst_stmt(then_block.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            var new_else: OptStmts = OptStmts::None;
            match else_block {
                OptStmts::Some(eb) => {
                    var new_eb: Vec<Stmt> = Vec::new();
                    var j: i64 = 0;
                    while j < eb.len() {
                        new_eb.push(subst_stmt(eb.get(j), subst, renames, method_renames));
                        j = j + 1;
                    }
                    new_else = OptStmts::Some(new_eb);
                }
                OptStmts::None => {}
            }
            return Expr::If(
                box_expr_new(subst_expr(box_expr_deref(cond), subst, renames, method_renames)),
                new_then, new_else);
        }
        Expr::Block(stmts) => {
            var new_stmts: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < stmts.len() {
                new_stmts.push(subst_stmt(stmts.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::Block(new_stmts);
        }
        Expr::FieldAccess(e, field) => {
            return Expr::FieldAccess(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames)), field);
        }
        Expr::OptionalFieldAccess(e, field) => {
            return Expr::OptionalFieldAccess(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames)), field);
        }
        Expr::MethodCall(receiver, method, args) => {
            // Check if this method call should be rewritten to a monomorphized function call
            match rename_get(method_renames, method) {
                OptStr::Some(mangled) => {
                    // Rewrite to a regular Call with receiver as first arg
                    var all_args: Vec<Expr> = Vec::new();
                    all_args.push(subst_expr(box_expr_deref(receiver), subst, renames, method_renames));
                    var i: i64 = 0;
                    while i < args.len() {
                        all_args.push(subst_expr(args.get(i), subst, renames, method_renames));
                        i = i + 1;
                    }
                    return Expr::Call(mangled, all_args);
                }
                OptStr::None => {
                    var new_args: Vec<Expr> = Vec::new();
                    var i: i64 = 0;
                    while i < args.len() {
                        new_args.push(subst_expr(args.get(i), subst, renames, method_renames));
                        i = i + 1;
                    }
                    return Expr::MethodCall(
                        box_expr_new(subst_expr(box_expr_deref(receiver), subst, renames, method_renames)),
                        method, new_args);
                }
            }
            return Expr::MethodCall(receiver, method, args);
        }
        Expr::Index(array, index) => {
            return Expr::Index(
                box_expr_new(subst_expr(box_expr_deref(array), subst, renames, method_renames)),
                box_expr_new(subst_expr(box_expr_deref(index), subst, renames, method_renames)));
        }
        Expr::ArrayLit(elem_type, elements) => {
            var new_elements: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < elements.len() {
                new_elements.push(subst_expr(elements.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::ArrayLit(box_type_new(subst_type(box_type_deref(elem_type), subst)), new_elements);
        }
        Expr::Range(start, end, inclusive) => {
            return Expr::Range(
                box_expr_new(subst_expr(box_expr_deref(start), subst, renames, method_renames)),
                box_expr_new(subst_expr(box_expr_deref(end), subst, renames, method_renames)),
                inclusive);
        }
        Expr::StructLit(name, fields, spread) => {
            var new_fields: Vec<FieldInit> = Vec::new();
            var i: i64 = 0;
            while i < fields.len() {
                new_fields.push(FieldInit_new(fields.get(i).name, subst_expr(fields.get(i).value, subst, renames, method_renames)));
                i = i + 1;
            }
            var new_spread: OptBoxExpr = OptBoxExpr::None;
            match spread {
                OptBoxExpr::Some(e) => {
                    new_spread = OptBoxExpr::Some(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames)));
                }
                OptBoxExpr::None => {}
            }
            return Expr::StructLit(name, new_fields, new_spread);
        }
        Expr::Match(e, arms) => {
            var new_arms: Vec<MatchArm> = Vec::new();
            var i: i64 = 0;
            while i < arms.len() {
                var arm: MatchArm = arms.get(i);
                var new_guard: OptBoxExpr = OptBoxExpr::None;
                match arm.guard {
                    OptBoxExpr::Some(g) => {
                        new_guard = OptBoxExpr::Some(box_expr_new(subst_expr(box_expr_deref(g), subst, renames, method_renames)));
                    }
                    OptBoxExpr::None => {}
                }
                var new_body: Vec<Stmt> = Vec::new();
                var j: i64 = 0;
                while j < arm.body.len() {
                    new_body.push(subst_stmt(arm.body.get(j), subst, renames, method_renames));
                    j = j + 1;
                }
                new_arms.push(MatchArm_new(arm.pattern, new_guard, new_body));
                i = i + 1;
            }
            return Expr::Match(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames)), new_arms);
        }
        Expr::Try(e) => {
            return Expr::Try(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames)));
        }
        Expr::Coalesce(e, default) => {
            return Expr::Coalesce(
                box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames)),
                box_expr_new(subst_expr(box_expr_deref(default), subst, renames, method_renames)));
        }
        Expr::IsCheck(e, type_name) => {
            return Expr::IsCheck(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames)), type_name);
        }
        Expr::TryBlock(body) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::TryBlock(new_body);
        }
        Expr::Closure(params, body, ret_ty) => {
            var new_params: Vec<Param> = Vec::new();
            var i: i64 = 0;
            while i < params.len() {
                var p: Param = Param_new(
                    params.get(i).name,
                    subst_type(params.get(i).ty, subst),
                    params.get(i).is_pub);
                p.annotations = params.get(i).annotations;
                new_params.push(p);
                i = i + 1;
            }
            var new_body: Vec<Stmt> = Vec::new();
            var j: i64 = 0;
            while j < body.len() {
                new_body.push(subst_stmt(body.get(j), subst, renames, method_renames));
                j = j + 1;
            }
            var new_ret: OptType = OptType::None;
            match ret_ty {
                OptType::Some(t) => { new_ret = OptType::Some(subst_type(t, subst)); }
                OptType::None => {}
            }
            return Expr::Closure(new_params, new_body, new_ret);
        }
        Expr::FString(parts) => {
            var new_parts: Vec<FStringPart> = Vec::new();
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Literal(s) => { new_parts.push(FStringPart::Literal(s)); }
                    FStringPart::Expr(e) => {
                        new_parts.push(FStringPart::Expr(subst_expr(e, subst, renames, method_renames)));
                    }
                }
                i = i + 1;
            }
            return Expr::FString(new_parts);
        }
        Expr::Cast(e, target_ty) => {
            return Expr::Cast(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames)), subst_type(target_ty, subst));
        }
        Expr::Asm(template, operands) => {
            var new_operands: Vec<AsmOperand> = Vec::new();
            var i: i64 = 0;
            while i < operands.len() {
                new_operands.push(AsmOperand_new(
                    operands.get(i).direction,
                    operands.get(i).reg,
                    subst_expr(operands.get(i).expr, subst, renames, method_renames)));
                i = i + 1;
            }
            return Expr::Asm(template, new_operands);
        }
        Expr::Ref(e, is_mut) => {
            return Expr::Ref(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames)), is_mut);
        }
        Expr::Deref(e) => {
            return Expr::Deref(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames)));
        }
        Expr::StrConcat(left, right) => {
            return Expr::StrConcat(
                box_expr_new(subst_expr(box_expr_deref(left), subst, renames, method_renames)),
                box_expr_new(subst_expr(box_expr_deref(right), subst, renames, method_renames)));
        }
        Expr::TupleLit(exprs) => {
            var new_exprs: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < exprs.len() {
                new_exprs.push(subst_expr(exprs.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::TupleLit(new_exprs);
        }
        Expr::EnumLit(enum_name, variant, args) => {
            var new_args: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(subst_expr(args.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::EnumLit(enum_name, variant, new_args);
        }
        Expr::Comptime(inner) => {
            return Expr::Comptime(box_expr_new(subst_expr(box_expr_deref(inner), subst, renames, method_renames)));
        }
        Expr::ComptimeBlock(stmts) => {
            var new_stmts: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < stmts.len() {
                new_stmts.push(subst_stmt(stmts.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::ComptimeBlock(new_stmts);
        }
        Expr::ComptimeReflect(op, ty) => {
            return Expr::ComptimeReflect(op, subst_type(ty, subst));
        }
        Expr::PipeForward(left, right) => {
            return Expr::PipeForward(
                box_expr_new(subst_expr(box_expr_deref(left), subst, renames, method_renames)),
                box_expr_new(subst_expr(box_expr_deref(right), subst, renames, method_renames)));
        }
        Expr::QuantCast(e, target_ty) => {
            return Expr::QuantCast(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames)), subst_type(target_ty, subst));
        }
        Expr::Await(inner) => {
            return Expr::Await(box_expr_new(subst_expr(box_expr_deref(inner), subst, renames, method_renames)));
        }
        Expr::Spawn(inner) => {
            return Expr::Spawn(box_expr_new(subst_expr(box_expr_deref(inner), subst, renames, method_renames)));
        }
    }
    return expr;
}

// ─── Apply substitution to a statement ───────────────────────────────────

pub fn subst_stmt(
    stmt: Stmt,
    subst: Vec<SubstEntry>,
    renames: Vec<RenameEntry>,
    method_renames: Vec<RenameEntry>,
) -> Stmt {
    match stmt {
        Stmt::Let(name, ty, expr, is_mut, is_persist, line) => {
            var new_ty: OptType = OptType::None;
            match ty {
                OptType::Some(t) => { new_ty = OptType::Some(subst_type(t, subst)); }
                OptType::None => {}
            }
            return Stmt::Let(name, new_ty, subst_expr(expr, subst, renames, method_renames), is_mut, is_persist, line);
        }
        Stmt::LetUninit(name, ty, line) => {
            return Stmt::LetUninit(name, subst_type(ty, subst), line);
        }
        Stmt::LetTuple(names, expr, line) => {
            return Stmt::LetTuple(names, subst_expr(expr, subst, renames, method_renames), line);
        }
        Stmt::Assign(target, op, expr, line) => {
            return Stmt::Assign(target, op, subst_expr(expr, subst, renames, method_renames), line);
        }
        Stmt::IndexAssign(array, index, op, expr, line) => {
            return Stmt::IndexAssign(array, subst_expr(index, subst, renames, method_renames), op, subst_expr(expr, subst, renames, method_renames), line);
        }
        Stmt::DerefAssign(ptr_expr, op, expr, line) => {
            return Stmt::DerefAssign(subst_expr(ptr_expr, subst, renames, method_renames), op, subst_expr(expr, subst, renames, method_renames), line);
        }
        Stmt::FieldAssign(object, field, op, expr, line) => {
            return Stmt::FieldAssign(subst_expr(object, subst, renames, method_renames), field, op, subst_expr(expr, subst, renames, method_renames), line);
        }
        Stmt::Expr(e, line) => {
            return Stmt::Expr(subst_expr(e, subst, renames, method_renames), line);
        }
        Stmt::Return(opt, line) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    return Stmt::Return(OptBoxExpr::Some(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames))), line);
                }
                OptBoxExpr::None => { return Stmt::Return(OptBoxExpr::None, line); }
            }
            return Stmt::Return(OptBoxExpr::None, line);
        }
        Stmt::If(cond, then_block, else_block, line) => {
            var new_then: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < then_block.len() {
                new_then.push(subst_stmt(then_block.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            var new_else: OptStmts = OptStmts::None;
            match else_block {
                OptStmts::Some(eb) => {
                    var new_eb: Vec<Stmt> = Vec::new();
                    var j: i64 = 0;
                    while j < eb.len() {
                        new_eb.push(subst_stmt(eb.get(j), subst, renames, method_renames));
                        j = j + 1;
                    }
                    new_else = OptStmts::Some(new_eb);
                }
                OptStmts::None => {}
            }
            return Stmt::If(subst_expr(cond, subst, renames, method_renames), new_then, new_else, line);
        }
        Stmt::While(cond, body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::While(subst_expr(cond, subst, renames, method_renames), new_body, line);
        }
        Stmt::For(var_name, iterator, body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::For(var_name, subst_expr(iterator, subst, renames, method_renames), new_body, line);
        }
        Stmt::Loop(body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Loop(new_body, line);
        }
        Stmt::Break(opt, line) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    return Stmt::Break(OptBoxExpr::Some(box_expr_new(subst_expr(box_expr_deref(e), subst, renames, method_renames))), line);
                }
                OptBoxExpr::None => { return Stmt::Break(OptBoxExpr::None, line); }
            }
            return Stmt::Break(OptBoxExpr::None, line);
        }
        Stmt::Continue(line) => { return Stmt::Continue(line); }
        Stmt::Defer(body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Defer(new_body, line);
        }
        Stmt::Match(e, arms, line) => {
            var new_arms: Vec<MatchArm> = Vec::new();
            var i: i64 = 0;
            while i < arms.len() {
                var arm: MatchArm = arms.get(i);
                var new_guard: OptBoxExpr = OptBoxExpr::None;
                match arm.guard {
                    OptBoxExpr::Some(g) => {
                        new_guard = OptBoxExpr::Some(box_expr_new(subst_expr(box_expr_deref(g), subst, renames, method_renames)));
                    }
                    OptBoxExpr::None => {}
                }
                var new_body: Vec<Stmt> = Vec::new();
                var j: i64 = 0;
                while j < arm.body.len() {
                    new_body.push(subst_stmt(arm.body.get(j), subst, renames, method_renames));
                    j = j + 1;
                }
                new_arms.push(MatchArm_new(arm.pattern, new_guard, new_body));
                i = i + 1;
            }
            return Stmt::Match(subst_expr(e, subst, renames, method_renames), new_arms, line);
        }
        Stmt::Use(path, items, line) => { return Stmt::Use(path, items, line); }
        Stmt::Handle(body, handlers, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            var new_handlers: Vec<EffectHandler> = Vec::new();
            var j: i64 = 0;
            while j < handlers.len() {
                var h: EffectHandler = handlers.get(j);
                var new_h_body: Vec<Stmt> = Vec::new();
                var k: i64 = 0;
                while k < h.body.len() {
                    new_h_body.push(subst_stmt(h.body.get(k), subst, renames, method_renames));
                    k = k + 1;
                }
                new_handlers.push(EffectHandler_new(h.effect, h.op, h.params, new_h_body));
                j = j + 1;
            }
            return Stmt::Handle(new_body, new_handlers, line);
        }
        Stmt::Do(effect, op, args, line) => {
            var new_args: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(subst_expr(args.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Do(effect, op, new_args, line);
        }
        Stmt::RegionBlock(name, budget, is_gpu, is_kv_cache, window_size, body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::RegionBlock(name, budget, is_gpu, is_kv_cache, window_size, new_body, line);
        }
        Stmt::ComptimeGen(body, line) => { return Stmt::ComptimeGen(body, line); }
        Stmt::Sandbox(body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Sandbox(new_body, line);
        }
        Stmt::Unsafe(body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Unsafe(new_body, line);
        }
        Stmt::Txn(body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Txn(new_body, line);
        }
        Stmt::GradBlock(var_name, body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::GradBlock(var_name, new_body, line);
        }
        Stmt::Backward(loss, line) => {
            return Stmt::Backward(subst_expr(loss, subst, renames, method_renames), line);
        }
        Stmt::Query(components, body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Query(components, new_body, line);
        }
        Stmt::Select(cases, default, line) => {
            var new_cases: Vec<SelectCase> = Vec::new();
            var i: i64 = 0;
            while i < cases.len() {
                var c: SelectCase = cases.get(i);
                var new_body: Vec<Stmt> = Vec::new();
                var j: i64 = 0;
                while j < c.body.len() {
                    new_body.push(subst_stmt(c.body.get(j), subst, renames, method_renames));
                    j = j + 1;
                }
                new_cases.push(SelectCase_new(subst_expr(c.channel, subst, renames, method_renames), c.var_name, new_body));
                i = i + 1;
            }
            var new_default: OptStmts = OptStmts::None;
            match default {
                OptStmts::Some(d) => {
                    var new_d: Vec<Stmt> = Vec::new();
                    var j: i64 = 0;
                    while j < d.len() {
                        new_d.push(subst_stmt(d.get(j), subst, renames, method_renames));
                        j = j + 1;
                    }
                    new_default = OptStmts::Some(new_d);
                }
                OptStmts::None => {}
            }
            return Stmt::Select(new_cases, new_default, line);
        }
    }
    return stmt;
}

// ─── Infer type substitution from a call site ────────────────────────────

pub fn infer_subst(
    param_types: Vec<Type>,
    arg_types: Vec<Type>,
    type_params: Vec<str>,
) -> Vec<SubstEntry> {
    var subst: Vec<SubstEntry> = Vec::new();
    var n: i64 = param_types.len();
    if arg_types.len() < n { n = arg_types.len(); }
    var i: i64 = 0;
    while i < n {
        infer_from_pair(param_types.get(i), arg_types.get(i), type_params, &mut subst);
        i = i + 1;
    }
    return subst;
}

// ─── Recursively infer type parameter bindings from a (param, arg) pair ───

pub fn infer_from_pair(param: Type, arg: Type, type_params: Vec<str>, subst: &mut Vec<SubstEntry>) {
    match param {
        Type::Named(name) => {
            if str_vec_contains(type_params, name) {
                subst_set(subst, name, arg);
            }
        }
        Type::ArrayConst(elem, size_param) => {
            if str_vec_contains(type_params, size_param) {
                match arg {
                    Type::Array(arg_elem, size) => {
                        subst_set(subst, size_param, Type::Named("__const_" + int_to_str(size)));
                        infer_from_pair(box_type_deref(elem), box_type_deref(arg_elem), type_params, subst);
                    }
                    _ => {}
                }
            }
        }
        Type::Array(elem, _) => {
            match arg {
                Type::Array(arg_elem, _) => {
                    infer_from_pair(box_type_deref(elem), box_type_deref(arg_elem), type_params, subst);
                }
                _ => {}
            }
        }
        Type::Ref(inner, _) => {
            match arg {
                Type::Ref(arg_inner, _) => {
                    infer_from_pair(box_type_deref(inner), box_type_deref(arg_inner), type_params, subst);
                }
                _ => {}
            }
        }
        Type::RawPtr(inner, _) => {
            match arg {
                Type::RawPtr(arg_inner, _) => {
                    infer_from_pair(box_type_deref(inner), box_type_deref(arg_inner), type_params, subst);
                }
                _ => {}
            }
        }
        Type::Tuple(types) => {
            match arg {
                Type::Tuple(arg_types) => {
                    var n: i64 = types.len();
                    if arg_types.len() < n { n = arg_types.len(); }
                    var i: i64 = 0;
                    while i < n {
                        infer_from_pair(types.get(i), arg_types.get(i), type_params, subst);
                        i = i + 1;
                    }
                }
                _ => {}
            }
        }
        Type::Func(params, ret) => {
            match arg {
                Type::Func(arg_params, arg_ret) => {
                    var n: i64 = params.len();
                    if arg_params.len() < n { n = arg_params.len(); }
                    var i: i64 = 0;
                    while i < n {
                        infer_from_pair(params.get(i), arg_params.get(i), type_params, subst);
                        i = i + 1;
                    }
                    infer_from_pair(box_type_deref(ret), box_type_deref(arg_ret), type_params, subst);
                }
                _ => {}
            }
        }
        _ => {}
    }
}

// ─── Monomorphization context ────────────────────────────────────────────

pub struct MonoCtx {
    pub generics: Vec<GenericFuncEntry>,
    pub generic_methods: Vec<GenericMethodEntry>,
    pub instantiated: Vec<Func>,
    pub seen: Vec<str>,
    pub trait_assoc_bindings: Vec<TraitAssocEntry>,
}

pub fn MonoCtx_new() -> MonoCtx {
    return MonoCtx {
        generics: Vec::new(),
        generic_methods: Vec::new(),
        instantiated: Vec::new(),
        seen: Vec::new(),
        trait_assoc_bindings: Vec::new(),
    };
}

pub fn MonoCtx_seen_insert(ctx: &mut MonoCtx, name: str) -> bool {
    if str_vec_contains(ctx.seen, name) { return false; }
    ctx.seen.push(name);
    return true;
}

// ─── Main monomorphization entry point ───────────────────────────────────

pub fn monomorphize(program: Program) -> Program {
    var ctx: MonoCtx = MonoCtx_new();

    // Separate generic and non-generic functions
    var concrete_funcs: Vec<Func> = Vec::new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        var func: Func = program.funcs.get(i);
        if func.type_params.len() == 0 {
            concrete_funcs.push(func);
        } else {
            ctx.generics.push(GenericFuncEntry_new(func.name, func, func.type_params));
        }
        i = i + 1;
    }

    // Register trait impl associated type bindings
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        if ti.associated_types.len() > 0 {
            var entry: TraitAssocEntry = TraitAssocEntry_new(ti.trait_name, ti.type_name);
            var j: i64 = 0;
            while j < ti.associated_types.len() {
                entry.bindings.push(AssocBindingEntry_new(ti.associated_types.get(j).name, ti.associated_types.get(j).ty));
                j = j + 1;
            }
            ctx.trait_assoc_bindings.push(entry);
        }
        i = i + 1;
    }

    // Register generic impl methods BEFORE processing any functions
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        if imp.type_params.len() > 0 {
            var j: i64 = 0;
            while j < imp.methods.len() {
                ctx.generic_methods.push(GenericMethodEntry_new(imp.struct_name, imp.methods.get(j).name, imp.methods.get(j), imp.type_params));
                j = j + 1;
            }
        }
        i = i + 1;
    }

    // Register generic trait impl methods
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        if ti.type_params.len() > 0 {
            var j: i64 = 0;
            while j < ti.methods.len() {
                ctx.generic_methods.push(GenericMethodEntry_new(ti.type_name, ti.methods.get(j).name, ti.methods.get(j), ti.type_params));
                j = j + 1;
            }
        }
        i = i + 1;
    }

    // Process concrete functions — find calls to generics and instantiate
    var new_funcs: Vec<Func> = Vec::new();
    i = 0;
    while i < concrete_funcs.len() {
        new_funcs.push(process_func(concrete_funcs.get(i), &mut ctx));
        i = i + 1;
    }

    // Process impl methods — separate generic from non-generic
    var new_impls: Vec<ImplDef> = Vec::new();
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var new_methods: Vec<Func> = Vec::new();
        var j: i64 = 0;
        while j < imp.methods.len() {
            if imp.type_params.len() == 0 {
                new_methods.push(process_func(imp.methods.get(j), &mut ctx));
            }
            j = j + 1;
        }
        var new_impl: ImplDef = ImplDef_new(imp.struct_name);
        new_impl.methods = new_methods;
        new_impls.push(new_impl);
        i = i + 1;
    }

    // Process trait impl methods — separate generic from non-generic
    var new_trait_impls: Vec<TraitImpl> = Vec::new();
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var new_methods: Vec<Func> = Vec::new();
        var j: i64 = 0;
        while j < ti.methods.len() {
            if ti.type_params.len() == 0 {
                new_methods.push(process_func(ti.methods.get(j), &mut ctx));
            }
            j = j + 1;
        }
        var new_ti: TraitImpl = TraitImpl_new(ti.trait_name, ti.type_name);
        new_ti.methods = new_methods;
        new_ti.associated_types = ti.associated_types;
        new_trait_impls.push(new_ti);
        i = i + 1;
    }

    // Add all instantiated functions
    i = 0;
    while i < ctx.instantiated.len() {
        new_funcs.push(ctx.instantiated.get(i));
        i = i + 1;
    }

    var result: Program = program_new();
    result.module = program.module;
    result.structs = program.structs;
    result.enums = program.enums;
    result.funcs = new_funcs;
    result.consts = program.consts;
    result.type_aliases = program.type_aliases;
    result.impls = new_impls;
    result.imports = program.imports;
    result.attributes = program.attributes;
    result.traits = program.traits;
    result.trait_impls = new_trait_impls;
    result.extern_decls = program.extern_decls;
    result.layers = program.layers;
    result.models = program.models;
    result.components = program.components;
    result.systems = program.systems;
    result.state_machines = program.state_machines;
    result.event_handlers = program.event_handlers;
    return result;
}

// ─── Fix up call sites for generic functions ─────────────────────────────
// For each call to a generic, re-infer the substitution from argument types
// and use the correct mangled name.

pub fn fixup_generic_calls(stmts: Vec<Stmt>, generics: Vec<GenericFuncEntry>, current_func: Func) -> Vec<Stmt> {
    var result: Vec<Stmt> = Vec::new();
    var i: i64 = 0;
    while i < stmts.len() {
        result.push(fixup_generic_calls_stmt(stmts.get(i), generics, current_func));
        i = i + 1;
    }
    return result;
}

pub fn fixup_generic_calls_stmt(stmt: Stmt, generics: Vec<GenericFuncEntry>, current_func: Func) -> Stmt {
    match stmt {
        Stmt::Expr(e, line) => {
            return Stmt::Expr(fixup_generic_calls_expr(e, generics, current_func), line);
        }
        Stmt::Let(name, ty, expr, is_mut, is_persist, line) => {
            return Stmt::Let(name, ty, fixup_generic_calls_expr(expr, generics, current_func), is_mut, is_persist, line);
        }
        Stmt::LetTuple(names, expr, line) => {
            return Stmt::LetTuple(names, fixup_generic_calls_expr(expr, generics, current_func), line);
        }
        Stmt::Return(opt, line) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    return Stmt::Return(OptBoxExpr::Some(box_expr_new(fixup_generic_calls_expr(box_expr_deref(e), generics, current_func))), line);
                }
                OptBoxExpr::None => { return Stmt::Return(OptBoxExpr::None, line); }
            }
            return Stmt::Return(OptBoxExpr::None, line);
        }
        Stmt::If(cond, then_block, else_block, line) => {
            var new_then: Vec<Stmt> = fixup_generic_calls(then_block, generics, current_func);
            var new_else: OptStmts = OptStmts::None;
            match else_block {
                OptStmts::Some(eb) => {
                    new_else = OptStmts::Some(fixup_generic_calls(eb, generics, current_func));
                }
                OptStmts::None => {}
            }
            return Stmt::If(fixup_generic_calls_expr(cond, generics, current_func), new_then, new_else, line);
        }
        Stmt::While(cond, body, line) => {
            return Stmt::While(fixup_generic_calls_expr(cond, generics, current_func), fixup_generic_calls(body, generics, current_func), line);
        }
        Stmt::For(var_name, iterator, body, line) => {
            return Stmt::For(var_name, fixup_generic_calls_expr(iterator, generics, current_func), fixup_generic_calls(body, generics, current_func), line);
        }
        Stmt::Assign(target, op, expr, line) => {
            return Stmt::Assign(target, op, fixup_generic_calls_expr(expr, generics, current_func), line);
        }
        other => { return other; }
    }
    return stmt;
}

pub fn fixup_generic_calls_expr(expr: Expr, generics: Vec<GenericFuncEntry>, current_func: Func) -> Expr {
    match expr {
        Expr::Call(callee, args) => {
            // First, recursively fix up args
            var new_args: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(fixup_generic_calls_expr(args.get(i), generics, current_func));
                i = i + 1;
            }
            // Check if this is a call to a generic function
            match generic_funcs_get(generics, callee) {
                OptGenericFunc::Some(entry) => {
                    var arg_types: Vec<Type> = Vec::new();
                    var j: i64 = 0;
                    while j < new_args.len() {
                        arg_types.push(infer_expr_type(new_args.get(j), current_func));
                        j = j + 1;
                    }
                    var param_types: Vec<Type> = Vec::new();
                    var k: i64 = 0;
                    while k < entry.func.params.len() {
                        param_types.push(entry.func.params.get(k).ty);
                        k = k + 1;
                    }
                    var subst: Vec<SubstEntry> = infer_subst(param_types, arg_types, entry.type_params);
                    var mangled: str = mangle(callee, subst, entry.type_params);
                    return Expr::Call(mangled, new_args);
                }
                OptGenericFunc::None => {
                    return Expr::Call(callee, new_args);
                }
            }
            return Expr::Call(callee, new_args);
        }
        Expr::Binary(op, left, right) => {
            return Expr::Binary(op,
                box_expr_new(fixup_generic_calls_expr(box_expr_deref(left), generics, current_func)),
                box_expr_new(fixup_generic_calls_expr(box_expr_deref(right), generics, current_func)));
        }
        Expr::Unary(op, inner) => {
            return Expr::Unary(op, box_expr_new(fixup_generic_calls_expr(box_expr_deref(inner), generics, current_func)));
        }
        Expr::MethodCall(receiver, method, args) => {
            var new_args: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(fixup_generic_calls_expr(args.get(i), generics, current_func));
                i = i + 1;
            }
            return Expr::MethodCall(box_expr_new(fixup_generic_calls_expr(box_expr_deref(receiver), generics, current_func)), method, new_args);
        }
        Expr::FieldAccess(inner, field) => {
            return Expr::FieldAccess(box_expr_new(fixup_generic_calls_expr(box_expr_deref(inner), generics, current_func)), field);
        }
        Expr::Index(array, index) => {
            return Expr::Index(
                box_expr_new(fixup_generic_calls_expr(box_expr_deref(array), generics, current_func)),
                box_expr_new(fixup_generic_calls_expr(box_expr_deref(index), generics, current_func)));
        }
        Expr::If(cond, then_block, else_block) => {
            var new_then: Vec<Stmt> = fixup_generic_calls(then_block, generics, current_func);
            var new_else: OptStmts = OptStmts::None;
            match else_block {
                OptStmts::Some(eb) => {
                    new_else = OptStmts::Some(fixup_generic_calls(eb, generics, current_func));
                }
                OptStmts::None => {}
            }
            return Expr::If(box_expr_new(fixup_generic_calls_expr(box_expr_deref(cond), generics, current_func)), new_then, new_else);
        }
        Expr::Block(stmts) => {
            return Expr::Block(fixup_generic_calls(stmts, generics, current_func));
        }
        other => { return other; }
    }
    return expr;
}

// ─── Process a function: find calls to generics, instantiate, rewrite ────

pub fn process_func(func: Func, ctx: &mut MonoCtx) -> Func {
    // Collect all calls to generic functions in this function's body
    var calls_to_instantiate: Vec<GenericCallEntry> = Vec::new();
    var method_calls_to_instantiate: Vec<GenericMethodCallEntry> = Vec::new();

    var i: i64 = 0;
    while i < func.body.len() {
        collect_generic_calls_stmt(
            func.body.get(i),
            ctx.generics,
            ctx.generic_methods,
            &mut calls_to_instantiate,
            &mut method_calls_to_instantiate,
            func);
        i = i + 1;
    }

    // Instantiate each generic function call
    var local_renames: Vec<RenameEntry> = rename_new();
    i = 0;
    while i < calls_to_instantiate.len() {
        var entry: GenericCallEntry = calls_to_instantiate.get(i);
        var callee: str = entry.callee;
        var arg_types: Vec<Type> = entry.arg_types;

        match generic_funcs_get(ctx.generics, callee) {
            OptGenericFunc::Some(gen) => {
                var param_types: Vec<Type> = Vec::new();
                var j: i64 = 0;
                while j < gen.func.params.len() {
                    param_types.push(gen.func.params.get(j).ty);
                    j = j + 1;
                }
                var subst: Vec<SubstEntry> = infer_subst(param_types, arg_types, gen.type_params);

                // Check that all type params are bound
                var all_bound: bool = true;
                var k: i64 = 0;
                while k < gen.type_params.len() {
                    if !subst_contains(subst, gen.type_params.get(k)) {
                        all_bound = false;
                    }
                    k = k + 1;
                }
                if !all_bound {
                    i = i + 1;
                    continue;
                }

                var mangled: str = mangle(callee, subst, gen.type_params);

                if MonoCtx_seen_insert(ctx, mangled) {
                    var instantiated: Func = instantiate(gen.func, subst, mangled, ctx);
                    ctx.instantiated.push(instantiated);
                }

                rename_set(&mut local_renames, callee, mangled);
            }
            OptGenericFunc::None => {}
        }
        i = i + 1;
    }

    // Instantiate each generic method call
    var method_renames: Vec<RenameEntry> = rename_new();
    i = 0;
    while i < method_calls_to_instantiate.len() {
        var entry: GenericMethodCallEntry = method_calls_to_instantiate.get(i);
        var struct_name: str = entry.struct_name;
        var method_name: str = entry.method_name;
        var arg_types: Vec<Type> = entry.arg_types;

        match generic_methods_get(ctx.generic_methods, struct_name, method_name) {
            OptGenericMethod::Some(gen) => {
                var param_types: Vec<Type> = Vec::new();
                var j: i64 = 0;
                while j < gen.func.params.len() {
                    param_types.push(gen.func.params.get(j).ty);
                    j = j + 1;
                }
                var subst: Vec<SubstEntry> = infer_subst(param_types, arg_types, gen.type_params);

                // Bind any unbound type params to a placeholder
                var k: i64 = 0;
                while k < gen.type_params.len() {
                    if !subst_contains(subst, gen.type_params.get(k)) {
                        subst_set(&mut subst, gen.type_params.get(k), Type::I32);
                    }
                    k = k + 1;
                }

                var mangled: str = mangle_method(struct_name, method_name, subst, gen.type_params);

                if MonoCtx_seen_insert(ctx, mangled) {
                    var instantiated: Func = instantiate(gen.func, subst, mangled, ctx);
                    ctx.instantiated.push(instantiated);
                }

                rename_set(&mut method_renames, method_name, mangled);
            }
            OptGenericMethod::None => {}
        }
        i = i + 1;
    }

    // Fixup call sites for generics with multiple instantiations
    var fixed_body: Vec<Stmt> = fixup_generic_calls(func.body, ctx.generics, func);
    // Apply type substitution (no call renames since fixup already did them)
    var new_body: Vec<Stmt> = Vec::new();
    i = 0;
    while i < fixed_body.len() {
        new_body.push(subst_stmt(fixed_body.get(i), subst_new(), rename_new(), method_renames));
        i = i + 1;
    }

    var result: Func = Func_new(func.name, func.ret_ty);
    result.is_pub = func.is_pub;
    result.params = func.params;
    result.body = new_body;
    result.is_comptime = false;
    result.declared_effects = func.declared_effects;
    result.has_effect_annotation = func.has_effect_annotation;
    result.is_interrupt = func.is_interrupt;
    result.annotations = func.annotations;
    result.preconditions = func.preconditions;
    result.postconditions = func.postconditions;
    result.is_async = func.is_async;
    return result;
}

// ─── Instantiate a generic function with a concrete substitution ─────────

pub fn instantiate(gen_func: Func, subst: Vec<SubstEntry>, mangled_name: str, ctx: &mut MonoCtx) -> Func {
    // Apply substitution to params, then resolve associated types
    var new_params: Vec<Param> = Vec::new();
    var i: i64 = 0;
    while i < gen_func.params.len() {
        var substituted: Type = subst_type(gen_func.params.get(i).ty, subst);
        var resolved: Type = resolve_assoc_types(substituted, subst, ctx.trait_assoc_bindings);
        var p: Param = Param_new(gen_func.params.get(i).name, resolved, gen_func.params.get(i).is_pub);
        p.annotations = gen_func.params.get(i).annotations;
        new_params.push(p);
        i = i + 1;
    }

    var substituted_ret: Type = subst_type(gen_func.ret_ty, subst);
    var new_ret_ty: Type = resolve_assoc_types(substituted_ret, subst, ctx.trait_assoc_bindings);

    // Apply the type substitution to the body
    var subst_body: Vec<Stmt> = Vec::new();
    i = 0;
    while i < gen_func.body.len() {
        subst_body.push(subst_stmt(gen_func.body.get(i), subst, rename_new(), rename_new()));
        i = i + 1;
    }

    // Create a temporary concrete function with the substituted body
    var temp_func: Func = Func_new(mangled_name, new_ret_ty);
    temp_func.is_pub = gen_func.is_pub;
    temp_func.params = new_params;
    temp_func.body = subst_body;
    temp_func.is_comptime = false;
    temp_func.declared_effects = gen_func.declared_effects;
    temp_func.has_effect_annotation = gen_func.has_effect_annotation;
    temp_func.is_interrupt = gen_func.is_interrupt;
    temp_func.annotations = gen_func.annotations;
    temp_func.preconditions = gen_func.preconditions;
    temp_func.postconditions = gen_func.postconditions;
    temp_func.is_async = gen_func.is_async;

    // Process this concrete function — it may contain calls to other generics
    return process_func(temp_func, ctx);
}

// ─── Walk statements to find calls to generic functions ──────────────────

pub fn collect_generic_calls_stmt(
    stmt: Stmt,
    generics: Vec<GenericFuncEntry>,
    generic_methods: Vec<GenericMethodEntry>,
    calls: &mut Vec<GenericCallEntry>,
    method_calls: &mut Vec<GenericMethodCallEntry>,
    current_func: Func,
) {
    collect_generic_calls_stmt_with_hint(stmt, generics, generic_methods, calls, method_calls, current_func, OptType::None);
}

pub fn collect_generic_calls_stmt_with_hint(
    stmt: Stmt,
    generics: Vec<GenericFuncEntry>,
    generic_methods: Vec<GenericMethodEntry>,
    calls: &mut Vec<GenericCallEntry>,
    method_calls: &mut Vec<GenericMethodCallEntry>,
    current_func: Func,
    expected_ty: OptType,
) {
    match stmt {
        Stmt::Let(name, ty, expr, is_mut, is_persist, line) => {
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, ty);
        }
        Stmt::LetUninit(name, ty, line) => {}
        Stmt::LetTuple(names, expr, line) => {
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::Assign(target, op, expr, line) => {
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::IndexAssign(array, index, op, expr, line) => {
            collect_generic_calls_expr_with_hint(index, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::DerefAssign(ptr_expr, op, expr, line) => {
            collect_generic_calls_expr_with_hint(ptr_expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::FieldAssign(object, field, op, expr, line) => {
            collect_generic_calls_expr_with_hint(object, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::Expr(e, line) => {
            collect_generic_calls_expr_with_hint(e, generics, generic_methods, calls, method_calls, current_func, expected_ty);
        }
        Stmt::Return(opt, line) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    collect_generic_calls_expr_with_hint(box_expr_deref(e), generics, generic_methods, calls, method_calls, current_func, OptType::Some(current_func.ret_ty));
                }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, line) => {
            collect_generic_calls_expr_with_hint(cond, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < then_block.len() {
                collect_generic_calls_stmt_with_hint(then_block.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        collect_generic_calls_stmt_with_hint(eb.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                        j = j + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Stmt::While(cond, body, line) => {
            collect_generic_calls_expr_with_hint(cond, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::For(var_name, iterator, body, line) => {
            collect_generic_calls_expr_with_hint(iterator, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Loop(body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Break(opt, line) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    collect_generic_calls_expr_with_hint(box_expr_deref(e), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                }
                OptBoxExpr::None => {}
            }
        }
        Stmt::Continue(line) => {}
        Stmt::Defer(body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Match(e, arms, line) => {
            collect_generic_calls_expr_with_hint(e, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < arms.len() {
                var j: i64 = 0;
                while j < arms.get(i).body.len() {
                    collect_generic_calls_stmt_with_hint(arms.get(i).body.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        Stmt::Use(path, items, line) => {}
        Stmt::Handle(body, handlers, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
            var j: i64 = 0;
            while j < handlers.len() {
                var k: i64 = 0;
                while k < handlers.get(j).body.len() {
                    collect_generic_calls_stmt_with_hint(handlers.get(j).body.get(k), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                    k = k + 1;
                }
                j = j + 1;
            }
        }
        Stmt::Do(effect, op, args, line) => {
            var i: i64 = 0;
            while i < args.len() {
                collect_generic_calls_expr_with_hint(args.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::RegionBlock(name, budget, is_gpu, is_kv_cache, window_size, body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::ComptimeGen(body, line) => {}
        Stmt::Sandbox(body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Unsafe(body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Txn(body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::GradBlock(var_name, body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Backward(loss, line) => {
            collect_generic_calls_expr_with_hint(loss, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::Query(components, body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Select(cases, default, line) => {
            var i: i64 = 0;
            while i < cases.len() {
                collect_generic_calls_expr_with_hint(cases.get(i).channel, generics, generic_methods, calls, method_calls, current_func, OptType::None);
                var j: i64 = 0;
                while j < cases.get(i).body.len() {
                    collect_generic_calls_stmt_with_hint(cases.get(i).body.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                    j = j + 1;
                }
                i = i + 1;
            }
            match default {
                OptStmts::Some(d) => {
                    var j: i64 = 0;
                    while j < d.len() {
                        collect_generic_calls_stmt_with_hint(d.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                        j = j + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
    }
}

// ─── Walk expressions to find calls to generic functions ─────────────────

pub fn collect_generic_calls_expr_with_hint(
    expr: Expr,
    generics: Vec<GenericFuncEntry>,
    generic_methods: Vec<GenericMethodEntry>,
    calls: &mut Vec<GenericCallEntry>,
    method_calls: &mut Vec<GenericMethodCallEntry>,
    current_func: Func,
    expected_ty: OptType,
) {
    match expr {
        Expr::Call(callee, args) => {
            if generic_funcs_contains(generics, callee) {
                var arg_types: Vec<Type> = Vec::new();
                var i: i64 = 0;
                while i < args.len() {
                    arg_types.push(infer_expr_type_with_hint(args.get(i), current_func, expected_ty));
                    i = i + 1;
                }
                calls.push(GenericCallEntry_new(callee, arg_types));
            }
            var i: i64 = 0;
            while i < args.len() {
                collect_generic_calls_expr_with_hint(args.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Binary(op, left, right) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(left), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(box_expr_deref(right), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Unary(op, inner) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::If(cond, then_block, else_block) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(cond), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < then_block.len() {
                collect_generic_calls_stmt_with_hint(then_block.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        collect_generic_calls_stmt_with_hint(eb.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                        j = j + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Expr::Block(stmts) => {
            var i: i64 = 0;
            while i < stmts.len() {
                collect_generic_calls_stmt_with_hint(stmts.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::FieldAccess(inner, field) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::OptionalFieldAccess(inner, field) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::MethodCall(receiver, method, args) => {
            // Unbox receiver once to avoid codegen issues with repeated box_expr_deref
            var recv_expr: Expr = box_expr_deref(receiver);
            // Check if this is a call to a generic method
            var struct_name: OptStr = infer_receiver_struct_name(recv_expr, current_func);
            match struct_name {
                OptStr::Some(sn) => {
                    if generic_methods_contains(generic_methods, sn, method) {
                        var arg_types: Vec<Type> = Vec::new();
                        var i: i64 = 0;
                        while i < args.len() {
                            arg_types.push(infer_expr_type_with_hint(args.get(i), current_func, expected_ty));
                            i = i + 1;
                        }
                        method_calls.push(GenericMethodCallEntry_new(sn, method, arg_types));
                    }
                }
                OptStr::None => {}
            }
            // Always recurse into receiver and args for nested generic calls
            collect_generic_calls_expr_with_hint(recv_expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < args.len() {
                collect_generic_calls_expr_with_hint(args.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Index(array, index) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(array), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(box_expr_deref(index), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::ArrayLit(elem_type, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                collect_generic_calls_expr_with_hint(elements.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Range(start, end, inclusive) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(start), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(box_expr_deref(end), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::StructLit(name, fields, spread) => {
            var i: i64 = 0;
            while i < fields.len() {
                collect_generic_calls_expr_with_hint(fields.get(i).value, generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
            match spread {
                OptBoxExpr::Some(se) => {
                    collect_generic_calls_expr_with_hint(box_expr_deref(se), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                }
                OptBoxExpr::None => {}
            }
        }
        Expr::Match(e, arms) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(e), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < arms.len() {
                var j: i64 = 0;
                while j < arms.get(i).body.len() {
                    collect_generic_calls_stmt_with_hint(arms.get(i).body.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        Expr::Try(inner) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Coalesce(e, default) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(e), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(box_expr_deref(default), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::IsCheck(inner, type_name) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::TryBlock(body) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Closure(params, body, ret_ty) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Literal(s) => {}
                    FStringPart::Expr(e) => {
                        collect_generic_calls_expr_with_hint(e, generics, generic_methods, calls, method_calls, current_func, OptType::None);
                    }
                }
                i = i + 1;
            }
        }
        Expr::Cast(inner, target_ty) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Asm(template, operands) => {
            var i: i64 = 0;
            while i < operands.len() {
                collect_generic_calls_expr_with_hint(operands.get(i).expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Ref(inner, is_mut) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Deref(inner) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::StrConcat(left, right) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(left), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(box_expr_deref(right), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::TupleLit(exprs) => {
            var i: i64 = 0;
            while i < exprs.len() {
                collect_generic_calls_expr_with_hint(exprs.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::EnumLit(enum_name, variant, args) => {
            var i: i64 = 0;
            while i < args.len() {
                collect_generic_calls_expr_with_hint(args.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Comptime(inner) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::ComptimeBlock(stmts) => {
            var i: i64 = 0;
            while i < stmts.len() {
                collect_generic_calls_stmt_with_hint(stmts.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::ComptimeReflect(op, ty) => {}
        Expr::PipeForward(left, right) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(left), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(box_expr_deref(right), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::QuantCast(inner, target_ty) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Await(inner) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Spawn(inner) => {
            collect_generic_calls_expr_with_hint(box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::IntLit(n) => {}
        Expr::FloatLit(f) => {}
        Expr::StringLit(s) => {}
        Expr::BoolLit(b) => {}
        Expr::Ident(name) => {}
    }
}

// ─── Infer the struct name from a method call receiver ───────────────────

pub fn infer_receiver_struct_name(receiver: Expr, func: Func) -> OptStr {
    var ty: Type = infer_expr_type(receiver, func);
    match ty {
        Type::Named(s) => { return OptStr::Some(s); }
        Type::Generic(name, args) => { return OptStr::Some(name); }
        Type::Ref(inner, is_mut) => {
            match box_type_deref(inner) {
                Type::Named(s) => { return OptStr::Some(s); }
                Type::Generic(name, args) => { return OptStr::Some(name); }
                _ => { return OptStr::None; }
            }
        }
        _ => { return OptStr::None; }
    }
    return OptStr::None;
}

// ─── Type inference with hint fallback ───────────────────────────────────

pub fn infer_expr_type_with_hint(expr: Expr, func: Func, hint: OptType) -> Type {
    var inferred: Type = infer_expr_type(expr, func);
    // If inference produced a Named type (unknown), try the hint
    match inferred {
        Type::Named(_) => {
            match hint {
                OptType::Some(h) => { return h; }
                OptType::None => {}
            }
        }
        _ => {}
    }
    return inferred;
}

// ─── Simple type inference for expressions ───────────────────────────────

pub fn infer_expr_type(expr: Expr, func: Func) -> Type {
    match expr {
        Expr::IntLit(n) => {
            if n > 2147483647 || n < -2147483648 {
                return Type::I64;
            }
            return Type::I32;
        }
        Expr::FloatLit(f) => { return Type::F64; }
        Expr::BoolLit(b) => { return Type::Bool; }
        Expr::StringLit(s) => { return Type::Str; }
        Expr::Ident(name) => {
            // Check function params
            var i: i64 = 0;
            while i < func.params.len() {
                if str_equal(func.params.get(i).name, name) {
                    return func.params.get(i).ty;
                }
                i = i + 1;
            }
            // Check let bindings with explicit type
            i = 0;
            while i < func.body.len() {
                match func.body.get(i) {
                    Stmt::Let(ln, ty, e, is_mut, is_persist, line) => {
                        match ty {
                            OptType::Some(t) => {
                                if str_equal(ln, name) { return t; }
                            }
                            OptType::None => {}
                        }
                    }
                    _ => {}
                }
                i = i + 1;
            }
            // Check let bindings without explicit type — infer from initializer
            i = 0;
            while i < func.body.len() {
                match func.body.get(i) {
                    Stmt::Let(ln, ty, e, is_mut, is_persist, line) => {
                        match ty {
                            OptType::None => {
                                if str_equal(ln, name) {
                                    return infer_expr_type(e, func);
                                }
                            }
                            OptType::Some(_) => {}
                        }
                    }
                    _ => {}
                }
                i = i + 1;
            }
            return Type::Named(name);
        }
        Expr::Cast(inner, target_ty) => { return target_ty; }
        Expr::Asm(template, operands) => {
            // If any operand has Out direction, return I64, else Void
            var i: i64 = 0;
            while i < operands.len() {
                match operands.get(i).direction {
                    AsmDir::Out => { return Type::I64; }
                    AsmDir::In => {}
                }
                i = i + 1;
            }
            return Type::Void;
        }
        Expr::Binary(op, left, right) => {
            match op {
                BinOp::Eq => { return Type::Bool; }
                BinOp::Neq => { return Type::Bool; }
                BinOp::Lt => { return Type::Bool; }
                BinOp::Gt => { return Type::Bool; }
                BinOp::LtEq => { return Type::Bool; }
                BinOp::GtEq => { return Type::Bool; }
                _ => {
                    var lt: Type = infer_expr_type(box_expr_deref(left), func);
                    var rt: Type = infer_expr_type(box_expr_deref(right), func);
                    // If left is not Named, use it; else use right
                    match lt {
                        Type::Named(_) => { return rt; }
                        _ => { return lt; }
                    }
                }
            }
            return Type::I64;
        }
        Expr::Unary(op, inner) => {
            match op {
                UnaryOp::Not => { return Type::Bool; }
                _ => { return infer_expr_type(box_expr_deref(inner), func); }
            }
        }
        Expr::StructLit(name, fields, spread) => { return Type::Named(name); }
        Expr::ArrayLit(elem_type, elements) => {
            return Type::Array(elem_type, elements.len());
        }
        Expr::MethodCall(receiver, method, args) => {
            // For associated function calls like Point::new(x, y),
            // the receiver is Expr::Ident("Point")
            match box_expr_deref(receiver) {
                Expr::Ident(name) => {
                    return Type::Named(name);
                }
                _ => { return infer_expr_type(box_expr_deref(receiver), func); }
            }
        }
        _ => { return Type::I64; }
    }
    return Type::I64;
}
