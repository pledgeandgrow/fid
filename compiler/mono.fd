// --- Rename maps ---------------------------------------------------------
// Rust: HashMap<String, String>
// Fides: Vec<RenameEntry>

pub struct RenameEntry {
    pub from: str,
    pub to: str,
}

pub fn RenameEntry_new(from: str, to: str) -> RenameEntry {
    return RenameEntry {
        from: from, to: to
    };
}

pub fn rename_get(map: Vec<RenameEntry>, key: str) -> OptStr {
    // Return the last match (supports overwrite via push)
    var result: OptStr = OptStr::None;
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).from == key {
            result = OptStr::Some(map.get(i).to);
        }
        i = i + 1;
    }
    return result;
}

pub fn rename_set(map: & mut Vec<RenameEntry>, from: str, to: str) {
    // Fides Vec::get returns a copy, so we can't mutate in place.
    // Just push -- rename_get returns the last match.
    map.push(RenameEntry_new(from, to));
}

pub fn rename_new() -> Vec<RenameEntry> {
    return Vec::new();
}

// --- Call collection types -----------------------------------------------
// Rust: Vec<(String, Vec<Type>)> for generic calls
// Fides: Vec<GenericCallEntry>

pub struct GenericCallEntry {
    pub callee: str,
    pub arg_types: Vec<Type>,
}

pub fn GenericCallEntry_new(callee: str, arg_types: Vec<Type>) -> GenericCallEntry {
    return GenericCallEntry {
        callee: callee, arg_types: arg_types
    };
}

// Rust: Vec<(String, String, Vec<Type>)> for generic method calls
// Fides: Vec<GenericMethodCallEntry>

pub struct GenericMethodCallEntry {
    pub struct_name: str,
    pub method_name: str,
    pub arg_types: Vec<Type>,
    pub recv_ty: Type,
}

pub fn GenericMethodCallEntry_new(struct_name: str, method_name: str, arg_types: Vec<Type>, recv_ty: Type) -> GenericMethodCallEntry {
    return GenericMethodCallEntry {
        struct_name: struct_name, method_name: method_name, arg_types: arg_types, recv_ty: recv_ty,
    };
}

// --- Mangled name for a monomorphized function: name__T1_T2 --------------

pub fn mangle(name: str, subst: Vec<SubstEntry>, type_params: Vec<str>) -> str {
    var type_strs: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < type_params.len() {
        var tp: str = type_params.get(i);
        var ty: Type = Type::Named(tp);
        // Inline lookup to avoid potential parameter passing issues
        var j: i64 = 0;
        while j < subst.len() {
            if subst.get(j).key == tp {
                ty = subst.get(j).val;
            }
            j = j + 1;
        }
        type_strs.push(mangle_type(ty));
        i = i + 1;
    }
    return name + "__" + str_join(type_strs, "_");
}

/// Mangled name for a monomorphized generic method: StructName__methodName__T1_T2
pub fn mangle_method(struct_name: str, method_name: str, subst: Vec<SubstEntry>, type_params: Vec<str>) -> str {
    var type_strs: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < type_params.len() {
        var tp: str = type_params.get(i);
        var ty: Type = Type::Named(tp);
        var j: i64 = 0;
        while j < subst.len() {
            if subst.get(j).key == tp {
                ty = subst.get(j).val;
            }
            j = j + 1;
        }
        type_strs.push(mangle_type(ty));
        i = i + 1;
    }
    return struct_name + "__" + method_name + "__" + str_join(type_strs, "_");
}

// --- str_join helper (joins Vec<str> with separator) ---------------------

// --- Short type name for mangling ----------------------------------------

pub fn mangle_type(ty: Type) -> str {
    match ty {
        Type::I8 => {
            return "i8";
        }
        Type::I16 => {
            return "i16";
        }
        Type::I32 => {
            return "i32";
        }
        Type::I64 => {
            return "i64";
        }
        Type::I128 => {
            return "i128";
        }
        Type::U8 => {
            return "u8";
        }
        Type::U16 => {
            return "u16";
        }
        Type::U32 => {
            return "u32";
        }
        Type::U64 => {
            return "u64";
        }
        Type::U128 => {
            return "u128";
        }
        Type::F32 => {
            return "f32";
        }
        Type::F64 => {
            return "f64";
        }
        Type::Bool => {
            return "bool";
        }
        Type::Str => {
            return "str";
        }
        Type::Void => {
            return "void";
        }
        Type::Never => {
            return "never";
        }
        Type::Infer => {
            return "infer";
        }
        Type::Named(s) => {
            return s;
        }
        Type::Generic(name, args) => {
            var args_str: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                args_str.push(mangle_type(args.get(i)));
                i = i + 1;
            }
            return name + "__" + str_join(args_str, "_");
        }
        Type::Ref(inner, is_mut) => {
            var mut_str: str = "const";
            if is_mut {
                mut_str = "mut";
            }
            return "ref_" + mut_str + "_" + mangle_type(box_type_deref(inner));
        }
        Type::RawPtr(inner, is_mut) => {
            var mut_str: str = "const";
            if is_mut {
                mut_str = "mut";
            }
            return "rawptr_" + mut_str + "_" + mangle_type(box_type_deref(inner));
        }
        Type::Array(elem, _) => {
            return "arr_" + mangle_type(box_type_deref(elem));
        }
        Type::ArrayConst(elem, size_param) => {
            return "arrc_" + mangle_type(box_type_deref(elem)) + "_" + size_param;
        }
        Type::Tuple(types) => {
            var parts: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                parts.push(mangle_type(types.get(i)));
                i = i + 1;
            }
            return "tup_" + str_join(parts, "_");
        }
        Type::Func(params, ret) => {
            var p: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < params.len() {
                p.push(mangle_type(params.get(i)));
                i = i + 1;
            }
            return "fn_" + str_join(p, "_") + "_" + mangle_type(box_type_deref(ret));
        }
        Type::Assoc(_, trait_name, name, _) => {
            return "assoc_" + trait_name + "_" + name;
        }
        Type::Dyn(name) => {
            return "dyn_" + name;
        }
        Type::ShapedTensor(elem, shape) => {
            var shape_str: Vec<str> = Vec::new();
            var i: i64 = 0;
            while i < shape.len() {
                match shape.get(i) {
                    ShapeDim::Known(n) => {
                        shape_str.push(int_to_str(n));
                    }
                    ShapeDim::Symbolic(s) => {
                        shape_str.push(s);
                    }
                }
                i = i + 1;
            }
            return "tensor_" + mangle_type(box_type_deref(elem)) + "_" + str_join(shape_str, "_");
        }
    }
    return "unknown";
}

// --- Box<Type> deref helper ----------------------------------------------

fn box_type_deref(b: Box<Type>) -> Type {
    match b {
        Type::I8 => {
            return Type::I8;
        }
        Type::I16 => {
            return Type::I16;
        }
        Type::I32 => {
            return Type::I32;
        }
        Type::I64 => {
            return Type::I64;
        }
        Type::I128 => {
            return Type::I128;
        }
        Type::U8 => {
            return Type::U8;
        }
        Type::U16 => {
            return Type::U16;
        }
        Type::U32 => {
            return Type::U32;
        }
        Type::U64 => {
            return Type::U64;
        }
        Type::U128 => {
            return Type::U128;
        }
        Type::F32 => {
            return Type::F32;
        }
        Type::F64 => {
            return Type::F64;
        }
        Type::Bool => {
            return Type::Bool;
        }
        Type::Str => {
            return Type::Str;
        }
        Type::Void => {
            return Type::Void;
        }
        Type::Never => {
            return Type::Never;
        }
        Type::Infer => {
            return Type::Infer;
        }
        Type::Named(n) => {
            return Type::Named(n);
        }
        Type::Array(e, s) => {
            return Type::Array(e, s);
        }
        Type::ArrayConst(e, s) => {
            return Type::ArrayConst(e, s);
        }
        Type::Ref(e, m) => {
            return Type::Ref(e, m);
        }
        Type::RawPtr(e, m) => {
            return Type::RawPtr(e, m);
        }
        Type::Generic(n, a) => {
            return Type::Generic(n, a);
        }
        Type::Tuple(a) => {
            return Type::Tuple(a);
        }
        Type::Func(a, r) => {
            return Type::Func(a, r);
        }
        Type::Assoc(a, b2, c, d) => {
            return Type::Assoc(a, b2, c, d);
        }
        Type::Dyn(n) => {
            return Type::Dyn(n);
        }
        Type::ShapedTensor(e, d) => {
            return Type::ShapedTensor(e, d);
        }
    }
    return Type::Void;
}

// --- Apply a substitution to a type --------------------------------------

pub fn subst_type(ty: Type, subst: Vec<SubstEntry>) -> Type {
    match ty {
        Type::Named(name) => {
            match subst_get(subst, name) {
                OptType::Some(replacement) => {
                    return replacement;
                }
                OptType::None => {
                    return ty;
                }
            }
            return ty;
        }
        Type::Array(elem, size) => {
            return Type::Array(box_type_new(subst_type(box_type_deref(elem), subst)), size);
        }
        Type::ArrayConst(elem, size_param) => {
            // If the const param is in the substitution, resolve it to a concrete size
            match subst_get(subst, size_param) {
                OptType::Some(replacement) => {
                    match replacement {
                        Type::Named(name) => {
                            // Check for __const_ prefix
                            if str_starts_with(name, "__const_") {
                                var size_str: str = str_slice(name, 8, str_len(name));
                                var size: i64 = str_parse_int(size_str);
                                if size >= 0 {
                                    return Type::Array(box_type_new(subst_type(box_type_deref(elem), subst)), size);
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptType::None => {
                }
            }
            return Type::ArrayConst(box_type_new(subst_type(box_type_deref(elem), subst)), size_param);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(box_type_new(subst_type(box_type_deref(inner), subst)), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(box_type_new(subst_type(box_type_deref(inner), subst)), is_mut);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(subst_type(args.get(i), subst));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(subst_type(types.get(i), subst));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        Type::Func(params, ret) => {
            var new_params: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < params.len() {
                new_params.push(subst_type(params.get(i), subst));
                i = i + 1;
            }
            return Type::Func(new_params, box_type_new(subst_type(box_type_deref(ret), subst)));
        }
        _ => {
            return ty;
        }
    }
    return ty;
}

// --- Box<Type> constructor helper ----------------------------------------

fn box_type_new(ty: Type) -> Box<Type> {
    return Box::new(ty);
}

// --- Box<Expr> constructor/deref helpers ---------------------------------

pub fn mn_box_expr_new(e: Expr) -> Box<Expr> {
    return Box::new(e);
}

pub fn mn_box_expr_deref(b: Box<Expr>) -> Expr {
    match b {
        Expr::IntLit(v) => {
            return Expr::IntLit(v);
        }
        Expr::FloatLit(v) => {
            return Expr::FloatLit(v);
        }
        Expr::StringLit(v) => {
            return Expr::StringLit(v);
        }
        Expr::BoolLit(v) => {
            return Expr::BoolLit(v);
        }
        Expr::Ident(n) => {
            return Expr::Ident(n);
        }
        Expr::Binary(op, l, r) => {
            return Expr::Binary(op, l, r);
        }
        Expr::Unary(op, e) => {
            return Expr::Unary(op, e);
        }
        Expr::Call(n, a) => {
            return Expr::Call(n, a);
        }
        Expr::FieldAccess(e, f) => {
            return Expr::FieldAccess(e, f);
        }
        Expr::OptionalFieldAccess(e, f) => {
            return Expr::OptionalFieldAccess(e, f);
        }
        Expr::StructLit(n, f, s) => {
            return Expr::StructLit(n, f, s);
        }
        Expr::If(c, t, e) => {
            return Expr::If(c, t, e);
        }
        Expr::Range(s, e2, i) => {
            return Expr::Range(s, e2, i);
        }
        Expr::Block(s) => {
            return Expr::Block(s);
        }
        Expr::MethodCall(r, m, a) => {
            return Expr::MethodCall(r, m, a);
        }
        Expr::ArrayLit(t, e) => {
            return Expr::ArrayLit(t, e);
        }
        Expr::Index(a, i) => {
            return Expr::Index(a, i);
        }
        Expr::FString(p) => {
            return Expr::FString(p);
        }
        Expr::Match(e, a) => {
            return Expr::Match(e, a);
        }
        Expr::EnumLit(en, v, a) => {
            return Expr::EnumLit(en, v, a);
        }
        Expr::Ref(e, m) => {
            return Expr::Ref(e, m);
        }
        Expr::Deref(e) => {
            return Expr::Deref(e);
        }
        Expr::StrConcat(l, r) => {
            return Expr::StrConcat(l, r);
        }
        Expr::Try(e) => {
            return Expr::Try(e);
        }
        Expr::Coalesce(e, d) => {
            return Expr::Coalesce(e, d);
        }
        Expr::IsCheck(e, t) => {
            return Expr::IsCheck(e, t);
        }
        Expr::TryBlock(b) => {
            return Expr::TryBlock(b);
        }
        Expr::TupleLit(e) => {
            return Expr::TupleLit(e);
        }
        Expr::Closure(p, b, r) => {
            return Expr::Closure(p, b, r);
        }
        Expr::Cast(e, t) => {
            return Expr::Cast(e, t);
        }
        Expr::Asm(t, o) => {
            return Expr::Asm(t, o);
        }
        Expr::Comptime(e) => {
            return Expr::Comptime(e);
        }
        Expr::ComptimeBlock(s) => {
            return Expr::ComptimeBlock(s);
        }
        Expr::ComptimeReflect(op, t) => {
            return Expr::ComptimeReflect(op, t);
        }
        Expr::PipeForward(l, r) => {
            return Expr::PipeForward(l, r);
        }
        Expr::QuantCast(e, t) => {
            return Expr::QuantCast(e, t);
        }
        Expr::Await(e) => {
            return Expr::Await(e);
        }
        Expr::Spawn(e) => {
            return Expr::Spawn(e);
        }
        Expr::Yield(e) => {
            return Expr::Yield(e);
        }
        Expr::NamedArg(name, e) => {
            return Expr::NamedArg(name, e);
        }
    }
    return Expr::IntLit(0);
}

// --- Substitute GAT type arguments into a resolved associated type -------

fn subst_gat_type_args(ty: Type, args: Vec<Type>, subst: Vec<SubstEntry>) -> Type {
    match ty {
        Type::Named(_) => {
            return ty;
        }
        Type::Generic(name, inner_args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < inner_args.len() {
                var a: Type = inner_args.get(i);
                match a {
                    Type::Named(n) => {
                        // Check if it's a single-char uppercase type param
                        if str_len(n) == 1 {
                            var c: i64 = str_byte_at(n, 0);
                            // 'A'..'Z' = 65..90
                            if c >= 65 && c <= 90 {
                                if args.len() > 0 {
                                    new_args.push(args.get(0));
                                } else {
                                    new_args.push(a);
                                }
                            } else {
                                new_args.push(subst_gat_type_args(a, args, subst));
                            }
                        } else {
                            new_args.push(subst_gat_type_args(a, args, subst));
                        }
                    }
                    _ => {
                        new_args.push(subst_gat_type_args(a, args, subst));
                    }
                }
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Array(elem, size) => {
            return Type::Array(box_type_new(subst_gat_type_args(box_type_deref(elem), args, subst)), size);
        }
        Type::ArrayConst(elem, size_param) => {
            if args.len() > 0 {
                match args.get(0) {
                    Type::Named(n) => {
                        if n == size_param {
                            return Type::ArrayConst(box_type_new(subst_gat_type_args(box_type_deref(elem), args, subst)), size_param);
                        }
                    }
                    _ => {
                    }
                }
            }
            return Type::ArrayConst(box_type_new(subst_gat_type_args(box_type_deref(elem), args, subst)), size_param);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(box_type_new(subst_gat_type_args(box_type_deref(inner), args, subst)), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(box_type_new(subst_gat_type_args(box_type_deref(inner), args, subst)), is_mut);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(subst_gat_type_args(types.get(i), args, subst));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        _ => {
            return ty;
        }
    }
    return ty;
}

// --- Resolve Type::Assoc using substitution and trait impl bindings ------

fn resolve_assoc_types(ty: Type, subst: Vec<SubstEntry>, bindings: Vec<TraitAssocEntry>) -> Type {
    match ty {
        Type::Assoc(type_param, trait_name, assoc_name, type_args) => {
            match subst_get(subst, type_param) {
                OptType::Some(concrete) => {
                    var concrete_name: str = "";
                    match concrete {
                        Type::Named(n) => {
                            concrete_name = n;
                        }
                        _ => {
                            return Type::I64;
                        }
                    }
                    // If trait_name is empty, search all bindings for this type+assoc_name
                    if str_len(trait_name) == 0 {
                        var i: i64 = 0;
                        while i < bindings.len() {
                            var entry: TraitAssocEntry = bindings.get(i);
                            if entry.type_name == concrete_name {
                                match assoc_bindings_get(entry.bindings, assoc_name) {
                                    OptType::Some(resolved) => {
                                        if type_args.len() > 0 {
                                            return subst_gat_type_args(resolved, type_args, subst);
                                        }
                                        return resolved;
                                    }
                                    OptType::None => {
                                    }
                                }
                            }
                            i = i + 1;
                        }
                    } else {
                        match trait_assoc_get(bindings, trait_name, concrete_name) {
                            OptVecAssocBinding::Some(assoc_map) => {
                                match assoc_bindings_get(assoc_map, assoc_name) {
                                    OptType::Some(resolved) => {
                                        if type_args.len() > 0 {
                                            return subst_gat_type_args(resolved, type_args, subst);
                                        }
                                        return resolved;
                                    }
                                    OptType::None => {
                                    }
                                }
                            }
                            OptVecAssocBinding::None => {
                            }
                        }
                    }
                }
                OptType::None => {
                }
            }
            return Type::I64;
        }
        Type::Array(elem, size) => {
            return Type::Array(box_type_new(resolve_assoc_types(box_type_deref(elem), subst, bindings)), size);
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(box_type_new(resolve_assoc_types(box_type_deref(inner), subst, bindings)), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(box_type_new(resolve_assoc_types(box_type_deref(inner), subst, bindings)), is_mut);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(resolve_assoc_types(args.get(i), subst, bindings));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        Type::Tuple(types) => {
            var new_types: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < types.len() {
                new_types.push(resolve_assoc_types(types.get(i), subst, bindings));
                i = i + 1;
            }
            return Type::Tuple(new_types);
        }
        Type::Func(params, ret) => {
            var new_params: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < params.len() {
                new_params.push(resolve_assoc_types(params.get(i), subst, bindings));
                i = i + 1;
            }
            return Type::Func(new_params, box_type_new(resolve_assoc_types(box_type_deref(ret), subst, bindings)));
        }
        _ => {
            return ty;
        }
    }
    return ty;
}

// --- Apply substitution to an expression ---------------------------------
// Rewrites call sites (using renames) and type annotations (using subst)

pub fn subst_expr(expr: Expr, subst: Vec<SubstEntry>, renames: Vec<RenameEntry>, method_renames: Vec<RenameEntry>,) -> Expr {
    match expr {
        Expr::Call(callee, args) => {
            var new_args: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            // L8E: the pack being written out passed on as the last argument
            // of a variadic function (a pack or a Vec variadic): its
            // elements xs__0 .. xs__<m-1> become that call's last arguments
            var fwd: bool = false;
            if g_mono_pack_var != "" && args.len() > 0 {
                if mono_is_ident(args.get(args.len() - 1), g_mono_pack_var) {
                    fwd = mono_pack_fwd_ok(callee);
                }
            }
            var n_own: i64 = args.len();
            if fwd {
                n_own = args.len() - 1;
            }
            while i < n_own {
                new_args.push(subst_expr(args.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            if fwd {
                var fk: i64 = 0;
                while fk < g_mono_pack_n {
                    new_args.push(Expr::Ident(g_mono_pack_var + "__" + int_to_str(fk)));
                    fk = fk + 1;
                }
            }
            var new_callee: str = callee;
            match rename_get(renames, callee) {
                OptStr::Some(r) => {
                    new_callee = r;
                }
                OptStr::None => {
                }
            }
            return Expr::Call(new_callee, new_args);
        }
        Expr::Ident(s) => {
            // L8E: the pack being written out read any other way (xs[i],
            // xs.get(i), passed as a value): it has no single type
            if g_mono_pack_var != "" && s == g_mono_pack_var {
                mono_pack_misuse();
            }
            // Check if this is a const generic param being substituted
            match subst_get(subst, s) {
                OptType::Some(replacement) => {
                    match replacement {
                        Type::Named(name) => {
                            if str_starts_with(name, "__const_") {
                                var size_str: str = str_slice(name, 8, str_len(name));
                                var val: i64 = str_parse_int(size_str);
                                return Expr::IntLit(val);
                            }
                        }
                        _ => {
                        }
                    }
                }
                OptType::None => {
                }
            }
            return Expr::Ident(s);
        }
        Expr::IntLit(n) => {
            return Expr::IntLit(n);
        }
        Expr::FloatLit(f) => {
            return Expr::FloatLit(f);
        }
        Expr::BoolLit(b) => {
            return Expr::BoolLit(b);
        }
        Expr::StringLit(s) => {
            return Expr::StringLit(s);
        }
        Expr::Binary(op, left, right) => {
            return Expr::Binary(op, mn_box_expr_new(subst_expr(mn_box_expr_deref(left), subst, renames, method_renames)), mn_box_expr_new(subst_expr(mn_box_expr_deref(right), subst, renames, method_renames)));
        }
        Expr::Unary(op, operand) => {
            return Expr::Unary(op, mn_box_expr_new(subst_expr(mn_box_expr_deref(operand), subst, renames, method_renames)));
        }
        Expr::If(cond, then_block, else_block) => {
            var new_then: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < then_block.len() {
                new_then.push(subst_stmt(then_block.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            var new_else: OptStmts = OptStmts::None;
            match else_block {
                OptStmts::Some(eb) => {
                    var new_eb: Vec<Stmt> = Vec::new();
                    var j: i64 = 0;
                    while j < eb.len() {
                        new_eb.push(subst_stmt(eb.get(j), subst, renames, method_renames));
                        j = j + 1;
                    }
                    new_else = OptStmts::Some(new_eb);
                }
                OptStmts::None => {
                }
            }
            return Expr::If(mn_box_expr_new(subst_expr(mn_box_expr_deref(cond), subst, renames, method_renames)), new_then, new_else);
        }
        Expr::Block(stmts) => {
            var new_stmts: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < stmts.len() {
                new_stmts.push(subst_stmt(stmts.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::Block(new_stmts);
        }
        Expr::FieldAccess(e, field) => {
            return Expr::FieldAccess(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames)), field);
        }
        Expr::OptionalFieldAccess(e, field) => {
            return Expr::OptionalFieldAccess(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames)), field);
        }
        Expr::MethodCall(receiver, method, args) => {
            // Check if this method call should be rewritten to a monomorphized function call
            match rename_get(method_renames, method) {
                OptStr::Some(mangled) => {
                    // Rewrite to a regular Call with receiver as first arg
                    var all_args: Vec<Expr> = Vec::new();
                    all_args.push(subst_expr(mn_box_expr_deref(receiver), subst, renames, method_renames));
                    var i: i64 = 0;
                    while i < args.len() {
                        all_args.push(subst_expr(args.get(i), subst, renames, method_renames));
                        i = i + 1;
                    }
                    return Expr::Call(mangled, all_args);
                }
                OptStr::None => {
                    var new_args: Vec<Expr> = Vec::new();
                    var i: i64 = 0;
                    while i < args.len() {
                        new_args.push(subst_expr(args.get(i), subst, renames, method_renames));
                        i = i + 1;
                    }
                    // L8E: xs.len() / xs.get(K) of the pack being written out
                    if g_mono_pack_var != "" && mono_is_ident(mn_box_expr_deref(receiver), g_mono_pack_var) {
                        if method == "len" && new_args.len() == 0 {
                            return Expr::IntLit(g_mono_pack_n);
                        }
                        if method == "get" && new_args.len() == 1 {
                            match new_args.get(0) {
                                Expr::IntLit(pk) => {
                                    if pk >= 0 && pk < g_mono_pack_n {
                                        return Expr::Ident(g_mono_pack_var + "__" + int_to_str(pk));
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    return Expr::MethodCall(mn_box_expr_new(subst_expr(mn_box_expr_deref(receiver), subst, renames, method_renames)), method, new_args);
                }
            }
            return Expr::MethodCall(receiver, method, args);
        }
        Expr::Index(array, index) => {
            return Expr::Index(mn_box_expr_new(subst_expr(mn_box_expr_deref(array), subst, renames, method_renames)), mn_box_expr_new(subst_expr(mn_box_expr_deref(index), subst, renames, method_renames)));
        }
        Expr::ArrayLit(elem_type, elements) => {
            var new_elements: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < elements.len() {
                new_elements.push(subst_expr(elements.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::ArrayLit(box_type_new(subst_type(box_type_deref(elem_type), subst)), new_elements);
        }
        Expr::Range(start, end, inclusive) => {
            return Expr::Range(mn_box_expr_new(subst_expr(mn_box_expr_deref(start), subst, renames, method_renames)), mn_box_expr_new(subst_expr(mn_box_expr_deref(end), subst, renames, method_renames)), inclusive);
        }
        _ => {
            return subst_expr_part2(expr, subst, renames, method_renames);
        }
    }
    return expr;
}

fn subst_expr_part2(expr: Expr, subst: Vec<SubstEntry>, renames: Vec<RenameEntry>, method_renames: Vec<RenameEntry>,) -> Expr {
    match expr {
        Expr::StructLit(name, fields, spread) => {
            // CL5: `S { a: 1, .. }` -- the defaults of the fields left out
            // are written in (before substitution, so a default holding a
            // literal of its own is filled too)
            var all_fields: Vec<FieldInit> = fields;
            var fill_depth_in: bool = false;
            var new_spread: OptBoxExpr = OptBoxExpr::None;
            match spread {
                OptBoxExpr::Some(e) => {
                    var se: Expr = mn_box_expr_deref(e);
                    if ast_is_spread_defaults(se) {
                        if g_mono_fill_defaults && g_mono_fill_depth < 32 {
                            all_fields = mn_fill_struct_defaults(name, fields);
                            g_mono_fill_depth = g_mono_fill_depth + 1;
                            fill_depth_in = true;
                        } else if !g_mono_fill_defaults {
                            // not monomorphization (a rename pass before
                            // type checking): keep the marker for later
                            new_spread = OptBoxExpr::Some(mn_box_expr_new(se));
                        }
                    } else {
                        new_spread = OptBoxExpr::Some(mn_box_expr_new(subst_expr(se, subst, renames, method_renames)));
                    }
                }
                OptBoxExpr::None => {
                }
            }
            var new_fields: Vec<FieldInit> = Vec::new();
            var i: i64 = 0;
            while i < all_fields.len() {
                new_fields.push(FieldInit_new(all_fields.get(i).name, subst_expr(all_fields.get(i).value, subst, renames, method_renames)));
                i = i + 1;
            }
            if fill_depth_in {
                g_mono_fill_depth = g_mono_fill_depth - 1;
            }
            return Expr::StructLit(name, new_fields, new_spread);
        }
        Expr::Match(e, arms) => {
            var new_arms: Vec<MatchArm> = Vec::new();
            var i: i64 = 0;
            while i < arms.len() {
                var arm: MatchArm = arms.get(i);
                var new_guard: OptBoxExpr = OptBoxExpr::None;
                match arm.guard {
                    OptBoxExpr::Some(g) => {
                        new_guard = OptBoxExpr::Some(mn_box_expr_new(subst_expr(mn_box_expr_deref(g), subst, renames, method_renames)));
                    }
                    OptBoxExpr::None => {
                    }
                }
                var new_body: Vec<Stmt> = Vec::new();
                var j: i64 = 0;
                while j < arm.body.len() {
                    new_body.push(subst_stmt(arm.body.get(j), subst, renames, method_renames));
                    j = j + 1;
                }
                new_arms.push(MatchArm_new(arm.pattern, new_guard, new_body));
                i = i + 1;
            }
            return Expr::Match(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames)), new_arms);
        }
        Expr::Try(e) => {
            return Expr::Try(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames)));
        }
        Expr::Coalesce(e, default) => {
            return Expr::Coalesce(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames)), mn_box_expr_new(subst_expr(mn_box_expr_deref(default), subst, renames, method_renames)));
        }
        Expr::IsCheck(e, type_name) => {
            return Expr::IsCheck(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames)), type_name);
        }
        Expr::TryBlock(body) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::TryBlock(new_body);
        }
        Expr::Closure(params, body, ret_ty) => {
            var new_params: Vec<Param> = Vec::new();
            var i: i64 = 0;
            while i < params.len() {
                var p: Param = Param_new(params.get(i).name, subst_type(params.get(i).ty, subst), params.get(i).is_pub);
                p.annotations = params.get(i).annotations;
                p.is_variadic = params.get(i).is_variadic;
                new_params.push(p);
                i = i + 1;
            }
            var new_body: Vec<Stmt> = Vec::new();
            var j: i64 = 0;
            while j < body.len() {
                new_body.push(subst_stmt(body.get(j), subst, renames, method_renames));
                j = j + 1;
            }
            var new_ret: OptType = OptType::None;
            match ret_ty {
                OptType::Some(t) => {
                    new_ret = OptType::Some(subst_type(t, subst));
                }
                OptType::None => {
                }
            }
            return Expr::Closure(new_params, new_body, new_ret);
        }
        Expr::FString(parts) => {
            var new_parts: Vec<FStringPart> = Vec::new();
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Literal(s) => {
                        new_parts.push(FStringPart::Literal(s));
                    }
                    FStringPart::Expr(e) => {
                        new_parts.push(FStringPart::Expr(subst_expr(e, subst, renames, method_renames)));
                    }
                }
                i = i + 1;
            }
            return Expr::FString(new_parts);
        }
        Expr::Cast(e, target_ty) => {
            return Expr::Cast(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames)), subst_type(target_ty, subst));
        }
        Expr::Asm(template, operands) => {
            var new_operands: Vec<AsmOperand> = Vec::new();
            var i: i64 = 0;
            while i < operands.len() {
                new_operands.push(AsmOperand_new(operands.get(i).direction, operands.get(i).reg, subst_expr(operands.get(i).expr, subst, renames, method_renames)));
                i = i + 1;
            }
            return Expr::Asm(template, new_operands);
        }
        Expr::Ref(e, is_mut) => {
            return Expr::Ref(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames)), is_mut);
        }
        Expr::Deref(e) => {
            return Expr::Deref(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames)));
        }
        Expr::StrConcat(left, right) => {
            return Expr::StrConcat(mn_box_expr_new(subst_expr(mn_box_expr_deref(left), subst, renames, method_renames)), mn_box_expr_new(subst_expr(mn_box_expr_deref(right), subst, renames, method_renames)));
        }
        Expr::TupleLit(exprs) => {
            var new_exprs: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < exprs.len() {
                new_exprs.push(subst_expr(exprs.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::TupleLit(new_exprs);
        }
        Expr::EnumLit(enum_name, variant, args) => {
            var new_args: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(subst_expr(args.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::EnumLit(enum_name, variant, new_args);
        }
        Expr::Comptime(inner) => {
            return Expr::Comptime(mn_box_expr_new(subst_expr(mn_box_expr_deref(inner), subst, renames, method_renames)));
        }
        Expr::ComptimeBlock(stmts) => {
            var new_stmts: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < stmts.len() {
                new_stmts.push(subst_stmt(stmts.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Expr::ComptimeBlock(new_stmts);
        }
        Expr::ComptimeReflect(op, ty) => {
            return Expr::ComptimeReflect(op, subst_type(ty, subst));
        }
        Expr::PipeForward(left, right) => {
            return Expr::PipeForward(mn_box_expr_new(subst_expr(mn_box_expr_deref(left), subst, renames, method_renames)), mn_box_expr_new(subst_expr(mn_box_expr_deref(right), subst, renames, method_renames)));
        }
        Expr::QuantCast(e, target_ty) => {
            return Expr::QuantCast(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames)), subst_type(target_ty, subst));
        }
        Expr::Await(inner) => {
            return Expr::Await(mn_box_expr_new(subst_expr(mn_box_expr_deref(inner), subst, renames, method_renames)));
        }
        Expr::Spawn(inner) => {
            return Expr::Spawn(mn_box_expr_new(subst_expr(mn_box_expr_deref(inner), subst, renames, method_renames)));
        }
        Expr::Yield(inner) => {
            return Expr::Yield(mn_box_expr_new(subst_expr(mn_box_expr_deref(inner), subst, renames, method_renames)));
        }
        Expr::NamedArg(name, inner) => {
            return Expr::NamedArg(name, Box::new(subst_expr(mn_box_expr_deref(inner), subst, renames, method_renames)));
        }
        _ => {
        }
    }
    return expr;
}

// --- Apply substitution to a statement -----------------------------------

pub fn subst_stmt(stmt: Stmt, subst: Vec<SubstEntry>, renames: Vec<RenameEntry>, method_renames: Vec<RenameEntry>,) -> Stmt {
    match stmt {
        Stmt::Let(name, ty, expr, is_mut, is_persist, annotations, line) => {
            var new_ty: OptType = OptType::None;
            match ty {
                OptType::Some(t) => {
                    new_ty = OptType::Some(subst_type(t, subst));
                }
                OptType::None => {
                }
            }
            return Stmt::Let(name, new_ty, subst_expr(expr, subst, renames, method_renames), is_mut, is_persist, annotations, line);
        }
        Stmt::LetUninit(name, ty, annotations, line) => {
            return Stmt::LetUninit(name, subst_type(ty, subst), annotations, line);
        }
        Stmt::LetTuple(names, expr, line) => {
            return Stmt::LetTuple(names, subst_expr(expr, subst, renames, method_renames), line);
        }
        Stmt::Assign(target, op, expr, line) => {
            return Stmt::Assign(target, op, subst_expr(expr, subst, renames, method_renames), line);
        }
        Stmt::IndexAssign(array, index, op, expr, line) => {
            return Stmt::IndexAssign(array, subst_expr(index, subst, renames, method_renames), op, subst_expr(expr, subst, renames, method_renames), line);
        }
        Stmt::DerefAssign(ptr_expr, op, expr, line) => {
            return Stmt::DerefAssign(subst_expr(ptr_expr, subst, renames, method_renames), op, subst_expr(expr, subst, renames, method_renames), line);
        }
        Stmt::FieldAssign(object, field, op, expr, line) => {
            return Stmt::FieldAssign(subst_expr(object, subst, renames, method_renames), field, op, subst_expr(expr, subst, renames, method_renames), line);
        }
        Stmt::Expr(e, line) => {
            return Stmt::Expr(subst_expr(e, subst, renames, method_renames), line);
        }
        Stmt::Return(opt, line) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    return Stmt::Return(OptBoxExpr::Some(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames))), line);
                }
                OptBoxExpr::None => {
                    return Stmt::Return(OptBoxExpr::None, line);
                }
            }
            return Stmt::Return(OptBoxExpr::None, line);
        }
        Stmt::If(cond, then_block, else_block, line) => {
            var new_then: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < then_block.len() {
                new_then.push(subst_stmt(then_block.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            var new_else: OptStmts = OptStmts::None;
            match else_block {
                OptStmts::Some(eb) => {
                    var new_eb: Vec<Stmt> = Vec::new();
                    var j: i64 = 0;
                    while j < eb.len() {
                        new_eb.push(subst_stmt(eb.get(j), subst, renames, method_renames));
                        j = j + 1;
                    }
                    new_else = OptStmts::Some(new_eb);
                }
                OptStmts::None => {
                }
            }
            return Stmt::If(subst_expr(cond, subst, renames, method_renames), new_then, new_else, line);
        }
        Stmt::While(cond, body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::While(subst_expr(cond, subst, renames, method_renames), new_body, line);
        }
        Stmt::For(var_name, iterator, body, line) => {
            // L8E: a loop over the pack being written out is unrolled
            if g_mono_pack_var != "" && mono_is_ident(iterator, g_mono_pack_var) {
                return mono_pack_unroll(var_name, body, line, subst, renames, method_renames);
            }
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::For(var_name, subst_expr(iterator, subst, renames, method_renames), new_body, line);
        }
        Stmt::Loop(body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Loop(new_body, line);
        }
        Stmt::Break(opt, line) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    return Stmt::Break(OptBoxExpr::Some(mn_box_expr_new(subst_expr(mn_box_expr_deref(e), subst, renames, method_renames))), line);
                }
                OptBoxExpr::None => {
                    return Stmt::Break(OptBoxExpr::None, line);
                }
            }
            return Stmt::Break(OptBoxExpr::None, line);
        }
        Stmt::Continue(line) => {
            return Stmt::Continue(line);
        }
        Stmt::Defer(body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Defer(new_body, line);
        }
        Stmt::Match(_, _, _) => {
            return subst_stmt_part2(stmt, subst, renames, method_renames);
        }
        _ => {
            return subst_stmt_part2(stmt, subst, renames, method_renames);
        }
    }
    return stmt;
}

fn subst_stmt_part2(stmt: Stmt, subst: Vec<SubstEntry>, renames: Vec<RenameEntry>, method_renames: Vec<RenameEntry>,) -> Stmt {
    match stmt {
        Stmt::Match(e, arms, line) => {
            var new_arms: Vec<MatchArm> = Vec::new();
            var i: i64 = 0;
            while i < arms.len() {
                var arm: MatchArm = arms.get(i);
                var new_guard: OptBoxExpr = OptBoxExpr::None;
                match arm.guard {
                    OptBoxExpr::Some(g) => {
                        new_guard = OptBoxExpr::Some(mn_box_expr_new(subst_expr(mn_box_expr_deref(g), subst, renames, method_renames)));
                    }
                    OptBoxExpr::None => {
                    }
                }
                var new_body: Vec<Stmt> = Vec::new();
                var j: i64 = 0;
                while j < arm.body.len() {
                    new_body.push(subst_stmt(arm.body.get(j), subst, renames, method_renames));
                    j = j + 1;
                }
                new_arms.push(MatchArm_new(arm.pattern, new_guard, new_body));
                i = i + 1;
            }
            return Stmt::Match(subst_expr(e, subst, renames, method_renames), new_arms, line);
        }
        Stmt::Use(path, items, line) => {
            return Stmt::Use(path, items, line);
        }
        Stmt::Handle(body, handlers, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            var new_handlers: Vec<EffectHandler> = Vec::new();
            var j: i64 = 0;
            while j < handlers.len() {
                var h: EffectHandler = handlers.get(j);
                var new_h_body: Vec<Stmt> = Vec::new();
                var k: i64 = 0;
                while k < h.body.len() {
                    new_h_body.push(subst_stmt(h.body.get(k), subst, renames, method_renames));
                    k = k + 1;
                }
                new_handlers.push(EffectHandler_new(h.effect, h.op, h.params, new_h_body));
                j = j + 1;
            }
            return Stmt::Handle(new_body, new_handlers, line);
        }
        Stmt::Do(effect, op, args, line) => {
            var new_args: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(subst_expr(args.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Do(effect, op, new_args, line);
        }
        Stmt::RegionBlock(name, budget, is_gpu, is_kv_cache, window_size, body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::RegionBlock(name, budget, is_gpu, is_kv_cache, window_size, new_body, line);
        }
        Stmt::ComptimeGen(body, line) => {
            return Stmt::ComptimeGen(body, line);
        }
        Stmt::Sandbox(body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Sandbox(new_body, line);
        }
        Stmt::Unsafe(body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Unsafe(new_body, line);
        }
        Stmt::Txn(body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Txn(new_body, line);
        }
        Stmt::GradBlock(var_name, body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::GradBlock(var_name, new_body, line);
        }
        Stmt::Backward(loss, line) => {
            return Stmt::Backward(subst_expr(loss, subst, renames, method_renames), line);
        }
        Stmt::Query(components, body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var i: i64 = 0;
            while i < body.len() {
                new_body.push(subst_stmt(body.get(i), subst, renames, method_renames));
                i = i + 1;
            }
            return Stmt::Query(components, new_body, line);
        }
        Stmt::Select(cases, default, line) => {
            var new_cases: Vec<SelectCase> = Vec::new();
            var i: i64 = 0;
            while i < cases.len() {
                var c: SelectCase = cases.get(i);
                var new_body: Vec<Stmt> = Vec::new();
                var j: i64 = 0;
                while j < c.body.len() {
                    new_body.push(subst_stmt(c.body.get(j), subst, renames, method_renames));
                    j = j + 1;
                }
                new_cases.push(SelectCase_new(subst_expr(c.channel, subst, renames, method_renames), c.var_name, new_body));
                i = i + 1;
            }
            var new_default: OptStmts = OptStmts::None;
            match default {
                OptStmts::Some(d) => {
                    var new_d: Vec<Stmt> = Vec::new();
                    var j: i64 = 0;
                    while j < d.len() {
                        new_d.push(subst_stmt(d.get(j), subst, renames, method_renames));
                        j = j + 1;
                    }
                    new_default = OptStmts::Some(new_d);
                }
                OptStmts::None => {
                }
            }
            return Stmt::Select(new_cases, new_default, line);
        }
        Stmt::Parallel(branches, line) => {
            var new_branches: Vec<Vec<Stmt>> = Vec::new();
            var i: i64 = 0;
            while i < branches.len() {
                var branch: Vec<Stmt> = branches.get(i);
                var new_branch: Vec<Stmt> = Vec::new();
                var j: i64 = 0;
                while j < branch.len() {
                    new_branch.push(subst_stmt(branch.get(j), subst, renames, method_renames));
                    j = j + 1;
                }
                new_branches.push(new_branch);
                i = i + 1;
            }
            return Stmt::Parallel(new_branches, line);
        }
        Stmt::Resume(cont, value, line) => {
            return Stmt::Resume(subst_expr(cont, subst, renames, method_renames), subst_expr(value, subst, renames, method_renames), line);
        }
        Stmt::SpawnScope(body, line) => {
            var new_body: Vec<Stmt> = Vec::new();
            var bi2: i64 = 0;
            while bi2 < body.len() {
                new_body.push(subst_stmt(body.get(bi2), subst, renames, method_renames));
                bi2 = bi2 + 1;
            }
            return Stmt::SpawnScope(new_body, line);
        }
        Stmt::CancelScope(line) => {
            return Stmt::CancelScope(line);
        }
        _ => {
        }
    }
    return stmt;
}

// --- Infer type substitution from a call site ----------------------------

pub fn infer_subst(param_types: Vec<Type>, arg_types: Vec<Type>, type_params: Vec<str>,) -> Vec<SubstEntry> {
    var subst: Vec<SubstEntry> = Vec::new();
    var n: i64 = param_types.len();
    if arg_types.len() < n {
        n = arg_types.len();
    }
    var i: i64 = 0;
    while i < n {
        infer_from_pair(param_types.get(i), arg_types.get(i), type_params, & mut subst);
        i = i + 1;
    }
    return subst;
}

// --- Recursively infer type parameter bindings from a (param, arg) pair ---

pub fn infer_from_pair(param: Type, arg: Type, type_params: Vec<str>, subst: & mut Vec<SubstEntry>) {
    match param {
        Type::Named(name) => {
            if str_vec_contains(type_params, name) {
                subst_set(subst, name, arg);
            }
        }
        Type::ArrayConst(elem, size_param) => {
            if str_vec_contains(type_params, size_param) {
                match arg {
                    Type::Array(arg_elem, size) => {
                        subst_set(subst, size_param, Type::Named("__const_" + int_to_str(size)));
                        infer_from_pair(box_type_deref(elem), box_type_deref(arg_elem), type_params, subst);
                    }
                    _ => {
                    }
                }
            }
        }
        Type::Array(elem, _) => {
            match arg {
                Type::Array(arg_elem, _) => {
                    infer_from_pair(box_type_deref(elem), box_type_deref(arg_elem), type_params, subst);
                }
                _ => {
                }
            }
        }
        Type::Ref(inner, _) => {
            match arg {
                Type::Ref(arg_inner, _) => {
                    infer_from_pair(box_type_deref(inner), box_type_deref(arg_inner), type_params, subst);
                }
                _ => {
                }
            }
        }
        Type::RawPtr(inner, _) => {
            match arg {
                Type::RawPtr(arg_inner, _) => {
                    infer_from_pair(box_type_deref(inner), box_type_deref(arg_inner), type_params, subst);
                }
                _ => {
                }
            }
        }
        Type::Tuple(types) => {
            match arg {
                Type::Tuple(arg_types) => {
                    var n: i64 = types.len();
                    if arg_types.len() < n {
                        n = arg_types.len();
                    }
                    var i: i64 = 0;
                    while i < n {
                        infer_from_pair(types.get(i), arg_types.get(i), type_params, subst);
                        i = i + 1;
                    }
                }
                _ => {
                }
            }
        }
        Type::Func(params, ret) => {
            match arg {
                Type::Func(arg_params, arg_ret) => {
                    var n: i64 = params.len();
                    if arg_params.len() < n {
                        n = arg_params.len();
                    }
                    var i: i64 = 0;
                    while i < n {
                        infer_from_pair(params.get(i), arg_params.get(i), type_params, subst);
                        i = i + 1;
                    }
                    infer_from_pair(box_type_deref(ret), box_type_deref(arg_ret), type_params, subst);
                }
                _ => {
                }
            }
        }
        Type::Generic(gname, gargs) => {
            // Recurse into generic type arguments to infer type parameters.
            // e.g. param=Vec<T>, arg=Vec<i64> -> bind T=i64
            match arg {
                Type::Generic(arg_gname, arg_gargs) => {
                    if gname == arg_gname {
                        var n: i64 = gargs.len();
                        if arg_gargs.len() < n {
                            n = arg_gargs.len();
                        }
                        var i: i64 = 0;
                        while i < n {
                            infer_from_pair(gargs.get(i), arg_gargs.get(i), type_params, subst);
                            i = i + 1;
                        }
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
}

// --- Monomorphization context --------------------------------------------

pub struct MonoCtx {
    pub generics: Vec<GenericFuncEntry>,
    pub generic_methods: Vec<GenericMethodEntry>,
    pub instantiated: Vec<Func>,
    pub seen: Vec<str>,
    pub trait_assoc_bindings: Vec<TraitAssocEntry>,
}

pub fn MonoCtx_new() -> MonoCtx {
    return MonoCtx {
        generics: Vec::new(), generic_methods: Vec::new(), instantiated: Vec::new(), seen: Vec::new(), trait_assoc_bindings: Vec::new(),
    };
}

pub fn MonoCtx_seen_insert(ctx: & mut MonoCtx, name: str) -> bool {
    if str_vec_contains(ctx.seen, name) {
        return false;
    }
    ctx.seen.push(name);
    return true;
}

// --- Turbofish: explicit type arguments (proposal 0002) ------------------
//
// The parser reads `name::<T, U>(args)` as a call of `name::<#k>`, with the
// types in its table at k. Before type checking, mono_resolve_turbofish
// renames each such call to the instantiation (`name__T_U`) and adds that
// instantiation to the program, so every later pass sees an ordinary call
// of an ordinary function.

var g_mono_tf_only: bool = false; var g_mono_tf_table: Vec<Type> = Vec::new(); var g_mono_tf_names: Vec<str> = Vec::new(); var g_mono_tf_funcs: Vec<Func> = Vec::new(); var g_mono_tf_substs: Vec<Vec<SubstEntry>> = Vec::new(); var g_mono_tf_errors: Vec<str> = Vec::new();  /// The errors of the last mono_resolve_turbofish.
pub fn mono_turbofish_errors() -> Vec<str> {
    return g_mono_tf_errors;
}

/// The function a turbofish call `name::<#k>` calls: the instantiation of
/// `name` with the k-th type arguments, queued to be created.
fn mono_turbofish_callee(callee: str, generics: Vec<GenericFuncEntry>, in_func: str) -> str {
    var at: i64 = str_find(callee, "::<#");
    if at < 0 {
        return callee;
    }
    var base: str = str_slice(callee, 0, at);
    var k: i64 = str_parse_int(str_slice(callee, at + 4, str_len(callee) - 1));
    var targs: Vec<Type> = Vec::new();
    if k >= 0 && k < g_mono_tf_table.len() {
        match g_mono_tf_table.get(k) {
            Type::Generic(_, ta) => {
                targs = ta;
            }
            _ => {
            }
        }
    }
    match generic_funcs_get(generics, base) {
        OptGenericFunc::Some(entry) => {
            if targs.len() != entry.type_params.len() {
                g_mono_tf_errors.push("Type error (in '" + in_func + "'): '" + base + "' takes " + int_to_str(entry.type_params.len()) + " type argument(s), the call gives " + int_to_str(targs.len()) + ".\n    Fix: write `" + base + "::<" + str_join(entry.type_params, ", ") + ">(...)` with a type for each.");
                return base;
            }
            var subst: Vec<SubstEntry> = subst_new();
            var i: i64 = 0;
            while i < targs.len() {
                subst_set(& mut subst, entry.type_params.get(i), targs.get(i));
                i = i + 1;
            }
            var mangled: str = mangle(base, subst, entry.type_params);
            if !str_vec_contains(g_mono_tf_names, mangled) {
                g_mono_tf_names.push(mangled);
                g_mono_tf_funcs.push(entry.func);
                g_mono_tf_substs.push(subst);
            }
            return mangled;
        }
        OptGenericFunc::None => {
            g_mono_tf_errors.push("Type error (in '" + in_func + "'): '" + base + "' is not a generic function, so it takes no type arguments.\n    Fix: call it as `" + base + "(...)`.");
            return base;
        }
    }
    return base;
}

fn mono_tf_body(f: Func, generics: Vec<GenericFuncEntry>) -> Func {
    var r: Func = f;
    var no_methods: Vec<GenericMethodEntry> = Vec::new();
    r.body = fixup_generic_calls(f.body, generics, no_methods, f);
    return r;
}

/// Resolve the turbofish calls of `program` (table: the parser's
/// turbofish_types). Errors are read with mono_turbofish_errors.
pub fn mono_resolve_turbofish(program0: Program, table: Vec<Type>) -> Program {
    g_mono_tf_errors = Vec::new();
    // L8E: variadic calls packed first, so the turbofish pass and type
    // checking see a Vec argument
    var program: Program = mono_desugar_variadics(program0);
    if table.len() == 0 {
        return program;
    }
    mono_spec_setup(program);
    g_mono_tf_table = table;
    g_mono_tf_names = Vec::new();
    g_mono_tf_funcs = Vec::new();
    g_mono_tf_substs = Vec::new();
    var generics: Vec<GenericFuncEntry> = Vec::new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        var f: Func = program.funcs.get(i);
        if f.type_params.len() > 0 {
            generics.push(GenericFuncEntry_new(f.name, f, f.type_params));
        }
        i = i + 1;
    }
    // Only turbofish calls are renamed here: inference is mono's later job
    g_mono_tf_only = true;
    var result: Program = program;
    var funcs: Vec<Func> = Vec::new();
    i = 0;
    while i < program.funcs.len() {
        var f: Func = program.funcs.get(i);
        if f.type_params.len() == 0 {
            funcs.push(mono_tf_body(f, generics));
        } else {
            funcs.push(f);
        }
        i = i + 1;
    }
    var impls: Vec<ImplDef> = Vec::new();
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        if imp.type_params.len() == 0 {
            var ms: Vec<Func> = Vec::new();
            var j: i64 = 0;
            while j < imp.methods.len() {
                ms.push(mono_tf_body(imp.methods.get(j), generics));
                j = j + 1;
            }
            imp.methods = ms;
        }
        impls.push(imp);
        i = i + 1;
    }
    var timpls: Vec<TraitImpl> = Vec::new();
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        if ti.type_params.len() == 0 {
            var ms: Vec<Func> = Vec::new();
            var j: i64 = 0;
            while j < ti.methods.len() {
                ms.push(mono_tf_body(ti.methods.get(j), generics));
                j = j + 1;
            }
            ti.methods = ms;
        }
        timpls.push(ti);
        i = i + 1;
    }
    g_mono_tf_only = false;
    // The instantiations, and the generic functions they call in turn
    var ctx: MonoCtx = MonoCtx_new();
    ctx.generics = generics;
    i = 0;
    while i < g_mono_tf_names.len() {
        if MonoCtx_seen_insert(& mut ctx, g_mono_tf_names.get(i)) {
            funcs.push(instantiate(g_mono_tf_funcs.get(i), g_mono_tf_substs.get(i), g_mono_tf_names.get(i), & mut ctx));
        }
        i = i + 1;
    }
    i = 0;
    while i < ctx.instantiated.len() {
        funcs.push(ctx.instantiated.get(i));
        i = i + 1;
    }
    result.funcs = funcs;
    result.impls = impls;
    result.trait_impls = timpls;
    return result;
}

// --- L8E: variadic parameters ---------------------------------------------
// `fn sum(...xs: i64)`: xs is a Vec<i64> in the body, and a call
// `sum(1, 2, 3)` passes the arguments after the fixed ones packed into one,
// `{ var __va_N: Vec<i64> = Vec::new(); __va_N.push(1); ...; __va_N }`.
// Done on the merged program before type checking (mono_resolve_turbofish),
// so every later pass sees an ordinary Vec parameter and argument; the type
// checker registers the declared signature with the same Vec
// (tc_variadic_param_ty). Not covered: generic variadic functions (their
// element type would be written in the caller), methods, and a call with
// named arguments (left as written, the checker reports its count).

// L8H: the program's specializations `name__spec<k>` (ast.fd
// spec_base_name), for instantiate
var g_mono_specs: Vec<Func> = Vec::new();
// L8H: the methods of narrower impls that specialize a generic impl's
// (`impl Wrap<i64> { fn show__spec1(self: Wrap<i64>) }`, parser.fd
// pd_impl_specializations), the struct each is a method of, and its impl's
// type parameters
var g_mono_mspecs: Vec<Func> = Vec::new();
var g_mono_mspec_structs: Vec<str> = Vec::new();
var g_mono_mspec_tps: Vec<Vec<str>> = Vec::new();

fn mono_spec_setup(program: Program) {
    g_mono_specs = Vec::new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        if spec_base_name(program.funcs.get(i).name) != "" {
            g_mono_specs.push(program.funcs.get(i));
        }
        i = i + 1;
    }
    // L8H: methods of narrower impls (parser.fd pd_impl_specializations)
    g_mono_mspecs = Vec::new();
    g_mono_mspec_structs = Vec::new();
    g_mono_mspec_tps = Vec::new();
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var j: i64 = 0;
        while j < imp.methods.len() {
            var m: Func = imp.methods.get(j);
            if spec_base_name(m.name) != "" && m.params.len() > 0 && m.params.get(0).name == "self" {
                g_mono_mspecs.push(m);
                g_mono_mspec_structs.push(imp.struct_name);
                g_mono_mspec_tps.push(imp.type_params);
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

/// `self`'s type without a reference (`&mut Wrap<i64>`: Wrap<i64>).
fn mono_self_value_type(t: Type) -> Type {
    match t {
        Type::Ref(inner, _) => {
            return box_type_deref(inner);
        }
        _ => {
        }
    }
    return t;
}

/// L8A: whether `tp` is one of the const parameters of method `f` (its
/// impl's `const N: usize`, parser.fd pd_impl_consts).
fn mono_is_const_param(f: Func, tp: str) -> bool {
    var i: i64 = 0;
    while i < f.const_params.len() {
        if f.const_params.get(i).a == tp {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// --- LG4: generic methods (`fn m<U>(self, ..)` in an impl or trait impl) ---
// A method with type parameters of its own is instantiated per call, like a
// generic impl's: the call `v.m(x)` on a value of type Pos becomes
// `Pos__m__T(v, x)` (fixup_generic_calls_expr), T what x's type gives U.
// The impl keeps, under the plain name, the instance with i64 for them (as
// a generic impl's methods keep theirs), for a call whose receiver mono
// cannot type (`self.m(x)` inside the impl). A method without `self` is
// not one: its calls (`Pos::m(x)`) pass no receiver.

/// Whether `f` is a generic method LG4 instantiates.
fn mono_lg4_generic(f: Func) -> bool {
    if f.type_params.len() == 0 || f.params.len() == 0 {
        return false;
    }
    return f.params.get(0).name == "self";
}

/// The type parameters an instantiation of method `f` of an impl with
/// parameters `impl_tps` binds: the impl's, then (LG4) the method's own.
fn mono_lg4_tps(impl_tps: Vec<str>, f: Func) -> Vec<str> {
    if !mono_lg4_generic(f) {
        return impl_tps;
    }
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < impl_tps.len() {
        out.push(impl_tps.get(i));
        i = i + 1;
    }
    i = 0;
    while i < f.type_params.len() {
        if !str_vec_contains(out, f.type_params.get(i)) {
            out.push(f.type_params.get(i));
        }
        i = i + 1;
    }
    return out;
}

/// Method `f` of the (non-generic) impl of `type_name` with `Self` read as
/// that type: its instantiations are functions of their own
/// (`Pos__m__str`), with no impl around them to say what `Self` is.
fn mono_lg4_self(f: Func, type_name: str) -> Func {
    var s: Vec<SubstEntry> = subst_new();
    subst_set(& mut s, "Self", Type::Named(type_name));
    var r: Func = f;
    var ps: Vec<Param> = Vec::new();
    var i: i64 = 0;
    while i < f.params.len() {
        var p: Param = f.params.get(i);
        p.ty = subst_type(p.ty, s);
        ps.push(p);
        i = i + 1;
    }
    r.params = ps;
    r.ret_ty = subst_type(f.ret_ty, s);
    var body: Vec<Stmt> = Vec::new();
    i = 0;
    while i < f.body.len() {
        body.push(subst_stmt(f.body.get(i), s, rename_new(), rename_new()));
        i = i + 1;
    }
    r.body = body;
    return r;
}

/// Whether the impl keeps method `f` under its plain name: always, but for
/// a generic method whose own type parameters have bounds (`fn m<U: Show>`):
/// its i64 instance would call Show's methods on an i64.
fn mono_lg4_plain_ok(f: Func) -> bool {
    if !mono_lg4_generic(f) {
        return true;
    }
    var i: i64 = 0;
    while i < f.type_param_bounds.len() {
        if str_vec_contains(f.type_params, f.type_param_bounds.get(i).a) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// `base` with i64 for each of method `f`'s own type parameters (the
/// instance kept under the method's plain name).
fn mono_lg4_i64_subst(f: Func, base: Vec<SubstEntry>) -> Vec<SubstEntry> {
    var s: Vec<SubstEntry> = subst_new();
    var i: i64 = 0;
    while i < base.len() {
        subst_set(& mut s, base.get(i).key, base.get(i).val);
        i = i + 1;
    }
    i = 0;
    while i < f.type_params.len() {
        if !subst_contains(s, f.type_params.get(i)) {
            subst_set(& mut s, f.type_params.get(i), Type::I64);
        }
        i = i + 1;
    }
    return s;
}

/// L8H: the instantiation `mangled` of method `gen_func` of the generic
/// impl of `struct_name` (impl parameters `impl_tps`, bound in `subst`):
/// with the body of the most specific narrower impl's method of that name
/// whose type takes the receiver's (`impl Wrap<i64>` for a Wrap<i64>,
/// `impl<U> Wrap<Vec<U>>` for a Wrap<Vec<str>>), else its own. The type
/// checker has reported two that tie (TypeChecker_check_mspec_call).
pub fn mono_method_inst(struct_name: str, gen_func: Func, impl_tps: Vec<str>, subst: Vec<SubstEntry>, mangled: str, ctx: & mut MonoCtx) -> Func {
    if g_mono_mspecs.len() > 0 && spec_base_name(gen_func.name) == "" && impl_tps.len() > 0 {
        var gargs: Vec<Type> = Vec::new();
        var rargs: Vec<Type> = Vec::new();
        var k: i64 = 0;
        while k < impl_tps.len() {
            gargs.push(Type::Named(impl_tps.get(k)));
            rargs.push(subst_type(Type::Named(impl_tps.get(k)), subst));
            k = k + 1;
        }
        var cands: Vec<Func> = Vec::new();
        var at: Vec<i64> = Vec::new();
        var base: Func = Func_new(gen_func.name, gen_func.ret_ty);
        base.type_params = impl_tps;
        var bps: Vec<Param> = Vec::new();
        bps.push(Param_new("self", Type::Generic(struct_name, gargs), false));
        base.params = bps;
        cands.push(base);
        at.push(- 1);
        var si: i64 = 0;
        while si < g_mono_mspecs.len() {
            if g_mono_mspec_structs.get(si) == struct_name && spec_base_name(g_mono_mspecs.get(si).name) == gen_func.name {
                val sm: Func = g_mono_mspecs.get(si);
                var c: Func = Func_new(sm.name, sm.ret_ty);
                c.type_params = g_mono_mspec_tps.get(si);
                var cps: Vec<Param> = Vec::new();
                cps.push(Param_new("self", mono_self_value_type(sm.params.get(0).ty), false));
                c.params = cps;
                cands.push(c);
                at.push(si);
            }
            si = si + 1;
        }
        if cands.len() > 1 {
            var concrete: Vec<Type> = Vec::new();
            concrete.push(Type::Generic(struct_name, rargs));
            var tie: Vec<i64> = Vec::new();
            val chosen: i64 = spec_choose(cands, concrete, & mut tie);
            if chosen > 0 {
                val cf: Func = cands.get(chosen);
                val ssub: Vec<SubstEntry> = infer_subst(spec_param_types(cf), concrete, cf.type_params);
                return instantiate(g_mono_mspecs.get(at.get(chosen)), ssub, mangled, ctx);
            }
        }
    }
    return instantiate(gen_func, subst, mangled, ctx);
}

var g_mono_va_on: bool = false;
var g_mono_va_only: bool = false;
// function name -> 1 + index into g_mono_va_fixed / g_mono_va_elem
var g_mono_va_at: i64 = 0;
var g_mono_va_fixed: Vec<i64> = Vec::new();
var g_mono_va_elem: Vec<Type> = Vec::new();
var g_mono_va_n: i64 = 0;

/// Whether `f` is a non-generic function whose last parameter is variadic.
fn mono_va_last(f: Func) -> bool {
    val n: i64 = f.params.len();
    if n == 0 || f.type_params.len() > 0 {
        return false;
    }
    return f.params.get(n - 1).is_variadic;
}

/// `f` with its variadic parameter `...xs: T` made `xs: Vec<T>`.
fn mono_va_params(f: Func) -> Func {
    var r: Func = f;
    if !mono_va_last(f) {
        return r;
    }
    var ps: Vec<Param> = Vec::new();
    val n: i64 = f.params.len();
    var i: i64 = 0;
    while i < n {
        var p: Param = f.params.get(i);
        if i == n - 1 {
            var ta: Vec<Type> = Vec::new();
            ta.push(p.ty);
            p.ty = Type::Generic("Vec", ta);
            p.is_variadic = false;
        }
        ps.push(p);
        i = i + 1;
    }
    r.params = ps;
    return r;
}

/// The arguments of a call of a variadic function with `fixed` parameters
/// before the variadic one of element type `elem`: the fixed ones, then
/// the rest packed into one Vec.
fn mono_va_pack(args: Vec<Expr>, fixed: i64, elem: Type) -> Vec<Expr> {
    var i: i64 = 0;
    while i < args.len() {
        match args.get(i) {
            Expr::NamedArg(_, _) => {
                return args;
            }
            _ => {
            }
        }
        i = i + 1;
    }
    if args.len() < fixed {
        return args;
    }
    var out: Vec<Expr> = Vec::new();
    i = 0;
    while i < fixed {
        out.push(args.get(i));
        i = i + 1;
    }
    g_mono_va_n = g_mono_va_n + 1;
    val vn: str = "__va_" + int_to_str(g_mono_va_n);
    var ta: Vec<Type> = Vec::new();
    ta.push(elem);
    var no_args: Vec<Expr> = Vec::new();
    var body: Vec<Stmt> = Vec::new();
    body.push(Stmt::Let(vn, OptType::Some(Type::Generic("Vec", ta)), Expr::MethodCall(mn_box_expr_new(Expr::Ident("Vec")), "new", no_args), true, false, Vec::new(), 0));
    while i < args.len() {
        var pa: Vec<Expr> = Vec::new();
        pa.push(args.get(i));
        body.push(Stmt::Expr(Expr::MethodCall(mn_box_expr_new(Expr::Ident(vn)), "push", pa), 0));
        i = i + 1;
    }
    body.push(Stmt::Expr(Expr::Ident(vn), 0));
    out.push(Expr::Block(body));
    return out;
}

fn mono_va_body(f: Func) -> Func {
    var r: Func = f;
    var no_generics: Vec<GenericFuncEntry> = Vec::new();
    var no_methods: Vec<GenericMethodEntry> = Vec::new();
    var nb: Vec<Stmt> = fixup_generic_calls(f.body, no_generics, no_methods, f);
    r.body = nb;
    return r;
}

// --- L8E: variadic packs (comptime tuples) ---------------------------------
// `fn show<T>(label: str, ...xs: T)` where T types nothing but xs: xs is a
// pack, each argument with a type of its own (`show("a", 1, "two", true)`).
// A call with m arguments after the fixed ones calls `show__pack<m>`, a
// clone whose pack is m parameters `xs__0: T__0` .. `xs__<m-1>: T__<m-1>`;
// the usual monomorphization then makes one instance per call shape (the
// argument types). In the clone's body, which is written out here:
//   xs.len()          is m (a constant),
//   xs.get(K)         for a literal K < m is xs__K,
//   for x in xs { B } is B once per element, x bound to xs__k and T meaning
//                     T__k in that copy (a comptime-unrolled loop).
//   f(.., xs)         where f is a pack or a Vec variadic function, passes
//                     the pack on: f(.., xs__0, .., xs__<m-1>).
// `break` and `continue` of an unrolled loop work as in a loop
// (mono_pack_unroll_jumps). Any other use of xs (xs.get(i) with a variable
// i, xs[i], xs passed as one value) is an error (mono_pack_misuse, read
// with mono_turbofish_errors). Not covered: methods, calls with named
// arguments.

// name of a pack function -> 1 + index into g_mono_pack_funcs (0: none)
var g_mono_pack_at: i64 = 0;
var g_mono_pack_funcs: Vec<Func> = Vec::new();
// clone name -> 1 once asked for
var g_mono_pack_made: i64 = 0;
// clones still to write: name, element count, 1 + pack function index
var g_mono_pack_todo: Vec<str> = Vec::new();
var g_mono_pack_todo_n: Vec<i64> = Vec::new();
var g_mono_pack_todo_of: Vec<i64> = Vec::new();
// while a clone's body is written out (subst_expr / subst_stmt): the pack
// parameter ("" = none), its element type parameter, its element count
var g_mono_pack_var: str = "";
var g_mono_pack_tp: str = "";
var g_mono_pack_n: i64 = 0;
// the pack function whose clone is being written out (for its errors), and
// a counter naming the flags and one-pass loops of unrolled pack loops
var g_mono_pack_fname: str = "";
var g_mono_pack_uid: i64 = 0;

/// Whether the pack being written out may be passed on, as the last
/// argument, to `callee`: a pack function or a Vec variadic function.
fn mono_pack_fwd_ok(callee: str) -> bool {
    if g_mono_pack_at != 0 {
        if HashMap_get(g_mono_pack_at, callee) > 0 {
            return true;
        }
    }
    if g_mono_va_at != 0 {
        if HashMap_get(g_mono_va_at, callee) > 0 {
            return true;
        }
    }
    return false;
}

/// The error for a use of the pack being written out that it cannot have
/// (its elements have types of their own): once per function.
fn mono_pack_misuse() {
    val v: str = g_mono_pack_var;
    val msg: str = "Type error (in '" + g_mono_pack_fname + "'): the pack '" + v + "' (`..." + v + ": " + g_mono_pack_tp + "`) has no single type: its elements each have their own.\n    Fix: read it as " + v + ".len(), " + v + ".get(K) with a literal K below its length, `for x in " + v + " { .. }`, or pass it on whole as the last argument of a variadic function (`f(.., " + v + ")`).";
    var i: i64 = 0;
    while i < g_mono_tf_errors.len() {
        if g_mono_tf_errors.get(i) == msg {
            return;
        }
        i = i + 1;
    }
    g_mono_tf_errors.push(msg);
}

/// What an unrolled pack loop's body does to the loop itself: 1 when it
/// has a `break`, 2 a `continue`, 3 both (not counting those of loops
/// inside it).
fn mono_pack_jumps(stmts: Vec<Stmt>) -> i64 {
    var bits: i64 = 0;
    var i: i64 = 0;
    while i < stmts.len() {
        bits = bits | mono_pack_jumps_stmt(stmts.get(i));
        i = i + 1;
    }
    return bits;
}

fn mono_pack_jumps_arms(arms: Vec<MatchArm>) -> i64 {
    var bits: i64 = 0;
    var i: i64 = 0;
    while i < arms.len() {
        bits = bits | mono_pack_jumps(arms.get(i).body);
        i = i + 1;
    }
    return bits;
}

fn mono_pack_jumps_expr(e: Expr) -> i64 {
    match e {
        Expr::If(_, tb, eb) => {
            var bits: i64 = mono_pack_jumps(tb);
            match eb {
                OptStmts::Some(es) => {
                    bits = bits | mono_pack_jumps(es);
                }
                OptStmts::None => {
                }
            }
            return bits;
        }
        Expr::Block(bs) => {
            return mono_pack_jumps(bs);
        }
        Expr::Match(_, arms) => {
            return mono_pack_jumps_arms(arms);
        }
        _ => {
        }
    }
    return 0;
}

fn mono_pack_jumps_stmt(s: Stmt) -> i64 {
    match s {
        Stmt::Break(_, _) => {
            return 1;
        }
        Stmt::Continue(_) => {
            return 2;
        }
        Stmt::If(_, tb, eb, _) => {
            var bits: i64 = mono_pack_jumps(tb);
            match eb {
                OptStmts::Some(es) => {
                    bits = bits | mono_pack_jumps(es);
                }
                OptStmts::None => {
                }
            }
            return bits;
        }
        Stmt::Match(_, arms, _) => {
            return mono_pack_jumps_arms(arms);
        }
        Stmt::Unsafe(us, _) => {
            return mono_pack_jumps(us);
        }
        Stmt::Expr(e, _) => {
            return mono_pack_jumps_expr(e);
        }
        _ => {
        }
    }
    return 0;
}

/// `stmts` with each `break` of the unrolled loop (not of a loop inside
/// it) preceded by `flag = true`, so the copies after it are skipped.
fn mono_pack_mark_breaks(stmts: Vec<Stmt>, flag: str) -> Vec<Stmt> {
    var out: Vec<Stmt> = Vec::new();
    var i: i64 = 0;
    while i < stmts.len() {
        match stmts.get(i) {
            Stmt::Break(bv, bl) => {
                out.push(Stmt::Assign(flag, AssignOp::Assign, Expr::BoolLit(true), bl));
                out.push(Stmt::Break(bv, bl));
            }
            s => {
                out.push(mono_pack_mark_stmt(s, flag));
            }
        }
        i = i + 1;
    }
    return out;
}

fn mono_pack_mark_else(eb: OptStmts, flag: str) -> OptStmts {
    match eb {
        OptStmts::Some(es) => {
            return OptStmts::Some(mono_pack_mark_breaks(es, flag));
        }
        OptStmts::None => {
        }
    }
    return OptStmts::None;
}

fn mono_pack_mark_arms(arms: Vec<MatchArm>, flag: str) -> Vec<MatchArm> {
    var out: Vec<MatchArm> = Vec::new();
    var i: i64 = 0;
    while i < arms.len() {
        var a: MatchArm = arms.get(i);
        a.body = mono_pack_mark_breaks(a.body, flag);
        out.push(a);
        i = i + 1;
    }
    return out;
}

fn mono_pack_mark_stmt(s: Stmt, flag: str) -> Stmt {
    match s {
        Stmt::If(c, tb, eb, l) => {
            return Stmt::If(c, mono_pack_mark_breaks(tb, flag), mono_pack_mark_else(eb, flag), l);
        }
        Stmt::Match(m, arms, l) => {
            return Stmt::Match(m, mono_pack_mark_arms(arms, flag), l);
        }
        Stmt::Unsafe(us, l) => {
            return Stmt::Unsafe(mono_pack_mark_breaks(us, flag), l);
        }
        Stmt::Expr(e, l) => {
            match e {
                Expr::If(c, tb, eb) => {
                    return Stmt::Expr(Expr::If(c, mono_pack_mark_breaks(tb, flag), mono_pack_mark_else(eb, flag)), l);
                }
                Expr::Block(bs) => {
                    return Stmt::Expr(Expr::Block(mono_pack_mark_breaks(bs, flag)), l);
                }
                Expr::Match(m, arms) => {
                    return Stmt::Expr(Expr::Match(m, mono_pack_mark_arms(arms, flag)), l);
                }
                _ => {
                }
            }
            return Stmt::Expr(e, l);
        }
        _ => {
        }
    }
    return s;
}

/// Whether type `t` mentions the type name `name`.
fn mono_type_mentions(t: Type, name: str) -> bool {
    match t {
        Type::Named(n) => {
            return n == name;
        }
        Type::Generic(g, gargs) => {
            if g == name {
                return true;
            }
            var i: i64 = 0;
            while i < gargs.len() {
                if mono_type_mentions(gargs.get(i), name) {
                    return true;
                }
                i = i + 1;
            }
        }
        Type::Ref(inner, _) => {
            return mono_type_mentions(box_type_deref(inner), name);
        }
        Type::RawPtr(inner, _) => {
            return mono_type_mentions(box_type_deref(inner), name);
        }
        Type::Array(e, _) => {
            return mono_type_mentions(box_type_deref(e), name);
        }
        Type::ArrayConst(e, _) => {
            return mono_type_mentions(box_type_deref(e), name);
        }
        Type::Tuple(ts) => {
            var j: i64 = 0;
            while j < ts.len() {
                if mono_type_mentions(ts.get(j), name) {
                    return true;
                }
                j = j + 1;
            }
        }
        Type::Func(ps, r) => {
            var k: i64 = 0;
            while k < ps.len() {
                if mono_type_mentions(ps.get(k), name) {
                    return true;
                }
                k = k + 1;
            }
            return mono_type_mentions(box_type_deref(r), name);
        }
        _ => {
        }
    }
    return false;
}

/// T when `f` is `fn f<.., T, ..>(.., ...xs: T)` and T types nothing but
/// xs (a pack), else "".
fn mono_pack_tp(f: Func) -> str {
    val n: i64 = f.params.len();
    if n == 0 || f.type_params.len() == 0 {
        return "";
    }
    val last: Param = f.params.get(n - 1);
    if !last.is_variadic {
        return "";
    }
    var tp: str = "";
    match last.ty {
        Type::Named(t) => {
            tp = t;
        }
        _ => {
        }
    }
    if tp == "" {
        return "";
    }
    var is_tp: bool = false;
    var i: i64 = 0;
    while i < f.type_params.len() {
        if f.type_params.get(i) == tp {
            is_tp = true;
        }
        i = i + 1;
    }
    if !is_tp {
        return "";
    }
    i = 0;
    while i < n - 1 {
        if mono_type_mentions(f.params.get(i).ty, tp) {
            return "";
        }
        i = i + 1;
    }
    if mono_type_mentions(f.ret_ty, tp) {
        return "";
    }
    return tp;
}

fn mono_is_ident(e: Expr, name: str) -> bool {
    match e {
        Expr::Ident(s) => {
            return s == name;
        }
        _ => {
        }
    }
    return false;
}

/// The clone a call of pack function `callee` (1 + index `pat`) with
/// `args` calls, asked for when new; "" when the call is left as written
/// (named arguments, fewer arguments than the fixed parameters).
fn mono_pack_call(callee: str, pat: i64, args: Vec<Expr>) -> str {
    var i: i64 = 0;
    while i < args.len() {
        match args.get(i) {
            Expr::NamedArg(_, _) => {
                return "";
            }
            _ => {
            }
        }
        i = i + 1;
    }
    val fixed: i64 = g_mono_pack_funcs.get(pat - 1).params.len() - 1;
    if args.len() < fixed {
        return "";
    }
    val m: i64 = args.len() - fixed;
    val name: str = callee + "__pack" + int_to_str(m);
    if HashMap_get(g_mono_pack_made, name) == 0 {
        HashMap_insert(g_mono_pack_made, name, 1);
        g_mono_pack_todo.push(name);
        g_mono_pack_todo_n.push(m);
        g_mono_pack_todo_of.push(pat);
    }
    return name;
}

/// `for x in xs { body }` over the pack being written out: the body once
/// per element, in its own block, x bound to xs__k and T read as T__k.
fn mono_pack_unroll(x: str, body: Vec<Stmt>, line: i64, subst: Vec<SubstEntry>, renames: Vec<RenameEntry>, method_renames: Vec<RenameEntry>) -> Stmt {
    // A `break` or `continue` of the loop itself: each copy runs inside a
    // one-pass loop (`for __pk_once_N in 0..1`), so `continue` ends that
    // copy and goes on to the next; a `break` also sets a flag that skips
    // the copies after it.
    if mono_pack_jumps(body) != 0 {
        return mono_pack_unroll_jumps(x, body, line, subst, renames, method_renames);
    }
    var copies: Vec<Stmt> = Vec::new();
    var k: i64 = 0;
    while k < g_mono_pack_n {
        var ks: Vec<SubstEntry> = Vec::new();
        var s: i64 = 0;
        while s < subst.len() {
            ks.push(subst.get(s));
            s = s + 1;
        }
        subst_set(& mut ks, g_mono_pack_tp, Type::Named(g_mono_pack_tp + "__" + int_to_str(k)));
        var one: Vec<Stmt> = Vec::new();
        one.push(Stmt::Let(x, OptType::None, Expr::Ident(g_mono_pack_var + "__" + int_to_str(k)), false, false, Vec::new(), line));
        var i: i64 = 0;
        while i < body.len() {
            one.push(subst_stmt(body.get(i), ks, renames, method_renames));
            i = i + 1;
        }
        copies.push(Stmt::If(Expr::BoolLit(true), one, OptStmts::None, line));
        k = k + 1;
    }
    return Stmt::If(Expr::BoolLit(true), copies, OptStmts::None, line);
}

/// mono_pack_unroll for a body that breaks or continues the loop:
///   var __pk_brk_N: bool = false;                    (only with a break)
///   if !__pk_brk_N { for __pk_once_N in 0..1 { val x = xs__k; B_k } }
/// once per element k, where B_k is the body with T read as T__k and each
/// `break` of the loop preceded by `__pk_brk_N = true`.
fn mono_pack_unroll_jumps(x: str, body: Vec<Stmt>, line: i64, subst: Vec<SubstEntry>, renames: Vec<RenameEntry>, method_renames: Vec<RenameEntry>) -> Stmt {
    g_mono_pack_uid = g_mono_pack_uid + 1;
    val uid: str = int_to_str(g_mono_pack_uid);
    val flag: str = "__pk_brk_" + uid;
    val has_break: bool = (mono_pack_jumps(body) & 1) != 0;
    var copies: Vec<Stmt> = Vec::new();
    if has_break {
        copies.push(Stmt::Let(flag, OptType::Some(Type::Bool), Expr::BoolLit(false), true, false, Vec::new(), line));
    }
    var k: i64 = 0;
    while k < g_mono_pack_n {
        var ks: Vec<SubstEntry> = Vec::new();
        var s: i64 = 0;
        while s < subst.len() {
            ks.push(subst.get(s));
            s = s + 1;
        }
        subst_set(& mut ks, g_mono_pack_tp, Type::Named(g_mono_pack_tp + "__" + int_to_str(k)));
        var one: Vec<Stmt> = Vec::new();
        one.push(Stmt::Let(x, OptType::None, Expr::Ident(g_mono_pack_var + "__" + int_to_str(k)), false, false, Vec::new(), line));
        var i: i64 = 0;
        while i < body.len() {
            one.push(subst_stmt(body.get(i), ks, renames, method_renames));
            i = i + 1;
        }
        if has_break {
            one = mono_pack_mark_breaks(one, flag);
        }
        var once: Vec<Stmt> = Vec::new();
        once.push(Stmt::For("__pk_once_" + uid, Expr::Range(mn_box_expr_new(Expr::IntLit(0)), mn_box_expr_new(Expr::IntLit(1)), false), one, line));
        if has_break {
            copies.push(Stmt::If(Expr::Unary(UnaryOp::Not, mn_box_expr_new(Expr::Ident(flag))), once, OptStmts::None, line));
        } else {
            copies.push(Stmt::If(Expr::BoolLit(true), once, OptStmts::None, line));
        }
        k = k + 1;
    }
    return Stmt::If(Expr::BoolLit(true), copies, OptStmts::None, line);
}

/// The clone `name` of pack function `f` (pack type parameter `tp`) for
/// `m` elements.
fn mono_pack_clone(f: Func, tp: str, m: i64, name: str) -> Func {
    var r: Func = f;
    r.name = name;
    var tps: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < f.type_params.len() {
        if f.type_params.get(i) != tp {
            tps.push(f.type_params.get(i));
        }
        i = i + 1;
    }
    var k: i64 = 0;
    while k < m {
        tps.push(tp + "__" + int_to_str(k));
        k = k + 1;
    }
    r.type_params = tps;
    // a bound on T holds for each element's type
    var bounds: Vec<StrPair> = Vec::new();
    i = 0;
    while i < f.type_param_bounds.len() {
        val bp: StrPair = f.type_param_bounds.get(i);
        if bp.a == tp {
            k = 0;
            while k < m {
                bounds.push(StrPair { a: tp + "__" + int_to_str(k), b: bp.b });
                k = k + 1;
            }
        } else {
            bounds.push(bp);
        }
        i = i + 1;
    }
    r.type_param_bounds = bounds;
    val n: i64 = f.params.len();
    val last: Param = f.params.get(n - 1);
    var ps: Vec<Param> = Vec::new();
    i = 0;
    while i < n - 1 {
        ps.push(f.params.get(i));
        i = i + 1;
    }
    k = 0;
    while k < m {
        var p: Param = last;
        p.name = last.name + "__" + int_to_str(k);
        p.ty = Type::Named(tp + "__" + int_to_str(k));
        p.is_variadic = false;
        ps.push(p);
        k = k + 1;
    }
    r.params = ps;
    val saved_var: str = g_mono_pack_var;
    val saved_tp: str = g_mono_pack_tp;
    val saved_n: i64 = g_mono_pack_n;
    val saved_fname: str = g_mono_pack_fname;
    g_mono_pack_var = last.name;
    g_mono_pack_tp = tp;
    g_mono_pack_n = m;
    g_mono_pack_fname = f.name;
    var no_subst: Vec<SubstEntry> = Vec::new();
    var no_renames: Vec<RenameEntry> = Vec::new();
    var no_mrenames: Vec<RenameEntry> = Vec::new();
    var body: Vec<Stmt> = Vec::new();
    i = 0;
    while i < f.body.len() {
        body.push(subst_stmt(f.body.get(i), no_subst, no_renames, no_mrenames));
        i = i + 1;
    }
    g_mono_pack_var = saved_var;
    g_mono_pack_tp = saved_tp;
    g_mono_pack_n = saved_n;
    g_mono_pack_fname = saved_fname;
    r.body = body;
    return r;
}

/// L8E: the program with its variadic functions' parameters made Vecs and
/// every call of one packed. The program itself when it has none.
pub fn mono_desugar_variadics(program: Program) -> Program {
    var any: bool = false;
    var any_pack: bool = false;
    var i: i64 = 0;
    while i < program.funcs.len() {
        if mono_va_last(program.funcs.get(i)) {
            any = true;
        } else if mono_pack_tp(program.funcs.get(i)) != "" {
            any_pack = true;
        }
        i = i + 1;
    }
    if !any && !any_pack {
        return program;
    }
    g_mono_va_at = HashMap_new();
    g_mono_va_fixed = Vec::new();
    g_mono_va_elem = Vec::new();
    g_mono_pack_funcs = Vec::new();
    g_mono_pack_todo = Vec::new();
    g_mono_pack_todo_n = Vec::new();
    g_mono_pack_todo_of = Vec::new();
    if any_pack {
        g_mono_pack_at = HashMap_new();
        g_mono_pack_made = HashMap_new();
        i = 0;
        while i < program.funcs.len() {
            if mono_pack_tp(program.funcs.get(i)) != "" {
                g_mono_pack_funcs.push(program.funcs.get(i));
                HashMap_insert(g_mono_pack_at, program.funcs.get(i).name, g_mono_pack_funcs.len());
            }
            i = i + 1;
        }
    }
    i = 0;
    while i < program.funcs.len() {
        var vf: Func = program.funcs.get(i);
        if mono_va_last(vf) {
            // a later declaration of the name wins (the user's program is
            // merged last)
            g_mono_va_fixed.push(vf.params.len() - 1);
            g_mono_va_elem.push(vf.params.get(vf.params.len() - 1).ty);
            HashMap_insert(g_mono_va_at, vf.name, g_mono_va_fixed.len());
        }
        i = i + 1;
    }
    val saved_tf: bool = g_mono_tf_only;
    g_mono_tf_only = true;
    g_mono_va_only = true;
    g_mono_va_on = true;
    var result: Program = program;
    var funcs: Vec<Func> = Vec::new();
    i = 0;
    while i < program.funcs.len() {
        // a pack function itself is replaced by its clones (below)
        if !any_pack || mono_pack_tp(program.funcs.get(i)) == "" {
            funcs.push(mono_va_body(mono_va_params(program.funcs.get(i))));
        }
        i = i + 1;
    }
    var impls: Vec<ImplDef> = Vec::new();
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var ms: Vec<Func> = Vec::new();
        var j: i64 = 0;
        while j < imp.methods.len() {
            ms.push(mono_va_body(imp.methods.get(j)));
            j = j + 1;
        }
        imp.methods = ms;
        impls.push(imp);
        i = i + 1;
    }
    var timpls: Vec<TraitImpl> = Vec::new();
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var tms: Vec<Func> = Vec::new();
        var tj: i64 = 0;
        while tj < ti.methods.len() {
            tms.push(mono_va_body(ti.methods.get(tj)));
            tj = tj + 1;
        }
        ti.methods = tms;
        timpls.push(ti);
        i = i + 1;
    }
    // the pack clones the calls asked for; a clone's own calls of pack
    // functions can ask for more
    var pt: i64 = 0;
    while pt < g_mono_pack_todo.len() {
        val pf: Func = g_mono_pack_funcs.get(g_mono_pack_todo_of.get(pt) - 1);
        val clone: Func = mono_pack_clone(pf, mono_pack_tp(pf), g_mono_pack_todo_n.get(pt), g_mono_pack_todo.get(pt));
        funcs.push(mono_va_body(mono_va_params(clone)));
        pt = pt + 1;
    }
    if any_pack {
        HashMap_drop(g_mono_pack_at);
        HashMap_drop(g_mono_pack_made);
        g_mono_pack_at = 0;
        g_mono_pack_made = 0;
    }
    g_mono_va_on = false;
    g_mono_va_only = false;
    g_mono_tf_only = saved_tf;
    HashMap_drop(g_mono_va_at);
    g_mono_va_at = 0;
    result.funcs = funcs;
    result.impls = impls;
    result.trait_impls = timpls;
    return result;
}

// --- Main monomorphization entry point -----------------------------------

// The declared return type of every non-generic function, for the type of a
// call (`parse(s).context(..)` is a method on what `parse` returns).
// --- CL5: struct field defaults -------------------------------------------
// `S { a: 1, .. }` (the parser's ast_spread_defaults) gets the default of
// each field it leaves out, written in by subst_expr while
// monomorphization runs: every function it writes out (process_func,
// instantiate) passes through subst_stmt, so no later pass sees the marker.
// The type checker has already checked that each such field has a default
// (TypeChecker_check_struct_defaults). Not covered: a literal in a global's
// or constant's initializer, and a default that calls a generic function
// (its instantiation is collected before the default is written in).

var g_mono_fill_defaults: bool = false;
var g_mono_fill_depth: i64 = 0;
// struct name -> 1 + index into g_mono_sdefs (structs with a default only)
var g_mono_sdef_at: i64 = 0;
var g_mono_sdefs: Vec<StructDef> = Vec::new();
// type alias name -> 1 + index into g_mono_salias (the name it stands for)
var g_mono_salias_at: i64 = 0;
var g_mono_salias: Vec<str> = Vec::new();

fn mn_defaults_setup(program: Program) {
    g_mono_sdef_at = HashMap_new();
    g_mono_sdefs = Vec::new();
    g_mono_salias_at = HashMap_new();
    g_mono_salias = Vec::new();
    g_mono_fill_depth = 0;
    var i: i64 = 0;
    while i < program.structs.len() {
        var s: StructDef = program.structs.get(i);
        var has: bool = false;
        var fi: i64 = 0;
        while fi < s.fields.len() {
            if s.fields.get(fi).has_default {
                has = true;
            }
            fi = fi + 1;
        }
        // the first struct of a name, as the type checker reads it
        if has && HashMap_get(g_mono_sdef_at, s.name) == 0 {
            g_mono_sdefs.push(s);
            HashMap_insert(g_mono_sdef_at, s.name, g_mono_sdefs.len());
        }
        i = i + 1;
    }
    i = 0;
    while i < program.type_aliases.len() {
        var ta: TypeAlias = program.type_aliases.get(i);
        match ta.alias_for {
            Type::Named(target) => {
                g_mono_salias.push(target);
                HashMap_insert(g_mono_salias_at, ta.name, g_mono_salias.len());
            }
            _ => {
            }
        }
        i = i + 1;
    }
    g_mono_fill_defaults = true;
}

fn mn_defaults_done() {
    g_mono_fill_defaults = false;
    HashMap_drop(g_mono_sdef_at);
    g_mono_sdef_at = HashMap_new();
    g_mono_sdefs = Vec::new();
    HashMap_drop(g_mono_salias_at);
    g_mono_salias_at = HashMap_new();
    g_mono_salias = Vec::new();
}

/// `fields` of a literal of struct `name` (or of an alias of it), with the
/// declared default of each field they leave out added.
fn mn_fill_struct_defaults(name: str, fields: Vec<FieldInit>) -> Vec<FieldInit> {
    var sname: str = name;
    var hops: i64 = 0;
    while hops < 8 && HashMap_get(g_mono_sdef_at, sname) == 0 {
        var al: i64 = HashMap_get(g_mono_salias_at, sname);
        if al == 0 {
            break;
        }
        sname = g_mono_salias.get(al - 1);
        hops = hops + 1;
    }
    var out: Vec<FieldInit> = Vec::new();
    var k: i64 = 0;
    while k < fields.len() {
        out.push(fields.get(k));
        k = k + 1;
    }
    var at: i64 = HashMap_get(g_mono_sdef_at, sname);
    if at == 0 {
        return out;
    }
    var s: StructDef = g_mono_sdefs.get(at - 1);
    var fi: i64 = 0;
    while fi < s.fields.len() {
        var f: Param = s.fields.get(fi);
        if f.has_default {
            var written: bool = false;
            var j: i64 = 0;
            while j < fields.len() {
                if fields.get(j).name == f.name {
                    written = true;
                }
                j = j + 1;
            }
            if !written {
                out.push(FieldInit_new(f.name, f.default_expr));
            }
        }
        fi = fi + 1;
    }
    return out;
}

// --- F45 @redundant: dual-channel execution with a voter ------------------
// The function's body becomes two channels, `<f>_chan_a` and `<f>_chan_b`;
// `f` itself runs both on the same arguments, compares the results and
// stops the program (fail-safe) when they differ. The typechecker has
// already required a scalar result, no generics, no `&mut` parameter and
// nothing that acts outside (compiler/typechecker.fd
// TypeChecker_verify_redundant), so running the body twice is sound.
fn mn_is_redundant(func: Func) -> bool {
    var i: i64 = 0;
    while i < func.annotations.len() {
        if func.annotations.get(i).name == "redundant" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The annotations without @redundant (and, for a channel, without what
/// makes a function an entry point: @export, @test, @panic_handler).
fn mn_redundant_anns(anns: Vec<Annotation>, channel: bool) -> Vec<Annotation> {
    var out: Vec<Annotation> = Vec::new();
    var i: i64 = 0;
    while i < anns.len() {
        var n: str = anns.get(i).name;
        var entry: bool = n == "export" || n == "test" || n == "panic_handler";
        if n != "redundant" && !(channel && entry) {
            out.push(anns.get(i));
        }
        i = i + 1;
    }
    return out;
}

fn mn_push_redundant(out: & mut Vec<Func>, func: Func) {
    var a: Func = func;
    a.name = func.name + "_chan_a";
    a.annotations = mn_redundant_anns(func.annotations, true);
    a.preconditions = Vec::new();
    a.postconditions = Vec::new();
    a.is_pub = false;
    var b: Func = a;
    b.name = func.name + "_chan_b";
    var a_name: str = a.name;
    var b_name: str = b.name;
    out.push(a);
    out.push(b);
    var args_a: Vec<Expr> = Vec::new();
    var args_b: Vec<Expr> = Vec::new();
    var i: i64 = 0;
    while i < func.params.len() {
        args_a.push(Expr::Ident(func.params.get(i).name));
        args_b.push(Expr::Ident(func.params.get(i).name));
        i = i + 1;
    }
    var line: i64 = 0;
    if func.body.len() > 0 {
        line = stmt_line(func.body.get(0));
    }
    var body: Vec<Stmt> = Vec::new();
    body.push(Stmt::Let("rdn_chan_a", OptType::Some(func.ret_ty), Expr::Call(a_name, args_a), false, false, Vec::new(), line));
    body.push(Stmt::Let("rdn_chan_b", OptType::Some(func.ret_ty), Expr::Call(b_name, args_b), false, false, Vec::new(), line));
    var msg: Vec<Expr> = Vec::new();
    msg.push(Expr::StringLit("@redundant: the two channels of '" + func.name + "' disagree (fail-safe stop)"));
    var fail: Vec<Stmt> = Vec::new();
    fail.push(Stmt::Expr(Expr::Call("p_panic", msg), line));
    body.push(Stmt::If(Expr::Binary(BinOp::Neq, mn_box_expr_new(Expr::Ident("rdn_chan_a")), mn_box_expr_new(Expr::Ident("rdn_chan_b"))), fail, OptStmts::None, line));
    body.push(Stmt::Return(OptBoxExpr::Some(mn_box_expr_new(Expr::Ident("rdn_chan_a"))), line));
    var v: Func = func;
    v.annotations = mn_redundant_anns(func.annotations, false);
    v.body = body;
    out.push(v);
}

// --- F34 @event / @emit: blockchain event log -----------------------------
// An `@event fn Transfer(from: i64, to: i64, amount: i64) {}` is an event
// declaration: the compiler writes its body. Each call appends one record
// to the event log (standard output), numbered in emission order:
//   emit #1 Transfer(i64,i64,i64) topic=0x1a2b3c4d from=1 to=2 amount=50
// The topic is the FNV-1a (32-bit) hash of the canonical signature, so a
// reader identifies the event by its signature as it would a log topic.
// compiler/typechecker.fd TypeChecker_verify_emit has checked the
// declaration (empty body, no result, parameters of encodable types) and
// that every function emitting it declares it with @emit(...).
var g_mn_emit_used: bool = false;

pub fn mn_is_event(func: Func) -> bool {
    var i: i64 = 0;
    while i < func.annotations.len() {
        if func.annotations.get(i).name == "event" {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The canonical name of an event parameter's type in its signature.
pub fn mn_event_type_name(t: Type) -> str {
    match t {
        Type::I8 => {
            return "i8";
        }
        Type::I16 => {
            return "i16";
        }
        Type::I32 => {
            return "i32";
        }
        Type::I64 => {
            return "i64";
        }
        Type::U8 => {
            return "u8";
        }
        Type::U16 => {
            return "u16";
        }
        Type::U32 => {
            return "u32";
        }
        Type::U64 => {
            return "u64";
        }
        Type::Bool => {
            return "bool";
        }
        Type::Str => {
            return "str";
        }
        _ => {
            return "";
        }
    }
}

/// `Name(t1,t2,...)`: the event's canonical signature.
pub fn mn_event_signature(func: Func) -> str {
    var s: str = func.name + "(";
    var i: i64 = 0;
    while i < func.params.len() {
        if i > 0 {
            s = s + ",";
        }
        s = s + mn_event_type_name(func.params.get(i).ty);
        i = i + 1;
    }
    return s + ")";
}

/// FNV-1a, 32 bits, of `s`.
pub fn mn_fnv32(s: str) -> i64 {
    var h: i64 = 2166136261;
    var i: i64 = 0;
    while i < str_len(s) {
        h = h ^ (str_byte_at(s, i) & 255);
        h = (h * 16777619) & 4294967295;
        i = i + 1;
    }
    return h;
}

/// `v` (0 <= v < 2^32) as 8 lower-case hex digits.
pub fn mn_hex8(v: i64) -> str {
    var digits: str = "0123456789abcdef";
    var out: str = "";
    var k: i64 = 7;
    while k >= 0 {
        var d: i64 = (v >> (k * 4)) & 15;
        out = out + str_slice(digits, d, d + 1);
        k = k - 1;
    }
    return out;
}

/// The event function with the body the compiler writes for it.
fn mn_event_body(func: Func) -> Func {
    var sig: str = mn_event_signature(func);
    var line: i64 = 0;
    var parts: Vec<FStringPart> = Vec::new();
    parts.push(FStringPart::Literal("emit #"));
    parts.push(FStringPart::Expr(Expr::Ident("__emit_seq")));
    var head: str = " " + sig + " topic=0x" + mn_hex8(mn_fnv32(sig));
    var i: i64 = 0;
    while i < func.params.len() {
        parts.push(FStringPart::Literal(head + " " + func.params.get(i).name + "="));
        parts.push(FStringPart::Expr(Expr::Ident(func.params.get(i).name)));
        head = "";
        i = i + 1;
    }
    if head != "" {
        parts.push(FStringPart::Literal(head));
    }
    var body: Vec<Stmt> = Vec::new();
    body.push(Stmt::Assign("__emit_seq", AssignOp::Assign, Expr::Binary(BinOp::Add, mn_box_expr_new(Expr::Ident("__emit_seq")), mn_box_expr_new(Expr::IntLit(1))), line));
    var args: Vec<Expr> = Vec::new();
    args.push(Expr::FString(parts));
    body.push(Stmt::Expr(Expr::Call("println", args), line));
    var out: Func = func;
    out.body = body;
    return out;
}

/// The program's globals, with the event counter when an event was written.
fn mn_emit_globals(globals: Vec<GlobalVar>) -> Vec<GlobalVar> {
    if !g_mn_emit_used {
        return globals;
    }
    var out: Vec<GlobalVar> = Vec::new();
    var have: bool = false;
    var i: i64 = 0;
    while i < globals.len() {
        if globals.get(i).name == "__emit_seq" {
            have = true;
        }
        out.push(globals.get(i));
        i = i + 1;
    }
    if !have {
        out.push(GlobalVar { name: "__emit_seq", ty: Type::I64, init: Expr::IntLit(0), is_pub: false });
    }
    return out;
}

// --- WP19: instances whose types lower alike share one body --------------
//
// An instance is keyed by its type arguments as lowering sees them, not as
// they are spelled. Lowering (lower.fd Lowerer_resolve_type, which
// Lowerer_lower_type, Lowerer_rc_kind and Lowerer_type_name_of all go
// through) reads a type alias as its target, also inside a reference, a raw
// pointer, an array and a generic's arguments: with `type Meters = i64`,
// `f(m)` (m: Meters) and `f(5)` lower to the same IR. Both calls now go to
// one instance, `f__i64`, built once (before: `f__Meters` and `f__i64`, the
// same body twice). The key mirrors Lowerer_resolve_type exactly (the first
// alias of a name; a tuple's or a function type's parts are left as they
// are), so two instances share only when lowering could not tell them apart.
// Not resolved, so not shared: an alias that has an impl or a trait impl of
// its own name (a method call on T may resolve through that name), and the
// type arguments of a function or method that has L8H specializations (they
// are chosen by the spelled types). Types that lower to different IR but
// happen to have the same layout (two structs with the same fields) stay
// separate instances here: their bodies differ in names (field lookup,
// printing); the IR-level fold (iropt.fd iro_fold_identical, `icf`) merges
// what is still identical after lowering.
// FID_MONO_SHARE_OFF=1 keys instances by the spelled types (as before);
// FID_MONO_STATS=1 prints how many instances were not built.

var g_mono_share_on: bool = false;
// alias name -> 1 + index into g_mono_alias_tys; -1: an alias with an impl
// of its name (not resolved)
var g_mono_alias_at: i64 = 0;
var g_mono_alias_tys: Vec<Type> = Vec::new();
// instance keys seen: as spelled, and as lowering sees them
var g_mono_share_orig_at: i64 = 0;
var g_mono_share_canon_at: i64 = 0;
var g_mono_share_orig_n: i64 = 0;
var g_mono_share_canon_n: i64 = 0;

fn mono_share_setup(program: Program) {
    g_mono_share_on = false;
    g_mono_alias_at = HashMap_new();
    g_mono_alias_tys = Vec::new();
    g_mono_share_orig_at = HashMap_new();
    g_mono_share_canon_at = HashMap_new();
    g_mono_share_orig_n = 0;
    g_mono_share_canon_n = 0;
    match env_var("FID_MONO_SHARE_OFF") {
        Option::Some(v) => {
            if str_len(v) > 0 && v != "0" {
                return;
            }
        }
        Option::None => {
        }
    }
    var i: i64 = 0;
    while i < program.type_aliases.len() {
        var ta: TypeAlias = program.type_aliases.get(i);
        // the first alias of a name, as Lowerer_lookup_type_alias finds it
        if HashMap_get(g_mono_alias_at, ta.name) == 0 {
            if mono_share_has_impl(program, ta.name) {
                HashMap_insert(g_mono_alias_at, ta.name, - 1);
            } else {
                g_mono_alias_tys.push(ta.alias_for);
                HashMap_insert(g_mono_alias_at, ta.name, g_mono_alias_tys.len());
            }
        }
        i = i + 1;
    }
    g_mono_share_on = g_mono_alias_tys.len() > 0;
}

/// Whether `name` has an impl or a trait impl of its own.
fn mono_share_has_impl(program: Program, name: str) -> bool {
    var i: i64 = 0;
    while i < program.impls.len() {
        if program.impls.get(i).struct_name == name {
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while i < program.trait_impls.len() {
        if program.trait_impls.get(i).type_name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn mono_share_done() {
    if g_mono_share_orig_n > 0 {
        match env_var("FID_MONO_STATS") {
            Option::Some(v) => {
                if str_len(v) > 0 && v != "0" {
                    p_eprint_str("mono: " + int_to_str(g_mono_share_orig_n) + " instance key(s), " + int_to_str(g_mono_share_canon_n) + " built, " + int_to_str(g_mono_share_orig_n - g_mono_share_canon_n) + " shared by lowered type\n");
                }
            }
            Option::None => {
            }
        }
    }
    g_mono_share_on = false;
    HashMap_drop(g_mono_alias_at);
    g_mono_alias_at = HashMap_new();
    g_mono_alias_tys = Vec::new();
    HashMap_drop(g_mono_share_orig_at);
    g_mono_share_orig_at = HashMap_new();
    HashMap_drop(g_mono_share_canon_at);
    g_mono_share_canon_at = HashMap_new();
}

/// `t` as lowering sees it (lower.fd Lowerer_resolve_type): an alias is its
/// target, also inside a reference, a raw pointer, an array and a generic's
/// arguments.
fn mono_share_type(t: Type, depth: i64) -> Type {
    if depth > 32 {
        return t;
    }
    match t {
        Type::Named(name) => {
            val at: i64 = HashMap_get(g_mono_alias_at, name);
            if at > 0 {
                return mono_share_type(g_mono_alias_tys.get(at - 1), depth + 1);
            }
            return t;
        }
        Type::Ref(inner, is_mut) => {
            return Type::Ref(box_type_new(mono_share_type(box_type_deref(inner), depth + 1)), is_mut);
        }
        Type::RawPtr(inner, is_mut) => {
            return Type::RawPtr(box_type_new(mono_share_type(box_type_deref(inner), depth + 1)), is_mut);
        }
        Type::Array(elem, size) => {
            return Type::Array(box_type_new(mono_share_type(box_type_deref(elem), depth + 1)), size);
        }
        Type::ArrayConst(elem, size_param) => {
            return Type::ArrayConst(box_type_new(mono_share_type(box_type_deref(elem), depth + 1)), size_param);
        }
        Type::Generic(name, args) => {
            var new_args: Vec<Type> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(mono_share_type(args.get(i), depth + 1));
                i = i + 1;
            }
            return Type::Generic(name, new_args);
        }
        _ => {
            return t;
        }
    }
    return t;
}

/// `subst` keyed as lowering sees its types; unchanged when nothing is an
/// alias, or when `may_share` is false.
fn mono_share_key(subst: Vec<SubstEntry>, may_share: bool) -> Vec<SubstEntry> {
    if !g_mono_share_on || !may_share {
        return subst;
    }
    var out: Vec<SubstEntry> = Vec::new();
    var changed: bool = false;
    var i: i64 = 0;
    while i < subst.len() {
        val t: Type = subst.get(i).val;
        val c: Type = mono_share_type(t, 0);
        if mangle_type(c) != mangle_type(t) {
            changed = true;
        }
        out.push(SubstEntry_new(subst.get(i).key, c));
        i = i + 1;
    }
    if !changed {
        return subst;
    }
    return out;
}

/// Whether a generic function's instances may share: not when it has L8H
/// specializations (instantiate chooses among them by the spelled types).
fn mono_share_fn_ok(name: str) -> bool {
    var i: i64 = 0;
    while i < g_mono_specs.len() {
        if spec_base_name(g_mono_specs.get(i).name) == name {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Whether a generic method's instances may share: not when a narrower impl
/// of its struct specializes it (mono_method_inst chooses by the types).
fn mono_share_method_ok(struct_name: str, method_name: str) -> bool {
    var i: i64 = 0;
    while i < g_mono_mspecs.len() {
        if g_mono_mspec_structs.get(i) == struct_name && spec_base_name(g_mono_mspecs.get(i).name) == method_name {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Counts an instance key (FID_MONO_STATS): `orig` as spelled, `canon` as
/// lowering sees it.
fn mono_share_count(orig: str, canon: str) {
    if HashMap_get(g_mono_share_orig_at, orig) == 0 {
        HashMap_insert(g_mono_share_orig_at, orig, 1);
        g_mono_share_orig_n = g_mono_share_orig_n + 1;
    }
    if HashMap_get(g_mono_share_canon_at, canon) == 0 {
        HashMap_insert(g_mono_share_canon_at, canon, 1);
        g_mono_share_canon_n = g_mono_share_canon_n + 1;
    }
}

var g_mono_ret_index: i64 = 0; var g_mono_ret_types: Vec<Type> = Vec::new(); pub fn monomorphize(program: Program) -> Program {
    g_mn_emit_used = false;
    mn_defaults_setup(program);
    mono_spec_setup(program);
    mn_gstructs_setup(program);
    // WP19: after mono_spec_setup (mono_share_fn_ok reads g_mono_specs)
    mono_share_setup(program);
    g_mono_ret_index = HashMap_new();
    g_mono_ret_types = Vec::new();
    var ri: i64 = 0;
    while ri < program.funcs.len() {
        if program.funcs.get(ri).type_params.len() == 0 {
            g_mono_ret_types.push(program.funcs.get(ri).ret_ty);
            HashMap_insert(g_mono_ret_index, program.funcs.get(ri).name, g_mono_ret_types.len());
        }
        ri = ri + 1;
    }
    var ctx: MonoCtx = MonoCtx_new();

    // Separate generic and non-generic functions. An instantiation already
    // in the program (made for a turbofish call) is not made again.
    var concrete_funcs: Vec<Func> = Vec::new();
    var i: i64 = 0;
    while i < program.funcs.len() {
        var func: Func = program.funcs.get(i);
        if func.type_params.len() == 0 {
            if str_contains(func.name, "__") {
                ctx.seen.push(func.name);
            }
            if mn_is_redundant(func) {
                // F45 @redundant: two channels and a voter
                mn_push_redundant(& mut concrete_funcs, func);
            } else if mn_is_event(func) && func.body.len() == 0 {
                // F34 @event: the compiler writes the event's body
                g_mn_emit_used = true;
                concrete_funcs.push(mn_event_body(func));
            } else {
                concrete_funcs.push(func);
            }
        } else {
            ctx.generics.push(GenericFuncEntry_new(func.name, func, func.type_params));
        }
        i = i + 1;
    }

    // Register trait impl associated type bindings
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        if ti.associated_types.len() > 0 {
            var entry: TraitAssocEntry = TraitAssocEntry_new(ti.trait_name, ti.type_name);
            var j: i64 = 0;
            while j < ti.associated_types.len() {
                entry.bindings.push(AssocBindingEntry_new(ti.associated_types.get(j).name, ti.associated_types.get(j).ty));
                j = j + 1;
            }
            ctx.trait_assoc_bindings.push(entry);
        }
        i = i + 1;
    }

    // Register generic impl methods BEFORE processing any functions
    // (LG4: also a method with type parameters of its own, `fn m<U>(self,
    // ..)`, in any impl: instantiated per call as `Type__m__U`)
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var j: i64 = 0;
        while j < imp.methods.len() {
            if imp.type_params.len() > 0 {
                ctx.generic_methods.push(GenericMethodEntry_new(imp.struct_name, imp.methods.get(j).name, imp.methods.get(j), mono_lg4_tps(imp.type_params, imp.methods.get(j))));
            } else if mono_lg4_generic(imp.methods.get(j)) {
                ctx.generic_methods.push(GenericMethodEntry_new(imp.struct_name, imp.methods.get(j).name, mono_lg4_self(imp.methods.get(j), imp.struct_name), imp.methods.get(j).type_params));
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Register generic trait impl methods
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var j: i64 = 0;
        while j < ti.methods.len() {
            if ti.type_params.len() > 0 {
                ctx.generic_methods.push(GenericMethodEntry_new(ti.type_name, ti.methods.get(j).name, ti.methods.get(j), mono_lg4_tps(ti.type_params, ti.methods.get(j))));
            } else if mono_lg4_generic(ti.methods.get(j)) {
                ctx.generic_methods.push(GenericMethodEntry_new(ti.type_name, ti.methods.get(j).name, mono_lg4_self(ti.methods.get(j), ti.type_name), ti.methods.get(j).type_params));
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Process concrete functions -- find calls to generics and instantiate
    var new_funcs: Vec<Func> = Vec::new();
    i = 0;
    while i < concrete_funcs.len() {
        new_funcs.push(process_func(concrete_funcs.get(i), & mut ctx));
        i = i + 1;
    }

    // Process impl methods -- separate generic from non-generic
    var new_impls: Vec<ImplDef> = Vec::new();
    i = 0;
    while i < program.impls.len() {
        var imp: ImplDef = program.impls.get(i);
        var new_methods: Vec<Func> = Vec::new();
        var j: i64 = 0;
        while j < imp.methods.len() {
            if imp.type_params.len() == 0 && mono_lg4_generic(imp.methods.get(j)) {
                // LG4: under its plain name, the instance with i64 for the
                // method's own parameters (a call mono could not type);
                // none for a bounded one (i64 has not its bound's methods)
                if mono_lg4_plain_ok(imp.methods.get(j)) {
                    new_methods.push(instantiate(imp.methods.get(j), mono_lg4_i64_subst(imp.methods.get(j), subst_new()), imp.methods.get(j).name, & mut ctx));
                }
            } else if imp.type_params.len() == 0 {
                new_methods.push(process_func(imp.methods.get(j), & mut ctx));
            } else {
                // A generic impl's methods are instantiated on demand; the i64
                // instance also keeps the plain name (Option_unwrap), for a
                // call whose receiver type is not known here (as mono.rs)
                var isub: Vec<SubstEntry> = subst_new();
                var tk: i64 = 0;
                while tk < imp.type_params.len() {
                    // L8A: a const parameter (`impl<T, const N: usize>`) is
                    // a number here, 0, so the body's N is a constant
                    if mono_is_const_param(imp.methods.get(j), imp.type_params.get(tk)) {
                        subst_set(& mut isub, imp.type_params.get(tk), Type::Named("__const_0"));
                    } else {
                        subst_set(& mut isub, imp.type_params.get(tk), Type::I64);
                    }
                    tk = tk + 1;
                }
                // LG4: and i64 for the method's own type parameters
                if mono_lg4_generic(imp.methods.get(j)) {
                    isub = mono_lg4_i64_subst(imp.methods.get(j), isub);
                }
                // L8H: the i64 instance of a method a narrower impl
                // specializes runs that one's body when it takes the type
                if mono_lg4_plain_ok(imp.methods.get(j)) {
                    new_methods.push(mono_method_inst(imp.struct_name, imp.methods.get(j), imp.type_params, isub, imp.methods.get(j).name, & mut ctx));
                }
            }
            j = j + 1;
        }
        var new_impl: ImplDef = ImplDef_new(imp.struct_name);
        new_impl.methods = new_methods;
        new_impls.push(new_impl);
        i = i + 1;
    }

    // Process trait impl methods -- separate generic from non-generic
    var new_trait_impls: Vec<TraitImpl> = Vec::new();
    i = 0;
    while i < program.trait_impls.len() {
        var ti: TraitImpl = program.trait_impls.get(i);
        var new_methods: Vec<Func> = Vec::new();
        var j: i64 = 0;
        while j < ti.methods.len() {
            if ti.type_params.len() == 0 && mono_lg4_generic(ti.methods.get(j)) {
                // LG4: the i64 instance under the plain name, as for an impl
                if mono_lg4_plain_ok(ti.methods.get(j)) {
                    new_methods.push(instantiate(ti.methods.get(j), mono_lg4_i64_subst(ti.methods.get(j), subst_new()), ti.methods.get(j).name, & mut ctx));
                }
            } else if ti.type_params.len() == 0 {
                new_methods.push(process_func(ti.methods.get(j), & mut ctx));
            }
            j = j + 1;
        }
        var new_ti: TraitImpl = TraitImpl_new(ti.trait_name, ti.type_name);
        new_ti.methods = new_methods;
        new_ti.associated_types = ti.associated_types;
        new_trait_impls.push(new_ti);
        i = i + 1;
    }

    // Add all instantiated functions
    i = 0;
    while i < ctx.instantiated.len() {
        new_funcs.push(ctx.instantiated.get(i));
        i = i + 1;
    }

    var result: Program = program_new();
    result.module = program.module;
    result.structs = program.structs;
    result.enums = program.enums;
    result.funcs = new_funcs;
    result.consts = program.consts;
    result.globals = mn_emit_globals(program.globals);
    result.type_aliases = program.type_aliases;
    result.impls = new_impls;
    result.imports = program.imports;
    result.attributes = program.attributes;
    result.traits = program.traits;
    result.trait_impls = new_trait_impls;
    result.extern_decls = program.extern_decls;
    result.layers = program.layers;
    result.models = program.models;
    result.components = program.components;
    result.systems = program.systems;
    result.state_machines = program.state_machines;
    result.event_handlers = program.event_handlers;
    mn_defaults_done();
    mono_share_done();
    return result;
}

// --- Fix up call sites for generic functions -----------------------------
// For each call to a generic, re-infer the substitution from argument types
// and use the correct mangled name.

pub fn fixup_generic_calls(stmts: Vec<Stmt>, generics: Vec<GenericFuncEntry>, gm: Vec<GenericMethodEntry>, current_func: Func) -> Vec<Stmt> {
    var result: Vec<Stmt> = Vec::new();
    var i: i64 = 0;
    while i < stmts.len() {
        result.push(fixup_generic_calls_stmt(stmts.get(i), generics, gm, current_func));
        i = i + 1;
    }
    return result;
}

pub fn fixup_generic_calls_stmt(stmt: Stmt, generics: Vec<GenericFuncEntry>, gm: Vec<GenericMethodEntry>, current_func: Func) -> Stmt {
    match stmt {
        Stmt::Expr(e, line) => {
            return Stmt::Expr(fixup_generic_calls_expr(e, generics, gm, current_func), line);
        }
        Stmt::Let(name, ty, expr, is_mut, is_persist, annotations, line) => {
            var hinted: Vec<Expr> = fixup_hinted_call(expr, ty, generics, gm, current_func);
            if hinted.len() > 0 {
                return Stmt::Let(name, ty, hinted.get(0), is_mut, is_persist, annotations, line);
            }
            return Stmt::Let(name, ty, fixup_generic_calls_expr(expr, generics, gm, current_func), is_mut, is_persist, annotations, line);
        }
        Stmt::LetTuple(names, expr, line) => {
            return Stmt::LetTuple(names, fixup_generic_calls_expr(expr, generics, gm, current_func), line);
        }
        Stmt::Return(opt, line) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    var rhinted: Vec<Expr> = fixup_hinted_call(mn_box_expr_deref(e), OptType::Some(current_func.ret_ty), generics, gm, current_func);
                    if rhinted.len() > 0 {
                        return Stmt::Return(OptBoxExpr::Some(mn_box_expr_new(rhinted.get(0))), line);
                    }
                    return Stmt::Return(OptBoxExpr::Some(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(e), generics, gm, current_func))), line);
                }
                OptBoxExpr::None => {
                    return Stmt::Return(OptBoxExpr::None, line);
                }
            }
            return Stmt::Return(OptBoxExpr::None, line);
        }
        Stmt::If(cond, then_block, else_block, line) => {
            var new_then: Vec<Stmt> = fixup_generic_calls(then_block, generics, gm, current_func);
            var new_else: OptStmts = OptStmts::None;
            match else_block {
                OptStmts::Some(eb) => {
                    new_else = OptStmts::Some(fixup_generic_calls(eb, generics, gm, current_func));
                }
                OptStmts::None => {
                }
            }
            return Stmt::If(fixup_generic_calls_expr(cond, generics, gm, current_func), new_then, new_else, line);
        }
        Stmt::While(cond, body, line) => {
            return Stmt::While(fixup_generic_calls_expr(cond, generics, gm, current_func), fixup_generic_calls(body, generics, gm, current_func), line);
        }
        Stmt::For(var_name, iterator, body, line) => {
            return Stmt::For(var_name, fixup_generic_calls_expr(iterator, generics, gm, current_func), fixup_generic_calls(body, generics, gm, current_func), line);
        }
        Stmt::Assign(target, op, expr, line) => {
            return Stmt::Assign(target, op, fixup_generic_calls_expr(expr, generics, gm, current_func), line);
        }
        Stmt::FieldAssign(obj, field, op, expr, line) => {
            return Stmt::FieldAssign(fixup_generic_calls_expr(obj, generics, gm, current_func), field, op, fixup_generic_calls_expr(expr, generics, gm, current_func), line);
        }
        Stmt::IndexAssign(arr, index, op, expr, line) => {
            return Stmt::IndexAssign(arr, fixup_generic_calls_expr(index, generics, gm, current_func), op, fixup_generic_calls_expr(expr, generics, gm, current_func), line);
        }
        Stmt::Loop(body, line) => {
            return Stmt::Loop(fixup_generic_calls(body, generics, gm, current_func), line);
        }
        Stmt::Defer(body, line) => {
            return Stmt::Defer(fixup_generic_calls(body, generics, gm, current_func), line);
        }
        Stmt::Unsafe(body, line) => {
            return Stmt::Unsafe(fixup_generic_calls(body, generics, gm, current_func), line);
        }
        Stmt::Match(scrut, arms, line) => {
            return Stmt::Match(fixup_generic_calls_expr(scrut, generics, gm, current_func), fixup_match_arms(arms, generics, gm, current_func), line);
        }
        // Every block statement too (known-bugs 2g.8: a generic call in
        // sandbox, region, txn, select, parallel, ... kept its unmangled
        // name and failed at run time)
        Stmt::Sandbox(body, line) => {
            return Stmt::Sandbox(fixup_generic_calls(body, generics, gm, current_func), line);
        }
        Stmt::Txn(body, line) => {
            return Stmt::Txn(fixup_generic_calls(body, generics, gm, current_func), line);
        }
        Stmt::SpawnScope(body, line) => {
            return Stmt::SpawnScope(fixup_generic_calls(body, generics, gm, current_func), line);
        }
        Stmt::RegionBlock(name, budget, is_gpu, is_kv, window, body, line) => {
            return Stmt::RegionBlock(name, budget, is_gpu, is_kv, window, fixup_generic_calls(body, generics, gm, current_func), line);
        }
        Stmt::GradBlock(var_name, body, line) => {
            return Stmt::GradBlock(var_name, fixup_generic_calls(body, generics, gm, current_func), line);
        }
        Stmt::Query(components, body, line) => {
            return Stmt::Query(components, fixup_generic_calls(body, generics, gm, current_func), line);
        }
        Stmt::Backward(loss, line) => {
            return Stmt::Backward(fixup_generic_calls_expr(loss, generics, gm, current_func), line);
        }
        Stmt::DerefAssign(ptr_expr, op, expr, line) => {
            return Stmt::DerefAssign(fixup_generic_calls_expr(ptr_expr, generics, gm, current_func), op, fixup_generic_calls_expr(expr, generics, gm, current_func), line);
        }
        Stmt::Break(opt, line) => {
            match opt {
                OptBoxExpr::Some(be) => {
                    return Stmt::Break(OptBoxExpr::Some(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(be), generics, gm, current_func))), line);
                }
                OptBoxExpr::None => {
                }
            }
            return Stmt::Break(OptBoxExpr::None, line);
        }
        Stmt::Do(effect, op, args, line) => {
            return Stmt::Do(effect, op, fixup_exprs(args, generics, gm, current_func), line);
        }
        Stmt::Parallel(branches, line) => {
            var nb: Vec<Vec<Stmt>> = Vec::new();
            var bi: i64 = 0;
            while bi < branches.len() {
                nb.push(fixup_generic_calls(branches.get(bi), generics, gm, current_func));
                bi = bi + 1;
            }
            return Stmt::Parallel(nb, line);
        }
        Stmt::Select(cases, default, line) => {
            var nc: Vec<SelectCase> = Vec::new();
            var ci: i64 = 0;
            while ci < cases.len() {
                var c: SelectCase = cases.get(ci);
                nc.push(SelectCase {
                    channel: fixup_generic_calls_expr(c.channel, generics, gm, current_func), var_name: c.var_name, body: fixup_generic_calls(c.body, generics, gm, current_func)
                });
                ci = ci + 1;
            }
            var nd: OptStmts = OptStmts::None;
            match default {
                OptStmts::Some(db) => {
                    nd = OptStmts::Some(fixup_generic_calls(db, generics, gm, current_func));
                }
                OptStmts::None => {
                }
            }
            return Stmt::Select(nc, nd, line);
        }
        Stmt::Handle(body, handlers, line) => {
            var nh: Vec<EffectHandler> = Vec::new();
            var hi: i64 = 0;
            while hi < handlers.len() {
                var h: EffectHandler = handlers.get(hi);
                nh.push(EffectHandler {
                    effect: h.effect, op: h.op, params: h.params, body: fixup_generic_calls(h.body, generics, gm, current_func)
                });
                hi = hi + 1;
            }
            return Stmt::Handle(fixup_generic_calls(body, generics, gm, current_func), nh, line);
        }
        other => {
            return other;
        }
    }
    return stmt;
}

/// The substitution for a call of a generic impl method, as mono.rs: from the
/// arguments (after `self`), then from the receiver's type arguments
/// (`impl<T> Option` on an Option<f64> gives T=f64), then i64 for the rest.
pub fn method_subst(gen_func: Func, type_params: Vec<str>, arg_types: Vec<Type>, recv_ty: Type) -> Vec<SubstEntry> {
    var param_types: Vec<Type> = Vec::new();
    var j: i64 = 1;
    while j < gen_func.params.len() {
        param_types.push(gen_func.params.get(j).ty);
        j = j + 1;
    }
    var subst: Vec<SubstEntry> = infer_subst(param_types, arg_types, type_params);
    var recv: Type = recv_ty;
    match recv_ty {
        Type::Ref(inner, _) => {
            recv = box_type_deref(inner);
        }
        _ => {
        }
    }
    // L8H: the receiver against `self`'s type first: in `impl<U>
    // Wrap<Vec<U>>` a Wrap<Vec<str>> gives U = str, not the struct's first
    // argument (for `impl<T> Wrap<T>` the two agree)
    if gen_func.params.len() > 0 && gen_func.params.get(0).name == "self" {
        var ssub: Vec<SubstEntry> = Vec::new();
        infer_from_pair(mono_self_value_type(gen_func.params.get(0).ty), recv, type_params, & mut ssub);
        var sk: i64 = 0;
        while sk < ssub.len() {
            if !subst_contains(subst, ssub.get(sk).key) {
                subst_set(& mut subst, ssub.get(sk).key, ssub.get(sk).val);
            }
            sk = sk + 1;
        }
    }
    match recv {
        Type::Generic(_, rargs) => {
            var k: i64 = 0;
            while k < type_params.len() && k < rargs.len() {
                if !subst_contains(subst, type_params.get(k)) {
                    subst_set(& mut subst, type_params.get(k), rargs.get(k));
                }
                k = k + 1;
            }
        }
        _ => {
        }
    }
    var t: i64 = 0;
    while t < type_params.len() {
        if !subst_contains(subst, type_params.get(t)) {
            subst_set(& mut subst, type_params.get(t), Type::I64);
        }
        t = t + 1;
    }
    return subst;
}

/// The substitution for a call: from the arguments, then, for a type
/// parameter they leave unbound, from the expected type (the element after
/// the arguments in `arg_types`, when there is one) against the result type.
pub fn subst_with_result(gen_func: Func, arg_types: Vec<Type>, type_params: Vec<str>) -> Vec<SubstEntry> {
    var param_types: Vec<Type> = Vec::new();
    var args: Vec<Type> = Vec::new();
    var j: i64 = 0;
    while j < gen_func.params.len() {
        param_types.push(gen_func.params.get(j).ty);
        if j < arg_types.len() {
            args.push(arg_types.get(j));
        }
        j = j + 1;
    }
    var subst: Vec<SubstEntry> = infer_subst(param_types, args, type_params);
    if arg_types.len() == param_types.len() + 1 {
        var from_result: Vec<SubstEntry> = subst_new();
        infer_from_pair(gen_func.ret_ty, arg_types.get(param_types.len()), type_params, & mut from_result);
        var k: i64 = 0;
        while k < type_params.len() {
            var tp: str = type_params.get(k);
            if !subst_contains(subst, tp) {
                match subst_get(from_result, tp) {
                    OptType::Some(t) => {
                        subst_set(& mut subst, tp, t);
                    }
                    OptType::None => {
                    }
                }
            }
            k = k + 1;
        }
    }
    return subst;
}

/// A direct call to a generic function whose result has a declared type:
/// renamed with that type for what the arguments leave unbound. One
/// expression, or none.
pub fn fixup_hinted_call(expr: Expr, hint: OptType, generics: Vec<GenericFuncEntry>, gm: Vec<GenericMethodEntry>, current_func: Func) -> Vec<Expr> {
    var out: Vec<Expr> = Vec::new();
    if g_mono_tf_only {
        return out;
    }
    var h: Type = Type::Infer;
    match hint {
        OptType::Some(t) => {
            h = t;
        }
        OptType::None => {
            return out;
        }
    }
    match expr {
        Expr::Call(callee, args) => {
            match generic_funcs_get(generics, callee) {
                OptGenericFunc::Some(entry) => {
                    var new_args: Vec<Expr> = Vec::new();
                    var arg_types: Vec<Type> = Vec::new();
                    var i: i64 = 0;
                    while i < args.len() {
                        var na: Expr = fixup_generic_calls_expr(args.get(i), generics, gm, current_func);
                        new_args.push(na);
                        arg_types.push(infer_expr_type(na, current_func));
                        i = i + 1;
                    }
                    arg_types.push(h);
                    var subst: Vec<SubstEntry> = subst_with_result(entry.func, arg_types, entry.type_params);
                    var k: i64 = 0;
                    while k < entry.type_params.len() {
                        if !subst_contains(subst, entry.type_params.get(k)) {
                            return out;
                        }
                        k = k + 1;
                    }
                    // WP19: the instance process_func made (keyed as lowered)
                    subst = mono_share_key(subst, mono_share_fn_ok(callee));
                    out.push(Expr::Call(mangle(callee, subst, entry.type_params), new_args));
                    return out;
                }
                OptGenericFunc::None => {
                }
            }
        }
        _ => {
        }
    }
    return out;
}

fn fixup_match_arms(arms: Vec<MatchArm>, generics: Vec<GenericFuncEntry>, gm: Vec<GenericMethodEntry>, current_func: Func) -> Vec<MatchArm> {
    var out: Vec<MatchArm> = Vec::new();
    var i: i64 = 0;
    while i < arms.len() {
        var arm: MatchArm = arms.get(i);
        var arm_guard: OptBoxExpr = OptBoxExpr::None;
        match arm.guard {
            OptBoxExpr::Some(g) => {
                arm_guard = OptBoxExpr::Some(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(g), generics, gm, current_func)));
            }
            OptBoxExpr::None => {
            }
        }
        out.push(MatchArm_new(arm.pattern, arm_guard, fixup_generic_calls(arm.body, generics, gm, current_func)));
        i = i + 1;
    }
    return out;
}

pub fn fixup_generic_calls_expr(expr: Expr, generics: Vec<GenericFuncEntry>, gm: Vec<GenericMethodEntry>, current_func: Func) -> Expr {
    match expr {
        Expr::Call(callee, args) => {
            // First, recursively fix up args
            var new_args: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(fixup_generic_calls_expr(args.get(i), generics, gm, current_func));
                i = i + 1;
            }
            if g_mono_va_on {
                // L8E: the arguments after the fixed ones of a variadic
                // function, packed into one Vec
                var vat: i64 = HashMap_get(g_mono_va_at, callee);
                if vat > 0 {
                    new_args = mono_va_pack(new_args, g_mono_va_fixed.get(vat - 1), g_mono_va_elem.get(vat - 1));
                }
                // a pack function: the clone for this many arguments
                if g_mono_pack_at != 0 && vat == 0 {
                    val pat: i64 = HashMap_get(g_mono_pack_at, callee);
                    if pat > 0 {
                        val pk: str = mono_pack_call(callee, pat, new_args);
                        if pk != "" {
                            return Expr::Call(pk, new_args);
                        }
                    }
                }
            }
            if !g_mono_va_only && str_contains(callee, "::<#") {
                return Expr::Call(mono_turbofish_callee(callee, generics, current_func.name), new_args);
            }
            if g_mono_tf_only {
                return Expr::Call(callee, new_args);
            }
            // Check if this is a call to a generic function
            match generic_funcs_get(generics, callee) {
                OptGenericFunc::Some(entry) => {
                    var arg_types: Vec<Type> = Vec::new();
                    var j: i64 = 0;
                    while j < new_args.len() {
                        arg_types.push(infer_expr_type(new_args.get(j), current_func));
                        j = j + 1;
                    }
                    var param_types: Vec<Type> = Vec::new();
                    var k: i64 = 0;
                    while k < entry.func.params.len() {
                        param_types.push(entry.func.params.get(k).ty);
                        k = k + 1;
                    }
                    var subst: Vec<SubstEntry> = infer_subst(param_types, arg_types, entry.type_params);
                    // WP19: the instance process_func made (keyed as lowered)
                    subst = mono_share_key(subst, mono_share_fn_ok(callee));
                    var mangled: str = mangle(callee, subst, entry.type_params);
                    return Expr::Call(mangled, new_args);
                }
                OptGenericFunc::None => {
                    return Expr::Call(callee, new_args);
                }
            }
            return Expr::Call(callee, new_args);
        }
        Expr::Binary(op, left, right) => {
            return Expr::Binary(op, mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(left), generics, gm, current_func)), mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(right), generics, gm, current_func)));
        }
        Expr::Unary(op, inner) => {
            return Expr::Unary(op, mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)));
        }
        Expr::MethodCall(receiver, method, args) => {
            var new_args: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < args.len() {
                new_args.push(fixup_generic_calls_expr(args.get(i), generics, gm, current_func));
                i = i + 1;
            }
            var recv_expr: Expr = mn_box_expr_deref(receiver);
            var new_recv: Expr = fixup_generic_calls_expr(recv_expr, generics, gm, current_func);
            // A generic impl method: a call to the instantiation for this
            // receiver's type, with the receiver as first argument
            match infer_receiver_struct_name(recv_expr, current_func) {
                OptStr::Some(sn) => {
                    match generic_methods_get(gm, sn, method) {
                        OptGenericMethod::Some(gen) => {
                            var arg_types: Vec<Type> = Vec::new();
                            var j: i64 = 0;
                            while j < new_args.len() {
                                arg_types.push(infer_expr_type(new_args.get(j), current_func));
                                j = j + 1;
                            }
                            var msubst: Vec<SubstEntry> = method_subst(gen.func, gen.type_params, arg_types, infer_expr_type(recv_expr, current_func));
                            // WP19: the instance process_func made (keyed as lowered)
                            msubst = mono_share_key(msubst, mono_share_method_ok(sn, method));
                            var all_args: Vec<Expr> = Vec::new();
                            all_args.push(new_recv);
                            j = 0;
                            while j < new_args.len() {
                                all_args.push(new_args.get(j));
                                j = j + 1;
                            }
                            return Expr::Call(mangle_method(sn, method, msubst, gen.type_params), all_args);
                        }
                        OptGenericMethod::None => {
                        }
                    }
                }
                OptStr::None => {
                }
            }
            return Expr::MethodCall(mn_box_expr_new(new_recv), method, new_args);
        }
        Expr::FieldAccess(inner, field) => {
            return Expr::FieldAccess(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)), field);
        }
        Expr::Index(array, index) => {
            return Expr::Index(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(array), generics, gm, current_func)), mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(index), generics, gm, current_func)));
        }
        Expr::If(cond, then_block, else_block) => {
            var new_then: Vec<Stmt> = fixup_generic_calls(then_block, generics, gm, current_func);
            var new_else: OptStmts = OptStmts::None;
            match else_block {
                OptStmts::Some(eb) => {
                    new_else = OptStmts::Some(fixup_generic_calls(eb, generics, gm, current_func));
                }
                OptStmts::None => {
                }
            }
            return Expr::If(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(cond), generics, gm, current_func)), new_then, new_else);
        }
        Expr::Block(stmts) => {
            return Expr::Block(fixup_generic_calls(stmts, generics, gm, current_func));
        }
        // Calls inside these are renamed as anywhere else (as mono.rs)
        Expr::Try(inner) => {
            return Expr::Try(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)));
        }
        Expr::Ref(inner, is_mut) => {
            return Expr::Ref(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)), is_mut);
        }
        Expr::Deref(inner) => {
            return Expr::Deref(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)));
        }
        Expr::Cast(inner, target_ty) => {
            return Expr::Cast(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)), target_ty);
        }
        Expr::StrConcat(left, right) => {
            return Expr::StrConcat(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(left), generics, gm, current_func)), mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(right), generics, gm, current_func)));
        }
        Expr::Coalesce(inner, dflt) => {
            return Expr::Coalesce(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)), mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(dflt), generics, gm, current_func)));
        }
        Expr::EnumLit(ename, variant, eargs) => {
            var nea: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < eargs.len() {
                nea.push(fixup_generic_calls_expr(eargs.get(i), generics, gm, current_func));
                i = i + 1;
            }
            return Expr::EnumLit(ename, variant, nea);
        }
        Expr::ArrayLit(elem_ty, elems) => {
            var nel: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < elems.len() {
                nel.push(fixup_generic_calls_expr(elems.get(i), generics, gm, current_func));
                i = i + 1;
            }
            return Expr::ArrayLit(elem_ty, nel);
        }
        Expr::TupleLit(items) => {
            var nti: Vec<Expr> = Vec::new();
            var i: i64 = 0;
            while i < items.len() {
                nti.push(fixup_generic_calls_expr(items.get(i), generics, gm, current_func));
                i = i + 1;
            }
            return Expr::TupleLit(nti);
        }
        Expr::StructLit(sname, fields, spread) => {
            var nfi: Vec<FieldInit> = Vec::new();
            var i: i64 = 0;
            while i < fields.len() {
                nfi.push(FieldInit_new(fields.get(i).name, fixup_generic_calls_expr(fields.get(i).value, generics, gm, current_func)));
                i = i + 1;
            }
            var nsp: OptBoxExpr = OptBoxExpr::None;
            match spread {
                OptBoxExpr::Some(se) => {
                    nsp = OptBoxExpr::Some(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(se), generics, gm, current_func)));
                }
                OptBoxExpr::None => {
                }
            }
            return Expr::StructLit(sname, nfi, nsp);
        }
        Expr::Match(scrut, arms) => {
            return Expr::Match(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(scrut), generics, gm, current_func)), fixup_match_arms(arms, generics, gm, current_func));
        }
        Expr::TryBlock(tbody) => {
            return Expr::TryBlock(fixup_generic_calls(tbody, generics, gm, current_func));
        }
        // known-bugs 2g.8: closures, f-strings, pipes, await/spawn/yield,
        // ranges, ... were left as they were
        Expr::Closure(params, body, ret_ty) => {
            var cf: Func = mono_closure_ctx(current_func, params, body);
            return Expr::Closure(params, fixup_generic_calls(body, generics, gm, cf), ret_ty);
        }
        Expr::FString(parts) => {
            var np: Vec<FStringPart> = Vec::new();
            var pi: i64 = 0;
            while pi < parts.len() {
                match parts.get(pi) {
                    FStringPart::Literal(lt) => {
                        np.push(FStringPart::Literal(lt));
                    }
                    FStringPart::Expr(pe) => {
                        np.push(FStringPart::Expr(fixup_generic_calls_expr(pe, generics, gm, current_func)));
                    }
                }
                pi = pi + 1;
            }
            return Expr::FString(np);
        }
        Expr::PipeForward(left, right) => {
            // `a |> f` and `a |> f(b)` are calls f(a) and f(a, b): fixed up
            // as such, so a generic f is renamed for a's type
            var nl: Expr = fixup_generic_calls_expr(mn_box_expr_deref(left), generics, gm, current_func);
            match mn_box_expr_deref(right) {
                Expr::Ident(fname) => {
                    if !g_mono_tf_only && generic_funcs_contains(generics, fname) {
                        var one: Vec<Expr> = Vec::new();
                        one.push(nl);
                        return fixup_generic_calls_expr(Expr::Call(fname, one), generics, gm, current_func);
                    }
                }
                Expr::Call(pcallee, pargs) => {
                    if !g_mono_tf_only && generic_funcs_contains(generics, pcallee) {
                        var all: Vec<Expr> = Vec::new();
                        all.push(nl);
                        var ai: i64 = 0;
                        while ai < pargs.len() {
                            all.push(pargs.get(ai));
                            ai = ai + 1;
                        }
                        return fixup_generic_calls_expr(Expr::Call(pcallee, all), generics, gm, current_func);
                    }
                }
                _ => {
                }
            }
            return Expr::PipeForward(mn_box_expr_new(nl), mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(right), generics, gm, current_func)));
        }
        Expr::Await(inner) => {
            return Expr::Await(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)));
        }
        Expr::Spawn(inner) => {
            return Expr::Spawn(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)));
        }
        Expr::Yield(inner) => {
            return Expr::Yield(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)));
        }
        Expr::Comptime(inner) => {
            return Expr::Comptime(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)));
        }
        Expr::QuantCast(inner, qt) => {
            return Expr::QuantCast(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)), qt);
        }
        Expr::IsCheck(inner, tn) => {
            return Expr::IsCheck(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)), tn);
        }
        Expr::NamedArg(an, inner) => {
            return Expr::NamedArg(an, mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)));
        }
        Expr::OptionalFieldAccess(inner, of) => {
            return Expr::OptionalFieldAccess(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(inner), generics, gm, current_func)), of);
        }
        Expr::Range(rs, re, incl) => {
            return Expr::Range(mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(rs), generics, gm, current_func)), mn_box_expr_new(fixup_generic_calls_expr(mn_box_expr_deref(re), generics, gm, current_func)), incl);
        }
        Expr::ComptimeBlock(cstmts) => {
            return Expr::ComptimeBlock(fixup_generic_calls(cstmts, generics, gm, current_func));
        }
        other => {
            return other;
        }
    }
    return expr;
}

/// The function a closure's body is typed in: its own parameters first,
/// then the enclosing function's, and its own body (whose `let`s give its
/// locals' types). Typed against the enclosing function, a call `inc(v)` on
/// a closure parameter was mangled `inc__v` and failed at run time.
fn mono_closure_ctx(outer: Func, params: Vec<Param>, body: Vec<Stmt>) -> Func {
    var f: Func = outer;
    var ps: Vec<Param> = Vec::new();
    var i: i64 = 0;
    while i < params.len() {
        ps.push(params.get(i));
        i = i + 1;
    }
    i = 0;
    while i < outer.params.len() {
        ps.push(outer.params.get(i));
        i = i + 1;
    }
    f.params = ps;
    var b: Vec<Stmt> = Vec::new();
    i = 0;
    while i < body.len() {
        b.push(body.get(i));
        i = i + 1;
    }
    i = 0;
    while i < outer.body.len() {
        b.push(outer.body.get(i));
        i = i + 1;
    }
    f.body = b;
    return f;
}

fn fixup_exprs(es: Vec<Expr>, generics: Vec<GenericFuncEntry>, gm: Vec<GenericMethodEntry>, current_func: Func) -> Vec<Expr> {
    var out: Vec<Expr> = Vec::new();
    var i: i64 = 0;
    while i < es.len() {
        out.push(fixup_generic_calls_expr(es.get(i), generics, gm, current_func));
        i = i + 1;
    }
    return out;
}

// --- Process a function: find calls to generics, instantiate, rewrite ----

pub fn process_func(func: Func, ctx: & mut MonoCtx) -> Func {
    // Collect all calls to generic functions in this function's body
    var calls_to_instantiate: Vec<GenericCallEntry> = Vec::new();
    var method_calls_to_instantiate: Vec<GenericMethodCallEntry> = Vec::new();

    var i: i64 = 0;
    while i < func.body.len() {
        collect_generic_calls_stmt(func.body.get(i), ctx.generics, ctx.generic_methods, & mut calls_to_instantiate, & mut method_calls_to_instantiate, func);
        i = i + 1;
    }

    // Instantiate each generic function call
    var local_renames: Vec<RenameEntry> = rename_new();
    i = 0;
    while i < calls_to_instantiate.len() {
        var entry: GenericCallEntry = calls_to_instantiate.get(i);
        var callee: str = entry.callee;
        var arg_types: Vec<Type> = entry.arg_types;

        match generic_funcs_get(ctx.generics, callee) {
            OptGenericFunc::Some(gen) => {
                var subst: Vec<SubstEntry> = subst_with_result(gen.func, arg_types, gen.type_params);

                // Check that all type params are bound
                var all_bound: bool = true;
                var k: i64 = 0;
                while k < gen.type_params.len() {
                    if !subst_contains(subst, gen.type_params.get(k)) {
                        all_bound = false;
                    }
                    k = k + 1;
                }
                if !all_bound {
                    i = i + 1;
                    continue;
                }

                // WP19: keyed by the types as lowering sees them, so types
                // that lower alike share one instance
                if g_mono_share_on {
                    val spelled: str = mangle(callee, subst, gen.type_params);
                    subst = mono_share_key(subst, mono_share_fn_ok(callee));
                    mono_share_count(spelled, mangle(callee, subst, gen.type_params));
                }
                var mangled: str = mangle(callee, subst, gen.type_params);

                if MonoCtx_seen_insert(ctx, mangled) {
                    var instantiated: Func = instantiate(gen.func, subst, mangled, ctx);
                    ctx.instantiated.push(instantiated);
                }

                rename_set(& mut local_renames, callee, mangled);
            }
            OptGenericFunc::None => {
            }
        }
        i = i + 1;
    }

    // Instantiate each generic method call
    var method_renames: Vec<RenameEntry> = rename_new();
    i = 0;
    while i < method_calls_to_instantiate.len() {
        var entry: GenericMethodCallEntry = method_calls_to_instantiate.get(i);
        var struct_name: str = entry.struct_name;
        var method_name: str = entry.method_name;
        var arg_types: Vec<Type> = entry.arg_types;

        match generic_methods_get(ctx.generic_methods, struct_name, method_name) {
            OptGenericMethod::Some(gen) => {
                var subst: Vec<SubstEntry> = method_subst(gen.func, gen.type_params, arg_types, entry.recv_ty);

                // WP19: as for a generic function's instances
                if g_mono_share_on {
                    val spelled: str = mangle_method(struct_name, method_name, subst, gen.type_params);
                    subst = mono_share_key(subst, mono_share_method_ok(struct_name, method_name));
                    mono_share_count(spelled, mangle_method(struct_name, method_name, subst, gen.type_params));
                }
                var mangled: str = mangle_method(struct_name, method_name, subst, gen.type_params);

                if MonoCtx_seen_insert(ctx, mangled) {
                    // L8H: the most specific impl's method for this receiver
                    var instantiated: Func = mono_method_inst(struct_name, gen.func, gen.type_params, subst, mangled, ctx);
                    ctx.instantiated.push(instantiated);
                }

                rename_set(& mut method_renames, method_name, mangled);
            }
            OptGenericMethod::None => {
            }
        }
        i = i + 1;
    }

    // Fixup call sites for generics with multiple instantiations
    var fixed_body: Vec<Stmt> = fixup_generic_calls(func.body, ctx.generics, ctx.generic_methods, func);
    // Apply type substitution (no renames: fixup renamed each call site from
    // its own argument and receiver types)
    var new_body: Vec<Stmt> = Vec::new();
    i = 0;
    while i < fixed_body.len() {
        new_body.push(subst_stmt(fixed_body.get(i), subst_new(), rename_new(), rename_new()));
        i = i + 1;
    }

    var result: Func = Func_new(func.name, func.ret_ty);
    result.is_pub = func.is_pub;
    result.params = func.params;
    result.body = new_body;
    result.is_comptime = false;
    result.declared_effects = func.declared_effects;
    result.has_effect_annotation = func.has_effect_annotation;
    result.is_interrupt = func.is_interrupt;
    result.annotations = func.annotations;
    result.preconditions = func.preconditions;
    result.postconditions = func.postconditions;
    result.is_async = func.is_async;
    result.line = func.line;
    return result;
}

// --- Instantiate a generic function with a concrete substitution ---------

pub fn instantiate(gen_func: Func, subst: Vec<SubstEntry>, mangled_name: str, ctx: & mut MonoCtx) -> Func {
    // L8H: an instantiation of a name with specializations takes the body
    // of the most specific definition whose parameters take its types (the
    // type checker has reported a tie)
    if g_mono_specs.len() > 0 && spec_base_name(gen_func.name) == "" {
        var cands: Vec<Func> = Vec::new();
        cands.push(gen_func);
        var si: i64 = 0;
        while si < g_mono_specs.len() {
            if spec_base_name(g_mono_specs.get(si).name) == gen_func.name {
                cands.push(g_mono_specs.get(si));
            }
            si = si + 1;
        }
        if cands.len() > 1 {
            var concrete: Vec<Type> = Vec::new();
            var ci: i64 = 0;
            while ci < gen_func.params.len() {
                concrete.push(subst_type(gen_func.params.get(ci).ty, subst));
                ci = ci + 1;
            }
            var tie: Vec<i64> = Vec::new();
            val chosen: i64 = spec_choose(cands, concrete, & mut tie);
            if chosen > 0 {
                val sf: Func = cands.get(chosen);
                return instantiate(sf, infer_subst(spec_param_types(sf), concrete, sf.type_params), mangled_name, ctx);
            }
        }
    }
    // Apply substitution to params, then resolve associated types
    var new_params: Vec<Param> = Vec::new();
    var i: i64 = 0;
    while i < gen_func.params.len() {
        var substituted: Type = subst_type(gen_func.params.get(i).ty, subst);
        var resolved: Type = resolve_assoc_types(substituted, subst, ctx.trait_assoc_bindings);
        var p: Param = Param_new(gen_func.params.get(i).name, resolved, gen_func.params.get(i).is_pub);
        p.annotations = gen_func.params.get(i).annotations;
        p.is_variadic = gen_func.params.get(i).is_variadic;
        new_params.push(p);
        i = i + 1;
    }

    var substituted_ret: Type = subst_type(gen_func.ret_ty, subst);
    var new_ret_ty: Type = resolve_assoc_types(substituted_ret, subst, ctx.trait_assoc_bindings);

    // Apply the type substitution to the body
    var subst_body: Vec<Stmt> = Vec::new();
    i = 0;
    while i < gen_func.body.len() {
        subst_body.push(subst_stmt(gen_func.body.get(i), subst, rename_new(), rename_new()));
        i = i + 1;
    }

    // Create a temporary concrete function with the substituted body
    var temp_func: Func = Func_new(mangled_name, new_ret_ty);
    temp_func.is_pub = gen_func.is_pub;
    temp_func.params = new_params;
    temp_func.body = subst_body;
    temp_func.is_comptime = false;
    temp_func.declared_effects = gen_func.declared_effects;
    temp_func.has_effect_annotation = gen_func.has_effect_annotation;
    temp_func.is_interrupt = gen_func.is_interrupt;
    temp_func.annotations = gen_func.annotations;
    temp_func.preconditions = gen_func.preconditions;
    temp_func.postconditions = gen_func.postconditions;
    temp_func.is_async = gen_func.is_async;
    temp_func.line = gen_func.line;

    // Process this concrete function -- it may contain calls to other generics
    return process_func(temp_func, ctx);
}

// --- Walk statements to find calls to generic functions ------------------

pub fn collect_generic_calls_stmt(stmt: Stmt, generics: Vec<GenericFuncEntry>, generic_methods: Vec<GenericMethodEntry>, calls: & mut Vec<GenericCallEntry>, method_calls: & mut Vec<GenericMethodCallEntry>, current_func: Func,) {
    collect_generic_calls_stmt_with_hint(stmt, generics, generic_methods, calls, method_calls, current_func, OptType::None);
}

pub fn collect_generic_calls_stmt_with_hint(stmt: Stmt, generics: Vec<GenericFuncEntry>, generic_methods: Vec<GenericMethodEntry>, calls: & mut Vec<GenericCallEntry>, method_calls: & mut Vec<GenericMethodCallEntry>, current_func: Func, expected_ty: OptType,) {
    match stmt {
        Stmt::Let(name, ty, expr, is_mut, is_persist, annotations, line) => {
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, ty);
        }
        Stmt::LetUninit(name, ty, _annotations, line) => {
        }
        Stmt::LetTuple(names, expr, line) => {
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::Assign(target, op, expr, line) => {
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::IndexAssign(array, index, op, expr, line) => {
            collect_generic_calls_expr_with_hint(index, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::DerefAssign(ptr_expr, op, expr, line) => {
            collect_generic_calls_expr_with_hint(ptr_expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::FieldAssign(object, field, op, expr, line) => {
            collect_generic_calls_expr_with_hint(object, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::Expr(e, line) => {
            collect_generic_calls_expr_with_hint(e, generics, generic_methods, calls, method_calls, current_func, expected_ty);
        }
        Stmt::Return(opt, line) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    collect_generic_calls_expr_with_hint(mn_box_expr_deref(e), generics, generic_methods, calls, method_calls, current_func, OptType::Some(current_func.ret_ty));
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, line) => {
            collect_generic_calls_expr_with_hint(cond, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < then_block.len() {
                collect_generic_calls_stmt_with_hint(then_block.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        collect_generic_calls_stmt_with_hint(eb.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                        j = j + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(cond, body, line) => {
            collect_generic_calls_expr_with_hint(cond, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::For(var_name, iterator, body, line) => {
            collect_generic_calls_expr_with_hint(iterator, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Loop(body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Break(opt, line) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    collect_generic_calls_expr_with_hint(mn_box_expr_deref(e), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::Continue(line) => {
        }
        Stmt::Defer(body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Match(e, arms, line) => {
            collect_generic_calls_expr_with_hint(e, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < arms.len() {
                var j: i64 = 0;
                while j < arms.get(i).body.len() {
                    collect_generic_calls_stmt_with_hint(arms.get(i).body.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        Stmt::Use(path, items, line) => {
        }
        Stmt::Handle(body, handlers, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
            var j: i64 = 0;
            while j < handlers.len() {
                var k: i64 = 0;
                while k < handlers.get(j).body.len() {
                    collect_generic_calls_stmt_with_hint(handlers.get(j).body.get(k), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                    k = k + 1;
                }
                j = j + 1;
            }
        }
        Stmt::Do(effect, op, args, line) => {
            var i: i64 = 0;
            while i < args.len() {
                collect_generic_calls_expr_with_hint(args.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::RegionBlock(name, budget, is_gpu, is_kv_cache, window_size, body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::ComptimeGen(body, line) => {
        }
        Stmt::Sandbox(body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Unsafe(body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Txn(body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::GradBlock(var_name, body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Backward(loss, line) => {
            collect_generic_calls_expr_with_hint(loss, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::Query(components, body, line) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Stmt::Select(cases, default, line) => {
            var i: i64 = 0;
            while i < cases.len() {
                collect_generic_calls_expr_with_hint(cases.get(i).channel, generics, generic_methods, calls, method_calls, current_func, OptType::None);
                var j: i64 = 0;
                while j < cases.get(i).body.len() {
                    collect_generic_calls_stmt_with_hint(cases.get(i).body.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                    j = j + 1;
                }
                i = i + 1;
            }
            match default {
                OptStmts::Some(d) => {
                    var j: i64 = 0;
                    while j < d.len() {
                        collect_generic_calls_stmt_with_hint(d.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                        j = j + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::Parallel(branches, line) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                var si: i64 = 0;
                while si < branch.len() {
                    collect_generic_calls_stmt_with_hint(branch.get(si), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                    si = si + 1;
                }
                bi = bi + 1;
            }
        }
        Stmt::Resume(cont, value, _) => {
            collect_generic_calls_expr_with_hint(cont, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(value, generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Stmt::SpawnScope(body, _) => {
            var si4: i64 = 0;
            while si4 < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(si4), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                si4 = si4 + 1;
            }
        }
        Stmt::CancelScope(_) => {
        }
    }
}

// --- Walk expressions to find calls to generic functions -----------------

pub fn collect_generic_calls_expr_with_hint(expr: Expr, generics: Vec<GenericFuncEntry>, generic_methods: Vec<GenericMethodEntry>, calls: & mut Vec<GenericCallEntry>, method_calls: & mut Vec<GenericMethodCallEntry>, current_func: Func, expected_ty: OptType,) {
    match expr {
        Expr::Call(callee, args) => {
            if generic_funcs_contains(generics, callee) {
                var arg_types: Vec<Type> = Vec::new();
                var i: i64 = 0;
                while i < args.len() {
                    arg_types.push(infer_expr_type_with_hint(args.get(i), current_func, expected_ty));
                    i = i + 1;
                }
                // The expected type follows the arguments: it binds what they
                // leave unbound (see subst_with_result)
                match expected_ty {
                    OptType::Some(h) => {
                        arg_types.push(h);
                    }
                    OptType::None => {
                    }
                }
                calls.push(GenericCallEntry_new(callee, arg_types));
            }
            var i: i64 = 0;
            while i < args.len() {
                collect_generic_calls_expr_with_hint(args.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Binary(op, left, right) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(left), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(right), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Unary(op, inner) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::If(cond, then_block, else_block) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(cond), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < then_block.len() {
                collect_generic_calls_stmt_with_hint(then_block.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        collect_generic_calls_stmt_with_hint(eb.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                        j = j + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Block(stmts) => {
            var i: i64 = 0;
            while i < stmts.len() {
                collect_generic_calls_stmt_with_hint(stmts.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::FieldAccess(inner, field) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::OptionalFieldAccess(inner, field) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::MethodCall(receiver, method, args) => {
            // Unbox receiver once to avoid codegen issues with repeated box_expr_deref
            var recv_expr: Expr = mn_box_expr_deref(receiver);
            // Check if this is a call to a generic method
            var struct_name: OptStr = infer_receiver_struct_name(recv_expr, current_func);
            match struct_name {
                OptStr::Some(sn) => {
                    if generic_methods_contains(generic_methods, sn, method) {
                        var arg_types: Vec<Type> = Vec::new();
                        var i: i64 = 0;
                        while i < args.len() {
                            arg_types.push(infer_expr_type_with_hint(args.get(i), current_func, expected_ty));
                            i = i + 1;
                        }
                        method_calls.push(GenericMethodCallEntry_new(sn, method, arg_types, infer_expr_type(recv_expr, current_func)));
                    }
                }
                OptStr::None => {
                }
            }
            // Always recurse into receiver and args for nested generic calls
            collect_generic_calls_expr_with_hint(recv_expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < args.len() {
                collect_generic_calls_expr_with_hint(args.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Index(array, index) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(array), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(index), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::ArrayLit(elem_type, elements) => {
            var i: i64 = 0;
            while i < elements.len() {
                collect_generic_calls_expr_with_hint(elements.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Range(start, end, inclusive) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(start), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(end), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::StructLit(name, fields, spread) => {
            var i: i64 = 0;
            while i < fields.len() {
                collect_generic_calls_expr_with_hint(fields.get(i).value, generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
            match spread {
                OptBoxExpr::Some(se) => {
                    collect_generic_calls_expr_with_hint(mn_box_expr_deref(se), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Expr::Match(e, arms) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(e), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            var i: i64 = 0;
            while i < arms.len() {
                var j: i64 = 0;
                while j < arms.get(i).body.len() {
                    collect_generic_calls_stmt_with_hint(arms.get(i).body.get(j), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                    j = j + 1;
                }
                i = i + 1;
            }
        }
        Expr::Try(inner) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Coalesce(e, default) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(e), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(default), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::IsCheck(inner, type_name) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::TryBlock(body) => {
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Closure(params, body, ret_ty) => {
            // the closure's own parameters and locals type its calls
            var cf: Func = mono_closure_ctx(current_func, params, body);
            var i: i64 = 0;
            while i < body.len() {
                collect_generic_calls_stmt_with_hint(body.get(i), generics, generic_methods, calls, method_calls, cf, OptType::None);
                i = i + 1;
            }
        }
        Expr::FString(parts) => {
            var i: i64 = 0;
            while i < parts.len() {
                match parts.get(i) {
                    FStringPart::Literal(s) => {
                    }
                    FStringPart::Expr(e) => {
                        collect_generic_calls_expr_with_hint(e, generics, generic_methods, calls, method_calls, current_func, OptType::None);
                    }
                }
                i = i + 1;
            }
        }
        Expr::Cast(inner, target_ty) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Asm(template, operands) => {
            var i: i64 = 0;
            while i < operands.len() {
                collect_generic_calls_expr_with_hint(operands.get(i).expr, generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Ref(inner, is_mut) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Deref(inner) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::StrConcat(left, right) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(left), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(right), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::TupleLit(exprs) => {
            var i: i64 = 0;
            while i < exprs.len() {
                collect_generic_calls_expr_with_hint(exprs.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::EnumLit(enum_name, variant, args) => {
            var i: i64 = 0;
            while i < args.len() {
                collect_generic_calls_expr_with_hint(args.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::Comptime(inner) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::ComptimeBlock(stmts) => {
            var i: i64 = 0;
            while i < stmts.len() {
                collect_generic_calls_stmt_with_hint(stmts.get(i), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                i = i + 1;
            }
        }
        Expr::ComptimeReflect(op, ty) => {
        }
        Expr::PipeForward(left, right) => {
            // `a |> f(b)` calls f(a, b): collected as that call
            var as_call: bool = false;
            match mn_box_expr_deref(right) {
                Expr::Ident(fname) => {
                    if generic_funcs_contains(generics, fname) {
                        var one: Vec<Expr> = Vec::new();
                        one.push(mn_box_expr_deref(left));
                        collect_generic_calls_expr_with_hint(Expr::Call(fname, one), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                        as_call = true;
                    }
                }
                Expr::Call(pcallee, pargs) => {
                    if generic_funcs_contains(generics, pcallee) {
                        var all: Vec<Expr> = Vec::new();
                        all.push(mn_box_expr_deref(left));
                        var ai: i64 = 0;
                        while ai < pargs.len() {
                            all.push(pargs.get(ai));
                            ai = ai + 1;
                        }
                        collect_generic_calls_expr_with_hint(Expr::Call(pcallee, all), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                        as_call = true;
                    }
                }
                _ => {
                }
            }
            if !as_call {
                collect_generic_calls_expr_with_hint(mn_box_expr_deref(left), generics, generic_methods, calls, method_calls, current_func, OptType::None);
                collect_generic_calls_expr_with_hint(mn_box_expr_deref(right), generics, generic_methods, calls, method_calls, current_func, OptType::None);
            }
        }
        Expr::QuantCast(inner, target_ty) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Await(inner) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Spawn(inner) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::Yield(inner) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::NamedArg(name, inner) => {
            collect_generic_calls_expr_with_hint(mn_box_expr_deref(inner), generics, generic_methods, calls, method_calls, current_func, OptType::None);
        }
        Expr::IntLit(n) => {
        }
        Expr::FloatLit(f) => {
        }
        Expr::StringLit(s) => {
        }
        Expr::BoolLit(b) => {
        }
        Expr::Ident(name) => {
        }
    }
}

// --- Infer the struct name from a method call receiver -------------------

pub fn infer_receiver_struct_name(receiver: Expr, func: Func) -> OptStr {
    var ty: Type = infer_expr_type(receiver, func);
    match ty {
        Type::Named(s) => {
            return OptStr::Some(s);
        }
        Type::Generic(name, args) => {
            return OptStr::Some(name);
        }
        Type::Ref(inner, is_mut) => {
            match box_type_deref(inner) {
                Type::Named(s) => {
                    return OptStr::Some(s);
                }
                Type::Generic(name, args) => {
                    return OptStr::Some(name);
                }
                _ => {
                    return OptStr::None;
                }
            }
        }
        _ => {
            return OptStr::None;
        }
    }
    return OptStr::None;
}

// --- Type inference with hint fallback -----------------------------------

pub fn infer_expr_type_with_hint(expr: Expr, func: Func, hint: OptType) -> Type {
    var inferred: Type = infer_expr_type(expr, func);
    // A struct literal, or a variable whose declared type is a struct
    // (`v: Pt` gives Named("Pt"); an unknown `v` gives Named("v")), has its
    // own type: the hint (the call's expected result) is not the
    // argument's. It made `inner_x(v)` with v: Pt, in a function returning
    // i64, call inner_x__i64 while inner_x__Pt was the one named (CE9).
    match expr {
        Expr::StructLit(_, _, _) => {
            return inferred;
        }
        Expr::Ident(vn) => {
            match inferred {
                Type::Named(tn) => {
                    if tn != vn {
                        return inferred;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    // If inference produced a Named type (unknown), try the hint
    match inferred {
        Type::Named(_) => {
            match hint {
                OptType::Some(h) => {
                    return h;
                }
                OptType::None => {
                }
            }
        }
        _ => {
        }
    }
    return inferred;
}

// LG14: the generic structs of the program (`struct Cell<T> { .. }`), so a
// literal of one has its type arguments (mn_struct_lit_type).
// struct name -> 1 + index into g_mono_gstructs
var g_mono_gstruct_at: i64 = 0;
var g_mono_gstructs: Vec<StructDef> = Vec::new();

fn mn_gstructs_setup(program: Program) {
    if g_mono_gstruct_at != 0 {
        HashMap_drop(g_mono_gstruct_at);
    }
    g_mono_gstruct_at = HashMap_new();
    g_mono_gstructs = Vec::new();
    var i: i64 = 0;
    while i < program.structs.len() {
        var s: StructDef = program.structs.get(i);
        // the first struct of a name, as the type checker reads it
        if s.type_params.len() > 0 && HashMap_get(g_mono_gstruct_at, s.name) == 0 {
            g_mono_gstructs.push(s);
            HashMap_insert(g_mono_gstruct_at, s.name, g_mono_gstructs.len());
        }
        i = i + 1;
    }
}

/// Whether `t`, inferred for a field's value, is a type mono knows (a
/// variable's unknown type is Named(<its name>)).
fn mn_lit_arg_known(t: Type, value: Expr) -> bool {
    match t {
        Type::Named(_) => {
            match value {
                Expr::StructLit(_, _, _) => {
                    return true;
                }
                _ => {
                    return false;
                }
            }
        }
        Type::Infer => {
            return false;
        }
        Type::Void => {
            return false;
        }
        _ => {
            return true;
        }
    }
    return false;
}

/// The type of literal `name { fields }`: for a generic struct, with the
/// type each of its parameters takes from a field declared with it
/// (`Cell { v: "hi", k: 3 }` is a `Cell<str>`), so a method call on it, or
/// on a variable it initializes, picks the instance of those types (it
/// picked the i64 one: `b.get()` gave the string's address). A parameter no
/// field shows, or a field whose type is not known here: Named, as before.
fn mn_struct_lit_type(name: str, fields: Vec<FieldInit>, func: Func) -> Type {
    if g_mono_gstruct_at == 0 {
        return Type::Named(name);
    }
    var at: i64 = HashMap_get(g_mono_gstruct_at, name);
    if at == 0 {
        return Type::Named(name);
    }
    var def: StructDef = g_mono_gstructs.get(at - 1);
    var args: Vec<Type> = Vec::new();
    var ti: i64 = 0;
    while ti < def.type_params.len() {
        var tp: str = def.type_params.get(ti);
        var found: bool = false;
        var fi: i64 = 0;
        while fi < def.fields.len() && !found {
            var declared_tp: bool = false;
            match def.fields.get(fi).ty {
                Type::Named(fty) => {
                    declared_tp = fty == tp;
                }
                _ => {
                }
            }
            if declared_tp {
                var li: i64 = 0;
                while li < fields.len() && !found {
                    if fields.get(li).name == def.fields.get(fi).name {
                        var vt: Type = infer_expr_type(fields.get(li).value, func);
                        if mn_lit_arg_known(vt, fields.get(li).value) {
                            args.push(vt);
                            found = true;
                        }
                    }
                    li = li + 1;
                }
            }
            fi = fi + 1;
        }
        if !found {
            return Type::Named(name);
        }
        ti = ti + 1;
    }
    return Type::Generic(name, args);
}

// --- Simple type inference for expressions -------------------------------

pub fn infer_expr_type(expr: Expr, func: Func) -> Type {
    match expr {
        // An integer literal is an i64, as everywhere else in the language
        Expr::IntLit(n) => {
            return Type::I64;
        }
        Expr::FloatLit(f) => {
            return Type::F64;
        }
        Expr::Call(callee, _) => {
            if g_mono_ret_index != 0 {
                var at: i64 = HashMap_get(g_mono_ret_index, callee);
                if at > 0 {
                    return g_mono_ret_types.get(at - 1);
                }
            }
            return Type::I64;
        }
        Expr::BoolLit(b) => {
            return Type::Bool;
        }
        Expr::StringLit(s) => {
            return Type::Str;
        }
        Expr::Ident(name) => {
            // Check function params
            var i: i64 = 0;
            while i < func.params.len() {
                if func.params.get(i).name == name {
                    return func.params.get(i).ty;
                }
                i = i + 1;
            }
            // Check let bindings with explicit type
            i = 0;
            while i < func.body.len() {
                match func.body.get(i) {
                    Stmt::Let(ln, ty, e, is_mut, is_persist, annotations, line) => {
                        match ty {
                            OptType::Some(t) => {
                                if ln == name {
                                    return t;
                                }
                            }
                            OptType::None => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                i = i + 1;
            }
            // Check let bindings without explicit type -- infer from initializer
            i = 0;
            while i < func.body.len() {
                match func.body.get(i) {
                    Stmt::Let(ln, ty, e, is_mut, is_persist, annotations, line) => {
                        match ty {
                            OptType::None => {
                                if ln == name {
                                    return infer_expr_type(e, func);
                                }
                            }
                            OptType::Some(_) => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                i = i + 1;
            }
            return Type::Named(name);
        }
        Expr::Cast(inner, target_ty) => {
            return target_ty;
        }
        Expr::Asm(template, operands) => {
            // If any operand has Out direction, return I64, else Void
            var i: i64 = 0;
            while i < operands.len() {
                match operands.get(i).direction {
                    AsmDir::Out => {
                        return Type::I64;
                    }
                    AsmDir::In => {
                    }
                    _ => {
                    }
                }
                i = i + 1;
            }
            return Type::Void;
        }
        Expr::Binary(op, left, right) => {
            match op {
                BinOp::Eq => {
                    return Type::Bool;
                }
                BinOp::Neq => {
                    return Type::Bool;
                }
                BinOp::Lt => {
                    return Type::Bool;
                }
                BinOp::Gt => {
                    return Type::Bool;
                }
                BinOp::LtEq => {
                    return Type::Bool;
                }
                BinOp::GtEq => {
                    return Type::Bool;
                }
                _ => {
                    var lt: Type = infer_expr_type(mn_box_expr_deref(left), func);
                    var rt: Type = infer_expr_type(mn_box_expr_deref(right), func);
                    // If left is not Named, use it; else use right
                    match lt {
                        Type::Named(_) => {
                            return rt;
                        }
                        _ => {
                            return lt;
                        }
                    }
                }
            }
            return Type::I64;
        }
        Expr::Unary(op, inner) => {
            match op {
                UnaryOp::Not => {
                    return Type::Bool;
                }
                _ => {
                    return infer_expr_type(mn_box_expr_deref(inner), func);
                }
            }
        }
        Expr::StructLit(name, fields, spread) => {
            return mn_struct_lit_type(name, fields, func);
        }
        // `&x` / `&mut x` is a reference to x's type: a parameter `s: &mut
        // T` binds T from it (stdlib-agent-bugs 19: T stayed unbound and the
        // call went to `use_store__T`, which no instance defines)
        Expr::Ref(rinner, rmut) => {
            return Type::Ref(box_type_new(infer_expr_type(mn_box_expr_deref(rinner), func)), rmut);
        }
        Expr::ArrayLit(elem_type, elements) => {
            return Type::Array(elem_type, elements.len());
        }
        Expr::MethodCall(receiver, method, args) => {
            // For associated function calls like Point::new(x, y),
            // the receiver is Expr::Ident("Point"); a variable has its type
            var rt: Type = infer_expr_type(mn_box_expr_deref(receiver), func);
            match rt {
                Type::Generic(gn, gargs) => {
                    if gargs.len() > 0 {
                        // What core's Option/Result/Vec methods return
                        // (proposal 0002): the payload, or the same type
                        if (gn == "Option" || gn == "Result") && (method == "unwrap" || method == "unwrap_or" || method == "expect") {
                            return gargs.get(0);
                        }
                        if (gn == "Option" || gn == "Result") && (method == "map" || method == "map_err" || method == "and_then" || method == "or" || method == "or_else" || method == "filter") {
                            return rt;
                        }
                        if gn == "Vec" && (method == "get" || method == "pop" || method == "first" || method == "last") {
                            return gargs.get(0);
                        }
                    }
                }
                _ => {
                }
            }
            return rt;
        }
        _ => {
            return Type::I64;
        }
    }
    return Type::I64;
}
