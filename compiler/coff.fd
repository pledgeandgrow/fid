// coff.fd -- COFF Object File Emitter for Windows (AMD64)
// Ported from src/coff.rs. Produces COFF relocatable object files (.obj).
//
// Instruction encoding is shared: this file assembles via ElfEmitter
// (compiler::elf64) and translates its (bytes, symbols, relocations) into
// COFF records — it is a format writer only, not a second assembler.
//
// COFF format (AMD64):
//   - COFF header (20 bytes)
//   - Section headers (40 bytes each): .text, optional .rdata
//   - Section data + per-section relocation tables
//   - Symbol table (18 bytes per symbol)
//   - String table

module compiler::coff;

use core;
use vec;
use string;
use compiler::elf64;

// --- Constants ----------------------------------------------------------

pub const IMAGE_FILE_MACHINE_AMD64: i64 = 0x8664;
pub const IMAGE_SCN_CNT_CODE: i64 = 0x00000020;
pub const IMAGE_SCN_CNT_INITIALIZED_DATA: i64 = 0x00000040;
pub const IMAGE_SCN_MEM_EXECUTE: i64 = 0x20000000;
pub const IMAGE_SCN_MEM_READ: i64 = 0x40000000;

pub const IMAGE_SYM_UNDEFINED: i64 = 0;
pub const IMAGE_SYM_TYPE_NULL: i64 = 0;
pub const IMAGE_SYM_CLASS_EXTERNAL: i64 = 2;
pub const IMAGE_SYM_CLASS_STATIC: i64 = 3;
pub const IMAGE_REL_AMD64_ADDR64: i64 = 1;
pub const IMAGE_REL_AMD64_REL32: i64 = 4;

// --- Structs ------------------------------------------------------------

pub struct SymbolEntry {
    pub name: str,
    pub value: i64,
    pub section_number: i64,
    pub sym_type: i64,
    pub storage_class: i64,
    pub number_of_aux_symbols: i64,
}

pub fn SymbolEntry_new(name: str, value: i64, section_number: i64, sym_type: i64, storage_class: i64, number_of_aux_symbols: i64) -> SymbolEntry {
    return SymbolEntry {
        name: name,
        value: value,
        section_number: section_number,
        sym_type: sym_type,
        storage_class: storage_class,
        number_of_aux_symbols: number_of_aux_symbols,
    };
}

pub struct RelocEntry {
    pub virtual_address: i64,
    pub symbol_table_index: i64,
    pub rtype: i64,
    pub section: i64,   // 1 = .text, 2 = .rdata
}

pub fn RelocEntry_new(virtual_address: i64, symbol_table_index: i64, rtype: i64, section: i64) -> RelocEntry {
    return RelocEntry {
        virtual_address: virtual_address,
        symbol_table_index: symbol_table_index,
        rtype: rtype,
        section: section,
    };
}

pub struct CoffEmitter {
    pub text_bytes: Vec<i64>,
    pub rdata_bytes: Vec<i64>,
    pub symbols: Vec<SymbolEntry>,
    pub relocations: Vec<RelocEntry>,
    pub symbol_name_map: Vec<(str, i64)>,
    pub sym_name_to_idx: Vec<str>,
}

pub fn CoffEmitter_new() -> CoffEmitter {
    return CoffEmitter {
        text_bytes: Vec::new(),
        rdata_bytes: Vec::new(),
        symbols: Vec::new(),
        relocations: Vec::new(),
        symbol_name_map: Vec::new(),
        sym_name_to_idx: Vec::new(),
    };
}

// --- Result types ---

pub enum ResultVec { Ok(Vec<i64>), Err(str) }

// --- Helper: emit little-endian ---

fn co_emit_u16(t: &mut Vec, v: i64) { t.push(v & 0xFF); t.push((v >> 8) & 0xFF); }
fn co_emit_u32(t: &mut Vec, v: i64) {
    t.push(v & 0xFF);
    t.push((v >> 8) & 0xFF);
    t.push((v >> 16) & 0xFF);
    t.push((v >> 24) & 0xFF);
}

// --- Helper: symbol index by name ---

fn coff_sym_index(e: &CoffEmitter, name: str) -> i64 {
    var i: i64 = 0;
    while i < e.sym_name_to_idx.len() {
        if e.sym_name_to_idx.get(i) == name { return i; }
        i = i + 1;
    }
    return 0;
}

fn coff_add_symbol(e: &mut CoffEmitter, name: str, value: i64, section_number: i64, storage_class: i64) -> i64 {
    var i: i64 = 0;
    while i < e.sym_name_to_idx.len() {
        if e.sym_name_to_idx.get(i) == name { return i; }
        i = i + 1;
    }
    var idx: i64 = e.symbols.len();
    e.symbols.push(SymbolEntry_new(name, value, section_number, IMAGE_SYM_TYPE_NULL, storage_class, 0));
    e.sym_name_to_idx.push(name);
    return idx;
}

// Translate an ElfEmitter symbol-section number to a COFF section number.
// elf64 uses section 1 for .text; rodata labels live in rodata_symbols.
fn coff_section_of(elf_sec: i64) -> i64 {
    if elf_sec == 1 { return 1; }
    return 2;
}

// Assemble via the shared encoder, then translate results into COFF
// symbols/relocations/section bytes.
pub fn CoffEmitter_import(self: &mut CoffEmitter, em: &ElfEmitter) {
    // Section bytes come straight from the assembler
    var i: i64 = 0;
    while i < em.text.len() {
        self.text_bytes.push(em.text.get(i));
        i = i + 1;
    }
    i = 0;
    while i < em.rodata.len() {
        self.rdata_bytes.push(em.rodata.get(i));
        i = i + 1;
    }

    // Defined + undefined symbols
    i = 0;
    while i < em.symbols.len() {
        var s: Symbol = em.symbols.get(i);
        if s.is_defined {
            var cls: i64 = IMAGE_SYM_CLASS_EXTERNAL;
            if s.binding == 0 { cls = IMAGE_SYM_CLASS_STATIC; }
            coff_add_symbol(self, s.name, s.value, coff_section_of(s.section), cls);
        } else {
            // Skip .rodata labels — they are added below as section-2 symbols
            if coff_rodata_find(em, s.name) < 0 {
                coff_add_symbol(self, s.name, 0, IMAGE_SYM_UNDEFINED, IMAGE_SYM_CLASS_EXTERNAL);
            }
        }
        i = i + 1;
    }
    // .rodata symbols -> COFF section 2
    i = 0;
    while i < em.rodata_symbols.len() {
        var rs: RodataSym = em.rodata_symbols.get(i);
        coff_add_symbol(self, rs.name, rs.offset, 2, IMAGE_SYM_CLASS_STATIC);
        i = i + 1;
    }

    // .text relocations
    i = 0;
    while i < em.relocations.len() {
        var rel: Relocation = em.relocations.get(i);
        var name: str = em.symbols.get(rel.symbol).name;
        var rtype: i64 = IMAGE_REL_AMD64_REL32;
        if rel.rtype == 1 { rtype = IMAGE_REL_AMD64_ADDR64; }
        var idx: i64 = coff_sym_index(self, name);
        self.relocations.push(RelocEntry_new(rel.offset, idx, rtype, 1));
        i = i + 1;
    }
    // .rdata relocations
    i = 0;
    while i < em.rodata_relocations.len() {
        var rrel: Relocation = em.rodata_relocations.get(i);
        var rname: str = em.symbols.get(rrel.symbol).name;
        var rrtype: i64 = IMAGE_REL_AMD64_ADDR64;
        var ridx: i64 = coff_sym_index(self, rname);
        self.relocations.push(RelocEntry_new(rrel.offset, ridx, rrtype, 2));
        i = i + 1;
    }
}

fn coff_rodata_find(em: &ElfEmitter, name: str) -> i64 {
    var i: i64 = 0;
    while i < em.rodata_symbols.len() {
        if em.rodata_symbols.get(i).name == name { return em.rodata_symbols.get(i).offset; }
        i = i + 1;
    }
    return -1;
}

// --- Build COFF object file ---

pub fn CoffEmitter_build_coff(self: &mut CoffEmitter) -> ResultVec {
    var has_rdata: bool = self.rdata_bytes.len() > 0;
    var num_sections: i64 = 1;
    if has_rdata { num_sections = 2; }
    var header_size: i64 = 20;
    var section_header_size: i64 = 40;
    var section_headers_size: i64 = section_header_size * num_sections;

    // .text section data starts after headers
    var text_data_offset: i64 = header_size + section_headers_size;
    var text_data_size: i64 = self.text_bytes.len();

    // .text relocations
    var text_reloc_count: i64 = 0;
    var rdata_reloc_count: i64 = 0;
    var rc: i64 = 0;
    while rc < self.relocations.len() {
        if self.relocations.get(rc).section == 2 { rdata_reloc_count = rdata_reloc_count + 1; }
        else { text_reloc_count = text_reloc_count + 1; }
        rc = rc + 1;
    }

    var text_reloc_offset: i64 = text_data_offset + text_data_size;
    var text_reloc_size: i64 = text_reloc_count * 10;

    // .rdata section (optional)
    var rdata_data_offset: i64 = text_reloc_offset + text_reloc_size;
    var rdata_data_size: i64 = 0;
    var rdata_reloc_offset: i64 = rdata_data_offset;
    var rdata_reloc_size: i64 = 0;
    if has_rdata {
        rdata_data_size = self.rdata_bytes.len();
        rdata_reloc_offset = rdata_data_offset + rdata_data_size;
        rdata_reloc_size = rdata_reloc_count * 10;
    }

    // Symbol table starts after relocations
    var symbol_table_offset: i64 = rdata_reloc_offset + rdata_reloc_size;
    var symbol_table_size: i64 = self.symbols.len() * 18;

    // Build string table (for names > 8 chars)
    var string_table_data: Vec<i64> = Vec::new();
    co_emit_u32(&mut string_table_data, 4); // initial size = 4

    var si: i64 = 0;
    while si < self.symbols.len() {
        var sym: SymbolEntry = self.symbols.get(si);
        if str_len(sym.name) > 8 {
            var offset: i64 = string_table_data.len();
            var ci: i64 = 0;
            while ci < str_len(sym.name) {
                string_table_data.push(str_byte_at(sym.name, ci));
                ci = ci + 1;
            }
            string_table_data.push(0);
            var new_size: i64 = string_table_data.len();
            string_table_data.set(0, new_size & 0xFF);
            string_table_data.set(1, (new_size >> 8) & 0xFF);
            string_table_data.set(2, (new_size >> 16) & 0xFF);
            string_table_data.set(3, (new_size >> 24) & 0xFF);
            self.symbol_name_map.push((sym.name, offset));
        }
        si = si + 1;
    }

    var buf: Vec<i64> = Vec::new();

    // -- COFF Header --
    co_emit_u16(&mut buf, IMAGE_FILE_MACHINE_AMD64);     // Machine
    co_emit_u16(&mut buf, num_sections);                   // NumberOfSections
    co_emit_u32(&mut buf, 0);                              // TimeDateStamp
    co_emit_u32(&mut buf, symbol_table_offset);            // PointerToSymbolTable
    co_emit_u32(&mut buf, self.symbols.len());              // NumberOfSymbols
    co_emit_u16(&mut buf, 0);                              // SizeOfOptionalHeader
    co_emit_u16(&mut buf, 0);                              // Characteristics

    // -- Section Header: .text --
    co_section_name(&mut buf, ".text");
    co_emit_u32(&mut buf, text_data_size);                  // VirtualSize
    co_emit_u32(&mut buf, 0);                               // VirtualAddress
    co_emit_u32(&mut buf, text_data_size);                  // SizeOfRawData
    co_emit_u32(&mut buf, text_data_offset);                // PointerToRawData
    co_emit_u32(&mut buf, text_reloc_offset);               // PointerToRelocations
    co_emit_u32(&mut buf, 0);                               // PointerToLinenumbers
    co_emit_u16(&mut buf, text_reloc_count);                // NumberOfRelocations
    co_emit_u16(&mut buf, 0);                               // NumberOfLinenumbers
    co_emit_u32(&mut buf, IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ);

    // -- Section Header: .rdata --
    if has_rdata {
        co_section_name(&mut buf, ".rdata");
        co_emit_u32(&mut buf, rdata_data_size);
        co_emit_u32(&mut buf, 0);
        co_emit_u32(&mut buf, rdata_data_size);
        co_emit_u32(&mut buf, rdata_data_offset);
        co_emit_u32(&mut buf, rdata_reloc_offset);
        co_emit_u32(&mut buf, 0);
        co_emit_u16(&mut buf, rdata_reloc_count);
        co_emit_u16(&mut buf, 0);
        co_emit_u32(&mut buf, IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ);
    }

    // -- .text section data --
    var ti: i64 = 0;
    while ti < self.text_bytes.len() {
        buf.push(self.text_bytes.get(ti));
        ti = ti + 1;
    }

    // -- .text relocations --
    var ri: i64 = 0;
    while ri < self.relocations.len() {
        var reloc: RelocEntry = self.relocations.get(ri);
        if reloc.section == 1 {
            co_emit_u32(&mut buf, reloc.virtual_address);
            co_emit_u32(&mut buf, reloc.symbol_table_index);
            co_emit_u16(&mut buf, reloc.rtype);
        }
        ri = ri + 1;
    }

    // -- .rdata section data + relocations --
    if has_rdata {
        var rdi: i64 = 0;
        while rdi < self.rdata_bytes.len() {
            buf.push(self.rdata_bytes.get(rdi));
            rdi = rdi + 1;
        }
        var rri: i64 = 0;
        while rri < self.relocations.len() {
            var rreloc: RelocEntry = self.relocations.get(rri);
            if rreloc.section == 2 {
                co_emit_u32(&mut buf, rreloc.virtual_address);
                co_emit_u32(&mut buf, rreloc.symbol_table_index);
                co_emit_u16(&mut buf, rreloc.rtype);
            }
            rri = rri + 1;
        }
    }

    // -- Symbol Table --
    var syi: i64 = 0;
    while syi < self.symbols.len() {
        var s2: SymbolEntry = self.symbols.get(syi);
        if str_len(s2.name) <= 8 {
            var ni: i64 = 0;
            while ni < str_len(s2.name) {
                buf.push(str_byte_at(s2.name, ni));
                ni = ni + 1;
            }
            while ni < 8 {
                buf.push(0);
                ni = ni + 1;
            }
        } else {
            // Long name: 4 bytes of 0 + 4 bytes offset into string table
            var offset: i64 = symbol_name_map_lookup(self.symbol_name_map, s2.name);
            co_emit_u32(&mut buf, 0);
            co_emit_u32(&mut buf, offset);
        }
        co_emit_u32(&mut buf, s2.value);                    // Value
        co_emit_u16(&mut buf, s2.section_number);           // SectionNumber
        co_emit_u16(&mut buf, s2.sym_type);                 // Type
        buf.push(s2.storage_class);                      // StorageClass
        buf.push(s2.number_of_aux_symbols);              // NumberOfAuxSymbols
        syi = syi + 1;
    }

    // -- String Table --
    var sti: i64 = 0;
    while sti < string_table_data.len() {
        buf.push(string_table_data.get(sti));
        sti = sti + 1;
    }

    return ResultVec::Ok(buf);
}

fn co_section_name(buf: &mut Vec, name: str) {
    var i: i64 = 0;
    while i < str_len(name) {
        buf.push(str_byte_at(name, i));
        i = i + 1;
    }
    while i < 8 {
        buf.push(0);
        i = i + 1;
    }
}

fn symbol_name_map_lookup(map: Vec<(str, i64)>, name: str) -> i64 {
    var i: i64 = 0;
    while i < map.len() {
        var entry: (str, i64) = map.get(i);
        var (e0, e1) = entry;
        if e0 == name {
            return e1;
        }
        i = i + 1;
    }
    return 0;
}

// --- Public API ---

pub fn emit_coff_file(module: i64, asm: str) -> ResultVec {
    var em: ElfEmitter = ElfEmitter_new();
    match ElfEmitter_assemble(&mut em, asm) {
        ResultUnit::Ok => {}
        ResultUnit::Err(e) => { return ResultVec::Err(e); }
    }
    var emitter: CoffEmitter = CoffEmitter_new();
    CoffEmitter_import(&mut emitter, &em);
    return CoffEmitter_build_coff(emitter);
}
