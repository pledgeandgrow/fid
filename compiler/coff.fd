// coff.fd -- COFF Object File Emitter for Windows (AMD64)
// Ported from src/coff.rs. Produces COFF relocatable object files (.obj).
//
// Instruction encoding is shared: this file assembles via ElfEmitter
// (compiler::elf64) and translates its (bytes, symbols, relocations) into
// COFF records — it is a format writer only, not a second assembler.
//
// COFF format (AMD64):
//   - COFF header (20 bytes)
//   - Section headers (40 bytes each): .text, optional .rdata
//   - Section data + per-section relocation tables
//   - Symbol table (18 bytes per symbol)
//   - String table

module compiler::coff; use core; use vec; use string; use compiler::elf64; use compiler::image_writer;  // --- Constants ----------------------------------------------------------

pub const IMAGE_FILE_MACHINE_AMD64: i64 = 0x8664; pub const IMAGE_SCN_CNT_CODE: i64 = 0x00000020; pub const IMAGE_SCN_CNT_INITIALIZED_DATA: i64 = 0x00000040; pub const IMAGE_SCN_MEM_EXECUTE: i64 = 0x20000000; pub const IMAGE_SCN_MEM_READ: i64 = 0x40000000; pub const IMAGE_SYM_UNDEFINED: i64 = 0; pub const IMAGE_SYM_TYPE_NULL: i64 = 0; pub const IMAGE_SYM_CLASS_EXTERNAL: i64 = 2; pub const IMAGE_SYM_CLASS_STATIC: i64 = 3; pub const IMAGE_REL_AMD64_ADDR64: i64 = 1; pub const IMAGE_REL_AMD64_REL32: i64 = 4;  // --- Structs ------------------------------------------------------------

pub struct SymbolEntry {
    pub name: str,
    pub value: i64,
    pub section_number: i64,
    pub sym_type: i64,
    pub storage_class: i64,
    pub number_of_aux_symbols: i64,
}

pub fn SymbolEntry_new(name: str, value: i64, section_number: i64, sym_type: i64, storage_class: i64, number_of_aux_symbols: i64) -> SymbolEntry {
    return SymbolEntry {
        name: name, value: value, section_number: section_number, sym_type: sym_type, storage_class: storage_class, number_of_aux_symbols: number_of_aux_symbols,
    };
}

pub struct RelocEntry {
    pub virtual_address: i64,
    pub symbol_table_index: i64,
    pub rtype: i64,
    pub section: i64,  // 1 = .text, 2 = .rdata
}

pub fn RelocEntry_new(virtual_address: i64, symbol_table_index: i64, rtype: i64, section: i64) -> RelocEntry {
    return RelocEntry {
        virtual_address: virtual_address, symbol_table_index: symbol_table_index, rtype: rtype, section: section,
    };
}

pub struct CoffEmitter {
    pub text_bytes: Vec<i64>,
    pub rdata_bytes: Vec<i64>,
    pub symbols: Vec<SymbolEntry>,
    pub relocations: Vec<RelocEntry>,
    pub symbol_name_map: Vec<(str, i64)>,
    pub sym_name_to_idx: Vec<str>,
}

pub fn CoffEmitter_new() -> CoffEmitter {
    return CoffEmitter {
        text_bytes: Vec::new(), rdata_bytes: Vec::new(), symbols: Vec::new(), relocations: Vec::new(), symbol_name_map: Vec::new(), sym_name_to_idx: Vec::new(),
    };
}

// --- Result types ---

pub enum ResultVec {
    Ok(Vec<i64>),
    Err(str)
}

// --- Helper: emit little-endian ---

fn co_emit_u16(t: & mut Vec, v: i64) {
    t.push(v & 0xFF);
    t.push((v >> 8) & 0xFF);
}

fn co_emit_u32(t: & mut Vec, v: i64) {
    t.push(v & 0xFF);
    t.push((v >> 8) & 0xFF);
    t.push((v >> 16) & 0xFF);
    t.push((v >> 24) & 0xFF);
}

// --- Helper: symbol index by name ---

fn coff_sym_index(e: & CoffEmitter, name: str) -> i64 {
    var i: i64 = 0;
    while i < e.sym_name_to_idx.len() {
        if e.sym_name_to_idx.get(i) == name {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

fn coff_add_symbol(e: & mut CoffEmitter, name: str, value: i64, section_number: i64, storage_class: i64) -> i64 {
    var i: i64 = 0;
    while i < e.sym_name_to_idx.len() {
        if e.sym_name_to_idx.get(i) == name {
            return i;
        }
        i = i + 1;
    }
    var idx: i64 = e.symbols.len();
    e.symbols.push(SymbolEntry_new(name, value, section_number, IMAGE_SYM_TYPE_NULL, storage_class, 0));
    e.sym_name_to_idx.push(name);
    return idx;
}

// Translate an ElfEmitter symbol-section number to a COFF section number.
// elf64 uses section 1 for .text; rodata labels live in rodata_symbols.
fn coff_section_of(elf_sec: i64) -> i64 {
    if elf_sec == 1 {
        return 1;
    }
    return 2;
}

// Assemble via the shared encoder, then translate results into COFF
// symbols/relocations/section bytes.
pub fn CoffEmitter_import(self: & mut CoffEmitter, em: & ElfEmitter) {
    // Section bytes come straight from the assembler
    var i: i64 = 0;
    while i < em.text.len() {
        self.text_bytes.push(em.text.get(i));
        i = i + 1;
    }
    i = 0;
    while i < em.rodata.len() {
        self.rdata_bytes.push(em.rodata.get(i));
        i = i + 1;
    }

    // Defined + undefined symbols
    i = 0;
    while i < em.symbols.len() {
        var s: Symbol = em.symbols.get(i);
        if s.is_defined {
            var cls: i64 = IMAGE_SYM_CLASS_EXTERNAL;
            if s.binding == 0 {
                cls = IMAGE_SYM_CLASS_STATIC;
            }
            coff_add_symbol(self, s.name, s.value, coff_section_of(s.section), cls);
        } else {
            // Skip .rodata labels — they are added below as section-2 symbols
            if coff_rodata_find(em, s.name) < 0 {
                coff_add_symbol(self, s.name, 0, IMAGE_SYM_UNDEFINED, IMAGE_SYM_CLASS_EXTERNAL);
            }
        }
        i = i + 1;
    }
    // .rodata symbols -> COFF section 2
    i = 0;
    while i < em.rodata_symbols.len() {
        var rs: RodataSym = em.rodata_symbols.get(i);
        coff_add_symbol(self, rs.name, rs.offset, 2, IMAGE_SYM_CLASS_STATIC);
        i = i + 1;
    }

    // .text relocations
    i = 0;
    while i < em.relocations.len() {
        var rel: Relocation = em.relocations.get(i);
        var name: str = em.symbols.get(rel.symbol).name;
        var rtype: i64 = IMAGE_REL_AMD64_REL32;
        if rel.rtype == 1 {
            rtype = IMAGE_REL_AMD64_ADDR64;
        }
        var idx: i64 = coff_sym_index(self, name);
        self.relocations.push(RelocEntry_new(rel.offset, idx, rtype, 1));
        i = i + 1;
    }
    // .rdata relocations
    i = 0;
    while i < em.rodata_relocations.len() {
        var rrel: Relocation = em.rodata_relocations.get(i);
        var rname: str = em.symbols.get(rrel.symbol).name;
        var rrtype: i64 = IMAGE_REL_AMD64_ADDR64;
        var ridx: i64 = coff_sym_index(self, rname);
        self.relocations.push(RelocEntry_new(rrel.offset, ridx, rrtype, 2));
        i = i + 1;
    }
}

fn coff_rodata_find(em: & ElfEmitter, name: str) -> i64 {
    var i: i64 = 0;
    while i < em.rodata_symbols.len() {
        if em.rodata_symbols.get(i).name == name {
            return em.rodata_symbols.get(i).offset;
        }
        i = i + 1;
    }
    return - 1;
}

// --- Build COFF object file ---

pub fn CoffEmitter_build_coff(self: & mut CoffEmitter) -> ResultVec {
    // TG13: the records come from compiler/image_writer.fd (the old body,
    // checked byte for byte against this one on Nov 17, is gone:
    // docs/image-writer.md)
    return CoffEmitter_build_coff_img(self);
}

/// TG13: CoffEmitter_build_coff as a layout over image_writer (the same
/// bytes as the old body): the 20-byte COFF header (AMD64, no optional header), the
/// section headers of .text and, when there is any, .rdata; then each
/// section's data followed by its relocations (10 bytes each); then the
/// symbol table (18 bytes per symbol, no aux records, Type 0) and the
/// string table of the names longer than 8 bytes.
pub fn CoffEmitter_build_coff_img(self: & mut CoffEmitter) -> ResultVec {
    var has_rdata: bool = self.rdata_bytes.len() > 0;
    var nsect: i64 = 1;
    if has_rdata {
        nsect = 2;
    }
    // The relocation tables, .text's (section 1) and .rdata's (section 2)
    var text_rel: Vec<i64> = Vec::new();
    var rdata_rel: Vec<i64> = Vec::new();
    var ntext: i64 = 0;
    var nrdata: i64 = 0;
    var r: i64 = 0;
    while r < self.relocations.len() {
        var rel: RelocEntry = self.relocations.get(r);
        if rel.section == 2 {
            img_coff_reloc(& mut rdata_rel, rel.virtual_address, rel.symbol_table_index, rel.rtype);
            nrdata = nrdata + 1;
        } else {
            img_coff_reloc(& mut text_rel, rel.virtual_address, rel.symbol_table_index, rel.rtype);
            ntext = ntext + 1;
        }
        r = r + 1;
    }
    if !has_rdata {
        // no .rdata section to hold them (the old body left them out too)
        rdata_rel = Vec::new();
        nrdata = 0;
    }
    var text_off: i64 = 20 + 40 * nsect;
    var text_rel_off: i64 = text_off + self.text_bytes.len();
    var rdata_off: i64 = text_rel_off + text_rel.len();
    var rdata_rel_off: i64 = rdata_off + self.rdata_bytes.len();
    var sym_off: i64 = rdata_rel_off + rdata_rel.len();
    // The symbols: STATIC (3) ones local, EXTERNAL (2) ones global
    var syms: Vec<ImgSym> = Vec::new();
    var si: i64 = 0;
    while si < self.symbols.len() {
        var s: SymbolEntry = self.symbols.get(si);
        var bind: i64 = IMG_GLOBAL;
        if s.storage_class == IMAGE_SYM_CLASS_STATIC {
            bind = IMG_LOCAL;
        }
        syms.push(img_sym(s.name, s.value, 0, s.section_number, IMG_SYM_NONE, bind));
        si = si + 1;
    }
    var buf: Vec<i64> = Vec::new();
    img_coff_header(& mut buf, IMAGE_FILE_MACHINE_AMD64, nsect, sym_off, syms.len(), 0, 0);
    img_coff_section(& mut buf, ".text", self.text_bytes.len(), 0, self.text_bytes.len(), text_off, text_rel_off, ntext, IMAGE_SCN_CNT_CODE | IMAGE_SCN_MEM_EXECUTE | IMAGE_SCN_MEM_READ);
    if has_rdata {
        img_coff_section(& mut buf, ".rdata", self.rdata_bytes.len(), 0, self.rdata_bytes.len(), rdata_off, rdata_rel_off, nrdata, IMAGE_SCN_CNT_INITIALIZED_DATA | IMAGE_SCN_MEM_READ);
    }
    img_append(& mut buf, & self.text_bytes);
    img_append(& mut buf, & text_rel);
    if has_rdata {
        img_append(& mut buf, & self.rdata_bytes);
        img_append(& mut buf, & rdata_rel);
    }
    // The symbol and string tables; they set PointerToSymbolTable and
    // NumberOfSymbols again (to the same values)
    var pre: Vec<str> = Vec::new();
    img_coff_symbols(& mut buf, & pre, & syms, IMG_COFF_SYMPTR_AT, IMG_COFF_NSYMS_AT);
    return ResultVec::Ok(buf);
}

fn co_section_name(buf: & mut Vec, name: str) {
    var i: i64 = 0;
    while i < str_len(name) {
        buf.push(str_byte_at(name, i));
        i = i + 1;
    } while i < 8 {
        buf.push(0);
        i = i + 1;
    }
}

// --- Public API ---

pub fn emit_coff_file(module: i64, asm: str) -> ResultVec {
    var em: ElfEmitter = ElfEmitter_new();
    match ElfEmitter_assemble(& mut em, asm) {
        ResultUnit::Ok => {
        }
        ResultUnit::Err(e) => {
            return ResultVec::Err(e);
        }
    }
    var emitter: CoffEmitter = CoffEmitter_new();
    CoffEmitter_import(& mut emitter, & em);
    return CoffEmitter_build_coff(emitter);
}
