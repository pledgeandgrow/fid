// nat_enc.fd -- machine code for the native Linux AArch64 and RISC-V 64
// backends (release F8): a code buffer with labels and fixups, the
// instruction encoders of both architectures, and a static ELF writer.
//
// The code generator (compiler/nat_ir.fd) emits whole 32-bit instruction
// words; a word whose target is a label not yet placed is recorded as a
// fixup and patched in NatEnc_resolve once every label is known. Code and
// data share one image, mapped read/write/execute at a fixed address
// (NAT_IMAGE_BASE), so every reference is PC-relative or absolute within it.

module compiler::nat_enc; use core; use vec; use string; use compiler::pgo; use compiler::image_writer; use compiler::pdb; pub const NAT_A64: i64 = 1; pub const NAT_RV64: i64 = 2;  /// Where the image (code, then data) is mapped: file offset 0x1000 holds
/// it, the ELF header is in front, one segment maps the file at 0x400000.
pub const NAT_IMAGE_BASE: i64 = 0x401000;  /// The address NATFIX_ABS64 adds to an image offset: NAT_IMAGE_BASE for
/// ELF and PE; the Mach-O writer (F7) sets the unslid address of its image
/// (NAT_MACHO_IMAGE) and dyld rebases each such word by the slide.
pub var g_nat_abs_base: i64 = 0x401000;  // Fixup kinds
pub const NATFIX_A64_B26: i64 = 1;  // B, BL: imm26 words
pub const NATFIX_A64_B19: i64 = 2;  // B.cond, CBZ, CBNZ: imm19 at bit 5
pub const NATFIX_A64_ADRP_ADD: i64 = 3;  // ADRP + ADD lo12: the label's address
pub const NATFIX_RV_JAL: i64 = 4;  // JAL: J-type imm20
pub const NATFIX_RV_AUIPC_I: i64 = 5;  // AUIPC + I-type (ADDI, JALR): pc-relative
pub const NATFIX_ABS64: i64 = 6;  // 8 data bytes: the label's absolute address
// TG6 (branch relaxation): the short forms nat_ir picks when the target is
// known to be in reach. A target found out of reach is a build error, never
// a wrong jump.
pub const NATFIX_X64_REL8: i64 = 9;  // 1 byte: rel8 from the end of that byte
pub const NATFIX_RV_B12: i64 = 10;  // B-type word: imm[12:1], -4096..4094
// TG8: AArch64 TBZ / TBNZ straight to the label: imm14 words at bit 5,
// -32768..32764 bytes (nat_ir picks it only when relaxation found the
// target in reach; else TBZ-inverse over B)
pub const NATFIX_A64_B14: i64 = 21;
// MI27: a jump-table entry, 4 data bytes: the label's offset from the
// entry itself (target - pos, signed 32 bits). Position-independent: no
// relocation in a PIE, a PE, a Mach-O image or an object file.
pub const NATFIX_SELF32: i64 = 22;

pub struct NatFix {
    pub pos: i64,
    pub label: i64,
    pub kind: i64,
}

/// The image being built: bytes, label offsets (-1 = not placed yet; label
/// 0 is never used, so a HashMap miss of 0 is never a label) and fixups.
pub struct NatEnc {
    pub code: Vec<i64>,
    pub labels: Vec<i64>,
    pub fixups: Vec<NatFix>,
    // MI3: where the last label was placed and where the last AArch64 MUL
    // that nat_ir's ng_mul emitted ends (-1: none), so ng_a64_mac can fuse
    // that MUL with the ADD/SUB right after it into one MADD/MSUB
    pub last_place: i64,
    pub mul_end: i64,
}

pub fn NatEnc_new() -> NatEnc {
    var labels: Vec<i64> = Vec::new();
    labels.push(- 1);
    return NatEnc {
        code: Vec::new(), labels: labels, fixups: Vec::new(), last_place: 0 - 1, mul_end: 0 - 1
    };
}

pub fn NatEnc_pos(e: & NatEnc) -> i64 {
    return e.code.len();
}

pub fn NatEnc_label(e: & mut NatEnc) -> i64 {
    e.labels.push(- 1);
    return e.labels.len() - 1;
}

pub fn NatEnc_place(e: & mut NatEnc, label: i64) {
    e.labels.set(label, e.code.len());
    e.last_place = e.code.len();
}

pub fn NatEnc_byte(e: & mut NatEnc, b: i64) {
    e.code.push(b & 0xFF);
}

pub fn NatEnc_word(e: & mut NatEnc, w: i64) {
    e.code.push(w & 0xFF);
    e.code.push((w >> 8) & 0xFF);
    e.code.push((w >> 16) & 0xFF);
    e.code.push((w >> 24) & 0xFF);
}

pub fn NatEnc_quad(e: & mut NatEnc, v: i64) {
    var i: i64 = 0;
    while i < 8 {
        e.code.push((v >> (i * 8)) & 0xFF);
        i = i + 1;
    }
}

pub fn NatEnc_align(e: & mut NatEnc, n: i64) {
    while e.code.len() % n != 0 {
        e.code.push(0);
    }
}

/// Record that the word(s) at the current position refer to `label`.
pub fn NatEnc_fix(e: & mut NatEnc, label: i64, kind: i64) {
    e.fixups.push(NatFix {
        pos: e.code.len(), label: label, kind: kind
    });
}

/// Record that the word(s) at `pos` refer to `label` — the CS6 function
/// cache replays fixups whose patch site is not the current position.
pub fn NatEnc_fix_at(e: & mut NatEnc, pos: i64, label: i64, kind: i64) {
    e.fixups.push(NatFix {
        pos: pos, label: label, kind: kind
    });
}

fn nat_read32(e: & NatEnc, pos: i64) -> i64 {
    return e.code.get(pos) | (e.code.get(pos + 1) << 8) | (e.code.get(pos + 2) << 16) | (e.code.get(pos + 3) << 24);
}

fn nat_write32(e: & mut NatEnc, pos: i64, w: i64) {
    e.code.set(pos, w & 0xFF);
    e.code.set(pos + 1, (w >> 8) & 0xFF);
    e.code.set(pos + 2, (w >> 16) & 0xFF);
    e.code.set(pos + 3, (w >> 24) & 0xFF);
}

fn nat_or32(e: & mut NatEnc, pos: i64, bits: i64) {
    nat_write32(e, pos, nat_read32(e, pos) | (bits & 0xFFFFFFFF));
}

/// Patch every fixup. Returns "" or the first error (a label never placed,
/// or a target out of an instruction's range).
@wrapping pub fn NatEnc_resolve(e: & mut NatEnc) -> str {
    var i: i64 = 0;
    while i < e.fixups.len() {
        var f: NatFix = e.fixups.get(i);
        var target: i64 = e.labels.get(f.label);
        if target < 0 {
            return "native backend: a label was never placed (fixup " + int_to_str(i) + ")";
        }
        var delta: i64 = target - f.pos;
        if f.kind == NATFIX_A64_B26 {
            if delta < 0 - 134217728 || delta >= 134217728 {
                return "native backend: branch out of range";
            }
            nat_or32(e, f.pos, (delta >> 2) & 0x3FFFFFF);
        } else if f.kind == NATFIX_A64_B19 {
            if delta < 0 - 1048576 || delta >= 1048576 {
                return "native backend: conditional branch out of range";
            }
            nat_or32(e, f.pos, ((delta >> 2) & 0x7FFFF) << 5);
        } else if f.kind == NATFIX_A64_ADRP_ADD {
            // The image base is page-aligned: pages follow from offsets
            var pd: i64 = ((target >> 12) - (f.pos >> 12));
            nat_or32(e, f.pos, ((pd & 3) << 29) | (((pd >> 2) & 0x7FFFF) << 5));
            nat_or32(e, f.pos + 4, (target & 0xFFF) << 10);
        } else if f.kind == NATFIX_RV_JAL {
            if delta < 0 - 1048576 || delta >= 1048576 {
                return "native backend: jump out of range";
            }
            var j: i64 = (((delta >> 20) & 1) << 31) | (((delta >> 1) & 0x3FF) << 21) | (((delta >> 11) & 1) << 20) | (((delta >> 12) & 0xFF) << 12);
            nat_or32(e, f.pos, j);
        } else if f.kind == NATFIX_RV_AUIPC_I {
            var hi: i64 = (delta + 0x800) >> 12;
            var lo: i64 = delta - (hi << 12);
            nat_or32(e, f.pos, (hi & 0xFFFFF) << 12);
            nat_or32(e, f.pos + 4, (lo & 0xFFF) << 20);
        } else if f.kind == NATFIX_X64_REL32 {
            // relative to the end of the 4-byte field
            var rel: i64 = target - (f.pos + 4);
            var kk: i64 = 0;
            while kk < 4 {
                e.code.set(f.pos + kk, (rel >> (kk * 8)) & 0xFF);
                kk = kk + 1;
            }
        } else if f.kind == NATFIX_RVA32 {
            // a PE relative virtual address: the image sits at RVA 0x1000
            var rva: i64 = 0x1000 + target;
            var kr: i64 = 0;
            while kr < 4 {
                e.code.set(f.pos + kr, (rva >> (kr * 8)) & 0xFF);
                kr = kr + 1;
            }
        } else if f.kind == NATFIX_X64_REL8 {
            // TG6: x86-64 short jmp/jcc, relative to the end of the byte
            var rel8: i64 = target - (f.pos + 1);
            if rel8 < 0 - 128 || rel8 > 127 {
                return "native backend: short branch out of range (branch relaxation)";
            }
            e.code.set(f.pos, rel8 & 0xFF);
        } else if f.kind == NATFIX_RV_B12 {
            // TG6: RISC-V conditional branch straight to the label
            if delta < 0 - 4096 || delta > 4094 {
                return "native backend: short conditional branch out of range (branch relaxation)";
            }
            var bw: i64 = (((delta >> 12) & 1) << 31) | (((delta >> 5) & 0x3F) << 25) | (((delta >> 1) & 0xF) << 8) | (((delta >> 11) & 1) << 7);
            nat_or32(e, f.pos, bw);
        } else if f.kind == NATFIX_A64_B14 {
            // TG8: TBZ / TBNZ straight to the label
            if delta < 0 - 32768 || delta > 32764 {
                return "native backend: short test-bit branch out of range (branch relaxation)";
            }
            nat_or32(e, f.pos, ((delta >> 2) & 0x3FFF) << 5);
        } else if f.kind == NATFIX_SELF32 {
            // MI27: a jump-table entry, relative to itself
            if delta < 0 - 2147483648 || delta > 2147483647 {
                return "native backend: jump-table target out of range";
            }
            nat_write32(e, f.pos, delta & 0xFFFFFFFF);
        } else if f.kind == NATFIX_ABS64 {
            var abs: i64 = g_nat_abs_base + target;
            var k: i64 = 0;
            while k < 8 {
                e.code.set(f.pos + k, (abs >> (k * 8)) & 0xFF);
                k = k + 1;
            }
        }
        i = i + 1;
    }
    return "";
}

// ===========================================================================
// AArch64 (A64) encodings. Registers: 0..30 = x0..x30; 31 = xzr or sp,
// by instruction. Floating point: 0..31 = d0..d31 (s0..s31 for f32).
// ===========================================================================

pub const A64_SP: i64 = 31; pub const A64_ZR: i64 = 31; pub const A64_FP: i64 = 29; pub const A64_LR: i64 = 30;  // Condition codes
pub const A64_EQ: i64 = 0; pub const A64_NE: i64 = 1; pub const A64_HS: i64 = 2; pub const A64_LO: i64 = 3; pub const A64_MI: i64 = 4; pub const A64_VS: i64 = 6; pub const A64_HI: i64 = 8; pub const A64_LS: i64 = 9; pub const A64_GE: i64 = 10; pub const A64_LT: i64 = 11; pub const A64_GT: i64 = 12; pub const A64_LE: i64 = 13;  /// Three-register data processing: base | m << 16 | n << 5 | d.
pub fn a64_rrr(e: & mut NatEnc, base: i64, d: i64, n: i64, m: i64) {
    NatEnc_word(e, base | (m << 16) | (n << 5) | d);
}

pub fn a64_add(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x8B000000, d, n, m);
}
pub fn a64_adds(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0xAB000000, d, n, m);
}
pub fn a64_sub(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0xCB000000, d, n, m);
}
pub fn a64_subs(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0xEB000000, d, n, m);
}
pub fn a64_and(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x8A000000, d, n, m);
}
pub fn a64_orr(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0xAA000000, d, n, m);
}
pub fn a64_eor(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0xCA000000, d, n, m);
}
pub fn a64_mul(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x9B007C00, d, n, m);
}
pub fn a64_smulh(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x9B407C00, d, n, m);
}
pub fn a64_umulh(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x9BC07C00, d, n, m);
}
pub fn a64_sdiv(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x9AC00C00, d, n, m);
}
pub fn a64_udiv(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x9AC00800, d, n, m);
}
pub fn a64_lslv(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x9AC02000, d, n, m);
}
pub fn a64_lsrv(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x9AC02400, d, n, m);
}
pub fn a64_asrv(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x9AC02800, d, n, m);
}

/// d = a - n * m
pub fn a64_msub(e: & mut NatEnc, d: i64, n: i64, m: i64, a: i64) {
    NatEnc_word(e, 0x9B008000 | (m << 16) | (a << 10) | (n << 5) | d);
}

/// MI3/TG8: d = a + n * m (MADD; MUL is MADD with a = xzr)
pub fn a64_madd(e: & mut NatEnc, d: i64, n: i64, m: i64, a: i64) {
    NatEnc_word(e, 0x9B000000 | (m << 16) | (a << 10) | (n << 5) | d);
}

/// RA11: a parallel move as a sequence of single moves. dst[i] <- src[i]
/// all at once: every destination takes what its source held before any
/// of them is written. Locations are plain numbers (registers, or slots
/// numbered apart from them by the caller); the destinations are
/// distinct. Returns [d0, s0, d1, s1, ...], to run in order. A move whose
/// destination no other pending move still reads goes first; when none is
/// left, what remains are disjoint cycles (each location read once), and
/// one is broken by saving one destination's value in `scratch` (a
/// location neither list names) and reading it from there: the cycle then
/// unwinds to its end before another is broken, so one scratch serves
/// them all. A move to its own source is dropped. Empty when a
/// destination repeats or the lists differ in length (no such move
/// exists), or scratch is named by either list. Its user: the moves of
/// live-range splitting (RA4, nat_ir.fd ng_ls_emit), one parallel move per
/// phase at each place (a block edge, a jump, an edge block).
pub fn nat_par_moves(dst: & Vec<i64>, src: & Vec<i64>, scratch: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var n: i64 = dst.len();
    if src.len() != n {
        return out;
    }
    var pd: Vec<i64> = Vec::new();
    var ps: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var j: i64 = 0;
        while j < i {
            if dst.get(j) == dst.get(i) {
                return Vec::new();
            }
            j = j + 1;
        }
        if dst.get(i) == scratch || src.get(i) == scratch {
            return Vec::new();
        }
        if dst.get(i) != src.get(i) {
            pd.push(dst.get(i));
            ps.push(src.get(i));
        }
        i = i + 1;
    }
    var done: Vec<i64> = Vec::new();
    i = 0;
    while i < pd.len() {
        done.push(0);
        i = i + 1;
    }
    var left: i64 = pd.len();
    while left > 0 {
        // a move whose destination no pending move reads
        var pick: i64 = 0 - 1;
        i = 0;
        while i < pd.len() && pick < 0 {
            if done.get(i) == 0 {
                var read: bool = false;
                var j2: i64 = 0;
                while j2 < pd.len() && !read {
                    if done.get(j2) == 0 && j2 != i && ps.get(j2) == pd.get(i) {
                        read = true;
                    }
                    j2 = j2 + 1;
                }
                if !read {
                    pick = i;
                }
            }
            i = i + 1;
        }
        if pick >= 0 {
            out.push(pd.get(pick));
            out.push(ps.get(pick));
            done.set(pick, 1);
            left = left - 1;
        } else {
            // only cycles: the first pending destination goes to scratch,
            // its reader reads it there
            var c: i64 = 0;
            while done.get(c) != 0 {
                c = c + 1;
            }
            var d: i64 = pd.get(c);
            out.push(scratch);
            out.push(d);
            i = 0;
            while i < pd.len() {
                if done.get(i) == 0 && ps.get(i) == d {
                    ps.set(i, scratch);
                }
                i = i + 1;
            }
        }
    }
    return out;
}

/// MI3: d = n & ~m (BIC, shifted register, no shift)
pub fn a64_bic(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x8A200000, d, n, m);
}

/// ADD d, n, #imm (0..4095); n and d may be sp.
pub fn a64_add_imm(e: & mut NatEnc, d: i64, n: i64, imm: i64) {
    NatEnc_word(e, 0x91000000 | ((imm & 0xFFF) << 10) | (n << 5) | d);
}

pub fn a64_sub_imm(e: & mut NatEnc, d: i64, n: i64, imm: i64) {
    NatEnc_word(e, 0xD1000000 | ((imm & 0xFFF) << 10) | (n << 5) | d);
}

/// ADD d, n, m, UXTX: n and d may be sp (the extended-register form).
pub fn a64_add_ext(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    NatEnc_word(e, 0x8B206000 | (m << 16) | (n << 5) | d);
}

/// RL6: d = n + m for an address whose base n may be sp (31): ADD
/// (extended register) reads sp there, ADD (shifted register) xzr. The
/// same word as a64_add for every other base.
pub fn a64_add_base(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    if n == A64_SP {
        a64_add_ext(e, d, n, m);
    } else {
        a64_add(e, d, n, m);
    }
}

pub fn a64_sub_ext(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    NatEnc_word(e, 0xCB206000 | (m << 16) | (n << 5) | d);
}

/// SUB d, n, #imm, LSL #12 (imm 0..4095: d = n - imm * 4096); n and d may
/// be sp. The stack probes of large frames (MI29) step sp by #1, LSL #12.
pub fn a64_sub_imm_lsl12(e: & mut NatEnc, d: i64, n: i64, imm: i64) {
    NatEnc_word(e, 0xD1400000 | ((imm & 0xFFF) << 10) | (n << 5) | d);
}

/// ADD d, n, m, LSL #sh (the shifted-register form: register 31 is xzr,
/// not sp). d = n + (m << sh), one instruction for an element address
/// (MI22).
pub fn a64_add_lsl(e: & mut NatEnc, d: i64, n: i64, m: i64, sh: i64) {
    NatEnc_word(e, 0x8B000000 | (m << 16) | ((sh & 63) << 10) | (n << 5) | d);
}

/// MOV d, m (ORR d, xzr, m): not for sp.
pub fn a64_mov(e: & mut NatEnc, d: i64, m: i64) {
    if d == m {
        return;
    }
    a64_rrr(e, 0xAA000000, d, A64_ZR, m);
}

pub fn a64_mvn(e: & mut NatEnc, d: i64, m: i64) {
    a64_rrr(e, 0xAA200000, d, A64_ZR, m);
}
pub fn a64_neg(e: & mut NatEnc, d: i64, m: i64) {
    a64_rrr(e, 0xCB000000, d, A64_ZR, m);
}
pub fn a64_negs(e: & mut NatEnc, d: i64, m: i64) {
    a64_rrr(e, 0xEB000000, d, A64_ZR, m);
}
pub fn a64_cmp(e: & mut NatEnc, n: i64, m: i64) {
    a64_rrr(e, 0xEB000000, A64_ZR, n, m);
}

/// CMP n, m, ASR #63 (SUBS xzr, n, m, ASR #63): the high half of a signed
/// product against the sign of its low half.
pub fn a64_cmp_asr63(e: & mut NatEnc, n: i64, m: i64) {
    NatEnc_word(e, 0xEB800000 | (m << 16) | (63 << 10) | (n << 5) | A64_ZR);
}

/// CSET d, cond (CSINC d, xzr, xzr, !cond)
pub fn a64_cset(e: & mut NatEnc, d: i64, cond: i64) {
    NatEnc_word(e, 0x9A9F07E0 | ((cond ^ 1) << 12) | d);
}

/// MI24: CSEL d, n, m, cond (64-bit): d = cond ? n : m.
/// `csel x0, x1, x2, ne` = 0x9A821020.
pub fn a64_csel(e: & mut NatEnc, d: i64, n: i64, m: i64, cond: i64) {
    NatEnc_word(e, 0x9A800000 | ((m & 31) << 16) | ((cond & 15) << 12) | ((n & 31) << 5) | (d & 31));
}

// Sign and zero extension (SBFM / UBFM)
pub fn a64_sxtb(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x93401C00 | (n << 5) | d);
}
pub fn a64_sxth(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x93403C00 | (n << 5) | d);
}
pub fn a64_sxtw(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x93407C00 | (n << 5) | d);
}
pub fn a64_uxtb(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0xD3401C00 | (n << 5) | d);
}
pub fn a64_uxth(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0xD3403C00 | (n << 5) | d);
}
pub fn a64_uxtw(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0xD3407C00 | (n << 5) | d);
}

/// d = n >> 63 (arithmetic): 0 or -1
pub fn a64_asr63(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x937FFC00 | (n << 5) | d);
}

/// Any 64-bit constant: MOVZ (or MOVN) and MOVKs.
@wrapping pub fn a64_li(e: & mut NatEnc, d: i64, v: i64) {
    // Count the 16-bit pieces that differ from 0 and from 0xFFFF
    var zeros: i64 = 0;
    var ones: i64 = 0;
    var k: i64 = 0;
    while k < 4 {
        var h: i64 = (v >> (k * 16)) & 0xFFFF;
        if h == 0 {
            zeros = zeros + 1;
        }
        if h == 0xFFFF {
            ones = ones + 1;
        }
        k = k + 1;
    }
    var inverted: bool = ones > zeros;
    var first: bool = true;
    k = 0;
    while k < 4 {
        var h2: i64 = (v >> (k * 16)) & 0xFFFF;
        var skip: bool = false;
        if inverted {
            skip = h2 == 0xFFFF;
        } else {
            skip = h2 == 0;
        }
        if !skip {
            if first {
                if inverted {
                    // MOVN d, ~h, LSL k*16
                    NatEnc_word(e, 0x92800000 | (k << 21) | (((~h2) & 0xFFFF) << 5) | d);
                } else {
                    NatEnc_word(e, 0xD2800000 | (k << 21) | (h2 << 5) | d);
                }
                first = false;
            } else {
                NatEnc_word(e, 0xF2800000 | (k << 21) | (h2 << 5) | d);
            }
        }
        k = k + 1;
    }
    if first {
        // 0 or -1
        if inverted {
            NatEnc_word(e, 0x92800000 | d);
        } else {
            NatEnc_word(e, 0xD2800000 | d);
        }
    }
}

// TG1: the one-instruction forms of a64_li (nat_ir.fd's selection table
// picks them by the shape of the constant).
/// MOVZ d, #h, LSL #(16 k): d = h << 16k (h 0..0xFFFF, k 0..3)
pub fn a64_movz_hw(e: & mut NatEnc, d: i64, h: i64, k: i64) {
    NatEnc_word(e, 0xD2800000 | ((k & 3) << 21) | ((h & 0xFFFF) << 5) | d);
}

/// MOVN d, #h, LSL #(16 k): d = ~(h << 16k)
pub fn a64_movn_hw(e: & mut NatEnc, d: i64, h: i64, k: i64) {
    NatEnc_word(e, 0x92800000 | ((k & 3) << 21) | ((h & 0xFFFF) << 5) | d);
}

/// TG1: d = n shifted by the constant s (0..63): kind 0 LSL (UBFM d, n,
/// #(-s mod 64), #(63 - s)), 1 ASR (SBFM d, n, #s, #63), 2 LSR (UBFM d, n,
/// #s, #63). `lsl x0, x1, #3` = 0xD37DF020, `asr x0, x1, #3` =
/// 0x9343FC20, `lsr x0, x1, #3` = 0xD343FC20.
pub fn a64_shift_imm(e: & mut NatEnc, kind: i64, d: i64, n: i64, s: i64) {
    var c: i64 = s & 63;
    if kind == 0 {
        NatEnc_word(e, 0xD3400000 | (((64 - c) & 63) << 16) | ((63 - c) << 10) | (n << 5) | d);
    } else if kind == 1 {
        NatEnc_word(e, 0x93400000 | (c << 16) | (63 << 10) | (n << 5) | d);
    } else {
        NatEnc_word(e, 0xD3400000 | (c << 16) | (63 << 10) | (n << 5) | d);
    }
}

// Loads and stores, [n + imm] with an unsigned scaled immediate. `size` is
// 1, 2, 4 or 8; a signed load sign-extends into the whole register.
pub fn a64_ldst_fits(size: i64, imm: i64) -> bool {
    return imm >= 0 && imm % size == 0 && imm / size < 4096;
}

pub fn a64_ldr_sized(e: & mut NatEnc, t: i64, n: i64, imm: i64, size: i64, signed: bool) {
    var base: i64 = 0xF9400000;
    // LDR x
    if size == 1 {
        if signed {
            base = 0x39800000;
        } else {
            base = 0x39400000;
        }
    } else if size == 2 {
        if signed {
            base = 0x79800000;
        } else {
            base = 0x79400000;
        }
    } else if size == 4 {
        if signed {
            base = 0xB9800000;
        } else {
            base = 0xB9400000;
        }
    }
    NatEnc_word(e, base | ((imm / size) << 10) | (n << 5) | t);
}

pub fn a64_str_sized(e: & mut NatEnc, t: i64, n: i64, imm: i64, size: i64) {
    var base: i64 = 0xF9000000;
    if size == 1 {
        base = 0x39000000;
    }
    if size == 2 {
        base = 0x79000000;
    }
    if size == 4 {
        base = 0xB9000000;
    }
    NatEnc_word(e, base | ((imm / size) << 10) | (n << 5) | t);
}

/// MI22: the register-offset forms, [n, m] or [n, m, lsl #log2(size)]
/// (`scaled`): the unsigned-immediate opcode of the same access with bit
/// 24 cleared, bits 21 and 11 set, option LSL (011, bits 15:13) and S
/// (bit 12). n 31 is sp, m 31 xzr.
fn a64_roff_word(imm_form: i64, t: i64, n: i64, m: i64, scaled: bool) -> i64 {
    var w: i64 = (imm_form & 0xFEFFFFFF) | 0x00200800 | 0x6000 | (m << 16) | (n << 5) | t;
    if scaled {
        w = w | 0x1000;
    }
    return w;
}

pub fn a64_ldr_roff(e: & mut NatEnc, t: i64, n: i64, m: i64, size: i64, signed: bool, scaled: bool) {
    var base: i64 = 0xF9400000;
    if size == 1 {
        if signed {
            base = 0x39800000;
        } else {
            base = 0x39400000;
        }
    } else if size == 2 {
        if signed {
            base = 0x79800000;
        } else {
            base = 0x79400000;
        }
    } else if size == 4 {
        if signed {
            base = 0xB9800000;
        } else {
            base = 0xB9400000;
        }
    }
    NatEnc_word(e, a64_roff_word(base, t, n, m, scaled));
}

pub fn a64_str_roff(e: & mut NatEnc, t: i64, n: i64, m: i64, size: i64, scaled: bool) {
    var base: i64 = 0xF9000000;
    if size == 1 {
        base = 0x39000000;
    }
    if size == 2 {
        base = 0x79000000;
    }
    if size == 4 {
        base = 0xB9000000;
    }
    NatEnc_word(e, a64_roff_word(base, t, n, m, scaled));
}

pub fn a64_ldr(e: & mut NatEnc, t: i64, n: i64, imm: i64) {
    a64_ldr_sized(e, t, n, imm, 8, false);
}
pub fn a64_str(e: & mut NatEnc, t: i64, n: i64, imm: i64) {
    a64_str_sized(e, t, n, imm, 8);
}

// Register pairs (roadmap RA13): STP / LDP of two x registers at
// [n + imm], signed offset form (no writeback); imm a multiple of 8 in
// -512..504 (a signed 7-bit count of words).
pub fn a64_ldstp_fits(imm: i64) -> bool {
    return imm % 8 == 0 && imm >= 0 - 512 && imm <= 504;
}

/// stp t1, t2, [n, #imm]: t1 at n + imm, t2 at n + imm + 8.
pub fn a64_stp(e: & mut NatEnc, t1: i64, t2: i64, n: i64, imm: i64) {
    NatEnc_word(e, 0xA9000000 | (((imm / 8) & 0x7F) << 15) | (t2 << 10) | (n << 5) | t1);
}

/// ldp t1, t2, [n, #imm]: t1 from n + imm, t2 from n + imm + 8.
pub fn a64_ldp(e: & mut NatEnc, t1: i64, t2: i64, n: i64, imm: i64) {
    NatEnc_word(e, 0xA9400000 | (((imm / 8) & 0x7F) << 15) | (t2 << 10) | (n << 5) | t1);
}

// TG8: loads and stores with writeback, the base stepped by a signed 9-bit
// c (-256..255, any multiple of 1) after the access (post-index:
// `ldr x0, [x1], #8` = 0xF8408420) or before it (pre-index:
// `ldr x0, [x1, #8]!` = 0xF8408C20). Each is the unsigned-offset opcode of
// the same access (a64_ldst_opc: what a64_ldr_sized / a64_str_sized emit)
// with bit 24 cleared, imm9 at bits 20:12 and bits 11:10 01 (post) or 11
// (pre). n may be sp (31); t must not be n (unpredictable with writeback).
pub fn a64_wb_fits(c: i64) -> bool {
    return c >= 0 - 256 && c <= 255;
}

/// TG8: the unsigned-offset opcode of an access of `size` bytes: STR
/// (load false), LDR zero-extending, or LDRS sign-extending into the x
/// register (signed, size below 8).
pub fn a64_ldst_opc(size: i64, load: bool, signed: bool) -> i64 {
    var base: i64 = 0xF9000000;
    if size == 1 {
        base = 0x39000000;
    } else if size == 2 {
        base = 0x79000000;
    } else if size == 4 {
        base = 0xB9000000;
    }
    if load {
        if signed && size < 8 {
            base = base | 0x00800000;
        } else {
            base = base | 0x00400000;
        }
    }
    return base;
}

/// TG8: the writeback form of the unsigned-offset access word `opc` (its
/// size, V and opc bits; register fields ignored) with t, n and step c.
pub fn a64_wb_word(opc: i64, t: i64, n: i64, c: i64, pre: bool) -> i64 {
    var w: i64 = (opc & 0xFEC00000) | ((c & 0x1FF) << 12) | ((n & 31) << 5) | (t & 31);
    if pre {
        return w | 0xC00;
    }
    return w | 0x400;
}

/// TG8: t = *(n + c) then n = n + c (pre), or t = *n then n = n + c
/// (post); `size` bytes, sign-extended when signed.
pub fn a64_ldr_wb(e: & mut NatEnc, t: i64, n: i64, c: i64, size: i64, signed: bool, pre: bool) {
    NatEnc_word(e, a64_wb_word(a64_ldst_opc(size, true, signed), t, n, c, pre));
}

/// TG8: *(n + c) = t then n = n + c (pre), or *n = t then n = n + c (post).
pub fn a64_str_wb(e: & mut NatEnc, t: i64, n: i64, c: i64, size: i64, pre: bool) {
    NatEnc_word(e, a64_wb_word(a64_ldst_opc(size, false, false), t, n, c, pre));
}

// Branches (targets are labels)
pub fn a64_b(e: & mut NatEnc, label: i64) {
    NatEnc_fix(e, label, NATFIX_A64_B26);
    NatEnc_word(e, 0x14000000);
}

pub fn a64_bl(e: & mut NatEnc, label: i64) {
    NatEnc_fix(e, label, NATFIX_A64_B26);
    NatEnc_word(e, 0x94000000);
}

pub fn a64_bcond(e: & mut NatEnc, cond: i64, label: i64) {
    NatEnc_fix(e, label, NATFIX_A64_B19);
    NatEnc_word(e, 0x54000000 | cond);
}

pub fn a64_cbz(e: & mut NatEnc, t: i64, label: i64) {
    NatEnc_fix(e, label, NATFIX_A64_B19);
    NatEnc_word(e, 0xB4000000 | t);
}

pub fn a64_cbnz(e: & mut NatEnc, t: i64, label: i64) {
    NatEnc_fix(e, label, NATFIX_A64_B19);
    NatEnc_word(e, 0xB5000000 | t);
}

/// B.cond over the next instruction (+8): the inverse of a far branch.
pub fn a64_bcond_skip1(e: & mut NatEnc, cond: i64) {
    NatEnc_word(e, 0x54000000 | (2 << 5) | cond);
}

pub fn a64_blr(e: & mut NatEnc, n: i64) {
    NatEnc_word(e, 0xD63F0000 | (n << 5));
}
/// MI27: BR xn, the indirect jump of a jump table (`br x16` = D61F0200).
pub fn a64_br(e: & mut NatEnc, n: i64) {
    NatEnc_word(e, 0xD61F0000 | (n << 5));
}

/// MI27: one jump-table entry: 4 bytes holding `label` minus the entry's
/// own address (NATFIX_SELF32), on every target.
pub fn nat_jt_entry(e: & mut NatEnc, label: i64) {
    NatEnc_fix(e, label, NATFIX_SELF32);
    NatEnc_word(e, 0);
}
pub fn a64_ret(e: & mut NatEnc) {
    NatEnc_word(e, 0xD65F03C0);
}
pub fn a64_svc0(e: & mut NatEnc) {
    NatEnc_word(e, 0xD4000001);
}
pub fn a64_brk(e: & mut NatEnc) {
    NatEnc_word(e, 0xD4200000);
}

/// d = the address of `label` (ADRP + ADD).
pub fn a64_addr(e: & mut NatEnc, d: i64, label: i64) {
    NatEnc_fix(e, label, NATFIX_A64_ADRP_ADD);
    NatEnc_word(e, 0x90000000 | d);
    NatEnc_word(e, 0x91000000 | (d << 5) | d);
}

// Floating point (double unless named _s)
pub fn a64_fmov_dx(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x9E670000 | (n << 5) | d);
}
pub fn a64_fmov_xd(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x9E660000 | (n << 5) | d);
}
pub fn a64_fmov_sw(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x1E270000 | (n << 5) | d);
}
pub fn a64_fmov_ws(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x1E260000 | (n << 5) | d);
}
pub fn a64_fadd(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x1E602800, d, n, m);
}
pub fn a64_fsub(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x1E603800, d, n, m);
}
pub fn a64_fmul(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x1E600800, d, n, m);
}
pub fn a64_fdiv(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    a64_rrr(e, 0x1E601800, d, n, m);
}
pub fn a64_fcmp(e: & mut NatEnc, n: i64, m: i64) {
    NatEnc_word(e, 0x1E602000 | (m << 16) | (n << 5));
}
pub fn a64_fcvt_ds(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x1E22C000 | (n << 5) | d);
}
pub fn a64_fcvt_sd(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x1E624000 | (n << 5) | d);
}
pub fn a64_scvtf(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x9E620000 | (n << 5) | d);
}
pub fn a64_fcvtzs(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x9E780000 | (n << 5) | d);
}
pub fn a64_fsqrt(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x1E61C000 | (n << 5) | d);
}
pub fn a64_fabs(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x1E60C000 | (n << 5) | d);
}
pub fn a64_frintm(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x1E654000 | (n << 5) | d);
}
pub fn a64_frintp(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x1E64C000 | (n << 5) | d);
}
pub fn a64_frintz(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x1E65C000 | (n << 5) | d);
}
pub fn a64_frinta(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x1E664000 | (n << 5) | d);
}

// Atomics (exclusive and acquire/release forms)
pub fn a64_ldaxr(e: & mut NatEnc, t: i64, n: i64) {
    NatEnc_word(e, 0xC85FFC00 | (n << 5) | t);
}
/// STLXR Ws, Xt, [Xn]: Ws = 0 on success
pub fn a64_stlxr(e: & mut NatEnc, s: i64, t: i64, n: i64) {
    NatEnc_word(e, 0xC800FC00 | (s << 16) | (n << 5) | t);
}
pub fn a64_ldar(e: & mut NatEnc, t: i64, n: i64) {
    NatEnc_word(e, 0xC8DFFC00 | (n << 5) | t);
}
pub fn a64_stlr(e: & mut NatEnc, t: i64, n: i64) {
    NatEnc_word(e, 0xC89FFC00 | (n << 5) | t);
}
pub fn a64_clrex(e: & mut NatEnc) {
    NatEnc_word(e, 0xD5033F5F);
}
// clrex (#15)
pub fn a64_dmb(e: & mut NatEnc) {
    NatEnc_word(e, 0xD5033BBF);
}
/// CBNZ Wt by a fixed word count (no fixup); negative jumps back
pub fn a64_cbnz_w_words(e: & mut NatEnc, t: i64, words: i64) {
    NatEnc_word(e, 0x35000000 | ((words & 0x7FFFF) << 5) | t);
}
/// B.cond / CBNZ X by a fixed word count
pub fn a64_bcond_words(e: & mut NatEnc, cond: i64, words: i64) {
    NatEnc_word(e, 0x54000000 | ((words & 0x7FFFF) << 5) | cond);
}
pub fn a64_cbnz_words(e: & mut NatEnc, t: i64, words: i64) {
    NatEnc_word(e, 0xB5000000 | ((words & 0x7FFFF) << 5) | t);
}

/// TG8: TBZ (nz false) / TBNZ (nz true) Xt, #bit by a fixed word count
/// (no fixup): b5 011011 op b40 imm14 Rt. `tbnz x3, #37, .+8` =
/// B7280043. bit 0..63.
pub fn a64_tbz_words(e: & mut NatEnc, t: i64, bit: i64, nz: bool, words: i64) {
    var w: i64 = 0x36000000 | (((bit >> 5) & 1) << 31) | ((bit & 31) << 19) | ((words & 0x3FFF) << 5) | t;
    if nz {
        w = w | 0x01000000;
    }
    NatEnc_word(e, w);
}

/// TG8: TBZ / TBNZ Xt, #bit straight to `label` (+-32 KB; NatEnc_resolve
/// checks the reach).
pub fn a64_tbz_label(e: & mut NatEnc, t: i64, bit: i64, nz: bool, label: i64) {
    NatEnc_fix(e, label, NATFIX_A64_B14);
    a64_tbz_words(e, t, bit, nz, 0);
}

// ===========================================================================
// RISC-V 64 (RV64IMFD) encodings. Registers: x0..x31 (zero, ra, sp, ...);
// floating point f0..f31.
// ===========================================================================

pub const RV_ZERO: i64 = 0; pub const RV_RA: i64 = 1; pub const RV_SP: i64 = 2; pub const RV_S0: i64 = 8; pub const RV_A0: i64 = 10; pub const RV_A7: i64 = 17; pub const RV_T0: i64 = 5; pub const RV_T6: i64 = 31; pub fn rv_r(e: & mut NatEnc, f7: i64, rs2: i64, rs1: i64, f3: i64, rd: i64, op: i64) {
    NatEnc_word(e, (f7 << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | (rd << 7) | op);
}

pub fn rv_i(e: & mut NatEnc, imm: i64, rs1: i64, f3: i64, rd: i64, op: i64) {
    NatEnc_word(e, ((imm & 0xFFF) << 20) | (rs1 << 15) | (f3 << 12) | (rd << 7) | op);
}

pub fn rv_s(e: & mut NatEnc, imm: i64, rs2: i64, rs1: i64, f3: i64) {
    NatEnc_word(e, (((imm >> 5) & 0x7F) << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | ((imm & 0x1F) << 7) | 0x23);
}

/// A conditional branch by a fixed byte offset (no fixup): -4096..4094.
pub fn rv_b_off(e: & mut NatEnc, f3: i64, rs1: i64, rs2: i64, off: i64) {
    var w: i64 = (((off >> 12) & 1) << 31) | (((off >> 5) & 0x3F) << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | (((off >> 1) & 0xF) << 8) | (((off >> 11) & 1) << 7) | 0x63;
    NatEnc_word(e, w);
}

/// TG6: a conditional branch straight to `label` (-4096..4094 bytes away;
/// NatEnc_resolve checks the reach).
pub fn rv_b_label(e: & mut NatEnc, f3: i64, rs1: i64, rs2: i64, label: i64) {
    NatEnc_fix(e, label, NATFIX_RV_B12);
    rv_b_off(e, f3, rs1, rs2, 0);
}

/// TG6: JAL ra, label: a call in one word (+-1 MB) where AUIPC + JALR took two.
pub fn rv_call_near(e: & mut NatEnc, label: i64) {
    NatEnc_fix(e, label, NATFIX_RV_JAL);
    NatEnc_word(e, (RV_RA << 7) | 0x6F);
}

pub const RV_BEQ: i64 = 0; pub const RV_BNE: i64 = 1; pub const RV_BLT: i64 = 4; pub const RV_BGE: i64 = 5; pub const RV_BLTU: i64 = 6; pub const RV_BGEU: i64 = 7; pub fn rv_add(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0, b, a, 0, d, 0x33);
}
pub fn rv_sub(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0x20, b, a, 0, d, 0x33);
}
pub fn rv_sll(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0, b, a, 1, d, 0x33);
}
pub fn rv_slt(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0, b, a, 2, d, 0x33);
}
pub fn rv_sltu(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0, b, a, 3, d, 0x33);
}
pub fn rv_xor(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0, b, a, 4, d, 0x33);
}
pub fn rv_srl(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0, b, a, 5, d, 0x33);
}
pub fn rv_sra(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0x20, b, a, 5, d, 0x33);
}
pub fn rv_or(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0, b, a, 6, d, 0x33);
}
pub fn rv_and(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0, b, a, 7, d, 0x33);
}
pub fn rv_mul(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 1, b, a, 0, d, 0x33);
}
pub fn rv_mulh(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 1, b, a, 1, d, 0x33);
}
pub fn rv_mulhu(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 1, b, a, 3, d, 0x33);
}
pub fn rv_div(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 1, b, a, 4, d, 0x33);
}
pub fn rv_divu(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 1, b, a, 5, d, 0x33);
}
pub fn rv_rem(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 1, b, a, 6, d, 0x33);
}
pub fn rv_remu(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 1, b, a, 7, d, 0x33);
}

pub fn rv_addi(e: & mut NatEnc, d: i64, a: i64, imm: i64) {
    rv_i(e, imm, a, 0, d, 0x13);
}
pub fn rv_xori(e: & mut NatEnc, d: i64, a: i64, imm: i64) {
    rv_i(e, imm, a, 4, d, 0x13);
}
pub fn rv_andi(e: & mut NatEnc, d: i64, a: i64, imm: i64) {
    rv_i(e, imm, a, 7, d, 0x13);
}
pub fn rv_sltiu(e: & mut NatEnc, d: i64, a: i64, imm: i64) {
    rv_i(e, imm, a, 3, d, 0x13);
}
pub fn rv_slli(e: & mut NatEnc, d: i64, a: i64, sh: i64) {
    rv_i(e, sh & 63, a, 1, d, 0x13);
}
pub fn rv_srli(e: & mut NatEnc, d: i64, a: i64, sh: i64) {
    rv_i(e, sh & 63, a, 5, d, 0x13);
}
pub fn rv_srai(e: & mut NatEnc, d: i64, a: i64, sh: i64) {
    rv_i(e, 0x400 | (sh & 63), a, 5, d, 0x13);
}
pub fn rv_addiw(e: & mut NatEnc, d: i64, a: i64, imm: i64) {
    rv_i(e, imm, a, 0, d, 0x1B);
}
/// TG9: the 32-bit operations of RV64 (OP-32, 0x3B): the low 32 bits of
/// the result, sign-extended to 64. `addw a0, a1, a2` = 00C5853B,
/// `subw t0, t1, t2` = 407302BB, `mulw a0, a1, a2` = 02C5853B.
pub fn rv_addw(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0, b, a, 0, d, 0x3B);
}
pub fn rv_subw(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0x20, b, a, 0, d, 0x3B);
}
pub fn rv_mulw(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 1, b, a, 0, d, 0x3B);
}
pub fn rv_mv(e: & mut NatEnc, d: i64, a: i64) {
    if d == a {
        return;
    }
    rv_addi(e, d, a, 0);
}

// TG9: Zba and Zbb (bit manipulation; RVA22U64 has both), used only under
// `--cpu rva22u64` / `rva23u64` / `rv64gc_zba_zbb` (nat_ir ng_rv_zb).
/// Zba sh1add / sh2add / sh3add: d = a + (b << n), n = 1..3 (rd = rs2 +
/// (rs1 << n), rs1 = b, rs2 = a).
pub fn rv_shadd(e: & mut NatEnc, d: i64, a: i64, b: i64, n: i64) {
    rv_r(e, 0x10, a, b, 2 * n, d, 0x33);
}
/// Zba zext.w (add.uw d, s, zero): the low 32 bits of s, zero-extended.
pub fn rv_zext_w(e: & mut NatEnc, d: i64, s: i64) {
    rv_r(e, 0x04, RV_ZERO, s, 0, d, 0x3B);
}
/// Zbb sext.b / sext.h: the low byte / halfword of s, sign-extended.
pub fn rv_sext_b(e: & mut NatEnc, d: i64, s: i64) {
    rv_i(e, 0x604, s, 1, d, 0x13);
}
pub fn rv_sext_h(e: & mut NatEnc, d: i64, s: i64) {
    rv_i(e, 0x605, s, 1, d, 0x13);
}
/// Zbb zext.h (RV64: packw d, s, zero): the low halfword, zero-extended.
pub fn rv_zext_h(e: & mut NatEnc, d: i64, s: i64) {
    rv_r(e, 0x04, RV_ZERO, s, 4, d, 0x3B);
}
/// MI3: Zbb andn: d = a & ~b (rd = rs1 & ~rs2, rs1 = a, rs2 = b).
pub fn rv_andn(e: & mut NatEnc, d: i64, a: i64, b: i64) {
    rv_r(e, 0x20, b, a, 7, d, 0x33);
}
/// MI24: Zicond czero.eqz d, a, c: d = (c == 0) ? 0 : a (funct7 0000111,
/// funct3 101, OP), used only under `--cpu rva23u64` (nat_ir ng_rv_zicond).
pub fn rv_czero_eqz(e: & mut NatEnc, d: i64, a: i64, c: i64) {
    rv_r(e, 0x07, c, a, 5, d, 0x33);
}
/// MI24: Zicond czero.nez d, a, c: d = (c != 0) ? 0 : a (funct3 111).
pub fn rv_czero_nez(e: & mut NatEnc, d: i64, a: i64, c: i64) {
    rv_r(e, 0x07, c, a, 7, d, 0x33);
}

pub fn rv_lui(e: & mut NatEnc, d: i64, imm20: i64) {
    NatEnc_word(e, ((imm20 & 0xFFFFF) << 12) | (d << 7) | 0x37);
}
pub fn rv_jalr(e: & mut NatEnc, d: i64, a: i64, imm: i64) {
    rv_i(e, imm, a, 0, d, 0x67);
}
pub fn rv_ret(e: & mut NatEnc) {
    rv_jalr(e, RV_ZERO, RV_RA, 0);
}
pub fn rv_ecall(e: & mut NatEnc) {
    NatEnc_word(e, 0x00000073);
}
pub fn rv_ebreak(e: & mut NatEnc) {
    NatEnc_word(e, 0x00100073);
}

// Loads (funct3: lb 0, lh 1, lw 2, ld 3, lbu 4, lhu 5, lwu 6) and stores
pub fn rv_load(e: & mut NatEnc, d: i64, a: i64, imm: i64, size: i64, signed: bool) {
    var f3: i64 = 3;
    if size == 1 {
        if signed {
            f3 = 0;
        } else {
            f3 = 4;
        }
    }
    if size == 2 {
        if signed {
            f3 = 1;
        } else {
            f3 = 5;
        }
    }
    if size == 4 {
        if signed {
            f3 = 2;
        } else {
            f3 = 6;
        }
    }
    rv_i(e, imm, a, f3, d, 0x03);
}

pub fn rv_store(e: & mut NatEnc, v: i64, a: i64, imm: i64, size: i64) {
    var f3: i64 = 3;
    if size == 1 {
        f3 = 0;
    }
    if size == 2 {
        f3 = 1;
    }
    if size == 4 {
        f3 = 2;
    }
    rv_s(e, imm, v, a, f3);
}

pub fn rv_fits12(v: i64) -> bool {
    return v >= 0 - 2048 && v <= 2047;
}

/// Any 64-bit constant (LUI/ADDI(W)/SLLI sequences).
@wrapping pub fn rv_li(e: & mut NatEnc, d: i64, v: i64) {
    if rv_fits12(v) {
        rv_addi(e, d, RV_ZERO, v);
        return;
    }
    if v >= 0 - 2147483648 && v <= 2147483647 {
        var lo: i64 = ((v & 0xFFF) ^ 0x800) - 0x800;
        // sign-extended low 12 bits
        var hi: i64 = (v - lo) >> 12;
        rv_lui(e, d, hi);
        if lo != 0 {
            rv_addiw(e, d, d, lo);
        } else {
            rv_addiw(e, d, d, 0);
        }
        return;
    }
    var lo12: i64 = ((v & 0xFFF) ^ 0x800) - 0x800;
    var rest: i64 = (v - lo12) >> 12;
    rv_li(e, d, rest);
    rv_slli(e, d, d, 12);
    if lo12 != 0 {
        rv_addi(e, d, d, lo12);
    }
}

/// JAL d, label (+-1 MB)
pub fn rv_jal(e: & mut NatEnc, d: i64, label: i64) {
    NatEnc_fix(e, label, NATFIX_RV_JAL);
    NatEnc_word(e, (d << 7) | 0x6F);
}

/// d = the address of `label` (AUIPC + ADDI).
pub fn rv_addr(e: & mut NatEnc, d: i64, label: i64) {
    NatEnc_fix(e, label, NATFIX_RV_AUIPC_I);
    NatEnc_word(e, (d << 7) | 0x17);
    rv_addi(e, d, d, 0);
}

/// A call anywhere in the image: AUIPC ra + JALR ra.
pub fn rv_call(e: & mut NatEnc, label: i64) {
    NatEnc_fix(e, label, NATFIX_RV_AUIPC_I);
    NatEnc_word(e, (RV_RA << 7) | 0x17);
    rv_jalr(e, RV_RA, RV_RA, 0);
}

/// A jump anywhere in the image through t6: AUIPC t6 + JALR zero.
pub fn rv_far_jump(e: & mut NatEnc, label: i64) {
    NatEnc_fix(e, label, NATFIX_RV_AUIPC_I);
    NatEnc_word(e, (RV_T6 << 7) | 0x17);
    rv_jalr(e, RV_ZERO, RV_T6, 0);
}

// Floating point (D, with F for f32 moves and conversions)
pub fn rv_fmv_dx(e: & mut NatEnc, fd: i64, rs: i64) {
    NatEnc_word(e, 0xF2000053 | (rs << 15) | (fd << 7));
}
pub fn rv_fmv_xd(e: & mut NatEnc, rd: i64, fs: i64) {
    NatEnc_word(e, 0xE2000053 | (fs << 15) | (rd << 7));
}
pub fn rv_fmv_wx(e: & mut NatEnc, fd: i64, rs: i64) {
    NatEnc_word(e, 0xF0000053 | (rs << 15) | (fd << 7));
}
pub fn rv_fmv_xw(e: & mut NatEnc, rd: i64, fs: i64) {
    NatEnc_word(e, 0xE0000053 | (fs << 15) | (rd << 7));
}
// rm = 7: the dynamic rounding mode (round to nearest even at start)
pub fn rv_fop_d(e: & mut NatEnc, base: i64, fd: i64, a: i64, b: i64) {
    NatEnc_word(e, base | (b << 20) | (a << 15) | (7 << 12) | (fd << 7));
}
pub fn rv_fadd_d(e: & mut NatEnc, fd: i64, a: i64, b: i64) {
    rv_fop_d(e, 0x02000053, fd, a, b);
}
pub fn rv_fsub_d(e: & mut NatEnc, fd: i64, a: i64, b: i64) {
    rv_fop_d(e, 0x0A000053, fd, a, b);
}
pub fn rv_fmul_d(e: & mut NatEnc, fd: i64, a: i64, b: i64) {
    rv_fop_d(e, 0x12000053, fd, a, b);
}
pub fn rv_fdiv_d(e: & mut NatEnc, fd: i64, a: i64, b: i64) {
    rv_fop_d(e, 0x1A000053, fd, a, b);
}
pub fn rv_feq_d(e: & mut NatEnc, rd: i64, a: i64, b: i64) {
    NatEnc_word(e, 0xA2002053 | (b << 20) | (a << 15) | (rd << 7));
}
pub fn rv_flt_d(e: & mut NatEnc, rd: i64, a: i64, b: i64) {
    NatEnc_word(e, 0xA2001053 | (b << 20) | (a << 15) | (rd << 7));
}
pub fn rv_fle_d(e: & mut NatEnc, rd: i64, a: i64, b: i64) {
    NatEnc_word(e, 0xA2000053 | (b << 20) | (a << 15) | (rd << 7));
}
pub fn rv_fcvt_dl(e: & mut NatEnc, fd: i64, rs: i64) {
    NatEnc_word(e, 0xD2200053 | (rs << 15) | (7 << 12) | (fd << 7));
}
// fcvt.l.d with rtz (round toward zero), as a C cast
pub fn rv_fcvt_ld(e: & mut NatEnc, rd: i64, fs: i64) {
    NatEnc_word(e, 0xC2200053 | (fs << 15) | (1 << 12) | (rd << 7));
}
pub fn rv_fcvt_ds(e: & mut NatEnc, fd: i64, fs: i64) {
    NatEnc_word(e, 0x42000053 | (fs << 15) | (fd << 7));
}
/// fcvt.l.d with an explicit rounding mode (1 rtz, 2 rdn, 3 rup, 4 rmm)
pub fn rv_fcvt_ld_rm(e: & mut NatEnc, rd: i64, fs: i64, rm: i64) {
    NatEnc_word(e, 0xC2200053 | (fs << 15) | (rm << 12) | (rd << 7));
}
pub fn rv_fsqrt_d(e: & mut NatEnc, fd: i64, fs: i64) {
    NatEnc_word(e, 0x5A000053 | (fs << 15) | (7 << 12) | (fd << 7));
}
pub fn rv_fsgnj_d(e: & mut NatEnc, fd: i64, a: i64, b: i64) {
    NatEnc_word(e, 0x22000053 | (b << 20) | (a << 15) | (fd << 7));
}
pub fn rv_fsgnjx_d(e: & mut NatEnc, fd: i64, a: i64, b: i64) {
    NatEnc_word(e, 0x22002053 | (b << 20) | (a << 15) | (fd << 7));
}

// Atomics (A extension), acquire + release
pub fn rv_amoadd_d(e: & mut NatEnc, rd: i64, rs2: i64, rs1: i64) {
    NatEnc_word(e, (0 << 27) | (1 << 26) | (1 << 25) | (rs2 << 20) | (rs1 << 15) | (3 << 12) | (rd << 7) | 0x2F);
}
pub fn rv_lr_d(e: & mut NatEnc, rd: i64, rs1: i64) {
    NatEnc_word(e, (2 << 27) | (1 << 26) | (1 << 25) | (rs1 << 15) | (3 << 12) | (rd << 7) | 0x2F);
}
/// sc.d rd, rs2, (rs1): rd = 0 on success
pub fn rv_sc_d(e: & mut NatEnc, rd: i64, rs2: i64, rs1: i64) {
    NatEnc_word(e, (3 << 27) | (1 << 26) | (1 << 25) | (rs2 << 20) | (rs1 << 15) | (3 << 12) | (rd << 7) | 0x2F);
}
pub fn rv_fence(e: & mut NatEnc) {
    NatEnc_word(e, 0x0330000F);
}
pub fn rv_fcvt_sd(e: & mut NatEnc, fd: i64, fs: i64) {
    NatEnc_word(e, 0x40100053 | (fs << 15) | (7 << 12) | (fd << 7));
}

// ===========================================================================
// TG9: RVC, the 2-byte forms of RV64C (rv64gc has them). The encoders above
// write 4-byte words and every fixup assumes it, so compression is a pass
// after layout (nat_rvc_compress, run by nat_ir ng_rvc_pass before the data
// is laid out and before NatEnc_resolve): each plain instruction that has a
// 2-byte form takes it, and every offset into the code moves (labels,
// fixups, the constant offsets of branches written without a fixup, line
// and frame rows). Kept at 4 bytes: words with a fixup (and the second word
// of an AUIPC pair), branches and jumps (their offsets are kept, moved),
// calls (JALR ra: a return address is the call's end), ebreak, ecall, the
// frame prologue of each function (nat_has_frame and the CIE rules read
// it), data words in the code (jump-table entries) and the asm! thunks.
// docs/reference/rvc.md.
// ===========================================================================

/// TG9: the image's code was compressed (nat_rvc_compress): the ELF's
/// e_flags say EF_RISCV_RVC and the frame rules' code alignment is 2.
pub var g_nat_rvc: bool = false;

/// TG9: the compressed (prime) register number of x8..x15, else -1.
fn nat_rvc_reg(r: i64) -> i64 {
    if r >= 8 && r <= 15 {
        return r - 8;
    }
    return 0 - 1;
}

fn nat_rvc_simm6(v: i64) -> bool {
    return v >= 0 - 32 && v <= 31;
}

/// TG9: the 2-byte RVC form of the 32-bit RISC-V instruction `w0`, or -1
/// when it has none (or when the pass keeps it at 4 bytes by rule: JALR
/// with a link register, EBREAK, branches and jumps). Where two forms
/// exist the assemblers' choice is taken (`addi sp, sp, -16` is c.addi,
/// not c.addi16sp); scripts and tests/nattools/enc-oracle-tg9.py check
/// every form against clang's assembler with `.option rvc`.
@wrapping pub fn nat_rvc_of(w0: i64) -> i64 {
    var w: i64 = w0 & 0xFFFFFFFF;
    if (w & 3) != 3 {
        return 0 - 1;
    }
    var op: i64 = w & 0x7F;
    var rd: i64 = (w >> 7) & 31;
    var f3: i64 = (w >> 12) & 7;
    var rs1: i64 = (w >> 15) & 31;
    var rs2: i64 = (w >> 20) & 31;
    var f7: i64 = (w >> 25) & 0x7F;
    var ii: i64 = (w >> 20) & 0xFFF;
    if ii >= 2048 {
        ii = ii - 4096;
    }
    var si: i64 = (((w >> 25) & 0x7F) << 5) | ((w >> 7) & 31);
    if si >= 2048 {
        si = si - 4096;
    }
    var pd: i64 = nat_rvc_reg(rd);
    var p1: i64 = nat_rvc_reg(rs1);
    var p2: i64 = nat_rvc_reg(rs2);
    if op == 0x13 {
        if f3 == 0 {
            // addi
            if rd == 0 {
                if rs1 == 0 && ii == 0 {
                    return 0x0001;
                    // c.nop
                }
                return 0 - 1;
            }
            if rs1 == 0 {
                if nat_rvc_simm6(ii) {
                    return 0x4001 | (((ii >> 5) & 1) << 12) | (rd << 7) | ((ii & 31) << 2);
                    // c.li
                }
                return 0 - 1;
            }
            if ii == 0 {
                return 0x8002 | (rd << 7) | (rs1 << 2);
                // c.mv
            }
            if rd == rs1 && nat_rvc_simm6(ii) {
                return 0x0001 | (((ii >> 5) & 1) << 12) | (rd << 7) | ((ii & 31) << 2);
                // c.addi
            }
            if rd == 2 && rs1 == 2 && (ii & 15) == 0 && ii >= 0 - 512 && ii <= 496 {
                return 0x6101 | (((ii >> 9) & 1) << 12) | (((ii >> 4) & 1) << 6) | (((ii >> 6) & 1) << 5) | (((ii >> 7) & 3) << 3) | (((ii >> 5) & 1) << 2);
                // c.addi16sp
            }
            if rs1 == 2 && pd >= 0 && ii > 0 && ii <= 1020 && (ii & 3) == 0 {
                return 0x0000 | (((ii >> 4) & 3) << 11) | (((ii >> 6) & 15) << 7) | (((ii >> 2) & 1) << 6) | (((ii >> 3) & 1) << 5) | (pd << 2);
                // c.addi4spn
            }
            return 0 - 1;
        }
        var sh: i64 = (w >> 20) & 63;
        var top: i64 = (w >> 26) & 63;
        if f3 == 1 {
            if top == 0 && rd == rs1 && rd != 0 && sh != 0 {
                return 0x0002 | (((sh >> 5) & 1) << 12) | (rd << 7) | ((sh & 31) << 2);
                // c.slli
            }
            return 0 - 1;
        }
        if f3 == 5 {
            if rd == rs1 && pd >= 0 && sh != 0 {
                if top == 0 {
                    return 0x8001 | (((sh >> 5) & 1) << 12) | (pd << 7) | ((sh & 31) << 2);
                    // c.srli
                }
                if top == 0x10 {
                    return 0x8401 | (((sh >> 5) & 1) << 12) | (pd << 7) | ((sh & 31) << 2);
                    // c.srai
                }
            }
            return 0 - 1;
        }
        if f3 == 7 {
            if rd == rs1 && pd >= 0 && nat_rvc_simm6(ii) {
                return 0x8801 | (((ii >> 5) & 1) << 12) | (pd << 7) | ((ii & 31) << 2);
                // c.andi
            }
        }
        return 0 - 1;
    }
    if op == 0x1B {
        if f3 == 0 && rs1 == 0 && rd != 0 && nat_rvc_simm6(ii) {
            return 0x4001 | (((ii >> 5) & 1) << 12) | (rd << 7) | ((ii & 31) << 2);
            // c.li (addiw rd, zero, imm is that small constant too; LLVM
            // compresses it so)
        }
        if f3 == 0 && rd == rs1 && rd != 0 && nat_rvc_simm6(ii) {
            return 0x2001 | (((ii >> 5) & 1) << 12) | (rd << 7) | ((ii & 31) << 2);
            // c.addiw (sext.w at 0)
        }
        return 0 - 1;
    }
    if op == 0x33 {
        if f7 == 0 && f3 == 0 {
            // add
            if rd == 0 {
                return 0 - 1;
            }
            if rs1 == 0 && rs2 != 0 {
                return 0x8002 | (rd << 7) | (rs2 << 2);
            }
            if rs2 == 0 && rs1 != 0 {
                return 0x8002 | (rd << 7) | (rs1 << 2);
            }
            if rs1 == 0 || rs2 == 0 {
                return 0 - 1;
            }
            if rd == rs1 {
                return 0x9002 | (rd << 7) | (rs2 << 2);
                // c.add
            }
            if rd == rs2 {
                return 0x9002 | (rd << 7) | (rs1 << 2);
            }
            return 0 - 1;
        }
        if pd < 0 {
            return 0 - 1;
        }
        if f7 == 0x20 && f3 == 0 {
            if rd == rs1 && p2 >= 0 {
                return 0x8C01 | (pd << 7) | (p2 << 2);
                // c.sub
            }
            return 0 - 1;
        }
        if f7 == 0 && (f3 == 4 || f3 == 6 || f3 == 7) {
            var fn2: i64 = 1;
            if f3 == 6 {
                fn2 = 2;
            } else if f3 == 7 {
                fn2 = 3;
            }
            if rd == rs1 && p2 >= 0 {
                return 0x8C01 | (pd << 7) | (fn2 << 5) | (p2 << 2);
                // c.xor / c.or / c.and
            }
            if rd == rs2 && p1 >= 0 {
                return 0x8C01 | (pd << 7) | (fn2 << 5) | (p1 << 2);
            }
        }
        return 0 - 1;
    }
    if op == 0x3B {
        if pd < 0 || f3 != 0 {
            return 0 - 1;
        }
        if f7 == 0x20 && rd == rs1 && p2 >= 0 {
            return 0x9C01 | (pd << 7) | (p2 << 2);
            // c.subw
        }
        if f7 == 0 {
            if rd == rs1 && p2 >= 0 {
                return 0x9C21 | (pd << 7) | (p2 << 2);
                // c.addw
            }
            if rd == rs2 && p1 >= 0 {
                return 0x9C21 | (pd << 7) | (p1 << 2);
            }
        }
        return 0 - 1;
    }
    if op == 0x37 {
        var imm20: i64 = (w >> 12) & 0xFFFFF;
        if rd != 0 && rd != 2 && ((imm20 >= 1 && imm20 <= 31) || imm20 >= 0xFFFE0) {
            return 0x6001 | (((imm20 >> 5) & 1) << 12) | (rd << 7) | ((imm20 & 31) << 2);
            // c.lui
        }
        return 0 - 1;
    }
    if op == 0x03 || op == 0x07 {
        // ld / lw (op 0x03, f3 3 / 2), fld (op 0x07, f3 3)
        var fp: bool = op == 0x07;
        if f3 == 3 {
            if rs1 == 2 && (fp || rd != 0) && ii >= 0 && ii <= 504 && (ii & 7) == 0 {
                var bsp: i64 = 0x6002;
                if fp {
                    bsp = 0x2002;
                }
                return bsp | (((ii >> 5) & 1) << 12) | (rd << 7) | (((ii >> 3) & 3) << 5) | (((ii >> 6) & 7) << 2);
                // c.ldsp / c.fldsp
            }
            if pd >= 0 && p1 >= 0 && ii >= 0 && ii <= 248 && (ii & 7) == 0 {
                var bl: i64 = 0x6000;
                if fp {
                    bl = 0x2000;
                }
                return bl | (((ii >> 3) & 7) << 10) | (p1 << 7) | (((ii >> 6) & 3) << 5) | (pd << 2);
                // c.ld / c.fld
            }
            return 0 - 1;
        }
        if f3 == 2 && !fp {
            if rs1 == 2 && rd != 0 && ii >= 0 && ii <= 252 && (ii & 3) == 0 {
                return 0x4002 | (((ii >> 5) & 1) << 12) | (rd << 7) | (((ii >> 2) & 7) << 4) | (((ii >> 6) & 3) << 2);
                // c.lwsp
            }
            if pd >= 0 && p1 >= 0 && ii >= 0 && ii <= 124 && (ii & 3) == 0 {
                return 0x4000 | (((ii >> 3) & 7) << 10) | (p1 << 7) | (((ii >> 2) & 1) << 6) | (((ii >> 6) & 1) << 5) | (pd << 2);
                // c.lw
            }
        }
        return 0 - 1;
    }
    if op == 0x23 || op == 0x27 {
        // sd / sw (op 0x23, f3 3 / 2), fsd (op 0x27, f3 3)
        var sfp: bool = op == 0x27;
        if f3 == 3 {
            if rs1 == 2 && si >= 0 && si <= 504 && (si & 7) == 0 {
                var ssp: i64 = 0xE002;
                if sfp {
                    ssp = 0xA002;
                }
                return ssp | (((si >> 3) & 7) << 10) | (((si >> 6) & 7) << 7) | (rs2 << 2);
                // c.sdsp / c.fsdsp
            }
            if p1 >= 0 && p2 >= 0 && si >= 0 && si <= 248 && (si & 7) == 0 {
                var sl: i64 = 0xE000;
                if sfp {
                    sl = 0xA000;
                }
                return sl | (((si >> 3) & 7) << 10) | (p1 << 7) | (((si >> 6) & 3) << 5) | (p2 << 2);
                // c.sd / c.fsd
            }
            return 0 - 1;
        }
        if f3 == 2 && !sfp {
            if rs1 == 2 && si >= 0 && si <= 252 && (si & 3) == 0 {
                return 0xC002 | (((si >> 2) & 15) << 9) | (((si >> 6) & 3) << 7) | (rs2 << 2);
                // c.swsp
            }
            if p1 >= 0 && p2 >= 0 && si >= 0 && si <= 124 && (si & 3) == 0 {
                return 0xC000 | (((si >> 3) & 7) << 10) | (p1 << 7) | (((si >> 2) & 1) << 6) | (((si >> 6) & 1) << 5) | (p2 << 2);
                // c.sw
            }
        }
        return 0 - 1;
    }
    if op == 0x67 {
        // jalr: only `jalr zero, 0(rs1)` (c.jr); a call keeps 4 bytes
        if f3 == 0 && rd == 0 && rs1 != 0 && ii == 0 {
            return 0x8002 | (rs1 << 7);
        }
        return 0 - 1;
    }
    return 0 - 1;
}

/// TG9: an I-type, S-type, R-type, B-type, J-type word (nat_rvc_expand).
fn nat_rvc_i(imm: i64, rs1: i64, f3: i64, rd: i64, op: i64) -> i64 {
    return ((imm & 0xFFF) << 20) | (rs1 << 15) | (f3 << 12) | (rd << 7) | op;
}
fn nat_rvc_s(imm: i64, rs2: i64, rs1: i64, f3: i64, op: i64) -> i64 {
    return (((imm >> 5) & 0x7F) << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | ((imm & 31) << 7) | op;
}
fn nat_rvc_r(f7: i64, rs2: i64, rs1: i64, f3: i64, rd: i64, op: i64) -> i64 {
    return (f7 << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | (rd << 7) | op;
}
@wrapping pub fn nat_rv_b_bits(off: i64) -> i64 {
    return (((off >> 12) & 1) << 31) | (((off >> 5) & 0x3F) << 25) | (((off >> 1) & 0xF) << 8) | (((off >> 11) & 1) << 7);
}
@wrapping pub fn nat_rv_j_bits(off: i64) -> i64 {
    return (((off >> 20) & 1) << 31) | (((off >> 1) & 0x3FF) << 21) | (((off >> 11) & 1) << 20) | (((off >> 12) & 0xFF) << 12);
}
/// TG9: the byte offset of a B-type word (sign-extended).
@wrapping pub fn nat_rv_b_off_of(w: i64) -> i64 {
    var off: i64 = (((w >> 31) & 1) << 12) | (((w >> 7) & 1) << 11) | (((w >> 25) & 0x3F) << 5) | (((w >> 8) & 0xF) << 1);
    if off >= 4096 {
        off = off - 8192;
    }
    return off;
}
/// TG9: the byte offset of a JAL word (sign-extended).
@wrapping pub fn nat_rv_j_off_of(w: i64) -> i64 {
    var off: i64 = (((w >> 31) & 1) << 20) | (((w >> 12) & 0xFF) << 12) | (((w >> 20) & 1) << 11) | (((w >> 21) & 0x3FF) << 1);
    if off >= 1048576 {
        off = off - 2097152;
    }
    return off;
}

/// TG9: the 32-bit instruction a 2-byte RVC instruction `h` stands for
/// (RV64C: every form, not only those nat_rvc_of makes), or -1 when `h` is
/// not one (a 32-bit instruction's low half, a reserved or illegal form).
/// For `fid disasm` (compiler/disasm.fd) and the round-trip test
/// (tests/nattools/rvc_unit.fd: nat_rvc_of(nat_rvc_expand(c)) == c).
@wrapping pub fn nat_rvc_expand(h0: i64) -> i64 {
    var h: i64 = h0 & 0xFFFF;
    var q: i64 = h & 3;
    var f3: i64 = (h >> 13) & 7;
    if q == 3 || h == 0 {
        return 0 - 1;
    }
    var rdp: i64 = 8 + ((h >> 2) & 7);
    var r1p: i64 = 8 + ((h >> 7) & 7);
    var offw: i64 = (((h >> 10) & 7) << 3) | (((h >> 6) & 1) << 2) | (((h >> 5) & 1) << 6);
    var offd: i64 = (((h >> 10) & 7) << 3) | (((h >> 5) & 3) << 6);
    if q == 0 {
        if f3 == 0 {
            var nz: i64 = (((h >> 11) & 3) << 4) | (((h >> 7) & 15) << 6) | (((h >> 6) & 1) << 2) | (((h >> 5) & 1) << 3);
            if nz == 0 {
                return 0 - 1;
            }
            return nat_rvc_i(nz, 2, 0, rdp, 0x13);
        }
        if f3 == 1 {
            return nat_rvc_i(offd, r1p, 3, rdp, 0x07);
        }
        if f3 == 2 {
            return nat_rvc_i(offw, r1p, 2, rdp, 0x03);
        }
        if f3 == 3 {
            return nat_rvc_i(offd, r1p, 3, rdp, 0x03);
        }
        if f3 == 5 {
            return nat_rvc_s(offd, rdp, r1p, 3, 0x27);
        }
        if f3 == 6 {
            return nat_rvc_s(offw, rdp, r1p, 2, 0x23);
        }
        if f3 == 7 {
            return nat_rvc_s(offd, rdp, r1p, 3, 0x23);
        }
        return 0 - 1;
    }
    var rd: i64 = (h >> 7) & 31;
    var r2: i64 = (h >> 2) & 31;
    var imm6: i64 = (((h >> 12) & 1) << 5) | ((h >> 2) & 31);
    var simm6: i64 = imm6;
    if simm6 >= 32 {
        simm6 = simm6 - 64;
    }
    if q == 1 {
        if f3 == 0 {
            return nat_rvc_i(simm6, rd, 0, rd, 0x13);
        }
        if f3 == 1 {
            if rd == 0 {
                return 0 - 1;
            }
            return nat_rvc_i(simm6, rd, 0, rd, 0x1B);
        }
        if f3 == 2 {
            return nat_rvc_i(simm6, 0, 0, rd, 0x13);
        }
        if f3 == 3 {
            if rd == 2 {
                var n16: i64 = (((h >> 12) & 1) << 9) | (((h >> 6) & 1) << 4) | (((h >> 5) & 1) << 6) | (((h >> 3) & 3) << 7) | (((h >> 2) & 1) << 5);
                if n16 >= 512 {
                    n16 = n16 - 1024;
                }
                if n16 == 0 {
                    return 0 - 1;
                }
                return nat_rvc_i(n16, 2, 0, 2, 0x13);
            }
            if imm6 == 0 {
                return 0 - 1;
            }
            return ((simm6 & 0xFFFFF) << 12) | (rd << 7) | 0x37;
        }
        if f3 == 4 {
            var f2: i64 = (h >> 10) & 3;
            if f2 == 0 {
                return nat_rvc_i(imm6, r1p, 5, r1p, 0x13);
            }
            if f2 == 1 {
                return nat_rvc_i(0x400 | imm6, r1p, 5, r1p, 0x13);
            }
            if f2 == 2 {
                return nat_rvc_i(simm6, r1p, 7, r1p, 0x13);
            }
            var fn2: i64 = (h >> 5) & 3;
            if ((h >> 12) & 1) == 0 {
                if fn2 == 0 {
                    return nat_rvc_r(0x20, rdp, r1p, 0, r1p, 0x33);
                }
                if fn2 == 1 {
                    return nat_rvc_r(0, rdp, r1p, 4, r1p, 0x33);
                }
                if fn2 == 2 {
                    return nat_rvc_r(0, rdp, r1p, 6, r1p, 0x33);
                }
                return nat_rvc_r(0, rdp, r1p, 7, r1p, 0x33);
            }
            if fn2 == 0 {
                return nat_rvc_r(0x20, rdp, r1p, 0, r1p, 0x3B);
            }
            if fn2 == 1 {
                return nat_rvc_r(0, rdp, r1p, 0, r1p, 0x3B);
            }
            return 0 - 1;
        }
        if f3 == 5 {
            var jo: i64 = (((h >> 12) & 1) << 11) | (((h >> 11) & 1) << 4) | (((h >> 9) & 3) << 8) | (((h >> 8) & 1) << 10) | (((h >> 7) & 1) << 6) | (((h >> 6) & 1) << 7) | (((h >> 3) & 7) << 1) | (((h >> 2) & 1) << 5);
            if jo >= 2048 {
                jo = jo - 4096;
            }
            return nat_rv_j_bits(jo) | 0x6F;
        }
        var bo: i64 = (((h >> 12) & 1) << 8) | (((h >> 10) & 3) << 3) | (((h >> 5) & 3) << 6) | (((h >> 3) & 3) << 1) | (((h >> 2) & 1) << 5);
        if bo >= 256 {
            bo = bo - 512;
        }
        var bf3: i64 = 0;
        if f3 == 7 {
            bf3 = 1;
        }
        return nat_rv_b_bits(bo) | (r1p << 15) | (bf3 << 12) | 0x63;
    }
    // quadrant 2
    var odsp: i64 = (((h >> 12) & 1) << 5) | (((h >> 5) & 3) << 3) | (((h >> 2) & 7) << 6);
    var owsp: i64 = (((h >> 12) & 1) << 5) | (((h >> 4) & 7) << 2) | (((h >> 2) & 3) << 6);
    var sdsp: i64 = (((h >> 10) & 7) << 3) | (((h >> 7) & 7) << 6);
    var swsp: i64 = (((h >> 9) & 15) << 2) | (((h >> 7) & 3) << 6);
    if f3 == 0 {
        if rd == 0 || imm6 == 0 {
            return 0 - 1;
        }
        return nat_rvc_i(imm6, rd, 1, rd, 0x13);
    }
    if f3 == 1 {
        return nat_rvc_i(odsp, 2, 3, rd, 0x07);
    }
    if f3 == 2 {
        if rd == 0 {
            return 0 - 1;
        }
        return nat_rvc_i(owsp, 2, 2, rd, 0x03);
    }
    if f3 == 3 {
        if rd == 0 {
            return 0 - 1;
        }
        return nat_rvc_i(odsp, 2, 3, rd, 0x03);
    }
    if f3 == 4 {
        if ((h >> 12) & 1) == 0 {
            if r2 == 0 {
                if rd == 0 {
                    return 0 - 1;
                }
                return nat_rvc_i(0, rd, 0, 0, 0x67);
                // c.jr
            }
            return nat_rvc_r(0, r2, 0, 0, rd, 0x33);
            // c.mv
        }
        if rd == 0 && r2 == 0 {
            return 0x00100073;
            // c.ebreak
        }
        if r2 == 0 {
            return nat_rvc_i(0, rd, 0, 1, 0x67);
            // c.jalr
        }
        return nat_rvc_r(0, r2, rd, 0, rd, 0x33);
        // c.add
    }
    if f3 == 5 {
        return nat_rvc_s(sdsp, r2, 2, 3, 0x27);
    }
    if f3 == 6 {
        return nat_rvc_s(swsp, r2, 2, 2, 0x23);
    }
    return nat_rvc_s(sdsp, r2, 2, 3, 0x23);
}

/// TG9: where nat_rvc_compress moved each old 4-byte unit of the code:
/// `units` holds the new offset of old offset 4k at k, and the code's new
/// end at the last index; offsets from `old_end` on move by
/// new_end - old_end. Counts: the instructions looked at, those made 2
/// bytes, the 2-byte paddings put before data.
pub struct NatRvcMap {
    pub units: Vec<i64>,
    pub old_end: i64,
    pub new_end: i64,
    pub n_insn: i64,
    pub n_short: i64,
    pub n_pad: i64,
}

pub fn NatRvcMap_new() -> NatRvcMap {
    return NatRvcMap {
        units: Vec::new(), old_end: 0, new_end: 0, n_insn: 0, n_short: 0, n_pad: 0
    };
}

/// TG9: the new offset of old image offset `pos` (negative: unchanged).
pub fn nat_rvc_pos(m: & NatRvcMap, pos: i64) -> i64 {
    if pos < 0 || m.units.len() == 0 {
        return pos;
    }
    if pos >= m.old_end {
        return pos - m.old_end + m.new_end;
    }
    var u: i64 = pos / 4;
    var at: i64 = m.units.get(u);
    var rest: i64 = pos - u * 4;
    var size: i64 = m.units.get(u + 1) - at;
    if rest >= size {
        return m.units.get(u + 1);
    }
    return at + rest;
}

// The kinds of 4-byte units nat_rvc_compress tells apart
const RVC_PLAIN: i64 = 0;  // an instruction that may take its 2-byte form
const RVC_KEEP: i64 = 1;  // an instruction kept at 4 bytes as it is
const RVC_DATA: i64 = 2;  // a data word (a jump-table entry): 4-aligned
const RVC_PCREL: i64 = 3;  // a branch or JAL by a constant offset: moved
const RVC_RAW: i64 = 4;  // the asm! thunks: copied, their start 4-aligned

fn nat_rvc_word(e: & NatEnc, pos: i64) -> i64 {
    return e.code.get(pos) | (e.code.get(pos + 1) << 8) | (e.code.get(pos + 2) << 16) | (e.code.get(pos + 3) << 24);
}

/// TG9: compress the RISC-V code [0, end) of `e` (end: the code's end,
/// before any data is laid out; labels after it are not placed yet).
/// `starts`: the functions' start offsets (a framed function's 4-word
/// prologue is kept, see nat_has_frame); [op_lo, op_hi): the asm! thunks
/// (empty when op_hi <= op_lo). Fills `m` and returns "" when the code was
/// compressed; otherwise the reason, and `e` is as it was: the pass first
/// lays everything out and checks that every branch still reaches (a
/// distance can grow by 2 bytes where data is re-aligned), then rewrites.
@wrapping pub fn nat_rvc_compress(e: & mut NatEnc, end: i64, starts: & Vec<i64>, op_lo: i64, op_hi: i64, m: & mut NatRvcMap) -> str {
    if end <= 0 || end > e.code.len() || (end & 3) != 0 {
        return "the code does not end on a 4-byte boundary";
    }
    if op_hi > op_lo && ((op_lo & 3) != 0 || (op_hi & 3) != 0 || op_hi > end) {
        return "the asm! thunks are not whole words";
    }
    var n: i64 = end / 4;
    var flag: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < n {
        flag.push(RVC_PLAIN);
        k = k + 1;
    }
    // what the fixups say
    var i: i64 = 0;
    while i < e.fixups.len() {
        var f: NatFix = e.fixups.get(i);
        if f.pos < end {
            if (f.pos & 3) != 0 {
                return "a fixup inside a word at offset " + int_to_str(f.pos);
            }
            var u: i64 = f.pos / 4;
            if f.kind == NATFIX_SELF32 {
                flag.set(u, RVC_DATA);
            } else if f.kind == NATFIX_RV_B12 || f.kind == NATFIX_RV_JAL {
                flag.set(u, RVC_KEEP);
            } else if f.kind == NATFIX_RV_AUIPC_I {
                flag.set(u, RVC_KEEP);
                if u + 1 < n {
                    flag.set(u + 1, RVC_KEEP);
                }
            } else {
                return "a fixup of kind " + int_to_str(f.kind) + " in the code";
            }
        }
        i = i + 1;
    }
    if op_hi > op_lo {
        k = op_lo / 4;
        while k < op_hi / 4 {
            flag.set(k, RVC_RAW);
            k = k + 1;
        }
    }
    // each framed function's prologue (addi sp, sp, -16; sd ra, 8(sp);
    // sd s0, 0(sp); addi s0, sp, 16) stays as nat_has_frame reads it
    i = 0;
    while i < starts.len() {
        var s: i64 = starts.get(i);
        if s >= 0 && (s & 3) == 0 && s + 16 <= end && nat_rvc_word(e, s) == 0xFF010113 {
            k = s / 4;
            while k < s / 4 + 4 {
                if flag.get(k) == RVC_PLAIN {
                    flag.set(k, RVC_KEEP);
                }
                k = k + 1;
            }
        }
        i = i + 1;
    }
    // the rest by its opcode
    k = 0;
    while k < n {
        if flag.get(k) == RVC_PLAIN {
            var w: i64 = nat_rvc_word(e, k * 4);
            var op: i64 = w & 0x7F;
            if (w & 3) != 3 {
                // not a 32-bit instruction (zeros): left as it is
                flag.set(k, RVC_KEEP);
            } else if op == 0x63 || op == 0x6F {
                flag.set(k, RVC_PCREL);
            } else if op == 0x17 {
                return "an AUIPC without a fixup at offset " + int_to_str(k * 4);
            }
        }
        k = k + 1;
    }
    // the layout
    var cform: Vec<i64> = Vec::new();
    m.units = Vec::new();
    m.n_insn = 0;
    m.n_short = 0;
    m.n_pad = 0;
    var np: i64 = 0;
    k = 0;
    while k < n {
        var fk: i64 = flag.get(k);
        var starts_raw: bool = false;
        if fk == RVC_RAW {
            starts_raw = true;
            if k > 0 {
                starts_raw = flag.get(k - 1) != RVC_RAW;
            }
        }
        if (fk == RVC_DATA || starts_raw) && (np & 3) != 0 {
            np = np + 2;
            m.n_pad = m.n_pad + 1;
        }
        m.units.push(np);
        var c: i64 = 0 - 1;
        if fk == RVC_PLAIN || fk == RVC_KEEP || fk == RVC_PCREL {
            m.n_insn = m.n_insn + 1;
        }
        if fk == RVC_PLAIN {
            c = nat_rvc_of(nat_rvc_word(e, k * 4));
        }
        cform.push(c);
        if c >= 0 {
            np = np + 2;
            m.n_short = m.n_short + 1;
        } else {
            np = np + 4;
        }
        k = k + 1;
    }
    m.units.push(np);
    m.old_end = end;
    m.new_end = np;
    // every branch must still reach
    i = 0;
    while i < e.fixups.len() {
        var f2: NatFix = e.fixups.get(i);
        if f2.pos < end && (f2.kind == NATFIX_RV_B12 || f2.kind == NATFIX_RV_JAL) {
            var t: i64 = e.labels.get(f2.label);
            if t >= 0 {
                var d: i64 = nat_rvc_pos(m, t) - nat_rvc_pos(m, f2.pos);
                if f2.kind == NATFIX_RV_B12 && (d < 0 - 4096 || d > 4094) {
                    return "a short branch would leave its reach at offset " + int_to_str(f2.pos);
                }
                if f2.kind == NATFIX_RV_JAL && (d < 0 - 1048576 || d >= 1048576) {
                    return "a jump would leave its reach at offset " + int_to_str(f2.pos);
                }
            }
        }
        i = i + 1;
    }
    var moved: Vec<i64> = Vec::new();
    k = 0;
    while k < n {
        var nw: i64 = 0;
        if flag.get(k) == RVC_PCREL {
            var w2: i64 = nat_rvc_word(e, k * 4);
            var jal: bool = (w2 & 0x7F) == 0x6F;
            var off: i64 = 0;
            if jal {
                off = nat_rv_j_off_of(w2);
            } else {
                off = nat_rv_b_off_of(w2);
            }
            var tgt: i64 = k * 4 + off;
            if tgt < 0 || tgt > end || (tgt & 3) != 0 {
                return "a branch by a constant offset to " + int_to_str(tgt) + " at offset " + int_to_str(k * 4);
            }
            var nd: i64 = nat_rvc_pos(m, tgt) - m.units.get(k);
            if jal {
                if nd < 0 - 1048576 || nd >= 1048576 {
                    return "a jump by a constant offset would leave its reach at offset " + int_to_str(k * 4);
                }
                nw = (w2 & 0xFFF) | nat_rv_j_bits(nd);
            } else {
                if nd < 0 - 4096 || nd > 4094 {
                    return "a branch by a constant offset would leave its reach at offset " + int_to_str(k * 4);
                }
                nw = (w2 & 0x01FFF07F) | nat_rv_b_bits(nd);
            }
        }
        moved.push(nw);
        k = k + 1;
    }
    // the rewrite
    var code: Vec<i64> = Vec::new();
    k = 0;
    while k < n {
        while code.len() < m.units.get(k) {
            // c.nop, never reached (data or a thunk follows)
            code.push(0x01);
            code.push(0x00);
        }
        var fk2: i64 = flag.get(k);
        var cw: i64 = cform.get(k);
        if cw >= 0 {
            code.push(cw & 0xFF);
            code.push((cw >> 8) & 0xFF);
        } else {
            var ww: i64 = nat_rvc_word(e, k * 4);
            if fk2 == RVC_PCREL {
                ww = moved.get(k);
            }
            code.push(ww & 0xFF);
            code.push((ww >> 8) & 0xFF);
            code.push((ww >> 16) & 0xFF);
            code.push((ww >> 24) & 0xFF);
        }
        k = k + 1;
    }
    var rest: i64 = end;
    while rest < e.code.len() {
        code.push(e.code.get(rest));
        rest = rest + 1;
    }
    e.code = code;
    i = 0;
    while i < e.labels.len() {
        var lv: i64 = e.labels.get(i);
        if lv >= 0 {
            e.labels.set(i, nat_rvc_pos(m, lv));
        }
        i = i + 1;
    }
    i = 0;
    while i < e.fixups.len() {
        var fx: NatFix = e.fixups.get(i);
        e.fixups.set(i, NatFix {
            pos: nat_rvc_pos(m, fx.pos), label: fx.label, kind: fx.kind
        });
        i = i + 1;
    }
    if e.last_place >= 0 {
        e.last_place = nat_rvc_pos(m, e.last_place);
    }
    e.mul_end = 0 - 1;
    g_nat_rvc = true;
    return "";
}

// --- TG9: the checks of tests/nattools/rvc_unit.fd ---------------------------

@wrapping fn nat_rvc_hex(v: i64) -> str {
    var digits: str = "0123456789abcdef";
    var out: str = "";
    var i: i64 = 7;
    while i >= 0 {
        var d: i64 = (v >> (i * 4)) & 15;
        out = out + str_slice(digits, d, d + 1);
        i = i - 1;
    }
    return "0x" + out;
}

fn nat_rvc_known(w: i64, want: i64, what: str) -> str {
    var got: i64 = nat_rvc_of(w);
    if got != want {
        return what + " (" + nat_rvc_hex(w) + "): " + nat_rvc_hex(got) + ", want " + nat_rvc_hex(want);
    }
    return "";
}

fn nat_rvc_bytes(w: i64) -> Vec<i64> {
    var b: Vec<i64> = Vec::new();
    b.push(w & 0xFF);
    b.push((w >> 8) & 0xFF);
    b.push((w >> 16) & 0xFF);
    b.push((w >> 24) & 0xFF);
    return b;
}

/// TG9: `w` (a word nat_rvc_of compressed to `c`) and the expansion `x`
/// of c do the same: the same word for memory, jumps and LUI; for the
/// operations, the same registers after each on random register files
/// (nat_enc's RISC-V simulator, nsr_exec).
@wrapping fn nat_rvc_same(w: i64, x: i64, seed: i64) -> str {
    var op: i64 = w & 0x7F;
    if op != 0x13 && op != 0x1B && op != 0x33 && op != 0x3B {
        if x != w {
            return "the expansion " + nat_rvc_hex(x) + " of " + nat_rvc_hex(w) + " differs";
        }
        return "";
    }
    var s: i64 = seed;
    var t: i64 = 0;
    while t < 3 {
        var ra: Vec<i64> = Vec::new();
        var rb: Vec<i64> = Vec::new();
        var r: i64 = 0;
        while r < 32 {
            s = s * 6364136223846793005 + 1442695040888963407;
            var v: i64 = s >> 7;
            if t == 1 {
                v = v & 0xFF;
            }
            ra.push(v);
            rb.push(v);
            r = r + 1;
        }
        var ca: Vec<i64> = nat_rvc_bytes(w);
        var cb: Vec<i64> = nat_rvc_bytes(x);
        var ea: str = nsel_exec(NAT_RV64, & ca, & mut ra);
        var eb: str = nsel_exec(NAT_RV64, & cb, & mut rb);
        if ea != "" || eb != "" {
            return "simulating " + nat_rvc_hex(w) + " / " + nat_rvc_hex(x) + ": " + ea + eb;
        }
        r = 1;
        while r < 32 {
            if ra.get(r) != rb.get(r) {
                return nat_rvc_hex(w) + " and its expansion " + nat_rvc_hex(x) + " differ in x" + int_to_str(r);
            }
            r = r + 1;
        }
        t = t + 1;
    }
    return "";
}

/// TG9: one word through nat_rvc_of and back (nat_rvc_expand); counts the
/// words compressed in n[0].
fn nat_rvc_trip(w: i64, n: & mut Vec<i64>) -> str {
    var c: i64 = nat_rvc_of(w);
    if c < 0 {
        return "";
    }
    n.set(0, n.get(0) + 1);
    if c == 0 || c > 0xFFFF || (c & 3) == 3 {
        return nat_rvc_hex(w) + ": not a 2-byte form " + nat_rvc_hex(c);
    }
    var x: i64 = nat_rvc_expand(c);
    if x < 0 {
        return nat_rvc_hex(w) + ": its form " + nat_rvc_hex(c) + " does not expand";
    }
    if nat_rvc_of(x) != c {
        return nat_rvc_hex(w) + ": " + nat_rvc_hex(c) + " expands to " + nat_rvc_hex(x) + ", which compresses to " + nat_rvc_hex(nat_rvc_of(x));
    }
    return nat_rvc_same(w, x, w * 31 + 7);
}

/// TG9: the positions of a compressed stream, decoded from its start: each
/// instruction 2 bytes when its low bits are not 11, else 4. "" when every
/// offset of `want` is an instruction start and the stream ends at `end`.
fn nat_rvc_stream(code: & Vec<i64>, end: i64, want: & Vec<i64>) -> str {
    var at: i64 = HashMap_new();
    var p: i64 = 0;
    while p < end {
        HashMap_insert(at, int_to_str(p), 1);
        if (code.get(p) & 3) != 3 {
            p = p + 2;
        } else {
            p = p + 4;
        }
    }
    if p != end {
        return "the compressed stream runs past its end (" + int_to_str(p) + " for " + int_to_str(end) + ")";
    }
    var i: i64 = 0;
    while i < want.len() {
        if !HashMap_contains(at, int_to_str(want.get(i))) {
            return "offset " + int_to_str(want.get(i)) + " is not an instruction start";
        }
        i = i + 1;
    }
    return "";
}

/// TG9: the checks of tests/nattools/rvc_unit.fd: "" or the first failure.
/// (a) forms whose 2-byte encoding assemblers print (objdump of rv64gc
/// code), and words kept at 4 bytes; (b) many words of every compressible
/// shape through nat_rvc_of and nat_rvc_expand and back, the operations
/// simulated; (c) a laid-out function compressed (nat_rvc_compress) and
/// resolved: the prologue kept, branches by a fixup and by a constant
/// offset, an AUIPC pair and a jump-table entry all reach their moved
/// targets, the entry 4-aligned; (d) the code left as it was when a fixup
/// it cannot move sits in it, or when a short branch would leave its reach.
@wrapping pub fn nat_rvc_unit_check() -> str {
    var err: str = "";
    // (a)
    var kw: Vec<i64> = Vec::new();
    var kc: Vec<i64> = Vec::new();
    var kn: Vec<str> = Vec::new();
    kw.push(nat_rvc_i(0 - 16, 2, 0, 2, 0x13)); kc.push(0x1141); kn.push("addi sp, sp, -16");
    kw.push(nat_rvc_s(8, 1, 2, 3, 0x23)); kc.push(0xE406); kn.push("sd ra, 8(sp)");
    kw.push(nat_rvc_s(0, 8, 2, 3, 0x23)); kc.push(0xE022); kn.push("sd s0, 0(sp)");
    kw.push(nat_rvc_i(16, 2, 0, 8, 0x13)); kc.push(0x0800); kn.push("addi s0, sp, 16");
    kw.push(nat_rvc_i(8, 2, 3, 1, 0x03)); kc.push(0x60A2); kn.push("ld ra, 8(sp)");
    kw.push(nat_rvc_i(0, 2, 3, 8, 0x03)); kc.push(0x6402); kn.push("ld s0, 0(sp)");
    kw.push(nat_rvc_i(16, 2, 0, 2, 0x13)); kc.push(0x0141); kn.push("addi sp, sp, 16");
    kw.push(nat_rvc_i(0, 1, 0, 0, 0x67)); kc.push(0x8082); kn.push("ret");
    kw.push(nat_rvc_i(0, 0, 0, 10, 0x13)); kc.push(0x4501); kn.push("li a0, 0");
    kw.push(nat_rvc_i(0, 11, 0, 10, 0x13)); kc.push(0x852E); kn.push("mv a0, a1");
    kw.push(nat_rvc_r(0, 11, 10, 0, 10, 0x33)); kc.push(0x952E); kn.push("add a0, a0, a1");
    kw.push(nat_rvc_i(0, 0, 0, 0, 0x13)); kc.push(0x0001); kn.push("nop");
    kw.push(nat_rvc_i(0, 15, 0, 15, 0x1B)); kc.push(0x2781); kn.push("sext.w a5, a5");
    kw.push(nat_rvc_r(0, 14, 15, 0, 15, 0x3B)); kc.push(0x9FB9); kn.push("addw a5, a5, a4");
    kw.push(nat_rvc_r(0x20, 14, 15, 0, 15, 0x33)); kc.push(0x8F99); kn.push("sub a5, a5, a4");
    kw.push(nat_rvc_i(3, 15, 1, 15, 0x13)); kc.push(0x078E); kn.push("slli a5, a5, 3");
    kw.push(nat_rvc_i(32, 15, 5, 15, 0x13)); kc.push(0x9381); kn.push("srli a5, a5, 32");
    kw.push(nat_rvc_i(1, 15, 7, 15, 0x13)); kc.push(0x8B85); kn.push("andi a5, a5, 1");
    kw.push(nat_rvc_i(0, 15, 3, 15, 0x03)); kc.push(0x639C); kn.push("ld a5, 0(a5)");
    kw.push(nat_rvc_i(0, 2, 3, 15, 0x03)); kc.push(0x6782); kn.push("ld a5, 0(sp)");
    kw.push(nat_rvc_s(0, 15, 2, 2, 0x23)); kc.push(0xC03E); kn.push("sw a5, 0(sp)");
    kw.push((0x10 << 12) | (15 << 7) | 0x37); kc.push(0x67C1); kn.push("lui a5, 0x10");
    kw.push(nat_rvc_i(0 - 32, 2, 0, 2, 0x13)); kc.push(0x1101); kn.push("addi sp, sp, -32");
    kw.push(nat_rvc_i(0 - 48, 2, 0, 2, 0x13)); kc.push(0x7179); kn.push("addi sp, sp, -48");
    kw.push(nat_rvc_i(8, 2, 0, 10, 0x13)); kc.push(0x0028); kn.push("addi a0, sp, 8");
    kw.push(nat_rvc_i(0, 9, 0, 10, 0x13)); kc.push(0x8526); kn.push("mv a0, s1");
    kw.push(nat_rvc_i(0, 15, 0, 0, 0x67)); kc.push(0x8782); kn.push("jr a5");
    // kept at 4 bytes
    kw.push(nat_rvc_i(0, 15, 0, 1, 0x67)); kc.push(0 - 1); kn.push("jalr ra, 0(a5) (a call)");
    kw.push(nat_rvc_r(0, 12, 11, 0, 10, 0x33)); kc.push(0 - 1); kn.push("add a0, a1, a2");
    kw.push(nat_rvc_i(5, 11, 0, 10, 0x13)); kc.push(0 - 1); kn.push("addi a0, a1, 5");
    kw.push(nat_rvc_i(256, 8, 3, 10, 0x03)); kc.push(0 - 1); kn.push("ld a0, 256(s0)");
    kw.push(nat_rvc_i(0, 8, 6, 10, 0x03)); kc.push(0 - 1); kn.push("lwu a0, 0(s0)");
    kw.push(nat_rvc_i(0, 10, 1, 10, 0x13)); kc.push(0 - 1); kn.push("slli a0, a0, 0");
    kw.push(0x00100073); kc.push(0 - 1); kn.push("ebreak");
    kw.push(0x00000073); kc.push(0 - 1); kn.push("ecall");
    kw.push(0x00000297); kc.push(0 - 1); kn.push("auipc t0, 0");
    kw.push(nat_rv_b_bits(8) | (10 << 15) | 0x63); kc.push(0 - 1); kn.push("beqz a0, .+8");
    kw.push(nat_rv_j_bits(8) | 0x6F); kc.push(0 - 1); kn.push("j .+8");
    kw.push((2 << 12) | (2 << 7) | 0x37); kc.push(0 - 1); kn.push("lui sp, 2");
    kw.push(0); kc.push(0 - 1); kn.push("zero padding");
    var ki: i64 = 0;
    while ki < kw.len() {
        err = nat_rvc_known(kw.get(ki), kc.get(ki), kn.get(ki));
        if err != "" {
            return err;
        }
        ki = ki + 1;
    }
    // (b)
    var regs: Vec<i64> = Vec::new();
    regs.push(0); regs.push(1); regs.push(2); regs.push(5); regs.push(8); regs.push(9); regs.push(10); regs.push(15); regs.push(16); regs.push(31);
    var imms: Vec<i64> = Vec::new();
    imms.push(0 - 2048); imms.push(0 - 528); imms.push(0 - 512); imms.push(0 - 48); imms.push(0 - 33); imms.push(0 - 32); imms.push(0 - 16); imms.push(0 - 1);
    imms.push(0); imms.push(1); imms.push(4); imms.push(5); imms.push(8); imms.push(16); imms.push(31); imms.push(32); imms.push(63); imms.push(64);
    imms.push(120); imms.push(124); imms.push(128); imms.push(248); imms.push(252); imms.push(256); imms.push(496); imms.push(504); imms.push(508);
    imms.push(512); imms.push(1020); imms.push(1024); imms.push(2047);
    var cnt: Vec<i64> = Vec::new();
    cnt.push(0);
    var a: i64 = 0;
    while a < regs.len() {
        var rd: i64 = regs.get(a);
        var b: i64 = 0;
        while b < regs.len() {
            var rs: i64 = regs.get(b);
            var ii: i64 = 0;
            while ii < imms.len() {
                var im: i64 = imms.get(ii);
                var ws: Vec<i64> = Vec::new();
                ws.push(nat_rvc_i(im, rs, 0, rd, 0x13));
                ws.push(nat_rvc_i(im, rs, 0, rd, 0x1B));
                ws.push(nat_rvc_i(im, rs, 7, rd, 0x13));
                ws.push(nat_rvc_i(im & 63, rs, 1, rd, 0x13));
                ws.push(nat_rvc_i(im & 63, rs, 5, rd, 0x13));
                ws.push(nat_rvc_i(0x400 | (im & 63), rs, 5, rd, 0x13));
                ws.push(((im & 0xFFFFF) << 12) | (rd << 7) | 0x37);
                ws.push(nat_rvc_i(im, rs, 3, rd, 0x03));
                ws.push(nat_rvc_i(im, rs, 2, rd, 0x03));
                ws.push(nat_rvc_i(im, rs, 3, rd, 0x07));
                ws.push(nat_rvc_s(im, rd, rs, 3, 0x23));
                ws.push(nat_rvc_s(im, rd, rs, 2, 0x23));
                ws.push(nat_rvc_s(im, rd, rs, 3, 0x27));
                ws.push(nat_rvc_i(im, rs, 0, rd, 0x67));
                var wi: i64 = 0;
                while wi < ws.len() {
                    err = nat_rvc_trip(ws.get(wi), & mut cnt);
                    if err != "" {
                        return err;
                    }
                    wi = wi + 1;
                }
                ii = ii + 1;
            }
            var c2: i64 = 0;
            while c2 < regs.len() {
                var r2: i64 = regs.get(c2);
                var rr: Vec<i64> = Vec::new();
                rr.push(nat_rvc_r(0, r2, rs, 0, rd, 0x33));
                rr.push(nat_rvc_r(0x20, r2, rs, 0, rd, 0x33));
                rr.push(nat_rvc_r(0, r2, rs, 4, rd, 0x33));
                rr.push(nat_rvc_r(0, r2, rs, 6, rd, 0x33));
                rr.push(nat_rvc_r(0, r2, rs, 7, rd, 0x33));
                rr.push(nat_rvc_r(0, r2, rs, 0, rd, 0x3B));
                rr.push(nat_rvc_r(0x20, r2, rs, 0, rd, 0x3B));
                rr.push(nat_rvc_r(1, r2, rs, 0, rd, 0x33));
                var ri: i64 = 0;
                while ri < rr.len() {
                    err = nat_rvc_trip(rr.get(ri), & mut cnt);
                    if err != "" {
                        return err;
                    }
                    ri = ri + 1;
                }
                c2 = c2 + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    if cnt.get(0) < 1000 {
        return "only " + int_to_str(cnt.get(0)) + " words compressed in (b)";
    }
    // (c) a function laid out as nat_ir lays one out
    var e: NatEnc = NatEnc_new();
    var l_fn: i64 = NatEnc_label(& mut e);
    var l_out: i64 = NatEnc_label(& mut e);
    var l_tab: i64 = NatEnc_label(& mut e);
    NatEnc_place(& mut e, l_fn);
    rv_addi(& mut e, RV_SP, RV_SP, 0 - 16);
    rv_store(& mut e, RV_RA, RV_SP, 8, 8);
    rv_store(& mut e, RV_S0, RV_SP, 0, 8);
    rv_addi(& mut e, RV_S0, RV_SP, 16);
    rv_addi(& mut e, 10, 10, 1);              // 16: c.addi
    var p_cb: i64 = NatEnc_pos(& e);
    rv_b_off(& mut e, RV_BEQ, 10, RV_ZERO, 12);  // 20: over the next two
    rv_add(& mut e, 11, 11, 10);              // 24: c.add
    rv_mv(& mut e, 12, 13);                   // 28: c.mv
    var p_cb_to: i64 = NatEnc_pos(& e);
    var p_b12: i64 = NatEnc_pos(& e);
    rv_b_label(& mut e, RV_BNE, 10, 11, l_out); // 32: kept
    rv_add(& mut e, 10, 11, 12);              // 36: kept (no form)
    var p_jal: i64 = NatEnc_pos(& e);
    rv_jal(& mut e, RV_ZERO, l_out);          // 40: kept
    var p_auipc: i64 = NatEnc_pos(& e);
    rv_addr(& mut e, RV_T0, l_tab);           // 44, 48: kept
    rv_addi(& mut e, 10, 10, 2);              // 52: c.addi, so the table needs padding
    rv_jalr(& mut e, RV_ZERO, RV_T0, 0);      // 56: c.jr
    NatEnc_place(& mut e, l_tab);
    var p_tab: i64 = NatEnc_pos(& e);
    NatEnc_fix(& mut e, l_out, NATFIX_SELF32);
    NatEnc_word(& mut e, 0);                  // 60: data
    NatEnc_place(& mut e, l_out);
    rv_load(& mut e, RV_RA, RV_SP, 8, 8, true); // 64: c.ldsp
    rv_load(& mut e, RV_S0, RV_SP, 0, 8, true); // 68: c.ldsp
    rv_addi(& mut e, RV_SP, RV_SP, 16);       // 72: c.addi
    rv_ret(& mut e);                          // 76: c.jr ra
    var end: i64 = NatEnc_pos(& e);
    var before: Vec<i64> = e.code;
    var starts: Vec<i64> = Vec::new();
    starts.push(0);
    var m: NatRvcMap = NatRvcMap_new();
    err = nat_rvc_compress(& mut e, end, & starts, 0, 0, & mut m);
    if err != "" {
        return "(c) not compressed: " + err;
    }
    // 16..: c.addi 16, beq 18, c.add 22, c.mv 24, bne 26, add 30, jal 34,
    // auipc 38, addi 42, c.addi 46, c.jr 48, pad 50, table 52, 56.. 2 each
    if m.new_end != 64 || m.n_short != 9 || m.n_pad != 1 {
        return "(c) the layout: end " + int_to_str(m.new_end) + ", " + int_to_str(m.n_short) + " short, " + int_to_str(m.n_pad) + " paddings (want 64, 9, 1)";
    }
    var k: i64 = 0;
    while k < 16 {
        if e.code.get(k) != before.get(k) {
            return "(c) the prologue changed at byte " + int_to_str(k);
        }
        k = k + 1;
    }
    err = NatEnc_resolve(& mut e);
    if err != "" {
        return "(c) resolve: " + err;
    }
    var want: Vec<i64> = Vec::new();
    want.push(16);
    want.push(nat_rvc_pos(& m, p_cb));
    want.push(nat_rvc_pos(& m, p_cb_to));
    want.push(nat_rvc_pos(& m, p_b12));
    want.push(nat_rvc_pos(& m, p_jal));
    want.push(nat_rvc_pos(& m, p_auipc));
    err = nat_rvc_stream(& e.code, 52, & want);
    if err != "" {
        return "(c) " + err;
    }
    var out_at: i64 = e.labels.get(l_out);
    var tab_at: i64 = e.labels.get(l_tab);
    if tab_at != 52 || (tab_at & 3) != 0 || out_at != 56 {
        return "(c) the table at " + int_to_str(tab_at) + ", the exit at " + int_to_str(out_at) + " (want 52, 56)";
    }
    var npc: i64 = nat_rvc_pos(& m, p_cb);
    if npc + nat_rv_b_off_of(nat_rvc_word(& e, npc)) != nat_rvc_pos(& m, p_cb_to) {
        return "(c) the branch by a constant offset does not reach its moved target";
    }
    var nb: i64 = nat_rvc_pos(& m, p_b12);
    if nb + nat_rv_b_off_of(nat_rvc_word(& e, nb)) != out_at {
        return "(c) the short branch does not reach its label";
    }
    var nj: i64 = nat_rvc_pos(& m, p_jal);
    if nj + nat_rv_j_off_of(nat_rvc_word(& e, nj)) != out_at {
        return "(c) the jump does not reach its label";
    }
    var na: i64 = nat_rvc_pos(& m, p_auipc);
    var wa: i64 = nat_rvc_word(& e, na);
    var wl: i64 = nat_rvc_word(& e, na + 4);
    var hi: i64 = nsel_sext(wa & 0xFFFFF000, 32);
    var lo: i64 = nsel_sext((wl >> 20) & 0xFFF, 12);
    if na + hi + lo != tab_at {
        return "(c) the AUIPC pair does not name the table";
    }
    if nsel_sext(nat_rvc_word(& e, tab_at), 32) != out_at - tab_at {
        return "(c) the table entry is " + int_to_str(nat_rvc_word(& e, tab_at)) + ", want " + int_to_str(out_at - tab_at);
    }
    // (d) nothing changes when the code holds a word it cannot move ...
    var e2: NatEnc = NatEnc_new();
    var l2: i64 = NatEnc_label(& mut e2);
    NatEnc_place(& mut e2, l2);
    rv_addi(& mut e2, 10, 10, 1);
    NatEnc_fix(& mut e2, l2, NATFIX_ABS64);
    NatEnc_quad(& mut e2, 0);
    rv_ret(& mut e2);
    var c2before: Vec<i64> = e2.code;
    var m2: NatRvcMap = NatRvcMap_new();
    g_nat_rvc = false;
    err = nat_rvc_compress(& mut e2, NatEnc_pos(& e2), & starts, 0, 0, & mut m2);
    if err == "" || g_nat_rvc || e2.code.len() != c2before.len() || e2.code.get(0) != c2before.get(0) {
        return "(d) an absolute word in the code was not refused";
    }
    // ... or when a short branch would leave its reach: one 2-byte
    // instruction, then T (a word without a 2-byte form, at 2 after it), a
    // table entry re-aligned after T (+2 bytes), 1022 words without a
    // 2-byte form, a B<cc> back to T (-4096 before, -4098 after)
    var e3: NatEnc = NatEnc_new();
    var l3: i64 = NatEnc_label(& mut e3);
    rv_addi(& mut e3, 10, 10, 1);
    NatEnc_place(& mut e3, l3);
    rv_add(& mut e3, 10, 11, 12);
    NatEnc_fix(& mut e3, l3, NATFIX_SELF32);
    NatEnc_word(& mut e3, 0);
    k = 0;
    while k < 1022 {
        rv_add(& mut e3, 10, 11, 12);
        k = k + 1;
    }
    rv_b_label(& mut e3, RV_BNE, 10, 11, l3);
    var e3end: i64 = NatEnc_pos(& e3);
    var m3: NatRvcMap = NatRvcMap_new();
    g_nat_rvc = false;
    err = nat_rvc_compress(& mut e3, e3end, & starts, 0, 0, & mut m3);
    if err == "" || g_nat_rvc || e3.code.len() != e3end || e3.labels.get(l3) != 4 {
        return "(d) a short branch pushed out of its reach was not refused";
    }
    err = NatEnc_resolve(& mut e3);
    if err != "" {
        return "(d) the uncompressed code does not resolve: " + err;
    }
    g_nat_rvc = false;
    return "";
}

// ===========================================================================
// ELF: one PT_LOAD segment, the whole file at 0x400000, read/write/execute;
// the image at file offset 0x1000 (NAT_IMAGE_BASE).
// TG14 (g_nat_pie): a position-independent executable instead (ET_DYN, the
// segment at 0, so the image's link address is 0x1000); the kernel maps it
// wherever ASLR puts it and the program's _start adds the load bias to
// every absolute word itself (nat_ir ng_gen_pie_reloc, no dynamic loader).
// ===========================================================================

/// TG14: nat_ir sets it for a position-independent Linux executable.
pub var g_nat_pie: bool = false;

/// TG14: what the driver asked for (main.fd `--pie` 1, `--no-pie` -1); 0:
/// FID_NAT_ON=pie decides (nat_ir nat_pie_wanted).
pub var g_nat_pie_req: i64 = 0;

/// TG14: the image offset where nat_elf's read/write segment starts (a page
/// boundary after the code: nat_ir puts the data there); -1: the whole
/// image in one read/write/execute segment (FID_NAT_OFF=wxsplit).
pub var g_nat_elf_data_off: i64 = 0 - 1;

/// TG14: the page size the split of code and data is aligned to: 64 KB on
/// AArch64 (kernels with 64 KB pages), 4 KB on x86-64 and RISC-V.
pub fn nat_elf_page(arch: i64) -> i64 {
    if arch == NAT_A64 {
        return 0x10000;
    }
    return 0x1000;
}

/// The link address of image offset 0 in the ELF: NAT_IMAGE_BASE, or 0x1000
/// for a position-independent executable.
pub fn nat_elf_image_base() -> i64 {
    if g_nat_pie {
        return 0x1000;
    }
    return NAT_IMAGE_BASE;
}

/// CI2: a dynamically linked executable's program interpreter path and
/// dynamic section, as image offsets and lengths (compiler/nat_ir.fd
/// ng_gen_ldyn lays them out in the image's data and sets these before
/// nat_elf); -1: a static executable.
pub var g_nat_ldyn_interp: i64 = 0 - 1;
pub var g_nat_ldyn_interp_len: i64 = 0;
pub var g_nat_ldyn_dyn: i64 = 0 - 1;
pub var g_nat_ldyn_dyn_len: i64 = 0;

/// A static Linux executable of `image`, entered at image offset `entry`
/// (CI2: dynamically linked when g_nat_ldyn_dyn is set: PT_INTERP and
/// PT_DYNAMIC around the one PT_LOAD).
pub fn nat_elf(arch: i64, image: Vec<i64>, entry: i64) -> Vec<i64> {
    // TG13: a layout over image_writer (nat_elf_img; the old body, checked
    // byte for byte against it on Nov 17, is gone: docs/image-writer.md)
    return nat_elf_img(arch, & image, entry);
}

// ---------------------------------------------------------------------------
// PE32+ (Windows x64): the image at RVA 0x1000 in two sections, .text
// (read/execute, [0, data_off)) and .data (read/write, the rest: strings,
// globals, the imports), ImageBase 0x400000 (so NAT_IMAGE_BASE holds), no
// relocations
// (the image is position-independent but for NATFIX_ABS64, which needs
// the base: RELOCS_STRIPPED, no DYNAMIC_BASE). The import directory and
// the import address table are inside the image (ng_win_imports).
// ---------------------------------------------------------------------------

// TG13: nat_elf and nat_pe as layouts over compiler/image_writer.fd (the
// old bodies were checked byte for byte against them on Nov 17 and are
// gone: docs/image-writer.md).

/// e_machine of the machine layer's targets.
pub fn nat_elf_machine(arch: i64) -> i64 {
    if arch == NAT_A64 {
        return 183;
        // EM_AARCH64
    }
    if arch == NAT_X64 {
        return 62;
        // EM_X86_64
    }
    return 243;
    // EM_RISCV
}

/// e_flags: RISC-V's double-float ABI, else 0. TG9: with EF_RISCV_RVC (1)
/// when the code holds 2-byte instructions (g_nat_rvc).
pub fn nat_elf_flags(arch: i64) -> i64 {
    if arch == NAT_A64 || arch == NAT_X64 {
        return 0;
    }
    if g_nat_rvc {
        return 5;
    }
    return 4;
}

// --- CB9: is a C function in a library the program links? ----------------
// A Linux executable of the machine layer binds its C functions at load
// (CI2, DF_BIND_NOW): a function no library defines would stop it in the
// dynamic linker ("symbol lookup error"), far from the declaration. When
// the libraries are on this machine (FID_NAT_LIBPATH, else the target's
// usual directories), nat_elf_link_missing reads their dynamic symbol
// tables at build time, so the build can report the function as a Fides
// link error with its declaration (main.fd link_error_report).

/// `n` little-endian bytes of `b` at `off` (-1 when out of range).
fn nat_elf_rd(b: & Vec<i64>, off: i64, n: i64) -> i64 {
    if off < 0 || off + n > b.len() {
        return 0 - 1;
    }
    var v: i64 = 0;
    var i: i64 = n - 1;
    while i >= 0 {
        v = (v << 8) | (b.get(off + i) & 255);
        i = i - 1;
    }
    return v;
}

/// Is the NUL-terminated name at `at` (before `end`) in `b` the text `s`?
fn nat_elf_name_is(b: & Vec<i64>, at: i64, end: i64, s: str) -> bool {
    var n: i64 = str_len(s);
    if at < 0 || at + n >= end || end > b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        if b.get(at + i) != str_byte_at(s, i) {
            return false;
        }
        i = i + 1;
    }
    return b.get(at + n) == 0;
}

/// CB9: the e_machine of a 64-bit little-endian ELF shared object (or
/// executable), -1 when `so` is not one (a linker script such as libc.so).
pub fn nat_elf_so_machine(so: & Vec<i64>) -> i64 {
    if so.len() < 64 || so.get(0) != 0x7F || so.get(1) != 0x45 || so.get(2) != 0x4C || so.get(3) != 0x46 || so.get(4) != 2 || so.get(5) != 1 {
        return 0 - 1;
    }
    var ty: i64 = nat_elf_rd(so, 16, 2);
    if ty != 3 && ty != 2 {
        return 0 - 1;
    }
    return nat_elf_rd(so, 18, 2);
}

/// CB9: 1 when the ELF shared object `so` defines `sym` in its dynamic
/// symbol table (a global or weak symbol with a section), 0 when it does
/// not, -1 when it cannot tell (not a 64-bit little-endian ELF, no section
/// headers or no .dynsym).
pub fn nat_elf_dynsym_defines(so: & Vec<i64>, sym: str) -> i64 {
    if nat_elf_so_machine(so) < 0 {
        return 0 - 1;
    }
    var shoff: i64 = nat_elf_rd(so, 0x28, 8);
    var shentsize: i64 = nat_elf_rd(so, 0x3A, 2);
    var shnum: i64 = nat_elf_rd(so, 0x3C, 2);
    if shoff <= 0 || shentsize < 64 || shnum <= 0 || shoff + shnum * shentsize > so.len() {
        return 0 - 1;
    }
    var tabs: i64 = 0;
    var si: i64 = 0;
    while si < shnum {
        var sh: i64 = shoff + si * shentsize;
        // SHT_DYNSYM
        if nat_elf_rd(so, sh + 4, 4) == 11 {
            tabs = tabs + 1;
            var off: i64 = nat_elf_rd(so, sh + 0x18, 8);
            var size: i64 = nat_elf_rd(so, sh + 0x20, 8);
            var link: i64 = nat_elf_rd(so, sh + 0x28, 4);
            var ent: i64 = nat_elf_rd(so, sh + 0x38, 8);
            if ent < 24 {
                ent = 24;
            }
            if link <= 0 || link >= shnum || off < 0 || size < 0 || off + size > so.len() {
                return 0 - 1;
            }
            var strsh: i64 = shoff + link * shentsize;
            var stroff: i64 = nat_elf_rd(so, strsh + 0x18, 8);
            var strsize: i64 = nat_elf_rd(so, strsh + 0x20, 8);
            if stroff < 0 || strsize < 0 || stroff + strsize > so.len() {
                return 0 - 1;
            }
            var k: i64 = off;
            while k + 24 <= off + size {
                var nm: i64 = nat_elf_rd(so, k, 4);
                var shndx: i64 = nat_elf_rd(so, k + 6, 2);
                var bind: i64 = (so.get(k + 4) >> 4) & 15;
                // STB_GLOBAL, STB_WEAK, STB_GNU_UNIQUE; SHN_UNDEF is 0
                if shndx != 0 && (bind == 1 || bind == 2 || bind == 10) && nm > 0 && nm < strsize {
                    if nat_elf_name_is(so, stroff + nm, stroff + strsize, sym) {
                        return 1;
                    }
                }
                k = k + ent;
            }
        }
        si = si + 1;
    }
    if tabs == 0 {
        return 0 - 1;
    }
    return 0;
}

/// CB9: the file names to try for `link "<lib>"` ("" the C library).
fn nat_elf_lib_names(lib: str) -> Vec<str> {
    var v: Vec<str> = Vec::new();
    if lib == "" || lib == "c" {
        v.push("libc.so.6");
        return v;
    }
    if lib == "m" {
        v.push("libm.so.6");
        return v;
    }
    if lib == "pthread" {
        v.push("libpthread.so.0");
        return v;
    }
    if lib == "dl" {
        v.push("libdl.so.2");
        return v;
    }
    if lib == "rt" {
        v.push("librt.so.1");
        return v;
    }
    var base: str = lib;
    if !str_starts_with(base, "lib") {
        base = "lib" + base;
    }
    if str_contains(lib, ".so") {
        v.push(base);
        return v;
    }
    v.push(base + ".so");
    var k: i64 = 0;
    while k <= 9 {
        v.push(base + ".so." + int_to_str(k));
        k = k + 1;
    }
    return v;
}

/// CB9: the directories a Linux library of `arch` is looked for in:
/// FID_NAT_LIBPATH (separated by ';', or ':' when no entry is a Windows
/// path), then the target's usual directories (which exist only on a
/// Linux build machine).
fn nat_elf_lib_dirs(arch: i64) -> Vec<str> {
    var dirs: Vec<str> = Vec::new();
    var lp: str = "";
    match env_var("FID_NAT_LIBPATH") {
        Option::Some(v) => {
            lp = v;
        }
        Option::None => {
        }
    }
    if str_len(lp) > 0 {
        var parts: Vec<str> = str_split(lp, ";");
        var pi: i64 = 0;
        while pi < parts.len() {
            var p: str = parts.get(pi);
            // a Windows path (C:\x, C:/x) is one directory
            var drive: bool = str_len(p) >= 3 && str_byte_at(p, 1) == 58 && (str_byte_at(p, 2) == 47 || str_byte_at(p, 2) == 92);
            if drive || str_contains(p, "\\") || !str_contains(p, ":") {
                if str_len(p) > 0 {
                    dirs.push(p);
                }
            } else {
                var sub: Vec<str> = str_split(p, ":");
                var qi: i64 = 0;
                while qi < sub.len() {
                    if str_len(sub.get(qi)) > 0 {
                        dirs.push(sub.get(qi));
                    }
                    qi = qi + 1;
                }
            }
            pi = pi + 1;
        }
    }
    var multi: str = "x86_64-linux-gnu";
    if arch == NAT_A64 {
        multi = "aarch64-linux-gnu";
    } else if arch == NAT_RV64 {
        multi = "riscv64-linux-gnu";
    }
    dirs.push("/lib/" + multi);
    dirs.push("/usr/lib/" + multi);
    dirs.push("/lib64");
    dirs.push("/usr/lib64");
    dirs.push("/lib");
    dirs.push("/usr/lib");
    dirs.push("/usr/local/lib");
    return dirs;
}

/// CB9: the path of `link "<lib>"`'s shared object for `arch` on this
/// machine (an ELF of that machine), "" when there is none.
pub fn nat_elf_find_lib(lib: str, arch: i64) -> str {
    var names: Vec<str> = nat_elf_lib_names(lib);
    var dirs: Vec<str> = nat_elf_lib_dirs(arch);
    var want: i64 = nat_elf_machine(arch);
    var di: i64 = 0;
    while di < dirs.len() {
        var ni: i64 = 0;
        while ni < names.len() {
            var path: str = dirs.get(di) + "/" + names.get(ni);
            if str_starts_with(names.get(ni), "/") {
                path = names.get(ni);
            }
            if p_file_exists(path) != 0 {
                var b: Vec<i64> = p_file_read_bytes(path);
                if nat_elf_so_machine(& b) == want {
                    return path;
                }
            }
            ni = ni + 1;
        }
        di = di + 1;
    }
    return "";
}

/// CB9: the C functions of `names` (C names) that no library of `libs`
/// (each entry the `link` library of a declaration, "" the C library;
/// repeats are fine) defines, as far as this machine can tell: a name is
/// listed only when every one of those libraries (and the C library) was
/// found and read, and none defines it. Nothing is listed when a library
/// is missing (the dynamic linker reports that by name) or unreadable.
pub fn nat_elf_link_missing(arch: i64, names: & Vec<str>, libs: & Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if names.len() == 0 {
        return out;
    }
    var uniq: Vec<str> = Vec::new();
    uniq.push("");
    var li: i64 = 0;
    while li < libs.len() {
        var l: str = libs.get(li);
        if l == "c" {
            l = "";
        }
        var seen: bool = false;
        var ui: i64 = 0;
        while ui < uniq.len() {
            if uniq.get(ui) == l {
                seen = true;
            }
            ui = ui + 1;
        }
        if !seen {
            uniq.push(l);
        }
        li = li + 1;
    }
    var blobs: Vec<Vec<i64>> = Vec::new();
    var ui2: i64 = 0;
    while ui2 < uniq.len() {
        var path: str = nat_elf_find_lib(uniq.get(ui2), arch);
        if path == "" {
            return out;
        }
        var b: Vec<i64> = p_file_read_bytes(path);
        blobs.push(b);
        ui2 = ui2 + 1;
    }
    var ni: i64 = 0;
    while ni < names.len() {
        var sym: str = names.get(ni);
        var defined: bool = false;
        var known: bool = true;
        var bi: i64 = 0;
        while bi < blobs.len() {
            var bb: Vec<i64> = blobs.get(bi);
            var r: i64 = nat_elf_dynsym_defines(& bb, sym);
            if r == 1 {
                defined = true;
            } else if r < 0 {
                known = false;
            }
            bi = bi + 1;
        }
        if !defined && known {
            out.push(sym);
        }
        ni = ni + 1;
    }
    return out;
}

/// nat_elf's executable: the header, the program headers (PT_INTERP,
/// PT_LOAD of the headers and code, or of everything; TG14 the data's
/// PT_LOAD and PT_GNU_STACK; PT_DYNAMIC), the image at file offset 0x1000.
pub fn nat_elf_img(arch: i64, image: & Vec<i64>, entry: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var base: i64 = nat_elf_image_base();
    var ldyn: bool = g_nat_ldyn_dyn >= 0 && g_nat_ldyn_interp >= 0;
    var dsplit: i64 = g_nat_elf_data_off;
    if dsplit <= 0 || dsplit > image.len() || ((0x1000 + dsplit) & (nat_elf_page(arch) - 1)) != 0 {
        dsplit = 0 - 1;
    }
    var etype: i64 = 2;
    // ET_EXEC, or ET_DYN for a position-independent executable (TG14)
    if g_nat_pie {
        etype = 3;
    }
    var phnum: i64 = 1;
    if ldyn {
        phnum = phnum + 2;
    }
    if dsplit > 0 {
        phnum = phnum + 2;
    }
    // TG14: a position-independent executable with a dynamic loader needs
    // PT_PHDR: glibc's ld.so takes the program's load bias from it (AT_PHDR
    // minus its p_vaddr) and, without one, relocates nothing by the bias
    var phdr_seg: bool = g_nat_pie && ldyn;
    if phdr_seg {
        phnum = phnum + 1;
    }
    img_elf_header(& mut out, etype, nat_elf_machine(arch), base + entry, 64, 0, nat_elf_flags(arch), 56, phnum, 0, 0);
    if phdr_seg {
        // PT_PHDR, read-only: the program headers at file offset 64, inside
        // the first PT_LOAD (which maps file offset 0 at base - 0x1000)
        img_elf_phdr(& mut out, 6, 4, 64, base - 0x1000 + 64, 56 * phnum, 56 * phnum, 8);
    }
    if ldyn {
        // PT_INTERP (before any loadable segment), read-only
        img_elf_phdr(& mut out, 3, 4, 0x1000 + g_nat_ldyn_interp, base + g_nat_ldyn_interp, g_nat_ldyn_interp_len, g_nat_ldyn_interp_len, 1);
    }
    var load_len: i64 = 0x1000 + image.len();
    var load_flags: i64 = 7;
    if dsplit > 0 {
        load_len = 0x1000 + dsplit;
        load_flags = 5;
    }
    // PT_LOAD from file offset 0: RWX, or R+X for the headers and code
    img_elf_phdr(& mut out, 1, load_flags, 0, base - 0x1000, load_len, load_len, 0x10000);
    if dsplit > 0 {
        // PT_LOAD of the data, read/write, from a page boundary
        img_elf_phdr(& mut out, 1, 6, 0x1000 + dsplit, base + dsplit, image.len() - dsplit, image.len() - dsplit, 0x10000);
        // PT_GNU_STACK, read/write
        img_elf_phdr(& mut out, 0x6474E551, 6, 0, 0, 0, 0, 16);
    }
    if ldyn {
        // PT_DYNAMIC, read/write (the dynamic linker writes DT_DEBUG)
        img_elf_phdr(& mut out, 2, 6, 0x1000 + g_nat_ldyn_dyn, base + g_nat_ldyn_dyn, g_nat_ldyn_dyn_len, g_nat_ldyn_dyn_len, 8);
    }
    img_pad_to(& mut out, 0x1000);
    img_append(& mut out, image);
    return out;
}

/// TG15: the DLL a `--nat` Windows executable imports a C function of
/// `extern "C" link "<lib>"` from (as pe_ir's pe_link_dll): the classic C
/// runtime msvcrt.dll for the C library ("", "c", "msvcrt" and the Unix
/// names Windows has no file for: "pthread", "dl", "rt"); the Universal C
/// Runtime ucrtbase.dll for libm ("m": C99's hypot, cbrt, fmax, ... that
/// msvcrt.dll lacks; every Windows 10 and 11 has it in System32); "GL" and
/// "GLU" as pe_ir; a name ending in ".dll" as it is; anything else
/// "<lib>.dll" ("kernel32", "user32", "sqlite3", ...).
pub fn nat_pe_dll_for(lib: str) -> str {
    if lib == "" || lib == "c" || lib == "msvcrt" || lib == "pthread" || lib == "dl" || lib == "rt" {
        return "msvcrt.dll";
    }
    if lib == "m" || lib == "ucrt" || lib == "ucrtbase" {
        return "ucrtbase.dll";
    }
    if lib == "GL" {
        return "opengl32.dll";
    }
    if lib == "GLU" {
        return "glu32.dll";
    }
    if str_ends_with(lib, ".dll") || str_ends_with(lib, ".DLL") {
        return lib;
    }
    return lib + ".dll";
}

/// TG15: a stub signature (ng_ldyn_sig's form) without the variadic
/// marker: in "i.id>w" the arguments after the `.` are a C function's
/// `...` ones (the first fixed).
pub fn nat_pe_sig_plain(sig: str) -> str {
    var dot: i64 = str_find(sig, ".");
    if dot < 0 {
        return sig;
    }
    return str_slice(sig, 0, dot) + str_slice(sig, dot + 1, str_len(sig));
}

/// TG15: the Windows x64 register of argument position `j` (0..3): rcx,
/// rdx, r8, r9.
fn nat_pe_win64_int(j: i64) -> i64 {
    if j == 0 {
        return 1;
    }
    if j == 1 {
        return 2;
    }
    if j == 2 {
        return 8;
    }
    return 9;
}

/// TG15: the machine layer's register of its argument `j` (0..3) on
/// x86-64: rdi, rsi, rdx, rcx (ng_argreg).
fn nat_pe_win64_src(j: i64) -> i64 {
    if j == 0 {
        return 7;
    }
    if j == 1 {
        return 6;
    }
    if j == 2 {
        return 2;
    }
    return 1;
}

/// TG15: the body of a stub (its label already placed) that calls the C
/// function whose import address table entry is `slot` (the 8-byte word
/// the Windows loader fills) from the machine layer's convention:
/// arguments 0..3 in rdi, rsi, rdx, rcx, the rest above the return address
/// ([rsp + 8 + 8 * (j - 4)] at entry), every float as its bits in a general
/// register (an f64 its 64 bits, an f32 its 32-bit pattern: MI25), the
/// result back in rdi. `sig` is ng_ldyn_sig's ("id>w": a class per
/// argument, `i` a word, `d` f64, `s` f32; `>`; the result's: `d`, `s`, `w`
/// i32, `W` u32, `h` i16, `H` u16, `b` i8, `B` u8 or bool, `v` none, `i` a
/// word).
/// Windows x64 passes by position: argument j < 4 in rcx, rdx, r8, r9 (an
/// integer) or xmm j (a float), the rest at [rsp + 32 + 8 * (j - 4)] above
/// 32 bytes of shadow space, rsp 16-aligned at the call. A float among the
/// first four also goes to its integer register: a variadic callee
/// (printf) reads it there, the others ignore it. The registers are set
/// from the last position to the first, so each source (rcx for position
/// 3, rdx for 2) is read before a lower position overwrites it. Windows
/// keeps rbx, rbp, rdi, rsi, r12-r15 and xmm6-xmm15; the stub changes only
/// what a call in the machine layer's convention may change.
pub fn nat_pe_win64_stub(e: & mut NatEnc, full_sig: str, slot: i64) {
    // A variadic call's marker (`.` after the fixed arguments) changes
    // nothing here: every float already goes to its integer register too
    var sig: str = nat_pe_sig_plain(full_sig);
    var gt: i64 = str_find(sig, ">");
    if gt < 0 {
        gt = str_len(sig);
    }
    x64_push(e, 5);
    x64_mov(e, 5, 4);
    x64_align_sp16(e);
    var nstack: i64 = 0;
    if gt > 4 {
        nstack = gt - 4;
    }
    var frame: i64 = (32 + 8 * nstack + 15) & (0 - 16);
    x64_sub_imm(e, 4, frame);
    // The stack arguments (through r11: no argument register is touched)
    var j: i64 = 4;
    while j < gt {
        x64_load(e, 11, 5, 16 + 8 * (j - 4), 8, true);
        x64_store(e, 11, 4, 32 + 8 * (j - 4), 8);
        j = j + 1;
    }
    // The register arguments, last position first
    j = gt;
    if j > 4 {
        j = 4;
    }
    j = j - 1;
    while j >= 0 {
        var c: i64 = str_byte_at(sig, j);
        var src: i64 = nat_pe_win64_src(j);
        var dst: i64 = nat_pe_win64_int(j);
        if c == 100 || c == 115 {
            x64_movq_xr(e, j, src, c == 100);
        }
        if dst != src {
            x64_mov(e, dst, src);
        }
        j = j - 1;
    }
    // rax = the IAT entry; the call
    x64_load_label(e, 0, slot);
    x64_call_r(e, 0);
    var rc: i64 = 105;
    if gt + 1 < str_len(sig) {
        rc = str_byte_at(sig, gt + 1);
    }
    if rc == 100 {
        x64_movq_rx(e, 7, 0, true);
    } else if rc == 115 {
        // the f32's 32-bit pattern, zero-extended (movd edi, xmm0)
        x64_movq_rx(e, 7, 0, false);
    } else if rc == 119 {
        x64_movx(e, 0x63, 7, 0);
    } else if rc == 87 {
        x64_mov32(e, 7, 0);
    } else if rc == 104 {
        x64_movx(e, 0xBF, 7, 0);
    } else if rc == 72 {
        x64_movx(e, 0xB7, 7, 0);
    } else if rc == 98 {
        x64_movx(e, 0xBE, 7, 0);
    } else if rc == 66 {
        x64_movx(e, 0xB6, 7, 0);
    } else {
        x64_mov(e, 7, 0);
    }
    x64_mov(e, 4, 5);
    x64_pop(e, 5);
    x64_ret(e);
}

/// nat_pe's executable (see above): DOS stub, COFF header, PE32+ optional
/// header (imports and IAT in the directories), .text and .data, the image
/// at file offset 0x200.
pub fn nat_pe_img(image: & Vec<i64>, entry: i64, data_off: i64, imp_off: i64, imp_size: i64, iat_off: i64, iat_size: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var vsize: i64 = (image.len() + 0xFFF) & (0 - 0x1000);
    var fsize: i64 = (image.len() + 0x1FF) & (0 - 0x200);
    var dsize: i64 = image.len() - data_off;
    img_pe_dos(& mut out, false);
    img_pe_signature(& mut out);
    img_coff_header(& mut out, 0x8664, 2, 0, 0, 240, 0x0023);
    // AMD64, two sections; RELOCS_STRIPPED | EXECUTABLE | LARGE_ADDRESS_AWARE
    // Stack reserve 256 MB (SP16: what the Linux runtime lets the main
    // stack grow to; only address space, committed as MI29's probes reach
    // it); NX_COMPAT | TERMINAL_SERVER_AWARE; console
    var o: ImgPeOpt = ImgPeOpt {
        linker_major: 0, code_size: data_off, init_size: (dsize + 0x1FF) & (0 - 0x200), entry: 0x1000 + entry, base_of_code: 0x1000, image_base: 0x400000, sect_align: 0x1000, file_align: 0x200, os_major: 6, subsys_major: 6, image_size: 0x1000 + vsize, header_size: 0x200, subsystem: 3, dll_chars: 0x8100, stack_reserve: 0x10000000, stack_commit: 0x10000, heap_reserve: 0x100000, heap_commit: 0x1000
    };
    var dirs: Vec<i64> = img_pe_dirs();
    img_pe_dir(& mut dirs, 1, 0x1000 + imp_off, imp_size);
    img_pe_dir(& mut dirs, 12, 0x1000 + iat_off, iat_size);
    img_pe_optional(& mut out, & o, & dirs);
    // data_off is page-aligned, so file and memory agree
    img_pe_section(& mut out, ".text", data_off, 0x1000, data_off, 0x200, 0x60000020);
    // code, RX
    img_pe_section(& mut out, ".data", dsize, 0x1000 + data_off, fsize - data_off, 0x200 + data_off, 0xC0000040);
    // data, RW
    img_pad_to(& mut out, 0x200);
    img_append(& mut out, image);
    img_pad_to(& mut out, 0x200 + fsize);
    return out;
}

pub fn nat_pe(image: Vec<i64>, entry: i64, data_off: i64, imp_off: i64, imp_size: i64, iat_off: i64, iat_size: i64) -> Vec<i64> {
    // TG13: a layout over image_writer (nat_pe_img; the old body, checked
    // byte for byte against it on Nov 17, is gone: docs/image-writer.md)
    return nat_pe_img(& image, entry, data_off, imp_off, imp_size, iat_off, iat_size);
}

/// DB10 for `--nat` (as pe_ir_enc.fd's pe_append_coff_symbols does for
/// pe_ir's images, DB3): a COFF symbol table after nat_pe's sections, one
/// function symbol (section 1, .text; type 0x20, EXTERNAL) per name at its
/// image offset (.text starts the image), then the string table; the COFF
/// header's PointerToSymbolTable and NumberOfSymbols (file offsets 76, 80)
/// point at it. The loader reads none of it; llvm-nm, llvm-objdump,
/// dumpbin and gdb name our functions from it.
pub fn nat_pe_symbols(pe: & mut Vec<i64>, names: Vec<str>, starts: Vec<i64>) {
    if names.len() == 0 || names.len() != starts.len() {
        return;
    }
    // TG13: the COFF records and string table from image_writer
    var none: Vec<i64> = Vec::new();
    var syms: Vec<ImgSym> = img_func_syms(& names, & starts, & none, 0, 1, IMG_GLOBAL);
    var pre: Vec<str> = Vec::new();
    img_coff_symbols(pe, & pre, & syms, IMG_PE_SYMPTR_AT, IMG_PE_NSYMS_AT);
}

/// DB6 for `--nat`: where nat_pe_unwind's .pdata starts when its bytes go
/// after an image of `len` bytes (4-aligned, after the 8 bytes of .xdata).
pub fn nat_pe_unwind_pdata(len: i64) -> i64 {
    return ((len + 3) & (0 - 4)) + 8;
}

/// DB6 for `--nat`: the Windows x64 unwind data of the functions [start,
/// end) (image offsets, in address order; .text is at RVA 0x1000), as the
/// bytes to append to the image (they land in .data): padding to 4, one
/// UNWIND_INFO all framed functions share, then a RUNTIME_FUNCTION (begin,
/// end, unwind info RVAs) per framed function. Our prologue (nat_ir.fd
/// ng_prologue) is `push rbp; mov rbp, rsp` then the frame's allocation:
/// UNWIND_INFO version 1, prologue 4 bytes, FrameRegister rbp with offset
/// 0, codes UWOP_SET_FPREG at 4 and UWOP_PUSH_NONVOL rbp at 1. From the
/// body the unwinder takes rsp = rbp (so the allocation and any later
/// change of rsp need no code), pops rbp and returns. An epilogue (`mov
/// rsp, rbp; pop rbp; ret`) unwinds the same at its first instruction and
/// is recognized from `pop rbp` on. A function without our frame record (a
/// WP8 leaf, nat_has_frame) gets no entry: Windows unwinds it as a leaf
/// (the return address at rsp), which is what it is. The callee-saved
/// registers the body stores below rbp have no UWOP_SAVE_NONVOL (its
/// offsets cannot be negative from the frame register): an unwinder gets
/// the stack and the frame pointers right, not their values in callers.
pub fn nat_pe_unwind(image: & Vec<i64>, starts: Vec<i64>, ends: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var len: i64 = image.len();
    while ((len + out.len()) & 3) != 0 {
        out.push(0);
    }
    var xdata: i64 = len + out.len();
    out.push(0x01);
    // version 1, no handler
    out.push(4);
    // SizeOfProlog
    out.push(2);
    // CountOfCodes
    out.push(0x05);
    // FrameRegister rbp, FrameOffset 0
    out.push(4);
    out.push(0x03);
    // at 4: UWOP_SET_FPREG
    out.push(1);
    out.push(0x50);
    // at 1: UWOP_PUSH_NONVOL rbp
    var i: i64 = 0;
    while i < starts.len() && i < ends.len() {
        var s: i64 = starts.get(i);
        var e: i64 = ends.get(i);
        if e > s + 4 && nat_has_frame(NAT_X64, image, s) {
            nat_put_u32(& mut out, 0x1000 + s);
            nat_put_u32(& mut out, 0x1000 + e);
            nat_put_u32(& mut out, 0x1000 + xdata);
        }
        i = i + 1;
    }
    return out;
}

/// Data directory `idx` of a PE32+ image nat_pe wrote (e_lfanew 0x40: the
/// directories at 0x40 + 4 + 20 + 112).
pub fn nat_pe_set_dir(pe: & mut Vec<i64>, idx: i64, rva: i64, size: i64) {
    nat_set_u32(pe, 0xC8 + idx * 8, rva);
    nat_set_u32(pe, 0xC8 + idx * 8 + 4, size);
}

// --- CT6: DWARF in `--nat` Windows images ----------------------------------
// A debug build's PE (nat_ir.fd ng_dbg_win_dwarf) carries the DWARF the
// Linux images have (nat_dwarf_build: functions, their parameters and
// variables with location lists, types, frames; nat_debug_line_at: the line
// table) as COFF sections after .data, the way MinGW's linker writes them:
// gdb, lldb and llvm-dwarfdump read DWARF from a PE. The names are longer
// than 8 bytes, so each section header says "/<offset>" into the COFF
// string table, which starts with them (nat_pe_symbols_pre). A PDB (what
// Visual Studio and WinDbg read) is not written.

/// CT6: where code offset 0 of a nat_pe image is in memory (ImageBase
/// 0x400000, .text at RVA 0x1000).
pub const NAT_PE_CODE_VA: i64 = 0x401000;

fn nat_pe_get_u32(pe: & Vec<i64>, at: i64) -> i64 {
    return pe.get(at) | (pe.get(at + 1) << 8) | (pe.get(at + 2) << 16) | (pe.get(at + 3) << 24);
}

/// CT6: `pe` (nat_pe's image: two sections, 0x200 bytes of headers) with
/// the sections `snames` / `parts` (none empty) after its last one: the
/// headers grow to 0x400 bytes (.text and .data move 0x200 bytes down the
/// file, their addresses do not change), each new section gets the next
/// page-aligned address and 0x200-aligned file space, flags
/// INITIALIZED_DATA | MEM_DISCARDABLE | MEM_READ, the name "/<n>" where n
/// counts from 4 over the names (the COFF string table nat_pe_symbols_pre
/// writes); NumberOfSections, SizeOfImage and SizeOfInitializedData cover
/// them. Another image, or more than 15 sections, comes back unchanged.
pub fn nat_pe_add_sections(pe: Vec<i64>, snames: Vec<str>, parts: Vec<Vec<i64>>) -> Vec<i64> {
    var ok: bool = pe.len() >= 0x400 && snames.len() > 0 && snames.len() == parts.len() && snames.len() <= 15;
    if ok {
        ok = (pe.get(70) | (pe.get(71) << 8)) == 2 && nat_pe_get_u32(& pe, 148) == 0x200 && pe.get(0x3C) == 0x40;
    }
    if !ok {
        return pe;
    }
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 0x200 {
        out.push(pe.get(i));
        i = i + 1;
    }
    while out.len() < 0x400 {
        out.push(0);
    }
    while i < pe.len() {
        out.push(pe.get(i));
        i = i + 1;
    }
    while out.len() % 0x200 != 0 {
        out.push(0);
    }
    nat_set_u32(& mut out, 148, 0x400);
    // SizeOfHeaders; .text's and .data's PointerToRawData
    nat_set_u32(& mut out, 328 + 20, nat_pe_get_u32(& out, 328 + 20) + 0x200);
    nat_set_u32(& mut out, 368 + 20, nat_pe_get_u32(& out, 368 + 20) + 0x200);
    var rva: i64 = (nat_pe_get_u32(& out, 368 + 12) + nat_pe_get_u32(& out, 368 + 8) + 0xFFF) & (0 - 0x1000);
    var init: i64 = nat_pe_get_u32(& out, 96);
    var noff: i64 = 4;
    var s: i64 = 0;
    while s < snames.len() {
        var data: Vec<i64> = parts.get(s);
        var pos: i64 = out.len();
        var raw: i64 = (data.len() + 0x1FF) & (0 - 0x200);
        img_pe_section_at(& mut out, 328 + 40 * (2 + s), "/" + int_to_str(noff), data.len(), rva, raw, pos, 0x42000040);
        img_append(& mut out, & data);
        img_pad_to(& mut out, pos + raw);
        rva = rva + ((data.len() + 0xFFF) & (0 - 0x1000));
        init = init + raw;
        noff = noff + str_len(snames.get(s)) + 1;
        s = s + 1;
    }
    nat_set_u16(& mut out, 70, 2 + snames.len());
    // NumberOfSections
    nat_set_u32(& mut out, 144, rva);
    // SizeOfImage
    nat_set_u32(& mut out, 96, init);
    // SizeOfInitializedData
    return out;
}

/// CT6: nat_pe_symbols with the COFF string table starting with the names
/// `pre` (the long section names of nat_pe_add_sections, at 4, 4 + len + 1,
/// ...); written even without function names, for the sections' sake.
pub fn nat_pe_symbols_pre(pe: & mut Vec<i64>, pre: Vec<str>, names: Vec<str>, starts: Vec<i64>) {
    var fnames: Vec<str> = names;
    var fstarts: Vec<i64> = starts;
    if names.len() != starts.len() {
        fnames = Vec::new();
        fstarts = Vec::new();
    }
    if fnames.len() == 0 && pre.len() == 0 {
        return;
    }
    var none: Vec<i64> = Vec::new();
    var syms: Vec<ImgSym> = img_func_syms(& fnames, & fstarts, & none, 0, 1, IMG_GLOBAL);
    img_coff_symbols(pe, & pre, & syms, IMG_PE_SYMPTR_AT, IMG_PE_NSYMS_AT);
}

/// CT6: the `--nat` PE `pe` (nat_pe) of `image` with its DWARF: the
/// functions `names` at [starts, ends) (image offsets), their line rows
/// `lrows` (against `file` and g_nat_line_files), their frame rows `cfi`
/// (DB6) and the variables, types and shown names of g_nat_dbg_vars,
/// g_nat_dbg_types and g_nat_dbg_shown, as .debug_abbrev, .debug_info,
/// .debug_line, .debug_frame and .debug_loc sections (nat_pe_add_sections),
/// then the COFF symbol table (DB10) whose string table names them. An
/// image nat_pe_add_sections does not take gets the symbols only.
pub fn nat_pe_debug(pe: Vec<i64>, image: Vec<i64>, names: Vec<str>, starts: Vec<i64>, ends: Vec<i64>, file: str, lrows: Vec<i64>, cfi: Vec<i64>) -> Vec<i64> {
    var dw: NatDwarf = nat_dwarf_build(NAT_X64, image, NAT_PE_CODE_VA, names, starts, ends, file, lrows, cfi, true);
    var fname: str = file;
    if fname == "" {
        fname = "fides";
    }
    var snames: Vec<str> = Vec::new();
    var parts: Vec<Vec<i64>> = Vec::new();
    snames.push(".debug_abbrev");
    parts.push(dw.abbrev);
    snames.push(".debug_info");
    parts.push(dw.info);
    snames.push(".debug_line");
    parts.push(nat_debug_line_at(fname, lrows, NAT_PE_CODE_VA));
    snames.push(".debug_frame");
    parts.push(dw.frame);
    if dw.dloc.len() > 0 {
        snames.push(".debug_loc");
        parts.push(dw.dloc);
    }
    var out: Vec<i64> = nat_pe_add_sections(pe, snames, parts);
    if (out.get(70) | (out.get(71) << 8)) > 2 {
        nat_pe_symbols_pre(& mut out, snames, names, starts);
    } else {
        nat_pe_symbols(& mut out, names, starts);
    }
    // DB3: the PDB for Visual Studio and WinDbg (compiler/pdb.fd) and the
    // image's debug directory naming it, when the driver gave a path
    // (pdb_setup) or FID_PDB_OUT does; else the image as it is
    return pdb_attach(out, names, starts, ends, lrows, g_nat_line_files, fname);
}

// ---------------------------------------------------------------------------
// Debug sections (own-backend roadmap DB2, DB6, DB10): a symbol table, DWARF
// function entries (.debug_info) and call frame information (.debug_frame),
// so gdb, perf and addr2line name our functions and walk our stacks. After
// the loaded image, outside the PT_LOAD: the program does not see them.
// Line tables wait for the lowering to record source lines.
// ---------------------------------------------------------------------------

fn nat_put_u16(out: & mut Vec<i64>, v: i64) {
    out.push(v & 255);
    out.push((v >> 8) & 255);
}

fn nat_put_u32(out: & mut Vec<i64>, v: i64) {
    nat_put_u16(out, v);
    nat_put_u16(out, v >> 16);
}

fn nat_put_u64(out: & mut Vec<i64>, v: i64) {
    nat_put_u32(out, v);
    nat_put_u32(out, v >> 32);
}

fn nat_put_str(out: & mut Vec<i64>, s: str) {
    var i: i64 = 0;
    while i < str_len(s) {
        out.push(str_byte_at(s, i));
        i = i + 1;
    }
    out.push(0);
}

fn nat_set_u32(out: & mut Vec<i64>, at: i64, v: i64) {
    var i: i64 = 0;
    while i < 4 {
        out.set(at + i, (v >> (i * 8)) & 255);
        i = i + 1;
    }
}

fn nat_set_u16(out: & mut Vec<i64>, at: i64, v: i64) {
    out.set(at, v & 255);
    out.set(at + 1, (v >> 8) & 255);
}

fn nat_set_u64(out: & mut Vec<i64>, at: i64, v: i64) {
    nat_set_u32(out, at, v);
    nat_set_u32(out, at + 4, v >> 32);
}

/// The CFI of one function: our prologue's frame record, then the frame
/// pointer as the CFA for the rest of the body.
fn nat_fde_body(arch: i64, out: & mut Vec<i64>) {
    if arch == NAT_X64 {
        out.push(0x41);
        // advance 1: after push rbp
        out.push(0x0E);
        out.push(16);
        // def_cfa_offset 16
        out.push(0x80 | 6);
        out.push(2);
        // rbp at cfa - 16
        out.push(0x43);
        // advance 3: after mov rbp, rsp
        out.push(0x0D);
        out.push(6);
        // def_cfa_register rbp
        return;
    }
    if arch == NAT_A64 {
        out.push(0x41);
        // advance 1: after stp x29, x30, [sp, #-16]!
        out.push(0x0E);
        out.push(16);
        // def_cfa_offset 16
        out.push(0x80 | 29);
        out.push(2);
        // x29 at cfa - 16
        out.push(0x80 | 30);
        out.push(1);
        // x30 at cfa - 8
        out.push(0x41);
        // advance 1: after mov x29, sp
        out.push(0x0D);
        out.push(29);
        // def_cfa_register x29
    } else {
        // (one 4-byte word: TG9 keeps the prologue uncompressed, so with
        // RVC's code alignment 2 a word is an advance of 2)
        var adv: i64 = 0x40 | (4 / nat_code_align(arch));
        out.push(adv);
        // advance 1: after addi sp, sp, -16
        out.push(0x0E);
        out.push(16);
        // def_cfa_offset 16
        out.push(adv);
        // advance 1: after sd ra, 8(sp)
        out.push(0x80 | 1);
        out.push(1);
        // ra at cfa - 8
        out.push(adv);
        // advance 1: after sd s0, 0(sp)
        out.push(0x80 | 8);
        out.push(2);
        // s0 at cfa - 16
        out.push(adv);
        // advance 1: after addi s0, sp, 16
        out.push(0x0C);
        out.push(8);
        out.push(0);
        // def_cfa s0, 0
    }
}

/// DB6: the function at image offset `at` starts with our frame prologue
/// (ng_prologue: x86-64 `push rbp; mov rbp, rsp`, AArch64 `stp x29, x30,
/// [sp, #-16]!`, RISC-V `addi sp, sp, -16`). A WP8 leaf, a primitive or a
/// function whose code does not start so keeps the CIE's entry rules
/// throughout: the CFA from sp, the return address where the call left it.
fn nat_has_frame(arch: i64, image: & Vec<i64>, at: i64) -> bool {
    if at < 0 || at + 4 > image.len() {
        return false;
    }
    if arch == NAT_X64 {
        return image.get(at) == 0x55 && image.get(at + 1) == 0x48 && image.get(at + 2) == 0x89 && image.get(at + 3) == 0xE5;
    }
    var w: i64 = image.get(at) | (image.get(at + 1) << 8) | (image.get(at + 2) << 16) | (image.get(at + 3) << 24);
    if arch == NAT_A64 {
        return w == 0xA9BF7BFD;
    }
    return w == 0xFF010113;
}

/// DB6: the bytes nat_fde_body's rules cover (the prologue's length).
fn nat_prologue_len(arch: i64) -> i64 {
    if arch == NAT_X64 {
        return 4;
    }
    if arch == NAT_A64 {
        return 8;
    }
    return 16;
}

/// DB6: the CIE's code alignment factor: 1 on x86-64, 4 on AArch64 and
/// RISC-V, TG9: 2 on RISC-V when the code holds 2-byte instructions.
fn nat_code_align(arch: i64) -> i64 {
    if arch == NAT_X64 {
        return 1;
    }
    if arch == NAT_RV64 && g_nat_rvc {
        return 2;
    }
    return 4;
}

/// DB6: DW_CFA_advance_loc* by `delta` bytes (in units of nat_code_align).
fn nat_cfa_advance(arch: i64, out: & mut Vec<i64>, delta: i64) {
    var d: i64 = delta;
    if arch != NAT_X64 {
        d = delta / nat_code_align(arch);
    }
    if d <= 0 {
        return;
    }
    if d < 64 {
        out.push(0x40 | d);
    } else if d < 256 {
        out.push(0x02);
        out.push(d);
    } else if d < 65536 {
        out.push(0x03);
        nat_put_u16(out, d);
    } else {
        out.push(0x04);
        nat_put_u32(out, d);
    }
}

/// DB6: one epilogue's rules (ng_cfi_row's [p1, p2, pend]), `loc` the
/// offset the FDE's rules have reached; returns the new one. From p1 the
/// frame record is gone: the CFA is sp-based and the frame pointer and
/// return address are restored (the CIE's same-value rules); RISC-V's
/// `addi sp, sp, 16` ends at p2. After the ret (pend), when the function
/// goes on, the body's rules come back (remember / restore state).
fn nat_fde_epilogue(arch: i64, out: & mut Vec<i64>, loc: i64, p1: i64, p2: i64, pend: i64, end: i64, saved: & Vec<i64>) -> i64 {
    var at: i64 = loc;
    nat_cfa_advance(arch, out, p1 - at);
    at = p1;
    out.push(0x0A);
    // remember_state
    // the callee-saved registers are back (restored before p1): the CIE's
    // rule for each (DW_CFA_restore)
    var si: i64 = 0;
    while si < saved.len() {
        out.push(0xC0 | (saved.get(si) & 63));
        si = si + 1;
    }
    if arch == NAT_X64 {
        out.push(0x0C);
        out.push(7);
        out.push(8);
        // def_cfa rsp, 8
        out.push(0xC0 | 6);
        // restore rbp
    } else if arch == NAT_A64 {
        out.push(0x0C);
        out.push(31);
        out.push(0);
        // def_cfa sp, 0
        out.push(0xC0 | 29);
        out.push(0xC0 | 30);
        // restore x29, x30
    } else {
        out.push(0x0C);
        out.push(2);
        out.push(16);
        // def_cfa sp, 16
        out.push(0xC0 | 8);
        out.push(0xC0 | 1);
        // restore s0, ra
        if p2 > at {
            nat_cfa_advance(arch, out, p2 - at);
            at = p2;
            out.push(0x0E);
            out.push(0);
            // def_cfa_offset 0
        }
    }
    if pend < end {
        nat_cfa_advance(arch, out, pend - at);
        at = pend;
        out.push(0x0B);
        // restore_state
    }
    return at;
}

/// nat_elf, with a symbol table and DWARF for the functions [name, start,
/// end) (image offsets, in address order).
fn nat_put_uleb(out: & mut Vec<i64>, v: i64) {
    var x: i64 = v;
    while true {
        var b: i64 = x & 127;
        x = x >> 7;
        if x == 0 {
            out.push(b);
            return;
        }
        out.push(b | 128);
    }
}

fn nat_put_sleb(out: & mut Vec<i64>, v: i64) {
    var x: i64 = v;
    while true {
        var b: i64 = x & 127;
        x = x >> 7;
        if (x == 0 && (b & 64) == 0) || (x == 0 - 1 && (b & 64) != 0) {
            out.push(b);
            return;
        }
        out.push(b | 128);
    }
}

/// .debug_line (DWARF 4) of the rows [image offset, line, 2 * file + end?]:
/// a sequence per function (DB1). The files are g_nat_line_files (`file`,
/// the input file, when that table is empty); DWARF numbers them from 1.
fn nat_debug_line(file: str, rows: Vec<i64>) -> Vec<i64> {
    return nat_debug_line_at(file, rows, nat_elf_image_base());
}

/// TL5: the same with image offset 0 at address `abase` (a Mach-O image's
/// code starts at NAT_MACHO_BASE + NAT_MACHO_HDR, nat_macho_dwarf).
pub fn nat_debug_line_at(file: str, rows: Vec<i64>, abase: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    nat_put_u32(& mut out, 0);
    // unit length, set below
    nat_put_u16(& mut out, 4);
    nat_put_u32(& mut out, 0);
    // header length, set below
    var hstart: i64 = out.len();
    out.push(1);
    // minimum instruction length
    out.push(1);
    // maximum operations per instruction
    out.push(1);
    // default is_stmt
    out.push(0xFB);
    // line_base -5
    out.push(14);
    // line_range
    out.push(13);
    // opcode_base
    out.push(0);
    out.push(1);
    out.push(1);
    out.push(1);
    out.push(1);
    out.push(0);
    out.push(0);
    out.push(0);
    out.push(1);
    out.push(0);
    out.push(0);
    out.push(1);
    out.push(0);
    // no include directories
    var nfiles: i64 = g_nat_line_files.len();
    if nfiles == 0 {
        nat_put_str(& mut out, nat_dbg_written_path(file));
        out.push(0);
        out.push(0);
        out.push(0);
    }
    var fi: i64 = 0;
    while fi < nfiles {
        var fname: str = g_nat_line_files.get(fi);
        if fi == 0 && str_len(fname) == 0 {
            fname = file;
        }
        // RL13 R2: not the build's own paths unless --debug / -g
        nat_put_str(& mut out, nat_dbg_written_path(fname));
        out.push(0);
        out.push(0);
        out.push(0);
        // directory, time, size
        fi = fi + 1;
    }
    out.push(0);
    nat_set_u32(& mut out, 6, out.len() - hstart);
    var open: bool = false;
    var addr: i64 = 0;
    var line: i64 = 1;
    var cur_file: i64 = 1;
    var i: i64 = 0;
    while i + 2 < rows.len() {
        var at: i64 = abase + rows.get(i);
        var l: i64 = rows.get(i + 1);
        var rflag: i64 = rows.get(i + 2);
        var rfile: i64 = (rflag >> 1) + 1;
        if (rflag & 1) == 1 {
            if open {
                out.push(0x02);
                nat_put_uleb(& mut out, at - addr);
                // advance_pc
                out.push(0);
                out.push(1);
                out.push(1);
                // end_sequence
                open = false;
                line = 1;
                cur_file = 1;
            }
        } else {
            if !open {
                out.push(0);
                out.push(9);
                out.push(2);
                // set_address
                nat_put_u64(& mut out, at);
                addr = at;
                open = true;
            } else if at != addr {
                out.push(0x02);
                nat_put_uleb(& mut out, at - addr);
                addr = at;
            }
            if rfile != cur_file {
                out.push(0x04);
                nat_put_uleb(& mut out, rfile);
                // set_file (DB1: a function of another file)
                cur_file = rfile;
            }
            if l != line {
                out.push(0x03);
                nat_put_sleb(& mut out, l - line);
                // advance_line
                line = l;
            }
            out.push(0x01);
            // copy
        }
        i = i + 3;
    }
    nat_set_u32(& mut out, 0, out.len() - 4);
    return out;
}

// --- CT9: Fides names and types in .debug_info ---------------------------

/// The name a debugger shows for each of nat_elf_debug's `names`, in the
/// same order (a method as written: `Point::len` for the symbol
/// `Point_len`); empty: every function shows its symbol. Set by
/// compiler/nat_ir.fd (ng_dbg_shown_names) before nat_elf_debug.
pub var g_nat_dbg_shown: Vec<str> = Vec::new();
/// The program's struct types, one per entry: the name, the byte size,
/// then per field its name, offset, type name (as written), byte size and
/// encoding ("5" signed, "7" unsigned, "4" float, "2" boolean, "S" a
/// struct of this list held inline, "P" a pointer to one, "Z" a str),
/// separated by tabs (compiler/nat_ir.fd ng_dbg_type_descs).
pub var g_nat_dbg_types: Vec<str> = Vec::new();

/// CT9: the type `str`: a typedef named str of a pointer to u8 characters
/// (DW_ATE_unsigned_char), so a debugger prints the text a str points to.
/// Three entries at the top level of `info`; returns the typedef's offset.
fn nat_dbg_str_type(info: & mut Vec<i64>) -> i64 {
    var ch: i64 = info.len();
    info.push(5);
    nat_put_str(info, "u8");
    info.push(8);
    info.push(1);
    var ptr: i64 = info.len();
    info.push(17);
    info.push(8);
    nat_put_u32(info, ch);
    var td: i64 = info.len();
    info.push(16);
    nat_put_str(info, "str");
    nat_put_u32(info, ptr);
    return td;
}

/// Abbreviations 3 a struct type (children: its members), 4 a member, 5 a
/// base type, 6 a function with a linkage name; CT9: 16 a typedef, 17 a
/// pointer type.
fn nat_dbg_abbrevs(abbrev: & mut Vec<i64>) {
    // 16: DW_TAG_typedef; name string, type ref4
    abbrev.push(16);
    abbrev.push(0x16);
    abbrev.push(0);
    abbrev.push(0x03);
    abbrev.push(0x08);
    abbrev.push(0x49);
    abbrev.push(0x13);
    abbrev.push(0);
    abbrev.push(0);
    // 17: DW_TAG_pointer_type; byte_size data1, type ref4
    abbrev.push(17);
    abbrev.push(0x0F);
    abbrev.push(0);
    abbrev.push(0x0B);
    abbrev.push(0x0B);
    abbrev.push(0x49);
    abbrev.push(0x13);
    abbrev.push(0);
    abbrev.push(0);
    // 3: DW_TAG_structure_type, children; name string, byte_size data4
    abbrev.push(3);
    abbrev.push(0x13);
    abbrev.push(1);
    abbrev.push(0x03);
    abbrev.push(0x08);
    abbrev.push(0x0B);
    abbrev.push(0x06);
    abbrev.push(0);
    abbrev.push(0);
    // 4: DW_TAG_member; name string, type ref4, data_member_location data4
    abbrev.push(4);
    abbrev.push(0x0D);
    abbrev.push(0);
    abbrev.push(0x03);
    abbrev.push(0x08);
    abbrev.push(0x49);
    abbrev.push(0x13);
    abbrev.push(0x38);
    abbrev.push(0x06);
    abbrev.push(0);
    abbrev.push(0);
    // 5: DW_TAG_base_type; name string, encoding data1, byte_size data1
    abbrev.push(5);
    abbrev.push(0x24);
    abbrev.push(0);
    abbrev.push(0x03);
    abbrev.push(0x08);
    abbrev.push(0x3E);
    abbrev.push(0x0B);
    abbrev.push(0x0B);
    abbrev.push(0x0B);
    abbrev.push(0);
    abbrev.push(0);
    // 6: DW_TAG_subprogram; name string, linkage_name string, low_pc addr,
    // high_pc data8, external flag_present
    abbrev.push(6);
    abbrev.push(0x2E);
    abbrev.push(0);
    abbrev.push(0x03);
    abbrev.push(0x08);
    abbrev.push(0x6E);
    abbrev.push(0x08);
    abbrev.push(0x11);
    abbrev.push(0x01);
    abbrev.push(0x12);
    abbrev.push(0x07);
    abbrev.push(0x3F);
    abbrev.push(0x19);
    abbrev.push(0);
    abbrev.push(0);
}

/// The base types the fields use (one DIE per name, size and encoding),
/// then each struct with its members. A member's type is a reference
/// (an offset in the unit, which starts at info's offset 0): to its base
/// type, or to the struct it holds inline, patched once every struct is
/// placed.
fn nat_dbg_types(info: & mut Vec<i64>, descs: Vec<str>) -> i64 {
    var base_at: i64 = HashMap_new();
    var struct_at: i64 = HashMap_new();
    var fix_pos: Vec<i64> = Vec::new();
    var fix_name: Vec<str> = Vec::new();
    var di: i64 = 0;
    while di < descs.len() {
        var p: Vec<str> = str_split(descs.get(di), "\t");
        var f: i64 = 2;
        while f + 4 < p.len() {
            var enc: str = p.get(f + 4);
            if enc == "Z" {
                // CT9: the str type, once (also for the variables:
                // nat_dbg_var_types finds it in the map returned)
                if !HashMap_contains(base_at, "\tstr") {
                    var st: i64 = nat_dbg_str_type(info);
                    HashMap_insert(base_at, "\tstr", st);
                    HashMap_insert(struct_at, "\tstr", st);
                }
            } else if enc == "P" {
                // CT9: a pointer to a struct of the list, once per struct;
                // its target patched below
                if !HashMap_contains(base_at, "P\t" + p.get(f + 2)) {
                    HashMap_insert(base_at, "P\t" + p.get(f + 2), info.len());
                    info.push(17);
                    info.push(8);
                    fix_pos.push(info.len());
                    fix_name.push(p.get(f + 2));
                    nat_put_u32(info, 0);
                }
            } else if enc != "S" {
                var key: str = p.get(f + 2) + "\t" + p.get(f + 3) + "\t" + enc;
                if !HashMap_contains(base_at, key) {
                    HashMap_insert(base_at, key, info.len());
                    info.push(5);
                    nat_put_str(info, p.get(f + 2));
                    info.push(str_parse_int(enc));
                    info.push(str_parse_int(p.get(f + 3)));
                }
            }
            f = f + 5;
        }
        di = di + 1;
    }
    di = 0;
    while di < descs.len() {
        var q: Vec<str> = str_split(descs.get(di), "\t");
        if q.len() >= 2 {
            HashMap_insert(struct_at, q.get(0), info.len());
            info.push(3);
            nat_put_str(info, q.get(0));
            nat_put_u32(info, str_parse_int(q.get(1)));
            var g: i64 = 2;
            while g + 4 < q.len() {
                info.push(4);
                nat_put_str(info, q.get(g));
                var enc2: str = q.get(g + 4);
                if enc2 == "S" {
                    fix_pos.push(info.len());
                    fix_name.push(q.get(g + 2));
                    nat_put_u32(info, 0);
                } else if enc2 == "Z" {
                    nat_put_u32(info, HashMap_get(base_at, "\tstr"));
                } else if enc2 == "P" {
                    nat_put_u32(info, HashMap_get(base_at, "P\t" + q.get(g + 2)));
                } else {
                    nat_put_u32(info, HashMap_get(base_at, q.get(g + 2) + "\t" + q.get(g + 3) + "\t" + enc2));
                }
                nat_put_u32(info, str_parse_int(q.get(g + 1)));
                g = g + 5;
            }
            info.push(0);
            // the end of the struct's members
        }
        di = di + 1;
    }
    var k: i64 = 0;
    while k < fix_pos.len() {
        if HashMap_contains(struct_at, fix_name.get(k)) {
            nat_set_u32(info, fix_pos.get(k), HashMap_get(struct_at, fix_name.get(k)));
        }
        k = k + 1;
    }
    return struct_at;
}

// --- DB2 / DB4: frame bases, declaration lines and variables ----------------

/// DB2/DB4: on, nat_elf_debug gives each function a DW_AT_frame_base
/// (DW_OP_call_frame_cfa: the .debug_frame CFA), its declaration file (of
/// the first line row inside it) and line (its `fn` line in that file,
/// nat_dbg_decl_line), and its parameters and variables
/// (g_nat_dbg_vars) as children. Set by compiler/nat_ir.fd
/// (`FID_NAT_OFF=dbgvars`: off, the sections as before).
pub var g_nat_dbg_ext: bool = false;
/// DB4: per function of nat_elf_debug's `names` (same order; shorter or
/// empty: no variables), its parameters and variables, one per line:
/// kind ("P" a parameter, "V" a variable), name, type name, byte size,
/// encoding (as g_nat_dbg_types: 5, 8, 4, 2; "S" a struct of
/// g_nat_dbg_types held inline, "P" a pointer to one), location, separated
/// by tabs. A location is "r<n>" (DWARF register n, the whole function),
/// "f<off>" (at CFA + off), "c<v>" (the constant v) or "" (none: shown as
/// optimized out). Filled by compiler/nat_ir.fd (ng_dbg_vars_resolve).
/// DB4: a seventh field is the id of the lexical scope a variable is in,
/// given by a line "B", id, parent id (0: the function), start and end
/// from the function's start (ng_dbg_scope_blocks; nat_dbg_put_vars).
pub var g_nat_dbg_vars: Vec<str> = Vec::new();

// --- DB2: a function's declaration line is its `fn` line -------------------
// The line rows start at the body (lower.fd gives what is lowered outside
// a statement the body's first line), so the first row of a function is
// not where it is declared when doc comments, annotations, a signature
// over several lines or a comment come between. nat_dbg_decl_line looks
// up, in the source file the row names, the nearest line at or above that
// row that declares the function (`fn <name>`, outside a `//` comment).
// A function the scan does not find (a closure, a generated function, a
// file that cannot be read) keeps the first row's line, as before.
// `FID_NAT_OFF=declline`: the first row's line for every function.

/// DB2: the source files read for one image's declaration lines, with
/// where each line starts: line l (from 1) of file f begins at offset
/// `starts[first[f] + l - 1]` of `texts[f]`, which has `count[f]` lines
/// (0: the file could not be read).
pub struct NatDeclSrc {
    pub paths: Vec<str>,
    pub texts: Vec<str>,
    pub first: Vec<i64>,
    pub count: Vec<i64>,
    pub starts: Vec<i64>,
}

pub fn NatDeclSrc_new() -> NatDeclSrc {
    return NatDeclSrc {
        paths: Vec::new(), texts: Vec::new(), first: Vec::new(), count: Vec::new(), starts: Vec::new()
    };
}

/// DB2: false when `FID_NAT_OFF` names `declline`.
pub fn nat_dbg_decl_on() -> bool {
    var off: str = "";
    match env_var("FID_NAT_OFF") {
        Option::Some(v) => {
            off = v;
        }
        Option::None => {
        }
    }
    if str_len(off) == 0 {
        return true;
    }
    return !str_contains("," + off + ",", ",declline,");
}

/// DB2: the index of `path` in `src`, reading the file the first time.
fn nat_decl_src_index(src: & mut NatDeclSrc, path: str) -> i64 {
    var i: i64 = 0;
    while i < src.paths.len() {
        if src.paths.get(i) == path {
            return i;
        }
        i = i + 1;
    }
    var text: str = "";
    var ok: bool = false;
    match read_file(path) {
        Option::Some(t) => {
            text = t;
            ok = true;
        }
        Option::None => {
        }
    }
    var at: i64 = src.starts.len();
    if ok {
        src.starts.push(0);
        var n: i64 = str_len(text);
        var k: i64 = 0;
        while k < n {
            if str_byte_at(text, k) == 10 && k + 1 < n {
                src.starts.push(k + 1);
            }
            k = k + 1;
        }
    }
    src.paths.push(path);
    src.texts.push(text);
    src.first.push(at);
    src.count.push(src.starts.len() - at);
    return src.paths.len() - 1;
}

/// DB2: a byte of an identifier (letter, digit, `_`).
fn nat_decl_ident(c: i64) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

/// DB2: true when bytes [a, b) of `text` hold `fn <name>`: `fn` a whole
/// word, then spaces, then `name` not followed by an identifier byte.
fn nat_decl_line_has(text: str, a: i64, b: i64, name: str) -> bool {
    var n: i64 = str_len(name);
    if n == 0 {
        return false;
    }
    var i: i64 = a;
    while i + 3 + n <= b {
        if str_byte_at(text, i) == 102 && str_byte_at(text, i + 1) == 110 && (i == a || !nat_decl_ident(str_byte_at(text, i - 1))) {
            var j: i64 = i + 2;
            var sp: i64 = 0;
            while j < b && (str_byte_at(text, j) == 32 || str_byte_at(text, j) == 9) {
                j = j + 1;
                sp = sp + 1;
            }
            if sp > 0 && j + n <= b {
                var k: i64 = 0;
                while k < n && str_byte_at(text, j + k) == str_byte_at(name, k) {
                    k = k + 1;
                }
                if k == n && (j + n == b || !nat_decl_ident(str_byte_at(text, j + n))) {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

/// DB2: the names function `name` (shown by a debugger as `shown`, "" when
/// as its symbol) may be declared under: the symbol; the shown name's last
/// `::` segment without type arguments (`Point::len` -> len, `max<i64>` ->
/// max); a mono instance's base (`max__i64` -> max, `Stack__push__i64` ->
/// push); a method's name after the type (`Point_len` -> len, after the
/// first and after the last `_`).
fn nat_decl_names(name: str, shown: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    out.push(name);
    if str_len(shown) > 0 {
        var s: str = shown;
        var lt: i64 = str_find(s, "<");
        if lt > 0 {
            s = str_slice(s, 0, lt);
        }
        var cc: i64 = str_rfind(s, "::");
        if cc >= 0 {
            s = str_slice(s, cc + 2, str_len(s));
        }
        if str_len(s) > 0 {
            out.push(s);
        }
    }
    var base: str = name;
    var dbl: i64 = str_find(name, "__");
    if dbl > 0 {
        base = str_slice(name, 0, dbl);
        out.push(base);
        var rest: str = str_slice(name, dbl + 2, str_len(name));
        var dbl2: i64 = str_find(rest, "__");
        if dbl2 > 0 {
            out.push(str_slice(rest, 0, dbl2));
        }
    }
    var us: i64 = str_find(base, "_");
    if us > 0 && us + 1 < str_len(base) {
        out.push(str_slice(base, us + 1, str_len(base)));
        var ul: i64 = str_rfind(base, "_");
        if ul > us && ul + 1 < str_len(base) {
            out.push(str_slice(base, ul + 1, str_len(base)));
        }
    }
    return out;
}

/// DB2: the declaration line of function `name` (`shown` as
/// nat_decl_names takes it) whose first line row is `line` of file
/// `path`: the nearest line at or above it, at most 400 lines up, that
/// holds `fn <one of its names>` before any `//`. `line` itself when there
/// is none, the name is a generated one (`__...`), the file cannot be read
/// or `FID_NAT_OFF=declline`.
pub fn nat_dbg_decl_line(src: & mut NatDeclSrc, path: str, line: i64, name: str, shown: str) -> i64 {
    if line <= 0 || str_len(path) == 0 || str_len(name) == 0 || !nat_dbg_decl_on() {
        return line;
    }
    // a generated function (`__closure_3`, `__own_dup_2`) has no `fn` line
    if str_starts_with(name, "__") {
        return line;
    }
    var fi: i64 = nat_decl_src_index(src, path);
    var cnt: i64 = src.count.get(fi);
    if line > cnt {
        return line;
    }
    var text: str = src.texts.get(fi);
    var tlen: i64 = str_len(text);
    var first: i64 = src.first.get(fi);
    var cands: Vec<str> = nat_decl_names(name, shown);
    var stop: i64 = line - 400;
    if stop < 1 {
        stop = 1;
    }
    var l: i64 = line;
    while l >= stop {
        var a: i64 = src.starts.get(first + l - 1);
        var b: i64 = tlen;
        if l < cnt {
            b = src.starts.get(first + l) - 1;
        }
        // up to a `//` comment
        var c: i64 = a;
        while c + 1 < b {
            if str_byte_at(text, c) == 47 && str_byte_at(text, c + 1) == 47 {
                b = c;
            }
            c = c + 1;
        }
        var ci: i64 = 0;
        while ci < cands.len() {
            if nat_decl_line_has(text, a, b, cands.get(ci)) {
                return l;
            }
            ci = ci + 1;
        }
        l = l - 1;
    }
    return line;
}

/// RL13 R2: whether the debug info writes the build's own paths (`--debug`
/// or `-g`, set by main.fd): a debugger then finds the sources where they
/// were. Otherwise nat_dbg_written_path shortens them.
pub var g_nat_dbg_full_paths: bool = false;

/// Set by main.fd for each native build (`--debug` or `-g`).
pub fn nat_dbg_set_full_paths(on: bool) {
    g_nat_dbg_full_paths = on;
}

fn nat_dbg_slashes(p: str) -> str {
    return str_replace(p, "\\", "/");
}

/// RL13 R2: a file name as the debug info writes it (.debug_line's file
/// table, the compile unit's name). Two hosts that build the same program
/// by absolute path must give the same image, so unless
/// g_nat_dbg_full_paths: FID_DEBUG_PREFIX_MAP=<old>=<new> replaces a
/// leading <old>; else a file in the input file's directory (or below)
/// is written relative to it (the input file is its name alone), a stdlib
/// module from its `stdlib/` on, any other file by its name alone. The
/// files are still read by their real paths (nat_decl_path).
pub fn nat_dbg_written_path(p: str) -> str {
    if g_nat_dbg_full_paths || str_len(p) == 0 {
        return p;
    }
    var q: str = nat_dbg_slashes(p);
    var pm: str = "";
    match env_var("FID_DEBUG_PREFIX_MAP") {
        Option::Some(v) => {
            pm = v;
        }
        Option::None => {
        }
    }
    var eq: i64 = str_find(pm, "=");
    if eq > 0 {
        var old: str = nat_dbg_slashes(str_slice(pm, 0, eq));
        if str_starts_with(q, old) {
            return str_slice(pm, eq + 1, str_len(pm)) + str_slice(q, str_len(old), str_len(q));
        }
    }
    var main_dir: str = "";
    if g_nat_line_files.len() > 0 {
        var m: str = nat_dbg_slashes(g_nat_line_files.get(0));
        var ms: i64 = str_rfind(m, "/");
        if ms >= 0 {
            main_dir = str_slice(m, 0, ms + 1);
        }
    }
    if str_len(main_dir) > 0 && str_starts_with(q, main_dir) {
        return str_slice(q, str_len(main_dir), str_len(q));
    }
    if str_starts_with(q, "stdlib/") {
        return q;
    }
    var si: i64 = str_rfind(q, "/stdlib/");
    if si >= 0 {
        return str_slice(q, si + 1, str_len(q));
    }
    var s: i64 = str_rfind(q, "/");
    if s >= 0 {
        return str_slice(q, s + 1, str_len(q));
    }
    return q;
}

/// DB2: the path of a line row's file `dfile` (1-based, as DW_AT_decl_file
/// and nat_debug_line_at number g_nat_line_files; `file` when that table
/// is empty or its first entry is).
fn nat_decl_path(file: str, dfile: i64) -> str {
    if dfile <= 0 {
        return "";
    }
    if g_nat_line_files.len() == 0 {
        if dfile == 1 {
            return file;
        }
        return "";
    }
    if dfile > g_nat_line_files.len() {
        return "";
    }
    var p: str = g_nat_line_files.get(dfile - 1);
    if dfile == 1 && str_len(p) == 0 {
        return file;
    }
    return p;
}

/// DB4: the source files nat_dbg_scope_end has read (a NatDeclSrc kept
/// for the whole build: one read per file).
pub var g_nat_scope_paths: Vec<str> = Vec::new();
pub var g_nat_scope_texts: Vec<str> = Vec::new();
pub var g_nat_scope_first: Vec<i64> = Vec::new();
pub var g_nat_scope_count: Vec<i64> = Vec::new();
pub var g_nat_scope_starts: Vec<i64> = Vec::new();

/// DB4: the line of the `}` that closes the block holding line `line` of
/// the source file `path` (a declaration's line: where its scope ends),
/// found by scanning forward from the start of that line and counting
/// braces, past string and character literals and `//` comments; 0 when
/// the file cannot be read, the line is past its end, or no such brace
/// comes within 20000 lines.
pub fn nat_dbg_scope_end(path: str, line: i64) -> i64 {
    if line <= 0 || str_len(path) == 0 {
        return 0;
    }
    var src: NatDeclSrc = NatDeclSrc {
        paths: g_nat_scope_paths, texts: g_nat_scope_texts, first: g_nat_scope_first, count: g_nat_scope_count, starts: g_nat_scope_starts
    };
    var fi: i64 = nat_decl_src_index(& mut src, path);
    g_nat_scope_paths = src.paths;
    g_nat_scope_texts = src.texts;
    g_nat_scope_first = src.first;
    g_nat_scope_count = src.count;
    g_nat_scope_starts = src.starts;
    var cnt: i64 = g_nat_scope_count.get(fi);
    if line > cnt {
        return 0;
    }
    var text: str = g_nat_scope_texts.get(fi);
    var n: i64 = str_len(text);
    var k: i64 = g_nat_scope_starts.get(g_nat_scope_first.get(fi) + line - 1);
    var l: i64 = line;
    var depth: i64 = 0;
    while k < n && l < line + 20000 {
        var ch: i64 = str_byte_at(text, k);
        if ch == 10 {
            l = l + 1;
        } else if ch == 47 && k + 1 < n && str_byte_at(text, k + 1) == 47 {
            // a comment, to the end of its line
            while k + 1 < n && str_byte_at(text, k + 1) != 10 {
                k = k + 1;
            }
        } else if ch == 34 {
            // a string, to its closing quote
            k = k + 1;
            while k < n && str_byte_at(text, k) != 34 {
                if str_byte_at(text, k) == 92 {
                    k = k + 1;
                } else if str_byte_at(text, k) == 10 {
                    l = l + 1;
                }
                k = k + 1;
            }
        } else if ch == 39 {
            // a character literal: 'x' or '\x'
            if k + 2 < n && str_byte_at(text, k + 2) == 39 {
                k = k + 2;
            } else if k + 3 < n && str_byte_at(text, k + 1) == 92 && str_byte_at(text, k + 3) == 39 {
                k = k + 3;
            }
        } else if ch == 123 {
            depth = depth + 1;
        } else if ch == 125 {
            depth = depth - 1;
            if depth < 0 {
                return l;
            }
        }
        k = k + 1;
    }
    return 0;
}

/// Abbreviations 7 a function with a frame base, declaration and children,
/// 8 the same with a linkage name, 9 / 10 a parameter / variable with a
/// location, 11 / 12 without one, 13 a pointer type; CT6 14 / 15 with a
/// location list; DB4 18 a lexical block.
fn nat_dbg_abbrevs_ext(abbrev: & mut Vec<i64>) {
    var code: i64 = 7;
    while code <= 8 {
        abbrev.push(code);
        abbrev.push(0x2E);
        abbrev.push(1);
        abbrev.push(0x03);
        abbrev.push(0x08);
        if code == 8 {
            abbrev.push(0x6E);
            abbrev.push(0x08);
        }
        abbrev.push(0x11);
        abbrev.push(0x01);
        abbrev.push(0x12);
        abbrev.push(0x07);
        abbrev.push(0x3F);
        abbrev.push(0x19);
        abbrev.push(0x40);
        abbrev.push(0x18);
        // frame_base, exprloc
        abbrev.push(0x3A);
        abbrev.push(0x05);
        // decl_file, data2
        abbrev.push(0x3B);
        abbrev.push(0x06);
        // decl_line, data4
        abbrev.push(0);
        abbrev.push(0);
        code = code + 1;
    }
    code = 9;
    while code <= 12 {
        abbrev.push(code);
        if code == 9 || code == 11 {
            abbrev.push(0x05);
            // DW_TAG_formal_parameter
        } else {
            abbrev.push(0x34);
            // DW_TAG_variable
        }
        abbrev.push(0);
        abbrev.push(0x03);
        abbrev.push(0x08);
        abbrev.push(0x49);
        abbrev.push(0x13);
        if code <= 10 {
            abbrev.push(0x02);
            abbrev.push(0x18);
            // location, exprloc
        }
        abbrev.push(0);
        abbrev.push(0);
        code = code + 1;
    }
    // 13: DW_TAG_pointer_type; byte_size data1, type ref4
    abbrev.push(13);
    abbrev.push(0x0F);
    abbrev.push(0);
    abbrev.push(0x0B);
    abbrev.push(0x0B);
    abbrev.push(0x49);
    abbrev.push(0x13);
    abbrev.push(0);
    abbrev.push(0);
    // CT6: 14 / 15 a parameter / variable whose location is a location
    // list (.debug_loc, DW_FORM_sec_offset)
    code = 14;
    while code <= 15 {
        abbrev.push(code);
        if code == 14 {
            abbrev.push(0x05);
        } else {
            abbrev.push(0x34);
        }
        abbrev.push(0);
        abbrev.push(0x03);
        abbrev.push(0x08);
        abbrev.push(0x49);
        abbrev.push(0x13);
        abbrev.push(0x02);
        abbrev.push(0x17);
        abbrev.push(0);
        abbrev.push(0);
        code = code + 1;
    }
    // DB4: 18 DW_TAG_lexical_block with children (the variables of a
    // scope, nat_dbg_put_vars); low_pc addr, high_pc data8 (a length)
    abbrev.push(18);
    abbrev.push(0x0B);
    abbrev.push(1);
    abbrev.push(0x11);
    abbrev.push(0x01);
    abbrev.push(0x12);
    abbrev.push(0x07);
    abbrev.push(0);
    abbrev.push(0);
}

/// CT6: the part of a g_nat_dbg_vars location after "@" (its code
/// ranges, "<start>:<end>,..." from the function's start); "" when it has
/// none (the whole function).
fn nat_dbg_loc_ranges(loc: str) -> str {
    var at: i64 = str_find(loc, "@");
    if at < 0 {
        return "";
    }
    return str_slice(loc, at + 1, str_len(loc));
}

/// The DWARF expression of a g_nat_dbg_vars location (empty: none); its
/// ranges (CT6, after "@") are left to nat_dbg_put_vars.
fn nat_dbg_loc_expr(loc0: str) -> Vec<i64> {
    var e: Vec<i64> = Vec::new();
    var loc: str = loc0;
    var at: i64 = str_find(loc0, "@");
    if at >= 0 {
        loc = str_slice(loc0, 0, at);
    }
    if str_len(loc) < 2 {
        return e;
    }
    var kind: i64 = str_byte_at(loc, 0);
    var v: i64 = str_parse_int(str_slice(loc, 1, str_len(loc)));
    if kind == 114 {
        // 'r': DW_OP_reg<n> / DW_OP_regx n
        if v >= 0 && v < 32 {
            e.push(0x50 + v);
        } else if v >= 0 {
            e.push(0x90);
            nat_put_uleb(& mut e, v);
        }
    } else if kind == 102 {
        // 'f': DW_OP_fbreg off (the frame base is the CFA)
        e.push(0x91);
        nat_put_sleb(& mut e, v);
    } else if kind == 99 {
        // 'c': DW_OP_consts v; DW_OP_stack_value
        e.push(0x11);
        nat_put_sleb(& mut e, v);
        e.push(0x9F);
    }
    return e;
}

/// CT9: the location of what a pointer points to, from the location
/// expression `e` of the pointer itself (nat_dbg_loc_expr): in register r,
/// the memory at r + 0 (DW_OP_breg<r> 0 / DW_OP_bregx r 0); in a frame
/// slot, the slot's word read (DW_OP_fbreg off; DW_OP_deref); a constant,
/// the memory at that address. Empty stays empty.
fn nat_dbg_addr_expr(e: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if e.len() == 0 {
        return out;
    }
    var op: i64 = e.get(0);
    if op >= 0x50 && op <= 0x6F && e.len() == 1 {
        out.push(0x70 + (op - 0x50));
        out.push(0);
        return out;
    }
    if op == 0x90 {
        out.push(0x92);
        var k: i64 = 1;
        while k < e.len() {
            out.push(e.get(k));
            k = k + 1;
        }
        out.push(0);
        return out;
    }
    var j: i64 = 0;
    var n: i64 = e.len();
    if op == 0x11 && e.get(n - 1) == 0x9F {
        // the constant is the address: drop DW_OP_stack_value
        n = n - 1;
    }
    while j < n {
        out.push(e.get(j));
        j = j + 1;
    }
    if op == 0x91 {
        out.push(0x06);
    }
    return out;
}

/// The type DIE of each variable type of `vars` (DB4), placed in `info`
/// before the functions: a base type per name, size and encoding; a
/// struct held inline, or (CT9) by its address, refers to its entry of
/// nat_dbg_types (`struct_at`, 0: none); a str to the str type. Returns
/// the map from a variable's type key (nat_dbg_var_key) to its DIE's
/// offset ("*" + key: the variable holds the struct's address).
fn nat_dbg_var_types(info: & mut Vec<i64>, vars: Vec<str>, struct_at: i64) -> i64 {
    var at: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < vars.len() {
        var lines: Vec<str> = str_split(vars.get(fi), "\n");
        var li: i64 = 0;
        while li < lines.len() {
            var p: Vec<str> = str_split(lines.get(li), "\t");
            if p.len() >= 6 {
                var key: str = nat_dbg_var_key(p.get(2), p.get(3), p.get(4));
                if !HashMap_contains(at, key) {
                    var enc: str = p.get(4);
                    if enc == "S" && struct_at != 0 && HashMap_contains(struct_at, p.get(2)) {
                        HashMap_insert(at, key, HashMap_get(struct_at, p.get(2)));
                    } else if enc == "P" && struct_at != 0 && HashMap_contains(struct_at, p.get(2)) {
                        // CT9: a struct the variable holds by its address
                        // shows as the struct, as written (`print p`:
                        // {x = 3, y = 4}); its location becomes the
                        // struct's address (nat_dbg_addr_expr, marked
                        // "*" + key)
                        HashMap_insert(at, key, HashMap_get(struct_at, p.get(2)));
                        HashMap_insert(at, "*" + key, 1);
                    } else if enc == "Z" {
                        // CT9: str, a pointer to its characters
                        if struct_at != 0 && HashMap_contains(struct_at, "\tstr") {
                            HashMap_insert(at, key, HashMap_get(struct_at, "\tstr"));
                        } else {
                            HashMap_insert(at, key, nat_dbg_str_type(info));
                        }
                    } else {
                        // a scalar, or a struct / pointer not described:
                        // a word of that name
                        HashMap_insert(at, key, info.len());
                        info.push(5);
                        var shown: str = p.get(2);
                        var e: i64 = 7;
                        var sz: i64 = str_parse_int(p.get(3));
                        if enc == "P" {
                            shown = "*" + shown;
                            sz = 8;
                        } else if enc != "S" {
                            e = str_parse_int(enc);
                        }
                        if sz <= 0 || sz > 8 {
                            sz = 8;
                        }
                        nat_put_str(info, shown);
                        info.push(e);
                        info.push(sz);
                    }
                }
            }
            li = li + 1;
        }
        fi = fi + 1;
    }
    return at;
}

fn nat_dbg_var_key(tname: str, size: str, enc: str) -> str {
    return tname + "\t" + size + "\t" + enc;
}

/// The children of function `fi` (DB4): its parameters, then its
/// variables, each with its type (`type_at`) and location; then the null
/// entry that ends the function's children. CT6: a location with code
/// ranges ("r3@0:12,40:96") becomes a location list in `dloc`
/// (.debug_loc, DWARF 4: begin and end from the unit's low_pc, `fpc` the
/// function's start from there) when `lists`; else the expression for the
/// whole function, as before.
///
/// DB4: lexical scopes. A "B" line (id, parent id, code range from the
/// function's start: compiler/nat_ir.fd ng_dbg_scope_blocks, in pre-order)
/// becomes a DW_TAG_lexical_block (abbreviation 18: low_pc at `upc` (the
/// unit's low_pc) + `fpc` + start, high_pc its length) inside its parent's,
/// holding the variables whose seventh field is its id; the variables
/// without one are the function's. A range is cut to the function's
/// `flen` bytes; one left empty is dropped with what it holds.
fn nat_dbg_put_vars(info: & mut Vec<i64>, fi: i64, type_at: i64, fpc: i64, dloc: & mut Vec<i64>, lists: bool, upc: i64, flen: i64) {
    if fi < g_nat_dbg_vars.len() {
        var lines: Vec<str> = str_split(g_nat_dbg_vars.get(fi), "\n");
        var pass: i64 = 0;
        while pass < 2 {
            var li: i64 = 0;
            while li < lines.len() {
                var p: Vec<str> = str_split(lines.get(li), "\t");
                var want: str = "P";
                if pass == 1 {
                    want = "V";
                }
                if p.len() >= 6 && p.get(0) == want && (p.len() < 7 || str_len(p.get(6)) == 0) {
                    nat_dbg_put_var(info, p, pass, type_at, fpc, dloc, lists);
                }
                li = li + 1;
            }
            pass = pass + 1;
        }
        // DB4: the scopes, each closed when the next is not inside it
        var open: Vec<str> = Vec::new();
        var bi: i64 = 0;
        while bi < lines.len() {
            var b: Vec<str> = str_split(lines.get(bi), "\t");
            if b.len() >= 5 && b.get(0) == "B" {
                var bid: str = b.get(1);
                var par: str = b.get(2);
                var bs: i64 = str_parse_int(b.get(3));
                var be: i64 = str_parse_int(b.get(4));
                if bs < 0 {
                    bs = 0;
                }
                if be > flen {
                    be = flen;
                }
                var par_open: bool = par == "0";
                var oi: i64 = 0;
                while oi < open.len() {
                    if open.get(oi) == par {
                        par_open = true;
                    }
                    oi = oi + 1;
                }
                if be > bs && par_open {
                    while open.len() > 0 && open.get(open.len() - 1) != par {
                        info.push(0);
                        open.pop();
                    }
                    info.push(18);
                    nat_put_u64(info, upc + fpc + bs);
                    nat_put_u64(info, be - bs);
                    var vi: i64 = 0;
                    while vi < lines.len() {
                        var q: Vec<str> = str_split(lines.get(vi), "\t");
                        if q.len() >= 7 && q.get(0) == "V" && q.get(6) == bid {
                            nat_dbg_put_var(info, q, 1, type_at, fpc, dloc, lists);
                        }
                        vi = vi + 1;
                    }
                    open.push(bid);
                }
            }
            bi = bi + 1;
        }
        while open.len() > 0 {
            info.push(0);
            open.pop();
        }
    }
    info.push(0);
}

/// DB4: one parameter (`pass` 0) or variable (1) of g_nat_dbg_vars, its
/// fields `p`, as nat_dbg_put_vars writes it.
fn nat_dbg_put_var(info: & mut Vec<i64>, p: Vec<str>, pass: i64, type_at: i64, fpc: i64, dloc: & mut Vec<i64>, lists: bool) {
    var key: str = nat_dbg_var_key(p.get(2), p.get(3), p.get(4));
    if str_contains(p.get(5), ";") {
        // DB4: several places, each over its own code ranges (a value
        // split into pieces): one location list; without lists, none
        nat_dbg_put_var_multi(info, p, pass, type_at, key, fpc, dloc, lists);
        return;
    }
    var expr: Vec<i64> = nat_dbg_loc_expr(p.get(5));
    if HashMap_contains(type_at, "*" + key) {
        // CT9: shown as the struct it points to
        expr = nat_dbg_addr_expr(expr);
    }
    var rngs: str = nat_dbg_loc_ranges(p.get(5));
    var as_list: bool = lists && expr.len() > 0 && str_len(rngs) > 0;
    var code: i64 = 9 + pass;
    if expr.len() == 0 {
        code = 11 + pass;
    } else if as_list {
        code = 14 + pass;
    }
    info.push(code);
    nat_put_str(info, p.get(1));
    var tat: i64 = 0;
    if HashMap_contains(type_at, key) {
        tat = HashMap_get(type_at, key);
    }
    nat_put_u32(info, tat);
    if as_list {
        // CT6: the list's offset, then its entries
        nat_put_u32(info, dloc.len());
        var rl: Vec<str> = str_split(rngs, ",");
        var ri: i64 = 0;
        while ri < rl.len() {
            var se: Vec<str> = str_split(rl.get(ri), ":");
            if se.len() == 2 {
                var rs: i64 = str_parse_int(se.get(0));
                var re: i64 = str_parse_int(se.get(1));
                if re > rs && rs >= 0 {
                    nat_put_u64(dloc, fpc + rs);
                    nat_put_u64(dloc, fpc + re);
                    nat_put_u16(dloc, expr.len());
                    var ek: i64 = 0;
                    while ek < expr.len() {
                        dloc.push(expr.get(ek));
                        ek = ek + 1;
                    }
                }
            }
            ri = ri + 1;
        }
        nat_put_u64(dloc, 0);
        nat_put_u64(dloc, 0);
    } else if expr.len() > 0 {
        nat_put_uleb(info, expr.len());
        var k: i64 = 0;
        while k < expr.len() {
            info.push(expr.get(k));
            k = k + 1;
        }
    }
}

/// DB4: a variable whose location has several places ("f-24@0:8;r3@8:40",
/// compiler/nat_ir.fd ng_dbg_split_loc), each with its code ranges: one
/// location list in `dloc` holding every place's entries (`lists`), else
/// no location (one place for the whole function would be wrong where the
/// others hold the value).
fn nat_dbg_put_var_multi(info: & mut Vec<i64>, p: Vec<str>, pass: i64, type_at: i64, key: str, fpc: i64, dloc: & mut Vec<i64>, lists: bool) {
    var code: i64 = 11 + pass;
    if lists {
        code = 14 + pass;
    }
    info.push(code);
    nat_put_str(info, p.get(1));
    var tat: i64 = 0;
    if HashMap_contains(type_at, key) {
        tat = HashMap_get(type_at, key);
    }
    nat_put_u32(info, tat);
    if !lists {
        return;
    }
    nat_put_u32(info, dloc.len());
    var places: Vec<str> = str_split(p.get(5), ";");
    var pi: i64 = 0;
    while pi < places.len() {
        var expr: Vec<i64> = nat_dbg_loc_expr(places.get(pi));
        if HashMap_contains(type_at, "*" + key) {
            expr = nat_dbg_addr_expr(expr);
        }
        var rngs: str = nat_dbg_loc_ranges(places.get(pi));
        if expr.len() > 0 && str_len(rngs) > 0 {
            var rl: Vec<str> = str_split(rngs, ",");
            var ri: i64 = 0;
            while ri < rl.len() {
                var se: Vec<str> = str_split(rl.get(ri), ":");
                if se.len() == 2 {
                    var rs: i64 = str_parse_int(se.get(0));
                    var re: i64 = str_parse_int(se.get(1));
                    if re > rs && rs >= 0 {
                        nat_put_u64(dloc, fpc + rs);
                        nat_put_u64(dloc, fpc + re);
                        nat_put_u16(dloc, expr.len());
                        var ek: i64 = 0;
                        while ek < expr.len() {
                            dloc.push(expr.get(ek));
                            ek = ek + 1;
                        }
                    }
                }
                ri = ri + 1;
            }
        }
        pi = pi + 1;
    }
    nat_put_u64(dloc, 0);
    nat_put_u64(dloc, 0);
}

pub fn nat_elf_debug(arch: i64, image: Vec<i64>, entry: i64, names: Vec<str>, starts: Vec<i64>, ends: Vec<i64>, file: str, lrows: Vec<i64>, cfi: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = nat_elf(arch, image, entry);
    var base: i64 = nat_elf_image_base();
    // .strtab and .symtab
    var strtab: Vec<i64> = Vec::new();
    strtab.push(0);
    // TG13: global function symbols of .text (section 1)
    var fsyms: Vec<ImgSym> = img_func_syms(& names, & starts, & ends, base, 1, IMG_GLOBAL);
    var symtab: Vec<i64> = img_elf_symtab(& fsyms, & mut strtab);
    // .debug_abbrev, .debug_info, .debug_frame and (CT6) .debug_loc, as
    // nat_pe_debug writes them too (nat_dwarf_build)
    var dw: NatDwarf = nat_dwarf_build(arch, image, base, names, starts, ends, file, lrows, cfi, true);
    var abbrev: Vec<i64> = dw.abbrev;
    var info: Vec<i64> = dw.info;
    var frame: Vec<i64> = dw.frame;
    var dloc: Vec<i64> = dw.dloc;
    // DB6: .eh_frame and .eh_frame_hdr (PT_GNU_EH_FRAME) right after the
    // image, for the unwinders that read only those (nat_elf_eh_frame;
    // `FID_NAT_OFF=ehframe`: none)
    var eh: Vec<i64> = Vec::new();
    if nat_eh_frame_on() {
        out = nat_elf_eh_frame(out, image.len(), & frame, & mut eh);
    }
    // TG13: the sections and their headers from image_writer (the old
    // body, checked byte for byte against it on Nov 17 with
    // FID_NAT_OFF=ehframe, is gone: docs/image-writer.md)
    return nat_elf_debug_sections(out, image.len(), base, symtab, strtab, abbrev, info, frame, file, lrows, dloc, eh);
}

/// CT6: the DWARF of a native image that an ELF (nat_elf_debug) and a
/// `--nat` PE (nat_pe_debug) share: .debug_abbrev, .debug_info (the compile
/// unit, its types, a subprogram per function with its parameters and
/// variables), .debug_frame (a CIE, an FDE per function) and .debug_loc
/// (the location lists of values held in registers; empty when `lists` is
/// off or nothing needs one).
pub struct NatDwarf {
    pub abbrev: Vec<i64>,
    pub info: Vec<i64>,
    pub frame: Vec<i64>,
    pub dloc: Vec<i64>,
}

/// CT6: the DWARF sections of `image` (code offset 0 at address `base`)
/// for nat_elf_debug and nat_pe_debug: the functions `names` at [starts,
/// ends), the line rows `lrows` (their declarations), the frame rows `cfi`
/// (DB6), the variables of g_nat_dbg_vars (DB4) with location lists when
/// `lists` (.debug_loc), the types and names of g_nat_dbg_types /
/// g_nat_dbg_shown (CT9).
pub fn nat_dwarf_build(arch: i64, image: Vec<i64>, base: i64, names: Vec<str>, starts: Vec<i64>, ends: Vec<i64>, file: str, lrows: Vec<i64>, cfi: Vec<i64>, lists: bool) -> NatDwarf {
    var i: i64 = 0;
    // .debug_abbrev: 1 the compile unit, 2 a function
    var abbrev: Vec<i64> = Vec::new();
    abbrev.push(1);
    abbrev.push(0x11);
    abbrev.push(1);
    abbrev.push(0x25);
    abbrev.push(0x08);
    // producer, string
    abbrev.push(0x13);
    abbrev.push(0x05);
    // language, data2
    abbrev.push(0x03);
    abbrev.push(0x08);
    // name, string
    abbrev.push(0x11);
    abbrev.push(0x01);
    // low_pc, addr
    abbrev.push(0x12);
    abbrev.push(0x07);
    // high_pc, data8 (a length)
    abbrev.push(0x10);
    abbrev.push(0x17);
    // stmt_list, sec_offset
    abbrev.push(0);
    abbrev.push(0);
    abbrev.push(2);
    abbrev.push(0x2E);
    abbrev.push(0);
    abbrev.push(0x03);
    abbrev.push(0x08);
    abbrev.push(0x11);
    abbrev.push(0x01);
    abbrev.push(0x12);
    abbrev.push(0x07);
    abbrev.push(0x3F);
    abbrev.push(0x19);
    // external, flag_present
    abbrev.push(0);
    abbrev.push(0);
    // CT9: the struct types and the names as Fides writes them
    // (g_nat_dbg_types, g_nat_dbg_shown); without them the sections are
    // what they were
    if g_nat_dbg_types.len() > 0 || g_nat_dbg_shown.len() > 0 || g_nat_dbg_ext {
        nat_dbg_abbrevs(& mut abbrev);
    }
    // DB2/DB4: frame bases, declarations, variables
    if g_nat_dbg_ext {
        nat_dbg_abbrevs_ext(& mut abbrev);
    }
    abbrev.push(0);
    // .debug_info (DWARF 4)
    var info: Vec<i64> = Vec::new();
    nat_put_u32(& mut info, 0);
    // unit length, set below
    nat_put_u16(& mut info, 4);
    nat_put_u32(& mut info, 0);
    // abbrev offset
    info.push(8);
    // address size
    info.push(1);
    nat_put_str(& mut info, "fid (Fides)");
    nat_put_u16(& mut info, 0x0C);
    // DW_LANG_C99: what debuggers expect
    if file == "" {
        nat_put_str(& mut info, "fides");
    } else {
        // RL13 R2: the input file's name, not its path, unless --debug / -g
        nat_put_str(& mut info, nat_dbg_written_path(file));
    }
    var lo: i64 = 0;
    var hi: i64 = image.len();
    if starts.len() > 0 {
        lo = starts.get(0);
        hi = ends.get(ends.len() - 1);
    }
    nat_put_u64(& mut info, base + lo);
    nat_put_u64(& mut info, hi - lo);
    nat_put_u32(& mut info, 0);
    // the line program at .debug_line + 0
    var dbg_sat: i64 = 0;
    if g_nat_dbg_types.len() > 0 {
        dbg_sat = nat_dbg_types(& mut info, g_nat_dbg_types);
    }
    // DB4: the variables' types
    var dbg_vat: i64 = 0;
    // CT6: the location lists of values held in registers (.debug_loc;
    // only with image_writer's sections, nat_elf_debug_sections)
    var dloc: Vec<i64> = Vec::new();
    if g_nat_dbg_ext {
        dbg_vat = nat_dbg_var_types(& mut info, g_nat_dbg_vars, dbg_sat);
    }
    // DB2: the line rows, in image order, give each function its
    // declaration file (the first row inside it) and, read from that
    // file, its `fn` line (nat_dbg_decl_line)
    var dri: i64 = 0;
    var dsrc: NatDeclSrc = NatDeclSrc_new();
    i = 0;
    while i < names.len() {
        // CT9: a method as written (Point::len), its symbol (Point_len) as
        // the linkage name
        var shown: str = "";
        if i < g_nat_dbg_shown.len() {
            shown = g_nat_dbg_shown.get(i);
        }
        var with_link: bool = str_len(shown) > 0 && shown != names.get(i);
        if g_nat_dbg_ext {
            if with_link {
                info.push(8);
                nat_put_str(& mut info, shown);
                nat_put_str(& mut info, names.get(i));
            } else {
                info.push(7);
                nat_put_str(& mut info, names.get(i));
            }
        } else if with_link {
            info.push(6);
            nat_put_str(& mut info, shown);
            nat_put_str(& mut info, names.get(i));
        } else {
            info.push(2);
            nat_put_str(& mut info, names.get(i));
        }
        nat_put_u64(& mut info, base + starts.get(i));
        nat_put_u64(& mut info, ends.get(i) - starts.get(i));
        if g_nat_dbg_ext {
            // frame_base: DW_OP_call_frame_cfa
            info.push(1);
            info.push(0x9C);
            var dfile: i64 = 0;
            var dline: i64 = 0;
            while dri + 2 < lrows.len() && lrows.get(dri) < starts.get(i) {
                dri = dri + 3;
            }
            var dk: i64 = dri;
            while dline == 0 && dk + 2 < lrows.len() && lrows.get(dk) < ends.get(i) {
                if (lrows.get(dk + 2) & 1) == 0 && lrows.get(dk + 1) > 0 {
                    dfile = (lrows.get(dk + 2) >> 1) + 1;
                    dline = lrows.get(dk + 1);
                }
                dk = dk + 3;
            }
            dline = nat_dbg_decl_line(& mut dsrc, nat_decl_path(file, dfile), dline, names.get(i), shown);
            nat_put_u16(& mut info, dfile);
            nat_put_u32(& mut info, dline);
            nat_dbg_put_vars(& mut info, i, dbg_vat, starts.get(i) - lo, & mut dloc, lists, base + lo, ends.get(i) - starts.get(i));
        }
        i = i + 1;
    }
    info.push(0);
    nat_set_u32(& mut info, 0, info.len() - 4);
    // .debug_frame: one CIE, an FDE per function
    var frame: Vec<i64> = Vec::new();
    nat_put_u32(& mut frame, 0);
    // CIE length, set below
    nat_put_u32(& mut frame, 4294967295);
    // CIE id
    frame.push(1);
    // version
    frame.push(0);
    // augmentation ""
    frame.push(nat_code_align(arch));
    // code alignment (TG9: 2 on RISC-V with RVC)
    frame.push(0x78);
    // data alignment -8
    if arch == NAT_A64 {
        frame.push(30);
    } else if arch == NAT_X64 {
        frame.push(16);
    } else {
        frame.push(1);
    }
    // The entry state of every function; DB6: the frame pointer and the
    // return address register hold the caller's values (same_value), which
    // an epilogue's DW_CFA_restore returns to
    if arch == NAT_X64 {
        frame.push(0x0C);
        frame.push(7);
        frame.push(8);
        // def_cfa rsp, 8
        frame.push(0x80 | 16);
        frame.push(1);
        // rip at cfa - 8
        frame.push(0x08);
        frame.push(6);
        // same_value rbp
    } else {
        frame.push(0x0C);
        // def_cfa sp, 0
        if arch == NAT_A64 {
            frame.push(31);
        } else {
            frame.push(2);
        }
        frame.push(0);
        frame.push(0x08);
        if arch == NAT_A64 {
            frame.push(29);
            frame.push(0x08);
            frame.push(30);
            // same_value x29, x30
        } else {
            frame.push(8);
            frame.push(0x08);
            frame.push(1);
            // same_value s0, ra
        }
    } while frame.len() % 8 != 0 {
        frame.push(0);
    }
    nat_set_u32(& mut frame, 0, frame.len() - 4);
    i = 0;
    var ci: i64 = 0;
    while i < names.len() {
        var at: i64 = frame.len();
        nat_put_u32(& mut frame, 0);
        nat_put_u32(& mut frame, 0);
        // the CIE at offset 0
        nat_put_u64(& mut frame, base + starts.get(i));
        nat_put_u64(& mut frame, ends.get(i) - starts.get(i));
        // DB6: a framed function's prologue and epilogues; a leaf (no
        // frame record) keeps the CIE's entry rules
        while ci + 2 < cfi.len() && cfi.get(ci) < starts.get(i) {
            ci = ci + 3;
        }
        if nat_has_frame(arch, & image, starts.get(i)) {
            nat_fde_body(arch, & mut frame);
            var loc: i64 = starts.get(i) + nat_prologue_len(arch);
            // DB6: the callee-saved registers the prologue stored
            // (nat_ir.fd ng_cfi_saves: p2 = -2 - (reg | n << 8)), saved
            // at CFA - 8n until an epilogue restores them
            var saved: Vec<i64> = Vec::new();
            while ci + 2 < cfi.len() && cfi.get(ci) < ends.get(i) {
                var p2: i64 = cfi.get(ci + 1);
                if p2 <= 0 - 2 {
                    if cfi.get(ci) >= loc {
                        var code: i64 = 0 - 2 - p2;
                        nat_cfa_advance(arch, & mut frame, cfi.get(ci) - loc);
                        loc = cfi.get(ci);
                        // (DB6: a register named again leaves `saved`
                        // first, so an epilogue restores it once)
                        var kept: Vec<i64> = Vec::new();
                        var sk: i64 = 0;
                        while sk < saved.len() {
                            if saved.get(sk) != (code & 63) {
                                kept.push(saved.get(sk));
                            }
                            sk = sk + 1;
                        }
                        saved = kept;
                        if (code >> 8) == 0 {
                            // DB6: n = 0, a save RA12 deferred that is
                            // given back here or not made on the way to
                            // this block (nat_ir.fd ng_dbg_sw_to): the
                            // CIE's rule again (DW_CFA_restore reg)
                            frame.push(0xC0 | (code & 63));
                        } else {
                            frame.push(0x80 | (code & 63));
                            nat_put_uleb(& mut frame, code >> 8);
                            // DW_CFA_offset reg, n
                            saved.push(code & 63);
                        }
                    }
                } else if cfi.get(ci) > loc {
                    loc = nat_fde_epilogue(arch, & mut frame, loc, cfi.get(ci), p2, cfi.get(ci + 2), ends.get(i), & saved);
                }
                ci = ci + 3;
            }
        }
        while (frame.len() - at) % 8 != 0 {
            frame.push(0);
        }
        nat_set_u32(& mut frame, at, frame.len() - at - 4);
        i = i + 1;
    }
    return NatDwarf { abbrev: abbrev, info: info, frame: frame, dloc: dloc };
}

/// TG13: nat_elf_debug's sections after the executable `elf` (an image of
/// `image_len` bytes at `base`): .symtab, .strtab and the DWARF, 8-aligned
/// after the loaded image, then the section headers (image_writer).
/// CT6: `dloc`, when not empty, is .debug_loc (the last section).
/// DB6: `eh`, when not empty, places .eh_frame_hdr and .eh_frame in the
/// loaded image (nat_elf_eh_frame's [hdr offset, length, address, frame
/// offset, length, address]); their headers come last.
fn nat_elf_debug_sections(elf: Vec<i64>, image_len: i64, base: i64, symtab: Vec<i64>, strtab: Vec<i64>, abbrev: Vec<i64>, info: Vec<i64>, frame: Vec<i64>, file: str, lrows: Vec<i64>, dloc: Vec<i64>, eh: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = elf;
    var shnames: Vec<str> = Vec::new();
    shnames.push("");
    shnames.push(".text");
    shnames.push(".symtab");
    shnames.push(".strtab");
    shnames.push(".debug_abbrev");
    shnames.push(".debug_info");
    shnames.push(".debug_frame");
    shnames.push(".shstrtab");
    shnames.push(".debug_line");
    if dloc.len() > 0 {
        shnames.push(".debug_loc");
    }
    var has_eh: bool = eh.len() >= 6;
    if has_eh {
        shnames.push(".eh_frame_hdr");
        shnames.push(".eh_frame");
    }
    // TG13: a dynamically linked image (CI2) names its PT_INTERP and
    // PT_DYNAMIC as .interp and .dynamic too: with section headers and no
    // SHT_DYNAMIC one, readelf says "no .dynamic section in the dynamic
    // segment" (the loader reads only the segments). .dynamic's sh_link is
    // the string table DT_STRTAB / DT_STRSZ give (.dynstr); without them
    // (never in an image ng_gen_ldyn made) .strtab, so it is a string table
    var has_dyn: bool = g_nat_ldyn_dyn >= 0 && g_nat_ldyn_interp >= 0 && g_nat_ldyn_dyn + g_nat_ldyn_dyn_len <= image_len && g_nat_ldyn_interp + g_nat_ldyn_interp_len <= image_len;
    var dstr_off: i64 = 0 - 1;
    var dstr_len: i64 = 0;
    if has_dyn {
        var dstr_addr: i64 = nat_elf_dyn_value(& out, 5);
        dstr_len = nat_elf_dyn_value(& out, 10);
        if dstr_addr >= base && dstr_len > 0 && dstr_addr - base + dstr_len <= image_len {
            dstr_off = dstr_addr - base;
        }
        shnames.push(".interp");
        if dstr_off >= 0 {
            shnames.push(".dynstr");
        }
        shnames.push(".dynamic");
    }
    var fname: str = file;
    if fname == "" {
        fname = "fides";
    }
    var parts: Vec<Vec<i64>> = Vec::new();
    parts.push(symtab);
    parts.push(strtab);
    parts.push(abbrev);
    parts.push(info);
    parts.push(frame);
    parts.push(img_elf_shstrtab(& shnames));
    parts.push(nat_debug_line(fname, lrows));
    if dloc.len() > 0 {
        parts.push(dloc);
    }
    var offs: Vec<i64> = img_place_parts(& mut out, & parts, 8);
    var secs: Vec<ImgSec> = Vec::new();
    secs.push(img_sec("", 0, 0, 0, 0, 0, 0, 0, 0, 0));
    secs.push(img_sec(".text", 1, 7, base, 0x1000, image_len, 0, 0, 16, 0));
    // PROGBITS, WRITE | ALLOC | EXECINSTR: the loaded image
    secs.push(img_sec(".symtab", 2, 0, 0, offs.get(0), parts.get(0).len(), 3, 1, 8, 24));
    // SYMTAB, names in 3, every symbol global (sh_info 1)
    secs.push(img_sec(".strtab", 3, 0, 0, offs.get(1), parts.get(1).len(), 0, 0, 1, 0));
    secs.push(img_sec(".debug_abbrev", 1, 0, 0, offs.get(2), parts.get(2).len(), 0, 0, 1, 0));
    secs.push(img_sec(".debug_info", 1, 0, 0, offs.get(3), parts.get(3).len(), 0, 0, 1, 0));
    secs.push(img_sec(".debug_frame", 1, 0, 0, offs.get(4), parts.get(4).len(), 0, 0, 8, 0));
    secs.push(img_sec(".shstrtab", 3, 0, 0, offs.get(5), parts.get(5).len(), 0, 0, 1, 0));
    secs.push(img_sec(".debug_line", 1, 0, 0, offs.get(6), parts.get(6).len(), 0, 0, 1, 0));
    if dloc.len() > 0 {
        secs.push(img_sec(".debug_loc", 1, 0, 0, offs.get(7), parts.get(7).len(), 0, 0, 1, 0));
    }
    if has_eh {
        // DB6: PROGBITS, ALLOC: inside the image's last PT_LOAD
        secs.push(img_sec(".eh_frame_hdr", 1, 2, eh.get(2), eh.get(0), eh.get(1), 0, 0, 4, 0));
        secs.push(img_sec(".eh_frame", 1, 2, eh.get(5), eh.get(3), eh.get(4), 0, 0, 8, 0));
    }
    if has_dyn {
        // PROGBITS, ALLOC; DYNAMIC, WRITE | ALLOC, 16-byte entries: the
        // bytes of PT_INTERP and PT_DYNAMIC (file offset 0x1000 + image
        // offset, as nat_elf_img's program headers say)
        secs.push(img_sec(".interp", 1, 2, base + g_nat_ldyn_interp, 0x1000 + g_nat_ldyn_interp, g_nat_ldyn_interp_len, 0, 0, 1, 0));
        var dlink: i64 = 3;
        if dstr_off >= 0 {
            // STRTAB, ALLOC
            dlink = secs.len();
            secs.push(img_sec(".dynstr", 3, 2, base + dstr_off, 0x1000 + dstr_off, dstr_len, 0, 0, 1, 0));
        }
        secs.push(img_sec(".dynamic", 6, 3, base + g_nat_ldyn_dyn, 0x1000 + g_nat_ldyn_dyn, g_nat_ldyn_dyn_len, dlink, 0, 8, 16));
    }
    img_elf_sections(& mut out, & secs);
    return out;
}

/// TG13: the value of the first entry tagged `tag` in the dynamic section
/// of the executable `elf` (nat_elf's PT_DYNAMIC: file offset 0x1000 +
/// g_nat_ldyn_dyn), or -1 (none before DT_NULL).
fn nat_elf_dyn_value(elf: & Vec<i64>, tag: i64) -> i64 {
    var at: i64 = 0x1000 + g_nat_ldyn_dyn;
    var end: i64 = at + g_nat_ldyn_dyn_len;
    while at + 16 <= end && at + 16 <= elf.len() {
        // the words' high halves are 0 for every tag and address we read
        var t: i64 = nat_le32_at(elf, at);
        var th: i64 = nat_le32_at(elf, at + 4);
        if t == 0 && th == 0 {
            return 0 - 1;
        }
        if t == tag && th == 0 {
            if nat_le32_at(elf, at + 12) != 0 {
                return 0 - 1;
            }
            return nat_le32_at(elf, at + 8);
        }
        at = at + 16;
    }
    return 0 - 1;
}

/// DB6: false when `FID_NAT_OFF` names `ehframe` (the image as before:
/// no .eh_frame, no PT_GNU_EH_FRAME).
pub fn nat_eh_frame_on() -> bool {
    var off: str = "";
    match env_var("FID_NAT_OFF") {
        Option::Some(v) => {
            off = v;
        }
        Option::None => {
        }
    }
    if str_len(off) == 0 {
        return true;
    }
    return !str_contains("," + off + ",", ",ehframe,");
}

/// DB6: the number of FDEs of nat_dwarf_build's .debug_frame `frame` (a
/// CIE at 0, then the FDEs).
fn nat_frame_fde_count(frame: & Vec<i64>) -> i64 {
    if frame.len() < 8 {
        return 0;
    }
    var q: i64 = 4 + nat_elf_rd(frame, 0, 4);
    var n: i64 = 0;
    var going: bool = true;
    while going && q + 24 <= frame.len() {
        var flen: i64 = nat_elf_rd(frame, q, 4);
        if flen < 20 || q + 4 + flen > frame.len() {
            going = false;
        } else {
            n = n + 1;
            q = q + 4 + flen;
        }
    }
    return n;
}

/// DB6: .eh_frame from nat_dwarf_build's .debug_frame `frame` (a version 1
/// CIE with no augmentation at 0, then FDEs [length, CIE 0, start (8
/// bytes), length (8), rules]), placed at address `eh_addr`: the CIE with
/// augmentation "zR" and FDE addresses pc-relative in 4 bytes
/// (DW_EH_PE_pcrel | sdata4), each FDE with the same rules, entries
/// 8-aligned with DW_CFA_nop, then a zero terminator. `fdes` gets [start
/// address, offset in .eh_frame] for each FDE. Empty when `frame` is not
/// that shape.
pub fn nat_eh_frame(frame: & Vec<i64>, eh_addr: i64, fdes: & mut Vec<i64>) -> Vec<i64> {
    var eh: Vec<i64> = Vec::new();
    fdes.clear();
    if frame.len() < 16 {
        return eh;
    }
    var cend: i64 = 4 + nat_elf_rd(frame, 0, 4);
    if cend > frame.len() || nat_elf_rd(frame, 4, 4) != 4294967295 || frame.get(8) != 1 {
        return eh;
    }
    // the augmentation string, the code and data alignment, the return
    // address column (one byte in version 1), the initial rules
    var p: i64 = 9;
    while p < cend && frame.get(p) != 0 {
        p = p + 1;
    }
    p = p + 1;
    var align_at: i64 = p;
    while p < cend && (frame.get(p) & 128) != 0 {
        p = p + 1;
    }
    p = p + 1;
    while p < cend && (frame.get(p) & 128) != 0 {
        p = p + 1;
    }
    p = p + 1;
    if p >= cend {
        return eh;
    }
    var align_end: i64 = p;
    var ra: i64 = frame.get(p);
    p = p + 1;
    nat_put_u32(& mut eh, 0);
    // length, set below
    nat_put_u32(& mut eh, 0);
    // CIE id 0 (.eh_frame's)
    eh.push(1);
    eh.push(0x7A);
    eh.push(0x52);
    eh.push(0);
    // version 1, augmentation "zR"
    img_append_range(& mut eh, frame, align_at, align_end);
    nat_put_uleb(& mut eh, ra);
    eh.push(1);
    // augmentation data: 1 byte, the FDE address encoding
    eh.push(0x1B);
    // DW_EH_PE_pcrel | DW_EH_PE_sdata4
    img_append_range(& mut eh, frame, p, cend);
    while eh.len() % 8 != 0 {
        eh.push(0);
    }
    nat_set_u32(& mut eh, 0, eh.len() - 4);
    var q: i64 = cend;
    var going: bool = true;
    while going && q + 24 <= frame.len() {
        var flen: i64 = nat_elf_rd(frame, q, 4);
        if flen < 20 || q + 4 + flen > frame.len() {
            going = false;
        } else {
            var start: i64 = nat_elf_rd(frame, q + 8, 8);
            var range: i64 = nat_elf_rd(frame, q + 16, 8);
            var at: i64 = eh.len();
            nat_put_u32(& mut eh, 0);
            // length, set below
            nat_put_u32(& mut eh, at + 4);
            // CIE pointer: back from this field to the CIE at 0
            nat_put_u32(& mut eh, start - (eh_addr + at + 8));
            // pc_begin, from this field
            nat_put_u32(& mut eh, range);
            eh.push(0);
            // no augmentation data
            img_append_range(& mut eh, frame, q + 24, q + 4 + flen);
            while eh.len() % 8 != 0 {
                eh.push(0);
            }
            nat_set_u32(& mut eh, at, eh.len() - at - 4);
            fdes.push(start);
            fdes.push(at);
            q = q + 4 + flen;
        }
    }
    nat_put_u32(& mut eh, 0);
    // the terminator
    return eh;
}

/// DB6: .eh_frame_hdr at address `hdr_addr` for the .eh_frame at
/// `eh_addr` whose FDEs nat_eh_frame listed in `fdes` ([start, offset]):
/// version 1, .eh_frame's address pc-relative, the FDE count, and the
/// binary search table [start, FDE address] relative to the header,
/// sorted by start (one entry per start).
pub fn nat_eh_frame_hdr(hdr_addr: i64, eh_addr: i64, fdes: & Vec<i64>) -> Vec<i64> {
    var n: i64 = fdes.len() / 2;
    // the FDEs in order of their start (a merge sort of their indexes)
    var ord: Vec<i64> = Vec::new();
    var tmp: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        ord.push(i);
        tmp.push(0);
        i = i + 1;
    }
    var width: i64 = 1;
    while width < n {
        var lo: i64 = 0;
        while lo < n {
            var mid: i64 = lo + width;
            if mid > n {
                mid = n;
            }
            var hi: i64 = lo + 2 * width;
            if hi > n {
                hi = n;
            }
            var a: i64 = lo;
            var b: i64 = mid;
            var o: i64 = lo;
            while o < hi {
                var take_a: bool = false;
                if a < mid && b < hi {
                    take_a = fdes.get(2 * ord.get(a)) <= fdes.get(2 * ord.get(b));
                } else {
                    take_a = a < mid;
                }
                if take_a {
                    tmp.set(o, ord.get(a));
                    a = a + 1;
                } else {
                    tmp.set(o, ord.get(b));
                    b = b + 1;
                }
                o = o + 1;
            }
            lo = hi;
        }
        i = 0;
        while i < n {
            ord.set(i, tmp.get(i));
            i = i + 1;
        }
        width = width * 2;
    }
    var table: Vec<i64> = Vec::new();
    var count: i64 = 0;
    var last: i64 = 0;
    i = 0;
    while i < n {
        var f: i64 = ord.get(i);
        var st: i64 = fdes.get(2 * f);
        if count == 0 || st != last {
            nat_put_u32(& mut table, st - hdr_addr);
            nat_put_u32(& mut table, eh_addr + fdes.get(2 * f + 1) - hdr_addr);
            count = count + 1;
            last = st;
        }
        i = i + 1;
    }
    var h: Vec<i64> = Vec::new();
    h.push(1);
    // version
    h.push(0x1B);
    // eh_frame_ptr: pcrel sdata4
    h.push(0x03);
    // fde_count: udata4
    h.push(0x3B);
    // the table: datarel sdata4
    nat_put_u32(& mut h, eh_addr - (hdr_addr + 4));
    nat_put_u32(& mut h, count);
    img_append(& mut h, & table);
    return h;
}

/// DB6: the executable `elf` (nat_elf's: the image of `image_len` bytes at
/// file offset 0x1000, ending the file) with .eh_frame_hdr and .eh_frame
/// (from the .debug_frame `frame`) after the image, 8-aligned: the PT_LOAD
/// that ends at the image's end (the data, or the one RWX segment) grows
/// over them, so they are mapped at addresses that keep their file
/// offsets' distance, and a PT_GNU_EH_FRAME names the header for
/// unwinders (libgcc, libunwind, perf, gdb). `eh` gets [hdr offset,
/// length, address, .eh_frame offset, length, address]. Unchanged (and
/// `eh` empty) when the program headers leave no room or no PT_LOAD ends
/// at the image's end.
pub fn nat_elf_eh_frame(elf: Vec<i64>, image_len: i64, frame: & Vec<i64>, eh: & mut Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = elf;
    eh.clear();
    var fend: i64 = 0x1000 + image_len;
    var nf: i64 = nat_frame_fde_count(frame);
    if out.len() != fend || nf == 0 {
        return out;
    }
    var phoff: i64 = nat_elf_rd(& out, 0x20, 8);
    var phnum: i64 = nat_elf_rd(& out, 0x38, 2);
    if phoff < 64 || phoff + 56 * (phnum + 1) > 0x1000 {
        return out;
    }
    // the PT_LOAD whose file bytes end where the image does
    var li: i64 = 0 - 1;
    var i: i64 = 0;
    while i < phnum {
        var at: i64 = phoff + 56 * i;
        if nat_elf_rd(& out, at, 4) == 1 && nat_elf_rd(& out, at + 8, 8) + nat_elf_rd(& out, at + 32, 8) == fend && nat_elf_rd(& out, at + 32, 8) == nat_elf_rd(& out, at + 40, 8) {
            li = at;
        }
        i = i + 1;
    }
    // (the room for one more program header must be the padding)
    var slot: i64 = phoff + 56 * phnum;
    i = slot;
    while i < slot + 56 {
        if out.get(i) != 0 {
            return out;
        }
        i = i + 1;
    }
    if li < 0 {
        return out;
    }
    var seg_off: i64 = nat_elf_rd(& out, li + 8, 8);
    var seg_addr: i64 = nat_elf_rd(& out, li + 16, 8);
    var hoff: i64 = (fend + 7) / 8 * 8;
    var hdr_addr: i64 = seg_addr + (hoff - seg_off);
    var hlen: i64 = 12 + 8 * nf;
    var eoff: i64 = hoff + (hlen + 7) / 8 * 8;
    var eh_addr: i64 = seg_addr + (eoff - seg_off);
    var fdes: Vec<i64> = Vec::new();
    var ehf: Vec<i64> = nat_eh_frame(frame, eh_addr, & mut fdes);
    if ehf.len() == 0 {
        return out;
    }
    var hdr: Vec<i64> = nat_eh_frame_hdr(hdr_addr, eh_addr, & fdes);
    img_pad_to(& mut out, hoff);
    img_append(& mut out, & hdr);
    img_pad_to(& mut out, eoff);
    img_append(& mut out, & ehf);
    var grow: i64 = out.len() - fend;
    nat_set_u64(& mut out, li + 32, nat_elf_rd(& out, li + 32, 8) + grow);
    nat_set_u64(& mut out, li + 40, nat_elf_rd(& out, li + 40, 8) + grow);
    // PT_GNU_EH_FRAME, read-only, 4-aligned
    nat_set_u32(& mut out, slot, 0x6474E550);
    nat_set_u32(& mut out, slot + 4, 4);
    nat_set_u64(& mut out, slot + 8, hoff);
    nat_set_u64(& mut out, slot + 16, hdr_addr);
    nat_set_u64(& mut out, slot + 24, hdr_addr);
    nat_set_u64(& mut out, slot + 32, hdr.len());
    nat_set_u64(& mut out, slot + 40, hdr.len());
    nat_set_u64(& mut out, slot + 48, 4);
    nat_set_u16(& mut out, 0x38, phnum + 1);
    // TG14: a PT_PHDR (nat_elf_img, first) covers every program header
    if nat_elf_rd(& out, phoff, 4) == 6 {
        nat_set_u64(& mut out, phoff + 32, 56 * (phnum + 1));
        nat_set_u64(& mut out, phoff + 40, 56 * (phnum + 1));
    }
    eh.push(hoff);
    eh.push(hdr.len());
    eh.push(hdr_addr);
    eh.push(eoff);
    eh.push(ehf.len());
    eh.push(eh_addr);
    return out;
}

// ---------------------------------------------------------------------------
// x86-64 (own-backend roadmap MI15): the encodings the machine layer selects
// for Linux x86-64. Registers are the hardware numbers (rax 0, rcx 1, rdx 2,
// rbx 3, rsp 4, rbp 5, rsi 6, rdi 7, r8..r15 8..15); xmm registers 0..15.
// ---------------------------------------------------------------------------

pub const NAT_X64: i64 = 3; pub const NATFIX_X64_REL32: i64 = 7; pub const NATFIX_RVA32: i64 = 8;  // 4 data bytes: the label's PE RVA

// Condition codes (the low nibble of Jcc / SETcc)
pub const X64_O: i64 = 0; pub const X64_B: i64 = 2; pub const X64_AE: i64 = 3; pub const X64_E: i64 = 4; pub const X64_NE: i64 = 5; pub const X64_BE: i64 = 6; pub const X64_A: i64 = 7; pub const X64_S: i64 = 8; pub const X64_P: i64 = 10; pub const X64_NP: i64 = 11; pub const X64_L: i64 = 12; pub const X64_GE: i64 = 13; pub const X64_LE: i64 = 14; pub const X64_G: i64 = 15;  /// A REX prefix when one is needed (or `force`: byte access to spl..dil).
fn x64_rex(e: & mut NatEnc, w: bool, reg: i64, index: i64, base: i64, force: bool) {
    var r: i64 = 0x40;
    if w {
        r = r | 8;
    }
    if reg >= 8 {
        r = r | 4;
    }
    if index >= 8 {
        r = r | 2;
    }
    if base >= 8 {
        r = r | 1;
    }
    if r != 0x40 || force {
        NatEnc_byte(e, r);
    }
}

fn x64_modrm_rr(e: & mut NatEnc, reg: i64, rm: i64) {
    NatEnc_byte(e, 0xC0 | ((reg & 7) << 3) | (rm & 7));
}

fn x64_fits8(v: i64) -> bool {
    return v >= 0 - 128 && v <= 127;
}

/// ModRM (+ SIB, displacement) for [base + disp].
fn x64_modrm_mem(e: & mut NatEnc, reg: i64, base: i64, disp: i64) {
    var b: i64 = base & 7;
    var md: i64 = 2;
    if disp == 0 && b != 5 {
        md = 0;
    } else if x64_fits8(disp) {
        md = 1;
    }
    NatEnc_byte(e, (md << 6) | ((reg & 7) << 3) | b);
    if b == 4 {
        NatEnc_byte(e, 0x24);
    }
    if md == 1 {
        NatEnc_byte(e, disp & 255);
    }
    if md == 2 {
        NatEnc_u32(e, disp);
    }
}

pub fn NatEnc_u32(e: & mut NatEnc, v: i64) {
    NatEnc_byte(e, v & 255);
    NatEnc_byte(e, (v >> 8) & 255);
    NatEnc_byte(e, (v >> 16) & 255);
    NatEnc_byte(e, (v >> 24) & 255);
}

/// A 32-bit field relative to its own end, filled with label later.
fn x64_rel32(e: & mut NatEnc, label: i64) {
    NatEnc_fix(e, label, NATFIX_X64_REL32);
    NatEnc_u32(e, 0);
}

pub fn x64_mov(e: & mut NatEnc, d: i64, s: i64) {
    x64_rex(e, true, s, 0, d, false);
    NatEnc_byte(e, 0x89);
    x64_modrm_rr(e, s, d);
}

/// mov r32, r32: the low 32 bits, zero-extended
pub fn x64_mov32(e: & mut NatEnc, d: i64, s: i64) {
    x64_rex(e, false, s, 0, d, false);
    NatEnc_byte(e, 0x89);
    x64_modrm_rr(e, s, d);
}

@wrapping pub fn x64_li(e: & mut NatEnc, d: i64, v: i64) {
    if v == 0 {
        x64_li_zero(e, d);
        return;
    }
    if v > 0 && v <= 4294967295 {
        x64_li_u32(e, d, v);
        return;
    }
    if v >= 0 - 2147483648 && v <= 2147483647 {
        x64_li_s32(e, d, v);
        return;
    }
    x64_li_abs(e, d, v);
}

// TG1: the four forms of x64_li, one per immediate class (nat_ir.fd's
// selection table picks them by the class of the constant).
/// xor r32, r32 (d = 0; flags written)
pub fn x64_li_zero(e: & mut NatEnc, d: i64) {
    x64_rex(e, false, d, 0, d, false);
    NatEnc_byte(e, 0x31);
    x64_modrm_rr(e, d, d);
}

/// mov r32, imm32: d = v zero-extended (0 < v <= 0xFFFFFFFF)
@wrapping pub fn x64_li_u32(e: & mut NatEnc, d: i64, v: i64) {
    x64_rex(e, false, 0, 0, d, false);
    NatEnc_byte(e, 0xB8 + (d & 7));
    NatEnc_u32(e, v);
}

/// mov r/m64, simm32 (REX.W C7 /0): d = v sign-extended from 32 bits
@wrapping pub fn x64_li_s32(e: & mut NatEnc, d: i64, v: i64) {
    x64_rex(e, true, 0, 0, d, false);
    NatEnc_byte(e, 0xC7);
    x64_modrm_rr(e, 0, d);
    NatEnc_u32(e, v);
}

/// movabs r64, imm64 (REX.W B8+r)
@wrapping pub fn x64_li_abs(e: & mut NatEnc, d: i64, v: i64) {
    x64_rex(e, true, 0, 0, d, false);
    NatEnc_byte(e, 0xB8 + (d & 7));
    NatEnc_quad(e, v);
}

/// d = d op s for op 0x01 add, 0x09 or, 0x21 and, 0x29 sub, 0x31 xor,
/// 0x39 cmp (flags only)
pub fn x64_alu(e: & mut NatEnc, op: i64, d: i64, s: i64) {
    x64_rex(e, true, s, 0, d, false);
    NatEnc_byte(e, op);
    x64_modrm_rr(e, s, d);
}

pub fn x64_imul(e: & mut NatEnc, d: i64, s: i64) {
    x64_rex(e, true, d, 0, s, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0xAF);
    x64_modrm_rr(e, d, s);
}

/// TG7: d = d op *(base + disp), a memory source operand: REX.W op /r
/// with op 0x03 add, 0x0B or, 0x23 and, 0x2B sub, 0x33 xor, 0x3B cmp
/// (flags only), or 0x0FAF imul. `add rax, [rsp+16]` = 48 03 44 24 10;
/// `imul r9, [rsp+8]` = 4C 0F AF 4C 24 08.
pub fn x64_alu_mem(e: & mut NatEnc, op: i64, d: i64, base: i64, disp: i64) {
    x64_rex(e, true, d, 0, base, false);
    if op == 0x0FAF {
        NatEnc_byte(e, 0x0F);
        NatEnc_byte(e, 0xAF);
    } else {
        NatEnc_byte(e, op);
    }
    x64_modrm_mem(e, d, base, disp);
}

/// OP18: the flags of `size` bytes at base + disp minus an immediate
/// (`cmp [mem], imm`): 80 /7 ib (byte), 66 83 /7 ib or 66 81 /7 iw
/// (word), 83 /7 ib or 81 /7 id (dword), REX.W 83 /7 ib or REX.W 81 /7 id
/// (qword: the immediate sign-extended, so 32 bits signed). The short ib
/// form when the immediate fits 8 bits signed. `cmp qword [rsp+8], 0` =
/// 48 83 7C 24 08 00; `cmp byte [rdi+16], 1` = 80 7F 10 01.
pub fn x64_cmp_mem_imm(e: & mut NatEnc, size: i64, base: i64, disp: i64, imm: i64) {
    if size == 2 {
        NatEnc_byte(e, 0x66);
    }
    x64_rex(e, size == 8, 0, 0, base, false);
    if size == 1 {
        NatEnc_byte(e, 0x80);
        x64_modrm_mem(e, 7, base, disp);
        NatEnc_byte(e, imm & 255);
        return;
    }
    // the immediate as the operation sees it (16 or 32 bits, signed): a
    // word compare with 65535 is the short form of -1, as an assembler
    // writes it
    var sv: i64 = imm;
    if size == 2 {
        sv = imm & 65535;
        if sv >= 32768 {
            sv = sv - 65536;
        }
    } else if size == 4 {
        sv = imm & 4294967295;
        if sv >= 2147483648 {
            sv = sv - 4294967296;
        }
    }
    if x64_fits8(sv) {
        NatEnc_byte(e, 0x83);
        x64_modrm_mem(e, 7, base, disp);
        NatEnc_byte(e, imm & 255);
        return;
    }
    NatEnc_byte(e, 0x81);
    x64_modrm_mem(e, 7, base, disp);
    if size == 2 {
        NatEnc_byte(e, imm & 255);
        NatEnc_byte(e, (imm >> 8) & 255);
    } else {
        NatEnc_u32(e, imm);
    }
}

/// OP18: *(base + disp) = *(base + disp) op s, 64 bits (a read-modify-write
/// destination): REX.W op /r with op 0x01 add, 0x09 or, 0x21 and, 0x29
/// sub, 0x31 xor. `add [rdi+8], rax` = 48 01 47 08; `or [rsp+16], r9` =
/// 4C 09 4C 24 10.
pub fn x64_alu_to_mem(e: & mut NatEnc, op: i64, s: i64, base: i64, disp: i64) {
    x64_rex(e, true, s, 0, base, false);
    NatEnc_byte(e, op);
    x64_modrm_mem(e, s, base, disp);
}

/// OP18: *(base + disp) op= imm, 64 bits, the immediate sign-extended from
/// 8 bits (REX.W 83 /ext ib) or 32 bits (REX.W 81 /ext id); ext 0 add,
/// 1 or, 4 and, 5 sub, 6 xor. `or qword [rdi+8], 4` = 48 83 4F 08 04.
pub fn x64_alu_mem_imm(e: & mut NatEnc, ext: i64, base: i64, disp: i64, imm: i64) {
    x64_rex(e, true, 0, 0, base, false);
    if x64_fits8(imm) {
        NatEnc_byte(e, 0x83);
        x64_modrm_mem(e, ext, base, disp);
        NatEnc_byte(e, imm & 255);
        return;
    }
    NatEnc_byte(e, 0x81);
    x64_modrm_mem(e, ext, base, disp);
    NatEnc_u32(e, imm);
}

/// F7 /ext: 2 not, 3 neg, 4 mul, 5 imul, 6 div, 7 idiv
pub fn x64_f7(e: & mut NatEnc, ext: i64, r: i64) {
    x64_rex(e, true, 0, 0, r, false);
    NatEnc_byte(e, 0xF7);
    x64_modrm_rr(e, ext, r);
}

/// D3 /ext: shift by cl (4 shl, 5 shr, 7 sar)
pub fn x64_shift_cl(e: & mut NatEnc, ext: i64, r: i64) {
    x64_rex(e, true, 0, 0, r, false);
    NatEnc_byte(e, 0xD3);
    x64_modrm_rr(e, ext, r);
}

/// TG7 (BMI2): d = a shifted by register b (count masked to 6 bits, as
/// by CL), flags untouched, no CL needed: VEX.LZ.pp.0F38.W1 F7 /r with
/// ModRM.reg = d, ModRM.rm = a, VEX.vvvv = b. pp 1 SHLX (66), 2 SARX (F3),
/// 3 SHRX (F2). `shlx rax, rbx, rcx` = C4 E2 F1 F7 C3.
pub fn x64_shiftx(e: & mut NatEnc, pp: i64, d: i64, a: i64, b: i64) {
    NatEnc_byte(e, 0xC4);
    NatEnc_byte(e, ((((d >> 3) & 1) ^ 1) << 7) | (1 << 6) | ((((a >> 3) & 1) ^ 1) << 5) | 0x02);
    NatEnc_byte(e, 0x80 | (((b & 15) ^ 15) << 3) | (pp & 3));
    NatEnc_byte(e, 0xF7);
    x64_modrm_rr(e, d, a);
}

/// OP20/MI3 (BMI1): d = ~s & o, flags as AND: VEX.LZ.0F38.W1 F2 /r with
/// ModRM.reg = d, VEX.vvvv = s, ModRM.rm = o. `andn rax, rbx, rcx` =
/// C4 E2 E0 F2 C1.
pub fn x64_andn(e: & mut NatEnc, d: i64, s: i64, o: i64) {
    NatEnc_byte(e, 0xC4);
    NatEnc_byte(e, ((((d >> 3) & 1) ^ 1) << 7) | (1 << 6) | ((((o >> 3) & 1) ^ 1) << 5) | 0x02);
    NatEnc_byte(e, 0x80 | (((s & 15) ^ 15) << 3));
    NatEnc_byte(e, 0xF2);
    x64_modrm_rr(e, d, o);
}

/// OP20/MI3 (BMI1): d = a & (a - 1), the lowest set bit cleared:
/// VEX.LZ.0F38.W1 F3 /1 with VEX.vvvv = d, ModRM.rm = a. `blsr rax, rcx`
/// = C4 E2 F8 F3 C9.
pub fn x64_blsr(e: & mut NatEnc, d: i64, a: i64) {
    NatEnc_byte(e, 0xC4);
    NatEnc_byte(e, (1 << 7) | (1 << 6) | ((((a >> 3) & 1) ^ 1) << 5) | 0x02);
    NatEnc_byte(e, 0x80 | (((d & 15) ^ 15) << 3));
    NatEnc_byte(e, 0xF3);
    x64_modrm_rr(e, 1, a);
}

/// TG7 (BMI1): d = a ^ (a - 1), the mask up to and including the lowest
/// set bit (all ones for a = 0): VEX.LZ.0F38.W1 F3 /2 with VEX.vvvv = d,
/// ModRM.rm = a. `blsmsk rax, rcx` = C4 E2 F8 F3 D1.
pub fn x64_blsmsk(e: & mut NatEnc, d: i64, a: i64) {
    NatEnc_byte(e, 0xC4);
    NatEnc_byte(e, (1 << 7) | (1 << 6) | ((((a >> 3) & 1) ^ 1) << 5) | 0x02);
    NatEnc_byte(e, 0x80 | (((d & 15) ^ 15) << 3));
    NatEnc_byte(e, 0xF3);
    x64_modrm_rr(e, 2, a);
}

/// TG7 (BMI1): d = a & -a, the lowest set bit alone: VEX.LZ.0F38.W1 F3 /3
/// with VEX.vvvv = d, ModRM.rm = a. `blsi rax, rcx` = C4 E2 F8 F3 D9.
pub fn x64_blsi(e: & mut NatEnc, d: i64, a: i64) {
    NatEnc_byte(e, 0xC4);
    NatEnc_byte(e, (1 << 7) | (1 << 6) | ((((a >> 3) & 1) ^ 1) << 5) | 0x02);
    NatEnc_byte(e, 0x80 | (((d & 15) ^ 15) << 3));
    NatEnc_byte(e, 0xF3);
    x64_modrm_rr(e, 3, a);
}

/// C1 /ext ib: shift by an immediate
pub fn x64_shift_imm(e: & mut NatEnc, ext: i64, r: i64, n: i64) {
    x64_rex(e, true, 0, 0, r, false);
    NatEnc_byte(e, 0xC1);
    x64_modrm_rr(e, ext, r);
    NatEnc_byte(e, n & 255);
}

pub fn x64_cqo(e: & mut NatEnc) {
    NatEnc_byte(e, 0x48);
    NatEnc_byte(e, 0x99);
}

pub fn x64_setcc(e: & mut NatEnc, cc: i64, r: i64) {
    x64_rex(e, false, 0, 0, r, r >= 4 && r <= 7);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x90 + cc);
    x64_modrm_rr(e, 0, r);
}

/// Extensions to 64 bits: 0F B6 movzx8, 0F B7 movzx16, 0F BE movsx8,
/// 0F BF movsx16 (REX.W), 63 movsxd
pub fn x64_movx(e: & mut NatEnc, op: i64, d: i64, s: i64) {
    x64_rex(e, true, d, 0, s, false);
    if op != 0x63 {
        NatEnc_byte(e, 0x0F);
    }
    NatEnc_byte(e, op);
    x64_modrm_rr(e, d, s);
}

pub fn x64_test(e: & mut NatEnc, a: i64, b: i64) {
    x64_rex(e, true, b, 0, a, false);
    NatEnc_byte(e, 0x85);
    x64_modrm_rr(e, b, a);
}

/// TG7/TG8: set the flags by one bit of r, for a branch on it: bits 0..7
/// TEST r8, imm8 (F6 /0 ib; REX for spl..dil and r8..r15), bits 8..31
/// TEST r32, imm32 (F7 /0 id: the 32-bit form tests bit 31 without the
/// sign extension of imm32), then ZF clear when the bit is set (jne / je);
/// bits 32..63 BT r64, imm8 (REX.W 0F BA /4 ib), CF = the bit (jb / jae).
/// x64_bit_cc gives the condition that holds when the bit is set.
/// `test cl, 4` = F6 C1 04; `test ebx, 0x100` = F7 C3 00 01 00 00;
/// `bt rax, 40` = 48 0F BA E0 28.
pub fn x64_test_bit(e: & mut NatEnc, r: i64, bit: i64) {
    if bit < 8 {
        if r == 0 {
            // TEST al, imm8: A8 ib (the accumulator's short form)
            NatEnc_byte(e, 0xA8);
        } else {
            x64_rex(e, false, 0, 0, r, r >= 4 && r <= 7);
            NatEnc_byte(e, 0xF6);
            x64_modrm_rr(e, 0, r);
        }
        NatEnc_byte(e, 1 << bit);
        return;
    }
    if bit < 32 {
        if r == 0 {
            // TEST eax, imm32: A9 id
            NatEnc_byte(e, 0xA9);
        } else {
            x64_rex(e, false, 0, 0, r, false);
            NatEnc_byte(e, 0xF7);
            x64_modrm_rr(e, 0, r);
        }
        var imm: i64 = 1 << bit;
        var k: i64 = 0;
        while k < 4 {
            NatEnc_byte(e, (imm >> (k * 8)) & 0xFF);
            k = k + 1;
        }
        return;
    }
    x64_rex(e, true, 0, 0, r, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0xBA);
    x64_modrm_rr(e, 4, r);
    NatEnc_byte(e, bit & 63);
}

/// TG7/TG8: the condition after x64_test_bit(r, bit) that holds when the
/// bit is set.
pub fn x64_bit_cc(bit: i64) -> i64 {
    if bit < 32 {
        return X64_NE;
    }
    return X64_B;
}

/// MI24: CMOVcc d, s (REX.W 0F 40+cc /r, ModRM.reg = d, ModRM.rm = s):
/// d = s when cc holds, else d stays. `cmovne rax, rbx` = 48 0F 45 C3.
pub fn x64_cmov(e: & mut NatEnc, cc: i64, d: i64, s: i64) {
    x64_rex(e, true, d, 0, s, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x40 + (cc & 15));
    x64_modrm_rr(e, d, s);
}

/// d = *(base + disp), `size` bytes, extended to 64 bits
pub fn x64_load(e: & mut NatEnc, d: i64, base: i64, disp: i64, size: i64, signed: bool) {
    if size == 8 {
        x64_rex(e, true, d, 0, base, false);
        NatEnc_byte(e, 0x8B);
    } else if size == 4 && signed {
        x64_rex(e, true, d, 0, base, false);
        NatEnc_byte(e, 0x63);
    } else if size == 4 {
        x64_rex(e, false, d, 0, base, false);
        NatEnc_byte(e, 0x8B);
    } else {
        x64_rex(e, true, d, 0, base, false);
        NatEnc_byte(e, 0x0F);
        if size == 2 {
            if signed {
                NatEnc_byte(e, 0xBF);
            } else {
                NatEnc_byte(e, 0xB7);
            }
        } else {
            if signed {
                NatEnc_byte(e, 0xBE);
            } else {
                NatEnc_byte(e, 0xB6);
            }
        }
    }
    x64_modrm_mem(e, d, base, disp);
}

/// *(base + disp) = v, `size` bytes
pub fn x64_store(e: & mut NatEnc, v: i64, base: i64, disp: i64, size: i64) {
    if size == 2 {
        NatEnc_byte(e, 0x66);
    }
    x64_rex(e, size == 8, v, 0, base, size == 1 && v >= 4 && v <= 7);
    if size == 1 {
        NatEnc_byte(e, 0x88);
    } else {
        NatEnc_byte(e, 0x89);
    }
    x64_modrm_mem(e, v, base, disp);
}

pub fn x64_lea(e: & mut NatEnc, d: i64, base: i64, disp: i64) {
    x64_rex(e, true, d, 0, base, false);
    NatEnc_byte(e, 0x8D);
    x64_modrm_mem(e, d, base, disp);
}

/// lea d, [base + index * (1 << scale)] (scale 0..3), through a SIB byte.
/// `index` must not be rsp (4: "no index" in a SIB); a base of rbp / r13
/// takes mod 01 with a zero disp8 (mod 00 there means rip/disp32).
pub fn x64_lea_idx(e: & mut NatEnc, d: i64, base: i64, index: i64, scale: i64) {
    x64_rex(e, true, d, index, base, false);
    NatEnc_byte(e, 0x8D);
    var md: i64 = 0;
    if (base & 7) == 5 {
        md = 1;
    }
    NatEnc_byte(e, (md << 6) | ((d & 7) << 3) | 4);
    NatEnc_byte(e, ((scale & 3) << 6) | ((index & 7) << 3) | (base & 7));
    if md == 1 {
        NatEnc_byte(e, 0);
    }
}

/// MI22: ModRM + SIB (+ displacement) for [base + index * 2^scale + disp]
/// (scale 0..3). `index` must not be rsp; a base of rbp / r13 takes a
/// displacement even when it is 0 (mod 00 there means no base).
fn x64_modrm_sib(e: & mut NatEnc, reg: i64, base: i64, index: i64, scale: i64, disp: i64) {
    var md: i64 = 2;
    if disp == 0 && (base & 7) != 5 {
        md = 0;
    } else if x64_fits8(disp) {
        md = 1;
    }
    NatEnc_byte(e, (md << 6) | ((reg & 7) << 3) | 4);
    NatEnc_byte(e, ((scale & 3) << 6) | ((index & 7) << 3) | (base & 7));
    if md == 1 {
        NatEnc_byte(e, disp & 255);
    }
    if md == 2 {
        NatEnc_u32(e, disp);
    }
}

/// MI22: d = *(base + index * 2^scale + disp), `size` bytes, extended to
/// 64 bits (x64_load's opcodes with a SIB operand)
pub fn x64_load_idx(e: & mut NatEnc, d: i64, base: i64, index: i64, scale: i64, disp: i64, size: i64, signed: bool) {
    if size == 8 {
        x64_rex(e, true, d, index, base, false);
        NatEnc_byte(e, 0x8B);
    } else if size == 4 && signed {
        x64_rex(e, true, d, index, base, false);
        NatEnc_byte(e, 0x63);
    } else if size == 4 {
        x64_rex(e, false, d, index, base, false);
        NatEnc_byte(e, 0x8B);
    } else {
        x64_rex(e, true, d, index, base, false);
        NatEnc_byte(e, 0x0F);
        if size == 2 {
            if signed {
                NatEnc_byte(e, 0xBF);
            } else {
                NatEnc_byte(e, 0xB7);
            }
        } else {
            if signed {
                NatEnc_byte(e, 0xBE);
            } else {
                NatEnc_byte(e, 0xB6);
            }
        }
    }
    x64_modrm_sib(e, d, base, index, scale, disp);
}

/// MI22: *(base + index * 2^scale + disp) = v, `size` bytes
pub fn x64_store_idx(e: & mut NatEnc, v: i64, base: i64, index: i64, scale: i64, disp: i64, size: i64) {
    if size == 2 {
        NatEnc_byte(e, 0x66);
    }
    x64_rex(e, size == 8, v, index, base, size == 1 && v >= 4 && v <= 7);
    if size == 1 {
        NatEnc_byte(e, 0x88);
    } else {
        NatEnc_byte(e, 0x89);
    }
    x64_modrm_sib(e, v, base, index, scale, disp);
}

/// d = the address of `label` (rip-relative)
pub fn x64_lea_label(e: & mut NatEnc, d: i64, label: i64) {
    x64_rex(e, true, d, 0, 0, false);
    NatEnc_byte(e, 0x8D);
    NatEnc_byte(e, ((d & 7) << 3) | 5);
    x64_rel32(e, label);
}

/// [rip + label] = r (8 bytes)
pub fn x64_store_label(e: & mut NatEnc, r: i64, label: i64) {
    x64_rex(e, true, r, 0, 0, false);
    NatEnc_byte(e, 0x89);
    NatEnc_byte(e, ((r & 7) << 3) | 5);
    x64_rel32(e, label);
}

/// r = [rip + label] (8 bytes)
pub fn x64_load_label(e: & mut NatEnc, r: i64, label: i64) {
    x64_rex(e, true, r, 0, 0, false);
    NatEnc_byte(e, 0x8B);
    NatEnc_byte(e, ((r & 7) << 3) | 5);
    x64_rel32(e, label);
}

/// r = fs:[disp]
pub fn x64_load_fs(e: & mut NatEnc, r: i64, disp: i64) {
    NatEnc_byte(e, 0x64);
    x64_rex(e, true, r, 0, 0, false);
    NatEnc_byte(e, 0x8B);
    NatEnc_byte(e, ((r & 7) << 3) | 4);
    NatEnc_byte(e, 0x25);
    NatEnc_u32(e, disp);
}

/// r = gs:[disp] (Windows: the thread environment block)
pub fn x64_load_gs(e: & mut NatEnc, r: i64, disp: i64) {
    NatEnc_byte(e, 0x65);
    x64_rex(e, true, r, 0, 0, false);
    NatEnc_byte(e, 0x8B);
    NatEnc_byte(e, ((r & 7) << 3) | 4);
    NatEnc_byte(e, 0x25);
    NatEnc_u32(e, disp);
}

/// gs:[disp] = r
pub fn x64_store_gs(e: & mut NatEnc, r: i64, disp: i64) {
    NatEnc_byte(e, 0x65);
    x64_rex(e, true, r, 0, 0, false);
    NatEnc_byte(e, 0x89);
    NatEnc_byte(e, ((r & 7) << 3) | 4);
    NatEnc_byte(e, 0x25);
    NatEnc_u32(e, disp);
}

/// and rsp, -16
pub fn x64_align_sp16(e: & mut NatEnc) {
    NatEnc_byte(e, 0x48);
    NatEnc_byte(e, 0x83);
    NatEnc_byte(e, 0xE4);
    NatEnc_byte(e, 0xF0);
}

/// 4 data bytes: the PE RVA of `label`
pub fn NatEnc_rva32(e: & mut NatEnc, label: i64) {
    NatEnc_fix(e, label, NATFIX_RVA32);
    NatEnc_u32(e, 0);
}

pub fn x64_call(e: & mut NatEnc, label: i64) {
    NatEnc_byte(e, 0xE8);
    x64_rel32(e, label);
}
pub fn x64_jmp(e: & mut NatEnc, label: i64) {
    NatEnc_byte(e, 0xE9);
    x64_rel32(e, label);
}
pub fn x64_jcc(e: & mut NatEnc, cc: i64, label: i64) {
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x80 + cc);
    x64_rel32(e, label);
}

/// Jcc by a fixed count of bytes after this 2-byte instruction
pub fn x64_jcc8(e: & mut NatEnc, cc: i64, rel: i64) {
    NatEnc_byte(e, 0x70 + cc);
    NatEnc_byte(e, rel & 255);
}

/// TG6: the short forms to a label (rel8, -128..127 from the instruction's
/// end; NatEnc_resolve checks the reach): `jmp rel8` (EB) and `jcc rel8`.
pub fn x64_jmp_short(e: & mut NatEnc, label: i64) {
    NatEnc_byte(e, 0xEB);
    NatEnc_fix(e, label, NATFIX_X64_REL8);
    NatEnc_byte(e, 0);
}
pub fn x64_jcc_short(e: & mut NatEnc, cc: i64, label: i64) {
    NatEnc_byte(e, 0x70 + cc);
    NatEnc_fix(e, label, NATFIX_X64_REL8);
    NatEnc_byte(e, 0);
}

pub fn x64_call_r(e: & mut NatEnc, r: i64) {
    x64_rex(e, false, 0, 0, r, false);
    NatEnc_byte(e, 0xFF);
    x64_modrm_rr(e, 2, r);
}

/// MI27: JMP r (FF /4), the indirect jump of a jump table: `jmp r10` =
/// 41 FF E2.
pub fn x64_jmp_r(e: & mut NatEnc, r: i64) {
    x64_rex(e, false, 0, 0, r, false);
    NatEnc_byte(e, 0xFF);
    x64_modrm_rr(e, 4, r);
}

pub fn x64_ret(e: & mut NatEnc) {
    NatEnc_byte(e, 0xC3);
}
pub fn x64_push(e: & mut NatEnc, r: i64) {
    x64_rex(e, false, 0, 0, r, false);
    NatEnc_byte(e, 0x50 + (r & 7));
}
pub fn x64_pop(e: & mut NatEnc, r: i64) {
    x64_rex(e, false, 0, 0, r, false);
    NatEnc_byte(e, 0x58 + (r & 7));
}
pub fn x64_ud2(e: & mut NatEnc) {
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x0B);
}
pub fn x64_syscall(e: & mut NatEnc) {
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x05);
}
pub fn x64_mfence(e: & mut NatEnc) {
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0xAE);
    NatEnc_byte(e, 0xF0);
}

/// add / sub r, imm32 (81 /0, /5)
pub fn x64_add_imm(e: & mut NatEnc, r: i64, v: i64) {
    x64_rex(e, true, 0, 0, r, false);
    if x64_fits8(v) {
        NatEnc_byte(e, 0x83);
        x64_modrm_rr(e, 0, r);
        NatEnc_byte(e, v & 255);
    } else if r == 0 {
        NatEnc_byte(e, 0x05);
        NatEnc_u32(e, v);
    }  // the rax form
    else {
        NatEnc_byte(e, 0x81);
        x64_modrm_rr(e, 0, r);
        NatEnc_u32(e, v);
    }
}

pub fn x64_sub_imm(e: & mut NatEnc, r: i64, v: i64) {
    x64_rex(e, true, 0, 0, r, false);
    if x64_fits8(v) {
        NatEnc_byte(e, 0x83);
        x64_modrm_rr(e, 5, r);
        NatEnc_byte(e, v & 255);
    } else if r == 0 {
        NatEnc_byte(e, 0x2D);
        NatEnc_u32(e, v);
    }  // the rax form
    else {
        NatEnc_byte(e, 0x81);
        x64_modrm_rr(e, 5, r);
        NatEnc_u32(e, v);
    }
}

// ---------------------------------------------------------------------------
// OP21: vector (SIMD) instruction forms, every target. One kind numbering
// across the targets (NVK_*), the lane width in the kind; RISC-V takes the
// element width from VSETVLI instead (its kinds only pick the operation).
// The register numbers are the vector registers' (xmm/ymm 0..15, AArch64
// v0..v31, RISC-V v0..v31). Checked byte for byte against clang's
// assembler by tests/nattools/enc-oracle-op21.py.
// ---------------------------------------------------------------------------

pub const NVK_ADD64: i64 = 0;
pub const NVK_SUB64: i64 = 1;
pub const NVK_ADD32: i64 = 2;
pub const NVK_SUB32: i64 = 3;
pub const NVK_MUL32: i64 = 4;
pub const NVK_AND: i64 = 5;
pub const NVK_OR: i64 = 6;
pub const NVK_XOR: i64 = 7;
pub const NVK_FADD64: i64 = 8;
pub const NVK_FSUB64: i64 = 9;
pub const NVK_FMUL64: i64 = 10;
pub const NVK_FDIV64: i64 = 11;
pub const NVK_LAST: i64 = 11;

/// The operation commutes (VEX operand order may be swapped).
pub fn nvk_commutes(kind: i64) -> bool {
    return kind == NVK_ADD64 || kind == NVK_ADD32 || kind == NVK_MUL32 || kind == NVK_AND || kind == NVK_OR || kind == NVK_XOR || kind == NVK_FADD64 || kind == NVK_FMUL64;
}

/// x86-64: (map << 8) | opcode of kind, all with the 66 prefix; map 1 is
/// 0F, 2 is 0F 38. paddq D4, psubq FB, paddd FE, psubd FA, pmulld 0F38 40
/// (SSE4.1), pand DB, por EB, pxor EF, addpd 58, subpd 5C, mulpd 59,
/// divpd 5E.
fn x64_vec_code(kind: i64) -> i64 {
    if kind == NVK_ADD64 {
        return 0x1D4;
    }
    if kind == NVK_SUB64 {
        return 0x1FB;
    }
    if kind == NVK_ADD32 {
        return 0x1FE;
    }
    if kind == NVK_SUB32 {
        return 0x1FA;
    }
    if kind == NVK_MUL32 {
        return 0x240;
    }
    if kind == NVK_AND {
        return 0x1DB;
    }
    if kind == NVK_OR {
        return 0x1EB;
    }
    if kind == NVK_XOR {
        return 0x1EF;
    }
    if kind == NVK_FADD64 {
        return 0x158;
    }
    if kind == NVK_FSUB64 {
        return 0x15C;
    }
    if kind == NVK_FMUL64 {
        return 0x159;
    }
    return 0x15E;
}

/// SSE2: x1 = x1 op x2 on 128-bit xmm registers (`paddq xmm1, xmm2`).
pub fn x64_vec(e: & mut NatEnc, kind: i64, x1: i64, x2: i64) {
    var c: i64 = x64_vec_code(kind);
    NatEnc_byte(e, 0x66);
    x64_rex(e, false, x1, 0, x2, false);
    NatEnc_byte(e, 0x0F);
    if (c >> 8) == 2 {
        NatEnc_byte(e, 0x38);
    }
    NatEnc_byte(e, c & 255);
    x64_modrm_rr(e, x1, x2);
}

/// movdqu xmm x, [base + disp] (F3 0F 6F) and movdqu [base + disp], xmm x
/// (F3 0F 7F): unaligned 128-bit load and store.
pub fn x64_vld(e: & mut NatEnc, x: i64, base: i64, disp: i64) {
    NatEnc_byte(e, 0xF3);
    x64_rex(e, false, x, 0, base, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x6F);
    x64_modrm_mem(e, x, base, disp);
}

pub fn x64_vst(e: & mut NatEnc, base: i64, disp: i64, x: i64) {
    NatEnc_byte(e, 0xF3);
    x64_rex(e, false, x, 0, base, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x7F);
    x64_modrm_mem(e, x, base, disp);
}

/// pshufd x1, x2, imm (66 0F 70 /r ib): the four dwords of x2 picked by
/// imm's two-bit fields (0x4E swaps the two quadwords).
pub fn x64_pshufd(e: & mut NatEnc, x1: i64, x2: i64, imm: i64) {
    NatEnc_byte(e, 0x66);
    x64_rex(e, false, x1, 0, x2, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x70);
    x64_modrm_rr(e, x1, x2);
    NatEnc_byte(e, imm & 255);
}

/// punpcklqdq x1, x2 (66 0F 6C): x1 = [x1.lo, x2.lo] (two i64 into a vector)
pub fn x64_punpcklqdq(e: & mut NatEnc, x1: i64, x2: i64) {
    NatEnc_byte(e, 0x66);
    x64_rex(e, false, x1, 0, x2, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x6C);
    x64_modrm_rr(e, x1, x2);
}

/// A VEX prefix: reg r (ModRM.reg), vvvv v, rm b (ModRM.rm or base), map
/// 1 0F / 2 0F38, pp 0 none / 1 66 / 2 F3 / 3 F2, l256 VEX.L. The two-byte
/// form (C5) when map is 0F and b needs no REX.B, as assemblers pick.
fn x64_vex(e: & mut NatEnc, r: i64, v: i64, b: i64, map: i64, pp: i64, l256: bool) {
    var lbit: i64 = 0;
    if l256 {
        lbit = 4;
    }
    var rbar: i64 = 0x80;
    if r >= 8 {
        rbar = 0;
    }
    var vv: i64 = ((15 - (v & 15)) & 15) << 3;
    if map == 1 && b < 8 {
        NatEnc_byte(e, 0xC5);
        NatEnc_byte(e, rbar | vv | lbit | pp);
        return;
    }
    var bbar: i64 = 0x20;
    if b >= 8 {
        bbar = 0;
    }
    NatEnc_byte(e, 0xC4);
    NatEnc_byte(e, rbar | 0x40 | bbar | map);
    NatEnc_byte(e, vv | lbit | pp);
}

/// AVX / AVX2: d = a op b, three operands (`vpaddq ymm0, ymm1, ymm2`);
/// l256 the 256-bit ymm form (AVX2 for the integer kinds), else 128-bit
/// xmm. An operation that commutes takes b first when only b needs the
/// three-byte prefix (the shorter encoding assemblers choose).
pub fn x64_vvec(e: & mut NatEnc, kind: i64, d: i64, a: i64, b: i64, l256: bool) {
    var c: i64 = x64_vec_code(kind);
    var map: i64 = c >> 8;
    var s1: i64 = a;
    var s2: i64 = b;
    if map == 1 && b >= 8 && a < 8 && nvk_commutes(kind) {
        s1 = b;
        s2 = a;
    }
    x64_vex(e, d, s1, s2, map, 1, l256);
    NatEnc_byte(e, c & 255);
    x64_modrm_rr(e, d, s2);
}

/// vmovdqu ymm/xmm x, [base + disp] (VEX F3 0F 6F) and the store (7F).
pub fn x64_vvld(e: & mut NatEnc, x: i64, base: i64, disp: i64, l256: bool) {
    x64_vex(e, x, 0, base, 1, 2, l256);
    NatEnc_byte(e, 0x6F);
    x64_modrm_mem(e, x, base, disp);
}

pub fn x64_vvst(e: & mut NatEnc, base: i64, disp: i64, x: i64, l256: bool) {
    x64_vex(e, x, 0, base, 1, 2, l256);
    NatEnc_byte(e, 0x7F);
    x64_modrm_mem(e, x, base, disp);
}

/// AArch64 NEON (128-bit, Q = 1): d = n op m, the arrangement from the
/// kind (.2d, .4s, .16b for the bitwise ones): ADD, SUB, MUL (.4s only),
/// AND, ORR, EOR, FADD, FSUB, FMUL, FDIV (.2d).
pub fn a64_vec(e: & mut NatEnc, kind: i64, d: i64, n: i64, m: i64) {
    var base: i64 = 0x4EE08400;
    if kind == NVK_SUB64 {
        base = 0x6EE08400;
    } else if kind == NVK_ADD32 {
        base = 0x4EA08400;
    } else if kind == NVK_SUB32 {
        base = 0x6EA08400;
    } else if kind == NVK_MUL32 {
        base = 0x4EA09C00;
    } else if kind == NVK_AND {
        base = 0x4E201C00;
    } else if kind == NVK_OR {
        base = 0x4EA01C00;
    } else if kind == NVK_XOR {
        base = 0x6E201C00;
    } else if kind == NVK_FADD64 {
        base = 0x4E60D400;
    } else if kind == NVK_FSUB64 {
        base = 0x4EE0D400;
    } else if kind == NVK_FMUL64 {
        base = 0x6E60DC00;
    } else if kind == NVK_FDIV64 {
        base = 0x6E60FC00;
    }
    NatEnc_word(e, base | ((m & 31) << 16) | ((n & 31) << 5) | (d & 31));
}

/// ldr q t, [n, #off] / str q t, [n, #off]: off a multiple of 16 below
/// 65536 (the unsigned scaled offset).
pub fn a64_ldr_q(e: & mut NatEnc, t: i64, n: i64, off: i64) {
    NatEnc_word(e, 0x3DC00000 | (((off >> 4) & 0xFFF) << 10) | ((n & 31) << 5) | (t & 31));
}

pub fn a64_str_q(e: & mut NatEnc, t: i64, n: i64, off: i64) {
    NatEnc_word(e, 0x3D800000 | (((off >> 4) & 0xFFF) << 10) | ((n & 31) << 5) | (t & 31));
}

/// dup v d.2d, x n: both lanes = the general register
pub fn a64_dup_2d(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x4E080C00 | ((n & 31) << 5) | (d & 31));
}

/// addp d d, v n.2d: the sum of the two lanes (a reduction)
pub fn a64_addp_d(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x5EF1B800 | ((n & 31) << 5) | (d & 31));
}

/// umov x d, v n.d[i] (`mov x0, v1.d[1]`) and ins v d.d[i], x n
pub fn a64_umov_d(e: & mut NatEnc, d: i64, n: i64, i: i64) {
    NatEnc_word(e, 0x4E083C00 | ((i & 1) << 20) | ((n & 31) << 5) | (d & 31));
}

pub fn a64_ins_d(e: & mut NatEnc, d: i64, i: i64, n: i64) {
    NatEnc_word(e, 0x4E081C00 | ((i & 1) << 20) | ((n & 31) << 5) | (d & 31));
}

/// RISC-V V 1.0: vsetvli rd, rs1, vtype (vtype: vma << 7 | vta << 6 |
/// vsew << 3 | vlmul; e64, m1, ta, ma is 0xD8, e32 0xD0)
pub fn rv_vsetvli(e: & mut NatEnc, rd: i64, rs1: i64, vtype: i64) {
    NatEnc_word(e, 0x7057 | ((vtype & 0x7FF) << 20) | ((rs1 & 31) << 15) | ((rd & 31) << 7));
}

/// The width field of a unit-stride access of sew-bit elements
fn rv_vwidth(sew: i64) -> i64 {
    if sew == 8 {
        return 0;
    }
    if sew == 16 {
        return 5;
    }
    if sew == 32 {
        return 6;
    }
    return 7;
}

/// vle<sew>.v vd, (rs1) and vse<sew>.v vs3, (rs1), unmasked unit stride
pub fn rv_vle(e: & mut NatEnc, vd: i64, rs1: i64, sew: i64) {
    NatEnc_word(e, (1 << 25) | ((rs1 & 31) << 15) | (rv_vwidth(sew) << 12) | ((vd & 31) << 7) | 0x07);
}

pub fn rv_vse(e: & mut NatEnc, vs3: i64, rs1: i64, sew: i64) {
    NatEnc_word(e, (1 << 25) | ((rs1 & 31) << 15) | (rv_vwidth(sew) << 12) | ((vs3 & 31) << 7) | 0x27);
}

/// vd = a op b, unmasked (`vadd.vv vd, a, b`; `vsub.vv vd, a, b` is a - b):
/// vadd, vsub, vmul, vand, vor, vxor (OPIVV / OPMVV), vfadd, vfsub, vfmul,
/// vfdiv (OPFVV), at the element width VSETVLI set.
pub fn rv_vec(e: & mut NatEnc, kind: i64, vd: i64, a: i64, b: i64) {
    var f6: i64 = 0;
    var f3: i64 = 0;
    if kind == NVK_SUB64 || kind == NVK_SUB32 {
        f6 = 2;
    } else if kind == NVK_MUL32 {
        f6 = 0x25;
        f3 = 2;
    } else if kind == NVK_AND {
        f6 = 0x09;
    } else if kind == NVK_OR {
        f6 = 0x0A;
    } else if kind == NVK_XOR {
        f6 = 0x0B;
    } else if kind == NVK_FADD64 {
        f3 = 1;
    } else if kind == NVK_FSUB64 {
        f6 = 2;
        f3 = 1;
    } else if kind == NVK_FMUL64 {
        f6 = 0x24;
        f3 = 1;
    } else if kind == NVK_FDIV64 {
        f6 = 0x20;
        f3 = 1;
    }
    NatEnc_word(e, (f6 << 26) | (1 << 25) | ((a & 31) << 20) | ((b & 31) << 15) | (f3 << 12) | ((vd & 31) << 7) | 0x57);
}

/// vredsum.vs vd, vs2, vs1: vd[0] = vs1[0] + the sum of vs2's elements
pub fn rv_vredsum(e: & mut NatEnc, vd: i64, vs2: i64, vs1: i64) {
    NatEnc_word(e, (1 << 25) | ((vs2 & 31) << 20) | ((vs1 & 31) << 15) | (2 << 12) | ((vd & 31) << 7) | 0x57);
}

/// vmv.x.s rd, vs2 (element 0 to a general register) and vmv.v.x vd, rs1
/// (every element = rs1)
pub fn rv_vmv_x_s(e: & mut NatEnc, rd: i64, vs2: i64) {
    NatEnc_word(e, 0x42002057 | ((vs2 & 31) << 20) | ((rd & 31) << 7));
}

pub fn rv_vmv_v_x(e: & mut NatEnc, vd: i64, rs1: i64) {
    NatEnc_word(e, 0x5E004057 | ((rs1 & 31) << 15) | ((vd & 31) << 7));
}

// TG11: the forms the machine IR's vector operations add (nat_ir.fd
// MO_VSPLAT, MO_VLANE, MO_VZMASK, MO_VEND), checked against clang's
// assembler by tests/nattools/enc-oracle-tg11.py.

/// cmppd x1, x2, imm (66 0F C2 /r ib): each f64 lane of x1 = all ones when
/// (x1 cmp x2), imm 0 eq, 4 neq (unordered: true for NaN), 1 lt, 2 le.
pub fn x64_cmppd(e: & mut NatEnc, x1: i64, x2: i64, imm: i64) {
    NatEnc_byte(e, 0x66);
    x64_rex(e, false, x1, 0, x2, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0xC2);
    x64_modrm_rr(e, x1, x2);
    NatEnc_byte(e, imm & 255);
}

/// vcmppd d, a, b, imm (VEX 66 0F C2 /r ib): d = (a cmp b) per f64 lane
pub fn x64_vcmppd(e: & mut NatEnc, d: i64, a: i64, b: i64, imm: i64, l256: bool) {
    x64_vex(e, d, a, b, 1, 1, l256);
    NatEnc_byte(e, 0xC2);
    x64_modrm_rr(e, d, b);
    NatEnc_byte(e, imm & 255);
}

/// cmppd x, xmmword [base + disp], imm and vcmppd d, a, [base + disp],
/// imm: the compare with its second operand in memory
pub fn x64_cmppd_m(e: & mut NatEnc, x: i64, base: i64, disp: i64, imm: i64) {
    NatEnc_byte(e, 0x66);
    x64_rex(e, false, x, 0, base, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0xC2);
    x64_modrm_mem(e, x, base, disp);
    NatEnc_byte(e, imm & 255);
}

pub fn x64_vcmppd_m(e: & mut NatEnc, d: i64, a: i64, base: i64, disp: i64, imm: i64, l256: bool) {
    x64_vex(e, d, a, base, 1, 1, l256);
    NatEnc_byte(e, 0xC2);
    x64_modrm_mem(e, d, base, disp);
    NatEnc_byte(e, imm & 255);
}

/// vpbroadcastq d, xmm s (AVX2, VEX 66 0F38 59 /r W0): every 64-bit lane
/// of d = the low lane of s
pub fn x64_vpbroadcastq(e: & mut NatEnc, d: i64, s: i64, l256: bool) {
    x64_vex(e, d, 0, s, 2, 1, l256);
    NatEnc_byte(e, 0x59);
    x64_modrm_rr(e, d, s);
}

/// vzeroupper (C5 F8 77): the upper halves of every ymm register cleared,
/// after 256-bit code, so that the SSE code after it pays no transition
pub fn x64_vzeroupper(e: & mut NatEnc) {
    NatEnc_byte(e, 0xC5);
    NatEnc_byte(e, 0xF8);
    NatEnc_byte(e, 0x77);
}

/// fcmeq v d.2d, v n.2d, #0.0: each lane of d = all ones when n's lane is
/// +0.0 or -0.0 (NaN: zeros)
pub fn a64_fcmeq_zero_2d(e: & mut NatEnc, d: i64, n: i64) {
    NatEnc_word(e, 0x4EE0D800 | ((n & 31) << 5) | (d & 31));
}

/// bic v d.16b, v n.16b, v m.16b: d = n & ~m
pub fn a64_bic_16b(e: & mut NatEnc, d: i64, n: i64, m: i64) {
    NatEnc_word(e, 0x4E601C00 | ((m & 31) << 16) | ((n & 31) << 5) | (d & 31));
}

/// dup v d.2d, v n.d[i] (both lanes = lane i) and dup d d, v n.d[i] (the
/// scalar form, `mov d0, v1.d[1]`)
pub fn a64_dup_elem_2d(e: & mut NatEnc, d: i64, n: i64, i: i64) {
    NatEnc_word(e, 0x4E000400 | ((((i & 1) << 4) | 8) << 16) | ((n & 31) << 5) | (d & 31));
}

pub fn a64_dup_d_elem(e: & mut NatEnc, d: i64, n: i64, i: i64) {
    NatEnc_word(e, 0x5E000400 | ((((i & 1) << 4) | 8) << 16) | ((n & 31) << 5) | (d & 31));
}

/// The OPIVI forms (funct3 011) with a five-bit immediate: funct6, vm (1:
/// unmasked), vs2, imm, vd
fn rv_vivi(e: & mut NatEnc, f6: i64, vm: i64, vd: i64, vs2: i64, imm: i64) {
    NatEnc_word(e, (f6 << 26) | ((vm & 1) << 25) | ((vs2 & 31) << 20) | ((imm & 31) << 15) | (3 << 12) | ((vd & 31) << 7) | 0x57);
}

/// vsll.vi vd, vs2, uimm: each element shifted left
pub fn rv_vsll_vi(e: & mut NatEnc, vd: i64, vs2: i64, uimm: i64) {
    rv_vivi(e, 0x25, 1, vd, vs2, uimm);
}

/// vmseq.vi vd, vs2, simm: mask bit i of vd = (vs2[i] == simm)
pub fn rv_vmseq_vi(e: & mut NatEnc, vd: i64, vs2: i64, simm: i64) {
    rv_vivi(e, 0x18, 1, vd, vs2, simm);
}

/// vmerge.vim vd, vs2, simm, v0: vd[i] = v0's mask bit i ? simm : vs2[i]
pub fn rv_vmerge_vim(e: & mut NatEnc, vd: i64, vs2: i64, simm: i64) {
    rv_vivi(e, 0x17, 0, vd, vs2, simm);
}

/// vslidedown.vi vd, vs2, uimm: vd[i] = vs2[i + uimm]
pub fn rv_vslidedown_vi(e: & mut NatEnc, vd: i64, vs2: i64, uimm: i64) {
    rv_vivi(e, 0x0F, 1, vd, vs2, uimm);
}

/// vfmv.f.s fd, vs2 (element 0 to a float register) and vfmv.v.f vd, fs1
/// (every element = fs1)
pub fn rv_vfmv_f_s(e: & mut NatEnc, fd: i64, vs2: i64) {
    NatEnc_word(e, (0x10 << 26) | (1 << 25) | ((vs2 & 31) << 20) | (1 << 12) | ((fd & 31) << 7) | 0x57);
}

pub fn rv_vfmv_v_f(e: & mut NatEnc, vd: i64, fs1: i64) {
    NatEnc_word(e, (0x17 << 26) | (1 << 25) | ((fs1 & 31) << 15) | (5 << 12) | ((vd & 31) << 7) | 0x57);
}

// ---------------------------------------------------------------------------
// PL5: Thumb-2 (ARMv7-M, Cortex-M3/M4) instruction forms, the encoder a
// Cortex-M target needs (r0..r12, sp 13, lr 14, pc 15). A 32-bit form is two
// halfwords, the first one first, each little-endian. The wide (.W) forms
// throughout, so each operation has one encoding; checked byte for byte
// against clang's assembler by tests/nattools/enc-oracle-op21.py.
// ---------------------------------------------------------------------------

pub fn NatEnc_half(e: & mut NatEnc, h: i64) {
    e.code.push(h & 0xFF);
    e.code.push((h >> 8) & 0xFF);
}

pub fn t2_word(e: & mut NatEnc, hw1: i64, hw2: i64) {
    NatEnc_half(e, hw1);
    NatEnc_half(e, hw2);
}

/// The imm4:i:imm3:imm8 split of a 16-bit immediate (MOVW / MOVT), or the
/// i:imm3:imm8 one of a 12-bit one (ADDW / SUBW): hw1 bits, hw2 bits.
fn t2_imm16(e: & mut NatEnc, hw1: i64, d: i64, imm: i64) {
    var i4: i64 = (imm >> 12) & 15;
    var i1: i64 = (imm >> 11) & 1;
    var i3: i64 = (imm >> 8) & 7;
    var lo8: i64 = imm & 255;
    t2_word(e, hw1 | (i1 << 10) | i4, (i3 << 12) | ((d & 15) << 8) | lo8);
}

/// movw d, #imm16 (the low half, the high half cleared); movt d, #imm16
/// (the high half, the low kept): any 32-bit constant in two.
pub fn t2_movw(e: & mut NatEnc, d: i64, imm: i64) {
    t2_imm16(e, 0xF240, d, imm & 0xFFFF);
}

pub fn t2_movt(e: & mut NatEnc, d: i64, imm: i64) {
    t2_imm16(e, 0xF2C0, d, imm & 0xFFFF);
}

/// addw d, n, #imm12 and subw d, n, #imm12 (0..4095)
pub fn t2_addw(e: & mut NatEnc, d: i64, n: i64, imm: i64) {
    t2_imm16(e, 0xF200 | (n & 15), d, imm & 0xFFF);
}

pub fn t2_subw(e: & mut NatEnc, d: i64, n: i64, imm: i64) {
    t2_imm16(e, 0xF2A0 | (n & 15), d, imm & 0xFFF);
}

/// d = n op m, the wide register forms: kind NVK_ADD32 add.w, NVK_SUB32
/// sub.w, NVK_AND and.w, NVK_OR orr.w, NVK_XOR eor.w, NVK_MUL32 mul (T2).
/// Flags untouched (S = 0).
pub fn t2_alu(e: & mut NatEnc, kind: i64, d: i64, n: i64, m: i64) {
    if kind == NVK_MUL32 {
        t2_word(e, 0xFB00 | (n & 15), 0xF000 | ((d & 15) << 8) | (m & 15));
        return;
    }
    var hw1: i64 = 0xEB00;
    if kind == NVK_SUB32 || kind == NVK_SUB64 {
        hw1 = 0xEBA0;
    } else if kind == NVK_AND {
        hw1 = 0xEA00;
    } else if kind == NVK_OR {
        hw1 = 0xEA40;
    } else if kind == NVK_XOR {
        hw1 = 0xEA80;
    }
    t2_word(e, hw1 | (n & 15), ((d & 15) << 8) | (m & 15));
}

/// sdiv / udiv d, n, m (ARMv7-M: a division by zero gives 0, no trap)
pub fn t2_div(e: & mut NatEnc, d: i64, n: i64, m: i64, unsigned: bool) {
    var hw1: i64 = 0xFB90;
    if unsigned {
        hw1 = 0xFBB0;
    }
    t2_word(e, hw1 | (n & 15), 0xF0F0 | ((d & 15) << 8) | (m & 15));
}

/// d = n shifted by register m: kind 0 lsl.w, 1 lsr.w, 2 asr.w
pub fn t2_shift(e: & mut NatEnc, kind: i64, d: i64, n: i64, m: i64) {
    t2_word(e, 0xFA00 | ((kind & 3) << 5) | (n & 15), 0xF000 | ((d & 15) << 8) | (m & 15));
}

/// mov.w d, m and cmp.w n, m
pub fn t2_mov(e: & mut NatEnc, d: i64, m: i64) {
    t2_word(e, 0xEA4F, ((d & 15) << 8) | (m & 15));
}

pub fn t2_cmp(e: & mut NatEnc, n: i64, m: i64) {
    t2_word(e, 0xEBB0 | (n & 15), 0x0F00 | (m & 15));
}

/// ldr.w / str.w t, [n, #imm12] (word), ldrb.w / strb.w (byte): imm 0..4095
pub fn t2_ldst(e: & mut NatEnc, load: bool, byte: bool, t: i64, n: i64, imm: i64) {
    var hw1: i64 = 0xF8C0;
    if byte {
        hw1 = 0xF880;
    }
    if load {
        hw1 = hw1 | 0x10;
    }
    t2_word(e, hw1 | (n & 15), ((t & 15) << 12) | (imm & 0xFFF));
}

/// push.w {mask} / pop.w {mask} (bit r per register; lr 14 on a push, pc
/// 15 on a pop); at least two registers
pub fn t2_push(e: & mut NatEnc, mask: i64) {
    t2_word(e, 0xE92D, mask & 0x5FFF);
}

pub fn t2_pop(e: & mut NatEnc, mask: i64) {
    t2_word(e, 0xE8BD, mask & 0xDFFF);
}

/// The 25-bit branch offset fields of b.w (T4) and bl (T1): off is the
/// byte distance from the instruction's address + 4, even.
fn t2_branch(e: & mut NatEnc, hw2_base: i64, off: i64) {
    var s: i64 = (off >> 24) & 1;
    var i1: i64 = (off >> 23) & 1;
    var i2: i64 = (off >> 22) & 1;
    var imm10: i64 = (off >> 12) & 0x3FF;
    var imm11: i64 = (off >> 1) & 0x7FF;
    var j1: i64 = 1 - (i1 ^ s);
    var j2: i64 = 1 - (i2 ^ s);
    t2_word(e, 0xF000 | (s << 10) | imm10, hw2_base | (j1 << 13) | (j2 << 11) | imm11);
}

pub fn t2_b(e: & mut NatEnc, off: i64) {
    t2_branch(e, 0x9000, off);
}

pub fn t2_bl(e: & mut NatEnc, off: i64) {
    t2_branch(e, 0xD000, off);
}

/// b<cond>.w (T3), cond 0 eq .. 13 le: off from the address + 4, within
/// +-1 MB, even.
pub fn t2_bcc(e: & mut NatEnc, cond: i64, off: i64) {
    var s: i64 = (off >> 20) & 1;
    var j2: i64 = (off >> 19) & 1;
    var j1: i64 = (off >> 18) & 1;
    var imm6: i64 = (off >> 12) & 0x3F;
    var imm11: i64 = (off >> 1) & 0x7FF;
    t2_word(e, 0xF000 | (s << 10) | ((cond & 15) << 6) | imm6, 0x8000 | (j1 << 13) | (j2 << 11) | imm11);
}

/// The 16-bit forms a function needs: bx lr, bx r, nop, udf #0 (a trap),
/// bkpt #imm8 (semihosting is bkpt 0xab on v7-M).
pub fn t_bx(e: & mut NatEnc, m: i64) {
    NatEnc_half(e, 0x4700 | ((m & 15) << 3));
}

pub fn t_nop(e: & mut NatEnc) {
    NatEnc_half(e, 0xBF00);
}

pub fn t_udf(e: & mut NatEnc) {
    NatEnc_half(e, 0xDE00);
}

pub fn t_bkpt(e: & mut NatEnc, imm: i64) {
    NatEnc_half(e, 0xBE00 | (imm & 255));
}

// PL5: the rest of what compiler/nat_thumb.fd (the Cortex-M code generator)
// emits. Data-processing operations are numbered as the architecture does:
// TDP_AND 0, TDP_BIC 1, TDP_ORR 2, TDP_ORN 3, TDP_EOR 4, TDP_ADD 8, TDP_ADC
// 10, TDP_SBC 11, TDP_SUB 13, TDP_RSB 14 (cmp is subs to pc 15, tst ands to
// 15, mov orr from 15, mvn orn from 15).
pub const TDP_AND: i64 = 0;
pub const TDP_BIC: i64 = 1;
pub const TDP_ORR: i64 = 2;
pub const TDP_ORN: i64 = 3;
pub const TDP_EOR: i64 = 4;
pub const TDP_ADD: i64 = 8;
pub const TDP_ADC: i64 = 10;
pub const TDP_SBC: i64 = 11;
pub const TDP_SUB: i64 = 13;
pub const TDP_RSB: i64 = 14;

/// d = n op (m shifted): the wide register form; `s` sets the flags;
/// stype 0 lsl, 1 lsr, 2 asr, 3 ror by amt (0..31; 0 with lsl = no shift)
pub fn t2_dp(e: & mut NatEnc, op: i64, s: bool, d: i64, n: i64, m: i64, stype: i64, amt: i64) {
    var sb: i64 = 0;
    if s {
        sb = 1;
    }
    var hw2: i64 = (((amt >> 2) & 7) << 12) | ((d & 15) << 8) | ((amt & 3) << 6) | ((stype & 3) << 4) | (m & 15);
    t2_word(e, 0xEA00 | ((op & 15) << 5) | (sb << 4) | (n & 15), hw2);
}

/// d = n op #imm8 (0..255, the plain form of the modified immediate)
pub fn t2_dpi(e: & mut NatEnc, op: i64, s: bool, d: i64, n: i64, imm8: i64) {
    var sb: i64 = 0;
    if s {
        sb = 1;
    }
    t2_word(e, 0xF000 | ((op & 15) << 5) | (sb << 4) | (n & 15), ((d & 15) << 8) | (imm8 & 255));
}

/// lsl.w / lsr.w / asr.w d, m, #amt (1..31): mov.w with a shifted operand
pub fn t2_shift_imm(e: & mut NatEnc, stype: i64, d: i64, m: i64, amt: i64) {
    t2_dp(e, TDP_ORR, false, d, 15, m, stype, amt);
}

/// umull lo, hi, n, m (64-bit product of unsigned words)
pub fn t2_umull(e: & mut NatEnc, lo: i64, hi: i64, n: i64, m: i64) {
    t2_word(e, 0xFBA0 | (n & 15), ((lo & 15) << 12) | ((hi & 15) << 8) | (m & 15));
}

/// mla d, n, m, a (d = a + n * m) and mls d, n, m, a (d = a - n * m)
pub fn t2_mla(e: & mut NatEnc, d: i64, n: i64, m: i64, a: i64) {
    t2_word(e, 0xFB00 | (n & 15), ((a & 15) << 12) | ((d & 15) << 8) | (m & 15));
}

pub fn t2_mls(e: & mut NatEnc, d: i64, n: i64, m: i64, a: i64) {
    t2_word(e, 0xFB00 | (n & 15), ((a & 15) << 12) | ((d & 15) << 8) | 0x10 | (m & 15));
}

/// sxtb.w (kind 0), sxth.w (1), uxtb.w (2), uxth.w (3) d, m
pub fn t2_ext(e: & mut NatEnc, kind: i64, d: i64, m: i64) {
    var hw1: i64 = 0xFA4F;
    if kind == 1 {
        hw1 = 0xFA0F;
    } else if kind == 2 {
        hw1 = 0xFA5F;
    } else if kind == 3 {
        hw1 = 0xFA1F;
    }
    t2_word(e, hw1, 0xF080 | ((d & 15) << 8) | (m & 15));
}

/// strh.w (kind 0), ldrh.w (1), ldrsb.w (2), ldrsh.w (3) t, [n, #imm12]
pub fn t2_ldst_x(e: & mut NatEnc, kind: i64, t: i64, n: i64, imm: i64) {
    var hw1: i64 = 0xF8A0;
    if kind == 1 {
        hw1 = 0xF8B0;
    } else if kind == 2 {
        hw1 = 0xF990;
    } else if kind == 3 {
        hw1 = 0xF9B0;
    }
    t2_word(e, hw1 | (n & 15), ((t & 15) << 12) | (imm & 0xFFF));
}

/// svc #imm8 (a Linux system call is svc 0), blx m, and the 16-bit mov
/// of any two registers (mov sp, r12 among them)
pub fn t_svc(e: & mut NatEnc, imm: i64) {
    NatEnc_half(e, 0xDF00 | (imm & 255));
}

pub fn t_blx(e: & mut NatEnc, m: i64) {
    NatEnc_half(e, 0x4780 | ((m & 15) << 3));
}

pub fn t_mov(e: & mut NatEnc, d: i64, m: i64) {
    NatEnc_half(e, 0x4600 | (((d >> 3) & 1) << 7) | ((m & 15) << 3) | (d & 7));
}

// SSE2 (and SSE4.1 roundsd, FMA3 vfmadd213sd)

/// xmm x = the 64 bits of r (movq), or the low 32 (movd)
pub fn x64_movq_xr(e: & mut NatEnc, x: i64, r: i64, w: bool) {
    NatEnc_byte(e, 0x66);
    x64_rex(e, w, x, 0, r, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x6E);
    x64_modrm_rr(e, x, r);
}

pub fn x64_movq_rx(e: & mut NatEnc, r: i64, x: i64, w: bool) {
    NatEnc_byte(e, 0x66);
    x64_rex(e, w, x, 0, r, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x7E);
    x64_modrm_rr(e, x, r);
}

/// prefix 0F op /r between xmm registers (F2 58 addsd, 5C subsd, 59 mulsd,
/// 5E divsd, 51 sqrtsd, F3 5A cvtss2sd, F2 5A cvtsd2ss, 66 2E ucomisd)
pub fn x64_sse(e: & mut NatEnc, prefix: i64, op: i64, x1: i64, x2: i64) {
    NatEnc_byte(e, prefix);
    x64_rex(e, false, x1, 0, x2, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, op);
    x64_modrm_rr(e, x1, x2);
}

pub fn x64_cvtsi2sd(e: & mut NatEnc, x: i64, r: i64) {
    NatEnc_byte(e, 0xF2);
    x64_rex(e, true, x, 0, r, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x2A);
    x64_modrm_rr(e, x, r);
}

pub fn x64_cvttsd2si(e: & mut NatEnc, r: i64, x: i64) {
    NatEnc_byte(e, 0xF2);
    x64_rex(e, true, r, 0, x, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x2C);
    x64_modrm_rr(e, r, x);
}

/// roundsd x1, x2, mode (1 floor, 2 ceil, 3 trunc)
pub fn x64_roundsd(e: & mut NatEnc, x1: i64, x2: i64, mode: i64) {
    NatEnc_byte(e, 0x66);
    x64_rex(e, false, x1, 0, x2, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0x3A);
    NatEnc_byte(e, 0x0B);
    x64_modrm_rr(e, x1, x2);
    NatEnc_byte(e, mode);
}

/// xmm0 = xmm1 * xmm0 + xmm2, rounded once
pub fn x64_vfmadd213sd_012(e: & mut NatEnc) {
    NatEnc_byte(e, 0xC4);
    NatEnc_byte(e, 0xE2);
    NatEnc_byte(e, 0xF1);
    NatEnc_byte(e, 0xA9);
    NatEnc_byte(e, 0xC2);
}

// Atomics

/// xchg [base], r (an implicit lock)
pub fn x64_xchg_mem(e: & mut NatEnc, base: i64, r: i64) {
    x64_rex(e, true, r, 0, base, false);
    NatEnc_byte(e, 0x87);
    x64_modrm_mem(e, r, base, 0);
}

/// lock xadd [base], r
pub fn x64_lock_xadd(e: & mut NatEnc, base: i64, r: i64) {
    NatEnc_byte(e, 0xF0);
    x64_rex(e, true, r, 0, base, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0xC1);
    x64_modrm_mem(e, r, base, 0);
}

/// lock cmpxchg [base], r (compares with rax)
pub fn x64_lock_cmpxchg(e: & mut NatEnc, base: i64, r: i64) {
    NatEnc_byte(e, 0xF0);
    x64_rex(e, true, r, 0, base, false);
    NatEnc_byte(e, 0x0F);
    NatEnc_byte(e, 0xB1);
    x64_modrm_mem(e, r, base, 0);
}

// ===========================================================================
// Mach-O (macOS x86-64 / arm64), release F7. `fid emit --target
// x86_64-macos|aarch64-macos`.
//
// The same contiguous image as ELF/PE (code then data), mapped identity:
// vmaddr = NAT_MACHO_BASE + file offset, so NATFIX_ABS64 words (resolved
// against g_nat_abs_base = NAT_MACHO_BASE + NAT_MACHO_HDR) hold the right
// unslid address wherever they point; dyld rebases each by the slide. The
// file is __PAGEZERO (4 GB, no file), __TEXT (r-x: header, load commands,
// code), __DATA (rw: the data region — globals, tables, strings and the
// import GOT), __LINKEDIT (dyld rebase/bind opcodes, symbol table, the
// ad-hoc code signature). Imports are bound into GOT slots and called
// through them (nat_mac_call), as the Windows IAT is. On arm64 the kernel
// refuses an unsigned binary, so a CodeDirectory of SHA-256 page hashes is
// written (ad-hoc, no certificate).
// ===========================================================================

pub const NAT_MACHO_BASE: i64 = 0x100000000;  /// The header + load commands take one page; the code follows.
pub const NAT_MACHO_HDR: i64 = 0x4000;  // ── SHA-256 (for the ad-hoc code signature's page hashes) ───────────────

fn sha_rotr(x: i64, n: i64) -> i64 {
    return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF;
}

fn sha_k(i: i64) -> i64 {
    var k: Vec<i64> = Vec::new();
    k.push(0x428a2f98);
    k.push(0x71374491);
    k.push(0xb5c0fbcf);
    k.push(0xe9b5dba5);
    k.push(0x3956c25b);
    k.push(0x59f111f1);
    k.push(0x923f82a4);
    k.push(0xab1c5ed5);
    k.push(0xd807aa98);
    k.push(0x12835b01);
    k.push(0x243185be);
    k.push(0x550c7dc3);
    k.push(0x72be5d74);
    k.push(0x80deb1fe);
    k.push(0x9bdc06a7);
    k.push(0xc19bf174);
    k.push(0xe49b69c1);
    k.push(0xefbe4786);
    k.push(0x0fc19dc6);
    k.push(0x240ca1cc);
    k.push(0x2de92c6f);
    k.push(0x4a7484aa);
    k.push(0x5cb0a9dc);
    k.push(0x76f988da);
    k.push(0x983e5152);
    k.push(0xa831c66d);
    k.push(0xb00327c8);
    k.push(0xbf597fc7);
    k.push(0xc6e00bf3);
    k.push(0xd5a79147);
    k.push(0x06ca6351);
    k.push(0x14292967);
    k.push(0x27b70a85);
    k.push(0x2e1b2138);
    k.push(0x4d2c6dfc);
    k.push(0x53380d13);
    k.push(0x650a7354);
    k.push(0x766a0abb);
    k.push(0x81c2c92e);
    k.push(0x92722c85);
    k.push(0xa2bfe8a1);
    k.push(0xa81a664b);
    k.push(0xc24b8b70);
    k.push(0xc76c51a3);
    k.push(0xd192e819);
    k.push(0xd6990624);
    k.push(0xf40e3585);
    k.push(0x106aa070);
    k.push(0x19a4c116);
    k.push(0x1e376c08);
    k.push(0x2748774c);
    k.push(0x34b0bcb5);
    k.push(0x391c0cb3);
    k.push(0x4ed8aa4a);
    k.push(0x5b9cca4f);
    k.push(0x682e6ff3);
    k.push(0x748f82ee);
    k.push(0x78a5636f);
    k.push(0x84c87814);
    k.push(0x8cc70208);
    k.push(0x90befffa);
    k.push(0xa4506ceb);
    k.push(0xbef9a3f7);
    k.push(0xc67178f2);
    return k.get(i);
}

/// SHA-256 of bytes `data[from, to)`, as 32 big-endian bytes appended to
/// `out`. 32-bit modular arithmetic throughout.
@wrapping fn sha256_into(out: & mut Vec<i64>, data: & Vec<i64>, from: i64, to: i64) {
    var h0: i64 = 0x6a09e667;
    var h1: i64 = 0xbb67ae85;
    var h2: i64 = 0x3c6ef372;
    var h3: i64 = 0xa54ff53a;
    var h4: i64 = 0x510e527f;
    var h5: i64 = 0x9b05688c;
    var h6: i64 = 0x1f83d9ab;
    var h7: i64 = 0x5be0cd19;
    var len: i64 = to - from;
    var bits: i64 = len * 8;
    // padded message as a byte Vec
    var msg: Vec<i64> = Vec::new();
    var i: i64 = from;
    while i < to {
        msg.push(data.get(i) & 0xFF);
        i = i + 1;
    }
    msg.push(0x80);
    while (msg.len() % 64) != 56 {
        msg.push(0);
    }
    var b: i64 = 7;
    while b >= 0 {
        msg.push((bits >> (b * 8)) & 0xFF);
        b = b - 1;
    }
    var w: Vec<i64> = Vec::new();
    var wi: i64 = 0;
    while wi < 64 {
        w.push(0);
        wi = wi + 1;
    }
    var blk: i64 = 0;
    while blk < msg.len() {
        var t: i64 = 0;
        while t < 16 {
            var o: i64 = blk + t * 4;
            w.set(t, ((msg.get(o) << 24) | (msg.get(o + 1) << 16) | (msg.get(o + 2) << 8) | msg.get(o + 3)) & 0xFFFFFFFF);
            t = t + 1;
        }
        t = 16;
        while t < 64 {
            var x15: i64 = w.get(t - 15);
            var s0: i64 = sha_rotr(x15, 7) ^ sha_rotr(x15, 18) ^ (x15 >> 3);
            var x2: i64 = w.get(t - 2);
            var s1: i64 = sha_rotr(x2, 17) ^ sha_rotr(x2, 19) ^ (x2 >> 10);
            w.set(t, (w.get(t - 16) + s0 + w.get(t - 7) + s1) & 0xFFFFFFFF);
            t = t + 1;
        }
        var a: i64 = h0;
        var bb: i64 = h1;
        var c: i64 = h2;
        var d: i64 = h3;
        var e: i64 = h4;
        var f: i64 = h5;
        var gg: i64 = h6;
        var hh: i64 = h7;
        t = 0;
        while t < 64 {
            var S1: i64 = sha_rotr(e, 6) ^ sha_rotr(e, 11) ^ sha_rotr(e, 25);
            var ch: i64 = (e & f) ^ ((e ^ 0xFFFFFFFF) & gg);
            var t1: i64 = (hh + S1 + ch + sha_k(t) + w.get(t)) & 0xFFFFFFFF;
            var S0: i64 = sha_rotr(a, 2) ^ sha_rotr(a, 13) ^ sha_rotr(a, 22);
            var maj: i64 = (a & bb) ^ (a & c) ^ (bb & c);
            var t2: i64 = (S0 + maj) & 0xFFFFFFFF;
            hh = gg;
            gg = f;
            f = e;
            e = (d + t1) & 0xFFFFFFFF;
            d = c;
            c = bb;
            bb = a;
            a = (t1 + t2) & 0xFFFFFFFF;
            t = t + 1;
        }
        h0 = (h0 + a) & 0xFFFFFFFF;
        h1 = (h1 + bb) & 0xFFFFFFFF;
        h2 = (h2 + c) & 0xFFFFFFFF;
        h3 = (h3 + d) & 0xFFFFFFFF;
        h4 = (h4 + e) & 0xFFFFFFFF;
        h5 = (h5 + f) & 0xFFFFFFFF;
        h6 = (h6 + gg) & 0xFFFFFFFF;
        h7 = (h7 + hh) & 0xFFFFFFFF;
        blk = blk + 64;
    }
    var hs: Vec<i64> = Vec::new();
    hs.push(h0);
    hs.push(h1);
    hs.push(h2);
    hs.push(h3);
    hs.push(h4);
    hs.push(h5);
    hs.push(h6);
    hs.push(h7);
    var j: i64 = 0;
    while j < 8 {
        var v: i64 = hs.get(j);
        out.push((v >> 24) & 0xFF);
        out.push((v >> 16) & 0xFF);
        out.push((v >> 8) & 0xFF);
        out.push(v & 0xFF);
        j = j + 1;
    }
}

/// Round `v` up to a multiple of `n`.
fn nat_round(v: i64, n: i64) -> i64 {
    return (v + n - 1) / n * n;
}

fn nat_macho_dylinker(out: & mut Vec<i64>) {
    var path: str = "/usr/lib/dyld";
    var cmdsize: i64 = nat_round(12 + str_len(path) + 1, 8);
    nat_put_u32(out, 0xE);
    // LC_LOAD_DYLINKER
    nat_put_u32(out, cmdsize);
    nat_put_u32(out, 12);
    // name offset
    var i: i64 = 0;
    while i < str_len(path) {
        out.push(str_byte_at(path, i));
        i = i + 1;
    }
    i = 12 + str_len(path);
    while i < cmdsize {
        out.push(0);
        i = i + 1;
    }
}

fn nat_macho_dylib(out: & mut Vec<i64>) {
    nat_macho_dylib_named(out, "/usr/lib/libSystem.B.dylib");
}

/// TG15: the dylib dyld loads for `extern "C" link "<lib>"` on macOS ("",
/// "c", "m", "pthread", "dl", "System": libSystem, which holds them all).
/// A path ("/..." or "@rpath/...", "@executable_path/...") stays as it is;
/// "Name.framework" (or "framework:Name") is the system framework; a name
/// ending in ".dylib" is under /usr/lib ("z.1.dylib" and "libz.1.dylib":
/// /usr/lib/libz.1.dylib); anything else is /usr/lib/lib<name>.dylib
/// (sqlite3, z, c++, curl, ...).
pub fn nat_macho_dylib_path(lib: str) -> str {
    if lib == "" || lib == "c" || lib == "m" || lib == "pthread" || lib == "dl" || lib == "System" || lib == "System.B" || lib == "rt" {
        return "/usr/lib/libSystem.B.dylib";
    }
    if str_starts_with(lib, "/") || str_starts_with(lib, "@") {
        return lib;
    }
    if str_ends_with(lib, ".framework") {
        var fw: str = str_slice(lib, 0, str_len(lib) - 10);
        return "/System/Library/Frameworks/" + lib + "/" + fw;
    }
    if str_starts_with(lib, "framework:") {
        var fw2: str = str_slice(lib, 10, str_len(lib));
        return "/System/Library/Frameworks/" + fw2 + ".framework/" + fw2;
    }
    if str_ends_with(lib, ".dylib") {
        if str_starts_with(lib, "lib") {
            return "/usr/lib/" + lib;
        }
        return "/usr/lib/lib" + lib;
    }
    return "/usr/lib/lib" + lib + ".dylib";
}

/// TG15: one entry of nat_macho's `imp_names` for symbol `sym` (with its
/// leading underscore) of `link "<lib>"`: the bare symbol when it is
/// libSystem's (dylib ordinal 1), else "<dylib path>|<symbol>", which
/// nat_macho binds through an LC_LOAD_DYLIB of its own.
pub fn nat_macho_import(lib: str, sym: str) -> str {
    var path: str = nat_macho_dylib_path(lib);
    if path == "/usr/lib/libSystem.B.dylib" {
        return sym;
    }
    return path + "|" + sym;
}

/// TG15: `imp_names` (nat_macho) split into what dyld binds: the symbols,
/// each one's dylib ordinal (1: libSystem, 2.. the other dylibs in order of
/// first use) and those other dylibs' paths, through the out parameters.
pub fn nat_macho_split_imports(imp_names: & Vec<str>, syms: & mut Vec<str>, ords: & mut Vec<i64>, dylibs: & mut Vec<str>) {
    var i: i64 = 0;
    while i < imp_names.len() {
        var nm: str = imp_names.get(i);
        var bar: i64 = str_find(nm, "|");
        if bar < 0 {
            syms.push(nm);
            ords.push(1);
        } else {
            var path: str = str_slice(nm, 0, bar);
            syms.push(str_slice(nm, bar + 1, str_len(nm)));
            if path == "/usr/lib/libSystem.B.dylib" {
                ords.push(1);
            } else {
                var k: i64 = 0;
                var found: i64 = 0 - 1;
                while k < dylibs.len() {
                    if dylibs.get(k) == path {
                        found = k;
                    }
                    k = k + 1;
                }
                if found < 0 {
                    dylibs.push(path);
                    found = dylibs.len() - 1;
                }
                ords.push(found + 2);
            }
        }
        i = i + 1;
    }
}

/// True when some import of `imp_names` is not libSystem's (TG15).
fn nat_macho_has_dylibs(imp_names: & Vec<str>) -> bool {
    var i: i64 = 0;
    while i < imp_names.len() {
        if str_find(imp_names.get(i), "|") >= 0 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// TG15: the body of a stub (its label already placed) that calls the C
/// function in GOT slot `slot` (bound by dyld) on Apple arm64, from the
/// machine layer's convention: arguments 0..7 in x0..x7, the rest at
/// [sp + 8 * (j - 8)] at entry, every float as its bits in a general
/// register (an f32 its 32-bit pattern: MI25); the result back in x0.
/// `sig` is ng_ldyn_sig's ("id>w"), with a `.` after the fixed arguments
/// of a variadic C function ("i.id>w": printf's format, then the rest).
/// The fixed arguments follow AAPCS64 (each integer to the next free x
/// register, never above its own, each float to the next d / s register);
/// Apple's variant puts every variadic argument in an 8-byte slot on the
/// stack, from sp up, in order (an f32 promoted to double, as C does),
/// where AAPCS64 proper would use registers. A frame record (x29, x30)
/// around the call; x16 / x17 / v16 are scratch (the intra-procedure-call
/// registers), x18 is never touched (Apple's platform register).
pub fn nat_macho_a64_stub(e: & mut NatEnc, sig: str, slot: i64) {
    var gt: i64 = str_find(sig, ">");
    if gt < 0 {
        gt = str_len(sig);
    }
    var dot: i64 = str_find(sig, ".");
    if dot > gt {
        dot = 0 - 1;
    }
    var nfixed: i64 = gt;
    var nvar: i64 = 0;
    if dot >= 0 {
        nfixed = dot;
        nvar = gt - dot - 1;
    }
    NatEnc_word(e, 0xA9BF7BFD);
    // stp x29, x30, [sp, #-16]!
    a64_add_imm(e, A64_FP, A64_SP, 0);
    var area: i64 = (8 * nvar + 15) & (0 - 16);
    if area > 0 {
        a64_sub_imm(e, A64_SP, A64_SP, area);
    }
    // The variadic arguments first: their registers are above every fixed
    // argument's, which the moves below write
    var v: i64 = 0;
    while v < nvar {
        var j: i64 = nfixed + v;
        var c: i64 = str_byte_at(sig, dot + 1 + v);
        var src: i64 = j;
        if j >= 8 {
            a64_ldr(e, 16, A64_FP, 16 + 8 * (j - 8));
            src = 16;
        }
        if c == 115 {
            // fmov s16, w; fcvt d16, s16; fmov x17, d16
            a64_fmov_sw(e, 16, src);
            a64_fcvt_ds(e, 16, 16);
            a64_fmov_xd(e, 17, 16);
            src = 17;
        }
        a64_str(e, src, A64_SP, 8 * v);
        v = v + 1;
    }
    var ii: i64 = 0;
    var fi: i64 = 0;
    var k: i64 = 0;
    while k < nfixed {
        var c2: i64 = str_byte_at(sig, k);
        var src2: i64 = k;
        if k >= 8 {
            a64_ldr(e, 16, A64_FP, 16 + 8 * (k - 8));
            src2 = 16;
        }
        if c2 == 100 {
            a64_fmov_dx(e, fi, src2);
            fi = fi + 1;
        } else if c2 == 115 {
            a64_fmov_sw(e, fi, src2);
            fi = fi + 1;
        } else {
            if ii != src2 {
                a64_mov(e, ii, src2);
            }
            ii = ii + 1;
        }
        k = k + 1;
    }
    a64_addr(e, 16, slot);
    a64_ldr(e, 16, 16, 0);
    a64_blr(e, 16);
    a64_add_imm(e, A64_SP, A64_FP, 0);
    NatEnc_word(e, 0xA8C17BFD);
    // ldp x29, x30, [sp], #16
    var rc: i64 = 105;
    if gt + 1 < str_len(sig) {
        rc = str_byte_at(sig, gt + 1);
    }
    if rc == 100 {
        a64_fmov_xd(e, 0, 0);
    } else if rc == 115 {
        // the f32's 32-bit pattern, zero-extended (fmov w0, s0)
        a64_fmov_ws(e, 0, 0);
    } else if rc == 119 {
        a64_sxtw(e, 0, 0);
    } else if rc == 87 {
        a64_uxtw(e, 0, 0);
    } else if rc == 104 {
        a64_sxth(e, 0, 0);
    } else if rc == 72 {
        a64_uxth(e, 0, 0);
    } else if rc == 98 {
        a64_sxtb(e, 0, 0);
    } else if rc == 66 {
        a64_uxtb(e, 0, 0);
    }
    a64_ret(e);
}

/// One LC_LOAD_DYLIB command for the dylib at `path`.
fn nat_macho_dylib_named(out: & mut Vec<i64>, path: str) {
    var cmdsize: i64 = nat_round(24 + str_len(path) + 1, 8);
    nat_put_u32(out, 0xC);
    // LC_LOAD_DYLIB
    nat_put_u32(out, cmdsize);
    nat_put_u32(out, 24);
    // name offset
    nat_put_u32(out, 2);
    // timestamp
    nat_put_u32(out, 0x10000);
    // current version
    nat_put_u32(out, 0x10000);
    // compat version
    var i: i64 = 0;
    while i < str_len(path) {
        out.push(str_byte_at(path, i));
        i = i + 1;
    }
    i = 24 + str_len(path);
    while i < cmdsize {
        out.push(0);
        i = i + 1;
    }
}

/// A 64-bit Mach-O executable. `image` is the contiguous code+data blob
/// (code at [0, data_off), data at [data_off, end)); `entry` the entry
/// offset in the code; `rebase_offs` the image offsets of the NATFIX_ABS64
/// words (each >= data_off); `imp_names` the libSystem symbols and
/// `imp_offs` their GOT slot offsets in the image (each >= data_off).
/// g_nat_abs_base must already be NAT_MACHO_BASE + NAT_MACHO_HDR.
/// `names` / `starts`: the functions placed in the code and their image
/// offsets (DB2, DB10: local symbols of __text, so nm, lldb, Instruments
/// and atos name our functions; empty: no symbols).
pub fn nat_macho(arch: i64, image: Vec<i64>, entry: i64, data_off: i64, rebase_offs: Vec<i64>, imp_names: Vec<str>, imp_offs: Vec<i64>, names: Vec<str>, starts: Vec<i64>) -> Vec<i64> {
    // TG13: a layout over image_writer (nat_macho_img; the old body,
    // checked byte for byte against it on Nov 17, is gone:
    // docs/image-writer.md). TG15's dylibs other than libSystem were only
    // ever bound here.
    return nat_macho_img(arch, & image, entry, data_off, & rebase_offs, & imp_names, & imp_offs, & names, & starts);
}

/// TG13: nat_macho as a layout over image_writer (same arguments, same
/// bytes): __PAGEZERO, __TEXT (the headers and code), __DATA, __LINKEDIT
/// (rebase and bind opcodes, the symbols, their names, the signature).
pub fn nat_macho_img(arch: i64, image: & Vec<i64>, entry: i64, data_off: i64, rebase_offs: & Vec<i64>, imp_names: & Vec<str>, imp_offs: & Vec<i64>, names: & Vec<str>, starts: & Vec<i64>) -> Vec<i64> {
    var page: i64 = 0x1000;
    var cputype: i64 = 0x01000007;
    var cpusub: i64 = 3;
    if arch == NAT_A64 {
        page = 0x4000;
        cputype = 0x0100000C;
        cpusub = 0;
    }
    var H: i64 = NAT_MACHO_HDR;
    var base: i64 = NAT_MACHO_BASE;
    var imglen: i64 = image.len();
    var text_fileend: i64 = img_round(H + data_off, page);
    var datalen: i64 = imglen - data_off;
    var data_fileoff: i64 = text_fileend;
    var data_filelen: i64 = img_round(datalen, page);
    var le_fileoff: i64 = data_fileoff + data_filelen;
    // TL5: a debug build's DWARF (nat_macho_debug) in a __DWARF segment
    // between __DATA and __LINKEDIT
    var dw_parts: Vec<Vec<i64>> = Vec::new();
    var dw_fileoff: i64 = le_fileoff;
    var dw_seglen: i64 = 0;
    if g_nat_macho_dw_rows.len() > 2 && names.len() > 0 && g_nat_macho_dw_ends.len() == names.len() {
        dw_parts = nat_macho_dwarf(names, starts, g_nat_macho_dw_ends, g_nat_macho_dw_file, g_nat_macho_dw_rows, base + H);
        var dw_len: i64 = 0;
        var dpi: i64 = 0;
        while dpi < dw_parts.len() {
            var dwp0: Vec<i64> = dw_parts.get(dpi);
            dw_len = dw_len + dwp0.len();
            dpi = dpi + 1;
        }
        dw_seglen = img_round(dw_len, page);
        le_fileoff = dw_fileoff + dw_seglen;
    }
    // the absolute words to rebase and the imports to bind, in __DATA
    // (segment 2), from libSystem (ordinal 1)
    var rebase: Vec<i64> = img_macho_rebase(rebase_offs, 2, data_off);
    var bind: Vec<i64> = Vec::new();
    // TG15: imports of other dylibs ("<path>|<symbol>", nat_macho_import)
    // are bound by their dylib's ordinal; LC_LOAD_DYLIB for each below
    var dylibs: Vec<str> = Vec::new();
    if nat_macho_has_dylibs(imp_names) {
        var bsyms: Vec<str> = Vec::new();
        var bords: Vec<i64> = Vec::new();
        nat_macho_split_imports(imp_names, & mut bsyms, & mut bords, & mut dylibs);
        bind = img_macho_bind_ords(& bsyms, & bords, imp_offs, 2, data_off);
    } else {
        bind = img_macho_bind(imp_names, imp_offs, 2, data_off, 1);
    }
    img_align(& mut rebase, 8);
    img_align(& mut bind, 8);
    var rebase_off: i64 = le_fileoff;
    var bind_off: i64 = rebase_off + rebase.len();
    var symoff: i64 = bind_off + bind.len();
    // one local N_SECT symbol per function in section 1 (__text)
    var none: Vec<i64> = Vec::new();
    var fsyms: Vec<ImgSym> = img_func_syms(names, starts, & none, base + H, 1, IMG_LOCAL);
    var nsyms: i64 = fsyms.len();
    var strtab: Vec<i64> = Vec::new();
    strtab.push(0);
    var syms: Vec<i64> = img_macho_symtab(& fsyms, & mut strtab);
    var stroff: i64 = symoff + syms.len();
    img_align(& mut strtab, 8);
    var strsize: i64 = strtab.len();
    var sig_off: i64 = img_round(stroff + strsize, 16);
    // the ad-hoc code signature's size (codeLimit = sig_off)
    var ident: str = "a.out";
    var ident_len: i64 = str_len(ident) + 1;
    var ncode: i64 = (sig_off + 4095) / 4096;
    var cd_len: i64 = 88 + ident_len + ncode * 32;
    var sig_len: i64 = 20 + cd_len;
    var file_end: i64 = sig_off + sig_len;
    var le_filelen: i64 = file_end - le_fileoff;
    // load commands
    var lc: Vec<i64> = Vec::new();
    img_macho_segment(& mut lc, "__PAGEZERO", 0, base, 0, 0, 0, 0, 0);
    img_macho_segment(& mut lc, "__TEXT", base, img_round(text_fileend, page), 0, text_fileend, 5, 5, 1);
    img_macho_section(& mut lc, "__text", "__TEXT", base + H, data_off, H, 2, 0x80000400);
    var dvm: i64 = base + data_fileoff;
    img_macho_segment(& mut lc, "__DATA", dvm, img_round(datalen, page), data_fileoff, data_filelen, 3, 3, 1);
    img_macho_section(& mut lc, "__data", "__DATA", dvm, datalen, data_fileoff, 3, 0);
    var ndw: i64 = 0;
    if dw_parts.len() > 0 {
        nat_macho_dwarf_seg(& mut lc, & dw_parts, base + dw_fileoff, dw_fileoff, dw_seglen);
        ndw = 1;
    }
    img_macho_segment(& mut lc, "__LINKEDIT", base + le_fileoff, img_round(le_filelen, page), le_fileoff, le_filelen, 1, 1, 0);
    img_macho_dyld_info_cmd(& mut lc, rebase_off, rebase.len(), bind_off, bind.len());
    img_macho_symtab_cmd(& mut lc, symoff, nsyms, stroff, strsize);
    // every symbol local, no external or undefined ones (dyld binds by
    // the opcodes' names)
    img_macho_dysymtab_cmd(& mut lc, 0, nsyms, nsyms, 0, nsyms, 0);
    nat_macho_dylinker(& mut lc);
    // LC_BUILD_VERSION: macOS, minos 11.0, sdk 13.0, 0 tools
    img_u32(& mut lc, 0x32);
    img_u32(& mut lc, 24);
    img_u32(& mut lc, 1);
    img_u32(& mut lc, 0x000B0000);
    img_u32(& mut lc, 0x000D0000);
    img_u32(& mut lc, 0);
    // LC_MAIN
    img_u32(& mut lc, 0x80000028);
    img_u32(& mut lc, 24);
    img_u64(& mut lc, H + entry);
    img_u64(& mut lc, 0);
    nat_macho_dylib(& mut lc);
    // TG15: the other dylibs, ordinals 2.. in this order
    var dyi: i64 = 0;
    while dyi < dylibs.len() {
        nat_macho_dylib_named(& mut lc, dylibs.get(dyi));
        dyi = dyi + 1;
    }
    // LC_CODE_SIGNATURE
    img_u32(& mut lc, 0x1D);
    img_u32(& mut lc, 16);
    img_u32(& mut lc, sig_off);
    img_u32(& mut lc, sig_len);
    if 32 + lc.len() > H {
        return Vec::new();
    }
    var out: Vec<i64> = Vec::new();
    img_macho_header(& mut out, cputype, cpusub, 2, 12 + dylibs.len() + ndw, lc.len(), 0x00200085);
    // MH_EXECUTE, 12 commands (and one per other dylib, one for __DWARF);
    // NOUNDEFS | DYLDLINK | TWOLEVEL | PIE
    img_append(& mut out, & lc);
    img_pad_to(& mut out, H);
    img_append(& mut out, image);
    img_pad_to(& mut out, dw_fileoff);
    var dwi: i64 = 0;
    while dwi < dw_parts.len() {
        var dwp: Vec<i64> = dw_parts.get(dwi);
        img_append(& mut out, & dwp);
        dwi = dwi + 1;
    }
    img_pad_to(& mut out, le_fileoff);
    img_append(& mut out, & rebase);
    img_append(& mut out, & bind);
    img_append(& mut out, & syms);
    img_append(& mut out, & strtab);
    img_pad_to(& mut out, sig_off);
    nat_macho_codesig(& mut out, sig_off, sig_len, cd_len, ncode, ident, text_fileend);
    return out;
}

// --- TL5: DWARF in Mach-O images --------------------------------------------
// A debug build for macOS keeps its line table and its functions in the
// executable itself, in a __DWARF segment (__debug_abbrev, __debug_info,
// __debug_line, flags S_ATTR_DEBUG) between __DATA and __LINKEDIT, as Go's
// linker does: lldb and dsymutil read the sections from there (no .dSYM
// needed). The segment is mapped read-only and its vmsize covers its file
// size (dyld refuses a segment whose file size exceeds its vmsize);
// __LINKEDIT stays last in the file, as the code signature requires.

/// The end offsets, line rows and input file of the image nat_macho_debug
/// is writing (empty outside it).
pub var g_nat_macho_dw_ends: Vec<i64> = Vec::new();
pub var g_nat_macho_dw_rows: Vec<i64> = Vec::new();
pub var g_nat_macho_dw_file: str = "";
/// CT9: the __DWARF sections nat_macho_debug_cfi built in full (types,
/// variables, frames: nat_macho_dwarf_full), one after the other, and the
/// length of each; empty: nat_macho_dwarf's functions and lines only.
pub var g_nat_macho_dw_full: Vec<i64> = Vec::new();
pub var g_nat_macho_dw_lens: Vec<i64> = Vec::new();

/// nat_macho with DWARF: `ends` the end offset of each function of
/// `names` / `starts`, `file` the input file, `lrows` the line rows
/// (nat_debug_line's [image offset, line, 2 * file + end?]). Without rows
/// or functions the image is nat_macho's.
pub fn nat_macho_debug(arch: i64, image: Vec<i64>, entry: i64, data_off: i64, rebase_offs: Vec<i64>, imp_names: Vec<str>, imp_offs: Vec<i64>, names: Vec<str>, starts: Vec<i64>, ends: Vec<i64>, file: str, lrows: Vec<i64>) -> Vec<i64> {
    var no_cfi: Vec<i64> = Vec::new();
    return nat_macho_debug_cfi(arch, image, entry, data_off, rebase_offs, imp_names, imp_offs, names, starts, ends, file, lrows, no_cfi);
}

/// CT9: nat_macho_debug with the frame rows `cfi` (DB6, nat_elf_debug's).
/// When the program's struct types (g_nat_dbg_types) or its variables
/// (g_nat_dbg_ext, g_nat_dbg_vars) are there, the __DWARF segment holds
/// the DWARF a Linux image has (nat_macho_dwarf_full): the names as Fides
/// writes them, the structs with their fields, each function's parameters
/// and variables with their types and locations, .debug_frame and
/// .debug_loc; so lldb's `breakpoint set -n 'Point::len2'`, `type lookup
/// Seg` and `frame variable` work. Without them, nat_macho_dwarf's
/// functions and lines (as before).
pub fn nat_macho_debug_cfi(arch: i64, image: Vec<i64>, entry: i64, data_off: i64, rebase_offs: Vec<i64>, imp_names: Vec<str>, imp_offs: Vec<i64>, names: Vec<str>, starts: Vec<i64>, ends: Vec<i64>, file: str, lrows: Vec<i64>, cfi: Vec<i64>) -> Vec<i64> {
    if names.len() == 0 || lrows.len() < 3 || ends.len() != names.len() {
        return nat_macho(arch, image, entry, data_off, rebase_offs, imp_names, imp_offs, names, starts);
    }
    g_nat_macho_dw_ends = ends;
    g_nat_macho_dw_rows = lrows;
    g_nat_macho_dw_file = file;
    if g_nat_dbg_ext || g_nat_dbg_types.len() > 0 {
        var fparts: Vec<Vec<i64>> = nat_macho_dwarf_full(arch, image, names, starts, ends, file, lrows, cfi);
        var flat: Vec<i64> = Vec::new();
        var lens: Vec<i64> = Vec::new();
        var fp: i64 = 0;
        while fp < fparts.len() {
            var fpart: Vec<i64> = fparts.get(fp);
            lens.push(fpart.len());
            img_append(& mut flat, & fpart);
            fp = fp + 1;
        }
        g_nat_macho_dw_full = flat;
        g_nat_macho_dw_lens = lens;
    }
    var out: Vec<i64> = nat_macho_img(arch, & image, entry, data_off, & rebase_offs, & imp_names, & imp_offs, & names, & starts);
    g_nat_macho_dw_ends = Vec::new();
    g_nat_macho_dw_rows = Vec::new();
    g_nat_macho_dw_file = "";
    g_nat_macho_dw_full = Vec::new();
    g_nat_macho_dw_lens = Vec::new();
    return out;
}

/// CT9: the full DWARF of a Mach-O image (code offset 0 at NAT_MACHO_BASE
/// + NAT_MACHO_HDR), the sections nat_dwarf_build writes for ELF and
/// `--nat` PE: [__debug_abbrev, __debug_info, __debug_line, __debug_frame]
/// and __debug_loc when a value has a location list.
pub fn nat_macho_dwarf_full(arch: i64, image: Vec<i64>, names: Vec<str>, starts: Vec<i64>, ends: Vec<i64>, file: str, lrows: Vec<i64>, cfi: Vec<i64>) -> Vec<Vec<i64>> {
    var abase: i64 = NAT_MACHO_BASE + NAT_MACHO_HDR;
    var dw: NatDwarf = nat_dwarf_build(arch, image, abase, names, starts, ends, file, lrows, cfi, true);
    var fname: str = file;
    if fname == "" {
        fname = "fides";
    }
    var parts: Vec<Vec<i64>> = Vec::new();
    parts.push(dw.abbrev);
    parts.push(dw.info);
    parts.push(nat_debug_line_at(fname, lrows, abase));
    parts.push(dw.frame);
    if dw.dloc.len() > 0 {
        parts.push(dw.dloc);
    }
    return parts;
}

/// The DWARF 4 sections of a Mach-O image, [__debug_abbrev, __debug_info,
/// __debug_line], for the functions `names` at image offsets [starts,
/// ends) with line rows `lrows`; image offset 0 is at address `abase`. The
/// compile unit is named `file` and spans the functions; each function has
/// its declaration file and line (the file of its first row and the `fn`
/// line there, as nat_elf_debug's DB2 entries) and, when g_nat_dbg_shown names it otherwise (a method as
/// written, `Point::len`), that name with its symbol as the linkage name.
pub fn nat_macho_dwarf(names: & Vec<str>, starts: & Vec<i64>, ends: Vec<i64>, file: str, lrows: Vec<i64>, abase: i64) -> Vec<Vec<i64>> {
    // CT9: built in full by nat_macho_debug_cfi (types, variables, frames)
    if g_nat_macho_dw_lens.len() > 0 {
        var full: Vec<Vec<i64>> = Vec::new();
        var fat: i64 = 0;
        var fk: i64 = 0;
        while fk < g_nat_macho_dw_lens.len() {
            var piece: Vec<i64> = Vec::new();
            var fe: i64 = fat + g_nat_macho_dw_lens.get(fk);
            while fat < fe {
                piece.push(g_nat_macho_dw_full.get(fat));
                fat = fat + 1;
            }
            full.push(piece);
            fk = fk + 1;
        }
        return full;
    }
    var fname: str = file;
    if fname == "" {
        fname = "fides";
    }
    var abbrev: Vec<i64> = Vec::new();
    // 1: the compile unit (children)
    abbrev.push(1);
    abbrev.push(0x11);
    abbrev.push(1);
    abbrev.push(0x25);
    abbrev.push(0x08);
    // producer, string
    abbrev.push(0x13);
    abbrev.push(0x05);
    // language, data2
    abbrev.push(0x03);
    abbrev.push(0x08);
    // name, string
    abbrev.push(0x11);
    abbrev.push(0x01);
    // low_pc, addr
    abbrev.push(0x12);
    abbrev.push(0x07);
    // high_pc, data8 (a length)
    abbrev.push(0x10);
    abbrev.push(0x17);
    // stmt_list, sec_offset
    abbrev.push(0);
    abbrev.push(0);
    // 2: a function; 3: one with a linkage name
    var ab: i64 = 2;
    while ab <= 3 {
        abbrev.push(ab);
        abbrev.push(0x2E);
        abbrev.push(0);
        abbrev.push(0x03);
        abbrev.push(0x08);
        // name, string
        if ab == 3 {
            abbrev.push(0x6E);
            abbrev.push(0x08);
            // linkage_name, string
        }
        abbrev.push(0x11);
        abbrev.push(0x01);
        abbrev.push(0x12);
        abbrev.push(0x07);
        abbrev.push(0x3F);
        abbrev.push(0x19);
        // external, flag_present
        abbrev.push(0x3A);
        abbrev.push(0x05);
        // decl_file, data2
        abbrev.push(0x3B);
        abbrev.push(0x06);
        // decl_line, data4
        abbrev.push(0);
        abbrev.push(0);
        ab = ab + 1;
    }
    abbrev.push(0);
    var info: Vec<i64> = Vec::new();
    nat_put_u32(& mut info, 0);
    // unit length, set below
    nat_put_u16(& mut info, 4);
    nat_put_u32(& mut info, 0);
    // abbrev offset
    info.push(8);
    // address size
    info.push(1);
    nat_put_str(& mut info, "fid (Fides)");
    nat_put_u16(& mut info, 0x0C);
    // DW_LANG_C99: what debuggers expect
    nat_put_str(& mut info, fname);
    var lo: i64 = starts.get(0);
    var hi: i64 = ends.get(0);
    var i: i64 = 1;
    while i < names.len() {
        if starts.get(i) < lo {
            lo = starts.get(i);
        }
        if ends.get(i) > hi {
            hi = ends.get(i);
        }
        i = i + 1;
    }
    nat_put_u64(& mut info, abase + lo);
    nat_put_u64(& mut info, hi - lo);
    nat_put_u32(& mut info, 0);
    // the line program at __debug_line + 0
    var dri: i64 = 0;
    // DB2: the `fn` lines, read from the sources (nat_dbg_decl_line)
    var dsrc: NatDeclSrc = NatDeclSrc_new();
    i = 0;
    while i < names.len() {
        var shown: str = "";
        if i < g_nat_dbg_shown.len() {
            shown = g_nat_dbg_shown.get(i);
        }
        if str_len(shown) > 0 && shown != names.get(i) {
            info.push(3);
            nat_put_str(& mut info, shown);
            nat_put_str(& mut info, names.get(i));
        } else {
            info.push(2);
            nat_put_str(& mut info, names.get(i));
        }
        nat_put_u64(& mut info, abase + starts.get(i));
        nat_put_u64(& mut info, ends.get(i) - starts.get(i));
        // the declaration: the first row with a line inside the function
        // (rows and functions are both in image order; a function placed
        // before the one before it starts the scan over)
        if i > 0 && starts.get(i) < starts.get(i - 1) {
            dri = 0;
        }
        while dri + 2 < lrows.len() && lrows.get(dri) < starts.get(i) {
            dri = dri + 3;
        }
        var dfile: i64 = 0;
        var dline: i64 = 0;
        var dk: i64 = dri;
        while dline == 0 && dk + 2 < lrows.len() && lrows.get(dk) < ends.get(i) {
            if (lrows.get(dk + 2) & 1) == 0 && lrows.get(dk + 1) > 0 {
                dfile = (lrows.get(dk + 2) >> 1) + 1;
                dline = lrows.get(dk + 1);
            }
            dk = dk + 3;
        }
        dline = nat_dbg_decl_line(& mut dsrc, nat_decl_path(fname, dfile), dline, names.get(i), shown);
        nat_put_u16(& mut info, dfile);
        nat_put_u32(& mut info, dline);
        i = i + 1;
    }
    info.push(0);
    nat_set_u32(& mut info, 0, info.len() - 4);
    var parts: Vec<Vec<i64>> = Vec::new();
    parts.push(abbrev);
    parts.push(info);
    parts.push(nat_debug_line_at(fname, lrows, abase));
    return parts;
}

/// The __DWARF segment command and its sections (`parts` from
/// nat_macho_dwarf, in its order) at `vmaddr` / file offset `fileoff`,
/// `seglen` bytes (a whole number of pages) in the file and in memory.
fn nat_macho_dwarf_seg(lc: & mut Vec<i64>, parts: & Vec<Vec<i64>>, vmaddr: i64, fileoff: i64, seglen: i64) {
    var snames: Vec<str> = Vec::new();
    snames.push("__debug_abbrev");
    snames.push("__debug_info");
    snames.push("__debug_line");
    // CT9: nat_macho_dwarf_full's frames and location lists
    snames.push("__debug_frame");
    snames.push("__debug_loc");
    var n: i64 = parts.len();
    if n > snames.len() {
        n = snames.len();
    }
    img_macho_segment(lc, "__DWARF", vmaddr, seglen, fileoff, seglen, 1, 1, n);
    var off: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var part: Vec<i64> = parts.get(i);
        img_macho_section(lc, snames.get(i), "__DWARF", vmaddr + off, part.len(), fileoff + off, 0, 0x02000000);
        // S_REGULAR | S_ATTR_DEBUG
        off = off + part.len();
        i = i + 1;
    }
}

/// TG13: the ad-hoc code signature (big-endian) over file [0, sig_off) of
/// `out`, appended to it: a SuperBlob with one CodeDirectory (SHA-256, a
/// hash per 4 KB page, the identifier `ident`, the executable segment
/// [0, text_fileend) of the main binary).
fn nat_macho_codesig(out: & mut Vec<i64>, sig_off: i64, sig_len: i64, cd_len: i64, ncode: i64, ident: str, text_fileend: i64) {
    var ident_len: i64 = str_len(ident) + 1;
    img_be_u32(out, 0xFADE0CC0);
    img_be_u32(out, sig_len);
    img_be_u32(out, 1);
    img_be_u32(out, 0);
    img_be_u32(out, 20);
    // the CodeDirectory at offset 20
    img_be_u32(out, 0xFADE0C02);
    img_be_u32(out, cd_len);
    img_be_u32(out, 0x00020400);
    img_be_u32(out, 2);
    // flags adhoc
    img_be_u32(out, 88 + ident_len);
    // hashOffset
    img_be_u32(out, 88);
    // identOffset
    img_be_u32(out, 0);
    // nSpecialSlots
    img_be_u32(out, ncode);
    // nCodeSlots
    img_be_u32(out, sig_off);
    // codeLimit
    out.push(32);
    out.push(2);
    out.push(0);
    out.push(12);
    // hashSize, SHA256, platform, pageShift
    img_be_u32(out, 0);
    img_be_u32(out, 0);
    img_be_u32(out, 0);
    img_be_u32(out, 0);
    // spare2, scatterOffset, teamOffset, spare3
    img_be_u64(out, 0);
    // codeLimit64
    img_be_u64(out, 0);
    // execSegBase
    img_be_u64(out, text_fileend);
    // execSegLimit
    img_be_u64(out, 1);
    // execSegFlags MAIN_BINARY
    img_cstr(out, ident);
    // the hashes, from a copy of the signed prefix
    var body: Vec<i64> = Vec::new();
    var bj: i64 = 0;
    while bj < sig_off {
        body.push(out.get(bj));
        bj = bj + 1;
    }
    var pg: i64 = 0;
    while pg < ncode {
        var lo: i64 = pg * 4096;
        var hi: i64 = lo + 4096;
        if hi > sig_off {
            hi = sig_off;
        }
        sha256_into(out, & body, lo, hi);
        pg = pg + 1;
    }
}

/// L2B: the Mach-O CPU type and subtype of a 64-bit Mach-O `m`
/// (mach_header_64: magic 0xFEEDFACF, cputype and cpusubtype little-endian
/// at 4 and 8), [-1, -1] when m is not one.
pub fn nat_macho_cpu(m: & Vec<i64>) -> Vec<i64> {
    var r: Vec<i64> = Vec::new();
    if m.len() < 32 || nat_le32_at(m, 0) != 0xFEEDFACF {
        r.push(0 - 1);
        r.push(0 - 1);
        return r;
    }
    r.push(nat_le32_at(m, 4));
    r.push(nat_le32_at(m, 8) & 0xFFFFFF);
    return r;
}

fn nat_le32_at(b: & Vec<i64>, at: i64) -> i64 {
    return b.get(at) | (b.get(at + 1) << 8) | (b.get(at + 2) << 16) | (b.get(at + 3) << 24);
}

/// L2B: a macOS universal ("fat") binary holding the two 64-bit Mach-O
/// executables `first` and `second` (nat_macho's output, x86-64 and
/// AArch64): a big-endian fat_header (magic 0xCAFEBABE, 2 architectures),
/// one fat_arch each (cputype, cpusubtype, offset, size, align = 14, as
/// lipo writes for arm64), then each slice at a 16 KB boundary. Each
/// slice keeps its own code signature (the fat wrapper is not signed).
/// Empty when either is not a 64-bit Mach-O, or both have one CPU type.
pub fn nat_macho_fat(first: Vec<i64>, second: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var c1: Vec<i64> = nat_macho_cpu(& first);
    var c2: Vec<i64> = nat_macho_cpu(& second);
    if c1.get(0) < 0 || c2.get(0) < 0 || c1.get(0) == c2.get(0) {
        return out;
    }
    var align: i64 = 0x4000;
    var off1: i64 = align;
    var off2: i64 = nat_round(off1 + first.len(), align);
    // TG13: the fat header from image_writer
    img_be_u32(& mut out, 0xCAFEBABE);
    img_be_u32(& mut out, 2);
    img_fat_arch(& mut out, c1.get(0), c1.get(1), off1, first.len(), 14);
    img_fat_arch(& mut out, c2.get(0), c2.get(1), off2, second.len(), 14);
    img_pad_to(& mut out, off1);
    img_append(& mut out, & first);
    img_pad_to(& mut out, off2);
    img_append(& mut out, & second);
    return out;
}

// ===========================================================================
// WP17: hot functions together. With a profile (`fid run --profile`, read
// by `--profile-use`: compiler/pgo.fd), nat_ir's emission order puts the
// functions the run called first, most called first; the rest keep the
// call-graph order. pgo_apply's reordering of module.functions does not
// reach this layer: it lays functions out in its own order.
// ===========================================================================

/// `idx` (positions of functions named `names`) with the ones the profile
/// counts first, by count (equal counts keep their order), then the rest
/// in their order. Without a profile, or when it names none of them, `idx`
/// comes back as it was.
pub fn nat_hot_first(idx: Vec<i64>, names: Vec<str>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if idx.len() != names.len() {
        var c0: i64 = 0;
        while c0 < idx.len() {
            out.push(idx.get(c0));
            c0 = c0 + 1;
        }
        return out;
    }
    var counts: Vec<i64> = Vec::new();
    var hot: Vec<i64> = Vec::new();
    var cold: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < names.len() {
        var c: i64 = pgo_count(names.get(i));
        counts.push(c);
        if c > 0 {
            hot.push(i);
        } else {
            cold.push(i);
        }
        i = i + 1;
    }
    // insertion sort of the hot positions by count, most first (stable)
    var k: i64 = 1;
    while k < hot.len() {
        var cur: i64 = hot.get(k);
        var j: i64 = k - 1;
        while j >= 0 && counts.get(hot.get(j)) < counts.get(cur) {
            hot.set(j + 1, hot.get(j));
            j = j - 1;
        }
        hot.set(j + 1, cur);
        k = k + 1;
    }
    i = 0;
    while i < hot.len() {
        out.push(idx.get(hot.get(i)));
        i = i + 1;
    }
    i = 0;
    while i < cold.len() {
        out.push(idx.get(cold.get(i)));
        i = i + 1;
    }
    return out;
}

// ===========================================================================
// DB1: the files of the line table. File 0 is the input file (main.fd's
// g_nat_lines_file); a function of another file of the program (ir.fd
// ir_fn_file) gets the index of its own file. A row's third word is
// 2 * file index, plus 1 for the end of a sequence (nat_debug_line).
// ===========================================================================

pub var g_nat_line_files: Vec<str> = Vec::new();
/// The file index of the function whose rows are being written.
pub var g_nat_line_file_ix: i64 = 0;
var g_nat_line_file_map: i64 = 0;  // path -> index + 1
var g_nat_line_fn_map: i64 = 0;  // function name -> index + 1

/// A new image: the file table holds only the input file.
pub fn nat_line_files_reset(main_file: str) {
    g_nat_line_files = Vec::new();
    g_nat_line_files.push(main_file);
    g_nat_line_file_map = HashMap_new();
    HashMap_insert(g_nat_line_file_map, main_file, 1);
    g_nat_line_fn_map = HashMap_new();
    g_nat_line_file_ix = 0;
}

/// The index of `path` in the file table (added when new).
pub fn nat_line_file_index(path: str) -> i64 {
    if g_nat_line_file_map == 0 {
        nat_line_files_reset("");
    }
    var v: i64 = HashMap_get(g_nat_line_file_map, path);
    if v > 0 {
        return v - 1;
    }
    g_nat_line_files.push(path);
    HashMap_insert(g_nat_line_file_map, path, g_nat_line_files.len());
    return g_nat_line_files.len() - 1;
}

/// Record the file index of function `name` (its rows are written later,
/// when the function is emitted).
pub fn nat_line_fn_set(name: str, ix: i64) {
    if g_nat_line_fn_map == 0 {
        g_nat_line_fn_map = HashMap_new();
    }
    HashMap_insert(g_nat_line_fn_map, name, ix + 1);
}

/// The file index nat_line_fn_set recorded for `name` (0: the input file).
pub fn nat_line_fn_file(name: str) -> i64 {
    if g_nat_line_fn_map == 0 {
        return 0;
    }
    var v: i64 = HashMap_get(g_nat_line_fn_map, name);
    if v <= 0 {
        return 0;
    }
    return v - 1;
}

// ===========================================================================
// TG12: object files. `nat_emit_object` (nat_ir.fd) builds the image as
// for an executable and then writes it as a relocatable ELF64 object
// (ET_REL) instead: one `.text` section holding code and data as the
// executable's one segment does (read/write/execute; aligned to a page, so
// AArch64's ADRP page arithmetic between the section's own words holds),
// a RELA relocation per absolute word (NATFIX_ABS64: the section's symbol
// plus the word's image offset), a local function symbol per function and
// one global, `fid_main`: the program's entry (what the executable's
// `_start` is: it reads argc/argv from the stack, runs main and exits the
// process). Linked alone (`ld -e fid_main prog.o -o prog`) it is the
// program `fid emit` builds. The functions keep the machine layer's own
// calling convention (results in argument register 0), not the C one, so
// they stay local: C code can start the program, not call into it yet.
// ===========================================================================

/// Set by nat_emit_object while it builds the image.
pub var g_nat_object: bool = false;

/// The relocatable object of `image` (see above): `names`/`starts`/`ends`
/// the functions (image offsets, address order), `entry` the entry's
/// offset, `fixups` the image's fixups (the NATFIX_ABS64 ones become
/// relocations; the image holds their resolved words, which give the
/// addends).
@wrapping pub fn nat_elf_object(arch: i64, image: Vec<i64>, entry: i64, names: Vec<str>, starts: Vec<i64>, ends: Vec<i64>, fixups: Vec<NatFix>) -> Vec<i64> {
    // TG13: a layout over image_writer (nat_elf_object_img; the old body,
    // checked byte for byte against it on Nov 17, is gone:
    // docs/image-writer.md)
    return nat_elf_object_img(arch, & image, entry, & names, & starts, & ends, & fixups);
}

/// TG13: nat_elf_object as a layout over image_writer: the header, .text
/// (16-aligned in the file, its absolute words zero), .rela.text, .symtab
/// (null, the section, the functions local, fid_main global), .strtab,
/// .note.GNU-stack (empty), .shstrtab, then the section headers.
@wrapping pub fn nat_elf_object_img(arch: i64, image: & Vec<i64>, entry: i64, names: & Vec<str>, starts: & Vec<i64>, ends: & Vec<i64>, fixups: & Vec<NatFix>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var rtype: i64 = 1;
    // R_X86_64_64
    if arch == NAT_A64 {
        rtype = 257;
        // R_AARCH64_ABS64
    } else if arch != NAT_X64 {
        rtype = 2;
        // R_RISCV_64
    }
    img_elf_header(& mut out, 1, nat_elf_machine(arch), 0, 0, 0, nat_elf_flags(arch), 0, 0, 0, 0);
    // ET_REL; e_shoff, e_shnum and e_shstrndx come with the sections
    img_align(& mut out, 16);
    var text_off: i64 = out.len();
    img_append(& mut out, image);
    // a RELA relocation against the section's symbol (1) per absolute
    // word; the image holds the resolved word, which gives the addend
    var rela: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < fixups.len() {
        var f: NatFix = fixups.get(i);
        if f.kind == NATFIX_ABS64 && f.pos + 8 <= image.len() {
            var word: i64 = 0;
            var k: i64 = 7;
            while k >= 0 {
                word = (word << 8) | image.get(f.pos + k);
                k = k - 1;
            }
            img_elf_rela(& mut rela, f.pos, 1, rtype, word - g_nat_abs_base);
            img_set_u64(& mut out, text_off + f.pos, 0);
        }
        i = i + 1;
    }
    img_align(& mut out, 8);
    var rela_off: i64 = out.len();
    img_append(& mut out, & rela);
    var syms: Vec<ImgSym> = Vec::new();
    syms.push(img_sym("", 0, 0, 1, IMG_SYM_SECTION, IMG_LOCAL));
    var fsyms: Vec<ImgSym> = img_func_syms(names, starts, ends, 0, 1, IMG_LOCAL);
    var j: i64 = 0;
    while j < fsyms.len() {
        syms.push(fsyms.get(j));
        j = j + 1;
    }
    syms.push(img_sym("fid_main", entry, 0, 1, IMG_SYM_FUNC, IMG_GLOBAL));
    // TG12: the C-callable entry points (g_nat_obj_exports), global too
    var xsyms: Vec<ImgSym> = nat_obj_export_syms(1);
    j = 0;
    while j < xsyms.len() {
        syms.push(xsyms.get(j));
        j = j + 1;
    }
    var strtab: Vec<i64> = Vec::new();
    strtab.push(0);
    var symtab: Vec<i64> = img_elf_symtab(& syms, & mut strtab);
    img_align(& mut out, 8);
    var sym_off: i64 = out.len();
    img_append(& mut out, & symtab);
    var str_off: i64 = out.len();
    img_append(& mut out, & strtab);
    var shnames: Vec<str> = Vec::new();
    shnames.push("");
    shnames.push(".text");
    shnames.push(".rela.text");
    shnames.push(".symtab");
    shnames.push(".strtab");
    shnames.push(".note.GNU-stack");
    shnames.push(".shstrtab");
    var shstr: Vec<i64> = img_elf_shstrtab(& shnames);
    var shstr_off: i64 = out.len();
    img_append(& mut out, & shstr);
    img_align(& mut out, 8);
    var secs: Vec<ImgSec> = Vec::new();
    secs.push(img_sec("", 0, 0, 0, 0, 0, 0, 0, 0, 0));
    secs.push(img_sec(".text", 1, 7, 0, text_off, image.len(), 0, 0, 4096, 0));
    // PROGBITS, WRITE | ALLOC | EXECINSTR
    secs.push(img_sec(".rela.text", 4, 0x40, 0, rela_off, rela.len(), 3, 1, 8, 24));
    // RELA, INFO_LINK; symbols in 3, applies to 1
    secs.push(img_sec(".symtab", 2, 0, 0, sym_off, symtab.len(), 4, img_elf_first_global(& syms), 8, 24));
    secs.push(img_sec(".strtab", 3, 0, 0, str_off, strtab.len(), 0, 0, 1, 0));
    secs.push(img_sec(".note.GNU-stack", 1, 0, 0, shstr_off, 0, 0, 0, 1, 0));
    // a non-executable stack
    secs.push(img_sec(".shstrtab", 3, 0, 0, shstr_off, shstr.len(), 0, 0, 1, 0));
    img_elf_sections(& mut out, & secs);
    return out;
}

// ===========================================================================
// TG12: COFF (`--nat` Windows) and Mach-O objects of the same image. Both
// keep the executable's split: the code in one section (.text / __text),
// the data from `data_off` on in another (.data / __data), so the code
// stays read/execute. What the executable resolved against its own fixed
// layout becomes a relocation, read from the image's fixups (`e`, after
// NatEnc_resolve):
//   - every absolute word (NATFIX_ABS64): against the start of the
//     section its target is in, the offset in that section as the addend
//   - a rip-relative reference (NATFIX_X64_REL32) or an ADRP + ADD pair
//     (NATFIX_A64_ADRP_ADD) from the code to the data
//   - a PE RVA (NATFIX_RVA32, the import tables): an image-relative word
// and the import tables the loader filled become relocations against the
// system libraries' symbols: a `--nat` PE's import address table slots
// hold the address of each DLL function (ADDR64 against the function's
// symbol, which the DLL's import library defines), a Mach-O's GOT slots
// the address of each libSystem symbol (UNSIGNED against the undefined
// `_name`). The program's entry is the global `fid_main`, as in the ELF
// object: on Windows the PE's entry point (no arguments), on macOS the
// LC_MAIN entry (dyld's main(argc, argv, envp)). Link:
//   lld-link /entry:fid_main /subsystem:console x.obj   (the DLLs' import
//     libraries come from the object's /DEFAULTLIB directives; MinGW:
//     -nostdlib -Wl,--entry=fid_main x.obj -lkernel32 ...)
//   ld -e _fid_main x.o -lSystem   (macOS; cc -Wl,-e,_fid_main x.o)
// ===========================================================================

/// Why the last nat_coff_object / nat_macho_object returned no bytes ("":
/// it did not fail).
pub var g_nat_obj_err: str = "";

/// TG12: C-callable entry points an object makes global besides fid_main
/// (ELF, COFF and Mach-O alike): each name and the image offset of its
/// code, in the code section. nat_ir.fd sets them before the object is
/// written (the wrappers in the C convention of `pub extern "C"`
/// functions) and clears them after; empty: none.
pub var g_nat_obj_exports: Vec<str> = Vec::new();
pub var g_nat_obj_export_offs: Vec<i64> = Vec::new();

/// The global function symbols of g_nat_obj_exports, in section `sect`.
pub fn nat_obj_export_syms(sect: i64) -> Vec<ImgSym> {
    var out: Vec<ImgSym> = Vec::new();
    var i: i64 = 0;
    while i < g_nat_obj_exports.len() && i < g_nat_obj_export_offs.len() {
        out.push(img_sym(g_nat_obj_exports.get(i), g_nat_obj_export_offs.get(i), 0, sect, IMG_SYM_FUNC, IMG_GLOBAL));
        i = i + 1;
    }
    return out;
}

/// The NUL-terminated string at `at` in `image`.
fn nat_obj_cstr(image: & Vec<i64>, at: i64) -> str {
    var b: Vec<i64> = Vec::new();
    var i: i64 = at;
    while i >= 0 && i < image.len() && image.get(i) != 0 {
        b.push(image.get(i));
        i = i + 1;
    }
    return str_from_bytes(b);
}

/// TG12: the import library a DLL's functions come from (kernel32.dll ->
/// kernel32.lib; the API set of WaitOnAddress -> synchronization.lib).
pub fn nat_coff_dll_lib(dll: str) -> str {
    if str_find(dll, "api-ms-win-core-synch") == 0 {
        return "synchronization.lib";
    }
    var n: i64 = str_len(dll);
    if n > 4 {
        var ext: str = str_slice(dll, n - 4, n);
        if ext == ".dll" || ext == ".DLL" {
            return str_slice(dll, 0, n - 4) + ".lib";
        }
    }
    return dll + ".lib";
}

/// TG12: the imports of a `--nat` PE image, read from its import directory
/// (`imp_off`, `imp_size`: nat_ir.fd ng_gen_win_imports' tables, the image
/// at RVA 0x1000, each import address table slot still holding its
/// hint/name entry's RVA): each slot's image offset, the function's name
/// and its DLL, through the out parameters. "" or what is wrong.
pub fn nat_coff_imports(image: & Vec<i64>, imp_off: i64, imp_size: i64, slots: & mut Vec<i64>, names: & mut Vec<str>, dlls: & mut Vec<str>) -> str {
    var d: i64 = imp_off;
    var more: bool = true;
    while more && d + 20 <= imp_off + imp_size && d + 20 <= image.len() {
        var name_rva: i64 = img_get_u32(image, d + 12);
        var iat_rva: i64 = img_get_u32(image, d + 16);
        if name_rva == 0 && iat_rva == 0 {
            more = false;
        } else {
            var dll: str = nat_obj_cstr(image, name_rva - 0x1000);
            var s: i64 = iat_rva - 0x1000;
            var slot_more: bool = true;
            while slot_more {
                if s < 0 || s + 8 > image.len() {
                    return "an import address table slot is outside the image";
                }
                var lo: i64 = img_get_u32(image, s);
                var hi: i64 = img_get_u32(image, s + 4);
                if lo == 0 && hi == 0 {
                    slot_more = false;
                } else {
                    if hi != 0 {
                        return "an import by ordinal (only imports by name become symbols)";
                    }
                    var nm: str = nat_obj_cstr(image, lo - 0x1000 + 2);
                    if str_len(nm) == 0 {
                        return "an import without a name";
                    }
                    slots.push(s);
                    names.push(nm);
                    dlls.push(dll);
                    s = s + 8;
                }
            }
            d = d + 20;
        }
    }
    return "";
}

/// A section's relocations, with the COFF count overflow (more than 65535:
/// the first entry holds the count, IMAGE_SCN_LNK_NRELOC_OVFL is set).
fn nat_coff_put_relocs(out: & mut Vec<i64>, rel: & Vec<i64>) {
    var n: i64 = rel.len() / 10;
    if n > 0xFFFF {
        img_coff_reloc(out, n + 1, 0, 0);
    }
    img_append(out, rel);
}

fn nat_coff_nreloc(rel: & Vec<i64>) -> i64 {
    var n: i64 = rel.len() / 10;
    if n > 0xFFFF {
        return 0xFFFF;
    }
    return n;
}

fn nat_coff_ovfl(rel: & Vec<i64>) -> i64 {
    if rel.len() / 10 > 0xFFFF {
        return 0x01000000;
    }
    return 0;
}

/// TG12: the COFF object (AMD64) of a `--nat` PE image (see above): `e` the
/// resolved image, `entry` its entry's offset, `data_off` where the data
/// starts (a page boundary), `imp_off`/`imp_size` the import directory,
/// `iat_off`/`iat_size` the import address table (nat_ir.fd passes what it
/// gives nat_pe), `names`/`starts`/`ends` the functions (local symbols).
/// Sections: 1 .text, 2 .data, 3 .drectve (/DEFAULTLIB for each DLL, the
/// PE's 256 MB stack reserve). Symbols: 0 the start of .text, 1 the start
/// of .data (static), the functions (static), `fid_main` (external), then
/// one undefined external per imported function. An empty result:
/// g_nat_obj_err says why.
@wrapping pub fn nat_coff_object(e: & NatEnc, entry: i64, data_off: i64, imp_off: i64, imp_size: i64, iat_off: i64, iat_size: i64, names: & Vec<str>, starts: & Vec<i64>, ends: & Vec<i64>) -> Vec<i64> {
    g_nat_obj_err = "";
    var empty: Vec<i64> = Vec::new();
    var image: Vec<i64> = Vec::new();
    img_append(& mut image, & e.code);
    var len: i64 = image.len();
    if data_off <= 0 || data_off > len {
        g_nat_obj_err = "native backend: --obj: the image has no data part";
        return empty;
    }
    var islots: Vec<i64> = Vec::new();
    var inames: Vec<str> = Vec::new();
    var idlls: Vec<str> = Vec::new();
    var ierr: str = nat_coff_imports(& image, imp_off, imp_size, & mut islots, & mut inames, & mut idlls);
    if ierr != "" {
        g_nat_obj_err = "native backend: --obj: " + ierr;
        return empty;
    }
    var syms: Vec<ImgSym> = Vec::new();
    syms.push(img_sym("fides$t", 0, 0, 1, IMG_SYM_NONE, IMG_LOCAL));
    syms.push(img_sym("fides$d", 0, 0, 2, IMG_SYM_NONE, IMG_LOCAL));
    var fsyms: Vec<ImgSym> = img_func_syms(names, starts, ends, 0, 1, IMG_LOCAL);
    var j: i64 = 0;
    while j < fsyms.len() {
        syms.push(fsyms.get(j));
        j = j + 1;
    }
    syms.push(img_sym("fid_main", entry, 0, 1, IMG_SYM_FUNC, IMG_GLOBAL));
    var xsyms: Vec<ImgSym> = nat_obj_export_syms(1);
    j = 0;
    while j < xsyms.len() {
        syms.push(xsyms.get(j));
        j = j + 1;
    }
    var first_import: i64 = syms.len();
    j = 0;
    while j < inames.len() {
        syms.push(img_sym(inames.get(j), 0, 0, 0, IMG_SYM_FUNC, IMG_GLOBAL));
        j = j + 1;
    }
    // the fixups: IMAGE_REL_AMD64_ADDR64 (1), ADDR32NB (3), REL32 (4)
    var trel: Vec<i64> = Vec::new();
    var drel: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < e.fixups.len() {
        var f: NatFix = e.fixups.get(i);
        var t: i64 = 0 - 1;
        if f.label > 0 && f.label < e.labels.len() {
            t = e.labels.get(f.label);
        }
        var in_iat: bool = f.pos >= iat_off && f.pos < iat_off + iat_size;
        if t < 0 {
            g_nat_obj_err = "native backend: --obj: a fixup's label was never placed";
            return empty;
        }
        var pbase: i64 = 0;
        if f.pos >= data_off {
            pbase = data_off;
        }
        var tbase: i64 = 0;
        var tsym: i64 = 0;
        if t >= data_off {
            tbase = data_off;
            tsym = 1;
        }
        var rtype: i64 = 0;
        if in_iat {
            // the slot becomes an ADDR64 against its function below
            rtype = 0;
        } else if f.kind == NATFIX_ABS64 {
            img_set_u64(& mut image, f.pos, t - tbase);
            rtype = 1;
        } else if f.kind == NATFIX_RVA32 {
            img_set_u32(& mut image, f.pos, t - tbase);
            rtype = 3;
        } else if f.kind == NATFIX_X64_REL32 {
            if pbase != tbase {
                img_set_u32(& mut image, f.pos, t - tbase);
                rtype = 4;
            }
        } else if pbase != tbase {
            g_nat_obj_err = "native backend: --obj: a fixup of kind " + int_to_str(f.kind) + " crosses from the code to the data";
            return empty;
        }
        if rtype != 0 {
            if pbase == 0 {
                img_coff_reloc(& mut trel, f.pos, tsym, rtype);
            } else {
                img_coff_reloc(& mut drel, f.pos - data_off, tsym, rtype);
            }
        }
        i = i + 1;
    }
    // each import address table slot: the address of its function
    j = 0;
    while j < islots.len() {
        var s: i64 = islots.get(j);
        img_set_u64(& mut image, s, 0);
        if s >= data_off {
            img_coff_reloc(& mut drel, s - data_off, first_import + j, 1);
        } else {
            img_coff_reloc(& mut trel, s, first_import + j, 1);
        }
        j = j + 1;
    }
    // the linker directives: each DLL's import library, the stack reserve
    // and commit of nat_pe (SP16)
    var dir: str = "";
    var seen: i64 = HashMap_new();
    j = 0;
    while j < idlls.len() {
        var lib: str = nat_coff_dll_lib(idlls.get(j));
        if !HashMap_contains(seen, lib) {
            HashMap_insert(seen, lib, 1);
            dir = dir + " /DEFAULTLIB:" + lib;
        }
        j = j + 1;
    }
    dir = dir + " /STACK:268435456,65536 ";
    var out: Vec<i64> = Vec::new();
    img_coff_header(& mut out, 0x8664, 3, 0, 0, 0, 0);
    var sh_at: i64 = out.len();
    var z: i64 = 0;
    while z < 120 {
        out.push(0);
        z = z + 1;
    }
    img_align(& mut out, 16);
    var text_at: i64 = out.len();
    img_append_range(& mut out, & image, 0, data_off);
    img_align(& mut out, 4);
    var trel_at: i64 = out.len();
    nat_coff_put_relocs(& mut out, & trel);
    img_align(& mut out, 16);
    var data_at: i64 = out.len();
    img_append_range(& mut out, & image, data_off, len);
    img_align(& mut out, 4);
    var drel_at: i64 = out.len();
    nat_coff_put_relocs(& mut out, & drel);
    var dir_at: i64 = out.len();
    img_bytes(& mut out, dir);
    var hdr: Vec<i64> = Vec::new();
    // CODE | EXECUTE | READ, ALIGN_4096BYTES
    img_coff_section(& mut hdr, ".text", 0, 0, data_off, text_at, trel_at, nat_coff_nreloc(& trel), 0x60D00020 | nat_coff_ovfl(& trel));
    // INITIALIZED_DATA | READ | WRITE, ALIGN_4096BYTES
    img_coff_section(& mut hdr, ".data", 0, 0, len - data_off, data_at, drel_at, nat_coff_nreloc(& drel), 0xC0D00040 | nat_coff_ovfl(& drel));
    // LNK_INFO | LNK_REMOVE, ALIGN_1BYTES
    img_coff_section(& mut hdr, ".drectve", 0, 0, str_len(dir), dir_at, 0, 0, 0x00100A00);
    z = 0;
    while z < hdr.len() {
        out.set(sh_at + z, hdr.get(z));
        z = z + 1;
    }
    var pre: Vec<str> = Vec::new();
    img_coff_symbols(& mut out, & pre, & syms, IMG_COFF_SYMPTR_AT, IMG_COFF_NSYMS_AT);
    return out;
}

/// TG12: the Mach-O object (MH_OBJECT) of a macOS image (see above): `e`
/// the resolved image (its absolute words hold NAT_MACHO_BASE +
/// NAT_MACHO_HDR + offset), `entry` the LC_MAIN entry's offset,
/// `data_off` where the data starts, `imp_names`/`imp_offs` the GOT's
/// symbols and slots (as nat_macho gets them), `names`/`starts`/`ends` the
/// functions. One unnamed segment (the image's offsets are its addresses)
/// with __TEXT,__text and __DATA,__data. x86-64 relocations against the
/// sections (r_extern 0, the target's address in the bytes, as the
/// image already holds it); AArch64 ones against symbols (r_extern 1):
/// a local symbol at the start of each section (ltmp0, ltmp1) for the
/// absolute words and one per ADRP target in the other section (ltmp_<offset>),
/// the immediates cleared. Symbols: those locals and the functions,
/// `_fid_main` (external), then the undefined imports. An empty result:
/// g_nat_obj_err says why.
@wrapping pub fn nat_macho_object(arch: i64, e: & NatEnc, entry: i64, data_off: i64, imp_names: & Vec<str>, imp_offs: & Vec<i64>, names: & Vec<str>, starts: & Vec<i64>, ends: & Vec<i64>) -> Vec<i64> {
    g_nat_obj_err = "";
    var empty: Vec<i64> = Vec::new();
    var a64: bool = arch == NAT_A64;
    if arch != NAT_A64 && arch != NAT_X64 {
        g_nat_obj_err = "native backend: --obj: Mach-O objects are for x86-64 and AArch64";
        return empty;
    }
    var image: Vec<i64> = Vec::new();
    img_append(& mut image, & e.code);
    var len: i64 = image.len();
    if data_off <= 0 || data_off > len {
        g_nat_obj_err = "native backend: --obj: the image has no data part";
        return empty;
    }
    var isyms: Vec<str> = Vec::new();
    var iords: Vec<i64> = Vec::new();
    var idylibs: Vec<str> = Vec::new();
    nat_macho_split_imports(imp_names, & mut isyms, & mut iords, & mut idylibs);
    var nfn: i64 = 0;
    while nfn < names.len() && nfn < starts.len() {
        nfn = nfn + 1;
    }
    // AArch64: the ADRP targets in the other section, each a local symbol
    // 2 + nfn + k
    var tgt: Vec<i64> = Vec::new();
    var tgt_ix: i64 = HashMap_new();
    var i: i64 = 0;
    while i < e.fixups.len() {
        var f0: NatFix = e.fixups.get(i);
        if a64 && f0.kind == NATFIX_A64_ADRP_ADD && f0.label > 0 && f0.label < e.labels.len() {
            var t0: i64 = e.labels.get(f0.label);
            var cross: bool = (f0.pos >= data_off && t0 < data_off) || (f0.pos < data_off && t0 >= data_off);
            if cross {
                var key: str = int_to_str(t0);
                if !HashMap_contains(tgt_ix, key) {
                    tgt.push(t0);
                    HashMap_insert(tgt_ix, key, tgt.len());
                }
            }
        }
        i = i + 1;
    }
    var nlocal: i64 = 2 + nfn + tgt.len();
    var ext_ix: i64 = nlocal;
    var xsyms: Vec<ImgSym> = nat_obj_export_syms(1);
    var undef_ix: i64 = nlocal + 1 + xsyms.len();
    // the relocations: X86_64_RELOC_UNSIGNED 0 / SIGNED 1; ARM64_RELOC_
    // UNSIGNED 0 / PAGE21 3 / PAGEOFF12 4
    var trel: Vec<i64> = Vec::new();
    var drel: Vec<i64> = Vec::new();
    i = 0;
    while i < e.fixups.len() {
        var f: NatFix = e.fixups.get(i);
        var t: i64 = 0 - 1;
        if f.label > 0 && f.label < e.labels.len() {
            t = e.labels.get(f.label);
        }
        if t < 0 {
            g_nat_obj_err = "native backend: --obj: a fixup's label was never placed";
            return empty;
        }
        var in_data: bool = f.pos >= data_off;
        var pbase: i64 = 0;
        if in_data {
            pbase = data_off;
        }
        var tbase: i64 = 0;
        var tsect: i64 = 1;
        if t >= data_off {
            tbase = data_off;
            tsect = 2;
        }
        var rel: Vec<i64> = Vec::new();
        if f.kind == NATFIX_ABS64 {
            if a64 {
                img_set_u64(& mut image, f.pos, t - tbase);
                img_macho_reloc(& mut rel, f.pos - pbase, tsect - 1, false, 3, true, 0);
            } else {
                img_set_u64(& mut image, f.pos, t);
                img_macho_reloc(& mut rel, f.pos - pbase, tsect, false, 3, false, 0);
            }
        } else if f.kind == NATFIX_X64_REL32 && pbase != tbase {
            // the displacement already reaches the target at its address
            img_macho_reloc(& mut rel, f.pos - pbase, tsect, true, 2, false, 1);
        } else if f.kind == NATFIX_A64_ADRP_ADD && pbase != tbase {
            var k: i64 = 2 + nfn + HashMap_get(tgt_ix, int_to_str(t)) - 1;
            img_set_u32(& mut image, f.pos, img_get_u32(& image, f.pos) & 0x9F00001F);
            img_set_u32(& mut image, f.pos + 4, img_get_u32(& image, f.pos + 4) & 0xFFC003FF);
            img_macho_reloc(& mut rel, f.pos - pbase, k, true, 2, true, 3);
            img_macho_reloc(& mut rel, f.pos + 4 - pbase, k, false, 2, true, 4);
        } else if pbase != tbase {
            g_nat_obj_err = "native backend: --obj: a fixup of kind " + int_to_str(f.kind) + " crosses from the code to the data";
            return empty;
        }
        if in_data {
            img_append(& mut drel, & rel);
        } else {
            img_append(& mut trel, & rel);
        }
        i = i + 1;
    }
    // each GOT slot: the address of its symbol
    var j: i64 = 0;
    while j < isyms.len() && j < imp_offs.len() {
        var s: i64 = imp_offs.get(j);
        img_set_u64(& mut image, s, 0);
        if s >= data_off {
            img_macho_reloc(& mut drel, s - data_off, undef_ix + j, false, 3, true, 0);
        } else {
            img_macho_reloc(& mut trel, s, undef_ix + j, false, 3, true, 0);
        }
        j = j + 1;
    }
    // the symbol table: the locals, _fid_main, the imports
    var lsyms: Vec<ImgSym> = Vec::new();
    lsyms.push(img_sym("ltmp0", 0, 0, 1, IMG_SYM_NONE, IMG_LOCAL));
    lsyms.push(img_sym("ltmp1", data_off, 0, 2, IMG_SYM_NONE, IMG_LOCAL));
    var fsyms: Vec<ImgSym> = img_func_syms(names, starts, ends, 0, 1, IMG_LOCAL);
    j = 0;
    while j < fsyms.len() {
        lsyms.push(fsyms.get(j));
        j = j + 1;
    }
    j = 0;
    while j < tgt.len() {
        var tt: i64 = tgt.get(j);
        var ts: i64 = 1;
        if tt >= data_off {
            ts = 2;
        }
        lsyms.push(img_sym("ltmp_" + int_to_str(tt), tt, 0, ts, IMG_SYM_NONE, IMG_LOCAL));
        j = j + 1;
    }
    lsyms.push(img_sym("fid_main", entry, 0, 1, IMG_SYM_FUNC, IMG_GLOBAL));
    j = 0;
    while j < xsyms.len() {
        lsyms.push(xsyms.get(j));
        j = j + 1;
    }
    var strtab: Vec<i64> = Vec::new();
    strtab.push(0);
    var symtab: Vec<i64> = img_macho_symtab(& lsyms, & mut strtab);
    j = 0;
    while j < isyms.len() {
        var strx: i64 = img_str_add(& mut strtab, isyms.get(j));
        // N_UNDF | N_EXT
        img_macho_nlist(& mut symtab, strx, 0x01, 0, 0, 0);
        j = j + 1;
    }
    img_align(& mut strtab, 8);
    var nsyms: i64 = symtab.len() / 16;
    // the layout: header, load commands, the image (its sections at their
    // alignment), the relocations, the symbols, the strings
    var cputype: i64 = 0x01000007;
    var cpusub: i64 = 3;
    var align: i64 = 12;
    if a64 {
        cputype = 0x0100000C;
        cpusub = 0;
        align = 14;
    }
    var sizeofcmds: i64 = (72 + 80 * 2) + 24 + 24 + 80;
    var text_at: i64 = img_round(32 + sizeofcmds, 1 << align);
    var trel_at: i64 = img_round(text_at + len, 8);
    var drel_at: i64 = trel_at + trel.len();
    var sym_at: i64 = drel_at + drel.len();
    var str_at: i64 = sym_at + symtab.len();
    var out: Vec<i64> = Vec::new();
    img_macho_header(& mut out, cputype, cpusub, 1, 4, sizeofcmds, 0);
    img_macho_segment(& mut out, "", 0, len, text_at, len, 7, 7, 2);
    // S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
    img_macho_section_rel(& mut out, "__text", "__TEXT", 0, data_off, text_at, align, trel_at, trel.len() / 8, 0x80000400);
    img_macho_section_rel(& mut out, "__data", "__DATA", data_off, len - data_off, text_at + data_off, align, drel_at, drel.len() / 8, 0);
    // LC_BUILD_VERSION: macOS, minos 11.0, sdk 13.0 (as nat_macho)
    img_u32(& mut out, 0x32);
    img_u32(& mut out, 24);
    img_u32(& mut out, 1);
    img_u32(& mut out, 0x000B0000);
    img_u32(& mut out, 0x000D0000);
    img_u32(& mut out, 0);
    img_macho_symtab_cmd(& mut out, sym_at, nsyms, str_at, strtab.len());
    img_macho_dysymtab_cmd(& mut out, 0, nlocal, ext_ix, 1 + xsyms.len(), undef_ix, nsyms - undef_ix);
    img_pad_to(& mut out, text_at);
    img_append(& mut out, & image);
    img_pad_to(& mut out, trel_at);
    img_append(& mut out, & trel);
    img_append(& mut out, & drel);
    img_append(& mut out, & symtab);
    img_append(& mut out, & strtab);
    return out;
}

// ===========================================================================
// LG13: asm! in a process on the machine-layer targets, by pe_ir's rule
// (nat_ir.fd ng_gen_asm): a template with a privileged instruction, or one
// the encoders do not know, gives 0 as before, so test_asm.fd (which
// writes `hlt` and `cli`) keeps working; FID_NAT_OFF=asm: always 0. Each
// asm! site becomes a call to a thunk of its own placed after the code:
// the thunk saves the callee-saved registers, moves the inputs from the
// argument registers (input i arrives in argument register i) into the
// registers the template names, sets an output register that is not an
// input to 0, runs the template, moves the output register into the
// result register (argument register 0; no output: 0) and returns.
// The register allocator sees an ordinary call to an unknown function
// (every register clobbered), so the template may use any register but
// the stack pointer, which it must leave as it found it. x86-64 templates
// are encoded by pe_ir_stubs's pe_asm_encode (the bare builds' encoder);
// AArch64 and RISC-V templates by nat_asm_encode below.
// ===========================================================================

/// The thunks still to place: [label, byte count, bytes...] each.
pub var g_nat_asm_pending: Vec<i64> = Vec::new();

pub struct NatAsmCode {
    pub bytes: Vec<i64>,
    pub error: str,
}

/// The state of the writers here for a new image (nat_ir calls it first):
/// the line table's files (DB1) and the pending asm! thunks.
pub fn nat_enc_image_start(main_file: str) {
    nat_line_files_reset(main_file);
    g_nat_asm_pending = Vec::new();
}

/// Queue the thunk `code` at `label`.
pub fn nat_asm_add(label: i64, code: Vec<i64>) {
    g_nat_asm_pending.push(label);
    g_nat_asm_pending.push(code.len());
    var i: i64 = 0;
    while i < code.len() {
        g_nat_asm_pending.push(code.get(i));
        i = i + 1;
    }
}

/// Place every queued thunk at the current position (after the code).
pub fn nat_asm_emit(e: & mut NatEnc) {
    var i: i64 = 0;
    while i + 1 < g_nat_asm_pending.len() {
        var label: i64 = g_nat_asm_pending.get(i);
        var n: i64 = g_nat_asm_pending.get(i + 1);
        NatEnc_align(e, 4);
        NatEnc_place(e, label);
        var k: i64 = 0;
        while k < n {
            NatEnc_byte(e, g_nat_asm_pending.get(i + 2 + k));
            k = k + 1;
        }
        i = i + 2 + n;
    }
    g_nat_asm_pending = Vec::new();
}

/// The register number `s` names on `arch` (x86-64: rax..r15; AArch64:
/// x0..x30, fp, lr; RISC-V: x0..x31 and the ABI names), else -1. The stack
/// pointer is never an operand register here.
pub fn nat_asm_reg(arch: i64, s: str) -> i64 {
    var t: str = str_to_lower(str_trim(s));
    if arch == NAT_X64 {
        var x: Vec<str> = str_split("rax,rcx,rdx,rbx,rsp,rbp,rsi,rdi,r8,r9,r10,r11,r12,r13,r14,r15", ",");
        var xi: i64 = 0;
        while xi < x.len() {
            if x.get(xi) == t && xi != 4 {
                return xi;
            }
            xi = xi + 1;
        }
        return 0 - 1;
    }
    if arch == NAT_A64 {
        if t == "fp" {
            return 29;
        }
        if t == "lr" {
            return 30;
        }
        if str_len(t) >= 2 && str_byte_at(t, 0) == 120 {
            return nat_asm_regnum(str_slice(t, 1, str_len(t)), 30);
        }
        return 0 - 1;
    }
    if str_len(t) >= 2 && str_byte_at(t, 0) == 120 {
        return nat_asm_regnum(str_slice(t, 1, str_len(t)), 31);
    }
    var abi: Vec<str> = str_split("zero,ra,sp,gp,tp,t0,t1,t2,s0,s1,a0,a1,a2,a3,a4,a5,a6,a7,s2,s3,s4,s5,s6,s7,s8,s9,s10,s11,t3,t4,t5,t6", ",");
    var ai: i64 = 0;
    while ai < abi.len() {
        if abi.get(ai) == t {
            return ai;
        }
        ai = ai + 1;
    }
    if t == "fp" {
        return 8;
    }
    return 0 - 1;
}

/// A decimal register number 0..max, else -1.
fn nat_asm_regnum(s: str, max: i64) -> i64 {
    if str_len(s) == 0 || str_len(s) > 2 {
        return 0 - 1;
    }
    var v: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if v > max {
        return 0 - 1;
    }
    return v;
}

/// An immediate operand: `#12`, `12`, `-3`, `0x1f`; ok false when it is not one.
pub struct NatAsmImm {
    pub ok: bool,
    pub v: i64,
}

@wrapping fn nat_asm_imm(s: str) -> NatAsmImm {
    var t: str = str_trim(s);
    if str_starts_with(t, "#") {
        t = str_trim(str_slice(t, 1, str_len(t)));
    }
    var neg: bool = false;
    if str_starts_with(t, "-") {
        neg = true;
        t = str_slice(t, 1, str_len(t));
    }
    if str_len(t) == 0 {
        return NatAsmImm {
            ok: false, v: 0
        };
    }
    var v: i64 = 0;
    if str_starts_with(t, "0x") || str_starts_with(t, "0X") {
        if str_len(t) < 3 {
            return NatAsmImm {
                ok: false, v: 0
            };
        }
        var hi: i64 = 2;
        while hi < str_len(t) {
            var hc: i64 = str_byte_at(t, hi);
            var hd: i64 = 0 - 1;
            if hc >= 48 && hc <= 57 {
                hd = hc - 48;
            }
            if hc >= 97 && hc <= 102 {
                hd = hc - 87;
            }
            if hc >= 65 && hc <= 70 {
                hd = hc - 55;
            }
            if hd < 0 {
                return NatAsmImm {
                    ok: false, v: 0
                };
            }
            v = v * 16 + hd;
            hi = hi + 1;
        }
    } else {
        var di: i64 = 0;
        while di < str_len(t) {
            var dc: i64 = str_byte_at(t, di);
            if dc < 48 || dc > 57 {
                return NatAsmImm {
                    ok: false, v: 0
                };
            }
            v = v * 10 + (dc - 48);
            di = di + 1;
        }
    }
    if neg {
        v = 0 - v;
    }
    return NatAsmImm {
        ok: true, v: v
    };
}

/// Encode an asm! template for AArch64 or RISC-V: instructions separated
/// by `;` or new lines. AArch64: nop, yield, isb, dmb/dsb ish|sy, brk #n,
/// svc #n, mov, movz-style `mov xd, #imm`, add/sub (register or #imm),
/// and/orr/eor/mul/sdiv/udiv/lsl/lsr/asr (registers; lsl/lsr/asr also
/// #imm), neg, mvn, mrs xd, cntvct_el0|cntfrq_el0|tpidr_el0. RISC-V: nop,
/// fence, ecall, ebreak, mv, li, neg, not, add/sub/and/or/xor/sll/srl/sra/
/// slt/sltu/mul/mulh/mulhu/div/divu/rem/remu, addi/andi/ori/xori/slli/
/// srli/srai, rdcycle/rdtime/rdinstret. `ret` is refused (it would leave
/// the thunk without restoring what it saved).
pub fn nat_asm_encode(arch: i64, template: str) -> NatAsmCode {
    var e: NatEnc = NatEnc_new();
    var lines: Vec<str> = str_split(str_replace(template, "\n", ";"), ";");
    var i: i64 = 0;
    while i < lines.len() {
        var line: str = str_trim(lines.get(i));
        if str_len(line) > 0 {
            var why: str = "";
            if arch == NAT_A64 {
                why = nat_asm_a64_one(& mut e, line);
            } else {
                why = nat_asm_rv_one(& mut e, line);
            }
            if why != "" {
                return NatAsmCode {
                    bytes: Vec::new(), error: line + ": " + why
                };
            }
        }
        i = i + 1;
    }
    return NatAsmCode {
        bytes: e.code, error: ""
    };
}

/// "op a, b, c" -> [op, a, b, c] (operands trimmed).
fn nat_asm_split(line: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var sp: i64 = 0 - 1;
    var i: i64 = 0;
    while i < str_len(line) && sp < 0 {
        var c: i64 = str_byte_at(line, i);
        if c == 32 || c == 9 {
            sp = i;
        }
        i = i + 1;
    }
    if sp < 0 {
        out.push(str_to_lower(line));
        return out;
    }
    out.push(str_to_lower(str_slice(line, 0, sp)));
    var ops: Vec<str> = str_split(str_slice(line, sp + 1, str_len(line)), ",");
    var k: i64 = 0;
    while k < ops.len() {
        out.push(str_trim(ops.get(k)));
        k = k + 1;
    }
    return out;
}

fn nat_asm_a64_one(e: & mut NatEnc, line: str) -> str {
    var p: Vec<str> = nat_asm_split(line);
    var m: str = p.get(0);
    var n: i64 = p.len() - 1;
    if n == 0 {
        if m == "nop" {
            NatEnc_word(e, 0xD503201F);
            return "";
        }
        if m == "yield" {
            NatEnc_word(e, 0xD503203F);
            return "";
        }
        if m == "isb" {
            NatEnc_word(e, 0xD5033FDF);
            return "";
        }
        if m == "ret" {
            return "ret is not allowed in asm! (the thunk returns itself)";
        }
        return "unknown instruction";
    }
    if (m == "dmb" || m == "dsb") && n == 1 {
        var opt: str = str_to_lower(p.get(1));
        var crm: i64 = 0 - 1;
        if opt == "sy" {
            crm = 15;
        }
        if opt == "ish" {
            crm = 11;
        }
        if opt == "ishld" {
            crm = 9;
        }
        if opt == "ishst" {
            crm = 10;
        }
        if crm < 0 {
            return "unknown barrier option";
        }
        if m == "dmb" {
            NatEnc_word(e, 0xD50330BF | (crm << 8));
        } else {
            NatEnc_word(e, 0xD503309F | (crm << 8));
        }
        return "";
    }
    if (m == "brk" || m == "svc") && n == 1 {
        var bi: NatAsmImm = nat_asm_imm(p.get(1));
        if !bi.ok || bi.v < 0 || bi.v > 0xFFFF {
            return "needs #imm16";
        }
        if m == "brk" {
            NatEnc_word(e, 0xD4200000 | (bi.v << 5));
        } else {
            NatEnc_word(e, 0xD4000001 | (bi.v << 5));
        }
        return "";
    }
    var d: i64 = nat_asm_reg(NAT_A64, p.get(1));
    if d < 0 {
        return "unknown register " + p.get(1);
    }
    if m == "mrs" && n == 2 {
        var sr: str = str_to_lower(p.get(2));
        if sr == "cntvct_el0" {
            NatEnc_word(e, 0xD53BE040 | d);
            return "";
        }
        if sr == "cntfrq_el0" {
            NatEnc_word(e, 0xD53BE000 | d);
            return "";
        }
        if sr == "tpidr_el0" {
            NatEnc_word(e, 0xD53BD040 | d);
            return "";
        }
        return "unknown system register (cntvct_el0, cntfrq_el0, tpidr_el0)";
    }
    if n == 2 {
        var s: i64 = nat_asm_reg(NAT_A64, p.get(2));
        if m == "mov" {
            if s >= 0 {
                a64_mov(e, d, s);
                if d == s {
                    NatEnc_word(e, 0xD503201F);
                }
                return "";
            }
            var mi: NatAsmImm = nat_asm_imm(p.get(2));
            if !mi.ok {
                return "needs a register or #imm";
            }
            a64_li(e, d, mi.v);
            return "";
        }
        if s < 0 {
            return "unknown register " + p.get(2);
        }
        if m == "neg" {
            a64_neg(e, d, s);
            return "";
        }
        if m == "mvn" {
            a64_mvn(e, d, s);
            return "";
        }
        return "unknown instruction";
    }
    if n != 3 {
        return "wrong number of operands";
    }
    var a: i64 = nat_asm_reg(NAT_A64, p.get(2));
    if a < 0 {
        return "unknown register " + p.get(2);
    }
    var b: i64 = nat_asm_reg(NAT_A64, p.get(3));
    if b < 0 {
        var im: NatAsmImm = nat_asm_imm(p.get(3));
        if !im.ok {
            return "unknown register or immediate " + p.get(3);
        }
        if (m == "add" || m == "sub") && im.v >= 0 && im.v < 4096 {
            if m == "add" {
                a64_add_imm(e, d, a, im.v);
            } else {
                a64_sub_imm(e, d, a, im.v);
            }
            return "";
        }
        if (m == "lsl" || m == "lsr" || m == "asr") && im.v >= 0 && im.v < 64 {
            var sh: i64 = im.v;
            if m == "lsl" {
                // UBFM d, a, #(64 - sh) % 64, #(63 - sh)
                NatEnc_word(e, 0xD3400000 | (((64 - sh) & 63) << 16) | ((63 - sh) << 10) | (a << 5) | d);
            } else if m == "lsr" {
                NatEnc_word(e, 0xD3400000 | (sh << 16) | (63 << 10) | (a << 5) | d);
            } else {
                NatEnc_word(e, 0x93400000 | (sh << 16) | (63 << 10) | (a << 5) | d);
            }
            return "";
        }
        return "immediate out of range";
    }
    if m == "add" {
        a64_add(e, d, a, b);
    } else if m == "sub" {
        a64_sub(e, d, a, b);
    } else if m == "and" {
        a64_and(e, d, a, b);
    } else if m == "orr" {
        a64_orr(e, d, a, b);
    } else if m == "eor" {
        a64_eor(e, d, a, b);
    } else if m == "mul" {
        a64_mul(e, d, a, b);
    } else if m == "sdiv" {
        a64_sdiv(e, d, a, b);
    } else if m == "udiv" {
        a64_udiv(e, d, a, b);
    } else if m == "lsl" {
        a64_lslv(e, d, a, b);
    } else if m == "lsr" {
        a64_lsrv(e, d, a, b);
    } else if m == "asr" {
        a64_asrv(e, d, a, b);
    } else {
        return "unknown instruction";
    }
    return "";
}

fn nat_asm_rv_one(e: & mut NatEnc, line: str) -> str {
    var p: Vec<str> = nat_asm_split(line);
    var m: str = p.get(0);
    var n: i64 = p.len() - 1;
    if n == 0 {
        if m == "nop" {
            rv_addi(e, 0, 0, 0);
            return "";
        }
        if m == "fence" {
            rv_fence(e);
            return "";
        }
        if m == "ecall" {
            rv_ecall(e);
            return "";
        }
        if m == "ebreak" {
            rv_ebreak(e);
            return "";
        }
        if m == "ret" {
            return "ret is not allowed in asm! (the thunk returns itself)";
        }
        return "unknown instruction";
    }
    var d: i64 = nat_asm_reg(NAT_RV64, p.get(1));
    if d < 0 {
        return "unknown register " + p.get(1);
    }
    if n == 1 {
        var csr: i64 = 0 - 1;
        if m == "rdcycle" {
            csr = 0xC00;
        }
        if m == "rdtime" {
            csr = 0xC01;
        }
        if m == "rdinstret" {
            csr = 0xC02;
        }
        if csr < 0 {
            return "unknown instruction";
        }
        // csrrs d, csr, x0
        NatEnc_word(e, (csr << 20) | (2 << 12) | (d << 7) | 0x73);
        return "";
    }
    if n == 2 {
        if m == "li" {
            var li: NatAsmImm = nat_asm_imm(p.get(2));
            if !li.ok {
                return "needs an immediate";
            }
            rv_li(e, d, li.v);
            return "";
        }
        var s: i64 = nat_asm_reg(NAT_RV64, p.get(2));
        if s < 0 {
            return "unknown register " + p.get(2);
        }
        if m == "mv" {
            rv_addi(e, d, s, 0);
            return "";
        }
        if m == "neg" {
            rv_sub(e, d, 0, s);
            return "";
        }
        if m == "not" {
            rv_xori(e, d, s, 0 - 1);
            return "";
        }
        return "unknown instruction";
    }
    if n != 3 {
        return "wrong number of operands";
    }
    var a: i64 = nat_asm_reg(NAT_RV64, p.get(2));
    if a < 0 {
        return "unknown register " + p.get(2);
    }
    if m == "addi" || m == "andi" || m == "ori" || m == "xori" || m == "slli" || m == "srli" || m == "srai" {
        var im: NatAsmImm = nat_asm_imm(p.get(3));
        if !im.ok {
            return "needs an immediate";
        }
        if m == "slli" || m == "srli" || m == "srai" {
            if im.v < 0 || im.v > 63 {
                return "shift out of range";
            }
            if m == "slli" {
                rv_slli(e, d, a, im.v);
            } else if m == "srli" {
                rv_srli(e, d, a, im.v);
            } else {
                rv_srai(e, d, a, im.v);
            }
            return "";
        }
        if !rv_fits12(im.v) {
            return "immediate out of range (12 bits)";
        }
        if m == "addi" {
            rv_addi(e, d, a, im.v);
        } else if m == "andi" {
            rv_andi(e, d, a, im.v);
        } else if m == "ori" {
            rv_i(e, im.v, a, 6, d, 0x13);
        } else {
            rv_xori(e, d, a, im.v);
        }
        return "";
    }
    var b: i64 = nat_asm_reg(NAT_RV64, p.get(3));
    if b < 0 {
        return "unknown register " + p.get(3);
    }
    if m == "add" {
        rv_add(e, d, a, b);
    } else if m == "sub" {
        rv_sub(e, d, a, b);
    } else if m == "and" {
        rv_and(e, d, a, b);
    } else if m == "or" {
        rv_or(e, d, a, b);
    } else if m == "xor" {
        rv_xor(e, d, a, b);
    } else if m == "sll" {
        rv_sll(e, d, a, b);
    } else if m == "srl" {
        rv_srl(e, d, a, b);
    } else if m == "sra" {
        rv_sra(e, d, a, b);
    } else if m == "slt" {
        rv_slt(e, d, a, b);
    } else if m == "sltu" {
        rv_sltu(e, d, a, b);
    } else if m == "mul" {
        rv_mul(e, d, a, b);
    } else if m == "mulh" {
        rv_mulh(e, d, a, b);
    } else if m == "mulhu" {
        rv_mulhu(e, d, a, b);
    } else if m == "div" {
        rv_div(e, d, a, b);
    } else if m == "divu" {
        rv_divu(e, d, a, b);
    } else if m == "rem" {
        rv_rem(e, d, a, b);
    } else if m == "remu" {
        rv_remu(e, d, a, b);
    } else {
        return "unknown instruction";
    }
    return "";
}

/// An output register that is not an input starts at 0 (pe_ir's rule, so
/// `asm!("nop", out("rax") x)` gives 0 on every backend).
fn nat_asm_out_zero(arch: i64, e: & mut NatEnc, ins: Vec<i64>, out: i64) {
    if out < 0 {
        return;
    }
    var i: i64 = 0;
    while i < ins.len() {
        if ins.get(i) == out {
            return;
        }
        i = i + 1;
    }
    if arch == NAT_X64 {
        x64_li(e, out, 0);
    } else if arch == NAT_A64 {
        a64_li(e, out, 0);
    } else {
        rv_addi(e, out, 0, 0);
    }
}

/// The thunk of one asm! site (see above): `tpl` the template's bytes,
/// `ins` the register of each input (input i arrives in argument register
/// i: x86-64 rdi, rsi, rdx, rcx; AArch64 x0..x7; RISC-V a0..a7), `out`
/// the output register (-1: none, the result is 0).
pub fn nat_asm_thunk(arch: i64, tpl: Vec<i64>, ins: Vec<i64>, out: i64) -> Vec<i64> {
    var e: NatEnc = NatEnc_new();
    var i: i64 = 0;
    if arch == NAT_X64 {
        var saved: Vec<i64> = Vec::new();
        saved.push(3);
        saved.push(5);
        saved.push(12);
        saved.push(13);
        saved.push(14);
        saved.push(15);
        i = 0;
        while i < saved.len() {
            x64_push(& mut e, saved.get(i));
            i = i + 1;
        }
        // the inputs: every argument register onto the stack, then each
        // off it into its register (any permutation of registers works)
        var args: Vec<i64> = Vec::new();
        args.push(7);
        args.push(6);
        args.push(2);
        args.push(1);
        i = 0;
        while i < ins.len() && i < args.len() {
            x64_push(& mut e, args.get(i));
            i = i + 1;
        }
        i = ins.len() - 1;
        if i >= args.len() {
            i = args.len() - 1;
        }
        while i >= 0 {
            x64_pop(& mut e, ins.get(i));
            i = i - 1;
        }
        nat_asm_out_zero(arch, & mut e, ins, out);
        i = 0;
        while i < tpl.len() {
            NatEnc_byte(& mut e, tpl.get(i));
            i = i + 1;
        }
        if out >= 0 {
            if out != 7 {
                x64_mov(& mut e, 7, out);
            }
        } else {
            x64_li(& mut e, 7, 0);
        }
        i = saved.len() - 1;
        while i >= 0 {
            x64_pop(& mut e, saved.get(i));
            i = i - 1;
        }
        x64_ret(& mut e);
        return e.code;
    }
    if arch == NAT_A64 {
        // x19..x30 at sp+0..88, the inputs at sp+96..
        a64_sub_imm(& mut e, A64_SP, A64_SP, 160);
        var r: i64 = 19;
        while r < 31 {
            a64_stp(& mut e, r, r + 1, A64_SP, (r - 19) * 8);
            r = r + 2;
        }
        i = 0;
        while i < ins.len() && i < 8 {
            a64_str(& mut e, i, A64_SP, 96 + i * 8);
            i = i + 1;
        }
        i = 0;
        while i < ins.len() && i < 8 {
            a64_ldr(& mut e, ins.get(i), A64_SP, 96 + i * 8);
            i = i + 1;
        }
        nat_asm_out_zero(arch, & mut e, ins, out);
        i = 0;
        while i < tpl.len() {
            NatEnc_byte(& mut e, tpl.get(i));
            i = i + 1;
        }
        if out >= 0 {
            if out != 0 {
                a64_mov(& mut e, 0, out);
            }
        } else {
            a64_li(& mut e, 0, 0);
        }
        r = 19;
        while r < 31 {
            a64_ldp(& mut e, r, r + 1, A64_SP, (r - 19) * 8);
            r = r + 2;
        }
        a64_add_imm(& mut e, A64_SP, A64_SP, 160);
        a64_ret(& mut e);
        return e.code;
    }
    // RISC-V: ra, gp, tp, s0..s11 at sp+0..112, the inputs at sp+120..
    var keep: Vec<i64> = Vec::new();
    keep.push(1);
    keep.push(3);
    keep.push(4);
    keep.push(8);
    keep.push(9);
    var s2: i64 = 18;
    while s2 <= 27 {
        keep.push(s2);
        s2 = s2 + 1;
    }
    rv_addi(& mut e, RV_SP, RV_SP, 0 - 192);
    i = 0;
    while i < keep.len() {
        rv_store(& mut e, keep.get(i), RV_SP, i * 8, 8);
        i = i + 1;
    }
    i = 0;
    while i < ins.len() && i < 8 {
        rv_store(& mut e, RV_A0 + i, RV_SP, 120 + i * 8, 8);
        i = i + 1;
    }
    i = 0;
    while i < ins.len() && i < 8 {
        rv_load(& mut e, ins.get(i), RV_SP, 120 + i * 8, 8, true);
        i = i + 1;
    }
    nat_asm_out_zero(arch, & mut e, ins, out);
    i = 0;
    while i < tpl.len() {
        NatEnc_byte(& mut e, tpl.get(i));
        i = i + 1;
    }
    if out >= 0 {
        if out != RV_A0 {
            rv_addi(& mut e, RV_A0, out, 0);
        }
    } else {
        rv_addi(& mut e, RV_A0, 0, 0);
    }
    i = 0;
    while i < keep.len() {
        rv_load(& mut e, keep.get(i), RV_SP, i * 8, 8, true);
        i = i + 1;
    }
    rv_addi(& mut e, RV_SP, RV_SP, 192);
    rv_ret(& mut e);
    return e.code;
}

// ===========================================================================
// RL6: translation validation of instruction selection. nat_ir.fd's
// `nat_sel_check` (run under FID_VERIFY=1) selects each integer MIR
// operation alone, with physical registers, through the emitter's own path
// (ng_mi_dispatch, as the replay after allocation calls it), and hands the
// bytes to nat_sel_eval_case: a small evaluator of the instructions those
// selections use runs them on edge and pseudo-random values, and the
// destination must hold the operation's meaning (nat_sel_ref), with the
// other input registers unchanged. An instruction the evaluator does not
// know is an error, so a new selection cannot pass unchecked. Covered:
// LI, MOV, ADD..SHR, NEG, NOT, DIV, REM, MULH (signed and unsigned),
// SETCC (every condition, also against the zero register), EXT (every
// kind), ASR63, ADDSHL, ADDI and SHI (TG1: add and shift by a constant).
// Floats, memory, branches and calls run through the same evaluator, with
// float registers, a memory model and jumps (nat_ir.fd nat_sel_check_more
// and nat_sel_eval_float / _mem / _branch / _call below; nat_ir.fd
// nat_isel_mem_check also compares their table rules with the
// hand-written selection byte for byte). TG2: nat_ir.fd
// nat_isel_rule_check runs each rule of the selection table alone on
// random operands through this evaluator.
// ===========================================================================

// The MIR operation codes nat_sel_ref knows: nat_ir.fd's MO_* (a code that
// drifts from them makes the check fail, never pass).
const NSEL_LI: i64 = 1; const NSEL_MOV: i64 = 2; const NSEL_ADD: i64 = 16; const NSEL_SUB: i64 = 17; const NSEL_MUL: i64 = 18; const NSEL_AND: i64 = 19; const NSEL_OR: i64 = 20; const NSEL_XOR: i64 = 21; const NSEL_SHL: i64 = 22; const NSEL_SAR: i64 = 23; const NSEL_SHR: i64 = 24; const NSEL_NEG: i64 = 25; const NSEL_NOT: i64 = 26; const NSEL_DIV: i64 = 27; const NSEL_REM: i64 = 28; const NSEL_MULH: i64 = 29; const NSEL_SETCC: i64 = 30; const NSEL_EXT: i64 = 31; const NSEL_ASR63: i64 = 42; const NSEL_ADDSHL: i64 = 46;
// TG1: MO_ADDI (r0 = r1 + i0) and MO_SHI (r0 = r1 shifted by i0, kind
// i1: 0 shl, 1 sar, 2 shr). A case's one immediate holds a SHI's count
// and kind as count | (kind << 6) (nat_ir.fd ng_sel_case_mi splits it).
const NSEL_ADDI: i64 = 52; const NSEL_SHI: i64 = 56;

@wrapping fn nsel_min() -> i64 {
    return 1 << 63;
}

/// a < b as unsigned 64-bit numbers
@wrapping fn nsel_ult(a: i64, b: i64) -> bool {
    return (a ^ nsel_min()) < (b ^ nsel_min());
}

/// a >> n, logical (n taken mod 64)
@wrapping fn nsel_shr(a: i64, n: i64) -> i64 {
    var s: i64 = n & 63;
    if s == 0 {
        return a;
    }
    return (a >> s) & ((1 << (64 - s)) - 1);
}

/// The low `bits` bits of v, sign-extended
@wrapping fn nsel_sext(v: i64, bits: i64) -> i64 {
    var s: i64 = 64 - bits;
    return (v << s) >> s;
}

/// The high 64 bits of the unsigned product a * b
@wrapping fn nsel_mulhu(a: i64, b: i64) -> i64 {
    var a0: i64 = a & 0xFFFFFFFF;
    var a1: i64 = nsel_shr(a, 32);
    var b0: i64 = b & 0xFFFFFFFF;
    var b1: i64 = nsel_shr(b, 32);
    var p00: i64 = a0 * b0;
    var p01: i64 = a0 * b1;
    var p10: i64 = a1 * b0;
    var p11: i64 = a1 * b1;
    var mid: i64 = nsel_shr(p00, 32) + (p01 & 0xFFFFFFFF) + (p10 & 0xFFFFFFFF);
    return p11 + nsel_shr(p01, 32) + nsel_shr(p10, 32) + nsel_shr(mid, 32);
}

/// The high 64 bits of the signed product a * b
@wrapping fn nsel_mulhs(a: i64, b: i64) -> i64 {
    var h: i64 = nsel_mulhu(a, b);
    if a < 0 {
        h = h - b;
    }
    if b < 0 {
        h = h - a;
    }
    return h;
}

/// a / b as unsigned numbers (b != 0)
@wrapping fn nsel_udiv(a: i64, b: i64) -> i64 {
    if b < 0 {
        if nsel_ult(a, b) {
            return 0;
        }
        return 1;
    }
    if a >= 0 {
        return a / b;
    }
    var q: i64 = (nsel_shr(a, 1) / b) << 1;
    var r: i64 = a - q * b;
    if !nsel_ult(r, b) {
        q = q + 1;
    }
    return q;
}

@wrapping fn nsel_urem(a: i64, b: i64) -> i64 {
    return a - nsel_udiv(a, b) * b;
}

/// What MIR operation `op` (with its immediate `imm`) gives for inputs a, b.
@wrapping pub fn nat_sel_ref(op: i64, imm: i64, a: i64, b: i64) -> i64 {
    if op == NSEL_LI {
        return imm;
    }
    if op == NSEL_MOV {
        return a;
    }
    if op == NSEL_ADD {
        return a + b;
    }
    if op == NSEL_SUB {
        return a - b;
    }
    if op == NSEL_MUL {
        return a * b;
    }
    if op == NSEL_AND {
        return a & b;
    }
    if op == NSEL_OR {
        return a | b;
    }
    if op == NSEL_XOR {
        return a ^ b;
    }
    if op == NSEL_SHL {
        return a << (b & 63);
    }
    if op == NSEL_SAR {
        return a >> (b & 63);
    }
    if op == NSEL_SHR {
        return nsel_shr(a, b);
    }
    if op == NSEL_NEG {
        return 0 - a;
    }
    if op == NSEL_NOT {
        return ~a;
    }
    if op == NSEL_DIV {
        if imm != 0 {
            return nsel_udiv(a, b);
        }
        return a / b;
    }
    if op == NSEL_REM {
        if imm != 0 {
            return nsel_urem(a, b);
        }
        return a % b;
    }
    if op == NSEL_MULH {
        if imm != 0 {
            return nsel_mulhu(a, b);
        }
        return nsel_mulhs(a, b);
    }
    if op == NSEL_SETCC {
        var t: bool = false;
        if imm == 0 {
            t = a == b;
        } else if imm == 1 {
            t = a != b;
        } else if imm == 2 {
            t = a < b;
        } else if imm == 3 {
            t = a <= b;
        } else if imm == 4 {
            t = a > b;
        } else if imm == 5 {
            t = a >= b;
        } else if imm == 6 {
            t = nsel_ult(a, b);
        } else if imm == 7 {
            t = !nsel_ult(b, a);
        } else if imm == 8 {
            t = nsel_ult(b, a);
        } else {
            t = !nsel_ult(a, b);
        }
        if t {
            return 1;
        }
        return 0;
    }
    if op == NSEL_EXT {
        if imm == 1 {
            return nsel_sext(a, 8);
        }
        if imm == 2 {
            return nsel_sext(a, 16);
        }
        if imm == 3 {
            return nsel_sext(a, 32);
        }
        if imm == 4 {
            return a & 0xFF;
        }
        if imm == 5 {
            return a & 0xFFFF;
        }
        return a & 0xFFFFFFFF;
    }
    if op == NSEL_ASR63 {
        return a >> 63;
    }
    if op == NSEL_ADDSHL {
        return a + (b << (imm & 63));
    }
    if op == NSEL_ADDI {
        return a + imm;
    }
    if op == NSEL_SHI {
        var sk: i64 = (imm >> 6) & 3;
        var sc: i64 = imm & 63;
        if sk == 0 {
            return a << sc;
        }
        if sk == 1 {
            return a >> sc;
        }
        return nsel_shr(a, sc);
    }
    return 0;
}

/// Inputs an operation is not defined on: division by zero, and MIN / -1
/// signed (the lowering checks both before a MO_DIV / MO_REM).
fn nsel_skip(op: i64, imm: i64, a: i64, b: i64) -> bool {
    if op == NSEL_DIV || op == NSEL_REM {
        if b == 0 {
            return true;
        }
        return imm == 0 && a == nsel_min() && b == 0 - 1;
    }
    return false;
}

fn nsel_name(op: i64, imm: i64) -> str {
    var names: Vec<str> = str_split("?,LI,MOV,?,?,?,?,?,?,?,?,?,?,?,?,?,ADD,SUB,MUL,AND,OR,XOR,SHL,SAR,SHR,NEG,NOT,DIV,REM,MULH,SETCC,EXT", ",");
    var nm: str = "op " + int_to_str(op);
    if op >= 0 && op < names.len() {
        nm = "MO_" + names.get(op);
    }
    if op == NSEL_ASR63 {
        nm = "MO_ASR63";
    }
    if op == NSEL_ADDSHL {
        nm = "MO_ADDSHL";
    }
    if op == NSEL_ADDI {
        nm = "MO_ADDI";
    }
    if op == NSEL_SHI {
        nm = "MO_SHI";
    }
    return nm + " (" + int_to_str(imm) + ")";
}

/// Edge values first (their pairs are all tried), then pseudo-random ones
/// (tried in neighbouring pairs).
@wrapping fn nsel_values() -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(0);
    v.push(1);
    v.push(0 - 1);
    v.push(2);
    v.push(63);
    v.push(64);
    v.push(65);
    v.push(0x80);
    v.push(0x8000);
    v.push(0x7FFFFFFF);
    v.push(0x80000000);
    v.push(0xFFFFFFFF);
    v.push(nsel_min());
    v.push(nsel_min() - 1);
    v.push(nsel_min() + 1);
    v.push(0 - 128);
    v.push(255);
    v.push(0x100000000);
    var x: i64 = 0x1E3779B97F4A7C15;
    var i: i64 = 0;
    while i < 48 {
        x = x ^ (x << 13);
        x = x ^ nsel_shr(x, 7);
        x = x ^ (x << 17);
        if i % 3 == 0 {
            v.push(x & 0xFFFF);
        } else {
            v.push(x);
        }
        i = i + 1;
    }
    return v;
}

/// The cases nat_sel_check selects: [op, d, a, b, imm] each; b = -2 means
/// the target's zero register (x86-64's 60, RISC-V's x0; nat_ir passes it).
pub fn nat_sel_cases(arch: i64) -> Vec<i64> {
    var c: Vec<i64> = Vec::new();
    var d: i64 = 3;
    var a: i64 = 12;
    var b: i64 = 13;
    if arch == NAT_A64 {
        d = 19;
        a = 20;
        b = 21;
    }
    if arch == NAT_RV64 {
        d = 18;
        a = 19;
        b = 20;
    }
    var lis: Vec<i64> = nsel_values();
    var li: i64 = 0;
    while li < lis.len() {
        nsel_case(& mut c, NSEL_LI, d, a, b, lis.get(li));
        li = li + 1;
    }
    nsel_case(& mut c, NSEL_MOV, d, a, b, 0);
    var op: i64 = NSEL_ADD;
    while op <= NSEL_SHR {
        nsel_case(& mut c, op, d, a, b, 0);
        nsel_case(& mut c, op, a, a, b, 0);
        nsel_case(& mut c, op, b, a, b, 0);
        nsel_case(& mut c, op, a, a, a, 0);
        op = op + 1;
    }
    nsel_case(& mut c, NSEL_NEG, d, a, b, 0);
    nsel_case(& mut c, NSEL_NEG, a, a, b, 0);
    nsel_case(& mut c, NSEL_NOT, d, a, b, 0);
    nsel_case(& mut c, NSEL_NOT, a, a, b, 0);
    nsel_case(& mut c, NSEL_ASR63, d, a, b, 0);
    nsel_case(& mut c, NSEL_ASR63, a, a, b, 0);
    var u: i64 = 0;
    while u < 2 {
        nsel_case(& mut c, NSEL_DIV, d, a, b, u);
        nsel_case(& mut c, NSEL_REM, d, a, b, u);
        nsel_case(& mut c, NSEL_MULH, d, a, b, u);
        u = u + 1;
    }
    var cc: i64 = 0;
    while cc < 10 {
        nsel_case(& mut c, NSEL_SETCC, d, a, b, cc);
        nsel_case(& mut c, NSEL_SETCC, a, a, b, cc);
        nsel_case(& mut c, NSEL_SETCC, b, a, b, cc);
        if arch != NAT_A64 {
            nsel_case(& mut c, NSEL_SETCC, d, a, 0 - 2, cc);
        }
        cc = cc + 1;
    }
    var k: i64 = 1;
    while k <= 6 {
        nsel_case(& mut c, NSEL_EXT, d, a, b, k);
        nsel_case(& mut c, NSEL_EXT, a, a, b, k);
        k = k + 1;
    }
    var sh: i64 = 0;
    while sh <= 4 {
        nsel_case(& mut c, NSEL_ADDSHL, d, a, b, sh);
        nsel_case(& mut c, NSEL_ADDSHL, a, a, b, sh);
        sh = sh + 1;
    }
    // TG1: adds of a constant the target's add takes as an immediate
    // (nat_ir.fd ng_addi_fits), in place and into another register
    var adds: Vec<i64> = nsel_addi_imms(arch);
    var ai: i64 = 0;
    while ai < adds.len() {
        nsel_case(& mut c, NSEL_ADDI, d, a, b, adds.get(ai));
        nsel_case(& mut c, NSEL_ADDI, a, a, b, adds.get(ai));
        ai = ai + 1;
    }
    // TG1: shifts by a constant, every kind
    var counts: Vec<i64> = Vec::new();
    counts.push(0);
    counts.push(1);
    counts.push(7);
    counts.push(31);
    counts.push(32);
    counts.push(63);
    var kind: i64 = 0;
    while kind < 3 {
        var ci: i64 = 0;
        while ci < counts.len() {
            nsel_case(& mut c, NSEL_SHI, d, a, b, counts.get(ci) | (kind << 6));
            nsel_case(& mut c, NSEL_SHI, a, a, b, counts.get(ci) | (kind << 6));
            ci = ci + 1;
        }
        kind = kind + 1;
    }
    return c;
}

/// TG1: constants an MO_ADDI of `arch` may hold (nat_ir.fd ng_addi_fits:
/// x86-64 a signed 32-bit immediate, AArch64 -4095..4095, RISC-V
/// -2048..2047).
pub fn nsel_addi_imms(arch: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(0);
    v.push(1);
    v.push(0 - 1);
    v.push(7);
    v.push(0 - 300);
    v.push(127);
    v.push(128);
    v.push(0 - 128);
    v.push(0 - 129);
    v.push(2047);
    v.push(0 - 2048);
    if arch != NAT_RV64 {
        v.push(4095);
        v.push(0 - 4095);
    }
    if arch == NAT_X64 {
        v.push(100000);
        v.push(2147483647);
        v.push(0 - 2147483647);
    }
    return v;
}

fn nsel_case(c: & mut Vec<i64>, op: i64, d: i64, a: i64, b: i64, imm: i64) {
    c.push(op);
    c.push(d);
    c.push(a);
    c.push(b);
    c.push(imm);
}

/// Run the selected bytes `code` of one case on every value pair; "" or
/// what went wrong. `zr` is the target's zero register (b == zr reads 0).
@wrapping pub fn nat_sel_eval_case(arch: i64, code: Vec<i64>, op: i64, d: i64, a: i64, b: i64, imm: i64, zr: i64) -> str {
    var vals: Vec<i64> = nsel_values();
    var pa: Vec<i64> = Vec::new();
    var pb: Vec<i64> = Vec::new();
    var ne: i64 = 18;
    var i: i64 = 0;
    while i < ne {
        var j: i64 = 0;
        while j < ne {
            pa.push(vals.get(i));
            pb.push(vals.get(j));
            j = j + 1;
        }
        i = i + 1;
    }
    i = ne;
    while i + 1 < vals.len() {
        pa.push(vals.get(i));
        pb.push(vals.get(i + 1));
        pa.push(vals.get(i + 1));
        pb.push(vals.get(i));
        i = i + 1;
    }
    var k: i64 = 0;
    while k < pa.len() {
        var av: i64 = pa.get(k);
        var bv: i64 = pb.get(k);
        if a == b {
            bv = av;
        }
        if b == zr {
            bv = 0;
        }
        if !nsel_skip(op, imm, av, bv) {
            var regs: Vec<i64> = Vec::new();
            var r: i64 = 0;
            while r < 32 {
                regs.push(0x5A5A5A5A00000000 + r * 0x10101);
                r = r + 1;
            }
            regs.set(a, av);
            if b != zr {
                regs.set(b, bv);
            }
            var err: str = nsel_exec(arch, & code, & mut regs);
            if err != "" {
                return nsel_name(op, imm) + ": " + err;
            }
            var want: i64 = nat_sel_ref(op, imm, av, bv);
            var got: i64 = regs.get(d);
            if got != want {
                return nsel_name(op, imm) + ": got " + int_to_str(got) + ", want " + int_to_str(want) + nsel_ctx(d, a, b, av, bv);
            }
            if op != NSEL_LI && a != d && regs.get(a) != av {
                return nsel_name(op, imm) + ": changed its first input register" + nsel_ctx(d, a, b, av, bv);
            }
            if op != NSEL_LI && op != NSEL_MOV && b != d && b != a && b != zr && regs.get(b) != bv {
                return nsel_name(op, imm) + ": changed its second input register" + nsel_ctx(d, a, b, av, bv);
            }
        }
        k = k + 1;
        if op == NSEL_LI {
            k = pa.len();
        }
    }
    return "";
}

fn nsel_ctx(d: i64, a: i64, b: i64, av: i64, bv: i64) -> str {
    return " (registers d " + int_to_str(d) + ", a " + int_to_str(a) + ", b " + int_to_str(b) + "; inputs " + int_to_str(av) + ", " + int_to_str(bv) + ")";
}

/// An instruction the evaluator does not know.
fn nsel_bad(what: str, v: i64, at: i64) -> str {
    return "unknown " + what + " " + int_to_str(v) + " at byte " + int_to_str(at) + " (the evaluator covers what the integer selections emit)";
}

fn nsel_exec(arch: i64, code: & Vec<i64>, regs: & mut Vec<i64>) -> str {
    var m: NselM = NselM_new(code.len());
    return nsel_exec_m(arch, code, regs, & mut m);
}

/// RL6: run `code` from byte 0 with memory, branches and calls (NselM).
pub fn nsel_exec_m(arch: i64, code: & Vec<i64>, regs: & mut Vec<i64>, m: & mut NselM) -> str {
    while regs.len() < 64 {
        regs.push(0x3C3C3C3C00000000 + regs.len() * 0x10101);
    }
    if arch == NAT_X64 {
        return nsx_exec(code, regs, m);
    }
    if arch == NAT_A64 {
        return nsa_exec(code, regs, m);
    }
    return nsr_exec(code, regs, m);
}

fn nsel_at(code: & Vec<i64>, p: i64) -> i64 {
    if p < 0 || p >= code.len() {
        return 0 - 1;
    }
    return code.get(p);
}

@wrapping fn nsel_word(code: & Vec<i64>, p: i64) -> i64 {
    return code.get(p) | (code.get(p + 1) << 8) | (code.get(p + 2) << 16) | (code.get(p + 3) << 24);
}

// --- RL6: the rest of the machine state ------------------------------------
// The registers of an evaluation are 64 words: the general registers 0..31
// and the float registers at 32 + f (nat_ir.fd's NG_FREG numbering: xmm f,
// d/s f, f f; the low 64 bits, an f32 in the low 32: x86-64 keeps the
// rest of the register as it was, AArch64 clears it, RISC-V NaN-boxes it).
// Memory is a byte map: a byte nothing wrote holds nsel_mem_init of its
// address, and the writes are kept in order (the checks look at every
// byte written). A run starts at byte 0 and ends at the first position at
// or past `stop` (the end of the code, or where a branch's fall-through
// and target were placed), or at a call: its position, target and the
// registers then are kept, the callee is not run.

pub struct NselM {
    pub wa: Vec<i64>,
    pub wv: Vec<i64>,
    pub stop: i64,
    pub pc: i64,
    pub call_at: i64,
    pub call_to: i64,
    pub call_regs: Vec<i64>,
    // scratch of the decoders: the next position, an effective address,
    // the flags an SSE compare set (bit 0 ZF, 1 PF, 2 CF; -1 none)
    pub np: i64,
    pub ea: i64,
    pub fl: i64,
    // what a byte nothing wrote holds: -1 nsel_mem_init of its address,
    // else this byte (0x80, 0xFF: every sign bit set)
    pub fill: i64,
}

pub fn NselM_new(stop: i64) -> NselM {
    return NselM {
        wa: Vec::new(), wv: Vec::new(), stop: stop, pc: 0 - 1, call_at: 0 - 1, call_to: 0 - 1, call_regs: Vec::new(), np: 0, ea: 0, fl: 0 - 1, fill: 0 - 1
    };
}

/// The byte at `addr` before anything wrote it.
@wrapping pub fn nsel_mem_init(addr: i64) -> i64 {
    var x: i64 = addr * 0x1E3779B97F4A7C15;
    x = x ^ nsel_shr(x, 29);
    return nsel_shr(x, 17) & 0xFF;
}

fn nsel_mem_byte(m: & NselM, addr: i64) -> i64 {
    var i: i64 = m.wa.len() - 1;
    while i >= 0 {
        if m.wa.get(i) == addr {
            return m.wv.get(i);
        }
        i = i - 1;
    }
    if m.fill >= 0 {
        return m.fill;
    }
    return nsel_mem_init(addr);
}

/// `size` bytes at addr, little-endian, not extended
@wrapping pub fn nsel_mem_rd(m: & NselM, addr: i64, size: i64) -> i64 {
    var v: i64 = 0;
    var k: i64 = size - 1;
    while k >= 0 {
        v = (v << 8) | nsel_mem_byte(m, addr + k);
        k = k - 1;
    }
    return v;
}

@wrapping fn nsel_mem_wr(m: & mut NselM, addr: i64, size: i64, v: i64) {
    var k: i64 = 0;
    while k < size {
        m.wa.push(addr + k);
        m.wv.push(nsel_shr(v, 8 * k) & 0xFF);
        k = k + 1;
    }
}

/// The low `size` bytes of v extended to 64 bits
@wrapping pub fn nsel_ext_sz(v: i64, size: i64, signed: bool) -> i64 {
    if size >= 8 {
        return v;
    }
    if signed {
        return nsel_sext(v, size * 8);
    }
    return v & ((1 << (size * 8)) - 1);
}

/// The run stops at a call: where, its target, the registers then.
fn nsel_call(m: & mut NselM, regs: & Vec<i64>, at: i64, to: i64) {
    m.call_at = at;
    m.call_to = to;
    var i: i64 = 0;
    while i < regs.len() {
        m.call_regs.push(regs.get(i));
        i = i + 1;
    }
}

// --- RL6: IEEE values on bit patterns ---------------------------------------
// The arithmetic is the host's f64 (one rounding); an f32 operation is the
// f64 one on the widened operands rounded once to single, which is the
// single-precision result for + - * / (and what every selection of them
// computes). Compares and the f32 widening are done on the bits, so they
// do not depend on how the compiler running this compares floats.

@wrapping pub fn nsf_isnan(b: i64) -> bool {
    return ((b >> 52) & 0x7FF) == 0x7FF && (b & 0xFFFFFFFFFFFFF) != 0;
}

pub fn nsf_isnan32(w: i64) -> bool {
    return ((w >> 23) & 0xFF) == 0xFF && (w & 0x7FFFFF) != 0;
}

/// The f64 bits of the f32 whose pattern is the low 32 bits of w (exact).
@wrapping pub fn nsf_widen(w0: i64) -> i64 {
    var w: i64 = w0 & 0xFFFFFFFF;
    var sign: i64 = ((w >> 31) & 1) << 63;
    var e: i64 = (w >> 23) & 0xFF;
    var m: i64 = w & 0x7FFFFF;
    if e == 0xFF {
        if m == 0 {
            return sign | 0x7FF0000000000000;
        }
        return sign | 0x7FF8000000000000 | (m << 29);
    }
    if e == 0 {
        if m == 0 {
            return sign;
        }
        var ee: i64 = 897;
        while (m & 0x800000) == 0 {
            m = m << 1;
            ee = ee - 1;
        }
        return sign | (ee << 52) | ((m & 0x7FFFFF) << 29);
    }
    return sign | ((e - 127 + 1023) << 52) | (m << 29);
}

/// The f32 pattern (zero-extended) of the f64 bits b rounded to single.
@wrapping pub fn nsf_narrow(b: i64) -> i64 {
    if nsf_isnan(b) {
        return 0x7FC00000 | (nsel_shr(b, 32) & 0x80000000);
    }
    return p_f32_to_bits(p_f64_from_bits(b)) & 0xFFFFFFFF;
}

/// a op b (1 add, 2 sub, 3 mul, 4 div) on f64 bits, or on f32 patterns
/// (is32: the result an f32 pattern too)
@wrapping pub fn nsf_op(op: i64, a: i64, b: i64, is32: bool) -> i64 {
    var ab: i64 = a;
    var bb: i64 = b;
    if is32 {
        ab = nsf_widen(a);
        bb = nsf_widen(b);
    }
    var x: f64 = p_f64_from_bits(ab);
    var y: f64 = p_f64_from_bits(bb);
    var r: f64 = x + y;
    if op == 2 {
        r = x - y;
    }
    if op == 3 {
        r = x * y;
    }
    if op == 4 {
        r = x / y;
    }
    var rb: i64 = p_f64_to_bits(r);
    if is32 {
        return nsf_narrow(rb);
    }
    return rb;
}

/// An order on f64 bits: 2 unordered (a NaN), -1 a < b, 0 equal (+0 and
/// -0 too), 1 a > b.
@wrapping pub fn nsf_cmp(a: i64, b: i64) -> i64 {
    if nsf_isnan(a) || nsf_isnan(b) {
        return 2;
    }
    var ma: i64 = a & 0x7FFFFFFFFFFFFFFF;
    var mb: i64 = b & 0x7FFFFFFFFFFFFFFF;
    if ma == 0 && mb == 0 {
        return 0;
    }
    // sign-magnitude to a signed order
    var ka: i64 = ma;
    if a < 0 {
        ka = 0 - ma;
    }
    var kb: i64 = mb;
    if b < 0 {
        kb = 0 - mb;
    }
    if ka < kb {
        return 0 - 1;
    }
    if ka > kb {
        return 1;
    }
    return 0;
}

/// Is the f64 (bits b) truncated toward zero an i64? (No NaN, |x| < 2^63
/// or exactly -2^63.)
@wrapping pub fn nsf_f2i_ok(b: i64) -> bool {
    if nsf_isnan(b) {
        return false;
    }
    var e: i64 = (b >> 52) & 0x7FF;
    if e < 1023 + 63 {
        return true;
    }
    return b == (0 - 4332462841530417152);
}

/// The f64 (bits b) truncated toward zero; out of range: `bad`.
@wrapping pub fn nsf_f2i(b: i64, bad: i64) -> i64 {
    if !nsf_f2i_ok(b) {
        return bad;
    }
    var x: f64 = p_f64_from_bits(b);
    return x as i64;
}

/// The f64 bits of integer v (rounded to nearest, ties to even).
@wrapping pub fn nsf_i2f(v: i64) -> i64 {
    var x: f64 = v as f64;
    return p_f64_to_bits(x);
}

/// RISC-V: the f32 in a float register's 64 bits: its low 32 when
/// NaN-boxed (the upper 32 all ones), else the canonical NaN.
@wrapping fn nsf_rv_unbox(v: i64) -> i64 {
    if nsel_shr(v, 32) == 0xFFFFFFFF {
        return v & 0xFFFFFFFF;
    }
    return 0x7FC00000;
}

@wrapping fn nsf_rv_box(w: i64) -> i64 {
    return (w & 0xFFFFFFFF) | (0 - 4294967296);
}

// --- x86-64 ----------------------------------------------------------------

/// x86-64 condition `cc` (the low nibble of SETcc) on the flags.
fn nsx_cond(cc: i64, zf: bool, sf: bool, cf: bool, of: bool) -> bool {
    if cc == 0 {
        return of;
    }
    if cc == 1 {
        return !of;
    }
    if cc == 2 {
        return cf;
    }
    if cc == 3 {
        return !cf;
    }
    if cc == 4 {
        return zf;
    }
    if cc == 5 {
        return !zf;
    }
    if cc == 6 {
        return cf || zf;
    }
    if cc == 7 {
        return !cf && !zf;
    }
    if cc == 8 {
        return sf;
    }
    if cc == 9 {
        return !sf;
    }
    if cc == 12 {
        return sf != of;
    }
    if cc == 13 {
        return sf == of;
    }
    if cc == 14 {
        return zf || sf != of;
    }
    return !zf && sf == of;
}

@wrapping fn nsx_exec(code: & Vec<i64>, regs: & mut Vec<i64>, st: & mut NselM) -> str {
    var zf: bool = false;
    var sf: bool = false;
    var cf: bool = false;
    var of: bool = false;
    // RL6: the parity flag, known only after a float compare (pf_ok)
    var pf: bool = false;
    var pf_ok: bool = false;
    var p: i64 = 0;
    var steps: i64 = 0;
    while p >= 0 && p < st.stop {
        steps = steps + 1;
        if steps > 4096 {
            return "x86-64 code runs past 4096 instructions";
        }
        var at: i64 = p;
        var rex: i64 = 0;
        var pfx: i64 = 0;
        var op: i64 = nsel_at(code, p);
        if op == 0x66 || op == 0xF2 || op == 0xF3 {
            pfx = op;
            p = p + 1;
            op = nsel_at(code, p);
        }
        if op >= 0x40 && op <= 0x4F {
            rex = op;
            p = p + 1;
            op = nsel_at(code, p);
        }
        p = p + 1;
        var w: bool = (rex & 8) != 0;
        var xr: i64 = (rex >> 2) & 1;
        var xx: i64 = (rex >> 1) & 1;
        var xb: i64 = rex & 1;

        if op < 0 {
            return "x86-64 code ends inside an instruction";
        }
        // RL6: relative jumps and calls, SSE, TEST of the accumulator
        var two0: i64 = 0 - 1;
        if op == 0x0F {
            two0 = nsel_at(code, p);
        }
        if op == 0xE8 || op == 0xE9 || op == 0xEB || (op >= 0x70 && op <= 0x7F) || (two0 >= 0x80 && two0 <= 0x8F) {
            var rel: i64 = 0;
            if op == 0xEB || (op >= 0x70 && op <= 0x7F) {
                rel = nsel_sext(nsel_at(code, p), 8);
                p = p + 1;
            } else {
                if op == 0x0F {
                    p = p + 1;
                }
                if p + 3 >= code.len() {
                    return "x86-64 code ends inside a branch";
                }
                rel = nsel_sext(nsel_word(code, p), 32);
                p = p + 4;
            }
            var to: i64 = p + rel;
            if op == 0xE8 {
                nsel_call(st, regs, at, to);
                st.pc = at;
                return "";
            }
            var take: bool = true;
            if op != 0xE9 && op != 0xEB {
                var jcc: i64 = op & 15;
                if op == 0x0F {
                    jcc = two0 & 15;
                }
                if jcc == 10 || jcc == 11 {
                    if !pf_ok {
                        return "a branch on the parity flag after an integer operation (not evaluated) at byte " + int_to_str(at);
                    }
                    take = pf == (jcc == 10);
                } else {
                    take = nsx_cond(jcc, zf, sf, cf, of);
                }
            }
            if take {
                p = to;
            }
            continue;
        }
        if op == 0x0F && (pfx != 0 || two0 == 0x28 || two0 == 0x2E) {
            var serr: str = nsx_sse(code, p, at, pfx, rex, regs, st);
            if serr != "" {
                return serr;
            }
            p = st.np;
            if st.fl >= 0 {
                zf = (st.fl & 1) != 0;
                pf = (st.fl & 2) != 0;
                cf = (st.fl & 4) != 0;
                sf = false;
                of = false;
                pf_ok = true;
            }
            continue;
        }
        if pfx != 0 && !(pfx == 0x66 && op == 0x89) {
            return nsel_bad("x86-64 byte after a prefix", op, at);
        }
        if op == 0xA8 || op == 0xA9 {
            // TEST al, imm8 / eax, imm32 (TBNZ on rax)
            var tv: i64 = 0;
            var tr: i64 = 0;
            if op == 0xA8 {
                tv = nsel_at(code, p);
                p = p + 1;
                tr = regs.get(0) & tv & 0xFF;
                sf = (tr & 0x80) != 0;
            } else {
                tv = nsel_word(code, p);
                p = p + 4;
                tr = regs.get(0) & tv & 0xFFFFFFFF;
                sf = (tr & 0x80000000) != 0;
            }
            zf = tr == 0;
            cf = false;
            of = false;
            pf_ok = false;
            continue;
        }
        if op >= 0xB8 && op <= 0xBF {
            var rd: i64 = (op - 0xB8) | (xb << 3);
            var iv: i64 = 0;
            var nb: i64 = 4;
            if w {
                nb = 8;
            }
            var bi: i64 = nb - 1;
            while bi >= 0 {
                var bv8: i64 = nsel_at(code, p + bi);
                if bv8 < 0 {
                    return "x86-64 code ends inside an immediate";
                }
                iv = (iv << 8) | bv8;
                bi = bi - 1;
            }
            p = p + nb;
            regs.set(rd, iv);
        } else if op == 0x05 || op == 0x2D {
            // add / sub rax, simm32 (x64_add_imm / x64_sub_imm's rax form)
            if !w {
                return nsel_bad("x86-64 byte", op, at);
            }
            var ri: i64 = nsel_sext(nsel_at(code, p) | (nsel_at(code, p + 1) << 8) | (nsel_at(code, p + 2) << 16) | (nsel_at(code, p + 3) << 24), 32);
            p = p + 4;
            if op == 0x05 {
                regs.set(0, regs.get(0) + ri);
            } else {
                regs.set(0, regs.get(0) - ri);
            }
        } else if op == 0x99 {
            if !w {
                return nsel_bad("x86-64 byte", op, at);
            }
            regs.set(2, regs.get(0) >> 63);
        } else if op == 0xC4 {
            // VEX: SHLX / SARX / SHRX (BMI2)
            var v1: i64 = nsel_at(code, p);
            var v2: i64 = nsel_at(code, p + 1);
            var vop: i64 = nsel_at(code, p + 2);
            var vm: i64 = nsel_at(code, p + 3);
            p = p + 4;
            if vm < 0 || (v1 & 0x1F) != 2 || (v2 & 0x80) == 0 || vop != 0xF7 || (vm >> 6) != 3 {
                return nsel_bad("x86-64 byte", op, at);
            }
            var vreg: i64 = ((vm >> 3) & 7) | ((1 - ((v1 >> 7) & 1)) << 3);
            var vrm: i64 = (vm & 7) | ((1 - ((v1 >> 5) & 1)) << 3);
            var vv: i64 = (~(v2 >> 3)) & 15;
            var vcnt: i64 = regs.get(vv) & 63;
            var vpp: i64 = v2 & 3;
            if vpp == 1 {
                regs.set(vreg, regs.get(vrm) << vcnt);
            } else if vpp == 2 {
                regs.set(vreg, regs.get(vrm) >> vcnt);
            } else if vpp == 3 {
                regs.set(vreg, nsel_shr(regs.get(vrm), vcnt));
            } else {
                return nsel_bad("x86-64 byte", op, at);
            }
        } else {
            var two: i64 = 0 - 1;
            if op == 0x0F {
                two = nsel_at(code, p);
                p = p + 1;
            }
            var m: i64 = nsel_at(code, p);
            p = p + 1;
            if m < 0 {
                return "x86-64 code ends before a ModRM byte";
            }
            var md: i64 = m >> 6;
            var reg: i64 = ((m >> 3) & 7) | (xr << 3);
            var rm: i64 = (m & 7) | (xb << 3);
            if op == 0x8D {
                // lea reg, [base + index * scale + disp]
                if !w || md == 3 {
                    return nsel_bad("x86-64 byte", op, at);
                }
                var base: i64 = rm;
                var idx: i64 = 0 - 1;
                var scale: i64 = 0;
                if (m & 7) == 4 {
                    var sib: i64 = nsel_at(code, p);
                    p = p + 1;
                    scale = sib >> 6;
                    idx = ((sib >> 3) & 7) | (xx << 3);
                    if idx == 4 {
                        idx = 0 - 1;
                    }
                    base = (sib & 7) | (xb << 3);
                    if (sib & 7) == 5 && md == 0 {
                        return nsel_bad("x86-64 byte", op, at);
                    }
                } else if (m & 7) == 5 && md == 0 {
                    return nsel_bad("x86-64 byte", op, at);
                }
                var disp: i64 = 0;
                if md == 1 {
                    disp = nsel_sext(nsel_at(code, p), 8);
                    p = p + 1;
                } else if md == 2 {
                    disp = nsel_sext(nsel_at(code, p) | (nsel_at(code, p + 1) << 8) | (nsel_at(code, p + 2) << 16) | (nsel_at(code, p + 3) << 24), 32);
                    p = p + 4;
                }
                var addr: i64 = regs.get(base) + disp;
                if idx >= 0 {
                    addr = addr + (regs.get(idx) << scale);
                }
                regs.set(reg, addr);
            } else if md != 3 {
                // RL6: loads and stores (nsx_mem)
                var merr: str = nsx_mem(code, p, at, pfx, rex, op, two, m, regs, st);
                if merr != "" {
                    return merr;
                }
                p = st.np;
            } else if op == 0xFF {
                // RL6: call / jmp through a register
                var fext: i64 = (m >> 3) & 7;
                if fext == 2 {
                    nsel_call(st, regs, at, regs.get(rm));
                    st.pc = at;
                    return "";
                }
                if fext != 4 {
                    return nsel_bad("x86-64 byte", op, at);
                }
                p = regs.get(rm);
            } else if op == 0xF6 {
                // RL6: TEST r/m8, imm8 (TBNZ on bits 0..7)
                if ((m >> 3) & 7) != 0 {
                    return nsel_bad("x86-64 byte", op, at);
                }
                if rex == 0 && rm >= 4 && rm <= 7 {
                    return "byte register ah..bh (no REX)";
                }
                var t8: i64 = regs.get(rm) & nsel_at(code, p) & 0xFF;
                p = p + 1;
                zf = t8 == 0;
                sf = (t8 & 0x80) != 0;
                cf = false;
                of = false;
                pf_ok = false;
            } else if op == 0xF7 && ((m >> 3) & 7) == 0 && !w {
                // RL6: TEST r32, imm32 (TBNZ on bits 8..31)
                var t32: i64 = regs.get(rm) & nsel_word(code, p) & 0xFFFFFFFF;
                p = p + 4;
                zf = t32 == 0;
                sf = (t32 & 0x80000000) != 0;
                cf = false;
                of = false;
                pf_ok = false;
            } else if two == 0xBA {
                // RL6: BT r64, imm8 (TBNZ on bits 32..63): CF = the bit
                if ((m >> 3) & 7) != 4 || !w {
                    return nsel_bad("x86-64 byte", op, at);
                }
                cf = (nsel_shr(regs.get(rm), nsel_at(code, p) & 63) & 1) != 0;
                p = p + 1;
            } else if two >= 0 {
                if two == 0xAF {
                    if !w {
                        return nsel_bad("x86-64 byte", op, at);
                    }
                    regs.set(reg, regs.get(reg) * regs.get(rm));
                } else if two >= 0x90 && two <= 0x9F {
                    if rex == 0 && rm >= 4 && rm <= 7 {
                        return "SETcc of ah..bh (no REX)";
                    }
                    var cc: i64 = two - 0x90;
                    var bit: i64 = 0;
                    if cc == 10 || cc == 11 {
                        // RL6: SETP / SETNP, after a float compare only
                        if !pf_ok {
                            return "SETP / SETNP after an integer operation (not evaluated) at byte " + int_to_str(at);
                        }
                        if pf == (cc == 10) {
                            bit = 1;
                        }
                    } else if nsx_cond(cc, zf, sf, cf, of) {
                        bit = 1;
                    }
                    regs.set(rm, (regs.get(rm) & (~255)) | bit);
                } else if two == 0xB6 || two == 0xB7 || two == 0xBE || two == 0xBF {
                    if rex == 0 && (two == 0xB6 || two == 0xBE) && rm >= 4 && rm <= 7 {
                        return "byte register ah..bh (no REX)";
                    }
                    var src: i64 = regs.get(rm);
                    var res: i64 = 0;
                    if two == 0xB6 {
                        res = src & 0xFF;
                    } else if two == 0xB7 {
                        res = src & 0xFFFF;
                    } else if two == 0xBE {
                        res = nsel_sext(src, 8);
                    } else {
                        res = nsel_sext(src, 16);
                    }
                    if !w {
                        res = res & 0xFFFFFFFF;
                    }
                    regs.set(reg, res);
                } else {
                    return nsel_bad("x86-64 byte", op, at);
                }
            } else if op == 0x89 || op == 0x8B {
                var mfrom: i64 = reg;
                var mto: i64 = rm;
                if op == 0x8B {
                    mfrom = rm;
                    mto = reg;
                }
                if w {
                    regs.set(mto, regs.get(mfrom));
                } else {
                    regs.set(mto, regs.get(mfrom) & 0xFFFFFFFF);
                }
            } else if op == 0x01 || op == 0x09 || op == 0x21 || op == 0x29 || op == 0x31 || op == 0x39 || op == 0x85 {
                var x: i64 = regs.get(rm);
                var y: i64 = regs.get(reg);
                if !w && op != 0x31 {
                    return "32-bit x86-64 arithmetic (not evaluated) at byte " + int_to_str(at);
                }
                var res2: i64 = 0;
                if op == 0x01 {
                    res2 = x + y;
                } else if op == 0x09 {
                    res2 = x | y;
                } else if op == 0x21 || op == 0x85 {
                    res2 = x & y;
                } else if op == 0x31 {
                    res2 = x ^ y;
                } else {
                    res2 = x - y;
                }
                if !w {
                    res2 = res2 & 0xFFFFFFFF;
                }
                zf = res2 == 0;
                sf = res2 < 0;
                cf = false;
                of = false;
                pf_ok = false;
                if op == 0x29 || op == 0x39 {
                    cf = nsel_ult(x, y);
                    of = ((x ^ y) & (x ^ res2)) < 0;
                }
                if op == 0x01 {
                    cf = nsel_ult(res2, x);
                    of = ((~(x ^ y)) & (x ^ res2)) < 0;
                }
                if op != 0x39 && op != 0x85 {
                    regs.set(rm, res2);
                }
            } else if op == 0x63 {
                if !w {
                    return nsel_bad("x86-64 byte", op, at);
                }
                regs.set(reg, nsel_sext(regs.get(rm), 32));
            } else if op == 0xF7 {
                if !w {
                    return nsel_bad("x86-64 byte", op, at);
                }
                var ext: i64 = (m >> 3) & 7;
                var v: i64 = regs.get(rm);
                if ext == 2 {
                    regs.set(rm, ~v);
                } else if ext == 3 {
                    regs.set(rm, 0 - v);
                } else if ext == 4 {
                    var ra: i64 = regs.get(0);
                    regs.set(2, nsel_mulhu(ra, v));
                    regs.set(0, ra * v);
                } else if ext == 5 {
                    var ra2: i64 = regs.get(0);
                    regs.set(2, nsel_mulhs(ra2, v));
                    regs.set(0, ra2 * v);
                } else if ext == 6 {
                    if regs.get(2) != 0 || v == 0 {
                        return "div with rdx != 0 or a zero divisor";
                    }
                    var ua: i64 = regs.get(0);
                    regs.set(0, nsel_udiv(ua, v));
                    regs.set(2, nsel_urem(ua, v));
                } else if ext == 7 {
                    var sa: i64 = regs.get(0);
                    if regs.get(2) != (sa >> 63) || v == 0 || (sa == nsel_min() && v == 0 - 1) {
                        return "idiv without cqo, or a divisor that traps";
                    }
                    regs.set(0, sa / v);
                    regs.set(2, sa % v);
                } else {
                    return nsel_bad("x86-64 byte", op, at);
                }
            } else if op == 0xD3 || op == 0xC1 {
                if !w {
                    return nsel_bad("x86-64 byte", op, at);
                }
                var cnt: i64 = regs.get(1) & 63;
                if op == 0xC1 {
                    cnt = nsel_at(code, p) & 63;
                    p = p + 1;
                }
                var sext: i64 = (m >> 3) & 7;
                var sv: i64 = regs.get(rm);
                if sext == 4 {
                    regs.set(rm, sv << cnt);
                } else if sext == 5 {
                    regs.set(rm, nsel_shr(sv, cnt));
                } else if sext == 7 {
                    regs.set(rm, sv >> cnt);
                } else {
                    return nsel_bad("x86-64 byte", op, at);
                }
            } else if op == 0xC7 {
                var c7: i64 = nsel_at(code, p) | (nsel_at(code, p + 1) << 8) | (nsel_at(code, p + 2) << 16) | (nsel_at(code, p + 3) << 24);
                p = p + 4;
                if ((m >> 3) & 7) != 0 {
                    return nsel_bad("x86-64 byte", op, at);
                }
                if w {
                    regs.set(rm, nsel_sext(c7, 32));
                } else {
                    regs.set(rm, c7 & 0xFFFFFFFF);
                }
            } else if op == 0x83 || op == 0x81 {
                if !w {
                    return nsel_bad("x86-64 byte", op, at);
                }
                var ai: i64 = 0;
                if op == 0x83 {
                    ai = nsel_sext(nsel_at(code, p), 8);
                    p = p + 1;
                } else {
                    ai = nsel_sext(nsel_at(code, p) | (nsel_at(code, p + 1) << 8) | (nsel_at(code, p + 2) << 16) | (nsel_at(code, p + 3) << 24), 32);
                    p = p + 4;
                }
                var aext: i64 = (m >> 3) & 7;
                if aext == 0 {
                    regs.set(rm, regs.get(rm) + ai);
                } else if aext == 5 {
                    regs.set(rm, regs.get(rm) - ai);
                } else {
                    return nsel_bad("x86-64 byte", op, at);
                }
            } else {
                return nsel_bad("x86-64 byte", op, at);
            }
        }
    }
    st.pc = p;
    return "";
}

/// RL6: the x86-64 effective address of the ModRM byte mrm (and SIB,
/// displacement) at p: st.ea, st.np past it. No RIP-relative or base-less
/// forms (the selections never make them).
@wrapping fn nsx_ea(code: & Vec<i64>, p0: i64, at: i64, rex: i64, mrm: i64, regs: & Vec<i64>, st: & mut NselM) -> str {
    var p: i64 = p0;
    var md: i64 = mrm >> 6;
    var xx: i64 = (rex >> 1) & 1;
    var xb: i64 = rex & 1;
    var base: i64 = (mrm & 7) | (xb << 3);
    var idx: i64 = 0 - 1;
    var scale: i64 = 0;
    if md == 3 {
        return "x86-64: a register where a memory operand was expected at byte " + int_to_str(at);
    }
    if (mrm & 7) == 4 {
        var sib: i64 = nsel_at(code, p);
        p = p + 1;
        if sib < 0 {
            return "x86-64 code ends inside a SIB byte";
        }
        scale = sib >> 6;
        idx = ((sib >> 3) & 7) | (xx << 3);
        if idx == 4 {
            idx = 0 - 1;
        }
        base = (sib & 7) | (xb << 3);
        if (sib & 7) == 5 && md == 0 {
            return "x86-64: an address without a base (not evaluated) at byte " + int_to_str(at);
        }
    } else if (mrm & 7) == 5 && md == 0 {
        return "x86-64: a RIP-relative address (not evaluated) at byte " + int_to_str(at);
    }
    var disp: i64 = 0;
    if md == 1 {
        disp = nsel_sext(nsel_at(code, p), 8);
        p = p + 1;
    } else if md == 2 {
        disp = nsel_sext(nsel_word(code, p), 32);
        p = p + 4;
    }
    var addr: i64 = regs.get(base) + disp;
    if idx >= 0 {
        addr = addr + (regs.get(idx) << scale);
    }
    st.ea = addr;
    st.np = p;
    return "";
}

/// RL6: an x86-64 load or store (op, or 0F two; mrm its ModRM at p, past
/// the opcode): MOV r/m, MOVSXD, MOVZX / MOVSX, MOV m, imm32. st.np: the
/// next position.
@wrapping fn nsx_mem(code: & Vec<i64>, p: i64, at: i64, pfx: i64, rex: i64, op: i64, two: i64, mrm: i64, regs: & mut Vec<i64>, st: & mut NselM) -> str {
    var err: str = nsx_ea(code, p, at, rex, mrm, regs, st);
    if err != "" {
        return err;
    }
    var w: bool = (rex & 8) != 0;
    var reg: i64 = ((mrm >> 3) & 7) | (((rex >> 2) & 1) << 3);
    var ea: i64 = st.ea;
    if op == 0x8B && pfx == 0 {
        if w {
            regs.set(reg, nsel_mem_rd(st, ea, 8));
        } else {
            regs.set(reg, nsel_mem_rd(st, ea, 4));
        }
        return "";
    }
    if op == 0x63 && w {
        regs.set(reg, nsel_sext(nsel_mem_rd(st, ea, 4), 32));
        return "";
    }
    if op == 0x0F && (two == 0xB6 || two == 0xB7 || two == 0xBE || two == 0xBF) {
        var sz: i64 = 1;
        if two == 0xB7 || two == 0xBF {
            sz = 2;
        }
        var v: i64 = nsel_ext_sz(nsel_mem_rd(st, ea, sz), sz, two == 0xBE || two == 0xBF);
        if !w {
            v = v & 0xFFFFFFFF;
        }
        regs.set(reg, v);
        return "";
    }
    if op == 0x89 {
        var ssz: i64 = 4;
        if w {
            ssz = 8;
        }
        if pfx == 0x66 {
            if w {
                return nsel_bad("x86-64 byte", op, at);
            }
            ssz = 2;
        }
        nsel_mem_wr(st, ea, ssz, regs.get(reg));
        return "";
    }
    if op == 0x88 {
        if rex == 0 && reg >= 4 && reg <= 7 {
            return "a byte store of ah..bh (no REX)";
        }
        nsel_mem_wr(st, ea, 1, regs.get(reg));
        return "";
    }
    if op == 0xC7 && ((mrm >> 3) & 7) == 0 {
        var iv: i64 = nsel_sext(nsel_word(code, st.np), 32);
        st.np = st.np + 4;
        if w {
            nsel_mem_wr(st, ea, 8, iv);
        } else {
            nsel_mem_wr(st, ea, 4, iv);
        }
        return "";
    }
    return "x86-64 memory operand of byte " + int_to_str(op) + " (not evaluated) at byte " + int_to_str(at);
}

/// RL6: x86-64 SSE (0F op after prefix pfx: 66, F2, F3, or none for
/// movaps / ucomiss), p at the opcode byte after 0F. Registers 32 + n are
/// xmm n's low 64 bits. st.fl: the flags of a compare (else -1).
@wrapping fn nsx_sse(code: & Vec<i64>, p0: i64, at: i64, pfx: i64, rex: i64, regs: & mut Vec<i64>, st: & mut NselM) -> str {
    st.fl = 0 - 1;
    var op: i64 = nsel_at(code, p0);
    var mrm: i64 = nsel_at(code, p0 + 1);
    if mrm < 0 {
        return "x86-64 code ends inside an SSE instruction";
    }
    var p: i64 = p0 + 2;
    var w: bool = (rex & 8) != 0;
    var reg: i64 = ((mrm >> 3) & 7) | (((rex >> 2) & 1) << 3);
    var rm: i64 = (mrm & 7) | ((rex & 1) << 3);
    var md: i64 = mrm >> 6;
    var xr: i64 = 32 + reg;
    var xm: i64 = 32 + rm;
    st.np = p;
    if (op == 0x10 || op == 0x11) && (pfx == 0xF2 || pfx == 0xF3) {
        // movsd / movss
        var sz: i64 = 8;
        if pfx == 0xF3 {
            sz = 4;
        }
        if md != 3 {
            var err: str = nsx_ea(code, p, at, rex, mrm, regs, st);
            if err != "" {
                return err;
            }
            if op == 0x10 {
                // a load zeroes the rest of the register
                regs.set(xr, nsel_mem_rd(st, st.ea, sz));
            } else {
                nsel_mem_wr(st, st.ea, sz, regs.get(xr));
            }
            return "";
        }
        var to: i64 = xr;
        var from: i64 = xm;
        if op == 0x11 {
            to = xm;
            from = xr;
        }
        if sz == 8 {
            regs.set(to, regs.get(from));
        } else {
            regs.set(to, (regs.get(to) & (0 - 4294967296)) | (regs.get(from) & 0xFFFFFFFF));
        }
        return "";
    }
    if md != 3 {
        return "x86-64 SSE memory operand (not evaluated) at byte " + int_to_str(at);
    }
    if op == 0x28 && pfx == 0 {
        regs.set(xr, regs.get(xm));
        return "";
    }
    if op == 0xEF && pfx == 0x66 {
        regs.set(xr, regs.get(xr) ^ regs.get(xm));
        return "";
    }
    if (op == 0x6E || op == 0x7E) && pfx == 0x66 {
        // movq / movd between an xmm register (reg) and a general one (rm)
        if op == 0x6E {
            if w {
                regs.set(xr, regs.get(rm));
            } else {
                regs.set(xr, regs.get(rm) & 0xFFFFFFFF);
            }
        } else {
            if w {
                regs.set(rm, regs.get(xr));
            } else {
                regs.set(rm, regs.get(xr) & 0xFFFFFFFF);
            }
        }
        return "";
    }
    if op == 0x2A && pfx == 0xF2 {
        // cvtsi2sd xmm, r64 (cvtsi2ss, one rounding to single, is not
        // emitted: an integer becomes an f32 through f64)
        if !w {
            return "a 32-bit integer conversion (not evaluated) at byte " + int_to_str(at);
        }
        regs.set(xr, nsf_i2f(regs.get(rm)));
        return "";
    }
    if op == 0x2C && (pfx == 0xF2 || pfx == 0xF3) {
        // cvttsd2si / cvttss2si r64, xmm (out of range: the indefinite
        // integer, MIN)
        if !w {
            return "a 32-bit integer conversion (not evaluated) at byte " + int_to_str(at);
        }
        var src: i64 = regs.get(xm);
        if pfx == 0xF3 {
            src = nsf_widen(src);
        }
        regs.set(reg, nsf_f2i(src, nsel_min()));
        return "";
    }
    if op == 0x2E && (pfx == 0x66 || pfx == 0) {
        // ucomisd / ucomiss: ZF PF CF = 111 unordered, 001 less, 100
        // equal, 000 greater
        var x: i64 = regs.get(xr);
        var y: i64 = regs.get(xm);
        if pfx == 0 {
            x = nsf_widen(x);
            y = nsf_widen(y);
        }
        var c: i64 = nsf_cmp(x, y);
        if c == 2 {
            st.fl = 7;
        } else if c == 0 - 1 {
            st.fl = 4;
        } else if c == 0 {
            st.fl = 1;
        } else {
            st.fl = 0;
        }
        return "";
    }
    if op == 0x5A && pfx == 0xF3 {
        // cvtss2sd
        regs.set(xr, nsf_widen(regs.get(xm)));
        return "";
    }
    if op == 0x5A && pfx == 0xF2 {
        // cvtsd2ss: the low 32 bits only
        regs.set(xr, (regs.get(xr) & (0 - 4294967296)) | nsf_narrow(regs.get(xm)));
        return "";
    }
    if (op == 0x58 || op == 0x5C || op == 0x59 || op == 0x5E) && (pfx == 0xF2 || pfx == 0xF3) {
        var fo: i64 = 1;
        if op == 0x5C {
            fo = 2;
        }
        if op == 0x59 {
            fo = 3;
        }
        if op == 0x5E {
            fo = 4;
        }
        if pfx == 0xF2 {
            regs.set(xr, nsf_op(fo, regs.get(xr), regs.get(xm), false));
        } else {
            regs.set(xr, (regs.get(xr) & (0 - 4294967296)) | nsf_op(fo, regs.get(xr), regs.get(xm), true));
        }
        return "";
    }
    return "unknown x86-64 SSE instruction " + int_to_str(op) + " (prefix " + int_to_str(pfx) + ") at byte " + int_to_str(at);
}

// --- AArch64 ---------------------------------------------------------------

fn nsa_cond(cc: i64, nf: bool, zf: bool, cf: bool, vf: bool) -> bool {
    var base: i64 = cc >> 1;
    var t: bool = true;
    if base == 0 {
        t = zf;
    } else if base == 1 {
        t = cf;
    } else if base == 2 {
        t = nf;
    } else if base == 3 {
        t = vf;
    } else if base == 4 {
        t = cf && !zf;
    } else if base == 5 {
        t = nf == vf;
    } else if base == 6 {
        t = !zf && nf == vf;
    } else {
        return true;
    }
    if (cc & 1) == 1 {
        return !t;
    }
    return t;
}

/// Register n of a data-processing instruction: 31 reads 0 (xzr).
fn nsa_r(regs: & Vec<i64>, n: i64) -> i64 {
    if n == 31 {
        return 0;
    }
    return regs.get(n);
}

fn nsa_set(regs: & mut Vec<i64>, d: i64, v: i64) {
    if d != 31 {
        regs.set(d, v);
    }
}

@wrapping fn nsa_shift(v: i64, typ: i64, n: i64) -> i64 {
    if n == 0 {
        return v;
    }
    if typ == 0 {
        return v << n;
    }
    if typ == 1 {
        return nsel_shr(v, n);
    }
    if typ == 2 {
        return v >> n;
    }
    return nsel_shr(v, n) | (v << (64 - n));
}

@wrapping fn nsa_exec(code: & Vec<i64>, regs: & mut Vec<i64>, st: & mut NselM) -> str {
    var nf: bool = false;
    var zf: bool = false;
    var cf: bool = false;
    var vf: bool = false;
    var p: i64 = 0;
    var steps: i64 = 0;
    while p >= 0 && p < st.stop {
        steps = steps + 1;
        if steps > 4096 {
            return "AArch64 code runs past 4096 instructions";
        }
        if p + 3 >= code.len() {
            return "AArch64 code ends inside a word (at byte " + int_to_str(p) + ")";
        }
        var w: i64 = nsel_word(code, p);

        p = p + 4;
        var d: i64 = w & 31;
        var n: i64 = (w >> 5) & 31;
        var m: i64 = (w >> 16) & 31;
        var top: i64 = (w >> 24) & 0xFF;
        if (top == 0x8B || top == 0xAB || top == 0xCB || top == 0xEB) && ((w >> 21) & 1) == 0 {
            // ADD / ADDS / SUB / SUBS (shifted register)
            var x: i64 = nsa_r(regs, n);
            var y: i64 = nsa_shift(nsa_r(regs, m), (w >> 22) & 3, (w >> 10) & 63);
            var res: i64 = 0;
            if top == 0x8B || top == 0xAB {
                res = x + y;
            } else {
                res = x - y;
            }
            if top == 0xAB {
                nf = res < 0;
                zf = res == 0;
                cf = nsel_ult(res, x);
                vf = ((~(x ^ y)) & (x ^ res)) < 0;
            }
            if top == 0xEB {
                nf = res < 0;
                zf = res == 0;
                cf = !nsel_ult(x, y);
                vf = ((x ^ y) & (x ^ res)) < 0;
            }
            nsa_set(regs, d, res);
        } else if top == 0x8A || top == 0xAA || top == 0xCA || top == 0xEA {
            // AND / ORR / EOR / ANDS (shifted register; N inverts the operand)
            var lx: i64 = nsa_r(regs, n);
            var ly: i64 = nsa_shift(nsa_r(regs, m), (w >> 22) & 3, (w >> 10) & 63);
            if ((w >> 21) & 1) == 1 {
                ly = ~ly;
            }
            var lres: i64 = 0;
            if top == 0x8A || top == 0xEA {
                lres = lx & ly;
            } else if top == 0xAA {
                lres = lx | ly;
            } else {
                lres = lx ^ ly;
            }
            if top == 0xEA {
                nf = lres < 0;
                zf = lres == 0;
                cf = false;
                vf = false;
            }
            nsa_set(regs, d, lres);
        } else if (w & 0xFFE08000) == 0x9B000000 {
            nsa_set(regs, d, nsa_r(regs, (w >> 10) & 31) + nsa_r(regs, n) * nsa_r(regs, m));
        } else if (w & 0xFFE08000) == 0x9B008000 {
            nsa_set(regs, d, nsa_r(regs, (w >> 10) & 31) - nsa_r(regs, n) * nsa_r(regs, m));
        } else if (w & 0xFFE0FC00) == 0x9B407C00 {
            nsa_set(regs, d, nsel_mulhs(nsa_r(regs, n), nsa_r(regs, m)));
        } else if (w & 0xFFE0FC00) == 0x9BC07C00 {
            nsa_set(regs, d, nsel_mulhu(nsa_r(regs, n), nsa_r(regs, m)));
        } else if (w & 0xFFE0FC00) == 0x9AC00C00 || (w & 0xFFE0FC00) == 0x9AC00800 {
            var dn: i64 = nsa_r(regs, n);
            var dm: i64 = nsa_r(regs, m);
            var q: i64 = 0;
            if dm != 0 {
                if (w & 0xFFE0FC00) == 0x9AC00800 {
                    q = nsel_udiv(dn, dm);
                } else if dn == nsel_min() && dm == 0 - 1 {
                    q = dn;
                } else {
                    q = dn / dm;
                }
            }
            nsa_set(regs, d, q);
        } else if (w & 0xFFE0FC00) == 0x9AC02000 {
            nsa_set(regs, d, nsa_r(regs, n) << (nsa_r(regs, m) & 63));
        } else if (w & 0xFFE0FC00) == 0x9AC02400 {
            nsa_set(regs, d, nsel_shr(nsa_r(regs, n), nsa_r(regs, m) & 63));
        } else if (w & 0xFFE0FC00) == 0x9AC02800 {
            nsa_set(regs, d, nsa_r(regs, n) >> (nsa_r(regs, m) & 63));
        } else if (w & 0xFFE00C00) == 0x9A800400 || (w & 0xFFE00C00) == 0x9A800000 {
            // CSINC / CSEL
            var cv: i64 = nsa_r(regs, m);
            if (w & 0xFFE00C00) == 0x9A800400 {
                cv = cv + 1;
            }
            if nsa_cond((w >> 12) & 15, nf, zf, cf, vf) {
                cv = nsa_r(regs, n);
            }
            nsa_set(regs, d, cv);
        } else if (w & 0xFFC00000) == 0x93400000 || (w & 0xFFC00000) == 0xD3400000 {
            // SBFM / UBFM (64-bit)
            var immr: i64 = (w >> 16) & 63;
            var imms: i64 = (w >> 10) & 63;
            var src: i64 = nsa_r(regs, n);
            var signed: bool = (w & 0xFFC00000) == 0x93400000;
            var bf: i64 = 0;
            if imms >= immr {
                var up: i64 = src << (63 - imms);
                if signed {
                    bf = up >> (63 - imms + immr);
                } else {
                    bf = nsel_shr(up, 63 - imms + immr);
                }
            } else {
                var low: i64 = src;
                if imms < 63 {
                    low = src & ((1 << (imms + 1)) - 1);
                    if signed {
                        low = nsel_sext(low, imms + 1);
                    }
                }
                bf = low << (64 - immr);
            }
            nsa_set(regs, d, bf);
        } else if (w & 0xFF800000) == 0xD2800000 || (w & 0xFF800000) == 0x92800000 || (w & 0xFF800000) == 0xF2800000 {
            // MOVZ / MOVN / MOVK
            var hw: i64 = ((w >> 21) & 3) * 16;
            var imm16: i64 = (w >> 5) & 0xFFFF;
            if (w & 0xFF800000) == 0xD2800000 {
                nsa_set(regs, d, imm16 << hw);
            } else if (w & 0xFF800000) == 0x92800000 {
                nsa_set(regs, d, ~(imm16 << hw));
            } else {
                var old: i64 = nsa_r(regs, d);
                nsa_set(regs, d, (old & (~(0xFFFF << hw))) | (imm16 << hw));
            }
        } else if (w & 0xFF800000) == 0x91000000 || (w & 0xFF800000) == 0xD1000000 {
            // ADD / SUB (immediate): register 31 is sp here
            var iv: i64 = (w >> 10) & 0xFFF;
            if ((w >> 22) & 1) == 1 {
                iv = iv << 12;
            }
            var base: i64 = regs.get(n);
            if (w & 0xFF800000) == 0xD1000000 {
                iv = 0 - iv;
            }
            regs.set(d, base + iv);
        } else if w == 0xD503201F {
            // nop
        } else {
            // RL6: branches, calls, loads and stores, floats (nsa_more)
            st.fl = nsa_pack(nf, zf, cf, vf);
            st.np = p;
            var xerr: str = nsa_more(w, p - 4, regs, st);
            if xerr != "" {
                return xerr;
            }
            if st.call_at >= 0 {
                st.pc = st.call_at;
                return "";
            }
            nf = (st.fl & 8) != 0;
            zf = (st.fl & 4) != 0;
            cf = (st.fl & 2) != 0;
            vf = (st.fl & 1) != 0;
            p = st.np;
        }
    }
    st.pc = p;
    return "";
}

fn nsa_pack(nf: bool, zf: bool, cf: bool, vf: bool) -> i64 {
    var f: i64 = 0;
    if nf {
        f = f | 8;
    }
    if zf {
        f = f | 4;
    }
    if cf {
        f = f | 2;
    }
    if vf {
        f = f | 1;
    }
    return f;
}

/// RL6: AArch64 saturating float -> integer (FCVTZS): NaN 0, past the
/// range MIN / MAX.
@wrapping fn nsa_f2i(b: i64) -> i64 {
    if nsf_isnan(b) {
        return 0;
    }
    if !nsf_f2i_ok(b) {
        if b < 0 {
            return nsel_min();
        }
        return nsel_min() - 1;
    }
    return nsf_f2i(b, 0);
}

/// RL6: the AArch64 words nsa_exec's integer part does not know: B, BL,
/// B.cond, CBZ / CBNZ, TBZ / TBNZ, BLR, BR; LDR / STR of every size and
/// sign (unsigned offset, register offset; general and float registers);
/// ADD (extended register); FMOV, FADD..FDIV, FCMP, FCVT, SCVTF, FCVTZS
/// (double, and single where the selections use it). `at`: the word's
/// position; st.np: the next one (the word after it, or the target);
/// st.fl: NZCV in, and out after an FCMP; a call stops the run (st.call_at).
@wrapping fn nsa_more(w: i64, at: i64, regs: & mut Vec<i64>, st: & mut NselM) -> str {
    var d: i64 = w & 31;
    var n: i64 = (w >> 5) & 31;
    var m: i64 = (w >> 16) & 31;
    var fl: i64 = st.fl;
    if (w & 0x7C000000) == 0x14000000 {
        // B / BL
        var to: i64 = at + nsel_sext(w & 0x3FFFFFF, 26) * 4;
        if (w & 0x80000000) != 0 {
            nsel_call(st, regs, at, to);
            return "";
        }
        st.np = to;
        return "";
    }
    if (w & 0xFF000010) == 0x54000000 {
        if nsa_cond(w & 15, (fl & 8) != 0, (fl & 4) != 0, (fl & 2) != 0, (fl & 1) != 0) {
            st.np = at + nsel_sext((w >> 5) & 0x7FFFF, 19) * 4;
        }
        return "";
    }
    if (w & 0x7E000000) == 0x34000000 {
        // CBZ / CBNZ (32 or 64 bits)
        var cv: i64 = nsa_r(regs, d);
        if (w & 0x80000000) == 0 {
            cv = cv & 0xFFFFFFFF;
        }
        if (cv == 0) == ((w & 0x01000000) == 0) {
            st.np = at + nsel_sext((w >> 5) & 0x7FFFF, 19) * 4;
        }
        return "";
    }
    if (w & 0x7E000000) == 0x36000000 {
        // TBZ / TBNZ
        var bit: i64 = (((w >> 31) & 1) << 5) | ((w >> 19) & 31);
        var set: bool = (nsel_shr(nsa_r(regs, d), bit) & 1) != 0;
        if set == ((w & 0x01000000) != 0) {
            st.np = at + nsel_sext((w >> 5) & 0x3FFF, 14) * 4;
        }
        return "";
    }
    if (w & 0xFFFFFC1F) == 0xD63F0000 {
        nsel_call(st, regs, at, nsa_r(regs, n));
        return "";
    }
    if (w & 0xFFFFFC1F) == 0xD61F0000 {
        st.np = nsa_r(regs, n);
        return "";
    }
    if (w & 0xFFE00000) == 0x8B200000 {
        // ADD (extended register), UXTX / SXTX: n and d may be sp
        var opt: i64 = (w >> 13) & 7;
        if opt != 3 && opt != 7 {
            return nsel_bad("AArch64 word", w, at);
        }
        regs.set(d, regs.get(n) + (nsa_r(regs, m) << ((w >> 10) & 7)));
        return "";
    }
    var uimm: bool = (w & 0x3B000000) == 0x39000000;
    var roff: bool = (w & 0x3B200C00) == 0x38200800;
    if uimm || roff {
        var size: i64 = 1 << ((w >> 30) & 3);
        var opc: i64 = (w >> 22) & 3;
        var fp: bool = (w & 0x04000000) != 0;
        var addr: i64 = regs.get(n);
        if uimm {
            addr = addr + ((w >> 10) & 0xFFF) * size;
        } else {
            var opt2: i64 = (w >> 13) & 7;
            if opt2 != 3 && opt2 != 7 {
                return "AArch64 register-offset access with an extension (not evaluated) at byte " + int_to_str(at);
            }
            var ix: i64 = nsa_r(regs, m);
            if (w & 0x1000) != 0 {
                ix = ix * size;
            }
            addr = addr + ix;
        }
        if fp {
            if size != 4 && size != 8 {
                return nsel_bad("AArch64 word", w, at);
            }
            if opc == 0 {
                nsel_mem_wr(st, addr, size, regs.get(32 + d));
            } else if opc == 1 {
                regs.set(32 + d, nsel_mem_rd(st, addr, size));
            } else {
                return nsel_bad("AArch64 word", w, at);
            }
            return "";
        }
        if opc == 0 {
            nsel_mem_wr(st, addr, size, nsa_r(regs, d));
        } else if opc == 1 {
            nsa_set(regs, d, nsel_mem_rd(st, addr, size));
        } else if opc == 2 && size < 8 {
            nsa_set(regs, d, nsel_ext_sz(nsel_mem_rd(st, addr, size), size, true));
        } else if opc == 3 && size < 4 {
            nsa_set(regs, d, nsel_ext_sz(nsel_mem_rd(st, addr, size), size, true) & 0xFFFFFFFF);
        } else {
            return nsel_bad("AArch64 word", w, at);
        }
        return "";
    }
    var fd: i64 = 32 + d;
    var fnn: i64 = 32 + n;
    var fm: i64 = 32 + m;
    var mov: i64 = w & 0xFFFFFC00;
    if mov == 0x9E670000 {
        regs.set(fd, nsa_r(regs, n));
        return "";
    }
    if mov == 0x9E660000 {
        nsa_set(regs, d, regs.get(fnn));
        return "";
    }
    if mov == 0x1E270000 {
        regs.set(fd, nsa_r(regs, n) & 0xFFFFFFFF);
        return "";
    }
    if mov == 0x1E260000 {
        nsa_set(regs, d, regs.get(fnn) & 0xFFFFFFFF);
        return "";
    }
    if mov == 0x1E604000 {
        regs.set(fd, regs.get(fnn));
        return "";
    }
    if mov == 0x1E204000 {
        regs.set(fd, regs.get(fnn) & 0xFFFFFFFF);
        return "";
    }
    if mov == 0x1E22C000 {
        regs.set(fd, nsf_widen(regs.get(fnn)));
        return "";
    }
    if mov == 0x1E624000 {
        regs.set(fd, nsf_narrow(regs.get(fnn)));
        return "";
    }
    if mov == 0x9E620000 {
        regs.set(fd, nsf_i2f(nsa_r(regs, n)));
        return "";
    }
    if mov == 0x9E780000 {
        nsa_set(regs, d, nsa_f2i(regs.get(fnn)));
        return "";
    }
    if mov == 0x9E380000 {
        nsa_set(regs, d, nsa_f2i(nsf_widen(regs.get(fnn))));
        return "";
    }
    var ftype: i64 = (w >> 22) & 3;
    if (w & 0xFF200C00) == 0x1E200800 && ftype <= 1 {
        // FMUL 0 / FDIV 1 / FADD 2 / FSUB 3
        var fop: i64 = (w >> 12) & 15;
        var fo: i64 = 0;
        if fop == 0 {
            fo = 3;
        } else if fop == 1 {
            fo = 4;
        } else if fop == 2 {
            fo = 1;
        } else if fop == 3 {
            fo = 2;
        } else {
            return nsel_bad("AArch64 word", w, at);
        }
        if ftype == 1 {
            regs.set(fd, nsf_op(fo, regs.get(fnn), regs.get(fm), false));
        } else {
            regs.set(fd, nsf_op(fo, regs.get(fnn) & 0xFFFFFFFF, regs.get(fm) & 0xFFFFFFFF, true));
        }
        return "";
    }
    if (w & 0xFF20FC1F) == 0x1E202000 && ftype <= 1 {
        // FCMP: NZCV 0011 unordered, 1000 less, 0110 equal, 0010 greater
        var x: i64 = regs.get(fnn);
        var y: i64 = regs.get(fm);
        if ftype == 0 {
            x = nsf_widen(x);
            y = nsf_widen(y);
        }
        var c: i64 = nsf_cmp(x, y);
        if c == 2 {
            st.fl = 3;
        } else if c == 0 - 1 {
            st.fl = 8;
        } else if c == 0 {
            st.fl = 6;
        } else {
            st.fl = 2;
        }
        return "";
    }
    return nsel_bad("AArch64 word", w, at);
}

// --- RISC-V ----------------------------------------------------------------

fn nsr_r(regs: & Vec<i64>, n: i64) -> i64 {
    if n == 0 {
        return 0;
    }
    return regs.get(n);
}

@wrapping fn nsr_exec(code: & Vec<i64>, regs: & mut Vec<i64>, st: & mut NselM) -> str {
    var p: i64 = 0;
    var steps: i64 = 0;
    while p >= 0 && p < st.stop {
        steps = steps + 1;
        if steps > 4096 {
            return "RISC-V code runs past 4096 instructions";
        }
        if p + 3 >= code.len() {
            return "RISC-V code ends inside a word (at byte " + int_to_str(p) + ")";
        }
        var w: i64 = nsel_word(code, p);

        p = p + 4;
        var opc: i64 = w & 0x7F;
        var rd: i64 = (w >> 7) & 31;
        var f3: i64 = (w >> 12) & 7;
        var rs1: i64 = (w >> 15) & 31;
        var rs2: i64 = (w >> 20) & 31;
        var f7: i64 = (w >> 25) & 0x7F;
        var x: i64 = nsr_r(regs, rs1);
        var y: i64 = nsr_r(regs, rs2);
        var imm: i64 = nsel_sext((w >> 20) & 0xFFF, 12);
        var res: i64 = 0;
        if opc == 0x33 {
            if f7 == 0 && f3 == 0 {
                res = x + y;
            } else if f7 == 0x20 && f3 == 0 {
                res = x - y;
            } else if f7 == 0 && f3 == 1 {
                res = x << (y & 63);
            } else if f7 == 0 && f3 == 2 {
                if x < y {
                    res = 1;
                }
            } else if f7 == 0 && f3 == 3 {
                if nsel_ult(x, y) {
                    res = 1;
                }
            } else if f7 == 0 && f3 == 4 {
                res = x ^ y;
            } else if f7 == 0 && f3 == 5 {
                res = nsel_shr(x, y & 63);
            } else if f7 == 0x20 && f3 == 5 {
                res = x >> (y & 63);
            } else if f7 == 0 && f3 == 6 {
                res = x | y;
            } else if f7 == 0 && f3 == 7 {
                res = x & y;
            } else if f7 == 1 && f3 == 0 {
                res = x * y;
            } else if f7 == 1 && f3 == 1 {
                res = nsel_mulhs(x, y);
            } else if f7 == 1 && f3 == 3 {
                res = nsel_mulhu(x, y);
            } else if f7 == 1 && (f3 == 4 || f3 == 6) {
                // div / rem: by zero -1 / x; MIN / -1 MIN / 0
                if y == 0 {
                    if f3 == 4 {
                        res = 0 - 1;
                    } else {
                        res = x;
                    }
                } else if x == nsel_min() && y == 0 - 1 {
                    if f3 == 4 {
                        res = x;
                    } else {
                        res = 0;
                    }
                } else if f3 == 4 {
                    res = x / y;
                } else {
                    res = x % y;
                }
            } else if f7 == 1 && (f3 == 5 || f3 == 7) {
                if y == 0 {
                    if f3 == 5 {
                        res = 0 - 1;
                    } else {
                        res = x;
                    }
                } else if f3 == 5 {
                    res = nsel_udiv(x, y);
                } else {
                    res = nsel_urem(x, y);
                }
            } else if f7 == 0x10 && (f3 == 2 || f3 == 4 || f3 == 6) {
                // Zba shNadd: rd = rs2 + (rs1 << N)
                res = y + (x << (f3 / 2));
            } else {
                return nsel_bad("RISC-V word", w, p - 4);
            }
        } else if opc == 0x13 {
            if f3 == 0 {
                res = x + imm;
            } else if f3 == 1 {
                var i12: i64 = (w >> 20) & 0xFFF;
                if (i12 >> 6) == 0 {
                    res = x << (i12 & 63);
                } else if i12 == 0x604 {
                    res = nsel_sext(x, 8);
                } else if i12 == 0x605 {
                    res = nsel_sext(x, 16);
                } else {
                    return nsel_bad("RISC-V word", w, p - 4);
                }
            } else if f3 == 2 {
                if x < imm {
                    res = 1;
                }
            } else if f3 == 3 {
                if nsel_ult(x, imm) {
                    res = 1;
                }
            } else if f3 == 4 {
                res = x ^ imm;
            } else if f3 == 5 {
                var sh: i64 = (w >> 20) & 63;
                if ((w >> 26) & 0x3F) == 0x10 {
                    res = x >> sh;
                } else if ((w >> 26) & 0x3F) == 0 {
                    res = nsel_shr(x, sh);
                } else {
                    return nsel_bad("RISC-V word", w, p - 4);
                }
            } else if f3 == 6 {
                res = x | imm;
            } else {
                res = x & imm;
            }
        } else if opc == 0x1B && f3 == 0 {
            res = nsel_sext(x + imm, 32);
        } else if opc == 0x3B {
            if f7 == 0x04 && f3 == 0 {
                res = (x & 0xFFFFFFFF) + y;
            } else if f7 == 0x04 && f3 == 4 && rs2 == 0 {
                res = x & 0xFFFF;
            } else if f7 == 0 && f3 == 0 {
                res = nsel_sext(x + y, 32);
            } else if f7 == 0x20 && f3 == 0 {
                res = nsel_sext(x - y, 32);
            } else {
                return nsel_bad("RISC-V word", w, p - 4);
            }
        } else if opc == 0x37 {
            res = nsel_sext(w & 0xFFFFF000, 32);
        } else {
            // RL6: branches, calls, loads and stores, floats (nsr_more)
            st.np = p;
            var xerr: str = nsr_more(w, p - 4, regs, st);
            if xerr != "" {
                return xerr;
            }
            if st.call_at >= 0 {
                st.pc = st.call_at;
                return "";
            }
            p = st.np;
            continue;
        }
        if rd != 0 {
            regs.set(rd, res);
        }
    }
    st.pc = p;
    return "";
}

/// RL6: RISC-V saturating float -> integer (FCVT.L.D / .S): NaN and past
/// the top MAX, past the bottom MIN.
@wrapping fn nsr_f2i(b: i64) -> i64 {
    if nsf_isnan(b) {
        return nsel_min() - 1;
    }
    if !nsf_f2i_ok(b) {
        if b < 0 {
            return nsel_min();
        }
        return nsel_min() - 1;
    }
    return nsf_f2i(b, 0);
}

fn nsr_setx(regs: & mut Vec<i64>, rd: i64, v: i64) {
    if rd != 0 {
        regs.set(rd, v);
    }
}

/// RL6: the RISC-V words nsr_exec's integer part does not know: BEQ..BGEU,
/// JAL, JALR (with rd ra: a call, which stops the run), AUIPC; LB..LD,
/// LBU..LWU, SB..SD, FLW / FLD, FSW / FSD; FADD..FDIV (.d, .s), FEQ / FLT /
/// FLE, FMV between the register files, FCVT between f32 and f64, from
/// and to an integer (.d; .l.s), FSGNJ / FSGNJX. Float registers are
/// 32 + f, an f32 NaN-boxed. `at`: the word's position; st.np: the next.
@wrapping fn nsr_more(w: i64, at: i64, regs: & mut Vec<i64>, st: & mut NselM) -> str {
    var opc: i64 = w & 0x7F;
    var rd: i64 = (w >> 7) & 31;
    var f3: i64 = (w >> 12) & 7;
    var rs1: i64 = (w >> 15) & 31;
    var rs2: i64 = (w >> 20) & 31;
    var f7: i64 = (w >> 25) & 0x7F;
    var x: i64 = nsr_r(regs, rs1);
    var y: i64 = nsr_r(regs, rs2);
    var imm: i64 = nsel_sext((w >> 20) & 0xFFF, 12);
    if opc == 0x63 {
        var boff: i64 = nsel_sext((((w >> 31) & 1) << 12) | (((w >> 7) & 1) << 11) | (((w >> 25) & 0x3F) << 5) | (((w >> 8) & 0xF) << 1), 13);
        var t: bool = false;
        if f3 == 0 {
            t = x == y;
        } else if f3 == 1 {
            t = x != y;
        } else if f3 == 4 {
            t = x < y;
        } else if f3 == 5 {
            t = x >= y;
        } else if f3 == 6 {
            t = nsel_ult(x, y);
        } else if f3 == 7 {
            t = !nsel_ult(x, y);
        } else {
            return nsel_bad("RISC-V word", w, at);
        }
        if t {
            st.np = at + boff;
        }
        return "";
    }
    if opc == 0x6F || opc == 0x67 {
        var to: i64 = 0;
        if opc == 0x6F {
            to = at + nsel_sext((((w >> 31) & 1) << 20) | (((w >> 12) & 0xFF) << 12) | (((w >> 20) & 1) << 11) | (((w >> 21) & 0x3FF) << 1), 21);
        } else {
            if f3 != 0 {
                return nsel_bad("RISC-V word", w, at);
            }
            to = (x + imm) & (0 - 2);
        }
        if rd == RV_RA {
            nsel_call(st, regs, at, to);
            return "";
        }
        nsr_setx(regs, rd, at + 4);
        st.np = to;
        return "";
    }
    if opc == 0x17 {
        nsr_setx(regs, rd, at + nsel_sext(w & 0xFFFFF000, 32));
        return "";
    }
    if opc == 0x03 {
        var lsz: i64 = 1 << (f3 & 3);
        if f3 == 7 {
            return nsel_bad("RISC-V word", w, at);
        }
        nsr_setx(regs, rd, nsel_ext_sz(nsel_mem_rd(st, x + imm, lsz), lsz, f3 < 4));
        return "";
    }
    if opc == 0x23 {
        var simm: i64 = nsel_sext((((w >> 25) & 0x7F) << 5) | ((w >> 7) & 31), 12);
        if f3 > 3 {
            return nsel_bad("RISC-V word", w, at);
        }
        nsel_mem_wr(st, x + simm, 1 << f3, y);
        return "";
    }
    if opc == 0x07 {
        if f3 == 2 {
            regs.set(32 + rd, nsf_rv_box(nsel_mem_rd(st, x + imm, 4)));
        } else if f3 == 3 {
            regs.set(32 + rd, nsel_mem_rd(st, x + imm, 8));
        } else {
            return nsel_bad("RISC-V word", w, at);
        }
        return "";
    }
    if opc == 0x27 {
        var fimm: i64 = nsel_sext((((w >> 25) & 0x7F) << 5) | ((w >> 7) & 31), 12);
        if f3 == 2 {
            nsel_mem_wr(st, x + fimm, 4, regs.get(32 + rs2));
        } else if f3 == 3 {
            nsel_mem_wr(st, x + fimm, 8, regs.get(32 + rs2));
        } else {
            return nsel_bad("RISC-V word", w, at);
        }
        return "";
    }
    if opc != 0x53 {
        return nsel_bad("RISC-V word", w, at);
    }
    var f1: i64 = regs.get(32 + rs1);
    var f2: i64 = regs.get(32 + rs2);
    var dbl: bool = (f7 & 3) == 1;
    var sgl: bool = (f7 & 3) == 0;
    if f7 <= 0x0D && (dbl || sgl) {
        // FADD 0 / FSUB 1 / FMUL 2 / FDIV 3 (f7 >> 2), rounding to nearest
        if f3 != 7 && f3 != 0 {
            return "RISC-V float operation with a static rounding mode (not evaluated) at byte " + int_to_str(at);
        }
        var fo: i64 = (f7 >> 2) + 1;
        if dbl {
            regs.set(32 + rd, nsf_op(fo, f1, f2, false));
        } else {
            regs.set(32 + rd, nsf_rv_box(nsf_op(fo, nsf_rv_unbox(f1), nsf_rv_unbox(f2), true)));
        }
        return "";
    }
    if f7 == 0x51 || f7 == 0x50 {
        // FEQ 2 / FLT 1 / FLE 0
        var a: i64 = f1;
        var b: i64 = f2;
        if f7 == 0x50 {
            a = nsf_widen(nsf_rv_unbox(f1));
            b = nsf_widen(nsf_rv_unbox(f2));
        }
        var c: i64 = nsf_cmp(a, b);
        var r: i64 = 0;
        if f3 == 2 && c == 0 {
            r = 1;
        } else if f3 == 1 && c == 0 - 1 {
            r = 1;
        } else if f3 == 0 && (c == 0 - 1 || c == 0) {
            r = 1;
        } else if f3 > 2 {
            return nsel_bad("RISC-V word", w, at);
        }
        nsr_setx(regs, rd, r);
        return "";
    }
    if f7 == 0x79 && rs2 == 0 && f3 == 0 {
        regs.set(32 + rd, x);
        return "";
    }
    if f7 == 0x78 && rs2 == 0 && f3 == 0 {
        regs.set(32 + rd, nsf_rv_box(x));
        return "";
    }
    if f7 == 0x71 && rs2 == 0 && f3 == 0 {
        nsr_setx(regs, rd, f1);
        return "";
    }
    if f7 == 0x70 && rs2 == 0 && f3 == 0 {
        nsr_setx(regs, rd, nsel_sext(f1, 32));
        return "";
    }
    if f7 == 0x21 && rs2 == 0 {
        regs.set(32 + rd, nsf_widen(nsf_rv_unbox(f1)));
        return "";
    }
    if f7 == 0x20 && rs2 == 1 {
        regs.set(32 + rd, nsf_rv_box(nsf_narrow(f1)));
        return "";
    }
    if f7 == 0x69 && rs2 == 2 {
        if f3 != 7 && f3 != 0 {
            return "RISC-V conversion with a static rounding mode (not evaluated) at byte " + int_to_str(at);
        }
        regs.set(32 + rd, nsf_i2f(x));
        return "";
    }
    if (f7 == 0x61 || f7 == 0x60) && rs2 == 2 {
        if f3 != 1 {
            return "RISC-V float to integer not toward zero (not evaluated) at byte " + int_to_str(at);
        }
        if f7 == 0x61 {
            nsr_setx(regs, rd, nsr_f2i(f1));
        } else {
            nsr_setx(regs, rd, nsr_f2i(nsf_widen(nsf_rv_unbox(f1))));
        }
        return "";
    }
    if f7 == 0x11 && (f3 == 0 || f3 == 2) {
        var sgn: i64 = nsel_min();
        if f3 == 0 {
            regs.set(32 + rd, (f1 & (~sgn)) | (f2 & sgn));
        } else {
            regs.set(32 + rd, f1 ^ (f2 & sgn));
        }
        return "";
    }
    return nsel_bad("RISC-V word", w, at);
}

// ===========================================================================
// RL6 (continued): floats, memory, branches and calls. nat_ir.fd's
// nat_sel_check_more selects each case alone with physical registers
// through ng_mi_dispatch, as nat_sel_check does for the integer
// operations, and hands the bytes to these with what the operation means:
//   nat_sel_eval_float   MO_FBIN (+ - * /), MO_FCMP (EQ..GE, IEEE: NaN
//                        unordered), MO_I2F, MO_F2I, f64 and f32, in
//                        general registers (the bits; an f32 zero-extended)
//                        or float registers (32 + f)
//   nat_sel_eval_mem     MO_LOAD / MO_STORE / MO_LDX / MO_STX of every size
//                        and sign: a load reads what the memory holds at
//                        the address, extended, and writes nothing; a store
//                        writes exactly its bytes there
//   nat_sel_eval_branch  MO_BRCC (every kind, against a register or zero),
//                        MO_BNEZ / MO_BEQZ, MO_TBNZ: taken exactly when the
//                        condition holds, falling through otherwise
//   nat_sel_eval_call    argument setup and MO_CALL / MO_CALLR: at the call
//                        each argument is in its register or its outgoing
//                        stack slot, the target is the callee's
// ===========================================================================

pub const NSEL_FBIN: i64 = 32; pub const NSEL_FCMP: i64 = 33; pub const NSEL_I2F: i64 = 34; pub const NSEL_F2I: i64 = 35; pub const NSEL_BNEZ: i64 = 12; pub const NSEL_BEQZ: i64 = 13; pub const NSEL_BRCC: i64 = 45; pub const NSEL_TBNZ: i64 = 53;

/// Float values (bits; f32 patterns zero-extended when is32): edges first
/// (zeros, ones, a fraction, subnormals, the largest, infinities, NaN,
/// integers past 2^53, +-2^63), then pseudo-random ones of moderate size
/// (F2I's range), then raw random patterns.
@wrapping pub fn nsf_values(is32: bool) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    if is32 {
        v.push(0);
        v.push(0x80000000);
        v.push(0x3F800000);
        v.push(0xBFC00000);
        v.push(0x40200000);
        v.push(0x3DCCCCCD);
        v.push(0x7F7FFFFF);
        v.push(0x00000001);
        v.push(0x80000001);
        v.push(0x7F800000);
        v.push(0xFF800000);
        v.push(0x7FC00000);
        v.push(0x4B000001);
        v.push(0x5EFFFFFF);
        v.push(0xDF000000);
        v.push(0x5F000000);
        v.push(0x00800000);
        v.push(0xC2F6E979);
    } else {
        v.push(0);
        v.push(nsel_min());
        v.push(0x3FF0000000000000);
        v.push(0 - 4609434218613702656);
        v.push(0x4004000000000000);
        v.push(0x3FB999999999999A);
        v.push(0x7FEFFFFFFFFFFFFF);
        v.push(1);
        v.push(nsel_min() + 1);
        v.push(0x7FF0000000000000);
        v.push(0 - 4503599627370496);
        v.push(0x7FF8000000000000);
        v.push(0x4340000000000001);
        v.push(0x43DFFFFFFFFFFFFF);
        v.push(0 - 4332462841530417152);
        v.push(0x43E0000000000000);
        v.push(0x0010000000000000);
        v.push(0x405EDD2F1A9FBE77);
    }
    var x: i64 = 0x2545F4914F6CDD1D;
    var i: i64 = 0;
    while i < 40 {
        x = x ^ (x << 13);
        x = x ^ nsel_shr(x, 7);
        x = x ^ (x << 17);
        if is32 {
            if i % 2 == 0 {
                // exponent 107..170: magnitudes about 2^-20 .. 2^43
                v.push((x & 0x807FFFFF) | ((107 + (nsel_shr(x, 40) & 63)) << 23));
            } else {
                v.push(x & 0xFFFFFFFF);
            }
        } else {
            if i % 2 == 0 {
                v.push((x & (0 - 9218868437227405313)) | ((1003 + (nsel_shr(x, 52) & 63)) << 52));
            } else {
                v.push(x);
            }
        }
        i = i + 1;
    }
    return v;
}

/// The value pairs a two-operand case runs on: every pair of the first
/// `ne` values, then neighbouring pairs of the rest.
fn nsel_pairs(vals: & Vec<i64>, ne: i64, pa: & mut Vec<i64>, pb: & mut Vec<i64>) {
    var i: i64 = 0;
    while i < ne && i < vals.len() {
        var j: i64 = 0;
        while j < ne && j < vals.len() {
            pa.push(vals.get(i));
            pb.push(vals.get(j));
            j = j + 1;
        }
        i = i + 1;
    }
    i = ne;
    while i + 1 < vals.len() {
        pa.push(vals.get(i));
        pb.push(vals.get(i + 1));
        pa.push(vals.get(i + 1));
        pb.push(vals.get(i));
        i = i + 1;
    }
}

/// Fresh registers: every one a different pattern.
fn nsel_regs64() -> Vec<i64> {
    var regs: Vec<i64> = Vec::new();
    var r: i64 = 0;
    while r < 64 {
        regs.push(0x5A5A5A5A00000000 + r * 0x10101);
        r = r + 1;
    }
    return regs;
}

/// Register r = float value v (bits; an f32 pattern when is32) as `arch`
/// holds it: a general register its bits (an f32 zero-extended); a float
/// register (32 + f) the double, or the single in the low 32 bits with
/// what was there above it on x86-64, zeros on AArch64, NaN-boxed on
/// RISC-V.
@wrapping fn nsf_put(arch: i64, regs: & mut Vec<i64>, r: i64, v: i64, is32: bool) {
    if r < 32 || !is32 {
        regs.set(r, v);
        return;
    }
    if arch == NAT_X64 {
        regs.set(r, (regs.get(r) & (0 - 4294967296)) | (v & 0xFFFFFFFF));
    } else if arch == NAT_A64 {
        regs.set(r, v & 0xFFFFFFFF);
    } else {
        regs.set(r, nsf_rv_box(v));
    }
}

/// The float value register r holds (nsf_put's inverse).
@wrapping fn nsf_get(arch: i64, regs: & Vec<i64>, r: i64, is32: bool) -> i64 {
    if r < 32 || !is32 {
        return regs.get(r);
    }
    if arch == NAT_RV64 {
        return nsf_rv_unbox(regs.get(r));
    }
    return regs.get(r) & 0xFFFFFFFF;
}

fn nsf_name(op: i64, imm: i64, w: i64) -> str {
    var nm: str = "MO_FBIN";
    if op == NSEL_FCMP {
        nm = "MO_FCMP";
    } else if op == NSEL_I2F {
        nm = "MO_I2F";
    } else if op == NSEL_F2I {
        nm = "MO_F2I";
    }
    var ty: str = "f64";
    if w != 0 {
        ty = "f32";
    }
    return nm + " (" + int_to_str(imm) + ", " + ty + ")";
}

/// What float operation `op` gives (bits; FCMP 0 / 1, F2I the integer).
/// is32: the f32 forms. ok[0] = 0 when the operation is not defined on
/// these inputs (F2I of a NaN or past the i64 range).
@wrapping pub fn nat_sel_fref(op: i64, imm: i64, is32: bool, a: i64, b: i64, ok: & mut Vec<i64>) -> i64 {
    if op == NSEL_FBIN {
        return nsf_op(imm, a, b, is32);
    }
    if op == NSEL_FCMP {
        var x: i64 = a;
        var y: i64 = b;
        if is32 {
            x = nsf_widen(a);
            y = nsf_widen(b);
        }
        var c: i64 = nsf_cmp(x, y);
        var t: bool = false;
        if imm == 0 {
            t = c == 0;
        } else if imm == 1 {
            t = c != 0;
        } else if imm == 2 {
            t = c == 0 - 1;
        } else if imm == 3 {
            t = c == 0 - 1 || c == 0;
        } else if imm == 4 {
            t = c == 1;
        } else {
            t = c == 1 || c == 0;
        }
        if t {
            return 1;
        }
        return 0;
    }
    if op == NSEL_I2F {
        // an integer becomes an f32 through f64 (the MIR's meaning)
        if is32 {
            return nsf_narrow(nsf_i2f(a));
        }
        return nsf_i2f(a);
    }
    var src: i64 = a;
    if is32 {
        src = nsf_widen(a);
    }
    if !nsf_f2i_ok(src) {
        ok.set(0, 0);
        return 0;
    }
    return nsf_f2i(src, 0);
}

/// RL6: run float case `code` (op with imm: FBIN's operation, FCMP's
/// kind; w != 0: f32) on edge and pseudo-random values. d, a, b: its
/// registers (32 + f: a float register). "" or what went wrong.
@wrapping pub fn nat_sel_eval_float(arch: i64, code: Vec<i64>, op: i64, d: i64, a: i64, b: i64, imm: i64, w: i64) -> str {
    var is32: bool = w != 0;
    var two: bool = op == NSEL_FBIN || op == NSEL_FCMP;
    var pa: Vec<i64> = Vec::new();
    var pb: Vec<i64> = Vec::new();
    if op == NSEL_I2F {
        var iv: Vec<i64> = nsel_values();
        var ii: i64 = 0;
        while ii < iv.len() {
            pa.push(iv.get(ii));
            pb.push(0);
            ii = ii + 1;
        }
    } else if two {
        var fv: Vec<i64> = nsf_values(is32);
        nsel_pairs(& fv, 18, & mut pa, & mut pb);
    } else {
        var fv1: Vec<i64> = nsf_values(is32);
        var fi: i64 = 0;
        while fi < fv1.len() {
            pa.push(fv1.get(fi));
            pb.push(0);
            fi = fi + 1;
        }
    }
    // the result: a float (bits) for FBIN and I2F, an integer otherwise
    var fres: bool = op == NSEL_FBIN || op == NSEL_I2F;
    var in32: bool = is32 && op != NSEL_I2F;
    var k: i64 = 0;
    while k < pa.len() {
        var av: i64 = pa.get(k);
        var bv: i64 = pb.get(k);
        if a == b {
            bv = av;
        }
        var ok: Vec<i64> = Vec::new();
        ok.push(1);
        var want: i64 = nat_sel_fref(op, imm, is32, av, bv, & mut ok);
        if ok.get(0) != 0 {
            var regs: Vec<i64> = nsel_regs64();
            nsf_put(arch, & mut regs, a, av, in32);
            if two {
                nsf_put(arch, & mut regs, b, bv, in32);
            }
            var st: NselM = NselM_new(code.len());
            var err: str = nsel_exec_m(arch, & code, & mut regs, & mut st);
            if err != "" {
                return nsf_name(op, imm, w) + ": " + err;
            }
            var got: i64 = 0;
            if fres {
                got = nsf_get(arch, & regs, d, is32);
            } else {
                got = regs.get(d);
            }
            var same: bool = got == want;
            if fres && !same {
                // any NaN is the NaN (the payload is the target's)
                if is32 {
                    same = nsf_isnan32(want) && nsf_isnan32(got) && (d >= 32 || nsel_shr(got, 32) == 0);
                } else {
                    same = nsf_isnan(want) && nsf_isnan(got);
                }
            }
            if !same {
                return nsf_name(op, imm, w) + ": got " + int_to_str(got) + ", want " + int_to_str(want) + nsel_ctx(d, a, b, av, bv);
            }
            if a != d && nsf_get(arch, & regs, a, in32) != av {
                return nsf_name(op, imm, w) + ": changed its first input register" + nsel_ctx(d, a, b, av, bv);
            }
            if two && b != d && b != a && nsf_get(arch, & regs, b, in32) != bv {
                return nsf_name(op, imm, w) + ": changed its second input register" + nsel_ctx(d, a, b, av, bv);
            }
        }
        k = k + 1;
    }
    return "";
}

/// RL6: run memory case `code`: a load (store false) of `size` bytes
/// (signed: sign-extended) into r, or a store of r, at [base + (idx << sh)
/// + disp] (idx -1: none; r, base, idx may be float registers 32 + f or,
/// on AArch64, 31: sp as the base, xzr as the index or value). Several
/// base, index and stored values; the memory starts with a known pattern.
/// sp: the stack pointer register (it holds the base when base is it).
@wrapping pub fn nat_sel_eval_mem(arch: i64, code: Vec<i64>, store: bool, r: i64, base: i64, idx: i64, sh: i64, disp: i64, size: i64, signed: bool) -> str {
    var what: str = "MO_LOAD";
    if store {
        what = "MO_STORE";
    }
    what = what + " (" + int_to_str(size) + " bytes";
    if signed && !store {
        what = what + " signed";
    }
    what = what + ", r " + int_to_str(r) + " base " + int_to_str(base) + " index " + int_to_str(idx) + " << " + int_to_str(sh) + " disp " + int_to_str(disp) + ")";
    var bases: Vec<i64> = Vec::new();
    bases.push(0x10000000);
    bases.push(0x7FFF0000F008);
    var ixs: Vec<i64> = Vec::new();
    ixs.push(0);
    if idx >= 0 {
        ixs.push(1);
        ixs.push(7);
        ixs.push(0 - 3);
        ixs.push(1000);
    }
    // a store's values; a load's memory: the address pattern, then every
    // byte 0x80, 0x7F, 0xFF (sign bits set and clear)
    var vs: Vec<i64> = Vec::new();
    if store {
        vs.push(0x1122334455667788);
        vs.push(0 - 1);
        vs.push(0x80);
        vs.push(0 - 9151314442816847872);
    } else {
        vs.push(0 - 1);
        vs.push(0x80);
        vs.push(0x7F);
        vs.push(0xFF);
    }
    var a64_zr_ix: bool = arch == NAT_A64 && idx == 31;
    var a64_zr_v: bool = arch == NAT_A64 && r == 31;
    var bi: i64 = 0;
    while bi < bases.len() {
        var ii: i64 = 0;
        while ii < ixs.len() {
            var vi: i64 = 0;
            while vi < vs.len() {
                var bv: i64 = bases.get(bi);
                var iv: i64 = ixs.get(ii);
                var vv: i64 = vs.get(vi);
                var regs: Vec<i64> = nsel_regs64();
                if idx >= 0 && idx != base {
                    regs.set(idx, iv);
                }
                regs.set(base, bv);
                if store && r != base && r != idx {
                    regs.set(r, vv);
                }
                // what the registers hold when the code runs
                var ieff: i64 = 0;
                if idx >= 0 {
                    ieff = regs.get(idx);
                    if a64_zr_ix {
                        ieff = 0;
                    }
                }
                var vstore: i64 = regs.get(r);
                if a64_zr_v {
                    vstore = 0;
                }
                var ea: i64 = regs.get(base) + (ieff << sh) + disp;
                var bsave: i64 = regs.get(base);
                var isave: i64 = 0;
                if idx >= 0 {
                    isave = regs.get(idx);
                }
                var st: NselM = NselM_new(code.len());
                if !store {
                    st.fill = vv;
                }
                var err: str = nsel_exec_m(arch, & code, & mut regs, & mut st);
                if err != "" {
                    return what + ": " + err;
                }
                if store {
                    var wi: i64 = 0;
                    while wi < st.wa.len() {
                        var wa: i64 = st.wa.get(wi);
                        if wa < ea || wa >= ea + size {
                            return what + ": wrote byte " + int_to_str(wa - ea) + " from the address (base " + int_to_str(bsave) + ", index " + int_to_str(ieff) + ")";
                        }
                        wi = wi + 1;
                    }
                    var got: i64 = nsel_mem_rd(& st, ea, size);
                    var want: i64 = nsel_ext_sz(vstore, size, false);
                    if got != want || st.wa.len() == 0 {
                        return what + ": memory holds " + int_to_str(got) + ", want " + int_to_str(want);
                    }
                    if r != base && r != idx && !a64_zr_v && regs.get(r) != vstore {
                        return what + ": changed the stored register";
                    }
                } else {
                    if st.wa.len() != 0 {
                        return what + ": a load wrote memory";
                    }
                    var want2: i64 = nsel_ext_sz(nsel_mem_rd(& st, ea, size), size, signed && r < 32);
                    var got2: i64 = regs.get(r);
                    if r >= 32 {
                        got2 = nsf_get(arch, & regs, r, size == 4);
                    }
                    if got2 != want2 {
                        return what + ": got " + int_to_str(got2) + ", want " + int_to_str(want2) + " (base " + int_to_str(bsave) + ", index " + int_to_str(ieff) + ")";
                    }
                }
                if base != r || store {
                    if regs.get(base) != bsave {
                        return what + ": changed the base register";
                    }
                }
                if idx >= 0 && (idx != r || store) && regs.get(idx) != isave {
                    return what + ": changed the index register";
                }
                vi = vi + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    return "";
}

/// RL6: run branch case `code`: kind NSEL_BRCC (a i1 b, i1 a compare
/// kind; b may be the zero register zr), NSEL_BNEZ / NSEL_BEQZ (a), or
/// NSEL_TBNZ (bit i1 of a set, i2 = 0, or clear, i2 = 1). The branch's
/// fall-through is at byte ft and its target at byte tk (> ft): every run
/// must end at the one the condition picks.
@wrapping pub fn nat_sel_eval_branch(arch: i64, code: Vec<i64>, ft: i64, tk: i64, kind: i64, a: i64, b: i64, i1: i64, i2: i64, zr: i64) -> str {
    var what: str = "MO_BRCC (" + int_to_str(i1) + ")";
    if kind == NSEL_BNEZ {
        what = "MO_BNEZ";
    } else if kind == NSEL_BEQZ {
        what = "MO_BEQZ";
    } else if kind == NSEL_TBNZ {
        what = "MO_TBNZ (bit " + int_to_str(i1) + ", clear " + int_to_str(i2) + ")";
    }
    var vals: Vec<i64> = nsel_values();
    var pa: Vec<i64> = Vec::new();
    var pb: Vec<i64> = Vec::new();
    nsel_pairs(& vals, 18, & mut pa, & mut pb);
    var k: i64 = 0;
    while k < pa.len() {
        var av: i64 = pa.get(k);
        var bv: i64 = pb.get(k);
        if a == b {
            bv = av;
        }
        if b == zr {
            bv = 0;
        }
        var regs: Vec<i64> = nsel_regs64();
        regs.set(a, av);
        if kind == NSEL_BRCC && b != zr {
            regs.set(b, bv);
        }
        var st: NselM = NselM_new(ft);
        var err: str = nsel_exec_m(arch, & code, & mut regs, & mut st);
        if err != "" {
            return what + ": " + err;
        }
        if st.call_at >= 0 {
            return what + ": a call";
        }
        var want: bool = false;
        if kind == NSEL_BRCC {
            want = nat_sel_ref(NSEL_SETCC, i1, av, bv) == 1;
        } else if kind == NSEL_BNEZ {
            want = av != 0;
        } else if kind == NSEL_BEQZ {
            want = av == 0;
        } else {
            want = (nsel_shr(av, i1) & 1) == 1;
            if i2 != 0 {
                want = !want;
            }
        }
        var taken: bool = st.pc == tk;
        if st.pc != tk && st.pc != ft {
            return what + ": the run ended at byte " + int_to_str(st.pc) + " (the fall-through is " + int_to_str(ft) + ", the target " + int_to_str(tk) + ")" + nsel_ctx(0, a, b, av, bv);
        }
        if taken != want {
            var tw: str = "taken";
            if !want {
                tw = "not taken";
            }
            return what + ": must be " + tw + nsel_ctx(0, a, b, av, bv);
        }
        if regs.get(a) != av {
            return what + ": changed its register" + nsel_ctx(0, a, b, av, bv);
        }
        if kind == NSEL_BRCC && b != zr && regs.get(b) != bv {
            return what + ": changed its second register" + nsel_ctx(0, a, b, av, bv);
        }
        k = k + 1;
    }
    return "";
}

/// RL6: run call case `code` (argument setup, then the call) from the
/// registers init_r = init_v (the rest a pattern; sp = spv): it must stop
/// at a call to byte `target` with each want_r register holding its
/// want_v value and the k-th outgoing stack argument, the 8 bytes at
/// spv + 8k, holding want_s[k]; sp unchanged.
@wrapping pub fn nat_sel_eval_call(arch: i64, code: Vec<i64>, init_r: Vec<i64>, init_v: Vec<i64>, want_r: Vec<i64>, want_v: Vec<i64>, want_s: Vec<i64>, sp: i64, spv: i64, target: i64) -> str {
    var regs: Vec<i64> = nsel_regs64();
    var i: i64 = 0;
    while i < init_r.len() {
        regs.set(init_r.get(i), init_v.get(i));
        i = i + 1;
    }
    regs.set(sp, spv);
    var st: NselM = NselM_new(code.len());
    var err: str = nsel_exec_m(arch, & code, & mut regs, & mut st);
    if err != "" {
        return "call: " + err;
    }
    if st.call_at < 0 {
        return "call: the run reached no call";
    }
    if st.call_to != target {
        return "call: to byte " + int_to_str(st.call_to) + ", want " + int_to_str(target);
    }
    if st.call_regs.get(sp) != spv {
        return "call: the stack pointer moved";
    }
    i = 0;
    while i < want_r.len() {
        if st.call_regs.get(want_r.get(i)) != want_v.get(i) {
            return "call: argument " + int_to_str(i) + " in register " + int_to_str(want_r.get(i)) + " is " + int_to_str(st.call_regs.get(want_r.get(i))) + ", want " + int_to_str(want_v.get(i));
        }
        i = i + 1;
    }
    i = 0;
    while i < want_s.len() {
        var sv: i64 = nsel_mem_rd(& st, spv + 8 * i, 8);
        if sv != want_s.get(i) {
            return "call: stack argument " + int_to_str(i) + " is " + int_to_str(sv) + ", want " + int_to_str(want_s.get(i));
        }
        i = i + 1;
    }
    return "";
}
