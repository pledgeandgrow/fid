// build_info.fd -- what `fid version` names as the exact build (release N12).
//
// The version (fid_version, below) is "<fid_version_base>+dev" unless a
// release build wrote fid_build_release.
//
// The two values are constants compiled into fid. In the source they are
// empty: a development build names itself by the hash of its executable
// (main.fd fid_build_id). `scripts/build-info.sh` writes the commit and the
// date in before a release build (RELEASE=1 scripts/bootstrap.sh) and
// `scripts/build-info.sh --reset` puts the empty values back after it, so
// the tree is left as it was. Every stage of a bootstrap reads the same
// file, so the fixpoint still holds.

module compiler::build_info; use core;

/// N12: the version the next release grows from, set by hand when a
/// release is tagged (tag v<this>). A development build calls itself
/// "<this>+dev" (fid_version).
pub fn fid_version_base() -> str {
    return "1.0.0";
}

/// N12: the exact version of a release build ("" in a development build):
/// `scripts/build-info.sh` writes it from FIDES_VERSION, a VERSION file at
/// the repository root, or a tag v<version> on the commit built, and
/// `--reset` empties it again.
pub fn fid_build_release() -> str {
    return "";
}

/// N12: the version every place names: `fid version`, `fid --version`,
/// crash reports. The release version when there is one, else
/// "<base>+dev".
pub fn fid_version() -> str {
    var rel: str = fid_build_release();
    if str_len(rel) > 0 {
        return rel;
    }
    return fid_version_base() + "+dev";
}

/// D9 (release-roadmap): a hash of the source fid was built from (every
/// .fd file of compiler/ but this one, and of stdlib/), "" in a
/// development build. `scripts/build-info.sh` writes it. When it is set,
/// inc.fd inc_compiler_hash (what every build cache is keyed on) is this
/// hash with the executable's size, instead of a hash of the whole
/// executable's bytes (a 50 MB read on every command).
pub fn fid_build_source() -> str {
    return "";
}

/// The commit fid was built from ("" in a development build).
pub fn fid_build_commit() -> str {
    return "";
}

/// The date (UTC, YYYY-MM-DD) of that build ("" in a development build).
pub fn fid_build_date() -> str {
    return "";
}
