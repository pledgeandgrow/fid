// --- BRK ---

pub fn Arm64Assembler_enc_brk(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() == 0 { return ResultArm64EncodedInst::Err("BRK needs 1 operand"); }
    var imm: i64 = arm64_strip_hash(ops.get(0));
    var inst: i64 = 0xD4200000 | ((imm & 0xFFFF) << 5);
    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
}

// --- SCVTF ---

pub fn Arm64Assembler_enc_scvtf(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("SCVTF needs 2 operands"); }
    match parse_float_reg(ops.get(0)) {
        ResultI64Str::Ok(rd) => {
            match parse_reg(ops.get(1)) {
                ResultI64Str::Ok(rn) => {
                    var inst: i64 = 0x9E620000 | (rn << 5) | rd;
                    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("SCVTF parse error");
}

// --- FCVTZS ---

pub fn Arm64Assembler_enc_fcvtzs(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("FCVTZS needs 2 operands"); }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rd) => {
            match parse_float_reg(ops.get(1)) {
                ResultI64Str::Ok(rn) => {
                    var inst: i64 = 0x9E380000 | (rn << 5) | rd;
                    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("FCVTZS parse error");
}

// --- ADRP ---

pub fn Arm64Assembler_enc_adrp(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("ADRP needs 2 operands"); }
    var sf: i64 = 1;
    if !is_64bit_reg(ops.get(0)) { sf = 0; }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rd) => {
            var label: str = ops.get(1);
            var inst: i64 = (sf << 31) | 0x90000000 | rd;
            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_with_reloc(inst, label, 14));
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("ADRP parse error");
}

// --- SXTW ---

pub fn Arm64Assembler_enc_sxtw(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("SXTW needs 2 operands"); }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rd) => {
            match parse_reg(ops.get(1)) {
                ResultI64Str::Ok(rn) => {
                    var inst: i64 = 0xD3407C00 | (rn << 5) | rd;
                    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("SXTW parse error");
}

// ===========================================================================
// Helper types and functions
// ===========================================================================

/// Result of parsing STP/LDP operands.
pub enum Arm64StpLdpResult {
    Ok(str, str, str, i64, StpLdpMode),
    Err(str),
}

/// Result of parsing a memory operand.
pub enum Arm64MemOperand {
    Ok(str, i64),
    Err(str),
}

pub fn arm64_parse_stp_ldp_operands(ops: Vec<str>) -> Arm64StpLdpResult {
    if ops.len() < 3 { return Arm64StpLdpResult::Err("STP/LDP needs at least 3 operands"); }
    var rt1: str = ops.get(0);
    var rt2: str = ops.get(1);
    var mem: str = str_trim(ops.get(2));

    if str_ends_with(mem, "!") {
        // Pre-index: [Xn, #imm]!
        var inner: str = str_slice(mem, 1, str_len(mem) - 2); // strip [ and ]!
        var parts: Vec<str> = str_split(inner, ",");
        var rn: str = str_trim(parts.get(0));
        var imm: i64 = 0;
        if parts.len() > 1 {
            imm = arm64_strip_hash(str_trim(parts.get(1)));
        }
        return Arm64StpLdpResult::Ok(rt1, rt2, rn, imm, StpLdpMode::PreIndex);
    }
    if ops.len() > 3 {
        // Post-index: [Xn], #imm
        var rn: str = str_trim(str_slice(mem, 1, str_len(mem) - 1)); // strip [ and ]
        var imm: i64 = arm64_strip_hash(str_trim(ops.get(3)));
        return Arm64StpLdpResult::Ok(rt1, rt2, rn, imm, StpLdpMode::PostIndex);
    }
    // Signed offset: [Xn, #imm] or [Xn]
    var inner: str = str_slice(mem, 1, str_len(mem) - 1); // strip [ and ]
    var parts: Vec<str> = str_split(inner, ",");
    var rn: str = str_trim(parts.get(0));
    var imm: i64 = 0;
    if parts.len() > 1 {
        imm = arm64_strip_hash(str_trim(parts.get(1)));
    }
    return Arm64StpLdpResult::Ok(rt1, rt2, rn, imm, StpLdpMode::SignedOffset);
}

pub fn arm64_parse_mem_operand(s: str) -> Arm64MemOperand {
    var t: str = str_trim(s);
    if !str_starts_with(t, "[") || !str_ends_with(t, "]") {
        return Arm64MemOperand::Err("Invalid memory operand: " + t);
    }
    var inner: str = str_slice(t, 1, str_len(t) - 1);
    var parts: Vec<str> = str_split(inner, ",");
    var rn: str = str_trim(parts.get(0));
    var imm: i64 = 0;
    if parts.len() > 1 {
        imm = arm64_strip_hash(str_trim(parts.get(1)));
    }
    return Arm64MemOperand::Ok(rn, imm);
}

/// Strip leading '#' from an immediate string and parse as integer.
pub fn arm64_strip_hash(s: str) -> i64 {
    var t: str = str_trim(s);
    if str_starts_with(t, "#") {
        return str_parse_int(str_slice(t, 1, str_len(t)));
    }
    return str_parse_int(t);
}

/// Split a line into mnemonic and rest (operands string).
pub fn arm64_split_mnemonic(line: str) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var pos: i64 = 0;
    while pos < str_len(line) {
        var c: i64 = str_byte_at(line, pos);
        if c == 32 || c == 9 { // space or tab
            break;
        }
        pos = pos + 1;
    }
    if pos < str_len(line) {
        result.push(str_slice(line, 0, pos));
        result.push(str_trim(str_slice(line, pos, str_len(line))));
    } else {
        result.push(line);
        result.push("");
    }
    return result;
}

/// Parse operands string into a Vec of individual operand strings.
/// Splits by comma, respecting brackets.
pub fn arm64_parse_operands(s: str) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    if str_len(s) == 0 { return result; }
    var current: str = "";
    var bracket_depth: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c == 91 { // [
            bracket_depth = bracket_depth + 1;
            current = current + char_to_str(c);
        } else if c == 93 { // ]
            bracket_depth = bracket_depth - 1;
            current = current + char_to_str(c);
        } else if c == 44 && bracket_depth == 0 { // comma
            result.push(str_trim(current));
            current = "";
        } else {
            current = current + char_to_str(c);
        }
        i = i + 1;
    }
    if str_len(str_trim(current)) > 0 {
        result.push(str_trim(current));
    }
    return result;
}

/// Decode escape sequences in a string literal.
pub fn arm64_decode_string(s: str) -> Vec<i64> {
    var result: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c == 92 { // backslash
            i = i + 1;
            if i < str_len(s) {
                var next: i64 = str_byte_at(s, i);
                if next == 110 { result.push(10); } // \n
                else if next == 116 { result.push(9); } // \t
                else if next == 114 { result.push(13); } // \r
                else if next == 48 { result.push(0); } // \0
                else if next == 92 { result.push(92); } // \\
                else if next == 34 { result.push(34); } // \"
                else if next == 39 { result.push(39); } // \'
                else { result.push(92); result.push(next); }
            } else {
                result.push(92);
            }
        } else {
            result.push(c);
        }
        i = i + 1;
    }
    return result;
}
