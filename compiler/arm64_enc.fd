// arm64_enc.fd -- ARM64 (AArch64) Instruction Encoder
// Ported from src/arm64_enc.rs (~1328 LOC)
//
// Assembles ARM64 assembly text into raw machine code bytes.
// All ARM64 instructions are fixed 4 bytes (little-endian).
//
// Supports the instruction subset produced by codegen_arm64.fd:
//   - Data processing: mov, add, sub, mul, sdiv, msub, and, orr, eor, lsl, asr, neg, mvn
//   - Compare: cmp (reg, imm)
//   - Conditional set: cset
//   - Load/Store: ldr, str, ldrb, strb
//   - Branches: b, bl, blr, b.cond, brk, ret
//   - Immediate: movz, movk
//   - Float: scvtf, fcvtzs
//   - Extend: sxtw
//   - Directives: .section, .globl, .asciz, .ascii, .quad, .byte, .align, labels
//
// Calling convention: AAPCS64
//   - Args: X0-X7, Return: X0
//   - Callee-saved: X19-X28, SP
//   - Stack 16-byte aligned
//
// Adaptations from Rust:
// 1. u32/u8/u64 -> i64 (Fides uses i64 for all integers; all constants fit)
// 2. Vec<u8> -> Vec<i64> (bytes stored as i64)
// 3. HashMap<String, u64> -> Vec-based label map
// 4. Result<T, String> -> custom result enums
// 5. inst.to_le_bytes() -> push_u32_le() helper
// 6. u32::from_le_bytes() -> read_u32_le() helper
// 7. s[1..].parse() -> str_parse_int(str_slice(...))
// 8. strip_prefix('#') -> manual check + slice
// 9. struct methods -> free functions with self param

module compiler::arm64_enc;

use core;
use vec;
use string;

// ===========================================================================
// Result types
// ===========================================================================

pub enum ResultI64Str {
    Ok(i64),
    Err(str),
}

pub enum ResultUnit {
    Ok,
    Err(str),
}

// ===========================================================================
// Public API types
// ===========================================================================

pub struct Arm64Symbol {
    pub name: str,
    pub offset: i64,
}

pub fn Arm64Symbol_new(name: str, offset: i64) -> Arm64Symbol {
    return Arm64Symbol { name: name, offset: offset };
}

pub struct Arm64Reloc {
    pub offset: i64,
    pub symbol: str,
    pub rtype: i64,
}

pub fn Arm64Reloc_new(offset: i64, symbol: str, rtype: i64) -> Arm64Reloc {
    return Arm64Reloc { offset: offset, symbol: symbol, rtype: rtype };
}

pub struct Arm64AssembleResult {
    pub text: Vec<i64>,
    pub symbols: Vec<Arm64Symbol>,
    pub relocations: Vec<Arm64Reloc>,
}

pub enum ResultArm64Assemble {
    Ok(Arm64AssembleResult),
    Err(str),
}

// ===========================================================================
// Arm64EncodedInst -- result of encoding a single instruction
// ===========================================================================

pub struct Arm64InstReloc {
    pub label: str,
    pub rtype: i64,
}

pub fn Arm64InstReloc_new(label: str, rtype: i64) -> Arm64InstReloc {
    return Arm64InstReloc { label: label, rtype: rtype };
}

pub struct Arm64EncodedInst {
    pub bytes: Vec<i64>,
    pub relocations: Vec<Arm64InstReloc>,
}

pub enum ResultArm64EncodedInst {
    Ok(Arm64EncodedInst),
    Err(str),
}

pub fn Arm64EncodedInst_bytes(inst: i64) -> Arm64EncodedInst {
    var bytes: Vec<i64> = Vec::new();
    push_u32_le(bytes, inst);
    return Arm64EncodedInst { bytes: bytes, relocations: Vec::new() };
}

pub fn Arm64EncodedInst_with_reloc(inst: i64, label: str, reloc_type: i64) -> Arm64EncodedInst {
    var bytes: Vec<i64> = Vec::new();
    push_u32_le(bytes, inst);
    var relocs: Vec<Arm64InstReloc> = Vec::new();
    relocs.push(Arm64InstReloc_new(label, reloc_type));
    return Arm64EncodedInst { bytes: bytes, relocations: relocs };
}

pub fn Arm64EncodedInst_multi(bytes: Vec<i64>) -> Arm64EncodedInst {
    return Arm64EncodedInst { bytes: bytes, relocations: Vec::new() };
}

// ===========================================================================
// Byte helpers
// ===========================================================================

/// Split a string into lines by newline (LF).
pub fn a64_str_lines(s: str) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var i: i64 = 0;
    var start: i64 = 0;
    while i < str_len(s) {
        var b: i64 = str_byte_at(s, i);
        if b == 10 {
            result.push(str_slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if start < str_len(s) {
        result.push(str_slice(s, start, str_len(s)));
    }
    return result;
}

/// Push a 32-bit value in little-endian byte order.
pub fn push_u32_le(text: &mut Vec<i64>, inst: i64) {
    text.push(inst & 0xFF);
    text.push((inst >> 8) & 0xFF);
    text.push((inst >> 16) & 0xFF);
    text.push((inst >> 24) & 0xFF);
}

/// Read a 32-bit little-endian value from a byte vector.
pub fn read_u32_le(text: Vec<i64>, idx: i64) -> i64 {
    return (text.get(idx) & 0xFF) | ((text.get(idx + 1) & 0xFF) << 8) | ((text.get(idx + 2) & 0xFF) << 16) | ((text.get(idx + 3) & 0xFF) << 24);
}

/// Patch a 32-bit little-endian value in a byte vector.
pub fn patch_u32_le(text: &mut Vec<i64>, idx: i64, inst: i64) {
    text.set(idx, inst & 0xFF);
    text.set(idx + 1, (inst >> 8) & 0xFF);
    text.set(idx + 2, (inst >> 16) & 0xFF);
    text.set(idx + 3, (inst >> 24) & 0xFF);
}

// ===========================================================================
// Public API
// ===========================================================================

/// Assemble ARM64 assembly text into machine code.
/// Returns (text_bytes, symbols, relocations).
pub fn assemble_arm64(asm: str) -> ResultArm64Assemble {
    var enc: Arm64Assembler = Arm64Assembler_new();
    match Arm64Assembler_assemble(enc, asm) {
        ResultUnit::Ok => {}
        ResultUnit::Err(e) => { return ResultArm64Assemble::Err(e); }
    }
    return ResultArm64Assemble::Ok(Arm64AssembleResult {
        text: enc.text,
        symbols: enc.symbols,
        relocations: enc.relocations,
    });
}

// ===========================================================================
// ARM64 Register encoding
// ===========================================================================

pub fn parse_reg(s: str) -> ResultI64Str {
    var t: str = str_trim(s);
    if str_equal(t, "sp") || str_equal(t, "SP") { return ResultI64Str::Ok(31); }
    if str_equal(t, "xzr") || str_equal(t, "XZR") || str_equal(t, "wzr") || str_equal(t, "WZR") { return ResultI64Str::Ok(31); }
    if str_starts_with(t, "x") || str_starts_with(t, "X") {
        var n: i64 = str_parse_int(str_slice(t, 1, str_len(t)));
        if n > 30 { return ResultI64Str::Err("Register out of range: " + t); }
        return ResultI64Str::Ok(n);
    }
    if str_starts_with(t, "w") || str_starts_with(t, "W") {
        var n: i64 = str_parse_int(str_slice(t, 1, str_len(t)));
        if n > 30 { return ResultI64Str::Err("Register out of range: " + t); }
        return ResultI64Str::Ok(n);
    }
    return ResultI64Str::Err("Unknown register: " + t);
}

pub fn is_64bit_reg(s: str) -> bool {
    return str_starts_with(s, "x") || str_starts_with(s, "X") || str_equal(s, "sp") || str_equal(s, "SP");
}

/// Condition codes for B.cond / CSET
pub fn parse_cond(s: str) -> ResultI64Str {
    if str_equal(s, "eq") { return ResultI64Str::Ok(0); }
    if str_equal(s, "ne") { return ResultI64Str::Ok(1); }
    if str_equal(s, "cs") || str_equal(s, "hs") { return ResultI64Str::Ok(2); }
    if str_equal(s, "cc") || str_equal(s, "lo") { return ResultI64Str::Ok(3); }
    if str_equal(s, "mi") { return ResultI64Str::Ok(4); }
    if str_equal(s, "pl") { return ResultI64Str::Ok(5); }
    if str_equal(s, "vs") { return ResultI64Str::Ok(6); }
    if str_equal(s, "vc") { return ResultI64Str::Ok(7); }
    if str_equal(s, "hi") { return ResultI64Str::Ok(8); }
    if str_equal(s, "ls") { return ResultI64Str::Ok(9); }
    if str_equal(s, "ge") { return ResultI64Str::Ok(10); }
    if str_equal(s, "lt") { return ResultI64Str::Ok(11); }
    if str_equal(s, "gt") { return ResultI64Str::Ok(12); }
    if str_equal(s, "le") { return ResultI64Str::Ok(13); }
    if str_equal(s, "al") { return ResultI64Str::Ok(14); }
    if str_equal(s, "nv") { return ResultI64Str::Ok(15); }
    return ResultI64Str::Err("Unknown condition: " + s);
}

pub fn parse_float_reg(s: str) -> ResultI64Str {
    var t: str = str_trim(s);
    if str_starts_with(t, "d") || str_starts_with(t, "D") {
        var n: i64 = str_parse_int(str_slice(t, 1, str_len(t)));
        if n > 31 { return ResultI64Str::Err("Register out of range: " + t); }
        return ResultI64Str::Ok(n);
    }
    if str_starts_with(t, "v") || str_starts_with(t, "V") {
        var n: i64 = str_parse_int(str_slice(t, 1, str_len(t)));
        if n > 31 { return ResultI64Str::Err("Register out of range: " + t); }
        return ResultI64Str::Ok(n);
    }
    return ResultI64Str::Err("Not a float register: " + t);
}

// ===========================================================================
// Assembler
// ===========================================================================

pub enum Arm64Section {
    Text,
    Rodata,
}

pub enum StpLdpMode {
    PreIndex,
    PostIndex,
    SignedOffset,
}

pub struct LabelOffsetEntry {
    pub label: str,
    pub offset: i64,
}

pub fn LabelOffsetEntry_new(label: str, offset: i64) -> LabelOffsetEntry {
    return LabelOffsetEntry { label: label, offset: offset };
}

pub struct Arm64Assembler {
    pub text: Vec<i64>,
    pub rodata: Vec<i64>,
    pub symbols: Vec<Arm64Symbol>,
    pub rodata_symbols: Vec<Arm64Symbol>,
    pub relocations: Vec<Arm64Reloc>,
    pub current_section: Arm64Section,
    pub pending_labels: Vec<str>,
    pub label_offsets: Vec<LabelOffsetEntry>,
    pub pending_branches: Vec<Arm64Reloc>,
}

pub fn Arm64Assembler_new() -> Arm64Assembler {
    return Arm64Assembler {
        text: Vec::new(),
        rodata: Vec::new(),
        symbols: Vec::new(),
        rodata_symbols: Vec::new(),
        relocations: Vec::new(),
        current_section: Arm64Section::Text,
        pending_labels: Vec::new(),
        label_offsets: Vec::new(),
        pending_branches: Vec::new(),
    };
}

// --- Label offset map helpers ---

pub fn label_offset_lookup(map: Vec<LabelOffsetEntry>, label: str) -> i64 {
    var i: i64 = 0;
    while i < map.len() {
        if str_equal(map.get(i).label, label) { return map.get(i).offset; }
        i = i + 1;
    }
    return -1;
}

pub fn label_offset_insert(map: &mut Vec<LabelOffsetEntry>, label: str, offset: i64) {
    map.push(LabelOffsetEntry_new(label, offset));
}

// --- Assemble ---

pub fn Arm64Assembler_assemble(self: &mut Arm64Assembler, asm: str) -> ResultUnit {
    var lines: Vec<str> = a64_str_lines(asm);
    var li: i64 = 0;
    while li < lines.len() {
        var line: str = str_trim(lines.get(li));
        if str_len(line) == 0 || str_starts_with(line, "//") || str_starts_with(line, "#") {
            li = li + 1;
            continue;
        }

        // Handle labels (end with : and don't start with space)
        if str_ends_with(line, ":") && !str_starts_with(line, " ") {
            var label: str = str_trim(str_slice(line, 0, str_len(line) - 1));
            Arm64Assembler_define_label(self, label);
            li = li + 1;
            continue;
        }

        // Handle directives
        if str_starts_with(line, ".") {
            match Arm64Assembler_handle_directive(self, line) {
                ResultUnit::Ok => {}
                ResultUnit::Err(e) => { return ResultUnit::Err(e); }
            }
            li = li + 1;
            continue;
        }

        // Strip inline comments (// ...)
        var inst_line: str = line;
        var cpos: i64 = str_find(line, "//");
        if cpos >= 0 {
            inst_line = str_trim(str_slice(line, 0, cpos));
        }
        if str_len(inst_line) == 0 { li = li + 1; continue; }

        match Arm64Assembler_handle_instruction(self, inst_line) {
            ResultUnit::Ok => {}
            ResultUnit::Err(e) => { return ResultUnit::Err(e); }
        }
        li = li + 1;
    }

    // Resolve pending branches
    match Arm64Assembler_resolve_branches(self) {
        ResultUnit::Ok => {}
        ResultUnit::Err(e) => { return ResultUnit::Err(e); }
    }
    return ResultUnit::Ok;
}

pub fn Arm64Assembler_define_label(self: &mut Arm64Assembler, label: str) {
    match self.current_section {
        Arm64Section::Text => {
            var offset: i64 = self.text.len();
            label_offset_insert(self.label_offsets, label, offset);
            self.symbols.push(Arm64Symbol_new(label, offset));
        }
        Arm64Section::Rodata => {
            var offset: i64 = self.rodata.len();
            self.rodata_symbols.push(Arm64Symbol_new(label, offset));
        }
    }
}

pub fn Arm64Assembler_handle_directive(self: &mut Arm64Assembler, line: str) -> ResultUnit {
    var parts: Vec<str> = str_split(line, " ");
    var directive: str = parts.get(0);
    if str_equal(directive, ".section") {
        if parts.len() > 1 && str_contains(parts.get(1), ".rodata") {
            self.current_section = Arm64Section::Rodata;
        } else {
            self.current_section = Arm64Section::Text;
        }
    } else if str_equal(directive, ".globl") || str_equal(directive, ".global") {
        // Mark as global — we already add all labels to symbols
    } else if str_equal(directive, ".asciz") {
        // .asciz "string" — null-terminated string
        if parts.len() > 1 {
            var s: str = str_trim(parts.get(1));
            if str_starts_with(s, "\"") && str_ends_with(s, "\"") {
                var content: str = str_slice(s, 1, str_len(s) - 1);
                var decoded: Vec<i64> = arm64_decode_string(content);
                var di: i64 = 0;
                while di < decoded.len() { self.rodata.push(decoded.get(di)); di = di + 1; }
                self.rodata.push(0); // null terminator
            }
        }
    } else if str_equal(directive, ".ascii") {
        // .ascii "string" — no null terminator
        if parts.len() > 1 {
            var s: str = str_trim(parts.get(1));
            if str_starts_with(s, "\"") && str_ends_with(s, "\"") {
                var content: str = str_slice(s, 1, str_len(s) - 1);
                var decoded: Vec<i64> = arm64_decode_string(content);
                var di: i64 = 0;
                while di < decoded.len() { self.rodata.push(decoded.get(di)); di = di + 1; }
            }
        }
    } else if str_equal(directive, ".quad") {
        // .quad value — 8-byte value
        if parts.len() > 1 {
            var qv: i64 = str_parse_int(str_trim(parts.get(1)));
            push_u32_le(self.rodata, qv & 0xFFFFFFFF);
            push_u32_le(self.rodata, (qv >> 32) & 0xFFFFFFFF);
        }
    } else if str_equal(directive, ".byte") {
        if parts.len() > 1 {
            var bv: i64 = str_parse_int(str_trim(parts.get(1)));
            self.rodata.push(bv & 0xFF);
        }
    } else if str_equal(directive, ".align") || str_equal(directive, ".p2align") {
        // Align to power of 2
        if parts.len() > 1 {
            var n: i64 = str_parse_int(str_trim(parts.get(1)));
            var align: i64 = 1;
            var ai: i64 = 0;
            while ai < n { align = align * 2; ai = ai + 1; }
            match self.current_section {
                Arm64Section::Text => {
                    while self.text.len() % align != 0 { self.text.push(0); }
                }
                Arm64Section::Rodata => {
                    while self.rodata.len() % align != 0 { self.rodata.push(0); }
                }
            }
        }
    }
    // Ignore unknown directives
    return ResultUnit::Ok;
}

pub fn Arm64Assembler_handle_instruction(self: &mut Arm64Assembler, line: str) -> ResultUnit {
    // Only encode in text section
    match self.current_section {
        Arm64Section::Text => {}
        Arm64Section::Rodata => { return ResultUnit::Ok; }
    }

    match Arm64Assembler_encode_instruction(self, line) {
        ResultArm64EncodedInst::Ok(encoded) => {
            var offset: i64 = self.text.len();
            var ri: i64 = 0;
            while ri < encoded.relocations.len() {
                var rel: Arm64InstReloc = encoded.relocations.get(ri);
                self.pending_branches.push(Arm64Reloc_new(offset, rel.label, rel.rtype));
                ri = ri + 1;
            }
            var bi: i64 = 0;
            while bi < encoded.bytes.len() {
                self.text.push(encoded.bytes.get(bi));
                bi = bi + 1;
            }
        }
        ResultArm64EncodedInst::Err(e) => { return ResultUnit::Err(e); }
    }
    return ResultUnit::Ok;
}

pub fn Arm64Assembler_resolve_branches(self: &mut Arm64Assembler) -> ResultUnit {
    var i: i64 = 0;
    while i < self.pending_branches.len() {
        var pb: Arm64Reloc = self.pending_branches.get(i);
        var target_offset: i64 = label_offset_lookup(self.label_offsets, pb.symbol);
        if target_offset >= 0 {
            var delta: i64 = target_offset - pb.offset;
            var idx: i64 = pb.offset;
            if idx + 4 <= self.text.len() {
                var instr: i64 = read_u32_le(self.text, idx);
                if pb.rtype == 10 {
                    // BL: 26-bit immediate, offset = delta/4
                    var imm26: i64 = (delta / 4) & 0x03FFFFFF;
                    var patched: i64 = (instr & 0xFC000000) | imm26;
                    patch_u32_le(self.text, idx, patched);
                } else if pb.rtype == 11 {
                    // B: 26-bit immediate
                    var imm26: i64 = (delta / 4) & 0x03FFFFFF;
                    var patched: i64 = (instr & 0xFC000000) | imm26;
                    patch_u32_le(self.text, idx, patched);
                } else if pb.rtype == 12 {
                    // B.cond: 19-bit immediate
                    var imm19: i64 = (delta / 4) & 0x0007FFFF;
                    var patched: i64 = (instr & 0xFF00001F) | (imm19 << 5);
                    patch_u32_le(self.text, idx, patched);
                }
            }
        } else {
            // External symbol — add to relocations for linker
            self.relocations.push(Arm64Reloc_new(pb.offset, pb.symbol, pb.rtype));
        }
        i = i + 1;
    }
    return ResultUnit::Ok;
}

// ===========================================================================
// Instruction encoding
// ===========================================================================

pub fn Arm64Assembler_encode_instruction(self: &Arm64Assembler, line: str) -> ResultArm64EncodedInst {
    var t: str = str_trim(line);
    var split: Vec<str> = arm64_split_mnemonic(t);
    var mnemonic: str = split.get(0);
    var rest: str = split.get(1);
    var operands: Vec<str> = arm64_parse_operands(rest);

    // Handle b.cond (b.eq, b.ne, b.gt, etc.)
    if str_starts_with(mnemonic, "b.") {
        var cond: str = str_slice(mnemonic, 2, str_len(mnemonic));
        return Arm64Assembler_enc_bcond(self, cond, operands);
    }

    if str_equal(mnemonic, "stp") { return Arm64Assembler_enc_stp(self, operands); }
    if str_equal(mnemonic, "ldp") { return Arm64Assembler_enc_ldp(self, operands); }
    if str_equal(mnemonic, "mov") { return Arm64Assembler_enc_mov(self, operands); }
    if str_equal(mnemonic, "movz") { return Arm64Assembler_enc_movz(self, operands); }
    if str_equal(mnemonic, "movk") { return Arm64Assembler_enc_movk(self, operands); }
    if str_equal(mnemonic, "add") { return Arm64Assembler_enc_add(self, operands); }
    if str_equal(mnemonic, "sub") { return Arm64Assembler_enc_sub(self, operands); }
    if str_equal(mnemonic, "mul") { return Arm64Assembler_enc_mul(self, operands); }
    if str_equal(mnemonic, "sdiv") { return Arm64Assembler_enc_sdiv(self, operands); }
    if str_equal(mnemonic, "udiv") { return Arm64Assembler_enc_udiv(self, operands); }
    if str_equal(mnemonic, "msub") { return Arm64Assembler_enc_msub(self, operands); }
    if str_equal(mnemonic, "neg") { return Arm64Assembler_enc_neg(self, operands); }
    if str_equal(mnemonic, "and") { return Arm64Assembler_enc_and(self, operands); }
    if str_equal(mnemonic, "orr") { return Arm64Assembler_enc_orr(self, operands); }
    if str_equal(mnemonic, "eor") { return Arm64Assembler_enc_eor(self, operands); }
    if str_equal(mnemonic, "mvn") { return Arm64Assembler_enc_mvn(self, operands); }
    if str_equal(mnemonic, "lsl") { return Arm64Assembler_enc_lsl(self, operands); }
    if str_equal(mnemonic, "asr") { return Arm64Assembler_enc_asr(self, operands); }
    if str_equal(mnemonic, "cmp") { return Arm64Assembler_enc_cmp(self, operands); }
    if str_equal(mnemonic, "cset") { return Arm64Assembler_enc_cset(self, operands); }
    if str_equal(mnemonic, "ldr") { return Arm64Assembler_enc_ldr(self, operands); }
    if str_equal(mnemonic, "str") { return Arm64Assembler_enc_str(self, operands); }
    if str_equal(mnemonic, "ldrb") { return Arm64Assembler_enc_ldrb(self, operands); }
    if str_equal(mnemonic, "strb") { return Arm64Assembler_enc_strb(self, operands); }
    if str_equal(mnemonic, "b") { return Arm64Assembler_enc_b(self, operands); }
    if str_equal(mnemonic, "bl") { return Arm64Assembler_enc_bl(self, operands); }
    if str_equal(mnemonic, "blr") { return Arm64Assembler_enc_blr(self, operands); }
    if str_equal(mnemonic, "br") { return Arm64Assembler_enc_br(self, operands); }
    if str_equal(mnemonic, "ret") { return Arm64Assembler_enc_ret(self, operands); }
    if str_equal(mnemonic, "brk") { return Arm64Assembler_enc_brk(self, operands); }
    if str_equal(mnemonic, "svc") { return Arm64Assembler_enc_svc(self, operands); }
    if str_equal(mnemonic, "scvtf") { return Arm64Assembler_enc_scvtf(self, operands); }
    if str_equal(mnemonic, "fcvtzs") { return Arm64Assembler_enc_fcvtzs(self, operands); }
    if str_equal(mnemonic, "sxtw") { return Arm64Assembler_enc_sxtw(self, operands); }
    if str_equal(mnemonic, "adrp") { return Arm64Assembler_enc_adrp(self, operands); }
    if str_equal(mnemonic, "nop") { return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(0xD503201F)); }
    return ResultArm64EncodedInst::Err("Unknown ARM64 instruction: " + mnemonic);
}

// --- STP ---

pub fn Arm64Assembler_enc_stp(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    var parsed: Arm64StpLdpResult = arm64_parse_stp_ldp_operands(ops);
    match parsed {
        Arm64StpLdpResult::Err(e) => { return ResultArm64EncodedInst::Err(e); }
        Arm64StpLdpResult::Ok(rt1, rt2, rn, imm, mode) => {
            var sf: i64 = 1;
            if !is_64bit_reg(ops.get(0)) { sf = 0; }
            var imm7: i64 = (imm / 8) & 0x7F;
            match parse_reg(rt1) {
                ResultI64Str::Ok(rt1n) => {
                    match parse_reg(rt2) {
                        ResultI64Str::Ok(rt2n) => {
                            match parse_reg(rn) {
                                ResultI64Str::Ok(rnn) => {
                                    var opcode: i64 = 0;
                                    match mode {
                                        StpLdpMode::PreIndex => { if sf == 1 { opcode = 0xA9800000; } else { opcode = 0x29800000; } }
                                        StpLdpMode::PostIndex => { if sf == 1 { opcode = 0xA8800000; } else { opcode = 0x28800000; } }
                                        StpLdpMode::SignedOffset => { if sf == 1 { opcode = 0xA9000000; } else { opcode = 0x29000000; } }
                                    }
                                    var inst: i64 = opcode | (imm7 << 15) | (rt2n << 10) | (rnn << 5) | rt1n;
                                    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                                }
                                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                            }
                        }
                        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                    }
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
    }
    return ResultArm64EncodedInst::Err("STP parse error");
}

// --- LDP ---

pub fn Arm64Assembler_enc_ldp(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    var parsed: Arm64StpLdpResult = arm64_parse_stp_ldp_operands(ops);
    match parsed {
        Arm64StpLdpResult::Err(e) => { return ResultArm64EncodedInst::Err(e); }
        Arm64StpLdpResult::Ok(rt1, rt2, rn, imm, mode) => {
            var sf: i64 = 1;
            if !is_64bit_reg(ops.get(0)) { sf = 0; }
            var imm7: i64 = (imm / 8) & 0x7F;
            match parse_reg(rt1) {
                ResultI64Str::Ok(rt1n) => {
                    match parse_reg(rt2) {
                        ResultI64Str::Ok(rt2n) => {
                            match parse_reg(rn) {
                                ResultI64Str::Ok(rnn) => {
                                    var opcode: i64 = 0;
                                    match mode {
                                        StpLdpMode::PreIndex => { if sf == 1 { opcode = 0xA9C00000; } else { opcode = 0x29C00000; } }
                                        StpLdpMode::PostIndex => { if sf == 1 { opcode = 0xA8C00000; } else { opcode = 0x28C00000; } }
                                        StpLdpMode::SignedOffset => { if sf == 1 { opcode = 0xA9400000; } else { opcode = 0x29400000; } }
                                    }
                                    var inst: i64 = opcode | (imm7 << 15) | (rt2n << 10) | (rnn << 5) | rt1n;
                                    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                                }
                                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                            }
                        }
                        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                    }
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
    }
    return ResultArm64EncodedInst::Err("LDP parse error");
}

// --- MOV ---

pub fn Arm64Assembler_enc_mov(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("MOV needs 2 operands"); }
    var dst: str = ops.get(0);
    var src: str = ops.get(1);

    // MOV reg, #imm -> MOVZ
    if str_starts_with(src, "#") {
        var imm: i64 = str_parse_int(str_slice(src, 1, str_len(src)));
        return Arm64Assembler_emit_movz_imm(self, dst, imm);
    }

    // MOV reg, reg -> ORR reg, XZR, reg
    var sf: i64 = 1;
    if !is_64bit_reg(dst) { sf = 0; }
    match parse_reg(dst) {
        ResultI64Str::Ok(rd) => {
            match parse_reg(src) {
                ResultI64Str::Ok(rm) => {
                    var base: i64 = 0xAA0003E0;
                    if sf == 0 { base = 0x2A0003E0; }
                    var inst: i64 = base | (rm << 16) | rd;
                    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("MOV parse error");
}

pub fn Arm64Assembler_emit_movz_imm(self: &Arm64Assembler, dst: str, imm: i64) -> ResultArm64EncodedInst {
    var sf: i64 = 1;
    if !is_64bit_reg(dst) { sf = 0; }
    match parse_reg(dst) {
        ResultI64Str::Ok(rd) => {
            var base: i64 = 0xD2800000;
            if sf == 0 { base = 0x52800000; }
            var movk_base: i64 = 0xF2800000;
            if sf == 0 { movk_base = 0x72800000; }
            // For small immediates (0-65535), use MOVZ with shift=0
            if imm >= 0 && imm <= 0xFFFF {
                var inst: i64 = base | ((imm & 0xFFFF) << 5) | rd;
                return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
            }
            // For larger, emit MOVZ + MOVK sequence
            var bytes: Vec<i64> = Vec::new();
            var v: i64 = imm;
            // MOVZ Xd, #(v & 0xFFFF)
            var inst1: i64 = base | ((v & 0xFFFF) << 5) | rd;
            push_u32_le(bytes, inst1);
            // MOVK Xd, #((v >> 16) & 0xFFFF), lsl #16
            if v > 0xFFFF || v < 0 {
                var inst2: i64 = movk_base | (1 << 21) | (((v >> 16) & 0xFFFF) << 5) | rd;
                push_u32_le(bytes, inst2);
            }
            // MOVK Xd, #((v >> 32) & 0xFFFF), lsl #32
            if v > 0xFFFFFFFF || v < 0 {
                var inst3: i64 = movk_base | (2 << 21) | (((v >> 32) & 0xFFFF) << 5) | rd;
                push_u32_le(bytes, inst3);
            }
            // MOVK Xd, #((v >> 48) & 0xFFFF), lsl #48
            if v > 0xFFFFFFFFFFFF || v < 0 {
                var inst4: i64 = movk_base | (3 << 21) | (((v >> 48) & 0xFFFF) << 5) | rd;
                push_u32_le(bytes, inst4);
            }
            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_multi(bytes));
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("MOVZ parse error");
}

pub fn Arm64Assembler_enc_movz(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    return Arm64Assembler_enc_movz_impl(self, ops);
}

pub fn Arm64Assembler_enc_movz_impl(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("MOVZ needs 2 operands"); }
    var dst: str = ops.get(0);
    var imm_str: str = ops.get(1);
    var imm_val: i64 = arm64_strip_hash(imm_str);
    var imm: i64 = imm_val;
    var shift: i64 = 0;
    if ops.len() > 3 {
        shift = arm64_strip_hash(ops.get(3));
    }
    var sf: i64 = 1;
    if !is_64bit_reg(dst) { sf = 0; }
    match parse_reg(dst) {
        ResultI64Str::Ok(rd) => {
            var hw: i64 = shift / 16;
            var base: i64 = 0xD2800000;
            if sf == 0 { base = 0x52800000; }
            var inst: i64 = base | (hw << 21) | ((imm & 0xFFFF) << 5) | rd;
            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("MOVZ parse error");
}

pub fn Arm64Assembler_enc_movk(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("MOVK needs 2 operands"); }
    var dst: str = ops.get(0);
    var imm_str: str = ops.get(1);
    var imm: i64 = arm64_strip_hash(imm_str);
    var shift: i64 = 0;
    if ops.len() > 3 {
        shift = arm64_strip_hash(ops.get(3));
    }
    var sf: i64 = 1;
    if !is_64bit_reg(dst) { sf = 0; }
    match parse_reg(dst) {
        ResultI64Str::Ok(rd) => {
            var hw: i64 = shift / 16;
            var base: i64 = 0xF2800000;
            if sf == 0 { base = 0x72800000; }
            var inst: i64 = base | (hw << 21) | ((imm & 0xFFFF) << 5) | rd;
            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("MOVK parse error");
}

// --- ADD ---

pub fn Arm64Assembler_enc_add(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 3 { return ResultArm64EncodedInst::Err("ADD needs 3 operands"); }
    var dst: str = ops.get(0);
    var rn_str: str = ops.get(1);
    var rm_str: str = ops.get(2);
    var sf: i64 = 1;
    if !is_64bit_reg(dst) { sf = 0; }
    match parse_reg(dst) {
        ResultI64Str::Ok(rd) => {
            match parse_reg(rn_str) {
                ResultI64Str::Ok(rn) => {
                    // Check for :lo12: prefix
                    if str_starts_with(rm_str, ":lo12:") {
                        var label: str = str_slice(rm_str, 6, str_len(rm_str));
                        var inst: i64 = (sf << 31) | 0x11000000 | (rn << 5) | rd;
                        return ResultArm64EncodedInst::Ok(Arm64EncodedInst_with_reloc(inst, label, 15));
                    }
                    if str_starts_with(rm_str, "#") {
                        var imm: i64 = str_parse_int(str_slice(rm_str, 1, str_len(rm_str)));
                        var inst: i64 = (sf << 31) | 0x11000000 | ((imm & 0xFFF) << 10) | (rn << 5) | rd;
                        return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                    }
                    match parse_reg(rm_str) {
                        ResultI64Str::Ok(rm) => {
                            var inst: i64 = (sf << 31) | 0x0B000000 | (rm << 16) | (rn << 5) | rd;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                    }
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("ADD parse error");
}

// --- SUB ---

pub fn Arm64Assembler_enc_sub(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 3 { return ResultArm64EncodedInst::Err("SUB needs 3 operands"); }
    var dst: str = ops.get(0);
    var rn_str: str = ops.get(1);
    var rm_str: str = ops.get(2);
    var sf: i64 = 1;
    if !is_64bit_reg(dst) { sf = 0; }
    match parse_reg(dst) {
        ResultI64Str::Ok(rd) => {
            match parse_reg(rn_str) {
                ResultI64Str::Ok(rn) => {
                    if str_starts_with(rm_str, "#") {
                        var imm: i64 = str_parse_int(str_slice(rm_str, 1, str_len(rm_str)));
                        var inst: i64 = (sf << 31) | 0x51000000 | ((imm & 0xFFF) << 10) | (rn << 5) | rd;
                        return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                    }
                    match parse_reg(rm_str) {
                        ResultI64Str::Ok(rm) => {
                            var inst: i64 = (sf << 31) | 0x4B000000 | (rm << 16) | (rn << 5) | rd;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                    }
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("SUB parse error");
}

