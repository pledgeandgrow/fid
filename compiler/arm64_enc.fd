                                    var inst: i64 = (sf << 31) | 0x1B008000 | (rm << 16) | (ra << 10) | (rn << 5) | rd;
                                    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                                }
                                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
