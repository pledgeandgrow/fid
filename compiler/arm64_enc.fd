// --- AND ---

pub fn Arm64Assembler_enc_and(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 3 { return ResultArm64EncodedInst::Err("AND needs 3 operands"); }
    var sf: i64 = 1;
    if !is_64bit_reg(ops.get(0)) { sf = 0; }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rd) => {
            match parse_reg(ops.get(1)) {
                ResultI64Str::Ok(rn) => {
                    if str_starts_with(ops.get(2), "#") {
                        var imm_str: str = str_slice(ops.get(2), 1, str_len(ops.get(2)));
                        if str_equal(imm_str, "0xFFFFFFFFFFFFF000") {
                            var n: i64 = 1;
                            var immr: i64 = 12;
                            var imms: i64 = 63;
                            var inst: i64 = (sf << 31) | (n << 22) | (immr << 16) | (imms << 10) | (rn << 5) | rd;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        return ResultArm64EncodedInst::Err("AND with immediate " + ops.get(2) + " not supported");
                    }
                    match parse_reg(ops.get(2)) {
                        ResultI64Str::Ok(rm) => {
                            var inst: i64 = (sf << 31) | 0x0A000000 | (rm << 16) | (rn << 5) | rd;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                    }
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("AND parse error");
}

