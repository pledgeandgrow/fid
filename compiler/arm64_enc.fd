// --- LSL ---

pub fn Arm64Assembler_enc_lsl(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 3 { return ResultArm64EncodedInst::Err("LSL needs 3 operands"); }
    var sf: i64 = 1;
    if !is_64bit_reg(ops.get(0)) { sf = 0; }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rd) => {
            match parse_reg(ops.get(1)) {
                ResultI64Str::Ok(rn) => {
                    if str_starts_with(ops.get(2), "#") {
                        var shift: i64 = str_parse_int(str_slice(ops.get(2), 1, str_len(ops.get(2))));
                        if sf == 1 {
                            var immr: i64 = (64 - shift) % 64;
                            var imms: i64 = 63 - shift;
                            var inst: i64 = 0xD3400000 | (imms << 16) | (immr << 6) | (rn << 5) | rd;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        var immr32: i64 = (32 - shift) % 32;
                        var imms32: i64 = 31 - shift;
                        var inst32: i64 = 0x53000000 | (imms32 << 16) | (immr32 << 6) | (rn << 5) | rd;
                        return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst32));
                    }
                    match parse_reg(ops.get(2)) {
                        ResultI64Str::Ok(rm) => {
                            var inst: i64 = (sf << 31) | 0x1AC02000 | (rm << 16) | (rn << 5) | rd;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                    }
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("LSL parse error");
}

// --- ASR ---

pub fn Arm64Assembler_enc_asr(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 3 { return ResultArm64EncodedInst::Err("ASR needs 3 operands"); }
    var sf: i64 = 1;
    if !is_64bit_reg(ops.get(0)) { sf = 0; }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rd) => {
            match parse_reg(ops.get(1)) {
                ResultI64Str::Ok(rn) => {
                    if str_starts_with(ops.get(2), "#") {
                        var shift: i64 = str_parse_int(str_slice(ops.get(2), 1, str_len(ops.get(2))));
                        // ASR Xd, Xn, #shift → SBFM Xd, Xn, #shift, #(63 or 31)
                        if sf == 1 {
                            // 64-bit: 0xD3400000 | (63 << 16) | (shift << 6) | (rn << 5) | rd
                            var inst: i64 = 0xD3400000 | (63 << 16) | (shift << 6) | (rn << 5) | rd;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        // 32-bit: 0x13000000 | (31 << 16) | (shift << 6) | (rn << 5) | rd
                        var inst32: i64 = 0x13000000 | (31 << 16) | (shift << 6) | (rn << 5) | rd;
                        return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst32));
                    }
                    match parse_reg(ops.get(2)) {
                        ResultI64Str::Ok(rm) => {
                            var inst: i64 = (sf << 31) | 0x1AC02800 | (rm << 16) | (rn << 5) | rd;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                    }
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("ASR parse error");
}

// --- CMP (SUBS XZR, Xn, #imm) ---

pub fn Arm64Assembler_enc_cmp(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("CMP needs 2 operands"); }
    var sf: i64 = 1;
    if !is_64bit_reg(ops.get(0)) { sf = 0; }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rn) => {
            if str_starts_with(ops.get(1), "#") {
                var imm: i64 = str_parse_int(str_slice(ops.get(1), 1, str_len(ops.get(1))));
                // SUBS XZR, Xn, #imm: base 0x7100003F (Rd=31, matches Rust source)
                var inst: i64 = (sf << 31) | 0x7100003F | ((imm & 0xFFF) << 10) | (rn << 5);
                return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
            }
            match parse_reg(ops.get(1)) {
                ResultI64Str::Ok(rm) => {
                    var inst: i64 = (sf << 31) | 0x6B00001F | (rm << 16) | (rn << 5);
                    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("CMP parse error");
}

// --- CSET (CSINC Xd, XZR, XZR, invert(cond)) ---

pub fn Arm64Assembler_enc_cset(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("CSET needs 2 operands"); }
    var sf: i64 = 1;
    if !is_64bit_reg(ops.get(0)) { sf = 0; }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rd) => {
            match parse_cond(ops.get(1)) {
                ResultI64Str::Ok(cond) => {
                    // CSET = CSINC Xd, XZR, XZR, invert(cond)
                    // 64-bit: 0x9A9F07E0 | (inv_cond << 12) | rd
                    // 32-bit: 0x1A9F07E0 | (inv_cond << 12) | rd
                    var inv: i64 = cond ^ 1;
                    var base: i64 = 0x9A9F07E0;
                    if sf == 0 { base = 0x1A9F07E0; }
                    var inst: i64 = base | (inv << 12) | rd;
                    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                }
                ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("CSET parse error");
}

// --- LDR ---

pub fn Arm64Assembler_enc_ldr(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("LDR needs 2 operands"); }
    var sf: i64 = 1;
    if !is_64bit_reg(ops.get(0)) { sf = 0; }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rt) => {
            var mem: Arm64MemOperand = arm64_parse_mem_operand(ops.get(1));
            match mem {
                Arm64MemOperand::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                Arm64MemOperand::Ok(rn_str, imm) => {
                    match parse_reg(rn_str) {
                        ResultI64Str::Ok(rn) => {
                            var base: i64 = 0xF9400000;
                            if sf == 0 { base = 0xB9400000; }
                            if imm == 0 && !str_contains(ops.get(1), "!") {
                                // LDR Xt, [Xn] → LDR Xt, [Xn, #0]
                                var inst: i64 = base | (rn << 5) | rt;
                                return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                            }
                            // LDR Xt, [Xn, #imm] — scale by 8 (64-bit) or 4 (32-bit)
                            var scale: i64 = 8;
                            if sf == 0 { scale = 4; }
                            var imm12: i64 = imm / scale;
                            var inst: i64 = base | (imm12 << 10) | (rn << 5) | rt;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                    }
                }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("LDR parse error");
}

// --- STR ---

pub fn Arm64Assembler_enc_str(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("STR needs 2 operands"); }
    var sf: i64 = 1;
    if !is_64bit_reg(ops.get(0)) { sf = 0; }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rt) => {
            var mem: Arm64MemOperand = arm64_parse_mem_operand(ops.get(1));
            match mem {
                Arm64MemOperand::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                Arm64MemOperand::Ok(rn_str, imm) => {
                    match parse_reg(rn_str) {
                        ResultI64Str::Ok(rn) => {
                            var base: i64 = 0xF9000000;
                            if sf == 0 { base = 0xB9000000; }
                            if imm == 0 {
                                var inst: i64 = base | (rn << 5) | rt;
                                return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                            }
                            // STR Xt, [Xn, #imm] — scale by 8 (64-bit) or 4 (32-bit)
                            var scale: i64 = 8;
                            if sf == 0 { scale = 4; }
                            var imm12: i64 = imm / scale;
                            var inst: i64 = base | (imm12 << 10) | (rn << 5) | rt;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                    }
                }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("STR parse error");
}

// --- LDRB ---

pub fn Arm64Assembler_enc_ldrb(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("LDRB needs 2 operands"); }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rt) => {
            var mem: Arm64MemOperand = arm64_parse_mem_operand(ops.get(1));
            match mem {
                Arm64MemOperand::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                Arm64MemOperand::Ok(rn_str, imm) => {
                    match parse_reg(rn_str) {
                        ResultI64Str::Ok(rn) => {
                            var inst: i64 = 0x39400000 | ((imm & 0xFFF) << 10) | (rn << 5) | rt;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                    }
                }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("LDRB parse error");
}

// --- STRB ---

pub fn Arm64Assembler_enc_strb(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() < 2 { return ResultArm64EncodedInst::Err("STRB needs 2 operands"); }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rt) => {
            var mem: Arm64MemOperand = arm64_parse_mem_operand(ops.get(1));
            match mem {
                Arm64MemOperand::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                Arm64MemOperand::Ok(rn_str, imm) => {
                    match parse_reg(rn_str) {
                        ResultI64Str::Ok(rn) => {
                            var inst: i64 = 0x39000000 | ((imm & 0xFFF) << 10) | (rn << 5) | rt;
                            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
                        }
                        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
                    }
                }
            }
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("STRB parse error");
}

// --- SVC ---

pub fn Arm64Assembler_enc_svc(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() == 0 { return ResultArm64EncodedInst::Err("SVC needs 1 operand"); }
    var imm: i64 = arm64_strip_hash(ops.get(0));
    var inst: i64 = 0xD4000001 | ((imm & 0xFFFF) << 5);
    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
}

// --- B.cond ---

pub fn Arm64Assembler_enc_bcond(self: &Arm64Assembler, cond: str, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() == 0 { return ResultArm64EncodedInst::Err("B.cond needs 1 operand"); }
    var target: str = ops.get(0);
    match parse_cond(cond) {
        ResultI64Str::Ok(cond_val) => {
            var inst: i64 = 0x54000000 | cond_val;
            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_with_reloc(inst, target, 12));
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("B.cond parse error");
}

// --- B ---

pub fn Arm64Assembler_enc_b(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() == 0 { return ResultArm64EncodedInst::Err("B needs 1 operand"); }
    var target: str = ops.get(0);
    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_with_reloc(0x14000000, target, 11));
}

// --- BL ---

pub fn Arm64Assembler_enc_bl(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() == 0 { return ResultArm64EncodedInst::Err("BL needs 1 operand"); }
    var target: str = ops.get(0);
    return ResultArm64EncodedInst::Ok(Arm64EncodedInst_with_reloc(0x94000000, target, 10));
}

// --- BLR ---

pub fn Arm64Assembler_enc_blr(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() == 0 { return ResultArm64EncodedInst::Err("BLR needs 1 operand"); }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rn) => {
            var inst: i64 = 0xD63F0000 | (rn << 5);
            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("BLR parse error");
}

// --- BR ---

pub fn Arm64Assembler_enc_br(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() == 0 { return ResultArm64EncodedInst::Err("BR needs 1 operand"); }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rn) => {
            var inst: i64 = 0xD61F0000 | (rn << 5);
            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("BR parse error");
}

// --- RET ---

pub fn Arm64Assembler_enc_ret(self: &Arm64Assembler, ops: Vec<str>) -> ResultArm64EncodedInst {
    if ops.len() == 0 {
        return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(0xD65F03C0));
    }
    match parse_reg(ops.get(0)) {
        ResultI64Str::Ok(rn) => {
            var inst: i64 = 0xD65F0000 | (rn << 5);
            return ResultArm64EncodedInst::Ok(Arm64EncodedInst_bytes(inst));
        }
        ResultI64Str::Err(e) => { return ResultArm64EncodedInst::Err(e); }
    }
    return ResultArm64EncodedInst::Err("RET parse error");
