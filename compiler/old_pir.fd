// pir.fd — PIR (Fides Intermediate Representation), rewritten from src/pir.rs
//
// Multi-level IR pipeline:
//   AST ──lower.rs──▶ IR (ir.rs) ──pir.rs──▶ PIR L1 ─▶ L2 ─▶ L3
//
// Levels:
//   L1 — Semantic: named regions, per-call effects, capabilities
//   L2 — Mid: drops region naming (stack/heap only), keeps SSA + control flow
//   L3 — Low: virtual registers, stack frame slots, calling-convention lowering
//
// Adaptations from Rust:
// 1. String → str, usize/u32/u64 → i64
// 2. HashMap<K,V> → Vec-based maps with helper structs
// 3. HashSet<T> → Vec<T> with contains check
// 4. Option<T> → Opt* enums or -1 sentinel for i64
// 5. struct-style enum variants → tuple-style (Fides convention)
// 6. impl blocks → free functions
// 7. Closures → inlined or helper functions with explicit state

module compiler::pir;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;

// ═══════════════════════════════════════════════════════════════════════════
// Shared PIR types
// ═══════════════════════════════════════════════════════════════════════════

// PIR reuses the existing IR type system.
// PirType = IrType (used directly)
// PValue = i64 (ValueId)
// PBlock = i64 (BlockId)

// ─── CapSet ──────────────────────────────────────────────────────────────

pub struct CapSet {
    pub caps: Vec<str>,
}

pub fn CapSet_new() -> CapSet {
    return CapSet { caps: Vec::new() };
}

pub fn CapSet_add(self: &mut CapSet, c: str) {
    if !CapSet_contains(self, c) {
        self.caps.push(c);
    }
}

pub fn CapSet_contains(self: &CapSet, c: str) -> bool {
    var i: i64 = 0;
    while i < self.caps.len() {
        if str_equal(self.caps.get(i), c) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn CapSet_is_empty(self: &CapSet) -> bool {
    return self.caps.len() == 0;
}

pub fn CapSet_to_str(self: &CapSet) -> str {
    if self.caps.len() == 0 {
        return "no_cap";
    }
    var result: str = "cap[";
    var i: i64 = 0;
    while i < self.caps.len() {
        if i > 0 {
            result = result + ",";
        }
        result = result + self.caps.get(i);
        i = i + 1;
    }
    result = result + "]";
    return result;
}

// ═══════════════════════════════════════════════════════════════════════════
// PIR Level 1 — Semantic
// ═══════════════════════════════════════════════════════════════════════════

// L1 instruction set — tuple-style variants (Fides convention).
// Mirrors ir::Inst but makes region, effect, and capability metadata explicit.

pub enum L1Inst {
    // ─── Constants ───
    ConstInt(i64, IrType),
    ConstFloat(i64, IrType),    // bits stored as i64
    ConstBool(bool),
    ConstStr(str),
    ConstNull(IrType),

    // ─── Arithmetic (pure) ───
    BinOp(BinOp, i64, i64, IrType),
    UnaryOp(UnaryOp, i64, IrType),

    // ─── Region lifetime (L1 only) ───
    NewRegion(str),
    FreeRegion(i64),

    // ─── Memory (region-annotated) ───
    AllocaIn(RegionRef, IrType),
    Load(i64, IrType, EffectSet),
    Store(i64, i64, OptIrType, EffectSet),
    GetFieldPtr(i64, i64, IrType),
    GetElemPtr(i64, i64, IrType),

    // ─── Control flow ───
    Jump(i64),
    Branch(i64, i64, i64),
    Return(OptValueId),
    Unreachable,

    // ─── Calls (effect + capability + region annotated) ───
    Call(str, Vec<i64>, IrType, EffectSet, CapSet, RegionRef),
    CallPtr(i64, Vec<i64>, IrType, EffectSet, CapSet, bool),
    DynCall(str, str, Vec<i64>, IrType, EffectSet),
    MakeDyn(i64, str, str),

    // ─── Conversions (pure) ───
    BitCast(i64, IrType, IrType),
    Copy(i64, IrType),
    IntExtend(i64, IrType, IrType),
    IntTrunc(i64, IrType, IrType),
    IntToFloat(i64, IrType, IrType),
    FloatToInt(i64, IrType, IrType),

    // ─── Fides-specific ───
    TryUnwrap(i64, i64, i64, i64),
    Print(i64, IrType),
    Panic(str),
}

// Region reference at L1: either a named region handle or a builtin region.
pub enum RegionRef {
    Builtin(Region),
    Handle(i64),
    Unknown,
}

pub fn region_ref_to_str(r: RegionRef) -> str {
    match r {
        RegionRef::Builtin(reg) => { return region_to_str(reg); }
        RegionRef::Handle(v) => { return "region(" + int_to_str(v) + ")"; }
        RegionRef::Unknown => { return "region?"; }
    }
    return "region?";
}

pub fn region_ref_eq(a: RegionRef, b: RegionRef) -> bool {
    match a {
        RegionRef::Builtin(ra) => {
            match b {
                RegionRef::Builtin(rb) => { return region_eq(ra, rb); }
                _ => { return false; }
            }
        }
        RegionRef::Handle(va) => {
            match b {
                RegionRef::Handle(vb) => { return va == vb; }
                _ => { return false; }
            }
        }
        RegionRef::Unknown => {
            match b {
                RegionRef::Unknown => { return true; }
                _ => { return false; }
            }
        }
    }
    return false;
}

pub fn region_eq(a: Region, b: Region) -> bool {
    match a {
        Region::Stack => { match b { Region::Stack => { return true; }, _ => { return false; } } }
        Region::Heap => { match b { Region::Heap => { return true; }, _ => { return false; } } }
        Region::Static => { match b { Region::Static => { return true; }, _ => { return false; } } }
        Region::Named(na) => {
            match b {
                Region::Named(nb) => { return str_equal(na, nb); }
                _ => { return false; }
            }
        }
    }
    return false;
}

// ─── L1Inst methods ──────────────────────────────────────────────────────

pub fn l1inst_is_terminator(inst: &L1Inst) -> bool {
    match inst {
        L1Inst::Jump(_) => { return true; }
        L1Inst::Branch(_, _, _) => { return true; }
        L1Inst::Return(_) => { return true; }
        L1Inst::Unreachable => { return true; }
        L1Inst::Panic(_) => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn l1inst_kind_name(inst: &L1Inst) -> str {
    match inst {
        L1Inst::ConstInt(_, _) => { return "ConstInt"; }
        L1Inst::ConstFloat(_, _) => { return "ConstFloat"; }
        L1Inst::ConstBool(_) => { return "ConstBool"; }
        L1Inst::ConstStr(_) => { return "ConstStr"; }
        L1Inst::ConstNull(_) => { return "ConstNull"; }
        L1Inst::BinOp(_, _, _, _) => { return "BinOp"; }
        L1Inst::UnaryOp(_, _, _) => { return "UnaryOp"; }
        L1Inst::NewRegion(_) => { return "NewRegion"; }
        L1Inst::FreeRegion(_) => { return "FreeRegion"; }
        L1Inst::AllocaIn(_, _) => { return "AllocaIn"; }
        L1Inst::Load(_, _, _) => { return "Load"; }
        L1Inst::Store(_, _, _, _) => { return "Store"; }
        L1Inst::GetFieldPtr(_, _, _) => { return "GetFieldPtr"; }
        L1Inst::GetElemPtr(_, _, _) => { return "GetElemPtr"; }
        L1Inst::Jump(_) => { return "Jump"; }
        L1Inst::Branch(_, _, _) => { return "Branch"; }
        L1Inst::Return(_) => { return "Return"; }
        L1Inst::Unreachable => { return "Unreachable"; }
        L1Inst::Call(_, _, _, _, _, _) => { return "Call"; }
        L1Inst::CallPtr(_, _, _, _, _, _) => { return "CallPtr"; }
        L1Inst::DynCall(_, _, _, _, _) => { return "DynCall"; }
        L1Inst::MakeDyn(_, _, _) => { return "MakeDyn"; }
        L1Inst::BitCast(_, _, _) => { return "BitCast"; }
        L1Inst::Copy(_, _) => { return "Copy"; }
        L1Inst::IntExtend(_, _, _) => { return "IntExtend"; }
        L1Inst::IntTrunc(_, _, _) => { return "IntTrunc"; }
        L1Inst::IntToFloat(_, _, _) => { return "IntToFloat"; }
        L1Inst::FloatToInt(_, _, _) => { return "FloatToInt"; }
        L1Inst::TryUnwrap(_, _, _, _) => { return "TryUnwrap"; }
        L1Inst::Print(_, _) => { return "Print"; }
        L1Inst::Panic(_) => { return "Panic"; }
    }
    return "Unknown";
}

// ─── L1 value entry: (instruction, region, effects, source_line) ────────

pub struct L1ValueEntry {
    pub inst: L1Inst,
    pub region: RegionRef,
    pub effects: EffectSet,
    pub source_line: OptU64,
}

pub fn L1ValueEntry_new(inst: L1Inst, region: RegionRef, effects: EffectSet, source_line: OptU64) -> L1ValueEntry {
    return L1ValueEntry {
        inst: inst,
        region: region,
        effects: effects,
        source_line: source_line,
    };
}

// ─── L1 Block ────────────────────────────────────────────────────────────

pub struct L1Block {
    pub id: i64,
    pub instructions: Vec<i64>,
    pub predecessors: Vec<i64>,
    pub params: Vec<ValueIdType>,
}

pub fn L1Block_new(id: i64) -> L1Block {
    return L1Block {
        id: id,
        instructions: Vec::new(),
        predecessors: Vec::new(),
        params: Vec::new(),
    };
}

// ─── L1 Function ─────────────────────────────────────────────────────────

pub struct L1Function {
    pub name: str,
    pub params: Vec<ValueIdType>,
    pub ret_ty: IrType,
    pub blocks: Vec<L1Block>,
    pub values: Vec<ValueIdL1Entry>,    // value id → L1ValueEntry
    pub effects: EffectSet,
    pub caps: CapSet,
    pub entry: i64,
    pub is_wrapping: bool,
    pub is_deterministic: bool,
    pub is_crashfree: bool,
    pub sandbox_values: Vec<i64>,       // HashSet → Vec
    pub linear_values: Vec<i64>,        // HashSet → Vec
    pub borrow_kinds: Vec<ValueIdBorrowKind>,
    pub gas_limit: OptU64,
    pub is_no_alloc: bool,
    pub is_medical: bool,
    pub is_kernel: bool,
    pub workgroup_size: Vec<i64>,
}

pub struct ValueIdL1Entry {
    pub id: i64,
    pub entry: L1ValueEntry,
}

pub fn ValueIdL1Entry_new(id: i64, entry: L1ValueEntry) -> ValueIdL1Entry {
    return ValueIdL1Entry { id: id, entry: entry };
}

pub struct ValueIdBorrowKind {
    pub id: i64,
    pub kind: BorrowKind,
}

pub fn ValueIdBorrowKind_new(id: i64, kind: BorrowKind) -> ValueIdBorrowKind {
    return ValueIdBorrowKind { id: id, kind: kind };
}

pub fn L1Function_new(name: str, ret_ty: IrType) -> L1Function {
    return L1Function {
        name: name,
        params: Vec::new(),
        ret_ty: ret_ty,
        blocks: Vec::new(),
        values: Vec::new(),
        effects: EffectSet_new(),
        caps: CapSet_new(),
        entry: 0,
        is_wrapping: false,
        is_deterministic: false,
        is_crashfree: false,
        sandbox_values: Vec::new(),
        linear_values: Vec::new(),
        borrow_kinds: Vec::new(),
        gas_limit: OptU64::None,
        is_no_alloc: false,
        is_medical: false,
        is_kernel: false,
        workgroup_size: Vec::new(),
    };
}

pub fn L1Function_get_value(self: &L1Function, id: i64) -> OptL1ValueEntry {
    var i: i64 = 0;
    while i < self.values.len() {
        if self.values.get(i).id == id {
            return OptL1ValueEntry::Some(self.values.get(i).entry);
        }
        i = i + 1;
    }
    return OptL1ValueEntry::None;
}

pub fn L1Function_set_value(self: &mut L1Function, id: i64, entry: L1ValueEntry) {
    var i: i64 = 0;
    while i < self.values.len() {
        if self.values.get(i).id == id {
            self.values.set(i, ValueIdL1Entry_new(id, entry));
            return;
        }
        i = i + 1;
    }
    self.values.push(ValueIdL1Entry_new(id, entry));
}

pub enum OptL1ValueEntry {
    Some(L1ValueEntry),
    None,
}

// ─── L1 Module ───────────────────────────────────────────────────────────

pub struct L1Module {
    pub functions: Vec<L1Function>,
    pub struct_layouts: Vec<StructLayoutEntry>,
    pub string_constants: Vec<StringStringEntry>,
    pub extern_functions: Vec<StringVecIrType>,
    pub trait_methods: Vec<StringVecStr>,
    pub trait_impls: Vec<StringVecStr>,
    pub linear_structs: Vec<str>,
}

pub fn L1Module_new() -> L1Module {
    return L1Module {
        functions: Vec::new(),
        struct_layouts: Vec::new(),
        string_constants: Vec::new(),
        extern_functions: Vec::new(),
        trait_methods: Vec::new(),
        trait_impls: Vec::new(),
        linear_structs: Vec::new(),
    };
}

// ═══════════════════════════════════════════════════════════════════════════
// PIR Level 2 — Mid (control flow)
// ═══════════════════════════════════════════════════════════════════════════

// L2 drops region handles, capability tracking, and per-instruction effect
// annotations. Regions collapse to a simple MemRegion (Stack/Heap/Static).

pub enum MemRegion {
    Stack,
    Heap,
    Static,
    Named(str),
}

pub fn mem_region_to_str(r: MemRegion) -> str {
    match r {
        MemRegion::Stack => { return "stack"; }
        MemRegion::Heap => { return "heap"; }
        MemRegion::Static => { return "static"; }
        MemRegion::Named(name) => { return "region." + name; }
    }
    return "heap";
}

pub fn mem_region_eq(a: MemRegion, b: MemRegion) -> bool {
    match a {
        MemRegion::Stack => { match b { MemRegion::Stack => { return true; }, _ => { return false; } } }
        MemRegion::Heap => { match b { MemRegion::Heap => { return true; }, _ => { return false; } } }
        MemRegion::Static => { match b { MemRegion::Static => { return true; }, _ => { return false; } } }
        MemRegion::Named(na) => {
            match b {
                MemRegion::Named(nb) => { return str_equal(na, nb); }
                _ => { return false; }
            }
        }
    }
    return false;
}

pub enum L2Inst {
    // ─── Constants ───
    ConstInt(i64, IrType),
    ConstFloat(i64, IrType),
    ConstBool(bool),
    ConstStr(str),
    ConstNull(IrType),

    // ─── Arithmetic ───
    BinOp(BinOp, i64, i64, IrType),
    UnaryOp(UnaryOp, i64, IrType),

    // ─── Memory ───
    Alloca(IrType, MemRegion),
    Load(i64, IrType),
    Store(i64, i64, OptIrType),
    GetFieldPtr(i64, i64, IrType),
    GetElemPtr(i64, i64, IrType),

    // ─── Control flow ───
    Jump(i64),
    Branch(i64, i64, i64),
    Return(i64),  // -1 = void return
    Unreachable,

    // ─── Calls ───
    Call(str, Vec<i64>, IrType),
    CallPtr(i64, Vec<i64>, IrType, bool),
    DynCall(str, str, Vec<i64>, IrType),
    MakeDyn(i64, str, str),

    // ─── Conversions ───
    BitCast(i64, IrType, IrType),
    Copy(i64, IrType),
    IntExtend(i64, IrType, IrType),
    IntTrunc(i64, IrType, IrType),
    IntToFloat(i64, IrType, IrType),
    FloatToInt(i64, IrType, IrType),

    // ─── Fides-specific ───
    TryUnwrap(i64, i64, i64, i64),
    Print(i64, IrType),
    Panic(str),
}

pub fn l2inst_is_terminator(inst: &L2Inst) -> bool {
    match inst {
        L2Inst::Jump(_) => { return true; }
        L2Inst::Branch(_, _, _) => { return true; }
        L2Inst::Return(_) => { return true; }
        L2Inst::Unreachable => { return true; }
        L2Inst::Panic(_) => { return true; }
        _ => { return false; }
    }
    return false;
}

pub fn l2inst_kind_name(inst: &L2Inst) -> str {
    match inst {
        L2Inst::ConstInt(_, _) => { return "ConstInt"; }
        L2Inst::ConstFloat(_, _) => { return "ConstFloat"; }
        L2Inst::ConstBool(_) => { return "ConstBool"; }
        L2Inst::ConstStr(_) => { return "ConstStr"; }
        L2Inst::ConstNull(_) => { return "ConstNull"; }
        L2Inst::BinOp(_, _, _, _) => { return "BinOp"; }
        L2Inst::UnaryOp(_, _, _) => { return "UnaryOp"; }
        L2Inst::Alloca(_, _) => { return "Alloca"; }
        L2Inst::Load(_, _) => { return "Load"; }
        L2Inst::Store(_, _, _) => { return "Store"; }
        L2Inst::GetFieldPtr(_, _, _) => { return "GetFieldPtr"; }
        L2Inst::GetElemPtr(_, _, _) => { return "GetElemPtr"; }
        L2Inst::Jump(_) => { return "Jump"; }
        L2Inst::Branch(_, _, _) => { return "Branch"; }
        L2Inst::Return(_) => { return "Return"; }
        L2Inst::Unreachable => { return "Unreachable"; }
        L2Inst::Call(_, _, _) => { return "Call"; }
        L2Inst::CallPtr(_, _, _, _) => { return "CallPtr"; }
        L2Inst::DynCall(_, _, _, _) => { return "DynCall"; }
        L2Inst::MakeDyn(_, _, _) => { return "MakeDyn"; }
        L2Inst::BitCast(_, _, _) => { return "BitCast"; }
        L2Inst::Copy(_, _) => { return "Copy"; }
        L2Inst::IntExtend(_, _, _) => { return "IntExtend"; }
        L2Inst::IntTrunc(_, _, _) => { return "IntTrunc"; }
        L2Inst::IntToFloat(_, _, _) => { return "IntToFloat"; }
        L2Inst::FloatToInt(_, _, _) => { return "FloatToInt"; }
        L2Inst::TryUnwrap(_, _, _, _) => { return "TryUnwrap"; }
        L2Inst::Print(_, _) => { return "Print"; }
        L2Inst::Panic(_) => { return "Panic"; }
    }
    return "Unknown";
}

// ─── L2 Block ────────────────────────────────────────────────────────────

pub struct L2Block {
    pub id: i64,
    pub instructions: Vec<i64>,
    pub predecessors: Vec<i64>,
    pub params: Vec<ValueIdType>,
}

pub fn L2Block_new(id: i64) -> L2Block {
    return L2Block {
        id: id,
        instructions: Vec::new(),
        predecessors: Vec::new(),
        params: Vec::new(),
    };
}

// ─── L2 Function ─────────────────────────────────────────────────────────

pub struct L2Function {
    pub name: str,
    pub params: Vec<ValueIdType>,
    pub ret_ty: IrType,
    pub blocks: Vec<L2Block>,
    pub values: Vec<ValueIdL2Entry>,
    pub entry: i64,
    pub is_pure: bool,
    pub is_wrapping: bool,
    pub is_deterministic: bool,
    pub is_crashfree: bool,
    pub sandbox_values: Vec<i64>,
    pub linear_values: Vec<i64>,
    pub borrow_kinds: Vec<ValueIdBorrowKind>,
    pub gas_limit: OptU64,
    pub is_no_alloc: bool,
    pub is_medical: bool,
    pub is_kernel: bool,
    pub workgroup_size: Vec<i64>,
}

pub struct ValueIdL2Entry {
    pub id: i64,
    pub inst: L2Inst,
}

pub fn ValueIdL2Entry_new(id: i64, inst: L2Inst) -> ValueIdL2Entry {
    return ValueIdL2Entry { id: id, inst: inst };
}

pub fn L2Function_new(name: str, ret_ty: IrType) -> L2Function {
    return L2Function {
        name: name,
        params: Vec::new(),
        ret_ty: ret_ty,
        blocks: Vec::new(),
        values: Vec::new(),
        entry: 0,
        is_pure: false,
        is_wrapping: false,
        is_deterministic: false,
        is_crashfree: false,
        sandbox_values: Vec::new(),
        linear_values: Vec::new(),
        borrow_kinds: Vec::new(),
        gas_limit: OptU64::None,
        is_no_alloc: false,
        is_medical: false,
        is_kernel: false,
        workgroup_size: Vec::new(),
    };
}

pub fn L2Function_get_value(self: &L2Function, id: i64) -> OptL2Inst {
    var i: i64 = 0;
    while i < self.values.len() {
        if self.values.get(i).id == id {
            return OptL2Inst::Some(self.values.get(i).inst);
        }
        i = i + 1;
    }
    return OptL2Inst::None;
}

pub fn L2Function_set_value(self: &mut L2Function, id: i64, inst: L2Inst) {
    var i: i64 = 0;
    while i < self.values.len() {
        if self.values.get(i).id == id {
            self.values.set(i, ValueIdL2Entry_new(id, inst));
            return;
        }
        i = i + 1;
    }
    self.values.push(ValueIdL2Entry_new(id, inst));
}

pub fn L2Function_remove_value(self: &mut L2Function, vid: i64) {
    // Find and remove the entry with matching id
    var idx: i64 = -1;
    var i: i64 = 0;
    while i < self.values.len() {
        if self.values.get(i).id == vid {
            idx = i;
        }
        i = i + 1;
    }
    if idx >= 0 {
        // Shift all elements after idx down by 1
        var j: i64 = idx;
        while j < self.values.len() - 1 {
            self.values.set(j, self.values.get(j + 1));
            j = j + 1;
        }
        self.values.pop();
    }
}

pub enum OptL2Inst {
    Some(L2Inst),
    None,
}

// ─── L2 Module ───────────────────────────────────────────────────────────

pub struct L2Module {
    pub functions: Vec<L2Function>,
    pub struct_layouts: Vec<StructLayoutEntry>,
    pub string_constants: Vec<StringStringEntry>,
    pub extern_functions: Vec<StringVecIrType>,
    pub trait_methods: Vec<StringVecStr>,
    pub trait_impls: Vec<StringVecStr>,
    pub linear_structs: Vec<str>,
}

pub fn L2Module_new() -> L2Module {
    return L2Module {
        functions: Vec::new(),
        struct_layouts: Vec::new(),
        string_constants: Vec::new(),
        extern_functions: Vec::new(),
        trait_methods: Vec::new(),
        trait_impls: Vec::new(),
        linear_structs: Vec::new(),
    };
}

// ═══════════════════════════════════════════════════════════════════════════
// PIR Level 3 — Low (machine-near)
// ═══════════════════════════════════════════════════════════════════════════

// Virtual register — L3 operates on an unbounded virtual register file.
pub struct VReg {
    pub id: i64,
}

pub fn VReg_new(id: i64) -> VReg {
    return VReg { id: id };
}

pub fn vreg_to_str(r: VReg) -> str {
    return "v" + int_to_str(r.id);
}

pub fn vreg_eq(a: VReg, b: VReg) -> bool {
    return a.id == b.id;
}

// Stack frame slot — addressed by byte offset from the frame pointer.
pub struct Slot {
    pub offset: i64,
}

pub fn Slot_new(offset: i64) -> Slot {
    return Slot { offset: offset };
}

pub fn slot_to_str(s: Slot) -> str {
    return "[fp-" + int_to_str(s.offset) + "]";
}

pub fn slot_eq(a: Slot, b: Slot) -> bool {
    return a.offset == b.offset;
}

// L3 operand — virtual register, stack slot, or immediate.
pub enum Operand {
    VReg(VReg),
    Slot(Slot),
    ImmI(i64),
    ImmF(i64),        // f64 bits stored as i64
    ImmStr(str),
    ImmFunc(str),     // function address (for closure envs)
    ImmNull,
}

pub fn operand_to_str(op: Operand) -> str {
    match op {
        Operand::VReg(r) => { return vreg_to_str(r); }
        Operand::Slot(s) => { return slot_to_str(s); }
        Operand::ImmI(v) => { return "#" + int_to_str(v); }
        Operand::ImmF(b) => { return "#f:" + int_to_str(b); }
        Operand::ImmStr(s) => { return "\"" + s + "\""; }
        Operand::ImmFunc(s) => { return "&" + s; }
        Operand::ImmNull => { return "#null"; }
    }
    return "#null";
}

// Cast kind for L3 Cast instruction.
pub enum CastKind {
    BitCast,
    IntExtend,
    IntTrunc,
    IntToFloat,
    FloatToInt,
}

pub fn cast_kind_to_str(k: CastKind) -> str {
    match k {
        CastKind::BitCast => { return "bitcast"; }
        CastKind::IntExtend => { return "int_extend"; }
        CastKind::IntTrunc => { return "int_trunc"; }
        CastKind::IntToFloat => { return "int_to_float"; }
        CastKind::FloatToInt => { return "float_to_int"; }
    }
    return "bitcast";
}

// L3 instructions — close to machine code but still target-independent.
pub enum L3Inst {
    // dst = imm (or load immediate)
    Mov(VReg, Operand),
    // dst = &slot (address-of stack slot — for Alloca)
    AddrOfSlot(VReg, Slot),
    // dst = a op b
    Bin(BinOp, VReg, Operand, Operand, IrType),
    // dst = op src
    Unary(UnaryOp, VReg, Operand, IrType),
    // Allocate bytes on the stack; result pointer in dst
    StackAlloc(VReg, i64, MemRegion),
    // dst = *ptr (typed load)
    Load(VReg, Operand, IrType),
    // *ptr = val
    Store(Operand, Operand, IrType),
    // dst = &base + offset
    FieldAddr(VReg, Operand, i64, IrType),
    // dst = &base + index * elem_size
    ElemAddr(VReg, Operand, Operand, IrType),
    // Unconditional jump
    Jmp(i64),
    // if cond then target else else_
    Br(Operand, i64, i64),
    // Return with optional value operand
    Ret(OptOperand),
    Unreachable,
    // Direct call — result in dst
    Call(OptVReg, str, Vec<Operand>, IrType),
    // Indirect call through function pointer
    CallPtr(OptVReg, Operand, Vec<Operand>, IrType, bool),
    // Dynamic dispatch call (trait object)
    DynCall(OptVReg, str, str, Vec<Operand>, IrType),
    // Create a trait object from a concrete value
    MakeDyn(VReg, Operand, str, str),
    // Type conversions
    Cast(VReg, Operand, IrType, IrType, CastKind),
    // Try-unwrap: branch on Ok/Some vs Err/None
    TryUnwrap(Operand, VReg, i64, i64),
    // Print a value (runtime call, abstracted)
    Print(Operand, IrType),
    // Abort with message
    Panic(str),
}

// Optional types for L3
pub enum OptOperand {
    Some(Operand),
    None,
}

pub enum OptVReg {
    Some(VReg),
    None,
}

// ─── L3 Block ────────────────────────────────────────────────────────────

pub struct L3Block {
    pub id: i64,
    pub instructions: Vec<L3Inst>,
    pub predecessors: Vec<i64>,
    pub params: Vec<VRegIrType>,
}

pub struct VRegIrType {
    pub vreg: VReg,
    pub ty: IrType,
}

pub fn VRegIrType_new(vreg: VReg, ty: IrType) -> VRegIrType {
    return VRegIrType { vreg: vreg, ty: ty };
}

pub fn L3Block_new(id: i64) -> L3Block {
    return L3Block {
        id: id,
        instructions: Vec::new(),
        predecessors: Vec::new(),
        params: Vec::new(),
    };
}

// ─── L3 Function ─────────────────────────────────────────────────────────

pub struct L3Function {
    pub name: str,
    pub params: Vec<VRegIrType>,
    pub ret_ty: IrType,
    pub blocks: Vec<L3Block>,
    pub entry: i64,
    pub frame_size: i64,
    pub next_vreg: i64,
    pub is_kernel: bool,
    pub workgroup_size: Vec<i64>,
}

pub fn L3Function_new(name: str, ret_ty: IrType) -> L3Function {
    return L3Function {
        name: name,
        params: Vec::new(),
        ret_ty: ret_ty,
        blocks: Vec::new(),
        entry: 0,
        frame_size: 0,
        next_vreg: 0,
        is_kernel: false,
        workgroup_size: Vec::new(),
    };
}

pub fn L3Function_new_vreg(self: &mut L3Function) -> VReg {
    var r: VReg = VReg_new(self.next_vreg);
    self.next_vreg = self.next_vreg + 1;
    return r;
}

// ─── L3 Module ───────────────────────────────────────────────────────────

pub struct L3Module {
    pub functions: Vec<L3Function>,
    pub struct_layouts: Vec<StructLayoutEntry>,
    pub string_constants: Vec<StringStringEntry>,
    pub extern_functions: Vec<StringVecIrType>,
    pub trait_methods: Vec<StringVecStr>,
    pub trait_impls: Vec<StringVecStr>,
    pub pure_functions: Vec<str>,       // HashSet → Vec
    pub no_alloc_functions: Vec<str>,   // HashSet → Vec
}

pub fn L3Module_new() -> L3Module {
    return L3Module {
        functions: Vec::new(),
        struct_layouts: Vec::new(),
        string_constants: Vec::new(),
        extern_functions: Vec::new(),
        trait_methods: Vec::new(),
        trait_impls: Vec::new(),
        pure_functions: Vec::new(),
        no_alloc_functions: Vec::new(),
    };
}

pub fn L3Module_has_pure(self: &L3Module, name: str) -> bool {
    var i: i64 = 0;
    while i < self.pure_functions.len() {
        if str_equal(self.pure_functions.get(i), name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn L3Module_has_no_alloc(self: &L3Module, name: str) -> bool {
    var i: i64 = 0;
    while i < self.no_alloc_functions.len() {
        if str_equal(self.no_alloc_functions.get(i), name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ═══════════════════════════════════════════════════════════════════════════
// Lowering: IrModule → PIR Level 1
// ═══════════════════════════════════════════════════════════════════════════

// Lower an IrModule to PIR Level 1.
// This is a 1:1 rewrite of every IR instruction into its L1 counterpart,
// making region/effect metadata explicit.

pub fn lower_ir_to_l1(module: &IrModule) -> L1Module {
    var l1: L1Module = L1Module_new();

    // Copy module-level metadata
    l1.struct_layouts = module.struct_layouts;
    l1.string_constants = module.string_constants;
    l1.extern_functions = module.extern_functions;
    l1.trait_methods = module.trait_methods;
    l1.trait_impls = module.trait_impls;
    l1.linear_structs = module.linear_structs;

    // Process functions in sorted order for stable output
    var names: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < module.functions.len() {
        names.push(module.functions.get(i).name);
        i = i + 1;
    }
    names = vec_sort_str(names);

    var j: i64 = 0;
    while j < names.len() {
        var k: i64 = 0;
        while k < module.functions.len() {
            if str_equal(module.functions.get(k).name, names.get(j)) {
                l1.functions.push(lower_func_to_l1(module.functions.get(k).func));
                break;
            }
            k = k + 1;
        }
        j = j + 1;
    }

    return l1;
}

// Helper: convert a Region to a RegionRef
fn region_ref_from(reg: Region) -> RegionRef {
    return RegionRef::Builtin(reg);
}

// Helper: capability set for a call — always empty (Phase 2C elision)
fn caps_for_call(func: str) -> CapSet {
    return CapSet_new();
}

// Lower a single IrFunction to L1Function
fn lower_func_to_l1(f: &IrFunction) -> L1Function {
    var values: Vec<ValueIdL1Entry> = Vec::new();

    // First pass: build a region map for each value (from ValueMeta + Alloca)
    var region_of: Vec<ValueIdRegionRef> = Vec::new();
    var i: i64 = 0;
    while i < f.value_metas.len() {
        var meta: ValueMeta = f.value_metas.get(i).meta;
        region_of.push(ValueIdRegionRef_new(f.value_metas.get(i).id, region_ref_from(meta.region)));
        i = i + 1;
    }
    // Override with Alloca's explicit region when present
    var j: i64 = 0;
    while j < f.insts.len() {
        var inst: Inst = f.insts.get(j).inst;
        var vid: i64 = f.insts.get(j).id;
        match inst {
            Inst::Alloca(ty, reg) => {
                region_of_set(&mut region_of, vid, region_ref_from(reg));
            }
            _ => {}
        }
        j = j + 1;
    }

    // Second pass: rewrite instructions
    var k: i64 = 0;
    while k < f.insts.len() {
        var inst: Inst = f.insts.get(k).inst;
        var vid: i64 = f.insts.get(k).id;
        var reg: RegionRef = region_of_get(region_of, vid);
        var effects: EffectSet = inst_effects(&inst);
        var src_line_opt: OptU64 = OptU64::None;
        match IrFunction_get_meta(f, vid) {
            OptValueMeta::Some(meta) => { src_line_opt = meta.source_line; }
            OptValueMeta::None => {}
        }

        var l1_inst: L1Inst = L1Inst::Unreachable;
        var skip: bool = false;

        match inst {
            Inst::ConstInt(value, ty) => { l1_inst = L1Inst::ConstInt(value, ty); }
            Inst::ConstFloat(bits, ty) => { l1_inst = L1Inst::ConstFloat(bits, ty); }
            Inst::ConstBool(value) => { l1_inst = L1Inst::ConstBool(value); }
            Inst::ConstStr(value) => { l1_inst = L1Inst::ConstStr(value); }
            Inst::ConstNull(ty) => { l1_inst = L1Inst::ConstNull(ty); }

            Inst::BinOp(op, left, right, ty) => { l1_inst = L1Inst::BinOp(op, left, right, ty); }
            Inst::UnaryOp(op, operand, ty) => { l1_inst = L1Inst::UnaryOp(op, operand, ty); }

            Inst::Alloca(ty, r) => { l1_inst = L1Inst::AllocaIn(region_ref_from(r), ty); }

            Inst::Load(ptr, ty) => {
                var e: EffectSet = EffectSet_new();
                EffectSet_add(&mut e, Effect::Read);
                l1_inst = L1Inst::Load(ptr, ty, e);
            }
            Inst::Store(ptr, value, store_ty) => {
                var e: EffectSet = EffectSet_new();
                EffectSet_add(&mut e, Effect::Write);
                l1_inst = L1Inst::Store(ptr, value, store_ty, e);
            }
            Inst::GetFieldPtr(struct_ptr, field_index, field_ty) => {
                l1_inst = L1Inst::GetFieldPtr(struct_ptr, field_index, field_ty);
            }
            Inst::GetElemPtr(array_ptr, index, elem_ty) => {
                l1_inst = L1Inst::GetElemPtr(array_ptr, index, elem_ty);
            }

            Inst::Jump(target) => { l1_inst = L1Inst::Jump(target); }
            Inst::Branch(cond, then_b, else_b) => { l1_inst = L1Inst::Branch(cond, then_b, else_b); }
            Inst::Return(value) => { l1_inst = L1Inst::Return(value); }
            Inst::Unreachable => { l1_inst = L1Inst::Unreachable; }

            Inst::Call(func, args, ret_ty, call_effects) => {
                l1_inst = L1Inst::Call(func, args, ret_ty, call_effects, caps_for_call(func), RegionRef::Builtin(Region::Heap));
            }
            Inst::CallPtr(fn_ptr, args, ret_ty, call_effects, has_env) => {
                l1_inst = L1Inst::CallPtr(fn_ptr, args, ret_ty, call_effects, CapSet_new(), has_env);
            }
            Inst::DynCall(trait_name, method, args, ret_ty, call_effects) => {
                l1_inst = L1Inst::DynCall(trait_name, method, args, ret_ty, call_effects);
            }
            Inst::MakeDyn(value, type_name, trait_name) => {
                l1_inst = L1Inst::MakeDyn(value, type_name, trait_name);
            }

            Inst::BitCast(value, from, to) => { l1_inst = L1Inst::BitCast(value, from, to); }
            Inst::IntExtend(value, from, to) => { l1_inst = L1Inst::IntExtend(value, from, to); }
            Inst::IntTrunc(value, from, to) => { l1_inst = L1Inst::IntTrunc(value, from, to); }
            Inst::IntToFloat(value, from, to) => { l1_inst = L1Inst::IntToFloat(value, from, to); }
            Inst::FloatToInt(value, from, to) => { l1_inst = L1Inst::FloatToInt(value, from, to); }

            Inst::TryUnwrap(value, ok_dst, err_block, ok_block) => {
                l1_inst = L1Inst::TryUnwrap(value, ok_dst, err_block, ok_block);
            }
            Inst::Print(value, ty) => { l1_inst = L1Inst::Print(value, ty); }
            Inst::PersistLoad(name, default, ty) => {
                l1_inst = L1Inst::Copy(default, ty);
            }
            Inst::PersistSave(name, value) => {
                l1_inst = L1Inst::Copy(0, IrType::I64);
            }
            // Compile-time markers produce no runtime value — skip them
            Inst::TxnBegin => { skip = true; l1_inst = L1Inst::ConstInt(0, IrType::I64); }
            Inst::TxnEnd => { skip = true; l1_inst = L1Inst::ConstInt(0, IrType::I64); }
            Inst::UnsafeBegin => { skip = true; l1_inst = L1Inst::ConstInt(0, IrType::I64); }
            Inst::UnsafeEnd => { skip = true; l1_inst = L1Inst::ConstInt(0, IrType::I64); }
            Inst::GradBegin(name) => { skip = true; l1_inst = L1Inst::ConstInt(0, IrType::I64); }
            Inst::GradEnd => { skip = true; l1_inst = L1Inst::ConstInt(0, IrType::I64); }
            Inst::Backward(loss) => { skip = true; l1_inst = L1Inst::ConstInt(0, IrType::I64); }
            Inst::Panic(message) => { l1_inst = L1Inst::Panic(message); }
            Inst::Asm(template, inputs, outputs, ret_ty) => {
                l1_inst = L1Inst::Panic("inline asm not supported in PIR: " + template);
            }
            Inst::RegionBegin(name, has_cap, is_unsafe, size) => {
                l1_inst = L1Inst::NewRegion(name);
            }
            Inst::RegionEnd(name, has_cap, is_unsafe) => {
                l1_inst = L1Inst::FreeRegion(0);
            }
        }

        if !skip {
            values.push(ValueIdL1Entry_new(vid, L1ValueEntry_new(l1_inst, reg, effects, src_line_opt)));
        }
        k = k + 1;
    }

    // Collect sandbox values
    var sandbox_values: Vec<i64> = Vec::new();
    var si: i64 = 0;
    while si < f.insts.len() {
        var vid: i64 = f.insts.get(si).id;
        match IrFunction_get_meta(f, vid) {
            OptValueMeta::Some(meta) => {
                if meta.in_sandbox {
                    sandbox_values.push(vid);
                }
            }
            OptValueMeta::None => {}
        }
        si = si + 1;
    }

    // Collect linear values
    var linear_values: Vec<i64> = Vec::new();
    var li: i64 = 0;
    while li < f.insts.len() {
        var vid: i64 = f.insts.get(li).id;
        match IrFunction_get_meta(f, vid) {
            OptValueMeta::Some(meta) => {
                if meta.is_linear {
                    linear_values.push(vid);
                }
            }
            OptValueMeta::None => {}
        }
        li = li + 1;
    }

    // Collect borrow kinds
    var borrow_kinds: Vec<ValueIdBorrowKind> = Vec::new();
    var bi: i64 = 0;
    while bi < f.insts.len() {
        var vid: i64 = f.insts.get(bi).id;
        match IrFunction_get_meta(f, vid) {
            OptValueMeta::Some(meta) => {
                if meta.borrow_kind != BorrowKind::None {
                    borrow_kinds.push(ValueIdBorrowKind_new(vid, meta.borrow_kind));
                }
            }
            OptValueMeta::None => {}
        }
        bi = bi + 1;
    }

    // Build blocks
    var blocks: Vec<L1Block> = Vec::new();
    var bi2: i64 = 0;
    while bi2 < f.blocks.len() {
        var b: BasicBlock = f.blocks.get(bi2);
        blocks.push(L1Block {
            id: b.id,
            instructions: b.instructions,
            predecessors: b.predecessors,
            params: b.params,
        });
        bi2 = bi2 + 1;
    }

    // Function-level effects: union of all instruction effects
    var func_effects: EffectSet = EffectSet_new();
    var ei: i64 = 0;
    while ei < values.len() {
        EffectSet_add_all(&mut func_effects, &values.get(ei).entry.effects);
        ei = ei + 1;
    }

    return L1Function {
        name: f.name,
        params: f.params,
        ret_ty: f.ret_ty,
        blocks: blocks,
        values: values,
        effects: func_effects,
        caps: CapSet_new(),
        entry: f.entry,
        is_wrapping: f.is_wrapping,
        is_deterministic: f.is_deterministic,
        is_crashfree: f.is_crashfree,
        sandbox_values: sandbox_values,
        linear_values: linear_values,
        borrow_kinds: borrow_kinds,
        gas_limit: f.gas_limit,
        is_no_alloc: f.is_no_alloc,
        is_medical: f.is_medical,
        is_kernel: f.is_kernel,
        workgroup_size: f.workgroup_size,
    };
}

// ─── Helper structs for region_of map ────────────────────────────────────

pub struct ValueIdRegionRef {
    pub id: i64,
    pub region: RegionRef,
}

pub fn ValueIdRegionRef_new(id: i64, region: RegionRef) -> ValueIdRegionRef {
    return ValueIdRegionRef { id: id, region: region };
}

fn region_of_get(map: Vec<ValueIdRegionRef>, id: i64) -> RegionRef {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).id == id {
            return map.get(i).region;
        }
        i = i + 1;
    }
    return RegionRef::Unknown;
}

fn region_of_set(map: &mut Vec<ValueIdRegionRef>, id: i64, reg: RegionRef) {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).id == id {
            map.set(i, ValueIdRegionRef_new(id, reg));
            return;
        }
        i = i + 1;
    }
    map.push(ValueIdRegionRef_new(id, reg));
}

// ═══════════════════════════════════════════════════════════════════════════
// Lowering: PIR Level 1 → Level 2
// ═══════════════════════════════════════════════════════════════════════════

// Lower L1 to L2: drop region handles, capability tracking, and per-call
// effect annotations. NewRegion/FreeRegion vanish; AllocaIn becomes Alloca
// with a simple MemRegion.

pub fn lower_l1_to_l2(l1: &L1Module) -> L2Module {
    var l2: L2Module = L2Module_new();
    l2.struct_layouts = l1.struct_layouts;
    l2.string_constants = l1.string_constants;
    l2.extern_functions = l1.extern_functions;
    l2.trait_methods = l1.trait_methods;
    l2.trait_impls = l1.trait_impls;
    l2.linear_structs = l1.linear_structs;

    var i: i64 = 0;
    while i < l1.functions.len() {
        l2.functions.push(lower_func_l1_to_l2(l1.functions.get(i)));
        i = i + 1;
    }
    return l2;
}

// Helper: convert RegionRef to MemRegion
fn mem_region_of(r: &RegionRef) -> MemRegion {
    match r {
        RegionRef::Builtin(reg) => {
            match reg {
                Region::Stack => { return MemRegion::Stack; }
                Region::Heap => { return MemRegion::Heap; }
                Region::Static => { return MemRegion::Static; }
                Region::Named(name) => { return MemRegion::Named(name); }
            }
            return MemRegion::Heap;
        }
        RegionRef::Handle(_) => { return MemRegion::Heap; }
        RegionRef::Unknown => { return MemRegion::Heap; }
    }
    return MemRegion::Heap;
}

fn lower_func_l1_to_l2(f: &L1Function) -> L2Function {
    var values: Vec<ValueIdL2Entry> = Vec::new();
    // Track NewRegion and FreeRegion handles so we can drop them from the
    // block instruction lists and remap AllocaIn that referenced NewRegion to Heap.
    var region_handles: Vec<i64> = Vec::new();
    var dropped_insts: Vec<i64> = Vec::new();

    // First pass: identify NewRegion/FreeRegion to drop
    var i: i64 = 0;
    while i < f.values.len() {
        var vid: i64 = f.values.get(i).id;
        var inst: L1Inst = f.values.get(i).entry.inst;
        match inst {
            L1Inst::NewRegion(name) => {
                region_handles.push(vid);
                dropped_insts.push(vid);
            }
            L1Inst::FreeRegion(reg) => {
                dropped_insts.push(vid);
            }
            _ => {}
        }
        i = i + 1;
    }

    // Second pass: rewrite instructions, dropping NewRegion/FreeRegion
    var j: i64 = 0;
    while j < f.values.len() {
        var vid: i64 = f.values.get(j).id;
        var inst: L1Inst = f.values.get(j).entry.inst;
        var reg: RegionRef = f.values.get(j).entry.region;

        // Skip dropped instructions
        if vec_contains_i64(dropped_insts, vid) {
            j = j + 1;
            continue;
        }

        var l2_inst: L2Inst = L2Inst::Unreachable;
        match inst {
            L1Inst::ConstInt(value, ty) => { l2_inst = L2Inst::ConstInt(value, ty); }
            L1Inst::ConstFloat(bits, ty) => { l2_inst = L2Inst::ConstFloat(bits, ty); }
            L1Inst::ConstBool(value) => { l2_inst = L2Inst::ConstBool(value); }
            L1Inst::ConstStr(value) => { l2_inst = L2Inst::ConstStr(value); }
            L1Inst::ConstNull(ty) => { l2_inst = L2Inst::ConstNull(ty); }

            L1Inst::BinOp(op, left, right, ty) => { l2_inst = L2Inst::BinOp(op, left, right, ty); }
            L1Inst::UnaryOp(op, operand, ty) => { l2_inst = L2Inst::UnaryOp(op, operand, ty); }

            L1Inst::AllocaIn(r, ty) => {
                var mr: MemRegion;
                if region_ref_is_handle(r) && vec_contains_i64(region_handles, region_ref_handle_value(r)) {
                    mr = MemRegion::Heap;
                } else {
                    mr = mem_region_of(&r);
                }
                l2_inst = L2Inst::Alloca(ty, mr);
            }
            L1Inst::Load(ptr, ty, effects) => { l2_inst = L2Inst::Load(ptr, ty); }
            L1Inst::Store(ptr, value, store_ty, effects) => { l2_inst = L2Inst::Store(ptr, value, store_ty); }
            L1Inst::GetFieldPtr(struct_ptr, field_index, field_ty) => {
                l2_inst = L2Inst::GetFieldPtr(struct_ptr, field_index, field_ty);
            }
            L1Inst::GetElemPtr(array_ptr, index, elem_ty) => {
                l2_inst = L2Inst::GetElemPtr(array_ptr, index, elem_ty);
            }

            L1Inst::Jump(target) => { l2_inst = L2Inst::Jump(target); }
            L1Inst::Branch(cond, then_b, else_b) => { l2_inst = L2Inst::Branch(cond, then_b, else_b); }
            L1Inst::Return(value) => {
                match value {
                    OptValueId::Some(v) => { l2_inst = L2Inst::Return(v); }
                    OptValueId::None => { l2_inst = L2Inst::Return(-1); }
                }
            }
            L1Inst::Unreachable => { l2_inst = L2Inst::Unreachable; }

            L1Inst::Call(func, args, ret_ty, effects, caps, reg) => {
                l2_inst = L2Inst::Call(func, args, ret_ty);
            }
            L1Inst::CallPtr(fn_ptr, args, ret_ty, effects, caps, has_env) => {
                l2_inst = L2Inst::CallPtr(fn_ptr, args, ret_ty, has_env);
            }
            L1Inst::DynCall(trait_name, method, args, ret_ty, effects) => {
                l2_inst = L2Inst::DynCall(trait_name, method, args, ret_ty);
            }
            L1Inst::MakeDyn(value, type_name, trait_name) => {
                l2_inst = L2Inst::MakeDyn(value, type_name, trait_name);
            }

            L1Inst::BitCast(value, from, to) => { l2_inst = L2Inst::BitCast(value, from, to); }
            L1Inst::Copy(value, ty) => { l2_inst = L2Inst::Copy(value, ty); }
            L1Inst::IntExtend(value, from, to) => { l2_inst = L2Inst::IntExtend(value, from, to); }
            L1Inst::IntTrunc(value, from, to) => { l2_inst = L2Inst::IntTrunc(value, from, to); }
            L1Inst::IntToFloat(value, from, to) => { l2_inst = L2Inst::IntToFloat(value, from, to); }
            L1Inst::FloatToInt(value, from, to) => { l2_inst = L2Inst::FloatToInt(value, from, to); }

            L1Inst::TryUnwrap(value, ok_dst, err_block, ok_block) => {
                l2_inst = L2Inst::TryUnwrap(value, ok_dst, err_block, ok_block);
            }
            L1Inst::Print(value, ty) => { l2_inst = L2Inst::Print(value, ty); }
            L1Inst::Panic(message) => { l2_inst = L2Inst::Panic(message); }

            // Already handled above (NewRegion/FreeRegion are skipped)
            L1Inst::NewRegion(name) => { j = j + 1; continue; }
            L1Inst::FreeRegion(reg) => { j = j + 1; continue; }
        }
        values.push(ValueIdL2Entry_new(vid, l2_inst));
        j = j + 1;
    }

    // Rebuild block instruction lists, dropping dropped value IDs
    var blocks: Vec<L2Block> = Vec::new();
    var bi: i64 = 0;
    while bi < f.blocks.len() {
        var b: L1Block = f.blocks.get(bi);
        var new_insts: Vec<i64> = Vec::new();
        var ii: i64 = 0;
        while ii < b.instructions.len() {
            var vid: i64 = b.instructions.get(ii);
            if !vec_contains_i64(dropped_insts, vid) {
                new_insts.push(vid);
            }
            ii = ii + 1;
        }
        blocks.push(L2Block {
            id: b.id,
            instructions: new_insts,
            predecessors: b.predecessors,
            params: b.params,
        });
        bi = bi + 1;
    }

    return L2Function {
        name: f.name,
        params: f.params,
        ret_ty: f.ret_ty,
        blocks: blocks,
        values: values,
        entry: f.entry,
        is_pure: EffectSet_is_pure(&f.effects),
        is_wrapping: f.is_wrapping,
        is_deterministic: f.is_deterministic,
        is_crashfree: f.is_crashfree,
        sandbox_values: f.sandbox_values,
        linear_values: f.linear_values,
        borrow_kinds: f.borrow_kinds,
        gas_limit: f.gas_limit,
        is_no_alloc: f.is_no_alloc,
        is_medical: f.is_medical,
        is_kernel: f.is_kernel,
        workgroup_size: f.workgroup_size,
    };
}

// ─── RegionRef helpers ───────────────────────────────────────────────────

fn region_ref_is_handle(r: RegionRef) -> bool {
    match r {
        RegionRef::Handle(_) => { return true; }
        _ => { return false; }
    }
    return false;
}

fn region_ref_handle_value(r: RegionRef) -> i64 {
    match r {
        RegionRef::Handle(v) => { return v; }
        _ => { return -1; }
    }
    return -1;
}

// ─── Vec<i64> contains helper ────────────────────────────────────────────

fn vec_contains_i64(v: Vec<i64>, value: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == value {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ═══════════════════════════════════════════════════════════════════════════
// Lowering: PIR Level 2 → Level 3
// ═══════════════════════════════════════════════════════════════════════════

// Lower L2 to L3: introduce virtual registers, compute a stack frame layout,
// and lower every L2 value into operand/vreg form.

pub fn lower_l2_to_l3(l2: &L2Module, module: &IrModule) -> L3Module {
    var l3: L3Module = L3Module_new();
    l3.struct_layouts = l2.struct_layouts;
    l3.string_constants = l2.string_constants;
    l3.extern_functions = l2.extern_functions;
    l3.trait_methods = l2.trait_methods;
    l3.trait_impls = l2.trait_impls;

    // Populate pure function set (F-1D: effect-aware regalloc)
    var i: i64 = 0;
    while i < l2.functions.len() {
        if l2.functions.get(i).is_pure {
            l3.pure_functions.push(l2.functions.get(i).name);
        }
        // I-2D: Populate no-alloc function set
        if l2.functions.get(i).is_no_alloc || l2.functions.get(i).is_medical {
            l3.no_alloc_functions.push(l2.functions.get(i).name);
        }
        i = i + 1;
    }

    var j: i64 = 0;
    while j < l2.functions.len() {
        l3.functions.push(lower_func_l2_to_l3(l2.functions.get(j), module));
        j = j + 1;
    }
    return l3;
}

// Helper struct for vreg_of map: PValue → VReg
pub struct PValueVReg {
    pub pval: i64,
    pub vreg: VReg,
}

pub fn PValueVReg_new(pval: i64, vreg: VReg) -> PValueVReg {
    return PValueVReg { pval: pval, vreg: vreg };
}

// Helper struct for slot_of map: PValue → Slot
pub struct PValueSlot {
    pub pval: i64,
    pub slot: Slot,
}

pub fn PValueSlot_new(pval: i64, slot: Slot) -> PValueSlot {
    return PValueSlot { pval: pval, slot: slot };
}

// Helper struct for value_types map: PValue → IrType
pub struct PValueIrType {
    pub pval: i64,
    pub ty: IrType,
}

pub fn PValueIrType_new(pval: i64, ty: IrType) -> PValueIrType {
    return PValueIrType { pval: pval, ty: ty };
}

// Lookup helpers for Vec-based maps
fn vreg_of_get(map: Vec<PValueVReg>, pval: i64) -> OptVReg {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).pval == pval {
            return OptVReg::Some(map.get(i).vreg);
        }
        i = i + 1;
    }
    return OptVReg::None;
}

fn vreg_of_set(map: &mut Vec<PValueVReg>, pval: i64, vreg: VReg) {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).pval == pval {
            map.set(i, PValueVReg_new(pval, vreg));
            return;
        }
        i = i + 1;
    }
    map.push(PValueVReg_new(pval, vreg));
}

fn vreg_of_get_or_create(map: &mut Vec<PValueVReg>, pval: i64, next: &mut i64) -> VReg {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).pval == pval {
            return map.get(i).vreg;
        }
        i = i + 1;
    }
    var r: VReg = VReg_new(*next);
    *next = *next + 1;
    map.push(PValueVReg_new(pval, r));
    return r;
}

fn slot_of_get(map: Vec<PValueSlot>, pval: i64) -> OptSlot {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).pval == pval {
            return OptSlot::Some(map.get(i).slot);
        }
        i = i + 1;
    }
    return OptSlot::None;
}

pub enum OptSlot {
    Some(Slot),
    None,
}

fn value_types_get(map: Vec<PValueIrType>, pval: i64) -> OptIrType {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).pval == pval {
            return OptIrType::Some(map.get(i).ty);
        }
        i = i + 1;
    }
    return OptIrType::None;
}

fn value_types_set(map: &mut Vec<PValueIrType>, pval: i64, ty: IrType) {
    var i: i64 = 0;
    while i < map.len() {
        if map.get(i).pval == pval {
            map.set(i, PValueIrType_new(pval, ty));
            return;
        }
        i = i + 1;
    }
    map.push(PValueIrType_new(pval, ty));
}

// Materialize a PValue to an Operand, preferring stack slot for alloca results.
// Uses VReg_new(pv) directly since value IDs are unique.
fn materialize_slot(pv: i64, slot_of: Vec<PValueSlot>) -> Operand {
    match slot_of_get(slot_of, pv) {
        OptSlot::Some(s) => { return Operand::Slot(s); }
        OptSlot::None => { return Operand::VReg(VReg_new(pv)); }
    }
    return Operand::VReg(VReg_new(pv));
}

// Materialize a PValue as a VALUE (not a pointer) — always uses vreg
fn materialize_vreg(pv: i64) -> Operand {
    return Operand::VReg(VReg_new(pv));
}

fn lower_func_l2_to_l3(f: &L2Function, module: &IrModule) -> L3Function {
    var value_types: Vec<PValueIrType> = Vec::new();

    // Assign vregs to function params — use VReg_new(pv) directly
    var params: Vec<VRegIrType> = Vec::new();
    var i: i64 = 0;
    while i < f.params.len() {
        var pv: i64 = f.params.get(i).id;
        var ty: IrType = f.params.get(i).ty;
        params.push(VRegIrType_new(VReg_new(pv), ty));
        value_types_set(&mut value_types, pv, ty);
        i = i + 1;
    }

    // Block params also use VReg_new(pv) directly
    var bi: i64 = 0;
    while bi < f.blocks.len() {
        var pi: i64 = 0;
        while pi < f.blocks.get(bi).params.len() {
            var pv: i64 = f.blocks.get(bi).params.get(pi).id;
            var ty: IrType = f.blocks.get(bi).params.get(pi).ty;
            value_types_set(&mut value_types, pv, ty);
            pi = pi + 1;
        }
        bi = bi + 1;
    }

    // Infer types from producing instructions
    var vi: i64 = 0;
    while vi < f.values.len() {
        var pv: i64 = f.values.get(vi).id;
        var inst: L2Inst = f.values.get(vi).inst;
        var ty: IrType = IrType::I64;
        match inst {
            L2Inst::Alloca(t, _) => { ty = IrType::Ptr(Box::new(t)); }
            L2Inst::GetFieldPtr(_, _, field_ty) => { ty = IrType::Ptr(Box::new(field_ty)); }
            L2Inst::GetElemPtr(_, _, elem_ty) => { ty = IrType::Ptr(Box::new(elem_ty)); }
            L2Inst::Call(_, _, ret_ty) => { ty = ret_ty; }
            L2Inst::CallPtr(_, _, ret_ty, _) => { ty = ret_ty; }
            L2Inst::DynCall(_, _, _, ret_ty) => { ty = ret_ty; }
            L2Inst::Load(_, t) => { ty = t; }
            L2Inst::BinOp(_, _, _, t) => { ty = t; }
            L2Inst::UnaryOp(_, _, t) => { ty = t; }
            L2Inst::Copy(_, t) => { ty = t; }
            L2Inst::BitCast(_, _, to) => { ty = to; }
            L2Inst::IntExtend(_, _, to) => { ty = to; }
            L2Inst::IntTrunc(_, _, to) => { ty = to; }
            L2Inst::IntToFloat(_, _, to) => { ty = to; }
            L2Inst::FloatToInt(_, _, to) => { ty = to; }
            L2Inst::ConstInt(_, t) => { ty = t; }
            L2Inst::ConstFloat(_, t) => { ty = t; }
            L2Inst::ConstNull(t) => { ty = t; }
            _ => { ty = IrType::I64; }
        }
        value_types_set(&mut value_types, pv, ty);
        vi = vi + 1;
    }

    // Compute stack frame: each Alloca gets a slot sized by its type
    var frame_size: i64 = 0;
    var slot_of: Vec<PValueSlot> = Vec::new();
    // Sort values by PValue for deterministic slot assignment
    var sorted_pvals: Vec<i64> = Vec::new();
    var si: i64 = 0;
    while si < f.values.len() {
        sorted_pvals.push(f.values.get(si).id);
        si = si + 1;
    }
    sorted_pvals = vec_sort_i64(sorted_pvals);
    var sj: i64 = 0;
    while sj < sorted_pvals.len() {
        var vid: i64 = sorted_pvals.get(sj);
        // Direct lookup — avoid OptL2Inst enum extraction issues
        var vi3: i64 = 0;
        while vi3 < f.values.len() {
            if f.values.get(vi3).id == vid {
                match f.values.get(vi3).inst {
                    L2Inst::Alloca(ty, _) => {
                        var size: i64 = IrModule_type_size(module, ty);
                        if size < 1 { size = 1; }
                        var aligned: i64 = (size + 7) & ~7;
                        frame_size = frame_size + aligned;
                        slot_of.push(PValueSlot_new(vid, Slot_new(frame_size)));
                    }
                    _ => {}
                }
                break;
            }
            vi3 = vi3 + 1;
        }
        sj = sj + 1;
    }

    // Lower blocks
    var blocks: Vec<L3Block> = Vec::new();
    var bi2: i64 = 0;
    while bi2 < f.blocks.len() {
        var b: L2Block = f.blocks.get(bi2);
        var l3_insts: Vec<L3Inst> = Vec::new();
        var ii: i64 = 0;
        while ii < b.instructions.len() {
            var vid: i64 = b.instructions.get(ii);
            var found: bool = false;
            var retrieved_inst: L2Inst = L2Inst::Unreachable;
            var vi2: i64 = 0;
            while vi2 < f.values.len() {
                if f.values.get(vi2).id == vid {
                    retrieved_inst = f.values.get(vi2).inst;
                    found = true;
                    break;
                }
                vi2 = vi2 + 1;
            }
            if found {
                l3_insts.push(lower_l2_inst_to_l3(f, vid, slot_of, module, value_types));
            }
            ii = ii + 1;
        }
        var bp: Vec<VRegIrType> = Vec::new();
        var pi2: i64 = 0;
        while pi2 < b.params.len() {
            var pv: i64 = b.params.get(pi2).id;
            var ty: IrType = b.params.get(pi2).ty;
            bp.push(VRegIrType_new(VReg_new(pv), ty));
            pi2 = pi2 + 1;
        }
        blocks.push(L3Block {
            id: b.id,
            instructions: l3_insts,
            predecessors: b.predecessors,
            params: bp,
        });
        bi2 = bi2 + 1;
    }

    // Compute next_vreg as max value ID + 1
    var max_vid: i64 = 0;
    var vi3: i64 = 0;
    while vi3 < f.values.len() {
        if f.values.get(vi3).id > max_vid {
            max_vid = f.values.get(vi3).id;
        }
        vi3 = vi3 + 1;
    }

    return L3Function {
        name: f.name,
        params: params,
        ret_ty: f.ret_ty,
        blocks: blocks,
        entry: f.entry,
        frame_size: frame_size,
        next_vreg: max_vid + 1,
        is_kernel: f.is_kernel,
        workgroup_size: f.workgroup_size,
    };
}

fn lower_l2_inst_to_l3(
    f: &L2Function,
    vid: i64,
    slot_of: Vec<PValueSlot>,
    module: &IrModule,
    value_types: Vec<PValueIrType>,
) -> L3Inst {
    var dst: VReg = VReg_new(vid);

    // Look up the L2Inst by value ID — this avoids passing nested enum
    // values as function parameters (which can corrupt inner enum fields)
    var local_inst: L2Inst = L2Inst::Unreachable;
    var found: bool = false;
    var fi: i64 = 0;
    while fi < f.values.len() {
        if f.values.get(fi).id == vid {
            local_inst = f.values.get(fi).inst;
            found = true;
            break;
        }
        fi = fi + 1;
    }
    if !found { return L3Inst::Unreachable; }

    match local_inst {
        L2Inst::ConstInt(value, ty) => {
            var imm_val: i64 = value;
            if ir_type_eq(ty, IrType::Bool) {
                if value != 0 { imm_val = 1; } else { imm_val = 0; }
            }
            return L3Inst::Mov(dst, Operand::ImmI(imm_val));
        }
        L2Inst::ConstFloat(bits, _) => {
            return L3Inst::Mov(dst, Operand::ImmF(bits));
        }
        L2Inst::ConstBool(value) => {
            var v: i64 = 0;
            if value { v = 1; }
            return L3Inst::Mov(dst, Operand::ImmI(v));
        }
        L2Inst::ConstStr(value) => {
            if IrModule_has_function(module, value) {
                return L3Inst::Mov(dst, Operand::ImmFunc(value));
            }
            return L3Inst::Mov(dst, Operand::ImmStr(value));
        }
        L2Inst::ConstNull(_) => {
            return L3Inst::Mov(dst, Operand::ImmNull);
        }

        L2Inst::BinOp(op, left, right, ty) => {
            var left_op: Operand = Operand::VReg(VReg_new(left));
            var right_op: Operand = Operand::VReg(VReg_new(right));
            return L3Inst::Bin(op, dst, left_op, right_op, ty);
        }
        L2Inst::UnaryOp(op, operand, ty) => {
            var operand_op: Operand = Operand::VReg(VReg_new(operand));
            return L3Inst::Unary(op, dst, operand_op, ty);
        }

        L2Inst::Alloca(ty, reg) => {
            match slot_of_get(slot_of, vid) {
                OptSlot::Some(s) => { return L3Inst::AddrOfSlot(dst, s); }
                OptSlot::None => {
                    var size: i64 = ir_type_size(ty);
                    if size < 1 { size = 1; }
                    return L3Inst::StackAlloc(dst, size, reg);
                }
            }
            return L3Inst::StackAlloc(dst, 1, reg);
        }
        L2Inst::Load(ptr, ty) => {
            var ptr_op: Operand = materialize_slot(ptr, slot_of);
            return L3Inst::Load(dst, ptr_op, ty);
        }
        L2Inst::Store(ptr, value, store_ty) => {
            var store_type: IrType = IrType::I64;
            match store_ty {
                OptIrType::Some(t) => { store_type = t; }
                OptIrType::None => {}
            }
            var store_ptr: Operand = materialize_slot(ptr, slot_of);
            var store_val: Operand = materialize_vreg(value);
            return L3Inst::Store(store_ptr, store_val, store_type);
        }
        L2Inst::GetFieldPtr(struct_ptr, field_index, field_ty) => {
            var offset: i64 = field_index * 8;
            match value_types_get(value_types, struct_ptr) {
                OptIrType::Some(ty) => {
                    match ty {
                        IrType::Ptr(inner) => {
                            match box_ir_type_unbox(inner) {
                                IrType::Struct(name) => {
                                    match IrModule_get_struct(module, name) {
                                        OptStructLayout::Some(layout) => {
                                            if field_index < layout.fields.len() {
                                                offset = layout.fields.get(field_index).offset;
                                            }
                                        }
                                        OptStructLayout::None => {}
                                    }
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                }
                OptIrType::None => {}
            }
            var base_op: Operand = materialize_slot(struct_ptr, slot_of);
            return L3Inst::FieldAddr(dst, base_op, offset, field_ty);
        }
        L2Inst::GetElemPtr(array_ptr, index, elem_ty) => {
            var arr_op: Operand = materialize_slot(array_ptr, slot_of);
            var idx_op: Operand = materialize_slot(index, slot_of);
            return L3Inst::ElemAddr(dst, arr_op, idx_op, elem_ty);
        }

        L2Inst::Jump(target) => { return L3Inst::Jmp(target); }
        L2Inst::Branch(cond, then_b, else_b) => {
            var cond_op: Operand = materialize_slot(cond, slot_of);
            return L3Inst::Br(cond_op, then_b, else_b);
        }
        L2Inst::Return(value) => {
            if value < 0 {
                return L3Inst::Ret(OptOperand::None);
            }
            var ret_op: Operand = materialize_slot(value, slot_of);
            return L3Inst::Ret(OptOperand::Some(ret_op));
        }
        L2Inst::Unreachable => { return L3Inst::Unreachable; }

        L2Inst::Call(func, args, ret_ty) => {
            var arg_ops: Vec<Operand> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                arg_ops.push(materialize_slot(args.get(ai), slot_of));
                ai = ai + 1;
            }
            if ir_type_eq(ret_ty, IrType::Void) {
                return L3Inst::Call(OptVReg::None, func, arg_ops, ret_ty);
            }
            return L3Inst::Call(OptVReg::Some(dst), func, arg_ops, ret_ty);
        }
        L2Inst::CallPtr(fn_ptr, args, ret_ty, has_env) => {
            var arg_ops: Vec<Operand> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                arg_ops.push(materialize_slot(args.get(ai), slot_of));
                ai = ai + 1;
            }
            var fnptr_op: Operand = materialize_slot(fn_ptr, slot_of);
            if ir_type_eq(ret_ty, IrType::Void) {
                return L3Inst::CallPtr(OptVReg::None, fnptr_op, arg_ops, ret_ty, has_env);
            }
            return L3Inst::CallPtr(OptVReg::Some(dst), fnptr_op, arg_ops, ret_ty, has_env);
        }
        L2Inst::DynCall(trait_name, method, args, ret_ty) => {
            var arg_ops: Vec<Operand> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                arg_ops.push(materialize_slot(args.get(ai), slot_of));
                ai = ai + 1;
            }
            if ir_type_eq(ret_ty, IrType::Void) {
                return L3Inst::DynCall(OptVReg::None, trait_name, method, arg_ops, ret_ty);
            }
            return L3Inst::DynCall(OptVReg::Some(dst), trait_name, method, arg_ops, ret_ty);
        }
        L2Inst::MakeDyn(value, type_name, trait_name) => {
            return L3Inst::MakeDyn(dst, materialize_vreg(value), type_name, trait_name);
        }

        L2Inst::BitCast(value, from, to) => {
            return L3Inst::Cast(dst, materialize_vreg(value), from, to, CastKind::BitCast);
        }
        L2Inst::Copy(value, _) => {
            return L3Inst::Mov(dst, materialize_vreg(value));
        }
        L2Inst::IntExtend(value, from, to) => {
            return L3Inst::Cast(dst, materialize_vreg(value), from, to, CastKind::IntExtend);
        }
        L2Inst::IntTrunc(value, from, to) => {
            return L3Inst::Cast(dst, materialize_vreg(value), from, to, CastKind::IntTrunc);
        }
        L2Inst::IntToFloat(value, from, to) => {
            return L3Inst::Cast(dst, materialize_vreg(value), from, to, CastKind::IntToFloat);
        }
        L2Inst::FloatToInt(value, from, to) => {
            return L3Inst::Cast(dst, materialize_vreg(value), from, to, CastKind::FloatToInt);
        }

        L2Inst::TryUnwrap(value, ok_dst, err_block, ok_block) => {
            var ok_dst_v: VReg = VReg_new(ok_dst);
            var unwrap_op: Operand = materialize_slot(value, slot_of);
            return L3Inst::TryUnwrap(unwrap_op, ok_dst_v, err_block, ok_block);
        }
        L2Inst::Print(value, ty) => {
            return L3Inst::Print(materialize_vreg(value), ty);
        }
        L2Inst::Panic(message) => {
            return L3Inst::Panic(message);
        }
    }
    return L3Inst::Unreachable;
}

// ═══════════════════════════════════════════════════════════════════════════
// Printers
// ═══════════════════════════════════════════════════════════════════════════

pub enum PirLevel {
    L1,
    L2,
    L3,
    All,
}

pub fn PirLevel_parse(s: str) -> OptPirLevel {
    if str_equal(s, "1") || str_equal(s, "l1") { return OptPirLevel::Some(PirLevel::L1); }
    if str_equal(s, "2") || str_equal(s, "l2") { return OptPirLevel::Some(PirLevel::L2); }
    if str_equal(s, "3") || str_equal(s, "l3") { return OptPirLevel::Some(PirLevel::L3); }
    if str_equal(s, "all") { return OptPirLevel::Some(PirLevel::All); }
    return OptPirLevel::None;
}

pub enum OptPirLevel {
    Some(PirLevel),
    None,
}

pub fn pir_level_eq(a: PirLevel, b: PirLevel) -> bool {
    match a {
        PirLevel::L1 => { match b { PirLevel::L1 => { return true; }, _ => { return false; } } }
        PirLevel::L2 => { match b { PirLevel::L2 => { return true; }, _ => { return false; } } }
        PirLevel::L3 => { match b { PirLevel::L3 => { return true; }, _ => { return false; } } }
        PirLevel::All => { match b { PirLevel::All => { return true; }, _ => { return false; } } }
    }
    return false;
}

// Generate a human-readable PIR dump for module at the requested level.
pub fn generate_pir(module: &IrModule, level: PirLevel) -> str {
    var l1: L1Module = lower_ir_to_l1(module);
    var l2: L2Module = lower_l1_to_l2(&l1);
    var l3: L3Module = lower_l2_to_l3(&l2, module);

    var out: str = "; ════════════════════════════════════════════════════════════════\n";
    out = out + "; PIR — Fides Intermediate Representation\n";
    out = out + "; ════════════════════════════════════════════════════════════════\n\n";

    if pir_level_eq(level, PirLevel::L1) || pir_level_eq(level, PirLevel::All) {
        out = out + format_l1(&l1);
        if pir_level_eq(level, PirLevel::All) {
            out = out + "\n";
        }
    }
    if pir_level_eq(level, PirLevel::L2) || pir_level_eq(level, PirLevel::All) {
        out = out + format_l2(&l2);
        if pir_level_eq(level, PirLevel::All) {
            out = out + "\n";
        }
    }
    if pir_level_eq(level, PirLevel::L3) || pir_level_eq(level, PirLevel::All) {
        out = out + format_l3(&l3);
    }
    return out;
}

// Public wrappers
pub fn format_l1(m: &L1Module) -> str {
    return print_l1_module(m);
}

pub fn format_l2(m: &L2Module) -> str {
    return print_l2_module(m);
}

pub fn format_l3(m: &L3Module) -> str {
    return print_l3_module(m);
}

// ─── L1 printer ──────────────────────────────────────────────────────────

fn print_l1_module(m: &L1Module) -> str {
    var out: str = "; ─── PIR Level 1 — Semantic (regions, effects, capabilities) ───\n";
    out = out + print_struct_layouts(m.struct_layouts);
    out = out + print_string_constants(m.string_constants);
    out = out + print_externs(m.extern_functions);
    var i: i64 = 0;
    while i < m.functions.len() {
        out = out + print_l1_function(m.functions.get(i));
        i = i + 1;
    }
    return out;
}

fn print_l1_function(f: &L1Function) -> str {
    var out: str = "\n; ─── function " + f.name + " ───\n";
    var params: str = fmt_params(f.params);
    out = out + "fn " + f.name + "(" + params + ") -> " + ir_type_to_str(f.ret_ty) + " " + EffectSet_to_str(&f.effects) + " " + CapSet_to_str(&f.caps) + "\n{\n";
    var i: i64 = 0;
    while i < f.blocks.len() {
        out = out + print_l1_block(f.blocks.get(i), f);
        i = i + 1;
    }
    out = out + "}\n";
    return out;
}

fn print_l1_block(b: L1Block, f: &L1Function) -> str {
    var out: str = "  " + block_id_to_str(b.id) + ":";
    if b.params.len() > 0 {
        var p: Vec<str> = Vec::new();
        var i: i64 = 0;
        while i < b.params.len() {
            p.push(value_id_to_str(b.params.get(i).id) + ": " + ir_type_to_str(b.params.get(i).ty));
            i = i + 1;
        }
        out = out + " (" + str_join(p, ", ") + ")";
    }
    if b.predecessors.len() > 0 {
        var preds: Vec<str> = Vec::new();
        var j: i64 = 0;
        while j < b.predecessors.len() {
            preds.push(block_id_to_str(b.predecessors.get(j)));
            j = j + 1;
        }
        out = out + "  ; preds: " + str_join(preds, ", ");
    }
    out = out + "\n";
    var k: i64 = 0;
    while k < b.instructions.len() {
        var vid: i64 = b.instructions.get(k);
        match L1Function_get_value(f, vid) {
            OptL1ValueEntry::Some(entry) => {
                out = out + "    " + value_id_to_str(vid) + " = " + fmt_l1_inst(entry.inst) + "  ; " + region_ref_to_str(entry.region) + " " + EffectSet_to_str(&entry.effects);
                match entry.source_line {
                    OptU64::Some(line) => { out = out + "  ; line " + int_to_str(line); }
                    OptU64::None => {}
                }
                out = out + "\n";
            }
            OptL1ValueEntry::None => {}
        }
        k = k + 1;
    }
    return out;
}

pub fn fmt_l1_inst(i: L1Inst) -> str {
    match i {
        L1Inst::ConstInt(value, ty) => { return "const " + ir_type_to_str(ty) + " " + int_to_str(value); }
        L1Inst::ConstFloat(bits, ty) => { return "const " + ir_type_to_str(ty) + " #f:" + int_to_str(bits); }
        L1Inst::ConstBool(value) => { return "const bool " + bool_to_str(value); }
        L1Inst::ConstStr(value) => { return "const str \"" + escape_str(value) + "\""; }
        L1Inst::ConstNull(ty) => { return "const " + ir_type_to_str(ty) + " null"; }
        L1Inst::BinOp(op, left, right, ty) => { return "binop " + binop_debug_str(op) + " " + ir_type_to_str(ty) + " " + value_id_to_str(left) + ", " + value_id_to_str(right) + " -> " + ir_type_to_str(ty); }
        L1Inst::UnaryOp(op, operand, ty) => { return "unop " + unaryop_debug_str(op) + " " + ir_type_to_str(ty) + " " + value_id_to_str(operand) + " -> " + ir_type_to_str(ty); }
        L1Inst::NewRegion(name) => { return "new_region \"" + name + "\""; }
        L1Inst::FreeRegion(reg) => { return "free_region " + value_id_to_str(reg); }
        L1Inst::AllocaIn(reg, ty) => { return "alloca_in " + region_ref_to_str(reg) + " " + ir_type_to_str(ty); }
        L1Inst::Load(ptr, ty, effects) => { return "load " + ir_type_to_str(ty) + " " + value_id_to_str(ptr); }
        L1Inst::Store(ptr, value, store_ty, effects) => { return "store " + value_id_to_str(value) + " -> " + value_id_to_str(ptr); }
        L1Inst::GetFieldPtr(struct_ptr, field_index, field_ty) => { return "fieldptr " + value_id_to_str(struct_ptr) + " +" + int_to_str(field_index) + " -> *" + ir_type_to_str(field_ty); }
        L1Inst::GetElemPtr(array_ptr, index, elem_ty) => { return "elemptr " + value_id_to_str(array_ptr) + "[" + value_id_to_str(index) + "] -> *" + ir_type_to_str(elem_ty); }
        L1Inst::Jump(target) => { return "jmp " + block_id_to_str(target); }
        L1Inst::Branch(cond, then_b, else_b) => { return "br " + value_id_to_str(cond) + " ? " + block_id_to_str(then_b) + " : " + block_id_to_str(else_b); }
        L1Inst::Return(value) => {
            match value {
                OptValueId::Some(v) => { return "return " + value_id_to_str(v); }
                OptValueId::None => { return "ret"; }
            }
            return "ret";
        }
        L1Inst::Unreachable => { return "unreachable"; }
        L1Inst::Call(func, args, ret_ty, effects, caps, reg) => {
            var a: Vec<str> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() { a.push(value_id_to_str(args.get(ai))); ai = ai + 1; }
            return "call " + region_ref_to_str(reg) + " " + func + "(" + str_join(a, ", ") + ") -> " + ir_type_to_str(ret_ty) + " " + EffectSet_to_str(&effects) + " " + CapSet_to_str(&caps) + " " + region_ref_to_str(reg);
        }
        L1Inst::CallPtr(fn_ptr, args, ret_ty, effects, caps, has_env) => {
            var a: Vec<str> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() { a.push(value_id_to_str(args.get(ai))); ai = ai + 1; }
            return "callptr " + value_id_to_str(fn_ptr) + "(" + str_join(a, ", ") + ") -> " + ir_type_to_str(ret_ty) + " " + EffectSet_to_str(&effects) + " " + CapSet_to_str(&caps) + " env=" + bool_to_str(has_env);
        }
        L1Inst::DynCall(trait_name, method, args, ret_ty, effects) => {
            var a: Vec<str> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() { a.push(value_id_to_str(args.get(ai))); ai = ai + 1; }
            return "dyncall " + trait_name + "::" + method + "(" + str_join(a, ", ") + ") -> " + ir_type_to_str(ret_ty) + " " + EffectSet_to_str(&effects);
        }
        L1Inst::MakeDyn(value, type_name, trait_name) => { return "makedyn " + value_id_to_str(value) + " as " + type_name + " for " + trait_name; }
        L1Inst::BitCast(value, from, to) => { return "bitcast " + value_id_to_str(value) + " " + ir_type_to_str(from) + " -> " + ir_type_to_str(to); }
        L1Inst::Copy(value, ty) => { return "copy " + value_id_to_str(value) + " -> " + ir_type_to_str(ty); }
        L1Inst::IntExtend(value, from, to) => { return "int_extend " + value_id_to_str(value) + " " + ir_type_to_str(from) + " -> " + ir_type_to_str(to); }
        L1Inst::IntTrunc(value, from, to) => { return "int_trunc " + value_id_to_str(value) + " " + ir_type_to_str(from) + " -> " + ir_type_to_str(to); }
        L1Inst::IntToFloat(value, from, to) => { return "int_to_float " + value_id_to_str(value) + " " + ir_type_to_str(from) + " -> " + ir_type_to_str(to); }
        L1Inst::FloatToInt(value, from, to) => { return "float_to_int " + value_id_to_str(value) + " " + ir_type_to_str(from) + " -> " + ir_type_to_str(to); }
        L1Inst::TryUnwrap(value, ok_dst, err_block, ok_block) => { return "try_unwrap " + value_id_to_str(value) + " -> " + value_id_to_str(ok_dst) + " ? " + block_id_to_str(ok_block) + " : " + block_id_to_str(err_block); }
        L1Inst::Print(value, ty) => { return "print " + ir_type_to_str(ty) + " " + value_id_to_str(value); }
        L1Inst::Panic(message) => { return "panic \"" + escape_str(message) + "\""; }
    }
    return "unknown";
}

// ─── L2 printer ──────────────────────────────────────────────────────────

fn print_l2_module(m: &L2Module) -> str {
    var out: str = "; ─── PIR Level 2 — Mid (control flow, no regions/caps) ───\n";
    out = out + print_struct_layouts(m.struct_layouts);
    out = out + print_string_constants(m.string_constants);
    out = out + print_externs(m.extern_functions);
    var i: i64 = 0;
    while i < m.functions.len() {
        out = out + print_l2_function(m.functions.get(i));
        i = i + 1;
    }
    return out;
}

fn print_l2_function(f: &L2Function) -> str {
    var out: str = "\n; ─── function " + f.name + " ───\n";
    var params: str = fmt_params(f.params);
    out = out + "fn " + f.name + "(" + params + ") -> " + ir_type_to_str(f.ret_ty) + "\n{\n";
    var i: i64 = 0;
    while i < f.blocks.len() {
        out = out + print_l2_block(f.blocks.get(i), f);
        i = i + 1;
    }
    out = out + "}\n";
    return out;
}

fn print_l2_block(b: L2Block, f: &L2Function) -> str {
    var out: str = "  " + block_id_to_str(b.id) + ":";
    if b.params.len() > 0 {
        var p: Vec<str> = Vec::new();
        var i: i64 = 0;
        while i < b.params.len() {
            p.push(value_id_to_str(b.params.get(i).id) + ": " + ir_type_to_str(b.params.get(i).ty));
            i = i + 1;
        }
        out = out + " (" + str_join(p, ", ") + ")";
    }
    if b.predecessors.len() > 0 {
        var preds: Vec<str> = Vec::new();
        var j: i64 = 0;
        while j < b.predecessors.len() {
            preds.push(block_id_to_str(b.predecessors.get(j)));
            j = j + 1;
        }
        out = out + "  ; preds: " + str_join(preds, ", ");
    }
    out = out + "\n";
    var k: i64 = 0;
    while k < b.instructions.len() {
        var vid: i64 = b.instructions.get(k);
        match L2Function_get_value(f, vid) {
            OptL2Inst::Some(inst) => {
                out = out + "    " + value_id_to_str(vid) + " = " + fmt_l2_inst(inst) + "\n";
            }
            OptL2Inst::None => {}
        }
        k = k + 1;
    }
    return out;
}

pub fn fmt_l2_inst(i: L2Inst) -> str {
    match i {
        L2Inst::ConstInt(value, ty) => { return "const " + ir_type_to_str(ty) + " " + int_to_str(value); }
        L2Inst::ConstFloat(bits, ty) => { return "const " + ir_type_to_str(ty) + " #f:" + int_to_str(bits); }
        L2Inst::ConstBool(value) => { return "const bool " + bool_to_str(value); }
        L2Inst::ConstStr(value) => { return "const str \"" + escape_str(value) + "\""; }
        L2Inst::ConstNull(ty) => { return "const " + ir_type_to_str(ty) + " null"; }
        L2Inst::BinOp(op, left, right, ty) => { return "binop " + binop_debug_str(op) + " " + value_id_to_str(left) + ", " + value_id_to_str(right) + " -> " + ir_type_to_str(ty); }
        L2Inst::UnaryOp(op, operand, ty) => { return "unop " + unaryop_debug_str(op) + " " + value_id_to_str(operand) + " -> " + ir_type_to_str(ty); }
        L2Inst::Alloca(ty, reg) => { return "alloca " + mem_region_to_str(reg) + " " + ir_type_to_str(ty); }
        L2Inst::Load(ptr, ty) => { return "load " + ir_type_to_str(ty) + " " + value_id_to_str(ptr); }
        L2Inst::Store(ptr, value, _) => { return "store " + value_id_to_str(value) + " -> " + value_id_to_str(ptr); }
        L2Inst::GetFieldPtr(struct_ptr, field_index, field_ty) => { return "fieldptr " + value_id_to_str(struct_ptr) + " +" + int_to_str(field_index) + " -> *" + ir_type_to_str(field_ty); }
        L2Inst::GetElemPtr(array_ptr, index, elem_ty) => { return "elemptr " + value_id_to_str(array_ptr) + "[" + value_id_to_str(index) + "] -> *" + ir_type_to_str(elem_ty); }
        L2Inst::Jump(target) => { return "jmp " + block_id_to_str(target); }
        L2Inst::Branch(cond, then_b, else_b) => { return "br " + value_id_to_str(cond) + " ? " + block_id_to_str(then_b) + " : " + block_id_to_str(else_b); }
        L2Inst::Return(value) => {
            if value < 0 { return "ret"; }
            return "return " + value_id_to_str(value);
        }
        L2Inst::Unreachable => { return "unreachable"; }
        L2Inst::Call(func, args, ret_ty) => {
            var a: Vec<str> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() { a.push(value_id_to_str(args.get(ai))); ai = ai + 1; }
            return "call " + func + "(" + str_join(a, ", ") + ") -> " + ir_type_to_str(ret_ty);
        }
        L2Inst::CallPtr(fn_ptr, args, ret_ty, has_env) => {
            var a: Vec<str> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() { a.push(value_id_to_str(args.get(ai))); ai = ai + 1; }
            return "callptr " + value_id_to_str(fn_ptr) + "(" + str_join(a, ", ") + ") -> " + ir_type_to_str(ret_ty) + " env=" + bool_to_str(has_env);
        }
        L2Inst::DynCall(trait_name, method, args, ret_ty) => {
            var a: Vec<str> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() { a.push(value_id_to_str(args.get(ai))); ai = ai + 1; }
            return "dyncall " + trait_name + "::" + method + "(" + str_join(a, ", ") + ") -> " + ir_type_to_str(ret_ty);
        }
        L2Inst::MakeDyn(value, type_name, trait_name) => { return "makedyn " + value_id_to_str(value) + " as " + type_name + " for " + trait_name; }
        L2Inst::BitCast(value, from, to) => { return "bitcast " + value_id_to_str(value) + " " + ir_type_to_str(from) + " -> " + ir_type_to_str(to); }
        L2Inst::Copy(value, ty) => { return "copy " + value_id_to_str(value) + " -> " + ir_type_to_str(ty); }
        L2Inst::IntExtend(value, from, to) => { return "int_extend " + value_id_to_str(value) + " " + ir_type_to_str(from) + " -> " + ir_type_to_str(to); }
        L2Inst::IntTrunc(value, from, to) => { return "int_trunc " + value_id_to_str(value) + " " + ir_type_to_str(from) + " -> " + ir_type_to_str(to); }
        L2Inst::IntToFloat(value, from, to) => { return "int_to_float " + value_id_to_str(value) + " " + ir_type_to_str(from) + " -> " + ir_type_to_str(to); }
        L2Inst::FloatToInt(value, from, to) => { return "float_to_int " + value_id_to_str(value) + " " + ir_type_to_str(from) + " -> " + ir_type_to_str(to); }
        L2Inst::TryUnwrap(value, ok_dst, err_block, ok_block) => { return "try_unwrap " + value_id_to_str(value) + " -> " + value_id_to_str(ok_dst) + " ? " + block_id_to_str(ok_block) + " : " + block_id_to_str(err_block); }
        L2Inst::Print(value, ty) => { return "print " + ir_type_to_str(ty) + " " + value_id_to_str(value); }
        L2Inst::Panic(message) => { return "panic \"" + escape_str(message) + "\""; }
    }
    return "unknown";
}

// ─── L3 printer ──────────────────────────────────────────────────────────

fn print_l3_module(m: &L3Module) -> str {
    var out: str = "; ─── PIR Level 3 — Low (virtual registers, stack frame) ───\n";
    out = out + print_struct_layouts(m.struct_layouts);
    out = out + print_string_constants(m.string_constants);
    out = out + print_externs(m.extern_functions);
    var i: i64 = 0;
    while i < m.functions.len() {
        out = out + print_l3_function(m.functions.get(i));
        i = i + 1;
    }
    return out;
}

fn print_l3_function(f: &L3Function) -> str {
    var out: str = "\n; ─── function " + f.name + " (frame=" + int_to_str(f.frame_size) + " bytes) ───\n";
    var params: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < f.params.len() {
        params.push(vreg_to_str(f.params.get(i).vreg) + ": " + ir_type_to_str(f.params.get(i).ty));
        i = i + 1;
    }
    out = out + "fn " + f.name + "(" + str_join(params, ", ") + ") -> " + ir_type_to_str(f.ret_ty) + "\n{\n";
    var j: i64 = 0;
    while j < f.blocks.len() {
        out = out + print_l3_block(f.blocks.get(j));
        j = j + 1;
    }
    out = out + "}\n";
    return out;
}

fn print_l3_block(b: L3Block) -> str {
    var out: str = "  " + block_id_to_str(b.id) + ":";
    if b.params.len() > 0 {
        var p: Vec<str> = Vec::new();
        var i: i64 = 0;
        while i < b.params.len() {
            p.push(vreg_to_str(b.params.get(i).vreg) + ": " + ir_type_to_str(b.params.get(i).ty));
            i = i + 1;
        }
        out = out + " (" + str_join(p, ", ") + ")";
    }
    if b.predecessors.len() > 0 {
        var preds: Vec<str> = Vec::new();
        var j: i64 = 0;
        while j < b.predecessors.len() {
            preds.push(block_id_to_str(b.predecessors.get(j)));
            j = j + 1;
        }
        out = out + "  ; preds: " + str_join(preds, ", ");
    }
    out = out + "\n";
    var k: i64 = 0;
    while k < b.instructions.len() {
        out = out + "    " + fmt_l3_inst(b.instructions.get(k)) + "\n";
        k = k + 1;
    }
    return out;
}

pub fn fmt_l3_inst(i: L3Inst) -> str {
    match i {
        L3Inst::Mov(dst, src) => { return vreg_to_str(dst) + " = " + operand_to_str(src); }
        L3Inst::AddrOfSlot(dst, slot) => { return vreg_to_str(dst) + " = addrof " + slot_to_str(slot); }
        L3Inst::Bin(op, dst, a, b, ty) => { return vreg_to_str(dst) + " = " + binop_debug_str(op) + " " + operand_to_str(a) + ", " + operand_to_str(b) + "  ; " + ir_type_to_str(ty); }
        L3Inst::Unary(op, dst, src, ty) => { return vreg_to_str(dst) + " = " + unaryop_debug_str(op) + " " + operand_to_str(src) + "  ; " + ir_type_to_str(ty); }
        L3Inst::StackAlloc(dst, bytes, reg) => { return vreg_to_str(dst) + " = stackalloc " + mem_region_to_str(reg) + " " + int_to_str(bytes); }
        L3Inst::Load(dst, ptr, ty) => { return vreg_to_str(dst) + " = load " + ir_type_to_str(ty) + " " + operand_to_str(ptr); }
        L3Inst::Store(ptr, v, ty) => { return "store " + ir_type_to_str(ty) + " " + operand_to_str(v) + " -> " + operand_to_str(ptr); }
        L3Inst::FieldAddr(dst, base, offset, field_ty) => { return vreg_to_str(dst) + " = addr " + operand_to_str(base) + " +" + int_to_str(offset) + "  ; *" + ir_type_to_str(field_ty); }
        L3Inst::ElemAddr(dst, base, index, elem_ty) => { return vreg_to_str(dst) + " = addr " + operand_to_str(base) + "[" + operand_to_str(index) + "]  ; *" + ir_type_to_str(elem_ty); }
        L3Inst::Jmp(target) => { return "jmp " + block_id_to_str(target); }
        L3Inst::Br(cond, then_b, else_b) => { return "br " + operand_to_str(cond) + " ? " + block_id_to_str(then_b) + " : " + block_id_to_str(else_b); }
        L3Inst::Ret(value) => {
            match value {
                OptOperand::Some(v) => { return "return " + operand_to_str(v); }
                OptOperand::None => { return "ret"; }
            }
            return "ret";
        }
        L3Inst::Unreachable => { return "unreachable"; }
        L3Inst::Call(dst, target, args, ret_ty) => {
            var a: Vec<str> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() { a.push(operand_to_str(args.get(ai))); ai = ai + 1; }
            match dst {
                OptVReg::Some(d) => { return vreg_to_str(d) + " = call " + target + "(" + str_join(a, ", ") + ") -> " + ir_type_to_str(ret_ty); }
                OptVReg::None => { return "call " + target + "(" + str_join(a, ", ") + ")"; }
            }
            return "call " + target + "(" + str_join(a, ", ") + ")";
        }
        L3Inst::CallPtr(dst, fn_ptr, args, ret_ty, has_env) => {
            var a: Vec<str> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() { a.push(operand_to_str(args.get(ai))); ai = ai + 1; }
            match dst {
                OptVReg::Some(d) => { return vreg_to_str(d) + " = callptr " + operand_to_str(fn_ptr) + "(" + str_join(a, ", ") + ") -> " + ir_type_to_str(ret_ty) + " env=" + bool_to_str(has_env); }
                OptVReg::None => { return "callptr " + operand_to_str(fn_ptr) + "(" + str_join(a, ", ") + ") env=" + bool_to_str(has_env); }
            }
            return "callptr " + operand_to_str(fn_ptr) + "(" + str_join(a, ", ") + ")";
        }
        L3Inst::DynCall(dst, trait_name, method, args, ret_ty) => {
            var a: Vec<str> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() { a.push(operand_to_str(args.get(ai))); ai = ai + 1; }
            match dst {
                OptVReg::Some(d) => { return vreg_to_str(d) + " = dyncall " + trait_name + "::" + method + "(" + str_join(a, ", ") + ") -> " + ir_type_to_str(ret_ty); }
                OptVReg::None => { return "dyncall " + trait_name + "::" + method + "(" + str_join(a, ", ") + ")"; }
            }
            return "dyncall " + trait_name + "::" + method + "(" + str_join(a, ", ") + ")";
        }
        L3Inst::MakeDyn(dst, value, type_name, trait_name) => { return vreg_to_str(dst) + " = makedyn " + operand_to_str(value) + " as " + type_name + " for " + trait_name; }
        L3Inst::Cast(dst, src, from, to, kind) => { return vreg_to_str(dst) + " = " + cast_kind_to_str(kind) + " " + operand_to_str(src) + " " + ir_type_to_str(from) + " -> " + ir_type_to_str(to); }
        L3Inst::TryUnwrap(value, ok_dst, err_block, ok_block) => { return "try_unwrap " + operand_to_str(value) + " -> " + vreg_to_str(ok_dst) + " ? " + block_id_to_str(ok_block) + " : " + block_id_to_str(err_block); }
        L3Inst::Print(v, ty) => { return "print " + ir_type_to_str(ty) + " " + operand_to_str(v); }
        L3Inst::Panic(message) => { return "panic \"" + escape_str(message) + "\""; }
    }
    return "unknown";
}

// ─── Shared printer helpers ──────────────────────────────────────────────

fn print_struct_layouts(layouts: Vec<StructLayoutEntry>) -> str {
    if layouts.len() == 0 { return ""; }
    // Sort by name
    var sorted: Vec<StructLayoutEntry> = Vec::new();
    var names: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < layouts.len() {
        names.push(layouts.get(i).name);
        i = i + 1;
    }
    names = vec_sort_str(names);
    var out: str = "; ─── struct layouts ───\n";
    var j: i64 = 0;
    while j < names.len() {
        var k: i64 = 0;
        while k < layouts.len() {
            if str_equal(layouts.get(k).name, names.get(j)) {
                var l: StructLayout = layouts.get(k).layout;
                out = out + "struct " + l.name + " { size=" + int_to_str(l.size) + ", align=" + int_to_str(l.align) + "\n";
                var fi: i64 = 0;
                while fi < l.fields.len() {
                    var f: StringIrTypeOffset = l.fields.get(fi);
                    out = out + "  +" + int_to_str(f.offset) + " " + f.name + ": " + ir_type_to_str(f.ty) + "\n";
                    fi = fi + 1;
                }
                out = out + "}\n";
                break;
            }
            k = k + 1;
        }
        j = j + 1;
    }
    return out;
}

fn print_string_constants(strings: Vec<StringStringEntry>) -> str {
    if strings.len() == 0 { return ""; }
    var out: str = "; ─── string constants ───\n";
    var i: i64 = 0;
    while i < strings.len() {
        out = out + strings.get(i).val + " = \"" + escape_str(strings.get(i).key) + "\"\n";
        i = i + 1;
    }
    return out;
}

fn print_externs(externs: Vec<StringVecIrType>) -> str {
    if externs.len() == 0 { return ""; }
    var out: str = "; ─── extern functions ───\n";
    var i: i64 = 0;
    while i < externs.len() {
        var e: StringVecIrType = externs.get(i);
        var p: Vec<str> = Vec::new();
        var j: i64 = 0;
        while j < e.params.len() {
            p.push(ir_type_to_str(e.params.get(j)));
            j = j + 1;
        }
        out = out + "extern " + e.name + "(" + str_join(p, ", ") + ") -> " + ir_type_to_str(e.ret) + "\n";
        i = i + 1;
    }
    return out;
}

fn fmt_params(params: Vec<ValueIdType>) -> str {
    var parts: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < params.len() {
        parts.push(value_id_to_str(params.get(i).id) + ": " + ir_type_to_str(params.get(i).ty));
        i = i + 1;
    }
    return str_join(parts, ", ");
}

pub fn escape_str(s: str) -> str {
    var result: str = s;
    result = str_replace(result, "\\", "\\\\");
    result = str_replace(result, "\"", "\\\"");
    result = str_replace(result, "\n", "\\n");
    return result;
}

// Note: str_replace is provided by stdlib/core.fd

pub fn bool_to_str(b: bool) -> str {
    if b { return "true"; }
    return "false";
}

// ─── BinOp / UnaryOp debug strings ───────────────────────────────────────

pub fn binop_debug_str(op: BinOp) -> str {
    match op {
        BinOp::Add => { return "Add"; }
        BinOp::Sub => { return "Sub"; }
        BinOp::Mul => { return "Mul"; }
        BinOp::Div => { return "Div"; }
        BinOp::Mod => { return "Mod"; }
        BinOp::Eq => { return "Eq"; }
        BinOp::Neq => { return "Neq"; }
        BinOp::Lt => { return "Lt"; }
        BinOp::Gt => { return "Gt"; }
        BinOp::LtEq => { return "LtEq"; }
        BinOp::GtEq => { return "GtEq"; }
        BinOp::And => { return "And"; }
        BinOp::Or => { return "Or"; }
        BinOp::BitAnd => { return "BitAnd"; }
        BinOp::BitOr => { return "BitOr"; }
        BinOp::BitXor => { return "BitXor"; }
        BinOp::Shl => { return "Shl"; }
        BinOp::Shr => { return "Shr"; }
    }
    return "Unknown";
}

pub fn unaryop_debug_str(op: UnaryOp) -> str {
    match op {
        UnaryOp::Neg => { return "Neg"; }
        UnaryOp::Not => { return "Not"; }
        UnaryOp::BitNot => { return "BitNot"; }
    }
    return "Unknown";
}

// ─── String join helper ──────────────────────────────────────────────────

pub fn str_join(v: Vec<str>, sep: str) -> str {
    if v.len() == 0 { return ""; }
    var result: str = v.get(0);
    var i: i64 = 1;
    while i < v.len() {
        result = result + sep + v.get(i);
        i = i + 1;
    }
    return result;
}

// Note: str_replace is provided by stdlib/core.fd

// ═══════════════════════════════════════════════════════════════════════════
// Public accessors for tests / future optimizer passes
// ═══════════════════════════════════════════════════════════════════════════

// Build all three PIR levels from an IrModule.
pub fn build_all(module: &IrModule) -> PirAllLevels {
    var l1: L1Module = lower_ir_to_l1(module);
    var l2: L2Module = lower_l1_to_l2(&l1);
    var l3: L3Module = lower_l2_to_l3(&l2, module);
    return PirAllLevels_new(l1, l2, l3);
}

pub struct PirAllLevels {
    pub l1: L1Module,
    pub l2: L2Module,
    pub l3: L3Module,
}

pub fn PirAllLevels_new(l1: L1Module, l2: L2Module, l3: L3Module) -> PirAllLevels {
    return PirAllLevels { l1: l1, l2: l2, l3: l3 };
}

// ═══════════════════════════════════════════════════════════════════════════
// Missing helper functions
// ═══════════════════════════════════════════════════════════════════════════

// Sort Vec<str> — returns a new sorted Vec (Fides &mut doesn't propagate)
fn vec_sort_str(v: Vec<str>) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        result.push(v.get(i));
        i = i + 1;
    }
    // Insertion sort on the copy
    var n: i64 = result.len();
    var j: i64 = 1;
    while j < n {
        var key: str = result.get(j);
        var k: i64 = j - 1;
        while k >= 0 {
            if str_compare(result.get(k), key) <= 0 { break; }
            result.set(k + 1, result.get(k));
            k = k - 1;
        }
        result.set(k + 1, key);
        j = j + 1;
    }
    return result;
}

// Sort Vec<i64> — returns a new sorted Vec
fn vec_sort_i64(v: Vec<i64>) -> Vec<i64> {
    var result: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        result.push(v.get(i));
        i = i + 1;
    }
    var n: i64 = result.len();
    var j: i64 = 1;
    while j < n {
        var key: i64 = result.get(j);
        var k: i64 = j - 1;
        while k >= 0 {
            if result.get(k) <= key { break; }
            result.set(k + 1, result.get(k));
            k = k - 1;
        }
        result.set(k + 1, key);
        j = j + 1;
    }
    return result;
}

// String comparison: returns -1, 0, or 1 (uses core::str_compare)
// Note: str_compare is provided by stdlib/core.fd

// Check if IrModule has a function with the given name
fn IrModule_has_function(module: &IrModule, name: str) -> bool {
    var i: i64 = 0;
    while i < module.functions.len() {
        if str_equal(module.functions.get(i).name, name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// String substring — extract a substring of length `len` starting at `start`
fn str_substring(s: str, start: i64, len: i64) -> str {
    // Fides str doesn't have direct char indexing; str_replace from core
    // handles the escaping we need. This is a stub for completeness.
    return s;
}
