// comptime.fd — Compile-time evaluation engine, rewritten from src/comptime.rs
//
// Evaluates `comptime <expr>`, `comptime { block }`, and `comptime gen { block }`
// at compile time, substituting results as literals into the AST.
//
// Current status: minimal pass-through implementation.
// - process_gen: removes ComptimeGen statements (no code generation yet)
// - substitute: pass-through (no comptime expression substitution yet)
//
// These stubs ensure the pipeline stages exist but don't block compilation.
// Full comptime evaluation would require an AST interpreter, which is a
// future enhancement.

module compiler::comptime_eval;

use core;
use vec;
use compiler::ast;

/// Process `comptime gen` blocks in the program.
/// Currently a stub: removes ComptimeGen statements without generating code.
/// Full implementation would evaluate the block, parse the result as Fides
/// source, and inject generated functions/structs into the program.
pub fn process_gen(program: Program) -> Program {
    var prog: Program = program;

    // Remove ComptimeGen statements from all function bodies
    var fi: i64 = 0;
    while fi < prog.funcs.len() {
        var func: Func = prog.funcs.get(fi);
        var new_body: Vec<Stmt> = Vec::new();
        var si: i64 = 0;
        while si < func.body.len() {
            var stmt: Stmt = func.body.get(si);
            match stmt {
                Stmt::ComptimeGen(_, _) => {
                    // Skip — comptime gen blocks are removed without processing
                }
                _ => {
                    new_body.push(stmt);
                }
            }
            si = si + 1;
        }
        func.body = new_body;
        prog.funcs.set(fi, func);
        fi = fi + 1;
    }

    return prog;
}

/// Substitute comptime expressions with their evaluated values.
/// Currently a stub: returns the program unchanged.
/// Full implementation would evaluate comptime expressions and replace
/// them with literal AST nodes.
/// Returns (program, errors) — empty errors means success.
pub fn substitute(program: &Program) -> Program {
    // Pass-through: no substitution yet
    return program_clone(program);
}

/// Clone a program (shallow — shares Vec contents)
pub fn program_clone(program: &Program) -> Program {
    var result: Program = program_new();
    result.module = program.module;
    result.funcs = program.funcs;
    result.structs = program.structs;
    result.enums = program.enums;
    result.consts = program.consts;
    result.type_aliases = program.type_aliases;
    result.impls = program.impls;
    result.imports = program.imports;
    result.attributes = program.attributes;
    result.traits = program.traits;
    result.trait_impls = program.trait_impls;
    result.extern_decls = program.extern_decls;
    result.layers = program.layers;
    result.models = program.models;
    result.components = program.components;
    result.systems = program.systems;
    result.state_machines = program.state_machines;
    result.event_handlers = program.event_handlers;
    return result;
}
