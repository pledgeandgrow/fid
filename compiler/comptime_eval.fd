// comptime_eval.fd -- Compile-time evaluation engine, ported from src/comptime.rs
//
// Evuates `comptime <expr>`, `comptime { block }`, and `comptime reflect_op(T)`
// at compile time, substituting results as literals into the AST.
//
// Comptime functions (`comptime fn name(...) { ... }`) are evaluated by
// directly interpreting their AST bodies when called from a comptime context.

module compiler::comptime_eval;

use core;
use vec;
use string;
use compiler::ast;
use compiler::token;
use compiler::lexer;
use compiler::parser;

// --- Box helpers ---------------------------------------------------------
// Each module defines its own box_expr_unbox because Fides has no trait-based
// generic unbox. This mirrors the pattern in lower.fd, typechecker.fd, etc.

pub fn ct_box_expr_unbox(b: Box<Expr>) -> Expr {
    match b {
        Expr::IntLit(v) => { return Expr::IntLit(v); }
        Expr::FloatLit(v) => { return Expr::FloatLit(v); }
        Expr::StringLit(v) => { return Expr::StringLit(v); }
        Expr::BoolLit(v) => { return Expr::BoolLit(v); }
        Expr::Ident(n) => { return Expr::Ident(n); }
        Expr::Binary(op, l, r) => { return Expr::Binary(op, l, r); }
        Expr::Unary(op, e) => { return Expr::Unary(op, e); }
        Expr::Call(n, a) => { return Expr::Call(n, a); }
        Expr::FieldAccess(e, f) => { return Expr::FieldAccess(e, f); }
        Expr::OptionalFieldAccess(e, f) => { return Expr::OptionalFieldAccess(e, f); }
        Expr::StructLit(n, f, s) => { return Expr::StructLit(n, f, s); }
        Expr::If(c, t, e) => { return Expr::If(c, t, e); }
        Expr::Range(a, b, i) => { return Expr::Range(a, b, i); }
        Expr::Block(s) => { return Expr::Block(s); }
        Expr::MethodCall(r, m, a) => { return Expr::MethodCall(r, m, a); }
        Expr::ArrayLit(e, a) => { return Expr::ArrayLit(e, a); }
        Expr::Index(a, i) => { return Expr::Index(a, i); }
        Expr::FString(p) => { return Expr::FString(p); }
        Expr::Match(e, a) => { return Expr::Match(e, a); }
        Expr::EnumLit(en, v, a) => { return Expr::EnumLit(en, v, a); }
        Expr::Ref(e, m) => { return Expr::Ref(e, m); }
        Expr::Deref(e) => { return Expr::Deref(e); }
        Expr::StrConcat(l, r) => { return Expr::StrConcat(l, r); }
        Expr::Try(e) => { return Expr::Try(e); }
        Expr::Coalesce(l, r) => { return Expr::Coalesce(l, r); }
        Expr::IsCheck(e, n) => { return Expr::IsCheck(e, n); }
        Expr::TryBlock(s) => { return Expr::TryBlock(s); }
        Expr::TupleLit(e) => { return Expr::TupleLit(e); }
        Expr::Closure(p, b, r) => { return Expr::Closure(p, b, r); }
        Expr::Cast(e, ty) => { return Expr::Cast(e, ty); }
        Expr::Asm(s, o) => { return Expr::Asm(s, o); }
        Expr::Comptime(e) => { return Expr::Comptime(e); }
        Expr::ComptimeBlock(s) => { return Expr::ComptimeBlock(s); }
        Expr::ComptimeReflect(n, a) => { return Expr::ComptimeReflect(n, a); }
        Expr::PipeForward(l, r) => { return Expr::PipeForward(l, r); }
        Expr::QuantCast(e, ty) => { return Expr::QuantCast(e, ty); }
        Expr::Await(e) => { return Expr::Await(e); }
        Expr::Spawn(e) => { return Expr::Spawn(e); }
        Expr::Yield(e) => { return Expr::Yield(e); }
        Expr::NamedArg(name, e) => { return Expr::NamedArg(name, e); }
    }
    return Expr::IntLit(0);
}

// --- Comptime environment ------------------------------------------------
// Fides has no HashMap at compile time, so we use parallel Vecs.

pub struct ComptimeEnv {
    pub names: Vec<str>,
    pub values: Vec<Expr>,
}

pub fn ComptimeEnv_new() -> ComptimeEnv {
    return ComptimeEnv { names: Vec::new(), values: Vec::new() };
}

pub fn ComptimeEnv_get(env: &ComptimeEnv, name: str) -> OptExpr {
    var i: i64 = 0;
    while i < env.names.len() {
        if env.names.get(i) == name {
            return OptExpr::Some(env.values.get(i));
        }
        i = i + 1;
    }
    return OptExpr::None;
}

pub fn ComptimeEnv_set(env: &mut ComptimeEnv, name: str, v: Expr) {
    var i: i64 = 0;
    while i < env.names.len() {
        if env.names.get(i) == name {
            env.values.set(i, v);
            return;
        }
        i = i + 1;
    }
    env.names.push(name);
    env.values.push(v);
}

pub fn ComptimeEnv_clone(env: &ComptimeEnv) -> ComptimeEnv {
    var new_env: ComptimeEnv = ComptimeEnv_new();
    var i: i64 = 0;
    while i < env.names.len() {
        new_env.names.push(env.names.get(i));
        new_env.values.push(env.values.get(i));
        i = i + 1;
    }
    return new_env;
}

// --- Result type for comptime evuation ---------------------------------

pub enum OptExpr {
    Some(Expr),
    None,
}

pub enum ResultExpr {
    Ok(Expr),
    Err(str),
}

// --- process_gen ---------------------------------------------------------
// Process `comptime gen` blocks: evaluate them, parse the result as Fides
// source, and inject generated functions/structs into the program.

pub fn process_gen(program: Program) -> Program {
    var prog: Program = program;

    // First, substitute comptime expressions inside comptime gen blocks
    var errs: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < prog.funcs.len() {
        substitute_comptime_gen_blocks(&mut prog.funcs, fi, &prog, &mut errs);
        fi = fi + 1;
    }

    // Now process the gen blocks
    var generated_funcs: Vec<Func> = Vec::new();
    var generated_structs: Vec<StructDef> = Vec::new();
    var func_count: i64 = prog.funcs.len();
    var idx: i64 = 0;
    while idx < func_count {
        process_comptime_gen_in_func(&mut prog.funcs, idx, &prog, &mut generated_funcs, &mut generated_structs, &mut errs);
        idx = idx + 1;
    }

    // Append generated funcs/structs
    var gi: i64 = 0;
    while gi < generated_funcs.len() {
        prog.funcs.push(generated_funcs.get(gi));
        gi = gi + 1;
    }
    var si: i64 = 0;
    while si < generated_structs.len() {
        prog.structs.push(generated_structs.get(si));
        si = si + 1;
    }

    return prog;
}

fn substitute_comptime_gen_blocks(funcs: &mut Vec<Func>, idx: i64, original: &Program, errs: &mut Vec<str>) {
    var func: Func = funcs.get(idx);
    var si: i64 = 0;
    while si < func.body.len() {
        match func.body.get(si) {
            Stmt::ComptimeGen(block, _) => {
                var block_copy: Vec<Stmt> = block;
                substitute_stmts(&mut block_copy, original, errs);
                func.body.set(si, Stmt::ComptimeGen(block_copy, 0));
            }
            _ => {}
        }
        si = si + 1;
    }
    funcs.set(idx, func);
}

fn process_comptime_gen_in_func(funcs: &mut Vec<Func>, idx: i64, original: &Program, generated_funcs: &mut Vec<Func>, generated_structs: &mut Vec<StructDef>, errs: &mut Vec<str>) {
    var func: Func = funcs.get(idx);
    var new_body: Vec<Stmt> = Vec::new();
    var si: i64 = 0;
    while si < func.body.len() {
        match func.body.get(si) {
            Stmt::ComptimeGen(block, line) => {
                var result: ResultExpr = evaluate_block(block, original);
                match result {
                    ResultExpr::Ok(v) => {
                        match v {
                            Expr::StringLit(source) => {
                                var parse_result: OptProgram = parse_generated_code(source);
                                match parse_result {
                                    OptProgram::Some(gen_prog) => {
                                        var gfi: i64 = 0;
                                        while gfi < gen_prog.funcs.len() {
                                            generated_funcs.push(gen_prog.funcs.get(gfi));
                                            gfi = gfi + 1;
                                        }
                                        var gsi: i64 = 0;
                                        while gsi < gen_prog.structs.len() {
                                            generated_structs.push(gen_prog.structs.get(gsi));
                                            gsi = gsi + 1;
                                        }
                                    }
                                    OptProgram::None => {
                                        errs.push("comptime gen: failed to parse generated code");
                                    }
                                }
                            }
                            _ => {
                                errs.push("comptime gen: block must evaluate to a string");
                            }
                        }
                    }
                    ResultExpr::Err(msg) => {
                        errs.push("comptime gen error: " + msg);
                    }
                }
            }
            other => { new_body.push(other); }
        }
        si = si + 1;
    }
    func.body = new_body;
    funcs.set(idx, func);
}

pub enum OptProgram {
    Some(Program),
    None,
}

fn parse_generated_code(source: str) -> OptProgram {
    var lex: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lex.tokenize();
    var parser_obj: Parser = Parser_new(tokens);
    var result: ParseResultProgram = parser_obj.parse();
    match result {
        ParseResultProgram::Ok(prog) => { return OptProgram::Some(prog); }
        ParseResultProgram::Err(_) => { return OptProgram::None; }
    }
    return OptProgram::None;
}

// --- substitute ----------------------------------------------------------
// Recursively substitute every comptime expression in the program with an
// AST literal carrying its compile-time value.

pub fn substitute(program: Program) -> Program {
    var prog: Program = program;
    var errs: Vec<str> = Vec::new();
    // Compile time (CS4): a function with no node a phase rewrites is left
    // as it is, not rebuilt 13 times. A function without comptime nodes gets
    // none from substitution, and one without phase 3's patterns (an `if`
    // on a bool literal, a `for` over a literal range, a call to a comptime
    // fn) gets none from phase 3, so the result is the same; the scans visit
    // the variants the phases visit. FID_CT_FULL=1: every function, as before.
    var ct_full_env: str = p_getenv("FID_CT_FULL");
    var full: bool = (ct_full_env as i64) != 0 && str_len(ct_full_env) > 0;
    var need: Vec<bool> = Vec::new();
    var ni: i64 = 0;
    while ni < prog.funcs.len() {
        need.push(full || ct_scan_stmts_sub(prog.funcs.get(ni).body));
        ni = ni + 1;
    }

    // Phase 1: Pre-substitute comptime expressions inside comptime function bodies
    var iter: i64 = 0;
    while iter < 8 {
        var fi: i64 = 0;
        while fi < prog.funcs.len() {
            if need.get(fi) { substitute_func(&mut prog.funcs, fi, &prog, &mut errs); }
            fi = fi + 1;
        }
        iter = iter + 1;
    }

    // Phase 2: Substitute comptime expressions everywhere
    var fi2: i64 = 0;
    while fi2 < prog.funcs.len() {
        if need.get(fi2) { substitute_func(&mut prog.funcs, fi2, &prog, &mut errs); }
        fi2 = fi2 + 1;
    }

    // Phase 3: Aggressive comptime evuation -- auto-evaluate calls to
    // comptime fn functions when ALL arguments are literals
    ct_comptime_fns = HashMap_new();
    var cf: i64 = 0;
    while cf < prog.funcs.len() {
        if prog.funcs.get(cf).is_comptime {
            HashMap_insert(ct_comptime_fns, prog.funcs.get(cf).name, 1);
        }
        cf = cf + 1;
    }
    var need3: Vec<bool> = Vec::new();
    var nj: i64 = 0;
    while nj < prog.funcs.len() {
        need3.push(full || ct_scan_stmts_aggr(prog.funcs.get(nj).body));
        nj = nj + 1;
    }
    var iter2: i64 = 0;
    while iter2 < 4 {
        var fi3: i64 = 0;
        while fi3 < prog.funcs.len() {
            if need3.get(fi3) { aggressive_comptime_func(&mut prog.funcs, fi3, &prog); }
            fi3 = fi3 + 1;
        }
        iter2 = iter2 + 1;
    }

    return prog;
}

// --- Which functions a phase can change (read-only scans) -----------------
// Each visits at least the variants its phase visits, so `false` means the
// phase leaves the function as it is.

/// Phases 1-2: a comptime expression or a ComptimeGen statement.
fn ct_scan_stmts_sub(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        if ct_scan_stmt_sub(stmts.get(i)) { return true; }
        i = i + 1;
    }
    return false;
}

fn ct_scan_opt_sub(o: OptStmts) -> bool {
    match o {
        OptStmts::Some(b) => { return ct_scan_stmts_sub(b); }
        OptStmts::None => {}
    }
    return false;
}

fn ct_scan_arms_sub(arms: Vec<MatchArm>) -> bool {
    var i: i64 = 0;
    while i < arms.len() {
        if ct_scan_stmts_sub(arms.get(i).body) { return true; }
        i = i + 1;
    }
    return false;
}

fn ct_scan_stmt_sub(stmt: Stmt) -> bool {
    match stmt {
        Stmt::Let(_, _, e, _, _, _, _) => { return ct_scan_expr_sub(e); }
        Stmt::LetTuple(_, e, _) => { return ct_scan_expr_sub(e); }
        Stmt::Assign(_, _, e, _) => { return ct_scan_expr_sub(e); }
        Stmt::IndexAssign(_, ix, _, e, _) => { return ct_scan_expr_sub(ix) || ct_scan_expr_sub(e); }
        Stmt::DerefAssign(pe, _, e, _) => { return ct_scan_expr_sub(pe) || ct_scan_expr_sub(e); }
        Stmt::FieldAssign(ob, _, _, e, _) => { return ct_scan_expr_sub(ob) || ct_scan_expr_sub(e); }
        Stmt::Expr(e, _) => { return ct_scan_expr_sub(e); }
        Stmt::Return(opt, _) => {
            match opt {
                OptBoxExpr::Some(b) => { return ct_scan_expr_sub(ct_box_expr_unbox(b)); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(c, t, e, _) => { return ct_scan_expr_sub(c) || ct_scan_stmts_sub(t) || ct_scan_opt_sub(e); }
        Stmt::While(c, b, _) => { return ct_scan_expr_sub(c) || ct_scan_stmts_sub(b); }
        Stmt::For(_, it, b, _) => { return ct_scan_expr_sub(it) || ct_scan_stmts_sub(b); }
        Stmt::Match(e, arms, _) => { return ct_scan_expr_sub(e) || ct_scan_arms_sub(arms); }
        Stmt::Defer(b, _) => { return ct_scan_stmts_sub(b); }
        Stmt::Txn(b, _) => { return ct_scan_stmts_sub(b); }
        Stmt::RegionBlock(_, _, _, _, _, b, _) => { return ct_scan_stmts_sub(b); }
        Stmt::Sandbox(b, _) => { return ct_scan_stmts_sub(b); }
        Stmt::Unsafe(b, _) => { return ct_scan_stmts_sub(b); }
        Stmt::ComptimeGen(_, _) => { return true; }
        Stmt::Handle(b, hs, _) => {
            if ct_scan_stmts_sub(b) { return true; }
            var hi: i64 = 0;
            while hi < hs.len() {
                if ct_scan_stmts_sub(hs.get(hi).body) { return true; }
                hi = hi + 1;
            }
        }
        Stmt::Query(_, b, _) => { return ct_scan_stmts_sub(b); }
        Stmt::Parallel(brs, _) => {
            var bi: i64 = 0;
            while bi < brs.len() {
                if ct_scan_stmts_sub(brs.get(bi)) { return true; }
                bi = bi + 1;
            }
        }
        Stmt::Backward(l, _) => { return ct_scan_expr_sub(l); }
        Stmt::Resume(c, v, _) => { return ct_scan_expr_sub(c) || ct_scan_expr_sub(v); }
        Stmt::SpawnScope(b, _) => { return ct_scan_stmts_sub(b); }
        _ => {}
    }
    return false;
}

fn ct_scan_exprs_sub(es: Vec<Expr>) -> bool {
    var i: i64 = 0;
    while i < es.len() {
        if ct_scan_expr_sub(es.get(i)) { return true; }
        i = i + 1;
    }
    return false;
}

fn ct_scan_expr_sub(expr: Expr) -> bool {
    match expr {
        Expr::Binary(_, l, r) => { return ct_scan_expr_sub(ct_box_expr_unbox(l)) || ct_scan_expr_sub(ct_box_expr_unbox(r)); }
        Expr::Unary(_, e) => { return ct_scan_expr_sub(ct_box_expr_unbox(e)); }
        Expr::Call(_, args) => { return ct_scan_exprs_sub(args); }
        Expr::MethodCall(r, _, args) => { return ct_scan_expr_sub(ct_box_expr_unbox(r)) || ct_scan_exprs_sub(args); }
        Expr::FieldAccess(e, _) => { return ct_scan_expr_sub(ct_box_expr_unbox(e)); }
        Expr::StructLit(_, fields, _) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                if ct_scan_expr_sub(fields.get(fi).value) { return true; }
                fi = fi + 1;
            }
        }
        Expr::If(c, t, e) => { return ct_scan_expr_sub(c) || ct_scan_stmts_sub(t) || ct_scan_opt_sub(e); }
        Expr::Block(b) => { return ct_scan_stmts_sub(b); }
        Expr::Index(a, i) => { return ct_scan_expr_sub(ct_box_expr_unbox(a)) || ct_scan_expr_sub(ct_box_expr_unbox(i)); }
        Expr::ArrayLit(_, els) => { return ct_scan_exprs_sub(els); }
        Expr::Match(e, arms) => { return ct_scan_expr_sub(e) || ct_scan_arms_sub(arms); }
        Expr::Range(a, b, _) => { return ct_scan_expr_sub(ct_box_expr_unbox(a)) || ct_scan_expr_sub(ct_box_expr_unbox(b)); }
        Expr::Ref(e, _) => { return ct_scan_expr_sub(ct_box_expr_unbox(e)); }
        Expr::Deref(e) => { return ct_scan_expr_sub(ct_box_expr_unbox(e)); }
        Expr::StrConcat(l, r) => { return ct_scan_expr_sub(ct_box_expr_unbox(l)) || ct_scan_expr_sub(ct_box_expr_unbox(r)); }
        Expr::Cast(e, _) => { return ct_scan_expr_sub(ct_box_expr_unbox(e)); }
        Expr::Comptime(_) => { return true; }
        Expr::ComptimeBlock(_) => { return true; }
        Expr::ComptimeReflect(_, _) => { return true; }
        _ => {}
    }
    return false;
}

/// Phase 3: an `if` on a bool literal, a `for` over a literal range, or a
/// call to a comptime fn (ct_comptime_fns), where phase 3 looks.
fn ct_scan_stmts_aggr(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        if ct_scan_stmt_aggr(stmts.get(i)) { return true; }
        i = i + 1;
    }
    return false;
}

fn ct_scan_stmt_aggr(stmt: Stmt) -> bool {
    match stmt {
        Stmt::Let(_, _, e, _, _, _, _) => { return ct_scan_expr_aggr(e); }
        Stmt::Assign(_, _, e, _) => { return ct_scan_expr_aggr(e); }
        Stmt::Expr(e, _) => { return ct_scan_expr_aggr(e); }
        Stmt::Return(opt, _) => {
            match opt {
                OptBoxExpr::Some(b) => { return ct_scan_expr_aggr(ct_box_expr_unbox(b)); }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(c, t, e, _) => {
            match c {
                Expr::BoolLit(_) => { return true; }
                _ => {}
            }
            if ct_scan_expr_aggr(c) || ct_scan_stmts_aggr(t) { return true; }
            match e {
                OptStmts::Some(eb) => { return ct_scan_stmts_aggr(eb); }
                OptStmts::None => {}
            }
        }
        Stmt::For(_, it, b, _) => {
            match it {
                Expr::Range(a, z, _) => {
                    var a2: Expr = ct_box_expr_unbox(a);
                    var z2: Expr = ct_box_expr_unbox(z);
                    var lit_a: bool = false;
                    var lit_z: bool = false;
                    match a2 { Expr::IntLit(_) => { lit_a = true; } _ => {} }
                    match z2 { Expr::IntLit(_) => { lit_z = true; } _ => {} }
                    if lit_a && lit_z { return true; }
                }
                _ => {}
            }
            return ct_scan_expr_aggr(it) || ct_scan_stmts_aggr(b);
        }
        Stmt::While(c, b, _) => { return ct_scan_expr_aggr(c) || ct_scan_stmts_aggr(b); }
        _ => {}
    }
    return false;
}

fn ct_scan_expr_aggr(expr: Expr) -> bool {
    match expr {
        Expr::Binary(_, l, r) => { return ct_scan_expr_aggr(ct_box_expr_unbox(l)) || ct_scan_expr_aggr(ct_box_expr_unbox(r)); }
        Expr::Unary(_, e) => { return ct_scan_expr_aggr(ct_box_expr_unbox(e)); }
        Expr::Call(callee, args) => {
            if HashMap_get(ct_comptime_fns, callee) != 0 { return true; }
            var ai: i64 = 0;
            while ai < args.len() {
                if ct_scan_expr_aggr(args.get(ai)) { return true; }
                ai = ai + 1;
            }
        }
        Expr::MethodCall(r, _, args) => {
            if ct_scan_expr_aggr(ct_box_expr_unbox(r)) { return true; }
            var mi: i64 = 0;
            while mi < args.len() {
                if ct_scan_expr_aggr(args.get(mi)) { return true; }
                mi = mi + 1;
            }
        }
        _ => {}
    }
    return false;
}

fn substitute_func(funcs: &mut Vec<Func>, idx: i64, original: &Program, errs: &mut Vec<str>) {
    var func: Func = funcs.get(idx);
    var si: i64 = 0;
    while si < func.body.len() {
        var stmt: Stmt = func.body.get(si);
        substitute_stmt(&mut stmt, original, errs);
        func.body.set(si, stmt);
        si = si + 1;
    }
    funcs.set(idx, func);
}

fn substitute_stmts(stmts: &mut Vec<Stmt>, original: &Program, errs: &mut Vec<str>) {
    var si: i64 = 0;
    while si < stmts.len() {
        var stmt: Stmt = stmts.get(si);
        substitute_stmt(&mut stmt, original, errs);
        stmts.set(si, stmt);
        si = si + 1;
    }
}

fn substitute_stmt(stmt: &mut Stmt, original: &Program, errs: &mut Vec<str>) {
    // A match binding is a copy of the payload: substitute into the copy,
    // then rebuild the statement so the result is kept.
    match stmt {
        Stmt::Let(lname, lty, expr, lmut, lpersist, lann, lline) => {
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::Let(lname, lty, expr, lmut, lpersist, lann, lline);
        }
        Stmt::LetTuple(tnames, expr, tline) => {
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::LetTuple(tnames, expr, tline);
        }
        Stmt::Assign(aname, aop, expr, aline) => {
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::Assign(aname, aop, expr, aline);
        }
        Stmt::IndexAssign(iname, index, iop, expr, iline) => {
            substitute_expr(&mut index, original, errs);
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::IndexAssign(iname, index, iop, expr, iline);
        }
        Stmt::DerefAssign(ptr_expr, dop, expr, dline) => {
            substitute_expr(&mut ptr_expr, original, errs);
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::DerefAssign(ptr_expr, dop, expr, dline);
        }
        Stmt::FieldAssign(object, ffield, fop, expr, fline) => {
            substitute_expr(&mut object, original, errs);
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::FieldAssign(object, ffield, fop, expr, fline);
        }
        Stmt::Expr(e, eline) => {
            substitute_expr(&mut e, original, errs);
            *stmt = Stmt::Expr(e, eline);
        }
        Stmt::Return(opt, rline) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    var inner: Expr = ct_box_expr_unbox(e);
                    substitute_expr(&mut inner, original, errs);
                    *stmt = Stmt::Return(OptBoxExpr::Some(box_expr_new(inner)), rline);
                }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, iline2) => {
            substitute_expr(&mut cond, original, errs);
            substitute_stmts(&mut then_block, original, errs);
            match else_block {
                OptStmts::Some(eb) => { substitute_stmts(&mut eb, original, errs); }
                OptStmts::None => {}
            }
            *stmt = Stmt::If(cond, then_block, else_block, iline2);
        }
        Stmt::While(cond, body, wline) => {
            substitute_expr(&mut cond, original, errs);
            substitute_stmts(&mut body, original, errs);
            *stmt = Stmt::While(cond, body, wline);
        }
        Stmt::For(fvar, iterator, body, forline) => {
            substitute_expr(&mut iterator, original, errs);
            substitute_stmts(&mut body, original, errs);
            *stmt = Stmt::For(fvar, iterator, body, forline);
        }
        Stmt::Match(expr, arms, mline) => {
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::Match(expr, arms, mline);
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                substitute_stmts(&mut arm.body, original, errs);
                arms.set(ai, arm);
                ai = ai + 1;
            }
        }
        Stmt::Defer(body, _) => { substitute_stmts(&mut body, original, errs); }
        Stmt::Txn(body, _) => { substitute_stmts(&mut body, original, errs); }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => { substitute_stmts(&mut body, original, errs); }
        Stmt::Sandbox(body, _) => { substitute_stmts(&mut body, original, errs); }
        Stmt::Unsafe(body, _) => { substitute_stmts(&mut body, original, errs); }
        Stmt::ComptimeGen(block, _) => { substitute_stmts(&mut block, original, errs); }
        Stmt::Handle(body, handlers, _) => {
            substitute_stmts(&mut body, original, errs);
            var hi: i64 = 0;
            while hi < handlers.len() {
                var h: EffectHandler = handlers.get(hi);
                substitute_stmts(&mut h.body, original, errs);
                handlers.set(hi, h);
                hi = hi + 1;
            }
        }
        Stmt::Query(_, body, _) => { substitute_stmts(&mut body, original, errs); }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                substitute_stmts(&mut branch, original, errs);
                branches.set(bi, branch);
                bi = bi + 1;
            }
        }
        Stmt::Backward(loss, _) => { substitute_expr(&mut loss, original, errs); }
        Stmt::Resume(cont, value, _) => {
            substitute_expr(&mut cont, original, errs);
            substitute_expr(&mut value, original, errs);
        }
        Stmt::SpawnScope(body, _) => { substitute_stmts(&mut body, original, errs); }
        Stmt::CancelScope(_) => {}
        _ => {}
    }
}

fn substitute_expr(expr: &mut Expr, original: &Program, errs: &mut Vec<str>) {
    match expr {
        Expr::Binary(op, left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            substitute_expr(&mut l, original, errs);
            substitute_expr(&mut r, original, errs);
            *expr = Expr::Binary(op, box_expr_new(l), box_expr_new(r));
        }
        Expr::Unary(op, inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::Unary(op, box_expr_new(e));
        }
        Expr::Call(_, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                substitute_expr(&mut a, original, errs);
                args.set(ai, a);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(receiver, mname, args) => {
            var r: Expr = ct_box_expr_unbox(receiver);
            substitute_expr(&mut r, original, errs);
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                substitute_expr(&mut a, original, errs);
                args.set(ai, a);
                ai = ai + 1;
            }
            *expr = Expr::MethodCall(box_expr_new(r), mname, args);
        }
        Expr::FieldAccess(inner, field) => {
            var e: Expr = ct_box_expr_unbox(inner);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::FieldAccess(box_expr_new(e), field);
        }
        Expr::StructLit(_, fields, _) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                var f: FieldInit = fields.get(fi);
                substitute_expr(&mut f.value, original, errs);
                fields.set(fi, f);
                fi = fi + 1;
            }
        }
        Expr::If(cond, then_block, else_block) => {
            substitute_expr(&mut cond, original, errs);
            substitute_stmts(&mut then_block, original, errs);
            match else_block {
                OptStmts::Some(eb) => { substitute_stmts(&mut eb, original, errs); }
                OptStmts::None => {}
            }
        }
        Expr::Block(stmts) => { substitute_stmts(&mut stmts, original, errs); }
        Expr::Index(array, index) => {
            var a: Expr = ct_box_expr_unbox(array);
            var i: Expr = ct_box_expr_unbox(index);
            substitute_expr(&mut a, original, errs);
            substitute_expr(&mut i, original, errs);
            *expr = Expr::Index(box_expr_new(a), box_expr_new(i));
        }
        Expr::ArrayLit(_, elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                var e: Expr = elements.get(ei);
                substitute_expr(&mut e, original, errs);
                elements.set(ei, e);
                ei = ei + 1;
            }
        }
        Expr::Match(inner, arms) => {
            substitute_expr(&mut inner, original, errs);
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                substitute_stmts(&mut arm.body, original, errs);
                arms.set(ai, arm);
                ai = ai + 1;
            }
        }
        Expr::Range(start, end, inclusive) => {
            var s: Expr = ct_box_expr_unbox(start);
            var e: Expr = ct_box_expr_unbox(end);
            substitute_expr(&mut s, original, errs);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::Range(box_expr_new(s), box_expr_new(e), inclusive);
        }
        Expr::Ref(inner, is_mut) => {
            var e: Expr = ct_box_expr_unbox(inner);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::Ref(box_expr_new(e), is_mut);
        }
        Expr::Deref(inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::Deref(box_expr_new(e));
        }
        Expr::StrConcat(left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            substitute_expr(&mut l, original, errs);
            substitute_expr(&mut r, original, errs);
            *expr = Expr::StrConcat(box_expr_new(l), box_expr_new(r));
        }
        Expr::Cast(inner, ty) => {
            var e: Expr = ct_box_expr_unbox(inner);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::Cast(box_expr_new(e), ty);
        }
        Expr::Comptime(inner) => { substitute_expr_comptime(expr, inner, original, errs); }
        Expr::ComptimeBlock(stmts) => { substitute_expr_comptime_block(expr, &mut stmts, original, errs); }
        Expr::ComptimeReflect(op, ty) => { substitute_expr_comptime_reflect(expr, op, ty, original, errs); }
        _ => {}
    }
}

fn substitute_expr_comptime(expr: &mut Expr, inner: Box<Expr>, original: &Program, errs: &mut Vec<str>) {
    var e: Expr = ct_box_expr_unbox(inner);
    substitute_expr(&mut e, original, errs);
    // Now evaluate the comptime expression
    var result: ResultExpr = evaluate(&e, original);
    match result {
        ResultExpr::Ok(v) => { *expr = v; }
        ResultExpr::Err(msg) => { errs.push("comptime error: " + msg); }
    }
}

fn substitute_expr_comptime_block(expr: &mut Expr, stmts: &mut Vec<Stmt>, original: &Program, errs: &mut Vec<str>) {
    substitute_stmts(stmts, original, errs);
    var result: ResultExpr = evaluate_block(stmts, original);
    match result {
        ResultExpr::Ok(v) => { *expr = v; }
        ResultExpr::Err(msg) => { errs.push("comptime error: " + msg); }
    }
}

fn substitute_expr_comptime_reflect(expr: &mut Expr, op: ReflectOp, ty: Type, original: &Program, errs: &mut Vec<str>) {
    var result: ResultExpr = evaluate_reflect(op, ty, original);
    match result {
        ResultExpr::Ok(v) => { *expr = v; }
        ResultExpr::Err(msg) => { errs.push("comptime error: " + msg); }
    }
}

// --- Aggressive comptime evuation (I-5A) -------------------------------
// Auto-evaluate calls to `comptime fn` functions when ALL arguments are
// literals, without requiring an explicit `comptime` wrapper.

// The names of this program's comptime fns
var ct_comptime_fns: i64 = 0;

fn aggressive_comptime_func(funcs: &mut Vec<Func>, idx: i64, original: &Program) {
    var func: Func = funcs.get(idx);
    var si: i64 = 0;
    while si < func.body.len() {
        var stmt: Stmt = func.body.get(si);
        aggressive_comptime_stmt(&mut stmt, original);
        func.body.set(si, stmt);
        si = si + 1;
    }
    funcs.set(idx, func);
}

fn aggressive_comptime_stmt(stmt: &mut Stmt, original: &Program) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => { aggressive_comptime_expr(&mut expr, original); }
        Stmt::Assign(_, _, expr, _) => { aggressive_comptime_expr(&mut expr, original); }
        Stmt::Expr(e, _) => { aggressive_comptime_expr(&mut e, original); }
        Stmt::Return(opt, _) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    var inner: Expr = ct_box_expr_unbox(e);
                    aggressive_comptime_expr(&mut inner, original);
                }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            aggressive_comptime_expr(&mut cond, original);
            var si: i64 = 0;
            while si < then_block.len() {
                var s: Stmt = then_block.get(si);
                aggressive_comptime_stmt(&mut s, original);
                then_block.set(si, s);
                si = si + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var ei: i64 = 0;
                    while ei < eb.len() {
                        var s: Stmt = eb.get(ei);
                        aggressive_comptime_stmt(&mut s, original);
                        eb.set(ei, s);
                        ei = ei + 1;
                    }
                }
                OptStmts::None => {}
            }
            // I-5A: If condition is a literal bool, eliminate the dead branch
            match cond {
                Expr::BoolLit(b) => {
                    if b {
                        // Clear else block -- then block stays
                        match else_block {
                            OptStmts::Some(_) => { *else_block = OptStmts::None; }
                            OptStmts::None => {}
                        }
                    } else {
                        // Clear then block -- else block stays
                        then_block.clear();
                    }
                }
                _ => {}
            }
        }
        Stmt::For(loop_var, iterator, body, _) => {
            aggressive_comptime_expr(&mut iterator, original);
            var si: i64 = 0;
            while si < body.len() {
                var s: Stmt = body.get(si);
                aggressive_comptime_stmt(&mut s, original);
                body.set(si, s);
                si = si + 1;
            }
            // I-5D: Comptime loop unrolling -- if iterator is Range with
            // literal bounds and body is small (<=16 stmts), unroll at AST level
            match iterator {
                Expr::Range(start_box, end_box, inclusive) => {
                    var start_e: Expr = ct_box_expr_unbox(start_box);
                    var end_e: Expr = ct_box_expr_unbox(end_box);
                    match start_e {
                        Expr::IntLit(s) => {
                            match end_e {
                                Expr::IntLit(e) => {
                                    var trip: i64 = 0;
                                    if inclusive { trip = e - s + 1; } else { trip = e - s; }
                                    // Check for break/continue in body
                                    var has_bc: bool = false;
                                    var bi: i64 = 0;
                                    while bi < body.len() {
                                        if stmt_has_break_or_continue(body.get(bi)) { has_bc = true; }
                                        bi = bi + 1;
                                    }
                                    if trip > 0 && trip <= 16 && body.len() <= 16 && !has_bc {
                                        // Build unrolled body: one `if true { let i = k; body }`
                                        // per iteration. (Substituting k for i in the body
                                        // would rewrite it in place: body.get() is the
                                        // statement itself, not a copy, so every
                                        // iteration after the first saw the first's k.)
                                        var unrolled: Vec<Stmt> = Vec::new();
                                        var last: i64 = 0;
                                        if inclusive { last = e + 1; } else { last = e; }
                                        var i: i64 = s;
                                        while i < last {
                                            var iteration: Vec<Stmt> = Vec::new();
                                            iteration.push(Stmt::Let(loop_var, OptType::Some(Type::I64), Expr::IntLit(i), false, false, Vec::new(), 0));
                                            var si2: i64 = 0;
                                            while si2 < body.len() {
                                                iteration.push(body.get(si2));
                                                si2 = si2 + 1;
                                            }
                                            unrolled.push(Stmt::If(Expr::BoolLit(true), iteration, OptStmts::None, 0));
                                            i = i + 1;
                                        }
                                        // Replace the for loop with if true { unrolled }
                                        *stmt = Stmt::If(Expr::BoolLit(true), unrolled, OptStmts::None, 0);
                                        return;
                                    }
                                }
                                _ => {}
                            }
                        }
                        _ => {}
                    }
                }
                _ => {}
            }
        }
        Stmt::While(cond, body, _) => {
            aggressive_comptime_expr(&mut cond, original);
            var si: i64 = 0;
            while si < body.len() {
                var s: Stmt = body.get(si);
                aggressive_comptime_stmt(&mut s, original);
                body.set(si, s);
                si = si + 1;
            }
        }
        _ => {}
    }
}

fn aggressive_comptime_expr(expr: &mut Expr, original: &Program) {
    // First recurse into children
    match expr {
        Expr::Binary(op, left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            aggressive_comptime_expr(&mut l, original);
            aggressive_comptime_expr(&mut r, original);
            *expr = Expr::Binary(op, box_expr_new(l), box_expr_new(r));
        }
        Expr::Unary(op, inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            aggressive_comptime_expr(&mut e, original);
            *expr = Expr::Unary(op, box_expr_new(e));
        }
        Expr::Call(callee, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                aggressive_comptime_expr(&mut a, original);
                args.set(ai, a);
                ai = ai + 1;
            }
            *expr = Expr::Call(callee, args);
        }
        Expr::MethodCall(receiver, mname, args) => {
            var r: Expr = ct_box_expr_unbox(receiver);
            aggressive_comptime_expr(&mut r, original);
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                aggressive_comptime_expr(&mut a, original);
                args.set(ai, a);
                ai = ai + 1;
            }
            *expr = Expr::MethodCall(box_expr_new(r), mname, args);
        }
        _ => {}
    }

    // I-5A: If this is a call to a comptime fn with all-literal args, evaluate it
    match expr {
        Expr::Call(callee, args) => {
            if HashMap_get(ct_comptime_fns, callee) != 0 {
                var all_lit: bool = true;
                var ai: i64 = 0;
                while ai < args.len() {
                    if !is_literal(args.get(ai)) { all_lit = false; }
                    ai = ai + 1;
                }
                if all_lit {
                    var result: ResultExpr = evaluate(expr, original);
                    match result {
                        ResultExpr::Ok(v) => { *expr = v; }
                        ResultExpr::Err(_) => {} // Leave as-is on error
                    }
                }
            }
        }
        _ => {}
    }
}

fn is_literal(expr: Expr) -> bool {
    match expr {
        Expr::IntLit(_) => { return true; }
        Expr::FloatLit(_) => { return true; }
        Expr::BoolLit(_) => { return true; }
        Expr::StringLit(_) => { return true; }
        _ => { return false; }
    }
    return false;
}

fn stmt_has_break_or_continue(stmt: Stmt) -> bool {
    match stmt {
        Stmt::Break(_, _) => { return true; }
        Stmt::Continue(_) => { return true; }
        Stmt::If(_, then_block, else_block, _) => {
            var i: i64 = 0;
            while i < then_block.len() {
                if stmt_has_break_or_continue(then_block.get(i)) { return true; }
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        if stmt_has_break_or_continue(eb.get(j)) { return true; }
                        j = j + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Stmt::For(_, _, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                if stmt_has_break_or_continue(body.get(i)) { return true; }
                i = i + 1;
            }
        }
        Stmt::While(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                if stmt_has_break_or_continue(body.get(i)) { return true; }
                i = i + 1;
            }
        }
        Stmt::Unsafe(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                if stmt_has_break_or_continue(body.get(i)) { return true; }
                i = i + 1;
            }
        }
        _ => {}
    }
    return false;
}

// --- Identifier replacement (for loop unrolling) -------------------------

fn replace_ident_in_stmt(stmt: &mut Stmt, name: str, replacement: Expr) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => { replace_ident_in_expr(expr, name, replacement); }
        Stmt::Assign(_, _, expr, _) => { replace_ident_in_expr(expr, name, replacement); }
        Stmt::IndexAssign(_, index, _, expr, _) => {
            replace_ident_in_expr(index, name, replacement);
            replace_ident_in_expr(expr, name, replacement);
        }
        Stmt::Expr(e, _) => { replace_ident_in_expr(e, name, replacement); }
        Stmt::Return(opt, _) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    var inner: Expr = ct_box_expr_unbox(e);
                    replace_ident_in_expr(&mut inner, name, replacement);
                }
                OptBoxExpr::None => {}
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            replace_ident_in_expr(cond, name, replacement);
            var si: i64 = 0;
            while si < then_block.len() {
                var s: Stmt = then_block.get(si);
                replace_ident_in_stmt(&mut s, name, replacement);
                then_block.set(si, s);
                si = si + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var ei: i64 = 0;
                    while ei < eb.len() {
                        var s: Stmt = eb.get(ei);
                        replace_ident_in_stmt(&mut s, name, replacement);
                        eb.set(ei, s);
                        ei = ei + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Stmt::For(v, iterator, body, _) => {
            if v != name {
                replace_ident_in_expr(iterator, name, replacement);
                var si: i64 = 0;
                while si < body.len() {
                    var s: Stmt = body.get(si);
                    replace_ident_in_stmt(&mut s, name, replacement);
                    body.set(si, s);
                    si = si + 1;
                }
            }
        }
        Stmt::While(cond, body, _) => {
            replace_ident_in_expr(cond, name, replacement);
            var si: i64 = 0;
            while si < body.len() {
                var s: Stmt = body.get(si);
                replace_ident_in_stmt(&mut s, name, replacement);
                body.set(si, s);
                si = si + 1;
            }
        }
        _ => {}
    }
}

fn replace_ident_in_expr(expr: &mut Expr, name: str, replacement: Expr) {
    match expr {
        Expr::Ident(n) => {
            if n == name { *expr = replacement; }
        }
        Expr::Binary(op, left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            replace_ident_in_expr(&mut l, name, replacement);
            replace_ident_in_expr(&mut r, name, replacement);
            *expr = Expr::Binary(op, box_expr_new(l), box_expr_new(r));
        }
        Expr::Unary(op, inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            replace_ident_in_expr(&mut e, name, replacement);
            *expr = Expr::Unary(op, box_expr_new(e));
        }
        Expr::Call(callee, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                replace_ident_in_expr(&mut a, name, replacement);
                args.set(ai, a);
                ai = ai + 1;
            }
            *expr = Expr::Call(callee, args);
        }
        Expr::MethodCall(receiver, mname, args) => {
            var r: Expr = ct_box_expr_unbox(receiver);
            replace_ident_in_expr(&mut r, name, replacement);
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                replace_ident_in_expr(&mut a, name, replacement);
                args.set(ai, a);
                ai = ai + 1;
            }
            *expr = Expr::MethodCall(box_expr_new(r), mname, args);
        }
        Expr::FieldAccess(inner, field) => {
            var e: Expr = ct_box_expr_unbox(inner);
            replace_ident_in_expr(&mut e, name, replacement);
            *expr = Expr::FieldAccess(box_expr_new(e), field);
        }
        Expr::Index(array, index) => {
            var a: Expr = ct_box_expr_unbox(array);
            var i: Expr = ct_box_expr_unbox(index);
            replace_ident_in_expr(&mut a, name, replacement);
            replace_ident_in_expr(&mut i, name, replacement);
            *expr = Expr::Index(box_expr_new(a), box_expr_new(i));
        }
        Expr::StructLit(sname, fields, base) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                var f: FieldInit = fields.get(fi);
                replace_ident_in_expr(&mut f.value, name, replacement);
                fields.set(fi, f);
                fi = fi + 1;
            }
            *expr = Expr::StructLit(sname, fields, base);
        }
        Expr::If(cond, then_block, else_block) => {
            replace_ident_in_expr(cond, name, replacement);
            var si: i64 = 0;
            while si < then_block.len() {
                var s: Stmt = then_block.get(si);
                replace_ident_in_stmt(&mut s, name, replacement);
                then_block.set(si, s);
                si = si + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var ei: i64 = 0;
                    while ei < eb.len() {
                        var s: Stmt = eb.get(ei);
                        replace_ident_in_stmt(&mut s, name, replacement);
                        eb.set(ei, s);
                        ei = ei + 1;
                    }
                }
                OptStmts::None => {}
            }
        }
        Expr::Block(stmts) => {
            var si: i64 = 0;
            while si < stmts.len() {
                var s: Stmt = stmts.get(si);
                replace_ident_in_stmt(&mut s, name, replacement);
                stmts.set(si, s);
                si = si + 1;
            }
        }
        Expr::Range(start, end, incl) => {
            var s: Expr = ct_box_expr_unbox(start);
            var e: Expr = ct_box_expr_unbox(end);
            replace_ident_in_expr(&mut s, name, replacement);
            replace_ident_in_expr(&mut e, name, replacement);
            *expr = Expr::Range(box_expr_new(s), box_expr_new(e), incl);
        }
        Expr::Ref(inner, is_mut) => {
            var e: Expr = ct_box_expr_unbox(inner);
            replace_ident_in_expr(&mut e, name, replacement);
            *expr = Expr::Ref(box_expr_new(e), is_mut);
        }
        Expr::Deref(inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            replace_ident_in_expr(&mut e, name, replacement);
            *expr = Expr::Deref(box_expr_new(e));
        }
        Expr::Cast(inner, ty) => {
            var e: Expr = ct_box_expr_unbox(inner);
            replace_ident_in_expr(&mut e, name, replacement);
            *expr = Expr::Cast(box_expr_new(e), ty);
        }
        _ => {}
    }
}

// --- Evuation ----------------------------------------------------------

fn evaluate(expr: &Expr, original: &Program) -> ResultExpr {
    match expr {
        Expr::IntLit(n) => { return ResultExpr::Ok(Expr::IntLit(n)); }
        Expr::FloatLit(f) => { return ResultExpr::Ok(Expr::FloatLit(f)); }
        Expr::StringLit(s) => { return ResultExpr::Ok(Expr::StringLit(s)); }
        Expr::BoolLit(b) => { return ResultExpr::Ok(Expr::BoolLit(b)); }
        Expr::Binary(op, left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            var lr: ResultExpr = evaluate(&l, original);
            match lr {
                ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                ResultExpr::Ok(lv) => {
                    var rr: ResultExpr = evaluate(&r, original);
                    match rr {
                        ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                        ResultExpr::Ok(rv) => { return eval_binop(op, lv, rv); }
                    }
                }
            }
        }
        Expr::Unary(op, inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            var vr: ResultExpr = evaluate(&e, original);
            match vr {
                ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                ResultExpr::Ok(v) => { return eval_unaryop(op, v); }
            }
        }
        Expr::Call(callee, args) => {
            // Look up comptime function
            var func_idx: i64 = -1;
            var fi: i64 = 0;
            while fi < original.funcs.len() {
                var f: Func = original.funcs.get(fi);
                if f.name == callee && f.is_comptime { func_idx = fi; }
                fi = fi + 1;
            }
            if func_idx < 0 {
                return ResultExpr::Err("comptime function '" + callee + "' not found");
            }
            var func: Func = original.funcs.get(func_idx);
            // Evuate args
            var arg_values: Vec<Expr> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                var ar: ResultExpr = evaluate(&a, original);
                match ar {
                    ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                    ResultExpr::Ok(v) => { arg_values.push(v); }
                }
                ai = ai + 1;
            }
            return call_comptime_func(func, arg_values, original);
        }
        Expr::If(cond, then_block, else_block) => {
            var cr: ResultExpr = evaluate(cond, original);
            match cr {
                ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                ResultExpr::Ok(c) => {
                    match c {
                        Expr::BoolLit(b) => {
                            if b {
                                return evaluate_block(then_block, original);
                            } else {
                                match else_block {
                                    OptStmts::Some(eb) => { return evaluate_block(eb, original); }
                                    OptStmts::None => { return ResultExpr::Ok(Expr::IntLit(0)); }
                                }
                            }
                        }
                        _ => { return ResultExpr::Err("comptime if condition must be boolean"); }
                    }
                }
            }
        }
        Expr::Block(stmts) => { return evaluate_block(stmts, original); }
        Expr::Comptime(inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            return evaluate(&e, original);
        }
        Expr::ComptimeBlock(stmts) => { return evaluate_block(stmts, original); }
        Expr::ComptimeReflect(op, ty) => { return evaluate_reflect(op, ty, original); }
        _ => { return ResultExpr::Ok(*expr); }
    }
    return ResultExpr::Ok(Expr::IntLit(0));
}

fn evaluate_block(stmts: Vec<Stmt>, original: &Program) -> ResultExpr {
    var env: ComptimeEnv = ComptimeEnv_new();
    return evaluate_block_with_env(stmts, original, &env);
}

fn evaluate_block_with_env(stmts: Vec<Stmt>, original: &Program, env: &ComptimeEnv) -> ResultExpr {
    var returned: Vec<i64> = Vec::new();
    var block_env: ComptimeEnv = ComptimeEnv_clone(env);
    return evaluate_block_rt(stmts, original, &block_env, &mut returned);
}

/// Runs `stmts` in `env` itself (its Vecs are shared): assignments to
/// outer variables persist (a loop accumulating into `out`), names the
/// block declares are dropped at its end.
fn evaluate_block_rt(stmts: Vec<Stmt>, original: &Program, env: &ComptimeEnv, returned: &mut Vec<i64>) -> ResultExpr {
    var local_env: ComptimeEnv = ComptimeEnv { names: env.names, values: env.values };
    var n_outer: i64 = local_env.names.len();
    var result: Expr = Expr::IntLit(0);
    var si: i64 = 0;
    while si < stmts.len() {
        var stmt: Stmt = stmts.get(si);
        match stmt {
            Stmt::Let(name, _, expr, _, _, _, _) => {
                var vr: ResultExpr = evaluate_with_env(expr, &local_env, original);
                match vr {
                    ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                    ResultExpr::Ok(v) => { ComptimeEnv_set(&mut local_env, name, v); }
                }
            }
            Stmt::Assign(target, op, expr, _) => {
                var vr: ResultExpr = evaluate_with_env(expr, &local_env, original);
                match vr {
                    ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                    ResultExpr::Ok(v) => {
                        var current_opt: OptExpr = ComptimeEnv_get(&local_env, target);
                        var current: Expr = Expr::IntLit(0);
                        match current_opt {
                            OptExpr::Some(c) => { current = c; }
                            OptExpr::None => {}
                        }
                        var new_v: Expr = v;
                        match op {
                            AssignOp::AddAssign => {
                                var br: ResultExpr = eval_binop(BinOp::Add, current, v);
                                match br { ResultExpr::Ok(nv) => { new_v = nv; }, ResultExpr::Err(_) => {} }
                            }
                            AssignOp::SubAssign => {
                                var br: ResultExpr = eval_binop(BinOp::Sub, current, v);
                                match br { ResultExpr::Ok(nv) => { new_v = nv; }, ResultExpr::Err(_) => {} }
                            }
                            AssignOp::MulAssign => {
                                var br: ResultExpr = eval_binop(BinOp::Mul, current, v);
                                match br { ResultExpr::Ok(nv) => { new_v = nv; }, ResultExpr::Err(_) => {} }
                            }
                            _ => {}
                        }
                        ComptimeEnv_set(&mut local_env, target, new_v);
                    }
                }
            }
            Stmt::Expr(e, _) => {
                result = Expr::IntLit(0);
                var vr: ResultExpr = evaluate_with_env(e, &local_env, original);
                match vr {
                    ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                    ResultExpr::Ok(v) => { result = v; }
                }
            }
            Stmt::Return(opt, _) => {
                returned.push(1);
                match opt {
                    OptBoxExpr::Some(e) => {
                        var inner: Expr = ct_box_expr_unbox(e);
                        return evaluate_with_env(&inner, &local_env, original);
                    }
                    OptBoxExpr::None => { return ResultExpr::Ok(Expr::IntLit(0)); }
                }
            }
            Stmt::If(cond, then_block, else_block, _) => {
                var cr: ResultExpr = evaluate_with_env(cond, &local_env, original);
                match cr {
                    ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                    ResultExpr::Ok(c) => {
                        match c {
                            Expr::BoolLit(b) => {
                                if b {
                                    var br: ResultExpr = evaluate_block_rt(then_block, original, &local_env, returned);
                                    if returned.len() > 0 { return br; }
                                    match br {
                                        ResultExpr::Ok(v) => { result = v; }
                                        ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                                    }
                                } else {
                                    match else_block {
                                        OptStmts::Some(eb) => {
                                            var br: ResultExpr = evaluate_block_rt(eb, original, &local_env, returned);
                                            if returned.len() > 0 { return br; }
                                            match br {
                                                ResultExpr::Ok(v) => { result = v; }
                                                ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                                            }
                                        }
                                        OptStmts::None => {}
                                    }
                                }
                            }
                            _ => { return ResultExpr::Err("comptime if condition must be boolean"); }
                        }
                    }
                }
            }
            Stmt::For(loop_var, iterator, body, _) => {
                var iter_v: ResultExpr = evaluate_with_env(iterator, &local_env, original);
                match iter_v {
                    ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                    ResultExpr::Ok(iv) => {
                        match iv {
                            Expr::Range(start_box, end_box, _) => {
                                var start_e: Expr = ct_box_expr_unbox(start_box);
                                var end_e: Expr = ct_box_expr_unbox(end_box);
                                var sr: ResultExpr = evaluate_with_env(&start_e, &local_env, original);
                                var er: ResultExpr = evaluate_with_env(&end_e, &local_env, original);
                                match sr {
                                    ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                                    ResultExpr::Ok(s) => {
                                        match er {
                                            ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                                            ResultExpr::Ok(e) => {
                                                match s {
                                                    Expr::IntLit(a) => {
                                                        match e {
                                                            Expr::IntLit(b) => {
                                                                var i: i64 = a;
                                                                while i < b {
                                                                    ComptimeEnv_set(&mut local_env, loop_var, Expr::IntLit(i));
                                                                    var br: ResultExpr = evaluate_block_rt(body, original, &local_env, returned);
                                                                    if returned.len() > 0 { return br; }
                                                                    match br {
                                                                        ResultExpr::Ok(v) => { result = v; }
                                                                        ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                                                                    }
                                                                    i = i + 1;
                                                                }
                                                            }
                                                            _ => { return ResultExpr::Err("comptime for range must be ints"); }
                                                        }
                                                    }
                                                    _ => { return ResultExpr::Err("comptime for range must be ints"); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            _ => { return ResultExpr::Err("comptime for requires a range"); }
                        }
                    }
                }
            }
            _ => {}
        }
        si = si + 1;
    }
    local_env.names.truncate(n_outer);
    local_env.values.truncate(n_outer);
    return ResultExpr::Ok(result);
}

fn evaluate_with_env(expr: &Expr, env: &ComptimeEnv, original: &Program) -> ResultExpr {
    match expr {
        Expr::Ident(name) => {
            var v: OptExpr = ComptimeEnv_get(env, name);
            match v {
                OptExpr::Some(v) => { return ResultExpr::Ok(v); }
                OptExpr::None => { return ResultExpr::Err("undefined variable '" + name + "' in comptime"); }
            }
        }
        Expr::IntLit(n) => { return ResultExpr::Ok(Expr::IntLit(n)); }
        Expr::FloatLit(f) => { return ResultExpr::Ok(Expr::FloatLit(f)); }
        Expr::StringLit(s) => { return ResultExpr::Ok(Expr::StringLit(s)); }
        Expr::BoolLit(b) => { return ResultExpr::Ok(Expr::BoolLit(b)); }
        Expr::Binary(op, left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            var lr: ResultExpr = evaluate_with_env(&l, env, original);
            match lr {
                ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                ResultExpr::Ok(lv) => {
                    var rr: ResultExpr = evaluate_with_env(&r, env, original);
                    match rr {
                        ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                        ResultExpr::Ok(rv) => { return eval_binop(op, lv, rv); }
                    }
                }
            }
        }
        Expr::Unary(op, inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            var vr: ResultExpr = evaluate_with_env(&e, env, original);
            match vr {
                ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                ResultExpr::Ok(v) => { return eval_unaryop(op, v); }
            }
        }
        Expr::Call(callee, args) => {
            var func_idx: i64 = -1;
            var fi: i64 = 0;
            while fi < original.funcs.len() {
                var f: Func = original.funcs.get(fi);
                if f.name == callee && f.is_comptime { func_idx = fi; }
                fi = fi + 1;
            }
            if func_idx < 0 {
                return ResultExpr::Err("comptime function '" + callee + "' not found");
            }
            var func: Func = original.funcs.get(func_idx);
            var arg_values: Vec<Expr> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                var ar: ResultExpr = evaluate_with_env(&a, env, original);
                match ar {
                    ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                    ResultExpr::Ok(v) => { arg_values.push(v); }
                }
                ai = ai + 1;
            }
            return call_comptime_func(func, arg_values, original);
        }
        Expr::If(cond, then_block, else_block) => {
            var cr: ResultExpr = evaluate_with_env(cond, env, original);
            match cr {
                ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                ResultExpr::Ok(c) => {
                    match c {
                        Expr::BoolLit(b) => {
                            if b {
                                return evaluate_block_with_env(then_block, original, env);
                            } else {
                                match else_block {
                                    OptStmts::Some(eb) => { return evaluate_block_with_env(eb, original, env); }
                                    OptStmts::None => { return ResultExpr::Ok(Expr::IntLit(0)); }
                                }
                            }
                        }
                        _ => { return ResultExpr::Err("comptime if condition must be boolean"); }
                    }
                }
            }
        }
        Expr::Block(stmts) => { return evaluate_block_with_env(stmts, original, env); }
        Expr::StrConcat(left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            var lr: ResultExpr = evaluate_with_env(&l, env, original);
            match lr {
                ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                ResultExpr::Ok(lv) => {
                    var rr: ResultExpr = evaluate_with_env(&r, env, original);
                    match rr {
                        ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                        ResultExpr::Ok(rv) => {
                            match lv {
                                Expr::StringLit(a) => {
                                    match rv {
                                        Expr::StringLit(b) => { return ResultExpr::Ok(Expr::StringLit(a + b)); }
                                        _ => { return ResultExpr::Err("comptime str_concat requires strings"); }
                                    }
                                }
                                _ => { return ResultExpr::Err("comptime str_concat requires strings"); }
                            }
                        }
                    }
                }
            }
        }
        Expr::Index(iarr, iidx) => {
            // Array indexing at comptime (field_names[i] etc.).
            var ae: Expr = ct_box_expr_unbox(iarr);
            var ie: Expr = ct_box_expr_unbox(iidx);
            var ar: ResultExpr = evaluate_with_env(&ae, env, original);
            var ir: ResultExpr = evaluate_with_env(&ie, env, original);
            match ar {
                ResultExpr::Ok(av) => {
                    match ir {
                        ResultExpr::Ok(iv) => {
                            match av {
                                Expr::ArrayLit(_, elements) => {
                                    match iv {
                                        Expr::IntLit(ix) => {
                                            if ix >= 0 && ix < elements.len() { return ResultExpr::Ok(elements.get(ix)); }
                                            return ResultExpr::Err("comptime index " + int_to_str(ix) + " out of bounds");
                                        }
                                        _ => {}
                                    }
                                }
                                _ => {}
                            }
                            return ResultExpr::Err("comptime indexing requires array and int");
                        }
                        ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                    }
                }
                ResultExpr::Err(m) => { return ResultExpr::Err(m); }
            }
        }
        Expr::FString(parts) => {
            var result: str = "";
            var pi: i64 = 0;
            while pi < parts.len() {
                var part: FStringPart = parts.get(pi);
                match part {
                    FStringPart::Literal(s) => { result = result + s; }
                    FStringPart::Expr(e) => {
                        var vr: ResultExpr = evaluate_with_env(&e, env, original);
                        match vr {
                            ResultExpr::Ok(v) => {
                                match v {
                                    Expr::IntLit(n) => { result = result + int_to_str(n); }
                                    Expr::FloatLit(f) => { result = result + float_to_str(f); }
                                    Expr::StringLit(s) => { result = result + s; }
                                    Expr::BoolLit(b) => {
                                        if b { result = result + "true"; } else { result = result + "false"; }
                                    }
                                    _ => { result = result + "?"; }
                                }
                            }
                            ResultExpr::Err(msg) => { return ResultExpr::Err(msg); }
                        }
                    }
                }
                pi = pi + 1;
            }
            return ResultExpr::Ok(Expr::StringLit(result));
        }
        _ => { return evaluate(expr, original); }
    }
    return ResultExpr::Ok(Expr::IntLit(0));
}

fn call_comptime_func(func: Func, args: Vec<Expr>, original: &Program) -> ResultExpr {
    if args.len() != func.params.len() {
        return ResultExpr::Err("comptime function '" + func.name + "' expects " + int_to_str(func.params.len()) + " args, got " + int_to_str(args.len()));
    }
    var env: ComptimeEnv = ComptimeEnv_new();
    var i: i64 = 0;
    while i < args.len() {
        ComptimeEnv_set(&mut env, func.params.get(i).name, args.get(i));
        i = i + 1;
    }
    // The statement forms and scoping of src/comptime.rs call_comptime_func:
    // an if branch runs let/return/expression statements in a copy of the
    // environment; a for body runs let/assign/expression/return statements.
    var result: Expr = Expr::IntLit(0);
    var si: i64 = 0;
    while si < func.body.len() {
        var stmt: Stmt = func.body.get(si);
        match stmt {
            Stmt::Let(lname, _, lexpr, _, _, _, _) => {
                match evaluate_with_env(&lexpr, &env, original) {
                    ResultExpr::Ok(v) => { ComptimeEnv_set(&mut env, lname, v); }
                    ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                }
            }
            Stmt::Assign(target, op, aexpr, _) => {
                match evaluate_with_env(&aexpr, &env, original) {
                    ResultExpr::Ok(v) => {
                        match ce_assign(&env, target, op, v) {
                            ResultExpr::Ok(nv) => { ComptimeEnv_set(&mut env, target, nv); }
                            ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                        }
                    }
                    ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                }
            }
            Stmt::Expr(e, _) => {
                match evaluate_with_env(&e, &env, original) {
                    ResultExpr::Ok(v) => { result = v; }
                    ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                }
            }
            Stmt::Return(opt, _) => {
                match opt {
                    OptBoxExpr::Some(re) => {
                        var rinner: Expr = ct_box_expr_unbox(re);
                        return evaluate_with_env(&rinner, &env, original);
                    }
                    OptBoxExpr::None => { return ResultExpr::Ok(Expr::IntLit(0)); }
                }
            }
            Stmt::If(cond, then_block, else_block, _) => {
                var branch: Vec<Stmt> = Vec::new();
                var take: bool = false;
                match evaluate_with_env(&cond, &env, original) {
                    ResultExpr::Ok(c) => {
                        match c {
                            Expr::BoolLit(b) => {
                                if b { branch = then_block; take = true; }
                                else {
                                    match else_block {
                                        OptStmts::Some(eb) => { branch = eb; take = true; }
                                        OptStmts::None => {}
                                    }
                                }
                            }
                            _ => { return ResultExpr::Err("comptime if condition must be boolean"); }
                        }
                    }
                    ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                }
                if take {
                    var sub_env: ComptimeEnv = ComptimeEnv_clone(&env);
                    var bi: i64 = 0;
                    while bi < branch.len() {
                        match branch.get(bi) {
                            Stmt::Let(bname, _, bexpr, _, _, _, _) => {
                                match evaluate_with_env(&bexpr, &sub_env, original) {
                                    ResultExpr::Ok(v) => { ComptimeEnv_set(&mut sub_env, bname, v); }
                                    ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                                }
                            }
                            Stmt::Return(bopt, _) => {
                                match bopt {
                                    OptBoxExpr::Some(bre) => {
                                        var binner: Expr = ct_box_expr_unbox(bre);
                                        return evaluate_with_env(&binner, &sub_env, original);
                                    }
                                    OptBoxExpr::None => { return ResultExpr::Ok(Expr::IntLit(0)); }
                                }
                            }
                            Stmt::Expr(be, _) => {
                                match evaluate_with_env(&be, &sub_env, original) {
                                    ResultExpr::Ok(v) => { result = v; }
                                    ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                                }
                            }
                            _ => {}
                        }
                        bi = bi + 1;
                    }
                }
            }
            Stmt::For(fvar, iterator, fbody, _) => {
                var lo: i64 = 0;
                var hi: i64 = 0;
                match evaluate_with_env(&iterator, &env, original) {
                    ResultExpr::Ok(iv) => {
                        match iv {
                            Expr::Range(sb, eb2, _) => {
                                var se: Expr = ct_box_expr_unbox(sb);
                                var ee: Expr = ct_box_expr_unbox(eb2);
                                var sr: ResultExpr = evaluate_with_env(&se, &env, original);
                                var er: ResultExpr = evaluate_with_env(&ee, &env, original);
                                var ok: bool = false;
                                match sr {
                                    ResultExpr::Ok(sv) => {
                                        match er {
                                            ResultExpr::Ok(ev) => {
                                                match sv {
                                                    Expr::IntLit(a) => {
                                                        match ev {
                                                            Expr::IntLit(b) => { lo = a; hi = b; ok = true; }
                                                            _ => {}
                                                        }
                                                    }
                                                    _ => {}
                                                }
                                            }
                                            ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                                        }
                                    }
                                    ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                                }
                                if !ok { return ResultExpr::Err("comptime for range must be ints"); }
                            }
                            _ => { return ResultExpr::Err("comptime for requires a range"); }
                        }
                    }
                    ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                }
                var it: i64 = lo;
                while it < hi {
                    ComptimeEnv_set(&mut env, fvar, Expr::IntLit(it));
                    var fi: i64 = 0;
                    while fi < fbody.len() {
                        match fbody.get(fi) {
                            Stmt::Let(fname, _, fexpr, _, _, _, _) => {
                                match evaluate_with_env(&fexpr, &env, original) {
                                    ResultExpr::Ok(v) => { ComptimeEnv_set(&mut env, fname, v); }
                                    ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                                }
                            }
                            Stmt::Assign(ftarget, fop, faexpr, _) => {
                                match evaluate_with_env(&faexpr, &env, original) {
                                    ResultExpr::Ok(v) => {
                                        match ce_assign(&env, ftarget, fop, v) {
                                            ResultExpr::Ok(nv) => { ComptimeEnv_set(&mut env, ftarget, nv); }
                                            ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                                        }
                                    }
                                    ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                                }
                            }
                            Stmt::Expr(fe, _) => {
                                match evaluate_with_env(&fe, &env, original) {
                                    ResultExpr::Ok(v) => { result = v; }
                                    ResultExpr::Err(m) => { return ResultExpr::Err(m); }
                                }
                            }
                            Stmt::Return(fopt, _) => {
                                match fopt {
                                    OptBoxExpr::Some(fre) => {
                                        var finner: Expr = ct_box_expr_unbox(fre);
                                        return evaluate_with_env(&finner, &env, original);
                                    }
                                    OptBoxExpr::None => { return ResultExpr::Ok(Expr::IntLit(0)); }
                                }
                            }
                            _ => {}
                        }
                        fi = fi + 1;
                    }
                    it = it + 1;
                }
            }
            _ => {}
        }
        si = si + 1;
    }
    return ResultExpr::Ok(result);
}

/// New value of `target` after `target op= v` (src/comptime.rs).
fn ce_assign(env: &ComptimeEnv, target: str, op: AssignOp, v: Expr) -> ResultExpr {
    var current: Expr = Expr::IntLit(0);
    match ComptimeEnv_get(env, target) {
        OptExpr::Some(c) => { current = c; }
        OptExpr::None => {}
    }
    match op {
        AssignOp::AddAssign => { return eval_binop(BinOp::Add, current, v); }
        AssignOp::SubAssign => { return eval_binop(BinOp::Sub, current, v); }
        AssignOp::MulAssign => { return eval_binop(BinOp::Mul, current, v); }
        _ => {}
    }
    return ResultExpr::Ok(v);
}

// --- Binary/unary operation evuation -----------------------------------

fn eval_binop(op: BinOp, l: Expr, r: Expr) -> ResultExpr {
    match l {
        Expr::IntLit(a) => {
            match r {
                Expr::IntLit(b) => {
                    match op {
                        BinOp::Add => { return ResultExpr::Ok(Expr::IntLit(a + b)); }
                        BinOp::Sub => { return ResultExpr::Ok(Expr::IntLit(a - b)); }
                        BinOp::Mul => { return ResultExpr::Ok(Expr::IntLit(a * b)); }
                        BinOp::Div => {
                            if b == 0 { return ResultExpr::Err("division by zero in comptime"); }
                            return ResultExpr::Ok(Expr::IntLit(a / b));
                        }
                        BinOp::Mod => {
                            if b == 0 { return ResultExpr::Err("modulo by zero in comptime"); }
                            return ResultExpr::Ok(Expr::IntLit(a % b));
                        }
                        BinOp::Eq => { return ResultExpr::Ok(Expr::BoolLit(a == b)); }
                        BinOp::Neq => { return ResultExpr::Ok(Expr::BoolLit(a != b)); }
                        BinOp::Lt => { return ResultExpr::Ok(Expr::BoolLit(a < b)); }
                        BinOp::LtEq => { return ResultExpr::Ok(Expr::BoolLit(a <= b)); }
                        BinOp::Gt => { return ResultExpr::Ok(Expr::BoolLit(a > b)); }
                        BinOp::GtEq => { return ResultExpr::Ok(Expr::BoolLit(a >= b)); }
                        BinOp::And => { return ResultExpr::Ok(Expr::BoolLit(a != 0 && b != 0)); }
                        BinOp::Or => { return ResultExpr::Ok(Expr::BoolLit(a != 0 || b != 0)); }
                        BinOp::BitAnd => { return ResultExpr::Ok(Expr::IntLit(a & b)); }
                        BinOp::BitOr => { return ResultExpr::Ok(Expr::IntLit(a | b)); }
                        BinOp::BitXor => { return ResultExpr::Ok(Expr::IntLit(a ^ b)); }
                        BinOp::Shl => { return ResultExpr::Ok(Expr::IntLit(a << b)); }
                        BinOp::Shr => { return ResultExpr::Ok(Expr::IntLit(a >> b)); }
                    }
                }
                _ => { return ResultExpr::Err("cannot evaluate binop: type mismatch"); }
            }
        }
        Expr::FloatLit(a) => {
            match r {
                Expr::FloatLit(b) => {
                    match op {
                        BinOp::Add => { return ResultExpr::Ok(Expr::FloatLit(a + b)); }
                        BinOp::Sub => { return ResultExpr::Ok(Expr::FloatLit(a - b)); }
                        BinOp::Mul => { return ResultExpr::Ok(Expr::FloatLit(a * b)); }
                        BinOp::Div => { return ResultExpr::Ok(Expr::FloatLit(a / b)); }
                        BinOp::Eq => { return ResultExpr::Ok(Expr::BoolLit(a == b)); }
                        BinOp::Neq => { return ResultExpr::Ok(Expr::BoolLit(a != b)); }
                        BinOp::Lt => { return ResultExpr::Ok(Expr::BoolLit(a < b)); }
                        BinOp::LtEq => { return ResultExpr::Ok(Expr::BoolLit(a <= b)); }
                        BinOp::Gt => { return ResultExpr::Ok(Expr::BoolLit(a > b)); }
                        BinOp::GtEq => { return ResultExpr::Ok(Expr::BoolLit(a >= b)); }
                        _ => { return ResultExpr::Err("unsupported float binop"); }
                    }
                }
                _ => { return ResultExpr::Err("cannot evaluate binop: type mismatch"); }
            }
        }
        Expr::StringLit(a) => {
            match r {
                Expr::StringLit(b) => {
                    match op {
                        BinOp::Add => { return ResultExpr::Ok(Expr::StringLit(a + b)); }
                        BinOp::Eq => { return ResultExpr::Ok(Expr::BoolLit(a == b)); }
                        BinOp::Neq => { return ResultExpr::Ok(Expr::BoolLit(a != b)); }
                        _ => { return ResultExpr::Err("unsupported string binop"); }
                    }
                }
                _ => { return ResultExpr::Err("cannot evaluate binop: type mismatch"); }
            }
        }
        Expr::BoolLit(a) => {
            match r {
                Expr::BoolLit(b) => {
                    match op {
                        BinOp::Eq => { return ResultExpr::Ok(Expr::BoolLit(a == b)); }
                        BinOp::Neq => { return ResultExpr::Ok(Expr::BoolLit(a != b)); }
                        BinOp::And => { return ResultExpr::Ok(Expr::BoolLit(a && b)); }
                        BinOp::Or => { return ResultExpr::Ok(Expr::BoolLit(a || b)); }
                        _ => { return ResultExpr::Err("unsupported bool binop"); }
                    }
                }
                _ => { return ResultExpr::Err("cannot evaluate binop: type mismatch"); }
            }
        }
        _ => { return ResultExpr::Err("cannot evaluate binop on non-literal"); }
    }
    return ResultExpr::Err("unreachable");
}

fn eval_unaryop(op: UnaryOp, v: Expr) -> ResultExpr {
    match op {
        UnaryOp::Neg => {
            match v {
                Expr::IntLit(n) => { return ResultExpr::Ok(Expr::IntLit(-n)); }
                Expr::FloatLit(f) => { return ResultExpr::Ok(Expr::FloatLit(-f)); }
                _ => { return ResultExpr::Err("cannot negate non-number"); }
            }
        }
        UnaryOp::Not => {
            match v {
                Expr::BoolLit(b) => { return ResultExpr::Ok(Expr::BoolLit(!b)); }
                Expr::IntLit(n) => {
                    if n == 0 { return ResultExpr::Ok(Expr::IntLit(1)); }
                    return ResultExpr::Ok(Expr::IntLit(0));
                }
                _ => { return ResultExpr::Err("cannot not non-bool/int"); }
            }
        }
        UnaryOp::BitNot => {
            match v {
                Expr::IntLit(n) => { return ResultExpr::Ok(Expr::IntLit(-1 ^ n)); }
                _ => { return ResultExpr::Err("cannot bitnot non-int"); }
            }
        }
    }
    return ResultExpr::Err("unreachable");
}

// --- Reflection ----------------------------------------------------------

fn ce_find_struct(original: &Program, name: str) -> i64 {
    var i: i64 = 0;
    while i < original.structs.len() {
        if original.structs.get(i).name == name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn ce_has_annotation(anns: Vec<Annotation>, name: str, arg: str) -> bool {
    var i: i64 = 0;
    while i < anns.len() {
        var a: Annotation = anns.get(i);
        if a.name == name {
            if arg == "" { return true; }
            var j: i64 = 0;
            while j < a.args.len() {
                if a.args.get(j) == arg { return true; }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return false;
}

/// Bytes a field of type `ty` takes with the default struct layout (see
/// the lowerer): one 8-byte slot, except an inline struct (its whole
/// layout) and an enum with payloads ((1 + largest payload) slots).
fn ce_slot_size(ty: Type, original: &Program, depth: i64) -> i64 {
    match ty {
        Type::Named(n) => {
            var si: i64 = ce_find_struct(original, n);
            if si >= 0 && depth < 32 {
                return ce_struct_layout(original.structs.get(si), original, depth + 1, "");
            }
            var ei: i64 = 0;
            while ei < original.enums.len() {
                var e: EnumDef = original.enums.get(ei);
                if e.name == n {
                    var payload: i64 = 0;
                    var vi: i64 = 0;
                    while vi < e.variants.len() {
                        match e.variants.get(vi).data {
                            OptParams::Some(d) => { if d.len() > payload { payload = d.len(); } }
                            OptParams::None => {}
                        }
                        vi = vi + 1;
                    }
                    if payload > 0 { return (1 + payload) * 8; }
                    return 8;
                }
                ei = ei + 1;
            }
        }
        _ => {}
    }
    return 8;
}

/// With `field` empty: the struct's size. Otherwise the offset of `field`
/// (-1 if absent). @repr(C) and @packed use natural sizes, the default
/// layout 8-byte slots, as the lowerer does.
fn ce_struct_layout(s: StructDef, original: &Program, depth: i64, field: str) -> i64 {
    var c_layout: bool = ce_has_annotation(s.annotations, "repr", "C");
    var packed: bool = ce_has_annotation(s.annotations, "packed", "");
    var natural: bool = c_layout || packed;
    var offset: i64 = 0;
    var max_align: i64 = 8;
    if natural { max_align = 1; }
    var i: i64 = 0;
    while i < s.fields.len() {
        var f: Param = s.fields.get(i);
        var size: i64 = 8;
        if natural {
            match f.ty {
                Type::I8 => { size = 1; }
                Type::U8 => { size = 1; }
                Type::Bool => { size = 1; }
                Type::I16 => { size = 2; }
                Type::U16 => { size = 2; }
                Type::I32 => { size = 4; }
                Type::U32 => { size = 4; }
                Type::F32 => { size = 4; }
                _ => {}
            }
            var align: i64 = size;
            if packed { align = 1; }
            offset = (offset + align - 1) / align * align;
            if align > max_align { max_align = align; }
        } else {
            size = ce_slot_size(f.ty, original, depth);
        }
        if field != "" && f.name == field { return offset; }
        offset = offset + size;
        i = i + 1;
    }
    if field != "" { return 0 - 1; }
    return (offset + max_align - 1) / max_align * max_align;
}

fn ce_str_array(items: Vec<str>) -> Expr {
    var elements: Vec<Expr> = Vec::new();
    var i: i64 = 0;
    while i < items.len() {
        elements.push(Expr::StringLit(items.get(i)));
        i = i + 1;
    }
    return Expr::ArrayLit(Box::new(Type::Str), elements);
}

fn ce_find_func(funcs: Vec<Func>, name: str) -> i64 {
    var i: i64 = 0;
    while i < funcs.len() {
        if funcs.get(i).name == name { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

/// Effects declared on function (or method) `name`; Err if there is none.
fn ce_function_effects(original: &Program, name: str) -> ResultExpr {
    var fi: i64 = ce_find_func(original.funcs, name);
    if fi >= 0 { return ResultExpr::Ok(ce_str_array(original.funcs.get(fi).declared_effects)); }
    var i: i64 = 0;
    while i < original.impls.len() {
        var ms: Vec<Func> = original.impls.get(i).methods;
        var mi: i64 = ce_find_func(ms, name);
        if mi >= 0 { return ResultExpr::Ok(ce_str_array(ms.get(mi).declared_effects)); }
        i = i + 1;
    }
    i = 0;
    while i < original.trait_impls.len() {
        var ms2: Vec<Func> = original.trait_impls.get(i).methods;
        var mi2: i64 = ce_find_func(ms2, name);
        if mi2 >= 0 { return ResultExpr::Ok(ce_str_array(ms2.get(mi2).declared_effects)); }
        i = i + 1;
    }
    return ResultExpr::Err("function_effects: no function '" + name + "'");
}

/// The traits implemented by the type that defines method `name`.
fn ce_function_capabilities(original: &Program, name: str) -> ResultExpr {
    var owner: str = "";
    var i: i64 = 0;
    while i < original.trait_impls.len() && owner == "" {
        var ti: TraitImpl = original.trait_impls.get(i);
        if ce_find_func(ti.methods, name) >= 0 { owner = ti.type_name; }
        i = i + 1;
    }
    i = 0;
    while i < original.impls.len() && owner == "" {
        var im: ImplDef = original.impls.get(i);
        if ce_find_func(im.methods, name) >= 0 { owner = im.struct_name; }
        i = i + 1;
    }
    var traits: Vec<str> = Vec::new();
    if owner == "" {
        if ce_find_func(original.funcs, name) < 0 {
            return ResultExpr::Err("function_capabilities: no function '" + name + "'");
        }
        return ResultExpr::Ok(ce_str_array(traits));
    }
    i = 0;
    while i < original.trait_impls.len() {
        var t2: TraitImpl = original.trait_impls.get(i);
        if t2.type_name == owner {
            var seen: bool = false;
            var k: i64 = 0;
            while k < traits.len() {
                if traits.get(k) == t2.trait_name { seen = true; }
                k = k + 1;
            }
            if !seen { traits.push(t2.trait_name); }
        }
        i = i + 1;
    }
    return ResultExpr::Ok(ce_str_array(traits));
}

fn evaluate_reflect(op: ReflectOp, ty: Type, original: &Program) -> ResultExpr {
    var type_name: str = "";
    match ty {
        Type::Named(n) => { type_name = n; }
        Type::I8 => { type_name = "i8"; }
        Type::I16 => { type_name = "i16"; }
        Type::I32 => { type_name = "i32"; }
        Type::I64 => { type_name = "i64"; }
        Type::I128 => { type_name = "i128"; }
        Type::U8 => { type_name = "u8"; }
        Type::U16 => { type_name = "u16"; }
        Type::U32 => { type_name = "u32"; }
        Type::U64 => { type_name = "u64"; }
        Type::U128 => { type_name = "u128"; }
        Type::F32 => { type_name = "f32"; }
        Type::F64 => { type_name = "f64"; }
        Type::Bool => { type_name = "bool"; }
        Type::Str => { type_name = "str"; }
        Type::Void => { type_name = "void"; }
        _ => { return ResultExpr::Err("reflect: unsupported type"); }
    }

    match op {
        ReflectOp::TypeName => { return ResultExpr::Ok(Expr::StringLit(type_name)); }
        ReflectOp::IsStruct => {
            var found: bool = false;
            var si: i64 = 0;
            while si < original.structs.len() {
                if original.structs.get(si).name == type_name { found = true; }
                si = si + 1;
            }
            return ResultExpr::Ok(Expr::BoolLit(found));
        }
        ReflectOp::IsEnum => {
            var found: bool = false;
            var ei: i64 = 0;
            while ei < original.enums.len() {
                if original.enums.get(ei).name == type_name { found = true; }
                ei = ei + 1;
            }
            return ResultExpr::Ok(Expr::BoolLit(found));
        }
        ReflectOp::FieldCount => {
            var si: i64 = 0;
            while si < original.structs.len() {
                var s: StructDef = original.structs.get(si);
                if s.name == type_name {
                    return ResultExpr::Ok(Expr::IntLit(s.fields.len()));
                }
                si = si + 1;
            }
            return ResultExpr::Err("type_name: '" + type_name + "' is not a struct");
        }
        ReflectOp::FieldNames => {
            var si: i64 = 0;
            while si < original.structs.len() {
                var s: StructDef = original.structs.get(si);
                if s.name == type_name {
                    var elements: Vec<Expr> = Vec::new();
                    var fi: i64 = 0;
                    while fi < s.fields.len() {
                        elements.push(Expr::StringLit(s.fields.get(fi).name));
                        fi = fi + 1;
                    }
                    return ResultExpr::Ok(Expr::ArrayLit(Box::new(Type::Str), elements));
                }
                si = si + 1;
            }
            return ResultExpr::Err("field_names: '" + type_name + "' is not a struct");
        }
        ReflectOp::FieldTypes => {
            var si: i64 = 0;
            while si < original.structs.len() {
                var s: StructDef = original.structs.get(si);
                if s.name == type_name {
                    var elements: Vec<Expr> = Vec::new();
                    var fi: i64 = 0;
                    while fi < s.fields.len() {
                        elements.push(Expr::StringLit(type_to_str(s.fields.get(fi).ty)));
                        fi = fi + 1;
                    }
                    return ResultExpr::Ok(Expr::ArrayLit(Box::new(Type::Str), elements));
                }
                si = si + 1;
            }
            return ResultExpr::Err("field_types: '" + type_name + "' is not a struct");
        }
        ReflectOp::EnumVariants => {
            var ei: i64 = 0;
            while ei < original.enums.len() {
                var e: EnumDef = original.enums.get(ei);
                if e.name == type_name {
                    var elements: Vec<Expr> = Vec::new();
                    var vi: i64 = 0;
                    while vi < e.variants.len() {
                        elements.push(Expr::StringLit(e.variants.get(vi).name));
                        vi = vi + 1;
                    }
                    return ResultExpr::Ok(Expr::ArrayLit(Box::new(Type::Str), elements));
                }
                ei = ei + 1;
            }
            return ResultExpr::Err("enum_variants: '" + type_name + "' is not an enum");
        }
        ReflectOp::StructSize => {
            var ssi: i64 = ce_find_struct(original, type_name);
            if ssi < 0 { return ResultExpr::Err("struct_size: '" + type_name + "' is not a struct"); }
            return ResultExpr::Ok(Expr::IntLit(ce_struct_layout(original.structs.get(ssi), original, 0, "")));
        }
        ReflectOp::FieldOffset => {
            var dot: i64 = str_find(type_name, ".");
            if dot < 0 { return ResultExpr::Err("field_offset: expected Owner.member, got '" + type_name + "'"); }
            var owner: str = str_slice(type_name, 0, dot);
            var field: str = str_slice(type_name, dot + 1, str_len(type_name));
            var osi: i64 = ce_find_struct(original, owner);
            if osi < 0 { return ResultExpr::Err("field_offset: '" + owner + "' is not a struct"); }
            var off: i64 = ce_struct_layout(original.structs.get(osi), original, 0, field);
            if off < 0 { return ResultExpr::Err("field_offset: struct '" + owner + "' has no field '" + field + "'"); }
            return ResultExpr::Ok(Expr::IntLit(off));
        }
        ReflectOp::EnumDiscriminant => {
            var dot2: i64 = str_find(type_name, ".");
            if dot2 < 0 { return ResultExpr::Err("enum_discriminant: expected Owner.member, got '" + type_name + "'"); }
            var eowner: str = str_slice(type_name, 0, dot2);
            var variant: str = str_slice(type_name, dot2 + 1, str_len(type_name));
            var dei: i64 = 0;
            while dei < original.enums.len() {
                var de: EnumDef = original.enums.get(dei);
                if de.name == eowner {
                    var dvi: i64 = 0;
                    while dvi < de.variants.len() {
                        if de.variants.get(dvi).name == variant { return ResultExpr::Ok(Expr::IntLit(dvi)); }
                        dvi = dvi + 1;
                    }
                    return ResultExpr::Err("enum_discriminant: enum '" + eowner + "' has no variant '" + variant + "'");
                }
                dei = dei + 1;
            }
            return ResultExpr::Err("enum_discriminant: '" + eowner + "' is not an enum");
        }
        ReflectOp::FunctionEffects => { return ce_function_effects(original, type_name); }
        ReflectOp::FunctionCapabilities => { return ce_function_capabilities(original, type_name); }
    }
    return ResultExpr::Err("unreachable");
}
