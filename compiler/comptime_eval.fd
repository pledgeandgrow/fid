// comptime_eval.fd -- Compile-time evaluation engine, ported from src/comptime.rs
//
// Evuates `comptime <expr>`, `comptime { block }`, and `comptime reflect_op(T)`
// at compile time, substituting results as literals into the AST.
//
// Comptime functions (`comptime fn name(...) { ... }`) are evaluated by
// directly interpreting their AST bodies when called from a comptime context.

module compiler::comptime_eval;
use core;
use vec;
use string;
use compiler::ast;
use compiler::token;
use compiler::lexer;
use compiler::parser;
use compiler::ir;
use compiler::lower;
// --- Box helpers ---------------------------------------------------------
// Each module defines its own box_expr_unbox because Fides has no trait-based
// generic unbox. This mirrors the pattern in lower.fd, typechecker.fd, etc.

pub fn ct_box_expr_unbox(b: Box<Expr>) -> Expr {
    match b {
        Expr::IntLit(v) => {
            return Expr::IntLit(v);
        }
        Expr::FloatLit(v) => {
            return Expr::FloatLit(v);
        }
        Expr::StringLit(v) => {
            return Expr::StringLit(v);
        }
        Expr::BoolLit(v) => {
            return Expr::BoolLit(v);
        }
        Expr::Ident(n) => {
            return Expr::Ident(n);
        }
        Expr::Binary(op, l, r) => {
            return Expr::Binary(op, l, r);
        }
        Expr::Unary(op, e) => {
            return Expr::Unary(op, e);
        }
        Expr::Call(n, a) => {
            return Expr::Call(n, a);
        }
        Expr::FieldAccess(e, f) => {
            return Expr::FieldAccess(e, f);
        }
        Expr::OptionalFieldAccess(e, f) => {
            return Expr::OptionalFieldAccess(e, f);
        }
        Expr::StructLit(n, f, s) => {
            return Expr::StructLit(n, f, s);
        }
        Expr::If(c, t, e) => {
            return Expr::If(c, t, e);
        }
        Expr::Range(a, b, i) => {
            return Expr::Range(a, b, i);
        }
        Expr::Block(s) => {
            return Expr::Block(s);
        }
        Expr::MethodCall(r, m, a) => {
            return Expr::MethodCall(r, m, a);
        }
        Expr::ArrayLit(e, a) => {
            return Expr::ArrayLit(e, a);
        }
        Expr::Index(a, i) => {
            return Expr::Index(a, i);
        }
        Expr::FString(p) => {
            return Expr::FString(p);
        }
        Expr::Match(e, a) => {
            return Expr::Match(e, a);
        }
        Expr::EnumLit(en, v, a) => {
            return Expr::EnumLit(en, v, a);
        }
        Expr::Ref(e, m) => {
            return Expr::Ref(e, m);
        }
        Expr::Deref(e) => {
            return Expr::Deref(e);
        }
        Expr::StrConcat(l, r) => {
            return Expr::StrConcat(l, r);
        }
        Expr::Try(e) => {
            return Expr::Try(e);
        }
        Expr::Coalesce(l, r) => {
            return Expr::Coalesce(l, r);
        }
        Expr::IsCheck(e, n) => {
            return Expr::IsCheck(e, n);
        }
        Expr::TryBlock(s) => {
            return Expr::TryBlock(s);
        }
        Expr::TupleLit(e) => {
            return Expr::TupleLit(e);
        }
        Expr::Closure(p, b, r) => {
            return Expr::Closure(p, b, r);
        }
        Expr::Cast(e, ty) => {
            return Expr::Cast(e, ty);
        }
        Expr::Asm(s, o) => {
            return Expr::Asm(s, o);
        }
        Expr::Comptime(e) => {
            return Expr::Comptime(e);
        }
        Expr::ComptimeBlock(s) => {
            return Expr::ComptimeBlock(s);
        }
        Expr::ComptimeReflect(n, a) => {
            return Expr::ComptimeReflect(n, a);
        }
        Expr::PipeForward(l, r) => {
            return Expr::PipeForward(l, r);
        }
        Expr::QuantCast(e, ty) => {
            return Expr::QuantCast(e, ty);
        }
        Expr::Await(e) => {
            return Expr::Await(e);
        }
        Expr::Spawn(e) => {
            return Expr::Spawn(e);
        }
        Expr::Yield(e) => {
            return Expr::Yield(e);
        }
        Expr::NamedArg(name, e) => {
            return Expr::NamedArg(name, e);
        }
    }
    return Expr::IntLit(0);
}

// --- Comptime environment ------------------------------------------------
// Fides has no HashMap at compile time, so we use parallel Vecs.

pub struct ComptimeEnv {
    pub names: Vec<str>,
    pub values: Vec<Expr>,
}

pub fn ComptimeEnv_new() -> ComptimeEnv {
    return ComptimeEnv {
        names: Vec::new(), values: Vec::new()
    };
}

// Names are looked up from the last one declared: an inner block's `val x`
// hides an outer `x` (ComptimeEnv_declare) and an assignment reaches the
// innermost `x`.
pub fn ComptimeEnv_get(env: &ComptimeEnv, name: str) -> OptExpr {
    var i: i64 = env.names.len() - 1;
    while i >= 0 {
        if env.names.get(i) == name {
            return OptExpr::Some(env.values.get(i));
        }
        i = i - 1;
    }
    return OptExpr::None;
}

pub fn ComptimeEnv_set(env: &mut ComptimeEnv, name: str, v: Expr) {
    var i: i64 = env.names.len() - 1;
    while i >= 0 {
        if env.names.get(i) == name {
            env.values.set(i, v);
            return;
        }
        i = i - 1;
    }
    env.names.push(name);
    env.values.push(v);
}

/// `val name = v` in a block whose own names start at index `from`: a new
/// variable, even when an enclosing block has one of the same name (it was
/// overwritten, and the block's end wrote the inner value back to it).
pub fn ComptimeEnv_declare(env: &mut ComptimeEnv, name: str, v: Expr, from: i64) {
    var i: i64 = env.names.len() - 1;
    while i >= from {
        if env.names.get(i) == name {
            env.values.set(i, v);
            return;
        }
        i = i - 1;
    }
    env.names.push(name);
    env.values.push(v);
}

pub fn ComptimeEnv_clone(env: &ComptimeEnv) -> ComptimeEnv {
    var new_env: ComptimeEnv = ComptimeEnv_new();
    var i: i64 = 0;
    while i < env.names.len() {
        new_env.names.push(env.names.get(i));
        new_env.values.push(env.values.get(i));
        i = i + 1;
    }
    return new_env;
}

// --- Comptime tables (OP28) ------------------------------------------------
// A Vec built at compile time is an ArrayLit whose element type is
// __ctvec<T>; where its value lands in the program it becomes a block that
// builds the Vec from the computed elements, so the work that made them
// is gone from the binary.

pub fn ct_vec_of(elem_ty: Type, elements: Vec<Expr>) -> Expr {
    var a: Vec<Type> = Vec::new();
    a.push(elem_ty);
    return Expr::ArrayLit(Box::new(Type::Generic("__ctvec", a)), elements);
}

/// The elements of comptime Vec `e`, when it is one.
pub fn ct_vec_elems(e: Expr, out: &mut Vec<Expr>) -> bool {
    match e {
        Expr::ArrayLit(t, els) => {
            match ct_box_type_unbox(t) {
                Type::Generic(n, _) => {
                    if n == "__ctvec" {
                        var i: i64 = 0;
                        while i < els.len() {
                            out.push(els.get(i));
                            i = i + 1;
                        }
                        return true;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return false;
}

fn ct_box_type_unbox(b: Box<Type>) -> Type {
    return *b;
}

/// The type of a computed element: what its literal is.
fn ct_lit_type(e: Expr) -> Type {
    match ct_untag_type(e) {
        OptType::Some(uty) => {
            return uty;
        }
        OptType::None => {
        }
    }
    match e {
        Expr::IntLit(_) => {
            return Type::I64;
        }
        Expr::FloatLit(_) => {
            return Type::F64;
        }
        Expr::StringLit(_) => {
            return Type::Str;
        }
        Expr::BoolLit(_) => {
            return Type::Bool;
        }
        _ => {
        }
    }
    return Type::I64;
}

/// Program code for comptime value `v`: itself, or for a comptime Vec
/// `{ var __ctv: Vec<T> = Vec::new(); __ctv.push(e0); ...; __ctv }`.
pub fn ct_materialize(v: Expr) -> Expr {
    var els: Vec<Expr> = Vec::new();
    if !ct_vec_elems(v, &mut els) {
        return v;
    }
    var et: Type = Type::I64;
    if els.len() > 0 {
        et = ct_lit_type(els.get(0));
    }
    var targs: Vec<Type> = Vec::new();
    targs.push(et);
    var no_args: Vec<Expr> = Vec::new();
    var body: Vec<Stmt> = Vec::new();
    body.push(Stmt::Let("__ctv", OptType::Some(Type::Generic("Vec", targs)), Expr::MethodCall(Box::new(Expr::Ident("Vec")), "new", no_args), true, false, Vec::new(), 0));
    var i: i64 = 0;
    while i < els.len() {
        var pa: Vec<Expr> = Vec::new();
        pa.push(els.get(i));
        body.push(Stmt::Expr(Expr::MethodCall(Box::new(Expr::Ident("__ctv")), "push", pa), 0));
        i = i + 1;
    }
    body.push(Stmt::Expr(Expr::Ident("__ctv"), 0));
    return Expr::Block(body);
}

// --- The build's target, for comptime (§4.11, §12) -------------------------
// The same flags @cfg reads (compiler.fd's g_cfg_*), set by the pipeline
// before any comptime runs (host values when no --target names others):
// `comptime target_os() == "windows"` is the general form of which
// `@cfg(windows)` on a whole function or struct is the sugar.
pub var g_ct_target_os: str = "";
pub var g_ct_target_arch: str = "";
pub var g_ct_debug: bool = false;
pub var g_ct_features: str = "";

// --- Comptime safety: fatal errors, fuel, traces ---------------------------
// An explicit `comptime` that cannot be evaluated is a compile error. It
// used to warn once and run when the program did, so a comptime that
// silently became runtime work (and a table the program rebuilt on every
// run) looked fine. FID_CT_FALLBACK=1 keeps the old behavior
// (docs/verification/kill-switches.md).
var g_ct_fallback: bool = false;

// The fatal errors of the last substitute() (compiler.fd reports them as it
// reports comptime gen errors).
var g_ct_subst_errors: Vec<str> = Vec::new();
pub fn comptime_subst_errors() -> Vec<str> {
    return g_ct_subst_errors;
}

// Warned-once bookkeeping of fallback mode (as before the hardening).
var g_ct_warn_on: bool = false;
var g_ct_warned: i64 = 0;
fn ct_warn(msg: str) {
    if !g_ct_warn_on {
        return;
    }
    if g_ct_warned == 0 {
        g_ct_warned = HashMap_new();
    }
    if HashMap_get(g_ct_warned, msg) != 0 {
        return;
    }
    HashMap_insert(g_ct_warned, msg, 1);
    p_eprint_str("warning: comptime: " + msg + " -- evaluated when the program runs instead\n");
}

// Fuel: the total work one evaluation pass may do, in steps (one expression
// node, statement, binop or call each). A comptime that would run away is
// an error, never a hang of the compiler. FID_CT_FUEL=N overrides the
// default budget.
var g_ct_fuel: i64 = 0;
var g_ct_steps: i64 = 0;

/// Whether another step is within the budget (and charges it).
fn ct_fuel_left() -> bool {
    if g_ct_fuel == 0 {
        g_ct_fuel = 100000000;
        var fe: str = p_getenv("FID_CT_FUEL");
        if str_len(fe) > 0 {
            g_ct_fuel = str_parse_int(fe);
            if g_ct_fuel < 1 {
                g_ct_fuel = 1000000000;
            }
        }
    }
    g_ct_steps = g_ct_steps + 1;
    return g_ct_steps <= g_ct_fuel;
}

fn ct_out_of_fuel() -> ResultExpr {
    return ResultExpr::Err("comptime evaluation ran past its fuel budget of " + int_to_str(g_ct_fuel) + " steps (FID_CT_FUEL raises it; compute less at compile time)");
}

// The comptime call stack, for error traces: one frame per comptime fn call
// being evaluated, the innermost source line reached, and the statement of
// the program whose expression is being substituted.
var g_ct_call_stack: Vec<str> = Vec::new();
var g_ct_line: i64 = 0;
var g_ct_subst_line: i64 = 0;

/// The comptime frames, innermost first, plus the line being run; the empty
/// string when there is nothing to show. Frames stay on the stack when an
/// error passes through (call_comptime_func pops only on success), so the
/// boundary that reports the error sees the whole failing chain; the
/// boundary clears them before the next evaluation.
fn ct_trace() -> str {
    var s: str = "";
    var i: i64 = g_ct_call_stack.len() - 1;
    var shown: i64 = 0;
    while i >= 0 && shown < 8 {
        s = s + "\n  " + g_ct_call_stack.get(i);
        i = i - 1;
        shown = shown + 1;
    }
    if i >= 0 {
        s = s + "\n  .. " + int_to_str(i + 1) + " more comptime frame(s)";
    }
    if g_ct_line > 0 {
        s = s + "\n  while running line " + int_to_str(g_ct_line);
    }
    return s;
}

/// " (line N)" for a message, or "" when the line is unknown.
fn ct_at(line: i64) -> str {
    if line > 0 {
        return " (line " + int_to_str(line) + ")";
    }
    return "";
}

/// A comptime result landing in a narrower integer type fits, or the build
/// stops naming the value (§4.11) — the literal-range rule (E079) extended
/// to what comptime computed.
fn ct_check_int_fit(ty: Type, expr: &Expr, name: str, errs: &mut Vec<str>) {
    var v: i64 = 0;
    var v_unsigned: bool = false;
    match ct_untag_type(*expr) {
        OptType::Some(uty) => {
            // A value tagged unsigned (BG62): its bits already sit inside that
            // width — it fits an unsigned target of the same or a wider one
            v = ct_int_untag(*expr);
            v_unsigned = true;
        }
        OptType::None => {
            match expr {
                Expr::IntLit(n) => {
                    v = n;
                }
                _ => {
                    return;
                }
            }
        }
    }
    var lo: i64 = 0;
    var hi: i64 = 0;
    var tname: str = "";
    match ty {
        Type::I8 => {
            lo = 0 - 128;
            hi = 127;
            tname = "i8";
        }
        Type::U8 => {
            lo = 0;
            hi = 255;
            tname = "u8";
        }
        Type::I16 => {
            lo = 0 - 32768;
            hi = 32767;
            tname = "i16";
        }
        Type::U16 => {
            lo = 0;
            hi = 65535;
            tname = "u16";
        }
        Type::I32 => {
            lo = 0 - 2147483648;
            hi = 2147483647;
            tname = "i32";
        }
        Type::U32 => {
            lo = 0;
            hi = 4294967295;
            tname = "u32";
        }
        Type::U64 => {
            lo = 0;
            hi = 9223372036854775807;
            tname = "u64";
        }
        _ => {
            return;
        }
    }
    if v_unsigned {
        // The bits are already inside an unsigned width: they fit iff the
        // target's range, read unsigned, holds them. u64 holds any bits.
        var uv: u64 = v as u64;
        var ok: bool = true;
        match ty {
            Type::U64 => {
            }
            Type::U128 => {
            }
            _ => {
                ok = uv <= (hi as u64);
            }
        }
        if !ok {
            var umsg: str = "comptime value " + u64_to_str(uv) + " does not fit in " + tname + " ('" + name + "')";
            errs.push(umsg);
            ct_fatal_push(umsg);
        }
        return;
    }
    if v < lo || v > hi {
        var msg: str = "comptime value " + int_to_str(v) + " does not fit in " + tname + " ('" + name + "')";
        errs.push(msg);
        ct_fatal_push(msg);
    }
}

/// Onto the fatal list, once: the substitution phases iterate, so the same
/// failed comptime is reported per round without this.
fn ct_fatal_push(msg: str) {
    var i: i64 = 0;
    while i < g_ct_subst_errors.len() {
        if g_ct_subst_errors.get(i) == msg {
            return;
        }
        i = i + 1;
    }
    g_ct_subst_errors.push(msg);
}

/// Where a failed explicit comptime is reported from: the statement whose
/// expression holds it (substitute_stmt), or 0 (a constant's initializer).
fn ct_stmt_line(stmt: Stmt) -> i64 {
    match stmt {
        Stmt::Let(_, _, _, _, _, _, ln) => {
            return ln;
        }
        Stmt::LetTuple(_, _, ln) => {
            return ln;
        }
        Stmt::Assign(_, _, _, ln) => {
            return ln;
        }
        Stmt::IndexAssign(_, _, _, _, ln) => {
            return ln;
        }
        Stmt::DerefAssign(_, _, _, ln) => {
            return ln;
        }
        Stmt::FieldAssign(_, _, _, _, ln) => {
            return ln;
        }
        Stmt::Expr(_, ln) => {
            return ln;
        }
        Stmt::Return(_, ln) => {
            return ln;
        }
        Stmt::If(_, _, _, ln) => {
            return ln;
        }
        Stmt::While(_, _, ln) => {
            return ln;
        }
        Stmt::For(_, _, _, ln) => {
            return ln;
        }
        Stmt::Match(_, _, ln) => {
            return ln;
        }
        Stmt::Loop(_, ln) => {
            return ln;
        }
        Stmt::Break(_, ln) => {
            return ln;
        }
        Stmt::Continue(ln) => {
            return ln;
        }
        Stmt::Defer(_, ln) => {
            return ln;
        }
        Stmt::ComptimeGen(_, ln) => {
            return ln;
        }
        _ => {
        }
    }
    return 0;
}

// --- Result type for comptime evuation ---------------------------------

pub enum OptExpr {
    Some(Expr),
    None,
}

pub enum ResultExpr {
    Ok(Expr),
    Err(str),
}

// --- process_gen ---------------------------------------------------------
// Process `comptime gen` blocks: evaluate them, parse the result as Fides
// source, and inject generated functions/structs into the program.

// The errors of the last process_gen (they were dropped before: a failed
// parse of generated code or an evaluation error was silent)
var g_ct_gen_errors: Vec<str> = Vec::new();
pub fn comptime_gen_errors() -> Vec<str> {
    return g_ct_gen_errors;
}

pub fn process_gen(program: Program) -> Program {
    var prog: Program = program;
    g_ct_gen_errors = Vec::new();
    // A fresh fuel budget and call stack for this pass's evaluations
    // (substitute, which runs later, resets both again).
    g_ct_steps = 0;
    g_ct_call_stack = Vec::new();
    g_ct_memo_keys = Vec::new();
    g_ct_memo_vals = Vec::new();
    g_ct_line = 0;
    g_ct_subst_line = 0;
    var fbg: str = p_getenv("FID_CT_FALLBACK");
    g_ct_fallback = str_len(fbg) > 0 && (fbg as i64) != 0;

    // First, substitute comptime expressions inside comptime gen blocks
    var errs: Vec<str> = Vec::new();
    // LG9: `comptime splice` expressions are expanded before anything else
    // (the comptime fns a gen block calls have theirs in place), and before
    // type checking, which sees only the generated expressions
    if parser_saw_splice() {
        prog = ct_expand_splices(prog, &mut errs);
    }
    var fi: i64 = 0;
    while fi < prog.funcs.len() {
        substitute_comptime_gen_blocks(&mut prog.funcs, fi, &prog, &mut errs);
        fi = fi + 1;
    }

    // Now process the gen blocks
    var generated_funcs: Vec<Func> = Vec::new();
    var generated_structs: Vec<StructDef> = Vec::new();
    // Generated enums, constants, impl blocks and trait impls (LG9)
    var gen_rest: Program = program_new();
    var func_count: i64 = prog.funcs.len();
    var idx: i64 = 0;
    while idx < func_count {
        process_comptime_gen_in_func(&mut prog.funcs, idx, &prog, &mut generated_funcs, &mut generated_structs, &mut gen_rest, &mut errs);
        idx = idx + 1;
    }
    var ei: i64 = 0;
    while ei < gen_rest.enums.len() {
        prog.enums.push(gen_rest.enums.get(ei));
        ei = ei + 1;
    }
    var ci: i64 = 0;
    while ci < gen_rest.consts.len() {
        prog.consts.push(gen_rest.consts.get(ci));
        ci = ci + 1;
    }
    var ii: i64 = 0;
    while ii < gen_rest.impls.len() {
        prog.impls.push(gen_rest.impls.get(ii));
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < gen_rest.trait_impls.len() {
        prog.trait_impls.push(gen_rest.trait_impls.get(ti));
        ti = ti + 1;
    }

    // Append generated funcs/structs
    var gi: i64 = 0;
    while gi < generated_funcs.len() {
        prog.funcs.push(generated_funcs.get(gi));
        gi = gi + 1;
    }
    var si: i64 = 0;
    while si < generated_structs.len() {
        prog.structs.push(generated_structs.get(si));
        si = si + 1;
    }
    // CL6: `==` on the structs and enums gen created compares by content,
    // as on declared ones (compiler.fd synthesizes those before this pass)
    if generated_structs.len() > 0 || gen_rest.enums.len() > 0 {
        ct_gen_synth_eq(&mut prog, generated_structs, gen_rest.enums);
    }
    g_ct_gen_errors = errs;
    return prog;
}

// --- `==` for generated types (CL6) -------------------------------------------
// compiler.fd synthesize_enum_eq / synthesize_struct_eq run before
// process_gen, so a struct or enum `comptime gen` creates had no `__eq_<T>`
// and `==` on it compared words (false for equal values). The same helpers
// are made here for the generated types only, with the same shape:
//
//     fn __eq_S(__eq_a: S, __eq_b: S) -> bool { return __eq_a.f == __eq_b.f && ..; }
//     fn __eq_E(__eq_a: E, __eq_b: E) -> bool {
//         match __eq_a { E::V(__a0, ..) => { match __eq_b {
//             E::V(__b0, ..) => { return __a0 == __b0 && ..; } _ => { return false; } } } .. }
//         return false;
//     }
//
// A type whose `__eq_` exists already (written by the program) is skipped,
// and so are generic types and structs with a field of a generic struct or
// enum (as there).

/// The core function comparing two Vecs of type `t` by content, as
/// lower.fd vec_eq_fn_for: "" for anything else (compared with `==`).
fn ct_gen_vec_eq_fn(t: Type) -> str {
    match t {
        Type::Generic(gname, gargs) => {
            if gname != "Vec" || gargs.len() != 1 {
                return "";
            }
            match gargs.get(0) {
                Type::Str => {
                    return "Vec_eq_strs";
                }
                Type::I8 => {
                    return "Vec_eq_words";
                }
                Type::I16 => {
                    return "Vec_eq_words";
                }
                Type::I32 => {
                    return "Vec_eq_words";
                }
                Type::I64 => {
                    return "Vec_eq_words";
                }
                Type::U8 => {
                    return "Vec_eq_words";
                }
                Type::U16 => {
                    return "Vec_eq_words";
                }
                Type::U32 => {
                    return "Vec_eq_words";
                }
                Type::U64 => {
                    return "Vec_eq_words";
                }
                Type::F64 => {
                    return "Vec_eq_words";
                }
                Type::Bool => {
                    return "Vec_eq_words";
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return "";
}

/// `E::V(<prefix>0, .., <prefix>n-1)` as a pattern.
fn ct_gen_eq_pattern(enum_name: str, variant: str, prefix: str, n: i64) -> Pattern {
    var binds: Vec<Binding> = Vec::new();
    var i: i64 = 0;
    while i < n {
        binds.push(Binding_new(prefix + int_to_str(i), ""));
        i = i + 1;
    }
    return Pattern::EnumVariant(enum_name, variant, binds);
}

/// Whether `funcs` has a function `name`.
fn ct_gen_has_func(funcs: Vec<Func>, name: str) -> bool {
    var i: i64 = 0;
    while i < funcs.len() {
        if funcs.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// `__eq_<T>` for each generated struct and enum (see above), added to
/// `prog`.
fn ct_gen_synth_eq(prog: &mut Program, gstructs: Vec<StructDef>, genums: Vec<EnumDef>) {
    var generic_defs: Vec<str> = Vec::new();
    var gd: i64 = 0;
    while gd < prog.structs.len() {
        if prog.structs.get(gd).type_params.len() > 0 {
            generic_defs.push(prog.structs.get(gd).name);
        }
        gd = gd + 1;
    }
    gd = 0;
    while gd < prog.enums.len() {
        if prog.enums.get(gd).type_params.len() > 0 {
            generic_defs.push(prog.enums.get(gd).name);
        }
        gd = gd + 1;
    }
    var made: Vec<Func> = Vec::new();
    var si: i64 = 0;
    while si < gstructs.len() {
        var s: StructDef = gstructs.get(si);
        si = si + 1;
        if s.type_params.len() > 0 {
            continue;
        }
        var sname: str = "__eq_" + s.name;
        if ct_gen_has_func(prog.funcs, sname) {
            continue;
        }
        var skip: bool = false;
        var same: Expr = Expr::BoolLit(true);
        var i: i64 = 0;
        while i < s.fields.len() {
            var f: Param = s.fields.get(i);
            match f.ty {
                Type::Generic(fgname, _) => {
                    if str_vec_contains(generic_defs, fgname) {
                        skip = true;
                    }
                }
                _ => {
                }
            }
            var fa: Expr = Expr::FieldAccess(Box::new(Expr::Ident("__eq_a")), f.name);
            var fb: Expr = Expr::FieldAccess(Box::new(Expr::Ident("__eq_b")), f.name);
            var cmp: Expr = Expr::Binary(BinOp::Eq, Box::new(fa), Box::new(fb));
            var veq: str = ct_gen_vec_eq_fn(f.ty);
            if veq != "" {
                var vargs: Vec<Expr> = Vec::new();
                vargs.push(Expr::FieldAccess(Box::new(Expr::Ident("__eq_a")), f.name));
                vargs.push(Expr::FieldAccess(Box::new(Expr::Ident("__eq_b")), f.name));
                cmp = Expr::Call(veq, vargs);
            }
            if i == 0 {
                same = cmp;
            } else {
                same = Expr::Binary(BinOp::And, Box::new(same), Box::new(cmp));
            }
            i = i + 1;
        }
        if skip {
            continue;
        }
        var sparams: Vec<Param> = Vec::new();
        sparams.push(Param_new("__eq_a", Type::Named(s.name), false));
        sparams.push(Param_new("__eq_b", Type::Named(s.name), false));
        var sbody: Vec<Stmt> = Vec::new();
        sbody.push(Stmt::Return(OptBoxExpr::Some(Box::new(same)), 0));
        made.push(Func_new_full(sname, sparams, Type::Bool, sbody, true));
    }
    var ei: i64 = 0;
    while ei < genums.len() {
        var e: EnumDef = genums.get(ei);
        ei = ei + 1;
        if e.type_params.len() > 0 {
            continue;
        }
        var ename: str = "__eq_" + e.name;
        if ct_gen_has_func(prog.funcs, ename) {
            continue;
        }
        var arms: Vec<MatchArm> = Vec::new();
        var vi: i64 = 0;
        while vi < e.variants.len() {
            var v: EnumVariant = e.variants.get(vi);
            vi = vi + 1;
            var n: i64 = 0;
            match v.data {
                OptParams::Some(ps) => {
                    n = ps.len();
                }
                OptParams::None => {
                }
            }
            var vsame: Expr = Expr::BoolLit(true);
            var k: i64 = 0;
            while k < n {
                var field_eq: Expr = Expr::Binary(BinOp::Eq, Box::new(Expr::Ident("__a" + int_to_str(k))), Box::new(Expr::Ident("__b" + int_to_str(k))));
                if k == 0 {
                    vsame = field_eq;
                } else {
                    vsame = Expr::Binary(BinOp::And, Box::new(vsame), Box::new(field_eq));
                }
                k = k + 1;
            }
            var same_body: Vec<Stmt> = Vec::new();
            same_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(vsame)), 0));
            var differ_body: Vec<Stmt> = Vec::new();
            differ_body.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::BoolLit(false))), 0));
            var inner_arms: Vec<MatchArm> = Vec::new();
            inner_arms.push(MatchArm_new(ct_gen_eq_pattern(e.name, v.name, "__b", n), OptBoxExpr::None, same_body));
            inner_arms.push(MatchArm_new(Pattern::Wildcard, OptBoxExpr::None, differ_body));
            var outer_body: Vec<Stmt> = Vec::new();
            outer_body.push(Stmt::Match(Expr::Ident("__eq_b"), inner_arms, 0));
            arms.push(MatchArm_new(ct_gen_eq_pattern(e.name, v.name, "__a", n), OptBoxExpr::None, outer_body));
        }
        var eparams: Vec<Param> = Vec::new();
        eparams.push(Param_new("__eq_a", Type::Named(e.name), false));
        eparams.push(Param_new("__eq_b", Type::Named(e.name), false));
        var ebody: Vec<Stmt> = Vec::new();
        ebody.push(Stmt::Match(Expr::Ident("__eq_a"), arms, 0));
        ebody.push(Stmt::Return(OptBoxExpr::Some(Box::new(Expr::BoolLit(false))), 0));
        made.push(Func_new_full(ename, eparams, Type::Bool, ebody, true));
    }
    var mi: i64 = 0;
    while mi < made.len() {
        prog.funcs.push(made.get(mi));
        mi = mi + 1;
    }
}

fn substitute_comptime_gen_blocks(funcs: &mut Vec<Func>, idx: i64, original: &Program, errs: &mut Vec<str>) {
    var func: Func = funcs.get(idx);
    var si: i64 = 0;
    while si < func.body.len() {
        match func.body.get(si) {
            Stmt::ComptimeGen(block, gen_line) => {
                var block_copy: Vec<Stmt> = block;
                substitute_stmts(&mut block_copy, original, errs);
                func.body.set(si, Stmt::ComptimeGen(block_copy, gen_line));
            }
            _ => {
            }
        }
        si = si + 1;
    }
    funcs.set(idx, func);
}

fn process_comptime_gen_in_func(funcs: &mut Vec<Func>, idx: i64, original: &Program, generated_funcs: &mut Vec<Func>, generated_structs: &mut Vec<StructDef>, gen_rest: &mut Program, errs: &mut Vec<str>) {
    var func: Func = funcs.get(idx);
    var new_body: Vec<Stmt> = Vec::new();
    var si: i64 = 0;
    while si < func.body.len() {
        match func.body.get(si) {
            Stmt::ComptimeGen(block, line) => {
                var result: ResultExpr = evaluate_block(block, original);
                match result {
                    ResultExpr::Ok(v) => {
                        match v {
                            Expr::StringLit(source) => {
                                var parse_result: OptProgram = parse_generated_code(source);
                                match parse_result {
                                    OptProgram::Some(gen_prog) => {
                                        // LG9: a generated name never silently
                                        // replaces or shadows one the program (or
                                        // an earlier generation) declares
                                        var gfi: i64 = 0;
                                        while gfi < gen_prog.funcs.len() {
                                            var gname: str = gen_prog.funcs.get(gfi).name;
                                            if ct_gen_func_taken(original, generated_funcs, gname) {
                                                errs.push("comptime gen (line " + int_to_str(line) + "): generated function '" + gname + "' collides with a function already declared; give the generated one a unique name");
                                            } else {
                                                generated_funcs.push(gen_prog.funcs.get(gfi));
                                            }
                                            gfi = gfi + 1;
                                        }
                                        var gsi: i64 = 0;
                                        while gsi < gen_prog.structs.len() {
                                            var gsname: str = gen_prog.structs.get(gsi).name;
                                            if ct_gen_struct_taken(original, generated_structs, gsname) || ct_gen_enum_in(gen_rest.enums, gsname) {
                                                errs.push("comptime gen (line " + int_to_str(line) + "): generated struct '" + gsname + "' collides with a type already declared; give the generated one a unique name");
                                            } else {
                                                generated_structs.push(gen_prog.structs.get(gsi));
                                            }
                                            gsi = gsi + 1;
                                        }
                                        // Enums, constants, impl blocks and trait
                                        // impls are added too (they were dropped
                                        // without a word), under the same rule
                                        ct_gen_merge_rest(gen_prog, original, generated_structs, gen_rest, line, errs);
                                    }
                                    OptProgram::None => {
                                        errs.push("comptime gen: failed to parse generated code");
                                    }
                                }
                            }
                            _ => {
                                errs.push("comptime gen: block must evaluate to a string");
                            }
                        }
                    }
                    ResultExpr::Err(msg) => {
                        errs.push("comptime gen error: " + msg + ct_trace());
                    }
                }
            }
            other => {
                new_body.push(other);
            }
        }
        si = si + 1;
    }
    func.body = new_body;
    funcs.set(idx, func);
}

pub enum OptProgram {
    Some(Program),
    None,
}

fn ct_gen_func_taken(original: &Program, generated: &Vec<Func>, name: str) -> bool {
    var i: i64 = 0;
    while i < original.funcs.len() {
        if original.funcs.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while i < generated.len() {
        if generated.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn ct_gen_struct_taken(original: &Program, generated: &Vec<StructDef>, name: str) -> bool {
    var i: i64 = 0;
    while i < original.structs.len() {
        if original.structs.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while i < original.enums.len() {
        if original.enums.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while i < generated.len() {
        if generated.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn ct_gen_enum_in(enums: Vec<EnumDef>, name: str) -> bool {
    var i: i64 = 0;
    while i < enums.len() {
        if enums.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn ct_gen_const_taken(original: &Program, rest: Vec<ConstDef>, name: str) -> bool {
    var i: i64 = 0;
    while i < original.consts.len() {
        if original.consts.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while i < original.globals.len() {
        if original.globals.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    i = 0;
    while i < rest.len() {
        if rest.get(i).name == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Whether an `impl <sname>` block of `impls` already has a method `mname`.
fn ct_gen_impl_has(impls: Vec<ImplDef>, sname: str, mname: str) -> bool {
    var i: i64 = 0;
    while i < impls.len() {
        var im: ImplDef = impls.get(i);
        if im.struct_name == sname {
            var j: i64 = 0;
            while j < im.methods.len() {
                if im.methods.get(j).name == mname {
                    return true;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return false;
}

fn ct_gen_trait_impl_in(tis: Vec<TraitImpl>, trait_name: str, type_name: str) -> bool {
    var i: i64 = 0;
    while i < tis.len() {
        if tis.get(i).trait_name == trait_name && tis.get(i).type_name == type_name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// LG9: the declarations of generated code other than functions and
/// structs. Enums, constants, impl blocks and trait impls are collected in
/// `rest` (process_gen adds them to the program) unless a name is already
/// taken; a kind `comptime gen` does not add (a trait, a global, a type
/// alias, an extern block, a `use`) is an error rather than dropped.
fn ct_gen_merge_rest(gp: Program, original: &Program, gstructs: &Vec<StructDef>, rest: &mut Program, line: i64, errs: &mut Vec<str>) {
    var at: str = "comptime gen (line " + int_to_str(line) + "): ";
    var i: i64 = 0;
    while i < gp.enums.len() {
        var ed: EnumDef = gp.enums.get(i);
        if ct_gen_struct_taken(original, gstructs, ed.name) || ct_gen_enum_in(rest.enums, ed.name) {
            errs.push(at + "generated enum '" + ed.name + "' collides with a type already declared; give the generated one a unique name");
        } else {
            rest.enums.push(ed);
        }
        i = i + 1;
    }
    i = 0;
    while i < gp.consts.len() {
        var cd: ConstDef = gp.consts.get(i);
        if ct_gen_const_taken(original, rest.consts, cd.name) {
            errs.push(at + "generated constant '" + cd.name + "' collides with a constant or global already declared; give the generated one a unique name");
        } else {
            rest.consts.push(cd);
        }
        i = i + 1;
    }
    i = 0;
    while i < gp.impls.len() {
        var im: ImplDef = gp.impls.get(i);
        var kept: Vec<Func> = Vec::new();
        var j: i64 = 0;
        while j < im.methods.len() {
            var mname: str = im.methods.get(j).name;
            if ct_gen_impl_has(original.impls, im.struct_name, mname) || ct_gen_impl_has(rest.impls, im.struct_name, mname) {
                errs.push(at + "generated method '" + im.struct_name + "." + mname + "' collides with a method already declared; give the generated one a unique name");
            } else {
                kept.push(im.methods.get(j));
            }
            j = j + 1;
        }
        if kept.len() > 0 {
            im.methods = kept;
            rest.impls.push(im);
        }
        i = i + 1;
    }
    i = 0;
    while i < gp.trait_impls.len() {
        var ti: TraitImpl = gp.trait_impls.get(i);
        if ct_gen_trait_impl_in(original.trait_impls, ti.trait_name, ti.type_name) || ct_gen_trait_impl_in(rest.trait_impls, ti.trait_name, ti.type_name) {
            errs.push(at + "generated `impl " + ti.trait_name + " for " + ti.type_name + "` collides with one already declared");
        } else {
            rest.trait_impls.push(ti);
        }
        i = i + 1;
    }
    if gp.traits.len() > 0 {
        errs.push(at + "generated code declares the trait '" + gp.traits.get(0).name + "'; `comptime gen` adds functions, structs, enums, constants and impls only: declare it in the source");
    }
    if gp.globals.len() > 0 {
        errs.push(at + "generated code declares the global '" + gp.globals.get(0).name + "'; `comptime gen` adds functions, structs, enums, constants and impls only: declare it in the source");
    }
    if gp.type_aliases.len() > 0 {
        errs.push(at + "generated code declares a type alias; `comptime gen` adds functions, structs, enums, constants and impls only: declare it in the source");
    }
    if gp.extern_decls.len() > 0 || gp.imports.len() > 0 {
        errs.push(at + "generated code has an extern block or a `use`; `comptime gen` adds functions, structs, enums, constants and impls only: write it in the source");
    }
}

// --- gensym (LG9 hygiene) ----------------------------------------------------
// `gensym("helper")` in a comptime context gives a name no declaration of
// the program uses and no earlier gensym gave: `helper__gs1`, `helper__gs2`,
// ... Generated code names its private helpers with it, so they can never
// collide with (or capture) a name the program declares.

var g_ct_gensym_n: i64 = 0;
fn ct_gensym(prefix: str, original: &Program) -> str {
    var empty_f: Vec<Func> = Vec::new();
    var empty_s: Vec<StructDef> = Vec::new();
    var empty_c: Vec<ConstDef> = Vec::new();
    while true {
        g_ct_gensym_n = g_ct_gensym_n + 1;
        var name: str = prefix + "__gs" + int_to_str(g_ct_gensym_n);
        if !ct_gen_func_taken(original, &empty_f, name) && !ct_gen_struct_taken(original, &empty_s, name) && !ct_gen_const_taken(original, empty_c, name) {
            return name;
        }
    }
    return prefix;
}

/// Whether the program declares a comptime function `name` (one of its own
/// wins over a builtin of the evaluator).
fn ct_has_comptime_fn(original: &Program, name: str) -> bool {
    var i: i64 = 0;
    while i < original.funcs.len() {
        if original.funcs.get(i).name == name && original.funcs.get(i).is_comptime {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// CD8: builtins that reach outside the compiler. The evaluator never runs
/// them; a comptime that calls one is reported as doing I/O (the
/// typechecker rejects it in `comptime` expressions and `comptime fn`s).
fn ct_io_builtin(name: str) -> bool {
    if name == "print" || name == "println" || name == "eprint" || name == "eprintln" || name == "print_int" || name == "print_str" || name == "print_float" || name == "read_file" || name == "write_file" || name == "read_line" || name == "read_stdin" || name == "env_var" || name == "arg_at" || name == "http_get" || name == "http_post" || name == "spawn" || name == "exec" || name == "system" {
        return true;
    }
    if str_starts_with(name, "p_print") || str_starts_with(name, "p_eprint") || str_starts_with(name, "p_file_") || str_starts_with(name, "p_dir_") || str_starts_with(name, "p_socket_") || str_starts_with(name, "p_net_") || str_starts_with(name, "p_http_") || str_starts_with(name, "p_dns_") || str_starts_with(name, "p_tls_") || str_starts_with(name, "p_process_") || str_starts_with(name, "p_clock_") || str_starts_with(name, "p_dl_") || str_starts_with(name, "p_co_") {
        return true;
    }
    return name == "p_system" || name == "p_getenv" || name == "p_env_get" || name == "p_argv" || name == "p_argc" || name == "p_read_line" || name == "p_read_stdin" || name == "p_time_now" || name == "p_os_random_u64" || name == "p_thread_spawn" || name == "p_mkdir" || name == "p_rename" || name == "p_remove";
}

/// Whether an evaluation error is the I/O one ct_io_builtin leads to.
fn ct_io_message(msg: str) -> bool {
    var tail: str = "comptime code runs inside the compiler with no I/O";
    var n: i64 = str_len(msg);
    var m: i64 = str_len(tail);
    var i: i64 = 0;
    while i + m <= n {
        if str_slice(msg, i, i + m) == tail {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// §4.11 annotation reflection: the names of the annotations on a struct
/// (`struct_annotations("S")`) or one of its fields
/// (`field_annotations("S", "f")`), as a comptime Vec<str>. Compile-time
/// code acts on the safety annotations a declaration carries: a serializer
/// generated from reflection can refuse a @secret field, a zeroizer can
/// find the @zeroize ones.
fn ct_annotations_call(callee: str, a: Vec<Expr>, original: &Program) -> ResultExpr {
    // The build's target (§4.11): the flags @cfg reads, as values
    if callee == "target_os" {
        return ResultExpr::Ok(Expr::StringLit(g_ct_target_os));
    }
    if callee == "target_arch" {
        return ResultExpr::Ok(Expr::StringLit(g_ct_target_arch));
    }
    if callee == "build_debug" {
        return ResultExpr::Ok(Expr::BoolLit(g_ct_debug));
    }
    if callee == "feature_enabled" {
        if a.len() != 1 {
            return ResultExpr::Err("feature_enabled takes one argument, the feature's name (a str)");
        }
        match a.get(0) {
            Expr::StringLit(feat) => {
                return ResultExpr::Ok(Expr::BoolLit(str_contains(g_ct_features, "
" + feat + "
")));
            }
            _ => {
            }
        }
        return ResultExpr::Err("feature_enabled takes the feature's name as a string");
    }
    // String-named siblings of the reflect ops (§4.11): what a comptime fn
    // composes on inside its body (field_names_of / field_count_of), where
    // a type operand cannot be written — a comptime fn's parameters and
    // locals are values, and `comptime T: type` hands the name over with
    // `comptime type_name(T)`.
    if callee == "field_count_of" {
        if a.len() != 1 {
            return ResultExpr::Err("field_count_of takes one argument, the struct's name (a str)");
        }
        match a.get(0) {
            Expr::StringLit(sn0) => {
                var ci: i64 = ce_find_struct(original, sn0);
                if ci < 0 {
                    return ResultExpr::Err("field_count_of: '" + sn0 + "' is not a struct");
                }
                return ResultExpr::Ok(Expr::IntLit(original.structs.get(ci).fields.len()));
            }
            _ => {
            }
        }
        return ResultExpr::Err("field_count_of takes the struct's name as a string");
    }
    if callee == "field_names_of" {
        if a.len() != 1 {
            return ResultExpr::Err("field_names_of takes one argument, the struct's name (a str)");
        }
        match a.get(0) {
            Expr::StringLit(sn1) => {
                var ci1: i64 = ce_find_struct(original, sn1);
                if ci1 < 0 {
                    return ResultExpr::Err("field_names_of: '" + sn1 + "' is not a struct");
                }
                var ns: Vec<str> = Vec::new();
                var fi1: i64 = 0;
                var sfields: Vec<Param> = original.structs.get(ci1).fields;
                while fi1 < sfields.len() {
                    ns.push(sfields.get(fi1).name);
                    fi1 = fi1 + 1;
                }
                return ResultExpr::Ok(ct_str_vec(ns));
            }
            _ => {
            }
        }
        return ResultExpr::Err("field_names_of takes the struct's name as a string");
    }
    if callee == "struct_annotations" {
        if a.len() != 1 {
            return ResultExpr::Err("struct_annotations takes one argument, the struct's name (as type_name gives it)");
        }
        match a.get(0) {
            Expr::StringLit(sn) => {
                var si: i64 = ce_find_struct(original, sn);
                if si < 0 {
                    return ResultExpr::Err("struct_annotations: '" + sn + "' is not a struct");
                }
                var names: Vec<str> = Vec::new();
                var ai: i64 = 0;
                var anns: Vec<Annotation> = original.structs.get(si).annotations;
                while ai < anns.len() {
                    names.push(anns.get(ai).name);
                    ai = ai + 1;
                }
                return ResultExpr::Ok(ct_str_vec(names));
            }
            _ => {
            }
        }
        return ResultExpr::Err("struct_annotations takes the struct's name as a string (type_name(T) composes)");
    }
    // field_annotations("S", "f")
    if a.len() != 2 {
        return ResultExpr::Err("field_annotations takes two arguments, the struct's name and the field's (as strings)");
    }
    var sname: str = "";
    var fname: str = "";
    match a.get(0) {
        Expr::StringLit(sn2) => {
            sname = sn2;
        }
        _ => {
            return ResultExpr::Err("field_annotations takes the struct's name as a string (type_name(T) composes)");
        }
    }
    match a.get(1) {
        Expr::StringLit(fn2) => {
            fname = fn2;
        }
        _ => {
            return ResultExpr::Err("field_annotations takes the field's name as a string");
        }
    }
    var si2: i64 = ce_find_struct(original, sname);
    if si2 < 0 {
        return ResultExpr::Err("field_annotations: '" + sname + "' is not a struct");
    }
    var sd: StructDef = original.structs.get(si2);
    var fi: i64 = 0;
    while fi < sd.fields.len() {
        var fld: Param = sd.fields.get(fi);
        if fld.name == fname {
            var names2: Vec<str> = Vec::new();
            var ai2: i64 = 0;
            while ai2 < fld.annotations.len() {
                names2.push(fld.annotations.get(ai2).name);
                ai2 = ai2 + 1;
            }
            return ResultExpr::Ok(ct_str_vec(names2));
        }
        fi = fi + 1;
    }
    return ResultExpr::Err("field_annotations: struct '" + sname + "' has no field '" + fname + "'");
}

/// §4.11: embed("path") reads a file of the project while compiling, its
/// bytes a comptime Vec<i64> — the one file read comptime code may do. The
/// path is relative to the directory fid runs in (the project root), never
/// absolute and never leaving it (`..` is an error).
fn ct_embed_call(a: Vec<Expr>) -> ResultExpr {
    if a.len() != 1 {
        return ResultExpr::Err("embed takes one argument, the file's path relative to the project (a str)");
    }
    var path: str = "";
    match a.get(0) {
        Expr::StringLit(pth) => {
            path = pth;
        }
        _ => {
            return ResultExpr::Err("embed takes the file's path as a string");
        }
    }
    if str_len(path) == 0 {
        return ResultExpr::Err("embed: the path is empty");
    }
    if str_starts_with(path, "/") || str_starts_with(path, "\\") || str_len(path) > 1 && str_byte_at(path, 1) == 58 {
        return ResultExpr::Err("embed: '" + path + "' is absolute: the path is relative to the project root");
    }
    if str_contains(path, "..") {
        return ResultExpr::Err("embed: '" + path + "' leaves the project: no `..` in the path");
    }
    var bytes: Vec<i64> = p_file_read_bytes(path);
    if bytes.len() == 0 {
        return ResultExpr::Err("embed: cannot read '" + path + "' from the project root (missing or empty)");
    }
    var els: Vec<Expr> = Vec::new();
    var bi: i64 = 0;
    while bi < bytes.len() {
        els.push(Expr::IntLit(bytes.get(bi)));
        bi = bi + 1;
    }
    return ResultExpr::Ok(ct_vec_of(Type::I64, els));
}

/// `gensym(prefix)` with its argument already evaluated.
fn ct_gensym_call(args: Vec<Expr>, original: &Program) -> ResultExpr {
    if args.len() != 1 {
        return ResultExpr::Err("gensym takes one string argument, the prefix of the name");
    }
    match args.get(0) {
        Expr::StringLit(p) => {
            return ResultExpr::Ok(Expr::StringLit(ct_gensym(p, original)));
        }
        _ => {
        }
    }
    return ResultExpr::Err("gensym takes one string argument, the prefix of the name");
}

// --- Comptime parsers (OP28) -----------------------------------------------
// A comptime fn that parses constant text calls core's string functions and
// helper functions of its own. The pure string functions run here as the
// compiler's own copy of core's (the same code the program links, so the
// value is the one the program would compute), and a plain function whose
// parameters and result are scalars, strings or Vecs of them is run by the
// evaluator like a comptime fn. Anything else it reaches (I/O, a global,
// a struct) is an evaluation error, and the comptime is left to run when the
// program does, as before.

/// Core's pure string functions the evaluator runs itself.
fn ct_pure_builtin(name: str) -> bool {
    if name == "str_len" || name == "str_byte_at" || name == "str_slice" || name == "str_is_empty" || name == "str_concat" || name == "str_equal" || name == "str_compare" || name == "int_to_str" || name == "char_to_str" || name == "byte_to_str" || name == "str_parse_int" || name == "str_parse_int_range" {
        return true;
    }
    if name == "str_starts_with" || name == "str_ends_with" || name == "str_contains" || name == "str_find" || name == "str_rfind" || name == "str_trim" || name == "str_trim_start" || name == "str_trim_end" || name == "str_to_upper" || name == "str_to_lower" || name == "str_replace" || name == "str_repeat" || name == "str_clone" {
        return true;
    }
    return name == "str_split" || name == "str_split_char" || name == "str_lines" || name == "str_bytes" || name == "str_from_bytes" || name == "char_is_digit" || name == "char_is_alpha";
}

fn ct_is_str(e: Expr) -> bool {
    match e {
        Expr::StringLit(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

fn ct_is_int(e: Expr) -> bool {
    match e {
        Expr::IntLit(_) => {
            return true;
        }
        _ => {
        }
    }
    match ct_untag_type(e) {
        OptType::Some(_) => {
            return true;
        }
        OptType::None => {
        }
    }
    return false;
}

fn ct_str(e: Expr) -> str {
    match e {
        Expr::StringLit(s) => {
            return s;
        }
        _ => {
        }
    }
    return "";
}

fn ct_int(e: Expr) -> i64 {
    match e {
        Expr::IntLit(n) => {
            return n;
        }
        _ => {
        }
    }
    return 0;
}

/// `ct_int` through an unsigned tag: the bits the tagged value holds.
fn ct_int_untag(e: Expr) -> i64 {
    match ct_untag_type(e) {
        OptType::Some(_) => {
            return ct_int(ct_untag(e));
        }
        OptType::None => {
        }
    }
    return ct_int(e);
}

// --- Typed comptime values (BG62) ------------------------------------------
// An unsigned value a comptime declaration gives a name to is held as
// `Expr::Cast(IntLit(bits), <unsigned type>)`: the untyped evaluator keeps
// the declared type in the value, so `m >> 1`, `m / 3`, `m > 0` on
// `val m: u64 = MAX` evaluate unsigned, the way every backend runs them.

/// Whether `t` is an unsigned integer type a comptime value can be tagged
/// with (u128's value is the low 64 bits — all a comptime IntLit holds).
fn ct_unsigned_ty(t: Type) -> bool {
    match t {
        Type::U8 => {
            return true;
        }
        Type::U16 => {
            return true;
        }
        Type::U32 => {
            return true;
        }
        Type::U64 => {
            return true;
        }
        Type::U128 => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Whether `t` is a signed integer type (`x as iN` sign-extends).
fn ct_signed_ty(t: Type) -> bool {
    match t {
        Type::I8 => {
            return true;
        }
        Type::I16 => {
            return true;
        }
        Type::I32 => {
            return true;
        }
        Type::I64 => {
            return true;
        }
        Type::I128 => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Whether `t` is a float type (`x as f32` / `x as f64`).
fn ct_float_ty(t: Type) -> bool {
    match t {
        Type::F32 => {
            return true;
        }
        Type::F64 => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// The bit width `t` stores in a comptime IntLit (wider types store their
/// low 64).
fn ct_int_width(t: Type) -> i64 {
    match t {
        Type::U8 => {
            return 8;
        }
        Type::I8 => {
            return 8;
        }
        Type::U16 => {
            return 16;
        }
        Type::I16 => {
            return 16;
        }
        Type::U32 => {
            return 32;
        }
        Type::I32 => {
            return 32;
        }
        _ => {
        }
    }
    return 64;
}

/// The value mask of width `w` (64's is -1: all bits set).
fn ct_width_mask(w: i64) -> i64 {
    if w >= 64 {
        return -1;
    }
    return (1 << w) - 1;
}

/// `e`'s unsigned type when `e` is a tagged unsigned literal.
fn ct_untag_type(e: Expr) -> OptType {
    match e {
        Expr::Cast(ib, ty) => {
            if ct_unsigned_ty(ty) {
                match ct_box_expr_unbox(ib) {
                    Expr::IntLit(_) => {
                        return OptType::Some(ty);
                    }
                    _ => {
                    }
                }
            }
        }
        _ => {
        }
    }
    return OptType::None;
}

/// `e` with a value tag removed: the IntLit a tagged unsigned value wraps,
/// `e` itself otherwise.
fn ct_untag(e: Expr) -> Expr {
    match e {
        Expr::Cast(ib, ty) => {
            if ct_unsigned_ty(ty) {
                var inner: Expr = ct_box_expr_unbox(ib);
                match inner {
                    Expr::IntLit(_) => {
                        return inner;
                    }
                    _ => {
                    }
                }
            }
        }
        _ => {
        }
    }
    return e;
}

/// `v` tagged with unsigned type `ty` (masked to its width). A FloatLit,
/// StringLit or a cast it cannot read is returned unchanged.
fn ct_tag(v: Expr, ty: Type) -> Expr {
    var bits: i64 = 0;
    var have: bool = false;
    match v {
        Expr::IntLit(n) => {
            bits = n;
            have = true;
        }
        _ => {
        }
    }
    match ct_untag_type(v) {
        OptType::Some(_) => {
            bits = ct_int(ct_untag(v));
            have = true;
        }
        OptType::None => {
        }
    }
    if !have {
        return v;
    }
    var w: i64 = ct_int_width(ty);
    return Expr::Cast(Box::new(Expr::IntLit(bits & ct_width_mask(w))), ty);
}

/// `bits` narrowed to signed width `w` and sign-extended back to i64.
fn ct_sext(bits: i64, w: i64) -> i64 {
    if w >= 64 {
        return bits;
    }
    var m: i64 = bits & ct_width_mask(w);
    if (m & (1 << (w - 1))) != 0 {
        m = m - (1 << w);
    }
    return m;
}

/// Whether `a` are literals of the kinds `sig` spells: `s` a string, `i` an
/// integer, `v` a comptime Vec of integers.
fn ct_sig(a: Vec<Expr>, sig: str) -> bool {
    var n: i64 = str_len(sig);
    if a.len() != n {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        val k: i64 = str_byte_at(sig, i);
        val e: Expr = a.get(i);
        if k == 115 && !ct_is_str(e) {
            return false;
        }
        if k == 105 && !ct_is_int(e) {
            return false;
        }
        if k == 118 {
            var tmp: Vec<Expr> = Vec::new();
            if !ct_vec_elems(e, &mut tmp) {
                return false;
            }
            var j: i64 = 0;
            while j < tmp.len() {
                if !ct_is_int(tmp.get(j)) {
                    return false;
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return true;
}

fn ct_str_vec(items: Vec<str>) -> Expr {
    var els: Vec<Expr> = Vec::new();
    var i: i64 = 0;
    while i < items.len() {
        els.push(Expr::StringLit(items.get(i)));
        i = i + 1;
    }
    return ct_vec_of(Type::Str, els);
}

/// Pure builtin `name` on evaluated arguments `a`.
fn ct_pure_call(name: str, a: Vec<Expr>) -> ResultExpr {
    val bad: ResultExpr = ResultExpr::Err("comptime: '" + name + "()' takes other arguments than these literals");
    if name == "str_len" {
        if ct_sig(a, "s") {
            return ResultExpr::Ok(Expr::IntLit(str_len(ct_str(a.get(0)))));
        }
        return bad;
    }
    if name == "str_is_empty" {
        if ct_sig(a, "s") {
            return ResultExpr::Ok(Expr::BoolLit(str_is_empty(ct_str(a.get(0)))));
        }
        return bad;
    }
    if name == "str_byte_at" {
        if ct_sig(a, "si") {
            return ResultExpr::Ok(Expr::IntLit(str_byte_at(ct_str(a.get(0)), ct_int(a.get(1)))));
        }
        return bad;
    }
    if name == "str_slice" {
        if ct_sig(a, "sii") {
            return ResultExpr::Ok(Expr::StringLit(str_slice(ct_str(a.get(0)), ct_int(a.get(1)), ct_int(a.get(2)))));
        }
        return bad;
    }
    if name == "str_concat" {
        if ct_sig(a, "ss") {
            return ResultExpr::Ok(Expr::StringLit(ct_str(a.get(0)) + ct_str(a.get(1))));
        }
        return bad;
    }
    if name == "str_equal" {
        if ct_sig(a, "ss") {
            return ResultExpr::Ok(Expr::BoolLit(str_equal(ct_str(a.get(0)), ct_str(a.get(1)))));
        }
        return bad;
    }
    if name == "str_compare" {
        if ct_sig(a, "ss") {
            return ResultExpr::Ok(Expr::IntLit(str_compare(ct_str(a.get(0)), ct_str(a.get(1)))));
        }
        return bad;
    }
    if name == "int_to_str" {
        if ct_sig(a, "i") {
            return ResultExpr::Ok(Expr::StringLit(int_to_str(ct_int(a.get(0)))));
        }
        return bad;
    }
    if name == "char_to_str" || name == "byte_to_str" {
        if ct_sig(a, "i") {
            return ResultExpr::Ok(Expr::StringLit(byte_to_str(ct_int(a.get(0)))));
        }
        return bad;
    }
    if name == "char_is_digit" {
        if ct_sig(a, "i") {
            return ResultExpr::Ok(Expr::BoolLit(char_is_digit(ct_int(a.get(0)))));
        }
        return bad;
    }
    if name == "char_is_alpha" {
        if ct_sig(a, "i") {
            return ResultExpr::Ok(Expr::BoolLit(char_is_alpha(ct_int(a.get(0)))));
        }
        return bad;
    }
    if name == "str_parse_int" {
        if ct_sig(a, "s") {
            return ResultExpr::Ok(Expr::IntLit(str_parse_int(ct_str(a.get(0)))));
        }
        return bad;
    }
    if name == "str_parse_int_range" {
        if ct_sig(a, "sii") {
            return ResultExpr::Ok(Expr::IntLit(str_parse_int_range(ct_str(a.get(0)), ct_int(a.get(1)), ct_int(a.get(2)))));
        }
        return bad;
    }
    if name == "str_starts_with" {
        if ct_sig(a, "ss") {
            return ResultExpr::Ok(Expr::BoolLit(str_starts_with(ct_str(a.get(0)), ct_str(a.get(1)))));
        }
        return bad;
    }
    if name == "str_ends_with" {
        if ct_sig(a, "ss") {
            return ResultExpr::Ok(Expr::BoolLit(str_ends_with(ct_str(a.get(0)), ct_str(a.get(1)))));
        }
        return bad;
    }
    if name == "str_contains" {
        if ct_sig(a, "ss") {
            return ResultExpr::Ok(Expr::BoolLit(str_contains(ct_str(a.get(0)), ct_str(a.get(1)))));
        }
        return bad;
    }
    if name == "str_find" {
        if ct_sig(a, "ss") {
            return ResultExpr::Ok(Expr::IntLit(str_find(ct_str(a.get(0)), ct_str(a.get(1)))));
        }
        return bad;
    }
    if name == "str_rfind" {
        if ct_sig(a, "ss") {
            return ResultExpr::Ok(Expr::IntLit(str_rfind(ct_str(a.get(0)), ct_str(a.get(1)))));
        }
        return bad;
    }
    if name == "str_trim" {
        if ct_sig(a, "s") {
            return ResultExpr::Ok(Expr::StringLit(str_trim(ct_str(a.get(0)))));
        }
        return bad;
    }
    if name == "str_trim_start" {
        if ct_sig(a, "s") {
            return ResultExpr::Ok(Expr::StringLit(str_trim_start(ct_str(a.get(0)))));
        }
        return bad;
    }
    if name == "str_trim_end" {
        if ct_sig(a, "s") {
            return ResultExpr::Ok(Expr::StringLit(str_trim_end(ct_str(a.get(0)))));
        }
        return bad;
    }
    if name == "str_to_upper" {
        if ct_sig(a, "s") {
            return ResultExpr::Ok(Expr::StringLit(str_to_upper(ct_str(a.get(0)))));
        }
        return bad;
    }
    if name == "str_to_lower" {
        if ct_sig(a, "s") {
            return ResultExpr::Ok(Expr::StringLit(str_to_lower(ct_str(a.get(0)))));
        }
        return bad;
    }
    if name == "str_clone" {
        if ct_sig(a, "s") {
            return ResultExpr::Ok(Expr::StringLit(ct_str(a.get(0))));
        }
        return bad;
    }
    if name == "str_replace" {
        if ct_sig(a, "sss") {
            return ResultExpr::Ok(Expr::StringLit(str_replace(ct_str(a.get(0)), ct_str(a.get(1)), ct_str(a.get(2)))));
        }
        return bad;
    }
    if name == "str_repeat" {
        if ct_sig(a, "si") {
            // A repeat that builds a huge string at compile time is bounded
            // (16 MB), as a loop is by fuel: the compiler must not die of a
            // comptime string.
            var rep_n: i64 = ct_int(a.get(1));
            var rep_len: i64 = str_len(ct_str(a.get(0)));
            if rep_n < 0 || (rep_len > 0 && rep_n > 16777216 / rep_len) {
                return ResultExpr::Err("comptime str_repeat: " + int_to_str(rep_n) + " x " + int_to_str(rep_len) + " bytes is more than the 16 MB comptime strings allow");
            }
            return ResultExpr::Ok(Expr::StringLit(str_repeat(ct_str(a.get(0)), rep_n)));
        }
        return bad;
    }
    if name == "str_split" {
        if ct_sig(a, "ss") {
            return ResultExpr::Ok(ct_str_vec(str_split(ct_str(a.get(0)), ct_str(a.get(1)))));
        }
        return bad;
    }
    if name == "str_split_char" {
        if ct_sig(a, "si") {
            return ResultExpr::Ok(ct_str_vec(str_split_char(ct_str(a.get(0)), ct_int(a.get(1)))));
        }
        return bad;
    }
    if name == "str_lines" {
        if ct_sig(a, "s") {
            return ResultExpr::Ok(ct_str_vec(str_lines(ct_str(a.get(0)))));
        }
        return bad;
    }
    if name == "str_bytes" {
        if ct_sig(a, "s") {
            val bs: Vec<i64> = str_bytes(ct_str(a.get(0)));
            var els: Vec<Expr> = Vec::new();
            var bi: i64 = 0;
            while bi < bs.len() {
                els.push(Expr::IntLit(bs.get(bi)));
                bi = bi + 1;
            }
            return ResultExpr::Ok(ct_vec_of(Type::I64, els));
        }
        return bad;
    }
    if name == "str_from_bytes" {
        if ct_sig(a, "v") {
            var bels: Vec<Expr> = Vec::new();
            if !ct_vec_elems(a.get(0), &mut bels) {
                return bad;
            }
            var bv: Vec<i64> = Vec::new();
            var fi: i64 = 0;
            while fi < bels.len() {
                bv.push(ct_int(bels.get(fi)));
                fi = fi + 1;
            }
            return ResultExpr::Ok(Expr::StringLit(str_from_bytes(bv)));
        }
        return bad;
    }
    return ResultExpr::Err("comptime: '" + name + "()' is not evaluated at compile time");
}

/// Whether values of type `t` are what the evaluator holds as literals.
fn ct_plain_type(t: Type) -> bool {
    match t {
        Type::I64 => {
            return true;
        }
        Type::Bool => {
            return true;
        }
        Type::Str => {
            return true;
        }
        Type::Void => {
            return true;
        }
        Type::Generic(gn, gargs) => {
            if gn == "Vec" && gargs.len() == 1 {
                match gargs.get(0) {
                    Type::I64 => {
                        return true;
                    }
                    Type::Bool => {
                        return true;
                    }
                    Type::Str => {
                        return true;
                    }
                    _ => {
                    }
                }
            }
        }
        _ => {
        }
    }
    return false;
}

/// Index in `original.funcs` of plain function `name` the evaluator may run
/// at compile time (OP28): not generic, not async, with a body, scalar,
/// string or Vec parameters and result. -1 when there is none.
fn ct_plain_fn(original: &Program, name: str) -> i64 {
    var i: i64 = 0;
    while i < original.funcs.len() {
        val f: Func = original.funcs.get(i);
        if f.name == name && !f.is_comptime {
            if f.type_params.len() > 0 || f.const_params.len() > 0 || f.is_async || f.body.len() == 0 {
                return -1;
            }
            if !ct_plain_type(f.ret_ty) {
                return -1;
            }
            var pi: i64 = 0;
            while pi < f.params.len() {
                if !ct_plain_type(f.params.get(pi).ty) || f.params.get(pi).is_variadic {
                    return -1;
                }
                pi = pi + 1;
            }
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Nesting of comptime calls: a function that recurses without end is an
// evaluation error, not a stack overflow of the compiler.
var g_ct_call_depth: i64 = 0;

fn parse_generated_code(source: str) -> OptProgram {
    var lex: Lexer = Lexer::new(source);
    var tokens: Vec<Token> = lex.tokenize();
    var parser_obj: Parser = Parser_new(tokens);
    var result: ParseResultProgram = parser_obj.parse();
    match result {
        ParseResultProgram::Ok(prog) => {
            return OptProgram::Some(prog);
        }
        ParseResultProgram::Err(_) => {
            return OptProgram::None;
        }
    }
    return OptProgram::None;
}

// --- substitute ----------------------------------------------------------
// Recursively substitute every comptime expression in the program with an
// AST literal carrying its compile-time value.

pub fn substitute(program: Program) -> Program {
    var prog: Program = program;
    var errs: Vec<str> = Vec::new();
    // Safety pass state: a fresh fuel budget, a fresh fatal-error list, and
    // the fallback kill switch (FID_CT_FALLBACK=1: warn and run at runtime,
    // as before the hardening).
    g_ct_steps = 0;
    g_ct_subst_errors = Vec::new();
    g_ct_memo_keys = Vec::new();
    g_ct_memo_vals = Vec::new();
    g_ct_call_stack = Vec::new();
    g_ct_line = 0;
    g_ct_subst_line = 0;
    var fb_env: str = p_getenv("FID_CT_FALLBACK");
    g_ct_fallback = str_len(fb_env) > 0 && (fb_env as i64) != 0;
    // Compile time (CS4): a function with no node a phase rewrites is left
    // as it is, not rebuilt 13 times. A function without comptime nodes gets
    // none from substitution, and one without phase 3's patterns (an `if`
    // on a bool literal, a `for` over a literal range, a call to a comptime
    // fn) gets none from phase 3, so the result is the same; the scans visit
    // the variants the phases visit. FID_CT_FULL=1: every function, as before.
    var ct_full_env: str = p_getenv("FID_CT_FULL");
    var full: bool = (ct_full_env as i64) != 0 && str_len(ct_full_env) > 0;
    var need: Vec<bool> = Vec::new();
    var ni: i64 = 0;
    while ni < prog.funcs.len() {
        // A generic function is a template: its comptime nodes (the
        // reflection its `comptime T: type` parameters drive) are evaluated
        // per instantiation, on the second substitute pass after mono (§4.11)
        need.push(prog.funcs.get(ni).type_params.len() == 0 && (full || ct_scan_stmts_sub(prog.funcs.get(ni).body)));
        ni = ni + 1;
    }

    // Phase 1: Pre-substitute comptime expressions inside comptime function bodies
    var iter: i64 = 0;
    while iter < 8 {
        var fi: i64 = 0;
        while fi < prog.funcs.len() {
            if need.get(fi) {
                substitute_func(&mut prog.funcs, fi, &prog, &mut errs);
            }
            fi = fi + 1;
        }
        iter = iter + 1;
    }

    // Phase 2: Substitute comptime expressions everywhere (an explicit one
    // that fails in an ordinary function is reported)
    var fi2: i64 = 0;
    while fi2 < prog.funcs.len() {
        if need.get(fi2) {
            g_ct_warn_on = !prog.funcs.get(fi2).is_comptime;
            substitute_func(&mut prog.funcs, fi2, &prog, &mut errs);
            g_ct_warn_on = false;
        }
        fi2 = fi2 + 1;
    }
    // A constant's initializer: `const TABLE: Vec<i64> = comptime make()`
    // (it was left a run-time call)
    var ci: i64 = 0;
    while ci < prog.consts.len() {
        var cd: ConstDef = prog.consts.get(ci);
        if ct_scan_expr_sub(cd.expr) {
            g_ct_warn_on = true;
            substitute_expr(&mut cd.expr, &prog, &mut errs);
            g_ct_warn_on = false;
            ct_check_int_fit(cd.ty, &cd.expr, cd.name, &mut errs);
            prog.consts.set(ci, cd);
        }
        ci = ci + 1;
    }

    // Phase 3: Aggressive comptime evuation -- auto-evaluate calls to
    // comptime fn functions when ALL arguments are literals (a generic
    // comptime fn is left: its type parameters are not known until mono)
    ct_comptime_fns = HashMap_new();
    var cf: i64 = 0;
    while cf < prog.funcs.len() {
        if prog.funcs.get(cf).is_comptime && prog.funcs.get(cf).type_params.len() == 0 {
            HashMap_insert(ct_comptime_fns, prog.funcs.get(cf).name, 1);
        }
        cf = cf + 1;
    }
    var need3: Vec<bool> = Vec::new();
    var nj: i64 = 0;
    while nj < prog.funcs.len() {
        need3.push(full || ct_scan_stmts_aggr(prog.funcs.get(nj).body));
        nj = nj + 1;
    }
    var iter2: i64 = 0;
    while iter2 < 4 {
        var fi3: i64 = 0;
        while fi3 < prog.funcs.len() {
            if need3.get(fi3) {
                aggressive_comptime_func(&mut prog.funcs, fi3, &prog);
            }
            fi3 = fi3 + 1;
        }
        iter2 = iter2 + 1;
    }

    return prog;
}

// --- Which functions a phase can change (read-only scans) -----------------
// Each visits at least the variants its phase visits, so `false` means the
// phase leaves the function as it is.

/// Phases 1-2: a comptime expression or a ComptimeGen statement.
fn ct_scan_stmts_sub(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        if ct_scan_stmt_sub(stmts.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn ct_scan_opt_sub(o: OptStmts) -> bool {
    match o {
        OptStmts::Some(b) => {
            return ct_scan_stmts_sub(b);
        }
        OptStmts::None => {
        }
    }
    return false;
}

fn ct_scan_arms_sub(arms: Vec<MatchArm>) -> bool {
    var i: i64 = 0;
    while i < arms.len() {
        if ct_scan_stmts_sub(arms.get(i).body) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn ct_scan_stmt_sub(stmt: Stmt) -> bool {
    match stmt {
        Stmt::Let(_, _, e, _, _, _, _) => {
            return ct_scan_expr_sub(e);
        }
        Stmt::LetTuple(_, e, _) => {
            return ct_scan_expr_sub(e);
        }
        Stmt::Assign(_, _, e, _) => {
            return ct_scan_expr_sub(e);
        }
        Stmt::IndexAssign(_, ix, _, e, _) => {
            return ct_scan_expr_sub(ix) || ct_scan_expr_sub(e);
        }
        Stmt::DerefAssign(pe, _, e, _) => {
            return ct_scan_expr_sub(pe) || ct_scan_expr_sub(e);
        }
        Stmt::FieldAssign(ob, _, _, e, _) => {
            return ct_scan_expr_sub(ob) || ct_scan_expr_sub(e);
        }
        Stmt::Expr(e, _) => {
            return ct_scan_expr_sub(e);
        }
        Stmt::Return(opt, _) => {
            match opt {
                OptBoxExpr::Some(b) => {
                    return ct_scan_expr_sub(ct_box_expr_unbox(b));
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(c, t, e, _) => {
            return ct_scan_expr_sub(c) || ct_scan_stmts_sub(t) || ct_scan_opt_sub(e);
        }
        Stmt::While(c, b, _) => {
            return ct_scan_expr_sub(c) || ct_scan_stmts_sub(b);
        }
        Stmt::For(_, it, b, _) => {
            return ct_scan_expr_sub(it) || ct_scan_stmts_sub(b);
        }
        Stmt::Match(e, arms, _) => {
            return ct_scan_expr_sub(e) || ct_scan_arms_sub(arms);
        }
        Stmt::Defer(b, _) => {
            return ct_scan_stmts_sub(b);
        }
        Stmt::Txn(b, _) => {
            return ct_scan_stmts_sub(b);
        }
        Stmt::RegionBlock(_, _, _, _, _, b, _) => {
            return ct_scan_stmts_sub(b);
        }
        Stmt::Sandbox(b, _) => {
            return ct_scan_stmts_sub(b);
        }
        Stmt::Unsafe(b, _) => {
            return ct_scan_stmts_sub(b);
        }
        Stmt::ComptimeGen(_, _) => {
            return true;
        }
        Stmt::Handle(b, hs, _) => {
            if ct_scan_stmts_sub(b) {
                return true;
            }
            var hi: i64 = 0;
            while hi < hs.len() {
                if ct_scan_stmts_sub(hs.get(hi).body) {
                    return true;
                }
                hi = hi + 1;
            }
        }
        Stmt::Query(_, b, _) => {
            return ct_scan_stmts_sub(b);
        }
        Stmt::Parallel(brs, _) => {
            var bi: i64 = 0;
            while bi < brs.len() {
                if ct_scan_stmts_sub(brs.get(bi)) {
                    return true;
                }
                bi = bi + 1;
            }
        }
        Stmt::Backward(l, _) => {
            return ct_scan_expr_sub(l);
        }
        Stmt::Resume(c, v, _) => {
            return ct_scan_expr_sub(c) || ct_scan_expr_sub(v);
        }
        Stmt::SpawnScope(b, _) => {
            return ct_scan_stmts_sub(b);
        }
        _ => {
        }
    }
    return false;
}

fn ct_scan_exprs_sub(es: Vec<Expr>) -> bool {
    var i: i64 = 0;
    while i < es.len() {
        if ct_scan_expr_sub(es.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn ct_scan_expr_sub(expr: Expr) -> bool {
    match expr {
        Expr::Binary(_, l, r) => {
            return ct_scan_expr_sub(ct_box_expr_unbox(l)) || ct_scan_expr_sub(ct_box_expr_unbox(r));
        }
        Expr::Unary(_, e) => {
            return ct_scan_expr_sub(ct_box_expr_unbox(e));
        }
        Expr::Call(_, args) => {
            return ct_scan_exprs_sub(args);
        }
        Expr::MethodCall(r, _, args) => {
            return ct_scan_expr_sub(ct_box_expr_unbox(r)) || ct_scan_exprs_sub(args);
        }
        Expr::FieldAccess(e, _) => {
            return ct_scan_expr_sub(ct_box_expr_unbox(e));
        }
        Expr::StructLit(_, fields, _) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                if ct_scan_expr_sub(fields.get(fi).value) {
                    return true;
                }
                fi = fi + 1;
            }
        }
        Expr::If(c, t, e) => {
            return ct_scan_expr_sub(c) || ct_scan_stmts_sub(t) || ct_scan_opt_sub(e);
        }
        Expr::Block(b) => {
            return ct_scan_stmts_sub(b);
        }
        Expr::Index(a, i) => {
            return ct_scan_expr_sub(ct_box_expr_unbox(a)) || ct_scan_expr_sub(ct_box_expr_unbox(i));
        }
        Expr::ArrayLit(_, els) => {
            return ct_scan_exprs_sub(els);
        }
        Expr::Match(e, arms) => {
            return ct_scan_expr_sub(e) || ct_scan_arms_sub(arms);
        }
        Expr::Range(a, b, _) => {
            return ct_scan_expr_sub(ct_box_expr_unbox(a)) || ct_scan_expr_sub(ct_box_expr_unbox(b));
        }
        Expr::Ref(e, _) => {
            return ct_scan_expr_sub(ct_box_expr_unbox(e));
        }
        Expr::Deref(e) => {
            return ct_scan_expr_sub(ct_box_expr_unbox(e));
        }
        Expr::StrConcat(l, r) => {
            return ct_scan_expr_sub(ct_box_expr_unbox(l)) || ct_scan_expr_sub(ct_box_expr_unbox(r));
        }
        Expr::Cast(e, _) => {
            return ct_scan_expr_sub(ct_box_expr_unbox(e));
        }
        Expr::Comptime(_) => {
            return true;
        }
        Expr::ComptimeBlock(_) => {
            return true;
        }
        Expr::ComptimeReflect(_, _) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Phase 3: an `if` on a bool literal, a `for` over a literal range, or a
/// call to a comptime fn (ct_comptime_fns), where phase 3 looks.
fn ct_scan_stmts_aggr(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        if ct_scan_stmt_aggr(stmts.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn ct_scan_stmt_aggr(stmt: Stmt) -> bool {
    match stmt {
        Stmt::Let(_, _, e, _, _, _, _) => {
            return ct_scan_expr_aggr(e);
        }
        Stmt::Assign(_, _, e, _) => {
            return ct_scan_expr_aggr(e);
        }
        Stmt::Expr(e, _) => {
            return ct_scan_expr_aggr(e);
        }
        Stmt::Return(opt, _) => {
            match opt {
                OptBoxExpr::Some(b) => {
                    return ct_scan_expr_aggr(ct_box_expr_unbox(b));
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(c, t, e, _) => {
            match c {
                Expr::BoolLit(_) => {
                    return true;
                }
                _ => {
                }
            }
            if ct_scan_expr_aggr(c) || ct_scan_stmts_aggr(t) {
                return true;
            }
            match e {
                OptStmts::Some(eb) => {
                    return ct_scan_stmts_aggr(eb);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::For(_, it, b, _) => {
            match it {
                Expr::Range(a, z, _) => {
                    var a2: Expr = ct_box_expr_unbox(a);
                    var z2: Expr = ct_box_expr_unbox(z);
                    var lit_a: bool = false;
                    var lit_z: bool = false;
                    match a2 {
                        Expr::IntLit(_) => {
                            lit_a = true;
                        }
                        _ => {
                        }
                    }
                    match z2 {
                        Expr::IntLit(_) => {
                            lit_z = true;
                        }
                        _ => {
                        }
                    }
                    if lit_a && lit_z {
                        return true;
                    }
                }
                _ => {
                }
            }
            return ct_scan_expr_aggr(it) || ct_scan_stmts_aggr(b);
        }
        Stmt::While(c, b, _) => {
            return ct_scan_expr_aggr(c) || ct_scan_stmts_aggr(b);
        }
        _ => {
        }
    }
    return false;
}

fn ct_scan_expr_aggr(expr: Expr) -> bool {
    match expr {
        Expr::Binary(_, l, r) => {
            return ct_scan_expr_aggr(ct_box_expr_unbox(l)) || ct_scan_expr_aggr(ct_box_expr_unbox(r));
        }
        Expr::Unary(_, e) => {
            return ct_scan_expr_aggr(ct_box_expr_unbox(e));
        }
        Expr::Call(callee, args) => {
            if HashMap_get(ct_comptime_fns, callee) != 0 {
                return true;
            }
            var ai: i64 = 0;
            while ai < args.len() {
                if ct_scan_expr_aggr(args.get(ai)) {
                    return true;
                }
                ai = ai + 1;
            }
        }
        Expr::MethodCall(r, _, args) => {
            if ct_scan_expr_aggr(ct_box_expr_unbox(r)) {
                return true;
            }
            var mi: i64 = 0;
            while mi < args.len() {
                if ct_scan_expr_aggr(args.get(mi)) {
                    return true;
                }
                mi = mi + 1;
            }
        }
        _ => {
        }
    }
    return false;
}

fn substitute_func(funcs: &mut Vec<Func>, idx: i64, original: &Program, errs: &mut Vec<str>) {
    var func: Func = funcs.get(idx);
    var si: i64 = 0;
    while si < func.body.len() {
        var stmt: Stmt = func.body.get(si);
        substitute_stmt(&mut stmt, original, errs);
        func.body.set(si, stmt);
        si = si + 1;
    }
    funcs.set(idx, func);
}

fn substitute_stmts(stmts: &mut Vec<Stmt>, original: &Program, errs: &mut Vec<str>) {
    var si: i64 = 0;
    while si < stmts.len() {
        var stmt: Stmt = stmts.get(si);
        substitute_stmt(&mut stmt, original, errs);
        stmts.set(si, stmt);
        si = si + 1;
    }
}

fn substitute_stmt(stmt: &mut Stmt, original: &Program, errs: &mut Vec<str>) {
    // Where this statement sits, for the error of a comptime it holds
    g_ct_subst_line = ct_stmt_line(*stmt);
    // A match binding is a copy of the payload: substitute into the copy,
    // then rebuild the statement so the result is kept.
    match stmt {
        Stmt::Let(lname, lty, expr, lmut, lpersist, lann, lline) => {
            // Only a value comptime computed is checked here (BG47): a plain
            // literal is the type checker's (E079), and a u64 literal above
            // i64::MAX is held as its raw bits, which read negative
            val ct_had: bool = ct_scan_expr_sub(expr);
            substitute_expr(&mut expr, original, errs);
            // §4.11: the value comptime computed must fit the declared type
            if ct_had {
                match lty {
                    OptType::Some(ct_fit_ty) => {
                        ct_check_int_fit(ct_fit_ty, &expr, lname, errs);
                    }
                    OptType::None => {
                    }
                }
            }
            * stmt = Stmt::Let(lname, lty, expr, lmut, lpersist, lann, lline);
        }
        Stmt::LetTuple(tnames, expr, tline) => {
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::LetTuple(tnames, expr, tline);
        }
        Stmt::Assign(aname, aop, expr, aline) => {
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::Assign(aname, aop, expr, aline);
        }
        Stmt::IndexAssign(iname, index, iop, expr, iline) => {
            substitute_expr(&mut index, original, errs);
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::IndexAssign(iname, index, iop, expr, iline);
        }
        Stmt::DerefAssign(ptr_expr, dop, expr, dline) => {
            substitute_expr(&mut ptr_expr, original, errs);
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::DerefAssign(ptr_expr, dop, expr, dline);
        }
        Stmt::FieldAssign(object, ffield, fop, expr, fline) => {
            substitute_expr(&mut object, original, errs);
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::FieldAssign(object, ffield, fop, expr, fline);
        }
        Stmt::Expr(e, eline) => {
            // Statement `comptime if`: select the branch here (the expand
            // pass does it before type checking for non-generic functions;
            // a generic function's turn comes now, its type parameters
            // instantiated by mono). The taken branch's statements run in
            // a block: names it declares end with it.
            var ctif_handled: bool = false;
            match e {
                Expr::Comptime(ctif_inner) => {
                    match ct_box_expr_unbox(ctif_inner) {
                        Expr::If(ctif_cond, ctif_then, ctif_else) => {
                            var cond2: Expr = ct_box_expr_unbox(ctif_cond);
                            substitute_expr(&mut cond2, original, errs);
                            g_ct_call_stack = Vec::new();
                            g_ct_line = 0;
                            match evaluate(&cond2, original) {
                                ResultExpr::Ok(ctif_v) => {
                                    match ctif_v {
                                        Expr::BoolLit(ctif_b) => {
                                            var taken: Vec<Stmt> = ctif_then;
                                            if !ctif_b {
                                                taken = Vec::new();
                                                match ctif_else {
                                                    OptStmts::Some(eb3) => {
                                                        taken = eb3;
                                                    }
                                                    OptStmts::None => {
                                                    }
                                                }
                                            }
                                            substitute_stmts(&mut taken, original, errs);
                                            *stmt = Stmt::Expr(Expr::Block(taken), eline);
                                            ctif_handled = true;
                                        }
                                        _ => {
                                            var bad_cond: str = "comptime if" + ct_at(g_ct_subst_line) + ": the condition is not known at compile time (a bool the evaluator can compute)";
                                            errs.push(bad_cond);
                                            ct_fatal_push(bad_cond);
                                        }
                                    }
                                }
                                ResultExpr::Err(ctif_m) => {
                                    errs.push("comptime if" + ct_at(g_ct_subst_line) + ": " + ctif_m + ct_trace());
                                    ct_fatal_push("comptime if" + ct_at(g_ct_subst_line) + ": " + ctif_m + ct_trace());
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            if !ctif_handled {
                substitute_expr(&mut e, original, errs);
                *stmt = Stmt::Expr(e, eline);
            }
        }
        Stmt::Return(opt, rline) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    var inner: Expr = ct_box_expr_unbox(e);
                    substitute_expr(&mut inner, original, errs);
                    *stmt = Stmt::Return(OptBoxExpr::Some(box_expr_new(inner)), rline);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, iline2) => {
            substitute_expr(&mut cond, original, errs);
            substitute_stmts(&mut then_block, original, errs);
            match else_block {
                OptStmts::Some(eb) => {
                    substitute_stmts(&mut eb, original, errs);
                }
                OptStmts::None => {
                }
            }
            * stmt = Stmt::If(cond, then_block, else_block, iline2);
        }
        Stmt::While(cond, body, wline) => {
            substitute_expr(&mut cond, original, errs);
            substitute_stmts(&mut body, original, errs);
            *stmt = Stmt::While(cond, body, wline);
        }
        Stmt::For(fvar, iterator, body, forline) => {
            // `inline for` of an instantiated generic body: the iterator
            // arrived wrapped in `comptime` (parser.fd); unroll it here —
            // evaluating the wrapper would swallow the marker
            var ec_inline: bool = false;
            var ec_range: Expr = Expr::IntLit(0);
            match iterator {
                Expr::Comptime(ri) => {
                    ec_inline = true;
                    ec_range = ct_box_expr_unbox(ri);
                }
                _ => {
                }
            }
            if ec_inline {
                var unrolled: Vec<Stmt> = Vec::new();
                ec_unroll_inline(&mut unrolled, fvar, ec_range, body, original, errs, forline);
                substitute_stmts(&mut unrolled, original, errs);
                *stmt = Stmt::Expr(Expr::Block(unrolled), forline);
            } else {
                substitute_expr(&mut iterator, original, errs);
                substitute_stmts(&mut body, original, errs);
                *stmt = Stmt::For(fvar, iterator, body, forline);
            }
        }
        Stmt::Match(expr, arms, mline) => {
            substitute_expr(&mut expr, original, errs);
            *stmt = Stmt::Match(expr, arms, mline);
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                substitute_stmts(&mut arm.body, original, errs);
                arms.set(ai, arm);
                ai = ai + 1;
            }
        }
        Stmt::Defer(body, _) => {
            substitute_stmts(&mut body, original, errs);
        }
        Stmt::Txn(body, _) => {
            substitute_stmts(&mut body, original, errs);
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            substitute_stmts(&mut body, original, errs);
        }
        Stmt::Sandbox(body, _) => {
            substitute_stmts(&mut body, original, errs);
        }
        Stmt::Unsafe(body, _) => {
            substitute_stmts(&mut body, original, errs);
        }
        Stmt::ComptimeGen(block, _) => {
            substitute_stmts(&mut block, original, errs);
        }
        Stmt::Handle(body, handlers, _) => {
            substitute_stmts(&mut body, original, errs);
            var hi: i64 = 0;
            while hi < handlers.len() {
                var h: EffectHandler = handlers.get(hi);
                substitute_stmts(&mut h.body, original, errs);
                handlers.set(hi, h);
                hi = hi + 1;
            }
        }
        Stmt::Query(_, body, _) => {
            substitute_stmts(&mut body, original, errs);
        }
        Stmt::Parallel(branches, _) => {
            var bi: i64 = 0;
            while bi < branches.len() {
                var branch: Vec<Stmt> = branches.get(bi);
                substitute_stmts(&mut branch, original, errs);
                branches.set(bi, branch);
                bi = bi + 1;
            }
        }
        Stmt::Backward(loss, _) => {
            substitute_expr(&mut loss, original, errs);
        }
        Stmt::Resume(cont, value, _) => {
            substitute_expr(&mut cont, original, errs);
            substitute_expr(&mut value, original, errs);
        }
        Stmt::SpawnScope(body, _) => {
            substitute_stmts(&mut body, original, errs);
        }
        Stmt::CancelScope(_) => {
        }
        _ => {
        }
    }
}

fn substitute_expr(expr: &mut Expr, original: &Program, errs: &mut Vec<str>) {
    match expr {
        Expr::Binary(op, left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            substitute_expr(&mut l, original, errs);
            substitute_expr(&mut r, original, errs);
            *expr = Expr::Binary(op, box_expr_new(l), box_expr_new(r));
        }
        Expr::Unary(op, inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::Unary(op, box_expr_new(e));
        }
        Expr::Call(cname, args) => {
            // LG9: `comptime splice { }` (parser.fd parse_comptime_expr)
            if cname == "__comptime_splice" && args.len() == 2 {
                *expr = ct_expand_splice(args, original, errs);
                return;
            }
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                substitute_expr(&mut a, original, errs);
                args.set(ai, a);
                ai = ai + 1;
            }
        }
        Expr::MethodCall(receiver, mname, args) => {
            var r: Expr = ct_box_expr_unbox(receiver);
            substitute_expr(&mut r, original, errs);
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                substitute_expr(&mut a, original, errs);
                args.set(ai, a);
                ai = ai + 1;
            }
            * expr = Expr::MethodCall(box_expr_new(r), mname, args);
        }
        Expr::FieldAccess(inner, field) => {
            var e: Expr = ct_box_expr_unbox(inner);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::FieldAccess(box_expr_new(e), field);
        }
        Expr::StructLit(_, fields, _) => {
            var fi: i64 = 0;
            while fi < fields.len() {
                var f: FieldInit = fields.get(fi);
                substitute_expr(&mut f.value, original, errs);
                fields.set(fi, f);
                fi = fi + 1;
            }
        }
        Expr::If(cond, then_block, else_block) => {
            substitute_expr(&mut cond, original, errs);
            substitute_stmts(&mut then_block, original, errs);
            match else_block {
                OptStmts::Some(eb) => {
                    substitute_stmts(&mut eb, original, errs);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Block(stmts) => {
            substitute_stmts(&mut stmts, original, errs);
        }
        Expr::Index(array, index) => {
            var a: Expr = ct_box_expr_unbox(array);
            var i: Expr = ct_box_expr_unbox(index);
            substitute_expr(&mut a, original, errs);
            substitute_expr(&mut i, original, errs);
            *expr = Expr::Index(box_expr_new(a), box_expr_new(i));
        }
        Expr::ArrayLit(_, elements) => {
            var ei: i64 = 0;
            while ei < elements.len() {
                var e: Expr = elements.get(ei);
                substitute_expr(&mut e, original, errs);
                elements.set(ei, e);
                ei = ei + 1;
            }
        }
        Expr::Match(inner, arms) => {
            substitute_expr(&mut inner, original, errs);
            var ai: i64 = 0;
            while ai < arms.len() {
                var arm: MatchArm = arms.get(ai);
                substitute_stmts(&mut arm.body, original, errs);
                arms.set(ai, arm);
                ai = ai + 1;
            }
        }
        Expr::Range(start, end, inclusive) => {
            var s: Expr = ct_box_expr_unbox(start);
            var e: Expr = ct_box_expr_unbox(end);
            substitute_expr(&mut s, original, errs);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::Range(box_expr_new(s), box_expr_new(e), inclusive);
        }
        Expr::Ref(inner, is_mut) => {
            var e: Expr = ct_box_expr_unbox(inner);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::Ref(box_expr_new(e), is_mut);
        }
        Expr::Deref(inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::Deref(box_expr_new(e));
        }
        Expr::StrConcat(left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            substitute_expr(&mut l, original, errs);
            substitute_expr(&mut r, original, errs);
            *expr = Expr::StrConcat(box_expr_new(l), box_expr_new(r));
        }
        Expr::Cast(inner, ty) => {
            var e: Expr = ct_box_expr_unbox(inner);
            substitute_expr(&mut e, original, errs);
            *expr = Expr::Cast(box_expr_new(e), ty);
        }
        Expr::Comptime(inner) => {
            // LG9: the splice-only walk of process_gen leaves the other
            // comptime forms to substitute (after type checking)
            if !g_ct_splice_only {
                substitute_expr_comptime(expr, inner, original, errs);
            }
        }
        Expr::ComptimeBlock(stmts) => {
            if !g_ct_splice_only {
                substitute_expr_comptime_block(expr, &mut stmts, original, errs);
            }
        }
        Expr::ComptimeReflect(op, ty) => {
            if !g_ct_splice_only {
                substitute_expr_comptime_reflect(expr, op, ty, original, errs);
            }
        }
        _ => {
        }
    }
}

// --- comptime splice (LG9) ---------------------------------------------------
// `comptime splice { block }` is an expression written by compile-time code:
// the block runs in the evaluator and returns source text, and that text,
// parsed as one expression, takes the splice's place before type checking.
// Names the generated expression introduces (a block's locals) come from
// `gensym`, so they cannot capture or shadow the program's; a name the text
// spells out (a variable of the caller) means that variable, as written.

/// process_gen's walk: only splices are expanded (the other comptime forms
/// are substitute's, after type checking).
var g_ct_splice_only: bool = false;

/// How many splices the one being expanded came out of.
var g_ct_splice_depth: i64 = 0;

/// The splice `__comptime_splice(ComptimeBlock(block), line)` (parser.fd
/// parse_comptime_expr) replaced by the expression its block generates.
/// What it gives is expanded too (generated text may hold a splice), to a
/// depth of 16. A splice whose block cannot run at compile time, does not
/// return a string, or returns text that is not one expression is an error:
/// unlike `comptime <expr>`, it has nothing to run when the program does
/// (the splice becomes 0, and process_gen's errors stop the build).
/// The caller stores the result (`* expr = ct_expand_splice(..)`): the new
/// expression is handed over whole, never stored through a reference while
/// the old one's parts are still bound.
/// A splice error: process_gen's walk reports it through its own (fatal)
/// error list; the same expansion on substitute's walk reaches this
/// helper with g_ct_splice_only false, and then the fatal list of
/// substitute carries it too (its own errs are dropped there).
fn ct_fatal_splice(errs: &mut Vec<str>, msg: str) {
    errs.push(msg);
    if !g_ct_splice_only {
        ct_fatal_push(msg + ct_trace());
    }
}

fn ct_expand_splice(args: Vec<Expr>, original: &Program, errs: &mut Vec<str>) -> Expr {
    var line: i64 = 0;
    match args.get(1) {
        Expr::IntLit(n) => {
            line = n;
        }
        _ => {
        }
    }
    var at: str = "comptime splice (line " + int_to_str(line) + "): ";
    var block: Vec<Stmt> = Vec::new();
    match args.get(0) {
        Expr::ComptimeBlock(b) => {
            block = b;
        }
        _ => {
            ct_fatal_splice(errs, at + "a splice is `comptime splice { ... }`, a block that returns the expression's text");
            return Expr::IntLit(0);
        }
    }
    if g_ct_splice_depth >= 16 {
        ct_fatal_splice(errs, at + "splices generate splices more than 16 deep");
        return Expr::IntLit(0);
    }
    var src: str = "";
    match evaluate_block(block, original) {
        ResultExpr::Ok(v) => {
            match v {
                Expr::StringLit(s) => {
                    src = s;
                }
                _ => {
                    ct_fatal_splice(errs, at + "the block must return the source text of an expression, as a string");
                    return Expr::IntLit(0);
                }
            }
        }
        ResultExpr::Err(msg) => {
            ct_fatal_splice(errs, at + msg + ct_trace());
            return Expr::IntLit(0);
        }
    }
    var snames: Vec<str> = Vec::new();
    var si: i64 = 0;
    while si < original.structs.len() {
        snames.push(original.structs.get(si).name);
        si = si + 1;
    }
    var enames: Vec<str> = Vec::new();
    var ei: i64 = 0;
    while ei < original.enums.len() {
        enames.push(original.enums.get(ei).name);
        ei = ei + 1;
    }
    match parse_expression_source(src, line, snames, enames) {
        ParseResultExpr::Ok(e) => {
            var out: Expr = e;
            if ct_scan_expr_sub(out) {
                g_ct_splice_depth = g_ct_splice_depth + 1;
                substitute_expr(&mut out, original, errs);
                g_ct_splice_depth = g_ct_splice_depth - 1;
            }
            return out;
        }
        ParseResultExpr::Err(m) => {
            ct_fatal_splice(errs, at + "the generated text `" + src + "` is not one expression: " + m);
        }
    }
    return Expr::IntLit(0);
}

/// Expands the splices of `f`'s body (process_gen, splice-only walk).
/// A body without comptime nodes (ct_scan_stmts_sub, which sees the splice's
/// block) is left as it is.
fn ct_splice_func(f: &mut Func, original: &Program, errs: &mut Vec<str>) {
    if !ct_scan_stmts_sub(f.body) {
        return;
    }
    var body: Vec<Stmt> = f.body;
    substitute_stmts(&mut body, original, errs);
    f.body = body;
}

/// LG9: every `comptime splice` of the program expanded in place: the
/// functions, the methods of impl blocks and trait impls, and constants'
/// initializers. Run by process_gen before type checking, and only when the
/// parser saw a splice (parser_saw_splice).
fn ct_expand_splices(program: Program, errs: &mut Vec<str>) -> Program {
    var prog: Program = program;
    g_ct_splice_only = true;
    var fi: i64 = 0;
    while fi < prog.funcs.len() {
        var f: Func = prog.funcs.get(fi);
        ct_splice_func(&mut f, &prog, errs);
        prog.funcs.set(fi, f);
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < prog.impls.len() {
        var im: ImplDef = prog.impls.get(ii);
        var mi: i64 = 0;
        while mi < im.methods.len() {
            var m: Func = im.methods.get(mi);
            ct_splice_func(&mut m, &prog, errs);
            im.methods.set(mi, m);
            mi = mi + 1;
        }
        prog.impls.set(ii, im);
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < prog.trait_impls.len() {
        var tim: TraitImpl = prog.trait_impls.get(ti);
        var tmi: i64 = 0;
        while tmi < tim.methods.len() {
            var tm: Func = tim.methods.get(tmi);
            ct_splice_func(&mut tm, &prog, errs);
            tim.methods.set(tmi, tm);
            tmi = tmi + 1;
        }
        prog.trait_impls.set(ti, tim);
        ti = ti + 1;
    }
    var ci: i64 = 0;
    while ci < prog.consts.len() {
        var cd: ConstDef = prog.consts.get(ci);
        if ct_scan_expr_sub(cd.expr) {
            substitute_expr(&mut cd.expr, &prog, errs);
            prog.consts.set(ci, cd);
        }
        ci = ci + 1;
    }
    g_ct_splice_only = false;
    return prog;
}

fn substitute_expr_comptime(expr: &mut Expr, inner: Box<Expr>, original: &Program, errs: &mut Vec<str>) {
    var e: Expr = ct_box_expr_unbox(inner);
    substitute_expr(&mut e, original, errs);
    // Now evaluate the comptime expression (the call stack and line are
    // fresh: any frames left are from an error already reported)
    g_ct_call_stack = Vec::new();
    g_ct_line = 0;
    var result: ResultExpr = evaluate(&e, original);
    match result {
        ResultExpr::Ok(v) => {
            *expr = ct_materialize(v);
        }
        ResultExpr::Err(msg) => {
            var full: str = "comptime error" + ct_at(g_ct_subst_line) + ": " + msg + ct_trace();
            errs.push(full);
            // Fatal unless the kill switch is on. CD8: I/O in comptime is a
            // type error (typechecker.fd TypeChecker_check_comptime_call),
            // not code moved to run time; in fallback mode its warning is
            // suppressed (the typechecker already errors), in fatal mode it
            // is always fatal (an I/O call hidden behind a plain function
            // is one the typechecker cannot see).
            if g_ct_fallback {
                if !ct_io_message(msg) {
                    ct_warn(msg);
                }
            } else {
                ct_fatal_push(full);
            }
        }
    }
}

fn substitute_expr_comptime_block(expr: &mut Expr, stmts: &mut Vec<Stmt>, original: &Program, errs: &mut Vec<str>) {
    substitute_stmts(stmts, original, errs);
    g_ct_call_stack = Vec::new();
    g_ct_line = 0;
    var result: ResultExpr = evaluate_block(stmts, original);
    match result {
        ResultExpr::Ok(v) => {
            *expr = ct_materialize(v);
        }
        ResultExpr::Err(msg) => {
            var full: str = "comptime error" + ct_at(g_ct_subst_line) + ": " + msg + ct_trace();
            errs.push(full);
            if g_ct_fallback {
                if !ct_io_message(msg) {
                    ct_warn(msg);
                }
            } else {
                ct_fatal_push(full);
            }
        }
    }
}

fn substitute_expr_comptime_reflect(expr: &mut Expr, op: ReflectOp, ty: Type, original: &Program, errs: &mut Vec<str>) {
    var result: ResultExpr = evaluate_reflect(op, ty, original);
    match result {
        ResultExpr::Ok(v) => {
            *expr = v;
        }
        ResultExpr::Err(msg) => {
            // A reflect error was silent before (the node lowered to 0);
            // there is no runtime fallback for reflection, so it is fatal
            // in fallback mode too.
            var full: str = "comptime error" + ct_at(g_ct_subst_line) + ": " + msg;
            errs.push(full);
            ct_fatal_push(full);
        }
    }
}

// --- Aggressive comptime evuation (I-5A) -------------------------------
// Auto-evaluate calls to `comptime fn` functions when ALL arguments are
// literals, without requiring an explicit `comptime` wrapper.

// The names of this program's comptime fns
var ct_comptime_fns: i64 = 0;
fn aggressive_comptime_func(funcs: &mut Vec<Func>, idx: i64, original: &Program) {
    var func: Func = funcs.get(idx);
    var si: i64 = 0;
    while si < func.body.len() {
        var stmt: Stmt = func.body.get(si);
        aggressive_comptime_stmt(&mut stmt, original);
        func.body.set(si, stmt);
        si = si + 1;
    }
    funcs.set(idx, func);
}

fn aggressive_comptime_stmt(stmt: &mut Stmt, original: &Program) {
    match stmt {
        Stmt::Let(_, _, expr, _, _, _, _) => {
            aggressive_comptime_expr(&mut expr, original);
        }
        Stmt::Assign(_, _, expr, _) => {
            aggressive_comptime_expr(&mut expr, original);
        }
        Stmt::Expr(e, _) => {
            aggressive_comptime_expr(&mut e, original);
        }
        Stmt::Return(opt, _) => {
            match opt {
                OptBoxExpr::Some(e) => {
                    var inner: Expr = ct_box_expr_unbox(e);
                    aggressive_comptime_expr(&mut inner, original);
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(cond, then_block, else_block, _) => {
            aggressive_comptime_expr(&mut cond, original);
            var si: i64 = 0;
            while si < then_block.len() {
                var s: Stmt = then_block.get(si);
                aggressive_comptime_stmt(&mut s, original);
                then_block.set(si, s);
                si = si + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var ei: i64 = 0;
                    while ei < eb.len() {
                        var s: Stmt = eb.get(ei);
                        aggressive_comptime_stmt(&mut s, original);
                        eb.set(ei, s);
                        ei = ei + 1;
                    }
                }
                OptStmts::None => {
                }
            }
            // I-5A: If condition is a literal bool, eliminate the dead branch
            match cond {
                Expr::BoolLit(b) => {
                    if b {
                        // Clear else block -- then block stays
                        match else_block {
                            OptStmts::Some(_) => {
                                *else_block = OptStmts::None;
                            }
                            OptStmts::None => {
                            }
                        }
                    } else {
                        // Clear then block -- else block stays
                        then_block.clear();
                    }
                }
                _ => {
                }
            }
        }
        Stmt::For(loop_var, iterator, body, _) => {
            aggressive_comptime_expr(&mut iterator, original);
            var si: i64 = 0;
            while si < body.len() {
                var s: Stmt = body.get(si);
                aggressive_comptime_stmt(&mut s, original);
                body.set(si, s);
                si = si + 1;
            }
            // I-5D: Comptime loop unrolling -- if iterator is Range with
            // literal bounds and body is small (<=16 stmts), unroll at AST level
            match iterator {
                Expr::Range(start_box, end_box, inclusive) => {
                    var start_e: Expr = ct_box_expr_unbox(start_box);
                    var end_e: Expr = ct_box_expr_unbox(end_box);
                    match start_e {
                        Expr::IntLit(s) => {
                            match end_e {
                                Expr::IntLit(e) => {
                                    // The count without overflow (BG84): only
                                    // a span of 16 or less is unrolled, and
                                    // e - s (+ 1) wraps for a wide range or
                                    // one ending at i64::MAX
                                    var trip: i64 = 0;
                                    if e > s || (inclusive && e == s) {
                                        trip = 17;
                                        if s >= 0 || e < 0 || e - 16 <= s {
                                            var span: i64 = e - s;
                                            if span <= 16 {
                                                trip = span;
                                                if inclusive {
                                                    trip = span + 1;
                                                }
                                            }
                                        }
                                    }
                                    // Check for break/continue in body
                                    var has_bc: bool = false;
                                    var bi: i64 = 0;
                                    while bi < body.len() {
                                        if stmt_has_break_or_continue(body.get(bi)) {
                                            has_bc = true;
                                        }
                                        bi = bi + 1;
                                    }
                                    if trip > 0 && trip <= 16 && body.len() <= 16 && !has_bc {
                                        // Build unrolled body: one `if true { let i = k; body }`
                                        // per iteration. (Substituting k for i in the body
                                        // would rewrite it in place: body.get() is the
                                        // statement itself, not a copy, so every
                                        // iteration after the first saw the first's k.)
                                        // Counted by iteration, not up to e + 1
                                        // (which wraps at i64::MAX: BG84)
                                        var unrolled: Vec<Stmt> = Vec::new();
                                        var k: i64 = 0;
                                        while k < trip {
                                            var i: i64 = s + k;
                                            var iteration: Vec<Stmt> = Vec::new();
                                            iteration.push(Stmt::Let(loop_var, OptType::Some(Type::I64), Expr::IntLit(i), false, false, Vec::new(), 0));
                                            var si2: i64 = 0;
                                            while si2 < body.len() {
                                                iteration.push(body.get(si2));
                                                si2 = si2 + 1;
                                            }
                                            unrolled.push(Stmt::If(Expr::BoolLit(true), iteration, OptStmts::None, 0));
                                            k = k + 1;
                                        }
                                        // Replace the for loop with if true { unrolled }
                                        * stmt = Stmt::If(Expr::BoolLit(true), unrolled, OptStmts::None, 0);
                                        return;
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        Stmt::While(cond, body, _) => {
            aggressive_comptime_expr(&mut cond, original);
            var si: i64 = 0;
            while si < body.len() {
                var s: Stmt = body.get(si);
                aggressive_comptime_stmt(&mut s, original);
                body.set(si, s);
                si = si + 1;
            }
        }
        _ => {
        }
    }
}

fn aggressive_comptime_expr(expr: &mut Expr, original: &Program) {
    // First recurse into children
    match expr {
        Expr::Binary(op, left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            aggressive_comptime_expr(&mut l, original);
            aggressive_comptime_expr(&mut r, original);
            *expr = Expr::Binary(op, box_expr_new(l), box_expr_new(r));
        }
        Expr::Unary(op, inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            aggressive_comptime_expr(&mut e, original);
            *expr = Expr::Unary(op, box_expr_new(e));
        }
        Expr::Call(callee, args) => {
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                aggressive_comptime_expr(&mut a, original);
                args.set(ai, a);
                ai = ai + 1;
            }
            * expr = Expr::Call(callee, args);
        }
        Expr::MethodCall(receiver, mname, args) => {
            var r: Expr = ct_box_expr_unbox(receiver);
            aggressive_comptime_expr(&mut r, original);
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                aggressive_comptime_expr(&mut a, original);
                args.set(ai, a);
                ai = ai + 1;
            }
            * expr = Expr::MethodCall(box_expr_new(r), mname, args);
        }
        _ => {
        }
    }

    // I-5A: If this is a call to a comptime fn with all-literal args, evaluate it
    match expr {
        Expr::Call(callee, args) => {
            if HashMap_get(ct_comptime_fns, callee) != 0 {
                var all_lit: bool = true;
                var ai: i64 = 0;
                while ai < args.len() {
                    if !is_literal(args.get(ai)) {
                        all_lit = false;
                    }
                    ai = ai + 1;
                }
                if all_lit {
                    var result: ResultExpr = evaluate(expr, original);
                    match result {
                        ResultExpr::Ok(v) => {
                            *expr = ct_materialize(v);
                        }
                        ResultExpr::Err(_) => {
                        }
                        // Leave as-is on error
                    }
                }
            }
        }
        _ => {
        }
    }
}

fn is_literal(expr: Expr) -> bool {
    match expr {
        Expr::IntLit(_) => {
            return true;
        }
        Expr::FloatLit(_) => {
            return true;
        }
        Expr::BoolLit(_) => {
            return true;
        }
        Expr::StringLit(_) => {
            return true;
        }
        _ => {
            return false;
        }
    }
    return false;
}

fn stmt_has_break_or_continue(stmt: Stmt) -> bool {
    match stmt {
        Stmt::Break(_, _) => {
            return true;
        }
        Stmt::Continue(_) => {
            return true;
        }
        Stmt::If(_, then_block, else_block, _) => {
            var i: i64 = 0;
            while i < then_block.len() {
                if stmt_has_break_or_continue(then_block.get(i)) {
                    return true;
                }
                i = i + 1;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    var j: i64 = 0;
                    while j < eb.len() {
                        if stmt_has_break_or_continue(eb.get(j)) {
                            return true;
                        }
                        j = j + 1;
                    }
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::For(_, _, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                if stmt_has_break_or_continue(body.get(i)) {
                    return true;
                }
                i = i + 1;
            }
        }
        Stmt::While(_, body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                if stmt_has_break_or_continue(body.get(i)) {
                    return true;
                }
                i = i + 1;
            }
        }
        Stmt::Unsafe(body, _) => {
            var i: i64 = 0;
            while i < body.len() {
                if stmt_has_break_or_continue(body.get(i)) {
                    return true;
                }
                i = i + 1;
            }
        }
        // V1d (miscompile-log): a `break`/`continue` in a `match` arm (or
        // another block, or an if/match/block expression) is the loop's
        // too; unrolling such a body made `break` leave only the arm
        Stmt::Match(scrut, arms, _) => {
            if ct_expr_has_break_or_continue(scrut) {
                return true;
            }
            var ai: i64 = 0;
            while ai < arms.len() {
                if ct_stmts_have_break_or_continue(arms.get(ai).body) {
                    return true;
                }
                ai = ai + 1;
            }
        }
        Stmt::Loop(body, _) => {
            return ct_stmts_have_break_or_continue(body);
        }
        Stmt::Defer(body, _) => {
            return ct_stmts_have_break_or_continue(body);
        }
        Stmt::Sandbox(body, _) => {
            return ct_stmts_have_break_or_continue(body);
        }
        Stmt::Txn(body, _) => {
            return ct_stmts_have_break_or_continue(body);
        }
        Stmt::SpawnScope(body, _) => {
            return ct_stmts_have_break_or_continue(body);
        }
        Stmt::Handle(body, _, _) => {
            return ct_stmts_have_break_or_continue(body);
        }
        Stmt::RegionBlock(_, _, _, _, _, body, _) => {
            return ct_stmts_have_break_or_continue(body);
        }
        Stmt::Expr(e, _) => {
            return ct_expr_has_break_or_continue(e);
        }
        Stmt::Let(_, _, e, _, _, _, _) => {
            return ct_expr_has_break_or_continue(e);
        }
        Stmt::Assign(_, _, e, _) => {
            return ct_expr_has_break_or_continue(e);
        }
        _ => {
        }
    }
    return false;
}

fn ct_stmts_have_break_or_continue(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        if stmt_has_break_or_continue(stmts.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// V1d: a `break`/`continue` inside an if, match or block expression
/// (`val x = match k { _ => { break; } }`). Closures are left out: a
/// `break` there is not the loop's.
fn ct_expr_has_break_or_continue(e: Expr) -> bool {
    match e {
        Expr::If(c, then_block, else_block) => {
            if ct_expr_has_break_or_continue(ct_box_expr_unbox(c)) {
                return true;
            }
            if ct_stmts_have_break_or_continue(then_block) {
                return true;
            }
            match else_block {
                OptStmts::Some(eb) => {
                    return ct_stmts_have_break_or_continue(eb);
                }
                OptStmts::None => {
                }
            }
        }
        Expr::Match(scrut, arms) => {
            if ct_expr_has_break_or_continue(ct_box_expr_unbox(scrut)) {
                return true;
            }
            var ai: i64 = 0;
            while ai < arms.len() {
                if ct_stmts_have_break_or_continue(arms.get(ai).body) {
                    return true;
                }
                ai = ai + 1;
            }
        }
        Expr::Block(body) => {
            return ct_stmts_have_break_or_continue(body);
        }
        Expr::TryBlock(body) => {
            return ct_stmts_have_break_or_continue(body);
        }
        _ => {
        }
    }
    return false;
}

// --- Identifier replacement (for loop unrolling) -------------------------
// Each function returns a new tree and changes nothing in place: a pattern
// binding is a copy, and a statement list read with get() can share its
// buffer with the loop body the next iteration copies again (BG27). Every
// expression and statement form is visited (f-strings, match, tuples,
// closures, ...). A name the body binds again (`val`, a match arm's
// pattern, a closure parameter, an inner `for`, a select case, an effect
// handler's parameter) hides the loop variable from there on.

/// Pattern `p` binds `name`.
fn ct_pattern_binds(p: Pattern, name: str) -> bool {
    match p {
        Pattern::Ident(n) => {
            return n == name;
        }
        Pattern::EnumVariant(_, _, bindings) => {
            var i: i64 = 0;
            while i < bindings.len() {
                if bindings.get(i).name == name {
                    return true;
                }
                i = i + 1;
            }
        }
        _ => {
        }
    }
    return false;
}

/// Statement `stmt` declares `name` for the statements after it.
fn ct_stmt_binds(stmt: Stmt, name: str) -> bool {
    match stmt {
        Stmt::Let(lname, _, _, _, _, _, _) => {
            return lname == name;
        }
        Stmt::LetTuple(tnames, _, _) => {
            var i: i64 = 0;
            while i < tnames.len() {
                if tnames.get(i) == name {
                    return true;
                }
                i = i + 1;
            }
        }
        Stmt::LetUninit(uname, _, _, _) => {
            return uname == name;
        }
        _ => {
        }
    }
    return false;
}

fn ct_str_in(names: Vec<str>, name: str) -> bool {
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// `stmts` with `name` replaced by `replacement` up to the statement that
/// declares `name` again (its initializer still reads the outer one).
fn replace_ident_in_stmts(stmts: Vec<Stmt>, name: str, replacement: Expr) -> Vec<Stmt> {
    var out: Vec<Stmt> = Vec::new();
    var hidden: bool = false;
    var si: i64 = 0;
    while si < stmts.len() {
        if hidden {
            out.push(stmts.get(si));
        } else {
            val s2: Stmt = replace_ident_in_stmt(stmts.get(si), name, replacement);
            if ct_stmt_binds(s2, name) {
                hidden = true;
            }
            out.push(s2);
        }
        si = si + 1;
    }
    return out;
}

fn ct_ri_opt_stmts(o: OptStmts, name: str, replacement: Expr) -> OptStmts {
    match o {
        OptStmts::Some(b) => {
            return OptStmts::Some(replace_ident_in_stmts(b, name, replacement));
        }
        OptStmts::None => {
        }
    }
    return OptStmts::None;
}

fn ct_ri_opt_box(o: OptBoxExpr, name: str, replacement: Expr) -> OptBoxExpr {
    match o {
        OptBoxExpr::Some(e) => {
            return OptBoxExpr::Some(ct_ri_box(e, name, replacement));
        }
        OptBoxExpr::None => {
        }
    }
    return OptBoxExpr::None;
}

fn ct_ri_box(b: Box<Expr>, name: str, replacement: Expr) -> Box<Expr> {
    return box_expr_new(replace_ident_in_expr(ct_box_expr_unbox(b), name, replacement));
}

fn ct_ri_exprs(es: Vec<Expr>, name: str, replacement: Expr) -> Vec<Expr> {
    var out: Vec<Expr> = Vec::new();
    var i: i64 = 0;
    while i < es.len() {
        out.push(replace_ident_in_expr(es.get(i), name, replacement));
        i = i + 1;
    }
    return out;
}

/// Match arms: an arm whose pattern binds `name` is left as it is.
fn ct_ri_arms(arms: Vec<MatchArm>, name: str, replacement: Expr) -> Vec<MatchArm> {
    var out: Vec<MatchArm> = Vec::new();
    var ai: i64 = 0;
    while ai < arms.len() {
        var arm: MatchArm = arms.get(ai);
        if !ct_pattern_binds(arm.pattern, name) {
            arm.guard = ct_ri_opt_box(arm.guard, name, replacement);
            arm.body = replace_ident_in_stmts(arm.body, name, replacement);
        }
        out.push(arm);
        ai = ai + 1;
    }
    return out;
}

fn replace_ident_in_stmt(stmt: Stmt, name: str, replacement: Expr) -> Stmt {
    match stmt {
        Stmt::Let(lname, lty, expr, lmut, lpersist, lann, lline) => {
            return Stmt::Let(lname, lty, replace_ident_in_expr(expr, name, replacement), lmut, lpersist, lann, lline);
        }
        Stmt::LetTuple(tnames, expr, tline) => {
            return Stmt::LetTuple(tnames, replace_ident_in_expr(expr, name, replacement), tline);
        }
        Stmt::Assign(aname, aop, expr, aline) => {
            return Stmt::Assign(aname, aop, replace_ident_in_expr(expr, name, replacement), aline);
        }
        Stmt::IndexAssign(iname, index, iop, expr, iline) => {
            return Stmt::IndexAssign(iname, replace_ident_in_expr(index, name, replacement), iop, replace_ident_in_expr(expr, name, replacement), iline);
        }
        Stmt::DerefAssign(pexpr, dop, expr, dline) => {
            return Stmt::DerefAssign(replace_ident_in_expr(pexpr, name, replacement), dop, replace_ident_in_expr(expr, name, replacement), dline);
        }
        Stmt::FieldAssign(oexpr, ffield, fop, expr, fline) => {
            return Stmt::FieldAssign(replace_ident_in_expr(oexpr, name, replacement), ffield, fop, replace_ident_in_expr(expr, name, replacement), fline);
        }
        Stmt::Expr(e, eline) => {
            return Stmt::Expr(replace_ident_in_expr(e, name, replacement), eline);
        }
        Stmt::Return(opt, rline) => {
            return Stmt::Return(ct_ri_opt_box(opt, name, replacement), rline);
        }
        Stmt::Break(bopt, bline) => {
            return Stmt::Break(ct_ri_opt_box(bopt, name, replacement), bline);
        }
        Stmt::If(cond, then_block, else_block, iline2) => {
            return Stmt::If(replace_ident_in_expr(cond, name, replacement), replace_ident_in_stmts(then_block, name, replacement), ct_ri_opt_stmts(else_block, name, replacement), iline2);
        }
        Stmt::For(v, iterator, body, forline) => {
            // The iterator is evaluated outside the inner loop's variable
            val it2: Expr = replace_ident_in_expr(iterator, name, replacement);
            if v == name {
                return Stmt::For(v, it2, body, forline);
            }
            return Stmt::For(v, it2, replace_ident_in_stmts(body, name, replacement), forline);
        }
        Stmt::While(cond, body, wline) => {
            return Stmt::While(replace_ident_in_expr(cond, name, replacement), replace_ident_in_stmts(body, name, replacement), wline);
        }
        Stmt::Loop(lbody, lline2) => {
            return Stmt::Loop(replace_ident_in_stmts(lbody, name, replacement), lline2);
        }
        Stmt::Defer(dbody, dline2) => {
            return Stmt::Defer(replace_ident_in_stmts(dbody, name, replacement), dline2);
        }
        Stmt::Match(scrut, arms, mline) => {
            return Stmt::Match(replace_ident_in_expr(scrut, name, replacement), ct_ri_arms(arms, name, replacement), mline);
        }
        Stmt::Sandbox(sbody, sline) => {
            return Stmt::Sandbox(replace_ident_in_stmts(sbody, name, replacement), sline);
        }
        Stmt::Unsafe(ubody, uline) => {
            return Stmt::Unsafe(replace_ident_in_stmts(ubody, name, replacement), uline);
        }
        Stmt::Txn(tbody, tline2) => {
            return Stmt::Txn(replace_ident_in_stmts(tbody, name, replacement), tline2);
        }
        Stmt::SpawnScope(spbody, spline) => {
            return Stmt::SpawnScope(replace_ident_in_stmts(spbody, name, replacement), spline);
        }
        Stmt::RegionBlock(rname, ra, rb, rc, rd, rbody, rline2) => {
            return Stmt::RegionBlock(rname, ra, rb, rc, rd, replace_ident_in_stmts(rbody, name, replacement), rline2);
        }
        Stmt::Parallel(brs, pline) => {
            var nb: Vec<Vec<Stmt>> = Vec::new();
            var bi: i64 = 0;
            while bi < brs.len() {
                nb.push(replace_ident_in_stmts(brs.get(bi), name, replacement));
                bi = bi + 1;
            }
            return Stmt::Parallel(nb, pline);
        }
        Stmt::Handle(hbody, hs, hline) => {
            var nh: Vec<EffectHandler> = Vec::new();
            var hi: i64 = 0;
            while hi < hs.len() {
                var h: EffectHandler = hs.get(hi);
                if !ct_str_in(h.params, name) {
                    h.body = replace_ident_in_stmts(h.body, name, replacement);
                }
                nh.push(h);
                hi = hi + 1;
            }
            return Stmt::Handle(replace_ident_in_stmts(hbody, name, replacement), nh, hline);
        }
        Stmt::Select(cases, sdefault, sline2) => {
            var nc: Vec<SelectCase> = Vec::new();
            var ci: i64 = 0;
            while ci < cases.len() {
                var c: SelectCase = cases.get(ci);
                c.channel = replace_ident_in_expr(c.channel, name, replacement);
                if c.var_name != name {
                    c.body = replace_ident_in_stmts(c.body, name, replacement);
                }
                nc.push(c);
                ci = ci + 1;
            }
            return Stmt::Select(nc, ct_ri_opt_stmts(sdefault, name, replacement), sline2);
        }
        Stmt::Do(deff, dop2, dargs, dline3) => {
            return Stmt::Do(deff, dop2, ct_ri_exprs(dargs, name, replacement), dline3);
        }
        Stmt::Backward(be, bline2) => {
            return Stmt::Backward(replace_ident_in_expr(be, name, replacement), bline2);
        }
        Stmt::Resume(rk, rv, rline3) => {
            return Stmt::Resume(replace_ident_in_expr(rk, name, replacement), replace_ident_in_expr(rv, name, replacement), rline3);
        }
        _ => {
        }
    }
    return stmt;
}

fn replace_ident_in_expr(expr: Expr, name: str, replacement: Expr) -> Expr {
    match expr {
        Expr::Ident(n) => {
            if n == name {
                return replacement;
            }
        }
        // `comptime (i * i)` inside an inline for's body: the loop variable
        // is its literal in the comptime expression too
        Expr::Comptime(inner) => {
            return Expr::Comptime(ct_ri_box(inner, name, replacement));
        }
        Expr::ComptimeBlock(cstmts) => {
            return Expr::ComptimeBlock(replace_ident_in_stmts(cstmts, name, replacement));
        }
        Expr::Binary(op, left, right) => {
            return Expr::Binary(op, ct_ri_box(left, name, replacement), ct_ri_box(right, name, replacement));
        }
        Expr::Unary(op, inner) => {
            return Expr::Unary(op, ct_ri_box(inner, name, replacement));
        }
        Expr::Call(callee, args) => {
            return Expr::Call(callee, ct_ri_exprs(args, name, replacement));
        }
        Expr::MethodCall(receiver, mname, args) => {
            return Expr::MethodCall(ct_ri_box(receiver, name, replacement), mname, ct_ri_exprs(args, name, replacement));
        }
        Expr::FieldAccess(inner, field) => {
            return Expr::FieldAccess(ct_ri_box(inner, name, replacement), field);
        }
        Expr::OptionalFieldAccess(inner, ofield) => {
            return Expr::OptionalFieldAccess(ct_ri_box(inner, name, replacement), ofield);
        }
        Expr::Index(array, index) => {
            return Expr::Index(ct_ri_box(array, name, replacement), ct_ri_box(index, name, replacement));
        }
        Expr::StructLit(sname, fields, base) => {
            var nf: Vec<FieldInit> = Vec::new();
            var fi: i64 = 0;
            while fi < fields.len() {
                var f: FieldInit = fields.get(fi);
                f.value = replace_ident_in_expr(f.value, name, replacement);
                nf.push(f);
                fi = fi + 1;
            }
            return Expr::StructLit(sname, nf, ct_ri_opt_box(base, name, replacement));
        }
        Expr::If(cond, then_block, else_block) => {
            return Expr::If(ct_ri_box(cond, name, replacement), replace_ident_in_stmts(then_block, name, replacement), ct_ri_opt_stmts(else_block, name, replacement));
        }
        Expr::Block(bstmts) => {
            return Expr::Block(replace_ident_in_stmts(bstmts, name, replacement));
        }
        Expr::TryBlock(tstmts) => {
            return Expr::TryBlock(replace_ident_in_stmts(tstmts, name, replacement));
        }
        Expr::Range(start, end, incl) => {
            return Expr::Range(ct_ri_box(start, name, replacement), ct_ri_box(end, name, replacement), incl);
        }
        Expr::ArrayLit(aty, elems) => {
            return Expr::ArrayLit(aty, ct_ri_exprs(elems, name, replacement));
        }
        Expr::TupleLit(telems) => {
            return Expr::TupleLit(ct_ri_exprs(telems, name, replacement));
        }
        Expr::EnumLit(ename, evariant, eargs) => {
            return Expr::EnumLit(ename, evariant, ct_ri_exprs(eargs, name, replacement));
        }
        Expr::FString(parts) => {
            var np: Vec<FStringPart> = Vec::new();
            var pi: i64 = 0;
            while pi < parts.len() {
                match parts.get(pi) {
                    FStringPart::Literal(ls) => {
                        np.push(FStringPart::Literal(ls));
                    }
                    FStringPart::Expr(pe) => {
                        np.push(FStringPart::Expr(replace_ident_in_expr(pe, name, replacement)));
                    }
                }
                pi = pi + 1;
            }
            return Expr::FString(np);
        }
        Expr::Match(scrut, arms) => {
            return Expr::Match(ct_ri_box(scrut, name, replacement), ct_ri_arms(arms, name, replacement));
        }
        Expr::Closure(cparams, cbody, cret) => {
            var cpi: i64 = 0;
            while cpi < cparams.len() {
                if cparams.get(cpi).name == name {
                    return Expr::Closure(cparams, cbody, cret);
                }
                cpi = cpi + 1;
            }
            return Expr::Closure(cparams, replace_ident_in_stmts(cbody, name, replacement), cret);
        }
        Expr::Ref(inner, is_mut) => {
            return Expr::Ref(ct_ri_box(inner, name, replacement), is_mut);
        }
        Expr::Deref(inner) => {
            return Expr::Deref(ct_ri_box(inner, name, replacement));
        }
        Expr::StrConcat(sl, sr) => {
            return Expr::StrConcat(ct_ri_box(sl, name, replacement), ct_ri_box(sr, name, replacement));
        }
        Expr::Try(te) => {
            return Expr::Try(ct_ri_box(te, name, replacement));
        }
        Expr::Coalesce(cl, cr) => {
            return Expr::Coalesce(ct_ri_box(cl, name, replacement), ct_ri_box(cr, name, replacement));
        }
        Expr::IsCheck(ie, iname) => {
            return Expr::IsCheck(ct_ri_box(ie, name, replacement), iname);
        }
        Expr::Cast(inner, ty) => {
            return Expr::Cast(ct_ri_box(inner, name, replacement), ty);
        }
        Expr::QuantCast(qe, qty) => {
            return Expr::QuantCast(ct_ri_box(qe, name, replacement), qty);
        }
        Expr::PipeForward(pl, pr) => {
            return Expr::PipeForward(ct_ri_box(pl, name, replacement), ct_ri_box(pr, name, replacement));
        }
        Expr::Await(ae) => {
            return Expr::Await(ct_ri_box(ae, name, replacement));
        }
        Expr::Spawn(spe) => {
            return Expr::Spawn(ct_ri_box(spe, name, replacement));
        }
        Expr::Yield(ye) => {
            return Expr::Yield(ct_ri_box(ye, name, replacement));
        }
        Expr::NamedArg(nname, ne) => {
            return Expr::NamedArg(nname, ct_ri_box(ne, name, replacement));
        }
        Expr::Asm(atext, aops) => {
            var no: Vec<AsmOperand> = Vec::new();
            var oi: i64 = 0;
            while oi < aops.len() {
                var o: AsmOperand = aops.get(oi);
                match o.direction {
                    AsmDir::In => {
                        o.expr = replace_ident_in_expr(o.expr, name, replacement);
                    }
                    _ => {
                    }
                }
                no.push(o);
                oi = oi + 1;
            }
            return Expr::Asm(atext, no);
        }
        _ => {
        }
    }
    return expr;
}

// --- Evuation ----------------------------------------------------------

/// Index in `original.consts` of const `name`, or -1.
fn ct_find_const(original: &Program, name: str) -> i64 {
    var ci: i64 = 0;
    while ci < original.consts.len() {
        if original.consts.get(ci).name == name {
            return ci;
        }
        ci = ci + 1;
    }
    return 0 - 1;
}

/// The value of const `original.consts[idx]` (its initializer evaluated);
/// a const is comptime-known, so `comptime CONST + 1` computes. Nested
/// consts (`const A = B + 1`) recurse through here, bounded by the same
/// call-depth guard as comptime fn calls.
fn ct_const_value(idx: i64, original: &Program) -> ResultExpr {
    if g_ct_call_depth >= 400 {
        return ResultExpr::Err("comptime consts nest deeper than 400 (through '" + original.consts.get(idx).name + "')");
    }
    g_ct_call_depth = g_ct_call_depth + 1;
    var ie: Expr = original.consts.get(idx).expr;
    val cres: ResultExpr = evaluate(&ie, original);
    g_ct_call_depth = g_ct_call_depth - 1;
    // A const declared unsigned tags its value, the way a `val x: u64`
    // in a comptime block does (BG62)
    match cres {
        ResultExpr::Ok(cv) => {
            var cty: Type = original.consts.get(idx).ty;
            if ct_unsigned_ty(cty) {
                return ResultExpr::Ok(ct_tag(cv, cty));
            }
        }
        ResultExpr::Err(_) => {
        }
    }
    return cres;
}

pub fn evaluate(expr: &Expr, original: &Program) -> ResultExpr {
    if !ct_fuel_left() {
        return ct_out_of_fuel();
    }
    // A method on a comptime table (.len, .get on a reflect result) needs
    // the env-aware evaluator's table handling; an empty env serves (the
    // tables arrive as values, not names)
    match expr {
        Expr::MethodCall(_, _, _) => {
            var empty_env: ComptimeEnv = ComptimeEnv_new();
            return evaluate_with_env(expr, &empty_env, original);
        }
        Expr::Cast(_, _) => {
            var cenv: ComptimeEnv = ComptimeEnv_new();
            return evaluate_with_env(expr, &cenv, original);
        }
        Expr::Ident(name) => {
            var ci: i64 = ct_find_const(original, name);
            if ci >= 0 {
                return ct_const_value(ci, original);
            }
            return ResultExpr::Err("'" + name + "' is not known at compile time (a variable of the running program)");
        }
        Expr::IntLit(n) => {
            return ResultExpr::Ok(Expr::IntLit(n));
        }
        Expr::FloatLit(f) => {
            return ResultExpr::Ok(Expr::FloatLit(f));
        }
        Expr::StringLit(s) => {
            return ResultExpr::Ok(Expr::StringLit(s));
        }
        Expr::BoolLit(b) => {
            return ResultExpr::Ok(Expr::BoolLit(b));
        }
        Expr::Binary(op, left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            var lr: ResultExpr = evaluate(&l, original);
            match lr {
                ResultExpr::Err(msg) => {
                    return ResultExpr::Err(msg);
                }
                ResultExpr::Ok(lv) => {
                    var rr: ResultExpr = evaluate(&r, original);
                    match rr {
                        ResultExpr::Err(msg) => {
                            return ResultExpr::Err(msg);
                        }
                        ResultExpr::Ok(rv) => {
                            return eval_binop(op, lv, rv);
                        }
                    }
                }
            }
        }
        Expr::Unary(op, inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            var vr: ResultExpr = evaluate(&e, original);
            match vr {
                ResultExpr::Err(msg) => {
                    return ResultExpr::Err(msg);
                }
                ResultExpr::Ok(v) => {
                    return eval_unaryop(op, v);
                }
            }
        }
        Expr::Call(callee, args) => {
            if callee == "gensym" && !ct_has_comptime_fn(original, callee) {
                var gs_args: Vec<Expr> = Vec::new();
                var gai: i64 = 0;
                while gai < args.len() {
                    var gae: Expr = args.get(gai);
                    match evaluate(&gae, original) {
                        ResultExpr::Err(gm) => {
                            return ResultExpr::Err(gm);
                        }
                        ResultExpr::Ok(gv) => {
                            gs_args.push(gv);
                        }
                    }
                    gai = gai + 1;
                }
                return ct_gensym_call(gs_args, original);
            }
            // Look up comptime function
            var func_idx: i64 = -1;
            var fi: i64 = 0;
            while fi < original.funcs.len() {
                var f: Func = original.funcs.get(fi);
                if f.name == callee && f.is_comptime {
                    func_idx = fi;
                }
                fi = fi + 1;
            }

            // §4.11 reflection over annotations: the names on a struct
            // (struct_annotations) or one of its fields
            // (field_annotations), so compile-time code can act on the
            // safety annotations (@secret, @zeroize, ...) a declaration
            // carries — type arguments come as strings (type_name(T)
            // composes inside a comptime T: type function).
            if callee == "target_os" || callee == "target_arch" || callee == "build_debug" || callee == "feature_enabled" || callee == "field_annotations" || callee == "struct_annotations" || callee == "field_names_of" || callee == "field_count_of" {
                var fa_args: Vec<Expr> = Vec::new();
                var fai: i64 = 0;
                while fai < args.len() {
                    var fa_e: Expr = args.get(fai);
                    match evaluate(&fa_e, original) {
                        ResultExpr::Err(fam) => {
                            return ResultExpr::Err(fam);
                        }
                        ResultExpr::Ok(fav) => {
                            fa_args.push(fav);
                        }
                    }
                    fai = fai + 1;
                }
                return ct_annotations_call(callee, fa_args, original);
            }
            // §4.11: embed("path") reads a file of the project while
            // compiling (its bytes a comptime Vec<i64>): the one file
            // read comptime code may do, relative to the source's
            // directory and never leaving it
            if callee == "embed" {
                var em_args: Vec<Expr> = Vec::new();
                var emi: i64 = 0;
                while emi < args.len() {
                    var em_e: Expr = args.get(emi);
                    match evaluate(&em_e, original) {
                        ResultExpr::Err(emm) => {
                            return ResultExpr::Err(emm);
                        }
                        ResultExpr::Ok(emv) => {
                            em_args.push(emv);
                        }
                    }
                    emi = emi + 1;
                }
                return ct_embed_call(em_args);
            }
            if callee == "compile_error" {
                var ce_args: Vec<Expr> = Vec::new();
                var cei: i64 = 0;
                while cei < args.len() {
                    var ce_e: Expr = args.get(cei);
                    match evaluate(&ce_e, original) {
                        ResultExpr::Err(cem) => {
                            return ResultExpr::Err(cem);
                        }
                        ResultExpr::Ok(cev) => {
                            ce_args.push(cev);
                        }
                    }
                    cei = cei + 1;
                }
                if ce_args.len() == 1 {
                    match ce_args.get(0) {
                        Expr::StringLit(m) => {
                            return ResultExpr::Err("compile error: " + m + ct_trace());
                        }
                        _ => {
                        }
                    }
                }
                return ResultExpr::Err("compile_error takes one string, the message");
            }
            if callee == "comptime_assert" {
                var ca_args: Vec<Expr> = Vec::new();
                var cai: i64 = 0;
                while cai < args.len() {
                    var ca_e: Expr = args.get(cai);
                    match evaluate(ca_e, original) {
                        ResultExpr::Err(cam) => {
                            return ResultExpr::Err(cam);
                        }
                        ResultExpr::Ok(cav) => {
                            ca_args.push(cav);
                        }
                    }
                    cai = cai + 1;
                }
                var ca_msg: str = "(no message)";
                if ca_args.len() == 2 {
                    match ca_args.get(1) {
                        Expr::StringLit(mm) => {
                            ca_msg = mm;
                        }
                        _ => {
                        }
                    }
                }
                if ca_args.len() >= 1 {
                    match ca_args.get(0) {
                        Expr::BoolLit(cb) => {
                            if cb {
                                return ResultExpr::Ok(Expr::BoolLit(true));
                            }
                            return ResultExpr::Err("comptime assert failed: " + ca_msg + ct_trace());
                        }
                        _ => {
                            return ResultExpr::Err("comptime_assert takes a bool the evaluator can compute");
                        }
                    }
                }
                return ResultExpr::Err("comptime_assert takes a bool and an optional message");
            }
            if func_idx < 0 {
                if ct_io_builtin(callee) {
                    return ResultExpr::Err("'" + callee + "()' does I/O, and comptime code runs inside the compiler with no I/O (files, network, processes, the console, the clock or the environment)");
                }
                if ct_pure_builtin(callee) {
                    var pb_args: Vec<Expr> = Vec::new();
                    var pbi: i64 = 0;
                    while pbi < args.len() {
                        var pbe: Expr = args.get(pbi);
                        match evaluate(&pbe, original) {
                            ResultExpr::Err(pm) => {
                                return ResultExpr::Err(pm);
                            }
                            ResultExpr::Ok(pv) => {
                                pb_args.push(pv);
                            }
                        }
                        pbi = pbi + 1;
                    }
                    return ct_pure_call(callee, pb_args);
                }
                func_idx = ct_plain_fn(original, callee);
            }
            if func_idx < 0 {
                return ResultExpr::Err("comptime function '" + callee + "' not found");
            }
            var func: Func = original.funcs.get(func_idx);
            // Evuate args
            var arg_values: Vec<Expr> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                var ar: ResultExpr = evaluate(&a, original);
                match ar {
                    ResultExpr::Err(msg) => {
                        return ResultExpr::Err(msg);
                    }
                    ResultExpr::Ok(v) => {
                        arg_values.push(v);
                    }
                }
                ai = ai + 1;
            }
            return call_comptime_func(func, arg_values, original);
        }
        Expr::If(cond, then_block, else_block) => {
            var cr: ResultExpr = evaluate(cond, original);
            match cr {
                ResultExpr::Err(msg) => {
                    return ResultExpr::Err(msg);
                }
                ResultExpr::Ok(c) => {
                    match c {
                        Expr::BoolLit(b) => {
                            if b {
                                return evaluate_block(then_block, original);
                            } else {
                                match else_block {
                                    OptStmts::Some(eb) => {
                                        return evaluate_block(eb, original);
                                    }
                                    OptStmts::None => {
                                        return ResultExpr::Ok(Expr::IntLit(0));
                                    }
                                }
                            }
                        }
                        _ => {
                            return ResultExpr::Err("comptime if condition must be boolean");
                        }
                    }
                }
            }
        }
        Expr::Block(stmts) => {
            return evaluate_block(stmts, original);
        }
        Expr::Comptime(inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            return evaluate(&e, original);
        }
        Expr::ComptimeBlock(stmts) => {
            return evaluate_block(stmts, original);
        }
        Expr::ComptimeReflect(op, ty) => {
            return evaluate_reflect(op, ty, original);
        }
        _ => {
            return ResultExpr::Ok(*expr);
        }
    }
    return ResultExpr::Ok(Expr::IntLit(0));
}

fn evaluate_block(stmts: Vec<Stmt>, original: &Program) -> ResultExpr {
    var env: ComptimeEnv = ComptimeEnv_new();
    return evaluate_block_with_env(stmts, original, &env);
}

fn evaluate_block_with_env(stmts: Vec<Stmt>, original: &Program, env: &ComptimeEnv) -> ResultExpr {
    var returned: Vec<i64> = Vec::new();
    var block_env: ComptimeEnv = ComptimeEnv_clone(env);
    return evaluate_block_rt(stmts, original, &mut block_env, &mut returned);
}

/// Runs `stmts` in `env` itself (its Vecs are shared): assignments to
/// outer variables persist (a loop accumulating into `out`), names the
/// block declares are dropped at its end.
fn evaluate_block_rt(stmts: Vec<Stmt>, original: &Program, env: &mut ComptimeEnv, returned: &mut Vec<i64>) -> ResultExpr {
    var local_env: ComptimeEnv = ComptimeEnv {
        names: env.names, values: env.values
    };
    var n_outer: i64 = local_env.names.len();
    var result: Expr = Expr::IntLit(0);
    var si: i64 = 0;
    while si < stmts.len() {
        var stmt: Stmt = stmts.get(si);
        if !ct_fuel_left() {
            return ct_out_of_fuel();
        }
        g_ct_line = ct_stmt_line(stmt);
        match stmt {
            Stmt::Let(name, lty, expr, _, _, _, _) => {
                var vr: ResultExpr = evaluate_with_env(expr, &local_env, original);
                match vr {
                    ResultExpr::Err(msg) => {
                        return ResultExpr::Err(msg);
                    }
                    ResultExpr::Ok(v) => {
                        // BG62: a declared unsigned type tags the value so the
                        // arithmetic on it stays unsigned
                        var sv: Expr = v;
                        match lty {
                            OptType::Some(dty) => {
                                if ct_unsigned_ty(dty) {
                                    sv = ct_tag(v, dty);
                                }
                            }
                            OptType::None => {
                            }
                        }
                        ComptimeEnv_declare(&mut local_env, name, sv, n_outer);
                    }
                }
            }
            Stmt::Assign(target, op, expr, _) => {
                var vr: ResultExpr = evaluate_with_env(expr, &local_env, original);
                match vr {
                    ResultExpr::Err(msg) => {
                        return ResultExpr::Err(msg);
                    }
                    ResultExpr::Ok(v) => {
                        // Every compound operator (`/=`, `%=`, `<<=`, ...: only
                        // `+=`, `-=`, `*=` were known, the others stored `v`),
                        // and one that fails (`x /= 0`) is an error
                        match ce_assign(&local_env, target, op, v) {
                            ResultExpr::Ok(nv) => {
                                ComptimeEnv_set(&mut local_env, target, nv);
                            }
                            ResultExpr::Err(am) => {
                                return ResultExpr::Err(am);
                            }
                        }
                    }
                }
            }
            Stmt::LetUninit(uname, udty, _, _) => {
                // declared here, so an assignment in an inner block reaches it
                var uv: Expr = Expr::IntLit(0);
                if ct_unsigned_ty(udty) {
                    uv = Expr::Cast(Box::new(Expr::IntLit(0)), udty);
                }
                ComptimeEnv_declare(&mut local_env, uname, uv, n_outer);
            }
            Stmt::Expr(e, _) => {
                result = Expr::IntLit(0);
                // `t.push(x)` / `t.set(i, x)` on a comptime table
                var handled: bool = false;
                match e {
                    Expr::MethodCall(pr, pm, pargs) => {
                        match ct_box_expr_unbox(pr) {
                            Expr::Ident(pv) => {
                                if pm == "push" || pm == "set" {
                                    var cur: OptExpr = ComptimeEnv_get(&local_env, pv);
                                    match cur {
                                        OptExpr::Some(cv) => {
                                            var tel: Vec<Expr> = Vec::new();
                                            if ct_vec_elems(cv, &mut tel) {
                                                var vals: Vec<Expr> = Vec::new();
                                                var pa: i64 = 0;
                                                while pa < pargs.len() {
                                                    var ax: Expr = pargs.get(pa);
                                                    match evaluate_with_env(&ax, &local_env, original) {
                                                        ResultExpr::Ok(av) => {
                                                            vals.push(av);
                                                        }
                                                        ResultExpr::Err(am) => {
                                                            return ResultExpr::Err(am);
                                                        }
                                                    }
                                                    pa = pa + 1;
                                                }
                                                var et: Type = Type::I64;
                                                if pm == "push" && vals.len() == 1 {
                                                    tel.push(vals.get(0));
                                                    et = ct_lit_type(vals.get(0));
                                                    handled = true;
                                                } else if pm == "set" && vals.len() == 2 {
                                                    match ct_untag(vals.get(0)) {
                                                        Expr::IntLit(si2) => {
                                                            if si2 < 0 || si2 >= tel.len() {
                                                                return ResultExpr::Err("comptime Vec index " + int_to_str(si2) + " out of bounds");
                                                            }
                                                            tel.set(si2, vals.get(1));
                                                            et = ct_lit_type(vals.get(1));
                                                            handled = true;
                                                        }
                                                        _ => {
                                                        }
                                                    }
                                                }
                                                if handled {
                                                    ComptimeEnv_set(&mut local_env, pv, ct_vec_of(et, tel));
                                                }
                                            }
                                        }
                                        OptExpr::None => {
                                        }
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                if handled {
                    si = si + 1;
                    continue;
                }
                var vr: ResultExpr = evaluate_with_env(e, &local_env, original);
                match vr {
                    ResultExpr::Err(msg) => {
                        return ResultExpr::Err(msg);
                    }
                    ResultExpr::Ok(v) => {
                        result = v;
                    }
                }
            }
            Stmt::Return(opt, _) => {
                returned.push(CE_FLOW_RETURN);
                match opt {
                    OptBoxExpr::Some(e) => {
                        var inner: Expr = ct_box_expr_unbox(e);
                        return evaluate_with_env(&inner, &local_env, original);
                    }
                    OptBoxExpr::None => {
                        return ResultExpr::Ok(Expr::IntLit(0));
                    }
                }
            }
            Stmt::If(cond, then_block, else_block, _) => {
                var cr: ResultExpr = evaluate_with_env(cond, &local_env, original);
                match cr {
                    ResultExpr::Err(msg) => {
                        return ResultExpr::Err(msg);
                    }
                    ResultExpr::Ok(c) => {
                        match c {
                            Expr::BoolLit(b) => {
                                if b {
                                    var br: ResultExpr = evaluate_block_rt(then_block, original, &mut local_env, returned);
                                    if returned.len() > 0 {
                                        // return, or a break/continue for an
                                        // enclosing loop: what was assigned
                                        // so far is kept
                                        ce_write_back(env, &local_env, n_outer);
                                        return br;
                                    }
                                    match br {
                                        ResultExpr::Ok(v) => {
                                            result = v;
                                        }
                                        ResultExpr::Err(msg) => {
                                            return ResultExpr::Err(msg);
                                        }
                                    }
                                } else {
                                    match else_block {
                                        OptStmts::Some(eb) => {
                                            var br: ResultExpr = evaluate_block_rt(eb, original, &mut local_env, returned);
                                            if returned.len() > 0 {
                                                ce_write_back(env, &local_env, n_outer);
                                                return br;
                                            }
                                            match br {
                                                ResultExpr::Ok(v) => {
                                                    result = v;
                                                }
                                                ResultExpr::Err(msg) => {
                                                    return ResultExpr::Err(msg);
                                                }
                                            }
                                        }
                                        OptStmts::None => {
                                        }
                                    }
                                }
                            }
                            _ => {
                                return ResultExpr::Err("comptime if condition must be boolean");
                            }
                        }
                    }
                }
            }
            Stmt::While(wcond, wbody, _) => {
                // at most 10 million iterations: a comptime loop that does
                // not end is an error, not a hang
                var hops: i64 = 0;
                var going: bool = true;
                while going {
                    var wc: ResultExpr = evaluate_with_env(wcond, &local_env, original);
                    match wc {
                        ResultExpr::Err(wm) => {
                            return ResultExpr::Err(wm);
                        }
                        ResultExpr::Ok(wv) => {
                            match wv {
                                Expr::BoolLit(wb) => {
                                    going = wb;
                                }
                                _ => {
                                    return ResultExpr::Err("comptime while condition must be boolean");
                                }
                            }
                        }
                    }
                    if going {
                        hops = hops + 1;
                        if hops > 10000000 {
                            return ResultExpr::Err("comptime while loop ran 10 million times");
                        }
                        var wr: ResultExpr = evaluate_block_rt(wbody, original, &mut local_env, returned);
                        var wflow: i64 = ce_loop_flow(returned);
                        if wflow == CE_FLOW_BREAK {
                            going = false;
                        } else if wflow == CE_FLOW_RETURN {
                            ce_write_back(env, &local_env, n_outer);
                            return wr;
                        }
                        match wr {
                            ResultExpr::Ok(_) => {
                            }
                            ResultExpr::Err(wem) => {
                                return ResultExpr::Err(wem);
                            }
                        }
                    }
                }
            }
            Stmt::For(loop_var, iterator, body, _) => {
                var iter_v: ResultExpr = evaluate_with_env(iterator, &local_env, original);
                match iter_v {
                    ResultExpr::Err(msg) => {
                        return ResultExpr::Err(msg);
                    }
                    ResultExpr::Ok(iv) => {
                        match iv {
                            Expr::Range(start_box, end_box, _) => {
                                var start_e: Expr = ct_box_expr_unbox(start_box);
                                var end_e: Expr = ct_box_expr_unbox(end_box);
                                var sr: ResultExpr = evaluate_with_env(&start_e, &local_env, original);
                                var er: ResultExpr = evaluate_with_env(&end_e, &local_env, original);
                                match sr {
                                    ResultExpr::Err(msg) => {
                                        return ResultExpr::Err(msg);
                                    }
                                    ResultExpr::Ok(s) => {
                                        match er {
                                            ResultExpr::Err(msg) => {
                                                return ResultExpr::Err(msg);
                                            }
                                            ResultExpr::Ok(e) => {
                                                match ct_untag(s) {
                                                    Expr::IntLit(a) => {
                                                        match ct_untag(e) {
                                                            Expr::IntLit(b) => {
                                                                var i: i64 = a;
                                                                while i < b {
                                                                    ComptimeEnv_declare(&mut local_env, loop_var, Expr::IntLit(i), n_outer);
                                                                    var br: ResultExpr = evaluate_block_rt(body, original, &mut local_env, returned);
                                                                    var fflow: i64 = ce_loop_flow(returned);
                                                                    if fflow == CE_FLOW_BREAK {
                                                                        break;
                                                                    } else if fflow == CE_FLOW_RETURN {
                                                                        ce_write_back(env, &local_env, n_outer);
                                                                        return br;
                                                                    }
                                                                    match br {
                                                                        ResultExpr::Ok(v) => {
                                                                            result = v;
                                                                        }
                                                                        ResultExpr::Err(msg) => {
                                                                            return ResultExpr::Err(msg);
                                                                        }
                                                                    }
                                                                    i = i + 1;
                                                                }
                                                            }
                                                            _ => {
                                                                return ResultExpr::Err("comptime for range must be ints");
                                                            }
                                                        }
                                                    }
                                                    _ => {
                                                        return ResultExpr::Err("comptime for range must be ints");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            _ => {
                                return ResultExpr::Err("comptime for requires a range");
                            }
                        }
                    }
                }
            }
            Stmt::Loop(lbody, _) => {
                // `loop { ... }` ends by break or return; the same 10 million
                // iteration guard as `while`
                var lguard: i64 = 0;
                var lgoing: bool = true;
                while lgoing {
                    lguard = lguard + 1;
                    if lguard > 10000000 {
                        return ResultExpr::Err("comptime loop ran 10 million times");
                    }
                    var lr: ResultExpr = evaluate_block_rt(lbody, original, &mut local_env, returned);
                    var lflow: i64 = ce_loop_flow(returned);
                    if lflow == CE_FLOW_BREAK {
                        lgoing = false;
                    } else if lflow == CE_FLOW_RETURN {
                        ce_write_back(env, &local_env, n_outer);
                        return lr;
                    }
                    match lr {
                        ResultExpr::Ok(_) => {
                        }
                        ResultExpr::Err(lem) => {
                            return ResultExpr::Err(lem);
                        }
                    }
                }
            }
            Stmt::Break(_, _) => {
                // the innermost loop stops (ce_loop_flow); this block and
                // the ones up to the loop end here, keeping their assignments
                returned.push(CE_FLOW_BREAK);
                ce_write_back(env, &local_env, n_outer);
                return ResultExpr::Ok(result);
            }
            Stmt::Continue(_) => {
                returned.push(CE_FLOW_CONTINUE);
                ce_write_back(env, &local_env, n_outer);
                return ResultExpr::Ok(result);
            }
            _ => {
                // A statement the evaluator does not run (match, field or
                // index assignment, defer, ...) was skipped, so the value
                // came out wrong without a word. An error leaves the call
                // to run with the program, which computes it right.
                return ResultExpr::Err("this statement is not evaluated at compile time (comptime runs let, var, assignment, if, while, for, loop, break, continue, return and expression statements)");
            }
        }
        si = si + 1;
    }
    // The variables of the enclosing blocks get what this block assigned
    // them (the copy's buffers are not shared with `env` under copy-on-
    // write, so a `while` body's `i = i + 1` was lost: an endless loop)
    ce_write_back(env, &local_env, n_outer);
    return ResultExpr::Ok(result);
}

// How a comptime block ended, kept on the `returned` stack of
// evaluate_block_rt: a `return` (the function's value is ready), or a
// `break` / `continue` for the innermost loop.
const CE_FLOW_RETURN: i64 = 1;
const CE_FLOW_BREAK: i64 = 2;
const CE_FLOW_CONTINUE: i64 = 3;

/// After a loop body ran: 0 (go on), CE_FLOW_BREAK (stop the loop) or
/// CE_FLOW_RETURN (leave the function). A break or continue is the loop's
/// own and is taken off the stack; a return stays for the caller.
fn ce_loop_flow(returned: &mut Vec<i64>) -> i64 {
    if returned.len() == 0 {
        return 0;
    }
    var code: i64 = returned.get(returned.len() - 1);
    if code == CE_FLOW_BREAK {
        returned.pop();
        return CE_FLOW_BREAK;
    }
    if code == CE_FLOW_CONTINUE {
        returned.pop();
        return 0;
    }
    return CE_FLOW_RETURN;
}

/// The variables of the enclosing blocks (the first `n_outer` of `local`)
/// get the values this block gave them.
fn ce_write_back(env: &mut ComptimeEnv, local: &ComptimeEnv, n_outer: i64) {
    var wk: i64 = 0;
    while wk < n_outer {
        env.values.set(wk, local.values.get(wk));
        wk = wk + 1;
    }
}

fn evaluate_with_env(expr: &Expr, env: &ComptimeEnv, original: &Program) -> ResultExpr {
    if !ct_fuel_left() {
        return ct_out_of_fuel();
    }
    match expr {
        Expr::Ident(name) => {
            var v: OptExpr = ComptimeEnv_get(env, name);
            match v {
                OptExpr::Some(v) => {
                    return ResultExpr::Ok(v);
                }
                OptExpr::None => {
                    // Not a local: a const of the program is comptime-known
                    var ci: i64 = ct_find_const(original, name);
                    if ci >= 0 {
                        return ct_const_value(ci, original);
                    }
                    return ResultExpr::Err("undefined variable '" + name + "' in comptime");
                }
            }
        }
        Expr::IntLit(n) => {
            return ResultExpr::Ok(Expr::IntLit(n));
        }
        Expr::FloatLit(f) => {
            return ResultExpr::Ok(Expr::FloatLit(f));
        }
        Expr::StringLit(s) => {
            return ResultExpr::Ok(Expr::StringLit(s));
        }
        Expr::BoolLit(b) => {
            return ResultExpr::Ok(Expr::BoolLit(b));
        }
        Expr::Binary(op, left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            var lr: ResultExpr = evaluate_with_env(&l, env, original);
            match lr {
                ResultExpr::Err(msg) => {
                    return ResultExpr::Err(msg);
                }
                ResultExpr::Ok(lv) => {
                    // `&&` / `||` stop at the left side as the program does
                    // (`i < v.len() && v.get(i) == x` reads no element past
                    // the end).
                    match lv {
                        Expr::BoolLit(lb) => {
                            match op {
                                BinOp::And => {
                                    if !lb {
                                        return ResultExpr::Ok(Expr::BoolLit(false));
                                    }
                                }
                                BinOp::Or => {
                                    if lb {
                                        return ResultExpr::Ok(Expr::BoolLit(true));
                                    }
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    var rr: ResultExpr = evaluate_with_env(&r, env, original);
                    match rr {
                        ResultExpr::Err(msg) => {
                            return ResultExpr::Err(msg);
                        }
                        ResultExpr::Ok(rv) => {
                            return eval_binop(op, lv, rv);
                        }
                    }
                }
            }
        }
        Expr::Unary(op, inner) => {
            var e: Expr = ct_box_expr_unbox(inner);
            var vr: ResultExpr = evaluate_with_env(&e, env, original);
            match vr {
                ResultExpr::Err(msg) => {
                    return ResultExpr::Err(msg);
                }
                ResultExpr::Ok(v) => {
                    return eval_unaryop(op, v);
                }
            }
        }
        Expr::MethodCall(mrecv, mname, margs) => {
            var rcv: Expr = ct_box_expr_unbox(mrecv);
            // Vec::new() / Vec::with_capacity(n): an empty comptime table
            match rcv {
                Expr::Ident(rn) => {
                    if rn == "Vec" && (mname == "new" || mname == "with_capacity") {
                        return ResultExpr::Ok(ct_vec_of(Type::I64, Vec::new()));
                    }
                }
                _ => {
                }
            }
            var rv: ResultExpr = evaluate_with_env(&rcv, env, original);
            match rv {
                ResultExpr::Err(m) => {
                    return ResultExpr::Err(m);
                }
                ResultExpr::Ok(recv_v) => {
                    var els: Vec<Expr> = Vec::new();
                    if ct_vec_elems(recv_v, &mut els) {
                        if mname == "len" {
                            return ResultExpr::Ok(Expr::IntLit(els.len()));
                        }
                        if mname == "is_empty" {
                            return ResultExpr::Ok(Expr::BoolLit(els.len() == 0));
                        }
                        if mname == "get" && margs.len() == 1 {
                            var gi: Expr = margs.get(0);
                            match evaluate_with_env(&gi, env, original) {
                                ResultExpr::Ok(iv) => {
                                    match ct_untag(iv) {
                                        Expr::IntLit(ix) => {
                                            if ix >= 0 && ix < els.len() {
                                                return ResultExpr::Ok(els.get(ix));
                                            }
                                            return ResultExpr::Err("comptime Vec index " + int_to_str(ix) + " out of bounds");
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                ResultExpr::Err(m2) => {
                                    return ResultExpr::Err(m2);
                                }
                            }
                        }
                    }
                }
            }
            return ResultExpr::Err("method '" + mname + "' is not evaluated at compile time");
        }
        Expr::Call(callee, args) => {
            if callee == "Vec_new" && args.len() == 0 {
                return ResultExpr::Ok(ct_vec_of(Type::I64, Vec::new()));
            }
            if callee == "gensym" && !ct_has_comptime_fn(original, callee) {
                var gs_args: Vec<Expr> = Vec::new();
                var gai: i64 = 0;
                while gai < args.len() {
                    var gae: Expr = args.get(gai);
                    match evaluate_with_env(&gae, env, original) {
                        ResultExpr::Err(gm) => {
                            return ResultExpr::Err(gm);
                        }
                        ResultExpr::Ok(gv) => {
                            gs_args.push(gv);
                        }
                    }
                    gai = gai + 1;
                }
                return ct_gensym_call(gs_args, original);
            }
            var func_idx: i64 = -1;
            var fi: i64 = 0;
            while fi < original.funcs.len() {
                var f: Func = original.funcs.get(fi);
                if f.name == callee && f.is_comptime {
                    func_idx = fi;
                }
                fi = fi + 1;
            }

            // §4.11 reflection over annotations: the names on a struct
            // (struct_annotations) or one of its fields
            // (field_annotations), so compile-time code can act on the
            // safety annotations (@secret, @zeroize, ...) a declaration
            // carries — type arguments come as strings (type_name(T)
            // composes inside a comptime T: type function).
            if callee == "target_os" || callee == "target_arch" || callee == "build_debug" || callee == "feature_enabled" || callee == "field_annotations" || callee == "struct_annotations" || callee == "field_names_of" || callee == "field_count_of" {
                var fa_args: Vec<Expr> = Vec::new();
                var fai: i64 = 0;
                while fai < args.len() {
                    var fa_e: Expr = args.get(fai);
                    match evaluate_with_env(&fa_e, env, original) {
                        ResultExpr::Err(fam) => {
                            return ResultExpr::Err(fam);
                        }
                        ResultExpr::Ok(fav) => {
                            fa_args.push(fav);
                        }
                    }
                    fai = fai + 1;
                }
                return ct_annotations_call(callee, fa_args, original);
            }
            // §4.11: embed("path") reads a file of the project while
            // compiling (its bytes a comptime Vec<i64>): the one file
            // read comptime code may do, relative to the source's
            // directory and never leaving it
            if callee == "embed" {
                var em_args: Vec<Expr> = Vec::new();
                var emi: i64 = 0;
                while emi < args.len() {
                    var em_e: Expr = args.get(emi);
                    match evaluate_with_env(&em_e, env, original) {
                        ResultExpr::Err(emm) => {
                            return ResultExpr::Err(emm);
                        }
                        ResultExpr::Ok(emv) => {
                            em_args.push(emv);
                        }
                    }
                    emi = emi + 1;
                }
                return ct_embed_call(em_args);
            }
            if callee == "compile_error" {
                var ce_args: Vec<Expr> = Vec::new();
                var cei: i64 = 0;
                while cei < args.len() {
                    var ce_e: Expr = args.get(cei);
                    match evaluate_with_env(&ce_e, env, original) {
                        ResultExpr::Err(cem) => {
                            return ResultExpr::Err(cem);
                        }
                        ResultExpr::Ok(cev) => {
                            ce_args.push(cev);
                        }
                    }
                    cei = cei + 1;
                }
                if ce_args.len() == 1 {
                    match ce_args.get(0) {
                        Expr::StringLit(m) => {
                            return ResultExpr::Err("compile error: " + m + ct_trace());
                        }
                        _ => {
                        }
                    }
                }
                return ResultExpr::Err("compile_error takes one string, the message");
            }
            if callee == "comptime_assert" {
                var ca_args: Vec<Expr> = Vec::new();
                var cai: i64 = 0;
                while cai < args.len() {
                    var ca_e: Expr = args.get(cai);
                    match evaluate_with_env(&ca_e, env, original) {
                        ResultExpr::Err(cam) => {
                            return ResultExpr::Err(cam);
                        }
                        ResultExpr::Ok(cav) => {
                            ca_args.push(cav);
                        }
                    }
                    cai = cai + 1;
                }
                var ca_msg: str = "(no message)";
                if ca_args.len() == 2 {
                    match ca_args.get(1) {
                        Expr::StringLit(mm) => {
                            ca_msg = mm;
                        }
                        _ => {
                        }
                    }
                }
                if ca_args.len() >= 1 {
                    match ca_args.get(0) {
                        Expr::BoolLit(cb) => {
                            if cb {
                                return ResultExpr::Ok(Expr::BoolLit(true));
                            }
                            return ResultExpr::Err("comptime assert failed: " + ca_msg + ct_trace());
                        }
                        _ => {
                            return ResultExpr::Err("comptime_assert takes a bool the evaluator can compute");
                        }
                    }
                }
                return ResultExpr::Err("comptime_assert takes a bool and an optional message");
            }
            if func_idx < 0 {
                if ct_io_builtin(callee) {
                    return ResultExpr::Err("'" + callee + "()' does I/O, and comptime code runs inside the compiler with no I/O (files, network, processes, the console, the clock or the environment)");
                }
                if ct_pure_builtin(callee) {
                    var pb_args: Vec<Expr> = Vec::new();
                    var pbi: i64 = 0;
                    while pbi < args.len() {
                        var pbe: Expr = args.get(pbi);
                        match evaluate_with_env(&pbe, env, original) {
                            ResultExpr::Err(pm) => {
                                return ResultExpr::Err(pm);
                            }
                            ResultExpr::Ok(pv) => {
                                pb_args.push(pv);
                            }
                        }
                        pbi = pbi + 1;
                    }
                    return ct_pure_call(callee, pb_args);
                }
                func_idx = ct_plain_fn(original, callee);
            }
            if func_idx < 0 {
                return ResultExpr::Err("comptime function '" + callee + "' not found");
            }
            var func: Func = original.funcs.get(func_idx);
            var arg_values: Vec<Expr> = Vec::new();
            var ai: i64 = 0;
            while ai < args.len() {
                var a: Expr = args.get(ai);
                var ar: ResultExpr = evaluate_with_env(&a, env, original);
                match ar {
                    ResultExpr::Err(msg) => {
                        return ResultExpr::Err(msg);
                    }
                    ResultExpr::Ok(v) => {
                        arg_values.push(v);
                    }
                }
                ai = ai + 1;
            }
            return call_comptime_func(func, arg_values, original);
        }
        Expr::If(cond, then_block, else_block) => {
            var cr: ResultExpr = evaluate_with_env(cond, env, original);
            match cr {
                ResultExpr::Err(msg) => {
                    return ResultExpr::Err(msg);
                }
                ResultExpr::Ok(c) => {
                    match c {
                        Expr::BoolLit(b) => {
                            if b {
                                return evaluate_block_with_env(then_block, original, env);
                            } else {
                                match else_block {
                                    OptStmts::Some(eb) => {
                                        return evaluate_block_with_env(eb, original, env);
                                    }
                                    OptStmts::None => {
                                        return ResultExpr::Ok(Expr::IntLit(0));
                                    }
                                }
                            }
                        }
                        _ => {
                            return ResultExpr::Err("comptime if condition must be boolean");
                        }
                    }
                }
            }
        }
        Expr::Block(stmts) => {
            return evaluate_block_with_env(stmts, original, env);
        }
        Expr::StrConcat(left, right) => {
            var l: Expr = ct_box_expr_unbox(left);
            var r: Expr = ct_box_expr_unbox(right);
            var lr: ResultExpr = evaluate_with_env(&l, env, original);
            match lr {
                ResultExpr::Err(msg) => {
                    return ResultExpr::Err(msg);
                }
                ResultExpr::Ok(lv) => {
                    var rr: ResultExpr = evaluate_with_env(&r, env, original);
                    match rr {
                        ResultExpr::Err(msg) => {
                            return ResultExpr::Err(msg);
                        }
                        ResultExpr::Ok(rv) => {
                            match lv {
                                Expr::StringLit(a) => {
                                    match rv {
                                        Expr::StringLit(b) => {
                                            return ResultExpr::Ok(Expr::StringLit(a + b));
                                        }
                                        _ => {
                                            return ResultExpr::Err("comptime str_concat requires strings");
                                        }
                                    }
                                }
                                _ => {
                                    return ResultExpr::Err("comptime str_concat requires strings");
                                }
                            }
                        }
                    }
                }
            }
        }
        Expr::Index(iarr, iidx) => {
            // Array indexing at comptime (field_names[i] etc.).
            var ae: Expr = ct_box_expr_unbox(iarr);
            var ie: Expr = ct_box_expr_unbox(iidx);
            var ar: ResultExpr = evaluate_with_env(&ae, env, original);
            var ir: ResultExpr = evaluate_with_env(&ie, env, original);
            match ar {
                ResultExpr::Ok(av) => {
                    match ir {
                        ResultExpr::Ok(iv) => {
                            match av {
                                Expr::ArrayLit(_, elements) => {
                                    match ct_untag(iv) {
                                        Expr::IntLit(ix) => {
                                            if ix >= 0 && ix < elements.len() {
                                                return ResultExpr::Ok(elements.get(ix));
                                            }
                                            return ResultExpr::Err("comptime index " + int_to_str(ix) + " out of bounds");
                                        }
                                        _ => {
                                        }
                                    }
                                }
                                _ => {
                                }
                            }
                            return ResultExpr::Err("comptime indexing requires array and int");
                        }
                        ResultExpr::Err(m) => {
                            return ResultExpr::Err(m);
                        }
                    }
                }
                ResultExpr::Err(m) => {
                    return ResultExpr::Err(m);
                }
            }
        }
        Expr::FString(parts) => {
            var result: str = "";
            var pi: i64 = 0;
            while pi < parts.len() {
                var part: FStringPart = parts.get(pi);
                match part {
                    FStringPart::Literal(s) => {
                        result = result + s;
                    }
                    FStringPart::Expr(e) => {
                        var vr: ResultExpr = evaluate_with_env(&e, env, original);
                        match vr {
                            ResultExpr::Ok(v) => {
                                var is_uv: bool = false;
                                match ct_untag_type(v) {
                                    OptType::Some(_) => {
                                        var uv2: u64 = ct_int_untag(v) as u64;
                                        result = result + u64_to_str(uv2);
                                        is_uv = true;
                                    }
                                    OptType::None => {
                                    }
                                }
                                if is_uv {
                                    pi = pi + 1;
                                    continue;
                                }
                                match v {
                                    Expr::IntLit(n) => {
                                        result = result + int_to_str(n);
                                    }
                                    Expr::FloatLit(f) => {
                                        result = result + float_to_str(f);
                                    }
                                    Expr::StringLit(s) => {
                                        result = result + s;
                                    }
                                    Expr::BoolLit(b) => {
                                        if b {
                                            result = result + "true";
                                        } else {
                                            result = result + "false";
                                        }
                                    }
                                    _ => {
                                        result = result + "?";
                                    }
                                }
                            }
                            ResultExpr::Err(msg) => {
                                return ResultExpr::Err(msg);
                            }
                        }
                    }
                }
                pi = pi + 1;
            }
            return ResultExpr::Ok(Expr::StringLit(result));
        }
        Expr::Cast(ic, cty) => {
            // `x as T` on a comptime integer: unsigned targets tag the value,
            // signed ones narrow it (BG62)
            var ice: Expr = ct_box_expr_unbox(ic);
            var cr: ResultExpr = evaluate_with_env(&ice, env, original);
            match cr {
                ResultExpr::Err(msg) => {
                    return ResultExpr::Err(msg);
                }
                ResultExpr::Ok(cv) => {
                    var iv: i64 = 0;
                    var is_int: bool = false;
                    match cv {
                        Expr::IntLit(n) => {
                            iv = n;
                            is_int = true;
                        }
                        _ => {
                            match ct_untag_type(cv) {
                                OptType::Some(_) => {
                                    iv = ct_int_untag(cv);
                                    is_int = true;
                                }
                                OptType::None => {
                                }
                            }
                        }
                    }
                    if !is_int {
                        // A float value (BG212): to a float it is itself; to
                        // an integer it is truncated toward zero, as at run
                        // time, and must be in range
                        match cv {
                            Expr::FloatLit(fv) => {
                                if ct_unsigned_ty(cty) || ct_signed_ty(cty) {
                                    if fv != fv || fv >= 9223372036854775808.0 || fv < -9223372036854775808.0 {
                                        return ResultExpr::Err("comptime cast: " + float_to_str(fv) + " does not fit in " + type_to_str(cty));
                                    }
                                    var fvi: i64 = fv as i64;
                                    if ct_unsigned_ty(cty) {
                                        if fvi < 0 {
                                            return ResultExpr::Err("comptime cast: " + float_to_str(fv) + " does not fit in " + type_to_str(cty));
                                        }
                                        return ResultExpr::Ok(ct_tag(Expr::IntLit(fvi), cty));
                                    }
                                    return ResultExpr::Ok(Expr::IntLit(ct_sext(fvi, ct_int_width(cty))));
                                }
                                if ct_float_ty(cty) {
                                    return ResultExpr::Ok(Expr::FloatLit(fv));
                                }
                            }
                            _ => {
                            }
                        }
                        return ResultExpr::Ok(Expr::Cast(Box::new(cv), cty));
                    }
                    if ct_unsigned_ty(cty) {
                        return ResultExpr::Ok(ct_tag(Expr::IntLit(iv), cty));
                    }
                    if ct_signed_ty(cty) {
                        return ResultExpr::Ok(Expr::IntLit(ct_sext(iv, ct_int_width(cty))));
                    }
                    // an integer to a float (BG212)
                    if ct_float_ty(cty) {
                        return ResultExpr::Ok(Expr::FloatLit(iv as f64));
                    }
                    return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(iv)), cty));
                }
            }
        }
        _ => {
            return evaluate(expr, original);
        }
    }
    return ResultExpr::Ok(Expr::IntLit(0));
}

// --- Comptime memoization --------------------------------------------------
// A comptime fn called again with the same literal arguments returns the
// cached value: the substitution phases iterate, and generated code asks
// the same questions per instantiation (a serializer over every field of
// every type). Keyed on the function and its argument values — all a
// comptime fn can read besides consts, which one pass never changes.
// A body that calls gensym() is never memoized (its value is fresh per
// call), and the cache empties with each pass's other state.
var g_ct_memo_keys: Vec<str> = Vec::new();
var g_ct_memo_vals: Vec<Expr> = Vec::new();

/// "" when the arguments are not memoizable literals.
fn ct_memo_key(func: Func, args: &Vec<Expr>) -> str {
    var k: str = func.name;
    var i: i64 = 0;
    while i < args.len() {
        k = k + "|";
        match args.get(i) {
            Expr::IntLit(n) => {
                k = k + "i" + int_to_str(n);
            }
            Expr::Cast(_, _) => {
                match ct_untag_type(args.get(i)) {
                    OptType::Some(t2) => {
                        k = k + "u" + int_to_str(ct_int_width(t2)) + ":" + u64_to_str(ct_int_untag(args.get(i)) as u64);
                    }
                    OptType::None => {
                        return "";
                    }
                }
            }
            Expr::BoolLit(b) => {
                if b {
                    k = k + "b1";
                } else {
                    k = k + "b0";
                }
            }
            Expr::StringLit(sv) => {
                k = k + "s" + int_to_str(str_len(sv)) + ":" + sv;
            }
            _ => {
                return "";
            }
        }
        i = i + 1;
    }
    return k;
}

fn ct_memo_get(key: str) -> OptExpr {
    var i: i64 = 0;
    while i < g_ct_memo_keys.len() {
        if g_ct_memo_keys.get(i) == key {
            return OptExpr::Some(g_ct_memo_vals.get(i));
        }
        i = i + 1;
    }
    return OptExpr::None;
}

/// Whether any statement calls gensym() (directly or in a nested block):
/// such a function's value is fresh per call and is never cached.
fn ct_stmts_use_gensym(stmts: Vec<Stmt>) -> bool {
    var i: i64 = 0;
    while i < stmts.len() {
        if ct_stmt_uses_gensym(stmts.get(i)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn ct_expr_uses_gensym(e: Expr) -> bool {
    match e {
        Expr::Call(cn, cargs) => {
            if cn == "gensym" {
                return true;
            }
            var i: i64 = 0;
            while i < cargs.len() {
                if ct_expr_uses_gensym(cargs.get(i)) {
                    return true;
                }
                i = i + 1;
            }
        }
        Expr::MethodCall(r, _, margs) => {
            if ct_expr_uses_gensym(ct_box_expr_unbox(r)) {
                return true;
            }
            var j: i64 = 0;
            while j < margs.len() {
                if ct_expr_uses_gensym(margs.get(j)) {
                    return true;
                }
                j = j + 1;
            }
        }
        Expr::Binary(_, l, r2) => {
            return ct_expr_uses_gensym(ct_box_expr_unbox(l)) || ct_expr_uses_gensym(ct_box_expr_unbox(r2));
        }
        Expr::Unary(_, inner) => {
            return ct_expr_uses_gensym(ct_box_expr_unbox(inner));
        }
        Expr::Block(bs) => {
            return ct_stmts_use_gensym(bs);
        }
        _ => {
        }
    }
    return false;
}

fn ct_stmt_uses_gensym(stmt: Stmt) -> bool {
    match stmt {
        Stmt::Let(_, _, e, _, _, _, _) => {
            return ct_expr_uses_gensym(e);
        }
        Stmt::Assign(_, _, e, _) => {
            return ct_expr_uses_gensym(e);
        }
        Stmt::Expr(e2, _) => {
            return ct_expr_uses_gensym(e2);
        }
        Stmt::Return(opt, _) => {
            match opt {
                OptBoxExpr::Some(e3) => {
                    return ct_expr_uses_gensym(ct_box_expr_unbox(e3));
                }
                OptBoxExpr::None => {
                }
            }
        }
        Stmt::If(c, t, eb, _) => {
            if ct_expr_uses_gensym(c) || ct_stmts_use_gensym(t) {
                return true;
            }
            match eb {
                OptStmts::Some(ebs) => {
                    return ct_stmts_use_gensym(ebs);
                }
                OptStmts::None => {
                }
            }
        }
        Stmt::While(c2, b, _) => {
            return ct_expr_uses_gensym(c2) || ct_stmts_use_gensym(b);
        }
        Stmt::For(_, it, b2, _) => {
            return ct_expr_uses_gensym(it) || ct_stmts_use_gensym(b2);
        }
        _ => {
        }
    }
    return false;
}

fn call_comptime_func(func: Func, args: Vec<Expr>, original: &Program) -> ResultExpr {
    if args.len() != func.params.len() {
        return ResultExpr::Err("comptime function '" + func.name + "' expects " + int_to_str(func.params.len()) + " args, got " + int_to_str(args.len()));
    }
    var env: ComptimeEnv = ComptimeEnv_new();
    var i: i64 = 0;
    while i < args.len() {
        // A parameter declared unsigned tags the argument's value (BG62)
        var pv: Expr = args.get(i);
        var pty: Type = func.params.get(i).ty;
        if ct_unsigned_ty(pty) {
            pv = ct_tag(pv, pty);
        }
        ComptimeEnv_set(&mut env, func.params.get(i).name, pv);
        i = i + 1;
    }
    // The body runs in the block evaluator, with all its statements (let,
    // assignment, if, for, while, return, table updates) -- OP28. It had a
    // smaller interpreter of its own (no while, no `t.push`), so a table
    // built in a loop was left to run when the program did.
    var returned: Vec<i64> = Vec::new();
    if g_ct_call_depth >= 400 {
        return ResultExpr::Err("comptime calls nest deeper than 400 (through '" + func.name + "')");
    }
    // The memo: same function, same literal arguments, value already known
    var mkey: str = "";
    if !ct_stmts_use_gensym(func.body) {
        mkey = ct_memo_key(func, &args);
        if str_len(mkey) > 0 {
            match ct_memo_get(mkey) {
                OptExpr::Some(mv) => {
                    return ResultExpr::Ok(mv);
                }
                OptExpr::None => {
                }
            }
        }
    }
    if !ct_fuel_left() {
        return ct_out_of_fuel();
    }
    g_ct_call_depth = g_ct_call_depth + 1;
    g_ct_call_stack.push("in comptime fn '" + func.name + "' (defined at line " + int_to_str(func.line) + ")");
    val cres: ResultExpr = evaluate_block_rt(func.body, original, &mut env, &mut returned);
    g_ct_call_depth = g_ct_call_depth - 1;
    // The frame is popped only on success: on an error it stays, so the
    // trace of the boundary error shows the whole failing chain (the
    // boundary clears the stack before the next evaluation).
    match cres {
        ResultExpr::Ok(mv) => {
            g_ct_call_stack.pop();
            if str_len(mkey) > 0 && g_ct_memo_keys.len() < 4096 {
                g_ct_memo_keys.push(mkey);
                g_ct_memo_vals.push(mv);
            }
        }
        ResultExpr::Err(_) => {
        }
    }
    return cres;
}

/// New value of `target` after `target op= v` (src/comptime.rs).
fn ce_assign(env: &ComptimeEnv, target: str, op: AssignOp, v: Expr) -> ResultExpr {
    var current: Expr = Expr::IntLit(0);
    match ComptimeEnv_get(env, target) {
        OptExpr::Some(c) => {
            current = c;
        }
        OptExpr::None => {
        }
    }
    match op {
        AssignOp::Assign => {
            return ResultExpr::Ok(v);
        }
        AssignOp::AddAssign => {
            return eval_binop(BinOp::Add, current, v);
        }
        AssignOp::SubAssign => {
            return eval_binop(BinOp::Sub, current, v);
        }
        AssignOp::MulAssign => {
            return eval_binop(BinOp::Mul, current, v);
        }
        AssignOp::DivAssign => {
            return eval_binop(BinOp::Div, current, v);
        }
        AssignOp::ModAssign => {
            return eval_binop(BinOp::Mod, current, v);
        }
        AssignOp::BitAndAssign => {
            return eval_binop(BinOp::BitAnd, current, v);
        }
        AssignOp::BitOrAssign => {
            return eval_binop(BinOp::BitOr, current, v);
        }
        AssignOp::BitXorAssign => {
            return eval_binop(BinOp::BitXor, current, v);
        }
        AssignOp::ShlAssign => {
            return eval_binop(BinOp::Shl, current, v);
        }
        AssignOp::ShrAssign => {
            return eval_binop(BinOp::Shr, current, v);
        }
    }
    return ResultExpr::Ok(v);
}

// --- Binary/unary operation evuation -----------------------------------

// Checked comptime arithmetic: overflow is an error with the operands in
// the message, never a silently wrapped value -- a table computed wrong is
// worse than a failed build. What does not fit i64 does not compute (the
// one exception kept is i64::MIN itself, from -2^63 or MIN * 1; a product
// of exactly 2^63 from other factors is rejected too).
fn ct_ovf(expr: str) -> ResultExpr {
    return ResultExpr::Err("comptime arithmetic overflow: " + expr + " does not fit in i64");
}

fn ct_add_checked(a: i64, b: i64) -> ResultExpr {
    var lim: i64 = 9223372036854775807;
    if b > 0 && a > lim - b {
        return ct_ovf(int_to_str(a) + " + " + int_to_str(b));
    }
    if b < 0 && a < (0 - lim - 1) - b {
        return ct_ovf(int_to_str(a) + " + " + int_to_str(b));
    }
    return ResultExpr::Ok(Expr::IntLit(a + b));
}

fn ct_sub_checked(a: i64, b: i64) -> ResultExpr {
    var lim: i64 = 9223372036854775807;
    if b < 0 && a > lim + b {
        return ct_ovf(int_to_str(a) + " - " + int_to_str(b));
    }
    if b > 0 && a < (0 - lim - 1) + b {
        return ct_ovf(int_to_str(a) + " - " + int_to_str(b));
    }
    return ResultExpr::Ok(Expr::IntLit(a - b));
}

fn ct_mul_checked(a: i64, b: i64) -> ResultExpr {
    var lim: i64 = 9223372036854775807;
    var min: i64 = 0 - lim - 1;
    if a == 0 || b == 0 {
        return ResultExpr::Ok(Expr::IntLit(0));
    }
    if a == min || b == min {
        if a == min && b == 1 {
            return ResultExpr::Ok(Expr::IntLit(min));
        }
        if b == min && a == 1 {
            return ResultExpr::Ok(Expr::IntLit(min));
        }
        return ct_ovf(int_to_str(a) + " * " + int_to_str(b));
    }
    var ua: i64 = a;
    if ua < 0 {
        ua = 0 - ua;
    }
    var ub: i64 = b;
    if ub < 0 {
        ub = 0 - ub;
    }
    if ua > lim / ub {
        return ct_ovf(int_to_str(a) + " * " + int_to_str(b));
    }
    return ResultExpr::Ok(Expr::IntLit(a * b));
}

/// The comptime shift rules: the amount must be 0..63, and a left shift
/// that drops bits (or the sign) is an overflow.
fn ct_shift_amount(b: i64) -> ResultExpr {
    if b < 0 || b > 63 {
        return ResultExpr::Err("comptime shift by " + int_to_str(b) + ": the amount must be 0..63");
    }
    return ResultExpr::Ok(Expr::IntLit(0));
}

/// `l op r` where one side is a tagged unsigned value: the operation
/// unsigned at the tag's width, its result tagged again (BG62).
/// @wrapping: the unsigned arithmetic is meant to wrap at 64 bits so the
/// width checks below can see what the machine would have produced.
@wrapping
fn ct_eval_uint_binop(op: BinOp, a: i64, b: i64, ty: Type) -> ResultExpr {
    var ua: u64 = a as u64;
    var ub: u64 = b as u64;
    var w: i64 = ct_int_width(ty);
    var mask: i64 = ct_width_mask(w);
    var um: u64 = mask as u64;
    var ur: u64 = 0;
    match op {
        BinOp::Add => {
            ur = (ua + ub) & um;
            if ur < ua || ur > um {
                return ct_ovf(u64_to_str(ua) + " + " + u64_to_str(ub));
            }
            return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(ur as i64)), ty));
        }
        BinOp::Sub => {
            if ua < ub {
                return ct_ovf(u64_to_str(ua) + " - " + u64_to_str(ub));
            }
            return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(((ua - ub) & um) as i64)), ty));
        }
        BinOp::Mul => {
            ur = (ua * ub) & um;
            if ua != 0 && (ur / ua) != (ub & um) {
                return ct_ovf(u64_to_str(ua) + " * " + u64_to_str(ub));
            }
            return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(ur as i64)), ty));
        }
        BinOp::Div => {
            if ub == 0 {
                return ResultExpr::Err("division by zero in comptime");
            }
            return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(((ua / ub) & um) as i64)), ty));
        }
        BinOp::Mod => {
            if ub == 0 {
                return ResultExpr::Err("modulo by zero in comptime");
            }
            return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(((ua % ub) & um) as i64)), ty));
        }
        BinOp::Eq => {
            return ResultExpr::Ok(Expr::BoolLit(a == b));
        }
        BinOp::Neq => {
            return ResultExpr::Ok(Expr::BoolLit(a != b));
        }
        BinOp::Lt => {
            return ResultExpr::Ok(Expr::BoolLit((ua & um) < (ub & um)));
        }
        BinOp::LtEq => {
            return ResultExpr::Ok(Expr::BoolLit((ua & um) <= (ub & um)));
        }
        BinOp::Gt => {
            return ResultExpr::Ok(Expr::BoolLit((ua & um) > (ub & um)));
        }
        BinOp::GtEq => {
            return ResultExpr::Ok(Expr::BoolLit((ua & um) >= (ub & um)));
        }
        BinOp::And => {
            return ResultExpr::Ok(Expr::BoolLit(a != 0 && b != 0));
        }
        BinOp::Or => {
            return ResultExpr::Ok(Expr::BoolLit(a != 0 || b != 0));
        }
        BinOp::BitAnd => {
            return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(((ua & ub) & um) as i64)), ty));
        }
        BinOp::BitOr => {
            return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(((ua | ub) & um) as i64)), ty));
        }
        BinOp::BitXor => {
            return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(((ua ^ ub) & um) as i64)), ty));
        }
        BinOp::Shl => {
            match ct_shift_amount(b) {
                ResultExpr::Err(sm) => {
                    return ResultExpr::Err(sm);
                }
                ResultExpr::Ok(_) => {
                }
            }
            var shraw: u64 = ua << (ub & 63);
            if (shraw >> (ub & 63)) != ua || shraw > um {
                return ct_ovf(u64_to_str(ua) + " << " + int_to_str(b) + " (bits shifted out)");
            }
            ur = shraw & um;
            return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(ur as i64)), ty));
        }
        BinOp::Shr => {
            match ct_shift_amount(b) {
                ResultExpr::Err(sm) => {
                    return ResultExpr::Err(sm);
                }
                ResultExpr::Ok(_) => {
                }
            }
            ur = (ua & um) >> (ub & 63);
            return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(ur as i64)), ty));
        }
    }
    return ResultExpr::Err("unreachable");
}

fn eval_binop(op: BinOp, l: Expr, r: Expr) -> ResultExpr {
    if !ct_fuel_left() {
        return ct_out_of_fuel();
    }
    // A tagged unsigned operand makes the whole operation unsigned (BG62)
    var uty: OptType = ct_untag_type(l);
    match uty {
        OptType::Some(_) => {
        }
        OptType::None => {
            uty = ct_untag_type(r);
        }
    }
    match uty {
        OptType::Some(t) => {
            var l2: Expr = ct_untag(l);
            var r2: Expr = ct_untag(r);
            match l2 {
                Expr::IntLit(ua) => {
                    match r2 {
                        Expr::IntLit(ub) => {
                            return ct_eval_uint_binop(op, ua, ub, t);
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
        }
        OptType::None => {
        }
    }
    match l {
        Expr::IntLit(a) => {
            match r {
                Expr::IntLit(b) => {
                    match op {
                        BinOp::Add => {
                            return ct_add_checked(a, b);
                        }
                        BinOp::Sub => {
                            return ct_sub_checked(a, b);
                        }
                        BinOp::Mul => {
                            return ct_mul_checked(a, b);
                        }
                        BinOp::Div => {
                            if b == 0 {
                                return ResultExpr::Err("division by zero in comptime");
                            }
                            if a == (0 - 9223372036854775807 - 1) && b == (0 - 1) {
                                return ct_ovf(int_to_str(a) + " / " + int_to_str(b));
                            }
                            return ResultExpr::Ok(Expr::IntLit(a / b));
                        }
                        BinOp::Mod => {
                            if b == 0 {
                                return ResultExpr::Err("modulo by zero in comptime");
                            }
                            if a == (0 - 9223372036854775807 - 1) && b == (0 - 1) {
                                return ResultExpr::Ok(Expr::IntLit(0));
                            }
                            return ResultExpr::Ok(Expr::IntLit(a % b));
                        }
                        BinOp::Eq => {
                            return ResultExpr::Ok(Expr::BoolLit(a == b));
                        }
                        BinOp::Neq => {
                            return ResultExpr::Ok(Expr::BoolLit(a != b));
                        }
                        BinOp::Lt => {
                            return ResultExpr::Ok(Expr::BoolLit(a < b));
                        }
                        BinOp::LtEq => {
                            return ResultExpr::Ok(Expr::BoolLit(a <= b));
                        }
                        BinOp::Gt => {
                            return ResultExpr::Ok(Expr::BoolLit(a > b));
                        }
                        BinOp::GtEq => {
                            return ResultExpr::Ok(Expr::BoolLit(a >= b));
                        }
                        BinOp::And => {
                            return ResultExpr::Ok(Expr::BoolLit(a != 0 && b != 0));
                        }
                        BinOp::Or => {
                            return ResultExpr::Ok(Expr::BoolLit(a != 0 || b != 0));
                        }
                        BinOp::BitAnd => {
                            return ResultExpr::Ok(Expr::IntLit(a & b));
                        }
                        BinOp::BitOr => {
                            return ResultExpr::Ok(Expr::IntLit(a | b));
                        }
                        BinOp::BitXor => {
                            return ResultExpr::Ok(Expr::IntLit(a ^ b));
                        }
                        BinOp::Shl => {
                            match ct_shift_amount(b) {
                                ResultExpr::Err(sm) => {
                                    return ResultExpr::Err(sm);
                                }
                                ResultExpr::Ok(_) => {
                                }
                            }
                            var sh: i64 = a << b;
                            if (sh >> b) != a {
                                return ct_ovf(int_to_str(a) + " << " + int_to_str(b) + " (bits shifted out)");
                            }
                            return ResultExpr::Ok(Expr::IntLit(sh));
                        }
                        BinOp::Shr => {
                            match ct_shift_amount(b) {
                                ResultExpr::Err(sm) => {
                                    return ResultExpr::Err(sm);
                                }
                                ResultExpr::Ok(_) => {
                                }
                            }
                            return ResultExpr::Ok(Expr::IntLit(a >> b));
                        }
                    }
                }
                _ => {
                    return ResultExpr::Err("cannot evaluate binop: type mismatch");
                }
            }
        }
        Expr::FloatLit(a) => {
            match r {
                Expr::FloatLit(b) => {
                    match op {
                        BinOp::Add => {
                            return ResultExpr::Ok(Expr::FloatLit(a + b));
                        }
                        BinOp::Sub => {
                            return ResultExpr::Ok(Expr::FloatLit(a - b));
                        }
                        BinOp::Mul => {
                            return ResultExpr::Ok(Expr::FloatLit(a * b));
                        }
                        BinOp::Div => {
                            return ResultExpr::Ok(Expr::FloatLit(a / b));
                        }
                        BinOp::Eq => {
                            return ResultExpr::Ok(Expr::BoolLit(a == b));
                        }
                        BinOp::Neq => {
                            return ResultExpr::Ok(Expr::BoolLit(a != b));
                        }
                        BinOp::Lt => {
                            return ResultExpr::Ok(Expr::BoolLit(a < b));
                        }
                        BinOp::LtEq => {
                            return ResultExpr::Ok(Expr::BoolLit(a <= b));
                        }
                        BinOp::Gt => {
                            return ResultExpr::Ok(Expr::BoolLit(a > b));
                        }
                        BinOp::GtEq => {
                            return ResultExpr::Ok(Expr::BoolLit(a >= b));
                        }
                        _ => {
                            return ResultExpr::Err("unsupported float binop");
                        }
                    }
                }
                _ => {
                    return ResultExpr::Err("cannot evaluate binop: type mismatch");
                }
            }
        }
        Expr::StringLit(a) => {
            match r {
                Expr::StringLit(b) => {
                    match op {
                        BinOp::Add => {
                            return ResultExpr::Ok(Expr::StringLit(a + b));
                        }
                        BinOp::Eq => {
                            return ResultExpr::Ok(Expr::BoolLit(a == b));
                        }
                        BinOp::Neq => {
                            return ResultExpr::Ok(Expr::BoolLit(a != b));
                        }
                        _ => {
                            return ResultExpr::Err("unsupported string binop");
                        }
                    }
                }
                _ => {
                    return ResultExpr::Err("cannot evaluate binop: type mismatch");
                }
            }
        }
        Expr::BoolLit(a) => {
            match r {
                Expr::BoolLit(b) => {
                    match op {
                        BinOp::Eq => {
                            return ResultExpr::Ok(Expr::BoolLit(a == b));
                        }
                        BinOp::Neq => {
                            return ResultExpr::Ok(Expr::BoolLit(a != b));
                        }
                        BinOp::And => {
                            return ResultExpr::Ok(Expr::BoolLit(a && b));
                        }
                        BinOp::Or => {
                            return ResultExpr::Ok(Expr::BoolLit(a || b));
                        }
                        _ => {
                            return ResultExpr::Err("unsupported bool binop");
                        }
                    }
                }
                _ => {
                    return ResultExpr::Err("cannot evaluate binop: type mismatch");
                }
            }
        }
        _ => {
            return ResultExpr::Err("cannot evaluate binop on non-literal");
        }
    }
    return ResultExpr::Err("unreachable");
}

fn eval_unaryop(op: UnaryOp, v: Expr) -> ResultExpr {
    // A tagged unsigned value keeps its type through `!`/`-` (BG62): `!` masks
    // to the width, `-` is a type error (unsigned has no negatives).
    match ct_untag_type(v) {
        OptType::Some(ty) => {
            var n: i64 = ct_int_untag(v);
            match op {
                UnaryOp::BitNot => {
                    var w: i64 = ct_int_width(ty);
                    var rb: i64 = (-1 ^ n) & ct_width_mask(w);
                    return ResultExpr::Ok(Expr::Cast(Box::new(Expr::IntLit(rb)), ty));
                }
                UnaryOp::Neg => {
                    return ResultExpr::Err("cannot negate an unsigned comptime value");
                }
                UnaryOp::Not => {
                    if n != 0 {
                        return ResultExpr::Ok(Expr::IntLit(0));
                    }
                    return ResultExpr::Ok(Expr::IntLit(1));
                }
            }
        }
        OptType::None => {
        }
    }
    match op {
        UnaryOp::Neg => {
            match v {
                Expr::IntLit(n) => {
                    if n == (0 - 9223372036854775807 - 1) {
                        return ct_ovf("- " + int_to_str(n));
                    }
                    return ResultExpr::Ok(Expr::IntLit(0 - n));
                }
                Expr::FloatLit(f) => {
                    return ResultExpr::Ok(Expr::FloatLit(-f));
                }
                _ => {
                    return ResultExpr::Err("cannot negate non-number");
                }
            }
        }
        UnaryOp::Not => {
            match v {
                Expr::BoolLit(b) => {
                    return ResultExpr::Ok(Expr::BoolLit(!b));
                }
                Expr::IntLit(n) => {
                    if n == 0 {
                        return ResultExpr::Ok(Expr::IntLit(1));
                    }
                    return ResultExpr::Ok(Expr::IntLit(0));
                }
                _ => {
                    return ResultExpr::Err("cannot not non-bool/int");
                }
            }
        }
        UnaryOp::BitNot => {
            match v {
                Expr::IntLit(n) => {
                    return ResultExpr::Ok(Expr::IntLit(-1 ^ n));
                }
                _ => {
                    return ResultExpr::Err("cannot bitnot non-int");
                }
            }
        }
    }
    return ResultExpr::Err("unreachable");
}

// --- Reflection ----------------------------------------------------------

fn ce_find_struct(original: &Program, name: str) -> i64 {
    var i: i64 = 0;
    while i < original.structs.len() {
        if original.structs.get(i).name == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// --- Layout through the lowerer (one code path) ----------------------------
// struct_size and field_offset must report what the program's own struct
// gets, so they are computed by the lowerer's layout code itself: a
// throwaway Lowerer holds every struct and enum of the program (laid out to
// a fixpoint, as Lowerer_lower_program does), and the query reads it. The
// evaluator's own copy of the layout rules is gone: two copies agreed only
// while both were edited in step.

/// A Lowerer with every struct and enum of `original` laid out, for
/// struct_size / field_offset.
fn ce_layout_lowerer(original: &Program) -> Lowerer {
    var lw: Lowerer = Lowerer_new();
    // The lowerer's table is (name, EnumDef) entries, as Lowerer_lower_program
    // fills it. (Until Nov 23 the program's Vec<EnumDef> was assigned to it:
    // an assignment was not type-checked, and a lookup read an EnumDef's
    // fields where it expects an entry's.)
    var ei: i64 = 0;
    while ei < original.enums.len() {
        var ced: EnumDef = original.enums.get(ei);
        lw.enums.push(StringEnumDefEntry_new(ced.name, ced));
        HashMap_insert(lw.enum_index, ced.name, ei + 1);
        ei = ei + 1;
    }
    var ai: i64 = 0;
    while ai < original.type_aliases.len() {
        var ta: TypeAlias = original.type_aliases.get(ai);
        lw.type_aliases.push(StringTypeEntry_new(ta.name, ta.alias_for));
        ai = ai + 1;
    }
    // Layouts to a fixpoint: a struct whose field is a struct declared
    // later needs that one's size (Lowerer_lower_program does the same).
    var rounds: i64 = 0;
    var changed: bool = true;
    while changed && rounds < 8 {
        changed = false;
        rounds = rounds + 1;
        var si: i64 = 0;
        while si < original.structs.len() {
            var s: StructDef = original.structs.get(si);
            var old_size: i64 = 0;
            match IrModule_get_struct(&lw.module, s.name) {
                OptStructLayout::Some(ol) => {
                    old_size = ol.size;
                }
                OptStructLayout::None => {
                }
            }
            Lowerer_compute_struct_layout(&mut lw, s);
            match IrModule_get_struct(&lw.module, s.name) {
                OptStructLayout::Some(nl) => {
                    if nl.size != old_size {
                        changed = true;
                    }
                }
                OptStructLayout::None => {
                }
            }
            si = si + 1;
        }
        var ej: i64 = 0;
        while ej < original.enums.len() {
            var en: EnumDef = original.enums.get(ej);
            var old_esize: i64 = 0;
            match IrModule_get_struct(&lw.module, en.name) {
                OptStructLayout::Some(oel) => {
                    old_esize = oel.size;
                }
                OptStructLayout::None => {
                }
            }
            Lowerer_compute_enum_layout(&mut lw, en);
            match IrModule_get_struct(&lw.module, en.name) {
                OptStructLayout::Some(nel) => {
                    if nel.size != old_esize {
                        changed = true;
                    }
                }
                OptStructLayout::None => {
                }
            }
            ej = ej + 1;
        }
    }
    return lw;
}

fn ce_str_array(items: Vec<str>) -> Expr {
    // An array literal, as ever: `[i]` indexing works where it lands in the
    // program (test_comptime_function_effects.fd). Comptime code that
    // composes with .len/.get uses the string-named builtins
    // (field_names_of & co.), which give comptime Vec tables.
    var elements: Vec<Expr> = Vec::new();
    var i: i64 = 0;
    while i < items.len() {
        elements.push(Expr::StringLit(items.get(i)));
        i = i + 1;
    }
    return Expr::ArrayLit(Box::new(Type::Str), elements);
}

fn ce_find_func(funcs: Vec<Func>, name: str) -> i64 {
    var i: i64 = 0;
    while i < funcs.len() {
        if funcs.get(i).name == name {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// Effects declared on function (or method) `name`; Err if there is none.
fn ce_function_effects(original: &Program, name: str) -> ResultExpr {
    var fi: i64 = ce_find_func(original.funcs, name);
    if fi >= 0 {
        return ResultExpr::Ok(ce_str_array(original.funcs.get(fi).declared_effects));
    }
    var i: i64 = 0;
    while i < original.impls.len() {
        var ms: Vec<Func> = original.impls.get(i).methods;
        var mi: i64 = ce_find_func(ms, name);
        if mi >= 0 {
            return ResultExpr::Ok(ce_str_array(ms.get(mi).declared_effects));
        }
        i = i + 1;
    }
    i = 0;
    while i < original.trait_impls.len() {
        var ms2: Vec<Func> = original.trait_impls.get(i).methods;
        var mi2: i64 = ce_find_func(ms2, name);
        if mi2 >= 0 {
            return ResultExpr::Ok(ce_str_array(ms2.get(mi2).declared_effects));
        }
        i = i + 1;
    }
    return ResultExpr::Err("function_effects: no function '" + name + "'");
}

/// The traits implemented by the type that defines method `name`.
fn ce_function_capabilities(original: &Program, name: str) -> ResultExpr {
    var owner: str = "";
    var i: i64 = 0;
    while i < original.trait_impls.len() && owner == "" {
        var ti: TraitImpl = original.trait_impls.get(i);
        if ce_find_func(ti.methods, name) >= 0 {
            owner = ti.type_name;
        }
        i = i + 1;
    }
    i = 0;
    while i < original.impls.len() && owner == "" {
        var im: ImplDef = original.impls.get(i);
        if ce_find_func(im.methods, name) >= 0 {
            owner = im.struct_name;
        }
        i = i + 1;
    }
    var traits: Vec<str> = Vec::new();
    if owner == "" {
        if ce_find_func(original.funcs, name) < 0 {
            return ResultExpr::Err("function_capabilities: no function '" + name + "'");
        }
        return ResultExpr::Ok(ce_str_array(traits));
    }
    i = 0;
    while i < original.trait_impls.len() {
        var t2: TraitImpl = original.trait_impls.get(i);
        if t2.type_name == owner {
            var seen: bool = false;
            var k: i64 = 0;
            while k < traits.len() {
                if traits.get(k) == t2.trait_name {
                    seen = true;
                }
                k = k + 1;
            }
            if !seen {
                traits.push(t2.trait_name);
            }
        }
        i = i + 1;
    }
    return ResultExpr::Ok(ce_str_array(traits));
}

fn evaluate_reflect(op: ReflectOp, ty: Type, original: &Program) -> ResultExpr {
    var type_name: str = "";
    match ty {
        Type::Named(n) => {
            type_name = n;
        }
        Type::I8 => {
            type_name = "i8";
        }
        Type::I16 => {
            type_name = "i16";
        }
        Type::I32 => {
            type_name = "i32";
        }
        Type::I64 => {
            type_name = "i64";
        }
        Type::I128 => {
            type_name = "i128";
        }
        Type::U8 => {
            type_name = "u8";
        }
        Type::U16 => {
            type_name = "u16";
        }
        Type::U32 => {
            type_name = "u32";
        }
        Type::U64 => {
            type_name = "u64";
        }
        Type::U128 => {
            type_name = "u128";
        }
        Type::F32 => {
            type_name = "f32";
        }
        Type::F64 => {
            type_name = "f64";
        }
        Type::Bool => {
            type_name = "bool";
        }
        Type::Str => {
            type_name = "str";
        }
        Type::Void => {
            type_name = "void";
        }
        _ => {
            return ResultExpr::Err("reflect: unsupported type");
        }
    }

    match op {
        ReflectOp::TypeName => {
            return ResultExpr::Ok(Expr::StringLit(type_name));
        }
        ReflectOp::IsStruct => {
            var found: bool = false;
            var si: i64 = 0;
            while si < original.structs.len() {
                if original.structs.get(si).name == type_name {
                    found = true;
                }
                si = si + 1;
            }
            return ResultExpr::Ok(Expr::BoolLit(found));
        }
        ReflectOp::IsEnum => {
            var found: bool = false;
            var ei: i64 = 0;
            while ei < original.enums.len() {
                if original.enums.get(ei).name == type_name {
                    found = true;
                }
                ei = ei + 1;
            }
            return ResultExpr::Ok(Expr::BoolLit(found));
        }
        ReflectOp::FieldCount => {
            var si: i64 = 0;
            while si < original.structs.len() {
                var s: StructDef = original.structs.get(si);
                if s.name == type_name {
                    return ResultExpr::Ok(Expr::IntLit(s.fields.len()));
                }
                si = si + 1;
            }
            return ResultExpr::Err("type_name: '" + type_name + "' is not a struct");
        }
        ReflectOp::FieldNames => {
            var si: i64 = 0;
            while si < original.structs.len() {
                var s: StructDef = original.structs.get(si);
                if s.name == type_name {
                    var elements: Vec<Expr> = Vec::new();
                    var fi: i64 = 0;
                    while fi < s.fields.len() {
                        elements.push(Expr::StringLit(s.fields.get(fi).name));
                        fi = fi + 1;
                    }
                    return ResultExpr::Ok(Expr::ArrayLit(Box::new(Type::Str), elements));
                }
                si = si + 1;
            }
            return ResultExpr::Err("field_names: '" + type_name + "' is not a struct");
        }
        ReflectOp::FieldTypes => {
            var si: i64 = 0;
            while si < original.structs.len() {
                var s: StructDef = original.structs.get(si);
                if s.name == type_name {
                    var elements: Vec<Expr> = Vec::new();
                    var fi: i64 = 0;
                    while fi < s.fields.len() {
                        elements.push(Expr::StringLit(type_to_str(s.fields.get(fi).ty)));
                        fi = fi + 1;
                    }
                    return ResultExpr::Ok(Expr::ArrayLit(Box::new(Type::Str), elements));
                }
                si = si + 1;
            }
            return ResultExpr::Err("field_types: '" + type_name + "' is not a struct");
        }
        ReflectOp::EnumVariants => {
            var ei: i64 = 0;
            while ei < original.enums.len() {
                var e: EnumDef = original.enums.get(ei);
                if e.name == type_name {
                    var elements: Vec<Expr> = Vec::new();
                    var vi: i64 = 0;
                    while vi < e.variants.len() {
                        elements.push(Expr::StringLit(e.variants.get(vi).name));
                        vi = vi + 1;
                    }
                    return ResultExpr::Ok(Expr::ArrayLit(Box::new(Type::Str), elements));
                }
                ei = ei + 1;
            }
            return ResultExpr::Err("enum_variants: '" + type_name + "' is not an enum");
        }
        ReflectOp::StructSize => {
            var ssi: i64 = ce_find_struct(original, type_name);
            if ssi < 0 {
                return ResultExpr::Err("struct_size: '" + type_name + "' is not a struct");
            }
            var lw: Lowerer = ce_layout_lowerer(original);
            match IrModule_get_struct(&lw.module, type_name) {
                OptStructLayout::Some(l) => {
                    return ResultExpr::Ok(Expr::IntLit(l.size));
                }
                OptStructLayout::None => {
                    return ResultExpr::Err("struct_size: '" + type_name + "' could not be laid out");
                }
            }
        }
        ReflectOp::FieldOffset => {
            var dot: i64 = str_find(type_name, ".");
            if dot < 0 {
                return ResultExpr::Err("field_offset: expected Owner.member, got '" + type_name + "'");
            }
            var owner: str = str_slice(type_name, 0, dot);
            var field: str = str_slice(type_name, dot + 1, str_len(type_name));
            var osi: i64 = ce_find_struct(original, owner);
            if osi < 0 {
                return ResultExpr::Err("field_offset: '" + owner + "' is not a struct");
            }
            var lw: Lowerer = ce_layout_lowerer(original);
            match IrModule_get_struct(&lw.module, owner) {
                OptStructLayout::Some(l) => {
                    var fi: i64 = 0;
                    while fi < l.fields.len() {
                        if l.fields.get(fi).name == field {
                            return ResultExpr::Ok(Expr::IntLit(l.fields.get(fi).offset));
                        }
                        fi = fi + 1;
                    }
                    return ResultExpr::Err("field_offset: struct '" + owner + "' has no field '" + field + "'");
                }
                OptStructLayout::None => {
                    return ResultExpr::Err("field_offset: '" + owner + "' could not be laid out");
                }
            }
        }
        ReflectOp::EnumDiscriminant => {
            var dot2: i64 = str_find(type_name, ".");
            if dot2 < 0 {
                return ResultExpr::Err("enum_discriminant: expected Owner.member, got '" + type_name + "'");
            }
            var eowner: str = str_slice(type_name, 0, dot2);
            var variant: str = str_slice(type_name, dot2 + 1, str_len(type_name));
            var dei: i64 = 0;
            while dei < original.enums.len() {
                var de: EnumDef = original.enums.get(dei);
                if de.name == eowner {
                    var dvi: i64 = 0;
                    while dvi < de.variants.len() {
                        if de.variants.get(dvi).name == variant {
                            return ResultExpr::Ok(Expr::IntLit(dvi));
                        }
                        dvi = dvi + 1;
                    }
                    return ResultExpr::Err("enum_discriminant: enum '" + eowner + "' has no variant '" + variant + "'");
                }
                dei = dei + 1;
            }
            return ResultExpr::Err("enum_discriminant: '" + eowner + "' is not an enum");
        }
        ReflectOp::FunctionEffects => {
            return ce_function_effects(original, type_name);
        }
        ReflectOp::FunctionCapabilities => {
            return ce_function_capabilities(original, type_name);
        }
    }
    return ResultExpr::Err("unreachable");
}

// --- Pre-type-check expansion: comptime if, inline for (§4.11) ------------
// Statement-position `comptime if` selects its branch before type checking,
// so the branch not taken is not checked (config-gated code may name what
// the other configuration has) and its locals are as visible as any other
// statement's. `inline for` (parser.fd wraps its iterator in `comptime`)
// unrolls into one copy of the body per iteration with the loop variable a
// literal, so comptime expressions over it compute. Generic functions are
// left to substitute's second pass, after mono filled their parameters.

var g_ct_expand_errors: Vec<str> = Vec::new();
pub fn comptime_expand_errors() -> Vec<str> {
    return g_ct_expand_errors;
}

pub fn expand_comptime(program: Program) -> Program {
    var prog: Program = program;
    g_ct_expand_errors = Vec::new();
    g_ct_steps = 0;
    g_ct_call_stack = Vec::new();
    g_ct_line = 0;
    g_ct_subst_line = 0;
    var errs: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < prog.funcs.len() {
        if prog.funcs.get(fi).type_params.len() == 0 {
            var f: Func = prog.funcs.get(fi);
            f.body = ec_stmts(f.body, &prog, &mut errs);
            prog.funcs.set(fi, f);
        }
        fi = fi + 1;
    }
    var ii: i64 = 0;
    while ii < prog.impls.len() {
        if prog.impls.get(ii).type_params.len() == 0 {
            var im: ImplDef = prog.impls.get(ii);
            var mi: i64 = 0;
            while mi < im.methods.len() {
                if im.methods.get(mi).type_params.len() == 0 {
                    var m: Func = im.methods.get(mi);
                    m.body = ec_stmts(m.body, &prog, &mut errs);
                    im.methods.set(mi, m);
                }
                mi = mi + 1;
            }
            prog.impls.set(ii, im);
        }
        ii = ii + 1;
    }
    var ti: i64 = 0;
    while ti < prog.trait_impls.len() {
        var tim: TraitImpl = prog.trait_impls.get(ti);
        var tmi: i64 = 0;
        while tmi < tim.methods.len() {
            if tim.methods.get(tmi).type_params.len() == 0 {
                var m2: Func = tim.methods.get(tmi);
                m2.body = ec_stmts(m2.body, &prog, &mut errs);
                tim.methods.set(tmi, m2);
            }
            tmi = tmi + 1;
        }
        prog.trait_impls.set(ti, tim);
        ti = ti + 1;
    }
    g_ct_expand_errors = errs;
    return prog;
}

/// The statements of `inline for fvar in range_e { body }`: one copy of the
/// body per iteration, the loop variable replaced by its literal (so comptime
/// expressions over it compute), each copy expanded (nested comptime ifs and
/// inline fors inside see the literal). The loop variable's name is not
/// declared: every use is the literal.
fn ec_unroll_inline(out: &mut Vec<Stmt>, fvar: str, range_e: Expr, body: Vec<Stmt>, original: &Program, errs: &mut Vec<str>, line: i64) {
    match range_e {
        Expr::Range(a_box, b_box, incl) => {
            var a_e: Expr = ct_box_expr_unbox(a_box);
            var b_e: Expr = ct_box_expr_unbox(b_box);
            substitute_expr(&mut a_e, original, errs);
            substitute_expr(&mut b_e, original, errs);
            g_ct_call_stack = Vec::new();
            g_ct_line = 0;
            var av: Expr = Expr::IntLit(0);
            match evaluate(&a_e, original) {
                ResultExpr::Ok(v) => {
                    av = v;
                }
                ResultExpr::Err(m) => {
                    errs.push("inline for (line " + int_to_str(line) + "): the range's start: " + m + ct_trace());
                    return;
                }
            }
            var bv: Expr = Expr::IntLit(0);
            match evaluate(&b_e, original) {
                ResultExpr::Ok(v) => {
                    bv = v;
                }
                ResultExpr::Err(m) => {
                    errs.push("inline for (line " + int_to_str(line) + "): the range's end: " + m + ct_trace());
                    return;
                }
            }
            var a: i64 = 0;
            var b: i64 = 0;
            match av {
                Expr::IntLit(n) => {
                    a = n;
                }
                _ => {
                    errs.push("inline for (line " + int_to_str(line) + "): the range's start must be known at compile time (a const or a literal)");
                    return;
                }
            }
            match bv {
                Expr::IntLit(n2) => {
                    b = n2;
                }
                _ => {
                    errs.push("inline for (line " + int_to_str(line) + "): the range's end must be known at compile time (a const or a literal)");
                    return;
                }
            }
            // The count without overflow (BG84): b - a wraps when the range
            // spans more than i64::MAX, and b - a + 1 at a..=i64::MAX
            var trip: i64 = 0;
            if b > a || (incl && b == a) {
                if a < 0 && b >= 0 && b - 4096 > a {
                    errs.push("inline for (line " + int_to_str(line) + "): more than the 4096 iterations an inline for unrolls");
                    return;
                }
                trip = b - a;
                if trip > 4096 {
                    errs.push("inline for (line " + int_to_str(line) + "): " + int_to_str(trip) + " iterations is more than the 4096 an inline for unrolls");
                    return;
                }
                if incl {
                    trip = trip + 1;
                }
            }
            if trip > 4096 {
                errs.push("inline for (line " + int_to_str(line) + "): " + int_to_str(trip) + " iterations is more than the 4096 an inline for unrolls");
                return;
            }
            if trip > 0 && ct_stmts_have_break_or_continue(body) {
                errs.push("inline for (line " + int_to_str(line) + "): break/continue belong to a runtime loop; an unrolled body has no loop to leave");
                return;
            }
            var k: i64 = 0;
            while k < trip {
                if !ct_fuel_left() {
                    errs.push("inline for (line " + int_to_str(line) + "): the fuel budget ran out while unrolling (FID_CT_FUEL raises it)");
                    return;
                }
                // A fresh copy per iteration, `fvar` replaced everywhere it
                // is not declared again (BG27). `if true` gives the copy
                // its own scope: the body's lets belong to their iteration,
                // not the enclosing block (BG123).
                var iter: Vec<Stmt> = replace_ident_in_stmts(body, fvar, Expr::IntLit(a + k));
                var expanded: Vec<Stmt> = ec_stmts(iter, original, errs);
                out.push(Stmt::If(Expr::BoolLit(true), expanded, OptStmts::None, line));
                k = k + 1;
            }
        }
        _ => {
            errs.push("inline for (line " + int_to_str(line) + "): the iterator must be a range (a..b) known at compile time");
        }
    }
}

/// One statement list expanded: a statement `comptime if` splices its taken
/// branch in place (no scope of its own), an `inline for` splices its
/// unrolled copies; every other statement recurses into the statement lists
/// it holds. Expressions are untouched: `comptime` there is a value, as
/// before.
fn ec_stmts(stmts: Vec<Stmt>, original: &Program, errs: &mut Vec<str>) -> Vec<Stmt> {
    var out: Vec<Stmt> = Vec::new();
    var si: i64 = 0;
    while si < stmts.len() {
        var stmt: Stmt = stmts.get(si);
        g_ct_subst_line = ct_stmt_line(stmt);
        match stmt {
            Stmt::Expr(e, eline) => {
                var handled: bool = false;
                match e {
                    Expr::Comptime(inner) => {
                        match ct_box_expr_unbox(inner) {
                            Expr::If(cond, then_block, else_block) => {
                                var cond2: Expr = ct_box_expr_unbox(cond);
                                substitute_expr(&mut cond2, original, errs);
                                g_ct_call_stack = Vec::new();
                                g_ct_line = 0;
                                match evaluate(&cond2, original) {
                                    ResultExpr::Ok(v) => {
                                        match v {
                                            Expr::BoolLit(b) => {
                                                var taken: Vec<Stmt> = then_block;
                                                if !b {
                                                    taken = Vec::new();
                                                    match else_block {
                                                        OptStmts::Some(eb4) => {
                                                            taken = eb4;
                                                        }
                                                        OptStmts::None => {
                                                        }
                                                    }
                                                }
                                                var inner_out: Vec<Stmt> = ec_stmts(taken, original, errs);
                                                var ti2: i64 = 0;
                                                while ti2 < inner_out.len() {
                                                    out.push(inner_out.get(ti2));
                                                    ti2 = ti2 + 1;
                                                }
                                                handled = true;
                                            }
                                            _ => {
                                                errs.push("comptime if (line " + int_to_str(eline) + "): the condition is not known at compile time (a bool the evaluator can compute)");
                                            }
                                        }
                                    }
                                    ResultExpr::Err(m) => {
                                        errs.push("comptime if (line " + int_to_str(eline) + "): " + m + ct_trace());
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    _ => {
                    }
                }
                if !handled {
                    out.push(stmt);
                }
            }
            Stmt::For(fvar, iterator, body, fline) => {
                var inline_iter: bool = false;
                var range_e: Expr = Expr::IntLit(0);
                match iterator {
                    Expr::Comptime(ri) => {
                        inline_iter = true;
                        range_e = ct_box_expr_unbox(ri);
                    }
                    _ => {
                    }
                }
                if inline_iter {
                    ec_unroll_inline(&mut out, fvar, range_e, body, original, errs, fline);
                } else {
                    out.push(Stmt::For(fvar, iterator, ec_stmts(body, original, errs), fline));
                }
            }
            Stmt::If(c, t, eb, iline) => {
                var new_t: Vec<Stmt> = ec_stmts(t, original, errs);
                var new_e: OptStmts = OptStmts::None;
                match eb {
                    OptStmts::Some(eb2) => {
                        new_e = OptStmts::Some(ec_stmts(eb2, original, errs));
                    }
                    OptStmts::None => {
                    }
                }
                out.push(Stmt::If(c, new_t, new_e, iline));
            }
            Stmt::While(c, b, wline) => {
                out.push(Stmt::While(c, ec_stmts(b, original, errs), wline));
            }
            Stmt::Loop(b, lline) => {
                out.push(Stmt::Loop(ec_stmts(b, original, errs), lline));
            }
            Stmt::Match(m, arms, mline) => {
                var new_arms: Vec<MatchArm> = Vec::new();
                var ai: i64 = 0;
                while ai < arms.len() {
                    var arm: MatchArm = arms.get(ai);
                    arm.body = ec_stmts(arm.body, original, errs);
                    new_arms.push(arm);
                    ai = ai + 1;
                }
                out.push(Stmt::Match(m, new_arms, mline));
            }
            Stmt::Defer(b, dline) => {
                out.push(Stmt::Defer(ec_stmts(b, original, errs), dline));
            }
            Stmt::Txn(b, tline2) => {
                out.push(Stmt::Txn(ec_stmts(b, original, errs), tline2));
            }
            Stmt::Sandbox(b, sline) => {
                out.push(Stmt::Sandbox(ec_stmts(b, original, errs), sline));
            }
            Stmt::Unsafe(b, uline) => {
                out.push(Stmt::Unsafe(ec_stmts(b, original, errs), uline));
            }
            Stmt::SpawnScope(b, sline2) => {
                out.push(Stmt::SpawnScope(ec_stmts(b, original, errs), sline2));
            }
            Stmt::Parallel(brs, pline) => {
                var nb: Vec<Vec<Stmt>> = Vec::new();
                var bi2: i64 = 0;
                while bi2 < brs.len() {
                    nb.push(ec_stmts(brs.get(bi2), original, errs));
                    bi2 = bi2 + 1;
                }
                out.push(Stmt::Parallel(nb, pline));
            }
            Stmt::Handle(b, hs, hline) => {
                var nb2: Vec<Stmt> = ec_stmts(b, original, errs);
                var nh: Vec<EffectHandler> = Vec::new();
                var hi: i64 = 0;
                while hi < hs.len() {
                    var h: EffectHandler = hs.get(hi);
                    h.body = ec_stmts(h.body, original, errs);
                    nh.push(h);
                    hi = hi + 1;
                }
                out.push(Stmt::Handle(nb2, nh, hline));
            }
            _ => {
                out.push(stmt);
            }
        }
        si = si + 1;
    }
    return out;
}
