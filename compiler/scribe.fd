// scribe.fd -- Documentation generator for the Fides programming language
// Ported from src/scribe.rs.
//
// Parses .fd source files, extracts doc comments (///), and generates
// HTML or Markdown documentation.
//
// Usage:
//   scribe <file.fd> [--output <dir>] [--format html|markdown]
//   scribe <dir>    [--output <dir>]
//
// Output:
//   HTML/Markdown files in the specified output directory (default: docs/)

module compiler::scribe;
use core;
use vec;
use string;
use compiler::build_info;
// Wrapper structs for tuple-like data (Fides has no tuples)
pub struct StringPair {
    pub a: str,
    pub b: str,
}

pub fn StringPair_new(a: str, b: str) -> StringPair {
    return StringPair {
        a: a, b: b
    };
}

pub struct StringTriple {
    pub a: str,
    pub b: str,
    pub c: str,
}

pub fn StringTriple_new(a: str, b: str, c: str) -> StringTriple {
    return StringTriple {
        a: a, b: b, c: c
    };
}

pub struct ParamsRet {
    pub params: Vec<StringPair>,
    pub ret_type: str,
}

pub fn ParamsRet_new(params: Vec<StringPair>, ret_type: str) -> ParamsRet {
    return ParamsRet {
        params: params, ret_type: ret_type
    };
}

// --- DocItem ---

pub struct DocItem {
    pub kind: str,
    // "function", "struct", "enum", "impl", "const", "trait"
    pub name: str,
    pub signature: str,
    // source-level signature
    pub doc: str,
    // doc comment text (/// lines joined)
    pub line: i64,
    // source line number
    pub fields: Vec<StringTriple>,
    // (name, type, doc) for struct fields
    pub params: Vec<StringPair>,
    // (name, type) for function params
    pub ret_type: str,
    pub methods: Vec<DocItem>,
    // for impl blocks
    pub variants: Vec<StringPair>,
    // (name, doc) for enum variants
    pub is_pub: bool,
}

pub fn DocItem_new(kind: str, name: str, signature: str, doc: str, line: i64, is_pub: bool) -> DocItem {
    return DocItem {
        kind: kind, name: name, signature: signature, doc: doc, line: line, fields: Vec::new(), params: Vec::new(), ret_type: "", methods: Vec::new(), variants: Vec::new(), is_pub: is_pub,
    };
}

// --- Doc extraction ---

/// Extract doc comments and items from source text
pub fn extract_docs(source: str) -> Vec<DocItem> {
    var items: Vec<DocItem> = Vec::new();
    var lines: Vec<str> = str_split(source, "\n");
    // the braces of each line that are code (BG105)
    val code: Vec<str> = scribe_code_braces(lines);
    var i: i64 = 0;

    while i < lines.len() {
        // Collect doc comments (/// prefix)
        var doc_lines: Vec<str> = Vec::new();
        while i < lines.len() {
            var trimmed: str = str_trim_start(lines.get(i));
            if str_starts_with(trimmed, "///") {
                var rest: str = str_slice(trimmed, 3, str_len(trimmed));
                // TL11: an example's code lines keep their indentation
                doc_lines.push(scribe_doc_line(lines.get(i), rest));
                i = i + 1;
            } else if str_starts_with(trimmed, "//") {
                i = i + 1;
            } else if str_len(trimmed) == 0 {
                i = i + 1;
            } else {
                break;
            }
        }

        if i >= lines.len() {
            break;
        }

        var line: str = str_trim_start(lines.get(i));
        var doc: str = "";
        var di: i64 = 0;
        while di < doc_lines.len() {
            if di > 0 {
                doc = doc + "\n";
            }
            doc = doc + doc_lines.get(di);
            di = di + 1;
        }

        // Detect item type
        if str_starts_with(line, "pub fn ") || str_starts_with(line, "fn ") {
            var result: ParseResult = parse_function(lines, code, i, doc);
            match result.item {
                OptionDocItem::Some(it) => {
                    items.push(it);
                }
                OptionDocItem::None => {
                }
            }
            i = result.end;
        } else if str_starts_with(line, "pub struct ") || str_starts_with(line, "struct ") {
            var result: ParseResult = scribe_parse_struct(lines, code, i, doc);
            match result.item {
                OptionDocItem::Some(it) => {
                    items.push(it);
                }
                OptionDocItem::None => {
                }
            }
            i = result.end;
        } else if str_starts_with(line, "pub enum ") || str_starts_with(line, "enum ") {
            var result: ParseResult = scribe_parse_enum(lines, code, i, doc);
            match result.item {
                OptionDocItem::Some(it) => {
                    items.push(it);
                }
                OptionDocItem::None => {
                }
            }
            i = result.end;
        } else if str_starts_with(line, "impl ") {
            var result: ParseResult = parse_impl(lines, code, i, doc);
            match result.item {
                OptionDocItem::Some(it) => {
                    items.push(it);
                }
                OptionDocItem::None => {
                }
            }
            i = result.end;
        } else if str_starts_with(line, "pub const ") || str_starts_with(line, "const ") {
            var result: ParseResult = scribe_parse_const(lines, i, doc);
            match result.item {
                OptionDocItem::Some(it) => {
                    items.push(it);
                }
                OptionDocItem::None => {
                }
            }
            i = result.end;
        } else if str_starts_with(line, "cap ") || str_starts_with(line, "pub cap ") {
            var result: ParseResult = scribe_parse_trait(lines, code, i, doc);
            match result.item {
                OptionDocItem::Some(it) => {
                    items.push(it);
                }
                OptionDocItem::None => {
                }
            }
            i = result.end;
        } else {
            i = i + 1;
        }
    }

    return items;
}

// --- Option type ---

pub enum OptionDocItem {
    Some(DocItem),
    None
}

// --- Parse result (item + end index) ---

pub struct ParseResult {
    pub item: OptionDocItem,
    pub end: i64,
}

pub fn ParseResult_new(item: OptionDocItem, end: i64) -> ParseResult {
    return ParseResult {
        item: item, end: end
    };
}

// --- Code braces (BG105) ---

fn scribe_ident_byte(c: i64) -> bool {
    return char_is_alpha(c) || char_is_digit(c) || c == 95;
}

/// The `{` and `}` of each line that are code, in order: none inside a
/// string, an f-string, a raw string, a char literal or a comment (a block
/// comment, a string or a raw string may run over several lines). The item
/// parsers count these, not every brace of the line: `return "{";` or a
/// `// }` swallowed the items after it or cut one short (BG105).
pub fn scribe_code_braces(lines: Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var in_block: bool = false;
    // 0: code, 1: a string, 2: an f-string, 3: a raw string
    var in_str: i64 = 0;
    var raw_hashes: i64 = 0;
    var li: i64 = 0;
    while li < lines.len() {
        val l: str = lines.get(li);
        val n: i64 = str_len(l);
        var braces: str = "";
        var i: i64 = 0;
        while i < n {
            val c: i64 = str_byte_at(l, i);
            var c1: i64 = 0;
            if i + 1 < n {
                c1 = str_byte_at(l, i + 1);
            }
            if in_block {
                if c == 42 && c1 == 47 {
                    in_block = false;
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            } else if in_str == 1 || in_str == 2 {
                if c == 92 {
                    i = i + 2;
                } else if c == 34 {
                    in_str = 0;
                    i = i + 1;
                } else if c == 123 && in_str == 2 {
                    // an interpolation runs to its matching `}` (a `"` in it
                    // does not end the f-string), as the lexer reads it
                    var depth: i64 = 1;
                    i = i + 1;
                    while i < n && depth > 0 {
                        val fc: i64 = str_byte_at(l, i);
                        if fc == 123 {
                            depth = depth + 1;
                        } else if fc == 125 {
                            depth = depth - 1;
                        }
                        i = i + 1;
                    }
                } else {
                    i = i + 1;
                }
            } else if in_str == 3 {
                var closes: bool = c == 34;
                var h: i64 = 0;
                while closes && h < raw_hashes {
                    if i + 1 + h >= n || str_byte_at(l, i + 1 + h) != 35 {
                        closes = false;
                    }
                    h = h + 1;
                }
                if closes {
                    in_str = 0;
                    i = i + 1 + raw_hashes;
                } else {
                    i = i + 1;
                }
            } else {
                var after_word: bool = i > 0 && scribe_ident_byte(str_byte_at(l, i - 1));
                if c == 47 && c1 == 47 {
                    // a line comment: the rest of the line
                    i = n;
                } else if c == 47 && c1 == 42 {
                    in_block = true;
                    i = i + 2;
                } else if c == 34 {
                    in_str = 1;
                    i = i + 1;
                } else if c == 102 && c1 == 34 && !after_word {
                    in_str = 2;
                    i = i + 2;
                } else if c == 114 && (c1 == 34 || c1 == 35) && !after_word {
                    var j: i64 = i + 1;
                    var hashes: i64 = 0;
                    while j < n && str_byte_at(l, j) == 35 {
                        hashes = hashes + 1;
                        j = j + 1;
                    }
                    if j < n && str_byte_at(l, j) == 34 {
                        in_str = 3;
                        raw_hashes = hashes;
                        i = j + 1;
                    } else {
                        i = i + 1;
                    }
                } else if c == 39 {
                    // a char literal ('{', '\'', '\u{7B}'); a lifetime (`'a`,
                    // no closing quote after the name) is code
                    var j: i64 = i + 1;
                    if c1 == 92 {
                        j = i + 3;
                        while j < n && j < i + 14 && str_byte_at(l, j) != 39 {
                            j = j + 1;
                        }
                    } else {
                        j = i + 2;
                        while j < n && j < i + 6 && str_byte_at(l, j) >= 128 && str_byte_at(l, j) < 192 {
                            j = j + 1;
                        }
                    }
                    if j < n && str_byte_at(l, j) == 39 {
                        i = j + 1;
                    } else {
                        i = i + 1;
                    }
                } else {
                    if c == 123 {
                        braces = braces + "{";
                    } else if c == 125 {
                        braces = braces + "}";
                    }
                    i = i + 1;
                }
            }
        }
        out.push(braces);
        li = li + 1;
    }
    return out;
}

// --- Parsers ---

fn parse_function(lines: Vec<str>, code: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var is_pub: bool = str_starts_with(line, "pub ");
    var sig: str = line;
    if is_pub {
        sig = str_slice(line, 4, str_len(line));
    }

    var name: str = extract_name_after(sig, "fn ");
    if str_len(name) == 0 {
        return ParseResult_new(OptionDocItem::None, start + 1);
    }

    var params_ret: ParamsRet = extract_params_and_return(line);

    // Find end of function (opening { or ; for declarations)
    var end: i64 = start;
    var brace_depth: i64 = 0;
    var found_brace: bool = false;
    while end < lines.len() {
        var l: str = lines.get(end);
        val cb: str = code.get(end);
        var ci: i64 = 0;
        while ci < str_len(cb) {
            var c: i64 = str_byte_at(cb, ci);
            if c == 123 {
                brace_depth = brace_depth + 1;
                found_brace = true;
            } else if c == 125 {
                brace_depth = brace_depth - 1;
            }
            ci = ci + 1;
        }
        end = end + 1;
        if found_brace && brace_depth == 0 {
            break;
        }
        // Declaration without body
        if !found_brace && str_ends_with(str_trim_end(l), ";") {
            break;
        }
    }

    var item: DocItem = DocItem_new("function", name, str_trim(line), doc, start + 1, is_pub);
    item.params = params_ret.params;
    item.ret_type = params_ret.ret_type;
    return ParseResult_new(OptionDocItem::Some(item), end);
}

fn scribe_parse_struct(lines: Vec<str>, code: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var is_pub: bool = str_starts_with(line, "pub ");
    var sig: str = line;
    if is_pub {
        sig = str_slice(line, 4, str_len(line));
    }

    var name: str = extract_name_after(sig, "struct ");
    if str_len(name) == 0 {
        return ParseResult_new(OptionDocItem::None, start + 1);
    }

    var item: DocItem = DocItem_new("struct", name, str_trim(line), doc, start + 1, is_pub);

    // Parse fields inside { } -- scan forward from start
    var i: i64 = start;
    var in_body: bool = false;
    var brace_depth: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim(lines.get(i));
        val cb: str = code.get(i);
        var ci: i64 = 0;
        while ci < str_len(cb) {
            var c: i64 = str_byte_at(cb, ci);
            if c == 123 {
                // '{'
                brace_depth = brace_depth + 1;
                in_body = true;
            } else if c == 125 {
                // '}'
                brace_depth = brace_depth - 1;
            }
            ci = ci + 1;
        }
        // not the header line (`struct S<T: Clone> {` held a `:`)
        if in_body && brace_depth > 0 && i > start && !str_starts_with(l, "{") && !str_starts_with(l, "}") {
            var field_line: str = str_trim_end_char(l, 44);
            // remove trailing comma
            // byte codes: a str literal given for the i64 never matched
            var colon_pos: i64 = sc_str_find_char(field_line, 58);
            if colon_pos >= 0 {
                var field_name: str = str_trim(str_slice(field_line, 0, colon_pos));
                field_name = str_trim_start_str(field_name, "pub ");
                field_name = str_trim(field_name);
                var field_type: str = str_trim(str_slice(field_line, colon_pos + 1, str_len(field_line)));
                if str_len(field_name) > 0 && !str_starts_with(field_name, "//") {
                    item.fields.push(StringTriple_new(field_name, field_type, ""));
                }
            }
        }
        i = i + 1;
        if in_body && brace_depth == 0 {
            break;
        }
    }

    return ParseResult_new(OptionDocItem::Some(item), i);
}

fn scribe_parse_enum(lines: Vec<str>, code: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var is_pub: bool = str_starts_with(line, "pub ");
    var sig: str = line;
    if is_pub {
        sig = str_slice(line, 4, str_len(line));
    }

    var name: str = extract_name_after(sig, "enum ");
    if str_len(name) == 0 {
        return ParseResult_new(OptionDocItem::None, start + 1);
    }

    var item: DocItem = DocItem_new("enum", name, str_trim(line), doc, start + 1, is_pub);

    // Parse variants inside { }
    var i: i64 = start;
    var in_body: bool = false;
    var brace_depth: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim(lines.get(i));
        val cb: str = code.get(i);
        var ci: i64 = 0;
        while ci < str_len(cb) {
            var c: i64 = str_byte_at(cb, ci);
            if c == 123 {
                brace_depth = brace_depth + 1;
                in_body = true;
            } else if c == 125 {
                brace_depth = brace_depth - 1;
            }
            ci = ci + 1;
        }
        // not the header line: `pub enum Mark {` was listed as a variant
        if in_body && brace_depth > 0 && i > start && !str_starts_with(l, "{") && !str_starts_with(l, "}") && str_len(l) > 0 {
            var var_line: str = str_trim_end_char(l, 44);
            // remove trailing comma
            // Variant: "Ok(i64)" or "None" or "Ok(i64, str)"
            var var_name: str = var_line;
            var paren_pos: i64 = sc_str_find_char(var_line, 40);
            if paren_pos >= 0 {
                var_name = str_slice(var_line, 0, paren_pos);
            }
            var_name = str_trim(var_name);
            if str_len(var_name) > 0 {
                item.variants.push(StringPair_new(var_name, ""));
            }
        }
        i = i + 1;
        if in_body && brace_depth == 0 {
            break;
        }
    }

    return ParseResult_new(OptionDocItem::Some(item), i);
}

fn parse_impl(lines: Vec<str>, code: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var name: str = extract_name_after(line, "impl ");

    // Could be "impl Trait for Struct" -- extract struct name
    var struct_name: str = name;
    var fpos: i64 = str_find_str(name, " for ");
    if fpos >= 0 {
        struct_name = str_trim(str_slice(name, fpos + 5, str_len(name)));
    }

    var item: DocItem = DocItem_new("impl", struct_name, str_trim(line), doc, start + 1, true);

    // Parse methods inside { }
    var i: i64 = start;
    var brace_depth: i64 = 0;
    var in_body: bool = false;
    var method_doc_lines: Vec<str> = Vec::new();
    while i < lines.len() {
        var l: str = str_trim_start(lines.get(i));

        // Collect doc comments for methods
        if str_starts_with(l, "///") {
            var rest: str = str_slice(l, 3, str_len(l));
            method_doc_lines.push(str_trim_start(rest));
            i = i + 1;
            continue;
        }
        if str_starts_with(l, "//") || str_len(l) == 0 {
            if !str_starts_with(l, "///") {
                method_doc_lines = Vec::new();
            }
            i = i + 1;
            continue;
        }

        // the depth before this line's braces: a method's own `{` is on its
        // line, so after counting it the depth was 2 and only one-line
        // methods were documented (BG104)
        val depth_before: i64 = brace_depth;
        val cb: str = code.get(i);
        var ci: i64 = 0;
        while ci < str_len(cb) {
            var c: i64 = str_byte_at(cb, ci);
            if c == 123 {
                brace_depth = brace_depth + 1;
                in_body = true;
            } else if c == 125 {
                brace_depth = brace_depth - 1;
            }
            ci = ci + 1;
        }

        // Detect method: "pub fn name(" or "fn name("
        if in_body && depth_before == 1 && (str_starts_with(l, "pub fn ") || str_starts_with(l, "fn ")) {
            var method_doc: str = "";
            var di: i64 = 0;
            while di < method_doc_lines.len() {
                if di > 0 {
                    method_doc = method_doc + "\n";
                }
                method_doc = method_doc + method_doc_lines.get(di);
                di = di + 1;
            }
            method_doc_lines = Vec::new();
            var mresult: ParseResult = parse_function(lines, code, i, method_doc);
            match mresult.item {
                OptionDocItem::Some(mit) => {
                    item.methods.push(mit);
                }
                OptionDocItem::None => {
                }
            }
            // parse_function read the method to its end: back at the depth
            // of the impl's body
            brace_depth = depth_before;
            i = mresult.end;
            continue;
        }

        i = i + 1;
        if in_body && brace_depth == 0 {
            break;
        }
    }

    return ParseResult_new(OptionDocItem::Some(item), i);
}

fn scribe_parse_const(lines: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var is_pub: bool = str_starts_with(line, "pub ");
    var sig: str = line;
    if is_pub {
        sig = str_slice(line, 4, str_len(line));
    }
    var name: str = extract_name_after(sig, "const ");
    var item: DocItem = DocItem_new("const", name, str_trim(line), doc, start + 1, is_pub);
    return ParseResult_new(OptionDocItem::Some(item), start + 1);
}

fn scribe_parse_trait(lines: Vec<str>, code: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var is_pub: bool = str_starts_with(line, "pub ");
    var sig: str = line;
    if is_pub {
        sig = str_slice(line, 4, str_len(line));
    }
    var name: str = extract_name_after(sig, "cap ");
    if str_len(name) == 0 {
        return ParseResult_new(OptionDocItem::None, start + 1);
    }

    // Find end of trait body (matching braces)
    var end: i64 = start;
    var brace_depth: i64 = 0;
    while end < lines.len() {
        val cb: str = code.get(end);
        var ci: i64 = 0;
        while ci < str_len(cb) {
            var c: i64 = str_byte_at(cb, ci);
            if c == 123 {
                brace_depth = brace_depth + 1;
            } else if c == 125 {
                brace_depth = brace_depth - 1;
            }
            ci = ci + 1;
        }
        end = end + 1;
        if brace_depth == 0 && end > start + 1 {
            break;
        }
    }

    var item: DocItem = DocItem_new("trait", name, str_trim(line), doc, start + 1, is_pub);
    return ParseResult_new(OptionDocItem::Some(item), end);
}

// --- Helpers ---

pub fn extract_name_after(s: str, prefix: str) -> str {
    var pos: i64 = str_find_str(s, prefix);
    if pos < 0 {
        return "";
    }
    var after: str = str_slice(s, pos + str_len(prefix), str_len(s));
    // Name ends at (, <, {, space, or ;
    var end: i64 = str_len(after);
    var i: i64 = 0;
    while i < str_len(after) {
        var c: i64 = str_byte_at(after, i);
        if c == 40 || c == 60 || c == 123 || c == 32 || c == 59 {
            // ( < { space ;
            end = i;
            break;
        }
        i = i + 1;
    }
    return str_trim(str_slice(after, 0, end));
}

fn extract_params_and_return(line: str) -> ParamsRet {
    var params: Vec<StringPair> = Vec::new();
    var ret_type: str = "";

    // Find params between first ( and matching )
    var start: i64 = sc_str_find_char(line, 40);
    if start < 0 {
        return ParamsRet_new(params, ret_type);
    }

    var depth: i64 = 1;
    var end: i64 = start + 1;
    while end < str_len(line) && depth > 0 {
        var c: i64 = str_byte_at(line, end);
        if c == 40 {
            depth = depth + 1;
        } else if c == 41 {
            depth = depth - 1;
        }
        end = end + 1;
    }
    // A parameter list that runs on to the next line has no closing paren here
    var close: i64 = end - 1;
    if depth != 0 {
        close = end;
    }
    var params_str: str = str_slice(line, start + 1, close);

    // Split by comma
    var parts: Vec<str> = str_split_char(params_str, 44);
    // ','
    var pi: i64 = 0;
    while pi < parts.len() {
        var param: str = str_trim(parts.get(pi));
        if str_len(param) > 0 {
            var colon: i64 = sc_str_find_char(param, 58);
            if colon >= 0 {
                var pname: str = str_trim_start_str(str_slice(param, 0, colon), "pub ");
                pname = str_trim(pname);
                var pty: str = str_trim(str_slice(param, colon + 1, str_len(param)));
                params.push(StringPair_new(pname, pty));
            }
        }
        pi = pi + 1;
    }

    // Return type after ->
    var after_parens: str = str_slice(line, end, str_len(line));
    var arrow: i64 = str_find_str(after_parens, "->");
    if arrow >= 0 {
        var ret: str = str_trim(str_slice(after_parens, arrow + 2, str_len(after_parens)));
        // Find end at { or ;
        var ret_end: i64 = str_len(ret);
        var ri: i64 = 0;
        while ri < str_len(ret) {
            var c: i64 = str_byte_at(ret, ri);
            if c == 123 || c == 59 {
                ret_end = ri;
                break;
            }
            ri = ri + 1;
        }
        ret_type = str_trim(str_slice(ret, 0, ret_end));
    }

    return ParamsRet_new(params, ret_type);
}

pub fn escape_html(s: str) -> str {
    var result: str = str_replace(s, "&", "&" + "amp;");
    result = str_replace(result, "<", "&" + "lt;");
    result = str_replace(result, ">", "&" + "gt;");
    result = str_replace(result, "\"", "&" + "quot;");
    return result;
}

// --- HTML generation ---

pub fn generate_html(items: Vec<DocItem>, module_name: str) -> str {
    return generate_html_ctx(items, module_name, DocCtx_new());
}

/// TL11: a module's page; `ctx` names the types other pages document
/// (signatures link to them), the module's source page (each item links
/// to its line) and the version label.
pub fn generate_html_ctx(items: Vec<DocItem>, module_name: str, ctx: DocCtx) -> str {
    var html: str = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n";
    html = html + "<title>" + escape_html(module_name) + " -- Fides Documentation</title>\n";
    html = html + "<meta charset=\"utf-8\">\n";
    html = html + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n";
    html = html + "<style>\n" + CSS + SCRIBE_CSS_MORE + "</style>\n";
    html = html + "</head>\n<body>\n";

    html = html + "<h1>" + escape_html(module_name) + "</h1>\n";
    if str_len(ctx.version) > 0 {
        html = html + "<p class=\"version\">Version " + escape_html(ctx.version) + "</p>\n";
    }
    if str_len(ctx.src_href) > 0 {
        html = html + "<p class=\"srcfile\">Source: <a class=\"src\" href=\"" + escape_html(ctx.src_href) + "\">" + escape_html(ctx.src_label) + "</a></p>\n";
    }
    html = html + "<nav class=\"sidebar\">\n<ul>\n";

    var i: i64 = 0;
    while i < items.len() {
        var item: DocItem = items.get(i);
        if item.kind == "impl" {
            // the impl's own section (the type may be documented elsewhere)
            html = html + "<li><a href=\"#impl-" + escape_html(item.name) + "\">" + escape_html(item.name) + " <span class=\"kind\">" + item.kind + "</span></a></li>\n";
        } else if item.is_pub {
            html = html + "<li><a href=\"#" + escape_html(item.name) + "\">" + escape_html(item.name) + " <span class=\"kind\">" + item.kind + "</span></a></li>\n";
        }
        i = i + 1;
    }
    html = html + "</ul>\n</nav>\n";

    html = html + "<main>\n";

    // Group items by kind
    var functions: Vec<DocItem> = Vec::new();
    var structs: Vec<DocItem> = Vec::new();
    var enums: Vec<DocItem> = Vec::new();
    var impls: Vec<DocItem> = Vec::new();
    var consts: Vec<DocItem> = Vec::new();
    var traits: Vec<DocItem> = Vec::new();

    i = 0;
    while i < items.len() {
        var item: DocItem = items.get(i);
        if item.kind == "function" && item.is_pub {
            functions.push(item);
        } else if item.kind == "struct" && item.is_pub {
            structs.push(item);
        } else if item.kind == "enum" && item.is_pub {
            enums.push(item);
        } else if item.kind == "impl" {
            impls.push(item);
        } else if item.kind == "const" && item.is_pub {
            consts.push(item);
        } else if item.kind == "trait" {
            traits.push(item);
        }
        i = i + 1;
    }

    // the sections go through a StringBuilder: core's page has thousands
    var body: StringBuilder = StringBuilder::new();
    body.append_str(html);
    if functions.len() > 0 {
        body.append_str("<h2 id=\"functions\">Functions</h2>\n");
        i = 0;
        while i < functions.len() {
            body.append_str(render_function(functions.get(i), ctx));
            i = i + 1;
        }
    }

    if structs.len() > 0 {
        body.append_str("<h2 id=\"structs\">Structs</h2>\n");
        i = 0;
        while i < structs.len() {
            body.append_str(render_struct(structs.get(i), ctx));
            i = i + 1;
        }
    }

    if enums.len() > 0 {
        body.append_str("<h2 id=\"enums\">Enums</h2>\n");
        i = 0;
        while i < enums.len() {
            body.append_str(render_enum(enums.get(i), ctx));
            i = i + 1;
        }
    }

    if impls.len() > 0 {
        body.append_str("<h2 id=\"impls\">Implementations</h2>\n");
        i = 0;
        while i < impls.len() {
            body.append_str(render_impl(impls.get(i), ctx));
            i = i + 1;
        }
    }

    if consts.len() > 0 {
        body.append_str("<h2 id=\"consts\">Constants</h2>\n");
        i = 0;
        while i < consts.len() {
            body.append_str(render_const(consts.get(i), ctx));
            i = i + 1;
        }
    }

    if traits.len() > 0 {
        body.append_str("<h2 id=\"traits\">Traits</h2>\n");
        i = 0;
        while i < traits.len() {
            body.append_str(render_trait(traits.get(i), ctx));
            i = i + 1;
        }
    }

    body.append_str("</main>\n");
    body.append_str("<footer><p>Generated by scribe -- Fides documentation generator</p></footer>\n");
    body.append_str("</body>\n</html>\n");
    return body.to_str();
}

fn render_function(item: DocItem, ctx: DocCtx) -> str {
    var html: str = "<section id=\"" + escape_html(item.name) + "\">\n";
    html = html + "<h3>" + escape_html(item.name) + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + scribe_doc_html(item.doc) + "</div>\n";
    }
    html = html + "<pre class=\"signature\">" + scribe_link_types(item.signature, ctx, item.name) + "</pre>\n";

    if item.params.len() > 0 {
        html = html + "<h4>Parameters</h4>\n<table>\n";
        var pi: i64 = 0;
        while pi < item.params.len() {
            var param: StringPair = item.params.get(pi);
            html = html + "<tr><td class=\"name\">" + escape_html(param.a) + "</td><td class=\"type\">" + scribe_link_types(param.b, ctx, "") + "</td></tr>\n";
            pi = pi + 1;
        }
        html = html + "</table>\n";
    }

    if str_len(item.ret_type) > 0 {
        html = html + "<h4>Returns</h4>\n<p class=\"type\">" + scribe_link_types(item.ret_type, ctx, "") + "</p>\n";
    }

    html = html + scribe_location_html(item.line, ctx);
    html = html + "</section>\n";
    return html;
}

fn render_struct(item: DocItem, ctx: DocCtx) -> str {
    var html: str = "<section id=\"" + escape_html(item.name) + "\">\n";
    html = html + "<h3>" + escape_html(item.name) + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + scribe_doc_html(item.doc) + "</div>\n";
    }
    html = html + "<pre class=\"signature\">" + scribe_link_types(item.signature, ctx, item.name) + "</pre>\n";

    if item.fields.len() > 0 {
        html = html + "<h4>Fields</h4>\n<table>\n";
        var fi: i64 = 0;
        while fi < item.fields.len() {
            var field: StringTriple = item.fields.get(fi);
            html = html + "<tr><td class=\"name\">" + escape_html(field.a) + "</td><td class=\"type\">" + scribe_link_types(field.b, ctx, "") + "</td><td class=\"doc\">" + escape_html(field.c) + "</td></tr>\n";
            fi = fi + 1;
        }
        html = html + "</table>\n";
    }

    html = html + scribe_location_html(item.line, ctx);
    html = html + "</section>\n";
    return html;
}

fn render_enum(item: DocItem, ctx: DocCtx) -> str {
    var html: str = "<section id=\"" + escape_html(item.name) + "\">\n";
    html = html + "<h3>" + escape_html(item.name) + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + scribe_doc_html(item.doc) + "</div>\n";
    }
    html = html + "<pre class=\"signature\">" + scribe_link_types(item.signature, ctx, item.name) + "</pre>\n";

    if item.variants.len() > 0 {
        html = html + "<h4>Variants</h4>\n<ul>\n";
        var vi: i64 = 0;
        while vi < item.variants.len() {
            var variant: StringPair = item.variants.get(vi);
            html = html + "<li><span class=\"name\">" + escape_html(variant.a) + "</span> <span class=\"doc\">" + escape_html(variant.b) + "</span></li>\n";
            vi = vi + 1;
        }
        html = html + "</ul>\n";
    }

    html = html + scribe_location_html(item.line, ctx);
    html = html + "</section>\n";
    return html;
}

fn render_impl(item: DocItem, ctx: DocCtx) -> str {
    var html: str = "<section id=\"impl-" + escape_html(item.name) + "\">\n";
    html = html + "<h3>impl " + scribe_link_types(item.name, ctx, "") + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + scribe_doc_html(item.doc) + "</div>\n";
    }
    html = html + scribe_location_html(item.line, ctx);

    if item.methods.len() > 0 {
        html = html + "<h4>Methods</h4>\n";
        var mi: i64 = 0;
        while mi < item.methods.len() {
            html = html + render_function(item.methods.get(mi), ctx);
            mi = mi + 1;
        }
    }

    html = html + "</section>\n";
    return html;
}

fn render_const(item: DocItem, ctx: DocCtx) -> str {
    var html: str = "<section id=\"" + escape_html(item.name) + "\">\n";
    html = html + "<h3>" + escape_html(item.name) + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + scribe_doc_html(item.doc) + "</div>\n";
    }
    html = html + "<pre class=\"signature\">" + scribe_link_types(item.signature, ctx, item.name) + "</pre>\n";
    html = html + scribe_location_html(item.line, ctx);
    html = html + "</section>\n";
    return html;
}

fn render_trait(item: DocItem, ctx: DocCtx) -> str {
    var html: str = "<section id=\"" + escape_html(item.name) + "\">\n";
    html = html + "<h3>cap " + escape_html(item.name) + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + scribe_doc_html(item.doc) + "</div>\n";
    }
    html = html + "<pre class=\"signature\">" + scribe_link_types(item.signature, ctx, item.name) + "</pre>\n";
    html = html + scribe_location_html(item.line, ctx);
    html = html + "</section>\n";
    return html;
}

// --- Markdown generation ---

pub fn generate_markdown(items: Vec<DocItem>, module_name: str) -> str {
    var md: str = "# " + module_name + " -- Fides Documentation\n\n";

    // Table of contents
    md = md + "## Contents\n\n";
    var i: i64 = 0;
    while i < items.len() {
        var item: DocItem = items.get(i);
        if item.is_pub || item.kind == "impl" {
            md = md + "- [" + item.name + "](#" + item.name + ") (" + item.kind + ")\n";
        }
        i = i + 1;
    }
    md = md + "\n";

    i = 0;
    while i < items.len() {
        var item: DocItem = items.get(i);
        if !item.is_pub && item.kind != "impl" {
            i = i + 1;
            continue;
        }
        md = md + "## " + item.name + "\n\n";
        if str_len(item.doc) > 0 {
            md = md + scribe_doc_md(item.doc) + "\n\n";
        }
        md = md + "```fides\n" + item.signature + "\n```\n\n";

        if item.kind == "function" {
            if item.params.len() > 0 {
                md = md + "**Parameters:**\n\n";
                var pi: i64 = 0;
                while pi < item.params.len() {
                    var param: StringPair = item.params.get(pi);
                    md = md + "- `" + param.a + "`: `" + param.b + "`\n";
                    pi = pi + 1;
                }
                md = md + "\n";
            }
            if str_len(item.ret_type) > 0 {
                md = md + "**Returns:** `" + item.ret_type + "`\n\n";
            }
        }

        if item.kind == "struct" && item.fields.len() > 0 {
            md = md + "**Fields:**\n\n";
            md = md + "| Name | Type |\n|------|------|\n";
            var fi: i64 = 0;
            while fi < item.fields.len() {
                var field: StringTriple = item.fields.get(fi);
                md = md + "| `" + field.a + "` | `" + field.b + "` |\n";
                fi = fi + 1;
            }
            md = md + "\n";
        }

        if item.kind == "enum" && item.variants.len() > 0 {
            md = md + "**Variants:**\n\n";
            var vi: i64 = 0;
            while vi < item.variants.len() {
                var variant: StringPair = item.variants.get(vi);
                md = md + "- `" + variant.a + "`\n";
                vi = vi + 1;
            }
            md = md + "\n";
        }

        if item.kind == "impl" && item.methods.len() > 0 {
            md = md + "**Methods:**\n\n";
            var mi: i64 = 0;
            while mi < item.methods.len() {
                var method: DocItem = item.methods.get(mi);
                md = md + "### " + method.name + "\n\n";
                if str_len(method.doc) > 0 {
                    md = md + scribe_doc_md(method.doc) + "\n\n";
                }
                md = md + "```fides\n" + method.signature + "\n```\n\n";
                mi = mi + 1;
            }
        }

        md = md + "*Defined at line " + int_to_str(item.line) + "*\n\n---\n\n";
        i = i + 1;
    }

    md = md + "*Generated by [scribe](https://fides.dev) -- Fides documentation generator*\n";
    return md;
}

// --- CSS ---

pub const CSS: str = "body { font-family: -apple-system, sans-serif; max-width: 900px; margin: 0 auto; padding: 20px; color: #333; }\nnav.sidebar { float: right; width: 200px; padding: 10px; background: #f5f5f5; border-radius: 5px; }\nnav.sidebar ul { list-style: none; padding: 0; }\nnav.sidebar li { padding: 4px 0; }\n.kind { color: #999; font-size: 0.85em; }\nsection { border-bottom: 1px solid #eee; padding: 20px 0; }\nh1 { color: #2c3e50; }\nh2 { color: #34495e; margin-top: 30px; }\npre { background: #f8f8f8; padding: 10px; border-radius: 5px; overflow-x: auto; }\ncode { font-family: 'Fira Code', monospace; font-size: 0.9em; }\ntable { border-collapse: collapse; margin: 10px 0; }\ntd { border: 1px solid #ddd; padding: 6px 12px; }\n.line { color: #999; font-size: 0.85em; }\n.doc { margin: 10px 0; line-height: 1.5; }\n";
/// TL11: type links, source links, examples and the version label.
pub const SCRIBE_CSS_MORE: str = "a.ty { color: #2a6db0; text-decoration: none; }\na.ty:hover { text-decoration: underline; }\n.location a.src { color: #777; }\n.version { color: #666; font-size: 0.9em; margin-top: -10px; }\n.example-note { color: #555; font-size: 0.85em; margin: 8px 0 2px; }\npre.example { background: #f3f7f3; border-left: 3px solid #8b8; }\n";
// --- File processing ---

pub fn scribe_process_file(input_path: str, output_dir: str, format: str) -> str {
    // read_file: p_file_read gives a raw 0 for a missing file
    var source: str = "";
    match read_file(input_path) {
        Option::Some(c) => {
            source = c;
        }
        Option::None => {
        }
    }
    if str_len(source) == 0 {
        return "Cannot read " + input_path;
    }

    var items: Vec<DocItem> = extract_docs(source);

    // Extract module name from source or filename
    var module_name: str = extract_module_name(source, input_path);

    var content: str = "";
    var ext: str = "html";
    if format == "markdown" || format == "md" {
        content = generate_markdown(items, module_name);
        ext = "md";
    } else {
        // TL11: types of this file link to their sections, items to their
        // lines in src/<page>.html
        var page1: str = scribe_page_name(module_name);
        var ctx: DocCtx = DocCtx_new();
        scribe_register_types(&mut ctx, items, page1);
        ctx.page = page1;
        ctx.src_href = "src/" + page1 + ".html";
        ctx.src_label = input_path;
        ctx.version = scribe_doc_version(scribe_dir_of(input_path));
        scribe_mkdir_all(output_dir);
        p_mkdir(output_dir + "/src");
        p_file_write(output_dir + "/" + ctx.src_href, scribe_source_page(source, input_path, page1));
        content = generate_html_ctx(items, module_name, ctx);
    }

    var output_file: str = output_dir + "/" + scribe_page_name(module_name) + "." + ext;
    // AD1: as the Rust scribe (fs::create_dir_all), the output directory
    // and its parents are made first; a markdown page was not written when
    // the directory did not exist yet.
    scribe_mkdir_all(output_dir);
    if p_file_write(output_file, content) != 0 {
        return "Cannot write " + output_file;
    }

    return "Generated " + output_file + " (" + int_to_str(items.len()) + " items)";
}

/// `fid doc <dir>` (TL11): a documentation site for the .fd files under
/// `input_dir`, as scribe_site writes it. A .fd file is one page; a file
/// that lists paths (one a line) documents those files.
pub fn process_directory(input_dir: str, output_dir: str, format: str) -> str {
    if str_ends_with(input_dir, ".fd") {
        return scribe_process_file(input_dir, output_dir, format);
    }
    if p_is_dir(input_dir) != 0 {
        return scribe_site(input_dir, output_dir, format);
    }
    // A file of newline-separated paths
    var listing: str = "";
    match read_file(input_dir) {
        Option::Some(c) => {
            listing = c;
        }
        Option::None => {
        }
    }
    if str_len(listing) > 0 {
        var paths: Vec<str> = str_split(listing, "\n");
        var count: i64 = 0;
        var i: i64 = 0;
        while i < paths.len() {
            var path: str = str_trim(paths.get(i));
            if str_len(path) > 0 && str_ends_with(path, ".fd") {
                scribe_process_file(path, output_dir, format);
                count = count + 1;
            }
            i = i + 1;
        }
        if count > 0 {
            return "Generated documentation for " + int_to_str(count) + " file(s) in " + output_dir;
        }
    }
    return "Cannot read " + input_dir + ": not a .fd file, a directory, or a list of paths";
}

// --- TL11: documentation sites --------------------------------------------

/// The file name of a module's page, without the extension: `a::b` is
/// `a_b` (`:` cannot be in a Windows file name).
pub fn scribe_page_name(module_name: str) -> str {
    return str_replace(module_name, "::", "_");
}

/// The .fd files under `dir` (recursively; not in hidden directories or
/// ark_modules/), appended to `out`.
fn scribe_collect(dir: str, out: &mut Vec<str>) {
    var listing: str = p_dir_list(dir);
    if str_len(listing) == 0 {
        return;
    }
    var names: Vec<str> = str_split(listing, "\n");
    var i: i64 = 0;
    while i < names.len() {
        var nm: str = str_trim(names.get(i));
        if str_len(nm) > 0 && !str_starts_with(nm, ".") && nm != "ark_modules" {
            var full: str = dir + "/" + nm;
            if p_is_dir(full) != 0 {
                scribe_collect(full, out);
            } else if str_ends_with(nm, ".fd") {
                out.push(full);
            }
        }
        i = i + 1;
    }
}

/// The first line of the comment a file starts with (its summary), or "".
fn scribe_file_summary(source: str) -> str {
    var lines: Vec<str> = str_split(source, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim(lines.get(i));
        if str_len(l) > 0 {
            if !str_starts_with(l, "//") {
                return "";
            }
            var text: str = str_trim(str_trim_start_str(str_trim_start_str(l, "//"), "/"));
            // a separator line (// ----) or an empty comment says nothing
            if str_len(text) > 0 && !str_starts_with(text, "---") && !str_starts_with(text, "===") {
                return text;
            }
        }
        i = i + 1;
    }
    return "";
}

/// `s` as the inside of a JavaScript string literal in an HTML page.
fn scribe_js_str(s: str) -> str {
    var r: str = str_replace(s, "\\", "\\\\");
    r = str_replace(r, "\"", "\\\"");
    r = str_replace(r, "<", "\\u003c");
    r = str_replace(r, "\r", " ");
    r = str_replace(r, "\n", " ");
    return r;
}

// --- TL11: links between types, source links, examples, versions --------

/// What a page needs to link outside one item: the types the site
/// documents (`types`: a type's name, and `<page>#<name>` for the page that
/// declares it, to an index into `pages`), this page's name, its source
/// page (`src_href`, "" for none) and file, and the version label.
pub struct DocCtx {
    pub types: HashMap<str,
     i64>,
    pub pages: Vec<str>,
    pub page: str,
    pub src_href: str,
    pub src_label: str,
    pub version: str,
}

/// A context that links nothing (a page on its own).
pub fn DocCtx_new() -> DocCtx {
    var types: HashMap<str, i64> = HashMap::new();
    var pages: Vec<str> = Vec::new();
    return DocCtx {
        types: types, pages: pages, page: "", src_href: "", src_label: "", version: "",
    };
}

/// Enter the types `items` declare (pub structs and enums, and caps, whose
/// sections render_* gives the id of their name) as sections of `page`.
/// The first page to declare a name is the one other pages link to.
pub fn scribe_register_types(ctx: &mut DocCtx, items: Vec<DocItem>, page: str) {
    var i: i64 = 0;
    while i < items.len() {
        var it: DocItem = items.get(i);
        if str_len(it.name) > 0 && ((it.is_pub && (it.kind == "struct" || it.kind == "enum")) || it.kind == "trait") {
            var local: str = page + "#" + it.name;
            if !ctx.types.contains(local) {
                ctx.pages.push(page);
                var idx: i64 = ctx.pages.len() - 1;
                ctx.types.insert(local, idx);
                if !ctx.types.contains(it.name) {
                    ctx.types.insert(it.name, idx);
                }
            }
        }
        i = i + 1;
    }
}

/// The link to the section of type `name` ("#Name" on this page,
/// "page.html#Name" on another), or "" when no page documents it.
pub fn scribe_type_href(ctx: DocCtx, name: str) -> str {
    if str_len(ctx.page) > 0 && ctx.types.contains(ctx.page + "#" + name) {
        return "#" + name;
    }
    if ctx.types.contains(name) {
        var idx: i64 = ctx.types.get(name);
        if idx >= 0 && idx < ctx.pages.len() {
            var p: str = ctx.pages.get(idx);
            if p == ctx.page {
                return "#" + name;
            }
            return p + ".html#" + name;
        }
    }
    return "";
}

fn scribe_is_word_byte(c: i64) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
}

/// `text` (a signature or a type) as HTML in which each type name a page
/// documents links to its section. `self_name` (the item declared) stays
/// text, and so do string literals and a trailing `//` comment.
pub fn scribe_link_types(text: str, ctx: DocCtx, self_name: str) -> str {
    if ctx.pages.len() == 0 {
        return escape_html(text);
    }
    var n: i64 = str_len(text);
    var sb: StringBuilder = StringBuilder::new();
    var run: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(text, i);
        if c == 34 {
            // a string literal (a parameter's default) stays text
            i = i + 1;
            while i < n && str_byte_at(text, i) != 34 {
                if str_byte_at(text, i) == 92 {
                    i = i + 1;
                }
                i = i + 1;
            }
            i = i + 1;
        } else if c == 47 && i + 1 < n && str_byte_at(text, i + 1) == 47 {
            i = n;
        } else if scribe_is_word_byte(c) {
            var j: i64 = i + 1;
            while j < n && scribe_is_word_byte(str_byte_at(text, j)) {
                j = j + 1;
            }
            // type names start with a capital; words starting with a
            // digit or a small letter (values, i64, str) are never linked
            if c >= 65 && c <= 90 {
                var word: str = str_slice(text, i, j);
                if word != self_name {
                    var href: str = scribe_type_href(ctx, word);
                    if str_len(href) > 0 {
                        sb.append_str(escape_html(str_slice(text, run, i)));
                        sb.append_str("<a class=\"ty\" href=\"" + escape_html(href) + "\">" + word + "</a>");
                        run = j;
                    }
                }
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    if run < n {
        sb.append_str(escape_html(str_slice(text, run, n)));
    }
    return sb.to_str();
}

/// Where an item is defined: a link to its line on the module's source
/// page when there is one, else the line number.
pub fn scribe_location_html(line: i64, ctx: DocCtx) -> str {
    if str_len(ctx.src_href) > 0 {
        return "<p class=\"location\">Defined at <a class=\"src\" href=\"" + escape_html(ctx.src_href) + "#L" + int_to_str(line) + "\">" + escape_html(ctx.src_label) + ":" + int_to_str(line) + "</a></p>\n";
    }
    return "<p class=\"location\">Defined at line " + int_to_str(line) + "</p>\n";
}

/// The page of a module's source (written to src/<page>.html): a line
/// each, `id="L<n>"`, so a location links to its line, and a link back
/// to the module's page.
pub fn scribe_source_page(source: str, label: str, module_page: str) -> str {
    var sb: StringBuilder = StringBuilder::new();
    sb.append_str("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<title>" + escape_html(label) + " -- source</title>\n<meta charset=\"utf-8\">\n");
    sb.append_str("<style>\nbody { font-family: -apple-system, sans-serif; margin: 0 auto; padding: 20px; color: #333; }\npre.src { background: #f8f8f8; padding: 10px; overflow-x: auto; line-height: 1.35; }\npre.src span:target { background: #fff3b0; }\na.ln { display: inline-block; width: 4em; color: #999; text-decoration: none; text-align: right; margin-right: 1em; user-select: none; }\n</style>\n</head>\n<body>\n");
    sb.append_str("<p><a href=\"../" + escape_html(module_page) + ".html\">Documentation of " + escape_html(label) + "</a></p>\n");
    sb.append_str("<h1>" + escape_html(label) + "</h1>\n<pre class=\"src\">");
    var lines: Vec<str> = str_split(source, "\n");
    var n: i64 = lines.len();
    // a file ending in a newline has no line after it
    if n > 0 && str_len(lines.get(n - 1)) == 0 {
        n = n - 1;
    }
    var i: i64 = 0;
    while i < n {
        var num: str = int_to_str(i + 1);
        var text: str = lines.get(i);
        if str_len(text) > 0 && str_byte_at(text, str_len(text) - 1) == 13 {
            text = str_slice(text, 0, str_len(text) - 1);
        }
        sb.append_str("<span id=\"L" + num + "\"><a class=\"ln\" href=\"#L" + num + "\">" + num + "</a>" + escape_html(text) + "</span>\n");
        i = i + 1;
    }
    sb.append_str("</pre>\n</body>\n</html>\n");
    return sb.to_str();
}

/// A `///` line's text as the doc keeps it: `rest` (what follows `///`)
/// trimmed, except for a line of an example as scripts/doctest.py reads
/// one (`///` in column 0, then two spaces or more), which keeps its
/// indentation so scribe_doc_html can find the example.
pub fn scribe_doc_line(raw: str, rest: str) -> str {
    if str_starts_with(raw, "///  ") {
        return str_trim_end_char(rest, 13);
    }
    return str_trim_start(rest);
}

/// -1 unless `l` (trimmed) is doctest.py's example marker: 0 for
/// `Example:`, 1 for `Example (native only):`.
pub fn scribe_example_marker(l: str) -> i64 {
    if !str_starts_with(l, "Example") || !str_ends_with(l, ":") || str_len(l) < 8 {
        return -1;
    }
    var mid: str = str_trim(str_slice(l, 7, str_len(l) - 1));
    if str_len(mid) == 0 {
        return 0;
    }
    if mid == "(native only)" {
        return 1;
    }
    return -1;
}

/// The code of an example: doc lines `from` .. `to`, less the indentation
/// they share.
fn scribe_example_code(lines: Vec<str>, from: i64, to: i64) -> str {
    var indent: i64 = 1000000;
    var k: i64 = from;
    while k < to {
        var cl: str = lines.get(k);
        var sp: i64 = 0;
        while sp < str_len(cl) && str_byte_at(cl, sp) == 32 {
            sp = sp + 1;
        }
        if sp < str_len(cl) && sp < indent {
            indent = sp;
        }
        k = k + 1;
    }
    var out: str = "";
    k = from;
    while k < to {
        var cl2: str = lines.get(k);
        var code: str = "";
        if str_len(cl2) > indent {
            code = str_slice(cl2, indent, str_len(cl2));
        }
        if k > from {
            out = out + "\n";
        }
        out = out + code;
        k = k + 1;
    }
    return out;
}

/// The end (exclusive) of the example whose marker is doc line `i`: the
/// lines after it indented by two spaces or more.
fn scribe_example_end(lines: Vec<str>, i: i64) -> i64 {
    var end: i64 = i + 1;
    while end < lines.len() && str_starts_with(lines.get(end), "  ") {
        end = end + 1;
    }
    return end;
}

/// A doc comment as HTML: its lines joined with <br>, and each example
/// (doctest.py's convention) as a code block with a note that
/// scripts/doctest.py runs it.
pub fn scribe_doc_html(doc: str) -> str {
    var lines: Vec<str> = str_split(doc, "\n");
    var sb: StringBuilder = StringBuilder::new();
    var after_text: bool = false;
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = lines.get(i);
        var kind: i64 = scribe_example_marker(str_trim(l));
        var end: i64 = i + 1;
        if kind >= 0 {
            end = scribe_example_end(lines, i);
        }
        if kind >= 0 && end > i + 1 {
            sb.append_str("<p class=\"example-note\">Example");
            if kind == 1 {
                sb.append_str(" (native only)");
            }
            sb.append_str(" -- run as a test by <code>scripts/doctest.py</code></p>\n<pre class=\"example\"><code>");
            sb.append_str(escape_html(scribe_example_code(lines, i + 1, end)));
            sb.append_str("</code></pre>\n");
            after_text = false;
            i = end;
        } else {
            if after_text {
                sb.append_str("<br>\n");
            }
            sb.append_str(escape_html(str_trim(l)));
            after_text = true;
            i = i + 1;
        }
    }
    return sb.to_str();
}

/// A doc comment as Markdown, its examples as fenced code.
pub fn scribe_doc_md(doc: str) -> str {
    var lines: Vec<str> = str_split(doc, "\n");
    var out: str = "";
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = lines.get(i);
        var kind: i64 = scribe_example_marker(str_trim(l));
        var end: i64 = i + 1;
        if kind >= 0 {
            end = scribe_example_end(lines, i);
        }
        if kind >= 0 && end > i + 1 {
            var note: str = "Example";
            if kind == 1 {
                note = note + " (native only)";
            }
            out = out + "\n*" + note + " -- run as a test by `scripts/doctest.py`:*\n\n```fides\n" + scribe_example_code(lines, i + 1, end) + "\n```\n";
            i = end;
        } else {
            out = out + str_trim(l) + "\n";
            i = i + 1;
        }
    }
    return str_trim_end(out);
}

/// The directory part of `path` ("." for none).
fn scribe_dir_of(path: str) -> str {
    var p: str = str_replace(path, "\\", "/");
    var slash: i64 = str_rfind_char(p, 47);
    if slash < 0 {
        return ".";
    }
    if slash == 0 {
        return "/";
    }
    return str_slice(p, 0, slash);
}

/// The value of `key = "…"` in the [package] section (or before any
/// section) of an ark.toml, or "".
pub fn scribe_toml_value(toml: str, key: str) -> str {
    var lines: Vec<str> = str_split(toml, "\n");
    var section: str = "";
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim(lines.get(i));
        if str_starts_with(l, "[") {
            section = l;
        } else if (section == "" || section == "[package]") && str_starts_with(l, key) {
            var rest: str = str_trim(str_slice(l, str_len(key), str_len(l)));
            if str_starts_with(rest, "=") {
                var v: str = str_trim(str_slice(rest, 1, str_len(rest)));
                if str_starts_with(v, "\"") {
                    v = str_slice(v, 1, str_len(v));
                    var q: i64 = sc_str_find_char(v, 34);
                    if q >= 0 {
                        v = str_slice(v, 0, q);
                    }
                }
                return v;
            }
        }
        i = i + 1;
    }
    return "";
}

/// The version label of the documentation of `dir`: $FID_DOC_VERSION when
/// set; else the name and version of the package (an ark.toml in `dir` or
/// its parent); else the fid version (and the commit a release build has).
pub fn scribe_doc_version(dir: str) -> str {
    var label: str = "";
    match env_var("FID_DOC_VERSION") {
        Option::Some(v) => {
            label = str_trim(v);
        }
        Option::None => {
        }
    }
    if str_len(label) > 0 {
        return label;
    }
    var toml: str = "";
    match read_file(dir + "/ark.toml") {
        Option::Some(t) => {
            toml = t;
        }
        Option::None => {
        }
    }
    if str_len(toml) == 0 {
        match read_file(dir + "/../ark.toml") {
            Option::Some(t2) => {
                toml = t2;
            }
            Option::None => {
            }
        }
    }
    if str_len(toml) > 0 {
        var ver: str = scribe_toml_value(toml, "version");
        if str_len(ver) > 0 {
            var name: str = scribe_toml_value(toml, "name");
            if str_len(name) > 0 {
                return name + " " + ver;
            }
            return ver;
        }
    }
    label = "fid " + fid_version();
    if str_len(fid_build_commit()) > 0 {
        label = label + " (commit " + fid_build_commit() + ")";
    }
    return label;
}

/// TL11: a documentation site for the .fd files under `input_dir`, written
/// to `output_dir`: a page per module (as `fid doc <file>` writes it, with a
/// link back to the index) and an index — every module with the first line
/// of its file's leading comment and its count of public items, and (HTML)
/// a search box over every public item's name, kind and signature that
/// links to the item's anchor. Markdown: index.md with the module list.
pub fn scribe_site(input_dir: str, output_dir: str, format: str) -> str {
    p_mkdir(output_dir);
    var files: Vec<str> = Vec::new();
    scribe_collect(input_dir, &mut files);
    if files.len() == 0 {
        return "No .fd files under " + input_dir;
    }
    var md: bool = format == "markdown" || format == "md";
    var ext: str = "html";
    if md {
        ext = "md";
    }
    // TL11, pass 1: the types every page documents, so a signature on one
    // page links to a type documented on another
    var ctx: DocCtx = DocCtx_new();
    ctx.version = scribe_doc_version(input_dir);
    // each file's page name: its module's, or (when another file has that
    // name: stdlib/math.fd and a runtime's math.fd) its path under
    // input_dir with `/` as `_`, so no page overwrites another. A file
    // whose path is its module's name (stdlib/math.fd) keeps the name.
    var sources: Vec<str> = Vec::new();
    var mod_pages: Vec<str> = Vec::new();
    var path_pages: Vec<str> = Vec::new();
    var ti: i64 = 0;
    while ti < files.len() {
        var tsource: str = "";
        match read_file(files.get(ti)) {
            Option::Some(tsrc) => {
                tsource = tsrc;
            }
            Option::None => {
            }
        }
        sources.push(tsource);
        var rel: str = files.get(ti);
        if str_starts_with(rel, input_dir + "/") {
            rel = str_slice(rel, str_len(input_dir) + 1, str_len(rel));
        }
        if str_ends_with(rel, ".fd") {
            rel = str_slice(rel, 0, str_len(rel) - 3);
        }
        path_pages.push(str_replace(str_replace(scribe_page_name(rel), "/", "_"), "\\", "_"));
        if str_len(tsource) > 0 {
            mod_pages.push(scribe_page_name(extract_module_name(tsource, files.get(ti))));
        } else {
            mod_pages.push("");
        }
        ti = ti + 1;
    }
    var site_pages: Vec<str> = Vec::new();
    var used: HashMap<str, i64> = HashMap::new();
    // first the files at their module's path, then the rest
    var round: i64 = 0;
    while round < 2 {
        ti = 0;
        while ti < files.len() {
            var mp: str = mod_pages.get(ti);
            var pp: str = path_pages.get(ti);
            if round == 0 {
                if str_len(mp) > 0 && mp == pp && mp != "index" && !used.contains(mp) {
                    used.insert(mp, ti);
                    site_pages.push(mp);
                } else {
                    site_pages.push("");
                }
            } else if str_len(mp) > 0 && str_len(site_pages.get(ti)) == 0 {
                var tpage: str = mp;
                if used.contains(tpage) || tpage == "index" {
                    tpage = pp;
                    var k: i64 = 2;
                    while used.contains(tpage) || tpage == "index" {
                        tpage = pp + "_" + int_to_str(k);
                        k = k + 1;
                    }
                }
                used.insert(tpage, ti);
                site_pages.set(ti, tpage);
            }
            ti = ti + 1;
        }
        round = round + 1;
    }
    ti = 0;
    while ti < files.len() {
        if str_len(sources.get(ti)) > 0 {
            var titems: Vec<DocItem> = extract_docs(sources.get(ti));
            scribe_register_types(&mut ctx, titems, site_pages.get(ti));
        }
        ti = ti + 1;
    }
    var module_pages: Vec<str> = Vec::new();
    if !md {
        p_mkdir(output_dir + "/src");
    }
    // per module: (name, summary, public item count)
    var modules: Vec<StringTriple> = Vec::new();
    var search: str = "";
    var total_items: i64 = 0;
    var fi: i64 = 0;
    while fi < files.len() {
        var source: str = sources.get(fi);
        if str_len(source) > 0 {
            var items: Vec<DocItem> = extract_docs(source);
            var module_name: str = extract_module_name(source, files.get(fi));
            var page: str = site_pages.get(fi);
            if str_len(page) == 0 {
                page = scribe_page_name(module_name);
            }
            module_pages.push(page);
            var content: str = "";
            if md {
                content = "[All modules](index.md)\n\n" + generate_markdown(items, module_name);
            } else {
                // TL11: the module's source as a page with an id per line
                ctx.page = page;
                ctx.src_href = "src/" + page + ".html";
                ctx.src_label = files.get(fi);
                p_file_write(output_dir + "/" + ctx.src_href, scribe_source_page(source, files.get(fi), page));
                content = str_replace(generate_html_ctx(items, module_name, ctx), "<body>\n", "<body>\n<p><a href=\"index.html\">All modules</a></p>\n");
            }
            p_file_write(output_dir + "/" + page + "." + ext, content);
            var pub_count: i64 = 0;
            var ii: i64 = 0;
            while ii < items.len() {
                var it: DocItem = items.get(ii);
                if it.is_pub {
                    pub_count = pub_count + 1;
                    if !md {
                        search = search + "[\"" + scribe_js_str(page) + "\",\"" + scribe_js_str(module_name) + "\",\"" + scribe_js_str(it.kind) + "\",\"" + scribe_js_str(it.name) + "\",\"" + scribe_js_str(it.signature) + "\"],\n";
                    }
                }
                ii = ii + 1;
            }
            total_items = total_items + pub_count;
            modules.push(StringTriple_new(module_name, scribe_file_summary(source), int_to_str(pub_count)));
        }
        fi = fi + 1;
    }
    var index: str = "";
    if md {
        index = "# Modules\n\n";
        var mi: i64 = 0;
        while mi < modules.len() {
            var m: StringTriple = modules.get(mi);
            index = index + "- [" + m.a + "](" + module_pages.get(mi) + ".md) (" + m.c + " items)";
            if str_len(m.b) > 0 {
                index = index + " -- " + m.b;
            }
            index = index + "\n";
            mi = mi + 1;
        }
    } else {
        index = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<title>Fides Documentation</title>\n";
        index = index + "<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n";
        index = index + "<style>\n" + CSS + SCRIBE_CSS_MORE + "#q { width: 100%; padding: 8px; font-size: 1em; box-sizing: border-box; }\n#results li { padding: 3px 0; }\n</style>\n</head>\n<body>\n";
        index = index + "<h1>Modules</h1>\n";
        // TL11: which version of the library these pages document
        index = index + "<p class=\"version\">Version " + escape_html(ctx.version) + "</p>\n";
        index = index + "<input id=\"q\" type=\"search\" placeholder=\"Search " + int_to_str(total_items) + " functions, types and constants\" autofocus>\n<ul id=\"results\"></ul>\n";
        index = index + "<table>\n";
        var mj: i64 = 0;
        while mj < modules.len() {
            var m2: StringTriple = modules.get(mj);
            index = index + "<tr><td><a href=\"" + escape_html(module_pages.get(mj)) + ".html\">" + escape_html(m2.a) + "</a></td><td>" + escape_html(m2.b) + "</td><td class=\"line\">" + m2.c + " items</td></tr>\n";
            mj = mj + 1;
        }
        index = index + "</table>\n";
        index = index + "<script>\nconst ITEMS = [\n" + search + "];\n";
        index = index + "const q = document.getElementById('q'), res = document.getElementById('results');\n";
        index = index + "q.addEventListener('input', () => {\n  const t = q.value.toLowerCase(); res.innerHTML = '';\n  if (!t) return;\n  let n = 0;\n";
        index = index + "  for (const it of ITEMS) {\n    if (!it[3].toLowerCase().includes(t)) continue;\n";
        index = index + "    const li = document.createElement('li'), a = document.createElement('a');\n";
        index = index + "    a.href = it[0] + '.html#' + (it[2] === 'impl' ? 'impl-' : '') + it[3]; a.textContent = it[3]; li.appendChild(a);\n";
        index = index + "    const k = document.createElement('span'); k.className = 'kind'; k.textContent = ' ' + it[2] + ' in ' + it[1] + ': ' + it[4];\n";
        index = index + "    li.appendChild(k); res.appendChild(li);\n    if (++n >= 50) break;\n  }\n});\n</script>\n";
        index = index + "<footer><p>Generated by scribe -- Fides documentation generator</p></footer>\n</body>\n</html>\n";
    }
    p_file_write(output_dir + "/index." + ext, index);
    return "Generated " + output_dir + "/index." + ext + ": " + int_to_str(modules.len()) + " module(s), " + int_to_str(total_items) + " public item(s)";
}

fn extract_module_name(source: str, fallback_path: str) -> str {
    var lines: Vec<str> = str_split(source, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim_start(lines.get(i));
        if str_starts_with(l, "module ") {
            var s: str = str_slice(l, 7, str_len(l));
            // `module a; use b; ...` on one line: the name ends at the `;`
            var semi: i64 = sc_str_find_char(s, 59);
            if semi >= 0 {
                s = str_slice(s, 0, semi);
            }
            s = str_trim(s);
            s = str_trim_end_char(s, 59);
            // remove trailing ';'
            s = str_trim(s);
            if str_len(s) > 0 {
                return s;
            }
        }
        i = i + 1;
    }
    // Fall back to filename without extension
    var name: str = fallback_path;
    var slash: i64 = str_rfind_char(name, 47);
    // '/'
    if slash >= 0 {
        name = str_slice(name, slash + 1, str_len(name));
    }
    var dot: i64 = str_rfind_char(name, 46);
    // '.'
    if dot >= 0 {
        name = str_slice(name, 0, dot);
    }
    if str_len(name) == 0 {
        return "module";
    }
    return name;
}

// --- Help ---

pub fn scribe_print_help() -> str {
    return "scribe -- Documentation generator for Fides\n\n" + "USAGE:\n" + "    scribe <file.fd> [--output <dir>] [--format html|markdown]\n" + "    scribe <dir>    [--output <dir>] [--format html|markdown]\n\n" + "OPTIONS:\n" + "    --output <dir>      Output directory (default: docs/)\n" + "    --format <format>   Output format: html (default) or markdown\n" + "    --help, -h          Show this help\n\n" + "EXAMPLES:\n" + "    scribe stdlib/math.fd                    # Generate HTML docs\n" + "    scribe stdlib/ --output docs/            # Generate docs for all stdlib\n" + "    scribe stdlib/ --format markdown         # Generate Markdown docs\n";
}

// --- Local helpers ---

fn sc_str_find_char(s: str, ch: i64) -> i64 {
    var i: i64 = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) == ch {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn str_rfind_char(s: str, ch: i64) -> i64 {
    var i: i64 = str_len(s) - 1;
    while i >= 0 {
        if str_byte_at(s, i) == ch {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

fn str_find_str(s: str, substr: str) -> i64 {
    var slen: i64 = str_len(substr);
    if slen == 0 {
        return 0;
    }
    var i: i64 = 0;
    while i + slen <= str_len(s) {
        var matched: bool = true;
        var j: i64 = 0;
        while j < slen {
            if str_byte_at(s, i + j) != str_byte_at(substr, j) {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn str_trim_start_str(s: str, prefix: str) -> str {
    var plen: i64 = str_len(prefix);
    if plen == 0 {
        return s;
    }
    if str_len(s) < plen {
        return s;
    }
    var i: i64 = 0;
    while i < plen {
        if str_byte_at(s, i) != str_byte_at(prefix, i) {
            return s;
        }
        i = i + 1;
    }
    return str_slice(s, plen, str_len(s));
}

// --- Entry point ---

/// Make `path` and every parent it lacks (as fs::create_dir_all); an
/// existing directory is fine. Both separators count.
pub fn scribe_mkdir_all(path: str) {
    var n: i64 = str_len(path);
    var i: i64 = 1;
    while i < n {
        var c: i64 = str_byte_at(path, i);
        if (c == 47 || c == 92) && str_byte_at(path, i - 1) != 58 {
            var _p: i64 = p_mkdir(str_slice(path, 0, i));
        }
        i = i + 1;
    }
    if n > 0 {
        var _q: i64 = p_mkdir(path);
    }
}

/// Command-line argument `i`, "" past the last.
fn scribe_arg(i: i64) -> str {
    match arg_at(i) {
        Option::Some(a) => {
            return a;
        }
        Option::None => {
        }
    }
    return "";
}

pub fn scribe_help_text() -> str {
    return "scribe -- Documentation generator for Fides\n\n" + "USAGE:\n" + "    scribe <file.fd> [--output <dir>] [--format html|markdown]\n" + "    scribe <dir>    [--output <dir>] [--format html|markdown]\n\n" + "OPTIONS:\n" + "    --output <dir>      Output directory (default: docs/)\n" + "    --format <format>   Output format: html (default) or markdown\n" + "    --help, -h          Show this help\n\n" + "EXAMPLES:\n" + "    scribe stdlib/math.fd                    # Generate HTML docs\n" + "    scribe stdlib/ --output docs/            # Generate docs for all stdlib\n" + "    scribe stdlib/ --format markdown         # Generate Markdown docs\n";
}

/// Is `message` (from process_directory) a failure?
fn scribe_failed(message: str) -> bool {
    return str_starts_with(message, "Cannot ") || str_starts_with(message, "No .fd files");
}

/// Standalone `scribe.exe` entry; also serves `fid scribe` (skips the
/// leading "scribe" argument, and a "--" separator from `fid run`).
/// Arguments as the Rust scribe takes them (src/bin/scribe.rs, AD1):
/// options anywhere, `-o`/`-f` short forms, `--help`/`-h` (exit 0),
/// `--version`/`-v`, one input; an error goes to stderr with exit 1.
pub fn scribe_main() -> i64 {
    var n: i64 = p_argc();
    var start: i64 = 1;
    var i: i64 = 0;
    while i < n {
        if scribe_arg(i) == "--" {
            start = i + 1;
            break;
        }
        i = i + 1;
    }
    if start < n && scribe_arg(start) == "scribe" {
        start = start + 1;
    }
    if start >= n {
        print(scribe_help_text());
        return 1;
    }
    var input: str = "";
    var have_input: bool = false;
    var format: str = "html";
    var output_dir: str = "docs";
    i = start;
    while i < n {
        var a: str = scribe_arg(i);
        if a == "--format" || a == "-f" {
            if i + 1 < n {
                format = scribe_arg(i + 1);
            }
            i = i + 1;
        } else if a == "--output" || a == "-o" {
            if i + 1 < n {
                output_dir = scribe_arg(i + 1);
            }
            i = i + 1;
        } else if a == "--help" || a == "-h" {
            print(scribe_help_text());
            return 0;
        } else if a == "--version" || a == "-v" {
            print("scribe 0.1.0 -- Fides documentation generator\n");
            return 0;
        } else if !have_input {
            input = a;
            have_input = true;
        } else {
            p_eprint_str("Unknown argument: " + a + "\n");
            return 1;
        }
        i = i + 1;
    }
    if !have_input {
        p_eprint_str("Error: no input file or directory specified\nRun 'scribe --help' for usage.\n");
        return 1;
    }
    // a file is one page; a directory is a site (TL11)
    var message: str = process_directory(input, output_dir, format);
    if scribe_failed(message) {
        p_eprint_str("error: " + message + "\n");
        return 1;
    }
    print(message);
    print("\n");
    return 0;
}
