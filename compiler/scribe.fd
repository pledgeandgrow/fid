// scribe.fd -- Documentation generator for the Fides programming language
// Ported from src/scribe.rs.
//
// Parses .fd source files, extracts doc comments (///), and generates
// HTML or Markdown documentation.
//
// Usage:
//   scribe <file.fd> [--output <dir>] [--format html|markdown]
//   scribe <dir>    [--output <dir>]
//
// Output:
//   HTML/Markdown files in the specified output directory (default: docs/)

module compiler::scribe;

use core;
use vec;
use string;

// Wrapper structs for tuple-like data (Fides has no tuples)
pub struct StringPair {
    pub a: str,
    pub b: str,
}

pub fn StringPair_new(a: str, b: str) -> StringPair {
    return StringPair { a: a, b: b };
}

pub struct StringTriple {
    pub a: str,
    pub b: str,
    pub c: str,
}

pub fn StringTriple_new(a: str, b: str, c: str) -> StringTriple {
    return StringTriple { a: a, b: b, c: c };
}

pub struct ParamsRet {
    pub params: Vec<StringPair>,
    pub ret_type: str,
}

pub fn ParamsRet_new(params: Vec<StringPair>, ret_type: str) -> ParamsRet {
    return ParamsRet { params: params, ret_type: ret_type };
}

// --- DocItem ---

pub struct DocItem {
    pub kind: str,           // "function", "struct", "enum", "impl", "const", "trait"
    pub name: str,
    pub signature: str,      // source-level signature
    pub doc: str,            // doc comment text (/// lines joined)
    pub line: i64,           // source line number
    pub fields: Vec<StringTriple>,  // (name, type, doc) for struct fields
    pub params: Vec<StringPair>,       // (name, type) for function params
    pub ret_type: str,
    pub methods: Vec<DocItem>,         // for impl blocks
    pub variants: Vec<StringPair>,     // (name, doc) for enum variants
    pub is_pub: bool,
}

pub fn DocItem_new(kind: str, name: str, signature: str, doc: str, line: i64, is_pub: bool) -> DocItem {
    return DocItem {
        kind: kind,
        name: name,
        signature: signature,
        doc: doc,
        line: line,
        fields: Vec::new(),
        params: Vec::new(),
        ret_type: "",
        methods: Vec::new(),
        variants: Vec::new(),
        is_pub: is_pub,
    };
}

// --- Doc extraction ---

/// Extract doc comments and items from source text
pub fn extract_docs(source: str) -> Vec<DocItem> {
    var items: Vec<DocItem> = Vec::new();
    var lines: Vec<str> = str_split(source, "\n");
    var i: i64 = 0;

    while i < lines.len() {
        // Collect doc comments (/// prefix)
        var doc_lines: Vec<str> = Vec::new();
        while i < lines.len() {
            var trimmed: str = str_trim_start(lines.get(i));
            if str_starts_with(trimmed, "///") {
                var rest: str = str_slice(trimmed, 3, str_len(trimmed));
                doc_lines.push(str_trim_start(rest));
                i = i + 1;
            } else if str_starts_with(trimmed, "//") {
                i = i + 1;
            } else if str_len(trimmed) == 0 {
                i = i + 1;
            } else {
                break;
            }
        }

        if i >= lines.len() { break; }

        var line: str = str_trim_start(lines.get(i));
        var doc: str = "";
        var di: i64 = 0;
        while di < doc_lines.len() {
            if di > 0 { doc = doc + "\n"; }
            doc = doc + doc_lines.get(di);
            di = di + 1;
        }

        // Detect item type
        if str_starts_with(line, "pub fn ") || str_starts_with(line, "fn ") {
            var result: ParseResult = parse_function(lines, i, doc);
            match result.item {
                OptionDocItem::Some(it) => { items.push(it); }
                OptionDocItem::None => {}
            }
            i = result.end;
        } else if str_starts_with(line, "pub struct ") || str_starts_with(line, "struct ") {
            var result: ParseResult = scribe_parse_struct(lines, i, doc);
            match result.item {
                OptionDocItem::Some(it) => { items.push(it); }
                OptionDocItem::None => {}
            }
            i = result.end;
        } else if str_starts_with(line, "pub enum ") || str_starts_with(line, "enum ") {
            var result: ParseResult = scribe_parse_enum(lines, i, doc);
            match result.item {
                OptionDocItem::Some(it) => { items.push(it); }
                OptionDocItem::None => {}
            }
            i = result.end;
        } else if str_starts_with(line, "impl ") {
            var result: ParseResult = parse_impl(lines, i, doc);
            match result.item {
                OptionDocItem::Some(it) => { items.push(it); }
                OptionDocItem::None => {}
            }
            i = result.end;
        } else if str_starts_with(line, "pub const ") || str_starts_with(line, "const ") {
            var result: ParseResult = scribe_parse_const(lines, i, doc);
            match result.item {
                OptionDocItem::Some(it) => { items.push(it); }
                OptionDocItem::None => {}
            }
            i = result.end;
        } else if str_starts_with(line, "cap ") || str_starts_with(line, "pub cap ") {
            var result: ParseResult = scribe_parse_trait(lines, i, doc);
            match result.item {
                OptionDocItem::Some(it) => { items.push(it); }
                OptionDocItem::None => {}
            }
            i = result.end;
        } else {
            i = i + 1;
        }
    }

    return items;
}

// --- Option type ---

pub enum OptionDocItem { Some(DocItem), None }

// --- Parse result (item + end index) ---

pub struct ParseResult {
    pub item: OptionDocItem,
    pub end: i64,
}

pub fn ParseResult_new(item: OptionDocItem, end: i64) -> ParseResult {
    return ParseResult { item: item, end: end };
}

// --- Parsers ---

fn parse_function(lines: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var is_pub: bool = str_starts_with(line, "pub ");
    var sig: str = line;
    if is_pub { sig = str_slice(line, 4, str_len(line)); }

    var name: str = extract_name_after(sig, "fn ");
    if str_len(name) == 0 { return ParseResult_new(OptionDocItem::None, start + 1); }

    var params_ret: ParamsRet = extract_params_and_return(line);

    // Find end of function (opening { or ; for declarations)
    var end: i64 = start;
    var brace_depth: i64 = 0;
    var found_brace: bool = false;
    while end < lines.len() {
        var l: str = lines.get(end);
        var ci: i64 = 0;
        while ci < str_len(l) {
            var c: i64 = str_byte_at(l, ci);
            if c == 123 { brace_depth = brace_depth + 1; found_brace = true; }
            else if c == 125 { brace_depth = brace_depth - 1; }
            ci = ci + 1;
        }
        end = end + 1;
        if found_brace && brace_depth == 0 { break; }
        // Declaration without body
        if !found_brace && str_ends_with(str_trim_end(l), ";") { break; }
    }

    var item: DocItem = DocItem_new("function", name, str_trim(line), doc, start + 1, is_pub);
    item.params = params_ret.params;
    item.ret_type = params_ret.ret_type;
    return ParseResult_new(OptionDocItem::Some(item), end);
}

fn scribe_parse_struct(lines: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var is_pub: bool = str_starts_with(line, "pub ");
    var sig: str = line;
    if is_pub { sig = str_slice(line, 4, str_len(line)); }

    var name: str = extract_name_after(sig, "struct ");
    if str_len(name) == 0 { return ParseResult_new(OptionDocItem::None, start + 1); }

    var item: DocItem = DocItem_new("struct", name, str_trim(line), doc, start + 1, is_pub);

    // Parse fields inside { } -- scan forward from start
    var i: i64 = start;
    var in_body: bool = false;
    var brace_depth: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim(lines.get(i));
        var ci: i64 = 0;
        while ci < str_len(l) {
            var c: i64 = str_byte_at(l, ci);
            if c == 123 { // '{'
                brace_depth = brace_depth + 1;
                in_body = true;
            } else if c == 125 { // '}'
                brace_depth = brace_depth - 1;
            }
            ci = ci + 1;
        }
        if in_body && brace_depth > 0 && !str_starts_with(l, "{") && !str_starts_with(l, "}") {
            var field_line: str = str_trim_end_char(l, 44); // remove trailing comma
            var colon_pos: i64 = sc_str_find_char(field_line, ":");
            if colon_pos >= 0 {
                var field_name: str = str_trim(str_slice(field_line, 0, colon_pos));
                field_name = str_trim_start_str(field_name, "pub ");
                field_name = str_trim(field_name);
                var field_type: str = str_trim(str_slice(field_line, colon_pos + 1, str_len(field_line)));
                if str_len(field_name) > 0 && !str_starts_with(field_name, "//") {
                    item.fields.push(StringTriple_new(field_name, field_type, ""));
                }
            }
        }
        i = i + 1;
        if in_body && brace_depth == 0 { break; }
    }

    return ParseResult_new(OptionDocItem::Some(item), i);
}

fn scribe_parse_enum(lines: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var is_pub: bool = str_starts_with(line, "pub ");
    var sig: str = line;
    if is_pub { sig = str_slice(line, 4, str_len(line)); }

    var name: str = extract_name_after(sig, "enum ");
    if str_len(name) == 0 { return ParseResult_new(OptionDocItem::None, start + 1); }

    var item: DocItem = DocItem_new("enum", name, str_trim(line), doc, start + 1, is_pub);

    // Parse variants inside { }
    var i: i64 = start;
    var in_body: bool = false;
    var brace_depth: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim(lines.get(i));
        var ci: i64 = 0;
        while ci < str_len(l) {
            var c: i64 = str_byte_at(l, ci);
            if c == 123 { brace_depth = brace_depth + 1; in_body = true; }
            else if c == 125 { brace_depth = brace_depth - 1; }
            ci = ci + 1;
        }
        if in_body && brace_depth > 0 && !str_starts_with(l, "{") && !str_starts_with(l, "}") && str_len(l) > 0 {
            var var_line: str = str_trim_end_char(l, 44); // remove trailing comma
            // Variant: "Ok(i64)" or "None" or "Ok(i64, str)"
            var var_name: str = var_line;
            var paren_pos: i64 = sc_str_find_char(var_line, "(");
            if paren_pos >= 0 {
                var_name = str_slice(var_line, 0, paren_pos);
            }
            var_name = str_trim(var_name);
            if str_len(var_name) > 0 {
                item.variants.push(StringPair_new(var_name, ""));
            }
        }
        i = i + 1;
        if in_body && brace_depth == 0 { break; }
    }

    return ParseResult_new(OptionDocItem::Some(item), i);
}

fn parse_impl(lines: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var name: str = extract_name_after(line, "impl ");

    // Could be "impl Trait for Struct" -- extract struct name
    var struct_name: str = name;
    var fpos: i64 = str_find_str(name, " for ");
    if fpos >= 0 {
        struct_name = str_trim(str_slice(name, fpos + 5, str_len(name)));
    }

    var item: DocItem = DocItem_new("impl", struct_name, str_trim(line), doc, start + 1, true);

    // Parse methods inside { }
    var i: i64 = start;
    var brace_depth: i64 = 0;
    var in_body: bool = false;
    var method_doc_lines: Vec<str> = Vec::new();
    while i < lines.len() {
        var l: str = str_trim_start(lines.get(i));

        // Collect doc comments for methods
        if str_starts_with(l, "///") {
            var rest: str = str_slice(l, 3, str_len(l));
            method_doc_lines.push(str_trim_start(rest));
            i = i + 1;
            continue;
        }
        if str_starts_with(l, "//") || str_len(l) == 0 {
            if !str_starts_with(l, "///") {
                method_doc_lines = Vec::new();
            }
            i = i + 1;
            continue;
        }

        var ci: i64 = 0;
        while ci < str_len(l) {
            var c: i64 = str_byte_at(l, ci);
            if c == 123 { brace_depth = brace_depth + 1; in_body = true; }
            else if c == 125 { brace_depth = brace_depth - 1; }
            ci = ci + 1;
        }

        // Detect method: "pub fn name(" or "fn name("
        if in_body && brace_depth == 1 && (str_starts_with(l, "pub fn ") || str_starts_with(l, "fn ")) {
            var method_doc: str = "";
            var di: i64 = 0;
            while di < method_doc_lines.len() {
                if di > 0 { method_doc = method_doc + "\n"; }
                method_doc = method_doc + method_doc_lines.get(di);
                di = di + 1;
            }
            method_doc_lines = Vec::new();
            var mresult: ParseResult = parse_function(lines, i, method_doc);
            match mresult.item {
                OptionDocItem::Some(mit) => { item.methods.push(mit); }
                OptionDocItem::None => {}
            }
            i = mresult.end;
            continue;
        }

        i = i + 1;
        if in_body && brace_depth == 0 { break; }
    }

    return ParseResult_new(OptionDocItem::Some(item), i);
}

fn scribe_parse_const(lines: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var is_pub: bool = str_starts_with(line, "pub ");
    var sig: str = line;
    if is_pub { sig = str_slice(line, 4, str_len(line)); }
    var name: str = extract_name_after(sig, "const ");
    var item: DocItem = DocItem_new("const", name, str_trim(line), doc, start + 1, is_pub);
    return ParseResult_new(OptionDocItem::Some(item), start + 1);
}

fn scribe_parse_trait(lines: Vec<str>, start: i64, doc: str) -> ParseResult {
    var line: str = str_trim_start(lines.get(start));
    var is_pub: bool = str_starts_with(line, "pub ");
    var sig: str = line;
    if is_pub { sig = str_slice(line, 4, str_len(line)); }
    var name: str = extract_name_after(sig, "cap ");
    if str_len(name) == 0 { return ParseResult_new(OptionDocItem::None, start + 1); }

    // Find end of trait body (matching braces)
    var end: i64 = start;
    var brace_depth: i64 = 0;
    while end < lines.len() {
        var l: str = lines.get(end);
        var ci: i64 = 0;
        while ci < str_len(l) {
            var c: i64 = str_byte_at(l, ci);
            if c == 123 { brace_depth = brace_depth + 1; }
            else if c == 125 { brace_depth = brace_depth - 1; }
            ci = ci + 1;
        }
        end = end + 1;
        if brace_depth == 0 && end > start + 1 { break; }
    }

    var item: DocItem = DocItem_new("trait", name, str_trim(line), doc, start + 1, is_pub);
    return ParseResult_new(OptionDocItem::Some(item), end);
}

// --- Helpers ---

pub fn extract_name_after(s: str, prefix: str) -> str {
    var pos: i64 = str_find_str(s, prefix);
    if pos < 0 { return ""; }
    var after: str = str_slice(s, pos + str_len(prefix), str_len(s));
    // Name ends at (, <, {, space, or ;
    var end: i64 = str_len(after);
    var i: i64 = 0;
    while i < str_len(after) {
        var c: i64 = str_byte_at(after, i);
        if c == 40 || c == 60 || c == 123 || c == 32 || c == 59 { // ( < { space ;
            end = i;
            break;
        }
        i = i + 1;
    }
    return str_trim(str_slice(after, 0, end));
}

fn extract_params_and_return(line: str) -> ParamsRet {
    var params: Vec<StringPair> = Vec::new();
    var ret_type: str = "";

    // Find params between first ( and matching )
    var start: i64 = sc_str_find_char(line, "(");
    if start < 0 { return ParamsRet_new(params, ret_type); }

    var depth: i64 = 1;
    var end: i64 = start + 1;
    while end < str_len(line) && depth > 0 {
        var c: i64 = str_byte_at(line, end);
        if c == 40 { depth = depth + 1; }
        else if c == 41 { depth = depth - 1; }
        end = end + 1;
    }
    var params_str: str = str_slice(line, start + 1, end - 1);

    // Split by comma
    var parts: Vec<str> = str_split_char(params_str, 44); // ','
    var pi: i64 = 0;
    while pi < parts.len() {
        var param: str = str_trim(parts.get(pi));
        if str_len(param) > 0 {
            var colon: i64 = sc_str_find_char(param, ":");
            if colon >= 0 {
                var pname: str = str_trim_start_str(str_slice(param, 0, colon), "pub ");
                pname = str_trim(pname);
                var pty: str = str_trim(str_slice(param, colon + 1, str_len(param)));
                params.push(StringPair_new(pname, pty));
            }
        }
        pi = pi + 1;
    }

    // Return type after ->
    var after_parens: str = str_slice(line, end, str_len(line));
    var arrow: i64 = str_find_str(after_parens, "->");
    if arrow >= 0 {
        var ret: str = str_trim(str_slice(after_parens, arrow + 2, str_len(after_parens)));
        // Find end at { or ;
        var ret_end: i64 = str_len(ret);
        var ri: i64 = 0;
        while ri < str_len(ret) {
            var c: i64 = str_byte_at(ret, ri);
            if c == 123 || c == 59 { ret_end = ri; break; }
            ri = ri + 1;
        }
        ret_type = str_trim(str_slice(ret, 0, ret_end));
    }

    return ParamsRet_new(params, ret_type);
}

pub fn escape_html(s: str) -> str {
    var result: str = str_replace(s, "&", "&" + "amp;");
    result = str_replace(result, "<", "&" + "lt;");
    result = str_replace(result, ">", "&" + "gt;");
    result = str_replace(result, "\"", "&" + "quot;");
    return result;
}

// --- HTML generation ---

pub fn generate_html(items: Vec<DocItem>, module_name: str) -> str {
    var html: str = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n";
    html = html + "<title>" + escape_html(module_name) + " -- Fides Documentation</title>\n";
    html = html + "<meta charset=\"utf-8\">\n";
    html = html + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n";
    html = html + "<style>\n" + CSS + "</style>\n";
    html = html + "</head>\n<body>\n";

    html = html + "<h1>" + escape_html(module_name) + "</h1>\n";
    html = html + "<nav class=\"sidebar\">\n<ul>\n";

    var i: i64 = 0;
    while i < items.len() {
        var item: DocItem = items.get(i);
        if item.is_pub || str_equal(item.kind, "impl") {
            html = html + "<li><a href=\"#" + escape_html(item.name) + "\">"
                + escape_html(item.name) + " <span class=\"kind\">" + item.kind + "</span></a></li>\n";
        }
        i = i + 1;
    }
    html = html + "</ul>\n</nav>\n";

    html = html + "<main>\n";

    // Group items by kind
    var functions: Vec<DocItem> = Vec::new();
    var structs: Vec<DocItem> = Vec::new();
    var enums: Vec<DocItem> = Vec::new();
    var impls: Vec<DocItem> = Vec::new();
    var consts: Vec<DocItem> = Vec::new();
    var traits: Vec<DocItem> = Vec::new();

    i = 0;
    while i < items.len() {
        var item: DocItem = items.get(i);
        if str_equal(item.kind, "function") && item.is_pub {
            functions.push(item);
        } else if str_equal(item.kind, "struct") && item.is_pub {
            structs.push(item);
        } else if str_equal(item.kind, "enum") && item.is_pub {
            enums.push(item);
        } else if str_equal(item.kind, "impl") {
            impls.push(item);
        } else if str_equal(item.kind, "const") && item.is_pub {
            consts.push(item);
        } else if str_equal(item.kind, "trait") {
            traits.push(item);
        }
        i = i + 1;
    }

    if functions.len() > 0 {
        html = html + "<h2 id=\"functions\">Functions</h2>\n";
        i = 0;
        while i < functions.len() {
            html = html + render_function(functions.get(i));
            i = i + 1;
        }
    }

    if structs.len() > 0 {
        html = html + "<h2 id=\"structs\">Structs</h2>\n";
        i = 0;
        while i < structs.len() {
            html = html + render_struct(structs.get(i));
            i = i + 1;
        }
    }

    if enums.len() > 0 {
        html = html + "<h2 id=\"enums\">Enums</h2>\n";
        i = 0;
        while i < enums.len() {
            html = html + render_enum(enums.get(i));
            i = i + 1;
        }
    }

    if impls.len() > 0 {
        html = html + "<h2 id=\"impls\">Implementations</h2>\n";
        i = 0;
        while i < impls.len() {
            html = html + render_impl(impls.get(i));
            i = i + 1;
        }
    }

    if consts.len() > 0 {
        html = html + "<h2 id=\"consts\">Constants</h2>\n";
        i = 0;
        while i < consts.len() {
            html = html + render_const(consts.get(i));
            i = i + 1;
        }
    }

    if traits.len() > 0 {
        html = html + "<h2 id=\"traits\">Traits</h2>\n";
        i = 0;
        while i < traits.len() {
            html = html + render_trait(traits.get(i));
            i = i + 1;
        }
    }

    html = html + "</main>\n";
    html = html + "<footer><p>Generated by scribe -- Fides documentation generator</p></footer>\n";
    html = html + "</body>\n</html>\n";
    return html;
}

fn render_function(item: DocItem) -> str {
    var html: str = "<section id=\"" + escape_html(item.name) + "\">\n";
    html = html + "<h3>" + escape_html(item.name) + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + escape_html(str_replace(item.doc, "\n", "<br>\n")) + "</div>\n";
    }
    html = html + "<pre class=\"signature\">" + escape_html(item.signature) + "</pre>\n";

    if item.params.len() > 0 {
        html = html + "<h4>Parameters</h4>\n<table>\n";
        var pi: i64 = 0;
        while pi < item.params.len() {
            var param: StringPair = item.params.get(pi);
            html = html + "<tr><td class=\"name\">" + escape_html(param.a) + "</td><td class=\"type\">" + escape_html(param.b) + "</td></tr>\n";
            pi = pi + 1;
        }
        html = html + "</table>\n";
    }

    if str_len(item.ret_type) > 0 {
        html = html + "<h4>Returns</h4>\n<p class=\"type\">" + escape_html(item.ret_type) + "</p>\n";
    }

    html = html + "<p class=\"location\">Defined at line " + int_to_str(item.line) + "</p>\n";
    html = html + "</section>\n";
    return html;
}

fn render_struct(item: DocItem) -> str {
    var html: str = "<section id=\"" + escape_html(item.name) + "\">\n";
    html = html + "<h3>" + escape_html(item.name) + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + escape_html(str_replace(item.doc, "\n", "<br>\n")) + "</div>\n";
    }
    html = html + "<pre class=\"signature\">" + escape_html(item.signature) + "</pre>\n";

    if item.fields.len() > 0 {
        html = html + "<h4>Fields</h4>\n<table>\n";
        var fi: i64 = 0;
        while fi < item.fields.len() {
            var field: StringTriple = item.fields.get(fi);
            html = html + "<tr><td class=\"name\">" + escape_html(field.a) + "</td><td class=\"type\">" + escape_html(field.b) + "</td><td class=\"doc\">" + escape_html(field.c) + "</td></tr>\n";
            fi = fi + 1;
        }
        html = html + "</table>\n";
    }

    html = html + "<p class=\"location\">Defined at line " + int_to_str(item.line) + "</p>\n";
    html = html + "</section>\n";
    return html;
}

fn render_enum(item: DocItem) -> str {
    var html: str = "<section id=\"" + escape_html(item.name) + "\">\n";
    html = html + "<h3>" + escape_html(item.name) + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + escape_html(str_replace(item.doc, "\n", "<br>\n")) + "</div>\n";
    }
    html = html + "<pre class=\"signature\">" + escape_html(item.signature) + "</pre>\n";

    if item.variants.len() > 0 {
        html = html + "<h4>Variants</h4>\n<ul>\n";
        var vi: i64 = 0;
        while vi < item.variants.len() {
            var variant: StringPair = item.variants.get(vi);
            html = html + "<li><span class=\"name\">" + escape_html(variant.a) + "</span> <span class=\"doc\">" + escape_html(variant.b) + "</span></li>\n";
            vi = vi + 1;
        }
        html = html + "</ul>\n";
    }

    html = html + "<p class=\"location\">Defined at line " + int_to_str(item.line) + "</p>\n";
    html = html + "</section>\n";
    return html;
}

fn render_impl(item: DocItem) -> str {
    var html: str = "<section id=\"impl-" + escape_html(item.name) + "\">\n";
    html = html + "<h3>impl " + escape_html(item.name) + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + escape_html(str_replace(item.doc, "\n", "<br>\n")) + "</div>\n";
    }

    if item.methods.len() > 0 {
        html = html + "<h4>Methods</h4>\n";
        var mi: i64 = 0;
        while mi < item.methods.len() {
            html = html + render_function(item.methods.get(mi));
            mi = mi + 1;
        }
    }

    html = html + "</section>\n";
    return html;
}

fn render_const(item: DocItem) -> str {
    var html: str = "<section id=\"" + escape_html(item.name) + "\">\n";
    html = html + "<h3>" + escape_html(item.name) + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + escape_html(str_replace(item.doc, "\n", "<br>\n")) + "</div>\n";
    }
    html = html + "<pre class=\"signature\">" + escape_html(item.signature) + "</pre>\n";
    html = html + "<p class=\"location\">Defined at line " + int_to_str(item.line) + "</p>\n";
    html = html + "</section>\n";
    return html;
}

fn render_trait(item: DocItem) -> str {
    var html: str = "<section id=\"" + escape_html(item.name) + "\">\n";
    html = html + "<h3>cap " + escape_html(item.name) + "</h3>\n";
    if str_len(item.doc) > 0 {
        html = html + "<div class=\"doc\">" + escape_html(str_replace(item.doc, "\n", "<br>\n")) + "</div>\n";
    }
    html = html + "<pre class=\"signature\">" + escape_html(item.signature) + "</pre>\n";
    html = html + "<p class=\"location\">Defined at line " + int_to_str(item.line) + "</p>\n";
    html = html + "</section>\n";
    return html;
}

// --- Markdown generation ---

pub fn generate_markdown(items: Vec<DocItem>, module_name: str) -> str {
    var md: str = "# " + module_name + " -- Fides Documentation\n\n";

    // Table of contents
    md = md + "## Contents\n\n";
    var i: i64 = 0;
    while i < items.len() {
        var item: DocItem = items.get(i);
        if item.is_pub || str_equal(item.kind, "impl") {
            md = md + "- [" + item.name + "](#" + item.name + ") (" + item.kind + ")\n";
        }
        i = i + 1;
    }
    md = md + "\n";

    i = 0;
    while i < items.len() {
        var item: DocItem = items.get(i);
        if !item.is_pub && !str_equal(item.kind, "impl") {
            i = i + 1;
            continue;
        }
        md = md + "## " + item.name + "\n\n";
        if str_len(item.doc) > 0 {
            md = md + item.doc + "\n\n";
        }
        md = md + "```fides\n" + item.signature + "\n```\n\n";

        if str_equal(item.kind, "function") {
            if item.params.len() > 0 {
                md = md + "**Parameters:**\n\n";
                var pi: i64 = 0;
                while pi < item.params.len() {
                    var param: StringPair = item.params.get(pi);
                    md = md + "- `" + param.a + "`: `" + param.b + "`\n";
                    pi = pi + 1;
                }
                md = md + "\n";
            }
            if str_len(item.ret_type) > 0 {
                md = md + "**Returns:** `" + item.ret_type + "`\n\n";
            }
        }

        if str_equal(item.kind, "struct") && item.fields.len() > 0 {
            md = md + "**Fields:**\n\n";
            md = md + "| Name | Type |\n|------|------|\n";
            var fi: i64 = 0;
            while fi < item.fields.len() {
                var field: StringTriple = item.fields.get(fi);
                md = md + "| `" + field.a + "` | `" + field.b + "` |\n";
                fi = fi + 1;
            }
            md = md + "\n";
        }

        if str_equal(item.kind, "enum") && item.variants.len() > 0 {
            md = md + "**Variants:**\n\n";
            var vi: i64 = 0;
            while vi < item.variants.len() {
                var variant: StringPair = item.variants.get(vi);
                md = md + "- `" + variant.a + "`\n";
                vi = vi + 1;
            }
            md = md + "\n";
        }

        if str_equal(item.kind, "impl") && item.methods.len() > 0 {
            md = md + "**Methods:**\n\n";
            var mi: i64 = 0;
            while mi < item.methods.len() {
                var method: DocItem = item.methods.get(mi);
                md = md + "### " + method.name + "\n\n";
                if str_len(method.doc) > 0 {
                    md = md + method.doc + "\n\n";
                }
                md = md + "```fides\n" + method.signature + "\n```\n\n";
                mi = mi + 1;
            }
        }

        md = md + "*Defined at line " + int_to_str(item.line) + "*\n\n---\n\n";
        i = i + 1;
    }

    md = md + "*Generated by [scribe](https://fides.dev) -- Fides documentation generator*\n";
    return md;
}

// --- CSS ---

pub const CSS: str = "body { font-family: -apple-system, sans-serif; max-width: 900px; margin: 0 auto; padding: 20px; color: #333; }\nnav.sidebar { float: right; width: 200px; padding: 10px; background: #f5f5f5; border-radius: 5px; }\nnav.sidebar ul { list-style: none; padding: 0; }\nnav.sidebar li { padding: 4px 0; }\n.kind { color: #999; font-size: 0.85em; }\nsection { border-bottom: 1px solid #eee; padding: 20px 0; }\nh1 { color: #2c3e50; }\nh2 { color: #34495e; margin-top: 30px; }\npre { background: #f8f8f8; padding: 10px; border-radius: 5px; overflow-x: auto; }\ncode { font-family: 'Fira Code', monospace; font-size: 0.9em; }\ntable { border-collapse: collapse; margin: 10px 0; }\ntd { border: 1px solid #ddd; padding: 6px 12px; }\n.line { color: #999; font-size: 0.85em; }\n.doc { margin: 10px 0; line-height: 1.5; }\n";

// --- File processing ---

pub fn scribe_process_file(input_path: str, output_dir: str, format: str) -> str {
    var source: str = p_file_read(input_path);
    if str_len(source) == 0 {
        return "Cannot read " + input_path;
    }

    var items: Vec<DocItem> = extract_docs(source);

    // Extract module name from source or filename
    var module_name: str = extract_module_name(source, input_path);

    var content: str = "";
    var ext: str = "html";
    if str_equal(format, "markdown") || str_equal(format, "md") {
        content = generate_markdown(items, module_name);
        ext = "md";
    } else {
        content = generate_html(items, module_name);
    }

    var output_file: str = output_dir + "/" + module_name + "." + ext;
    p_file_write(output_file, content);

    return "Generated " + output_file + " (" + int_to_str(items.len()) + " items)";
}

pub fn process_directory(input_dir: str, output_dir: str, format: str) -> str {
    // LIMITATION: The Fides runtime does not provide a directory listing API
    // (no readdir/getdents syscall wrapper). The Rust reference (src/scribe.rs)
    // uses std::fs::read_dir, which is not available in the self-hosted compiler.
    //
    // To process multiple files, call scribe_process_file for each .fd file
    // individually, or pass a newline-separated list of file paths.
    //
    // If the input is a single .fd file, process it directly.
    if str_ends_with(input_dir, ".fd") {
        return scribe_process_file(input_dir, output_dir, format);
    }

    // Try to read the input as a file containing newline-separated paths.
    // This allows batch processing without a directory listing API.
    var listing: str = p_file_read(input_dir);
    if str_len(listing) > 0 {
        var paths: Vec<str> = str_split(listing, "\n");
        var count: i64 = 0;
        var i: i64 = 0;
        while i < paths.len() {
            var path: str = str_trim(paths.get(i));
            if str_len(path) > 0 && str_ends_with(path, ".fd") {
                scribe_process_file(path, output_dir, format);
                count = count + 1;
            }
            i = i + 1;
        }
        if count > 0 {
            return "Generated documentation for " + int_to_str(count) + " file(s) in " + output_dir;
        }
    }

    return "Cannot list directory " + input_dir + " -- directory listing is not available in the Fides runtime. Call scribe_process_file for each .fd file individually.";
}

fn extract_module_name(source: str, fallback_path: str) -> str {
    var lines: Vec<str> = str_split(source, "\n");
    var i: i64 = 0;
    while i < lines.len() {
        var l: str = str_trim_start(lines.get(i));
        if str_starts_with(l, "module ") {
            var s: str = str_slice(l, 7, str_len(l));
            s = str_trim_end_char(s, 59); // remove trailing ';'
            s = str_trim(s);
            if str_len(s) > 0 { return s; }
        }
        i = i + 1;
    }
    // Fall back to filename without extension
    var name: str = fallback_path;
    var slash: i64 = str_rfind_char(name, 47); // '/'
    if slash >= 0 { name = str_slice(name, slash + 1, str_len(name)); }
    var dot: i64 = str_rfind_char(name, 46); // '.'
    if dot >= 0 { name = str_slice(name, 0, dot); }
    if str_len(name) == 0 { return "module"; }
    return name;
}

// --- Help ---

pub fn print_help() -> str {
    return "scribe -- Documentation generator for Fides\n\n"
        + "USAGE:\n"
        + "    scribe <file.fd> [--output <dir>] [--format html|markdown]\n"
        + "    scribe <dir>    [--output <dir>] [--format html|markdown]\n\n"
        + "OPTIONS:\n"
        + "    --output <dir>      Output directory (default: docs/)\n"
        + "    --format <format>   Output format: html (default) or markdown\n"
        + "    --help, -h          Show this help\n\n"
        + "EXAMPLES:\n"
        + "    scribe stdlib/math.fd                    # Generate HTML docs\n"
        + "    scribe stdlib/ --output docs/            # Generate docs for all stdlib\n"
        + "    scribe stdlib/ --format markdown         # Generate Markdown docs\n";
}

// --- Local helpers ---

fn sc_str_find_char(s: str, ch: i64) -> i64 {
    var i: i64 = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) == ch { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn str_rfind_char(s: str, ch: i64) -> i64 {
    var i: i64 = str_len(s) - 1;
    while i >= 0 {
        if str_byte_at(s, i) == ch { return i; }
        i = i - 1;
    }
    return -1;
}

fn str_find_str(s: str, substr: str) -> i64 {
    var slen: i64 = str_len(substr);
    if slen == 0 { return 0; }
    var i: i64 = 0;
    while i + slen <= str_len(s) {
        var matched: bool = true;
        var j: i64 = 0;
        while j < slen {
            if str_byte_at(s, i + j) != str_byte_at(substr, j) {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn str_trim_start_str(s: str, prefix: str) -> str {
    var plen: i64 = str_len(prefix);
    if plen == 0 { return s; }
    if str_len(s) < plen { return s; }
    var i: i64 = 0;
    while i < plen {
        if str_byte_at(s, i) != str_byte_at(prefix, i) { return s; }
        i = i + 1;
    }
    return str_slice(s, plen, str_len(s));
}
