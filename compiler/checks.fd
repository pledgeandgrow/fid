// checks.fd - which runtime checks a function does not need.
//
// The counted-loop analysis (src/pe.rs unchecked_ops): an increment that cannot
// overflow, and Vec accesses a counted loop keeps in bounds. Used by the native
// backend (pe_ir.fd) and the C backend (codegen_c.fd).

module compiler::checks;

use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;

pub fn peir_zeros(n: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        v.push(0);
        i = i + 1;
    }
    return v;
}

/// The values of one function a counted loop looks at (peir_unchecked_ops).
pub struct PeirLoopFacts {
    pub block_of: Vec<i64>,     // per value
    pub at: Vec<i64>,           // per value: position in its block
    pub plain: Vec<i64>,        // per value: a slot only loads and stores use
    pub st_ptr: Vec<i64>,       // the stores: pointer, block, position, value
    pub st_block: Vec<i64>,
    pub st_at: Vec<i64>,
    pub st_value: Vec<i64>,
}

pub fn peir_inst_of(f: &IrFunction, id: i64) -> Inst {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(i) => { return i; }
        // Unreachable, not a constant: a Const* fallback reads a missing id
        // (a parameter, a global value) as that constant — iro_ipcp took
        // every such argument for literal 0 (M9).
        OptInst::None => { return Inst::Unreachable; }
    }
}

pub fn peir_load_of(f: &IrFunction, id: i64, ptr: i64) -> bool {
    match peir_inst_of(f, id) {
        Inst::Load(p, _) => { return p == ptr; }
        _ => { return false; }
    }
}

// Could this instruction make a Vec shorter?
pub fn peir_may_shorten(f: &IrFunction, id: i64) -> bool {
    match peir_inst_of(f, id) {
        Inst::Call(name, _, _, _) => {
            return !(name == "Vec_get" || name == "Vec_set" || name == "Vec_len" || name == "Vec_push"
                || name == "Vec_is_empty" || name == "Vec_capacity"
                || name == "p_vec_get" || name == "p_vec_set" || name == "p_vec_len" || name == "p_vec_push"
                || name == "p_vec_is_empty" || name == "print" || name == "println" || name == "int_to_str"
                || name == "p_print_int" || name == "p_print_str" || name == "p_print_float"
                || name == "p_print_bool" || name == "p_print_newline");
        }
        Inst::CallPtr(_, _, _, _, _) => { return true; }
        Inst::DynCall(_, _, _, _, _) => { return true; }
        Inst::Asm(_, _, _, _) => { return true; }
        Inst::Backward(_) => { return true; }
        _ => { return false; }
    }
}

pub fn peir_same_vec(f: &IrFunction, a: i64, b: i64, body: Vec<i64>, facts: PeirLoopFacts) -> bool {
    if a == b { return true; }
    var pa: i64 = -1;
    var pb: i64 = -2;
    match peir_inst_of(f, a) {
        Inst::Load(p, _) => { pa = p; }
        _ => {}
    }
    match peir_inst_of(f, b) {
        Inst::Load(p, _) => { pb = p; }
        _ => {}
    }
    if pa != pb { return false; }
    var ok: bool = facts.plain.get(pa) != 0;
    var i: i64 = 0;
    while i < f.params.len() {
        if f.params.get(i).id == pa { ok = true; }
        i = i + 1;
    }
    if !ok { return false; }
    i = 0;
    while i < facts.st_ptr.len() {
        if facts.st_ptr.get(i) == pa && body.get(facts.st_block.get(i)) != 0 { return false; }
        i = i + 1;
    }
    return true;
}

/// As src/pe.rs unchecked_ops: the checks a counted loop makes needless. In
/// `while i < n`, with `i` an unshared local that only the increment
/// `i = i + 1` changes in the loop, that increment cannot overflow. If also `n`
/// is `v.len()` (or a local set once to it before the loop), `i` starts at a
/// constant >= 0 and nothing between that `len` and the loop's end can shorten
/// `v`, then `v.get(i)` and `v.set(i, x)` are in bounds, when `i` is read
/// before the increment. Returns a flag per value. The C backend uses it too.
/// Per value: bit 1, an operation that needs no overflow or bounds check;
/// bit 2, a value known to be >= 0.
pub fn peir_unchecked_ops(f: &IrFunction, nvals: i64) -> Vec<i64> {
    var out: Vec<i64> = peir_zeros(nvals);
    if PEIR_RANGES { peir_range_ops(f, nvals, &mut out); }
    var n: i64 = f.blocks.len();
    var max_id: i64 = 0;
    var b: i64 = 0;
    while b < n {
        if f.blocks.get(b).id > max_id { max_id = f.blocks.get(b).id; }
        b = b + 1;
    }
    var index: Vec<i64> = Vec::new();
    while index.len() <= max_id { index.push(-1); }
    b = 0;
    while b < n {
        index.set(f.blocks.get(b).id, b);
        b = b + 1;
    }
    var succs: Vec<Vec<i64>> = Vec::new();
    var preds: Vec<Vec<i64>> = Vec::new();
    b = 0;
    while b < n {
        var s0: Vec<i64> = Vec::new();
        var p0: Vec<i64> = Vec::new();
        succs.push(s0);
        preds.push(p0);
        b = b + 1;
    }
    b = 0;
    while b < n {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        if ids.len() > 0 {
            match peir_inst_of(f, ids.get(ids.len() - 1)) {
                Inst::Jump(t) => { peir_add_edge(&mut succs, &mut preds, index, b, t); }
                Inst::Branch(_, t, e) => {
                    peir_add_edge(&mut succs, &mut preds, index, b, t);
                    peir_add_edge(&mut succs, &mut preds, index, b, e);
                }
                _ => {}
            }
        }
        b = b + 1;
    }
    // Back edges: to a block on the depth-first path
    var latches: Vec<Vec<i64>> = Vec::new();
    b = 0;
    while b < n {
        var l0: Vec<i64> = Vec::new();
        latches.push(l0);
        b = b + 1;
    }
    var any: bool = false;
    if n > 0 {
        var state: Vec<i64> = peir_zeros(n);
        var st_b: Vec<i64> = Vec::new();
        var st_next: Vec<i64> = Vec::new();
        st_b.push(0);
        st_next.push(0);
        state.set(0, 1);
        while st_b.len() > 0 {
            var top: i64 = st_b.len() - 1;
            var cur: i64 = st_b.get(top);
            var next: i64 = st_next.get(top);
            var cur_succs: Vec<i64> = succs.get(cur);
            if next < cur_succs.len() {
                st_next.set(top, next + 1);
                var s: i64 = cur_succs.get(next);
                if state.get(s) == 0 {
                    state.set(s, 1);
                    st_b.push(s);
                    st_next.push(0);
                } else if state.get(s) == 1 {
                    latches.get(s).push(cur);
                    any = true;
                }
            } else {
                state.set(cur, 2);
                st_b.pop();
                st_next.pop();
            }
        }
    }
    if !any { return out; }
    var facts: PeirLoopFacts = peir_loop_facts(f, nvals);
    var head: i64 = 0;
    while head < n {
        if latches.get(head).len() > 0 {
            peir_counted_loop(f, head, n, succs, preds, latches.get(head), index, facts, &mut out);
        }
        head = head + 1;
    }
    return out;
}

pub fn peir_is_len(f: &IrFunction, id: i64) -> bool {
    match peir_inst_of(f, id) {
        Inst::Call(name, _, _, _) => { return name == "Vec_len" || name == "p_vec_len"; }
        _ => { return false; }
    }
}

/// The blocks outside the loop body reached from `start` along `edges`.
pub fn peir_reach(edges: Vec<Vec<i64>>, start: Vec<i64>, body: Vec<i64>, n: i64) -> Vec<i64> {
    var seen: Vec<i64> = peir_zeros(n);
    var work: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < start.len() {
        work.push(start.get(i));
        i = i + 1;
    }
    while work.len() > 0 {
        var b: i64 = work.pop();
        if seen.get(b) == 0 && body.get(b) == 0 {
            seen.set(b, 1);
            var next: Vec<i64> = edges.get(b);
            i = 0;
            while i < next.len() {
                work.push(next.get(i));
                i = i + 1;
            }
        }
    }
    return seen;
}

pub fn peir_add_edge(succs: &mut Vec<Vec<i64>>, preds: &mut Vec<Vec<i64>>, index: Vec<i64>, from: i64, target: i64) {
    if target < index.len() && index.get(target) >= 0 {
        succs.get(from).push(index.get(target));
        preds.get(index.get(target)).push(from);
    }
}

pub fn peir_loop_facts(f: &IrFunction, nvals: i64) -> PeirLoopFacts {
    var facts: PeirLoopFacts = PeirLoopFacts {
        block_of: peir_zeros(nvals), at: peir_zeros(nvals), plain: peir_zeros(nvals),
        st_ptr: Vec::new(), st_block: Vec::new(), st_at: Vec::new(), st_value: Vec::new(),
    };
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            facts.block_of.set(id, b);
            facts.at.set(id, k);
            match peir_inst_of(f, id) {
                Inst::Alloca(_, _) => { facts.plain.set(id, 1); }
                _ => {}
            }
            k = k + 1;
        }
        b = b + 1;
    }
    b = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var inst: Inst = peir_inst_of(f, ids.get(k));
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(inst, &mut ops);
            var o: i64 = 0;
            while o < ops.len() {
                var op: i64 = ops.get(o);
                var target: bool = false;
                match inst {
                    Inst::Load(ptr, _) => { target = ptr == op; }
                    Inst::Store(ptr, value, _) => { target = ptr == op && value != op; }
                    _ => {}
                }
                if !target { facts.plain.set(op, 0); }
                o = o + 1;
            }
            match inst {
                Inst::Store(ptr, value, _) => {
                    facts.st_ptr.push(ptr);
                    facts.st_block.push(b);
                    facts.st_at.push(k);
                    facts.st_value.push(value);
                }
                _ => {}
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return facts;
}

pub fn peir_counted_loop(f: &IrFunction, head: i64, n: i64, succs: Vec<Vec<i64>>, preds: Vec<Vec<i64>>, latches: Vec<i64>,
                     index: Vec<i64>, facts: PeirLoopFacts, out: &mut Vec<i64>) {
    var body: Vec<i64> = peir_zeros(n);
    body.set(head, 1);
    var work: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < latches.len() {
        work.push(latches.get(i));
        i = i + 1;
    }
    while work.len() > 0 {
        var b: i64 = work.pop();
        if body.get(b) == 0 {
            body.set(b, 1);
            var ps: Vec<i64> = preds.get(b);
            i = 0;
            while i < ps.len() {
                work.push(ps.get(i));
                i = i + 1;
            }
        }
    }
    // The guard: `i < right`, entering the loop only when it holds
    var head_ids: Vec<i64> = f.blocks.get(head).instructions;
    if head_ids.len() == 0 { return; }
    var cond: i64 = -1;
    var then_b: i64 = -1;
    var else_b: i64 = -1;
    match peir_inst_of(f, head_ids.get(head_ids.len() - 1)) {
        Inst::Branch(c, t, e) => {
            cond = c;
            if t < index.len() { then_b = index.get(t); }
            if e < index.len() { else_b = index.get(e); }
        }
        _ => { return; }
    }
    if then_b < 0 || else_b < 0 || body.get(then_b) == 0 || body.get(else_b) != 0 { return; }
    var left: i64 = -1;
    var right: i64 = -1;
    match peir_inst_of(f, cond) {
        Inst::BinOp(op, l, r, _) => {
            match op {
                BinOp::Lt => { left = l; right = r; }
                _ => { return; }
            }
        }
        _ => { return; }
    }
    var slot: i64 = -1;
    match peir_inst_of(f, left) {
        Inst::Load(p, ty) => {
            match ty {
                IrType::I64 => { slot = p; }
                _ => { return; }
            }
        }
        _ => { return; }
    }
    if facts.plain.get(slot) == 0 || body.get(facts.block_of.get(slot)) != 0 { return; }
    // The only store in the loop: `i = i + 1`
    var inside: i64 = 0;
    var store_block: i64 = -1;
    var store_at: i64 = -1;
    var value: i64 = -1;
    var starts_ok: bool = true;
    i = 0;
    while i < facts.st_ptr.len() {
        if facts.st_ptr.get(i) == slot {
            if body.get(facts.st_block.get(i)) != 0 {
                inside = inside + 1;
                store_block = facts.st_block.get(i);
                store_at = facts.st_at.get(i);
                value = facts.st_value.get(i);
            } else {
                match peir_inst_of(f, facts.st_value.get(i)) {
                    Inst::ConstInt(v, _) => { if v < 0 { starts_ok = false; } }
                    _ => { starts_ok = false; }
                }
            }
        }
        i = i + 1;
    }
    if inside != 1 || store_block == head { return; }
    match peir_inst_of(f, value) {
        Inst::BinOp(op, x, one, ty) => {
            match op {
                BinOp::Add => {}
                _ => { return; }
            }
            match ty {
                IrType::I64 => {}
                _ => { return; }
            }
            if !peir_load_of(f, x, slot) { return; }
            match peir_inst_of(f, one) {
                Inst::ConstInt(c, _) => { if c != 1 { return; } }
                _ => { return; }
            }
        }
        _ => { return; }
    }
    out.set(value, out.get(value) | 1);
    // Bounds: `right` is v.len(), or a local set once, before the loop, to it
    var len_call: i64 = -1;
    if peir_is_len(f, right) {
        len_call = right;
    } else {
        match peir_inst_of(f, right) {
            Inst::Load(p, _) => {
                if facts.plain.get(p) == 0 { return; }
                var count: i64 = 0;
                i = 0;
                while i < facts.st_ptr.len() {
                    if facts.st_ptr.get(i) == p {
                        count = count + 1;
                        if body.get(facts.st_block.get(i)) == 0 && peir_is_len(f, facts.st_value.get(i)) {
                            len_call = facts.st_value.get(i);
                        }
                    }
                    i = i + 1;
                }
                if count != 1 { return; }
            }
            _ => { return; }
        }
    }
    if len_call < 0 { return; }
    var vec_val: i64 = -1;
    match peir_inst_of(f, len_call) {
        Inst::Call(_, args, _, _) => {
            if args.len() == 0 { return; }
            vec_val = args.get(args.len() - 1);
        }
        _ => { return; }
    }
    if !starts_ok { return; }
    var len_block: i64 = facts.block_of.get(len_call);
    if body.get(len_block) == 0 {
        // Nothing shortens v after the len and before the loop: not later in
        // its block, nor in a block on a path from it to the loop
        var len_ids: Vec<i64> = f.blocks.get(len_block).instructions;
        i = facts.at.get(len_call) + 1;
        while i < len_ids.len() {
            if peir_may_shorten(f, len_ids.get(i)) { return; }
            i = i + 1;
        }
        var fwd: Vec<i64> = peir_reach(succs, succs.get(len_block), body, n);
        var into: Vec<i64> = peir_reach(preds, preds.get(head), body, n);
        var bb: i64 = 0;
        while bb < n {
            if fwd.get(bb) != 0 && into.get(bb) != 0 && bb != len_block {
                var ids: Vec<i64> = f.blocks.get(bb).instructions;
                i = 0;
                while i < ids.len() {
                    if peir_may_shorten(f, ids.get(i)) { return; }
                    i = i + 1;
                }
            }
            bb = bb + 1;
        }
    }
    var b2: i64 = 0;
    while b2 < n {
        if body.get(b2) != 0 {
            var ids: Vec<i64> = f.blocks.get(b2).instructions;
            i = 0;
            while i < ids.len() {
                if peir_may_shorten(f, ids.get(i)) { return; }
                i = i + 1;
            }
        }
        b2 = b2 + 1;
    }
    // The blocks that can run after the increment, in the same iteration
    var after: Vec<i64> = peir_zeros(n);
    work = Vec::new();
    var first: Vec<i64> = succs.get(store_block);
    i = 0;
    while i < first.len() {
        work.push(first.get(i));
        i = i + 1;
    }
    while work.len() > 0 {
        var b: i64 = work.pop();
        if b != head && after.get(b) == 0 {
            after.set(b, 1);
            var ss: Vec<i64> = succs.get(b);
            i = 0;
            while i < ss.len() {
                work.push(ss.get(i));
                i = i + 1;
            }
        }
    }
    b2 = 0;
    while b2 < n {
        if body.get(b2) != 0 && b2 != head {
            var ids: Vec<i64> = f.blocks.get(b2).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                var id: i64 = ids.get(k);
                match peir_inst_of(f, id) {
                    Inst::Call(name, args, _, _) => {
                        var at: i64 = -1;
                        if (name == "Vec_get" || name == "p_vec_get") && args.len() >= 2 { at = args.len() - 2; }
                        if (name == "Vec_set" || name == "p_vec_set") && args.len() >= 3 { at = args.len() - 3; }
                        if at >= 0 && peir_same_vec(f, args.get(at), vec_val, body, facts)
                            && peir_load_of(f, args.get(at + 1), slot) {
                            var lb: i64 = facts.block_of.get(args.get(at + 1));
                            var lk: i64 = facts.at.get(args.get(at + 1));
                            if after.get(lb) == 0 && !(lb == store_block && lk > store_at) {
                                out.set(id, out.get(id) | 1);
                            }
                        }
                    }
                    _ => {}
                }
                k = k + 1;
            }
        }
        b2 = b2 + 1;
    }
}

/// Generate integer binary operation.
/// Append every ValueId `inst` reads to `out` (used by the slot-reuse
/// analysis in gen_function — pe-roadmap items 84-85).
pub fn peir_inst_operands(inst: Inst, out: &mut Vec<i64>) -> void {
    match inst {
        Inst::BinOp(_, l, r, _) => { out.push(l); out.push(r); }
        Inst::UnaryOp(_, v, _) => { out.push(v); }
        Inst::Load(p, _) => { out.push(p); }
        Inst::Store(p, v, _) => { out.push(p); out.push(v); }
        Inst::StructCopy(d, s, _) => { out.push(d); out.push(s); }
        Inst::GetFieldPtr(p, _, _) => { out.push(p); }
        Inst::GetElemPtr(p, i, _) => { out.push(p); out.push(i); }
        Inst::Branch(c, _, _) => { out.push(c); }
        Inst::Return(rv) => {
            match rv {
                OptValueId::Some(v) => { out.push(v); }
                OptValueId::None => {}
            }
        }
        Inst::Call(_, args, _, _) => {
            var i: i64 = 0;
            while i < args.len() { out.push(args.get(i)); i = i + 1; }
        }
        Inst::CallPtr(fp, args, _, _, _) => {
            out.push(fp);
            var j: i64 = 0;
            while j < args.len() { out.push(args.get(j)); j = j + 1; }
        }
        Inst::DynCall(_, _, args, _, _) => {
            var k: i64 = 0;
            while k < args.len() { out.push(args.get(k)); k = k + 1; }
        }
        Inst::MakeDyn(v, _, _) => { out.push(v); }
        Inst::BitCast(v, _, _) => { out.push(v); }
        Inst::IntExtend(v, _, _) => { out.push(v); }
        Inst::IntTrunc(v, _, _) => { out.push(v); }
        Inst::IntToFloat(v, _, _) => { out.push(v); }
        Inst::FloatToInt(v, _, _) => { out.push(v); }
        Inst::TryUnwrap(v, _, _, _) => { out.push(v); }
        Inst::Print(v, _) => { out.push(v); }
        Inst::Asm(_, inputs, _, _) => {
            var m: i64 = 0;
            while m < inputs.len() { out.push(inputs.get(m).id); m = m + 1; }
        }
        Inst::PersistLoad(_, d, _) => { out.push(d); }
        Inst::PersistSave(_, v) => { out.push(v); }
        Inst::Backward(l) => { out.push(l); }
        _ => {}
    }
}

// ===========================================================================
// Integer ranges (competitive OP24)
//
// Each i64 value gets an interval [lo, hi]; an open side is the i64
// extreme, so i64::MIN as lo says nothing. Intervals come from constants,
// `% c`, `/ c`, `& c`, `>> c`, comparisons, narrow types, lengths, the
// locals' stores (a local only stored values >= 0, or itself plus a value
// >= 0, is >= 0) and the branch that leads into a block (`i < n` taken:
// i <= n - 1 there). An add, sub or mul whose result interval stays inside
// i64 cannot overflow: it is marked unchecked (bit 1 of the result). A
// value known >= 0 has bit 2 (x % c and x / c of one need no sign fix).
// Every interval only holds facts that are true on every path, so dropping
// a check never changes what a program does.
// ===========================================================================

const PEIR_RANGES: bool = true;
const PEIR_I64_MIN: i64 = -9223372036854775807 - 1;
const PEIR_I64_MAX: i64 = 9223372036854775807;

/// a + b, or false when it leaves i64
fn peir_radd(a: i64, b: i64, out: &mut Vec<i64>) -> bool {
    if b > 0 && a > PEIR_I64_MAX - b { return false; }
    if b < 0 && a < PEIR_I64_MIN - b { return false; }
    out.push(a + b);
    return true;
}

/// a - b, or false when it leaves i64
fn peir_rsub(a: i64, b: i64, out: &mut Vec<i64>) -> bool {
    if b < 0 && a > PEIR_I64_MAX + b { return false; }
    if b > 0 && a < PEIR_I64_MIN + b { return false; }
    out.push(a - b);
    return true;
}

/// The range of a narrow integer type; false for any other.
fn peir_type_range(ty: IrType, out: &mut Vec<i64>) -> bool {
    out.clear();
    match ty {
        IrType::Bool => { out.push(0); out.push(1); }
        IrType::U8 => { out.push(0); out.push(255); }
        IrType::I8 => { out.push(-128); out.push(127); }
        IrType::U16 => { out.push(0); out.push(65535); }
        IrType::I16 => { out.push(-32768); out.push(32767); }
        IrType::U32 => { out.push(0); out.push(4294967295); }
        IrType::I32 => { out.push(-2147483648); out.push(2147483647); }
        _ => { return false; }
    }
    return true;
}

/// Ranges of one function: per value lo and hi, per local its bounds, and
/// the refinement in force in the block being scanned.
pub struct PeirRanges {
    pub lo: Vec<i64>,
    pub hi: Vec<i64>,
    pub loc_lo: Vec<i64>,
    pub loc_hi: Vec<i64>,
    pub plain: Vec<i64>,
    // the current block's refinement: one value (or local) and its interval
    pub ref_v: i64,
    pub ref_loc: i64,
    pub ref_lo: i64,
    pub ref_hi: i64,
    pub ref_live: bool,
    // Vec locals that only ever hold a Vec_filled_typed result (or null)
    // and are never shortened: 1; their least length (-1: unknown)
    pub vstable: Vec<i64>,
    pub vlen: Vec<i64>,
}

fn peir_rng_get_lo(r: &PeirRanges, v: i64) -> i64 {
    if v < 0 || v >= r.lo.len() { return PEIR_I64_MIN; }
    if v == r.ref_v && r.ref_v >= 0 {
        if r.ref_lo > r.lo.get(v) { return r.ref_lo; }
    }
    return r.lo.get(v);
}

fn peir_rng_get_hi(r: &PeirRanges, v: i64) -> i64 {
    if v < 0 || v >= r.hi.len() { return PEIR_I64_MAX; }
    if v == r.ref_v && r.ref_v >= 0 {
        if r.ref_hi < r.hi.get(v) { return r.ref_hi; }
    }
    return r.hi.get(v);
}

fn peir_rng_put(r: &mut PeirRanges, id: i64, l: i64, h: i64) {
    if id < 0 || id >= r.lo.len() || l > h { return; }
    r.lo.set(id, l);
    r.hi.set(id, h);
}

/// Is `v` an i64 value (a comparison of two may refine one)?
fn peir_rng_i64(f: &IrFunction, v: i64) -> bool {
    match IrFunction_get_meta(f, v) {
        OptValueMeta::Some(m) => { return ir_type_eq(m.ty, IrType::I64); }
        OptValueMeta::None => { return false; }
    }
}

/// One scan of the function in layout order; `final` marks the results.
fn peir_range_scan(f: &IrFunction, r: &mut PeirRanges, single_pred: &Vec<i64>, index: &Vec<i64>, out: &mut Vec<i64>, final: bool) {
    var nv: i64 = r.lo.len();
    var tr: Vec<i64> = Vec::new();
    var t1: Vec<i64> = Vec::new();
    var t2: Vec<i64> = Vec::new();
    // The refinement in force at the end of each block scanned so far: a
    // block whose only way in is a jump from one of them keeps it
    var nb: i64 = f.blocks.len();
    var x_v: Vec<i64> = Vec::new();
    var x_loc: Vec<i64> = Vec::new();
    var x_lo: Vec<i64> = Vec::new();
    var x_hi: Vec<i64> = Vec::new();
    var x_live: Vec<i64> = Vec::new();
    var x_done: Vec<i64> = peir_zeros(nb);
    var xb: i64 = 0;
    while xb < nb {
        x_v.push(-1); x_loc.push(-1); x_lo.push(0); x_hi.push(0); x_live.push(0);
        xb = xb + 1;
    }
    var b: i64 = 0;
    while b < f.blocks.len() {
        // The branch into this block, when it is the only way in
        r.ref_v = -1;
        r.ref_loc = -1;
        r.ref_live = false;
        var pb: i64 = single_pred.get(b);
        if pb >= 0 {
            var pids: Vec<i64> = f.blocks.get(pb).instructions;
            if pids.len() > 0 {
                match peir_inst_of(f, pids.get(pids.len() - 1)) {
                    Inst::Jump(_) => {
                        // entered only from `pb`, whose facts hold here too
                        if x_done.get(pb) == 1 {
                            r.ref_v = x_v.get(pb);
                            r.ref_loc = x_loc.get(pb);
                            r.ref_lo = x_lo.get(pb);
                            r.ref_hi = x_hi.get(pb);
                            r.ref_live = x_live.get(pb) == 1;
                        }
                    }
                    Inst::Branch(cond, tb, eb) => {
                        var taken: i64 = -1;
                        if tb >= 0 && tb < index.len() && index.get(tb) == b { taken = 1; }
                        if eb >= 0 && eb < index.len() && index.get(eb) == b {
                            if taken == 1 { taken = -1; } else { taken = 0; }
                        }
                        if taken >= 0 {
                            peir_range_refine(f, r, cond, taken == 1);
                        }
                    }
                    _ => {}
                }
            }
        }
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < nv {
                var inst: Inst = peir_inst_of(f, id);
                match inst {
                    Inst::ConstInt(v, ty) => {
                        if ir_type_is_int(ty) { peir_rng_put(r, id, v, v); }
                    }
                    Inst::ConstBool(_) => { peir_rng_put(r, id, 0, 1); }
                    Inst::IntExtend(v, from, _) => {
                        if peir_type_range(from, &mut tr) {
                            var el: i64 = tr.get(0);
                            var eh: i64 = tr.get(1);
                            if peir_rng_get_lo(r, v) > el { el = peir_rng_get_lo(r, v); }
                            if peir_rng_get_hi(r, v) < eh { eh = peir_rng_get_hi(r, v); }
                            peir_rng_put(r, id, el, eh);
                        }
                    }
                    Inst::IntTrunc(_, _, to) => {
                        if peir_type_range(to, &mut tr) { peir_rng_put(r, id, tr.get(0), tr.get(1)); }
                    }
                    Inst::Load(p, ty) => {
                        if peir_type_range(ty, &mut tr) {
                            peir_rng_put(r, id, tr.get(0), tr.get(1));
                        } else if ir_type_eq(ty, IrType::I64) && p >= 0 && p < r.plain.len() && r.plain.get(p) == 1 {
                            var ll: i64 = r.loc_lo.get(p);
                            var lh: i64 = r.loc_hi.get(p);
                            if r.ref_live && r.ref_loc == p {
                                if r.ref_lo > ll { ll = r.ref_lo; }
                                if r.ref_hi < lh { lh = r.ref_hi; }
                            }
                            peir_rng_put(r, id, ll, lh);
                        }
                    }
                    Inst::Store(p, _, _) => {
                        // the branch's fact about a local ends at a store to it
                        if r.ref_live && r.ref_loc == p { r.ref_live = false; }
                    }
                    Inst::Call(name, cargs, _, _) => {
                        // A length: no more elements than bytes of memory
                        if name == "Vec_len" || name == "p_vec_len" || name == "str_len" || name == "String_len"
                            || name == "p_str_length" || name == "p_str_len" {
                            peir_rng_put(r, id, 0, 281474976710656);
                        }
                        // An index below the least length of a filled Vec
                        // that never shrinks: in bounds
                        if final && (name == "Vec_get" || name == "Vec_set") && cargs.len() >= 3 {
                            var vs: i64 = peir_filled_slot(f, r, cargs.get(1));
                            if vs >= 0 {
                                var ix: i64 = cargs.get(2);
                                if peir_rng_get_lo(r, ix) >= 0 && peir_rng_get_hi(r, ix) < r.vlen.get(vs) {
                                    out.set(id, out.get(id) | 1);
                                }
                            }
                        }
                    }
                    Inst::BinOp(op, l, rr, ty) => {
                        var ll2: i64 = peir_rng_get_lo(r, l);
                        var lh2: i64 = peir_rng_get_hi(r, l);
                        var rl: i64 = peir_rng_get_lo(r, rr);
                        var rh: i64 = peir_rng_get_hi(r, rr);
                        var rconst: bool = rl == rh;
                        match op {
                            BinOp::Eq => { peir_rng_put(r, id, 0, 1); }
                            BinOp::Neq => { peir_rng_put(r, id, 0, 1); }
                            BinOp::Lt => { peir_rng_put(r, id, 0, 1); }
                            BinOp::Gt => { peir_rng_put(r, id, 0, 1); }
                            BinOp::LtEq => { peir_rng_put(r, id, 0, 1); }
                            BinOp::GtEq => { peir_rng_put(r, id, 0, 1); }
                            BinOp::And => { peir_rng_put(r, id, 0, 1); }
                            BinOp::Or => { peir_rng_put(r, id, 0, 1); }
                            _ => {}
                        }
                        if ir_type_eq(ty, IrType::I64) {
                            match op {
                                BinOp::Mod => {
                                    if rconst && rl != 0 && rl != PEIR_I64_MIN {
                                        var m: i64 = rl;
                                        if m < 0 { m = 0 - m; }
                                        m = m - 1;
                                        if ll2 >= 0 { peir_rng_put(r, id, 0, m); }
                                        else if lh2 <= 0 { peir_rng_put(r, id, 0 - m, 0); }
                                        else { peir_rng_put(r, id, 0 - m, m); }
                                    }
                                }
                                BinOp::Div => {
                                    if rconst && rl > 0 { peir_rng_put(r, id, ll2 / rl, lh2 / rl); }
                                }
                                BinOp::BitAnd => {
                                    if rconst && rl >= 0 { peir_rng_put(r, id, 0, rl); }
                                    else if ll2 == lh2 && ll2 >= 0 { peir_rng_put(r, id, 0, ll2); }
                                    else if ll2 >= 0 && rl >= 0 {
                                        var mh: i64 = lh2;
                                        if rh < mh { mh = rh; }
                                        peir_rng_put(r, id, 0, mh);
                                    } else if ll2 >= 0 { peir_rng_put(r, id, 0, lh2); }
                                    else if rl >= 0 { peir_rng_put(r, id, 0, rh); }
                                }
                                BinOp::Shr => {
                                    if rconst && rl >= 1 && rl <= 63 && ll2 >= 0 {
                                        peir_rng_put(r, id, ll2 >> rl, lh2 >> rl);
                                    }
                                }
                                BinOp::Add => {
                                    t1.clear();
                                    t2.clear();
                                    var okl: bool = peir_radd(ll2, rl, &mut t1);
                                    var okh: bool = peir_radd(lh2, rh, &mut t2);
                                    if okl && okh {
                                        if final { out.set(id, out.get(id) | 1); }
                                        peir_rng_put(r, id, t1.get(0), t2.get(0));
                                    } else if okl && ll2 > PEIR_I64_MIN && rl > PEIR_I64_MIN {
                                        // may overflow upward: still checked, the lower bound holds
                                        peir_rng_put(r, id, t1.get(0), PEIR_I64_MAX);
                                    }
                                }
                                BinOp::Sub => {
                                    t1.clear();
                                    t2.clear();
                                    var okl2: bool = peir_rsub(ll2, rh, &mut t1);
                                    var okh2: bool = peir_rsub(lh2, rl, &mut t2);
                                    if okl2 && okh2 {
                                        if final { out.set(id, out.get(id) | 1); }
                                        peir_rng_put(r, id, t1.get(0), t2.get(0));
                                    }
                                }
                                BinOp::Mul => {
                                    var lim: i64 = 2147483647;
                                    if ll2 >= 0 - lim && lh2 <= lim && rl >= 0 - lim && rh <= lim {
                                        if final { out.set(id, out.get(id) | 1); }
                                        var c1: i64 = ll2 * rl;
                                        var c2: i64 = ll2 * rh;
                                        var c3: i64 = lh2 * rl;
                                        var c4: i64 = lh2 * rh;
                                        var mn: i64 = c1;
                                        var mx: i64 = c1;
                                        if c2 < mn { mn = c2; }
                                        if c3 < mn { mn = c3; }
                                        if c4 < mn { mn = c4; }
                                        if c2 > mx { mx = c2; }
                                        if c3 > mx { mx = c3; }
                                        if c4 > mx { mx = c4; }
                                        peir_rng_put(r, id, mn, mx);
                                    } else if ll2 >= 0 && rl >= 0 && ll2 <= lim && rl <= lim {
                                        // both >= 0: the product is at least lo * lo (checked)
                                        peir_rng_put(r, id, ll2 * rl, PEIR_I64_MAX);
                                    }
                                }
                                _ => {}
                            }
                        }
                    }
                    _ => {}
                }
                if final && r.lo.get(id) >= 0 && r.lo.get(id) <= r.hi.get(id) {
                    match IrFunction_get_meta(f, id) {
                        OptValueMeta::Some(_) => { out.set(id, out.get(id) | 2); }
                        OptValueMeta::None => {}
                    }
                }
            }
            k = k + 1;
        }
        x_v.set(b, r.ref_v);
        x_loc.set(b, r.ref_loc);
        x_lo.set(b, r.ref_lo);
        x_hi.set(b, r.ref_hi);
        if r.ref_live { x_live.set(b, 1); } else { x_live.set(b, 0); }
        x_done.set(b, 1);
        b = b + 1;
    }
    r.ref_v = -1;
    r.ref_loc = -1;
    r.ref_live = false;
}

/// The fact a branch on `cond` gives in the block it leads to.
fn peir_range_refine(f: &IrFunction, r: &mut PeirRanges, cond: i64, taken: bool) {
    match peir_inst_of(f, cond) {
        Inst::BinOp(op, l, rr, _) => {
            // var OP bound, the bound's interval known
            var v: i64 = l;
            var w: i64 = rr;
            var kind: i64 = -1; // 0 <, 1 <=, 2 >, 3 >=, 4 ==, 5 !=
            match op {
                BinOp::Lt => { kind = 0; }
                BinOp::LtEq => { kind = 1; }
                BinOp::Gt => { kind = 2; }
                BinOp::GtEq => { kind = 3; }
                BinOp::Eq => { kind = 4; }
                BinOp::Neq => { kind = 5; }
                _ => { return; }
            }
            if !peir_rng_i64(f, l) || !peir_rng_i64(f, rr) { return; }
            // the variable side: a local's load, or any value; prefer a load
            var vload: bool = false;
            match peir_inst_of(f, l) {
                Inst::Load(p, _) => { vload = p >= 0 && p < r.plain.len() && r.plain.get(p) == 1; }
                _ => {}
            }
            if !vload {
                match peir_inst_of(f, rr) {
                    Inst::Load(p2, _) => {
                        if p2 >= 0 && p2 < r.plain.len() && r.plain.get(p2) == 1 {
                            // flip: w OP' v
                            v = rr;
                            w = l;
                            if kind == 0 { kind = 2; } else if kind == 1 { kind = 3; }
                            else if kind == 2 { kind = 0; } else if kind == 3 { kind = 1; }
                        }
                    }
                    _ => {}
                }
            }
            if !taken {
                // the negation
                if kind == 0 { kind = 3; } else if kind == 1 { kind = 2; }
                else if kind == 2 { kind = 1; } else if kind == 3 { kind = 0; }
                else if kind == 4 { kind = 5; } else { kind = 4; }
            }
            var wl: i64 = peir_rng_get_lo(r, w);
            var wh: i64 = peir_rng_get_hi(r, w);
            var nl: i64 = PEIR_I64_MIN;
            var nh: i64 = PEIR_I64_MAX;
            if kind == 0 { if wh > PEIR_I64_MIN { nh = wh - 1; } }
            else if kind == 1 { nh = wh; }
            else if kind == 2 { if wl < PEIR_I64_MAX { nl = wl + 1; } }
            else if kind == 3 { nl = wl; }
            else if kind == 4 { nl = wl; nh = wh; }
            else { return; }
            r.ref_lo = nl;
            r.ref_hi = nh;
            match peir_inst_of(f, v) {
                Inst::Load(p3, _) => {
                    if p3 >= 0 && p3 < r.plain.len() && r.plain.get(p3) == 1 {
                        r.ref_loc = p3;
                        r.ref_live = true;
                        return;
                    }
                }
                _ => {}
            }
            r.ref_v = v;
        }
        _ => {}
    }
}

pub fn peir_range_ops(f: &IrFunction, nvals: i64, out: &mut Vec<i64>) {
    var r: PeirRanges = PeirRanges {
        lo: Vec::new(), hi: Vec::new(), loc_lo: Vec::new(), loc_hi: Vec::new(), plain: peir_zeros(nvals),
        ref_v: -1, ref_loc: -1, ref_lo: 0, ref_hi: 0, ref_live: false,
        vstable: peir_zeros(nvals), vlen: Vec::new(),
    };
    var vi: i64 = 0;
    while vi < nvals { r.vlen.push(-1); vi = vi + 1; }
    peir_filled_vecs(f, nvals, &mut r);
    var i: i64 = 0;
    while i < nvals {
        r.lo.push(PEIR_I64_MIN);
        r.hi.push(PEIR_I64_MAX);
        r.loc_lo.push(PEIR_I64_MIN);
        r.loc_hi.push(PEIR_I64_MAX);
        i = i + 1;
    }
    // Locals only loads and stores of whole i64 values use
    i = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        match ve.inst {
            Inst::Alloca(ty, _) => { if ve.id >= 0 && ve.id < nvals && ir_type_eq(ty, IrType::I64) { r.plain.set(ve.id, 1); } }
            _ => {}
        }
        i = i + 1;
    }
    var st_ptr: Vec<i64> = Vec::new();
    var st_val: Vec<i64> = Vec::new();
    var ops: Vec<i64> = Vec::new();
    i = 0;
    while i < f.insts.len() {
        var inst: Inst = f.insts.get(i).inst;
        ops.clear();
        peir_inst_operands(inst, &mut ops);
        var o: i64 = 0;
        while o < ops.len() {
            var v: i64 = ops.get(o);
            if v >= 0 && v < nvals && r.plain.get(v) == 1 {
                var ok: bool = false;
                match inst {
                    Inst::Load(p, lty) => { ok = p == v && ir_type_eq(lty, IrType::I64); }
                    Inst::Store(p, sv, _) => { ok = p == v && sv != v; }
                    _ => {}
                }
                if !ok { r.plain.set(v, 0); }
            }
            o = o + 1;
        }
        match inst {
            Inst::Store(p, sv, _) => { st_ptr.push(p); st_val.push(sv); }
            _ => {}
        }
        i = i + 1;
    }
    // Blocks entered from one block only
    var n: i64 = f.blocks.len();
    var max_id: i64 = 0;
    var b: i64 = 0;
    while b < n {
        if f.blocks.get(b).id > max_id { max_id = f.blocks.get(b).id; }
        b = b + 1;
    }
    var index: Vec<i64> = Vec::new();
    while index.len() <= max_id { index.push(-1); }
    b = 0;
    while b < n {
        index.set(f.blocks.get(b).id, b);
        b = b + 1;
    }
    var npred: Vec<i64> = peir_zeros(n);
    var single: Vec<i64> = Vec::new();
    b = 0;
    while b < n { single.push(-1); b = b + 1; }
    b = 0;
    while b < n {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        if ids.len() > 0 {
            match peir_inst_of(f, ids.get(ids.len() - 1)) {
                Inst::Jump(t) => {
                    if t >= 0 && t < index.len() && index.get(t) >= 0 {
                        var ti: i64 = index.get(t);
                        npred.set(ti, npred.get(ti) + 1);
                        single.set(ti, b);
                    }
                }
                Inst::Branch(_, t, e) => {
                    if t >= 0 && t < index.len() && index.get(t) >= 0 {
                        var ti2: i64 = index.get(t);
                        npred.set(ti2, npred.get(ti2) + 1);
                        single.set(ti2, b);
                    }
                    if e >= 0 && e < index.len() && index.get(e) >= 0 && e != t {
                        var ei: i64 = index.get(e);
                        npred.set(ei, npred.get(ei) + 1);
                        single.set(ei, b);
                    }
                }
                _ => {}
            }
        }
        b = b + 1;
    }
    b = 0;
    while b < n {
        if npred.get(b) != 1 || b == 0 { single.set(b, -1); }
        b = b + 1;
    }
    // Rounds: value ranges from the locals' bounds, the locals' bounds from
    // the values they are stored
    var dummy: Vec<i64> = peir_zeros(nvals);
    var round: i64 = 0;
    while round < 3 {
        // fresh value intervals each round
        i = 0;
        while i < nvals {
            r.lo.set(i, PEIR_I64_MIN);
            r.hi.set(i, PEIR_I64_MAX);
            i = i + 1;
        }
        peir_range_scan(f, &mut r, &single, &index, &mut dummy, false);
        var newlo: Vec<i64> = Vec::new();
        var newhi: Vec<i64> = Vec::new();
        var has: Vec<i64> = peir_zeros(nvals);
        i = 0;
        while i < nvals { newlo.push(PEIR_I64_MAX); newhi.push(PEIR_I64_MIN); i = i + 1; }
        var keep_lo: Vec<i64> = peir_zeros(nvals);
        var keep_hi: Vec<i64> = peir_zeros(nvals);
        var s: i64 = 0;
        while s < st_ptr.len() {
            var p: i64 = st_ptr.get(s);
            var sv: i64 = st_val.get(s);
            if p >= 0 && p < nvals && r.plain.get(p) == 1 {
                // itself plus (minus) something: keeps one side
                var self_step: bool = false;
                var up: bool = false;
                var down: bool = false;
                match peir_inst_of(f, sv) {
                    Inst::BinOp(sop, sl, sr, _) => {
                        var from_self: bool = false;
                        match peir_inst_of(f, sl) {
                            Inst::Load(lp, _) => { from_self = lp == p; }
                            _ => {}
                        }
                        if from_self {
                            match sop {
                                BinOp::Add => {
                                    self_step = true;
                                    up = peir_rng_get_lo(&r, sr) >= 0;
                                    down = peir_rng_get_hi(&r, sr) <= 0;
                                }
                                BinOp::Sub => {
                                    self_step = true;
                                    up = peir_rng_get_hi(&r, sr) <= 0;
                                    down = peir_rng_get_lo(&r, sr) >= 0;
                                }
                                _ => {}
                            }
                        }
                    }
                    _ => {}
                }
                if self_step {
                    // never lowers it (up) / never raises it (down)
                    if !up { keep_lo.set(p, 1); }
                    if !down { keep_hi.set(p, 1); }
                } else {
                    has.set(p, 1);
                    var vl: i64 = peir_rng_get_lo(&r, sv);
                    var vh: i64 = peir_rng_get_hi(&r, sv);
                    if vl < newlo.get(p) { newlo.set(p, vl); }
                    if vh > newhi.get(p) { newhi.set(p, vh); }
                }
            }
            s = s + 1;
        }
        peir_filled_lengths(f, nvals, &mut r);
        i = 0;
        while i < nvals {
            if r.plain.get(i) == 1 {
                if has.get(i) == 1 && keep_lo.get(i) == 0 { r.loc_lo.set(i, newlo.get(i)); } else { r.loc_lo.set(i, PEIR_I64_MIN); }
                if has.get(i) == 1 && keep_hi.get(i) == 0 { r.loc_hi.set(i, newhi.get(i)); } else { r.loc_hi.set(i, PEIR_I64_MAX); }
            }
            i = i + 1;
        }
        round = round + 1;
    }
    i = 0;
    while i < nvals {
        r.lo.set(i, PEIR_I64_MIN);
        r.hi.set(i, PEIR_I64_MAX);
        i = i + 1;
    }
    peir_range_scan(f, &mut r, &single, &index, out, true);
}

// ---------------------------------------------------------------------------
// Filled Vecs (competitive OP: bounds from Vec::filled)
//
// A Vec local whose every store is a Vec_filled_typed(n, ...) result (or a
// zero: the slot's prologue, a move out) and whose loaded value only feeds
// get, set, push, len, share or drop never has fewer elements than the least
// `n` it was filled with: get/set at an index known to be in [0, that n)
// need no bounds check.
// ---------------------------------------------------------------------------

/// Is `name` a call that keeps a Vec (its argument 1) at least as long?
fn peir_vec_keeps_len(name: str) -> bool {
    return name == "Vec_get" || name == "Vec_set" || name == "Vec_push" || name == "Vec_len"
        || name == "Vec_drop" || name == "Vec_share" || name == "Vec_capacity" || name == "Vec_is_empty";
}

/// Is `v` the result of Vec_filled_typed?
fn peir_is_filled_call(f: &IrFunction, v: i64) -> bool {
    match peir_inst_of(f, v) {
        Inst::Call(name, _, _, _) => { return name == "Vec_filled_typed"; }
        _ => {}
    }
    return false;
}

/// Is `v` a zero constant?
fn peir_is_zero_const(f: &IrFunction, v: i64) -> bool {
    match peir_inst_of(f, v) {
        Inst::ConstInt(c, _) => { return c == 0; }
        Inst::ConstNull(_) => { return true; }
        _ => {}
    }
    return false;
}

/// Mark the stable filled Vec locals (r.vstable).
fn peir_filled_vecs(f: &IrFunction, nvals: i64, r: &mut PeirRanges) {
    // candidates: allocas with at least one filled store
    var cand: Vec<i64> = peir_zeros(nvals);
    var load_of: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nvals { load_of.push(-1); i = i + 1; }
    i = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        match ve.inst {
            Inst::Store(p, sv, _) => {
                if p >= 0 && p < nvals && peir_is_filled_call(f, sv) {
                    match peir_inst_of(f, p) {
                        Inst::Alloca(_, _) => { cand.set(p, 1); }
                        _ => {}
                    }
                }
            }
            Inst::Load(p2, _) => {
                if ve.id >= 0 && ve.id < nvals && p2 >= 0 && p2 < nvals { load_of.set(ve.id, p2); }
            }
            _ => {}
        }
        i = i + 1;
    }
    // every use of a candidate, or of a value loaded from it, must keep it
    // at least as long
    var ops: Vec<i64> = Vec::new();
    i = 0;
    while i < f.insts.len() {
        var inst: Inst = f.insts.get(i).inst;
        ops.clear();
        peir_inst_operands(inst, &mut ops);
        var o: i64 = 0;
        while o < ops.len() {
            var v: i64 = ops.get(o);
            if v >= 0 && v < nvals {
                // the slot itself: loads, and stores of a filled Vec or zero
                if cand.get(v) == 1 {
                    var ok: bool = false;
                    match inst {
                        Inst::Load(lp, _) => { ok = lp == v; }
                        Inst::Store(sp, sv2, _) => {
                            ok = sp == v && sv2 != v && (peir_is_filled_call(f, sv2) || peir_is_zero_const(f, sv2));
                        }
                        _ => {}
                    }
                    if !ok { cand.set(v, 0); }
                }
                // a value loaded from it: argument 1 of a call that keeps it
                var ls: i64 = load_of.get(v);
                if ls >= 0 && cand.get(ls) == 1 {
                    var ok2: bool = false;
                    match inst {
                        Inst::Call(cn, cargs, _, _) => {
                            if peir_vec_keeps_len(cn) && cargs.len() >= 2 && cargs.get(1) == v {
                                ok2 = true;
                                var a: i64 = 0;
                                while a < cargs.len() {
                                    if a != 1 && cargs.get(a) == v { ok2 = false; }
                                    a = a + 1;
                                }
                            }
                        }
                        _ => {}
                    }
                    if !ok2 { cand.set(ls, 0); }
                }
            }
            o = o + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < nvals {
        r.vstable.set(i, cand.get(i));
        i = i + 1;
    }
}

/// The least length of each stable filled Vec: the least lower bound of `n`
/// over its filled stores, from this round's ranges (-1: none known).
fn peir_filled_lengths(f: &IrFunction, nvals: i64, r: &mut PeirRanges) {
    var least: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nvals { least.push(PEIR_I64_MAX); i = i + 1; }
    i = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Store(p, sv, _) => {
                if p >= 0 && p < nvals && r.vstable.get(p) == 1 && peir_is_filled_call(f, sv) {
                    var nlo: i64 = -1;
                    match peir_inst_of(f, sv) {
                        Inst::Call(_, fargs, _, _) => {
                            if fargs.len() >= 2 { nlo = peir_rng_get_lo(r, fargs.get(1)); }
                        }
                        _ => {}
                    }
                    if nlo < 0 { nlo = -1; }
                    if nlo < least.get(p) { least.set(p, nlo); }
                }
            }
            _ => {}
        }
        i = i + 1;
    }
    i = 0;
    while i < nvals {
        if r.vstable.get(i) == 1 && least.get(i) != PEIR_I64_MAX { r.vlen.set(i, least.get(i)); } else { r.vlen.set(i, -1); }
        i = i + 1;
    }
}

/// The stable filled Vec local that `v` is loaded from, or -1.
fn peir_filled_slot(f: &IrFunction, r: &PeirRanges, v: i64) -> i64 {
    match peir_inst_of(f, v) {
        Inst::Load(p, _) => {
            if p >= 0 && p < r.vstable.len() && r.vstable.get(p) == 1 && r.vlen.get(p) > 0 { return p; }
        }
        _ => {}
    }
    return -1;
}

// --- CP3: fid explain -------------------------------------------------------
// peir_unchecked_ops already computes which runtime checks a counted loop or
// the range analysis makes needless. `fid explain` surfaces that: per
// function, the checks removed and the checks still emitted.

/// The check an instruction would emit, or "" when it never emits one.
fn explain_check_kind(inst: Inst) -> str {
    match inst {
        Inst::BinOp(op, _, _, _) => {
            if op == BinOp::Add { return "add overflow check"; }
            if op == BinOp::Sub { return "sub overflow check"; }
            if op == BinOp::Mul { return "mul overflow check"; }
            if op == BinOp::Div { return "div check"; }
            if op == BinOp::Mod { return "mod check"; }
            return "";
        }
        Inst::Call(n, _, _, _) => {
            if n == "Vec_get" || n == "p_vec_get" { return "bounds check"; }
            if n == "Vec_set" || n == "p_vec_set" { return "bounds check"; }
            return "";
        }
        _ => { return ""; }
    }
    return "";
}

/// Per function: checks removed (with the proof that removed them) vs kept.
/// `filt` ("" = all) keeps only functions whose name contains it.
pub fn explain_checks(module: IrModule, filt: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var ent: IrFunctionEntry = module.functions.get(fi);
        if str_len(filt) > 0 && str_find(ent.name, filt) < 0 {
            fi = fi + 1;
            continue;
        }
        var f: IrFunction = ent.func;
        var nvals: i64 = f.value_metas.len() + f.insts.len() + 16;
        var flags: Vec<i64> = peir_unchecked_ops(&f, nvals);
        var rflag: Vec<i64> = peir_zeros(nvals);
        peir_range_ops(&f, nvals, &mut rflag);
        var removed: Vec<str> = Vec::new();
        var kept: i64 = 0;
        var bi: i64 = 0;
        while bi < f.blocks.len() {
            var ids: Vec<i64> = f.blocks.get(bi).instructions;
            var ii: i64 = 0;
            while ii < ids.len() {
                var id: i64 = ids.get(ii);
                var kind: str = explain_check_kind(peir_inst_of(&f, id));
                if str_len(kind) > 0 {
                    var bit: i64 = 0;
                    if id >= 0 && id < flags.len() { bit = flags.get(id); }
                    if (bit & 1) != 0 {
                        var why: str = "counted loop";
                        if id >= 0 && id < rflag.len() && (rflag.get(id) & 1) != 0 { why = "range analysis"; }
                        removed.push("    removed " + kind + " (v" + int_to_str(id) + ", " + why + ")");
                    } else {
                        kept = kept + 1;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        if removed.len() > 0 || kept > 0 {
            out.push("fn " + ent.name + ": " + int_to_str(removed.len()) + " check(s) removed, " + int_to_str(kept) + " kept");
            var ri: i64 = 0;
            while ri < removed.len() {
                out.push(removed.get(ri));
                ri = ri + 1;
            }
        }
        fi = fi + 1;
    }
    if out.len() == 0 { out.push("no runtime checks in this program"); }
    return out;
}

/// A rough "why on the heap" for an instruction that allocates, or "".
fn explain_alloc_kind(inst: Inst) -> str {
    match inst {
        Inst::Call(n, _, _, _) => {
            if n == "p_malloc" || n == "p_alloc" || n == "p_calloc" || n == "p_realloc" {
                return "heap allocation (runtime allocator)";
            }
            if str_starts_with(n, "Vec_new") || str_starts_with(n, "Vec_filled") || str_starts_with(n, "Vec_init") {
                return "Vec buffer (heap: resizable)";
            }
            if str_starts_with(n, "HashMap_new") {
                return "HashMap table (heap: resizable)";
            }
            if n == "Str_dup" || n == "str_concat" || n == "String_from" {
                return "string copy (heap: dynamic length)";
            }
            if str_ends_with(n, "_to_str") || n == "int_to_str" || n == "f64_to_str" || n == "f32_to_str" || n == "bool_to_str" {
                return "string result (heap: dynamic length)";
            }
            if n == "Vec_share" || n == "Vec_share_deep" || n == "Vec_clone" {
                return "Vec copy for COW sharing";
            }
            return "";
        }
        Inst::MakeDyn(_, _, _) => { return "trait object (heap: dyn box)"; }
        _ => { return ""; }
    }
    return "";
}

/// Per function: the instructions that allocate, and why the value is on the
/// heap. `filt` ("" = all) keeps only functions whose name contains it.
pub fn explain_allocs(module: IrModule, filt: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var ent: IrFunctionEntry = module.functions.get(fi);
        if str_len(filt) == 0 || str_find(ent.name, filt) >= 0 {
            var f: IrFunction = ent.func;
            var lines: Vec<str> = Vec::new();
            var bi: i64 = 0;
            while bi < f.blocks.len() {
                var ids: Vec<i64> = f.blocks.get(bi).instructions;
                var ii: i64 = 0;
                while ii < ids.len() {
                    var id: i64 = ids.get(ii);
                    var kind: str = explain_alloc_kind(peir_inst_of(&f, id));
                    if str_len(kind) > 0 {
                        lines.push("    v" + int_to_str(id) + ": " + kind);
                    }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
            if lines.len() > 0 {
                out.push("fn " + ent.name + ": " + int_to_str(lines.len()) + " allocation(s)");
                var li: i64 = 0;
                while li < lines.len() {
                    out.push(lines.get(li));
                    li = li + 1;
                }
            }
        }
        fi = fi + 1;
    }
    if out.len() == 0 { out.push("no heap allocations"); }
    return out;
}
