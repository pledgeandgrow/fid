// checks.fd - which runtime checks a function does not need.
//
// The counted-loop analysis (src/pe.rs unchecked_ops): an increment that cannot
// overflow, and Vec accesses a counted loop keeps in bounds. Used by the native
// backend (pe_ir.fd) and the C backend (codegen_c.fd).
//
// At the end: the mid-end's shared CFG facts (ME2): IroCfg / iro_cfg
// (successors, predecessors, reverse postorder, dominator tree),
// iro_dominates, and the loop tree iro_loops.

module compiler::checks;
use core;
use vec;
use string;
use compiler::ast;
use compiler::ir;
use compiler::inc;
pub fn peir_zeros(n: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        v.push(0);
        i = i + 1;
    }
    return v;
}

/// The values of one function a counted loop looks at (peir_unchecked_ops).
pub struct PeirLoopFacts {
    pub block_of: Vec<i64>,
    // per value
    pub at: Vec<i64>,
    // per value: position in its block
    pub plain: Vec<i64>,
    // per value: a slot only loads and stores use
    pub st_ptr: Vec<i64>,
    // the stores: pointer, block, position, value
    pub st_block: Vec<i64>,
    pub st_at: Vec<i64>,
    pub st_value: Vec<i64>,
}

pub fn peir_inst_of(f: &IrFunction, id: i64) -> Inst {
    match IrFunction_get_inst(f, id) {
        OptInst::Some(i) => {
            return i;
        }
        // Unreachable, not a constant: a Const* fallback reads a missing id
        // (a parameter, a global value) as that constant — iro_ipcp took
        // every such argument for literal 0 (M9).
        OptInst::None => {
            return Inst::Unreachable;
        }
    }
}

/// The position of `id`'s instruction in f.insts, or -1 (a parameter, a
/// missing id). Hot loops match `f.insts.get(pos).inst` in place instead of
/// copying the instruction twice through peir_inst_of (CS4).
pub fn peir_inst_pos(f: &IrFunction, id: i64) -> i64 {
    if id >= 0 && id < f.inst_at.len() {
        return f.inst_at.get(id) - 1;
    }
    return 0 - 1;
}

pub fn peir_load_of(f: &IrFunction, id: i64, ptr: i64) -> bool {
    match peir_inst_of(f, id) {
        Inst::Load(p, _) => {
            return p == ptr;
        }
        _ => {
            return false;
        }
    }
}

// Could this instruction make a Vec shorter?
pub fn peir_may_shorten(f: &IrFunction, id: i64) -> bool {
    match peir_inst_of(f, id) {
        Inst::Call(name, _, _, _) => {
            return !(name == "Vec_get" || name == "Vec_set" || name == "Vec_len" || name == "Vec_push" || name == "Vec_is_empty" || name == "Vec_capacity" || name == "p_vec_get" || name == "p_vec_set" || name == "p_vec_len" || name == "p_vec_push" || name == "p_vec_is_empty" || name == "print" || name == "println" || name == "int_to_str" || name == "p_print_int" || name == "p_print_str" || name == "p_print_float" || name == "p_print_bool" || name == "p_print_newline"  // Destructors and to-string helpers run after a value's last
                // use and only ever free other temporaries inside a region.
                || name == "Str_drop" || name == "Vec_drop" || name == "Vec_drop_inplace" || name == "Box_drop_t" || name == "__p_mem_drop" || name == "__p_elem_drop" || name == "p_allocator_free" || name == "p_free" || name == "vec_box_free" || name == "vec_buf_free" || name == "byte_to_str" || name == "p_char_to_str" || name == "p_float_to_str" || name == "p_to_str" || name == "p_sb_to_str");
        }
        Inst::CallPtr(_, _, _, _, _) => {
            return true;
        }
        Inst::DynCall(_, _, _, _, _) => {
            return true;
        }
        Inst::Asm(_, _, _, _) => {
            return true;
        }
        Inst::Backward(_) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

pub fn peir_same_vec(f: &IrFunction, a: i64, b: i64, body: Vec<i64>, facts: PeirLoopFacts) -> bool {
    if a == b {
        return true;
    }
    var pa: i64 = -1;
    var pb: i64 = -2;
    match peir_inst_of(f, a) {
        Inst::Load(p, _) => {
            pa = p;
        }
        _ => {
        }
    }
    match peir_inst_of(f, b) {
        Inst::Load(p, _) => {
            pb = p;
        }
        _ => {
        }
    }
    if pa != pb {
        return false;
    }
    var ok: bool = facts.plain.get(pa) != 0;
    var i: i64 = 0;
    while i < f.params.len() {
        if f.params.get(i).id == pa {
            ok = true;
        }
        i = i + 1;
    }
    if !ok {
        return false;
    }
    i = 0;
    while i < facts.st_ptr.len() {
        if facts.st_ptr.get(i) == pa && body.get(facts.st_block.get(i)) != 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// As src/pe.rs unchecked_ops: the checks a counted loop makes needless. In
/// `while i < n`, with `i` an unshared local that only the increment
/// `i = i + 1` changes in the loop, that increment cannot overflow. If also `n`
/// is `v.len()` (or a local set once to it before the loop), `i` starts at a
/// constant >= 0 and nothing between that `len` and the loop's end can shorten
/// `v`, then `v.get(i)` and `v.set(i, x)` are in bounds, when `i` is read
/// before the increment. Since Nov 16 (ME25) the increment may be `i = i +
/// c` for a constant c in 1..2^20: the accesses are proved as for 1, and
/// the increment then needs no overflow check only when the bound is a
/// length. Returns a flag per value. The C backend uses it too.
/// Per value: bit 1, an operation that needs no overflow or bounds check;
/// bit 2, a value known to be >= 0.
pub fn peir_unchecked_ops(f: &IrFunction, nvals: i64) -> Vec<i64> {
    var out: Vec<i64> = peir_zeros(nvals);
    if PEIR_RANGES {
        peir_range_ops(f, nvals, &mut out);
    }
    // ME2: the shared CFG (iro_cfg: block index, successors, predecessors,
    // a Branch to one block counted once) and loop tree (iro_loops: back
    // edges to a dominating header, so an irreducible cycle is no counted
    // loop; the body each loop's latches reach), not a CFG of its own
    var n: i64 = f.blocks.len();
    var cfg: IroCfg = iro_cfg(f);
    var index: Vec<i64> = cfg.index;
    var succs: Vec<Vec<i64>> = cfg.succs;
    var preds: Vec<Vec<i64>> = cfg.preds;
    var facts: PeirLoopFacts = peir_loop_facts(f, nvals);
    if n > 0 {
        var lt: IroLoops = iro_loops(&cfg);
        if lt.found.len() > 0 {
            var head: i64 = 0;
            while head < n {
                if lt.latches.get(head).len() > 0 {
                    peir_counted_loop(f, head, n, succs, preds, iro_loop_body(&lt, head), index, facts, &mut out);
                    // LF7: loops counting down
                    peir_counted_down(f, head, n, succs, preds, iro_loop_body(&lt, head), index, facts, &mut out);
                }
                head = head + 1;
            }
        }
    }
    peir_guard_ops(f, n, succs, preds, index, facts, &mut out);
    return out;
}

pub fn peir_is_len(f: &IrFunction, id: i64) -> bool {
    match peir_inst_of(f, id) {
        Inst::Call(name, _, _, _) => {
            return name == "Vec_len" || name == "p_vec_len";
        }
        _ => {
            return false;
        }
    }
}

/// The blocks outside the loop body reached from `start` along `edges`.
pub fn peir_reach(edges: Vec<Vec<i64>>, start: Vec<i64>, body: Vec<i64>, n: i64) -> Vec<i64> {
    var seen: Vec<i64> = peir_zeros(n);
    var work: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < start.len() {
        work.push(start.get(i));
        i = i + 1;
    }
    while work.len() > 0 {
        var b: i64 = work.pop();
        if seen.get(b) == 0 && body.get(b) == 0 {
            seen.set(b, 1);
            var next: Vec<i64> = edges.get(b);
            i = 0;
            while i < next.len() {
                work.push(next.get(i));
                i = i + 1;
            }
        }
    }
    return seen;
}

pub fn peir_add_edge(succs: &mut Vec<Vec<i64>>, preds: &mut Vec<Vec<i64>>, index: Vec<i64>, from: i64, target: i64) {
    if target < index.len() && index.get(target) >= 0 {
        succs.get(from).push(index.get(target));
        preds.get(index.get(target)).push(from);
    }
}

pub fn peir_loop_facts(f: &IrFunction, nvals: i64) -> PeirLoopFacts {
    var facts: PeirLoopFacts = PeirLoopFacts {
        block_of: peir_zeros(nvals), at: peir_zeros(nvals), plain: peir_zeros(nvals), st_ptr: Vec::new(), st_block: Vec::new(), st_at: Vec::new(), st_value: Vec::new(),
    };
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            facts.block_of.set(id, b);
            facts.at.set(id, k);
            var ipos: i64 = peir_inst_pos(f, id);
            if ipos >= 0 {
                match f.insts.get(ipos).inst {
                    Inst::Alloca(_, _) => {
                        facts.plain.set(id, 1);
                    }
                    _ => {
                    }
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    b = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            // CS4: matched in place; a missing instruction has no operands
            // and is no store
            var ipos: i64 = peir_inst_pos(f, ids.get(k));
            if ipos >= 0 {
                var ops: Vec<i64> = Vec::new();
                peir_inst_operands(f.insts.get(ipos).inst, &mut ops);
                var o: i64 = 0;
                while o < ops.len() {
                    var op: i64 = ops.get(o);
                    var target: bool = false;
                    match f.insts.get(ipos).inst {
                        Inst::Load(ptr, _) => {
                            target = ptr == op;
                        }
                        Inst::Store(ptr, value, _) => {
                            target = ptr == op && value != op;
                        }
                        _ => {
                        }
                    }
                    if !target {
                        facts.plain.set(op, 0);
                    }
                    o = o + 1;
                }
                match f.insts.get(ipos).inst {
                    Inst::Store(ptr, value, _) => {
                        facts.st_ptr.push(ptr);
                        facts.st_block.push(b);
                        facts.st_at.push(k);
                        facts.st_value.push(value);
                    }
                    _ => {
                    }
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return facts;
}

/// Is `ptr` stored in block `blk` after position `at`?
fn peir_stored_after(facts: &PeirLoopFacts, ptr: i64, blk: i64, at: i64) -> bool {
    var i: i64 = 0;
    while i < facts.st_ptr.len() {
        if facts.st_ptr.get(i) == ptr && facts.st_block.get(i) == blk && facts.st_at.get(i) > at {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// ME23: do bounds `a` (tested at the end of block `pa`) and `b` (of `pb`)
/// name the same number, or at least the same Vec's length? The same
/// value; loads of one plain local the loop never stores (nor its block
/// after the load); Vec_len calls on the same Vec (nothing in the loop may
/// shorten it: the counted-loop proof checks that, and a length only grows
/// then, so each test's bound is at most the length when the body runs);
/// or either of these minus the same constant.
fn peir_rot_same(f: &IrFunction, a: i64, pa: i64, b: i64, pb: i64, body: Vec<i64>, facts: PeirLoopFacts, depth: i64) -> bool {
    if a == b {
        return true;
    }
    if depth > 3 {
        return false;
    }
    match peir_inst_of(f, a) {
        Inst::Load(xa, _) => {
            match peir_inst_of(f, b) {
                Inst::Load(xb, _) => {
                    if xa != xb || xa < 0 || xa >= facts.plain.len() || facts.plain.get(xa) == 0 {
                        return false;
                    }
                    var i: i64 = 0;
                    while i < facts.st_ptr.len() {
                        if facts.st_ptr.get(i) == xa && body.get(facts.st_block.get(i)) != 0 {
                            return false;
                        }
                        i = i + 1;
                    }
                    if facts.block_of.get(a) == pa && peir_stored_after(&facts, xa, pa, facts.at.get(a)) {
                        return false;
                    }
                    if facts.block_of.get(b) == pb && peir_stored_after(&facts, xa, pb, facts.at.get(b)) {
                        return false;
                    }
                    return true;
                }
                _ => {
                    return false;
                }
            }
        }
        Inst::Call(na, aa, _, _) => {
            match peir_inst_of(f, b) {
                Inst::Call(nb, ab, _, _) => {
                    if !peir_is_len(f, a) || !peir_is_len(f, b) || aa.len() == 0 || ab.len() == 0 || na != nb {
                        return false;
                    }
                    return peir_same_vec(f, aa.get(aa.len() - 1), ab.get(ab.len() - 1), body, facts);
                }
                _ => {
                    return false;
                }
            }
        }
        Inst::BinOp(opa, a1, ka, ta) => {
            match peir_inst_of(f, b) {
                Inst::BinOp(opb, b1, kb, tb) => {
                    if !binop_eq(opa, BinOp::Sub) || !binop_eq(opb, BinOp::Sub) || !ir_type_eq(ta, IrType::I64) || !ir_type_eq(tb, IrType::I64) {
                        return false;
                    }
                    var same_k: bool = false;
                    match peir_inst_of(f, ka) {
                        Inst::ConstInt(va, _) => {
                            match peir_inst_of(f, kb) {
                                Inst::ConstInt(vb, _) => {
                                    same_k = va == vb;
                                }
                                _ => {
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    return same_k && peir_rot_same(f, a1, pa, b1, pb, body, facts, depth + 1);
                }
                _ => {
                    return false;
                }
            }
        }
        _ => {
            return false;
        }
    }
}

/// ME23: the test of a rotated loop (iropt_me.fd ime_rotate) headed by
/// `head`, which itself tests nothing: every predecessor of `head` ends in
/// Branch(c, head, out) with `out` outside the loop, every c is `i < r` (or
/// `<=`, `>`, `>=`: one operator for all) on loads of one i64 slot, each
/// load in its predecessor with no store to the slot after it there, and
/// every r the same bound as the one on the way in (peir_rot_same). Then
/// `i < r` holds whenever the loop's header starts, as in a loop that tests
/// in its header. Returns the condition on the way in (some predecessor
/// outside the loop), -1 when the loop is not of this shape.
fn peir_rotated_test(f: &IrFunction, head: i64, body: Vec<i64>, preds: Vec<Vec<i64>>, index: Vec<i64>, facts: PeirLoopFacts) -> i64 {
    var ps: Vec<i64> = preds.get(head);
    if ps.len() < 2 {
        return -1;
    }
    var canon: i64 = -1;
    var canon_r: i64 = -1;
    var canon_p: i64 = -1;
    var c_op: i64 = -1;
    var slot: i64 = -1;
    var nin: i64 = 0;
    var rights: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < ps.len() {
        var p: i64 = ps.get(i);
        var ids: Vec<i64> = f.blocks.get(p).instructions;
        if ids.len() == 0 {
            return -1;
        }
        var c: i64 = -1;
        match peir_inst_of(f, ids.get(ids.len() - 1)) {
            Inst::Branch(bc, t, e) => {
                if t < 0 || t >= index.len() || e < 0 || e >= index.len() {
                    return -1;
                }
                if index.get(t) != head || index.get(e) < 0 || index.get(e) == head || body.get(index.get(e)) != 0 {
                    return -1;
                }
                c = bc;
            }
            _ => {
                return -1;
            }
        }
        var opk: i64 = -1;
        var l: i64 = -1;
        var r: i64 = -1;
        match peir_inst_of(f, c) {
            Inst::BinOp(op, a, b, _) => {
                if binop_eq(op, BinOp::Lt) {
                    opk = 1;
                    l = a;
                    r = b;
                } else if binop_eq(op, BinOp::LtEq) {
                    opk = 2;
                    l = a;
                    r = b;
                } else if binop_eq(op, BinOp::Gt) {
                    opk = 3;
                    l = b;
                    r = a;
                } else if binop_eq(op, BinOp::GtEq) {
                    opk = 4;
                    l = b;
                    r = a;
                } else {
                    return -1;
                }
            }
            _ => {
                return -1;
            }
        }
        if c_op >= 0 && opk != c_op {
            return -1;
        }
        c_op = opk;
        var ls: i64 = -1;
        match peir_inst_of(f, l) {
            Inst::Load(lp, lty) => {
                if !ir_type_eq(lty, IrType::I64) {
                    return -1;
                }
                ls = lp;
            }
            _ => {
                return -1;
            }
        }
        if ls < 0 || (slot >= 0 && ls != slot) {
            return -1;
        }
        slot = ls;
        // the test reads i as the header will see it
        if l < 0 || l >= facts.block_of.len() || facts.block_of.get(l) != p {
            return -1;
        }
        if peir_stored_after(&facts, slot, p, facts.at.get(l)) {
            return -1;
        }
        rights.push(r);
        if body.get(p) == 0 {
            if canon < 0 {
                canon = c;
                canon_r = r;
                canon_p = p;
            }
        } else {
            nin = nin + 1;
        }
        i = i + 1;
    }
    if canon < 0 || nin == 0 {
        return -1;
    }
    i = 0;
    while i < ps.len() {
        if !peir_rot_same(f, rights.get(i), ps.get(i), canon_r, canon_p, body, facts, 0) {
            return -1;
        }
        i = i + 1;
    }
    return canon;
}

/// `lbody`: the loop's blocks (flags per block index), the shared loop
/// tree's body of the loop headed by `head` (iro_loop_body, ME2).
pub fn peir_counted_loop(f: &IrFunction, head: i64, n: i64, succs: Vec<Vec<i64>>, preds: Vec<Vec<i64>>, lbody: Vec<i64>, index: Vec<i64>, facts: PeirLoopFacts, out: &mut Vec<i64>) {
    var body: Vec<i64> = lbody;
    var work: Vec<i64> = Vec::new();
    var i: i64 = 0;
    // The guard: `i < right`, entering the loop only when it holds
    var head_ids: Vec<i64> = f.blocks.get(head).instructions;
    if head_ids.len() == 0 {
        return;
    }
    var cond: i64 = -1;
    var then_b: i64 = -1;
    var else_b: i64 = -1;
    match peir_inst_of(f, head_ids.get(head_ids.len() - 1)) {
        Inst::Branch(c, t, e) => {
            cond = c;
            if t < index.len() {
                then_b = index.get(t);
            }
            if e < index.len() {
                else_b = index.get(e);
            }
        }
        _ => {
        }
    }
    // ME23: a rotated loop (iropt_me.fd ime_rotate) tests on every edge
    // into its header instead: the way in from outside and each latch end
    // in Branch(i < right, head, out), with the same i and bound. Nov 21
    // evening: a rotated loop of one body block is a SELF-loop — the head
    // ends in Branch(test, head, out), its own latch — which took the
    // normal path below and was then refused at "the step may be in the
    // header" (store_block == head && !rotated). A branch to the head
    // itself is the rotated shape too.
    var rotated: bool = false;
    if then_b < 0 || else_b < 0 || body.get(then_b) == 0 || body.get(else_b) != 0 || then_b == head || else_b == head {
        cond = peir_rotated_test(f, head, body, preds, index, facts);
        if cond < 0 {
            return;
        }
        rotated = true;
    }
    var left: i64 = -1;
    var right: i64 = -1;
    var le_test: bool = false;
    match peir_inst_of(f, cond) {
        Inst::BinOp(op, l, r, _) => {
            match op {
                BinOp::Lt => {
                    left = l;
                    right = r;
                }
                // LF7: `i <= b - 1` is `i < b` (b - 1 either checked or in
                // @wrapping code, where i + 1 has no check to drop)
                BinOp::LtEq => {
                    left = l;
                    right = r;
                    le_test = true;
                }
                // LF7: the same tests written the other way round:
                // `right > i` and `right >= i`
                BinOp::Gt => {
                    left = r;
                    right = l;
                }
                BinOp::GtEq => {
                    left = r;
                    right = l;
                    le_test = true;
                }
                _ => {
                    return;
                }
            }
        }
        _ => {
            return;
        }
    }
    // The Vec length L the bound stays at or below, and d: i < L - d at the
    // test (peir_len_minus); -1 while not known
    var len_call: i64 = -1;
    var len_d: i64 = 0;
    if le_test {
        // LF7: `i <= L - d` (d >= 1) is `i < L - (d - 1)`
        var lm0: Vec<i64> = peir_len_minus(f, right, body, facts);
        if lm0.get(0) >= 0 && lm0.get(1) >= 1 {
            len_call = lm0.get(0);
            len_d = lm0.get(1) - 1;
        } else {
            right = peir_le_bound(f, right, body, facts);
            if right < 0 {
                return;
            }
        }
    }
    var slot: i64 = -1;
    match peir_inst_of(f, left) {
        Inst::Load(p, ty) => {
            match ty {
                IrType::I64 => {
                    slot = p;
                }
                _ => {
                    return;
                }
            }
        }
        _ => {
            return;
        }
    }
    if facts.plain.get(slot) == 0 || body.get(facts.block_of.get(slot)) != 0 {
        return;
    }
    // The only store in the loop: `i = i + 1`
    var inside: i64 = 0;
    var store_block: i64 = -1;
    var store_at: i64 = -1;
    var value: i64 = -1;
    var starts_ok: bool = true;
    var step_c: i64 = 1;
    // LF7: the smallest start: i >= start_min in the loop (it only grows)
    var start_min: i64 = 1048576;
    var nstarts: i64 = 0;
    i = 0;
    while i < facts.st_ptr.len() {
        if facts.st_ptr.get(i) == slot {
            if body.get(facts.st_block.get(i)) != 0 {
                inside = inside + 1;
                store_block = facts.st_block.get(i);
                store_at = facts.st_at.get(i);
                value = facts.st_value.get(i);
            } else {
                nstarts = nstarts + 1;
                match peir_inst_of(f, facts.st_value.get(i)) {
                    Inst::ConstInt(v, _) => {
                        if v < 0 {
                            starts_ok = false;
                        } else if v < start_min {
                            start_min = v;
                        }
                    }
                    _ => {
                        starts_ok = false;
                    }
                }
            }
        }
        i = i + 1;
    }
    // (rotated: the header runs after the test, so the step may be in it;
    // peir_rotated_test made sure no test reads i before a step after it)
    if inside != 1 || (store_block == head && !rotated) {
        return;
    }
    match peir_inst_of(f, value) {
        Inst::BinOp(op, x, one, ty) => {
            match op {
                BinOp::Add => {
                }
                _ => {
                    return;
                }
            }
            match ty {
                IrType::I64 => {
                }
                _ => {
                    return;
                }
            }
            if !peir_load_of(f, x, slot) {
                return;
            }
            // ME25 (Nov 16): any step from 1 to 2^20, not only 1. With i <
            // right at the test, i >= 0 and i stepping up, every index the
            // body reads before the step is in [0, right), whatever the step
            match peir_inst_of(f, one) {
                Inst::ConstInt(c, _) => {
                    if c < 1 || c > 1048576 {
                        return;
                    }
                    step_c = c;
                }
                _ => {
                    return;
                }
            }
        }
        _ => {
            return;
        }
    }
    // i + 1 cannot overflow when i < right; i + c (c > 1) only once right is
    // known to be at most a Vec's length (below)
    if step_c == 1 {
        out.set(value, out.get(value) | 1);
    }
    // Bounds: `right` is v.len(), or a local set once, before the loop, to
    // it; LF7: or either of them minus a constant d >= 0 (peir_len_minus)
    if len_call < 0 {
        var lm: Vec<i64> = peir_len_minus(f, right, body, facts);
        if lm.get(0) >= 0 {
            len_call = lm.get(0);
            len_d = lm.get(1);
        }
    }
    if nstarts == 0 {
        start_min = 0;
    }
    // LF11/ME25: the only way into the loop from outside passes a guard
    // `right <= v.len() && i >= 0` (iropt's loop versioning makes one):
    // it bounds `right` by a Vec's length and starts `i` at >= 0
    var eg: Vec<i64> = peir_entry_guard(f, head, body, slot, right, preds, index, facts);
    if len_call < 0 {
        len_call = eg.get(1);
        len_d = 0;
    }
    if !starts_ok && eg.get(0) == 1 {
        starts_ok = true;
        start_min = 0;
    }
    if len_call < 0 {
        return;
    }
    var vec_val: i64 = -1;
    match peir_inst_of(f, len_call) {
        Inst::Call(_, args, _, _) => {
            if args.len() == 0 {
                return;
            }
            vec_val = args.get(args.len() - 1);
        }
        _ => {
            return;
        }
    }
    if !starts_ok {
        return;
    }
    // The Vec's own slot (when it is a loaded local): re-storing it between
    // the len and the loop measures another Vec
    var vslot: i64 = -1;
    match peir_inst_of(f, vec_val) {
        Inst::Load(vp, _) => {
            vslot = vp;
        }
        _ => {
        }
    }
    var len_block: i64 = facts.block_of.get(len_call);
    if body.get(len_block) == 0 {
        // Nothing shortens v after the len and before the loop: not later in
        // its block, nor in a block on a path from it to the loop
        var len_ids: Vec<i64> = f.blocks.get(len_block).instructions;
        i = facts.at.get(len_call) + 1;
        while i < len_ids.len() {
            if peir_may_shorten(f, len_ids.get(i)) || peir_stores_to(f, len_ids.get(i), vslot) {
                return;
            }
            i = i + 1;
        }
        var fwd: Vec<i64> = peir_reach(succs, succs.get(len_block), body, n);
        var into: Vec<i64> = peir_reach(preds, preds.get(head), body, n);
        var bb: i64 = 0;
        while bb < n {
            if fwd.get(bb) != 0 && into.get(bb) != 0 && bb != len_block {
                var ids: Vec<i64> = f.blocks.get(bb).instructions;
                i = 0;
                while i < ids.len() {
                    if peir_may_shorten(f, ids.get(i)) || peir_stores_to(f, ids.get(i), vslot) {
                        return;
                    }
                    i = i + 1;
                }
            }
            bb = bb + 1;
        }
    }
    var b2: i64 = 0;
    while b2 < n {
        if body.get(b2) != 0 {
            var ids: Vec<i64> = f.blocks.get(b2).instructions;
            i = 0;
            while i < ids.len() {
                if peir_may_shorten(f, ids.get(i)) {
                    return;
                }
                i = i + 1;
            }
        }
        b2 = b2 + 1;
    }
    // ME25: i < right <= v.len() (a length is below 2^60) and c <= 2^20:
    // i + c fits
    if step_c > 1 {
        out.set(value, out.get(value) | 1);
    }
    // The blocks that can run after the increment, in the same iteration
    var after: Vec<i64> = peir_zeros(n);
    work = Vec::new();
    var first: Vec<i64> = succs.get(store_block);
    i = 0;
    while i < first.len() {
        work.push(first.get(i));
        i = i + 1;
    }
    while work.len() > 0 {
        var b: i64 = work.pop();
        if b != head && after.get(b) == 0 {
            after.set(b, 1);
            var ss: Vec<i64> = succs.get(b);
            i = 0;
            while i < ss.len() {
                work.push(ss.get(i));
                i = i + 1;
            }
        }
    }
    b2 = 0;
    while b2 < n {
        // (rotated: the header too runs after a test let the loop in)
        if body.get(b2) != 0 && (b2 != head || rotated) {
            var ids: Vec<i64> = f.blocks.get(b2).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                var id: i64 = ids.get(k);
                match peir_inst_of(f, id) {
                    Inst::Call(name, args, _, _) => {
                        var at: i64 = -1;
                        if (name == "Vec_get" || name == "p_vec_get") && args.len() >= 2 {
                            at = args.len() - 2;
                        }
                        if (name == "Vec_set" || name == "p_vec_set") && args.len() >= 3 {
                            at = args.len() - 3;
                        }
                        if at >= 0 && peir_same_vec(f, args.get(at), vec_val, body, facts) {
                            // LF7: the index is i, or i + e / i - e: before
                            // the step i is in [start_min, L - d - 1], so
                            // i + e is in bounds when start_min + e >= 0
                            // and e <= d (and cannot overflow)
                            var li: Vec<i64> = peir_loop_index(f, args.get(at + 1), slot);
                            var ld: i64 = li.get(0);
                            var off: i64 = li.get(1);
                            if ld >= 0 && start_min + off >= 0 && off <= len_d {
                                var lb: i64 = facts.block_of.get(ld);
                                var lk: i64 = facts.at.get(ld);
                                if after.get(lb) == 0 && !(lb == store_block && lk > store_at) {
                                    out.set(id, out.get(id) | 1);
                                    if li.get(2) >= 0 {
                                        out.set(li.get(2), out.get(li.get(2)) | 1);
                                    }
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                k = k + 1;
            }
        }
        b2 = b2 + 1;
    }
}

/// LF7: the index `idx` of a Vec access in a counted loop over the slot
/// `slot`: [load, offset, arith]. A load of the slot is [idx, 0, -1]; `load
/// + e`, `e + load` or `load - e` (an i64 BinOp with a constant |e| <=
/// 2^20) is [load, e or -e, that BinOp]; anything else [-1, 0, -1].
fn peir_loop_index(f: &IrFunction, idx: i64, slot: i64) -> Vec<i64> {
    var res: Vec<i64> = Vec::new();
    res.push(-1);
    res.push(0);
    res.push(-1);
    if peir_load_of(f, idx, slot) {
        res.set(0, idx);
        return res;
    }
    match peir_inst_of(f, idx) {
        Inst::BinOp(op, a, b, ty) => {
            match ty {
                IrType::I64 => {
                }
                _ => {
                    return res;
                }
            }
            var is_add: bool = false;
            match op {
                BinOp::Add => {
                    is_add = true;
                }
                BinOp::Sub => {
                }
                _ => {
                    return res;
                }
            }
            var ld: i64 = -1;
            var cst: i64 = -1;
            if peir_load_of(f, a, slot) {
                ld = a;
                cst = b;
            } else if is_add && peir_load_of(f, b, slot) {
                ld = b;
                cst = a;
            }
            if ld < 0 {
                return res;
            }
            match peir_inst_of(f, cst) {
                Inst::ConstInt(e, _) => {
                    if e >= 0 - 1048576 && e <= 1048576 {
                        res.set(0, ld);
                        if is_add {
                            res.set(1, e);
                        } else {
                            res.set(1, 0 - e);
                        }
                        res.set(2, idx);
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return res;
}

/// LF7: a bound `v` that is a Vec's length minus a constant: [L, d] with
/// v == L - d always, L a Vec_len call and 0 <= d <= 2^20. `v` is L itself
/// (d = 0), `L - d`, or a load of a plain local stored once, outside the
/// loop `body`, with one of those. [-1, 0] otherwise. The caller checks
/// that nothing shortens the Vec from L to the loop's end.
fn peir_len_minus(f: &IrFunction, v: i64, body: Vec<i64>, facts: PeirLoopFacts) -> Vec<i64> {
    var res: Vec<i64> = Vec::new();
    res.push(-1);
    res.push(0);
    var x: i64 = v;
    match peir_inst_of(f, v) {
        Inst::Load(p, _) => {
            if p < 0 || p >= facts.plain.len() || facts.plain.get(p) == 0 {
                return res;
            }
            var count: i64 = 0;
            var sv: i64 = -1;
            var i: i64 = 0;
            while i < facts.st_ptr.len() {
                if facts.st_ptr.get(i) == p {
                    count = count + 1;
                    if body.get(facts.st_block.get(i)) == 0 {
                        sv = facts.st_value.get(i);
                    }
                }
                i = i + 1;
            }
            if count != 1 || sv < 0 {
                return res;
            }
            x = sv;
        }
        _ => {
        }
    }
    if peir_is_len(f, x) {
        res.set(0, x);
        return res;
    }
    match peir_inst_of(f, x) {
        Inst::BinOp(op, a, c, ty) => {
            match op {
                BinOp::Sub => {
                }
                _ => {
                    return res;
                }
            }
            match ty {
                IrType::I64 => {
                }
                _ => {
                    return res;
                }
            }
            if !peir_is_len(f, a) {
                return res;
            }
            match peir_inst_of(f, c) {
                Inst::ConstInt(d, _) => {
                    if d >= 0 && d <= 1048576 {
                        res.set(0, a);
                        res.set(1, d);
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return res;
}

/// LF7: `v` is `a - 1` (an i64 subtraction of the constant 1): `a`, or -1.
fn peir_minus_one_of(f: &IrFunction, v: i64) -> i64 {
    match peir_inst_of(f, v) {
        Inst::BinOp(op, a, one, ty) => {
            match op {
                BinOp::Sub => {
                }
                _ => {
                    return -1;
                }
            }
            match ty {
                IrType::I64 => {
                }
                _ => {
                    return -1;
                }
            }
            match peir_inst_of(f, one) {
                Inst::ConstInt(c, _) => {
                    if c == 1 {
                        return a;
                    }
                }
                _ => {
                }
            }
        }
        _ => {
        }
    }
    return -1;
}

/// LF7: for a loop test `i <= r`, the value `b` with r == b - 1 always: r
/// is `b - 1` itself, or a load of a local stored once, before the loop,
/// with `b - 1`. -1 when r is neither.
fn peir_le_bound(f: &IrFunction, r: i64, body: Vec<i64>, facts: PeirLoopFacts) -> i64 {
    var v: i64 = r;
    match peir_inst_of(f, r) {
        Inst::Load(p, _) => {
            if p < 0 || p >= facts.plain.len() || facts.plain.get(p) == 0 {
                return -1;
            }
            var count: i64 = 0;
            var sv: i64 = -1;
            var i: i64 = 0;
            while i < facts.st_ptr.len() {
                if facts.st_ptr.get(i) == p {
                    count = count + 1;
                    if body.get(facts.st_block.get(i)) == 0 {
                        sv = facts.st_value.get(i);
                    }
                }
                i = i + 1;
            }
            if count != 1 || sv < 0 {
                return -1;
            }
            v = sv;
        }
        _ => {
        }
    }
    return peir_minus_one_of(f, v);
}

/// LF7: nothing can shorten the Vec measured by `len_call` (whose slot is
/// `vslot`, -1 when it is no loaded local) from that call to the end of
/// the loop at `head`: not later in the call's block, in a block on a way
/// from it into the loop, nor in the loop. The len is outside the loop.
fn peir_len_stable(f: &IrFunction, len_call: i64, vslot: i64, head: i64, body: Vec<i64>, succs: Vec<Vec<i64>>, preds: Vec<Vec<i64>>, n: i64, facts: PeirLoopFacts) -> bool {
    var len_block: i64 = facts.block_of.get(len_call);
    if len_block < 0 || len_block >= n || body.get(len_block) != 0 {
        return false;
    }
    var len_ids: Vec<i64> = f.blocks.get(len_block).instructions;
    var i: i64 = facts.at.get(len_call) + 1;
    while i < len_ids.len() {
        if peir_may_shorten(f, len_ids.get(i)) || peir_stores_to(f, len_ids.get(i), vslot) {
            return false;
        }
        i = i + 1;
    }
    var fwd: Vec<i64> = peir_reach(succs, succs.get(len_block), body, n);
    var into: Vec<i64> = peir_reach(preds, preds.get(head), body, n);
    var bb: i64 = 0;
    while bb < n {
        if (fwd.get(bb) != 0 && into.get(bb) != 0 && bb != len_block) || body.get(bb) != 0 {
            var ids: Vec<i64> = f.blocks.get(bb).instructions;
            i = 0;
            while i < ids.len() {
                if peir_may_shorten(f, ids.get(i)) {
                    return false;
                }
                // the Vec's slot re-stored before the loop measures another
                // Vec (in the loop, peir_same_vec looks for that)
                if body.get(bb) == 0 && peir_stores_to(f, ids.get(i), vslot) {
                    return false;
                }
                i = i + 1;
            }
        }
        bb = bb + 1;
    }
    return true;
}

/// LF7: a loop counting down by one over a Vec's indexes:
///   var i = v.len();     while i > 0  { i = i - 1; .. v.get(i) .. }
///   var i = v.len() - 1; while i >= 0 { .. v.get(i) .. i = i - 1; }
/// with `i` an unshared local the loop changes only by `i = i - 1`. The
/// decrement needs no overflow check (i > 0, or i >= 0, when it runs). When
/// also every store to `i` outside the loop is that length (`- 1` for
/// `>=`) or a constant the test never lets in, and nothing shortens `v`
/// from that `len` to the loop's end, then i <= v.len() (v.len() - 1) at the
/// test, and `v.get(i)` / `v.set(i, x)` are in bounds where `i` is read
/// after the decrement (`>`: in [0, len - 1]) or before it (`>=`).
/// Since Nov 17 (LF7) in general: the test is `i >= K` (or `i > K - 1`,
/// `K <= i`, `K - 1 < i`; 0 <= K <= 2^20), the step `i = i - c` (1 <= c
/// <= 2^20) and the starts L - d (d >= 0, peir_len_minus) or constants
/// below K. Then i is in [K, L - d] at the test, so a read at `i + o`
/// before the decrement is in bounds when K + o >= 0 and o <= d - 1, and
/// one after it (i - c + o) when K - c + o >= 0 and o <= d + c - 1.
fn peir_counted_down(f: &IrFunction, head: i64, n: i64, succs: Vec<Vec<i64>>, preds: Vec<Vec<i64>>, body: Vec<i64>, index: Vec<i64>, facts: PeirLoopFacts, out: &mut Vec<i64>) {
    var head_ids: Vec<i64> = f.blocks.get(head).instructions;
    if head_ids.len() == 0 {
        return;
    }
    var cond: i64 = -1;
    var then_b: i64 = -1;
    var else_b: i64 = -1;
    match peir_inst_of(f, head_ids.get(head_ids.len() - 1)) {
        Inst::Branch(c, t, e) => {
            cond = c;
            if t < index.len() {
                then_b = index.get(t);
            }
            if e < index.len() {
                else_b = index.get(e);
            }
        }
        _ => {
            return;
        }
    }
    if then_b < 0 || else_b < 0 || body.get(then_b) == 0 || body.get(else_b) != 0 {
        return;
    }
    // The test, as `i >= kmin`: `i > K` and `K < i` are kmin = K + 1, `i
    // >= K` and `K <= i` kmin = K
    var left: i64 = -1;
    var kconst: i64 = -1;
    var strict: bool = false;
    match peir_inst_of(f, cond) {
        Inst::BinOp(op, l, r, _) => {
            match op {
                BinOp::Gt => {
                    strict = true;
                    left = l;
                    kconst = r;
                }
                BinOp::GtEq => {
                    left = l;
                    kconst = r;
                }
                // LF7: written the other way round
                BinOp::Lt => {
                    strict = true;
                    left = r;
                    kconst = l;
                }
                BinOp::LtEq => {
                    left = r;
                    kconst = l;
                }
                _ => {
                    return;
                }
            }
        }
        _ => {
            return;
        }
    }
    var kmin: i64 = 0;
    match peir_inst_of(f, kconst) {
        Inst::ConstInt(c, _) => {
            if c < 0 - 1 || c > 1048576 {
                return;
            }
            kmin = c;
            if strict {
                kmin = c + 1;
            }
            if kmin < 0 {
                return;
            }
        }
        _ => {
            return;
        }
    }
    var slot: i64 = -1;
    match peir_inst_of(f, left) {
        Inst::Load(p, ty) => {
            match ty {
                IrType::I64 => {
                    slot = p;
                }
                _ => {
                    return;
                }
            }
        }
        _ => {
            return;
        }
    }
    if slot < 0 || slot >= facts.plain.len() || facts.plain.get(slot) == 0 || body.get(facts.block_of.get(slot)) != 0 {
        return;
    }
    // The only store in the loop: `i = i - c`; the stores before it give
    // the start: L - d (the smallest d of them all), or a constant the
    // test never lets in
    var inside: i64 = 0;
    var store_block: i64 = -1;
    var store_at: i64 = -1;
    var value: i64 = -1;
    var len_call: i64 = -1;
    var len_d: i64 = 1048576;
    var starts_ok: bool = true;
    var i: i64 = 0;
    while i < facts.st_ptr.len() {
        if facts.st_ptr.get(i) == slot {
            if body.get(facts.st_block.get(i)) != 0 {
                inside = inside + 1;
                store_block = facts.st_block.get(i);
                store_at = facts.st_at.get(i);
                value = facts.st_value.get(i);
            } else {
                var sv: i64 = facts.st_value.get(i);
                var lm: Vec<i64> = peir_len_minus(f, sv, body, facts);
                var lc: i64 = lm.get(0);
                if lc >= 0 {
                    if len_call >= 0 && len_call != lc {
                        starts_ok = false;
                    }
                    len_call = lc;
                    if lm.get(1) < len_d {
                        len_d = lm.get(1);
                    }
                } else {
                    match peir_inst_of(f, sv) {
                        Inst::ConstInt(c, _) => {
                            // a start the test never lets into the loop
                            if c >= kmin {
                                starts_ok = false;
                            }
                        }
                        _ => {
                            starts_ok = false;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    if inside != 1 || store_block == head {
        return;
    }
    // The blocks that can run after the decrement in the same iteration; a
    // decrement that can run twice before the test is no counted loop
    var after: Vec<i64> = peir_zeros(n);
    var work: Vec<i64> = Vec::new();
    var first: Vec<i64> = succs.get(store_block);
    i = 0;
    while i < first.len() {
        work.push(first.get(i));
        i = i + 1;
    }
    while work.len() > 0 {
        var b: i64 = work.pop();
        if b != head && body.get(b) != 0 && after.get(b) == 0 {
            after.set(b, 1);
            var ss: Vec<i64> = succs.get(b);
            i = 0;
            while i < ss.len() {
                work.push(ss.get(i));
                i = i + 1;
            }
        }
    }
    if after.get(store_block) != 0 {
        return;
    }
    // The decrement, of `i` as the test let it in: computed in the loop,
    // after the test; LF7: by any constant c in 1..2^20 (i >= kmin >= 0
    // there, so i - c cannot overflow)
    var step_c: i64 = 1;
    match peir_inst_of(f, value) {
        Inst::BinOp(op, x, one, ty) => {
            match op {
                BinOp::Sub => {
                }
                _ => {
                    return;
                }
            }
            match ty {
                IrType::I64 => {
                }
                _ => {
                    return;
                }
            }
            if !peir_load_of(f, x, slot) || body.get(facts.block_of.get(x)) == 0 {
                return;
            }
            var vb: i64 = facts.block_of.get(value);
            if vb == head || body.get(vb) == 0 {
                return;
            }
            match peir_inst_of(f, one) {
                Inst::ConstInt(c, _) => {
                    if c < 1 || c > 1048576 {
                        return;
                    }
                    step_c = c;
                }
                _ => {
                    return;
                }
            }
        }
        _ => {
            return;
        }
    }
    out.set(value, out.get(value) | 1);
    if !starts_ok || len_call < 0 {
        return;
    }
    var vec_val: i64 = -1;
    match peir_inst_of(f, len_call) {
        Inst::Call(_, args, _, _) => {
            if args.len() == 0 {
                return;
            }
            vec_val = args.get(args.len() - 1);
        }
        _ => {
            return;
        }
    }
    var vslot: i64 = -1;
    match peir_inst_of(f, vec_val) {
        Inst::Load(vp, _) => {
            vslot = vp;
        }
        _ => {
        }
    }
    if !peir_len_stable(f, len_call, vslot, head, body, succs, preds, n, facts) {
        return;
    }
    // `>`: the blocks a way from the test reaches before the decrement
    var before: Vec<i64> = peir_zeros(n);
    work = Vec::new();
    work.push(then_b);
    while work.len() > 0 {
        var b: i64 = work.pop();
        if b != head && body.get(b) != 0 && before.get(b) == 0 {
            before.set(b, 1);
            if b != store_block {
                var ss: Vec<i64> = succs.get(b);
                i = 0;
                while i < ss.len() {
                    work.push(ss.get(i));
                    i = i + 1;
                }
            }
        }
    }
    var b2: i64 = 0;
    while b2 < n {
        if body.get(b2) != 0 && b2 != head {
            var ids: Vec<i64> = f.blocks.get(b2).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                var id: i64 = ids.get(k);
                match peir_inst_of(f, id) {
                    Inst::Call(name, args, _, _) => {
                        var at: i64 = -1;
                        if (name == "Vec_get" || name == "p_vec_get") && args.len() >= 2 {
                            at = args.len() - 2;
                        }
                        if (name == "Vec_set" || name == "p_vec_set") && args.len() >= 3 {
                            at = args.len() - 3;
                        }
                        // LF7: the index is i + o (peir_loop_index); i is
                        // in [kmin, L - d] at the test
                        var li: Vec<i64> = Vec::new();
                        if at >= 0 && peir_same_vec(f, args.get(at), vec_val, body, facts) {
                            li = peir_loop_index(f, args.get(at + 1), slot);
                        }
                        if li.len() == 3 && li.get(0) >= 0 {
                            var ld: i64 = li.get(0);
                            var off: i64 = li.get(1);
                            var lb: i64 = facts.block_of.get(ld);
                            var lk: i64 = facts.at.get(ld);
                            var ok: bool = false;
                            if lb != head && body.get(lb) != 0 {
                                var is_after: bool = false;
                                var is_before: bool = false;
                                if lb == store_block {
                                    is_after = lk > store_at;
                                    is_before = lk < store_at;
                                } else {
                                    is_after = before.get(lb) == 0 && after.get(lb) != 0;
                                    is_before = after.get(lb) == 0;
                                }
                                if is_after {
                                    // read after the decrement: i - c + o
                                    ok = kmin - step_c + off >= 0 && off <= len_d + step_c - 1;
                                }
                                if is_before {
                                    // read before it: i + o
                                    ok = kmin + off >= 0 && off <= len_d - 1;
                                }
                            }
                            if ok {
                                out.set(id, out.get(id) | 1);
                                if li.get(2) >= 0 {
                                    out.set(li.get(2), out.get(li.get(2)) | 1);
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                k = k + 1;
            }
        }
        b2 = b2 + 1;
    }
}

/// Is instruction `id` a store to slot `p` (p >= 0)?
fn peir_stores_to(f: &IrFunction, id: i64, p: i64) -> bool {
    if p < 0 {
        return false;
    }
    match peir_inst_of(f, id) {
        Inst::Store(sp, _, _) => {
            return sp == p;
        }
        _ => {
            return false;
        }
    }
}

/// An instruction that cannot write memory or call: a block of only these
/// between a guard and the loop keeps what the guard measured.
fn peir_quiet_inst(inst: Inst) -> bool {
    match inst {
        Inst::ConstInt(_, _) => {
            return true;
        }
        Inst::ConstBool(_) => {
            return true;
        }
        Inst::Load(_, _) => {
            return true;
        }
        Inst::BinOp(_, _, _, _) => {
            return true;
        }
        Inst::GetFieldPtr(_, _, _) => {
            return true;
        }
        Inst::BitCast(_, _, _) => {
            return true;
        }
        Inst::IntExtend(_, _, _) => {
            return true;
        }
        Inst::Jump(_) => {
            return true;
        }
        _ => {
            return false;
        }
    }
}

/// The conditions `c` is the conjunction of (`a && b` is And(a, b)).
fn peir_conjuncts(f: &IrFunction, c: i64, out: &mut Vec<i64>, depth: i64) {
    if depth < 8 {
        match peir_inst_of(f, c) {
            Inst::BinOp(op, a, b, _) => {
                match op {
                    BinOp::And => {
                        peir_conjuncts(f, a, out, depth + 1);
                        peir_conjuncts(f, b, out, depth + 1);
                        return;
                    }
                    _ => {
                    }
                }
            }
            _ => {
            }
        }
    }
    out.push(c);
}

/// Does `x` (in guard block `ids`) read the loop's bound `right`: the same
/// value, or a load of the same plain slot `pn` with no store to it after
/// x in the block (the loop never stores pn: the caller checked)?
fn peir_guard_same(f: &IrFunction, ids: Vec<i64>, x: i64, right: i64, pn: i64) -> bool {
    if x == right {
        return true;
    }
    if pn < 0 || !peir_load_of(f, x, pn) {
        return false;
    }
    var at: i64 = -1;
    var k: i64 = 0;
    while k < ids.len() {
        if ids.get(k) == x {
            at = k;
        }
        k = k + 1;
    }
    if at < 0 {
        return false;
    }
    k = at + 1;
    while k < ids.len() {
        if peir_stores_to(f, ids.get(k), pn) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

/// LF11/ME25: what a guard on the loop's only way in from outside proves.
/// The way in is one block outside the loop (`head`'s other predecessors
/// are in `body`); going up from it through blocks of one predecessor that
/// only compute (peir_quiet_inst), each Branch whose true edge leads down
/// to the loop adds its conjuncts. Returns [lo, len]: lo = 1 when a conjunct is `i >= k`
/// (k a constant >= 0, i a load of the loop's slot with no store to it
/// after it in the guard block), len = a Vec_len call L when a conjunct is
/// `right <= L` (or `L >= right`) on the loop's bound (peir_guard_same; a
/// bound loaded from a slot needs that slot unstored in the loop), -1 else.
/// The caller checks, as for any len, that nothing shortens the Vec or
/// re-stores its slot from L to the loop.
fn peir_entry_guard(f: &IrFunction, head: i64, body: Vec<i64>, slot: i64, right: i64, preds: Vec<Vec<i64>>, index: Vec<i64>, facts: PeirLoopFacts) -> Vec<i64> {
    var res: Vec<i64> = Vec::new();
    res.push(0);
    res.push(-1);
    var ps: Vec<i64> = preds.get(head);
    var outside: i64 = -1;
    var i: i64 = 0;
    while i < ps.len() {
        if body.get(ps.get(i)) == 0 {
            if outside >= 0 && outside != ps.get(i) {
                return res;
            }
            outside = ps.get(i);
        }
        i = i + 1;
    }
    if outside < 0 {
        return res;
    }
    // Up from the way in: each Branch whose true edge leads here adds its
    // condition; the walk goes on through blocks that only compute and
    // have one way in
    var cur: i64 = outside;
    var into: i64 = head;
    var conds: Vec<i64> = Vec::new();
    var cblk: Vec<i64> = Vec::new();
    var going: bool = true;
    var steps: i64 = 0;
    while going && steps < 6 {
        going = false;
        var ids: Vec<i64> = f.blocks.get(cur).instructions;
        if ids.len() == 0 {
            break;
        }
        var quiet: bool = true;
        var k: i64 = 0;
        while k + 1 < ids.len() {
            if !peir_quiet_inst(peir_inst_of(f, ids.get(k))) {
                quiet = false;
            }
            k = k + 1;
        }
        match peir_inst_of(f, ids.get(ids.len() - 1)) {
            Inst::Branch(c, t, e) => {
                if t != e && t >= 0 && t < index.len() && index.get(t) == into {
                    conds.push(c);
                    cblk.push(cur);
                    going = quiet;
                }
            }
            Inst::Jump(_) => {
                going = quiet;
            }
            _ => {
            }
        }
        if going {
            if cur == 0 || preds.get(cur).len() != 1 {
                going = false;
            } else {
                into = cur;
                cur = preds.get(cur).get(0);
                if body.get(cur) != 0 {
                    going = false;
                }
            }
        }
        steps = steps + 1;
    }
    if conds.len() == 0 {
        return res;
    }
    // the bound's slot, when the loop reloads it: never stored in the loop
    var pn: i64 = -1;
    match peir_inst_of(f, right) {
        Inst::Load(rp, _) => {
            if facts.plain.get(rp) != 0 {
                pn = rp;
                var si: i64 = 0;
                while si < facts.st_ptr.len() {
                    if facts.st_ptr.get(si) == rp && body.get(facts.st_block.get(si)) != 0 {
                        pn = -1;
                    }
                    si = si + 1;
                }
                if pn < 0 {
                    return res;
                }
            } else {
                return res;
            }
        }
        _ => {
        }
    }
    var cs: Vec<i64> = Vec::new();
    var csb: Vec<i64> = Vec::new();
    var qi: i64 = 0;
    while qi < conds.len() {
        peir_conjuncts(f, conds.get(qi), &mut cs, 0);
        while csb.len() < cs.len() {
            csb.push(cblk.get(qi));
        }
        qi = qi + 1;
    }
    var ci: i64 = 0;
    while ci < cs.len() {
        var gids: Vec<i64> = f.blocks.get(csb.get(ci)).instructions;
        match peir_inst_of(f, cs.get(ci)) {
            Inst::BinOp(op, a, b, _) => {
                var lo_side: i64 = -1;
                var k_side: i64 = -1;
                var n_side: i64 = -1;
                var l_side: i64 = -1;
                match op {
                    BinOp::GtEq => {
                        lo_side = a;
                        k_side = b;
                        l_side = a;
                        n_side = b;
                    }
                    BinOp::LtEq => {
                        lo_side = b;
                        k_side = a;
                        n_side = a;
                        l_side = b;
                    }
                    _ => {
                    }
                }
                // i >= k, k a constant >= 0
                if lo_side >= 0 && peir_guard_same(f, gids, lo_side, -2, slot) {
                    match peir_inst_of(f, k_side) {
                        Inst::ConstInt(kv, _) => {
                            if kv >= 0 {
                                res.set(0, 1);
                            }
                        }
                        _ => {
                        }
                    }
                }
                // right <= L
                if l_side >= 0 && peir_is_len(f, l_side) && peir_guard_same(f, gids, n_side, right, pn) {
                    res.set(1, l_side);
                }
            }
            _ => {
            }
        }
        ci = ci + 1;
    }
    return res;
}

// --- CP6: guard-fact propagation ---------------------------------------------
// `if i < v.len() { ... v.get(i) ... }` — the bounds check under the edge
// that keeps the comparison true is redundant. Four compare forms carry
// the fact (with `idx` the loaded slot and `len` the bound):
//   Lt(idx,len)  -> then edge,   GtEq(idx,len) -> else edge,
//   Gt(len,idx)  -> then edge,   LtEq(len,idx) -> else edge.
// `len` may be a Vec_len call or a plain local stored once to it in a
// block dominating the guard, provided nothing may shorten the Vec on the
// way (peir_guard_len_fresh). Marks Vec_get/Vec_set in blocks dominated
// by the guarded edge when the index loads the same slot (no store to it
// inside the region), the Vec is the same local, and the index is already
// known >= 0 (bit 2, set by peir_range_ops).

/// Dominator sets over the CFG: dom[x].get(g) == 1 means g dominates x.
fn peir_dominators(n: i64, preds: Vec<Vec<i64>>) -> Vec<Vec<i64>> {
    var dom: Vec<Vec<i64>> = Vec::new();
    var b: i64 = 0;
    while b < n {
        dom.push(peir_zeros(n));
        b = b + 1;
    }
    if n == 0 {
        return dom;
    }
    dom.get(0).set(0, 1);
    var changed: bool = true;
    var rounds: i64 = 0;
    while changed && rounds <= n {
        changed = false;
        b = 1;
        while b < n {
            var ps: Vec<i64> = preds.get(b);
            var nb: Vec<i64> = peir_zeros(n);
            var i: i64 = 0;
            if ps.len() == 0 {
                nb.set(b, 1);
            } else {
                i = 0;
                while i < n {
                    nb.set(i, dom.get(ps.get(0)).get(i));
                    i = i + 1;
                }
                var pi: i64 = 1;
                while pi < ps.len() {
                    i = 0;
                    while i < n {
                        if dom.get(ps.get(pi)).get(i) == 0 {
                            nb.set(i, 0);
                        }
                        i = i + 1;
                    }
                    pi = pi + 1;
                }
                nb.set(b, 1);
            }
            i = 0;
            while i < n {
                if nb.get(i) != dom.get(b).get(i) {
                    dom.get(b).set(i, nb.get(i));
                    changed = true;
                }
                i = i + 1;
            }
            b = b + 1;
        }
        rounds = rounds + 1;
    }
    return dom;
}

/// Between the single store of a Vec_len and the guard block `g`, nothing
/// may shorten the Vec or re-store the Vec's own slot `pv` (the measured
/// identity must still be the slot's current Vec). Same scan as the
/// counted-loop's len freshness: the rest of the store's block, then
/// every block on a path from it to `g` that does not pass through `g`'s
/// dominated region.
fn peir_guard_len_fresh(f: &IrFunction, succs: Vec<Vec<i64>>, preds: Vec<Vec<i64>>, dom: Vec<Vec<i64>>, g: i64, facts: PeirLoopFacts, store_i: i64, pv: i64, n: i64) -> bool {
    var sb: i64 = facts.st_block.get(store_i);
    var sids: Vec<i64> = f.blocks.get(sb).instructions;
    var k: i64 = facts.st_at.get(store_i) + 1;
    while k < sids.len() {
        var sid: i64 = sids.get(k);
        if peir_may_shorten(f, sid) {
            return false;
        }
        match peir_inst_of(f, sid) {
            Inst::Store(p, _, _) => {
                if p == pv {
                    return false;
                }
            }
            _ => {
            }
        }
        k = k + 1;
    }
    var excl: Vec<i64> = peir_zeros(n);
    var x: i64 = 0;
    while x < n {
        if x == g || dom.get(x).get(g) == 1 {
            excl.set(x, 1);
        }
        x = x + 1;
    }
    var fwd: Vec<i64> = peir_reach(succs, succs.get(sb), excl, n);
    var into: Vec<i64> = peir_reach(preds, preds.get(g), excl, n);
    var bb: i64 = 0;
    while bb < n {
        if bb != sb && fwd.get(bb) == 1 && into.get(bb) == 1 {
            var ids: Vec<i64> = f.blocks.get(bb).instructions;
            var i: i64 = 0;
            while i < ids.len() {
                var id: i64 = ids.get(i);
                if peir_may_shorten(f, id) {
                    return false;
                }
                match peir_inst_of(f, id) {
                    Inst::Store(p, _, _) => {
                        if p == pv {
                            return false;
                        }
                    }
                    _ => {
                    }
                }
                i = i + 1;
            }
        }
        bb = bb + 1;
    }
    return true;
}

pub fn peir_guard_ops(f: &IrFunction, n: i64, succs: Vec<Vec<i64>>, preds: Vec<Vec<i64>>, index: Vec<i64>, facts: PeirLoopFacts, out: &mut Vec<i64>) {
    if n == 0 {
        return;
    }
    var dom: Vec<Vec<i64>> = peir_dominators(n, preds);
    var b: i64 = 0;
    while b < n {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var cond: i64 = -1;
        var t_edge: i64 = -1;
        var e_edge: i64 = -1;
        if ids.len() > 0 {
            match peir_inst_of(f, ids.get(ids.len() - 1)) {
                Inst::Branch(c, t, e) => {
                    cond = c;
                    if t < index.len() {
                        t_edge = index.get(t);
                    }
                    if e < index.len() {
                        e_edge = index.get(e);
                    }
                }
                _ => {
                }
            }
        }
        var idx_val: i64 = -1;
        // the compared index value (param or load)
        var slot: i64 = -1;
        // its slot when it is a Load, else -1 (param)
        var len_call: i64 = -1;
        var edge: i64 = -1;
        if cond >= 0 && t_edge >= 0 && e_edge >= 0 {
            var i_l: i64 = -1;
            var i_r: i64 = -1;
            match peir_inst_of(f, cond) {
                Inst::BinOp(op, l, r, _) => {
                    match op {
                        BinOp::Lt => {
                            i_l = l;
                            i_r = r;
                            edge = t_edge;
                        }
                        BinOp::GtEq => {
                            i_l = l;
                            i_r = r;
                            edge = e_edge;
                        }
                        BinOp::Gt => {
                            i_l = r;
                            i_r = l;
                            edge = t_edge;
                        }
                        BinOp::LtEq => {
                            i_l = r;
                            i_r = l;
                            edge = e_edge;
                        }
                        _ => {
                        }
                    }
                }
                _ => {
                }
            }
            if edge >= 0 && i_l >= 0 {
                // The index is either a bare value (param — nothing can
                // re-store it) or a Load of a plain i64 slot (stores to it
                // inside the region are checked below).
                idx_val = i_l;
                match peir_inst_of(f, i_l) {
                    Inst::Load(p, ty) => {
                        var ok_slot: bool = false;
                        match ty {
                            IrType::I64 => {
                                if facts.plain.get(p) != 0 {
                                    ok_slot = true;
                                }
                            }
                            _ => {
                            }
                        }
                        if ok_slot {
                            slot = p;
                        } else {
                            idx_val = -1;
                        }
                    }
                    _ => {
                    }
                }
            }
            if idx_val >= 0 {
                if peir_is_len(f, i_r) {
                    len_call = i_r;
                } else {
                    match peir_inst_of(f, i_r) {
                        Inst::Load(p2, _) => {
                            if facts.plain.get(p2) != 0 {
                                var cnt: i64 = 0;
                                var si: i64 = 0;
                                while si < facts.st_ptr.len() {
                                    if facts.st_ptr.get(si) == p2 {
                                        cnt = cnt + 1;
                                        var sv: i64 = facts.st_value.get(si);
                                        var sb: i64 = facts.st_block.get(si);
                                        if cnt == 1 && peir_is_len(f, sv) && (sb == b || dom.get(b).get(sb) == 1) {
                                            var pv: i64 = -1;
                                            match peir_inst_of(f, sv) {
                                                Inst::Call(_, a2, _, _) => {
                                                    if a2.len() > 0 {
                                                        match peir_inst_of(f, a2.get(a2.len() - 1)) {
                                                            Inst::Load(p3, _) => {
                                                                pv = p3;
                                                            }
                                                            _ => {
                                                            }
                                                        }
                                                    }
                                                }
                                                _ => {
                                                }
                                            }
                                            if peir_guard_len_fresh(f, succs, preds, dom, b, facts, si, pv, n) {
                                                len_call = sv;
                                            }
                                        }
                                    }
                                    si = si + 1;
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
            }
        }
        var vec_val: i64 = -1;
        if len_call >= 0 {
            match peir_inst_of(f, len_call) {
                Inst::Call(_, args, _, _) => {
                    if args.len() > 0 {
                        vec_val = args.get(args.len() - 1);
                    }
                }
                _ => {
                }
            }
        }
        if edge >= 0 && idx_val >= 0 && len_call >= 0 && vec_val >= 0 {
            // Region D = blocks dominated by the guarded edge. Bail on a
            // store to the index slot or a possible Vec shrink inside D.
            var dvec: Vec<i64> = peir_zeros(n);
            var bad: bool = false;
            var bb: i64 = 0;
            while bb < n {
                if dom.get(bb).get(edge) == 1 {
                    dvec.set(bb, 1);
                    var ids2: Vec<i64> = f.blocks.get(bb).instructions;
                    var k: i64 = 0;
                    while k < ids2.len() {
                        if peir_may_shorten(f, ids2.get(k)) {
                            bad = true;
                        }
                        k = k + 1;
                    }
                }
                bb = bb + 1;
            }
            if slot >= 0 {
                var si: i64 = 0;
                while si < facts.st_ptr.len() {
                    if facts.st_ptr.get(si) == slot && dvec.get(facts.st_block.get(si)) == 1 {
                        bad = true;
                    }
                    si = si + 1;
                }
            }
            if !bad {
                bb = 0;
                while bb < n {
                    if dvec.get(bb) == 1 {
                        var ids3: Vec<i64> = f.blocks.get(bb).instructions;
                        var k: i64 = 0;
                        while k < ids3.len() {
                            var id: i64 = ids3.get(k);
                            match peir_inst_of(f, id) {
                                Inst::Call(name, args, _, _) => {
                                    var at: i64 = -1;
                                    if (name == "Vec_get" || name == "p_vec_get") && args.len() >= 2 {
                                        at = args.len() - 2;
                                    }
                                    if (name == "Vec_set" || name == "p_vec_set") && args.len() >= 3 {
                                        at = args.len() - 3;
                                    }
                                    var idx_ok: bool = args.get(at + 1) == idx_val;
                                    if !idx_ok && slot >= 0 {
                                        idx_ok = peir_load_of(f, args.get(at + 1), slot);
                                    }
                                    if at >= 0 && idx_ok && peir_same_vec(f, args.get(at), vec_val, dvec, facts) && (out.get(args.get(at + 1)) & 2) != 0 {
                                        out.set(id, out.get(id) | 1);
                                    }
                                }
                                _ => {
                                }
                            }
                            k = k + 1;
                        }
                    }
                    bb = bb + 1;
                }
            }
        }
        b = b + 1;
    }
}

/// Generate integer binary operation.
/// Append every ValueId `inst` reads to `out` (used by the slot-reuse
/// analysis in gen_function — pe-roadmap items 84-85).
pub fn peir_inst_operands(inst: Inst, out: &mut Vec<i64>) -> void {
    match inst {
        Inst::BinOp(_, l, r, _) => {
            out.push(l);
            out.push(r);
        }
        Inst::UnaryOp(_, v, _) => {
            out.push(v);
        }
        Inst::Load(p, _) => {
            out.push(p);
        }
        Inst::Store(p, v, _) => {
            out.push(p);
            out.push(v);
        }
        Inst::StructCopy(d, s, _) => {
            out.push(d);
            out.push(s);
        }
        Inst::GetFieldPtr(p, _, _) => {
            out.push(p);
        }
        Inst::GetElemPtr(p, i, _) => {
            out.push(p);
            out.push(i);
        }
        Inst::Branch(c, _, _) => {
            out.push(c);
        }
        Inst::Switch(sv, _, _, _) => {
            out.push(sv);
        }
        Inst::Return(rv) => {
            match rv {
                OptValueId::Some(v) => {
                    out.push(v);
                }
                OptValueId::None => {
                }
            }
        }
        Inst::Call(_, args, _, _) => {
            var i: i64 = 0;
            while i < args.len() {
                out.push(args.get(i));
                i = i + 1;
            }
        }
        Inst::CallPtr(fp, args, _, _, _) => {
            out.push(fp);
            var j: i64 = 0;
            while j < args.len() {
                out.push(args.get(j));
                j = j + 1;
            }
        }
        Inst::DynCall(_, _, args, _, _) => {
            var k: i64 = 0;
            while k < args.len() {
                out.push(args.get(k));
                k = k + 1;
            }
        }
        Inst::MakeDyn(v, _, _) => {
            out.push(v);
        }
        Inst::BitCast(v, _, _) => {
            out.push(v);
        }
        Inst::IntExtend(v, _, _) => {
            out.push(v);
        }
        Inst::IntTrunc(v, _, _) => {
            out.push(v);
        }
        Inst::IntToFloat(v, _, _) => {
            out.push(v);
        }
        Inst::FloatToInt(v, _, _) => {
            out.push(v);
        }
        Inst::TryUnwrap(v, _, _, _) => {
            out.push(v);
        }
        Inst::Print(v, _) => {
            out.push(v);
        }
        Inst::Asm(_, inputs, _, _) => {
            var m: i64 = 0;
            while m < inputs.len() {
                // a clobber("reg") travels as an input with id -1: no value
                // (2g.53: indexing by it ran out of bounds)
                var aid: i64 = inputs.get(m).id;
                if aid >= 0 {
                    out.push(aid);
                }
                m = m + 1;
            }
        }
        Inst::PersistLoad(_, d, _) => {
            out.push(d);
        }
        Inst::PersistSave(_, v) => {
            out.push(v);
        }
        Inst::Backward(l) => {
            out.push(l);
        }
        _ => {
        }
    }
}

// ===========================================================================
// Integer ranges (competitive OP24)
//
// Each i64 value gets an interval [lo, hi]; an open side is the i64
// extreme, so i64::MIN as lo says nothing. Intervals come from constants,
// `% c`, `/ c`, `& c`, `>> c`, comparisons, narrow types, lengths, the
// locals' stores (a local only stored values >= 0, or itself plus a value
// >= 0, is >= 0) and the branch that leads into a block (`i < n` taken:
// i <= n - 1 there). An add, sub or mul whose result interval stays inside
// i64 cannot overflow: it is marked unchecked (bit 1 of the result). A
// value known >= 0 has bit 2 (x % c and x / c of one need no sign fix).
// Every interval only holds facts that are true on every path, so dropping
// a check never changes what a program does.
// ===========================================================================

const PEIR_RANGES: bool = true;
const PEIR_I64_MIN: i64 = -9223372036854775807 - 1;
const PEIR_I64_MAX: i64 = 9223372036854775807;
/// a + b, or false when it leaves i64
fn peir_radd(a: i64, b: i64, out: &mut Vec<i64>) -> bool {
    if b > 0 && a > PEIR_I64_MAX - b {
        return false;
    }
    if b < 0 && a < PEIR_I64_MIN - b {
        return false;
    }
    out.push(a + b);
    return true;
}

/// a - b, or false when it leaves i64
fn peir_rsub(a: i64, b: i64, out: &mut Vec<i64>) -> bool {
    if b < 0 && a > PEIR_I64_MAX + b {
        return false;
    }
    if b > 0 && a < PEIR_I64_MIN + b {
        return false;
    }
    out.push(a - b);
    return true;
}

/// OP24: does a * b stay within i64 (|a * b| <= i64 max; i64 min as an
/// operand only times 0)? Never overflows itself.
fn peir_mul_fits(a: i64, b: i64) -> bool {
    if a == 0 || b == 0 {
        return true;
    }
    if a == PEIR_I64_MIN || b == PEIR_I64_MIN {
        return false;
    }
    var ua: i64 = a;
    if ua < 0 {
        ua = 0 - ua;
    }
    var ub: i64 = b;
    if ub < 0 {
        ub = 0 - ub;
    }
    return ua <= PEIR_I64_MAX / ub;
}

/// The range of a narrow integer type; false for any other.
fn peir_type_range(ty: IrType, out: &mut Vec<i64>) -> bool {
    out.clear();
    match ty {
        IrType::Bool => {
            out.push(0);
            out.push(1);
        }
        IrType::U8 => {
            out.push(0);
            out.push(255);
        }
        IrType::I8 => {
            out.push(-128);
            out.push(127);
        }
        IrType::U16 => {
            out.push(0);
            out.push(65535);
        }
        IrType::I16 => {
            out.push(-32768);
            out.push(32767);
        }
        IrType::U32 => {
            out.push(0);
            out.push(4294967295);
        }
        IrType::I32 => {
            out.push(-2147483648);
            out.push(2147483647);
        }
        _ => {
            return false;
        }
    }
    return true;
}

/// Ranges of one function: per value lo and hi, per local its bounds, and
/// the refinement in force in the block being scanned.
pub struct PeirRanges {
    pub lo: Vec<i64>,
    pub hi: Vec<i64>,
    pub loc_lo: Vec<i64>,
    pub loc_hi: Vec<i64>,
    pub plain: Vec<i64>,
    // the current block's refinement: one value (or local) and its interval
    pub ref_v: i64,
    pub ref_loc: i64,
    pub ref_lo: i64,
    pub ref_hi: i64,
    pub ref_live: bool,
    // Vec locals that only ever hold a Vec_filled_typed result (or null)
    // and are never shortened: 1; their least length (-1: unknown)
    pub vstable: Vec<i64>,
    pub vlen: Vec<i64>,
    // OP24: the facts on values in force in the block being scanned (from
    // the blocks that dominate it, and from calls earlier in it): value,
    // bounds; empty outside a scan
    pub cf_v: Vec<i64>,
    pub cf_lo: Vec<i64>,
    pub cf_hi: Vec<i64>,
    // LF8 (Nov 17): the range set. Further facts on plain locals in force
    // at this point of the block being scanned, besides ref_*: local,
    // bounds (at most PEIR_SF_MAX). A block's facts at its end (ref_*,
    // these, cf_*) go to the blocks it leads to, so a branch's fact no
    // longer replaces the ones before it, and joins meet every fact all
    // their ways in share. sf_on: FID_IROPT_OFF=rangeset (or rangejoin)
    // turns the set off
    pub sf_on: bool,
    pub sf_loc: Vec<i64>,
    pub sf_lo: Vec<i64>,
    pub sf_hi: Vec<i64>,
    // LF8: per value, the block index computing it (-1: none, a
    // parameter); filled when sf_on
    pub def_b: Vec<i64>,
    // LF8: no block is entered other than by Jump, Branch or Switch (no
    // TryUnwrap), so a block other than the entry with no way in is dead
    pub plain_cfg: bool,
}

fn peir_rng_get_lo(r: &PeirRanges, v: i64) -> i64 {
    if v < 0 || v >= r.lo.len() {
        return PEIR_I64_MIN;
    }
    var lo: i64 = r.lo.get(v);
    if v == r.ref_v && r.ref_v >= 0 {
        if r.ref_lo > lo {
            lo = r.ref_lo;
        }
    }
    var i: i64 = 0;
    while i < r.cf_v.len() {
        if r.cf_v.get(i) == v && r.cf_lo.get(i) > lo {
            lo = r.cf_lo.get(i);
        }
        i = i + 1;
    }
    return lo;
}

fn peir_rng_get_hi(r: &PeirRanges, v: i64) -> i64 {
    if v < 0 || v >= r.hi.len() {
        return PEIR_I64_MAX;
    }
    var hi: i64 = r.hi.get(v);
    if v == r.ref_v && r.ref_v >= 0 {
        if r.ref_hi < hi {
            hi = r.ref_hi;
        }
    }
    var i: i64 = 0;
    while i < r.cf_v.len() {
        if r.cf_v.get(i) == v && r.cf_hi.get(i) < hi {
            hi = r.cf_hi.get(i);
        }
        i = i + 1;
    }
    return hi;
}

fn peir_rng_put(r: &mut PeirRanges, id: i64, l: i64, h: i64) {
    if id < 0 || id >= r.lo.len() || l > h {
        return;
    }
    r.lo.set(id, l);
    r.hi.set(id, h);
}

/// Is `v` an i64 value (a comparison of two may refine one)?
fn peir_rng_i64(f: &IrFunction, v: i64) -> bool {
    match IrFunction_get_meta(f, v) {
        OptValueMeta::Some(m) => {
            return ir_type_eq(m.ty, IrType::I64);
        }
        OptValueMeta::None => {
            return false;
        }
    }
}

// ---------------------------------------------------------------------------
// LF8 (Nov 17): the range set. One fact per block (ref_*) lost what held
// before a branch that gave a fact of its own, and a join kept a fact only
// when every way in carried that same single one. Now each block also
// carries a small set: facts on plain locals (sf_*: from its ways in, a
// loop header's assumptions, and a store `p = v`, which gives p v's
// interval until the next store to p) and on values (cf_*). What holds at
// a block's end (ref_*, sf_*, cf_*: at most PEIR_XS_MAX entries) is kept
// per block (xs, flat: kind 0 local / 1 value, id, lo, hi); a block with
// one way in starts with all of its predecessor's, and a join with every
// fact all of its ways in (each with its branch's own fact) share, as the
// hull of their intervals. Facts on values a block starts with are also
// recorded for the blocks it dominates (peir_dom_vfact). Each fact is
// true on the edge it comes from, so the scan stays sound in any block
// order: a predecessor not scanned yet (a back edge) gives nothing, and a
// join keeps nothing then. FID_IROPT_OFF=rangeset turns it off.
// ---------------------------------------------------------------------------

const PEIR_SF_MAX: i64 = 8;
const PEIR_XS_MAX: i64 = 24;

/// LF8: is value v computed in block b (a fact from a way in would be about
/// its previous value)? Unsure (no table): yes.
fn peir_defined_in(r: &PeirRanges, b: i64, v: i64) -> bool {
    if v < 0 || v >= r.def_b.len() {
        return true;
    }
    return r.def_b.get(v) == b;
}

/// LF8: r.def_b, the block index computing each value.
fn peir_def_blocks(f: &IrFunction, r: &mut PeirRanges, nvals: i64) {
    var d: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nvals {
        d.push(0 - 1);
        i = i + 1;
    }
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < nvals {
                d.set(id, b);
            }
            match peir_inst_of(f, id) {
                Inst::TryUnwrap(_, _, _, _) => {
                    r.plain_cfg = false;
                }
                _ => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    r.def_b = d;
}

/// LF8: plain local p in [lo, hi] from here on: intersected with the set's
/// fact on p, or added (dropped when the set is full).
fn peir_sf_add(r: &mut PeirRanges, p: i64, lo: i64, hi: i64) {
    if !r.sf_on || p < 0 || lo > hi {
        return;
    }
    var i: i64 = 0;
    while i < r.sf_loc.len() {
        if r.sf_loc.get(i) == p {
            if lo > r.sf_lo.get(i) {
                r.sf_lo.set(i, lo);
            }
            if hi < r.sf_hi.get(i) {
                r.sf_hi.set(i, hi);
            }
            return;
        }
        i = i + 1;
    }
    if r.sf_loc.len() < PEIR_SF_MAX {
        r.sf_loc.push(p);
        r.sf_lo.push(lo);
        r.sf_hi.push(hi);
    }
}

/// LF8: a store to p ends the set's fact on it.
fn peir_sf_kill(r: &mut PeirRanges, p: i64) {
    var i: i64 = 0;
    while i < r.sf_loc.len() {
        if r.sf_loc.get(i) == p {
            var last: i64 = r.sf_loc.len() - 1;
            r.sf_loc.set(i, r.sf_loc.get(last));
            r.sf_lo.set(i, r.sf_lo.get(last));
            r.sf_hi.set(i, r.sf_hi.get(last));
            r.sf_loc.pop();
            r.sf_lo.pop();
            r.sf_hi.pop();
        } else {
            i = i + 1;
        }
    }
}

/// LF8: v in [lo, hi] joins the facts on values in force (intersected with
/// the first one on v): the entry's position when it is new or narrower,
/// else -1.
fn peir_cf_add(r: &mut PeirRanges, v: i64, lo: i64, hi: i64) -> i64 {
    var i: i64 = 0;
    while i < r.cf_v.len() {
        if r.cf_v.get(i) == v {
            var ch: bool = false;
            if lo > r.cf_lo.get(i) {
                r.cf_lo.set(i, lo);
                ch = true;
            }
            if hi < r.cf_hi.get(i) {
                r.cf_hi.set(i, hi);
                ch = true;
            }
            if ch {
                return i;
            }
            return 0 - 1;
        }
        i = i + 1;
    }
    if r.cf_v.len() >= 40 {
        return 0 - 1;
    }
    r.cf_v.push(v);
    r.cf_lo.push(lo);
    r.cf_hi.push(hi);
    return r.cf_v.len() - 1;
}

/// LF8: what holds at the end of the block just scanned, appended to xs as
/// (kind, id, lo, hi) entries (at most PEIR_XS_MAX); their number.
fn peir_xs_save(r: &PeirRanges, xs: &mut Vec<i64>) -> i64 {
    var c: i64 = 0;
    if r.ref_lo <= r.ref_hi {
        if r.ref_v >= 0 {
            xs.push(1);
            xs.push(r.ref_v);
            xs.push(r.ref_lo);
            xs.push(r.ref_hi);
            c = c + 1;
        }
        if r.ref_loc >= 0 && r.ref_live {
            xs.push(0);
            xs.push(r.ref_loc);
            xs.push(r.ref_lo);
            xs.push(r.ref_hi);
            c = c + 1;
        }
    }
    var i: i64 = 0;
    while i < r.sf_loc.len() && c < PEIR_XS_MAX {
        if r.sf_lo.get(i) <= r.sf_hi.get(i) {
            xs.push(0);
            xs.push(r.sf_loc.get(i));
            xs.push(r.sf_lo.get(i));
            xs.push(r.sf_hi.get(i));
            c = c + 1;
        }
        i = i + 1;
    }
    // the newest facts on values first (a call's, the ways in's)
    i = r.cf_v.len() - 1;
    while i >= 0 && c < PEIR_XS_MAX {
        if r.cf_lo.get(i) <= r.cf_hi.get(i) {
            xs.push(1);
            xs.push(r.cf_v.get(i));
            xs.push(r.cf_lo.get(i));
            xs.push(r.cf_hi.get(i));
            c = c + 1;
        }
        i = i - 1;
    }
    return c;
}

/// LF8: the interval entries [s, e) of the flat set `es` give (kind, id),
/// in out [lo, hi] (every entry on it intersected); false when none is
/// about it.
fn peir_es_get(es: &Vec<i64>, s: i64, e: i64, kind: i64, id: i64, out: &mut Vec<i64>) -> bool {
    out.clear();
    var lo: i64 = PEIR_I64_MIN;
    var hi: i64 = PEIR_I64_MAX;
    var any: bool = false;
    var i: i64 = s;
    while i + 3 < e && i + 3 < es.len() {
        if es.get(i) == kind && es.get(i + 1) == id {
            if es.get(i + 2) > lo {
                lo = es.get(i + 2);
            }
            if es.get(i + 3) < hi {
                hi = es.get(i + 3);
            }
            any = true;
        }
        i = i + 4;
    }
    out.push(lo);
    out.push(hi);
    return any;
}

/// LF8: the facts on the edge from block q into block b, appended to out:
/// what held at q's end (scanned already: x_done) and, with `branch`, the
/// fact q's branch gives on that edge (r.ref_* is overwritten then). False
/// when q was not scanned yet in this scan.
fn peir_sf_edge(f: &IrFunction, r: &mut PeirRanges, index: &Vec<i64>, q: i64, b: i64, branch: bool, xs: &Vec<i64>, x_s0: &Vec<i64>, x_sn: &Vec<i64>, x_done: &Vec<i64>, out: &mut Vec<i64>) -> bool {
    if q < 0 || q >= x_done.len() || q >= f.blocks.len() || x_done.get(q) == 0 {
        return false;
    }
    var s: i64 = x_s0.get(q);
    var e: i64 = s + 4 * x_sn.get(q);
    while s < e && s < xs.len() {
        out.push(xs.get(s));
        s = s + 1;
    }
    if !branch {
        return true;
    }
    var pids: Vec<i64> = f.blocks.get(q).instructions;
    if pids.len() == 0 {
        return true;
    }
    match peir_inst_of(f, pids.get(pids.len() - 1)) {
        Inst::Branch(cond, tb, eb) => {
            var taken: i64 = 0 - 1;
            if tb >= 0 && tb < index.len() && index.get(tb) == b {
                taken = 1;
            }
            if eb >= 0 && eb < index.len() && index.get(eb) == b {
                if taken == 1 {
                    taken = 0 - 1;
                } else {
                    taken = 0;
                }
            }
            if taken >= 0 {
                r.ref_v = 0 - 1;
                r.ref_loc = 0 - 1;
                r.ref_live = false;
                peir_range_refine(f, r, cond, taken == 1);
                if r.ref_lo <= r.ref_hi {
                    if r.ref_v >= 0 {
                        out.push(1);
                        out.push(r.ref_v);
                        out.push(r.ref_lo);
                        out.push(r.ref_hi);
                    } else if r.ref_loc >= 0 && r.ref_live {
                        out.push(0);
                        out.push(r.ref_loc);
                        out.push(r.ref_lo);
                        out.push(r.ref_hi);
                    }
                }
            }
        }
        _ => {
        }
    }
    return true;
}

/// LF8: one fact at the entry of block b into the set: a plain local's
/// into sf_*, a value's (not one b computes) into cf_* and, when new or
/// narrower, recorded for the blocks b dominates.
fn peir_sf_apply(f: &IrFunction, r: &mut PeirRanges, dom: &mut PeirDomFacts, b: i64, kind: i64, id: i64, lo: i64, hi: i64) {
    if id < 0 || lo > hi || (lo == PEIR_I64_MIN && hi == PEIR_I64_MAX) {
        return;
    }
    if kind == 0 {
        if id < r.plain.len() && r.plain.get(id) == 1 {
            peir_sf_add(r, id, lo, hi);
        }
        return;
    }
    if id >= r.lo.len() || peir_defined_in(r, b, id) {
        return;
    }
    var at: i64 = peir_cf_add(r, id, lo, hi);
    if at >= 0 {
        peir_dom_vfact(dom, b, id, r.cf_lo.get(at), r.cf_hi.get(at));
    }
}

/// LF8: block b, entered only from pb, starts with every fact that held at
/// pb's end (the branch's own fact is r.ref_*, from peir_edge_fact).
fn peir_sf_inherit(f: &IrFunction, r: &mut PeirRanges, dom: &mut PeirDomFacts, index: &Vec<i64>, pb: i64, b: i64, xs: &Vec<i64>, x_s0: &Vec<i64>, x_sn: &Vec<i64>, x_done: &Vec<i64>) {
    var es: Vec<i64> = Vec::new();
    if !peir_sf_edge(f, r, index, pb, b, false, xs, x_s0, x_sn, x_done, &mut es) {
        return;
    }
    var i: i64 = 0;
    while i + 3 < es.len() {
        peir_sf_apply(f, r, dom, b, es.get(i), es.get(i + 1), es.get(i + 2), es.get(i + 3));
        i = i + 4;
    }
}

/// LF8 (Nov 21): is slot `slot` stored, or value `vid` defined, anywhere on
/// the paths from block q back to block b (q a not-yet-scanned predecessor
/// of b, the two blocks and everything between them the loop's body)? A
/// budget bounds the walk; running out answers "yes" (a fact is then
/// dropped, never kept unsoundly).
/// OP24 (Nov 21 evening): FID_RANGE_WHY=1 prints the range analysis's
/// square-rule and filled-fact decisions, a diagnostic never a gate.
fn peir_range_why(what: str) {
    var v: str = p_getenv("FID_RANGE_WHY");
    if (v as i64) != 0 && str_len(v) > 0 {
        p_eprint_str("range: " + what + "
");
    }
}

fn peir_join_stored(f: &IrFunction, preds: &Vec<Vec<i64>>, b: i64, q: i64, slot: i64, vid: i64, def_b: &Vec<i64>, st_ptr: &Vec<i64>, st_blk: &Vec<i64>) -> bool {
    var nb: i64 = f.blocks.len();
    var seen: Vec<i64> = peir_zeros(nb);
    var work: Vec<i64> = Vec::new();
    work.push(q);
    var budget: i64 = 1024;
    while work.len() > 0 && budget > 0 {
        var w: i64 = work.pop();
        if w < 0 || w >= nb || w == b || seen.get(w) == 1 {
            continue;
        }
        seen.set(w, 1);
        budget = budget - 1;
        if slot >= 0 {
            var si: i64 = 0;
            while si < st_ptr.len() {
                if st_blk.get(si) == w && st_ptr.get(si) == slot {
                    return true;
                }
                si = si + 1;
            }
        }
        if vid >= 0 && vid < def_b.len() && def_b.get(vid) == w {
            return true;
        }
        if w < preds.len() {
            var pi: i64 = 0;
            var pp: Vec<i64> = preds.get(w);
            while pi < pp.len() {
                work.push(pp.get(pi));
                pi = pi + 1;
            }
        }
    }
    if budget <= 0 {
        return true;
    }
    return false;
}

/// LF8: join block b (ways in `ps`) starts with each fact every way in
/// carries (what held at the predecessor's end, or its branch's fact on
/// that edge), as the hull of their intervals. Every predecessor must have
/// been scanned already; one that has no way in itself (a dead block left
/// after a `return`) never runs and is left out. r.ref_* (the join's own
/// fact) is kept.
///
/// Nov 21 (OP24): a predecessor not scanned yet is a back edge (it is laid
/// out after b). It no longer empties the join: a fact every scanned way
/// in carries is kept when the back edge cannot break it — a fact on a
/// value the loop body never re-defines (a value's fact is a property of
/// the value itself), or on a plain local the body never stores (its back
/// edge carries the same value). So the sieve's inner loop keeps p's fact
/// from the outer loop at its header, and `m = m + p` loses its overflow
/// check. The store/definition walk is peir_join_stored; a fact it cannot
/// prove is dropped, as before.
fn peir_join_set(f: &IrFunction, r: &mut PeirRanges, dom: &mut PeirDomFacts, index: &Vec<i64>, preds: &Vec<Vec<i64>>, ps: Vec<i64>, b: i64, xs: &Vec<i64>, x_s0: &Vec<i64>, x_sn: &Vec<i64>, x_done: &Vec<i64>, st_ptr: &Vec<i64>, st_blk: &Vec<i64>) {
    if ps.len() < 2 {
        return;
    }
    var keep_v: i64 = r.ref_v;
    var keep_loc: i64 = r.ref_loc;
    var keep_lo: i64 = r.ref_lo;
    var keep_hi: i64 = r.ref_hi;
    var keep_live: bool = r.ref_live;
    var all: Vec<i64> = Vec::new();
    var st: Vec<i64> = Vec::new();
    var en: Vec<i64> = Vec::new();
    var backs: Vec<i64> = Vec::new();
    var q: i64 = 0;
    while q < ps.len() {
        var qb: i64 = ps.get(q);
        var dead: bool = r.plain_cfg && qb > 0 && qb < preds.len() && preds.get(qb).len() == 0;
        if !dead {
            if qb >= 0 && qb < x_done.len() && x_done.get(qb) != 0 {
                st.push(all.len());
                peir_sf_edge(f, r, index, qb, b, true, xs, x_s0, x_sn, x_done, &mut all);
                en.push(all.len());
            } else if qb >= 0 {
                // not scanned yet: a back edge, judged per fact below
                backs.push(qb);
            }
        }
        q = q + 1;
    }
    r.ref_v = keep_v;
    r.ref_loc = keep_loc;
    r.ref_lo = keep_lo;
    r.ref_hi = keep_hi;
    r.ref_live = keep_live;
    if st.len() < 1 {
        return;
    }
    var t: Vec<i64> = Vec::new();
    var i: i64 = st.get(0);
    while i + 3 < en.get(0) {
        var kind: i64 = all.get(i);
        var id: i64 = all.get(i + 1);
        // each (kind, id) once: at its first entry in the first edge's set
        var first: bool = true;
        var j: i64 = st.get(0);
        while j < i && first {
            if all.get(j) == kind && all.get(j + 1) == id {
                first = false;
            }
            j = j + 4;
        }
        if first {
            var lo: i64 = PEIR_I64_MAX;
            var hi: i64 = PEIR_I64_MIN;
            var every: bool = true;
            var q2: i64 = 0;
            while q2 < st.len() && every {
                if peir_es_get(&all, st.get(q2), en.get(q2), kind, id, &mut t) {
                    if t.get(0) < lo {
                        lo = t.get(0);
                    }
                    if t.get(1) > hi {
                        hi = t.get(1);
                    }
                } else {
                    every = false;
                }
                q2 = q2 + 1;
            }
            if every && lo <= hi {
                var safe: bool = true;
                var bi: i64 = 0;
                while bi < backs.len() && safe {
                    var slot: i64 = 0 - 1;
                    var vid: i64 = 0 - 1;
                    if kind == 0 {
                        slot = id;
                    } else {
                        vid = id;
                    }
                    if peir_join_stored(f, preds, b, backs.get(bi), slot, vid, &r.def_b, st_ptr, st_blk) {
                        safe = false;
                    }
                    bi = bi + 1;
                }
                if safe {
                    peir_sf_apply(f, r, dom, b, kind, id, lo, hi);
                }
            }
        }
        i = i + 4;
    }
}

/// LF8/LF9: the fact on the edge from block `pb` into block `b` (block
/// indexes), left in r.ref_*: the branch's own fact when `pb` ends in a
/// branch to `b` that gives one; otherwise, when `inherit` (or `pb` ends in
/// a jump), what held at the end of `pb` if it was scanned already
/// (x_done): a fact true at the end of a block is true on every way out of
/// it. No fact: r.ref_v and r.ref_loc are -1.
fn peir_edge_fact(f: &IrFunction, r: &mut PeirRanges, index: &Vec<i64>, pb: i64, b: i64, inherit: bool, x_v: &Vec<i64>, x_loc: &Vec<i64>, x_lo: &Vec<i64>, x_hi: &Vec<i64>, x_live: &Vec<i64>, x_done: &Vec<i64>) {
    r.ref_v = -1;
    r.ref_loc = -1;
    r.ref_live = false;
    var pids: Vec<i64> = f.blocks.get(pb).instructions;
    if pids.len() == 0 {
        return;
    }
    var from_end: bool = false;
    match peir_inst_of(f, pids.get(pids.len() - 1)) {
        Inst::Jump(_) => {
            // entered from `pb` by a jump: its facts hold here too
            from_end = true;
        }
        Inst::Branch(cond, tb, eb) => {
            var taken: i64 = -1;
            if tb >= 0 && tb < index.len() && index.get(tb) == b {
                taken = 1;
            }
            if eb >= 0 && eb < index.len() && index.get(eb) == b {
                if taken == 1 {
                    taken = -1;
                } else {
                    taken = 0;
                }
            }
            if taken >= 0 {
                peir_range_refine(f, r, cond, taken == 1);
            }
            // a branch that says nothing about a range keeps what held
            // before it
            from_end = inherit && r.ref_v < 0 && !(r.ref_loc >= 0 && r.ref_live);
        }
        _ => {
        }
    }
    if from_end && x_done.get(pb) == 1 {
        r.ref_v = x_v.get(pb);
        r.ref_loc = x_loc.get(pb);
        r.ref_lo = x_lo.get(pb);
        r.ref_hi = x_hi.get(pb);
        r.ref_live = x_live.get(pb) == 1;
    }
}

/// LF8/LF9: the fact at the entry of join block `b` (several ways in):
/// when every edge into it (from blocks scanned already: never a back
/// edge not seen yet) has a fact about the same local or value, that fact
/// with the smallest interval holding all of them. A value defined in `b`
/// itself is left out (an edge's fact would be about its previous value).
/// Left in r.ref_*, as peir_edge_fact.
fn peir_join_fact(f: &IrFunction, r: &mut PeirRanges, index: &Vec<i64>, ps: Vec<i64>, b: i64, x_v: &Vec<i64>, x_loc: &Vec<i64>, x_lo: &Vec<i64>, x_hi: &Vec<i64>, x_live: &Vec<i64>, x_done: &Vec<i64>) {
    var ok: bool = ps.len() > 1;
    var m_v: i64 = -1;
    var m_loc: i64 = -1;
    var m_lo: i64 = PEIR_I64_MAX;
    var m_hi: i64 = PEIR_I64_MIN;
    var q: i64 = 0;
    while q < ps.len() && ok {
        var qb: i64 = ps.get(q);
        if qb < 0 || qb >= x_done.len() || x_done.get(qb) == 0 {
            ok = false;
        } else {
            peir_edge_fact(f, r, index, qb, b, true, x_v, x_loc, x_lo, x_hi, x_live, x_done);
            var e_loc: i64 = -1;
            if r.ref_loc >= 0 && r.ref_live {
                e_loc = r.ref_loc;
            }
            var e_v: i64 = r.ref_v;
            if (e_loc < 0 && e_v < 0) || (e_loc >= 0 && e_v >= 0) {
                ok = false;
            } else if q == 0 {
                m_v = e_v;
                m_loc = e_loc;
            } else if e_v != m_v || e_loc != m_loc {
                ok = false;
            }
            if ok {
                if r.ref_lo < m_lo {
                    m_lo = r.ref_lo;
                }
                if r.ref_hi > m_hi {
                    m_hi = r.ref_hi;
                }
            }
        }
        q = q + 1;
    }
    if ok && m_v >= 0 {
        var bids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < bids.len() {
            if bids.get(k) == m_v {
                ok = false;
            }
            k = k + 1;
        }
    }
    r.ref_v = -1;
    r.ref_loc = -1;
    r.ref_live = false;
    if ok && m_lo <= m_hi {
        r.ref_lo = m_lo;
        r.ref_hi = m_hi;
        if m_loc >= 0 {
            r.ref_loc = m_loc;
            r.ref_live = true;
        } else {
            r.ref_v = m_v;
        }
    }
}

/// One scan of the function in layout order; `final` marks the results.
/// With `joins` (LF8/LF9, FID_IROPT_OFF=rangejoin turns it off), a branch
/// that gives no fact keeps the one before it, and facts meet at joins.
fn peir_range_scan(f: &IrFunction, r: &mut PeirRanges, single_pred: &Vec<i64>, preds: &Vec<Vec<i64>>, joins: bool, index: &Vec<i64>, out: &mut Vec<i64>, final: bool, dom: &mut PeirDomFacts, lf: &PeirBackFacts) {
    var nv: i64 = r.lo.len();
    var tr: Vec<i64> = Vec::new();
    // OP24: entry facts are this scan's own
    var dn: Vec<i64> = Vec::new();
    peir_dom_reset(dom);
    var t1: Vec<i64> = Vec::new();
    var t2: Vec<i64> = Vec::new();
    // The refinement in force at the end of each block scanned so far: a
    // block whose only way in is a jump from one of them keeps it
    var nb: i64 = f.blocks.len();
    var x_v: Vec<i64> = Vec::new();
    var x_loc: Vec<i64> = Vec::new();
    var x_lo: Vec<i64> = Vec::new();
    var x_hi: Vec<i64> = Vec::new();
    var x_live: Vec<i64> = Vec::new();
    var x_done: Vec<i64> = peir_zeros(nb);
    var xb: i64 = 0;
    while xb < nb {
        x_v.push(-1);
        x_loc.push(-1);
        x_lo.push(0);
        x_hi.push(0);
        x_live.push(0);
        xb = xb + 1;
    }
    // LF8: every fact in force at the end of each block scanned so far
    // (the range set): flat (kind, id, lo, hi) entries, from x_s0 (words)
    // x_sn of them per block
    var xs: Vec<i64> = Vec::new();
    var x_s0: Vec<i64> = peir_zeros(nb);
    var x_sn: Vec<i64> = peir_zeros(nb);
    // LF8 (Nov 21): every store of the function (slot, block), for the
    // back-edge rule of peir_join_set (only with the range set on)
    var st_ptr: Vec<i64> = Vec::new();
    var st_blk: Vec<i64> = Vec::new();
    if r.sf_on {
        var sb: i64 = 0;
        while sb < f.blocks.len() {
            var sids: Vec<i64> = f.blocks.get(sb).instructions;
            var sk: i64 = 0;
            while sk < sids.len() {
                var spos: i64 = peir_inst_pos(f, sids.get(sk));
                if spos >= 0 {
                    match f.insts.get(spos).inst {
                        Inst::Store(sp, _, _) => {
                            st_ptr.push(sp);
                            st_blk.push(sb);
                        }
                        _ => {
                        }
                    }
                }
                sk = sk + 1;
            }
            sb = sb + 1;
        }
    }
    r.sf_loc.clear();
    r.sf_lo.clear();
    r.sf_hi.clear();
    var b: i64 = 0;
    while b < f.blocks.len() {
        // The branch into this block, when it is the only way in
        r.ref_v = -1;
        r.ref_loc = -1;
        r.ref_live = false;
        r.sf_loc.clear();
        r.sf_lo.clear();
        r.sf_hi.clear();
        // OP24: the facts on values of the blocks that dominate this one
        // (before the edge's fact, which may compare with such a value)
        peir_dom_enter(dom, r, b);
        var pb: i64 = single_pred.get(b);
        if pb >= 0 {
            // entered only from `pb`: its jump's facts, or its branch's
            peir_edge_fact(f, r, index, pb, b, joins, &x_v, &x_loc, &x_lo, &x_hi, &x_live, &x_done);
            // LF8: and everything else that held at pb's end
            if r.sf_on {
                peir_sf_inherit(f, r, dom, index, pb, b, &xs, &x_s0, &x_sn, &x_done);
            }
        } else if joins && b > 0 && b < preds.len() {
            peir_join_fact(f, r, index, preds.get(b), b, &x_v, &x_loc, &x_lo, &x_hi, &x_live, &x_done);
            // LF8: every fact all the ways in share
            if r.sf_on {
                peir_join_set(f, r, dom, index, preds, preds.get(b), b, &xs, &x_s0, &x_sn, &x_done, &st_ptr, &st_blk);
            }
        }
        // LF8: a loop header with no other fact gets its assumed one
        // (checked against the back edges after the scan: peir_lf_update)
        var lf_used: bool = false;
        if lf.on && b < lf.h_loc.len() && lf.h_loc.get(b) >= 0 && r.ref_v < 0 && !(r.ref_loc >= 0 && r.ref_live) && lf.h_lo.get(b) <= lf.h_hi.get(b) {
            r.ref_loc = lf.h_loc.get(b);
            r.ref_lo = lf.h_lo.get(b);
            r.ref_hi = lf.h_hi.get(b);
            r.ref_live = true;
            lf_used = true;
        }
        // OP24: the fact on a local at this block's entry, for the loads of
        // the blocks it dominates
        if dom.on && b < dom.e_loc.len() && r.ref_loc >= 0 && r.ref_live && r.ref_lo <= r.ref_hi {
            dom.e_loc.set(b, r.ref_loc);
            dom.e_lo.set(b, r.ref_lo);
            dom.e_hi.set(b, r.ref_hi);
        }
        // OP24: the block's fact set: a header's assumed fact (LF8) as a
        // second entry fact when the edge's fact took the first, and the
        // edge's fact on a value for the blocks this one dominates
        if dom.on && !lf_used && lf.on && b < lf.h_loc.len() && b < dom.e_loc2.len() && lf.h_loc.get(b) >= 0 && lf.h_lo.get(b) <= lf.h_hi.get(b) {
            dom.e_loc2.set(b, lf.h_loc.get(b));
            dom.e_lo2.set(b, lf.h_lo.get(b));
            dom.e_hi2.set(b, lf.h_hi.get(b));
        }
        // LF8: with the range set, every assumption of a loop header holds
        // at its entry, for the loads of this block and (through the
        // blocks' sets) of the blocks after it: the first one when the
        // edge's fact took ref_*, and the further ones (lf.m_*)
        if r.sf_on && lf.on && b < lf.is_head.len() && lf.is_head.get(b) == 1 {
            if !lf_used && lf.h_loc.get(b) >= 0 && lf.h_lo.get(b) <= lf.h_hi.get(b) {
                peir_sf_add(r, lf.h_loc.get(b), lf.h_lo.get(b), lf.h_hi.get(b));
            }
            var mi: i64 = 0;
            while mi < lf.m_h.len() {
                if lf.m_h.get(mi) == b && lf.m_p.get(mi) >= 0 && lf.m_lo.get(mi) <= lf.m_hi.get(mi) {
                    peir_sf_add(r, lf.m_p.get(mi), lf.m_lo.get(mi), lf.m_hi.get(mi));
                }
                mi = mi + 1;
            }
        }
        if dom.on && r.ref_v >= 0 && r.ref_lo <= r.ref_hi {
            peir_dom_vfact(dom, b, r.ref_v, r.ref_lo, r.ref_hi);
        }
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            var id: i64 = ids.get(k);
            if id >= 0 && id < nv {
                // CS4: the instruction matched in place (no copy); a missing
                // one (pos -1) took the `_` arm, which does nothing
                var ipos: i64 = peir_inst_pos(f, id);
                if ipos >= 0 {
                    match f.insts.get(ipos).inst {
                        Inst::ConstInt(v, ty) => {
                            if ir_type_is_int(ty) {
                                peir_rng_put(r, id, v, v);
                            }
                        }
                        Inst::ConstBool(_) => {
                            peir_rng_put(r, id, 0, 1);
                        }
                        Inst::IntExtend(v, from, _) => {
                            if peir_type_range(from, &mut tr) {
                                var el: i64 = tr.get(0);
                                var eh: i64 = tr.get(1);
                                if peir_rng_get_lo(r, v) > el {
                                    el = peir_rng_get_lo(r, v);
                                }
                                if peir_rng_get_hi(r, v) < eh {
                                    eh = peir_rng_get_hi(r, v);
                                }
                                peir_rng_put(r, id, el, eh);
                            }
                        }
                        Inst::IntTrunc(_, _, to) => {
                            if peir_type_range(to, &mut tr) {
                                peir_rng_put(r, id, tr.get(0), tr.get(1));
                            }
                        }
                        Inst::Load(p, ty) => {
                            if peir_type_range(ty, &mut tr) {
                                peir_rng_put(r, id, tr.get(0), tr.get(1));
                            } else if ir_type_eq(ty, IrType::I64) && p >= 0 && p < r.plain.len() && r.plain.get(p) == 1 {
                                var ll: i64 = r.loc_lo.get(p);
                                var lh: i64 = r.loc_hi.get(p);
                                if r.ref_live && r.ref_loc == p {
                                    if r.ref_lo > ll {
                                        ll = r.ref_lo;
                                    }
                                    if r.ref_hi < lh {
                                        lh = r.ref_hi;
                                    }
                                }
                                // OP24: facts of the blocks that dominate this one
                                if dom.on && peir_dom_narrow(dom, b, k, p, &mut dn) {
                                    if dn.get(0) > ll {
                                        ll = dn.get(0);
                                    }
                                    if dn.get(1) < lh {
                                        lh = dn.get(1);
                                    }
                                }
                                // LF8: the range set's facts on p
                                var si: i64 = 0;
                                while si < r.sf_loc.len() {
                                    if r.sf_loc.get(si) == p {
                                        if r.sf_lo.get(si) > ll {
                                            ll = r.sf_lo.get(si);
                                        }
                                        if r.sf_hi.get(si) < lh {
                                            lh = r.sf_hi.get(si);
                                        }
                                    }
                                    si = si + 1;
                                }
                                peir_rng_put(r, id, ll, lh);
                            }
                        }
                        Inst::Store(p, sv0, _) => {
                            // the branch's fact about a local ends at a store to it
                            if r.ref_live && r.ref_loc == p {
                                r.ref_live = false;
                            }
                            // LF8: so do the set's; from here p holds sv0
                            if r.sf_on && p >= 0 && p < r.plain.len() && r.plain.get(p) == 1 {
                                peir_sf_kill(r, p);
                                var svl0: i64 = peir_rng_get_lo(r, sv0);
                                var svh0: i64 = peir_rng_get_hi(r, sv0);
                                if svl0 <= svh0 && (svl0 > PEIR_I64_MIN || svh0 < PEIR_I64_MAX) {
                                    peir_sf_add(r, p, svl0, svh0);
                                }
                            }
                        }
                        Inst::Call(name, cargs, _, _) => {
                            // A length: no more elements than bytes of memory
                            if name == "Vec_len" || name == "p_vec_len" || name == "str_len" || name == "String_len" || name == "p_str_length" || name == "p_str_len" {
                                peir_rng_put(r, id, 0, 281474976710656);
                            }
                            // OP24: Vec_filled_typed(n, ..) returned, so it
                            // allocated and filled n elements (core: a checked
                            // n * size, "out of memory" when the allocation
                            // fails): from here on n is at most the bytes of
                            // memory, the bound lengths have above
                        if dom.on && name == "Vec_filled_typed" && cargs.len() >= 2 {
                            var fnv: i64 = cargs.get(1);
                            if fnv >= 0 && fnv < nv {
                                var fhi: i64 = 281474976710656;
                                var flo: i64 = peir_rng_get_lo(r, fnv);
                                if flo > fhi {
                                    flo = fhi;
                                }
                                if r.cf_v.len() < 40 {
                                    r.cf_v.push(fnv);
                                    r.cf_lo.push(flo);
                                    r.cf_hi.push(fhi);
                                }
                                peir_dom_vfact(dom, b, fnv, flo, fhi);
                                peir_range_why("filled: v" + int_to_str(fnv) + " <= 2^48 recorded at block " + int_to_str(b));
                            }
                        }
                            // LF10: what every return of an internal callee gives
                            peir_ret_seed(f, r, id, name);
                            // An index below the least length of a filled Vec
                            // that never shrinks: in bounds
                            if final && (name == "Vec_get" || name == "Vec_set") && cargs.len() >= 3 {
                                var vs: i64 = peir_filled_slot(f, r, cargs.get(1));
                                if vs >= 0 {
                                    var ix: i64 = cargs.get(2);
                                    if peir_rng_get_lo(r, ix) >= 0 && peir_rng_get_hi(r, ix) < r.vlen.get(vs) {
                                        out.set(id, out.get(id) | 1);
                                    }
                                }
                            }
                        }
                        Inst::BinOp(op, l, rr, ty) => {
                            var ll2: i64 = peir_rng_get_lo(r, l);
                            var lh2: i64 = peir_rng_get_hi(r, l);
                            var rl: i64 = peir_rng_get_lo(r, rr);
                            var rh: i64 = peir_rng_get_hi(r, rr);
                            var rconst: bool = rl == rh;
                            match op {
                                BinOp::Eq => {
                                    peir_rng_put(r, id, 0, 1);
                                }
                                BinOp::Neq => {
                                    peir_rng_put(r, id, 0, 1);
                                }
                                BinOp::Lt => {
                                    peir_rng_put(r, id, 0, 1);
                                }
                                BinOp::Gt => {
                                    peir_rng_put(r, id, 0, 1);
                                }
                                BinOp::LtEq => {
                                    peir_rng_put(r, id, 0, 1);
                                }
                                BinOp::GtEq => {
                                    peir_rng_put(r, id, 0, 1);
                                }
                                BinOp::And => {
                                    peir_rng_put(r, id, 0, 1);
                                }
                                BinOp::Or => {
                                    peir_rng_put(r, id, 0, 1);
                                }
                                _ => {
                                }
                            }
                            if ir_type_eq(ty, IrType::I64) {
                                match op {
                                    BinOp::Mod => {
                                        if rconst && rl != 0 && rl != PEIR_I64_MIN {
                                            var m: i64 = rl;
                                            if m < 0 {
                                                m = 0 - m;
                                            }
                                            m = m - 1;
                                            if ll2 >= 0 {
                                                peir_rng_put(r, id, 0, m);
                                            } else if lh2 <= 0 {
                                                peir_rng_put(r, id, 0 - m, 0);
                                            } else {
                                                peir_rng_put(r, id, 0 - m, m);
                                            }
                                        }
                                    }
                                    BinOp::Div => {
                                        if rconst && rl > 0 {
                                            peir_rng_put(r, id, ll2 / rl, lh2 / rl);
                                        }
                                    }
                                    BinOp::BitAnd => {
                                        if rconst && rl >= 0 {
                                            peir_rng_put(r, id, 0, rl);
                                        } else if ll2 == lh2 && ll2 >= 0 {
                                            peir_rng_put(r, id, 0, ll2);
                                        } else if ll2 >= 0 && rl >= 0 {
                                            var mh: i64 = lh2;
                                            if rh < mh {
                                                mh = rh;
                                            }
                                            peir_rng_put(r, id, 0, mh);
                                        } else if ll2 >= 0 {
                                            peir_rng_put(r, id, 0, lh2);
                                        } else if rl >= 0 {
                                            peir_rng_put(r, id, 0, rh);
                                        }
                                    }
                                    BinOp::Shr => {
                                        if rconst && rl >= 1 && rl <= 63 && ll2 >= 0 {
                                            peir_rng_put(r, id, ll2 >> rl, lh2 >> rl);
                                        }
                                    }
                                    BinOp::Add => {
                                        t1.clear();
                                        t2.clear();
                                        var okl: bool = peir_radd(ll2, rl, &mut t1);
                                        var okh: bool = peir_radd(lh2, rh, &mut t2);
                                        if okl && okh {
                                            if final {
                                                out.set(id, out.get(id) | 1);
                                            }
                                            peir_rng_put(r, id, t1.get(0), t2.get(0));
                                        } else if okl && ll2 > PEIR_I64_MIN && rl > PEIR_I64_MIN {
                                            // may overflow upward: still checked, the lower bound holds
                                            peir_rng_put(r, id, t1.get(0), PEIR_I64_MAX);
                                        }
                                    }
                                    BinOp::Sub => {
                                        t1.clear();
                                        t2.clear();
                                        var okl2: bool = peir_rsub(ll2, rh, &mut t1);
                                        var okh2: bool = peir_rsub(lh2, rl, &mut t2);
                                        if okl2 && okh2 {
                                            if final {
                                                out.set(id, out.get(id) | 1);
                                            }
                                            peir_rng_put(r, id, t1.get(0), t2.get(0));
                                        }
                                    }
                                    BinOp::Mul => {
                                        // OP24: every corner product fits, so every product
                                        // does (was |operands| <= 2^31 - 1)
                                        if peir_mul_fits(ll2, rl) && peir_mul_fits(ll2, rh) && peir_mul_fits(lh2, rl) && peir_mul_fits(lh2, rh) {
                                            if final {
                                                out.set(id, out.get(id) | 1);
                                            }
                                            var c1: i64 = ll2 * rl;
                                            var c2: i64 = ll2 * rh;
                                            var c3: i64 = lh2 * rl;
                                            var c4: i64 = lh2 * rh;
                                            var mn: i64 = c1;
                                            var mx: i64 = c1;
                                            if c2 < mn {
                                                mn = c2;
                                            }
                                            if c3 < mn {
                                                mn = c3;
                                            }
                                            if c4 < mn {
                                                mn = c4;
                                            }
                                            if c2 > mx {
                                                mx = c2;
                                            }
                                            if c3 > mx {
                                                mx = c3;
                                            }
                                            if c4 > mx {
                                                mx = c4;
                                            }
                                            peir_rng_put(r, id, mn, mx);
                                        } else if ll2 >= 0 && rl >= 0 && peir_mul_fits(ll2, rl) {
                                            // both >= 0: the product is at least lo * lo (checked)
                                            peir_rng_put(r, id, ll2 * rl, PEIR_I64_MAX);
                                        }
                                    }
                                    _ => {
                                    }
                                }
                            }
                        }
                        _ => {
                        }
                    }
                }
                if final && r.lo.get(id) >= 0 && r.lo.get(id) <= r.hi.get(id) {
                    match IrFunction_get_meta(f, id) {
                        OptValueMeta::Some(_) => {
                            out.set(id, out.get(id) | 2);
                        }
                        OptValueMeta::None => {
                        }
                    }
                }
            }
            k = k + 1;
        }
        x_v.set(b, r.ref_v);
        x_loc.set(b, r.ref_loc);
        x_lo.set(b, r.ref_lo);
        x_hi.set(b, r.ref_hi);
        if r.ref_live {
            x_live.set(b, 1);
        } else {
            x_live.set(b, 0);
        }
        // LF8: the range set at this block's end
        if r.sf_on {
            x_s0.set(b, xs.len());
            x_sn.set(b, peir_xs_save(r, &mut xs));
        }
        x_done.set(b, 1);
        b = b + 1;
    }
    r.ref_v = -1;
    r.ref_loc = -1;
    r.ref_live = false;
    r.sf_loc.clear();
    r.sf_lo.clear();
    r.sf_hi.clear();
    // OP24: block facts end with the scan
    r.cf_v.clear();
    r.cf_lo.clear();
    r.cf_hi.clear();
}

/// The fact a branch on `cond` gives in the block it leads to.
fn peir_range_refine(f: &IrFunction, r: &mut PeirRanges, cond: i64, taken: bool) {
    // CS4: matched in place; a missing instruction gives no fact
    var cpos: i64 = peir_inst_pos(f, cond);
    if cpos < 0 {
        return;
    }
    match f.insts.get(cpos).inst {
        Inst::BinOp(op, l, rr, _) => {
            // var OP bound, the bound's interval known
            var v: i64 = l;
            var w: i64 = rr;
            var kind: i64 = -1;
            // 0 <, 1 <=, 2 >, 3 >=, 4 ==, 5 !=
            match op {
                BinOp::Lt => {
                    kind = 0;
                }
                BinOp::LtEq => {
                    kind = 1;
                }
                BinOp::Gt => {
                    kind = 2;
                }
                BinOp::GtEq => {
                    kind = 3;
                }
                BinOp::Eq => {
                    kind = 4;
                }
                BinOp::Neq => {
                    kind = 5;
                }
                _ => {
                    return;
                }
            }
            if !peir_rng_i64(f, l) || !peir_rng_i64(f, rr) {
                return;
            }
            // the variable side: a local's load, or any value; prefer a load
            var vload: bool = false;
            match peir_inst_of(f, l) {
                Inst::Load(p, _) => {
                    vload = p >= 0 && p < r.plain.len() && r.plain.get(p) == 1;
                }
                _ => {
                }
            }
            // OP24: `p * p OP n` keeps p * p on the variable side (its
            // bound becomes a fact on p below), not n
            if !vload && peir_square_local(f, r, l, cond) < 0 {
                match peir_inst_of(f, rr) {
                    Inst::Load(p2, _) => {
                        if p2 >= 0 && p2 < r.plain.len() && r.plain.get(p2) == 1 {
                            // flip: w OP' v
                            v = rr;
                            w = l;
                            if kind == 0 {
                                kind = 2;
                            } else if kind == 1 {
                                kind = 3;
                            } else if kind == 2 {
                                kind = 0;
                            } else if kind == 3 {
                                kind = 1;
                            }
                        }
                    }
                    _ => {
                    }
                }
            }
            if !taken {
                // the negation
                if kind == 0 {
                    kind = 3;
                } else if kind == 1 {
                    kind = 2;
                } else if kind == 2 {
                    kind = 1;
                } else if kind == 3 {
                    kind = 0;
                } else if kind == 4 {
                    kind = 5;
                } else {
                    kind = 4;
                }
            }
            var wl: i64 = peir_rng_get_lo(r, w);
            var wh: i64 = peir_rng_get_hi(r, w);
            var nl: i64 = PEIR_I64_MIN;
            var nh: i64 = PEIR_I64_MAX;
            if kind == 0 {
                if wh > PEIR_I64_MIN {
                    nh = wh - 1;
                }
            } else if kind == 1 {
                nh = wh;
            } else if kind == 2 {
                if wl < PEIR_I64_MAX {
                    nl = wl + 1;
                }
            } else if kind == 3 {
                nl = wl;
            } else if kind == 4 {
                nl = wl;
                nh = wh;
            } else {
                return;
            }
            r.ref_lo = nl;
            r.ref_hi = nh;
            match peir_inst_of(f, v) {
                Inst::Load(p3, _) => {
                    if p3 >= 0 && p3 < r.plain.len() && r.plain.get(p3) == 1 {
                        r.ref_loc = p3;
                        r.ref_live = true;
                        return;
                    }
                }
                _ => {
                }
            }
            // OP24: `p * p < n` (or <=, ==) bounds the local p itself:
            // |p| <= isqrt(n - 1); the multiply was checked, so it held
            if nh < PEIR_I64_MAX && nh >= 0 {
                var sq: i64 = peir_square_local(f, r, v, cond);
                if sq >= 0 {
                    var s: i64 = peir_isqrt(nh);
                    peir_range_why("square: slot v" + int_to_str(sq) + " |p| <= isqrt(nh=" + int_to_str(nh) + ") = " + int_to_str(s) + " (wh " + int_to_str(wh) + ")");
                    r.ref_lo = 0 - s;
                    r.ref_hi = s;
                    r.ref_loc = sq;
                    r.ref_live = true;
                    return;
                }
            }
            r.ref_v = v;
        }
        _ => {
        }
    }
}

/// OP24: the plain local `x` loads, or -1.
fn peir_plain_load_slot(f: &IrFunction, r: &PeirRanges, x: i64) -> i64 {
    match peir_inst_of(f, x) {
        Inst::Load(p, ty) => {
            if p >= 0 && p < r.plain.len() && r.plain.get(p) == 1 && ir_type_eq(ty, IrType::I64) {
                return p;
            }
        }
        _ => {
        }
    }
    return 0 - 1;
}

/// OP24: when `v` is `x * y`, x and y loads of the same plain local p, and
/// every block that branches on `cond` holds both loads with no store to p
/// from the first of them to its end (so p still holds what was squared
/// when the branch is taken): p. Otherwise -1.
fn peir_square_local(f: &IrFunction, r: &PeirRanges, v: i64, cond: i64) -> i64 {
    var px: i64 = 0 - 1;
    var x: i64 = 0 - 1;
    var y: i64 = 0 - 1;
    match peir_inst_of(f, v) {
        Inst::BinOp(op, a, b2, _) => {
            if op == BinOp::Mul {
                x = a;
                y = b2;
                px = peir_plain_load_slot(f, r, a);
                if px >= 0 && peir_plain_load_slot(f, r, b2) != px {
                    px = 0 - 1;
                }
            }
        }
        _ => {
        }
    }
    if px < 0 {
        return 0 - 1;
    }
    var found: bool = false;
    var b: i64 = 0;
    while b < f.blocks.len() {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var n: i64 = ids.len();
        if n > 0 {
            var ends: bool = false;
            match peir_inst_of(f, ids.get(n - 1)) {
                Inst::Branch(c, _, _) => {
                    ends = c == cond;
                }
                _ => {
                }
            }
            if ends {
                var first: i64 = 0 - 1;
                var gotx: bool = false;
                var goty: bool = false;
                var ok: bool = true;
                var k: i64 = 0;
                while k < n {
                    var id: i64 = ids.get(k);
                    if id == x {
                        gotx = true;
                        if first < 0 {
                            first = k;
                        }
                    }
                    if id == y {
                        goty = true;
                        if first < 0 {
                            first = k;
                        }
                    }
                    if first >= 0 {
                        match peir_inst_of(f, id) {
                            Inst::Store(sp, _, _) => {
                                if sp == px {
                                    ok = false;
                                }
                            }
                            _ => {
                            }
                        }
                    }
                    k = k + 1;
                }
                if !(gotx && goty && ok) {
                    return 0 - 1;
                }
                found = true;
            }
        }
        b = b + 1;
    }
    if found {
        return px;
    }
    return 0 - 1;
}

/// OP24: the integer square root of v (0 for v <= 0).
fn peir_isqrt(v: i64) -> i64 {
    if v <= 0 {
        return 0;
    }
    var lo: i64 = 0;
    var hi: i64 = 3037000499;
    while lo < hi {
        var mid: i64 = lo + (hi - lo + 1) / 2;
        if mid <= v / mid {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return lo;
}

// ---------------------------------------------------------------------------
// OP24: facts that dominate a load. A fact on a plain local that holds at
// the entry of block D (the edge fact of its only way in, or a join's)
// holds at a load of that local in any block D dominates, as long as no
// path from D's entry to the load stores to the local without entering D
// again (entering D again makes the fact true again). One fact per block
// is what the scan carries; this lets a fact of an outer block reach the
// loads under an inner branch or loop, and a latch's `p = p + 1` (the
// sieve's `p * p < n`, `m = m + p`). FID_IROPT_OFF=rangedom turns it off.
// ---------------------------------------------------------------------------

pub struct PeirDomFacts {
    pub on: bool,
    pub n: i64,
    pub idom: Vec<i64>,
    pub succs: Vec<Vec<i64>>,
    // per block: the local its entry fact is about (-1: none) and its bounds
    pub e_loc: Vec<i64>,
    pub e_lo: Vec<i64>,
    pub e_hi: Vec<i64>,
    // stores to plain locals: block and position, chained per local
    pub st_head: Vec<i64>,
    pub st_next: Vec<i64>,
    pub st_b: Vec<i64>,
    pub st_k: Vec<i64>,
    // reach sets built so far: from the successors of rs, never entering rd
    pub rd: Vec<i64>,
    pub rs: Vec<i64>,
    pub rm: Vec<Vec<i64>>,
    // reach sets this function may still build (compile time bound)
    pub budget: i64,
    // per block: a second fact on a local at its entry (a loop header's
    // assumed one, LF8, when the edge's fact took the first slot)
    pub e_loc2: Vec<i64>,
    pub e_lo2: Vec<i64>,
    pub e_hi2: Vec<i64>,
    // facts on values that hold from a block on (its entry's, and what a
    // call in it that returned implies), chained per block: they hold in
    // every block it dominates (a value never changes once computed)
    pub fv_head: Vec<i64>,
    pub fv_next: Vec<i64>,
    pub fv_v: Vec<i64>,
    pub fv_lo: Vec<i64>,
    pub fv_hi: Vec<i64>,
}

fn peir_dom_new(f: &IrFunction, r: &PeirRanges, cfg: &IroCfg, on: bool) -> PeirDomFacts {
    var n: i64 = f.blocks.len();
    var nv: i64 = r.plain.len();
    var d: PeirDomFacts = PeirDomFacts {
        on: on && cfg.idom.len() == n && cfg.succs.len() == n, n: n, idom: cfg.idom, succs: cfg.succs, e_loc: Vec::new(), e_lo: peir_zeros(n), e_hi: peir_zeros(n), st_head: Vec::new(), st_next: Vec::new(), st_b: Vec::new(), st_k: Vec::new(), rd: Vec::new(), rs: Vec::new(), rm: Vec::new(), budget: 64, e_loc2: Vec::new(), e_lo2: peir_zeros(n), e_hi2: peir_zeros(n), fv_head: Vec::new(), fv_next: Vec::new(), fv_v: Vec::new(), fv_lo: Vec::new(), fv_hi: Vec::new(),
    };
    var b: i64 = 0;
    while b < n {
        d.e_loc.push(0 - 1);
        d.e_loc2.push(0 - 1);
        d.fv_head.push(0 - 1);
        b = b + 1;
    }
    if !d.on {
        return d;
    }
    var i: i64 = 0;
    while i < nv {
        d.st_head.push(0 - 1);
        i = i + 1;
    }
    b = 0;
    while b < n {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            match peir_inst_of(f, ids.get(k)) {
                Inst::Store(p, _, _) => {
                    if p >= 0 && p < nv && r.plain.get(p) == 1 {
                        d.st_b.push(b);
                        d.st_k.push(k);
                        d.st_next.push(d.st_head.get(p));
                        d.st_head.set(p, d.st_b.len() - 1);
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    return d;
}

/// The blocks reached from the successors of `from` without entering
/// `avoid`: its position in d.rm, or -1 when the budget is spent.
fn peir_dom_reach(d: &mut PeirDomFacts, from: i64, avoid: i64) -> i64 {
    var i: i64 = 0;
    while i < d.rd.len() {
        if d.rd.get(i) == avoid && d.rs.get(i) == from {
            return i;
        }
        i = i + 1;
    }
    if d.budget <= 0 {
        return 0 - 1;
    }
    d.budget = d.budget - 1;
    var mask: Vec<i64> = peir_zeros(d.n);
    mask.set(avoid, 1);
    var seen: Vec<i64> = peir_reach(d.succs, d.succs.get(from), mask, d.n);
    d.rd.push(avoid);
    d.rs.push(from);
    d.rm.push(seen);
    return d.rd.len() - 1;
}

/// Can a store to local p come between the entry of block dd and the load
/// at position k of block b (dd dominates b) without entering dd again?
/// True when unsure.
fn peir_dom_killed(d: &mut PeirDomFacts, dd: i64, b: i64, k: i64, p: i64) -> bool {
    var s: i64 = d.st_head.get(p);
    while s >= 0 {
        var sb: i64 = d.st_b.get(s);
        if sb == b && d.st_k.get(s) < k {
            return true;
        }
        var from_d: bool = sb == dd;
        if !from_d {
            var ri: i64 = peir_dom_reach(d, dd, dd);
            if ri < 0 {
                return true;
            }
            from_d = d.rm.get(ri).get(sb) == 1;
        }
        if from_d {
            var rj: i64 = peir_dom_reach(d, sb, dd);
            if rj < 0 {
                return true;
            }
            if d.rm.get(rj).get(b) == 1 {
                return true;
            }
        }
        s = d.st_next.get(s);
    }
    return false;
}

/// The bounds every dominating entry fact on local p gives the load at
/// position k of block b, in out [lo, hi]; false when none applies.
fn peir_dom_narrow(d: &mut PeirDomFacts, b: i64, k: i64, p: i64, out: &mut Vec<i64>) -> bool {
    out.clear();
    if !d.on || b < 0 || b >= d.n || p < 0 || p >= d.st_head.len() {
        return false;
    }
    var lo: i64 = PEIR_I64_MIN;
    var hi: i64 = PEIR_I64_MAX;
    var any: bool = false;
    var x: i64 = b;
    var steps: i64 = 0;
    while x >= 0 && x < d.n && steps < 32 {
        if d.e_loc.get(x) == p {
            if !peir_dom_killed(d, x, b, k, p) {
                if d.e_lo.get(x) > lo {
                    lo = d.e_lo.get(x);
                }
                if d.e_hi.get(x) < hi {
                    hi = d.e_hi.get(x);
                }
                any = true;
            }
        }
        // the block's second entry fact (a loop's assumption)
        if x < d.e_loc2.len() && d.e_loc2.get(x) == p {
            if !peir_dom_killed(d, x, b, k, p) {
                if d.e_lo2.get(x) > lo {
                    lo = d.e_lo2.get(x);
                }
                if d.e_hi2.get(x) < hi {
                    hi = d.e_hi2.get(x);
                }
                any = true;
            }
        }
        var nx: i64 = d.idom.get(x);
        if nx == x {
            x = 0 - 1;
        } else {
            x = nx;
        }
        steps = steps + 1;
    }
    out.push(lo);
    out.push(hi);
    return any;
}

/// OP24: v in [lo, hi] from block b on (from its entry, or from a call in
/// it that returned): recorded for the blocks b dominates. At most 4096
/// facts per scan (compile time).
fn peir_dom_vfact(d: &mut PeirDomFacts, b: i64, v: i64, lo: i64, hi: i64) {
    if !d.on || b < 0 || b >= d.fv_head.len() || v < 0 || lo > hi || d.fv_v.len() >= 4096 {
        return;
    }
    d.fv_v.push(v);
    d.fv_lo.push(lo);
    d.fv_hi.push(hi);
    d.fv_next.push(d.fv_head.get(b));
    d.fv_head.set(b, d.fv_v.len() - 1);
}

/// OP24: drop every fact recorded by the last scan (each scan's own).
fn peir_dom_reset(d: &mut PeirDomFacts) {
    var b: i64 = 0;
    while b < d.e_loc.len() {
        d.e_loc.set(b, 0 - 1);
        b = b + 1;
    }
    b = 0;
    while b < d.e_loc2.len() {
        d.e_loc2.set(b, 0 - 1);
        b = b + 1;
    }
    b = 0;
    while b < d.fv_head.len() {
        d.fv_head.set(b, 0 - 1);
        b = b + 1;
    }
    d.fv_next.clear();
    d.fv_v.clear();
    d.fv_lo.clear();
    d.fv_hi.clear();
}

/// OP24: the facts on values in force at the entry of block b, into
/// r.cf_*: every one recorded for a block that strictly dominates b (each
/// such block ran to its end before b was entered, and a value keeps what
/// it was computed as). At most 32 dominators and 32 facts.
fn peir_dom_enter(d: &mut PeirDomFacts, r: &mut PeirRanges, b: i64) {
    r.cf_v.clear();
    r.cf_lo.clear();
    r.cf_hi.clear();
    if !d.on || b < 0 || b >= d.n || b >= d.idom.len() {
        return;
    }
    var x: i64 = d.idom.get(b);
    if x == b {
        return;
    }
    var steps: i64 = 0;
    while x >= 0 && x < d.n && x < d.fv_head.len() && steps < 32 && r.cf_v.len() < 32 {
        var s: i64 = d.fv_head.get(x);
        while s >= 0 && r.cf_v.len() < 32 {
            r.cf_v.push(d.fv_v.get(s));
            r.cf_lo.push(d.fv_lo.get(s));
            r.cf_hi.push(d.fv_hi.get(s));
            s = d.fv_next.get(s);
        }
        var nx: i64 = d.idom.get(x);
        if nx == x {
            x = 0 - 1;
        } else {
            x = nx;
        }
        steps = steps + 1;
    }
}

// ---------------------------------------------------------------------------
// LF8: facts over a loop's back edge. A loop header (iro_loops) gets an
// assumed fact about one plain local p: p in [lo, hi] at its entry. The
// range scan runs with it; the assumption holds when p's bounds on every
// way into the header from outside the loop, and every value the loop's
// body stores to p, lie in [lo, hi] (by induction over the header's
// entries: on a back edge p holds what the body last stored to it, or what
// it held at the header's entry). peir_lf_update checks that after each
// scan and moves the assumptions (from the ways in, grown, widened to
// i64's ends after two rounds, narrowed back to what the stores give)
// until every one holds; the final scan uses only assumptions the scan
// before it checked. Values a scan computes under an assumption are only
// kept when that assumption held. The fact reaches loads in the loop
// through the header's entry fact (dom.e_loc, OP24). FID_IROPT_OFF=
// rangeloop (or rangejoin) turns it off. With the range set (Nov 17,
// FID_IROPT_OFF=rangeset turns it off) a header holds up to
// 1 + PEIR_LF_MORE assumptions (the further ones in m_*, reaching the
// loop's blocks through the blocks' fact sets), all checked together:
// each scan assumes all of them at every header entry, so when every one
// held, all hold by induction over the program's steps. New ones are
// picked in the first 4 scans only; after 10, the ones still moving are
// dropped one scan at a time (3 at most), then all if that fails.
// ---------------------------------------------------------------------------

pub struct PeirBackFacts {
    pub on: bool,
    // the loop headers (block indexes) and their bodies (flags per block)
    pub heads: Vec<i64>,
    pub bodies: Vec<Vec<i64>>,
    // per block index: the local assumed at its entry (-1: none), bounds
    pub h_loc: Vec<i64>,
    pub h_lo: Vec<i64>,
    pub h_hi: Vec<i64>,
    // per block index: rounds the assumption grew, and was narrowed
    pub h_grow: Vec<i64>,
    pub h_nar: Vec<i64>,
    // (header, local) pairs tried already
    pub tried_h: Vec<i64>,
    pub tried_p: Vec<i64>,
    // LF8 (Nov 17), with the range set (multi): per block index 1 for a
    // loop header; further assumptions at headers besides h_*, at most
    // PEIR_LF_MORE per header: header, local (-1: dropped), bounds, rounds
    // grown and narrowed
    pub multi: bool,
    pub is_head: Vec<i64>,
    pub m_h: Vec<i64>,
    pub m_p: Vec<i64>,
    pub m_lo: Vec<i64>,
    pub m_hi: Vec<i64>,
    pub m_grow: Vec<i64>,
    pub m_nar: Vec<i64>,
}

const PEIR_LF_MORE: i64 = 3;

/// The loop facts of a function of `n` blocks, all unassumed; off when
/// `on` is false or the function has no loop (header other than the entry).
fn peir_lf_new(cfg: &IroCfg, n: i64, on: bool) -> PeirBackFacts {
    var lf: PeirBackFacts = PeirBackFacts {
        on: false, heads: Vec::new(), bodies: Vec::new(), h_loc: Vec::new(), h_lo: peir_zeros(n), h_hi: peir_zeros(n), h_grow: peir_zeros(n), h_nar: peir_zeros(n), tried_h: Vec::new(), tried_p: Vec::new(), multi: false, is_head: peir_zeros(n), m_h: Vec::new(), m_p: Vec::new(), m_lo: Vec::new(), m_hi: Vec::new(), m_grow: Vec::new(), m_nar: Vec::new(),
    };
    var b: i64 = 0;
    while b < n {
        lf.h_loc.push(0 - 1);
        b = b + 1;
    }
    if !on || cfg.n != n {
        return lf;
    }
    var lt: IroLoops = iro_loops(cfg);
    var i: i64 = 0;
    while i < lt.found.len() && i < lt.bodies.len() {
        var h: i64 = lt.found.get(i);
        // the entry block is also entered from the function's start
        if h > 0 && h < n {
            lf.heads.push(h);
            lf.bodies.push(lt.bodies.get(i));
            lf.is_head.set(h, 1);
        }
        i = i + 1;
    }
    lf.on = lf.heads.len() > 0;
    return lf;
}

/// Drop every assumption.
fn peir_lf_clear(lf: &mut PeirBackFacts) {
    var b: i64 = 0;
    while b < lf.h_loc.len() {
        lf.h_loc.set(b, 0 - 1);
        b = b + 1;
    }
    b = 0;
    while b < lf.m_p.len() {
        lf.m_p.set(b, 0 - 1);
        b = b + 1;
    }
}

/// The interval of value v from the last scan, pushed to out.
fn peir_lf_vr(r: &PeirRanges, v: i64, out: &mut Vec<i64>) {
    if v >= 0 && v < r.lo.len() {
        out.push(r.lo.get(v));
        out.push(r.hi.get(v));
    } else {
        out.push(PEIR_I64_MIN);
        out.push(PEIR_I64_MAX);
    }
}

/// The bounds of plain local p at the end of block x0, pushed to out: the
/// value its last store there stores, else (a block with one way in) what p
/// holds at the end of that way's block, else p's bounds from all stores.
fn peir_lf_end(f: &IrFunction, r: &PeirRanges, single: &Vec<i64>, x0: i64, p: i64, out: &mut Vec<i64>) {
    var x: i64 = x0;
    var steps: i64 = 0;
    while x >= 0 && x < f.blocks.len() && steps < 16 {
        var ids: Vec<i64> = f.blocks.get(x).instructions;
        var k: i64 = ids.len() - 1;
        while k >= 0 {
            match peir_inst_of(f, ids.get(k)) {
                Inst::Store(sp, sv, _) => {
                    if sp == p {
                        peir_lf_vr(r, sv, out);
                        return;
                    }
                }
                _ => {
                }
            }
            k = k - 1;
        }
        if x == 0 || x >= single.len() {
            x = 0 - 1;
        } else {
            x = single.get(x);
        }
        steps = steps + 1;
    }
    out.push(r.loc_lo.get(p));
    out.push(r.loc_hi.get(p));
}

/// For header h (loop body `body`) and plain local p, in out: [0, 1] the
/// hull of p's bounds on the ways in from outside the loop and of every
/// value the body stores to p; [2, 3] the hull of the ways in alone. False
/// when no way in comes from outside the loop.
fn peir_lf_need(f: &IrFunction, r: &PeirRanges, single: &Vec<i64>, preds: &Vec<Vec<i64>>, h: i64, body: &Vec<i64>, p: i64, out: &mut Vec<i64>) -> bool {
    out.clear();
    if h < 0 || h >= preds.len() || p < 0 || p >= r.loc_lo.len() {
        return false;
    }
    var t: Vec<i64> = Vec::new();
    var elo: i64 = PEIR_I64_MAX;
    var ehi: i64 = PEIR_I64_MIN;
    var any: bool = false;
    var ps: Vec<i64> = preds.get(h);
    var q: i64 = 0;
    while q < ps.len() {
        var qb: i64 = ps.get(q);
        if qb >= 0 && qb < body.len() && body.get(qb) == 0 {
            t.clear();
            peir_lf_end(f, r, single, qb, p, &mut t);
            if t.get(0) < elo {
                elo = t.get(0);
            }
            if t.get(1) > ehi {
                ehi = t.get(1);
            }
            any = true;
        }
        q = q + 1;
    }
    if !any {
        return false;
    }
    var lo: i64 = elo;
    var hi: i64 = ehi;
    var b: i64 = 0;
    while b < body.len() && b < f.blocks.len() {
        if body.get(b) == 1 {
            var ids: Vec<i64> = f.blocks.get(b).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                match peir_inst_of(f, ids.get(k)) {
                    Inst::Store(sp, sv, _) => {
                        if sp == p {
                            t.clear();
                            peir_lf_vr(r, sv, &mut t);
                            if t.get(0) < lo {
                                lo = t.get(0);
                            }
                            if t.get(1) > hi {
                                hi = t.get(1);
                            }
                        }
                    }
                    _ => {
                    }
                }
                k = k + 1;
            }
        }
        b = b + 1;
    }
    out.push(lo);
    out.push(hi);
    out.push(elo);
    out.push(ehi);
    return true;
}

fn peir_lf_tried(lf: &PeirBackFacts, h: i64, p: i64) -> bool {
    var i: i64 = 0;
    while i < lf.tried_h.len() {
        if lf.tried_h.get(i) == h && lf.tried_p.get(i) == p {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// LF8: one assumption's check after a scan: plain local p assumed in
/// [al, ah] at header h's entry, grown g0 and narrowed nar rounds so far.
/// In out: keep (1; 0 when dropped), lo, hi, grown, narrowed. True when it
/// changed. It held when p's bounds on the ways in and every value the
/// body stores to p lie inside it; then it is narrowed to them (twice at
/// most). Otherwise it grows: to what was found, then to i64's ends, and
/// it is dropped when both ends are open or after 4 rounds of growth.
/// With `freeze` (the scans ran out) one that failed is dropped and none
/// is narrowed.
fn peir_lf_step(f: &IrFunction, r: &PeirRanges, single: &Vec<i64>, preds: &Vec<Vec<i64>>, h: i64, body: &Vec<i64>, p: i64, al: i64, ah: i64, g0: i64, nar: i64, freeze: bool, out: &mut Vec<i64>) -> bool {
    out.clear();
    var t: Vec<i64> = Vec::new();
    if !peir_lf_need(f, r, single, preds, h, body, p, &mut t) {
        out.push(0);
        out.push(al);
        out.push(ah);
        out.push(g0);
        out.push(nar);
        return true;
    }
    var nl: i64 = t.get(0);
    var nh: i64 = t.get(1);
    if nl >= al && nh <= ah {
        // it held; narrow it to what the stores give (twice at most)
        if !freeze && (nl > al || nh < ah) && nar < 2 {
            out.push(1);
            out.push(nl);
            out.push(nh);
            out.push(g0);
            out.push(nar + 1);
            return true;
        }
        out.push(1);
        out.push(al);
        out.push(ah);
        out.push(g0);
        out.push(nar);
        return false;
    }
    var g: i64 = g0 + 1;
    var wl: i64 = al;
    var wh: i64 = ah;
    if nl < al {
        if g >= 2 {
            wl = PEIR_I64_MIN;
        } else {
            wl = nl;
        }
    }
    if nh > ah {
        if g >= 2 {
            wh = PEIR_I64_MAX;
        } else {
            wh = nh;
        }
    }
    if freeze || (wl == PEIR_I64_MIN && wh == PEIR_I64_MAX) || g > 4 {
        out.push(0);
    } else {
        out.push(1);
    }
    out.push(wl);
    out.push(wh);
    out.push(g);
    out.push(nar);
    return true;
}

/// After a scan: check each header's assumptions against what the scan
/// found, and move them (peir_lf_step); with `pick`, pick locals for a
/// header with none (with the range set, lf.multi: up to 1 + PEIR_LF_MORE
/// per header). True when anything changed, so another scan is needed;
/// false when every assumption held in the scan just made.
fn peir_lf_update(f: &IrFunction, r: &PeirRanges, single: &Vec<i64>, preds: &Vec<Vec<i64>>, lf: &mut PeirBackFacts, pick: bool, freeze: bool) -> bool {
    var changed: bool = false;
    var t: Vec<i64> = Vec::new();
    var st: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < lf.heads.len() && i < lf.bodies.len() {
        var h: i64 = lf.heads.get(i);
        var body: Vec<i64> = lf.bodies.get(i);
        var p: i64 = lf.h_loc.get(h);
        var live: i64 = 0;
        if p >= 0 {
            var hlo: i64 = lf.h_lo.get(h);
            var hhi: i64 = lf.h_hi.get(h);
            var hg: i64 = lf.h_grow.get(h);
            var hn: i64 = lf.h_nar.get(h);
            if peir_lf_step(f, r, single, preds, h, &body, p, hlo, hhi, hg, hn, freeze, &mut st) {
                changed = true;
            }
            if st.get(0) == 1 {
                lf.h_lo.set(h, st.get(1));
                lf.h_hi.set(h, st.get(2));
                lf.h_grow.set(h, st.get(3));
                lf.h_nar.set(h, st.get(4));
                live = live + 1;
            } else {
                lf.h_loc.set(h, 0 - 1);
            }
        }
        // LF8: the further assumptions at h
        var mi: i64 = 0;
        while mi < lf.m_h.len() {
            var mp: i64 = lf.m_p.get(mi);
            if lf.m_h.get(mi) == h && mp >= 0 {
                var mlo: i64 = lf.m_lo.get(mi);
                var mhi: i64 = lf.m_hi.get(mi);
                var mg: i64 = lf.m_grow.get(mi);
                var mn: i64 = lf.m_nar.get(mi);
                if peir_lf_step(f, r, single, preds, h, &body, mp, mlo, mhi, mg, mn, freeze, &mut st) {
                    changed = true;
                }
                if st.get(0) == 1 {
                    lf.m_lo.set(mi, st.get(1));
                    lf.m_hi.set(mi, st.get(2));
                    lf.m_grow.set(mi, st.get(3));
                    lf.m_nar.set(mi, st.get(4));
                    live = live + 1;
                } else {
                    lf.m_p.set(mi, 0 - 1);
                }
            }
            mi = mi + 1;
        }
        // how many locals to pick: one for a header with none (without the
        // range set, only one that had none before this update, as before)
        var want: i64 = 0;
        if lf.multi {
            want = 1 + PEIR_LF_MORE - live;
        } else if p < 0 {
            want = 1;
        }
        if pick && !freeze && want > 0 {
            // pick the first locals the body stores whose hull, without an
            // assumption, is narrower than their bounds from all stores (at
            // most 8 locals tried per header and scan: compile time)
            var bb: i64 = 0;
            var picked: i64 = 0;
            var tries: i64 = 0;
            while bb < body.len() && bb < f.blocks.len() && picked < want && tries < 8 {
                if body.get(bb) == 1 {
                    var ids: Vec<i64> = f.blocks.get(bb).instructions;
                    var k: i64 = 0;
                    while k < ids.len() && picked < want && tries < 8 {
                        match peir_inst_of(f, ids.get(k)) {
                            Inst::Store(sp, _, _) => {
                                if sp >= 0 && sp < r.plain.len() && r.plain.get(sp) == 1 && !peir_lf_tried(lf, h, sp) {
                                    tries = tries + 1;
                                    lf.tried_h.push(h);
                                    lf.tried_p.push(sp);
                                    if peir_lf_need(f, r, single, preds, h, &body, sp, &mut t) {
                                        if (t.get(0) > r.loc_lo.get(sp) || t.get(1) < r.loc_hi.get(sp)) && t.get(2) <= t.get(3) {
                                            // start from the ways in
                                            if lf.h_loc.get(h) < 0 {
                                                lf.h_loc.set(h, sp);
                                                lf.h_lo.set(h, t.get(2));
                                                lf.h_hi.set(h, t.get(3));
                                                lf.h_grow.set(h, 0);
                                                lf.h_nar.set(h, 0);
                                            } else {
                                                lf.m_h.push(h);
                                                lf.m_p.push(sp);
                                                lf.m_lo.push(t.get(2));
                                                lf.m_hi.push(t.get(3));
                                                lf.m_grow.push(0);
                                                lf.m_nar.push(0);
                                            }
                                            picked = picked + 1;
                                            changed = true;
                                        }
                                    }
                                }
                            }
                            _ => {
                            }
                        }
                        k = k + 1;
                    }
                }
                bb = bb + 1;
            }
        }
        i = i + 1;
    }
    return changed;
}

pub fn peir_range_ops(f: &IrFunction, nvals: i64, out: &mut Vec<i64>) {
    var r: PeirRanges = PeirRanges {
        lo: Vec::new(), hi: Vec::new(), loc_lo: Vec::new(), loc_hi: Vec::new(), plain: peir_zeros(nvals), ref_v: -1, ref_loc: -1, ref_lo: 0, ref_hi: 0, ref_live: false, vstable: peir_zeros(nvals), vlen: Vec::new(), cf_v: Vec::new(), cf_lo: Vec::new(), cf_hi: Vec::new(), sf_on: false, sf_loc: Vec::new(), sf_lo: Vec::new(), sf_hi: Vec::new(), def_b: Vec::new(), plain_cfg: true,
    };
    var vi: i64 = 0;
    while vi < nvals {
        r.vlen.push(-1);
        vi = vi + 1;
    }
    peir_filled_vecs(f, nvals, &mut r);
    var i: i64 = 0;
    while i < nvals {
        r.lo.push(PEIR_I64_MIN);
        r.hi.push(PEIR_I64_MAX);
        r.loc_lo.push(PEIR_I64_MIN);
        r.loc_hi.push(PEIR_I64_MAX);
        i = i + 1;
    }
    // Locals only loads and stores of whole i64 values use
    i = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        match ve.inst {
            Inst::Alloca(ty, _) => {
                if ve.id >= 0 && ve.id < nvals && ir_type_eq(ty, IrType::I64) {
                    r.plain.set(ve.id, 1);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    var st_ptr: Vec<i64> = Vec::new();
    var st_val: Vec<i64> = Vec::new();
    var ops: Vec<i64> = Vec::new();
    i = 0;
    while i < f.insts.len() {
        var inst: Inst = f.insts.get(i).inst;
        ops.clear();
        peir_inst_operands(inst, &mut ops);
        var o: i64 = 0;
        while o < ops.len() {
            var v: i64 = ops.get(o);
            if v >= 0 && v < nvals && r.plain.get(v) == 1 {
                var ok: bool = false;
                match inst {
                    Inst::Load(p, lty) => {
                        ok = p == v && ir_type_eq(lty, IrType::I64);
                    }
                    Inst::Store(p, sv, _) => {
                        ok = p == v && sv != v;
                    }
                    _ => {
                    }
                }
                if !ok {
                    r.plain.set(v, 0);
                }
            }
            o = o + 1;
        }
        match inst {
            Inst::Store(p, sv, _) => {
                st_ptr.push(p);
                st_val.push(sv);
            }
            _ => {
            }
        }
        i = i + 1;
    }
    // Blocks entered from one block only, and (LF8/LF9) every block's ways
    // in, for facts that meet at joins: both from the shared CFG (ME2:
    // iro_cfg, where a Branch to one block counts once and a Switch once
    // per block it may enter, so a block a Switch enters has no fact from
    // it unless it is that block's only way in, as before)
    var n: i64 = f.blocks.len();
    var jcfg: IroCfg = iro_cfg(f);
    var index: Vec<i64> = jcfg.index;
    var jpreds: Vec<Vec<i64>> = jcfg.preds;
    var single: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < n {
        var jps: Vec<i64> = jpreds.get(b);
        if b != 0 && jps.len() == 1 {
            single.push(jps.get(0));
        } else {
            single.push(-1);
        }
        b = b + 1;
    }
    var joins: bool = !iro_named_off(p_getenv("FID_IROPT_OFF"), "rangejoin");
    // LF8: the range set: several facts per block (FID_IROPT_OFF=rangeset)
    r.sf_on = joins && !iro_named_off(p_getenv("FID_IROPT_OFF"), "rangeset");
    if r.sf_on {
        peir_def_blocks(f, &mut r, nvals);
    }
    // OP24: facts of dominating blocks reach loads (FID_IROPT_OFF=rangedom)
    var domf: bool = !iro_named_off(p_getenv("FID_IROPT_OFF"), "rangedom");
    var dom: PeirDomFacts = peir_dom_new(f, &r, &jcfg, domf);
    domf = dom.on;
    // LF8: facts over loops' back edges, for the final scan
    // (FID_IROPT_OFF=rangeloop); the rounds below scan without them
    var lf_none: PeirBackFacts = peir_lf_new(&jcfg, n, false);
    var lf: PeirBackFacts = peir_lf_new(&jcfg, n, joins && !iro_named_off(p_getenv("FID_IROPT_OFF"), "rangeloop"));
    // Rounds: value ranges from the locals' bounds, the locals' bounds from
    // the values they are stored
    var dummy: Vec<i64> = peir_zeros(nvals);
    var round: i64 = 0;
    while round < 3 {
        // fresh value intervals each round
        i = 0;
        while i < nvals {
            r.lo.set(i, PEIR_I64_MIN);
            r.hi.set(i, PEIR_I64_MAX);
            i = i + 1;
        }
        // LF10: the parameters' ranges from every call (when known)
        peir_prm_seed(f, &mut r);
        peir_range_scan(f, &mut r, &single, &jpreds, joins, &index, &mut dummy, false, &mut dom, &lf_none);
        var newlo: Vec<i64> = Vec::new();
        var newhi: Vec<i64> = Vec::new();
        var has: Vec<i64> = peir_zeros(nvals);
        i = 0;
        while i < nvals {
            newlo.push(PEIR_I64_MAX);
            newhi.push(PEIR_I64_MIN);
            i = i + 1;
        }
        var keep_lo: Vec<i64> = peir_zeros(nvals);
        var keep_hi: Vec<i64> = peir_zeros(nvals);
        var s: i64 = 0;
        while s < st_ptr.len() {
            var p: i64 = st_ptr.get(s);
            var sv: i64 = st_val.get(s);
            if p >= 0 && p < nvals && r.plain.get(p) == 1 {
                // itself plus (minus) something: keeps one side
                var self_step: bool = false;
                var up: bool = false;
                var down: bool = false;
                match peir_inst_of(f, sv) {
                    Inst::BinOp(sop, sl, sr, _) => {
                        var from_self: bool = false;
                        match peir_inst_of(f, sl) {
                            Inst::Load(lp, _) => {
                                from_self = lp == p;
                            }
                            _ => {
                            }
                        }
                        if from_self {
                            match sop {
                                BinOp::Add => {
                                    self_step = true;
                                    up = peir_rng_get_lo(&r, sr) >= 0;
                                    down = peir_rng_get_hi(&r, sr) <= 0;
                                }
                                BinOp::Sub => {
                                    self_step = true;
                                    up = peir_rng_get_hi(&r, sr) <= 0;
                                    down = peir_rng_get_lo(&r, sr) >= 0;
                                }
                                _ => {
                                }
                            }
                        }
                    }
                    _ => {
                    }
                }
                if self_step {
                    // never lowers it (up) / never raises it (down); OP24:
                    // on a side it may move, a stored value the facts bound
                    // (the load under a dominating `p * p < n`) bounds it
                    var svl: i64 = peir_rng_get_lo(&r, sv);
                    var svh: i64 = peir_rng_get_hi(&r, sv);
                    if !up {
                        if domf && svl > PEIR_I64_MIN {
                            if svl < newlo.get(p) {
                                newlo.set(p, svl);
                            }
                        } else {
                            keep_lo.set(p, 1);
                        }
                    }
                    if !down {
                        if domf && svh < PEIR_I64_MAX {
                            if svh > newhi.get(p) {
                                newhi.set(p, svh);
                            }
                        } else {
                            keep_hi.set(p, 1);
                        }
                    }
                } else {
                    has.set(p, 1);
                    var vl: i64 = peir_rng_get_lo(&r, sv);
                    var vh: i64 = peir_rng_get_hi(&r, sv);
                    if vl < newlo.get(p) {
                        newlo.set(p, vl);
                    }
                    if vh > newhi.get(p) {
                        newhi.set(p, vh);
                    }
                }
            }
            s = s + 1;
        }
        peir_filled_lengths(f, nvals, &mut r);
        i = 0;
        while i < nvals {
            if r.plain.get(i) == 1 {
                if has.get(i) == 1 && keep_lo.get(i) == 0 {
                    r.loc_lo.set(i, newlo.get(i));
                } else {
                    r.loc_lo.set(i, PEIR_I64_MIN);
                }
                if has.get(i) == 1 && keep_hi.get(i) == 0 {
                    r.loc_hi.set(i, newhi.get(i));
                } else {
                    r.loc_hi.set(i, PEIR_I64_MAX);
                }
            }
            i = i + 1;
        }
        round = round + 1;
    }
    // LF8: scan with the loop headers' assumptions until a scan finds every
    // one held (peir_lf_update); when that takes too many scans, none
    // With the range set (LF8, Nov 17) a header holds several assumptions
    // (lf.multi): new ones are picked in the first scans only, and when
    // the scans run out, the assumptions that still move are dropped one
    // scan at a time (up to 3) instead of all of them
    if lf.on {
        lf.multi = r.sf_on;
        var lfmax: i64 = 8;
        if lf.multi {
            lfmax = 10;
        }
        var lfit: i64 = 0;
        var lfgo: bool = true;
        while lfgo && lfit < lfmax {
            i = 0;
            while i < nvals {
                r.lo.set(i, PEIR_I64_MIN);
                r.hi.set(i, PEIR_I64_MAX);
                i = i + 1;
            }
            peir_prm_seed(f, &mut r);
            peir_range_scan(f, &mut r, &single, &jpreds, joins, &index, &mut dummy, false, &mut dom, &lf);
            var lfpick: bool = !lf.multi || lfit < 4;
            lfgo = peir_lf_update(f, &r, &single, &jpreds, &mut lf, lfpick, false);
            lfit = lfit + 1;
        }
        var lffz: i64 = 0;
        while lfgo && lf.multi && lffz < 3 {
            i = 0;
            while i < nvals {
                r.lo.set(i, PEIR_I64_MIN);
                r.hi.set(i, PEIR_I64_MAX);
                i = i + 1;
            }
            peir_prm_seed(f, &mut r);
            peir_range_scan(f, &mut r, &single, &jpreds, joins, &index, &mut dummy, false, &mut dom, &lf);
            lfgo = peir_lf_update(f, &r, &single, &jpreds, &mut lf, false, true);
            lffz = lffz + 1;
        }
        if lfgo {
            peir_lf_clear(&mut lf);
        }
    }
    i = 0;
    while i < nvals {
        r.lo.set(i, PEIR_I64_MIN);
        r.hi.set(i, PEIR_I64_MAX);
        i = i + 1;
    }
    peir_prm_seed(f, &mut r);
    peir_range_scan(f, &mut r, &single, &jpreds, joins, &index, out, true, &mut dom, &lf);
    // DB8: explain_checks reads the ranges to say why a check stayed
    if g_peir_keep_ranges {
        g_peir_kept_lo = r.lo;
        g_peir_kept_hi = r.hi;
    }
}

/// DB8: when set, peir_range_ops keeps its final value ranges here.
var g_peir_keep_ranges: bool = false;
var g_peir_kept_lo: Vec<i64> = Vec::new();
var g_peir_kept_hi: Vec<i64> = Vec::new();

/// A range as text: "[lo, hi]", "?" for an unbounded side.
fn explain_rng(v: i64) -> str {
    if v < 0 || v >= g_peir_kept_lo.len() || v >= g_peir_kept_hi.len() {
        return "[?, ?]";
    }
    var lo: str = "?";
    var hi: str = "?";
    if g_peir_kept_lo.get(v) != PEIR_I64_MIN {
        lo = int_to_str(g_peir_kept_lo.get(v));
    }
    if g_peir_kept_hi.get(v) != PEIR_I64_MAX {
        hi = int_to_str(g_peir_kept_hi.get(v));
    }
    return "[" + lo + ", " + hi + "]";
}

/// DB8: why a check stayed: what the analyses knew about its operands.
fn explain_kept_why(f: &IrFunction, inst: Inst) -> str {
    match inst {
        Inst::BinOp(op, l, r, _) => {
            if op == BinOp::Div || op == BinOp::Mod {
                var dl: i64 = -1;
                var dh: i64 = 1;
                if r >= 0 && r < g_peir_kept_lo.len() && r < g_peir_kept_hi.len() {
                    dl = g_peir_kept_lo.get(r);
                    dh = g_peir_kept_hi.get(r);
                }
                if dl <= 0 && dh >= 0 {
                    return "divisor v" + int_to_str(r) + " in " + explain_rng(r) + " may be 0";
                }
                return "divisor v" + int_to_str(r) + " in " + explain_rng(r) + " may be -1 with v" + int_to_str(l) + " in " + explain_rng(l);
            }
            return "operands v" + int_to_str(l) + " in " + explain_rng(l) + " and v" + int_to_str(r) + " in " + explain_rng(r) + ": the result may leave i64, and no counted loop bounds it";
        }
        Inst::Call(_, args, _, _) => {
            if args.len() >= 3 {
                var ix: i64 = args.get(2);
                var il: i64 = -1;
                if ix >= 0 && ix < g_peir_kept_lo.len() {
                    il = g_peir_kept_lo.get(ix);
                }
                if il < 0 {
                    return "index v" + int_to_str(ix) + " in " + explain_rng(ix) + " may be negative";
                }
                return "index v" + int_to_str(ix) + " in " + explain_rng(ix) + ": no counted loop over this Vec and no length fact keeps it below len()";
            }
            return "operands unknown";
        }
        _ => {
        }
    }
    return "not proved";
}

// ---------------------------------------------------------------------------
// Filled Vecs (competitive OP: bounds from Vec::filled)
//
// A Vec local whose every store is a Vec_filled_typed(n, ...) result (or a
// zero: the slot's prologue, a move out) and whose loaded value only feeds
// get, set, push, len, share or drop never has fewer elements than the least
// `n` it was filled with: get/set at an index known to be in [0, that n)
// need no bounds check.
// ---------------------------------------------------------------------------

/// Is `name` a call that keeps a Vec (its argument 1) at least as long?
fn peir_vec_keeps_len(name: str) -> bool {
    return name == "Vec_get" || name == "Vec_set" || name == "Vec_push" || name == "Vec_len" || name == "Vec_drop" || name == "Vec_share" || name == "Vec_capacity" || name == "Vec_is_empty";
}

/// Is `v` the result of Vec_filled_typed?
fn peir_is_filled_call(f: &IrFunction, v: i64) -> bool {
    match peir_inst_of(f, v) {
        Inst::Call(name, _, _, _) => {
            return name == "Vec_filled_typed";
        }
        _ => {
        }
    }
    return false;
}

/// Is `v` a zero constant?
fn peir_is_zero_const(f: &IrFunction, v: i64) -> bool {
    match peir_inst_of(f, v) {
        Inst::ConstInt(c, _) => {
            return c == 0;
        }
        Inst::ConstNull(_) => {
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Mark the stable filled Vec locals (r.vstable).
fn peir_filled_vecs(f: &IrFunction, nvals: i64, r: &mut PeirRanges) {
    // candidates: allocas with at least one filled store
    var cand: Vec<i64> = peir_zeros(nvals);
    var load_of: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nvals {
        load_of.push(-1);
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        var ve: ValueIdInst = f.insts.get(i);
        match ve.inst {
            Inst::Store(p, sv, _) => {
                if p >= 0 && p < nvals && peir_is_filled_call(f, sv) {
                    var ppos: i64 = peir_inst_pos(f, p);
                    if ppos >= 0 {
                        match f.insts.get(ppos).inst {
                            Inst::Alloca(_, _) => {
                                cand.set(p, 1);
                            }
                            _ => {
                            }
                        }
                    }
                }
            }
            Inst::Load(p2, _) => {
                if ve.id >= 0 && ve.id < nvals && p2 >= 0 && p2 < nvals {
                    load_of.set(ve.id, p2);
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    // every use of a candidate, or of a value loaded from it, must keep it
    // at least as long
    var ops: Vec<i64> = Vec::new();
    i = 0;
    while i < f.insts.len() {
        var inst: Inst = f.insts.get(i).inst;
        ops.clear();
        peir_inst_operands(inst, &mut ops);
        var o: i64 = 0;
        while o < ops.len() {
            var v: i64 = ops.get(o);
            if v >= 0 && v < nvals {
                // the slot itself: loads, and stores of a filled Vec or zero
                if cand.get(v) == 1 {
                    var ok: bool = false;
                    match inst {
                        Inst::Load(lp, _) => {
                            ok = lp == v;
                        }
                        Inst::Store(sp, sv2, _) => {
                            ok = sp == v && sv2 != v && (peir_is_filled_call(f, sv2) || peir_is_zero_const(f, sv2));
                        }
                        _ => {
                        }
                    }
                    if !ok {
                        cand.set(v, 0);
                    }
                }
                // a value loaded from it: argument 1 of a call that keeps it
                var ls: i64 = load_of.get(v);
                if ls >= 0 && cand.get(ls) == 1 {
                    var ok2: bool = false;
                    match inst {
                        Inst::Call(cn, cargs, _, _) => {
                            if peir_vec_keeps_len(cn) && cargs.len() >= 2 && cargs.get(1) == v {
                                ok2 = true;
                                var a: i64 = 0;
                                while a < cargs.len() {
                                    if a != 1 && cargs.get(a) == v {
                                        ok2 = false;
                                    }
                                    a = a + 1;
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    if !ok2 {
                        cand.set(ls, 0);
                    }
                }
            }
            o = o + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < nvals {
        r.vstable.set(i, cand.get(i));
        i = i + 1;
    }
}

/// The least length of each stable filled Vec: the least lower bound of `n`
/// over its filled stores, from this round's ranges (-1: none known).
fn peir_filled_lengths(f: &IrFunction, nvals: i64, r: &mut PeirRanges) {
    var least: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nvals {
        least.push(PEIR_I64_MAX);
        i = i + 1;
    }
    i = 0;
    while i < f.insts.len() {
        match f.insts.get(i).inst {
            Inst::Store(p, sv, _) => {
                if p >= 0 && p < nvals && r.vstable.get(p) == 1 && peir_is_filled_call(f, sv) {
                    var nlo: i64 = -1;
                    match peir_inst_of(f, sv) {
                        Inst::Call(_, fargs, _, _) => {
                            if fargs.len() >= 2 {
                                nlo = peir_rng_get_lo(r, fargs.get(1));
                            }
                        }
                        _ => {
                        }
                    }
                    if nlo < 0 {
                        nlo = -1;
                    }
                    if nlo < least.get(p) {
                        least.set(p, nlo);
                    }
                }
            }
            _ => {
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < nvals {
        if r.vstable.get(i) == 1 && least.get(i) != PEIR_I64_MAX {
            r.vlen.set(i, least.get(i));
        } else {
            r.vlen.set(i, -1);
        }
        i = i + 1;
    }
}

/// The stable filled Vec local that `v` is loaded from, or -1.
fn peir_filled_slot(f: &IrFunction, r: &PeirRanges, v: i64) -> i64 {
    match peir_inst_of(f, v) {
        Inst::Load(p, _) => {
            if p >= 0 && p < r.vstable.len() && r.vstable.get(p) == 1 && r.vlen.get(p) > 0 {
                return p;
            }
        }
        _ => {
        }
    }
    return -1;
}

// --- LF10: ranges through function boundaries ---------------------------------
//
// A function reached only through direct calls (the predicate of iropt.fd
// iro_conv_mark: not named by a ConstFnRef or a string, no dyn target,
// extern, C callback, runtime stand-in or machine-code root) whose every
// call passes an i64 argument in [lo, hi] has that range for the
// parameter: peir_range_ops starts the parameter's value there, so a check
// the range makes needless goes in the callee too. Whole program only (a
// `main`); two rounds, the second starting from the first's facts (each
// round's facts hold given the previous round's: the first assumes
// nothing). Filled by iropt_native and explain_checks when
// FID_IROPT_ON names `paramrange` (opt-in until a suite run agrees);
// empty otherwise, so the C path never sees it.

/// Function name -> its first entry + 1 (0: no table).
var g_peir_prm_map: i64 = 0;
/// Per entry (one per parameter, a function's entries in a row): the
/// first entry of its function, the function's parameter count, the
/// parameter's value id (-1: no fact), its range.
var g_peir_prm_fn: Vec<i64> = Vec::new();
var g_peir_prm_np: Vec<i64> = Vec::new();
var g_peir_prm_id: Vec<i64> = Vec::new();
var g_peir_prm_lo: Vec<i64> = Vec::new();
var g_peir_prm_hi: Vec<i64> = Vec::new();

/// LF10: drop every parameter fact.
pub fn peir_prm_clear() {
    g_peir_prm_map = 0;
    g_peir_prm_fn = Vec::new();
    g_peir_prm_np = Vec::new();
    g_peir_prm_id = Vec::new();
    g_peir_prm_lo = Vec::new();
    g_peir_prm_hi = Vec::new();
    g_peir_ret_map = 0;
    g_peir_ret_lo = Vec::new();
    g_peir_ret_hi = Vec::new();
}

/// LF10: is `paramrange` on (FID_IROPT_ON names it or "all", FID_IROPT_OFF
/// does not)?
pub fn peir_prm_wanted() -> bool {
    var on: str = p_getenv("FID_IROPT_ON");
    if (on as i64) == 0 || str_len(on) == 0 {
        return false;
    }
    var list: str = "," + on + ",";
    if !str_contains(list, ",paramrange,") && !str_contains(list, ",all,") {
        return false;
    }
    return !iro_named_off(p_getenv("FID_IROPT_OFF"), "paramrange");
}

/// LF10: start `f`'s i64 parameters at the ranges every call gives them.
fn peir_prm_seed(f: &IrFunction, r: &mut PeirRanges) {
    if g_peir_prm_map == 0 || !HashMap_contains(g_peir_prm_map, f.name) {
        return;
    }
    var base: i64 = HashMap_get(g_peir_prm_map, f.name) - 1;
    if base < 0 || base >= g_peir_prm_np.len() || g_peir_prm_np.get(base) != f.params.len() {
        return;
    }
    var k: i64 = 0;
    while k < f.params.len() {
        var e: i64 = base + k;
        if e >= g_peir_prm_id.len() || g_peir_prm_fn.get(e) != base {
            return;
        }
        var p: ValueIdType = f.params.get(k);
        if g_peir_prm_id.get(e) >= 0 && g_peir_prm_id.get(e) == p.id && p.id < r.lo.len() && ir_type_eq(p.ty, IrType::I64) {
            r.lo.set(p.id, g_peir_prm_lo.get(e));
            r.hi.set(p.id, g_peir_prm_hi.get(e));
        }
        k = k + 1;
    }
}

// LF10 return ranges: an internal function returning i64 whose every
// `return` gives a value in [lo, hi] has that range for the result of each
// call to it (peir_ret_seed, in peir_range_scan). Found with the parameter
// facts, in the same rounds (a round's facts hold given the previous
// round's, so recursion needs no fixpoint); FID_IROPT_OFF=retrange keeps
// the parameter facts only.

/// Function name -> its return range's entry + 1 (0: no table).
var g_peir_ret_map: i64 = 0;
var g_peir_ret_lo: Vec<i64> = Vec::new();
var g_peir_ret_hi: Vec<i64> = Vec::new();

/// LF10: are return ranges wanted with the parameter ones?
fn peir_ret_wanted() -> bool {
    return !iro_named_off(p_getenv("FID_IROPT_OFF"), "retrange");
}

/// LF10: narrow the i64 result `id` of a call to `name` to the range every
/// return of that function gives (when known).
fn peir_ret_seed(f: &IrFunction, r: &mut PeirRanges, id: i64, name: str) {
    if g_peir_ret_map == 0 || id < 0 || id >= r.lo.len() {
        return;
    }
    if !HashMap_contains(g_peir_ret_map, name) {
        return;
    }
    if !peir_rng_i64(f, id) {
        return;
    }
    var e: i64 = HashMap_get(g_peir_ret_map, name) - 1;
    if e < 0 || e >= g_peir_ret_lo.len() || e >= g_peir_ret_hi.len() {
        return;
    }
    var l: i64 = g_peir_ret_lo.get(e);
    var h: i64 = g_peir_ret_hi.get(e);
    if r.lo.get(id) > l {
        l = r.lo.get(id);
    }
    if r.hi.get(id) < h {
        h = r.hi.get(id);
    }
    peir_rng_put(r, id, l, h);
}

/// LF10: the range of what `g` returns, from the value ranges `klo`/`khi`
/// of its final scan, pushed to `out` as lo, hi. False when no return is
/// found, one returns no value, or the range is the whole of i64.
fn peir_ret_join(g: &IrFunction, klo: &Vec<i64>, khi: &Vec<i64>, out: &mut Vec<i64>) -> bool {
    var lo: i64 = PEIR_I64_MAX;
    var hi: i64 = PEIR_I64_MIN;
    var seen: bool = false;
    var b: i64 = 0;
    while b < g.blocks.len() {
        var ids: Vec<i64> = g.blocks.get(b).instructions;
        var k: i64 = 0;
        while k < ids.len() {
            match peir_inst_of(g, ids.get(k)) {
                Inst::Return(rv) => {
                    var l: i64 = PEIR_I64_MIN;
                    var h: i64 = PEIR_I64_MAX;
                    match rv {
                        OptValueId::Some(v) => {
                            if v >= 0 && v < klo.len() && v < khi.len() {
                                l = klo.get(v);
                                h = khi.get(v);
                            }
                        }
                        OptValueId::None => {
                        }
                    }
                    seen = true;
                    if l < lo {
                        lo = l;
                    }
                    if h > hi {
                        hi = h;
                    }
                }
                _ => {
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    if !seen || lo > hi {
        return false;
    }
    if lo == PEIR_I64_MIN && hi == PEIR_I64_MAX {
        return false;
    }
    out.push(lo);
    out.push(hi);
    return true;
}

fn peir_prm_has(v: Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// LF10: the names of the functions only direct calls reach (as iropt.fd
/// iro_conv_mark decides it), as a name -> 1 map.
fn peir_prm_internal(module: &IrModule) -> i64 {
    var nfn: i64 = module.functions.len();
    var names: i64 = HashMap_new();
    var fi: i64 = 0;
    while fi < nfn {
        HashMap_insert(names, module.functions.get(fi).name, 1);
        fi = fi + 1;
    }
    var taken: Vec<str> = Vec::new();
    var dtys: Vec<str> = Vec::new();
    var dmeths: Vec<str> = Vec::new();
    fi = 0;
    while fi < nfn {
        var sf: IrFunction = module.functions.get(fi).func;
        var si: i64 = 0;
        while si < sf.insts.len() {
            match sf.insts.get(si).inst {
                Inst::ConstFnRef(nm) => {
                    taken.push(nm);
                    taken.push(c_fn_target(nm));
                }
                Inst::ConstStr(cs) => {
                    if HashMap_contains(names, cs) {
                        taken.push(cs);
                    }
                }
                Inst::MakeDyn(_, dty, _) => {
                    dtys.push(dty);
                }
                Inst::DynCall(_, dm, _, _, _) => {
                    dmeths.push(dm);
                }
                _ => {
                }
            }
            si = si + 1;
        }
        fi = fi + 1;
    }
    var bad: i64 = HashMap_new();
    var i: i64 = 0;
    while i < taken.len() {
        HashMap_insert(bad, taken.get(i), 1);
        i = i + 1;
    }
    i = 0;
    while i < dtys.len() {
        var j: i64 = 0;
        while j < dmeths.len() {
            HashMap_insert(bad, dtys.get(i) + "_" + dmeths.get(j), 1);
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < module.extern_functions.len() {
        HashMap_insert(bad, module.extern_functions.get(i).name, 1);
        i = i + 1;
    }
    // WP7 (Nov 17): a function the module's data names (a global's string
    // initializer: a task entry started by name) gets any argument
    var dnamed: Vec<str> = ir_data_named_fns(module);
    i = 0;
    while i < dnamed.len() {
        HashMap_insert(bad, dnamed.get(i), 1);
        i = i + 1;
    }
    var out: i64 = HashMap_new();
    fi = 0;
    while fi < nfn {
        var ent: IrFunctionEntry = module.functions.get(fi);
        var nm2: str = ent.name;
        if nm2 != "main" && nm2 != "main_entry" && ent.func.name == nm2 && !HashMap_contains(bad, nm2) && !peir_prm_has(module.c_callbacks, nm2) && !str_starts_with(nm2, "p_") && !str_starts_with(nm2, "pe_") && !str_starts_with(nm2, "pert_") && !str_starts_with(nm2, "nat_") && !pe_runtime_alias_target(nm2) && !ir_dfe_root(nm2) && !ent.func.is_interrupt && !ent.func.is_kernel {
            HashMap_insert(out, nm2, 1);
        }
        fi = fi + 1;
    }
    return out;
}

/// LF10: fill the parameter facts for the whole program `module` (none
/// without a `main`). Returns how many parameters got a range.
pub fn peir_note_param_ranges(module: &IrModule) -> i64 {
    peir_prm_clear();
    var nfn: i64 = module.functions.len();
    var has_main: bool = false;
    var fi: i64 = 0;
    while fi < nfn {
        if module.functions.get(fi).name == "main" {
            has_main = true;
        }
        fi = fi + 1;
    }
    if !has_main || !PEIR_RANGES {
        return 0;
    }
    var internal: i64 = peir_prm_internal(module);
    var retr: bool = peir_ret_wanted();
    var facts: i64 = 0;
    var round: i64 = 0;
    while round < 2 {
        // the candidates: one entry per parameter, i64 ones open
        var cand: i64 = HashMap_new();
        var c_fn: Vec<i64> = Vec::new();
        var c_np: Vec<i64> = Vec::new();
        var c_id: Vec<i64> = Vec::new();
        var c_lo: Vec<i64> = Vec::new();
        var c_hi: Vec<i64> = Vec::new();
        // this round's return ranges (peir_ret_seed reads the last round's)
        var r_map: i64 = HashMap_new();
        var r_lo: Vec<i64> = Vec::new();
        var r_hi: Vec<i64> = Vec::new();
        fi = 0;
        while fi < nfn {
            var ent: IrFunctionEntry = module.functions.get(fi);
            var np: i64 = ent.func.params.len();
            if np > 0 && HashMap_contains(internal, ent.name) && !HashMap_contains(cand, ent.name) {
                var base: i64 = c_id.len();
                HashMap_insert(cand, ent.name, base + 1);
                var k: i64 = 0;
                while k < np {
                    var p: ValueIdType = ent.func.params.get(k);
                    c_fn.push(base);
                    c_np.push(np);
                    if ir_type_eq(p.ty, IrType::I64) && p.id >= 0 {
                        c_id.push(p.id);
                    } else {
                        c_id.push(-1);
                    }
                    // empty until a call is seen
                    c_lo.push(PEIR_I64_MAX);
                    c_hi.push(PEIR_I64_MIN);
                    k = k + 1;
                }
            }
            fi = fi + 1;
        }
        // every call: its arguments' ranges join the callee's
        fi = 0;
        while fi < nfn {
            var g: IrFunction = module.functions.get(fi).func;
            var gname: str = module.functions.get(fi).name;
            var want_ret: bool = retr && g.name == gname && ir_type_eq(g.ret_ty, IrType::I64) && HashMap_contains(internal, gname) && !HashMap_contains(r_map, gname);
            var calls: bool = false;
            var ii: i64 = 0;
            while ii < g.insts.len() && !calls {
                match g.insts.get(ii).inst {
                    Inst::Call(nm, _, _, _) => {
                        calls = HashMap_contains(cand, nm);
                    }
                    _ => {
                    }
                }
                ii = ii + 1;
            }
            if calls || want_ret {
                var nvals: i64 = g.value_metas.len() + g.insts.len() + 16;
                var dummy: Vec<i64> = peir_zeros(nvals);
                g_peir_keep_ranges = true;
                g_peir_kept_lo = Vec::new();
                g_peir_kept_hi = Vec::new();
                peir_range_ops(&g, nvals, &mut dummy);
                g_peir_keep_ranges = false;
                var klo: Vec<i64> = g_peir_kept_lo;
                var khi: Vec<i64> = g_peir_kept_hi;
                // LF10: what g returns, for the calls to it next round
                if want_ret {
                    var rj: Vec<i64> = Vec::new();
                    if peir_ret_join(&g, &klo, &khi, &mut rj) {
                        HashMap_insert(r_map, gname, r_lo.len() + 1);
                        r_lo.push(rj.get(0));
                        r_hi.push(rj.get(1));
                    }
                }
                ii = 0;
                while ii < g.insts.len() {
                    match g.insts.get(ii).inst {
                        Inst::Call(nm, args, _, _) => {
                            if HashMap_contains(cand, nm) {
                                var base2: i64 = HashMap_get(cand, nm) - 1;
                                var np2: i64 = c_np.get(base2);
                                var k2: i64 = 0;
                                while k2 < np2 {
                                    var e: i64 = base2 + k2;
                                    if c_id.get(e) >= 0 {
                                        var lo: i64 = PEIR_I64_MIN;
                                        var hi: i64 = PEIR_I64_MAX;
                                        if args.len() == np2 {
                                            var a: i64 = args.get(k2);
                                            if a >= 0 && a < klo.len() && a < khi.len() {
                                                lo = klo.get(a);
                                                hi = khi.get(a);
                                            }
                                        }
                                        if lo < c_lo.get(e) {
                                            c_lo.set(e, lo);
                                        }
                                        if hi > c_hi.get(e) {
                                            c_hi.set(e, hi);
                                        }
                                    }
                                    k2 = k2 + 1;
                                }
                            }
                        }
                        _ => {
                        }
                    }
                    ii = ii + 1;
                }
            }
            fi = fi + 1;
        }
        // a parameter no call reaches, or any value reaches, has no fact
        facts = 0;
        var e2: i64 = 0;
        while e2 < c_id.len() {
            if c_id.get(e2) >= 0 {
                var seen: bool = c_lo.get(e2) <= c_hi.get(e2);
                var bounded: bool = c_lo.get(e2) != PEIR_I64_MIN || c_hi.get(e2) != PEIR_I64_MAX;
                if seen && bounded {
                    facts = facts + 1;
                } else {
                    c_id.set(e2, -1);
                }
            }
            e2 = e2 + 1;
        }
        g_peir_prm_map = cand;
        g_peir_prm_fn = c_fn;
        g_peir_prm_np = c_np;
        g_peir_prm_id = c_id;
        g_peir_prm_lo = c_lo;
        g_peir_prm_hi = c_hi;
        g_peir_ret_map = r_map;
        g_peir_ret_lo = r_lo;
        g_peir_ret_hi = r_hi;
        facts = facts + r_lo.len();
        round = round + 1;
    }
    return facts;
}

// --- CP3: fid explain -------------------------------------------------------
// peir_unchecked_ops already computes which runtime checks a counted loop or
// the range analysis makes needless. `fid explain` surfaces that: per
// function, the checks removed and the checks still emitted.

/// The check an instruction would emit, or "" when it never emits one.
fn explain_check_kind(inst: Inst) -> str {
    match inst {
        Inst::BinOp(op, _, _, _) => {
            if op == BinOp::Add {
                return "add overflow check";
            }
            if op == BinOp::Sub {
                return "sub overflow check";
            }
            if op == BinOp::Mul {
                return "mul overflow check";
            }
            if op == BinOp::Div {
                return "div check";
            }
            if op == BinOp::Mod {
                return "mod check";
            }
            return "";
        }
        Inst::Call(n, _, _, _) => {
            if n == "Vec_get" || n == "p_vec_get" {
                return "bounds check";
            }
            if n == "Vec_set" || n == "p_vec_set" {
                return "bounds check";
            }
            return "";
        }
        _ => {
            return "";
        }
    }
    return "";
}

/// Per function: checks removed (with the proof that removed them) vs kept
/// (DB8: each with what the range analysis knew about its operands).
/// `filt` ("" = all) keeps only functions whose name contains it.
pub fn explain_checks(module: IrModule, filt: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    // LF10 (opt-in, as for emit): ranges of parameters from their calls
    if peir_prm_wanted() {
        peir_note_param_ranges(&module);
    }
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var ent: IrFunctionEntry = module.functions.get(fi);
        if str_len(filt) > 0 && str_find(ent.name, filt) < 0 {
            fi = fi + 1;
            continue;
        }
        var f: IrFunction = ent.func;
        var nvals: i64 = f.value_metas.len() + f.insts.len() + 16;
        var flags: Vec<i64> = peir_unchecked_ops(&f, nvals);
        var rflag: Vec<i64> = peir_zeros(nvals);
        g_peir_keep_ranges = true;
        g_peir_kept_lo = Vec::new();
        g_peir_kept_hi = Vec::new();
        peir_range_ops(&f, nvals, &mut rflag);
        g_peir_keep_ranges = false;
        var removed: Vec<str> = Vec::new();
        var kept: i64 = 0;
        var kept_lines: Vec<str> = Vec::new();
        var bi: i64 = 0;
        while bi < f.blocks.len() {
            var ids: Vec<i64> = f.blocks.get(bi).instructions;
            var ii: i64 = 0;
            while ii < ids.len() {
                var id: i64 = ids.get(ii);
                var kind: str = explain_check_kind(peir_inst_of(&f, id));
                if str_len(kind) > 0 {
                    var bit: i64 = 0;
                    if id >= 0 && id < flags.len() {
                        bit = flags.get(id);
                    }
                    if (bit & 1) != 0 {
                        var why: str = "counted loop";
                        if id >= 0 && id < rflag.len() && (rflag.get(id) & 1) != 0 {
                            why = "range analysis";
                        }
                        removed.push("    removed " + kind + " (v" + int_to_str(id) + ", " + why + ")");
                    } else {
                        kept = kept + 1;
                        kept_lines.push("    kept " + kind + " (v" + int_to_str(id) + ": " + explain_kept_why(&f, peir_inst_of(&f, id)) + ")");
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        if removed.len() > 0 || kept > 0 {
            out.push("fn " + ent.name + ": " + int_to_str(removed.len()) + " check(s) removed, " + int_to_str(kept) + " kept");
            var ri: i64 = 0;
            while ri < removed.len() {
                out.push(removed.get(ri));
                ri = ri + 1;
            }
            var ki: i64 = 0;
            while ki < kept_lines.len() {
                out.push(kept_lines.get(ki));
                ki = ki + 1;
            }
        }
        fi = fi + 1;
    }
    if out.len() == 0 {
        out.push("no runtime checks in this program");
    }
    peir_prm_clear();
    return out;
}

/// A rough "why on the heap" for an instruction that allocates, or "".
fn explain_alloc_kind(inst: Inst) -> str {
    match inst {
        Inst::Call(n, _, _, _) => {
            if n == "p_malloc" || n == "p_alloc" || n == "p_calloc" || n == "p_realloc" {
                return "heap allocation (runtime allocator)";
            }
            if n == "Vec_init_filled_at" {
                // header and buffer both on the stack (LF13): no heap
                // allocation
                return "";
            }
            if n == "Vec_init_typed" || n == "Vec_init_filled" {
                return "Vec header on the stack (LF13/OP27: it never leaves the function or its safe callees); buffer on the heap";
            }
            if str_starts_with(n, "Vec_new") || str_starts_with(n, "Vec_filled") || str_starts_with(n, "Vec_init") {
                return "Vec buffer (heap: resizable)";
            }
            if str_starts_with(n, "HashMap_new") {
                return "HashMap table (heap: resizable)";
            }
            if n == "Str_dup" || n == "str_concat" || n == "String_from" {
                return "string copy (heap: dynamic length)";
            }
            if str_ends_with(n, "_to_str") || n == "int_to_str" || n == "f64_to_str" || n == "f32_to_str" || n == "bool_to_str" {
                return "string result (heap: dynamic length)";
            }
            if n == "Vec_share" || n == "Vec_share_deep" || n == "Vec_clone" {
                return "Vec copy for COW sharing";
            }
            return "";
        }
        Inst::MakeDyn(_, _, _) => {
            return "trait object (heap: dyn box)";
        }
        _ => {
            return "";
        }
    }
    return "";
}

/// What a p_region_word call of the lowering means for allocations
/// (proposal 0005, FID_REGION_ARENA=1), or "" for anything else.
fn explain_region_note(f: &IrFunction, id: i64) -> str {
    match peir_inst_of(f, id) {
        Inst::Call(n, args, _, _) => {
            if n != "p_region_word" || args.len() != 2 {
                return "";
            }
            var op: i64 = 0 - 1;
            var x: i64 = 0;
            match peir_inst_of(f, args.get(0)) {
                Inst::ConstInt(c, _) => {
                    op = c;
                }
                _ => {
                }
            }
            match peir_inst_of(f, args.get(1)) {
                Inst::ConstInt(c2, _) => {
                    x = c2;
                }
                _ => {
                }
            }
            if op == 7 {
                return "region begins: what it allocates comes from its arena, released at once at its end";
            }
            if op == 8 {
                return "region ends: its arena is released at once";
            }
            if op == 3 && x < 0 {
                return "the next call may keep values where no region's end reaches (a global, a channel, a task, C code): it runs with no region current, and its region drops its values one by one";
            }
            if op == 3 {
                return "this statement keeps or changes something declared outside the region: what it keeps is copied out of the region, and the region drops its values one by one at its end";
            }
            if op == 6 {
                return "a return, `?` or break leaves the regions: the value it hands out is copied out of them";
            }
            if op == 11 {
                return "a `?` whose Result type is unknown here: its regions' memory is kept (never freed) so the error stays valid";
            }
            return "";
        }
        _ => {
        }
    }
    return "";
}

/// Per function: the instructions that allocate, and why the value is on the
/// heap. `filt` ("" = all) keeps only functions whose name contains it.
pub fn explain_allocs(module: IrModule, filt: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < module.functions.len() {
        var ent: IrFunctionEntry = module.functions.get(fi);
        if str_len(filt) == 0 || str_find(ent.name, filt) >= 0 {
            var f: IrFunction = ent.func;
            var lines: Vec<str> = Vec::new();
            var bi: i64 = 0;
            while bi < f.blocks.len() {
                var ids: Vec<i64> = f.blocks.get(bi).instructions;
                var ii: i64 = 0;
                while ii < ids.len() {
                    var id: i64 = ids.get(ii);
                    var kind: str = explain_alloc_kind(peir_inst_of(&f, id));
                    // CP4: a second owner the lowering made (proposal 0004)
                    var why: str = explain_clone_reason(&f, bi, ii);
                    if str_len(kind) == 0 && str_len(why) > 0 {
                        kind = explain_clone_label(peir_inst_of(&f, id));
                    }
                    if str_len(kind) > 0 {
                        lines.push("    v" + int_to_str(id) + ": " + kind);
                    }
                    if str_len(why) > 0 {
                        lines.push("      " + why);
                    }
                    // proposal 0005: where a region's arena starts and ends,
                    // and where what is kept is copied out of it
                    var rg: str = explain_region_note(&f, id);
                    if str_len(rg) > 0 {
                        lines.push("    v" + int_to_str(id) + ": " + rg);
                    }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
            if lines.len() > 0 {
                out.push("fn " + ent.name + ": " + int_to_str(lines.len()) + " allocation(s)");
                var li: i64 = 0;
                while li < lines.len() {
                    out.push(lines.get(li));
                    li = li + 1;
                }
            }
        }
        fi = fi + 1;
    }
    if out.len() == 0 {
        out.push("no heap allocations");
    }
    return out;
}

// --- CP4: why a clone was required --------------------------------------------

// Under proposal 0004 a value has one owner; keeping it somewhere else
// (a variable, a field, an element, a return) while its owner still holds
// it takes a second owner, which the lowering inserts as a call
// (Lowerer_rc_own_value -> Lowerer_rc_dup). `fid explain --alloc` prints,
// under each such call, the line it came from, who still owns the value,
// what keeps the new owner and what that costs.

/// The runtime function `inst` calls when it is a second owner the
/// lowering inserted, or "".
fn explain_clone_callee(inst: Inst) -> str {
    match inst {
        Inst::Call(n, _, _, _) => {
            if n == "Vec_share" || n == "HashMap_share" || n == "Str_dup" || n == "Box_dup" || str_starts_with(n, "__own_dup_") {
                return n;
            }
            if n == "Box_dup_t" {
                return "Box_dup";
            }
            return "";
        }
        _ => {
            return "";
        }
    }
    return "";
}

/// The allocation line of a second owner explain_alloc_kind does not name.
fn explain_clone_label(inst: Inst) -> str {
    var n: str = explain_clone_callee(inst);
    if n == "Box_dup" {
        return "Box owner added (a count: nothing is copied)";
    }
    if str_starts_with(n, "__own_dup_") {
        return "struct copy for a second owner";
    }
    return "";
}

/// What a second owner made by runtime function `n` costs.
fn explain_clone_cost(n: str) -> str {
    if n == "Vec_share" {
        return "a Vec share: the buffer is copied only when one of the two changes it";
    }
    if n == "HashMap_share" {
        return "a HashMap share: the table is copied only when one of the two changes it";
    }
    if n == "Str_dup" {
        return "the string's owner count goes up: no bytes are copied";
    }
    if n == "Box_dup" {
        return "the Box's owner count goes up";
    }
    return "a copy of the struct in which each field takes an owner";
}

fn explain_has_id(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// `v` under bit casts (the lowering casts a value to i64 to pass it).
fn explain_strip(f: &IrFunction, v: i64) -> i64 {
    var x: i64 = v;
    var k: i64 = 0;
    while k < 8 {
        match peir_inst_of(f, x) {
            Inst::BitCast(s, _, _) => {
                x = s;
            }
            _ => {
                return x;
            }
        }
        k = k + 1;
    }
    return x;
}

/// The name of the variable whose slot is `p`, or "".
fn explain_local_name(f: &IrFunction, p: i64) -> str {
    var i: i64 = 0;
    while i < f.locals.len() {
        if f.locals.get(i).id == p {
            return f.locals.get(i).name;
        }
        i = i + 1;
    }
    return "";
}

fn explain_is_param(f: &IrFunction, v: i64) -> bool {
    var i: i64 = 0;
    while i < f.params.len() {
        if f.params.get(i).id == v {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The source line of instruction `id` (0: none recorded).
fn explain_line(f: &IrFunction, id: i64) -> i64 {
    match IrFunction_get_meta(f, id) {
        OptValueMeta::Some(m) => {
            match m.source_line {
                OptU64::Some(l) => {
                    return l;
                }
                OptU64::None => {
                    return 0;
                }
            }
        }
        OptValueMeta::None => {
            return 0;
        }
    }
    return 0;
}

/// A place (a pointer) in words.
fn explain_place(f: &IrFunction, p0: i64) -> str {
    var p: i64 = explain_strip(f, p0);
    var nm: str = explain_local_name(f, p);
    if str_len(nm) > 0 {
        return "`" + nm + "`";
    }
    if explain_is_param(f, p) {
        return "the place a reference parameter points to";
    }
    match peir_inst_of(f, p) {
        Inst::GetFieldPtr(_, _, _) => {
            return "a struct field";
        }
        Inst::GetElemPtr(_, _, _) => {
            return "an element in memory";
        }
        Inst::GlobalAddr(g, _) => {
            return "the global `" + g + "`";
        }
        Inst::Alloca(_, _) => {
            return "a temporary";
        }
        Inst::Load(_, _) => {
            return "a place read through a pointer";
        }
        _ => {
            return "memory";
        }
    }
    return "memory";
}

/// Who still owns the value `v0` being kept, in words.
fn explain_clone_source(f: &IrFunction, v0: i64) -> str {
    var v: i64 = explain_strip(f, v0);
    if explain_is_param(f, v) {
        return "it is a parameter, and parameters are borrowed (the caller keeps its owner)";
    }
    var own: str = explain_local_name(f, v);
    if str_len(own) > 0 {
        return "`" + own + "` still owns the value";
    }
    match peir_inst_of(f, v) {
        Inst::Load(p, _) => {
            var pl: str = explain_place(f, p);
            if str_len(explain_local_name(f, explain_strip(f, p))) > 0 {
                return pl + " still owns the value (reading a variable borrows it)";
            }
            return pl + " still owns the value";
        }
        Inst::Call(n, _, _, _) => {
            if str_starts_with(n, "Vec_get") || n == "vec_ld" || str_starts_with(n, "Vec_first") || str_starts_with(n, "Vec_last") {
                return "the Vec still owns that element (`" + n + "` lends it)";
            }
            if str_starts_with(n, "HashMap_get") {
                return "the HashMap still owns that value (`" + n + "` lends it)";
            }
            return "`" + n + "` lends its result (it hands over no owner)";
        }
        _ => {
            return "the value still has another owner";
        }
    }
    return "the value still has another owner";
}

/// The value stored into `slot` by the last Store before position `k` of
/// block `b`, or -1.
fn explain_stored_into(f: &IrFunction, b: i64, k: i64, slot: i64) -> i64 {
    var ids: Vec<i64> = f.blocks.get(b).instructions;
    var j: i64 = k - 1;
    while j >= 0 {
        match peir_inst_of(f, ids.get(j)) {
            Inst::Store(p, sv, _) => {
                if explain_strip(f, p) == slot {
                    return sv;
                }
            }
            _ => {
            }
        }
        j = j - 1;
    }
    return 0 - 1;
}

/// What keeps the new owner `t0`: the first instruction after position
/// `k0` of block `b0` (in block order) that reads it, in words.
fn explain_clone_sink(f: &IrFunction, b0: i64, k0: i64, t0: i64) -> str {
    var t: i64 = t0;
    var b: i64 = b0;
    var k: i64 = k0 + 1;
    var steps: i64 = 0;
    var first_call: str = "";
    while b < f.blocks.len() && steps < 400 {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        while k < ids.len() && steps < 400 {
            var id: i64 = ids.get(k);
            var inst: Inst = peir_inst_of(f, id);
            var ops: Vec<i64> = Vec::new();
            peir_inst_operands(inst, &mut ops);
            if explain_has_id(ops, t) {
                match inst {
                    Inst::BitCast(_, _, _) => {
                        // a view of the new owner: follow it
                        t = id;
                    }
                    Inst::Store(p, sv, _) => {
                        if sv == t {
                            return "the copy is kept in " + explain_place(f, p);
                        }
                    }
                    Inst::StructCopy(d, s, _) => {
                        if s == t {
                            return "the copy is kept in " + explain_place(f, d);
                        }
                    }
                    Inst::Return(_) => {
                        return "the copy is returned to the caller";
                    }
                    Inst::Call(n, _, _, _) => {
                        if str_starts_with(n, "Vec_push") || str_starts_with(n, "Vec_set") || str_starts_with(n, "Vec_insert") {
                            return "the copy is kept as an element of a Vec (`" + n + "`)";
                        }
                        if str_starts_with(n, "HashMap_insert") || str_starts_with(n, "HashMap_set") {
                            return "the copy is kept in a HashMap (`" + n + "`)";
                        }
                        // a call may only read it (`str_len(name)` before
                        // the field is stored): look on for a place that
                        // keeps it, this call the answer if none does
                        if str_len(first_call) == 0 {
                            first_call = n;
                        }
                    }
                    _ => {
                    }
                }
            }
            k = k + 1;
            steps = steps + 1;
        }
        b = b + 1;
        k = 0;
    }
    if str_len(first_call) > 0 {
        return "the copy is handed to `" + first_call + "`, which keeps it";
    }
    return "the copy is kept";
}

/// CP4: for the instruction at index `k` of block `b`, when it is a second
/// owner the lowering inserted: "line N: clone required here because ...";
/// "" for any other instruction.
pub fn explain_clone_reason(f: &IrFunction, b: i64, k: i64) -> str {
    var ids: Vec<i64> = f.blocks.get(b).instructions;
    var id: i64 = ids.get(k);
    var inst: Inst = peir_inst_of(f, id);
    var n: str = explain_clone_callee(inst);
    if str_len(n) == 0 {
        return "";
    }
    var arg: i64 = 0 - 1;
    match inst {
        Inst::Call(_, args, _, _) => {
            // args: the environment slot, then the value
            if args.len() >= 2 {
                arg = args.get(1);
            }
        }
        _ => {
        }
    }
    if arg < 0 {
        return "";
    }
    var src: i64 = explain_strip(f, arg);
    var kept: i64 = src;
    if n == "Vec_share" || n == "HashMap_share" {
        // the new handle is the call's result
        kept = id;
    }
    if str_starts_with(n, "__own_dup_") {
        // `src` is the copy's slot, filled from the value being kept
        var from: i64 = explain_stored_into(f, b, k, src);
        if from >= 0 {
            src = from;
        }
    }
    var at: str = "";
    var line: i64 = explain_line(f, id);
    if line > 0 {
        at = "line " + int_to_str(line) + ": ";
    }
    return at + "clone required here because " + explain_clone_source(f, src) + ", and " + explain_clone_sink(f, b, k, kept) + " (" + explain_clone_cost(n) + ")";
}

// --- Shared CFG facts (competitive OP3) -------------------------------------

// Moved here from compiler/iropt.fd on Nov 15 (ME2): one CFG, dominator
// tree and loop tree for iropt, iropt_me, egraph, rules and irverify.

/// A function's control flow: block id -> index, successors and
/// predecessors by index, reverse postorder of the reachable blocks, and
/// immediate dominators (the entry's is itself; -1 unreachable).
pub struct IroCfg {
    pub n: i64,
    pub index: Vec<i64>,
    pub succs: Vec<Vec<i64>>,
    pub preds: Vec<Vec<i64>>,
    pub rpo: Vec<i64>,
    pub rpo_num: Vec<i64>,
    pub idom: Vec<i64>,
    // Dominator-tree interval numbering: a dominates b iff
    // tin[a] <= tin[b] && tout[b] <= tout[a]; -1 when unreachable.
    pub tin: Vec<i64>,
    pub tout: Vec<i64>,
    // OP3: which CFG this is, for the analyses cached with it (iro_loops):
    // a number `iro_cfg` gives each CFG it caches, the same on every copy
    // it hands back; 0 for one built uncached (FID_IROPT_OFF=cfgcache)
    pub gen: i64,
}

// One CFG per function shape (OP3). An IroCfg depends on nothing but the
// blocks' ids, in order, and the targets of their terminators: `iro_cfg`
// keeps the last one it built with that key, and a pass that asks again
// for a function whose control flow no edit has changed since gets it back
// instead of a new reverse postorder, dominator tree and intervals. Any
// edit that changes a block or an edge changes the key, so that is the
// invalidation. FID_IROPT_OFF=cfgcache builds every time (to compare);
// FID_IROPT_STATS prints how many were built and reused.
var g_iro_cfg_mode: i64 = 0;  // 0 unread, 1 cache, 2 always build
var g_iro_cfg_builds: i64 = 0;
var g_iro_cfg_reused: i64 = 0;
var g_iro_cfg_n: i64 = -1;  // -1: nothing cached
var g_iro_cfg_key: Vec<i64> = Vec::new();
var g_iro_cfg_index: Vec<i64> = Vec::new();
var g_iro_cfg_succs: Vec<Vec<i64>> = Vec::new();
var g_iro_cfg_preds: Vec<Vec<i64>> = Vec::new();
var g_iro_cfg_rpo: Vec<i64> = Vec::new();
var g_iro_cfg_rpo_num: Vec<i64> = Vec::new();
var g_iro_cfg_idom: Vec<i64> = Vec::new();
var g_iro_cfg_tin: Vec<i64> = Vec::new();
var g_iro_cfg_tout: Vec<i64> = Vec::new();
var g_iro_cfg_gen: i64 = 0;  // the `gen` of the cached CFG (0: none yet)

/// OP3: are the mid-end's analyses cached (the CFG with its dominator tree
/// and loop tree here, the use lists in iropt.fd)? false with
/// FID_IROPT_OFF=cfgcache, which turns every one of these caches off.
pub fn iro_cache_on() -> bool {
    if g_iro_cfg_mode == 0 {
        g_iro_cfg_mode = 1;
        if iro_named_off(p_getenv("FID_IROPT_OFF"), "cfgcache") {
            g_iro_cfg_mode = 2;
        }
    }
    return g_iro_cfg_mode == 1;
}

/// How many CFGs `iro_cfg` built, and how many it handed back unchanged.
pub fn iro_cfg_builds() -> i64 {
    return g_iro_cfg_builds;
}

pub fn iro_cfg_reused() -> i64 {
    return g_iro_cfg_reused;
}

/// What `iro_cfg_build` reads of `f`: the block count, then per block its
/// id and its terminator's kind and targets.
fn iro_cfg_key(f: &IrFunction) -> Vec<i64> {
    var key: Vec<i64> = Vec::new();
    var n: i64 = f.blocks.len();
    key.push(n);
    var b: i64 = 0;
    while b < n {
        key.push(f.blocks.get(b).id);
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        if ids.len() == 0 {
            key.push(0 - 1);
        } else {
            match peir_inst_of(f, ids.get(ids.len() - 1)) {
                Inst::Jump(t) => {
                    key.push(1);
                    key.push(t);
                }
                Inst::Branch(_, t, e) => {
                    key.push(2);
                    key.push(t);
                    key.push(e);
                }
                Inst::Switch(_, _, sw_t, sw_d) => {
                    var swb: Vec<i64> = switch_succ_blocks(sw_t, sw_d);
                    key.push(3);
                    key.push(swb.len());
                    var swi: i64 = 0;
                    while swi < swb.len() {
                        key.push(swb.get(swi));
                        swi = swi + 1;
                    }
                }
                _ => {
                    key.push(0);
                }
            }
        }
        b = b + 1;
    }
    return key;
}

fn iro_cfg_same_key(a: Vec<i64>, b: Vec<i64>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn iro_cfg(f: &IrFunction) -> IroCfg {
    if !iro_cache_on() {
        g_iro_cfg_builds = g_iro_cfg_builds + 1;
        return iro_cfg_build(f);
    }
    var key: Vec<i64> = iro_cfg_key(f);
    if g_iro_cfg_n >= 0 && iro_cfg_same_key(key, g_iro_cfg_key) {
        g_iro_cfg_reused = g_iro_cfg_reused + 1;
        return IroCfg {
            n: g_iro_cfg_n, index: g_iro_cfg_index, succs: g_iro_cfg_succs, preds: g_iro_cfg_preds, rpo: g_iro_cfg_rpo, rpo_num: g_iro_cfg_rpo_num, idom: g_iro_cfg_idom, tin: g_iro_cfg_tin, tout: g_iro_cfg_tout, gen: g_iro_cfg_gen
        };
    }
    var cfg: IroCfg = iro_cfg_build(f);
    g_iro_cfg_builds = g_iro_cfg_builds + 1;
    // a new CFG: what was cached with the old one (its loop tree) no
    // longer matches (iro_loops compares `gen`)
    g_iro_cfg_gen = g_iro_cfg_gen + 1;
    cfg.gen = g_iro_cfg_gen;
    g_iro_cfg_key = key;
    g_iro_cfg_n = cfg.n;
    g_iro_cfg_index = cfg.index;
    g_iro_cfg_succs = cfg.succs;
    g_iro_cfg_preds = cfg.preds;
    g_iro_cfg_rpo = cfg.rpo;
    g_iro_cfg_rpo_num = cfg.rpo_num;
    g_iro_cfg_idom = cfg.idom;
    g_iro_cfg_tin = cfg.tin;
    g_iro_cfg_tout = cfg.tout;
    return cfg;
}

/// The CFG of `f`, built (what `iro_cfg` returns when nothing is cached).
fn iro_cfg_build(f: &IrFunction) -> IroCfg {
    var n: i64 = f.blocks.len();
    var max_id: i64 = 0;
    var b: i64 = 0;
    while b < n {
        if f.blocks.get(b).id > max_id {
            max_id = f.blocks.get(b).id;
        }
        b = b + 1;
    }
    var index: Vec<i64> = Vec::new();
    while index.len() <= max_id {
        index.push(-1);
    }
    b = 0;
    while b < n {
        index.set(f.blocks.get(b).id, b);
        b = b + 1;
    }
    var succs: Vec<Vec<i64>> = Vec::new();
    var preds: Vec<Vec<i64>> = Vec::new();
    b = 0;
    while b < n {
        var s0: Vec<i64> = Vec::new();
        var p0: Vec<i64> = Vec::new();
        succs.push(s0);
        preds.push(p0);
        b = b + 1;
    }
    b = 0;
    while b < n {
        var ids: Vec<i64> = f.blocks.get(b).instructions;
        if ids.len() > 0 {
            match peir_inst_of(f, ids.get(ids.len() - 1)) {
                Inst::Jump(t) => {
                    peir_add_edge(&mut succs, &mut preds, index, b, t);
                }
                Inst::Branch(_, t, e) => {
                    peir_add_edge(&mut succs, &mut preds, index, b, t);
                    if e != t {
                        peir_add_edge(&mut succs, &mut preds, index, b, e);
                    }
                }
                Inst::Switch(_, _, sw_t, sw_d) => {
                    var swb: Vec<i64> = switch_succ_blocks(sw_t, sw_d);
                    var swi: i64 = 0;
                    while swi < swb.len() {
                        peir_add_edge(&mut succs, &mut preds, index, b, swb.get(swi));
                        swi = swi + 1;
                    }
                }
                _ => {
                }
            }
        }
        b = b + 1;
    }
    // Postorder by depth-first search from the entry
    var post: Vec<i64> = Vec::new();
    var rpo_num: Vec<i64> = Vec::new();
    var idom: Vec<i64> = Vec::new();
    b = 0;
    while b < n {
        rpo_num.push(-1);
        idom.push(-1);
        b = b + 1;
    }
    var rpo: Vec<i64> = Vec::new();
    if n == 0 {
        return IroCfg {
            n: n, index: index, succs: succs, preds: preds, rpo: rpo, rpo_num: rpo_num, idom: idom, tin: Vec::new(), tout: Vec::new(), gen: 0
        };
    }
    var state: Vec<i64> = peir_zeros(n);
    var st_b: Vec<i64> = Vec::new();
    var st_next: Vec<i64> = Vec::new();
    st_b.push(0);
    st_next.push(0);
    state.set(0, 1);
    while st_b.len() > 0 {
        var top: i64 = st_b.len() - 1;
        var cur: i64 = st_b.get(top);
        var next: i64 = st_next.get(top);
        var cs: Vec<i64> = succs.get(cur);
        if next < cs.len() {
            st_next.set(top, next + 1);
            var sx: i64 = cs.get(next);
            if state.get(sx) == 0 {
                state.set(sx, 1);
                st_b.push(sx);
                st_next.push(0);
            }
        } else {
            post.push(cur);
            st_b.pop();
            st_next.pop();
        }
    }
    var k: i64 = post.len() - 1;
    while k >= 0 {
        rpo_num.set(post.get(k), rpo.len());
        rpo.push(post.get(k));
        k = k - 1;
    }
    // Dominators (Cooper, Harvey and Kennedy): iterate in reverse postorder
    idom.set(0, 0);
    var changed: bool = true;
    while changed {
        changed = false;
        var r: i64 = 1;
        while r < rpo.len() {
            var bb: i64 = rpo.get(r);
            var ps: Vec<i64> = preds.get(bb);
            var nd: i64 = -1;
            var pi: i64 = 0;
            while pi < ps.len() {
                var p: i64 = ps.get(pi);
                if idom.get(p) >= 0 {
                    if nd < 0 {
                        nd = p;
                    } else {
                        // intersect
                        var x: i64 = p;
                        var y: i64 = nd;
                        while x != y {
                            while rpo_num.get(x) > rpo_num.get(y) {
                                x = idom.get(x);
                            }
                            while rpo_num.get(y) > rpo_num.get(x) {
                                y = idom.get(y);
                            }
                        }
                        nd = x;
                    }
                }
                pi = pi + 1;
            }
            if nd >= 0 && idom.get(bb) != nd {
                idom.set(bb, nd);
                changed = true;
            }
            r = r + 1;
        }
    }
    // Dominator-tree intervals: DFS over the tree rooted at the entry
    // (idom[0] == 0); reachable blocks get [tin, tout], others stay -1.
    var tin: Vec<i64> = Vec::new();
    var tout: Vec<i64> = Vec::new();
    var kids: Vec<Vec<i64>> = Vec::new();
    b = 0;
    while b < n {
        tin.push(-1);
        tout.push(-1);
        var k0: Vec<i64> = Vec::new();
        kids.push(k0);
        b = b + 1;
    }
    b = 0;
    while b < n {
        var p2: i64 = idom.get(b);
        if p2 >= 0 && p2 != b {
            var kl: Vec<i64> = kids.get(p2);
            kl.push(b);
            kids.set(p2, kl);
        }
        b = b + 1;
    }
    var tick: i64 = 0;
    var d_st: Vec<i64> = Vec::new();
    var d_nx: Vec<i64> = Vec::new();
    d_st.push(0);
    d_nx.push(0);
    while d_st.len() > 0 {
        var dt: i64 = d_st.len() - 1;
        var dcur: i64 = d_st.get(dt);
        var dnx: i64 = d_nx.get(dt);
        if dnx == 0 {
            tin.set(dcur, tick);
            tick = tick + 1;
        }
        var dks: Vec<i64> = kids.get(dcur);
        if dnx < dks.len() {
            d_nx.set(dt, dnx + 1);
            d_st.push(dks.get(dnx));
            d_nx.push(0);
        } else {
            tout.set(dcur, tick - 1);
            d_st.pop();
            d_nx.pop();
        }
    }
    return IroCfg {
        n: n, index: index, succs: succs, preds: preds, rpo: rpo, rpo_num: rpo_num, idom: idom, tin: tin, tout: tout, gen: 0
    };
}

/// Does block `a` dominate block `b` (indexes)? O(1): the dominator
/// tree's DFS interval of `a` covers `b`'s.
pub fn iro_dominates(cfg: &IroCfg, a: i64, b: i64) -> bool {
    if a < 0 || b < 0 || a >= cfg.tin.len() || b >= cfg.tin.len() {
        return false;
    }
    var ta: i64 = cfg.tin.get(a);
    var tb: i64 = cfg.tin.get(b);
    return ta >= 0 && tb >= 0 && ta <= tb && cfg.tout.get(b) <= cfg.tout.get(a);
}

// --- The loop tree (ME2) ------------------------------------------------------

/// The natural loops of a function, from its shared CFG (iro_cfg): a loop
/// is a header h with back edges b -> h (h dominates b); its body is h and
/// every reachable block that reaches a latch without passing through h.
/// Back edges to one header make one loop.
pub struct IroLoops {
    // the headers (block indexes), innermost first: a loop's body is
    // strictly smaller than the body of any loop around it
    pub headers: Vec<i64>,
    // per block index: the latches of the loop it heads (empty: none)
    pub latches: Vec<Vec<i64>>,
    // per block index: the header of the innermost loop holding it (-1:
    // in no loop); a header holds itself
    pub head_of: Vec<i64>,
    // per block index that heads a loop: the header of the loop around it
    // (-1: an outermost loop, or not a header)
    pub parent: Vec<i64>,
    // per block index: how many loops hold it (0 outside every loop)
    pub depth: Vec<i64>,
    // the headers in the order their first back edge is found (block
    // order, then successor order): the order iropt_me's loop passes walk
    // them in, so their output does not depend on loop nesting
    pub found: Vec<i64>,
    // per loop, in `found` order: its body as flags per block index
    // (iro_loop_body reads it; ME2: no pass derives a body itself)
    pub bodies: Vec<Vec<i64>>,
    // per block index: its loop's position in `found`/`bodies` (-1: heads none)
    pub body_at: Vec<i64>,
}

/// The body (flags per block index) of the loop headed by block index `h`
/// in `lt`; all zeros when `h` heads no loop.
pub fn iro_loop_body(lt: &IroLoops, h: i64) -> Vec<i64> {
    if h >= 0 && h < lt.body_at.len() && lt.body_at.get(h) >= 0 {
        return lt.bodies.get(lt.body_at.get(h));
    }
    return peir_zeros(lt.body_at.len());
}

// --- Bounded induction variables (OP10) ----------------------------------------

/// The i64 constant `id` holds (any integer ConstInt), into `out[0]`.
fn iro_iv_const(f: &IrFunction, id: i64, out: &mut Vec<i64>) -> bool {
    match peir_inst_of(f, id) {
        Inst::ConstInt(v, _) => {
            out.set(0, v);
            return true;
        }
        _ => {
        }
    }
    return false;
}

/// Is `id` a Load of local `loc` that block index `bi` holds?
fn iro_iv_load_in(f: &IrFunction, id: i64, loc: i64, bi: i64) -> bool {
    match peir_inst_of(f, id) {
        Inst::Load(p, _) => {
            if p != loc {
                return false;
            }
            var ids: Vec<i64> = f.blocks.get(bi).instructions;
            var k: i64 = 0;
            while k < ids.len() {
                if ids.get(k) == id {
                    return true;
                }
                k = k + 1;
            }
        }
        _ => {
        }
    }
    return false;
}

/// OP10: may a shadow local j, set to L * c at the end of the preheader
/// `pre` and bumped by c * d right after the loop's one store to L
/// (`L = L + d`, in block index `sb`), be kept in code whose arithmetic
/// traps on overflow? It may when no value j ever holds overflows: L's
/// value on entry is a constant c0 (the last store to it on the way to
/// `pre`), the header `head` tests L against a constant K on its way out
/// (`L < K`, `L <= K` for d > 0; `>`, `>=` for d < 0, either branch order)
/// before any store to L in the iteration (the store is not in the
/// header), so L takes values between c0 and K -/+ 1 + d only; and the
/// magnitudes (c0, K at most 2^40, c and d at most 2^20) keep L * c for
/// each of them, c * d, and the original products, inside i64. Then the
/// shadow never traps, and neither did the multiply it replaces on any
/// iteration that ran: the shadow computes nothing the program could not.
pub fn iro_iv_bounded(f: &IrFunction, cfg: &IroCfg, body: Vec<i64>, head: i64, pre: i64, loc: i64, d: i64, sb: i64, c: i64) -> bool {
    var lim: i64 = 1099511627776;
    var small: i64 = 1048576;
    if d == 0 || d > small || d < 0 - small || c > small || c < 0 - small {
        return false;
    }
    if sb == head || head < 0 || head >= f.blocks.len() || pre < 0 {
        return false;
    }
    // L's one store runs once per pass through the header: no cycle of the
    // body goes through its block `sb` without `head` (an inner loop that
    // steps L would take it past the bound between two of the tests)
    if sb < 0 || sb >= cfg.n || sb >= cfg.succs.len() || sb >= body.len() {
        return false;
    }
    var seen: Vec<i64> = peir_zeros(cfg.n + 1);
    var work: Vec<i64> = Vec::new();
    var s0: Vec<i64> = cfg.succs.get(sb);
    var w0: i64 = 0;
    while w0 < s0.len() {
        work.push(s0.get(w0));
        w0 = w0 + 1;
    }
    while work.len() > 0 {
        var x: i64 = work.pop();
        if x == sb {
            return false;
        }
        if x >= 0 && x < cfg.n && x < body.len() && x != head && body.get(x) == 1 && seen.get(x) == 0 {
            seen.set(x, 1);
            var xs: Vec<i64> = cfg.succs.get(x);
            var w1: i64 = 0;
            while w1 < xs.len() {
                work.push(xs.get(w1));
                w1 = w1 + 1;
            }
        }
    }
    var hids: Vec<i64> = f.blocks.get(head).instructions;
    if hids.len() == 0 {
        return false;
    }
    var cond: i64 = -1;
    var stay_true: bool = false;
    match peir_inst_of(f, hids.get(hids.len() - 1)) {
        Inst::Branch(cv, t, e) => {
            if t >= 0 && t < cfg.index.len() && e >= 0 && e < cfg.index.len() {
                var ti: i64 = cfg.index.get(t);
                var ei: i64 = cfg.index.get(e);
                if ti >= 0 && ei >= 0 {
                    var in_t: bool = body.get(ti) == 1;
                    var in_e: bool = body.get(ei) == 1;
                    if in_t != in_e {
                        cond = cv;
                        stay_true = in_t;
                    }
                }
            }
        }
        _ => {
        }
    }
    if cond < 0 {
        return false;
    }
    // the test as `L op K`, op what keeps the loop going: 0 <, 1 <=, 2 >, 3 >=
    var op: i64 = -1;
    var kk: Vec<i64> = Vec::new();
    kk.push(0);
    match peir_inst_of(f, cond) {
        Inst::BinOp(bop, a, b, _) => {
            var o: i64 = -1;
            if binop_eq(bop, BinOp::Lt) {
                o = 0;
            } else if binop_eq(bop, BinOp::LtEq) {
                o = 1;
            } else if binop_eq(bop, BinOp::Gt) {
                o = 2;
            } else if binop_eq(bop, BinOp::GtEq) {
                o = 3;
            }
            if o >= 0 {
                if iro_iv_load_in(f, a, loc, head) && iro_iv_const(f, b, &mut kk) {
                    op = o;
                } else if iro_iv_load_in(f, b, loc, head) && iro_iv_const(f, a, &mut kk) {
                    // K op L is L op' K
                    if o == 0 {
                        op = 2;
                    } else if o == 1 {
                        op = 3;
                    } else if o == 2 {
                        op = 0;
                    } else {
                        op = 1;
                    }
                }
            }
        }
        _ => {
        }
    }
    if op < 0 {
        return false;
    }
    if !stay_true {
        // the loop goes on when the test fails: !(L < K) is L >= K, ...
        if op == 0 {
            op = 3;
        } else if op == 1 {
            op = 2;
        } else if op == 2 {
            op = 1;
        } else {
            op = 0;
        }
    }
    var k: i64 = kk.get(0);
    if k > lim || k < 0 - lim {
        return false;
    }
    // L on entry: the last store to it on the one way into `pre`
    var c0: i64 = 0;
    var found: bool = false;
    var scan: i64 = pre;
    var hops: i64 = 0;
    while scan >= 0 && hops < 4 && !found {
        var sids: Vec<i64> = f.blocks.get(scan).instructions;
        var z: i64 = sids.len() - 1;
        while z >= 0 && !found {
            match peir_inst_of(f, sids.get(z)) {
                Inst::Store(p, sv, _) => {
                    if p == loc {
                        if !iro_iv_const(f, sv, &mut kk) {
                            return false;
                        }
                        c0 = kk.get(0);
                        found = true;
                    }
                }
                _ => {
                }
            }
            z = z - 1;
        }
        if !found {
            if scan == 0 || scan >= cfg.preds.len() {
                return false;
            }
            var sps: Vec<i64> = cfg.preds.get(scan);
            if sps.len() != 1 {
                return false;
            }
            scan = sps.get(0);
            hops = hops + 1;
        }
    }
    if !found || c0 > lim || c0 < 0 - lim {
        return false;
    }
    // L stays between c0 and the last value the test lets through, one
    // step on: with these magnitudes every L * c fits
    if d > 0 {
        return op == 0 || op == 1;
    }
    return op == 2 || op == 3;
}

// OP3: the loop tree is cached with the CFG it was found on. It reads
// nothing but the CFG, so while `iro_cfg` keeps handing back the same CFG
// (same `gen`: no edit changed a block or an edge) the loop tree is the
// same too, and the loop passes (licm, iv, the iropt_me loop passes, the
// counted-loop facts, eg_place) stop finding it again. A CFG built
// uncached (gen 0, FID_IROPT_OFF=cfgcache) gets its loop tree built.
var g_iro_loops_gen: i64 = 0;  // the gen of the CFG cached below (0: none)
var g_iro_loops_builds: i64 = 0;
var g_iro_loops_reused: i64 = 0;
var g_iro_loops_headers: Vec<i64> = Vec::new();
var g_iro_loops_latches: Vec<Vec<i64>> = Vec::new();
var g_iro_loops_head_of: Vec<i64> = Vec::new();
var g_iro_loops_parent: Vec<i64> = Vec::new();
var g_iro_loops_depth: Vec<i64> = Vec::new();
var g_iro_loops_found: Vec<i64> = Vec::new();
var g_iro_loops_bodies: Vec<Vec<i64>> = Vec::new();
var g_iro_loops_body_at: Vec<i64> = Vec::new();

/// How many loop trees `iro_loops` found, and how many it handed back from
/// its cache (FID_IROPT_STATS).
pub fn iro_loops_builds() -> i64 {
    return g_iro_loops_builds;
}

pub fn iro_loops_reused() -> i64 {
    return g_iro_loops_reused;
}

/// The loop tree of the function `cfg` describes. Computed on demand (it
/// costs one walk per loop), so passes without loops do not pay for it;
/// the last one found is kept with its CFG's `gen` (OP3).
pub fn iro_loops(cfg: &IroCfg) -> IroLoops {
    if cfg.gen > 0 && cfg.gen == g_iro_loops_gen {
        g_iro_loops_reused = g_iro_loops_reused + 1;
        return IroLoops {
            headers: g_iro_loops_headers, latches: g_iro_loops_latches, head_of: g_iro_loops_head_of, parent: g_iro_loops_parent, depth: g_iro_loops_depth, found: g_iro_loops_found, bodies: g_iro_loops_bodies, body_at: g_iro_loops_body_at
        };
    }
    var lt: IroLoops = iro_loops_build(cfg);
    g_iro_loops_builds = g_iro_loops_builds + 1;
    if cfg.gen > 0 {
        g_iro_loops_gen = cfg.gen;
        g_iro_loops_headers = lt.headers;
        g_iro_loops_latches = lt.latches;
        g_iro_loops_head_of = lt.head_of;
        g_iro_loops_parent = lt.parent;
        g_iro_loops_depth = lt.depth;
        g_iro_loops_found = lt.found;
        g_iro_loops_bodies = lt.bodies;
        g_iro_loops_body_at = lt.body_at;
    }
    return lt;
}

/// The loop tree of `cfg`, found (what `iro_loops` returns uncached).
fn iro_loops_build(cfg: &IroCfg) -> IroLoops {
    var n: i64 = cfg.n;
    var latches: Vec<Vec<i64>> = Vec::new();
    var head_of: Vec<i64> = Vec::new();
    var parent: Vec<i64> = Vec::new();
    var depth: Vec<i64> = Vec::new();
    var b: i64 = 0;
    while b < n {
        var l0: Vec<i64> = Vec::new();
        latches.push(l0);
        head_of.push(0 - 1);
        parent.push(0 - 1);
        depth.push(0);
        b = b + 1;
    }
    // Back edges b -> h, h dominating b; `cand` the headers in the order
    // first found
    var cand: Vec<i64> = Vec::new();
    b = 0;
    while b < n {
        var ss: Vec<i64> = cfg.succs.get(b);
        var k: i64 = 0;
        while k < ss.len() {
            var h: i64 = ss.get(k);
            if h >= 0 && h < n && iro_dominates(cfg, h, b) {
                var ll: Vec<i64> = latches.get(h);
                if ll.len() == 0 {
                    cand.push(h);
                }
                ll.push(b);
                latches.set(h, ll);
            }
            k = k + 1;
        }
        b = b + 1;
    }
    var headers: Vec<i64> = Vec::new();
    var body_at: Vec<i64> = Vec::new();
    b = 0;
    while b < n {
        body_at.push(0 - 1);
        b = b + 1;
    }
    var bodies: Vec<Vec<i64>> = Vec::new();
    if cand.len() == 0 {
        return IroLoops {
            headers: headers, latches: latches, head_of: head_of, parent: parent, depth: depth, found: cand, bodies: bodies, body_at: body_at
        };
    }
    // The body of each loop: member flags, and how many blocks
    var sizes: Vec<i64> = Vec::new();
    var ci: i64 = 0;
    while ci < cand.len() {
        var hc: i64 = cand.get(ci);
        var body: Vec<i64> = peir_zeros(n);
        body.set(hc, 1);
        var size: i64 = 1;
        var work: Vec<i64> = Vec::new();
        var lat: Vec<i64> = latches.get(hc);
        var li: i64 = 0;
        while li < lat.len() {
            work.push(lat.get(li));
            li = li + 1;
        }
        while work.len() > 0 {
            var x: i64 = work.pop();
            if body.get(x) == 0 && cfg.rpo_num.get(x) >= 0 {
                body.set(x, 1);
                size = size + 1;
                var ps: Vec<i64> = cfg.preds.get(x);
                var pk: i64 = 0;
                while pk < ps.len() {
                    work.push(ps.get(pk));
                    pk = pk + 1;
                }
            }
        }
        bodies.push(body);
        sizes.push(size);
        body_at.set(hc, ci);
        ci = ci + 1;
    }
    // Innermost first: candidates by body size (insertion sort of indexes;
    // equal sizes keep the order they were found in)
    var order: Vec<i64> = Vec::new();
    ci = 0;
    while ci < cand.len() {
        var at: i64 = order.len();
        while at > 0 && sizes.get(order.get(at - 1)) > sizes.get(ci) {
            at = at - 1;
        }
        order.insert(at, ci);
        ci = ci + 1;
    }
    var oi: i64 = 0;
    while oi < order.len() {
        headers.push(cand.get(order.get(oi)));
        oi = oi + 1;
    }
    // Per block: the first (innermost) loop holding it, and how many do;
    // per header: the first loop after its own that holds it
    b = 0;
    while b < n {
        oi = 0;
        while oi < order.len() {
            var cx: i64 = order.get(oi);
            if bodies.get(cx).get(b) == 1 {
                var hx: i64 = cand.get(cx);
                if head_of.get(b) < 0 {
                    head_of.set(b, hx);
                } else if hx != b && latches.get(b).len() > 0 && parent.get(b) < 0 {
                    parent.set(b, hx);
                }
                depth.set(b, depth.get(b) + 1);
            }
            oi = oi + 1;
        }
        b = b + 1;
    }
    return IroLoops {
        headers: headers, latches: latches, head_of: head_of, parent: parent, depth: depth, found: cand, bodies: bodies, body_at: body_at
    };
}

// --- Pass switches from the command line (ME5) ----------------------------

/// The passes `--no-pass=a,b` (or `--no-pass a,b`) names on the command
/// line, as ",a,b" to append to an off list (FID_IROPT_OFF, FID_NAT_OFF);
/// "" when there is none. iropt, iropt_me and the e-graph read it where
/// they read those variables, so the flag works for every command that
/// reaches the mid-end with no parsing in main.fd (its flag lookups skip
/// what they do not know).
pub fn iro_cli_off() -> str {
    var out: str = "";
    // SP18: argv_count/argv_at read a `fid serve` request's words while
    // one is being served, the process's argv otherwise
    var n: i64 = argv_count();
    var i: i64 = 1;
    while i < n {
        var a: str = argv_at(i);
        if (a as i64) != 0 {
            if str_starts_with(a, "--no-pass=") {
                out = out + "," + str_slice(a, 10, str_len(a));
            } else if a == "--no-pass" && i + 1 < n {
                out = out + "," + argv_at(i + 1);
            } else if a == "--size" {
                // TG19: code size first: no loop unrolling (iropt_me ME24)
                out = out + ",unroll";
            }
        }
        i = i + 1;
    }
    return out;
}

/// Is pass `name` named by the off list `env` (a comma list, may be null or
/// empty) or by `--no-pass`?
pub fn iro_named_off(env: str, name: str) -> bool {
    var off: str = iro_cli_off();
    if (env as i64) != 0 && str_len(env) > 0 {
        off = env + off;
    }
    if str_len(off) == 0 {
        return false;
    }
    return str_contains("," + off + ",", "," + name + ",");
}
