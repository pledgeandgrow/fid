// pdb.fd — program databases (PDB, MSF 7.00) for Windows images: what
// Visual Studio, WinDbg and dbghelp read (own-backend roadmap DB3, release
// N9). A debug build's image (`fid emit -g`: pe_ir, and `--nat`) already
// carries COFF symbols and DWARF sections, which gdb, lldb and llvm tools
// read; Microsoft's debuggers read neither, only a PDB that the image names
// in its debug directory.
//
// pdb_attach is the one call a backend makes, after its image is complete
// (sections, DWARF and COFF symbol table written):
//   1. pdb_guid: the PDB's GUID, a hash of the image (the same input gives
//      the same image and the same PDB);
//   2. pdb_add_debug_directory: a `.buildid` section with an
//      IMAGE_DEBUG_DIRECTORY entry of type CODEVIEW and its RSDS record
//      (GUID, age, the PDB's path), data directory 6 pointing at it; the
//      COFF symbol table moves after the new section;
//   3. pdb_build: the PDB itself, written to g_pdb_out (pdb_setup: the
//      output path with .exe -> .pdb) or $FID_PDB_OUT.
// No path (pdb_setup not called, FID_PDB=0): the image comes back as it is.
//
// The PDB (streams of an MSF container, block size 4096):
//   0  old directory (empty)
//   1  PDB info: version VC70, signature, age, GUID, the named stream map
//      ("/names" -> 5) and the feature VC140
//   2  TPI: the variables' types (DB4, below: LF_STRUCTURE, LF_FIELDLIST,
//      LF_POINTER; base types are simple types); 4 IPI: header only
//      (functions have type 0, as assembly procedures do)
//   3  DBI: one module (the input file) with its section contribution
//      (.text), the section map, the file info (the module's source files),
//      an empty EC name table and the optional debug header naming the
//      section header stream
//   5  /names: the source file names (string table, hash version 1)
//   6  the module's symbols: S_OBJNAME, S_COMPILE3, then per function
//      S_GPROC32, its variables and lexical blocks (DB4, below), S_END;
//      and its C13 lines: DEBUG_S_FILECHKSMS (one
//      entry per file, no checksum) and a DEBUG_S_LINES subsection per
//      function, one block per run of rows of the same file
//   7  globals: S_PROCREF for each function (GSI hash)
//   8  publics: S_PUB32 for each function and each other COFF function
//      symbol of the image (runtime stubs, primitives, thunks), GSI hash
//      and address map
//   9  the symbol records of 7 and 8
//   10 the image's section headers (dbghelp maps section:offset with them)
//   11 the TPI hash stream, when the TPI has type records (DB4)
// The formats are those LLVM documents (llvm/docs/PDB) and lld writes.
//
// Rows are those the backends already record for DWARF: [code offset,
// line, 2 * file + end?] (nat_ir.fd; pe_ir.fd's rows are file 0), offsets
// counted from the start of .text (section 1). Checks:
// tests/nattools/pdb_unit.fd (the writer on a real image, run by
// tests/nattools/pe_pdb_check.py, which reads the PDB with its own MSF
// reader, with dbghelp on Windows and with llvm-pdbutil when present).

module compiler::pdb;
use core;
use vec;
use string;

/// The PDB pdb_attach writes ("" = none): pdb_setup sets it.
pub var g_pdb_out: str = "";

pub const PDB_BLOCK: i64 = 4096;
const PDB_S_END: i64 = 0x0006;
const PDB_S_OBJNAME: i64 = 0x1101;
const PDB_S_PUB32: i64 = 0x110E;
const PDB_S_GPROC32: i64 = 0x1110;
const PDB_S_PROCREF: i64 = 0x1125;
const PDB_S_COMPILE3: i64 = 0x113C;
const PDB_DEBUG_S_LINES: i64 = 0xF2;
const PDB_DEBUG_S_FILECHKSMS: i64 = 0xF4;
const PDB_IPHR_HASH: i64 = 4096;
const PDB_STREAM_NAMES: i64 = 5;
const PDB_STREAM_MODULE: i64 = 6;
const PDB_STREAM_GLOBALS: i64 = 7;
const PDB_STREAM_PUBLICS: i64 = 8;
const PDB_STREAM_SYMRECS: i64 = 9;
const PDB_STREAM_SECHDR: i64 = 10;

// --- Bytes ------------------------------------------------------------------

fn pdb_u8(out: &mut Vec<i64>, v: i64) {
    out.push(v & 255);
}

fn pdb_u16(out: &mut Vec<i64>, v: i64) {
    out.push(v & 255);
    out.push((v >> 8) & 255);
}

fn pdb_u32(out: &mut Vec<i64>, v: i64) {
    pdb_u16(out, v & 0xFFFF);
    pdb_u16(out, (v >> 16) & 0xFFFF);
}

fn pdb_set_u16(out: &mut Vec<i64>, at: i64, v: i64) {
    out.set(at, v & 255);
    out.set(at + 1, (v >> 8) & 255);
}

fn pdb_set_u32(out: &mut Vec<i64>, at: i64, v: i64) {
    pdb_set_u16(out, at, v & 0xFFFF);
    pdb_set_u16(out, at + 2, (v >> 16) & 0xFFFF);
}

pub fn pdb_get_u16(b: &Vec<i64>, at: i64) -> i64 {
    return (b.get(at) & 255) | ((b.get(at + 1) & 255) << 8);
}

pub fn pdb_get_u32(b: &Vec<i64>, at: i64) -> i64 {
    return pdb_get_u16(b, at) | (pdb_get_u16(b, at + 2) << 16);
}

fn pdb_cstr(out: &mut Vec<i64>, s: str) {
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i < n {
        out.push(str_byte_at(s, i) & 255);
        i = i + 1;
    }
    out.push(0);
}

fn pdb_pad4(out: &mut Vec<i64>) {
    while out.len() % 4 != 0 {
        out.push(0);
    }
}

fn pdb_append(out: &mut Vec<i64>, src: &Vec<i64>) {
    var i: i64 = 0;
    var n: i64 = src.len();
    while i < n {
        out.push(src.get(i));
        i = i + 1;
    }
}

fn pdb_align(v: i64, a: i64) -> i64 {
    return ((v + a - 1) / a) * a;
}

/// A CodeView symbol record: u16 length (after itself), u16 kind; the
/// caller writes the fields, then pdb_rec_end pads it to 4 bytes with zeros
/// and sets the length. Returns where the record starts.
fn pdb_rec_begin(out: &mut Vec<i64>, kind: i64) -> i64 {
    var at: i64 = out.len();
    pdb_u16(out, 0);
    pdb_u16(out, kind);
    return at;
}

fn pdb_rec_end(out: &mut Vec<i64>, at: i64) {
    pdb_pad4(out);
    pdb_set_u16(out, at, out.len() - at - 2);
}

// --- Hashes -----------------------------------------------------------------

/// hashStringV1 of the PDB reference implementation (LHashPbCb): the names
/// map of the info stream, the string tables and the GSI buckets use it.
pub fn pdb_hash_v1(s: str) -> i64 {
    var n: i64 = str_len(s);
    var r: i64 = 0;
    var i: i64 = 0;
    while i + 4 <= n {
        r = r ^ ((str_byte_at(s, i) & 255) | ((str_byte_at(s, i + 1) & 255) << 8) | ((str_byte_at(s, i + 2) & 255) << 16) | ((str_byte_at(s, i + 3) & 255) << 24));
        i = i + 4;
    }
    if n - i >= 2 {
        r = r ^ ((str_byte_at(s, i) & 255) | ((str_byte_at(s, i + 1) & 255) << 8));
        i = i + 2;
    }
    if n - i == 1 {
        r = r ^ (str_byte_at(s, i) & 255);
    }
    r = r | 0x20202020;
    r = r ^ (r >> 11);
    return (r ^ (r >> 16)) & 0xFFFFFFFF;
}

/// The PDB's GUID (16 bytes, a version-4 layout): four FNV-1a lanes over
/// the image, so the same image always names the same PDB.
pub fn pdb_guid(pe: &Vec<i64>) -> Vec<i64> {
    var h0: i64 = 0x811C9DC5;
    var h1: i64 = 0x050C5D1F;
    var h2: i64 = 0x2E5BE3A1;
    var h3: i64 = 0x1B873593;
    var i: i64 = 0;
    var n: i64 = pe.len();
    while i < n {
        var b: i64 = pe.get(i) & 255;
        h0 = ((h0 ^ b) * 16777619) & 0xFFFFFFFF;
        h1 = ((h1 ^ ((b + 0x5B) & 255)) * 16777619) & 0xFFFFFFFF;
        h2 = ((h2 ^ ((b + 0xA7) & 255)) * 16777619) & 0xFFFFFFFF;
        h3 = ((h3 ^ ((b + 0x3D) & 255)) * 16777619) & 0xFFFFFFFF;
        i = i + 1;
    }
    h3 = ((h3 ^ (n & 0xFFFFFFFF)) * 16777619) & 0xFFFFFFFF;
    var g: Vec<i64> = Vec::new();
    pdb_u32(&mut g, h0);
    pdb_u32(&mut g, h1);
    pdb_u32(&mut g, h2);
    pdb_u32(&mut g, h3);
    g.set(7, (g.get(7) & 0x0F) | 0x40);
    g.set(8, (g.get(8) & 0x3F) | 0x80);
    return g;
}

/// The GUID as Windows prints it ({XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
/// without braces, upper case): what symbol servers and dumpbin show.
pub fn pdb_guid_text(g: &Vec<i64>) -> str {
    var out: str = "";
    out = out + pdb_hex(pdb_get_u32(g, 0), 8) + "-" + pdb_hex(pdb_get_u16(g, 4), 4) + "-" + pdb_hex(pdb_get_u16(g, 6), 4) + "-";
    var i: i64 = 8;
    while i < 16 {
        if i == 10 {
            out = out + "-";
        }
        out = out + pdb_hex(g.get(i), 2);
        i = i + 1;
    }
    return out;
}

fn pdb_hex(v: i64, digits: i64) -> str {
    var out: str = "";
    var d: i64 = digits - 1;
    while d >= 0 {
        var x: i64 = (v >> (4 * d)) & 15;
        if x < 10 {
            out = out + char_to_str(48 + x);
        } else {
            out = out + char_to_str(55 + x);
        }
        d = d - 1;
    }
    return out;
}

// --- Setup and the backends' call --------------------------------------------

/// The PDB beside `exe`: its name with ".exe" replaced by ".pdb" (or
/// ".pdb" added).
pub fn pdb_path_for(exe: str) -> str {
    var n: i64 = str_len(exe);
    if n > 4 && str_to_lower(str_slice(exe, n - 4, n)) == ".exe" {
        return str_slice(exe, 0, n - 4) + ".pdb";
    }
    return exe + ".pdb";
}

/// A debug build's driver (main.fd) calls this with the output path before
/// the backend runs: pdb_attach then writes the PDB beside it. FID_PDB=0
/// writes none.
pub fn pdb_setup(output: str) {
    match env_var("FID_PDB") {
        Option::Some(v) => {
            if v == "0" {
                g_pdb_out = "";
                return;
            }
        }
        Option::None => {
        }
    }
    g_pdb_out = pdb_path_for(output);
}

/// Where pdb_attach writes: g_pdb_out, else $FID_PDB_OUT, else "".
pub fn pdb_out_path() -> str {
    if g_pdb_out != "" {
        return g_pdb_out;
    }
    match env_var("FID_PDB_OUT") {
        Option::Some(v) => {
            return v;
        }
        Option::None => {
        }
    }
    return "";
}

/// The backends' call (pe_ir.fd after the COFF symbols, nat_enc.fd
/// nat_pe_debug): `pe` is the finished image; the functions `names` span
/// [starts, ends) of .text; `rows` are their line rows (see the top of the
/// file) against `files` (empty: just `file`). Writes the PDB to
/// pdb_out_path() and returns the image with its debug directory; with no
/// path, no functions, or an image pdb_add_debug_directory cannot extend,
/// returns `pe` as it is (and writes nothing).
pub fn pdb_attach(pe: Vec<i64>, names: Vec<str>, starts: Vec<i64>, ends: Vec<i64>, rows: Vec<i64>, files: Vec<str>, file: str) -> Vec<i64> {
    var path: str = pdb_out_path();
    if path == "" || names.len() == 0 || names.len() != starts.len() || names.len() != ends.len() {
        return pe;
    }
    var guid: Vec<i64> = pdb_guid(&pe);
    var out: Vec<i64> = pdb_add_debug_directory(&pe, &guid, 1, path);
    if out.len() == 0 {
        return pe;
    }
    var bytes: Vec<i64> = pdb_build(&out, &names, &starts, &ends, &rows, &files, file, &guid, 1);
    p_file_write_vec(path, bytes);
    return out;
}

// --- The image's debug directory ---------------------------------------------

/// Where the PE headers of `pe` are: [e_lfanew, NumberOfSections, the
/// optional header, the section table], or an empty Vec when `pe` is not a
/// PE32+ image.
fn pdb_pe_layout(pe: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if pe.len() < 0x200 || pe.get(0) != 0x4D || pe.get(1) != 0x5A {
        return out;
    }
    var e: i64 = pdb_get_u32(pe, 0x3C);
    if e <= 0 || e + 24 + 240 > pe.len() || pe.get(e) != 0x50 || pe.get(e + 1) != 0x45 || pe.get(e + 2) != 0 || pe.get(e + 3) != 0 {
        return out;
    }
    var opt: i64 = e + 24;
    if pdb_get_u16(pe, opt) != 0x20B {
        return out;
    }
    out.push(e);
    out.push(pdb_get_u16(pe, e + 6));
    out.push(opt);
    out.push(opt + pdb_get_u16(pe, e + 20));
    return out;
}

/// `pe` (a PE32+ image) with a `.buildid` section after its last one that
/// holds an IMAGE_DEBUG_DIRECTORY entry (type 2, CODEVIEW) and the RSDS
/// record it points at: "RSDS", `guid`, `age`, `path` NUL-ended. Data
/// directory 6 (Debug) points at the entry. The section gets the next
/// aligned address and file space (INITIALIZED_DATA | MEM_READ);
/// NumberOfSections, SizeOfImage and SizeOfInitializedData cover it. A COFF
/// symbol table after the sections moves after the new one (its pointer
/// follows). Empty when `pe` is not a PE32+ image, has fewer than 7 data
/// directories, or has no room for another section header.
pub fn pdb_add_debug_directory(pe: &Vec<i64>, guid: &Vec<i64>, age: i64, path: str) -> Vec<i64> {
    var none: Vec<i64> = Vec::new();
    var lay: Vec<i64> = pdb_pe_layout(pe);
    if lay.len() == 0 || guid.len() != 16 {
        return none;
    }
    var e: i64 = lay.get(0);
    var nsec: i64 = lay.get(1);
    var opt: i64 = lay.get(2);
    var sect: i64 = lay.get(3);
    var hdr_size: i64 = pdb_get_u32(pe, opt + 60);
    var file_align: i64 = pdb_get_u32(pe, opt + 36);
    var sect_align: i64 = pdb_get_u32(pe, opt + 32);
    if pdb_get_u32(pe, opt + 108) < 7 || sect + 40 * (nsec + 1) > hdr_size || file_align <= 0 || sect_align <= 0 {
        return none;
    }
    // the first free address, right after the last section (the loader
    // wants the sections contiguous in memory)
    var next_rva: i64 = 0;
    var s: i64 = 0;
    while s < nsec {
        var h: i64 = sect + 40 * s;
        var vs: i64 = pdb_get_u32(pe, h + 8);
        if vs == 0 {
            vs = pdb_get_u32(pe, h + 16);
        }
        var top: i64 = pdb_align(pdb_get_u32(pe, h + 12) + vs, sect_align);
        if top > next_rva {
            next_rva = top;
        }
        s = s + 1;
    }
    var symptr: i64 = pdb_get_u32(pe, e + 12);
    var body_end: i64 = pe.len();
    if symptr > 0 && symptr <= pe.len() {
        body_end = symptr;
    }
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < body_end {
        out.push(pe.get(i));
        i = i + 1;
    }
    while out.len() % file_align != 0 {
        out.push(0);
    }
    var raw_off: i64 = out.len();
    // the section: the directory entry, then the RSDS record
    var data: Vec<i64> = Vec::new();
    pdb_u32(&mut data, 0);
    // Characteristics
    pdb_u32(&mut data, 0);
    // TimeDateStamp (none: reproducible)
    pdb_u16(&mut data, 0);
    pdb_u16(&mut data, 0);
    // version
    pdb_u32(&mut data, 2);
    // IMAGE_DEBUG_TYPE_CODEVIEW
    var rsds: Vec<i64> = Vec::new();
    rsds.push(0x52);
    rsds.push(0x53);
    rsds.push(0x44);
    rsds.push(0x53);
    pdb_append(&mut rsds, guid);
    pdb_u32(&mut rsds, age);
    pdb_cstr(&mut rsds, path);
    pdb_u32(&mut data, rsds.len());
    // SizeOfData
    pdb_u32(&mut data, next_rva + 28);
    // AddressOfRawData
    pdb_u32(&mut data, raw_off + 28);
    // PointerToRawData
    pdb_append(&mut data, &rsds);
    var raw: i64 = pdb_align(data.len(), file_align);
    pdb_append(&mut out, &data);
    while out.len() < raw_off + raw {
        out.push(0);
    }
    // the section header
    var sh: i64 = sect + 40 * nsec;
    var name: str = ".buildid";
    var k: i64 = 0;
    while k < 8 {
        out.set(sh + k, str_byte_at(name, k) & 255);
        k = k + 1;
    }
    pdb_set_u32(&mut out, sh + 8, data.len());
    pdb_set_u32(&mut out, sh + 12, next_rva);
    pdb_set_u32(&mut out, sh + 16, raw);
    pdb_set_u32(&mut out, sh + 20, raw_off);
    pdb_set_u32(&mut out, sh + 24, 0);
    pdb_set_u32(&mut out, sh + 28, 0);
    pdb_set_u32(&mut out, sh + 32, 0);
    pdb_set_u32(&mut out, sh + 36, 0x40000040);
    pdb_set_u16(&mut out, e + 6, nsec + 1);
    // SizeOfImage, SizeOfInitializedData, data directory 6 (Debug)
    pdb_set_u32(&mut out, opt + 56, next_rva + pdb_align(data.len(), sect_align));
    pdb_set_u32(&mut out, opt + 8, pdb_get_u32(&out, opt + 8) + raw);
    pdb_set_u32(&mut out, opt + 112 + 6 * 8, next_rva);
    pdb_set_u32(&mut out, opt + 112 + 6 * 8 + 4, 28);
    // the COFF symbol table (and its string table) after the new section
    if body_end < pe.len() {
        pdb_set_u32(&mut out, e + 12, out.len());
        i = body_end;
        while i < pe.len() {
            out.push(pe.get(i));
            i = i + 1;
        }
    }
    return out;
}

/// The function symbols of `pe`'s COFF symbol table (section 1, .text):
/// their names in `names`, their offsets in .text in `offs`.
pub fn pdb_coff_functions(pe: &Vec<i64>, names: &mut Vec<str>, offs: &mut Vec<i64>) {
    var lay: Vec<i64> = pdb_pe_layout(pe);
    if lay.len() == 0 {
        return;
    }
    var e: i64 = lay.get(0);
    var symptr: i64 = pdb_get_u32(pe, e + 12);
    var nsyms: i64 = pdb_get_u32(pe, e + 16);
    if symptr <= 0 || symptr + 18 * nsyms > pe.len() {
        return;
    }
    var strtab: i64 = symptr + 18 * nsyms;
    var i: i64 = 0;
    while i < nsyms {
        var at: i64 = symptr + 18 * i;
        var sec: i64 = pdb_get_u16(pe, at + 12);
        var naux: i64 = pe.get(at + 17) & 255;
        if sec == 1 {
            var bytes: Vec<i64> = Vec::new();
            if pdb_get_u32(pe, at) == 0 {
                var p: i64 = strtab + pdb_get_u32(pe, at + 4);
                while p < pe.len() && pe.get(p) != 0 {
                    bytes.push(pe.get(p) & 255);
                    p = p + 1;
                }
            } else {
                var k: i64 = 0;
                while k < 8 && pe.get(at + k) != 0 {
                    bytes.push(pe.get(at + k) & 255);
                    k = k + 1;
                }
            }
            if bytes.len() > 0 {
                names.push(str_from_bytes(bytes));
                offs.push(pdb_get_u32(pe, at + 8));
            }
        }
        i = i + 1 + naux;
    }
}

// --- String tables and hash tables ---------------------------------------------

/// The bucket count of a PDB string table of `n` names (LLVM's table, so
/// the tables match what lld writes).
fn pdb_strtab_buckets(n: i64) -> i64 {
    if n <= 1 {
        return 2;
    }
    if n <= 2 {
        return 4;
    }
    if n <= 4 {
        return 7;
    }
    if n <= 6 {
        return 11;
    }
    if n <= 9 {
        return 17;
    }
    if n <= 13 {
        return 26;
    }
    if n <= 20 {
        return 40;
    }
    if n <= 31 {
        return 61;
    }
    if n <= 46 {
        return 92;
    }
    if n <= 70 {
        return 139;
    }
    return n * 2 + 1;
}

/// A PDB string table (the /names stream, the DBI's EC names): header
/// (0xEFFEEFFE, hash version 1, size of the strings), the strings `buf`
/// (starting with the empty string), the buckets (hashStringV1, linear
/// probing; 0 = empty) and the number of names. `offs` are the names'
/// offsets in `buf`.
fn pdb_string_table(buf: &Vec<i64>, offs: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    pdb_u32(&mut out, 0xEFFEEFFE);
    pdb_u32(&mut out, 1);
    pdb_u32(&mut out, buf.len());
    pdb_append(&mut out, buf);
    var nb: i64 = pdb_strtab_buckets(offs.len());
    var buckets: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < nb {
        buckets.push(0);
        i = i + 1;
    }
    i = 0;
    while i < offs.len() {
        var off: i64 = offs.get(i);
        var h: i64 = pdb_hash_v1(pdb_cstr_at(buf, off));
        var t: i64 = 0;
        while t < nb {
            var slot: i64 = (h + t) % nb;
            if buckets.get(slot) == 0 {
                buckets.set(slot, off);
                t = nb;
            }
            t = t + 1;
        }
        i = i + 1;
    }
    pdb_u32(&mut out, nb);
    i = 0;
    while i < nb {
        pdb_u32(&mut out, buckets.get(i));
        i = i + 1;
    }
    pdb_u32(&mut out, offs.len());
    return out;
}

fn pdb_cstr_at(buf: &Vec<i64>, at: i64) -> str {
    var bytes: Vec<i64> = Vec::new();
    var i: i64 = at;
    while i < buf.len() && buf.get(i) != 0 {
        bytes.push(buf.get(i));
        i = i + 1;
    }
    return str_from_bytes(bytes);
}

/// Add `s` to the string buffer `buf` (once) and return its offset.
fn pdb_intern(buf: &mut Vec<i64>, offs: &mut Vec<i64>, strs: &mut Vec<str>, s: str) -> i64 {
    var i: i64 = 0;
    while i < strs.len() {
        if strs.get(i) == s {
            return offs.get(i);
        }
        i = i + 1;
    }
    var at: i64 = buf.len();
    pdb_cstr(buf, s);
    offs.push(at);
    strs.push(s);
    return at;
}

/// The order of names within a GSI bucket (the reference implementation's
/// caseInsensitiveComparePchPchCchCch): shorter first; ASCII names case
/// insensitively, others byte by byte.
fn pdb_gsi_cmp(a: str, b: str) -> i64 {
    var la: i64 = str_len(a);
    var lb: i64 = str_len(b);
    if la != lb {
        if la < lb {
            return 0 - 1;
        }
        return 1;
    }
    var ascii: bool = true;
    var i: i64 = 0;
    while i < la {
        if (str_byte_at(a, i) & 255) >= 128 || (str_byte_at(b, i) & 255) >= 128 {
            ascii = false;
        }
        i = i + 1;
    }
    i = 0;
    while i < la {
        var x: i64 = str_byte_at(a, i) & 255;
        var y: i64 = str_byte_at(b, i) & 255;
        if ascii {
            if x >= 65 && x <= 90 {
                x = x + 32;
            }
            if y >= 65 && y <= 90 {
                y = y + 32;
            }
        }
        if x != y {
            if x < y {
                return 0 - 1;
            }
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

/// A GSI hash table (globals and publics streams): header (0xFFFFFFFF,
/// GSIHashV70, size of the hash records, size of bitmap and buckets), one
/// record {offset + 1, 1} per name in bucket order (hashStringV1 % 4096;
/// within a bucket by pdb_gsi_cmp, then offset), the bitmap of non-empty
/// buckets (4096 + 32 bits) and, per non-empty bucket, where its chain
/// starts (record index * 12, the reference implementation's in-memory
/// record size). `offs` are the records' offsets in the symbol record
/// stream.
fn pdb_gsi_hash(names: &Vec<str>, offs: &Vec<i64>) -> Vec<i64> {
    var n: i64 = names.len();
    var bucket: Vec<i64> = Vec::new();
    var order: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        bucket.push(pdb_hash_v1(names.get(i)) % PDB_IPHR_HASH);
        order.push(i);
        i = i + 1;
    }
    // insertion sort by (bucket, name, offset)
    i = 1;
    while i < n {
        var cur: i64 = order.get(i);
        var j: i64 = i - 1;
        var moving: bool = true;
        while j >= 0 && moving {
            var o: i64 = order.get(j);
            var before: bool = false;
            if bucket.get(cur) != bucket.get(o) {
                before = bucket.get(cur) < bucket.get(o);
            } else {
                var c: i64 = pdb_gsi_cmp(names.get(cur), names.get(o));
                if c != 0 {
                    before = c < 0;
                } else {
                    before = offs.get(cur) < offs.get(o);
                }
            }
            if before {
                order.set(j + 1, o);
                j = j - 1;
            } else {
                moving = false;
            }
        }
        order.set(j + 1, cur);
        i = i + 1;
    }
    var out: Vec<i64> = Vec::new();
    var nwords: i64 = (PDB_IPHR_HASH + 32) / 32;
    var bitmap: Vec<i64> = Vec::new();
    i = 0;
    while i < nwords {
        bitmap.push(0);
        i = i + 1;
    }
    var chains: Vec<i64> = Vec::new();
    var prev: i64 = 0 - 1;
    i = 0;
    while i < n {
        var b: i64 = bucket.get(order.get(i));
        if b != prev {
            bitmap.set(b / 32, bitmap.get(b / 32) | (1 << (b % 32)));
            chains.push(i * 12);
            prev = b;
        }
        i = i + 1;
    }
    pdb_u32(&mut out, 0xFFFFFFFF);
    pdb_u32(&mut out, 0xEFFE0000 + 19990810);
    pdb_u32(&mut out, n * 8);
    pdb_u32(&mut out, nwords * 4 + chains.len() * 4);
    i = 0;
    while i < n {
        pdb_u32(&mut out, offs.get(order.get(i)) + 1);
        pdb_u32(&mut out, 1);
        i = i + 1;
    }
    i = 0;
    while i < nwords {
        pdb_u32(&mut out, bitmap.get(i));
        i = i + 1;
    }
    i = 0;
    while i < chains.len() {
        pdb_u32(&mut out, chains.get(i));
        i = i + 1;
    }
    return out;
}

// --- Line rows ---------------------------------------------------------------

/// The rows of the function at [start, end): triples [offset from start,
/// line, file index], by offset, one per offset (the last row given for
/// it), lines > 0 only, and a first row at offset 0 (the function's first
/// line) when the first recorded row is later (the prologue).
fn pdb_fn_rows(rows: &Vec<i64>, start: i64, end: i64, nfiles: i64) -> Vec<i64> {
    var offs: Vec<i64> = Vec::new();
    var lines: Vec<i64> = Vec::new();
    var fls: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i + 2 < rows.len() {
        var at: i64 = rows.get(i);
        var line: i64 = rows.get(i + 1);
        var flag: i64 = rows.get(i + 2);
        if at >= start && at < end && (flag & 1) == 0 && line > 0 {
            var f: i64 = flag >> 1;
            if f < 0 || f >= nfiles {
                f = 0;
            }
            if line > 0xFFFFFF {
                line = 0xFFFFFF;
            }
            // keep them by offset: insert after the last row at or before
            var k: i64 = offs.len();
            while k > 0 && offs.get(k - 1) > at - start {
                k = k - 1;
            }
            if k > 0 && offs.get(k - 1) == at - start {
                lines.set(k - 1, line);
                fls.set(k - 1, f);
            } else {
                offs.push(0);
                lines.push(0);
                fls.push(0);
                var m: i64 = offs.len() - 1;
                while m > k {
                    offs.set(m, offs.get(m - 1));
                    lines.set(m, lines.get(m - 1));
                    fls.set(m, fls.get(m - 1));
                    m = m - 1;
                }
                offs.set(k, at - start);
                lines.set(k, line);
                fls.set(k, f);
            }
        }
        i = i + 3;
    }
    var out: Vec<i64> = Vec::new();
    if offs.len() > 0 && offs.get(0) > 0 {
        out.push(0);
        out.push(lines.get(0));
        out.push(fls.get(0));
    }
    i = 0;
    while i < offs.len() {
        out.push(offs.get(i));
        out.push(lines.get(i));
        out.push(fls.get(i));
        i = i + 1;
    }
    return out;
}

// --- The PDB ------------------------------------------------------------------

/// The PDB of the image `pe` (with its debug directory: pdb_add_debug_
/// directory): the functions `names` at [starts, ends) of .text, their
/// line rows `rows` against `files` (empty: `file`), `guid` and `age` as
/// in the image's RSDS record. See the top of the file for the streams.
pub fn pdb_build(pe: &Vec<i64>, names: &Vec<str>, starts: &Vec<i64>, ends: &Vec<i64>, rows: &Vec<i64>, files: &Vec<str>, file: str, guid: &Vec<i64>, age: i64) -> Vec<i64> {
    var lay: Vec<i64> = pdb_pe_layout(pe);
    var nsec: i64 = 0;
    var sect: i64 = 0;
    if lay.len() > 0 {
        nsec = lay.get(1);
        sect = lay.get(3);
    }
    // DB4: the functions' variables and their types, from the image's DWARF
    var dlocals: PdbLocals = pdb_dwarf_locals(pe);
    var text_size: i64 = 0;
    var text_chars: i64 = 0x60000020;
    if nsec > 0 {
        text_size = pdb_get_u32(pe, sect + 8);
        text_chars = pdb_get_u32(pe, sect + 36);
    }
    var main_file: str = file;
    if main_file == "" {
        main_file = "fides";
    }
    // the source files: `files` (the first one "" means `file`), else `file`
    var fl: Vec<str> = Vec::new();
    var fi: i64 = 0;
    while fi < files.len() {
        var fname: str = files.get(fi);
        if fname == "" {
            fname = main_file;
        }
        fl.push(fname);
        fi = fi + 1;
    }
    if fl.len() == 0 {
        fl.push(main_file);
    }
    // /names: the file names
    var nbuf: Vec<i64> = Vec::new();
    nbuf.push(0);
    var noffs: Vec<i64> = Vec::new();
    var nstrs: Vec<str> = Vec::new();
    var file_name_off: Vec<i64> = Vec::new();
    fi = 0;
    while fi < fl.len() {
        file_name_off.push(pdb_intern(&mut nbuf, &mut noffs, &mut nstrs, fl.get(fi)));
        fi = fi + 1;
    }
    var names_stream: Vec<i64> = pdb_string_table(&nbuf, &noffs);

    // the module's symbols
    var msyms: Vec<i64> = Vec::new();
    pdb_u32(&mut msyms, 4);
    // CV_SIGNATURE_C13
    var r: i64 = pdb_rec_begin(&mut msyms, PDB_S_OBJNAME);
    pdb_u32(&mut msyms, 0);
    pdb_cstr(&mut msyms, main_file);
    pdb_rec_end(&mut msyms, r);
    r = pdb_rec_begin(&mut msyms, PDB_S_COMPILE3);
    pdb_u32(&mut msyms, 0);
    // flags: language C (the expression evaluators' plainest)
    pdb_u16(&mut msyms, 0xD0);
    // CV_CFL_X64
    var vi: i64 = 0;
    while vi < 8 {
        if vi == 0 || vi == 4 {
            pdb_u16(&mut msyms, 1);
        } else {
            pdb_u16(&mut msyms, 0);
        }
        vi = vi + 1;
    }
    pdb_cstr(&mut msyms, "fid");
    pdb_rec_end(&mut msyms, r);
    var proc_off: Vec<i64> = Vec::new();
    var proc_name: Vec<str> = Vec::new();
    var proc_start: Vec<i64> = Vec::new();
    var proc_end: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < names.len() {
        var st: i64 = starts.get(i);
        var en: i64 = ends.get(i);
        var nm: str = names.get(i);
        if en > st && st >= 0 && nm != "" {
            var at: i64 = pdb_rec_begin(&mut msyms, PDB_S_GPROC32);
            pdb_u32(&mut msyms, 0);
            // parent
            pdb_u32(&mut msyms, 0);
            // end (set below)
            pdb_u32(&mut msyms, 0);
            // next
            pdb_u32(&mut msyms, en - st);
            pdb_u32(&mut msyms, 0);
            // debug start
            pdb_u32(&mut msyms, en - st);
            // debug end
            pdb_u32(&mut msyms, 0);
            // type: none
            pdb_u32(&mut msyms, st);
            pdb_u16(&mut msyms, 1);
            // section 1, .text
            pdb_u8(&mut msyms, 0);
            // flags
            pdb_cstr(&mut msyms, nm);
            pdb_rec_end(&mut msyms, at);
            var li: i64 = 0;
            while li < dlocals.fn_starts.len() {
                if dlocals.fn_starts.get(li) == st {
                    var fitems: Vec<PdbVarItem> = dlocals.fn_items.get(li);
                    pdb_put_items(&mut msyms, at, &fitems);
                }
                li = li + 1;
            }
            var end_at: i64 = pdb_rec_begin(&mut msyms, PDB_S_END);
            pdb_rec_end(&mut msyms, end_at);
            pdb_set_u32(&mut msyms, at + 8, end_at);
            proc_off.push(at);
            proc_name.push(nm);
            proc_start.push(st);
            proc_end.push(en);
        }
        i = i + 1;
    }
    var sym_bytes: i64 = msyms.len();
    // C13: the file checksums (none), then the lines of each function
    var c13: Vec<i64> = Vec::new();
    var chk: Vec<i64> = Vec::new();
    var chk_off: Vec<i64> = Vec::new();
    fi = 0;
    while fi < fl.len() {
        chk_off.push(chk.len());
        pdb_u32(&mut chk, file_name_off.get(fi));
        pdb_u8(&mut chk, 0);
        // checksum size
        pdb_u8(&mut chk, 0);
        // checksum kind: none
        pdb_pad4(&mut chk);
        fi = fi + 1;
    }
    pdb_u32(&mut c13, PDB_DEBUG_S_FILECHKSMS);
    pdb_u32(&mut c13, chk.len());
    pdb_append(&mut c13, &chk);
    i = 0;
    while i < proc_off.len() {
        var lst: i64 = proc_start.get(i);
        var len_fn: i64 = proc_end.get(i) - lst;
        var fr: Vec<i64> = pdb_fn_rows(rows, lst, lst + len_fn, fl.len());
        if fr.len() > 0 {
            var sub: Vec<i64> = Vec::new();
            pdb_u32(&mut sub, lst);
            pdb_u16(&mut sub, 1);
            pdb_u16(&mut sub, 0);
            // no columns
            pdb_u32(&mut sub, len_fn);
            var k: i64 = 0;
            while k < fr.len() {
                var bfile: i64 = fr.get(k + 2);
                var bend: i64 = k;
                while bend < fr.len() && fr.get(bend + 2) == bfile {
                    bend = bend + 3;
                }
                var cnt: i64 = (bend - k) / 3;
                pdb_u32(&mut sub, chk_off.get(bfile));
                pdb_u32(&mut sub, cnt);
                pdb_u32(&mut sub, 12 + 8 * cnt);
                var q: i64 = k;
                while q < bend {
                    pdb_u32(&mut sub, fr.get(q));
                    pdb_u32(&mut sub, fr.get(q + 1) | 0x80000000);
                    // is a statement
                    q = q + 3;
                }
                k = bend;
            }
            pdb_u32(&mut c13, PDB_DEBUG_S_LINES);
            pdb_u32(&mut c13, sub.len());
            pdb_append(&mut c13, &sub);
            pdb_pad4(&mut c13);
        }
        i = i + 1;
    }
    var mod_stream: Vec<i64> = Vec::new();
    pdb_append(&mut mod_stream, &msyms);
    pdb_append(&mut mod_stream, &c13);
    pdb_u32(&mut mod_stream, 0);
    // no global refs

    // the symbol records: publics (the functions, then the image's other
    // COFF function symbols), then the globals' S_PROCREFs
    var recs: Vec<i64> = Vec::new();
    var pub_names: Vec<str> = Vec::new();
    var pub_offs: Vec<i64> = Vec::new();
    var pub_addr: Vec<i64> = Vec::new();
    var seen: i64 = HashMap_new();
    i = 0;
    while i < proc_off.len() {
        var pn: str = proc_name.get(i);
        if !HashMap_contains(seen, pn) {
            HashMap_insert(seen, pn, 1);
            pub_offs.push(recs.len());
            pub_names.push(pn);
            pub_addr.push(proc_start.get(i));
            var pr: i64 = pdb_rec_begin(&mut recs, PDB_S_PUB32);
            pdb_u32(&mut recs, 2);
            // a function
            pdb_u32(&mut recs, proc_start.get(i));
            pdb_u16(&mut recs, 1);
            pdb_cstr(&mut recs, pn);
            pdb_rec_end(&mut recs, pr);
        }
        i = i + 1;
    }
    var cnames: Vec<str> = Vec::new();
    var coffs: Vec<i64> = Vec::new();
    pdb_coff_functions(pe, &mut cnames, &mut coffs);
    i = 0;
    while i < cnames.len() {
        var cn: str = cnames.get(i);
        if !HashMap_contains(seen, cn) && coffs.get(i) >= 0 && (text_size == 0 || coffs.get(i) < text_size) {
            HashMap_insert(seen, cn, 1);
            pub_offs.push(recs.len());
            pub_names.push(cn);
            pub_addr.push(coffs.get(i));
            var cr: i64 = pdb_rec_begin(&mut recs, PDB_S_PUB32);
            pdb_u32(&mut recs, 2);
            pdb_u32(&mut recs, coffs.get(i));
            pdb_u16(&mut recs, 1);
            pdb_cstr(&mut recs, cn);
            pdb_rec_end(&mut recs, cr);
        }
        i = i + 1;
    }
    var glob_names: Vec<str> = Vec::new();
    var glob_offs: Vec<i64> = Vec::new();
    i = 0;
    while i < proc_off.len() {
        glob_offs.push(recs.len());
        glob_names.push(proc_name.get(i));
        var gr: i64 = pdb_rec_begin(&mut recs, PDB_S_PROCREF);
        pdb_u32(&mut recs, 0);
        // SumName
        pdb_u32(&mut recs, proc_off.get(i));
        // the S_GPROC32 in the module stream
        pdb_u16(&mut recs, 1);
        // module 1 (counted from 1)
        pdb_cstr(&mut recs, proc_name.get(i));
        pdb_rec_end(&mut recs, gr);
        i = i + 1;
    }
    var globals: Vec<i64> = pdb_gsi_hash(&glob_names, &glob_offs);
    // publics: header, hash, the address map (by section, offset, name)
    var pub_hash: Vec<i64> = pdb_gsi_hash(&pub_names, &pub_offs);
    var amap: Vec<i64> = Vec::new();
    i = 0;
    while i < pub_names.len() {
        amap.push(i);
        i = i + 1;
    }
    i = 1;
    while i < amap.len() {
        var cur: i64 = amap.get(i);
        var j: i64 = i - 1;
        var moving: bool = true;
        while j >= 0 && moving {
            var o: i64 = amap.get(j);
            var before: bool = false;
            if pub_addr.get(cur) != pub_addr.get(o) {
                before = pub_addr.get(cur) < pub_addr.get(o);
            } else {
                before = str_compare(pub_names.get(cur), pub_names.get(o)) < 0;
            }
            if before {
                amap.set(j + 1, o);
                j = j - 1;
            } else {
                moving = false;
            }
        }
        amap.set(j + 1, cur);
        i = i + 1;
    }
    var publics: Vec<i64> = Vec::new();
    pdb_u32(&mut publics, pub_hash.len());
    // SymHash
    pdb_u32(&mut publics, amap.len() * 4);
    // AddrMap
    pdb_u32(&mut publics, 0);
    // NumThunks
    pdb_u32(&mut publics, 0);
    // SizeOfThunk
    pdb_u16(&mut publics, 0);
    // ISectThunkTable
    pdb_u16(&mut publics, 0);
    pdb_u32(&mut publics, 0);
    // OffThunkTable
    pdb_u32(&mut publics, 0);
    // NumSections
    pdb_append(&mut publics, &pub_hash);
    i = 0;
    while i < amap.len() {
        pdb_u32(&mut publics, pub_offs.get(amap.get(i)));
        i = i + 1;
    }

    // DBI
    var modi: Vec<i64> = Vec::new();
    pdb_u32(&mut modi, 0);
    pdb_section_contrib(&mut modi, text_size, text_chars);
    pdb_u16(&mut modi, 0);
    // flags
    pdb_u16(&mut modi, PDB_STREAM_MODULE);
    pdb_u32(&mut modi, sym_bytes);
    pdb_u32(&mut modi, 0);
    // C11 lines
    pdb_u32(&mut modi, c13.len());
    pdb_u16(&mut modi, fl.len());
    pdb_u16(&mut modi, 0);
    pdb_u32(&mut modi, 0);
    pdb_u32(&mut modi, 0);
    // source file name index
    pdb_u32(&mut modi, 0);
    // PDB file path name index
    pdb_cstr(&mut modi, main_file);
    pdb_cstr(&mut modi, main_file);
    pdb_pad4(&mut modi);
    var contribs: Vec<i64> = Vec::new();
    pdb_u32(&mut contribs, 0xEFFE0000 + 19970605);
    pdb_section_contrib(&mut contribs, text_size, text_chars);
    var secmap: Vec<i64> = Vec::new();
    pdb_u16(&mut secmap, nsec + 1);
    pdb_u16(&mut secmap, nsec + 1);
    var s: i64 = 0;
    while s < nsec {
        var ch: i64 = pdb_get_u32(pe, sect + 40 * s + 36);
        var fl16: i64 = 0x100;
        // IsSelector
        if (ch & 0x40000000) != 0 {
            fl16 = fl16 | 1;
        }
        if (ch & 0x80000000) != 0 {
            fl16 = fl16 | 2;
        }
        if (ch & 0x20000000) != 0 {
            fl16 = fl16 | 4;
        }
        if (ch & 0x00020000) == 0 {
            fl16 = fl16 | 8;
        }
        pdb_u16(&mut secmap, fl16);
        pdb_u16(&mut secmap, 0);
        pdb_u16(&mut secmap, 0);
        pdb_u16(&mut secmap, s + 1);
        pdb_u16(&mut secmap, 0xFFFF);
        pdb_u16(&mut secmap, 0xFFFF);
        pdb_u32(&mut secmap, 0);
        pdb_u32(&mut secmap, pdb_get_u32(pe, sect + 40 * s + 8));
        s = s + 1;
    }
    pdb_u16(&mut secmap, 8 | 0x200);
    // the absolute pseudo-section
    pdb_u16(&mut secmap, 0);
    pdb_u16(&mut secmap, 0);
    pdb_u16(&mut secmap, nsec + 1);
    pdb_u16(&mut secmap, 0xFFFF);
    pdb_u16(&mut secmap, 0xFFFF);
    pdb_u32(&mut secmap, 0);
    pdb_u32(&mut secmap, 0xFFFFFFFF);
    var finfo: Vec<i64> = Vec::new();
    pdb_u16(&mut finfo, 1);
    pdb_u16(&mut finfo, fl.len());
    pdb_u16(&mut finfo, 0);
    pdb_u16(&mut finfo, fl.len());
    var fnames: Vec<i64> = Vec::new();
    fi = 0;
    while fi < fl.len() {
        pdb_u32(&mut finfo, fnames.len());
        pdb_cstr(&mut fnames, fl.get(fi));
        fi = fi + 1;
    }
    pdb_append(&mut finfo, &fnames);
    pdb_pad4(&mut finfo);
    var ec_buf: Vec<i64> = Vec::new();
    ec_buf.push(0);
    var ec_offs: Vec<i64> = Vec::new();
    var ec: Vec<i64> = pdb_string_table(&ec_buf, &ec_offs);
    var dbghdr: Vec<i64> = Vec::new();
    var di: i64 = 0;
    while di < 11 {
        if di == 5 {
            pdb_u16(&mut dbghdr, PDB_STREAM_SECHDR);
        } else {
            pdb_u16(&mut dbghdr, 0xFFFF);
        }
        di = di + 1;
    }
    var dbi: Vec<i64> = Vec::new();
    pdb_u32(&mut dbi, 0xFFFFFFFF);
    pdb_u32(&mut dbi, 19990903);
    // V70
    pdb_u32(&mut dbi, age);
    pdb_u16(&mut dbi, PDB_STREAM_GLOBALS);
    pdb_u16(&mut dbi, 0x8E0B);
    // new format, 14.11 (what Microsoft's tools expect, as lld writes)
    pdb_u16(&mut dbi, PDB_STREAM_PUBLICS);
    pdb_u16(&mut dbi, 0);
    pdb_u16(&mut dbi, PDB_STREAM_SYMRECS);
    pdb_u16(&mut dbi, 0);
    pdb_u32(&mut dbi, modi.len());
    pdb_u32(&mut dbi, contribs.len());
    pdb_u32(&mut dbi, secmap.len());
    pdb_u32(&mut dbi, finfo.len());
    pdb_u32(&mut dbi, 0);
    // type server map
    pdb_u32(&mut dbi, 0);
    // MFC type server
    pdb_u32(&mut dbi, dbghdr.len());
    pdb_u32(&mut dbi, ec.len());
    pdb_u16(&mut dbi, 0);
    // flags
    pdb_u16(&mut dbi, 0x8664);
    pdb_u32(&mut dbi, 0);
    pdb_append(&mut dbi, &modi);
    pdb_append(&mut dbi, &contribs);
    pdb_append(&mut dbi, &secmap);
    pdb_append(&mut dbi, &finfo);
    pdb_append(&mut dbi, &ec);
    pdb_append(&mut dbi, &dbghdr);

    // PDB info
    var info: Vec<i64> = Vec::new();
    pdb_u32(&mut info, 20000404);
    // VC70
    pdb_u32(&mut info, pdb_get_u32(guid, 0));
    // signature
    pdb_u32(&mut info, age);
    pdb_append(&mut info, guid);
    var nm_names: str = "/names";
    pdb_u32(&mut info, str_len(nm_names) + 1);
    pdb_cstr(&mut info, nm_names);
    pdb_u32(&mut info, 1);
    // entries
    pdb_u32(&mut info, 8);
    // capacity
    pdb_u32(&mut info, 1);
    // present bit vector: one word
    pdb_u32(&mut info, 1 << ((pdb_hash_v1(nm_names) & 0xFFFF) % 8));
    pdb_u32(&mut info, 0);
    // deleted bit vector: none
    pdb_u32(&mut info, 0);
    // key: "/names" at 0 in the buffer
    pdb_u32(&mut info, PDB_STREAM_NAMES);
    pdb_u32(&mut info, 20140508);
    // feature VC140

    var sechdr: Vec<i64> = Vec::new();
    i = 0;
    while i < 40 * nsec {
        sechdr.push(pe.get(sect + i) & 255);
        i = i + 1;
    }

    var streams: Vec<Vec<i64>> = Vec::new();
    streams.push(Vec::new());
    streams.push(info);
    streams.push(pdb_tpi_stream(&dlocals.types, dlocals.ntypes, 11));
    streams.push(dbi);
    streams.push(pdb_tpi_header());
    streams.push(names_stream);
    streams.push(mod_stream);
    streams.push(globals);
    streams.push(publics);
    streams.push(recs);
    streams.push(sechdr);
    // 11: the TPI hash stream (DB4), when there are type records
    if dlocals.ntypes > 0 {
        streams.push(pdb_tpi_hash_stream(&dlocals.hashes));
    }
    return pdb_msf(&streams);
}

/// A section contribution (28 bytes): .text (section 1) from offset 0 for
/// `size` bytes, module 0.
fn pdb_section_contrib(out: &mut Vec<i64>, size: i64, chars: i64) {
    pdb_u16(out, 1);
    pdb_u16(out, 0);
    pdb_u32(out, 0);
    pdb_u32(out, size);
    pdb_u32(out, chars);
    pdb_u16(out, 0);
    pdb_u16(out, 0);
    pdb_u32(out, 0);
    pdb_u32(out, 0);
}

/// A TPI or IPI stream with no records: the 56-byte header (V80, type
/// indices 0x1000..0x1000, no hash stream).
fn pdb_tpi_header() -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    pdb_u32(&mut out, 20040203);
    pdb_u32(&mut out, 56);
    pdb_u32(&mut out, 0x1000);
    pdb_u32(&mut out, 0x1000);
    pdb_u32(&mut out, 0);
    // record bytes
    pdb_u16(&mut out, 0xFFFF);
    pdb_u16(&mut out, 0xFFFF);
    // hash streams: none
    pdb_u32(&mut out, 4);
    // hash key size
    pdb_u32(&mut out, 0x3FFFF);
    // buckets
    var k: i64 = 0;
    while k < 6 {
        pdb_u32(&mut out, 0);
        k = k + 1;
    }
    return out;
}

// --- DB4: the variables, from the image's DWARF -----------------------------
// A debug build's image already carries DWARF 4 for its functions (pe_ir.fd
// pe_add_dwarf, nat_enc.fd nat_pe_debug): .debug_info with each function's
// parameters, variables and lexical blocks, their types and locations,
// .debug_loc for values that move, .debug_frame for the CFA. pdb_build reads
// them back here and writes what Visual Studio and WinDbg read instead:
//   - per function, between S_GPROC32 and its S_END: S_BLOCK32 ... S_END for
//     each lexical block (DB4's shadowed names), and per variable
//       S_REGREL32  a slot under the CFA (DW_OP_fbreg; the CFA is the rule
//                   .debug_frame gives the function's body: rbp + 16 after
//                   `push rbp; mov rbp, rsp`), or the memory at a register
//                   (DW_OP_bregN)
//       S_REGISTER  a register for the whole function (DW_OP_regN)
//       S_LOCAL + S_DEFRANGE_REGISTER / S_DEFRANGE_REGISTER_REL  a location
//                   list: one range per entry that is a register or a slot
//     (a constant, DW_OP_stack_value, and an entry of any other form is left
//     out: the variable is "optimized away" there, as with no location);
//     a slot that holds the variable's address (DW_OP_fbreg; DW_OP_deref: a
//     struct passed by pointer) is typed as a pointer to it;
//   - the types in the TPI stream: base types as CodeView's simple types
//     (i64 T_INT8, u8 T_UCHAR, bool T_BOOL08, f64 T_REAL64, ...), str (a
//     pointer to u8) as char * (T_64PRCHAR), a struct as LF_STRUCTURE with
//     its LF_FIELDLIST of LF_MEMBERs, other pointers as LF_POINTER.
// An image without .debug_info (pdb_unit's) gets procedures and lines only,
// as before. Check: tests/nattools/pe_pdb_locals_check.py (llvm-pdbutil and
// dbghelp's SymEnumSymbols at a function's address).

const PDB_S_BLOCK32: i64 = 0x1103;
const PDB_S_REGISTER: i64 = 0x1106;
const PDB_S_REGREL32: i64 = 0x1111;
const PDB_S_LOCAL: i64 = 0x113E;
const PDB_S_DEFRANGE_REGISTER: i64 = 0x1141;
const PDB_S_DEFRANGE_REGISTER_REL: i64 = 0x1145;
const PDB_LF_POINTER: i64 = 0x1002;
const PDB_LF_FIELDLIST: i64 = 0x1203;
const PDB_LF_STRUCTURE: i64 = 0x1505;
const PDB_LF_MEMBER: i64 = 0x150D;
const PDB_T_64PVOID: i64 = 0x0603;
const PDB_T_64PRCHAR: i64 = 0x0670;

/// One item of a function's variables: kind 0 S_REGREL32 (reg, off), 1
/// S_REGISTER (reg), 2 S_LOCAL with `ranges` (5 words each: start offset in
/// .text, length, 0 register / 1 register + offset, register, offset), 10 a
/// lexical block [lo, lo + len) begins, 11 it ends.
pub struct PdbVarItem {
    pub kind: i64,
    pub name: str,
    pub ty: i64,
    pub reg: i64,
    pub off: i64,
    pub lo: i64,
    pub len: i64,
    pub is_param: bool,
    pub ranges: Vec<i64>,
}

/// The variables of the image: per function (by its offset in .text) its
/// items, and the TPI type records they use (`ntypes` of them, from 0x1000).
pub struct PdbLocals {
    pub fn_starts: Vec<i64>,
    pub fn_items: Vec<Vec<PdbVarItem>>,
    pub types: Vec<i64>,
    pub ntypes: i64,
    // each record's hash (TPI hash stream: dbghelp will not read type
    // records without one)
    pub hashes: Vec<i64>,
}

/// A section of a PE image found by name (a long name `/n` is in the COFF
/// string table): [file offset, size, RVA], or an empty Vec.
fn pdb_pe_section(pe: &Vec<i64>, want: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var lay: Vec<i64> = pdb_pe_layout(pe);
    if lay.len() == 0 {
        return out;
    }
    var e: i64 = lay.get(0);
    var nsec: i64 = lay.get(1);
    var sect: i64 = lay.get(3);
    var symptr: i64 = pdb_get_u32(pe, e + 12);
    var nsyms: i64 = pdb_get_u32(pe, e + 16);
    var strtab: i64 = 0;
    if symptr > 0 {
        strtab = symptr + 18 * nsyms;
    }
    var s: i64 = 0;
    while s < nsec {
        var h: i64 = sect + 40 * s;
        var nm: str = "";
        var k: i64 = 0;
        while k < 8 && pe.get(h + k) != 0 {
            nm = nm + char_to_str(pe.get(h + k));
            k = k + 1;
        }
        if str_starts_with(nm, "/") && strtab > 0 {
            var so: i64 = strtab + str_parse_int(str_slice(nm, 1, str_len(nm)));
            if so >= strtab && so < pe.len() {
                nm = pdb_cstr_at(pe, so);
            }
        }
        if nm == want {
            var vsize: i64 = pdb_get_u32(pe, h + 8);
            var rawsize: i64 = pdb_get_u32(pe, h + 16);
            var size: i64 = rawsize;
            if vsize > 0 && vsize <= rawsize {
                size = vsize;
            }
            out.push(pdb_get_u32(pe, h + 20));
            out.push(size);
            out.push(pdb_get_u32(pe, h + 12));
            return out;
        }
        s = s + 1;
    }
    return out;
}

/// The bytes [off, off + size) of `pe`.
fn pdb_slice(pe: &Vec<i64>, off: i64, size: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < size && off + i < pe.len() {
        out.push(pe.get(off + i) & 255);
        i = i + 1;
    }
    return out;
}

fn pdb_get_u64(b: &Vec<i64>, at: i64) -> i64 {
    return pdb_get_u32(b, at) | (pdb_get_u32(b, at + 4) << 32);
}

// the reading position of pdb_uleb / pdb_sleb
var g_pdb_rd: i64 = 0;

fn pdb_uleb(b: &Vec<i64>) -> i64 {
    var v: i64 = 0;
    var sh: i64 = 0;
    while g_pdb_rd < b.len() {
        var c: i64 = b.get(g_pdb_rd);
        g_pdb_rd = g_pdb_rd + 1;
        if sh < 63 {
            v = v | ((c & 0x7F) << sh);
        }
        sh = sh + 7;
        if c < 0x80 {
            return v;
        }
    }
    return v;
}

fn pdb_sleb(b: &Vec<i64>) -> i64 {
    var v: i64 = 0;
    var sh: i64 = 0;
    while g_pdb_rd < b.len() {
        var c: i64 = b.get(g_pdb_rd);
        g_pdb_rd = g_pdb_rd + 1;
        if sh < 63 {
            v = v | ((c & 0x7F) << sh);
        }
        sh = sh + 7;
        if c < 0x80 {
            if (c & 0x40) != 0 && sh < 64 {
                v = v - (1 << sh);
            }
            return v;
        }
    }
    return v;
}

/// The CodeView register of DWARF x86-64 register `r` (0 when none).
fn pdb_cv_reg(r: i64) -> i64 {
    if r == 0 {
        return 328;
    }
    // rax
    if r == 1 {
        return 331;
    }
    // rdx
    if r == 2 {
        return 330;
    }
    // rcx
    if r == 3 {
        return 329;
    }
    // rbx
    if r == 4 {
        return 332;
    }
    // rsi
    if r == 5 {
        return 333;
    }
    // rdi
    if r == 6 {
        return 334;
    }
    // rbp
    if r == 7 {
        return 335;
    }
    // rsp
    if r >= 8 && r <= 15 {
        return 336 + (r - 8);
    }
    // r8..r15
    if r >= 17 && r <= 32 {
        return 154 + (r - 17);
    }
    // xmm0..xmm15
    return 0;
}

/// The entries of .debug_info: parallel lists (one element per entry).
pub struct PdbDies {
    pub off: Vec<i64>,
    pub tag: Vec<i64>,
    pub parent: Vec<i64>,
    pub name: Vec<str>,
    pub ty: Vec<i64>,
    pub lo: Vec<i64>,
    pub hi: Vec<i64>,
    pub enc: Vec<i64>,
    pub size: Vec<i64>,
    pub memloc: Vec<i64>,
    // location: 0 none, 1 an expression at [loc_at, loc_at + loc_len) of
    // .debug_info, 2 a list at loc_at of .debug_loc
    pub loc_kind: Vec<i64>,
    pub loc_at: Vec<i64>,
    pub loc_len: Vec<i64>,
    // the compile unit's base address (DW_AT_low_pc) of each entry
    pub cu_base: Vec<i64>,
}

/// Every entry of every unit of .debug_info `info` (abbreviations from
/// .debug_abbrev `ab`); type references made absolute. The forms are those
/// the writers use; an unknown form ends the unit.
fn pdb_read_dies(info: &Vec<i64>, ab: &Vec<i64>) -> PdbDies {
    var d: PdbDies = PdbDies {
        off: Vec::new(), tag: Vec::new(), parent: Vec::new(), name: Vec::new(), ty: Vec::new(), lo: Vec::new(), hi: Vec::new(), enc: Vec::new(), size: Vec::new(), memloc: Vec::new(), loc_kind: Vec::new(), loc_at: Vec::new(), loc_len: Vec::new(), cu_base: Vec::new(),
    };
    var cu: i64 = 0;
    while cu + 11 <= info.len() {
        var unit_len: i64 = pdb_get_u32(info, cu);
        if unit_len == 0 || unit_len == 0xFFFFFFFF {
            break;
        }
        var unit_end: i64 = cu + 4 + unit_len;
        var abbr_off: i64 = pdb_get_u32(info, cu + 6);
        // the unit's abbreviations: code -> position in `ab` after the code
        var codes: Vec<i64> = Vec::new();
        var cpos: Vec<i64> = Vec::new();
        g_pdb_rd = abbr_off;
        while g_pdb_rd < ab.len() {
            var code: i64 = pdb_uleb(ab);
            if code == 0 {
                break;
            }
            codes.push(code);
            cpos.push(g_pdb_rd);
            pdb_uleb(ab);
            g_pdb_rd = g_pdb_rd + 1;
            while g_pdb_rd < ab.len() {
                var an: i64 = pdb_uleb(ab);
                var af: i64 = pdb_uleb(ab);
                if an == 0 && af == 0 {
                    break;
                }
            }
        }
        var stack: Vec<i64> = Vec::new();
        stack.push(-1);
        var base: i64 = 0;
        var p: i64 = cu + 11;
        var bad: bool = false;
        while p < unit_end && !bad {
            var die_off: i64 = p;
            g_pdb_rd = p;
            var code2: i64 = pdb_uleb(info);
            p = g_pdb_rd;
            if code2 == 0 {
                stack.pop();
                if stack.len() == 0 {
                    break;
                }
                continue;
            }
            var ci: i64 = 0;
            var apos: i64 = -1;
            while ci < codes.len() {
                if codes.get(ci) == code2 {
                    apos = cpos.get(ci);
                }
                ci = ci + 1;
            }
            if apos < 0 {
                break;
            }
            g_pdb_rd = apos;
            var tag: i64 = pdb_uleb(ab);
            var children: i64 = ab.get(g_pdb_rd);
            g_pdb_rd = g_pdb_rd + 1;
            var a_pos: i64 = g_pdb_rd;
            var nm: str = "";
            var ty: i64 = -1;
            var lo: i64 = 0;
            var hi: i64 = 0;
            var hi_abs: bool = false;
            var enc: i64 = 0;
            var size: i64 = 0;
            var memloc: i64 = 0;
            var lk: i64 = 0;
            var lat: i64 = 0;
            var llen: i64 = 0;
            while true {
                g_pdb_rd = a_pos;
                var an2: i64 = pdb_uleb(ab);
                var af2: i64 = pdb_uleb(ab);
                a_pos = g_pdb_rd;
                if an2 == 0 && af2 == 0 {
                    break;
                }
                var v: i64 = 0;
                var sv: str = "";
                var ex_at: i64 = 0;
                var ex_len: i64 = -1;
                if af2 == 0x08 {
                    var q: i64 = p;
                    while q < info.len() && info.get(q) != 0 {
                        q = q + 1;
                    }
                    sv = pdb_cstr_at(info, p);
                    p = q + 1;
                } else if af2 == 0x0B || af2 == 0x11 || af2 == 0x0C {
                    v = info.get(p);
                    p = p + 1;
                } else if af2 == 0x05 || af2 == 0x12 {
                    v = pdb_get_u16(info, p);
                    p = p + 2;
                } else if af2 == 0x06 || af2 == 0x13 || af2 == 0x17 || af2 == 0x0E || af2 == 0x10 {
                    v = pdb_get_u32(info, p);
                    p = p + 4;
                } else if af2 == 0x07 || af2 == 0x01 || af2 == 0x14 {
                    v = pdb_get_u64(info, p);
                    p = p + 8;
                } else if af2 == 0x0F {
                    g_pdb_rd = p;
                    v = pdb_uleb(info);
                    p = g_pdb_rd;
                } else if af2 == 0x0D {
                    g_pdb_rd = p;
                    v = pdb_sleb(info);
                    p = g_pdb_rd;
                } else if af2 == 0x18 {
                    g_pdb_rd = p;
                    var n: i64 = pdb_uleb(info);
                    ex_at = g_pdb_rd;
                    ex_len = n;
                    p = g_pdb_rd + n;
                } else if af2 == 0x0A {
                    var n1: i64 = info.get(p);
                    ex_at = p + 1;
                    ex_len = n1;
                    p = p + 1 + n1;
                } else if af2 == 0x19 {
                    v = 1;
                } else {
                    bad = true;
                    break;
                }
                if an2 == 0x03 {
                    nm = sv;
                } else if an2 == 0x49 {
                    if af2 == 0x10 {
                        ty = v;
                    } else {
                        ty = cu + v;
                    }
                } else if an2 == 0x11 {
                    lo = v;
                } else if an2 == 0x12 {
                    hi = v;
                    hi_abs = af2 == 0x01;
                } else if an2 == 0x3E {
                    enc = v;
                } else if an2 == 0x0B {
                    size = v;
                } else if an2 == 0x38 {
                    memloc = v;
                } else if an2 == 0x02 {
                    if ex_len >= 0 {
                        lk = 1;
                        lat = ex_at;
                        llen = ex_len;
                    } else {
                        lk = 2;
                        lat = v;
                    }
                }
            }
            if bad {
                break;
            }
            if hi_abs && hi >= lo {
                hi = hi - lo;
            }
            if tag == 0x11 {
                base = lo;
            }
            d.off.push(die_off);
            d.tag.push(tag);
            d.parent.push(stack.get(stack.len() - 1));
            d.name.push(nm);
            d.ty.push(ty);
            d.lo.push(lo);
            d.hi.push(hi);
            d.enc.push(enc);
            d.size.push(size);
            d.memloc.push(memloc);
            d.loc_kind.push(lk);
            d.loc_at.push(lat);
            d.loc_len.push(llen);
            d.cu_base.push(base);
            if children != 0 {
                stack.push(d.off.len() - 1);
            }
        }
        cu = unit_end;
    }
    return d;
}

/// The position in `d` of the entry at .debug_info offset `off`, or -1.
fn pdb_die_at(d: &PdbDies, offs: i64, map: i64) -> i64 {
    if !HashMap_contains(map, int_to_str(offs)) {
        return -1;
    }
    var v: i64 = HashMap_get(map, int_to_str(offs));
    return v - 1;
}

/// The CodeView simple type of a DWARF base type (encoding, size), or 0.
fn pdb_cv_base(enc: i64, size: i64) -> i64 {
    if enc == 2 {
        return 0x0030;
    }
    // boolean: T_BOOL08
    if enc == 4 {
        if size == 4 {
            return 0x0040;
        }
        return 0x0041;
    }
    // float: T_REAL32 / T_REAL64
    if enc == 6 {
        return 0x0010;
    }
    // signed char: T_CHAR
    if enc == 8 {
        return 0x0020;
    }
    // unsigned char: T_UCHAR
    if enc == 5 || enc == 0x0D {
        if size == 1 {
            return 0x0068;
        }
        if size == 2 {
            return 0x0072;
        }
        if size == 4 {
            return 0x0074;
        }
        return 0x0076;
    }
    // signed: T_INT1..T_INT8
    if size == 1 {
        return 0x0069;
    }
    if size == 2 {
        return 0x0073;
    }
    if size == 4 {
        return 0x0075;
    }
    return 0x0077;
    // unsigned (and anything else of a size): T_UINT1..T_UINT8
}

// the TPI records pdb_cv_type makes, and their count; DWARF entry -> type
// index + 1 (0 while one is being made: a cycle)
var g_pdb_tpi: Vec<i64> = Vec::new();
var g_pdb_ntypes: i64 = 0;
var g_pdb_tpi_hash: Vec<i64> = Vec::new();
var g_pdb_tymap: i64 = 0;

/// Append a TPI record of `leaf` with `body` (padded to 4 with LF_PAD
/// bytes); its type index.
fn pdb_tpi_add(leaf: i64, body: &Vec<i64>) -> i64 {
    var rec: Vec<i64> = Vec::new();
    pdb_u16(&mut rec, leaf);
    pdb_append(&mut rec, body);
    while (rec.len() + 2) % 4 != 0 {
        rec.push(0xF0 + (4 - (rec.len() + 2) % 4));
    }
    var full: Vec<i64> = Vec::new();
    pdb_u16(&mut full, rec.len());
    pdb_append(&mut full, &rec);
    pdb_append(&mut g_pdb_tpi, &full);
    // the hash a reader looks the record up by (LLVM TpiHashing): a named
    // struct by its name, anything else by the record's bytes
    g_pdb_tpi_hash.push(pdb_jamcrc(&full));
    var idx: i64 = 0x1000 + g_pdb_ntypes;
    g_pdb_ntypes = g_pdb_ntypes + 1;
    return idx;
}

/// A CodeView numeric leaf (an unsigned value).
fn pdb_numeric(out: &mut Vec<i64>, v: i64) {
    if v >= 0 && v < 0x8000 {
        pdb_u16(out, v);
    } else {
        pdb_u16(out, 0x8004);
        pdb_u32(out, v);
    }
}

/// The CodeView type index of DWARF type entry `ti` (a position in `d`):
/// 0 (no type) when it is unknown.
fn pdb_cv_type(d: &PdbDies, map: i64, ti: i64) -> i64 {
    if ti < 0 || ti >= d.tag.len() {
        return 0;
    }
    var key: str = int_to_str(ti);
    if HashMap_contains(g_pdb_tymap, key) {
        var known: i64 = HashMap_get(g_pdb_tymap, key);
        if known == 0 {
            return PDB_T_64PVOID;
        }
        return known - 1;
    }
    var tag: i64 = d.tag.get(ti);
    var r: i64 = 0;
    if tag == 0x24 {
        r = pdb_cv_base(d.enc.get(ti), d.size.get(ti));
    } else if tag == 0x16 || tag == 0x26 || tag == 0x35 {
        // typedef, const, volatile: what they name
        HashMap_insert(g_pdb_tymap, key, 0);
        r = pdb_cv_type(d, map, pdb_die_at(d, d.ty.get(ti), map));
    } else if tag == 0x0F || tag == 0x10 {
        // a pointer (or reference)
        var pt: i64 = pdb_die_at(d, d.ty.get(ti), map);
        if pt < 0 {
            r = PDB_T_64PVOID;
        } else {
            HashMap_insert(g_pdb_tymap, key, 0);
            var inner: i64 = pdb_cv_type(d, map, pt);
            r = pdb_pointer_to(inner);
        }
    } else if tag == 0x13 || tag == 0x17 {
        // a struct (or union): its members first
        HashMap_insert(g_pdb_tymap, key, 0);
        var fl: Vec<i64> = Vec::new();
        var count: i64 = 0;
        var k: i64 = ti + 1;
        while k < d.tag.len() && d.parent.get(k) >= ti {
            if d.parent.get(k) == ti && d.tag.get(k) == 0x0D {
                var mt: i64 = pdb_cv_type(d, map, pdb_die_at(d, d.ty.get(k), map));
                pdb_u16(&mut fl, PDB_LF_MEMBER);
                pdb_u16(&mut fl, 3);
                // public
                pdb_u32(&mut fl, mt);
                pdb_numeric(&mut fl, d.memloc.get(k));
                pdb_cstr(&mut fl, d.name.get(k));
                while fl.len() % 4 != 0 {
                    fl.push(0xF0 + (4 - fl.len() % 4));
                }
                count = count + 1;
            }
            k = k + 1;
        }
        var fli: i64 = pdb_tpi_add(PDB_LF_FIELDLIST, &fl);
        var st: Vec<i64> = Vec::new();
        pdb_u16(&mut st, count);
        pdb_u16(&mut st, 0);
        // properties
        pdb_u32(&mut st, fli);
        pdb_u32(&mut st, 0);
        // derived from
        pdb_u32(&mut st, 0);
        // vshape
        pdb_numeric(&mut st, d.size.get(ti));
        var sname: str = d.name.get(ti);
        if sname == "" {
            sname = "<anonymous>";
        }
        pdb_cstr(&mut st, sname);
        r = pdb_tpi_add(PDB_LF_STRUCTURE, &st);
        g_pdb_tpi_hash.set(g_pdb_tpi_hash.len() - 1, pdb_hash_v1(sname));
    }
    HashMap_insert(g_pdb_tymap, key, r + 1);
    return r;
}

/// The type index of a 64-bit pointer to type `inner`.
fn pdb_pointer_to(inner: i64) -> i64 {
    if inner == 0 {
        return PDB_T_64PVOID;
    }
    if inner == 0x0020 || inner == 0x0010 || inner == 0x0068 || inner == 0x0069 {
        return PDB_T_64PRCHAR;
    }
    // str: char *, shown as text
    if inner < 0x100 {
        return 0x0600 | inner;
    }
    var pb: Vec<i64> = Vec::new();
    pdb_u32(&mut pb, inner);
    pdb_u32(&mut pb, 0x0C | (8 << 13));
    // near 64-bit pointer, 8 bytes
    return pdb_tpi_add(PDB_LF_POINTER, &pb);
}

/// The CFA rules of .debug_frame `fr` for code [lo, hi) (VAs): the rule
/// that covers most of the function, as [DWARF register, offset]; rbp + 16
/// (`push rbp; mov rbp, rsp`) when no FDE covers `lo`.
fn pdb_cfa_rule(fr: &Vec<i64>, lo: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(6);
    out.push(16);
    // the CIEs' initial rules and factors: offset -> [code align, data
    // align, register, offset]
    var p: i64 = 0;
    while p + 8 <= fr.len() {
        var len: i64 = pdb_get_u32(fr, p);
        if len == 0 || len == 0xFFFFFFFF {
            break;
        }
        var start: i64 = p + 4;
        var end: i64 = start + len;
        var id: i64 = pdb_get_u32(fr, start);
        if id != 0xFFFFFFFF && start + 4 + 16 <= end {
            var cie: i64 = id;
            var floc: i64 = pdb_get_u64(fr, start + 4);
            var frange: i64 = pdb_get_u64(fr, start + 12);
            if lo >= floc && lo < floc + frange {
                // the CIE: version, augmentation "", code / data alignment,
                // return register, initial instructions
                var clen: i64 = pdb_get_u32(fr, cie);
                var cend: i64 = cie + 4 + clen;
                var cver: i64 = fr.get(cie + 8);
                g_pdb_rd = cie + 9;
                while g_pdb_rd < cend && fr.get(g_pdb_rd) != 0 {
                    g_pdb_rd = g_pdb_rd + 1;
                }
                g_pdb_rd = g_pdb_rd + 1;
                // DWARF 4: address and segment selector sizes
                if cver >= 4 {
                    g_pdb_rd = g_pdb_rd + 2;
                }
                var caf: i64 = pdb_uleb(fr);
                pdb_sleb(fr);
                pdb_uleb(fr);
                var reg: i64 = 7;
                var off: i64 = 8;
                // run the CIE's then the FDE's instructions; the rule held
                // over the longest stretch wins
                var best_reg: i64 = 7;
                var best_off: i64 = 8;
                var best_len: i64 = -1;
                var pc: i64 = floc;
                var seg_start: i64 = floc;
                var pass: i64 = 0;
                while pass < 2 {
                    var iend: i64 = cend;
                    if pass == 1 {
                        g_pdb_rd = start + 20;
                        iend = end;
                    }
                    while g_pdb_rd < iend {
                        var op: i64 = fr.get(g_pdb_rd);
                        g_pdb_rd = g_pdb_rd + 1;
                        var hi2: i64 = op & 0xC0;
                        var adv: i64 = -1;
                        if hi2 == 0x40 {
                            adv = (op & 0x3F) * caf;
                        } else if hi2 == 0x80 {
                            pdb_uleb(fr);
                        } else if hi2 == 0xC0 {
                        } else if op == 0x02 {
                            adv = fr.get(g_pdb_rd) * caf;
                            g_pdb_rd = g_pdb_rd + 1;
                        } else if op == 0x03 {
                            adv = pdb_get_u16(fr, g_pdb_rd) * caf;
                            g_pdb_rd = g_pdb_rd + 2;
                        } else if op == 0x04 {
                            adv = pdb_get_u32(fr, g_pdb_rd) * caf;
                            g_pdb_rd = g_pdb_rd + 4;
                        } else if op == 0x0C {
                            reg = pdb_uleb(fr);
                            off = pdb_uleb(fr);
                        } else if op == 0x0D {
                            reg = pdb_uleb(fr);
                        } else if op == 0x0E {
                            off = pdb_uleb(fr);
                        } else if op == 0x05 || op == 0x10 || op == 0x14 || op == 0x16 {
                            pdb_uleb(fr);
                            if op == 0x05 || op == 0x14 {
                                pdb_uleb(fr);
                            } else if op == 0x10 || op == 0x16 {
                                var bl: i64 = pdb_uleb(fr);
                                g_pdb_rd = g_pdb_rd + bl;
                            }
                        } else if op == 0x06 || op == 0x07 || op == 0x08 {
                            pdb_uleb(fr);
                        } else if op == 0x09 {
                            pdb_uleb(fr);
                            pdb_uleb(fr);
                        } else if op == 0x0F {
                            var el: i64 = pdb_uleb(fr);
                            g_pdb_rd = g_pdb_rd + el;
                        } else if op == 0x11 || op == 0x12 {
                            pdb_uleb(fr);
                            pdb_sleb(fr);
                        } else if op == 0x13 {
                            off = pdb_sleb(fr);
                        } else if op == 0x00 || op == 0x0A || op == 0x0B {
                        } else {
                            // an instruction not read here: keep what we have
                            g_pdb_rd = iend;
                        }
                        if adv >= 0 {
                            if pc + adv - seg_start > best_len {
                                best_len = pc + adv - seg_start;
                                best_reg = reg;
                                best_off = off;
                            }
                            pc = pc + adv;
                            seg_start = pc;
                        }
                    }
                    pass = pass + 1;
                }
                if floc + frange - seg_start > best_len {
                    best_reg = reg;
                    best_off = off;
                }
                out.set(0, best_reg);
                out.set(1, best_off);
                return out;
            }
        }
        p = end;
    }
    return out;
}

/// What a location expression [at, at + len) of `b` says, for CodeView:
/// [0 the memory at register + offset, register, offset, deref?] or [1 a
/// register, register, 0, 0]; an empty Vec for anything else (a constant,
/// a value computed on the stack). DW_OP_fbreg is relative to the CFA
/// `cfa` ([register, offset]).
fn pdb_loc_expr(b: &Vec<i64>, at: i64, len: i64, cfa: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if len <= 0 {
        return out;
    }
    g_pdb_rd = at;
    var op: i64 = b.get(g_pdb_rd);
    g_pdb_rd = g_pdb_rd + 1;
    var reg: i64 = -1;
    var off: i64 = 0;
    var mem: bool = true;
    if op == 0x91 {
        off = cfa.get(1) + pdb_sleb(b);
        reg = cfa.get(0);
    } else if op >= 0x70 && op <= 0x8F {
        reg = op - 0x70;
        off = pdb_sleb(b);
    } else if op == 0x92 {
        reg = pdb_uleb(b);
        off = pdb_sleb(b);
    } else if op >= 0x50 && op <= 0x6F {
        reg = op - 0x50;
        mem = false;
    } else if op == 0x90 {
        reg = pdb_uleb(b);
        mem = false;
    } else {
        return out;
    }
    var deref: i64 = 0;
    if g_pdb_rd < at + len {
        if mem && b.get(g_pdb_rd) == 0x06 && g_pdb_rd + 1 == at + len {
            deref = 1;
        } else {
            return out;
        }
    }
    var cv: i64 = pdb_cv_reg(reg);
    if cv == 0 {
        return out;
    }
    if mem {
        out.push(0);
    } else {
        out.push(1);
    }
    out.push(cv);
    out.push(off);
    out.push(deref);
    return out;
}

/// The variables of the image `pe` (empty when it has no .debug_info).
pub fn pdb_dwarf_locals(pe: &Vec<i64>) -> PdbLocals {
    g_pdb_tpi = Vec::new();
    g_pdb_ntypes = 0;
    g_pdb_tpi_hash = Vec::new();
    g_pdb_tymap = HashMap_new();
    var res: PdbLocals = PdbLocals {
        fn_starts: Vec::new(), fn_items: Vec::new(), types: Vec::new(), ntypes: 0, hashes: Vec::new(),
    };
    var lay: Vec<i64> = pdb_pe_layout(pe);
    var si: Vec<i64> = pdb_pe_section(pe, ".debug_info");
    var sa: Vec<i64> = pdb_pe_section(pe, ".debug_abbrev");
    if lay.len() == 0 || si.len() == 0 || sa.len() == 0 || lay.get(1) == 0 {
        return res;
    }
    var image_base: i64 = pdb_get_u64(pe, lay.get(2) + 24);
    var text_rva: i64 = pdb_get_u32(pe, lay.get(3) + 12);
    var text_va: i64 = image_base + text_rva;
    var info: Vec<i64> = pdb_slice(pe, si.get(0), si.get(1));
    var ab: Vec<i64> = pdb_slice(pe, sa.get(0), sa.get(1));
    var fr: Vec<i64> = Vec::new();
    var sf: Vec<i64> = pdb_pe_section(pe, ".debug_frame");
    if sf.len() > 0 {
        fr = pdb_slice(pe, sf.get(0), sf.get(1));
    }
    var dloc: Vec<i64> = Vec::new();
    var sl: Vec<i64> = pdb_pe_section(pe, ".debug_loc");
    if sl.len() > 0 {
        dloc = pdb_slice(pe, sl.get(0), sl.get(1));
    }
    var d: PdbDies = pdb_read_dies(&info, &ab);
    var map: i64 = HashMap_new();
    var i: i64 = 0;
    while i < d.off.len() {
        HashMap_insert(map, int_to_str(d.off.get(i)), i + 1);
        i = i + 1;
    }
    i = 0;
    while i < d.tag.len() {
        if d.tag.get(i) == 0x2E && d.lo.get(i) >= text_va && d.hi.get(i) > 0 {
            var lo: i64 = d.lo.get(i);
            var hi: i64 = lo + d.hi.get(i);
            var cfa: Vec<i64> = pdb_cfa_rule(&fr, lo);
            var items: Vec<PdbVarItem> = Vec::new();
            pdb_scope_items(&d, map, i, &info, &dloc, &cfa, text_va, lo, hi, &mut items);
            if items.len() > 0 {
                res.fn_starts.push(lo - text_va);
                res.fn_items.push(items);
            }
        }
        i = i + 1;
    }
    res.types = g_pdb_tpi;
    res.ntypes = g_pdb_ntypes;
    res.hashes = g_pdb_tpi_hash;
    return res;
}

/// The items of scope `si` (a function or lexical block) of `d`: its
/// variables, then its blocks with theirs (as CodeView nests them).
fn pdb_scope_items(d: &PdbDies, map: i64, si: i64, info: &Vec<i64>, dloc: &Vec<i64>, cfa: &Vec<i64>, text_va: i64, fn_lo: i64, fn_hi: i64, items: &mut Vec<PdbVarItem>) {
    // the scope's variables: those with one location (S_REGREL32,
    // S_REGISTER) before those with ranges (S_LOCAL and its S_DEFRANGEs):
    // dbghelp lists no S_REGREL32 that follows an S_LOCAL of its scope
    var vars: Vec<PdbVarItem> = Vec::new();
    var k: i64 = si + 1;
    while k < d.tag.len() && d.parent.get(k) >= si {
        if d.parent.get(k) == si {
            var tag: i64 = d.tag.get(k);
            if (tag == 0x05 || tag == 0x34) && d.name.get(k) != "" && d.loc_kind.get(k) != 0 {
                pdb_var_item(d, map, k, info, dloc, cfa, text_va, fn_lo, fn_hi, &mut vars);
            }
        }
        k = k + 1;
    }
    var pass: i64 = 0;
    while pass < 2 {
        var vi: i64 = 0;
        while vi < vars.len() {
            var v: PdbVarItem = vars.get(vi);
            if (v.kind == 2) == (pass == 1) {
                items.push(v);
            }
            vi = vi + 1;
        }
        pass = pass + 1;
    }
    k = si + 1;
    while k < d.tag.len() && d.parent.get(k) >= si {
        if d.parent.get(k) == si && d.tag.get(k) == 0x0B && d.hi.get(k) > 0 {
            items.push(PdbVarItem {
                kind: 10, name: "", ty: 0, reg: 0, off: 0, lo: d.lo.get(k) - text_va, len: d.hi.get(k), is_param: false, ranges: Vec::new(),
            });
            pdb_scope_items(d, map, k, info, dloc, cfa, text_va, fn_lo, fn_hi, items);
            items.push(PdbVarItem {
                kind: 11, name: "", ty: 0, reg: 0, off: 0, lo: 0, len: 0, is_param: false, ranges: Vec::new(),
            });
        }
        k = k + 1;
    }
}

/// The item of variable entry `k`, when its location is one CodeView can
/// say.
fn pdb_var_item(d: &PdbDies, map: i64, k: i64, info: &Vec<i64>, dloc: &Vec<i64>, cfa: &Vec<i64>, text_va: i64, fn_lo: i64, fn_hi: i64, items: &mut Vec<PdbVarItem>) {
    var ty: i64 = pdb_cv_type(d, map, pdb_die_at(d, d.ty.get(k), map));
    var is_param: bool = d.tag.get(k) == 0x05;
    if d.loc_kind.get(k) == 1 {
        var e: Vec<i64> = pdb_loc_expr(info, d.loc_at.get(k), d.loc_len.get(k), cfa);
        if e.len() == 0 {
            return;
        }
        var vty: i64 = ty;
        if e.get(3) == 1 {
            vty = pdb_pointer_to(ty);
        }
        var kind: i64 = 0;
        if e.get(0) == 1 {
            kind = 1;
        }
        items.push(PdbVarItem {
            kind: kind, name: d.name.get(k), ty: vty, reg: e.get(1), off: e.get(2), lo: 0, len: 0, is_param: is_param, ranges: Vec::new(),
        });
        return;
    }
    // a location list: [begin, end) pairs relative to the unit's base
    var ranges: Vec<i64> = Vec::new();
    var base: i64 = d.cu_base.get(k);
    var p: i64 = d.loc_at.get(k);
    var deref_seen: bool = false;
    while p + 16 <= dloc.len() {
        var s: i64 = pdb_get_u64(dloc, p);
        var t: i64 = pdb_get_u64(dloc, p + 8);
        p = p + 16;
        if s == 0 && t == 0 {
            break;
        }
        if s == -1 {
            base = t;
            continue;
        }
        var n: i64 = pdb_get_u16(dloc, p);
        p = p + 2;
        var e2: Vec<i64> = pdb_loc_expr(dloc, p, n, cfa);
        p = p + n;
        if e2.len() > 0 && e2.get(3) == 0 {
            var a0: i64 = base + s;
            var a1: i64 = base + t;
            // CodeView ranges are at most 0xFFFF bytes: split longer ones
            while a1 > a0 {
                var piece: i64 = a1 - a0;
                if piece > 0xFFFF {
                    piece = 0xFFFF;
                }
                ranges.push(a0 - text_va);
                ranges.push(piece);
                ranges.push(1 - e2.get(0));
                ranges.push(e2.get(1));
                ranges.push(e2.get(2));
                a0 = a0 + piece;
            }
        } else if e2.len() > 0 {
            deref_seen = true;
        }
    }
    if ranges.len() == 0 {
        return;
    }
    items.push(PdbVarItem {
        kind: 2, name: d.name.get(k), ty: ty, reg: 0, off: 0, lo: 0, len: 0, is_param: is_param, ranges: ranges,
    });
}

/// Write the items of a function (S_GPROC32 at `proc_at` of `msyms`) into
/// its symbols: blocks get their parent and end.
fn pdb_put_items(msyms: &mut Vec<i64>, proc_at: i64, items: &Vec<PdbVarItem>) {
    var stack: Vec<i64> = Vec::new();
    stack.push(proc_at);
    var i: i64 = 0;
    while i < items.len() {
        var it: PdbVarItem = items.get(i);
        if it.kind == 10 {
            var b: i64 = pdb_rec_begin(msyms, PDB_S_BLOCK32);
            pdb_u32(msyms, stack.get(stack.len() - 1));
            // parent
            pdb_u32(msyms, 0);
            // end (set at its S_END)
            pdb_u32(msyms, it.len);
            pdb_u32(msyms, it.lo);
            pdb_u16(msyms, 1);
            pdb_cstr(msyms, "");
            pdb_rec_end(msyms, b);
            stack.push(b);
        } else if it.kind == 11 {
            if stack.len() > 1 {
                var e: i64 = pdb_rec_begin(msyms, PDB_S_END);
                pdb_rec_end(msyms, e);
                pdb_set_u32(msyms, stack.get(stack.len() - 1) + 8, e);
                stack.pop();
            }
        } else if it.kind == 0 {
            var r: i64 = pdb_rec_begin(msyms, PDB_S_REGREL32);
            pdb_u32(msyms, it.off & 0xFFFFFFFF);
            pdb_u32(msyms, it.ty);
            pdb_u16(msyms, it.reg);
            pdb_cstr(msyms, it.name);
            pdb_rec_end(msyms, r);
        } else if it.kind == 1 {
            var r1: i64 = pdb_rec_begin(msyms, PDB_S_REGISTER);
            pdb_u32(msyms, it.ty);
            pdb_u16(msyms, it.reg);
            pdb_cstr(msyms, it.name);
            pdb_rec_end(msyms, r1);
        } else if it.kind == 2 {
            var r2: i64 = pdb_rec_begin(msyms, PDB_S_LOCAL);
            pdb_u32(msyms, it.ty);
            if it.is_param {
                pdb_u16(msyms, 1);
            } else {
                pdb_u16(msyms, 0);
            }
            pdb_cstr(msyms, it.name);
            pdb_rec_end(msyms, r2);
            var q: i64 = 0;
            while q + 5 <= it.ranges.len() {
                var rs: i64 = it.ranges.get(q);
                var rl: i64 = it.ranges.get(q + 1);
                if it.ranges.get(q + 2) == 0 {
                    var dr: i64 = pdb_rec_begin(msyms, PDB_S_DEFRANGE_REGISTER);
                    pdb_u16(msyms, it.ranges.get(q + 3));
                    pdb_u16(msyms, 0);
                    pdb_u32(msyms, rs);
                    pdb_u16(msyms, 1);
                    pdb_u16(msyms, rl);
                    pdb_rec_end(msyms, dr);
                } else {
                    var dx: i64 = pdb_rec_begin(msyms, PDB_S_DEFRANGE_REGISTER_REL);
                    pdb_u16(msyms, it.ranges.get(q + 3));
                    pdb_u16(msyms, 0);
                    pdb_u32(msyms, it.ranges.get(q + 4) & 0xFFFFFFFF);
                    pdb_u32(msyms, rs);
                    pdb_u16(msyms, 1);
                    pdb_u16(msyms, rl);
                    pdb_rec_end(msyms, dx);
                }
                q = q + 5;
            }
        }
        i = i + 1;
    }
    // a block left open (should not happen): close it
    while stack.len() > 1 {
        var e2: i64 = pdb_rec_begin(msyms, PDB_S_END);
        pdb_rec_end(msyms, e2);
        pdb_set_u32(msyms, stack.get(stack.len() - 1) + 8, e2);
        stack.pop();
    }
}

/// The TPI stream: its header, then `records` (`n` of them); with records,
/// their hashes are in stream `hash_stream`.
fn pdb_tpi_stream(records: &Vec<i64>, n: i64, hash_stream: i64) -> Vec<i64> {
    var out: Vec<i64> = pdb_tpi_header();
    pdb_set_u32(&mut out, 12, 0x1000 + n);
    pdb_set_u32(&mut out, 16, records.len());
    if n > 0 {
        pdb_set_u16(&mut out, 20, hash_stream);
        // the hash values, one index offset, no adjusters
        pdb_set_u32(&mut out, 32, 0);
        pdb_set_u32(&mut out, 36, 4 * n);
        pdb_set_u32(&mut out, 40, 4 * n);
        pdb_set_u32(&mut out, 44, 8);
        pdb_set_u32(&mut out, 48, 4 * n + 8);
        pdb_set_u32(&mut out, 52, 0);
    }
    pdb_append(&mut out, records);
    return out;
}

/// The TPI hash stream of records with `hashes`: each hash modulo the
/// bucket count (0x3FFFF, pdb_tpi_header), then the index offset of the
/// first record (type 0x1000 at offset 0).
fn pdb_tpi_hash_stream(hashes: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < hashes.len() {
        pdb_u32(&mut out, hashes.get(i) % 0x3FFFF);
        i = i + 1;
    }
    pdb_u32(&mut out, 0x1000);
    pdb_u32(&mut out, 0);
    return out;
}

/// JamCRC (CRC-32 without the final inversion) of `b`: LLVM's
/// hashBufferV8, the hash of a type record that is not a named struct.
fn pdb_jamcrc(b: &Vec<i64>) -> i64 {
    var crc: i64 = 0xFFFFFFFF;
    var i: i64 = 0;
    while i < b.len() {
        crc = crc ^ (b.get(i) & 255);
        var k: i64 = 0;
        while k < 8 {
            if (crc & 1) != 0 {
                crc = (crc >> 1) ^ 0xEDB88320;
            } else {
                crc = crc >> 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return crc & 0xFFFFFFFF;
}

// --- MSF ----------------------------------------------------------------------

/// The next block at or after `b` that is not a free block map block
/// (blocks 1 and 2 of every 4096).
fn pdb_msf_next(b: i64) -> i64 {
    var x: i64 = b;
    while x % PDB_BLOCK == 1 || x % PDB_BLOCK == 2 {
        x = x + 1;
    }
    return x;
}

/// The MSF 7.00 container ("big MSF", blocks of 4096 bytes) of `streams`:
/// block 0 the superblock, 1 and 2 (and 1, 2 of every 4096) the free block
/// maps, then each stream's blocks, the stream directory (number of
/// streams, their sizes, their blocks) and the block that lists the
/// directory's blocks. Every block is used: the free block map has a 0 bit
/// for each block of the file, 1 after.
pub fn pdb_msf(streams: &Vec<Vec<i64>>) -> Vec<i64> {
    var bs: i64 = PDB_BLOCK;
    var next: i64 = 3;
    var blocks: Vec<i64> = Vec::new();
    var counts: Vec<i64> = Vec::new();
    var s: i64 = 0;
    while s < streams.len() {
        var st: Vec<i64> = streams.get(s);
        var nb: i64 = (st.len() + bs - 1) / bs;
        counts.push(nb);
        var k: i64 = 0;
        while k < nb {
            next = pdb_msf_next(next);
            blocks.push(next);
            next = next + 1;
            k = k + 1;
        }
        s = s + 1;
    }
    var dir: Vec<i64> = Vec::new();
    pdb_u32(&mut dir, streams.len());
    s = 0;
    while s < streams.len() {
        var st2: Vec<i64> = streams.get(s);
        pdb_u32(&mut dir, st2.len());
        s = s + 1;
    }
    var bi: i64 = 0;
    while bi < blocks.len() {
        pdb_u32(&mut dir, blocks.get(bi));
        bi = bi + 1;
    }
    var ndir: i64 = (dir.len() + bs - 1) / bs;
    var dir_blocks: Vec<i64> = Vec::new();
    var d: i64 = 0;
    while d < ndir {
        next = pdb_msf_next(next);
        dir_blocks.push(next);
        next = next + 1;
        d = d + 1;
    }
    next = pdb_msf_next(next);
    var map_block: i64 = next;
    next = next + 1;
    var num_blocks: i64 = next;
    var out: Vec<i64> = Vec::new();
    var t: i64 = 0;
    while t < num_blocks * bs {
        out.push(0);
        t = t + 1;
    }
    // the superblock
    var magic: str = "Microsoft C/C++ MSF 7.00\r\n";
    var m: i64 = 0;
    while m < str_len(magic) {
        out.set(m, str_byte_at(magic, m) & 255);
        m = m + 1;
    }
    out.set(26, 0x1A);
    out.set(27, 0x44);
    out.set(28, 0x53);
    pdb_set_u32(&mut out, 32, bs);
    pdb_set_u32(&mut out, 36, 1);
    // the free block map in use: blocks 1, 4097, ...
    pdb_set_u32(&mut out, 40, num_blocks);
    pdb_set_u32(&mut out, 44, dir.len());
    pdb_set_u32(&mut out, 48, 0);
    pdb_set_u32(&mut out, 52, map_block);
    // the free block maps: byte j of the map (spread over blocks 1, 4097,
    // ... ; block 2's copy alike) holds the bits of blocks 8j .. 8j + 7
    var fb: i64 = 1;
    while fb < num_blocks {
        var interval: i64 = fb / bs;
        var q: i64 = 0;
        while q < bs {
            var j: i64 = interval * bs + q;
            var byte: i64 = 0;
            var bit: i64 = 0;
            while bit < 8 {
                if 8 * j + bit >= num_blocks {
                    byte = byte | (1 << bit);
                }
                bit = bit + 1;
            }
            out.set(fb * bs + q, byte);
            if fb + 1 < num_blocks {
                out.set((fb + 1) * bs + q, byte);
            }
            q = q + 1;
        }
        fb = fb + bs;
    }
    // the streams
    var bpos: i64 = 0;
    s = 0;
    while s < streams.len() {
        var st3: Vec<i64> = streams.get(s);
        var n: i64 = st3.len();
        var c: i64 = 0;
        while c < n {
            var blk: i64 = blocks.get(bpos + c / bs);
            out.set(blk * bs + c % bs, st3.get(c) & 255);
            c = c + 1;
        }
        bpos = bpos + counts.get(s);
        s = s + 1;
    }
    // the directory and its block list
    var dc: i64 = 0;
    while dc < dir.len() {
        out.set(dir_blocks.get(dc / bs) * bs + dc % bs, dir.get(dc));
        dc = dc + 1;
    }
    d = 0;
    while d < dir_blocks.len() {
        pdb_set_u32(&mut out, map_block * bs + 4 * d, dir_blocks.get(d));
        d = d + 1;
    }
    return out;
}
