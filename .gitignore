/target
/target2
Cargo.lock
*.exe
*.obj
*.lib
*.pdb

# Self-hosted compiler build output (built by fidesc, not Rust)
# release/ contains the Fides-compiled compiler (.c + .exe)
/release/*
!/release/.gitkeep

# Generated C output from test runs (auto-generated from .fd files)
# Only ignore in tests/ root, NOT in tests/selfhost/ or tests/golden/ (those are tracked source)
tests/*.c
tests/*.bak

# Compiled test binaries (no extension, built from .c or .fd)
tests/test_async
tests/test_float
tests/test_generics

# Self-host compiled binaries (built from .c sources in tests/selfhost/)
tests/selfhost/probe_argc
tests/selfhost/probe_argc2
tests/selfhost/probe_parser_simple
tests/selfhost/probe_parser_simple_asan
tests/selfhost/test_lexer_harness
tests/selfhost/test_mut
tests/selfhost/test_parser_asan
tests/selfhost/test_parser_harness
tests/selfhost/test_parser_harness_dbg
tests/selfhost/tpa
tests/selfhost/tpa_dbg
tests/selfhost/vec_expr_test
tests/selfhost/vec_fieldinit_test

# Stray debug/build artifacts in repo root
output.s
--opt

# Build artifacts in repo root (generated by ccompile/bootstrap)
/fides-*.c
/fides-*.exe
/fides-bootstrap
/fides-rust
/fides-self
/test_*.c
/test_*.exe
/test_min*.fd
/test_opt_compile.fd
/hello.c
/hello.exe
/stage*.c
/stage*.exe

# scripts/bootstrap.sh output
build/

# Written by tests/bootstrap/test_plot.fd into the directory it runs from
/test_plot*.svg
/test_plot*.html
.fidcache/
