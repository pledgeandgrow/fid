/target
/target2
# Cargo.lock is committed: fidesc is a binary, and Dependabot reads it
*.exe
*.obj
*.lib
*.pdb

# Self-hosted compiler output (built by fidesc, not Rust)
# release/ keeps user-facing binaries; generated intermediates go under build/.
/release/*
!/release/.gitkeep

# Generated C output from test runs (auto-generated from .fd files)
# Only ignore in tests/ root, NOT in tests/selfhost/ or tests/golden/ (those are tracked source)
tests/*.c
tests/*.bak

# Compiled test binaries (no extension, built from .c or .fd)
tests/test_async
tests/test_float
tests/test_generics

# Self-host compiled binaries (built from .c sources in tests/selfhost/)
tests/selfhost/probe_argc
tests/selfhost/probe_argc2
tests/selfhost/probe_parser_simple
tests/selfhost/probe_parser_simple_asan
tests/selfhost/test_lexer_harness
tests/selfhost/test_mut
tests/selfhost/test_parser_asan
tests/selfhost/test_parser_harness
tests/selfhost/test_parser_harness_dbg
tests/selfhost/tpa
tests/selfhost/tpa_dbg
tests/selfhost/vec_expr_test
tests/selfhost/vec_fieldinit_test

# Stray debug/build artifacts in repo root
output.s
--opt

# Build artifacts in repo root (generated by ccompile/bootstrap)
/fides-*.c
/fides-*.exe
/fides-bootstrap
/fides-rust
/fides-self
/test_*.c
/test_*.exe
/test_min*.fd
/test_opt_compile.fd
/hello.c
/hello.exe
/stage*.c
/stage*.exe

# scripts/bootstrap.sh output
build/

# Legacy project-root outputs from before tests used tests/ paths
/test_plot*.svg
/test_plot*.html
# Generated test outputs. Tests are run from the repository root.
/tests/*.tmp
/tests/*.sock
/tests/_*_check.*
/tests/_fides_test_list.txt
/tests/_fides_test_tmp
/tests/frame.png
/tests/bg41_input_*.txt
/tests/build_bg81_*
/tests/build_os_services_*
/tests/fid_unix_*.sock
/tests/fid_bg39_*.sock
/tests/fides_test_config_*.ini
/tests/fides_test_lib_log_*.log
/tests/key.bin
/tests/test_plot*.svg
/tests/test_plot*.html
.fidcache/
/target3

# Incremental build stamps (regenerated by every fid/fidesc build)
*.fides-stamp

# Memcheck temp output from `run --leaks` / `--checked-alloc`
/_fides_memcheck_tmp.*

# dump-c / ccompile output dropped at repo root
/*.c

# Agent scratch area — experiments, not source
/scratch/

# Python caches of scripts/ and tests/
__pycache__/
*.pyc

# Temp files left by interrupted runs
/fdt_*.tmp

# Legacy project-root outputs from local tests and the self-hosted compiler
/fid_unix_*.sock
/fides_test_config.ini
/test_fs_stream.tmp
/bg41_input_*.txt
/off
/*.fides-fncache.pe
/scripts/_tmp_cs_note.py

# Release checksums (scripts/release-checksums.sh), published, not committed
/SHA256SUMS.txt
