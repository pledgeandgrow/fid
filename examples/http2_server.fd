// Example: an HTTP/2 server (h2c, prior knowledge) with the handlers of
// module `http`, and an HTTP/2 client talking to it.
//
//   CC="zig cc" fid ccompile examples/http2_server.fd -o h2.exe
//   ./h2.exe serve 8091        serve until GET /stop
//       curl --http2-prior-knowledge http://127.0.0.1:8091/
//       (or any HTTP/2 client that speaks h2c with prior knowledge);
//       it also takes `curl --http2` (the h2c Upgrade from HTTP/1.1) and
//       answers a plain HTTP/1.1 request over HTTP/1.1
//   ./h2.exe get 8091 /path    our client against any h2c server
//   ./h2.exe selftest 8092     the server on tasks, and our client against
//                              it: one GET, a POST, five GETs at once on one
//                              connection, a 200 KB body (flow control)
//
// Needs tasks that run side by side for selftest: C and native builds
// (`fid run` runs a task to its end when it starts).

use vec;
use string;
use http;
use http2;
use task;

fn big_body() -> str {
    var sb: StringBuilder = StringBuilder::new();
    var i: i64 = 0;
    while i < 4000 {
        sb.append_str("line " + str_pad_left(int_to_str(i), 5, 48) + " of the big body....................\n");
        i = i + 1;
    }
    return sb.to_str();
}

fn route(req: HttpRequest) -> str {
    if req.path == "/" {
        return build_response(200, "text/plain", "Hello over HTTP/2 from Fides! "
            + req.method + " " + req.target + " (HTTP/" + req.version + ", host " + http_header(req, "host") + ")\n");
    }
    if req.path == "/echo" {
        return build_response(200, "text/plain", "you sent " + int_to_str(str_len(req.body)) + " bytes: " + req.body);
    }
    if req.path == "/big" {
        return build_response(200, "text/plain", big_body());
    }
    if req.path == "/stop" {
        http2_stop();
        return build_response(200, "text/plain", "stopping\n");
    }
    return build_response_headers(404, "text/plain", "X-Fides: h2\r\n", "Not Found: " + req.path + "\n");
}

fn selftest(port: i64) -> i64 {
    val fd: i64 = p_socket_listen(port);
    if fd < 0 {
        println("cannot listen on " + int_to_str(port));
        return 1;
    }
    http2_listen_tasks(fd, route);
    // The client is a task too: its waits let the server's tasks run
    task_go("client_task", port);
    task_run();
    return 0;
}

pub fn client_task(port: i64) -> i64 {
    val r: Http2Response = http2_get("127.0.0.1", port, "/?a=1");
    if r.status == 0 {
        println("GET failed: " + r.error);
    }
    println("GET /?a=1 -> " + int_to_str(r.status) + " " + http2_header(r, "content-type") + ": " + r.body);
    val p: Http2Response = http2_post("127.0.0.1", port, "/echo", "text/plain", "hello h2");
    println("POST /echo -> " + int_to_str(p.status) + ": " + p.body);
    var paths: Vec<str> = Vec::new();
    paths.push("/");
    paths.push("/missing");
    paths.push("/echo");
    paths.push("/big");
    paths.push("/?last");
    val many: Vec<Http2Response> = http2_get_many("127.0.0.1", port, paths);
    var i: i64 = 0;
    while i < many.len() {
        val m: Http2Response = many.get(i);
        var shown: str = m.body;
        if str_len(shown) > 60 {
            shown = str_slice(shown, 0, 40) + "... (" + int_to_str(str_len(m.body)) + " bytes)\n";
        }
        println("stream " + int_to_str(m.stream) + " " + paths.get(i) + " -> " + int_to_str(m.status)
            + " x-fides=" + http2_header(m, "x-fides") + ": " + shown);
        i = i + 1;
    }
    val big: Http2Response = http2_get("127.0.0.1", port, "/big");
    println("GET /big -> " + int_to_str(big.status) + ", " + int_to_str(str_len(big.body))
        + " bytes, same as served: " + bool_to_str(big.body == big_body()));
    http2_stop();
    return 0;
}

fn main() -> i64 {
    var mode: str = "serve";
    var port: i64 = 8091;
    match arg_at(1) {
        Option::Some(m) => { mode = m; }
        Option::None => {}
    }
    match arg_at(2) {
        Option::Some(p) => { port = str_parse_int(p); }
        Option::None => {}
    }
    if mode == "selftest" {
        return selftest(port);
    }
    if mode == "get" {
        var path: str = "/";
        match arg_at(3) {
            Option::Some(x) => { path = x; }
            Option::None => {}
        }
        val r: Http2Response = http2_get("127.0.0.1", port, path);
        if r.status == 0 {
            println("no response: " + r.error);
            return 1;
        }
        println(int_to_str(r.status) + " " + http2_header(r, "content-type") + " " + int_to_str(str_len(r.body)) + " bytes");
        print(r.body);
        return 0;
    }
    println("HTTP/2 (h2c) on port " + int_to_str(port));
    if !http2_serve(port, route) {
        println("Cannot open port " + int_to_str(port));
        return 1;
    }
    return 0;
}
