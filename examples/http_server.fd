// Example: HTTP server in Pledge — Phase 5D.3
// Run with: pledgec run examples/http_server.p
// Then: curl http://localhost:8080/

use http;
use json;

// Override the default handler with our custom route handler.
fn handle_request(raw: str) -> str {
    val req = parse_request(raw);
    val path = json_get(req, "path");
    val method = json_get(req, "method");

    // Route: GET / — hello world
    if path == "\"/\"" && method == "\"GET\"" {
        return build_response(200, "text/plain", "Hello, Pledge!");
    }

    // Route: GET /json — JSON response
    if path == "\"/json\"" && method == "\"GET\"" {
        return build_response(200, "application/json", "{\"message\":\"Hello from Pledge HTTP\",\"version\":\"0.1\"}");
    }

    // Route: GET /health — health check
    if path == "\"/health\"" {
        return build_response(200, "application/json", "{\"status\":\"healthy\"}");
    }

    // 404 for everything else
    return build_response(404, "text/plain", "Not Found\n");
}

fn main() {
    serve(8080);
}
