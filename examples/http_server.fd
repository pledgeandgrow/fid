// Example: an HTTP server. Build it with `fid emit examples/http_server.fd`.
// Then: curl http://localhost:8080/

use http;

fn route(req: HttpRequest) -> str {
    if req.path == "/" && req.method == "GET" {
        return build_response(200, "text/plain", "Hello, Fides!\n");
    }
    if req.path == "/json" && req.method == "GET" {
        return build_response(200, "application/json", "{\"message\":\"Hello from Fides\"}");
    }
    if req.path == "/echo" && req.method == "POST" {
        return build_response(200, "text/plain", req.body);
    }
    return build_response(404, "text/plain", "Not Found\n");
}

fn main() -> i64 {
    if !http_serve(8080, route) {
        println("Cannot open port 8080");
        return 1;
    }
    return 0;
}
