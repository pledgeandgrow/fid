use json;
use vec;

fn bool_to_str(b: bool) -> str {
    if b { return "true"; }
    return "false";
}

fn main() -> i64 {
    println("valid=" + bool_to_str(json_is_valid("{\"a\":1,\"b\":[2,3]}")));
    println("bad=" + bool_to_str(json_is_valid("{\"a\":1,")));
    println("trailing=" + bool_to_str(json_is_valid("{}x")));
    println("type=" + json_type_safe("{\"a\":1}") + "|" + json_type_safe("nope"));

    var doc: str = "{\"user\":{\"name\":\"ada \\\"x\\\" lovelace\",\"age\":36},\"tags\":[\"a\",\"b\"],\"ok\":true}";
    println("name=" + json_path(doc, "user.name"));
    println("age=" + int_to_str(json_get_int(json_get_safe(doc, "user"), "age", 0)));
    println("tag1=" + json_path(doc, "tags.1"));
    println("ok=" + bool_to_str(json_get_bool(doc, "ok", false)));
    println("missing=" + bool_to_str(str_len(json_path(doc, "user.zzz")) == 0));

    var ks: Vec = json_keys(doc);
    println("keys_n=" + int_to_str(ks.len()));
    var i: i64 = 0;
    var acc: str = "";
    while i < ks.len() {
        var k: str = ks.get(i);
        acc = acc + k + ",";
        i = i + 1;
    }
    println("keys=" + acc);
    println("has_tags=" + bool_to_str(json_has(doc, "tags")) + " has_zz=" + bool_to_str(json_has(doc, "zz")));

    // builders
    var o: str = "{}";
    o = json_obj_set(o, "n", "1");
    o = json_obj_set(o, "s", json_string("hi \"q\""));
    o = json_obj_set(o, "n", "42");
    println("built=" + o);
    var a: str = "[]";
    a = json_arr_push(a, "1");
    a = json_arr_push(a, "\"x\"");
    println("arr=" + a);

    // items
    var it: Vec = json_items("[1,\"a b\",{\"k\":2}]");
    println("items_n=" + int_to_str(it.len()));

    // pretty still works
    println("pp=" + bool_to_str(str_len(json_pretty_safe("{}")) > 0));
    return 0;
}
