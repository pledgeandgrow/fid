{
  "name": "tree-sitter-fides",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for Fides (.fd)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pledgeandgrow/fid",
    "directory": "editors/tree-sitter-fides"
  },
  "keywords": ["tree-sitter", "fides", "fid", "parser"],
  "files": ["grammar.js", "src/**", "queries/**", "tree-sitter.json"],
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test"
  },
  "tree-sitter": [
    {
      "scope": "source.fides",
      "file-types": ["fd"],
      "highlights": ["queries/highlights.scm"]
    }
  ]
}
