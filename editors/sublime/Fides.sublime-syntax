%YAML 1.2
---
# Fides in Sublime Text: gives *.fd files the scope source.fides, which the
# LSP client (LSP-fides.sublime-settings, "selector") starts `fid lsp` on.
# Copy this file into the Packages/User folder. Highlighting follows
# editors/vscode/syntaxes/fid.tmLanguage.json.
name: Fides
file_extensions:
  - fd
scope: source.fides

contexts:
  main:
    - match: '//[/!].*$'
      scope: comment.line.documentation.fides
    - match: '//.*$'
      scope: comment.line.double-slash.fides
    - match: '/\*'
      scope: punctuation.definition.comment.begin.fides
      push: block_comment
    - match: '@[A-Za-z_][A-Za-z0-9_]*(-[A-Za-z0-9_]+)*'
      scope: meta.annotation.fides
    - match: '\bf"'
      scope: punctuation.definition.string.begin.fides
      push: format_string
    - match: '\br#"'
      scope: punctuation.definition.string.begin.fides
      push: raw_string_hash
    - match: '\br"'
      scope: punctuation.definition.string.begin.fides
      push: raw_string
    - match: '"'
      scope: punctuation.definition.string.begin.fides
      push: string
    - match: "'(\\\\.|\\\\x[0-9a-fA-F]{2}|\\\\u\\{[0-9a-fA-F]+\\}|[^'\\\\])'"
      scope: constant.character.fides
    - match: '\b0[xX][0-9a-fA-F]+\b|\b0[bB][01]+\b|\b0[oO][0-7]+\b'
      scope: constant.numeric.integer.fides
    - match: '\b[0-9][0-9_]*\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\b'
      scope: constant.numeric.float.fides
    - match: '\b[0-9][0-9_]*\b'
      scope: constant.numeric.integer.fides
    - match: '![A-Z][A-Za-z0-9_]*'
      scope: storage.modifier.effect.fides
    - match: '\b(fn)\s+([a-z_][A-Za-z0-9_]*)'
      captures:
        1: storage.type.fides
        2: entity.name.function.fides
    - match: '\b(if|else|match|for|while|loop|break|continue|return|in|defer|handle|do|with|try|spawn|await|yield|guard|resume|select|region|sandbox|txn|query|grad|backward)\b'
      scope: keyword.control.fides
    - match: '\b(fn|val|var|const|type|struct|enum|impl|cap|module|static|extern|layer|model|component|system|state|on)\b'
      scope: storage.type.fides
    - match: '\b(pub|mut|dyn|async|comptime|interrupt|unsafe|persist|given|ensure|where|move)\b'
      scope: storage.modifier.fides
    - match: '\b(use|as|is|include|link)\b'
      scope: keyword.other.fides
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.fides
    - match: '\bself\b'
      scope: variable.language.fides
    - match: '\b(i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f32|f64|bool|str|void|q8|q4)\b'
      scope: storage.type.primitive.fides
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.type.fides
    - match: '\b[a-z_][A-Za-z0-9_]*(?=\s*\()'
      scope: variable.function.fides
    - match: '->|=>|::|\.\.=|\.\.|\?\?|\?\.|\|>|~>|&&|\|\||==|!=|<=|>=|<<=|>>=|[-+*/%&|^]=|<<|>>|[-+*/%=<>!&|^~?]'
      scope: keyword.operator.fides

  block_comment:
    - meta_scope: comment.block.fides
    - match: '\*/'
      scope: punctuation.definition.comment.end.fides
      pop: true

  string:
    - meta_scope: string.quoted.double.fides
    - match: '\\(x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]+\}|.)'
      scope: constant.character.escape.fides
    - match: '"'
      scope: punctuation.definition.string.end.fides
      pop: true

  raw_string:
    - meta_scope: string.quoted.other.raw.fides
    - match: '"'
      scope: punctuation.definition.string.end.fides
      pop: true

  raw_string_hash:
    - meta_scope: string.quoted.other.raw.fides
    - match: '"#'
      scope: punctuation.definition.string.end.fides
      pop: true

  format_string:
    - meta_scope: string.interpolated.fides
    - match: '\\(x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]+\}|.)'
      scope: constant.character.escape.fides
    - match: '\{'
      scope: punctuation.section.interpolation.begin.fides
      push: interpolation
    - match: '"'
      scope: punctuation.definition.string.end.fides
      pop: true

  interpolation:
    - clear_scopes: 1
    - meta_scope: meta.interpolation.fides
    - match: '\}'
      scope: punctuation.section.interpolation.end.fides
      pop: true
    - include: main
