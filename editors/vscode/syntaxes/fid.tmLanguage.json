{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "fid",
  "scopeName": "source.fid",
  "fileTypes": ["fd"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#effects" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.fid", "match": "//[/!].*$" },
        { "name": "comment.line.double-slash.fid", "match": "//.*$" },
        { "name": "comment.block.fid", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "attributes": {
      "patterns": [
        { "name": "meta.attribute.fid", "match": "#\\[[^\\]]*\\]" },
        { "name": "meta.attribute.fid", "match": "@[A-Za-z_][A-Za-z0-9_]*" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.fid",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.fid", "match": "\\\\." },
            {
              "name": "meta.embedded.line.fid",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.quoted.double.fid",
          "begin": "b?\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.fid", "match": "\\\\." }]
        }
      ]
    },
    "chars": {
      "patterns": [{ "name": "string.quoted.single.fid", "match": "'(\\\\.|[^'\\\\])'" }]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.fid", "match": "\\b0x[0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.binary.fid", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.octal.fid", "match": "\\b0o[0-7_]+\\b" },
        {
          "name": "constant.numeric.decimal.fid",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?((i|u)(8|16|32|64|128|size)|f32|f64)?\\b"
        }
      ]
    },
    "effects": {
      "patterns": [
        { "name": "storage.modifier.effect.fid", "match": "![A-Z][A-Za-z0-9_]*" },
        { "name": "storage.modifier.effect.fid", "match": "!\\{\\}" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fid",
          "match": "\\b(if|else|for|while|loop|match|break|continue|return|in|defer|handle|do|with|try|spawn|await)\\b"
        },
        {
          "name": "storage.type.fid",
          "match": "\\b(fn|val|var|const|type|struct|enum|impl|cap|module|region|static)\\b"
        },
        {
          "name": "storage.modifier.fid",
          "match": "\\b(pub|mut|move|dyn|async|comptime|extern|interrupt|where)\\b"
        },
        { "name": "keyword.other.fid", "match": "\\b(use|as|interrupt)\\b" },
        { "name": "constant.language.fid", "match": "\\b(true|false)\\b" },
        { "name": "variable.language.fid", "match": "\\b(self|Self)\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.fid",
          "match": "\\b(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|bool|char|str|String)\\b"
        },
        { "name": "entity.name.type.fid", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.fid" },
            "2": { "name": "entity.name.function.fid" }
          }
        },
        { "name": "entity.name.function.call.fid", "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*[(!]?\\()" }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fid",
          "match": "(->|=>|::|\\.\\.=|\\.\\.|\\?|&&|\\|\\||==|!=|<=|>=|<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<|>>|[+\\-*/%=<>!&|^~])"
        }
      ]
    }
  }
}
