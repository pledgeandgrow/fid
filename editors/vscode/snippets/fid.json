{
  "main function": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "\t$0",
      "}"
    ],
    "description": "Program entry point"
  },
  "function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:type} {",
      "\t$0",
      "}"
    ],
    "description": "Function with a return type"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:type},",
      "}"
    ],
    "description": "Struct definition"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:Variant},",
      "}"
    ],
    "description": "Enum definition"
  },
  "impl block": {
    "prefix": "impl",
    "body": [
      "impl ${1:Name} {",
      "\tfn ${2:method}(self: ${1:Name}) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Impl block with a method"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:pattern} => {",
      "\t\t$0",
      "\t}",
      "\t_ => {",
      "\t}",
      "}"
    ],
    "description": "Match expression"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "If statement"
  },
  "if else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "If-else statement"
  },
  "for loop": {
    "prefix": "for",
    "body": [
      "for ${1:x} in ${2:iterable} {",
      "\t$0",
      "}"
    ],
    "description": "For-in loop"
  },
  "while loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "infinite loop": {
    "prefix": "loop",
    "body": [
      "loop {",
      "\t$0",
      "}"
    ],
    "description": "Infinite loop (leave with break)"
  },
  "spawn task": {
    "prefix": "spawn",
    "body": [
      "val ${1:t} = spawn ${2:work}(${3:args});",
      "$0",
      "val ${4:result} = await ${1:t};"
    ],
    "description": "Spawn a task and await it"
  },
  "println": {
    "prefix": "println",
    "body": "println(f\"${1:text}: {${2:value}}\");",
    "description": "Print a line with an interpolated f-string"
  },
  "val binding": {
    "prefix": "val",
    "body": "val ${1:name} = ${2:value};",
    "description": "Immutable binding"
  },
  "var binding": {
    "prefix": "var",
    "body": "var ${1:name} = ${2:value};",
    "description": "Mutable binding"
  },
  "use module": {
    "prefix": "use",
    "body": "use ${1:module};",
    "description": "Module import"
  }
}
