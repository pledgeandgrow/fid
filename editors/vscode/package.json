{
  "name": "fid-lang",
  "displayName": "Fid Language",
  "description": "Fid language support: syntax highlighting, diagnostics, completion, go to definition, hover, rename, formatting and quick fixes, powered by the Fid compiler's own language server.",
  "version": "0.1.1",
  "publisher": "pledgeandgrow",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#C2255C",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pledgeandgrow/fid",
    "directory": "editors/vscode"
  },
  "homepage": "https://fid-lang.org/docs/editor-setup",
  "bugs": {
    "url": "https://github.com/pledgeandgrow/fid/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "fid",
    "fides",
    "systems",
    "language",
    "borrow checker",
    "lsp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fid",
        "aliases": [
          "Fid",
          "Fides",
          "fid"
        ],
        "extensions": [
          ".fd"
        ],
        "icon": {
          "light": "./icons/fid-file.svg",
          "dark": "./icons/fid-file.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fid",
        "scopeName": "source.fid",
        "path": "./syntaxes/fid.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fid",
        "path": "./snippets/fid.json"
      }
    ],
    "configuration": {
      "title": "Fid",
      "properties": {
        "fid.server.path": {
          "type": "string",
          "default": "fid",
          "markdownDescription": "The Fid compiler, which runs the language server (`fid lsp`). Install it from [fid-lang.org](https://fid-lang.org/docs/install) or build it from source; give a full path here when it is not on your PATH.",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:fid"
  ],
  "dependencies": {
    "vscode-languageclient": "11.0.1"
  },
  "scripts": {
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish"
  }
}
