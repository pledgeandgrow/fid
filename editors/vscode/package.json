{
  "name": "fid-lang",
  "displayName": "Fid Language",
  "description": "Fid language support: completion, go to definition, hover, rename and diagnostics.",
  "version": "0.1.0",
  "publisher": "pledgeandgrow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pledgeandgrow/fid",
    "directory": "editors/vscode"
  },
  "homepage": "https://fides-lang.org/docs/editor-setup",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "fid",
    "fides",
    "systems",
    "language"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fid",
        "aliases": [
          "Fid",
          "Fides",
          "fid"
        ],
        "extensions": [
          ".fd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fid",
        "scopeName": "source.fid",
        "path": "./syntaxes/fid.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Fid",
      "properties": {
        "fid.server.path": {
          "type": "string",
          "default": "fid",
          "description": "The fid compiler, which runs the language server (`fid lsp`)."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:fid"
  ],
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "scripts": {
    "package": "npx @vscode/vsce package"
  }
}
