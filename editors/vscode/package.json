{
  "name": "fid-lang",
  "displayName": "Fid Language",
  "description": "Syntax highlighting and language configuration for Fid (.fd) source files.",
  "version": "0.1.0",
  "publisher": "pledgeandgrow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pledgeandgrow/p-lang",
    "directory": "editors/vscode"
  },
  "homepage": "https://fides-lang.org/docs/editor-setup",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["fid", "fides", "systems", "language"],
  "contributes": {
    "languages": [
      {
        "id": "fid",
        "aliases": ["Fid", "Fides", "fid"],
        "extensions": [".fd"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fid",
        "scopeName": "source.fid",
        "path": "./syntaxes/fid.tmLanguage.json"
      }
    ]
  }
}
