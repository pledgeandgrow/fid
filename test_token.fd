pub enum TokenKind {
    Eof,
    Semicolon,
    Plus,
    IntLit(i64),
    StringLit(str),
    Ident(str),
}

pub struct Token {
    pub kind: TokenKind,
    pub line: i64,
    pub col: i64,
}

pub fn token_new(kind: TokenKind, line: i64, col: i64) -> Token {
    return Token { kind: kind, line: line, col: col };
}

pub fn main() {
    var kind: TokenKind = TokenKind::Eof;
    kind = TokenKind::Semicolon;
    var tok: Token = token_new(kind, 1, 2);
    p_print_int(tok.line);
    p_print_str("\n");
}
