use compiler::compiler;

fn main() -> i64 {
    var src: str = "fn mk2(a: i64, b: i64) -> Vec<i64> {\n    var v: Vec<i64> = Vec::new();\n    v.push(a); v.push(b);\n    return v;\n}\nfn main() -> i64 {\n    var t = p_tensor_filled(mk2(2, 2), 1.5);\n    p_tensor_set(t, mk2(0, 0), 3.0);\n    val v = p_tensor_get(t, mk2(0, 0));\n    print(v);\n    print(p_tensor_ndim(t));\n    print(p_tensor_sum(t));\n    return 0;\n}\n";
    return interpret_source(src);
}
