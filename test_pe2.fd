pub fn main() -> i64 {
    // Test p_eprint_str
    p_eprint_str("this goes to stderr\n");

    // Test p_file_write and p_file_read
    p_file_write("test_pe_io.txt", "file content here\n");
    var content: str = p_file_read("test_pe_io.txt");
    print(content);

    // Test string builder
    var sb: i64 = p_sb_new();
    p_sb_append(sb, "hello ");
    p_sb_append(sb, "world\n");
    var s: str = p_sb_to_str(sb);
    print(s);

    // Test char_to_str
    var c: str = p_char_to_str(65);  // 'A'
    print(c);
    print("\n");

    // Test float_to_str alias
    var fs: str = p_float_to_str(2.5);
    print(fs);
    print("\n");

    // Test bool_to_str alias
    var bs: str = p_bool_to_str(true);
    print(bs);
    print("\n");

    return 0;
}
