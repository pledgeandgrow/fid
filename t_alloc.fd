fn main() -> i64 {
    // Allocate many small blocks + a few large ones through Vec
    var v: Vec<Vec<i64>> = Vec::new();
    var i: i64 = 0;
    while i < 1000 {
        var inner: Vec<i64> = Vec::new();
        var j: i64 = 0;
        while j < 20 {
            inner.push(i * 100 + j);
            j = j + 1;
        }
        v.push(inner);
        i = i + 1;
    }
    // Large allocation: ~4.8 MB vec payload (crosses a chunk)
    var big: Vec<i64> = Vec::new();
    i = 0;
    while i < 600000 {
        big.push(i);
        i = i + 1;
    }
    // Verify data integrity across chunk boundaries
    var sum: i64 = 0;
    i = 0;
    while i < v.len() {
        var inner2: Vec<i64> = v[i];
        sum = sum + inner2[0] + inner2[19];
        i = i + 1;
    }
    print("vecs=");
    print(v.len());
    print("sum=");
    print(sum);
    print("big=");
    print(big.len());
    print("big_last=");
    print(big[599999]);
    return 0;
}
