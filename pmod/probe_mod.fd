module pmod::probe_mod;

pub struct PHolder3 {
    pub a: Vec<i64>,
    pub b: Vec<i64>,
    pub data: Vec<f64>,
}

pub fn ph3_new(a: Vec<i64>, b: Vec<i64>, c: Vec<f64>) -> PHolder3 {
    return PHolder3 { a: a, b: b, data: c };
}

pub fn PHolder3_new(a: Vec<i64>, b: Vec<i64>, c: Vec<f64>) -> PHolder3 {
    return PHolder3 { a: a, b: b, data: c };
}
