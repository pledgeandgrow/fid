// tools/fuzz_gen.fd — random Fides programs, run on every backend and
// compared (roadmap VF1): the Fides port of scripts/fuzz/gen_programs.py
// (roadmap AD4). Same arguments, same programs for a seed (the numbers are
// drawn from tools/py_random.fd, Python's own generator), same output, the
// same kept files and exit status:
//
//   fid ccompile tools/fuzz_gen.fd -o fuzz_gen.exe
//   fuzz_gen.exe [-n 200] [--seed 1] [--fid release/fid.exe]
//                [--backends run,emit,ccompile,checked] [--keep out/dir]
//                [--rich] [--batch K] [--retries K] [--run-timeout S]
//
// The script's header (scripts/fuzz/gen_programs.py) says what the
// programs hold, how a batch is split and what is kept where.
//
// Differences from the script: a child's output is read as UTF-8 (Python
// on Windows decodes it with the console's code page; the programs print
// ASCII, a compiler message with a non-ASCII character is kept as its
// UTF-8 bytes); a bad option value is "fuzz_gen: ..." with exit status 2
// (argparse prints its usage); an option is not taken from an abbreviation
// (`--ret 2`); on a timeout outside Windows only the child is killed (the
// script kills its process group).

use core;
use fs;
use io;
use process;
use py_random;
use fuzz_lib;


// ─── The generator (class Gen) ───

pub struct Gen {
    pub r: PyRng,
    pub funcs: Vec<str>,
    pub rich: bool,
    pub nq: i64,
}

fn gen_new(seed: i64, rich: bool) -> Gen {
    return Gen { r: py_rng(seed), funcs: Vec::new(), rich: rich, nq: 0 };
}

fn g_rand(g: &mut Gen) -> f64 {
    return py_random(&mut g.r);
}

fn g_randint(g: &mut Gen, a: i64, b: i64) -> i64 {
    return py_randint(&mut g.r, a, b);
}

fn g_choice(g: &mut Gen, v: &Vec<str>) -> str {
    return v.get(py_below(&mut g.r, v.len()));
}

fn push_all(out: &mut Vec<str>, more: &Vec<str>) {
    var i: i64 = 0;
    while i < more.len() {
        out.push(more.get(i));
        i = i + 1;
    }
}

fn copy_vec(v: &Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    push_all(&mut out, v);
    return out;
}

/// One statement on the rich-mode state (p: Pt, s: str, fv: f64).
fn rich_stmt(g: &mut Gen, local: &Vec<str>, pad: str) -> Vec<str> {
    val e: str = expr(g, local, 2);
    val k: i64 = g_randint(g, 0, 6);
    var out: Vec<str> = Vec::new();
    if k == 0 {
        out.push(pad + "p.a = (p.a + " + e + ") % " + "1000003" + ";");
        return out;
    }
    if k == 1 {
        out.push(pad + "p.b = (p.b * 3 + p.a + " + e + ") % " + "1000003" + ";");
        return out;
    }
    if k == 2 {
        g.nq = g.nq + 1;
        val q: str = "q" + int_to_str(g.nq);
        out.push(pad + "var " + q + ": Pt = p;");
        out.push(pad + q + ".a = (" + q + ".a + 1) % " + "1000003" + ";");
        out.push(pad + "acc = (acc + " + q + ".a + p.a) % " + "1000003" + ";");
        return out;
    }
    if k == 3 {
        // the list is built (and its second item drawn) before choice()
        var ctors: Vec<str> = Vec::new();
        ctors.push("Sh::One(" + e + ")");
        ctors.push("Sh::Two(" + e + ", " + expr(g, local, 1) + ")");
        ctors.push("Sh::Zero");
        val ctor: str = g_choice(g, &ctors);
        out.push(pad + "acc = (acc + sh_val(" + ctor + ")) % " + "1000003" + ";");
        return out;
    }
    if k == 4 {
        out.push(pad + "s = s + int_to_str(" + e + " % 1000);");
        out.push(pad + "if str_len(s) > 40 { s = \"\"; }");
        return out;
    }
    if k == 5 {
        out.push(pad + "acc = (acc + str_len(s) * 7) % " + "1000003" + ";");
        return out;
    }
    out.push(pad + "fv = ((" + e + " % 1000) as f64) * 0.25 + fv * 0.5;");
    out.push(pad + "acc = (acc + (fv as i64)) % " + "1000003" + ";");
    return out;
}

fn expr(g: &mut Gen, vars: &Vec<str>, depth: i64) -> str {
    if depth <= 0 || g_rand(g) < 0.3 {
        if vars.len() > 0 && g_rand(g) < 0.7 {
            return g_choice(g, vars);
        }
        return int_to_str(g_randint(g, 0, 999));
    }
    val k: i64 = g_randint(g, 0, 6);
    val a: str = expr(g, vars, depth - 1);
    val b: str = expr(g, vars, depth - 1);
    if k == 0 { return "((" + a + " + " + b + ") % " + "1000003" + ")"; }
    if k == 1 { return "((" + a + " * " + b + ") % " + "1000003" + ")"; }
    if k == 2 { return "((" + a + " - " + b + " + " + "1000003" + ") % " + "1000003" + ")"; }
    if k == 3 { return "(" + a + " / (" + b + " % 97 + 1))"; }
    if k == 4 { return "((" + a + " ^ " + b + ") % " + "1000003" + ")"; }
    if k == 5 && g.funcs.len() > 0 {
        val fs: Vec<str> = copy_vec(&g.funcs);
        val f: str = g_choice(g, &fs);
        return f + "(" + a + " % 50)";
    }
    return "((" + a + " & 1023) + (" + b + " >> 3))";
}

fn cond(g: &mut Gen, vars: &Vec<str>) -> str {
    var ops: Vec<str> = Vec::new();
    ops.push("<");
    ops.push(">");
    ops.push("==");
    ops.push("!=");
    ops.push("<=");
    ops.push(">=");
    val a: str = expr(g, vars, 2);
    val op: str = g_choice(g, &ops);
    val b: str = expr(g, vars, 2);
    return a + " " + op + " " + b;
}

/// re.match(r"i\d+_\d+$", v): a loop counter.
fn is_counter(v: str) -> bool {
    val n: i64 = str_len(v);
    if n < 4 || str_byte_at(v, 0) != 105 { return false; }
    var i: i64 = 1;
    val d0: i64 = i;
    while i < n && fl_digit(str_byte_at(v, i)) { i = i + 1; }
    if i == d0 || i >= n || str_byte_at(v, i) != 95 { return false; }
    i = i + 1;
    val d1: i64 = i;
    while i < n && fl_digit(str_byte_at(v, i)) { i = i + 1; }
    return i > d1 && i == n;
}

/// The variable an assignment writes: never a loop counter (see the
/// script's Gen.target).
fn target(v: str) -> str {
    if is_counter(v) { return "acc"; }
    return v;
}

fn block(g: &mut Gen, vars: &Vec<str>, depth: i64, indent: i64) -> Vec<str> {
    var pad: str = "";
    var t: i64 = 0;
    while t < indent {
        pad = pad + "    ";
        t = t + 1;
    }
    var out: Vec<str> = Vec::new();
    var local: Vec<str> = copy_vec(vars);
    val count: i64 = g_randint(g, 1, 5);
    var it: i64 = 0;
    while it < count {
        it = it + 1;
        val k: i64 = g_randint(g, 0, 6);
        if k <= 1 || local.len() == 0 {
            var name: str = "v" + int_to_str(local.len()) + "_" + int_to_str(indent);
            while fl_contains(&local, name) { name = name + "x"; }
            out.push(pad + "var " + name + ": i64 = " + expr(g, &local, 3) + ";");
            local.push(name);
        } else if k == 2 {
            val v: str = target(g_choice(g, &local));
            out.push(pad + v + " = " + expr(g, &local, 3) + ";");
        } else if k == 3 && depth > 0 {
            out.push(pad + "if " + cond(g, &local) + " {");
            val b1: Vec<str> = block(g, &local, depth - 1, indent + 1);
            push_all(&mut out, &b1);
            out.push(pad + "} else {");
            val b2: Vec<str> = block(g, &local, depth - 1, indent + 1);
            push_all(&mut out, &b2);
            out.push(pad + "}");
        } else if k == 4 && depth > 0 {
            val i: str = "i" + int_to_str(indent) + "_" + int_to_str(out.len());
            out.push(pad + "var " + i + ": i64 = 0;");
            out.push(pad + "while " + i + " < " + int_to_str(g_randint(g, 1, 20)) + " {");
            var inner: Vec<str> = copy_vec(&local);
            inner.push(i);
            val b3: Vec<str> = block(g, &inner, depth - 1, indent + 1);
            push_all(&mut out, &b3);
            out.push(pad + "    " + i + " = " + i + " + 1;");
            out.push(pad + "}");
        } else if k == 5 {
            out.push(pad + "xs.push(" + expr(g, &local, 2) + ");");
        } else if g.rich && g_rand(g) < 0.5 {
            // rich mode only: the plain programs draw no number here
            val rs: Vec<str> = rich_stmt(g, &local, pad);
            push_all(&mut out, &rs);
        } else {
            val v2: str = target(g_choice(g, &local));
            out.push(pad + "if xs.len() > 0 { " + v2 + " = (xs.get(" + expr(g, &local, 1) + " % xs.len()) + " + v2 + ") % " + "1000003" + "; }");
        }
    }
    var last: str = "7";
    if local.len() > 0 { last = g_choice(g, &local); }
    out.push(pad + "acc = (acc * 31 + " + last + ") % " + "1000003" + ";");
    return out;
}

fn rich_decls() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("struct Pt {");
    v.push("    a: i64,");
    v.push("    b: i64,");
    v.push("}");
    v.push("");
    v.push("enum Sh {");
    v.push("    One(i64),");
    v.push("    Two(i64, i64),");
    v.push("    Zero,");
    v.push("}");
    v.push("");
    v.push("fn sh_val(v: Sh) -> i64 {");
    v.push("    match v {");
    v.push("        One(x) => { return x % " + "1000003" + "; }");
    v.push("        Two(x, y) => { return (x * 2 + y) % " + "1000003" + "; }");
    v.push("        Zero => { return 7; }");
    v.push("    }");
    v.push("    return 0;");
    v.push("}");
    v.push("");
    return v;
}

fn rich_locals(v: &mut Vec<str>) {
    v.push("    var p: Pt = Pt { a: 1, b: 2 };");
    v.push("    var s: str = \"\";");
    v.push("    var fv: f64 = 0.0;");
}

fn rich_fold(v: &mut Vec<str>) {
    v.push("    p.b = (p.b + acc) % " + "1000003" + ";");
    v.push("    s = s + \".\";");
    v.push("    fv = fv + 1.0;");
    v.push("    acc = (acc + p.a + p.b + str_len(s) + (fv as i64)) % " + "1000003" + ";");
}

/// The program of the generator's seed (decls=false leaves out the rich
/// declarations: a batch writes them once).
fn program(g: &mut Gen, decls: bool) -> str {
    var lines: Vec<str> = Vec::new();
    if g.rich && decls { lines = rich_decls(); }
    val nf: i64 = g_randint(g, 0, 3);
    var fi: i64 = 0;
    while fi < nf {
        val name: str = "f" + int_to_str(fi);
        var n: Vec<str> = Vec::new();
        n.push("n");
        val body: Vec<str> = block(g, &n, 1, 1);
        lines.push("fn " + name + "(n: i64) -> i64 {");
        lines.push("    var acc: i64 = n;");
        lines.push("    var xs: Vec<i64> = Vec::new();");
        if g.rich { rich_locals(&mut lines); }
        push_all(&mut lines, &body);
        if fi > 0 {
            lines.push("    if n > 0 { acc = (acc + f" + int_to_str(fi - 1) + "(n - 1)) % " + "1000003" + "; }");
        }
        if g.rich { rich_fold(&mut lines); }
        lines.push("    return acc;");
        lines.push("}");
        lines.push("");
        g.funcs.push(name);
        fi = fi + 1;
    }
    lines.push("fn main() -> i64 {");
    lines.push("    var acc: i64 = 1;");
    lines.push("    var xs: Vec<i64> = Vec::new();");
    if g.rich { rich_locals(&mut lines); }
    val none: Vec<str> = Vec::new();
    val mb: Vec<str> = block(g, &none, 3, 1);
    push_all(&mut lines, &mb);
    if g.rich { rich_fold(&mut lines); }
    lines.push("    println(acc);");
    lines.push("    println(xs.len());");
    if g.rich {
        lines.push("    println(p.a);");
        lines.push("    println(p.b);");
        lines.push("    println(s);");
        lines.push("    println((fv * 1000.0) as i64);");
    }
    lines.push("    return 0;");
    lines.push("}");
    return fl_join_lines(&lines, "\n") + "\n";
}

pub fn gen_program(seed: i64, rich: bool) -> str {
    var g: Gen = gen_new(seed, rich);
    return program(&mut g, true);
}

/// re.sub(r"\bf(\d+)\(", "p<seed>_f\1(", text)
fn rename_calls(text: str, seed: i64) -> str {
    var b: StringBuilder = StringBuilder::new();
    val n: i64 = str_len(text);
    val pre: str = "p" + int_to_str(seed) + "_f";
    var i: i64 = 0;
    var start: i64 = 0;
    while i < n {
        if str_byte_at(text, i) == 102 && (i == 0 || !fl_word(str_byte_at(text, i - 1))) {
            var j: i64 = i + 1;
            while j < n && fl_digit(str_byte_at(text, j)) { j = j + 1; }
            if j > i + 1 && j < n && str_byte_at(text, j) == 40 {
                b.append_str(str_slice(text, start, i));
                b.append_str(pre + str_slice(text, i + 1, j + 1));
                i = j + 1;
                start = i;
                continue;
            }
        }
        i = i + 1;
    }
    b.append_str(str_slice(text, start, n));
    return b.to_str();
}

/// The programs of `seeds` as one file (--batch).
fn batch_program(seeds: &Vec<i64>, rich: bool) -> str {
    var lines: Vec<str> = Vec::new();
    if rich { lines = rich_decls(); }
    var calls: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < seeds.len() {
        val s: i64 = seeds.get(i);
        val ss: str = int_to_str(s);
        var g: Gen = gen_new(s, rich);
        var text: str = rename_calls(program(&mut g, false), s);
        val k: i64 = str_find(text, "fn main() -> i64 {");
        if k >= 0 {
            text = str_slice(text, 0, k) + "fn p" + ss + "_main() -> i64 {" + str_slice(text, k + 18, str_len(text));
        }
        lines.push(text);
        calls.push("    println(\"== seed " + ss + "\");");
        calls.push("    var r" + ss + ": i64 = p" + ss + "_main();");
        calls.push("    if r" + ss + " != 0 { println(r" + ss + "); }");
        i = i + 1;
    }
    lines.push("fn main() -> i64 {");
    push_all(&mut lines, &calls);
    lines.push("    return 0;");
    lines.push("}");
    return fl_join_lines(&lines, "\n") + "\n";
}

// ─── Running the backends ───

/// One backend's result: rc is the exit status as text, or "build-failed"
/// or "timeout".
pub struct Res {
    pub rc: str,
    pub out: str,
    pub err: str,
}

pub struct Opts {
    pub fid: str,
    pub keep: str,
    pub rich: bool,
    pub retries: i64,
    pub run_timeout: i64,
    pub batch_only: i64,
}

fn clean(exe: str) {
    val base: str = fl_stem(exe);
    fl_remove(exe);
    fl_remove(exe + ".fides-stamp");
    fl_remove(base + ".c");
    fl_remove(base + ".c.err");
    fl_remove(base + ".pdb");
    fl_remove(base + ".ilk");
}

fn txt(raw: str) -> str {
    return fl_as_text(raw);
}

fn timeout_res() -> Res {
    return Res { rc: "timeout", out: "", err: "" };
}

/// (exit status, stdout, stderr) of one backend on `src`; `scale`
/// multiplies the time limits (a batch holds several programs).
fn run_backend(o: &Opts, backend: str, src0: str, workdir: str, seed: str, scale: i64) -> Res {
    val exe: str = fl_join(workdir, seed + "-" + str_replace(backend, ":", "-") + ".exe");
    val t_build: i64 = 300 * scale;
    val t_run: i64 = o.run_timeout * scale;
    val src: str = fl_abspath(src0);
    var res: Res = timeout_res();
    if str_starts_with(backend, "emit:") {
        val tgt: str = str_slice(backend, 5, str_len(backend));
        var cmd: Vec<str> = fl_v5(o.fid, "emit", src, "--target", tgt);
        cmd.push("-o");
        cmd.push(exe);
        val p: FlRun = fl_run(&cmd, "", t_build);
        if p.timed_out {
            res = timeout_res();
        } else if p.code != 0 || !fl_exists(exe) {
            res = Res { rc: "build-failed", out: "", err: txt(p.out) + txt(p.err) + "\n(compiler exit " + int_to_str(p.code) + ")" };
        } else {
            var rcmd: Vec<str> = Vec::new();
            if str_starts_with(tgt, "aarch64") && !fl_win() && fl_machine() != "aarch64" {
                rcmd.push("qemu-aarch64");
            } else if str_starts_with(tgt, "riscv64") {
                rcmd.push("qemu-riscv64");
            }
            rcmd.push(exe);
            val q: FlRun = fl_run(&rcmd, "", t_run);
            if q.timed_out { res = timeout_res(); } else { res = Res { rc: int_to_str(q.code), out: txt(q.out), err: txt(q.err) }; }
        }
    } else if backend == "run" {
        val p2: FlRun = fl_run(&fl_v3(o.fid, "run", src), "", t_run);
        if p2.timed_out { res = timeout_res(); } else { res = Res { rc: int_to_str(p2.code), out: txt(p2.out), err: txt(p2.err) }; }
    } else if backend == "checked" {
        var cc: Vec<str> = fl_v3(o.fid, "run", src);
        cc.push("--checked-alloc");
        val p3: FlRun = fl_run(&cc, workdir, t_build + t_run);
        if p3.timed_out {
            res = timeout_res();
        } else {
            // drop the line that names the executable
            val ls: Vec<str> = fl_lines(txt(p3.out));
            var keep: StringBuilder = StringBuilder::new();
            var i: i64 = 0;
            while i < ls.len() {
                val l: str = ls.get(i);
                val last: bool = i == ls.len() - 1;
                if !str_starts_with(l, "Built native executable:") && !(last && str_len(l) == 0) {
                    keep.append_str(l);
                    if !last { keep.append_str("\n"); }
                }
                i = i + 1;
            }
            res = Res { rc: int_to_str(p3.code), out: keep.to_str(), err: txt(p3.err) };
        }
    } else {
        var bc: Vec<str> = fl_v3(o.fid, backend, src);
        bc.push("-o");
        bc.push(exe);
        val p4: FlRun = fl_run(&bc, "", t_build);
        if p4.timed_out {
            res = timeout_res();
        } else if p4.code != 0 || !fl_exists(exe) {
            res = Res { rc: "build-failed", out: "", err: txt(p4.out) + txt(p4.err) + "\n(compiler exit " + int_to_str(p4.code) + ")" };
        } else {
            val q4: FlRun = fl_run(&fl_v1(exe), "", t_run);
            if q4.timed_out { res = timeout_res(); } else { res = Res { rc: int_to_str(q4.code), out: txt(q4.out), err: txt(p4.err) + txt(q4.err) }; }
        }
    }
    clean(exe);
    if backend == "checked" {
        clean(fl_join(workdir, "_fides_memcheck_tmp.exe"));
    }
    return res;
}

var fl_machine_cache: str = "";

/// os.uname().machine
fn fl_machine() -> str {
    if str_len(fl_machine_cache) > 0 { return fl_machine_cache; }
    val r: FlRun = fl_run(&fl_v2("uname", "-m"), "", 10);
    fl_machine_cache = str_trim(r.out);
    if str_len(fl_machine_cache) == 0 { fl_machine_cache = "?"; }
    return fl_machine_cache;
}

/// seed -> that program's lines of a batch's output: the seeds in order
/// of appearance, each section's lines joined by "\n".
fn sections(out: str, seeds_out: &mut Vec<i64>, texts: &mut Vec<str>) {
    val ls: Vec<str> = fl_lines(fl_no_cr(out));
    var cur: i64 = -1;
    var i: i64 = 0;
    while i < ls.len() {
        val l: str = ls.get(i);
        if str_starts_with(l, "== seed ") {
            val s: i64 = fl_int(str_slice(l, 8, str_len(l)), -1);
            // a seed seen again starts its section again (dict assignment)
            var k: i64 = 0;
            cur = -1;
            while k < seeds_out.len() {
                if seeds_out.get(k) == s { cur = k; }
                k = k + 1;
            }
            if cur < 0 {
                seeds_out.push(s);
                texts.push("");
                cur = seeds_out.len() - 1;
            }
            texts.set(cur, "\u{1}");
        } else if cur >= 0 {
            texts.set(cur, texts.get(cur) + l + "\n");
        }
        i = i + 1;
    }
}

fn section_of(seeds_out: &Vec<i64>, texts: &Vec<str>, s: i64) -> str {
    var k: i64 = 0;
    while k < seeds_out.len() {
        if seeds_out.get(k) == s { return texts.get(k); }
        k = k + 1;
    }
    return "<missing>";
}

fn write_outs(keep: str, name: str, backends: &Vec<str>, results: &Vec<Res>) {
    var i: i64 = 0;
    while i < backends.len() {
        val r: Res = results.get(i);
        val path: str = fl_join(keep, name + "." + str_replace(backends.get(i), ":", "-") + ".out");
        fl_write(path, "exit: " + r.rc + "\n" + fl_no_cr(r.out) + "\n--- stderr ---\n" + fl_no_cr(r.err));
        i = i + 1;
    }
}

fn key_of(r: &Res) -> str {
    return r.rc + "\u{1}" + fl_no_cr(r.out);
}

/// Every backend built it and all gave the same status and output.
fn agree(results: &Vec<Res>) -> bool {
    var i: i64 = 0;
    while i < results.len() {
        if results.get(i).rc == "build-failed" { return false; }
        i = i + 1;
    }
    i = 1;
    while i < results.len() {
        if key_of(&results.get(i)) != key_of(&results.get(0)) { return false; }
        i = i + 1;
    }
    return true;
}

fn run_all(o: &Opts, backends: &Vec<str>, src: str, seed: str, scale: i64) -> Vec<Res> {
    var out: Vec<Res> = Vec::new();
    var i: i64 = 0;
    while i < backends.len() {
        out.push(run_backend(o, backends.get(i), src, o.keep, seed, scale));
        i = i + 1;
    }
    return out;
}

fn copy_res(v: &Vec<Res>) -> Vec<Res> {
    var out: Vec<Res> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        out.push(v.get(i));
        i = i + 1;
    }
    return out;
}

fn max1(n: i64) -> i64 {
    if n < 1 { return 1; }
    return n;
}

/// Run one seed's program alone; keep it when the backends disagree.
fn check_one(o: &mut Opts, backends: &Vec<str>, seed: i64) -> bool {
    val ss: str = int_to_str(seed);
    val src: str = fl_join(o.keep, ss + ".fd");
    fl_write(src, gen_program(seed, o.rich));
    val results: Vec<Res> = run_all(o, backends, src, ss, 1);
    if agree(&results) {
        fl_remove(src);
        return false;
    }
    var again: Vec<Res> = copy_res(&results);
    var round: i64 = 0;
    while round < max1(o.retries) {
        round = round + 1;
        // votes in the order the backends first gave each result
        var keys: Vec<str> = Vec::new();
        var counts: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < again.len() {
            val k: str = key_of(&again.get(i));
            val at: i64 = fl_index(&keys, k);
            if at < 0 {
                keys.push(k);
                counts.push(1);
            } else {
                counts.set(at, counts.get(at) + 1);
            }
            i = i + 1;
        }
        var best: i64 = 0;
        i = 1;
        while i < counts.len() {
            if counts.get(i) > counts.get(best) { best = i; }
            i = i + 1;
        }
        val no_majority: bool = counts.get(best) * 2 <= backends.len();
        i = 0;
        while i < backends.len() {
            val r: Res = again.get(i);
            if no_majority || r.rc == "build-failed" || r.rc == "timeout" || key_of(&r) != keys.get(best) {
                again.set(i, run_backend(o, backends.get(i), src, o.keep, ss, 1));
            }
            i = i + 1;
        }
        if agree(&again) { break; }
    }
    if agree(&again) {
        val fl: str = fl_join(o.keep, "flaky");
        fl_mkdirs(fl);
        fl_replace(src, fl_join(fl, ss + ".fd"));
        write_outs(fl, ss, backends, &results);
        fl_print("seed " + ss + ": disagreed once, agrees on a later run -> " + fl);
        return false;
    }
    fl_print("seed " + ss + ": backends disagree -> " + src);
    write_outs(o.keep, ss, backends, &again);
    return true;
}

/// The seed of a batch whose text holds the line a compile error names
/// (`Parse error at 195:21`, `--> file:195:21`), or -1.
fn error_line(text: str) -> i64 {
    val n: i64 = str_len(text);
    var p: i64 = 0;
    while p < n {
        if p + 5 <= n && str_slice(text, p, p + 5) == "error" {
            var q: i64 = p + 5;
            while q < n && str_byte_at(text, q) != 10 {
                if q + 4 <= n && str_slice(text, q, q + 4) == " at " {
                    val l: i64 = num_colon_num(text, q + 4);
                    if l >= 0 { return l; }
                }
                q = q + 1;
            }
        }
        if p + 4 <= n && str_slice(text, p, p + 4) == "--> " {
            var q2: i64 = p + 4;
            while q2 < n && str_byte_at(text, q2) != 10 {
                if str_byte_at(text, q2) == 58 {
                    val l2: i64 = num_colon_num(text, q2 + 1);
                    if l2 >= 0 { return l2; }
                }
                q2 = q2 + 1;
            }
        }
        p = p + 1;
    }
    return -1;
}

/// (\d+):\d at i: the first number, or -1.
fn num_colon_num(t: str, i: i64) -> i64 {
    var j: i64 = i;
    while j < str_len(t) && fl_digit(str_byte_at(t, j)) { j = j + 1; }
    if j == i || j + 1 >= str_len(t) || str_byte_at(t, j) != 58 || !fl_digit(str_byte_at(t, j + 1)) { return -1; }
    return fl_int(str_slice(t, i, j), -1);
}

fn has_seed(seeds: &Vec<i64>, s: i64) -> bool {
    var i: i64 = 0;
    while i < seeds.len() {
        if seeds.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

fn error_seed(src: str, seeds: &Vec<i64>, results: &Vec<Res>) -> i64 {
    var line: i64 = -1;
    var i: i64 = 0;
    while i < results.len() {
        val r: Res = results.get(i);
        line = error_line(r.out + r.err);
        if line >= 0 { break; }
        i = i + 1;
    }
    if line < 0 { return -1; }
    var owner: i64 = -1;
    val ls: Vec<str> = fl_lines(fl_text(fl_read(src)));
    i = 0;
    while i < ls.len() && i + 1 <= line {
        val l: str = ls.get(i);
        if str_starts_with(l, "fn p") {
            var j: i64 = 4;
            while j < str_len(l) && fl_digit(str_byte_at(l, j)) { j = j + 1; }
            if j > 4 && j < str_len(l) && str_byte_at(l, j) == 95 {
                val s: i64 = fl_int(str_slice(l, 4, j), -1);
                if has_seed(seeds, s) { owner = s; }
            }
        }
        i = i + 1;
    }
    return owner;
}

fn seeds_from(seeds: &Vec<i64>, from: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = from;
    while i < seeds.len() {
        out.push(seeds.get(i));
        i = i + 1;
    }
    return out;
}

/// Seed `s0` of the batch at `src` alone, then `rest` as a batch of its
/// own; returns the seeds that fail.
fn split_batch(o: &mut Opts, backends: &Vec<str>, seeds: &Vec<i64>, src: str, results: &Vec<Res>, s0: i64, rest: &Vec<i64>) -> Vec<i64> {
    val text: str = fl_read(src);
    fl_remove(src);
    var bad: Vec<i64> = Vec::new();
    if check_one(o, backends, s0) { bad.push(s0); }
    if rest.len() > 0 {
        val more: Vec<i64> = check_batch(o, backends, rest);
        var i: i64 = 0;
        while i < more.len() {
            bad.push(more.get(i));
            i = i + 1;
        }
    }
    if bad.len() == 0 {
        val name: str = "batch-" + int_to_str(seeds.get(0)) + "-" + int_to_str(seeds.len());
        val keep: str = fl_join(o.keep, name + ".fd");
        fl_write(keep, text);
        fl_print("batch " + int_to_str(seeds.get(0)) + ".." + int_to_str(seeds.get(seeds.len() - 1)) + ": no seed fails alone -> " + keep);
        write_outs(o.keep, name, backends, results);
        o.batch_only = o.batch_only + 1;
    }
    return bad;
}

/// Run `seeds` as one batch; returns the seeds that disagree alone.
fn check_batch(o: &mut Opts, backends: &Vec<str>, seeds: &Vec<i64>) -> Vec<i64> {
    val first: i64 = seeds.get(0);
    val fs: str = int_to_str(first);
    val last: str = int_to_str(seeds.get(seeds.len() - 1));
    val src: str = fl_join(o.keep, "batch-" + fs + ".fd");
    fl_write(src, batch_program(seeds, o.rich));
    val scale: i64 = max1(seeds.len() / 4);
    var results: Vec<Res> = run_all(o, backends, src, "batch-" + fs, scale);
    var round: i64 = 0;
    while round < max1(o.retries) {
        round = round + 1;
        if agree(&results) { break; }
        var failed: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < results.len() {
            val rc: str = results.get(i).rc;
            if rc == "build-failed" || rc == "timeout" { failed.push(i); }
            i = i + 1;
        }
        if failed.len() == 0 { break; }
        i = 0;
        while i < failed.len() {
            val b: i64 = failed.get(i);
            results.set(b, run_backend(o, backends.get(b), src, o.keep, "batch-" + fs, scale));
            i = i + 1;
        }
    }
    if agree(&results) {
        fl_remove(src);
        return Vec::new();
    }
    var s_err: i64 = -1;
    var any_bad: bool = false;
    var any_fail: bool = false;
    var i2: i64 = 0;
    while i2 < results.len() {
        val r: Res = results.get(i2);
        if r.rc == "build-failed" || r.rc == "timeout" {
            any_bad = true;
            any_fail = true;
        }
        if backends.get(i2) == "run" && r.rc == "1" && str_len(r.out) == 0 { any_bad = true; }
        i2 = i2 + 1;
    }
    if any_bad { s_err = error_seed(src, seeds, &results); }
    if s_err >= 0 && seeds.len() > 1 {
        var rest: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < seeds.len() {
            if seeds.get(k) != s_err { rest.push(seeds.get(k)); }
            k = k + 1;
        }
        fl_print("batch " + fs + ".." + last + ": does not compile at seed " + int_to_str(s_err) + "; it runs alone, the " + int_to_str(rest.len()) + " others as a batch");
        return split_batch(o, backends, seeds, src, &results, s_err, &rest);
    }
    var suspects: Vec<i64> = Vec::new();
    if any_fail {
        suspects = seeds_from(seeds, 0);
    } else {
        // each backend's sections
        var all_seeds: Vec<Vec<i64>> = Vec::new();
        var all_texts: Vec<Vec<str>> = Vec::new();
        var b2: i64 = 0;
        while b2 < results.len() {
            var so: Vec<i64> = Vec::new();
            var tx: Vec<str> = Vec::new();
            sections(results.get(b2).out, &mut so, &mut tx);
            all_seeds.push(so);
            all_texts.push(tx);
            b2 = b2 + 1;
        }
        var k2: i64 = 0;
        while k2 < seeds.len() {
            val s: i64 = seeds.get(k2);
            val first_sec: str = section_of(&all_seeds.get(0), &all_texts.get(0), s);
            var differs: bool = false;
            var b3: i64 = 1;
            while b3 < results.len() {
                if section_of(&all_seeds.get(b3), &all_texts.get(b3), s) != first_sec { differs = true; }
                b3 = b3 + 1;
            }
            if differs { suspects.push(s); }
            k2 = k2 + 1;
        }
        if suspects.len() == 0 {
            suspects = seeds_from(seeds, 0);
        } else if suspects.len() > 1 {
            val s0: i64 = suspects.get(0);
            var at: i64 = 0;
            while seeds.get(at) != s0 { at = at + 1; }
            val rest2: Vec<i64> = seeds_from(seeds, at + 1);
            fl_print("batch " + fs + ".." + last + ": backends disagree from seed " + int_to_str(s0) + "; it runs alone, the " + int_to_str(rest2.len()) + " after it as a batch");
            return split_batch(o, backends, seeds, src, &results, s0, &rest2);
        }
    }
    fl_print("batch " + fs + ".." + last + ": backends disagree; " + int_to_str(suspects.len()) + " seed(s) run alone");
    var bad: Vec<i64> = Vec::new();
    var k3: i64 = 0;
    while k3 < suspects.len() {
        if check_one(o, backends, suspects.get(k3)) { bad.push(suspects.get(k3)); }
        k3 = k3 + 1;
    }
    if bad.len() > 0 {
        fl_remove(src);
    } else {
        fl_print("batch " + fs + ".." + last + ": no seed fails alone -> " + src);
        write_outs(o.keep, "batch-" + fs, backends, &results);
        o.batch_only = o.batch_only + 1;
    }
    return bad;
}

fn int_opt(av: &Vec<str>, name: str, def: i64) -> i64 {
    val s: str = fl_opt(av, name, int_to_str(def));
    val v: i64 = fl_int(s, -987654321);
    if v == -987654321 {
        io_eprintln("fuzz_gen: argument " + name + ": invalid int value: '" + s + "'");
        process_exit(2);
    }
    return v;
}

fn main() -> i64 {
    val av: Vec<str> = fl_args();
    var dfid: str = "release/fid";
    if fl_win() { dfid = "release/fid.exe"; }
    val n: i64 = int_opt(&av, "-n", 100);
    val seed: i64 = int_opt(&av, "--seed", 1);
    val fid: str = fl_opt(&av, "--fid", fl_join("release", str_slice(dfid, 8, str_len(dfid))));
    val bs: str = fl_opt(&av, "--backends", "run,emit,ccompile");
    val keep: str = fl_opt(&av, "--keep", fl_join("build", "fuzz"));
    val batch: i64 = int_opt(&av, "--batch", 1);
    var o: Opts = Opts {
        fid: fid, keep: keep, rich: fl_flag(&av, "--rich"), retries: int_opt(&av, "--retries", 1),
        run_timeout: int_opt(&av, "--run-timeout", 60), batch_only: 0
    };
    val backends: Vec<str> = str_split(bs, ",");
    fl_mkdirs(keep);
    var fails: i64 = 0;
    var seeds: Vec<i64> = Vec::new();
    var s: i64 = seed;
    while s < seed + n {
        seeds.push(s);
        s = s + 1;
    }
    val k: i64 = max1(batch);
    var i: i64 = 0;
    while i < seeds.len() {
        var group: Vec<i64> = Vec::new();
        var j: i64 = i;
        while j < i + k && j < seeds.len() {
            group.push(seeds.get(j));
            j = j + 1;
        }
        if k == 1 {
            if check_one(&mut o, &backends, group.get(0)) { fails = fails + 1; }
        } else {
            val bad: Vec<i64> = check_batch(&mut o, &backends, &group);
            fails = fails + bad.len();
        }
        i = i + k;
    }
    var extra: str = "";
    if k > 1 { extra = ", " + int_to_str(o.batch_only) + " batch-only disagreements"; }
    fl_print(int_to_str(n) + " programs, " + int_to_str(fails) + " disagreements" + extra);
    if fails > 0 || o.batch_only > 0 { return 1; }
    return 0;
}
