// tools/c2fd.fd -- C to Fid source translator (best effort).
//
//   c2fd input.c > output.fd
//   fid run tools/c2fd.fd input.c > output.fd
//
// It reads one C99 file and writes Fid source that keeps the C program's
// structure, names and comments. It is not a C compiler: the output needs a
// review, and every place it could not translate faithfully carries a
// `// TODO(c2fd): ...` comment next to the closest translation it found.
//
// What it handles (docs/reference/c2fd.md has the details):
//   - #define constants (as `const`), other macros (expanded), #include
//     (dropped: C library calls are mapped), #if/#ifdef/#ifndef/#else/#endif;
//   - functions, structs, unions (as structs, with a TODO), enums (as
//     constants and a type alias), typedefs, globals, static locals;
//   - every statement: if/else, while, do-while, for, switch (as an
//     if/else chain, fall-through copied), break, continue, return, goto
//     (a TODO), labels;
//   - every operator, casts, sizeof, ++/-- and assignments inside
//     expressions (hoisted into statements, in C's order);
//   - C patterns to Fid idioms: arrays and malloc'd arrays become Vec,
//     `char*` becomes `str` (a written char buffer becomes Vec<i64> of
//     bytes), pointer parameters become `&mut T` or `&mut Vec<T>`, linked
//     structures keep raw pointers in `@unsafe` functions, counting `for`
//     loops become `for i in a..b`, printf with simple formats becomes
//     print/println of an f-string, FILE* reading becomes a small reader;
//   - pointers into arrays become indexes (a local `int *p = a` is an i64
//     index into `a`, a moved or offset pointer parameter is the Vec and an
//     index `p_at`), and an array malloc'd and freed in one block becomes a
//     `region` (overlapping lifetimes share one, like an arena).
//
// The translator itself is plain Fid: a lexer and preprocessor, a recursive
// descent parser that also resolves names and types, an analysis of how
// each pointer is used (which decides its Fid form), and an emitter.

use core;

// --- Token kinds ------------------------------------------------------------

const TK_ID: i64 = 1;
const TK_INT: i64 = 2;
const TK_FLT: i64 = 3;
const TK_STR: i64 = 4;
const TK_CHR: i64 = 5;
const TK_P: i64 = 6;
const TK_EOF: i64 = 7;
// a #define in the token stream (text: the macro's index)
const TK_DIR: i64 = 8;

// --- AST node kinds ---------------------------------------------------------

const E_IDENT: i64 = 1;
const E_INT: i64 = 2;
const E_FLT: i64 = 3;
const E_STR: i64 = 4;
const E_CHR: i64 = 5;
const E_BIN: i64 = 6;
const E_ASSIGN: i64 = 7;
const E_UNARY: i64 = 8;
const E_PREINC: i64 = 9;
const E_PREDEC: i64 = 10;
const E_POSTINC: i64 = 11;
const E_POSTDEC: i64 = 12;
const E_COND: i64 = 13;
const E_CALL: i64 = 14;
const E_INDEX: i64 = 15;
const E_MEMBER: i64 = 16;
const E_CAST: i64 = 17;
const E_SIZEOF_T: i64 = 18;
const E_SIZEOF_E: i64 = 19;
const E_COMMA: i64 = 20;
const E_INIT: i64 = 21;
const E_NULL: i64 = 22;
const E_BOOL: i64 = 23;
const E_DESIG: i64 = 24;

const S_EXPR: i64 = 40;
const S_DECL: i64 = 41;
const S_BLOCK: i64 = 42;
const S_IF: i64 = 43;
const S_WHILE: i64 = 44;
const S_DO: i64 = 45;
const S_FOR: i64 = 46;
const S_SWITCH: i64 = 47;
const S_CASE: i64 = 48;
const S_DEFAULT: i64 = 49;
const S_BREAK: i64 = 50;
const S_CONTINUE: i64 = 51;
const S_RETURN: i64 = 52;
const S_GOTO: i64 = 53;
const S_LABEL: i64 = 54;
const S_EMPTY: i64 = 55;
const S_TODO: i64 = 56;

const D_VAR: i64 = 60;
const D_PARAM: i64 = 61;

const T_FUNC: i64 = 70;
const T_GVAR: i64 = 71;
const T_STRUCT: i64 = 72;
const T_ENUM: i64 = 73;
const T_TYPEDEF: i64 = 74;
const T_MACRO: i64 = 75;
const T_TODO: i64 = 76;

// --- Type kinds -------------------------------------------------------------

const Y_VOID: i64 = 1;
const Y_INT: i64 = 2;
const Y_FLT: i64 = 3;
const Y_BOOL: i64 = 4;
const Y_STRUCT: i64 = 5;
const Y_PTR: i64 = 6;
const Y_ARRAY: i64 = 7;
const Y_FUNC: i64 = 8;
const Y_FILE: i64 = 9;

const YF_UNSIGNED: i64 = 1;
const YF_CONST: i64 = 2;
const YF_VARIADIC: i64 = 4;
const YF_CHAR: i64 = 8;

// --- Symbol kinds, usage flags, representations -----------------------------

const SK_GLOBAL: i64 = 1;
const SK_LOCAL: i64 = 2;
const SK_PARAM: i64 = 3;
const SK_FIELD: i64 = 4;
const SK_FUNC: i64 = 5;
const SK_ECONST: i64 = 6;
const SK_MACRO: i64 = 7;

const U_MOD: i64 = 1;
const U_INDEX: i64 = 2;
const U_ELEM_WRITE: i64 = 4;
const U_DEREF: i64 = 8;
const U_ARROW: i64 = 16;
const U_ARITH: i64 = 32;
const U_NULLCMP: i64 = 64;
const U_ASSIGNED: i64 = 128;
const U_FREED: i64 = 256;
const U_MALLOC_ARR: i64 = 512;
const U_MALLOC_ONE: i64 = 1024;
const U_STORED: i64 = 2048;
const U_RETURNED: i64 = 4096;
const U_ADDR: i64 = 8192;
const U_PTR_WRITE: i64 = 16384;
const U_STATIC: i64 = 32768;
const U_FROM_ADDR: i64 = 65536;
// stored somewhere other than a plain pointer variable (a field, an element)
const U_STORED_ELSE: i64 = 131072;
// passed to a C library function
const U_LIBC_ARG: i64 = 262144;
// its own address taken (`&p`, not `&p[i]`)
const U_SELF_ADDR: i64 = 524288;

// A value as is (numbers, structs, function values)
const R_VAL: i64 = 0;
// char* read only: str
const R_STR: i64 = 1;
// a written char array: Vec<i64> of bytes, NUL included
const R_BYTES: i64 = 2;
// a written char* parameter: &mut Vec<i64>
const R_BYTESREF: i64 = 3;
// an array or a malloc'd array: Vec<T>
const R_VEC: i64 = 4;
// an array parameter: &mut Vec<T> (or &Vec<T>)
const R_VECREF: i64 = 5;
// a pointer to one value: &mut T (or &T)
const R_REF: i64 = 6;
// anything else: *mut T, in @unsafe code
const R_RAW: i64 = 7;
// FILE*: the CFile reader
const R_FILE: i64 = 8;
// a local pointer that walks one array (`int *p = a; p++`): an i64 index
// into that array (sy_cbase); `*p` is `a[p]`, `p[i]` is `a[p + i]`
const R_CUR: i64 = 9;
// a pointer parameter that is moved, or that callers point into the middle
// of an array: `&mut Vec<T>` plus its offset `<p>_at` (a parameter when
// callers pass an offset, sy_cext; else a local starting at 0)
const R_PCUR: i64 = 10;

// --- Lexer token result -----------------------------------------------------

struct LexTok {
    kind: i64,
    end: i64,
}

struct Ex {
    code: str,
    prec: i64,
    ty: i64,
    repr: i64,
}

struct Decl {
    name: str,
    ty: i64,
    line: i64,
}

struct Spec {
    ty: i64,
    storage: i64,
}

// --- The translator's state -------------------------------------------------

struct C2 {
    file: str,
    // raw tokens (before macro expansion)
    tk: Vec<i64>,
    tt: Vec<str>,
    tl: Vec<i64>,
    tlead: Vec<str>,
    ttrail: Vec<str>,
    includes: Vec<str>,
    top_notes: Vec<str>,
    // macros
    mac_idx: HashMap<str, i64>,
    mac_name: Vec<str>,
    mac_params: Vec<str>,
    mac_bstart: Vec<i64>,
    mac_blen: Vec<i64>,
    mac_const: Vec<bool>,
    mac_dead: Vec<bool>,
    mac_text: Vec<str>,
    mac_line: Vec<i64>,
    mtk: Vec<i64>,
    mtt: Vec<str>,
    cnd_active: Vec<bool>,
    cnd_done: Vec<bool>,
    cnd_parent: Vec<bool>,
    expanding: Vec<str>,
    // tokens after expansion
    xk: Vec<i64>,
    xt: Vec<str>,
    xl: Vec<i64>,
    xlead: Vec<str>,
    xtrail: Vec<str>,
    pos: i64,
    perr: bool,
    perr_msg: str,
    // AST
    nk: Vec<i64>,
    ntext: Vec<str>,
    na: Vec<i64>,
    nb: Vec<i64>,
    nc: Vec<i64>,
    nd: Vec<i64>,
    nty: Vec<i64>,
    nlst: Vec<i64>,
    nline: Vec<i64>,
    nlead: Vec<str>,
    ntrail: Vec<str>,
    nsym: Vec<i64>,
    nend: Vec<i64>,
    // lists
    ls_start: Vec<i64>,
    ls_len: Vec<i64>,
    ls_items: Vec<i64>,
    // types
    yk: Vec<i64>,
    yname: Vec<str>,
    yelem: Vec<i64>,
    ylst: Vec<i64>,
    yflags: Vec<i64>,
    ylen: Vec<i64>,
    yalias: Vec<str>,
    td_idx: HashMap<str, i64>,
    // structs
    sd_idx: HashMap<str, i64>,
    sd_key: Vec<str>,
    sd_fid: Vec<str>,
    sd_fields: Vec<i64>,
    sd_union: Vec<bool>,
    sd_done: Vec<bool>,
    sd_linked: Vec<bool>,
    anon: i64,
    // symbols
    sy_name: Vec<str>,
    sy_fid: Vec<str>,
    sy_ty: Vec<i64>,
    sy_kind: Vec<i64>,
    sy_flags: Vec<i64>,
    sy_repr: Vec<i64>,
    sy_assigns: Vec<i64>,
    sy_init: Vec<i64>,
    sy_fn: Vec<i64>,
    sy_val: Vec<i64>,
    sy_params: Vec<i64>,
    sy_ret: Vec<i64>,
    sy_defined: Vec<bool>,
    sy_owner: Vec<i64>,
    fn_idx: HashMap<str, i64>,
    // a cursor (R_CUR): the array symbol it walks; R_PCUR: whether callers
    // pass the offset as an extra argument
    sy_cbase: Vec<i64>,
    sy_cext: Vec<bool>,
    // pointer variables written: symbol, right side (-1 for ++/--), operator
    pa_sym: Vec<i64>,
    pa_rhs: Vec<i64>,
    pa_op: Vec<str>,
    // regions made from malloc/free lifetimes: how many were made, the
    // variables declared before the region being emitted (their
    // declarations inside become assignments), the arrays it frees
    rg_n: i64,
    rg_hoist: Vec<i64>,
    rg_syms: Vec<i64>,
    // scopes
    sc_names: Vec<str>,
    sc_syms: Vec<i64>,
    sc_marks: Vec<i64>,
    // call arguments seen: callee symbol, parameter index, argument node
    cl_fn: Vec<i64>,
    cl_idx: Vec<i64>,
    cl_arg: Vec<i64>,
    // returns seen: function symbol, returned node
    rt_fn: Vec<i64>,
    rt_node: Vec<i64>,
    cur_fn: i64,
    items: Vec<i64>,
    // emission
    lines: Vec<str>,
    pre: Vec<str>,
    post: Vec<str>,
    notes: Vec<str>,
    tmp_n: i64,
    fn_raw: bool,
    fn_wrap: bool,
    // M10: functions that do raw memory (@unsafe), and the calls between
    // translated functions (caller symbol, callee symbol): a caller of an
    // @unsafe function is @unsafe too (raw_close, after all are emitted)
    raw_fns: Vec<i64>,
    call_from: Vec<i64>,
    call_to: Vec<i64>,
    fn_name: str,
    fn_ret: i64,
    fn_globals: Vec<str>,
    helpers: HashMap<str, i64>,
    lp_kind: Vec<i64>,
    lp_cont: Vec<str>,
    sw_wrap: Vec<bool>,
    todo_count: i64,
    reserved: HashMap<str, i64>,
    allow_post: bool,
    cur_body: i64,
    // built-in types
    t_void: i64,
    t_int: i64,
    t_uint: i64,
    t_ulong: i64,
    t_char: i64,
    t_uchar: i64,
    t_double: i64,
    t_bool: i64,
    t_file: i64,
    t_charp: i64,
    t_voidp: i64,
    t_u16: i64,
    t_u8: i64,
}

fn C2_new(file: str) -> C2 {
    return C2 {
        file: file, tk: Vec::new(), tt: Vec::new(), tl: Vec::new(), tlead: Vec::new(), ttrail: Vec::new(),
        includes: Vec::new(), top_notes: Vec::new(),
        mac_idx: HashMap::new(), mac_name: Vec::new(), mac_params: Vec::new(), mac_bstart: Vec::new(),
        mac_blen: Vec::new(), mac_const: Vec::new(), mac_dead: Vec::new(), mac_text: Vec::new(), mac_line: Vec::new(),
        mtk: Vec::new(), mtt: Vec::new(),
        cnd_active: Vec::new(), cnd_done: Vec::new(), cnd_parent: Vec::new(), expanding: Vec::new(),
        xk: Vec::new(), xt: Vec::new(), xl: Vec::new(), xlead: Vec::new(), xtrail: Vec::new(), pos: 0,
        perr: false, perr_msg: "",
        nk: Vec::new(), ntext: Vec::new(), na: Vec::new(), nb: Vec::new(), nc: Vec::new(), nd: Vec::new(),
        nty: Vec::new(), nlst: Vec::new(), nline: Vec::new(), nlead: Vec::new(), ntrail: Vec::new(),
        nsym: Vec::new(), nend: Vec::new(),
        ls_start: Vec::new(), ls_len: Vec::new(), ls_items: Vec::new(),
        yk: Vec::new(), yname: Vec::new(), yelem: Vec::new(), ylst: Vec::new(), yflags: Vec::new(),
        ylen: Vec::new(), yalias: Vec::new(), td_idx: HashMap::new(),
        sd_idx: HashMap::new(), sd_key: Vec::new(), sd_fid: Vec::new(), sd_fields: Vec::new(),
        sd_union: Vec::new(), sd_done: Vec::new(), sd_linked: Vec::new(), anon: 0,
        sy_name: Vec::new(), sy_fid: Vec::new(), sy_ty: Vec::new(), sy_kind: Vec::new(), sy_flags: Vec::new(),
        sy_repr: Vec::new(), sy_assigns: Vec::new(), sy_init: Vec::new(), sy_fn: Vec::new(), sy_val: Vec::new(),
        sy_params: Vec::new(), sy_ret: Vec::new(), sy_defined: Vec::new(), sy_owner: Vec::new(),
        fn_idx: HashMap::new(),
        sy_cbase: Vec::new(), sy_cext: Vec::new(), pa_sym: Vec::new(), pa_rhs: Vec::new(), pa_op: Vec::new(), rg_n: 0, rg_hoist: Vec::new(), rg_syms: Vec::new(),
        sc_names: Vec::new(), sc_syms: Vec::new(), sc_marks: Vec::new(),
        cl_fn: Vec::new(), cl_idx: Vec::new(), cl_arg: Vec::new(), rt_fn: Vec::new(), rt_node: Vec::new(),
        cur_fn: -1, items: Vec::new(),
        lines: Vec::new(), pre: Vec::new(), post: Vec::new(), notes: Vec::new(), tmp_n: 0, fn_raw: false, fn_wrap: false,
        raw_fns: Vec::new(), call_from: Vec::new(), call_to: Vec::new(),
        fn_name: "", fn_ret: 0, fn_globals: Vec::new(), helpers: HashMap::new(),
        lp_kind: Vec::new(), lp_cont: Vec::new(), sw_wrap: Vec::new(), todo_count: 0, reserved: HashMap::new(), allow_post: false, cur_body: -1,
        t_void: 0, t_int: 0, t_uint: 0, t_ulong: 0, t_char: 0, t_uchar: 0, t_double: 0, t_bool: 0,
        t_file: 0, t_charp: 0, t_voidp: 0, t_u16: 0, t_u8: 0,
    };
}

// --- Small string helpers ---------------------------------------------------

fn is_alpha(c: i64) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn is_dig(c: i64) -> bool {
    return c >= 48 && c <= 57;
}

fn is_alnum(c: i64) -> bool {
    return is_alpha(c) || is_dig(c);
}

fn is_hspace(c: i64) -> bool {
    return c == 32 || c == 9 || c == 13 || c == 11 || c == 12;
}

fn byte_at(s: str, i: i64) -> i64 {
    if i < 0 || i >= str_len(s) {
        return 0;
    }
    return str_byte_at(s, i);
}

fn trim(s: str) -> str {
    return str_trim(s);
}

fn spaces(n: i64) -> str {
    var s: str = "";
    var i: i64 = 0;
    while i < n {
        s = s + "    ";
        i += 1;
    }
    return s;
}

fn join_lines(v: Vec<str>, sep: str) -> str {
    var sb: StringBuilder = StringBuilder::new();
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 {
            sb.append_str(sep);
        }
        sb.append_str(v.get(i));
        i += 1;
    }
    return sb.to_str();
}

/// Split at "\n" (a lone trailing piece included).
fn split_nl(s: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var start: i64 = 0;
    var i: i64 = 0;
    val n: i64 = str_len(s);
    while i < n {
        if str_byte_at(s, i) == 10 {
            out.push(str_slice(s, start, i));
            start = i + 1;
        }
        i += 1;
    }
    if start < n {
        out.push(str_slice(s, start, n));
    }
    return out;
}

fn add_line(lines: str, more: str) -> str {
    if more == "" {
        return lines;
    }
    if lines == "" {
        return more;
    }
    return lines + "\n" + more;
}

// --- Lexer ------------------------------------------------------------------

/// The token that starts at `i` (not a space or comment): its kind and end.
fn read_token(src: str, i: i64) -> LexTok {
    val n: i64 = str_len(src);
    val c: i64 = str_byte_at(src, i);
    // wide/UTF string and char prefixes
    if (c == 76 || c == 117 || c == 85) && i + 1 < n && (byte_at(src, i + 1) == 34 || byte_at(src, i + 1) == 39) {
        val r: LexTok = read_token(src, i + 1);
        return r;
    }
    if is_alpha(c) {
        var j: i64 = i + 1;
        while j < n && is_alnum(str_byte_at(src, j)) {
            j += 1;
        }
        return LexTok { kind: TK_ID, end: j };
    }
    if is_dig(c) || (c == 46 && is_dig(byte_at(src, i + 1))) {
        var j: i64 = i;
        var is_float: bool = false;
        val hex: bool = c == 48 && (byte_at(src, i + 1) == 120 || byte_at(src, i + 1) == 88);
        while j < n {
            val d: i64 = str_byte_at(src, j);
            if is_alnum(d) || d == 46 {
                if d == 46 {
                    is_float = true;
                }
                if !hex && (d == 101 || d == 69) {
                    is_float = true;
                    if byte_at(src, j + 1) == 43 || byte_at(src, j + 1) == 45 {
                        j += 1;
                    }
                }
                if hex && (d == 112 || d == 80) {
                    is_float = true;
                    if byte_at(src, j + 1) == 43 || byte_at(src, j + 1) == 45 {
                        j += 1;
                    }
                }
                j += 1;
            } else {
                break;
            }
        }
        if is_float {
            return LexTok { kind: TK_FLT, end: j };
        }
        return LexTok { kind: TK_INT, end: j };
    }
    if c == 34 || c == 39 {
        var j: i64 = i + 1;
        while j < n && str_byte_at(src, j) != c && str_byte_at(src, j) != 10 {
            if str_byte_at(src, j) == 92 {
                j += 1;
            }
            j += 1;
        }
        if c == 34 {
            return LexTok { kind: TK_STR, end: j + 1 };
        }
        return LexTok { kind: TK_CHR, end: j + 1 };
    }
    // punctuators, longest first
    val three: str = str_slice(src, i, min(i + 3, n));
    if three == "<<=" || three == ">>=" || three == "..." {
        return LexTok { kind: TK_P, end: i + 3 };
    }
    val two: str = str_slice(src, i, min(i + 2, n));
    if two == "->" || two == "++" || two == "--" || two == "<<" || two == ">>" || two == "<=" || two == ">=" || two == "==" || two == "!=" || two == "&&" || two == "||" || two == "+=" || two == "-=" || two == "*=" || two == "/=" || two == "%=" || two == "&=" || two == "|=" || two == "^=" || two == "##" {
        return LexTok { kind: TK_P, end: i + 2 };
    }
    return LexTok { kind: TK_P, end: i + 1 };
}

/// The text of a token: string and char literals without their quotes.
fn token_text(src: str, i: i64, t: LexTok) -> str {
    var s: i64 = i;
    val c: i64 = str_byte_at(src, i);
    if (t.kind == TK_STR || t.kind == TK_CHR) && c != 34 && c != 39 {
        s = i + 1;
    }
    if t.kind == TK_STR || t.kind == TK_CHR {
        val e: i64 = max(s + 1, t.end - 1);
        return str_slice(src, s + 1, e);
    }
    return str_slice(src, i, t.end);
}

/// A C comment as Fid `//` lines.
fn comment_lines(body: str, block: bool) -> str {
    if !block {
        return "//" + str_trim_end(body);
    }
    var parts: Vec<str> = split_nl(body);
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < parts.len() {
        var l: str = str_trim(parts.get(i));
        if str_starts_with(l, "*") && !str_starts_with(l, "*/") {
            l = str_trim(str_slice(l, 1, str_len(l)));
        }
        if !((i == 0 || i == parts.len() - 1) && l == "") {
            if l == "" {
                out.push("//");
            } else {
                out.push("// " + l);
            }
        }
        i += 1;
    }
    return join_lines(out, "\n");
}

fn cond_active(st: &mut C2) -> bool {
    if st.cnd_active.len() == 0 {
        return true;
    }
    return st.cnd_active.get(st.cnd_active.len() - 1);
}

fn push_raw(st: &mut C2, kind: i64, text: str, line: i64, lead: str) {
    st.tk.push(kind);
    st.tt.push(text);
    st.tl.push(line);
    st.tlead.push(lead);
    st.ttrail.push("");
}

fn note_top(st: &mut C2, line: i64, msg: str) {
    st.top_notes.push("// TODO(c2fd): line " + int_to_str(line) + ": " + msg);
}

/// Tokenize the whole file: comments are kept (leading ones on the next
/// token, ones after code on the same line as that line's last token),
/// directives are run as they are met.
fn lex_file(st: &mut C2, src: str) {
    val n: i64 = str_len(src);
    var i: i64 = 0;
    var line: i64 = 1;
    var bol: bool = true;
    var lead: str = "";
    var last_line: i64 = -1;
    while i < n {
        val c: i64 = str_byte_at(src, i);
        if c == 10 {
            line += 1;
            bol = true;
            i += 1;
            continue;
        }
        if is_hspace(c) {
            i += 1;
            continue;
        }
        if c == 92 && byte_at(src, i + 1) == 10 {
            i += 2;
            line += 1;
            continue;
        }
        if c == 47 && byte_at(src, i + 1) == 47 {
            var j: i64 = i + 2;
            while j < n && str_byte_at(src, j) != 10 {
                j += 1;
            }
            if cond_active(st) {
                val text: str = comment_lines(str_slice(src, i + 2, j), false);
                if last_line == line && st.tk.len() > 0 {
                    val k: i64 = st.tk.len() - 1;
                    val old: str = st.ttrail.get(k);
                    st.ttrail.set(k, add_line(old, text));
                } else {
                    lead = add_line(lead, text);
                }
            }
            i = j;
            continue;
        }
        if c == 47 && byte_at(src, i + 1) == 42 {
            var j: i64 = i + 2;
            var nl: i64 = 0;
            while j + 1 < n && !(str_byte_at(src, j) == 42 && str_byte_at(src, j + 1) == 47) {
                if str_byte_at(src, j) == 10 {
                    nl += 1;
                }
                j += 1;
            }
            if cond_active(st) {
                val text: str = comment_lines(str_slice(src, i + 2, j), true);
                if last_line == line && nl == 0 && st.tk.len() > 0 {
                    val k: i64 = st.tk.len() - 1;
                    val old: str = st.ttrail.get(k);
                    st.ttrail.set(k, add_line(old, text));
                } else {
                    lead = add_line(lead, text);
                }
            }
            line += nl;
            i = j + 2;
            continue;
        }
        if c == 35 && bol {
            // a directive: up to the end of the line, splices joined
            var j: i64 = i + 1;
            var sb: StringBuilder = StringBuilder::new();
            var start_line: i64 = line;
            while j < n && str_byte_at(src, j) != 10 {
                val d: i64 = str_byte_at(src, j);
                if d == 92 && byte_at(src, j + 1) == 10 {
                    sb.append_str(" ");
                    j += 2;
                    line += 1;
                    continue;
                }
                if d == 47 && byte_at(src, j + 1) == 47 {
                    while j < n && str_byte_at(src, j) != 10 {
                        j += 1;
                    }
                    break;
                }
                if d == 47 && byte_at(src, j + 1) == 42 {
                    j += 2;
                    while j + 1 < n && !(str_byte_at(src, j) == 42 && str_byte_at(src, j + 1) == 47) {
                        if str_byte_at(src, j) == 10 {
                            line += 1;
                        }
                        j += 1;
                    }
                    j += 2;
                    sb.append_str(" ");
                    continue;
                }
                sb.append_str(char_to_str(d));
                j += 1;
            }
            val dtext: str = sb.to_str();
            val dlead: str = lead;
            lead = "";
            directive(st, dtext, start_line, dlead);
            i = j;
            continue;
        }
        bol = false;
        if !cond_active(st) {
            while i < n && str_byte_at(src, i) != 10 {
                i += 1;
            }
            continue;
        }
        val t: LexTok = read_token(src, i);
        val text: str = token_text(src, i, t);
        push_raw(st, t.kind, text, line, lead);
        lead = "";
        last_line = line;
        i = t.end;
    }
    if lead != "" {
        push_raw(st, TK_EOF, "", line, lead);
    }
}

/// Tokens of a macro body (no comments or directives left in it).
fn lex_body(st: &mut C2, body: str) {
    val n: i64 = str_len(body);
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(body, i);
        if is_hspace(c) || c == 10 {
            i += 1;
            continue;
        }
        val t: LexTok = read_token(body, i);
        val text: str = token_text(body, i, t);
        st.mtk.push(t.kind);
        st.mtt.push(text);
        i = t.end;
    }
}

fn first_word(s: str) -> str {
    var i: i64 = 0;
    val n: i64 = str_len(s);
    while i < n && is_hspace(str_byte_at(s, i)) {
        i += 1;
    }
    var j: i64 = i;
    while j < n && is_alnum(str_byte_at(s, j)) {
        j += 1;
    }
    return str_slice(s, i, j);
}

fn after_word(s: str, w: str) -> str {
    val k: i64 = str_find(s, w);
    if k < 0 {
        return "";
    }
    return str_trim(str_slice(s, k + str_len(w), str_len(s)));
}

fn macro_index(st: &mut C2, name: str) -> i64 {
    if !st.mac_idx.contains(name) {
        return -1;
    }
    val m: i64 = st.mac_idx.get(name) - 1;
    if st.mac_dead.get(m) {
        return -1;
    }
    return m;
}

fn directive(st: &mut C2, text: str, line: i64, lead: str) {
    val name: str = first_word(text);
    val rest: str = after_word(text, name);
    if name == "ifdef" || name == "ifndef" {
        val parent: bool = cond_active(st);
        var c: bool = macro_index(st, first_word(rest)) >= 0;
        if name == "ifndef" {
            c = !c;
        }
        st.cnd_parent.push(parent);
        st.cnd_active.push(parent && c);
        st.cnd_done.push(c);
        return;
    }
    if name == "if" {
        val parent: bool = cond_active(st);
        var v: i64 = pp_eval_text(st, rest);
        if v < 0 {
            if parent {
                note_top(st, line, "#if " + rest + " could not be evaluated; its first branch is kept");
            }
            v = 1;
        }
        st.cnd_parent.push(parent);
        st.cnd_active.push(parent && v != 0);
        st.cnd_done.push(v != 0);
        return;
    }
    if name == "elif" || name == "else" {
        if st.cnd_active.len() == 0 {
            note_top(st, line, "#" + name + " without #if");
            return;
        }
        val k: i64 = st.cnd_active.len() - 1;
        val parent: bool = st.cnd_parent.get(k);
        if st.cnd_done.get(k) {
            st.cnd_active.set(k, false);
            return;
        }
        var v: i64 = 1;
        if name == "elif" {
            v = pp_eval_text(st, rest);
            if v < 0 {
                note_top(st, line, "#elif " + rest + " could not be evaluated; taken");
                v = 1;
            }
        }
        st.cnd_active.set(k, parent && v != 0);
        st.cnd_done.set(k, v != 0);
        return;
    }
    if name == "endif" {
        if st.cnd_active.len() > 0 {
            st.cnd_active.pop();
            st.cnd_done.pop();
            st.cnd_parent.pop();
        }
        return;
    }
    if !cond_active(st) {
        return;
    }
    if name != "define" && lead != "" {
        // keep the comments written before the directive
        push_raw(st, TK_DIR, "-1", line, lead);
    }
    if name == "include" {
        st.includes.push(rest);
        return;
    }
    if name == "define" {
        define_macro(st, rest, line, lead);
        return;
    }
    if name == "undef" {
        val m: i64 = macro_index(st, first_word(rest));
        if m >= 0 {
            st.mac_dead.set(m, true);
        }
        return;
    }
    if name == "pragma" && first_word(rest) == "once" {
        return;
    }
    if name == "" {
        return;
    }
    note_top(st, line, "#" + name + " " + rest + " is not translated");
}

fn define_macro(st: &mut C2, rest: str, line: i64, lead: str) {
    val name: str = first_word(rest);
    if name == "" {
        return;
    }
    var after: i64 = str_find(rest, name) + str_len(name);
    var params: str = "";
    if byte_at(rest, after) == 40 {
        val close: i64 = str_find(str_slice(rest, after, str_len(rest)), ")");
        if close < 0 {
            note_top(st, line, "#define " + rest + " is not translated");
            return;
        }
        params = str_trim(str_slice(rest, after + 1, after + close));
        if params == "" {
            params = "()";
        }
        after = after + close + 1;
    }
    val body: str = str_trim(str_slice(rest, after, str_len(rest)));
    val start: i64 = st.mtk.len();
    lex_body(st, body);
    val m: i64 = st.mac_name.len();
    st.mac_idx.insert(name, m + 1);
    st.mac_name.push(name);
    st.mac_params.push(params);
    st.mac_bstart.push(start);
    st.mac_blen.push(st.mtk.len() - start);
    st.mac_dead.push(false);
    st.mac_text.push(rest);
    st.mac_line.push(line);
    val isc: bool = params == "" && macro_is_constant(st, start, st.mtk.len());
    st.mac_const.push(isc);
    push_raw(st, TK_DIR, int_to_str(m), line, lead);
}

/// A body of literals, operators and constant macros: written as a `const`.
fn macro_is_constant(st: &mut C2, a: i64, b: i64) -> bool {
    if a >= b {
        return false;
    }
    var i: i64 = a;
    var has_value: bool = false;
    while i < b {
        val k: i64 = st.mtk.get(i);
        val t: str = st.mtt.get(i);
        if k == TK_INT || k == TK_FLT || k == TK_CHR || k == TK_STR {
            has_value = true;
        } else if k == TK_ID {
            val m: i64 = macro_index(st, t);
            if m < 0 || !st.mac_const.get(m) {
                return false;
            }
            has_value = true;
        } else if k == TK_P {
            if !(t == "(" || t == ")" || t == "+" || t == "-" || t == "*" || t == "/" || t == "%" || t == "<<" || t == ">>" || t == "&" || t == "|" || t == "^" || t == "~" || t == "!") {
                return false;
            }
            // a cast such as (int) is not constant syntax for us
        } else {
            return false;
        }
        i += 1;
    }
    return has_value;
}

// --- #if expressions ----------------------------------------------------------

struct PP {
    toks: Vec<str>,
    kinds: Vec<i64>,
    pos: i64,
    bad: bool,
}

fn pp_eval_text(st: &mut C2, text: str) -> i64 {
    var p: PP = PP { toks: Vec::new(), kinds: Vec::new(), pos: 0, bad: false };
    val n: i64 = str_len(text);
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(text, i);
        if is_hspace(c) {
            i += 1;
            continue;
        }
        val t: LexTok = read_token(text, i);
        p.toks.push(token_text(text, i, t));
        p.kinds.push(t.kind);
        i = t.end;
    }
    val v: i64 = pp_or(st, &mut p);
    if p.bad || p.pos < p.toks.len() {
        return -1;
    }
    if v != 0 {
        return 1;
    }
    return 0;
}

fn pp_peek(p: &mut PP) -> str {
    if p.pos < p.toks.len() {
        return p.toks.get(p.pos);
    }
    return "";
}

fn pp_or(st: &mut C2, p: &mut PP) -> i64 {
    var v: i64 = pp_and(st, p);
    while pp_peek(p) == "||" {
        p.pos += 1;
        val r: i64 = pp_and(st, p);
        if v != 0 || r != 0 {
            v = 1;
        } else {
            v = 0;
        }
    }
    return v;
}

fn pp_and(st: &mut C2, p: &mut PP) -> i64 {
    var v: i64 = pp_cmp(st, p);
    while pp_peek(p) == "&&" {
        p.pos += 1;
        val r: i64 = pp_cmp(st, p);
        if v != 0 && r != 0 {
            v = 1;
        } else {
            v = 0;
        }
    }
    return v;
}

fn pp_cmp(st: &mut C2, p: &mut PP) -> i64 {
    var v: i64 = pp_add(st, p);
    while true {
        val op: str = pp_peek(p);
        if !(op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
            break;
        }
        p.pos += 1;
        val r: i64 = pp_add(st, p);
        var b: bool = false;
        if op == "==" { b = v == r; }
        if op == "!=" { b = v != r; }
        if op == "<" { b = v < r; }
        if op == ">" { b = v > r; }
        if op == "<=" { b = v <= r; }
        if op == ">=" { b = v >= r; }
        if b { v = 1; } else { v = 0; }
    }
    return v;
}

fn pp_add(st: &mut C2, p: &mut PP) -> i64 {
    var v: i64 = pp_unary(st, p);
    while pp_peek(p) == "+" || pp_peek(p) == "-" {
        val op: str = pp_peek(p);
        p.pos += 1;
        val r: i64 = pp_unary(st, p);
        if op == "+" { v = v + r; } else { v = v - r; }
    }
    return v;
}

fn pp_unary(st: &mut C2, p: &mut PP) -> i64 {
    val t: str = pp_peek(p);
    if t == "!" {
        p.pos += 1;
        val v: i64 = pp_unary(st, p);
        if v == 0 { return 1; }
        return 0;
    }
    if t == "-" {
        p.pos += 1;
        val v: i64 = pp_unary(st, p);
        return 0 - v;
    }
    if t == "(" {
        p.pos += 1;
        val v: i64 = pp_or(st, p);
        if pp_peek(p) == ")" {
            p.pos += 1;
        } else {
            p.bad = true;
        }
        return v;
    }
    if p.pos >= p.toks.len() {
        p.bad = true;
        return 0;
    }
    val k: i64 = p.kinds.get(p.pos);
    p.pos += 1;
    if t == "defined" {
        var paren: bool = false;
        if pp_peek(p) == "(" {
            paren = true;
            p.pos += 1;
        }
        val name: str = pp_peek(p);
        p.pos += 1;
        if paren {
            if pp_peek(p) == ")" { p.pos += 1; } else { p.bad = true; }
        }
        if name == "__STDC__" || name == "__STDC_VERSION__" {
            return 1;
        }
        if macro_index(st, name) >= 0 {
            return 1;
        }
        return 0;
    }
    if k == TK_INT {
        return parse_c_int(t);
    }
    if k == TK_ID {
        if t == "__STDC__" { return 1; }
        if t == "__STDC_VERSION__" { return 199901; }
        val m: i64 = macro_index(st, t);
        if m >= 0 && st.mac_blen.get(m) == 1 && st.mtk.get(st.mac_bstart.get(m)) == TK_INT {
            return parse_c_int(st.mtt.get(st.mac_bstart.get(m)));
        }
        // an unknown name is 0 in #if, as in C
        return 0;
    }
    p.bad = true;
    return 0;
}

/// The value of a C integer literal (suffixes ignored).
fn parse_c_int(t: str) -> i64 {
    var s: str = t;
    while str_len(s) > 1 {
        val c: i64 = str_byte_at(s, str_len(s) - 1);
        if c == 117 || c == 85 || c == 108 || c == 76 {
            s = str_slice(s, 0, str_len(s) - 1);
        } else {
            break;
        }
    }
    if str_starts_with(s, "0x") || str_starts_with(s, "0X") {
        return str_parse_hex(str_slice(s, 2, str_len(s)));
    }
    if str_len(s) > 1 && str_starts_with(s, "0") {
        var v: i64 = 0;
        var i: i64 = 1;
        while i < str_len(s) {
            v = v * 8 + (str_byte_at(s, i) - 48);
            i += 1;
        }
        return v;
    }
    return str_parse_int(s);
}

// --- Macro expansion ------------------------------------------------------------

fn push_x(st: &mut C2, kind: i64, text: str, line: i64, lead: str, trail: str) {
    val n: i64 = st.xk.len();
    if kind == TK_STR && n > 0 && st.xk.get(n - 1) == TK_STR {
        val old: str = st.xt.get(n - 1);
        st.xt.set(n - 1, old + text);
        val ot: str = st.xtrail.get(n - 1);
        st.xtrail.set(n - 1, add_line(ot, trail));
        return;
    }
    st.xk.push(kind);
    st.xt.push(text);
    st.xl.push(line);
    st.xlead.push(lead);
    st.xtrail.push(trail);
}

fn expand_all(st: &mut C2) {
    var depth: i64 = 0;
    var i: i64 = 0;
    // macros defined inside a function cannot become top-level consts
    while i < st.tk.len() {
        val k: i64 = st.tk.get(i);
        val t: str = st.tt.get(i);
        if k == TK_P && t == "{" { depth += 1; }
        if k == TK_P && t == "}" { depth -= 1; }
        if k == TK_DIR && depth > 0 {
            val m: i64 = str_parse_int(t);
            st.mac_const.set(m, false);
        }
        i += 1;
    }
    depth = 0;
    i = 0;
    while i < st.tk.len() {
        val k: i64 = st.tk.get(i);
        val t: str = st.tt.get(i);
        val line: i64 = st.tl.get(i);
        val lead: str = st.tlead.get(i);
        val trail: str = st.ttrail.get(i);
        if k == TK_P && t == "{" { depth += 1; }
        if k == TK_P && t == "}" { depth -= 1; }
        if k == TK_DIR {
            val m: i64 = str_parse_int(t);
            if depth == 0 {
                push_x(st, k, t, line, lead, trail);
            } else if lead != "" {
                // keep the comments of a #define inside a function
                push_x(st, TK_DIR, "-1", line, lead, trail);
            }
            i += 1;
            continue;
        }
        if k == TK_ID {
            val m: i64 = macro_index(st, t);
            if m >= 0 && !st.mac_const.get(m) {
                val params: str = st.mac_params.get(m);
                if params == "" {
                    var kinds: Vec<i64> = Vec::new();
                    var texts: Vec<str> = Vec::new();
                    macro_body(st, m, &mut kinds, &mut texts);
                    st.expanding.push(t);
                    expand_seq(st, kinds, texts, line, lead, trail);
                    st.expanding.pop();
                    i += 1;
                    continue;
                }
                if i + 1 < st.tk.len() && st.tt.get(i + 1) == "(" && st.tk.get(i + 1) == TK_P {
                    // gather the arguments from the raw stream
                    var args_k: Vec<i64> = Vec::new();
                    var args_t: Vec<str> = Vec::new();
                    var j: i64 = i + 2;
                    var pd: i64 = 0;
                    while j < st.tk.len() {
                        val aj: str = st.tt.get(j);
                        val ak: i64 = st.tk.get(j);
                        if ak == TK_P && aj == "(" { pd += 1; }
                        if ak == TK_P && aj == ")" {
                            if pd == 0 { break; }
                            pd -= 1;
                        }
                        args_k.push(ak);
                        args_t.push(aj);
                        j += 1;
                    }
                    var kinds: Vec<i64> = Vec::new();
                    var texts: Vec<str> = Vec::new();
                    substitute(st, m, args_k, args_t, &mut kinds, &mut texts);
                    st.expanding.push(t);
                    val tr2: str = st.ttrail.get(min(j, st.tk.len() - 1));
                    expand_seq(st, kinds, texts, line, lead, tr2);
                    st.expanding.pop();
                    i = j + 1;
                    continue;
                }
            }
        }
        push_x(st, k, t, line, lead, trail);
        i += 1;
    }
    push_x(st, TK_EOF, "", 0, "", "");
}

fn macro_body(st: &mut C2, m: i64, kinds: &mut Vec<i64>, texts: &mut Vec<str>) {
    val a: i64 = st.mac_bstart.get(m);
    val b: i64 = a + st.mac_blen.get(m);
    var i: i64 = a;
    while i < b {
        kinds.push(st.mtk.get(i));
        texts.push(st.mtt.get(i));
        i += 1;
    }
}

/// The body of function-like macro `m` with its parameters replaced.
fn substitute(st: &mut C2, m: i64, ak: Vec<i64>, at: Vec<str>, kinds: &mut Vec<i64>, texts: &mut Vec<str>) {
    var pnames: Vec<str> = Vec::new();
    val ps: str = st.mac_params.get(m);
    if ps != "()" {
        val parts: Vec<str> = str_split(ps, ",");
        var i: i64 = 0;
        while i < parts.len() {
            pnames.push(str_trim(parts.get(i)));
            i += 1;
        }
    }
    // split the arguments at top-level commas: argument j is [a_start[j], a_end[j])
    var a_start: Vec<i64> = Vec::new();
    var a_end: Vec<i64> = Vec::new();
    var d: i64 = 0;
    var s: i64 = 0;
    var i: i64 = 0;
    while i < at.len() {
        val t: str = at.get(i);
        if t == "(" || t == "[" || t == "{" { d += 1; }
        if t == ")" || t == "]" || t == "}" { d -= 1; }
        if t == "," && d == 0 {
            a_start.push(s);
            a_end.push(i);
            s = i + 1;
        }
        i += 1;
    }
    if at.len() > 0 || pnames.len() > 0 {
        a_start.push(s);
        a_end.push(at.len());
    }
    var bk: Vec<i64> = Vec::new();
    var bt: Vec<str> = Vec::new();
    macro_body(st, m, &mut bk, &mut bt);
    i = 0;
    while i < bt.len() {
        val t: str = bt.get(i);
        val k: i64 = bk.get(i);
        if t == "#" && i + 1 < bt.len() {
            val pi: i64 = str_index_of(pnames, bt.get(i + 1));
            if pi >= 0 && pi < a_start.len() {
                var sb: StringBuilder = StringBuilder::new();
                var j: i64 = a_start.get(pi);
                while j < a_end.get(pi) {
                    if j > a_start.get(pi) { sb.append_str(" "); }
                    sb.append_str(at.get(j));
                    j += 1;
                }
                kinds.push(TK_STR);
                texts.push(sb.to_str());
                i += 2;
                continue;
            }
        }
        if t == "##" && kinds.len() > 0 && i + 1 < bt.len() {
            var right: str = bt.get(i + 1);
            val pi: i64 = str_index_of(pnames, right);
            if pi >= 0 && pi < a_start.len() && a_end.get(pi) > a_start.get(pi) {
                right = at.get(a_start.get(pi));
            }
            val last: i64 = texts.len() - 1;
            val joined: str = texts.get(last) + right;
            texts.set(last, joined);
            kinds.set(last, TK_ID);
            i += 2;
            continue;
        }
        if k == TK_ID {
            val pi: i64 = str_index_of(pnames, t);
            if pi >= 0 && pi < a_start.len() {
                var j: i64 = a_start.get(pi);
                while j < a_end.get(pi) {
                    kinds.push(ak.get(j));
                    texts.push(at.get(j));
                    j += 1;
                }
                i += 1;
                continue;
            }
        }
        kinds.push(k);
        texts.push(t);
        i += 1;
    }
}

fn str_index_of(v: Vec<str>, s: str) -> i64 {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return i;
        }
        i += 1;
    }
    return -1;
}

/// Push a token sequence to the output, expanding the macros in it.
fn expand_seq(st: &mut C2, kinds: Vec<i64>, texts: Vec<str>, line: i64, lead: str, trail: str) {
    var i: i64 = 0;
    var first: bool = true;
    while i < kinds.len() {
        val k: i64 = kinds.get(i);
        val t: str = texts.get(i);
        var ld: str = "";
        if first { ld = lead; }
        var tr: str = "";
        if i == kinds.len() - 1 { tr = trail; }
        first = false;
        if k == TK_ID && st.expanding.len() < 32 && str_index_of(st.expanding, t) < 0 {
            val m: i64 = macro_index(st, t);
            if m >= 0 && !st.mac_const.get(m) {
                if st.mac_params.get(m) == "" {
                    var bk: Vec<i64> = Vec::new();
                    var bt: Vec<str> = Vec::new();
                    macro_body(st, m, &mut bk, &mut bt);
                    st.expanding.push(t);
                    expand_seq(st, bk, bt, line, ld, tr);
                    st.expanding.pop();
                    i += 1;
                    continue;
                }
                if i + 1 < kinds.len() && texts.get(i + 1) == "(" {
                    var ak: Vec<i64> = Vec::new();
                    var at: Vec<str> = Vec::new();
                    var j: i64 = i + 2;
                    var pd: i64 = 0;
                    while j < kinds.len() {
                        val aj: str = texts.get(j);
                        if aj == "(" { pd += 1; }
                        if aj == ")" {
                            if pd == 0 { break; }
                            pd -= 1;
                        }
                        ak.push(kinds.get(j));
                        at.push(aj);
                        j += 1;
                    }
                    var bk: Vec<i64> = Vec::new();
                    var bt: Vec<str> = Vec::new();
                    substitute(st, m, ak, at, &mut bk, &mut bt);
                    st.expanding.push(t);
                    expand_seq(st, bk, bt, line, ld, tr);
                    st.expanding.pop();
                    i = j + 1;
                    continue;
                }
            }
        }
        push_x(st, k, t, line, ld, tr);
        i += 1;
    }
}

// --- Types --------------------------------------------------------------------

fn ty_new(st: &mut C2, kind: i64, name: str, elem: i64, flags: i64) -> i64 {
    val id: i64 = st.yk.len();
    st.yk.push(kind);
    st.yname.push(name);
    st.yelem.push(elem);
    st.ylst.push(-1);
    st.yflags.push(flags);
    st.ylen.push(-1);
    st.yalias.push("");
    return id;
}

fn ty_copy(st: &mut C2, t: i64) -> i64 {
    val k: i64 = st.yk.get(t);
    val nm: str = st.yname.get(t);
    val el: i64 = st.yelem.get(t);
    val fl: i64 = st.yflags.get(t);
    val id: i64 = ty_new(st, k, nm, el, fl);
    val l: i64 = st.ylst.get(t);
    val ln: i64 = st.ylen.get(t);
    val al: str = st.yalias.get(t);
    st.ylst.set(id, l);
    st.ylen.set(id, ln);
    st.yalias.set(id, al);
    return id;
}

fn ty_ptr(st: &mut C2, t: i64) -> i64 {
    return ty_new(st, Y_PTR, "", t, 0);
}

fn ty_const(st: &mut C2, t: i64) -> i64 {
    val c: i64 = ty_copy(st, t);
    val f: i64 = st.yflags.get(c);
    st.yflags.set(c, f | YF_CONST);
    return c;
}

fn init_types(st: &mut C2) {
    st.t_void = ty_new(st, Y_VOID, "void", -1, 0);
    st.t_int = ty_new(st, Y_INT, "int", -1, 0);
    st.t_uint = ty_new(st, Y_INT, "uint", -1, YF_UNSIGNED);
    st.t_ulong = ty_new(st, Y_INT, "ulong", -1, YF_UNSIGNED);
    st.t_char = ty_new(st, Y_INT, "char", -1, YF_CHAR);
    st.t_uchar = ty_new(st, Y_INT, "uchar", -1, YF_CHAR | YF_UNSIGNED);
    st.t_double = ty_new(st, Y_FLT, "double", -1, 0);
    st.t_bool = ty_new(st, Y_BOOL, "bool", -1, 0);
    st.t_file = ty_new(st, Y_FILE, "FILE", -1, 0);
    val ch: i64 = st.t_char;
    st.t_charp = ty_ptr(st, ch);
    val vd: i64 = st.t_void;
    st.t_voidp = ty_ptr(st, vd);
    st.t_u16 = ty_new(st, Y_INT, "ushort", -1, YF_UNSIGNED);
    st.t_u8 = st.t_uchar;
    val tl: i64 = ty_new(st, Y_INT, "long", -1, 0);
    val tll: i64 = ty_new(st, Y_INT, "llong", -1, 0);
    val tull: i64 = ty_new(st, Y_INT, "ullong", -1, YF_UNSIGNED);
    val tsh: i64 = ty_new(st, Y_INT, "short", -1, 0);
    st.td_idx.insert("size_t", st.t_ulong + 1);
    st.td_idx.insert("uintptr_t", st.t_ulong + 1);
    st.td_idx.insert("uint64_t", tull + 1);
    st.td_idx.insert("uintmax_t", tull + 1);
    st.td_idx.insert("uint32_t", st.t_uint + 1);
    st.td_idx.insert("uint16_t", st.t_u16 + 1);
    st.td_idx.insert("uint8_t", st.t_uchar + 1);
    st.td_idx.insert("int64_t", tll + 1);
    st.td_idx.insert("intmax_t", tll + 1);
    st.td_idx.insert("int32_t", st.t_int + 1);
    st.td_idx.insert("int16_t", tsh + 1);
    st.td_idx.insert("int8_t", st.t_char + 1);
    st.td_idx.insert("ssize_t", tl + 1);
    st.td_idx.insert("ptrdiff_t", tl + 1);
    st.td_idx.insert("intptr_t", tl + 1);
    st.td_idx.insert("off_t", tl + 1);
    st.td_idx.insert("time_t", tl + 1);
    st.td_idx.insert("wchar_t", st.t_int + 1);
    st.td_idx.insert("FILE", st.t_file + 1);
    st.td_idx.insert("bool", st.t_bool + 1);
    val words: Vec<str> = str_split("fn val var mut const given ensure cap type return if else match select struct enum impl pub use module with async await comptime defer spawn yield move static try in as dyn where region sandbox unsafe txn persist for while loop break continue handle do interrupt extern guard is resume true false layer model grad backward kernel component system query state on i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64 bool str void q8 q4 self Self abort cancel", " ");
    var i: i64 = 0;
    while i < words.len() {
        st.reserved.insert(words.get(i), 1);
        i += 1;
    }
}

fn int_rank(name: str) -> i64 {
    if name == "bool" { return 0; }
    if name == "char" || name == "uchar" { return 1; }
    if name == "short" || name == "ushort" { return 2; }
    if name == "int" || name == "uint" { return 3; }
    if name == "long" || name == "ulong" { return 4; }
    return 5;
}

fn is_int(st: &mut C2, t: i64) -> bool {
    return t >= 0 && st.yk.get(t) == Y_INT;
}

fn is_flt(st: &mut C2, t: i64) -> bool {
    return t >= 0 && st.yk.get(t) == Y_FLT;
}

fn is_bool(st: &mut C2, t: i64) -> bool {
    return t >= 0 && st.yk.get(t) == Y_BOOL;
}

fn is_arith(st: &mut C2, t: i64) -> bool {
    return is_int(st, t) || is_flt(st, t) || is_bool(st, t);
}

fn is_ptr(st: &mut C2, t: i64) -> bool {
    return t >= 0 && st.yk.get(t) == Y_PTR;
}

fn is_array(st: &mut C2, t: i64) -> bool {
    return t >= 0 && st.yk.get(t) == Y_ARRAY;
}

fn is_ptrish(st: &mut C2, t: i64) -> bool {
    return is_ptr(st, t) || is_array(st, t);
}

fn is_struct(st: &mut C2, t: i64) -> bool {
    return t >= 0 && st.yk.get(t) == Y_STRUCT;
}

fn is_func(st: &mut C2, t: i64) -> bool {
    return t >= 0 && st.yk.get(t) == Y_FUNC;
}

fn is_unsigned(st: &mut C2, t: i64) -> bool {
    return is_int(st, t) && (st.yflags.get(t) & YF_UNSIGNED) != 0;
}

fn is_charlike(st: &mut C2, t: i64) -> bool {
    return is_int(st, t) && (st.yflags.get(t) & YF_CHAR) != 0;
}

fn is_const(st: &mut C2, t: i64) -> bool {
    return t >= 0 && (st.yflags.get(t) & YF_CONST) != 0;
}

fn elem(st: &mut C2, t: i64) -> i64 {
    if t < 0 {
        return -1;
    }
    return st.yelem.get(t);
}

/// A pointer to char (any constness or signedness).
fn is_charp(st: &mut C2, t: i64) -> bool {
    if !is_ptrish(st, t) {
        return false;
    }
    val e: i64 = elem(st, t);
    return is_charlike(st, e);
}

fn is_struct_ptr(st: &mut C2, t: i64) -> bool {
    if !is_ptr(st, t) {
        return false;
    }
    val e: i64 = elem(st, t);
    return is_struct(st, e);
}

/// The Fid integer type of a C integer type.
fn fid_int(name: str) -> str {
    if name == "uchar" { return "u8"; }
    if name == "ushort" { return "u16"; }
    if name == "uint" { return "u32"; }
    if name == "ulong" || name == "ullong" { return "u64"; }
    return "i64";
}

/// The Fid scalar type a C arithmetic type computes in (aliases ignored).
fn fid_base(st: &mut C2, t: i64) -> str {
    if t < 0 {
        return "i64";
    }
    val k: i64 = st.yk.get(t);
    if k == Y_INT { return fid_int(st.yname.get(t)); }
    if k == Y_FLT { return "f64"; }
    if k == Y_BOOL { return "bool"; }
    if k == Y_VOID { return "void"; }
    if k == Y_FILE { return "CFile"; }
    if k == Y_STRUCT { return struct_fid(st, st.yelem.get(t)); }
    return "i64";
}

fn struct_fid(st: &mut C2, sdi: i64) -> str {
    if sdi < 0 {
        return "i64";
    }
    val f: str = st.sd_fid.get(sdi);
    if f != "" {
        return safe_type_name(st, f);
    }
    return safe_type_name(st, st.sd_key.get(sdi));
}

fn safe_type_name(st: &mut C2, name: str) -> str {
    if str_starts_with(name, "__anon") {
        return "Anon" + str_slice(name, 6, str_len(name));
    }
    if st.reserved.contains(name) {
        return name + "_";
    }
    return name;
}

fn safe_name(st: &mut C2, name: str) -> str {
    if st.reserved.contains(name) {
        return name + "_";
    }
    return name;
}

// --- AST ----------------------------------------------------------------------

fn cur_line(st: &mut C2) -> i64 {
    if st.pos < st.xl.len() {
        return st.xl.get(st.pos);
    }
    return 0;
}

fn mk(st: &mut C2, kind: i64, text: str, a: i64, b: i64, c: i64, ty: i64) -> i64 {
    val id: i64 = st.nk.len();
    val line: i64 = cur_line(st);
    var endl: i64 = line;
    if st.pos > 0 && st.pos - 1 < st.xl.len() {
        endl = st.xl.get(st.pos - 1);
    }
    st.nk.push(kind);
    st.ntext.push(text);
    st.na.push(a);
    st.nb.push(b);
    st.nc.push(c);
    st.nd.push(-1);
    st.nty.push(ty);
    st.nlst.push(-1);
    st.nline.push(line);
    st.nlead.push("");
    st.ntrail.push("");
    st.nsym.push(-1);
    st.nend.push(endl);
    return id;
}

fn list_new(st: &mut C2, items: Vec<i64>) -> i64 {
    val id: i64 = st.ls_start.len();
    st.ls_start.push(st.ls_items.len());
    st.ls_len.push(items.len());
    var i: i64 = 0;
    while i < items.len() {
        st.ls_items.push(items.get(i));
        i += 1;
    }
    return id;
}

fn list_len(st: &mut C2, l: i64) -> i64 {
    if l < 0 {
        return 0;
    }
    return st.ls_len.get(l);
}

fn list_at(st: &mut C2, l: i64, i: i64) -> i64 {
    return st.ls_items.get(st.ls_start.get(l) + i);
}

// --- Symbols and scopes ---------------------------------------------------------

fn sym_new(st: &mut C2, name: str, kind: i64, ty: i64) -> i64 {
    val id: i64 = st.sy_name.len();
    val fid: str = safe_name(st, name);
    val cf: i64 = st.cur_fn;
    st.sy_name.push(name);
    st.sy_fid.push(fid);
    st.sy_ty.push(ty);
    st.sy_kind.push(kind);
    st.sy_flags.push(0);
    st.sy_repr.push(R_VAL);
    st.sy_assigns.push(0);
    st.sy_init.push(-1);
    st.sy_fn.push(cf);
    st.sy_val.push(0);
    st.sy_params.push(-1);
    st.sy_ret.push(R_VAL);
    st.sy_defined.push(false);
    st.sy_owner.push(-1);
    st.sy_cbase.push(-1);
    st.sy_cext.push(false);
    return id;
}

fn flag(st: &mut C2, sym: i64, f: i64) {
    if sym >= 0 {
        val old: i64 = st.sy_flags.get(sym);
        st.sy_flags.set(sym, old | f);
    }
}

fn has_flag(st: &mut C2, sym: i64, f: i64) -> bool {
    return sym >= 0 && (st.sy_flags.get(sym) & f) != 0;
}

fn scope_push(st: &mut C2) {
    st.sc_marks.push(st.sc_names.len());
}

fn scope_pop(st: &mut C2) {
    if st.sc_marks.len() == 0 {
        return;
    }
    val m: i64 = st.sc_marks.pop();
    st.sc_names.truncate(m);
    st.sc_syms.truncate(m);
}

fn declare(st: &mut C2, name: str, sym: i64) {
    st.sc_names.push(name);
    st.sc_syms.push(sym);
}

fn lookup(st: &mut C2, name: str) -> i64 {
    var i: i64 = st.sc_names.len() - 1;
    while i >= 0 {
        if st.sc_names.get(i) == name {
            return st.sc_syms.get(i);
        }
        i -= 1;
    }
    if st.fn_idx.contains(name) {
        return st.fn_idx.get(name) - 1;
    }
    return -1;
}

fn sd_get(st: &mut C2, key: str) -> i64 {
    if st.sd_idx.contains(key) {
        return st.sd_idx.get(key) - 1;
    }
    val id: i64 = st.sd_key.len();
    st.sd_idx.insert(key, id + 1);
    st.sd_key.push(key);
    st.sd_fid.push("");
    st.sd_fields.push(-1);
    st.sd_union.push(false);
    st.sd_done.push(false);
    st.sd_linked.push(false);
    return id;
}

/// The field `name` of struct `sdi`, or -1.
fn field_of(st: &mut C2, sdi: i64, name: str) -> i64 {
    if sdi < 0 {
        return -1;
    }
    val l: i64 = st.sd_fields.get(sdi);
    val n: i64 = list_len(st, l);
    var i: i64 = 0;
    while i < n {
        val f: i64 = list_at(st, l, i);
        if st.sy_name.get(f) == name {
            return f;
        }
        i += 1;
    }
    return -1;
}

// --- Parser: tokens -------------------------------------------------------------

fn pk(st: &mut C2) -> str {
    return st.xt.get(st.pos);
}

fn pkk(st: &mut C2) -> i64 {
    return st.xk.get(st.pos);
}

fn pk_at(st: &mut C2, off: i64) -> str {
    val p: i64 = min(st.pos + off, st.xt.len() - 1);
    return st.xt.get(p);
}

fn adv(st: &mut C2) {
    if st.pos < st.xk.len() - 1 {
        st.pos += 1;
    }
}

fn is_p(st: &mut C2, t: str) -> bool {
    return st.xk.get(st.pos) == TK_P && st.xt.get(st.pos) == t;
}

fn accept_p(st: &mut C2, t: str) -> bool {
    if is_p(st, t) {
        adv(st);
        return true;
    }
    return false;
}

fn parse_err(st: &mut C2, msg: str) {
    if !st.perr {
        st.perr = true;
        val line: i64 = cur_line(st);
        val got: str = pk(st);
        st.perr_msg = msg + " near '" + got + "' (line " + int_to_str(line) + ")";
    }
}

fn expect(st: &mut C2, t: str) {
    if !accept_p(st, t) {
        parse_err(st, "expected '" + t + "'");
    }
}

fn at_eof(st: &mut C2) -> bool {
    return st.xk.get(st.pos) == TK_EOF;
}

fn take_lead(st: &mut C2, p: i64) -> str {
    val s: str = st.xlead.get(p);
    st.xlead.set(p, "");
    return s;
}

fn take_trail(st: &mut C2, p: i64) -> str {
    if p < 0 {
        return "";
    }
    val s: str = st.xtrail.get(p);
    st.xtrail.set(p, "");
    return s;
}

/// Comments of every token in [a, b) gathered (for one-line statements).
fn take_span_comments(st: &mut C2, a: i64, b: i64, node: i64) {
    var lead: str = "";
    var trail: str = "";
    var i: i64 = a;
    while i < b {
        val l: str = take_lead(st, i);
        if i == a {
            lead = add_line(lead, l);
        } else {
            trail = add_line(trail, l);
        }
        val t: str = take_trail(st, i);
        trail = add_line(trail, t);
        i += 1;
    }
    st.nlead.set(node, lead);
    st.ntrail.set(node, trail);
    if b > a {
        st.nend.set(node, st.xl.get(b - 1));
        st.nline.set(node, st.xl.get(a));
    }
}

fn is_type_kw(t: str) -> bool {
    return t == "void" || t == "char" || t == "short" || t == "int" || t == "long" || t == "float" || t == "double" || t == "signed" || t == "unsigned" || t == "_Bool" || t == "struct" || t == "union" || t == "enum" || t == "const" || t == "volatile" || t == "static" || t == "extern" || t == "inline" || t == "register" || t == "auto" || t == "restrict" || t == "__restrict" || t == "__inline" || t == "typedef" || t == "_Noreturn" || t == "__extension__";
}

fn is_type_start_at(st: &mut C2, off: i64) -> bool {
    val p: i64 = min(st.pos + off, st.xk.len() - 1);
    if st.xk.get(p) != TK_ID {
        return false;
    }
    val t: str = st.xt.get(p);
    if is_type_kw(t) {
        return true;
    }
    if st.td_idx.contains(t) {
        // a typedef name, unless a variable of the same name hides it
        val s: i64 = lookup(st, t);
        return s < 0;
    }
    return false;
}

// --- Parser: declarations ----------------------------------------------------------

fn parse_spec(st: &mut C2) -> Spec {
    var storage: i64 = 0;
    var cnst: bool = false;
    var nuns: i64 = 0;
    var nsigned: i64 = 0;
    var nshort: i64 = 0;
    var nlong: i64 = 0;
    var nint: i64 = 0;
    var nchar: i64 = 0;
    var nflt: i64 = 0;
    var nvoid: i64 = 0;
    var nbool: i64 = 0;
    var ty: i64 = -1;
    while pkk(st) == TK_ID {
        val t: str = pk(st);
        if t == "typedef" { storage = 3; adv(st); continue; }
        if t == "static" { storage = 1; adv(st); continue; }
        if t == "extern" { storage = 2; adv(st); continue; }
        if t == "const" { cnst = true; adv(st); continue; }
        if t == "inline" || t == "__inline" || t == "register" || t == "auto" || t == "volatile" || t == "restrict" || t == "__restrict" || t == "_Noreturn" || t == "__extension__" { adv(st); continue; }
        if t == "unsigned" { nuns += 1; adv(st); continue; }
        if t == "signed" { nsigned += 1; adv(st); continue; }
        if t == "short" { nshort += 1; adv(st); continue; }
        if t == "long" { nlong += 1; adv(st); continue; }
        if t == "int" { nint += 1; adv(st); continue; }
        if t == "char" { nchar += 1; adv(st); continue; }
        if t == "float" || t == "double" { nflt += 1; adv(st); continue; }
        if t == "void" { nvoid += 1; adv(st); continue; }
        if t == "_Bool" { nbool += 1; adv(st); continue; }
        if t == "struct" || t == "union" {
            ty = parse_struct_spec(st);
            continue;
        }
        if t == "enum" {
            ty = parse_enum_spec(st);
            continue;
        }
        if ty < 0 && nuns + nsigned + nshort + nlong + nint + nchar + nflt + nvoid + nbool == 0 && st.td_idx.contains(t) && lookup(st, t) < 0 {
            ty = st.td_idx.get(t) - 1;
            adv(st);
            continue;
        }
        break;
    }
    if ty < 0 {
        if nvoid > 0 {
            ty = st.t_void;
        } else if nbool > 0 {
            ty = st.t_bool;
        } else if nflt > 0 {
            ty = st.t_double;
        } else if nchar > 0 {
            if nuns > 0 { ty = st.t_uchar; } else { ty = st.t_char; }
        } else if nuns > 0 {
            if nlong > 0 {
                ty = st.t_ulong;
            } else if nshort > 0 {
                ty = st.t_u16;
            } else {
                ty = st.t_uint;
            }
        } else if nlong > 1 {
            ty = ty_new(st, Y_INT, "llong", -1, 0);
        } else if nlong > 0 {
            ty = ty_new(st, Y_INT, "long", -1, 0);
        } else if nshort > 0 {
            ty = ty_new(st, Y_INT, "short", -1, 0);
        } else {
            ty = st.t_int;
        }
    }
    if cnst {
        ty = ty_const(st, ty);
    }
    return Spec { ty: ty, storage: storage };
}

fn parse_struct_spec(st: &mut C2) -> i64 {
    val is_union: bool = pk(st) == "union";
    adv(st);
    var tag: str = "";
    if pkk(st) == TK_ID {
        tag = pk(st);
        adv(st);
    }
    var key: str = tag;
    if key == "" {
        st.anon += 1;
        key = "__anon" + int_to_str(st.anon);
    }
    val sdi: i64 = sd_get(st, key);
    if is_p(st, "{") {
        val lead: str = take_lead(st, st.pos - 1);
        val start: i64 = st.pos;
        adv(st);
        var fields: Vec<i64> = Vec::new();
        var notes: Vec<str> = Vec::new();
        while !is_p(st, "}") && !at_eof(st) && !st.perr {
            val fpos: i64 = st.pos;
            val spec: Spec = parse_spec(st);
            while !is_p(st, ";") && !st.perr {
                val d: Decl = parse_declarator(st, spec.ty);
                if accept_p(st, ":") {
                    val w: i64 = parse_cond(st);
                    notes.push("the bit-field " + d.name + " is a whole field here");
                }
                val fs: i64 = sym_new(st, d.name, SK_FIELD, d.ty);
                st.sy_owner.set(fs, sdi);
                val fl: str = take_lead(st, fpos);
                // keep field comments on the field symbol's init slot as a node
                val cn: i64 = mk(st, S_EMPTY, "", -1, -1, -1, -1);
                st.nlead.set(cn, fl);
                st.sy_init.set(fs, cn);
                fields.push(fs);
                if !accept_p(st, ",") {
                    break;
                }
            }
            expect(st, ";");
            val tr: str = take_trail(st, st.pos - 1);
            if fields.len() > 0 {
                val last: i64 = st.sy_init.get(fields.get(fields.len() - 1));
                st.ntrail.set(last, tr);
            }
        }
        expect(st, "}");
        val fl: i64 = list_new(st, fields);
        st.sd_fields.set(sdi, fl);
        st.sd_done.set(sdi, true);
        st.sd_union.set(sdi, is_union);
        val node: i64 = mk(st, T_STRUCT, key, -1, -1, -1, -1);
        st.nd.set(node, sdi);
        st.nlead.set(node, lead);
        var nl: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < notes.len() {
            val nn: i64 = mk(st, S_TODO, notes.get(i), -1, -1, -1, -1);
            nl.push(nn);
            i += 1;
        }
        val nll: i64 = list_new(st, nl);
        st.nlst.set(node, nll);
        st.items.push(node);
    }
    val t: i64 = ty_new(st, Y_STRUCT, key, sdi, 0);
    return t;
}

fn parse_enum_spec(st: &mut C2) -> i64 {
    adv(st);
    var tag: str = "";
    if pkk(st) == TK_ID {
        tag = pk(st);
        adv(st);
    }
    val t: i64 = ty_copy(st, st.t_int);
    st.yalias.set(t, tag);
    if is_p(st, "{") {
        val lead: str = take_lead(st, st.pos - 1);
        adv(st);
        var consts: Vec<i64> = Vec::new();
        var next: i64 = 0;
        var known: bool = true;
        var prev: i64 = -1;
        while pkk(st) == TK_ID && !st.perr {
            val cpos: i64 = st.pos;
            val name: str = pk(st);
            adv(st);
            val s: i64 = sym_new(st, name, SK_ECONST, t);
            if accept_p(st, "=") {
                val e: i64 = parse_cond(st);
                st.sy_init.set(s, e);
                if const_ok(st, e) {
                    next = const_val(st, e);
                    known = true;
                } else {
                    known = false;
                }
            } else if !known && prev >= 0 {
                // prev + 1, written as an expression
                val pe: i64 = mk(st, E_IDENT, st.sy_name.get(prev), -1, -1, -1, t);
                st.nsym.set(pe, prev);
                val one: i64 = mk(st, E_INT, "1", -1, -1, -1, st.t_int);
                val sum: i64 = mk(st, E_BIN, "+", pe, one, -1, st.t_int);
                st.sy_init.set(s, sum);
            }
            st.sy_val.set(s, next);
            if !known {
                st.sy_flags.set(s, U_ASSIGNED);
            }
            next += 1;
            declare(st, name, s);
            val cl: str = take_lead(st, cpos);
            consts.push(s);
            prev = s;
            if !accept_p(st, ",") {
                break;
            }
            // a comment after the comma belongs to this constant
            val tr: str = take_trail(st, st.pos - 1);
            val tr2: str = take_trail(st, cpos);
            val cn: i64 = mk(st, S_EMPTY, "", -1, -1, -1, -1);
            st.nlead.set(cn, cl);
            st.ntrail.set(cn, add_line(tr2, tr));
            st.sy_owner.set(s, cn);
        }
        expect(st, "}");
        val node: i64 = mk(st, T_ENUM, tag, -1, -1, -1, t);
        val cl: i64 = list_new(st, consts);
        st.nlst.set(node, cl);
        st.nlead.set(node, lead);
        st.items.push(node);
    }
    return t;
}

struct CV {
    ok: bool,
    v: i64,
}

fn const_ok(st: &mut C2, e: i64) -> bool {
    val r: CV = const_eval(st, e);
    return r.ok;
}

fn const_val(st: &mut C2, e: i64) -> i64 {
    val r: CV = const_eval(st, e);
    return r.v;
}

fn const_eval(st: &mut C2, e: i64) -> CV {
    if e < 0 {
        return CV { ok: false, v: 0 };
    }
    val k: i64 = st.nk.get(e);
    if k == E_INT {
        return CV { ok: true, v: parse_c_int(st.ntext.get(e)) };
    }
    if k == E_CHR {
        return CV { ok: true, v: char_value(st.ntext.get(e)) };
    }
    if k == E_IDENT {
        val s: i64 = st.nsym.get(e);
        if s >= 0 && st.sy_kind.get(s) == SK_ECONST && !has_flag(st, s, U_ASSIGNED) {
            return CV { ok: true, v: st.sy_val.get(s) };
        }
        if s >= 0 && st.sy_kind.get(s) == SK_MACRO && st.sy_init.get(s) >= 0 {
            val mn: i64 = st.sy_init.get(s);
            return const_eval(st, st.na.get(mn));
        }
        return CV { ok: false, v: 0 };
    }
    if k == E_UNARY {
        val a: CV = const_eval(st, st.na.get(e));
        val op: str = st.ntext.get(e);
        if !a.ok { return a; }
        if op == "-" { return CV { ok: true, v: 0 - a.v }; }
        if op == "+" { return a; }
        if op == "~" { return CV { ok: true, v: ~a.v }; }
        return CV { ok: false, v: 0 };
    }
    if k == E_BIN {
        val a: CV = const_eval(st, st.na.get(e));
        val b: CV = const_eval(st, st.nb.get(e));
        if !a.ok || !b.ok {
            return CV { ok: false, v: 0 };
        }
        val op: str = st.ntext.get(e);
        if op == "+" { return CV { ok: true, v: a.v + b.v }; }
        if op == "-" { return CV { ok: true, v: a.v - b.v }; }
        if op == "*" { return CV { ok: true, v: a.v * b.v }; }
        if op == "/" && b.v != 0 { return CV { ok: true, v: a.v / b.v }; }
        if op == "%" && b.v != 0 { return CV { ok: true, v: a.v % b.v }; }
        if op == "<<" { return CV { ok: true, v: a.v << b.v }; }
        if op == ">>" { return CV { ok: true, v: a.v >> b.v }; }
        if op == "|" { return CV { ok: true, v: a.v | b.v }; }
        if op == "&" { return CV { ok: true, v: a.v & b.v }; }
        if op == "^" { return CV { ok: true, v: a.v ^ b.v }; }
    }
    return CV { ok: false, v: 0 };
}

/// The value of a C character literal's text (no quotes).
fn char_value(t: str) -> i64 {
    if str_len(t) == 0 {
        return 0;
    }
    val c: i64 = str_byte_at(t, 0);
    if c != 92 {
        return c;
    }
    val e: i64 = byte_at(t, 1);
    if e == 110 { return 10; }
    if e == 116 { return 9; }
    if e == 114 { return 13; }
    if e == 48 && str_len(t) == 2 { return 0; }
    if e == 97 { return 7; }
    if e == 98 { return 8; }
    if e == 102 { return 12; }
    if e == 118 { return 11; }
    if e == 120 {
        return str_parse_hex(str_slice(t, 2, str_len(t)));
    }
    if e >= 48 && e <= 55 {
        var v: i64 = 0;
        var i: i64 = 1;
        while i < str_len(t) && i < 4 {
            val d: i64 = str_byte_at(t, i);
            if d < 48 || d > 55 { break; }
            v = v * 8 + (d - 48);
            i += 1;
        }
        return v;
    }
    return e;
}

fn skip_qualifiers(st: &mut C2) {
    while pkk(st) == TK_ID && (pk(st) == "const" || pk(st) == "volatile" || pk(st) == "restrict" || pk(st) == "__restrict") {
        adv(st);
    }
}

fn parse_declarator(st: &mut C2, base: i64) -> Decl {
    var t: i64 = base;
    val line: i64 = cur_line(st);
    while is_p(st, "*") {
        adv(st);
        skip_qualifiers(st);
        t = ty_ptr(st, t);
    }
    if is_p(st, "(") && (pk_at(st, 1) == "*" || pk_at(st, 1) == "^") {
        adv(st);
        var inner: i64 = 0;
        while is_p(st, "*") || is_p(st, "^") {
            adv(st);
            skip_qualifiers(st);
            inner += 1;
        }
        var name: str = "";
        if pkk(st) == TK_ID {
            name = pk(st);
            adv(st);
        }
        // an array of function pointers: (*name[N])(...)
        var arr: i64 = -2;
        if is_p(st, "[") {
            adv(st);
            arr = -1;
            if !is_p(st, "]") {
                arr = parse_cond(st);
            }
            expect(st, "]");
        }
        expect(st, ")");
        t = parse_suffixes(st, t);
        var k: i64 = 0;
        while k < inner {
            t = ty_ptr(st, t);
            k += 1;
        }
        if arr > -2 {
            t = ty_new(st, Y_ARRAY, "", t, 0);
            st.ylen.set(t, arr);
        }
        return Decl { name: name, ty: t, line: line };
    }
    var name: str = "";
    if pkk(st) == TK_ID && !is_type_kw(pk(st)) {
        name = pk(st);
        adv(st);
    }
    t = parse_suffixes(st, t);
    return Decl { name: name, ty: t, line: line };
}

fn parse_suffixes(st: &mut C2, base: i64) -> i64 {
    if is_p(st, "[") {
        adv(st);
        var len: i64 = -1;
        skip_qualifiers(st);
        if pk(st) == "static" {
            adv(st);
        }
        if !is_p(st, "]") {
            len = parse_cond(st);
        }
        expect(st, "]");
        val inner: i64 = parse_suffixes(st, base);
        val t: i64 = ty_new(st, Y_ARRAY, "", inner, 0);
        st.ylen.set(t, len);
        return t;
    }
    if is_p(st, "(") {
        adv(st);
        var params: Vec<i64> = Vec::new();
        var variadic: bool = false;
        if is_p(st, ")") {
            adv(st);
        } else if pk(st) == "void" && pk_at(st, 1) == ")" {
            adv(st);
            adv(st);
        } else {
            while !st.perr {
                if accept_p(st, "...") {
                    variadic = true;
                    break;
                }
                val spec: Spec = parse_spec(st);
                val d: Decl = parse_declarator(st, spec.ty);
                var pt: i64 = d.ty;
                if is_array(st, pt) {
                    val e: i64 = elem(st, pt);
                    pt = ty_ptr(st, e);
                } else if is_func(st, pt) {
                    pt = ty_ptr(st, pt);
                }
                val pn: i64 = mk(st, D_PARAM, d.name, -1, -1, -1, pt);
                params.push(pn);
                if !accept_p(st, ",") {
                    break;
                }
            }
            expect(st, ")");
        }
        val ret: i64 = parse_suffixes(st, base);
        var fl: i64 = 0;
        if variadic {
            fl = YF_VARIADIC;
        }
        val t: i64 = ty_new(st, Y_FUNC, "", ret, fl);
        val pl: i64 = list_new(st, params);
        st.ylst.set(t, pl);
        return t;
    }
    return base;
}

fn parse_initializer(st: &mut C2) -> i64 {
    if is_p(st, "{") {
        adv(st);
        var items: Vec<i64> = Vec::new();
        while !is_p(st, "}") && !at_eof(st) && !st.perr {
            if is_p(st, ".") {
                adv(st);
                val fname: str = pk(st);
                adv(st);
                expect(st, "=");
                val v: i64 = parse_initializer(st);
                val dn: i64 = mk(st, E_DESIG, fname, v, -1, -1, -1);
                items.push(dn);
            } else if is_p(st, "[") {
                adv(st);
                val ix: i64 = parse_cond(st);
                expect(st, "]");
                expect(st, "=");
                val v: i64 = parse_initializer(st);
                val dn: i64 = mk(st, E_DESIG, "", v, ix, -1, -1);
                items.push(dn);
            } else {
                val v: i64 = parse_initializer(st);
                items.push(v);
            }
            if !accept_p(st, ",") {
                break;
            }
        }
        expect(st, "}");
        val n: i64 = mk(st, E_INIT, "", -1, -1, -1, -1);
        val l: i64 = list_new(st, items);
        st.nlst.set(n, l);
        return n;
    }
    return parse_assign(st);
}

/// One top-level item: a function, a declaration, a #define.
fn parse_top(st: &mut C2) {
    val start: i64 = st.pos;
    if pkk(st) == TK_DIR {
        val m: i64 = str_parse_int(pk(st));
        val lead: str = take_lead(st, st.pos);
        val tr: str = take_trail(st, st.pos);
        adv(st);
        val node: i64 = mk(st, T_MACRO, "", -1, -1, -1, -1);
        st.nd.set(node, m);
        st.nlead.set(node, lead);
        st.ntrail.set(node, tr);
        st.items.push(node);
        if m >= 0 && st.mac_const.get(m) {
            val name: str = st.mac_name.get(m);
            val s: i64 = sym_new(st, name, SK_MACRO, -1);
            st.sy_init.set(s, node);
            declare(st, name, s);
            // the body as an expression, for its type
            val e: i64 = parse_macro_expr(st, m);
            st.na.set(node, e);
            val et: i64 = st.nty.get(e);
            st.sy_ty.set(s, et);
            st.nsym.set(node, s);
        }
        return;
    }
    if accept_p(st, ";") {
        return;
    }
    var lead: str = take_lead(st, st.pos);
    val nitems: i64 = st.items.len();
    val spec: Spec = parse_spec(st);
    if st.items.len() > nitems && lead != "" {
        // a struct or enum defined here takes the comment written above it
        val first: i64 = st.items.get(nitems);
        val old: str = st.nlead.get(first);
        st.nlead.set(first, add_line(lead, old));
        lead = "";
    }
    if accept_p(st, ";") {
        return;
    }
    while !st.perr {
        val d: Decl = parse_declarator(st, spec.ty);
        if spec.storage == 3 {
            add_typedef(st, d.name, d.ty, lead);
        } else if is_func(st, d.ty) {
            val fs: i64 = func_symbol(st, d.name, d.ty);
            if is_p(st, "{") {
                parse_function(st, fs, d.ty, lead, spec.storage);
                if st.perr {
                    break;
                }
                return;
            }
        } else if d.name != "" {
            val s: i64 = sym_new(st, d.name, SK_GLOBAL, d.ty);
            declare(st, d.name, s);
            var init: i64 = -1;
            if accept_p(st, "=") {
                init = parse_initializer(st);
                note_init(st, s, init);
            }
            st.sy_init.set(s, init);
            if spec.storage != 2 {
                val node: i64 = mk(st, T_GVAR, d.name, init, -1, -1, d.ty);
                st.nsym.set(node, s);
                st.nlead.set(node, lead);
                st.items.push(node);
            }
        }
        if !accept_p(st, ",") {
            break;
        }
    }
    expect(st, ";");
    if st.items.len() > 0 {
        val last: i64 = st.items.get(st.items.len() - 1);
        val tr: str = take_trail(st, st.pos - 1);
        val old: str = st.ntrail.get(last);
        st.ntrail.set(last, add_line(old, tr));
    }
}

fn parse_macro_expr(st: &mut C2, m: i64) -> i64 {
    // parse the body tokens with a temporary token stream
    var save_k: Vec<i64> = st.xk;
    var save_t: Vec<str> = st.xt;
    var save_l: Vec<i64> = st.xl;
    var save_ld: Vec<str> = st.xlead;
    var save_tr: Vec<str> = st.xtrail;
    val save_pos: i64 = st.pos;
    val line: i64 = cur_line(st);
    var k: Vec<i64> = Vec::new();
    var t: Vec<str> = Vec::new();
    var l: Vec<i64> = Vec::new();
    var e: Vec<str> = Vec::new();
    val a: i64 = st.mac_bstart.get(m);
    val b: i64 = a + st.mac_blen.get(m);
    var i: i64 = a;
    while i < b {
        k.push(st.mtk.get(i));
        t.push(st.mtt.get(i));
        l.push(line);
        e.push("");
        i += 1;
    }
    k.push(TK_EOF);
    t.push("");
    l.push(line);
    e.push("");
    st.xk = k;
    st.xt = t;
    st.xl = l;
    st.xlead = e;
    st.xtrail = e;
    st.pos = 0;
    val node: i64 = parse_expr(st);
    st.xk = save_k;
    st.xt = save_t;
    st.xl = save_l;
    st.xlead = save_ld;
    st.xtrail = save_tr;
    st.pos = save_pos;
    return node;
}

fn add_typedef(st: &mut C2, name: str, ty: i64, lead: str) {
    if name == "" {
        return;
    }
    var t: i64 = ty;
    if is_struct(st, t) {
        val sdi: i64 = st.yelem.get(t);
        if st.sd_fid.get(sdi) == "" || str_starts_with(st.sd_key.get(sdi), "__anon") || st.sd_fid.get(sdi) == st.sd_key.get(sdi) {
            st.sd_fid.set(sdi, name);
        }
        st.td_idx.insert(name, t + 1);
        return;
    }
    if is_int(st, t) && st.yalias.get(t) == "" && is_enum_type(st, t) {
        st.yalias.set(t, name);
        st.td_idx.insert(name, t + 1);
        return;
    }
    if (is_arith(st, t) || is_func_ptr(st, t)) && !st.reserved.contains(name) {
        val c: i64 = ty_copy(st, t);
        st.yalias.set(c, name);
        st.td_idx.insert(name, c + 1);
        val node: i64 = mk(st, T_TYPEDEF, name, -1, -1, -1, t);
        st.nlead.set(node, lead);
        st.items.push(node);
        return;
    }
    st.td_idx.insert(name, t + 1);
}

/// An enum's type: an int type made by parse_enum_spec (it has an alias slot).
fn is_enum_type(st: &mut C2, t: i64) -> bool {
    var i: i64 = 0;
    while i < st.items.len() {
        val it: i64 = st.items.get(i);
        if st.nk.get(it) == T_ENUM && st.nty.get(it) == t {
            return true;
        }
        i += 1;
    }
    return false;
}

fn is_func_ptr(st: &mut C2, t: i64) -> bool {
    if !is_ptr(st, t) {
        return false;
    }
    val e: i64 = elem(st, t);
    return is_func(st, e);
}

fn func_symbol(st: &mut C2, name: str, ty: i64) -> i64 {
    if st.fn_idx.contains(name) {
        return st.fn_idx.get(name) - 1;
    }
    val save: i64 = st.cur_fn;
    st.cur_fn = -1;
    val s: i64 = sym_new(st, name, SK_FUNC, ty);
    st.cur_fn = save;
    st.fn_idx.insert(name, s + 1);
    return s;
}

fn parse_function(st: &mut C2, fs: i64, ty: i64, lead: str, storage: i64) {
    st.sy_ty.set(fs, ty);
    st.sy_defined.set(fs, true);
    st.cur_fn = fs;
    scope_push(st);
    val pl: i64 = st.ylst.get(ty);
    var params: Vec<i64> = Vec::new();
    val n: i64 = list_len(st, pl);
    var i: i64 = 0;
    while i < n {
        val pn: i64 = list_at(st, pl, i);
        var pname: str = st.ntext.get(pn);
        if pname == "" {
            pname = "arg" + int_to_str(i);
        }
        val ps: i64 = sym_new(st, pname, SK_PARAM, st.nty.get(pn));
        declare(st, pname, ps);
        params.push(ps);
        i += 1;
    }
    val plist: i64 = list_new(st, params);
    st.sy_params.set(fs, plist);
    val body: i64 = parse_block(st);
    scope_pop(st);
    st.cur_fn = -1;
    val node: i64 = mk(st, T_FUNC, st.sy_name.get(fs), body, -1, -1, ty);
    st.nsym.set(node, fs);
    st.nlead.set(node, lead);
    st.items.push(node);
}

// --- Parser: statements -----------------------------------------------------------------

fn parse_block(st: &mut C2) -> i64 {
    val bline: i64 = cur_line(st);
    val lead: str = take_lead(st, st.pos);
    expect(st, "{");
    scope_push(st);
    var items: Vec<i64> = Vec::new();
    while !is_p(st, "}") && !at_eof(st) && !st.perr {
        val s: i64 = parse_stmt(st);
        if s >= 0 {
            items.push(s);
        }
    }
    val endl: i64 = cur_line(st);
    val close_lead: str = take_lead(st, st.pos);
    expect(st, "}");
    scope_pop(st);
    if close_lead != "" {
        val cn: i64 = mk(st, S_EMPTY, "", -1, -1, -1, -1);
        st.nlead.set(cn, close_lead);
        items.push(cn);
    }
    val node: i64 = mk(st, S_BLOCK, "", -1, -1, -1, -1);
    val l: i64 = list_new(st, items);
    st.nlst.set(node, l);
    st.nlead.set(node, lead);
    st.nend.set(node, endl);
    st.nline.set(node, bline);
    return node;
}

fn parse_stmt(st: &mut C2) -> i64 {
    val start: i64 = st.pos;
    val line: i64 = cur_line(st);
    val t: str = pk(st);
    val k: i64 = pkk(st);
    if k == TK_DIR {
        val lead: str = take_lead(st, st.pos);
        adv(st);
        val n: i64 = mk(st, S_EMPTY, "", -1, -1, -1, -1);
        st.nlead.set(n, lead);
        return n;
    }
    if k == TK_P && t == "{" {
        return parse_block(st);
    }
    if k == TK_P && t == ";" {
        adv(st);
        val n: i64 = mk(st, S_EMPTY, "", -1, -1, -1, -1);
        take_span_comments(st, start, st.pos, n);
        return n;
    }
    if k == TK_ID {
        if t == "if" {
            val lead: str = take_lead(st, start);
            adv(st);
            expect(st, "(");
            val c: i64 = parse_expr(st);
            note_cond(st, c);
            expect(st, ")");
            val tr: str = take_trail(st, st.pos - 1);
            val th: i64 = parse_stmt(st);
            var el: i64 = -1;
            if pk(st) == "else" && pkk(st) == TK_ID {
                adv(st);
                el = parse_stmt(st);
            }
            val n: i64 = mk(st, S_IF, "", c, th, el, -1);
            st.nlead.set(n, lead);
            st.ntrail.set(n, tr);
            st.nline.set(n, line);
            return n;
        }
        if t == "while" {
            val lead: str = take_lead(st, start);
            adv(st);
            expect(st, "(");
            val c: i64 = parse_expr(st);
            note_cond(st, c);
            expect(st, ")");
            val tr: str = take_trail(st, st.pos - 1);
            val body: i64 = parse_stmt(st);
            val n: i64 = mk(st, S_WHILE, "", c, body, -1, -1);
            st.nlead.set(n, lead);
            st.ntrail.set(n, tr);
            st.nline.set(n, line);
            return n;
        }
        if t == "do" {
            val lead: str = take_lead(st, start);
            adv(st);
            val body: i64 = parse_stmt(st);
            if pk(st) == "while" {
                adv(st);
            } else {
                parse_err(st, "expected 'while'");
            }
            expect(st, "(");
            val c: i64 = parse_expr(st);
            note_cond(st, c);
            expect(st, ")");
            expect(st, ";");
            val n: i64 = mk(st, S_DO, "", c, body, -1, -1);
            st.nlead.set(n, lead);
            st.nline.set(n, line);
            return n;
        }
        if t == "for" {
            val lead: str = take_lead(st, start);
            adv(st);
            expect(st, "(");
            scope_push(st);
            var init: i64 = -1;
            if is_type_start_at(st, 0) {
                init = parse_decl_stmt(st);
            } else {
                if !is_p(st, ";") {
                    val e: i64 = parse_expr(st);
                    init = mk(st, S_EXPR, "", e, -1, -1, -1);
                }
                expect(st, ";");
            }
            var c: i64 = -1;
            if !is_p(st, ";") {
                c = parse_expr(st);
                note_cond(st, c);
            }
            expect(st, ";");
            var step: i64 = -1;
            if !is_p(st, ")") {
                step = parse_expr(st);
            }
            expect(st, ")");
            val tr: str = take_trail(st, st.pos - 1);
            val body: i64 = parse_stmt(st);
            scope_pop(st);
            val n: i64 = mk(st, S_FOR, "", init, c, step, -1);
            st.nd.set(n, body);
            st.nlead.set(n, lead);
            st.ntrail.set(n, tr);
            st.nline.set(n, line);
            return n;
        }
        if t == "switch" {
            val lead: str = take_lead(st, start);
            adv(st);
            expect(st, "(");
            val c: i64 = parse_expr(st);
            expect(st, ")");
            val tr: str = take_trail(st, st.pos - 1);
            val body: i64 = parse_stmt(st);
            val n: i64 = mk(st, S_SWITCH, "", c, body, -1, -1);
            st.nlead.set(n, lead);
            st.ntrail.set(n, tr);
            st.nline.set(n, line);
            return n;
        }
        if t == "case" {
            adv(st);
            val e: i64 = parse_cond(st);
            var hi: i64 = -1;
            if accept_p(st, "...") {
                hi = parse_cond(st);
            }
            expect(st, ":");
            val n: i64 = mk(st, S_CASE, "", e, hi, -1, -1);
            take_span_comments(st, start, st.pos, n);
            return n;
        }
        if t == "default" && pk_at(st, 1) == ":" {
            adv(st);
            adv(st);
            val n: i64 = mk(st, S_DEFAULT, "", -1, -1, -1, -1);
            take_span_comments(st, start, st.pos, n);
            return n;
        }
        if t == "break" || t == "continue" {
            adv(st);
            expect(st, ";");
            var kind: i64 = S_BREAK;
            if t == "continue" {
                kind = S_CONTINUE;
            }
            val n: i64 = mk(st, kind, "", -1, -1, -1, -1);
            take_span_comments(st, start, st.pos, n);
            return n;
        }
        if t == "return" {
            adv(st);
            var e: i64 = -1;
            if !is_p(st, ";") {
                e = parse_expr(st);
                note_return(st, e);
            }
            expect(st, ";");
            val n: i64 = mk(st, S_RETURN, "", e, -1, -1, -1);
            take_span_comments(st, start, st.pos, n);
            st.nline.set(n, line);
            return n;
        }
        if t == "goto" {
            adv(st);
            val label: str = pk(st);
            adv(st);
            expect(st, ";");
            val n: i64 = mk(st, S_GOTO, label, -1, -1, -1, -1);
            take_span_comments(st, start, st.pos, n);
            return n;
        }
        if pk_at(st, 1) == ":" && !is_type_start_at(st, 0) && lookup(st, t) < 0 {
            adv(st);
            adv(st);
            val n: i64 = mk(st, S_LABEL, t, -1, -1, -1, -1);
            take_span_comments(st, start, st.pos, n);
            return n;
        }
        if is_type_start_at(st, 0) {
            val n: i64 = parse_decl_stmt(st);
            take_span_comments(st, start, st.pos, n);
            st.nline.set(n, line);
            return n;
        }
    }
    val e: i64 = parse_expr(st);
    expect(st, ";");
    val n: i64 = mk(st, S_EXPR, "", e, -1, -1, -1);
    take_span_comments(st, start, st.pos, n);
    st.nline.set(n, line);
    if st.perr {
        // skip to a point the parser can go on from
        while !at_eof(st) && !is_p(st, ";") && !is_p(st, "}") {
            adv(st);
        }
        accept_p(st, ";");
    }
    return n;
}

/// A local declaration (with its ';').
fn parse_decl_stmt(st: &mut C2) -> i64 {
    val spec: Spec = parse_spec(st);
    var decls: Vec<i64> = Vec::new();
    if is_p(st, ";") {
        adv(st);
        val n: i64 = mk(st, S_DECL, "", -1, -1, -1, -1);
        val l: i64 = list_new(st, decls);
        st.nlst.set(n, l);
        return n;
    }
    while !st.perr {
        val d: Decl = parse_declarator(st, spec.ty);
        if spec.storage == 3 {
            add_typedef(st, d.name, d.ty, "");
        } else if is_func(st, d.ty) {
            // a local prototype
            func_symbol(st, d.name, d.ty);
        } else {
            var kind: i64 = SK_LOCAL;
            if spec.storage == 1 || spec.storage == 2 {
                kind = SK_GLOBAL;
            }
            val s: i64 = sym_new(st, d.name, kind, d.ty);
            if spec.storage == 1 {
                flag(st, s, U_STATIC);
                val fname: str = st.sy_name.get(st.cur_fn);
                st.sy_fid.set(s, fname + "_" + d.name);
            }
            declare(st, d.name, s);
            var init: i64 = -1;
            if accept_p(st, "=") {
                init = parse_initializer(st);
                note_init(st, s, init);
            }
            st.sy_init.set(s, init);
            val dn: i64 = mk(st, D_VAR, d.name, init, -1, -1, d.ty);
            st.nsym.set(dn, s);
            if spec.storage != 2 {
                decls.push(dn);
            }
        }
        if !accept_p(st, ",") {
            break;
        }
    }
    expect(st, ";");
    val n: i64 = mk(st, S_DECL, "", -1, -1, -1, -1);
    val l: i64 = list_new(st, decls);
    st.nlst.set(n, l);
    return n;
}

// --- Usage notes taken while parsing ---------------------------------------------------

/// The symbol an expression names directly: a variable or a field.
fn base_sym(st: &mut C2, e: i64) -> i64 {
    if e < 0 {
        return -1;
    }
    val k: i64 = st.nk.get(e);
    if k == E_IDENT || k == E_MEMBER {
        return st.nsym.get(e);
    }
    if k == E_CAST {
        return base_sym(st, st.na.get(e));
    }
    return -1;
}

/// The variable whose storage an lvalue is part of.
fn root_var(st: &mut C2, e: i64) -> i64 {
    if e < 0 {
        return -1;
    }
    val k: i64 = st.nk.get(e);
    if k == E_IDENT {
        return st.nsym.get(e);
    }
    if k == E_MEMBER && st.ntext.get(e) == "." {
        return root_var(st, st.na.get(e));
    }
    if k == E_INDEX {
        return root_var(st, st.na.get(e));
    }
    if k == E_CAST {
        return root_var(st, st.na.get(e));
    }
    return -1;
}

fn strip_casts(st: &mut C2, e: i64) -> i64 {
    var x: i64 = e;
    while x >= 0 && st.nk.get(x) == E_CAST {
        x = st.na.get(x);
    }
    return x;
}

fn call_name(st: &mut C2, e: i64) -> str {
    val x: i64 = strip_casts(st, e);
    if x < 0 || st.nk.get(x) != E_CALL {
        return "";
    }
    val f: i64 = st.na.get(x);
    if st.nk.get(f) != E_IDENT {
        return "";
    }
    return st.ntext.get(f);
}

fn mark_write(st: &mut C2, lhs: i64) {
    val r: i64 = root_var(st, lhs);
    flag(st, r, U_MOD);
    val k: i64 = st.nk.get(lhs);
    if k == E_IDENT {
        val s: i64 = st.nsym.get(lhs);
        if s >= 0 {
            val a: i64 = st.sy_assigns.get(s);
            st.sy_assigns.set(s, a + 1);
            flag(st, s, U_ASSIGNED);
        }
    } else if k == E_MEMBER {
        val f: i64 = st.nsym.get(lhs);
        flag(st, f, U_MOD | U_ASSIGNED);
        if st.ntext.get(lhs) == "->" {
            val b: i64 = base_sym(st, st.na.get(lhs));
            flag(st, b, U_PTR_WRITE);
        } else {
            mark_inner_write(st, st.na.get(lhs));
        }
    } else if k == E_INDEX {
        val b: i64 = base_sym(st, st.na.get(lhs));
        flag(st, b, U_ELEM_WRITE | U_INDEX | U_MOD);
        mark_inner_write(st, st.na.get(lhs));
    } else if k == E_UNARY && st.ntext.get(lhs) == "*" {
        var b: i64 = base_sym(st, st.na.get(lhs));
        if b < 0 {
            // *p++ = v, *(p + i) = v: the pointer the address is made from
            b = ptr_root_ident(st, st.na.get(lhs));
        }
        flag(st, b, U_ELEM_WRITE | U_DEREF);
    }
}

/// A write to a part of `e` (`e.f = ..`, `e[i] = ..`) also writes through
/// the pointer `e` may be reached by.
fn mark_inner_write(st: &mut C2, e: i64) {
    val k: i64 = st.nk.get(e);
    if k == E_MEMBER && st.ntext.get(e) == "->" {
        val b: i64 = base_sym(st, st.na.get(e));
        flag(st, b, U_PTR_WRITE);
    }
    if k == E_MEMBER {
        val f: i64 = st.nsym.get(e);
        flag(st, f, U_MOD | U_ELEM_WRITE);
        mark_inner_write(st, st.na.get(e));
    }
    if k == E_INDEX {
        val b: i64 = base_sym(st, st.na.get(e));
        flag(st, b, U_ELEM_WRITE | U_MOD);
        mark_inner_write(st, st.na.get(e));
    }
    if k == E_UNARY && st.ntext.get(e) == "*" {
        var b: i64 = base_sym(st, st.na.get(e));
        if b < 0 {
            b = ptr_root_ident(st, st.na.get(e));
        }
        flag(st, b, U_ELEM_WRITE);
    }
}

/// The pointer variable a pointer expression is made from: `p`, `p + n`,
/// `n + p`, `&p[i]`, `p++`, through casts; -1 for anything else.
fn ptr_root_ident(st: &mut C2, e: i64) -> i64 {
    val x: i64 = strip_casts(st, e);
    if x < 0 {
        return -1;
    }
    val k: i64 = st.nk.get(x);
    if k == E_IDENT {
        return st.nsym.get(x);
    }
    if k == E_BIN {
        val op: str = st.ntext.get(x);
        val a: i64 = st.na.get(x);
        val b: i64 = st.nb.get(x);
        if (op == "+" || op == "-") && is_ptrish(st, st.nty.get(a)) && is_arith(st, st.nty.get(b)) {
            return ptr_root_ident(st, a);
        }
        if op == "+" && is_ptrish(st, st.nty.get(b)) && is_arith(st, st.nty.get(a)) {
            return ptr_root_ident(st, b);
        }
        return -1;
    }
    if k == E_UNARY && st.ntext.get(x) == "&" {
        val inner: i64 = st.na.get(x);
        if st.nk.get(inner) == E_INDEX {
            return ptr_root_ident(st, st.na.get(inner));
        }
        return -1;
    }
    if k == E_PREINC || k == E_PREDEC || k == E_POSTINC || k == E_POSTDEC {
        return ptr_root_ident(st, st.na.get(x));
    }
    return -1;
}

/// The kind of allocation an expression is: 1 one object, 2 an array, 0 none.
fn alloc_kind(st: &mut C2, e: i64) -> i64 {
    val name: str = call_name(st, e);
    if name == "calloc" || name == "realloc" {
        return 2;
    }
    if name == "malloc" {
        val call: i64 = strip_casts(st, e);
        val args: i64 = st.nlst.get(call);
        if list_len(st, args) == 1 {
            val a: i64 = list_at(st, args, 0);
            val ak: i64 = st.nk.get(a);
            if ak == E_SIZEOF_T || ak == E_SIZEOF_E {
                return 1;
            }
        }
        return 2;
    }
    return 0;
}

fn note_init(st: &mut C2, s: i64, init: i64) {
    if init < 0 {
        return;
    }
    val ak: i64 = alloc_kind(st, init);
    if ak == 1 { flag(st, s, U_MALLOC_ONE); }
    if ak == 2 { flag(st, s, U_MALLOC_ARR); }
    val x: i64 = strip_casts(st, init);
    if st.nk.get(x) == E_UNARY && st.ntext.get(x) == "&" {
        flag(st, s, U_FROM_ADDR);
    }
    val t: i64 = st.nty.get(x);
    if is_ptrish(st, t) {
        val b: i64 = base_sym(st, x);
        flag(st, b, U_STORED);
        if !(st.sy_kind.get(s) == SK_LOCAL && is_ptr(st, st.sy_ty.get(s))) {
            flag(st, ptr_root_ident(st, x), U_STORED_ELSE);
        }
    }
}

fn note_cond(st: &mut C2, e: i64) {
    if e < 0 {
        return;
    }
    val t: i64 = st.nty.get(e);
    if is_ptr(st, t) {
        val b: i64 = base_sym(st, e);
        flag(st, b, U_NULLCMP);
    }
}

fn note_return(st: &mut C2, e: i64) {
    st.rt_fn.push(st.cur_fn);
    st.rt_node.push(e);
    val t: i64 = st.nty.get(e);
    if is_ptrish(st, t) {
        val b: i64 = base_sym(st, e);
        flag(st, b, U_RETURNED);
    }
}

// --- Parser: expressions ----------------------------------------------------------------

fn parse_expr(st: &mut C2) -> i64 {
    var a: i64 = parse_assign(st);
    while is_p(st, ",") && !st.perr {
        adv(st);
        val b: i64 = parse_assign(st);
        val t: i64 = st.nty.get(b);
        a = mk(st, E_COMMA, ",", a, b, -1, t);
    }
    return a;
}

fn is_assign_op(t: str) -> bool {
    return t == "=" || t == "+=" || t == "-=" || t == "*=" || t == "/=" || t == "%=" || t == "&=" || t == "|=" || t == "^=" || t == "<<=" || t == ">>=";
}

fn parse_assign(st: &mut C2) -> i64 {
    val lhs: i64 = parse_cond(st);
    if pkk(st) == TK_P && is_assign_op(pk(st)) {
        val op: str = pk(st);
        adv(st);
        val rhs: i64 = parse_assign(st);
        mark_write(st, lhs);
        val lt: i64 = st.nty.get(lhs);
        if is_ptr(st, lt) {
            val b: i64 = base_sym(st, lhs);
            if op == "=" {
                val ak: i64 = alloc_kind(st, rhs);
                if ak == 1 { flag(st, b, U_MALLOC_ONE); }
                if ak == 2 { flag(st, b, U_MALLOC_ARR); }
            } else {
                flag(st, b, U_ARITH);
            }
        }
        val rt: i64 = st.nty.get(rhs);
        var to_var: bool = false;
        if st.nk.get(lhs) == E_IDENT && is_ptr(st, lt) {
            val ls: i64 = st.nsym.get(lhs);
            if ls >= 0 && (st.sy_kind.get(ls) == SK_LOCAL || st.sy_kind.get(ls) == SK_PARAM) {
                to_var = true;
                st.pa_sym.push(ls);
                st.pa_rhs.push(rhs);
                st.pa_op.push(op);
            }
        }
        if is_ptrish(st, rt) {
            val rb: i64 = base_sym(st, rhs);
            flag(st, rb, U_STORED);
            if !to_var {
                flag(st, ptr_root_ident(st, rhs), U_STORED_ELSE);
            }
        }
        return mk(st, E_ASSIGN, op, lhs, rhs, -1, lt);
    }
    return lhs;
}

fn parse_cond(st: &mut C2) -> i64 {
    val c: i64 = parse_bin(st, 1);
    if is_p(st, "?") {
        adv(st);
        note_cond(st, c);
        val a: i64 = parse_expr(st);
        expect(st, ":");
        val b: i64 = parse_cond(st);
        val ta: i64 = st.nty.get(a);
        val tb: i64 = st.nty.get(b);
        var t: i64 = ta;
        if is_arith(st, ta) && is_arith(st, tb) {
            t = usual_arith(st, ta, tb);
        } else if st.nk.get(a) == E_NULL {
            t = tb;
        }
        return mk(st, E_COND, "?", c, a, b, t);
    }
    return c;
}

fn bin_prec(t: str) -> i64 {
    if t == "||" { return 1; }
    if t == "&&" { return 2; }
    if t == "|" { return 3; }
    if t == "^" { return 4; }
    if t == "&" { return 5; }
    if t == "==" || t == "!=" { return 6; }
    if t == "<" || t == ">" || t == "<=" || t == ">=" { return 7; }
    if t == "<<" || t == ">>" { return 8; }
    if t == "+" || t == "-" { return 9; }
    if t == "*" || t == "/" || t == "%" { return 10; }
    return 0;
}

fn parse_bin(st: &mut C2, min_prec: i64) -> i64 {
    var a: i64 = parse_unary(st);
    while pkk(st) == TK_P && !st.perr {
        val op: str = pk(st);
        val p: i64 = bin_prec(op);
        if p == 0 || p < min_prec {
            break;
        }
        adv(st);
        val b: i64 = parse_bin(st, p + 1);
        a = mk_bin(st, op, a, b);
    }
    return a;
}

fn is_null_lit(st: &mut C2, e: i64) -> bool {
    val x: i64 = strip_casts(st, e);
    val k: i64 = st.nk.get(x);
    return k == E_NULL || (k == E_INT && st.ntext.get(x) == "0");
}

/// C's usual arithmetic conversions (LP64 sizes).
fn usual_arith(st: &mut C2, a: i64, b: i64) -> i64 {
    if is_flt(st, a) || is_flt(st, b) {
        return st.t_double;
    }
    var ta: i64 = a;
    var tb: i64 = b;
    if !is_int(st, ta) || int_rank(st.yname.get(ta)) < 3 { ta = st.t_int; }
    if !is_int(st, tb) || int_rank(st.yname.get(tb)) < 3 { tb = st.t_int; }
    val ua: bool = is_unsigned(st, ta);
    val ub: bool = is_unsigned(st, tb);
    val ra: i64 = int_rank(st.yname.get(ta));
    val rb: i64 = int_rank(st.yname.get(tb));
    if ua == ub {
        if ra >= rb { return ta; }
        return tb;
    }
    var u: i64 = ta;
    var s: i64 = tb;
    var ru: i64 = ra;
    var rs: i64 = rb;
    if ub {
        u = tb;
        s = ta;
        ru = rb;
        rs = ra;
    }
    if ru >= rs {
        return u;
    }
    // the signed type is wider: long or long long holds an unsigned int
    if ru == 3 {
        return s;
    }
    return st.t_ulong;
}

fn promote(st: &mut C2, t: i64) -> i64 {
    if is_bool(st, t) {
        return st.t_int;
    }
    if is_int(st, t) && int_rank(st.yname.get(t)) < 3 {
        return st.t_int;
    }
    return t;
}

fn mk_bin(st: &mut C2, op: str, a: i64, b: i64) -> i64 {
    val ta: i64 = st.nty.get(a);
    val tb: i64 = st.nty.get(b);
    var t: i64 = st.t_int;
    if op == "&&" || op == "||" {
        note_cond(st, a);
        note_cond(st, b);
        t = st.t_bool;
    } else if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" {
        t = st.t_bool;
        if op == "==" || op == "!=" {
            if is_null_lit(st, b) && is_ptrish(st, ta) {
                val s: i64 = base_sym(st, a);
                flag(st, s, U_NULLCMP);
            }
            if is_null_lit(st, a) && is_ptrish(st, tb) {
                val s: i64 = base_sym(st, b);
                flag(st, s, U_NULLCMP);
            }
        }
    } else if (op == "+" || op == "-") && is_ptrish(st, ta) && is_arith(st, tb) {
        val s: i64 = base_sym(st, a);
        flag(st, s, U_ARITH);
        if is_array(st, ta) {
            val e: i64 = elem(st, ta);
            t = ty_ptr(st, e);
        } else {
            t = ta;
        }
    } else if op == "+" && is_ptrish(st, tb) && is_arith(st, ta) {
        val s: i64 = base_sym(st, b);
        flag(st, s, U_ARITH);
        t = tb;
    } else if op == "-" && is_ptrish(st, ta) && is_ptrish(st, tb) {
        t = ty_new(st, Y_INT, "long", -1, 0);
    } else if op == "<<" || op == ">>" {
        t = promote(st, ta);
    } else {
        t = usual_arith(st, ta, tb);
    }
    return mk(st, E_BIN, op, a, b, -1, t);
}

fn parse_unary(st: &mut C2) -> i64 {
    val t: str = pk(st);
    val k: i64 = pkk(st);
    if k == TK_P && (t == "++" || t == "--") {
        adv(st);
        val a: i64 = parse_unary(st);
        mark_write(st, a);
        val ta: i64 = st.nty.get(a);
        if is_ptr(st, ta) {
            val s: i64 = base_sym(st, a);
            flag(st, s, U_ARITH);
            if st.nk.get(a) == E_IDENT && s >= 0 {
                st.pa_sym.push(s);
                st.pa_rhs.push(-1);
                st.pa_op.push(t);
            }
        }
        var kind: i64 = E_PREINC;
        if t == "--" {
            kind = E_PREDEC;
        }
        return mk(st, kind, t, a, -1, -1, ta);
    }
    if k == TK_P && (t == "-" || t == "+" || t == "!" || t == "~" || t == "*" || t == "&") {
        adv(st);
        val a: i64 = parse_cast(st);
        val ta: i64 = st.nty.get(a);
        var ty: i64 = ta;
        if t == "!" {
            note_cond(st, a);
            ty = st.t_bool;
        } else if t == "*" {
            val s: i64 = base_sym(st, a);
            flag(st, s, U_DEREF);
            ty = elem(st, ta);
            if ty < 0 {
                ty = st.t_int;
            }
        } else if t == "&" {
            val r: i64 = root_var(st, a);
            flag(st, r, U_ADDR | U_MOD);
            if st.nk.get(a) == E_IDENT {
                flag(st, st.nsym.get(a), U_SELF_ADDR);
            }
            mark_inner_write(st, a);
            ty = ty_ptr(st, ta);
        } else {
            ty = promote(st, ta);
        }
        return mk(st, E_UNARY, t, a, -1, -1, ty);
    }
    if k == TK_ID && t == "sizeof" {
        adv(st);
        if is_p(st, "(") && is_type_start_at(st, 1) {
            adv(st);
            val tt: i64 = parse_type_name(st);
            expect(st, ")");
            val tl: i64 = ty_new(st, Y_INT, "long", -1, 0);
            val n: i64 = mk(st, E_SIZEOF_T, "", -1, -1, -1, tl);
            st.nd.set(n, tt);
            return n;
        }
        val a: i64 = parse_unary(st);
        val tl: i64 = ty_new(st, Y_INT, "long", -1, 0);
        return mk(st, E_SIZEOF_E, "", a, -1, -1, tl);
    }
    return parse_cast(st);
}

fn parse_type_name(st: &mut C2) -> i64 {
    val spec: Spec = parse_spec(st);
    val d: Decl = parse_declarator(st, spec.ty);
    return d.ty;
}

fn parse_cast(st: &mut C2) -> i64 {
    if is_p(st, "(") && is_type_start_at(st, 1) {
        adv(st);
        val t: i64 = parse_type_name(st);
        expect(st, ")");
        if is_p(st, "{") {
            val init: i64 = parse_initializer(st);
            val n: i64 = mk(st, E_CAST, "{}", init, -1, -1, t);
            return n;
        }
        val a: i64 = parse_unary(st);
        return mk(st, E_CAST, "", a, -1, -1, t);
    }
    return parse_postfix(st);
}

fn parse_postfix(st: &mut C2) -> i64 {
    var a: i64 = parse_primary(st);
    while pkk(st) == TK_P && !st.perr {
        val t: str = pk(st);
        if t == "[" {
            adv(st);
            val i: i64 = parse_expr(st);
            expect(st, "]");
            val ta: i64 = st.nty.get(a);
            var et: i64 = elem(st, ta);
            if et < 0 {
                et = st.t_int;
            }
            val s: i64 = base_sym(st, a);
            flag(st, s, U_INDEX);
            a = mk(st, E_INDEX, "", a, i, -1, et);
            continue;
        }
        if t == "(" {
            adv(st);
            var args: Vec<i64> = Vec::new();
            while !is_p(st, ")") && !at_eof(st) && !st.perr {
                val x: i64 = parse_assign(st);
                args.push(x);
                if !accept_p(st, ",") {
                    break;
                }
            }
            expect(st, ")");
            a = mk_call(st, a, args);
            continue;
        }
        if t == "." || t == "->" {
            adv(st);
            val fname: str = pk(st);
            adv(st);
            var bt: i64 = st.nty.get(a);
            if t == "->" {
                val s: i64 = base_sym(st, a);
                flag(st, s, U_ARROW);
                bt = elem(st, bt);
            }
            var sdi: i64 = -1;
            if is_struct(st, bt) {
                sdi = st.yelem.get(bt);
            }
            val f: i64 = field_of(st, sdi, fname);
            var ft: i64 = st.t_int;
            if f >= 0 {
                ft = st.sy_ty.get(f);
            }
            val n: i64 = mk(st, E_MEMBER, t, a, -1, -1, ft);
            st.nsym.set(n, f);
            st.nd.set(n, -1);
            st.ntext.set(n, t);
            // the field name lives in nc as a string index: keep it in a node
            val fnode: i64 = mk(st, E_IDENT, fname, -1, -1, -1, ft);
            st.nb.set(n, fnode);
            a = n;
            continue;
        }
        if t == "++" || t == "--" {
            adv(st);
            mark_write(st, a);
            val ta: i64 = st.nty.get(a);
            if is_ptr(st, ta) {
                val s: i64 = base_sym(st, a);
                flag(st, s, U_ARITH);
                if st.nk.get(a) == E_IDENT && s >= 0 {
                    st.pa_sym.push(s);
                    st.pa_rhs.push(-1);
                    st.pa_op.push(t);
                }
            }
            var kind: i64 = E_POSTINC;
            if t == "--" {
                kind = E_POSTDEC;
            }
            a = mk(st, kind, t, a, -1, -1, ta);
            continue;
        }
        break;
    }
    return a;
}

fn mk_call(st: &mut C2, f: i64, args: Vec<i64>) -> i64 {
    var ret: i64 = st.t_int;
    var callee: i64 = -1;
    var name: str = "";
    if st.nk.get(f) == E_IDENT {
        callee = st.nsym.get(f);
        name = st.ntext.get(f);
    }
    val ft: i64 = st.nty.get(f);
    if callee >= 0 && st.sy_kind.get(callee) == SK_FUNC {
        ret = elem(st, st.sy_ty.get(callee));
    } else if is_func(st, ft) {
        ret = elem(st, ft);
    } else if is_func_ptr(st, ft) {
        val fe: i64 = elem(st, ft);
        ret = elem(st, fe);
    } else {
        ret = libc_type(st, name);
    }
    if ret < 0 {
        ret = st.t_int;
    }
    var i: i64 = 0;
    while i < args.len() {
        val a: i64 = args.get(i);
        if callee >= 0 && st.sy_kind.get(callee) == SK_FUNC {
            st.cl_fn.push(callee);
            st.cl_idx.push(i);
            st.cl_arg.push(a);
        }
        if name == "free" {
            val s: i64 = base_sym(st, a);
            flag(st, s, U_FREED);
        }
        // a pointer passed to a callee may be kept by it
        val at: i64 = st.nty.get(a);
        if callee >= 0 && is_ptrish(st, at) && !is_charp(st, at) {
            val rv: i64 = root_var(st, a);
            flag(st, rv, U_MOD);
        }
        if is_ptr(st, at) && callee < 0 && name != "free" && name != "printf" && name != "fprintf" && name != "strlen" && name != "puts" {
            val s: i64 = base_sym(st, a);
            flag(st, s, U_PTR_WRITE);
        }
        if is_ptrish(st, at) && !(callee >= 0 && st.sy_kind.get(callee) == SK_FUNC) {
            // the C library (or a function pointer) gets the pointer itself
            flag(st, ptr_root_ident(st, a), U_LIBC_ARG);
        }
        i += 1;
    }
    if args.len() > 0 && callee < 0 && (name == "strcpy" || name == "strncpy" || name == "strcat" || name == "strncat" || name == "sprintf" || name == "snprintf" || name == "fgets" || name == "memset" || name == "memcpy") {
        // the C library writes its first argument
        mark_write(st, args.get(0));
    }
    val n: i64 = mk(st, E_CALL, name, f, -1, -1, ret);
    val l: i64 = list_new(st, args);
    st.nlst.set(n, l);
    return n;
}

/// The C type of a C library function's result.
fn libc_type(st: &mut C2, name: str) -> i64 {
    if name == "malloc" || name == "calloc" || name == "realloc" || name == "memcpy" || name == "memset" || name == "memmove" {
        return st.t_voidp;
    }
    if name == "fopen" {
        val f: i64 = st.t_file;
        return ty_ptr(st, f);
    }
    if name == "strcpy" || name == "strncpy" || name == "strcat" || name == "strncat" || name == "strchr" || name == "strrchr" || name == "strstr" || name == "strdup" || name == "fgets" || name == "getenv" {
        return st.t_charp;
    }
    if name == "atof" || name == "strtod" || name == "sqrt" || name == "pow" || name == "fabs" || name == "floor" || name == "ceil" || name == "sin" || name == "cos" || name == "tan" || name == "exp" || name == "log" || name == "log10" || name == "fmod" || name == "atan2" || name == "round" {
        return st.t_double;
    }
    if name == "isdigit" || name == "isalpha" || name == "isspace" || name == "isupper" || name == "islower" || name == "isalnum" || name == "ispunct" || name == "isxdigit" || name == "isprint" || name == "iscntrl" || name == "feof" {
        return st.t_bool;
    }
    if name == "atol" || name == "strtol" || name == "labs" || name == "time" || name == "clock" || name == "ftell" {
        return ty_new(st, Y_INT, "long", -1, 0);
    }
    return st.t_int;
}

fn parse_primary(st: &mut C2) -> i64 {
    val t: str = pk(st);
    val k: i64 = pkk(st);
    if k == TK_INT {
        adv(st);
        return mk(st, E_INT, t, -1, -1, -1, int_lit_type(st, t));
    }
    if k == TK_FLT {
        adv(st);
        return mk(st, E_FLT, t, -1, -1, -1, st.t_double);
    }
    if k == TK_STR {
        adv(st);
        return mk(st, E_STR, t, -1, -1, -1, st.t_charp);
    }
    if k == TK_CHR {
        adv(st);
        return mk(st, E_CHR, t, -1, -1, -1, st.t_int);
    }
    if k == TK_P && t == "(" {
        adv(st);
        val e: i64 = parse_expr(st);
        expect(st, ")");
        return e;
    }
    if k == TK_ID {
        adv(st);
        if t == "NULL" {
            return mk(st, E_NULL, t, -1, -1, -1, st.t_voidp);
        }
        if t == "true" || t == "false" {
            return mk(st, E_BOOL, t, -1, -1, -1, st.t_bool);
        }
        val s: i64 = lookup(st, t);
        var ty: i64 = st.t_int;
        if s >= 0 {
            ty = st.sy_ty.get(s);
            if ty < 0 {
                ty = st.t_int;
            }
        } else if t == "stdin" || t == "stdout" || t == "stderr" {
            val f: i64 = st.t_file;
            ty = ty_ptr(st, f);
        }
        val n: i64 = mk(st, E_IDENT, t, -1, -1, -1, ty);
        st.nsym.set(n, s);
        return n;
    }
    parse_err(st, "expected an expression");
    adv(st);
    return mk(st, E_INT, "0", -1, -1, -1, st.t_int);
}

fn int_lit_type(st: &mut C2, t: str) -> i64 {
    var u: bool = false;
    var l: i64 = 0;
    var i: i64 = str_len(t) - 1;
    val hex: bool = str_starts_with(t, "0x") || str_starts_with(t, "0X");
    while i > 0 {
        val c: i64 = str_byte_at(t, i);
        if c == 117 || c == 85 {
            u = true;
        } else if c == 108 || c == 76 {
            l += 1;
        } else {
            break;
        }
        i -= 1;
    }
    if u && l > 0 { return st.t_ulong; }
    if u { return st.t_uint; }
    if l > 0 { return ty_new(st, Y_INT, "long", -1, 0); }
    val v: i64 = parse_c_int(t);
    if v > 2147483647 || v < 0 {
        return ty_new(st, Y_INT, "long", -1, 0);
    }
    return st.t_int;
}

// --- The program ------------------------------------------------------------------------

fn parse_program(st: &mut C2) {
    scope_push(st);
    while !at_eof(st) {
        val start: i64 = st.pos;
        val before: i64 = st.items.len();
        st.perr = false;
        parse_top(st);
        if st.perr {
            // keep what could not be parsed, as a comment
            st.items.truncate(before);
            var depth: i64 = 0;
            var p: i64 = start;
            // from the start of the item to its end: a ';' or '}' at depth 0
            while p < st.xk.len() - 1 {
                val t: str = st.xt.get(p);
                val k: i64 = st.xk.get(p);
                if k == TK_P && t == "{" { depth += 1; }
                if k == TK_P && t == "}" {
                    depth -= 1;
                    if depth <= 0 {
                        p += 1;
                        if p < st.xk.len() - 1 && st.xt.get(p) == ";" { p += 1; }
                        break;
                    }
                }
                if k == TK_P && t == ";" && depth == 0 {
                    p += 1;
                    break;
                }
                p += 1;
            }
            if p <= start {
                p = start + 1;
            }
            val node: i64 = mk(st, T_TODO, st.perr_msg, start, p, -1, -1);
            st.items.push(node);
            st.pos = p;
            st.perr = false;
        }
        var i: i64 = before;
        while i < st.items.len() {
            val it: i64 = st.items.get(i);
            st.nline.set(it, st.xl.get(start));
            i += 1;
        }
    }
}

// --- Deciding the Fid form of each pointer ---------------------------------------------

fn mark_linked(st: &mut C2) {
    var i: i64 = 0;
    while i < st.sy_name.len() {
        if st.sy_kind.get(i) == SK_FIELD {
            val t: i64 = st.sy_ty.get(i);
            if is_struct_ptr(st, t) {
                val e: i64 = elem(st, t);
                val sdi: i64 = st.yelem.get(e);
                st.sd_linked.set(sdi, true);
            }
        }
        i += 1;
    }
}

fn ret_repr_of_call(st: &mut C2, init: i64) -> i64 {
    val x: i64 = strip_casts(st, init);
    if x < 0 || st.nk.get(x) != E_CALL {
        return -1;
    }
    val f: i64 = st.na.get(x);
    if st.nk.get(f) != E_IDENT {
        return -1;
    }
    val s: i64 = st.nsym.get(f);
    if s < 0 || st.sy_kind.get(s) != SK_FUNC || !st.sy_defined.get(s) {
        return -1;
    }
    return st.sy_ret.get(s);
}

// --- Cursors: pointers into arrays as indexes -------------------------------------
//
// `int *p = a; ... *p++ ...` keeps no raw pointer: `p` becomes an i64 index
// into the Vec `a` (R_CUR), and a pointer parameter that is moved, or that
// callers point into the middle of an array, becomes the Vec and an offset
// (R_PCUR, `p: &mut Vec<T>, p_at: i64`). `*p` is `a[p]`, `p[i]` and
// `*(p + i)` are `a[p + i]`, `p++` is `p += 1`, `q - p` is an index
// difference and `p < end` compares indexes.

/// The element type of a pointer that can be a cursor (a pointer to a
/// number or a char), or -1.
fn cur_elem(st: &mut C2, t: i64) -> i64 {
    if !is_ptr(st, t) {
        return -1;
    }
    val e: i64 = elem(st, t);
    if e < 0 || !is_arith(st, e) {
        return -1;
    }
    return e;
}

/// Nothing a cursor cannot follow happens to `s`: it is not allocated,
/// freed, returned, compared with NULL, kept in a field, handed to the C
/// library, nor is its own address taken.
fn cur_flags_ok(st: &mut C2, s: i64) -> bool {
    val bad: i64 = U_MALLOC_ONE | U_MALLOC_ARR | U_FREED | U_RETURNED | U_SELF_ADDR | U_NULLCMP | U_PTR_WRITE | U_STATIC | U_LIBC_ARG | U_STORED_ELSE;
    return (st.sy_flags.get(s) & bad) == 0;
}

/// Whether `b` can be the array a cursor of element type `e` walks.
fn cur_base_ok(st: &mut C2, b: i64, e: i64) -> bool {
    if b < 0 {
        return false;
    }
    val k: i64 = st.sy_kind.get(b);
    if k != SK_LOCAL && k != SK_PARAM {
        return false;
    }
    if has_flag(st, b, U_STATIC) {
        return false;
    }
    val bt: i64 = st.sy_ty.get(b);
    if !is_ptrish(st, bt) {
        return false;
    }
    val be: i64 = elem(st, bt);
    if be < 0 {
        return false;
    }
    val r: i64 = st.sy_repr.get(b);
    if is_charlike(st, e) || is_charlike(st, be) {
        if !(is_charlike(st, e) && is_charlike(st, be)) {
            return false;
        }
        return r == R_BYTES || r == R_BYTESREF || r == R_PCUR;
    }
    if fid_val_type(st, e) != fid_val_type(st, be) {
        return false;
    }
    if r == R_VEC || r == R_VECREF || r == R_PCUR {
        return true;
    }
    // a parameter read as one value until now: it becomes the caller's array
    return k == SK_PARAM && r == R_REF;
}

/// The array symbol the pointer expression `e` (a value given to `s`)
/// points into; -2 when it is `s` itself moved (`p + 1`, `p++`), -1 when
/// it is no pointer into an array.
fn cur_src_base(st: &mut C2, e: i64, s: i64) -> i64 {
    val x: i64 = strip_casts(st, e);
    if x < 0 {
        return -1;
    }
    val k: i64 = st.nk.get(x);
    if k == E_IDENT {
        val y: i64 = st.nsym.get(x);
        if y < 0 {
            return -1;
        }
        if y == s {
            return -2;
        }
        if st.sy_repr.get(y) == R_CUR {
            return st.sy_cbase.get(y);
        }
        return y;
    }
    if k == E_BIN {
        val op: str = st.ntext.get(x);
        val a: i64 = st.na.get(x);
        val b: i64 = st.nb.get(x);
        if (op == "+" || op == "-") && is_ptrish(st, st.nty.get(a)) && is_arith(st, st.nty.get(b)) {
            return cur_src_base(st, a, s);
        }
        if op == "+" && is_ptrish(st, st.nty.get(b)) && is_arith(st, st.nty.get(a)) {
            return cur_src_base(st, b, s);
        }
        return -1;
    }
    if k == E_UNARY && st.ntext.get(x) == "&" {
        val inner: i64 = st.na.get(x);
        if st.nk.get(inner) == E_INDEX {
            return cur_src_base(st, st.na.get(inner), s);
        }
        return -1;
    }
    if k == E_PREINC || k == E_PREDEC || k == E_POSTINC || k == E_POSTDEC {
        val inner: i64 = strip_casts(st, st.na.get(x));
        if st.nk.get(inner) != E_IDENT {
            return -1;
        }
        val y: i64 = st.nsym.get(inner);
        if y == s {
            return -2;
        }
        if y >= 0 && st.sy_repr.get(y) == R_CUR {
            return st.sy_cbase.get(y);
        }
        if y >= 0 && st.sy_repr.get(y) == R_PCUR {
            return y;
        }
        return -1;
    }
    return -1;
}

/// A pointer argument that need not point at the start of its array.
fn cur_offsetish(st: &mut C2, a: i64, arrayish: bool) -> bool {
    val x: i64 = strip_casts(st, a);
    if x < 0 {
        return false;
    }
    val k: i64 = st.nk.get(x);
    if k == E_IDENT {
        val y: i64 = st.nsym.get(x);
        return y >= 0 && (st.sy_repr.get(y) == R_CUR || st.sy_repr.get(y) == R_PCUR);
    }
    if k == E_BIN || k == E_PREINC || k == E_PREDEC || k == E_POSTINC || k == E_POSTDEC {
        return true;
    }
    if k == E_UNARY && st.ntext.get(x) == "&" {
        // &a[i] for a parameter used as an array (one read as a single
        // value keeps its reference: swap(&a[i], &a[j]))
        return arrayish;
    }
    return false;
}

/// The function whose parameter `s` is, or -1.
fn param_owner(st: &mut C2, s: i64) -> i64 {
    var f: i64 = 0;
    while f < st.sy_name.len() {
        if st.sy_kind.get(f) == SK_FUNC {
            val pl: i64 = st.sy_params.get(f);
            if pl >= 0 {
                var i: i64 = 0;
                while i < list_len(st, pl) {
                    if list_at(st, pl, i) == s {
                        return f;
                    }
                    i += 1;
                }
            }
        }
        f += 1;
    }
    return -1;
}

/// The parameter a recorded call argument goes to, or -1.
fn call_param(st: &mut C2, c: i64) -> i64 {
    val callee: i64 = st.cl_fn.get(c);
    val pl: i64 = st.sy_params.get(callee);
    val idx: i64 = st.cl_idx.get(c);
    if pl < 0 || idx >= list_len(st, pl) {
        return -1;
    }
    return list_at(st, pl, idx);
}

/// Where the value of pointer `s` goes, a cursor can follow it: into other
/// cursors and cursor parameters only, never out of the function.
fn cur_uses_ok(st: &mut C2, s: i64) -> bool {
    var j: i64 = 0;
    while j < st.rt_node.len() {
        if ptr_root_ident(st, st.rt_node.get(j)) == s {
            return false;
        }
        j += 1;
    }
    var y: i64 = 0;
    while y < st.sy_name.len() {
        val init: i64 = st.sy_init.get(y);
        if y != s && init >= 0 && st.nk.get(init) != E_INIT && is_ptrish(st, st.nty.get(init)) && ptr_root_ident(st, init) == s {
            if st.sy_repr.get(y) != R_CUR {
                return false;
            }
        }
        y += 1;
    }
    j = 0;
    while j < st.pa_sym.len() {
        val rhs: i64 = st.pa_rhs.get(j);
        val d: i64 = st.pa_sym.get(j);
        if d != s && rhs >= 0 && ptr_root_ident(st, rhs) == s {
            if st.sy_repr.get(d) != R_CUR && st.sy_repr.get(d) != R_PCUR {
                return false;
            }
        }
        j += 1;
    }
    var c: i64 = 0;
    while c < st.cl_fn.len() {
        val a: i64 = st.cl_arg.get(c);
        if is_ptrish(st, st.nty.get(a)) && ptr_root_ident(st, a) == s {
            val p: i64 = call_param(st, c);
            // (a parameter handed to itself in a recursive call is fine)
            if p < 0 || (p != s && st.sy_repr.get(p) != R_PCUR) {
                return false;
            }
        }
        c += 1;
    }
    return true;
}

/// R_CUR for a local pointer that only ever points into one array.
fn decide_local_cur(st: &mut C2, s: i64, e: i64) -> i64 {
    if !cur_flags_ok(st, s) {
        return -1;
    }
    var base: i64 = -1;
    val init: i64 = st.sy_init.get(s);
    if init >= 0 {
        if st.nk.get(init) == E_INIT {
            return -1;
        }
        val b: i64 = cur_src_base(st, init, s);
        if b < 0 {
            return -1;
        }
        base = b;
    }
    var j: i64 = 0;
    while j < st.pa_sym.len() {
        if st.pa_sym.get(j) == s {
            val op: str = st.pa_op.get(j);
            if op == "=" {
                val b: i64 = cur_src_base(st, st.pa_rhs.get(j), s);
                if b == -1 {
                    return -1;
                }
                if b >= 0 {
                    if base >= 0 && b != base {
                        return -1;
                    }
                    base = b;
                }
            } else if op != "+=" && op != "-=" && op != "++" && op != "--" {
                return -1;
            }
        }
        j += 1;
    }
    if !cur_base_ok(st, base, e) {
        return -1;
    }
    if !cur_uses_ok(st, s) {
        return -1;
    }
    st.sy_cbase.set(s, base);
    return R_CUR;
}

/// R_PCUR for a pointer parameter that is moved, or that some caller points
/// into the middle of an array (then its offset is a parameter too).
fn decide_param_cur(st: &mut C2, s: i64, e: i64) -> i64 {
    if !cur_flags_ok(st, s) {
        return -1;
    }
    if is_charlike(st, e) && !has_flag(st, s, U_ELEM_WRITE) {
        // a string only read stays a str
        return -1;
    }
    val owner: i64 = param_owner(st, s);
    if owner < 0 || !st.sy_defined.get(owner) {
        return -1;
    }
    var moved: bool = false;
    var j: i64 = 0;
    while j < st.pa_sym.len() {
        if st.pa_sym.get(j) == s {
            val op: str = st.pa_op.get(j);
            if op == "=" {
                if cur_src_base(st, st.pa_rhs.get(j), s) != -2 {
                    return -1;
                }
                moved = true;
            } else if op == "+=" || op == "-=" || op == "++" || op == "--" {
                moved = true;
            } else {
                return -1;
            }
        }
        j += 1;
    }
    val arrayish: bool = moved || has_flag(st, s, U_INDEX | U_ARITH);
    var ext: bool = false;
    var c: i64 = 0;
    while c < st.cl_fn.len() {
        if call_param(st, c) == s {
            val a: i64 = st.cl_arg.get(c);
            val b: i64 = cur_src_base(st, a, -1);
            if !cur_base_ok(st, b, e) {
                // a caller passes something that is no array: keep the old form
                return -1;
            }
            if cur_offsetish(st, a, arrayish) {
                ext = true;
            }
        }
        c += 1;
    }
    if !moved && !ext {
        return -1;
    }
    if !cur_uses_ok(st, s) {
        return -1;
    }
    st.sy_cext.set(s, ext);
    return R_PCUR;
}

/// Whether a local cursor walks the array `s`.
fn is_cursor_base(st: &mut C2, s: i64) -> bool {
    var y: i64 = 0;
    while y < st.sy_name.len() {
        if st.sy_repr.get(y) == R_CUR && st.sy_cbase.get(y) == s {
            return true;
        }
        y += 1;
    }
    return false;
}

/// Before the representations are decided: every pointer that could be a
/// cursor is taken to be one (cursors depend on each other through calls
/// and copies, so the rounds of decide_all only take back what fails), and
/// a write through a copy of a pointer is a write through the pointer.
fn cur_prepare(st: &mut C2) {
    var round: i64 = 0;
    while round < 4 {
        var y: i64 = 0;
        while y < st.sy_name.len() {
            val init: i64 = st.sy_init.get(y);
            if has_flag(st, y, U_ELEM_WRITE) && init >= 0 && st.nk.get(init) != E_INIT && is_ptrish(st, st.nty.get(init)) {
                flag(st, ptr_root_ident(st, init), U_ELEM_WRITE);
            }
            y += 1;
        }
        var j: i64 = 0;
        while j < st.pa_sym.len() {
            val rhs: i64 = st.pa_rhs.get(j);
            if rhs >= 0 && has_flag(st, st.pa_sym.get(j), U_ELEM_WRITE) && is_ptrish(st, st.nty.get(rhs)) {
                flag(st, ptr_root_ident(st, rhs), U_ELEM_WRITE);
            }
            j += 1;
        }
        round += 1;
    }
    // the others first (arrays, Vecs: what a cursor's checks read), then
    // every candidate as a cursor
    var s: i64 = 0;
    while s < st.sy_name.len() {
        val k: i64 = st.sy_kind.get(s);
        val cand: bool = (k == SK_LOCAL || k == SK_PARAM) && cur_elem(st, st.sy_ty.get(s)) >= 0 && cur_flags_ok(st, s);
        if !cand && (k == SK_GLOBAL || k == SK_LOCAL || k == SK_PARAM || k == SK_FIELD) {
            st.sy_repr.set(s, decide(st, s));
        }
        s += 1;
    }
    s = 0;
    while s < st.sy_name.len() {
        val k: i64 = st.sy_kind.get(s);
        if (k == SK_LOCAL || k == SK_PARAM) && cur_elem(st, st.sy_ty.get(s)) >= 0 && cur_flags_ok(st, s) {
            if k == SK_LOCAL {
                st.sy_repr.set(s, R_CUR);
            } else {
                st.sy_repr.set(s, R_PCUR);
            }
        }
        s += 1;
    }
}

fn decide(st: &mut C2, s: i64) -> i64 {
    val t: i64 = st.sy_ty.get(s);
    val f: i64 = st.sy_flags.get(s);
    val kind: i64 = st.sy_kind.get(s);
    if is_array(st, t) {
        val e: i64 = elem(st, t);
        if is_charlike(st, e) {
            if (f & U_ELEM_WRITE) != 0 {
                return R_BYTES;
            }
            return R_STR;
        }
        return R_VEC;
    }
    if !is_ptr(st, t) {
        return R_VAL;
    }
    val e: i64 = elem(st, t);
    if e >= 0 && st.yk.get(e) == Y_FILE {
        return R_FILE;
    }
    if is_func(st, e) {
        return R_VAL;
    }
    if cur_elem(st, t) >= 0 {
        // a pointer that walks an array: an index into it
        var cr: i64 = -1;
        if kind == SK_LOCAL {
            cr = decide_local_cur(st, s, e);
        } else if kind == SK_PARAM {
            cr = decide_param_cur(st, s, e);
        }
        if cr >= 0 {
            return cr;
        }
    }
    if is_charlike(st, e) {
        if kind == SK_PARAM && (f & U_ELEM_WRITE) != 0 {
            return R_BYTESREF;
        }
        if (f & U_MALLOC_ARR) != 0 {
            return R_BYTES;
        }
        return R_STR;
    }
    if e >= 0 && st.yk.get(e) == Y_VOID {
        return R_RAW;
    }
    val init: i64 = st.sy_init.get(s);
    if kind == SK_LOCAL && init >= 0 {
        val rr: i64 = ret_repr_of_call(st, init);
        if rr == R_VEC || rr == R_RAW {
            return rr;
        }
    }
    if is_struct(st, e) {
        val sdi: i64 = st.yelem.get(e);
        if st.sd_linked.get(sdi) {
            return R_RAW;
        }
        if (f & (U_NULLCMP | U_ARITH | U_FREED | U_MALLOC_ONE | U_MALLOC_ARR | U_STORED | U_RETURNED | U_INDEX)) != 0 {
            return R_RAW;
        }
        if kind == SK_PARAM {
            return R_REF;
        }
        if kind == SK_LOCAL && (f & U_FROM_ADDR) != 0 && st.sy_assigns.get(s) == 0 {
            return R_REF;
        }
        return R_RAW;
    }
    if (f & U_MALLOC_ARR) != 0 {
        return R_VEC;
    }
    if kind == SK_PARAM {
        if (f & U_NULLCMP) != 0 {
            return R_RAW;
        }
        if (f & (U_INDEX | U_ARITH)) != 0 {
            return R_VECREF;
        }
        if is_cursor_base(st, s) {
            // a local pointer walks it: the caller's array
            return R_VECREF;
        }
        return R_REF;
    }
    if kind == SK_LOCAL && (f & U_FROM_ADDR) != 0 && st.sy_assigns.get(s) == 0 && (f & (U_ARITH | U_INDEX)) == 0 {
        return R_REF;
    }
    return R_RAW;
}

fn decide_all(st: &mut C2) {
    mark_linked(st);
    cur_prepare(st);
    var round: i64 = 0;
    while round < 6 {
        var s: i64 = 0;
        while s < st.sy_name.len() {
            val k: i64 = st.sy_kind.get(s);
            if k == SK_GLOBAL || k == SK_LOCAL || k == SK_PARAM || k == SK_FIELD {
                val r: i64 = decide(st, s);
                st.sy_repr.set(s, r);
            }
            s += 1;
        }
        // function results
        s = 0;
        while s < st.sy_name.len() {
            if st.sy_kind.get(s) == SK_FUNC {
                val rt: i64 = elem(st, st.sy_ty.get(s));
                var r: i64 = R_VAL;
                if is_charp(st, rt) {
                    r = R_STR;
                } else if is_ptr(st, rt) {
                    val pe: i64 = elem(st, rt);
                    if pe >= 0 && st.yk.get(pe) == Y_FILE {
                        r = R_FILE;
                    } else {
                        r = R_RAW;
                    }
                }
                var j: i64 = 0;
                while j < st.rt_fn.len() {
                    if st.rt_fn.get(j) == s {
                        val b: i64 = base_sym(st, st.rt_node.get(j));
                        if b >= 0 && (st.sy_repr.get(b) == R_VEC || st.sy_repr.get(b) == R_BYTES) {
                            r = st.sy_repr.get(b);
                        }
                    }
                    j += 1;
                }
                st.sy_ret.set(s, r);
            }
            s += 1;
        }
        // a char buffer passed to a parameter that writes it must be bytes
        var c: i64 = 0;
        while c < st.cl_fn.len() {
            val callee: i64 = st.cl_fn.get(c);
            val pl: i64 = st.sy_params.get(callee);
            val idx: i64 = st.cl_idx.get(c);
            if pl >= 0 && idx < list_len(st, pl) {
                val p: i64 = list_at(st, pl, idx);
                val pr: i64 = st.sy_repr.get(p);
                val a: i64 = st.cl_arg.get(c);
                val b: i64 = base_sym(st, a);
                if pr == R_BYTESREF && b >= 0 {
                    flag(st, b, U_ELEM_WRITE);
                }
                if pr == R_RAW && b >= 0 && st.sy_kind.get(b) == SK_PARAM && is_struct_ptr(st, st.sy_ty.get(b)) {
                    // a reference parameter handed on to a raw one stays raw too
                    flag(st, b, U_STORED);
                }
                if pr == R_PCUR {
                    // the caller's array goes in as `&mut`, and is written
                    // when the parameter is
                    val cb: i64 = cur_src_base(st, a, -1);
                    if cb >= 0 {
                        if !is_const(st, elem(st, st.sy_ty.get(p))) {
                            flag(st, cb, U_MOD);
                        }
                        if has_flag(st, p, U_ELEM_WRITE) {
                            flag(st, cb, U_ELEM_WRITE);
                        }
                    }
                }
            }
            c += 1;
        }
        // a write through a cursor writes its array
        var y: i64 = 0;
        while y < st.sy_name.len() {
            if st.sy_repr.get(y) == R_CUR && has_flag(st, y, U_ELEM_WRITE) {
                val cb: i64 = st.sy_cbase.get(y);
                if cb >= 0 {
                    flag(st, cb, U_ELEM_WRITE | U_MOD);
                }
            }
            y += 1;
        }
        round += 1;
    }
}

fn repr_of_type(st: &mut C2, t: i64) -> i64 {
    if is_array(st, t) {
        val e: i64 = elem(st, t);
        if is_charlike(st, e) {
            return R_BYTES;
        }
        return R_VEC;
    }
    if is_charp(st, t) {
        return R_STR;
    }
    if is_ptr(st, t) {
        val e: i64 = elem(st, t);
        if e >= 0 && st.yk.get(e) == Y_FILE {
            return R_FILE;
        }
        if is_func(st, e) {
            return R_VAL;
        }
        return R_RAW;
    }
    return R_VAL;
}

// --- Fid types ----------------------------------------------------------------------------

fn fid_val_type(st: &mut C2, t: i64) -> str {
    if t < 0 {
        return "i64";
    }
    val k: i64 = st.yk.get(t);
    val al: str = st.yalias.get(t);
    if al != "" && (k == Y_INT || k == Y_FLT || k == Y_BOOL || k == Y_PTR) {
        return safe_type_name(st, al);
    }
    if k == Y_PTR {
        return fid_elem_type(st, t);
    }
    if k == Y_ARRAY {
        val e: i64 = elem(st, t);
        if is_charlike(st, e) {
            return "Vec<i64>";
        }
        val et: str = fid_elem_type(st, e);
        return "Vec<" + et + ">";
    }
    if k == Y_FUNC {
        val pl: i64 = st.ylst.get(t);
        var ps: Vec<str> = Vec::new();
        var i: i64 = 0;
        val n: i64 = list_len(st, pl);
        while i < n {
            val pn: i64 = list_at(st, pl, i);
            val pt: str = fid_elem_type(st, st.nty.get(pn));
            ps.push(pt);
            i += 1;
        }
        val rt: i64 = elem(st, t);
        var ret: str = fid_elem_type(st, rt);
        return "fn(" + join_lines(ps, ", ") + ") -> " + ret;
    }
    return fid_base(st, t);
}

/// The Fid type of a value of C type `t` that has no variable of its own
/// (an element, a function's parameter in a function type).
fn fid_elem_type(st: &mut C2, t: i64) -> str {
    if t < 0 {
        return "i64";
    }
    if is_charp(st, t) {
        return "str";
    }
    if is_ptr(st, t) {
        val e: i64 = elem(st, t);
        if e >= 0 && st.yk.get(e) == Y_FILE {
            return "CFile";
        }
        if is_func(st, e) {
            return fid_val_type(st, e);
        }
        return "*mut " + fid_raw_pointee(st, e);
    }
    return fid_val_type(st, t);
}

fn fid_raw_pointee(st: &mut C2, e: i64) -> str {
    if e < 0 || st.yk.get(e) == Y_VOID {
        return "u8";
    }
    if is_ptr(st, e) {
        val e2: i64 = elem(st, e);
        return "*mut " + fid_raw_pointee(st, e2);
    }
    if is_array(st, e) {
        return fid_raw_pointee(st, elem(st, e));
    }
    return fid_val_type(st, e);
}

fn fid_type(st: &mut C2, t: i64, r: i64, kind: i64) -> str {
    if r == R_STR {
        return "str";
    }
    if r == R_BYTES {
        return "Vec<i64>";
    }
    if r == R_BYTESREF {
        val e: i64 = elem(st, t);
        if is_const(st, e) {
            return "&Vec<i64>";
        }
        return "&mut Vec<i64>";
    }
    if r == R_CUR {
        return "i64";
    }
    if r == R_VEC || r == R_VECREF || r == R_PCUR {
        val e: i64 = elem(st, t);
        var et: str = "i64";
        if is_charlike(st, e) && (is_array(st, t) || r == R_PCUR) {
            et = "i64";
        } else {
            et = fid_elem_type(st, e);
        }
        if r == R_VEC {
            return "Vec<" + et + ">";
        }
        if is_const(st, e) {
            return "&Vec<" + et + ">";
        }
        return "&mut Vec<" + et + ">";
    }
    if r == R_REF {
        val e: i64 = elem(st, t);
        val et: str = fid_val_type(st, e);
        if is_const(st, e) {
            return "&" + et;
        }
        return "&mut " + et;
    }
    if r == R_RAW {
        val e: i64 = elem(st, t);
        return "*mut " + fid_raw_pointee(st, e);
    }
    if r == R_FILE {
        if kind == SK_PARAM {
            return "&mut CFile";
        }
        return "CFile";
    }
    return fid_val_type(st, t);
}

fn sym_type(st: &mut C2, s: i64) -> str {
    val t: i64 = st.sy_ty.get(s);
    val r: i64 = st.sy_repr.get(s);
    val k: i64 = st.sy_kind.get(s);
    return fid_type(st, t, r, k);
}

// --- Emission: expressions ------------------------------------------------------------

// Fid precedence levels (higher binds tighter), reference.md 4.1
const P_IF: i64 = 0;
const P_OR: i64 = 4;
const P_BOR: i64 = 5;
const P_XOR: i64 = 6;
const P_BAND: i64 = 7;
const P_SHIFT: i64 = 8;
const P_AND: i64 = 9;
const P_EQ: i64 = 10;
const P_CMP: i64 = 11;
const P_ADD: i64 = 12;
const P_MUL: i64 = 13;
const P_UNARY: i64 = 14;
const P_POST: i64 = 15;
const P_PRIM: i64 = 16;
// the null pointer, until a context gives it a type
const R_NULL: i64 = 99;

fn ex(code: str, prec: i64, ty: i64, repr: i64) -> Ex {
    return Ex { code: code, prec: prec, ty: ty, repr: repr };
}

fn fid_prec(op: str) -> i64 {
    if op == "||" { return P_OR; }
    if op == "&&" { return P_AND; }
    if op == "|" { return P_BOR; }
    if op == "^" { return P_XOR; }
    if op == "&" { return P_BAND; }
    if op == "<<" || op == ">>" { return P_SHIFT; }
    if op == "==" || op == "!=" { return P_EQ; }
    if op == "<" || op == ">" || op == "<=" || op == ">=" { return P_CMP; }
    if op == "+" || op == "-" { return P_ADD; }
    return P_MUL;
}

fn paren(e: Ex, min: i64) -> str {
    if e.prec < min {
        return "(" + e.code + ")";
    }
    return e.code;
}

fn note(st: &mut C2, msg: str) {
    st.notes.push("// TODO(c2fd): " + msg);
    st.todo_count += 1;
}

fn use_h(st: &mut C2, name: str) {
    if !st.helpers.contains(name) {
        st.helpers.insert(name, 1);
    }
}

fn new_tmp(st: &mut C2) -> str {
    st.tmp_n += 1;
    return "_t" + int_to_str(st.tmp_n);
}

fn pre_add(st: &mut C2, line: str) {
    st.pre.push(line);
}

/// The lines of `pre` from `mark` on, removed from it.
fn pre_take(st: &mut C2, mark: i64) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = mark;
    while i < st.pre.len() {
        out.push(st.pre.get(i));
        i += 1;
    }
    st.pre.truncate(mark);
    return out;
}

fn hexdig(v: i64) -> str {
    return char_to_str(str_byte_at("0123456789abcdef", v & 15));
}

fn hex2(v: i64) -> str {
    return hexdig(v >> 4) + hexdig(v);
}

/// A C string literal's text (escapes as written) as a Fid literal's text.
fn fid_str_text(t: str) -> str {
    var sb: StringBuilder = StringBuilder::new();
    val n: i64 = str_len(t);
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(t, i);
        if c == 92 && i + 1 < n {
            val e: i64 = str_byte_at(t, i + 1);
            i += 2;
            if e == 110 { sb.append_str("\\n"); continue; }
            if e == 116 { sb.append_str("\\t"); continue; }
            if e == 114 { sb.append_str("\\r"); continue; }
            if e == 92 { sb.append_str("\\\\"); continue; }
            if e == 34 { sb.append_str("\\\""); continue; }
            if e == 39 { sb.append_str("'"); continue; }
            if e == 63 { sb.append_str("?"); continue; }
            if e == 97 { sb.append_str("\\x07"); continue; }
            if e == 98 { sb.append_str("\\x08"); continue; }
            if e == 102 { sb.append_str("\\x0c"); continue; }
            if e == 118 { sb.append_str("\\x0b"); continue; }
            if e == 120 {
                var v: i64 = 0;
                var k: i64 = 0;
                while i < n && k < 2 {
                    val d: i64 = str_byte_at(t, i);
                    var dv: i64 = -1;
                    if d >= 48 && d <= 57 { dv = d - 48; }
                    if d >= 97 && d <= 102 { dv = d - 87; }
                    if d >= 65 && d <= 70 { dv = d - 55; }
                    if dv < 0 { break; }
                    v = v * 16 + dv;
                    i += 1;
                    k += 1;
                }
                sb.append_str(byte_escape(v));
                continue;
            }
            if e >= 48 && e <= 55 {
                var v: i64 = e - 48;
                var k: i64 = 1;
                while i < n && k < 3 && str_byte_at(t, i) >= 48 && str_byte_at(t, i) <= 55 {
                    v = v * 8 + (str_byte_at(t, i) - 48);
                    i += 1;
                    k += 1;
                }
                sb.append_str(byte_escape(v));
                continue;
            }
            sb.append_str(char_to_str(e));
            continue;
        }
        sb.append_str(char_to_str(c));
        i += 1;
    }
    return sb.to_str();
}

fn byte_escape(v: i64) -> str {
    if v == 0 { return "\\0"; }
    if v == 10 { return "\\n"; }
    if v == 9 { return "\\t"; }
    if v == 13 { return "\\r"; }
    if v == 34 { return "\\\""; }
    if v == 92 { return "\\\\"; }
    if v >= 32 && v < 127 { return char_to_str(v); }
    return "\\x" + hex2(v);
}

fn fid_char_lit(t: str) -> str {
    val v: i64 = char_value(t);
    if v == 39 { return "'\\''"; }
    if v == 92 { return "'\\\\'"; }
    if v == 10 { return "'\\n'"; }
    if v == 9 { return "'\\t'"; }
    if v == 13 { return "'\\r'"; }
    if v == 0 { return "'\\0'"; }
    if v >= 32 && v < 127 { return "'" + char_to_str(v) + "'"; }
    if v < 256 { return "'\\x" + hex2(v) + "'"; }
    return int_to_str(v);
}

fn fid_int_lit(t: str) -> str {
    var s: str = t;
    while str_len(s) > 1 {
        val c: i64 = str_byte_at(s, str_len(s) - 1);
        if c == 117 || c == 85 || c == 108 || c == 76 {
            s = str_slice(s, 0, str_len(s) - 1);
        } else {
            break;
        }
    }
    if str_len(s) > 1 && str_starts_with(s, "0") && is_dig(str_byte_at(s, 1)) {
        return "0o" + str_slice(s, 1, str_len(s));
    }
    return s;
}

fn fid_float_lit(t: str) -> str {
    var s: str = t;
    val last: i64 = str_byte_at(s, str_len(s) - 1);
    if last == 102 || last == 70 || last == 108 || last == 76 {
        s = str_slice(s, 0, str_len(s) - 1);
    }
    if str_starts_with(s, ".") {
        s = "0" + s;
    }
    var e: i64 = str_find(s, "e");
    if e < 0 {
        e = str_find(s, "E");
    }
    val dot: i64 = str_find(s, ".");
    if e >= 0 {
        if dot < 0 {
            s = str_slice(s, 0, e) + ".0" + str_slice(s, e, str_len(s));
        } else if dot == e - 1 {
            s = str_slice(s, 0, e) + "0" + str_slice(s, e, str_len(s));
        }
    } else if dot < 0 {
        s = s + ".0";
    } else if dot == str_len(s) - 1 {
        s = s + "0";
    }
    return s;
}

fn is_int_code(c: str) -> bool {
    if str_len(c) == 0 {
        return false;
    }
    if str_starts_with(c, "'") {
        return true;
    }
    var i: i64 = 0;
    if str_starts_with(c, "0x") || str_starts_with(c, "0o") || str_starts_with(c, "0X") {
        i = 2;
    }
    while i < str_len(c) {
        val d: i64 = str_byte_at(c, i);
        if !(is_dig(d) || (d >= 97 && d <= 102) || (d >= 65 && d <= 70)) {
            return false;
        }
        i += 1;
    }
    return true;
}

// --- Conversions -------------------------------------------------------------------------

/// `v` as a Fid bool.
fn truthy(st: &mut C2, v: Ex) -> Ex {
    val t: i64 = v.ty;
    if is_bool(st, t) {
        return v;
    }
    if v.repr == R_STR || v.repr == R_RAW || v.repr == R_NULL {
        return ex("(" + paren(v, P_POST) + " as i64) != 0", P_EQ, st.t_bool, R_VAL);
    }
    if v.repr == R_FILE {
        return ex(paren(v, P_POST) + ".ok", P_POST, st.t_bool, R_VAL);
    }
    if v.repr == R_REF || v.repr == R_VEC || v.repr == R_VECREF || v.repr == R_BYTES || v.repr == R_BYTESREF {
        return ex("true", P_PRIM, st.t_bool, R_VAL);
    }
    if is_flt(st, t) {
        return ex(paren(v, P_EQ + 1) + " != 0.0", P_EQ, st.t_bool, R_VAL);
    }
    return ex(paren(v, P_EQ + 1) + " != 0", P_EQ, st.t_bool, R_VAL);
}

fn falsy(st: &mut C2, v: Ex) -> Ex {
    val t: i64 = v.ty;
    if is_bool(st, t) {
        return ex("!" + paren(v, P_UNARY), P_UNARY, st.t_bool, R_VAL);
    }
    if v.repr == R_STR || v.repr == R_RAW || v.repr == R_NULL {
        return ex("(" + paren(v, P_POST) + " as i64) == 0", P_EQ, st.t_bool, R_VAL);
    }
    if v.repr == R_FILE {
        return ex("!" + paren(v, P_POST) + ".ok", P_UNARY, st.t_bool, R_VAL);
    }
    if v.repr == R_REF || v.repr == R_VEC || v.repr == R_VECREF || v.repr == R_BYTES || v.repr == R_BYTESREF {
        return ex("false", P_PRIM, st.t_bool, R_VAL);
    }
    if is_flt(st, t) {
        return ex(paren(v, P_EQ + 1) + " == 0.0", P_EQ, st.t_bool, R_VAL);
    }
    return ex(paren(v, P_EQ + 1) + " == 0", P_EQ, st.t_bool, R_VAL);
}

/// `v` converted to C type `to` held as `repr`.
fn conv(st: &mut C2, v: Ex, to: i64, repr: i64) -> Ex {
    if v.repr == R_NULL {
        if repr == R_RAW {
            val e: i64 = elem(st, to);
            val pt: str = fid_raw_pointee(st, e);
            return ex("0 as *mut " + pt, P_POST, to, R_RAW);
        }
        if repr == R_STR {
            return ex("0 as str", P_POST, to, R_STR);
        }
        if repr == R_FILE {
            use_h(st, "CFile");
            return ex("c_nofile()", P_POST, to, R_FILE);
        }
        if repr == R_VAL && is_arith(st, to) {
            return ex("0", P_PRIM, to, R_VAL);
        }
        note(st, "NULL where a Fid value is required");
        return ex("0", P_PRIM, to, repr);
    }
    if repr == R_STR {
        if v.repr == R_BYTES || v.repr == R_BYTESREF {
            use_h(st, "c_cstr");
            if v.repr == R_BYTES {
                return ex("c_cstr(&" + paren(v, P_UNARY) + ")", P_POST, to, R_STR);
            }
            return ex("c_cstr(" + v.code + ")", P_POST, to, R_STR);
        }
        return v;
    }
    if repr == R_BYTES {
        if v.repr == R_STR {
            use_h(st, "c_bytes");
            return ex("c_bytes(" + v.code + ")", P_POST, to, R_BYTES);
        }
        return v;
    }
    if repr != R_VAL {
        return v;
    }
    if !is_arith(st, to) {
        return v;
    }
    if is_bool(st, to) {
        if is_bool(st, v.ty) {
            return v;
        }
        return truthy(st, v);
    }
    if is_bool(st, v.ty) {
        return ex("if " + v.code + " { 1 } else { 0 }", P_IF, st.t_int, R_VAL);
    }
    val fb: str = fid_base(st, v.ty);
    val ft: str = fid_base(st, to);
    if fb == ft {
        return ex(v.code, v.prec, to, R_VAL);
    }
    if is_int_code(v.code) && ft != "f64" {
        return ex(v.code, v.prec, to, R_VAL);
    }
    if is_int_code(v.code) && ft == "f64" && !str_starts_with(v.code, "'") && !str_starts_with(v.code, "0x") && !str_starts_with(v.code, "0o") {
        return ex(v.code + ".0", P_PRIM, to, R_VAL);
    }
    return ex(paren(v, P_POST) + " as " + ft, P_POST, to, R_VAL);
}

/// An operand of arithmetic in type `to` (Fid computes in the operands' type).
fn arith_operand(st: &mut C2, v: Ex, to: i64) -> Ex {
    var x: Ex = v;
    if is_bool(st, x.ty) {
        x = ex("if " + x.code + " { 1 } else { 0 }", P_IF, st.t_int, R_VAL);
    }
    val fb: str = fid_base(st, x.ty);
    val ft: str = fid_base(st, to);
    if fb == ft || is_int_code(x.code) {
        return ex(x.code, x.prec, to, R_VAL);
    }
    if ft == "f64" {
        if fb == "i64" {
            // Fid widens an integer operand next to a float itself
            return x;
        }
    }
    return ex(paren(x, P_POST) + " as " + ft, P_POST, to, R_VAL);
}

// --- Expressions -------------------------------------------------------------------------

fn tx(st: &mut C2, e: i64) -> Ex {
    val k: i64 = st.nk.get(e);
    val t: i64 = st.nty.get(e);
    val text: str = st.ntext.get(e);
    if k == E_INT {
        return ex(fid_int_lit(text), P_PRIM, t, R_VAL);
    }
    if k == E_FLT {
        return ex(fid_float_lit(text), P_PRIM, t, R_VAL);
    }
    if k == E_CHR {
        return ex(fid_char_lit(text), P_PRIM, t, R_VAL);
    }
    if k == E_STR {
        return ex("\"" + fid_str_text(text) + "\"", P_PRIM, t, R_STR);
    }
    if k == E_NULL {
        return ex("0", P_PRIM, t, R_NULL);
    }
    if k == E_BOOL {
        return ex(text, P_PRIM, st.t_bool, R_VAL);
    }
    if k == E_IDENT {
        return tx_ident(st, e);
    }
    if k == E_BIN {
        return tx_bin(st, e);
    }
    if k == E_UNARY {
        return tx_unary(st, e);
    }
    if k == E_ASSIGN {
        val code: str = assign_code(st, e);
        pre_add(st, code + ";");
        val lhs: i64 = st.na.get(e);
        return tx(st, lhs);
    }
    if k == E_PREINC || k == E_PREDEC || k == E_POSTINC || k == E_POSTDEC {
        return tx_incdec(st, e);
    }
    if k == E_COND {
        return tx_ternary(st, e);
    }
    if k == E_CALL {
        return tx_call(st, e, false);
    }
    if k == E_INDEX {
        return tx_index(st, e);
    }
    if k == E_MEMBER {
        return tx_member(st, e);
    }
    if k == E_CAST {
        return tx_cast(st, e);
    }
    if k == E_SIZEOF_T || k == E_SIZEOF_E {
        return tx_sizeof(st, e);
    }
    if k == E_COMMA {
        val a: i64 = st.na.get(e);
        val sc: str = stmt_code(st, a);
        if sc != "" {
            pre_add(st, sc);
        }
        val b: i64 = st.nb.get(e);
        return tx(st, b);
    }
    if k == E_INIT {
        note(st, "an initializer list where Fid needs a value");
        return ex("0", P_PRIM, t, R_VAL);
    }
    note(st, "an expression c2fd does not translate");
    return ex("0", P_PRIM, t, R_VAL);
}

fn tx_ident(st: &mut C2, e: i64) -> Ex {
    val s: i64 = st.nsym.get(e);
    val t: i64 = st.nty.get(e);
    val text: str = st.ntext.get(e);
    if s < 0 {
        if text == "EOF" {
            use_h(st, "EOF");
            return ex("EOF", P_PRIM, st.t_int, R_VAL);
        }
        if text == "stdin" || text == "stdout" || text == "stderr" {
            return ex(text, P_PRIM, t, R_FILE);
        }
        if text == "INT_MAX" { return ex("2147483647", P_PRIM, st.t_int, R_VAL); }
        if text == "INT_MIN" { return ex("(-2147483647 - 1)", P_PRIM, st.t_int, R_VAL); }
        if text == "UINT_MAX" { return ex("4294967295", P_PRIM, st.t_uint, R_VAL); }
        if text == "LONG_MAX" || text == "LLONG_MAX" || text == "INT64_MAX" { return ex("9223372036854775807", P_PRIM, t, R_VAL); }
        if text == "CHAR_BIT" { return ex("8", P_PRIM, st.t_int, R_VAL); }
        if text == "EXIT_SUCCESS" { return ex("0", P_PRIM, st.t_int, R_VAL); }
        if text == "EXIT_FAILURE" { return ex("1", P_PRIM, st.t_int, R_VAL); }
        if text == "RAND_MAX" { return ex("2147483647", P_PRIM, st.t_int, R_VAL); }
        note(st, "'" + text + "' is not declared in this file");
        return ex(safe_name(st, text), P_PRIM, t, R_VAL);
    }
    val kind: i64 = st.sy_kind.get(s);
    val name: str = st.sy_fid.get(s);
    if kind == SK_FUNC || kind == SK_ECONST || kind == SK_MACRO {
        var r: i64 = R_VAL;
        if kind == SK_MACRO && is_charp(st, st.sy_ty.get(s)) {
            r = R_STR;
        }
        return ex(name, P_PRIM, t, r);
    }
    val r: i64 = st.sy_repr.get(s);
    if kind == SK_GLOBAL && r == R_VAL && is_unsigned(st, t) {
        // a global of an unsigned type reads as signed (see docs/reference/c2fd.md)
        val ft: str = fid_base(st, t);
        return ex("(" + name + " as " + ft + ")", P_PRIM, t, R_VAL);
    }
    return ex(name, P_PRIM, t, r);
}

/// Pointer operand of + or - on a string: the string from that offset.
fn tx_bin(st: &mut C2, e: i64) -> Ex {
    val op: str = st.ntext.get(e);
    val a: i64 = st.na.get(e);
    val b: i64 = st.nb.get(e);
    val t: i64 = st.nty.get(e);
    val ta: i64 = st.nty.get(a);
    val tb: i64 = st.nty.get(b);
    if op == "&&" || op == "||" {
        return tx_cond(st, e);
    }
    if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" {
        return tx_compare(st, e);
    }
    // sizeof(a) / sizeof(a[0]): the number of elements
    if op == "/" && st.nk.get(a) == E_SIZEOF_E && (st.nk.get(b) == E_SIZEOF_E || st.nk.get(b) == E_SIZEOF_T) {
        val arr: i64 = st.na.get(a);
        val at: i64 = st.nty.get(arr);
        if is_array(st, at) {
            val va: Ex = tx(st, arr);
            if va.repr == R_STR {
                return ex("(str_len(" + va.code + ") + 1)", P_PRIM, st.t_int, R_VAL);
            }
            return ex(paren(va, P_POST) + ".len()", P_POST, st.t_int, R_VAL);
        }
    }
    if (op == "+" || op == "-") && is_ptrish(st, ta) && is_arith(st, tb) {
        val va: Ex = tx(st, a);
        val vb: Ex = tx(st, b);
        return ptr_offset(st, va, vb, op, t);
    }
    if op == "+" && is_ptrish(st, tb) && is_arith(st, ta) {
        val va: Ex = tx(st, a);
        val vb: Ex = tx(st, b);
        return ptr_offset(st, vb, va, op, t);
    }
    if op == "-" && is_ptrish(st, ta) && is_ptrish(st, tb) {
        val cd: str = cur_pair(st, a, b, "-");
        if cd != "" {
            if str_contains(cd, " ") {
                return ex(cd, P_ADD, t, R_VAL);
            }
            return ex(cd, P_PRIM, t, R_VAL);
        }
        val va: Ex = tx(st, a);
        val vb: Ex = tx(st, b);
        if va.repr == R_STR && vb.repr == R_STR {
            note(st, "a difference of two char pointers: the length of the shorter tail is subtracted");
            return ex("(str_len(" + vb.code + ") - str_len(" + va.code + "))", P_PRIM, t, R_VAL);
        }
        st.fn_raw = true;
        note(st, "a pointer difference, in bytes divided by 8");
        return ex("((" + paren(va, P_POST) + " as i64) - (" + paren(vb, P_POST) + " as i64)) / 8", P_MUL, t, R_VAL);
    }
    val va0: Ex = tx(st, a);
    val vb0: Ex = tx(st, b);
    var va: Ex = va0;
    var vb: Ex = vb0;
    if op == "<<" || op == ">>" {
        va = arith_operand(st, va0, t);
        vb = arith_operand(st, vb0, t);
    } else {
        va = arith_operand(st, va0, t);
        vb = arith_operand(st, vb0, t);
    }
    if is_unsigned(st, t) && (op == "+" || op == "-" || op == "*" || op == "<<") {
        st.fn_wrap = true;
    }
    val p: i64 = fid_prec(op);
    return ex(paren(va, p) + " " + op + " " + paren(vb, p + 1), p, t, R_VAL);
}

fn ptr_offset(st: &mut C2, vp: Ex, vn: Ex, op: str, t: i64) -> Ex {
    if vp.repr == R_STR {
        if op == "+" {
            use_h(st, "c_skip");
            return ex("c_skip(" + vp.code + ", " + vn.code + ")", P_POST, t, R_STR);
        }
        note(st, "a char pointer moved backwards");
        return vp;
    }
    if vp.repr == R_VEC || vp.repr == R_VECREF || vp.repr == R_BYTES || vp.repr == R_BYTESREF {
        note(st, "a pointer into the middle of an array: an index would be the Fid way");
        return vp;
    }
    if vp.repr == R_CUR || vp.repr == R_PCUR {
        note(st, "a pointer into an array used where c2fd keeps no index: rewrite it with one");
        return vp;
    }
    st.fn_raw = true;
    note(st, "pointer arithmetic on a raw pointer (8-byte elements assumed)");
    return ex("((" + paren(vp, P_POST) + " as i64) " + op + " " + paren(vn, P_MUL) + " * 8) as " + fid_type(st, t, R_RAW, SK_LOCAL), P_POST, t, R_RAW);
}

// --- Emission: pointers into arrays as an array and an index ------------------------

/// A pointer into an array as Fid writes it: the array (a Vec variable or
/// a reference to one) and the index the pointer is at.
struct Cur {
    base: str,
    off: str,
    bsym: i64,
}

/// Whether `e` is a pointer c2fd can write as an array and an index: a
/// cursor, an array (or array parameter), `p + n`, `&a[i]`, `p++`.
fn cur_able(st: &mut C2, e: i64) -> bool {
    val x: i64 = strip_casts(st, e);
    if x < 0 {
        return false;
    }
    val k: i64 = st.nk.get(x);
    if k == E_IDENT {
        val s: i64 = st.nsym.get(x);
        if s < 0 {
            return false;
        }
        val sk: i64 = st.sy_kind.get(s);
        if sk != SK_LOCAL && sk != SK_PARAM {
            return false;
        }
        val r: i64 = st.sy_repr.get(s);
        return r == R_CUR || r == R_PCUR || r == R_VEC || r == R_VECREF || r == R_BYTES || r == R_BYTESREF;
    }
    if k == E_BIN {
        val op: str = st.ntext.get(x);
        val a: i64 = st.na.get(x);
        val b: i64 = st.nb.get(x);
        if (op == "+" || op == "-") && is_ptrish(st, st.nty.get(a)) && is_arith(st, st.nty.get(b)) {
            return cur_able(st, a);
        }
        if op == "+" && is_ptrish(st, st.nty.get(b)) && is_arith(st, st.nty.get(a)) {
            return cur_able(st, b);
        }
        return false;
    }
    if k == E_UNARY && st.ntext.get(x) == "&" {
        val inner: i64 = st.na.get(x);
        if st.nk.get(inner) == E_INDEX {
            return cur_able(st, st.na.get(inner));
        }
        return false;
    }
    if k == E_PREINC || k == E_PREDEC || k == E_POSTINC || k == E_POSTDEC {
        val inner: i64 = strip_casts(st, st.na.get(x));
        if st.nk.get(inner) != E_IDENT || st.nsym.get(inner) < 0 {
            return false;
        }
        val r: i64 = st.sy_repr.get(st.nsym.get(inner));
        return r == R_CUR || r == R_PCUR;
    }
    return false;
}

/// A pointer expression the cursor form must translate (a plain array
/// variable is left to the older code, which writes it the same way).
fn cur_expr(st: &mut C2, e: i64) -> bool {
    if !cur_able(st, e) {
        return false;
    }
    val x: i64 = strip_casts(st, e);
    val k: i64 = st.nk.get(x);
    if k == E_IDENT {
        val r: i64 = st.sy_repr.get(st.nsym.get(x));
        return r == R_CUR || r == R_PCUR;
    }
    return k != E_UNARY;
}

/// The variable holding the index of cursor `s`.
fn cur_off_var(st: &mut C2, s: i64) -> str {
    if st.sy_repr.get(s) == R_PCUR {
        return st.sy_fid.get(s) + "_at";
    }
    return st.sy_fid.get(s);
}

/// The index `a op v` (a is an index code, v an integer value).
fn off_join(a: str, op: str, v: Ex) -> str {
    if v.code == "0" {
        return a;
    }
    if a == "0" {
        if op == "+" {
            return paren(v, P_ADD);
        }
        return "0 - " + paren(v, P_ADD + 1);
    }
    return a + " " + op + " " + paren(v, P_ADD + 1);
}

/// An index code as the right operand of `-`.
fn off_paren(o: str) -> str {
    if str_contains(o, " ") {
        return "(" + o + ")";
    }
    return o;
}

/// The array and index of the pointer expression `e` (cur_able). A `p++`
/// in it moves the cursor in a hoisted statement.
fn cur_of(st: &mut C2, e: i64) -> Cur {
    val x: i64 = strip_casts(st, e);
    val k: i64 = st.nk.get(x);
    if k == E_IDENT {
        val s: i64 = st.nsym.get(x);
        val r: i64 = st.sy_repr.get(s);
        val name: str = st.sy_fid.get(s);
        if r == R_CUR {
            val b: i64 = st.sy_cbase.get(s);
            return Cur { base: st.sy_fid.get(b), off: name, bsym: b };
        }
        if r == R_PCUR {
            return Cur { base: name, off: name + "_at", bsym: s };
        }
        return Cur { base: name, off: "0", bsym: s };
    }
    if k == E_BIN {
        val op: str = st.ntext.get(x);
        val a: i64 = st.na.get(x);
        val b: i64 = st.nb.get(x);
        if is_ptrish(st, st.nty.get(a)) {
            val c: Cur = cur_of(st, a);
            val v0: Ex = tx(st, b);
            val v: Ex = index_code(st, v0);
            return Cur { base: c.base, off: off_join(c.off, op, v), bsym: c.bsym };
        }
        val c: Cur = cur_of(st, b);
        val v0: Ex = tx(st, a);
        val v: Ex = index_code(st, v0);
        return Cur { base: c.base, off: off_join(c.off, "+", v), bsym: c.bsym };
    }
    if k == E_UNARY {
        // &a[i]
        val inner: i64 = st.na.get(x);
        val c: Cur = cur_of(st, st.na.get(inner));
        val v0: Ex = tx(st, st.nb.get(inner));
        val v: Ex = index_code(st, v0);
        return Cur { base: c.base, off: off_join(c.off, "+", v), bsym: c.bsym };
    }
    // p++, ++p, p--, --p on a cursor
    val inner: i64 = strip_casts(st, st.na.get(x));
    val s: i64 = st.nsym.get(inner);
    val c: Cur = cur_of(st, inner);
    val ov: str = cur_off_var(st, s);
    var step: str = " += 1;";
    if k == E_PREDEC || k == E_POSTDEC {
        step = " -= 1;";
    }
    if k == E_PREINC || k == E_PREDEC {
        pre_add(st, ov + step);
        return c;
    }
    val tmp: str = new_tmp(st);
    pre_add(st, "val " + tmp + ": i64 = " + ov + ";");
    pre_add(st, ov + step);
    return Cur { base: c.base, off: tmp, bsym: c.bsym };
}

/// The argument(s) for a cursor parameter `p`: its array (a reference), and
/// the index when the function takes one.
fn cur_arg_code(st: &mut C2, a: i64, p: i64) -> str {
    val pe: i64 = elem(st, st.sy_ty.get(p));
    if !cur_able(st, a) {
        note(st, "a pointer argument where an array and an index are expected");
        val v: Ex = tx(st, a);
        if st.sy_cext.get(p) {
            return v.code + ", 0";
        }
        return v.code;
    }
    val c: Cur = cur_of(st, a);
    val br: i64 = st.sy_repr.get(c.bsym);
    var code: str = c.base;
    if br != R_VECREF && br != R_PCUR && br != R_BYTESREF {
        if is_const(st, pe) {
            code = "&" + c.base;
        } else {
            code = "&mut " + c.base;
        }
    }
    if st.sy_cext.get(p) {
        return code + ", " + c.off;
    }
    if c.off != "0" {
        note(st, "a pointer into the middle of an array passed where the start is expected");
    }
    return code;
}

/// A comparison or difference of two pointers into one array: of their
/// indexes. Element 0 is the code ("" when not both are cursor forms).
fn cur_pair(st: &mut C2, a: i64, b: i64, op: str) -> str {
    if !(cur_able(st, a) && cur_able(st, b)) || !(cur_expr(st, a) || cur_expr(st, b)) {
        return "";
    }
    val ca: Cur = cur_of(st, a);
    val cb: Cur = cur_of(st, b);
    if ca.base != cb.base {
        note(st, "pointers into two different arrays (" + ca.base + ", " + cb.base + "): their indexes are used");
    }
    if op == "-" {
        if cb.off == "0" {
            return ca.off;
        }
        return ca.off + " - " + off_paren(cb.off);
    }
    return ca.off + " " + op + " " + cb.off;
}

fn tx_compare(st: &mut C2, e: i64) -> Ex {
    val op: str = st.ntext.get(e);
    return tx_compare_op(st, e, op);
}

fn inverse_op(op: str) -> str {
    if op == "==" { return "!="; }
    if op == "!=" { return "=="; }
    if op == "<" { return ">="; }
    if op == ">=" { return "<"; }
    if op == ">" { return "<="; }
    return ">";
}

/// The negation of C condition `e`, written without a `!(...)` when it can.
fn neg_cond(st: &mut C2, e: i64) -> Ex {
    val k: i64 = st.nk.get(e);
    val op: str = st.ntext.get(e);
    if k == E_UNARY && op == "!" {
        return tx_cond(st, st.na.get(e));
    }
    if k == E_BIN && (op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=") {
        return tx_compare_op(st, e, inverse_op(op));
    }
    if k == E_BIN && (op == "&&" || op == "||") {
        val c: Ex = tx_cond(st, e);
        return ex("!" + paren(c, P_UNARY), P_UNARY, st.t_bool, R_VAL);
    }
    val t: i64 = st.nty.get(e);
    if is_bool(st, t) {
        val c: Ex = tx_cond(st, e);
        return ex("!" + paren(c, P_UNARY), P_UNARY, st.t_bool, R_VAL);
    }
    val v: Ex = tx(st, e);
    return falsy(st, v);
}

fn tx_compare_op(st: &mut C2, e: i64, op: str) -> Ex {
    val a: i64 = st.na.get(e);
    val b: i64 = st.nb.get(e);
    val ta: i64 = st.nty.get(a);
    val tb: i64 = st.nty.get(b);
    val p: i64 = fid_prec(op);
    val pa: bool = is_ptrish(st, ta) || st.nk.get(a) == E_NULL;
    val pb: bool = is_ptrish(st, tb) || st.nk.get(b) == E_NULL;
    if pa && pb && st.nk.get(a) != E_NULL && st.nk.get(b) != E_NULL {
        val cc: str = cur_pair(st, a, b, op);
        if cc != "" {
            return ex(cc, p, st.t_bool, R_VAL);
        }
    }
    if (pa || pb) && (op == "==" || op == "!=") {
        val va: Ex = tx(st, a);
        val vb: Ex = tx(st, b);
        var vp: Ex = va;
        var other: Ex = vb;
        if va.repr == R_NULL || is_null_lit(st, a) {
            vp = vb;
            other = va;
        }
        if other.repr == R_NULL || is_null_lit(st, a) || is_null_lit(st, b) {
            if op == "==" {
                return falsy(st, vp);
            }
            return truthy(st, vp);
        }
        if va.repr == R_STR && vb.repr == R_STR {
            note(st, "C compares the two pointers, not the strings");
        }
        if va.repr == R_RAW || va.repr == R_STR {
            return ex("(" + paren(va, P_POST) + " as i64) " + op + " (" + paren(vb, P_POST) + " as i64)", p, st.t_bool, R_VAL);
        }
        return ex(paren(va, p + 1) + " " + op + " " + paren(vb, p + 1), p, st.t_bool, R_VAL);
    }
    val va0: Ex = tx(st, a);
    val vb0: Ex = tx(st, b);
    if is_bool(st, ta) && is_bool(st, tb) {
        return ex(paren(va0, p + 1) + " " + op + " " + paren(vb0, p + 1), p, st.t_bool, R_VAL);
    }
    if pa || pb {
        if va0.repr == R_RAW || vb0.repr == R_RAW {
            return ex("(" + paren(va0, P_POST) + " as i64) " + op + " (" + paren(vb0, P_POST) + " as i64)", p, st.t_bool, R_VAL);
        }
        note(st, "a comparison of pointers");
        return ex(paren(va0, p + 1) + " " + op + " " + paren(vb0, p + 1), p, st.t_bool, R_VAL);
    }
    val common: i64 = usual_arith(st, ta, tb);
    val va: Ex = arith_operand(st, va0, common);
    val vb: Ex = arith_operand(st, vb0, common);
    return ex(paren(va, p + 1) + " " + op + " " + paren(vb, p + 1), p, st.t_bool, R_VAL);
}

/// A C expression as a Fid bool.
fn tx_cond(st: &mut C2, e: i64) -> Ex {
    val k: i64 = st.nk.get(e);
    val op: str = st.ntext.get(e);
    if k == E_BIN && (op == "&&" || op == "||") {
        val a: i64 = st.na.get(e);
        val b: i64 = st.nb.get(e);
        val ca: Ex = tx_cond(st, a);
        val mark: i64 = st.pre.len();
        val cb: Ex = tx_cond(st, b);
        val p: i64 = fid_prec(op);
        if st.pre.len() > mark {
            // the right side has statements of its own: run them only when C does
            val moved: Vec<str> = pre_take(st, mark);
            val tmp: str = new_tmp(st);
            if op == "&&" {
                pre_add(st, "var " + tmp + ": bool = false;");
                pre_add(st, "if " + ca.code + " {");
            } else {
                pre_add(st, "var " + tmp + ": bool = true;");
                pre_add(st, "if " + falsy_code(st, ca) + " {");
            }
            var i: i64 = 0;
            while i < moved.len() {
                pre_add(st, "    " + moved.get(i));
                i += 1;
            }
            pre_add(st, "    " + tmp + " = " + cb.code + ";");
            pre_add(st, "}");
            return ex(tmp, P_PRIM, st.t_bool, R_VAL);
        }
        // parentheses where C programmers expect them: && inside ||
        var sa: str = paren(ca, p);
        var sb: str = paren(cb, p + 1);
        if ca.prec == P_AND && op == "||" { sa = "(" + ca.code + ")"; }
        if cb.prec == P_AND && op == "||" { sb = "(" + cb.code + ")"; }
        if ca.prec == P_OR && op == "&&" { sa = "(" + ca.code + ")"; }
        return ex(sa + " " + op + " " + sb, p, st.t_bool, R_VAL);
    }
    if k == E_UNARY && op == "!" {
        val a: i64 = st.na.get(e);
        val ak: i64 = st.nk.get(a);
        val at: i64 = st.nty.get(a);
        if is_bool(st, at) {
            val ca: Ex = tx_cond(st, a);
            return ex("!" + paren(ca, P_UNARY), P_UNARY, st.t_bool, R_VAL);
        }
        val va: Ex = tx(st, a);
        return falsy(st, va);
    }
    val v: Ex = tx(st, e);
    return truthy(st, v);
}

fn falsy_code(st: &mut C2, c: Ex) -> str {
    return "!" + paren(c, P_UNARY);
}

fn tx_unary(st: &mut C2, e: i64) -> Ex {
    val op: str = st.ntext.get(e);
    val a: i64 = st.na.get(e);
    val t: i64 = st.nty.get(e);
    if op == "!" {
        return tx_cond(st, e);
    }
    if op == "&" {
        return tx_addr(st, a, false);
    }
    if op == "*" && cur_expr(st, a) {
        // *p, *(p + i), *p++ on a pointer into an array: an element
        val c: Cur = cur_of(st, a);
        var r: i64 = repr_of_type(st, t);
        if is_charlike(st, t) {
            r = R_VAL;
        }
        return ex(c.base + "[" + c.off + "]", P_POST, t, r);
    }
    val va: Ex = tx(st, a);
    if op == "+" {
        return va;
    }
    if op == "-" {
        val v: Ex = arith_operand(st, va, t);
        if is_unsigned(st, t) {
            st.fn_wrap = true;
            return ex("0 - " + paren(v, P_ADD + 1), P_ADD, t, R_VAL);
        }
        if is_int_code(v.code) && !str_starts_with(v.code, "'") {
            return ex("-" + v.code, P_UNARY, t, R_VAL);
        }
        return ex("-" + paren(v, P_UNARY), P_UNARY, t, R_VAL);
    }
    if op == "~" {
        val v: Ex = arith_operand(st, va, t);
        return ex("~" + paren(v, P_UNARY), P_UNARY, t, R_VAL);
    }
    if op == "*" {
        return deref(st, va, t);
    }
    note(st, "the operator " + op);
    return va;
}

fn deref(st: &mut C2, va: Ex, t: i64) -> Ex {
    val r: i64 = repr_of_type(st, t);
    if va.repr == R_STR {
        use_h(st, "c_char");
        return ex("c_char(" + va.code + ", 0)", P_POST, st.t_char, R_VAL);
    }
    if va.repr == R_VEC || va.repr == R_VECREF || va.repr == R_BYTES || va.repr == R_BYTESREF {
        return ex(paren(va, P_POST) + "[0]", P_POST, t, r);
    }
    if va.repr == R_REF {
        return ex("*" + paren(va, P_UNARY), P_UNARY, t, r);
    }
    if va.repr == R_FILE {
        note(st, "a FILE dereferenced");
        return va;
    }
    st.fn_raw = true;
    return ex("*" + paren(va, P_UNARY), P_UNARY, t, r);
}

/// `&x` where no call or declaration says what is wanted: a mutable reference.
fn tx_addr(st: &mut C2, a: i64, imm: bool) -> Ex {
    val k: i64 = st.nk.get(a);
    val t: i64 = st.nty.get(a);
    val pt: i64 = ty_ptr(st, t);
    if k == E_UNARY && st.ntext.get(a) == "*" {
        return tx(st, st.na.get(a));
    }
    val v: Ex = tx(st, a);
    if is_func(st, t) {
        return v;
    }
    if imm {
        return ex("&" + paren(v, P_UNARY), P_UNARY, pt, R_REF);
    }
    return ex("&mut " + paren(v, P_UNARY), P_UNARY, pt, R_REF);
}

fn tx_index(st: &mut C2, e: i64) -> Ex {
    val b: i64 = st.na.get(e);
    val i: i64 = st.nb.get(e);
    val t: i64 = st.nty.get(e);
    if cur_expr(st, b) {
        // p[i] on a pointer into an array: the array at the pointer's index + i
        val c: Cur = cur_of(st, b);
        val ci0: Ex = tx(st, i);
        val ci: Ex = index_code(st, ci0);
        var cr: i64 = repr_of_type(st, t);
        if is_charlike(st, t) {
            cr = R_VAL;
        }
        return ex(c.base + "[" + off_join(c.off, "+", ci) + "]", P_POST, t, cr);
    }
    val vb: Ex = tx(st, b);
    val vi0: Ex = tx(st, i);
    val vi: Ex = index_code(st, vi0);
    var r: i64 = repr_of_type(st, t);
    if is_charlike(st, t) {
        r = R_VAL;
    }
    if vb.repr == R_STR {
        use_h(st, "c_char");
        return ex("c_char(" + vb.code + ", " + vi.code + ")", P_POST, st.t_char, R_VAL);
    }
    if vb.repr == R_VEC || vb.repr == R_VECREF || vb.repr == R_BYTES || vb.repr == R_BYTESREF || (vb.repr == R_VAL && is_array(st, vb.ty)) {
        if is_global_ident(st, b) {
            return ex(vb.code + ".get(" + vi.code + ")", P_POST, t, r);
        }
        return ex(paren(vb, P_POST) + "[" + vi.code + "]", P_POST, t, r);
    }
    if vb.repr == R_REF {
        if vi.code == "0" {
            return ex("*" + paren(vb, P_UNARY), P_UNARY, t, r);
        }
    }
    st.fn_raw = true;
    note(st, "indexing a raw pointer (8-byte elements assumed)");
    return ex("*((" + paren(vb, P_POST) + " as i64 + " + paren(vi, P_MUL) + " * 8) as *mut " + fid_raw_pointee(st, t) + ")", P_UNARY, t, r);
}

fn index_code(st: &mut C2, v: Ex) -> Ex {
    if is_int_code(v.code) {
        return v;
    }
    val fb: str = fid_base(st, v.ty);
    if fb == "i64" {
        return v;
    }
    if is_bool(st, v.ty) {
        return ex("if " + v.code + " { 1 } else { 0 }", P_IF, st.t_int, R_VAL);
    }
    return ex(paren(v, P_POST) + " as i64", P_POST, st.t_int, R_VAL);
}

fn is_global_ident(st: &mut C2, e: i64) -> bool {
    if st.nk.get(e) != E_IDENT {
        return false;
    }
    val s: i64 = st.nsym.get(e);
    return s >= 0 && st.sy_kind.get(s) == SK_GLOBAL;
}

fn tx_member(st: &mut C2, e: i64) -> Ex {
    val b: i64 = st.na.get(e);
    val f: i64 = st.nsym.get(e);
    val t: i64 = st.nty.get(e);
    val fnode: i64 = st.nb.get(e);
    val fname: str = safe_name(st, st.ntext.get(fnode));
    var r: i64 = repr_of_type(st, t);
    if f >= 0 {
        r = st.sy_repr.get(f);
    } else {
        note(st, "no field '" + st.ntext.get(fnode) + "' is known here");
    }
    val vb: Ex = tx(st, b);
    if st.ntext.get(e) == "->" {
        if vb.repr == R_RAW {
            st.fn_raw = true;
            return ex("(*" + paren(vb, P_UNARY) + ")." + fname, P_POST, t, r);
        }
        if vb.repr == R_VEC || vb.repr == R_VECREF {
            return ex(paren(vb, P_POST) + "[0]." + fname, P_POST, t, r);
        }
        return ex(paren(vb, P_POST) + "." + fname, P_POST, t, r);
    }
    return ex(paren(vb, P_POST) + "." + fname, P_POST, t, r);
}

fn tx_cast(st: &mut C2, e: i64) -> Ex {
    val a: i64 = st.na.get(e);
    val t: i64 = st.nty.get(e);
    if st.ntext.get(e) == "{}" {
        note(st, "a compound literal");
        return ex("0", P_PRIM, t, R_VAL);
    }
    val v: Ex = tx(st, a);
    if t >= 0 && st.yk.get(t) == Y_VOID {
        return v;
    }
    if is_ptrish(st, t) {
        // pointer casts keep what the value is
        if v.repr == R_STR || v.repr == R_BYTES || v.repr == R_BYTESREF {
            if is_charp(st, t) || is_ptr_to_void(st, t) {
                return ex(v.code, v.prec, t, v.repr);
            }
        }
        if v.repr == R_NULL {
            return v;
        }
        if is_arith(st, v.ty) {
            st.fn_raw = true;
            return ex(paren(v, P_POST) + " as " + fid_type(st, t, R_RAW, SK_LOCAL), P_POST, t, R_RAW);
        }
        if v.repr == R_RAW && is_ptr(st, t) {
            val rt: str = fid_type(st, t, R_RAW, SK_LOCAL);
            return ex(paren(v, P_POST) + " as " + rt, P_POST, t, R_RAW);
        }
        return ex(v.code, v.prec, t, v.repr);
    }
    if is_arith(st, t) {
        if v.repr == R_RAW || v.repr == R_STR {
            return ex(paren(v, P_POST) + " as " + fid_base(st, t), P_POST, t, R_VAL);
        }
        if is_bool(st, t) {
            return truthy(st, v);
        }
        if is_bool(st, v.ty) {
            return conv(st, v, t, R_VAL);
        }
        val fb: str = fid_base(st, v.ty);
        val ft: str = fid_base(st, t);
        if fb == ft {
            return ex(v.code, v.prec, t, R_VAL);
        }
        return ex(paren(v, P_POST) + " as " + ft, P_POST, t, R_VAL);
    }
    return ex(v.code, v.prec, t, v.repr);
}

fn is_ptr_to_void(st: &mut C2, t: i64) -> bool {
    if !is_ptr(st, t) {
        return false;
    }
    val e: i64 = elem(st, t);
    return e >= 0 && st.yk.get(e) == Y_VOID;
}

/// sizeof: the C sizes of an LP64 target; a struct's is Fid's layout.
fn c_size_of(st: &mut C2, t: i64) -> str {
    if t < 0 {
        return "8";
    }
    val k: i64 = st.yk.get(t);
    if k == Y_INT {
        val r: i64 = int_rank(st.yname.get(t));
        if r == 1 { return "1"; }
        if r == 2 { return "2"; }
        if r == 3 { return "4"; }
        return "8";
    }
    if k == Y_BOOL { return "1"; }
    if k == Y_FLT { return "8"; }
    if k == Y_PTR { return "8"; }
    if k == Y_STRUCT {
        return "comptime struct_size(" + struct_fid(st, st.yelem.get(t)) + ")";
    }
    if k == Y_ARRAY {
        val e: i64 = elem(st, t);
        val es: str = c_size_of(st, e);
        val ln: i64 = st.ylen.get(t);
        if ln >= 0 {
            val lv: Ex = tx(st, ln);
            return paren(lv, P_MUL) + " * " + es;
        }
        return es;
    }
    return "8";
}

fn tx_sizeof(st: &mut C2, e: i64) -> Ex {
    var t: i64 = st.nd.get(e);
    if st.nk.get(e) == E_SIZEOF_E {
        val a: i64 = st.na.get(e);
        t = st.nty.get(a);
        if is_array(st, t) && st.ylen.get(t) < 0 {
            val v: Ex = tx(st, a);
            val es: str = c_size_of(st, elem(st, t));
            if v.repr == R_STR {
                return ex("(str_len(" + v.code + ") + 1) * " + es, P_MUL, st.t_int, R_VAL);
            }
            return ex(paren(v, P_POST) + ".len() * " + es, P_MUL, st.t_int, R_VAL);
        }
    }
    val code: str = c_size_of(st, t);
    if str_starts_with(code, "comptime") {
        return ex(code, P_UNARY, st.t_int, R_VAL);
    }
    if is_int_code(code) {
        return ex(code, P_PRIM, st.nty.get(e), R_VAL);
    }
    return ex(code, P_MUL, st.nty.get(e), R_VAL);
}

fn tx_ternary(st: &mut C2, e: i64) -> Ex {
    val c: i64 = st.na.get(e);
    val a: i64 = st.nb.get(e);
    val b: i64 = st.nc.get(e);
    val t: i64 = st.nty.get(e);
    val cc: Ex = tx_cond(st, c);
    val m1: i64 = st.pre.len();
    val va0: Ex = tx(st, a);
    val pa: Vec<str> = pre_take(st, m1);
    val vb0: Ex = tx(st, b);
    val pb: Vec<str> = pre_take(st, m1);
    var r: i64 = va0.repr;
    if r == R_NULL {
        r = vb0.repr;
    }
    if r == R_NULL {
        r = R_RAW;
    }
    var rt: i64 = t;
    if !is_arith(st, t) && va0.repr == R_NULL {
        rt = vb0.ty;
    }
    val va: Ex = conv(st, va0, rt, r);
    val vb: Ex = conv(st, vb0, rt, r);
    if pa.len() == 0 && pb.len() == 0 {
        return ex("if " + cc.code + " { " + va.code + " } else { " + vb.code + " }", P_IF, rt, r);
    }
    val tmp: str = new_tmp(st);
    val ft: str = fid_type(st, rt, r, SK_LOCAL);
    val z: str = zero_value(st, rt, r);
    pre_add(st, "var " + tmp + ": " + ft + " = " + z + ";");
    pre_add(st, "if " + cc.code + " {");
    var i: i64 = 0;
    while i < pa.len() {
        pre_add(st, "    " + pa.get(i));
        i += 1;
    }
    pre_add(st, "    " + tmp + " = " + va.code + ";");
    pre_add(st, "} else {");
    i = 0;
    while i < pb.len() {
        pre_add(st, "    " + pb.get(i));
        i += 1;
    }
    pre_add(st, "    " + tmp + " = " + vb.code + ";");
    pre_add(st, "}");
    return ex(tmp, P_PRIM, rt, r);
}

// --- Places (the left side of an assignment) ----------------------------------------------

struct Place {
    // 1: plain (`x = v` works), 2: .set(i, v) on a Vec, 3: cannot be written
    kind: i64,
    code: str,
    base: str,
    index: str,
    ty: i64,
    repr: i64,
    // a statement that must follow the store (a row written back)
    after: str,
}

fn tx_place(st: &mut C2, e: i64) -> Place {
    val k: i64 = st.nk.get(e);
    val t: i64 = st.nty.get(e);
    if k == E_IDENT {
        val s: i64 = st.nsym.get(e);
        var r: i64 = R_VAL;
        var name: str = safe_name(st, st.ntext.get(e));
        if s >= 0 {
            r = st.sy_repr.get(s);
            name = st.sy_fid.get(s);
        }
        return Place { kind: 1, code: name, base: "", index: "", ty: t, repr: r, after: "" };
    }
    if (k == E_INDEX && cur_expr(st, st.na.get(e))) || (k == E_UNARY && st.ntext.get(e) == "*" && cur_expr(st, st.na.get(e))) {
        // p[i] = v, *p = v, *p++ = v on a pointer into an array
        val c: Cur = cur_of(st, st.na.get(e));
        var at: str = c.off;
        if k == E_INDEX {
            val ci0: Ex = tx(st, st.nb.get(e));
            val ci: Ex = index_code(st, ci0);
            at = off_join(c.off, "+", ci);
        }
        var cr: i64 = repr_of_type(st, t);
        if is_charlike(st, t) {
            cr = R_VAL;
        }
        return Place { kind: 1, code: c.base + "[" + at + "]", base: c.base, index: at, ty: t, repr: cr, after: "" };
    }
    if k == E_INDEX && st.nk.get(st.na.get(e)) == E_INDEX && is_global_ident(st, st.na.get(st.na.get(e))) {
        // g[i][j] = v on a global: the row is a copy, written back after
        val row: i64 = st.na.get(e);
        val g: Ex = tx(st, st.na.get(row));
        val gi0: Ex = tx(st, st.nb.get(row));
        val gi: Ex = index_code(st, gi0);
        val vj0: Ex = tx(st, st.nb.get(e));
        val vj: Ex = index_code(st, vj0);
        val tmp: str = new_tmp(st);
        val rt: str = fid_val_type(st, st.nty.get(row));
        pre_add(st, "var " + tmp + ": " + rt + " = " + g.code + ".get(" + gi.code + ");");
        var r: i64 = repr_of_type(st, t);
        if is_charlike(st, t) {
            r = R_VAL;
        }
        return Place { kind: 1, code: tmp + "[" + vj.code + "]", base: tmp, index: vj.code, ty: t, repr: r, after: g.code + ".set(" + gi.code + ", " + tmp + ")" };
    }
    if k == E_INDEX {
        val b: i64 = st.na.get(e);
        val i: i64 = st.nb.get(e);
        val vi0: Ex = tx(st, i);
        val vi: Ex = index_code(st, vi0);
        val vb: Ex = tx(st, b);
        var r: i64 = repr_of_type(st, t);
        if is_charlike(st, t) {
            r = R_VAL;
        }
        if vb.repr == R_STR {
            note(st, "a write into a string, which Fid strings do not allow (make it a char array)");
            return Place { kind: 3, code: vb.code + "[" + vi.code + "]", base: vb.code, index: vi.code, ty: t, repr: r, after: "" };
        }
        if vb.repr == R_VEC || vb.repr == R_VECREF || vb.repr == R_BYTES || vb.repr == R_BYTESREF || is_array(st, vb.ty) {
            val bk: i64 = st.nk.get(b);
            if bk == E_IDENT && !is_global_ident(st, b) {
                return Place { kind: 1, code: vb.code + "[" + vi.code + "]", base: vb.code, index: vi.code, ty: t, repr: r, after: "" };
            }
            return Place { kind: 2, code: paren(vb, P_POST) + "[" + vi.code + "]", base: paren(vb, P_POST), index: vi.code, ty: t, repr: r, after: "" };
        }
        st.fn_raw = true;
        note(st, "a write through an indexed raw pointer (8-byte elements assumed)");
        val code: str = "*((" + paren(vb, P_POST) + " as i64 + " + paren(vi, P_MUL) + " * 8) as *mut " + fid_raw_pointee(st, t) + ")";
        return Place { kind: 1, code: code, base: "", index: "", ty: t, repr: r, after: "" };
    }
    if k == E_MEMBER {
        val v: Ex = tx_member(st, e);
        return Place { kind: 1, code: v.code, base: "", index: "", ty: t, repr: v.repr, after: "" };
    }
    if k == E_UNARY && st.ntext.get(e) == "*" {
        val a: i64 = st.na.get(e);
        val va: Ex = tx(st, a);
        val r: i64 = repr_of_type(st, t);
        if va.repr == R_STR {
            note(st, "a write through a char pointer that is a Fid str");
            return Place { kind: 3, code: va.code, base: "", index: "", ty: t, repr: r, after: "" };
        }
        if va.repr == R_VEC || va.repr == R_VECREF || va.repr == R_BYTES || va.repr == R_BYTESREF {
            return Place { kind: 1, code: paren(va, P_POST) + "[0]", base: "", index: "", ty: t, repr: r, after: "" };
        }
        if va.repr != R_REF {
            st.fn_raw = true;
        }
        return Place { kind: 1, code: "*" + paren(va, P_UNARY), base: "", index: "", ty: t, repr: r, after: "" };
    }
    if k == E_CAST {
        return tx_place(st, st.na.get(e));
    }
    note(st, "an assignment to an expression c2fd cannot write");
    val v: Ex = tx(st, e);
    return Place { kind: 3, code: v.code, base: "", index: "", ty: t, repr: v.repr, after: "" };
}

fn place_read(p: Place) -> str {
    if p.kind == 2 {
        return p.base + "[" + p.index + "]";
    }
    return p.code;
}

/// The statement `place = value`.
fn place_store(st: &mut C2, p: Place, value: str) -> str {
    if p.after != "" {
        val q: Place = Place { kind: p.kind, code: p.code, base: p.base, index: p.index, ty: p.ty, repr: p.repr, after: "" };
        return place_store(st, q, value) + ";
" + p.after;
    }
    if p.kind == 2 {
        return p.base + ".set(" + p.index + ", " + value + ")";
    }
    if p.kind == 3 {
        return "// " + p.code + " = " + value;
    }
    return p.code + " = " + value;
}

/// The statement code of an assignment expression.
fn assign_code(st: &mut C2, e: i64) -> str {
    val op: str = st.ntext.get(e);
    val lhs: i64 = st.na.get(e);
    val rhs: i64 = st.nb.get(e);
    val lt: i64 = st.nty.get(lhs);
    val lx: i64 = strip_casts(st, lhs);
    if st.nk.get(lx) == E_IDENT && st.nsym.get(lx) >= 0 && (st.sy_repr.get(st.nsym.get(lx)) == R_CUR || st.sy_repr.get(st.nsym.get(lx)) == R_PCUR) {
        // a cursor set or moved: its index
        val ov: str = cur_off_var(st, st.nsym.get(lx));
        if op == "=" {
            if cur_able(st, rhs) {
                val c: Cur = cur_of(st, rhs);
                return ov + " = " + c.off;
            }
            note(st, "a pointer into an array set to something else");
            return "// " + ov + " = ...";
        }
        val v0: Ex = tx(st, rhs);
        val v: Ex = index_code(st, v0);
        return ov + " " + op + " " + v.code;
    }
    if op == "=" && alloc_kind(st, rhs) > 0 {
        val p: Place = tx_place(st, lhs);
        val ac: str = alloc_code(st, lt, p.repr, rhs, p.code);
        if str_starts_with(ac, "\n") {
            return str_slice(ac, 1, str_len(ac));
        }
        return place_store(st, p, ac);
    }
    val p: Place = tx_place(st, lhs);
    val v0: Ex = tx(st, rhs);
    if op == "=" {
        val v: Ex = conv(st, v0, lt, p.repr);
        return place_store(st, p, v.code);
    }
    val bop: str = str_slice(op, 0, str_len(op) - 1);
    if p.repr == R_STR && (bop == "+" || bop == "-") {
        if bop == "+" {
            use_h(st, "c_skip");
            return place_store(st, p, "c_skip(" + p.code + ", " + v0.code + ")");
        }
        note(st, "a char pointer moved backwards");
        return "// " + p.code + " " + op + " " + v0.code;
    }
    if is_ptrish(st, lt) && (p.repr == R_VEC || p.repr == R_VECREF || p.repr == R_BYTES || p.repr == R_BYTESREF || p.repr == R_REF) {
        note(st, "a pointer moved along an array: rewrite it with an index");
        return "// " + p.code + " " + op + " " + v0.code;
    }
    if p.repr == R_RAW {
        st.fn_raw = true;
        note(st, "pointer arithmetic on a raw pointer (8-byte elements assumed)");
        val pt: str = fid_type(st, lt, R_RAW, SK_LOCAL);
        return place_store(st, p, "((" + p.code + " as i64) " + bop + " " + paren(v0, P_MUL) + " * 8) as " + pt);
    }
    var v: Ex = arith_operand(st, v0, lt);
    if is_bool(st, lt) {
        v = conv(st, v0, st.t_int, R_VAL);
    }
    if is_unsigned(st, lt) && (bop == "+" || bop == "-" || bop == "*" || bop == "<<") {
        st.fn_wrap = true;
    }
    if is_flt(st, v0.ty) && !is_flt(st, lt) {
        // C computes in double and converts back
        val fb: str = fid_base(st, lt);
        return place_store(st, p, "(" + place_read(p) + " as f64 " + bop + " " + paren(v0, fid_prec(bop) + 1) + ") as " + fb);
    }
    if p.kind == 2 || p.kind == 3 || p.after != "" {
        return place_store(st, p, place_read(p) + " " + bop + " " + paren(v, fid_prec(bop) + 1));
    }
    return p.code + " " + op + " " + v.code;
}

/// `++`/`--` as a statement.
fn incdec_code(st: &mut C2, e: i64) -> str {
    val k: i64 = st.nk.get(e);
    val a: i64 = st.na.get(e);
    val inc: bool = k == E_PREINC || k == E_POSTINC;
    val ax: i64 = strip_casts(st, a);
    if st.nk.get(ax) == E_IDENT && st.nsym.get(ax) >= 0 && (st.sy_repr.get(st.nsym.get(ax)) == R_CUR || st.sy_repr.get(st.nsym.get(ax)) == R_PCUR) {
        // a cursor moved one element
        val ov: str = cur_off_var(st, st.nsym.get(ax));
        if inc {
            return ov + " += 1";
        }
        return ov + " -= 1";
    }
    val p: Place = tx_place(st, a);
    if p.repr == R_STR {
        if inc {
            use_h(st, "c_skip");
            return place_store(st, p, "c_skip(" + p.code + ", 1)");
        }
        note(st, "a char pointer moved backwards");
        return "// " + p.code + "--";
    }
    if is_ptrish(st, p.ty) && (p.repr == R_VEC || p.repr == R_VECREF || p.repr == R_BYTES || p.repr == R_BYTESREF || p.repr == R_REF) {
        note(st, "a pointer moved along an array: rewrite it with an index");
        if inc {
            return "// " + p.code + "++";
        }
        return "// " + p.code + "--";
    }
    if p.repr == R_RAW {
        st.fn_raw = true;
        note(st, "pointer arithmetic on a raw pointer (8-byte elements assumed)");
        val pt: str = fid_type(st, p.ty, R_RAW, SK_LOCAL);
        var op: str = "+";
        if !inc { op = "-"; }
        return place_store(st, p, "((" + p.code + " as i64) " + op + " 8) as " + pt);
    }
    if is_unsigned(st, p.ty) {
        st.fn_wrap = true;
    }
    var op: str = " += 1";
    if !inc {
        op = " -= 1";
    }
    if p.kind == 2 || p.after != "" {
        var bop: str = " + 1";
        if !inc { bop = " - 1"; }
        return place_store(st, p, place_read(p) + bop);
    }
    return p.code + op;
}

fn tx_incdec(st: &mut C2, e: i64) -> Ex {
    val k: i64 = st.nk.get(e);
    val a: i64 = st.na.get(e);
    val t: i64 = st.nty.get(e);
    if k == E_PREINC || k == E_PREDEC {
        val code: str = incdec_code(st, e);
        pre_add(st, code + ";");
        return tx(st, a);
    }
    val v: Ex = tx(st, a);
    val tmp: str = new_tmp(st);
    val ft: str = fid_type(st, t, v.repr, SK_LOCAL);
    pre_add(st, "val " + tmp + ": " + ft + " = " + v.code + ";");
    val code: str = incdec_code(st, e);
    pre_add(st, code + ";");
    return ex(tmp, P_PRIM, t, v.repr);
}

// --- Allocation ---------------------------------------------------------------------------

fn zero_value(st: &mut C2, t: i64, r: i64) -> str {
    if r == R_STR {
        return "\"\"";
    }
    if r == R_BYTES {
        if is_array(st, t) && st.ylen.get(t) >= 0 {
            val lv: Ex = tx(st, st.ylen.get(t));
            return "Vec::filled(" + lv.code + ", 0)";
        }
        return "Vec::new()";
    }
    if r == R_VEC {
        val e: i64 = elem(st, t);
        if is_array(st, t) && st.ylen.get(t) >= 0 {
            val ln: i64 = st.ylen.get(t);
            val er: i64 = repr_of_type(st, e);
            if is_arith(st, e) || er == R_STR {
                val lv: Ex = tx(st, ln);
                val z: str = zero_value(st, e, er);
                return "Vec::filled(" + lv.code + ", " + z + ")";
            }
            return "";
        }
        return "Vec::new()";
    }
    if r == R_RAW {
        val e: i64 = elem(st, t);
        return "0 as *mut " + fid_raw_pointee(st, e);
    }
    if r == R_FILE {
        use_h(st, "CFile");
        return "c_nofile()";
    }
    if r == R_REF || r == R_VECREF || r == R_BYTESREF {
        return "";
    }
    if t < 0 {
        return "0";
    }
    val k: i64 = st.yk.get(t);
    if k == Y_INT { return "0"; }
    if k == Y_FLT { return "0.0"; }
    if k == Y_BOOL { return "false"; }
    if k == Y_STRUCT {
        return struct_literal(st, st.yelem.get(t), -1);
    }
    if is_func_ptr(st, t) {
        return "";
    }
    return "0";
}

/// A struct value: fields from the initializer list `init` (or zero).
fn struct_literal(st: &mut C2, sdi: i64, init: i64) -> str {
    val name: str = struct_fid(st, sdi);
    val fl: i64 = st.sd_fields.get(sdi);
    val n: i64 = list_len(st, fl);
    var parts: Vec<str> = Vec::new();
    var il: i64 = -1;
    if init >= 0 {
        il = st.nlst.get(init);
    }
    val ni: i64 = list_len(st, il);
    var i: i64 = 0;
    while i < n {
        val f: i64 = list_at(st, fl, i);
        val ft: i64 = st.sy_ty.get(f);
        val fr: i64 = st.sy_repr.get(f);
        var item: i64 = -1;
        // positional, or designated by name
        var j: i64 = 0;
        while j < ni {
            val it: i64 = list_at(st, il, j);
            if st.nk.get(it) == E_DESIG && st.ntext.get(it) == st.sy_name.get(f) {
                item = st.na.get(it);
            }
            j += 1;
        }
        if item < 0 && i < ni {
            val it: i64 = list_at(st, il, i);
            if st.nk.get(it) != E_DESIG {
                item = it;
            }
        }
        var v: str = "";
        if item >= 0 {
            v = init_value(st, ft, fr, item);
        } else {
            v = zero_value(st, ft, fr);
        }
        if v == "" {
            note(st, "field " + st.sy_name.get(f) + " of " + name + " has no zero value in Fid; Vec::new() used");
            v = "Vec::new()";
        }
        parts.push(safe_name(st, st.sy_name.get(f)) + ": " + v);
        i += 1;
    }
    return name + " { " + join_lines(parts, ", ") + " }";
}

/// An initializer as a value of C type `t` held as `r` (no statements).
fn init_value(st: &mut C2, t: i64, r: i64, init: i64) -> str {
    if st.nk.get(init) == E_INIT {
        if is_struct(st, t) {
            return struct_literal(st, st.yelem.get(t), init);
        }
        val l: i64 = st.nlst.get(init);
        if (r == R_VEC || is_array(st, t)) {
            // a nested array: built in a block expression
            val e: i64 = elem(st, t);
            val er: i64 = repr_of_type(st, e);
            val et: str = fid_elem_type(st, e);
            var sb: StringBuilder = StringBuilder::new();
            sb.append_str("{ var v: Vec<" + et + "> = Vec::new(); ");
            var i: i64 = 0;
            while i < list_len(st, l) {
                val it: i64 = list_at(st, l, i);
                val iv: str = init_value(st, e, er, it);
                sb.append_str("v.push(" + iv + "); ");
                i += 1;
            }
            sb.append_str("v }");
            return sb.to_str();
        }
        if list_len(st, l) > 0 {
            return init_value(st, t, r, list_at(st, l, 0));
        }
        return zero_value(st, t, r);
    }
    val v0: Ex = tx(st, init);
    val v: Ex = conv(st, v0, t, r);
    return v.code;
}

/// The number of elements an allocation asks for, as code.
fn alloc_count(st: &mut C2, call: i64, et: i64) -> str {
    val name: str = call_name(st, call);
    val x: i64 = strip_casts(st, call);
    val args: i64 = st.nlst.get(x);
    if name == "calloc" && list_len(st, args) == 2 {
        val v: Ex = tx(st, list_at(st, args, 0));
        val c: Ex = index_code(st, v);
        return c.code;
    }
    var a: i64 = -1;
    if name == "malloc" && list_len(st, args) == 1 {
        a = list_at(st, args, 0);
    }
    if name == "realloc" && list_len(st, args) == 2 {
        a = list_at(st, args, 1);
    }
    if a < 0 {
        return "0";
    }
    val ak: i64 = st.nk.get(a);
    if ak == E_SIZEOF_T || ak == E_SIZEOF_E {
        return "1";
    }
    if ak == E_BIN && st.ntext.get(a) == "*" {
        val l: i64 = st.na.get(a);
        val r: i64 = st.nb.get(a);
        if st.nk.get(r) == E_SIZEOF_T || st.nk.get(r) == E_SIZEOF_E {
            val v: Ex = tx(st, l);
            val c: Ex = index_code(st, v);
            return c.code;
        }
        if st.nk.get(l) == E_SIZEOF_T || st.nk.get(l) == E_SIZEOF_E {
            val v: Ex = tx(st, r);
            val c: Ex = index_code(st, v);
            return c.code;
        }
    }
    val v: Ex = tx(st, a);
    if is_charlike(st, et) {
        val c: Ex = index_code(st, v);
        return c.code;
    }
    val sz: str = c_size_of(st, et);
    note(st, "allocation size divided by the element size");
    return paren(v, P_MUL) + " / " + sz;
}

/// The value of `malloc`/`calloc`/`realloc` stored into something of C type
/// `t` held as `r`. A result starting with "\n" is a whole statement.
fn alloc_code(st: &mut C2, t: i64, r: i64, call: i64, target: str) -> str {
    val name: str = call_name(st, call);
    val e: i64 = elem(st, t);
    if r == R_VEC || r == R_BYTES {
        val n: str = alloc_count(st, call, e);
        var z: str = "0";
        if r == R_VEC {
            val er: i64 = repr_of_type(st, e);
            z = zero_value(st, e, er);
            if z == "" || !(is_arith(st, e) || er == R_STR) {
                note(st, "a Vec of " + fid_elem_type(st, e) + " filled with push");
                return "Vec::new()";
            }
        }
        if name == "realloc" {
            val x: i64 = strip_casts(st, call);
            val args: i64 = st.nlst.get(x);
            val first: Ex = tx(st, list_at(st, args, 0));
            if first.code == target {
                return "\nwhile " + target + ".len() < " + n + " { " + target + ".push(" + z + "); }\n" + target + ".truncate(" + n + ")";
            }
        }
        return "Vec::filled(" + n + ", " + z + ")";
    }
    if r == R_RAW {
        st.fn_raw = true;
        val pt: str = fid_raw_pointee(st, e);
        if is_struct(st, e) {
            if name == "calloc" {
                note(st, "calloc: the memory p_malloc gives is not zeroed");
            }
            val n: str = alloc_count(st, call, e);
            if n == "1" {
                return "p_malloc(comptime struct_size(" + pt + ")) as *mut " + pt;
            }
            return "p_malloc(" + n + " * comptime struct_size(" + pt + ")) as *mut " + pt;
        }
        val x: i64 = strip_casts(st, call);
        val args: i64 = st.nlst.get(x);
        var size: str = "8";
        if list_len(st, args) > 0 {
            val sv: Ex = tx(st, list_at(st, args, list_len(st, args) - 1));
            size = sv.code;
        }
        if name == "realloc" {
            note(st, "realloc of a raw pointer");
        }
        return "p_malloc(" + size + ") as *mut " + pt;
    }
    note(st, name + " where c2fd cannot tell what is allocated");
    st.fn_raw = true;
    return "p_malloc(8)";
}

// --- Calls ----------------------------------------------------------------------------------

fn call_args(st: &mut C2, e: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val l: i64 = st.nlst.get(e);
    var i: i64 = 0;
    while i < list_len(st, l) {
        out.push(list_at(st, l, i));
        i += 1;
    }
    return out;
}

/// A call. In statement position (`stmt`) the code may be a whole statement.
fn tx_call(st: &mut C2, e: i64, stmt: bool) -> Ex {
    val f: i64 = st.na.get(e);
    val t: i64 = st.nty.get(e);
    val args: Vec<i64> = call_args(st, e);
    var callee: i64 = -1;
    var name: str = "";
    if st.nk.get(f) == E_IDENT {
        callee = st.nsym.get(f);
        name = st.ntext.get(f);
    }
    if callee >= 0 && st.sy_kind.get(callee) == SK_FUNC && st.sy_defined.get(callee) {
        return user_call(st, callee, args, t);
    }
    if st.nk.get(f) == E_IDENT && (callee < 0 || (st.sy_kind.get(callee) == SK_FUNC && !st.sy_defined.get(callee))) {
        val v: Ex = tx_libc(st, name, args, stmt, t);
        if v.code != "" {
            return v;
        }
        if callee >= 0 {
            note(st, "'" + name + "' is declared but not defined in this file");
            return plain_call(st, safe_name(st, name), args, t, st.sy_ty.get(callee));
        }
        note(st, "'" + name + "' is not defined in this file");
        return plain_call(st, safe_name(st, name), args, t, -1);
    }
    // a call through a function value
    val fv: Ex = tx(st, f);
    var ft: i64 = st.nty.get(f);
    if is_func_ptr(st, ft) {
        ft = elem(st, ft);
    }
    return plain_call(st, paren(fv, P_POST), args, t, ft);
}

/// `callee(args)` with each argument converted to the parameter types of
/// function type `ft` (when known).
fn plain_call(st: &mut C2, callee: str, args: Vec<i64>, t: i64, ft: i64) -> Ex {
    var parts: Vec<str> = Vec::new();
    var pl: i64 = -1;
    if ft >= 0 && is_func(st, ft) {
        pl = st.ylst.get(ft);
    }
    var i: i64 = 0;
    while i < args.len() {
        val a: i64 = args.get(i);
        if i < list_len(st, pl) {
            val pn: i64 = list_at(st, pl, i);
            val pt: i64 = st.nty.get(pn);
            val pr: i64 = repr_of_type(st, pt);
            val code: str = arg_code(st, a, pt, pr, SK_PARAM);
            parts.push(code);
        } else {
            val v: Ex = tx(st, a);
            val c: Ex = conv(st, v, v.ty, R_STR);
            if v.repr == R_BYTES || v.repr == R_BYTESREF {
                parts.push(c.code);
            } else {
                parts.push(v.code);
            }
        }
        i += 1;
    }
    return ex(callee + "(" + join_lines(parts, ", ") + ")", P_POST, t, repr_of_type(st, t));
}

fn user_call(st: &mut C2, callee: i64, args: Vec<i64>, t: i64) -> Ex {
    if st.cur_fn >= 0 {
        // M10: the caller is @unsafe if the callee is (raw_close)
        st.call_from.push(st.cur_fn);
        st.call_to.push(callee);
    }
    val pl: i64 = st.sy_params.get(callee);
    var parts: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < args.len() {
        val a: i64 = args.get(i);
        if i < list_len(st, pl) {
            val p: i64 = list_at(st, pl, i);
            val pt: i64 = st.sy_ty.get(p);
            val pr: i64 = st.sy_repr.get(p);
            if pr == R_PCUR {
                parts.push(cur_arg_code(st, a, p));
            } else {
                val code: str = arg_code(st, a, pt, pr, SK_PARAM);
                parts.push(code);
            }
        } else {
            val v: Ex = tx(st, a);
            parts.push(v.code);
        }
        i += 1;
    }
    var name: str = st.sy_fid.get(callee);
    val r: i64 = st.sy_ret.get(callee);
    return ex(name + "(" + join_lines(parts, ", ") + ")", P_POST, t, r);
}

/// An argument for a parameter of C type `pt` held as `pr`.
fn arg_code(st: &mut C2, a: i64, pt: i64, pr: i64, kind: i64) -> str {
    val x: i64 = strip_casts(st, a);
    val xk: i64 = st.nk.get(x);
    val pe: i64 = elem(st, pt);
    if pr == R_REF {
        if xk == E_UNARY && st.ntext.get(x) == "&" {
            val inner: i64 = st.na.get(x);
            val ik: i64 = st.nk.get(inner);
            if ik == E_INDEX && st.allow_post {
                // &v[i]: a copy in a local, written back after the call
                val v: Ex = tx(st, inner);
                val tmp: str = new_tmp(st);
                val ft: str = fid_val_type(st, st.nty.get(inner));
                pre_add(st, "var " + tmp + ": " + ft + " = " + v.code + ";");
                val p: Place = tx_place(st, inner);
                val back: str = place_store(st, p, tmp);
                st.post.push(back + ";");
                if is_const(st, pe) {
                    return "&" + tmp;
                }
                return "&mut " + tmp;
            }
            val ra: Ex = tx_addr(st, inner, is_const(st, pe));
            return ra.code;
        }
        val v: Ex = tx(st, x);
        if v.repr == R_REF {
            return v.code;
        }
        if v.repr == R_RAW {
            st.fn_raw = true;
            return "&mut *" + paren(v, P_UNARY);
        }
        note(st, "a pointer argument c2fd cannot make a reference of");
        return v.code;
    }
    if pr == R_VECREF || pr == R_BYTESREF {
        val v: Ex = tx(st, x);
        if v.repr == R_VEC || v.repr == R_BYTES {
            if is_const(st, pe) || (pr == R_BYTESREF && is_const(st, pe)) {
                return "&" + paren(v, P_UNARY);
            }
            return "&mut " + paren(v, P_UNARY);
        }
        if v.repr == R_VECREF || v.repr == R_BYTESREF {
            return v.code;
        }
        if v.repr == R_STR && pr == R_BYTESREF {
            use_h(st, "c_bytes");
            val tmp: str = new_tmp(st);
            pre_add(st, "var " + tmp + ": Vec<i64> = c_bytes(" + v.code + ");");
            note(st, "a string passed where a char buffer is written: the writes stay in " + tmp);
            return "&mut " + tmp;
        }
        note(st, "a pointer argument where a Vec is expected");
        return v.code;
    }
    if pr == R_FILE {
        val v: Ex = tx(st, x);
        return file_code(st, x, v);
    }
    val v: Ex = tx(st, a);
    val c: Ex = conv(st, v, pt, pr);
    if pr == R_RAW && v.repr == R_REF && str_starts_with(v.code, "&mut ") {
        return c.code;
    }
    return c.code;
}

/// A FILE argument for a `&mut CFile` parameter or helper.
fn file_code(st: &mut C2, x: i64, v: Ex) -> str {
    val s: i64 = base_sym(st, x);
    if s >= 0 && st.sy_kind.get(s) == SK_PARAM {
        return v.code;
    }
    return "&mut " + paren(v, P_UNARY);
}

fn str_arg(st: &mut C2, a: i64) -> str {
    val v: Ex = tx(st, a);
    val c: Ex = conv(st, v, st.t_charp, R_STR);
    return c.code;
}

fn int_arg(st: &mut C2, a: i64) -> str {
    val v: Ex = tx(st, a);
    val c: Ex = conv(st, v, st.t_int, R_VAL);
    return c.code;
}

fn f64_arg(st: &mut C2, a: i64) -> str {
    val v: Ex = tx(st, a);
    val c: Ex = conv(st, v, st.t_double, R_VAL);
    return c.code;
}

fn stream_of(st: &mut C2, a: i64) -> str {
    if st.nk.get(a) == E_IDENT {
        val n: str = st.ntext.get(a);
        if n == "stdout" { return "out"; }
        if n == "stderr" { return "err"; }
        if n == "stdin" { return "in"; }
    }
    return "file";
}

fn stmt_or_pre(st: &mut C2, code: str, stmt: bool, t: i64, value: str) -> Ex {
    if stmt {
        return ex(code, P_POST, t, R_VAL);
    }
    pre_add(st, code + ";");
    return ex(value, P_PRIM, t, R_VAL);
}

fn bool_or(st: &mut C2, code: str) -> Ex {
    return ex(code, P_POST, st.t_bool, R_VAL);
}

/// The C library calls c2fd knows: their Fid form, or code "" when unknown.
fn tx_libc(st: &mut C2, name: str, args: Vec<i64>, stmt: bool, t: i64) -> Ex {
    val n: i64 = args.len();
    if name == "printf" && n >= 1 {
        var rest: Vec<i64> = Vec::new();
        var i: i64 = 1;
        while i < n { rest.push(args.get(i)); i += 1; }
        val code: str = printf_code(st, args.get(0), rest, "out");
        if !stmt { note(st, "printf's result (a count) is not computed"); }
        return stmt_or_pre(st, code, stmt, t, "0");
    }
    if name == "fprintf" && n >= 2 {
        val s: str = stream_of(st, args.get(0));
        var rest: Vec<i64> = Vec::new();
        var i: i64 = 2;
        while i < n { rest.push(args.get(i)); i += 1; }
        if s == "file" {
            note(st, "fprintf to a file is not translated; it prints to stdout here");
        }
        val code: str = printf_code(st, args.get(1), rest, s);
        return stmt_or_pre(st, code, stmt, t, "0");
    }
    if (name == "sprintf" || name == "snprintf") && n >= 2 {
        var fi: i64 = 1;
        if name == "snprintf" { fi = 2; }
        var rest: Vec<i64> = Vec::new();
        var i: i64 = fi + 1;
        while i < n { rest.push(args.get(i)); i += 1; }
        val sv: str = format_value(st, args.get(fi), rest);
        val p: Place = tx_place(st, args.get(0));
        var code: str = "";
        if p.repr == R_BYTES || p.repr == R_BYTESREF {
            use_h(st, "c_strcpy");
            if p.repr == R_BYTES {
                code = "c_strcpy(&mut " + p.code + ", " + sv + ")";
            } else {
                code = "c_strcpy(" + p.code + ", " + sv + ")";
            }
        } else {
            code = place_store(st, p, sv);
        }
        if !stmt { note(st, name + "'s result (a count) is not computed"); }
        return stmt_or_pre(st, code, stmt, t, "0");
    }
    if name == "puts" && n == 1 {
        val s: str = str_arg(st, args.get(0));
        return stmt_or_pre(st, "println(" + s + ")", stmt, t, "0");
    }
    if name == "putchar" && n == 1 {
        val c: str = int_arg(st, args.get(0));
        return stmt_or_pre(st, "print(char_to_str(" + c + "))", stmt, t, c);
    }
    if (name == "fputs" || name == "fputc" || name == "putc") && n == 2 {
        val s: str = stream_of(st, args.get(1));
        var v: str = "";
        if name == "fputs" {
            v = str_arg(st, args.get(0));
        } else {
            v = "char_to_str(" + int_arg(st, args.get(0)) + ")";
        }
        if s == "err" {
            return stmt_or_pre(st, "p_eprint_str(" + v + ")", stmt, t, "0");
        }
        if s == "file" {
            note(st, name + " to a file is not translated; it prints to stdout here");
        }
        return stmt_or_pre(st, "print(" + v + ")", stmt, t, "0");
    }
    if name == "strlen" && n == 1 {
        val v: Ex = tx(st, args.get(0));
        if v.repr == R_BYTES {
            use_h(st, "c_strlen");
            return ex("c_strlen(&" + paren(v, P_UNARY) + ")", P_POST, t, R_VAL);
        }
        if v.repr == R_BYTESREF {
            use_h(st, "c_strlen");
            return ex("c_strlen(" + v.code + ")", P_POST, t, R_VAL);
        }
        return ex("str_len(" + v.code + ")", P_POST, t, R_VAL);
    }
    if name == "strcmp" && n == 2 {
        val a: str = str_arg(st, args.get(0));
        val b: str = str_arg(st, args.get(1));
        return ex("str_compare(" + a + ", " + b + ")", P_POST, t, R_VAL);
    }
    if name == "strncmp" && n == 3 {
        use_h(st, "c_strncmp");
        val a: str = str_arg(st, args.get(0));
        val b: str = str_arg(st, args.get(1));
        val c: str = int_arg(st, args.get(2));
        return ex("c_strncmp(" + a + ", " + b + ", " + c + ")", P_POST, t, R_VAL);
    }
    if (name == "strcpy" || name == "strcat" || name == "strncpy") && n >= 2 {
        val src: str = str_arg(st, args.get(1));
        val p: Place = tx_place(st, args.get(0));
        var code: str = "";
        if p.repr == R_BYTES || p.repr == R_BYTESREF {
            var h: str = "c_strcpy";
            if name == "strcat" { h = "c_strcat"; }
            use_h(st, h);
            var target: str = p.code;
            if p.repr == R_BYTES { target = "&mut " + p.code; }
            code = h + "(" + target + ", " + src + ")";
        } else if name == "strcat" {
            code = place_store(st, p, p.code + " + " + src);
        } else {
            if name == "strncpy" { note(st, "strncpy's length limit is not kept"); }
            code = place_store(st, p, src);
        }
        if stmt {
            return ex(code, P_POST, t, R_VAL);
        }
        pre_add(st, code + ";");
        return ex(p.code, P_PRIM, t, p.repr);
    }
    if name == "strdup" && n == 1 {
        val s: str = str_arg(st, args.get(0));
        return ex(s, P_POST, t, R_STR);
    }
    if (name == "strchr" || name == "strrchr" || name == "strstr") && n == 2 {
        use_h(st, "c_" + name);
        val s: str = str_arg(st, args.get(0));
        var b: str = "";
        if name == "strstr" { b = str_arg(st, args.get(1)); } else { b = int_arg(st, args.get(1)); }
        return ex("c_" + name + "(" + s + ", " + b + ")", P_POST, t, R_STR);
    }
    if (name == "atoi" || name == "atol" || name == "atoll") && n == 1 {
        use_h(st, "c_atoi");
        val s: str = str_arg(st, args.get(0));
        return ex("c_atoi(" + s + ")", P_POST, t, R_VAL);
    }
    if name == "atof" && n == 1 {
        val s: str = str_arg(st, args.get(0));
        return ex("str_parse_float(" + s + ")", P_POST, t, R_VAL);
    }
    if (name == "abs" || name == "labs" || name == "llabs") && n == 1 {
        val c: str = int_arg(st, args.get(0));
        return ex("abs(" + c + ")", P_POST, t, R_VAL);
    }
    if (name == "sqrt" || name == "pow" || name == "sin" || name == "cos" || name == "floor" || name == "ceil" || name == "exp" || name == "log" || name == "fabs") && n >= 1 {
        use_h(st, "math");
        var parts: Vec<str> = Vec::new();
        var i: i64 = 0;
        while i < n {
            parts.push(f64_arg(st, args.get(i)));
            i += 1;
        }
        return ex("math_" + name + "(" + join_lines(parts, ", ") + ")", P_POST, st.t_double, R_VAL);
    }
    if n == 1 && (name == "isdigit" || name == "isalpha" || name == "isupper" || name == "islower") {
        val c: str = int_arg(st, args.get(0));
        var f: str = "char_is_digit";
        if name == "isalpha" { f = "char_is_alpha"; }
        if name == "isupper" { f = "char_is_upper"; }
        if name == "islower" { f = "char_is_lower"; }
        return bool_or(st, f + "(" + c + ")");
    }
    if n == 1 && (name == "isspace" || name == "isalnum" || name == "ispunct" || name == "isxdigit" || name == "isprint" || name == "iscntrl") {
        use_h(st, "c_" + name);
        val c: str = int_arg(st, args.get(0));
        return bool_or(st, "c_" + name + "(" + c + ")");
    }
    if n == 1 && (name == "toupper" || name == "tolower") {
        val c: str = int_arg(st, args.get(0));
        var f: str = "char_to_upper";
        if name == "tolower" { f = "char_to_lower"; }
        return ex(f + "(" + c + ")", P_POST, t, R_VAL);
    }
    if name == "exit" && n == 1 {
        val c: str = int_arg(st, args.get(0));
        return stmt_or_pre(st, "p_exit(" + c + ")", stmt, t, "0");
    }
    if name == "abort" {
        return stmt_or_pre(st, "panic(\"abort\")", stmt, t, "0");
    }
    if name == "assert" && n == 1 {
        val c: Ex = tx_cond(st, args.get(0));
        return stmt_or_pre(st, "assert(" + c.code + ")", stmt, t, "0");
    }
    if name == "free" && n == 1 {
        val v: Ex = tx(st, args.get(0));
        if v.repr == R_RAW {
            st.fn_raw = true;
            return stmt_or_pre(st, "p_free(" + paren(v, P_POST) + " as i64)", stmt, t, "0");
        }
        val fs: i64 = base_sym(st, args.get(0));
        if fs >= 0 && vec_has_i64(st.rg_syms, fs) {
            return stmt_or_pre(st, "// free(" + v.code + "): the end of the region frees it", stmt, t, "0");
        }
        return stmt_or_pre(st, "// free(" + v.code + "): Fid frees the Vec or string itself", stmt, t, "0");
    }
    if (name == "malloc" || name == "calloc" || name == "realloc") && n >= 1 {
        val vt: i64 = st.t_voidp;
        val code: str = alloc_code(st, vt, R_RAW, -1, "");
        return ex(code, P_POST, st.t_voidp, R_RAW);
    }
    if name == "fopen" && n == 2 {
        use_h(st, "CFile");
        val p: str = str_arg(st, args.get(0));
        val m: str = str_arg(st, args.get(1));
        return ex("c_fopen(" + p + ", " + m + ")", P_POST, t, R_FILE);
    }
    if name == "fclose" && n == 1 {
        use_h(st, "CFile");
        val v: Ex = tx(st, args.get(0));
        val fc: str = file_code(st, args.get(0), v);
        return stmt_or_pre(st, "c_fclose(" + fc + ")", stmt, t, "0");
    }
    if (name == "fgetc" || name == "getc") && n == 1 {
        use_h(st, "CFile");
        if stream_of(st, args.get(0)) == "in" {
            use_h(st, "c_getchar");
            return ex("c_getchar()", P_POST, t, R_VAL);
        }
        val v: Ex = tx(st, args.get(0));
        val fc: str = file_code(st, args.get(0), v);
        return ex("c_fgetc(" + fc + ")", P_POST, t, R_VAL);
    }
    if name == "getchar" && n == 0 {
        use_h(st, "CFile");
        use_h(st, "c_getchar");
        return ex("c_getchar()", P_POST, t, R_VAL);
    }
    if name == "feof" && n == 1 {
        use_h(st, "CFile");
        val v: Ex = tx(st, args.get(0));
        val fc: str = file_code(st, args.get(0), v);
        return bool_or(st, "c_feof(" + fc + ")");
    }
    if name == "fgets" && n == 3 {
        use_h(st, "CFile");
        val p: Place = tx_place(st, args.get(0));
        val size: str = int_arg(st, args.get(1));
        var fc: str = "";
        if stream_of(st, args.get(2)) == "in" {
            use_h(st, "c_getchar");
            fc = "&mut c_stdin";
        } else {
            val v: Ex = tx(st, args.get(2));
            fc = file_code(st, args.get(2), v);
        }
        if p.repr == R_STR {
            pre_add(st, place_store(st, p, "c_fgets(" + fc + ", " + size + ")") + ";");
            return ex(p.code, P_PRIM, st.t_charp, R_STR);
        }
        use_h(st, "c_strcpy");
        val tmp: str = new_tmp(st);
        pre_add(st, "val " + tmp + ": str = c_fgets(" + fc + ", " + size + ");");
        var target: str = p.code;
        if p.repr == R_BYTES { target = "&mut " + p.code; }
        pre_add(st, "if (" + tmp + " as i64) != 0 { c_strcpy(" + target + ", " + tmp + "); }");
        return ex(tmp, P_PRIM, st.t_charp, R_STR);
    }
    if name == "memset" && n == 3 {
        val v: Ex = tx(st, args.get(0));
        if v.repr == R_VEC || v.repr == R_BYTES || v.repr == R_VECREF || v.repr == R_BYTESREF {
            val c: str = int_arg(st, args.get(1));
            var target: str = v.code;
            if v.repr == R_VEC || v.repr == R_BYTES { target = "&mut " + v.code; }
            use_h(st, "c_fill");
            note(st, "memset fills the whole Vec; its size argument is ignored");
            return stmt_or_pre(st, "c_fill(" + target + ", " + c + ")", stmt, t, "0");
        }
    }
    return ex("", P_PRIM, t, R_VAL);
}

// --- printf ------------------------------------------------------------------------------------

struct FmtSpec {
    flags: str,
    width: i64,
    prec: i64,
    conv: i64,
    end: i64,
    star_w: bool,
    star_p: bool,
}

/// The conversion that starts at `%` at `i` of a format's (C-escaped) text.
fn parse_spec_at(f: str, i: i64) -> FmtSpec {
    val n: i64 = str_len(f);
    var j: i64 = i + 1;
    var flags: str = "";
    while j < n {
        val c: i64 = str_byte_at(f, j);
        if c == 45 || c == 43 || c == 32 || c == 35 || c == 48 {
            flags = flags + char_to_str(c);
            j += 1;
        } else {
            break;
        }
    }
    var width: i64 = -1;
    var star_w: bool = false;
    if j < n && str_byte_at(f, j) == 42 {
        star_w = true;
        j += 1;
    }
    while j < n && is_dig(str_byte_at(f, j)) {
        if width < 0 { width = 0; }
        width = width * 10 + (str_byte_at(f, j) - 48);
        j += 1;
    }
    var prec: i64 = -1;
    var star_p: bool = false;
    if j < n && str_byte_at(f, j) == 46 {
        j += 1;
        prec = 0;
        if j < n && str_byte_at(f, j) == 42 {
            star_p = true;
            j += 1;
        }
        while j < n && is_dig(str_byte_at(f, j)) {
            prec = prec * 10 + (str_byte_at(f, j) - 48);
            j += 1;
        }
    }
    while j < n {
        val c: i64 = str_byte_at(f, j);
        if c == 104 || c == 108 || c == 76 || c == 113 || c == 106 || c == 122 || c == 116 {
            j += 1;
        } else {
            break;
        }
    }
    var conv: i64 = 0;
    if j < n {
        conv = str_byte_at(f, j);
        j += 1;
    }
    return FmtSpec { flags: flags, width: width, prec: prec, conv: conv, end: j, star_w: star_w, star_p: star_p };
}

/// One piece of formatted output: `code` is a str expression, or (when
/// `plain`) a value an f-string prints as C would.
struct Piece {
    text: bool,
    code: str,
    plain: bool,
    // the piece as a str expression, for a concatenation
    alt: str,
}

fn tpiece(t: str) -> Piece {
    return Piece { text: true, code: t, plain: true, alt: "" };
}

fn vpiece(code: str, plain: bool, alt: str) -> Piece {
    return Piece { text: false, code: code, plain: plain, alt: alt };
}

fn pad_code(st: &mut C2, s: str, sp: FmtSpec, wcode: str) -> str {
    if wcode == "" {
        return s;
    }
    if str_contains(sp.flags, "-") {
        use_h(st, "c_ljust");
        return "c_ljust(" + s + ", " + wcode + ")";
    }
    if str_contains(sp.flags, "0") && sp.conv != 115 && sp.conv != 99 {
        use_h(st, "c_zfill");
        return "c_zfill(" + s + ", " + wcode + ")";
    }
    use_h(st, "c_rjust");
    return "c_rjust(" + s + ", " + wcode + ")";
}

fn int_text(st: &mut C2, v: Ex) -> str {
    var x: Ex = v;
    if is_bool(st, v.ty) {
        x = ex("if " + v.code + " { 1 } else { 0 }", P_IF, st.t_int, R_VAL);
    }
    val fb: str = fid_base(st, x.ty);
    if fb == "i64" {
        return "int_to_str(" + x.code + ")";
    }
    return "int_to_str(" + paren(x, P_POST) + " as i64)";
}

/// The pieces of a printf format applied to `args`.
fn format_pieces(st: &mut C2, f: str, args: Vec<i64>) -> Vec<Piece> {
    var out: Vec<Piece> = Vec::new();
    val n: i64 = str_len(f);
    var i: i64 = 0;
    var start: i64 = 0;
    var ai: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(f, i);
        if c == 92 {
            i += 2;
            continue;
        }
        if c != 37 {
            i += 1;
            continue;
        }
        if i > start {
            out.push(tpiece(str_slice(f, start, i)));
        }
        val sp: FmtSpec = parse_spec_at(f, i);
        i = sp.end;
        start = i;
        if sp.conv == 37 {
            out.push(tpiece("%"));
            continue;
        }
        var wcode: str = "";
        if sp.width >= 0 {
            wcode = int_to_str(sp.width);
        }
        if sp.star_w && ai < args.len() {
            wcode = int_arg(st, args.get(ai));
            ai += 1;
        }
        var prec: i64 = sp.prec;
        var pcode: str = "";
        if prec >= 0 {
            pcode = int_to_str(prec);
        }
        if sp.star_p && ai < args.len() {
            pcode = int_arg(st, args.get(ai));
            ai += 1;
        }
        if ai >= args.len() {
            note(st, "printf has fewer arguments than its format");
            out.push(tpiece("?"));
            continue;
        }
        val a: i64 = args.get(ai);
        ai += 1;
        val v: Ex = tx(st, a);
        val cv: i64 = sp.conv;
        if cv == 100 || cv == 105 || cv == 117 {
            if str_contains(sp.flags, "+") {
                note(st, "printf's '+' flag is not translated");
            }
            if wcode == "" && pcode == "" {
                val it: str = int_text(st, v);
                if is_bool(st, v.ty) {
                    out.push(vpiece("if " + v.code + " { 1 } else { 0 }", true, it));
                } else {
                    out.push(vpiece(v.code, true, it));
                }
            } else {
                val it: str = int_text(st, v);
                val pc: str = pad_code(st, it, sp, wcode);
                out.push(vpiece(pc, false, pc));
            }
            continue;
        }
        if cv == 99 {
            val ic: Ex = conv(st, v, st.t_int, R_VAL);
            val s: str = "char_to_str(" + ic.code + ")";
            val pc: str = pad_code(st, s, sp, wcode);
            out.push(vpiece(pc, false, pc));
            continue;
        }
        if cv == 115 && wcode == "" && pcode == "" && st.nk.get(a) == E_STR {
            // a literal argument joins the text
            out.push(tpiece(st.ntext.get(a)));
            continue;
        }
        if cv == 115 {
            val sv: Ex = conv(st, v, st.t_charp, R_STR);
            var s: str = sv.code;
            if pcode != "" {
                use_h(st, "c_left");
                s = "c_left(" + s + ", " + pcode + ")";
            }
            if wcode == "" && pcode == "" {
                var alt: str = s;
                if str_starts_with(s, "if ") {
                    alt = "(" + s + ")";
                }
                out.push(vpiece(s, true, alt));
            } else {
                val pc: str = pad_code(st, s, sp, wcode);
                out.push(vpiece(pc, false, pc));
            }
            continue;
        }
        if cv == 102 || cv == 70 {
            use_h(st, "c_fmt_f");
            val fv: Ex = conv(st, v, st.t_double, R_VAL);
            if pcode == "" { pcode = "6"; }
            val s: str = "c_fmt_f(" + fv.code + ", " + pcode + ")";
            val pc: str = pad_code(st, s, sp, wcode);
            out.push(vpiece(pc, false, pc));
            continue;
        }
        if cv == 101 || cv == 69 || cv == 103 || cv == 71 {
            use_h(st, "c_fmt_g");
            val fv: Ex = conv(st, v, st.t_double, R_VAL);
            if pcode == "" { pcode = "6"; }
            if cv == 101 || cv == 69 {
                note(st, "%e is printed like %g");
            }
            val s: str = "c_fmt_g(" + fv.code + ", " + pcode + ")";
            val pc: str = pad_code(st, s, sp, wcode);
            out.push(vpiece(pc, false, pc));
            continue;
        }
        if cv == 120 || cv == 88 || cv == 111 {
            use_h(st, "c_hex");
            val iv: Ex = conv(st, v, st.t_int, R_VAL);
            var s: str = "";
            if cv == 111 {
                s = "c_oct(" + iv.code + ")";
            } else if cv == 88 {
                s = "c_hex(" + iv.code + ", true)";
            } else {
                s = "c_hex(" + iv.code + ", false)";
            }
            if str_contains(sp.flags, "#") {
                if cv == 111 { s = "\"0\" + " + s; } else if cv == 88 { s = "\"0X\" + " + s; } else { s = "\"0x\" + " + s; }
            }
            val pc: str = pad_code(st, s, sp, wcode);
            out.push(vpiece(pc, false, pc));
            continue;
        }
        if cv == 112 {
            note(st, "%p prints the address as a number");
            val pc: str = "int_to_str(" + paren(v, P_POST) + " as i64)";
            out.push(vpiece(pc, false, pc));
            continue;
        }
        note(st, "printf conversion '%" + char_to_str(cv) + "' is not translated");
        out.push(vpiece(v.code, true, "f\"{" + v.code + "}\""));
    }
    if start < n {
        out.push(tpiece(str_slice(f, start, n)));
    }
    if ai < args.len() {
        note(st, "printf has more arguments than its format uses");
    }
    return out;
}

/// The pieces as one Fid str expression: an f-string when that is safe,
/// else a concatenation.
fn pieces_value(st: &mut C2, pieces: Vec<Piece>) -> str {
    var fstring_ok: bool = true;
    var any_value: bool = false;
    var i: i64 = 0;
    while i < pieces.len() {
        val p: Piece = pieces.get(i);
        if p.text {
            if str_contains(p.code, "{") || str_contains(p.code, "}") {
                fstring_ok = false;
            }
        } else {
            any_value = true;
            if str_contains(p.code, "\"") || str_contains(p.code, "{") || str_contains(p.code, "}") {
                fstring_ok = false;
            }
        }
        i += 1;
    }
    if !any_value {
        var sb: StringBuilder = StringBuilder::new();
        i = 0;
        while i < pieces.len() {
            val p: Piece = pieces.get(i);
            sb.append_str(fid_str_text(p.code));
            i += 1;
        }
        return "\"" + sb.to_str() + "\"";
    }
    if pieces.len() == 1 && pieces.get(0).plain && !str_contains(pieces.get(0).code, "\"") {
        // print and println take any value
        return pieces.get(0).code;
    }
    if fstring_ok {
        var sb: StringBuilder = StringBuilder::new();
        sb.append_str("f\"");
        i = 0;
        while i < pieces.len() {
            val p: Piece = pieces.get(i);
            if p.text {
                sb.append_str(fid_str_text(p.code));
            } else {
                sb.append_str("{" + p.code + "}");
            }
            i += 1;
        }
        sb.append_str("\"");
        return sb.to_str();
    }
    var parts: Vec<str> = Vec::new();
    var lit: StringBuilder = StringBuilder::new();
    var has_lit: bool = false;
    i = 0;
    while i < pieces.len() {
        val p: Piece = pieces.get(i);
        if p.text {
            lit.append_str(fid_str_text(p.code));
            has_lit = true;
        } else {
            if has_lit {
                parts.push("\"" + lit.to_str() + "\"");
                lit = StringBuilder::new();
                has_lit = false;
            }
            parts.push(p.alt);
        }
        i += 1;
    }
    if has_lit {
        parts.push("\"" + lit.to_str() + "\"");
    }
    return join_lines(parts, " + ");
}

fn format_value(st: &mut C2, fmt: i64, args: Vec<i64>) -> str {
    if st.nk.get(fmt) != E_STR {
        note(st, "a format that is not a string literal is used as the text");
        return str_arg(st, fmt);
    }
    val pieces: Vec<Piece> = format_pieces(st, st.ntext.get(fmt), args);
    return pieces_value(st, pieces);
}

/// printf(fmt, args) to `stream` ("out", "err", "file") as a statement.
fn printf_code(st: &mut C2, fmt: i64, args: Vec<i64>, stream: str) -> str {
    val fk: i64 = st.nk.get(fmt);
    if fk == E_COND && st.nk.get(st.nb.get(fmt)) == E_STR && st.nk.get(st.nc.get(fmt)) == E_STR {
        val c: Ex = tx_cond(st, st.na.get(fmt));
        val m: i64 = st.pre.len();
        val a: str = printf_code(st, st.nb.get(fmt), args, stream);
        val pa: Vec<str> = pre_take(st, m);
        val b: str = printf_code(st, st.nc.get(fmt), args, stream);
        val pb: Vec<str> = pre_take(st, m);
        var sb: StringBuilder = StringBuilder::new();
        sb.append_str("if " + c.code + " {\n");
        var i: i64 = 0;
        while i < pa.len() { sb.append_str("    " + pa.get(i) + "\n"); i += 1; }
        sb.append_str("    " + a + ";\n} else {\n");
        i = 0;
        while i < pb.len() { sb.append_str("    " + pb.get(i) + "\n"); i += 1; }
        sb.append_str("    " + b + ";\n}");
        return sb.to_str();
    }
    if fk != E_STR {
        note(st, "a format that is not a string literal is printed as text");
        val s: str = str_arg(st, fmt);
        if stream == "err" {
            return "p_eprint_str(" + s + ")";
        }
        return "print(" + s + ")";
    }
    var text: str = st.ntext.get(fmt);
    var nl: bool = false;
    if stream != "err" && str_ends_with(text, "\\n") && !str_ends_with(text, "\\\\n") {
        nl = true;
        text = str_slice(text, 0, str_len(text) - 2);
    }
    val pieces: Vec<Piece> = format_pieces(st, text, args);
    var v: str = pieces_value(st, pieces);
    if stream == "err" {
        return "p_eprint_str(" + v + ")";
    }
    if nl {
        if v == "\"\"" {
            return "println(\"\")";
        }
        return "println(" + v + ")";
    }
    return "print(" + v + ")";
}

// --- Emission: statements ---------------------------------------------------------------------

fn emit(st: &mut C2, ind: i64, line: str) {
    st.lines.push(spaces(ind) + line);
}

/// Emit text that may hold several lines (each with its own relative indent).
fn emit_text(st: &mut C2, ind: i64, text: str) {
    val parts: Vec<str> = split_nl(text);
    var i: i64 = 0;
    while i < parts.len() {
        emit(st, ind, parts.get(i));
        i += 1;
    }
}

fn emit_comments(st: &mut C2, ind: i64, c: str) {
    if c != "" {
        emit_text(st, ind, c);
    }
}

/// TODO notes, then the statements hoisted out of the expressions.
fn flush(st: &mut C2, ind: i64) {
    var i: i64 = 0;
    while i < st.notes.len() {
        emit(st, ind, st.notes.get(i));
        i += 1;
    }
    st.notes.clear();
    i = 0;
    while i < st.pre.len() {
        emit_text(st, ind, st.pre.get(i));
        i += 1;
    }
    st.pre.clear();
}

fn flush_post(st: &mut C2, ind: i64) {
    var i: i64 = 0;
    while i < st.post.len() {
        emit_text(st, ind, st.post.get(i));
        i += 1;
    }
    st.post.clear();
}

/// A statement's code with its `;` (none after a block or a comment).
fn add_semi(code: str) -> str {
    if code == "" {
        return "";
    }
    val parts: Vec<str> = split_nl(code);
    val last: str = str_trim(parts.get(parts.len() - 1));
    if str_ends_with(last, "}") || str_starts_with(last, "//") || str_ends_with(last, ";") {
        return code;
    }
    return code + ";";
}

/// Emit `code` with a trailing comment on its last line.
fn emit_code(st: &mut C2, ind: i64, code: str, trail: str) {
    val parts: Vec<str> = split_nl(code);
    var i: i64 = 0;
    while i < parts.len() {
        var l: str = parts.get(i);
        if i == parts.len() - 1 && trail != "" && !str_contains(trail, "\n") {
            l = l + "  " + trail;
        }
        emit(st, ind, l);
        i += 1;
    }
    if str_contains(trail, "\n") {
        emit_text(st, ind, trail);
    }
}

/// An expression used as a statement, as code (with `;`).
fn stmt_code(st: &mut C2, x: i64) -> str {
    val k: i64 = st.nk.get(x);
    if k == E_ASSIGN {
        val c: str = assign_code(st, x);
        return add_semi(c);
    }
    if k == E_PREINC || k == E_PREDEC || k == E_POSTINC || k == E_POSTDEC {
        val c: str = incdec_code(st, x);
        return add_semi(c);
    }
    if k == E_CALL {
        val v: Ex = tx_call(st, x, true);
        return add_semi(v.code);
    }
    if k == E_COMMA {
        val a: str = stmt_code(st, st.na.get(x));
        val b: str = stmt_code(st, st.nb.get(x));
        if a == "" { return b; }
        if b == "" { return a; }
        return a + "\n" + b;
    }
    if k == E_CAST {
        return stmt_code(st, st.na.get(x));
    }
    if k == E_COND {
        val c: Ex = tx_cond(st, st.na.get(x));
        val m: i64 = st.pre.len();
        val a: str = stmt_code(st, st.nb.get(x));
        val pa: Vec<str> = pre_take(st, m);
        val b: str = stmt_code(st, st.nc.get(x));
        val pb: Vec<str> = pre_take(st, m);
        var sb: StringBuilder = StringBuilder::new();
        sb.append_str("if " + c.code + " {\n");
        var i: i64 = 0;
        while i < pa.len() { sb.append_str(indent_text(pa.get(i)) + "\n"); i += 1; }
        if a != "" { sb.append_str(indent_text(a) + "\n"); }
        sb.append_str("} else {\n");
        i = 0;
        while i < pb.len() { sb.append_str(indent_text(pb.get(i)) + "\n"); i += 1; }
        if b != "" { sb.append_str(indent_text(b) + "\n"); }
        sb.append_str("}");
        return sb.to_str();
    }
    val v: Ex = tx(st, x);
    if st.nk.get(x) == E_IDENT || st.nk.get(x) == E_INT {
        return "// " + v.code + ";  (a C statement with no effect)";
    }
    return add_semi(v.code);
}

fn indent_text(t: str) -> str {
    val parts: Vec<str> = split_nl(t);
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < parts.len() {
        out.push("    " + parts.get(i));
        i += 1;
    }
    return join_lines(out, "\n");
}

fn comment_line_count(c: str) -> i64 {
    if c == "" {
        return 0;
    }
    return split_nl(c).len();
}

fn emit_vec(st: &mut C2, v: Vec<i64>, ind: i64) {
    val spans: Vec<i64> = region_spans(st, v);
    var sp: i64 = 0;
    var prev_end: i64 = -1;
    var i: i64 = 0;
    while i < v.len() {
        val s: i64 = v.get(i);
        val first: i64 = st.nline.get(s) - comment_line_count(st.nlead.get(s));
        if prev_end >= 0 && first > prev_end + 1 && st.nk.get(s) != S_EMPTY {
            emit(st, 0, "");
        }
        if sp < spans.len() && spans.get(sp) == i {
            // statements from a malloc to its free: a region
            val last: i64 = spans.get(sp + 1);
            emit_region(st, v, i, last, ind);
            prev_end = st.nend.get(v.get(last));
            i = last + 1;
            sp += 2;
            continue;
        }
        emit_stmt(st, s, ind);
        prev_end = st.nend.get(s);
        i += 1;
    }
}

// --- Regions: memory malloc'd and freed in one block ------------------------------------
//
// A block that mallocs an array, uses it and frees it (in the same block,
// as a statement of its own) keeps that lifetime as a Fid region: the
// statements from the declaration to the free become `region r_<name> { }`,
// and the free a comment (the region's end frees what it allocated).
// Allocations whose lifetimes overlap share one region, like an arena.
// A variable declared inside and used after the free is declared before
// the region and assigned in it.

/// A local that holds a Vec malloc'd in its declaration and freed by name.
fn region_alloc_sym(st: &mut C2, s: i64) -> bool {
    if s < 0 || st.sy_kind.get(s) != SK_LOCAL || has_flag(st, s, U_STATIC) {
        return false;
    }
    val r: i64 = st.sy_repr.get(s);
    if r != R_VEC && r != R_BYTES {
        return false;
    }
    val init: i64 = st.sy_init.get(s);
    return init >= 0 && alloc_kind(st, init) > 0 && has_flag(st, s, U_FREED);
}

/// The statement in v[from..] that is `free(s);`, or -1.
fn free_index(st: &mut C2, v: Vec<i64>, from: i64, s: i64) -> i64 {
    var j: i64 = from;
    while j < v.len() {
        val x: i64 = v.get(j);
        if st.nk.get(x) == S_EXPR {
            val e: i64 = strip_casts(st, st.na.get(x));
            if e >= 0 && call_name(st, e) == "free" {
                val args: i64 = st.nlst.get(e);
                if list_len(st, args) == 1 {
                    val a: i64 = strip_casts(st, list_at(st, args, 0));
                    if st.nk.get(a) == E_IDENT && st.nsym.get(a) == s {
                        return j;
                    }
                }
            }
        }
        j += 1;
    }
    return -1;
}

/// References to `s` in v[from..].
fn refs_after(st: &mut C2, v: Vec<i64>, from: i64, s: i64) -> i64 {
    var c: i64 = 0;
    var j: i64 = from;
    while j < v.len() {
        c += count_refs(st, v.get(j), s);
        j += 1;
    }
    return c;
}

/// The regions of a block: pairs (first statement, last statement).
fn region_spans(st: &mut C2, v: Vec<i64>) -> Vec<i64> {
    var raw: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        val x: i64 = v.get(i);
        if st.nk.get(x) == S_DECL {
            val l: i64 = st.nlst.get(x);
            var d: i64 = 0;
            while d < list_len(st, l) {
                val sym: i64 = st.nsym.get(list_at(st, l, d));
                if region_alloc_sym(st, sym) {
                    val j: i64 = free_index(st, v, i + 1, sym);
                    // C may still name it after the free (p = NULL): no region then
                    if j > i && refs_after(st, v, j + 1, sym) == 0 {
                        raw.push(i);
                        raw.push(j);
                    }
                }
                d += 1;
            }
        }
        i += 1;
    }
    // overlapping lifetimes share one region
    var merged: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < raw.len() {
        val a: i64 = raw.get(k);
        val b: i64 = raw.get(k + 1);
        val n: i64 = merged.len();
        if n > 0 && a <= merged.get(n - 1) {
            if b > merged.get(n - 1) {
                merged.set(n - 1, b);
            }
        } else {
            merged.push(a);
            merged.push(b);
        }
        k += 2;
    }
    var out: Vec<i64> = Vec::new();
    k = 0;
    while k < merged.len() {
        val a: i64 = merged.get(k);
        val b: i64 = merged.get(k + 1);
        if region_span_ok(st, v, a, b) {
            out.push(a);
            out.push(b);
        }
        k += 2;
    }
    return out;
}

/// No case or goto label inside, and every variable declared in it and
/// used after it can be declared before it.
fn region_span_ok(st: &mut C2, v: Vec<i64>, a: i64, b: i64) -> bool {
    var j: i64 = a;
    while j <= b {
        val x: i64 = v.get(j);
        val k: i64 = st.nk.get(x);
        if k == S_CASE || k == S_DEFAULT || k == S_LABEL {
            return false;
        }
        if k == S_DECL {
            val l: i64 = st.nlst.get(x);
            var d: i64 = 0;
            while d < list_len(st, l) {
                val sym: i64 = st.nsym.get(list_at(st, l, d));
                if refs_after(st, v, b + 1, sym) > 0 {
                    if region_alloc_sym(st, sym) && free_index(st, v, j + 1, sym) >= 0 && free_index(st, v, j + 1, sym) <= b {
                        return false;
                    }
                    if has_flag(st, sym, U_STATIC) || region_zero(st, sym) == "" {
                        return false;
                    }
                }
                d += 1;
            }
        }
        j += 1;
    }
    return true;
}

/// The value a variable declared before its region starts with.
fn region_zero(st: &mut C2, s: i64) -> str {
    val r: i64 = st.sy_repr.get(s);
    if r == R_CUR {
        return "0";
    }
    if r == R_REF || r == R_VECREF || r == R_BYTESREF || r == R_PCUR {
        return "";
    }
    return zero_value(st, st.sy_ty.get(s), r);
}

/// v[a..=b] as `region r_<name> { ... }`.
fn emit_region(st: &mut C2, v: Vec<i64>, a: i64, b: i64, ind: i64) {
    // the arrays it frees, for the free comments
    var freed: Vec<i64> = Vec::new();
    var names: Vec<str> = Vec::new();
    var hoisted: Vec<i64> = Vec::new();
    var j: i64 = a;
    while j <= b {
        val x: i64 = v.get(j);
        if st.nk.get(x) == S_DECL {
            val l: i64 = st.nlst.get(x);
            var d: i64 = 0;
            while d < list_len(st, l) {
                val sym: i64 = st.nsym.get(list_at(st, l, d));
                if region_alloc_sym(st, sym) {
                    val fj: i64 = free_index(st, v, j + 1, sym);
                    if fj > j && fj <= b {
                        freed.push(sym);
                        names.push(st.sy_fid.get(sym));
                    }
                }
                if refs_after(st, v, b + 1, sym) > 0 {
                    hoisted.push(sym);
                }
                d += 1;
            }
        }
        j += 1;
    }
    var rname: str = "r_mem";
    if names.len() > 0 {
        rname = "r_" + names.get(0);
    }
    st.rg_n += 1;
    // declared before: used after the region
    var h: i64 = 0;
    while h < hoisted.len() {
        val s: i64 = hoisted.get(h);
        emit(st, ind, "var " + st.sy_fid.get(s) + ": " + sym_type(st, s) + " = " + region_zero(st, s) + ";");
        st.rg_hoist.push(s);
        h += 1;
    }
    var what: str = join_lines(names, ", ");
    if names.len() > 1 {
        emit(st, ind, "// " + what + ": malloc'd here and freed together (one region, like an arena)");
    } else {
        emit(st, ind, "// " + what + ": malloc'd here and freed at the end of this region");
    }
    emit(st, ind, "region " + rname + " {");
    val mark: i64 = st.rg_syms.len();
    h = 0;
    while h < freed.len() {
        st.rg_syms.push(freed.get(h));
        h += 1;
    }
    var prev_end: i64 = -1;
    j = a;
    while j <= b {
        val s: i64 = v.get(j);
        val first: i64 = st.nline.get(s) - comment_line_count(st.nlead.get(s));
        if prev_end >= 0 && first > prev_end + 1 && st.nk.get(s) != S_EMPTY {
            emit(st, 0, "");
        }
        emit_stmt(st, s, ind + 1);
        prev_end = st.nend.get(s);
        j += 1;
    }
    st.rg_syms.truncate(mark);
    emit(st, ind, "}");
}

fn vec_has_i64(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return true;
        }
        i += 1;
    }
    return false;
}

fn list_vec(st: &mut C2, l: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < list_len(st, l) {
        out.push(list_at(st, l, i));
        i += 1;
    }
    return out;
}

/// The statements a C body holds (one statement or a block's items).
fn body_vec(st: &mut C2, s: i64) -> Vec<i64> {
    if s >= 0 && st.nk.get(s) == S_BLOCK {
        return list_vec(st, st.nlst.get(s));
    }
    var out: Vec<i64> = Vec::new();
    if s >= 0 {
        out.push(s);
    }
    return out;
}

fn emit_body(st: &mut C2, s: i64, ind: i64) {
    if s >= 0 && st.nk.get(s) == S_BLOCK {
        emit_comments(st, ind, st.nlead.get(s));
    }
    val v: Vec<i64> = body_vec(st, s);
    emit_vec(st, v, ind);
}

fn emit_stmt(st: &mut C2, s: i64, ind: i64) {
    val k: i64 = st.nk.get(s);
    val lead: str = st.nlead.get(s);
    val trail: str = st.ntrail.get(s);
    if k != S_BLOCK {
        emit_comments(st, ind, lead);
    }
    if k == S_EMPTY {
        emit_comments(st, ind, trail);
        return;
    }
    if k == S_EXPR {
        st.allow_post = true;
        val code: str = stmt_code(st, st.na.get(s));
        st.allow_post = false;
        flush(st, ind);
        if code != "" {
            emit_code(st, ind, code, trail);
        }
        flush_post(st, ind);
        return;
    }
    if k == S_DECL {
        emit_decl(st, s, ind);
        emit_comments(st, ind, trail);
        return;
    }
    if k == S_BLOCK {
        emit_comments(st, ind, lead);
        emit(st, ind, "{");
        emit_body(st, s, ind + 1);
        emit(st, ind, "}");
        return;
    }
    if k == S_IF {
        emit_if(st, s, ind);
        return;
    }
    if k == S_WHILE {
        emit_while(st, s, ind);
        return;
    }
    if k == S_DO {
        emit_do(st, s, ind);
        return;
    }
    if k == S_FOR {
        emit_for(st, s, ind);
        return;
    }
    if k == S_SWITCH {
        emit_switch(st, s, ind);
        return;
    }
    if k == S_BREAK {
        if st.lp_kind.len() == 0 {
            note(st, "break outside a loop");
        }
        flush(st, ind);
        emit_code(st, ind, "break;", trail);
        return;
    }
    if k == S_CONTINUE {
        emit_continue(st, ind, trail);
        return;
    }
    if k == S_RETURN {
        emit_return(st, s, ind, trail);
        return;
    }
    if k == S_GOTO {
        st.todo_count += 1;
        emit_code(st, ind, "// TODO(c2fd): goto " + st.ntext.get(s) + "; (Fid has no goto: restructure this jump)", trail);
        return;
    }
    if k == S_LABEL {
        st.todo_count += 1;
        emit_code(st, ind, "// TODO(c2fd): label " + st.ntext.get(s) + ": (a goto target)", trail);
        return;
    }
    if k == S_CASE || k == S_DEFAULT {
        st.todo_count += 1;
        emit(st, ind, "// TODO(c2fd): a case label outside the statements of its switch");
        return;
    }
    if k == S_TODO {
        note(st, st.ntext.get(s));
        flush(st, ind);
        return;
    }
}

fn emit_return(st: &mut C2, s: i64, ind: i64, trail: str) {
    val e: i64 = st.na.get(s);
    if e < 0 {
        flush(st, ind);
        emit_code(st, ind, "return;", trail);
        return;
    }
    val v0: Ex = tx(st, e);
    val fs: i64 = st.cur_fn;
    var r: i64 = st.sy_ret.get(fs);
    val v: Ex = conv(st, v0, st.fn_ret, r);
    flush(st, ind);
    emit_code(st, ind, "return " + v.code + ";", trail);
}

fn emit_continue(st: &mut C2, ind: i64, trail: str) {
    var i: i64 = st.lp_kind.len() - 1;
    var through_switch: bool = false;
    while i >= 0 {
        val k: i64 = st.lp_kind.get(i);
        if k == 1 {
            break;
        }
        if k == 3 {
            through_switch = true;
        }
        i -= 1;
    }
    if through_switch {
        note(st, "continue inside a switch that became a loop: it restarts that loop, not the C loop");
    }
    flush(st, ind);
    if i >= 0 {
        val c: str = st.lp_cont.get(i);
        if c != "" {
            emit_text(st, ind, c);
        }
    }
    emit_code(st, ind, "continue;", trail);
}

fn is_true_const(st: &mut C2, e: i64) -> bool {
    if e < 0 {
        return true;
    }
    val k: i64 = st.nk.get(e);
    if k == E_INT {
        return parse_c_int(st.ntext.get(e)) != 0;
    }
    if k == E_BOOL {
        return st.ntext.get(e) == "true";
    }
    return false;
}

fn is_false_const(st: &mut C2, e: i64) -> bool {
    if e < 0 {
        return false;
    }
    val k: i64 = st.nk.get(e);
    if k == E_INT {
        return parse_c_int(st.ntext.get(e)) == 0;
    }
    if k == E_BOOL {
        return st.ntext.get(e) == "false";
    }
    return false;
}

fn emit_if(st: &mut C2, s: i64, ind: i64) {
    val c: Ex = tx_cond(st, st.na.get(s));
    flush(st, ind);
    emit_code(st, ind, "if " + c.code + " {", st.ntrail.get(s));
    emit_body(st, st.nb.get(s), ind + 1);
    var el: i64 = st.nc.get(s);
    var closes: i64 = 0;
    var depth: i64 = ind;
    while el >= 0 {
        if st.nk.get(el) == S_IF {
            val m: i64 = st.pre.len();
            val c2: Ex = tx_cond(st, st.na.get(el));
            if st.pre.len() > m || st.notes.len() > 0 {
                emit(st, depth, "} else {");
                depth += 1;
                closes += 1;
                emit_comments(st, depth, st.nlead.get(el));
                flush(st, depth);
                emit_code(st, depth, "if " + c2.code + " {", st.ntrail.get(el));
            } else {
                emit_comments(st, depth + 1, st.nlead.get(el));
                emit_code(st, depth, "} else if " + c2.code + " {", st.ntrail.get(el));
            }
            emit_body(st, st.nb.get(el), depth + 1);
            el = st.nc.get(el);
            continue;
        }
        emit(st, depth, "} else {");
        emit_body(st, el, depth + 1);
        break;
    }
    emit(st, depth, "}");
    while closes > 0 {
        depth -= 1;
        emit(st, depth, "}");
        closes -= 1;
    }
}

fn negate_code(c: Ex) -> str {
    return "!" + paren(c, P_UNARY);
}

fn emit_while(st: &mut C2, s: i64, ind: i64) {
    val cond: i64 = st.na.get(s);
    val body: i64 = st.nb.get(s);
    if is_true_const(st, cond) {
        emit_code(st, ind, "loop {", st.ntrail.get(s));
        st.lp_kind.push(1);
        st.lp_cont.push("");
        emit_body(st, body, ind + 1);
        st.lp_kind.pop();
        st.lp_cont.pop();
        emit(st, ind, "}");
        return;
    }
    val m: i64 = st.pre.len();
    val tmp0: i64 = st.tmp_n;
    val notes0: i64 = st.notes.len();
    val c: Ex = tx_cond(st, cond);
    if st.pre.len() == m {
        flush(st, ind);
        emit_code(st, ind, "while " + c.code + " {", st.ntrail.get(s));
        st.lp_kind.push(1);
        st.lp_cont.push("");
        emit_body(st, body, ind + 1);
        st.lp_kind.pop();
        st.lp_cont.pop();
        emit(st, ind, "}");
        return;
    }
    // the condition has statements of its own: they run before each test
    pre_take(st, m);
    st.tmp_n = tmp0;
    st.notes.truncate(notes0);
    val nc: Ex = neg_cond(st, cond);
    val pre: Vec<str> = pre_take(st, m);
    flush(st, ind);
    emit_code(st, ind, "loop {", st.ntrail.get(s));
    var i: i64 = 0;
    while i < pre.len() {
        emit_text(st, ind + 1, pre.get(i));
        i += 1;
    }
    emit(st, ind + 1, "if " + nc.code + " {");
    emit(st, ind + 2, "break;");
    emit(st, ind + 1, "}");
    st.lp_kind.push(1);
    st.lp_cont.push("");
    emit_body(st, body, ind + 1);
    st.lp_kind.pop();
    st.lp_cont.pop();
    emit(st, ind, "}");
}

fn emit_do(st: &mut C2, s: i64, ind: i64) {
    val cond: i64 = st.na.get(s);
    val body: i64 = st.nb.get(s);
    if is_false_const(st, cond) && !has_jump(st, body, true) {
        // do { ... } while (0): a block
        emit(st, ind, "{");
        emit_body(st, body, ind + 1);
        emit(st, ind, "}");
        return;
    }
    val m: i64 = st.pre.len();
    var check: str = "";
    if !is_true_const(st, cond) {
        val c: Ex = neg_cond(st, cond);
        val pre: Vec<str> = pre_take(st, m);
        var sb: StringBuilder = StringBuilder::new();
        var i: i64 = 0;
        while i < pre.len() {
            sb.append_str(pre.get(i) + "\n");
            i += 1;
        }
        sb.append_str("if " + c.code + " {\n    break;\n}");
        check = sb.to_str();
    }
    flush(st, ind);
    emit(st, ind, "loop {");
    st.lp_kind.push(1);
    st.lp_cont.push(check);
    emit_body(st, body, ind + 1);
    st.lp_kind.pop();
    st.lp_cont.pop();
    if check != "" {
        emit_text(st, ind + 1, check);
    }
    emit(st, ind, "}");
}

/// A break (or continue, with `cont`) that leaves `s` itself: not one
/// inside a nested loop (or switch, for break).
fn has_jump(st: &mut C2, s: i64, cont: bool) -> bool {
    if s < 0 {
        return false;
    }
    val k: i64 = st.nk.get(s);
    if k == S_BREAK {
        return true;
    }
    if k == S_CONTINUE {
        return cont;
    }
    if k == S_WHILE || k == S_DO || k == S_FOR {
        return false;
    }
    if k == S_SWITCH {
        if !cont {
            return false;
        }
        return has_jump(st, st.nb.get(s), cont);
    }
    if k == S_BLOCK {
        val l: i64 = st.nlst.get(s);
        var i: i64 = 0;
        while i < list_len(st, l) {
            if has_jump(st, list_at(st, l, i), cont) {
                return true;
            }
            i += 1;
        }
        return false;
    }
    if k == S_IF {
        return has_jump(st, st.nb.get(s), cont) || has_jump(st, st.nc.get(s), cont);
    }
    return false;
}

fn has_continue(st: &mut C2, s: i64) -> bool {
    if s < 0 {
        return false;
    }
    val k: i64 = st.nk.get(s);
    if k == S_CONTINUE {
        return true;
    }
    if k == S_WHILE || k == S_DO || k == S_FOR {
        return false;
    }
    if k == S_BLOCK {
        val l: i64 = st.nlst.get(s);
        var i: i64 = 0;
        while i < list_len(st, l) {
            if has_continue(st, list_at(st, l, i)) {
                return true;
            }
            i += 1;
        }
        return false;
    }
    if k == S_IF {
        return has_continue(st, st.nb.get(s)) || has_continue(st, st.nc.get(s));
    }
    if k == S_SWITCH {
        return has_continue(st, st.nb.get(s));
    }
    return false;
}

// --- Walking the AST ------------------------------------------------------------------------

fn children(st: &mut C2, n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if n < 0 {
        return out;
    }
    val k: i64 = st.nk.get(n);
    if k == E_SIZEOF_T || k == T_TODO || k == T_STRUCT || k == T_ENUM {
        return out;
    }
    val a: i64 = st.na.get(n);
    val b: i64 = st.nb.get(n);
    val c: i64 = st.nc.get(n);
    if a >= 0 { out.push(a); }
    if b >= 0 { out.push(b); }
    if c >= 0 { out.push(c); }
    if k == S_FOR {
        val d: i64 = st.nd.get(n);
        if d >= 0 { out.push(d); }
    }
    if k == E_CALL || k == E_INIT || k == S_BLOCK || k == S_DECL {
        val l: i64 = st.nlst.get(n);
        var i: i64 = 0;
        while i < list_len(st, l) {
            out.push(list_at(st, l, i));
            i += 1;
        }
    }
    return out;
}

fn count_refs(st: &mut C2, n: i64, sym: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    var c: i64 = 0;
    if st.nk.get(n) == E_IDENT && st.nsym.get(n) == sym {
        c = 1;
    }
    val ch: Vec<i64> = children(st, n);
    var i: i64 = 0;
    while i < ch.len() {
        c += count_refs(st, ch.get(i), sym);
        i += 1;
    }
    return c;
}

/// Whether `n` may change variable `sym` (assignment, ++/--, &sym).
fn modifies(st: &mut C2, n: i64, sym: i64) -> bool {
    if n < 0 {
        return false;
    }
    val k: i64 = st.nk.get(n);
    if k == E_ASSIGN || k == E_PREINC || k == E_PREDEC || k == E_POSTINC || k == E_POSTDEC {
        val r: i64 = root_var(st, st.na.get(n));
        if r == sym {
            return true;
        }
    }
    if k == E_UNARY && st.ntext.get(n) == "&" {
        val r: i64 = root_var(st, st.na.get(n));
        if r == sym {
            return true;
        }
    }
    if k == D_VAR && st.nsym.get(n) == sym {
        return true;
    }
    val ch: Vec<i64> = children(st, n);
    var i: i64 = 0;
    while i < ch.len() {
        if modifies(st, ch.get(i), sym) {
            return true;
        }
        i += 1;
    }
    return false;
}

/// An expression without side effects whose variables `body` leaves alone.
fn stable_in(st: &mut C2, e: i64, body: i64) -> bool {
    if e < 0 {
        return true;
    }
    val k: i64 = st.nk.get(e);
    if k == E_ASSIGN || k == E_PREINC || k == E_PREDEC || k == E_POSTINC || k == E_POSTDEC {
        return false;
    }
    if k == E_CALL {
        if st.ntext.get(e) != "strlen" {
            return false;
        }
    }
    if k == E_IDENT {
        val s: i64 = st.nsym.get(e);
        if s >= 0 {
            val sk: i64 = st.sy_kind.get(s);
            if sk == SK_GLOBAL {
                // a call in the body could change a global
                return false;
            }
            if modifies(st, body, s) {
                return false;
            }
            // a pointer's target may change through another name
            if st.sy_repr.get(s) == R_REF || st.sy_repr.get(s) == R_RAW || st.sy_repr.get(s) == R_BYTESREF {
                return false;
            }
        }
    }
    if k == E_MEMBER || k == E_INDEX || (k == E_UNARY && st.ntext.get(e) == "*") {
        return false;
    }
    val ch: Vec<i64> = children(st, e);
    var i: i64 = 0;
    while i < ch.len() {
        if !stable_in(st, ch.get(i), body) {
            return false;
        }
        i += 1;
    }
    return true;
}

struct CountLoop {
    ok: bool,
    sym: i64,
    start: i64,
    bound: i64,
    inclusive: bool,
}

fn no_count() -> CountLoop {
    return CountLoop { ok: false, sym: -1, start: -1, bound: -1, inclusive: false };
}

/// `for (i = a; i < b; i++)` with `i` and `b` left alone by the body.
fn counting_loop(st: &mut C2, s: i64) -> CountLoop {
    val init: i64 = st.na.get(s);
    val cond: i64 = st.nb.get(s);
    val step: i64 = st.nc.get(s);
    val body: i64 = st.nd.get(s);
    if init < 0 || cond < 0 || step < 0 {
        return no_count();
    }
    var sym: i64 = -1;
    var start: i64 = -1;
    if st.nk.get(init) == S_DECL {
        val l: i64 = st.nlst.get(init);
        if list_len(st, l) != 1 {
            return no_count();
        }
        val d: i64 = list_at(st, l, 0);
        sym = st.nsym.get(d);
        start = st.na.get(d);
    } else if st.nk.get(init) == S_EXPR {
        val e: i64 = st.na.get(init);
        if st.nk.get(e) != E_ASSIGN || st.ntext.get(e) != "=" || st.nk.get(st.na.get(e)) != E_IDENT {
            return no_count();
        }
        sym = st.nsym.get(st.na.get(e));
        start = st.nb.get(e);
        if sym < 0 || st.sy_kind.get(sym) != SK_LOCAL {
            return no_count();
        }
        // the variable must not be used outside the loop
        val total: i64 = count_refs(st, st.cur_body, sym);
        val inside: i64 = count_refs(st, s, sym);
        if total != inside {
            return no_count();
        }
    } else {
        return no_count();
    }
    if sym < 0 || start < 0 {
        return no_count();
    }
    val t: i64 = st.sy_ty.get(sym);
    if !is_int(st, t) || has_flag(st, sym, U_ADDR) {
        return no_count();
    }
    if st.nk.get(cond) != E_BIN || st.nk.get(st.na.get(cond)) != E_IDENT || st.nsym.get(st.na.get(cond)) != sym {
        return no_count();
    }
    val op: str = st.ntext.get(cond);
    if op != "<" && op != "<=" {
        return no_count();
    }
    val bound: i64 = st.nb.get(cond);
    val sk: i64 = st.nk.get(step);
    var step_ok: bool = false;
    if (sk == E_POSTINC || sk == E_PREINC) && st.nk.get(st.na.get(step)) == E_IDENT && st.nsym.get(st.na.get(step)) == sym {
        step_ok = true;
    }
    if sk == E_ASSIGN && st.ntext.get(step) == "+=" && st.nk.get(st.na.get(step)) == E_IDENT && st.nsym.get(st.na.get(step)) == sym && st.nk.get(st.nb.get(step)) == E_INT && st.ntext.get(st.nb.get(step)) == "1" {
        step_ok = true;
    }
    if !step_ok {
        return no_count();
    }
    if modifies(st, body, sym) {
        return no_count();
    }
    if !stable_in(st, bound, body) {
        return no_count();
    }
    // the loop variable takes the range's type: keep both the same
    val bt: i64 = st.nty.get(bound);
    if fid_base(st, bt) != fid_base(st, t) && !(st.nk.get(bound) == E_INT) {
        return no_count();
    }
    return CountLoop { ok: true, sym: sym, start: start, bound: bound, inclusive: op == "<=" };
}

fn emit_for(st: &mut C2, s: i64, ind: i64) {
    val init: i64 = st.na.get(s);
    val cond: i64 = st.nb.get(s);
    val step: i64 = st.nc.get(s);
    val body: i64 = st.nd.get(s);
    val cl: CountLoop = counting_loop(st, s);
    if cl.ok {
        val a0: Ex = tx(st, cl.start);
        val t: i64 = st.sy_ty.get(cl.sym);
        val a: Ex = conv(st, a0, t, R_VAL);
        val b0: Ex = tx(st, cl.bound);
        val b: Ex = conv(st, b0, t, R_VAL);
        var range: str = "..";
        if cl.inclusive {
            range = "..=";
        }
        flush(st, ind);
        val name: str = st.sy_fid.get(cl.sym);
        emit_code(st, ind, "for " + name + " in " + paren(a, P_OR + 1) + range + paren(b, P_OR + 1) + " {", st.ntrail.get(s));
        st.lp_kind.push(1);
        st.lp_cont.push("");
        emit_body(st, body, ind + 1);
        st.lp_kind.pop();
        st.lp_cont.pop();
        emit(st, ind, "}");
        return;
    }
    // the general form: init; while cond { body; step }
    if init >= 0 {
        emit_stmt(st, init, ind);
    }
    var stepc: str = "";
    if step >= 0 {
        val m: i64 = st.pre.len();
        val sc: str = stmt_code(st, step);
        val sp: Vec<str> = pre_take(st, m);
        var sb: StringBuilder = StringBuilder::new();
        var i: i64 = 0;
        while i < sp.len() {
            sb.append_str(sp.get(i) + "\n");
            i += 1;
        }
        sb.append_str(sc);
        stepc = sb.to_str();
        if st.notes.len() > 0 {
            flush(st, ind);
        }
    }
    val m: i64 = st.pre.len();
    var header: str = "loop {";
    var check: str = "";
    if cond >= 0 && !is_true_const(st, cond) {
        val tmp0: i64 = st.tmp_n;
        val notes0: i64 = st.notes.len();
        val c: Ex = tx_cond(st, cond);
        if st.pre.len() == m {
            header = "while " + c.code + " {";
        } else {
            pre_take(st, m);
            st.tmp_n = tmp0;
            st.notes.truncate(notes0);
            val nc: Ex = neg_cond(st, cond);
            val pre: Vec<str> = pre_take(st, m);
            var sb: StringBuilder = StringBuilder::new();
            var i: i64 = 0;
            while i < pre.len() {
                sb.append_str(pre.get(i) + "\n");
                i += 1;
            }
            sb.append_str("if " + nc.code + " {\n    break;\n}");
            check = sb.to_str();
        }
    }
    flush(st, ind);
    emit_code(st, ind, header, st.ntrail.get(s));
    if check != "" {
        emit_text(st, ind + 1, check);
    }
    st.lp_kind.push(1);
    st.lp_cont.push(stepc);
    emit_body(st, body, ind + 1);
    st.lp_kind.pop();
    st.lp_cont.pop();
    if stepc != "" {
        emit_text(st, ind + 1, stepc);
    }
    emit(st, ind, "}");
}

// --- switch -----------------------------------------------------------------------------------

fn leaves(st: &mut C2, s: i64) -> bool {
    if s < 0 {
        return false;
    }
    val k: i64 = st.nk.get(s);
    if k == S_BREAK || k == S_CONTINUE || k == S_RETURN || k == S_GOTO {
        return true;
    }
    return always_leaves(st, s);
}

/// Whether control never reaches the end of `s`.
fn always_leaves(st: &mut C2, s: i64) -> bool {
    if s < 0 {
        return false;
    }
    val k: i64 = st.nk.get(s);
    if k == S_RETURN {
        return true;
    }
    if k == S_EXPR {
        val n: str = call_name(st, st.na.get(s));
        return n == "exit" || n == "abort";
    }
    if k == S_BLOCK {
        val v: Vec<i64> = body_vec(st, s);
        var i: i64 = v.len() - 1;
        while i >= 0 && st.nk.get(v.get(i)) == S_EMPTY {
            i -= 1;
        }
        if i < 0 {
            return false;
        }
        return always_leaves(st, v.get(i));
    }
    if k == S_IF {
        return st.nc.get(s) >= 0 && always_leaves(st, st.nb.get(s)) && always_leaves(st, st.nc.get(s));
    }
    if k == S_WHILE {
        return is_true_const(st, st.na.get(s)) && !has_jump(st, st.nb.get(s), false);
    }
    if k == S_FOR {
        return st.nb.get(s) < 0 && !has_jump(st, st.nd.get(s), false);
    }
    if k == S_SWITCH {
        val sw: SwitchGroups = switch_groups(st, s);
        if !sw.has_default {
            return false;
        }
        var g: i64 = 0;
        while g < sw.stmts.len() {
            val eff: Vec<i64> = effective(st, sw, g);
            if eff.len() == 0 {
                return false;
            }
            val last: i64 = eff.get(eff.len() - 1);
            if !always_leaves(st, last) {
                return false;
            }
            g += 1;
        }
        return true;
    }
    return false;
}

struct SwitchGroups {
    labels: Vec<Vec<i64>>,
    stmts: Vec<Vec<i64>>,
    is_default: Vec<bool>,
    before: Vec<i64>,
    has_default: bool,
}

fn switch_groups(st: &mut C2, s: i64) -> SwitchGroups {
    var sw: SwitchGroups = SwitchGroups { labels: Vec::new(), stmts: Vec::new(), is_default: Vec::new(), before: Vec::new(), has_default: false };
    val items: Vec<i64> = body_vec(st, st.nb.get(s));
    var cur_labels: Vec<i64> = Vec::new();
    var cur_stmts: Vec<i64> = Vec::new();
    var cur_def: bool = false;
    var open: bool = false;
    var i: i64 = 0;
    while i < items.len() {
        val it: i64 = items.get(i);
        val k: i64 = st.nk.get(it);
        if k == S_CASE || k == S_DEFAULT {
            if open && cur_stmts.len() > 0 {
                sw.labels.push(cur_labels);
                sw.stmts.push(cur_stmts);
                sw.is_default.push(cur_def);
                cur_labels = Vec::new();
                cur_stmts = Vec::new();
                cur_def = false;
            }
            open = true;
            if k == S_DEFAULT {
                cur_def = true;
                sw.has_default = true;
            } else {
                cur_labels.push(it);
            }
        } else if !open {
            sw.before.push(it);
        } else {
            cur_stmts.push(it);
        }
        i += 1;
    }
    if open {
        sw.labels.push(cur_labels);
        sw.stmts.push(cur_stmts);
        sw.is_default.push(cur_def);
    }
    return sw;
}

/// The statements group `g` runs: its own, then the groups it falls into.
fn effective(st: &mut C2, sw: SwitchGroups, g: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var k: i64 = g;
    while k < sw.stmts.len() {
        val v: Vec<i64> = sw.stmts.get(k);
        var i: i64 = 0;
        var last: i64 = -1;
        while i < v.len() {
            out.push(v.get(i));
            if st.nk.get(v.get(i)) != S_EMPTY {
                last = v.get(i);
            }
            i += 1;
        }
        if last >= 0 && leaves(st, last) {
            break;
        }
        k += 1;
    }
    // the closing break belongs to the switch
    var j: i64 = out.len() - 1;
    while j >= 0 && st.nk.get(out.get(j)) == S_EMPTY {
        j -= 1;
    }
    if j >= 0 && st.nk.get(out.get(j)) == S_BREAK {
        var trimmed: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < out.len() {
            if i != j {
                trimmed.push(out.get(i));
            }
            i += 1;
        }
        return trimmed;
    }
    return out;
}

fn emit_switch(st: &mut C2, s: i64, ind: i64) {
    val sw: SwitchGroups = switch_groups(st, s);
    val e: i64 = st.na.get(s);
    val m: i64 = st.pre.len();
    val v0: Ex = tx(st, e);
    var v: Ex = v0;
    val ek: i64 = st.nk.get(e);
    if st.pre.len() > m || !(ek == E_IDENT || ek == E_MEMBER) {
        val tmp: str = new_tmp(st);
        val ft: str = fid_val_type(st, st.nty.get(e));
        pre_add(st, "val " + tmp + ": " + ft + " = " + v0.code + ";");
        v = ex(tmp, P_PRIM, v0.ty, v0.repr);
    }
    flush(st, ind);
    emit_comments(st, ind, st.ntrail.get(s));
    if sw.before.len() > 0 {
        note(st, "statements before the first case label of a switch never run in C");
        flush(st, ind);
        var i: i64 = 0;
        while i < sw.before.len() {
            val b: i64 = sw.before.get(i);
            emit(st, ind, "// (skipped) line " + int_to_str(st.nline.get(b)));
            i += 1;
        }
    }
    // the groups' statements, and whether a break inside needs a loop to leave
    var effs: Vec<Vec<i64>> = Vec::new();
    var wrap: bool = false;
    var g: i64 = 0;
    while g < sw.stmts.len() {
        val eff: Vec<i64> = effective(st, sw, g);
        var i: i64 = 0;
        while i < eff.len() {
            if has_jump(st, eff.get(i), false) {
                wrap = true;
            }
            i += 1;
        }
        effs.push(eff);
        g += 1;
    }
    var ci: i64 = ind;
    if wrap {
        emit(st, ind, "loop {");
        ci = ind + 1;
        st.lp_kind.push(3);
    } else {
        st.lp_kind.push(2);
    }
    st.lp_cont.push("");
    var first: bool = true;
    var def: i64 = -1;
    g = 0;
    while g < sw.stmts.len() {
        if sw.is_default.get(g) {
            def = g;
            g += 1;
            continue;
        }
        val labels: Vec<i64> = sw.labels.get(g);
        var conds: Vec<str> = Vec::new();
        var i: i64 = 0;
        while i < labels.len() {
            val lab: i64 = labels.get(i);
            val lv0: Ex = tx(st, st.na.get(lab));
            val hi: i64 = st.nb.get(lab);
            if hi >= 0 {
                val hv: Ex = tx(st, hi);
                conds.push("(" + paren(v, P_CMP + 1) + " >= " + paren(lv0, P_CMP + 1) + " && " + paren(v, P_CMP + 1) + " <= " + paren(hv, P_CMP + 1) + ")");
            } else {
                conds.push(paren(v, P_EQ + 1) + " == " + paren(lv0, P_EQ + 1));
            }
            i += 1;
        }
        val cc: str = join_lines(conds, " || ");
        if first {
            emit(st, ci, "if " + cc + " {");
            first = false;
        } else {
            emit(st, ci, "} else if " + cc + " {");
        }
        val falls: bool = effs.get(g).len() > sw.stmts.get(g).len();
        if falls {
            emit(st, ci + 1, "// c2fd: falls through to the next case (its statements are repeated here)");
        }
        emit_vec(st, effs.get(g), ci + 1);
        g += 1;
    }
    if def >= 0 {
        val dv: Vec<i64> = effs.get(def);
        if first {
            if dv.len() > 0 {
                emit(st, ci, "{");
                emit_vec(st, dv, ci + 1);
                emit(st, ci, "}");
            }
        } else if dv.len() > 0 {
            emit(st, ci, "} else {");
            emit_vec(st, dv, ci + 1);
            emit(st, ci, "}");
        } else {
            emit(st, ci, "}");
        }
    } else if !first {
        emit(st, ci, "}");
    }
    st.lp_kind.pop();
    st.lp_cont.pop();
    if wrap {
        emit(st, ci, "break;");
        emit(st, ind, "}");
    }
}

// --- Declarations ------------------------------------------------------------------------

fn needs_var(st: &mut C2, s: i64) -> bool {
    if st.sy_repr.get(s) == R_FILE {
        return true;
    }
    return has_flag(st, s, U_MOD | U_ADDR | U_ELEM_WRITE | U_ARITH | U_ASSIGNED) || st.sy_assigns.get(s) > 0;
}

/// The value a declaration starts with, and the statements that finish it
/// (for initializer lists): element 0 is the value.
fn decl_value(st: &mut C2, s: i64, name: str) -> Vec<str> {
    val t: i64 = st.sy_ty.get(s);
    val r: i64 = st.sy_repr.get(s);
    val init: i64 = st.sy_init.get(s);
    var out: Vec<str> = Vec::new();
    if r == R_CUR {
        // a pointer into an array: the index it starts at
        if init >= 0 && cur_able(st, init) {
            val c: Cur = cur_of(st, init);
            out.push(c.off);
            return out;
        }
        out.push("0");
        return out;
    }
    if init < 0 {
        val z: str = zero_value(st, t, r);
        if z != "" {
            out.push(z);
            return out;
        }
        if r == R_VEC && is_array(st, t) {
            val e: i64 = elem(st, t);
            val er: i64 = repr_of_type(st, e);
            val ze: str = zero_value(st, e, er);
            val lv: Ex = tx(st, st.ylen.get(t));
            out.push("Vec::new()");
            if ze == "" {
                note(st, "an array of " + fid_elem_type(st, e) + " without values: Fid has no zero value for it, push the elements before use");
                return out;
            }
            out.push("for _i in 0.." + paren(lv, P_OR + 1) + " {\n    " + name + ".push(" + ze + ");\n}");
            return out;
        }
        if is_func_ptr(st, t) {
            note(st, "a function pointer without a value: Fid has no null function");
        } else {
            note(st, "a pointer declared without a value");
        }
        out.push("0");
        return out;
    }
    if st.nk.get(init) == E_INIT && (r == R_VEC || r == R_BYTES || is_array(st, t)) {
        return init_list(st, t, r, init, name);
    }
    if st.nk.get(init) == E_INIT {
        out.push(init_value(st, t, r, init));
        return out;
    }
    if alloc_kind(st, init) > 0 {
        out.push(alloc_code(st, t, r, init, name));
        return out;
    }
    if r == R_REF {
        val x: i64 = strip_casts(st, init);
        if st.nk.get(x) == E_UNARY && st.ntext.get(x) == "&" {
            val e: i64 = elem(st, t);
            val v: Ex = tx_addr(st, st.na.get(x), is_const(st, e));
            out.push(v.code);
            return out;
        }
    }
    val v0: Ex = tx(st, init);
    val v: Ex = conv(st, v0, t, r);
    out.push(v.code);
    return out;
}

/// An array from an initializer list: Vec::new() and pushes.
fn init_list(st: &mut C2, t: i64, r: i64, init: i64, name: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    val e: i64 = elem(st, t);
    val er: i64 = repr_of_type(st, e);
    val l: i64 = st.nlst.get(init);
    val n: i64 = list_len(st, l);
    var ln: i64 = -1;
    if is_array(st, t) {
        ln = st.ylen.get(t);
    }
    var lcode: str = "";
    if ln >= 0 {
        val lv: Ex = tx(st, ln);
        lcode = lv.code;
    }
    var z: str = "0";
    if is_arith(st, e) || er == R_STR {
        z = zero_value(st, e, er);
    }
    // {0} with a size: all zero
    if n == 1 && ln >= 0 && is_null_lit(st, list_at(st, l, 0)) && (is_arith(st, e) || r == R_BYTES) {
        out.push("Vec::filled(" + lcode + ", " + z + ")");
        return out;
    }
    out.push("Vec::new()");
    var codes: Vec<str> = Vec::new();
    var simple: bool = is_int(st, e) && fid_base(st, e) == "i64" && r != R_BYTES;
    var i: i64 = 0;
    while i < n {
        val it: i64 = list_at(st, l, i);
        val m: i64 = st.pre.len();
        var code: str = "";
        if r == R_BYTES || is_charlike(st, e) {
            val v0: Ex = tx(st, it);
            val v: Ex = conv(st, v0, st.t_int, R_VAL);
            code = v.code;
        } else {
            code = init_value(st, e, er, it);
        }
        if st.pre.len() > m || st.nk.get(it) == E_INIT {
            simple = false;
        }
        codes.push(code);
        i += 1;
    }
    if simple && n > 1 {
        out.push("for x in [" + join_lines(codes, ", ") + "] {\n    " + name + ".push(x);\n}");
    } else {
        i = 0;
        while i < codes.len() {
            out.push(name + ".push(" + codes.get(i) + ");");
            i += 1;
        }
    }
    if ln >= 0 && !(const_ok(st, ln) && const_val(st, ln) <= n) {
        out.push("while " + name + ".len() < " + lcode + " {\n    " + name + ".push(" + z + ");\n}");
    }
    return out;
}

fn emit_decl(st: &mut C2, s: i64, ind: i64) {
    val l: i64 = st.nlst.get(s);
    var i: i64 = 0;
    while i < list_len(st, l) {
        val dn: i64 = list_at(st, l, i);
        val sym: i64 = st.nsym.get(dn);
        val name: str = st.sy_fid.get(sym);
        val ft: str = sym_type(st, sym);
        if has_flag(st, sym, U_STATIC) {
            val vals: Vec<str> = decl_value(st, sym, name);
            if st.pre.len() > 0 || vals.len() > 1 {
                note(st, "the static " + st.sy_name.get(sym) + " needs statements to start: they run at each call here");
            }
            flush(st, ind);
            st.fn_globals.push("// static in " + st.fn_name);
            st.fn_globals.push("var " + name + ": " + ft + " = " + vals.get(0) + ";");
            var j: i64 = 1;
            while j < vals.len() {
                emit_text(st, ind, vals.get(j));
                j += 1;
            }
            i += 1;
            continue;
        }
        st.allow_post = false;
        val vals: Vec<str> = decl_value(st, sym, name);
        flush(st, ind);
        var kw: str = "val";
        if needs_var(st, sym) || vals.len() > 1 {
            kw = "var";
        }
        if vec_has_i64(st.rg_hoist, sym) {
            // declared before its region (it is used after it)
            emit(st, ind, name + " = " + vals.get(0) + ";");
        } else {
            emit(st, ind, kw + " " + name + ": " + ft + " = " + vals.get(0) + ";");
        }
        var j: i64 = 1;
        while j < vals.len() {
            emit_text(st, ind, vals.get(j));
            j += 1;
        }
        i += 1;
    }
}

// --- Emission: functions and top-level items ------------------------------------------------

/// The line emit_function leaves before a function's signature, followed by
/// the function's symbol; translate turns it into "@unsafe" or drops it.
const C2_RAW_MARK: str = "@c2fd-raw-check ";

/// M10: a function that calls an @unsafe translated function (one that
/// does raw memory, or calls one) is @unsafe too, so its calls need no
/// `unsafe` block. Grows st.raw_fns to the fixpoint over st.call_from/to.
fn raw_close(st: &mut C2) {
    var changed: bool = true;
    while changed {
        changed = false;
        var i: i64 = 0;
        while i < st.call_from.len() {
            val from: i64 = st.call_from.get(i);
            if !vec_has_i64(st.raw_fns, from) && vec_has_i64(st.raw_fns, st.call_to.get(i)) {
                st.raw_fns.push(from);
                changed = true;
            }
            i += 1;
        }
    }
}

fn emit_function(st: &mut C2, node: i64) {
    val fs: i64 = st.nsym.get(node);
    val fty: i64 = st.nty.get(node);
    val body: i64 = st.na.get(node);
    st.tmp_n = 0;
    st.fn_raw = false;
    st.fn_wrap = false;
    st.fn_globals.clear();
    st.lp_kind.clear();
    st.lp_cont.clear();
    st.pre.clear();
    st.notes.clear();
    st.post.clear();
    st.cur_fn = fs;
    st.cur_body = body;
    val cname: str = st.sy_name.get(fs);
    st.fn_name = cname;
    st.fn_ret = elem(st, fty);
    val is_main: bool = cname == "main";
    val start: i64 = st.lines.len();
    val pl: i64 = st.sy_params.get(fs);
    val np: i64 = list_len(st, pl);
    var params: Vec<str> = Vec::new();
    if is_main && np >= 1 {
        use_h(st, "c_args");
        var argv: str = "_args";
        if np >= 2 {
            val av: i64 = list_at(st, pl, 1);
            argv = st.sy_fid.get(av);
            st.sy_repr.set(av, R_VEC);
        }
        emit(st, 1, "// argv: the program's arguments (c_args)");
        emit(st, 1, "val " + argv + ": Vec<str> = c_args();");
        val ac: i64 = list_at(st, pl, 0);
        var kw: str = "val";
        if needs_var(st, ac) {
            kw = "var";
        }
        emit(st, 1, kw + " " + st.sy_fid.get(ac) + ": i64 = " + argv + ".len();");
    } else if !is_main {
        var i: i64 = 0;
        while i < np {
            val p: i64 = list_at(st, pl, i);
            val pt: str = sym_type(st, p);
            params.push(st.sy_fid.get(p) + ": " + pt);
            if st.sy_repr.get(p) == R_PCUR {
                // the index the pointer is at in its array
                if st.sy_cext.get(p) {
                    params.push(st.sy_fid.get(p) + "_at: i64");
                } else {
                    emit(st, 1, "var " + st.sy_fid.get(p) + "_at: i64 = 0;");
                }
            }
            if st.sy_repr.get(p) == R_VAL && is_struct(st, st.sy_ty.get(p)) && has_flag(st, p, U_MOD) {
                // C changes its own copy of the struct
                emit(st, 1, "var " + st.sy_fid.get(p) + ": " + pt + " = " + st.sy_fid.get(p) + ";");
            }
            i += 1;
        }
    }
    emit_body(st, body, 1);
    val rt: i64 = st.fn_ret;
    val void_ret: bool = rt >= 0 && st.yk.get(rt) == Y_VOID;
    if !void_ret && !always_leaves(st, body) {
        if is_main {
            emit(st, 1, "return 0;");
        } else {
            val r: i64 = st.sy_ret.get(fs);
            var z: str = zero_value(st, rt, r);
            if z == "" {
                z = "0";
            }
            st.todo_count += 1;
            emit(st, 1, "// TODO(c2fd): C can reach the end of " + cname + " without a return value");
            emit(st, 1, "return " + z + ";");
        }
    }
    emit(st, 0, "}");
    var header: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < st.fn_globals.len() {
        header.push(st.fn_globals.get(i));
        i += 1;
    }
    if st.fn_globals.len() > 0 {
        header.push("");
    }
    val lead: str = st.nlead.get(node);
    if lead != "" {
        val cl: Vec<str> = split_nl(lead);
        i = 0;
        while i < cl.len() {
            header.push(cl.get(i));
            i += 1;
        }
    }
    if st.fn_raw {
        st.raw_fns.push(fs);
    }
    // "@unsafe" or nothing, decided by raw_close once every function is
    // translated (a callee can come after its caller)
    header.push(C2_RAW_MARK + int_to_str(fs));
    if st.fn_wrap {
        header.push("@wrapping");
    }
    var sig: str = "";
    if is_main {
        sig = "fn main() -> i64 {";
    } else {
        sig = "fn " + st.sy_fid.get(fs) + "(" + join_lines(params, ", ") + ")";
        if !void_ret {
            val r: i64 = st.sy_ret.get(fs);
            sig = sig + " -> " + fid_type(st, rt, r, SK_LOCAL);
        }
        sig = sig + " {";
    }
    header.push(sig);
    i = 0;
    while i < header.len() {
        st.lines.insert(start + i, header.get(i));
        i += 1;
    }
    st.cur_fn = -1;
}

fn emit_struct(st: &mut C2, node: i64) {
    val sdi: i64 = st.nd.get(node);
    val name: str = struct_fid(st, sdi);
    emit_comments(st, 0, st.nlead.get(node));
    if st.sd_union.get(sdi) {
        st.todo_count += 1;
        emit(st, 0, "// TODO(c2fd): the union " + name + " became a struct: its fields no longer share memory");
    }
    val nl: i64 = st.nlst.get(node);
    var i: i64 = 0;
    while i < list_len(st, nl) {
        st.todo_count += 1;
        emit(st, 0, "// TODO(c2fd): " + st.ntext.get(list_at(st, nl, i)));
        i += 1;
    }
    emit(st, 0, "struct " + name + " {");
    val fl: i64 = st.sd_fields.get(sdi);
    i = 0;
    while i < list_len(st, fl) {
        val f: i64 = list_at(st, fl, i);
        val cn: i64 = st.sy_init.get(f);
        if cn >= 0 {
            emit_comments(st, 1, st.nlead.get(cn));
        }
        val ft: str = sym_type(st, f);
        var line: str = safe_name(st, st.sy_name.get(f)) + ": " + ft + ",";
        if cn >= 0 && st.ntrail.get(cn) != "" && !str_contains(st.ntrail.get(cn), "\n") {
            line = line + "  " + st.ntrail.get(cn);
        }
        emit(st, 1, line);
        i += 1;
    }
    emit(st, 0, "}");
}

fn emit_enum(st: &mut C2, node: i64) {
    val t: i64 = st.nty.get(node);
    emit_comments(st, 0, st.nlead.get(node));
    val alias: str = st.yalias.get(t);
    var tn: str = "i64";
    if alias != "" {
        tn = safe_type_name(st, alias);
        emit(st, 0, "// enum " + alias + ": C enum values are integers, so they stay constants");
        emit(st, 0, "type " + tn + " = i64;");
    }
    val l: i64 = st.nlst.get(node);
    var i: i64 = 0;
    while i < list_len(st, l) {
        val s: i64 = list_at(st, l, i);
        val cn: i64 = st.sy_owner.get(s);
        if cn >= 0 {
            emit_comments(st, 0, st.nlead.get(cn));
        }
        var v: str = int_to_str(st.sy_val.get(s));
        if has_flag(st, s, U_ASSIGNED) {
            val ve: Ex = tx(st, st.sy_init.get(s));
            v = ve.code;
        }
        var line: str = "const " + st.sy_fid.get(s) + ": " + tn + " = " + v + ";";
        if cn >= 0 && st.ntrail.get(cn) != "" && !str_contains(st.ntrail.get(cn), "\n") {
            line = line + "  " + st.ntrail.get(cn);
        }
        emit(st, 0, line);
        i += 1;
    }
    flush(st, 0);
}

fn emit_macro(st: &mut C2, node: i64) {
    val m: i64 = st.nd.get(node);
    emit_comments(st, 0, st.nlead.get(node));
    if m < 0 {
        return;
    }
    val name: str = st.mac_name.get(m);
    val trail: str = st.ntrail.get(node);
    if st.mac_const.get(m) {
        val e: i64 = st.na.get(node);
        val v: Ex = tx(st, e);
        var ty: str = fid_val_type(st, v.ty);
        if v.repr == R_STR {
            ty = "str";
        }
        if is_bool(st, v.ty) {
            ty = "bool";
        }
        flush(st, 0);
        emit_code(st, 0, "const " + safe_name(st, name) + ": " + ty + " = " + v.code + ";", trail);
        return;
    }
    var line: str = "// c2fd: #define " + st.mac_text.get(m) + "  (expanded where it is used)";
    if st.mac_blen.get(m) == 0 {
        line = "// c2fd: #define " + st.mac_text.get(m) + "  (defined empty: dropped where it is used)";
    }
    emit_code(st, 0, line, trail);
}

fn emit_typedef(st: &mut C2, node: i64) {
    emit_comments(st, 0, st.nlead.get(node));
    val t: i64 = st.nty.get(node);
    val name: str = safe_type_name(st, st.ntext.get(node));
    var ft: str = fid_val_type(st, t);
    if is_func_ptr(st, t) {
        ft = fid_elem_type(st, t);
    }
    emit_code(st, 0, "type " + name + " = " + ft + ";", st.ntrail.get(node));
}

fn emit_gvar(st: &mut C2, node: i64) {
    val s: i64 = st.nsym.get(node);
    val t: i64 = st.sy_ty.get(s);
    val r: i64 = st.sy_repr.get(s);
    val init: i64 = st.sy_init.get(s);
    val name: str = st.sy_fid.get(s);
    val ft: str = sym_type(st, s);
    emit_comments(st, 0, st.nlead.get(node));
    st.pre.clear();
    st.notes.clear();
    val vals: Vec<str> = decl_value(st, s, "v");
    if st.pre.len() > 0 || vals.len() > 1 {
        // statements are needed: an initializing function
        val fname: str = "init_" + name;
        if st.lines.len() > 0 && st.lines.get(st.lines.len() - 1) != "" {
            emit(st, 0, "");
        }
        emit(st, 0, "fn " + fname + "() -> " + ft + " {");
        flush(st, 1);
        emit(st, 1, "var v: " + ft + " = " + vals.get(0) + ";");
        var j: i64 = 1;
        while j < vals.len() {
            emit_text(st, 1, vals.get(j));
            j += 1;
        }
        emit(st, 1, "return v;");
        emit(st, 0, "}");
        emit_code(st, 0, "var " + name + ": " + ft + " = " + fname + "();", st.ntrail.get(node));
        return;
    }
    flush(st, 0);
    val is_c: bool = is_const(st, t) && (is_arith(st, t) || r == R_STR) && !has_flag(st, s, U_MOD) && init >= 0 && st.nk.get(init) != E_INIT;
    if is_c {
        emit_code(st, 0, "const " + name + ": " + ft + " = " + vals.get(0) + ";", st.ntrail.get(node));
        return;
    }
    emit_code(st, 0, "var " + name + ": " + ft + " = " + vals.get(0) + ";", st.ntrail.get(node));
}

fn emit_todo_item(st: &mut C2, node: i64) {
    st.todo_count += 1;
    emit(st, 0, "// TODO(c2fd): not translated (" + st.ntext.get(node) + "):");
    val a: i64 = st.na.get(node);
    val b: i64 = st.nb.get(node);
    var line: str = "//     ";
    var i: i64 = a;
    while i < b {
        // comments inside the item are kept too
        val lead: str = st.xlead.get(i);
        if lead != "" {
            if line != "//     " {
                emit(st, 0, line);
                line = "//     ";
            }
            emit_text(st, 0, lead);
        }
        var t: str = st.xt.get(i);
        val k: i64 = st.xk.get(i);
        if k == TK_STR {
            t = "\"" + t + "\"";
        }
        if k == TK_CHR {
            t = "'" + t + "'";
        }
        if str_len(line) + str_len(t) > 90 {
            emit(st, 0, line);
            line = "//     ";
        }
        line = line + t + " ";
        i += 1;
    }
    if line != "//     " {
        emit(st, 0, line);
    }
}

fn is_small_item(st: &mut C2, n: i64) -> bool {
    val k: i64 = st.nk.get(n);
    return k == T_MACRO || k == T_GVAR || k == T_TYPEDEF;
}

fn emit_items(st: &mut C2) {
    var prev: i64 = -1;
    var i: i64 = 0;
    while i < st.items.len() {
        val it: i64 = st.items.get(i);
        val k: i64 = st.nk.get(it);
        if prev >= 0 {
            var gap: bool = true;
            if is_small_item(st, it) && is_small_item(st, prev) && st.nline.get(it) - comment_line_count(st.nlead.get(it)) <= st.nend.get(prev) + 1 {
                gap = false;
            }
            if k == T_MACRO && st.nd.get(it) >= 0 && st.nk.get(prev) == T_MACRO && st.nline.get(it) - comment_line_count(st.nlead.get(it)) <= st.nline.get(prev) + 1 {
                gap = false;
            }
            if gap {
                emit(st, 0, "");
            }
        }
        if k == T_FUNC { emit_function(st, it); }
        if k == T_STRUCT { emit_struct(st, it); }
        if k == T_ENUM { emit_enum(st, it); }
        if k == T_MACRO { emit_macro(st, it); }
        if k == T_TYPEDEF { emit_typedef(st, it); }
        if k == T_GVAR { emit_gvar(st, it); }
        if k == T_TODO { emit_todo_item(st, it); }
        prev = it;
        i += 1;
    }
}

// --- The helpers a translation uses ------------------------------------------------------------

fn helper_src(name: str) -> str {
    if name == "EOF" {
        return "const EOF: i64 = -1;";
    }
    if name == "c_char" {
        return r#"/// s[i] of a C string: its NUL (0) at the end.
fn c_char(s: str, i: i64) -> i64 {
    if i < 0 || i >= str_len(s) {
        return 0;
    }
    return str_byte_at(s, i);
}"#;
    }
    if name == "c_skip" {
        return r#"/// s + n for a C string: what follows its first n bytes.
fn c_skip(s: str, n: i64) -> str {
    if n >= str_len(s) {
        return "";
    }
    return str_slice(s, n, str_len(s));
}"#;
    }
    if name == "c_bytes" {
        return r#"/// A char array holding s and its NUL.
fn c_bytes(s: str) -> Vec<i64> {
    var b: Vec<i64> = str_bytes(s);
    b.push(0);
    return b;
}"#;
    }
    if name == "c_strlen" {
        return r#"/// strlen of a char array: the bytes before its first NUL.
fn c_strlen(b: &Vec<i64>) -> i64 {
    var n: i64 = 0;
    while n < b.len() && b[n] != 0 {
        n += 1;
    }
    return n;
}"#;
    }
    if name == "c_cstr" {
        return r#"/// The C string in a char array, as a str.
fn c_cstr(b: &Vec<i64>) -> str {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < b.len() && b[i] != 0 {
        v.push(b[i]);
        i += 1;
    }
    return str_from_bytes(v);
}"#;
    }
    if name == "c_strcpy" {
        return r#"/// strcpy into a char array (it grows when C would overflow it).
fn c_strcpy(dst: &mut Vec<i64>, src: str) {
    var i: i64 = 0;
    while i < str_len(src) {
        if i < dst.len() {
            dst[i] = str_byte_at(src, i);
        } else {
            dst.push(str_byte_at(src, i));
        }
        i += 1;
    }
    if i < dst.len() {
        dst[i] = 0;
    } else {
        dst.push(0);
    }
}"#;
    }
    if name == "c_strcat" {
        return r#"/// strcat onto a char array.
fn c_strcat(dst: &mut Vec<i64>, src: str) {
    var n: i64 = 0;
    while n < dst.len() && dst[n] != 0 {
        n += 1;
    }
    var i: i64 = 0;
    while i < str_len(src) {
        if n + i < dst.len() {
            dst[n + i] = str_byte_at(src, i);
        } else {
            dst.push(str_byte_at(src, i));
        }
        i += 1;
    }
    if n + i < dst.len() {
        dst[n + i] = 0;
    } else {
        dst.push(0);
    }
}"#;
    }
    if name == "c_strncmp" {
        return r#"/// strncmp: compares at most n bytes.
fn c_strncmp(a: str, b: str, n: i64) -> i64 {
    var i: i64 = 0;
    while i < n {
        var ca: i64 = 0;
        var cb: i64 = 0;
        if i < str_len(a) { ca = str_byte_at(a, i); }
        if i < str_len(b) { cb = str_byte_at(b, i); }
        if ca != cb || ca == 0 {
            return ca - cb;
        }
        i += 1;
    }
    return 0;
}"#;
    }
    if name == "c_strchr" {
        return r#"/// strchr: the string from the first c, or a null str.
fn c_strchr(s: str, c: i64) -> str {
    var i: i64 = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) == c {
            return str_slice(s, i, str_len(s));
        }
        i += 1;
    }
    if c == 0 {
        return "";
    }
    return 0 as str;
}"#;
    }
    if name == "c_strrchr" {
        return r#"/// strrchr: the string from the last c, or a null str.
fn c_strrchr(s: str, c: i64) -> str {
    var i: i64 = str_len(s) - 1;
    while i >= 0 {
        if str_byte_at(s, i) == c {
            return str_slice(s, i, str_len(s));
        }
        i -= 1;
    }
    return 0 as str;
}"#;
    }
    if name == "c_strstr" {
        return r#"/// strstr: the string from the first t, or a null str.
fn c_strstr(s: str, t: str) -> str {
    val i: i64 = str_find(s, t);
    if i < 0 {
        return 0 as str;
    }
    return str_slice(s, i, str_len(s));
}"#;
    }
    if name == "c_atoi" {
        return r#"/// atoi: optional spaces and sign, then digits; 0 when there are none.
fn c_atoi(s: str) -> i64 {
    var i: i64 = 0;
    val n: i64 = str_len(s);
    while i < n && c_isspace(str_byte_at(s, i)) {
        i += 1;
    }
    var neg: bool = false;
    if i < n && (str_byte_at(s, i) == '-' || str_byte_at(s, i) == '+') {
        neg = str_byte_at(s, i) == '-';
        i += 1;
    }
    var v: i64 = 0;
    while i < n && char_is_digit(str_byte_at(s, i)) {
        v = v * 10 + (str_byte_at(s, i) - '0');
        i += 1;
    }
    if neg {
        return -v;
    }
    return v;
}"#;
    }
    if name == "c_isspace" {
        return r#"fn c_isspace(c: i64) -> bool {
    return c == ' ' || (c >= 9 && c <= 13);
}"#;
    }
    if name == "c_isalnum" {
        return r#"fn c_isalnum(c: i64) -> bool {
    return char_is_alpha(c) || char_is_digit(c);
}"#;
    }
    if name == "c_ispunct" {
        return r#"fn c_ispunct(c: i64) -> bool {
    return c > 32 && c < 127 && !char_is_alpha(c) && !char_is_digit(c);
}"#;
    }
    if name == "c_isxdigit" {
        return r#"fn c_isxdigit(c: i64) -> bool {
    return char_is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}"#;
    }
    if name == "c_isprint" {
        return r#"fn c_isprint(c: i64) -> bool {
    return c >= 32 && c < 127;
}"#;
    }
    if name == "c_iscntrl" {
        return r#"fn c_iscntrl(c: i64) -> bool {
    return (c >= 0 && c < 32) || c == 127;
}"#;
    }
    if name == "c_rjust" {
        return r#"/// printf's width: s right-aligned in w columns.
fn c_rjust(s: str, w: i64) -> str {
    var out: str = s;
    while str_len(out) < w {
        out = " " + out;
    }
    return out;
}"#;
    }
    if name == "c_ljust" {
        return r#"/// printf's "-" flag: s left-aligned in w columns.
fn c_ljust(s: str, w: i64) -> str {
    var out: str = s;
    while str_len(out) < w {
        out = out + " ";
    }
    return out;
}"#;
    }
    if name == "c_zfill" {
        return r#"/// printf's "0" flag: a number padded with zeros after its sign.
fn c_zfill(s: str, w: i64) -> str {
    var sign: str = "";
    var digits: str = s;
    if str_starts_with(s, "-") {
        sign = "-";
        digits = str_slice(s, 1, str_len(s));
    }
    while str_len(sign) + str_len(digits) < w {
        digits = "0" + digits;
    }
    return sign + digits;
}"#;
    }
    if name == "c_left" {
        return r#"/// printf's "%.Ns": at most n bytes of s.
fn c_left(s: str, n: i64) -> str {
    if n >= str_len(s) {
        return s;
    }
    return str_slice(s, 0, n);
}"#;
    }
    if name == "c_fmt_f" {
        return r#"/// printf's "%.Nf": x rounded to prec decimals.
fn c_fmt_f(x: f64, prec: i64) -> str {
    var v: f64 = x;
    var sign: str = "";
    if v < 0.0 {
        sign = "-";
        v = 0.0 - v;
    }
    var scale: i64 = 1;
    var i: i64 = 0;
    while i < prec {
        scale = scale * 10;
        i += 1;
    }
    val total: i64 = (v * (scale as f64) + 0.5) as i64;
    val whole: i64 = total / scale;
    var out: str = sign + int_to_str(whole);
    if prec > 0 {
        var frac: str = int_to_str(total % scale);
        while str_len(frac) < prec {
            frac = "0" + frac;
        }
        out = out + "." + frac;
    }
    return out;
}"#;
    }
    if name == "c_fmt_g" {
        return r#"/// printf's "%g", roughly: an integral value without decimals, else
/// float_to_str. Check the output where it matters.
fn c_fmt_g(x: f64, prec: i64) -> str {
    if x == ((x as i64) as f64) {
        return int_to_str(x as i64);
    }
    return float_to_str(x);
}"#;
    }
    if name == "c_hex" {
        return r#"/// printf's "%x" / "%X" (the value as an unsigned 64-bit number).
fn c_hex(n: i64, upper: bool) -> str {
    var digits: str = "0123456789abcdef";
    if upper {
        digits = "0123456789ABCDEF";
    }
    if n == 0 {
        return "0";
    }
    var out: str = "";
    var v: u64 = n as u64;
    while v != 0 {
        out = char_to_str(str_byte_at(digits, (v & 15) as i64)) + out;
        v = v >> 4;
    }
    return out;
}

/// printf's "%o".
fn c_oct(n: i64) -> str {
    if n == 0 {
        return "0";
    }
    var out: str = "";
    var v: u64 = n as u64;
    while v != 0 {
        out = char_to_str('0' + (v & 7) as i64) + out;
        v = v >> 3;
    }
    return out;
}"#;
    }
    if name == "c_fill" {
        return r#"/// memset of a whole Vec.
fn c_fill(v: &mut Vec<i64>, x: i64) {
    var i: i64 = 0;
    while i < v.len() {
        v[i] = x;
        i += 1;
    }
}"#;
    }
    if name == "CFile" {
        return r#"/// A FILE* opened for reading: c_fopen reads the whole file.
struct CFile {
    data: str,
    pos: i64,
    ok: bool,
}

/// No file (a NULL FILE*).
fn c_nofile() -> CFile {
    return CFile { data: "", pos: 0, ok: false };
}

/// fopen: reading only ("r", "rb"); `ok` is false where C gives NULL.
fn c_fopen(path: str, mode: str) -> CFile {
    if !str_starts_with(mode, "r") {
        return c_nofile();
    }
    match read_file(path) {
        Option::Some(d) => {
            return CFile { data: d, pos: 0, ok: true };
        }
        Option::None => {
            return c_nofile();
        }
    }
}

fn c_fclose(f: &mut CFile) {
    f.ok = false;
}

/// fgetc: the next byte, or EOF (-1).
fn c_fgetc(f: &mut CFile) -> i64 {
    if f.pos >= str_len(f.data) {
        return -1;
    }
    val c: i64 = str_byte_at(f.data, f.pos);
    f.pos += 1;
    return c;
}

fn c_feof(f: &mut CFile) -> bool {
    return f.pos >= str_len(f.data);
}

/// fgets: up to n - 1 bytes, through the next newline; a null str at the end.
fn c_fgets(f: &mut CFile, n: i64) -> str {
    if f.pos >= str_len(f.data) {
        return 0 as str;
    }
    var end: i64 = f.pos;
    while end < str_len(f.data) && end - f.pos < n - 1 {
        end += 1;
        if str_byte_at(f.data, end - 1) == '\n' {
            break;
        }
    }
    val line: str = str_slice(f.data, f.pos, end);
    f.pos = end;
    return line;
}"#;
    }
    if name == "c_getchar" {
        return r#"var c_stdin: CFile = CFile { data: "", pos: -1, ok: true };

/// getchar: standard input, read whole at the first call.
fn c_getchar() -> i64 {
    if c_stdin.pos < 0 {
        c_stdin.data = read_stdin(1 << 30).unwrap_or("");
        c_stdin.pos = 0;
    }
    return c_fgetc(&mut c_stdin);
}"#;
    }
    if name == "c_args" {
        return r#"/// The program's arguments, argv[0] first. Under `fid run file.fd args`
/// the arguments of fid itself come first: they are skipped.
fn c_args() -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 1;
    val a1: str = arg_at(1).unwrap_or("");
    val a2: str = arg_at(2).unwrap_or("");
    if a1 == "run" && str_ends_with(a2, ".fd") {
        out.push(a2);
        i = 3;
    } else {
        out.push(arg_at(0).unwrap_or("program"));
    }
    while true {
        match arg_at(i) {
            Option::Some(a) => {
                out.push(a);
            }
            Option::None => {
                break;
            }
        }
        i += 1;
    }
    return out;
}"#;
    }
    return "";
}

fn emit_helpers(st: &mut C2) {
    val order: Vec<str> = str_split("EOF c_char c_skip c_bytes c_strlen c_cstr c_strcpy c_strcat c_strncmp c_strchr c_strrchr c_strstr c_atoi c_isspace c_isalnum c_ispunct c_isxdigit c_isprint c_iscntrl c_rjust c_ljust c_zfill c_left c_fmt_f c_fmt_g c_hex c_fill CFile c_getchar c_args", " ");
    // helpers other helpers call
    if st.helpers.contains("c_atoi") {
        use_h(st, "c_isspace");
    }
    if st.helpers.contains("c_getchar") {
        use_h(st, "CFile");
    }
    var any: bool = false;
    var i: i64 = 0;
    while i < order.len() {
        val h: str = order.get(i);
        if st.helpers.contains(h) {
            if !any {
                emit(st, 0, "");
                emit(st, 0, "// --- c2fd helpers: the C library behaviour this translation relies on ---");
                any = true;
            }
            emit(st, 0, "");
            emit_text(st, 0, helper_src(h));
        }
        i += 1;
    }
}

// --- Driver -------------------------------------------------------------------------------------

fn translate(path: str, src: str) -> str {
    var st: C2 = C2_new(path);
    init_types(&mut st);
    lex_file(&mut st, src);
    expand_all(&mut st);
    parse_program(&mut st);
    decide_all(&mut st);
    emit_items(&mut st);
    emit_helpers(&mut st);
    raw_close(&mut st);
    var head: Vec<str> = Vec::new();
    head.push("// Translated from " + cp_base(path) + " by c2fd (C to Fid, best effort): review it before use.");
    if st.includes.len() > 0 {
        head.push("// C headers: " + join_lines(st.includes, ", ") + " (their calls are mapped to Fid's).");
    }
    var i: i64 = 0;
    while i < st.top_notes.len() {
        head.push(st.top_notes.get(i));
        st.todo_count += 1;
        i += 1;
    }
    if st.helpers.contains("math") {
        head.push("");
        head.push("use math;");
    }
    head.push("");
    var sb: StringBuilder = StringBuilder::new();
    i = 0;
    while i < head.len() {
        sb.append_str(head.get(i));
        sb.append_str("\n");
        i += 1;
    }
    // drop the blank lines a leading comment-only item may leave at the top
    var started: bool = false;
    i = 0;
    val mark_len: i64 = str_len(C2_RAW_MARK);
    while i < st.lines.len() {
        var l: str = st.lines.get(i);
        if str_starts_with(l, C2_RAW_MARK) {
            val fs: i64 = str_parse_int(str_slice(l, mark_len, str_len(l)));
            if !vec_has_i64(st.raw_fns, fs) {
                i += 1;
                continue;
            }
            l = "@unsafe";
        }
        if started || str_trim(l) != "" {
            sb.append_str(str_trim_end(l));
            sb.append_str("\n");
            started = true;
        }
        i += 1;
    }
    if st.todo_count > 0 {
        p_eprint_str("c2fd: " + int_to_str(st.todo_count) + " TODO(c2fd) note(s) to review in the output\n");
    }
    return sb.to_str();
}

fn cp_base(path: str) -> str {
    var i: i64 = str_len(path) - 1;
    while i >= 0 {
        val c: i64 = str_byte_at(path, i);
        if c == 47 || c == 92 {
            return str_slice(path, i + 1, str_len(path));
        }
        i -= 1;
    }
    return path;
}

fn main() -> i64 {
    // under `fid run tools/c2fd.fd input.c`, fid's own arguments come first
    var first: i64 = 1;
    val a1: str = arg_at(1).unwrap_or("");
    val a2: str = arg_at(2).unwrap_or("");
    if a1 == "run" && str_ends_with(a2, ".fd") {
        first = 3;
    }
    val path: str = arg_at(first).unwrap_or("");
    if path == "" || path == "-h" || path == "--help" {
        p_eprint_str("usage: c2fd input.c > output.fd\n");
        return 2;
    }
    match read_file(path) {
        Option::Some(src) => {
            print(translate(path, src));
            return 0;
        }
        Option::None => {
            p_eprint_str("c2fd: cannot read " + path + "\n");
            return 1;
        }
    }
}
