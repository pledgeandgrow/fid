// tools/py_random.fd — Python's `random.Random(seed)` in Fides, so the
// ported fuzz drivers (tools/fuzz_gen.fd, tools/fuzz_vs_c.fd,
// tools/fuzz_frontend.fd, tools/fuzz_parsers.fd; roadmap AD4) draw the same
// numbers as the scripts they replace and a seed names the same program
// in both.
//
// The generator is MT19937 seeded as CPython seeds it from an int (the
// absolute value cut into 32-bit words, init_by_array); random() is
// genrand_res53; getrandbits, _randbelow (rejection over getrandbits of
// n.bit_length() bits), randrange, randint and choice are Lib/random.py's.
// tests/tools/fuzz_gen/check.sh compares the drawn numbers with Python's.

module py_random;

use core;

pub struct PyRng {
    pub mt: Vec<i64>,
    pub idx: i64,
}

@wrapping
fn pr_init_genrand(mt: &mut Vec<i64>, s: i64) -> void {
    mt.set(0, s & 4294967295);
    var i: i64 = 1;
    while i < 624 {
        val p: i64 = mt.get(i - 1);
        mt.set(i, (1812433253 * (p ^ (p >> 30)) + i) & 4294967295);
        i = i + 1;
    }
}

/// A generator seeded as `random.Random(seed)` seeds it.
@wrapping
pub fn py_rng(seed: i64) -> PyRng {
    var key: Vec<i64> = Vec::new();
    var s: i64 = seed;
    if s < 0 {
        s = 0 - s;
    }
    key.push(s & 4294967295);
    if (s >> 32) > 0 {
        key.push(s >> 32);
    }
    var mt: Vec<i64> = Vec::new();
    var z: i64 = 0;
    while z < 624 {
        mt.push(0);
        z = z + 1;
    }
    pr_init_genrand(&mut mt, 19650218);
    var i: i64 = 1;
    var j: i64 = 0;
    var k: i64 = 624;
    if key.len() > k {
        k = key.len();
    }
    while k > 0 {
        val p: i64 = mt.get(i - 1);
        mt.set(i, ((mt.get(i) ^ ((p ^ (p >> 30)) * 1664525)) + key.get(j) + j) & 4294967295);
        i = i + 1;
        j = j + 1;
        if i >= 624 {
            mt.set(0, mt.get(623));
            i = 1;
        }
        if j >= key.len() {
            j = 0;
        }
        k = k - 1;
    }
    k = 623;
    while k > 0 {
        val p: i64 = mt.get(i - 1);
        mt.set(i, ((mt.get(i) ^ ((p ^ (p >> 30)) * 1566083941)) - i) & 4294967295);
        i = i + 1;
        if i >= 624 {
            mt.set(0, mt.get(623));
            i = 1;
        }
        k = k - 1;
    }
    mt.set(0, 2147483648);
    return PyRng { mt: mt, idx: 624 };
}

fn pr_mag(y: i64) -> i64 {
    if (y & 1) == 1 {
        return 2567483615;
    }
    return 0;
}

/// genrand_uint32: the next 32-bit word.
@wrapping
pub fn py_u32(r: &mut PyRng) -> i64 {
    if r.idx >= 624 {
        var kk: i64 = 0;
        while kk < 227 {
            val y: i64 = (r.mt.get(kk) & 2147483648) | (r.mt.get(kk + 1) & 2147483647);
            r.mt.set(kk, r.mt.get(kk + 397) ^ (y >> 1) ^ pr_mag(y));
            kk = kk + 1;
        }
        while kk < 623 {
            val y2: i64 = (r.mt.get(kk) & 2147483648) | (r.mt.get(kk + 1) & 2147483647);
            r.mt.set(kk, r.mt.get(kk - 227) ^ (y2 >> 1) ^ pr_mag(y2));
            kk = kk + 1;
        }
        val y3: i64 = (r.mt.get(623) & 2147483648) | (r.mt.get(0) & 2147483647);
        r.mt.set(623, r.mt.get(396) ^ (y3 >> 1) ^ pr_mag(y3));
        r.idx = 0;
    }
    var y: i64 = r.mt.get(r.idx);
    r.idx = r.idx + 1;
    y = y ^ (y >> 11);
    y = y ^ ((y << 7) & 2636928640);
    y = y ^ ((y << 15) & 4022730752);
    y = y ^ (y >> 18);
    return y & 4294967295;
}

/// random(): a float in [0, 1) with 53 random bits.
pub fn py_random(r: &mut PyRng) -> f64 {
    val a: i64 = py_u32(r) >> 5;
    val b: i64 = py_u32(r) >> 6;
    return ((a as f64) * 67108864.0 + (b as f64)) * (1.0 / 9007199254740992.0);
}

/// getrandbits(k), 0 <= k <= 63.
@wrapping
pub fn py_getrandbits(r: &mut PyRng, k: i64) -> i64 {
    if k <= 0 {
        return 0;
    }
    if k <= 32 {
        return py_u32(r) >> (32 - k);
    }
    // words little-endian, the last one cut to what is left (CPython)
    var out: i64 = 0;
    var shift: i64 = 0;
    var left: i64 = k;
    while left > 0 {
        var w: i64 = py_u32(r);
        if left < 32 {
            w = w >> (32 - left);
        }
        out = out | (w << shift);
        shift = shift + 32;
        left = left - 32;
    }
    return out;
}

fn pr_bit_length(n: i64) -> i64 {
    var k: i64 = 0;
    var v: i64 = n;
    while v > 0 {
        k = k + 1;
        v = v >> 1;
    }
    return k;
}

/// _randbelow(n): an int in [0, n), n > 0.
pub fn py_below(r: &mut PyRng, n: i64) -> i64 {
    val k: i64 = pr_bit_length(n);
    var v: i64 = py_getrandbits(r, k);
    while v >= n {
        v = py_getrandbits(r, k);
    }
    return v;
}

/// randrange(a, b): an int in [a, b).
pub fn py_randrange(r: &mut PyRng, a: i64, b: i64) -> i64 {
    return a + py_below(r, b - a);
}

/// randint(a, b): an int in [a, b].
pub fn py_randint(r: &mut PyRng, a: i64, b: i64) -> i64 {
    return a + py_below(r, b - a + 1);
}

/// The index choice(seq) takes for a sequence of `n` items.
pub fn py_choice(r: &mut PyRng, n: i64) -> i64 {
    return py_below(r, n);
}

/// choice() over strings.
pub fn py_choice_str(r: &mut PyRng, v: &Vec<str>) -> str {
    return v.get(py_below(r, v.len()));
}
