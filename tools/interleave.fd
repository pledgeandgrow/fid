// tools/interleave.fd — sharded interleaving tests: one program, many
// schedules (roadmap VF18): the Fides port of scripts/verify/interleave.py
// (roadmap AD4). Same options and defaults, the same lines, the same files
// in <out> and the same --record rows, the same exit status:
//
//   fid ccompile tools/interleave.fd -o interleave.exe
//   interleave.exe --fid release/fid.exe [-n 2000] [--shards 4]
//       [--backends ccompile,emit] [--programs tests/verify/interleave.fd,...]
//       [--timeout 60] [--out build/interleave] [--sched-random]
//       [--seeds 17,42] [--record FILE]
//
// Each program is built once per backend (`<fid> <backend> <program> -o
// <out>/<name>-<backend>.exe`, CC=zig cc unless CC is set), run once as
// the reference (seed 0), then once per seed (1..n, or --seeds), up to
// --shards runs at a time. Each run draws from Python's random.Random(seed)
// exactly as the script does (a CPU set: choice of 1, 1, 2, half or all
// CPUs, then sample; then whether to load the machine and with how many
// busy loops), so a seed names the same CPU set and load in both; the
// child is pinned to its CPUs once started (Windows: SetProcessAffinityMask;
// Linux: `taskset -p`), and with --sched-random runs 1..n get
// FIDES_SCHED_RANDOM=<seed>. The output must be the program's '// Expected
// output' block when it has one, else the reference run's; a run that
// prints something else, crashes, or runs past --timeout seconds is kept
// in <out>/<name>-<backend>-seed<seed>.out (the first five). The lines
// printed, the replay command (the script's) and the --record row are the
// script's.
//
// Differences from the script: its shards are threads and its busy loops
// Python threads in its own process (one interpreter lock: together they
// load about one CPU); here the runs are child processes polled from one
// loop, and each busy loop is a child process of this tool (`--il-burn`,
// hidden), each loading one CPU. Files are written with "\n" line ends
// (Python on Windows writes "\r\n"). A program that cannot be started and
// a bad --seeds or --shards give the last line of Python's traceback only,
// exit 1 as there.

use core;
use args;
use fs;
use io;
use process;
use sys;
use task;

extern "C" {
    fn getcwd(buf: i64, n: i64) -> i64;
}

// SAFETY: kernel32 functions, declared by <windows.h>, which every
// generated C file includes on Windows (`<stdint.h>` only makes the C
// backend use the system's prototypes); only the @cfg(windows) function
// calls them, with a process id and the handle OpenProcess returned.
extern "C" include "<stdint.h>" {
    fn OpenProcess as il_open_process(access: i64, inherit: i64, pid: i64) -> i64;
    fn SetProcessAffinityMask as il_set_affinity(h: i64, mask: i64) -> i32;
    fn CloseHandle as il_close_handle(h: i64) -> i32;
}

// SAFETY: the C library's time functions, declared by <time.h> (the
// include): `t` is an 8-byte block this file allocated, localtime's
// result is only handed to strftime, `buf` is a block of `n` bytes.
extern "C" include "<time.h>" {
    fn time as il_time(t: i64) -> i64;
    fn localtime as il_localtime(t: i64) -> i64;
    fn strftime as il_strftime(buf: i64, n: i64, fmt: str, tm: i64) -> i64;
}

const IL_PROG: str = "interleave.py";

fn il_usage() -> str {
    var u: str = "usage: interleave.py [-h] [--fid FID] [-n N] [--shards SHARDS]\n";
    u = u + "                     [--backends BACKENDS] [--programs PROGRAMS]\n";
    u = u + "                     [--timeout TIMEOUT] [--out OUT] [--sched-random]\n";
    u = u + "                     [--seeds SEEDS] [--record RECORD]\n";
    return u;
}

fn il_help() -> str {
    var h: str = il_usage() + "\noptions:\n";
    h = h + "  -h, --help           show this help message and exit\n";
    h = h + "  --fid FID\n";
    h = h + "  -n N\n";
    h = h + "  --shards SHARDS\n";
    h = h + "  --backends BACKENDS\n";
    h = h + "  --programs PROGRAMS\n";
    h = h + "  --timeout TIMEOUT\n";
    h = h + "  --out OUT\n";
    h = h + "  --sched-random       runs 1..n set FIDES_SCHED_RANDOM to their seed (native\n";
    h = h + "                       runtimes)\n";
    h = h + "  --seeds SEEDS        comma-separated seeds to run instead of 1..n (replay)\n";
    h = h + "  --record RECORD      append a Markdown row per program and backend to this\n";
    h = h + "                       file\n";
    return h;
}

// ─── Text (Python's str methods, ASCII whitespace) ───

fn il_ws(c: i64) -> bool {
    return (c >= 9 && c <= 13) || (c >= 28 && c <= 32);
}

fn il_digit(c: i64) -> bool {
    return c >= 48 && c <= 57;
}

fn il_skip_ws(s: str, i: i64) -> i64 {
    var k: i64 = i;
    while k < str_len(s) && il_ws(str_byte_at(s, k)) { k = k + 1; }
    return k;
}

fn il_at(s: str, i: i64, w: str) -> bool {
    if i < 0 || i + str_len(w) > str_len(s) { return false; }
    return str_slice(s, i, i + str_len(w)) == w;
}

/// s.strip()
fn il_strip(s: str) -> str {
    var a: i64 = 0;
    var b: i64 = str_len(s);
    while a < b && il_ws(str_byte_at(s, a)) { a = a + 1; }
    while b > a && il_ws(str_byte_at(s, b - 1)) { b = b - 1; }
    return str_slice(s, a, b);
}

/// s.split(sep) (keeps empty pieces).
fn il_split(s: str, sep: str) -> Vec<str> {
    var r: Vec<str> = Vec::new();
    val n: i64 = str_len(s);
    val m: i64 = str_len(sep);
    var start: i64 = 0;
    var i: i64 = 0;
    while i + m <= n {
        if str_slice(s, i, i + m) == sep {
            r.push(str_slice(s, start, i));
            i = i + m;
            start = i;
        } else {
            i = i + 1;
        }
    }
    r.push(str_slice(s, start, n));
    return r;
}

/// s.splitlines() (on "\n", "\r\n" and "\r").
fn il_splitlines(s: str) -> Vec<str> {
    var r: Vec<str> = Vec::new();
    val n: i64 = str_len(s);
    var start: i64 = 0;
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(s, i);
        if c == 10 || c == 13 {
            r.push(str_slice(s, start, i));
            if c == 13 && i + 1 < n && str_byte_at(s, i + 1) == 10 { i = i + 1; }
            start = i + 1;
        }
        i = i + 1;
    }
    if start < n { r.push(str_slice(s, start, n)); }
    return r;
}

/// f"{s:<w}"
fn il_ljust(s: str, w: i64) -> str {
    var r: str = s;
    var n: i64 = il_chars(s);
    while n < w {
        r = r + " ";
        n = n + 1;
    }
    return r;
}

/// f"{s:>w}"
fn il_rjust(s: str, w: i64) -> str {
    var r: str = s;
    var n: i64 = il_chars(s);
    while n < w {
        r = " " + r;
        n = n + 1;
    }
    return r;
}

/// The code points of UTF-8 text.
fn il_chars(s: str) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) {
        if (str_byte_at(s, i) & 192) != 128 { n = n + 1; }
        i = i + 1;
    }
    return n;
}

/// s[:n] by code points.
fn il_head(s: str, n: i64) -> str {
    var seen: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) {
        if (str_byte_at(s, i) & 192) != 128 {
            if seen == n { return str_slice(s, 0, i); }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return s;
}

/// s[-n:] by code points.
fn il_tail(s: str, n: i64) -> str {
    val total: i64 = il_chars(s);
    if total <= n { return s; }
    var skip: i64 = total - n;
    var i: i64 = 0;
    while i < str_len(s) {
        if (str_byte_at(s, i) & 192) != 128 {
            if skip == 0 { return str_slice(s, i, str_len(s)); }
            skip = skip - 1;
        }
        i = i + 1;
    }
    return "";
}

fn il_hexw(c: i64, width: i64) -> str {
    val digits: str = "0123456789abcdef";
    var s: str = "";
    var k: i64 = width - 1;
    while k >= 0 {
        s = s + char_to_str(str_byte_at(digits, (c >> (4 * k)) & 15));
        k = k - 1;
    }
    return s;
}

/// hex(v) for v >= 0: "0x" and the digits, no padding.
fn il_hex(v: i64) -> str {
    if v == 0 { return "0x0"; }
    val digits: str = "0123456789abcdef";
    var s: str = "";
    var x: i64 = v;
    while x > 0 {
        s = char_to_str(str_byte_at(digits, x & 15)) + s;
        x = x >> 4;
    }
    return "0x" + s;
}

/// repr() of a str: ASCII control characters, U+007F..U+009F escaped,
/// the rest as it is.
fn il_repr(s: str) -> str {
    var q: str = "'";
    if str_contains(s, "'") && !str_contains(s, "\"") { q = "\""; }
    var out: str = q;
    var i: i64 = 0;
    while i < str_len(s) {
        val c: i64 = str_byte_at(s, i);
        i = i + 1;
        if char_to_str(c) == q || c == 92 {
            out = out + "\\" + char_to_str(c);
        } else if c == 9 {
            out = out + "\\t";
        } else if c == 10 {
            out = out + "\\n";
        } else if c == 13 {
            out = out + "\\r";
        } else if c < 32 || c == 127 {
            out = out + "\\x" + il_hexw(c, 2);
        } else if c == 192 && i < str_len(s) && str_byte_at(s, i) == 128 {
            // a NUL the decoder kept as C0 80
            out = out + "\\x00";
            i = i + 1;
        } else if c == 194 && i < str_len(s) && str_byte_at(s, i) >= 128 && str_byte_at(s, i) <= 159 {
            out = out + "\\x" + il_hexw(str_byte_at(s, i), 2);
            i = i + 1;
        } else {
            out = out + char_to_str(c);
        }
    }
    return out + q;
}

/// f"{d:.{prec}f}", rounded as Python rounds (the binary value, ties to
/// even).
fn il_fixed(d: f64, prec: i64) -> str {
    if d != d { return "nan"; }
    var neg: bool = false;
    var x: f64 = d;
    if x < 0.0 {
        neg = true;
        x = 0.0 - x;
    }
    if x > 1.0e15 {
        return float_to_str(d);
    }
    val bits: i64 = p_f64_to_bits(x);
    val e: i64 = (bits >> 52) & 2047;
    var m: i64 = bits & 4503599627370495;
    var exp: i64 = -1074;
    if e != 0 {
        m = m | 4503599627370496;
        exp = e - 1075;
    }
    var scale: i64 = 1;
    var k: i64 = 0;
    while k < prec {
        scale = scale * 10;
        k = k + 1;
    }
    // m * scale fits while prec <= 2 (m < 2^53)
    val num: i64 = m * scale;
    var q: i64 = 0;
    if exp >= 0 {
        q = num << exp;
    } else {
        val s: i64 = 0 - exp;
        if s <= 61 {
            q = num >> s;
            val r: i64 = num - (q << s);
            val half: i64 = 1 << (s - 1);
            if r > half || (r == half && (q & 1) == 1) { q = q + 1; }
        }
    }
    var out: str = int_to_str(q / scale);
    if prec > 0 {
        var frac: str = int_to_str(q % scale);
        while str_len(frac) < prec { frac = "0" + frac; }
        out = out + "." + frac;
    }
    if neg { out = "-" + out; }
    return out;
}

/// The text Python's bytes.decode("utf-8", "replace") gives (a NUL as
/// C0 80, which a str can hold).
fn il_decode(b: Vec<i64>) -> str {
    var out: Vec<i64> = Vec::new();
    val n: i64 = b.len();
    var i: i64 = 0;
    while i < n {
        val c: i64 = b.get(i);
        if c == 0 {
            out.push(192);
            out.push(128);
            i = i + 1;
            continue;
        }
        if c < 128 {
            out.push(c);
            i = i + 1;
            continue;
        }
        var need: i64 = 0;
        var lo: i64 = 128;
        var hi: i64 = 191;
        if c >= 194 && c <= 223 {
            need = 1;
        } else if c >= 224 && c <= 239 {
            need = 2;
            if c == 224 { lo = 160; }
            if c == 237 { hi = 159; }
        } else if c >= 240 && c <= 244 {
            need = 3;
            if c == 240 { lo = 144; }
            if c == 244 { hi = 143; }
        } else {
            out.push(239);
            out.push(191);
            out.push(189);
            i = i + 1;
            continue;
        }
        var j: i64 = 1;
        var ok: bool = true;
        while j <= need {
            if i + j >= n {
                ok = false;
                break;
            }
            val d: i64 = b.get(i + j);
            var l: i64 = 128;
            var h: i64 = 191;
            if j == 1 {
                l = lo;
                h = hi;
            }
            if d < l || d > h {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if ok {
            var k: i64 = 0;
            while k <= need {
                out.push(b.get(i + k));
                k = k + 1;
            }
            i = i + need + 1;
        } else {
            out.push(239);
            out.push(191);
            out.push(189);
            i = i + j;
        }
    }
    return str_from_bytes(out);
}

// ─── Paths (os.path on this system) ───

fn il_win() -> bool {
    return process_is_windows();
}

fn il_is_sep(c: i64) -> bool {
    return c == 47 || (c == 92 && il_win());
}

fn il_sep() -> str {
    if il_win() { return "\\"; }
    return "/";
}

var il_cwd_cache: str = "";

/// os.getcwd()
fn il_cwd() -> str {
    if str_len(il_cwd_cache) > 0 { return il_cwd_cache; }
    var buf: i64 = 0;
    // SAFETY: a fresh 4096-byte buffer; getcwd writes at most that many
    // bytes, NUL included, and the result is copied out before it is freed.
    unsafe {
        buf = p_malloc(4096);
        if buf != 0 {
            if getcwd(buf, 4096) != 0 {
                il_cwd_cache = p_str_from_ptr(buf);
            }
            p_free(buf);
        }
    }
    if str_len(il_cwd_cache) == 0 { il_cwd_cache = "."; }
    return il_cwd_cache;
}

/// The drive ("C:") of a Windows path, "" for none.
fn il_drive(p: str) -> str {
    if il_win() && str_len(p) >= 2 && str_byte_at(p, 1) == 58 { return str_slice(p, 0, 2); }
    return "";
}

fn il_isabs(p: str) -> bool {
    val d: str = il_drive(p);
    val rest: str = str_slice(p, str_len(d), str_len(p));
    return str_len(rest) > 0 && il_is_sep(str_byte_at(rest, 0));
}

/// os.path.join(a, b)
fn il_join(a: str, b: str) -> str {
    if str_len(a) == 0 { return b; }
    if il_isabs(b) { return b; }
    if il_is_sep(str_byte_at(a, str_len(a) - 1)) { return a + b; }
    return a + il_sep() + b;
}

/// os.path.normpath
fn il_normpath(p: str) -> str {
    val d: str = il_drive(p);
    var rest: str = str_slice(p, str_len(d), str_len(p));
    if il_win() { rest = str_replace(rest, "/", "\\"); }
    val abs: bool = str_len(rest) > 0 && il_is_sep(str_byte_at(rest, 0));
    val parts: Vec<str> = il_split(rest, il_sep());
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < parts.len() {
        val c: str = parts.get(i);
        i = i + 1;
        if str_len(c) == 0 || c == "." { continue; }
        if c == ".." {
            if out.len() > 0 && out.get(out.len() - 1) != ".." {
                out.remove(out.len() - 1);
                continue;
            }
            if abs { continue; }
        }
        out.push(c);
    }
    var s: str = "";
    i = 0;
    while i < out.len() {
        if i > 0 { s = s + il_sep(); }
        s = s + out.get(i);
        i = i + 1;
    }
    if abs { s = il_sep() + s; }
    s = d + s;
    if str_len(s) == 0 { return "."; }
    return s;
}

/// os.path.abspath
fn il_abspath(p: str) -> str {
    if il_isabs(p) { return il_normpath(p); }
    return il_normpath(il_join(il_cwd(), p));
}

/// os.path.basename
fn il_basename(p: str) -> str {
    var i: i64 = str_len(p) - 1;
    while i >= 0 {
        if il_is_sep(str_byte_at(p, i)) { return str_slice(p, i + 1, str_len(p)); }
        i = i - 1;
    }
    if str_len(il_drive(p)) == 2 { return str_slice(p, 2, str_len(p)); }
    return p;
}

/// os.makedirs(p, exist_ok=True)
fn il_makedirs(p: str) -> bool {
    if str_len(p) == 0 || fs_is_dir(p) { return true; }
    var k: i64 = str_len(p) - 1;
    while k >= 0 && il_is_sep(str_byte_at(p, k)) { k = k - 1; }
    while k >= 0 && !il_is_sep(str_byte_at(p, k)) { k = k - 1; }
    if k > 0 {
        val parent: str = str_slice(p, 0, k);
        if !(str_len(parent) == 2 && str_len(il_drive(parent)) == 2) {
            il_makedirs(parent);
        }
    }
    fs_mkdir(p);
    return fs_is_dir(p);
}

/// os.environ.get(name, "")
fn il_env(name: str) -> str {
    match env_var(name) {
        Option::Some(v) => { return v; }
        Option::None => { }
    }
    return "";
}

fn il_has_env(name: str) -> bool {
    match env_var(name) {
        Option::Some(v) => { return true; }
        Option::None => { }
    }
    return false;
}

// ─── argparse (options only, no positionals) ───

struct IlOpt {
    long: str,
    short: str,
    takes: bool,
    kind: i64,
}

const IL_STR: i64 = 0;
const IL_INT: i64 = 1;
const IL_FLOAT: i64 = 2;
const IL_FLAG: i64 = 3;
const IL_HELP: i64 = 4;

fn il_opt(long: str, short: str, kind: i64) -> IlOpt {
    return IlOpt { long: long, short: short, takes: kind == IL_STR || kind == IL_INT || kind == IL_FLOAT, kind: kind };
}

/// argparse's look of a negative number: -\d+ or -\d*\.\d+
fn il_negnum(a: str) -> bool {
    if str_len(a) < 2 || str_byte_at(a, 0) != 45 { return false; }
    var i: i64 = 1;
    var dig: i64 = 0;
    while i < str_len(a) && il_digit(str_byte_at(a, i)) {
        i = i + 1;
        dig = dig + 1;
    }
    if i == str_len(a) { return dig > 0; }
    if str_byte_at(a, i) != 46 { return false; }
    i = i + 1;
    var frac: i64 = 0;
    while i < str_len(a) && il_digit(str_byte_at(a, i)) {
        i = i + 1;
        frac = frac + 1;
    }
    return i == str_len(a) && frac > 0;
}

/// int(s) as Python reads it (whitespace, a sign, ASCII digits, "_"
/// between digits).
fn il_is_int(s: str) -> bool {
    val t: str = il_strip(s);
    var i: i64 = 0;
    if i < str_len(t) && (str_byte_at(t, i) == 43 || str_byte_at(t, i) == 45) { i = i + 1; }
    if i >= str_len(t) { return false; }
    var prev_digit: bool = false;
    while i < str_len(t) {
        val c: i64 = str_byte_at(t, i);
        if c == 95 {
            if !prev_digit || i + 1 >= str_len(t) || !il_digit(str_byte_at(t, i + 1)) { return false; }
            prev_digit = false;
        } else if !il_digit(c) {
            return false;
        } else {
            prev_digit = true;
        }
        i = i + 1;
    }
    return true;
}

fn il_int(s: str) -> i64 {
    var t: str = str_replace(il_strip(s), "_", "");
    if str_starts_with(t, "+") { t = str_slice(t, 1, str_len(t)); }
    return str_parse_int(t);
}

/// float(s): a decimal with an optional exponent, inf, infinity or nan.
fn il_is_float(s: str) -> bool {
    val t: str = str_to_lower(il_strip(s));
    var i: i64 = 0;
    if i < str_len(t) && (str_byte_at(t, i) == 43 || str_byte_at(t, i) == 45) { i = i + 1; }
    val rest: str = str_slice(t, i, str_len(t));
    if rest == "inf" || rest == "infinity" || rest == "nan" { return true; }
    var digs: i64 = 0;
    while i < str_len(t) && il_digit(str_byte_at(t, i)) {
        i = i + 1;
        digs = digs + 1;
    }
    if i < str_len(t) && str_byte_at(t, i) == 46 {
        i = i + 1;
        while i < str_len(t) && il_digit(str_byte_at(t, i)) {
            i = i + 1;
            digs = digs + 1;
        }
    }
    if digs == 0 { return false; }
    if i < str_len(t) && str_byte_at(t, i) == 101 {
        i = i + 1;
        if i < str_len(t) && (str_byte_at(t, i) == 43 || str_byte_at(t, i) == 45) { i = i + 1; }
        var ed: i64 = 0;
        while i < str_len(t) && il_digit(str_byte_at(t, i)) {
            i = i + 1;
            ed = ed + 1;
        }
        if ed == 0 { return false; }
    }
    return i == str_len(t);
}

fn il_float(s: str) -> f64 {
    val t: str = str_to_lower(il_strip(s));
    if str_contains(t, "inf") {
        if str_starts_with(t, "-") { return 0.0 - 1.0e308 * 10.0; }
        return 1.0e308 * 10.0;
    }
    if str_contains(t, "nan") {
        val z: f64 = 0.0;
        return z / z;
    }
    return str_parse_float(t);
}

/// -1 none, -2 ambiguous (msg set), else the option's index.
fn il_find_opt(opts: Vec<IlOpt>, a: str, msg: &mut str, explicit: &mut str, has_explicit: &mut bool) -> i64 {
    *has_explicit = false;
    *explicit = "";
    var i: i64 = 0;
    while i < opts.len() {
        if opts.get(i).long == a || (str_len(opts.get(i).short) > 0 && opts.get(i).short == a) { return i; }
        i = i + 1;
    }
    if str_len(a) < 2 || str_byte_at(a, 0) != 45 { return -1; }
    val eq: i64 = str_find(a, "=");
    if eq > 0 {
        val name: str = str_slice(a, 0, eq);
        i = 0;
        while i < opts.len() {
            if opts.get(i).long == name || (str_len(opts.get(i).short) > 0 && opts.get(i).short == name) {
                *explicit = str_slice(a, eq + 1, str_len(a));
                *has_explicit = true;
                return i;
            }
            i = i + 1;
        }
    }
    if str_starts_with(a, "--") {
        var prefix: str = a;
        if eq > 0 { prefix = str_slice(a, 0, eq); }
        var hits: Vec<i64> = Vec::new();
        i = 0;
        while i < opts.len() {
            if str_len(opts.get(i).long) > 0 && str_starts_with(opts.get(i).long, prefix) { hits.push(i); }
            i = i + 1;
        }
        if hits.len() > 1 {
            var names: str = "";
            var k: i64 = 0;
            while k < hits.len() {
                if k > 0 { names = names + ", "; }
                names = names + opts.get(hits.get(k)).long;
                k = k + 1;
            }
            *msg = "ambiguous option: " + a + " could match " + names;
            return -2;
        }
        if hits.len() == 1 {
            if eq > 0 {
                *explicit = str_slice(a, eq + 1, str_len(a));
                *has_explicit = true;
            }
            return hits.get(0);
        }
        return -1;
    }
    // a short option with its value glued on (-n4)
    val two: str = str_slice(a, 0, 2);
    i = 0;
    while i < opts.len() {
        if str_len(opts.get(i).short) > 0 && opts.get(i).short == two && opts.get(i).takes {
            *explicit = str_slice(a, 2, str_len(a));
            *has_explicit = true;
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// ap.error(msg): the usage and "<prog>: error: msg" on stderr; 2.
fn il_ap_error(msg: str) -> i64 {
    io_eprint(il_usage());
    io_eprintln(IL_PROG + ": error: " + msg);
    return 2;
}

struct IlArgs {
    vals: Vec<str>,
    given: Vec<bool>,
    code: i64,
}

/// ap.parse_args(): code -1 when the options are good (vals/given hold
/// them), else the exit status (help printed: 0; an error: 2).
fn il_parse(argv: Vec<str>, opts: Vec<IlOpt>) -> IlArgs {
    var vals: Vec<str> = Vec::new();
    var given: Vec<bool> = Vec::new();
    var i: i64 = 0;
    while i < opts.len() {
        vals.push("");
        given.push(false);
        i = i + 1;
    }
    var kinds: Vec<i64> = Vec::new();
    var idx: Vec<i64> = Vec::new();
    var expl: Vec<str> = Vec::new();
    var hexp: Vec<bool> = Vec::new();
    var dashdash: bool = false;
    i = 0;
    while i < argv.len() {
        val a: str = argv.get(i);
        i = i + 1;
        var msg: str = "";
        var ex: str = "";
        var he: bool = false;
        if dashdash || a == "-" || !str_starts_with(a, "-") {
            kinds.push(0);
            idx.push(-1);
            expl.push("");
            hexp.push(false);
            continue;
        }
        if a == "--" {
            dashdash = true;
            kinds.push(2);
            idx.push(-1);
            expl.push("");
            hexp.push(false);
            continue;
        }
        val f: i64 = il_find_opt(opts, a, &mut msg, &mut ex, &mut he);
        if f == -2 {
            return IlArgs { vals: vals, given: given, code: il_ap_error(msg) };
        }
        if f < 0 && (il_negnum(a) || str_contains(a, " ")) {
            kinds.push(0);
        } else {
            kinds.push(1);
        }
        idx.push(f);
        expl.push(ex);
        hexp.push(he);
    }
    var extras: Vec<str> = Vec::new();
    i = 0;
    while i < argv.len() {
        val a2: str = argv.get(i);
        val kd: i64 = kinds.get(i);
        val f2: i64 = idx.get(i);
        i = i + 1;
        if kd == 2 { continue; }
        if kd == 0 || f2 < 0 {
            extras.push(a2);
            continue;
        }
        val o: IlOpt = opts.get(f2);
        var name: str = o.long;
        if str_len(o.long) == 0 { name = o.short; } else if str_len(o.short) > 0 { name = o.short + "/" + o.long; }
        if o.kind == IL_HELP {
            io_print(il_help());
            return IlArgs { vals: vals, given: given, code: 0 };
        }
        if !o.takes {
            if hexp.get(i - 1) {
                return IlArgs { vals: vals, given: given,
                    code: il_ap_error("argument " + name + ": ignored explicit argument " + il_repr(expl.get(i - 1))) };
            }
            given.set(f2, true);
            vals.set(f2, "1");
            continue;
        }
        var v: str = "";
        if hexp.get(i - 1) {
            v = expl.get(i - 1);
        } else {
            if i >= argv.len() || kinds.get(i) != 0 {
                return IlArgs { vals: vals, given: given, code: il_ap_error("argument " + name + ": expected one argument") };
            }
            v = argv.get(i);
            i = i + 1;
        }
        if o.kind == IL_INT && !il_is_int(v) {
            return IlArgs { vals: vals, given: given, code: il_ap_error("argument " + name + ": invalid int value: " + il_repr(v)) };
        }
        if o.kind == IL_FLOAT && !il_is_float(v) {
            return IlArgs { vals: vals, given: given, code: il_ap_error("argument " + name + ": invalid float value: " + il_repr(v)) };
        }
        given.set(f2, true);
        vals.set(f2, v);
    }
    if extras.len() > 0 {
        var s: str = "";
        var k: i64 = 0;
        while k < extras.len() {
            if k > 0 { s = s + " "; }
            s = s + extras.get(k);
            k = k + 1;
        }
        return IlArgs { vals: vals, given: given, code: il_ap_error("unrecognized arguments: " + s) };
    }
    return IlArgs { vals: vals, given: given, code: -1 };
}

fn il_val(a: &IlArgs, i: i64, def: str) -> str {
    if a.given.get(i) { return a.vals.get(i); }
    return def;
}

fn il_flag(a: &IlArgs, i: i64) -> bool {
    return a.given.get(i);
}

// ─── Running programs ───

fn il_join_list(v: Vec<str>) -> str {
    val sep: str = char_to_str(31);
    var s: str = "";
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 { s = s + sep; }
        s = s + v.get(i);
        i = i + 1;
    }
    return s;
}

/// What il_run gives: the exit status (Python's: a crash on Windows as the
/// unsigned code), timed_out when it was killed at the time limit,
/// started false when it could not start; stdout and stderr decoded as
/// UTF-8 with replacement; the seconds it took.
struct IlRes {
    started: bool,
    timed_out: bool,
    code: i64,
    out: str,
    err: str,
    secs: f64,
}

var il_run_ctr: i64 = 0;

/// When set, il_run decodes as subprocess.run(..., text=True) does: the
/// locale's encoding (Windows: the ANSI code page, whose bytes are kept as
/// they are; elsewhere UTF-8) and universal newlines.
var il_locale_mode: bool = false;

/// Text a child wrote, as text=True gives it and print() writes it back:
/// CR LF and a lone CR as LF; on Windows every other byte as it is
/// (the code page's characters print as the same bytes) but NUL, which a
/// str cannot hold (Python prints it); elsewhere UTF-8 with replacement.
fn il_locale(b: Vec<i64>) -> str {
    var nl: Vec<i64> = Vec::new();
    val n: i64 = b.len();
    var i: i64 = 0;
    while i < n {
        val c: i64 = b.get(i);
        if c == 13 {
            nl.push(10);
            if i + 1 < n && b.get(i + 1) == 10 { i = i + 1; }
        } else {
            nl.push(c);
        }
        i = i + 1;
    }
    return il_raw(nl);
}

/// Bytes a child wrote, decoded as the locale's encoding (no newline
/// translation): see il_locale.
fn il_raw(b: Vec<i64>) -> str {
    if !il_win() { return il_decode(b); }
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < b.len() {
        if b.get(i) != 0 { out.push(b.get(i)); }
        i = i + 1;
    }
    return str_from_bytes(out);
}

/// s[-n:] of text il_locale or il_raw made (Windows: one byte is one
/// character of the code page).
fn il_ltail(s: str, n: i64) -> str {
    if !il_win() { return il_tail(s, n); }
    if str_len(s) <= n { return s; }
    return str_slice(s, str_len(s) - n, str_len(s));
}
var il_tmp: str = "";

fn il_tmpdir() -> str {
    if str_len(il_tmp) > 0 { return il_tmp; }
    var t: str = il_env("TMPDIR");
    if str_len(t) == 0 { t = il_env("TEMP"); }
    if str_len(t) == 0 { t = il_env("TMP"); }
    if str_len(t) == 0 {
        if il_win() { t = "."; } else { t = "/tmp"; }
    }
    il_tmp = t;
    return t;
}

/// A fresh temporary file name (nothing made).
fn il_tmpname(tag: str) -> str {
    il_run_ctr = il_run_ctr + 1;
    return il_join(il_tmpdir(), ".fid-" + tag + "-" + int_to_str(p_getpid()) + "-" + int_to_str(il_run_ctr));
}

/// A child's exit code as Python's subprocess gives it: on Windows the
/// unsigned 32-bit value; elsewhere a signal n (128 + n here) as -n when
/// `signals` (a direct child, not a shell's status).
fn il_code(c: i64, signals: bool) -> i64 {
    var code: i64 = c;
    if il_win() {
        if code < 0 { code = code + 4294967296; }
    } else if signals && code > 128 && code < 128 + 65 {
        code = 128 - code;
    }
    return code;
}

/// subprocess.run(cmd, capture_output=True, timeout=...): stdin ours,
/// stdout and stderr captured; `env` "NAME=value" entries added to ours;
/// timeout_ms < 0: no limit.
fn il_run(cmd: Vec<str>, env: Vec<str>, timeout_ms: i64, signals: bool) -> IlRes {
    val t0: i64 = p_clock_now_ms();
    val base: str = il_tmpname("run");
    val outp: str = base + ".out";
    val errp: str = base + ".err";
    val h: i64 = process_spawn_files(cmd, env, "", outp, errp);
    if h == 0 {
        if fs_exists(outp) { fs_delete(outp); }
        if fs_exists(errp) { fs_delete(errp); }
        return IlRes { started: false, timed_out: false, code: -1, out: "", err: "", secs: 0.0 };
    }
    var timed_out: bool = false;
    var code: i64 = -1;
    match process_wait(h, timeout_ms) {
        Option::Some(c) => {
            code = il_code(c, signals);
        }
        Option::None => {
            timed_out = true;
            process_kill(h);
            process_wait(h, 10000);
        }
    }
    process_release(h);
    var out: str = "";
    var err: str = "";
    if !timed_out {
        if il_locale_mode {
            out = il_locale(fs_read_bytes(outp));
            err = il_locale(fs_read_bytes(errp));
        } else {
            out = il_decode(fs_read_bytes(outp));
            err = il_decode(fs_read_bytes(errp));
        }
    }
    if fs_exists(outp) { fs_delete(outp); }
    if fs_exists(errp) { fs_delete(errp); }
    val secs: f64 = ((p_clock_now_ms() - t0) as f64) / 1000.0;
    return IlRes { started: true, timed_out: timed_out, code: code, out: out, err: err, secs: secs };
}

// SAFETY: FormatMessageA, declared by <windows.h>, which every generated
// C file includes on Windows (`<stdint.h>` only makes the C backend use
// the system's prototype); `buf` is a block of `size` bytes this file
// allocated. Only the @cfg(windows) il_winerr calls it.
extern "C" include "<stdint.h>" {
    fn FormatMessageA as il_fmtmsg(flags: i64, src: i64, id: i64, lang: i64, buf: i64, size: i64, args: i64) -> i64;
}

/// The system's text for Windows error `n`, as Python shows it (trailing
/// whitespace and dots removed).
@cfg(windows)
fn il_winerr(n: i64) -> str {
    var msg: str = "";
    // SAFETY: a fresh 1024-byte block; FormatMessageA writes at most 1023
    // bytes and a NUL into it (FROM_SYSTEM | IGNORE_INSERTS: no inserts
    // are read), and the text is copied out before the block is freed.
    unsafe {
        val buf: i64 = p_malloc(1024);
        if buf != 0 {
            if il_fmtmsg(4096 | 512, 0, n, 0, buf, 1023, 0) > 0 {
                msg = p_str_from_ptr(buf);
            }
            p_free(buf);
        }
    }
    var e: i64 = str_len(msg);
    while e > 0 && (il_ws(str_byte_at(msg, e - 1)) || str_byte_at(msg, e - 1) == 46) { e = e - 1; }
    return str_slice(msg, 0, e);
}

@cfg(unix)
fn il_winerr(n: i64) -> str {
    return "";
}

/// What Python prints for a program it cannot start (the last line of
/// its traceback).
fn il_not_found(prog: str) -> str {
    if il_win() { return "FileNotFoundError: [WinError 2] " + il_winerr(2); }
    return "FileNotFoundError: [Errno 2] No such file or directory: " + il_repr(prog);
}

fn il_clone_list(v: &Vec<str>) -> Vec<str> {
    var r: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        r.push(v.get(i));
        i = i + 1;
    }
    return r;
}

/// Python's text mode on a captured stream: "\r\n" as "\n".
fn il_text(s: str) -> str {
    return str_replace(s, "\r\n", "\n");
}

// ─── Python's random.Random(seed) (MT19937 seeded by init_by_array, as
// tools/py_random.fd; choice, sample, random, randint as Lib/random.py) ───

struct IlRng {
    mt: Vec<i64>,
    idx: i64,
}

@wrapping
fn il_init_genrand(mt: &mut Vec<i64>, s: i64) -> void {
    mt.set(0, s & 4294967295);
    var i: i64 = 1;
    while i < 624 {
        val p: i64 = mt.get(i - 1);
        mt.set(i, (1812433253 * (p ^ (p >> 30)) + i) & 4294967295);
        i = i + 1;
    }
}

@wrapping
fn il_rng(seed: i64) -> IlRng {
    var key: Vec<i64> = Vec::new();
    var s: i64 = seed;
    if s < 0 { s = 0 - s; }
    key.push(s & 4294967295);
    if (s >> 32) > 0 { key.push(s >> 32); }
    var mt: Vec<i64> = Vec::new();
    var z: i64 = 0;
    while z < 624 {
        mt.push(0);
        z = z + 1;
    }
    il_init_genrand(&mut mt, 19650218);
    var i: i64 = 1;
    var j: i64 = 0;
    var k: i64 = 624;
    if key.len() > k { k = key.len(); }
    while k > 0 {
        val p: i64 = mt.get(i - 1);
        mt.set(i, ((mt.get(i) ^ ((p ^ (p >> 30)) * 1664525)) + key.get(j) + j) & 4294967295);
        i = i + 1;
        j = j + 1;
        if i >= 624 {
            mt.set(0, mt.get(623));
            i = 1;
        }
        if j >= key.len() { j = 0; }
        k = k - 1;
    }
    k = 623;
    while k > 0 {
        val p: i64 = mt.get(i - 1);
        mt.set(i, ((mt.get(i) ^ ((p ^ (p >> 30)) * 1566083941)) - i) & 4294967295);
        i = i + 1;
        if i >= 624 {
            mt.set(0, mt.get(623));
            i = 1;
        }
        k = k - 1;
    }
    mt.set(0, 2147483648);
    return IlRng { mt: mt, idx: 624 };
}

fn il_mag(y: i64) -> i64 {
    if (y & 1) == 1 { return 2567483615; }
    return 0;
}

@wrapping
fn il_u32(r: &mut IlRng) -> i64 {
    if r.idx >= 624 {
        var kk: i64 = 0;
        while kk < 227 {
            val y: i64 = (r.mt.get(kk) & 2147483648) | (r.mt.get(kk + 1) & 2147483647);
            r.mt.set(kk, r.mt.get(kk + 397) ^ (y >> 1) ^ il_mag(y));
            kk = kk + 1;
        }
        while kk < 623 {
            val y2: i64 = (r.mt.get(kk) & 2147483648) | (r.mt.get(kk + 1) & 2147483647);
            r.mt.set(kk, r.mt.get(kk - 227) ^ (y2 >> 1) ^ il_mag(y2));
            kk = kk + 1;
        }
        val y3: i64 = (r.mt.get(623) & 2147483648) | (r.mt.get(0) & 2147483647);
        r.mt.set(623, r.mt.get(396) ^ (y3 >> 1) ^ il_mag(y3));
        r.idx = 0;
    }
    var y: i64 = r.mt.get(r.idx);
    r.idx = r.idx + 1;
    y = y ^ (y >> 11);
    y = y ^ ((y << 7) & 2636928640);
    y = y ^ ((y << 15) & 4022730752);
    y = y ^ (y >> 18);
    return y & 4294967295;
}

/// random()
fn il_random(r: &mut IlRng) -> f64 {
    val a: i64 = il_u32(r) >> 5;
    val b: i64 = il_u32(r) >> 6;
    return ((a as f64) * 67108864.0 + (b as f64)) * (1.0 / 9007199254740992.0);
}

/// _randbelow(n), 0 < n < 2^32
fn il_below(r: &mut IlRng, n: i64) -> i64 {
    var k: i64 = 0;
    var m: i64 = n;
    while m > 0 {
        k = k + 1;
        m = m >> 1;
    }
    var v: i64 = il_u32(r) >> (32 - k);
    while v >= n { v = il_u32(r) >> (32 - k); }
    return v;
}

/// sample(range(n), k)
fn il_sample(r: &mut IlRng, n: i64, k: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec::new();
    var setsize: i64 = 21;
    if k > 5 {
        var p: i64 = 1;
        while p < 3 * k { p = p * 4; }
        setsize = setsize + p;
    }
    if n <= setsize {
        var pool: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < n {
            pool.push(i);
            i = i + 1;
        }
        i = 0;
        while i < k {
            val j: i64 = il_below(r, n - i);
            result.push(pool.get(j));
            pool.set(j, pool.get(n - i - 1));
            i = i + 1;
        }
        return result;
    }
    var selected: Vec<bool> = Vec::new();
    var z: i64 = 0;
    while z < n {
        selected.push(false);
        z = z + 1;
    }
    var i2: i64 = 0;
    while i2 < k {
        var j2: i64 = il_below(r, n);
        while selected.get(j2) { j2 = il_below(r, n); }
        selected.set(j2, true);
        result.push(j2);
        i2 = i2 + 1;
    }
    return result;
}

fn il_sort_ints(v: &mut Vec<i64>) {
    var i: i64 = 1;
    while i < v.len() {
        val x: i64 = v.get(i);
        var j: i64 = i - 1;
        while j >= 0 && v.get(j) > x {
            v.set(j + 1, v.get(j));
            j = j - 1;
        }
        v.set(j + 1, x);
        i = i + 1;
    }
}

/// repr() of a list of ints: "[0, 3]"
fn il_list(v: &Vec<i64>) -> str {
    var s: str = "[";
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 { s = s + ", "; }
        s = s + int_to_str(v.get(i));
        i = i + 1;
    }
    return s + "]";
}

// ─── One run ───

/// What one() returns: rc ("timeout" or the exit code), stdout ("\r"
/// removed), stderr, the CPU set and whether the machine was loaded.
struct IlRun {
    rc: str,
    out: str,
    err: str,
    cpus: Vec<i64>,
    loaded: bool,
}

/// A run in progress.
struct IlSlot {
    used: bool,
    index: i64,
    seed: i64,
    h: i64,
    burners: Vec<i64>,
    cpus: Vec<i64>,
    outp: str,
    errp: str,
    start: i64,
}

fn il_slot_free() -> IlSlot {
    return IlSlot { used: false, index: -1, seed: 0, h: 0, burners: Vec::new(), cpus: Vec::new(), outp: "", errp: "", start: 0 };
}

var il_sched_random: bool = false;
var il_burn_ms: i64 = 70000;
var il_self: str = "";

/// psutil.Process(pid).cpu_affinity(cpus); errors ignored as there.
@cfg(windows)
fn il_affinity(pid: i64, cpus: &Vec<i64>) {
    var mask: i64 = 0;
    var i: i64 = 0;
    while i < cpus.len() {
        if cpus.get(i) < 63 { mask = mask | (1 << cpus.get(i)); }
        i = i + 1;
    }
    // SAFETY: OpenProcess and SetProcessAffinityMask take integers; the
    // handle (PROCESS_SET_INFORMATION | PROCESS_QUERY_INFORMATION) is
    // closed before returning.
    unsafe {
        val h: i64 = il_open_process(512 | 1024, 0, pid);
        if h != 0 {
            il_set_affinity(h, mask);
            il_close_handle(h);
        }
    }
}

@cfg(unix)
fn il_affinity(pid: i64, cpus: &Vec<i64>) {
    var list: str = "";
    var i: i64 = 0;
    while i < cpus.len() {
        if i > 0 { list = list + ","; }
        list = list + int_to_str(cpus.get(i));
        i = i + 1;
    }
    var cmd: Vec<str> = Vec::new();
    cmd.push("taskset");
    cmd.push("-a");
    cmd.push("-p");
    cmd.push("-c");
    cmd.push(list);
    cmd.push(int_to_str(pid));
    process_run_argv(cmd, Vec::new(), "", 10000);
}

/// The first half of one(exe, seed, timeout): the draws, the busy loops,
/// the child started and pinned.
fn il_start(exe: str, seed: i64, index: i64, ncpu: i64) -> IlSlot {
    var r: IlRng = il_rng(seed);
    var env: Vec<str> = Vec::new();
    if il_sched_random && seed > 0 { env.push("FIDES_SCHED_RANDOM=" + int_to_str(seed)); }
    var half: i64 = ncpu / 2;
    if half < 1 { half = 1; }
    var choices: Vec<i64> = Vec::new();
    choices.push(1);
    choices.push(1);
    choices.push(2);
    choices.push(half);
    choices.push(ncpu);
    val k: i64 = choices.get(il_below(&mut r, 5));
    var cpus: Vec<i64> = il_sample(&mut r, ncpu, k);
    il_sort_ints(&mut cpus);
    var burners: Vec<i64> = Vec::new();
    if il_random(&mut r) < 0.5 {
        val nb: i64 = 1 + il_below(&mut r, 3);
        var b: i64 = 0;
        while b < nb {
            var bcmd: Vec<str> = Vec::new();
            bcmd.push(il_self);
            bcmd.push("--il-burn");
            bcmd.push(int_to_str(il_burn_ms));
            val bh: i64 = process_spawn(bcmd, Vec::new(), "");
            burners.push(bh);
            b = b + 1;
        }
    }
    val base: str = il_tmpname("run");
    val outp: str = base + ".out";
    val errp: str = base + ".err";
    var cmd: Vec<str> = Vec::new();
    cmd.push(exe);
    val h: i64 = process_spawn_files(cmd, env, "", outp, errp);
    if h != 0 { il_affinity(process_child_pid(h), &cpus); }
    return IlSlot { used: true, index: index, seed: seed, h: h, burners: burners, cpus: cpus, outp: outp, errp: errp, start: p_clock_now_ms() };
}

/// The second half: the result once the child has ended (or was killed
/// at the time limit); the busy loops stopped.
fn il_finish(s: &IlSlot, code: i64, timed_out: bool) -> IlRun {
    var i: i64 = 0;
    while i < s.burners.len() {
        val bh: i64 = s.burners.get(i);
        if bh != 0 {
            process_kill(bh);
            process_wait(bh, 10000);
            process_release(bh);
        }
        i = i + 1;
    }
    var rc: str = int_to_str(code);
    if timed_out { rc = "timeout"; }
    val out: str = str_replace(il_decode(fs_read_bytes(s.outp)), "\r", "");
    val err: str = il_decode(fs_read_bytes(s.errp));
    if fs_exists(s.outp) { fs_delete(s.outp); }
    if fs_exists(s.errp) { fs_delete(s.errp); }
    return IlRun { rc: rc, out: out, err: err, cpus: s.cpus.clone(), loaded: s.burners.len() > 0 };
}

/// one() over `seeds`, up to `shards` at a time; the results in seed order.
fn il_runs(exe: str, seeds: &Vec<i64>, shards: i64, timeout_s: i64, ncpu: i64) -> Vec<IlRun> {
    var results: Vec<IlRun> = Vec::new();
    var done: Vec<bool> = Vec::new();
    var i: i64 = 0;
    while i < seeds.len() {
        results.push(IlRun { rc: "", out: "", err: "", cpus: Vec::new(), loaded: false });
        done.push(false);
        i = i + 1;
    }
    var slots: Vec<IlSlot> = Vec::new();
    i = 0;
    while i < shards {
        slots.push(il_slot_free());
        i = i + 1;
    }
    var nxt: i64 = 0;
    var left: i64 = seeds.len();
    while left > 0 {
        var busy: bool = false;
        var k: i64 = 0;
        while k < slots.len() {
            if !slots.get(k).used && nxt < seeds.len() {
                slots.set(k, il_start(exe, seeds.get(nxt), nxt, ncpu));
                nxt = nxt + 1;
            }
            val s: IlSlot = slots.get(k);
            if s.used {
                var finished: bool = false;
                var code: i64 = -1;
                var timed_out: bool = false;
                if s.h == 0 {
                    // could not start: the script stops with a traceback
                    finished = true;
                    code = -1;
                } else {
                    match process_wait(s.h, 0) {
                        Option::Some(c) => {
                            finished = true;
                            code = il_code(c, true);
                        }
                        Option::None => {
                            if p_clock_now_ms() - s.start > timeout_s * 1000 {
                                process_kill(s.h);
                                process_wait(s.h, 10000);
                                finished = true;
                                timed_out = true;
                            }
                        }
                    }
                }
                if finished {
                    if s.h != 0 { process_release(s.h); }
                    results.set(s.index, il_finish(&s, code, timed_out));
                    done.set(s.index, true);
                    slots.set(k, il_slot_free());
                    left = left - 1;
                    busy = true;
                    // a free slot takes the nxt seed at once
                    continue;
                }
            }
            k = k + 1;
        }
        if !busy && left > 0 { task_sleep(5); }
    }
    return results;
}

/// One run on its own (the reference run).
fn il_one(exe: str, seed: i64, timeout_s: i64, ncpu: i64) -> IlRun {
    var seeds: Vec<i64> = Vec::new();
    seeds.push(seed);
    val r: Vec<IlRun> = il_runs(exe, &seeds, 1, timeout_s, ncpu);
    return r.get(0);
}

/// The program's '// Expected output' comment block; `found` false when
/// it has none (None).
fn il_expected(prog: str, found: &mut bool) -> str {
    *found = false;
    var text: str = "";
    match read_file(prog) {
        Option::Some(t) => { text = t; }
        Option::None => { return ""; }
    }
    val lines: Vec<str> = il_split(str_replace(text, "\r", ""), "\n");
    var i: i64 = 0;
    while i < lines.len() {
        val l: str = lines.get(i);
        if str_starts_with(l, "//") && str_contains(l, "Expected output") {
            var got: str = "";
            var n: i64 = 0;
            var j: i64 = i + 1;
            while j < lines.len() {
                val m: str = lines.get(j);
                if !str_starts_with(m, "// ") { break; }
                val body: str = str_slice(m, 3, str_len(m));
                if str_len(il_strip(body)) == 0 { break; }
                // m[3:].rstrip()
                var e: i64 = str_len(body);
                while e > 0 && il_ws(str_byte_at(body, e - 1)) { e = e - 1; }
                if n > 0 { got = got + "\n"; }
                got = got + str_slice(body, 0, e);
                n = n + 1;
                j = j + 1;
            }
            if n == 0 { return ""; }
            *found = true;
            return got;
        }
        i = i + 1;
    }
    return "";
}

/// time.strftime('%Y-%m-%d %H:%M')
fn il_now_text() -> str {
    var s: str = "";
    // SAFETY: an 8-byte block for time() to fill and a 64-byte one for
    // strftime (16 characters and a NUL are written); localtime's static
    // result is only read by strftime; both blocks are freed here.
    unsafe {
        val t: i64 = p_malloc(8);
        val buf: i64 = p_malloc(64);
        if t != 0 && buf != 0 {
            il_time(t);
            if il_strftime(buf, 64, "%Y-%m-%d %H:%M", il_localtime(t)) > 0 {
                s = p_str_from_ptr(buf);
            }
        }
        if t != 0 { p_free(t); }
        if buf != 0 { p_free(buf); }
    }
    return s;
}

struct IlConf {
    fid: str,
    shards: i64,
    sched_random: bool,
    record: str,
}

/// record(a, name, backend, runs, result, secs, distinct)
fn il_record(c: &IlConf, name: str, backend: str, runs: i64, result: str, secs: f64, distinct: i64) {
    if str_len(c.record) == 0 { return; }
    var text: str = "";
    if !fs_exists(c.record) {
        text = "| date | compiler | program | backend | runs | shards | mode | result | distinct | time |\n"
            + "|---|---|---|---|---|---|---|---|---|---|\n";
    }
    var mode: str = "OS scheduler";
    if c.sched_random { mode = "sched-random"; }
    text = text + "| " + il_now_text() + " | " + il_basename(c.fid) + " | " + name + " | " + backend + " | "
        + int_to_str(runs) + " | " + int_to_str(c.shards) + " | " + mode + " | " + result + " | " + int_to_str(distinct) + " | "
        + il_fixed(secs, 0) + " s |\n";
    fs_append_text(c.record, text);
}

fn il_bar(s: str) -> str {
    return str_replace(il_strip(s), "\n", " | ");
}

/// The hidden `--il-burn <ms>` mode: a busy loop until it is killed
/// (the script's burner thread), or after `ms` milliseconds (a run lasts
/// at most --timeout: a loop this tool did not stop, because it ended
/// first, stops by itself).
@wrapping
fn il_burn(ms: i64) -> i64 {
    var x: i64 = 0;
    val t0: i64 = p_clock_now_ms();
    while p_clock_now_ms() - t0 < ms {
        var i: i64 = 0;
        while i < 100000 {
            x = x + i * i;
            i = i + 1;
        }
        if x == 42 { println(""); }
    }
    return 0;
}

fn main() -> i64 {
    var av: Vec<str> = args_all();
    if av.len() >= 3 && av.get(1) == "--il-burn" { return il_burn(il_int(av.get(2))); }
    il_self = av.get(0);
    var rest: Vec<str> = Vec::new();
    var i: i64 = 1;
    while i < av.len() {
        rest.push(av.get(i));
        i = i + 1;
    }
    var opts: Vec<IlOpt> = Vec::new();
    opts.push(il_opt("--fid", "", IL_STR));           // 0
    opts.push(il_opt("", "-n", IL_INT));              // 1
    opts.push(il_opt("--shards", "", IL_INT));        // 2
    opts.push(il_opt("--backends", "", IL_STR));      // 3
    opts.push(il_opt("--programs", "", IL_STR));      // 4
    opts.push(il_opt("--timeout", "", IL_INT));       // 5
    opts.push(il_opt("--out", "", IL_STR));           // 6
    opts.push(il_opt("--sched-random", "", IL_FLAG)); // 7
    opts.push(il_opt("--seeds", "", IL_STR));         // 8
    opts.push(il_opt("--record", "", IL_STR));        // 9
    opts.push(il_opt("--help", "-h", IL_HELP));       // 10
    val a: IlArgs = il_parse(rest, opts);
    if a.code >= 0 { return a.code; }
    val fid: str = il_val(&a, 0, il_join("release", "fid.exe"));
    val n: i64 = il_int(il_val(&a, 1, "1000"));
    val shards: i64 = il_int(il_val(&a, 2, "4"));
    val backends: str = il_val(&a, 3, "ccompile,emit");
    val programs: str = il_val(&a, 4, il_join("tests", il_join("verify", "interleave.fd")));
    val timeout_s: i64 = il_int(il_val(&a, 5, "60"));
    il_burn_ms = timeout_s * 1000 + 10000;
    val out: str = il_val(&a, 6, il_join("build", "interleave"));
    il_sched_random = il_flag(&a, 7);
    val seeds_text: str = il_val(&a, 8, "");
    val conf: IlConf = IlConf { fid: fid, shards: shards, sched_random: il_sched_random, record: il_val(&a, 9, "") };
    var env: Vec<str> = Vec::new();
    if !il_has_env("CC") { env.push("CC=zig cc"); }
    il_makedirs(out);
    var seeds: Vec<i64> = Vec::new();
    if str_len(seeds_text) > 0 {
        val parts: Vec<str> = il_split(seeds_text, ",");
        i = 0;
        while i < parts.len() {
            if str_len(il_strip(parts.get(i))) > 0 {
                if !il_is_int(parts.get(i)) {
                    io_eprintln("ValueError: invalid literal for int() with base 10: " + il_repr(parts.get(i)));
                    return 1;
                }
                seeds.push(il_int(parts.get(i)));
            }
            i = i + 1;
        }
    } else {
        i = 1;
        while i <= n {
            seeds.push(i);
            i = i + 1;
        }
    }
    if shards <= 0 && seeds.len() > 0 {
        io_eprintln("ValueError: max_workers must be greater than 0");
        return 1;
    }
    val ncpu: i64 = sys_cpu_count();
    var allok: bool = true;
    val progs: Vec<str> = il_split(programs, ",");
    val bks: Vec<str> = il_split(backends, ",");
    var pi: i64 = 0;
    while pi < progs.len() {
        val prog: str = progs.get(pi);
        pi = pi + 1;
        var name: str = il_basename(prog);
        if str_len(name) >= 3 { name = str_slice(name, 0, str_len(name) - 3); } else { name = ""; }
        var has_want: bool = false;
        val want: str = il_expected(prog, &mut has_want);
        var bi: i64 = 0;
        while bi < bks.len() {
            val b: str = bks.get(bi);
            bi = bi + 1;
            val exe: str = il_abspath(il_join(out, name + "-" + b + ".exe"));
            var bcmd: Vec<str> = Vec::new();
            bcmd.push(fid);
            bcmd.push(b);
            bcmd.push(prog);
            bcmd.push("-o");
            bcmd.push(exe);
            il_locale_mode = true;
            val br: IlRes = il_run(bcmd, il_clone_list(&env), -1, false);
            il_locale_mode = false;
            if !br.started {
                io_eprintln(il_not_found(fid));
                return 1;
            }
            if br.code != 0 || !fs_exists(exe) {
                println(name + " " + b + ": build failed: " + il_ltail(br.out + br.err, 600));
                allok = false;
                il_record(&conf, name, b, seeds.len(), "build failed", 0.0, 0);
                continue;
            }
            val refr: IlRun = il_one(exe, 0, timeout_s, ncpu);
            if refr.rc == "-1" && !fs_exists(exe) {
                io_eprintln(il_not_found(exe));
                return 1;
            }
            val ref_ok: bool = refr.rc == "0" && (!has_want || il_strip(refr.out) == want);
            if has_want && il_strip(refr.out) != want {
                println("     " + name + " " + b + ": the reference run (seed 0) does not print the program's 'Expected output' block");
            }
            val t0: i64 = p_clock_now_ms();
            val res: Vec<IlRun> = il_runs(exe, &seeds, shards, timeout_s, ncpu);
            // outs: (rc, out) -> count, in first-seen order
            var keys_rc: Vec<str> = Vec::new();
            var keys_out: Vec<str> = Vec::new();
            var counts: Vec<i64> = Vec::new();
            var bad: Vec<i64> = Vec::new();
            var j: i64 = 0;
            while j < res.len() {
                val rr: IlRun = res.get(j);
                val seed: i64 = seeds.get(j);
                var at: i64 = -1;
                var q: i64 = 0;
                while q < keys_rc.len() {
                    if keys_rc.get(q) == rr.rc && keys_out.get(q) == rr.out { at = q; }
                    q = q + 1;
                }
                if at < 0 {
                    keys_rc.push(rr.rc);
                    keys_out.push(rr.out);
                    counts.push(1);
                } else {
                    counts.set(at, counts.get(at) + 1);
                }
                if str_len(seeds_text) > 0 {
                    var ld: str = "False";
                    if rr.loaded { ld = "True"; }
                    println("     seed " + int_to_str(seed) + ": exit " + rr.rc + ", cpus " + il_list(&rr.cpus) + ", loaded " + ld + ": "
                        + il_head(il_bar(rr.out), 200));
                }
                var wrong: bool = false;
                if has_want {
                    wrong = rr.rc != "0" || il_strip(rr.out) != want;
                } else {
                    wrong = rr.rc != refr.rc || rr.out != refr.out;
                }
                if wrong {
                    bad.push(seed);
                    if bad.len() <= 5 {
                        var ld2: str = "False";
                        if rr.loaded { ld2 = "True"; }
                        fs_write_text(il_join(out, name + "-" + b + "-seed" + int_to_str(seed) + ".out"),
                            "seed " + int_to_str(seed) + ", exit " + rr.rc + ", cpus " + il_list(&rr.cpus) + ", loaded " + ld2 + "\n"
                            + rr.out + "\n--- stderr ---\n" + il_tail(rr.err, 3000));
                    }
                }
                j = j + 1;
            }
            val secs: f64 = ((p_clock_now_ms() - t0) as f64) / 1000.0;
            val ok: bool = bad.len() == 0 && ref_ok;
            if !ok { allok = false; }
            var verdict: str = "FAIL";
            if ok { verdict = "PASS"; }
            println(verdict + " " + name + " " + b + ": " + int_to_str(seeds.len()) + " runs in " + il_fixed(secs, 0) + " s, "
                + int_to_str(keys_rc.len()) + " distinct result(s); reference exit " + refr.rc + ": " + il_bar(refr.out));
            // sorted by count, most first (stable: ties in first-seen order), the first four
            var order: Vec<i64> = Vec::new();
            j = 0;
            while j < counts.len() {
                var p: i64 = order.len();
                while p > 0 && counts.get(order.get(p - 1)) < counts.get(j) { p = p - 1; }
                order.insert(p, j);
                j = j + 1;
            }
            j = 0;
            while j < order.len() && j < 4 {
                val o: i64 = order.get(j);
                if (keys_rc.get(o) != refr.rc || keys_out.get(o) != refr.out) || !ref_ok {
                    println("     " + int_to_str(counts.get(o)) + " run(s): exit " + keys_rc.get(o) + ": " + il_head(il_bar(keys_out.get(o)), 120));
                }
                j = j + 1;
            }
            if bad.len() > 0 {
                var first: str = "";
                j = 0;
                while j < bad.len() && j < 10 {
                    if j > 0 { first = first + ","; }
                    first = first + int_to_str(bad.get(j));
                    j = j + 1;
                }
                var more: str = "";
                if bad.len() > 10 { more = " ..."; }
                var sr: str = "";
                if il_sched_random { sr = " --sched-random"; }
                println("     failing seeds: " + first + more + "; replay with: python scripts/verify/interleave.py --fid " + fid
                    + " --backends " + b + " --programs " + prog + sr + " --seeds " + first);
            }
            var rtext: str = "PASS";
            if !ok { rtext = "FAIL (" + int_to_str(bad.len()) + " wrong)"; }
            il_record(&conf, name, b, seeds.len(), rtext, secs, keys_rc.len());
        }
    }
    if allok { return 0; }
    return 1;
}
