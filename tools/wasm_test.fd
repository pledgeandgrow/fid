// tools/wasm_test.fd — run tests through the native WebAssembly backend:
// the Fides port of scripts/wasm-test.sh (roadmap AD4). Same arguments,
// the same environment (FID, JOBS, OUT, ALL, REUSE, LANE_SKIPS,
// WASM_LANE), the same files in $OUT and the same output and exit status
// (XT28: the lane's skips and `//@ backends:` lines, the Expected output
// block when the interpreter gives no reference: see the script):
//
//   fid ccompile tools/wasm_test.fd -o wasm_test.exe
//   wasm_test.exe [test.fd ...]
//   fid run tools/wasm_test.fd [test.fd ...]
//
// Run it from the repository root. Each test: `fid run` (120 s) is the
// reference; `fid wasm <test> -o $OUT/<test>.wasm` (600 s) builds it;
// `node tests/wasm/validate.mjs` must accept the module (else BUILD);
// `node scripts/wasm-run.mjs` (60 s) runs it under Node's WASI. Output,
// exit code and the panic's message are compared. Node stays: it is the
// WASI host (the two .mjs files are JavaScript).
//
// Differences: the steps of the tests run in three rounds (every run and
// build, then the validations, then the runs under Node), JOBS commands
// at a time, where the script runs each test's steps in turn, JOBS tests
// at a time: the same files, other timing; every child's stdin is at its
// end. A test's `//@ env: NAME=value` lines, which the script sets for its
// three commands, are not set here (tt_pool gives every command one
// environment): run such a test with the script.

use core;
use fs;
use io;
use process;
use target_test_lib;

fn wt_skip_re(base: str) -> bool {
    if !str_ends_with(base, ".fd") { return false; }
    val s: str = str_slice(base, 0, str_len(base) - 3);
    if str_starts_with(s, "test_bare") || str_starts_with(s, "test_pe_") || str_starts_with(s, "test_dll_") { return true; }
    val names: Vec<str> = str_split("test_comptime_basic test_comptime_func test_comptime_reflect test_comptime_serialize test_comptime_gen test_http test_json test_tensor test_autodiff test_kv_cache test_quantization test_checkpoint test_shard test_lora test_simd test_shape test_shape_verify test_wasm test_allocator test_effect_handler test_asm test_asm_pe test_boot test_interrupt test_mmu test_gat test_ffi_header test_dlopen test_game_stdlib test_kernel_serial test_serial_hello test_os_gaps test_phase8b test_vec_math test_sqlite test_parse_header_sqlite test_lib_sdl test_lib_gl test_lib_font test_lib_image test_lib_audio test_lib_audio_mixer test_lib_shader test_lib_mesh test_elf_native", " ");
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == s { return true; }
        i = i + 1;
    }
    return false;
}

/// The first line of `text` holding (any case) error, not available,
/// panic or INVALID, cut to 160 bytes ("" when none); the compiler's
/// [build] / [prof] lines left out.
fn wt_grep_build(text: str) -> str {
    val lines: Vec<str> = tt_lines(text);
    var i: i64 = 0;
    while i < lines.len() {
        val l: str = lines.get(i);
        i = i + 1;
        // the compiler's progress lines ("[build] ... Checking errors...")
        if str_starts_with(l, "[build]") || str_starts_with(l, "[prof]") { continue; }
        val low: str = str_to_lower(l);
        if str_contains(low, "error") || str_contains(low, "not available") || str_contains(low, "panic") || str_contains(low, "invalid") {
            if str_len(l) > 160 { return str_slice(l, 0, 160); }
            return l;
        }
    }
    return "";
}

/// A lane-skips line's three fields: the pattern, the test, the reason
/// (`read -r spat stest swhy`)
fn wt_read3(line: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    val n: i64 = str_len(line);
    var w: i64 = 0;
    while w < 2 {
        while i < n && (str_byte_at(line, i) == 32 || str_byte_at(line, i) == 9) { i = i + 1; }
        var j: i64 = i;
        while j < n && str_byte_at(line, j) != 32 && str_byte_at(line, j) != 9 { j = j + 1; }
        out.push(str_slice(line, i, j));
        i = j;
        w = w + 1;
    }
    while i < n && (str_byte_at(line, i) == 32 || str_byte_at(line, i) == 9) { i = i + 1; }
    out.push(tt_trim_blanks(str_slice(line, i, n)));
    return out;
}

/// XT28: the test's `//@ backends:` list without blanks ("" when none)
fn wt_backends(path: str) -> str {
    val lines: Vec<str> = tt_lines(tt_read(path));
    var i: i64 = 0;
    while i < lines.len() {
        val l: str = tt_drop_cr(lines.get(i));
        i = i + 1;
        if str_starts_with(l, "//@ backends:") {
            var v: str = str_slice(l, 13, str_len(l));
            v = str_replace(v, " ", "");
            return str_replace(v, "\t", "");
        }
    }
    return "";
}

/// XT28: what the interpreter cannot do, so that its run is no reference
/// (wasm-test.sh interp_no_ref): call C, a builtin it lacks, its memory
/// limit, its recursion limit, the fid process itself out of memory
fn wt_interp_no_ref(err: str) -> bool {
    if str_contains(err, "is not available in the interpreter") || str_contains(err, "the interpreter holds at most") { return true; }
    val lines: Vec<str> = tt_lines(err);
    var i: i64 = 0;
    while i < lines.len() {
        val l: str = lines.get(i);
        i = i + 1;
        if str_starts_with(l, "Panic: a C function pointer ") && str_contains(l, " can only be called in a C build") { return true; }
        if str_starts_with(l, "Panic: Unknown runtime function") { return true; }
        if str_starts_with(l, "Panic: Recursion depth limit (") && str_contains(l, ") exceeded") { return true; }
        if str_starts_with(l, "Panic: out of memory (allocating ") && str_contains(l, " bytes)") { return true; }
    }
    return false;
}

/// The first "Panic:" line of `text` ("" when none)
fn wt_first_panic(text: str) -> str {
    val lines: Vec<str> = tt_lines(text);
    var i: i64 = 0;
    while i < lines.len() {
        if str_starts_with(lines.get(i), "Panic:") { return tt_no_cr(lines.get(i)); }
        i = i + 1;
    }
    return "";
}

fn wt_v3(a: str, b: str, c: str) -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    return v;
}

fn main() -> i64 {
    val args: Vec<str> = tt_args();
    val host: str = tt_host();
    var fid: str = tt_env("FID");
    if str_len(fid) == 0 {
        if host == "windows" { fid = "release/fid.exe"; } else { fid = "release/fid"; }
    }
    val jobs_s: str = tt_env_or("JOBS", "4");
    val jobs: i64 = str_parse_int(jobs_s);
    val out: str = tt_env_or("OUT", "build/wasm-native");
    tt_mkdir_p(out);

    var tests: Vec<str> = Vec::new();
    if args.len() > 0 {
        tests = args;
    } else if tt_env("ALL") == "1" {
        val files: Vec<str> = tt_glob("tests/bootstrap", "", ".fd");
        var i: i64 = 0;
        while i < files.len() {
            val f: str = files.get(i);
            i = i + 1;
            val b: str = str_slice(f, 16, str_len(f));
            if str_starts_with(b, "test_panic_") && str_ends_with(b, "_fail.fd") && str_len(b) >= 19 {
                tests.push(f);
                continue;
            }
            if str_ends_with(b, "_fail.fd") || str_ends_with(b, "_fail2.fd") { continue; }
            if wt_skip_re(b) && !str_starts_with(b, "test_wasm_") { continue; }
            if tt_head3_has(f, "expect-error") { continue; }
            tests.push(f);
        }
    } else {
        val ws: Vec<str> = tt_glob("tests/bootstrap", "test_wasm_", ".fd");
        var i2: i64 = 0;
        while i2 < ws.len() {
            tests.push(ws.get(i2));
            i2 = i2 + 1;
        }
        val more: Vec<str> = str_split("test_int_semantics test_panic_overflow_fail test_panic_div_zero_fail test_panic_min_div_fail", " ");
        i2 = 0;
        while i2 < more.len() {
            tests.push("tests/bootstrap/" + more.get(i2) + ".fd");
            i2 = i2 + 1;
        }
    }
    // XT28: the tests left out on this lane (scripts/lane-skips.txt, whose
    // patterns are matched against WASM_LANE, and a `//@ backends:` line
    // that does not name wasm), "SKIP  <test> (<reason>)" in the results
    val lane_skips: str = tt_env_or("LANE_SKIPS", "scripts/lane-skips.txt");
    val lane: str = tt_env_or("WASM_LANE", "wasm32-wasi-native");
    var ls_names: Vec<str> = Vec::new();
    var ls_why: Vec<str> = Vec::new();
    if lane_skips != "/dev/null" && fs_exists(lane_skips) && !fs_is_dir(lane_skips) {
        val parts: Vec<str> = str_split(tt_read(lane_skips), "\n");
        var li: i64 = 0;
        while li + 1 < parts.len() {
            val lw: Vec<str> = wt_read3(parts.get(li));
            li = li + 1;
            var spat: str = lw.get(0);
            if str_len(spat) == 0 || str_starts_with(spat, "#") { continue; }
            var neg: bool = false;
            if str_starts_with(spat, "!") {
                neg = true;
                spat = str_slice(spat, 1, str_len(spat));
            }
            if tt_case_match(lane, spat) != neg {
                ls_names.push(tt_drop_cr(lw.get(1)));
                val swhy: str = tt_drop_cr(lw.get(2));
                if str_len(swhy) > 0 { ls_why.push(swhy); } else { ls_why.push("skipped on " + lane); }
            }
        }
    }
    var bi: i64 = 0;
    while bi < tests.len() {
        val bl: str = wt_backends(tests.get(bi));
        if str_len(bl) > 0 && !str_contains("," + bl + ",", ",wasm,") {
            ls_names.push(tt_base(tests.get(bi)));
            ls_why.push("its //@ backends: line is " + bl);
        }
        bi = bi + 1;
    }
    val all_tests: Vec<str> = tests;
    tests = Vec::new();
    var lskip: i64 = 0;
    bi = 0;
    while bi < all_tests.len() {
        val tb: str = tt_base(all_tests.get(bi));
        var listed: bool = false;
        var k0: i64 = 0;
        while k0 < ls_names.len() && !listed {
            if ls_names.get(k0) == tb { listed = true; }
            k0 = k0 + 1;
        }
        if listed { lskip = lskip + 1; } else { tests.push(all_tests.get(bi)); }
        bi = bi + 1;
    }
    // in the list's order, as the script prints them
    var skipped_lines: Vec<str> = Vec::new();
    var k1: i64 = 0;
    while k1 < ls_names.len() {
        var t1: i64 = 0;
        while t1 < all_tests.len() {
            if tt_base(all_tests.get(t1)) == ls_names.get(k1) {
                skipped_lines.push("SKIP  " + ls_names.get(k1) + " (" + ls_why.get(k1) + ")");
                break;
            }
            t1 = t1 + 1;
        }
        k1 = k1 + 1;
    }
    var head_line: str = "fid wasm: " + int_to_str(tests.len()) + " tests, " + jobs_s + " at a time, output in " + out;
    if lskip > 0 { head_line = head_line + " (" + int_to_str(lskip) + " skipped on " + lane + ")"; }
    println(head_line);

    var env: Vec<str> = Vec::new();
    env.push("FID=" + fid);
    env.push("OUT=" + out);
    val reuse: bool = tt_env("REUSE") == "1";
    // round 1: the reference run and the build of each test
    var todo: Vec<str> = Vec::new();
    var cmds: Vec<str> = Vec::new();
    var outs: Vec<str> = Vec::new();
    var errs: Vec<str> = Vec::new();
    var secs: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < tests.len() {
        val f: str = tests.get(i);
        i = i + 1;
        val b: str = tt_base(f);
        if reuse && fs_exists(out + "/" + b + ".actual_rc") { continue; }
        todo.push(f);
        cmds.push(tt_pack(wt_v3(fid, "run", f)));
        outs.push(out + "/" + b + ".expected");
        errs.push(out + "/" + b + ".expected_err");
        secs.push(120);
        var bc: Vec<str> = wt_v3(fid, "wasm", f);
        bc.push("-o");
        bc.push(out + "/" + b + ".wasm");
        cmds.push(tt_pack(bc));
        outs.push(out + "/" + b + ".build.log");
        errs.push("");
        secs.push(600);
    }
    val c1: Vec<i64> = tt_pool(cmds, env, outs, errs, secs, jobs);
    // round 2: the engine must validate what built
    var built: Vec<str> = Vec::new();
    cmds = Vec::new();
    outs = Vec::new();
    errs = Vec::new();
    secs = Vec::new();
    i = 0;
    while i < todo.len() {
        val b: str = tt_base(todo.get(i));
        fs_write_text(out + "/" + b + ".expected_rc", int_to_str(c1.get(2 * i)) + "\n");
        val rc: i64 = c1.get(2 * i + 1);
        fs_write_text(out + "/" + b + ".build_rc", int_to_str(rc) + "\n");
        i = i + 1;
        if rc != 0 { continue; }
        built.push(b);
        cmds.push(tt_pack(wt_v3("node", "tests/wasm/validate.mjs", out + "/" + b + ".wasm")));
        outs.push(out + "/" + b + ".valid.log");
        errs.push("");
        secs.push(0);
    }
    val c2: Vec<i64> = tt_pool(cmds, env, outs, errs, secs, jobs);
    // round 3: run what is valid under Node
    var valid: Vec<str> = Vec::new();
    cmds = Vec::new();
    outs = Vec::new();
    errs = Vec::new();
    secs = Vec::new();
    i = 0;
    while i < built.len() {
        val b: str = built.get(i);
        val ok: bool = c2.get(i) == 0;
        i = i + 1;
        if !ok {
            val pre: str = out + "/" + b;
            fs_write_text(pre + ".build.log", tt_read(pre + ".build.log") + tt_read(pre + ".valid.log"));
            fs_write_text(pre + ".build_rc", "1\n");
            continue;
        }
        valid.push(b);
        cmds.push(tt_pack(wt_v3("node", "scripts/wasm-run.mjs", out + "/" + b + ".wasm")));
        outs.push(out + "/" + b + ".actual");
        errs.push(out + "/" + b + ".stderr");
        secs.push(60);
    }
    val c3: Vec<i64> = tt_pool(cmds, env, outs, errs, secs, jobs);
    i = 0;
    while i < valid.len() {
        fs_write_text(out + "/" + valid.get(i) + ".actual_rc", int_to_str(c3.get(i)) + "\n");
        i = i + 1;
    }

    // compare
    var pass: i64 = 0;
    var fail: i64 = 0;
    var berr: i64 = 0;
    var skip: i64 = 0;
    val res: str = out + "/results.txt";
    fs_write_text(res, "");
    i = 0;
    while i < skipped_lines.len() {
        tt_append_line(res, skipped_lines.get(i));
        i = i + 1;
    }
    i = 0;
    while i < tests.len() {
        val f: str = tests.get(i);
        i = i + 1;
        val b: str = tt_base(f);
        val pre: str = out + "/" + b;
        val erc: str = tt_cat(pre + ".expected_rc");
        var compile_err: bool = false;
        var ci: i64 = 0;
        val refs: Vec<str> = wt_v3(pre + ".expected", pre + ".expected_err", "");
        while ci < 2 {
            if tt_has_line_prefix(refs.get(ci), "Compilation error") || tt_has_line_prefix(refs.get(ci), "error: ") { compile_err = true; }
            ci = ci + 1;
        }
        if compile_err {
            tt_append_line(res, "SKIP  " + b + " (fid run gives no reference: a compile error)");
            skip = skip + 1;
            continue;
        }
        // XT28: no reference from the interpreter: the test's own
        // `// Expected output:` block is (as in cross-test.sh)
        var whyblock: str = "";
        val eerr: str = tt_read(pre + ".expected_err");
        if erc == "124" {
            whyblock = "fid run timed out";
        } else if wt_interp_no_ref(eerr) {
            var pl: str = wt_first_panic(eerr);
            var pe: i64 = str_len(pl);
            if pe > 80 { pe = 80; }
            if pe > 7 { pl = str_slice(pl, 7, pe); } else { pl = ""; }
            whyblock = "fid run: " + pl;
        }
        var byblock: bool = false;
        if str_len(whyblock) > 0 {
            if !str_contains(tt_read(f), "\n// Expected output:") && !str_starts_with(tt_read(f), "// Expected output:") {
                tt_append_line(res, "SKIP  " + b + " (no reference: " + whyblock + ", and the test has no Expected output)");
                skip = skip + 1;
                continue;
            }
            byblock = true;
        }
        if tt_cat(pre + ".build_rc") != "0" {
            tt_append_line(res, "BUILD " + b + ": " + wt_grep_build(tt_read(pre + ".build.log")));
            berr = berr + 1;
            continue;
        }
        val sl: Vec<str> = tt_lines(tt_read(pre + ".stderr"));
        var na: str = "";
        var k: i64 = 0;
        while k < sl.len() {
            if str_starts_with(sl.get(k), "Panic: not available in WebAssembly") {
                na = sl.get(k);
                break;
            }
            k = k + 1;
        }
        if str_len(na) > 0 {
            var e: i64 = str_len(na);
            if e > 120 { e = 120; }
            tt_append_line(res, "SKIP  " + b + " (" + str_slice(na, 7, e) + ")");
            skip = skip + 1;
            continue;
        }
        val arc: str = tt_cat(pre + ".actual_rc");
        if byblock {
            val blk: str = tt_block_of(f, true);
            fs_write_text(pre + ".expected_block", blk);
            val xrc: str = tt_block_exit_of(f);
            if arc == xrc && tt_same_lines(tt_no_cr(tt_read(pre + ".actual")), blk, true) {
                tt_append_line(res, "PASS  " + b);
                pass = pass + 1;
            } else {
                tt_append_line(res, "FAIL  " + b + " (rc " + arc + ", its Expected output: rc " + xrc + "; " + whyblock + ")");
                fail = fail + 1;
            }
            continue;
        }
        if arc == erc && tt_panic_key(pre + ".expected_err", true) == tt_panic_key(pre + ".stderr", true) && tt_no_cr(tt_read(pre + ".expected")) == tt_no_cr(tt_read(pre + ".actual")) {
            tt_append_line(res, "PASS  " + b);
            pass = pass + 1;
        } else {
            tt_append_line(res, "FAIL  " + b + " (rc " + arc + ", interpreter " + erc + ")");
            fail = fail + 1;
        }
    }
    val rl: Vec<str> = tt_lines(tt_read(res));
    var shown: i64 = 0;
    i = 0;
    while i < rl.len() && shown < 60 {
        val l: str = rl.get(i);
        i = i + 1;
        if str_starts_with(l, "PASS") { continue; }
        println(l);
        shown = shown + 1;
    }
    skip = skip + lskip;
    println("fid wasm: " + int_to_str(pass) + " passed, " + int_to_str(fail) + " failed, " + int_to_str(berr) + " did not build, " + int_to_str(skip) + " skipped (of " + int_to_str(all_tests.len()) + ")");
    if fail == 0 && berr == 0 { return 0; }
    return 1;
}
