// tools/gen_brotli_dict.fd — stdlib/brotli_dict.fd from brotli's static
// dictionary: the Fides port of scripts/gen-brotli-dict.py (roadmap AD4).
// Same command line, the same file written byte for byte, the same lines
// on stdout and stderr, the same exit status:
//
//   fid ccompile tools/gen_brotli_dict.fd -o gen_brotli_dict.exe
//   gen_brotli_dict.exe path/to/dictionary.bin [out.fd]
//
// The dictionary (122,784 bytes, RFC 7932 Appendix A) is google/brotli's
// c/common/dictionary.bin (MIT licence, Copyright Google Inc.). It is
// stored as base64 text in 40 string literals of 4096 characters (3072
// bytes) each, so stdlib/brotli.fd can read any byte without decoding the
// whole thing and native executables carry it with them. The output
// defaults to stdlib/brotli_dict.fd (the script finds it from its own
// path, scripts/../stdlib; here it is <current directory>/scripts/../stdlib:
// run it from the repository root, as the script is). What was written is
// decoded back to bytes (every `return "<base64>";` literal, as the
// script's regular expression finds them) and must equal the input.
//
// Differences from the script: a file that cannot be read gives one line,
// "FileNotFoundError: [Errno 2] No such file or directory: '<path>'" (or
// "IsADirectoryError: ..." for a directory), where Python prints a
// traceback ending in that line (likewise when the output cannot be
// written); exit status 1 as there.

use core;
use args;
use fs;
use io;
use crypto;
use encoding;
use process;

const GB_DICT_SIZE: i64 = 122784;
const GB_DICT_SHA256: str = "20e42eb1b511c21806d4d227d07e5dd06877d8ce7b3a817f378f313653f35c70";
/// Bytes per literal: 4096 base64 characters, no padding.
const GB_CHUNK: i64 = 3072;

/// The script's docstring, which it prints (to stderr, exit 1) when it is
/// given no file.
fn gb_doc() -> str {
    var d: str = "Generate stdlib/brotli_dict.fd: the brotli static dictionary as Fides data.\n\n";
    d = d + "The dictionary (122,784 bytes, RFC 7932 Appendix A) is google/brotli's\n";
    d = d + "c/common/dictionary.bin (MIT licence, Copyright Google Inc.). It is stored\n";
    d = d + "as base64 text in 40 string literals of 4096 characters (3072 bytes) each,\n";
    d = d + "so stdlib/brotli.fd can read any byte without decoding the whole thing and\n";
    d = d + "native executables carry it with them (they run without the stdlib).\n\n";
    d = d + "Usage:\n";
    d = d + "    python scripts/gen-brotli-dict.py path/to/dictionary.bin [out.fd]\n\n";
    d = d + "The output defaults to stdlib/brotli_dict.fd next to this script. The script\n";
    d = d + "decodes what it wrote back to bytes and checks they equal the input.\n";
    return d;
}

fn gb_slice(data: &Vec<i64>, a: i64, b: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = a;
    while i < b && i < data.len() {
        out.push(data.get(i));
        i = i + 1;
    }
    return out;
}

fn gb_lit(data: &Vec<i64>, k: i64) -> str {
    return b64_encode_bytes(gb_slice(data, k * GB_CHUNK, (k + 1) * GB_CHUNK));
}

/// generate(data): the text of brotli_dict.fd.
fn gb_generate(data: &Vec<i64>) -> str {
    val n: i64 = data.len();
    val nchunks: i64 = (n + GB_CHUNK - 1) / GB_CHUNK;
    val last: i64 = n - (nchunks - 1) * GB_CHUNK;
    var o: str = "// The brotli static dictionary (RFC 7932 Appendix A), as data.\n";
    o = o + "//\n";
    o = o + "// GENERATED by scripts/gen-brotli-dict.py from google/brotli's\n";
    o = o + "// c/common/dictionary.bin. Do not edit by hand.\n";
    o = o + "//\n";
    o = o + "// Copyright Google Inc. Distributed under the MIT licence (the brotli\n";
    o = o + "// project's licence: https://github.com/google/brotli/blob/master/LICENSE).\n";
    o = o + "//\n";
    o = o + "// " + int_to_str(n) + " bytes, sha256 " + crypto_sha256_hex(crypto_sha256_bytes(data.clone())) + ",\n";
    o = o + "// stored as base64 in " + int_to_str(nchunks) + " literals of " + int_to_str(GB_CHUNK) + " bytes\n";
    o = o + "// (" + int_to_str(GB_CHUNK * 4 / 3) + " characters) each; the last holds " + int_to_str(last) + " bytes.\n";
    o = o + "// stdlib/brotli.fd decodes the bytes it needs (dict_byte).\n";
    o = o + "\nmodule brotli_dict;\n\n";
    o = o + "/// Size of the dictionary in bytes.\npub fn brotli_dict_size() -> i64 { return " + int_to_str(n) + "; }\n\n";
    o = o + "/// Bytes held by each chunk (every chunk but the last).\npub fn brotli_dict_chunk_bytes() -> i64 { return " + int_to_str(GB_CHUNK) + "; }\n\n";
    o = o + "/// Chunk `i` (0-based) of the dictionary as base64 text, or \"\" past\n";
    o = o + "/// the end.\n";
    o = o + "pub fn brotli_dict_chunk(i: i64) -> str {\n";
    // the if-chain split in two halves
    val half: i64 = (nchunks + 1) / 2;
    o = o + "    if i < " + int_to_str(half) + " {\n";
    var k: i64 = 0;
    while k < half {
        o = o + "        if i == " + int_to_str(k) + " { return \"" + gb_lit(data, k) + "\"; }\n";
        k = k + 1;
    }
    o = o + "        return \"\";\n    }\n";
    k = half;
    while k < nchunks {
        o = o + "    if i == " + int_to_str(k) + " { return \"" + gb_lit(data, k) + "\"; }\n";
        k = k + 1;
    }
    o = o + "    return \"\";\n}\n";
    return o;
}

fn gb_b64_char(c: i64) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 43 || c == 47 || c == 61;
}

/// check(text, data): re.findall(r'return "([A-Za-z0-9+/=]+)";', text),
/// each decoded, joined; false when that is not `data`.
fn gb_check(text: str, data: &Vec<i64>) -> bool {
    val pat: str = "return \"";
    val n: i64 = str_len(text);
    var back: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i + str_len(pat) <= n {
        if str_byte_at(text, i) == 114 && str_slice(text, i, i + str_len(pat)) == pat {
            var j: i64 = i + str_len(pat);
            while j < n && gb_b64_char(str_byte_at(text, j)) { j = j + 1; }
            if j > i + str_len(pat) && j + 1 < n && str_byte_at(text, j) == 34 && str_byte_at(text, j + 1) == 59 {
                val b: Vec<i64> = b64_decode_bytes(str_slice(text, i + str_len(pat), j));
                var q: i64 = 0;
                while q < b.len() {
                    back.push(b.get(q));
                    q = q + 1;
                }
                i = j + 2;
                continue;
            }
        }
        i = i + 1;
    }
    if back.len() != data.len() { return false; }
    i = 0;
    while i < back.len() {
        if back.get(i) != data.get(i) { return false; }
        i = i + 1;
    }
    return true;
}

// ─── Paths (os.path as on this system) ───

fn gb_win() -> bool {
    return process_is_windows();
}

extern "C" {
    fn getcwd(buf: i64, n: i64) -> i64;
}

/// os.getcwd()
fn gb_cwd() -> str {
    var cwd: str = "";
    var buf: i64 = 0;
    // SAFETY: a fresh 4096-byte buffer; getcwd writes at most that many
    // bytes, NUL included, and the result is copied out before it is freed.
    unsafe {
        buf = p_malloc(4096);
        if buf != 0 {
            if getcwd(buf, 4096) != 0 {
                cwd = p_str_from_ptr(buf);
            }
            p_free(buf);
        }
    }
    if str_len(cwd) == 0 { cwd = "."; }
    return cwd;
}

/// Python's repr() of a str (ASCII; other bytes as they are).
fn gb_repr(s: str) -> str {
    var q: str = "'";
    if str_contains(s, "'") && !str_contains(s, "\"") { q = "\""; }
    var out: str = q;
    var i: i64 = 0;
    while i < str_len(s) {
        val c: i64 = str_byte_at(s, i);
        i = i + 1;
        if char_to_str(c) == q || c == 92 {
            out = out + "\\" + char_to_str(c);
        } else if c == 9 {
            out = out + "\\t";
        } else if c == 10 {
            out = out + "\\n";
        } else if c == 13 {
            out = out + "\\r";
        } else {
            out = out + char_to_str(c);
        }
    }
    return out + q;
}

fn main() -> i64 {
    val av: Vec<str> = args_all();
    if av.len() < 2 {
        // raise SystemExit(__doc__): the text and a newline on stderr
        io_eprint(gb_doc() + "\n");
        return 1;
    }
    val path: str = av.get(1);
    if fs_is_dir(path) {
        if gb_win() {
            io_eprintln("PermissionError: [Errno 13] Permission denied: " + gb_repr(path));
        } else {
            io_eprintln("IsADirectoryError: [Errno 21] Is a directory: " + gb_repr(path));
        }
        return 1;
    }
    if !fs_exists(path) {
        io_eprintln("FileNotFoundError: [Errno 2] No such file or directory: " + gb_repr(path));
        return 1;
    }
    val data: Vec<i64> = fs_read_bytes(path);
    if data.len() != GB_DICT_SIZE {
        io_eprintln("expected " + int_to_str(GB_DICT_SIZE) + " bytes, got " + int_to_str(data.len()));
        return 1;
    }
    val digest: str = crypto_sha256_hex(crypto_sha256_bytes(data.clone()));
    if digest != GB_DICT_SHA256 {
        println("warning: sha256 " + digest + " is not the known " + GB_DICT_SHA256);
    }
    var out_path: str = "";
    if av.len() > 2 {
        out_path = av.get(2);
    } else {
        // os.path.join(abspath(dirname(__file__)), "..", "stdlib", "brotli_dict.fd")
        var sep: str = "/";
        if gb_win() { sep = "\\"; }
        out_path = gb_cwd() + sep + "scripts" + sep + ".." + sep + "stdlib" + sep + "brotli_dict.fd";
        if gb_win() { out_path = str_replace(out_path, "/", "\\"); }
    }
    val text: str = gb_generate(&data);
    if !gb_check(text, &data) {
        io_eprintln("round trip FAILED: generated data differs from input");
        return 1;
    }
    if !fs_write_text(out_path, text) {
        io_eprintln("FileNotFoundError: [Errno 2] No such file or directory: " + gb_repr(out_path));
        return 1;
    }
    println("wrote " + out_path + ": " + int_to_str(str_len(text)) + " characters, round trip ok");
    return 0;
}
