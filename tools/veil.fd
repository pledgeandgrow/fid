// tools/veil.fd -- the standalone `veil` coverage tool (AD1, release N8):
// compiler/veil.fd's coverage run, with the command line of the Rust veil
// (src/bin/veil.rs): options anywhere, -f/-o short forms, --help/-h (exit
// 0), --version/-v, one input file; an error goes to stderr with exit 1.
// `fid veil` keeps compiler/veil.fd's veil_main.
//
//   fid ccompile tools/veil.fd -o veil.exe        (CC="zig cc")
//   veil <file.fd> [--format text|html] [--output <dir>]
use core;
use compiler::veil;

/// Command-line argument `i`, "" past the last.
fn veil_tool_arg(i: i64) -> str {
    match arg_at(i) {
        Option::Some(a) => {
            return a;
        }
        Option::None => {
        }
    }
    return "";
}

/// Is `message` (from veil_run) a failure?
fn veil_tool_failed(message: str) -> bool {
    return str_starts_with(message, "Cannot read ") || str_contains(message, "\nError: could not write ") || str_starts_with(message, "Compilation failed");
}

fn main() -> i64 {
    val n: i64 = p_argc();
    if n <= 1 {
        print(veil_print_help());
        return 1;
    }
    var input: str = "";
    var have_input: bool = false;
    var format: str = "text";
    var output_dir: str = "coverage";
    var i: i64 = 1;
    while i < n {
        val a: str = veil_tool_arg(i);
        if a == "--format" || a == "-f" {
            if i + 1 < n {
                format = veil_tool_arg(i + 1);
            }
            i = i + 1;
        } else if a == "--output" || a == "-o" {
            if i + 1 < n {
                output_dir = veil_tool_arg(i + 1);
            }
            i = i + 1;
        } else if a == "--help" || a == "-h" {
            print(veil_print_help());
            return 0;
        } else if a == "--version" || a == "-v" {
            print("veil 0.1.0 -- Fides code coverage tool\n");
            return 0;
        } else if !have_input {
            input = a;
            have_input = true;
        } else {
            p_eprint_str("Unknown argument: " + a + "\n");
            return 1;
        }
        i = i + 1;
    }
    if !have_input {
        p_eprint_str("Error: no input file specified\nRun 'veil --help' for usage.\n");
        return 1;
    }
    var message: str = veil_run(input, format, output_dir);
    if veil_tool_failed(message) {
        // the compile errors as src/bin/veil.rs prints them: "error: <errors>"
        if str_starts_with(message, "Compilation failed:\n") {
            message = str_slice(message, 20, str_len(message));
        }
        p_eprint_str("error: " + message + "\n");
        return 1;
    }
    print(message);
    print("\n");
    return 0;
}
