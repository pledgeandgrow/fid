struct Holder2 {
    a: Vec<i64>,
    b: Vec<i64>,
    c: Vec<f64>,
}

fn alen(h: &Holder2) -> i64 {
    return h.a.len();
}

fn clen(h: &Holder2) -> i64 {
    return h.c.len();
}

fn main() -> i64 {
    var v1: Vec<i64> = Vec::new(); v1.push(1); v1.push(2);
    var v2x: Vec<i64> = Vec::new(); v2x.push(3);
    var v3: Vec<f64> = Vec::new(); v3.push(9.0);
    var h: Holder2 = Holder2 { a: v1, b: v2x, c: v3 };
    print(h.a.len());
    print(alen(&h));
    print(clen(&h));
    return 0;
}
