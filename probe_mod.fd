module probe_mod;

pub struct PHolder {
    pub v: Vec<i64>,
}

pub fn ph_new(v: Vec<i64>) -> PHolder {
    return PHolder { v: v };
}

pub struct PHolder3 {
    pub a: Vec<i64>,
    pub b: Vec<i64>,
    pub c: Vec<f64>,
}

pub fn ph3_new(a: Vec<i64>, b: Vec<i64>, c: Vec<f64>) -> PHolder3 {
    return PHolder3 { a: a, b: b, c: c };
}
