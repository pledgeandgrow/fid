// Fides Markdown standard library
//
// Markdown → HTML rendering for the common subset:
//   # .. ###### headings, **bold**, *italic*, `code`, [text](url),
//   ![alt](src), -/*/1. lists, > blockquotes, ``` code fences,
//   --- horizontal rules, paragraphs, <http://autolinks>, backslash
//   escapes; fences and list items may be indented, and an item goes on
//   over its continuation lines.
// Not supported: tables, footnotes, nested lists (items are flattened),
// nested emphasis edge cases, reference-style links, HTML blocks (HTML is
// escaped, so untrusted Markdown cannot inject markup).
//
// Usage:
//   use markdown;
//   println(md_to_html("# Hello\n\nSome **bold** text."));

module markdown;
use vec;
use string;
// ─── HTML escaping ──────────────────────────────────────────────────────

/// Escape & < > " for HTML text contexts.
pub fn md_escape(s: str) -> str {
    var out: str = "";
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i < n {
        var c: i64 = str_byte_at(s, i);
        if c == 38 {
            out = out + "&amp;";
        } else if c == 60 {
            out = out + "&lt;";
        } else if c == 62 {
            out = out + "&gt;";
        } else if c == 34 {
            out = out + "&quot;";
        } else {
            out = out + str_slice(s, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

/// URL filter for rendered links and images: javascript:, vbscript: and
/// data: URLs are active content in an HTML page — they become "#" (the
/// link renders inert rather than executing script on click).
pub fn md_safe_url(u: str) -> str {
    var t: str = str_to_lower(str_trim(u));
    if str_starts_with(t, "javascript:") {
        return "#";
    }
    if str_starts_with(t, "vbscript:") {
        return "#";
    }
    if str_starts_with(t, "data:") {
        return "#";
    }
    return u;
}

// ─── Inline rendering ───────────────────────────────────────────────────

// Find matching '*' or '**' run starting at `from`; returns index after
// the closing delimiter or -1.
fn md_find_star(s: str, from: i64, len: i64) -> i64 {
    var i: i64 = from;
    var n: i64 = str_len(s);
    while i + len <= n {
        var okm: bool = true;
        var k: i64 = 0;
        while k < len {
            if str_byte_at(s, i + k) != 42 {
                okm = false;
            }
            k = k + 1;
        }
        if okm {
            // closing delimiter must not be immediately followed by '*'
            if i + len < n && str_byte_at(s, i + len) == 42 {
                i = i + 1;
                continue;
            }
            return i + len;
        }
        i = i + 1;
    }
    return -1;
}

// A letter, digit or byte of a multi-byte UTF-8 character: '_' between two
// of these is part of a word (snake_case), not emphasis.
fn md_is_word(c: i64) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c >= 128;
}

// ASCII punctuation, which a backslash makes literal.
fn md_is_punct(c: i64) -> bool {
    return (c >= 33 && c <= 47) || (c >= 58 && c <= 64) || (c >= 91 && c <= 96) || (c >= 123 && c <= 126);
}

// The closing run of `len` underscores at or after `from` that ends a word
// (not followed by a word character or another '_', not preceded by a
// space); its offset, or -1.
fn md_find_under(s: str, from: i64, len: i64) -> i64 {
    var n: i64 = str_len(s);
    var i: i64 = from + 1;
    while i + len <= n {
        var okm: bool = true;
        var k: i64 = 0;
        while k < len {
            if str_byte_at(s, i + k) != 95 {
                okm = false;
            }
            k = k + 1;
        }
        if okm && str_byte_at(s, i - 1) != 32 && str_byte_at(s, i - 1) != 95 {
            if i + len >= n {
                return i;
            }
            var after: i64 = str_byte_at(s, i + len);
            if after != 95 && !md_is_word(after) {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

// "<http://...>" or "<https://...>" at `at`: the offset of its '>', or -1.
fn md_autolink_end(s: str, at: i64) -> i64 {
    var n: i64 = str_len(s);
    var j: i64 = at + 1;
    if j + 8 <= n && str_slice(s, j, j + 8) == "https://" {
        j = j + 8;
    } else if j + 7 <= n && str_slice(s, j, j + 7) == "http://" {
        j = j + 7;
    } else {
        return -1;
    }
    while j < n {
        var c: i64 = str_byte_at(s, j);
        if c == 62 {
            return j;
        }
        if c == 32 || c == 60 || c < 32 {
            return -1;
        }
        j = j + 1;
    }
    return -1;
}

/// Render inline markup inside already-trimmed text.
/// Handles `code`, **bold**, *italic*, _italic_, [text](url), ![alt](src),
/// <http://autolinks>, and backslash escapes. A '_' inside a word
/// (snake_case) is text.
pub fn md_inline(s: str) -> str {
    var out: str = "";
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i < n {
        var c: i64 = str_byte_at(s, i);
        if c == 92 && i + 1 < n && md_is_punct(str_byte_at(s, i + 1)) {
            out = out + md_escape(str_slice(s, i + 1, i + 2));
            // \* \_ \| ...
            i = i + 2;
        } else if c == 60 && md_autolink_end(s, i) > 0 {
            var gt: i64 = md_autolink_end(s, i);
            var au: str = str_slice(s, i + 1, gt);
            out = out + "<a href=\"" + md_escape(md_safe_url(au)) + "\">" + md_escape(au) + "</a>";
            i = gt + 1;
        } else if c == 96 {
            // `code`
            var close: i64 = i + 1;
            var found: i64 = -1;
            while close < n {
                if str_byte_at(s, close) == 96 {
                    found = close;
                    break;
                }
                close = close + 1;
            }
            if found >= 0 {
                out = out + "<code>" + md_escape(str_slice(s, i + 1, found)) + "</code>";
                i = found + 1;
            } else {
                out = out + md_escape(str_slice(s, i, i + 1));
                i = i + 1;
            }
        } else if c == 42 {
            // * or **
            if i + 1 < n && str_byte_at(s, i + 1) == 42 {
                var e2: i64 = md_find_star(s, i + 2, 2);
                if e2 > 0 {
                    out = out + "<strong>" + md_inline(str_slice(s, i + 2, e2 - 2)) + "</strong>";
                    i = e2;
                } else {
                    out = out + md_escape(str_slice(s, i, i + 2));
                    i = i + 2;
                }
            } else {
                var e1: i64 = md_find_star(s, i + 1, 1);
                if e1 > 0 {
                    out = out + "<em>" + md_inline(str_slice(s, i + 1, e1 - 1)) + "</em>";
                    i = e1;
                } else {
                    out = out + md_escape(str_slice(s, i, i + 1));
                    i = i + 1;
                }
            }
        } else if c == 95 && (i == 0 || !md_is_word(str_byte_at(s, i - 1))) && i + 1 < n && str_byte_at(s, i + 1) != 32 {
            // _ or __ opening at the start of a word; one inside a word
            // (snake_case) is text, as is a run of three or more.
            var run: i64 = 1;
            if str_byte_at(s, i + 1) == 95 {
                run = 2;
            }
            var end: i64 = -1;
            if !(i + run < n && str_byte_at(s, i + run) == 95) {
                end = md_find_under(s, i + run, run);
            }
            if end > i + run {
                if run == 2 {
                    out = out + "<strong>" + md_inline(str_slice(s, i + 2, end)) + "</strong>";
                } else {
                    out = out + "<em>" + md_inline(str_slice(s, i + 1, end)) + "</em>";
                }
                i = end + run;
            } else {
                // Not emphasis: the whole run of '_' is text.
                var e: i64 = i;
                while e < n && str_byte_at(s, e) == 95 {
                    e = e + 1;
                }
                out = out + str_slice(s, i, e);
                i = e;
            }
        } else if c == 95 {
            // '_' inside a word
            var ew: i64 = i;
            while ew < n && str_byte_at(s, ew) == 95 {
                ew = ew + 1;
            }
            out = out + str_slice(s, i, ew);
            i = ew;
        } else if c == 33 && i + 1 < n && str_byte_at(s, i + 1) == 91 {
            // ![alt](src)
            var rb: i64 = str_find(str_slice(s, i, n), "]");
            var img: str = md_link_body(s, i + 2, rb + i);
            if str_len(img) > 0 {
                var parts: Vec = str_split_char(img, 7);
                out = out + "<img src=\"" + md_escape(md_safe_url(parts.get(1))) + "\" alt=\"" + md_escape(parts.get(0)) + "\" />";
                i = rb + i + str_parse_int(parts.get(2));
            } else {
                out = out + md_escape(str_slice(s, i, i + 1));
                i = i + 1;
            }
        } else if c == 91 {
            // [text](url)
            var rb2: i64 = str_find(str_slice(s, i, n), "]");
            var lnk: str = md_link_body(s, i + 1, rb2 + i);
            if str_len(lnk) > 0 {
                var parts2: Vec = str_split_char(lnk, 7);
                out = out + "<a href=\"" + md_escape(md_safe_url(parts2.get(1))) + "\">" + md_inline(parts2.get(0)) + "</a>";
                i = rb2 + i + str_parse_int(parts2.get(2));
            } else {
                out = out + md_escape(str_slice(s, i, i + 1));
                i = i + 1;
            }
        } else {
            out = out + md_escape(str_slice(s, i, i + 1));
            i = i + 1;
        }
    }
    return out;
}

// For "[body](url)": s[start..bracket] is the text; returns
// text + \x07 + url + \x07 + rest_len, or "" if no (url) follows.
fn md_link_body(s: str, start: i64, abs_bracket: i64) -> str {
    var n: i64 = str_len(s);
    if abs_bracket < 0 || abs_bracket + 1 >= n {
        return "";
    }
    if str_byte_at(s, abs_bracket + 1) != 40 {
        return "";
    }
    var depth: i64 = 0;
    var j: i64 = abs_bracket + 1;
    var close: i64 = -1;
    while j < n {
        var c: i64 = str_byte_at(s, j);
        if c == 40 {
            depth = depth + 1;
        }
        if c == 41 {
            depth = depth - 1;
            if depth == 0 {
                close = j;
                break;
            }
        }
        j = j + 1;
    }
    if close < 0 {
        return "";
    }
    var text: str = str_slice(s, start, abs_bracket);
    var url: str = str_slice(s, abs_bracket + 2, close);
    // Return packed: text \x07 url \x07 (chars consumed after ']' = close - abs_bracket)
    var bell: str = str_slice("\x07x", 0, 1);
    return text + bell + url + bell + int_to_str_padded(close - abs_bracket + 1, 4);
}

// ─── Block rendering ────────────────────────────────────────────────────

fn md_is_hr(t: str) -> bool {
    if str_len(t) < 3 {
        return false;
    }
    var c: i64 = str_byte_at(t, 0);
    if c != 45 && c != 42 && c != 95 {
        return false;
    }
    var i: i64 = 0;
    var cnt: i64 = 0;
    while i < str_len(t) {
        var x: i64 = str_byte_at(t, i);
        if x == c {
            cnt = cnt + 1;
        } else if x != 32 {
            return false;
        }
        i = i + 1;
    }
    return cnt >= 3;
}

fn md_heading_level(t: str) -> i64 {
    var i: i64 = 0;
    while i < str_len(t) && str_byte_at(t, i) == 35 {
        i = i + 1;
    }
    if i > 0 && i <= 6 && i < str_len(t) && str_byte_at(t, i) == 32 {
        return i;
    }
    return 0;
}

fn md_ul_item(t: str) -> bool {
    if str_len(t) < 2 {
        return false;
    }
    var c: i64 = str_byte_at(t, 0);
    return (c == 45 || c == 42 || c == 43) && str_byte_at(t, 1) == 32;
}

// "1. item" / "12. item" → content start index, -1 if not OL.
fn md_ol_item(t: str) -> i64 {
    var i: i64 = 0;
    var n: i64 = str_len(t);
    while i < n && str_byte_at(t, i) >= 48 && str_byte_at(t, i) <= 57 {
        i = i + 1;
    }
    if i == 0 || i + 1 >= n {
        return -1;
    }
    if str_byte_at(t, i) == 46 && str_byte_at(t, i + 1) == 32 {
        return i + 2;
    }
    return -1;
}

// Leading spaces of a line (a tab counts as four).
fn md_indent(line: str) -> i64 {
    var i: i64 = 0;
    var w: i64 = 0;
    while i < str_len(line) {
        var c: i64 = str_byte_at(line, i);
        if c == 32 {
            w = w + 1;
        } else if c == 9 {
            w = w + 4;
        } else {
            break;
        }
        i = i + 1;
    }
    return w;
}

// `line` without up to `indent` leading spaces.
fn md_dedent(line: str, indent: i64) -> str {
    var i: i64 = 0;
    while i < indent && i < str_len(line) && str_byte_at(line, i) == 32 {
        i = i + 1;
    }
    return str_slice(line, i, str_len(line));
}

// Does trimmed line `l` go on with the list item above it (it is not blank
// and starts no block of its own)?
fn md_continues(l: str) -> bool {
    if str_len(l) == 0 {
        return false;
    }
    if md_ul_item(l) || md_ol_item(l) > 0 || md_heading_level(l) > 0 || md_is_hr(l) {
        return false;
    }
    if str_starts_with(l, "```") || str_byte_at(l, 0) == 62 || str_byte_at(l, 0) == 124 {
        return false;
    }
    return true;
}

/// Convert Markdown text to an HTML fragment.
///
/// Example:
///   assert_eq(md_escape("a<b & c"), "a&lt;b &amp; c");
///   val h = md_to_html("# Title\n\nSome **bold** text.");
///   assert(str_contains(h, "<h1>Title</h1>"));
///   assert(str_contains(h, "<strong>bold</strong>"));
///   assert(str_contains(md_inline("`x`"), "<code>x</code>"));
///   assert(!str_contains(md_to_html("<script>"), "<script>"));
pub fn md_to_html(text: str) -> str {
    var lines: Vec<str> = str_lines(text);
    var out: str = "";
    var i: i64 = 0;
    var n: i64 = lines.len();

    while i < n {
        var line: str = lines.get(i);
        var t: str = str_trim_end(line);

        // Code fence ```, also indented (inside a list item): the fence's
        // indent is taken off each line of the code.
        if str_starts_with(str_trim_start(t), "```") {
            var indent: i64 = md_indent(t);
            var code: str = "";
            i = i + 1;
            while i < n && !str_starts_with(str_trim(lines.get(i)), "```") {
                code = code + md_escape(md_dedent(str_trim_end(lines.get(i)), indent)) + "\n";
                i = i + 1;
            }
            if i < n {
                i = i + 1;
            }
            // closing fence
            out = out + "<pre><code>" + code + "</code></pre>\n";
            continue;
        }
        var tr: str = str_trim(t);
        if str_len(tr) == 0 {
            i = i + 1;
            continue;
        }

        // Heading
        var h: i64 = md_heading_level(tr);
        if h > 0 {
            var content: str = str_trim(str_slice(tr, h, str_len(tr)));
            out = out + "<h" + int_to_str(h) + ">" + md_inline(content) + "</h" + int_to_str(h) + ">\n";
            i = i + 1;
            continue;
        }
        // Horizontal rule
        if md_is_hr(tr) {
            out = out + "<hr />\n";
            i = i + 1;
            continue;
        }
        // Blockquote (consecutive '>' lines)
        if str_byte_at(tr, 0) == 62 {
            var inner: str = "";
            while i < n {
                var l2: str = str_trim(lines.get(i));
                if str_len(l2) > 0 && str_byte_at(l2, 0) == 62 {
                    var body: str = str_trim(str_slice(l2, 1, str_len(l2)));
                    inner = inner + body + "\n";
                    i = i + 1;
                } else {
                    break;
                }
            }
            out = out + "<blockquote>" + md_to_html(inner) + "</blockquote>\n";
            continue;
        }
        // Unordered list
        // An item goes on over the following lines that start no other
        // block (CommonMark's continuation and lazy lines).
        if md_ul_item(tr) {
            out = out + "<ul>\n";
            var item: str = str_slice(tr, 2, str_len(tr));
            i = i + 1;
            while i < n {
                var l3: str = str_trim(lines.get(i));
                if str_len(l3) > 0 && md_ul_item(l3) {
                    out = out + "<li>" + md_inline(item) + "</li>\n";
                    item = str_slice(l3, 2, str_len(l3));
                    i = i + 1;
                } else if md_continues(l3) {
                    item = item + "\n" + l3;
                    i = i + 1;
                } else {
                    break;
                }
            }
            out = out + "<li>" + md_inline(item) + "</li>\n</ul>\n";
            continue;
        }
        // Ordered list
        if md_ol_item(tr) > 0 {
            out = out + "<ol>\n";
            var oitem: str = str_slice(tr, md_ol_item(tr), str_len(tr));
            i = i + 1;
            while i < n {
                var l4: str = str_trim(lines.get(i));
                var cs: i64 = -1;
                if str_len(l4) > 0 {
                    cs = md_ol_item(l4);
                }
                if cs > 0 {
                    out = out + "<li>" + md_inline(oitem) + "</li>\n";
                    oitem = str_slice(l4, cs, str_len(l4));
                    i = i + 1;
                } else if md_continues(l4) {
                    oitem = oitem + "\n" + l4;
                    i = i + 1;
                } else {
                    break;
                }
            }
            out = out + "<li>" + md_inline(oitem) + "</li>\n</ol>\n";
            continue;
        }
        // Paragraph: merge following non-blank, non-structural lines
        var para: str = tr;
        i = i + 1;
        while i < n {
            var l5: str = str_trim(lines.get(i));
            if str_len(l5) == 0 {
                break;
            }
            if md_heading_level(l5) > 0 || md_is_hr(l5) || md_ul_item(l5) || md_ol_item(l5) > 0 || str_starts_with(l5, "```") || str_byte_at(l5, 0) == 62 {
                break;
            }
            para = para + "\n" + l5;
            i = i + 1;
        }
        out = out + "<p>" + md_inline(para) + "</p>\n";
    }
    return out;
}

/// Render to a full HTML document with optional <title>.
pub fn md_to_page(text: str, title: str) -> str {
    return "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>" + md_escape(title) + "</title>\n</head>\n<body>\n" + md_to_html(text) + "</body>\n</html>\n";
}
