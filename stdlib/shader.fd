// Fides Shader standard library
//
// Material system and shader graph on top of gl.fd.
// Provides:
//   - Material definitions (shader program + uniform values)
//   - Material caching (avoid recompiling identical shaders)
//   - Common uniform management (MVP matrices, colors, textures)
//   - Built-in shader templates (unlit, lit, text, post-process)
//
// Usage:
//   use shader;
//   use gl;
//   use math;
//
//   var mat = material_create("diffuse");
//   material_set_mat4(&mut mat, "model", model_matrix);
//   material_set_mat4(&mut mat, "view", view_matrix);
//   material_set_mat4(&mut mat, "projection", proj_matrix);
//   material_set_vec3(&mut mat, "color", vec3(1.0, 0.0, 0.0));
//   material_bind(&mat);  // use program + set uniforms
//   // draw mesh...

module shader;

use vec;
use string;
use math;
use gl;

// ─── Uniform Value ──────────────────────────────────────────────────────

pub const UNIFORM_FLOAT: i64 = 0;
pub const UNIFORM_INT: i64 = 1;
pub const UNIFORM_VEC3: i64 = 2;
pub const UNIFORM_VEC4: i64 = 3;
pub const UNIFORM_MAT4: i64 = 4;
pub const UNIFORM_TEXTURE: i64 = 5;

pub struct UniformValue {
    pub name: str,
    pub kind: i64,
    pub float_val: f64,
    pub int_val: i64,
    pub vec_val: vec4,    // used for vec3 (xyz) and vec4
    pub mat_val: mat4,
    pub texture_unit: i64,
    pub location: i64,    // cached uniform location
}

pub struct Material {
    pub name: str,
    pub program: i64,       // GL shader program handle
    pub uniforms: Vec<UniformValue>,
    pub blend_mode: i64,   // 0 = opaque, 1 = alpha, 2 = additive
    pub cull_mode: i64,    // 0 = none, 1 = back, 2 = front
    pub depth_test: bool,
    pub depth_write: bool,
    pub valid: bool,
}

pub const BLEND_OPAQUE: i64 = 0;
pub const BLEND_ALPHA: i64 = 1;
pub const BLEND_ADDITIVE: i64 = 2;

pub const CULL_NONE: i64 = 0;
pub const CULL_BACK: i64 = 1;
pub const CULL_FRONT: i64 = 2;

/// Create a material from a shader name.
/// Uses built-in shader templates.
pub fn material_create(shader_name: str) -> Material {
    var vert_src = "";
    var frag_src = "";

    if str_equal(shader_name, "unlit") {
        vert_src = SHADER_UNLIT_VERT;
        frag_src = SHADER_UNLIT_FRAG;
    } else if str_equal(shader_name, "diffuse") {
        vert_src = SHADER_DIFFUSE_VERT;
        frag_src = SHADER_DIFFUSE_FRAG;
    } else if str_equal(shader_name, "text") {
        vert_src = SHADER_TEXT_VERT;
        frag_src = SHADER_TEXT_FRAG;
    } else if str_equal(shader_name, "postprocess") {
        vert_src = SHADER_POST_VERT;
        frag_src = SHADER_POST_FRAG;
    } else {
        // Default to unlit
        vert_src = SHADER_UNLIT_VERT;
        frag_src = SHADER_UNLIT_FRAG;
    }

    var program = gl_create_program_from_src(vert_src, frag_src);

    return Material {
        name: shader_name,
        program: program,
        uniforms: Vec::new(),
        blend_mode: BLEND_OPAQUE,
        cull_mode: CULL_BACK,
        depth_test: true,
        depth_write: true,
        valid: program != 0,
    };
}

/// Create a material from custom shader source.
pub fn material_create_custom(name: str, vert_src: str, frag_src: str) -> Material {
    var program = gl_create_program_from_src(vert_src, frag_src);
    return Material {
        name: name,
        program: program,
        uniforms: Vec::new(),
        blend_mode: BLEND_OPAQUE,
        cull_mode: CULL_BACK,
        depth_test: true,
        depth_write: true,
        valid: program != 0,
    };
}

/// Find a uniform in the material by name. Returns index or -1.
fn material_find_uniform(mat: &Material, name: str) -> i64 {
    var i = 0;
    while i < mat.uniforms.len() {
        if str_equal(mat.uniforms.get(i).name, name) { return i; }
        i = i + 1;
    }
    return -1;
}

/// Set a float uniform.
pub fn material_set_float(mat: &mut Material, name: str, val: f64) -> void {
    var idx = material_find_uniform(mat, name);
    if idx >= 0 {
        var u = mat.uniforms.get(idx);
        u.float_val = val;
        mat.uniforms.set(idx, u);
    } else {
        mat.uniforms.push(UniformValue {
            name: name, kind: UNIFORM_FLOAT,
            float_val: val, int_val: 0,
            vec_val: vec4(0.0, 0.0, 0.0, 0.0),
            mat_val: mat4::identity(),
            texture_unit: 0, location: -1,
        });
    }
}

/// Set an int uniform.
pub fn material_set_int(mat: &mut Material, name: str, val: i64) -> void {
    var idx = material_find_uniform(mat, name);
    if idx >= 0 {
        var u = mat.uniforms.get(idx);
        u.int_val = val;
        mat.uniforms.set(idx, u);
    } else {
        mat.uniforms.push(UniformValue {
            name: name, kind: UNIFORM_INT,
            float_val: 0.0, int_val: val,
            vec_val: vec4(0.0, 0.0, 0.0, 0.0),
            mat_val: mat4::identity(),
            texture_unit: 0, location: -1,
        });
    }
}

/// Set a vec3 uniform.
pub fn material_set_vec3(mat: &mut Material, name: str, val: vec3) -> void {
    var idx = material_find_uniform(mat, name);
    if idx >= 0 {
        var u = mat.uniforms.get(idx);
        u.vec_val = vec4(val.x, val.y, val.z, 0.0);
        mat.uniforms.set(idx, u);
    } else {
        mat.uniforms.push(UniformValue {
            name: name, kind: UNIFORM_VEC3,
            float_val: 0.0, int_val: 0,
            vec_val: vec4(val.x, val.y, val.z, 0.0),
            mat_val: mat4::identity(),
            texture_unit: 0, location: -1,
        });
    }
}

/// Set a vec4 uniform.
pub fn material_set_vec4(mat: &mut Material, name: str, val: vec4) -> void {
    var idx = material_find_uniform(mat, name);
    if idx >= 0 {
        var u = mat.uniforms.get(idx);
        u.vec_val = val;
        mat.uniforms.set(idx, u);
    } else {
        mat.uniforms.push(UniformValue {
            name: name, kind: UNIFORM_VEC4,
            float_val: 0.0, int_val: 0,
            vec_val: val,
            mat_val: mat4::identity(),
            texture_unit: 0, location: -1,
        });
    }
}

/// Set a mat4 uniform.
pub fn material_set_mat4(mat: &mut Material, name: str, val: mat4) -> void {
    var idx = material_find_uniform(mat, name);
    if idx >= 0 {
        var u = mat.uniforms.get(idx);
        u.mat_val = val;
        mat.uniforms.set(idx, u);
    } else {
        mat.uniforms.push(UniformValue {
            name: name, kind: UNIFORM_MAT4,
            float_val: 0.0, int_val: 0,
            vec_val: vec4(0.0, 0.0, 0.0, 0.0),
            mat_val: val,
            texture_unit: 0, location: -1,
        });
    }
}

/// Set a texture uniform (binds to a texture unit).
pub fn material_set_texture(mat: &mut Material, name: str, unit: i64) -> void {
    var idx = material_find_uniform(mat, name);
    if idx >= 0 {
        var u = mat.uniforms.get(idx);
        u.texture_unit = unit;
        mat.uniforms.set(idx, u);
    } else {
        mat.uniforms.push(UniformValue {
            name: name, kind: UNIFORM_TEXTURE,
            float_val: 0.0, int_val: 0,
            vec_val: vec4(0.0, 0.0, 0.0, 0.0),
            mat_val: mat4::identity(),
            texture_unit: unit, location: -1,
        });
    }
}

/// Bind the material (use program + set all uniforms).
pub fn material_bind(mat: &Material) -> void {
    if !mat.valid { return; }
    gl_use_program(mat.program);

    // Set render state
    if mat.depth_test { gl_enable(GL_DEPTH_TEST); }
    else { gl_disable(GL_DEPTH_TEST); }

    if mat.cull_mode != CULL_NONE { gl_enable(GL_CULL_FACE); }
    else { gl_disable(GL_CULL_FACE); }

    // Set uniforms
    var i = 0;
    while i < mat.uniforms.len() {
        var u = mat.uniforms.get(i);
        if u.location < 0 {
            // Cache the uniform location
            u.location = gl_get_uniform(mat.program, u.name);
        }
        if u.location >= 0 {
            if u.kind == UNIFORM_FLOAT {
                gl_uniform_1f(u.location, u.float_val);
            } else if u.kind == UNIFORM_INT {
                gl_uniform_1i(u.location, u.int_val);
            } else if u.kind == UNIFORM_VEC3 {
                gl_uniform_3f(u.location, u.vec_val.x, u.vec_val.y, u.vec_val.z);
            } else if u.kind == UNIFORM_VEC4 {
                gl_uniform_4f(u.location, u.vec_val.x, u.vec_val.y, u.vec_val.z, u.vec_val.w);
            } else if u.kind == UNIFORM_MAT4 {
                gl_uniform_matrix_4fv(u.location, 1, 0, 0);  // native: pass &mat_val
            } else if u.kind == UNIFORM_TEXTURE {
                gl_uniform_1i(u.location, u.texture_unit);
            }
        }
        i = i + 1;
    }
}

/// Set blend mode.
pub fn material_set_blend(mat: &mut Material, mode: i64) -> void {
    mat.blend_mode = mode;
}

/// Set cull mode.
pub fn material_set_cull(mat: &mut Material, mode: i64) -> void {
    mat.cull_mode = mode;
}

/// Set depth test/write.
pub fn material_set_depth(mat: &mut Material, test: bool, write: bool) -> void {
    mat.depth_test = test;
    mat.depth_write = write;
}

/// Destroy the material (delete shader program).
pub fn material_destroy(mat: &mut Material) -> void {
    if mat.valid && mat.program != 0 {
        gl_delete_program(mat.program);
        mat.program = 0;
        mat.valid = false;
    }
    mat.uniforms.clear();
}

/// Get the shader program handle.
pub fn material_program(mat: &Material) -> i64 {
    return mat.program;
}

/// Check if the material is valid.
pub fn material_is_valid(mat: &Material) -> bool {
    return mat.valid;
}

/// Get the number of uniforms.
pub fn material_uniform_count(mat: &Material) -> i64 {
    return mat.uniforms.len();
}

// ─── Built-in Shaders ────────────────────────────────────────────────────

pub const SHADER_UNLIT_VERT: str = "#version 330 core\nlayout(location = 0) in vec3 aPos;\nuniform mat4 model;\nuniform mat4 view;\nuniform mat4 projection;\nvoid main() {\n    gl_Position = projection * view * model * vec4(aPos, 1.0);\n}\n";

pub const SHADER_UNLIT_FRAG: str = "#version 330 core\nuniform vec3 color;\nout vec4 FragColor;\nvoid main() {\n    FragColor = vec4(color, 1.0);\n}\n";

pub const SHADER_DIFFUSE_VERT: str = "#version 330 core\nlayout(location = 0) in vec3 aPos;\nlayout(location = 1) in vec3 aNormal;\nuniform mat4 model;\nuniform mat4 view;\nuniform mat4 projection;\nout vec3 Normal;\nout vec3 FragPos;\nvoid main() {\n    FragPos = vec3(model * vec4(aPos, 1.0));\n    Normal = mat3(transpose(inverse(model))) * aNormal;\n    gl_Position = projection * view * vec4(FragPos, 1.0);\n}\n";

pub const SHADER_DIFFUSE_FRAG: str = "#version 330 core\nin vec3 Normal;\nin vec3 FragPos;\nuniform vec3 lightPos;\nuniform vec3 lightColor;\nuniform vec3 objectColor;\nout vec4 FragColor;\nvoid main() {\n    vec3 ambient = 0.1 * lightColor;\n    vec3 norm = normalize(Normal);\n    vec3 lightDir = normalize(lightPos - FragPos);\n    float diff = max(dot(norm, lightDir), 0.0);\n    vec3 diffuse = diff * lightColor;\n    vec3 result = (ambient + diffuse) * objectColor;\n    FragColor = vec4(result, 1.0);\n}\n";

pub const SHADER_TEXT_VERT: str = "#version 330 core\nlayout(location = 0) in vec2 aPos;\nlayout(location = 1) in vec2 aTexCoord;\nout vec2 TexCoord;\nuniform mat4 projection;\nvoid main() {\n    gl_Position = projection * vec4(aPos, 0.0, 1.0);\n    TexCoord = aTexCoord;\n}\n";

pub const SHADER_TEXT_FRAG: str = "#version 330 core\nin vec2 TexCoord;\nout vec4 FragColor;\nuniform sampler2D text;\nuniform vec3 textColor;\nvoid main() {\n    vec4 sampled = vec4(1.0, 1.0, 1.0, texture(text, TexCoord).r);\n    FragColor = vec4(textColor, 1.0) * sampled;\n}\n";

pub const SHADER_POST_VERT: str = "#version 330 core\nlayout(location = 0) in vec2 aPos;\nlayout(location = 1) in vec2 aTexCoord;\nout vec2 TexCoord;\nvoid main() {\n    gl_Position = vec4(aPos, 0.0, 1.0);\n    TexCoord = aTexCoord;\n}\n";

pub const SHADER_POST_FRAG: str = "#version 330 core\nin vec2 TexCoord;\nout vec4 FragColor;\nuniform sampler2D screenTexture;\nvoid main() {\n    FragColor = texture(screenTexture, TexCoord);\n}\n";

// ─── Material Cache ──────────────────────────────────────────────────────

pub struct MaterialCache {
    pub materials: Vec<Material>,
    pub names: Vec<str>,
}

/// Create a new material cache.
pub fn material_cache_create() -> MaterialCache {
    var materials = Vec::new();
    var names = Vec::new();
    return MaterialCache {
        materials: materials,
        names: names,
    };
}

/// Get or create a cached material by shader name.
pub fn material_cache_get(cache: &mut MaterialCache, shader_name: str) -> i64 {
    var i = 0;
    while i < cache.names.len() {
        if str_equal(cache.names.get(i), shader_name) {
            return i;
        }
        i = i + 1;
    }
    var mat = material_create(shader_name);
    cache.materials.push(mat);
    cache.names.push(shader_name);
    return cache.materials.len() - 1;
}

/// Get a cached material by index.
pub fn material_cache_get_idx(cache: &MaterialCache, idx: i64) -> Material {
    return cache.materials.get(idx);
}

/// Clear the material cache.
pub fn material_cache_clear(cache: &mut MaterialCache) -> void {
    cache.materials.clear();
    cache.names.clear();
}

/// Get the number of cached materials.
pub fn material_cache_count(cache: &MaterialCache) -> i64 {
    return cache.materials.len();
}
