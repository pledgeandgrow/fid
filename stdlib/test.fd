// Fides Test utilities standard library
//
// Assertion helpers for writing tests in Fides.
// Provides structured assertions with descriptive failure messages.
//
// Usage:
//   use test;
//   test_assert_eq(42, 42, "answer should be 42");
//   test_assert_approx_eq(3.14159, 3.14, 0.01, "pi approximation");

module test;
use vec;
use string;
use file;
// ─── Test state ─────────────────────────────────────────────────────────

/// Global test counters (managed via a TestRunner struct since Fides has no globals).
pub struct TestRunner {
    pub passed: i64,
    pub failed: i64,
    pub current_test: str,
}

/// Create a new test runner.
///
/// Example:
///   var r = test_runner_new();
///   test_begin(&mut r, "counters");
///   test_pass(&mut r);
///   assert(test_all_passed(r));
///   test_fail(&mut r, "boom");
///   assert_eq(r.passed, 1);
///   assert_eq(r.failed, 1);
///   assert(!test_all_passed(r));
///   assert(test_assert_eq(3, 3, "eq"));
///   assert(test_assert_true(true, "t"));
pub fn test_runner_new() -> TestRunner {
    return TestRunner {
        passed: 0, failed: 0, current_test: ""
    };
}

/// Begin a named test.
pub fn test_begin(runner: &mut TestRunner, name: str) -> void {
    runner.current_test = name;
    print("  test: ");
    println(name);
}

/// End the current test (mark as passed).
pub fn test_pass(runner: &mut TestRunner) -> void {
    runner.passed = runner.passed + 1;
}

/// Mark the current test as failed.
pub fn test_fail(runner: &mut TestRunner, msg: str) -> void {
    runner.failed = runner.failed + 1;
    print("    FAIL: ");
    println(msg);
}

/// Print test summary.
pub fn test_summary(runner: TestRunner) -> void {
    print("\n  Passed: ");
    println(int_to_str(runner.passed));
    print("  Failed: ");
    println(int_to_str(runner.failed));
    var total = runner.passed + runner.failed;
    print("  Total:  ");
    println(int_to_str(total));
    if runner.failed == 0 {
        println("\n  ALL TESTS PASSED");
    } else {
        print("\n  ");
        print(int_to_str(runner.failed));
        println(" TEST(S) FAILED");
    }
}

/// Check if all tests passed.
pub fn test_all_passed(runner: TestRunner) -> bool {
    return runner.failed == 0;
}

// ─── Assertions ─────────────────────────────────────────────────────────

/// Assert two i64 values are equal. Prints message on failure.
pub fn test_assert_eq(a: i64, b: i64, msg: str) -> bool {
    if a != b {
        print("  ASSERT FAIL: ");
        print(msg);
        print(" — expected ");
        print(int_to_str(b));
        print(", got ");
        println(int_to_str(a));
        return false;
    }
    return true;
}

/// Assert two i64 values are NOT equal.
pub fn test_assert_ne(a: i64, b: i64, msg: str) -> bool {
    if a == b {
        print("  ASSERT FAIL: ");
        print(msg);
        print(" — expected not ");
        println(int_to_str(b));
        return false;
    }
    return true;
}

/// Assert a condition is true.
pub fn test_assert_true(cond: bool, msg: str) -> bool {
    if !cond {
        print("  ASSERT FAIL: ");
        println(msg);
        return false;
    }
    return true;
}

/// Assert a condition is false.
pub fn test_assert_false(cond: bool, msg: str) -> bool {
    if cond {
        print("  ASSERT FAIL: ");
        print("value false: ");
        println(msg);
        return false;
    }
    return true;
}

/// Assert two f64 values are approximately equal (within epsilon).
pub fn test_assert_approx_eq(a: f64, b: f64, epsilon: f64, msg: str) -> bool {
    var diff = a - b;
    if diff < 0.0 {
        diff = -diff;
    }
    if diff > epsilon {
        print("  ASSERT FAIL: ");
        print(msg);
        print(" — expected ~");
        // Simple float print
        print(int_to_str(b as i64));
        print(", got ");
        println(int_to_str(a as i64));
        return false;
    }
    return true;
}

/// Assert a value is greater than another.
pub fn test_assert_gt(a: i64, b: i64, msg: str) -> bool {
    if a <= b {
        print("  ASSERT FAIL: ");
        print(msg);
        print(" — expected ");
        print(int_to_str(a));
        print(" > ");
        println(int_to_str(b));
        return false;
    }
    return true;
}

/// Assert a value is less than another.
pub fn test_assert_lt(a: i64, b: i64, msg: str) -> bool {
    if a >= b {
        print("  ASSERT FAIL: ");
        print(msg);
        print(" — expected ");
        print(int_to_str(a));
        print(" < ");
        println(int_to_str(b));
        return false;
    }
    return true;
}

/// Assert a value is in a range [lo, hi].
pub fn test_assert_in_range(value: i64, lo: i64, hi: i64, msg: str) -> bool {
    if value < lo || value > hi {
        print("  ASSERT FAIL: ");
        print(msg);
        print(" — expected ");
        print(int_to_str(value));
        print(" in [");
        print(int_to_str(lo));
        print(", ");
        print(int_to_str(hi));
        println("]");
        return false;
    }
    return true;
}

/// Assert a string equals another string.
pub fn test_assert_str_eq(a: str, b: str, msg: str) -> bool {
    if !str_equal(a, b) {
        print("  ASSERT FAIL: ");
        print(msg);
        print(" — expected \"");
        print(b);
        print("\", got \"");
        print(a);
        println("\"");
        return false;
    }
    return true;
}

/// Assert a Vec is empty.
pub fn test_assert_empty(v: Vec<i64>, msg: str) -> bool {
    if !v.is_empty() {
        print("  ASSERT FAIL: ");
        print(msg);
        print(" — expected empty, got len=");
        println(int_to_str(v.len()));
        return false;
    }
    return true;
}

/// Assert a Vec has a specific length.
pub fn test_assert_len(v: Vec<i64>, expected: i64, msg: str) -> bool {
    if v.len() != expected {
        print("  ASSERT FAIL: ");
        print(msg);
        print(" — expected len=");
        print(int_to_str(expected));
        print(", got len=");
        println(int_to_str(v.len()));
        return false;
    }
    return true;
}

/// Assert a Vec contains a value.
pub fn test_assert_contains(v: Vec<i64>, value: i64, msg: str) -> bool {
    if !v.contains(value) {
        print("  ASSERT FAIL: ");
        print(msg);
        print(" — Vec does not contain ");
        println(int_to_str(value));
        return false;
    }
    return true;
}

// ─── Hard assert (aborts on failure) ────────────────────────────────────

/// Assert and abort if false.
pub fn test_assert_or_abort(cond: bool, msg: str) -> void {
    if !cond {
        print("FATAL: ");
        println(msg);
        p_panic("abort");
    }
}

/// Assert equal and abort if not.
pub fn test_assert_eq_or_abort(a: i64, b: i64, msg: str) -> void {
    if a != b {
        print("FATAL: ");
        print(msg);
        print(" — expected ");
        print(int_to_str(b));
        print(", got ");
        println(int_to_str(a));
        p_panic("abort");
    }
}

// ─── Table tests (competitive SL13, complaint CT2) ──────────────────────
//
// Go's table-driven tests: one check per row, each row named, every row
// run even after one fails, and the failures listed together at the end.
//
//   var t: TableTest = table_new("parse_int");
//   table_int(& mut t, "zero", str_parse_int("0"), 0);
//   table_int(& mut t, "negative", str_parse_int("-12"), - 12);
//   table_str(& mut t, "trim", str_trim("  a "), "a");
//   table_done(t);      // panics when a row failed
//
// FIDES_ROW=<text> runs only the rows whose name contains <text> (the
// others count as skipped), like `go test -run 'Test/<row>'`.

/// The rows of one table test.
pub struct TableTest {
    pub name: str,
    pub passed: i64,
    pub skipped: i64,
    /// "<row>: <why>" for each failed row
    pub failures: Vec<str>,
    /// Only rows whose name contains this run ("" all)
    pub filter: str,
}

/// A table test named `name` (FIDES_ROW, when set, filters its rows).
pub fn table_new(name: str) -> TableTest {
    var filter: str = "";
    match env_var("FIDES_ROW") {
        Option::Some(v) => {
            filter = v;
        }
        Option::None => {
        }
    }
    return TableTest {
        name: name, passed: 0, skipped: 0, failures: Vec::new(), filter: filter,
    };
}

/// Whether row `row` runs under the filter (a skipped row is counted).
pub fn table_runs(t: &mut TableTest, row: str) -> bool {
    if str_len(t.filter) > 0 && !str_contains(row, t.filter) {
        t.skipped = t.skipped + 1;
        return false;
    }
    return true;
}

/// Row `row` passed when `ok`; `why` says what was wrong otherwise.
pub fn table_check(t: &mut TableTest, row: str, ok: bool, why: str) -> bool {
    if !table_runs(t, row) {
        return true;
    }
    if ok {
        t.passed = t.passed + 1;
        return true;
    }
    t.failures.push(row + ": " + why);
    return false;
}

/// Row `row`: `got` must equal `want`.
pub fn table_int(t: &mut TableTest, row: str, got: i64, want: i64) -> bool {
    return table_check(t, row, got == want, "got " + int_to_str(got) + ", want " + int_to_str(want));
}

/// Row `row`: `got` must equal `want` (text).
pub fn table_str(t: &mut TableTest, row: str, got: str, want: str) -> bool {
    return table_check(t, row, str_equal(got, want), "got \"" + got + "\", want \"" + want + "\"");
}

/// Row `row`: `got` must equal `want` (a truth value).
pub fn table_bool(t: &mut TableTest, row: str, got: bool, want: bool) -> bool {
    return table_check(t, row, got == want, "got " + bool_to_str(got) + ", want " + bool_to_str(want));
}

/// How many rows failed so far.
pub fn table_failed(t: &TableTest) -> i64 {
    return t.failures.len();
}

/// Print "table <name>: <n> passed[, <k> skipped][, <f> failed]" and each
/// failed row, then panic when a row failed (so `fid test` reports the
/// test as failed). Returns the number of rows that passed.
pub fn table_done(t: TableTest) -> i64 {
    var line: str = "table " + t.name + ": " + int_to_str(t.passed) + " passed";
    if t.skipped > 0 {
        line = line + ", " + int_to_str(t.skipped) + " skipped";
    }
    if t.failures.len() > 0 {
        line = line + ", " + int_to_str(t.failures.len()) + " failed";
    }
    println(line);
    var i: i64 = 0;
    while i < t.failures.len() {
        println("  FAIL " + t.name + "/" + t.failures.get(i));
        i = i + 1;
    }
    if t.failures.len() > 0 {
        p_panic("table " + t.name + ": " + int_to_str(t.failures.len()) + " row(s) failed");
    }
    return t.passed;
}

// ─── Snapshots (complaint CT5) ──────────────────────────────────────────

/// expect_snapshot(name, value): compares `value` with the stored snapshot
/// in `<name>.snap` next to the test that calls it. `fid test --update`
/// (or FIDES_UPDATE=1) writes the file instead of comparing. A missing
/// file is a failure that says how to create it.
pub fn expect_snapshot(name: str, value: str) -> void {
    var path: str = name + ".snap";
    var upd: bool = false;
    match env_var("FIDES_UPDATE") {
        Option::Some(v) => {
            upd = str_len(v) > 0 && v != "0";
        }
        Option::None => {
        }
    }
    if upd {
        file_write(path, value);
        println("snapshot updated: " + path);
        return;
    }
    if !file_exists(path) {
        println("snapshot missing: " + path + " (run fid test --update to write it)");
        p_panic("snapshot missing: " + path);
    }
    var old: str = file_read(path);
    if old != value {
        println("snapshot differs: " + path + " (run fid test --update to update)");
        p_panic("snapshot differs: " + path);
    }
}
