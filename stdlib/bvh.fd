// Fides BVH: bounding volume hierarchy over axis-aligned boxes, with
// triangle meshes on top.
//
//   - Build: top-down, splitting by the surface area heuristic over 16
//     centroid bins per axis (cost = 1 traversal + area-weighted primitive
//     counts of both sides, relative to the parent); a node becomes a leaf
//     when no split beats intersecting all its primitives and it holds at
//     most `max_leaf`, or when its centroids cannot be separated. A median
//     split build is there for comparison (bvh_build_median).
//   - Refit: after primitives move (same topology), boxes are recomputed
//     bottom-up without rebuilding (children always come after parents).
//   - Queries: closest hit and any hit (shadow rays) along a ray, with
//     front-to-back traversal and pruning by the best hit so far; all
//     primitives whose box overlaps a query box.
//   - Triangles: Moller-Trumbore ray/triangle intersection (two-sided),
//     barycentric u, v of the hit.
//
// Pure computation, no platform seam. Nodes are flat arrays: node i has
// box bmin/bmax[3i..3i+3]; an inner node's children are left[i] and
// left[i] + 1; a leaf (left = -1) holds order[first .. first+count).
//
// Usage:
//   use bvh;
//   var m: BvhMesh = bvh_mesh_new(positions, indices, 4);
//   val h: BvhHit = bvh_mesh_closest(&m, ox, oy, oz, dx, dy, dz, 1e30);
//   // move vertices, then
//   bvh_mesh_refit(&mut m, new_positions);

module bvh;
use vec;
use math;

pub const BVH_BINS: i64 = 16;
pub const BVH_FAR: f64 = 1.0e30;

// n copies of x (Vec::filled with a float value is avoided: the
// interpreter stores a wrong value for it).
pub fn bvh_f64s(n: i64, x: f64) -> Vec<f64> {
    var v: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        v.push(x);
        i = i + 1;
    }
    return v;
}

pub struct Bvh {
    pub bmin: Vec<f64>,
    pub bmax: Vec<f64>,
    pub left: Vec<i64>,
    pub first: Vec<i64>,
    pub count: Vec<i64>,
    pub order: Vec<i64>,
    /// Primitive boxes, 3 values each.
    pub pmin: Vec<f64>,
    pub pmax: Vec<f64>,
}

pub fn bvh_node_count(b: &Bvh) -> i64 {
    return b.left.len();
}

pub fn bvh_is_leaf(b: &Bvh, node: i64) -> bool {
    return b.left.get(node) < 0;
}

fn bvh_area(dx: f64, dy: f64, dz: f64) -> f64 {
    if dx < 0.0 || dy < 0.0 || dz < 0.0 {
        return 0.0;
    }
    return 2.0 * (dx * dy + dy * dz + dz * dx);
}

fn bvh_node_area(b: &Bvh, n: i64) -> f64 {
    return bvh_area(b.bmax.get(3 * n) - b.bmin.get(3 * n), b.bmax.get(3 * n + 1) - b.bmin.get(3 * n + 1), b.bmax.get(3 * n + 2) - b.bmin.get(3 * n + 2));
}

fn bvh_centroid(b: &Bvh, p: i64, axis: i64) -> f64 {
    return (b.pmin.get(3 * p + axis) + b.pmax.get(3 * p + axis)) * 0.5;
}

// Set node n's box to the union of its primitives' boxes.
fn bvh_bound_leaf(b: &mut Bvh, n: i64) {
    var k: i64 = 0;
    while k < 3 {
        b.bmin.set(3 * n + k, BVH_FAR);
        b.bmax.set(3 * n + k, 0.0 - BVH_FAR);
        k = k + 1;
    }
    var i: i64 = b.first.get(n);
    while i < b.first.get(n) + b.count.get(n) {
        val p: i64 = b.order.get(i);
        k = 0;
        while k < 3 {
            if b.pmin.get(3 * p + k) < b.bmin.get(3 * n + k) {
                b.bmin.set(3 * n + k, b.pmin.get(3 * p + k));
            }
            if b.pmax.get(3 * p + k) > b.bmax.get(3 * n + k) {
                b.bmax.set(3 * n + k, b.pmax.get(3 * p + k));
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

fn bvh_new_node(b: &mut Bvh, first: i64, count: i64) -> i64 {
    var k: i64 = 0;
    while k < 3 {
        b.bmin.push(0.0);
        b.bmax.push(0.0);
        k = k + 1;
    }
    b.left.push(-1);
    b.first.push(first);
    b.count.push(count);
    val n: i64 = b.left.len() - 1;
    bvh_bound_leaf(b, n);
    return n;
}

// Reorder order[first..first+count) so primitives with centroid on axis
// below `split` come first; returns how many.
fn bvh_partition(b: &mut Bvh, first: i64, count: i64, axis: i64, split: f64) -> i64 {
    var i: i64 = first;
    var j: i64 = first + count - 1;
    while i <= j {
        if bvh_centroid(b, b.order.get(i), axis) < split {
            i = i + 1;
        } else {
            val t: i64 = b.order.get(i);
            b.order.set(i, b.order.get(j));
            b.order.set(j, t);
            j = j - 1;
        }
    }
    return i - first;
}

// The best SAH split of node n: [cost, axis, split position]; cost is
// BVH_FAR when nothing separates the centroids.
fn bvh_best_split(b: &Bvh, n: i64) -> Vec<f64> {
    val first: i64 = b.first.get(n);
    val count: i64 = b.count.get(n);
    var best: Vec<f64> = Vec::new();
    best.push(BVH_FAR);
    best.push(0.0);
    best.push(0.0);
    var axis: i64 = 0;
    while axis < 3 {
        var cmin: f64 = BVH_FAR;
        var cmax: f64 = 0.0 - BVH_FAR;
        var i: i64 = first;
        while i < first + count {
            val c: f64 = bvh_centroid(b, b.order.get(i), axis);
            if c < cmin {
                cmin = c;
            }
            if c > cmax {
                cmax = c;
            }
            i = i + 1;
        }
        if cmax > cmin {
            val scale: f64 = (BVH_BINS as f64) / (cmax - cmin);
            var bcount: Vec<i64> = Vec::filled(BVH_BINS, 0);
            var bmn: Vec<f64> = bvh_f64s(3 * BVH_BINS, BVH_FAR);
            var bmx: Vec<f64> = bvh_f64s(3 * BVH_BINS, 0.0 - BVH_FAR);
            i = first;
            while i < first + count {
                val p: i64 = b.order.get(i);
                var bi: i64 = ((bvh_centroid(b, p, axis) - cmin) * scale) as i64;
                if bi >= BVH_BINS {
                    bi = BVH_BINS - 1;
                }
                bcount.set(bi, bcount.get(bi) + 1);
                var k: i64 = 0;
                while k < 3 {
                    if b.pmin.get(3 * p + k) < bmn.get(3 * bi + k) {
                        bmn.set(3 * bi + k, b.pmin.get(3 * p + k));
                    }
                    if b.pmax.get(3 * p + k) > bmx.get(3 * bi + k) {
                        bmx.set(3 * bi + k, b.pmax.get(3 * p + k));
                    }
                    k = k + 1;
                }
                i = i + 1;
            }
            // sweep: areas and counts left of each plane, then right
            var left_area: Vec<f64> = bvh_f64s(BVH_BINS, 0.0);
            var left_n: Vec<i64> = Vec::filled(BVH_BINS, 0);
            var lmn: Vec<f64> = bvh_f64s(3, BVH_FAR);
            var lmx: Vec<f64> = bvh_f64s(3, 0.0 - BVH_FAR);
            var acc: i64 = 0;
            var s: i64 = 0;
            while s < BVH_BINS - 1 {
                acc = acc + bcount.get(s);
                var k: i64 = 0;
                while k < 3 {
                    if bmn.get(3 * s + k) < lmn.get(k) {
                        lmn.set(k, bmn.get(3 * s + k));
                    }
                    if bmx.get(3 * s + k) > lmx.get(k) {
                        lmx.set(k, bmx.get(3 * s + k));
                    }
                    k = k + 1;
                }
                left_n.set(s, acc);
                left_area.set(s, bvh_area(lmx.get(0) - lmn.get(0), lmx.get(1) - lmn.get(1), lmx.get(2) - lmn.get(2)));
                s = s + 1;
            }
            var rmn: Vec<f64> = bvh_f64s(3, BVH_FAR);
            var rmx: Vec<f64> = bvh_f64s(3, 0.0 - BVH_FAR);
            var racc: i64 = 0;
            val parea: f64 = bvh_node_area(b, n);
            s = BVH_BINS - 1;
            while s > 0 {
                racc = racc + bcount.get(s);
                var k: i64 = 0;
                while k < 3 {
                    if bmn.get(3 * s + k) < rmn.get(k) {
                        rmn.set(k, bmn.get(3 * s + k));
                    }
                    if bmx.get(3 * s + k) > rmx.get(k) {
                        rmx.set(k, bmx.get(3 * s + k));
                    }
                    k = k + 1;
                }
                val ln: i64 = left_n.get(s - 1);
                if ln > 0 && racc > 0 {
                    val ra: f64 = bvh_area(rmx.get(0) - rmn.get(0), rmx.get(1) - rmn.get(1), rmx.get(2) - rmn.get(2));
                    var cost: f64 = 1.0;
                    if parea > 0.0 {
                        cost = 1.0 + (left_area.get(s - 1) * (ln as f64) + ra * (racc as f64)) / parea;
                    } else {
                        cost = 1.0 + (count as f64);
                    }
                    if cost < best.get(0) {
                        best.set(0, cost);
                        best.set(1, axis as f64);
                        best.set(2, cmin + (s as f64) / scale);
                    }
                }
                s = s - 1;
            }
        }
        axis = axis + 1;
    }
    return best;
}

fn bvh_empty(pmin: Vec<f64>, pmax: Vec<f64>) -> Bvh {
    var order: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < pmin.len() / 3 {
        order.push(i);
        i = i + 1;
    }
    return Bvh {
        bmin: Vec::new(), bmax: Vec::new(), left: Vec::new(), first: Vec::new(), count: Vec::new(), order: order, pmin: pmin, pmax: pmax
    };
}

/// Build over primitive boxes (pmin/pmax: 3 values per primitive) with the
/// surface area heuristic. max_leaf >= 1.
pub fn bvh_build(pmin: Vec<f64>, pmax: Vec<f64>, max_leaf: i64) -> Bvh {
    var b: Bvh = bvh_empty(pmin, pmax);
    if b.order.len() == 0 {
        return b;
    }
    bvh_new_node(&mut b, 0, b.order.len());
    var stack: Vec<i64> = Vec::new();
    stack.push(0);
    while stack.len() > 0 {
        val n: i64 = stack.pop();
        val count: i64 = b.count.get(n);
        if count <= 1 {
            continue;
        }
        val sp: Vec<f64> = bvh_best_split(&b, n);
        if sp.get(0) >= BVH_FAR {
            continue;
        }
        if sp.get(0) >= (count as f64) && count <= max_leaf {
            continue;
        }
        val first: i64 = b.first.get(n);
        val nl: i64 = bvh_partition(&mut b, first, count, sp.get(1) as i64, sp.get(2));
        if nl == 0 || nl == count {
            continue;
        }
        val l: i64 = bvh_new_node(&mut b, first, nl);
        bvh_new_node(&mut b, first + nl, count - nl);
        b.left.set(n, l);
        b.count.set(n, 0);
        stack.push(l + 1);
        stack.push(l);
    }
    return b;
}

/// Build by splitting at the median centroid of the longest axis (for
/// comparison with the SAH build).
pub fn bvh_build_median(pmin: Vec<f64>, pmax: Vec<f64>, max_leaf: i64) -> Bvh {
    var b: Bvh = bvh_empty(pmin, pmax);
    if b.order.len() == 0 {
        return b;
    }
    bvh_new_node(&mut b, 0, b.order.len());
    var stack: Vec<i64> = Vec::new();
    stack.push(0);
    while stack.len() > 0 {
        val n: i64 = stack.pop();
        val count: i64 = b.count.get(n);
        if count <= max_leaf {
            continue;
        }
        val first: i64 = b.first.get(n);
        var axis: i64 = 0;
        var ext: f64 = -1.0;
        var k: i64 = 0;
        while k < 3 {
            val e: f64 = b.bmax.get(3 * n + k) - b.bmin.get(3 * n + k);
            if e > ext {
                ext = e;
                axis = k;
            }
            k = k + 1;
        }
        // sort the range by centroid (insertion sort)
        var i: i64 = first + 1;
        while i < first + count {
            val p: i64 = b.order.get(i);
            val c: f64 = bvh_centroid(&b, p, axis);
            var j: i64 = i - 1;
            while j >= first && bvh_centroid(&b, b.order.get(j), axis) > c {
                b.order.set(j + 1, b.order.get(j));
                j = j - 1;
            }
            b.order.set(j + 1, p);
            i = i + 1;
        }
        val nl: i64 = count / 2;
        val l: i64 = bvh_new_node(&mut b, first, nl);
        bvh_new_node(&mut b, first + nl, count - nl);
        b.left.set(n, l);
        b.count.set(n, 0);
        stack.push(l + 1);
        stack.push(l);
    }
    return b;
}

/// Recompute every box from new primitive boxes (same primitives).
pub fn bvh_refit(b: &mut Bvh, pmin: Vec<f64>, pmax: Vec<f64>) {
    b.pmin = pmin;
    b.pmax = pmax;
    var n: i64 = b.left.len() - 1;
    while n >= 0 {
        if b.left.get(n) < 0 {
            bvh_bound_leaf(b, n);
        } else {
            val l: i64 = b.left.get(n);
            var k: i64 = 0;
            while k < 3 {
                b.bmin.set(3 * n + k, math_min_f64(b.bmin.get(3 * l + k), b.bmin.get(3 * (l + 1) + k)));
                b.bmax.set(3 * n + k, math_max_f64(b.bmax.get(3 * l + k), b.bmax.get(3 * (l + 1) + k)));
                k = k + 1;
            }
        }
        n = n - 1;
    }
}

/// SAH cost of the tree: sum over nodes of area / root area, times 1 per
/// inner node and the primitive count per leaf.
pub fn bvh_sah_cost(b: &Bvh) -> f64 {
    if b.left.len() == 0 {
        return 0.0;
    }
    val root: f64 = bvh_node_area(b, 0);
    var total: f64 = 0.0;
    var n: i64 = 0;
    while n < b.left.len() {
        var a: f64 = 1.0;
        if root > 0.0 {
            a = bvh_node_area(b, n) / root;
        }
        if b.left.get(n) < 0 {
            total = total + a * (b.count.get(n) as f64);
        } else {
            total = total + a;
        }
        n = n + 1;
    }
    return total;
}

/// Depth of the deepest leaf (root = 1).
pub fn bvh_depth(b: &Bvh) -> i64 {
    if b.left.len() == 0 {
        return 0;
    }
    var depth: Vec<i64> = Vec::filled(b.left.len(), 0);
    depth.set(0, 1);
    var best: i64 = 1;
    var n: i64 = 0;
    while n < b.left.len() {
        val l: i64 = b.left.get(n);
        if l >= 0 {
            depth.set(l, depth.get(n) + 1);
            depth.set(l + 1, depth.get(n) + 1);
        } else if depth.get(n) > best {
            best = depth.get(n);
        }
        n = n + 1;
    }
    return best;
}

/// Is every primitive inside its leaf's box and every child inside its
/// parent's box?
pub fn bvh_check(b: &Bvh) -> bool {
    var n: i64 = 0;
    while n < b.left.len() {
        val l: i64 = b.left.get(n);
        var k: i64 = 0;
        while k < 3 {
            if l >= 0 {
                if b.bmin.get(3 * l + k) < b.bmin.get(3 * n + k) || b.bmax.get(3 * l + k) > b.bmax.get(3 * n + k) {
                    return false;
                }
                if b.bmin.get(3 * (l + 1) + k) < b.bmin.get(3 * n + k) || b.bmax.get(3 * (l + 1) + k) > b.bmax.get(3 * n + k) {
                    return false;
                }
            } else {
                var i: i64 = b.first.get(n);
                while i < b.first.get(n) + b.count.get(n) {
                    val p: i64 = b.order.get(i);
                    if b.pmin.get(3 * p + k) < b.bmin.get(3 * n + k) || b.pmax.get(3 * p + k) > b.bmax.get(3 * n + k) {
                        return false;
                    }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        n = n + 1;
    }
    return true;
}

// ─── Box queries ───────────────────────────────────────────────────────────

/// Primitives whose box overlaps [qmin, qmax] (touching counts).
pub fn bvh_query_aabb(b: &Bvh, qminx: f64, qminy: f64, qminz: f64, qmaxx: f64, qmaxy: f64, qmaxz: f64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if b.left.len() == 0 {
        return out;
    }
    var stack: Vec<i64> = Vec::new();
    stack.push(0);
    while stack.len() > 0 {
        val n: i64 = stack.pop();
        if b.bmin.get(3 * n) > qmaxx || b.bmax.get(3 * n) < qminx || b.bmin.get(3 * n + 1) > qmaxy || b.bmax.get(3 * n + 1) < qminy || b.bmin.get(3 * n + 2) > qmaxz || b.bmax.get(3 * n + 2) < qminz {
            continue;
        }
        val l: i64 = b.left.get(n);
        if l >= 0 {
            stack.push(l);
            stack.push(l + 1);
        } else {
            var i: i64 = b.first.get(n);
            while i < b.first.get(n) + b.count.get(n) {
                val p: i64 = b.order.get(i);
                if !(b.pmin.get(3 * p) > qmaxx || b.pmax.get(3 * p) < qminx || b.pmin.get(3 * p + 1) > qmaxy || b.pmax.get(3 * p + 1) < qminy || b.pmin.get(3 * p + 2) > qmaxz || b.pmax.get(3 * p + 2) < qminz) {
                    out.push(p);
                }
                i = i + 1;
            }
        }
    }
    return out;
}

// ─── Rays ──────────────────────────────────────────────────────────────────

pub struct BvhRay {
    pub ox: f64,
    pub oy: f64,
    pub oz: f64,
    pub dx: f64,
    pub dy: f64,
    pub dz: f64,
    pub ix: f64,
    pub iy: f64,
    pub iz: f64,
}

fn bvh_inv(d: f64) -> f64 {
    if d == 0.0 {
        return BVH_FAR;
    }
    return 1.0 / d;
}

pub fn bvh_ray(ox: f64, oy: f64, oz: f64, dx: f64, dy: f64, dz: f64) -> BvhRay {
    return BvhRay {
        ox: ox, oy: oy, oz: oz, dx: dx, dy: dy, dz: dz, ix: bvh_inv(dx), iy: bvh_inv(dy), iz: bvh_inv(dz)
    };
}

/// Entry distance of the ray into node n's box within [0, tmax], or -1.
pub fn bvh_ray_box(b: &Bvh, n: i64, r: &BvhRay, tmax: f64) -> f64 {
    var t0: f64 = 0.0;
    var t1: f64 = tmax;
    var k: i64 = 0;
    while k < 3 {
        var o: f64 = r.ox;
        var inv: f64 = r.ix;
        var d: f64 = r.dx;
        if k == 1 {
            o = r.oy;
            inv = r.iy;
            d = r.dy;
        } else if k == 2 {
            o = r.oz;
            inv = r.iz;
            d = r.dz;
        }
        val lo: f64 = b.bmin.get(3 * n + k);
        val hi: f64 = b.bmax.get(3 * n + k);
        if d == 0.0 {
            if o < lo || o > hi {
                return -1.0;
            }
        } else {
            var ta: f64 = (lo - o) * inv;
            var tb: f64 = (hi - o) * inv;
            if ta > tb {
                val tt: f64 = ta;
                ta = tb;
                tb = tt;
            }
            if ta > t0 {
                t0 = ta;
            }
            if tb < t1 {
                t1 = tb;
            }
            if t0 > t1 {
                return -1.0;
            }
        }
        k = k + 1;
    }
    return t0;
}

pub struct BvhHit {
    pub hit: bool,
    pub t: f64,
    pub prim: i64,
    pub u: f64,
    pub v: f64,
}

pub fn bvh_no_hit() -> BvhHit {
    return BvhHit {
        hit: false, t: BVH_FAR, prim: -1, u: 0.0, v: 0.0
    };
}

/// Moller-Trumbore: the hit of ray o + t d with triangle (a, b, c) for t in
/// (tmin, tmax), two-sided; u, v barycentric (point = a + u (b-a) + v (c-a)).
pub fn bvh_ray_triangle(r: &BvhRay, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, cx: f64, cy: f64, cz: f64, tmin: f64, tmax: f64) -> BvhHit {
    val e1x: f64 = bx - ax;
    val e1y: f64 = by - ay;
    val e1z: f64 = bz - az;
    val e2x: f64 = cx - ax;
    val e2y: f64 = cy - ay;
    val e2z: f64 = cz - az;
    val px: f64 = r.dy * e2z - r.dz * e2y;
    val py: f64 = r.dz * e2x - r.dx * e2z;
    val pz: f64 = r.dx * e2y - r.dy * e2x;
    val det: f64 = e1x * px + e1y * py + e1z * pz;
    if det > 0.0 - 0.000000000001 && det < 0.000000000001 {
        return bvh_no_hit();
    }
    val inv: f64 = 1.0 / det;
    val tx: f64 = r.ox - ax;
    val ty: f64 = r.oy - ay;
    val tz: f64 = r.oz - az;
    val u: f64 = (tx * px + ty * py + tz * pz) * inv;
    if u < 0.0 || u > 1.0 {
        return bvh_no_hit();
    }
    val qx: f64 = ty * e1z - tz * e1y;
    val qy: f64 = tz * e1x - tx * e1z;
    val qz: f64 = tx * e1y - ty * e1x;
    val v: f64 = (r.dx * qx + r.dy * qy + r.dz * qz) * inv;
    if v < 0.0 || u + v > 1.0 {
        return bvh_no_hit();
    }
    val t: f64 = (e2x * qx + e2y * qy + e2z * qz) * inv;
    if t <= tmin || t >= tmax {
        return bvh_no_hit();
    }
    return BvhHit {
        hit: true, t: t, prim: -1, u: u, v: v
    };
}

// ─── Triangle meshes ───────────────────────────────────────────────────────

pub struct BvhMesh {
    pub positions: Vec<f64>,
    pub indices: Vec<i64>,
    pub tree: Bvh,
}

fn bvh_tri_bounds(pos: &Vec<f64>, idx: &Vec<i64>, lo: bool) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    var t: i64 = 0;
    while t + 2 < idx.len() {
        var k: i64 = 0;
        while k < 3 {
            var v: f64 = pos.get(3 * idx.get(t) + k);
            var j: i64 = 1;
            while j < 3 {
                val w: f64 = pos.get(3 * idx.get(t + j) + k);
                if (lo && w < v) || (!lo && w > v) {
                    v = w;
                }
                j = j + 1;
            }
            out.push(v);
            k = k + 1;
        }
        t = t + 3;
    }
    return out;
}

/// A BVH over the triangles of an indexed mesh (positions xyz, 3 indices
/// per triangle).
pub fn bvh_mesh_new(positions: Vec<f64>, indices: Vec<i64>, max_leaf: i64) -> BvhMesh {
    val tree: Bvh = bvh_build(bvh_tri_bounds(&positions, &indices, true), bvh_tri_bounds(&positions, &indices, false), max_leaf);
    return BvhMesh {
        positions: positions, indices: indices, tree: tree
    };
}

/// New vertex positions, same triangles: refit instead of rebuilding.
pub fn bvh_mesh_refit(m: &mut BvhMesh, positions: Vec<f64>) {
    m.positions = positions;
    bvh_refit(&mut m.tree, bvh_tri_bounds(&m.positions, &m.indices, true), bvh_tri_bounds(&m.positions, &m.indices, false));
}

fn bvh_mesh_tri(m: &BvhMesh, r: &BvhRay, tri: i64, tmax: f64) -> BvhHit {
    val a: i64 = 3 * m.indices.get(3 * tri);
    val b: i64 = 3 * m.indices.get(3 * tri + 1);
    val c: i64 = 3 * m.indices.get(3 * tri + 2);
    var h: BvhHit = bvh_ray_triangle(r, m.positions.get(a), m.positions.get(a + 1), m.positions.get(a + 2), m.positions.get(b), m.positions.get(b + 1), m.positions.get(b + 2), m.positions.get(c), m.positions.get(c + 1), m.positions.get(c + 2), 0.0, tmax);
    h.prim = tri;
    return h;
}

/// The nearest triangle hit along the ray with 0 < t < tmax.
pub fn bvh_mesh_closest(m: &BvhMesh, ox: f64, oy: f64, oz: f64, dx: f64, dy: f64, dz: f64, tmax: f64) -> BvhHit {
    val r: BvhRay = bvh_ray(ox, oy, oz, dx, dy, dz);
    var best: BvhHit = bvh_no_hit();
    best.t = tmax;
    val b: Bvh = m.tree;
    if b.left.len() == 0 {
        return bvh_no_hit();
    }
    var stack: Vec<i64> = Vec::new();
    var dist: Vec<f64> = Vec::new();
    val t_root: f64 = bvh_ray_box(&b, 0, &r, best.t);
    if t_root < 0.0 {
        return bvh_no_hit();
    }
    stack.push(0);
    dist.push(t_root);
    while stack.len() > 0 {
        val n: i64 = stack.pop();
        val tn: f64 = dist.pop();
        if tn > best.t {
            continue;
        }
        val l: i64 = b.left.get(n);
        if l < 0 {
            var i: i64 = b.first.get(n);
            while i < b.first.get(n) + b.count.get(n) {
                val h: BvhHit = bvh_mesh_tri(m, &r, b.order.get(i), best.t);
                if h.hit && h.t < best.t {
                    best = h;
                }
                i = i + 1;
            }
        } else {
            val ta: f64 = bvh_ray_box(&b, l, &r, best.t);
            val tb: f64 = bvh_ray_box(&b, l + 1, &r, best.t);
            // push the far child first so the near one is visited first
            if ta >= 0.0 && tb >= 0.0 {
                if ta <= tb {
                    stack.push(l + 1);
                    dist.push(tb);
                    stack.push(l);
                    dist.push(ta);
                } else {
                    stack.push(l);
                    dist.push(ta);
                    stack.push(l + 1);
                    dist.push(tb);
                }
            } else if ta >= 0.0 {
                stack.push(l);
                dist.push(ta);
            } else if tb >= 0.0 {
                stack.push(l + 1);
                dist.push(tb);
            }
        }
    }
    if !best.hit {
        return bvh_no_hit();
    }
    return best;
}

/// Is any triangle hit with 0 < t < tmax? (Stops at the first one.)
pub fn bvh_mesh_any(m: &BvhMesh, ox: f64, oy: f64, oz: f64, dx: f64, dy: f64, dz: f64, tmax: f64) -> bool {
    val r: BvhRay = bvh_ray(ox, oy, oz, dx, dy, dz);
    val b: Bvh = m.tree;
    if b.left.len() == 0 {
        return false;
    }
    var stack: Vec<i64> = Vec::new();
    stack.push(0);
    while stack.len() > 0 {
        val n: i64 = stack.pop();
        if bvh_ray_box(&b, n, &r, tmax) < 0.0 {
            continue;
        }
        val l: i64 = b.left.get(n);
        if l < 0 {
            var i: i64 = b.first.get(n);
            while i < b.first.get(n) + b.count.get(n) {
                if bvh_mesh_tri(m, &r, b.order.get(i), tmax).hit {
                    return true;
                }
                i = i + 1;
            }
        } else {
            stack.push(l);
            stack.push(l + 1);
        }
    }
    return false;
}

/// Brute force closest hit over every triangle (reference for tests).
pub fn bvh_mesh_closest_brute(m: &BvhMesh, ox: f64, oy: f64, oz: f64, dx: f64, dy: f64, dz: f64, tmax: f64) -> BvhHit {
    val r: BvhRay = bvh_ray(ox, oy, oz, dx, dy, dz);
    var best: BvhHit = bvh_no_hit();
    var bt: f64 = tmax;
    var t: i64 = 0;
    while t < m.indices.len() / 3 {
        val h: BvhHit = bvh_mesh_tri(m, &r, t, bt);
        if h.hit && h.t < bt {
            best = h;
            bt = h.t;
        }
        t = t + 1;
    }
    return best;
}
