// Fides secret storage: an encrypted file vault, pure Fides crypto
//
// A small password manager's building blocks:
//   - PBKDF2-HMAC-SHA512 (RFC 8018 §5.2), implemented here on stdlib
//     sha512's HMAC: the key-derivation function that turns a passphrase
//     and a salt into a vault key
//   - a vault: named entries (a label and a secret value), serialized to a
//     flat byte format and sealed with AES-256-GCM (stdlib aes_gcm) under a
//     key derived from the passphrase; the file holds a header, the random
//     salt, the iteration count, the IV, and the ciphertext+tag
//   - zeroizing buffers: a helper that overwrites a Vec's bytes with zero
//     when a secret is no longer needed (defense in depth; the compiler's
//     own @zeroize is the stronger tool where it applies)
//
// The vault format (all integers big-endian):
//   magic "FIDVAULT" (8) | version (1) | kdf_iters (u32) | salt_len (1) |
//   salt | iv (12) | ciphertext | tag (16)
// The plaintext inside is: count (u32), then each entry as
//   label_len (u16) | label | value_len (u32) | value
//
// OS keychain integration is behind an extern seam (declared, not called
// here): DPAPI on Windows, the macOS Keychain, the Secret Service on Linux.
// The vault above needs none of them; it is self-contained. The test
// exercises PBKDF2 (RFC vectors), the round trip, and tamper detection.
//
// Usage:
//   var v: Vault = vault_new();
//   vault_set(& mut v, "github", str_bytes("token-123"));
//   val blob: Vec<i64> = vault_seal(& v, "correct horse", 100000);
//   val o: VaultOpened = vault_open(blob, "correct horse");
//   if o.ok { use(vault_get(& o.vault, "github")); }

module secrets;
 use vec; use sha512; use aes_gcm;

// ─── PBKDF2-HMAC-SHA512 ─────────────────────────────────────────────────

fn sc_be32(o: & mut Vec<i64>, v: i64) {
    o.push((v >> 24) & 255);
    o.push((v >> 16) & 255);
    o.push((v >> 8) & 255);
    o.push(v & 255);
}

/// PBKDF2 (RFC 8018) with HMAC-SHA512 as the PRF: derive `dklen` bytes from
/// `password` and `salt` over `iters` iterations. `iters` >= 1.
pub fn pbkdf2_sha512(password: Vec<i64>, salt: Vec<i64>, iters: i64, dklen: i64) -> Vec<i64> {
    val hlen: i64 = 64;
    val blocks: i64 = (dklen + hlen - 1) / hlen;
    var out: Vec<i64> = Vec::new();
    var b: i64 = 1;
    while b <= blocks {
        // U1 = PRF(password, salt || INT(b))
        var msg: Vec<i64> = Vec::new();
        var si: i64 = 0;
        while si < salt.len() {
            msg.push(salt.get(si) & 255);
            si = si + 1;
        }
        sc_be32(& mut msg, b);
        var u: Vec<i64> = hmac_sha512_bytes(password, msg);
        var t: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < hlen {
            t.push(u.get(k));
            k = k + 1;
        }
        var it: i64 = 1;
        while it < iters {
            u = hmac_sha512_bytes(password, u);
            k = 0;
            while k < hlen {
                t.set(k, t.get(k) ^ u.get(k));
                k = k + 1;
            }
            it = it + 1;
        }
        k = 0;
        while k < hlen && out.len() < dklen {
            out.push(t.get(k));
            k = k + 1;
        }
        b = b + 1;
    }
    return out;
}

/// PBKDF2-HMAC-SHA512 over the bytes of two strings.
pub fn pbkdf2_sha512_str(password: str, salt: str, iters: i64, dklen: i64) -> Vec<i64> {
    return pbkdf2_sha512(str_bytes(password), str_bytes(salt), iters, dklen);
}

// ─── zeroizing ──────────────────────────────────────────────────────────

/// Overwrite every byte of `b` with zero (wipe a secret after use).
pub fn zeroize(b: & mut Vec<i64>) {
    var i: i64 = 0;
    while i < b.len() {
        b.set(i, 0);
        i = i + 1;
    }
}

// ─── vault ──────────────────────────────────────────────────────────────

pub struct VaultEntry {
    pub label: str,
    pub value: Vec<i64>,
}

pub struct Vault {
    pub entries: Vec<VaultEntry>,
}

/// The result of opening a sealed vault.
pub struct VaultOpened {
    pub ok: bool,
    pub error: str,
    pub vault: Vault,
}

pub fn vault_new() -> Vault {
    return Vault { entries: Vec::new() };
}

/// Set (or replace) the secret under `label`.
pub fn vault_set(v: & mut Vault, label: str, value: Vec<i64>) {
    var i: i64 = 0;
    while i < v.entries.len() {
        if v.entries.get(i).label == label {
            v.entries.set(i, VaultEntry { label: label, value: value });
            return;
        }
        i = i + 1;
    }
    v.entries.push(VaultEntry { label: label, value: value });
}

/// The secret under `label`, or [] when absent.
pub fn vault_get(v: & Vault, label: str) -> Vec<i64> {
    var i: i64 = 0;
    while i < v.entries.len() {
        if v.entries.get(i).label == label {
            return v.entries.get(i).value;
        }
        i = i + 1;
    }
    return Vec::new();
}

pub fn vault_has(v: & Vault, label: str) -> bool {
    var i: i64 = 0;
    while i < v.entries.len() {
        if v.entries.get(i).label == label {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Remove `label`; returns whether it was present.
pub fn vault_remove(v: & mut Vault, label: str) -> bool {
    var i: i64 = 0;
    while i < v.entries.len() {
        if v.entries.get(i).label == label {
            v.entries.remove(i);
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The labels in insertion order.
pub fn vault_labels(v: & Vault) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < v.entries.len() {
        out.push(v.entries.get(i).label);
        i = i + 1;
    }
    return out;
}

fn sc_be16(o: & mut Vec<i64>, v: i64) {
    o.push((v >> 8) & 255);
    o.push(v & 255);
}

/// The plaintext encoding of the entries (before encryption).
pub fn vault_encode(v: & Vault) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    sc_be32(& mut o, v.entries.len());
    var i: i64 = 0;
    while i < v.entries.len() {
        val e: VaultEntry = v.entries.get(i);
        val lb: Vec<i64> = str_bytes(e.label);
        sc_be16(& mut o, lb.len());
        var j: i64 = 0;
        while j < lb.len() {
            o.push(lb.get(j) & 255);
            j = j + 1;
        }
        sc_be32(& mut o, e.value.len());
        j = 0;
        while j < e.value.len() {
            o.push(e.value.get(j) & 255);
            j = j + 1;
        }
        i = i + 1;
    }
    return o;
}

fn sc_rd32(b: & Vec<i64>, o: i64) -> i64 {
    return ((b.get(o) & 255) << 24) | ((b.get(o + 1) & 255) << 16) | ((b.get(o + 2) & 255) << 8) | (b.get(o + 3) & 255);
}

fn sc_rd16(b: & Vec<i64>, o: i64) -> i64 {
    return ((b.get(o) & 255) << 8) | (b.get(o + 1) & 255);
}

fn sc_slice(b: & Vec<i64>, o: i64, n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        out.push(b.get(o + i) & 255);
        i = i + 1;
    }
    return out;
}

/// Parse the plaintext back into a vault (ok=false on a malformed blob).
pub fn vault_decode(b: Vec<i64>) -> VaultOpened {
    var v: Vault = vault_new();
    if b.len() < 4 {
        return VaultOpened { ok: false, error: "truncated", vault: v };
    }
    val n: i64 = sc_rd32(& b, 0);
    var o: i64 = 4;
    var i: i64 = 0;
    while i < n {
        if o + 2 > b.len() {
            return VaultOpened { ok: false, error: "truncated label length", vault: v };
        }
        val ll: i64 = sc_rd16(& b, o);
        o = o + 2;
        if o + ll + 4 > b.len() {
            return VaultOpened { ok: false, error: "truncated label", vault: v };
        }
        val label: str = str_from_bytes(sc_slice(& b, o, ll));
        o = o + ll;
        val vl: i64 = sc_rd32(& b, o);
        o = o + 4;
        if o + vl > b.len() {
            return VaultOpened { ok: false, error: "truncated value", vault: v };
        }
        v.entries.push(VaultEntry { label: label, value: sc_slice(& b, o, vl) });
        o = o + vl;
        i = i + 1;
    }
    return VaultOpened { ok: true, error: "", vault: v };
}

// ─── sealing ────────────────────────────────────────────────────────────

const SC_MAGIC: str = "FIDVAULT";
const SC_VERSION: i64 = 1;

/// Seal a vault: derive a 32-byte key from the passphrase with PBKDF2 over
/// `iters`, then AES-256-GCM. `salt` and `iv` are given so a test is
/// reproducible; use vault_seal for random ones.
pub fn vault_seal_with(v: & Vault, passphrase: str, iters: i64, salt: Vec<i64>, iv: Vec<i64>) -> Vec<i64> {
    val key: Vec<i64> = pbkdf2_sha512_str(passphrase, str_from_bytes(salt), iters, 32);
    val plain: Vec<i64> = vault_encode(v);
    val aad: Vec<i64> = str_bytes(SC_MAGIC);
    val sealed: Vec<i64> = aes_gcm_seal(key, iv, aad, plain);
    var o: Vec<i64> = Vec::new();
    val mb: Vec<i64> = str_bytes(SC_MAGIC);
    var i: i64 = 0;
    while i < mb.len() {
        o.push(mb.get(i));
        i = i + 1;
    }
    o.push(SC_VERSION);
    sc_be32(& mut o, iters);
    o.push(salt.len());
    i = 0;
    while i < salt.len() {
        o.push(salt.get(i) & 255);
        i = i + 1;
    }
    i = 0;
    while i < iv.len() {
        o.push(iv.get(i) & 255);
        i = i + 1;
    }
    i = 0;
    while i < sealed.len() {
        o.push(sealed.get(i) & 255);
        i = i + 1;
    }
    return o;
}

/// Seal with a fresh random 16-byte salt and 12-byte IV (p_os_random_u64).
pub fn vault_seal(v: & Vault, passphrase: str, iters: i64) -> Vec<i64> {
    return vault_seal_with(v, passphrase, iters, secrets_random(16), secrets_random(12));
}

/// `n` random bytes from the OS RNG.
pub fn secrets_random(n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    while out.len() < n {
        var r: i64 = p_os_random_u64();
        var k: i64 = 0;
        while k < 8 && out.len() < n {
            out.push(r & 255);
            r = r >> 8;
            k = k + 1;
        }
    }
    return out;
}

/// Open a sealed vault with the passphrase. ok=false when the magic is
/// wrong, the blob is truncated, or the tag does not verify (a wrong
/// passphrase or a tampered file both fail here).
pub fn vault_open(blob: Vec<i64>, passphrase: str) -> VaultOpened {
    val fail: Vault = vault_new();
    val mb: Vec<i64> = str_bytes(SC_MAGIC);
    if blob.len() < mb.len() + 1 + 4 + 1 {
        return VaultOpened { ok: false, error: "too short", vault: fail };
    }
    var i: i64 = 0;
    while i < mb.len() {
        if (blob.get(i) & 255) != mb.get(i) {
            return VaultOpened { ok: false, error: "bad magic", vault: fail };
        }
        i = i + 1;
    }
    var o: i64 = mb.len();
    val version: i64 = blob.get(o);
    o = o + 1;
    if version != SC_VERSION {
        return VaultOpened { ok: false, error: "unsupported version", vault: fail };
    }
    val iters: i64 = sc_rd32(& blob, o);
    o = o + 4;
    val slen: i64 = blob.get(o);
    o = o + 1;
    if o + slen + 12 + 16 > blob.len() {
        return VaultOpened { ok: false, error: "truncated", vault: fail };
    }
    val salt: Vec<i64> = sc_slice(& blob, o, slen);
    o = o + slen;
    val iv: Vec<i64> = sc_slice(& blob, o, 12);
    o = o + 12;
    val sealed: Vec<i64> = sc_slice(& blob, o, blob.len() - o);
    val key: Vec<i64> = pbkdf2_sha512_str(passphrase, str_from_bytes(salt), iters, 32);
    val aad: Vec<i64> = str_bytes(SC_MAGIC);
    val opened: GcmOpened = aes_gcm_open(key, iv, aad, sealed);
    if !opened.ok {
        return VaultOpened { ok: false, error: "wrong passphrase or tampered vault", vault: fail };
    }
    return vault_decode(opened.plain);
}

// ─── OS keychain seam (declared, not called here) ───────────────────────
//
// On each platform a real integration would use these. They are kept as a
// documented interface; this module's own vault needs none of them.
//
// Windows DPAPI (dpapi.h): wrappers around CryptProtectData /
//   CryptUnprotectData — encrypt a blob to the current user or machine.
// macOS Keychain (Security.framework): SecItemAdd / SecItemCopyMatching /
//   SecItemDelete with kSecClassGenericPassword.
// Linux Secret Service (libsecret): secret_password_store_sync /
//   secret_password_lookup_sync / secret_password_clear_sync.
//
// A caller wires one in by implementing this transport over its FFI:

/// A keychain backend: store, load (len<0 = absent) and delete a secret by
/// service+account. A caller supplies function values bound to DPAPI, the
/// macOS Keychain or the Secret Service.
pub struct Keychain {
    pub store: fn(str, str, Vec<i64>) -> bool,
    pub load: fn(str, str) -> Vec<i64>,
    pub remove: fn(str, str) -> bool,
}

/// Store a secret through a keychain backend.
pub fn keychain_store(k: & Keychain, service: str, account: str, secret: Vec<i64>) -> bool {
    val f = k.store;
    return f(service, account, secret);
}

/// Load a secret through a keychain backend ([] when absent).
pub fn keychain_load(k: & Keychain, service: str, account: str) -> Vec<i64> {
    val f = k.load;
    return f(service, account);
}
