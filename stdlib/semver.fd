// Fides Semantic Versioning standard library
//
// SemVer 2.0.0 parsing, comparison, and range matching — everything a
// package manager (ark) needs for dependency resolution.
//
// Usage:
//   use semver;
//   val v = semver_parse("1.4.2-rc.1+build.7");
//   println(semver_to_str(v));
//   println(bool_to_str(semver_satisfies_str("1.4.2", "^1.0.0")));

module semver;

use vec;
use string;

// ─── Version struct ─────────────────────────────────────────────────────

/// A parsed semantic version. `pre` and `build` are raw strings
/// ("" when absent). `major == -1` marks an invalid parse.
pub struct SemVer {
    pub major: i64,
    pub minor: i64,
    pub patch: i64,
    pub pre: str,
    pub build: str,
}

fn sv_invalid() -> SemVer {
    return SemVer { major: -1, minor: 0, patch: 0, pre: "", build: "" };
}

// ─── Helpers ────────────────────────────────────────────────────────────

fn sv_is_digit(c: i64) -> bool { return c >= 48 && c <= 57; }

fn sv_is_ident_char(c: i64) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) ||
           (c >= 97 && c <= 122) || c == 45;
}

fn sv_all_digits(s: str) -> bool {
    if str_len(s) == 0 { return false; }
    var i: i64 = 0;
    while i < str_len(s) {
        if !sv_is_digit(str_byte_at(s, i)) { return false; }
        i = i + 1;
    }
    return true;
}

fn sv_all_ident(s: str) -> bool {
    if str_len(s) == 0 { return false; }
    var i: i64 = 0;
    while i < str_len(s) {
        if !sv_is_ident_char(str_byte_at(s, i)) { return false; }
        i = i + 1;
    }
    return true;
}

// Strictly validate a numeric field: non-empty, digits, no leading zeros.
fn sv_valid_num(s: str) -> bool {
    if !sv_all_digits(s) { return false; }
    if str_len(s) > 1 && str_byte_at(s, 0) == 48 { return false; }
    return true;
}

// Validate a dot-separated identifier list (pre-release or build).
fn sv_valid_idents(s: str, numeric_rules: bool) -> bool {
    if str_len(s) == 0 { return false; }
    var parts: Vec = str_split(s, ".");
    var i: i64 = 0;
    while i < parts.len() {
        var p: str = parts.get(i);
        if !sv_all_ident(p) { return false; }
        if numeric_rules && sv_all_digits(p) {
            if str_len(p) > 1 && str_byte_at(p, 0) == 48 { return false; }
        }
        i = i + 1;
    }
    return true;
}

// ─── Parsing ────────────────────────────────────────────────────────────

/// Parse a SemVer string. Returns a SemVer with major == -1 on failure;
/// check with semver_is_valid(v) or semver_is_valid_str(s) first.
pub fn semver_parse(s: str) -> SemVer {
    var work: str = str_trim(s);
    var build: str = "";
    var pre: str = "";

    // Split off build metadata (+...)
    var plus: i64 = str_find(work, "+");
    if plus >= 0 {
        build = str_slice(work, plus + 1, str_len(work));
        work = str_slice(work, 0, plus);
        if !sv_valid_idents(build, false) { return sv_invalid(); }
    }

    // Split off pre-release (-...); first '-' after the version core.
    var dash: i64 = str_find(work, "-");
    if dash >= 0 {
        pre = str_slice(work, dash + 1, str_len(work));
        work = str_slice(work, 0, dash);
        if !sv_valid_idents(pre, true) { return sv_invalid(); }
    }

    var nums: Vec = str_split(work, ".");
    if nums.len() != 3 { return sv_invalid(); }
    var a: str = nums.get(0);
    var b: str = nums.get(1);
    var c: str = nums.get(2);
    if !sv_valid_num(a) || !sv_valid_num(b) || !sv_valid_num(c) {
        return sv_invalid();
    }
    return SemVer {
        major: str_parse_int(a),
        minor: str_parse_int(b),
        patch: str_parse_int(c),
        pre: pre,
        build: build,
    };
}

/// True if `v` is a successfully parsed version.
pub fn semver_is_valid(v: SemVer) -> bool {
    return v.major >= 0;
}

/// True if `s` parses as a valid SemVer string.
pub fn semver_is_valid_str(s: str) -> bool {
    return semver_is_valid(semver_parse(s));
}

/// Format back to canonical SemVer text (build metadata preserved).
pub fn semver_to_str(v: SemVer) -> str {
    if v.major < 0 { return "invalid"; }
    var s: str = int_to_str(v.major) + "." + int_to_str(v.minor) + "." + int_to_str(v.patch);
    if str_len(v.pre) > 0 { s = s + "-" + v.pre; }
    if str_len(v.build) > 0 { s = s + "+" + v.build; }
    return s;
}

// ─── Comparison (SemVer 2.0.0 §11; build metadata ignored) ──────────────

// Compare two pre-release identifier lists.
// Numeric identifiers compare numerically and are lower than alphanumeric.
fn sv_pre_compare(a: str, b: str) -> i64 {
    if str_len(a) == 0 && str_len(b) == 0 { return 0; }
    // A version without pre-release has HIGHER precedence.
    if str_len(a) == 0 { return 1; }
    if str_len(b) == 0 { return -1; }
    var pa: Vec = str_split(a, ".");
    var pb: Vec = str_split(b, ".");
    var n: i64 = pa.len();
    if pb.len() < n { n = pb.len(); }
    var i: i64 = 0;
    while i < n {
        var xa: str = pa.get(i);
        var xb: str = pb.get(i);
        var na: bool = sv_all_digits(xa);
        var nb: bool = sv_all_digits(xb);
        if na && nb {
            var va: i64 = str_parse_int(xa);
            var vb: i64 = str_parse_int(xb);
            if va < vb { return -1; }
            if va > vb { return 1; }
        } else if na && !nb {
            return -1;
        } else if !na && nb {
            return 1;
        } else {
            var c: i64 = str_compare(xa, xb);
            if c != 0 { return c; }
        }
        i = i + 1;
    }
    // Shorter set has lower precedence when all shared identifiers equal.
    if pa.len() < pb.len() { return -1; }
    if pa.len() > pb.len() { return 1; }
    return 0;
}

/// Compare two versions: -1 if a < b, 0 if equal precedence, 1 if a > b.
pub fn semver_compare(a: SemVer, b: SemVer) -> i64 {
    if a.major < b.major { return -1; }
    if a.major > b.major { return 1; }
    if a.minor < b.minor { return -1; }
    if a.minor > b.minor { return 1; }
    if a.patch < b.patch { return -1; }
    if a.patch > b.patch { return 1; }
    return sv_pre_compare(a.pre, b.pre);
}

/// Compare two version strings. Invalid versions sort before all valid ones.
pub fn semver_compare_str(a: str, b: str) -> i64 {
    return semver_compare(semver_parse(a), semver_parse(b));
}

pub fn semver_eq(a: SemVer, b: SemVer) -> bool {
    return semver_compare(a, b) == 0;
}

pub fn semver_lt(a: SemVer, b: SemVer) -> bool {
    return semver_compare(a, b) < 0;
}

pub fn semver_gt(a: SemVer, b: SemVer) -> bool {
    return semver_compare(a, b) > 0;
}

// ─── Range matching ─────────────────────────────────────────────────────
// Supported comparators (space-separated = AND):
//   * | 1.2.3 | =1.2.3 | >1.2.3 | >=1.2.3 | <1.2.3 | <=1.2.3
//   ^1.2.3   compatible (>=1.2.3 <2.0.0; left-most nonzero digit pins)
//   ~1.2.3   patch-level (>=1.2.3 <1.3.0)
// Partial versions in comparators: missing fields default to 0 and the
// bound becomes a prefix bound for ^ and ~.

fn sv_cmp_one(v: SemVer, op: str, c: SemVer) -> bool {
    var d: i64 = semver_compare(v, c);
    if str_equal(op, "=") || str_equal(op, "==") { return d == 0; }
    if str_equal(op, ">") { return d > 0; }
    if str_equal(op, ">=") { return d >= 0; }
    if str_equal(op, "<") { return d < 0; }
    if str_equal(op, "<=") { return d <= 0; }
    return false;
}

// Does a comparator token like "^1.2" have all three numeric fields?
fn sv_full(version_text: str) -> bool {
    var core: str = version_text;
    var plus: i64 = str_find(core, "+");
    if plus >= 0 { core = str_slice(core, 0, plus); }
    var dash: i64 = str_find(core, "-");
    if dash >= 0 { core = str_slice(core, 0, dash); }
    return str_split(core, ".").len() == 3;
}

fn sv_pad(version_text: str) -> str {
    // "1.2" -> "1.2.0", "1" -> "1.0.0"; leaves pre/build attached.
    var core: str = version_text;
    var tail: str = "";
    var plus: i64 = str_find(core, "+");
    if plus >= 0 {
        tail = str_slice(core, plus, str_len(core));
        core = str_slice(core, 0, plus);
    }
    var dash: i64 = str_find(core, "-");
    if dash >= 0 {
        tail = str_slice(core, dash, str_len(core)) + tail;
        core = str_slice(core, 0, dash);
    }
    var n: i64 = str_split(core, ".").len();
    while n < 3 {
        core = core + ".0";
        n = n + 1;
    }
    return core + tail;
}

/// True if version `v` satisfies range expression `range`.
/// Examples: "*", "1.2.3", "^1.2", "~1.4.0", ">=1.0 <2.0".
pub fn semver_satisfies(v: SemVer, range: str) -> bool {
    if v.major < 0 { return false; }
    var r: str = str_trim(range);
    if str_len(r) == 0 || str_equal(r, "*") || str_equal(r, "x") {
        return true;
    }
    // Union: "a || b"
    var ors: Vec = str_split(r, "||");
    var oi: i64 = 0;
    while oi < ors.len() {
        var branch: str = str_trim(ors.get(oi));
        if sv_satisfies_branch(v, branch) { return true; }
        oi = oi + 1;
    }
    return false;
}

/// Convenience: semver_satisfies(semver_parse(v), range).
pub fn semver_satisfies_str(v: str, range: str) -> bool {
    return semver_satisfies(semver_parse(v), range);
}

fn sv_satisfies_branch(v: SemVer, branch: str) -> bool {
    var b: str = str_trim(branch);
    if str_len(b) == 0 || str_equal(b, "*") { return true; }

    // Hyphen range: "1.2.3 - 2.0.0" means >=1.2.3 <=2.0.0
    var hy: i64 = str_find(b, " - ");
    if hy >= 0 {
        var lo: SemVer = semver_parse(sv_pad(str_trim(str_slice(b, 0, hy))));
        var hi: SemVer = semver_parse(sv_pad(str_trim(str_slice(b, hy + 3, str_len(b)))));
        if !semver_is_valid(lo) || !semver_is_valid(hi) { return false; }
        if str_len(v.pre) > 0 && !sv_branch_mentions_pre(b) { return false; }
        return semver_compare(v, lo) >= 0 && semver_compare(v, hi) <= 0;
    }

    // npm rule: a pre-release version only matches a range that
    // explicitly names a pre-release in some comparator.
    if str_len(v.pre) > 0 && !sv_branch_mentions_pre(b) { return false; }

    // AND of whitespace-separated comparator tokens.
    var toks: Vec = str_split_char(b, 32);
    var i: i64 = 0;
    while i < toks.len() {
        var t: str = str_trim(toks.get(i));
        i = i + 1;
        if str_len(t) == 0 { continue; }
        if !sv_match_token(v, t) { return false; }
    }
    return true;
}

// Does any token in the range carry a "-prerelease" suffix?
fn sv_branch_mentions_pre(b: str) -> bool {
    var toks: Vec = str_split_char(b, 32);
    var i: i64 = 0;
    while i < toks.len() {
        var t: str = str_trim(toks.get(i));
        i = i + 1;
        if str_len(t) == 0 { continue; }
        // strip a leading operator before looking for '-'
        var j: i64 = 0;
        while j < str_len(t) {
            var c: i64 = str_byte_at(t, j);
            if c == 94 || c == 126 || c == 60 || c == 61 || c == 62 { j = j + 1; }
            else { break; }
        }
        var k: i64 = j;
        while k < str_len(t) {
            if str_byte_at(t, k) == 45 { return true; }
            if str_byte_at(t, k) == 43 { break; }  // build metadata, not pre
            k = k + 1;
        }
    }
    return false;
}

fn sv_match_token(v: SemVer, t: str) -> bool {
    if str_equal(t, "*") || str_equal(t, "x") { return true; }
    var op: str = "=";
    var rest: str = t;
    var c0: i64 = str_byte_at(t, 0);

    if c0 == 94 {                          // '^'
        var c: SemVer = semver_parse(sv_pad(str_slice(t, 1, str_len(t))));
        if !semver_is_valid(c) { return false; }
        if semver_compare(v, c) < 0 { return false; }
        // Upper bound: bump left-most non-zero component.
        var hi: SemVer = SemVer {
            major: c.major + 1, minor: 0, patch: 0, pre: "", build: "" };
        if c.major == 0 {
            if c.minor > 0 {
                hi = SemVer { major: 0, minor: c.minor + 1, patch: 0, pre: "", build: "" };
            } else {
                hi = SemVer { major: 0, minor: 0, patch: c.patch + 1, pre: "", build: "" };
            }
        }
        return semver_compare(v, hi) < 0;
    }
    if c0 == 126 {                         // '~'
        var c2: SemVer = semver_parse(sv_pad(str_slice(t, 1, str_len(t))));
        if !semver_is_valid(c2) { return false; }
        if semver_compare(v, c2) < 0 { return false; }
        var hi2: SemVer = SemVer {
            major: c2.major, minor: c2.minor + 1, patch: 0, pre: "", build: "" };
        return semver_compare(v, hi2) < 0;
    }
    // Longest-first operator prefix match.
    if str_starts_with(t, ">=") { op = ">="; rest = str_slice(t, 2, str_len(t)); }
    else if str_starts_with(t, "<=") { op = "<="; rest = str_slice(t, 2, str_len(t)); }
    else if str_starts_with(t, "==") { op = "=="; rest = str_slice(t, 2, str_len(t)); }
    else if c0 == 62 { op = ">"; rest = str_slice(t, 1, str_len(t)); }
    else if c0 == 60 { op = "<"; rest = str_slice(t, 1, str_len(t)); }
    else if c0 == 61 { op = "="; rest = str_slice(t, 1, str_len(t)); }

    var target: SemVer = semver_parse(sv_pad(str_trim(rest)));
    if !semver_is_valid(target) { return false; }
    return sv_cmp_one(v, op, target);
}

// ─── Convenience queries ────────────────────────────────────────────────

/// Highest-precedence version in a list of version strings.
/// Returns "" when the list is empty or contains no valid versions.
pub fn semver_max(versions: Vec) -> str {
    var best: SemVer = sv_invalid();
    var best_s: str = "";
    var i: i64 = 0;
    while i < versions.len() {
        var s: str = versions.get(i);
        var v: SemVer = semver_parse(s);
        if semver_is_valid(v) {
            if str_len(best_s) == 0 || semver_compare(v, best) > 0 {
                best = v;
                best_s = s;
            }
        }
        i = i + 1;
    }
    return best_s;
}

/// Highest-precedence version satisfying `range`, or "" if none.
pub fn semver_max_satisfying(versions: Vec, range: str) -> str {
    var best: SemVer = sv_invalid();
    var best_s: str = "";
    var i: i64 = 0;
    while i < versions.len() {
        var s: str = versions.get(i);
        var v: SemVer = semver_parse(s);
        if semver_is_valid(v) && semver_satisfies(v, range) {
            if str_len(best_s) == 0 || semver_compare(v, best) > 0 {
                best = v;
                best_s = s;
            }
        }
        i = i + 1;
    }
    return best_s;
}
