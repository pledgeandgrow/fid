// Fides IMU processing library (robotics / sensors)
//
// Attitude and heading from gyroscope, accelerometer and magnetometer
// samples, on quat.fd's quaternions:
//   - Madgwick's gradient-descent AHRS (S. Madgwick, "An efficient
//     orientation filter for inertial and inertial/magnetic sensor arrays",
//     2010), 6-axis (gyro + accel) and 9-axis (+ magnetometer). The step is
//     the normalized gradient J' f of the paper's objective functions; for
//     9 axes the earth field reference is b = (|h_xy|, 0, h_z) of eq. 45-46
//     (the widely copied MadgwickAHRS.c uses half of it in its residual).
//   - Mahony's complementary filter on SO(3) (R. Mahony et al., 2008, in
//     the form of MahonyAHRS.c): proportional and integral feedback of the
//     cross product of measured and estimated directions.
//   - Gyro bias estimation while the sensor is at rest (gyro magnitude and
//     |accel| - 1 g under thresholds for a run of samples).
//   - Accelerometer calibration from its readings along +-g on each axis
//     (offset and scale per axis), magnetometer hard iron (offset) and
//     axis-aligned soft iron (scale) from the min/max of a rotation, and
//     the corrected samples.
//   - Gravity removal: linear acceleration in the earth or the body frame.
//
// Conventions: the quaternion q rotates body (sensor) vectors into the earth
// frame, v_earth = q v_body q* (quat.fd's qt_rotate); earth z is up, so an
// accelerometer at rest reads +1 g on the body axis that points up; earth x
// is magnetic north for the 9-axis filters. Gyro rates in rad/s.
// Everything is pure computation. The seam is the caller, which reads the
// sensor registers (stdlib/regmap, i2c, spi), converts the raw counts to
// these units and passes them in.
//
// Usage:
//   use imu;
//   var f: Madgwick = madgwick_new(0.1);
//   madgwick_update_imu(&mut f, gyro, accel, dt);
//   val e: EulerZYX = qt_to_euler_zyx(f.q);

module imu;
use math;
use quat;

// ─── helpers ───

fn imu_norm3(v: vec3) -> f64 {
    return math_sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
}

fn imu_unit3(v: vec3) -> vec3 {
    val n: f64 = imu_norm3(v);
    if n == 0.0 {
        return v;
    }
    return vec3(v.x / n, v.y / n, v.z / n);
}

/// The gravity direction (unit, body frame) an orientation predicts.
pub fn imu_gravity_body(q: quat) -> vec3 {
    return qt_rotate(qt_conj(q), vec3(0.0, 0.0, 1.0));
}

/// q advanced by the gyro rates over dt (q += 0.5 q (0, w) dt, normalized).
pub fn imu_gyro_step(q: quat, g: vec3, dt: f64) -> quat {
    val dw: f64 = 0.5 * (0.0 - q.x * g.x - q.y * g.y - q.z * g.z);
    val dx: f64 = 0.5 * (q.w * g.x + q.y * g.z - q.z * g.y);
    val dy: f64 = 0.5 * (q.w * g.y - q.x * g.z + q.z * g.x);
    val dz: f64 = 0.5 * (q.w * g.z + q.x * g.y - q.y * g.x);
    return qt_normalize(quat(q.w + dw * dt, q.x + dx * dt, q.y + dy * dt, q.z + dz * dt));
}

// ─── Madgwick ───

pub struct Madgwick {
    pub q: quat,
    pub beta: f64,
}

pub fn madgwick_new(beta: f64) -> Madgwick {
    return Madgwick { q: qt_identity(), beta: beta };
}

/// One 6-axis update (gyro rad/s, accel in any unit, dt seconds). A zero
/// accelerometer reading integrates the gyro alone.
pub fn madgwick_update_imu(f: & mut Madgwick, g: vec3, a: vec3, dt: f64) {
    madgwick_update(f, g, a, vec3(0.0, 0.0, 0.0), dt);
}

/// One 9-axis update; a zero magnetometer reading falls back to 6 axes.
pub fn madgwick_update(f: & mut Madgwick, g: vec3, a: vec3, m: vec3, dt: f64) {
    val q0: f64 = f.q.w;
    val q1: f64 = f.q.x;
    val q2: f64 = f.q.y;
    val q3: f64 = f.q.z;
    // rate of change from the gyro
    var d0: f64 = 0.5 * (0.0 - q1 * g.x - q2 * g.y - q3 * g.z);
    var d1: f64 = 0.5 * (q0 * g.x + q2 * g.z - q3 * g.y);
    var d2: f64 = 0.5 * (q0 * g.y - q1 * g.z + q3 * g.x);
    var d3: f64 = 0.5 * (q0 * g.z + q1 * g.y - q2 * g.x);
    if imu_norm3(a) > 0.0 {
        val an: vec3 = imu_unit3(a);
        // f_g and its Jacobian (eq. 25-26)
        val fg0: f64 = 2.0 * (q1 * q3 - q0 * q2) - an.x;
        val fg1: f64 = 2.0 * (q0 * q1 + q2 * q3) - an.y;
        val fg2: f64 = 2.0 * (0.5 - q1 * q1 - q2 * q2) - an.z;
        var s0: f64 = 0.0 - 2.0 * q2 * fg0 + 2.0 * q1 * fg1;
        var s1: f64 = 2.0 * q3 * fg0 + 2.0 * q0 * fg1 - 4.0 * q1 * fg2;
        var s2: f64 = 0.0 - 2.0 * q0 * fg0 + 2.0 * q3 * fg1 - 4.0 * q2 * fg2;
        var s3: f64 = 2.0 * q1 * fg0 + 2.0 * q2 * fg1;
        if imu_norm3(m) > 0.0 {
            val mn: vec3 = imu_unit3(m);
            // the measured field in the earth frame, then b = (|h_xy|, 0, h_z)
            val h: vec3 = qt_rotate(f.q, mn);
            val bx: f64 = math_sqrt(h.x * h.x + h.y * h.y);
            val bz: f64 = h.z;
            // f_b and its Jacobian (eq. 29-30)
            val fb0: f64 = 2.0 * bx * (0.5 - q2 * q2 - q3 * q3) + 2.0 * bz * (q1 * q3 - q0 * q2) - mn.x;
            val fb1: f64 = 2.0 * bx * (q1 * q2 - q0 * q3) + 2.0 * bz * (q0 * q1 + q2 * q3) - mn.y;
            val fb2: f64 = 2.0 * bx * (q0 * q2 + q1 * q3) + 2.0 * bz * (0.5 - q1 * q1 - q2 * q2) - mn.z;
            s0 = s0 + (0.0 - 2.0 * bz * q2) * fb0 + (0.0 - 2.0 * bx * q3 + 2.0 * bz * q1) * fb1 + (2.0 * bx * q2) * fb2;
            s1 = s1 + (2.0 * bz * q3) * fb0 + (2.0 * bx * q2 + 2.0 * bz * q0) * fb1 + (2.0 * bx * q3 - 4.0 * bz * q1) * fb2;
            s2 = s2 + (0.0 - 4.0 * bx * q2 - 2.0 * bz * q0) * fb0 + (2.0 * bx * q1 + 2.0 * bz * q3) * fb1 + (2.0 * bx * q0 - 4.0 * bz * q2) * fb2;
            s3 = s3 + (0.0 - 4.0 * bx * q3 + 2.0 * bz * q1) * fb0 + (0.0 - 2.0 * bx * q0 + 2.0 * bz * q2) * fb1 + (2.0 * bx * q1) * fb2;
        }
        val sn: f64 = math_sqrt(s0 * s0 + s1 * s1 + s2 * s2 + s3 * s3);
        if sn > 0.0 {
            d0 = d0 - f.beta * s0 / sn;
            d1 = d1 - f.beta * s1 / sn;
            d2 = d2 - f.beta * s2 / sn;
            d3 = d3 - f.beta * s3 / sn;
        }
    }
    f.q = qt_normalize(quat(q0 + d0 * dt, q1 + d1 * dt, q2 + d2 * dt, q3 + d3 * dt));
}

// ─── Mahony ───

pub struct Mahony {
    pub q: quat,
    pub kp: f64,
    pub ki: f64,
    // integral of the error (rad/s), the gyro bias estimate with sign flipped
    pub ix: f64,
    pub iy: f64,
    pub iz: f64,
}

pub fn mahony_new(kp: f64, ki: f64) -> Mahony {
    return Mahony { q: qt_identity(), kp: kp, ki: ki, ix: 0.0, iy: 0.0, iz: 0.0 };
}

pub fn mahony_update_imu(f: & mut Mahony, g: vec3, a: vec3, dt: f64) {
    mahony_update(f, g, a, vec3(0.0, 0.0, 0.0), dt);
}

/// One update; zero accel skips the correction, zero mag uses 6 axes.
pub fn mahony_update(f: & mut Mahony, gin: vec3, a: vec3, m: vec3, dt: f64) {
    val q0: f64 = f.q.w;
    val q1: f64 = f.q.x;
    val q2: f64 = f.q.y;
    val q3: f64 = f.q.z;
    var gx: f64 = gin.x;
    var gy: f64 = gin.y;
    var gz: f64 = gin.z;
    if imu_norm3(a) > 0.0 {
        val an: vec3 = imu_unit3(a);
        // half the estimated gravity direction
        val vx: f64 = q1 * q3 - q0 * q2;
        val vy: f64 = q0 * q1 + q2 * q3;
        val vz: f64 = q0 * q0 - 0.5 + q3 * q3;
        var ex: f64 = an.y * vz - an.z * vy;
        var ey: f64 = an.z * vx - an.x * vz;
        var ez: f64 = an.x * vy - an.y * vx;
        if imu_norm3(m) > 0.0 {
            val mn: vec3 = imu_unit3(m);
            val h: vec3 = qt_rotate(f.q, mn);
            val bx: f64 = math_sqrt(h.x * h.x + h.y * h.y);
            val bz: f64 = h.z;
            // half the estimated field direction in the body frame
            val wx: f64 = bx * (0.5 - q2 * q2 - q3 * q3) + bz * (q1 * q3 - q0 * q2);
            val wy: f64 = bx * (q1 * q2 - q0 * q3) + bz * (q0 * q1 + q2 * q3);
            val wz: f64 = bx * (q0 * q2 + q1 * q3) + bz * (0.5 - q1 * q1 - q2 * q2);
            ex = ex + (mn.y * wz - mn.z * wy);
            ey = ey + (mn.z * wx - mn.x * wz);
            ez = ez + (mn.x * wy - mn.y * wx);
        }
        if f.ki > 0.0 {
            f.ix = f.ix + 2.0 * f.ki * ex * dt;
            f.iy = f.iy + 2.0 * f.ki * ey * dt;
            f.iz = f.iz + 2.0 * f.ki * ez * dt;
            gx = gx + f.ix;
            gy = gy + f.iy;
            gz = gz + f.iz;
        } else {
            f.ix = 0.0;
            f.iy = 0.0;
            f.iz = 0.0;
        }
        gx = gx + 2.0 * f.kp * ex;
        gy = gy + 2.0 * f.kp * ey;
        gz = gz + 2.0 * f.kp * ez;
    }
    f.q = imu_gyro_step(f.q, vec3(gx, gy, gz), dt);
}

// ─── Gyro bias at rest ───

pub struct GyroBias {
    // a sample is "at rest" when |gyro| < gyro_thresh and ||a| - g| < acc_tol
    pub gyro_thresh: f64,
    pub acc_tol: f64,
    pub g: f64,
    // samples of rest needed before the estimate is taken
    pub needed: i64,
    pub n: i64,
    pub sx: f64,
    pub sy: f64,
    pub sz: f64,
    pub bias: vec3,
    pub valid: bool,
}

pub fn gyro_bias_new(gyro_thresh: f64, acc_tol: f64, g: f64, needed: i64) -> GyroBias {
    return GyroBias { gyro_thresh: gyro_thresh, acc_tol: acc_tol, g: g, needed: needed, n: 0, sx: 0.0, sy: 0.0, sz: 0.0, bias: vec3(0.0, 0.0, 0.0), valid: false };
}

/// Feed a sample; motion restarts the run. Returns true when a new bias
/// estimate (the mean of the last `needed` resting samples) was taken.
pub fn gyro_bias_feed(b: & mut GyroBias, gyro: vec3, acc: vec3) -> bool {
    val still: bool = imu_norm3(gyro) < b.gyro_thresh && math_fabs(imu_norm3(acc) - b.g) < b.acc_tol;
    if !still {
        b.n = 0;
        b.sx = 0.0;
        b.sy = 0.0;
        b.sz = 0.0;
        return false;
    }
    b.n = b.n + 1;
    b.sx = b.sx + gyro.x;
    b.sy = b.sy + gyro.y;
    b.sz = b.sz + gyro.z;
    if b.n >= b.needed {
        val k: f64 = b.n as f64;
        b.bias = vec3(b.sx / k, b.sy / k, b.sz / k);
        b.valid = true;
        b.n = 0;
        b.sx = 0.0;
        b.sy = 0.0;
        b.sz = 0.0;
        return true;
    }
    return false;
}

/// A gyro sample with the bias removed.
pub fn gyro_bias_apply(b: & GyroBias, gyro: vec3) -> vec3 {
    return vec3(gyro.x - b.bias.x, gyro.y - b.bias.y, gyro.z - b.bias.z);
}

// ─── Accelerometer and magnetometer calibration ───

/// Per-axis offset and scale: corrected = (raw - offset) * scale.
pub struct AxisCal {
    pub offset: vec3,
    pub scale: vec3,
}

pub fn axiscal_identity() -> AxisCal {
    return AxisCal { offset: vec3(0.0, 0.0, 0.0), scale: vec3(1.0, 1.0, 1.0) };
}

pub fn axiscal_apply(c: & AxisCal, raw: vec3) -> vec3 {
    return vec3((raw.x - c.offset.x) * c.scale.x, (raw.y - c.offset.y) * c.scale.y, (raw.z - c.offset.z) * c.scale.z);
}

/// Accelerometer calibration from the readings with each axis pointing up
/// (`up`) and down (`down`): up.x is the x reading with +x up, and so on.
/// offset = (up + down) / 2, scale = 2 g / (up - down).
pub fn accel_cal_from_6(up: vec3, down: vec3, g: f64) -> AxisCal {
    return AxisCal { offset: vec3((up.x + down.x) / 2.0, (up.y + down.y) / 2.0, (up.z + down.z) / 2.0), scale: vec3(2.0 * g / (up.x - down.x), 2.0 * g / (up.y - down.y), 2.0 * g / (up.z - down.z)) };
}

/// Running min/max of magnetometer samples while the sensor is turned.
pub struct MagMinMax {
    pub lo: vec3,
    pub hi: vec3,
    pub n: i64,
}

pub fn mag_minmax_new() -> MagMinMax {
    return MagMinMax { lo: vec3(1.0e300, 1.0e300, 1.0e300), hi: vec3(- 1.0e300, - 1.0e300, - 1.0e300), n: 0 };
}

pub fn mag_minmax_feed(mm: & mut MagMinMax, m: vec3) {
    mm.lo = vec3(rmath_min(mm.lo.x, m.x), rmath_min(mm.lo.y, m.y), rmath_min(mm.lo.z, m.z));
    mm.hi = vec3(rmath_max(mm.hi.x, m.x), rmath_max(mm.hi.y, m.y), rmath_max(mm.hi.z, m.z));
    mm.n = mm.n + 1;
}

/// Hard iron offset = centre of the box; soft iron (axis aligned) scale =
/// mean radius / axis radius, so the corrected samples lie on a sphere of
/// the mean radius.
pub fn mag_cal(mm: & MagMinMax) -> AxisCal {
    val rx: f64 = (mm.hi.x - mm.lo.x) / 2.0;
    val ry: f64 = (mm.hi.y - mm.lo.y) / 2.0;
    val rz: f64 = (mm.hi.z - mm.lo.z) / 2.0;
    val avg: f64 = (rx + ry + rz) / 3.0;
    return AxisCal { offset: vec3((mm.hi.x + mm.lo.x) / 2.0, (mm.hi.y + mm.lo.y) / 2.0, (mm.hi.z + mm.lo.z) / 2.0), scale: vec3(avg / rx, avg / ry, avg / rz) };
}

/// Tilt-compensated heading (radians from magnetic north, positive
/// counter-clockwise about up) of a body-frame field at orientation q
/// whose roll and pitch are trusted.
pub fn mag_heading(q: quat, m: vec3) -> f64 {
    val e: EulerZYX = qt_to_euler_zyx(q);
    // level the measurement with roll and pitch only
    val lev: quat = qt_from_euler_zyx(e.roll, e.pitch, 0.0);
    val h: vec3 = qt_rotate(lev, m);
    return rmath_atan2(0.0 - h.y, h.x);
}

// ─── Gravity removal ───

/// Linear acceleration in the earth frame: q a q* - (0, 0, g).
pub fn imu_linear_accel_earth(q: quat, acc: vec3, g: f64) -> vec3 {
    val e: vec3 = qt_rotate(q, acc);
    return vec3(e.x, e.y, e.z - g);
}

/// Linear acceleration in the body frame: a - g * (gravity direction).
pub fn imu_linear_accel_body(q: quat, acc: vec3, g: f64) -> vec3 {
    val gb: vec3 = imu_gravity_body(q);
    return vec3(acc.x - g * gb.x, acc.y - g * gb.y, acc.z - g * gb.z);
}

/// Roll and pitch from one accelerometer sample (no gyro): a quaternion
/// with yaw 0.
pub fn imu_tilt_from_accel(a: vec3) -> quat {
    val roll: f64 = rmath_atan2(a.y, a.z);
    val pitch: f64 = rmath_atan2(0.0 - a.x, math_sqrt(a.y * a.y + a.z * a.z));
    return qt_from_euler_zyx(roll, pitch, 0.0);
}
