// Fides Allocator standard library — Phase 10A
//
// Wraps the raw p_malloc/p_free builtins with nicer names.
// These are the building blocks for stdlib collections (Vec, HashMap, etc.)
//
// All functions return raw i64 pointers. Use unsafe { } to dereference them
// (when raw pointer support is added).

module alloc;
/// Allocate `size` bytes on the heap. Returns a raw pointer (i64).
/// The memory is uninitialized. Returns 0 on failure.
pub fn __alloc(size: i64) -> i64 {
    // SAFETY: p_malloc only allocates: it reads no memory of the caller's,
    // and the fresh block's address is handed back as a plain i64.
    unsafe {
        return p_malloc(size);
    }
}

/// Free a previously allocated pointer.
/// Passing 0 (null) is a no-op.
pub fn __free(ptr: i64) -> void {
    // SAFETY: NOT checked here. p_free is sound only when ptr is 0 or an
    // address __alloc/__alloc_bytes/__alloc_array returned that has not
    // been freed and is not used afterwards; this function cannot verify
    // that, so the caller must uphold it (its contract is unsafe).
    unsafe {
        p_free(ptr);
    }
}

/// Allocate `size` bytes (alias for __alloc).
pub fn __alloc_bytes(size: i64) -> i64 {
    // SAFETY: p_malloc only allocates a fresh block and returns its address
    // as a plain i64; nothing is read or written through it here.
    unsafe {
        return p_malloc(size);
    }
}

/// Allocate `count` elements of `elem_size` bytes each.
/// Total allocation = count * elem_size. Returns a raw pointer.
///
/// Example:
///   var p = __alloc_array(4, 8);
///   assert(p != 0);
///   __free(p);
///   var q = __alloc(16);
///   assert(q != 0);
///   __free(q);
pub fn __alloc_array(count: i64, elem_size: i64) -> i64 {
    // SAFETY: p_malloc only allocates a fresh block of count * elem_size
    // bytes and returns its address as a plain i64; nothing is accessed
    // through it here (an overflowing product only asks for a wrong size).
    unsafe {
        return p_malloc(count * elem_size);
    }
}
