// Fides Allocator standard library — Phase 10A
//
// Wraps the raw p_malloc/p_free builtins with nicer names.
// These are the building blocks for stdlib collections (Vec, HashMap, etc.)
//
// All functions return raw i64 pointers. Use unsafe { } to dereference them
// (when raw pointer support is added).

module alloc;

/// Allocate `size` bytes on the heap. Returns a raw pointer (i64).
/// The memory is uninitialized. Returns 0 on failure.
pub pf __alloc(size: i64) -> i64 {
    ret p_malloc(size);
}

/// Free a previously allocated pointer.
/// Passing 0 (null) is a no-op.
pub pf __free(ptr: i64) -> void {
    p_free(ptr);
}

/// Allocate `size` bytes (alias for __alloc).
pub pf __alloc_bytes(size: i64) -> i64 {
    ret p_malloc(size);
}

/// Allocate `count` elements of `elem_size` bytes each.
/// Total allocation = count * elem_size. Returns a raw pointer.
pub pf __alloc_array(count: i64, elem_size: i64) -> i64 {
    ret p_malloc(count * elem_size);
}
