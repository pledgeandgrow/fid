// ─── The function table layout ─────────────────────────────────────────

var jni_names: Vec<str> = Vec::new();

fn jni_types10() -> Vec<str> {
    var t: Vec<str> = Vec::new();
    t.push("Object");
    t.push("Boolean");
    t.push("Byte");
    t.push("Char");
    t.push("Short");
    t.push("Int");
    t.push("Long");
    t.push("Float");
    t.push("Double");
    t.push("Void");
    return t;
}

fn jni_add(n: str) {
    jni_names.push(n);
}

// Call<prefix><T>Method, ...V, ...A for the 10 kinds
fn jni_add_calls(prefix: str) {
    val t: Vec<str> = jni_types10();
    var i: i64 = 0;
    while i < 10 {
        val m: str = "Call" + prefix + t.get(i) + "Method";
        jni_add(m);
        jni_add(m + "V");
        jni_add(m + "A");
        i = i + 1;
    }
}

// <pre><T><post> for the 9 non-void kinds
fn jni_add_fields(pre: str, post: str) {
    val t: Vec<str> = jni_types10();
    var i: i64 = 0;
    while i < 9 {
        jni_add(pre + t.get(i) + post);
        i = i + 1;
    }
}

// <pre><P><post> for the 8 primitive kinds
fn jni_add_prims(pre: str, post: str) {
    val t: Vec<str> = jni_types10();
    var i: i64 = 1;
    while i < 9 {
        jni_add(pre + t.get(i) + post);
        i = i + 1;
    }
}

fn jni_init_names() {
    if jni_names.len() > 0 {
        return;
    }
    jni_add("reserved0");
    jni_add("reserved1");
    jni_add("reserved2");
    jni_add("reserved3");
    jni_add("GetVersion");
    jni_add("DefineClass");
    jni_add("FindClass");
    jni_add("FromReflectedMethod");
    jni_add("FromReflectedField");
    jni_add("ToReflectedMethod");
    jni_add("GetSuperclass");
    jni_add("IsAssignableFrom");
    jni_add("ToReflectedField");
    jni_add("Throw");
    jni_add("ThrowNew");
    jni_add("ExceptionOccurred");
    jni_add("ExceptionDescribe");
    jni_add("ExceptionClear");
    jni_add("FatalError");
    jni_add("PushLocalFrame");
    jni_add("PopLocalFrame");
    jni_add("NewGlobalRef");
    jni_add("DeleteGlobalRef");
    jni_add("DeleteLocalRef");
    jni_add("IsSameObject");
    jni_add("NewLocalRef");
    jni_add("EnsureLocalCapacity");
    jni_add("AllocObject");
    jni_add("NewObject");
    jni_add("NewObjectV");
    jni_add("NewObjectA");
    jni_add("GetObjectClass");
    jni_add("IsInstanceOf");
    jni_add("GetMethodID");
    jni_add_calls("");
    jni_add_calls("Nonvirtual");
    jni_add("GetFieldID");
    jni_add_fields("Get", "Field");
    jni_add_fields("Set", "Field");
    jni_add("GetStaticMethodID");
    jni_add_calls("Static");
    jni_add("GetStaticFieldID");
    jni_add_fields("GetStatic", "Field");
    jni_add_fields("SetStatic", "Field");
    jni_add("NewString");
    jni_add("GetStringLength");
    jni_add("GetStringChars");
    jni_add("ReleaseStringChars");
    jni_add("NewStringUTF");
    jni_add("GetStringUTFLength");
    jni_add("GetStringUTFChars");
    jni_add("ReleaseStringUTFChars");
    jni_add("GetArrayLength");
    jni_add("NewObjectArray");
    jni_add("GetObjectArrayElement");
    jni_add("SetObjectArrayElement");
    jni_add_prims("New", "Array");
    jni_add_prims("Get", "ArrayElements");
    jni_add_prims("Release", "ArrayElements");
    jni_add_prims("Get", "ArrayRegion");
    jni_add_prims("Set", "ArrayRegion");
    jni_add("RegisterNatives");
    jni_add("UnregisterNatives");
    jni_add("MonitorEnter");
    jni_add("MonitorExit");
    jni_add("GetJavaVM");
    jni_add("GetStringRegion");
    jni_add("GetStringUTFRegion");
    jni_add("GetPrimitiveArrayCritical");
    jni_add("ReleasePrimitiveArrayCritical");
    jni_add("GetStringCritical");
    jni_add("ReleaseStringCritical");
    jni_add("NewWeakGlobalRef");
    jni_add("DeleteWeakGlobalRef");
    jni_add("ExceptionCheck");
    jni_add("NewDirectByteBuffer");
    jni_add("GetDirectBufferAddress");
    jni_add("GetDirectBufferCapacity");
    jni_add("GetObjectRefType");
    jni_add("GetModule");
    jni_add("IsVirtualThread");
}

/// Number of slots in the JNIEnv table (235 for JNI 21).
pub fn jni_table_len() -> i64 {
    jni_init_names();
    return jni_names.len();
}

/// The jni.h name of slot `index` ("" when out of range).
pub fn jni_fn_name(index: i64) -> str {
    jni_init_names();
    if index < 0 || index >= jni_names.len() {
        return "";
    }
    return jni_names.get(index);
}

/// The slot of a JNIEnv function by its jni.h name, -1 if unknown.
pub fn jni_fn_index(name: str) -> i64 {
    jni_init_names();
    var i: i64 = 0;
    while i < jni_names.len() {
        if jni_names.get(i) == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Byte offset of slot `index` in the table on a 64-bit ABI.
pub fn jni_fn_offset(index: i64) -> i64 {
    return index * 8;
}

/// The JavaVM (JNIInvokeInterface_) name of slot `index`.
pub fn jni_vm_fn_name(index: i64) -> str {
    if index >= 0 && index <= 2 {
        return "reserved" + int_to_str(index);
    }
    if index == 3 {
        return "DestroyJavaVM";
    }
    if index == 4 {
        return "AttachCurrentThread";
    }
    if index == 5 {
        return "DetachCurrentThread";
    }
    if index == 6 {
        return "GetEnv";
    }
    if index == 7 {
        return "AttachCurrentThreadAsDaemon";
    }
    return "";
}

/// Read slot `index` of a real JNIEnv*: the table pointer is the first
/// word at `env`, the function pointer the index-th word of the table.
pub fn jni_read_table_entry(env: i64, index: i64) -> i64 {
    var r: i64 = 0;
    // SAFETY: env is a JNIEnv* the VM gave this thread; the table has
    // JNI_TABLE_LEN pointer-sized slots (checked by the caller's index).
    unsafe {
        val pe: *mut i64 = env;
        val table: i64 = *pe;
        val ps: *mut i64 = table + index * 8;
        r = *ps;
    }
    return r;
}

// ─── Type descriptors and signatures ───────────────────────────────────

/// Descriptor of a Java type name: "int" -> "I", "java.lang.String" ->
/// "Ljava/lang/String;", "byte[][]" -> "[[B". A name that is already a
/// descriptor of an array or class ("[I", "Lx;") is returned as it is.
pub fn jni_type_descriptor(java_type: str) -> str {
    var t: str = str_trim(java_type);
    var dims: str = "";
    while str_ends_with(t, "[]") {
        dims = dims + "[";
        t = str_slice(t, 0, str_len(t) - 2);
    }
    var d: str = "";
    if t == "int" {
        d = "I";
    } else if t == "boolean" {
        d = "Z";
    } else if t == "byte" {
        d = "B";
    } else if t == "char" {
        d = "C";
    } else if t == "short" {
        d = "S";
    } else if t == "long" {
        d = "J";
    } else if t == "float" {
        d = "F";
    } else if t == "double" {
        d = "D";
    } else if t == "void" {
        d = "V";
    } else if str_starts_with(t, "[") || (str_starts_with(t, "L") && str_ends_with(t, ";")) {
        d = t;
    } else {
        d = "L" + str_replace(t, ".", "/") + ";";
    }
    return dims + d;
}

/// Method signature from Java type names: (["int", "java.lang.String"],
/// "void") -> "(ILjava/lang/String;)V".
pub fn jni_method_sig(params: Vec<str>, ret: str) -> str {
    var s: str = "(";
    var i: i64 = 0;
    while i < params.len() {
        s = s + jni_type_descriptor(params.get(i));
        i = i + 1;
    }
    return s + ")" + jni_type_descriptor(ret);
}

/// A parsed method signature.
pub struct JniSig {
    pub ok: bool,
    pub error: str,
    pub args: Vec<str>,
    pub ret: str,
}

// End of the field descriptor starting at i, or -1 when malformed.
fn jni_desc_end(s: str, i: i64, allow_void: bool) -> i64 {
    val n: i64 = str_len(s);
    var j: i64 = i;
    while j < n && str_byte_at(s, j) == 91 {
        j = j + 1;
    }  // '['
    if j - i > 255 || j >= n {
        return -1;
    }
    val c: i64 = str_byte_at(s, j);
    if c == 86 {  // 'V'
        if allow_void && j == i {
            return j + 1;
        }
        return -1;
    }
    if c == 90 || c == 66 || c == 67 || c == 83 || c == 73 || c == 74 || c == 70 || c == 68 {
        return j + 1;
    }
    if c == 76 {  // 'L' class name ';'
        var k: i64 = j + 1;
        while k < n && str_byte_at(s, k) != 59 {
            val ck: i64 = str_byte_at(s, k);
            if ck == 46 || ck == 91 || ck == 40 || ck == 41 {
                return -1;
            }
            k = k + 1;
        }
        if k >= n || k == j + 1 {
            return -1;
        }
        return k + 1;
    }
    return -1;
}

fn jni_sig_err(msg: str) -> JniSig {
    return JniSig {
        ok: false, error: msg, args: Vec::new(), ret: ""
    };
}

/// Parse "(args)ret": every argument descriptor and the return type.
pub fn jni_parse_sig(sig: str) -> JniSig {
    val n: i64 = str_len(sig);
    if n < 3 || str_byte_at(sig, 0) != 40 {
        return jni_sig_err("signature must start with (");
    }
    var args: Vec<str> = Vec::new();
    var i: i64 = 1;
    while i < n && str_byte_at(sig, i) != 41 {
        val e: i64 = jni_desc_end(sig, i, false);
        if e < 0 {
            return jni_sig_err("bad argument at " + int_to_str(i));
        }
        args.push(str_slice(sig, i, e));
        i = e;
    }
    if i >= n {
        return jni_sig_err("missing )");
    }
    i = i + 1;
    val e2: i64 = jni_desc_end(sig, i, true);
    if e2 < 0 {
        return jni_sig_err("bad return type");
    }
    if e2 != n {
        return jni_sig_err("trailing characters");
    }
    return JniSig {
        ok: true, error: "", args: args, ret: str_slice(sig, i, n)
    };
}

/// Is `d` one valid field descriptor (no void)?
pub fn jni_valid_field_desc(d: str) -> bool {
    return str_len(d) > 0 && jni_desc_end(d, 0, false) == str_len(d);
}

/// The kind of a descriptor (JNI_KIND_*): arrays and classes are objects.
pub fn jni_desc_kind(d: str) -> i64 {
    if str_len(d) == 0 {
        return JNI_KIND_VOID;
    }
    val c: i64 = str_byte_at(d, 0);
    if c == 90 {
        return JNI_KIND_BOOLEAN;
    }
    if c == 66 {
        return JNI_KIND_BYTE;
    }
    if c == 67 {
        return JNI_KIND_CHAR;
    }
    if c == 83 {
        return JNI_KIND_SHORT;
    }
    if c == 73 {
        return JNI_KIND_INT;
    }
    if c == 74 {
        return JNI_KIND_LONG;
    }
    if c == 70 {
        return JNI_KIND_FLOAT;
    }
    if c == 68 {
        return JNI_KIND_DOUBLE;
    }
    if c == 86 {
        return JNI_KIND_VOID;
    }
    return JNI_KIND_OBJECT;
}

/// Call style for jni_call_slot.
pub const JNI_CALL_VIRTUAL: i64 = 0;
pub const JNI_CALL_NONVIRTUAL: i64 = 1;
pub const JNI_CALL_STATIC: i64 = 2;

/// The slot of Call[Nonvirtual|Static]<Kind>MethodA for a return kind.
pub fn jni_call_slot(style: i64, kind: i64) -> i64 {
    var base: i64 = 34;
    if style == JNI_CALL_NONVIRTUAL {
        base = 64;
    }
    if style == JNI_CALL_STATIC {
        base = 114;
    }
    return base + kind * 3 + 2;
}

/// Slot of Get<Kind>Field / GetStatic<Kind>Field (static: true).
pub fn jni_get_field_slot(is_static: bool, kind: i64) -> i64 {
    if is_static {
        return 145 + kind;
    }
    return 95 + kind;
}

/// Slot of Set<Kind>Field / SetStatic<Kind>Field.
pub fn jni_set_field_slot(is_static: bool, kind: i64) -> i64 {
    if is_static {
        return 154 + kind;
    }
    return 104 + kind;
}

// ─── Native method name mangling ───────────────────────────────────────

fn jni_hex4(c: i64) -> str {
    val h: str = "0123456789abcdef";
    var s: str = "";
    var sh: i64 = 12;
    while sh >= 0 {
        s = s + str_slice(h, (c >> sh) & 15, ((c >> sh) & 15) + 1);
        sh = sh - 4;
    }
    return s;
}

/// Mangle a name per the JNI spec: '/' or '.' -> '_', '_' -> "_1",
/// ';' -> "_2", '[' -> "_3", any non-alphanumeric ASCII or non-ASCII
/// UTF-16 unit -> "_0xxxx".
pub fn jni_mangle(name: str) -> str {
    val units: Vec<i64> = jni_utf16_units(name);
    var out: str = "";
    var i: i64 = 0;
    while i < units.len() {
        val c: i64 = units.get(i);
        if c == 47 || c == 46 {
            out = out + "_";
        } else if c == 95 {
            out = out + "_1";
        } else if c == 59 {
            out = out + "_2";
        } else if c == 91 {
            out = out + "_3";
        } else if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) {
            out = out + char_to_str(c);
        } else {
            out = out + "_0" + jni_hex4(c);
        }
        i = i + 1;
    }
    return out;
}

/// The C symbol the VM looks up for a native method: "Java_" + mangled
/// class + "_" + mangled method; with `sig` non-empty (an overloaded
/// native) "__" + the mangled argument descriptors follows.
pub fn jni_native_symbol(class_name: str, method: str, sig: str) -> str {
    var s: str = "Java_" + jni_mangle(class_name) + "_" + jni_mangle(method);
    if str_len(sig) > 0 {
        val p: JniSig = jni_parse_sig(sig);
        var a: str = "";
        var i: i64 = 0;
        while i < p.args.len() {
            a = a + p.args.get(i);
            i = i + 1;
        }
        s = s + "__" + jni_mangle(a);
    }
    return s;
}

// ─── Modified UTF-8 and UTF-16 ─────────────────────────────────────────

/// UTF-16 code units of a (standard UTF-8) Fides string.
pub fn jni_utf16_units(s: str) -> Vec<i64> {
    val cps: Vec<i64> = utf8_decode(s);
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < cps.len() {
        val c: i64 = cps.get(i);
        if c >= 0x10000 {
            val v: i64 = c - 0x10000;
            out.push(0xD800 + (v >> 10));
            out.push(0xDC00 + (v & 0x3FF));
        } else {
            out.push(c);
        }
        i = i + 1;
    }
    return out;
}

/// Code points of UTF-16 units (an unpaired surrogate is kept as is).
pub fn jni_utf16_to_codepoints(units: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < units.len() {
        val u: i64 = units.get(i);
        if u >= 0xD800 && u <= 0xDBFF && i + 1 < units.len() {
            val l: i64 = units.get(i + 1);
            if l >= 0xDC00 && l <= 0xDFFF {
                out.push(0x10000 + ((u - 0xD800) << 10) + (l - 0xDC00));
                i = i + 2;
            } else {
                out.push(u);
                i = i + 1;
            }
        } else {
            out.push(u);
            i = i + 1;
        }
    }
    return out;
}

/// A Fides string from UTF-16 units (what GetStringChars returns).
pub fn jni_utf16_to_str(units: Vec<i64>) -> str {
    return utf8_encode_all(jni_utf16_to_codepoints(units));
}

/// Modified UTF-8 bytes of a string (no terminating NUL).
pub fn jni_mutf8_encode(s: str) -> Vec<i64> {
    val units: Vec<i64> = jni_utf16_units(s);
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < units.len() {
        val c: i64 = units.get(i);
        if c >= 1 && c <= 0x7F {
            out.push(c);
        } else if c <= 0x7FF {
            out.push(0xC0 | (c >> 6));
            out.push(0x80 | (c & 0x3F));
        } else {
            out.push(0xE0 | (c >> 12));
            out.push(0x80 | ((c >> 6) & 0x3F));
            out.push(0x80 | (c & 0x3F));
        }
        i = i + 1;
    }
    return out;
}

/// Decoded modified UTF-8: `ok` false on a malformed byte sequence
/// (including a raw NUL or a 4-byte form, which modified UTF-8 never has).
pub struct JniDecoded {
    pub ok: bool,
    pub text: str,
    pub units: Vec<i64>,
}

/// Decode modified UTF-8 bytes into UTF-16 units and a Fides string.
pub fn jni_mutf8_decode(b: Vec<i64>) -> JniDecoded {
    var units: Vec<i64> = Vec::new();
    var i: i64 = 0;
    val n: i64 = b.len();
    while i < n {
        val c: i64 = b.get(i) & 255;
        if c >= 1 && c <= 0x7F {
            units.push(c);
            i = i + 1;
        } else if (c & 0xE0) == 0xC0 && i + 1 < n && (b.get(i + 1) & 0xC0) == 0x80 {
            units.push(((c & 0x1F) << 6) | (b.get(i + 1) & 0x3F));
            i = i + 2;
        } else if (c & 0xF0) == 0xE0 && i + 2 < n && (b.get(i + 1) & 0xC0) == 0x80 && (b.get(i + 2) & 0xC0) == 0x80 {
            units.push(((c & 0x0F) << 12) | ((b.get(i + 1) & 0x3F) << 6) | (b.get(i + 2) & 0x3F));
            i = i + 3;
        } else {
            return JniDecoded {
                ok: false, text: "", units: Vec::new()
            };
        }
    }
    return JniDecoded {
        ok: true, text: jni_utf16_to_str(units), units: units
    };
}

/// Copy bytes into a new NUL-terminated C buffer (p_malloc); the caller
/// frees it with jni_cbuf_free once the VM call returned.
pub fn jni_cbuf(bytes: Vec<i64>) -> i64 {
    val n: i64 = bytes.len();
    var buf: i64 = 0;
    // SAFETY: buf has n + 1 bytes; each write is inside it.
    unsafe {
        buf = p_malloc(n + 1);
        var i: i64 = 0;
        while i < n {
            val p: *mut u8 = buf + i;
            *p = bytes.get(i) & 255;
            i = i + 1;
        }
        val pz: *mut u8 = buf + n;
        *pz = 0;
    }
    return buf;
}

/// Bytes of a NUL-terminated C buffer (what GetStringUTFChars returns).
pub fn jni_cbuf_read(addr: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if addr == 0 {
        return out;
    }
    // SAFETY: addr is a NUL-terminated buffer (the VM's or jni_cbuf's).
    unsafe {
        var i: i64 = 0;
        loop {
            val p: *mut u8 = addr + i;
            val c: i64 = *p;
            if c == 0 {
                break;
            }
            out.push(c);
            i = i + 1;
        }
    }
    return out;
}

/// Free a buffer of jni_cbuf.
pub fn jni_cbuf_free(addr: i64) {
    // SAFETY: addr came from jni_cbuf (p_malloc) and is freed once.
    unsafe {
        p_free(addr);
    }
}

// ─── jvalue words ──────────────────────────────────────────────────────

/// An argument of a Call*MethodA call (a jvalue union member).
pub enum JValue {
    Z(bool),
    B(i64),
    C(i64),
    S(i64),
    I(i64),
    J(i64),
    F(f64),
    D(f64),
    L(i64),
}

/// IEEE 754 single-precision bits of x, rounded to nearest even
/// (what a jfloat holds).
pub fn jni_f32_bits(x: f64) -> i64 {
    val b: i64 = p_f64_to_bits(x);
    val sign: i64 = (b >> 63) & 1;
    val e: i64 = (b >> 52) & 0x7FF;
    val m: i64 = b & 0xFFFFFFFFFFFFF;
    val s: i64 = sign << 31;
    if e == 0x7FF {
        if m != 0 {
            return s | 0x7FC00000;
        }
        return s | 0x7F800000;
    }
    if e == 0 && m == 0 {
        return s;
    }
    var ue: i64 = e - 1023 + 127;
    // full significand with the hidden bit: 53 bits
    var sig: i64 = m | (1 << 52);
    if e == 0 {
        sig = m;
        ue = -126 + 127;
    }
    var shift: i64 = 29;
    if ue <= 0 {
        shift = 29 + (1 - ue);
        ue = 0;
    }
    if shift > 60 {
        return s;
    }
    var q: i64 = sig >> shift;
    val rem: i64 = sig & ((1 << shift) - 1);
    val half: i64 = 1 << (shift - 1);
    if rem > half || (rem == half && (q & 1) == 1) {
        q = q + 1;
    }
    // q holds 24 bits (normal) or fewer (subnormal); a carry may bump it
    if ue == 0 {
        // subnormal result: q < 2^23 unless rounding reached the normal range
        return s | q;
    }
    if q >= (1 << 24) {
        q = q >> 1;
        ue = ue + 1;
    }
    if ue >= 255 {
        return s | 0x7F800000;
    }
    return s | (ue << 23) | (q & 0x7FFFFF);
}

/// The 64-bit word of a jvalue holding `v` (little-endian union: the
/// member sits in the low bytes).
pub fn jni_jvalue_word(v: JValue) -> i64 {
    return match v {
        JValue::Z(b) => if b {
            1
        } else {
            0
        }, JValue::B(x) => x & 0xFF, JValue::C(x) => x & 0xFFFF, JValue::S(x) => x & 0xFFFF, JValue::I(x) => x & 0xFFFFFFFF, JValue::J(x) => x, JValue::F(f) => jni_f32_bits(f), JValue::D(d) => p_f64_to_bits(d), JValue::L(o) => o,
    };
}

/// jvalue words of an argument list.
pub fn jni_jvalue_words(args: Vec<JValue>) -> Vec<i64> {
    var w: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < args.len() {
        w.push(jni_jvalue_word(args.get(i)));
        i = i + 1;
    }
    return w;
}

/// A jvalue array in C memory (8 bytes per argument); free it with
/// jni_cbuf_free. 0 for no arguments.
pub fn jni_jvalue_array(args: Vec<JValue>) -> i64 {
    val w: Vec<i64> = jni_jvalue_words(args);
    if w.len() == 0 {
        return 0;
    }
    var buf: i64 = 0;
    // SAFETY: buf has 8 * len bytes; each write is one word inside it.
    unsafe {
        buf = p_malloc(w.len() * 8);
        var i: i64 = 0;
        while i < w.len() {
            val p: *mut i64 = buf + i * 8;
            *p = w.get(i);
            i = i + 1;
        }
    }
    return buf;
}

// ─── The environment and the call sequences ────────────────────────────

/// A JNIEnv* with the seam that reaches it (see the header).
pub struct JniEnv {
    pub env: i64,
    pub entry: fn(i64, i64) -> i64,
    pub call: fn(i64, Vec<i64>) -> i64,
    pub calls: i64,  // VM calls made through this env
    pub local_refs: i64,  // local references this code created and holds
    pub global_refs: i64,  // global references created and not deleted
    pub frames: i64,  // local frames pushed and not popped
}

pub fn jni_env(env: i64, entry: fn(i64, i64) -> i64, call: fn(i64, Vec<i64>) -> i64) -> JniEnv {
    return JniEnv {
        env: env, entry: entry, call: call, calls: 0, local_refs: 0, global_refs: 0, frames: 0
    };
}

/// Call slot `index` of the env's table with the arguments after env.
pub fn jni_invoke(e: &mut JniEnv, index: i64, rest: Vec<i64>) -> i64 {
    val entry: fn(i64, i64) -> i64 = e.entry;
    val call: fn(i64, Vec<i64>) -> i64 = e.call;
    val fp: i64 = entry(e.env, index);
    var args: Vec<i64> = Vec::new();
    args.push(e.env);
    var i: i64 = 0;
    while i < rest.len() {
        args.push(rest.get(i));
        i = i + 1;
    }
    e.calls = e.calls + 1;
    return call(fp, args);
}

fn jni_a0() -> Vec<i64> {
    return Vec::new();
}

fn jni_a1(a: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(a);
    return v;
}

fn jni_a2(a: i64, b: i64) -> Vec<i64> {
    var v: Vec<i64> = jni_a1(a);
    v.push(b);
    return v;
}

fn jni_a3(a: i64, b: i64, c: i64) -> Vec<i64> {
    var v: Vec<i64> = jni_a2(a, b);
    v.push(c);
    return v;
}

fn jni_a4(a: i64, b: i64, c: i64, d: i64) -> Vec<i64> {
    var v: Vec<i64> = jni_a3(a, b, c);
    v.push(d);
    return v;
}

// Call with one modified-UTF-8 string argument in a temporary C buffer.
fn jni_invoke_str(e: &mut JniEnv, index: i64, before: Vec<i64>, s: str, after: Vec<i64>) -> i64 {
    val buf: i64 = jni_cbuf(jni_mutf8_encode(s));
    var a: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < before.len() {
        a.push(before.get(i));
        i = i + 1;
    }
    a.push(buf);
    i = 0;
    while i < after.len() {
        a.push(after.get(i));
        i = i + 1;
    }
    val r: i64 = jni_invoke(e, index, a);
    jni_cbuf_free(buf);
    return r;
}

pub fn jni_get_version(e: &mut JniEnv) -> i64 {
    return jni_invoke(e, JNI_FN_GET_VERSION, jni_a0());
}

/// FindClass("java/lang/String"): a local reference or 0.
pub fn jni_find_class(e: &mut JniEnv, name: str) -> i64 {
    val r: i64 = jni_invoke_str(e, JNI_FN_FIND_CLASS, jni_a0(), str_replace(name, ".", "/"), jni_a0());
    if r != 0 {
        e.local_refs = e.local_refs + 1;
    }
    return r;
}

// GetMethodID / GetStaticMethodID / GetFieldID with two string arguments.
fn jni_invoke_2str(e: &mut JniEnv, index: i64, cls: i64, name: str, sig: str) -> i64 {
    val b1: i64 = jni_cbuf(jni_mutf8_encode(name));
    val b2: i64 = jni_cbuf(jni_mutf8_encode(sig));
    val r: i64 = jni_invoke(e, index, jni_a3(cls, b1, b2));
    jni_cbuf_free(b1);
    jni_cbuf_free(b2);
    return r;
}

pub fn jni_get_method_id(e: &mut JniEnv, cls: i64, name: str, sig: str) -> i64 {
    return jni_invoke_2str(e, JNI_FN_GET_METHOD_ID, cls, name, sig);
}

pub fn jni_get_static_method_id(e: &mut JniEnv, cls: i64, name: str, sig: str) -> i64 {
    return jni_invoke_2str(e, JNI_FN_GET_STATIC_METHOD_ID, cls, name, sig);
}

pub fn jni_get_field_id(e: &mut JniEnv, cls: i64, name: str, sig: str) -> i64 {
    return jni_invoke_2str(e, JNI_FN_GET_FIELD_ID, cls, name, sig);
}

/// Call a method through its Call<Kind>MethodA slot: `target` is the
/// object (virtual) or the class (static); the return kind comes from the
/// signature. The result is the raw return word (a reference, an integer,
/// or float bits; 0 for void).
pub fn jni_call_method(e: &mut JniEnv, style: i64, target: i64, mid: i64, sig: str, args: Vec<JValue>) -> i64 {
    val p: JniSig = jni_parse_sig(sig);
    if !p.ok || p.args.len() != args.len() {
        return 0;
    }
    val kind: i64 = jni_desc_kind(p.ret);
    val jv: i64 = jni_jvalue_array(args);
    val r: i64 = jni_invoke(e, jni_call_slot(style, kind), jni_a3(target, mid, jv));
    if jv != 0 {
        jni_cbuf_free(jv);
    }
    if kind == JNI_KIND_OBJECT && r != 0 {
        e.local_refs = e.local_refs + 1;
    }
    return r;
}

/// NewStringUTF of a Fides string (converted to modified UTF-8).
pub fn jni_new_string(e: &mut JniEnv, s: str) -> i64 {
    val r: i64 = jni_invoke_str(e, JNI_FN_NEW_STRING_UTF, jni_a0(), s, jni_a0());
    if r != 0 {
        e.local_refs = e.local_refs + 1;
    }
    return r;
}

/// A jstring's text: GetStringUTFChars, decode, ReleaseStringUTFChars.
pub fn jni_string_to_str(e: &mut JniEnv, jstr: i64) -> str {
    if jstr == 0 {
        return "";
    }
    val chars: i64 = jni_invoke(e, JNI_FN_GET_STRING_UTF_CHARS, jni_a2(jstr, 0));
    if chars == 0 {
        return "";
    }
    val d: JniDecoded = jni_mutf8_decode(jni_cbuf_read(chars));
    jni_invoke(e, JNI_FN_RELEASE_STRING_UTF_CHARS, jni_a2(jstr, chars));
    return d.text;
}

/// The exception check pattern after every call that may throw: when an
/// exception is pending, describe it (stderr / logcat) and clear it, so
/// the next JNI call is legal. True when there was one.
pub fn jni_exception_pending(e: &mut JniEnv) -> bool {
    val pending: i64 = jni_invoke(e, JNI_FN_EXCEPTION_CHECK, jni_a0());
    if pending == 0 {
        return false;
    }
    jni_invoke(e, JNI_FN_EXCEPTION_DESCRIBE, jni_a0());
    jni_invoke(e, JNI_FN_EXCEPTION_CLEAR, jni_a0());
    return true;
}

/// Throw a new exception of class `cls_name` with a message.
pub fn jni_throw_new(e: &mut JniEnv, cls_name: str, msg: str) -> i64 {
    val cls: i64 = jni_find_class(e, cls_name);
    if cls == 0 {
        return JNI_ERR;
    }
    val r: i64 = jni_invoke_str(e, JNI_FN_THROW_NEW, jni_a1(cls), msg, jni_a0());
    jni_delete_local_ref(e, cls);
    return r;
}

pub fn jni_new_global_ref(e: &mut JniEnv, obj: i64) -> i64 {
    val r: i64 = jni_invoke(e, JNI_FN_NEW_GLOBAL_REF, jni_a1(obj));
    if r != 0 {
        e.global_refs = e.global_refs + 1;
    }
    return r;
}

pub fn jni_delete_global_ref(e: &mut JniEnv, g: i64) {
    if g == 0 {
        return;
    }
    jni_invoke(e, JNI_FN_DELETE_GLOBAL_REF, jni_a1(g));
    e.global_refs = e.global_refs - 1;
}

pub fn jni_delete_local_ref(e: &mut JniEnv, l: i64) {
    if l == 0 {
        return;
    }
    jni_invoke(e, JNI_FN_DELETE_LOCAL_REF, jni_a1(l));
    e.local_refs = e.local_refs - 1;
}

/// PushLocalFrame(capacity): JNI_OK or an error code.
pub fn jni_push_local_frame(e: &mut JniEnv, capacity: i64) -> i64 {
    val r: i64 = jni_invoke(e, JNI_FN_PUSH_LOCAL_FRAME, jni_a1(capacity));
    if r == JNI_OK {
        e.frames = e.frames + 1;
    }
    return r;
}

/// PopLocalFrame(result): frees the frame's local references and returns
/// `result` as a reference in the outer frame.
pub fn jni_pop_local_frame(e: &mut JniEnv, result: i64) -> i64 {
    val r: i64 = jni_invoke(e, JNI_FN_POP_LOCAL_FRAME, jni_a1(result));
    e.frames = e.frames - 1;
    return r;
}

/// Does the env still hold references or frames this code created?
pub fn jni_leak_report(e: &JniEnv) -> str {
    return "locals=" + int_to_str(e.local_refs) + " globals=" + int_to_str(e.global_refs) + " frames=" + int_to_str(e.frames);
}
