// Fides JNI (Java Native Interface) bridge
//
// What is real (pure Fides, runs and is tested in the interpreter):
//   - the JNIEnv function table layout of jni.h (JNINativeInterface_):
//     the name of every slot 0..234 and its byte offset, built the same
//     way the header lists them (the Call<Type>Method/V/A families, the
//     Get/Set<Type>Field families, the primitive array families), plus
//     the JavaVM invoke table (JNIInvokeInterface_)
//   - type descriptors: Java type names to descriptors ("int[]" -> "[I",
//     "java.lang.String" -> "Ljava/lang/String;"), method signatures
//     built from parts, and a validating signature parser
//     ("(ILjava/lang/String;[J)V" -> args I, Ljava/lang/String;, [J; ret V)
//   - which Call*MethodA slot a return type uses (virtual, nonvirtual,
//     static), jvalue words for the A variants (jfloat as IEEE single bits)
//   - native method name mangling (JNI spec "Resolving Native Method
//     Names": _1 _2 _3 _0xxxx escapes, overloads with __<args>)
//   - modified UTF-8 (JNI spec "Modified UTF-8 Strings": NUL as C0 80,
//     supplementary characters as two 3-byte surrogates) encode and
//     decode, and UTF-16 code units for GetStringChars/NewString
//   - the call sequences: FindClass, GetMethodID, Call<T>MethodA, the
//     exception check pattern (ExceptionCheck, ExceptionDescribe,
//     ExceptionClear), local frames, global/local reference bookkeeping
//
// The platform seam: a JNIEnv* points at a table of C function pointers,
// and Fides cannot call a C function pointer with several arguments. The
// struct `JniEnv` therefore carries two function values:
//   entry(env, index) -> the function pointer in slot `index` (on a device
//                        `jni_read_table_entry`, which reads (*env)[index])
//   call(fnptr, args) -> calls fnptr with args (env first); on a device a
//                        small C trampoline of the app, in tests a fake VM
// The JNI invocation API (JNI_CreateJavaVM, JNI_GetCreatedJavaVMs,
// JNI_GetDefaultJavaVMInitArgs: libnativehelper on Android 31+, libjvm on
// desktop) is declared below; the interpreter cannot call it.
//
// Usage:
//   use jni;
//   var e: JniEnv = jni_env(env_ptr, jni_read_table_entry, my_trampoline);
//   val cls = jni_find_class(&mut e, "android/util/Log");
//   val mid = jni_get_static_method_id(&mut e, cls, "d",
//                 jni_method_sig(["java.lang.String", "java.lang.String"], "int"));
//   if jni_exception_pending(&mut e) { ... }

module jni;
use vec;
use string;
use encoding;

// ─── Invocation API (libnativehelper / libjvm) ─────────────────────────

// SAFETY: prototypes of <jni.h>; pointers are passed as i64 words. The
// interpreter cannot reach them: they are for C builds on a device.
extern "C" {
    fn JNI_GetDefaultJavaVMInitArgs as jni_c_default_init_args(args: i64) -> i64;
    fn JNI_CreateJavaVM as jni_c_create_vm(pvm: i64, penv: i64, args: i64) -> i64;
    fn JNI_GetCreatedJavaVMs as jni_c_created_vms(vms: i64, len: i64, n: i64) -> i64;
}

// ─── Constants of jni.h ────────────────────────────────────────────────

pub const JNI_VERSION_1_6: i64 = 0x00010006;
pub const JNI_VERSION_1_8: i64 = 0x00010008;
pub const JNI_VERSION_9: i64 = 0x00090000;
pub const JNI_VERSION_10: i64 = 0x000a0000;
