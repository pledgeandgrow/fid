// Fides File I/O standard library
//
// Provides file read/write/append/exists operations.
// Used for batch processing — reading ACH files, writing settlement reports.
//
// In the interpreter, these use the host OS filesystem.
// In native builds, these use Linux syscalls (open/read/write/close).

module file;

/// Read the entire contents of a file as a string.
/// Returns empty string if the file doesn't exist or can't be read.
pub pf file_read(path: str) -> str {
    pv content = p_file_read(path);
    if content == 0 {
        ret "";
    }
    ret content;
}

/// Write content to a file (overwrites existing content).
/// Returns 0 on success, -1 on error.
pub pf file_write(path: str, content: str) -> i64 {
    ret p_file_write(path, content);
}

/// Append content to a file (creates if it doesn't exist).
/// Returns 0 on success, -1 on error.
pub pf file_append(path: str, content: str) -> i64 {
    ret p_file_append(path, content);
}

/// Check if a file exists.
pub pf file_exists(path: str) -> bool {
    ret p_file_exists(path);
}

// ═══════════════════════════════════════════════════════════════════════
// Binary file IO — needed for emitting executables during self-hosting.
// ═══════════════════════════════════════════════════════════════════════

/// Write raw bytes to a file (binary mode). The bytes are provided as a Vec
/// of byte values (0-255). Returns 0 on success, -1 on error.
pub pf file_write_bytes(path: str, bytes: Vec) -> i64 {
    // Build a string from the byte vec — p_file_write handles binary content
    // since it uses fopen("wb") on the C backend.
    pv content: str = str_from_bytes(bytes);
    ret p_file_write(path, content);
}

/// Read a file as a Vec of byte values. Returns an empty Vec if the file
/// doesn't exist or can't be read.
pub pf file_read_bytes(path: str) -> Vec {
    pv content = p_file_read(path);
    if content == 0 {
        ret Vec::new();
    }
    ret str_bytes(content);
}

/// Write a raw string to a file in binary mode (no newline translation).
/// On the C backend this uses fopen("wb"). On the interpreter it uses
/// std::fs::write which is already binary-safe.
pub pf file_write_raw(path: str, content: str) -> i64 {
    ret p_file_write(path, content);
}

/// Delete a file. Returns 0 on success, -1 on error.
pub pf file_delete(path: str) -> i64 {
    ret p_file_delete(path);
}

/// Get the size of a file in bytes, or -1 if it doesn't exist.
pub pf file_size(path: str) -> i64 {
    ret p_file_size(path);
}
