// ─── DIN messages: encode, decode, read ──────────────────────────────────

/// EXI of a V2G_Message with this SessionID and body.
pub fn din_encode(s: & ExiSchema, session_id: & Vec<i64>, body: & Vec<ExiEvent>) -> ExiResult {
    var evs: Vec<ExiEvent> = Vec::new();
    evs.push(exi_se(DIN_MSG_DEF, "V2G_Message"));
    evs.push(exi_se(DIN_MSG_DEF, "Header"));
    var sid: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < session_id.len() {
        sid.push(session_id.get(i));
        i = i + 1;
    }
    exi_push_leaf(& mut evs, DIN_MSG_HEADER, "SessionID", exi_ch_bin(sid));
    evs.push(exi_ee());
    evs.push(exi_se(DIN_MSG_DEF, "Body"));
    i = 0;
    while i < body.len() {
        evs.push(body.get(i));
        i = i + 1;
    }
    evs.push(exi_ee());
    evs.push(exi_ee());
    return exi_encode(s, & exi_options(), & evs);
}

/// A decoded DIN message: the body element's name, the SessionID, the
/// ResponseCode (name and index; "" and -1 for a request) and all events.
pub struct DinMessage {
    pub ok: bool,
    pub error: str,
    pub name: str,
    pub session_id: Vec<i64>,
    pub response_code: str,
    pub code_index: i64,
    pub events: Vec<ExiEvent>,
}

pub fn din_decode(s: & ExiSchema, b: Vec<i64>) -> DinMessage {
    val d: ExiDoc = exi_decode(s, & exi_options(), b);
    var m: DinMessage = DinMessage { ok: d.ok, error: d.error, name: "", session_id: Vec::new(), response_code: "", code_index: - 1, events: d.events };
    if !d.ok {
        return m;
    }
    m.session_id = exi_get(& m.events, "V2G_Message/Header/SessionID").bval;
    val bi: i64 = exi_find(& m.events, "V2G_Message/Body");
    if bi >= 0 && bi + 1 < m.events.len() && m.events.get(bi + 1).kind == EXI_SE {
        m.name = m.events.get(bi + 1).name;
    }
    val rc: str = "V2G_Message/Body/" + m.name + "/ResponseCode";
    if exi_has(& m.events, rc) {
        val v: ExiEvent = exi_get(& m.events, rc);
        m.response_code = v.sval;
        m.code_index = v.ival;
    }
    return m;
}

/// The value of a field of the message, by its path below the body
/// element ("DC_EVSEStatus/EVSEStatusCode").
pub fn din_field(m: & DinMessage, rel: str) -> ExiEvent {
    return exi_get(& m.events, "V2G_Message/Body/" + m.name + "/" + rel);
}

pub fn din_has(m: & DinMessage, rel: str) -> bool {
    return exi_has(& m.events, "V2G_Message/Body/" + m.name + "/" + rel);
}

pub fn din_pv_at(m: & DinMessage, rel: str) -> DinPV {
    if !din_has(m, rel) {
        return din_pv_none();
    }
    var unit: str = "";
    if din_has(m, rel + "/Unit") {
        unit = din_field(m, rel + "/Unit").sval;
    }
    return din_pv(din_field(m, rel + "/Multiplier").ival, unit, din_field(m, rel + "/Value").ival);
}

pub fn din_ev_status_at(m: & DinMessage, rel: str) -> DinEVStatus {
    var st: DinEVStatus = din_ev_status(din_field(m, rel + "/EVReady").ival != 0, din_field(m, rel + "/EVErrorCode").sval, din_field(m, rel + "/EVRESSSOC").ival);
    if din_has(m, rel + "/EVCabinConditioning") {
        st.cabin = din_field(m, rel + "/EVCabinConditioning").ival;
    }
    if din_has(m, rel + "/EVRESSConditioning") {
        st.ress = din_field(m, rel + "/EVRESSConditioning").ival;
    }
    return st;
}

pub fn din_evse_status_at(m: & DinMessage, rel: str) -> DinEVSEStatus {
    var iso: str = "";
    if din_has(m, rel + "/EVSEIsolationStatus") {
        iso = din_field(m, rel + "/EVSEIsolationStatus").sval;
    }
    var st: DinEVSEStatus = din_evse_status(iso, din_field(m, rel + "/EVSEStatusCode").sval);
    st.max_delay = din_field(m, rel + "/NotificationMaxDelay").ival;
    st.notification = din_field(m, rel + "/EVSENotification").sval;
    return st;
}

// ─── Message-sequence state machine ──────────────────────────────────────

// states of the DIN profile (with V2G_APP_PROTOCOL .. V2G_DONE above)
pub const V2G_CONTRACT_AUTH: i64 = 10;
pub const V2G_CABLE_CHECK: i64 = 11;
pub const V2G_PRE_CHARGE: i64 = 12;
pub const V2G_WELDING: i64 = 13;

/// A V2G session's sequencing state with the expected next message and a
/// per-state deadline (the caller supplies the clock in ticks).
pub struct V2gSession {
    pub state: i64,
    pub din: bool,              // DIN 70121 profile (else ISO 15118-2)
    pub order: Vec<i64>,        // the states in sequence
    pub pos: i64,
    pub session: Vec<i64>,      // SessionID (DIN profile)
    pub schema_id: i64,
    pub failed: bool,
    pub error: str,
    pub current_demand_rounds: i64,
    pub repeats: i64,           // repetitions of the current state
    pub deadline: i64,          // tick by which the expected response must arrive
    pub timeout: i64,           // per-message timeout (ticks)
    pub precharge_target_mv: i64,
    pub precharge_tolerance_mv: i64,
    pub welding_limit_mv: i64,
}

fn v2g_new(timeout: i64, din: bool) -> V2gSession {
    var s: V2gSession = V2gSession {
        state: V2G_APP_PROTOCOL, din: din, order: Vec::new(), pos: 0, session: Vec::new(), schema_id: - 1, failed: false, error: "",
        current_demand_rounds: 0, repeats: 0, deadline: 0, timeout: timeout,
        precharge_target_mv: 0, precharge_tolerance_mv: 20000, welding_limit_mv: 20000,
    };
    s.order.push(V2G_APP_PROTOCOL);
    s.order.push(V2G_SESSION_SETUP);
    s.order.push(V2G_SERVICE_DISCOVERY);
    s.order.push(V2G_PAYMENT_SELECT);
    if din {
        s.order.push(V2G_CONTRACT_AUTH);
    }
    s.order.push(V2G_CHARGE_PARAM);
    if din {
        s.order.push(V2G_CABLE_CHECK);
        s.order.push(V2G_PRE_CHARGE);
    }
    s.order.push(V2G_POWER_DELIVERY_START);
    s.order.push(V2G_CURRENT_DEMAND);
    s.order.push(V2G_POWER_DELIVERY_STOP);
    if din {
        s.order.push(V2G_WELDING);
    }
    s.order.push(V2G_SESSION_STOP);
    s.order.push(V2G_DONE);
    return s;
}

/// An ISO 15118-2 session (messages through the caller's codec).
pub fn iso15118_session_new(timeout: i64) -> V2gSession {
    return v2g_new(timeout, false);
}

/// A DIN 70121 DC session (messages through this module's EXI codec).
pub fn iso15118_din_session_new(timeout: i64) -> V2gSession {
    return v2g_new(timeout, true);
}

fn v2g_state_base(s: & V2gSession) -> str {
    val st: i64 = s.state;
    if st == V2G_SESSION_SETUP { return "SessionSetup"; }
    if st == V2G_SERVICE_DISCOVERY { return "ServiceDiscovery"; }
    if st == V2G_PAYMENT_SELECT {
        if s.din {
            return "ServicePaymentSelection";
        }
        return "PaymentServiceSelection";
    }
    if st == V2G_CONTRACT_AUTH { return "ContractAuthentication"; }
    if st == V2G_CHARGE_PARAM { return "ChargeParameterDiscovery"; }
    if st == V2G_CABLE_CHECK { return "CableCheck"; }
    if st == V2G_PRE_CHARGE { return "PreCharge"; }
    if st == V2G_POWER_DELIVERY_START || st == V2G_POWER_DELIVERY_STOP { return "PowerDelivery"; }
    if st == V2G_CURRENT_DEMAND { return "CurrentDemand"; }
    if st == V2G_WELDING { return "WeldingDetection"; }
    if st == V2G_SESSION_STOP { return "SessionStop"; }
    return "";
}

/// The request message name expected in the current state.
pub fn v2g_expected_request(s: & V2gSession) -> str {
    if s.state == V2G_APP_PROTOCOL { return "supportedAppProtocolReq"; }
    if s.state == V2G_DONE { return ""; }
    return v2g_state_base(s) + "Req";
}

/// The response message name expected in the current state.
pub fn v2g_expected_response(s: & V2gSession) -> str {
    if s.state == V2G_APP_PROTOCOL { return "supportedAppProtocolRes"; }
    if s.state == V2G_DONE { return ""; }
    return v2g_state_base(s) + "Res";
}

/// Mark that the request for the current state was sent at `tick`; sets the
/// response deadline.
pub fn v2g_on_send(s: & mut V2gSession, tick: i64) {
    s.deadline = tick + s.timeout;
}

fn v2g_fail(s: & mut V2gSession, why: str) {
    if !s.failed {
        s.failed = true;
        s.error = why;
    }
}

/// Feed a received response of message `name` with `response_code` at
/// `tick`. `repeat` keeps the session in its state (the request is sent
/// again: EVSEProcessing Ongoing, pre-charge not done). CurrentDemand
/// repeats until v2g_request_stop. A wrong name, a failed response code
/// or a late response fails the session. Returns the new state.
pub fn v2g_step_repeat(s: & mut V2gSession, name: str, response_code: i64, tick: i64, repeat: bool) -> i64 {
    if s.failed || s.state == V2G_DONE {
        return s.state;
    }
    if tick > s.deadline && s.deadline > 0 {
        v2g_fail(s, "response timeout");
        return s.state;
    }
    if !str_equal(name, v2g_expected_response(s)) {
        v2g_fail(s, "expected " + v2g_expected_response(s) + ", got " + name);
        return s.state;
    }
    if response_code >= V2G_FAILED {
        v2g_fail(s, name + " failed");
        return s.state;
    }
    if s.state == V2G_CURRENT_DEMAND {
        s.current_demand_rounds = s.current_demand_rounds + 1;
        return s.state;
    }
    if repeat {
        s.repeats = s.repeats + 1;
        return s.state;
    }
    s.pos = s.pos + 1;
    s.state = s.order.get(s.pos);
    s.repeats = 0;
    return s.state;
}

/// v2g_step_repeat without repeating (ISO 15118-2 seam: the caller decoded
/// the message with its own codec).
pub fn v2g_step(s: & mut V2gSession, name: str, response_code: i64, tick: i64) -> i64 {
    return v2g_step_repeat(s, name, response_code, tick, false);
}

/// Leave the CurrentDemand loop and move to the stop PowerDelivery.
pub fn v2g_request_stop(s: & mut V2gSession) {
    if s.state == V2G_CURRENT_DEMAND {
        s.pos = s.pos + 1;
        s.state = s.order.get(s.pos);
    }
}

/// The grammar tables a DIN session needs.
pub struct V2gCodecs {
    pub app: ExiSchema,
    pub din: ExiSchema,
}

pub fn iso15118_codecs() -> V2gCodecs {
    return V2gCodecs { app: iso15118_app_schema(), din: iso15118_din_schema() };
}

/// EV side, DIN profile: encode the request `body` (the handshake's
/// events in the first state, else a DIN body from din_*_req) with the
/// session's SessionID, frame it as V2GTP and start the response timer.
/// Empty (and the session failed) if it is not the expected request or
/// does not encode.
pub fn v2g_din_send(s: & mut V2gSession, k: & V2gCodecs, body: & Vec<ExiEvent>, tick: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if s.failed {
        return out;
    }
    if body.len() == 0 || body.get(0).name != v2g_expected_request(s) {
        v2g_fail(s, "not the expected request " + v2g_expected_request(s));
        return out;
    }
    var r: ExiResult = exi_encode(& k.app, & exi_options(), body);
    if s.state != V2G_APP_PROTOCOL {
        r = din_encode(& k.din, & s.session, body);
    }
    if !r.ok {
        v2g_fail(s, "encode: " + r.error);
        return out;
    }
    v2g_on_send(s, tick);
    return iso15118_v2gtp(V2GTP_EXI, & r.bytes);
}

/// EV side, DIN profile: take a V2GTP packet with the EVSE's response,
/// decode it and advance the session: the SessionID of SessionSetupRes is
/// kept and every later response must carry it; FAILED* codes fail the
/// session; EVSEProcessing Ongoing repeats ContractAuthentication,
/// ChargeParameterDiscovery and CableCheck; PreCharge repeats until the
/// EVSE's present voltage is within precharge_tolerance_mv of
/// precharge_target_mv, WeldingDetection until it is at most
/// welding_limit_mv. Returns the decoded message.
pub fn v2g_din_receive(s: & mut V2gSession, k: & V2gCodecs, packet: & Vec<i64>, tick: i64) -> DinMessage {
    var m: DinMessage = DinMessage { ok: false, error: "", name: "", session_id: Vec::new(), response_code: "", code_index: - 1, events: Vec::new() };
    val p: V2gtpPacket = iso15118_v2gtp_parse(packet);
    if !p.ok || p.payload_type != V2GTP_EXI {
        m.error = "not a V2GTP EXI packet";
        v2g_fail(s, m.error);
        return m;
    }
    if s.state == V2G_APP_PROTOCOL {
        val r: AppProtocolRes = iso15118_app_protocol_res_parse(& p.payload);
        m.ok = r.ok;
        if !r.ok {
            m.error = "not a supportedAppProtocolRes";
            v2g_fail(s, m.error);
            return m;
        }
        m.name = "supportedAppProtocolRes";
        m.code_index = r.response_code;
        s.schema_id = r.schema_id;
        var code: i64 = r.response_code;
        if code == APP_FAILED {
            code = V2G_FAILED;
        }
        v2g_step_repeat(s, m.name, code, tick, false);
        return m;
    }
    m = din_decode(& k.din, p.payload);
    if !m.ok {
        v2g_fail(s, "decode: " + m.error);
        return m;
    }
    if s.state == V2G_SESSION_SETUP {
        s.session = m.session_id;
    } else if hex_of(& m.session_id) != hex_of(& s.session) {
        v2g_fail(s, "SessionID mismatch");
        return m;
    }
    var code: i64 = m.code_index;
    if code >= 4 {
        code = V2G_FAILED;   // FAILED and FAILED_*
    }
    var repeat: bool = false;
    val st: i64 = s.state;
    if st == V2G_CONTRACT_AUTH || st == V2G_CHARGE_PARAM || st == V2G_CABLE_CHECK {
        repeat = din_field(& m, "EVSEProcessing").sval == "Ongoing";
    }
    if st == V2G_PRE_CHARGE {
        var d: i64 = din_pv_milli(& din_pv_at(& m, "EVSEPresentVoltage")) - s.precharge_target_mv;
        if d < 0 {
            d = 0 - d;
        }
        repeat = d > s.precharge_tolerance_mv;
    }
    if st == V2G_WELDING {
        repeat = din_pv_milli(& din_pv_at(& m, "EVSEPresentVoltage")) > s.welding_limit_mv;
    }
    v2g_step_repeat(s, m.name, code, tick, repeat);
    return m;
}

fn hex_of(b: & Vec<i64>) -> str {
    val digits: str = "0123456789abcdef";
    var out: str = "";
    var i: i64 = 0;
    while i < b.len() {
        val v: i64 = b.get(i) & 255;
        out = out + str_slice(digits, v >> 4, (v >> 4) + 1) + str_slice(digits, v & 15, (v & 15) + 1);
        i = i + 1;
    }
    return out;
}

/// A copy of bytes behind a reference.
pub fn v2g_bytes(b: & Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < b.len() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}
