/// CurrentDemandReq; bulk_complete -1: absent.
pub struct DinCurrentDemand {
    pub status: DinEVStatus,
    pub target_current: DinPV,
    pub max_voltage: DinPV,
    pub max_current: DinPV,
    pub max_power: DinPV,
    pub bulk_complete: i64,
    pub charging_complete: bool,
    pub remaining_full: DinPV,
    pub remaining_bulk: DinPV,
    pub target_voltage: DinPV,
}

pub fn din_current_demand(status: DinEVStatus, target_current: DinPV, target_voltage: DinPV) -> DinCurrentDemand {
    return DinCurrentDemand {
        status: status, target_current: target_current, max_voltage: din_pv_none(), max_current: din_pv_none(), max_power: din_pv_none(),
        bulk_complete: - 1, charging_complete: false, remaining_full: din_pv_none(), remaining_bulk: din_pv_none(), target_voltage: target_voltage,
    };
}

pub fn din_current_demand_req(q: & DinCurrentDemand) -> Vec<ExiEvent> {
    val b: str = DIN_MSG_BODY;
    var e: Vec<ExiEvent> = din_body("CurrentDemandReq");
    din_push_ev_status(& mut e, b, & q.status);
    din_push_pv(& mut e, b, "EVTargetCurrent", & q.target_current);
    din_push_pv(& mut e, b, "EVMaximumVoltageLimit", & q.max_voltage);
    din_push_pv(& mut e, b, "EVMaximumCurrentLimit", & q.max_current);
    din_push_pv(& mut e, b, "EVMaximumPowerLimit", & q.max_power);
    if q.bulk_complete >= 0 {
        din_leaf(& mut e, b, "BulkChargingComplete", exi_ch_bool(q.bulk_complete == 1));
    }
    din_leaf(& mut e, b, "ChargingComplete", exi_ch_bool(q.charging_complete));
    din_push_pv(& mut e, b, "RemainingTimeToFullSoC", & q.remaining_full);
    din_push_pv(& mut e, b, "RemainingTimeToBulkSoC", & q.remaining_bulk);
    din_push_pv(& mut e, b, "EVTargetVoltage", & q.target_voltage);
    e.push(exi_ee());
    return e;
}

/// CurrentDemandRes; `limits` are "current|voltage|power" achieved flags
/// as three booleans, the EVSE maxima optional.
pub fn din_current_demand_res(code: str, st: & DinEVSEStatus, voltage: & DinPV, current: & DinPV, current_limit: bool, voltage_limit: bool, power_limit: bool, max_voltage: & DinPV, max_current: & DinPV, max_power: & DinPV) -> Vec<ExiEvent> {
    val b: str = DIN_MSG_BODY;
    var e: Vec<ExiEvent> = din_body("CurrentDemandRes");
    din_code(& mut e, code);
    din_push_evse_status(& mut e, b, st);
    din_push_pv(& mut e, b, "EVSEPresentVoltage", voltage);
    din_push_pv(& mut e, b, "EVSEPresentCurrent", current);
    din_leaf(& mut e, b, "EVSECurrentLimitAchieved", exi_ch_bool(current_limit));
    din_leaf(& mut e, b, "EVSEVoltageLimitAchieved", exi_ch_bool(voltage_limit));
    din_leaf(& mut e, b, "EVSEPowerLimitAchieved", exi_ch_bool(power_limit));
    din_push_pv(& mut e, b, "EVSEMaximumVoltageLimit", max_voltage);
    din_push_pv(& mut e, b, "EVSEMaximumCurrentLimit", max_current);
    din_push_pv(& mut e, b, "EVSEMaximumPowerLimit", max_power);
    e.push(exi_ee());
    return e;
}

