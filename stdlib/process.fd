// Fides Process Control standard library
//
// Provides process control: exit, system commands.
// In the interpreter, these use Rust's std::process.
// In C codegen, these use C's system() and exit().
// In native builds, p_exit works (syscall 60), p_system is a stub.
//
// Usage:
//   use process;
//   process_exit(0);     // exit with code 0
//   value status = process_system("ls -la");

module process;

/// Exit the process with the given exit code.
pub fn process_exit(code: i64) -> void {
    p_exit(code);
}

/// Run a shell command and return the exit status.
/// Returns -1 on failure.
pub fn process_system(cmd: str) -> i64 {
    return p_system(cmd);
}
