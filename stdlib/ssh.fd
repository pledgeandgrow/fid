// Fides SSH 2.0 transport and its first users: the version exchange and
// binary packet protocol (RFC 4253 §4.2, §6), KEXINIT and algorithm
// negotiation (§7.1), curve25519-sha256 key exchange (RFC 8731) with the
// exchange hash and key derivation (RFC 4253 §7.2, §8), "strict KEX"
// (OpenSSH kex-strict-*-v00, the Terrapin countermeasure), ssh-ed25519
// host keys and signatures (RFC 8709), the cipher
// chacha20-poly1305@openssh.com (OpenSSH PROTOCOL.chacha20poly1305),
// NEWKEYS, re-keying, the service request, the user authentication
// messages (RFC 4252: publickey with ssh-ed25519, password; failure,
// success, PK_OK, banner) and the connection messages (RFC 4254: channel
// open/confirmation/failure, window adjust, data, extended data, eof,
// close, requests "exec"/"shell"/"subsystem", success/failure), with
// encoders and parsers for each.
//
// One cipher suite: kex curve25519-sha256 (also @libssh.org), host key
// ssh-ed25519, cipher chacha20-poly1305@openssh.com, compression none.
// A peer that offers nothing in common gets a failed negotiation. The
// first packets (before NEWKEYS) are unencrypted as RFC 4253 requires.
//
// Pure computation over bytes: ssh_feed takes what the socket delivered
// and returns the bytes to write back; the TCP connection is the
// caller's. The transport layer (version, KEXINIT, ECDH, NEWKEYS, IGNORE,
// DEBUG, DISCONNECT, UNIMPLEMENTED) runs inside ssh_feed; every other
// message is queued for the application (ssh_next_message). Randomness
// (KEXINIT cookies, ephemeral keys, packet padding) comes from
// crypto_random_bytes unless set through ssh_set_kex_seed (tests and
// vectors; padding then is zeros). Host key trust is the caller's: the
// client keeps the server's host key blob (s.host_key) and refuses a key
// other than s.trusted_host_key when that is set.
//
// Checked in tests/bootstrap/test_std_ssh.fd: a client and a server talk
// through memory up to an authenticated session channel; the exchange
// hash, the server's signature and the first encrypted packet are
// byte-exact against an independent Node.js computation (OpenSSL
// X25519/Ed25519/ChaCha20, Poly1305 in BigInt).
//
// Usage:
//   use ssh;
//   var c = ssh_client_new("SSH-2.0-Fides_1.0");
//   var s = ssh_server_new("SSH-2.0-FidesD_1.0", host_seed);
//   val out_c = ssh_start(& mut c);                 // version + KEXINIT
//   val reply = ssh_feed(& mut s, out_c);           // ... pump until ssh_ready
//   val pkt = ssh_send(& mut c, ssh_service_request("ssh-userauth"));
//   val m = ssh_next_message(& mut s);              // m.ok, m.payload, m.msg

module ssh;
use vec;
use string;
use encoding;
use crypto;
use x25519;
use ed25519;
use chacha20poly1305;

pub const SSH_MSG_DISCONNECT: i64 = 1;
pub const SSH_MSG_IGNORE: i64 = 2;
pub const SSH_MSG_UNIMPLEMENTED: i64 = 3;
pub const SSH_MSG_DEBUG: i64 = 4;
pub const SSH_MSG_SERVICE_REQUEST: i64 = 5;
pub const SSH_MSG_SERVICE_ACCEPT: i64 = 6;
pub const SSH_MSG_KEXINIT: i64 = 20;
pub const SSH_MSG_NEWKEYS: i64 = 21;
pub const SSH_MSG_KEX_ECDH_INIT: i64 = 30;
pub const SSH_MSG_KEX_ECDH_REPLY: i64 = 31;
pub const SSH_MSG_USERAUTH_REQUEST: i64 = 50;
pub const SSH_MSG_USERAUTH_FAILURE: i64 = 51;
pub const SSH_MSG_USERAUTH_SUCCESS: i64 = 52;
pub const SSH_MSG_USERAUTH_BANNER: i64 = 53;
pub const SSH_MSG_USERAUTH_PK_OK: i64 = 60;
pub const SSH_MSG_GLOBAL_REQUEST: i64 = 80;
pub const SSH_MSG_CHANNEL_OPEN: i64 = 90;
pub const SSH_MSG_CHANNEL_OPEN_CONFIRMATION: i64 = 91;
pub const SSH_MSG_CHANNEL_OPEN_FAILURE: i64 = 92;
pub const SSH_MSG_CHANNEL_WINDOW_ADJUST: i64 = 93;
pub const SSH_MSG_CHANNEL_DATA: i64 = 94;
pub const SSH_MSG_CHANNEL_EXTENDED_DATA: i64 = 95;
pub const SSH_MSG_CHANNEL_EOF: i64 = 96;
pub const SSH_MSG_CHANNEL_CLOSE: i64 = 97;
pub const SSH_MSG_CHANNEL_REQUEST: i64 = 98;
pub const SSH_MSG_CHANNEL_SUCCESS: i64 = 99;
pub const SSH_MSG_CHANNEL_FAILURE: i64 = 100;

pub const SSH_DISCONNECT_PROTOCOL_ERROR: i64 = 2;
pub const SSH_DISCONNECT_KEY_EXCHANGE_FAILED: i64 = 3;
pub const SSH_DISCONNECT_MAC_ERROR: i64 = 5;
pub const SSH_DISCONNECT_HOST_KEY_NOT_VERIFIABLE: i64 = 9;
pub const SSH_DISCONNECT_BY_APPLICATION: i64 = 11;

/// Largest packet accepted (RFC 4253 §6.1 asks for at least 35000).
pub const SSH_MAX_PACKET: i64 = 262144;

// session states
pub const SSH_ST_VERSION: i64 = 0;
pub const SSH_ST_KEX: i64 = 1;
pub const SSH_ST_READY: i64 = 2;
pub const SSH_ST_CLOSED: i64 = 3;

/// A reader over a payload; `ok` turns false on any short read.
pub struct SshReader {
    pub data: Vec<i64>,
    pub pos: i64,
    pub ok: bool,
}

/// One application message from ssh_next_message.
pub struct SshMessage {
    pub ok: bool,
    pub msg: i64,
    pub payload: Vec<i64>,
}

/// What negotiation chose.
pub struct SshAlgs {
    pub ok: bool,
    pub kex: str,
    pub host_key: str,
    pub enc_cs: str,
    pub enc_sc: str,
    pub comp_cs: str,
    pub comp_sc: str,
    pub strict: bool,
}

/// One side of an SSH connection.
pub struct SshSession {
    pub server: bool,
    pub state: i64,
    pub err: str,
    pub ident: str,
    pub peer_ident: str,
    // transport
    pub inbuf: Vec<i64>,
    pub out_key: Vec<i64>,
    pub in_key: Vec<i64>,
    pub out_seq: i64,
    pub in_seq: i64,
    pub pending_out_key: Vec<i64>,
    pub pending_in_key: Vec<i64>,
    pub packets_in: i64,
    // key exchange
    pub my_kexinit: Vec<i64>,
    pub peer_kexinit: Vec<i64>,
    pub algs: SshAlgs,
    pub e_secret: Vec<i64>,
    pub e_pub: Vec<i64>,
    pub host_seed: Vec<i64>,
    pub host_key: Vec<i64>,
    pub trusted_host_key: Vec<i64>,
    pub exchange_hash: Vec<i64>,
    pub session_id: Vec<i64>,
    pub sent_newkeys: bool,
    pub got_newkeys: bool,
    pub kex_count: i64,
    pub seed: Vec<i64>,
    pub seed_ctr: i64,
    // application messages: u32 length || payload, repeated
    pub queue: Vec<i64>,
}

// ─── Wire encoding (RFC 4251 §5) ───────────────────────────────────────

fn ssh_cat(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = a;
    var i: i64 = 0;
    while i < b.len() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}

fn ssh_slice(v: &Vec<i64>, from: i64, to: i64) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    var i: i64 = from;
    while i < to {
        o.push(v.get(i));
        i = i + 1;
    }
    return o;
}

/// Append a byte.
pub fn ssh_put_byte(b: &mut Vec<i64>, v: i64) {
    b.push(v & 255);
}

/// Append a boolean.
pub fn ssh_put_bool(b: &mut Vec<i64>, v: bool) {
    if v {
        b.push(1);
    } else {
        b.push(0);
    }
}

/// Append a uint32 (big-endian).
pub fn ssh_put_u32(b: &mut Vec<i64>, v: i64) {
    b.push((v >> 24) & 255);
    b.push((v >> 16) & 255);
    b.push((v >> 8) & 255);
    b.push(v & 255);
}

/// Append a string (uint32 length || bytes).
pub fn ssh_put_string(b: &mut Vec<i64>, s: Vec<i64>) {
    ssh_put_u32(b, s.len());
    var i: i64 = 0;
    while i < s.len() {
        b.push(s.get(i) & 255);
        i = i + 1;
    }
}

/// Append text as a string.
pub fn ssh_put_text(b: &mut Vec<i64>, s: str) {
    ssh_put_string(b, str_bytes(s));
}

/// The mpint encoding of an unsigned big-endian magnitude.
pub fn ssh_mpint(mag: Vec<i64>) -> Vec<i64> {
    var start: i64 = 0;
    while start < mag.len() && mag.get(start) == 0 {
        start = start + 1;
    }
    var v: Vec<i64> = Vec::new();
    if start < mag.len() && mag.get(start) >= 128 {
        v.push(0);
    }
    v = ssh_cat(v, ssh_slice(&mag, start, mag.len()));
    var out: Vec<i64> = Vec::new();
    ssh_put_string(&mut out, v);
    return out;
}

/// A reader at the start of `data`.
pub fn ssh_reader(data: Vec<i64>) -> SshReader {
    return SshReader {
        data: data, pos: 0, ok: true
    };
}

/// Read a byte (0 and ok false at the end).
pub fn ssh_get_byte(r: &mut SshReader) -> i64 {
    if r.pos >= r.data.len() {
        r.ok = false;
        return 0;
    }
    val v: i64 = r.data.get(r.pos);
    r.pos = r.pos + 1;
    return v;
}

/// Read a boolean (any non-zero byte is true).
pub fn ssh_get_bool(r: &mut SshReader) -> bool {
    return ssh_get_byte(r) != 0;
}

/// Read a uint32.
pub fn ssh_get_u32(r: &mut SshReader) -> i64 {
    if r.pos + 4 > r.data.len() {
        r.ok = false;
        return 0;
    }
    val p: i64 = r.pos;
    r.pos = p + 4;
    return (r.data.get(p) << 24) | (r.data.get(p + 1) << 16) | (r.data.get(p + 2) << 8) | r.data.get(p + 3);
}

/// Read a string's bytes.
pub fn ssh_get_string(r: &mut SshReader) -> Vec<i64> {
    val n: i64 = ssh_get_u32(r);
    if !r.ok || n > r.data.len() - r.pos {
        r.ok = false;
        return Vec::new();
    }
    val p: i64 = r.pos;
    r.pos = p + n;
    return ssh_slice(&r.data, p, p + n);
}

/// Read a string as text.
pub fn ssh_get_text(r: &mut SshReader) -> str {
    return str_from_bytes(ssh_get_string(r));
}

/// Read a name-list.
pub fn ssh_get_namelist(r: &mut SshReader) -> Vec<str> {
    val t: str = ssh_get_text(r);
    if str_len(t) == 0 {
        return Vec::new();
    }
    return str_split(t, ",");
}

/// True when every byte has been read and nothing was short.
pub fn ssh_reader_done(r: &SshReader) -> bool {
    return r.ok && r.pos == r.data.len();
}

// ─── Host keys and signatures (RFC 8709) ───────────────────────────────

/// The ssh-ed25519 public key blob: string "ssh-ed25519" || string key.
pub fn ssh_ed25519_blob(public_key: Vec<i64>) -> Vec<i64> {
    var b: Vec<i64> = Vec::new();
    ssh_put_text(&mut b, "ssh-ed25519");
    ssh_put_string(&mut b, public_key);
    return b;
}

/// The 32-byte key inside an ssh-ed25519 blob, empty if it is not one.
pub fn ssh_ed25519_blob_key(blob: Vec<i64>) -> Vec<i64> {
    var r: SshReader = ssh_reader(blob);
    val alg: str = ssh_get_text(&mut r);
    val k: Vec<i64> = ssh_get_string(&mut r);
    if !ssh_reader_done(&r) || !str_equal(alg, "ssh-ed25519") || k.len() != 32 {
        return Vec::new();
    }
    return k;
}

/// An ssh-ed25519 signature blob over `data` with a 32-byte seed.
pub fn ssh_ed25519_sign(seed: Vec<i64>, data: Vec<i64>) -> Vec<i64> {
    var b: Vec<i64> = Vec::new();
    ssh_put_text(&mut b, "ssh-ed25519");
    ssh_put_string(&mut b, ed25519_sign(seed, data));
    return b;
}

/// Check an ssh-ed25519 signature blob against a public key blob.
pub fn ssh_ed25519_verify(key_blob: Vec<i64>, data: Vec<i64>, sig_blob: Vec<i64>) -> bool {
    val k: Vec<i64> = ssh_ed25519_blob_key(key_blob);
    if k.len() != 32 {
        return false;
    }
    var r: SshReader = ssh_reader(sig_blob);
    val alg: str = ssh_get_text(&mut r);
    val sig: Vec<i64> = ssh_get_string(&mut r);
    if !ssh_reader_done(&r) || !str_equal(alg, "ssh-ed25519") || sig.len() != 64 {
        return false;
    }
    return ed25519_verify(k, data, sig);
}

/// OpenSSH's fingerprint "SHA256:" || base64(SHA-256(blob)) without padding.
pub fn ssh_fingerprint(blob: Vec<i64>) -> str {
    return "SHA256:" + str_replace(b64_encode_bytes(crypto_sha256_bytes(blob)), "=", "");
}

// ─── Sessions ──────────────────────────────────────────────────────────

fn ssh_no_algs() -> SshAlgs {
    return SshAlgs {
        ok: false, kex: "", host_key: "", enc_cs: "", enc_sc: "", comp_cs: "", comp_sc: "", strict: false
    };
}

fn ssh_new(server: bool, ident: str, host_seed: Vec<i64>) -> SshSession {
    var hk: Vec<i64> = Vec::new();
    if host_seed.len() == 32 {
        hk = ssh_ed25519_blob(ed25519_public_key(host_seed));
    }
    return SshSession {
        server: server, state: SSH_ST_VERSION, err: "", ident: ident, peer_ident: "", inbuf: Vec::new(), out_key: Vec::new(), in_key: Vec::new(), out_seq: 0, in_seq: 0, pending_out_key: Vec::new(), pending_in_key: Vec::new(), packets_in: 0, my_kexinit: Vec::new(), peer_kexinit: Vec::new(), algs: ssh_no_algs(), e_secret: Vec::new(), e_pub: Vec::new(), host_seed: host_seed, host_key: hk, trusted_host_key: Vec::new(), exchange_hash: Vec::new(), session_id: Vec::new(), sent_newkeys: false, got_newkeys: false, kex_count: 0, seed: Vec::new(), seed_ctr: 0, queue: Vec::new()
    };
}

/// A client with identification string `ident` ("SSH-2.0-...").
pub fn ssh_client_new(ident: str) -> SshSession {
    return ssh_new(false, ident, Vec::new());
}

/// A server with identification `ident` and an Ed25519 host key seed.
pub fn ssh_server_new(ident: str, host_seed: Vec<i64>) -> SshSession {
    return ssh_new(true, ident, host_seed);
}

/// Seam: derive cookies, ephemeral keys and padding from `seed`
/// (SHA-256 in counter mode) instead of crypto_random_bytes, and pad with
/// zeros. For tests and reproducible vectors only.
pub fn ssh_set_kex_seed(s: &mut SshSession, seed: Vec<i64>) {
    s.seed = seed;
    s.seed_ctr = 0;
}

fn ssh_random(s: &mut SshSession, n: i64) -> Vec<i64> {
    if s.seed.len() == 0 {
        return crypto_random_bytes(n);
    }
    var out: Vec<i64> = Vec::new();
    while out.len() < n {
        var blk: Vec<i64> = s.seed;
        ssh_put_u32(&mut blk, s.seed_ctr);
        s.seed_ctr = s.seed_ctr + 1;
        val d: Vec<i64> = crypto_sha256_bytes(blk);
        var i: i64 = 0;
        while i < d.len() && out.len() < n {
            out.push(d.get(i));
            i = i + 1;
        }
    }
    return out;
}

/// True once the first key exchange is done in both directions.
pub fn ssh_ready(s: &SshSession) -> bool {
    return s.state == SSH_ST_READY;
}

// ─── Binary packet protocol (RFC 4253 §6, PROTOCOL.chacha20poly1305) ───

fn ssh_nonce(seq: i64) -> Vec<i64> {
    var n: Vec<i64> = Vec::new();
    ssh_put_u32(&mut n, 0);
    ssh_put_u32(&mut n, 0);
    ssh_put_u32(&mut n, seq);
    return n;
}

/// Frame and (once keyed) encrypt one payload.
fn ssh_packet(s: &mut SshSession, payload: Vec<i64>) -> Vec<i64> {
    val keyed: bool = s.out_key.len() == 64;
    // the length field is outside the alignment with the AEAD cipher
    var base: i64 = 5 + payload.len();
    if keyed {
        base = 1 + payload.len();
    }
    var pad: i64 = 8 - (base % 8);
    if pad < 4 {
        pad = pad + 8;
    }
    var padding: Vec<i64> = Vec::new();
    if s.seed.len() > 0 {
        var i: i64 = 0;
        while i < pad {
            padding.push(0);
            i = i + 1;
        }
    } else {
        padding = crypto_random_bytes(pad);
    }
    var body: Vec<i64> = Vec::new();
    body.push(pad);
    body = ssh_cat(ssh_cat(body, payload), padding);
    var len: Vec<i64> = Vec::new();
    ssh_put_u32(&mut len, body.len());
    var out: Vec<i64> = Vec::new();
    if keyed {
        val k2: Vec<i64> = ssh_slice(&s.out_key, 0, 32);
        val k1: Vec<i64> = ssh_slice(&s.out_key, 32, 64);
        val nonce: Vec<i64> = ssh_nonce(s.out_seq);
        val elen: Vec<i64> = cc20_xor(k1, nonce, 0, len);
        val ebody: Vec<i64> = cc20_xor(k2, nonce, 1, body);
        val tag: Vec<i64> = poly1305_mac(poly1305_key_gen(k2, nonce), ssh_cat(elen, ebody));
        out = ssh_cat(ssh_cat(elen, ebody), tag);
    } else {
        out = ssh_cat(len, body);
    }
    s.out_seq = (s.out_seq + 1) & 0xffffffff;
    return out;
}

/// The packet bytes carrying one application payload.
pub fn ssh_send(s: &mut SshSession, payload: Vec<i64>) -> Vec<i64> {
    if s.state == SSH_ST_CLOSED {
        return Vec::new();
    }
    return ssh_packet(s, payload);
}

fn ssh_fail(s: &mut SshSession, err: str) {
    if s.state != SSH_ST_CLOSED {
        s.err = err;
        s.state = SSH_ST_CLOSED;
    }
}

/// Take one packet's payload from inbuf: ready false when more bytes are
/// needed, ok false on a framing or MAC error.
fn ssh_take_packet(s: &mut SshSession) -> SshMessage {
    val need_more: SshMessage = SshMessage {
        ok: true, msg: -1, payload: Vec::new()
    };
    val bad: SshMessage = SshMessage {
        ok: false, msg: -1, payload: Vec::new()
    };
    if s.inbuf.len() < 4 {
        return need_more;
    }
    val keyed: bool = s.in_key.len() == 64;
    var lenb: Vec<i64> = ssh_slice(&s.inbuf, 0, 4);
    val nonce: Vec<i64> = ssh_nonce(s.in_seq);
    if keyed {
        lenb = cc20_xor(ssh_slice(&s.in_key, 32, 64), nonce, 0, lenb);
    }
    val plen: i64 = (lenb.get(0) << 24) | (lenb.get(1) << 16) | (lenb.get(2) << 8) | lenb.get(3);
    if plen < 5 || plen > SSH_MAX_PACKET {
        ssh_fail(s, "bad packet length");
        return bad;
    }
    if keyed && plen % 8 != 0 {
        ssh_fail(s, "bad packet length");
        return bad;
    }
    if !keyed && (plen + 4) % 8 != 0 {
        ssh_fail(s, "bad packet length");
        return bad;
    }
    var total: i64 = 4 + plen;
    if keyed {
        total = total + 16;
    }
    if s.inbuf.len() < total {
        return need_more;
    }
    var body: Vec<i64> = ssh_slice(&s.inbuf, 4, 4 + plen);
    if keyed {
        val k2: Vec<i64> = ssh_slice(&s.in_key, 0, 32);
        val tag: Vec<i64> = ssh_slice(&s.inbuf, 4 + plen, total);
        val want: Vec<i64> = poly1305_mac(poly1305_key_gen(k2, nonce), ssh_slice(&s.inbuf, 0, 4 + plen));
        if !aead_ct_eq(&tag, &want) {
            ssh_fail(s, "MAC error");
            return bad;
        }
        body = cc20_xor(k2, nonce, 1, body);
    }
    s.inbuf = ssh_slice(&s.inbuf, total, s.inbuf.len());
    s.in_seq = (s.in_seq + 1) & 0xffffffff;
    s.packets_in = s.packets_in + 1;
    val pad: i64 = body.get(0);
    if pad < 4 || pad > plen - 1 {
        ssh_fail(s, "bad padding");
        return bad;
    }
    val payload: Vec<i64> = ssh_slice(&body, 1, plen - pad);
    if payload.len() == 0 {
        ssh_fail(s, "empty payload");
        return bad;
    }
    return SshMessage {
        ok: true, msg: payload.get(0), payload: payload
    };
}

// ─── Version exchange (RFC 4253 §4.2) ──────────────────────────────────

/// Our identification line with CR LF.
pub fn ssh_version_line(s: &SshSession) -> Vec<i64> {
    return str_bytes(s.ident + "\r\n");
}

/// Consume the peer's identification from inbuf. A server's earlier
/// lines (not starting with "SSH-") are skipped; returns false while the
/// line is incomplete or when it is bad (state CLOSED then).
fn ssh_take_version(s: &mut SshSession) -> bool {
    var start: i64 = 0;
    while true {
        var nl: i64 = -1;
        var i: i64 = start;
        while i < s.inbuf.len() && nl < 0 {
            if s.inbuf.get(i) == 10 {
                nl = i;
            }
            i = i + 1;
        }
        if nl < 0 {
            if s.inbuf.len() - start > 255 {
                ssh_fail(s, "identification line too long");
            }
            return false;
        }
        var end: i64 = nl;
        if end > start && s.inbuf.get(end - 1) == 13 {
            end = end - 1;
        }
        val line: str = str_from_bytes(ssh_slice(&s.inbuf, start, end));
        if str_starts_with(line, "SSH-") {
            if !str_starts_with(line, "SSH-2.0-") && !str_starts_with(line, "SSH-1.99-") {
                ssh_fail(s, "unsupported protocol version");
                return false;
            }
            if nl + 1 - start > 255 {
                ssh_fail(s, "identification line too long");
                return false;
            }
            s.peer_ident = line;
            s.inbuf = ssh_slice(&s.inbuf, nl + 1, s.inbuf.len());
            s.state = SSH_ST_KEX;
            return true;
        }
        if s.server {
            ssh_fail(s, "client sent text before its identification");
            return false;
        }
        start = nl + 1;
    }
    return false;
}

// ─── KEXINIT and negotiation (RFC 4253 §7.1) ───────────────────────────

fn ssh_kexinit_payload(s: &mut SshSession) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_KEXINIT);
    p = ssh_cat(p, ssh_random(s, 16));
    if s.server {
        ssh_put_text(&mut p, "curve25519-sha256,curve25519-sha256@libssh.org,kex-strict-s-v00@openssh.com");
    } else {
        ssh_put_text(&mut p, "curve25519-sha256,curve25519-sha256@libssh.org,kex-strict-c-v00@openssh.com");
    }
    ssh_put_text(&mut p, "ssh-ed25519");
    ssh_put_text(&mut p, "chacha20-poly1305@openssh.com");
    ssh_put_text(&mut p, "chacha20-poly1305@openssh.com");
    ssh_put_text(&mut p, "hmac-sha2-256");
    ssh_put_text(&mut p, "hmac-sha2-256");
    ssh_put_text(&mut p, "none");
    ssh_put_text(&mut p, "none");
    ssh_put_text(&mut p, "");
    ssh_put_text(&mut p, "");
    ssh_put_bool(&mut p, false);
    ssh_put_u32(&mut p, 0);
    return p;
}

fn ssh_has(list: &Vec<str>, name: str) -> bool {
    var i: i64 = 0;
    while i < list.len() {
        if str_equal(list.get(i), name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The first client algorithm the server also supports ("" if none),
/// skipping the strict-KEX markers.
pub fn ssh_choose(client: Vec<str>, server: Vec<str>) -> str {
    var i: i64 = 0;
    while i < client.len() {
        val a: str = client.get(i);
        if !str_starts_with(a, "kex-strict-") && ssh_has(&server, a) {
            return a;
        }
        i = i + 1;
    }
    return "";
}

/// Negotiate from two KEXINIT payloads (client's first).
pub fn ssh_negotiate(ic: Vec<i64>, is: Vec<i64>, first_kex: bool) -> SshAlgs {
    var rc: SshReader = ssh_reader(ic);
    var rs: SshReader = ssh_reader(is);
    if ssh_get_byte(&mut rc) != SSH_MSG_KEXINIT || ssh_get_byte(&mut rs) != SSH_MSG_KEXINIT {
        return ssh_no_algs();
    }
    rc.pos = rc.pos + 16;
    rs.pos = rs.pos + 16;
    var a: SshAlgs = ssh_no_algs();
    val kc: Vec<str> = ssh_get_namelist(&mut rc);
    val ks: Vec<str> = ssh_get_namelist(&mut rs);
    a.kex = ssh_choose(kc, ks);
    a.strict = first_kex && ssh_has(&kc, "kex-strict-c-v00@openssh.com") && ssh_has(&ks, "kex-strict-s-v00@openssh.com");
    a.host_key = ssh_choose(ssh_get_namelist(&mut rc), ssh_get_namelist(&mut rs));
    a.enc_cs = ssh_choose(ssh_get_namelist(&mut rc), ssh_get_namelist(&mut rs));
    a.enc_sc = ssh_choose(ssh_get_namelist(&mut rc), ssh_get_namelist(&mut rs));
    // MACs are not used with an AEAD cipher; read past them
    val mc: Vec<str> = ssh_get_namelist(&mut rc);
    val ms: Vec<str> = ssh_get_namelist(&mut rs);
    val mc2: Vec<str> = ssh_get_namelist(&mut rc);
    val ms2: Vec<str> = ssh_get_namelist(&mut rs);
    a.comp_cs = ssh_choose(ssh_get_namelist(&mut rc), ssh_get_namelist(&mut rs));
    a.comp_sc = ssh_choose(ssh_get_namelist(&mut rc), ssh_get_namelist(&mut rs));
    if !rc.ok || !rs.ok {
        return ssh_no_algs();
    }
    val kex_ok: bool = str_equal(a.kex, "curve25519-sha256") || str_equal(a.kex, "curve25519-sha256@libssh.org");
    val aead: str = "chacha20-poly1305@openssh.com";
    a.ok = kex_ok && str_equal(a.host_key, "ssh-ed25519") && str_equal(a.enc_cs, aead) && str_equal(a.enc_sc, aead) && str_equal(a.comp_cs, "none") && str_equal(a.comp_sc, "none");
    return a;
}

/// Start (or restart, for re-keying) a key exchange: our KEXINIT packet.
fn ssh_send_kexinit(s: &mut SshSession) -> Vec<i64> {
    val p: Vec<i64> = ssh_kexinit_payload(s);
    s.my_kexinit = p;
    s.sent_newkeys = false;
    s.got_newkeys = false;
    // BG477: no keys of this exchange exist before its ECDH
    s.pending_out_key = Vec::new();
    s.pending_in_key = Vec::new();
    return ssh_packet(s, p);
}

/// The first bytes to send: our identification line and our KEXINIT.
pub fn ssh_start(s: &mut SshSession) -> Vec<i64> {
    return ssh_cat(ssh_version_line(s), ssh_send_kexinit(s));
}

/// Begin a re-key on an established session (either side may).
pub fn ssh_rekey(s: &mut SshSession) -> Vec<i64> {
    if s.state != SSH_ST_READY {
        return Vec::new();
    }
    s.peer_kexinit = Vec::new();
    return ssh_send_kexinit(s);
}

// ─── curve25519-sha256 (RFC 8731) and key derivation ───────────────────

fn ssh_str(v: Vec<i64>) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    ssh_put_string(&mut o, v);
    return o;
}

/// The exchange hash H = SHA-256(V_C || V_S || I_C || I_S || K_S || Q_C
/// || Q_S || K), each a string except K, an mpint.
pub fn ssh_exchange_hash(v_c: str, v_s: str, i_c: Vec<i64>, i_s: Vec<i64>, k_s: Vec<i64>, q_c: Vec<i64>, q_s: Vec<i64>, k_mpint: Vec<i64>) -> Vec<i64> {
    var m: Vec<i64> = ssh_str(str_bytes(v_c));
    m = ssh_cat(m, ssh_str(str_bytes(v_s)));
    m = ssh_cat(m, ssh_str(i_c));
    m = ssh_cat(m, ssh_str(i_s));
    m = ssh_cat(m, ssh_str(k_s));
    m = ssh_cat(m, ssh_str(q_c));
    m = ssh_cat(m, ssh_str(q_s));
    m = ssh_cat(m, k_mpint);
    return crypto_sha256_bytes(m);
}

/// Key derivation (RFC 4253 §7.2): HASH(K || H || letter || session_id),
/// extended with HASH(K || H || K1 || ...) to `len` bytes.
pub fn ssh_derive_key(k_mpint: Vec<i64>, h: Vec<i64>, letter: i64, session_id: Vec<i64>, len: i64) -> Vec<i64> {
    var first: Vec<i64> = ssh_cat(k_mpint, h);
    first.push(letter);
    var out: Vec<i64> = crypto_sha256_bytes(ssh_cat(first, session_id));
    while out.len() < len {
        out = ssh_cat(out, crypto_sha256_bytes(ssh_cat(ssh_cat(k_mpint, h), out)));
    }
    return ssh_slice(&out, 0, len);
}

fn ssh_set_keys(s: &mut SshSession, k_mpint: Vec<i64>, h: Vec<i64>) {
    if s.session_id.len() == 0 {
        s.session_id = h;
    }
    s.exchange_hash = h;
    val sid: Vec<i64> = s.session_id;
    val kcs: Vec<i64> = ssh_derive_key(k_mpint, h, 67, sid, 64);
    val ksc: Vec<i64> = ssh_derive_key(k_mpint, h, 68, sid, 64);
    if s.server {
        s.pending_out_key = ksc;
        s.pending_in_key = kcs;
    } else {
        s.pending_out_key = kcs;
        s.pending_in_key = ksc;
    }
}

fn ssh_shared(s: &mut SshSession, peer_pub: Vec<i64>) -> Vec<i64> {
    if peer_pub.len() != 32 {
        return Vec::new();
    }
    val z: Vec<i64> = x25519_scalarmult(s.e_secret, peer_pub);
    if x25519_is_all_zero(z) {
        return Vec::new();
    }
    return ssh_mpint(z);
}

fn ssh_new_ephemeral(s: &mut SshSession) {
    s.e_secret = ssh_random(s, 32);
    s.e_pub = x25519_public_key(s.e_secret);
}

fn ssh_send_newkeys(s: &mut SshSession) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_NEWKEYS);
    val out: Vec<i64> = ssh_packet(s, p);
    s.out_key = s.pending_out_key;
    s.sent_newkeys = true;
    if s.algs.strict {
        s.out_seq = 0;
    }
    if s.got_newkeys {
        ssh_kex_done(s);
    }
    return out;
}

/// Handle a peer KEXINIT; the client answers with KEX_ECDH_INIT.
fn ssh_on_kexinit(s: &mut SshSession, payload: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if s.my_kexinit.len() == 0 {
        // the peer started a re-key
        out = ssh_send_kexinit(s);
    }
    s.peer_kexinit = payload;
    var ic: Vec<i64> = s.my_kexinit;
    var is: Vec<i64> = payload;
    if s.server {
        ic = payload;
        is = s.my_kexinit;
    }
    val a: SshAlgs = ssh_negotiate(ic, is, s.kex_count == 0);
    if !a.ok {
        ssh_fail(s, "no common algorithms");
        return out;
    }
    if s.kex_count == 0 && a.strict && s.packets_in != 1 {
        ssh_fail(s, "strict KEX: KEXINIT was not the first packet");
        return out;
    }
    s.algs = a;
    if !s.server {
        ssh_new_ephemeral(s);
        var p: Vec<i64> = Vec::new();
        p.push(SSH_MSG_KEX_ECDH_INIT);
        ssh_put_string(&mut p, s.e_pub);
        out = ssh_cat(out, ssh_packet(s, p));
    }
    return out;
}

/// Server: KEX_ECDH_INIT in, KEX_ECDH_REPLY and NEWKEYS out.
fn ssh_on_ecdh_init(s: &mut SshSession, payload: Vec<i64>) -> Vec<i64> {
    var r: SshReader = ssh_reader(payload);
    val t: i64 = ssh_get_byte(&mut r);
    val q_c: Vec<i64> = ssh_get_string(&mut r);
    if !ssh_reader_done(&r) || q_c.len() != 32 || s.host_seed.len() != 32 {
        ssh_fail(s, "bad KEX_ECDH_INIT");
        return Vec::new();
    }
    ssh_new_ephemeral(s);
    val k: Vec<i64> = ssh_shared(s, q_c);
    if k.len() == 0 {
        ssh_fail(s, "bad client ephemeral key");
        return Vec::new();
    }
    val h: Vec<i64> = ssh_exchange_hash(s.peer_ident, s.ident, s.peer_kexinit, s.my_kexinit, s.host_key, q_c, s.e_pub, k);
    ssh_set_keys(s, k, h);
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_KEX_ECDH_REPLY);
    ssh_put_string(&mut p, s.host_key);
    ssh_put_string(&mut p, s.e_pub);
    ssh_put_string(&mut p, ssh_ed25519_sign(s.host_seed, h));
    val out: Vec<i64> = ssh_packet(s, p);
    return ssh_cat(out, ssh_send_newkeys(s));
}

/// Client: KEX_ECDH_REPLY in (host key and signature checked), NEWKEYS out.
fn ssh_on_ecdh_reply(s: &mut SshSession, payload: Vec<i64>) -> Vec<i64> {
    var r: SshReader = ssh_reader(payload);
    val t: i64 = ssh_get_byte(&mut r);
    val k_s: Vec<i64> = ssh_get_string(&mut r);
    val q_s: Vec<i64> = ssh_get_string(&mut r);
    val sig: Vec<i64> = ssh_get_string(&mut r);
    if !ssh_reader_done(&r) || q_s.len() != 32 {
        ssh_fail(s, "bad KEX_ECDH_REPLY");
        return Vec::new();
    }
    if s.trusted_host_key.len() > 0 && !aead_ct_eq(&k_s, &s.trusted_host_key) {
        ssh_fail(s, "host key not trusted");
        return Vec::new();
    }
    if s.host_key.len() > 0 && !aead_ct_eq(&k_s, &s.host_key) {
        ssh_fail(s, "host key changed during re-key");
        return Vec::new();
    }
    val k: Vec<i64> = ssh_shared(s, q_s);
    if k.len() == 0 {
        ssh_fail(s, "bad server ephemeral key");
        return Vec::new();
    }
    val h: Vec<i64> = ssh_exchange_hash(s.ident, s.peer_ident, s.my_kexinit, s.peer_kexinit, k_s, s.e_pub, q_s, k);
    if !ssh_ed25519_verify(k_s, h, sig) {
        ssh_fail(s, "bad host key signature");
        return Vec::new();
    }
    s.host_key = k_s;
    ssh_set_keys(s, k, h);
    return ssh_send_newkeys(s);
}

fn ssh_on_newkeys(s: &mut SshSession) {
    if s.pending_in_key.len() != 64 {
        ssh_fail(s, "NEWKEYS before the key exchange");
        return;
    }
    s.in_key = s.pending_in_key;
    s.got_newkeys = true;
    if s.algs.strict {
        s.in_seq = 0;
    }
    if s.sent_newkeys {
        ssh_kex_done(s);
    }
}

fn ssh_kex_done(s: &mut SshSession) {
    s.state = SSH_ST_READY;
    // BG477: the exchange's keys are installed; a NEWKEYS outside the next
    // exchange (before its ECDH, or with no re-key) finds none and fails
    // (RFC 4253 §7.3), instead of re-installing these as "new"
    s.pending_out_key = Vec::new();
    s.pending_in_key = Vec::new();
    s.kex_count = s.kex_count + 1;
    s.my_kexinit = Vec::new();
    s.peer_kexinit = Vec::new();
}

fn ssh_queue(s: &mut SshSession, payload: Vec<i64>) {
    var q: Vec<i64> = s.queue;
    ssh_put_string(&mut q, payload);
    s.queue = q;
}

/// Feed bytes received from the peer. The transport messages are handled
/// here; the bytes returned must be sent to the peer. Application
/// messages wait in the queue (ssh_next_message).
pub fn ssh_feed(s: &mut SshSession, bytes: Vec<i64>) -> Vec<i64> {
    s.inbuf = ssh_cat(s.inbuf, bytes);
    var out: Vec<i64> = Vec::new();
    if s.state == SSH_ST_VERSION {
        if !ssh_take_version(s) {
            return out;
        }
    }
    while s.state != SSH_ST_CLOSED {
        val m: SshMessage = ssh_take_packet(s);
        if !m.ok || m.msg < 0 {
            return out;
        }
        val t: i64 = m.msg;
        // strict KEX: nothing but key exchange messages until the first NEWKEYS
        val first: bool = s.kex_count == 0;
        if first && s.algs.strict && t != SSH_MSG_KEXINIT && t != SSH_MSG_NEWKEYS && t != SSH_MSG_KEX_ECDH_INIT && t != SSH_MSG_KEX_ECDH_REPLY {
            ssh_fail(s, "strict KEX: unexpected message during key exchange");
            return out;
        }
        if t == SSH_MSG_KEXINIT {
            out = ssh_cat(out, ssh_on_kexinit(s, m.payload));
        } else if t == SSH_MSG_KEX_ECDH_INIT && s.server && s.peer_kexinit.len() > 0 {
            out = ssh_cat(out, ssh_on_ecdh_init(s, m.payload));
        } else if t == SSH_MSG_KEX_ECDH_REPLY && !s.server && s.peer_kexinit.len() > 0 {
            out = ssh_cat(out, ssh_on_ecdh_reply(s, m.payload));
        } else if t == SSH_MSG_NEWKEYS {
            ssh_on_newkeys(s);
        } else if t == SSH_MSG_DISCONNECT {
            var r: SshReader = ssh_reader(m.payload);
            val tt: i64 = ssh_get_byte(&mut r);
            val code: i64 = ssh_get_u32(&mut r);
            ssh_fail(s, "peer disconnected (" + int_to_str(code) + "): " + ssh_get_text(&mut r));
        } else if t == SSH_MSG_IGNORE || t == SSH_MSG_DEBUG || t == SSH_MSG_UNIMPLEMENTED {
        // nothing to do
        } else if t >= 30 && t <= 49 {
            ssh_fail(s, "unexpected key exchange message");
        } else if s.state != SSH_ST_READY && s.kex_count == 0 {
            ssh_fail(s, "message before the key exchange finished");
        } else {
            ssh_queue(s, m.payload);
        }
    }
    return out;
}

/// The next queued application message, ok false when none.
pub fn ssh_next_message(s: &mut SshSession) -> SshMessage {
    if s.queue.len() < 4 {
        return SshMessage {
            ok: false, msg: -1, payload: Vec::new()
        };
    }
    var r: SshReader = ssh_reader(s.queue);
    val p: Vec<i64> = ssh_get_string(&mut r);
    s.queue = ssh_slice(&s.queue, r.pos, s.queue.len());
    return SshMessage {
        ok: true, msg: p.get(0), payload: p
    };
}

/// A DISCONNECT payload.
pub fn ssh_disconnect(reason: i64, text: str) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_DISCONNECT);
    ssh_put_u32(&mut p, reason);
    ssh_put_text(&mut p, text);
    ssh_put_text(&mut p, "");
    return p;
}

// ─── Service request (RFC 4253 §10) ────────────────────────────────────

/// SERVICE_REQUEST for a service ("ssh-userauth").
pub fn ssh_service_request(name: str) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_SERVICE_REQUEST);
    ssh_put_text(&mut p, name);
    return p;
}

/// SERVICE_ACCEPT.
pub fn ssh_service_accept(name: str) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_SERVICE_ACCEPT);
    ssh_put_text(&mut p, name);
    return p;
}

/// The service named in a SERVICE_REQUEST or SERVICE_ACCEPT ("" if malformed).
pub fn ssh_parse_service(payload: Vec<i64>) -> str {
    var r: SshReader = ssh_reader(payload);
    val t: i64 = ssh_get_byte(&mut r);
    val name: str = ssh_get_text(&mut r);
    if !ssh_reader_done(&r) || (t != SSH_MSG_SERVICE_REQUEST && t != SSH_MSG_SERVICE_ACCEPT) {
        return "";
    }
    return name;
}

// ─── User authentication (RFC 4252) ────────────────────────────────────

/// A parsed USERAUTH_REQUEST.
pub struct SshAuthRequest {
    pub ok: bool,
    pub user: str,
    pub service: str,
    pub method: str,
    pub has_sig: bool,
    pub alg: str,
    pub key_blob: Vec<i64>,
    pub sig: Vec<i64>,
    pub password: str,
}

fn ssh_auth_head(user: str, method: str) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_USERAUTH_REQUEST);
    ssh_put_text(&mut p, user);
    ssh_put_text(&mut p, "ssh-connection");
    ssh_put_text(&mut p, method);
    return p;
}

/// The data a publickey signature covers (RFC 4252 §7).
pub fn ssh_userauth_signed_data(session_id: Vec<i64>, user: str, alg: str, key_blob: Vec<i64>) -> Vec<i64> {
    var d: Vec<i64> = ssh_str(session_id);
    d = ssh_cat(d, ssh_auth_head(user, "publickey"));
    ssh_put_bool(&mut d, true);
    ssh_put_text(&mut d, alg);
    ssh_put_string(&mut d, key_blob);
    return d;
}

/// "Would this key be accepted?" (publickey without a signature).
pub fn ssh_userauth_publickey_query(user: str, public_key: Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = ssh_auth_head(user, "publickey");
    ssh_put_bool(&mut p, false);
    ssh_put_text(&mut p, "ssh-ed25519");
    ssh_put_string(&mut p, ssh_ed25519_blob(public_key));
    return p;
}

/// A signed publickey request with an Ed25519 user key seed.
pub fn ssh_userauth_publickey(s: &SshSession, user: str, seed: Vec<i64>) -> Vec<i64> {
    val blob: Vec<i64> = ssh_ed25519_blob(ed25519_public_key(seed));
    var p: Vec<i64> = ssh_auth_head(user, "publickey");
    ssh_put_bool(&mut p, true);
    ssh_put_text(&mut p, "ssh-ed25519");
    ssh_put_string(&mut p, blob);
    ssh_put_string(&mut p, ssh_ed25519_sign(seed, ssh_userauth_signed_data(s.session_id, user, "ssh-ed25519", blob)));
    return p;
}

/// A password request.
pub fn ssh_userauth_password(user: str, password: str) -> Vec<i64> {
    var p: Vec<i64> = ssh_auth_head(user, "password");
    ssh_put_bool(&mut p, false);
    ssh_put_text(&mut p, password);
    return p;
}

/// Parse a USERAUTH_REQUEST (methods none, password, publickey).
pub fn ssh_parse_userauth(payload: Vec<i64>) -> SshAuthRequest {
    var q: SshAuthRequest = SshAuthRequest {
        ok: false, user: "", service: "", method: "", has_sig: false, alg: "", key_blob: Vec::new(), sig: Vec::new(), password: ""
    };
    var r: SshReader = ssh_reader(payload);
    if ssh_get_byte(&mut r) != SSH_MSG_USERAUTH_REQUEST {
        return q;
    }
    q.user = ssh_get_text(&mut r);
    q.service = ssh_get_text(&mut r);
    q.method = ssh_get_text(&mut r);
    if str_equal(q.method, "publickey") {
        q.has_sig = ssh_get_bool(&mut r);
        q.alg = ssh_get_text(&mut r);
        q.key_blob = ssh_get_string(&mut r);
        if q.has_sig {
            q.sig = ssh_get_string(&mut r);
        }
    } else if str_equal(q.method, "password") {
        val change: bool = ssh_get_bool(&mut r);
        q.password = ssh_get_text(&mut r);
        if change {
            return q;
        }
    }
    q.ok = ssh_reader_done(&r);
    return q;
}

/// Server: check a signed publickey request against this session.
pub fn ssh_userauth_check_signature(s: &SshSession, q: &SshAuthRequest) -> bool {
    if !q.ok || !q.has_sig || !str_equal(q.alg, "ssh-ed25519") {
        return false;
    }
    return ssh_ed25519_verify(q.key_blob, ssh_userauth_signed_data(s.session_id, q.user, q.alg, q.key_blob), q.sig);
}

/// USERAUTH_FAILURE listing the methods that may continue.
pub fn ssh_userauth_failure(methods: str, partial: bool) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_USERAUTH_FAILURE);
    ssh_put_text(&mut p, methods);
    ssh_put_bool(&mut p, partial);
    return p;
}

/// USERAUTH_SUCCESS.
pub fn ssh_userauth_success() -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_USERAUTH_SUCCESS);
    return p;
}

/// USERAUTH_PK_OK for a queried key.
pub fn ssh_userauth_pk_ok(alg: str, key_blob: Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_USERAUTH_PK_OK);
    ssh_put_text(&mut p, alg);
    ssh_put_string(&mut p, key_blob);
    return p;
}

/// USERAUTH_BANNER.
pub fn ssh_userauth_banner(text: str) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_USERAUTH_BANNER);
    ssh_put_text(&mut p, text);
    ssh_put_text(&mut p, "");
    return p;
}

/// The method list of a USERAUTH_FAILURE.
pub fn ssh_parse_userauth_failure(payload: Vec<i64>) -> str {
    var r: SshReader = ssh_reader(payload);
    if ssh_get_byte(&mut r) != SSH_MSG_USERAUTH_FAILURE {
        return "";
    }
    return ssh_get_text(&mut r);
}

// ─── Connection protocol (RFC 4254) ────────────────────────────────────

/// A parsed channel message; fields not in the message stay zero/empty.
pub struct SshChannelMsg {
    pub ok: bool,
    pub msg: i64,
    pub recipient: i64,
    pub sender: i64,
    pub window: i64,
    pub max_packet: i64,
    pub kind: str,
    pub want_reply: bool,
    pub data: Vec<i64>,
    pub data_type: i64,
    pub text: str,
}

/// CHANNEL_OPEN for a "session" channel.
pub fn ssh_channel_open(sender: i64, window: i64, max_packet: i64) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_CHANNEL_OPEN);
    ssh_put_text(&mut p, "session");
    ssh_put_u32(&mut p, sender);
    ssh_put_u32(&mut p, window);
    ssh_put_u32(&mut p, max_packet);
    return p;
}

/// CHANNEL_OPEN_CONFIRMATION.
pub fn ssh_channel_open_confirm(recipient: i64, sender: i64, window: i64, max_packet: i64) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_CHANNEL_OPEN_CONFIRMATION);
    ssh_put_u32(&mut p, recipient);
    ssh_put_u32(&mut p, sender);
    ssh_put_u32(&mut p, window);
    ssh_put_u32(&mut p, max_packet);
    return p;
}

/// CHANNEL_OPEN_FAILURE (reason 1 = administratively prohibited, ...).
pub fn ssh_channel_open_failure(recipient: i64, reason: i64, text: str) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(SSH_MSG_CHANNEL_OPEN_FAILURE);
    ssh_put_u32(&mut p, recipient);
    ssh_put_u32(&mut p, reason);
    ssh_put_text(&mut p, text);
    ssh_put_text(&mut p, "");
    return p;
}

fn ssh_chan_simple(t: i64, recipient: i64) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(t);
    ssh_put_u32(&mut p, recipient);
    return p;
}

/// CHANNEL_WINDOW_ADJUST.
pub fn ssh_channel_window_adjust(recipient: i64, add: i64) -> Vec<i64> {
    var p: Vec<i64> = ssh_chan_simple(SSH_MSG_CHANNEL_WINDOW_ADJUST, recipient);
    ssh_put_u32(&mut p, add);
    return p;
}

/// CHANNEL_DATA.
pub fn ssh_channel_data(recipient: i64, data: Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = ssh_chan_simple(SSH_MSG_CHANNEL_DATA, recipient);
    ssh_put_string(&mut p, data);
    return p;
}

/// CHANNEL_EXTENDED_DATA (data_type 1 = stderr).
pub fn ssh_channel_extended_data(recipient: i64, data_type: i64, data: Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = ssh_chan_simple(SSH_MSG_CHANNEL_EXTENDED_DATA, recipient);
    ssh_put_u32(&mut p, data_type);
    ssh_put_string(&mut p, data);
    return p;
}

/// CHANNEL_EOF.
pub fn ssh_channel_eof(recipient: i64) -> Vec<i64> {
    return ssh_chan_simple(SSH_MSG_CHANNEL_EOF, recipient);
}

/// CHANNEL_CLOSE.
pub fn ssh_channel_close(recipient: i64) -> Vec<i64> {
    return ssh_chan_simple(SSH_MSG_CHANNEL_CLOSE, recipient);
}

/// CHANNEL_SUCCESS.
pub fn ssh_channel_success(recipient: i64) -> Vec<i64> {
    return ssh_chan_simple(SSH_MSG_CHANNEL_SUCCESS, recipient);
}

/// CHANNEL_FAILURE.
pub fn ssh_channel_failure(recipient: i64) -> Vec<i64> {
    return ssh_chan_simple(SSH_MSG_CHANNEL_FAILURE, recipient);
}

/// CHANNEL_REQUEST "exec" with a command, or "subsystem" with a name.
pub fn ssh_channel_request(recipient: i64, kind: str, want_reply: bool, arg: str) -> Vec<i64> {
    var p: Vec<i64> = ssh_chan_simple(SSH_MSG_CHANNEL_REQUEST, recipient);
    ssh_put_text(&mut p, kind);
    ssh_put_bool(&mut p, want_reply);
    if str_equal(kind, "exec") || str_equal(kind, "subsystem") {
        ssh_put_text(&mut p, arg);
    }
    return p;
}

/// Parse any channel message (90-100).
pub fn ssh_parse_channel(payload: Vec<i64>) -> SshChannelMsg {
    var c: SshChannelMsg = SshChannelMsg {
        ok: false, msg: -1, recipient: -1, sender: -1, window: 0, max_packet: 0, kind: "", want_reply: false, data: Vec::new(), data_type: 0, text: ""
    };
    var r: SshReader = ssh_reader(payload);
    val t: i64 = ssh_get_byte(&mut r);
    c.msg = t;
    if t == SSH_MSG_CHANNEL_OPEN {
        c.kind = ssh_get_text(&mut r);
        c.sender = ssh_get_u32(&mut r);
        c.window = ssh_get_u32(&mut r);
        c.max_packet = ssh_get_u32(&mut r);
        c.ok = r.ok;
        return c;
    }
    if t < SSH_MSG_CHANNEL_OPEN_CONFIRMATION || t > SSH_MSG_CHANNEL_FAILURE {
        return c;
    }
    c.recipient = ssh_get_u32(&mut r);
    if t == SSH_MSG_CHANNEL_OPEN_CONFIRMATION {
        c.sender = ssh_get_u32(&mut r);
        c.window = ssh_get_u32(&mut r);
        c.max_packet = ssh_get_u32(&mut r);
    } else if t == SSH_MSG_CHANNEL_OPEN_FAILURE {
        c.data_type = ssh_get_u32(&mut r);
        c.text = ssh_get_text(&mut r);
        val lang: str = ssh_get_text(&mut r);
    } else if t == SSH_MSG_CHANNEL_WINDOW_ADJUST {
        c.window = ssh_get_u32(&mut r);
    } else if t == SSH_MSG_CHANNEL_DATA {
        c.data = ssh_get_string(&mut r);
    } else if t == SSH_MSG_CHANNEL_EXTENDED_DATA {
        c.data_type = ssh_get_u32(&mut r);
        c.data = ssh_get_string(&mut r);
    } else if t == SSH_MSG_CHANNEL_REQUEST {
        c.kind = ssh_get_text(&mut r);
        c.want_reply = ssh_get_bool(&mut r);
        if str_equal(c.kind, "exec") || str_equal(c.kind, "subsystem") {
            c.text = ssh_get_text(&mut r);
        } else {
            r.pos = r.data.len();
        }
    }
    c.ok = r.ok && r.pos == r.data.len();
    return c;
}
