// Fides Byte Buffer standard library
//
// A growable byte buffer with read/write cursor for binary protocol parsing,
// serialization, and file format handling.
//
// Usage:
//   use buffer;
//   value buf = ByteBuffer::new();
//   buf.write_u32(0x12345678);
//   buf.rewind();
//   println(buf.read_u32());  // 305419896

module buffer;

use core;
use vec;
use string;

/// A byte buffer with separate read and write cursors.
pub struct ByteBuffer {
    pub data: Vec,
    pub pos: i64,   // read cursor
}

impl ByteBuffer {
    /// Create a new empty buffer.
    pub fn new() -> ByteBuffer {
        return ByteBuffer { data: Vec::new(), pos: 0 };
    }

    /// Create a buffer from an existing Vec of bytes.
    pub fn from_bytes(bytes: Vec) -> ByteBuffer {
        return ByteBuffer { data: bytes, pos: 0 };
    }

    /// Create a buffer from a string (UTF-8 bytes).
    pub fn from_string(s: str) -> ByteBuffer {
        return ByteBuffer { data: str_bytes(s), pos: 0 };
    }

    /// Get the total length of the buffer.
    pub fn len(self: ByteBuffer) -> i64 {
        return self.data.len();
    }

    /// Check if the buffer is empty.
    pub fn is_empty(self: ByteBuffer) -> bool {
        return self.data.is_empty();
    }

    /// Get the number of remaining readable bytes.
    pub fn remaining(self: ByteBuffer) -> i64 {
        return self.data.len() - self.pos;
    }

    /// Reset the read cursor to the beginning.
    pub fn rewind(self: ByteBuffer) -> void {
        self.pos = 0;
    }

    /// Clear the buffer and reset the cursor.
    pub fn clear(self: ByteBuffer) -> void {
        self.data.clear();
        self.pos = 0;
    }

    /// Get the raw bytes as a Vec.
    pub fn to_bytes(self: ByteBuffer) -> Vec {
        return self.data;
    }

    /// Convert the buffer to a string (UTF-8).
    pub fn to_string(self: ByteBuffer) -> str {
        return str_from_bytes(self.data);
    }

    // ─── Write operations (append to end) ───────────────────────────────

    /// Write a single byte.
    pub fn write_u8(self: ByteBuffer, value: i64) -> void {
        self.data.push(value & 0xFF);
    }

    /// Write a 16-bit unsigned integer (little-endian).
    pub fn write_u16_le(self: ByteBuffer, value: i64) -> void {
        self.data.push(value & 0xFF);
        self.data.push((value >> 8) & 0xFF);
    }

    /// Write a 16-bit unsigned integer (big-endian).
    pub fn write_u16_be(self: ByteBuffer, value: i64) -> void {
        self.data.push((value >> 8) & 0xFF);
        self.data.push(value & 0xFF);
    }

    /// Write a 32-bit unsigned integer (little-endian).
    pub fn write_u32_le(self: ByteBuffer, value: i64) -> void {
        self.data.push(value & 0xFF);
        self.data.push((value >> 8) & 0xFF);
        self.data.push((value >> 16) & 0xFF);
        self.data.push((value >> 24) & 0xFF);
    }

    /// Write a 32-bit unsigned integer (big-endian).
    pub fn write_u32_be(self: ByteBuffer, value: i64) -> void {
        self.data.push((value >> 24) & 0xFF);
        self.data.push((value >> 16) & 0xFF);
        self.data.push((value >> 8) & 0xFF);
        self.data.push(value & 0xFF);
    }

    /// Write a 64-bit integer (little-endian).
    pub fn write_u64_le(self: ByteBuffer, value: i64) -> void {
        var i = 0;
        while i < 8 {
            self.data.push((value >> (i * 8)) & 0xFF);
            i = i + 1;
        }
    }

    /// Write a 64-bit integer (big-endian).
    pub fn write_u64_be(self: ByteBuffer, value: i64) -> void {
        val i = 7;
        while i >= 0 {
            self.data.push((value >> (i * 8)) & 0xFF);
            i = i - 1;
        }
    }

    /// Write a raw byte array.
    pub fn write_bytes(self: ByteBuffer, bytes: Vec) -> void {
        var i = 0;
        while i < bytes.len() {
            self.data.push(bytes.get(i));
            i = i + 1;
        }
    }

    /// Write a string as UTF-8 bytes.
    pub fn write_string(self: ByteBuffer, s: str) -> void {
        val bytes = str_bytes(s);
        var i = 0;
        while i < bytes.len() {
            self.data.push(bytes.get(i));
            i = i + 1;
        }
    }

    /// Write a length-prefixed string (u32 LE length + bytes).
    pub fn write_string_lp(self: ByteBuffer, s: str) -> void {
        val bytes = str_bytes(s);
        self.write_u32_le(bytes.len());
        var i = 0;
        while i < bytes.len() {
            self.data.push(bytes.get(i));
            i = i + 1;
        }
    }

    // ─── Read operations (from cursor position) ─────────────────────────

    /// Read a single byte. Returns -1 if at end.
    pub fn read_u8(self: ByteBuffer) -> i64 {
        if self.pos >= self.data.len() { return -1; }
        val b = self.data.get(self.pos);
        self.pos = self.pos + 1;
        return b;
    }

    /// Read a 16-bit unsigned integer (little-endian).
    pub fn read_u16_le(self: ByteBuffer) -> i64 {
        if self.pos + 1 >= self.data.len() { return -1; }
        val lo = self.data.get(self.pos);
        val hi = self.data.get(self.pos + 1);
        self.pos = self.pos + 2;
        return lo | (hi << 8);
    }

    /// Read a 16-bit unsigned integer (big-endian).
    pub fn read_u16_be(self: ByteBuffer) -> i64 {
        if self.pos + 1 >= self.data.len() { return -1; }
        val hi = self.data.get(self.pos);
        val lo = self.data.get(self.pos + 1);
        self.pos = self.pos + 2;
        return (hi << 8) | lo;
    }

    /// Read a 32-bit unsigned integer (little-endian).
    pub fn read_u32_le(self: ByteBuffer) -> i64 {
        if self.pos + 3 >= self.data.len() { return -1; }
        val b0 = self.data.get(self.pos);
        val b1 = self.data.get(self.pos + 1);
        val b2 = self.data.get(self.pos + 2);
        val b3 = self.data.get(self.pos + 3);
        self.pos = self.pos + 4;
        return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    }

    /// Read a 32-bit unsigned integer (big-endian).
    pub fn read_u32_be(self: ByteBuffer) -> i64 {
        if self.pos + 3 >= self.data.len() { return -1; }
        val b0 = self.data.get(self.pos);
        val b1 = self.data.get(self.pos + 1);
        val b2 = self.data.get(self.pos + 2);
        val b3 = self.data.get(self.pos + 3);
        self.pos = self.pos + 4;
        return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
    }

    /// Read a 64-bit integer (little-endian).
    pub fn read_u64_le(self: ByteBuffer) -> i64 {
        if self.pos + 7 >= self.data.len() { return -1; }
        var result: i64 = 0;
        var i = 0;
        while i < 8 {
            result = result | (self.data.get(self.pos + i) << (i * 8));
            i = i + 1;
        }
        self.pos = self.pos + 8;
        return result;
    }

    /// Read a 64-bit integer (big-endian).
    pub fn read_u64_be(self: ByteBuffer) -> i64 {
        if self.pos + 7 >= self.data.len() { return -1; }
        var result: i64 = 0;
        var i = 0;
        while i < 8 {
            result = result | (self.data.get(self.pos + i) << ((7 - i) * 8));
            i = i + 1;
        }
        self.pos = self.pos + 8;
        return result;
    }

    /// Read `n` bytes into a Vec.
    pub fn read_bytes(self: ByteBuffer, n: i64) -> Vec {
        val result = Vec::new();
        var i = 0;
        while i < n && self.pos < self.data.len() {
            result.push(self.data.get(self.pos));
            self.pos = self.pos + 1;
            i = i + 1;
        }
        return result;
    }

    /// Read a length-prefixed string (u32 LE length + bytes).
    pub fn read_string_lp(self: ByteBuffer) -> str {
        val len = self.read_u32_le();
        if len <= 0 { return ""; }
        val bytes = self.read_bytes(len);
        return str_from_bytes(bytes);
    }

    /// Read a null-terminated string.
    pub fn read_string_null(self: ByteBuffer) -> str {
        val bytes = Vec::new();
        while self.pos < self.data.len() {
            val b = self.data.get(self.pos);
            self.pos = self.pos + 1;
            if b == 0 { break; }
            bytes.push(b);
        }
        return str_from_bytes(bytes);
    }

    /// Read the remaining bytes as a string.
    pub fn read_remaining_string(self: ByteBuffer) -> str {
        val bytes = self.read_bytes(self.remaining());
        return str_from_bytes(bytes);
    }

    // ─── Seek ───────────────────────────────────────────────────────────

    /// Seek to an absolute position.
    pub fn seek(self: ByteBuffer, pos: i64) -> void {
        if pos < 0 { self.pos = 0; return; }
        if pos > self.data.len() { self.pos = self.data.len(); return; }
        self.pos = pos;
    }

    /// Skip `n` bytes.
    pub fn skip(self: ByteBuffer, n: i64) -> void {
        self.pos = self.pos + n;
        if self.pos > self.data.len() { self.pos = self.data.len(); }
    }

    /// Get the current read position.
    pub fn position(self: ByteBuffer) -> i64 {
        return self.pos;
    }
}

// ─── Free function wrappers for constructors ────────────────────────────

/// Create a new empty buffer (free function wrapper).
pub fn buffer_new() -> ByteBuffer {
    return ByteBuffer { data: Vec::new(), pos: 0 };
}

/// Create a buffer from an existing Vec of bytes.
pub fn buffer_from_bytes(bytes: Vec) -> ByteBuffer {
    return ByteBuffer { data: bytes, pos: 0 };
}

/// Create a buffer from a string.
pub fn buffer_from_string(s: str) -> ByteBuffer {
    return ByteBuffer { data: str_bytes(s), pos: 0 };
}
