// Fides OS standard library
//
// Operating system interface: environment variables, command-line args,
// process control, and system information.
//
// Usage:
//   use os;
//   println(os_getenv("HOME"));     // "/home/user"
//   println(os_args());             // ["./program", "arg1"]
//   os_exit(0);

module os;
use vec;
// ─── FFI declarations ───────────────────────────────────────────────────

// SAFETY: the prototypes come from <stdlib.h>, checked by the C compiler;
// names and commands are NUL-terminated Fides strings, and a NULL from getenv
// is read as "" (str_len of a null string is 0).
extern "C" include "<stdlib.h>" {
    fn getenv as pledge_getenv(name: str) -> str;
    fn exit as pledge_exit(code: i64) -> void;
    fn system as pledge_system(cmd: str) -> i64;
}

// SAFETY: the prototype comes from <stdio.h>; nothing in os calls it (a
// format with % conversions would read missing arguments: do not pass user
// text as the format).
extern "C" include "<stdio.h>" {
    fn printf as pledge_printf(fmt: str) -> i64;
}

// ─── Environment variables ──────────────────────────────────────────────

/// Get an environment variable value. Returns "" if not set.
pub fn os_getenv(name: str) -> str {
    var value = pledge_getenv(name);
    // getenv returns NULL for an unset variable; hand back a real empty string
    if str_len(value) == 0 {
        return "";
    }
    return value;
}

/// Get an environment variable, or a default value if not set.
///
/// Example:
///   assert_eq(os_getenv_or("FIDDOC_NO_SUCH_VAR", "dflt"), "dflt");
///   assert(!os_hasenv("FIDDOC_NO_SUCH_VAR"));
///   assert_eq(os_getenv("FIDDOC_NO_SUCH_VAR"), "");
///   assert(os_argc() >= 1);
///   assert(str_len(os_name()) > 0);
pub fn os_getenv_or(name: str, default: str) -> str {
    var value = pledge_getenv(name);
    if str_len(value) == 0 {
        return default;
    }
    return value;
}

/// Check if an environment variable is set.
pub fn os_hasenv(name: str) -> bool {
    return str_len(pledge_getenv(name)) > 0;
}

// ─── Command-line arguments ─────────────────────────────────────────────

/// Get the number of command-line arguments.
pub fn os_argc() -> i64 {
    return p_argc();
}

/// Get a command-line argument by index ("" when out of range).
pub fn os_argv(idx: i64) -> str {
    match arg_at(idx) {
        Option::Some(value) => {
            return value;
        }
        Option::None => {
        }
    }
    return "";
}

/// Get all command-line arguments as a Vec of strings.
pub fn os_args() -> Vec<str> {
    var result = Vec::new();
    var argc = p_argc();
    var i = 0;
    while i < argc {
        result.push(p_str_take(p_argv(i)));
        i = i + 1;
    }
    return result;
}

// ─── Process control ────────────────────────────────────────────────────

/// Exit the process with a status code.
pub fn os_exit(code: i64) -> void {
    pledge_exit(code);
}

/// Exit with success (code 0).
pub fn os_exit_success() -> void {
    pledge_exit(0);
}

/// Exit with failure (code 1).
pub fn os_exit_failure() -> void {
    pledge_exit(1);
}

/// Execute a system command. Returns the exit status.
pub fn os_system(cmd: str) -> i64 {
    return pledge_system(cmd);
}

// ─── System information ─────────────────────────────────────────────────
// @cfg picks the compile-time target (host for `fid run`, --target for a
// cross build); an env-var override still wins where one exists.

/// Get the operating system name: "windows", "linux", "macos", "freebsd"
/// or "wasi" — decided at compile time by @cfg for the target.
@cfg(windows)
pub fn os_name() -> str {
    return "windows";
}

@cfg(linux)
pub fn os_name() -> str {
    return "linux";
}

@cfg(macos)
pub fn os_name() -> str {
    return "macos";
}

@cfg(freebsd)
pub fn os_name() -> str {
    return "freebsd";
}

@cfg(wasi)
pub fn os_name() -> str {
    return "wasi";
}

/// Get the user's home directory.
@cfg(windows)
pub fn os_home_dir() -> str {
    var home = pledge_getenv("USERPROFILE");
    if str_len(home) > 0 {
        return home;
    }
    var drive = pledge_getenv("HOMEDRIVE");
    var path = pledge_getenv("HOMEPATH");
    if str_len(drive) > 0 && str_len(path) > 0 {
        return drive + path;
    }
    return ".";
}

@cfg(unix)
pub fn os_home_dir() -> str {
    var home = pledge_getenv("HOME");
    if str_len(home) > 0 {
        return home;
    }
    return "/";
}

/// Get the current working directory (from PWD env var).
/// No getcwd builtin exists yet; PWD is set by shells on POSIX hosts.
pub fn os_cwd() -> str {
    var pwd = pledge_getenv("PWD");
    if str_len(pwd) > 0 {
        return pwd;
    }
    return ".";
}

/// Get the user name.
@cfg(windows)
pub fn os_user() -> str {
    var user = pledge_getenv("USERNAME");
    if str_len(user) > 0 {
        return user;
    }
    return "unknown";
}

@cfg(unix)
pub fn os_user() -> str {
    var user = pledge_getenv("USER");
    if str_len(user) > 0 {
        return user;
    }
    var logname = pledge_getenv("LOGNAME");
    if str_len(logname) > 0 {
        return logname;
    }
    return "unknown";
}

/// Get the hostname (env-var best-effort; no gethostname builtin yet).
pub fn os_hostname() -> str {
    var host = pledge_getenv("HOSTNAME");
    if str_len(host) > 0 {
        return host;
    }
    host = pledge_getenv("COMPUTERNAME");
    if str_len(host) > 0 {
        return host;
    }
    return "localhost";
}

/// Get the user's shell.
@cfg(windows)
pub fn os_shell() -> str {
    var shell = pledge_getenv("COMSPEC");
    if str_len(shell) > 0 {
        return shell;
    }
    return "cmd.exe";
}

@cfg(unix)
pub fn os_shell() -> str {
    var shell = pledge_getenv("SHELL");
    if str_len(shell) > 0 {
        return shell;
    }
    return "/bin/sh";
}

/// Get the terminal (from TERM env var).
pub fn os_term() -> str {
    var term = pledge_getenv("TERM");
    if str_len(term) > 0 {
        return term;
    }
    return "dumb";
}

/// Get the PATH environment variable as a Vec of paths.
pub fn os_path() -> Vec<str> {
    var path = pledge_getenv("PATH");
    if str_len(path) == 0 {
        return Vec::new();
    }
    return str_split(path, os_path_list_sep());
}

// ─── Temp directory ─────────────────────────────────────────────────────

/// Get the system temporary directory.
@cfg(windows)
pub fn os_tmp_dir() -> str {
    var tmp = pledge_getenv("TEMP");
    if str_len(tmp) > 0 {
        return tmp;
    }
    tmp = pledge_getenv("TMP");
    if str_len(tmp) > 0 {
        return tmp;
    }
    var profile = pledge_getenv("USERPROFILE");
    if str_len(profile) > 0 {
        return profile + "\\AppData\\Local\\Temp";
    }
    return "C:\\Windows\\Temp";
}

@cfg(unix)
pub fn os_tmp_dir() -> str {
    var tmpdir = pledge_getenv("TMPDIR");
    if str_len(tmpdir) > 0 {
        return tmpdir;
    }
    return "/tmp";
}

// ─── Path separator ─────────────────────────────────────────────────────

/// Get the path separator for this OS.
@cfg(windows)
pub fn os_path_sep() -> str {
    return "\\";
}

@cfg(unix)
pub fn os_path_sep() -> str {
    return "/";
}

/// Get the path list separator (for PATH-like variables).
@cfg(windows)
pub fn os_path_list_sep() -> str {
    return ";";
}

@cfg(unix)
pub fn os_path_list_sep() -> str {
    return ":";
}

// ─── WASI fallbacks ─────────────────────────────────────────────────────
// No user/home/shell concept; env vars are all there is.

@cfg(wasi)
pub fn os_home_dir() -> str {
    var home = pledge_getenv("HOME");
    if str_len(home) > 0 {
        return home;
    }
    return "/";
}

@cfg(wasi)
pub fn os_user() -> str {
    var user = pledge_getenv("USER");
    if str_len(user) > 0 {
        return user;
    }
    return "unknown";
}

@cfg(wasi)
pub fn os_shell() -> str {
    return "/bin/sh";
}

@cfg(wasi)
pub fn os_tmp_dir() -> str {
    var tmpdir = pledge_getenv("TMPDIR");
    if str_len(tmpdir) > 0 {
        return tmpdir;
    }
    return "/tmp";
}

@cfg(wasi)
pub fn os_path_sep() -> str {
    return "/";
}

@cfg(wasi)
pub fn os_path_list_sep() -> str {
    return ":";
}

// ─── Compatibility aliases for env.fd + args.fd ──────────────────────────
// These allow code written for env.fd/args.fd's API to work with `use os;`.

/// Alias for env_get — get an environment variable value.
pub fn env_get(name: str) -> str {
    return os_getenv(name);
}

/// Alias for env_exists — check if an environment variable is set.
pub fn env_exists(name: str) -> bool {
    return os_hasenv(name);
}

/// Alias for args_len — number of command-line arguments.
pub fn args_len() -> i64 {
    return os_argc();
}

/// Alias for args_get — get a command-line argument by index.
pub fn args_get(idx: i64) -> str {
    return os_argv(idx);
}

/// Alias for args_program_name — get the program name (argv[0]).
pub fn args_program_name() -> str {
    return os_argv(0);
}
