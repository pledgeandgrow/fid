// ─── Scripting via comptime gen ───────────────────────────────────────────
//
// Game scripts are Fides code compiled with `comptime gen { ... }`.
// The "scripting language" is Fides itself — no Lua, no separate VM.
// Scripts can be hot-reloaded via dev JIT (fidesc watch).
//
// In the future:
//   comptime gen {
//     system Move(dt: f64) {
//       query(Position, Velocity) {
//         Position.x = Position.x + Velocity.dx * dt;
//         Position.y = Position.y + Velocity.dy * dt;
//       }
//     }
//   }
//
// This would generate specialized iteration code at compile time.

/// Compile a game script. In comptime mode, this generates native code.
/// For now, it's a no-op (scripts are compiled normally).
pub fn compile_script(source: str) -> void {
    // In comptime mode, this would generate and compile the script.
    // For now, scripts are compiled as part of the main program.
}

// ─── Hot-reload dev mode ─────────────────────────────────────────────────
//
// Hot-reload is handled by `fidesc watch` (already implemented).
// Changed systems are recompiled and hot-swapped into the running game.
// Production builds are fully AOT-compiled, no JIT.

/// Reload changed systems. Called when a file changes during development.
/// In production, this is a no-op.
