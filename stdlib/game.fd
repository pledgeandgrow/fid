// Fides Game Engine Framework — Phase 15.5
//
// Game engine framework built on ECS + frame arenas.
// Fides is its own scripting language — no Lua, no embedded VM.
// ECS layouts are generated at compile time (comptime gen).
// Frame arenas handle per-frame allocations.
//
// Usage:
//   use game;
//   use ecs;
//   use arena;
//
//   component Position { x: f64, y: f64 }
//   component Velocity { dx: f64, dy: f64 }
//
//   fn main() {
//     var fa = frame_new();
//     var running = true;
//     while running {
//       frame_begin(fa);
//       game_update(0.016);  // 60 FPS
//       game_render();
//       frame_end(fa);
//     }
//     frame_free(fa);
//   }

module game;
 use arena; use ecs; use image; use font;
// ─── Game loop ───────────────────────────────────────────────────────────

/// Game configuration — timing, window, etc.
pub struct GameConfig {
    pub target_fps: i64,
    // target frames per second
    pub frame_time: f64,
    // seconds per frame (1.0 / target_fps)
    pub max_entities: i64,
    // maximum number of entities
    pub running: bool,  // whether the game is running
}

/// Create a default game configuration.
///
/// Example:
///   val c = game_config_new();
///   assert_eq(c.target_fps, 60);
///   val c4 = game_config_with_fps(4);
///   assert(c4.frame_time == 0.25);
///   val (x, y) = physics_move(1.0, 2.0, 4.0, -8.0, 0.5);
///   assert(x == 3.0);
///   assert(y == -2.0);
///   assert(physics_aabb_overlap(0.0, 0.0, 2.0, 2.0, 1.0, 1.0, 2.0, 2.0));
///   assert(!physics_aabb_overlap(0.0, 0.0, 1.0, 1.0, 5.0, 5.0, 1.0, 1.0));
pub fn game_config_new() -> GameConfig {
    return GameConfig {
        target_fps: 60, frame_time: 0.016666666666666666, max_entities: 10000, running: true,
    };
}

/// Create a game configuration with a custom FPS.
pub fn game_config_with_fps(fps: i64) -> GameConfig {
    var config = game_config_new();
    config.target_fps = fps;
    config.frame_time = 1.0 / (fps as f64);
    return config;
}

/// Run the game loop. Calls update and render functions each frame.
/// Uses a frame allocator for per-frame allocations.
pub fn game_loop(config: GameConfig, update_fn: fn(f64) -> void, render_fn: fn() -> void) -> void {
    var fa = frame_new();
    while config.running {
        frame_begin(& mut fa);
        update_fn(config.frame_time);
        render_fn();
        frame_end(fa);
    }
    frame_free(fa);
}

/// Run one frame of the game. Useful for testing.
pub fn game_frame(config: GameConfig, update_fn: fn(f64) -> void, render_fn: fn() -> void) -> void {
    var fa = frame_new();
    frame_begin(& mut fa);
    update_fn(config.frame_time);
    render_fn();
    frame_end(fa);
    frame_free(fa);
}

// ─── Asset management ────────────────────────────────────────────────────
//
// Assets are loaded via @derive(Serialize, Deserialize) — no reflection.
// Deserialization code is generated at compile time.

/// Asset handle — an opaque reference to a loaded asset.
type AssetHandle = i64;
/// Load an asset from a JSON file. The asset type is determined by the
/// caller (via @derive(Deserialize)). Returns an asset handle.
pub fn load_asset(path: str) -> AssetHandle {
    // In a full implementation, this would use @derive(Deserialize)
    // to parse the JSON into a typed struct at compile time.
    // For now, return the file content as a handle.
    var content: i64 = p_file_read(path);
    return content;
}

/// Load a texture asset.
pub fn load_texture(path: str) -> AssetHandle {
    return load_asset(path);
}

/// Load a sound asset.
pub fn load_sound(path: str) -> AssetHandle {
    return load_asset(path);
}

/// Load a 3D model asset.
pub fn load_model(path: str) -> AssetHandle {
    return load_asset(path);
}

// ─── Input handling ──────────────────────────────────────────────────────
//
// Input is handled via the event system. The game loop dispatches
// events to handlers registered with the ECS.

/// Input event types.
const INPUT_KEY_DOWN: i64 = 1; const INPUT_KEY_UP: i64 = 2; const INPUT_MOUSE_MOVE: i64 = 3; const INPUT_MOUSE_DOWN: i64 = 4; const INPUT_MOUSE_UP: i64 = 5;
/// Dispatch a key down event.
pub fn input_key_down(_key: i64) -> void {
    ecs_dispatch_event("on_key_down");
}

/// Dispatch a key up event.
pub fn input_key_up(_key: i64) -> void {
    ecs_dispatch_event("on_key_up");
}

/// Dispatch a mouse move event.
pub fn input_mouse_move(_x: i64, _y: i64) -> void {
    ecs_dispatch_event("on_mouse_move");
}

// ─── Rendering ───────────────────────────────────────────────────────────
//
// Software framebuffer: render_* functions draw into a module-owned RGBA
// Image. render_present() saves it to "frame.png"; render_present_to(path)
// chooses the file (PNG by extension, BMP otherwise). GPU backends can
// replace this layer later; everything below is real and testable.

var GAME_FB: Image = image_create(0, 0, 4);
var GAME_FB_PATH: str = "frame.png";

fn game_ensure_fb() -> void {
    // Lazily allocate the default 320x240 surface so importing the module
    // costs nothing.
    if GAME_FB.width == 0 {
        GAME_FB = image_create(320, 240, 4);
    }
}

/// Resize the software framebuffer (default 320x240, allocated lazily).
pub fn render_init(w: i64, h: i64) -> void {
    if w > 0 && h > 0 {
        GAME_FB = image_create(w, h, 4);
    }
}

/// Borrow the framebuffer Image (e.g. to save it yourself).
pub fn game_framebuffer() -> & Image {
    return & GAME_FB;
}

fn game_chan(c: f64) -> i64 {
    var v: i64 = (c * 255.0) as i64;
    if v < 0 { v = 0; }
    if v > 255 { v = 255; }
    return v;
}

/// Clear the screen with a color (channels are 0.0-1.0 floats).
pub fn render_clear(r: f64, g: f64, b: f64) -> void {
    game_ensure_fb();
    image_fill(& mut GAME_FB, game_chan(r), game_chan(g), game_chan(b), 255);
}

/// Draw a filled rectangle.
pub fn render_rect(x: f64, y: f64, w: f64, h: f64, r: f64, g: f64, b: f64) -> void {
    game_ensure_fb();
    var py: i64 = y as i64;
    val yend: i64 = (y + h) as i64;
    val xend: i64 = (x + w) as i64;
    while py < yend {
        var px: i64 = x as i64;
        while px < xend {
            image_set_pixel(& mut GAME_FB, px, py, game_chan(r), game_chan(g), game_chan(b), 255);
            px = px + 1;
        }
        py = py + 1;
    }
}

/// Draw a filled circle.
pub fn render_circle(x: f64, y: f64, radius: f64, r: f64, g: f64, b: f64) -> void {
    game_ensure_fb();
    val r2: f64 = radius * radius;
    var py: i64 = (y - radius) as i64;
    while (py as f64) <= y + radius {
        var px: i64 = (x - radius) as i64;
        while (px as f64) <= x + radius {
            val dx: f64 = (px as f64) - x;
            val dy: f64 = (py as f64) - y;
            if dx * dx + dy * dy <= r2 {
                image_set_pixel(& mut GAME_FB, px, py, game_chan(r), game_chan(g), game_chan(b), 255);
            }
            px = px + 1;
        }
        py = py + 1;
    }
}

/// Draw text using the built-in 8x8 bitmap font.
pub fn render_text(x: f64, y: f64, text: str) -> void {
    game_ensure_fb();
    var i: i64 = 0;
    val len: i64 = str_len(text);
    while i < len {
        val glyph: i64 = font8x8_glyph(str_byte_at(text, i));
        var gy: i64 = 0;
        while gy < 8 {
            val rowbyte: i64 = (glyph >> (gy * 8)) & 255;
            var gx: i64 = 0;
            while gx < 8 {
                if ((rowbyte >> gx) & 1) != 0 {
                    image_set_pixel(& mut GAME_FB, x as i64 + i * 8 + gx, y as i64 + gy, 255, 255, 255, 255);
                }
                gx = gx + 1;
            }
            gy = gy + 1;
        }
        i = i + 1;
    }
}

/// Present the frame: saves the framebuffer to "frame.png" (or the path
/// set by render_set_output). Returns file_write_bytes' status.
pub fn render_present() -> void {
    game_ensure_fb();
    image_save_png(& GAME_FB, GAME_FB_PATH);
}

/// Present the frame to a specific file (.png or .bmp by extension).
pub fn render_present_to(path: str) -> void {
    game_ensure_fb();
    if str_ends_with(path, ".bmp") {
        image_save_bmp(& GAME_FB, path);
    } else {
        image_save_png(& GAME_FB, path);
    }
}

/// Set the file render_present() writes to.
pub fn render_set_output(path: str) -> void {
    GAME_FB_PATH = path;
}

// ─── Scripting via comptime gen ───────────────────────────────────────────
//
// Game scripts are Fides code compiled with `comptime gen { ... }`.
// The "scripting language" is Fides itself — no Lua, no separate VM.
// Scripts can be hot-reloaded via dev JIT (fidesc watch).
//
// In the future:
//   comptime gen {
//     system Move(dt: f64) {
//       query(Position, Velocity) {
//         Position.x = Position.x + Velocity.dx * dt;
//         Position.y = Position.y + Velocity.dy * dt;
//       }
//     }
//   }
//
// This would generate specialized iteration code at compile time.

/// Compile a game script. In comptime mode, this generates native code.
/// For now, it's a no-op (scripts are compiled normally).
pub fn compile_script(_source: str) -> void {  // In comptime mode, this would generate and compile the script.
// For now, scripts are compiled as part of the main program.
}

// ─── Hot-reload dev mode ─────────────────────────────────────────────────
//
// Hot-reload is handled by `fidesc watch` (already implemented).
// Changed systems are recompiled and hot-swapped into the running game.
// Production builds are fully AOT-compiled, no JIT.

/// Reload changed systems. Called when a file changes during development.
/// In production, this is a no-op.
pub fn hot_reload() -> void {  // Hot-reload is handled by `fidesc watch` at the compiler level.
// This function is a placeholder for game-level reload hooks.
}

// ─── Physics (basic) ─────────────────────────────────────────────────────
//
// Basic 2D physics for game prototypes. Not a full physics engine.

/// Apply velocity to a position over a time step.
pub fn physics_move(pos_x: f64, pos_y: f64, vel_x: f64, vel_y: f64, dt: f64) -> (f64, f64) {
    var new_x = pos_x + vel_x * dt;
    var new_y = pos_y + vel_y * dt;
    return (new_x, new_y);
}

/// Apply gravity to a velocity.
pub fn physics_gravity(vel_y: f64, gravity: f64, dt: f64) -> f64 {
    return vel_y + gravity * dt;
}

/// Check if two axis-aligned bounding boxes overlap.
pub fn physics_aabb_overlap(x1: f64, y1: f64, w1: f64, h1: f64, x2: f64, y2: f64, w2: f64, h2: f64) -> bool {
    return x1 < x2 + w2 && x1 + w1 > x2 && y1 < y2 + h2 && y1 + h1 > y2;
}
