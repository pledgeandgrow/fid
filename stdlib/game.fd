// Fides Game Engine Framework — Phase 15.5
//
// Game engine framework built on ECS + frame arenas.
// Fides is its own scripting language — no Lua, no embedded VM.
// ECS layouts are generated at compile time (comptime gen).
// Frame arenas handle per-frame allocations.
//
// Usage:
//   use game;
//   use ecs;
//   use arena;
//
//   component Position { x: f64, y: f64 }
//   component Velocity { dx: f64, dy: f64 }
//
//   fn main() {
//     var fa = frame_new();
//     var running = true;
//     while running {
//       frame_begin(fa);
//       game_update(0.016);  // 60 FPS
//       game_render();
//       frame_end(fa);
//     }
//     frame_free(fa);
//   }

module game;

use ecs;
use arena;

// ─── Game loop ───────────────────────────────────────────────────────────

/// Game configuration — timing, window, etc.
pub struct GameConfig {
    pub target_fps: i64,       // target frames per second
    pub frame_time: f64,        // seconds per frame (1.0 / target_fps)
    pub max_entities: i64,     // maximum number of entities
    pub running: bool,          // whether the game is running
}

/// Create a default game configuration.
pub fn game_config_new() -> GameConfig {
    return GameConfig {
        target_fps: 60,
        frame_time: 0.016666666666666666,
        max_entities: 10000,
        running: true,
    };
}

/// Create a game configuration with a custom FPS.
pub fn game_config_with_fps(fps: i64) -> GameConfig {
    var config = game_config_new();
    config.target_fps = fps;
    config.frame_time = 1.0 / (fps as f64);
    return config;
}

/// Run the game loop. Calls update and render functions each frame.
/// Uses a frame allocator for per-frame allocations.
pub fn game_loop(config: GameConfig, update_fn: fn(f64) -> void, render_fn: fn() -> void) -> void {
    var fa = frame_new();
    while config.running {
        frame_begin(&mut fa);
        update_fn(config.frame_time);
        render_fn();
        frame_end(fa);
    }
    frame_free(fa);
}

/// Run one frame of the game. Useful for testing.
pub fn game_frame(config: GameConfig, update_fn: fn(f64) -> void, render_fn: fn() -> void) -> void {
    var fa = frame_new();
    frame_begin(&mut fa);
    update_fn(config.frame_time);
    render_fn();
    frame_end(fa);
    frame_free(fa);
}

// ─── Asset management ────────────────────────────────────────────────────
//
// Assets are loaded via @derive(Serialize, Deserialize) — no reflection.
// Deserialization code is generated at compile time.

/// Asset handle — an opaque reference to a loaded asset.
type AssetHandle = i64;

/// Load an asset from a JSON file. The asset type is determined by the
/// caller (via @derive(Deserialize)). Returns an asset handle.
pub fn load_asset(path: str) -> AssetHandle {
    // In a full implementation, this would use @derive(Deserialize)
    // to parse the JSON into a typed struct at compile time.
    // For now, return the file content as a handle.
    var content: i64 = p_file_read(path);
    return content;
}

/// Load a texture asset.
pub fn load_texture(path: str) -> AssetHandle {
    return load_asset(path);
}

/// Load a sound asset.
pub fn load_sound(path: str) -> AssetHandle {
    return load_asset(path);
}

/// Load a 3D model asset.
pub fn load_model(path: str) -> AssetHandle {
    return load_asset(path);
}

// ─── Input handling ──────────────────────────────────────────────────────
//
// Input is handled via the event system. The game loop dispatches
// events to handlers registered with the ECS.

/// Input event types.
const INPUT_KEY_DOWN: i64 = 1;
const INPUT_KEY_UP: i64 = 2;
const INPUT_MOUSE_MOVE: i64 = 3;
const INPUT_MOUSE_DOWN: i64 = 4;
const INPUT_MOUSE_UP: i64 = 5;

/// Dispatch a key down event.
pub fn input_key_down(key: i64) -> void {
    ecs_dispatch_event("on_key_down");
}

/// Dispatch a key up event.
pub fn input_key_up(key: i64) -> void {
    ecs_dispatch_event("on_key_up");
}

/// Dispatch a mouse move event.
pub fn input_mouse_move(x: i64, y: i64) -> void {
    ecs_dispatch_event("on_mouse_move");
}

