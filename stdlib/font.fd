// Fides Font standard library
//
// TrueType font loading and text rasterization via stb_truetype.
// stb_truetype is a single-header C library (no dependencies) that
// can parse TTF/OTF fonts and rasterize glyphs to bitmaps.
//
// Install: Download stb_truetype.h and place it in the include path.
//   wget https://raw.githubusercontent.com/nothings/stb/master/stb_truetype.h
//
// Usage:
//   use font;
//
//   var fnt = font_load("DejaVuSans.ttf", 24.0);  // 24px font
//   var glyph = font_get_glyph(fnt, 65);  // 'A' = codepoint 65
//   // glyph.bitmap contains grayscale pixels (glyph.width x glyph.height)
//
//   // Render a string to a pixel buffer:
//   var text_img = font_render_text(fnt, "Hello, World!");
//   // text_img is an Image with RGBA pixels

module font;
use vec;
use image;
// ─── Font Data Structures ────────────────────────────────────────────────

pub struct Font {
    pub info: i64,
    // stbtt_fontinfo (opaque pointer, 0 in interpreter)
    pub data: Vec<i64>,
    // TTF file bytes
    pub scale: f64,
    // pixel height scale
    pub ascent: f64,
    // font ascent (baseline to top)
    pub descent: f64,
    // font descent (baseline to bottom)
    pub line_gap: f64,
    // line gap
    pub line_height: f64,  // total line height (ascent - descent + line_gap)
}

pub struct Glyph {
    pub codepoint: i64,
    // Unicode codepoint
    pub width: i64,
    // glyph bitmap width
    pub height: i64,
    // glyph bitmap height
    pub xoff: i64,
    // x offset from cursor to left edge
    pub yoff: i64,
    // y offset from cursor to top edge
    pub advance: f64,
    // cursor advance after this glyph
    pub bitmap: Vec<i64>,  // grayscale pixels (0-255), width * height
}

// ─── stb_truetype FFI ─────────────────────────────────────────────────────
//
// stb_truetype is included as a single C header. The native runtime
// (pledge_font.c) wraps the stb_truetype API for Fides FFI.

// SAFETY: pledge_font.h is the runtime's own header, checked by the C
// compiler. font_load passes 0 as out_font (no output buffer), which the
// helper must treat as "none"; any other out_ argument must be the address
// of a buffer the caller allocated at the size the helper writes.
extern "C" include "pledge_font.h" link "" {
    // Load a TTF/OTF font from a file path: the font's handle (the
    // PledgeFont the helper malloc'd, > 0) on success, -1 on failure.
    // out_font is not used.
    fn pledge_font_load(path: str, pixel_size: f64, out_font: i64) -> i64;

    // Load a TTF/OTF font from raw bytes: a handle as pledge_font_load.
    fn pledge_font_load_mem(data: i64, data_len: i64, pixel_size: f64, out_font: i64) -> i64;

    // Get a glyph bitmap for a codepoint. Returns 0 on success.
    // Fills the Glyph struct fields (width, height, xoff, yoff, advance).
    // The bitmap data is written to out_bitmap (width * height bytes).
    fn pledge_font_get_glyph(font: i64, codepoint: i64, out_w: i64, out_h: i64, out_xoff: i64, out_yoff: i64, out_advance: i64, out_bitmap: i64) -> i64;

    // Get the kerning advance between two codepoints.
    fn pledge_font_kern(font: i64, ch1: i64, ch2: i64) -> f64;

    // Measure the width of a text string in pixels.
    fn pledge_font_text_width(font: i64, text: str) -> i64;

    // Free a font's resources.
    fn pledge_font_free(font: i64) -> void;
}

// ─── Font Loading ────────────────────────────────────────────────────────

/// Load a TrueType font from a file path at the given pixel size.
/// Returns a Font with info=0 on failure.
pub fn font_load(path: str, pixel_size: f64) -> Font {
    var font = Font {
        info: 0, data: Vec::new(), scale: pixel_size, ascent: 0.0, descent: 0.0, line_gap: 0.0, line_height: pixel_size,
    };

    // In native builds, pledge_font_load reads the TTF file and initializes
    // stbtt_fontinfo. In the interpreter, this is a no-op (info stays 0).
    var result: i64 = 0;
    // SAFETY: the helper (runtime/pledge_font.c) reads the NUL-terminated
    // text of path (a Fides str alive for the call) and never touches
    // out_font (0 here). It returns -1 on failure and, on success, the
    // handle of the font it malloc'd, which font.info now keeps (before, a
    // success was taken for a failure and the font leaked); font_free
    // gives it back.
    unsafe {
        result = pledge_font_load(path, pixel_size, 0);
    }
    if result <= 0 {
        return font;
        // failure, info=0
    }
    font.info = result;

    // Set metrics (would be filled by pledge_font_load in native builds)
    font.ascent = pixel_size * 0.8;
    font.descent = pixel_size * 0.2;
    font.line_gap = pixel_size * 0.1;
    font.line_height = font.ascent - font.descent + font.line_gap;

    return font;
}

/// Free a font's resources.
pub fn font_free(font: &mut Font) -> void {
    if font.info != 0 {
        // SAFETY: font.info is nonzero only when it holds a font the
        // pledge_font helper allocated (font_load sets it from
        // pledge_font_load's handle); it is zeroed right after, so this Font
        // frees it once. Two copies of one Font freed would free it twice.
        unsafe {
            pledge_font_free(font.info);
        }
        font.info = 0;
    }
    font.data = Vec::new();
}

// ─── Glyph Rasterization ─────────────────────────────────────────────────

/// Get a single glyph bitmap for a codepoint.
/// Returns a Glyph with width=0 if the codepoint is not in the font.
pub fn font_get_glyph(font: &Font, codepoint: i64) -> Glyph {
    var glyph = Glyph {
        codepoint: codepoint, width: 0, height: 0, xoff: 0, yoff: 0, advance: 0.0, bitmap: Vec::new(),
    };

    if font.info == 0 {
        return glyph;
        // no font loaded (interpreter mode)
    }

    // In native builds, pledge_font_get_glyph calls stbtt_GetCodepointBitmap
    // and fills the glyph fields. The bitmap is a grayscale alpha buffer.
    var result: i64 = 0;
    // SAFETY: font.info is a nonzero font from the pledge_font helper; every
    // out_ argument is 0, and runtime/pledge_font.c skips each null output
    // (no glyph field or bitmap is written) and frees its own bitmap.
    unsafe {
        result = pledge_font_get_glyph(font.info, codepoint, 0, 0, 0, 0, 0, 0);
    }
    if result != 0 {
        return glyph;
        // glyph not found
    }

    // Fill bitmap with zeros (actual pixels would be filled by native runtime)
    var size = glyph.width * glyph.height;
    var i = 0;
    while i < size {
        glyph.bitmap.push(0);
        i = i + 1;
    }

    return glyph;
}

/// Get the kerning advance between two codepoints (in pixels).
pub fn font_kern(font: &Font, ch1: i64, ch2: i64) -> f64 {
    if font.info == 0 {
        return 0.0;
    }
    // SAFETY: font.info is a nonzero font from the pledge_font helper; the
    // codepoints are values, and nothing is written.
    unsafe {
        return pledge_font_kern(font.info, ch1, ch2);
    }
}

// ─── Text Measurement ────────────────────────────────────────────────────

/// Measure the width of a text string in pixels.
pub fn font_text_width(font: &Font, text: str) -> i64 {
    if font.info == 0 {
        // Fallback: estimate as char_count * pixel_size * 0.6
        return str_len(text) * (font.scale * 0.6) as i64;
    }
    // SAFETY: font.info is a nonzero font from the pledge_font helper; the
    // helper reads the NUL-terminated text (a Fides str alive for the call)
    // up to its strlen and writes nothing.
    unsafe {
        return pledge_font_text_width(font.info, text);
    }
}

/// Measure the height of a text string (line height * number of lines).
pub fn font_text_height(font: &Font, text: str) -> i64 {
    var lines = 1;
    var i = 0;
    while i < str_len(text) {
        if str_byte_at(text, i) == 10 {
            lines = lines + 1;
        }
        // '\n'
        i = i + 1;
    }
    return lines * font.line_height as i64;
}

// ─── Text Rendering ──────────────────────────────────────────────────────

/// Render a text string to an Image (RGBA pixels, transparent background).
/// The image width is the text width, height is the line height.
pub fn font_render_text(font: &Font, text: str) -> Image {
    var w = font_text_width(font, text);
    var h = font_text_height(font, text);
    if w <= 0 {
        w = 1;
    }
    if h <= 0 {
        h = 1;
    }

    var img = image_create(w, h, 4);
    // Text is drawn over nothing: image_create starts opaque black, which
    // made every pixel the glyphs miss a black one and boxed the text in
    // (release B19). Transparent black, so the image blends over a scene and
    // font_render_text_colored tints only the glyphs.
    image_fill(&mut img, 0, 0, 0, 0);

    if font.info == 0 {
        // Interpreter mode: return blank image
        return img;
    }

    // Render each character
    var cursor_x = 0;
    var cursor_y = font.ascent as i64;
    var i = 0;
    while i < str_len(text) {
        var ch = str_byte_at(text, i);
        if ch == 10 {
            // '\n'
            cursor_x = 0;
            cursor_y = cursor_y + font.line_height as i64;
            i = i + 1;
            continue;
        }

        var glyph = font_get_glyph(font, ch);

        // Blit glyph bitmap to image
        var gy = 0;
        while gy < glyph.height {
            var gx = 0;
            while gx < glyph.width {
                var alpha = glyph.bitmap.get(gy * glyph.width + gx);
                var px = cursor_x + glyph.xoff + gx;
                var py = cursor_y + glyph.yoff + gy;
                if px >= 0 && px < w && py >= 0 && py < h {
                    // White text with alpha from glyph bitmap
                    image_set_pixel(&mut img, px, py, 255, 255, 255, alpha);
                }
                gx = gx + 1;
            }
            gy = gy + 1;
        }

        // Advance cursor
        cursor_x = cursor_x + glyph.advance as i64;

        // Add kerning
        if i + 1 < str_len(text) {
            var next_ch = str_byte_at(text, i + 1);
            cursor_x = cursor_x + font_kern(font, ch, next_ch) as i64;
        }

        i = i + 1;
    }

    return img;
}

/// Render text with a specific color (r, g, b, a).
pub fn font_render_text_colored(font: &Font, text: str, r: i64, g: i64, b: i64, a: i64) -> Image {
    var img = font_render_text(font, text);
    // Tint the image (replace white pixels with the given color)
    var y = 0;
    while y < img.height {
        var x = 0;
        while x < img.width {
            var idx = (y * img.width + x) * 4;
            var alpha = img.data.get(idx + 3);
            if alpha > 0 {
                image_set_pixel(&mut img, x, y, r, g, b, alpha * a / 255);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return img;
}

// ─── Built-in Bitmap Font (fallback, no FFI needed) ───────────────────────
//
// A simple 8x8 bitmap font for ASCII characters. This works in the
// interpreter (no stb_truetype needed) and is useful for debugging.
// Each character is 8 bytes (8 rows of 8 pixels, 1 bit per pixel).

// 8x8 font for ASCII 32-127 (96 characters, 768 bytes)
// Each byte is a row (MSB = leftmost pixel).
// This is a minimal font: space, letters, digits, common punctuation.
// For brevity, only a few characters are defined here; a full font
// would have all 96 printable ASCII characters.

pub const BITMAP_FONT_WIDTH: i64 = 8;
pub const BITMAP_FONT_HEIGHT: i64 = 8;
/// Render a single character using the built-in 8x8 bitmap font.
/// Returns an 8x8 RGBA Image.
///
/// Example:
///   use image;
///   val a = font_bitmap_char(65);
///   assert_eq(a.width, BITMAP_FONT_WIDTH);
///   assert_eq(a.height, 8);
///   assert_eq(image_get_pixel(&a, 2, 0), 0xFFFFFFFF);   // 'A' row 0, x=2 is set
///   assert_eq(image_get_pixel(&a, 0, 0), 0xFF000000);   // unset pixel is opaque black
///   val t = font_bitmap_text("hi");
///   assert_eq(t.width, 16);
// font8x8 (public domain, Daniel Hepper / IBM VGA font). Each glyph is
// packed into one i64: byte r at bits r*8, bit x = column x of row r.
/// Look up a packed font8x8 glyph (byte r at bits r*8, bit x = column).
/// Exposed so renderers can blit glyphs without an Image round trip.
pub fn font8x8_glyph(ch: i64) -> i64 {
    match ch {
        33 => {
            return 0x180018183c3c18;
        }
        34 => {
            return 0x3636;
        }
        35 => {
            return 0x36367f367f3636;
        }
        36 => {
            return 0xc1f301e033e0c;
        }
        37 => {
            return 0x63660c18336300;
        }
        38 => {
            return 0x6e333b6e1c361c;
        }
        39 => {
            return 0x30606;
        }
        40 => {
            return 0x180c0606060c18;
        }
        41 => {
            return 0x60c1818180c06;
        }
        42 => {
            return 0x663cff3c6600;
        }
        43 => {
            return 0xc0c3f0c0c00;
        }
        44 => {
            return 0x60c0c0000000000;
        }
        45 => {
            return 0x3f000000;
        }
        46 => {
            return 0xc0c0000000000;
        }
        47 => {
            return 0x103060c183060;
        }
        48 => {
            return 0x3e676f7b73633e;
        }
        49 => {
            return 0x3f0c0c0c0c0e0c;
        }
        50 => {
            return 0x3f33061c30331e;
        }
        51 => {
            return 0x1e33301c30331e;
        }
        52 => {
            return 0x78307f33363c38;
        }
        53 => {
            return 0x1e3330301f033f;
        }
        54 => {
            return 0x1e33331f03061c;
        }
        55 => {
            return 0xc0c0c1830333f;
        }
        56 => {
            return 0x1e33331e33331e;
        }
        57 => {
            return 0xe18303e33331e;
        }
        58 => {
            return 0xc0c00000c0c00;
        }
        59 => {
            return 0x60c0c00000c0c00;
        }
        60 => {
            return 0x180c0603060c18;
        }
        61 => {
            return 0x3f00003f0000;
        }
        62 => {
            return 0x60c1830180c06;
        }
        63 => {
            return 0xc000c1830331e;
        }
        64 => {
            return 0x1e037b7b7b633e;
        }
        65 => {
            return 0x33333f33331e0c;
        }
        66 => {
            return 0x3f66663e66663f;
        }
        67 => {
            return 0x3c66030303663c;
        }
        68 => {
            return 0x1f36666666361f;
        }
        69 => {
            return 0x7f46161e16467f;
        }
        70 => {
            return 0xf06161e16467f;
        }
        71 => {
            return 0x7c66730303663c;
        }
        72 => {
            return 0x3333333f333333;
        }
        73 => {
            return 0x1e0c0c0c0c0c1e;
        }
        74 => {
            return 0x1e333330303078;
        }
        75 => {
            return 0x6766361e366667;
        }
        76 => {
            return 0x7f66460606060f;
        }
        77 => {
            return 0x63636b7f7f7763;
        }
        78 => {
            return 0x6363737b6f6763;
        }
        79 => {
            return 0x1c36636363361c;
        }
        80 => {
            return 0xf06063e66663f;
        }
        81 => {
            return 0x381e3b3333331e;
        }
        82 => {
            return 0x6766363e66663f;
        }
        83 => {
            return 0x1e33380e07331e;
        }
        84 => {
            return 0x1e0c0c0c0c2d3f;
        }
        85 => {
            return 0x3f333333333333;
        }
        86 => {
            return 0xc1e3333333333;
        }
        87 => {
            return 0x63777f6b636363;
        }
        88 => {
            return 0x63361c1c366363;
        }
        89 => {
            return 0x1e0c0c1e333333;
        }
        90 => {
            return 0x7f664c1831637f;
        }
        91 => {
            return 0x1e06060606061e;
        }
        92 => {
            return 0x406030180c0603;
        }
        93 => {
            return 0x1e18181818181e;
        }
        94 => {
            return 0x63361c08;
        }
        95 => {
            return (0 - 72057594037927936);
        }
        96 => {
            return 0x180c0c;
        }
        97 => {
