        }
        104 => {
            return 0x6766666e360607;
        }
        105 => {
            return 0x1e0c0c0c0e000c;
        }
        106 => {
            return 0x1e33333030300030;
        }
        107 => {
            return 0x67361e36660607;
        }
        108 => {
            return 0x1e0c0c0c0c0c0e;
        }
        109 => {
            return 0x636b7f7f330000;
        }
        110 => {
            return 0x333333331f0000;
        }
        111 => {
            return 0x1e3333331e0000;
        }
        112 => {
            return 0xf063e66663b0000;
        }
        113 => {
            return 0x78303e33336e0000;
        }
        114 => {
            return 0xf06666e3b0000;
        }
        115 => {
            return 0x1f301e033e0000;
        }
        116 => {
            return 0x182c0c0c3e0c08;
        }
        117 => {
            return 0x6e333333330000;
        }
        118 => {
            return 0xc1e3333330000;
        }
        119 => {
            return 0x367f7f6b630000;
        }
        120 => {
            return 0x63361c36630000;
        }
        121 => {
            return 0x1f303e3333330000;
        }
        122 => {
            return 0x3f260c193f0000;
        }
        123 => {
            return 0x380c0c070c0c38;
        }
        124 => {
            return 0x18181800181818;
        }
        125 => {
            return 0x70c0c380c0c07;
        }
        126 => {
            return 0x3b6e;
        }
        _ => {
            return 0;
        }
    }
    return 0;
}

pub fn font_bitmap_char(ch: i64) -> Image {
    var img = image_create(8, 8, 4);
    val glyph: i64 = font8x8_glyph(ch);
    var y = 0;
    while y < 8 {
        val rowbyte: i64 = (glyph >> (y * 8)) & 255;
        var x = 0;
        while x < 8 {
            if ((rowbyte >> x) & 1) != 0 {
                image_set_pixel(&mut img, x, y, 255, 255, 255, 255);
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return img;
}

/// Render text using the built-in 8x8 bitmap font (no FFI needed).
pub fn font_bitmap_text(text: str) -> Image {
    var len = str_len(text);
    if len == 0 {
        return image_create(1, 1, 4);
    }
    var w = len * 8;
    var h = 8;
    var img = image_create(w, h, 4);

    var i = 0;
    while i < len {
        var ch = str_byte_at(text, i);
        var glyph = font_bitmap_char(ch);
        // Blit glyph to image
        var gy = 0;
        while gy < 8 {
            var gx = 0;
            while gx < 8 {
                var idx = (gy * 8 + gx) * 4;
                // a set pixel is white; the background of the glyph is opaque black, so
                // the alpha channel cannot tell them apart (it painted every cell solid)
                var red = glyph.data.get(idx);
                if red > 0 {
                    image_set_pixel(&mut img, i * 8 + gx, gy, 255, 255, 255, 255);
                }
                gx = gx + 1;
            }
            gy = gy + 1;
        }
        i = i + 1;
    }

    return img;
}
