// Fides Mesh standard library
//
// 3D mesh loading from OBJ files. Supports positions, normals,
// texture coordinates, and faces (triangulated). Also provides
// basic mesh manipulation (compute normals, transform).
//
// Usage:
//   use mesh;
//   var m = mesh_load_obj("cube.obj");
//   if m.valid {
//       // m.vertices has positions, m.normals has normals
//       // m.indices has triangle indices
//   }
//
// OBJ format reference: https://en.wikipedia.org/wiki/Wavefront_.obj_file

module mesh;

use vec;
use string;
use math;

// ─── Mesh Data Structures ────────────────────────────────────────────────

pub struct Vertex {
    pub x: f64, pub y: f64, pub z: f64,
}

pub struct TexCoord {
    pub u: f64, pub v: f64,
}

pub struct Face {
    pub v0: i64, pub v1: i64, pub v2: i64,   // vertex indices (0-based)
    pub t0: i64, pub t1: i64, pub t2: i64,   // texcoord indices (-1 if none)
    pub n0: i64, pub n1: i64, pub n2: i64,   // normal indices (-1 if none)
}

pub struct Mesh {
    pub vertices: Vec<Vertex>,     // positions
    pub normals: Vec<Vertex>,       // normals
    pub texcoords: Vec<TexCoord>,  // UV coordinates
    pub faces: Vec<Face>,           // triangles
    pub valid: bool,
    pub name: str,
}

// ─── Mesh Creation ───────────────────────────────────────────────────────

pub fn mesh_create() -> Mesh {
    return Mesh {
        vertices: Vec::new(),
        normals: Vec::new(),
        texcoords: Vec::new(),
        faces: Vec::new(),
        valid: true,
        name: "",
    };
}

/// Create a Vertex.
pub fn vertex_create(x: f64, y: f64, z: f64) -> Vertex {
    return Vertex { x: x, y: y, z: z };
}

/// Create a Face.
pub fn face_create(v0: i64, v1: i64, v2: i64) -> Face {
    return Face {
        v0: v0, v1: v1, v2: v2,
        t0: -1, t1: -1, t2: -1,
        n0: -1, n1: -1, n2: -1,
    };
}

/// Create a cube mesh (24 vertices, 12 triangles).
pub fn mesh_create_cube(size: f64) -> Mesh {
    var m = mesh_create();
    var s = size * 0.5;

    // 8 corners of the cube
    // Front face (z = +s)
    m.vertices.push(Vertex { x: -s, y: -s, z: s });
    m.vertices.push(Vertex { x: s, y: -s, z: s });
    m.vertices.push(Vertex { x: s, y: s, z: s });
    m.vertices.push(Vertex { x: -s, y: s, z: s });

    // Back face (z = -s)
    m.vertices.push(Vertex { x: -s, y: -s, z: -s });
    m.vertices.push(Vertex { x: s, y: -s, z: -s });
    m.vertices.push(Vertex { x: s, y: s, z: -s });
    m.vertices.push(Vertex { x: -s, y: s, z: -s });

    // 12 triangles (2 per face, 6 faces)
    // Front
    m.faces.push(Face { v0: 0, v1: 1, v1: 2, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    m.faces.push(Face { v0: 0, v1: 2, v1: 3, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    // Right
    m.faces.push(Face { v0: 1, v1: 5, v1: 6, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    m.faces.push(Face { v0: 1, v1: 6, v1: 2, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    // Back
    m.faces.push(Face { v0: 5, v1: 4, v1: 7, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    m.faces.push(Face { v0: 5, v1: 7, v1: 6, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    // Left
    m.faces.push(Face { v0: 4, v1: 0, v1: 3, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    m.faces.push(Face { v0: 4, v1: 3, v1: 7, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    // Top
    m.faces.push(Face { v0: 3, v1: 2, v1: 6, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    m.faces.push(Face { v0: 3, v1: 6, v1: 7, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    // Bottom
    m.faces.push(Face { v0: 4, v1: 5, v1: 1, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    m.faces.push(Face { v0: 4, v1: 1, v1: 0, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });

    mesh_compute_normals(&mut m);
    return m;
}

/// Create a plane mesh (in XZ plane, centered at origin).
pub fn mesh_create_plane(width: f64, depth: f64) -> Mesh {
    var m = mesh_create();
    var w = width * 0.5;
    var d = depth * 0.5;

    m.vertices.push(Vertex { x: -w, y: 0.0, z: d });
    m.vertices.push(Vertex { x: w, y: 0.0, z: d });
    m.vertices.push(Vertex { x: w, y: 0.0, z: -d });
    m.vertices.push(Vertex { x: -w, y: 0.0, z: -d });

    m.faces.push(Face { v0: 0, v1: 1, v1: 2, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });
    m.faces.push(Face { v0: 0, v1: 2, v1: 3, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 });

    mesh_compute_normals(&mut m);
    return m;
}

// ─── Helpers ─────────────────────────────────────────────────────────────

/// Get substring from start index to end of string.
fn mesh_str_from(s: str, start: i64) -> str {
    return str_slice(s, start, str_len(s));
}

/// Get substring [start, end).
fn mesh_str_range(s: str, start: i64, end: i64) -> str {
    return str_slice(s, start, end);
}

// ─── OBJ File Loading ────────────────────────────────────────────────────

/// Load a mesh from an OBJ file.
/// In the interpreter, this returns an invalid mesh (no file I/O).
/// In native builds, the runtime reads the file and parses OBJ format.
pub fn mesh_load_obj(path: str) -> Mesh {
    var m = mesh_create();
    m.valid = false;

    // Read the file
    var source = p_file_read(path);
    if (source as i64) == 0 || str_len(source) == 0 {
        return m;
    }

    // Parse line by line
    var lines = str_split(source, "\n");
    var i = 0;
    while i < lines.len() {
        var line = lines.get(i);
        var trimmed = str_trim(line);
        if str_len(trimmed) == 0 {
            i = i + 1;
            continue;
        }

        // Vertex: "v x y z"
        if str_starts_with(trimmed, "v ") {
            var parts = str_split(mesh_str_from(trimmed, 2), " ");
            if parts.len() >= 3 {
                var vx = str_parse_float(parts.get(0));
                var vy = str_parse_float(parts.get(1));
                var vz = str_parse_float(parts.get(2));
                m.vertices.push(Vertex { x: vx, y: vy, z: vz });
            }
        }

        // Normal: "vn x y z"
        if str_starts_with(trimmed, "vn ") {
            var parts = str_split(mesh_str_from(trimmed, 3), " ");
            if parts.len() >= 3 {
                var nx = str_parse_float(parts.get(0));
                var ny = str_parse_float(parts.get(1));
                var nz = str_parse_float(parts.get(2));
                m.normals.push(Vertex { x: nx, y: ny, z: nz });
            }
        }

        // TexCoord: "vt u v"
        if str_starts_with(trimmed, "vt ") {
            var parts = str_split(mesh_str_from(trimmed, 3), " ");
            if parts.len() >= 2 {
                var u = str_parse_float(parts.get(0));
                var v = str_parse_float(parts.get(1));
                m.texcoords.push(TexCoord { u: u, v: v });
            }
        }

        // Face: "f v0/vt0/vn0 v1/vt1/vn1 v2/vt2/vn2"
        // Or simplified: "f v0 v1 v2"
        if str_starts_with(trimmed, "f ") {
            var parts = str_split(mesh_str_from(trimmed, 2), " ");
            if parts.len() >= 3 {
                var f = Face { v0: 0, v1: 0, v1: 0, t0: -1, t1: -1, t2: -1, n0: -1, n1: -1, n2: -1 };

                // Parse each vertex index (may contain v/vt/vn)
                var j = 0;
                while j < 3 {
                    var token = parts.get(j);
                    var slash_idx = str_find(token, "/");
                    if slash_idx < 0 {
                        // Simple: "f v0 v1 v2"
                        var vi = str_parse_int(token) - 1;  // OBJ is 1-based
                        if j == 0 { f.v0 = vi; }
                        if j == 1 { f.v1 = vi; }
                        if j == 2 { f.v2 = vi; }
                    } else {
                        // Complex: "v/vt/vn" or "v//vn" or "v/vt"
                        var vi_str = mesh_str_range(token, 0, slash_idx);
                        var vi = str_parse_int(vi_str) - 1;
                        if j == 0 { f.v0 = vi; }
                        if j == 1 { f.v1 = vi; }
                        if j == 2 { f.v2 = vi; }

                        // Parse texcoord and normal indices
                        var rest = mesh_str_from(token, slash_idx + 1);
                        var slash2 = str_find(rest, "/");
                        if slash2 < 0 {
                            // "v/vt" (no normal)
                            var ti = str_parse_int(rest) - 1;
                            if j == 0 { f.t0 = ti; }
                            if j == 1 { f.t1 = ti; }
                            if j == 2 { f.t2 = ti; }
                        } else {
                            // "v/vt/vn" or "v//vn"
                            if slash2 > 0 {
                                var ti_str = mesh_str_range(rest, 0, slash2);
                                var ti = str_parse_int(ti_str) - 1;
                                if j == 0 { f.t0 = ti; }
                                if j == 1 { f.t1 = ti; }
                                if j == 2 { f.t2 = ti; }
                            }
                            var ni_str = mesh_str_from(rest, slash2 + 1);
                            if str_len(ni_str) > 0 {
                                var ni = str_parse_int(ni_str) - 1;
                                if j == 0 { f.n0 = ni; }
                                if j == 1 { f.n1 = ni; }
                                if j == 2 { f.n2 = ni; }
                            }
                        }
                    }
                    j = j + 1;
                }
                m.faces.push(f);
            }
        }

        i = i + 1;
    }

    m.valid = m.vertices.len() > 0 && m.faces.len() > 0;

    // Compute normals if the OBJ didn't provide them
    if m.normals.len() == 0 && m.valid {
        mesh_compute_normals(&mut m);
    }

    return m;
}

// ─── Mesh Operations ──────────────────────────────────────────────────────

/// Compute per-face normals and store them as per-vertex normals.
/// This is a flat (non-smoothed) normal computation.
pub fn mesh_compute_normals(m: &mut Mesh) -> void {
    m.normals.clear();

    var i = 0;
    while i < m.faces.len() {
        var face = m.faces.get(i);
        if face.v0 < 0 || face.v0 >= m.vertices.len() ||
           face.v1 < 0 || face.v1 >= m.vertices.len() ||
           face.v2 < 0 || face.v2 >= m.vertices.len() {
            i = i + 1;
            continue;
        }

        var v0 = m.vertices.get(face.v0);
        var v1 = m.vertices.get(face.v1);
        var v2 = m.vertices.get(face.v2);

        // Edge vectors
        var ex1 = v1.x - v0.x;
        var ey1 = v1.y - v0.y;
        var ez1 = v1.z - v0.z;
        var ex2 = v2.x - v0.x;
        var ey2 = v2.y - v0.y;
        var ez2 = v2.z - v0.z;

        // Cross product (e1 x e2)
        var nx = ey1 * ez2 - ez1 * ey2;
        var ny = ez1 * ex2 - ex1 * ez2;
        var nz = ex1 * ey2 - ey1 * ex2;

        // Normalize
        var len = pledge_sqrt(nx * nx + ny * ny + nz * nz);
        if len > 0.0 {
            nx = nx / len;
            ny = ny / len;
            nz = nz / len;
        }

        m.normals.push(Vertex { x: nx, y: ny, z: nz });

        // Update face normal indices
        var mut_face = face;
        mut_face.n0 = i;
        mut_face.n1 = i;
        mut_face.n2 = i;
        m.faces.set(i, mut_face);

        i = i + 1;
    }
}

/// Transform all vertices by a mat4.
pub fn mesh_transform(m: &mut Mesh, mat: mat4) -> void {
    var i = 0;
    while i < m.vertices.len() {
        var v = m.vertices.get(i);
        var w = mat.m30 * v.x + mat.m31 * v.y + mat.m32 * v.z + mat.m33;
        if w == 0.0 { w = 1.0; }
        var nv = Vertex {
            x: (mat.m00 * v.x + mat.m01 * v.y + mat.m02 * v.z + mat.m03) / w,
            y: (mat.m10 * v.x + mat.m11 * v.y + mat.m12 * v.z + mat.m13) / w,
            z: (mat.m20 * v.x + mat.m21 * v.y + mat.m22 * v.z + mat.m23) / w,
        };
        m.vertices.set(i, nv);
        i = i + 1;
    }
}

/// Get the number of triangles in the mesh.
pub fn mesh_triangle_count(m: &Mesh) -> i64 {
    return m.faces.len();
}

/// Get the number of vertices in the mesh.
pub fn mesh_vertex_count(m: &Mesh) -> i64 {
    return m.vertices.len();
}

/// Free mesh data.
pub fn mesh_free(m: &mut Mesh) -> void {
    m.vertices.clear();
    m.normals.clear();
    m.texcoords.clear();
    m.faces.clear();
    m.valid = false;
}
