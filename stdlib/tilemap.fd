// Fides Tilemap standard library — Phase 8D (S1)
//
// Tile maps for 2D games: grid-based storage, collision detection,
// and auto-tiling (picks the right sprite based on neighbor rules).
//
// Usage:
//   use tilemap;
//   value tm = tilemap_create(64, 32, 16);  // 64x32 tiles, 16px each
//   tilemap_set(tm, 5, 3, TILE_WALL);
//   value solid = tilemap_is_solid(tm, 5, 3);  // true
//   value tile = tilemap_auto_tile(tm, 5, 3);  // picks corner/edge/inner variant

module tilemap;

// ─── Tile Types ───────────────────────────────────────────────────────────
//
// Tile IDs are i64. 0 = empty. Positive = solid tiles.
// The caller defines what each tile ID means (wall, floor, water, etc.).
// TILE_EMPTY and TILE_WALL are provided as conventions.

pub const TILE_EMPTY: i64 = 0;
pub const TILE_WALL: i64 = 1;
pub const TILE_FLOOR: i64 = 2;
pub const TILE_WATER: i64 = 3;
pub const TILE_GRASS: i64 = 4;
pub const TILE_DIRT: i64 = 5;
pub const TILE_STONE: i64 = 6;
pub const TILE_SAND: i64 = 7;
pub const TILE_LAVA: i64 = 8;
pub const TILE_ICE: i64 = 9;

// ─── Tilemap Struct ───────────────────────────────────────────────────────
//
// Stored as a flat Vec<i64> for cache-friendly iteration.
// index = y * width + x

pub struct Tilemap {
    pub width: i64,
    pub height: i64,
    pub tile_size: i64,       // pixel size of each tile
    pub tiles: Vec<i64>,      // flat grid: tiles[y * width + x]
    pub solid_flags: Vec<i64>, // 1 = solid (blocks movement), 0 = passable
}

// ─── Creation ─────────────────────────────────────────────────────────────

/// Create a new tilemap filled with empty tiles.
pub fn tilemap_create(width: i64, height: i64, tile_size: i64) -> Tilemap {
    val tiles = Vec::new();
    val solid = Vec::new();
    val i = 0;
    while i < width * height {
        tiles.push(TILE_EMPTY);
        solid.push(0);
        i = i + 1;
    }
    return Tilemap {
        width: width,
        height: height,
        tile_size: tile_size,
        tiles: tiles,
        solid_flags: solid,
    };
}

/// Create a tilemap from an existing tile grid (flat Vec<i64>).
pub fn tilemap_from_grid(width: i64, height: i64, tile_size: i64, tiles: Vec<i64>) -> Tilemap {
    val solid = Vec::new();
    val i = 0;
    while i < width * height {
        if i < tiles.len() {
            if tiles.get(i) != TILE_EMPTY {
                solid.push(1);
            } else {
                solid.push(0);
            }
        } else {
            solid.push(0);
        }
        i = i + 1;
    }
    return Tilemap {
        width: width,
        height: height,
        tile_size: tile_size,
        tiles: tiles,
        solid_flags: solid,
    };
}

// ─── Tile Access ──────────────────────────────────────────────────────────

/// Get the tile ID at (x, y). Returns TILE_EMPTY if out of bounds.
pub fn tilemap_get(tm: Tilemap, x: i64, y: i64) -> i64 {
    if x < 0 || x >= tm.width || y < 0 || y >= tm.height {
        return TILE_EMPTY;
    }
    return tm.tiles.get(y * tm.width + x);
}

/// Set the tile ID at (x, y). Does nothing if out of bounds.
/// Updates the solid flag based on the tile ID (non-empty = solid by default).
pub fn tilemap_set(tm: &mut Tilemap, x: i64, y: i64, tile_id: i64) -> void {
    if x < 0 || x >= tm.width || y < 0 || y >= tm.height {
        return;
    }
    val idx = y * tm.width + x;
    tm.tiles.set(idx, tile_id);
    if tile_id == TILE_EMPTY || tile_id == TILE_FLOOR || tile_id == TILE_GRASS {
        tm.solid_flags.set(idx, 0);
    } else {
        tm.solid_flags.set(idx, 1);
    }
}

/// Set the tile ID at (x, y) with explicit solid flag.
pub fn tilemap_set_with_solid(tm: &mut Tilemap, x: i64, y: i64, tile_id: i64, is_solid: bool) -> void {
    if x < 0 || x >= tm.width || y < 0 || y >= tm.height {
        return;
    }
    val idx = y * tm.width + x;
    tm.tiles.set(idx, tile_id);
    if is_solid {
        tm.solid_flags.set(idx, 1);
    } else {
        tm.solid_flags.set(idx, 0);
    }
}

/// Check if a tile is solid (blocks movement).
pub fn tilemap_is_solid(tm: Tilemap, x: i64, y: i64) -> bool {
    if x < 0 || x >= tm.width || y < 0 || y >= tm.height {
        return true; // out of bounds = solid (can't walk off map)
    }
    val s = tm.solid_flags.get(y * tm.width + x);
    return s != 0;
}

/// Check if a tile is passable (not solid and in bounds).
pub fn tilemap_is_passable(tm: Tilemap, x: i64, y: i64) -> bool {
    return !tilemap_is_solid(tm, x, y);
}

/// Get the tile at a pixel position (converts pixels to tile coords).
pub fn tilemap_get_at_pixel(tm: Tilemap, px: i64, py: i64) -> i64 {
    val tile_x = px / tm.tile_size;
    val tile_y = py / tm.tile_size;
    return tilemap_get(tm, tile_x, tile_y);
}

/// Check if a pixel position is solid.
pub fn tilemap_is_solid_at_pixel(tm: Tilemap, px: i64, py: i64) -> bool {
    val tile_x = px / tm.tile_size;
    val tile_y = py / tm.tile_size;
    return tilemap_is_solid(tm, tile_x, tile_y);
}

// ─── Collision Detection ──────────────────────────────────────────────────

/// Check if an axis-aligned bounding box (AABB) collides with any solid tile.
/// (px, py) = top-left corner, (pw, ph) = width/height in pixels.
pub fn tilemap_box_collides(tm: Tilemap, px: i64, py: i64, pw: i64, ph: i64) -> bool {
    // Convert box to tile range
    val x0 = px / tm.tile_size;
    val y0 = py / tm.tile_size;
    val x1 = (px + pw - 1) / tm.tile_size;
    val y1 = (py + ph - 1) / tm.tile_size;

    val tile_y = y0;
    while tile_y <= y1 {
        val tile_x = x0;
        while tile_x <= x1 {
            if tilemap_is_solid(tm, tile_x, tile_y) {
                return true;
            }
            tile_x = tile_x + 1;
        }
        tile_y = tile_y + 1;
    }
    return false;
}

/// Resolve horizontal movement: move px by dx, stopping at solid tiles.
/// Returns the adjusted x position (may be less than px + dx if blocked).
pub fn tilemap_move_x(tm: Tilemap, px: i64, py: i64, pw: i64, ph: i64, dx: i64) -> i64 {
    val new_x = px + dx;
    if tilemap_box_collides(tm, new_x, py, pw, ph) {
        // Snap to tile boundary
        if dx > 0 {
            // Moving right: snap to left edge of the blocking tile
            val tile_x = (new_x + pw) / tm.tile_size;
            return tile_x * tm.tile_size - pw;
        } else {
            // Moving left: snap to right edge of the blocking tile
            val tile_x = new_x / tm.tile_size;
            return (tile_x + 1) * tm.tile_size;
        }
    }
    return new_x;
}

/// Resolve vertical movement: move py by dy, stopping at solid tiles.
/// Returns the adjusted y position.
pub fn tilemap_move_y(tm: Tilemap, px: i64, py: i64, pw: i64, ph: i64, dy: i64) -> i64 {
    val new_y = py + dy;
    if tilemap_box_collides(tm, px, new_y, pw, ph) {
        if dy > 0 {
            // Moving down: snap to top edge of the blocking tile
            val tile_y = (new_y + ph) / tm.tile_size;
            return tile_y * tm.tile_size - ph;
        } else {
            // Moving up: snap to bottom edge of the blocking tile
            val tile_y = new_y / tm.tile_size;
            return (tile_y + 1) * tm.tile_size;
        }
    }
    return new_y;
}

// ─── Auto-Tiling ──────────────────────────────────────────────────────────
//
// Auto-tiling picks the right sprite variant based on which neighbors are
// the same tile type. This produces seamless walls, coastlines, etc.
//
// The result is a bitmask indicating which neighbors match:
//   bit 0 (1) = north neighbor is same
//   bit 1 (2) = south neighbor is same
//   bit 2 (4) = east neighbor is same
//   bit 3 (8) = west neighbor is same
//   bit 4 (16) = northeast neighbor is same
//   bit 5 (32) = northwest neighbor is same
//   bit 6 (64) = southeast neighbor is same
//   bit 7 (128) = southwest neighbor is same
//
// The caller maps this bitmask to a sprite in their atlas.

/// Compute the 8-direction neighbor bitmask for auto-tiling.
pub fn tilemap_auto_tile(tm: Tilemap, x: i64, y: i64) -> i64 {
    val tile = tilemap_get(tm, x, y);
    if tile == TILE_EMPTY {
        return 0;
    }

    val mask = 0;
    // N
    if tilemap_get(tm, x, y - 1) == tile { mask = mask + 1; }
    // S
    if tilemap_get(tm, x, y + 1) == tile { mask = mask + 2; }
    // E
    if tilemap_get(tm, x + 1, y) == tile { mask = mask + 4; }
    // W
    if tilemap_get(tm, x - 1, y) == tile { mask = mask + 8; }
    // NE
    if tilemap_get(tm, x + 1, y - 1) == tile { mask = mask + 16; }
    // NW
    if tilemap_get(tm, x - 1, y - 1) == tile { mask = mask + 32; }
    // SE
    if tilemap_get(tm, x + 1, y + 1) == tile { mask = mask + 64; }
    // SW
    if tilemap_get(tm, x - 1, y + 1) == tile { mask = mask + 128; }
    return mask;
}

/// Get a simplified 4-direction mask (N/S/E/W only) for basic auto-tiling.
pub fn tilemap_auto_tile_4dir(tm: Tilemap, x: i64, y: i64) -> i64 {
    val tile = tilemap_get(tm, x, y);
    if tile == TILE_EMPTY {
        return 0;
    }

    val mask = 0;
    if tilemap_get(tm, x, y - 1) == tile { mask = mask + 1; }
    if tilemap_get(tm, x, y + 1) == tile { mask = mask + 2; }
    if tilemap_get(tm, x + 1, y) == tile { mask = mask + 4; }
    if tilemap_get(tm, x - 1, y) == tile { mask = mask + 8; }
    return mask;
}

// ─── Fill Operations ──────────────────────────────────────────────────────

/// Fill a rectangular region with a tile ID.
pub fn tilemap_fill_rect(tm: &mut Tilemap, x0: i64, y0: i64, x1: i64, y1: i64, tile_id: i64) -> void {
    val y = y0;
    while y <= y1 {
        val x = x0;
        while x <= x1 {
            tilemap_set(tm, x, y, tile_id);
            x = x + 1;
        }
        y = y + 1;
    }
}

/// Fill the entire map with one tile.
pub fn tilemap_fill_all(tm: &mut Tilemap, tile_id: i64) -> void {
    tilemap_fill_rect(tm, 0, 0, tm.width - 1, tm.height - 1, tile_id);
}

/// Fill the border (edges) of the map with a tile ID.
pub fn tilemap_fill_border(tm: &mut Tilemap, tile_id: i64) -> void {
    val x = 0;
    while x < tm.width {
        tilemap_set(tm, x, 0, tile_id);
        tilemap_set(tm, x, tm.height - 1, tile_id);
        x = x + 1;
    }
    val y = 0;
    while y < tm.height {
        tilemap_set(tm, 0, y, tile_id);
        tilemap_set(tm, tm.width - 1, y, tile_id);
        y = y + 1;
    }
}

/// Count tiles of a specific type.
pub fn tilemap_count_tile(tm: Tilemap, tile_id: i64) -> i64 {
    val count = 0;
    val i = 0;
    while i < tm.tiles.len() {
        if tm.tiles.get(i) == tile_id {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/// Count all solid tiles.
pub fn tilemap_count_solid(tm: Tilemap) -> i64 {
    val count = 0;
    val i = 0;
    while i < tm.solid_flags.len() {
        if tm.solid_flags.get(i) != 0 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

// ─── Line of Sight (Bresenham) ────────────────────────────────────────────

/// Check if there's a clear line of sight between two tiles (no solid tiles in between).
/// Uses Bresenham's line algorithm.
pub fn tilemap_line_of_sight(tm: Tilemap, x0: i64, y0: i64, x1: i64, y1: i64) -> bool {
    val dx = x1 - x0;
    val dy = y1 - y0;
    val abs_dx = dx;
    if abs_dx < 0 { abs_dx = -abs_dx; }
    val abs_dy = dy;
    if abs_dy < 0 { abs_dy = -abs_dy; }

    val sx = 1;
    if dx < 0 { sx = -1; }
    val sy = 1;
    if dy < 0 { sy = -1; }

    val err = abs_dx - abs_dy;
    val x = x0;
    val y = y0;

    while true {
        // Don't check the start tile itself
        if !(x == x0 && y == y0) {
            if tilemap_is_solid(tm, x, y) {
                return false;
            }
        }
        if x == x1 && y == y1 {
            return true;
        }
        val e2 = 2 * err;
        if e2 > -abs_dy {
            err = err - abs_dy;
            x = x + sx;
        }
        if e2 < abs_dx {
            err = err + abs_dx;
            y = y + sy;
        }
    }
    return true;
}
