// Fides QPACK (RFC 9204): field compression for HTTP/3, static table only
//
// QPACK is HPACK (stdlib/hpack.fd) rearranged for QUIC's independent
// streams. This module implements the part HTTP/3 needs when an endpoint
// advertises SETTINGS_QPACK_MAX_TABLE_CAPACITY 0, which stdlib/http3.fd
// does: no dynamic table in either direction.
//   - The static table of Appendix A (99 entries, indexes 0..98).
//   - Field sections (§4.5): the prefix (Required Insert Count and Base,
//     both 0 here), indexed field lines and literal field lines with a
//     static name reference or a literal name, integers with an N-bit
//     prefix, string literals raw or with the Huffman code of RFC 7541
//     Appendix B (RFC 9204 §4.1 reuses HPACK's), rebuilt here from its
//     code lengths (the code is canonical).
//   - The decoder rejects what needs a dynamic table (a non-zero Required
//     Insert Count, dynamic or post-base references) with
//     QPACK_DECOMPRESSION_FAILED, and a section over the size limit
//     (RFC 9114 §4.2.2: names, values and 32 bytes per line).
//   - The encoder- and decoder-stream instructions a peer may send (§4.3,
//     §4.4) are checked against a table of capacity 0: Set Dynamic Table
//     Capacity 0 and Stream Cancellation are fine, every insertion, a
//     duplicate, a larger capacity, a Section Acknowledgment and an Insert
//     Count Increment are errors (QPACK_ENCODER_STREAM_ERROR,
//     QPACK_DECODER_STREAM_ERROR).
//
// Bytes are Vec<i64>, one value 0..255 each. A field list is two parallel
// Vec<str>, names and values.
//
//   val block: Vec<i64> = qpack_encode(names, values, true);
//   val got: QpackFields = qpack_decode(block, 65536);
//   if got.ok { println(got.names.get(0) + ": " + got.values.get(0)); }
//
// Checked by tests/bootstrap/test_stdlib_qpack.fd (RFC 9204 Appendix B.1,
// every static entry, Huffman literals, the errors).

module qpack;
 use vec; use string;

/// QPACK error codes (RFC 9204 §6), sent as HTTP/3 application errors.
pub const QPACK_DECOMPRESSION_FAILED: i64 = 0x200;
pub const QPACK_ENCODER_STREAM_ERROR: i64 = 0x201;
pub const QPACK_DECODER_STREAM_ERROR: i64 = 0x202;

/// The static table has 99 entries, 0..98 (Appendix A).
pub const QPACK_STATIC_LEN: i64 = 99;

/// Results of scanning an encoder or decoder stream.
pub const QPACK_SCAN_OK: i64 = 0;
pub const QPACK_SCAN_MORE: i64 = 1;
pub const QPACK_SCAN_ERROR: i64 = 2;

/// A decoded field section. `ok` false: `error` is the QPACK error code
/// (QPACK_DECOMPRESSION_FAILED), or -1 with `too_large` when the section
/// is over the size limit (an HTTP/3 message error, not a QPACK one);
/// `why` says what was wrong. `size` is the section's size by RFC 9114
/// §4.2.2.
pub struct QpackFields {
    pub ok: bool,
    pub error: i64,
    pub too_large: bool,
    pub why: str,
    pub names: Vec<str>,
    pub values: Vec<str>,
    pub size: i64,
}

/// What an encoder- or decoder-stream scan found: QPACK_SCAN_OK when
/// every instruction from `from` was complete and allowed (`used` bytes),
/// QPACK_SCAN_MORE when the last one is cut short (`used` covers the
/// complete ones before it), QPACK_SCAN_ERROR with the code in `error`.
pub struct QpackScan {
    pub status: i64,
    pub used: i64,
    pub error: i64,
    pub why: str,
}

// ─── Static table (Appendix A) ─────────────────────────────────────────

