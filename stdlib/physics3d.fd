// Fides 3D Physics standard library
//
// 3D collision detection and rigid body dynamics.
// Supports sphere, AABB (box), and plane colliders.
// Provides broad-phase (brute force), narrow-phase (SAT for boxes),
// and a simple impulse-based solver.
//
// Usage:
//   use physics3d;
//   use math;
//
//   var body = phys3d_create_body(vec3(0,10,0), vec3(1,1,1), 1.0);
//   phys3d_set_gravity(vec3(0,-9.81,0));
//
//   while running {
//       phys3d_step(&mut body, dt);
//       if phys3d_check_sphere_plane(body, ground) {
//           phys3d_resolve_collision(&mut body, ...);
//       }
//   }

module physics3d;

use vec;
use math;

// ─── Collider Types ──────────────────────────────────────────────────────

pub const COLLIDER_SPHERE: i64 = 0;
pub const COLLIDER_BOX: i64 = 1;
pub const COLLIDER_PLANE: i64 = 2;

pub struct Sphere {
    pub center: vec3,
    pub radius: f64,
}

pub struct Aabb3 {
    pub min: vec3,
    pub max: vec3,
}

pub struct Plane3 {
    pub normal: vec3,
    pub distance: f64,    // distance from origin along normal
}

// ─── Rigid Body ──────────────────────────────────────────────────────────

pub struct RigidBody3 {
    pub position: vec3,
    pub velocity: vec3,
    pub acceleration: vec3,
    pub force: vec3,          // accumulated force
    pub mass: f64,
    pub inv_mass: f64,        // 1/mass (0 = static)
    pub restitution: f64,     // bounciness (0-1)
    pub friction: f64,         // friction coefficient (0-1)
    pub is_static: bool,
    pub collider_type: i64,
    pub sphere: Sphere,
    pub box: Aabb3,
    pub radius: f64,           // for sphere collider
    pub half_extents: vec3,   // for box collider
}

pub fn phys3d_create_body(pos: vec3, half_ext: vec3, mass: f64) -> RigidBody3 {
    var inv_mass = 0.0;
    if mass > 0.0 { inv_mass = 1.0 / mass; }
    return RigidBody3 {
        position: pos,
        velocity: vec3(0.0, 0.0, 0.0),
        acceleration: vec3(0.0, 0.0, 0.0),
        force: vec3(0.0, 0.0, 0.0),
        mass: mass,
        inv_mass: inv_mass,
        restitution: 0.5,
        friction: 0.3,
        is_static: mass == 0.0,
        collider_type: COLLIDER_BOX,
        sphere: Sphere { center: pos, radius: half_ext.x },
        box: Aabb3 {
            min: pos.sub(half_ext),
            max: pos.add(half_ext),
        },
        radius: half_ext.x,
        half_extents: half_ext,
    };
}

pub fn phys3d_create_sphere(pos: vec3, radius: f64, mass: f64) -> RigidBody3 {
    var inv_mass = 0.0;
    if mass > 0.0 { inv_mass = 1.0 / mass; }
    return RigidBody3 {
        position: pos,
        velocity: vec3(0.0, 0.0, 0.0),
        acceleration: vec3(0.0, 0.0, 0.0),
        force: vec3(0.0, 0.0, 0.0),
        mass: mass,
        inv_mass: inv_mass,
        restitution: 0.5,
        friction: 0.3,
        is_static: mass == 0.0,
        collider_type: COLLIDER_SPHERE,
        sphere: Sphere { center: pos, radius: radius },
        box: Aabb3 { min: pos, max: pos },
        radius: radius,
        half_extents: vec3(0.0, 0.0, 0.0),
    };
}

pub fn phys3d_create_static_plane(normal: vec3, distance: f64) -> RigidBody3 {
    return RigidBody3 {
        position: normal.scale(distance),
        velocity: vec3(0.0, 0.0, 0.0),
        acceleration: vec3(0.0, 0.0, 0.0),
        force: vec3(0.0, 0.0, 0.0),
        mass: 0.0,
        inv_mass: 0.0,
        restitution: 0.5,
        friction: 0.8,
        is_static: true,
        collider_type: COLLIDER_PLANE,
        sphere: Sphere { center: vec3(0.0, 0.0, 0.0), radius: 0.0 },
        box: Aabb3 { min: vec3(0.0, 0.0, 0.0), max: vec3(0.0, 0.0, 0.0) },
        radius: 0.0,
        half_extents: vec3(0.0, 0.0, 0.0),
    };
}

// ─── Forces ───────────────────────────────────────────────────────────────

var g_gravity_x: f64 = 0.0;
var g_gravity_y: f64 = -9.81;
var g_gravity_z: f64 = 0.0;

pub fn phys3d_set_gravity(g: vec3) -> void {
    g_gravity_x = g.x;
    g_gravity_y = g.y;
    g_gravity_z = g.z;
}

pub fn phys3d_get_gravity() -> vec3 {
    return vec3(g_gravity_x, g_gravity_y, g_gravity_z);
}

pub fn phys3d_apply_force(body: &mut RigidBody3, force: vec3) -> void {
    body.force = body.force.add(force);
}

pub fn phys3d_apply_impulse(body: &mut RigidBody3, impulse: vec3) -> void {
    if body.inv_mass == 0.0 { return; }
    body.velocity = body.velocity.add(impulse.scale(body.inv_mass));
}

pub fn phys3d_apply_gravity(body: &mut RigidBody3, dt: f64) -> void {
    if body.is_static { return; }
    body.velocity = body.velocity.add(vec3(g_gravity_x, g_gravity_y, g_gravity_z).scale(dt));
}

// ─── Integration ─────────────────────────────────────────────────────────

pub fn phys3d_step(body: &mut RigidBody3, dt: f64) -> void {
    if body.is_static { return; }

    // Apply gravity
    phys3d_apply_gravity(body, dt);

    // Apply accumulated force
    body.acceleration = body.force.scale(body.inv_mass);
    body.velocity = body.velocity.add(body.acceleration.scale(dt));

    // Update position
    body.position = body.position.add(body.velocity.scale(dt));

    // Clear force
    body.force = vec3(0.0, 0.0, 0.0);

    // Update collider positions
    if body.collider_type == COLLIDER_SPHERE {
        body.sphere.center = body.position;
    } else if body.collider_type == COLLIDER_BOX {
        body.box.min = body.position.sub(body.half_extents);
        body.box.max = body.position.add(body.half_extents);
    }
}

// ─── Collision Detection ─────────────────────────────────────────────────

pub struct Contact3 {
    pub normal: vec3,       // collision normal (from A to B)
    pub depth: f64,         // penetration depth
    pub point: vec3,        // contact point
    pub has_contact: bool,
}

// Sphere vs Sphere
pub fn phys3d_sphere_vs_sphere(a: &RigidBody3, b: &RigidBody3) -> Contact3 {
    var contact = Contact3 {
        normal: vec3(0.0, 0.0, 0.0),
        depth: 0.0,
        point: vec3(0.0, 0.0, 0.0),
        has_contact: false,
    };

    var delta = b.position.sub(a.position);
    var dist = delta.length();
    var sum_radii = a.radius + b.radius;

    if dist < sum_radii {
        contact.has_contact = true;
        if dist > 0.0001 {
            contact.normal = delta.scale(1.0 / dist);
        } else {
            contact.normal = vec3(0.0, 1.0, 0.0);
        }
        contact.depth = sum_radii - dist;
        contact.point = a.position.add(contact.normal.scale(a.radius));
    }

    return contact;
}

// AABB vs AABB
pub fn phys3d_aabb_vs_aabb(a: &RigidBody3, b: &RigidBody3) -> Contact3 {
    var contact = Contact3 {
        normal: vec3(0.0, 0.0, 0.0),
        depth: 0.0,
        point: vec3(0.0, 0.0, 0.0),
        has_contact: false,
    };

    var a_min = a.position.sub(a.half_extents);
    var a_max = a.position.add(a.half_extents);
    var b_min = b.position.sub(b.half_extents);
    var b_max = b.position.add(b.half_extents);

    // Check overlap on each axis
    var dx1 = b_max.x - a_min.x;
    var dx2 = a_max.x - b_min.x;
    var dy1 = b_max.y - a_min.y;
    var dy2 = a_max.y - b_min.y;
    var dz1 = b_max.z - a_min.z;
    var dz2 = a_max.z - b_min.z;

    if dx1 < 0.0 || dx2 < 0.0 || dy1 < 0.0 || dy2 < 0.0 || dz1 < 0.0 || dz2 < 0.0 {
        return contact;  // no overlap
    }

    // Find minimum overlap axis (SAT for AABB)
    var min_x = dx1;
    if dx2 < min_x { min_x = dx2; }
    var min_y = dy1;
    if dy2 < min_y { min_y = dy2; }
    var min_z = dz1;
    if dz2 < min_z { min_z = dz2; }

    contact.has_contact = true;

    if min_x < min_y && min_x < min_z {
        contact.depth = min_x;
        if dx1 < dx2 {
            contact.normal = vec3(-1.0, 0.0, 0.0);
        } else {
            contact.normal = vec3(1.0, 0.0, 0.0);
        }
    } else if min_y < min_z {
        contact.depth = min_y;
        if dy1 < dy2 {
            contact.normal = vec3(0.0, -1.0, 0.0);
        } else {
            contact.normal = vec3(0.0, 1.0, 0.0);
        }
    } else {
        contact.depth = min_z;
        if dz1 < dz2 {
            contact.normal = vec3(0.0, 0.0, -1.0);
        } else {
            contact.normal = vec3(0.0, 0.0, 1.0);
        }
    }

    contact.point = a.position.add(b.position).scale(0.5);
    return contact;
}

// Sphere vs Plane
pub fn phys3d_sphere_vs_plane(sphere: &RigidBody3, plane: &RigidBody3) -> Contact3 {
    var contact = Contact3 {
        normal: vec3(0.0, 0.0, 0.0),
        depth: 0.0,
        point: vec3(0.0, 0.0, 0.0),
        has_contact: false,
    };

    // Plane normal and distance (stored in position for static plane)
    var normal = plane.position.normalize();
    var plane_dist = plane.position.length();

    // Distance from sphere center to plane
    var along: f64 = sphere.position.dot(normal);  // a typed local: inline, the interpreter and PE lose the f64 type
    var dist = along - plane_dist;

    if dist < sphere.radius {
        contact.has_contact = true;
        contact.normal = normal.scale(-1.0);  // from plane to sphere
        contact.depth = sphere.radius - dist;
        contact.point = sphere.position.sub(normal.scale(dist));
    }

    return contact;
}

// Sphere vs AABB
pub fn phys3d_sphere_vs_aabb(sphere: &RigidBody3, box_body: &RigidBody3) -> Contact3 {
    var contact = Contact3 {
        normal: vec3(0.0, 0.0, 0.0),
        depth: 0.0,
        point: vec3(0.0, 0.0, 0.0),
        has_contact: false,
    };

    var box_min = box_body.position.sub(box_body.half_extents);
    var box_max = box_body.position.add(box_body.half_extents);

    // Closest point on AABB to sphere center
    var cx = sphere.position.x;
    if cx < box_min.x { cx = box_min.x; }
    if cx > box_max.x { cx = box_max.x; }
    var cy = sphere.position.y;
    if cy < box_min.y { cy = box_min.y; }
    if cy > box_max.y { cy = box_max.y; }
    var cz = sphere.position.z;
    if cz < box_min.z { cz = box_min.z; }
    if cz > box_max.z { cz = box_max.z; }

    var closest = vec3(cx, cy, cz);
    var delta = sphere.position.sub(closest);
    var dist = delta.length();

    if dist < sphere.radius {
        contact.has_contact = true;
        if dist > 0.0001 {
            contact.normal = delta.scale(1.0 / dist);
        } else {
            // Sphere center inside box — push out along smallest axis
            var to_center = sphere.position.sub(box_body.position);
            contact.normal = to_center.normalize();
        }
        contact.depth = sphere.radius - dist;
        contact.point = closest;
    }

    return contact;
}

// ─── Collision Resolution (Impulse-based) ────────────────────────────────

pub fn phys3d_resolve_contact(a: &mut RigidBody3, b: &mut RigidBody3, contact: &Contact3) -> void {
    if !contact.has_contact { return; }

    // Positional correction (push apart to avoid sinking)
    var percent = 0.8;   // correction percentage
    var slop = 0.01;       // penetration slop
    var correction = contact.normal.scale(
        math_max_f64(0.0, contact.depth - slop) * percent /
        (a.inv_mass + b.inv_mass)
    );

    if !a.is_static {
        a.position = a.position.sub(correction.scale(a.inv_mass));
    }
    if !b.is_static {
        b.position = b.position.add(correction.scale(b.inv_mass));
    }

    // Impulse resolution
    var rel_vel = b.velocity.sub(a.velocity);
    var vel_along_normal = rel_vel.dot(contact.normal);

    if vel_along_normal > 0.0 { return; }  // separating

    var e = math_min_f64(a.restitution, b.restitution);
    var j = -(1.0 + e) * vel_along_normal / (a.inv_mass + b.inv_mass);

    var impulse = contact.normal.scale(j);

    if !a.is_static {
        a.velocity = a.velocity.sub(impulse.scale(a.inv_mass));
    }
    if !b.is_static {
        b.velocity = b.velocity.add(impulse.scale(b.inv_mass));
    }

    // Friction (tangential impulse)
    rel_vel = b.velocity.sub(a.velocity);
    var tangent = rel_vel.sub(contact.normal.scale(rel_vel.dot(contact.normal)));
    var tan_len = tangent.length();
    if tan_len > 0.0001 {
        tangent = tangent.scale(1.0 / tan_len);
    }

    var vel_along_tangent = rel_vel.dot(tangent);
    var jt = -vel_along_tangent / (a.inv_mass + b.inv_mass);

    var friction_coef = math_sqrt(a.friction * b.friction);

    // Coulomb friction limit
    if math_fabs(jt) < j * friction_coef {
        var friction_impulse = tangent.scale(jt);
        if !a.is_static {
            a.velocity = a.velocity.sub(friction_impulse.scale(a.inv_mass));
        }
        if !b.is_static {
            b.velocity = b.velocity.add(friction_impulse.scale(b.inv_mass));
        }
    } else {
        var friction_impulse = tangent.scale(-j * friction_coef);
        if !a.is_static {
            a.velocity = a.velocity.sub(friction_impulse.scale(a.inv_mass));
        }
        if !b.is_static {
            b.velocity = b.velocity.add(friction_impulse.scale(b.inv_mass));
        }
    }
}

// ─── Broad Phase (Brute Force) ────────────────────────────────────────────

pub fn phys3d_check_collision(a: &RigidBody3, b: &RigidBody3) -> Contact3 {
    if a.collider_type == COLLIDER_SPHERE && b.collider_type == COLLIDER_SPHERE {
        return phys3d_sphere_vs_sphere(a, b);
    }
    if a.collider_type == COLLIDER_SPHERE && b.collider_type == COLLIDER_BOX {
        return phys3d_sphere_vs_aabb(a, b);
    }
    if a.collider_type == COLLIDER_BOX && b.collider_type == COLLIDER_SPHERE {
        var c = phys3d_sphere_vs_aabb(b, a);
        c.normal = c.normal.scale(-1.0);
        return c;
    }
    if a.collider_type == COLLIDER_BOX && b.collider_type == COLLIDER_BOX {
        return phys3d_aabb_vs_aabb(a, b);
    }
    if a.collider_type == COLLIDER_SPHERE && b.collider_type == COLLIDER_PLANE {
        return phys3d_sphere_vs_plane(a, b);
    }
    if a.collider_type == COLLIDER_PLANE && b.collider_type == COLLIDER_SPHERE {
        var c = phys3d_sphere_vs_plane(b, a);
        c.normal = c.normal.scale(-1.0);
        return c;
    }

    return Contact3 {
        normal: vec3(0.0, 0.0, 0.0),
        depth: 0.0,
        point: vec3(0.0, 0.0, 0.0),
        has_contact: false,
    };
}

/// Resolve all collisions in a list of bodies (brute force, O(n^2)).
pub fn phys3d_resolve_all(bodies: &mut Vec<RigidBody3>, dt: f64) -> void {
    // Step all bodies
    var i = 0;
    while i < bodies.len() {
        var body = bodies.get(i);
        phys3d_step(&mut body, dt);
        bodies.set(i, body);
        i = i + 1;
    }

    // Check all pairs
    i = 0;
    while i < bodies.len() {
        var j = i + 1;
        while j < bodies.len() {
            var a = bodies.get(i);
            var b = bodies.get(j);
            var contact = phys3d_check_collision(&a, &b);
            if contact.has_contact {
                phys3d_resolve_contact(&mut a, &mut b, &contact);
                bodies.set(i, a);
                bodies.set(j, b);
            }
            j = j + 1;
        }
        i = i + 1;
    }
}
