// Fides ARINC 653 standard library
//
// ARINC 653 is the avionics standard for partitioned real-time systems.
// It defines a time-partitioned, space-partitioned execution model where
// multiple applications (partitions) run on the same hardware without
// interfering with each other. Each partition has its own memory space
// and a guaranteed time slice in a cyclic schedule.
//
// This module provides the ARINC 653 API as Fides functions. The actual
// partitioning enforcement is done by the OS/hypervisor (e.g., VxWorks
// 653, PikeOS, INTEGRITY-178). This library is the application-level API
// that partitions use to communicate.
//
// In Fides, the @safety-critical (F44) and @dal-a (F56) annotations
// ensure that code using this module is allocation-free, recursion-free,
// crash-free, and audited — exactly what DO-178C DAL-A requires.
//
// Usage:
//   use arinc
//   fn main() {
//       val port = arinc_queuing_port_create("DISPLAY_Q", 32, 64,
//                       ARINC_PORT_SOURCE, ARINC_PORT_FIFO);
//       arinc_queuing_port_send(port, [0x01, 0x02, 0x03]);
//       val msg = arinc_queuing_port_receive(port);
//   }

module arinc;

// ─── ARINC 653 Partition States ────────────────────────────────────────

/// Partition states per ARINC 653 specification.
pub const ARINC_PARTITION_NORMAL: i64       = 0;
pub const ARINC_PARTITION_IDLE: i64         = 1;
pub const ARINC_PARTITION_COLD_START: i64   = 2;
pub const ARINC_PARTITION_WARM_START: i64   = 3;
pub const ARINC_PARTITION_STOP: i64         = 4;

/// Get the name of a partition state.
pub fn arinc_partition_state_name(state: i64) -> str {
    if state == ARINC_PARTITION_NORMAL      { return "NORMAL"; }
    if state == ARINC_PARTITION_IDLE        { return "IDLE"; }
    if state == ARINC_PARTITION_COLD_START  { return "COLD_START"; }
    if state == ARINC_PARTITION_WARM_START  { return "WARM_START"; }
    if state == ARINC_PARTITION_STOP        { return "STOP"; }
    return "UNKNOWN";
}

// ─── ARINC 653 Port Types ──────────────────────────────────────────────

/// Port directions
pub const ARINC_PORT_SOURCE: i64      = 0;
pub const ARINC_PORT_DESTINATION: i64 = 1;

/// Port disciplines (queuing ports)
pub const ARINC_PORT_FIFO: i64        = 0;
pub const ARINC_PORT_PRIORITY: i64    = 1;

/// Port status codes
pub const ARINC_NO_ERROR: i64                 = 0;
pub const ARINC_NOT_AVAILABLE: i64            = 1;
pub const ARINC_INVALID_PARAM: i64            = 2;
pub const ARINC_INVALID_CONFIG: i64           = 3;
pub const ARINC_INVALID_MODE: i64             = 4;
pub const ARINC_INVALID_POINTER: i64          = 5;
pub const ARINC_INVALID_SIZE: i64             = 6;
pub const ARINC_TOO_MANY_OBJECTS: i64         = 7;
pub const ARINC_NOT_AVAILABLE_PART: i64       = 8;
pub const ARINC_NO_ACTION: i64                = 9;
pub const ARINC_TIME_OUT: i64                 = 10;
pub const ARINC_QUEUE_EMPTY: i64              = 11;
pub const ARINC_QUEUE_FULL: i64               = 12;
pub const ARINC_PORT_FULL: i64                = 13;
pub const ARINC_PORT_EMPTY: i64               = 14;

/// Get the name of an ARINC error code.
pub fn arinc_error_name(code: i64) -> str {
    if code == ARINC_NO_ERROR             { return "NO_ERROR"; }
    if code == ARINC_NOT_AVAILABLE        { return "NOT_AVAILABLE"; }
    if code == ARINC_INVALID_PARAM        { return "INVALID_PARAM"; }
    if code == ARINC_INVALID_CONFIG       { return "INVALID_CONFIG"; }
    if code == ARINC_INVALID_MODE         { return "INVALID_MODE"; }
    if code == ARINC_INVALID_POINTER      { return "INVALID_POINTER"; }
    if code == ARINC_INVALID_SIZE         { return "INVALID_SIZE"; }
    if code == ARINC_TOO_MANY_OBJECTS     { return "TOO_MANY_OBJECTS"; }
    if code == ARINC_NOT_AVAILABLE_PART   { return "NOT_AVAILABLE_PART"; }
    if code == ARINC_NO_ACTION            { return "NO_ACTION"; }
    if code == ARINC_TIME_OUT             { return "TIME_OUT"; }
    if code == ARINC_QUEUE_EMPTY          { return "QUEUE_EMPTY"; }
    if code == ARINC_QUEUE_FULL           { return "QUEUE_FULL"; }
    if code == ARINC_PORT_FULL            { return "PORT_FULL"; }
    if code == ARINC_PORT_EMPTY           { return "PORT_EMPTY"; }
    return "UNKNOWN_ERROR";
}

// ─── Queuing Port (Inter-Partition Communication) ──────────────────────
//
// Queuing ports provide FIFO/priority message passing between partitions.
// Messages are fixed-size. The port has a bounded queue depth.
//
// This is a pure-Fides implementation using Vec for the message queue.
// In a real ARINC 653 system, the APEX (APplication EXecutive) provides
// these as OS calls. This library is the application-level abstraction.

/// A queuing port for inter-partition communication.
/// Messages are stored as flat byte arrays with length prefixes.
/// Since Vec stores i64 values, we use a flat buffer approach:
///   msg_lengths: Vec of message lengths (one per message)
///   msg_data:    Vec of all message bytes (concatenated)
///   msg_offsets: Vec of byte offsets into msg_data (start of each message)
pub struct QueuingPort {
    pub name: str,
    pub direction: i64,
    pub discipline: i64,
    pub max_message_size: i64,
    pub max_nb_message: i64,
    pub msg_lengths: Vec<i64>,
    pub msg_data: Vec<i64>,
    pub msg_offsets: Vec<i64>,
    pub count: i64,
    pub data_tail: i64,
}

/// Create a queuing port.
/// name: Port name (must be unique within the partition)
/// direction: ARINC_PORT_SOURCE or ARINC_PORT_DESTINATION
/// discipline: ARINC_PORT_FIFO or ARINC_PORT_PRIORITY
/// max_message_size: Maximum message size in bytes
/// max_nb_message: Maximum number of messages in the queue
pub fn arinc_queuing_port_create(name: str, max_nb_message: i64,
                                  max_message_size: i64, direction: i64,
                                  discipline: i64) -> QueuingPort {
    return QueuingPort {
        name: name,
        direction: direction,
        discipline: discipline,
        max_message_size: max_message_size,
        max_nb_message: max_nb_message,
        msg_lengths: Vec::new(),
        msg_data: Vec::new(),
        msg_offsets: Vec::new(),
        count: 0,
        data_tail: 0,
    };
}

/// Send a message through a queuing port.
/// Returns ARINC_NO_ERROR on success, ARINC_PORT_FULL if the queue is full.
pub fn arinc_queuing_port_send(port: &mut QueuingPort, message: Vec<i64>) -> i64 {
    if port.count >= port.max_nb_message {
        return ARINC_PORT_FULL;
    }
    var len = message.len();
    port.msg_lengths.push(len);
    port.msg_offsets.push(port.data_tail);
    for i in 0..len {
        port.msg_data.push(message.get(i));
    }
    port.data_tail = port.data_tail + len;
    port.count = port.count + 1;
    return ARINC_NO_ERROR;
}

/// Receive a message from a queuing port.
/// Returns the message as a Vec of bytes, or an empty Vec if empty.
/// Reads the first (oldest) message. Does not remove from queue
/// (Fides Vec API limitation — use count to track depth).
pub fn arinc_queuing_port_receive(port: QueuingPort) -> Vec<i64> {
    if port.count == 0 {
        return Vec::new();
    }
    var len = port.msg_lengths.get(0);
    var offset = port.msg_offsets.get(0);
    var result = Vec::new();
    for i in 0..len {
        result.push(port.msg_data.get(offset + i));
    }
    return result;
}

/// Get the number of messages currently in the queue.
pub fn arinc_queuing_port_count(port: QueuingPort) -> i64 {
    return port.count;
}

/// Check if the queuing port is empty.
pub fn arinc_queuing_port_is_empty(port: QueuingPort) -> bool {
    return port.count == 0;
}

/// Check if the queuing port is full.
pub fn arinc_queuing_port_is_full(port: QueuingPort) -> bool {
    return port.count >= port.max_nb_message;
}

/// Get the port name.
pub fn arinc_queuing_port_name(port: QueuingPort) -> str {
    return port.name;
}

// ─── Sampling Port (Latest-Value Communication) ────────────────────────
//
// Sampling ports hold only the latest message. New writes overwrite old
// data. A validity flag indicates whether the data is fresh (updated within
// the refresh period). This is used for periodic sensor data.

/// A sampling port for latest-value inter-partition communication.
pub struct SamplingPort {
    pub name: str,
    pub direction: i64,
    pub max_message_size: i64,
    pub refresh_period: i64,
    pub last_message: Vec<i64>,
    pub valid: bool,
    pub last_update_time: i64,
}

/// Create a sampling port.
/// refresh_period: Time in milliseconds after which data is considered stale.
pub fn arinc_sampling_port_create(name: str, max_message_size: i64,
                                   direction: i64, refresh_period: i64) -> SamplingPort {
    return SamplingPort {
        name: name,
        direction: direction,
        max_message_size: max_message_size,
        refresh_period: refresh_period,
        last_message: Vec::new(),
        valid: false,
        last_update_time: 0,
    };
}

/// Write a message to a sampling port (overwrites previous).
pub fn arinc_sampling_port_write(port: &mut SamplingPort, message: Vec<i64>,
                                  current_time: i64) -> i64 {
    port.last_message = message;
    port.valid = true;
    port.last_update_time = current_time;
    return ARINC_NO_ERROR;
}

/// Read the current message from a sampling port.
/// Returns the message Vec (may be empty if no data written).
/// Use arinc_sampling_port_is_valid to check freshness.
pub fn arinc_sampling_port_read(port: SamplingPort) -> Vec<i64> {
    return port.last_message;
}

/// Check if the sampling port has valid (fresh) data.
pub fn arinc_sampling_port_is_valid(port: SamplingPort, current_time: i64) -> bool {
    var age = current_time - port.last_update_time;
    return port.valid && age <= port.refresh_period;
}

/// Invalidate the sampling port data (mark as stale).
pub fn arinc_sampling_port_invalidate(port: &mut SamplingPort) -> void {
    port.valid = false;
}

/// Get the port name.
pub fn arinc_sampling_port_name(port: SamplingPort) -> str {
    return port.name;
}

// ─── Partition Management ──────────────────────────────────────────────
//
// In ARINC 653, partitions are scheduled by the OS in a cyclic schedule.
// The application code queries partition state and can request state
// transitions. This library provides the API; the OS enforces the schedule.

/// Partition information.
pub struct PartitionInfo {
    pub name: str,
    pub state: i64,
    pub period: i64,        // in milliseconds
    pub duration: i64,      // in milliseconds (time slice per period)
    pub time_capacity: i64, // WCET budget in milliseconds
}

/// Create partition info.
pub fn arinc_partition_create(name: str, period: i64, duration: i64,
                               time_capacity: i64) -> PartitionInfo {
    return PartitionInfo {
        name: name,
        state: ARINC_PARTITION_COLD_START,
        period: period,
        duration: duration,
        time_capacity: time_capacity,
    };
}

/// Get the current partition state.
pub fn arinc_partition_state(part: PartitionInfo) -> i64 {
    return part.state;
}

/// Set the partition state (state transition).
/// In a real system, this is an OS call. Here it's a struct update.
pub fn arinc_partition_set_state(part: &mut PartitionInfo, state: i64) -> void {
    part.state = state;
}

/// Get the partition period (ms).
pub fn arinc_partition_period(part: PartitionInfo) -> i64 {
    return part.period;
}

/// Get the partition duration (ms per period).
pub fn arinc_partition_duration(part: PartitionInfo) -> i64 {
    return part.duration;
}

/// Get the partition time capacity (WCET budget in ms).
pub fn arinc_partition_time_capacity(part: PartitionInfo) -> i64 {
    return part.time_capacity;
}

/// Get the partition name.
pub fn arinc_partition_name(part: PartitionInfo) -> str {
    return part.name;
}

// ─── Time Management ───────────────────────────────────────────────────
//
// ARINC 653 provides a timed wait primitive that suspends the partition
// until the next period. In a real ARINC 653 system, these are APEX OS
// calls. In Fides, the application should use the Fides runtime's
// p_time_ms() and p_sleep() directly, or implement periodic waits via
// the effect system. These stubs are omitted to keep the library
// portable across interpreter and C codegen backends.

// ─── Health Monitoring ─────────────────────────────────────────────────
//
// ARINC 653 health monitoring detects and handles errors at the partition
// level. Errors are categorized by severity and can trigger recovery
// actions (e.g., partition restart).

/// Health monitoring error levels
pub const ARINC_HM_LEVEL_MODULE: i64     = 0;
pub const ARINC_HM_LEVEL_PARTITION: i64  = 1;
pub const ARINC_HM_LEVEL_PROCESS: i64    = 2;

/// Health monitoring error types
pub const ARINC_HM_ERROR_MEMORY: i64         = 0;
pub const ARINC_HM_ERROR_PROGRAM: i64        = 1;
pub const ARINC_HM_ERROR_TIME: i64           = 2;
pub const ARINC_HM_ERROR_IO: i64             = 3;
pub const ARINC_HM_ERROR_POWER: i64          = 4;
pub const ARINC_HM_ERROR_FREE_RUN: i64       = 5;
pub const ARINC_HM_ERROR_APPLICATION: i64    = 6;

/// Health monitoring recovery actions
pub const ARINC_HM_ACTION_IGNORE: i64            = 0;
pub const ARINC_HM_ACTION_PROCESS_RESTART: i64   = 1;
pub const ARINC_HM_ACTION_PARTITION_RESTART: i64 = 2;
pub const ARINC_HM_ACTION_PARTITION_STOP: i64    = 3;
pub const ARINC_HM_ACTION_MODULE_RESET: i64      = 4;
pub const ARINC_HM_ACTION_MODULE_STOP: i64       = 5;

/// A health monitoring event.
pub struct HealthEvent {
    pub level: i64,
    pub error_type: i64,
    pub action: i64,
    pub partition_name: str,
    pub timestamp: i64,
}

/// Create a health monitoring event.
pub fn arinc_hm_event(level: i64, error_type: i64, action: i64,
                      partition_name: str, timestamp: i64) -> HealthEvent {
    return HealthEvent {
        level: level,
        error_type: error_type,
        action: action,
        partition_name: partition_name,
        timestamp: timestamp,
    };
}

/// Get the error level name.
pub fn arinc_hm_level_name(level: i64) -> str {
    if level == ARINC_HM_LEVEL_MODULE    { return "MODULE"; }
    if level == ARINC_HM_LEVEL_PARTITION { return "PARTITION"; }
    if level == ARINC_HM_LEVEL_PROCESS   { return "PROCESS"; }
    return "UNKNOWN";
}

/// Get the error type name.
pub fn arinc_hm_error_name(error_type: i64) -> str {
    if error_type == ARINC_HM_ERROR_MEMORY       { return "MEMORY"; }
    if error_type == ARINC_HM_ERROR_PROGRAM      { return "PROGRAM"; }
    if error_type == ARINC_HM_ERROR_TIME         { return "TIME"; }
    if error_type == ARINC_HM_ERROR_IO           { return "IO"; }
    if error_type == ARINC_HM_ERROR_POWER        { return "POWER"; }
    if error_type == ARINC_HM_ERROR_FREE_RUN     { return "FREE_RUN"; }
    if error_type == ARINC_HM_ERROR_APPLICATION  { return "APPLICATION"; }
    return "UNKNOWN";
}

/// Get the recovery action name.
pub fn arinc_hm_action_name(action: i64) -> str {
    if action == ARINC_HM_ACTION_IGNORE            { return "IGNORE"; }
    if action == ARINC_HM_ACTION_PROCESS_RESTART   { return "PROCESS_RESTART"; }
    if action == ARINC_HM_ACTION_PARTITION_RESTART { return "PARTITION_RESTART"; }
    if action == ARINC_HM_ACTION_PARTITION_STOP    { return "PARTITION_STOP"; }
    if action == ARINC_HM_ACTION_MODULE_RESET      { return "MODULE_RESET"; }
    if action == ARINC_HM_ACTION_MODULE_STOP       { return "MODULE_STOP"; }
    return "UNKNOWN";
}

/// Print a health monitoring event.
pub fn arinc_hm_event_print(event: HealthEvent) -> void {
    print("[HM] Level:");
    print(arinc_hm_level_name(event.level));
    print(" Error:");
    print(arinc_hm_error_name(event.error_type));
    print(" Action:");
    print(arinc_hm_action_name(event.action));
    print(" Partition:");
    print(event.partition_name);
    print(" Time:");
    print(event.timestamp);
    print("\n");
}

// ─── Cyclic Schedule Definition ────────────────────────────────────────
//
// The ARINC 653 cyclic schedule defines which partition runs in which
// time slot. This is a static schedule defined at integration time.
// This library provides the data structures for defining schedules.

/// A schedule entry: one partition's time slot in the cyclic schedule.
pub struct ScheduleEntry {
    pub partition_name: str,
    pub start_time: i64,    // offset from cycle start (ms)
    pub duration: i64,      // time slice duration (ms)
}

/// A cyclic schedule: a list of partition time slots.
/// Uses parallel arrays since Vec stores i64 values.
pub struct CyclicSchedule {
    pub partition_names: Vec<str>,   // Vec of str (partition names)
    pub start_times: Vec<i64>,       // Vec of i64 (start offsets in ms)
    pub durations: Vec<i64>,         // Vec of i64 (time slice durations in ms)
    pub cycle_length: i64,      // total cycle duration (ms)
}

/// Create a schedule entry (returned for inspection, not stored in Vec).
pub fn arinc_schedule_entry(partition_name: str, start_time: i64,
                             duration: i64) -> ScheduleEntry {
    return ScheduleEntry {
        partition_name: partition_name,
        start_time: start_time,
        duration: duration,
    };
}

/// Create a cyclic schedule.
pub fn arinc_cyclic_schedule(cycle_length: i64) -> CyclicSchedule {
    return CyclicSchedule {
        partition_names: Vec::new(),
        start_times: Vec::new(),
        durations: Vec::new(),
        cycle_length: cycle_length,
    };
}

/// Add a partition time slot to the schedule.
pub fn arinc_schedule_add_entry(schedule: &mut CyclicSchedule, entry: ScheduleEntry) -> void {
    schedule.partition_names.push(entry.partition_name);
    schedule.start_times.push(entry.start_time);
    schedule.durations.push(entry.duration);
}

/// Get the number of entries in the schedule.
pub fn arinc_schedule_count(schedule: CyclicSchedule) -> i64 {
    return schedule.start_times.len();
}

/// Get the cycle length (ms).
pub fn arinc_schedule_cycle_length(schedule: CyclicSchedule) -> i64 {
    return schedule.cycle_length;
}

/// Find which partition should be running at a given time offset.
/// Returns the partition name, or "" if no partition is scheduled.
pub fn arinc_schedule_partition_at(schedule: CyclicSchedule, time_offset: i64) -> str {
    var n = arinc_schedule_count(schedule);
    for i in 0..n {
        var start = schedule.start_times.get(i);
        var dur = schedule.durations.get(i);
        var end = start + dur;
        if time_offset >= start && time_offset < end {
            return schedule.partition_names.get(i);
        }
    }
    return "";
}

/// Print the cyclic schedule.
pub fn arinc_schedule_print(schedule: CyclicSchedule) -> void {
    var n = arinc_schedule_count(schedule);
    print("ARINC 653 Cyclic Schedule (cycle: ");
    print(schedule.cycle_length);
    print("ms)\n");
    for i in 0..n {
        var name = schedule.partition_names.get(i);
        var start = schedule.start_times.get(i);
        var dur = schedule.durations.get(i);
        print("  ");
        print(name);
        print(": start=");
        print(start);
        print("ms dur=");
        print(dur);
        print("ms\n");
    }
}
