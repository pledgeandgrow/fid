// Stdlib module: privacy test
// Defines a struct with private fields that should not be accessible
// from other modules.

struct PrivCounter {
    pub value: i64,    // public — readable from anywhere
    count: i64,        // private — only accessible from within this module
}

impl PrivCounter {
    pub pf new() -> PrivCounter {
        ret PrivCounter { value: 0, count: 0 };
    }

    pub pf increment(self: PrivCounter) -> PrivCounter {
        ret PrivCounter { value: self.value + 1, count: self.count + 1 };
    }

    pub pf get_count(self: PrivCounter) -> i64 {
        ret self.count;
    }
}
