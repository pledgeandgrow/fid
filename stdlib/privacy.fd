// Stdlib module: privacy
// Field-level privacy test struct (PrivCounter), plus the consent API that
// is the audited release for @sensitive data (roadmap CO7): @sensitive
// values cannot reach output sinks, and the only sanctioned way out is a
// function that checks consent at runtime — privacy::release.

struct PrivCounter {
    pub value: i64,    // public — readable from anywhere
    count: i64,        // private — only accessible from within this module
}

impl PrivCounter {
    pub fn new() -> PrivCounter {
        return PrivCounter { value: 0, count: 0 };
    }

    pub fn increment(self: PrivCounter) -> PrivCounter {
        return PrivCounter { value: self.value + 1, count: self.count + 1 };
    }

    pub fn get_count(self: PrivCounter) -> i64 {
        return self.count;
    }
}

// ─── Consent (roadmap CO7) ───────────────────────────────────────────────
// A Consent token says `subject` agreed to `purpose`. Only consent_grant
// makes one; consent_revoke withdraws it. The registry is the source of
// truth, so a token goes stale the moment consent is revoked.

struct Consent {
    subject: str,
    purpose: str,
}

var consent_registry: i64 = 0;   // HashMap with integer keys (the *_i functions): hash(subject|purpose) -> 1

fn consent_key(subject: str, purpose: str) -> i64 {
    return p_str_hash(subject as i64) ^ p_str_hash(purpose as i64);
}

/// Record that `subject` consents to `purpose`; returns the token.
pub fn consent_grant(subject: str, purpose: str) -> Consent {
    if consent_registry == 0 { consent_registry = HashMap_new(); }
    HashMap_insert_i(consent_registry, consent_key(subject, purpose), 1);
    return Consent { subject: subject, purpose: purpose };
}

/// Withdraw `subject`'s consent for `purpose`.
pub fn consent_revoke(subject: str, purpose: str) {
    if consent_registry == 0 { return; }
    HashMap_remove_i(consent_registry, consent_key(subject, purpose));
}

/// True while `subject` consents to `purpose`.
pub fn consent_given(subject: str, purpose: str) -> bool {
    if consent_registry == 0 { return false; }
    return HashMap_get_or_i(consent_registry, consent_key(subject, purpose), 0) != 0;
}

/// The audited release for @sensitive data: checks consent at runtime and
/// returns the plain value, or panics when consent was never granted (or
/// was revoked). Marked @declassify, so callers may output the result.
@declassify
pub fn release<T>(c: Consent, @sensitive x: T) -> T {
    if !consent_given(c.subject, c.purpose) {
        p_panic("privacy::release: no consent for '" + c.purpose + "' from '" + c.subject + "'");
    }
    return x;
}
