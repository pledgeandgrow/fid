// Fides PEM: the textual armor of RFC 7468 (base64 between
// "-----BEGIN <label>-----" and "-----END <label>-----" lines, 64
// characters per line), and the key containers found inside it:
// PKCS#8 PrivateKeyInfo / OneAsymmetricKey (RFC 5208, RFC 5958) for RSA,
// EC (with the inner SEC1 ECPrivateKey of RFC 5915), Ed25519 and X25519
// (RFC 8410); SubjectPublicKeyInfo (RFC 5280 §4.1.2.7); and recognition
// of the encrypted forms: EncryptedPrivateKeyInfo (the PBES2 algorithm is
// named, not decrypted) and PKCS#12 PFX files (RFC 7292), detected only.
//
// Pure computation over text and DER bytes, no platform seam. Decoding is
// strict: the END label must match the BEGIN label, the body must be
// valid base64, and RFC 1421 header lines ("Proc-Type: ...") are kept
// apart from the data. Bytes are Vec<i64>.
//
// Checked against RFC 8410's PEM examples and OpenSSL-made keys in
// tests/bootstrap/test_std_pem.fd.
//
// Usage:
//   use pem;
//   val blocks = pem_decode_all(text);
//   val k = pkcs8_parse(blocks.get(0).der);       // k.alg_name == "Ed25519"
//   val text2 = pem_encode("PRIVATE KEY", pkcs8_encode_ed25519(seed));

module pem;
use vec;
use string;
use encoding;
use asn1;

/// One armored block: its label, any RFC 1421 header lines (joined with
/// "\n"), and the decoded bytes.
pub struct PemBlock {
    pub ok: bool,
    pub label: str,
    pub headers: str,
    pub der: Vec<i64>,
}

pub const PEM_OID_RSA: str = "1.2.840.113549.1.1.1";
pub const PEM_OID_RSA_PSS: str = "1.2.840.113549.1.1.10";
pub const PEM_OID_EC: str = "1.2.840.10045.2.1";
pub const PEM_OID_ED25519: str = "1.3.101.112";
pub const PEM_OID_X25519: str = "1.3.101.110";
pub const PEM_OID_ED448: str = "1.3.101.113";
pub const PEM_OID_P256: str = "1.2.840.10045.3.1.7";
pub const PEM_OID_P384: str = "1.3.132.0.34";
pub const PEM_OID_P521: str = "1.3.132.0.35";
pub const PEM_OID_PBES2: str = "1.2.840.113549.1.5.13";
pub const PEM_OID_PKCS7_DATA: str = "1.2.840.113549.1.7.1";
pub const PEM_OID_PKCS7_SIGNED: str = "1.2.840.113549.1.7.2";

/// A readable name of a key or curve OID ("" when unknown).
pub fn pem_oid_name(oid: str) -> str {
    if str_equal(oid, PEM_OID_RSA) { return "RSA"; }
    if str_equal(oid, PEM_OID_RSA_PSS) { return "RSASSA-PSS"; }
    if str_equal(oid, PEM_OID_EC) { return "EC"; }
    if str_equal(oid, PEM_OID_ED25519) { return "Ed25519"; }
    if str_equal(oid, PEM_OID_X25519) { return "X25519"; }
    if str_equal(oid, PEM_OID_ED448) { return "Ed448"; }
    if str_equal(oid, PEM_OID_P256) { return "P-256"; }
    if str_equal(oid, PEM_OID_P384) { return "P-384"; }
    if str_equal(oid, PEM_OID_P521) { return "P-521"; }
    if str_equal(oid, PEM_OID_PBES2) { return "PBES2"; }
    return "";
}

// ─── Armor ─────────────────────────────────────────────────────────────

/// Armor DER bytes: base64 in lines of 64 characters, "\n" line ends.
pub fn pem_encode(label: str, der: Vec<i64>) -> str {
    val b: str = b64_encode_bytes(der);
    var out: str = "-----BEGIN " + label + "-----\n";
    var i: i64 = 0;
    val n: i64 = str_len(b);
    while i < n {
        var j: i64 = i + 64;
        if j > n { j = n; }
        out = out + str_slice(b, i, j) + "\n";
        i = j;
    }
    return out + "-----END " + label + "-----\n";
}

fn pem_bad() -> PemBlock {
    return PemBlock { ok: false, label: "", headers: "", der: Vec::new() };
}

fn pem_strip_cr(s: str) -> str {
    return str_trim(s);
}

/// Every block in a text, in order. Text outside blocks is ignored (as
/// RFC 7468 allows explanatory text); a malformed block is returned with
/// ok false so the caller can see that something was there.
pub fn pem_decode_all(text: str) -> Vec<PemBlock> {
    var out: Vec<PemBlock> = Vec::new();
    val lines: Vec<str> = str_lines(text);
    var i: i64 = 0;
    while i < lines.len() {
        val line: str = pem_strip_cr(lines.get(i));
        if str_starts_with(line, "-----BEGIN ") && str_ends_with(line, "-----") && str_len(line) >= 16 {
            val label: str = str_slice(line, 11, str_len(line) - 5);
            val end_line: str = "-----END " + label + "-----";
            var body: str = "";
            var headers: str = "";
            var in_headers: bool = true;
            var closed: bool = false;
            var good: bool = true;
            i = i + 1;
            while i < lines.len() && !closed {
                val l: str = pem_strip_cr(lines.get(i));
                if str_equal(l, end_line) {
                    closed = true;
                } else if str_starts_with(l, "-----") {
                    // Another BEGIN or a mismatched END: this block is broken.
                    good = false;
                    closed = true;
                    i = i - 1;
                } else if in_headers && str_contains(l, ":") {
                    if str_len(headers) > 0 { headers = headers + "\n"; }
                    headers = headers + l;
                } else {
                    in_headers = false;
                    body = body + l;
                }
                i = i + 1;
            }
            if !closed || !good || !b64_valid(body) || str_len(body) == 0 {
                var bad: PemBlock = pem_bad();
                bad.label = label;
                out.push(bad);
            } else {
                out.push(PemBlock { ok: true, label: label, headers: headers, der: b64_decode_bytes(body) });
            }
        } else {
            i = i + 1;
        }
    }
    return out;
}

/// The first well-formed block with the given label ("" = any label).
pub fn pem_decode(text: str, label: str) -> PemBlock {
    val all: Vec<PemBlock> = pem_decode_all(text);
    var i: i64 = 0;
    while i < all.len() {
        val b: PemBlock = all.get(i);
        if b.ok && (str_len(label) == 0 || str_equal(b.label, label)) {
            return b;
        }
        i = i + 1;
    }
    return pem_bad();
}

/// Whether a block uses legacy RFC 1421 encryption (OpenSSL's
/// "Proc-Type: 4,ENCRYPTED" header).
pub fn pem_is_legacy_encrypted(b: PemBlock) -> bool {
    return str_contains(b.headers, "ENCRYPTED");
}

// ─── AlgorithmIdentifier and SubjectPublicKeyInfo ──────────────────────

/// SubjectPublicKeyInfo: algorithm OID, parameter OID (the curve of an EC
/// key; "" otherwise) and the public key bytes (the BIT STRING content:
/// RSAPublicKey DER, a SEC1 point, or 32 raw bytes for Ed25519/X25519).
pub struct Spki {
    pub ok: bool,
    pub alg: str,
    pub params: str,
    pub key: Vec<i64>,
}

fn spki_bad() -> Spki {
    return Spki { ok: false, alg: "", params: "", key: Vec::new() };
}

/// The OID of an AlgorithmIdentifier SEQUENCE and its OID parameter ("" if
/// absent or NULL or not an OID), as two strings joined by a space.
pub fn pem_alg_id(buf: & Vec<i64>, t: Asn1Tlv) -> str {
    if !asn1_is(t, ASN1_SEQUENCE) { return ""; }
    val kids: Vec<Asn1Tlv> = asn1_children(buf, t);
    if kids.len() < 1 || !asn1_is(kids.get(0), ASN1_OID) { return ""; }
    var s: str = asn1_get_oid(buf, kids.get(0));
    if kids.len() >= 2 && asn1_is(kids.get(1), ASN1_OID) {
        s = s + " " + asn1_get_oid(buf, kids.get(1));
    }
    return s;
}

fn pem_first_word(s: str) -> str {
    val k: i64 = str_find(s, " ");
    if k < 0 { return s; }
    return str_slice(s, 0, k);
}

fn pem_second_word(s: str) -> str {
    val k: i64 = str_find(s, " ");
    if k < 0 { return ""; }
    return str_slice(s, k + 1, str_len(s));
}

/// Parse a SubjectPublicKeyInfo element inside a larger buffer.
pub fn spki_parse_at(buf: & Vec<i64>, t: Asn1Tlv) -> Spki {
    if !asn1_is(t, ASN1_SEQUENCE) { return spki_bad(); }
    val kids: Vec<Asn1Tlv> = asn1_children(buf, t);
    if kids.len() != 2 || !asn1_is(kids.get(1), ASN1_BIT_STRING) { return spki_bad(); }
    val a: str = pem_alg_id(buf, kids.get(0));
    if str_len(a) == 0 { return spki_bad(); }
    if asn1_bits_unused(buf, kids.get(1)) != 0 { return spki_bad(); }
    return Spki { ok: true, alg: pem_first_word(a), params: pem_second_word(a), key: asn1_get_bits(buf, kids.get(1)) };
}

/// Parse a DER SubjectPublicKeyInfo (a "PUBLIC KEY" PEM block).
pub fn spki_parse(der: Vec<i64>) -> Spki {
    val t: Asn1Tlv = asn1_read_der(& der, 0, der.len());
    if !t.ok || t.end != der.len() { return spki_bad(); }
    return spki_parse_at(& der, t);
}

fn pem_alg_seq(oid: str, params: str) -> Vec<i64> {
    if str_len(params) == 0 {
        return asn1_enc_seq(asn1_enc_oid(oid));
    }
    return asn1_enc_seq(asn1_cat(asn1_enc_oid(oid), asn1_enc_oid(params)));
}

/// Encode a SubjectPublicKeyInfo (params "" for none; RSA keys get the
/// NULL parameter RFC 3279 requires).
pub fn spki_encode(alg: str, params: str, key: Vec<i64>) -> Vec<i64> {
    var a: Vec<i64> = pem_alg_seq(alg, params);
    if str_equal(alg, PEM_OID_RSA) {
        a = asn1_enc_seq(asn1_cat(asn1_enc_oid(alg), asn1_enc_null()));
    }
    return asn1_enc_seq(asn1_cat(a, asn1_enc_bits(key, 0)));
}

// ─── PKCS#8 ────────────────────────────────────────────────────────────

/// A PKCS#8 private key. `key` is the privateKey OCTET STRING content;
/// `secret` is the raw secret it wraps (Ed25519/X25519 seed, EC scalar;
/// for RSA the RSAPrivateKey DER, same as key); `public_key` is the public
/// key when the container carries one (OneAsymmetricKey [1], or the SEC1
/// publicKey of an EC key).
pub struct Pkcs8Key {
    pub ok: bool,
    pub version: i64,
    pub alg: str,
    pub alg_name: str,
    pub params: str,
    pub key: Vec<i64>,
    pub secret: Vec<i64>,
    pub public_key: Vec<i64>,
}

fn pkcs8_bad() -> Pkcs8Key {
    return Pkcs8Key {
        ok: false, version: 0, alg: "", alg_name: "", params: "",
        key: Vec::new(), secret: Vec::new(), public_key: Vec::new()
    };
}

/// Parse a DER PrivateKeyInfo / OneAsymmetricKey ("PRIVATE KEY" block).
pub fn pkcs8_parse(der: Vec<i64>) -> Pkcs8Key {
    val t: Asn1Tlv = asn1_read_der(& der, 0, der.len());
    if !asn1_is(t, ASN1_SEQUENCE) || t.end != der.len() { return pkcs8_bad(); }
    val kids: Vec<Asn1Tlv> = asn1_children(& der, t);
    if kids.len() < 3 || !asn1_is(kids.get(0), ASN1_INTEGER) || !asn1_is(kids.get(2), ASN1_OCTET_STRING) {
        return pkcs8_bad();
    }
    val version: i64 = asn1_get_int(& der, kids.get(0));
    if version != 0 && version != 1 { return pkcs8_bad(); }
    val a: str = pem_alg_id(& der, kids.get(1));
    if str_len(a) == 0 { return pkcs8_bad(); }
    var k: Pkcs8Key = pkcs8_bad();
    k.version = version;
    k.alg = pem_first_word(a);
    k.params = pem_second_word(a);
    k.alg_name = pem_oid_name(k.alg);
    k.key = asn1_content(& der, kids.get(2));
    var i: i64 = 3;
    while i < kids.len() {
        val e: Asn1Tlv = kids.get(i);
        if asn1_is_ctx(e, 1) && version == 1 {
            // publicKey [1] IMPLICIT BIT STRING: unused-bits byte, then bits.
            k.public_key = asn1_slice(& der, e.off + 1, e.off + e.len);
        }
        i = i + 1;
    }
    val inner: Vec<i64> = k.key;
    if str_equal(k.alg, PEM_OID_ED25519) || str_equal(k.alg, PEM_OID_X25519) || str_equal(k.alg, PEM_OID_ED448) {
        // CurvePrivateKey ::= OCTET STRING (RFC 8410 §7).
        val c: Asn1Tlv = asn1_read_der(& inner, 0, inner.len());
        if !asn1_is(c, ASN1_OCTET_STRING) || c.end != inner.len() { return pkcs8_bad(); }
        k.secret = asn1_content(& inner, c);
    } else if str_equal(k.alg, PEM_OID_EC) {
        // ECPrivateKey ::= SEQUENCE { 1, OCTET STRING, [0] params, [1] pub }.
        val e: Asn1Tlv = asn1_read_der(& inner, 0, inner.len());
        if !asn1_is(e, ASN1_SEQUENCE) { return pkcs8_bad(); }
        val ek: Vec<Asn1Tlv> = asn1_children(& inner, e);
        if ek.len() < 2 || asn1_get_int(& inner, ek.get(0)) != 1 || !asn1_is(ek.get(1), ASN1_OCTET_STRING) {
            return pkcs8_bad();
        }
        k.secret = asn1_content(& inner, ek.get(1));
        var j: i64 = 2;
        while j < ek.len() {
            val x: Asn1Tlv = ek.get(j);
            if asn1_is_ctx(x, 0) && str_len(k.params) == 0 {
                val p: Asn1Tlv = asn1_read(& inner, x.off, x.off + x.len);
                if asn1_is(p, ASN1_OID) { k.params = asn1_get_oid(& inner, p); }
            }
            if asn1_is_ctx(x, 1) {
                val bs: Asn1Tlv = asn1_read(& inner, x.off, x.off + x.len);
                if asn1_is(bs, ASN1_BIT_STRING) { k.public_key = asn1_get_bits(& inner, bs); }
            }
            j = j + 1;
        }
    } else {
        k.secret = inner;
    }
    k.ok = true;
    return k;
}

/// PKCS#8 v1 (RFC 8410) for a 32-byte Ed25519 seed.
pub fn pkcs8_encode_ed25519(seed: Vec<i64>) -> Vec<i64> {
    return pkcs8_encode(PEM_OID_ED25519, "", asn1_enc_octets(seed));
}

/// PKCS#8 v1 for a 32-byte X25519 private key.
pub fn pkcs8_encode_x25519(secret: Vec<i64>) -> Vec<i64> {
    return pkcs8_encode(PEM_OID_X25519, "", asn1_enc_octets(secret));
}

/// PKCS#8 v1 around an algorithm's private key bytes (`private_key` is
/// the content of the privateKey OCTET STRING).
pub fn pkcs8_encode(alg: str, params: str, private_key: Vec<i64>) -> Vec<i64> {
    var a: Vec<i64> = pem_alg_seq(alg, params);
    if str_equal(alg, PEM_OID_RSA) {
        a = asn1_enc_seq(asn1_cat(asn1_enc_oid(alg), asn1_enc_null()));
    }
    return asn1_enc_seq(asn1_cat(asn1_cat(asn1_enc_int(0), a), asn1_enc_octets(private_key)));
}

/// PKCS#8 for an EC key: the SEC1 ECPrivateKey with its public point.
pub fn pkcs8_encode_ec(curve_oid: str, scalar: Vec<i64>, public_point: Vec<i64>) -> Vec<i64> {
    var inner: Vec<i64> = asn1_cat(asn1_enc_int(1), asn1_enc_octets(scalar));
    if public_point.len() > 0 {
        inner = asn1_cat(inner, asn1_enc_explicit(1, asn1_enc_bits(public_point, 0)));
    }
    return pkcs8_encode(PEM_OID_EC, curve_oid, asn1_enc_seq(inner));
}

// ─── Encrypted containers (recognized, not decrypted) ──────────────────

/// The encryption scheme OID of an EncryptedPrivateKeyInfo ("ENCRYPTED
/// PRIVATE KEY" block), or "" when the bytes are not one.
pub fn pkcs8_encryption_alg(der: Vec<i64>) -> str {
    val t: Asn1Tlv = asn1_read_der(& der, 0, der.len());
    if !asn1_is(t, ASN1_SEQUENCE) || t.end != der.len() { return ""; }
    val kids: Vec<Asn1Tlv> = asn1_children(& der, t);
    if kids.len() != 2 || !asn1_is(kids.get(1), ASN1_OCTET_STRING) { return ""; }
    return pem_first_word(pem_alg_id(& der, kids.get(0)));
}

/// Whether DER bytes have the shape of a PKCS#12 PFX: SEQUENCE { INTEGER
/// 3, ContentInfo { data or signedData OID, [0] ... }, ... }.
pub fn pem_is_pkcs12(der: Vec<i64>) -> bool {
    val t: Asn1Tlv = asn1_read(& der, 0, der.len());
    if !asn1_is(t, ASN1_SEQUENCE) { return false; }
    val kids: Vec<Asn1Tlv> = asn1_children(& der, t);
    if kids.len() < 2 || !asn1_is(kids.get(0), ASN1_INTEGER) || asn1_get_int(& der, kids.get(0)) != 3 {
        return false;
    }
    if !asn1_is(kids.get(1), ASN1_SEQUENCE) { return false; }
    val ci: Vec<Asn1Tlv> = asn1_children(& der, kids.get(1));
    if ci.len() < 2 || !asn1_is(ci.get(0), ASN1_OID) || !asn1_is_ctx(ci.get(1), 0) { return false; }
    val oid: str = asn1_get_oid(& der, ci.get(0));
    return str_equal(oid, PEM_OID_PKCS7_DATA) || str_equal(oid, PEM_OID_PKCS7_SIGNED);
}
