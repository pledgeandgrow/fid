// Fides X25519 (RFC 7748 §5) and the field arithmetic mod p = 2^255 - 19
// that ed25519.fd shares.
//
// Pure Fides, no bigint: a field element is ten signed limbs in radix
// 2^25.5 (26, 25, 26, 25, ... bits; the ref10 layout). Every operation
// below returns a carried element (|even limb| <= 2^25, |odd limb| <= 2^24,
// roughly), so the largest product sum in f25_mul is below 2^60 and i64
// arithmetic never overflows: no @wrapping needed, and the checked
// arithmetic of the language never panics here.
//
// Constant time. What is constant time:
//   - f25_add/sub/mul/sq/neg/mul_small/select/invert and the X25519 ladder:
//     straight-line code or loops with a fixed trip count, no branch and no
//     memory index that depends on a secret. Swaps use an arithmetic mask
//     (f25_select), never `if`.
//   - x25519_scalarmult runs 255 ladder steps whatever the scalar.
// What is not, or not promised:
//   - The compiler gives no constant-time guarantee for generated code: the
//     overflow checks of + - * are branches (never taken here, and not on a
//     secret), and the C compiler or the native backend may in principle
//     turn mask arithmetic into branches. Multiplication latency is assumed
//     constant (true on current x86-64 / AArch64 cores).
//   - f25_from_bytes / f25_to_bytes index bytes by public positions only.
//   - The interpreter (`fid run`) is not constant time at all.
//   - Vec<i64> byte buffers are heap memory that is not wiped.
//
// Usage:
//   use x25519;
//   val pk = x25519_public_key(sk);              // sk: 32 random bytes
//   val k  = x25519_shared_secret(sk, peer_pk);  // Option: None if all-zero
//   val u  = x25519_scalarmult(scalar, u_coord); // raw RFC 7748 function
// Bytes are Vec<i64> of values 0..255 (as in tls_crypto.fd).
//
// tls_crypto.fd keeps its older bigint `x25519`; this module's names do not
// collide with it.

module x25519;

use vec;

/// A field element mod 2^255-19: value = sum a_i * 2^ceil(25.5 i).
pub struct Fe25519 {
    a0: i64, a1: i64, a2: i64, a3: i64, a4: i64,
    a5: i64, a6: i64, a7: i64, a8: i64, a9: i64,
}

// ─── Small elements and constants ───────────────────────────────────────

@constant_time
pub fn f25_zero() -> Fe25519 {
    return Fe25519 { a0: 0, a1: 0, a2: 0, a3: 0, a4: 0, a5: 0, a6: 0, a7: 0, a8: 0, a9: 0 };
}

@constant_time
pub fn f25_one() -> Fe25519 {
    return Fe25519 { a0: 1, a1: 0, a2: 0, a3: 0, a4: 0, a5: 0, a6: 0, a7: 0, a8: 0, a9: 0 };
}

// Constants below are canonical limbs, generated from the integers:
//   d = -121665/121666, d2 = 2d, sqrtm1 = 2^((p-1)/4),
//   (bx, by, bt) = the Ed25519 base point B (y = 4/5, x even) and x*y.
@constant_time
pub fn f25_const_d() -> Fe25519 {
    return Fe25519 { a0: 56195235, a1: 13857412, a2: 51736253, a3: 6949390, a4: 114729, a5: 24766616, a6: 60832955, a7: 30306712, a8: 48412415, a9: 21499315 };
}
@constant_time
pub fn f25_const_d2() -> Fe25519 {
    return Fe25519 { a0: 45281625, a1: 27714825, a2: 36363642, a3: 13898781, a4: 229458, a5: 15978800, a6: 54557047, a7: 27058993, a8: 29715967, a9: 9444199 };
}
@constant_time
pub fn f25_const_sqrtm1() -> Fe25519 {
    return Fe25519 { a0: 34513072, a1: 25610706, a2: 9377949, a3: 3500415, a4: 12389472, a5: 33281959, a6: 41962654, a7: 31548777, a8: 326685, a9: 11406482 };
}
@constant_time
pub fn f25_const_bx() -> Fe25519 {
    return Fe25519 { a0: 52811034, a1: 25909283, a2: 16144682, a3: 17082669, a4: 27570973, a5: 30858332, a6: 40966398, a7: 8378388, a8: 20764389, a9: 8758491 };
}
@constant_time
pub fn f25_const_by() -> Fe25519 {
    return Fe25519 { a0: 40265304, a1: 26843545, a2: 13421772, a3: 20132659, a4: 26843545, a5: 6710886, a6: 53687091, a7: 13421772, a8: 40265318, a9: 26843545 };
}
@constant_time
pub fn f25_const_bt() -> Fe25519 {
    return Fe25519 { a0: 28827043, a1: 27438313, a2: 39759291, a3: 244362, a4: 8635006, a5: 11264893, a6: 19351346, a7: 13413597, a8: 16611511, a9: 27139452 };
}

// ─── Carry ──────────────────────────────────────────────────────────────

/// Carry ten wide limbs (each |h| < 2^62) into the reduced form.
/// Signed carries: c = round(h / 2^w); multiplication instead of `<<`
/// so that no negative value is shifted left.
@constant_time
fn f25_carry(x0: i64, x1: i64, x2: i64, x3: i64, x4: i64,
             x5: i64, x6: i64, x7: i64, x8: i64, x9: i64) -> Fe25519 {
    var h0: i64 = x0; var h1: i64 = x1; var h2: i64 = x2; var h3: i64 = x3;
    var h4: i64 = x4; var h5: i64 = x5; var h6: i64 = x6; var h7: i64 = x7;
    var h8: i64 = x8; var h9: i64 = x9;
    var c: i64 = 0;
    c = (h0 + 33554432) >> 26; h1 = h1 + c; h0 = h0 - c * 67108864;
    c = (h4 + 33554432) >> 26; h5 = h5 + c; h4 = h4 - c * 67108864;
    c = (h1 + 16777216) >> 25; h2 = h2 + c; h1 = h1 - c * 33554432;
    c = (h5 + 16777216) >> 25; h6 = h6 + c; h5 = h5 - c * 33554432;
    c = (h2 + 33554432) >> 26; h3 = h3 + c; h2 = h2 - c * 67108864;
    c = (h6 + 33554432) >> 26; h7 = h7 + c; h6 = h6 - c * 67108864;
    c = (h3 + 16777216) >> 25; h4 = h4 + c; h3 = h3 - c * 33554432;
    c = (h7 + 16777216) >> 25; h8 = h8 + c; h7 = h7 - c * 33554432;
    c = (h4 + 33554432) >> 26; h5 = h5 + c; h4 = h4 - c * 67108864;
    c = (h8 + 33554432) >> 26; h9 = h9 + c; h8 = h8 - c * 67108864;
    c = (h9 + 16777216) >> 25; h0 = h0 + c * 19; h9 = h9 - c * 33554432;
    c = (h0 + 33554432) >> 26; h1 = h1 + c; h0 = h0 - c * 67108864;
    return Fe25519 { a0: h0, a1: h1, a2: h2, a3: h3, a4: h4, a5: h5, a6: h6, a7: h7, a8: h8, a9: h9 };
}

// ─── Arithmetic ─────────────────────────────────────────────────────────

/// f + g
@constant_time
pub fn f25_add(f: Fe25519, g: Fe25519) -> Fe25519 {
    return f25_carry(f.a0 + g.a0, f.a1 + g.a1, f.a2 + g.a2, f.a3 + g.a3, f.a4 + g.a4,
                     f.a5 + g.a5, f.a6 + g.a6, f.a7 + g.a7, f.a8 + g.a8, f.a9 + g.a9);
}

/// f - g
@constant_time
pub fn f25_sub(f: Fe25519, g: Fe25519) -> Fe25519 {
    return f25_carry(f.a0 - g.a0, f.a1 - g.a1, f.a2 - g.a2, f.a3 - g.a3, f.a4 - g.a4,
                     f.a5 - g.a5, f.a6 - g.a6, f.a7 - g.a7, f.a8 - g.a8, f.a9 - g.a9);
}

/// -f
@constant_time
pub fn f25_neg(f: Fe25519) -> Fe25519 {
    return f25_carry(0 - f.a0, 0 - f.a1, 0 - f.a2, 0 - f.a3, 0 - f.a4,
                     0 - f.a5, 0 - f.a6, 0 - f.a7, 0 - f.a8, 0 - f.a9);
}

/// f * n for a small constant 0 <= n < 2^20 (121665 in X25519).
@constant_time
pub fn f25_mul_small(f: Fe25519, n: i64) -> Fe25519 {
    return f25_carry(f.a0 * n, f.a1 * n, f.a2 * n, f.a3 * n, f.a4 * n,
                     f.a5 * n, f.a6 * n, f.a7 * n, f.a8 * n, f.a9 * n);
}

/// f * g. Product f_i g_j lands in limb i+j, doubled when i and j are both
/// odd (the half bits), times 19 when i+j >= 10 (2^255 = 19 mod p).
@constant_time
pub fn f25_mul(f: Fe25519, g: Fe25519) -> Fe25519 {
    val f0: i64 = f.a0; val f1: i64 = f.a1; val f2: i64 = f.a2; val f3: i64 = f.a3; val f4: i64 = f.a4;
    val f5: i64 = f.a5; val f6: i64 = f.a6; val f7: i64 = f.a7; val f8: i64 = f.a8; val f9: i64 = f.a9;
    val g0: i64 = g.a0; val g1: i64 = g.a1; val g2: i64 = g.a2; val g3: i64 = g.a3; val g4: i64 = g.a4;
    val g5: i64 = g.a5; val g6: i64 = g.a6; val g7: i64 = g.a7; val g8: i64 = g.a8; val g9: i64 = g.a9;
    var h0: i64 = f0 * g0 + f1 * g9 * 38 + f2 * g8 * 19 + f3 * g7 * 38 + f4 * g6 * 19 + f5 * g5 * 38 + f6 * g4 * 19 + f7 * g3 * 38 + f8 * g2 * 19 + f9 * g1 * 38;
    var h1: i64 = f0 * g1 + f1 * g0 + f2 * g9 * 19 + f3 * g8 * 19 + f4 * g7 * 19 + f5 * g6 * 19 + f6 * g5 * 19 + f7 * g4 * 19 + f8 * g3 * 19 + f9 * g2 * 19;
    var h2: i64 = f0 * g2 + f1 * g1 * 2 + f2 * g0 + f3 * g9 * 38 + f4 * g8 * 19 + f5 * g7 * 38 + f6 * g6 * 19 + f7 * g5 * 38 + f8 * g4 * 19 + f9 * g3 * 38;
    var h3: i64 = f0 * g3 + f1 * g2 + f2 * g1 + f3 * g0 + f4 * g9 * 19 + f5 * g8 * 19 + f6 * g7 * 19 + f7 * g6 * 19 + f8 * g5 * 19 + f9 * g4 * 19;
    var h4: i64 = f0 * g4 + f1 * g3 * 2 + f2 * g2 + f3 * g1 * 2 + f4 * g0 + f5 * g9 * 38 + f6 * g8 * 19 + f7 * g7 * 38 + f8 * g6 * 19 + f9 * g5 * 38;
    var h5: i64 = f0 * g5 + f1 * g4 + f2 * g3 + f3 * g2 + f4 * g1 + f5 * g0 + f6 * g9 * 19 + f7 * g8 * 19 + f8 * g7 * 19 + f9 * g6 * 19;
    var h6: i64 = f0 * g6 + f1 * g5 * 2 + f2 * g4 + f3 * g3 * 2 + f4 * g2 + f5 * g1 * 2 + f6 * g0 + f7 * g9 * 38 + f8 * g8 * 19 + f9 * g7 * 38;
    var h7: i64 = f0 * g7 + f1 * g6 + f2 * g5 + f3 * g4 + f4 * g3 + f5 * g2 + f6 * g1 + f7 * g0 + f8 * g9 * 19 + f9 * g8 * 19;
    var h8: i64 = f0 * g8 + f1 * g7 * 2 + f2 * g6 + f3 * g5 * 2 + f4 * g4 + f5 * g3 * 2 + f6 * g2 + f7 * g1 * 2 + f8 * g0 + f9 * g9 * 38;
    var h9: i64 = f0 * g9 + f1 * g8 + f2 * g7 + f3 * g6 + f4 * g5 + f5 * g4 + f6 * g3 + f7 * g2 + f8 * g1 + f9 * g0;
    return f25_carry(h0, h1, h2, h3, h4, h5, h6, h7, h8, h9);
}

/// f^2 (the 55 distinct products of f25_mul).
@constant_time
pub fn f25_sq(f: Fe25519) -> Fe25519 {
    val f0: i64 = f.a0; val f1: i64 = f.a1; val f2: i64 = f.a2; val f3: i64 = f.a3; val f4: i64 = f.a4;
    val f5: i64 = f.a5; val f6: i64 = f.a6; val f7: i64 = f.a7; val f8: i64 = f.a8; val f9: i64 = f.a9;
    val g0: i64 = f0; val g1: i64 = f1; val g2: i64 = f2; val g3: i64 = f3; val g4: i64 = f4;
    val g5: i64 = f5; val g6: i64 = f6; val g7: i64 = f7; val g8: i64 = f8; val g9: i64 = f9;
    var h0: i64 = f0 * g0 + f1 * g9 * 76 + f2 * g8 * 38 + f3 * g7 * 76 + f4 * g6 * 38 + f5 * g5 * 38;
    var h1: i64 = f0 * g1 * 2 + f2 * g9 * 38 + f3 * g8 * 38 + f4 * g7 * 38 + f5 * g6 * 38;
    var h2: i64 = f0 * g2 * 2 + f1 * g1 * 2 + f3 * g9 * 76 + f4 * g8 * 38 + f5 * g7 * 76 + f6 * g6 * 19;
    var h3: i64 = f0 * g3 * 2 + f1 * g2 * 2 + f4 * g9 * 38 + f5 * g8 * 38 + f6 * g7 * 38;
    var h4: i64 = f0 * g4 * 2 + f1 * g3 * 4 + f2 * g2 + f5 * g9 * 76 + f6 * g8 * 38 + f7 * g7 * 38;
    var h5: i64 = f0 * g5 * 2 + f1 * g4 * 2 + f2 * g3 * 2 + f6 * g9 * 38 + f7 * g8 * 38;
    var h6: i64 = f0 * g6 * 2 + f1 * g5 * 4 + f2 * g4 * 2 + f3 * g3 * 2 + f7 * g9 * 76 + f8 * g8 * 19;
    var h7: i64 = f0 * g7 * 2 + f1 * g6 * 2 + f2 * g5 * 2 + f3 * g4 * 2 + f8 * g9 * 38;
    var h8: i64 = f0 * g8 * 2 + f1 * g7 * 4 + f2 * g6 * 2 + f3 * g5 * 4 + f4 * g4 + f9 * g9 * 38;
    var h9: i64 = f0 * g9 * 2 + f1 * g8 * 2 + f2 * g7 * 2 + f3 * g6 * 2 + f4 * g5 * 2;
    return f25_carry(h0, h1, h2, h3, h4, h5, h6, h7, h8, h9);
}

/// f^(2^n), n >= 1.
pub fn f25_sq_n(f: Fe25519, n: i64) -> Fe25519 {
    var r: Fe25519 = f25_sq(f);
    var i: i64 = 1;
    while i < n { r = f25_sq(r); i = i + 1; }
    return r;
}

/// g when b == 1, f when b == 0 (b must be 0 or 1). No branch: a mask.
@constant_time
pub fn f25_select(f: Fe25519, g: Fe25519, b: i64) -> Fe25519 {
    val m: i64 = 0 - b;
    return Fe25519 {
        a0: f.a0 ^ ((f.a0 ^ g.a0) & m), a1: f.a1 ^ ((f.a1 ^ g.a1) & m),
        a2: f.a2 ^ ((f.a2 ^ g.a2) & m), a3: f.a3 ^ ((f.a3 ^ g.a3) & m),
        a4: f.a4 ^ ((f.a4 ^ g.a4) & m), a5: f.a5 ^ ((f.a5 ^ g.a5) & m),
        a6: f.a6 ^ ((f.a6 ^ g.a6) & m), a7: f.a7 ^ ((f.a7 ^ g.a7) & m),
        a8: f.a8 ^ ((f.a8 ^ g.a8) & m), a9: f.a9 ^ ((f.a9 ^ g.a9) & m),
    };
}

/// z^(p-2) = 1/z (0 for z = 0): 254 squarings, 11 multiplications.
pub fn f25_invert(z: Fe25519) -> Fe25519 {
    val z2: Fe25519 = f25_sq(z);                       // 2
    val z9: Fe25519 = f25_mul(f25_sq_n(z2, 2), z);     // 9
    val z11: Fe25519 = f25_mul(z9, z2);                // 11
    val z5_0: Fe25519 = f25_mul(f25_sq(z11), z9);      // 2^5 - 1
    val z10_0: Fe25519 = f25_mul(f25_sq_n(z5_0, 5), z5_0);
    val z20_0: Fe25519 = f25_mul(f25_sq_n(z10_0, 10), z10_0);
    val z40_0: Fe25519 = f25_mul(f25_sq_n(z20_0, 20), z20_0);
    val z50_0: Fe25519 = f25_mul(f25_sq_n(z40_0, 10), z10_0);
    val z100_0: Fe25519 = f25_mul(f25_sq_n(z50_0, 50), z50_0);
    val z200_0: Fe25519 = f25_mul(f25_sq_n(z100_0, 100), z100_0);
    val z250_0: Fe25519 = f25_mul(f25_sq_n(z200_0, 50), z50_0);
    return f25_mul(f25_sq_n(z250_0, 5), z11);          // 2^255 - 21
}

/// z^((p-5)/8) = z^(2^252 - 3), for square roots (Ed25519 decoding).
pub fn f25_pow22523(z: Fe25519) -> Fe25519 {
    val z2: Fe25519 = f25_sq(z);
    val z9: Fe25519 = f25_mul(f25_sq_n(z2, 2), z);
    val z11: Fe25519 = f25_mul(z9, z2);
    val z5_0: Fe25519 = f25_mul(f25_sq(z11), z9);
    val z10_0: Fe25519 = f25_mul(f25_sq_n(z5_0, 5), z5_0);
    val z20_0: Fe25519 = f25_mul(f25_sq_n(z10_0, 10), z10_0);
    val z40_0: Fe25519 = f25_mul(f25_sq_n(z20_0, 20), z20_0);
    val z50_0: Fe25519 = f25_mul(f25_sq_n(z40_0, 10), z10_0);
    val z100_0: Fe25519 = f25_mul(f25_sq_n(z50_0, 50), z50_0);
    val z200_0: Fe25519 = f25_mul(f25_sq_n(z100_0, 100), z100_0);
    val z250_0: Fe25519 = f25_mul(f25_sq_n(z200_0, 50), z50_0);
    return f25_mul(f25_sq_n(z250_0, 2), z);            // 2^252 - 3
}

// ─── Bytes ──────────────────────────────────────────────────────────────

/// `w` bits of the little-endian number b[off..off+32] from bit `pos`.
fn f25_bits(b: &Vec<i64>, off: i64, pos: i64, w: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = (pos + w - 1) / 8;
    val lo: i64 = pos / 8;
    while i >= lo {
        acc = acc * 256 + (b.get(off + i) & 255);
        i = i - 1;
    }
    return (acc >> (pos % 8)) & ((1 << w) - 1);
}

/// The 32 bytes b[off..off+32] as a field element; bit 255 is ignored.
/// A value in [p, 2^255) is accepted and works as that value mod p.
pub fn f25_from_bytes_at(b: &Vec<i64>, off: i64) -> Fe25519 {
    return Fe25519 {
        a0: f25_bits(b, off, 0, 26), a1: f25_bits(b, off, 26, 25),
        a2: f25_bits(b, off, 51, 26), a3: f25_bits(b, off, 77, 25),
        a4: f25_bits(b, off, 102, 26), a5: f25_bits(b, off, 128, 25),
        a6: f25_bits(b, off, 153, 26), a7: f25_bits(b, off, 179, 25),
        a8: f25_bits(b, off, 204, 26), a9: f25_bits(b, off, 230, 25),
    };
}

pub fn f25_from_bytes(b: Vec<i64>) -> Fe25519 {
    return f25_from_bytes_at(&b, 0);
}

/// The canonical 32-byte little-endian encoding (value in [0, p)).
pub fn f25_to_bytes(f: Fe25519) -> Vec<i64> {
    val h: Fe25519 = f25_carry(f.a0, f.a1, f.a2, f.a3, f.a4, f.a5, f.a6, f.a7, f.a8, f.a9);
    var h0: i64 = h.a0; var h1: i64 = h.a1; var h2: i64 = h.a2; var h3: i64 = h.a3;
    var h4: i64 = h.a4; var h5: i64 = h.a5; var h6: i64 = h.a6; var h7: i64 = h.a7;
    var h8: i64 = h.a8; var h9: i64 = h.a9;
    // q = floor(h / p): -1, 0 or 1 for a carried h (the ref10 argument).
    var q: i64 = (19 * h9 + 16777216) >> 25;
    q = (h0 + q) >> 26; q = (h1 + q) >> 25; q = (h2 + q) >> 26; q = (h3 + q) >> 25;
    q = (h4 + q) >> 26; q = (h5 + q) >> 25; q = (h6 + q) >> 26; q = (h7 + q) >> 25;
    q = (h8 + q) >> 26; q = (h9 + q) >> 25;
    // h - q p = h + 19 q - 2^255 q: add 19q, carry, drop bit 255.
    h0 = h0 + 19 * q;
    var c: i64 = 0;
    c = h0 >> 26; h1 = h1 + c; h0 = h0 - c * 67108864;
    c = h1 >> 25; h2 = h2 + c; h1 = h1 - c * 33554432;
    c = h2 >> 26; h3 = h3 + c; h2 = h2 - c * 67108864;
    c = h3 >> 25; h4 = h4 + c; h3 = h3 - c * 33554432;
    c = h4 >> 26; h5 = h5 + c; h4 = h4 - c * 67108864;
    c = h5 >> 25; h6 = h6 + c; h5 = h5 - c * 33554432;
    c = h6 >> 26; h7 = h7 + c; h6 = h6 - c * 67108864;
    c = h7 >> 25; h8 = h8 + c; h7 = h7 - c * 33554432;
    c = h8 >> 26; h9 = h9 + c; h8 = h8 - c * 67108864;
    c = h9 >> 25; h9 = h9 - c * 33554432;
    // Limbs are now in [0, 2^w): pack 26,25,26,... bits little-endian.
    var limbs: Vec<i64> = Vec::new();
    limbs.push(h0); limbs.push(h1); limbs.push(h2); limbs.push(h3); limbs.push(h4);
    limbs.push(h5); limbs.push(h6); limbs.push(h7); limbs.push(h8); limbs.push(h9);
    var out: Vec<i64> = Vec::new();
    var acc: i64 = 0;
    var nbits: i64 = 0;
    var i: i64 = 0;
    while i < 10 {
        acc = acc | (limbs.get(i) << nbits);
        nbits = nbits + 26 - (i % 2);
        while nbits >= 8 {
            out.push(acc & 255);
            acc = acc >> 8;
            nbits = nbits - 8;
        }
        i = i + 1;
    }
    out.push(acc & 255);
    return out;
}

/// 1 when f = 0 mod p, else 0.
pub fn f25_is_zero(f: Fe25519) -> i64 {
    val b: Vec<i64> = f25_to_bytes(f);
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < 32 { acc = acc | b.get(i); i = i + 1; }
    return 1 - (((acc | (0 - acc)) >> 63) & 1);
}

/// 1 when f = g mod p, else 0.
pub fn f25_equal(f: Fe25519, g: Fe25519) -> i64 {
    return f25_is_zero(f25_sub(f, g));
}

/// The low bit of the canonical value ("negative" in RFC 8032).
pub fn f25_is_odd(f: Fe25519) -> i64 {
    return f25_to_bytes(f).get(0) & 1;
}

// ─── X25519 ─────────────────────────────────────────────────────────────

fn x25519_check_len(name: str, v: &Vec<i64>) {
    if v.len() != 32 {
        p_panic("x25519: " + name + " must be 32 bytes, got " + int_to_str(v.len()));
    }
}

/// A projective u-coordinate x/z.
struct X25519Xz {
    x: Fe25519,
    z: Fe25519,
}

/// The Montgomery ladder of RFC 7748 §5 for a clamped scalar k: [k] (x1 : 1)
/// as x/z. 255 fixed steps, swaps by mask: no branch or index on k (the bit
/// index t is the loop counter).
@constant_time
fn x25519_ladder_xz(k: &Vec<i64>, x1: Fe25519) -> X25519Xz {
    var x2: Fe25519 = f25_one();
    var z2: Fe25519 = f25_zero();
    var x3: Fe25519 = x1;
    var z3: Fe25519 = f25_one();
    var swap: i64 = 0;
    var t: i64 = 254;
    while t >= 0 {
        val kt: i64 = (k.get(t >> 3) >> (t & 7)) & 1;
        swap = swap ^ kt;
        val sx2: Fe25519 = f25_select(x2, x3, swap);
        val sx3: Fe25519 = f25_select(x3, x2, swap);
        val sz2: Fe25519 = f25_select(z2, z3, swap);
        val sz3: Fe25519 = f25_select(z3, z2, swap);
        swap = kt;
        val a: Fe25519 = f25_add(sx2, sz2);
        val aa: Fe25519 = f25_sq(a);
        val b: Fe25519 = f25_sub(sx2, sz2);
        val bb: Fe25519 = f25_sq(b);
        val e: Fe25519 = f25_sub(aa, bb);
        val c: Fe25519 = f25_add(sx3, sz3);
        val d: Fe25519 = f25_sub(sx3, sz3);
        val da: Fe25519 = f25_mul(d, a);
        val cb: Fe25519 = f25_mul(c, b);
        x3 = f25_sq(f25_add(da, cb));
        z3 = f25_mul(x1, f25_sq(f25_sub(da, cb)));
        x2 = f25_mul(aa, bb);
        z2 = f25_mul(e, f25_add(aa, f25_mul_small(e, 121665)));
        t = t - 1;
    }
    return X25519Xz { x: f25_select(x2, x3, swap), z: f25_select(z2, z3, swap) };
}

/// u-coordinate of [k] x1 for a clamped 32-byte k.
fn x25519_ladder(k: &Vec<i64>, x1: Fe25519) -> Fe25519 {
    val r: X25519Xz = x25519_ladder_xz(k, x1);
    return f25_mul(r.x, f25_invert(r.z));
}

/// X25519(k, u) of RFC 7748 §5: the u-coordinate of [clamp(k)] u.
/// Both arguments are 32 bytes; bit 255 of u is ignored and a
/// non-canonical u (>= p) is reduced, as the RFC requires. Panics on a
/// wrong length. Constant time in k (a fixed 255-step Montgomery ladder
/// with masked swaps).
pub fn x25519_scalarmult(scalar: Vec<i64>, u: Vec<i64>) -> Vec<i64> {
    x25519_check_len("scalar", &scalar);
    x25519_check_len("u-coordinate", &u);
    var k: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 32 { k.push(scalar.get(i) & 255); i = i + 1; }
    k.set(0, k.get(0) & 248);
    k.set(31, (k.get(31) & 127) | 64);
    val r: Fe25519 = x25519_ladder(&k, f25_from_bytes(u));
    return f25_to_bytes(r);
}

/// The public key of a 32-byte secret key: X25519(k, 9).
pub fn x25519_public_key(secret: Vec<i64>) -> Vec<i64> {
    var nine: Vec<i64> = Vec::new();
    nine.push(9);
    var i: i64 = 1;
    while i < 32 { nine.push(0); i = i + 1; }
    return x25519_scalarmult(secret, nine);
}

/// 1 when all 32 bytes are zero (checked without an early exit).
pub fn x25519_is_all_zero(k: Vec<i64>) -> bool {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < k.len() { acc = acc | k.get(i); i = i + 1; }
    return acc == 0;
}

/// The Diffie-Hellman shared secret X25519(secret, peer_public) of RFC 7748
/// §6.1, or None when it is all zero (the peer sent a small-order point).
pub fn x25519_shared_secret(secret: Vec<i64>, peer_public: Vec<i64>) -> Option<Vec<i64>> {
    val k: Vec<i64> = x25519_scalarmult(secret, peer_public);
    if x25519_is_all_zero(k) { return Option::None; }
    return Option::Some(k);
}
