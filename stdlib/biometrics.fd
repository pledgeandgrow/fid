// Fides biometric authentication: one flow for BiometricPrompt and
// LocalAuthentication
//
// What is real (pure Fides, tested in the interpreter):
//   - availability: BiometricManager.canAuthenticate results and
//     LAContext canEvaluatePolicy errors mapped to one status (available,
//     no hardware, hardware unavailable, not enrolled, needs a security
//     update, passcode not set, locked out), with the biometry kind
//     (fingerprint / face / iris; Touch ID, Face ID, Optic ID)
//   - authenticator sets (BIOMETRIC_STRONG 0x0F, BIOMETRIC_WEAK 0xFF,
//     DEVICE_CREDENTIAL 0x8000) and which combinations each API level
//     accepts; the LAPolicy matching a set
//   - prompt configuration with each platform's rules: a title and a
//     negative button unless the device credential is allowed (Android),
//     a non-empty localizedReason and NSFaceIDUsageDescription (iOS)
//   - the results: BiometricPrompt error codes, onAuthenticationFailed, and
//     LAError codes mapped to one result set, with what to do next
//     (retry, offer the passcode / password fallback, give up)
//   - a session state machine counting failed attempts to the platform
//     lockout (5 failures, 30 s on Android; then the device credential)
//
// The platform seam: the calls are given as data (`bio_android_calls`,
// `bio_ios_calls`: class, method / selector, signature / type encoding)
// for jni.fd and objc.fd to make; their callbacks are fed back with
// bio_session_android_error / _failed / _succeeded and bio_session_ios.

module biometrics;
use vec;
use string;

// Authenticators (androidx.biometric.BiometricManager.Authenticators)
pub const BIO_STRONG: i64 = 0x000F;
pub const BIO_WEAK: i64 = 0x00FF;
pub const BIO_DEVICE_CREDENTIAL: i64 = 0x8000;

// Unified availability
pub const BIO_AVAILABLE: i64 = 0;
pub const BIO_NO_HARDWARE: i64 = 1;
pub const BIO_HW_UNAVAILABLE: i64 = 2;
pub const BIO_NOT_ENROLLED: i64 = 3;
pub const BIO_SECURITY_UPDATE: i64 = 4;
pub const BIO_PASSCODE_NOT_SET: i64 = 5;
pub const BIO_LOCKED_OUT: i64 = 6;
pub const BIO_UNSUPPORTED: i64 = 7;
pub const BIO_UNKNOWN: i64 = 8;

// Biometry kinds
pub const BIO_KIND_NONE: i64 = 0;
pub const BIO_KIND_FINGERPRINT: i64 = 1;
pub const BIO_KIND_FACE: i64 = 2;
pub const BIO_KIND_IRIS: i64 = 3;

// Unified results
pub const BIO_SUCCESS: i64 = 0;
pub const BIO_NOT_RECOGNIZED: i64 = 1;     // try again, prompt still up
pub const BIO_USER_CANCELED: i64 = 2;
pub const BIO_FALLBACK: i64 = 3;           // user chose password / passcode
pub const BIO_LOCKOUT: i64 = 4;            // temporary
pub const BIO_LOCKOUT_PERMANENT: i64 = 5;  // device credential needed
pub const BIO_NOT_AVAILABLE: i64 = 6;
pub const BIO_SYSTEM_CANCELED: i64 = 7;    // app went to background, another prompt
pub const BIO_TIMEOUT: i64 = 8;
pub const BIO_ERROR: i64 = 9;

pub fn bio_availability_name(a: i64) -> str {
    val n: Vec<str> = str_split("available,no-hardware,hw-unavailable,not-enrolled,security-update,passcode-not-set,locked-out,unsupported,unknown", ",");
    if a < 0 || a >= n.len() { return "?"; }
    return n.get(a);
}

pub fn bio_result_name(r: i64) -> str {
    val n: Vec<str> = str_split("success,not-recognized,user-canceled,fallback,lockout,lockout-permanent,not-available,system-canceled,timeout,error", ",");
    if r < 0 || r >= n.len() { return "?"; }
    return n.get(r);
}

// ─── Availability ──────────────────────────────────────────────────────

/// BiometricManager.canAuthenticate(int) -> availability.
pub fn bio_android_availability(code: i64) -> i64 {
    if code == 0 { return BIO_AVAILABLE; }           // BIOMETRIC_SUCCESS
    if code == 1 { return BIO_HW_UNAVAILABLE; }      // ERROR_HW_UNAVAILABLE
    if code == 11 { return BIO_NOT_ENROLLED; }       // ERROR_NONE_ENROLLED
    if code == 12 { return BIO_NO_HARDWARE; }        // ERROR_NO_HARDWARE
    if code == 15 { return BIO_SECURITY_UPDATE; }    // ERROR_SECURITY_UPDATE_REQUIRED
    if code == -2 { return BIO_UNSUPPORTED; }        // ERROR_UNSUPPORTED
    return BIO_UNKNOWN;                              // STATUS_UNKNOWN (-1)
}

/// canEvaluatePolicy:error: -> availability (`ok` the BOOL, `la_error`
/// the NSError code when it is NO).
pub fn bio_ios_availability(ok: bool, la_error: i64) -> i64 {
    if ok { return BIO_AVAILABLE; }
    if la_error == -6 { return BIO_NO_HARDWARE; }    // biometryNotAvailable
    if la_error == -7 { return BIO_NOT_ENROLLED; }   // biometryNotEnrolled
    if la_error == -8 { return BIO_LOCKED_OUT; }     // biometryLockout
    if la_error == -5 { return BIO_PASSCODE_NOT_SET; }
    return BIO_UNKNOWN;
}

/// LABiometryType (0 none, 1 touchID, 2 faceID, 4 opticID) -> kind.
pub fn bio_ios_kind(biometry_type: i64) -> i64 {
    if biometry_type == 1 { return BIO_KIND_FINGERPRINT; }
    if biometry_type == 2 { return BIO_KIND_FACE; }
    if biometry_type == 4 { return BIO_KIND_IRIS; }
    return BIO_KIND_NONE;
}

/// PackageManager features -> kind (face before iris before fingerprint
/// is not implied: the first feature present wins in that order).
pub fn bio_android_kind(fingerprint: bool, face: bool, iris: bool) -> i64 {
    if fingerprint { return BIO_KIND_FINGERPRINT; }
    if face { return BIO_KIND_FACE; }
    if iris { return BIO_KIND_IRIS; }
    return BIO_KIND_NONE;
}

/// Does BiometricPrompt accept this authenticator set on `api`? (STRONG
/// or WEAK, either with DEVICE_CREDENTIAL; DEVICE_CREDENTIAL alone from
/// API 30; STRONG | DEVICE_CREDENTIAL not on API 28-29.)
pub fn bio_android_authenticators_ok(auth: i64, api: i64) -> bool {
    val bio: i64 = auth & 0x7FFF;
    val cred: bool = (auth & BIO_DEVICE_CREDENTIAL) != 0;
    if (auth & ~(BIO_WEAK | BIO_DEVICE_CREDENTIAL)) != 0 { return false; }
    if bio != 0 && bio != BIO_STRONG && bio != BIO_WEAK { return false; }
    if bio == 0 { return cred && api >= 30; }
    if cred && bio == BIO_STRONG && (api == 28 || api == 29) { return false; }
    return true;
}

/// The LAPolicy of an authenticator set: 1 (biometrics only) or 2
/// (biometrics or the passcode).
pub fn bio_ios_policy(auth: i64) -> i64 {
    if (auth & BIO_DEVICE_CREDENTIAL) != 0 { return 2; }
    return 1;
}

// ─── Prompt configuration ──────────────────────────────────────────────

pub struct BioPrompt {
    pub title: str,
    pub subtitle: str,
    pub description: str,
    pub negative_text: str,        // Android negative button
    pub reason: str,               // iOS localizedReason
    pub fallback_title: str,       // iOS: "" hides the fallback button
    pub cancel_title: str,
    pub confirmation_required: bool,
    pub authenticators: i64,
}

pub fn bio_prompt_new(title: str, reason: str) -> BioPrompt {
    return BioPrompt {
        title: title, subtitle: "", description: "", negative_text: "Cancel", reason: reason, fallback_title: "",
        cancel_title: "", confirmation_required: true, authenticators: BIO_STRONG,
    };
}

/// Problems of a prompt on Android (API `api`).
pub fn bio_prompt_check_android(p: &BioPrompt, api: i64) -> Vec<str> {
    var e: Vec<str> = Vec::new();
    if str_len(str_trim(p.title)) == 0 { e.push("title is required"); }
    val cred: bool = (p.authenticators & BIO_DEVICE_CREDENTIAL) != 0;
    if cred && str_len(p.negative_text) > 0 { e.push("no negative button when the device credential is allowed"); }
    if !cred && str_len(str_trim(p.negative_text)) == 0 { e.push("negative button text is required"); }
    if !bio_android_authenticators_ok(p.authenticators, api) { e.push("authenticators not supported on API " + int_to_str(api)); }
    return e;
}

/// Problems of a prompt on iOS. `has_face_id_key`: Info.plist has
/// NSFaceIDUsageDescription (needed when the device has Face ID).
pub fn bio_prompt_check_ios(p: &BioPrompt, kind: i64, has_face_id_key: bool) -> Vec<str> {
    var e: Vec<str> = Vec::new();
    if str_len(str_trim(p.reason)) == 0 { e.push("localizedReason must not be empty"); }
    if kind == BIO_KIND_FACE && !has_face_id_key { e.push("NSFaceIDUsageDescription missing from Info.plist"); }
    return e;
}

// ─── Results ───────────────────────────────────────────────────────────

/// BiometricPrompt.AuthenticationCallback.onAuthenticationError codes.
pub fn bio_android_error(code: i64) -> i64 {
    if code == 1 || code == 12 || code == 11 || code == 14 || code == 15 { return BIO_NOT_AVAILABLE; }
    if code == 3 { return BIO_TIMEOUT; }
    if code == 5 { return BIO_SYSTEM_CANCELED; }     // ERROR_CANCELED
    if code == 7 { return BIO_LOCKOUT; }
    if code == 9 { return BIO_LOCKOUT_PERMANENT; }
    if code == 10 { return BIO_USER_CANCELED; }
    if code == 13 { return BIO_FALLBACK; }           // ERROR_NEGATIVE_BUTTON
    return BIO_ERROR;                                // 2 unable to process, 4 no space, 8 vendor
}

/// LAError codes of evaluatePolicy's reply.
pub fn bio_ios_error(code: i64) -> i64 {
    if code == -1 { return BIO_NOT_RECOGNIZED; }      // authenticationFailed (after retries)
    if code == -2 { return BIO_USER_CANCELED; }
    if code == -3 { return BIO_FALLBACK; }
    if code == -4 || code == -9 { return BIO_SYSTEM_CANCELED; }
    if code == -5 || code == -6 || code == -7 { return BIO_NOT_AVAILABLE; }
    if code == -8 { return BIO_LOCKOUT_PERMANENT; }  // biometry locked: the passcode unlocks it
    return BIO_ERROR;                                // -10 invalidContext, -1004 notInteractive
}

/// What the app should do after a result: "done", "retry", "fallback"
/// (offer password / device credential), "wait" (lockout), "give-up".
pub fn bio_next_action(result: i64) -> str {
    if result == BIO_SUCCESS { return "done"; }
    if result == BIO_NOT_RECOGNIZED || result == BIO_TIMEOUT || result == BIO_SYSTEM_CANCELED { return "retry"; }
    if result == BIO_FALLBACK || result == BIO_LOCKOUT_PERMANENT || result == BIO_NOT_AVAILABLE { return "fallback"; }
    if result == BIO_LOCKOUT { return "wait"; }
    return "give-up";
}

// ─── The session ───────────────────────────────────────────────────────

pub const BIO_STATE_IDLE: i64 = 0;
pub const BIO_STATE_PROMPTING: i64 = 1;
pub const BIO_STATE_SUCCEEDED: i64 = 2;
pub const BIO_STATE_FAILED: i64 = 3;
pub const BIO_STATE_LOCKED: i64 = 4;

pub struct BioSession {
    pub state: i64,
    pub failures: i64,            // consecutive not-recognized attempts
    pub max_failures: i64,        // 5 on both platforms
    pub lockout_ms: i64,          // 30000 on Android
    pub locked_until: i64,
    pub last_result: i64,
    pub used_credential: bool,    // succeeded with PIN / pattern / passcode
}

pub fn bio_session_new() -> BioSession {
    return BioSession {
        state: BIO_STATE_IDLE, failures: 0, max_failures: 5, lockout_ms: 30000, locked_until: 0,
        last_result: -1, used_credential: false,
    };
}

/// Start a prompt at `now` ms: false while locked out.
pub fn bio_session_start(s: &mut BioSession, now: i64) -> bool {
    if s.state == BIO_STATE_LOCKED && now < s.locked_until { return false; }
    s.state = BIO_STATE_PROMPTING;
    return true;
}

fn bio_finish(s: &mut BioSession, result: i64, now: i64) {
    s.last_result = result;
    if result == BIO_SUCCESS {
        s.state = BIO_STATE_SUCCEEDED;
        s.failures = 0;
    } else if result == BIO_LOCKOUT || result == BIO_LOCKOUT_PERMANENT {
        s.state = BIO_STATE_LOCKED;
        s.locked_until = if result == BIO_LOCKOUT { now + s.lockout_ms } else { 9223372036854775807 };
    } else {
        s.state = BIO_STATE_FAILED;
    }
}

/// onAuthenticationFailed: a finger or face not recognized; the prompt
/// stays up until the platform's limit, which locks it out.
pub fn bio_session_android_failed(s: &mut BioSession, now: i64) -> i64 {
    s.failures = s.failures + 1;
    if s.failures >= s.max_failures {
        bio_finish(s, BIO_LOCKOUT, now);
        return BIO_LOCKOUT;
    }
    s.last_result = BIO_NOT_RECOGNIZED;
    return BIO_NOT_RECOGNIZED;
}

/// onAuthenticationError(code).
pub fn bio_session_android_error(s: &mut BioSession, code: i64, now: i64) -> i64 {
    val r: i64 = bio_android_error(code);
    bio_finish(s, r, now);
    return r;
}

/// onAuthenticationSucceeded(result): authenticationType 1 is the device
/// credential, 2 a biometric.
pub fn bio_session_android_succeeded(s: &mut BioSession, auth_type: i64, now: i64) -> i64 {
    s.used_credential = auth_type == 1;
    bio_finish(s, BIO_SUCCESS, now);
    return BIO_SUCCESS;
}

/// evaluatePolicy's reply: success, or the LAError code.
pub fn bio_session_ios(s: &mut BioSession, success: bool, la_error: i64, now: i64) -> i64 {
    if success {
        bio_finish(s, BIO_SUCCESS, now);
        return BIO_SUCCESS;
    }
    val r: i64 = bio_ios_error(la_error);
    if r == BIO_NOT_RECOGNIZED { s.failures = s.failures + 1; }
    bio_finish(s, r, now);
    return r;
}

// ─── Platform calls (as data) ──────────────────────────────────────────

pub struct BioCall {
    pub cls: str,
    pub method: str,
    pub sig: str,
}

pub fn bio_android_calls() -> Vec<BioCall> {
    var v: Vec<BioCall> = Vec::new();
    v.push(BioCall { cls: "androidx/biometric/BiometricManager", method: "from", sig: "(Landroid/content/Context;)Landroidx/biometric/BiometricManager;" });
    v.push(BioCall { cls: "androidx/biometric/BiometricManager", method: "canAuthenticate", sig: "(I)I" });
    val b: str = "androidx/biometric/BiometricPrompt$PromptInfo$Builder";
    v.push(BioCall { cls: b, method: "setTitle", sig: "(Ljava/lang/CharSequence;)L" + b + ";" });
    v.push(BioCall { cls: b, method: "setNegativeButtonText", sig: "(Ljava/lang/CharSequence;)L" + b + ";" });
    v.push(BioCall { cls: b, method: "setAllowedAuthenticators", sig: "(I)L" + b + ";" });
    v.push(BioCall { cls: b, method: "setConfirmationRequired", sig: "(Z)L" + b + ";" });
    v.push(BioCall { cls: "androidx/biometric/BiometricPrompt", method: "authenticate", sig: "(Landroidx/biometric/BiometricPrompt$PromptInfo;)V" });
    return v;
}

pub fn bio_ios_calls() -> Vec<BioCall> {
    var v: Vec<BioCall> = Vec::new();
    v.push(BioCall { cls: "LAContext", method: "canEvaluatePolicy:error:", sig: "B@:q^@" });
    v.push(BioCall { cls: "LAContext", method: "biometryType", sig: "q@:" });
    v.push(BioCall { cls: "LAContext", method: "evaluatePolicy:localizedReason:reply:", sig: "v@:q@@?" });
    v.push(BioCall { cls: "LAContext", method: "setLocalizedFallbackTitle:", sig: "v@:@" });
    v.push(BioCall { cls: "LAContext", method: "invalidate", sig: "v@:" });
    return v;
}
