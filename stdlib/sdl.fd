// Fides SDL2 standard library
//
// SDL2 bindings for game development: window creation, 2D rendering,
// input (keyboard/mouse), audio, and image loading.
//
// This is the fastest path to a working game in Fides. One dependency
// gives you window + input + audio + graphics.
//
// Install on Linux:  sudo apt install libsdl2-dev libsdl2-image-dev libsdl2-mixer-dev
// Install on macOS:  brew install sdl2 sdl2_image sdl2_mixer
// Link with:         -lSDL2 -lSDL2_image -lSDL2_mixer
//
// Usage:
//   use sdl;
//   sdl_init(SDL_INIT_VIDEO | SDL_INIT_AUDIO);
//   var win = sdl_create_window("My Game", 640, 480);
//   var ren = sdl_create_renderer(win);
//   var loop = simpleloop_create();
//   while loop.running {
//       var dt = simpleloop_step(&mut loop);
//       sdl_poll_events();  // updates key/mouse state
//       if sdl_key_pressed(SDL_SCANCODE_ESCAPE) { simpleloop_stop(&mut loop); }
//       sdl_set_draw_color(ren, 0, 0, 0, 255);
//       sdl_render_clear(ren);
//       // draw stuff here
//       sdl_render_present(ren);
//   }
//   sdl_destroy_renderer(ren);
//   sdl_destroy_window(win);
//   sdl_quit();

module sdl;

// ─── SDL2 Core FFI ────────────────────────────────────────────────────────

extern "C" include "<SDL2/SDL.h>" link "SDL2" {
    fn SDL_Init as sdl_init_raw(flags: i64) -> i64;
    fn SDL_Quit as sdl_quit_raw() -> void;
    fn SDL_CreateWindow as sdl_create_window_raw(title: str, x: i64, y: i64, w: i64, h: i64, flags: i64) -> i64;
    fn SDL_DestroyWindow as sdl_destroy_window_raw(win: i64) -> void;
    fn SDL_CreateRenderer as sdl_create_renderer_raw(win: i64, index: i64, flags: i64) -> i64;
    fn SDL_DestroyRenderer as sdl_destroy_renderer_raw(ren: i64) -> void;
    fn SDL_RenderPresent as sdl_render_present_raw(ren: i64) -> void;
    fn SDL_RenderClear as sdl_render_clear_raw(ren: i64) -> i64;
    fn SDL_SetRenderDrawColor as sdl_set_draw_color_raw(ren: i64, r: i64, g: i64, b: i64, a: i64) -> i64;
    fn SDL_RenderFillRect as sdl_fill_rect_raw(ren: i64, rect: i64) -> i64;
    fn SDL_RenderDrawLine as sdl_draw_line_raw(ren: i64, x1: i64, y1: i64, x2: i64, y2: i64) -> i64;
    fn SDL_RenderDrawPoint as sdl_draw_point_raw(ren: i64, x: i64, y: i64) -> i64;
    fn SDL_PollEvent as sdl_poll_event_raw(event: i64) -> i64;
    fn SDL_GetKeyboardState as sdl_key_state_raw(count: i64) -> i64;
    fn SDL_GetMouseState as sdl_mouse_state_raw(x: i64, y: i64) -> i64;
    fn SDL_Delay as sdl_delay_raw(ms: i64) -> void;
    fn SDL_GetTicks as sdl_get_ticks_raw() -> i64;
    fn SDL_GetError as sdl_get_error_raw() -> str;
}

// ─── SDL2_image FFI (PNG/JPG loading) ─────────────────────────────────────

extern "C" include "<SDL2/SDL_image.h>" link "SDL2_image" {
    fn IMG_Load as img_load_raw(path: str) -> i64;
    fn SDL_CreateTextureFromSurface as sdl_texture_from_surface(ren: i64, surf: i64) -> i64;
    fn SDL_DestroyTexture as sdl_destroy_texture_raw(tex: i64) -> void;
    fn SDL_RenderCopy as sdl_render_copy(ren: i64, tex: i64, src: i64, dst: i64) -> i64;
    fn SDL_FreeSurface as sdl_free_surface(surf: i64) -> void;
    fn SDL_QueryTexture as sdl_query_texture(tex: i64, format: i64, access: i64, w: i64, h: i64) -> i64;
}

// ─── SDL2_mixer FFI (audio playback) ──────────────────────────────────────

extern "C" include "<SDL2/SDL_mixer.h>" link "SDL2_mixer" {
    fn Mix_OpenAudio as mix_open(freq: i64, format: i64, channels: i64, chunksize: i64) -> i64;
    fn Mix_CloseAudio as mix_close() -> void;
    fn Mix_LoadWAV as mix_load_wav_raw(path: str) -> i64;
    fn Mix_FreeChunk as mix_free_chunk(chunk: i64) -> void;
    fn Mix_PlayChannel as mix_play(channel: i64, chunk: i64, loops: i64) -> i64;
    fn Mix_HaltChannel as mix_halt(channel: i64) -> i64;
    fn Mix_Volume as mix_volume(channel: i64, volume: i64) -> i64;
    fn Mix_Pause as mix_pause(channel: i64) -> void;
    fn Mix_Resume as mix_resume(channel: i64) -> void;
    fn Mix_Playing as mix_playing(channel: i64) -> i64;
}

// ─── Constants ───────────────────────────────────────────────────────────

// SDL_Init flags
pub const SDL_INIT_VIDEO: i64 = 0x00000020;
pub const SDL_INIT_AUDIO: i64 = 0x00000010;
pub const SDL_INIT_EVENTS: i64 = 0x00004000;
pub const SDL_INIT_GAMECONTROLLER: i64 = 0x00002000;

// Window position
pub const SDL_WINDOWPOS_CENTERED: i64 = 0x2FFF0000;
pub const SDL_WINDOWPOS_UNDEFINED: i64 = 0x1FFF0000;

// Window flags
pub const SDL_WINDOW_FULLSCREEN: i64 = 0x00000001;
pub const SDL_WINDOW_OPENGL: i64 = 0x00000002;
pub const SDL_WINDOW_RESIZABLE: i64 = 0x00000020;
pub const SDL_WINDOW_SHOWN: i64 = 0x00000004;

// Renderer flags
pub const SDL_RENDERER_ACCELERATED: i64 = 0x00000002;
pub const SDL_RENDERER_VSYNC: i64 = 0x00000004;
pub const SDL_RENDERER_SOFTWARE: i64 = 0x00000001;

// SDL events
pub const SDL_QUIT: i64 = 0x100;
pub const SDL_KEYDOWN: i64 = 0x300;
pub const SDL_KEYUP: i64 = 0x301;
pub const SDL_MOUSEMOTION: i64 = 0x400;
pub const SDL_MOUSEBUTTONDOWN: i64 = 0x401;
pub const SDL_MOUSEBUTTONUP: i64 = 0x402;

// Key scancodes (commonly used)
pub const SDL_SCANCODE_UNKNOWN: i64 = 0;
pub const SDL_SCANCODE_A: i64 = 4;
pub const SDL_SCANCODE_B: i64 = 5;
pub const SDL_SCANCODE_C: i64 = 6;
pub const SDL_SCANCODE_D: i64 = 7;
pub const SDL_SCANCODE_E: i64 = 8;
pub const SDL_SCANCODE_F: i64 = 9;
pub const SDL_SCANCODE_G: i64 = 10;
pub const SDL_SCANCODE_H: i64 = 11;
pub const SDL_SCANCODE_I: i64 = 12;
pub const SDL_SCANCODE_J: i64 = 13;
pub const SDL_SCANCODE_K: i64 = 14;
pub const SDL_SCANCODE_L: i64 = 15;
pub const SDL_SCANCODE_M: i64 = 16;
pub const SDL_SCANCODE_N: i64 = 17;
pub const SDL_SCANCODE_O: i64 = 18;
pub const SDL_SCANCODE_P: i64 = 19;
pub const SDL_SCANCODE_Q: i64 = 20;
pub const SDL_SCANCODE_R: i64 = 21;
pub const SDL_SCANCODE_S: i64 = 22;
pub const SDL_SCANCODE_T: i64 = 23;
pub const SDL_SCANCODE_U: i64 = 24;
pub const SDL_SCANCODE_V: i64 = 25;
pub const SDL_SCANCODE_W: i64 = 26;
pub const SDL_SCANCODE_X: i64 = 27;
pub const SDL_SCANCODE_Y: i64 = 28;
pub const SDL_SCANCODE_Z: i64 = 29;
pub const SDL_SCANCODE_1: i64 = 30;
pub const SDL_SCANCODE_2: i64 = 31;
pub const SDL_SCANCODE_3: i64 = 32;
pub const SDL_SCANCODE_4: i64 = 33;
pub const SDL_SCANCODE_5: i64 = 34;
pub const SDL_SCANCODE_6: i64 = 35;
pub const SDL_SCANCODE_7: i64 = 36;
pub const SDL_SCANCODE_8: i64 = 37;
pub const SDL_SCANCODE_9: i64 = 38;
pub const SDL_SCANCODE_0: i64 = 39;
pub const SDL_SCANCODE_RETURN: i64 = 40;
pub const SDL_SCANCODE_ESCAPE: i64 = 41;
pub const SDL_SCANCODE_BACKSPACE: i64 = 42;
pub const SDL_SCANCODE_TAB: i64 = 43;
pub const SDL_SCANCODE_SPACE: i64 = 44;
pub const SDL_SCANCODE_LEFT: i64 = 80;
pub const SDL_SCANCODE_RIGHT: i64 = 79;
pub const SDL_SCANCODE_UP: i64 = 82;
pub const SDL_SCANCODE_DOWN: i64 = 81;
pub const SDL_SCANCODE_LSHIFT: i64 = 225;
pub const SDL_SCANCODE_RSHIFT: i64 = 229;
pub const SDL_SCANCODE_LCTRL: i64 = 224;
pub const SDL_SCANCODE_RCTRL: i64 = 228;

// Mouse buttons
pub const SDL_BUTTON_LEFT: i64 = 1;
pub const SDL_BUTTON_MIDDLE: i64 = 2;
pub const SDL_BUTTON_RIGHT: i64 = 3;

// Audio format
pub const AUDIO_S16SYS: i64 = 0x8010;

// ─── Wrapper Functions ────────────────────────────────────────────────────

/// Initialize SDL with the given subsystem flags.
/// Returns 0 on success, -1 on failure.
pub fn sdl_init(flags: i64) -> i64 {
    return sdl_init_raw(flags);
}

/// Shut down SDL and free all resources.
pub fn sdl_quit() -> void {
    sdl_quit_raw();
}

/// Create a window with centered position.
/// Returns window handle (i64 pointer) or 0 on failure.
pub fn sdl_create_window(title: str, width: i64, height: i64) -> i64 {
    return sdl_create_window_raw(title, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, width, height, SDL_WINDOW_SHOWN);
}

/// Create a hardware-accelerated renderer with vsync.
/// Returns renderer handle or 0 on failure.
pub fn sdl_create_renderer(win: i64) -> i64 {
    return sdl_create_renderer_raw(win, -1, SDL_RENDERER_ACCELERATED | SDL_RENDERER_VSYNC);
}

/// Destroy a renderer.
pub fn sdl_destroy_renderer(ren: i64) -> void {
    sdl_destroy_renderer_raw(ren);
}

/// Destroy a window.
pub fn sdl_destroy_window(win: i64) -> void {
    sdl_destroy_window_raw(win);
}

/// Clear the screen with the current draw color.
pub fn sdl_render_clear(ren: i64) -> void {
    sdl_render_clear_raw(ren);
}

/// Present the rendered frame (swap buffers).
pub fn sdl_render_present(ren: i64) -> void {
    sdl_render_present_raw(ren);
}

/// Set the draw color (r, g, b, a — each 0-255).
pub fn sdl_set_draw_color(ren: i64, r: i64, g: i64, b: i64, a: i64) -> void {
    sdl_set_draw_color_raw(ren, r, g, b, a);
}

/// Draw a filled rectangle (pass 0 for rect to fill entire screen).
pub fn sdl_fill_rect(ren: i64, rect: i64) -> void {
    sdl_fill_rect_raw(ren, rect);
}

/// Draw a line from (x1,y1) to (x2,y2).
pub fn sdl_draw_line(ren: i64, x1: i64, y1: i64, x2: i64, y2: i64) -> void {
    sdl_draw_line_raw(ren, x1, y1, x2, y2);
}

/// Draw a single point at (x, y).
pub fn sdl_draw_point(ren: i64, x: i64, y: i64) -> void {
    sdl_draw_point_raw(ren, x, y);
}

/// Delay (sleep) for the given milliseconds.
pub fn sdl_delay(ms: i64) -> void {
    sdl_delay_raw(ms);
}

/// Get ticks (milliseconds since SDL init).
pub fn sdl_get_ticks() -> i64 {
    return sdl_get_ticks_raw();
}

/// Get the last SDL error message.
pub fn sdl_get_error() -> str {
    return sdl_get_error_raw();
}

// ─── Input (Keyboard + Mouse) ────────────────────────────────────────────

// Input state (kept in Fides, updated by sdl_poll_events)
pub struct SdlInputState {
    pub keys: Vec<i64>,        // 512 scancodes, 1 = held
    pub prev_keys: Vec<i64>,   // previous frame state
    pub mouse_x: i64,
    pub mouse_y: i64,
    pub mouse_buttons: i64,    // bitmask
    pub prev_mouse_buttons: i64,
    pub quit_requested: bool,
}

/// Create a new input state tracker.
pub fn sdl_input_create() -> SdlInputState {
    var keys = Vec::new();
    var prev_keys = Vec::new();
    var i = 0;
    while i < 512 {
        keys.push(0);
        prev_keys.push(0);
        i = i + 1;
    }
    return SdlInputState {
        keys: keys,
        prev_keys: prev_keys,
        mouse_x: 0,
        mouse_y: 0,
        mouse_buttons: 0,
        prev_mouse_buttons: 0,
        quit_requested: false,
    };
}

/// Poll SDL events and update input state.
/// Call this once per frame before checking input.
pub fn sdl_poll_events(state: &mut SdlInputState) -> void {
    // Save previous state
    var i = 0;
    while i < 512 {
        state.prev_keys.set(i, state.keys.get(i));
        i = i + 1;
    }
    state.prev_mouse_buttons = state.mouse_buttons;

    // Poll all pending events via a native helper that fills the state.
    // The actual event polling requires passing pointers to SDL_Event structs,
    // which is handled by the native runtime (pledge_sdl_poll).
    // In the interpreter, this is a no-op.
    //
    // Native builds call pledge_sdl_poll which:
    //   1. Polls SDL events (SDL_PollEvent in a loop)
    //   2. Sets quit_requested if SDL_QUIT received
    //   3. Calls SDL_GetKeyboardState and copies 512 bytes to keys array
    //   4. Calls SDL_GetMouseState for mouse x/y/buttons
    pledge_sdl_poll_events(state);
}

// Native runtime helper: polls SDL events and fills SdlInputState.
// In the interpreter, this is a no-op.
// In native builds, this calls SDL_PollEvent, SDL_GetKeyboardState, SDL_GetMouseState.
extern "C" include "pledge_sdl.h" link "" {
    fn pledge_sdl_poll_events(state: i64) -> void;
}

/// Check if a key is currently held down.
pub fn sdl_key_held(state: &SdlInputState, scancode: i64) -> bool {
    if scancode < 0 || scancode >= 512 { return false; }
    return state.keys.get(scancode) != 0;
}

/// Check if a key was just pressed this frame (held now, not held last frame).
pub fn sdl_key_pressed(state: &SdlInputState, scancode: i64) -> bool {
    if scancode < 0 || scancode >= 512 { return false; }
    return state.keys.get(scancode) != 0 && state.prev_keys.get(scancode) == 0;
}

/// Check if a key was just released this frame (not held now, held last frame).
pub fn sdl_key_released(state: &SdlInputState, scancode: i64) -> bool {
    if scancode < 0 || scancode >= 512 { return false; }
    return state.keys.get(scancode) == 0 && state.prev_keys.get(scancode) != 0;
}

/// Check if a mouse button is held (button: SDL_BUTTON_LEFT/MIDDLE/RIGHT).
pub fn sdl_mouse_held(state: &SdlInputState, button: i64) -> bool {
    return (state.mouse_buttons & (1 << (button - 1))) != 0;
}

/// Check if a mouse button was just pressed.
pub fn sdl_mouse_pressed(state: &SdlInputState, button: i64) -> bool {
    var now: bool = (state.mouse_buttons & (1 << (button - 1))) != 0;
    var prev: bool = (state.prev_mouse_buttons & (1 << (button - 1))) != 0;
    return now && !prev;
}

/// Get mouse X position.
pub fn sdl_mouse_x(state: &SdlInputState) -> i64 {
    return state.mouse_x;
}

/// Get mouse Y position.
pub fn sdl_mouse_y(state: &SdlInputState) -> i64 {
    return state.mouse_y;
}

/// Check if the user requested quit (close button, Alt+F4).
pub fn sdl_quit_requested(state: &SdlInputState) -> bool {
    return state.quit_requested;
}

// ─── Texture / Image Loading ─────────────────────────────────────────────

/// Load an image file (PNG, JPG, BMP) as a texture.
/// Returns texture handle or 0 on failure.
pub fn sdl_load_texture(ren: i64, path: str) -> i64 {
    var surf: i64 = img_load_raw(path);
    if surf == 0 { return 0; }
    var tex: i64 = sdl_texture_from_surface(ren, surf);
    sdl_free_surface(surf);
    return tex;
}

/// Destroy a texture.
pub fn sdl_destroy_texture(tex: i64) -> void {
    sdl_destroy_texture_raw(tex);
}

/// Draw a texture at position (x, y) with width w and height h.
/// Pass 0 for src to draw the whole texture.
pub fn sdl_draw_texture(ren: i64, tex: i64, x: i64, y: i64, w: i64, h: i64) -> void {
    // The SDL_RenderCopy takes SDL_Rect pointers for src and dst.
    // We use a native helper that builds the rect and calls SDL_RenderCopy.
    pledge_sdl_draw_texture(ren, tex, x, y, w, h);
}

// Native helper: draws a texture at the given position.
extern "C" include "pledge_sdl.h" link "" {
    fn pledge_sdl_draw_texture(ren: i64, tex: i64, x: i64, y: i64, w: i64, h: i64) -> void;
}

// ─── Audio ───────────────────────────────────────────────────────────────

/// Initialize SDL_mixer audio (44100 Hz, 16-bit, stereo, 1024 chunk).
/// Returns 0 on success, -1 on failure.
pub fn sdl_audio_init() -> i64 {
    return mix_open(44100, AUDIO_S16SYS, 2, 1024);
}

/// Shut down SDL_mixer.
pub fn sdl_audio_shutdown() -> void {
    mix_close();
}

/// Load a WAV file. Returns chunk handle or 0 on failure.
pub fn sdl_audio_load(path: str) -> i64 {
    return mix_load_wav_raw(path);
}

/// Play a sound on a channel. Returns the channel used, or -1 on failure.
/// Pass -1 for channel to use any free channel.
/// Pass 0 for loops to play once, -1 for infinite looping.
pub fn sdl_audio_play(channel: i64, chunk: i64, loops: i64) -> i64 {
    return mix_play(channel, chunk, loops);
}

/// Stop playback on a channel. Pass -1 for all channels.
pub fn sdl_audio_stop(channel: i64) -> void {
    mix_halt(channel);
}

/// Set volume for a channel (0-128). Pass -1 for all channels.
pub fn sdl_audio_volume(channel: i64, volume: i64) -> void {
    mix_volume(channel, volume);
}

/// Free a loaded sound chunk.
pub fn sdl_audio_free(chunk: i64) -> void {
    mix_free_chunk(chunk);
}

/// Check if a channel is currently playing.
pub fn sdl_audio_playing(channel: i64) -> bool {
    return mix_playing(channel) != 0;
}

/// Pause a channel.
pub fn sdl_audio_pause(channel: i64) -> void {
    mix_pause(channel);
}

/// Resume a paused channel.
pub fn sdl_audio_resume(channel: i64) -> void {
    mix_resume(channel);
}
