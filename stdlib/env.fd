// Fides Environment Variable standard library
//
// Provides access to environment variables.
// In the interpreter, these use Rust's std::env.
// In C codegen, these use C's getenv().
// In native builds, p_getenv is a stub (returns null).
//
// Usage:
//   use env;
//   value home = env_get("HOME");
//   if home == "" {
//       print("HOME not set\n");
//   }

module env;
/// Get an environment variable value.
/// Returns empty string if the variable is not set.
///
/// Example:
///   var path = env_get("PATH");
///   assert(str_len(path) > 0);
///   assert_eq(env_get("FIDES_DOCTEST_SURELY_UNSET"), "");
pub fn env_get(name: str) -> str {
    match env_var(name) {
        Option::Some(value) => {
            return value;
        }
        Option::None => {
        }
    }
    return "";
}

/// An environment variable that holds a credential (an API key, a token,
/// a password), or "" when it is not set. The result is `@secret`
/// (complaint CO1): the compiler rejects a program in which it reaches
/// print, a log, a file, the network, a global or another task. To send it
/// as a credential, do so in a function you mark `@declassify` (an audited
/// release).
///
///   val key = env_secret("API_KEY");
///   println(key);                     // error: a secret value reaches output
@secret
pub fn env_secret(name: str) -> str {
    return env_get(name);
}

/// Check if an environment variable exists.
///
/// Example:
///   assert(env_exists("PATH"));
///   assert(!env_exists("FIDES_DOCTEST_SURELY_UNSET"));
pub fn env_exists(name: str) -> bool {
    var value: i64 = p_getenv(name);
    return value != 0;
}

// ─── Compatibility aliases for os.fd ────────────────────────────────────
// These allow code written for os.fd's API to work with `use env;`.

/// Alias for os_getenv — get an environment variable value.
///
/// Example:
///   assert_eq(os_getenv("PATH"), env_get("PATH"));
pub fn os_getenv(name: str) -> str {
    return env_get(name);
}

/// Alias for os_hasenv — check if an environment variable is set.
///
/// Example:
///   assert(!os_hasenv("FIDES_DOCTEST_SURELY_UNSET"));
pub fn os_hasenv(name: str) -> bool {
    return env_exists(name);
}
