// Fides Environment Variable standard library
//
// Provides access to environment variables.
// In the interpreter, these use Rust's std::env.
// In C codegen, these use C's getenv().
// In native builds, p_getenv is a stub (returns null).
//
// Usage:
//   use env;
//   value home = env_get("HOME");
//   if home == "" {
//       print("HOME not set\n");
//   }

module env;

/// Get an environment variable value.
/// Returns empty string if the variable is not set.
pub fn env_get(name: str) -> str {
    val value = p_getenv(name);
    if value == 0 {
        return "";
    }
    return value;
}

/// Check if an environment variable exists.
pub fn env_exists(name: str) -> bool {
    val value = p_getenv(name);
    return value != 0;
}
