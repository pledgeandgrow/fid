    ec5_put(&mut k, 0x428a2f98d728ae22);
    ec5_put(&mut k, 0x7137449123ef65cd);
    ec5_put(&mut k, 0xb5c0fbcfec4d3b2f);
    ec5_put(&mut k, 0xe9b5dba58189dbbc);
    ec5_put(&mut k, 0x3956c25bf348b538);
    ec5_put(&mut k, 0x59f111f1b605d019);
    ec5_put(&mut k, 0x923f82a4af194f9b);
    ec5_put(&mut k, 0xab1c5ed5da6d8118);
    ec5_put(&mut k, 0xd807aa98a3030242);
    ec5_put(&mut k, 0x12835b0145706fbe);
    ec5_put(&mut k, 0x243185be4ee4b28c);
    ec5_put(&mut k, 0x550c7dc3d5ffb4e2);
    ec5_put(&mut k, 0x72be5d74f27b896f);
    ec5_put(&mut k, 0x80deb1fe3b1696b1);
    ec5_put(&mut k, 0x9bdc06a725c71235);
    ec5_put(&mut k, 0xc19bf174cf692694);
    ec5_put(&mut k, 0xe49b69c19ef14ad2);
    ec5_put(&mut k, 0xefbe4786384f25e3);
    ec5_put(&mut k, 0x0fc19dc68b8cd5b5);
    ec5_put(&mut k, 0x240ca1cc77ac9c65);
    ec5_put(&mut k, 0x2de92c6f592b0275);
    ec5_put(&mut k, 0x4a7484aa6ea6e483);
    ec5_put(&mut k, 0x5cb0a9dcbd41fbd4);
    ec5_put(&mut k, 0x76f988da831153b5);
    ec5_put(&mut k, 0x983e5152ee66dfab);
    ec5_put(&mut k, 0xa831c66d2db43210);
    ec5_put(&mut k, 0xb00327c898fb213f);
    ec5_put(&mut k, 0xbf597fc7beef0ee4);
    ec5_put(&mut k, 0xc6e00bf33da88fc2);
    ec5_put(&mut k, 0xd5a79147930aa725);
    ec5_put(&mut k, 0x06ca6351e003826f);
    ec5_put(&mut k, 0x142929670a0e6e70);
    ec5_put(&mut k, 0x27b70a8546d22ffc);
