// Fides elliptic-curve signatures and key agreement on the NIST prime
// curves P-256 (secp256r1), P-384 (secp384r1) and P-521 (secp521r1),
// with SHA-384 written here (the hash P-384 is paired with): field and point
// arithmetic, ECDSA signing with deterministic nonces (RFC 6979) and
// verification (FIPS 186-5 §6.4), ECDH (SEC 1 §3.3.1, the x coordinate of
// d Q), SEC 1 point encoding (uncompressed 04 || X || Y and compressed
// 02/03 || X), and DER or raw r || s signatures.
//
// Pure computation, no platform seam. Field elements are Montgomery
// residues on rsa.fd's 28-bit-limb engine (RsaMont), one context for the
// field prime p and one for the group order n. Points are Jacobian
// (X, Y, Z) with a = -3 doubling formulas; scalar multiplication uses a
// fixed 4-bit window, verification Shamir's trick (u1 G + u2 Q sharing
// the doublings). Inversions are Fermat powers.
//
// Scalar multiplication runs a fixed operation pattern (four doublings,
// a masked 16-way table lookup and a complete add/double select per
// nibble), so secret scalars do not set the operation count; residual
// exposure is inside the limb arithmetic itself (branches on limb values
// in rsa.fd helpers) and in the interpreter's own scheduling — fine for
// verification, tests, and ordinary signing; a signer facing physical
// side-channel attackers still wants hardware-level analysis.
//
// Checked against RFC 6979 §A.2.5 (P-256, SHA-256, "sample" and "test":
// k, r and s byte-exact) and OpenSSL-made keys, signatures and ECDH
// secrets in tests/bootstrap/test_std_ecdsa.fd; SHA-384 against FIPS 180
// examples, P-384/SHA-384 and P-521/SHA-512 deterministic signatures
// byte-exact against OpenSSL 3.5 (nonce-type 1, RFC 6979).
//
// Hash ids are kdf.fd's (KDF_SHA256, KDF_SHA512, ...) plus EC_SHA384;
// ec_hash / ec_hmac dispatch on all of them.
//
// Usage:
//   use ecdsa;
//   val c = ec_p256();
//   val pub = ec_public_key(& c, priv32);              // 04 || X || Y
//   val sig = ecdsa_sign(& c, priv32, KDF_SHA256, msg); // r || s, 64 bytes
//   val good = ecdsa_verify(& c, pub, KDF_SHA256, msg, sig);
//   val z = ecdh_shared(& c, priv32, peer_pub);         // 32 bytes or empty

module ecdsa;
use vec;
use encoding;
use asn1;
use kdf;
use rsa;

/// A short-Weierstrass curve y^2 = x^3 - 3x + b over GF(p).
pub struct EcCurve {
    pub name: str,
    pub oid: str,
    pub len: i64,
    pub qbits: i64,
    pub fp: RsaMont,
    pub fq: RsaMont,
    pub p: Vec<i64>,
    pub n: Vec<i64>,
    pub b: Vec<i64>,
    pub gx: Vec<i64>,
    pub gy: Vec<i64>,
}

/// A point in Jacobian coordinates, Montgomery form; inf = the identity.
pub struct EcPoint {
    pub x: Vec<i64>,
    pub y: Vec<i64>,
    pub z: Vec<i64>,
    pub inf: bool,
}

fn ec_make(name: str, oid: str, len: i64, qbits: i64, p: str, b: str, gx: str, gy: str, n: str) -> EcCurve {
    val pb: Vec<i64> = hex_decode_bytes(p);
    val nb: Vec<i64> = hex_decode_bytes(n);
    val fp: RsaMont = rsa_mont_new(pb);
    val fnm: RsaMont = rsa_mont_new(nb);
    val bl: Vec<i64> = rsa_limbs_from_bytes(hex_decode_bytes(b), fp.s);
    val xl: Vec<i64> = rsa_limbs_from_bytes(hex_decode_bytes(gx), fp.s);
    val yl: Vec<i64> = rsa_limbs_from_bytes(hex_decode_bytes(gy), fp.s);
    return EcCurve {
        name: name, oid: oid, len: len, qbits: qbits, fp: fp, fq: fnm, p: pb, n: nb, b: rsa_mont_to(&fp, &bl), gx: rsa_mont_to(&fp, &xl), gy: rsa_mont_to(&fp, &yl)
    };
}

/// NIST P-256 (SEC 2 secp256r1).
pub fn ec_p256() -> EcCurve {
    return ec_make("P-256", "1.2.840.10045.3.1.7", 32, 256, "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff", "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b", "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296", "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5", "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551");
}

/// NIST P-384 (SEC 2 secp384r1).
pub fn ec_p384() -> EcCurve {
    return ec_make("P-384", "1.3.132.0.34", 48, 384, "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff", "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef", "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7", "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f", "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973");
}

/// NIST P-521 (SEC 2 secp521r1): 66-byte values, a 521-bit order.
pub fn ec_p521() -> EcCurve {
    return ec_make("P-521", "1.3.132.0.35", 66, 521, "01ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff", "0051953eb9618e1c9a1f929a21a0b68540eea2da725b99b315f3b8b489918ef109e156193951ec7e937b1652c0bd3bb1bf073573df883d2c34f1ef451fd46b503f00", "00c6858e06b70404e9cd9e3ecb662395b4429c648139053fb521f828af606b4d3dbaa14b5e77efe75928fe1dc127a2ffa8de3348b3c1856a429bf97e7e31c2e5bd66", "011839296a789a3bc0045c8a5fb42c7d1bd998f54449579b446817afbd17273e662c97ee72995ef42640c550b9013fad0761353c7086a272c24088be94769fd16650", "01fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffa51868783bf2f966b7fcc0148f709a5d03bb5c9b8899c47aebb6fb71e91386409");
}

/// The curve named by an OID ("" name when unknown, then len is 0).
pub fn ec_curve_by_oid(oid: str) -> EcCurve {
    if str_equal(oid, "1.3.132.0.34") {
        return ec_p384();
    }
    if str_equal(oid, "1.3.132.0.35") {
        return ec_p521();
    }
    var c: EcCurve = ec_p256();
    if !str_equal(oid, "1.2.840.10045.3.1.7") {
        c.name = "";
        c.len = 0;
    }
    return c;
}

// ─── SHA-384 (FIPS 180-4 §6.5) and hash dispatch ─────────────────────
//
// SHA-512's compression with the SHA-384 initial value, truncated to 48
// bytes. The round function mirrors sha512.fd (whose helpers are private).

pub const EC_SHA384: i64 = 4;

fn ec5_put(v: &mut Vec<i64>, x: u64) {
    v.push(x as i64);
}

/// The 80 round constants K0..K79 (cube roots of the first 80 primes).
fn ec5_k() -> Vec<i64> {
