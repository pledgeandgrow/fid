    return k;
}

@wrapping
fn ec5_rotr(x: u64, n: u64) -> u64 {
    return (x >> n) | (x << (64 - n));
}

/// One 128-byte block of m at `off` into the state h (8 words).
@wrapping
fn ec5_block(h: &mut Vec<i64>, k: &Vec<i64>, w: &mut Vec<i64>, m: &Vec<i64>, off: i64) {
    var i: i64 = 0;
    while i < 16 {
        var x: u64 = 0;
        var j: i64 = 0;
        while j < 8 {
            x = (x << 8) | ((m.get(off + i * 8 + j) & 255) as u64);
            j = j + 1;
        }
        w.set(i, x as i64);
        i = i + 1;
    }
    while i < 80 {
        val w15: u64 = w.get(i - 15) as u64;
        val w2: u64 = w.get(i - 2) as u64;
        val s0: u64 = ec5_rotr(w15, 1) ^ ec5_rotr(w15, 8) ^ (w15 >> 7);
        val s1: u64 = ec5_rotr(w2, 19) ^ ec5_rotr(w2, 61) ^ (w2 >> 6);
        val nw: u64 = (w.get(i - 16) as u64) + s0 + (w.get(i - 7) as u64) + s1;
        w.set(i, nw as i64);
        i = i + 1;
    }
    var a: u64 = h.get(0) as u64;
    var b: u64 = h.get(1) as u64;
    var c: u64 = h.get(2) as u64;
    var d: u64 = h.get(3) as u64;
    var e: u64 = h.get(4) as u64;
    var f: u64 = h.get(5) as u64;
    var g: u64 = h.get(6) as u64;
    var hh: u64 = h.get(7) as u64;
    i = 0;
    while i < 80 {
        val bs1: u64 = ec5_rotr(e, 14) ^ ec5_rotr(e, 18) ^ ec5_rotr(e, 41);
        val ch: u64 = (e & f) ^ (~e & g);
        val t1: u64 = hh + bs1 + ch + (k.get(i) as u64) + (w.get(i) as u64);
        val bs0: u64 = ec5_rotr(a, 28) ^ ec5_rotr(a, 34) ^ ec5_rotr(a, 39);
        val mj: u64 = (a & b) ^ (a & c) ^ (b & c);
        val t2: u64 = bs0 + mj;
        hh = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
        i = i + 1;
    }
    h.set(0, ((h.get(0) as u64) + a) as i64);
    h.set(1, ((h.get(1) as u64) + b) as i64);
    h.set(2, ((h.get(2) as u64) + c) as i64);
    h.set(3, ((h.get(3) as u64) + d) as i64);
    h.set(4, ((h.get(4) as u64) + e) as i64);
    h.set(5, ((h.get(5) as u64) + f) as i64);
    h.set(6, ((h.get(6) as u64) + g) as i64);
    h.set(7, ((h.get(7) as u64) + hh) as i64);
}

/// SHA-384 of bytes: the 48-byte digest.
pub fn ec_sha384(msg: Vec<i64>) -> Vec<i64> {
    val n: i64 = msg.len();
    var m: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        m.push(msg.get(i) & 255);
        i = i + 1;
    }
    m.push(128);
    while m.len() % 128 != 112 {
        m.push(0);
    }
    i = 0;
    while i < 8 {
        m.push(0);
        i = i + 1;
    }
    val bits: i64 = n * 8;
    i = 7;
    while i >= 0 {
        m.push((bits >> (i * 8)) & 255);
        i = i - 1;
    }
    var h: Vec<i64> = Vec::new();
    ec5_put(&mut h, 0xcbbb9d5dc1059ed8);
    ec5_put(&mut h, 0x629a292a367cd507);
    ec5_put(&mut h, 0x9159015a3070dd17);
    ec5_put(&mut h, 0x152fecd8f70e5939);
    ec5_put(&mut h, 0x67332667ffc00b31);
    ec5_put(&mut h, 0x8eb44a8768581511);
    ec5_put(&mut h, 0xdb0c2e0d64f98fa7);
    ec5_put(&mut h, 0x47b5481dbefa4fa4);
    val k: Vec<i64> = ec5_k();
    var w: Vec<i64> = Vec::new();
    i = 0;
    while i < 80 {
        w.push(0);
        i = i + 1;
    }
    var off: i64 = 0;
    while off < m.len() {
        ec5_block(&mut h, &k, &mut w, &m, off);
        off = off + 128;
    }
    var out: Vec<i64> = Vec::new();
    i = 0;
    while i < 6 {
        val x: i64 = h.get(i);
        var sh: i64 = 56;
        while sh >= 0 {
            out.push((x >> sh) & 255);
            sh = sh - 8;
        }
        i = i + 1;
    }
    return out;
}

/// The digest of msg with hash h (a kdf.fd id or EC_SHA384).
pub fn ec_hash(h: i64, msg: Vec<i64>) -> Vec<i64> {
    if h == EC_SHA384 {
        return ec_sha384(msg);
    }
    return kdf_hash(h, msg);
}

/// Digest length in bytes.
pub fn ec_hash_len(h: i64) -> i64 {
    if h == EC_SHA384 {
        return 48;
    }
    return kdf_hash_len(h);
}

/// HMAC (RFC 2104) with hash h, SHA-384 included (RFC 4231).
pub fn ec_hmac(h: i64, key: Vec<i64>, msg: Vec<i64>) -> Vec<i64> {
    if h != EC_SHA384 {
        return kdf_hmac(h, key, msg);
    }
    var kb: Vec<i64> = Vec::new();
    var i: i64 = 0;
    if key.len() > 128 {
        kb = ec_sha384(key);
    } else {
        while i < key.len() {
            kb.push(key.get(i) & 255);
            i = i + 1;
        }
    }
    while kb.len() < 128 {
        kb.push(0);
    }
    var inner: Vec<i64> = Vec::new();
    i = 0;
    while i < 128 {
        inner.push(kb.get(i) ^ 0x36);
        i = i + 1;
    }
    i = 0;
    while i < msg.len() {
        inner.push(msg.get(i) & 255);
        i = i + 1;
    }
    val ih: Vec<i64> = ec_sha384(inner);
    var outer: Vec<i64> = Vec::new();
    i = 0;
    while i < 128 {
        outer.push(kb.get(i) ^ 0x5c);
        i = i + 1;
    }
    i = 0;
    while i < ih.len() {
        outer.push(ih.get(i));
        i = i + 1;
    }
    return ec_sha384(outer);
}

// ─── Field helpers ─────────────────────────────────────────────────────

fn ec_mul(c: &EcCurve, a: &Vec<i64>, b: &Vec<i64>) -> Vec<i64> {
    return rsa_mont_mul(&c.fp, a, b);
}

fn ec_add(c: &EcCurve, a: &Vec<i64>, b: &Vec<i64>) -> Vec<i64> {
    return rsa_mont_add(&c.fp, a, b);
}

fn ec_sub(c: &EcCurve, a: &Vec<i64>, b: &Vec<i64>) -> Vec<i64> {
    return rsa_mont_sub(&c.fp, a, b);
}

fn ec_is_zero(a: &Vec<i64>) -> bool {
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn ec_zero(s: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < s {
        v.push(0);
        i = i + 1;
    }
    return v;
}

fn ec_eq(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Big-endian bytes minus a small number (no underflow below zero).
fn ec_bytes_minus(b: Vec<i64>, v: i64) -> Vec<i64> {
    var out: Vec<i64> = b;
    var borrow: i64 = v;
    var i: i64 = out.len() - 1;
    while i >= 0 && borrow > 0 {
        var x: i64 = out.get(i) - (borrow & 255);
        borrow = borrow >> 8;
        if x < 0 {
            x = x + 256;
            borrow = borrow + 1;
        }
        out.set(i, x);
        i = i - 1;
    }
    return out;
}

fn ec_bytes_plus1_div4(b: Vec<i64>) -> Vec<i64> {
    // (p + 1) / 4 for p = 3 mod 4: add 1, then shift right by 2 bits.
    var x: Vec<i64> = b;
    var carry: i64 = 1;
    var i: i64 = x.len() - 1;
    while i >= 0 && carry > 0 {
        val v: i64 = x.get(i) + carry;
        x.set(i, v & 255);
        carry = v >> 8;
        i = i - 1;
    }
    var out: Vec<i64> = Vec::new();
    var prev: i64 = carry;
    i = 0;
    while i < x.len() {
        val v: i64 = x.get(i);
        out.push(((prev << 6) | (v >> 2)) & 255);
        prev = v & 3;
        i = i + 1;
    }
    return out;
}

/// The inverse of a non-zero field element (a^(p-2)).
fn ec_inv(c: &EcCurve, a: &Vec<i64>) -> Vec<i64> {
    return rsa_mont_pow(&c.fp, a, ec_bytes_minus(c.p, 2));
}

/// A field element (Montgomery form) to len big-endian bytes.
fn ec_fe_bytes(c: &EcCurve, a: &Vec<i64>) -> Vec<i64> {
    val plain: Vec<i64> = rsa_mont_from(&c.fp, a);
    return rsa_limbs_to_bytes(&plain, c.len);
}

/// Bytes below p to a field element; empty when the value is >= p.
fn ec_fe_from(c: &EcCurve, b: Vec<i64>) -> Vec<i64> {
    val l: Vec<i64> = rsa_limbs_from_bytes(b, c.fp.s);
    if b.len() != c.len || rsa_limbs_cmp(&l, &c.fp.n, c.fp.s) >= 0 {
        return Vec::new();
    }
    return rsa_mont_to(&c.fp, &l);
}

// ─── Points ────────────────────────────────────────────────────────────

/// The identity.
pub fn ec_infinity(c: &EcCurve) -> EcPoint {
    return EcPoint {
        x: c.fp.one, y: c.fp.one, z: ec_zero(c.fp.s), inf: true
    };
}

/// The base point G.
pub fn ec_generator(c: &EcCurve) -> EcPoint {
    return EcPoint {
        x: c.gx, y: c.gy, z: c.fp.one, inf: false
    };
}

/// OR-reduction of a limb vector: 1 when every limb is zero, else 0. The
/// loop count depends only on the vector's length.
fn ec_zero_mask(a: &Vec<i64>) -> i64 {
    var w: i64 = 0;
    var i: i64 = 0;
    while i < a.len() {
        w = w | a.get(i);
        i = i + 1;
    }
    if w == 0 {
        return 1;
    }
    return 0;
}

/// The limbs of `a` when `bit` is 0, of `b` when `bit` is 1; one mask per
/// word, no branch on the value.
fn ec_limbs_ct_select(a: &Vec<i64>, b: &Vec<i64>, bit: i64) -> Vec<i64> {
    val mask: i64 = 0 - bit;
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        val av: i64 = a.get(i);
        out.push(av ^ ((av ^ b.get(i)) & mask));
        i = i + 1;
    }
    return out;
}

/// `a` when `bit` is 0, `b` when 1, selected by limb masks.
fn ec_point_ct_select(a: &EcPoint, b: &EcPoint, bit: i64) -> EcPoint {
    var inf: bool = a.inf;
    if bit == 1 {
        inf = b.inf;
    }
    return EcPoint {
        x: ec_limbs_ct_select(&a.x, &b.x, bit), y: ec_limbs_ct_select(&a.y, &b.y, bit), z: ec_limbs_ct_select(&a.z, &b.z, bit), inf: inf,
    };
}

/// The add-2007-bl formula with no operand-dependent early outs; `h` and
/// `rr` are exposed for the constant-time case select in ec_point_add_ct.
fn ec_add_raw(c: &EcCurve, p: &EcPoint, q: &EcPoint, h: &mut Vec<i64>, rr: &mut Vec<i64>) -> EcPoint {
    val z1z1: Vec<i64> = ec_mul(c, &p.z, &p.z);
    val z2z2: Vec<i64> = ec_mul(c, &q.z, &q.z);
    val u1: Vec<i64> = ec_mul(c, &p.x, &z2z2);
    val u2: Vec<i64> = ec_mul(c, &q.x, &z1z1);
    val s1: Vec<i64> = ec_mul(c, &ec_mul(c, &p.y, &q.z), &z2z2);
    val s2: Vec<i64> = ec_mul(c, &ec_mul(c, &q.y, &p.z), &z1z1);
    *h = ec_sub(c, &u2, &u1);
    *rr = ec_sub(c, &s2, &s1);
    val h2: Vec<i64> = ec_add(c, h, h);
    val i: Vec<i64> = ec_mul(c, &h2, &h2);
    val j: Vec<i64> = ec_mul(c, h, &i);
    val r2: Vec<i64> = ec_add(c, rr, rr);
    val v: Vec<i64> = ec_mul(c, &u1, &i);
    val x3: Vec<i64> = ec_sub(c, &ec_sub(c, &ec_mul(c, &r2, &r2), &j), &ec_add(c, &v, &v));
    val sj: Vec<i64> = ec_mul(c, &s1, &j);
    val y3: Vec<i64> = ec_sub(c, &ec_mul(c, &r2, &ec_sub(c, &v, &x3)), &ec_add(c, &sj, &sj));
    val zz: Vec<i64> = ec_add(c, &p.z, &q.z);
    val z3: Vec<i64> = ec_mul(c, &ec_sub(c, &ec_sub(c, &ec_mul(c, &zz, &zz), &z1z1), &z2z2), h);
    return EcPoint {
        x: x3, y: y3, z: z3, inf: false
    };
}

/// The dbl-2001-b formula with no operand-dependent early outs.
fn ec_double_raw(c: &EcCurve, p: &EcPoint) -> EcPoint {
    val delta: Vec<i64> = ec_mul(c, &p.z, &p.z);
    val gamma: Vec<i64> = ec_mul(c, &p.y, &p.y);
    val beta: Vec<i64> = ec_mul(c, &p.x, &gamma);
    val t1: Vec<i64> = ec_sub(c, &p.x, &delta);
    val t2: Vec<i64> = ec_add(c, &p.x, &delta);
    val t3: Vec<i64> = ec_mul(c, &t1, &t2);
    val alpha: Vec<i64> = ec_add(c, &ec_add(c, &t3, &t3), &t3);
    val beta2: Vec<i64> = ec_add(c, &beta, &beta);
    val beta4: Vec<i64> = ec_add(c, &beta2, &beta2);
    val beta8: Vec<i64> = ec_add(c, &beta4, &beta4);
    val x3: Vec<i64> = ec_sub(c, &ec_mul(c, &alpha, &alpha), &beta8);
    val yz: Vec<i64> = ec_add(c, &p.y, &p.z);
    val z3: Vec<i64> = ec_sub(c, &ec_sub(c, &ec_mul(c, &yz, &yz), &gamma), &delta);
    val g2: Vec<i64> = ec_mul(c, &gamma, &gamma);
    val g4: Vec<i64> = ec_add(c, &g2, &g2);
    val g8: Vec<i64> = ec_add(c, &ec_add(c, &g4, &g4), &ec_add(c, &g4, &g4));
    val y3: Vec<i64> = ec_sub(c, &ec_mul(c, &alpha, &ec_sub(c, &beta4, &x3)), &g8);
    return EcPoint {
        x: x3, y: y3, z: z3, inf: false
    };
}

/// 2P (dbl-2001-b, a = -3).
pub fn ec_double(c: &EcCurve, p: &EcPoint) -> EcPoint {
    if p.inf || ec_is_zero(&p.y) {
        return ec_infinity(c);
    }
    return ec_double_raw(c, p);
}

/// P + Q with a fixed operation pattern: both formulas are computed
/// unconditionally and the result picked by limb masks — the constant-time
/// addition a secret scalar multiply needs.
fn ec_point_add_ct(c: &EcCurve, p: &EcPoint, q: &EcPoint) -> EcPoint {
    var h: Vec<i64> = Vec::new();
    var rr: Vec<i64> = Vec::new();
    val sum: EcPoint = ec_add_raw(c, p, q, &mut h, &mut rr);
    val dbl: EcPoint = ec_double_raw(c, p);
    val hz: i64 = ec_zero_mask(&h);
    val rz: i64 = ec_zero_mask(&rr);
    val yz: i64 = ec_zero_mask(&p.y);
    var pi: i64 = 0;
    if p.inf {
        pi = 1;
    }
    var qi: i64 = 0;
    if q.inf {
        qi = 1;
    }
    val inf_pt: EcPoint = ec_infinity(c);
    var out: EcPoint = sum;
    // h == 0 means P == ±Q: rr == 0 doubles (y == 0 gives the point at
    // infinity), rr != 0 is P + (-P) = O.
    out = ec_point_ct_select(&out, &inf_pt, hz & (1 - rz));
    out = ec_point_ct_select(&out, &dbl, hz & rz & (1 - yz));
    out = ec_point_ct_select(&out, &inf_pt, hz & rz & yz);
    // An identity operand returns the other point (an identity twice over
    // is still the identity — the last select hands back `q` = O).
    out = ec_point_ct_select(&out, p, qi);
    out = ec_point_ct_select(&out, q, pi);
    return out;
}

/// P + Q (add-2007-bl), doubling or the identity where it must.
pub fn ec_point_add(c: &EcCurve, p: &EcPoint, q: &EcPoint) -> EcPoint {
    if p.inf {
        return *q;
    }
    if q.inf {
        return *p;
    }
    val z1z1: Vec<i64> = ec_mul(c, &p.z, &p.z);
    val z2z2: Vec<i64> = ec_mul(c, &q.z, &q.z);
    val u1: Vec<i64> = ec_mul(c, &p.x, &z2z2);
    val u2: Vec<i64> = ec_mul(c, &q.x, &z1z1);
    val s1: Vec<i64> = ec_mul(c, &ec_mul(c, &p.y, &q.z), &z2z2);
    val s2: Vec<i64> = ec_mul(c, &ec_mul(c, &q.y, &p.z), &z1z1);
    val h: Vec<i64> = ec_sub(c, &u2, &u1);
    val rr: Vec<i64> = ec_sub(c, &s2, &s1);
    if ec_is_zero(&h) {
        if ec_is_zero(&rr) {
            return ec_double(c, p);
        }
        return ec_infinity(c);
    }
    val h2: Vec<i64> = ec_add(c, &h, &h);
    val i: Vec<i64> = ec_mul(c, &h2, &h2);
    val j: Vec<i64> = ec_mul(c, &h, &i);
    val r: Vec<i64> = ec_add(c, &rr, &rr);
    val v: Vec<i64> = ec_mul(c, &u1, &i);
    val x3: Vec<i64> = ec_sub(c, &ec_sub(c, &ec_mul(c, &r, &r), &j), &ec_add(c, &v, &v));
    val sj: Vec<i64> = ec_mul(c, &s1, &j);
    val y3: Vec<i64> = ec_sub(c, &ec_mul(c, &r, &ec_sub(c, &v, &x3)), &ec_add(c, &sj, &sj));
    val zz: Vec<i64> = ec_add(c, &p.z, &q.z);
    val z3: Vec<i64> = ec_mul(c, &ec_sub(c, &ec_sub(c, &ec_mul(c, &zz, &zz), &z1z1), &z2z2), &h);
    return EcPoint {
        x: x3, y: y3, z: z3, inf: false
    };
}

fn ec_table(c: &EcCurve, p: &EcPoint) -> Vec<EcPoint> {
    var t: Vec<EcPoint> = Vec::new();
    t.push(ec_infinity(c));
    t.push(*p);
    var k: i64 = 2;
    while k < 16 {
        val prev: EcPoint = t.get(k - 1);
        t.push(ec_point_add(c, &prev, p));
        k = k + 1;
    }
    return t;
}

/// k P for a scalar given as big-endian bytes (any length).
///
/// Constant operation pattern: four doublings, a 16-way masked table
/// lookup and a complete addition per nibble, whatever the scalar's bits —
/// the number of point operations and the field work in each do not
/// depend on `k`. (The table itself is built from `p`, public in every
/// use: the generator or the peer's key.)
pub fn ec_scalar_mul(c: &EcCurve, k: Vec<i64>, p: &EcPoint) -> EcPoint {
    val t: Vec<EcPoint> = ec_table(c, p);
    val inf_pt: EcPoint = ec_infinity(c);
    var acc: EcPoint = ec_infinity(c);
    var i: i64 = 0;
    while i < k.len() {
        val byte: i64 = k.get(i) & 255;
        var half: i64 = 0;
        while half < 2 {
            var nib: i64 = byte >> 4;
            if half == 1 {
                nib = byte & 15;
            }
            var d: i64 = 0;
            while d < 4 {
                val db: EcPoint = ec_double_raw(c, &acc);
                var di: i64 = ec_zero_mask(&acc.y);
                if acc.inf {
                    di = 1;
                }
                acc = ec_point_ct_select(&db, &inf_pt, di);
                d = d + 1;
            }
            var tp: EcPoint = t.get(0);
            var m: i64 = 1;
            while m < 16 {
                val tm: EcPoint = t.get(m);
                var sel: i64 = 0;
                if m == nib {
                    sel = 1;
                }
                tp = ec_point_ct_select(&tp, &tm, sel);
                m = m + 1;
            }
            acc = ec_point_add_ct(c, &acc, &tp);
            half = half + 1;
        }
        i = i + 1;
    }
    return acc;
}

/// a G + b Q (Shamir's trick), scalars as len-byte big-endian values.
pub fn ec_double_mul(c: &EcCurve, a: Vec<i64>, b: Vec<i64>, q: &EcPoint) -> EcPoint {
    val g: EcPoint = ec_generator(c);
    val tg: Vec<EcPoint> = ec_table(c, &g);
    val tq: Vec<EcPoint> = ec_table(c, q);
    var acc: EcPoint = ec_infinity(c);
    var i: i64 = 0;
    while i < a.len() {
        var half: i64 = 0;
        while half < 2 {
            var na: i64 = (a.get(i) >> 4) & 15;
            var nb: i64 = (b.get(i) >> 4) & 15;
            if half == 1 {
                na = a.get(i) & 15;
                nb = b.get(i) & 15;
            }
            if !acc.inf {
                var d: i64 = 0;
                while d < 4 {
                    acc = ec_double(c, &acc);
                    d = d + 1;
                }
            }
            if na != 0 {
                val pa: EcPoint = tg.get(na);
                acc = ec_point_add(c, &acc, &pa);
            }
            if nb != 0 {
                val pb: EcPoint = tq.get(nb);
                acc = ec_point_add(c, &acc, &pb);
            }
            half = half + 1;
        }
        i = i + 1;
    }
    return acc;
}

/// The affine coordinates of a point as X || Y bytes (empty for the
/// identity).
pub fn ec_affine_bytes(c: &EcCurve, p: &EcPoint) -> Vec<i64> {
    if p.inf {
        return Vec::new();
    }
    val zi: Vec<i64> = ec_inv(c, &p.z);
    val zi2: Vec<i64> = ec_mul(c, &zi, &zi);
    val zi3: Vec<i64> = ec_mul(c, &zi2, &zi);
    val x: Vec<i64> = ec_fe_bytes(c, &ec_mul(c, &p.x, &zi2));
    val y: Vec<i64> = ec_fe_bytes(c, &ec_mul(c, &p.y, &zi3));
    return asn1_cat(x, y);
}

fn ec_rhs(c: &EcCurve, x: &Vec<i64>) -> Vec<i64> {
    // x^3 - 3x + b
    val x2: Vec<i64> = ec_mul(c, x, x);
    val x3: Vec<i64> = ec_mul(c, &x2, x);
    val tx: Vec<i64> = ec_add(c, &ec_add(c, x, x), x);
    return ec_add(c, &ec_sub(c, &x3, &tx), &c.b);
}

/// Decode a SEC 1 point (04 || X || Y, or 02/03 || X); inf true when the
/// bytes are not a point on the curve.
pub fn ec_point_decode(c: &EcCurve, data: Vec<i64>) -> EcPoint {
    val bad: EcPoint = ec_infinity(c);
    val l: i64 = c.len;
    if data.len() == 2 * l + 1 && data.get(0) == 4 {
        val x: Vec<i64> = ec_fe_from(c, asn1_slice(&data, 1, 1 + l));
        val y: Vec<i64> = ec_fe_from(c, asn1_slice(&data, 1 + l, 1 + 2 * l));
        if x.len() == 0 || y.len() == 0 {
            return bad;
        }
        if !ec_eq(&ec_mul(c, &y, &y), &ec_rhs(c, &x)) {
            return bad;
        }
        return EcPoint {
            x: x, y: y, z: c.fp.one, inf: false
        };
    }
    if data.len() == l + 1 && (data.get(0) == 2 || data.get(0) == 3) {
        val x: Vec<i64> = ec_fe_from(c, asn1_slice(&data, 1, 1 + l));
        if x.len() == 0 {
            return bad;
        }
        val rhs: Vec<i64> = ec_rhs(c, &x);
        var y: Vec<i64> = rsa_mont_pow(&c.fp, &rhs, ec_bytes_plus1_div4(c.p));
        if !ec_eq(&ec_mul(c, &y, &y), &rhs) {
            return bad;
        }
        val yb: Vec<i64> = ec_fe_bytes(c, &y);
        if (yb.get(l - 1) & 1) != (data.get(0) & 1) {
            y = ec_sub(c, &ec_zero(c.fp.s), &y);
        }
        return EcPoint {
            x: x, y: y, z: c.fp.one, inf: false
        };
    }
    return bad;
}

/// SEC 1 encoding of a point: uncompressed (04 || X || Y) or compressed.
pub fn ec_point_encode(c: &EcCurve, p: &EcPoint, compressed: bool) -> Vec<i64> {
    val xy: Vec<i64> = ec_affine_bytes(c, p);
    var out: Vec<i64> = Vec::new();
    if xy.len() == 0 {
        out.push(0);
        return out;
    }
    if compressed {
        out.push(2 + (xy.get(2 * c.len - 1) & 1));
        return asn1_cat(out, asn1_slice(&xy, 0, c.len));
    }
    out.push(4);
    return asn1_cat(out, xy);
}

// ─── Scalars modulo n ──────────────────────────────────────────────────

fn ec_n_limbs(c: &EcCurve, b: Vec<i64>) -> Vec<i64> {
    // Reduce a value below 2^(8 len) modulo n: at most one subtraction
    // for these curves (n > 2^(8 len - 1)).
    var l: Vec<i64> = rsa_limbs_from_bytes(b, c.fq.s);
    if rsa_limbs_cmp(&l, &c.fq.n, c.fq.s) >= 0 {
        l = rsa_mont_sub(&c.fq, &l, &c.fq.n);
    }
    return l;
}

fn ec_scalar_ok(c: &EcCurve, d: Vec<i64>) -> bool {
    if d.len() != c.len {
        return false;
    }
    val l: Vec<i64> = rsa_limbs_from_bytes(d, c.fq.s);
    return !ec_is_zero(&l) && rsa_limbs_cmp(&l, &c.fq.n, c.fq.s) < 0;
}

/// bits2int (RFC 6979 §2.3.2): the leftmost qlen bits of a bit string,
/// as len bytes (P-521: qlen 521, a 66-byte value).
fn ec_bits2int(c: &EcCurve, h: Vec<i64>) -> Vec<i64> {
    val hbits: i64 = 8 * h.len();
    if hbits <= c.qbits {
        var out: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < c.len - h.len() {
            out.push(0);
            i = i + 1;
        }
        return asn1_cat(out, h);
    }
    // Shift right by hbits - qbits bits, keep the low len bytes.
    val shift: i64 = hbits - c.qbits;
    val sb: i64 = shift / 8;
    val r: i64 = shift % 8;
    var full: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < h.len() {
        var v: i64 = 0;
        if k - sb >= 0 {
            v = (h.get(k - sb) & 255) >> r;
        }
        if r > 0 && k - sb - 1 >= 0 {
            v = v | ((h.get(k - sb - 1) << (8 - r)) & 255);
        }
        full.push(v & 255);
        k = k + 1;
    }
    return asn1_slice(&full, h.len() - c.len, h.len());
}

/// bits2octets: bits2int reduced modulo n.
fn ec_bits2octets(c: &EcCurve, h: Vec<i64>) -> Vec<i64> {
    return rsa_limbs_to_bytes(&ec_n_limbs(c, ec_bits2int(c, h)), c.len);
}

/// The RFC 6979 nonce for private key d and message hash h1.
pub fn ecdsa_rfc6979_k(c: &EcCurve, hash: i64, d: Vec<i64>, h1: Vec<i64>) -> Vec<i64> {
    val hl: i64 = ec_hash_len(hash);
    var v: Vec<i64> = Vec::new();
    var kk: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < hl {
        v.push(1);
        kk.push(0);
        i = i + 1;
    }
    val x: Vec<i64> = d;
    val ho: Vec<i64> = ec_bits2octets(c, h1);
    var m: Vec<i64> = v;
    m.push(0);
    kk = ec_hmac(hash, kk, asn1_cat(asn1_cat(m, x), ho));
    v = ec_hmac(hash, kk, v);
    m = v;
    m.push(1);
    kk = ec_hmac(hash, kk, asn1_cat(asn1_cat(m, x), ho));
    v = ec_hmac(hash, kk, v);
    while true {
        var t: Vec<i64> = Vec::new();
        while t.len() < c.len {
            v = ec_hmac(hash, kk, v);
            t = asn1_cat(t, v);
        }
        val k: Vec<i64> = ec_bits2int(c, t);
        if ec_scalar_ok(c, k) {
            return k;
        }
        var m2: Vec<i64> = v;
        m2.push(0);
        kk = ec_hmac(hash, kk, m2);
        v = ec_hmac(hash, kk, v);
    }
    return Vec::new();
}

// ─── Keys, ECDSA, ECDH ─────────────────────────────────────────────────

/// The public point d G of a private scalar (len bytes, 1..n-1) as an
/// uncompressed SEC 1 point; empty for an invalid scalar.
pub fn ec_public_key(c: &EcCurve, d: Vec<i64>) -> Vec<i64> {
    if !ec_scalar_ok(c, d) {
        return Vec::new();
    }
    val g: EcPoint = ec_generator(c);
    val p: EcPoint = ec_scalar_mul(c, d, &g);
    return ec_point_encode(c, &p, false);
}

/// ECDSA signature r || s (2 len bytes) of msg with the nonce k given;
/// empty when k or d is invalid or r or s comes out zero.
pub fn ecdsa_sign_with_k(c: &EcCurve, d: Vec<i64>, hash: i64, msg: Vec<i64>, k: Vec<i64>) -> Vec<i64> {
    if !ec_scalar_ok(c, d) || !ec_scalar_ok(c, k) {
        return Vec::new();
    }
    val g: EcPoint = ec_generator(c);
    val rp: EcPoint = ec_scalar_mul(c, k, &g);
    val xy: Vec<i64> = ec_affine_bytes(c, &rp);
    if xy.len() == 0 {
        return Vec::new();
    }
    val r: Vec<i64> = ec_n_limbs(c, asn1_slice(&xy, 0, c.len));
    if ec_is_zero(&r) {
        return Vec::new();
    }
    val e: Vec<i64> = ec_n_limbs(c, ec_bits2int(c, ec_hash(hash, msg)));
    val fnm: RsaMont = c.fq;
    val dl: Vec<i64> = rsa_limbs_from_bytes(d, fnm.s);
    val kl: Vec<i64> = rsa_limbs_from_bytes(k, fnm.s);
    // s = k^-1 (e + r d) mod n, in Montgomery form throughout.
    val rm: Vec<i64> = rsa_mont_to(&fnm, &r);
    val dm: Vec<i64> = rsa_mont_to(&fnm, &dl);
    val em: Vec<i64> = rsa_mont_to(&fnm, &e);
    val km: Vec<i64> = rsa_mont_to(&fnm, &kl);
    val kinv: Vec<i64> = rsa_mont_pow(&fnm, &km, ec_bytes_minus(c.n, 2));
    val sum: Vec<i64> = rsa_mont_add(&fnm, &em, &rsa_mont_mul(&fnm, &rm, &dm));
    val s: Vec<i64> = rsa_mont_from(&fnm, &rsa_mont_mul(&fnm, &kinv, &sum));
    if ec_is_zero(&s) {
        return Vec::new();
    }
    return asn1_cat(rsa_limbs_to_bytes(&r, c.len), rsa_limbs_to_bytes(&s, c.len));
}

/// Deterministic ECDSA (RFC 6979): r || s.
pub fn ecdsa_sign(c: &EcCurve, d: Vec<i64>, hash: i64, msg: Vec<i64>) -> Vec<i64> {
    val k: Vec<i64> = ecdsa_rfc6979_k(c, hash, d, ec_hash(hash, msg));
    return ecdsa_sign_with_k(c, d, hash, msg, k);
}

/// Verify an r || s signature against a SEC 1 public key.
pub fn ecdsa_verify(c: &EcCurve, public_key: Vec<i64>, hash: i64, msg: Vec<i64>, sig: Vec<i64>) -> bool {
    if sig.len() != 2 * c.len {
        return false;
    }
    val rb: Vec<i64> = asn1_slice(&sig, 0, c.len);
    val sb: Vec<i64> = asn1_slice(&sig, c.len, 2 * c.len);
    if !ec_scalar_ok(c, rb) || !ec_scalar_ok(c, sb) {
        return false;
    }
    val q: EcPoint = ec_point_decode(c, public_key);
    if q.inf {
        return false;
    }
    val fnm: RsaMont = c.fq;
    val r: Vec<i64> = rsa_limbs_from_bytes(rb, fnm.s);
    val s: Vec<i64> = rsa_limbs_from_bytes(sb, fnm.s);
    val e: Vec<i64> = ec_n_limbs(c, ec_bits2int(c, ec_hash(hash, msg)));
    val sm: Vec<i64> = rsa_mont_to(&fnm, &s);
    val w: Vec<i64> = rsa_mont_pow(&fnm, &sm, ec_bytes_minus(c.n, 2));
    val u1: Vec<i64> = rsa_mont_from(&fnm, &rsa_mont_mul(&fnm, &rsa_mont_to(&fnm, &e), &w));
    val u2: Vec<i64> = rsa_mont_from(&fnm, &rsa_mont_mul(&fnm, &rsa_mont_to(&fnm, &r), &w));
    val pt: EcPoint = ec_double_mul(c, rsa_limbs_to_bytes(&u1, c.len), rsa_limbs_to_bytes(&u2, c.len), &q);
    val xy: Vec<i64> = ec_affine_bytes(c, &pt);
    if xy.len() == 0 {
        return false;
    }
    val v: Vec<i64> = ec_n_limbs(c, asn1_slice(&xy, 0, c.len));
    return ec_eq(&v, &r);
}

/// ECDH: the x coordinate of d Q (len bytes); empty when the peer key is
/// not a valid point or the result is the identity.
pub fn ecdh_shared(c: &EcCurve, d: Vec<i64>, peer_public: Vec<i64>) -> Vec<i64> {
    if !ec_scalar_ok(c, d) {
        return Vec::new();
    }
    val q: EcPoint = ec_point_decode(c, peer_public);
    if q.inf {
        return Vec::new();
    }
    val p: EcPoint = ec_scalar_mul(c, d, &q);
    val xy: Vec<i64> = ec_affine_bytes(c, &p);
    if xy.len() == 0 {
        return Vec::new();
    }
    return asn1_slice(&xy, 0, c.len);
}

// ─── Signature encodings ───────────────────────────────────────────────

/// r || s to the DER Ecdsa-Sig-Value SEQUENCE { r INTEGER, s INTEGER }.
pub fn ecdsa_sig_to_der(sig: Vec<i64>) -> Vec<i64> {
    val l: i64 = sig.len() / 2;
    return asn1_enc_seq(asn1_cat(asn1_enc_uint(asn1_slice(&sig, 0, l)), asn1_enc_uint(asn1_slice(&sig, l, 2 * l))));
}

fn ec_pad(b: Vec<i64>, len: i64) -> Vec<i64> {
    if b.len() > len {
        return Vec::new();
    }
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < len - b.len() {
        out.push(0);
        i = i + 1;
    }
    return asn1_cat(out, b);
}

/// A DER signature to r || s of 2 len bytes; empty when malformed.
pub fn ecdsa_sig_from_der(der: Vec<i64>, len: i64) -> Vec<i64> {
    val t: Asn1Tlv = asn1_read_der(&der, 0, der.len());
    if !asn1_is(t, ASN1_SEQUENCE) || t.end != der.len() {
        return Vec::new();
    }
    val kids: Vec<Asn1Tlv> = asn1_children(&der, t);
    if kids.len() != 2 || !asn1_is(kids.get(0), ASN1_INTEGER) || !asn1_is(kids.get(1), ASN1_INTEGER) {
        return Vec::new();
    }
    if asn1_int_negative(&der, kids.get(0)) || asn1_int_negative(&der, kids.get(1)) {
        return Vec::new();
    }
    if !asn1_int_minimal(&der, kids.get(0)) || !asn1_int_minimal(&der, kids.get(1)) {
        return Vec::new();
    }
    val r: Vec<i64> = ec_pad(asn1_get_uint_bytes(&der, kids.get(0)), len);
    val s: Vec<i64> = ec_pad(asn1_get_uint_bytes(&der, kids.get(1)), len);
    if r.len() == 0 || s.len() == 0 {
        return Vec::new();
    }
    return asn1_cat(r, s);
}

/// Verify a DER-encoded signature (as X.509 and TLS carry them).
pub fn ecdsa_verify_der(c: &EcCurve, public_key: Vec<i64>, hash: i64, msg: Vec<i64>, der: Vec<i64>) -> bool {
    val sig: Vec<i64> = ecdsa_sig_from_der(der, c.len);
    if sig.len() == 0 {
        return false;
    }
    return ecdsa_verify(c, public_key, hash, msg, sig);
}
