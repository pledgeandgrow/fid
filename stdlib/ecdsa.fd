    ec5_put(&mut k, 0x650a73548baf63de);
    ec5_put(&mut k, 0x766a0abb3c77b2a8);
    ec5_put(&mut k, 0x81c2c92e47edaee6);
    ec5_put(&mut k, 0x92722c851482353b);
    ec5_put(&mut k, 0xa2bfe8a14cf10364);
    ec5_put(&mut k, 0xa81a664bbc423001);
    ec5_put(&mut k, 0xc24b8b70d0f89791);
    ec5_put(&mut k, 0xc76c51a30654be30);
    ec5_put(&mut k, 0xd192e819d6ef5218);
    ec5_put(&mut k, 0xd69906245565a910);
    ec5_put(&mut k, 0xf40e35855771202a);
    ec5_put(&mut k, 0x106aa07032bbd1b8);
    ec5_put(&mut k, 0x19a4c116b8d2d0c8);
