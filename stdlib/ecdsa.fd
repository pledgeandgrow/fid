    ec5_put(&mut k, 0x34b0bcb5e19b48a8);
    ec5_put(&mut k, 0x391c0cb3c5c95a63);
    ec5_put(&mut k, 0x4ed8aa4ae3418acb);
    ec5_put(&mut k, 0x5b9cca4f7763e373);
    ec5_put(&mut k, 0x682e6ff3d6b2b8a3);
    ec5_put(&mut k, 0x748f82ee5defb2fc);
    ec5_put(&mut k, 0x78a5636f43172f60);
    ec5_put(&mut k, 0x84c87814a1f0ab72);
