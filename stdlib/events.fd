// stdlib/events.fd — Event system (Phase 8B: F20)
//
// Event handlers are defined with the `on` keyword:
//   on click(x: i64, y: i64) {
//       print("clicked at ", x, ", ", y);
//   }
//
// The compiler desugars `on event_name(params) { body }` into
// `fn __on_event_name(params) { body }`.
//
// To dispatch an event, call the handler function directly:
//   __on_click(10, 20);
//
// In a game loop, you would typically dispatch events from the input system:
//   fn game_loop() {
//       while true {
//           // Process input
//           if input_is_key_pressed("space") {
//               __on_key("space");
//           }
//           // Update systems
//           // Render
//       }
//   }

