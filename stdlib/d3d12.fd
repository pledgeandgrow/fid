// Fides Direct3D 12: bindings to d3d12.dll / dxgi.dll, COM method calls
// through vtable slots, the core structs as C memory images, and helpers
// that need no GPU.
//
// Platform seam (Windows 10+ with a D3D12 driver; the tests call none):
//   - the plain C exports, declared directly: D3D12CreateDevice,
//     D3D12GetDebugInterface, D3D12SerializeRootSignature (d3d12.dll) and
//     CreateDXGIFactory2 (dxgi.dll);
//   - COM methods: a COM object's first word points to its vtable, an array
//     of function pointers in the interface's declaration order. Fides
//     cannot call a function pointer itself, so d3d_com_call reads the slot
//     (unsafe, real) and calls it through a 6-line C shim the program links
//     (library "fides_com"):
//         #include <stdint.h>
//         typedef int64_t (*fides_com_fn)(void *, int64_t, int64_t, int64_t,
//                                         int64_t, int64_t, int64_t);
//         int64_t fides_com_call(int64_t fn, int64_t self, int64_t a,
//                 int64_t b, int64_t c, int64_t d, int64_t e, int64_t f) {
//             return ((fides_com_fn)fn)((void *)self, a, b, c, d, e, f);
//         }
//     Unused trailing arguments are ignored by the callee (Windows x64).
//     HRESULTs come back in the low 32 bits (d3d_hr). Methods returning a
//     struct (GetCPUDescriptorHandleForHeapStart, GetDesc) take a hidden
//     pointer to the result after `this` (MSVC member-function ABI);
//     d3d_heap_cpu_start shows the pattern.
//
// Real, tested without a GPU: the vtable slot numbers of the main
// interfaces (from d3d12.h's declaration order), interface IIDs and GUID
// byte layout, HRESULT names, resource states and barrier rules, DXGI
// format sizes, C struct layouts with nested structs and arrays (sizes as
// the x64 compiler lays them out: D3D12_RESOURCE_DESC 56,
// D3D12_RESOURCE_BARRIER 32, D3D12_GRAPHICS_PIPELINE_STATE_DESC 656, ...),
// builders for those structs (byte images with relocated pointers, copied
// to C memory by d3d_blob_to_mem), resource barrier builders, a root
// signature builder with the 64-DWORD cost limit, and texture upload
// footprints (GetCopyableFootprints' 256-byte row pitch and 512-byte
// placement alignment).
//
// Usage:
//   use d3d12;
//   var b: D3dBlob = d3d_blob_new();
//   val bar: i64 = d3d_barrier_transition(&mut b, texture, 0xFFFFFFFF,
//       D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
//   val mem: i64 = d3d_blob_to_mem(&b);
//   d3d_com_call(cmdlist, D3D12_GCL_RESOURCE_BARRIER, 1, mem + bar, 0, 0, 0, 0);

module d3d12;
use vec;

// ─── DLL exports and the COM shim (platform seam) ──────────────────────────

// SAFETY: each declaration matches the d3d12.h prototype it names (pointers
// and interfaces as i64, UINT as u32, HRESULT as i32); riid points to a
// 16-byte GUID (d3d_guid_mem).
extern "C" link "d3d12" {
    fn D3D12CreateDevice as d3d12_create_device(pAdapter: i64, minimumFeatureLevel: u32, riid: i64, ppDevice: i64) -> i32;
    fn D3D12GetDebugInterface as d3d12_get_debug_interface(riid: i64, ppvDebug: i64) -> i32;
    fn D3D12SerializeRootSignature as d3d12_serialize_root_signature(pRootSignature: i64, version: u32, ppBlob: i64, ppErrorBlob: i64) -> i32;
}

// SAFETY: as above, from dxgi1_4.h.
extern "C" link "dxgi" {
    fn CreateDXGIFactory2 as dxgi_create_factory2(flags: u32, riid: i64, ppFactory: i64) -> i32;
}

// SAFETY: fides_com_call calls `fn` with `self` and six integer arguments
// (the C shim in the header); fn must be a method of self's interface whose
// parameters are all integers or pointers.
extern "C" link "fides_com" {
    fn fides_com_call as p_fides_com_call(func: i64, obj: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64;
}

/// The function pointer in vtable slot `slot` of COM object `obj`.
pub fn d3d_vtable_fn(obj: i64, slot: i64) -> i64 {
    // SAFETY: obj is a live COM interface pointer: its first word is the
    // vtable address and slot is within the interface (the constants below).
    unsafe {
        var o: *mut i64 = obj;
        var v: *mut i64 = (*o) + 8 * slot;
        return *v;
    }
}

/// Call method `slot` of `obj` with up to six integer/pointer arguments.
pub fn d3d_com_call(obj: i64, slot: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    return p_fides_com_call(d3d_vtable_fn(obj, slot), obj, a, b, c, d, e, f);
}

/// IUnknown::Release.
pub fn d3d_release(obj: i64) -> i64 {
    return d3d_com_call(obj, D3D_IUNKNOWN_RELEASE, 0, 0, 0, 0, 0, 0);
}

/// ID3D12DescriptorHeap::GetCPUDescriptorHandleForHeapStart: the struct
/// result goes through a hidden out pointer.
pub fn d3d_heap_cpu_start(heap: i64) -> i64 {
    val slot: i64 = d3d_out_new();
    d3d_com_call(heap, D3D12_HEAP_GET_CPU_START, slot, 0, 0, 0, 0, 0);
    return d3d_out_read(slot);
}

pub fn d3d_out_new() -> i64 {
    // SAFETY: an 8-byte block the caller owns, zeroed.
    unsafe {
        val p: i64 = p_malloc(8);
        var q: *mut i64 = p;
        *q = 0;
        return p;
    }
}

pub fn d3d_out_read(slot: i64) -> i64 {
    // SAFETY: slot came from d3d_out_new.
    unsafe {
        var q: *mut i64 = slot;
        return *q;
    }
}

