fn d3d_hexval(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    return -1;
}

/// The 16 bytes of a GUID in memory ("xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"):
/// Data1 (4 bytes), Data2, Data3 (2 each) little-endian, Data4 as written.
/// Empty on a malformed string.
pub fn d3d_guid_bytes(s: str) -> Vec<i64> {
    var hex: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < str_len(s) {
        val c: i64 = str_byte_at(s, i);
        if c != 45 && c != 123 && c != 125 {
            val v: i64 = d3d_hexval(c);
            if v < 0 {
                return Vec::new();
            }
            hex.push(v);
        }
        i = i + 1;
    }
    if hex.len() != 32 {
        return Vec::new();
    }
    var raw: Vec<i64> = Vec::new();
    i = 0;
    while i < 16 {
        raw.push(hex.get(2 * i) * 16 + hex.get(2 * i + 1));
        i = i + 1;
    }
    var out: Vec<i64> = Vec::new();
    out.push(raw.get(3));
    out.push(raw.get(2));
    out.push(raw.get(1));
    out.push(raw.get(0));
    out.push(raw.get(5));
    out.push(raw.get(4));
    out.push(raw.get(7));
    out.push(raw.get(6));
    i = 8;
    while i < 16 {
        out.push(raw.get(i));
        i = i + 1;
    }
    return out;
}

/// Back to the textual form.
pub fn d3d_guid_str(b: &Vec<i64>) -> str {
    val d: str = "0123456789abcdef";
    var order: Vec<i64> = Vec::new();
    order.push(3);
    order.push(2);
    order.push(1);
    order.push(0);
    order.push(5);
    order.push(4);
    order.push(7);
    order.push(6);
    var i: i64 = 8;
    while i < 16 {
        order.push(i);
        i = i + 1;
    }
    var s: str = "";
    i = 0;
    while i < 16 {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            s = s + "-";
        }
        val x: i64 = b.get(order.get(i));
        s = s + byte_to_str(str_byte_at(d, x >> 4)) + byte_to_str(str_byte_at(d, x & 15));
        i = i + 1;
    }
    return s;
}

/// A GUID in C memory, for riid arguments.
pub fn d3d_guid_mem(s: str) -> i64 {
    var b: D3dBlob = d3d_blob_new();
    val g: Vec<i64> = d3d_guid_bytes(s);
    val at: i64 = d3d_blob_alloc(&mut b, 16, 4);
    var i: i64 = 0;
    while i < g.len() {
        b.bytes.set(at + i, g.get(i));
        i = i + 1;
    }
    return d3d_blob_to_mem(&b);
}

// ─── HRESULTs ──────────────────────────────────────────────────────────────

/// The HRESULT in the low 32 bits of a call's result, sign-extended.
pub fn d3d_hr(raw: i64) -> i64 {
    val v: i64 = raw & 0xFFFFFFFF;
    if v >= 0x80000000 {
        return v - 0x100000000;
    }
    return v;
}

pub fn d3d_succeeded(hr: i64) -> bool {
    return d3d_hr(hr) >= 0;
}

pub fn d3d_hr_name(hr: i64) -> str {
    val v: i64 = hr & 0xFFFFFFFF;
    if v == 0 {
        return "S_OK";
    }
    if v == 1 {
        return "S_FALSE";
    }
    if v == 0x80004001 {
        return "E_NOTIMPL";
    }
    if v == 0x80004002 {
        return "E_NOINTERFACE";
    }
    if v == 0x80004003 {
        return "E_POINTER";
    }
    if v == 0x80004005 {
        return "E_FAIL";
    }
    if v == 0x8007000E {
        return "E_OUTOFMEMORY";
    }
    if v == 0x80070057 {
        return "E_INVALIDARG";
    }
    if v == 0x887A0001 {
        return "DXGI_ERROR_INVALID_CALL";
    }
    if v == 0x887A0004 {
        return "DXGI_ERROR_UNSUPPORTED";
    }
    if v == 0x887A0005 {
        return "DXGI_ERROR_DEVICE_REMOVED";
    }
    if v == 0x887A0006 {
        return "DXGI_ERROR_DEVICE_HUNG";
    }
    if v == 0x887A0007 {
        return "DXGI_ERROR_DEVICE_RESET";
    }
    if v == 0x887A0020 {
        return "DXGI_ERROR_DRIVER_INTERNAL_ERROR";
    }
    if v == 0x887E0001 {
        return "D3D12_ERROR_ADAPTER_NOT_FOUND";
    }
    if v == 0x887E0002 {
        return "D3D12_ERROR_DRIVER_VERSION_MISMATCH";
    }
    return "HRESULT 0x" + d3d_hex(v);
}

fn d3d_hex(v: i64) -> str {
    val d: str = "0123456789ABCDEF";
    var s: str = "";
    var i: i64 = 7;
    while i >= 0 {
        s = s + byte_to_str(str_byte_at(d, (v >> (4 * i)) & 15));
        i = i - 1;
    }
    return s;
}

// ─── Resource states and barriers ──────────────────────────────────────────

pub const D3D12_RESOURCE_STATE_COMMON: i64 = 0;
pub const D3D12_RESOURCE_STATE_PRESENT: i64 = 0;
pub const D3D12_RESOURCE_STATE_VERTEX_AND_CONSTANT_BUFFER: i64 = 0x1;
pub const D3D12_RESOURCE_STATE_INDEX_BUFFER: i64 = 0x2;
pub const D3D12_RESOURCE_STATE_RENDER_TARGET: i64 = 0x4;
pub const D3D12_RESOURCE_STATE_UNORDERED_ACCESS: i64 = 0x8;
pub const D3D12_RESOURCE_STATE_DEPTH_WRITE: i64 = 0x10;
pub const D3D12_RESOURCE_STATE_DEPTH_READ: i64 = 0x20;
pub const D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE: i64 = 0x40;
pub const D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE: i64 = 0x80;
pub const D3D12_RESOURCE_STATE_STREAM_OUT: i64 = 0x100;
pub const D3D12_RESOURCE_STATE_INDIRECT_ARGUMENT: i64 = 0x200;
pub const D3D12_RESOURCE_STATE_COPY_DEST: i64 = 0x400;
pub const D3D12_RESOURCE_STATE_COPY_SOURCE: i64 = 0x800;
pub const D3D12_RESOURCE_STATE_RESOLVE_DEST: i64 = 0x1000;
pub const D3D12_RESOURCE_STATE_RESOLVE_SOURCE: i64 = 0x2000;
pub const D3D12_RESOURCE_STATE_GENERIC_READ: i64 = 0xAC3;

pub const D3D12_RESOURCE_BARRIER_TYPE_TRANSITION: i64 = 0;
pub const D3D12_RESOURCE_BARRIER_TYPE_ALIASING: i64 = 1;
pub const D3D12_RESOURCE_BARRIER_TYPE_UAV: i64 = 2;
pub const D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES: i64 = 0xFFFFFFFF;

pub const D3D12_STATES_WRITE: i64 = 0x151C;

/// Is a state combination legal? Read states combine freely; a write state
/// (render target, UAV, depth write, copy/resolve dest, stream out) stands
/// alone.
pub fn d3d_state_valid(s: i64) -> bool {
    val w: i64 = s & D3D12_STATES_WRITE;
    if w == 0 {
        return true;
    }
    return s == w && (w & (w - 1)) == 0;
}

/// Problems with a transition barrier.
pub fn d3d_validate_transition(before: i64, after: i64) -> Vec<str> {
    var e: Vec<str> = Vec::new();
    if !d3d_state_valid(before) {
        e.push("StateBefore combines a write state with others");
    }
    if !d3d_state_valid(after) {
        e.push("StateAfter combines a write state with others");
    }
    if before == after {
        e.push("StateBefore equals StateAfter (no transition needed)");
    }
    return e;
}

// ─── C struct layouts ──────────────────────────────────────────────────────

pub struct D3dLayout {
    pub name: str,
    pub fields: Vec<str>,
    pub offsets: Vec<i64>,
    pub sizes: Vec<i64>,
    pub size: i64,
    pub align: i64,
}

// Field lists: "name:type" (u8 u16 u32 i32 f32 u64 ptr); "name{ ... }" is a
// nested struct, "name[N]{ ... }" an array of them, "name[N]:type" an array
// of scalars. Unions are written as their largest member.
fn d3d_spec(name: str) -> str {
    if name == "D3D12_RESOURCE_DESC" {
        return "Dimension:u32 Alignment:u64 Width:u64 Height:u32 DepthOrArraySize:u16 MipLevels:u16 Format:u32 SampleDesc{ Count:u32 Quality:u32 } Layout:u32 Flags:u32";
    }
    if name == "D3D12_HEAP_PROPERTIES" {
        return "Type:u32 CPUPageProperty:u32 MemoryPoolPreference:u32 CreationNodeMask:u32 VisibleNodeMask:u32";
    }
    if name == "D3D12_RESOURCE_BARRIER" {
        return "Type:u32 Flags:u32 Transition{ pResource:ptr Subresource:u32 StateBefore:u32 StateAfter:u32 }";
    }
    if name == "D3D12_DESCRIPTOR_RANGE" {
        return "RangeType:u32 NumDescriptors:u32 BaseShaderRegister:u32 RegisterSpace:u32 OffsetInDescriptorsFromTableStart:u32";
    }
    if name == "D3D12_ROOT_PARAMETER" {
        return "ParameterType:u32 DescriptorTable{ NumDescriptorRanges:u32 pDescriptorRanges:ptr } ShaderVisibility:u32";
    }
    if name == "D3D12_ROOT_SIGNATURE_DESC" {
        return "NumParameters:u32 pParameters:ptr NumStaticSamplers:u32 pStaticSamplers:ptr Flags:u32";
    }
    if name == "D3D12_STATIC_SAMPLER_DESC" {
        return "Filter:u32 AddressU:u32 AddressV:u32 AddressW:u32 MipLODBias:f32 MaxAnisotropy:u32 ComparisonFunc:u32 BorderColor:u32 MinLOD:f32 MaxLOD:f32 ShaderRegister:u32 RegisterSpace:u32 ShaderVisibility:u32";
    }
    if name == "D3D12_COMMAND_QUEUE_DESC" {
        return "Type:u32 Priority:i32 Flags:u32 NodeMask:u32";
    }
    if name == "D3D12_DESCRIPTOR_HEAP_DESC" {
        return "Type:u32 NumDescriptors:u32 Flags:u32 NodeMask:u32";
    }
    if name == "D3D12_GRAPHICS_PIPELINE_STATE_DESC" {
        return "pRootSignature:ptr VS{ p:ptr n:u64 } PS{ p:ptr n:u64 } DS{ p:ptr n:u64 } HS{ p:ptr n:u64 } GS{ p:ptr n:u64 } StreamOutput{ pSODeclaration:ptr NumEntries:u32 pBufferStrides:ptr NumStrides:u32 RasterizedStream:u32 } BlendState{ AlphaToCoverageEnable:u32 IndependentBlendEnable:u32 RenderTarget[8]{ BlendEnable:u32 LogicOpEnable:u32 SrcBlend:u32 DestBlend:u32 BlendOp:u32 SrcBlendAlpha:u32 DestBlendAlpha:u32 BlendOpAlpha:u32 LogicOp:u32 RenderTargetWriteMask:u8 } } SampleMask:u32 RasterizerState{ FillMode:u32 CullMode:u32 FrontCounterClockwise:u32 DepthBias:i32 DepthBiasClamp:f32 SlopeScaledDepthBias:f32 DepthClipEnable:u32 MultisampleEnable:u32 AntialiasedLineEnable:u32 ForcedSampleCount:u32 ConservativeRaster:u32 } DepthStencilState{ DepthEnable:u32 DepthWriteMask:u32 DepthFunc:u32 StencilEnable:u32 StencilReadMask:u8 StencilWriteMask:u8 FrontFace{ StencilFailOp:u32 StencilDepthFailOp:u32 StencilPassOp:u32 StencilFunc:u32 } BackFace{ StencilFailOp:u32 StencilDepthFailOp:u32 StencilPassOp:u32 StencilFunc:u32 } } InputLayout{ pInputElementDescs:ptr NumElements:u32 } IBStripCutValue:u32 PrimitiveTopologyType:u32 NumRenderTargets:u32 RTVFormats[8]:u32 DSVFormat:u32 SampleDesc{ Count:u32 Quality:u32 } NodeMask:u32 CachedPSO{ p:ptr n:u64 } Flags:u32";
    }
    return "";
}

fn d3d_type_size(t: str) -> i64 {
    if t == "u8" {
        return 1;
    }
    if t == "u16" {
        return 2;
    }
    if t == "u64" || t == "ptr" {
        return 8;
    }
    return 4;
}

fn d3d_round(a: i64, n: i64) -> i64 {
    return ((n + a - 1) / a) * a;
}

// Lay out tokens from `at` to the matching "}" (or the end) at `base`.
// Returns [next token, size, align]; records fields when `emit`.
fn d3d_lay(l: &mut D3dLayout, toks: &Vec<str>, at: i64, prefix: str, base: i64, emit: bool) -> Vec<i64> {
    var i: i64 = at;
    var off: i64 = 0;
    var align: i64 = 1;
    while i < toks.len() && toks.get(i) != "}" {
        val t: str = toks.get(i);
        var count: i64 = 1;
        var name: str = t;
        if str_ends_with(t, "{") {
            name = str_slice(t, 0, str_len(t) - 1);
        } else {
            name = str_slice(t, 0, str_find(t, ":"));
        }
        val br: i64 = str_find(name, "[");
        var bare: str = name;
        if br >= 0 {
            count = str_parse_int(str_slice(name, br + 1, str_len(name) - 1));
            bare = str_slice(name, 0, br);
        }
        if str_ends_with(t, "{") {
            val dry: Vec<i64> = d3d_lay(l, toks, i + 1, "", 0, false);
            val sz: i64 = dry.get(1);
            val al: i64 = dry.get(2);
            off = d3d_round(al, off);
            if al > align {
                align = al;
            }
            var k: i64 = 0;
            while k < count {
                var p: str = prefix + bare;
                if br >= 0 {
                    p = p + "[" + int_to_str(k) + "]";
                }
                if emit {
                    d3d_lay(l, toks, i + 1, p + ".", base + off + k * sz, true);
                }
                k = k + 1;
            }
            off = off + count * sz;
            i = dry.get(0) + 1;
        } else {
            val ty: str = str_slice(t, str_find(t, ":") + 1, str_len(t));
            val sz: i64 = d3d_type_size(ty);
            off = d3d_round(sz, off);
            if sz > align {
                align = sz;
            }
            var k: i64 = 0;
            while k < count {
                if emit {
                    var p: str = prefix + bare;
                    if br >= 0 {
                        p = p + "[" + int_to_str(k) + "]";
                    }
                    l.fields.push(p);
                    l.offsets.push(base + off + k * sz);
                    l.sizes.push(sz);
                }
                k = k + 1;
            }
            off = off + count * sz;
            i = i + 1;
        }
    }
    var out: Vec<i64> = Vec::new();
    out.push(i);
    out.push(d3d_round(align, off));
    out.push(align);
    return out;
}

/// The layout of a known struct (empty fields when unknown).
pub fn d3d_layout(name: str) -> D3dLayout {
    var l: D3dLayout = D3dLayout {
        name: name, fields: Vec::new(), offsets: Vec::new(), sizes: Vec::new(), size: 0, align: 1
    };
    val spec: str = d3d_spec(name);
    if str_len(spec) == 0 {
        return l;
    }
    val toks: Vec<str> = str_split(spec, " ");
    val r: Vec<i64> = d3d_lay(&mut l, &toks, 0, "", 0, true);
    l.size = r.get(1);
    l.align = r.get(2);
    return l;
}

pub fn d3d_offset(l: &D3dLayout, field: str) -> i64 {
    var i: i64 = 0;
    while i < l.fields.len() {
        if l.fields.get(i) == field {
            return l.offsets.get(i);
        }
        i = i + 1;
    }
    return -1;
}

// ─── Blobs ─────────────────────────────────────────────────────────────────

pub struct D3dBlob {
    pub bytes: Vec<i64>,
    pub reloc_at: Vec<i64>,
    pub reloc_to: Vec<i64>,
}

pub fn d3d_blob_new() -> D3dBlob {
    return D3dBlob {
        bytes: Vec::new(), reloc_at: Vec::new(), reloc_to: Vec::new()
    };
}

pub fn d3d_blob_alloc(b: &mut D3dBlob, size: i64, align: i64) -> i64 {
    while b.bytes.len() % align != 0 {
        b.bytes.push(0);
    }
    val off: i64 = b.bytes.len();
    var i: i64 = 0;
    while i < size {
        b.bytes.push(0);
        i = i + 1;
    }
    return off;
}

pub fn d3d_put(b: &mut D3dBlob, off: i64, size: i64, v: i64) {
    var k: i64 = 0;
    while k < size {
        b.bytes.set(off + k, (v >> (8 * k)) & 255);
        k = k + 1;
    }
}

pub fn d3d_get(b: &D3dBlob, off: i64, size: i64) -> i64 {
    var v: i64 = 0;
    var k: i64 = size - 1;
    while k >= 0 {
        v = (v << 8) | b.bytes.get(off + k);
        k = k - 1;
    }
    return v;
}

pub fn d3d_set(b: &mut D3dBlob, base: i64, l: &D3dLayout, field: str, v: i64) {
    var i: i64 = 0;
    while i < l.fields.len() {
        if l.fields.get(i) == field {
            d3d_put(b, base + l.offsets.get(i), l.sizes.get(i), v);
            return;
        }
        i = i + 1;
    }
    panic("d3d12: " + l.name + " has no field " + field);
}

pub fn d3d_read(b: &D3dBlob, base: i64, l: &D3dLayout, field: str) -> i64 {
    val off: i64 = d3d_offset(l, field);
    if off < 0 {
        return -1;
    }
    var i: i64 = 0;
    while i < l.fields.len() {
        if l.fields.get(i) == field {
            return d3d_get(b, base + off, l.sizes.get(i));
        }
        i = i + 1;
    }
    return -1;
}

/// Pointer field -> blob offset `target` (patched by d3d_blob_to_mem).
pub fn d3d_set_ptr(b: &mut D3dBlob, base: i64, l: &D3dLayout, field: str, target: i64) {
    if target < 0 {
        d3d_set(b, base, l, field, 0);
        return;
    }
    b.reloc_at.push(base + d3d_offset(l, field));
    b.reloc_to.push(target);
}

/// Copy into C memory with internal pointers patched; free with p_free.
pub fn d3d_blob_to_mem(b: &D3dBlob) -> i64 {
    var n: i64 = b.bytes.len();
    if n == 0 {
        n = 8;
    }
    // SAFETY: n fresh bytes; writes stay inside them.
    unsafe {
        val base: i64 = p_malloc(n);
        var i: i64 = 0;
        while i < b.bytes.len() {
            var p: *mut u8 = base + i;
            *p = b.bytes.get(i) as u8;
            i = i + 1;
        }
        i = 0;
        while i < b.reloc_at.len() {
            var q: *mut i64 = base + b.reloc_at.get(i);
            *q = base + b.reloc_to.get(i);
            i = i + 1;
        }
        return base;
    }
}

// ─── Struct builders ───────────────────────────────────────────────────────

pub const D3D12_RESOURCE_DIMENSION_BUFFER: i64 = 1;
pub const D3D12_RESOURCE_DIMENSION_TEXTURE2D: i64 = 3;
pub const D3D12_TEXTURE_LAYOUT_ROW_MAJOR: i64 = 1;
pub const D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET: i64 = 0x1;
pub const D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL: i64 = 0x2;
pub const D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS: i64 = 0x4;
pub const D3D12_HEAP_TYPE_DEFAULT: i64 = 1;
pub const D3D12_HEAP_TYPE_UPLOAD: i64 = 2;
pub const D3D12_HEAP_TYPE_READBACK: i64 = 3;

/// D3D12_RESOURCE_DESC of a buffer (row-major, as buffers must be).
pub fn d3d_resource_desc_buffer(b: &mut D3dBlob, size: i64, flags: i64) -> i64 {
    val l: D3dLayout = d3d_layout("D3D12_RESOURCE_DESC");
    val at: i64 = d3d_blob_alloc(b, l.size, l.align);
    d3d_set(b, at, &l, "Dimension", D3D12_RESOURCE_DIMENSION_BUFFER);
    d3d_set(b, at, &l, "Width", size);
    d3d_set(b, at, &l, "Height", 1);
    d3d_set(b, at, &l, "DepthOrArraySize", 1);
    d3d_set(b, at, &l, "MipLevels", 1);
    d3d_set(b, at, &l, "SampleDesc.Count", 1);
    d3d_set(b, at, &l, "Layout", D3D12_TEXTURE_LAYOUT_ROW_MAJOR);
    d3d_set(b, at, &l, "Flags", flags);
    return at;
}

/// D3D12_RESOURCE_DESC of a 2D texture.
pub fn d3d_resource_desc_tex2d(b: &mut D3dBlob, format: i64, w: i64, h: i64, mips: i64, flags: i64) -> i64 {
    val l: D3dLayout = d3d_layout("D3D12_RESOURCE_DESC");
    val at: i64 = d3d_blob_alloc(b, l.size, l.align);
    d3d_set(b, at, &l, "Dimension", D3D12_RESOURCE_DIMENSION_TEXTURE2D);
    d3d_set(b, at, &l, "Width", w);
    d3d_set(b, at, &l, "Height", h);
    d3d_set(b, at, &l, "DepthOrArraySize", 1);
    d3d_set(b, at, &l, "MipLevels", mips);
    d3d_set(b, at, &l, "Format", format);
    d3d_set(b, at, &l, "SampleDesc.Count", 1);
    d3d_set(b, at, &l, "Flags", flags);
    return at;
}

pub fn d3d_heap_properties(b: &mut D3dBlob, heap_type: i64) -> i64 {
    val l: D3dLayout = d3d_layout("D3D12_HEAP_PROPERTIES");
    val at: i64 = d3d_blob_alloc(b, l.size, l.align);
    d3d_set(b, at, &l, "Type", heap_type);
    d3d_set(b, at, &l, "CreationNodeMask", 1);
    d3d_set(b, at, &l, "VisibleNodeMask", 1);
    return at;
}

/// A transition barrier (resource: the ID3D12Resource pointer).
pub fn d3d_barrier_transition(b: &mut D3dBlob, resource: i64, subresource: i64, before: i64, after: i64) -> i64 {
    val l: D3dLayout = d3d_layout("D3D12_RESOURCE_BARRIER");
    val at: i64 = d3d_blob_alloc(b, l.size, l.align);
    d3d_set(b, at, &l, "Type", D3D12_RESOURCE_BARRIER_TYPE_TRANSITION);
    d3d_set(b, at, &l, "Transition.pResource", resource);
    d3d_set(b, at, &l, "Transition.Subresource", subresource);
    d3d_set(b, at, &l, "Transition.StateBefore", before);
    d3d_set(b, at, &l, "Transition.StateAfter", after);
    return at;
}

/// A UAV barrier (resource 0: any UAV access).
pub fn d3d_barrier_uav(b: &mut D3dBlob, resource: i64) -> i64 {
    val l: D3dLayout = d3d_layout("D3D12_RESOURCE_BARRIER");
    val at: i64 = d3d_blob_alloc(b, l.size, l.align);
    d3d_set(b, at, &l, "Type", D3D12_RESOURCE_BARRIER_TYPE_UAV);
    d3d_put(b, at + 8, 8, resource);
    return at;
}

/// An aliasing barrier between two placed resources.
pub fn d3d_barrier_aliasing(b: &mut D3dBlob, before: i64, after: i64) -> i64 {
    val l: D3dLayout = d3d_layout("D3D12_RESOURCE_BARRIER");
    val at: i64 = d3d_blob_alloc(b, l.size, l.align);
    d3d_set(b, at, &l, "Type", D3D12_RESOURCE_BARRIER_TYPE_ALIASING);
    d3d_put(b, at + 8, 8, before);
    d3d_put(b, at + 16, 8, after);
    return at;
}

// ─── Root signatures ───────────────────────────────────────────────────────

pub const D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE: i64 = 0;
pub const D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS: i64 = 1;
pub const D3D12_ROOT_PARAMETER_TYPE_CBV: i64 = 2;
pub const D3D12_ROOT_PARAMETER_TYPE_SRV: i64 = 3;
pub const D3D12_ROOT_PARAMETER_TYPE_UAV: i64 = 4;
pub const D3D12_DESCRIPTOR_RANGE_TYPE_SRV: i64 = 0;
pub const D3D12_DESCRIPTOR_RANGE_TYPE_UAV: i64 = 1;
pub const D3D12_DESCRIPTOR_RANGE_TYPE_CBV: i64 = 2;
pub const D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER: i64 = 3;
pub const D3D12_SHADER_VISIBILITY_ALL: i64 = 0;
pub const D3D12_SHADER_VISIBILITY_VERTEX: i64 = 1;
pub const D3D12_SHADER_VISIBILITY_PIXEL: i64 = 5;
pub const D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT: i64 = 0x1;
pub const D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND: i64 = 0xFFFFFFFF;

pub struct D3dRootSig {
    pub ptype: Vec<i64>,
    pub visibility: Vec<i64>,
    /// root descriptor / constants: register, space, count of 32-bit values
    pub reg: Vec<i64>,
    pub space: Vec<i64>,
    pub num32: Vec<i64>,
    /// descriptor tables: ranges as (type, count, base register, space)
    pub ranges: Vec<Vec<i64>>,
    pub flags: i64,
}

pub fn d3d_root_sig_new(flags: i64) -> D3dRootSig {
    return D3dRootSig {
        ptype: Vec::new(), visibility: Vec::new(), reg: Vec::new(), space: Vec::new(), num32: Vec::new(), ranges: Vec::new(), flags: flags
    };
}

/// A root CBV/SRV/UAV (2 DWORDs). Returns the parameter index.
pub fn d3d_root_descriptor(r: &mut D3dRootSig, ptype: i64, register: i64, space: i64, vis: i64) -> i64 {
    r.ptype.push(ptype);
    r.visibility.push(vis);
    r.reg.push(register);
    r.space.push(space);
    r.num32.push(0);
    r.ranges.push(Vec::new());
    return r.ptype.len() - 1;
}

/// Root 32-bit constants (one DWORD each).
pub fn d3d_root_constants(r: &mut D3dRootSig, register: i64, space: i64, count: i64, vis: i64) -> i64 {
    r.ptype.push(D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS);
    r.visibility.push(vis);
    r.reg.push(register);
    r.space.push(space);
    r.num32.push(count);
    r.ranges.push(Vec::new());
    return r.ptype.len() - 1;
}

/// A descriptor table (1 DWORD); add ranges with d3d_root_table_range.
pub fn d3d_root_table(r: &mut D3dRootSig, vis: i64) -> i64 {
    r.ptype.push(D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE);
    r.visibility.push(vis);
    r.reg.push(0);
    r.space.push(0);
    r.num32.push(0);
    r.ranges.push(Vec::new());
    return r.ptype.len() - 1;
}

pub fn d3d_root_table_range(r: &mut D3dRootSig, param: i64, rtype: i64, count: i64, base_register: i64, space: i64) {
    var v: Vec<i64> = r.ranges.get(param);
    v.push(rtype);
    v.push(count);
    v.push(base_register);
    v.push(space);
    r.ranges.set(param, v);
}

/// Root signature size in DWORDs (tables 1, root descriptors 2, constants
/// one per value); the limit is 64.
pub fn d3d_root_cost(r: &D3dRootSig) -> i64 {
    var c: i64 = 0;
    var i: i64 = 0;
    while i < r.ptype.len() {
        val t: i64 = r.ptype.get(i);
        if t == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE {
            c = c + 1;
        } else if t == D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS {
            c = c + r.num32.get(i);
        } else {
            c = c + 2;
        }
        i = i + 1;
    }
    return c;
}

/// Problems: cost over 64 DWORDs, empty tables, samplers mixed with other
/// range types in one table.
pub fn d3d_root_validate(r: &D3dRootSig) -> Vec<str> {
    var e: Vec<str> = Vec::new();
    val cost: i64 = d3d_root_cost(r);
    if cost > 64 {
        e.push("root signature is " + int_to_str(cost) + " DWORDs (limit 64)");
    }
    var i: i64 = 0;
    while i < r.ptype.len() {
        if r.ptype.get(i) == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE {
            val rg: Vec<i64> = r.ranges.get(i);
            if rg.len() == 0 {
                e.push("parameter " + int_to_str(i) + ": descriptor table without ranges");
            }
            var samplers: bool = false;
            var others: bool = false;
            var k: i64 = 0;
            while k < rg.len() {
                if rg.get(k) == D3D12_DESCRIPTOR_RANGE_TYPE_SAMPLER {
                    samplers = true;
                } else {
                    others = true;
                }
                k = k + 4;
            }
            if samplers && others {
                e.push("parameter " + int_to_str(i) + ": sampler ranges cannot share a table with CBV/SRV/UAV ranges");
            }
        }
        i = i + 1;
    }
    return e;
}

/// D3D12_ROOT_SIGNATURE_DESC with its parameter and range arrays in the
/// blob (for D3D12SerializeRootSignature, version 1).
pub fn d3d_root_sig_desc(r: &D3dRootSig, b: &mut D3dBlob) -> i64 {
    val ld: D3dLayout = d3d_layout("D3D12_ROOT_SIGNATURE_DESC");
    val lp: D3dLayout = d3d_layout("D3D12_ROOT_PARAMETER");
    val lr: D3dLayout = d3d_layout("D3D12_DESCRIPTOR_RANGE");
    val n: i64 = r.ptype.len();
    val desc: i64 = d3d_blob_alloc(b, ld.size, ld.align);
    var params: i64 = -1;
    if n > 0 {
        params = d3d_blob_alloc(b, lp.size * n, lp.align);
    }
    val u: i64 = d3d_offset(&lp, "DescriptorTable.NumDescriptorRanges");
    var i: i64 = 0;
    while i < n {
        val at: i64 = params + i * lp.size;
        val t: i64 = r.ptype.get(i);
        d3d_set(b, at, &lp, "ParameterType", t);
        d3d_set(b, at, &lp, "ShaderVisibility", r.visibility.get(i));
        if t == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE {
            val rg: Vec<i64> = r.ranges.get(i);
            val nr: i64 = rg.len() / 4;
            var arr: i64 = -1;
            if nr > 0 {
                arr = d3d_blob_alloc(b, lr.size * nr, lr.align);
            }
            var k: i64 = 0;
            while k < nr {
                val ra: i64 = arr + k * lr.size;
                d3d_set(b, ra, &lr, "RangeType", rg.get(4 * k));
                d3d_set(b, ra, &lr, "NumDescriptors", rg.get(4 * k + 1));
                d3d_set(b, ra, &lr, "BaseShaderRegister", rg.get(4 * k + 2));
                d3d_set(b, ra, &lr, "RegisterSpace", rg.get(4 * k + 3));
                d3d_set(b, ra, &lr, "OffsetInDescriptorsFromTableStart", D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND);
                k = k + 1;
            }
            d3d_set(b, at, &lp, "DescriptorTable.NumDescriptorRanges", nr);
            d3d_set_ptr(b, at, &lp, "DescriptorTable.pDescriptorRanges", arr);
        } else if t == D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS {
            // union member Constants: ShaderRegister, RegisterSpace, Num32BitValues
            d3d_put(b, at + u, 4, r.reg.get(i));
            d3d_put(b, at + u + 4, 4, r.space.get(i));
            d3d_put(b, at + u + 8, 4, r.num32.get(i));
        } else {
            // union member Descriptor: ShaderRegister, RegisterSpace
            d3d_put(b, at + u, 4, r.reg.get(i));
            d3d_put(b, at + u + 4, 4, r.space.get(i));
        }
        i = i + 1;
    }
    d3d_set(b, desc, &ld, "NumParameters", n);
    d3d_set_ptr(b, desc, &ld, "pParameters", params);
    d3d_set(b, desc, &ld, "Flags", r.flags);
    return desc;
}

// ─── DXGI formats ──────────────────────────────────────────────────────────

pub const DXGI_FORMAT_UNKNOWN: i64 = 0;
pub const DXGI_FORMAT_R32G32B32A32_FLOAT: i64 = 2;
pub const DXGI_FORMAT_R32G32B32_FLOAT: i64 = 6;
pub const DXGI_FORMAT_R16G16B16A16_FLOAT: i64 = 10;
pub const DXGI_FORMAT_R32G32_FLOAT: i64 = 16;
pub const DXGI_FORMAT_R10G10B10A2_UNORM: i64 = 24;
pub const DXGI_FORMAT_R11G11B10_FLOAT: i64 = 26;
pub const DXGI_FORMAT_R8G8B8A8_UNORM: i64 = 28;
pub const DXGI_FORMAT_R8G8B8A8_UNORM_SRGB: i64 = 29;
pub const DXGI_FORMAT_R16G16_FLOAT: i64 = 34;
pub const DXGI_FORMAT_D32_FLOAT: i64 = 40;
pub const DXGI_FORMAT_R32_FLOAT: i64 = 41;
pub const DXGI_FORMAT_R32_UINT: i64 = 42;
pub const DXGI_FORMAT_D24_UNORM_S8_UINT: i64 = 45;
pub const DXGI_FORMAT_R8G8_UNORM: i64 = 49;
pub const DXGI_FORMAT_R16_FLOAT: i64 = 54;
pub const DXGI_FORMAT_D16_UNORM: i64 = 55;
pub const DXGI_FORMAT_R16_UINT: i64 = 57;
pub const DXGI_FORMAT_R8_UNORM: i64 = 61;
pub const DXGI_FORMAT_BC1_UNORM: i64 = 71;
pub const DXGI_FORMAT_BC3_UNORM: i64 = 77;
pub const DXGI_FORMAT_BC4_UNORM: i64 = 80;
pub const DXGI_FORMAT_BC5_UNORM: i64 = 83;
pub const DXGI_FORMAT_B8G8R8A8_UNORM: i64 = 87;
pub const DXGI_FORMAT_B8G8R8A8_UNORM_SRGB: i64 = 91;
pub const DXGI_FORMAT_BC6H_UF16: i64 = 95;
pub const DXGI_FORMAT_BC7_UNORM: i64 = 98;

/// Bits per element of a DXGI format (per 4x4 block for BC formats: 64 or
/// 128); 0 when unknown.
pub fn dxgi_format_bits(f: i64) -> i64 {
    if f >= 1 && f <= 4 {
        return 128;
    }
    if f >= 5 && f <= 8 {
        return 96;
    }
    if f >= 9 && f <= 22 {
        return 64;
    }
    if f >= 23 && f <= 47 {
        return 32;
    }
    if f >= 48 && f <= 59 {
        return 16;
    }
    if f >= 60 && f <= 65 {
        return 8;
    }
    if f == 66 {
        return 1;
    }
    if f >= 67 && f <= 69 {
        return 32;
    }
    if f >= 70 && f <= 72 {
        return 64;
    }
    if f >= 73 && f <= 78 {
        return 128;
    }
    if f >= 79 && f <= 81 {
        return 64;
    }
    if f >= 82 && f <= 84 {
        return 128;
    }
    if f == 85 || f == 86 {
        return 16;
    }
    if f >= 87 && f <= 93 {
        return 32;
    }
    if f >= 94 && f <= 99 {
        return 128;
    }
    if f == 115 {
        return 16;
    }
    return 0;
}

pub fn dxgi_format_is_bc(f: i64) -> bool {
    return (f >= 70 && f <= 84) || (f >= 94 && f <= 99);
}

pub fn dxgi_format_is_depth(f: i64) -> bool {
    return f == 20 || f == 40 || f == 45 || f == 55;
}

/// Bytes of one row of texels (one row of 4x4 blocks for BC).
pub fn dxgi_row_bytes(f: i64, width: i64) -> i64 {
    if dxgi_format_is_bc(f) {
        return ((width + 3) / 4) * dxgi_format_bits(f) / 8;
    }
    return (width * dxgi_format_bits(f) + 7) / 8;
}

pub fn dxgi_rows(f: i64, height: i64) -> i64 {
    if dxgi_format_is_bc(f) {
        return (height + 3) / 4;
    }
    return height;
}

pub const D3D12_TEXTURE_DATA_PITCH_ALIGNMENT: i64 = 256;
pub const D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT: i64 = 512;
pub const D3D12_CONSTANT_BUFFER_ALIGNMENT: i64 = 256;

/// A constant buffer's size rounded up to 256 bytes.
pub fn d3d_cb_size(n: i64) -> i64 {
    return d3d_round(D3D12_CONSTANT_BUFFER_ALIGNMENT, n);
}

pub struct D3dFootprints {
    /// Per mip: offset, row pitch, rows, row size in bytes.
    pub offset: Vec<i64>,
    pub row_pitch: Vec<i64>,
    pub rows: Vec<i64>,
    pub row_size: Vec<i64>,
    /// Upload buffer size needed (GetCopyableFootprints' TotalBytes).
    pub total: i64,
}

/// Upload layout of a 2D texture's mip chain, as GetCopyableFootprints
/// computes it: rows padded to 256 bytes, each subresource at a 512-byte
/// boundary; the last row of the last subresource is not padded.
pub fn d3d_footprints(f: i64, w: i64, h: i64, mips: i64, base_offset: i64) -> D3dFootprints {
    var r: D3dFootprints = D3dFootprints {
        offset: Vec::new(), row_pitch: Vec::new(), rows: Vec::new(), row_size: Vec::new(), total: 0
    };
    var at: i64 = base_offset;
    var lw: i64 = w;
    var lh: i64 = h;
    var m: i64 = 0;
    var end: i64 = 0;
    while m < mips {
        val off: i64 = d3d_round(D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT, at);
        val rs: i64 = dxgi_row_bytes(f, lw);
        val pitch: i64 = d3d_round(D3D12_TEXTURE_DATA_PITCH_ALIGNMENT, rs);
        val rows: i64 = dxgi_rows(f, lh);
        r.offset.push(off);
        r.row_pitch.push(pitch);
        r.rows.push(rows);
        r.row_size.push(rs);
        end = off + pitch * (rows - 1) + rs;
        at = off + pitch * rows;
        if lw > 1 {
            lw = lw / 2;
        }
        if lh > 1 {
            lh = lh / 2;
        }
        m = m + 1;
    }
    r.total = end - base_offset;
    return r;
}
