// Fides Banking standard library — Phase 7.5B
//
// A minimal banking layer built on linear Money + @conserve.
// Demonstrates compile-time financial conservation — the thing COBOL
// cannot do. Every function that moves money is @conserve, meaning
// the compiler proves no money is created, destroyed, or duplicated.
//
// Design: Accounts are immutable — each operation consumes the old
// Account and returns a new one. This fits naturally with linear types:
// the old balance Money is consumed, a new balance Money is produced.
//
// The conservation proof:
//   - deposit:    new_balance = old_balance + deposit_amount
//   - withdraw:   new_balance = old_balance - withdraw_amount
//   - interest:   new_balance = old_balance + accrued (integer math)
//
// In COBOL, all of these are runtime operations with no compile-time
// conservation check. A bug in COBOL's ADD/MOVE can silently create or
// destroy money (e.g. Knight Capital lost $440M in 45 minutes from
// a deployment bug that double-credited orders). In Fides, the compiler
// rejects such bugs before the program runs.

module banking;

use money;

/// A bank account with a linear Money balance.
/// The balance is Money (linear) — it cannot be duplicated.
@linear
pub struct Account {
    id: i64,
    balance: Money,
}

// ─── Account creation (NOT @conserve — initial mint) ───────────────────────

/// Open a new account with an initial balance.
/// NOT @conserve because it calls Money_new (minting).
pub pf Account_open(id: i64, initial_cents: i64) -> Account {
    ret Account { id: id, balance: Money_new(initial_cents) };
}

// ─── @conserve account operations ──────────────────────────────────────────

/// Deposit money into an account. Consumes the account and the deposit,
/// returns a new account with the combined balance.
/// Conservation: new_balance = old_balance + deposit.
@conserve
pub pf Account_deposit(acc: Account, amount: Money) -> Account {
    pv id = acc.id;
    pv new_balance = Money_add(acc.balance, amount);
    ret Account { id: id, balance: new_balance };
}

/// Withdraw money from an account. Consumes the account,
/// returns a new account with reduced balance AND the withdrawn cash.
/// Conservation: old_balance = new_balance + withdrawn.
@conserve
pub pf Account_withdraw(acc: Account, withdraw_cents: i64) -> (Account, Money) {
    pv id = acc.id;
    pv c = acc.balance.cents;
    pv new_balance = Money_from_cents(c - withdraw_cents);
    pv cash = Money_from_cents(withdraw_cents);
    ret (Account { id: id, balance: new_balance }, cash);
}

/// Transfer money from one account to another. Consumes both accounts,
/// returns both with updated balances.
/// Conservation: A loses X, B gains X. Total unchanged.
@conserve
pub pf Account_transfer(from: Account, to: Account, amount_cents: i64) -> (Account, Account) {
    pv from_id = from.id;
    pv from_bal = from.balance.cents;
    pv to_id = to.id;
    pv to_bal = to.balance.cents;
    pv new_from = Account { id: from_id, balance: Money_from_cents(from_bal - amount_cents) };
    pv new_to = Account { id: to_id, balance: Money_from_cents(to_bal + amount_cents) };
    ret (new_from, new_to);
}

/// Calculate simple interest on an account. Consumes the account,
/// returns a new account with interest added.
/// Uses integer arithmetic: interest = balance * rate_bps / 10000
/// (rate_bps = basis points, e.g. 500 = 5.00%)
/// @deterministic: same inputs always produce same outputs (no float).
@conserve
@deterministic
pub pf Account_accrue_interest(acc: Account, rate_bps: i64) -> Account {
    pv c = acc.balance.cents;
    pv interest = c * rate_bps / 10000;
    pv new_balance = Money_from_cents(c + interest);
    ret Account { id: acc.id, balance: new_balance };
}

/// Get the account balance in cents. Consumes the account.
@conserve
pub pf Account_balance_cents(acc: Account) -> i64 {
    ret acc.balance.cents;
}

/// Get the account ID. Consumes the account.
@conserve
pub pf Account_id(acc: Account) -> i64 {
    ret acc.id;
}

/// Print account info. NOT @conserve (has IO effect).
pub pf Account_print(acc: Account) -> void {
    pv c = acc.balance.cents;
    print("Account #");
    print(acc.id);
    print(": $");
    pv dollars = c / 100;
    pv cents = c % 100;
    print(dollars);
    print(".");
    if cents < 10 {
        print("0");
    }
    print(cents);
    print("\n");
}
