// Fides Banking standard library — Phase 7.5B
//
// A minimal banking layer built on linear Money + @conserve.
// Demonstrates compile-time financial conservation — the thing COBOL
// cannot do. Every function that moves money is @conserve, meaning
// the compiler proves no money is created, destroyed, or duplicated.
//
// Design: Accounts are immutable — each operation consumes the old
// Account and returns a new one. This fits naturally with linear types:
// the old balance Money is consumed, a new balance Money is produced.
//
// The conservation proof:
//   - deposit:    new_balance = old_balance + deposit_amount
//   - withdraw:   new_balance = old_balance - withdraw_amount
//   - interest:   new_balance = old_balance + accrued (integer math)
//
// In COBOL, all of these are runtime operations with no compile-time
// conservation check. A bug in COBOL's ADD/MOVE can silently create or
// destroy money (e.g. Knight Capital lost $440M in 45 minutes from
// a deployment bug that double-credited orders). In Fides, the compiler
// rejects such bugs before the program runs.

module banking;

use money;

/// A bank account with a linear Money balance.
/// The balance is Money (linear) — it cannot be duplicated.
@linear
pub struct Account {
    id: i64,
    balance: Money,
}

// ─── Account creation (NOT @conserve — initial mint) ───────────────────────

/// Open a new account with an initial balance.
/// NOT @conserve because it calls Money_new (minting).
pub fn Account_open(id: i64, initial_cents: i64) -> Account {
    return Account { id: id, balance: Money_new(initial_cents) };
}

// ─── @conserve account operations ──────────────────────────────────────────

/// Deposit money into an account. Consumes the account and the deposit,
/// returns a new account with the combined balance.
/// Conservation: new_balance = old_balance + deposit.
@conserve
pub fn Account_deposit(acc: Account, amount: Money) -> Account {
    val id = acc.id;
    val new_balance = Money_add(acc.balance, amount);
    return Account { id: id, balance: new_balance };
}

/// Withdraw money from an account. Consumes the account,
/// returns a new account with reduced balance AND the withdrawn cash.
/// Conservation: old_balance = new_balance + withdrawn.
@conserve
pub fn Account_withdraw(acc: Account, withdraw_cents: i64) -> (Account, Money) {
    val id = acc.id;
    val c = acc.balance.cents;
    val new_balance = Money_from_cents(c - withdraw_cents);
    val cash = Money_from_cents(withdraw_cents);
    return (Account { id: id, balance: new_balance }, cash);
}

/// Transfer money from one account to another. Consumes both accounts,
/// returns both with updated balances.
/// Conservation: A loses X, B gains X. Total unchanged.
@conserve
pub fn Account_transfer(from: Account, to: Account, amount_cents: i64) -> (Account, Account) {
    val from_id = from.id;
    val from_bal = from.balance.cents;
    val to_id = to.id;
    val to_bal = to.balance.cents;
    val new_from = Account { id: from_id, balance: Money_from_cents(from_bal - amount_cents) };
    val new_to = Account { id: to_id, balance: Money_from_cents(to_bal + amount_cents) };
    return (new_from, new_to);
}

/// Calculate simple interest on an account. Consumes the account,
/// returns a new account with interest added.
/// Uses integer arithmetic: interest = balance * rate_bps / 10000
/// (rate_bps = basis points, e.g. 500 = 5.00%)
/// @deterministic: same inputs always produce same outputs (no float).
@conserve
@deterministic
pub fn Account_accrue_interest(acc: Account, rate_bps: i64) -> Account {
    val c = acc.balance.cents;
    val interest = c * rate_bps / 10000;
    val new_balance = Money_from_cents(c + interest);
    return Account { id: acc.id, balance: new_balance };
}

/// Get the account balance in cents. Consumes the account.
@conserve
pub fn Account_balance_cents(acc: Account) -> i64 {
    return acc.balance.cents;
}

/// Get the account ID. Consumes the account.
@conserve
pub fn Account_id(acc: Account) -> i64 {
    return acc.id;
}

/// Print account info. NOT @conserve (has IO effect).
pub fn Account_print(acc: Account) -> void {
    val c = acc.balance.cents;
    print("Account #");
    print(acc.id);
    print(": $");
    val dollars = c / 100;
    val cents = c % 100;
    print(dollars);
    print(".");
    if cents < 10 {
        print("0");
    }
    print(cents);
    print("\n");
}

// ─── Account<State> — Typestate Pattern (F42) ──────────────────────────
//
// State-encoded account types: Active, Frozen, Closed.
// The compiler ensures that operations on a Frozen account can't
// transfer money, and operations on a Closed account can't do anything.
//
// This is the typestate pattern: the state is encoded in the TYPE,
// not in a runtime field. The compiler enforces transitions.
//
// Usage:
//   val acc = AccountActive_open(1, 10000);
//   val (acc2, cash) = AccountActive_withdraw(acc, 500);
//   val frozen = AccountActive_freeze(acc2);
//   // AccountFrozen_transfer(frozen, ...) — COMPILE ERROR (no such function)
//   val closed = AccountFrozen_close(frozen);
//   // AccountClosed_withdraw(closed, ...) — COMPILE ERROR

/// Account state constants.
pub const ACCOUNT_STATE_ACTIVE: i64  = 0;
pub const ACCOUNT_STATE_FROZEN: i64  = 1;
pub const ACCOUNT_STATE_CLOSED: i64  = 2;

/// An Active account — can deposit, withdraw, transfer, freeze.
@linear
pub struct AccountActive {
    pub id: i64,
    pub balance: Money,
}

/// A Frozen account — can only unfreeze or close. No transfers.
@linear
pub struct AccountFrozen {
    pub id: i64,
    pub balance: Money,
}

/// A Closed account — terminal state. No operations.
@linear
pub struct AccountClosed {
    pub id: i64,
    pub balance: Money,
}

// ─── Active Account Operations ─────────────────────────────────────────

/// Open a new active account with an initial balance.
pub fn AccountActive_open(id: i64, initial_cents: i64) -> AccountActive {
    return AccountActive { id: id, balance: Money_new(initial_cents) };
}

/// Deposit money into an active account.
@conserve
pub fn AccountActive_deposit(acc: AccountActive, amount: Money) -> AccountActive {
    val new_balance = Money_add(acc.balance, amount);
    return AccountActive { id: acc.id, balance: new_balance };
}

/// Withdraw money from an active account.
@conserve
pub fn AccountActive_withdraw(acc: AccountActive, withdraw_cents: i64) -> (AccountActive, Money) {
    val c = acc.balance.cents;
    val new_balance = Money_from_cents(c - withdraw_cents);
    val cash = Money_from_cents(withdraw_cents);
    return (AccountActive { id: acc.id, balance: new_balance }, cash);
}

/// Transfer money between two active accounts.
@conserve
pub fn AccountActive_transfer(from: AccountActive, to: AccountActive,
                                amount_cents: i64) -> (AccountActive, AccountActive) {
    val from_bal = from.balance.cents;
    val to_bal = to.balance.cents;
    val new_from = AccountActive { id: from.id, balance: Money_from_cents(from_bal - amount_cents) };
    val new_to = AccountActive { id: to.id, balance: Money_from_cents(to_bal + amount_cents) };
    return (new_from, new_to);
}

/// Freeze an active account (transition to Frozen state).
@conserve
pub fn AccountActive_freeze(acc: AccountActive) -> AccountFrozen {
    return AccountFrozen { id: acc.id, balance: acc.balance };
}

/// Close an active account (transition to Closed state).
@conserve
pub fn AccountActive_close(acc: AccountActive) -> AccountClosed {
    return AccountClosed { id: acc.id, balance: acc.balance };
}

/// Get balance of an active account.
@conserve
pub fn AccountActive_balance_cents(acc: AccountActive) -> i64 {
    return acc.balance.cents;
}

/// Get ID of an active account.
@conserve
pub fn AccountActive_id(acc: AccountActive) -> i64 {
    return acc.id;
}

// ─── Frozen Account Operations (limited) ───────────────────────────────
//
// A frozen account can only be unfrozen (back to Active) or closed.
// No deposits, withdrawals, or transfers are possible.

/// Unfreeze a frozen account (transition back to Active).
@conserve
pub fn AccountFrozen_unfreeze(acc: AccountFrozen) -> AccountActive {
    return AccountActive { id: acc.id, balance: acc.balance };
}

/// Close a frozen account (transition to Closed).
@conserve
pub fn AccountFrozen_close(acc: AccountFrozen) -> AccountClosed {
    return AccountClosed { id: acc.id, balance: acc.balance };
}

/// Get balance of a frozen account (read-only).
@conserve
pub fn AccountFrozen_balance_cents(acc: AccountFrozen) -> i64 {
    return acc.balance.cents;
}

/// Get ID of a frozen account.
@conserve
pub fn AccountFrozen_id(acc: AccountFrozen) -> i64 {
    return acc.id;
}

// ─── Closed Account Operations (terminal) ──────────────────────────────
//
// A closed account is in a terminal state. No financial operations
// are possible. Only read-only access for audit purposes.

/// Get final balance of a closed account (for audit).
@conserve
pub fn AccountClosed_balance_cents(acc: AccountClosed) -> i64 {
    return acc.balance.cents;
}

/// Get ID of a closed account.
@conserve
pub fn AccountClosed_id(acc: AccountClosed) -> i64 {
    return acc.id;
}

/// Get the state name for an account state constant.
@crashfree
pub fn account_state_name(state: i64) -> str {
    if state == ACCOUNT_STATE_ACTIVE { return "Active"; }
    if state == ACCOUNT_STATE_FROZEN { return "Frozen"; }
    if state == ACCOUNT_STATE_CLOSED { return "Closed"; }
    return "Unknown";
}
