// Fides Money standard library — Phase 7.5B
//
// A fixed-point decimal money type with linear semantics.
// Money cannot be copied (linear) — it can only be moved, split, or merged.
// Combined with @conserve, this gives compile-time conservation proofs:
// no money can be created, destroyed, or duplicated.
//
// Internally, Money stores cents as i64. All arithmetic is integer-based
// (no floating-point) to ensure exactness.

module money;
/// A linear money type. Values can be moved but not copied.
/// Use @conserve on functions that must prove no money is created or destroyed.
@linear pub struct Money {
    pub cents: i64,
}

// ─── Mint functions (NOT @conserve — these create money) ──────────────────
// Only callable from non-@conserve functions (e.g. the system mint, deposits).

/// Create new money from a cents amount. This is the "mint" function.
/// Calling this inside a @conserve function is a compile error.
pub fn Money_new(cents: i64) -> Money {
    return Money {
        cents: cents
    };
}

/// Create money from dollars and cents.
pub fn Money_from_dollars(dollars: i64, cents: i64) -> Money {
    return Money {
        cents: dollars * 100 + cents
    };
}

/// Make money from a cents value. A mint like Money_new: the cents are
/// a plain number, so nothing proves they came from existing Money.
/// Calling this inside a @conserve function is a compile error.
pub fn Money_from_cents(cents: i64) -> Money {
    return Money {
        cents: cents
    };
}

// ─── @conserve operations (move, split, merge — no creation) ───────────────
// Each keeps the total: what goes in comes out. The amount (`cents`) is
// only read or changed here: a @conserve function elsewhere that touches
// `.cents` is a compile error, so these are the whole trusted base.

/// Merge two amounts into one. Both inputs are consumed (linear).
@conserve pub fn Money_add(a: Money, b: Money) -> Money {
    return Money {
        cents: a.cents + b.cents
    };
}

/// Split: move `cents` out of `m` into a new Money. `m` keeps the rest,
/// so the two together hold what `m` held.
@conserve pub fn Money_take(m: & mut Money, cents: i64) -> Money {
    m.cents = m.cents - cents;
    return Money {
        cents: cents
    };
}

/// The amount, read through a borrow: nothing is consumed.
@conserve pub fn Money_cents(m: & Money) -> i64 {
    return m.cents;
}

/// Is the amount non-negative? Borrows, consumes nothing.
@conserve pub fn Money_is_non_negative(m: & Money) -> bool {
    return m.cents >= 0;
}

/// Are the two amounts equal? Borrows both, consumes nothing.
@conserve pub fn Money_eq(a: & Money, b: & Money) -> bool {
    return a.cents == b.cents;
}

// ─── Destroying operations (NOT @conserve) ─────────────────────────────────

/// a - b, both consumed: `b` and as much of `a` are destroyed. To pay `b`
/// out of `a` and keep both, use Money_take. Not @conserve.
pub fn Money_sub(a: Money, b: Money) -> Money {
    return Money {
        cents: a.cents - b.cents
    };
}

/// The cents value, consuming the Money: it leaves the money system (a
/// payout, a report at the end). Not @conserve; use Money_cents(&m) to read.
pub fn Money_to_cents(m: Money) -> i64 {
    return m.cents;
}

/// Print money as dollars.cents (e.g. "$12.34"). NOT @conserve (has IO effect).
pub fn Money_print(m: Money) -> void {
    var c = m.cents;
    var dollars = c / 100;
    var cents = c % 100;
    print("$");
    print(dollars);
    print(".");
    if cents < 10 {
        print("0");
    }
    print(cents);
}
