// Fides Money standard library — Phase 7.5B
//
// A fixed-point decimal money type with linear semantics.
// Money cannot be copied (linear) — it can only be moved, split, or merged.
// Combined with @conserve, this gives compile-time conservation proofs:
// no money can be created, destroyed, or duplicated.
//
// Internally, Money stores cents as i64. All arithmetic is integer-based
// (no floating-point) to ensure exactness.

module money;

/// A linear money type. Values can be moved but not copied.
/// Use @conserve on functions that must prove no money is created or destroyed.
@linear
pub struct Money {
    pub cents: i64,
}

// ─── Mint functions (NOT @conserve — these create money) ──────────────────
// Only callable from non-@conserve functions (e.g. the system mint, deposits).

/// Create new money from a cents amount. This is the "mint" function.
/// Calling this inside a @conserve function is a compile error.
pub fn Money_new(cents: i64) -> Money {
    return Money { cents: cents };
}

/// Create money from dollars and cents.
pub fn Money_from_dollars(dollars: i64, cents: i64) -> Money {
    return Money { cents: dollars * 100 + cents };
}

/// Restructure money from a cents value. This is @conserve because it
/// creates a new Money object from an integer — but the conservation is
/// proved by the linear type system: the old Money must be consumed
/// (its cents extracted), and this function rebuilds Money from those cents.
/// The total is preserved because the caller consumed the original.
@conserve
pub fn Money_from_cents(cents: i64) -> Money {
    return Money { cents: cents };
}

// ─── @conserve operations (move, split, merge — no creation) ───────────────

/// Add two money amounts. Both inputs are consumed (linear), producing one output.
@conserve
pub fn Money_add(a: Money, b: Money) -> Money {
    return Money { cents: a.cents + b.cents };
}

/// Subtract b from a. Both consumed, result is a - b.
@conserve
pub fn Money_sub(a: Money, b: Money) -> Money {
    return Money { cents: a.cents - b.cents };
}

/// Get the cents value. Consumes the money (linear).
@conserve
pub fn Money_to_cents(m: Money) -> i64 {
    return m.cents;
}

/// Check if money is non-negative. Consumes the input.
@conserve
pub fn Money_is_non_negative(m: Money) -> bool {
    return m.cents >= 0;
}

/// Check if two money amounts are equal. Both consumed.
@conserve
pub fn Money_eq(a: Money, b: Money) -> bool {
    return a.cents == b.cents;
}

/// Print money as dollars.cents (e.g. "$12.34"). NOT @conserve (has IO effect).
pub fn Money_print(m: Money) -> void {
    val c = m.cents;
    val dollars = c / 100;
    val cents = c % 100;
    print("$");
    print(dollars);
    print(".");
    if cents < 10 {
        print("0");
    }
    print(cents);
}
