// Fides CoAP (RFC 7252) with block-wise transfer (RFC 7959) and Observe (RFC 7641)
//
// Real (pure computation):
//   - the message format of RFC 7252 section 3: header, token, options with
//     delta/length nibbles and their 13/14 extensions, payload marker; the
//     format checks of 3 and 4.1 (version, token length, nibble 15, an empty
//     payload after the marker, an Empty message with anything in it);
//   - options: numbers of section 5.10 (+ Observe, Block1/2, Size1/2,
//     No-Response), uint, string and opaque values, Uri-Path/Uri-Query
//     from and to a path string, critical/unsafe/no-cache-key bits (5.4.6);
//   - block-wise: the Block1/Block2 value (NUM, M, SZX), slicing a body for
//     a Block2 response, a Block2 reassembler that asks for the next block,
//     Block1 requests for an upload;
//   - Observe: the 24-bit sequence and the freshness rule of RFC 7641
//     section 3.4, and a server-side observer list that makes notifications;
//   - CoapEndpoint, a request/response matcher: message IDs and tokens,
//     confirmable retransmission with exponential back-off (ACK_TIMEOUT 2 s,
//     ACK_RANDOM_FACTOR 1.5, MAX_RETRANSMIT 4: section 4.8), piggybacked
//     and separate responses (empty ACK, then a CON answered by an ACK),
//     Reset, Observe exchanges kept open; for a server, duplicate detection
//     that resends the cached response (4.5).
//
// The transport seam: an endpoint talks to one peer (one UDP association;
// keep one CoapEndpoint per peer) and does no I/O. coap_ep_take_outbox gives
// the datagrams to send, coap_ep_receive takes one datagram received, and
// coap_ep_tick(now) is called with the time in milliseconds. The random part
// of the first timeout comes from a seeded generator in the endpoint.
//
// Bytes are Vec<i64>, one value 0..255 each.

module coap;
 use vec; use string;

// Message types
pub const COAP_CON: i64 = 0;
pub const COAP_NON: i64 = 1;
pub const COAP_ACK: i64 = 2;
pub const COAP_RST: i64 = 3;

// Codes (class << 5 | detail)
pub const COAP_EMPTY: i64 = 0;
pub const COAP_GET: i64 = 1;
pub const COAP_POST: i64 = 2;
pub const COAP_PUT: i64 = 3;
pub const COAP_DELETE: i64 = 4;
pub const COAP_CREATED: i64 = 65;        // 2.01
pub const COAP_DELETED: i64 = 66;        // 2.02
pub const COAP_VALID: i64 = 67;          // 2.03
pub const COAP_CHANGED: i64 = 68;        // 2.04
pub const COAP_CONTENT: i64 = 69;        // 2.05
pub const COAP_CONTINUE: i64 = 95;       // 2.31 (RFC 7959)
pub const COAP_BAD_REQUEST: i64 = 128;   // 4.00
pub const COAP_NOT_FOUND: i64 = 132;     // 4.04
pub const COAP_METHOD_NOT_ALLOWED: i64 = 133; // 4.05
pub const COAP_REQUEST_INCOMPLETE: i64 = 136; // 4.08
pub const COAP_TOO_LARGE: i64 = 141;     // 4.13
pub const COAP_INTERNAL_ERROR: i64 = 160; // 5.00

// Option numbers
pub const COAP_O_IF_MATCH: i64 = 1;
pub const COAP_O_URI_HOST: i64 = 3;
pub const COAP_O_ETAG: i64 = 4;
pub const COAP_O_IF_NONE_MATCH: i64 = 5;
pub const COAP_O_OBSERVE: i64 = 6;
pub const COAP_O_URI_PORT: i64 = 7;
pub const COAP_O_LOCATION_PATH: i64 = 8;
pub const COAP_O_URI_PATH: i64 = 11;
pub const COAP_O_CONTENT_FORMAT: i64 = 12;
pub const COAP_O_MAX_AGE: i64 = 14;
pub const COAP_O_URI_QUERY: i64 = 15;
pub const COAP_O_ACCEPT: i64 = 17;
pub const COAP_O_LOCATION_QUERY: i64 = 20;
pub const COAP_O_BLOCK2: i64 = 23;
pub const COAP_O_BLOCK1: i64 = 27;
pub const COAP_O_SIZE2: i64 = 28;
pub const COAP_O_PROXY_URI: i64 = 35;
pub const COAP_O_PROXY_SCHEME: i64 = 39;
pub const COAP_O_SIZE1: i64 = 60;
pub const COAP_O_NO_RESPONSE: i64 = 258;

// Content formats
pub const COAP_CF_TEXT: i64 = 0;
pub const COAP_CF_LINK: i64 = 40;
pub const COAP_CF_JSON: i64 = 50;
pub const COAP_CF_CBOR: i64 = 60;

// Transmission parameters (section 4.8), milliseconds
pub const COAP_ACK_TIMEOUT: i64 = 2000;
pub const COAP_MAX_RETRANSMIT: i64 = 4;
pub const COAP_EXCHANGE_LIFETIME: i64 = 247000;

/// One CoAP message. Options are kept sorted by number (repeated options
/// in the order they were added).
pub struct CoapMsg {
    pub mtype: i64,
    pub code: i64,
    pub mid: i64,
    pub token: Vec<i64>,
    pub opt_nums: Vec<i64>,
    pub opt_vals: Vec<Vec<i64>>,
    pub payload: Vec<i64>,
}

pub fn coap_msg(mtype: i64, code: i64, mid: i64) -> CoapMsg {
    return CoapMsg {
        mtype: mtype, code: code, mid: mid, token: Vec::new(), opt_nums: Vec::new(), opt_vals: Vec::new(), payload: Vec::new(),
    };
}

/// "2.05" for 69.
pub fn coap_code_str(code: i64) -> str {
    val d: i64 = code & 31;
    var dd: str = int_to_str(d);
    if d < 10 {
        dd = "0" + dd;
    }
    return int_to_str(code >> 5) + "." + dd;
}

pub fn coap_is_request(m: & CoapMsg) -> bool {
    return m.code >= 1 && m.code <= 31;
}

pub fn coap_is_response(m: & CoapMsg) -> bool {
    return m.code >= 64;
}

// Option properties (section 5.4.6)
pub fn coap_opt_critical(num: i64) -> bool {
    return (num & 1) == 1;
}

pub fn coap_opt_unsafe(num: i64) -> bool {
    return (num & 2) == 2;
}

pub fn coap_opt_no_cache_key(num: i64) -> bool {
    return (num & 30) == 28;
}

// ─── Options ─────────────────────────────────────────────────────────────

/// A uint option value in the fewest bytes (0 is no bytes).
pub fn coap_uint_bytes(v: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var x: i64 = v;
    while x > 0 {
        out.insert(0, x & 255);
        x = x >> 8;
    }
    return out;
}

pub fn coap_bytes_uint(b: Vec<i64>) -> i64 {
    var x: i64 = 0;
    var i: i64 = 0;
    while i < b.len() {
        x = (x << 8) | (b.get(i) & 255);
        i = i + 1;
    }
    return x;
}

/// Add option `num` with value bytes `val` (after any option <= num).
pub fn coap_add_option(m: & mut CoapMsg, num: i64, val: Vec<i64>) {
    var at: i64 = m.opt_nums.len();
    while at > 0 && m.opt_nums.get(at - 1) > num {
        at = at - 1;
    }
    m.opt_nums.insert(at, num);
    m.opt_vals.insert(at, val);
}

pub fn coap_add_uint(m: & mut CoapMsg, num: i64, v: i64) {
    coap_add_option(m, num, coap_uint_bytes(v));
}

pub fn coap_add_str(m: & mut CoapMsg, num: i64, s: str) {
    coap_add_option(m, num, str_bytes(s));
}

/// Remove every option `num`.
pub fn coap_remove_option(m: & mut CoapMsg, num: i64) {
    var i: i64 = 0;
    while i < m.opt_nums.len() {
        if m.opt_nums.get(i) == num {
            m.opt_nums.remove(i);
            m.opt_vals.remove(i);
        } else {
            i = i + 1;
        }
    }
}

/// Replace option `num` by one uint value.
pub fn coap_set_uint(m: & mut CoapMsg, num: i64, v: i64) {
    coap_remove_option(m, num);
    coap_add_uint(m, num, v);
}

pub fn coap_has_option(m: & CoapMsg, num: i64) -> bool {
    return m.opt_nums.contains(num);
}

/// The first value of option `num` ([] when absent).
pub fn coap_get_option(m: & CoapMsg, num: i64) -> Vec<i64> {
    var i: i64 = 0;
    while i < m.opt_nums.len() {
        if m.opt_nums.get(i) == num {
            return m.opt_vals.get(i);
        }
        i = i + 1;
    }
    return Vec::new();
}

/// A uint option's value, or `def` when absent.
pub fn coap_get_uint(m: & CoapMsg, num: i64, def: i64) -> i64 {
    if !coap_has_option(m, num) {
        return def;
    }
    return coap_bytes_uint(coap_get_option(m, num));
}

/// Every value of option `num` as strings.
pub fn coap_get_strs(m: & CoapMsg, num: i64) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < m.opt_nums.len() {
        if m.opt_nums.get(i) == num {
            out.push(str_from_bytes(m.opt_vals.get(i)));
        }
        i = i + 1;
    }
    return out;
}

/// Set Uri-Path (and Uri-Query after a '?') from "/a/b?x=1&y=2".
pub fn coap_set_uri(m: & mut CoapMsg, uri: str) {
    coap_remove_option(m, COAP_O_URI_PATH);
    coap_remove_option(m, COAP_O_URI_QUERY);
    var path: str = uri;
    var query: str = "";
    val q: i64 = str_find(uri, "?");
    if q >= 0 {
        path = str_slice(uri, 0, q);
        query = str_slice(uri, q + 1, str_len(uri));
    }
    val segs: Vec<str> = str_split(path, "/");
    var i: i64 = 0;
    while i < segs.len() {
        if segs.get(i) != "" {
            coap_add_str(m, COAP_O_URI_PATH, segs.get(i));
        }
        i = i + 1;
    }
    if query != "" {
        val qs: Vec<str> = str_split(query, "&");
        i = 0;
        while i < qs.len() {
            coap_add_str(m, COAP_O_URI_QUERY, qs.get(i));
            i = i + 1;
        }
    }
}

/// "/a/b" from the Uri-Path options ("/" when none).
pub fn coap_uri_path(m: & CoapMsg) -> str {
    val segs: Vec<str> = coap_get_strs(m, COAP_O_URI_PATH);
    if segs.len() == 0 {
        return "/";
    }
    var s: str = "";
    var i: i64 = 0;
    while i < segs.len() {
        s = s + "/" + segs.get(i);
        i = i + 1;
    }
    return s;
}

// ─── Encoding and decoding ───────────────────────────────────────────────

fn cp_nibble(v: i64) -> i64 {
    if v < 13 {
        return v;
    }
    if v < 269 {
        return 13;
    }
    return 14;
}

fn cp_ext(out: & mut Vec<i64>, v: i64) {
    if v >= 269 {
        val x: i64 = v - 269;
        out.push((x >> 8) & 255);
        out.push(x & 255);
    } else if v >= 13 {
        out.push(v - 13);
    }
}

/// Encode a message (RFC 7252 section 3).
pub fn coap_encode(m: & CoapMsg) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(64 | ((m.mtype & 3) << 4) | (m.token.len() & 15));
    out.push(m.code & 255);
    out.push((m.mid >> 8) & 255);
    out.push(m.mid & 255);
    out.extend(m.token);
    var prev: i64 = 0;
    var i: i64 = 0;
    while i < m.opt_nums.len() {
        val num: i64 = m.opt_nums.get(i);
        val val_: Vec<i64> = m.opt_vals.get(i);
        val delta: i64 = num - prev;
        val len: i64 = val_.len();
        out.push((cp_nibble(delta) << 4) | cp_nibble(len));
        cp_ext(& mut out, delta);
        cp_ext(& mut out, len);
        out.extend(val_);
        prev = num;
        i = i + 1;
    }
    if m.payload.len() > 0 {
        out.push(255);
        out.extend(m.payload);
    }
    return out;
}

/// A decoded message. `ok` false: `error` says why (a message format
/// error: answer a CON with Reset, ignore a NON).
pub struct CoapDecoded {
    pub ok: bool,
    pub error: str,
    pub msg: CoapMsg,
}

fn cp_bad(m: CoapMsg, why: str) -> CoapDecoded {
    return CoapDecoded {
        ok: false, error: why, msg: m
    };
}

pub fn coap_decode(b: Vec<i64>) -> CoapDecoded {
    var m: CoapMsg = coap_msg(0, 0, 0);
    val n: i64 = b.len();
    if n < 4 {
        return cp_bad(m, "shorter than the header");
    }
    val b0: i64 = b.get(0);
    if (b0 >> 6) != 1 {
        return cp_bad(m, "version is not 1");
    }
    m.mtype = (b0 >> 4) & 3;
    val tkl: i64 = b0 & 15;
    m.code = b.get(1);
    m.mid = (b.get(2) << 8) | b.get(3);
    if tkl > 8 {
        return cp_bad(m, "token length above 8");
    }
    if 4 + tkl > n {
        return cp_bad(m, "token cut short");
    }
    var pos: i64 = 4;
    while pos < 4 + tkl {
        m.token.push(b.get(pos));
        pos = pos + 1;
    }
    if m.code == COAP_EMPTY && (tkl != 0 || n > 4) {
        return cp_bad(m, "empty message with content");
    }
    var num: i64 = 0;
    while pos < n {
        val ob: i64 = b.get(pos);
        pos = pos + 1;
        if ob == 255 {
            if pos >= n {
                return cp_bad(m, "payload marker without payload");
            }
            while pos < n {
                m.payload.push(b.get(pos));
                pos = pos + 1;
            }
            break;
        }
        var delta: i64 = ob >> 4;
        var len: i64 = ob & 15;
        if delta == 15 || len == 15 {
            return cp_bad(m, "reserved option nibble 15");
        }
        if delta == 13 {
            if pos >= n { return cp_bad(m, "option cut short"); }
            delta = b.get(pos) + 13;
            pos = pos + 1;
        } else if delta == 14 {
            if pos + 1 >= n { return cp_bad(m, "option cut short"); }
            delta = (b.get(pos) << 8) + b.get(pos + 1) + 269;
            pos = pos + 2;
        }
        if len == 13 {
            if pos >= n { return cp_bad(m, "option cut short"); }
            len = b.get(pos) + 13;
            pos = pos + 1;
        } else if len == 14 {
            if pos + 1 >= n { return cp_bad(m, "option cut short"); }
            len = (b.get(pos) << 8) + b.get(pos + 1) + 269;
            pos = pos + 2;
        }
        if pos + len > n {
            return cp_bad(m, "option value cut short");
        }
        num = num + delta;
        var v: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < len {
            v.push(b.get(pos + k));
            k = k + 1;
        }
        pos = pos + len;
        m.opt_nums.push(num);
        m.opt_vals.push(v);
    }
    return CoapDecoded {
        ok: true, error: "", msg: m
    };
}

/// The lowest critical option number not in `known`, or 0 when every
/// critical option is understood (a request with one gets 4.02).
pub fn coap_unknown_critical(m: & CoapMsg, known: Vec<i64>) -> i64 {
    var i: i64 = 0;
    while i < m.opt_nums.len() {
        val num: i64 = m.opt_nums.get(i);
        if coap_opt_critical(num) && !known.contains(num) {
            return num;
        }
        i = i + 1;
    }
    return 0;
}

// ─── Block-wise transfer (RFC 7959) ──────────────────────────────────────

/// A Block1/Block2 option value: NUM << 4 | M << 3 | SZX.
pub fn coap_block_value(num: i64, more: bool, szx: i64) -> i64 {
    var v: i64 = (num << 4) | (szx & 7);
    if more {
        v = v | 8;
    }
    return v;
}

pub fn coap_block_num(v: i64) -> i64 {
    return v >> 4;
}

pub fn coap_block_more(v: i64) -> bool {
    return (v & 8) != 0;
}

pub fn coap_block_szx(v: i64) -> i64 {
    return v & 7;
}

/// Block size for SZX (0..6): 16 .. 1024 bytes.
pub fn coap_block_size(szx: i64) -> i64 {
    return 16 << szx;
}

/// The RFC's notation "NUM/M/SIZE", e.g. "2/0/64".
pub fn coap_block_str(v: i64) -> str {
    var m: str = "0";
    if coap_block_more(v) {
        m = "1";
    }
    return int_to_str(coap_block_num(v)) + "/" + m + "/" + int_to_str(coap_block_size(coap_block_szx(v)));
}

/// Bytes of block `num` of `body` with blocks of 2^(szx+4).
pub fn coap_block_slice(body: & Vec<i64>, num: i64, szx: i64) -> Vec<i64> {
    val size: i64 = coap_block_size(szx);
    var out: Vec<i64> = Vec::new();
    var i: i64 = num * size;
    while i < body.len() && i < (num + 1) * size {
        out.push(body.get(i));
        i = i + 1;
    }
    return out;
}

/// Server side of Block2: put block `num` of `body` in response `resp`
/// (payload, Block2, and Size2 on the first block). False when `num` is
/// past the end (answer 4.02 Bad Option, RFC 7959 2.4).
pub fn coap_block2_respond(resp: & mut CoapMsg, body: & Vec<i64>, num: i64, szx: i64) -> bool {
    val size: i64 = coap_block_size(szx);
    if num * size >= body.len() && !(num == 0 && body.len() == 0) {
        return false;
    }
    resp.payload = coap_block_slice(body, num, szx);
    val more: bool = (num + 1) * size < body.len();
    coap_set_uint(resp, COAP_O_BLOCK2, coap_block_value(num, more, szx));
    if num == 0 {
        coap_set_uint(resp, COAP_O_SIZE2, body.len());
    }
    return true;
}

/// A Block2 reassembler (client): add each response; `done` when the
/// last block came, `next` is the Block2 value to ask for otherwise.
pub struct CoapBlockAsm {
    pub data: Vec<i64>,
    pub next: i64,
    pub done: bool,
    pub ok: bool,
    pub etag: Vec<i64>,
}

pub fn coap_block_asm_new() -> CoapBlockAsm {
    return CoapBlockAsm {
        data: Vec::new(), next: 0, done: false, ok: true, etag: Vec::new()
    };
}

/// Add a response. False on a block out of order or an ETag change (the
/// representation changed: start again).
pub fn coap_block_asm_add(a: & mut CoapBlockAsm, resp: & CoapMsg) -> bool {
    if !coap_has_option(resp, COAP_O_BLOCK2) {
        a.data = resp.payload;
        a.done = true;
        return true;
    }
    val v: i64 = coap_get_uint(resp, COAP_O_BLOCK2, 0);
    val size: i64 = coap_block_size(coap_block_szx(v));
    val et: Vec<i64> = coap_get_option(resp, COAP_O_ETAG);
    if a.data.len() == 0 && coap_block_num(v) == 0 {
        a.etag = et;
    } else if !cp_same(& et, & a.etag) {
        a.ok = false;
        return false;
    }
    if coap_block_num(v) * size != a.data.len() {
        a.ok = false;
        return false;
    }
    a.data.extend(resp.payload);
    if coap_block_more(v) {
        if resp.payload.len() != size {
            a.ok = false;   // only the last block may be short
            return false;
        }
        a.next = coap_block_value(coap_block_num(v) + 1, false, coap_block_szx(v));
    } else {
        a.done = true;
    }
    return true;
}

fn cp_same(a: & Vec<i64>, b: & Vec<i64>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// How many Block1 requests an upload of `n` bytes takes.
pub fn coap_block1_count(n: i64, szx: i64) -> i64 {
    val size: i64 = coap_block_size(szx);
    if n == 0 {
        return 1;
    }
    return (n + size - 1) / size;
}

/// Block1 request `num` of an upload: a copy of `base` with the slice and
/// Block1 (Size1 on the first).
pub fn coap_block1_request(base: & CoapMsg, body: & Vec<i64>, num: i64, szx: i64) -> CoapMsg {
    var m: CoapMsg = coap_msg(base.mtype, base.code, base.mid);
    m.token = base.token;
    m.opt_nums = base.opt_nums;
    m.opt_vals = base.opt_vals;
    m.payload = coap_block_slice(body, num, szx);
    val more: bool = (num + 1) * coap_block_size(szx) < body.len();
    coap_set_uint(& mut m, COAP_O_BLOCK1, coap_block_value(num, more, szx));
    if num == 0 {
        coap_set_uint(& mut m, COAP_O_SIZE1, body.len());
    }
    return m;
}

// ─── Observe (RFC 7641) ──────────────────────────────────────────────────

/// Whether a notification (v2 received at t2 seconds) is newer than the
/// last one (v1 at t1): RFC 7641 section 3.4.
pub fn coap_observe_fresh(v1: i64, t1: i64, v2: i64, t2: i64) -> bool {
    val half: i64 = 8388608;   // 2^23
    if v1 < v2 && v2 - v1 < half {
        return true;
    }
    if v1 > v2 && v1 - v2 > half {
        return true;
    }
    return t2 > t1 + 128;
}

/// Observers of the resources of a server: one entry per (path, token).
pub struct CoapObservers {
    pub paths: Vec<str>,
    pub tokens: Vec<Vec<i64>>,
    pub seq: i64,
}

pub fn coap_observers_new() -> CoapObservers {
    return CoapObservers {
        paths: Vec::new(), tokens: Vec::new(), seq: 2
    };
}

/// Handle a GET's Observe option: 0 registers, 1 deregisters. True when
/// the response should carry an Observe sequence (registered).
pub fn coap_observers_request(o: & mut CoapObservers, req: & CoapMsg) -> bool {
    if req.code != COAP_GET || !coap_has_option(req, COAP_O_OBSERVE) {
        return false;
    }
    val path: str = coap_uri_path(req);
    val reg: i64 = coap_get_uint(req, COAP_O_OBSERVE, 0);
    var i: i64 = 0;
    while i < o.paths.len() {
        if o.paths.get(i) == path && cp_same(& o.tokens.get(i), & req.token) {
            o.paths.remove(i);
            o.tokens.remove(i);
        } else {
            i = i + 1;
        }
    }
    if reg == 0 {
        o.paths.push(path);
        o.tokens.push(req.token);
        return true;
    }
    return false;
}

/// The next Observe sequence number (24 bits, wrapping).
pub fn coap_observers_next_seq(o: & mut CoapObservers) -> i64 {
    val s: i64 = o.seq;
    o.seq = (o.seq + 1) & 16777215;
    return s;
}

/// Notifications for a new state of `path`: one 2.05 per observer (type
/// `mtype`, mids from `first_mid`), all with the same sequence number.
pub fn coap_observers_notify(o: & mut CoapObservers, path: str, payload: Vec<i64>, content_format: i64, mtype: i64, first_mid: i64) -> Vec<CoapMsg> {
    var out: Vec<CoapMsg> = Vec::new();
    val seq: i64 = coap_observers_next_seq(o);
    var mid: i64 = first_mid;
    var i: i64 = 0;
    while i < o.paths.len() {
        if o.paths.get(i) == path {
            var m: CoapMsg = coap_msg(mtype, COAP_CONTENT, mid & 65535);
            m.token = o.tokens.get(i);
            coap_add_uint(& mut m, COAP_O_OBSERVE, seq);
            coap_add_uint(& mut m, COAP_O_CONTENT_FORMAT, content_format);
            m.payload = payload;
            out.push(m);
            mid = mid + 1;
        }
        i = i + 1;
    }
    return out;
}

/// A client answered a notification with Reset: forget that observer.
pub fn coap_observers_cancel(o: & mut CoapObservers, token: & Vec<i64>) {
    var i: i64 = 0;
    while i < o.tokens.len() {
        if cp_same(& o.tokens.get(i), token) {
            o.paths.remove(i);
            o.tokens.remove(i);
        } else {
            i = i + 1;
        }
    }
}

// ─── Endpoint: matching and reliability ──────────────────────────────────

/// What happened to a request (CoapEvent.kind).
pub const COAP_EV_RESPONSE: i64 = 1;   // a response (or notification)
pub const COAP_EV_TIMEOUT: i64 = 2;    // no ACK after MAX_RETRANSMIT
pub const COAP_EV_RESET: i64 = 3;      // the peer answered with RST
pub const COAP_EV_REQUEST: i64 = 4;    // a request for us (server side)

pub struct CoapEvent {
    pub kind: i64,
    pub token: Vec<i64>,
    pub msg: CoapMsg,
}

/// One endpoint towards one peer (see the module header).
pub struct CoapEndpoint {
    pub next_mid: i64,
    pub next_token: i64,
    pub rng: i64,
    pub outbox: Vec<Vec<i64>>,
    pub events: Vec<CoapEvent>,
    // confirmable messages waiting for an ACK
    pub rt_mids: Vec<i64>,
    pub rt_bytes: Vec<Vec<i64>>,
    pub rt_due: Vec<i64>,
    pub rt_wait: Vec<i64>,
    pub rt_count: Vec<i64>,
    pub rt_tokens: Vec<Vec<i64>>,
    // requests waiting for a response: token, observe
    pub req_tokens: Vec<Vec<i64>>,
    pub req_observe: Vec<bool>,
    // server: recently seen CON/NON mids and the reply sent (dedup)
    pub seen_mids: Vec<i64>,
    pub seen_reply: Vec<Vec<i64>>,
    pub seen_at: Vec<i64>,
}

pub fn coap_ep_new(first_mid: i64, seed: i64) -> CoapEndpoint {
    return CoapEndpoint {
        next_mid: first_mid & 65535, next_token: 1, rng: seed, outbox: Vec::new(), events: Vec::new(), rt_mids: Vec::new(), rt_bytes: Vec::new(), rt_due: Vec::new(), rt_wait: Vec::new(), rt_count: Vec::new(), rt_tokens: Vec::new(), req_tokens: Vec::new(), req_observe: Vec::new(), seen_mids: Vec::new(), seen_reply: Vec::new(), seen_at: Vec::new(),
    };
}

pub fn coap_ep_mid(e: & mut CoapEndpoint) -> i64 {
    val m: i64 = e.next_mid;
    e.next_mid = (e.next_mid + 1) & 65535;
    return m;
}

/// A fresh 4-byte token.
pub fn coap_ep_token(e: & mut CoapEndpoint) -> Vec<i64> {
    val t: i64 = e.next_token;
    e.next_token = e.next_token + 1;
    var out: Vec<i64> = Vec::new();
    out.push((t >> 24) & 255);
    out.push((t >> 16) & 255);
    out.push((t >> 8) & 255);
    out.push(t & 255);
    return out;
}

// The first timeout: ACK_TIMEOUT .. ACK_TIMEOUT * 1.5 (random).
fn cp_first_timeout(e: & mut CoapEndpoint) -> i64 {
    e.rng = (e.rng * 1103515245 + 12345) % 2147483648;
    return COAP_ACK_TIMEOUT + (e.rng % 1001);
}

fn cp_track_con(e: & mut CoapEndpoint, m: & CoapMsg, bytes: Vec<i64>, now: i64) {
    val w: i64 = cp_first_timeout(e);
    e.rt_mids.push(m.mid);
    e.rt_bytes.push(bytes);
    e.rt_due.push(now + w);
    e.rt_wait.push(w);
    e.rt_count.push(0);
    e.rt_tokens.push(m.token);
}

/// Send a request: gives it a mid and a token (unless it has one), and
/// tracks it. The token, to match the response events with.
pub fn coap_ep_request(e: & mut CoapEndpoint, req: & mut CoapMsg, now: i64) -> Vec<i64> {
    req.mid = coap_ep_mid(e);
    if req.token.len() == 0 {
        req.token = coap_ep_token(e);
    }
    val bytes: Vec<i64> = coap_encode(req);
    e.outbox.push(bytes);
    if req.mtype == COAP_CON {
        cp_track_con(e, req, bytes, now);
    }
    e.req_tokens.push(req.token);
    e.req_observe.push(coap_has_option(req, COAP_O_OBSERVE) && coap_get_uint(req, COAP_O_OBSERVE, 1) == 0);
    return req.token;
}

/// Stop waiting for responses with this token (ends an observation on
/// our side; the next notification is answered with Reset).
pub fn coap_ep_forget(e: & mut CoapEndpoint, token: & Vec<i64>) {
    val k: i64 = cp_find_tok(& e.req_tokens, token);
    if k >= 0 {
        e.req_tokens.remove(k);
        e.req_observe.remove(k);
    }
}

pub fn coap_ep_take_outbox(e: & mut CoapEndpoint) -> Vec<Vec<i64>> {
    val out: Vec<Vec<i64>> = e.outbox;
    e.outbox = Vec::new();
    return out;
}

pub fn coap_ep_take_events(e: & mut CoapEndpoint) -> Vec<CoapEvent> {
    val out: Vec<CoapEvent> = e.events;
    e.events = Vec::new();
    return out;
}

/// Exchanges still open (requests waiting, CONs waiting for an ACK).
pub fn coap_ep_pending(e: & CoapEndpoint) -> i64 {
    return e.req_tokens.len() + e.rt_mids.len();
}

fn cp_find_tok(v: & Vec<Vec<i64>>, t: & Vec<i64>) -> i64 {
    var i: i64 = 0;
    while i < v.len() {
        if cp_same(& v.get(i), t) {
            return i;
        }
        i = i + 1;
    }
    return - 1;
}

fn cp_find(v: & Vec<i64>, x: i64) -> i64 {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return i;
        }
        i = i + 1;
    }
    return - 1;
}

fn cp_rt_remove(e: & mut CoapEndpoint, k: i64) {
    e.rt_mids.remove(k);
    e.rt_bytes.remove(k);
    e.rt_due.remove(k);
    e.rt_wait.remove(k);
    e.rt_count.remove(k);
    e.rt_tokens.remove(k);
}

fn cp_event(e: & mut CoapEndpoint, kind: i64, token: Vec<i64>, m: CoapMsg) {
    e.events.push(CoapEvent {
        kind: kind, token: token, msg: m
    });
}

fn cp_send_empty(e: & mut CoapEndpoint, mtype: i64, mid: i64) {
    val m: CoapMsg = coap_msg(mtype, COAP_EMPTY, mid);
    e.outbox.push(coap_encode(& m));
}

/// Give the endpoint one datagram received from the peer.
pub fn coap_ep_receive(e: & mut CoapEndpoint, bytes: Vec<i64>, now: i64) {
    val d: CoapDecoded = coap_decode(bytes);
    if !d.ok {
        if d.msg.mtype == COAP_CON && bytes.len() >= 4 {
            cp_send_empty(e, COAP_RST, d.msg.mid);
        }
        return;
    }
    val m: CoapMsg = d.msg;
    // ACK or RST ends the retransmission of our CON with that mid
    if m.mtype == COAP_ACK || m.mtype == COAP_RST {
        val k: i64 = cp_find(& e.rt_mids, m.mid);
        if k < 0 {
            return;   // late or unknown: ignore
        }
        val tok: Vec<i64> = e.rt_tokens.get(k);
        cp_rt_remove(e, k);
        if m.mtype == COAP_RST {
            coap_ep_forget(e, & tok);
            cp_event(e, COAP_EV_RESET, tok, m);
            return;
        }
        if m.code == COAP_EMPTY {
            return;   // separate response follows
        }
        cp_deliver(e, m);
        return;
    }
    if m.code == COAP_EMPTY {
        if m.mtype == COAP_CON {
            cp_send_empty(e, COAP_RST, m.mid);   // a CoAP ping
        }
        return;
    }
    if coap_is_request(& m) {
        // duplicate: send the same reply again, do not deliver twice
        val s: i64 = cp_find(& e.seen_mids, m.mid);
        if s >= 0 {
            val reply: Vec<i64> = e.seen_reply.get(s);
            if reply.len() > 0 {
                e.outbox.push(reply);
            }
            return;
        }
        e.seen_mids.push(m.mid);
        e.seen_reply.push(Vec::new());
        e.seen_at.push(now);
        cp_event(e, COAP_EV_REQUEST, m.token, m);
        return;
    }
    // a separate response or a notification (CON or NON)
    if cp_find_tok(& e.req_tokens, & m.token) < 0 {
        cp_send_empty(e, COAP_RST, m.mid);
        return;
    }
    if m.mtype == COAP_CON {
        cp_send_empty(e, COAP_ACK, m.mid);
    }
    cp_deliver(e, m);
}

fn cp_deliver(e: & mut CoapEndpoint, m: CoapMsg) {
    val k: i64 = cp_find_tok(& e.req_tokens, & m.token);
    if k < 0 {
        return;
    }
    val observing: bool = e.req_observe.get(k) && coap_has_option(& m, COAP_O_OBSERVE) && m.code < 128;
    if !observing {
        e.req_tokens.remove(k);
        e.req_observe.remove(k);
    }
    cp_event(e, COAP_EV_RESPONSE, m.token, m);
}

/// Answer request `req` (from a COAP_EV_REQUEST event): a piggybacked ACK
/// for a CON, a NON for a NON. `resp` gives code, options and payload.
pub fn coap_ep_respond(e: & mut CoapEndpoint, req: & CoapMsg, resp: & mut CoapMsg, now: i64) {
    resp.token = req.token;
    if req.mtype == COAP_CON {
        resp.mtype = COAP_ACK;
        resp.mid = req.mid;
    } else {
        resp.mtype = COAP_NON;
        resp.mid = coap_ep_mid(e);
    }
    val bytes: Vec<i64> = coap_encode(resp);
    e.outbox.push(bytes);
    val s: i64 = cp_find(& e.seen_mids, req.mid);
    if s >= 0 {
        e.seen_reply.set(s, bytes);
    }
}

/// Acknowledge a CON request now and answer it later (coap_ep_send_separate).
pub fn coap_ep_ack_empty(e: & mut CoapEndpoint, req: & CoapMsg) {
    val m: CoapMsg = coap_msg(COAP_ACK, COAP_EMPTY, req.mid);
    val bytes: Vec<i64> = coap_encode(& m);
    e.outbox.push(bytes);
    val s: i64 = cp_find(& e.seen_mids, req.mid);
    if s >= 0 {
        e.seen_reply.set(s, bytes);
    }
}

/// Send a separate response (or a notification) as CON or NON; a CON is
/// retransmitted until the peer ACKs it.
pub fn coap_ep_send(e: & mut CoapEndpoint, m: & mut CoapMsg, now: i64) {
    m.mid = coap_ep_mid(e);
    val bytes: Vec<i64> = coap_encode(m);
    e.outbox.push(bytes);
    if m.mtype == COAP_CON {
        cp_track_con(e, m, bytes, now);
    }
}

/// Let time pass: retransmit CONs whose timeout ran out (doubling it),
/// give up after MAX_RETRANSMIT, forget old duplicate-detection entries.
pub fn coap_ep_tick(e: & mut CoapEndpoint, now: i64) {
    var i: i64 = 0;
    while i < e.rt_mids.len() {
        if now >= e.rt_due.get(i) {
            if e.rt_count.get(i) >= COAP_MAX_RETRANSMIT {
                val tok: Vec<i64> = e.rt_tokens.get(i);
                val mid: i64 = e.rt_mids.get(i);
                cp_rt_remove(e, i);
                coap_ep_forget(e, & tok);
                cp_event(e, COAP_EV_TIMEOUT, tok, coap_msg(COAP_CON, COAP_EMPTY, mid));
                continue;
            }
            e.outbox.push(e.rt_bytes.get(i));
            val w: i64 = e.rt_wait.get(i) * 2;
            e.rt_wait.set(i, w);
            e.rt_due.set(i, now + w);
            e.rt_count.set(i, e.rt_count.get(i) + 1);
        }
        i = i + 1;
    }
    i = 0;
    while i < e.seen_mids.len() {
        if now - e.seen_at.get(i) > COAP_EXCHANGE_LIFETIME {
            e.seen_mids.remove(i);
            e.seen_reply.remove(i);
            e.seen_at.remove(i);
        } else {
            i = i + 1;
        }
    }
}
