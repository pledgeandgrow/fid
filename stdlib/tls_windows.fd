// Fides TLS on Windows, through Schannel (the system's TLS). `use tls` picks this
// module on Windows and tls_unix on other systems; they have the same functions.
//
// Certificates are checked against the system's store, and the name against
// `host`. Reading and writing wait as tasks do: other tasks run meanwhile.
//
// Usage:
//   use tls;
//   val s: i64 = tls_connect("example.com", 443);
//   tls_session_send(s, data as i64, str_len(data));
//   val n: i64 = tls_session_recv(s, buffer, size, 30000);
//   tls_session_close(s);
//
// A server key comes from a PKCS#12 (.pfx) file: tls_server(path, password).
// Schannel needs the key in the user's key store, so tls_server imports a
// copy there (a CNG key) and tls_server_close deletes it.
//
// TLS 1.3 (Windows 11 / Server 2022): tls_client and tls_server take
// credentials through SCH_CREDENTIALS, which lets Schannel offer 1.3
// (SCHANNEL_CRED stops at 1.2; older Windows releases get it as before);
// tls_client13, tls_connect13 and tls_server13 accept nothing else;
// tls_session_version gives 772 for 1.3 on both platforms. Handshake
// messages after the handshake (1.3 NewSessionTicket and KeyUpdate, a 1.2
// renegotiation) are answered inside tls_session_recv.
//
// ALPN (RFC 7301): tls_connect_alpn(host, port, "h2,http/1.1") offers
// protocols, tls_server_alpn(server, "h2,http/1.1") makes a server pick
// one (its first the client offers), tls_session_alpn(s) gives the choice.
// Schannel takes the lists as SECBUFFER_APPLICATION_PROTOCOLS input
// buffers (Windows 8.1 / Server 2012 R2 or later).

module tls;
use tls_alpn;
// SAFETY: each declaration matches the secur32 (SSPI) prototype it names,
// handles and structure pointers as i64 words; every pointer passed is 0, a
// handle Schannel returned, or a block this module allocated with ts_zeroed
// at the size SSPI expects.
extern "C" link "secur32" {
    fn AcquireCredentialsHandleA as sc_acquire(principal: i64, package: str, usage: i64, logon: i64, auth: i64, get_key: i64, get_arg: i64, cred: i64, expiry: i64) -> i32;
    fn FreeCredentialsHandle as sc_free_cred(cred: i64) -> i32;
    fn InitializeSecurityContextA as sc_init(cred: i64, ctx: i64, target: str, flags: i64, reserved: i64, rep: i64, input: i64, reserved2: i64, new_ctx: i64, output: i64, attrs: i64, expiry: i64) -> i32;
    fn AcceptSecurityContext as sc_accept(cred: i64, ctx: i64, input: i64, flags: i64, rep: i64, new_ctx: i64, output: i64, attrs: i64, expiry: i64) -> i32;
    fn DeleteSecurityContext as sc_delete(ctx: i64) -> i32;
    fn FreeContextBuffer as sc_free_buffer(buffer: i64) -> i32;
    fn QueryContextAttributesA as sc_query(ctx: i64, attr: i64, out: i64) -> i32;
    fn EncryptMessage as sc_encrypt(ctx: i64, qop: i64, desc: i64, seq: i64) -> i32;
    fn DecryptMessage as sc_decrypt(ctx: i64, desc: i64, seq: i64, qop: i64) -> i32;
}

// SAFETY: the prototypes come from <wincrypt.h> (the include), so the C
// compiler checks each call; the blob is a 2-word CRYPT_DATA_BLOB this module
// filled and the password a NUL-terminated UTF-16 buffer it made.
extern "C" include "<wincrypt.h>" link "crypt32" {
    fn PFXImportCertStore as sc_pfx_import(blob: *u8, password: *u8, flags: i64) -> *u8;
    fn CertFindCertificateInStore as sc_find_cert(store: *u8, encoding: i64, flags: i64, kind: i64, para: *u8, prev: *u8) -> *u8;
    fn CertGetCertificateContextProperty as sc_cert_prop(cert: *u8, id: i64, data: *u8, size: *u8) -> i32;
    fn CertFreeCertificateContext as sc_free_cert(cert: *u8) -> i32;
    fn CertCloseStore as sc_close_store(store: *u8, flags: i64) -> i32;
}

// SAFETY: the prototypes come from <ncrypt.h>, which <wincrypt.h> includes;
// handles are the integers NCrypt returned, the out-slots one-word blocks
// this module allocated, and the names the NUL-terminated UTF-16 strings of
// the certificate's CRYPT_KEY_PROV_INFO.
extern "C" include "<wincrypt.h>" link "ncrypt" {
    fn NCryptOpenStorageProvider as nc_open_provider(prov: *u8, name: *u8, flags: i64) -> i32;
    fn NCryptOpenKey as nc_open_key(prov: i64, key: *u8, name: *u8, spec: i64, flags: i64) -> i32;
    fn NCryptDeleteKey as nc_delete_key(key: i64, flags: i64) -> i32;
    fn NCryptFreeObject as nc_free_object(obj: i64) -> i32;
}

// SAFETY: the prototypes come from <stdio.h>; fread writes at most cap bytes
// into the cap-byte block it is given.
extern "C" include "<stdio.h>" {
    fn fopen as ts_fopen(path: str, mode: str) -> *u8;
    fn fread as ts_fread(buf: *u8, size: i64, n: i64, file: *u8) -> i64;
    fn fclose as ts_fclose(file: *u8) -> i32;
}

// SAFETY: the prototype comes from <string.h>; every caller moves bytes
// inside one buffer it allocated, within its length.
extern "C" include "<string.h>" {
    fn memmove as ts_memmove(dst: *u8, src: *u8, n: i64) -> *u8;
}

const TS_PACKAGE: str = "Microsoft Unified Security Protocol Provider";
const TS_OK: i64 = 0;
const TS_CONTINUE: i64 = 590610;  // SEC_I_CONTINUE_NEEDED
const TS_CLOSED: i64 = 590615;  // SEC_I_CONTEXT_EXPIRED
const TS_INCOMPLETE: i64 = -2146893032;  // SEC_E_INCOMPLETE_MESSAGE
const TS_TIMEOUT: i64 = 30000;
const TB_EMPTY: i64 = 0;
const TB_DATA: i64 = 1;
const TB_TOKEN: i64 = 2;
const TB_EXTRA: i64 = 5;
const TB_TRAILER: i64 = 6;
const TB_HEADER: i64 = 7;
// A session is a block of words: socket, context handle (2), credentials handle
// (2), header, trailer and message sizes, input buffer, its size, the encrypted
// bytes in it, plain buffer, unread plain offset, unread plain bytes,
// whether it owns the credentials, the ALPN block the handshake offers
// (0: none; only during the handshake, the caller owns it), the host name
// a client checks (a ts_text_block, for the calls after the handshake; 0 on
// a server), whether the bytes in the input buffer belong to a handshake
// message that came after the handshake (TS_POST, see ts_post_handshake),
// whether it is the server's side, and the protocol ALPN chose (a
// ts_text_block read when the handshake ends, 0: none; Schannel forgets it
// once a TLS 1.3 client has taken the server's NewSessionTicket).
const TS_FD: i64 = 0;
const TS_CTX: i64 = 1;
const TS_CRED: i64 = 3;
const TS_HEADER: i64 = 5;
const TS_TRAILER: i64 = 6;
const TS_MAX: i64 = 7;
const TS_BUF: i64 = 8;
const TS_CAP: i64 = 9;
const TS_HAVE: i64 = 10;
const TS_PLAIN: i64 = 11;
const TS_PLAIN_AT: i64 = 12;
const TS_PLAIN_LEN: i64 = 13;
const TS_OWNS_CRED: i64 = 14;
const TS_ALPN: i64 = 15;
const TS_HOST: i64 = 16;
const TS_POST: i64 = 17;
const TS_SIDE: i64 = 18;
const TS_CHOSEN: i64 = 19;
const TS_WORDS: i64 = 20;
// SEC_I_RENEGOTIATE: DecryptMessage met a handshake message (TLS 1.3: a
// NewSessionTicket or KeyUpdate after the handshake; TLS 1.2: a
// renegotiation)
const TS_RENEGOTIATE: i64 = 590625;
// ALPN through SSPI: SECBUFFER_APPLICATION_PROTOCOLS (an input buffer
// holding a SEC_APPLICATION_PROTOCOLS block), SECPKG_ATTR_APPLICATION_PROTOCOL
// (the choice), SecApplicationProtocolNegotiationExt_ALPN and
// SecApplicationProtocolNegotiationStatus_Success.
const TB_ALPN: i64 = 18;
const TS_ATTR_ALPN: i64 = 35;
const TS_ALPN_EXT: i64 = 2;
const TS_ALPN_OK: i64 = 1;
// A server's credentials are a block of 4 words: the credentials handle (2),
// its ALPN block (tls_server_alpn; 0: none) and its certificate slot
// (ts_server_slot: the certificate, then the store it came from).
const TS_SERVER_WORDS: i64 = 4;
// PFXImportCertStore: PKCS12_ALWAYS_CNG_KSP. TLS 1.3 signs with RSA-PSS,
// which the legacy CryptoAPI providers cannot do: a key imported into one
// fails a 1.3 handshake. A CNG key also serves TLS 1.2.
const TS_PFX_CNG: i64 = 512;
// CERT_KEY_PROV_INFO_PROP_ID, NCRYPT_MACHINE_KEY_FLAG
const TS_KEY_PROV_INFO: i64 = 2;
const TS_MACHINE_KEY: i64 = 32;
fn ts_get(p: i64) -> i64 {
    var a: *mut i64 = p as *mut i64;
    var v: i64 = 0;
    // SAFETY: private helper; callers pass a word of a block this module
    // allocated (a session of TS_WORDS words, a ts_zeroed block). The public
    // tls_session_* functions take the session handle as an i64: one not made
    // by tls_connect/tls_accept is not caught (release M10, left).
    unsafe {
        v = *a;
    }
    return v;
}

fn ts_set(p: i64, v: i64) {
    var a: *mut i64 = p as *mut i64;
    // SAFETY: private helper; as ts_get, a word of a block this module
    // allocated.
    unsafe {
        *a = v;
    }
}

fn ts_get32(p: i64) -> i64 {
    return ts_get(p) & 4294967295;
}

fn ts_set32(p: i64, v: i64) {
    ts_set(p, (ts_get(p) & (0 - 4294967296)) | (v & 4294967295));
}

fn ts_copy(dst: i64, src: i64, n: i64) {
    // SAFETY: private helper; memmove reads n bytes at src and writes n at
    // dst, and allows them to overlap. Callers move bytes within a session's
    // 65536-byte input buffer (n <= what it holds), from it into the
    // 65536-byte plain buffer (a decrypted record is smaller than its
    // input), into tls_session_send's message block (n <= TS_MAX) or between
    // that and the caller's address/length pair of tls_session_send/recv
    // (the caller's contract: n bytes valid at addr).
    unsafe {
        ts_memmove(dst as *u8, src as *u8, n);
    }
}

/// `n` zeroed words.
fn ts_zeroed(n: i64) -> i64 {
    var block: i64 = 0;
    // SAFETY: a fresh n * 8-byte block; the loop below zeroes each of its n
    // words and the caller owns it (and frees it with p_free).
    unsafe {
        block = p_malloc(n * 8);
    }
    var i: i64 = 0;
    while i < n {
        ts_set(block + i * 8, 0);
        i = i + 1;
    }
    return block;
}

fn ts_field(s: i64, i: i64) -> i64 {
    return ts_get(s + i * 8);
}

fn ts_put(s: i64, i: i64, v: i64) {
    ts_set(s + i * 8, v);
}

// A SecBuffer: size, type, pointer. A SecBufferDesc: version, count, pointer.
fn ts_buffer(buffers: i64, i: i64, kind: i64, addr: i64, size: i64) {
    val b: i64 = buffers + i * 16;
    ts_set32(b, size);
    ts_set32(b + 4, kind);
    ts_set(b + 8, addr);
}

fn ts_buffer_size(buffers: i64, i: i64) -> i64 {
    return ts_get32(buffers + i * 16);
}

fn ts_buffer_kind(buffers: i64, i: i64) -> i64 {
    return ts_get32(buffers + i * 16 + 4);
}

fn ts_buffer_addr(buffers: i64, i: i64) -> i64 {
    return ts_get(buffers + i * 16 + 8);
}

fn ts_desc(buffers: i64, count: i64) -> i64 {
    val desc: i64 = ts_zeroed(2);
    ts_set32(desc + 4, count);
    ts_set(desc + 8, buffers);
    return desc;
}

// A SEC_APPLICATION_PROTOCOLS block for "h2,http/1.1"-style names, as
// zeroed words: ProtocolListsSize (u32) at 0, then one
// SEC_APPLICATION_PROTOCOL_LIST: ProtoNegoExt (u32) at 4, ProtocolListSize
// (u16) at 8, the wire-format list at 10. 0 when no name is left.
fn ts_alpn_block(protos: str) -> i64 {
    val wire: Vec<i64> = tls_alpn_wire(protos);
    val n: i64 = wire.len();
    if n == 0 || n > 65535 {
        return 0;
    }
    val block: i64 = ts_zeroed((10 + n) / 8 + 2);
    ts_set32(block, 6 + n);
    ts_set32(block + 4, TS_ALPN_EXT);
    p_volatile_store8(block + 8, n & 255);
    p_volatile_store8(block + 9, (n >> 8) & 255);
    var i: i64 = 0;
    while i < n {
        p_volatile_store8(block + 10 + i, wire.get(i));
        i = i + 1;
    }
    return block;
}

// The size of an ALPN block, for its SecBuffer.
fn ts_alpn_block_size(block: i64) -> i64 {
    return ts_get32(block) + 4;
}

fn ts_session(fd: i64) -> i64 {
    val s: i64 = ts_zeroed(TS_WORDS);
    ts_put(s, TS_FD, fd);
    ts_put(s, TS_CAP, 65536);
    // SAFETY: two fresh 65536-byte blocks (TS_CAP), the input and plain
    // buffers; the session owns them and ts_free_session frees them.
    unsafe {
        ts_put(s, TS_BUF, p_malloc(65536));
        ts_put(s, TS_PLAIN, p_malloc(65536));
    }
    return s;
}

fn ts_free_session(s: i64) {
    // SAFETY: the two buffers ts_session allocated for s; s is being freed,
    // so nothing reads them afterwards.
    unsafe {
        p_free(ts_field(s, TS_BUF));
        p_free(ts_field(s, TS_PLAIN));
    }
    if ts_field(s, TS_HOST) != 0 {
        // SAFETY: the ts_text_block the client stored in TS_HOST; only the
        // session pointed to it.
        unsafe {
            p_free(ts_field(s, TS_HOST));
        }
    }
    if ts_field(s, TS_CHOSEN) != 0 {
        // SAFETY: the ts_text_block ts_handshake stored in TS_CHOSEN; only
        // the session pointed to it.
        unsafe {
            p_free(ts_field(s, TS_CHOSEN));
        }
    }
    // SAFETY: s is the ts_zeroed block of ts_session; the caller drops its
    // handle (a closed or failed session is not used again).
    unsafe {
        p_free(s);
    }
}

// A copy of `t` the session keeps: [length word][bytes].
fn ts_text_block(t: str) -> i64 {
    val n: i64 = str_len(t);
    var block: i64 = 0;
    // SAFETY: a fresh n + 16-byte block: the length word and the n bytes
    // written below fit in it (8 + n bytes); the caller owns it.
    unsafe {
        block = p_malloc(n + 16);
    }
    ts_set(block, n);
    var i: i64 = 0;
    while i < n {
        p_volatile_store8(block + 8 + i, str_byte_at(t, i));
        i = i + 1;
    }
    return block;
}

// The text of a ts_text_block ("" for 0).
fn ts_block_text(block: i64) -> str {
    if block == 0 {
        return "";
    }
    var b: Vec<i64> = Vec::new();
    val n: i64 = ts_get(block);
    var i: i64 = 0;
    while i < n {
        b.push(p_volatile_load8(block + 8 + i));
        i = i + 1;
    }
    return str_from_bytes(b);
}

/// The sizes EncryptMessage needs, once the handshake is done.
fn ts_stream_sizes(s: i64) {
    val sizes: i64 = ts_zeroed(3);
    // SAFETY: SECPKG_ATTR_STREAM_SIZES (4) writes a SecPkgContext_StreamSizes
    // (5 u32, 20 bytes) into sizes, 24 bytes; the context handle at s + 8 is
    // the one the finished handshake made.
    unsafe {
        sc_query(s + TS_CTX * 8, 4, sizes);
    }
    ts_put(s, TS_HEADER, ts_get32(sizes));
    ts_put(s, TS_TRAILER, ts_get32(sizes + 4));
    ts_put(s, TS_MAX, ts_get32(sizes + 8));
    // SAFETY: the ts_zeroed block above, read for the last time.
    unsafe {
        p_free(sizes);
    }
}

/// The handshake, either side. Returns true once it is done.
fn ts_handshake(s: i64, host: str, server: bool) -> bool {
    val fd: i64 = ts_field(s, TS_FD);
    val buf: i64 = ts_field(s, TS_BUF);
    val cap: i64 = ts_field(s, TS_CAP);
    val cred: i64 = s + TS_CRED * 8;
    val ctx: i64 = s + TS_CTX * 8;
    val attrs: i64 = ts_zeroed(1);
    val expiry: i64 = ts_zeroed(1);
    val input: i64 = ts_zeroed(6);
    val output: i64 = ts_zeroed(2);
    val in_desc: i64 = ts_desc(input, 2);
    val out_desc: i64 = ts_desc(output, 1);
    // ALPN: a client offers its list as the only input of its first call;
    // a server gives its list with the ClientHello it answers first
    val alpn: i64 = ts_field(s, TS_ALPN);
    val alpn_buffers: i64 = ts_zeroed(2);
    val alpn_desc: i64 = ts_desc(alpn_buffers, 1);
    if alpn != 0 {
        ts_buffer(alpn_buffers, 0, TB_ALPN, alpn, ts_alpn_block_size(alpn));
    }
    var have: i64 = 0;
    var started: bool = false;
    var done: bool = false;
    var failed: bool = false;
    var need_data: bool = server;
    while !done && !failed {
        if need_data {
            val n: i64 = p_co_recv(fd, buf + have, cap - have, TS_TIMEOUT);
            if n <= 0 {
                failed = true;
                break;
            }
            have = have + n;
        }
        ts_buffer(input, 0, TB_TOKEN, buf, have);
        ts_buffer(input, 1, TB_EMPTY, 0, 0);
        if server && !started && alpn != 0 {
            ts_buffer(input, 2, TB_ALPN, alpn, ts_alpn_block_size(alpn));
            ts_set32(in_desc + 4, 3);
        } else {
            ts_set32(in_desc + 4, 2);
        }
        ts_buffer(output, 0, TB_TOKEN, 0, 0);
        var rc: i64 = 0;
        if server {
            var old: i64 = 0;
            if started {
                old = ctx;
            }
            // ASC_REQ: sequence and replay detection, confidentiality,
            // allocate memory, stream
            // SAFETY: cred is the server's credentials handle copied into
            // the session (tls_accept), ctx the session's 2-word context
            // slot (0 for old on the first call); in_desc describes 2 or 3
            // SecBuffers in input (6 words), the token one over the `have`
            // received bytes of buf; out_desc 1 buffer Schannel allocates
            // (ASC_REQ_ALLOCATE_MEMORY, freed below); attrs and expiry are
            // one-word blocks. All live until after the loop.
            unsafe {
                rc = sc_accept(cred, old, in_desc, 65820, 0, ctx, out_desc, attrs, expiry);
            }
        } else if started {
            // SAFETY: as sc_accept above, on the client: cred is the
            // handle ts_acquire* wrote into the session, ctx the context
            // the first call made, host a NUL-terminated str (the name the
            // certificate is checked against).
            unsafe {
                rc = sc_init(cred, ctx, host, 33052, 0, 0, in_desc, 0, ctx, out_desc, attrs, expiry);
            }
        } else if alpn != 0 {
            // SAFETY: the first client call: no context yet (0); the only
            // input is alpn_desc, 1 SecBuffer over the ALPN block of
            // ts_alpn_block_size bytes, owned by the caller for the
            // handshake. Other arguments as in the call above.
            unsafe {
                rc = sc_init(cred, 0, host, 33052, 0, 0, alpn_desc, 0, ctx, out_desc, attrs, expiry);
            }
        } else {
            // SAFETY: the first client call without input (0); the other
            // arguments as in the calls above.
            unsafe {
                rc = sc_init(cred, 0, host, 33052, 0, 0, 0, 0, ctx, out_desc, attrs, expiry);
            }
        }
        if rc != TS_INCOMPLETE {
            started = true;
        }
        val out_size: i64 = ts_buffer_size(output, 0);
        val out_addr: i64 = ts_buffer_addr(output, 0);
        if out_addr != 0 {
            if out_size > 0 && p_co_send(fd, out_addr, out_size) != out_size {
                failed = true;
            }
            // SAFETY: out_addr is the output token Schannel allocated in this
            // round (ISC/ASC_REQ_ALLOCATE_MEMORY), sent above and not used
            // again; the next round resets the output buffer to 0.
            unsafe {
                sc_free_buffer(out_addr);
            }
        }
        if rc == TS_OK || rc == TS_CONTINUE {
            // What the call did not use stays in the buffer
            var extra: i64 = 0;
            if ts_buffer_kind(input, 1) == TB_EXTRA {
                extra = ts_buffer_size(input, 1);
            }
            if extra > 0 {
                ts_copy(buf, buf + have - extra, extra);
            }
            have = extra;
            need_data = extra == 0;
            done = rc == TS_OK;
        } else if rc == TS_INCOMPLETE {
            need_data = true;
        } else {
            failed = true;
        }
    }
    ts_put(s, TS_HAVE, have);
    // SAFETY: the eight ts_zeroed/ts_desc blocks this function allocated;
    // the loop is over and Schannel keeps no pointer to them (the output
    // token it allocated was freed in its round).
    unsafe {
        p_free(attrs);
        p_free(expiry);
        p_free(input);
        p_free(output);
        p_free(in_desc);
        p_free(out_desc);
        p_free(alpn_buffers);
        p_free(alpn_desc);
    }
    if done {
        ts_stream_sizes(s);
        // what ALPN chose, kept: Schannel's answer to the query does not
        // last (tls_session_alpn)
        if alpn != 0 {
            val chosen: str = ts_query_alpn(s);
            if chosen != "" {
                ts_put(s, TS_CHOSEN, ts_text_block(chosen));
            }
        }
    }
    return done;
}

// SCHANNEL_CRED: 80 bytes; version at 0, credentials at 4 and 8, flags at 72.
fn ts_acquire(s: i64, usage: i64, flags: i64, cert_slot: i64) -> bool {
    val cred: i64 = ts_zeroed(10);
    ts_set32(cred, 4);
    if cert_slot != 0 {
        ts_set32(cred + 4, 1);
        ts_set(cred + 8, cert_slot);
    }
    // grbitEnabledProtocols stays 0 (system default): pinning TLS1_3 bits
    // fails the handshake — Schannel 1.3 needs the SCH_CRED + TLS_PARAMETERS
    // credentials structure (release-roadmap I7), not the protocol field.
    ts_set32(cred + 72, flags);
    val expiry: i64 = ts_zeroed(1);
    var rc: i64 = 0;
    // SAFETY: cred is an 80-byte SCHANNEL_CRED (ts_zeroed(10)) filled above,
    // its paCred the caller's certificate slot or none; Schannel writes the
    // 2-word credentials handle at s + 24 (a session's TS_CRED words, or
    // tls_server's block, passed so that this lands at its word 0) and a
    // one-word expiry into expiry. TS_PACKAGE is a NUL-terminated literal.
    unsafe {
        rc = sc_acquire(0, TS_PACKAGE, usage, 0, cred, 0, 0, s + TS_CRED * 8, expiry);
    }
    // SAFETY: the two ts_zeroed blocks above; AcquireCredentialsHandle
    // copies what it needs, nothing points to them afterwards.
    unsafe {
        p_free(cred);
        p_free(expiry);
    }
    return rc == TS_OK;
}

// SCH_CREDENTIALS (schannel.h, SCH_CREDENTIALS_VERSION = 5): 72 bytes;
// dwVersion at 0, dwCredFormat at 4, cCreds at 8, paCred at 16, hRootStore
// at 24, cMappers at 32, aphMappers at 40, dwSessionLifespan at 48, dwFlags
// at 52, cTlsParameters at 56, pTlsParameters at 64. (Until Nov 15 this
// wrote SCHANNEL_CRED's offsets, flags at 72 and the parameters at 80/88,
// past the end of the structure: Schannel saw no parameters and no flags,
// so nothing was pinned.) TLS_PARAMETERS: 40 bytes; cAlpnIds at 0,
// rgstrAlpnIds at 8, grbitDisabledProtocols at 16, cDisabledCrypto at 20,
// pDisabledCrypto at 24, dwFlags at 32. TLS 1.3 can only be requested this
// way: the legacy grbitEnabledProtocols field stops at TLS 1.2
// (release-roadmap I7).
//
// grbitDisabledProtocols for "TLS 1.3 only": every bit but SP_PROT_TLS1_3
// (SERVER 0x1000 | CLIENT 0x2000), i.e. 0xFFFFFFFF - 0x3000 = 0xFFFFCFFF.
// (Until Nov 15 both callers passed 4294945535 = 0xFFFFAAFF, which also
// disables SP_PROT_TLS1_3_CLIENT and leaves only server bits on: a 1.3-only
// client could never negotiate anything.)
const TS_ALL_BUT_TLS13: i64 = 4294955007;
fn ts_acquire13(s: i64, usage: i64, flags: i64, cert_slot: i64, disabled: i64) -> bool {
    val params: i64 = ts_zeroed(5);
    ts_set32(params + 16, disabled);
    val cred: i64 = ts_zeroed(9);
    ts_set32(cred, 5);
    if cert_slot != 0 {
        ts_set32(cred + 8, 1);
        ts_set(cred + 16, cert_slot);
    }
    ts_set32(cred + 52, flags);
    ts_set32(cred + 56, 1);
    ts_set(cred + 64, params);
    val expiry: i64 = ts_zeroed(1);
    var rc: i64 = 0;
    // SAFETY: cred is a 72-byte SCH_CREDENTIALS (ts_zeroed(9)) pointing to
    // one 40-byte TLS_PARAMETERS (params, ts_zeroed(5)); the handle and
    // expiry outputs as in ts_acquire.
    unsafe {
        rc = sc_acquire(0, TS_PACKAGE, usage, 0, cred, 0, 0, s + TS_CRED * 8, expiry);
    }
    // SAFETY: the three ts_zeroed blocks above; Schannel keeps no pointer to
    // them once AcquireCredentialsHandle has returned.
    unsafe {
        p_free(cred);
        p_free(params);
        p_free(expiry);
    }
    return rc == TS_OK;
}

// Credentials with the system's own choice of versions. Through
// SCH_CREDENTIALS with nothing disabled first: only that structure lets
// Schannel offer TLS 1.3 (Windows 11 / Server 2022; with the legacy
// SCHANNEL_CRED a Windows 11 client stops at 1.2). Windows releases that
// do not know SCH_CREDENTIALS refuse it, and get SCHANNEL_CRED.
fn ts_acquire_any(s: i64, usage: i64, flags: i64, cert_slot: i64) -> bool {
    if ts_acquire13(s, usage, flags, cert_slot, 0) {
        return true;
    }
    return ts_acquire(s, usage, flags, cert_slot);
}

fn ts_client(fd: i64, host: str, flags: i64) -> i64 {
    return ts_client_alpn(fd, host, flags, "");
}

// A client session offering the ALPN names `protos` ("": no ALPN).
fn ts_client_alpn(fd: i64, host: str, flags: i64, protos: str) -> i64 {
    val s: i64 = ts_session(fd);
    if !ts_acquire_any(s, 2, flags, 0) {
        ts_free_session(s);
        return 0;
    }
    ts_put(s, TS_OWNS_CRED, 1);
    ts_put(s, TS_HOST, ts_text_block(host));
    val alpn: i64 = ts_alpn_block(protos);
    ts_put(s, TS_ALPN, alpn);
    val ok: bool = ts_handshake(s, host, false);
    ts_put(s, TS_ALPN, 0);
    if alpn != 0 {
        // SAFETY: the ts_alpn_block made above; the handshake that borrowed
        // it is over and TS_ALPN was just cleared.
        unsafe {
            p_free(alpn);
        }
    }
    if !ok {
        // SAFETY: the credentials handle ts_acquire_any wrote at s + 24,
        // owned by this session (TS_OWNS_CRED), freed once: the session is
        // freed next.
        unsafe {
            sc_free_cred(s + TS_CRED * 8);
        }
        ts_free_session(s);
        return 0;
    }
    return s;
}

fn ts_client13(fd: i64, host: str, flags: i64) -> i64 {
    val s: i64 = ts_session(fd);
    if !ts_acquire13(s, 2, flags, 0, TS_ALL_BUT_TLS13) {
        ts_free_session(s);
        return 0;
    }
    ts_put(s, TS_OWNS_CRED, 1);
    ts_put(s, TS_HOST, ts_text_block(host));
    if !ts_handshake(s, host, false) {
        // SAFETY: the credentials handle ts_acquire13 wrote at s + 24, owned
        // by this session, freed once: the session is freed next.
        unsafe {
            sc_free_cred(s + TS_CRED * 8);
        }
        ts_free_session(s);
        return 0;
    }
    return s;
}

/// A TLS session over the connected socket `fd`, checking `host`'s certificate.
/// Returns 0 on failure.
pub fn tls_client(fd: i64, host: str) -> i64 {
    // SCH_CRED_NO_DEFAULT_CREDS, AUTO_CRED_VALIDATION, SCH_USE_STRONG_CRYPTO
    return ts_client(fd, host, 4194352);
}

/// Connect to host:port. The session owns the socket. Returns 0 on failure.
pub fn tls_connect(host: str, port: i64) -> i64 {
    val fd: i64 = p_co_connect(host, port);
    if fd < 0 {
        return 0;
    }
    val s: i64 = tls_client(fd, host);
    if s == 0 {
        p_socket_close(fd);
    }
    return s;
}

/// A TLS 1.3-only session over the connected socket `fd`, checking `host`'s
/// certificate. Needs Windows 11 / Server 2022+. Returns 0 on failure.
/// tls_session_protocol on a success returns SP_PROT_TLS1_3_CLIENT (8192).
pub fn tls_client13(fd: i64, host: str) -> i64 {
    return ts_client13(fd, host, 4194352);
}

/// As tls_connect, but pinned to TLS 1.3. The session owns the socket.
/// Returns 0 when the OS or peer lacks TLS 1.3.
pub fn tls_connect13(host: str, port: i64) -> i64 {
    val fd: i64 = p_co_connect(host, port);
    if fd < 0 {
        return 0;
    }
    val s: i64 = tls_client13(fd, host);
    if s == 0 {
        p_socket_close(fd);
    }
    return s;
}

/// As tls_connect, but accept any certificate. For tests of a local server only:
/// it does not know whom it is talking to.
pub fn tls_connect_unchecked(host: str, port: i64) -> i64 {
    val fd: i64 = p_co_connect(host, port);
    if fd < 0 {
        return 0;
    }
    // SCH_CRED_MANUAL_CRED_VALIDATION, NO_DEFAULT_CREDS, USE_STRONG_CRYPTO
    val s: i64 = ts_client(fd, host, 4194328);
    if s == 0 {
        p_socket_close(fd);
    }
    return s;
}

/// As tls_connect13, but accept any certificate: for checking a local
/// TLS 1.3 server (tls_server13) with a self-signed certificate only.
pub fn tls_connect13_unchecked(host: str, port: i64) -> i64 {
    val fd: i64 = p_co_connect(host, port);
    if fd < 0 {
        return 0;
    }
    // SCH_CRED_MANUAL_CRED_VALIDATION, NO_DEFAULT_CREDS, USE_STRONG_CRYPTO
    val s: i64 = ts_client13(fd, host, 4194328);
    if s == 0 {
        p_socket_close(fd);
    }
    return s;
}

/// As tls_client, offering the ALPN protocols `protos` (comma-separated,
/// most wanted first: "h2,http/1.1"). tls_session_alpn tells what the
/// server chose ("" when it chose none). Returns 0 on failure.
pub fn tls_client_alpn(fd: i64, host: str, protos: str) -> i64 {
    // SCH_CRED_NO_DEFAULT_CREDS, AUTO_CRED_VALIDATION, SCH_USE_STRONG_CRYPTO
    return ts_client_alpn(fd, host, 4194352, protos);
}

/// As tls_connect, offering the ALPN protocols `protos`. The session owns
/// the socket. Returns 0 on failure.
pub fn tls_connect_alpn(host: str, port: i64, protos: str) -> i64 {
    val fd: i64 = p_co_connect(host, port);
    if fd < 0 {
        return 0;
    }
    val s: i64 = tls_client_alpn(fd, host, protos);
    if s == 0 {
        p_socket_close(fd);
    }
    return s;
}

/// As tls_connect_alpn, but accept any certificate: for checking a local
/// server with a self-signed certificate only.
pub fn tls_connect_alpn_unchecked(host: str, port: i64, protos: str) -> i64 {
    val fd: i64 = p_co_connect(host, port);
    if fd < 0 {
        return 0;
    }
    // SCH_CRED_MANUAL_CRED_VALIDATION, NO_DEFAULT_CREDS, USE_STRONG_CRYPTO
    val s: i64 = ts_client_alpn(fd, host, 4194328, protos);
    if s == 0 {
        p_socket_close(fd);
    }
    return s;
}

// The certificate of a PKCS#12 file, in a two-word slot: the certificate
// (the first word is the one-element paCred array) and the store it came
// from (ts_free_slot frees both). 0 on failure.
fn ts_server_slot(pfx_path: str, password: str) -> i64 {
    var file: *u8 = 0 as *u8;
    // SAFETY: fopen reads two NUL-terminated strs (the path and "rb");
    // the FILE it returns is closed below, a null one is checked next.
    unsafe {
        file = ts_fopen(pfx_path, "rb");
    }
    if file as i64 == 0 {
        return 0;
    }
    val cap: i64 = 1048576;
    var data: i64 = 0;
    var size: i64 = 0;
    // SAFETY: data is a fresh cap-byte block, freed below once
    // PFXImportCertStore has copied what it needs; fread writes at most
    // 1 * cap bytes into it from the open FILE, which fclose then closes
    // (not used afterwards).
    unsafe {
        data = p_malloc(cap);
        size = ts_fread(data as *u8, 1, cap, file);
        ts_fclose(file);
    }
    // The password as UTF-16
    val n: i64 = str_len(password);
    val wide: i64 = ts_zeroed(n + 1);
    var i: i64 = 0;
    while i < n {
        var p: *mut u16 = (wide + i * 2) as *mut u16;
        // SAFETY: i < n and wide = ts_zeroed(n + 1) holds 8 * (n + 1) bytes:
        // the u16 at byte i * 2 is inside, and the rest stays zero (the NUL).
        unsafe {
            *p = str_byte_at(password, i) as u16;
        }
        i = i + 1;
    }
    val blob: i64 = ts_zeroed(2);
    ts_set32(blob, size);
    ts_set(blob + 8, data);
    // The key goes to the user's key store: Schannel cannot use one held only
    // in memory (PKCS12_NO_PERSIST_KEY gives SEC_E_NO_CREDENTIALS). It goes
    // to a CNG provider (TS_PFX_CNG), and tls_server_close deletes it.
    var store: *u8 = 0 as *u8;
    // SAFETY: blob is a CRYPT_DATA_BLOB (cbData = the size bytes fread
    // wrote, pbData = data) and wide the NUL-terminated UTF-16 password
    // (n + 1 zeroed words hold n u16 and the NUL); PFXImportCertStore only
    // reads them and copies what it keeps into the store it returns.
    unsafe {
        store = sc_pfx_import(blob as *u8, wide as *u8, TS_PFX_CNG);
    }
    // SAFETY: the three blocks allocated above (ts_zeroed, ts_zeroed,
    // p_malloc), not used after the import.
    unsafe {
        p_free(blob);
        p_free(wide);
        p_free(data);
    }
    if store as i64 == 0 {
        return 0;
    }
    // X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, CERT_FIND_ANY
    var cert: i64 = 0;
    // SAFETY: store is the non-null store PFXImportCertStore returned; no
    // search parameter and no previous certificate (both null), as
    // CERT_FIND_ANY allows.
    unsafe {
        cert = sc_find_cert(store, 65537, 0, 0, 0 as *u8, 0 as *u8) as i64;
    }
    if cert == 0 {
        // SAFETY: the store opened by the import above, closed once and
        // not used again (nothing was taken from it).
        unsafe {
            sc_close_store(store, 0);
        }
        return 0;
    }
    val slot: i64 = ts_zeroed(2);
    ts_set(slot, cert);
    ts_set(slot + 8, store as i64);
    return slot;
}

// Delete the private key PFXImportCertStore persisted for the certificate
// `cert`: its CRYPT_KEY_PROV_INFO (x64: pwszContainerName at 0,
// pwszProvName at 8, dwProvType at 16, dwFlags at 20) names a CNG key
// (dwProvType 0, as TS_PFX_CNG imports) that NCryptDeleteKey removes.
// False when there was none to delete or it could not be.
fn ts_delete_key(cert: i64) -> bool {
    val size: i64 = ts_zeroed(1);
    var have_info: i64 = 0;
    // SAFETY: cert is the certificate context of a ts_server_slot, not yet
    // freed (ts_free_slot frees it after this); with a null data pointer
    // CertGetCertificateContextProperty only writes the needed size into
    // the DWORD at size (a one-word block).
    unsafe {
        have_info = sc_cert_prop(cert as *u8, TS_KEY_PROV_INFO, 0 as *u8, size as *u8);
    }
    if have_info == 0 {
        // SAFETY: the ts_zeroed block above, not used again.
        unsafe {
            p_free(size);
        }
        return false;
    }
    val n: i64 = ts_get32(size);
    val info: i64 = ts_zeroed(n / 8 + 2);
    var deleted: bool = false;
    var got_info: bool = false;
    if n >= 24 {
        // SAFETY: info holds 8 * (n / 8 + 2) >= n bytes, the size the first
        // call asked for and the one passed in the DWORD at size; the
        // property is copied into it.
        unsafe {
            got_info = sc_cert_prop(cert as *u8, TS_KEY_PROV_INFO, info as *u8, size as *u8) != 0;
        }
    }
    if got_info && ts_get32(info + 16) == 0 {
        val prov: i64 = ts_zeroed(1);
        val key: i64 = ts_zeroed(1);
        var opened: i64 = 0;
        // SAFETY: prov is a one-word out-slot for the provider handle; the
        // name is the NUL-terminated UTF-16 pwszProvName inside info (alive
        // until info is freed below).
        unsafe {
            opened = nc_open_provider(prov as *u8, ts_get(info + 8) as *u8, 0);
        }
        if opened == 0 {
            val flags: i64 = ts_get32(info + 20) & TS_MACHINE_KEY;
            var key_rc: i64 = 0;
            // SAFETY: the provider handle just opened; key is a one-word
            // out-slot; the container name is the NUL-terminated UTF-16
            // pwszContainerName inside info.
            unsafe {
                key_rc = nc_open_key(ts_get(prov), key as *u8, ts_get(info) as *u8, 0, flags);
            }
            if key_rc == 0 {
                // NCryptDeleteKey frees the key handle when it succeeds
                // SAFETY: the key handle NCryptOpenKey just returned: freed
                // by NCryptDeleteKey on success, else by NCryptFreeObject,
                // never both, and not used afterwards.
                unsafe {
                    if nc_delete_key(ts_get(key), 0) == 0 {
                        deleted = true;
                    } else {
                        nc_free_object(ts_get(key));
                    }
                }
            }
            // SAFETY: the provider handle opened above, freed once.
            unsafe {
                nc_free_object(ts_get(prov));
            }
        }
        // SAFETY: the two ts_zeroed out-slots above, not used again.
        unsafe {
            p_free(prov);
            p_free(key);
        }
    }
    // SAFETY: the two ts_zeroed blocks of this function; the names inside
    // info were last read by the NCrypt calls above.
    unsafe {
        p_free(info);
        p_free(size);
    }
    return deleted;
}

// Free a ts_server_slot: the imported key, the certificate and its store.
fn ts_free_slot(slot: i64) {
    if slot == 0 {
        return;
    }
    val cert: i64 = ts_get(slot);
    if cert != 0 {
        ts_delete_key(cert);
        // SAFETY: the certificate context CertFindCertificateInStore gave
        // ts_server_slot, freed once here; the credentials that referenced
        // it were freed first (tls_server_close) or never made (tls_server
        // failing).
        unsafe {
            sc_free_cert(cert as *u8);
        }
    }
    val store: i64 = ts_get(slot + 8);
    if store != 0 {
        // SAFETY: the store PFXImportCertStore opened for this slot, closed
        // once, after its certificate was freed above.
        unsafe {
            sc_close_store(store as *u8, 0);
        }
    }
    // SAFETY: the slot's ts_zeroed block; its owner (the server block or
    // the failing tls_server) drops it with this call.
    unsafe {
        p_free(slot);
    }
}

/// Server credentials from a PKCS#12 file. Returns 0 on failure.
pub fn tls_server(pfx_path: str, password: str) -> i64 {
    val slot: i64 = ts_server_slot(pfx_path, password);
    if slot == 0 {
        return 0;
    }
    val creds: i64 = ts_zeroed(TS_SERVER_WORDS);
    if !ts_acquire_any(creds - TS_CRED * 8, 1, 0, slot) {
        ts_free_slot(slot);
        // SAFETY: the ts_zeroed block above; no credentials were acquired
        // into it and it is not returned.
        unsafe {
            p_free(creds);
        }
        return 0;
    }
    ts_set(creds + 24, slot);
    return creds;
}

/// As tls_server, but every session it accepts is TLS 1.3 (a client
/// without 1.3 fails the handshake). Needs Windows 11 / Server 2022 or
/// later. Returns 0 on failure.
pub fn tls_server13(pfx_path: str, password: str) -> i64 {
    val slot: i64 = ts_server_slot(pfx_path, password);
    if slot == 0 {
        return 0;
    }
    val creds: i64 = ts_zeroed(TS_SERVER_WORDS);
    if !ts_acquire13(creds - TS_CRED * 8, 1, 0, slot, TS_ALL_BUT_TLS13) {
        ts_free_slot(slot);
        // SAFETY: the ts_zeroed block above; no credentials were acquired
        // into it and it is not returned.
        unsafe {
            p_free(creds);
        }
        return 0;
    }
    ts_set(creds + 24, slot);
    return creds;
}

/// Free the server `server` (tls_server, tls_server13) once no session is
/// being accepted with it: its credentials, its ALPN list, and the private
/// key tls_server put in the user's key store (Schannel needs the key
/// there: importing the .pfx made a copy of it, which this deletes; the
/// .pfx stays). Sessions already accepted keep working until closed.
/// Returns 0.
pub fn tls_server_close(server: i64) -> i64 {
    if server == 0 {
        return 0;
    }
    // SAFETY: server is a tls_server/tls_server13 block, whose word 0-1 is
    // the credentials handle acquired there; freed once (the caller closes
    // a server once, when no handshake is using it).
    unsafe {
        sc_free_cred(server);
    }
    val alpn: i64 = ts_get(server + 16);
    if alpn != 0 {
        // SAFETY: the ts_alpn_block tls_server_alpn stored; only handshakes
        // borrow it, and none is running (the contract above).
        unsafe {
            p_free(alpn);
        }
    }
    ts_free_slot(ts_get(server + 24));
    // SAFETY: the ts_zeroed block of tls_server, dropped by this call.
    unsafe {
        p_free(server);
    }
    return 0;
}

/// The TLS library under `use tls`: "schannel" here, "openssl" on Linux
/// and macOS.
pub fn tls_library() -> str {
    return "schannel";
}

/// The server's side of a TLS session over the accepted socket `fd`. Returns 0 on
/// failure.
pub fn tls_accept(server: i64, fd: i64) -> i64 {
    val s: i64 = ts_session(fd);
    ts_put(s, TS_SIDE, 1);
    ts_put(s, TS_CRED, ts_get(server));
    ts_put(s, TS_CRED + 1, ts_get(server + 8));
    // The server's ALPN block (tls_server_alpn), borrowed for the handshake
    ts_put(s, TS_ALPN, ts_get(server + 16));
    val ok: bool = ts_handshake(s, "", true);
    ts_put(s, TS_ALPN, 0);
    if !ok {
        ts_free_session(s);
        return 0;
    }
    return s;
}

/// Make the server `server` (tls_server, tls_server13) answer ALPN: of the
/// protocols a client offers, it picks its first in `protos`
/// (comma-separated, "h2,http/1.1"); a client offering none of them, or no
/// ALPN, gets none. Call it once, before accepting. False when `protos`
/// holds no name.
pub fn tls_server_alpn(server: i64, protos: str) -> bool {
    if server == 0 {
        return false;
    }
    val block: i64 = ts_alpn_block(protos);
    if block == 0 {
        return false;
    }
    // The block lives as long as the server (sessions borrow it while they
    // shake hands)
    ts_set(server + 16, block);
    return true;
}

/// The protocol ALPN chose for the session ("h2", "http/1.1"), "" when
/// none was negotiated.
pub fn tls_session_alpn(s: i64) -> str {
    if s == 0 {
        return "";
    }
    // read when the handshake ended (ts_handshake): a TLS 1.3 client's
    // query answers "none" once it has taken a NewSessionTicket
    return ts_block_text(ts_field(s, TS_CHOSEN));
}

// The protocol ALPN chose, as Schannel answers now ("" when none).
fn ts_query_alpn(s: i64) -> str {
    if s == 0 || ts_field(s, TS_CTX) == 0 {
        return "";
    }
    // SecPkgContext_ApplicationProtocol: ProtoNegoStatus (u32) at 0,
    // ProtoNegoExt (u32) at 4, ProtocolIdSize (u8) at 8, ProtocolId at 9
    // (up to 255 bytes): 264 bytes
    val info: i64 = ts_zeroed(33);
    var rc: i64 = 0;
    // SAFETY: the session's context handle (non-zero, checked above);
    // SECPKG_ATTR_APPLICATION_PROTOCOL writes a 264-byte
    // SecPkgContext_ApplicationProtocol into info, 33 words = 264 bytes.
    unsafe {
        rc = sc_query(s + TS_CTX * 8, TS_ATTR_ALPN, info);
    }
    var out: str = "";
    if rc == TS_OK && ts_get32(info) == TS_ALPN_OK {
        val n: i64 = p_volatile_load8(info + 8);
        var b: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < n {
            b.push(p_volatile_load8(info + 9 + i));
            i = i + 1;
        }
        out = str_from_bytes(b);
    }
    // SAFETY: the ts_zeroed block above; its bytes were copied into out.
    unsafe {
        p_free(info);
    }
    return out;
}

/// The session's socket.
pub fn tls_session_fd(s: i64) -> i64 {
    return ts_field(s, TS_FD);
}

/// The negotiated protocol: SP_PROT_TLS1_3_CLIENT (8192) for TLS 1.3,
/// SP_PROT_TLS1_2_CLIENT (2048) for 1.2, -1 when not connected.
pub fn tls_session_protocol(s: i64) -> i64 {
    if ts_field(s, TS_CTX) == 0 {
        return -1;
    }
    val info: i64 = ts_zeroed(4);
    var rc: i64 = 0;
    // SAFETY: the session's context handle (non-zero, checked above);
    // SECPKG_ATTR_CONNECTION_INFO (90) writes a SecPkgContext_ConnectionInfo
    // (7 u32, 28 bytes) into info, 32 bytes.
    unsafe {
        rc = sc_query(s + TS_CTX * 8, 90, info);
    }
    if rc != 0 {
        // SAFETY: the ts_zeroed block above, not used again.
        unsafe {
            p_free(info);
        }
        return -1;
    }
    val proto: i64 = ts_get32(info);
    // SAFETY: the ts_zeroed block above, read for the last time.
    unsafe {
        p_free(info);
    }
    return proto;
}

/// The negotiated TLS version as its wire number, the same on every
/// platform: 772 (0x0304) for TLS 1.3, 771 for 1.2, 770 for 1.1, 769 for
/// 1.0; -1 when not connected or unknown.
pub fn tls_session_version(s: i64) -> i64 {
    val p: i64 = tls_session_protocol(s);
    // SP_PROT_*: a server bit and a client bit per version
    if p == 4096 || p == 8192 {
        return 772;
    }
    if p == 1024 || p == 2048 {
        return 771;
    }
    if p == 256 || p == 512 {
        return 770;
    }
    if p == 64 || p == 128 {
        return 769;
    }
    return -1;
}

/// Send `n` bytes at `addr`. Returns `n`, or -1.
pub fn tls_session_send(s: i64, addr: i64, n: i64) -> i64 {
    val header: i64 = ts_field(s, TS_HEADER);
    val trailer: i64 = ts_field(s, TS_TRAILER);
    val most: i64 = ts_field(s, TS_MAX);
    val buffers: i64 = ts_zeroed(8);
    val desc: i64 = ts_desc(buffers, 4);
    var msg: i64 = 0;
    // SAFETY: a fresh block for one TLS record: header, at most `most`
    // (TS_MAX) data bytes and the trailer, the sizes ts_stream_sizes read;
    // freed below.
    unsafe {
        msg = p_malloc(header + most + trailer);
    }
    var sent: i64 = 0;
    while sent < n {
        var part: i64 = n - sent;
        if part > most {
            part = most;
        }
        ts_copy(msg + header, addr + sent, part);
        ts_buffer(buffers, 0, TB_HEADER, msg, header);
        ts_buffer(buffers, 1, TB_DATA, msg + header, part);
        ts_buffer(buffers, 2, TB_TRAILER, msg + header + part, trailer);
        ts_buffer(buffers, 3, TB_EMPTY, 0, 0);
        var enc_rc: i64 = 0;
        // SAFETY: the session's context handle; desc describes the 4
        // SecBuffers in buffers (8 words), which cover msg exactly: the
        // header, the `part` <= TS_MAX data bytes and the trailer, so
        // EncryptMessage encrypts in place inside msg.
        unsafe {
            enc_rc = sc_encrypt(s + TS_CTX * 8, 0, desc, 0);
        }
        if enc_rc != TS_OK {
            sent = -1;
            break;
        }
        val total: i64 = ts_buffer_size(buffers, 0) + ts_buffer_size(buffers, 1) + ts_buffer_size(buffers, 2);
        if p_co_send(ts_field(s, TS_FD), msg, total) != total {
            sent = -1;
            break;
        }
        sent = sent + part;
    }
    // SAFETY: the record block and the two ts_zeroed/ts_desc blocks of this
    // function; the loop is over and nothing else points to them.
    unsafe {
        p_free(msg);
        p_free(desc);
        p_free(buffers);
    }
    return sent;
}

/// Read up to `n` bytes into `addr`. Returns how many; 0 when the other side has
/// closed; below 0 on an error or a timeout.
pub fn tls_session_recv(s: i64, addr: i64, n: i64, timeout_ms: i64) -> i64 {
    val buf: i64 = ts_field(s, TS_BUF);
    val plain: i64 = ts_field(s, TS_PLAIN);
    while ts_field(s, TS_PLAIN_LEN) == 0 {
        var result: i64 = 1;
        var have: i64 = ts_field(s, TS_HAVE);
        if have > 0 && ts_field(s, TS_POST) != 0 {
            result = ts_post_handshake(s, buf, have);
        } else if have > 0 {
            result = ts_decrypt(s, buf, plain, have);
        }
        if result <= 0 {
            return result;
        }
        // 2: bytes were used and others may wait in the buffer: go on with
        // them before reading more
        if ts_field(s, TS_PLAIN_LEN) == 0 && result != 2 {
            have = ts_field(s, TS_HAVE);
            if have >= ts_field(s, TS_CAP) {
                return -1;
            }
            val got: i64 = p_co_recv(ts_field(s, TS_FD), buf + have, ts_field(s, TS_CAP) - have, timeout_ms);
            if got <= 0 {
                return got;
            }
            ts_put(s, TS_HAVE, have + got);
        }
    }
    var part: i64 = ts_field(s, TS_PLAIN_LEN);
    if part > n {
        part = n;
    }
    ts_copy(addr, plain + ts_field(s, TS_PLAIN_AT), part);
    ts_put(s, TS_PLAIN_AT, ts_field(s, TS_PLAIN_AT) + part);
    ts_put(s, TS_PLAIN_LEN, ts_field(s, TS_PLAIN_LEN) - part);
    return part;
}

/// Decrypt what is in the buffer. 1 to go on (more input may be needed), 2
/// to go on with bytes still in the buffer, 0 when the other side closed,
/// -1 on an error.
fn ts_decrypt(s: i64, buf: i64, plain: i64, have: i64) -> i64 {
    val buffers: i64 = ts_zeroed(8);
    val desc: i64 = ts_desc(buffers, 4);
    ts_buffer(buffers, 0, TB_DATA, buf, have);
    ts_buffer(buffers, 1, TB_EMPTY, 0, 0);
    ts_buffer(buffers, 2, TB_EMPTY, 0, 0);
    ts_buffer(buffers, 3, TB_EMPTY, 0, 0);
    var rc: i64 = 0;
    // SAFETY: the session's context handle; desc describes the 4 SecBuffers
    // in buffers (8 words), the data one over the `have` received bytes of
    // the session's input buffer: DecryptMessage decrypts in place there
    // and points the output buffers into that same range.
    unsafe {
        rc = sc_decrypt(s + TS_CTX * 8, desc, 0, 0);
    }
    var result: i64 = -1;
    if rc == TS_INCOMPLETE {
        result = 1;
    } else if rc == TS_CLOSED {
        result = 0;
    } else if rc == TS_OK {
        var data_at: i64 = 0;
        var data_size: i64 = 0;
        var extra: i64 = 0;
        var i: i64 = 0;
        while i < 4 {
            val kind: i64 = ts_buffer_kind(buffers, i);
            if kind == TB_DATA {
                data_at = ts_buffer_addr(buffers, i);
                data_size = ts_buffer_size(buffers, i);
            }
            if kind == TB_EXTRA {
                extra = ts_buffer_size(buffers, i);
            }
            i = i + 1;
        }
        if data_size > 0 {
            ts_copy(plain, data_at, data_size);
        }
        ts_put(s, TS_PLAIN_AT, 0);
        ts_put(s, TS_PLAIN_LEN, data_size);
        if extra > 0 {
            ts_copy(buf, buf + have - extra, extra);
        }
        ts_put(s, TS_HAVE, extra);
        result = 1;
        if extra > 0 {
            result = 2;
        }
    } else if rc == TS_RENEGOTIATE {
        // A handshake message after the handshake. Its bytes come back in
        // SECBUFFER_EXTRA; they go to InitializeSecurityContext (client) or
        // AcceptSecurityContext (server) as their input token
        var extra: i64 = 0;
        var i: i64 = 0;
        while i < 4 {
            if ts_buffer_kind(buffers, i) == TB_EXTRA {
                extra = ts_buffer_size(buffers, i);
            }
            i = i + 1;
        }
        if extra > 0 {
            ts_copy(buf, buf + have - extra, extra);
        }
        ts_put(s, TS_HAVE, extra);
        ts_put(s, TS_PLAIN_AT, 0);
        ts_put(s, TS_PLAIN_LEN, 0);
        ts_put(s, TS_POST, 1);
        result = ts_post_handshake(s, buf, extra);
    }
    // SAFETY: the ts_zeroed/ts_desc blocks of this function; the bytes the
    // buffers pointed to were copied out above.
    unsafe {
        p_free(desc);
        p_free(buffers);
    }
    return result;
}

/// The `have` bytes at `buf` (the session's input buffer) start with a
/// handshake message that came after the handshake (DecryptMessage said
/// SEC_I_RENEGOTIATE): give them to InitializeSecurityContext on a client,
/// AcceptSecurityContext on a server, and send what it answers. TLS 1.3
/// sends NewSessionTicket this way (Schannel servers right after the
/// handshake) and KeyUpdate; TLS 1.2 a renegotiation, which takes several
/// rounds (SEC_I_CONTINUE_NEEDED). While TS_POST stays set, received bytes
/// come here instead of to DecryptMessage. What the call did not use stays
/// in the buffer (TS_HAVE). 1 to go on (more input needed), 2 to go on
/// with bytes still in the buffer, -1 on an error.
fn ts_post_handshake(s: i64, buf: i64, have: i64) -> i64 {
    val cred: i64 = s + TS_CRED * 8;
    val ctx: i64 = s + TS_CTX * 8;
    val attrs: i64 = ts_zeroed(1);
    val expiry: i64 = ts_zeroed(1);
    val input: i64 = ts_zeroed(4);
    val output: i64 = ts_zeroed(2);
    val in_desc: i64 = ts_desc(input, 2);
    val out_desc: i64 = ts_desc(output, 1);
    ts_buffer(input, 0, TB_TOKEN, buf, have);
    ts_buffer(input, 1, TB_EMPTY, 0, 0);
    ts_buffer(output, 0, TB_TOKEN, 0, 0);
    var rc: i64 = 0;
    if ts_field(s, TS_SIDE) != 0 {
        // SAFETY: the session's credentials handle (borrowed from its
        // server, which must not be closed while sessions run) and its
        // established context; in_desc describes 2 SecBuffers in input
        // (4 words), the token one over the `have` bytes at buf; out_desc
        // 1 buffer Schannel allocates (freed below); attrs and expiry are
        // one-word blocks.
        unsafe {
            rc = sc_accept(cred, ctx, in_desc, 65820, 0, ctx, out_desc, attrs, expiry);
        }
    } else {
        // SAFETY: as sc_accept above, with the client's own credentials and
        // the host name kept in TS_HOST, as a NUL-terminated str.
        unsafe {
            rc = sc_init(cred, ctx, ts_block_text(ts_field(s, TS_HOST)), 33052, 0, 0, in_desc, 0, ctx, out_desc, attrs, expiry);
        }
    }
    var result: i64 = 1;
    val out_size: i64 = ts_buffer_size(output, 0);
    val out_addr: i64 = ts_buffer_addr(output, 0);
    if out_addr != 0 {
        if out_size > 0 && p_co_send(ts_field(s, TS_FD), out_addr, out_size) != out_size {
            result = -1;
        }
        // SAFETY: the output token Schannel allocated in the call above,
        // sent and not used again.
        unsafe {
            sc_free_buffer(out_addr);
        }
    }
    if rc == TS_OK || rc == TS_CONTINUE {
        var extra: i64 = 0;
        if ts_buffer_kind(input, 1) == TB_EXTRA {
            extra = ts_buffer_size(input, 1);
        }
        if extra > 0 {
            ts_copy(buf, buf + have - extra, extra);
        }
        ts_put(s, TS_HAVE, extra);
        if rc == TS_OK {
            // done: what follows is records for DecryptMessage again
            ts_put(s, TS_POST, 0);
            ts_stream_sizes(s);
        }
        if extra > 0 && result > 0 {
            result = 2;
        }
    } else if rc != TS_INCOMPLETE {
        result = -1;
    }
    // SAFETY: the six ts_zeroed/ts_desc blocks of this function; Schannel
    // keeps no pointer to them once the call has returned.
    unsafe {
        p_free(attrs);
        p_free(expiry);
        p_free(input);
        p_free(output);
        p_free(in_desc);
        p_free(out_desc);
    }
    return result;
}

/// End the session and free it. The socket stays open: closing it is the
/// caller's.
pub fn tls_session_close(s: i64) -> i64 {
    // SAFETY: s is a session tls_connect/tls_accept returned (only
    // successful handshakes return one), so its context handle at s + 8 is
    // valid; it is deleted once, and the credentials only when the session
    // acquired them itself (TS_OWNS_CRED; a server's are its server's).
    unsafe {
        sc_delete(s + TS_CTX * 8);
        if ts_field(s, TS_OWNS_CRED) != 0 {
            sc_free_cred(s + TS_CRED * 8);
        }
    }
    ts_free_session(s);
    return 0;
}
