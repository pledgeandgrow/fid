// Fides crypto through the operating system — BCrypt (CNG) on Windows.
// release-roadmap J5 / decision 2: bind the reviewed system libraries for
// AEAD (AES-GCM), signatures (ECDSA P-256) and a KDF (PBKDF2-HMAC-SHA256)
// rather than shipping our own.
//
//   use crypto_bind;
//   val ct = cb_gcm_encrypt(&key, &nonce, &aad, &pt);   // ct || 16-byte tag
//   val ok = cb_ecdsa_verify(&pub_blob, &hash, &sig);
//
// RSA too: PKCS#1 v1.5 and PSS signatures, OAEP encryption and key
// generation (cb_rsa_*), keys as BCrypt's RSA blobs (crypto_bind_rsa.fd
// builds them from n, e, d, p, q ...).
//
// Key material passing through these calls is handled by BCrypt itself.
// On Linux and macOS `use crypto_bind` takes crypto_bind_unix.fd, the
// libcrypto twin with the same functions and blob formats.
//
// The extern block includes <bcrypt.h>, so the generated calls use the real
// prototypes: every handle/buffer parameter is *mut u8 and every scalar is
// i64 (ULONG/ULONGLONG widen cleanly).

module crypto_bind;
 use vec; use string; use crypto_bind_rsa;
 // SAFETY: the prototypes come from <bcrypt.h> itself (the include), so the C
 // compiler checks each call against the real signature; every pointer passed
 // is 0, a BCrypt handle, or a block this module allocated with at least the
 // length passed beside it.
 extern "C" include "<bcrypt.h>" link "bcrypt" {
    fn BCryptOpenAlgorithmProvider as cb_open_alg(alg: * mut u8, id: * mut u8, impl: * mut u8, flags: i64) -> i32;
    fn BCryptCloseAlgorithmProvider as cb_close_alg(alg: * mut u8, flags: i64) -> i32;
    fn BCryptGetProperty as cb_get_prop(obj: * mut u8, name: * mut u8, out: * mut u8, out_len: i64, res: * mut u8, flags: i64) -> i32;
    fn BCryptSetProperty as cb_set_prop(obj: * mut u8, name: * mut u8, val: * mut u8, val_len: i64, flags: i64) -> i32;
    fn BCryptGenerateSymmetricKey as cb_gen_sym(alg: * mut u8, key: * mut u8, key_obj: * mut u8, obj_len: i64, secret: * mut u8, secret_len: i64, flags: i64) -> i32;
    fn BCryptGenerateKeyPair as cb_gen_pair(alg: * mut u8, key: * mut u8, bits: i64, flags: i64) -> i32;
    fn BCryptFinalizeKeyPair as cb_final_pair(key: * mut u8, flags: i64) -> i32;
    fn BCryptExportKey as cb_export(key: * mut u8, exp_key: * mut u8, blob_type: * mut u8, out: * mut u8, out_len: i64, res: * mut u8, flags: i64) -> i32;
    fn BCryptImportKeyPair as cb_import(alg: * mut u8, imp_key: * mut u8, blob_type: * mut u8, key: * mut u8, input: * mut u8, input_len: i64, flags: i64) -> i32;
    fn BCryptEncrypt as cb_encrypt(key: * mut u8, input: * mut u8, in_len: i64, pad: * mut u8, iv: * mut u8, iv_len: i64, out: * mut u8, out_len: i64, res: * mut u8, flags: i64) -> i32;
    fn BCryptDecrypt as cb_decrypt(key: * mut u8, input: * mut u8, in_len: i64, pad: * mut u8, iv: * mut u8, iv_len: i64, out: * mut u8, out_len: i64, res: * mut u8, flags: i64) -> i32;
    fn BCryptDeriveKeyPBKDF2 as cb_pbkdf2(alg: * mut u8, pw: * mut u8, pw_len: i64, salt: * mut u8, salt_len: i64, iters: i64, out: * mut u8, out_len: i64, flags: i64) -> i32;
    fn BCryptSignHash as cb_sign(key: * mut u8, pad: * mut u8, hash: * mut u8, hash_len: i64, sig: * mut u8, sig_len: i64, res: * mut u8, flags: i64) -> i32;
    fn BCryptVerifySignature as cb_verify_sig(key: * mut u8, pad: * mut u8, hash: * mut u8, hash_len: i64, sig: * mut u8, sig_len: i64, flags: i64) -> i32;
    fn BCryptDestroyKey as cb_destroy_key(key: * mut u8) -> i32;
    fn BCryptDestroySecret as cb_destroy_secret(secret: * mut u8) -> i32;
}

const CB_HMAC_FLAG: i64 = 8;  // BCRYPT_ALG_HANDLE_HMAC_FLAG
const CB_AUTH_MODE_SIZE: i64 = 88;  // sizeof(BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO)
const CB_AUTH_V1: i64 = 1;  // BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO_VERSION

// ─── raw struct + wide-string helpers ─────────────────────────────────────

fn cb_set(p: i64, v: i64) {
    // SAFETY: private helper; every caller passes an address inside a block
    // it allocated (cb_zeroed handle slots of 8 bytes, the
    // CB_AUTH_MODE_SIZE-byte cipher-mode struct at the field offsets of
    // BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO).
    unsafe {
        var q: * mut i64 = p;
        * q = v;
    }
}

fn cb_set32(p: i64, v: i64) {
    // SAFETY: private helper; as cb_set, a 4-byte field inside a block the
    // caller allocated.
    unsafe {
        var q: * mut i32 = p;
        * q = v as i32;
    }
}

fn cb_get(p: i64) -> i64 {
    var v: i64 = 0;
    // SAFETY: private helper; every caller reads an 8-byte handle slot it
    // allocated with cb_zeroed(8).
    unsafe {
        var q: * mut i64 = p;
        v = * q;
    }
    return v;
}

fn cb_get32(p: i64) -> i64 {
    var v: i64 = 0;
    // SAFETY: private helper; every caller reads a 4-byte length slot it
    // allocated with cb_zeroed(8).
    unsafe {
        var q: * mut i32 = p;
        v = (* q) as i64;
    }
    return v;
}

fn cb_zeroed(n: i64) -> i64 {
    var p: i64 = p_malloc(n);
    var z: i64 = 0;
    while z < n {
        // SAFETY: z < n: inside the n-byte block p_malloc just returned.
        unsafe {
            var b: * mut u8 = p + z;
            * b = 0;
        }
        z = z + 1;
    }
    return p;
}

// UTF-8 bytes -> UTF-16LE + NUL. Algorithm names are ASCII, so one byte
// becomes one u16 — enough for provider/property/blob names.
fn cb_wide(s: str) -> i64 {
    val n: i64 = str_len(s);
    var w: i64 = cb_zeroed(n * 2 + 2);
    var i: i64 = 0;
    while i < n {
        // SAFETY: i < n and w holds n * 2 + 2 bytes: the u16 at byte i * 2 is
        // inside.
        unsafe {
            var p: * mut u16 = w + i * 2;
            * p = str_byte_at(s, i) as u16;
        }
        i = i + 1;
    }
    return w;
}

// A Vec<i64> in this ABI is a header, not a byte buffer — the binding works
// on raw buffers. cb_buf copies a byte Vec into malloc'd memory and cb_unbuf
// reads it back.
fn cb_buf(v: & Vec) -> i64 {
    val n: i64 = v.len();
    var p: i64 = p_malloc(if n == 0 {
        1
    } else {
        n
    });
    var i: i64 = 0;
    while i < n {
        // SAFETY: i < n and p holds max(n, 1) bytes.
        unsafe {
            var b: * mut u8 = p + i;
            * b = (v.get(i) & 255) as u8;
        }
        i = i + 1;
    }
    return p;
}

fn cb_unbuf(p: i64, n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var b: i64 = 0;
        // SAFETY: private helper; callers pass a block of at least n bytes:
        // cb_zeroed(n) buffers, the 16-byte tag, and BCrypt's reported
        // length, which is at most the buffer length passed to it.
        unsafe {
            var q: * mut u8 = p + i;
            b = (* q) as i64;
        }
        out.push(b & 255);
        i = i + 1;
    }
    return out;
}

// ─── AES-GCM ──────────────────────────────────────────────────────────────
// One provider+key per operation (keys here are one-shot session keys;
// caching handles is a later optimisation).

fn cb_aes_alg() -> i64 {
    var h: i64 = cb_zeroed(8);
    var w: i64 = cb_wide("AES");
    if cb_open_alg(h as * mut u8, w as * mut u8, 0 as * mut u8, 0) != 0 {
        p_free(w);
        p_free(h);
        return 0;
    }
    p_free(w);
    var cm: i64 = cb_wide("ChainingMode");
    var gcm: i64 = cb_wide("ChainingModeGCM");
    var r: i64 = cb_set_prop(cb_get(h) as * mut u8, cm as * mut u8, gcm as * mut u8, 32, 0);
    p_free(cm);
    p_free(gcm);
    if r != 0 {
        cb_close_alg(cb_get(h) as * mut u8, 0);
        p_free(h);
        return 0;
    }
    var alg: i64 = cb_get(h);
    p_free(h);
    return alg;
}

fn cb_key_obj_len(alg: i64) -> i64 {
    var w: i64 = cb_wide("ObjectLength");
    var out: i64 = cb_zeroed(8);
    var res: i64 = cb_zeroed(8);
    var r: i64 = cb_get_prop(alg as * mut u8, w as * mut u8, out as * mut u8, 4, res as * mut u8, 0);
    p_free(w);
    var n: i64 = cb_get32(out);
    p_free(out);
    p_free(res);
    if r != 0 {
        return 0;
    }
    return n;
}

fn cb_sym_key(alg: i64, secret: & Vec) -> i64 {
    var obj_len: i64 = cb_key_obj_len(alg);
    if obj_len == 0 {
        return 0;
    }
    var key_obj: i64 = cb_zeroed(obj_len);
    var sec: i64 = cb_buf(secret);
    var h: i64 = cb_zeroed(8);
    var r: i64 = cb_gen_sym(alg as * mut u8, h as * mut u8, key_obj as * mut u8, obj_len, sec as * mut u8, secret.len(), 0);
    p_free(sec);
    if r != 0 {
        p_free(h);
        p_free(key_obj);
        return 0;
    }
    var key: i64 = cb_get(h);
    p_free(h);
    return key;
    // key_obj intentionally kept: CNG reads it while the key lives
}

// BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO in a buffer.
fn cb_auth_info(nonce: i64, nonce_len: i64, aad: i64, aad_len: i64, tag: i64, tag_len: i64, data_len: i64) -> i64 {
    var m: i64 = cb_zeroed(CB_AUTH_MODE_SIZE);
    cb_set32(m, CB_AUTH_MODE_SIZE);
    // cbSize
    cb_set32(m + 4, CB_AUTH_V1);
    // dwInfoVersion
    cb_set(m + 8, nonce);
    // pbNonce
    cb_set32(m + 16, nonce_len);
    // cbNonce
    cb_set(m + 24, aad);
    // pbAuthData
    cb_set32(m + 32, aad_len);
    // cbAuthData
    cb_set(m + 40, tag);
    // pbTag
    cb_set32(m + 48, tag_len);
    // cbTag
    cb_set(m + 56, 0);
    // pbMacContext
    cb_set32(m + 64, 0);
    // cbMacContext
    cb_set32(m + 68, 0);
    // cbAAD
    cb_set(m + 72, data_len);
    // cbData
    cb_set32(m + 80, 0);
    // dwFlags
    return m;
}

/// AES-GCM encrypt: returns ciphertext || 16-byte tag, empty Vec on failure.
/// key is 16 or 32 bytes; nonce 12 bytes recommended; aad may be empty.
/// The key is `@secret` (complaint CO1): this body may not print, log,
/// send or store it; the result is an audited release (`@declassify`).
@declassify pub fn cb_gcm_encrypt(@secret key: & Vec, nonce: & Vec, aad: & Vec, pt: & Vec) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var alg: i64 = cb_aes_alg();
    if alg == 0 {
        return out;
    }
    var hkey: i64 = cb_sym_key(alg, key);
    if hkey == 0 {
        cb_close_alg(alg as * mut u8, 0);
        return out;
    }
    var nb: i64 = cb_buf(nonce);
    var ab: i64 = cb_buf(aad);
    var pb: i64 = cb_buf(pt);
    var n: i64 = pt.len();
    var ct: i64 = cb_zeroed(if n == 0 {
        1
    } else {
        n
    });
    var tag: i64 = cb_zeroed(16);
    var info: i64 = cb_auth_info(nb, nonce.len(), ab, aad.len(), tag, 16, n);
    var res: i64 = cb_zeroed(8);
    var r: i64 = cb_encrypt(hkey as * mut u8, pb as * mut u8, n, info as * mut u8, 0 as * mut u8, 0, ct as * mut u8, n, res as * mut u8, 0);
    if r == 0 {
        out = cb_unbuf(ct, n);
        var t: Vec<i64> = cb_unbuf(tag, 16);
        var i: i64 = 0;
        while i < 16 {
            out.push(t.get(i));
            i = i + 1;
        }
    }
    p_free(nb);
    p_free(ab);
    p_free(pb);
    p_free(ct);
    p_free(tag);
    p_free(info);
    p_free(res);
    cb_destroy_key(hkey as * mut u8);
    cb_close_alg(alg as * mut u8, 0);
    return out;
}

/// AES-GCM decrypt: input is ciphertext || 16-byte tag; empty Vec on failure
/// (tag mismatch included).
/// The key is `@secret` (complaint CO1): this body may not print, log,
/// send or store it; the result is an audited release (`@declassify`).
@declassify pub fn cb_gcm_decrypt(@secret key: & Vec, nonce: & Vec, aad: & Vec, ct_tag: & Vec) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if ct_tag.len() < 16 {
        return out;
    }
    var alg: i64 = cb_aes_alg();
    if alg == 0 {
        return out;
    }
    var hkey: i64 = cb_sym_key(alg, key);
    if hkey == 0 {
        cb_close_alg(alg as * mut u8, 0);
        return out;
    }
    var n: i64 = ct_tag.len() - 16;
    var ctb: i64 = cb_buf(ct_tag);
    var nb: i64 = cb_buf(nonce);
    var ab: i64 = cb_buf(aad);
    var tag: i64 = ctb + n;
    var info: i64 = cb_auth_info(nb, nonce.len(), ab, aad.len(), tag, 16, n);
    var pt: i64 = cb_zeroed(if n == 0 {
        1
    } else {
        n
    });
    var res: i64 = cb_zeroed(8);
    var r: i64 = cb_decrypt(hkey as * mut u8, ctb as * mut u8, n, info as * mut u8, 0 as * mut u8, 0, pt as * mut u8, n, res as * mut u8, 0);
    if r == 0 {
        out = cb_unbuf(pt, n);
    }
    p_free(ctb);
    p_free(nb);
    p_free(ab);
    p_free(pt);
    p_free(info);
    p_free(res);
    cb_destroy_key(hkey as * mut u8);
    cb_close_alg(alg as * mut u8, 0);
    return out;
}

// ─── PBKDF2-HMAC-SHA256 ───────────────────────────────────────────────────

/// PBKDF2-HMAC-SHA256: derives `out_len` bytes; empty Vec on failure.
/// The key is `@secret` (complaint CO1): this body may not print, log,
/// send or store it; the result is an audited release (`@declassify`).
@declassify pub fn cb_pbkdf2_derive(@secret password: & Vec, salt: & Vec, iters: i64, out_len: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var h: i64 = cb_zeroed(8);
    var w: i64 = cb_wide("SHA256");
    if cb_open_alg(h as * mut u8, w as * mut u8, 0 as * mut u8, CB_HMAC_FLAG) != 0 {
        p_free(w);
        p_free(h);
        return out;
    }
    p_free(w);
    var alg: i64 = cb_get(h);
    p_free(h);
    var pb: i64 = cb_buf(password);
    var sb: i64 = cb_buf(salt);
    var ob: i64 = cb_zeroed(out_len);
    var r: i64 = cb_pbkdf2(alg as * mut u8, pb as * mut u8, password.len(), sb as * mut u8, salt.len(), iters, ob as * mut u8, out_len, 0);
    if r == 0 {
        out = cb_unbuf(ob, out_len);
    }
    p_free(pb);
    p_free(sb);
    p_free(ob);
    cb_close_alg(alg as * mut u8, 0);
    return out;
}

// ─── ECDSA P-256 ──────────────────────────────────────────────────────────
// Key material moves as BCrypt blobs (ECCPRIVATEBLOB / ECCPUBLICBLOB). The
// private blob holds the secret scalar: treat it as a secret.

fn cb_ecdsa_alg() -> i64 {
    var h: i64 = cb_zeroed(8);
    var w: i64 = cb_wide("ECDSA_P256");
    if cb_open_alg(h as * mut u8, w as * mut u8, 0 as * mut u8, 0) != 0 {
        p_free(w);
        p_free(h);
        return 0;
    }
    p_free(w);
    var alg: i64 = cb_get(h);
    p_free(h);
    return alg;
}

fn cb_export_blob(key: i64, kind: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var w: i64 = cb_wide(kind);
    var res: i64 = cb_zeroed(8);
    var r: i64 = cb_export(key as * mut u8, 0 as * mut u8, w as * mut u8, 0 as * mut u8, 0, res as * mut u8, 0);
    var n: i64 = cb_get32(res);
    if r != 0 || n <= 0 {
        p_free(w);
        p_free(res);
        return out;
    }
    var b: i64 = cb_zeroed(n);
    r = cb_export(key as * mut u8, 0 as * mut u8, w as * mut u8, b as * mut u8, n, res as * mut u8, 0);
    p_free(w);
    p_free(res);
    if r == 0 {
        out = cb_unbuf(b, n);
    }
    p_free(b);
    return out;
}

/// Generate a P-256 key pair into priv_blob/pub_blob. 0 on success.
pub fn cb_ecdsa_generate(priv_blob: & mut Vec, pub_blob: & mut Vec) -> i64 {
    var alg: i64 = cb_ecdsa_alg();
    if alg == 0 {
        return - 1;
    }
    var kh: i64 = cb_zeroed(8);
    var r: i64 = cb_gen_pair(alg as * mut u8, kh as * mut u8, 256, 0);
    if r == 0 {
        r = cb_final_pair(cb_get(kh) as * mut u8, 0);
    }
    var key: i64 = cb_get(kh);
    p_free(kh);
    if r != 0 {
        cb_close_alg(alg as * mut u8, 0);
        return - 1;
    }
    var priv: Vec<i64> = cb_export_blob(key, "ECCPRIVATEBLOB");
    var pubb: Vec<i64> = cb_export_blob(key, "ECCPUBLICBLOB");
    cb_destroy_key(key as * mut u8);
    cb_close_alg(alg as * mut u8, 0);
    if priv.len() == 0 || pubb.len() == 0 {
        return - 1;
    }
    var i: i64 = 0;
    while i < priv.len() {
        priv_blob.push(priv.get(i));
        i = i + 1;
    }
    i = 0;
    while i < pubb.len() {
        pub_blob.push(pubb.get(i));
        i = i + 1;
    }
    return 0;
}

fn cb_import_key(blob: & Vec, kind: str) -> i64 {
    var alg: i64 = cb_ecdsa_alg();
    if alg == 0 {
        return 0;
    }
    var b: i64 = cb_buf(blob);
    var w: i64 = cb_wide(kind);
    var kh: i64 = cb_zeroed(8);
    var r: i64 = cb_import(alg as * mut u8, 0 as * mut u8, w as * mut u8, kh as * mut u8, b as * mut u8, blob.len(), 0);
    p_free(b);
    p_free(w);
    cb_close_alg(alg as * mut u8, 0);
    if r != 0 {
        p_free(kh);
        return 0;
    }
    var key: i64 = cb_get(kh);
    p_free(kh);
    return key;
}

/// Sign a 32-byte hash with the private blob: 64-byte r||s, empty on error.
/// The key is `@secret` (complaint CO1): this body may not print, log,
/// send or store it; the result is an audited release (`@declassify`).
@declassify pub fn cb_ecdsa_sign(@secret priv_blob: & Vec, hash: & Vec) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if hash.len() != 32 {
        return out;
    }
    var key: i64 = cb_import_key(priv_blob, "ECCPRIVATEBLOB");
    if key == 0 {
        return out;
    }
    var hb: i64 = cb_buf(hash);
    var sig: i64 = cb_zeroed(64);
    var res: i64 = cb_zeroed(8);
    var r: i64 = cb_sign(key as * mut u8, 0 as * mut u8, hb as * mut u8, 32, sig as * mut u8, 64, res as * mut u8, 0);
    if r == 0 {
        out = cb_unbuf(sig, cb_get32(res));
    }
    p_free(hb);
    p_free(sig);
    p_free(res);
    cb_destroy_key(key as * mut u8);
    return out;
}

/// Verify a 64-byte r||s signature over a 32-byte hash with the public blob.
pub fn cb_ecdsa_verify(pub_blob: & Vec, hash: & Vec, sig: & Vec) -> bool {
    if hash.len() != 32 || sig.len() != 64 {
        return false;
    }
    var key: i64 = cb_import_key(pub_blob, "ECCPUBLICBLOB");
    if key == 0 {
        return false;
    }
    var hb: i64 = cb_buf(hash);
    var sb: i64 = cb_buf(sig);
    var r: i64 = cb_verify_sig(key as * mut u8, 0 as * mut u8, hb as * mut u8, 32, sb as * mut u8, 64, 0);
    p_free(hb);
    p_free(sb);
    cb_destroy_key(key as * mut u8);
    return r == 0;
}

// ─── RSA ──────────────────────────────────────────────────────────────────
// Keys are BCrypt's own blobs (crypto_bind_rsa.fd builds and reads them):
// RSAPUBLICBLOB and RSAFULLPRIVATEBLOB. Padding by the flags of
// BCryptSignHash / BCryptEncrypt and their padding-info structures:
// BCRYPT_PKCS1_PADDING_INFO { pszAlgId } (8 bytes), BCRYPT_PSS_PADDING_INFO
// { pszAlgId, cbSalt } (16), BCRYPT_OAEP_PADDING_INFO { pszAlgId, pbLabel,
// cbLabel } (24). MGF1 uses the same hash. A signature or ciphertext is as
// long as the modulus: one of another length is refused before BCrypt
// sees it (as crypto_bind_unix does, so both answer alike).

// BCRYPT_PAD_PKCS1, BCRYPT_PAD_OAEP, BCRYPT_PAD_PSS
const CB_PAD_PKCS1: i64 = 2; const CB_PAD_OAEP: i64 = 4; const CB_PAD_PSS: i64 = 8;

fn cb_rsa_alg() -> i64 {
    var h: i64 = cb_zeroed(8);
    var w: i64 = cb_wide("RSA");
    if cb_open_alg(h as * mut u8, w as * mut u8, 0 as * mut u8, 0) != 0 {
        p_free(w);
        p_free(h);
        return 0;
    }
    p_free(w);
    var alg: i64 = cb_get(h);
    p_free(h);
    return alg;
}

// A BCrypt key from an RSA blob (checked first: crypto_bind_rsa's
// cbr_blob_ok), or 0. `want_private`: the blob must hold the private key.
fn cb_rsa_import(blob: & Vec, want_private: bool) -> i64 {
    if !cbr_blob_ok(blob, want_private) {
        return 0;
    }
    var kind: str = "RSAPUBLICBLOB";
    if cbr_u32(blob, 0) == CBR_FULL {
        kind = "RSAFULLPRIVATEBLOB";
    }
    var alg: i64 = cb_rsa_alg();
    if alg == 0 {
        return 0;
    }
    var b: i64 = cb_buf(blob);
    var w: i64 = cb_wide(kind);
    var kh: i64 = cb_zeroed(8);
    var r: i64 = cb_import(alg as * mut u8, 0 as * mut u8, w as * mut u8, kh as * mut u8, b as * mut u8, blob.len(), 0);
    cb_wipe_free(b, blob.len());
    p_free(w);
    // the key keeps what it needs of the provider
    cb_close_alg(alg as * mut u8, 0);
    if r != 0 {
        p_free(kh);
        return 0;
    }
    var key: i64 = cb_get(kh);
    p_free(kh);
    return key;
}

// Zero `n` bytes, then free: for buffers that held a private key.
fn cb_wipe_free(p: i64, n: i64) {
    var i: i64 = 0;
    while i < n {
        // SAFETY: i < n, inside the block of at least n bytes the caller
        // allocated (cb_buf, cb_zeroed).
        unsafe {
            var b: * mut u8 = p + i;
            * b = 0;
        }
        i = i + 1;
    }
    p_free(p);
}

// A padding-info structure for `pad`: the hash name (UTF-16, `alg_w`, kept
// by the caller until the call returns), then the salt length (PSS) or the
// label (OAEP).
fn cb_rsa_pad_info(pad: i64, alg_w: i64, salt_len: i64, label: i64, label_len: i64) -> i64 {
    val info: i64 = cb_zeroed(24);
    cb_set(info, alg_w);
    if pad == CB_PAD_PSS {
        cb_set32(info + 8, salt_len);
    }
    if pad == CB_PAD_OAEP && label_len > 0 {
        cb_set(info + 8, label);
        cb_set32(info + 16, label_len);
    }
    return info;
}

/// Generate an RSA key of `bits` bits (2048, 3072, 4096; e = 65537) into
/// priv_blob (full private) and pub_blob. 0 on success.
pub fn cb_rsa_generate(bits: i64, priv_blob: & mut Vec, pub_blob: & mut Vec) -> i64 {
    if bits < 1024 || bits > 16384 {
        return - 1;
    }
    var alg: i64 = cb_rsa_alg();
    if alg == 0 {
        return - 1;
    }
    var kh: i64 = cb_zeroed(8);
    var r: i64 = cb_gen_pair(alg as * mut u8, kh as * mut u8, bits, 0);
    if r == 0 {
        r = cb_final_pair(cb_get(kh) as * mut u8, 0);
    }
    var key: i64 = cb_get(kh);
    p_free(kh);
    if r != 0 {
        if key != 0 {
            cb_destroy_key(key as * mut u8);
        }
        cb_close_alg(alg as * mut u8, 0);
        return - 1;
    }
    var priv: Vec<i64> = cb_export_blob(key, "RSAFULLPRIVATEBLOB");
    var pubb: Vec<i64> = cb_export_blob(key, "RSAPUBLICBLOB");
    cb_destroy_key(key as * mut u8);
    cb_close_alg(alg as * mut u8, 0);
    if priv.len() == 0 || pubb.len() == 0 {
        return - 1;
    }
    var i: i64 = 0;
    while i < priv.len() {
        priv_blob.push(priv.get(i));
        i = i + 1;
    }
    i = 0;
    while i < pubb.len() {
        pub_blob.push(pubb.get(i));
        i = i + 1;
    }
    return 0;
}

// Sign `hash` (of the hash `hash_alg`) with padding `pad`: the signature,
// as long as the modulus; empty on failure.
fn cb_rsa_sign(priv_blob: & Vec, hash_alg: str, hash: & Vec, pad: i64, salt_len: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val hlen: i64 = cbr_hash_len(hash_alg);
    if hlen == 0 || hash.len() != hlen || salt_len < 0 {
        return out;
    }
    var key: i64 = cb_rsa_import(priv_blob, true);
    if key == 0 {
        return out;
    }
    val k: i64 = cb_rsa_modulus_len(priv_blob);
    var w: i64 = cb_wide(hash_alg);
    var info: i64 = cb_rsa_pad_info(pad, w, salt_len, 0, 0);
    var hb: i64 = cb_buf(hash);
    var sig: i64 = cb_zeroed(k);
    var res: i64 = cb_zeroed(8);
    var r: i64 = cb_sign(key as * mut u8, info as * mut u8, hb as * mut u8, hlen, sig as * mut u8, k, res as * mut u8, pad);
    if r == 0 && cb_get32(res) == k {
        out = cb_unbuf(sig, k);
    }
    p_free(w);
    p_free(info);
    p_free(hb);
    p_free(sig);
    p_free(res);
    cb_destroy_key(key as * mut u8);
    return out;
}

// Verify `sig` over `hash` with padding `pad`.
fn cb_rsa_verify(pub_blob: & Vec, hash_alg: str, hash: & Vec, sig: & Vec, pad: i64, salt_len: i64) -> bool {
    val hlen: i64 = cbr_hash_len(hash_alg);
    if hlen == 0 || hash.len() != hlen || salt_len < 0 {
        return false;
    }
    val k: i64 = cb_rsa_modulus_len(pub_blob);
    if k == 0 || sig.len() != k {
        return false;
    }
    var key: i64 = cb_rsa_import(pub_blob, false);
    if key == 0 {
        return false;
    }
    var w: i64 = cb_wide(hash_alg);
    var info: i64 = cb_rsa_pad_info(pad, w, salt_len, 0, 0);
    var hb: i64 = cb_buf(hash);
    var sb: i64 = cb_buf(sig);
    var r: i64 = cb_verify_sig(key as * mut u8, info as * mut u8, hb as * mut u8, hlen, sb as * mut u8, k, pad);
    p_free(w);
    p_free(info);
    p_free(hb);
    p_free(sb);
    cb_destroy_key(key as * mut u8);
    return r == 0;
}

/// RSASSA-PKCS1-v1_5 (RFC 8017 8.2): sign the digest `hash` of the hash
/// `hash_alg` ("SHA256" ...) with a private blob. The signature (as long as
/// the modulus), empty on error.
/// The key is `@secret` (complaint CO1): this body may not print, log,
/// send or store it; the result is an audited release (`@declassify`).
@declassify pub fn cb_rsa_sign_pkcs1(@secret priv_blob: & Vec, hash_alg: str, hash: & Vec) -> Vec<i64> {
    return cb_rsa_sign(priv_blob, hash_alg, hash, CB_PAD_PKCS1, 0);
}

/// Verify an RSASSA-PKCS1-v1_5 signature over the digest `hash` with a
/// public (or private) blob.
pub fn cb_rsa_verify_pkcs1(pub_blob: & Vec, hash_alg: str, hash: & Vec, sig: & Vec) -> bool {
    return cb_rsa_verify(pub_blob, hash_alg, hash, sig, CB_PAD_PKCS1, 0);
}

/// RSASSA-PSS (RFC 8017 8.1) with MGF1 of the same hash and a salt of
/// `salt_len` bytes (usually the digest length): sign the digest `hash`.
/// Empty on error.
/// The key is `@secret` (complaint CO1): this body may not print, log,
/// send or store it; the result is an audited release (`@declassify`).
@declassify pub fn cb_rsa_sign_pss(@secret priv_blob: & Vec, hash_alg: str, hash: & Vec, salt_len: i64) -> Vec<i64> {
    return cb_rsa_sign(priv_blob, hash_alg, hash, CB_PAD_PSS, salt_len);
}

/// Verify an RSASSA-PSS signature (MGF1 of the same hash, a salt of exactly
/// `salt_len` bytes) over the digest `hash`.
pub fn cb_rsa_verify_pss(pub_blob: & Vec, hash_alg: str, hash: & Vec, sig: & Vec, salt_len: i64) -> bool {
    return cb_rsa_verify(pub_blob, hash_alg, hash, sig, CB_PAD_PSS, salt_len);
}

/// RSAES-OAEP (RFC 8017 7.1) with the hash `hash_alg` for the label and
/// MGF1: encrypt `msg` (at most modulus length - 2 * digest - 2 bytes) to
/// a public blob. `label` may be empty. The ciphertext (as long as the
/// modulus), empty on error.
pub fn cb_rsa_encrypt_oaep(pub_blob: & Vec, hash_alg: str, msg: & Vec, label: & Vec) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val hlen: i64 = cbr_hash_len(hash_alg);
    val k: i64 = cb_rsa_modulus_len(pub_blob);
    if hlen == 0 || k == 0 || msg.len() > k - 2 * hlen - 2 {
        return out;
    }
    var key: i64 = cb_rsa_import(pub_blob, false);
    if key == 0 {
        return out;
    }
    var w: i64 = cb_wide(hash_alg);
    var lb: i64 = cb_buf(label);
    var info: i64 = cb_rsa_pad_info(CB_PAD_OAEP, w, 0, lb, label.len());
    var mb: i64 = cb_buf(msg);
    var ct: i64 = cb_zeroed(k);
    var res: i64 = cb_zeroed(8);
    var r: i64 = cb_encrypt(key as * mut u8, mb as * mut u8, msg.len(), info as * mut u8, 0 as * mut u8, 0, ct as * mut u8, k, res as * mut u8, CB_PAD_OAEP);
    if r == 0 && cb_get32(res) == k {
        out = cb_unbuf(ct, k);
    }
    p_free(w);
    p_free(lb);
    p_free(info);
    cb_wipe_free(mb, msg.len());
    p_free(ct);
    p_free(res);
    cb_destroy_key(key as * mut u8);
    return out;
}

/// RSAES-OAEP decrypt `ct` with a private blob into `out` (which may come
/// back empty: an empty message). False, with `out` untouched, when the
/// ciphertext, its padding or the label is wrong.
/// The key is `@secret` (complaint CO1): this body may not print, log,
/// send or store it; the result is an audited release (`@declassify`).
@declassify pub fn cb_rsa_decrypt_oaep(@secret priv_blob: & Vec, hash_alg: str, ct: & Vec, label: & Vec, out: & mut Vec) -> bool {
    val hlen: i64 = cbr_hash_len(hash_alg);
    val k: i64 = cb_rsa_modulus_len(priv_blob);
    if hlen == 0 || k == 0 || ct.len() != k {
        return false;
    }
    var key: i64 = cb_rsa_import(priv_blob, true);
    if key == 0 {
        return false;
    }
    var w: i64 = cb_wide(hash_alg);
    var lb: i64 = cb_buf(label);
    var info: i64 = cb_rsa_pad_info(CB_PAD_OAEP, w, 0, lb, label.len());
    var ctb: i64 = cb_buf(ct);
    var pt: i64 = cb_zeroed(k);
    var res: i64 = cb_zeroed(8);
    var r: i64 = cb_decrypt(key as * mut u8, ctb as * mut u8, k, info as * mut u8, 0 as * mut u8, 0, pt as * mut u8, k, res as * mut u8, CB_PAD_OAEP);
    val n: i64 = cb_get32(res);
    val ok: bool = r == 0 && n >= 0 && n <= k;
    if ok {
        val m: Vec<i64> = cb_unbuf(pt, n);
        var i: i64 = 0;
        while i < m.len() {
            out.push(m.get(i));
            i = i + 1;
        }
    }
    p_free(w);
    p_free(lb);
    p_free(info);
    p_free(ctb);
    cb_wipe_free(pt, k);
    p_free(res);
    cb_destroy_key(key as * mut u8);
    return ok;
}
