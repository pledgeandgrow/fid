// Fides Tasks standard library
//
// Green threads: many tasks on one OS thread, each with its own stack. A task
// runs until it calls task_yield, then the next one runs. On the native and C
// paths this is real stack switching, so 10,000 tasks are cheap. The interpreter
// has one call stack: there a task runs to its end when started.
//
// Usage:
//   use task;
//   fn worker(n: i64) -> i64 { task_yield(); return n * 2; }
//   val t = task_go("worker", 21);
//   task_run();
//   println(task_result(t));

module task;

/// Start the function `name`, which takes one i64, as a task. It first runs
/// when task_run does. Returns the task.
pub fn task_go(name: str, arg: i64) -> i64 {
    return p_co_go(name, arg);
}

/// Let the other tasks run. Outside a task it does nothing.
pub fn task_yield() -> void {
    p_co_yield();
}

/// Run every task until all have finished, tasks they start included.
/// Returns how many tasks there have been.
pub fn task_run() -> i64 {
    return p_co_run();
}

/// True once the task has finished.
pub fn task_done(t: i64) -> bool {
    return p_co_done(t) != 0;
}

/// What the task returned.
pub fn task_result(t: i64) -> i64 {
    return p_co_result(t);
}
