// xHCI (USB 3 host controller): register map, TRB formats, producer
// rings with link TRBs and cycle bits, the event ring and its segment
// table, device contexts, and the controller bring-up steps.
//
// What is real: capability, operational, port, runtime (interrupter) and
// doorbell register offsets and fields; extended capabilities (USB legacy
// support with the BIOS-to-OS ownership handoff, supported-protocol
// capabilities that say which ports are USB 2 and which USB 3); TRB
// encoding and decoding for Normal, Setup/Data/Status stage, Link, No-op,
// the command TRBs (Enable/Disable Slot, Address Device, Configure
// Endpoint, Evaluate Context, Reset/Stop Endpoint, Set TR Dequeue, Reset
// Device) and the events (Transfer, Command Completion, Port Status
// Change); completion codes; producer rings that write the cycle bit
// last, follow the link TRB and toggle the producer cycle state, and know
// when they are full; the event ring consumer with the consumer cycle
// state, the ERST and the ERDP value (with the EHB bit); slot, endpoint
// and input contexts (32- or 64-byte), endpoint ids (DCI), default EP0
// packet sizes per speed; and the reset / run sequence with the order the
// specification requires (ERSTBA written last).
//
// The seams: registers through an XhciBus of rd(offset) -> u32 and
// wr(offset, u32) on byte offsets from the MMIO base (the kernel maps BAR0
// uncached); DMA memory (rings, contexts, the DCBAA) is a stdlib vmm
// PhysMem, fake RAM in tests or real memory through a direct map.
module xhci;
 use vec; use vmm;

// ─── Capability registers ───────────────────────────────────────────────

pub const XHCI_CAPLENGTH: i64 = 0x00;
pub const XHCI_HCIVERSION: i64 = 0x02;
pub const XHCI_HCSPARAMS1: i64 = 0x04;
pub const XHCI_HCSPARAMS2: i64 = 0x08;
pub const XHCI_HCSPARAMS3: i64 = 0x0C;
pub const XHCI_HCCPARAMS1: i64 = 0x10;
pub const XHCI_DBOFF: i64 = 0x14;
pub const XHCI_RTSOFF: i64 = 0x18;
pub const XHCI_HCCPARAMS2: i64 = 0x1C;

// Operational registers (from the operational base = CAPLENGTH).
pub const XHCI_USBCMD: i64 = 0x00;
pub const XHCI_USBSTS: i64 = 0x04;
pub const XHCI_PAGESIZE: i64 = 0x08;
pub const XHCI_DNCTRL: i64 = 0x14;
pub const XHCI_CRCR: i64 = 0x18;
pub const XHCI_DCBAAP: i64 = 0x30;
pub const XHCI_CONFIG: i64 = 0x38;
pub const XHCI_PORTS: i64 = 0x400;

pub const USBCMD_RS: i64 = 0x1;
pub const USBCMD_HCRST: i64 = 0x2;
pub const USBCMD_INTE: i64 = 0x4;
pub const USBCMD_HSEE: i64 = 0x8;

pub const USBSTS_HCH: i64 = 0x1;
pub const USBSTS_HSE: i64 = 0x4;
pub const USBSTS_EINT: i64 = 0x8;
pub const USBSTS_PCD: i64 = 0x10;
pub const USBSTS_CNR: i64 = 0x800;
pub const USBSTS_HCE: i64 = 0x1000;

// PORTSC bits.
pub const PORTSC_CCS: i64 = 0x1;
pub const PORTSC_PED: i64 = 0x2;
pub const PORTSC_OCA: i64 = 0x8;
pub const PORTSC_PR: i64 = 0x10;
pub const PORTSC_PP: i64 = 0x200;
pub const PORTSC_LWS: i64 = 0x10000;
pub const PORTSC_CSC: i64 = 0x20000;
pub const PORTSC_PEC: i64 = 0x40000;
pub const PORTSC_WRC: i64 = 0x80000;
pub const PORTSC_OCC: i64 = 0x100000;
pub const PORTSC_PRC: i64 = 0x200000;
pub const PORTSC_PLC: i64 = 0x400000;
pub const PORTSC_CEC: i64 = 0x800000;
pub const PORTSC_WPR: i64 = 0x80000000;
/// Write-1-to-clear change bits (and PED, which a 1 would disable).
pub const PORTSC_RW1C: i64 = 0x00FE0002;

// Port speeds (default protocol speed IDs).
pub const XHCI_SPEED_FULL: i64 = 1;
pub const XHCI_SPEED_LOW: i64 = 2;
pub const XHCI_SPEED_HIGH: i64 = 3;
pub const XHCI_SPEED_SUPER: i64 = 4;
pub const XHCI_SPEED_SUPER_PLUS: i64 = 5;

// ─── TRB types and completion codes ─────────────────────────────────────

pub const TRB_NORMAL: i64 = 1;
pub const TRB_SETUP: i64 = 2;
pub const TRB_DATA: i64 = 3;
pub const TRB_STATUS: i64 = 4;
pub const TRB_ISOCH: i64 = 5;
pub const TRB_LINK: i64 = 6;
pub const TRB_EVENT_DATA: i64 = 7;
pub const TRB_NOOP: i64 = 8;
pub const TRB_ENABLE_SLOT: i64 = 9;
pub const TRB_DISABLE_SLOT: i64 = 10;
pub const TRB_ADDRESS_DEVICE: i64 = 11;
pub const TRB_CONFIGURE_EP: i64 = 12;
pub const TRB_EVALUATE_CTX: i64 = 13;
pub const TRB_RESET_EP: i64 = 14;
pub const TRB_STOP_EP: i64 = 15;
pub const TRB_SET_TR_DEQ: i64 = 16;
pub const TRB_RESET_DEVICE: i64 = 17;
pub const TRB_NOOP_CMD: i64 = 23;
pub const TRB_TRANSFER_EVENT: i64 = 32;
pub const TRB_CMD_COMPLETION: i64 = 33;
pub const TRB_PORT_STATUS: i64 = 34;
pub const TRB_HC_EVENT: i64 = 37;

pub const TRB_CYCLE: i64 = 0x1;
pub const TRB_TC: i64 = 0x2;
// link TRB: toggle cycle
pub const TRB_ENT: i64 = 0x2;
pub const TRB_ISP: i64 = 0x4;
pub const TRB_CH: i64 = 0x10;
pub const TRB_IOC: i64 = 0x20;
pub const TRB_IDT: i64 = 0x40;
pub const TRB_DIR_IN: i64 = 0x10000;

pub const CC_SUCCESS: i64 = 1;
pub const CC_DATA_BUFFER: i64 = 2;
pub const CC_BABBLE: i64 = 3;
pub const CC_TRANSACTION: i64 = 4;
pub const CC_TRB: i64 = 5;
pub const CC_STALL: i64 = 6;
pub const CC_NO_SLOTS: i64 = 9;
pub const CC_SHORT_PACKET: i64 = 13;
pub const CC_PARAMETER: i64 = 17;
pub const CC_CONTEXT_STATE: i64 = 19;
pub const CC_STOPPED: i64 = 26;

pub fn xhci_cc_name(cc: i64) -> str {
    if cc == 1 { return "Success"; }
    if cc == 2 { return "Data Buffer Error"; }
    if cc == 3 { return "Babble Detected"; }
    if cc == 4 { return "USB Transaction Error"; }
    if cc == 5 { return "TRB Error"; }
    if cc == 6 { return "Stall Error"; }
    if cc == 7 { return "Resource Error"; }
    if cc == 8 { return "Bandwidth Error"; }
    if cc == 9 { return "No Slots Available"; }
    if cc == 11 { return "Slot Not Enabled"; }
    if cc == 12 { return "Endpoint Not Enabled"; }
    if cc == 13 { return "Short Packet"; }
    if cc == 14 { return "Ring Underrun"; }
    if cc == 15 { return "Ring Overrun"; }
    if cc == 17 { return "Parameter Error"; }
    if cc == 19 { return "Context State Error"; }
    if cc == 21 { return "Event Ring Full"; }
    if cc == 24 { return "Command Ring Stopped"; }
    if cc == 25 { return "Command Aborted"; }
    if cc == 26 { return "Stopped"; }
    return "Code " + int_to_str(cc);
}

// ─── TRBs ───────────────────────────────────────────────────────────────

pub struct Trb {
    pub param: i64,
    // dwords 0-1 (64-bit parameter / pointer)
    pub status: i64,
    pub control: i64,
}

pub fn trb_type(t: & Trb) -> i64 {
    return (t.control >> 10) & 63;
}

pub fn trb_cycle(t: & Trb) -> i64 {
    return t.control & 1;
}

/// Completion code of an event TRB.
pub fn trb_cc(t: & Trb) -> i64 {
    return (t.status >> 24) & 255;
}

/// Slot id of an event or command TRB.
pub fn trb_slot(t: & Trb) -> i64 {
    return (t.control >> 24) & 255;
}

/// Endpoint id (DCI) of a transfer event.
pub fn trb_ep(t: & Trb) -> i64 {
    return (t.control >> 16) & 31;
}

/// Bytes not transferred, from a transfer event.
pub fn trb_residual(t: & Trb) -> i64 {
    return t.status & 0xFFFFFF;
}

/// Port id of a port status change event.
pub fn trb_port(t: & Trb) -> i64 {
    return (t.param >> 24) & 255;
}

fn trb_ctl(ty: i64, flags: i64) -> i64 {
    return ((ty & 63) << 10) | flags;
}

/// Normal TRB (bulk / interrupt data).
pub fn trb_normal(buf: i64, len: i64, td_size: i64, flags: i64) -> Trb {
    return Trb { param: buf, status: (len & 0x1FFFF) | ((td_size & 31) << 17), control: trb_ctl(TRB_NORMAL, flags) };
}

/// Setup stage TRB for an 8-byte SETUP packet (immediate data).
/// trt: 0 = no data stage, 2 = OUT data, 3 = IN data.
@wrapping pub fn trb_setup(bm_request_type: i64, b_request: i64, w_value: i64, w_index: i64, w_length: i64, trt: i64) -> Trb {
    var p: i64 = (bm_request_type & 255) | ((b_request & 255) << 8) | ((w_value & 0xFFFF) << 16) | ((w_index & 0xFFFF) << 32) | ((w_length & 0xFFFF) << 48);
    return Trb { param: p, status: 8, control: trb_ctl(TRB_SETUP, TRB_IDT | ((trt & 3) << 16)) };
}

pub fn trb_data(buf: i64, len: i64, dir_in: bool) -> Trb {
    var f: i64 = 0;
    if dir_in { f = TRB_DIR_IN; }
    return Trb { param: buf, status: len & 0x1FFFF, control: trb_ctl(TRB_DATA, f) };
}

/// Status stage: direction opposite to the data stage (IN when there is
/// no data stage), interrupt on completion.
pub fn trb_status(dir_in: bool) -> Trb {
    var f: i64 = TRB_IOC;
    if dir_in { f = f | TRB_DIR_IN; }
    return Trb { param: 0, status: 0, control: trb_ctl(TRB_STATUS, f) };
}

pub fn trb_link(target: i64, toggle: bool) -> Trb {
    var f: i64 = 0;
    if toggle { f = TRB_TC; }
    return Trb { param: target & ~15, status: 0, control: trb_ctl(TRB_LINK, f) };
}

pub fn trb_noop_cmd() -> Trb {
    return Trb { param: 0, status: 0, control: trb_ctl(TRB_NOOP_CMD, 0) };
}

pub fn trb_enable_slot(slot_type: i64) -> Trb {
    return Trb { param: 0, status: 0, control: trb_ctl(TRB_ENABLE_SLOT, (slot_type & 31) << 16) };
}

pub fn trb_disable_slot(slot: i64) -> Trb {
    return Trb { param: 0, status: 0, control: trb_ctl(TRB_DISABLE_SLOT, (slot & 255) << 24) };
}

/// Address Device; bsr = block SET_ADDRESS (only enable the slot).
pub fn trb_address_device(input_ctx: i64, slot: i64, bsr: bool) -> Trb {
    var f: i64 = (slot & 255) << 24;
    if bsr { f = f | 0x200; }
    return Trb { param: input_ctx & ~15, status: 0, control: trb_ctl(TRB_ADDRESS_DEVICE, f) };
}

/// Configure Endpoint; dc = deconfigure.
pub fn trb_configure_ep(input_ctx: i64, slot: i64, dc: bool) -> Trb {
    var f: i64 = (slot & 255) << 24;
    if dc { f = f | 0x200; }
    return Trb { param: input_ctx & ~15, status: 0, control: trb_ctl(TRB_CONFIGURE_EP, f) };
}

pub fn trb_evaluate_ctx(input_ctx: i64, slot: i64) -> Trb {
    return Trb { param: input_ctx & ~15, status: 0, control: trb_ctl(TRB_EVALUATE_CTX, (slot & 255) << 24) };
}

pub fn trb_reset_ep(slot: i64, dci: i64, preserve: bool) -> Trb {
    var f: i64 = ((slot & 255) << 24) | ((dci & 31) << 16);
    if preserve { f = f | 0x200; }
    return Trb { param: 0, status: 0, control: trb_ctl(TRB_RESET_EP, f) };
}

pub fn trb_stop_ep(slot: i64, dci: i64, suspend: bool) -> Trb {
    var f: i64 = ((slot & 255) << 24) | ((dci & 31) << 16);
    if suspend { f = f | 0x800000; }
    return Trb { param: 0, status: 0, control: trb_ctl(TRB_STOP_EP, f) };
}

/// Set TR Dequeue Pointer: new dequeue address with its cycle state.
pub fn trb_set_tr_deq(slot: i64, dci: i64, ptr: i64, dcs: i64) -> Trb {
    return Trb { param: (ptr & ~15) | (dcs & 1), status: 0, control: trb_ctl(TRB_SET_TR_DEQ, ((slot & 255) << 24) | ((dci & 31) << 16)) };
}

pub fn trb_reset_device(slot: i64) -> Trb {
    return Trb { param: 0, status: 0, control: trb_ctl(TRB_RESET_DEVICE, (slot & 255) << 24) };
}

/// Write a TRB at pa: parameter and status first, the control dword (with
/// the cycle bit) last, so the controller never sees a half-written TRB.
pub fn xhci_trb_write(m: & mut PhysMem, pa: i64, t: Trb) {
    phys_write_le(m, pa, 4, t.param & 0xFFFFFFFF);
    phys_write_le(m, pa + 4, 4, (t.param >> 32) & 0xFFFFFFFF);
    phys_write_le(m, pa + 8, 4, t.status & 0xFFFFFFFF);
    phys_write_le(m, pa + 12, 4, t.control & 0xFFFFFFFF);
}

@wrapping pub fn xhci_trb_read(m: & PhysMem, pa: i64) -> Trb {
    var lo: i64 = phys_read_le(m, pa, 4);
    var hi: i64 = phys_read_le(m, pa + 4, 4);
    return Trb { param: lo | (hi << 32), status: phys_read_le(m, pa + 8, 4), control: phys_read_le(m, pa + 12, 4) };
}

// ─── Producer rings (command and transfer) ──────────────────────────────

pub struct XhciRing {
    pub base: i64,
    pub size: i64,
    // TRBs in the segment, the last one is the link TRB
    pub enq: i64,
    pub pcs: i64,
    // producer cycle state
    pub deq: i64,
    // last index known consumed (from completion events)
    pub queued: i64,
}

/// A one-segment ring of `size` TRBs at pa (64-byte aligned): zeroed,
/// with a link TRB back to the start that toggles the cycle state.
pub fn xhci_ring_new(m: & mut PhysMem, pa: i64, size: i64) -> XhciRing {
    var i: i64 = 0;
    while i < size * 2 {
        phys_write64(m, pa + i * 8, 0);
        i = i + 1;
    }
    xhci_trb_write(m, pa + (size - 1) * 16, trb_link(pa, true));
    return XhciRing { base: pa, size: size, enq: 0, pcs: 1, deq: 0, queued: 0 };
}

/// TRBs that can still be queued (one slot stays empty to tell full from
/// empty).
pub fn xhci_ring_space(r: & XhciRing) -> i64 {
    var usable: i64 = r.size - 1;
    return usable - 1 - r.queued;
}

/// Physical address of the next enqueue slot.
pub fn xhci_ring_enq_ptr(r: & XhciRing) -> i64 {
    return r.base + r.enq * 16;
}

/// Queue a TRB with the producer cycle bit; returns its address, -1 when
/// the ring is full. Crossing the link TRB hands it to the controller
/// (its cycle bit and chain bit set from the TRB before it) and toggles
/// the producer cycle state.
pub fn xhci_ring_push(m: & mut PhysMem, r: & mut XhciRing, t: Trb) -> i64 {
    if xhci_ring_space(r) <= 0 {
        return -1;
    }
    var at: i64 = xhci_ring_enq_ptr(r);
    var c: Trb = Trb { param: t.param, status: t.status, control: (t.control & ~1) | r.pcs };
    xhci_trb_write(m, at, c);
    r.enq = r.enq + 1;
    r.queued = r.queued + 1;
    if r.enq == r.size - 1 {
        var link: Trb = xhci_trb_read(m, xhci_ring_enq_ptr(r));
        var lc: i64 = (link.control & ~(1 | TRB_CH)) | r.pcs | (t.control & TRB_CH);
        phys_write_le(m, xhci_ring_enq_ptr(r) + 12, 4, lc);
        r.enq = 0;
        r.pcs = r.pcs ^ 1;
    }
    return at;
}

/// The controller reported it finished the TRB at pa: everything up to
/// and including it is free again.
pub fn xhci_ring_consumed(r: & mut XhciRing, pa: i64) {
    var idx: i64 = (pa - r.base) / 16;
    if idx < 0 || idx >= r.size - 1 {
        return;
    }
    var n: i64 = idx - r.deq + 1;
    if n <= 0 {
        n = n + r.size - 1;
    }
    r.queued = r.queued - n;
    if r.queued < 0 { r.queued = 0; }
    r.deq = idx + 1;
    if r.deq == r.size - 1 {
        r.deq = 0;
    }
}

/// CRCR value: ring address with the ring cycle state.
pub fn xhci_crcr(r: & XhciRing) -> i64 {
    return (r.base & ~63) | (r.pcs & 1);
}

// ─── Event ring ─────────────────────────────────────────────────────────

pub struct XhciEventRing {
    pub erst: i64,
    // segment table address (one entry)
    pub seg: i64,
    pub size: i64,
    pub deq: i64,
    pub ccs: i64,
}

/// One-segment event ring: segment of `size` TRBs at seg, ERST at erst.
pub fn xhci_event_ring_new(m: & mut PhysMem, erst: i64, seg: i64, size: i64) -> XhciEventRing {
    var i: i64 = 0;
    while i < size * 2 {
        phys_write64(m, seg + i * 8, 0);
        i = i + 1;
    }
    phys_write64(m, erst, seg);
    phys_write_le(m, erst + 8, 4, size);
    phys_write_le(m, erst + 12, 4, 0);
    return XhciEventRing { erst: erst, seg: seg, size: size, deq: 0, ccs: 1 };
}

pub fn xhci_event_ptr(er: & XhciEventRing) -> i64 {
    return er.seg + er.deq * 16;
}

/// Whether an event is waiting (its cycle bit matches CCS).
pub fn xhci_event_pending(er: & XhciEventRing, m: & PhysMem) -> bool {
    return (phys_read_le(m, xhci_event_ptr(er) + 12, 4) & 1) == er.ccs;
}

/// Take the next event; control = -1 when none is pending.
pub fn xhci_event_pop(er: & mut XhciEventRing, m: & PhysMem) -> Trb {
    if !xhci_event_pending(er, m) {
        return Trb { param: 0, status: 0, control: -1 };
    }
    var t: Trb = xhci_trb_read(m, xhci_event_ptr(er));
    er.deq = er.deq + 1;
    if er.deq == er.size {
        er.deq = 0;
        er.ccs = er.ccs ^ 1;
    }
    return t;
}

/// ERDP value after handling events: dequeue pointer with EHB (bit 3,
/// write 1 to clear the busy flag).
pub fn xhci_erdp(er: & XhciEventRing) -> i64 {
    return xhci_event_ptr(er) | 8;
}

// ─── Contexts ───────────────────────────────────────────────────────────

pub const EP_ISOCH_OUT: i64 = 1;
pub const EP_BULK_OUT: i64 = 2;
pub const EP_INTR_OUT: i64 = 3;
pub const EP_CONTROL: i64 = 4;
pub const EP_ISOCH_IN: i64 = 5;
pub const EP_BULK_IN: i64 = 6;
pub const EP_INTR_IN: i64 = 7;

/// Device context index of an endpoint: EP0 = 1, epN OUT = 2N, IN = 2N+1.
pub fn xhci_dci(ep_num: i64, dir_in: bool) -> i64 {
    if ep_num == 0 {
        return 1;
    }
    if dir_in {
        return ep_num * 2 + 1;
    }
    return ep_num * 2;
}

/// xHCI endpoint type from a USB endpoint descriptor's bmAttributes and
/// direction.
pub fn xhci_ep_type(bm_attributes: i64, dir_in: bool) -> i64 {
    var t: i64 = bm_attributes & 3;
    if t == 0 { return EP_CONTROL; }
    if dir_in { return t + 4; }
    return t;
}

/// Initial EP0 max packet size for a port speed.
pub fn xhci_ep0_max_packet(speed: i64) -> i64 {
    if speed == XHCI_SPEED_LOW { return 8; }
    if speed == XHCI_SPEED_FULL { return 8; }
    if speed == XHCI_SPEED_HIGH { return 64; }
    return 512;
}

/// Slot context dword 0..3.
pub fn xhci_slot_ctx(speed: i64, entries: i64, root_port: i64, route: i64) -> Vec<i64> {
    var d: Vec<i64> = Vec::new();
    d.push((route & 0xFFFFF) | ((speed & 15) << 20) | ((entries & 31) << 27));
    d.push((root_port & 255) << 16);
    d.push(0);
    d.push(0);
    return d;
}

/// Endpoint context dwords 0..4: type, max packet, burst, interval,
/// error count 3 (0 for isochronous), TR dequeue pointer with DCS, and
/// the average TRB length.
@wrapping pub fn xhci_ep_ctx(ep_type: i64, max_packet: i64, burst: i64, interval: i64, ring: i64, dcs: i64, avg_trb: i64) -> Vec<i64> {
    var cerr: i64 = 3;
    if ep_type == EP_ISOCH_OUT || ep_type == EP_ISOCH_IN {
        cerr = 0;
    }
    var d: Vec<i64> = Vec::new();
    d.push((interval & 255) << 16);
    d.push((cerr << 1) | ((ep_type & 7) << 3) | ((burst & 255) << 8) | ((max_packet & 0xFFFF) << 16));
    d.push(((ring & ~15) | (dcs & 1)) & 0xFFFFFFFF);
    d.push((ring >> 32) & 0xFFFFFFFF);
    d.push(avg_trb & 0xFFFF);
    return d;
}

fn xhci_write_dwords(m: & mut PhysMem, pa: i64, d: Vec<i64>) {
    var i: i64 = 0;
    while i < d.len() {
        phys_write_le(m, pa + i * 4, 4, d.get(i));
        i = i + 1;
    }
}

/// Context size in bytes (HCCPARAMS1.CSZ: 64-byte contexts).
pub fn xhci_ctx_size(csz64: bool) -> i64 {
    if csz64 {
        return 64;
    }
    return 32;
}

/// Input context for Address Device at pa: add flags A0 (slot) and A1
/// (EP0), the slot context and the EP0 context on ring ep0_ring.
pub fn xhci_input_ctx_address(m: & mut PhysMem, pa: i64, csz64: bool, root_port: i64, speed: i64, ep0_ring: i64) {
    var cs: i64 = xhci_ctx_size(csz64);
    var i: i64 = 0;
    while i < cs * 33 / 8 {
        phys_write64(m, pa + i * 8, 0);
        i = i + 1;
    }
    phys_write_le(m, pa + 4, 4, 3);
    xhci_write_dwords(m, pa + cs, xhci_slot_ctx(speed, 1, root_port, 0));
    xhci_write_dwords(m, pa + cs * 2, xhci_ep_ctx(EP_CONTROL, xhci_ep0_max_packet(speed), 0, 0, ep0_ring, 1, 8));
}

/// Dword d of context index `ctx` (0 = input control / slot, ...) in a
/// context block at pa.
pub fn xhci_ctx_dword(m: & PhysMem, pa: i64, csz64: bool, ctx: i64, d: i64) -> i64 {
    return phys_read_le(m, pa + ctx * xhci_ctx_size(csz64) + d * 4, 4);
}

// ─── Registers over the bus seam ────────────────────────────────────────

pub struct XhciBus {
    pub rd: fn(i64) -> i64,
    pub wr: fn(i64, i64) -> void,
}

pub fn xhci_rd(b: & XhciBus, off: i64) -> i64 {
    val f = b.rd;
    return f(off) & 0xFFFFFFFF;
}

pub fn xhci_wr(b: & XhciBus, off: i64, v: i64) {
    val f = b.wr;
    f(off, v & 0xFFFFFFFF);
}

/// 64-bit register as two dword writes, low first.
pub fn xhci_wr64(b: & XhciBus, off: i64, v: i64) {
    xhci_wr(b, off, v & 0xFFFFFFFF);
    xhci_wr(b, off + 4, (v >> 32) & 0xFFFFFFFF);
}

@wrapping pub fn xhci_rd64(b: & XhciBus, off: i64) -> i64 {
    return xhci_rd(b, off) | (xhci_rd(b, off + 4) << 32);
}

pub struct XhciCaps {
    pub caplength: i64,
    pub version: i64,
    pub max_slots: i64,
    pub max_intrs: i64,
    pub max_ports: i64,
    pub erst_max: i64,
    // log2 of the ERST size limit
    pub scratchpads: i64,
    pub ac64: bool,
    pub csz64: bool,
    pub ppc: bool,
    pub xecp: i64,
    // byte offset of the first extended capability, 0 none
    pub op: i64,
    pub db: i64,
    pub rt: i64,
}

pub fn xhci_caps(b: & XhciBus) -> XhciCaps {
    var w0: i64 = xhci_rd(b, 0);
    var p1: i64 = xhci_rd(b, XHCI_HCSPARAMS1);
    var p2: i64 = xhci_rd(b, XHCI_HCSPARAMS2);
    var c1: i64 = xhci_rd(b, XHCI_HCCPARAMS1);
    var cl: i64 = w0 & 255;
    return XhciCaps {
        caplength: cl, version: (w0 >> 16) & 0xFFFF, max_slots: p1 & 255, max_intrs: (p1 >> 8) & 0x7FF, max_ports: (p1 >> 24) & 255, erst_max: (p2 >> 4) & 15, scratchpads: (((p2 >> 21) & 31) << 5) | ((p2 >> 27) & 31), ac64: (c1 & 1) != 0, csz64: (c1 & 4) != 0, ppc: (c1 & 8) != 0, xecp: ((c1 >> 16) & 0xFFFF) * 4, op: cl, db: xhci_rd(b, XHCI_DBOFF) & ~3, rt: xhci_rd(b, XHCI_RTSOFF) & ~31
    };
}

/// Byte offset of PORTSC of port n (1-based).
pub fn xhci_portsc_off(c: & XhciCaps, n: i64) -> i64 {
    return c.op + XHCI_PORTS + 0x10 * (n - 1);
}

/// Byte offset of a register of interrupter i: IMAN 0, IMOD 4, ERSTSZ 8,
/// ERSTBA 0x10, ERDP 0x18.
pub fn xhci_ir_off(c: & XhciCaps, i: i64, reg: i64) -> i64 {
    return c.rt + 0x20 + 32 * i + reg;
}

/// Doorbell register of a slot (0 = the host controller / command ring).
pub fn xhci_db_off(c: & XhciCaps, slot: i64) -> i64 {
    return c.db + 4 * slot;
}

pub fn xhci_ring_doorbell(b: & XhciBus, c: & XhciCaps, slot: i64, target: i64, stream: i64) {
    xhci_wr(b, xhci_db_off(c, slot), (target & 255) | ((stream & 0xFFFF) << 16));
}

fn xhci_wait(b: & XhciBus, off: i64, mask: i64, want: i64, spins: i64) -> bool {
    var i: i64 = 0;
    while i < spins {
        if (xhci_rd(b, off) & mask) == want {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Stop, then reset the controller: clear R/S, wait for HCHalted, set
/// HCRST, wait for HCRST and CNR to clear.
pub fn xhci_reset(b: & XhciBus, c: & XhciCaps, spins: i64) -> bool {
    var cmd: i64 = xhci_rd(b, c.op + XHCI_USBCMD);
    xhci_wr(b, c.op + XHCI_USBCMD, cmd & ~USBCMD_RS);
    if !xhci_wait(b, c.op + XHCI_USBSTS, USBSTS_HCH, USBSTS_HCH, spins) {
        return false;
    }
    xhci_wr(b, c.op + XHCI_USBCMD, USBCMD_HCRST);
    if !xhci_wait(b, c.op + XHCI_USBCMD, USBCMD_HCRST, 0, spins) {
        return false;
    }
    return xhci_wait(b, c.op + XHCI_USBSTS, USBSTS_CNR, 0, spins);
}

/// Program and start a reset controller: slots enabled, DCBAA, command
/// ring, interrupter 0 (ERSTSZ, ERDP, then ERSTBA last), interrupts on,
/// run. Returns false if the controller does not leave the halted state.
pub fn xhci_start(b: & XhciBus, c: & XhciCaps, dcbaa: i64, cmd: & XhciRing, er: & XhciEventRing, slots: i64, spins: i64) -> bool {
    var n: i64 = slots;
    if n > c.max_slots { n = c.max_slots; }
    xhci_wr(b, c.op + XHCI_CONFIG, n);
    xhci_wr64(b, c.op + XHCI_DCBAAP, dcbaa & ~63);
    xhci_wr64(b, c.op + XHCI_CRCR, xhci_crcr(cmd));
    xhci_wr(b, xhci_ir_off(c, 0, 0x08), 1);
    xhci_wr64(b, xhci_ir_off(c, 0, 0x18), xhci_event_ptr(er));
    xhci_wr64(b, xhci_ir_off(c, 0, 0x10), er.erst & ~63);
    xhci_wr(b, xhci_ir_off(c, 0, 0x04), 4000);
    // 1 ms moderation (250 ns units)
    xhci_wr(b, xhci_ir_off(c, 0, 0x00), 3);
    // IP (write 1 to clear) and IE
    xhci_wr(b, c.op + XHCI_USBCMD, USBCMD_RS | USBCMD_INTE | USBCMD_HSEE);
    return xhci_wait(b, c.op + XHCI_USBSTS, USBSTS_HCH, 0, spins);
}

// ─── Ports ──────────────────────────────────────────────────────────────

pub struct PortStatus {
    pub connected: bool,
    pub enabled: bool,
    pub powered: bool,
    pub reset: bool,
    pub speed: i64,
    pub link_state: i64,
    pub changes: i64,  // CSC..CEC bits (17..23)
}

pub fn xhci_port_decode(v: i64) -> PortStatus {
    return PortStatus {
        connected: (v & PORTSC_CCS) != 0, enabled: (v & PORTSC_PED) != 0, powered: (v & PORTSC_PP) != 0, reset: (v & PORTSC_PR) != 0, speed: (v >> 10) & 15, link_state: (v >> 5) & 15, changes: v & 0x00FE0000
    };
}

/// Value to write to PORTSC that changes nothing: RW1C bits and PED
/// cleared so the write does not acknowledge or disable anything.
pub fn xhci_portsc_preserve(v: i64) -> i64 {
    return v & ~PORTSC_RW1C;
}

/// Start a port reset (warm reset for USB 3 ports when warm).
pub fn xhci_port_reset(b: & XhciBus, c: & XhciCaps, port: i64, warm: bool) {
    var off: i64 = xhci_portsc_off(c, port);
    var v: i64 = xhci_portsc_preserve(xhci_rd(b, off));
    if warm {
        xhci_wr(b, off, v | PORTSC_WPR);
    } else {
        xhci_wr(b, off, v | PORTSC_PR);
    }
}

/// Acknowledge change bits (write 1 to the ones in `bits`).
pub fn xhci_port_ack(b: & XhciBus, c: & XhciCaps, port: i64, bits: i64) {
    var off: i64 = xhci_portsc_off(c, port);
    xhci_wr(b, off, xhci_portsc_preserve(xhci_rd(b, off)) | (bits & 0x00FE0000));
}

// ─── Extended capabilities ──────────────────────────────────────────────

pub const XECP_LEGACY: i64 = 1;
pub const XECP_PROTOCOL: i64 = 2;

/// Offsets of all extended capabilities, packed id * 2^32 + offset.
pub fn xhci_ext_caps(b: & XhciBus, c: & XhciCaps) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var off: i64 = c.xecp;
    var guard: i64 = 0;
    while off != 0 && guard < 64 {
        var w: i64 = xhci_rd(b, off);
        out.push(((w & 255) << 32) | off);
        var next: i64 = (w >> 8) & 255;
        if next == 0 {
            return out;
        }
        off = off + next * 4;
        guard = guard + 1;
    }
    return out;
}

/// BIOS -> OS handoff on the USB legacy support capability at off: set
/// the OS-owned semaphore, wait for the BIOS-owned one to clear.
pub fn xhci_legacy_handoff(b: & XhciBus, off: i64, spins: i64) -> bool {
    var w: i64 = xhci_rd(b, off);
    xhci_wr(b, off, w | (1 << 24));
    var i: i64 = 0;
    while i < spins {
        if (xhci_rd(b, off) & (1 << 16)) == 0 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub struct XhciProtocol {
    pub major: i64,
    pub minor: i64,
    pub name: str,
    pub first_port: i64,
    pub port_count: i64,
}

/// Supported protocol capability at off ("USB " 2.0 or 3.x and its ports).
pub fn xhci_protocol(b: & XhciBus, off: i64) -> XhciProtocol {
    var w0: i64 = xhci_rd(b, off);
    var name: i64 = xhci_rd(b, off + 4);
    var w2: i64 = xhci_rd(b, off + 8);
    var nb: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 4 {
        nb.push((name >> (i * 8)) & 255);
        i = i + 1;
    }
    return XhciProtocol {
        major: (w0 >> 24) & 255, minor: (w0 >> 16) & 255, name: str_from_bytes(nb), first_port: w2 & 255, port_count: (w2 >> 8) & 255
    };
}
