// Fides Stack standard library
//
// LIFO stack built on top of Vec.
// All operations are O(1) amortized.
//
// Usage:
//   use stack;
//   value s = Stack::new();
//   s.push(1);
//   s.push(2);
//   println(s.pop());  // 2
//   println(s.peek()); // 1

module stack;

use core;
use vec;

/// A LIFO stack backed by Vec.
pub struct Stack<T> {
    pub data: Vec,
}

impl Stack {
    /// Create a new empty stack.
    pub fn new() -> Stack {
        return Stack { data: Vec::new() };
    }

    /// Push a value onto the top of the stack.
    pub fn push(self: Stack, value: i64) -> void {
        val d = self.data;
        p_vec_push(d, value);
    }

    /// Pop the top value off the stack. Returns 0 if empty.
    pub fn pop(self: Stack) -> i64 {
        val d = self.data;
        if p_vec_is_empty(d) { return 0; }
        return p_vec_pop(d);
    }

    /// Peek at the top value without removing it. Returns 0 if empty.
    pub fn peek(self: Stack) -> i64 {
        val d = self.data;
        if p_vec_is_empty(d) { return 0; }
        return p_vec_last(d);
    }

    /// Check if the stack is empty.
    pub fn is_empty(self: Stack) -> bool {
        return p_vec_is_empty(self.data);
    }

    /// Get the number of elements in the stack.
    pub fn len(self: Stack) -> i64 {
        return p_vec_len(self.data);
    }

    /// Clear all elements from the stack.
    pub fn clear(self: Stack) -> void {
        p_vec_clear(self.data);
    }

    /// Check if the stack contains a value.
    pub fn contains(self: Stack, value: i64) -> bool {
        return p_vec_contains(self.data, value);
    }

    /// Get the element at a given depth from the top (0 = top).
    pub fn peek_at(self: Stack, depth: i64) -> i64 {
        val n = p_vec_len(self.data);
        if depth < 0 || depth >= n { return 0; }
        return self.data.get(n - 1 - depth);
    }

    /// Pop all elements into a Vec (top of stack = last element).
    pub fn drain(self: Stack) -> Vec {
        val result = Vec::new();
        while p_vec_is_empty(self.data) == 0 {
            result.push(p_vec_pop(self.data));
        }
        return result;
    }

    /// Create a stack from a Vec (last element becomes top).
    pub fn from_vec(v: Vec) -> Stack {
        return Stack { data: v };
    }

    /// Convert the stack to a Vec (top of stack = last element).
    pub fn to_vec(self: Stack) -> Vec {
        val result = Vec::new();
        var i = 0;
        while i < p_vec_len(self.data) {
            result.push(self.data.get(i));
            i = i + 1;
        }
        return result;
    }
}
