// A PostgreSQL connection (module postgres) as a `Database` (module db), so
// code written against the capability (query_one, insert, create_table,
// ...) runs on PostgreSQL as on MemoryDB or SQLite.
//
//   query(sql) -> the rows as a JSON array of objects ("[]" on an error:
//                 use pg_query for the error itself);
//   exec(sql)  -> the rows the statement changed, -1 on an error;
//   close()    -> Terminate, then the socket is closed.
//
// Usage:
//   use postgres; use postgres_db; use db;
//   val c: PgConn = pg_connect("127.0.0.1", 5432, "app", "secret", "appdb");
//   println(query_one(c, "SELECT 1 AS one"));     // {"one":1}

module postgres_db;
 use db; use postgres;

impl Database for PgConn {
    pub fn query (self: PgConn, sql: str) -> str {
        val r: PgResult = pg_query(& self, sql);
        return r.rows;
    }

    pub fn exec(self: PgConn, sql: str) -> i64 {
        return pg_exec(& self, sql);
    }

    pub fn close(self: PgConn) {
        var c: PgConn = self;
        pg_close(& mut c);
    }
}
