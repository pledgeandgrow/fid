// Fides signature matching: YARA-like rules over byte buffers, pure Fides
//
// A rule file holds rules in a small subset of YARA's syntax:
//
//   rule MZ_with_marker : pe demo {
//       meta:
//           author = "x"   score = 5   ok = true      (kept, not evaluated)
//       strings:
//           $mz   = { 4D 5A ?? 00 [2-4] 50 45 }        // hex pattern
//           $alt  = { 6A ( 40 | 41 42 ) 6? }           // alternatives, nibbles
//           $txt  = "This program" nocase              // text string
//           $w    = "kernel32" wide ascii fullword
//           $re   = /[A-Z]{3}-[0-9]+/                  // stdlib regex
//       condition:
//           $mz at 0 and (any of ($t*, $w) or #re >= 2) and filesize < 1MB
//   }
//
// Strings: text "..." (escapes \" \\ \n \r \t \xHH) with the modifiers
// nocase (ASCII case folding), wide (UTF-16LE: each byte followed by 0),
// ascii (also search the plain form when wide is given), fullword (the
// match is not preceded or followed by a letter, digit or '_'); hex
// patterns { } with bytes, ?? and nibble wildcards (4? ?A), jumps [n]
// [n-m] [n-] [-] (an open jump spans at most the rest of the buffer), and
// alternatives ( AA BB | CC ) of byte/wildcard sequences; regular
// expressions /.../ run by the stdlib regex engine (module regex: classes,
// quantifiers, alternation, anchors; no modifiers). A buffer is searched
// as text for regexes (one character per byte, NUL bytes included).
//
// Conditions: and, or, not, parentheses, true, false; `$a` (found),
// `$a at N`, `$a in (N..M)`, `#a <op> N` (number of matches), `@a[i] <op>
// N` (offset of the i-th match, from 1), `filesize <op> N` with <op> one
// of == != < <= > >=; `all of them`, `any of them`, `none of them`, `N of
// them`, and the same with a set `($a, $b*)` where `$b*` names every
// string starting with $b. Numbers are decimal or 0x hex, with an optional
// KB or MB suffix. Comments are // and /* */.
//
// Everything here is real; there is no platform seam (read files with the
// file module and pass the bytes).
//
// Usage:
//   val rs: SigRules = sig_compile(text);
//   if !rs.ok { println(rs.error); }
//   val hits: Vec<SigHit> = sig_scan(& rs, bytes);   // the rules that matched

module sigmatch;
use vec;
use regex;

/// One element of a compiled hex pattern: a byte under a mask (kind 0), a
/// jump of min..max bytes (kind 1), or alternatives (kind 2): each
/// alternative a Vec of (value | mask << 8) entries.
pub struct SigHexEl {
    pub kind: i64,
    pub value: i64,
    pub mask: i64,
    pub min: i64,
    pub max: i64,
    pub alts: Vec<Vec<i64>>,
}

/// A string definition. kind: 0 text, 1 hex, 2 regex.
pub struct SigString {
    pub id: str,
    pub kind: i64,
    pub text: Vec<i64>,
    pub hex: Vec<SigHexEl>,
    pub regex: str,
    pub nocase: bool,
    pub wide: bool,
    pub ascii: bool,
    pub fullword: bool,
}

/// A node of a condition tree (kept in the rule's arena `cond`).
/// kind: 0 true, 1 false, 2 and(a,b), 3 or(a,b), 4 not(a), 5 found(id),
/// 6 at(id, n), 7 in(id, lo, hi), 8 count(id) op n, 9 offset(id, idx) op n,
/// 10 filesize op n, 11 quantified: n (-1 all, -2 any, -3 none) of ids.
pub struct SigCond {
    pub kind: i64,
    pub a: i64,
    pub b: i64,
    pub id: str,
    pub ids: Vec<str>,
    pub op: str,
    pub n: i64,
    pub lo: i64,
    pub hi: i64,
}

pub struct SigRule {
    pub name: str,
    pub tags: Vec<str>,
    pub meta_keys: Vec<str>,
    pub meta_vals: Vec<str>,
    pub strings: Vec<SigString>,
    pub cond: Vec<SigCond>,
    pub root: i64,
}

pub struct SigRules {
    pub ok: bool,
    pub error: str,
    pub rules: Vec<SigRule>,
}

/// The matches of one string: start offsets and lengths, in order.
pub struct SigStrMatch {
    pub id: str,
    pub offsets: Vec<i64>,
    pub lengths: Vec<i64>,
}

/// A rule that matched, with the strings that were found.
pub struct SigHit {
    pub rule: str,
    pub tags: Vec<str>,
    pub strings: Vec<SigStrMatch>,
}

// ─── parser ─────────────────────────────────────────────────────────────

struct SgP {
    s: str,
    i: i64,
    err: str,
}

fn sg_c(p: &SgP) -> i64 {
    if p.i < str_len(p.s) {
        return str_byte_at(p.s, p.i);
    }
    return 0;
}

fn sg_at(p: &SgP, k: i64) -> i64 {
    if p.i + k < str_len(p.s) {
        return str_byte_at(p.s, p.i + k);
    }
    return 0;
}

fn sg_fail(p: &mut SgP, msg: str) {
    if str_len(p.err) == 0 {
        // the line of the error
        var line: i64 = 1;
        var k: i64 = 0;
        while k < p.i && k < str_len(p.s) {
            if str_byte_at(p.s, k) == 10 {
                line = line + 1;
            }
            k = k + 1;
        }
        p.err = "line " + int_to_str(line) + ": " + msg;
    }
    p.i = str_len(p.s);
}

fn sg_ws(p: &mut SgP) {
    while p.i < str_len(p.s) {
        val c: i64 = sg_c(p);
        if c == 32 || c == 9 || c == 10 || c == 13 {
            p.i = p.i + 1;
        } else if c == 47 && sg_at(p, 1) == 47 {
            while p.i < str_len(p.s) && sg_c(p) != 10 {
                p.i = p.i + 1;
            }
        } else if c == 47 && sg_at(p, 1) == 42 {
            p.i = p.i + 2;
            while p.i < str_len(p.s) && !(sg_c(p) == 42 && sg_at(p, 1) == 47) {
                p.i = p.i + 1;
            }
            p.i = p.i + 2;
        } else {
            return;
        }
    }
}

fn sg_is_id(c: i64) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
}

fn sg_word(p: &mut SgP) -> str {
    sg_ws(p);
    val st: i64 = p.i;
    while p.i < str_len(p.s) && sg_is_id(sg_c(p)) {
        p.i = p.i + 1;
    }
    return str_slice(p.s, st, p.i);
}

fn sg_peek_word(p: &mut SgP) -> str {
    sg_ws(p);
    val save: i64 = p.i;
    val w: str = sg_word(p);
    p.i = save;
    return w;
}

fn sg_expect(p: &mut SgP, c: i64) {
    sg_ws(p);
    if sg_c(p) != c {
        sg_fail(p, "expected '" + char_to_str(c) + "'");
        return;
    }
    p.i = p.i + 1;
}

fn sg_hexdig(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    return -1;
}

/// A number: decimal or 0x hex, optional KB / MB suffix; -1 when absent.
fn sg_number(p: &mut SgP) -> i64 {
    sg_ws(p);
    var v: i64 = 0;
    var any: bool = false;
    if sg_c(p) == 48 && (sg_at(p, 1) == 120 || sg_at(p, 1) == 88) {
        p.i = p.i + 2;
        while sg_hexdig(sg_c(p)) >= 0 {
            v = v * 16 + sg_hexdig(sg_c(p));
            p.i = p.i + 1;
            any = true;
        }
    } else {
        while sg_c(p) >= 48 && sg_c(p) <= 57 {
            v = v * 10 + (sg_c(p) - 48);
            p.i = p.i + 1;
            any = true;
        }
    }
    if !any {
        sg_fail(p, "expected a number");
        return -1;
    }
    if sg_c(p) == 75 && sg_at(p, 1) == 66 {
        v = v * 1024;
        p.i = p.i + 2;
    } else if sg_c(p) == 77 && sg_at(p, 1) == 66 {
        v = v * 1048576;
        p.i = p.i + 2;
    }
    return v;
}

fn sg_quoted(p: &mut SgP) -> Vec<i64> {
    // at '"'
    var out: Vec<i64> = Vec::new();
    p.i = p.i + 1;
    while p.i < str_len(p.s) && sg_c(p) != 34 {
        var c: i64 = sg_c(p);
        if c == 10 {
            sg_fail(p, "unterminated string");
            return out;
        }
        if c == 92 {
            val e: i64 = sg_at(p, 1);
            p.i = p.i + 2;
            if e == 110 {
                out.push(10);
            } else if e == 114 {
                out.push(13);
            } else if e == 116 {
                out.push(9);
            } else if e == 120 {
                val h1: i64 = sg_hexdig(sg_c(p));
                val h2: i64 = sg_hexdig(sg_at(p, 1));
                if h1 < 0 || h2 < 0 {
                    sg_fail(p, "bad \\x escape");
                    return out;
                }
                out.push(h1 * 16 + h2);
                p.i = p.i + 2;
            } else {
                out.push(e);
            }
        } else {
            out.push(c);
            p.i = p.i + 1;
        }
    }
    if sg_c(p) != 34 {
        sg_fail(p, "unterminated string");
        return out;
    }
    p.i = p.i + 1;
    return out;
}

fn sg_hex_el(kind: i64, value: i64, mask: i64, min: i64, max: i64) -> SigHexEl {
    return SigHexEl {
        kind: kind, value: value, mask: mask, min: min, max: max, alts: Vec::new()
    };
}

/// One byte token (two hex digits or ?) at p; value | mask << 8, -1 on error.
fn sg_hex_byte(p: &mut SgP) -> i64 {
    val c1: i64 = sg_c(p);
    val c2: i64 = sg_at(p, 1);
    var v: i64 = 0;
    var m: i64 = 0;
    if c1 == 63 {
        m = 0;
    } else if sg_hexdig(c1) >= 0 {
        v = sg_hexdig(c1) << 4;
        m = 0xF0;
    } else {
        return -1;
    }
    if c2 == 63 {
        m = m | 0;
    } else if sg_hexdig(c2) >= 0 {
        v = v | sg_hexdig(c2);
        m = m | 0x0F;
    } else {
        return -1;
    }
    p.i = p.i + 2;
    return v | (m << 8);
}

fn sg_parse_hex(p: &mut SgP) -> Vec<SigHexEl> {
    // at '{'
    var els: Vec<SigHexEl> = Vec::new();
    p.i = p.i + 1;
    while true {
        sg_ws(p);
        val c: i64 = sg_c(p);
        if c == 125 {
            p.i = p.i + 1;
            if els.len() == 0 {
                sg_fail(p, "empty hex string");
            }
            return els;
        }
        if c == 0 {
            sg_fail(p, "unterminated hex string");
            return els;
        }
        if c == 91 {
            p.i = p.i + 1;
            sg_ws(p);
            var lo: i64 = 0;
            var hi: i64 = -1;
            if sg_c(p) != 45 {
                lo = sg_number(p);
            }
            sg_ws(p);
            if sg_c(p) == 45 {
                p.i = p.i + 1;
                sg_ws(p);
                if sg_c(p) != 93 {
                    hi = sg_number(p);
                }
            } else {
                hi = lo;
            }
            sg_expect(p, 93);
            if hi >= 0 && hi < lo {
                sg_fail(p, "jump with max < min");
            }
            els.push(sg_hex_el(1, 0, 0, lo, hi));
        } else if c == 40 {
            p.i = p.i + 1;
            var e: SigHexEl = sg_hex_el(2, 0, 0, 0, 0);
            var cur: Vec<i64> = Vec::new();
            while true {
                sg_ws(p);
                val d: i64 = sg_c(p);
                if d == 124 || d == 41 {
                    if cur.len() == 0 {
                        sg_fail(p, "empty alternative");
                        return els;
                    }
                    e.alts.push(cur);
                    cur = Vec::new();
                    p.i = p.i + 1;
                    if d == 41 {
                        break;
                    }
                } else {
                    val bm: i64 = sg_hex_byte(p);
                    if bm < 0 {
                        sg_fail(p, "bad byte in alternative");
                        return els;
                    }
                    cur.push(bm);
                }
            }
            els.push(e);
        } else {
            val bm: i64 = sg_hex_byte(p);
            if bm < 0 {
                sg_fail(p, "bad hex token");
                return els;
            }
            els.push(sg_hex_el(0, bm & 255, (bm >> 8) & 255, 0, 0));
        }
    }
    return els;
}

fn sg_parse_regex(p: &mut SgP) -> str {
    // at '/': up to the next unescaped '/'
    p.i = p.i + 1;
    val st: i64 = p.i;
    while p.i < str_len(p.s) && sg_c(p) != 47 {
        if sg_c(p) == 92 {
            p.i = p.i + 1;
        }
        if sg_c(p) == 10 {
            sg_fail(p, "unterminated regex");
            return "";
        }
        p.i = p.i + 1;
    }
    if sg_c(p) != 47 {
        sg_fail(p, "unterminated regex");
        return "";
    }
    val re: str = str_slice(p.s, st, p.i);
    p.i = p.i + 1;
    return re;
}

fn sg_string_def(p: &mut SgP) -> SigString {
    // at '$'
    p.i = p.i + 1;
    val id: str = "$" + sg_word(p);
    var s: SigString = SigString {
        id: id, kind: 0, text: Vec::new(), hex: Vec::new(), regex: "", nocase: false, wide: false, ascii: false, fullword: false
    };
    sg_expect(p, 61);
    sg_ws(p);
    val c: i64 = sg_c(p);
    if c == 34 {
        s.text = sg_quoted(p);
        if s.text.len() == 0 && str_len(p.err) == 0 {
            sg_fail(p, "empty string " + id);
        }
    } else if c == 123 {
        s.kind = 1;
        s.hex = sg_parse_hex(p);
    } else if c == 47 {
        s.kind = 2;
        s.regex = sg_parse_regex(p);
    } else {
        sg_fail(p, "expected a string, hex string or regex for " + id);
        return s;
    }
    // modifiers
    while true {
        val w: str = sg_peek_word(p);
        if w == "nocase" {
            s.nocase = true;
        } else if w == "wide" {
            s.wide = true;
        } else if w == "ascii" {
            s.ascii = true;
        } else if w == "fullword" {
            s.fullword = true;
        } else {
            break;
        }
        sg_word(p);
    }
    if s.kind != 0 && (s.nocase || s.wide || s.ascii || s.fullword) {
        sg_fail(p, "modifiers apply to text strings only (" + id + ")");
    }
    return s;
}

fn sg_node(kind: i64) -> SigCond {
    return SigCond {
        kind: kind, a: -1, b: -1, id: "", ids: Vec::new(), op: "", n: 0, lo: 0, hi: 0
    };
}

fn sg_push(r: &mut SigRule, c: SigCond) -> i64 {
    r.cond.push(c);
    return r.cond.len() - 1;
}

fn sg_op(p: &mut SgP) -> str {
    sg_ws(p);
    val c: i64 = sg_c(p);
    val d: i64 = sg_at(p, 1);
    if (c == 61 || c == 33 || c == 60 || c == 62) && d == 61 {
        p.i = p.i + 2;
        return char_to_str(c) + "=";
    }
    if c == 60 || c == 62 {
        p.i = p.i + 1;
        return char_to_str(c);
    }
    sg_fail(p, "expected a comparison");
    return "";
}

fn sg_id_exists(r: &SigRule, id: str) -> bool {
    var i: i64 = 0;
    while i < r.strings.len() {
        if r.strings.get(i).id == id {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn sg_ref(p: &mut SgP, r: &SigRule) -> str {
    // after the sigil; the id with a '$' (names are checked here)
    val id: str = "$" + sg_word(p);
    if !sg_id_exists(r, id) {
        sg_fail(p, "unknown string " + id);
    }
    return id;
}

fn sg_set(p: &mut SgP, r: &SigRule) -> Vec<str> {
    // "them" or ( $a, $b* )
    var ids: Vec<str> = Vec::new();
    if sg_peek_word(p) == "them" {
        sg_word(p);
        var i: i64 = 0;
        while i < r.strings.len() {
            ids.push(r.strings.get(i).id);
            i = i + 1;
        }
        return ids;
    }
    sg_expect(p, 40);
    while str_len(p.err) == 0 {
        sg_expect(p, 36);
        val name: str = "$" + sg_word(p);
        if sg_c(p) == 42 {
            p.i = p.i + 1;
            var i: i64 = 0;
            var any: bool = false;
            while i < r.strings.len() {
                if str_starts_with(r.strings.get(i).id, name) {
                    ids.push(r.strings.get(i).id);
                    any = true;
                }
                i = i + 1;
            }
            if !any {
                sg_fail(p, "no string matches " + name + "*");
            }
        } else {
            if !sg_id_exists(r, name) {
                sg_fail(p, "unknown string " + name);
            }
            ids.push(name);
        }
        sg_ws(p);
        if sg_c(p) == 44 {
            p.i = p.i + 1;
        } else {
            break;
        }
    }
    sg_expect(p, 41);
    return ids;
}

fn sg_primary(p: &mut SgP, r: &mut SigRule) -> i64 {
    sg_ws(p);
    val c: i64 = sg_c(p);
    if c == 40 {
        p.i = p.i + 1;
        val e: i64 = sg_or(p, r);
        sg_expect(p, 41);
        return e;
    }
    if c == 36 {
        p.i = p.i + 1;
        val id: str = sg_ref(p, r);
        val w: str = sg_peek_word(p);
        if w == "at" {
            sg_word(p);
            var n: SigCond = sg_node(6);
            n.id = id;
            n.n = sg_number(p);
            return sg_push(r, n);
        }
        if w == "in" {
            sg_word(p);
            var n: SigCond = sg_node(7);
            n.id = id;
            sg_expect(p, 40);
            n.lo = sg_number(p);
            sg_expect(p, 46);
            sg_expect(p, 46);
            n.hi = sg_number(p);
            sg_expect(p, 41);
            return sg_push(r, n);
        }
        var n: SigCond = sg_node(5);
        n.id = id;
        return sg_push(r, n);
    }
    if c == 35 {
        p.i = p.i + 1;
        var n: SigCond = sg_node(8);
        n.id = sg_ref(p, r);
        n.op = sg_op(p);
        n.n = sg_number(p);
        return sg_push(r, n);
    }
    if c == 64 {
        p.i = p.i + 1;
        var n: SigCond = sg_node(9);
        n.id = sg_ref(p, r);
        n.lo = 1;
        sg_ws(p);
        if sg_c(p) == 91 {
            p.i = p.i + 1;
            n.lo = sg_number(p);
            sg_expect(p, 93);
        }
        n.op = sg_op(p);
        n.n = sg_number(p);
        return sg_push(r, n);
    }
    if c >= 48 && c <= 57 {
        var n: SigCond = sg_node(11);
        n.n = sg_number(p);
        if sg_word(p) != "of" {
            sg_fail(p, "expected 'of'");
        }
        n.ids = sg_set(p, r);
        return sg_push(r, n);
    }
    val w: str = sg_word(p);
    if w == "true" {
        return sg_push(r, sg_node(0));
    }
    if w == "false" {
        return sg_push(r, sg_node(1));
    }
    if w == "filesize" {
        var n: SigCond = sg_node(10);
        n.op = sg_op(p);
        n.n = sg_number(p);
        return sg_push(r, n);
    }
    if w == "all" || w == "any" || w == "none" {
        var n: SigCond = sg_node(11);
        if w == "all" {
            n.n = -1;
        }
        if w == "any" {
            n.n = -2;
        }
        if w == "none" {
            n.n = -3;
        }
        if sg_word(p) != "of" {
            sg_fail(p, "expected 'of'");
        }
        n.ids = sg_set(p, r);
        return sg_push(r, n);
    }
    if str_len(w) > 0 {
        sg_fail(p, "unexpected '" + w + "' in condition");
    } else if c == 0 {
        sg_fail(p, "unexpected end of condition");
    } else {
        sg_fail(p, "unexpected '" + char_to_str(c) + "' in condition");
    }
    return -1;
}

fn sg_not(p: &mut SgP, r: &mut SigRule) -> i64 {
    if sg_peek_word(p) == "not" {
        sg_word(p);
        var n: SigCond = sg_node(4);
        n.a = sg_not(p, r);
        return sg_push(r, n);
    }
    return sg_primary(p, r);
}

fn sg_and(p: &mut SgP, r: &mut SigRule) -> i64 {
    var left: i64 = sg_not(p, r);
    while str_len(p.err) == 0 && sg_peek_word(p) == "and" {
        sg_word(p);
        var n: SigCond = sg_node(2);
        n.a = left;
        n.b = sg_not(p, r);
        left = sg_push(r, n);
    }
    return left;
}

fn sg_or(p: &mut SgP, r: &mut SigRule) -> i64 {
    var left: i64 = sg_and(p, r);
    while str_len(p.err) == 0 && sg_peek_word(p) == "or" {
        sg_word(p);
        var n: SigCond = sg_node(3);
        n.a = left;
        n.b = sg_and(p, r);
        left = sg_push(r, n);
    }
    return left;
}

fn sg_rule(p: &mut SgP) -> SigRule {
    var r: SigRule = SigRule {
        name: "", tags: Vec::new(), meta_keys: Vec::new(), meta_vals: Vec::new(), strings: Vec::new(), cond: Vec::new(), root: -1
    };
    r.name = sg_word(p);
    if str_len(r.name) == 0 {
        sg_fail(p, "rule without a name");
        return r;
    }
    sg_ws(p);
    if sg_c(p) == 58 {
        p.i = p.i + 1;
        while str_len(sg_peek_word(p)) > 0 {
            r.tags.push(sg_word(p));
        }
    }
    sg_expect(p, 123);
    while str_len(p.err) == 0 {
        sg_ws(p);
        if sg_c(p) == 125 {
            p.i = p.i + 1;
            break;
        }
        val sec: str = sg_word(p);
        sg_expect(p, 58);
        if sec == "meta" {
            while str_len(p.err) == 0 {
                val k: str = sg_peek_word(p);
                if str_len(k) == 0 || k == "strings" || k == "condition" {
                    break;
                }
                sg_word(p);
                sg_expect(p, 61);
                sg_ws(p);
                if sg_c(p) == 34 {
                    r.meta_vals.push(str_from_bytes(sg_quoted(p)));
                } else if sg_c(p) >= 48 && sg_c(p) <= 57 {
                    r.meta_vals.push(int_to_str(sg_number(p)));
                } else {
                    r.meta_vals.push(sg_word(p));
                }
                r.meta_keys.push(k);
            }
        } else if sec == "strings" {
            sg_ws(p);
            while str_len(p.err) == 0 && sg_c(p) == 36 {
                val s: SigString = sg_string_def(p);
                if sg_id_exists(&r, s.id) {
                    sg_fail(p, "duplicate string " + s.id);
                }
                r.strings.push(s);
                sg_ws(p);
            }
        } else if sec == "condition" {
            val root: i64 = sg_or(p, &mut r);
            r.root = root;
            sg_ws(p);
            if sg_c(p) != 125 {
                sg_fail(p, "expected '}' after the condition");
            }
        } else {
            sg_fail(p, "unknown section '" + sec + "'");
        }
    }
    if str_len(p.err) == 0 && r.root < 0 {
        sg_fail(p, "rule " + r.name + " has no condition");
    }
    return r;
}

/// Compile a rule file.
pub fn sig_compile(text: str) -> SigRules {
    var p: SgP = SgP {
        s: text, i: 0, err: ""
    };
    var out: SigRules = SigRules {
        ok: true, error: "", rules: Vec::new()
    };
    while true {
        sg_ws(&mut p);
        if p.i >= str_len(p.s) {
            break;
        }
        if sg_word(&mut p) != "rule" {
            sg_fail(&mut p, "expected 'rule'");
            break;
        }
        val r: SigRule = sg_rule(&mut p);
        if str_len(p.err) > 0 {
            break;
        }
        out.rules.push(r);
    }
    if str_len(p.err) > 0 {
        out.ok = false;
        out.error = p.err;
    }
    return out;
}

// ─── matching ───────────────────────────────────────────────────────────

fn sg_lower(c: i64) -> i64 {
    if c >= 65 && c <= 90 {
        return c + 32;
    }
    return c;
}

fn sg_wordch(b: &Vec<i64>, i: i64) -> bool {
    if i < 0 || i >= b.len() {
        return false;
    }
    return sg_is_id(b.get(i) & 255);
}

fn sg_find_text(b: &Vec<i64>, pat: &Vec<i64>, nocase: bool, fullword: bool, m: &mut SigStrMatch) {
    val n: i64 = pat.len();
    var i: i64 = 0;
    while i + n <= b.len() {
        var j: i64 = 0;
        while j < n {
            var x: i64 = b.get(i + j) & 255;
            var y: i64 = pat.get(j) & 255;
            if nocase {
                x = sg_lower(x);
                y = sg_lower(y);
            }
            if x != y {
                break;
            }
            j = j + 1;
        }
        if j == n && (!fullword || (!sg_wordch(b, i - 1) && !sg_wordch(b, i + n))) {
            m.offsets.push(i);
            m.lengths.push(n);
        }
        i = i + 1;
    }
}

fn sg_hex_at(b: &Vec<i64>, els: &Vec<SigHexEl>, k: i64, pos: i64) -> i64 {
    // the end of a match of els[k..] starting at pos, or -1 (shortest jumps first)
    if k >= els.len() {
        return pos;
    }
    val e: SigHexEl = els.get(k);
    if e.kind == 0 {
        if pos >= b.len() || ((b.get(pos) & 255) & e.mask) != e.value {
            return -1;
        }
        return sg_hex_at(b, els, k + 1, pos + 1);
    }
    if e.kind == 1 {
        var hi: i64 = e.max;
        if hi < 0 || pos + hi > b.len() {
            hi = b.len() - pos;
        }
        var j: i64 = e.min;
        while j <= hi {
            val r: i64 = sg_hex_at(b, els, k + 1, pos + j);
            if r >= 0 {
                return r;
            }
            j = j + 1;
        }
        return -1;
    }
    var a: i64 = 0;
    while a < e.alts.len() {
        val alt: Vec<i64> = e.alts.get(a);
        var ok: bool = pos + alt.len() <= b.len();
        var j: i64 = 0;
        while ok && j < alt.len() {
            val bm: i64 = alt.get(j);
            if ((b.get(pos + j) & 255) & ((bm >> 8) & 255)) != (bm & 255) {
                ok = false;
            }
            j = j + 1;
        }
        if ok {
            val r: i64 = sg_hex_at(b, els, k + 1, pos + alt.len());
            if r >= 0 {
                return r;
            }
        }
        a = a + 1;
    }
    return -1;
}

fn sg_find_regex(b: &Vec<i64>, re: str, m: &mut SigStrMatch) {
    val s: str = str_from_bytes(b);
    var from: i64 = 0;
    while from <= str_len(s) {
        val sp: Vec<i64> = regex_capture_spans_from(s, re, from);
        if sp.len() < 2 || sp.get(0) < 0 {
            return;
        }
        m.offsets.push(sp.get(0));
        m.lengths.push(sp.get(1) - sp.get(0));
        if sp.get(1) > sp.get(0) {
            from = sp.get(1);
        } else {
            from = sp.get(0) + 1;
        }
    }
}

fn sg_widen(t: &Vec<i64>) -> Vec<i64> {
    var w: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < t.len() {
        w.push(t.get(i));
        w.push(0);
        i = i + 1;
    }
    return w;
}

/// Every match of one string in `b`.
pub fn sig_find(s: &SigString, b: &Vec<i64>) -> SigStrMatch {
    var m: SigStrMatch = SigStrMatch {
        id: s.id, offsets: Vec::new(), lengths: Vec::new()
    };
    if s.kind == 0 {
        if !s.wide || s.ascii {
            sg_find_text(b, &s.text, s.nocase, s.fullword, &mut m);
        }
        if s.wide {
            val w: Vec<i64> = sg_widen(&s.text);
            sg_find_text(b, &w, s.nocase, s.fullword, &mut m);
        }
    } else if s.kind == 1 {
        var i: i64 = 0;
        while i < b.len() {
            val e: i64 = sg_hex_at(b, &s.hex, 0, i);
            if e >= 0 {
                m.offsets.push(i);
                m.lengths.push(e - i);
            }
            i = i + 1;
        }
    } else {
        sg_find_regex(b, s.regex, &mut m);
    }
    return m;
}

fn sg_cmp(x: i64, op: str, y: i64) -> bool {
    if op == "==" {
        return x == y;
    }
    if op == "!=" {
        return x != y;
    }
    if op == "<" {
        return x < y;
    }
    if op == "<=" {
        return x <= y;
    }
    if op == ">" {
        return x > y;
    }
    return x >= y;
}

fn sg_matches_of(ms: &Vec<SigStrMatch>, id: str) -> SigStrMatch {
    var i: i64 = 0;
    while i < ms.len() {
        if ms.get(i).id == id {
            return ms.get(i);
        }
        i = i + 1;
    }
    return SigStrMatch {
        id: id, offsets: Vec::new(), lengths: Vec::new()
    };
}

fn sg_eval(r: &SigRule, k: i64, ms: &Vec<SigStrMatch>, size: i64) -> bool {
    val c: SigCond = r.cond.get(k);
    if c.kind == 0 {
        return true;
    }
    if c.kind == 1 {
        return false;
    }
    if c.kind == 2 {
        return sg_eval(r, c.a, ms, size) && sg_eval(r, c.b, ms, size);
    }
    if c.kind == 3 {
        return sg_eval(r, c.a, ms, size) || sg_eval(r, c.b, ms, size);
    }
    if c.kind == 4 {
        return !sg_eval(r, c.a, ms, size);
    }
    if c.kind == 10 {
        return sg_cmp(size, c.op, c.n);
    }
    if c.kind == 11 {
        var found: i64 = 0;
        var i: i64 = 0;
        while i < c.ids.len() {
            if sg_matches_of(ms, c.ids.get(i)).offsets.len() > 0 {
                found = found + 1;
            }
            i = i + 1;
        }
        if c.n == -1 {
            return found == c.ids.len();
        }
        if c.n == -2 {
            return found > 0;
        }
        if c.n == -3 {
            return found == 0;
        }
        return found >= c.n;
    }
    val m: SigStrMatch = sg_matches_of(ms, c.id);
    if c.kind == 5 {
        return m.offsets.len() > 0;
    }
    if c.kind == 8 {
        return sg_cmp(m.offsets.len(), c.op, c.n);
    }
    if c.kind == 9 {
        if c.lo < 1 || c.lo > m.offsets.len() {
            return false;
        }
        return sg_cmp(m.offsets.get(c.lo - 1), c.op, c.n);
    }
    var i: i64 = 0;
    while i < m.offsets.len() {
        val o: i64 = m.offsets.get(i);
        if c.kind == 6 && o == c.n {
            return true;
        }
        if c.kind == 7 && o >= c.lo && o <= c.hi {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Whether one rule's condition holds over `b`.
pub fn sig_rule_matches(r: &SigRule, b: &Vec<i64>) -> bool {
    var ms: Vec<SigStrMatch> = Vec::new();
    var i: i64 = 0;
    while i < r.strings.len() {
        ms.push(sig_find(&r.strings.get(i), b));
        i = i + 1;
    }
    return sg_eval(r, r.root, &ms, b.len());
}

/// Every rule whose condition holds over `b`, with its found strings.
pub fn sig_scan(rs: &SigRules, b: Vec<i64>) -> Vec<SigHit> {
    var hits: Vec<SigHit> = Vec::new();
    var k: i64 = 0;
    while k < rs.rules.len() {
        val r: SigRule = rs.rules.get(k);
        var ms: Vec<SigStrMatch> = Vec::new();
        var i: i64 = 0;
        while i < r.strings.len() {
            ms.push(sig_find(&r.strings.get(i), &b));
            i = i + 1;
        }
        if sg_eval(&r, r.root, &ms, b.len()) {
            var found: Vec<SigStrMatch> = Vec::new();
            i = 0;
            while i < ms.len() {
                if ms.get(i).offsets.len() > 0 {
                    found.push(ms.get(i));
                }
                i = i + 1;
            }
            hits.push(SigHit {
                rule: r.name, tags: r.tags, strings: found
            });
        }
        k = k + 1;
    }
    return hits;
}

/// Scan text (its bytes).
pub fn sig_scan_str(rs: &SigRules, s: str) -> Vec<SigHit> {
    return sig_scan(rs, str_bytes(s));
}

/// The names of the rules that matched.
pub fn sig_hit_names(hits: &Vec<SigHit>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < hits.len() {
        out.push(hits.get(i).rule);
        i = i + 1;
    }
    return out;
}
