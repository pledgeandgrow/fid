/// Cell x of bit i (0 = most significant) in the 8x8 grid.
pub fn atag36h11_bit_x() -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(5);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(3);
    v.push(6);
    v.push(6);
    v.push(6);
    v.push(6);
    v.push(6);
    v.push(5);
    v.push(5);
    v.push(5);
    v.push(4);
    v.push(6);
    v.push(5);
    v.push(4);
    v.push(3);
    v.push(2);
    v.push(5);
    v.push(4);
    v.push(3);
    v.push(4);
    v.push(1);
    v.push(1);
    v.push(1);
    v.push(1);
    v.push(1);
    v.push(2);
    v.push(2);
    v.push(2);
    v.push(3);
    return v;
}

/// Cell y of bit i in the 8x8 grid.
pub fn atag36h11_bit_y() -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(1);
    v.push(1);
    v.push(1);
    v.push(1);
    v.push(2);
    v.push(2);
    v.push(2);
    v.push(3);
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(5);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(3);
    v.push(6);
    v.push(6);
    v.push(6);
    v.push(6);
    v.push(6);
    v.push(5);
    v.push(5);
    v.push(5);
    v.push(4);
    v.push(6);
    v.push(5);
    v.push(4);
    v.push(3);
    v.push(2);
    v.push(5);
    v.push(4);
    v.push(3);
    v.push(4);
    return v;
}

/// Bits that differ between two 36-bit codes.
pub fn atag_hamming(a: i64, b: i64) -> i64 {
    var x: i64 = (a ^ b) & 68719476735;
    var n: i64 = 0;
    while x != 0 {
        x = x & (x - 1);
        n = n + 1;
    }
    return n;
}

/// The code of the tag turned 90 degrees (cell (x, y) -> (7 - y, x)).
pub fn atag_rotate_code(code: i64) -> i64 {
    val bx: Vec<i64> = atag36h11_bit_x();
    val by: Vec<i64> = atag36h11_bit_y();
    var out: i64 = 0;
    var i: i64 = 0;
    while i < 36 {
        if ((code >> (35 - i)) & 1) == 1 {
            val nx: i64 = 7 - by.get(i);
            val ny: i64 = bx.get(i);
            var j: i64 = 0;
            while j < 36 {
                if bx.get(j) == nx && by.get(j) == ny {
                    out = out | (1 << (35 - j));
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

/// The table entry nearest to a code: [id, hamming distance].
pub fn atag_lookup(code: i64) -> Vec<i64> {
    val t: Vec<i64> = atag36h11_codes();
    var best: i64 = -1;
    var bd: i64 = 99;
    var i: i64 = 0;
    while i < t.len() {
        val d: i64 = atag_hamming(code, t.get(i));
        if d < bd {
            bd = d;
            best = i;
        }
        i = i + 1;
    }
    var out: Vec<i64> = Vec::new();
    out.push(best);
    out.push(bd);
    return out;
}

/// The color (0 black, 255 white) of cell (cx, cy), 0..9, of tag `id`
/// (10 x 10 cells including the white border).
pub fn atag_cell(id: i64, cx: i64, cy: i64) -> i64 {
    if cx <= 0 || cy <= 0 || cx >= 9 || cy >= 9 {
        return 255;
    }
    if cx == 1 || cy == 1 || cx == 8 || cy == 8 {
        return 0;
    }
    val code: i64 = atag36h11_codes().get(id);
    val bx: Vec<i64> = atag36h11_bit_x();
    val by: Vec<i64> = atag36h11_bit_y();
    var i: i64 = 0;
    while i < 36 {
        if bx.get(i) + 1 == cx && by.get(i) + 1 == cy {
            if ((code >> (35 - i)) & 1) == 1 {
                return 255;
            }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

/// All 100 cells of tag `id`, row by row (0 black, 255 white).
pub fn atag_cells(id: i64) -> Vec<i64> {
    var cells: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 100 {
        val x: i64 = i % 10;
        val y: i64 = i / 10;
        if x == 0 || y == 0 || x == 9 || y == 9 {
            cells.push(255);
        } else {
            cells.push(0);
        }
        i = i + 1;
    }
    val code: i64 = atag36h11_codes().get(id);
    val bx: Vec<i64> = atag36h11_bit_x();
    val by: Vec<i64> = atag36h11_bit_y();
    i = 0;
    while i < 36 {
        if ((code >> (35 - i)) & 1) == 1 {
            cells.set((by.get(i) + 1) * 10 + bx.get(i) + 1, 255);
        }
        i = i + 1;
    }
    return cells;
}

/// The 10 x 10 cell picture of a tag as text rows ('#' black, '.' white).
pub fn atag_ascii(id: i64) -> Vec<str> {
    val cells: Vec<i64> = atag_cells(id);
    var rows: Vec<str> = Vec::new();
    var y: i64 = 0;
    while y < 10 {
        var s: str = "";
        var x: i64 = 0;
        while x < 10 {
            if cells.get(y * 10 + x) == 0 {
                s = s + "#";
            } else {
                s = s + ".";
            }
            x = x + 1;
        }
        rows.push(s);
        y = y + 1;
    }
    return rows;
}

/// Draw tag `id` into an image: `h` maps tag coordinates (the black square
/// is [-1, 1]^2, the white border reaches +-1.25) to pixels. Each pixel
/// averages 4x4 samples; pixels outside the tag are left alone.
pub fn atag_render(img: &mut GrayImg, id: i64, h: &Vec<f64>) {
    val hinv: Vec<f64> = vis_mat3_inverse(h);
    if hinv.len() == 0 {
        return;
    }
    val cells: Vec<i64> = atag_cells(id);
    // the pixels the tag can cover: the bounding box of its corners
    var x0: f64 = 1.0e9;
    var y0: f64 = 1.0e9;
    var x1: f64 = -1.0e9;
    var y1: f64 = -1.0e9;
    var k: i64 = 0;
    while k < 4 {
        var u: f64 = -1.25;
        var v: f64 = -1.25;
        if k == 1 || k == 2 {
            u = 1.25;
        }
        if k >= 2 {
            v = 1.25;
        }
        val p: vec2 = vis_hom_apply(h, u, v);
        x0 = rmath_min(x0, p.x);
        y0 = rmath_min(y0, p.y);
        x1 = rmath_max(x1, p.x);
        y1 = rmath_max(y1, p.y);
        k = k + 1;
    }
    var py: i64 = rmath_max(0.0, math_floor(y0) - 1.0) as i64;
    val pye: i64 = rmath_min((img.h - 1) as f64, math_ceil(y1) + 1.0) as i64;
    val pxs: i64 = rmath_max(0.0, math_floor(x0) - 1.0) as i64;
    val pxe: i64 = rmath_min((img.w - 1) as f64, math_ceil(x1) + 1.0) as i64;
    while py <= pye {
        var px: i64 = pxs;
        while px <= pxe {
            var sum: i64 = 0;
            var inside: i64 = 0;
            var sy: i64 = 0;
            while sy < 4 {
                var sx: i64 = 0;
                while sx < 4 {
                    val q: vec2 = vis_hom_apply(&hinv, (px as f64) - 0.375 + 0.25 * (sx as f64), (py as f64) - 0.375 + 0.25 * (sy as f64));
                    val cx: f64 = math_floor((q.x + 1.25) / 0.25);
                    val cy: f64 = math_floor((q.y + 1.25) / 0.25);
                    if cx >= 0.0 && cy >= 0.0 && cx < 10.0 && cy < 10.0 {
                        inside = inside + 1;
                        sum = sum + cells.get((cy as i64) * 10 + (cx as i64));
                    } else {
                        sum = sum + vis_get(img, px, py);
                    }
                    sx = sx + 1;
                }
                sy = sy + 1;
            }
            if inside > 0 {
                vis_set(img, px, py, (sum + 8) / 16);
            }
            px = px + 1;
        }
        py = py + 1;
    }
}

/// The homography of a tag of side `size` (metres, black square) at pose
/// (r = rotation tag -> camera, t = tag centre in the camera frame) seen by
/// a pinhole camera (distortion ignored).
pub fn atag_pose_homography(cam: &Camera, r: Mat3, t: vec3, size: f64) -> Vec<f64> {
    val s: f64 = size / 2.0;
    var h: Vec<f64> = Vec::new();
    // K [s r1, s r2, t]
    val c1: vec3 = vec3(r.m00 * s, r.m10 * s, r.m20 * s);
    val c2: vec3 = vec3(r.m01 * s, r.m11 * s, r.m21 * s);
    h.push(cam.fx * c1.x + cam.cx * c1.z);
    h.push(cam.fx * c2.x + cam.cx * c2.z);
    h.push(cam.fx * t.x + cam.cx * t.z);
    h.push(cam.fy * c1.y + cam.cy * c1.z);
    h.push(cam.fy * c2.y + cam.cy * c2.z);
    h.push(cam.fy * t.y + cam.cy * t.z);
    h.push(c1.z);
    h.push(c2.z);
    h.push(t.z);
    return h;
}

// ─── Detection ───

pub struct AtagDetection {
    pub id: i64,
    pub hamming: i64,
    // quarter turns between the tag as found and its canonical orientation
    pub rotation: i64,
    // corners in the tag's order: (-1,-1), (1,-1), (1,1), (-1,1)
    pub cx: Vec<f64>,
    pub cy: Vec<f64>,
    pub center: vec2,
    // tag coordinates -> pixels
    pub h: Vec<f64>,
    // white - black contrast found when decoding
    pub contrast: f64,
}

pub struct AtagPose {
    pub r: Mat3,
    pub t: vec3,
    pub q: quat,
}

fn atag_unit_x() -> Vec<f64> {
    var v: Vec<f64> = Vec::new();
    v.push(-1.0);
    v.push(1.0);
    v.push(1.0);
    v.push(-1.0);
    return v;
}

fn atag_unit_y() -> Vec<f64> {
    var v: Vec<f64> = Vec::new();
    v.push(-1.0);
    v.push(-1.0);
    v.push(1.0);
    v.push(1.0);
    return v;
}

// A line through points by total least squares: [nx, ny, c] with
// nx x + ny y = c and (nx, ny) a unit normal; empty with fewer than 2.
fn atag_fit_line(xs: &Vec<f64>, ys: &Vec<f64>) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    val n: i64 = xs.len();
    if n < 2 {
        return out;
    }
    var mx: f64 = 0.0;
    var my: f64 = 0.0;
    var i: i64 = 0;
    while i < n {
        mx = mx + xs.get(i);
        my = my + ys.get(i);
        i = i + 1;
    }
    mx = mx / (n as f64);
    my = my / (n as f64);
    var sxx: f64 = 0.0;
    var sxy: f64 = 0.0;
    var syy: f64 = 0.0;
    i = 0;
    while i < n {
        val dx: f64 = xs.get(i) - mx;
        val dy: f64 = ys.get(i) - my;
        sxx = sxx + dx * dx;
        sxy = sxy + dx * dy;
        syy = syy + dy * dy;
        i = i + 1;
    }
    // direction of largest spread: angle 0.5 atan2(2 sxy, sxx - syy)
    val a: f64 = 0.5 * rmath_atan2(2.0 * sxy, sxx - syy);
    val nx: f64 = 0.0 - math_sin(a);
    val ny: f64 = math_cos(a);
    out.push(nx);
    out.push(ny);
    out.push(nx * mx + ny * my);
    return out;
}

// Intersection of two lines [nx, ny, c]; empty when parallel.
fn atag_intersect(a: &Vec<f64>, b: &Vec<f64>) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    val det: f64 = a.get(0) * b.get(1) - a.get(1) * b.get(0);
    if math_fabs(det) < 0.000000001 {
        return out;
    }
    out.push((a.get(2) * b.get(1) - a.get(1) * b.get(2)) / det);
    out.push((a.get(0) * b.get(2) - a.get(2) * b.get(0)) / det);
    return out;
}

// Distance from (x, y) to the line through (ax, ay), (bx, by), signed.
fn atag_side(ax: f64, ay: f64, bx: f64, by: f64, x: f64, y: f64) -> f64 {
    val dx: f64 = bx - ax;
    val dy: f64 = by - ay;
    val l: f64 = math_sqrt(dx * dx + dy * dy);
    if l == 0.0 {
        return 0.0;
    }
    return (dx * (y - ay) - dy * (x - ax)) / l;
}

// Sample the cell at grid position (gx, gy) of the 8x8 grid (fractional
// positions allowed; -1 and 8 are the white quiet zone).
fn atag_sample(f: &FImg, h: &Vec<f64>, gx: f64, gy: f64) -> f64 {
    val p: vec2 = vis_hom_apply(h, (gx + 0.5) / 4.0 - 1.0, (gy + 0.5) / 4.0 - 1.0);
    return vis_bilinear(f, p.x, p.y);
}

/// Find the tag36h11 tags in a gray image, accepting codes at most
/// `max_hamming` bits from a table entry.
pub fn atag_detect(g: &GrayImg, max_hamming: i64) -> Vec<AtagDetection> {
    var out: Vec<AtagDetection> = Vec::new();
    val f: FImg = vis_to_float(g);
    val thr: i64 = vis_otsu(g);
    val thf: f64 = (thr as f64) + 0.5;
    // dark pixels
    var dark: GrayImg = vis_gray_new(g.w, g.h, 0);
    var i: i64 = 0;
    while i < g.data.len() {
        if g.data.get(i) <= thr {
            dark.data.set(i, 255);
        }
        i = i + 1;
    }
    val comps: Components = vis_components(&dark, false);
    var c: i64 = 0;
    while c < comps.count {
        val bx0: i64 = comps.min_x.get(c);
        val by0: i64 = comps.min_y.get(c);
        val bx1: i64 = comps.max_x.get(c);
        val by1: i64 = comps.max_y.get(c);
        val big: bool = comps.area.get(c) >= 24 && bx1 - bx0 >= 7 && by1 - by0 >= 7;
        val inner: bool = bx0 > 0 && by0 > 0 && bx1 < g.w - 1 && by1 < g.h - 1;
        if big && inner {
            val det: AtagDetection = atag_try_component(g, &f, &comps, c + 1, thf, max_hamming);
            if det.id >= 0 {
                out.push(det);
            }
        }
        c = c + 1;
    }
    return out;
}

fn atag_none() -> AtagDetection {
    return AtagDetection {
        id: -1, hamming: 99, rotation: 0, cx: Vec::new(), cy: Vec::new(), center: vec2(0.0, 0.0), h: Vec::new(), contrast: 0.0
    };
}

fn atag_try_component(g: &GrayImg, f: &FImg, comps: &Components, label: i64, thf: f64, max_hamming: i64) -> AtagDetection {
    val w: i64 = g.w;
    // the outside of the component within its bounding box grown by 1
    val x0: i64 = comps.min_x.get(label - 1) - 1;
    val y0: i64 = comps.min_y.get(label - 1) - 1;
    val x1: i64 = comps.max_x.get(label - 1) + 1;
    val y1: i64 = comps.max_y.get(label - 1) + 1;
    val bw: i64 = x1 - x0 + 1;
    val bh: i64 = y1 - y0 + 1;
    var outside: Vec<bool> = Vec::new();
    var i: i64 = 0;
    while i < bw * bh {
        outside.push(false);
        i = i + 1;
    }
    var stack: Vec<i64> = Vec::new();
    i = 0;
    while i < bw * bh {
        val lx: i64 = i % bw;
        val ly: i64 = i / bw;
        if lx == 0 || ly == 0 || lx == bw - 1 || ly == bh - 1 {
            outside.set(i, true);
            stack.push(i);
        }
        i = i + 1;
    }
    while stack.len() > 0 {
        val p: i64 = stack.pop();
        val px: i64 = p % bw;
        val py: i64 = p / bw;
        var d: i64 = 0;
        while d < 4 {
            var qx: i64 = px;
            var qy: i64 = py;
            if d == 0 {
                qx = px + 1;
            }
            if d == 1 {
                qx = px - 1;
            }
            if d == 2 {
                qy = py + 1;
            }
            if d == 3 {
                qy = py - 1;
            }
            if qx >= 0 && qy >= 0 && qx < bw && qy < bh {
                val q: i64 = qy * bw + qx;
                if !outside.get(q) && comps.labels.get((qy + y0) * w + qx + x0) != label {
                    outside.set(q, true);
                    stack.push(q);
                }
            }
            d = d + 1;
        }
    }
    // sub-pixel points of the outer boundary
    var ex: Vec<f64> = Vec::new();
    var ey: Vec<f64> = Vec::new();
    var y: i64 = y0 + 1;
    while y < y1 {
        var x: i64 = x0 + 1;
        while x < x1 {
            if comps.labels.get(y * w + x) == label {
                var d: i64 = 0;
                while d < 4 {
                    var dx: i64 = 0;
                    var dy: i64 = 0;
                    if d == 0 {
                        dx = 1;
                    }
                    if d == 1 {
                        dx = -1;
                    }
                    if d == 2 {
                        dy = 1;
                    }
                    if d == 3 {
                        dy = -1;
                    }
                    if outside.get((y + dy - y0) * bw + x + dx - x0) {
                        val vp: f64 = vis_fget(f, x, y);
                        val vq: f64 = vis_fget(f, x + dx, y + dy);
                        var t: f64 = 0.5;
                        if vq - vp > 0.5 {
                            t = rmath_clamp((thf - vp) / (vq - vp), 0.0, 1.0);
                        }
                        ex.push((x as f64) + t * (dx as f64));
                        ey.push((y as f64) + t * (dy as f64));
                    }
                    d = d + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    val n: i64 = ex.len();
    if n < 16 {
        return atag_none();
    }
    // corners from extreme points
    var mx: f64 = 0.0;
    var my: f64 = 0.0;
    i = 0;
    while i < n {
        mx = mx + ex.get(i);
        my = my + ey.get(i);
        i = i + 1;
    }
    mx = mx / (n as f64);
    my = my / (n as f64);
    var a: i64 = 0;
    var best: f64 = -1.0;
    i = 0;
    while i < n {
        val d2: f64 = (ex.get(i) - mx) * (ex.get(i) - mx) + (ey.get(i) - my) * (ey.get(i) - my);
        if d2 > best {
            best = d2;
            a = i;
        }
        i = i + 1;
    }
    var b: i64 = 0;
    best = -1.0;
    i = 0;
    while i < n {
        val d2: f64 = (ex.get(i) - ex.get(a)) * (ex.get(i) - ex.get(a)) + (ey.get(i) - ey.get(a)) * (ey.get(i) - ey.get(a));
        if d2 > best {
            best = d2;
            b = i;
        }
        i = i + 1;
    }
    var cpos: i64 = -1;
    var cneg: i64 = -1;
    var spos: f64 = 0.0;
    var sneg: f64 = 0.0;
    i = 0;
    while i < n {
        val s: f64 = atag_side(ex.get(a), ey.get(a), ex.get(b), ey.get(b), ex.get(i), ey.get(i));
        if s > spos {
            spos = s;
            cpos = i;
        }
        if s < sneg {
            sneg = s;
            cneg = i;
        }
        i = i + 1;
    }
    if cpos < 0 || cneg < 0 {
        return atag_none();
    }
    // the four corners in order of angle around the centre (clockwise on
    // screen, y down)
    var qx: Vec<f64> = Vec::new();
    var qy: Vec<f64> = Vec::new();
    var qa: Vec<f64> = Vec::new();
    var idx: Vec<i64> = Vec::new();
    idx.push(a);
    idx.push(cpos);
    idx.push(b);
    idx.push(cneg);
    i = 0;
    while i < 4 {
        val px: f64 = ex.get(idx.get(i));
        val py: f64 = ey.get(idx.get(i));
        val ang: f64 = rmath_atan2(py - my, px - mx);
        var at: i64 = qa.len();
        var k: i64 = 0;
        while k < qa.len() {
            if ang < qa.get(k) && at == qa.len() {
                at = k;
            }
            k = k + 1;
        }
        qa.insert(at, ang);
        qx.insert(at, px);
        qy.insert(at, py);
        i = i + 1;
    }
    // refine: fit a line to the points of each side (away from corners)
    var lines: Vec<Vec<f64>> = Vec::new();
    var sidei: i64 = 0;
    while sidei < 4 {
        val j: i64 = (sidei + 1) % 4;
        val ax: f64 = qx.get(sidei);
        val ay: f64 = qy.get(sidei);
        val bxx: f64 = qx.get(j);
        val byy: f64 = qy.get(j);
        val len: f64 = math_sqrt((bxx - ax) * (bxx - ax) + (byy - ay) * (byy - ay));
        var lx: Vec<f64> = Vec::new();
        var ly: Vec<f64> = Vec::new();
        i = 0;
        while i < n {
            val px: f64 = ex.get(i);
            val py: f64 = ey.get(i);
            val along: f64 = ((px - ax) * (bxx - ax) + (py - ay) * (byy - ay)) / len;
            val off: f64 = math_fabs(atag_side(ax, ay, bxx, byy, px, py));
            if along > 0.15 * len && along < 0.85 * len && off < 2.0 {
                lx.push(px);
                ly.push(py);
            }
            i = i + 1;
        }
        val ln: Vec<f64> = atag_fit_line(&lx, &ly);
        if ln.len() == 0 {
            return atag_none();
        }
        lines.push(ln);
        sidei = sidei + 1;
    }
    var cx: Vec<f64> = Vec::new();
    var cy: Vec<f64> = Vec::new();
    i = 0;
    while i < 4 {
        val prev: i64 = (i + 3) % 4;
        val p: Vec<f64> = atag_intersect(&lines.get(prev), &lines.get(i));
        if p.len() == 0 {
            return atag_none();
        }
        cx.push(p.get(0));
        cy.push(p.get(1));
        i = i + 1;
    }
    val ux: Vec<f64> = atag_unit_x();
    val uy: Vec<f64> = atag_unit_y();
    val hm: Homography = vis_homography(&ux, &uy, &cx, &cy);
    if !hm.ok {
        return atag_none();
    }
    // reference levels: black border (cells 0 and 7), white quiet zone
    // (just outside the black square)
    var black: f64 = 0.0;
    var white: f64 = 0.0;
    var k: i64 = 0;
    while k < 8 {
        val kf: f64 = k as f64;
        black = black + atag_sample(f, &hm.h, kf, 0.0) + atag_sample(f, &hm.h, kf, 7.0) + atag_sample(f, &hm.h, 0.0, kf) + atag_sample(f, &hm.h, 7.0, kf);
        white = white + atag_sample(f, &hm.h, kf, -0.5) + atag_sample(f, &hm.h, kf, 7.5) + atag_sample(f, &hm.h, -0.5, kf) + atag_sample(f, &hm.h, 7.5, kf);
        k = k + 1;
    }
    black = black / 32.0;
    white = white / 32.0;
    val contrast: f64 = white - black;
    if contrast < 20.0 {
        return atag_none();
    }
    val cut: f64 = (black + white) / 2.0;
    // the border must be dark
    var bad: i64 = 0;
    k = 0;
    while k < 8 {
        val kf: f64 = k as f64;
        if atag_sample(f, &hm.h, kf, 0.0) > cut {
            bad = bad + 1;
        }
        if atag_sample(f, &hm.h, kf, 7.0) > cut {
            bad = bad + 1;
        }
        if atag_sample(f, &hm.h, 0.0, kf) > cut {
            bad = bad + 1;
        }
        if atag_sample(f, &hm.h, 7.0, kf) > cut {
            bad = bad + 1;
        }
        k = k + 1;
    }
    if bad > 3 {
        return atag_none();
    }
    // the 6 x 6 data cells, then the code in each rotation
    var grid: Vec<i64> = Vec::new();
    var gy: i64 = 0;
    while gy < 8 {
        var gx: i64 = 0;
        while gx < 8 {
            if atag_sample(f, &hm.h, gx as f64, gy as f64) > cut {
                grid.push(1);
            } else {
                grid.push(0);
            }
            gx = gx + 1;
        }
        gy = gy + 1;
    }
    val bitx: Vec<i64> = atag36h11_bit_x();
    val bity: Vec<i64> = atag36h11_bit_y();
    var best_id: i64 = -1;
    var best_d: i64 = 99;
    var best_r: i64 = 0;
    var r: i64 = 0;
    while r < 4 {
        var code: i64 = 0;
        var bit: i64 = 0;
        while bit < 36 {
            // the canonical cell (x, y) appears at rot^r(x, y)
            var px: i64 = bitx.get(bit);
            var py: i64 = bity.get(bit);
            var t: i64 = 0;
            while t < r {
                val nx: i64 = 7 - py;
                py = px;
                px = nx;
                t = t + 1;
            }
            code = (code << 1) | grid.get(py * 8 + px);
            bit = bit + 1;
        }
        val m: Vec<i64> = atag_lookup(code);
        if m.get(1) < best_d {
            best_d = m.get(1);
            best_id = m.get(0);
            best_r = r;
        }
        r = r + 1;
    }
    if best_d > max_hamming {
        return atag_none();
    }
    // canonical corner k sits at our corner (k + r) % 4
    var ox: Vec<f64> = Vec::new();
    var oy: Vec<f64> = Vec::new();
    k = 0;
    while k < 4 {
        ox.push(cx.get((k + best_r) % 4));
        oy.push(cy.get((k + best_r) % 4));
        k = k + 1;
    }
    val hc: Homography = vis_homography(&ux, &uy, &ox, &oy);
    val ctr: vec2 = vis_hom_apply(&hc.h, 0.0, 0.0);
    return AtagDetection {
        id: best_id, hamming: best_d, rotation: best_r, cx: ox, cy: oy, center: ctr, h: hc.h, contrast: contrast
    };
}

// ─── Pose ───

/// The tag's pose in the camera frame from its corners, for a tag whose
/// black square has side `size` (metres).
pub fn atag_pose(d: &AtagDetection, cam: &Camera, size: f64) -> AtagPose {
    var nx: Vec<f64> = Vec::new();
    var ny: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < 4 {
        val p: vec2 = cam_pixel_to_norm(cam, d.cx.get(i), d.cy.get(i));
        nx.push(p.x);
        ny.push(p.y);
        i = i + 1;
    }
    val ux: Vec<f64> = atag_unit_x();
    val uy: Vec<f64> = atag_unit_y();
    val hm: Homography = vis_homography(&ux, &uy, &nx, &ny);
    val h: Vec<f64> = hm.h;
    val m1: vec3 = vec3(h.get(0), h.get(3), h.get(6));
    val m2: vec3 = vec3(h.get(1), h.get(4), h.get(7));
    val m3: vec3 = vec3(h.get(2), h.get(5), h.get(8));
    val l1: f64 = math_sqrt(m1.x * m1.x + m1.y * m1.y + m1.z * m1.z);
    val l2: f64 = math_sqrt(m2.x * m2.x + m2.y * m2.y + m2.z * m2.z);
    // H ~ [s r1, s r2, t] with s = size / 2
    var mu: f64 = (l1 + l2) / size;
    if m3.z < 0.0 {
        mu = 0.0 - mu;
    }
    val s: f64 = size / 2.0;
    val r1: vec3 = vec3(m1.x / (mu * s), m1.y / (mu * s), m1.z / (mu * s));
    val r2: vec3 = vec3(m2.x / (mu * s), m2.y / (mu * s), m2.z / (mu * s));
    val t: vec3 = vec3(m3.x / mu, m3.y / mu, m3.z / mu);
    // nearest rotation: make r1, r2 orthonormal symmetrically
    val a: vec3 = vec3(r1.x + r2.x, r1.y + r2.y, r1.z + r2.z);
    val b: vec3 = vec3(r1.x - r2.x, r1.y - r2.y, r1.z - r2.z);
    val la: f64 = math_sqrt(a.x * a.x + a.y * a.y + a.z * a.z);
    val lb: f64 = math_sqrt(b.x * b.x + b.y * b.y + b.z * b.z);
    val k: f64 = 0.7071067811865476;
    val e1: vec3 = vec3(k * (a.x / la + b.x / lb), k * (a.y / la + b.y / lb), k * (a.z / la + b.z / lb));
    val e2: vec3 = vec3(k * (a.x / la - b.x / lb), k * (a.y / la - b.y / lb), k * (a.z / la - b.z / lb));
    val e3: vec3 = vec3(e1.y * e2.z - e1.z * e2.y, e1.z * e2.x - e1.x * e2.z, e1.x * e2.y - e1.y * e2.x);
    val r: Mat3 = mat3_from_rows(vec3(e1.x, e2.x, e3.x), vec3(e1.y, e2.y, e3.y), vec3(e1.z, e2.z, e3.z));
    return AtagPose {
        r: r, t: t, q: qt_from_mat3(r)
    };
}
