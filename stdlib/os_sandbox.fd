// Fides sandbox policy data structures and encoders, pure Fides
//
// Builds the in-memory policy objects that OS process-confinement
// facilities consume, and encodes them to the byte layouts those kernels
// expect. This is a defensive tool: a policy here restricts what a child
// process may do. Nothing in this module calls the kernel; applying a
// policy is behind an extern seam (declared, not called here), so the test
// exercises only the pure encoders and the small verifier.
//
// Covered:
//   - Linux classic-BPF program objects (struct sock_filter, 8 bytes each,
//     little-endian) with a tiny assembler and disassembler, plus an
//     interpreter that runs a program over an input record so a test can
//     confirm which verdict each record gets. A helper builds the usual
//     shape of such a program from an allow list of call numbers: check the
//     architecture word, then one equality test per allowed number
//     returning ALLOW, else the default verdict.
//   - Linux Landlock ruleset objects (handled access-right bitsets, path
//     and port rules) and the byte layouts of landlock_ruleset_attr and
//     landlock_path_beneath_attr, with the best-effort downgrade of the
//     right set to an older ABI version.
//   - Windows job-object limits and AppContainer capability settings as
//     data (a struct a caller can read), with the field encodings of
//     JOBOBJECT_BASIC_LIMIT_INFORMATION.
//
// Seam (not called here; shown so callers know where the OS line is):
//   extern "C" { fn prctl(...) -> i32;  fn syscall(...) -> i64; }   // Linux
//   extern "C" { fn SetInformationJobObject(...) -> i32; }          // Windows
//
// Usage:
//   var p: BpfPolicy = bpf_policy_new(SB_VERDICT_ERRNO + 1);   // default EPERM
//   bpf_allow(& mut p, sb_call_x64("read"));
//   bpf_allow(& mut p, sb_call_x64("write"));
//   val prog: Vec<i64> = bpf_compile(& p, SB_ARCH_X86_64);     // sock_filter bytes
//   val verdict: i64 = bpf_run(& prog, SB_ARCH_X86_64, sb_call_x64("read"), args0());

module os_sandbox;
 use vec;

// ─── classic BPF opcodes (linux/bpf_common.h) ───────────────────────────

pub const BPF_LD: i64 = 0x00;
pub const BPF_JMP: i64 = 0x05;
pub const BPF_RET: i64 = 0x06;
pub const BPF_W: i64 = 0x00;
pub const BPF_ABS: i64 = 0x20;
pub const BPF_JEQ: i64 = 0x10;
pub const BPF_JGE: i64 = 0x30;
pub const BPF_JGT: i64 = 0x20;
pub const BPF_K: i64 = 0x00;

// seccomp return values (linux/seccomp.h), high 16 bits = action.
pub const SB_RET_KILL_PROCESS: i64 = 0x80000000;
pub const SB_RET_KILL_THREAD: i64 = 0x00000000;
pub const SB_RET_TRAP: i64 = 0x00030000;
pub const SB_RET_ERRNO: i64 = 0x00050000;
pub const SB_RET_USER_NOTIF: i64 = 0x7fc00000;
pub const SB_RET_TRACE: i64 = 0x7ff00000;
pub const SB_RET_LOG: i64 = 0x7ffc0000;
pub const SB_RET_ALLOW: i64 = 0x7fff0000;
pub const SB_RET_DATA: i64 = 0x0000ffff;  // mask for ERRNO / TRACE data

// policy "default/per-rule verdict" codes used by this module's builder
pub const SB_VERDICT_ALLOW: i64 = 0;
pub const SB_VERDICT_KILL: i64 = 1;
pub const SB_VERDICT_TRAP: i64 = 2;
pub const SB_VERDICT_LOG: i64 = 3;
pub const SB_VERDICT_NOTIFY: i64 = 4;
pub const SB_VERDICT_ERRNO: i64 = 100;  // + errno in the low part

// AUDIT_ARCH_* (linux/audit.h)
pub const SB_ARCH_X86_64: i64 = 0xC000003E;
pub const SB_ARCH_AARCH64: i64 = 0xC00000B7;
pub const SB_ARCH_I386: i64 = 0x40000003;

// seccomp_data field offsets (bytes): nr @0, arch @4, ip @8, args @16..
pub const SB_OFF_NR: i64 = 0;
pub const SB_OFF_ARCH: i64 = 4;
pub const SB_OFF_ARG0: i64 = 16;

/// One classic-BPF instruction (struct sock_filter).
pub struct BpfInsn {
    pub code: i64,
    pub jt: i64,
    pub jf: i64,
    pub k: i64,
}

pub fn bpf(code: i64, jt: i64, jf: i64, k: i64) -> BpfInsn {
    return BpfInsn { code: code, jt: jt, jf: jf, k: k };
}

/// A verdict value (the 32-bit seccomp return) from a policy verdict code.
pub fn sb_ret(verdict: i64) -> i64 {
    if verdict == SB_VERDICT_ALLOW { return SB_RET_ALLOW; }
    if verdict == SB_VERDICT_KILL { return SB_RET_KILL_PROCESS; }
    if verdict == SB_VERDICT_TRAP { return SB_RET_TRAP; }
    if verdict == SB_VERDICT_LOG { return SB_RET_LOG; }
    if verdict == SB_VERDICT_NOTIFY { return SB_RET_USER_NOTIF; }
    if verdict >= SB_VERDICT_ERRNO {
        return SB_RET_ERRNO | ((verdict - SB_VERDICT_ERRNO) & SB_RET_DATA);
    }
    return SB_RET_ALLOW;
}

// ─── policy model ───────────────────────────────────────────────────────

/// One rule: call number `nr` gets `verdict`. When `has_arg`, it applies
/// only when argument `arg_index` equals `arg_value`.
pub struct BpfRule {
    pub nr: i64,
    pub verdict: i64,
    pub has_arg: bool,
    pub arg_index: i64,
    pub arg_value: i64,
}

/// A policy: a list of per-call rules and a default verdict for everything
/// else. `kill_x32` rejects the x32 ABI (numbers >= 0x40000000) on x86-64.
pub struct BpfPolicy {
    pub rules: Vec<BpfRule>,
    pub default_verdict: i64,
    pub kill_x32: bool,
}

pub fn bpf_policy_new(default_verdict: i64) -> BpfPolicy {
    return BpfPolicy { rules: Vec::new(), default_verdict: default_verdict, kill_x32: true };
}

/// Allow one call number.
pub fn bpf_allow(p: & mut BpfPolicy, nr: i64) {
    p.rules.push(BpfRule { nr: nr, verdict: SB_VERDICT_ALLOW, has_arg: false, arg_index: 0, arg_value: 0 });
}

/// Allow one call only when argument `idx` (0..5) equals `value`.
pub fn bpf_allow_arg(p: & mut BpfPolicy, nr: i64, idx: i64, value: i64) {
    p.rules.push(BpfRule { nr: nr, verdict: SB_VERDICT_ALLOW, has_arg: true, arg_index: idx, arg_value: value });
}

/// Give one call number a specific verdict (e.g. SB_VERDICT_ERRNO + 1).
pub fn bpf_rule(p: & mut BpfPolicy, nr: i64, verdict: i64) {
    p.rules.push(BpfRule { nr: nr, verdict: verdict, has_arg: false, arg_index: 0, arg_value: 0 });
}

// ─── compilation to instructions ────────────────────────────────────────

/// The program as a list of instructions. Shape: load arch; if arch != the
/// target, default; (x86-64) load nr; if nr >= 0x40000000 and kill_x32,
/// default; load nr; per rule a compare that returns its verdict; default.
pub fn bpf_assemble(p: & BpfPolicy, arch: i64) -> Vec<BpfInsn> {
    var out: Vec<BpfInsn> = Vec::new();
    val def: i64 = sb_ret(p.default_verdict);
    // load arch, reject a foreign one
    out.push(bpf(BPF_LD | BPF_W | BPF_ABS, 0, 0, SB_OFF_ARCH));
    out.push(bpf(BPF_JMP | BPF_JEQ | BPF_K, 1, 0, arch));
    out.push(bpf(BPF_RET | BPF_K, 0, 0, def));
    // load nr
    out.push(bpf(BPF_LD | BPF_W | BPF_ABS, 0, 0, SB_OFF_NR));
    if arch == SB_ARCH_X86_64 && p.kill_x32 {
        // if nr >= 0x40000000 -> default
        out.push(bpf(BPF_JMP | BPF_JGE | BPF_K, 0, 1, 0x40000000));
        out.push(bpf(BPF_RET | BPF_K, 0, 0, def));
    }
    var i: i64 = 0;
    while i < p.rules.len() {
        val r: BpfRule = p.rules.get(i);
        if r.has_arg {
            // if nr != this, skip the two arg instructions; else load the
            // arg's low word and compare; the high word is checked too.
            out.push(bpf(BPF_JMP | BPF_JEQ | BPF_K, 0, 3, r.nr));
            out.push(bpf(BPF_LD | BPF_W | BPF_ABS, 0, 0, SB_OFF_ARG0 + r.arg_index * 8));
            out.push(bpf(BPF_JMP | BPF_JEQ | BPF_K, 0, 1, r.arg_value & 0xFFFFFFFF));
            out.push(bpf(BPF_RET | BPF_K, 0, 0, sb_ret(r.verdict)));
            // reload nr for the next rule
            out.push(bpf(BPF_LD | BPF_W | BPF_ABS, 0, 0, SB_OFF_NR));
        } else {
            out.push(bpf(BPF_JMP | BPF_JEQ | BPF_K, 0, 1, r.nr));
            out.push(bpf(BPF_RET | BPF_K, 0, 0, sb_ret(r.verdict)));
        }
        i = i + 1;
    }
    out.push(bpf(BPF_RET | BPF_K, 0, 0, def));
    return out;
}

fn sb_put32le(o: & mut Vec<i64>, v: i64) {
    o.push(v & 255);
    o.push((v >> 8) & 255);
    o.push((v >> 16) & 255);
    o.push((v >> 24) & 255);
}

/// Encode instructions as struct sock_filter bytes (8 bytes each).
pub fn bpf_encode(prog: & Vec<BpfInsn>) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < prog.len() {
        val in: BpfInsn = prog.get(i);
        o.push(in.code & 255);
        o.push((in.code >> 8) & 255);
        o.push(in.jt & 255);
        o.push(in.jf & 255);
        sb_put32le(& mut o, in.k & 0xFFFFFFFF);
        i = i + 1;
    }
    return o;
}

/// Compile a policy straight to sock_filter bytes.
pub fn bpf_compile(p: & BpfPolicy, arch: i64) -> Vec<i64> {
    return bpf_encode(& bpf_assemble(p, arch));
}

/// Decode sock_filter bytes back to instructions.
pub fn bpf_decode(b: & Vec<i64>) -> Vec<BpfInsn> {
    var out: Vec<BpfInsn> = Vec::new();
    var i: i64 = 0;
    while i + 8 <= b.len() {
        val code: i64 = (b.get(i) & 255) | ((b.get(i + 1) & 255) << 8);
        val k: i64 = (b.get(i + 4) & 255) | ((b.get(i + 5) & 255) << 8) | ((b.get(i + 6) & 255) << 16) | ((b.get(i + 7) & 255) << 24);
        out.push(bpf(code, b.get(i + 2) & 255, b.get(i + 3) & 255, k));
        i = i + 8;
    }
    return out;
}

/// The number of instructions a policy compiles to.
pub fn bpf_len(p: & BpfPolicy, arch: i64) -> i64 {
    return bpf_assemble(p, arch).len();
}

// ─── interpreter (so a test can confirm each record's verdict) ──────────

/// The six arguments of a call as a Vec (index 0..5).
pub fn sb_args(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(a0); v.push(a1); v.push(a2); v.push(a3); v.push(a4); v.push(a5);
    return v;
}

/// No arguments (all zero).
pub fn sb_args0() -> Vec<i64> {
    return sb_args(0, 0, 0, 0, 0, 0);
}

fn sb_field(nr: i64, arch: i64, args: & Vec<i64>, off: i64) -> i64 {
    if off == SB_OFF_NR {
        return nr & 0xFFFFFFFF;
    }
    if off == SB_OFF_ARCH {
        return arch & 0xFFFFFFFF;
    }
    if off == 8 || off == 12 {
        return 0;
    }
    if off >= SB_OFF_ARG0 && off < SB_OFF_ARG0 + 48 {
        val idx: i64 = (off - SB_OFF_ARG0) / 8;
        val low: bool = ((off - SB_OFF_ARG0) % 8) == 0;
        val a: i64 = args.get(idx);
        if low {
            return a & 0xFFFFFFFF;
        }
        return (a >> 32) & 0xFFFFFFFF;
    }
    return 0;
}

fn sb_u32(x: i64) -> i64 {
    return x & 0xFFFFFFFF;
}

/// Run an encoded program (sock_filter bytes) over one record; returns the
/// 32-bit seccomp verdict the program would produce for it.
pub fn bpf_run(prog_bytes: & Vec<i64>, arch: i64, nr: i64, args: Vec<i64>) -> i64 {
    val prog: Vec<BpfInsn> = bpf_decode(prog_bytes);
    var acc: i64 = 0;
    var pc: i64 = 0;
    var steps: i64 = 0;
    while pc < prog.len() && steps < 100000 {
        val ins: BpfInsn = prog.get(pc);
        steps = steps + 1;
        val cls: i64 = ins.code & 7;
        if cls == BPF_LD {
            acc = sb_field(nr, arch, & args, ins.k);
            pc = pc + 1;
        } else if cls == BPF_RET {
            return ins.k & 0xFFFFFFFF;
        } else if cls == BPF_JMP {
            val op: i64 = ins.code & 0xF0;
            var take: bool = false;
            if op == BPF_JEQ {
                take = sb_u32(acc) == sb_u32(ins.k);
            } else if op == BPF_JGE {
                take = sb_u32(acc) >= sb_u32(ins.k);
            } else if op == BPF_JGT {
                take = sb_u32(acc) > sb_u32(ins.k);
            }
            if take {
                pc = pc + 1 + ins.jt;
            } else {
                pc = pc + 1 + ins.jf;
            }
        } else {
            pc = pc + 1;
        }
    }
    return SB_RET_KILL_PROCESS;
}

/// A readable verdict name for a 32-bit seccomp return.
pub fn sb_verdict_name(ret: i64) -> str {
    val action: i64 = ret & 0x7FFF0000;
    if (ret & 0x80000000) != 0 && action == 0 {
        return "KILL_PROCESS";
    }
    if ret == SB_RET_KILL_THREAD { return "KILL_THREAD"; }
    if action == SB_RET_TRAP { return "TRAP"; }
    if action == SB_RET_ERRNO { return "ERRNO " + int_to_str(ret & SB_RET_DATA); }
    if ret == SB_RET_USER_NOTIF { return "USER_NOTIF"; }
    if action == (SB_RET_TRACE & 0x7FFF0000) { return "TRACE"; }
    if ret == SB_RET_LOG { return "LOG"; }
    if ret == SB_RET_ALLOW { return "ALLOW"; }
    return "KILL_PROCESS";
}

// ─── call-number tables (a common subset; x86-64 and aarch64) ───────────

fn sb_pair(names: & mut Vec<str>, nums: & mut Vec<i64>, n: str, v: i64) {
    names.push(n);
    nums.push(v);
}

fn sb_x64_tab(names: & mut Vec<str>, nums: & mut Vec<i64>) {
    sb_pair(names, nums, "read", 0); sb_pair(names, nums, "write", 1);
    sb_pair(names, nums, "open", 2); sb_pair(names, nums, "close", 3);
    sb_pair(names, nums, "stat", 4); sb_pair(names, nums, "fstat", 5);
    sb_pair(names, nums, "lstat", 6); sb_pair(names, nums, "poll", 7);
    sb_pair(names, nums, "lseek", 8); sb_pair(names, nums, "mmap", 9);
    sb_pair(names, nums, "mprotect", 10); sb_pair(names, nums, "munmap", 11);
    sb_pair(names, nums, "brk", 12); sb_pair(names, nums, "rt_sigaction", 13);
    sb_pair(names, nums, "rt_sigprocmask", 14); sb_pair(names, nums, "ioctl", 16);
    sb_pair(names, nums, "pread64", 17); sb_pair(names, nums, "pwrite64", 18);
    sb_pair(names, nums, "readv", 19); sb_pair(names, nums, "writev", 20);
    sb_pair(names, nums, "access", 21); sb_pair(names, nums, "pipe", 22);
    sb_pair(names, nums, "select", 23); sb_pair(names, nums, "dup", 32);
    sb_pair(names, nums, "dup2", 33); sb_pair(names, nums, "nanosleep", 35);
    sb_pair(names, nums, "socket", 41); sb_pair(names, nums, "connect", 42);
    sb_pair(names, nums, "accept", 43); sb_pair(names, nums, "sendto", 44);
    sb_pair(names, nums, "recvfrom", 45); sb_pair(names, nums, "bind", 49);
    sb_pair(names, nums, "listen", 50); sb_pair(names, nums, "clone", 56);
    sb_pair(names, nums, "fork", 57); sb_pair(names, nums, "execve", 59);
    sb_pair(names, nums, "exit", 60); sb_pair(names, nums, "wait4", 61);
    sb_pair(names, nums, "kill", 62); sb_pair(names, nums, "fcntl", 72);
    sb_pair(names, nums, "getcwd", 79); sb_pair(names, nums, "futex", 202);
    sb_pair(names, nums, "exit_group", 231); sb_pair(names, nums, "openat", 257);
    sb_pair(names, nums, "newfstatat", 262); sb_pair(names, nums, "ptrace", 101);
    sb_pair(names, nums, "getpid", 39); sb_pair(names, nums, "clock_gettime", 228);
}

fn sb_a64_tab(names: & mut Vec<str>, nums: & mut Vec<i64>) {
    sb_pair(names, nums, "io_setup", 0); sb_pair(names, nums, "getcwd", 17);
    sb_pair(names, nums, "dup", 23); sb_pair(names, nums, "fcntl", 25);
    sb_pair(names, nums, "ioctl", 29); sb_pair(names, nums, "faccessat", 48);
    sb_pair(names, nums, "openat", 56); sb_pair(names, nums, "close", 57);
    sb_pair(names, nums, "pipe2", 59); sb_pair(names, nums, "read", 63);
    sb_pair(names, nums, "write", 64); sb_pair(names, nums, "readv", 65);
    sb_pair(names, nums, "writev", 66); sb_pair(names, nums, "pread64", 67);
    sb_pair(names, nums, "pwrite64", 68); sb_pair(names, nums, "ppoll", 73);
    sb_pair(names, nums, "exit", 93); sb_pair(names, nums, "exit_group", 94);
    sb_pair(names, nums, "futex", 98); sb_pair(names, nums, "nanosleep", 101);
    sb_pair(names, nums, "clock_gettime", 113); sb_pair(names, nums, "kill", 129);
    sb_pair(names, nums, "rt_sigaction", 134); sb_pair(names, nums, "rt_sigprocmask", 135);
    sb_pair(names, nums, "getpid", 172); sb_pair(names, nums, "socket", 198);
    sb_pair(names, nums, "bind", 200); sb_pair(names, nums, "listen", 201);
    sb_pair(names, nums, "accept", 202); sb_pair(names, nums, "connect", 203);
    sb_pair(names, nums, "sendto", 206); sb_pair(names, nums, "recvfrom", 207);
    sb_pair(names, nums, "brk", 214); sb_pair(names, nums, "munmap", 215);
    sb_pair(names, nums, "clone", 220); sb_pair(names, nums, "execve", 221);
    sb_pair(names, nums, "mmap", 222); sb_pair(names, nums, "mprotect", 226);
    sb_pair(names, nums, "wait4", 260); sb_pair(names, nums, "ptrace", 117);
}

fn sb_lookup(name: str, x64: bool) -> i64 {
    var names: Vec<str> = Vec::new();
    var nums: Vec<i64> = Vec::new();
    if x64 {
        sb_x64_tab(& mut names, & mut nums);
    } else {
        sb_a64_tab(& mut names, & mut nums);
    }
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == name {
            return nums.get(i);
        }
        i = i + 1;
    }
    return - 1;
}

/// The x86-64 call number of a name, or -1 when not in the table.
pub fn sb_call_x64(name: str) -> i64 {
    return sb_lookup(name, true);
}

/// The AArch64 call number of a name, or -1.
pub fn sb_call_a64(name: str) -> i64 {
    return sb_lookup(name, false);
}

/// Allow a call by name for the given architecture (ignored when unknown).
pub fn bpf_allow_name(p: & mut BpfPolicy, name: str, arch: i64) {
    val nr: i64 = sb_lookup(name, arch != SB_ARCH_AARCH64);
    if nr >= 0 {
        bpf_allow(p, nr);
    }
}

// ─── Landlock ruleset objects (Linux) ───────────────────────────────────

// landlock access-right bits (linux/landlock.h), filesystem.
pub const LL_FS_EXECUTE: i64 = 1;
pub const LL_FS_WRITE_FILE: i64 = 2;
pub const LL_FS_READ_FILE: i64 = 4;
pub const LL_FS_READ_DIR: i64 = 8;
pub const LL_FS_REMOVE_DIR: i64 = 16;
pub const LL_FS_REMOVE_FILE: i64 = 32;
pub const LL_FS_MAKE_CHAR: i64 = 64;
pub const LL_FS_MAKE_DIR: i64 = 128;
pub const LL_FS_MAKE_REG: i64 = 256;
pub const LL_FS_MAKE_SOCK: i64 = 512;
pub const LL_FS_MAKE_FIFO: i64 = 1024;
pub const LL_FS_MAKE_BLOCK: i64 = 2048;
pub const LL_FS_MAKE_SYM: i64 = 4096;
pub const LL_FS_REFER: i64 = 8192;
pub const LL_FS_TRUNCATE: i64 = 16384;
// network
pub const LL_NET_BIND_TCP: i64 = 1;
pub const LL_NET_CONNECT_TCP: i64 = 2;

/// The filesystem access rights each Landlock ABI version added. ABI 1
/// handles bits 1..0x2000, ABI 2 adds REFER, ABI 3 adds TRUNCATE.
pub fn ll_fs_mask_for_abi(abi: i64) -> i64 {
    var m: i64 = 0x1FFF;  // bits 0..12 (EXECUTE..MAKE_SYM)
    if abi >= 2 { m = m | LL_FS_REFER; }
    if abi >= 3 { m = m | LL_FS_TRUNCATE; }
    return m;
}

/// A path-beneath rule: the rights allowed on everything under a directory.
pub struct LlPathRule {
    pub allowed: i64,
    pub path: str,
}

/// A TCP port rule: the action (bind/connect) allowed on a port.
pub struct LlPortRule {
    pub allowed: i64,
    pub port: i64,
}

pub struct LlRuleset {
    pub handled_fs: i64,
    pub handled_net: i64,
    pub paths: Vec<LlPathRule>,
    pub ports: Vec<LlPortRule>,
}

/// A ruleset that handles (and so by default denies) the given rights.
pub fn ll_new(handled_fs: i64, handled_net: i64) -> LlRuleset {
    return LlRuleset { handled_fs: handled_fs, handled_net: handled_net, paths: Vec::new(), ports: Vec::new() };
}

/// Allow `rights` on everything beneath `path`.
pub fn ll_allow_path(r: & mut LlRuleset, path: str, rights: i64) {
    r.paths.push(LlPathRule { allowed: rights, path: path });
}

/// Allow `action` (LL_NET_*) on `port`.
pub fn ll_allow_port(r: & mut LlRuleset, port: i64, action: i64) {
    r.ports.push(LlPortRule { allowed: action, port: port });
}

fn sb_put64le(o: & mut Vec<i64>, v: i64) {
    var i: i64 = 0;
    while i < 8 {
        o.push((v >> (i * 8)) & 255);
        i = i + 1;
    }
}

/// struct landlock_ruleset_attr: two u64 (handled_access_fs,
/// handled_access_net) masked to the rights an ABI version supports.
pub fn ll_ruleset_attr(r: & LlRuleset, abi: i64) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    var fs: i64 = r.handled_fs & ll_fs_mask_for_abi(abi);
    var net: i64 = 0;
    if abi >= 4 {
        net = r.handled_net & (LL_NET_BIND_TCP | LL_NET_CONNECT_TCP);
    }
    sb_put64le(& mut o, fs);
    sb_put64le(& mut o, net);
    return o;
}

/// struct landlock_path_beneath_attr: u64 allowed_access, then an s32 fd
/// placeholder (the kernel wants an open fd; -1 here since this module does
/// not open files).
pub fn ll_path_beneath_attr(rule: & LlPathRule, abi: i64) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    sb_put64le(& mut o, rule.allowed & ll_fs_mask_for_abi(abi));
    // fd as s32 = -1, then 4 bytes of padding to 16 (the struct is packed
    // in the kernel, but the syscall reads only the first 12 bytes)
    o.push(255); o.push(255); o.push(255); o.push(255);
    return o;
}

/// struct landlock_net_port_attr (ABI 4+): u64 allowed_access, u64 port.
pub fn ll_net_port_attr(rule: & LlPortRule) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    sb_put64le(& mut o, rule.allowed);
    sb_put64le(& mut o, rule.port);
    return o;
}

/// The rights a ruleset asks for that the given ABI cannot enforce (the
/// best-effort downgrade drops these). 0 when the ABI covers everything.
pub fn ll_unsupported_fs(r: & LlRuleset, abi: i64) -> i64 {
    return r.handled_fs & (0x7FFFFFFF ^ ll_fs_mask_for_abi(abi)) & r.handled_fs;
}

// ─── Windows job object / AppContainer settings (as data) ───────────────

// JOBOBJECT_BASIC_LIMIT_INFORMATION LimitFlags bits (winnt.h)
pub const JOB_LIMIT_ACTIVE_PROCESS: i64 = 0x00000008;
pub const JOB_LIMIT_PROCESS_MEMORY: i64 = 0x00000100;
pub const JOB_LIMIT_JOB_MEMORY: i64 = 0x00000200;
pub const JOB_LIMIT_KILL_ON_JOB_CLOSE: i64 = 0x00002000;
pub const JOB_LIMIT_BREAKAWAY_OK: i64 = 0x00000800;
pub const JOB_LIMIT_SILENT_BREAKAWAY: i64 = 0x00001000;

pub struct JobLimits {
    pub active_process_limit: i64,
    pub process_memory_limit: i64,
    pub job_memory_limit: i64,
    pub kill_on_close: bool,
    pub ui_restrictions: i64,
}

pub fn job_new() -> JobLimits {
    return JobLimits { active_process_limit: 0, process_memory_limit: 0, job_memory_limit: 0, kill_on_close: true, ui_restrictions: 0 };
}

/// The LimitFlags word a JobLimits produces.
pub fn job_limit_flags(j: & JobLimits) -> i64 {
    var f: i64 = 0;
    if j.active_process_limit > 0 { f = f | JOB_LIMIT_ACTIVE_PROCESS; }
    if j.process_memory_limit > 0 { f = f | JOB_LIMIT_PROCESS_MEMORY; }
    if j.job_memory_limit > 0 { f = f | JOB_LIMIT_JOB_MEMORY; }
    if j.kill_on_close { f = f | JOB_LIMIT_KILL_ON_JOB_CLOSE; }
    return f;
}

/// The extended-limit-information blob's basic section, abbreviated:
/// per_process_user_time (8, 0), per_job_user_time (8, 0), limit_flags (4),
/// minimum/maximum working set (8+8, 0), active process limit (4),
/// affinity (8, 0), priority class (4, 0), scheduling class (4, 0). This is
/// the exact head of JOBOBJECT_BASIC_LIMIT_INFORMATION (48 bytes, 64-bit).
pub fn job_basic_limit_bytes(j: & JobLimits) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    sb_put64le(& mut o, 0);  // PerProcessUserTimeLimit
    sb_put64le(& mut o, 0);  // PerJobUserTimeLimit
    sb_put32le(& mut o, job_limit_flags(j));  // LimitFlags
    sb_put32le(& mut o, 0);  // (padding to 8-byte alignment)
    sb_put64le(& mut o, 0);  // MinimumWorkingSetSize
    sb_put64le(& mut o, 0);  // MaximumWorkingSetSize
    sb_put32le(& mut o, j.active_process_limit);  // ActiveProcessLimit
    sb_put32le(& mut o, 0);  // (padding)
    sb_put64le(& mut o, 0);  // Affinity
    sb_put32le(& mut o, 0);  // PriorityClass
    sb_put32le(& mut o, 0);  // SchedulingClass
    return o;
}

// AppContainer / WinCapability well-known RIDs (a small set).
pub const APPCAP_INTERNET_CLIENT: i64 = 3;
pub const APPCAP_INTERNET_CLIENT_SERVER: i64 = 4;
pub const APPCAP_PRIVATE_NETWORK: i64 = 5;
pub const APPCAP_DOCUMENTS_LIBRARY: i64 = 7;
pub const APPCAP_PICTURES_LIBRARY: i64 = 8;

/// An AppContainer profile: a name and the capability RIDs it is granted.
pub struct AppContainer {
    pub name: str,
    pub capabilities: Vec<i64>,
}

pub fn appcontainer_new(name: str) -> AppContainer {
    return AppContainer { name: name, capabilities: Vec::new() };
}

pub fn appcontainer_add(a: & mut AppContainer, cap: i64) {
    a.capabilities.push(cap);
}

/// The capability SID subauthorities: every AppContainer capability SID is
/// S-1-15-3-<rid>, so this returns [15, 3, rid] (identifier authority,
/// first subauthority, the capability rid).
pub fn appcap_sid_parts(rid: i64) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    o.push(15);
    o.push(3);
    o.push(rid);
    return o;
}
