// Fides Queue standard library
//
// FIFO queue built on top of Vec.
// Uses a head index for O(1) dequeue (amortized, with periodic compaction).
//
// Usage:
//   use queue;
//   value q = Queue::new();
//   q.enqueue(1);
//   q.enqueue(2);
//   println(q.dequeue());   // 1
//   println(q.peek());      // 2

module queue;

use vec;

/// A FIFO queue backed by Vec with a head index.
pub struct Queue<T> {
    pub data: Vec,
    pub head: i64,
}

impl Queue {
    /// Create a new empty queue.
    pub fn new() -> Queue {
        return Queue { data: Vec::new(), head: 0 };
    }

    /// Add a value to the back of the queue.
    pub fn enqueue(self: Queue, value: i64) -> void {
        self.data.push(value);
    }

    /// Remove and return the front value. Returns 0 if empty.
    pub fn dequeue(self: Queue) -> i64 {
        if self.head >= self.data.len() { return 0; }
        var value = self.data.get(self.head);
        self.head = self.head + 1;
        // Compact when head reaches half the data size
        if self.head > 32 && self.head * 2 >= self.data.len() {
            self.compact();
        }
        return value;
    }

    /// Peek at the front value without removing it. Returns 0 if empty.
    pub fn peek(self: Queue) -> i64 {
        if self.head >= self.data.len() { return 0; }
        return self.data.get(self.head);
    }

    /// Check if the queue is empty.
    pub fn is_empty(self: Queue) -> bool {
        return self.head >= self.data.len();
    }

    /// Get the number of elements in the queue.
    pub fn len(self: Queue) -> i64 {
        var n = self.data.len() - self.head;
        if n < 0 { return 0; }
        return n;
    }

    /// Clear all elements from the queue.
    pub fn clear(self: Queue) -> void {
        self.data.clear();
        self.head = 0;
    }

    /// Compact internal storage by removing dequeued elements.
    fn compact(self: Queue) -> void {
        // Shift elements to the front
        var i = self.head;
        var j = 0;
        while i < self.data.len() {
            self.data.set(j, self.data.get(i));
            i = i + 1;
            j = j + 1;
        }
        // Pop the remaining elements
        while self.data.len() > j {
            self.data.pop();
        }
        self.head = 0;
    }

    /// Check if the queue contains a value (searches remaining elements).
    pub fn contains(self: Queue, value: i64) -> bool {
        var i = self.head;
        while i < self.data.len() {
            if self.data.get(i) == value {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /// Drain all elements into a Vec (front = first element).
    pub fn drain(self: Queue) -> Vec {
        var result = Vec::new();
        while !self.is_empty() {
            result.push(self.dequeue());
        }
        return result;
    }
}
