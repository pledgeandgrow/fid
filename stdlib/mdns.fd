// Fides mDNS (RFC 6762) and DNS-SD (RFC 6763) messages
//
// Real (pure computation):
//   - DNS messages (RFC 1035 section 4): header, questions, answer /
//     authority / additional records; names with compression on encode
//     (also inside PTR and SRV data, as RFC 6762 18.14 allows) and on
//     decode (pointers must point backwards, loops are refused), escaped
//     dots in instance names ("My\.Printer"), case-insensitive matching;
//   - records PTR, SRV, TXT (key=value strings, an empty TXT is one zero
//     byte), A, AAAA, and any other type as raw data; the mDNS bits: QU
//     (unicast-response, top bit of a question's class) and cache-flush
//     (top bit of a record's class);
//   - DNS-SD: a service (instance, type, domain, host, port, TXT, IPv4 and
//     IPv6 addresses), its announcement (PTR, SRV, TXT, A/AAAA with the
//     TTLs of RFC 6762 section 10: 120 s for host records, 4500 s for the
//     others, cache-flush on unique records), goodbye (TTL 0), queries
//     (also _services._dns-sd._udp enumeration), and a responder that
//     answers a query from a list of services with additional records and
//     known-answer suppression (RFC 6762 7.1).
//
// The transport is a seam. Messages are Vec<i64> of bytes, to be sent to
// MDNS_ADDR4 (224.0.0.251) or MDNS_ADDR6 (ff02::fb) on port 5353. Sending
// works with stdlib net (net_send_bytes_to to net_addr_create(MDNS_ADDR4,
// MDNS_PORT)); receiving multicast needs a socket that joined the group
// (IP_ADD_MEMBERSHIP), which stdlib net does not offer, so the caller's
// socket layer gives received datagrams to mdns_decode / mdns_respond.

module mdns;
 use vec; use string;

pub const MDNS_PORT: i64 = 5353;
pub const MDNS_ADDR4: str = "224.0.0.251";
pub const MDNS_ADDR6: str = "ff02::fb";

pub const MDNS_A: i64 = 1;
pub const MDNS_PTR: i64 = 12;
pub const MDNS_TXT: i64 = 16;
pub const MDNS_AAAA: i64 = 28;
pub const MDNS_SRV: i64 = 33;
pub const MDNS_ANY: i64 = 255;
pub const MDNS_IN: i64 = 1;

pub const MDNS_TTL_HOST: i64 = 120;
pub const MDNS_TTL_OTHER: i64 = 4500;

/// One resource record. `target` is the name in PTR and SRV data; `txt`
/// the TXT strings; `addr` the 4 or 16 address bytes; `rdata` the raw data
/// of other types.
pub struct MdnsRR {
    pub name: str,
    pub rtype: i64,
    pub rclass: i64,
    pub cache_flush: bool,
    pub ttl: i64,
    pub target: str,
    pub priority: i64,
    pub weight: i64,
    pub port: i64,
    pub txt: Vec<str>,
    pub addr: Vec<i64>,
    pub rdata: Vec<i64>,
}

pub struct MdnsMsg {
    pub id: i64,
    pub flags: i64,      // 0 for a query, 0x8400 for a response (QR, AA)
    pub q_names: Vec<str>,
    pub q_types: Vec<i64>,
    pub q_unicast: Vec<bool>,
    pub answers: Vec<MdnsRR>,
    pub authority: Vec<MdnsRR>,
    pub additional: Vec<MdnsRR>,
}

pub fn mdns_msg(flags: i64) -> MdnsMsg {
    return MdnsMsg {
        id: 0, flags: flags, q_names: Vec::new(), q_types: Vec::new(), q_unicast: Vec::new(), answers: Vec::new(), authority: Vec::new(), additional: Vec::new(),
    };
}

pub fn mdns_rr(name: str, rtype: i64, ttl: i64) -> MdnsRR {
    return MdnsRR {
        name: name, rtype: rtype, rclass: MDNS_IN, cache_flush: false, ttl: ttl, target: "", priority: 0, weight: 0, port: 0, txt: Vec::new(), addr: Vec::new(), rdata: Vec::new(),
    };
}

pub fn mdns_is_response(m: & MdnsMsg) -> bool {
    return (m.flags & 32768) != 0;
}

/// Add a question; `unicast` sets the QU bit.
pub fn mdns_question(m: & mut MdnsMsg, name: str, qtype: i64, unicast: bool) {
    m.q_names.push(name);
    m.q_types.push(qtype);
    m.q_unicast.push(unicast);
}

// ─── Names ───────────────────────────────────────────────────────────────

/// The labels of a name; "\." inside a label is a dot, "\\" a backslash.
pub fn mdns_labels(name: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var cur: str = "";
    var i: i64 = 0;
    val n: i64 = str_len(name);
    while i < n {
        val c: i64 = str_byte_at(name, i);
        if c == 92 && i + 1 < n {
            cur = cur + char_to_str(str_byte_at(name, i + 1));
            i = i + 2;
            continue;
        }
        if c == 46 {
            if cur != "" {
                out.push(cur);
            }
            cur = "";
        } else {
            cur = cur + char_to_str(c);
        }
        i = i + 1;
    }
    if cur != "" {
        out.push(cur);
    }
    return out;
}

fn md_escape(label: str) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < str_len(label) {
        val c: i64 = str_byte_at(label, i);
        if c == 46 || c == 92 {
            out = out + "\\";
        }
        out = out + char_to_str(c);
        i = i + 1;
    }
    return out;
}

fn md_join(labels: & Vec<str>, from: i64) -> str {
    var s: str = "";
    var i: i64 = from;
    while i < labels.len() {
        if i > from {
            s = s + ".";
        }
        s = s + md_escape(labels.get(i));
        i = i + 1;
    }
    return s;
}

/// Names compare without regard to ASCII case.
pub fn mdns_name_eq(a: str, b: str) -> bool {
    return str_to_lower(a) == str_to_lower(b);
}

// ─── Encoding ────────────────────────────────────────────────────────────

struct MdWriter {
    out: Vec<i64>,
    names: Vec<str>,   // lowercased suffixes already written
    offs: Vec<i64>,
    ok: bool,
}

fn md_put16(w: & mut MdWriter, v: i64) {
    w.out.push((v >> 8) & 255);
    w.out.push(v & 255);
}

fn md_put32(w: & mut MdWriter, v: i64) {
    md_put16(w, (v >> 16) & 65535);
    md_put16(w, v & 65535);
}

fn md_name(w: & mut MdWriter, name: str) {
    val labels: Vec<str> = mdns_labels(name);
    var total: i64 = 1;
    var i: i64 = 0;
    while i < labels.len() {
        val suffix: str = str_to_lower(md_join(& labels, i));
        var k: i64 = 0;
        while k < w.names.len() {
            if w.names.get(k) == suffix {
                md_put16(w, 49152 | w.offs.get(k));
                return;
            }
            k = k + 1;
        }
        if w.out.len() < 16384 {
            w.names.push(suffix);
            w.offs.push(w.out.len());
        }
        val lab: str = labels.get(i);
        val n: i64 = str_len(lab);
        total = total + n + 1;
        if n > 63 || total > 255 {
            w.ok = false;
        }
        w.out.push(n);
        var j: i64 = 0;
        while j < n {
            w.out.push(str_byte_at(lab, j));
            j = j + 1;
        }
        i = i + 1;
    }
    w.out.push(0);
}

fn md_rr(w: & mut MdWriter, r: & MdnsRR) {
    md_name(w, r.name);
    md_put16(w, r.rtype);
    var cls: i64 = r.rclass & 32767;
    if r.cache_flush {
        cls = cls | 32768;
    }
    md_put16(w, cls);
    md_put32(w, r.ttl);
    val lenpos: i64 = w.out.len();
    md_put16(w, 0);
    val start: i64 = w.out.len();
    if r.rtype == MDNS_PTR {
        md_name(w, r.target);
    } else if r.rtype == MDNS_SRV {
        md_put16(w, r.priority);
        md_put16(w, r.weight);
        md_put16(w, r.port);
        md_name(w, r.target);
    } else if r.rtype == MDNS_TXT {
        if r.txt.len() == 0 {
            w.out.push(0);
        }
        var i: i64 = 0;
        while i < r.txt.len() {
            val s: str = r.txt.get(i);
            val n: i64 = str_len(s);
            if n > 255 {
                w.ok = false;
            }
            w.out.push(n & 255);
            var j: i64 = 0;
            while j < n {
                w.out.push(str_byte_at(s, j));
                j = j + 1;
            }
            i = i + 1;
        }
    } else if r.rtype == MDNS_A || r.rtype == MDNS_AAAA {
        var i: i64 = 0;
        while i < r.addr.len() {
            w.out.push(r.addr.get(i) & 255);
            i = i + 1;
        }
    } else {
        var i: i64 = 0;
        while i < r.rdata.len() {
            w.out.push(r.rdata.get(i) & 255);
            i = i + 1;
        }
    }
    val len: i64 = w.out.len() - start;
    w.out.set(lenpos, (len >> 8) & 255);
    w.out.set(lenpos + 1, len & 255);
}

/// Encode a message with name compression ([] when a label is over 63
/// bytes, a name over 255 or a TXT string over 255).
pub fn mdns_encode(m: & MdnsMsg) -> Vec<i64> {
    var w: MdWriter = MdWriter {
        out: Vec::new(), names: Vec::new(), offs: Vec::new(), ok: true
    };
    md_put16(& mut w, m.id);
    md_put16(& mut w, m.flags);
    md_put16(& mut w, m.q_names.len());
    md_put16(& mut w, m.answers.len());
    md_put16(& mut w, m.authority.len());
    md_put16(& mut w, m.additional.len());
    var i: i64 = 0;
    while i < m.q_names.len() {
        md_name(& mut w, m.q_names.get(i));
        md_put16(& mut w, m.q_types.get(i));
        var cls: i64 = MDNS_IN;
        if m.q_unicast.get(i) {
            cls = cls | 32768;
        }
        md_put16(& mut w, cls);
        i = i + 1;
    }
    i = 0;
    while i < m.answers.len() {
        md_rr(& mut w, & m.answers.get(i));
        i = i + 1;
    }
    i = 0;
    while i < m.authority.len() {
        md_rr(& mut w, & m.authority.get(i));
        i = i + 1;
    }
    i = 0;
    while i < m.additional.len() {
        md_rr(& mut w, & m.additional.get(i));
        i = i + 1;
    }
    if !w.ok {
        return Vec::new();
    }
    return w.out;
}

// ─── Decoding ────────────────────────────────────────────────────────────

struct MdReader {
    b: Vec<i64>,
    pos: i64,
    ok: bool,
    error: str,
}

fn md_fail(r: & mut MdReader, why: str) {
    if r.ok {
        r.ok = false;
        r.error = why;
    }
}

fn md_u8(r: & mut MdReader) -> i64 {
    if r.pos >= r.b.len() {
        md_fail(r, "truncated");
        return 0;
    }
    val v: i64 = r.b.get(r.pos);
    r.pos = r.pos + 1;
    return v;
}

fn md_u16(r: & mut MdReader) -> i64 {
    val hi: i64 = md_u8(r);
    return (hi << 8) | md_u8(r);
}

fn md_u32(r: & mut MdReader) -> i64 {
    val hi: i64 = md_u16(r);
    return (hi << 16) | md_u16(r);
}

// A name at r.pos (r.pos moves past it; pointers are followed).
fn md_get_name(r: & mut MdReader) -> str {
    var labels: Vec<str> = Vec::new();
    var p: i64 = r.pos;
    var jumped: bool = false;
    var hops: i64 = 0;
    var total: i64 = 1;
    loop {
        if p >= r.b.len() {
            md_fail(r, "name runs past the end");
            return "";
        }
        val len: i64 = r.b.get(p);
        if len == 0 {
            if !jumped {
                r.pos = p + 1;
            }
            break;
        }
        if (len & 192) == 192 {
            if p + 1 >= r.b.len() {
                md_fail(r, "pointer cut short");
                return "";
            }
            val target: i64 = ((len & 63) << 8) | r.b.get(p + 1);
            if target >= p || hops > 64 {
                md_fail(r, "compression pointer not backwards");
                return "";
            }
            if !jumped {
                r.pos = p + 2;
            }
            jumped = true;
            hops = hops + 1;
            p = target;
            continue;
        }
        if (len & 192) != 0 {
            md_fail(r, "bad label type");
            return "";
        }
        if p + 1 + len > r.b.len() {
            md_fail(r, "label runs past the end");
            return "";
        }
        total = total + len + 1;
        if total > 255 {
            md_fail(r, "name longer than 255");
            return "";
        }
        var lab: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < len {
            lab.push(r.b.get(p + 1 + i));
            i = i + 1;
        }
        labels.push(str_from_bytes(lab));
        p = p + 1 + len;
    }
    return md_join(& labels, 0);
}

fn md_get_rr(r: & mut MdReader) -> MdnsRR {
    val name: str = md_get_name(r);
    var x: MdnsRR = mdns_rr(name, md_u16(r), 0);
    val cls: i64 = md_u16(r);
    x.rclass = cls & 32767;
    x.cache_flush = (cls & 32768) != 0;
    x.ttl = md_u32(r);
    val len: i64 = md_u16(r);
    val start: i64 = r.pos;
    val end: i64 = start + len;
    if end > r.b.len() {
        md_fail(r, "record data runs past the end");
        return x;
    }
    if x.rtype == MDNS_PTR {
        x.target = md_get_name(r);
    } else if x.rtype == MDNS_SRV {
        x.priority = md_u16(r);
        x.weight = md_u16(r);
        x.port = md_u16(r);
        x.target = md_get_name(r);
    } else if x.rtype == MDNS_TXT {
        while r.ok && r.pos < end {
            val n: i64 = md_u8(r);
            if r.pos + n > end {
                md_fail(r, "TXT string runs past the record");
                return x;
            }
            var s: Vec<i64> = Vec::new();
            var i: i64 = 0;
            while i < n {
                s.push(r.b.get(r.pos + i));
                i = i + 1;
            }
            r.pos = r.pos + n;
            if n > 0 {
                x.txt.push(str_from_bytes(s));
            }
        }
    } else {
        var i: i64 = start;
        while i < end {
            if x.rtype == MDNS_A || x.rtype == MDNS_AAAA {
                x.addr.push(r.b.get(i));
            } else {
                x.rdata.push(r.b.get(i));
            }
            i = i + 1;
        }
        if (x.rtype == MDNS_A && len != 4) || (x.rtype == MDNS_AAAA && len != 16) {
            md_fail(r, "address of the wrong length");
        }
        r.pos = end;
    }
    if r.ok && r.pos != end {
        md_fail(r, "record data length mismatch");
    }
    return x;
}

pub struct MdnsDecoded {
    pub ok: bool,
    pub error: str,
    pub msg: MdnsMsg,
}

pub fn mdns_decode(b: Vec<i64>) -> MdnsDecoded {
    var r: MdReader = MdReader {
        b: b, pos: 0, ok: true, error: ""
    };
    var m: MdnsMsg = mdns_msg(0);
    m.id = md_u16(& mut r);
    m.flags = md_u16(& mut r);
    val qd: i64 = md_u16(& mut r);
    val an: i64 = md_u16(& mut r);
    val ns: i64 = md_u16(& mut r);
    val ar: i64 = md_u16(& mut r);
    var i: i64 = 0;
    while i < qd && r.ok {
        m.q_names.push(md_get_name(& mut r));
        m.q_types.push(md_u16(& mut r));
        m.q_unicast.push((md_u16(& mut r) & 32768) != 0);
        i = i + 1;
    }
    i = 0;
    while i < an && r.ok {
        m.answers.push(md_get_rr(& mut r));
        i = i + 1;
    }
    i = 0;
    while i < ns && r.ok {
        m.authority.push(md_get_rr(& mut r));
        i = i + 1;
    }
    i = 0;
    while i < ar && r.ok {
        m.additional.push(md_get_rr(& mut r));
        i = i + 1;
    }
    return MdnsDecoded {
        ok: r.ok, error: r.error, msg: m
    };
}

/// "My Printer._ipp._tcp.local 4500 PTR ..." for logs and tests.
pub fn mdns_rr_text(x: & MdnsRR) -> str {
    var s: str = x.name + " " + int_to_str(x.ttl) + " ";
    if x.cache_flush {
        s = s + "flush ";
    }
    if x.rtype == MDNS_PTR {
        return s + "PTR " + x.target;
    }
    if x.rtype == MDNS_SRV {
        return s + "SRV " + int_to_str(x.priority) + " " + int_to_str(x.weight) + " " + int_to_str(x.port) + " " + x.target;
    }
    if x.rtype == MDNS_TXT {
        return s + "TXT " + str_join(x.txt, " ");
    }
    if x.rtype == MDNS_A {
        return s + "A " + mdns_ipv4_text(& x.addr);
    }
    if x.rtype == MDNS_AAAA {
        return s + "AAAA " + mdns_ipv6_text(& x.addr);
    }
    return s + "TYPE" + int_to_str(x.rtype) + " " + int_to_str(x.rdata.len()) + " bytes";
}

pub fn mdns_ipv4_text(a: & Vec<i64>) -> str {
    var s: str = "";
    var i: i64 = 0;
    while i < a.len() {
        if i > 0 {
            s = s + ".";
        }
        s = s + int_to_str(a.get(i));
        i = i + 1;
    }
    return s;
}

/// IPv6 text with the longest run of zero groups as "::" (RFC 5952).
pub fn mdns_ipv6_text(a: & Vec<i64>) -> str {
    if a.len() != 16 {
        return "";
    }
    var g: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 8 {
        g.push((a.get(2 * i) << 8) | a.get(2 * i + 1));
        i = i + 1;
    }
    var best: i64 = - 1;
    var best_len: i64 = 0;
    i = 0;
    while i < 8 {
        if g.get(i) == 0 {
            var j: i64 = i;
            while j < 8 && g.get(j) == 0 {
                j = j + 1;
            }
            if j - i > best_len && j - i >= 2 {
                best = i;
                best_len = j - i;
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    val digits: str = "0123456789abcdef";
    var s: str = "";
    i = 0;
    while i < 8 {
        if i == best {
            s = s + "::";
            i = i + best_len;
            continue;
        }
        if s != "" && !str_ends_with(s, ":") {
            s = s + ":";
        }
        var h: str = "";
        var v: i64 = g.get(i);
        if v == 0 {
            h = "0";
        }
        while v > 0 {
            h = str_slice(digits, v & 15, (v & 15) + 1) + h;
            v = v >> 4;
        }
        s = s + h;
        i = i + 1;
    }
    return s;
}

// ─── DNS-SD services ─────────────────────────────────────────────────────

pub struct MdnsService {
    pub instance: str,   // "My Printer"
    pub stype: str,      // "_ipp._tcp"
    pub domain: str,     // "local"
    pub host: str,       // "printer.local"
    pub port: i64,
    pub txt: Vec<str>,   // "key=value"
    pub ipv4: Vec<i64>,  // 4 bytes, or []
    pub ipv6: Vec<i64>,  // 16 bytes, or []
}

pub fn mdns_service(instance: str, stype: str, host: str, port: i64) -> MdnsService {
    return MdnsService {
        instance: instance, stype: stype, domain: "local", host: host, port: port, txt: Vec::new(), ipv4: Vec::new(), ipv6: Vec::new(),
    };
}

/// "_ipp._tcp.local"
pub fn mdns_service_type_name(s: & MdnsService) -> str {
    return s.stype + "." + s.domain;
}

/// "My Printer._ipp._tcp.local" (dots in the instance escaped).
pub fn mdns_instance_name(s: & MdnsService) -> str {
    return md_escape(s.instance) + "." + s.stype + "." + s.domain;
}

fn md_ptr(s: & MdnsService, ttl: i64) -> MdnsRR {
    var p: MdnsRR = mdns_rr(mdns_service_type_name(s), MDNS_PTR, ttl);
    p.target = mdns_instance_name(s);
    return p;
}

fn md_srv(s: & MdnsService, ttl: i64) -> MdnsRR {
    var x: MdnsRR = mdns_rr(mdns_instance_name(s), MDNS_SRV, ttl);
    x.port = s.port;
    x.target = s.host;
    x.cache_flush = true;
    return x;
}

fn md_txt(s: & MdnsService, ttl: i64) -> MdnsRR {
    var x: MdnsRR = mdns_rr(mdns_instance_name(s), MDNS_TXT, ttl);
    x.txt = s.txt;
    x.cache_flush = true;
    return x;
}

fn md_addrs(s: & MdnsService, ttl: i64, out: & mut Vec<MdnsRR>) {
    if s.ipv4.len() == 4 {
        var a: MdnsRR = mdns_rr(s.host, MDNS_A, ttl);
        a.addr = s.ipv4;
        a.cache_flush = true;
        out.push(a);
    }
    if s.ipv6.len() == 16 {
        var a: MdnsRR = mdns_rr(s.host, MDNS_AAAA, ttl);
        a.addr = s.ipv6;
        a.cache_flush = true;
        out.push(a);
    }
}

fn md_ttl(goodbye: bool, ttl: i64) -> i64 {
    if goodbye {
        return 0;
    }
    return ttl;
}

/// The announcement of a service (send it twice, one second apart, RFC
/// 6762 8.3); `goodbye` sets every TTL to 0 (10.1).
pub fn mdns_announce(s: & MdnsService, goodbye: bool) -> MdnsMsg {
    var m: MdnsMsg = mdns_msg(33792);
    m.answers.push(md_ptr(s, md_ttl(goodbye, MDNS_TTL_OTHER)));
    m.answers.push(md_srv(s, md_ttl(goodbye, MDNS_TTL_HOST)));
    m.answers.push(md_txt(s, md_ttl(goodbye, MDNS_TTL_OTHER)));
    var addrs: Vec<MdnsRR> = Vec::new();
    md_addrs(s, md_ttl(goodbye, MDNS_TTL_HOST), & mut addrs);
    var i: i64 = 0;
    while i < addrs.len() {
        m.answers.push(addrs.get(i));
        i = i + 1;
    }
    return m;
}

/// A query for `name`/`qtype`; `known` answers the asker already has go
/// in the answer section (known-answer suppression).
pub fn mdns_query(name: str, qtype: i64, unicast: bool, known: Vec<MdnsRR>) -> MdnsMsg {
    var m: MdnsMsg = mdns_msg(0);
    mdns_question(& mut m, name, qtype, unicast);
    m.answers = known;
    return m;
}

/// The DNS-SD enumeration name of `domain`: "_services._dns-sd._udp.local".
pub fn mdns_enum_name(domain: str) -> str {
    return "_services._dns-sd._udp." + domain;
}

fn md_known(q: & MdnsMsg, x: & MdnsRR) -> bool {
    var i: i64 = 0;
    while i < q.answers.len() {
        val k: MdnsRR = q.answers.get(i);
        if k.rtype == x.rtype && mdns_name_eq(k.name, x.name) && mdns_name_eq(k.target, x.target) && k.ttl * 2 >= x.ttl {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn md_has(v: & Vec<MdnsRR>, x: & MdnsRR) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        val k: MdnsRR = v.get(i);
        if k.rtype == x.rtype && mdns_name_eq(k.name, x.name) && mdns_name_eq(k.target, x.target) && k.txt.len() == x.txt.len() && k.addr.len() == x.addr.len() {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn md_add(v: & mut Vec<MdnsRR>, x: MdnsRR) {
    if !md_has(v, & x) {
        v.push(x);
    }
}

/// Answer a query from `services`: PTR for a service type (and the
/// enumeration name), SRV/TXT for an instance, A/AAAA for a host, with
/// the records a resolver needs next as additional records. Answers the
/// query already lists (with at least half our TTL) are left out. An
/// empty response (no answers) means: stay silent.
pub fn mdns_respond(services: & Vec<MdnsService>, q: & MdnsMsg) -> MdnsMsg {
    var m: MdnsMsg = mdns_msg(33792);
    if mdns_is_response(q) {
        return m;
    }
    var i: i64 = 0;
    while i < q.q_names.len() {
        val qn: str = q.q_names.get(i);
        val qt: i64 = q.q_types.get(i);
        var k: i64 = 0;
        while k < services.len() {
            val s: MdnsService = services.get(k);
            if (qt == MDNS_PTR || qt == MDNS_ANY) && mdns_name_eq(qn, mdns_enum_name(s.domain)) {
                var e: MdnsRR = mdns_rr(qn, MDNS_PTR, MDNS_TTL_OTHER);
                e.target = mdns_service_type_name(& s);
                if !md_known(q, & e) {
                    md_add(& mut m.answers, e);
                }
            }
            if (qt == MDNS_PTR || qt == MDNS_ANY) && mdns_name_eq(qn, mdns_service_type_name(& s)) {
                val p: MdnsRR = md_ptr(& s, MDNS_TTL_OTHER);
                if !md_known(q, & p) {
                    md_add(& mut m.answers, p);
                    md_add(& mut m.additional, md_srv(& s, MDNS_TTL_HOST));
                    md_add(& mut m.additional, md_txt(& s, MDNS_TTL_OTHER));
                    md_addrs(& s, MDNS_TTL_HOST, & mut m.additional);
                }
            }
            if mdns_name_eq(qn, mdns_instance_name(& s)) {
                if qt == MDNS_SRV || qt == MDNS_ANY {
                    md_add(& mut m.answers, md_srv(& s, MDNS_TTL_HOST));
                    md_addrs(& s, MDNS_TTL_HOST, & mut m.additional);
                }
                if qt == MDNS_TXT || qt == MDNS_ANY {
                    md_add(& mut m.answers, md_txt(& s, MDNS_TTL_OTHER));
                }
            }
            if mdns_name_eq(qn, s.host) && (qt == MDNS_A || qt == MDNS_AAAA || qt == MDNS_ANY) {
                var hostrr: Vec<MdnsRR> = Vec::new();
                md_addrs(& s, MDNS_TTL_HOST, & mut hostrr);
                var j: i64 = 0;
                while j < hostrr.len() {
                    val h: MdnsRR = hostrr.get(j);
                    if qt == MDNS_ANY || h.rtype == qt {
                        md_add(& mut m.answers, h);
                    } else {
                        md_add(& mut m.additional, h);
                    }
                    j = j + 1;
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    // an additional record that is also an answer is not repeated
    var a: i64 = 0;
    while a < m.additional.len() {
        if md_has(& m.answers, & m.additional.get(a)) {
            m.additional.remove(a);
        } else {
            a = a + 1;
        }
    }
    return m;
}

/// Read a TXT string "key=value": the value of `key` ("" when absent).
pub fn mdns_txt_get(txt: & Vec<str>, key: str) -> str {
    var i: i64 = 0;
    while i < txt.len() {
        val s: str = txt.get(i);
        val eq: i64 = str_find(s, "=");
        if eq > 0 && mdns_name_eq(str_slice(s, 0, eq), key) {
            return str_slice(s, eq + 1, str_len(s));
        }
        if eq < 0 && mdns_name_eq(s, key) {
            return "";
        }
        i = i + 1;
    }
    return "";
}
