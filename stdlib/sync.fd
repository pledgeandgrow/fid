// Fides Concurrency standard library
//
// Provides OS threads, atomics, and mutex for shared-memory parallelism.
// In the interpreter, threads use Rust's std::thread.
// In C codegen, threads use pthread + C11 stdatomic.
// In native builds, threads use clone() syscall (pending).
//
// Usage:
//   use sync;
//   value counter = sync_atomic_alloc(0);
//   value m = sync_mutex_create();
//   sync_mutex_lock(m);
//   sync_atomic_add(counter, 1);
//   sync_mutex_unlock(m);
//
//   value fut = spawn increment(counter, m);
//   value result = await fut;

module sync;

/// Allocate a shared atomic i64 slot, initialized to 0.
/// Returns an address that can be used with atomic operations.
pub fn sync_atomic_alloc(initial: i64) -> i64 {
    var addr = p_shared_alloc(8);
    p_atomic_store(addr, initial);
    return addr;
}

/// Atomically load the value at an address.
pub fn sync_atomic_load(addr: i64) -> i64 {
    return p_atomic_load(addr);
}

/// Atomically store a value at an address.
pub fn sync_atomic_store(addr: i64, value: i64) -> void {
    p_atomic_store(addr, value);
}

/// Atomically compare-and-swap. Returns true if the swap succeeded.
pub fn sync_atomic_cas(addr: i64, expected: i64, new_val: i64) -> bool {
    return p_atomic_cas(addr, expected, new_val);
}

/// Atomically add a value. Returns the old value before the add.
pub fn sync_atomic_add(addr: i64, value: i64) -> i64 {
    return p_atomic_add(addr, value);
}

/// Create a mutex. Returns a mutex handle.
pub fn sync_mutex_create() -> i64 {
    return p_mutex_init();
}

/// Lock a mutex (blocks if contended by another thread).
pub fn sync_mutex_lock(m: i64) -> void {
    p_mutex_lock(m);
}

/// Unlock a mutex.
pub fn sync_mutex_unlock(m: i64) -> void {
    p_mutex_unlock(m);
}

// ═══════════════════════════════════════════════════════════════════════════
// Thread-Local Storage (TLS)
// ═══════════════════════════════════════════════════════════════════════════
//
// Thread-local storage allows each thread to have its own copy of a variable.
// This is equivalent to Rust's `thread_local!` macro.
//
// Usage:
//   value key = sync_tls_create();     // create a TLS key
//   sync_tls_set(key, 42);             // set value for current thread
//   value v = sync_tls_get(key);       // get value for current thread (0 if unset)
//
// Note: TLS values are per-thread. Setting a value in one thread does not
// affect the value seen by other threads.

/// Create a thread-local storage key. Returns a key handle.
/// Each thread can store its own value for this key.
pub fn sync_tls_create() -> i64 {
    return p_tls_create();
}

/// Get the thread-local value for the current thread. Returns 0 if unset.
pub fn sync_tls_get(key: i64) -> i64 {
    return p_tls_get(key);
}

/// Set the thread-local value for the current thread.
pub fn sync_tls_set(key: i64, value: i64) -> void {
    p_tls_set(key, value);
}

// ═══════════════════════════════════════════════════════════════════════════
// RwLock — reader-writer lock (multiple readers OR one writer)
// ═══════════════════════════════════════════════════════════════════════════

/// Create a reader-writer lock. Returns a handle.
/// Allows multiple concurrent readers or one exclusive writer.
pub fn sync_rwlock_create() -> i64 {
    // RwLock is implemented as a mutex + reader count
    var lock = p_mutex_init();
    var reader_count = p_shared_alloc(8);
    p_atomic_store(reader_count, 0);
    // Pack: handle = lock | (reader_count << 32) — but we just return the lock
    // and use a separate allocation for reader count.
    // For simplicity, we return a struct pointer: [lock, reader_count]
    var handle = p_shared_alloc(16);
    unsafe {
        var lock_ptr: *mut i64 = handle;
        *lock_ptr = lock;
        var rc_ptr: *mut i64 = handle + 8;
        *rc_ptr = reader_count;
    }
    return handle;
}

/// Acquire a read lock (shared — multiple readers allowed).
pub fn sync_rwlock_read_lock(rwlock: i64) -> void {
    var lock_ptr: *mut i64 = rwlock;
    var rc_ptr: *mut i64 = rwlock + 8;
    unsafe {
        p_mutex_lock(*lock_ptr);
        // Atomically increment reader count. p_atomic_add returns the OLD value.
        // If old value was 0, we're the first reader — keep the lock.
        // Otherwise, release the lock (other readers already have access).
        var old_rc = p_atomic_add(*rc_ptr, 1);
        if old_rc != 0 {
            p_mutex_unlock(*lock_ptr);
        }
    }
}

/// Release a read lock.
pub fn sync_rwlock_read_unlock(rwlock: i64) -> void {
    var lock_ptr: *mut i64 = rwlock;
    var rc_ptr: *mut i64 = rwlock + 8;
    unsafe {
        // Atomically decrement reader count. If old value was 1, we're the
        // last reader — release the lock so writers can acquire it.
        var old_rc = p_atomic_add(*rc_ptr, -1);
        if old_rc == 1 {
            p_mutex_unlock(*lock_ptr);
        }
    }
}

/// Acquire a write lock (exclusive — no other readers or writers).
pub fn sync_rwlock_write_lock(rwlock: i64) -> void {
    var lock_ptr: *mut i64 = rwlock;
    unsafe {
        p_mutex_lock(*lock_ptr);
    }
}

/// Release a write lock.
pub fn sync_rwlock_write_unlock(rwlock: i64) -> void {
    var lock_ptr: *mut i64 = rwlock;
    unsafe {
        p_mutex_unlock(*lock_ptr);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// AtomicU64 — convenience wrapper for atomic 64-bit operations
// ═══════════════════════════════════════════════════════════════════════════

/// Create an AtomicU64 initialized to the given value.
pub fn atomic_u64_new(initial: i64) -> i64 {
    return sync_atomic_alloc(initial);
}

/// Atomically load an AtomicU64.
pub fn atomic_u64_load(addr: i64) -> i64 {
    return p_atomic_load(addr);
}

/// Atomically store a value to an AtomicU64.
pub fn atomic_u64_store(addr: i64, value: i64) -> void {
    p_atomic_store(addr, value);
}

/// Atomically add a value to an AtomicU64. Returns the old value.
pub fn atomic_u64_fetch_add(addr: i64, value: i64) -> i64 {
    return p_atomic_add(addr, value);
}

/// Atomically compare-and-swap. Returns true if successful.
pub fn atomic_u64_cas(addr: i64, expected: i64, new_val: i64) -> bool {
    return p_atomic_cas(addr, expected, new_val);
}

/// Spawn a function as a new OS thread.
/// Returns a Future handle. Use `await` to join the thread and get the result.
/// The function must take i64 parameters and return i64.
pub fn sync_spawn(func_name: str, num_args: i64) -> i64 {
    return p_thread_spawn(func_name, num_args);
}

// ═══════════════════════════════════════════════════════════════════════════
// Channels — bounded, thread-safe message passing
// ═══════════════════════════════════════════════════════════════════════════
//
// Channels are the preferred way to communicate between threads.
// They follow CSP (Communicating Sequential Processes) semantics:
//   - Bounded buffer (sender blocks when full, receiver blocks when empty)
//   - Closing a channel signals completion to receivers
//   - try_recv is non-blocking (returns PENDING_SENTINEL if empty)
//
// Usage:
//   value ch = sync_channel_create(8);   // bounded buffer of capacity 8
//   sync_channel_send(ch, 42);         // blocks if buffer is full
//   value value = sync_channel_recv(ch);    // blocks if buffer is empty
//   sync_channel_close(ch);            // signal no more sends
//   value value = sync_channel_try_recv(ch); // non-blocking (PENDING_SENTINEL if empty)
//
// Sentinel value returned by try_recv when the channel is empty.
// This is i64::MIN + 1 = -9223372036854775807.
pub const SYNC_CHAN_PENDING: i64 = -9223372036854775807;

/// Create a bounded channel with the given capacity.
/// Returns a channel handle (i64).
pub fn sync_channel_create(capacity: i64) -> i64 {
    return p_chan_create(capacity);
}

/// Send a value through the channel. Blocks if the buffer is full.
/// Returns true if the value was sent, false if the channel is closed.
pub fn sync_channel_send(ch: i64, value: i64) -> bool {
    return p_chan_send(ch, value);
}

/// Receive a value from the channel. Blocks if the buffer is empty.
/// Returns the value, or SYNC_CHAN_PENDING if the channel is closed and empty.
pub fn sync_channel_recv(ch: i64) -> i64 {
    return p_chan_recv(ch);
}

/// Non-blocking receive. Returns the value if available,
/// SYNC_CHAN_PENDING if the channel is empty (but not closed),
/// or 0 if the channel is closed and empty.
pub fn sync_channel_try_recv(ch: i64) -> i64 {
    return p_chan_try_recv(ch);
}

/// Close the channel. Signals receivers that no more values will be sent.
pub fn sync_channel_close(ch: i64) -> void {
    p_chan_close(ch);
}

/// Check if the channel has been closed.
pub fn sync_channel_is_closed(ch: i64) -> bool {
    return p_chan_is_closed(ch);
}
