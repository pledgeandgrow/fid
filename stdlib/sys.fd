// Fides System standard library
//
// Low-level system information: architecture, platform, memory, CPU count.
// Wraps runtime functions and environment variables. Linux and macOS go
// through sysconf and the POSIX id functions (macOS's own _SC_ numbers),
// Windows through GetSystemInfo, GlobalMemoryStatusEx and
// GetCurrentProcessId (@cfg picks the host's; see sx_sysconf).
//
// Usage:
//   use sys;
//   println(sys_arch());       // "x86_64"
//   println(sys_cpu_count());  // 8
//   println(sys_page_size());  // 4096

module sys;
use vec;
use os;
// ─── FFI declarations ───────────────────────────────────────────────────

// SAFETY: the prototypes come from <unistd.h>, checked by the C compiler;
// every function takes and returns plain integers.
extern "C" include "<unistd.h>" {
    fn sysconf as pledge_sysconf(name: i64) -> i64;
    fn getpagesize as pledge_getpagesize() -> i64;
    fn getuid as pledge_getuid() -> i64;
    fn getgid as pledge_getgid() -> i64;
    fn getpid as pledge_getpid() -> i64;
    fn getppid as pledge_getppid() -> i64;
}

// SAFETY: kernel32 functions, declared by <windows.h>, which every
// generated C file includes on Windows (`<stdint.h>` only makes the C
// backend use the system's prototypes; native Windows imports them from
// kernel32.dll). `info` is the address of a zeroed block this module
// allocated, longer than the structure the function fills (SYSTEM_INFO
// 48 bytes, MEMORYSTATUSEX 64). Only @cfg(windows) functions call them.
extern "C" include "<stdint.h>" {
    fn GetSystemInfo as sw_sysinfo(info: i64);
    fn GlobalMemoryStatusEx as sw_memstatus(info: i64) -> i32;
    fn GetCurrentProcessId as sw_getpid() -> i64;
}

// sysconf constants (Linux values; sx_sysconf maps them on other systems)
pub const _SC_PAGESIZE: i64 = 30;
pub const _SC_CLK_TCK: i64 = 2;
pub const _SC_NPROCESSORS_ONLN: i64 = 84;
pub const _SC_NPROCESSORS_CONF: i64 = 83;
pub const _SC_PHYS_PAGES: i64 = 85;
pub const _SC_AVPHYS_PAGES: i64 = 86;
// ─── Per-system primitives (@cfg) ───────────────────────────────────────
// sx_sysconf(name) takes the Linux _SC_ numbers above; -1 when the system
// has no such figure. The POSIX functions are only called on Linux and
// macOS (the Windows C library has no sysconf, getuid, ...); Windows has
// no user or group ids (0) and no cheap parent process id (0).

// A zeroed block of n bytes (0 when the allocation fails); freed by the
// caller with p_free.
fn sx_block(n: i64) -> i64 {
    var b: i64 = 0;
    // SAFETY: p_malloc only allocates a fresh n-byte block; it is zeroed
    // below before anything reads it.
    unsafe {
        b = p_malloc(n);
    }
    if b == 0 {
        return 0;
    }
    var i: i64 = 0;
    while i < n {
        var p: *mut u8 = (b + i) as *mut u8;
        // SAFETY: i < n, inside the block just allocated.
        unsafe {
            *p = 0 as u8;
        }
        i = i + 1;
    }
    return b;
}

// The little-endian unsigned value of `n` bytes at buf + off.
fn sx_get(buf: i64, off: i64, n: i64) -> i64 {
    var v: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var p: *mut u8 = (buf + off + i) as *mut u8;
        var b: i64 = 0;
        // SAFETY: every caller reads inside a block from sx_block.
        unsafe {
            b = (*p) as i64;
        }
        v = v | ((b & 255) << (8 * i));
        i = i + 1;
    }
    return v;
}

// SYSTEM_INFO: dwPageSize at 4, dwNumberOfProcessors at 32.
@cfg(windows)
fn sx_sysinfo_field(off: i64) -> i64 {
    val b: i64 = sx_block(64);
    if b == 0 {
        return -1;
    }
    // SAFETY: GetSystemInfo writes one SYSTEM_INFO (48 bytes) at b, the
    // zeroed 64-byte block sx_block just returned (b != 0 checked above).
    unsafe {
        sw_sysinfo(b);
    }
    val v: i64 = sx_get(b, off, 4);
    // SAFETY: b is the sx_block (p_malloc) block of this call; v was read
    // out of it above and nothing uses b after this.
    unsafe {
        p_free(b);
    }
    return v;
}

// MEMORYSTATUSEX (dwLength 64 set first): ullTotalPhys at 8, ullAvailPhys
// at 16.
@cfg(windows)
fn sx_memory_field(off: i64) -> i64 {
    val b: i64 = sx_block(72);
    if b == 0 {
        return -1;
    }
    var p: *mut u8 = b as *mut u8;
    // SAFETY: the first byte of the 72-byte block (dwLength = 64).
    unsafe {
        *p = 64 as u8;
    }
    var v: i64 = -1;
    var ok: i32 = 0;
    // SAFETY: GlobalMemoryStatusEx reads dwLength (64, set above) and fills
    // one 64-byte MEMORYSTATUSEX at b, inside the 72-byte zeroed block from
    // sx_block (b != 0 checked above).
    unsafe {
        ok = sw_memstatus(b);
    }
    if ok != 0 {
        v = sx_get(b, off, 8);
    }
    // SAFETY: b is this call's sx_block (p_malloc) block; the value was
    // copied into v above and nothing uses b after this.
    unsafe {
        p_free(b);
    }
    return v;
}

@cfg(windows)
fn sx_sysconf(name: i64) -> i64 {
    if name == _SC_NPROCESSORS_ONLN || name == _SC_NPROCESSORS_CONF {
        return sx_sysinfo_field(32);
    }
    if name == _SC_PAGESIZE {
        return sx_sysinfo_field(4);
    }
    if name == _SC_PHYS_PAGES || name == _SC_AVPHYS_PAGES {
        var off: i64 = 8;
        if name == _SC_AVPHYS_PAGES {
            off = 16;
        }
        val bytes: i64 = sx_memory_field(off);
        val ps: i64 = sx_sysinfo_field(4);
        if bytes < 0 || ps <= 0 {
            return -1;
        }
        return bytes / ps;
    }
    return -1;
}

@cfg(windows)
fn sx_pagesize() -> i64 {
    return sx_sysinfo_field(4);
}

@cfg(windows)
fn sx_getpid() -> i64 {
    // SAFETY: GetCurrentProcessId takes no arguments and only returns the
    // calling process's id; no memory of ours is touched.
    unsafe {
        return sw_getpid() & 0xFFFFFFFF;
    }
}

@cfg(windows)
fn sx_getppid() -> i64 {
    return 0;
}

@cfg(windows)
fn sx_getuid() -> i64 {
    return 0;
}

@cfg(windows)
fn sx_getgid() -> i64 {
    return 0;
}

@cfg(linux)
fn sx_sysconf(name: i64) -> i64 {
    // SAFETY: sysconf takes an integer name and returns an integer (-1 for
    // an unknown name); it reads and writes no memory of ours.
    unsafe {
        return pledge_sysconf(name);
    }
}

@cfg(linux)
fn sx_pagesize() -> i64 {
    // SAFETY: getpagesize takes no arguments and returns an integer.
    unsafe {
        return pledge_getpagesize();
    }
}

@cfg(linux)
fn sx_getpid() -> i64 {
    // SAFETY: getpid takes no arguments, cannot fail, returns an integer.
    unsafe {
        return pledge_getpid();
    }
}

@cfg(linux)
fn sx_getppid() -> i64 {
    // SAFETY: getppid takes no arguments, cannot fail, returns an integer.
    unsafe {
        return pledge_getppid();
    }
}

@cfg(linux)
fn sx_getuid() -> i64 {
    // SAFETY: getuid takes no arguments, cannot fail, returns an integer.
    unsafe {
        return pledge_getuid();
    }
}

@cfg(linux)
fn sx_getgid() -> i64 {
    // SAFETY: getgid takes no arguments, cannot fail, returns an integer.
    unsafe {
        return pledge_getgid();
    }
}

// macOS numbers its _SC_ names differently (<unistd.h> of Darwin) and has
// no _SC_AVPHYS_PAGES.
@cfg(macos)
fn sx_sysconf(name: i64) -> i64 {
    var m: i64 = -1;
    if name == _SC_PAGESIZE {
        m = 29;
    } else if name == _SC_CLK_TCK {
        m = 3;
    } else if name == _SC_NPROCESSORS_CONF {
        m = 57;
    } else if name == _SC_NPROCESSORS_ONLN {
        m = 58;
    } else if name == _SC_PHYS_PAGES {
        m = 200;
    }
    if m < 0 {
        return -1;
    }
    // SAFETY: sysconf takes an integer name (a Darwin _SC_ number here) and
    // returns an integer; it reads and writes no memory of ours.
    unsafe {
        return pledge_sysconf(m);
    }
}

@cfg(macos)
fn sx_pagesize() -> i64 {
    // SAFETY: getpagesize takes no arguments and returns an integer.
    unsafe {
        return pledge_getpagesize();
    }
}

@cfg(macos)
fn sx_getpid() -> i64 {
    // SAFETY: getpid takes no arguments, cannot fail, returns an integer.
    unsafe {
        return pledge_getpid();
    }
}

@cfg(macos)
fn sx_getppid() -> i64 {
    // SAFETY: getppid takes no arguments, cannot fail, returns an integer.
    unsafe {
        return pledge_getppid();
    }
}

@cfg(macos)
fn sx_getuid() -> i64 {
    // SAFETY: getuid takes no arguments, cannot fail, returns an integer.
    unsafe {
        return pledge_getuid();
    }
}

@cfg(macos)
fn sx_getgid() -> i64 {
    // SAFETY: getgid takes no arguments, cannot fail, returns an integer.
    unsafe {
        return pledge_getgid();
    }
}
// ─── CPU / Architecture ─────────────────────────────────────────────────

/// Get the CPU architecture. @cfg resolves it for the build target
/// (x86_64 on the host; aarch64/riscv64/wasm32 on cross targets);
/// PLEDGE_ARCH overrides.
pub fn sys_arch() -> str {
    var arch = os_getenv("PLEDGE_ARCH");
    if str_len(arch) > 0 {
        return arch;
    }
    return sys_target_arch();
}

/// The architecture @cfg sees for this build ("x86_64" when unset, since
/// fid runs on x86-64 hosts).
@cfg(aarch64)
fn sys_target_arch() -> str {
    return "aarch64";
}

@cfg(riscv64)
fn sys_target_arch() -> str {
    return "riscv64";
}

@cfg(wasm32)
fn sys_target_arch() -> str {
    return "wasm32";
}

@cfg(x86_64)
fn sys_target_arch() -> str {
    return "x86_64";
}

/// Get the number of processors currently online.
///
/// Example (native only):
///   assert(sys_cpu_count() >= 1);
///   assert(sys_page_size() >= 4096);
///   assert(sys_pid() > 0);
///   assert(str_len(sys_arch()) > 0);
pub fn sys_cpu_count() -> i64 {
    var n = sx_sysconf(_SC_NPROCESSORS_ONLN);
    if n > 0 {
        return n;
    }
    return 1;
}

/// Get the number of configured processors.
pub fn sys_cpu_count_conf() -> i64 {
    var n = sx_sysconf(_SC_NPROCESSORS_CONF);
    if n > 0 {
        return n;
    }
    return 1;
}

// ─── Memory ─────────────────────────────────────────────────────────────

/// Get the system page size in bytes.
pub fn sys_page_size() -> i64 {
    var ps = sx_pagesize();
    if ps > 0 {
        return ps;
    }
    return 4096;
}

/// Get total physical memory in bytes.
pub fn sys_total_memory() -> i64 {
    var pages = sx_sysconf(_SC_PHYS_PAGES);
    if pages < 0 {
        return 0;
    }
    var page_size = sys_page_size();
    return pages * page_size;
}

/// Get available (free) physical memory in bytes.
pub fn sys_available_memory() -> i64 {
    var pages = sx_sysconf(_SC_AVPHYS_PAGES);
    if pages < 0 {
        return 0;
    }
    var page_size = sys_page_size();
    return pages * page_size;
}

/// Get total memory in KB (rounded).
pub fn sys_total_memory_kb() -> i64 {
    return sys_total_memory() / 1024;
}

/// Get total memory in MB (rounded).
pub fn sys_total_memory_mb() -> i64 {
    return sys_total_memory() / (1024 * 1024);
}

/// Get total memory in GB (rounded).
pub fn sys_total_memory_gb() -> i64 {
    return sys_total_memory() / (1024 * 1024 * 1024);
}

// ─── Process info ───────────────────────────────────────────────────────

/// Get the current process ID.
pub fn sys_pid() -> i64 {
    return sx_getpid();
}

/// Get the parent process ID (0 on Windows).
pub fn sys_ppid() -> i64 {
    return sx_getppid();
}

/// Get the user ID (0 on Windows, which has none).
pub fn sys_uid() -> i64 {
    return sx_getuid();
}

/// Get the group ID (0 on Windows, which has none).
pub fn sys_gid() -> i64 {
    return sx_getgid();
}

// ─── Clock ticks ────────────────────────────────────────────────────────

/// Get the clock ticks per second.
pub fn sys_clk_tck() -> i64 {
    var tck = sx_sysconf(_SC_CLK_TCK);
    if tck > 0 {
        return tck;
    }
    return 100;
}

// ─── Platform detection ─────────────────────────────────────────────────

/// Check if running on Linux.
pub fn sys_is_linux() -> bool {
    return str_equal(os_name(), "linux");
}

/// Check if running on macOS.
pub fn sys_is_macos() -> bool {
    var name = os_name();
    return str_equal(name, "darwin") || str_equal(name, "macos");
}

/// Check if running on Windows.
pub fn sys_is_windows() -> bool {
    var name = os_name();
    return str_equal(name, "windows") || str_equal(name, "win32");
}

/// Check if running on a 64-bit system.
pub fn sys_is_64bit() -> bool {
    return str_contains(sys_arch(), "64");
}

/// Check if running on a 32-bit system.
pub fn sys_is_32bit() -> bool {
    return !sys_is_64bit();
}

// ─── Endianness ─────────────────────────────────────────────────────────

/// Check if the system is little-endian. Every architecture fid can
/// target (x86_64, aarch64, riscv64, wasm32) is little-endian, so this
/// is true on all of them; kept as a function for forward compatibility.
pub fn sys_is_little_endian() -> bool {
    var arch = sys_arch();
    if str_contains(arch, "mips") {
        return false;
    }
    if str_contains(arch, "s390") {
        return false;
    }
    if str_contains(arch, "sparc") {
        return false;
    }
    if str_contains(arch, "powerpc") || str_contains(arch, "ppc") {
        return false;
    }
    return true;
}

/// Check if the system is big-endian.
pub fn sys_is_big_endian() -> bool {
    return !sys_is_little_endian();
}

// ─── System info struct ─────────────────────────────────────────────────

/// A struct containing system information.
pub struct SystemInfo {
    pub arch: str,
    pub os_name: str,
    pub cpu_count: i64,
    pub memory_bytes: i64,
    pub page_size: i64,
    pub pid: i64,
    pub uid: i64,
}

/// Gather system information into a struct.
pub fn sys_info() -> SystemInfo {
    return SystemInfo {
        arch: sys_arch(), os_name: os_name(), cpu_count: sys_cpu_count(), memory_bytes: sys_total_memory(), page_size: sys_page_size(), pid: sys_pid(), uid: sys_uid(),
    };
}

/// Format system info as a human-readable string.
pub fn sys_info_string(info: SystemInfo) -> str {
    var result = "OS: ";
    result = result + info.os_name;
    result = result + "\nArch: ";
    result = result + info.arch;
    result = result + "\nCPUs: ";
    result = result + int_to_str(info.cpu_count);
    result = result + "\nMemory: ";
    result = result + int_to_str(info.memory_bytes / (1024 * 1024));
    result = result + " MB\nPage size: ";
    result = result + int_to_str(info.page_size);
    result = result + "\nPID: ";
    result = result + int_to_str(info.pid);
    result = result + "\nUID: ";
    result = result + int_to_str(info.uid);
    return result;
}
