// Fides Channels — bounded MPSC (multi-producer single-consumer) queues
//
// Channels provide thread-safe message passing between OS threads.
// A channel is created with a fixed capacity. Senders block when the
// buffer is full; receivers block when the buffer is empty.
//
// Usage:
//   use channel;
//   value ch = channel_create(10);  // bounded channel with capacity 10
//   channel_send(ch, 42);         // send a value
//   value value = channel_recv(ch);    // receive a value (blocks if empty)
//   channel_close(ch);            // close the channel
//
// With threads:
//   value ch = channel_create(10);
//   value fut = spawn producer(ch);
//   value value = channel_recv(ch);    // blocks until producer sends
//   channel_close(ch);
//   value _ = await fut;
//
// Limitations:
//   - Values are i64 only (Fides channels transport raw i64 values)
//   - In the interpreter, send/recv use spin-yield (no condvar)
//   - In C codegen, send/recv use pthread mutex + condvar (true blocking)

module channel;

/// Sentinel value returned by channel_recv when the channel is closed and empty.
/// This is i64::MIN + 1 (0x8000000000000001).
pub fn CHAN_CLOSED() -> i64 { return -9223372036854775807; }

/// Create a bounded channel with the given capacity.
/// Returns a channel handle (i64) that can be shared across threads.
pub fn channel_create(capacity: i64) -> i64 {
    return p_chan_create(capacity);
}

/// Send a value on the channel. Blocks if the channel is full.
/// Returns true if the value was sent, false if the channel is closed.
pub fn channel_send(ch: i64, value: i64) -> bool {
    return p_chan_send(ch, value);
}

/// Receive a value from the channel. Blocks if the channel is empty.
/// Returns the value, or CHAN_CLOSED if the channel is closed and empty.
pub fn channel_recv(ch: i64) -> i64 {
    return p_chan_recv(ch);
}

/// Try to receive a value from the channel without blocking.
/// Returns the value if available, CHAN_CLOSED if closed and empty,
/// or CHAN_PENDING if the channel is empty but not closed.
pub fn channel_try_recv(ch: i64) -> i64 {
    return p_chan_try_recv(ch);
}

/// Close the channel. After closing, no more values can be sent.
/// Pending values can still be received. Receivers wake up and get
/// CHAN_CLOSED when the buffer is drained.
pub fn channel_close(ch: i64) -> void {
    p_chan_close(ch);
}

/// Check if the channel is closed.
pub fn channel_is_closed(ch: i64) -> bool {
    return p_chan_is_closed(ch);
}
