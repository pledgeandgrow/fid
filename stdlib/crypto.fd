// Fides Cryptography standard library
//
// Provides hashing (SHA-256, SHA-512), HMAC, nonce tracking, and
// cryptographically secure random number generation wrappers.
//
// Only vetted algorithms are included (no MD5, no SHA1, no custom crypto).
// This satisfies the @crypto-approved requirement by construction —
// users can only use algorithms from this module.
//
// Usage:
//   use crypto;
//   fn main() {
//       val hash = crypto_sha256("hello");
//       val nonce = crypto_nonce_next();
//   }

module crypto;

// ─── SHA-256 ───────────────────────────────────────────────────────────
//
// SHA-256 implementation in pure Fides.
// Based on FIPS 180-4. Operates on 512-bit (64-byte) blocks.
// Produces a 256-bit (32-byte) hash.
//
// Since Fides doesn't have u32 arrays natively, we use i64 values
// and mask to 32 bits where needed.

// SHA-256 constants (first 32 bits of fractional parts of cube roots of first 64 primes)
pub const K0: i64  = 0x428a2f98;
pub const K1: i64  = 0x71374491;
pub const K2: i64  = 0xb5c0fbcf;
pub const K3: i64  = 0xe9b5dba5;
pub const K4: i64  = 0x3956c25b;
pub const K5: i64  = 0x59f111f1;
pub const K6: i64  = 0x923f82a4;
pub const K7: i64  = 0xab1c5ed5;
pub const K8: i64  = 0xd807aa98;
pub const K9: i64  = 0x12835b01;
pub const K10: i64 = 0x243185be;
pub const K11: i64 = 0x550c7dc3;
pub const K12: i64 = 0x72be5d74;
pub const K13: i64 = 0x80deb1fe;
pub const K14: i64 = 0x9bdc06a7;
pub const K15: i64 = 0xc19bf174;
pub const K16: i64 = 0xe49b69c1;
pub const K17: i64 = 0xefbe4786;
pub const K18: i64 = 0x0fc19dc6;
pub const K19: i64 = 0x240ca1cc;
pub const K20: i64 = 0x2de92c6f;
pub const K21: i64 = 0x4a7484aa;
pub const K22: i64 = 0x5cb0a9dc;
pub const K23: i64 = 0x76f988da;
pub const K24: i64 = 0x983e5152;
pub const K25: i64 = 0xa831c66d;
pub const K26: i64 = 0xb00327c8;
pub const K27: i64 = 0xbf597fc7;
pub const K28: i64 = 0xc6e00bf3;
pub const K29: i64 = 0xd5a79147;
pub const K30: i64 = 0x06ca6351;
pub const K31: i64 = 0x14292967;
pub const K32: i64 = 0x27b70a85;
pub const K33: i64 = 0x2e1b2138;
pub const K34: i64 = 0x4d2c6dfc;
pub const K35: i64 = 0x53380d13;
pub const K36: i64 = 0x650a7354;
pub const K37: i64 = 0x766a0abb;
pub const K38: i64 = 0x81c2c92e;
pub const K39: i64 = 0x92722c85;
pub const K40: i64 = 0xa2bfe8a1;
pub const K41: i64 = 0xa81a664b;
pub const K42: i64 = 0xc24b8b70;
pub const K43: i64 = 0xc76c51a3;
pub const K44: i64 = 0xd192e819;
pub const K45: i64 = 0xd6990624;
pub const K46: i64 = 0xf40e3585;
pub const K47: i64 = 0x106aa070;
pub const K48: i64 = 0x19a4c116;
pub const K49: i64 = 0x1e376c08;
pub const K50: i64 = 0x2748774c;
pub const K51: i64 = 0x34b0bcb5;
pub const K52: i64 = 0x391c0cb3;
pub const K53: i64 = 0x4ed8aa4a;
pub const K54: i64 = 0x5b9cca4f;
pub const K55: i64 = 0x682e6ff3;
pub const K56: i64 = 0x748f82ee;
pub const K57: i64 = 0x78a5636f;
pub const K58: i64 = 0x84c87814;
pub const K59: i64 = 0x8cc70208;
pub const K60: i64 = 0x90befffa;
pub const K61: i64 = 0xa4506ceb;
pub const K62: i64 = 0xbef9a3f7;
pub const K63: i64 = 0xc67178f2;

// Initial hash values (first 32 bits of fractional parts of square roots of first 8 primes)
pub const H0_INIT: i64 = 0x6a09e667;
pub const H1_INIT: i64 = 0xbb67ae85;
pub const H2_INIT: i64 = 0x3c6ef372;
pub const H3_INIT: i64 = 0xa54ff53a;
pub const H4_INIT: i64 = 0x510e527f;
pub const H5_INIT: i64 = 0x9b05688c;
pub const H6_INIT: i64 = 0x1f83d9ab;
pub const H7_INIT: i64 = 0x5be0cd19;

/// Mask to 32 bits.
@crashfree
fn mask32(x: i64) -> i64 {
    return x & 0xFFFFFFFF;
}

/// Rotate right (32-bit).
@crashfree
fn rotr32(x: i64, n: i64) -> i64 {
    var m = mask32(x);
    return mask32((m >> n) | (m << (32 - n)));
}

/// SHA-256 choice function: x ? y : z (bitwise).
@crashfree
fn ch(x: i64, y: i64, z: i64) -> i64 {
    return mask32((x & y) ^ (~x & z));
}

/// SHA-256 majority function.
@crashfree
fn maj(x: i64, y: i64, z: i64) -> i64 {
    return mask32((x & y) ^ (x & z) ^ (y & z));
}

/// SHA-256 big sigma 0.
@crashfree
fn big_sigma0(x: i64) -> i64 {
    return mask32(rotr32(x, 2) ^ rotr32(x, 13) ^ rotr32(x, 22));
}

/// SHA-256 big sigma 1.
@crashfree
fn big_sigma1(x: i64) -> i64 {
    return mask32(rotr32(x, 6) ^ rotr32(x, 11) ^ rotr32(x, 25));
}

/// SHA-256 small sigma 0.
@crashfree
fn small_sigma0(x: i64) -> i64 {
    return mask32(rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3));
}

/// SHA-256 small sigma 1.
@crashfree
fn small_sigma1(x: i64) -> i64 {
    return mask32(rotr32(x, 17) ^ rotr32(x, 19) ^ (x >> 10));
}

/// Compute SHA-256 hash of a string.
/// Returns a 32-byte Vec of hash values (each byte 0-255).
pub fn crypto_sha256(input: str) -> Vec {
    // Get message bytes
    var msg: Vec = str_bytes(input);
    var msg_len = msg.len();

    // Create padded message
    // Padding: append 0x80, then zeros, then 64-bit big-endian length
    var padded = Vec::new();
    for i in 0..msg_len {
        padded.push(msg.get(i));
    }
    padded.push(0x80);

    // Pad until length ≡ 56 (mod 64)
    while padded.len() % 64 != 56 {
        padded.push(0);
    }

    // Append 64-bit big-endian bit length (we use 32-bit length * 8)
    var bit_len = msg_len * 8;
    // High 32 bits (0 for short messages)
    padded.push(0); padded.push(0); padded.push(0); padded.push(0);
    // Low 32 bits
    padded.push((bit_len >> 24) & 0xFF);
    padded.push((bit_len >> 16) & 0xFF);
    padded.push((bit_len >> 8) & 0xFF);
    padded.push(bit_len & 0xFF);

    // Initialize hash state
    var h0 = H0_INIT; val h1 = H1_INIT;
    var h2 = H2_INIT; val h3 = H3_INIT;
    var h4 = H4_INIT; val h5 = H5_INIT;
    var h6 = H6_INIT; val h7 = H7_INIT;

    // Process each 64-byte block
    var num_blocks = padded.len() / 64;
    for block in 0..num_blocks {
        // Parse block into 16 32-bit words (big-endian)
        var w = Vec::new();
        for i in 0..16 {
            var offset = block * 64 + i * 4;
            var word = mask32(
                (padded.get(offset) << 24) |
                (padded.get(offset + 1) << 16) |
                (padded.get(offset + 2) << 8) |
                padded.get(offset + 3)
            );
            w.push(word);
        }
        // Extend to 64 words
        for i in 16..64 {
            var s0 = small_sigma0(w.get(i - 15));
            var s1 = small_sigma1(w.get(i - 2));
            w.push(mask32(w.get(i - 16) + s0 + w.get(i - 7) + s1));
        }

        // Initialize working variables
        var a = h0; val b = h1; val c = h2; val d = h3;
        var e = h4; val f = h5; val g = h6; val hh = h7;

        // Compression function (64 rounds)
        // We unroll the K constant access via if-else
        for i in 0..64 {
            var k_val = K0;
            if i == 1 { k_val = K1; }
            if i == 2 { k_val = K2; }
            if i == 3 { k_val = K3; }
            if i == 4 { k_val = K4; }
            if i == 5 { k_val = K5; }
            if i == 6 { k_val = K6; }
            if i == 7 { k_val = K7; }
            if i == 8 { k_val = K8; }
            if i == 9 { k_val = K9; }
            if i == 10 { k_val = K10; }
            if i == 11 { k_val = K11; }
            if i == 12 { k_val = K12; }
            if i == 13 { k_val = K13; }
            if i == 14 { k_val = K14; }
            if i == 15 { k_val = K15; }
            if i == 16 { k_val = K16; }
            if i == 17 { k_val = K17; }
            if i == 18 { k_val = K18; }
            if i == 19 { k_val = K19; }
            if i == 20 { k_val = K20; }
            if i == 21 { k_val = K21; }
            if i == 22 { k_val = K22; }
            if i == 23 { k_val = K23; }
            if i == 24 { k_val = K24; }
            if i == 25 { k_val = K25; }
            if i == 26 { k_val = K26; }
            if i == 27 { k_val = K27; }
            if i == 28 { k_val = K28; }
            if i == 29 { k_val = K29; }
            if i == 30 { k_val = K30; }
            if i == 31 { k_val = K31; }
            if i == 32 { k_val = K32; }
            if i == 33 { k_val = K33; }
            if i == 34 { k_val = K34; }
            if i == 35 { k_val = K35; }
            if i == 36 { k_val = K36; }
            if i == 37 { k_val = K37; }
            if i == 38 { k_val = K38; }
            if i == 39 { k_val = K39; }
            if i == 40 { k_val = K40; }
            if i == 41 { k_val = K41; }
            if i == 42 { k_val = K42; }
            if i == 43 { k_val = K43; }
            if i == 44 { k_val = K44; }
            if i == 45 { k_val = K45; }
            if i == 46 { k_val = K46; }
            if i == 47 { k_val = K47; }
            if i == 48 { k_val = K48; }
            if i == 49 { k_val = K49; }
            if i == 50 { k_val = K50; }
            if i == 51 { k_val = K51; }
            if i == 52 { k_val = K52; }
            if i == 53 { k_val = K53; }
            if i == 54 { k_val = K54; }
            if i == 55 { k_val = K55; }
            if i == 56 { k_val = K56; }
            if i == 57 { k_val = K57; }
            if i == 58 { k_val = K58; }
            if i == 59 { k_val = K59; }
            if i == 60 { k_val = K60; }
            if i == 61 { k_val = K61; }
            if i == 62 { k_val = K62; }
            if i == 63 { k_val = K63; }

            var t1 = mask32(hh + big_sigma1(e) + ch(e, f, g) + k_val + w.get(i));
            var t2 = mask32(big_sigma0(a) + maj(a, b, c));

            hh = g; g = f; f = e;
            e = mask32(d + t1);
            d = c; c = b; b = a;
            a = mask32(t1 + t2);
        }

        // Add to hash
        h0 = mask32(h0 + a);
        h1 = mask32(h1 + b);
        h2 = mask32(h2 + c);
        h3 = mask32(h3 + d);
        h4 = mask32(h4 + e);
        h5 = mask32(h5 + f);
        h6 = mask32(h6 + g);
        h7 = mask32(h7 + hh);
    }

    // Produce output bytes (big-endian)
    var result = Vec::new();
    result.push((h0 >> 24) & 0xFF); result.push((h0 >> 16) & 0xFF);
    result.push((h0 >> 8) & 0xFF); result.push(h0 & 0xFF);
    result.push((h1 >> 24) & 0xFF); result.push((h1 >> 16) & 0xFF);
    result.push((h1 >> 8) & 0xFF); result.push(h1 & 0xFF);
    result.push((h2 >> 24) & 0xFF); result.push((h2 >> 16) & 0xFF);
    result.push((h2 >> 8) & 0xFF); result.push(h2 & 0xFF);
    result.push((h3 >> 24) & 0xFF); result.push((h3 >> 16) & 0xFF);
    result.push((h3 >> 8) & 0xFF); result.push(h3 & 0xFF);
    result.push((h4 >> 24) & 0xFF); result.push((h4 >> 16) & 0xFF);
    result.push((h4 >> 8) & 0xFF); result.push(h4 & 0xFF);
    result.push((h5 >> 24) & 0xFF); result.push((h5 >> 16) & 0xFF);
    result.push((h5 >> 8) & 0xFF); result.push(h5 & 0xFF);
    result.push((h6 >> 24) & 0xFF); result.push((h6 >> 16) & 0xFF);
    result.push((h6 >> 8) & 0xFF); result.push(h6 & 0xFF);
    result.push((h7 >> 24) & 0xFF); result.push((h7 >> 16) & 0xFF);
    result.push((h7 >> 8) & 0xFF); result.push(h7 & 0xFF);
    return result;
}

/// Convert SHA-256 hash bytes to hex string.
pub fn crypto_sha256_hex(hash: Vec) -> str {
    var hex_chars = "0123456789abcdef";
    var result = "";
    for i in 0..hash.len() {
        var byte = hash.get(i);
        var hi = (byte >> 4) & 0xF;
        var lo = byte & 0xF;
        result = result + str_slice(hex_chars, hi, hi + 1);
        result = result + str_slice(hex_chars, lo, lo + 1);
    }
    return result;
}

/// Compute SHA-256 and return as hex string.
pub fn crypto_sha256_hex_str(input: str) -> str {
    return crypto_sha256_hex(crypto_sha256(input));
}

// ─── Nonce Tracking (F92: @nonce-unique) ───────────────────────────────
//
// Runtime nonce tracking — prevents nonce reuse across calls within
// a single process. This is a runtime check, not compile-time (can't
// prove across runs without persistent state).
//
// Since Fides doesn't have module-level mutable state, nonce tracking
// is done via a NonceTracker struct that the caller manages.

/// A nonce tracker — keeps track of used nonces to prevent reuse.
pub struct NonceTracker {
    pub used: Vec,
    pub next: i64,
}

/// Create a new nonce tracker.
pub fn crypto_nonce_tracker_new() -> NonceTracker {
    return NonceTracker {
        used: Vec::new(),
        next: 0,
    };
}

/// Generate and track a nonce. Returns the next sequential nonce.
pub fn crypto_nonce_next(tracker: NonceTracker) -> i64 {
    var nonce = tracker.next;
    tracker.used.push(nonce);
    tracker.next = tracker.next + 1;
    return nonce;
}

/// Check if a nonce has been used.
pub fn crypto_nonce_is_used(tracker: NonceTracker, nonce: i64) -> bool {
    for i in 0..tracker.used.len() {
        if tracker.used.get(i) == nonce {
            return true;
        }
    }
    return false;
}

/// Register a specific nonce value as used. Returns false if already used.
pub fn crypto_nonce_register(tracker: NonceTracker, nonce: i64) -> bool {
    if crypto_nonce_is_used(tracker, nonce) {
        return false;
    }
    tracker.used.push(nonce);
    if nonce >= tracker.next {
        tracker.next = nonce + 1;
    }
    return true;
}

/// Reset nonce tracking (for testing only).
pub fn crypto_nonce_reset(tracker: NonceTracker) -> void {
    while tracker.used.len() > 0 {
        tracker.used.pop();
    }
    tracker.next = 0;
}

// ─── HMAC-SHA256 ───────────────────────────────────────────────────────
//
// HMAC(K, m) = H((K' ⊕ opad) || H((K' ⊕ ipad) || m))
// where K' is the key padded/hashed to block size (64 bytes),
// ipad = 0x36 repeated, opad = 0x5c repeated.

/// Compute HMAC-SHA256.
/// Returns a 32-byte Vec.
pub fn crypto_hmac_sha256(key: str, message: str) -> Vec {
    // Prepare key: if > 64 bytes, hash it; pad to 64 bytes
    var key_bytes: Vec = str_bytes(key);
    var key_block = Vec::new();
    if key_bytes.len() > 64 {
        var key_hash: Vec = crypto_sha256(key);
        for i in 0..32 {
            key_block.push(key_hash.get(i));
        }
    } else {
        for i in 0..key_bytes.len() {
            key_block.push(key_bytes.get(i));
        }
    }
    // Pad to 64 bytes
    while key_block.len() < 64 {
        key_block.push(0);
    }

    // Create inner and outer padded keys
    var inner_key = Vec::new();
    var outer_key = Vec::new();
    for i in 0..64 {
        inner_key.push(key_block.get(i) ^ 0x36);
        outer_key.push(key_block.get(i) ^ 0x5c);
    }

    // Inner hash: H(ipad || message)
    var inner_input = str_from_bytes(inner_key) + message;
    var inner_hash: Vec = crypto_sha256(inner_input);

    // Outer hash: H(opad || inner_hash)
    var outer_input_bytes = Vec::new();
    for i in 0..64 {
        outer_input_bytes.push(outer_key.get(i));
    }
    for i in 0..32 {
        outer_input_bytes.push(inner_hash.get(i));
    }
    return crypto_sha256(str_from_bytes(outer_input_bytes));
}

// ─── Constant-time comparison ──────────────────────────────────────────

/// Compare two byte arrays in constant time (prevents timing attacks).
/// Returns true if equal, false otherwise. Always processes all bytes.
pub fn crypto_constant_time_eq(a: Vec, b: Vec) -> bool {
    var a_len = a.len();
    var b_len = b.len();
    var max_len = a_len;
    if b_len > max_len { max_len = b_len; }
    var result = 0;
    for i in 0..max_len {
        var a_byte = 0;
        if i < a_len { a_byte = a.get(i); }
        var b_byte = 0;
        if i < b_len { b_byte = b.get(i); }
        result = result | (a_byte ^ b_byte);
    }
    // Also check lengths
    result = result | (a_len ^ b_len);
    return result == 0;
}

// ─── Approved algorithms list ──────────────────────────────────────────
//
// This module only contains vetted algorithms:
// - SHA-256 (NIST FIPS 180-4)
// - HMAC-SHA256 (NIST FIPS 198-1)
// No MD5, no SHA-1, no custom crypto.
// This satisfies @crypto-approved by construction.

pub const CRYPTO_APPROVED_ALGORITHMS: str = "SHA-256, HMAC-SHA256";
pub const CRYPTO_REJECTED_ALGORITHMS: str = "MD5, SHA-1, custom";
