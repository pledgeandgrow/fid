// Fides Unicode standard library
//
// Unicode-aware string operations on top of encoding.fd's UTF-8 codec:
//   codepoint iteration, case mapping, grapheme-cluster segmentation,
//   and character classification.
//
// Scope (honest): full Unicode tables are ~megabytes, so this module
// implements the ranges that cover most real text —
//   case:      ASCII, Latin-1 Supplement, Latin Extended-A, Greek, Cyrillic
//   classes:   letters/digits for those scripts + CJK/Hangul/Hiragana ranges
//   graphemes: base + combining marks + ZWJ sequences + regional indicators
// No full normalization (NFC/NFKC) — see uni_normalize_lite() for the
// common accented-Latin subset.
//
// Usage:
//   use unicode;
//   println(uni_upper("héllo"));          // HÉLLO
//   println(int_to_str(uni_graphemes("a̐é").len()));

module unicode;

use vec;
use string;
use encoding;

// ─── Codepoint iteration ────────────────────────────────────────────────

// True when the `count` bytes from `at` are all continuation bytes (10xxxxxx).
fn uni_cont(s: str, at: i64, count: i64) -> bool {
    var k: i64 = 0;
    while k < count {
        if (str_byte_at(s, at + k) & 192) != 128 { return false; }
        k = k + 1;
    }
    return true;
}

/// Decode a UTF-8 string into a Vec of codepoints (invalid bytes → U+FFFD).
pub fn uni_to_codepoints(s: str) -> Vec {
    var out: Vec = Vec::new();
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i < n {
        var b: i64 = str_byte_at(s, i);
        if b < 128 {
            out.push(b);
            i = i + 1;
        } else if b >= 192 && b < 224 && i + 1 < n && uni_cont(s, i + 1, 1) {
            var b1: i64 = str_byte_at(s, i + 1);
            out.push(((b & 31) << 6) | (b1 & 63));
            i = i + 2;
        } else if b >= 224 && b < 240 && i + 2 < n && uni_cont(s, i + 1, 2) {
            var b2: i64 = str_byte_at(s, i + 1);
            var b3: i64 = str_byte_at(s, i + 2);
            out.push(((b & 15) << 12) | ((b2 & 63) << 6) | (b3 & 63));
            i = i + 3;
        } else if b >= 240 && b + 3 < 248 && i + 3 < n && uni_cont(s, i + 1, 3) {
            var c2: i64 = str_byte_at(s, i + 1);
            var c3: i64 = str_byte_at(s, i + 2);
            var c4: i64 = str_byte_at(s, i + 3);
            out.push(((b & 7) << 18) | ((c2 & 63) << 12) |
                     ((c3 & 63) << 6) | (c4 & 63));
            i = i + 4;
        } else {
            out.push(65533);   // U+FFFD
            i = i + 1;
        }
    }
    return out;
}

/// Encode one codepoint as UTF-8.
pub fn uni_encode_cp(cp: i64) -> str {
    var bytes: Vec = Vec::new();
    if cp < 0 { bytes.push(239); bytes.push(191); bytes.push(189); }
    else if cp < 128 { bytes.push(cp); }
    else if cp < 2048 {
        bytes.push(192 | (cp >> 6));
        bytes.push(128 | (cp & 63));
    } else if cp < 65536 {
        bytes.push(224 | (cp >> 12));
        bytes.push(128 | ((cp >> 6) & 63));
        bytes.push(128 | (cp & 63));
    } else {
        bytes.push(240 | (cp >> 18));
        bytes.push(128 | ((cp >> 12) & 63));
        bytes.push(128 | ((cp >> 6) & 63));
        bytes.push(128 | (cp & 63));
    }
    return str_from_bytes(bytes);
}

/// Encode a Vec of codepoints into a UTF-8 string.
pub fn uni_from_codepoints(cps: Vec) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < cps.len() {
        out = out + uni_encode_cp(cps.get(i));
        i = i + 1;
    }
    return out;
}

/// Number of codepoints (not bytes) in a string.
pub fn uni_len(s: str) -> i64 {
    var i: i64 = 0;
    var n: i64 = str_len(s);
    var count: i64 = 0;
    while i < n {
        var b: i64 = str_byte_at(s, i);
        if b < 128 { i = i + 1; }
        else if b < 224 { i = i + 2; }
        else if b < 240 { i = i + 3; }
        else { i = i + 4; }
        count = count + 1;
    }
    return count;
}

// ─── Case mapping ───────────────────────────────────────────────────────

/// Lowercase one codepoint (ASCII, Latin-1, Latin Ext-A, Greek, Cyrillic).
pub fn uni_lower_cp(cp: i64) -> i64 {
    if cp >= 65 && cp <= 90 { return cp + 32; }                 // A-Z
    if cp >= 192 && cp <= 222 && cp != 215 { return cp + 32; }  // À-Þ (× kept)
    // Latin Extended-A: alternating pairs starting 256, 258, ...
    if cp >= 256 && cp <= 311 && cp % 2 == 0 { return cp + 1; }
    if cp >= 313 && cp <= 328 && cp % 2 == 1 { return cp + 1; }
    if cp == 330 || cp == 332 || cp == 334 || cp == 336 || cp == 338 { return cp + 1; }
    if cp >= 340 && cp <= 375 && cp % 2 == 0 { return cp + 1; }
    if cp == 377 || cp == 379 || cp == 381 { return cp + 1; }   // Ź Ż Ž
    if cp == 376 { return 255; }                                // Ÿ→ÿ
    if cp == 391 { return 392; }                                // Ƈ→ƈ
    if cp == 913 { return 945; }                                // Α
    if cp >= 913 && cp <= 929 { return cp + 32; }               // Α-Ρ
    if cp >= 931 && cp <= 939 { return cp + 32; }               // Σ-Ϋ
    if cp >= 1024 && cp <= 1039 { return cp + 80; }             // Ѐ-Џ
    if cp >= 1040 && cp <= 1071 { return cp + 32; }             // А-Я
    if cp >= 1120 && cp <= 1153 && cp % 2 == 0 { return cp + 1; }
    return cp;
}

/// Uppercase one codepoint (mirrors uni_lower_cp coverage).
pub fn uni_upper_cp(cp: i64) -> i64 {
    if cp >= 97 && cp <= 122 { return cp - 32; }                // a-z
    if cp >= 224 && cp <= 254 && cp != 247 { return cp - 32; }  // à-þ (÷ kept)
    if cp == 255 { return 376; }                                // ÿ→Ÿ
    if cp == 223 { return 7838; }                               // ß→ẞ
    if cp >= 257 && cp <= 311 && cp % 2 == 1 { return cp - 1; }
    if cp >= 314 && cp <= 329 && cp % 2 == 0 { return cp - 1; }
    if cp == 331 || cp == 333 || cp == 335 || cp == 337 { return cp - 1; }
    if cp >= 339 && cp <= 375 && cp % 2 == 1 { return cp - 1; }
    if cp == 378 || cp == 380 || cp == 382 { return cp - 1; }   // ź ż ž
    if cp >= 945 && cp <= 961 { return cp - 32; }               // α-ρ
    if cp == 962 { return 931; }                                // final ς→Σ
    if cp >= 963 && cp <= 971 { return cp - 32; }               // σ-ϋ
    if cp >= 1104 && cp <= 1119 { return cp - 80; }             // ѐ-џ
    if cp >= 1072 && cp <= 1103 { return cp - 32; }             // а-я
    if cp >= 1121 && cp <= 1153 && cp % 2 == 1 { return cp - 1; }
    return cp;
}

/// Unicode-aware lowercase.
pub fn uni_lower(s: str) -> str {
    var cps: Vec = uni_to_codepoints(s);
    var i: i64 = 0;
    while i < cps.len() {
        cps.set(i, uni_lower_cp(cps.get(i)));
        i = i + 1;
    }
    return uni_from_codepoints(cps);
}

/// Unicode-aware uppercase.
pub fn uni_upper(s: str) -> str {
    var cps: Vec = uni_to_codepoints(s);
    var i: i64 = 0;
    while i < cps.len() {
        cps.set(i, uni_upper_cp(cps.get(i)));
        i = i + 1;
    }
    return uni_from_codepoints(cps);
}

/// Case-folded comparison (lowercase both sides first).
pub fn uni_equal_fold(a: str, b: str) -> bool {
    return str_equal(uni_lower(a), uni_lower(b));
}

// ─── Character classes ──────────────────────────────────────────────────

fn u_in(cp: i64, lo: i64, hi: i64) -> bool { return cp >= lo && cp <= hi; }

/// True for a codepoint in a combining-mark range (Mn/Mc approx.).
pub fn uni_is_combining(cp: i64) -> bool {
    return u_in(cp, 768, 879)      ||   // U+0300-036F combining diacriticals
           u_in(cp, 1155, 1161)    ||   // Cyrillic combining
           u_in(cp, 1425, 1469)    ||   // Hebrew points
           u_in(cp, 1552, 1562)    ||
           u_in(cp, 1611, 1631)    ||   // Arabic diacritics
           u_in(cp, 3655, 3659)    ||
           u_in(cp, 6846, 6846)    ||
           u_in(cp, 7616, 7679)    ||   // combining marks below/above
           u_in(cp, 8400, 8432)    ||   // combining diacriticals for symbols
           u_in(cp, 65056, 65071)  ||   // variation selectors
           u_in(cp, 917760, 917999);    // supplementary variation selectors
}

/// True for a Unicode letter (major scripts; not exhaustive).
pub fn uni_is_alpha(cp: i64) -> bool {
    return u_in(cp, 65, 90) || u_in(cp, 97, 122) ||
           u_in(cp, 192, 214) || u_in(cp, 216, 246) || u_in(cp, 248, 687) ||
           u_in(cp, 880, 1023) ||                     // Greek/Coptic
           u_in(cp, 1024, 1279) || u_in(cp, 1280, 1327) ||  // Cyrillic
           u_in(cp, 1329, 1366) ||                      // Armenian
           u_in(cp, 1488, 1514) ||                      // Hebrew
           u_in(cp, 1568, 1610) ||
           u_in(cp, 1646, 1747) ||                      // Arabic
           u_in(cp, 2308, 2361) ||                      // Devanagari vowels+consonants
           u_in(cp, 12353, 12438) ||                    // Hiragana
           u_in(cp, 12449, 12538) ||                    // Katakana
           u_in(cp, 19968, 40959) ||                    // CJK unified
           u_in(cp, 44032, 55203);                      // Hangul syllables
}

/// True for a decimal digit (ASCII + common digit ranges).
pub fn uni_is_digit(cp: i64) -> bool {
    return u_in(cp, 48, 57) ||
           u_in(cp, 1632, 1641) ||   // Arabic-Indic
           u_in(cp, 1776, 1785) ||   // Extended Arabic-Indic
           u_in(cp, 2406, 2415) ||   // Devanagari
           u_in(cp, 65296, 65305);   // Fullwidth
}

/// True for whitespace per Unicode White_Space (common members).
pub fn uni_is_space(cp: i64) -> bool {
    return cp == 32 || u_in(cp, 9, 13) || cp == 133 || cp == 160 ||
           u_in(cp, 8192, 8202) || cp == 8232 || cp == 8233 || cp == 12288;
}

// ─── Grapheme clusters ──────────────────────────────────────────────────
// Approximation of UAX #29 for common text: a cluster is a base
// codepoint plus following combining marks / variation selectors;
// ZWJ joins extend the cluster; paired regional indicators form flags.

fn uni_is_extend(cp: i64) -> bool {
    return uni_is_combining(cp) || cp == 8205 ||           // ZWJ
           u_in(cp, 65024, 65039) ||                       // VS1-16
           u_in(cp, 127995, 127999);                       // skin-tone modifiers
}

fn uni_is_regional(cp: i64) -> bool {
    return u_in(cp, 127462, 127487);                       // 🇦-🇿
}

fn uni_is_zwj(cp: i64) -> bool { return cp == 8205; }

/// Split a string into grapheme clusters (Vec of str).
/// Approximation: handles combining marks, VS16 emoji, ZWJ chains,
/// and flag pairs. Does not handle all GB9/extended-pictographic rules.
pub fn uni_graphemes(s: str) -> Vec {
    var cps: Vec = uni_to_codepoints(s);
    var out: Vec = Vec::new();
    var i: i64 = 0;
    var n: i64 = cps.len();
    while i < n {
        var start: i64 = i;
        var cp: i64 = cps.get(i);
        i = i + 1;
        if uni_is_regional(cp) && i < n && uni_is_regional(cps.get(i)) {
            i = i + 1;                                     // flag pair
        }
        var prev_zwj: bool = false;
        while i < n {
            var c2: i64 = cps.get(i);
            if uni_is_extend(c2) {
                if uni_is_zwj(c2) { prev_zwj = true; }
                else { prev_zwj = false; }
                i = i + 1;
                continue;
            }
            if prev_zwj {                                   // ZWJ chain member
                prev_zwj = false;
                i = i + 1;
                continue;
            }
            break;
        }
        // materialize cluster
        var cl: str = "";
        var k: i64 = start;
        while k < i {
            cl = cl + uni_encode_cp(cps.get(k));
            k = k + 1;
        }
        out.push(cl);
    }
    return out;
}

/// Number of grapheme clusters (user-perceived characters).
pub fn uni_grapheme_len(s: str) -> i64 { return uni_graphemes(s).len(); }

// ─── Lite normalization ─────────────────────────────────────────────────
// NFC for the common precomposed-Latin subset: combines base letter +
// combining accent into the precomposed codepoint where one exists.
// Not full NFC — no hangul, no reordering of multiple marks.

fn uni_compose(base: i64, mark: i64) -> i64 {
    // U+0300 grave, U+0301 acute, U+0302 circ, U+0303 tilde, U+0308 diaeresis
    if base == 65 {                                        // A
        if mark == 768 { return 192; } if mark == 769 { return 193; }
        if mark == 770 { return 194; } if mark == 771 { return 195; }
        if mark == 776 { return 196; } if mark == 778 { return 197; }
    }
    if base == 69 {                                        // E
        if mark == 768 { return 200; } if mark == 769 { return 201; }
        if mark == 770 { return 202; } if mark == 776 { return 203; }
    }
    if base == 73 {
        if mark == 768 { return 204; } if mark == 769 { return 205; }
        if mark == 770 { return 206; } if mark == 776 { return 207; }
    }
    if base == 78 && mark == 771 { return 209; }
    if base == 79 {
        if mark == 768 { return 210; } if mark == 769 { return 211; }
        if mark == 770 { return 212; } if mark == 771 { return 213; }
        if mark == 776 { return 214; }
    }
    if base == 85 {
        if mark == 768 { return 217; } if mark == 769 { return 218; }
        if mark == 770 { return 219; } if mark == 776 { return 220; }
    }
    if base == 89 && mark == 769 { return 221; }
    if base == 97 {
        if mark == 768 { return 224; } if mark == 769 { return 225; }
        if mark == 770 { return 226; } if mark == 771 { return 227; }
        if mark == 776 { return 228; } if mark == 778 { return 229; }
    }
    if base == 67 && mark == 807 { return 199; }
    if base == 99 && mark == 807 { return 231; }
    if base == 101 {
        if mark == 768 { return 232; } if mark == 769 { return 233; }
        if mark == 770 { return 234; } if mark == 776 { return 235; }
    }
    if base == 105 {
        if mark == 768 { return 236; } if mark == 769 { return 237; }
        if mark == 770 { return 238; } if mark == 776 { return 239; }
    }
    if base == 110 && mark == 771 { return 241; }
    if base == 111 {
        if mark == 768 { return 242; } if mark == 769 { return 243; }
        if mark == 770 { return 244; } if mark == 771 { return 245; }
        if mark == 776 { return 246; }
    }
    if base == 117 {
        if mark == 768 { return 249; } if mark == 769 { return 250; }
        if mark == 770 { return 251; } if mark == 776 { return 252; }
    }
    if base == 121 && mark == 769 { return 253; }
    if base == 121 && mark == 776 { return 255; }
    if base == 89 && mark == 776 { return 376; }
    return 0;
}

/// Compose base+combining-mark pairs for Latin (subset of NFC).
pub fn uni_normalize_lite(s: str) -> str {
    var cps: Vec = uni_to_codepoints(s);
    var out: Vec = Vec::new();
    var i: i64 = 0;
    while i < cps.len() {
        var cp: i64 = cps.get(i);
        if i + 1 < cps.len() {
            var m: i64 = cps.get(i + 1);
            var fused: i64 = uni_compose(cp, m);
            if fused > 0 {
                out.push(fused);
                i = i + 2;
                continue;
            }
        }
        out.push(cp);
        i = i + 1;
    }
    return uni_from_codepoints(out);
}
