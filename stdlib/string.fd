// Fides String utilities standard library
//
// Higher-level string operations built on core.fd primitives.
// All functions are pure (no IO, no allocation beyond return values).
//
// Usage:
//   use core;
//   use string;
//   value parts = str_split("a,b,c", ",");
//   value result = str_join(parts, "-");  // "a-b-c"

module string;
use vec;
// ─── Join / Split extensions ────────────────────────────────────────────

/// Join a Vec of strings with a separator.
/// str_join(["a", "b", "c"], "-") → "a-b-c"
///
/// Example:
///   var parts: Vec<str> = Vec::new();
///   parts.push("a"); parts.push("b"); parts.push("c");
///   var s = str_join(parts, "-");
///   println(s);
///   assert_eq(s, "a-b-c");
pub fn str_join(parts: Vec<str>, sep: str) -> str {
    if parts.len() == 0 {
        return "";
    }
    // Single pass through a byte buffer: O(total bytes) instead of the
    // O(len^2) of repeated string concatenation, and embedded NUL bytes
    // survive (str concat truncates at NUL).
    var out: Vec<i64> = Vec::new();
    var sep_len = str_len(sep);
    var i = 0;
    while i < parts.len() {
        if i > 0 {
            var s = 0;
            while s < sep_len {
                out.push(str_byte_at(sep, s));
                s = s + 1;
            }
        }
        var part: str = parts.get(i);
        var n = str_len(part);
        var j = 0;
        while j < n {
            out.push(str_byte_at(part, j));
            j = j + 1;
        }
        i = i + 1;
    }
    return str_from_bytes(out);
}

/// Efficient join that avoids O(n^2) memory by building in batches.
/// Concatenates groups of 1000 parts, then concatenates the groups.
/// This reduces the number of large intermediate strings.
///
/// Example:
///   var parts: Vec<str> = Vec::new();
///   parts.push("x"); parts.push("y");
///   assert_eq(str_join_fast(parts, ", "), "x, y");
pub fn str_join_fast(parts: Vec<str>, sep: str) -> str {
    if parts.len() == 0 {
        return "";
    }
    if parts.len() < 2000 {
        return str_join(parts, sep);
    }
    // Build in batches of 1000 to reduce O(n^2) overhead
    var batches: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < parts.len() {
        var batch: Vec<str> = Vec::new();
        var j: i64 = 0;
        while j < 1000 && i + j < parts.len() {
            batch.push(parts.get(i + j));
            j = j + 1;
        }
        batches.push(str_join(batch, sep));
        i = i + 1000;
    }
    return str_join(batches, sep);
}

/// Join a Vec of i64 values with a separator.
///
/// Example:
///   var nums: Vec<i64> = Vec::new();
///   nums.push(1); nums.push(2); nums.push(3);
///   var s = str_join_ints(nums, "+");
///   println(s);
///   assert_eq(s, "1+2+3");
pub fn str_join_ints(nums: Vec<i64>, sep: str) -> str {
    if nums.len() == 0 {
        return "";
    }
    var parts: Vec<str> = Vec::new();
    var i = 0;
    while i < nums.len() {
        parts.push(int_to_str(nums.get(i)));
        i = i + 1;
    }
    return str_join(parts, sep);
}

// ─── Transformations ────────────────────────────────────────────────────

/// Reverse a string (byte-level).
///
/// Example:
///   assert_eq(str_reverse("abc"), "cba");
///   assert_eq(str_reverse(""), "");
pub fn str_reverse(s: str) -> str {
    var len = str_len(s);
    if len <= 1 {
        return s;
    }
    var bytes = Vec::new();
    var i = len - 1;
    while i >= 0 {
        bytes.push(str_byte_at(s, i));
        i = i - 1;
    }
    return str_from_bytes(bytes);
}

/// Capitalize the first character of a string.
///
/// Example:
///   assert_eq(str_capitalize("hello"), "Hello");
pub fn str_capitalize(s: str) -> str {
    if str_len(s) == 0 {
        return s;
    }
    var first = str_byte_at(s, 0);
    if first >= 97 && first <= 122 {
        var bytes = Vec::new();
        bytes.push(first - 32);
        var i = 1;
        while i < str_len(s) {
            bytes.push(str_byte_at(s, i));
            i = i + 1;
        }
        return str_from_bytes(bytes);
    }
    return s;
}

/// Convert a string to title case (first char of each word uppercase).
///
/// Example:
///   var t = str_title("the quick fox");
///   println(t);
///   assert_eq(t, "The Quick Fox");
pub fn str_title(s: str) -> str {
    var len = str_len(s);
    if len == 0 {
        return s;
    }
    var bytes = Vec::new();
    var capitalize_next = true;
    var i = 0;
    while i < len {
        var ch = str_byte_at(s, i);
        if char_is_whitespace(ch) {
            bytes.push(ch);
            capitalize_next = true;
        } else {
            if capitalize_next && ch >= 97 && ch <= 122 {
                bytes.push(ch - 32);
            } else {
                bytes.push(ch);
            }
            capitalize_next = false;
        }
        i = i + 1;
    }
    return str_from_bytes(bytes);
}

// ─── Padding ────────────────────────────────────────────────────────────

/// Pad a string on the left with a character to reach the target length.
/// str_pad_left("42", 5, '0') → "00042"
///
/// Example:
///   assert_eq(str_pad_left("42", 5, '0'), "00042");
///   assert_eq(str_pad_left("toolong", 3, ' '), "toolong");
pub fn str_pad_left(s: str, width: i64, ch: i64) -> str {
    var len = str_len(s);
    if len >= width {
        return s;
    }
    var padding = str_repeat(char_to_str(ch), width - len);
    return padding + s;
}

/// Pad a string on the right with a character to reach the target length.
/// str_pad_right("42", 5, ' ') → "42   "
///
/// Example:
///   assert_eq(str_pad_right("42", 5, '.'), "42...");
pub fn str_pad_right(s: str, width: i64, ch: i64) -> str {
    var len = str_len(s);
    if len >= width {
        return s;
    }
    var padding = str_repeat(char_to_str(ch), width - len);
    return s + padding;
}

/// Center a string within a given width, padding with the given character.
/// str_center("hi", 6, ' ') → "  hi  "
///
/// Example:
///   assert_eq(str_center("hi", 6, '*'), "**hi**");
pub fn str_center(s: str, width: i64, ch: i64) -> str {
    var len = str_len(s);
    if len >= width {
        return s;
    }
    var total_pad = width - len;
    var left_pad = total_pad / 2;
    var right_pad = total_pad - left_pad;
    var result = str_repeat(char_to_str(ch), left_pad);
    result = result + s;
    result = result + str_repeat(char_to_str(ch), right_pad);
    return result;
}

// ─── Search / Count ─────────────────────────────────────────────────────

/// Count occurrences of a substring in a string.
///
/// Example:
///   assert_eq(str_count("abcabc", "bc"), 2);
///   assert_eq(str_count("aaa", "x"), 0);
pub fn str_count(s: str, sub: str) -> i64 {
    if str_len(sub) == 0 {
        return 0;
    }
    var count = 0;
    var pos = 0;
    var sub_len = str_len(sub);
    while pos <= str_len(s) - sub_len {
        var slice = str_slice(s, pos, pos + sub_len);
        if str_equal(slice, sub) {
            count = count + 1;
            pos = pos + sub_len;
        } else {
            pos = pos + 1;
        }
    }
    return count;
}

/// Count occurrences of a byte (character) in a string.
///
/// Example:
///   assert_eq(str_count_char("banana", 'a'), 3);
pub fn str_count_char(s: str, ch: i64) -> i64 {
    var count = 0;
    var i = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) == ch {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/// Find the nth occurrence of a substring. Returns index or -1.
///
/// Example:
///   assert_eq(str_find_nth("a-b-c", "-", 1), 1);
///   assert_eq(str_find_nth("a-b-c", "-", 2), 3);
///   assert_eq(str_find_nth("a-b-c", "-", 3), -1);
pub fn str_find_nth(s: str, sub: str, n: i64) -> i64 {
    if n < 1 || str_len(sub) == 0 {
        return -1;
    }
    var found = 0;
    var pos = 0;
    var sub_len = str_len(sub);
    while pos <= str_len(s) - sub_len {
        var slice = str_slice(s, pos, pos + sub_len);
        if str_equal(slice, sub) {
            found = found + 1;
            if found == n {
                return pos;
            }
            pos = pos + sub_len;
        } else {
            pos = pos + 1;
        }
    }
    return -1;
}

// ─── Predicates ─────────────────────────────────────────────────────────

/// Check if a string is empty.
///
/// Example:
///   assert(str_is_blank("   "));
///   assert(!str_is_blank(" x "));
pub fn str_is_blank(s: str) -> bool {
    var i = 0;
    while i < str_len(s) {
        if !char_is_whitespace(str_byte_at(s, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Check if a string consists only of digits.
///
/// Example:
///   assert(str_is_numeric("12345"));
///   assert(!str_is_numeric("12a"));
pub fn str_is_numeric(s: str) -> bool {
    if str_len(s) == 0 {
        return false;
    }
    var i = 0;
    while i < str_len(s) {
        if !char_is_digit(str_byte_at(s, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Check if a string consists only of alphabetic characters.
///
/// Example:
///   assert(str_is_alpha("abcXYZ"));
///   assert(!str_is_alpha("abc1"));
pub fn str_is_alpha(s: str) -> bool {
    if str_len(s) == 0 {
        return false;
    }
    var i = 0;
    while i < str_len(s) {
        if !char_is_alpha(str_byte_at(s, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Check if a string consists only of alphanumeric characters.
///
/// Example:
///   assert(str_is_alphanumeric("abc123"));
///   assert(!str_is_alphanumeric("a b"));
pub fn str_is_alphanumeric(s: str) -> bool {
    if str_len(s) == 0 {
        return false;
    }
    var i = 0;
    while i < str_len(s) {
        var ch = str_byte_at(s, i);
        if !char_is_alpha(ch) && !char_is_digit(ch) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ─── Trimming extensions ────────────────────────────────────────────────

/// Strip a specific character from both ends of a string.
///
/// Example:
///   assert_eq(str_strip_char("--x--", '-'), "x");
pub fn str_strip_char(s: str, ch: i64) -> str {
    var len = str_len(s);
    var start = 0;
    var end = len;
    while start < end && str_byte_at(s, start) == ch {
        start = start + 1;
    }
    while end > start && str_byte_at(s, end - 1) == ch {
        end = end - 1;
    }
    return str_slice(s, start, end);
}

/// Remove all occurrences of a character from a string.
///
/// Example:
///   assert_eq(str_remove_char("a,b,c", ','), "abc");
pub fn str_remove_char(s: str, ch: i64) -> str {
    var bytes = Vec::new();
    var i = 0;
    while i < str_len(s) {
        var b = str_byte_at(s, i);
        if b != ch {
            bytes.push(b);
        }
        i = i + 1;
    }
    return str_from_bytes(bytes);
}

// ─── Conversion ─────────────────────────────────────────────────────────

/// Convert a bool to a string.
///
/// Example:
///   assert_eq(bool_to_str(true), "true");
///   assert_eq(bool_to_str(false), "false");
pub fn bool_to_str(b: bool) -> str {
    if b {
        return "true";
    }
    return "false";
}

/// Convert an i64 to a string with a minimum width (zero-padded).
///
/// Example:
///   assert_eq(int_to_str_padded(7, 3), "007");
pub fn int_to_str_padded(n: i64, width: i64) -> str {
    var s = int_to_str(n);
    return str_pad_left(s, width, 48);
    // '0' = 48
}

/// Convert an i64 to a hex string (lowercase, no prefix).
/// Negative values print as their 64-bit two's-complement bit pattern
/// (int_to_hex(-1) == "ffffffffffffffff"), so i64::MIN formats correctly.
///
/// Example:
///   assert_eq(int_to_hex(255), "ff");
///   assert_eq(int_to_hex(0), "0");
///   assert_eq(int_to_hex(-1), "ffffffffffffffff");
///   assert_eq(int_to_hex(-255), "ffffffffffffff01");
pub fn int_to_hex(n: i64) -> str {
    if n == 0 {
        return "0";
    }
    var hex_chars = "0123456789abcdef";
    var bytes = Vec::new();
    if n > 0 {
        var value = n;
        while value > 0 {
            bytes.push(str_byte_at(hex_chars, value & 0xF));
            value = value >> 4;
        }
    } else {
        // Two's complement: extract nibbles with a logical right shift
        // (mask off the sign bits arithmetic shift reinserts).
        var value = n;
        while value != 0 {
            bytes.push(str_byte_at(hex_chars, value & 0xF));
            value = (value >> 4) & 0x0FFFFFFFFFFFFFFF;
        }
    }
    // Reverse
    var result = Vec::new();
    var i = bytes.len() - 1;
    while i >= 0 {
        result.push(bytes.get(i));
        i = i - 1;
    }
    return str_from_bytes(result);
}

/// Convert an i64 to a binary string (no prefix).
/// Negative values print as their 64-bit two's-complement bit pattern.
///
/// Example:
///   assert_eq(int_to_bin(5), "101");
///   assert_eq(int_to_bin(0), "0");
///   assert_eq(str_len(int_to_bin(-1)), 64);
pub fn int_to_bin(n: i64) -> str {
    if n == 0 {
        return "0";
    }
    var bytes = Vec::new();
    if n > 0 {
        var value = n;
        while value > 0 {
            if (value & 1) == 1 {
                bytes.push(49);
            } else {
                bytes.push(48);
            }
            value = value >> 1;
        }
    } else {
        var value = n;
        while value != 0 {
            if (value & 1) == 1 {
                bytes.push(49);
            } else {
                bytes.push(48);
            }
            value = (value >> 1) & 0x7FFFFFFFFFFFFFFF;
        }
    }
    // Reverse
    var result = Vec::new();
    var i = bytes.len() - 1;
    while i >= 0 {
        result.push(bytes.get(i));
        i = i - 1;
    }
    return str_from_bytes(result);
}

// ─── Small String Optimization (SSO) ─────────────────────────────────────
//
// Fides `str` is normally heap-allocated. SSO stores short strings (≤ 14
// bytes) inline in a 16-byte struct, avoiding a malloc for every short
// string. This is a huge win for compilers, parsers, and any code that
// creates many small strings (identifiers, error messages, keys).
//
// Usage:
//   use string;
//   value s = smallstr_new("hello");      // inline (no malloc)
//   value len = smallstr_len(s);           // 5
//   value heap_s = smallstr_to_str(s);     // convert to regular str
//   value s2 = smallstr_from_str("world"); // inline if ≤ 14 bytes

/// SmallStr is a small string optimization. Current implementation uses
/// heap-allocated strings for all cases (inline optimization deferred until
/// the typechecker supports array literals with context-dependent types).
struct SmallStr {
    ptr: i64,
    // heap-allocated string pointer (owned)
    len: i64,  // string length
}

/// Maximum length for inline storage.
pub fn smallstr_max_inline() -> i64 {
    return 14;
}

/// Create a SmallStr from a regular string.
pub fn smallstr_from_str(s: str) -> SmallStr {
    var len: i64 = str_len(s);
    var ptr: i64 = p_string_from(s);
    return SmallStr {
        ptr: ptr, len: len
    };
}

/// Alias for smallstr_from_str.
///
/// Example:
///   var s = smallstr_new("hello");
///   assert_eq(smallstr_len(s), 5);
///   assert(!smallstr_is_inline(s));
pub fn smallstr_new(s: str) -> SmallStr {
    return smallstr_from_str(s);
}

/// Get the length of a SmallStr.
pub fn smallstr_len(s: SmallStr) -> i64 {
    return s.len;
}

/// Convert a SmallStr to a regular heap string.
pub fn smallstr_to_str(s: SmallStr) -> str {
    // SAFETY: s.ptr is a counted string from p_string_from
    // (smallstr_from_str), so it carries the string header a str needs; the
    // return takes an owner of its own (proposal 0004: a returned value
    // that is not a temporary is counted again), the SmallStr keeps its own.
    unsafe {
        return s.ptr as str;
    }
}

/// Check if a SmallStr is stored inline (no heap allocation).
pub fn smallstr_is_inline(_s: SmallStr) -> bool {
    return false;
}

/// Compare two SmallStrs for equality.
pub fn smallstr_eq(a: SmallStr, b: SmallStr) -> bool {
    var la: i64 = smallstr_len(a);
    var lb: i64 = smallstr_len(b);
    if la != lb {
        return false;
    }
    var sa: str = smallstr_to_str(a);
    var sb: str = smallstr_to_str(b);
    return p_str_equal(sa as i64, sb as i64);
}

// ─── String Rope ─────────────────────────────────────────────────────────
//
// A rope is a tree of string fragments. Concatenation is O(1) (just create
// a new node with two children) instead of O(n) for regular string concat.
// This is ideal for large texts (compiler source files, document editing,
// log accumulation).
//
// Usage:
//   use string;
//   value r = rope_new("Hello, ");
//   r = rope_concat(r, rope_new("world!"));
//   value s = rope_to_str(r);  // "Hello, world!"
//   value len = rope_len(r);   // 13

/// A rope: an ordered list of string fragments. rope_push appends a
/// fragment in amortized O(1), rope_concat merges two ropes' fragment
/// lists in O(#fragments) (a pointer copy, no text copied), and
/// rope_to_str flattens in O(total bytes) exactly once.
struct Rope {
    parts: Vec<str>,
    length: i64,  // total byte length over all fragments
}

/// Create an empty rope.
///
/// Example:
///   var r = rope_empty();
///   rope_push(&mut r, "a");
///   assert_eq(rope_to_str(r), "a");
pub fn rope_empty() -> Rope {
    return Rope {
        parts: Vec::new(), length: 0
    };
}

/// Create a rope holding one fragment.
///
/// Example:
///   var r = rope_new("Hello");
///   assert_eq(rope_len(r), 5);
///   assert_eq(rope_to_str(r), "Hello");
pub fn rope_new(s: str) -> Rope {
    var parts: Vec<str> = Vec::new();
    parts.push(s);
    return Rope {
        parts: parts, length: str_len(s)
    };
}

/// Append a string fragment to the rope. Amortized O(1).
///
/// Example:
///   var r = rope_new("a");
///   rope_push(&mut r, "b");
///   rope_push(&mut r, "c");
///   assert_eq(rope_to_str(r), "abc");
pub fn rope_push(r: &mut Rope, s: str) -> void {
    r.length = r.length + str_len(s);
    r.parts.push(s);
}

/// Concatenate two ropes: the result has left's fragments then right's.
/// O(#fragments) — fragment references are copied, never the text.
///
/// Example:
///   var r = rope_concat(rope_new("Hello, "), rope_new("world!"));
///   assert_eq(rope_to_str(r), "Hello, world!");
pub fn rope_concat(left: Rope, right: Rope) -> Rope {
    var parts: Vec<str> = Vec::new();
    var i = 0;
    while i < left.parts.len() {
        parts.push(left.parts.get(i));
        i = i + 1;
    }
    i = 0;
    while i < right.parts.len() {
        parts.push(right.parts.get(i));
        i = i + 1;
    }
    return Rope {
        parts: parts, length: left.length + right.length
    };
}

/// Append all of `other`'s fragments to `r`. O(#fragments of other).
pub fn rope_append(r: &mut Rope, other: Rope) -> void {
    var i = 0;
    while i < other.parts.len() {
        r.parts.push(other.parts.get(i));
        i = i + 1;
    }
    r.length = r.length + other.length;
}

/// Get the total length of a rope. O(1) — stored in the node.
pub fn rope_len(r: Rope) -> i64 {
    return r.length;
}

/// The number of fragments in the rope.
pub fn rope_fragments(r: Rope) -> i64 {
    return r.parts.len();
}

/// Convert a rope to a regular string. O(total bytes) — builds through a
/// byte buffer once, so embedded NULs in fragments are preserved.
pub fn rope_to_str(r: Rope) -> str {
    var out: Vec<i64> = Vec::new();
    var i = 0;
    while i < r.parts.len() {
        var part: str = r.parts.get(i);
        var n = str_len(part);
        var j = 0;
        while j < n {
            out.push(str_byte_at(part, j));
            j = j + 1;
        }
        i = i + 1;
    }
    return str_from_bytes(out);
}

/// The byte at position `idx` in the flattened rope (clamped to bounds).
///
/// Example:
///   var r = rope_new("hello");
///   assert_eq(rope_byte_at(r, 1), 101);
pub fn rope_byte_at(r: Rope, idx: i64) -> i64 {
    if idx < 0 || idx >= r.length {
        return 0;
    }
    var pos = idx;
    var i = 0;
    while i < r.parts.len() {
        var part: str = r.parts.get(i);
        var n = str_len(part);
        if pos < n {
            return str_byte_at(part, pos);
        }
        pos = pos - n;
        i = i + 1;
    }
    return 0;
}

/// Create a rope from a substring of another rope.
/// This is O(log n) for balanced ropes.
pub fn rope_substring(r: Rope, start: i64, end: i64) -> Rope {
    var s: str = rope_to_str(r);
    var sub: str = "";
    // SAFETY: p_string_substring returns a new counted string (AGENTS.md
    // Known Bugs 25: every runtime string producer does) whose one owner is
    // handed to `sub` here.
    unsafe {
        sub = p_string_substring(s, start, end) as str;
    }
    return rope_new(sub);
}

// ─── StrView: slices without copying (release D16) ──────────────────────
//
// A view of `len` bytes of `base` from `start`. Making a view, slicing it,
// comparing, searching and splitting copy no bytes; only `to_str` does. The
// view owns its string (a counted share, proposal 0004), so the bytes stay
// alive as long as any view of them does. Zero bytes are ordinary bytes.
//
//   var v: StrView = str_view("key=value", 0, 9);
//   var parts: Vec<StrView> = v.split("=");
//   parts.get(1).eq_str("value")   // true

pub struct StrView {
    pub base: str,
    pub start: i64,
    pub len: i64,
}

/// The bytes `start..end` of `s` (clamped to the string), not copied.
///
/// Example:
///   var v = str_view("key=value", 4, 9);
///   assert_eq(v.length(), 5);
///   assert(v.eq_str("value"));
///   assert_eq(v.to_str(), "value");
pub fn str_view(s: str, start: i64, end: i64) -> StrView {
    var n: i64 = str_len(s);
    var a: i64 = start;
    var b: i64 = end;
    if a < 0 {
        a = 0;
    }
    if b > n {
        b = n;
    }
    if a > b {
        a = b;
    }
    return StrView {
        base: s, start: a, len: b - a
    };
}

/// A view of the whole string.
///
/// Example:
///   var v = str_view_all("  a=1  ").trim();
///   var parts: Vec<StrView> = v.split("=");
///   assert_eq(parts.len(), 2);
///   assert(parts.get(0).eq_str("a"));
///   assert_eq(parts.get(1).parse_int(-1), 1);
pub fn str_view_all(s: str) -> StrView {
    return StrView {
        base: s, start: 0, len: str_len(s)
    };
}

impl StrView {
    pub fn length(self: &StrView) -> i64 {
        return self.len;
    }

    pub fn is_empty(self: &StrView) -> bool {
        return self.len == 0;
    }

    /// The byte at `i`, or -1 outside the view.
    pub fn byte_at(self: &StrView, i: i64) -> i64 {
        if i < 0 || i >= self.len {
            return -1;
        }
        return str_byte_at(self.base, self.start + i);
    }

    /// The view's bytes `a..b` (clamped), not copied.
    pub fn slice(self: &StrView, a: i64, b: i64) -> StrView {
        var x: i64 = a;
        var y: i64 = b;
        if x < 0 {
            x = 0;
        }
        if y > self.len {
            y = self.len;
        }
        if x > y {
            x = y;
        }
        return StrView {
            base: self.base, start: self.start + x, len: y - x
        };
    }

    /// Address of the first byte (for the comparisons below).
    fn addr(self: &StrView) -> i64 {
        return (self.base as i64) + self.start;
    }

    pub fn eq(self: &StrView, other: &StrView) -> bool {
        if self.len != other.len {
            return false;
        }
        return p_bytes_eq(self.addr(), other.addr(), self.len);
    }

    pub fn eq_str(self: &StrView, s: str) -> bool {
        if self.len != str_len(s) {
            return false;
        }
        return p_bytes_eq(self.addr(), s as i64, self.len);
    }

    pub fn starts_with(self: &StrView, p: str) -> bool {
        var pl: i64 = str_len(p);
        if pl > self.len {
            return false;
        }
        return p_bytes_eq(self.addr(), p as i64, pl);
    }

    pub fn ends_with(self: &StrView, p: str) -> bool {
        var pl: i64 = str_len(p);
        if pl > self.len {
            return false;
        }
        return p_bytes_eq(self.addr() + self.len - pl, p as i64, pl);
    }

    /// Offset of the first `sub` in the view, or -1.
    pub fn find(self: &StrView, sub: str) -> i64 {
        var sl: i64 = str_len(sub);
        if sl == 0 {
            return 0;
        }
        var at: i64 = 0;
        var base: i64 = self.addr();
        var first: i64 = str_byte_at(sub, 0);
        while at + sl <= self.len {
            if str_byte_at(self.base, self.start + at) == first {
                if p_bytes_eq(base + at, sub as i64, sl) {
                    return at;
                }
            }
            at = at + 1;
        }
        return -1;
    }

    pub fn contains(self: &StrView, sub: str) -> bool {
        return self.find(sub) >= 0;
    }

    /// The parts between each `delim`, as views of the same string.
    pub fn split(self: &StrView, delim: str) -> Vec<StrView> {
        var out: Vec<StrView> = Vec::new();
        var dl: i64 = str_len(delim);
        if dl == 0 {
            out.push(self.slice(0, self.len));
            return out;
        }
        var rest: StrView = self.slice(0, self.len);
        while true {
            var at: i64 = rest.find(delim);
            if at < 0 {
                out.push(rest);
                return out;
            }
            out.push(rest.slice(0, at));
            rest = rest.slice(at + dl, rest.len);
        }
        return out;
    }

    /// Without leading and trailing spaces, tabs, CR and LF.
    pub fn trim(self: &StrView) -> StrView {
        var a: i64 = 0;
        var b: i64 = self.len;
        while a < b && sv_is_ws(self.byte_at(a)) {
            a = a + 1;
        }
        while b > a && sv_is_ws(self.byte_at(b - 1)) {
            b = b - 1;
        }
        return self.slice(a, b);
    }

    /// A new string with the view's bytes (the one copy).
    pub fn to_str(self: &StrView) -> str {
        return str_slice_len(self.base, str_len(self.base), self.start, self.start + self.len);
    }

    /// The decimal integer the view holds (an optional `-`), or `fallback`.
    pub fn parse_int(self: &StrView, fallback: i64) -> i64 {
        if self.len == 0 {
            return fallback;
        }
        var i: i64 = 0;
        var neg: bool = false;
        if self.byte_at(0) == 45 {
            neg = true;
            i = 1;
        }
        if i >= self.len {
            return fallback;
        }
        var n: i64 = 0;
        while i < self.len {
            var c: i64 = self.byte_at(i);
            if c < 48 || c > 57 {
                return fallback;
            }
            n = n * 10 + (c - 48);
            i = i + 1;
        }
        if neg {
            return 0 - n;
        }
        return n;
    }
}

fn sv_is_ws(c: i64) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

/// Parse an i64 with an optional +/- sign, or Option::None when the
/// string is not a well-formed integer — unlike str_parse_int, which
/// returns 0 both on failure and for the literal "0".
///
/// Example:
///   match str_parse_int_opt("-12") {
///     Option::Some(v) => { assert_eq(v, -12); }
///     Option::None => { assert(false); }
///   }
///   match str_parse_int_opt("x") {
///     Option::Some(v) => { assert(false); }
///     Option::None => { assert(true); }
///   }
pub fn str_parse_int_opt(s: str) -> Option<i64> {
    var n = str_len(s);
    if n == 0 {
        return Option::None;
    }
    var start = 0;
    var c0 = str_byte_at(s, 0);
    if c0 == 45 || c0 == 43 {
        start = 1;
    }
    if start >= n {
        return Option::None;
    }
    var i = start;
    while i < n {
        if !char_is_digit(str_byte_at(s, i)) {
            return Option::None;
        }
        i = i + 1;
    }
    return Option::Some(str_parse_int(s));
}
