// Fides Iterator standard library
//
// Iterator adapters for functional-style data processing.
// Built on top of Vec — creates new Vecs rather than lazy iterators.
//
// Usage:
//   use iter;
//   value v = Vec::new();
//   v.push(1); v.push(2); v.push(3);
//   value doubled = iter_map(v, double_fn);     // [2, 4, 6]
//   value evens = iter_filter(v, is_even_fn);   // [2]

module iter;

use core;
use vec;

// ─── Map / Filter / Reduce ──────────────────────────────────────────────

/// Map each element through a function, returning a new Vec.
pub fn iter_map(v: Vec, f: fn(i64) -> i64) -> Vec {
    var result = Vec::new();
    var i = 0;
    while i < v.len() {
        result.push(f(v.get(i)));
        i = i + 1;
    }
    return result;
}

/// Filter elements that satisfy a predicate, returning a new Vec.
pub fn iter_filter(v: Vec, pred: fn(i64) -> bool) -> Vec {
    var result = Vec::new();
    var i = 0;
    while i < v.len() {
        if pred(v.get(i)) {
            result.push(v.get(i));
        }
        i = i + 1;
    }
    return result;
}

/// Reduce a Vec to a single value using a function.
/// iter_reduce([1,2,3], add) → add(add(0, 1), 2), 3) = 6
pub fn iter_reduce(v: Vec, f: fn(i64, i64) -> i64, initial: i64) -> i64 {
    var acc = initial;
    var i = 0;
    while i < v.len() {
        acc = f(acc, v.get(i));
        i = i + 1;
    }
    return acc;
}

/// Sum all elements in a Vec.
pub fn iter_sum(v: Vec) -> i64 {
    var sum = 0;
    var i = 0;
    while i < v.len() {
        sum = sum + v.get(i);
        i = i + 1;
    }
    return sum;
}

/// Product of all elements in a Vec.
pub fn iter_product(v: Vec) -> i64 {
    var product = 1;
    var i = 0;
    while i < v.len() {
        product = product * v.get(i);
        i = i + 1;
    }
    return product;
}

/// Find the minimum element. Returns 0 if empty.
pub fn iter_min(v: Vec) -> i64 {
    if v.is_empty() { return 0; }
    var m = v.get(0);
    var i = 1;
    while i < v.len() {
        if v.get(i) < m { m = v.get(i); }
        i = i + 1;
    }
    return m;
}

/// Find the maximum element. Returns 0 if empty.
pub fn iter_max(v: Vec) -> i64 {
    if v.is_empty() { return 0; }
    var m = v.get(0);
    var i = 1;
    while i < v.len() {
        if v.get(i) > m { m = v.get(i); }
        i = i + 1;
    }
    return m;
}

// ─── Search ─────────────────────────────────────────────────────────────

/// Find the first index of a value. Returns -1 if not found.
pub fn iter_find_index(v: Vec, value: i64) -> i64 {
    var i = 0;
    while i < v.len() {
        if v.get(i) == value { return i; }
        i = i + 1;
    }
    return -1;
}

/// Find the first index matching a predicate. Returns -1 if not found.
pub fn iter_find(v: Vec, pred: fn(i64) -> bool) -> i64 {
    var i = 0;
    while i < v.len() {
        if pred(v.get(i)) { return i; }
        i = i + 1;
    }
    return -1;
}

/// Check if any element satisfies a predicate.
pub fn iter_any(v: Vec, pred: fn(i64) -> bool) -> bool {
    var i = 0;
    while i < v.len() {
        if pred(v.get(i)) { return true; }
        i = i + 1;
    }
    return false;
}

/// Check if all elements satisfy a predicate.
pub fn iter_all(v: Vec, pred: fn(i64) -> bool) -> bool {
    var i = 0;
    while i < v.len() {
        if !pred(v.get(i)) { return false; }
        i = i + 1;
    }
    return true;
}

/// Count elements that satisfy a predicate.
pub fn iter_count(v: Vec, pred: fn(i64) -> bool) -> i64 {
    var count = 0;
    var i = 0;
    while i < v.len() {
        if pred(v.get(i)) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

// ─── Chaining ───────────────────────────────────────────────────────────

/// Flatten a Vec of Vecs into a single Vec.
/// Note: Since Vec elements are i64 (opaque pointers), this treats
/// each element as a Vec pointer and flattens them.
pub fn iter_flatten(v: Vec) -> Vec {
    var result = Vec::new();
    var i = 0;
    while i < v.len() {
        var inner = v.get(i);
        var j = 0;
        while j < p_vec_len(inner) {
            result.push(p_vec_get(inner, j));
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

/// Take the first n elements, returning a new Vec.
pub fn iter_take(v: Vec, n: i64) -> Vec {
    var result = Vec::new();
    var count = n;
    if count > v.len() { count = v.len(); }
    var i = 0;
    while i < count {
        result.push(v.get(i));
        i = i + 1;
    }
    return result;
}

/// Skip the first n elements, returning a new Vec with the rest.
pub fn iter_skip(v: Vec, n: i64) -> Vec {
    var result = Vec::new();
    var i = n;
    if i < 0 { i = 0; }
    while i < v.len() {
        result.push(v.get(i));
        i = i + 1;
    }
    return result;
}

/// Concatenate two Vecs.
pub fn iter_chain(a: Vec, b: Vec) -> Vec {
    var result = Vec::new();
    var i = 0;
    while i < a.len() {
        result.push(a.get(i));
        i = i + 1;
    }
    var j = 0;
    while j < b.len() {
        result.push(b.get(j));
        j = j + 1;
    }
    return result;
}

// ─── Range generation ───────────────────────────────────────────────────

/// Generate a range [start, end) as a Vec.
pub fn iter_range(start: i64, end: i64) -> Vec {
    var result = Vec::new();
    var i = start;
    while i < end {
        result.push(i);
        i = i + 1;
    }
    return result;
}

/// Generate a range with a step.
/// iter_range_step(0, 10, 2) → [0, 2, 4, 6, 8]
pub fn iter_range_step(start: i64, end: i64, step: i64) -> Vec {
    var result = Vec::new();
    if step <= 0 { return result; }
    var i = start;
    while i < end {
        result.push(i);
        i = i + step;
    }
    return result;
}

/// Repeat a value n times.
pub fn iter_repeat(value: i64, n: i64) -> Vec {
    var result = Vec::new();
    var i = 0;
    while i < n {
        result.push(value);
        i = i + 1;
    }
    return result;
}

// ─── Partition ──────────────────────────────────────────────────────────

/// Partition a Vec into two: elements that pass and elements that fail the predicate.
/// Returns a Vec of two Vecs: [passing, failing].
pub fn iter_partition(v: Vec, pred: fn(i64) -> bool) -> Vec {
    var passing = Vec::new();
    var failing = Vec::new();
    var i = 0;
    while i < v.len() {
        if pred(v.get(i)) {
            passing.push(v.get(i));
        } else {
            failing.push(v.get(i));
        }
        i = i + 1;
    }
    var result = Vec::new();
    result.push(passing);
    result.push(failing);
    return result;
}

/// Deduplicate a Vec (remove consecutive duplicates).
pub fn iter_dedup(v: Vec) -> Vec {
    var result = Vec::new();
    if v.is_empty() { return result; }
    result.push(v.get(0));
    var i = 1;
    while i < v.len() {
        if v.get(i) != v.get(i - 1) {
            result.push(v.get(i));
        }
        i = i + 1;
    }
    return result;
}

/// Chunk a Vec into groups of `size` elements.
pub fn iter_chunk(v: Vec, size: i64) -> Vec {
    if size <= 0 { return Vec::new(); }
    var result = Vec::new();
    var i = 0;
    while i < v.len() {
        var chunk = Vec::new();
        var j = 0;
        while j < size && i + j < v.len() {
            chunk.push(v.get(i + j));
            j = j + 1;
        }
        result.push(chunk);
        i = i + size;
    }
    return result;
}
