// Fides OpenAPI 3.1 documents, pure Fides
//
// A small OpenAPI 3.1 document model and what a service needs around it:
//   - build a document from route descriptions (method, path template,
//     parameters, request body schema, responses, tags) plus shared
//     component schemas
//   - serialize it to JSON (stdlib json; keys come out sorted, as
//     json_parse canonicalizes) and to YAML (a block-style emitter written
//     here: stdlib yaml only reads; the output reads back with yaml_load)
//   - parse a JSON document back into the model
//   - validate an incoming request against it: find the operation by
//     method and path template ("/users/{id}"), check required parameters,
//     coerce path/query/header strings to the parameter schema's type and
//     validate them, and validate the JSON body; schemas are JSON Schema
//     2020-12 (stdlib jsonschema) and may $ref "#/components/schemas/X"
//
// Everything here is real; there is no platform seam (requests are plain
// data: method, path, query/header name-value lists, body text).
//
// Usage:
//   var doc: ApiDoc = openapi_new("Pets", "1.0.0");
//   var r: ApiRoute = openapi_route("get", "/pets/{id}", "getPet");
//   openapi_param(& mut r, "id", "path", true, "{\"type\":\"integer\"}");
//   openapi_response(& mut r, "200", "a pet", "{\"$ref\":\"#/components/schemas/Pet\"}");
//   doc.routes.push(r);
//   val text: str = openapi_to_json(& doc);
//   val errs: Vec<str> = openapi_check_request(& doc, req);

module openapi;
use vec;
use json;
use jsonschema;

pub struct ApiParam {
    pub name: str,
    pub location: str,  // path | query | header | cookie
    pub required: bool,
    pub schema: str,  // JSON Schema text
    pub description: str,
}

pub struct ApiResponse {
    pub status: str,  // "200", "404", "default"
    pub description: str,
    pub schema: str,  // "" when the response has no JSON body
}

pub struct ApiRoute {
    pub method: str,  // lowercase: get post put patch delete head options
    pub path: str,
    pub operation_id: str,
    pub summary: str,
    pub tags: Vec<str>,
    pub params: Vec<ApiParam>,
    pub body_schema: str,  // "" when there is no request body
    pub body_required: bool,
    pub responses: Vec<ApiResponse>,
}

pub struct ApiDoc {
    pub title: str,
    pub version: str,
    pub description: str,
    pub servers: Vec<str>,
    pub routes: Vec<ApiRoute>,
    pub schema_names: Vec<str>,
    pub schemas: Vec<str>,
}

/// An incoming request, as data.
pub struct ApiRequest {
    pub method: str,
    pub path: str,
    pub query_names: Vec<str>,
    pub query_vals: Vec<str>,
    pub header_names: Vec<str>,
    pub header_vals: Vec<str>,
    pub body: str,  // "" when absent
}

// ─── building ───────────────────────────────────────────────────────────

pub fn openapi_new(title: str, version: str) -> ApiDoc {
    return ApiDoc {
        title: title, version: version, description: "", servers: Vec::new(), routes: Vec::new(), schema_names: Vec::new(), schemas: Vec::new()
    };
}

fn oa_lower(s: str) -> str {
    var o: str = "";
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c >= 65 && c <= 90 {
            c = c + 32;
        }
        o = o + char_to_str(c);
        i = i + 1;
    }
    return o;
}

pub fn openapi_route(method: str, path: str, operation_id: str) -> ApiRoute {
    return ApiRoute {
        method: oa_lower(method), path: path, operation_id: operation_id, summary: "", tags: Vec::new(), params: Vec::new(), body_schema: "", body_required: false, responses: Vec::new()
    };
}

pub fn openapi_param(r: &mut ApiRoute, name: str, location: str, required: bool, schema: str) {
    // path parameters are always required (OpenAPI 3.1 §4.8.12.1)
    r.params.push(ApiParam {
        name: name, location: location, required: required || location == "path", schema: schema, description: ""
    });
}

pub fn openapi_body(r: &mut ApiRoute, schema: str, required: bool) {
    r.body_schema = schema;
    r.body_required = required;
}

pub fn openapi_response(r: &mut ApiRoute, status: str, description: str, schema: str) {
    r.responses.push(ApiResponse {
        status: status, description: description, schema: schema
    });
}

/// Add a shared schema under #/components/schemas/<name>.
pub fn openapi_schema(d: &mut ApiDoc, name: str, schema: str) {
    d.schema_names.push(name);
    d.schemas.push(schema);
}

// ─── JSON serialization ─────────────────────────────────────────────────

fn oa_obj() -> str {
    return "{}";
}

fn oa_content(schema: str) -> str {
    return json_obj_set("{}", "application/json", json_obj_set("{}", "schema", schema));
}

fn oa_operation(r: &ApiRoute) -> str {
    var op: str = "{}";
    if str_len(r.operation_id) > 0 {
        op = json_obj_set(op, "operationId", json_string(r.operation_id));
    }
    if str_len(r.summary) > 0 {
        op = json_obj_set(op, "summary", json_string(r.summary));
    }
    if r.tags.len() > 0 {
        var t: str = "[]";
        var i: i64 = 0;
        while i < r.tags.len() {
            t = json_arr_push(t, json_string(r.tags.get(i)));
            i = i + 1;
        }
        op = json_obj_set(op, "tags", t);
    }
    if r.params.len() > 0 {
        var ps: str = "[]";
        var i: i64 = 0;
        while i < r.params.len() {
            val p: ApiParam = r.params.get(i);
            var po: str = "{}";
            po = json_obj_set(po, "name", json_string(p.name));
            po = json_obj_set(po, "in", json_string(p.location));
            po = json_obj_set(po, "required", json_bool(p.required));
            po = json_obj_set(po, "schema", p.schema);
            if str_len(p.description) > 0 {
                po = json_obj_set(po, "description", json_string(p.description));
            }
            ps = json_arr_push(ps, po);
            i = i + 1;
        }
        op = json_obj_set(op, "parameters", ps);
    }
    if str_len(r.body_schema) > 0 {
        var b: str = json_obj_set("{}", "content", oa_content(r.body_schema));
        b = json_obj_set(b, "required", json_bool(r.body_required));
        op = json_obj_set(op, "requestBody", b);
    }
    var rs: str = "{}";
    var i: i64 = 0;
    while i < r.responses.len() {
        val resp: ApiResponse = r.responses.get(i);
        var ro: str = json_obj_set("{}", "description", json_string(resp.description));
        if str_len(resp.schema) > 0 {
            ro = json_obj_set(ro, "content", oa_content(resp.schema));
        }
        rs = json_obj_set(rs, resp.status, ro);
        i = i + 1;
    }
    op = json_obj_set(op, "responses", rs);
    return op;
}

/// The document as canonical JSON text (keys sorted).
pub fn openapi_to_json(d: &ApiDoc) -> str {
    var info: str = json_obj_set("{}", "title", json_string(d.title));
    info = json_obj_set(info, "version", json_string(d.version));
    if str_len(d.description) > 0 {
        info = json_obj_set(info, "description", json_string(d.description));
    }
    var doc: str = json_obj_set("{}", "openapi", json_string("3.1.0"));
    doc = json_obj_set(doc, "info", info);
    if d.servers.len() > 0 {
        var sv: str = "[]";
        var i: i64 = 0;
        while i < d.servers.len() {
            sv = json_arr_push(sv, json_obj_set("{}", "url", json_string(d.servers.get(i))));
            i = i + 1;
        }
        doc = json_obj_set(doc, "servers", sv);
    }
    var paths: str = "{}";
    var i: i64 = 0;
    while i < d.routes.len() {
        val r: ApiRoute = d.routes.get(i);
        var item: str = "{}";
        if json_has(paths, r.path) {
            item = json_get(paths, r.path);
        }
        item = json_obj_set(item, r.method, oa_operation(&r));
        paths = json_obj_set(paths, r.path, item);
        i = i + 1;
    }
    doc = json_obj_set(doc, "paths", paths);
    if d.schemas.len() > 0 {
        var sc: str = "{}";
        var k: i64 = 0;
        while k < d.schemas.len() {
            sc = json_obj_set(sc, d.schema_names.get(k), d.schemas.get(k));
            k = k + 1;
        }
        doc = json_obj_set(doc, "components", json_obj_set("{}", "schemas", sc));
    }
    return json_parse(doc);
}

// ─── YAML emitter (block style, from JSON text) ─────────────────────────

fn oa_pad(n: i64) -> str {
    var o: str = "";
    var i: i64 = 0;
    while i < n {
        o = o + "  ";
        i = i + 1;
    }
    return o;
}

// a scalar that YAML would read as something else (or that is not plain)
// is double-quoted, with JSON's escapes (a YAML double-quoted scalar
// accepts them)
fn oa_yaml_str(s: str) -> str {
    var plain: bool = str_len(s) > 0;
    if s == "true" || s == "false" || s == "null" || s == "~" || s == "yes" || s == "no" {
        plain = false;
    }
    var i: i64 = 0;
    while plain && i < str_len(s) {
        val c: i64 = str_byte_at(s, i);
        val ok: bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 47 || c == 46 || c == 45 || c == 32 || c == 40 || c == 41;
        if !ok {
            plain = false;
        }
        i = i + 1;
    }
    if plain {
        val c0: i64 = str_byte_at(s, 0);
        // leading digit/sign/dot/space could read as a number or need quotes
        if (c0 >= 48 && c0 <= 57) || c0 == 45 || c0 == 46 || c0 == 32 || str_byte_at(s, str_len(s) - 1) == 32 {
            plain = false;
        }
    }
    if plain {
        return s;
    }
    return json_string(s);
}

fn oa_yaml_scalar(v: str) -> str {
    val t: str = json_type_safe(v);
    if t == "string" {
        return oa_yaml_str(json_unescape(v));
    }
    return v;  // number, true, false, null read the same in YAML
}

fn oa_yaml_empty(v: str) -> bool {
    val t: str = json_type_safe(v);
    return (t == "object" || t == "array") && json_len(v) == 0;
}

fn oa_yaml(v: str, indent: i64) -> str {
    val t: str = json_type_safe(v);
    var o: str = "";
    if t == "object" {
        val keys: Vec<str> = json_keys(v);
        var i: i64 = 0;
        while i < keys.len() {
            val k: str = keys.get(i);
            val child: str = json_get(v, k);
            val ct: str = json_type_safe(child);
            o = o + oa_pad(indent) + oa_yaml_str(k) + ":";
            if oa_yaml_empty(child) {
                if ct == "object" {
                    o = o + " {}\n";
                } else {
                    o = o + " []\n";
                }
            } else if ct == "object" || ct == "array" {
                o = o + "\n" + oa_yaml(child, indent + 1);
            } else {
                o = o + " " + oa_yaml_scalar(child) + "\n";
            }
            i = i + 1;
        }
    } else if t == "array" {
        val items: Vec<str> = json_items(v);
        var i: i64 = 0;
        while i < items.len() {
            val child: str = items.get(i);
            val ct: str = json_type_safe(child);
            if oa_yaml_empty(child) {
                if ct == "object" {
                    o = o + oa_pad(indent) + "- {}\n";
                } else {
                    o = o + oa_pad(indent) + "- []\n";
                }
            } else if ct == "object" || ct == "array" {
                // "- " then the first line of the nested block on the same line
                val nested: str = oa_yaml(child, indent + 1);
                o = o + oa_pad(indent) + "-" + str_slice(nested, indent * 2 + 1, str_len(nested));
            } else {
                o = o + oa_pad(indent) + "- " + oa_yaml_scalar(child) + "\n";
            }
            i = i + 1;
        }
    } else {
        o = oa_pad(indent) + oa_yaml_scalar(v) + "\n";
    }
    return o;
}

/// The document as YAML (block style).
pub fn openapi_to_yaml(d: &ApiDoc) -> str {
    return oa_yaml(openapi_to_json(d), 0);
}

/// Any JSON text as block-style YAML.
pub fn json_to_yaml(v: str) -> str {
    return oa_yaml(v, 0);
}

// ─── parsing ────────────────────────────────────────────────────────────

fn oa_schema_of_content(c: str) -> str {
    if json_type_safe(c) != "object" || !json_has(c, "application/json") {
        return "";
    }
    val mt: str = json_get(c, "application/json");
    if !json_has(mt, "schema") {
        return "";
    }
    return json_get(mt, "schema");
}

/// Read a JSON OpenAPI document back into the model. Unknown members are
/// ignored. An invalid document gives an empty model titled "".
pub fn openapi_parse(text: str) -> ApiDoc {
    var d: ApiDoc = openapi_new("", "");
    if json_type_safe(text) != "object" {
        return d;
    }
    val info: str = json_get_safe(text, "info");
    d.title = json_get_str(info, "title");
    d.version = json_get_str(info, "version");
    d.description = json_get_str(info, "description");
    val servers: Vec<str> = json_items(json_get_safe(text, "servers"));
    var i: i64 = 0;
    while i < servers.len() {
        d.servers.push(json_get_str(servers.get(i), "url"));
        i = i + 1;
    }
    val paths: str = json_get_safe(text, "paths");
    val pkeys: Vec<str> = json_keys(paths);
    var pi: i64 = 0;
    while pi < pkeys.len() {
        val item: str = json_get(paths, pkeys.get(pi));
        val mkeys: Vec<str> = json_keys(item);
        var mi: i64 = 0;
        while mi < mkeys.len() {
            val m: str = mkeys.get(mi);
            val op: str = json_get(item, m);
            var r: ApiRoute = openapi_route(m, pkeys.get(pi), json_get_str(op, "operationId"));
            r.summary = json_get_str(op, "summary");
            val tags: Vec<str> = json_items(json_get_safe(op, "tags"));
            var ti: i64 = 0;
            while ti < tags.len() {
                r.tags.push(json_unescape(tags.get(ti)));
                ti = ti + 1;
            }
            val params: Vec<str> = json_items(json_get_safe(op, "parameters"));
            var k: i64 = 0;
            while k < params.len() {
                val p: str = params.get(k);
                var schema: str = "{}";
                if json_has(p, "schema") {
                    schema = json_get(p, "schema");
                }
                r.params.push(ApiParam {
                    name: json_get_str(p, "name"), location: json_get_str(p, "in"), required: json_get_bool(p, "required", false), schema: schema, description: json_get_str(p, "description")
                });
                k = k + 1;
            }
            if json_has(op, "requestBody") {
                val rb: str = json_get(op, "requestBody");
                r.body_schema = oa_schema_of_content(json_get_safe(rb, "content"));
                r.body_required = json_get_bool(rb, "required", false);
            }
            val resp: str = json_get_safe(op, "responses");
            val rkeys: Vec<str> = json_keys(resp);
            k = 0;
            while k < rkeys.len() {
                val ro: str = json_get(resp, rkeys.get(k));
                r.responses.push(ApiResponse {
                    status: rkeys.get(k), description: json_get_str(ro, "description"), schema: oa_schema_of_content(json_get_safe(ro, "content"))
                });
                k = k + 1;
            }
            d.routes.push(r);
            mi = mi + 1;
        }
        pi = pi + 1;
    }
    val comps: str = json_get_safe(text, "components");
    if json_type_safe(comps) == "object" && json_has(comps, "schemas") {
        val sc: str = json_get(comps, "schemas");
        val names: Vec<str> = json_keys(sc);
        var k: i64 = 0;
        while k < names.len() {
            d.schema_names.push(names.get(k));
            d.schemas.push(json_get(sc, names.get(k)));
            k = k + 1;
        }
    }
    return d;
}

// ─── request validation ─────────────────────────────────────────────────

pub fn openapi_request(method: str, path: str) -> ApiRequest {
    return ApiRequest {
        method: oa_lower(method), path: path, query_names: Vec::new(), query_vals: Vec::new(), header_names: Vec::new(), header_vals: Vec::new(), body: ""
    };
}

pub fn openapi_req_query(r: &mut ApiRequest, name: str, value: str) {
    r.query_names.push(name);
    r.query_vals.push(value);
}

pub fn openapi_req_header(r: &mut ApiRequest, name: str, value: str) {
    r.header_names.push(oa_lower(name));
    r.header_vals.push(value);
}

/// Match a concrete path against a template; the captured parameters as
/// [name, value, name, value...], or ["!"] when it does not match.
pub fn openapi_match_path(template: str, path: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    val ts: Vec<str> = str_split(template, "/");
    val ps: Vec<str> = str_split(path, "/");
    if ts.len() != ps.len() {
        out.push("!");
        return out;
    }
    var i: i64 = 0;
    while i < ts.len() {
        val t: str = ts.get(i);
        val p: str = ps.get(i);
        if str_len(t) >= 2 && str_byte_at(t, 0) == 123 && str_byte_at(t, str_len(t) - 1) == 125 {
            if str_len(p) == 0 {
                var bad: Vec<str> = Vec::new();
                bad.push("!");
                return bad;
            }
            out.push(str_slice(t, 1, str_len(t) - 1));
            out.push(p);
        } else if t != p {
            var bad: Vec<str> = Vec::new();
            bad.push("!");
            return bad;
        }
        i = i + 1;
    }
    return out;
}

/// The index of the route a request maps to, or -1. A literal segment
/// beats a template one: routes are tried with the fewest {} first.
pub fn openapi_find_route(d: &ApiDoc, method: str, path: str) -> i64 {
    var best: i64 = -1;
    var best_vars: i64 = 1000;
    val m: str = oa_lower(method);
    var i: i64 = 0;
    while i < d.routes.len() {
        val r: ApiRoute = d.routes.get(i);
        if r.method == m {
            val caps: Vec<str> = openapi_match_path(r.path, path);
            if caps.len() == 0 || caps.get(0) != "!" {
                if caps.len() / 2 < best_vars {
                    best = i;
                    best_vars = caps.len() / 2;
                }
            }
        }
        i = i + 1;
    }
    return best;
}

fn oa_lookup(names: &Vec<str>, vals: &Vec<str>, name: str) -> i64 {
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn oa_is_number(s: str) -> bool {
    if str_len(s) == 0 {
        return false;
    }
    var i: i64 = 0;
    var digits: i64 = 0;
    if str_byte_at(s, 0) == 45 {
        i = 1;
    }
    var dots: i64 = 0;
    while i < str_len(s) {
        val c: i64 = str_byte_at(s, i);
        if c >= 48 && c <= 57 {
            digits = digits + 1;
        } else if c == 46 {
            dots = dots + 1;
        } else {
            return false;
        }
        i = i + 1;
    }
    return digits > 0 && dots <= 1;
}

// a parameter string as the JSON value its schema's type expects; strings
// that do not fit stay strings, so the schema check reports the mismatch
fn oa_coerce(schema: str, raw: str) -> str {
    val t: str = json_get_str(schema, "type");
    if (t == "integer" || t == "number") && oa_is_number(raw) {
        return raw;
    }
    if t == "boolean" && (raw == "true" || raw == "false") {
        return raw;
    }
    return json_string(raw);
}

// a schema with the document's components attached, so "#/components/..."
// references resolve against it
fn oa_rooted(d: &ApiDoc, schema: str) -> str {
    if d.schemas.len() == 0 || json_type_safe(schema) != "object" {
        return schema;
    }
    var sc: str = "{}";
    var k: i64 = 0;
    while k < d.schemas.len() {
        sc = json_obj_set(sc, d.schema_names.get(k), d.schemas.get(k));
        k = k + 1;
    }
    return json_obj_set(schema, "components", json_obj_set("{}", "schemas", sc));
}

/// Validate a request against the document: [] when it is acceptable,
/// otherwise one message per problem (the first says when no operation
/// matches).
pub fn openapi_check_request(d: &ApiDoc, req: &ApiRequest) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    val ri: i64 = openapi_find_route(d, req.method, req.path);
    if ri < 0 {
        errs.push("no operation for " + str_to_upper(req.method) + " " + req.path);
        return errs;
    }
    val r: ApiRoute = d.routes.get(ri);
    val caps: Vec<str> = openapi_match_path(r.path, req.path);
    var cap_names: Vec<str> = Vec::new();
    var cap_vals: Vec<str> = Vec::new();
    var c: i64 = 0;
    while c + 1 < caps.len() {
        cap_names.push(caps.get(c));
        cap_vals.push(caps.get(c + 1));
        c = c + 2;
    }
    var i: i64 = 0;
    while i < r.params.len() {
        val p: ApiParam = r.params.get(i);
        var idx: i64 = -1;
        var raw: str = "";
        if p.location == "path" {
            idx = oa_lookup(&cap_names, &cap_vals, p.name);
            if idx >= 0 {
                raw = cap_vals.get(idx);
            }
        } else if p.location == "query" {
            idx = oa_lookup(&req.query_names, &req.query_vals, p.name);
            if idx >= 0 {
                raw = req.query_vals.get(idx);
            }
        } else if p.location == "header" {
            idx = oa_lookup(&req.header_names, &req.header_vals, oa_lower(p.name));
            if idx >= 0 {
                raw = req.header_vals.get(idx);
            }
        }
        if idx < 0 {
            if p.required {
                errs.push(p.location + " parameter \"" + p.name + "\" is required");
            }
        } else {
            val res: JsResult = jsonschema_validate(oa_rooted(d, p.schema), oa_coerce(p.schema, raw));
            var k: i64 = 0;
            while k < res.errors.len() {
                errs.push(p.location + " parameter \"" + p.name + "\": " + res.errors.get(k));
                k = k + 1;
            }
        }
        i = i + 1;
    }
    if str_len(r.body_schema) > 0 {
        if str_len(str_trim(req.body)) == 0 {
            if r.body_required {
                errs.push("request body is required");
            }
        } else {
            val res: JsResult = jsonschema_validate(oa_rooted(d, r.body_schema), req.body);
            var k: i64 = 0;
            while k < res.errors.len() {
                errs.push("body " + res.errors.get(k));
                k = k + 1;
            }
        }
    }
    return errs;
}
