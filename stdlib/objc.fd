// Fides Objective-C runtime bridge (iOS, macOS)
//
// What is real (pure Fides, tested in the interpreter):
//   - Objective-C type encodings (the @encode letters): C type names to
//     encodings ("void" -> "v", "id" -> "@", "CGRect" ->
//     "{CGRect={CGPoint=dd}{CGSize=dd}}"), method type strings ("v@:@"),
//     a parser for encodings (qualifiers, pointers, structs, unions,
//     arrays, blocks "@?") with LP64 sizes and alignments, and the
//     offset-annotated form the runtime reports ("v24@0:8@16")
//   - selectors: argument count from the colons, checks that a method's
//     type string matches its selector (self '@', _cmd ':', one type per
//     colon)
//   - delegate classes: a spec (name, superclass, protocols, methods)
//     validated before anything reaches the runtime, and the registration
//     sequence objc_allocateClassPair, class_addProtocol, class_addMethod,
//     objc_registerClassPair
//   - Foundation conversions done with object/integer messages only:
//     NSString <-> str (stringWithUTF8String:, UTF8String), NSMutableArray,
//     NSMutableDictionary, NSNumber, and double properties through
//     key-value coding (NSDecimalNumber decimalNumberWithString: then
//     setValue:forKey:; valueForKey: then stringValue)
//
// The platform seam: the runtime functions of libobjc are declared below.
// objc_msgSend is declared once, as (id, SEL, a1..a4) -> id: on arm64 and
// x86_64 this is the right call for any message whose arguments and
// result are objects, selectors, pointers, integers or BOOL (unused
// argument registers are ignored by the callee). Messages that take or
// return floating point or structs by value are not called through it
// (objc_msgSend_fpret/stret do not exist on arm64); use the KVC helpers
// or an NSValue/NSNumber method instead. All messaging goes through an
// `ObjcRuntime` struct of function values: `objc_runtime_native()` wraps
// libobjc (device builds), tests pass a fake runtime.
//
// class_addMethod takes a C function pointer, so it is called by the app
// with a named function (Fides refuses a function variable there):
//   val cls = objc_class_begin(&rt, spec);
//   unsafe { objc_c_class_add_method(cls, rt_sel, my_imp, "v@:@"); }
//   objc_class_end(&rt, cls);
// where `fn my_imp(self_: i64, cmd: i64, arg: i64) -> i64`.

module objc;
use vec;
use string;
use encoding;

// ─── libobjc ───────────────────────────────────────────────────────────

// SAFETY: <objc/runtime.h> and <objc/message.h> prototypes with id, SEL,
// Class and pointers as i64 words; names are NUL-terminated Fides
// strings. Device builds only.
extern "C" link "objc" {
    fn objc_getClass as objc_c_get_class(name: str) -> i64;
    fn objc_lookUpClass as objc_c_look_up_class(name: str) -> i64;
    fn objc_getProtocol as objc_c_get_protocol(name: str) -> i64;
    fn sel_registerName as objc_c_sel_register(name: str) -> i64;
    fn sel_getName as objc_c_sel_get_name(sel: i64) -> i64;
    fn objc_msgSend as objc_c_msg_send(recv: i64, sel: i64, a1: i64, a2: i64, a3: i64, a4: i64) -> i64;
    fn objc_allocateClassPair as objc_c_allocate_class_pair(superclass: i64, name: str, extra: i64) -> i64;
    fn objc_registerClassPair as objc_c_register_class_pair(cls: i64) -> void;
    fn objc_disposeClassPair as objc_c_dispose_class_pair(cls: i64) -> void;
    fn class_addMethod as objc_c_class_add_method(cls: i64, sel: i64, imp: fn(i64, i64, i64) -> i64, types: str) -> i64;
    fn class_addProtocol as objc_c_class_add_protocol(cls: i64, proto: i64) -> i64;
    fn class_addIvar as objc_c_class_add_ivar(cls: i64, name: str, size: i64, log2_align: i64, types: str) -> i64;
    fn class_getName as objc_c_class_get_name(cls: i64) -> i64;
    fn class_respondsToSelector as objc_c_class_responds(cls: i64, sel: i64) -> i64;
    fn class_getInstanceMethod as objc_c_class_instance_method(cls: i64, sel: i64) -> i64;
    fn method_getTypeEncoding as objc_c_method_type_encoding(method: i64) -> i64;
    fn object_getClass as objc_c_object_get_class(obj: i64) -> i64;
    fn objc_autoreleasePoolPush as objc_c_pool_push() -> i64;
    fn objc_autoreleasePoolPop as objc_c_pool_pop(pool: i64) -> void;
}

// ─── Type encodings ────────────────────────────────────────────────────

pub const OBJC_ENC_CGPOINT: str = "{CGPoint=dd}";
pub const OBJC_ENC_CGSIZE: str = "{CGSize=dd}";
pub const OBJC_ENC_CGRECT: str = "{CGRect={CGPoint=dd}{CGSize=dd}}";
pub const OBJC_ENC_NSRANGE: str = "{_NSRange=QQ}";

/// The encoding of a C / Objective-C type name on arm64 (BOOL is bool,
/// "B"; use objc_bool_encoding for x86_64). Unknown names give "?".
pub fn objc_encode_type(t: str) -> str {
    val n: str = str_trim(t);
    if str_ends_with(n, "*") && n != "char*" && n != "const char*" {
        val inner: str = str_trim(str_slice(n, 0, str_len(n) - 1));
        if inner == "void" { return "^v"; }
        if inner == "id" { return "^@"; }
        val e: str = objc_encode_type(inner);
        // a pointer to a class type (NSString*, UIView*) is an object
        if e == "@" || (e == "?" && char_is_upper(str_byte_at(inner, 0))) { return "@"; }
        return "^" + e;
    }
    if n == "void" { return "v"; }
    if n == "id" || str_starts_with(n, "NS") && !str_starts_with(n, "NSInteger") && !str_starts_with(n, "NSUInteger") && n != "NSRange" { return "@"; }
    if n == "SEL" { return ":"; }
    if n == "Class" { return "#"; }
    if n == "BOOL" || n == "bool" { return "B"; }
    if n == "char" { return "c"; }
    if n == "unsigned char" || n == "uint8_t" { return "C"; }
    if n == "short" || n == "int16_t" { return "s"; }
    if n == "unsigned short" || n == "uint16_t" || n == "unichar" { return "S"; }
    if n == "int" || n == "int32_t" { return "i"; }
    if n == "unsigned int" || n == "uint32_t" { return "I"; }
    if n == "long" || n == "long long" || n == "NSInteger" || n == "int64_t" { return "q"; }
    if n == "unsigned long" || n == "unsigned long long" || n == "NSUInteger" || n == "uint64_t" || n == "size_t" { return "Q"; }
    if n == "float" { return "f"; }
    if n == "double" || n == "CGFloat" || n == "NSTimeInterval" { return "d"; }
    if n == "char*" || n == "const char*" { return "*"; }
    if n == "CGPoint" { return OBJC_ENC_CGPOINT; }
    if n == "CGSize" { return OBJC_ENC_CGSIZE; }
    if n == "CGRect" { return OBJC_ENC_CGRECT; }
    if n == "NSRange" { return OBJC_ENC_NSRANGE; }
    if n == "block" { return "@?"; }
    return "?";
}

/// BOOL's encoding: "B" on arm64 (iOS, Apple silicon), "c" on x86_64.
pub fn objc_bool_encoding(arm64: bool) -> str {
    if arm64 { return "B"; }
    return "c";
}

/// A method's type string: return type, self, _cmd, then the arguments.
pub fn objc_method_types(ret: str, args: Vec<str>) -> str {
    var s: str = objc_encode_type(ret) + "@:";
    var i: i64 = 0;
    while i < args.len() { s = s + objc_encode_type(args.get(i)); i = i + 1; }
    return s;
}

/// One parsed type of an encoding string.
pub struct ObjcType {
    pub enc: str,     // the type's encoding text, qualifiers removed
    pub size: i64,    // bytes on LP64 (0 for void or an opaque struct)
    pub align: i64,
}

/// A parsed encoding: the types in order; `ok` false on malformed text.
pub struct ObjcTypes {
    pub ok: bool,
    pub types: Vec<ObjcType>,
}

fn objc_is_digit(c: i64) -> bool { return c >= 48 && c <= 57; }

fn objc_is_qualifier(c: i64) -> bool {
    // r const, n in, N inout, o out, O bycopy, R byref, V oneway, A atomic
    return c == 114 || c == 110 || c == 78 || c == 111 || c == 79 || c == 82 || c == 86 || c == 65;
}

fn objc_align_up(x: i64, a: i64) -> i64 {
    if a <= 1 { return x; }
    return ((x + a - 1) / a) * a;
}

// Parse one type at `pos` of `s`; result in out_*: [end, size, align]
// (end -1 on error). Leading qualifiers and trailing offset digits are
// the caller's business.
fn objc_parse_one(s: str, pos: i64) -> Vec<i64> {
    var r: Vec<i64> = Vec::new();
    val n: i64 = str_len(s);
    var i: i64 = pos;
    while i < n && objc_is_qualifier(str_byte_at(s, i)) { i = i + 1; }
    if i >= n { r.push(-1); r.push(0); r.push(1); return r; }
    val c: i64 = str_byte_at(s, i);
    var size: i64 = 0;
    var align: i64 = 1;
    var end: i64 = i + 1;
    if c == 99 || c == 67 || c == 66 { size = 1; align = 1; }           // c C B
    else if c == 115 || c == 83 { size = 2; align = 2; }                // s S
    else if c == 105 || c == 73 || c == 108 || c == 76 || c == 102 { size = 4; align = 4; } // i I l L f
    else if c == 113 || c == 81 || c == 100 { size = 8; align = 8; }    // q Q d
    else if c == 118 { size = 0; align = 1; }                           // v
    else if c == 42 || c == 35 || c == 58 { size = 8; align = 8; }      // * # :
    else if c == 63 { size = 8; align = 8; }                            // ? (function pointer)
    else if c == 64 {                                                   // @, @? block, @"Name"
        size = 8; align = 8;
        if end < n && str_byte_at(s, end) == 63 { end = end + 1; }
        else if end < n && str_byte_at(s, end) == 34 {
            var k: i64 = end + 1;
            while k < n && str_byte_at(s, k) != 34 { k = k + 1; }
            if k >= n { r.push(-1); r.push(0); r.push(1); return r; }
            end = k + 1;
        }
    }
    else if c == 94 {                                                   // ^type
        val inner: Vec<i64> = objc_parse_one(s, i + 1);
        if inner.get(0) < 0 { return inner; }
        end = inner.get(0);
        size = 8; align = 8;
    }
    else if c == 98 {                                                   // bN bitfield
        var k: i64 = i + 1;
        var bits: i64 = 0;
        while k < n && objc_is_digit(str_byte_at(s, k)) { bits = bits * 10 + str_byte_at(s, k) - 48; k = k + 1; }
        end = k;
        size = (bits + 7) / 8; align = 1;
    }
    else if c == 91 {                                                   // [N type]
        var k: i64 = i + 1;
        var count: i64 = 0;
        while k < n && objc_is_digit(str_byte_at(s, k)) { count = count * 10 + str_byte_at(s, k) - 48; k = k + 1; }
        val inner: Vec<i64> = objc_parse_one(s, k);
        if inner.get(0) < 0 || inner.get(0) >= n || str_byte_at(s, inner.get(0)) != 93 { r.push(-1); r.push(0); r.push(1); return r; }
        end = inner.get(0) + 1;
        size = count * inner.get(1);
        align = inner.get(2);
    }
    else if c == 123 || c == 40 {                                       // {name=...} or (name=...)
        val close: i64 = if c == 123 { 125 } else { 41 };
        var k: i64 = i + 1;
        while k < n && str_byte_at(s, k) != 61 && str_byte_at(s, k) != close { k = k + 1; }
        if k >= n { r.push(-1); r.push(0); r.push(1); return r; }
        var off: i64 = 0;
        var maxa: i64 = 1;
        var maxs: i64 = 0;
        if str_byte_at(s, k) == 61 {
            k = k + 1;
            while k < n && str_byte_at(s, k) != close {
                // a field may carry a quoted name: "x"d
                if str_byte_at(s, k) == 34 {
                    k = k + 1;
                    while k < n && str_byte_at(s, k) != 34 { k = k + 1; }
                    k = k + 1;
                }
                val f: Vec<i64> = objc_parse_one(s, k);
                if f.get(0) < 0 { return f; }
                if f.get(2) > maxa { maxa = f.get(2); }
                if f.get(1) > maxs { maxs = f.get(1); }
                off = objc_align_up(off, f.get(2)) + f.get(1);
                k = f.get(0);
            }
            if k >= n { r.push(-1); r.push(0); r.push(1); return r; }
        }
        end = k + 1;
        align = maxa;
        if c == 123 { size = objc_align_up(off, maxa); } else { size = objc_align_up(maxs, maxa); }
    }
    else { r.push(-1); r.push(0); r.push(1); return r; }
    r.push(end); r.push(size); r.push(align);
    return r;
}

/// Parse a type string such as "v@:@" or the runtime's "v24@0:8@16"
/// (offset digits between types are skipped).
pub fn objc_parse_types(s: str) -> ObjcTypes {
    var out: Vec<ObjcType> = Vec::new();
    val n: i64 = str_len(s);
    var i: i64 = 0;
    while i < n {
        var q: i64 = i;
        while q < n && objc_is_qualifier(str_byte_at(s, q)) { q = q + 1; }
        val one: Vec<i64> = objc_parse_one(s, q);
        if one.get(0) < 0 { return ObjcTypes { ok: false, types: Vec::new() }; }
        out.push(ObjcType { enc: str_slice(s, q, one.get(0)), size: one.get(1), align: one.get(2) });
        i = one.get(0);
        while i < n && (objc_is_digit(str_byte_at(s, i)) || str_byte_at(s, i) == 45) { i = i + 1; }
    }
    return ObjcTypes { ok: true, types: out };
}

/// The size in bytes of one encoded type (LP64), -1 if malformed.
pub fn objc_type_size(enc: str) -> i64 {
    val r: Vec<i64> = objc_parse_one(enc, 0);
    if r.get(0) != str_len(enc) { return -1; }
    return r.get(1);
}

/// The annotated form the runtime's method_getTypeEncoding gives:
/// "v@:@" -> "v24@0:8@16" (each argument in 8-byte slots).
pub fn objc_annotate_types(s: str) -> str {
    val p: ObjcTypes = objc_parse_types(s);
    if !p.ok || p.types.len() == 0 { return ""; }
    var off: i64 = 0;
    var body: str = "";
    var i: i64 = 1;
    while i < p.types.len() {
        val t: ObjcType = p.types.get(i);
        body = body + t.enc + int_to_str(off);
        off = off + objc_align_up(t.size, 8);
        i = i + 1;
    }
    return p.types.get(0).enc + int_to_str(off) + body;
}

// ─── Selectors and method checks ───────────────────────────────────────

/// Arguments a selector takes: its number of colons.
pub fn objc_selector_args(sel: str) -> i64 {
    var k: i64 = 0;
    var i: i64 = 0;
    while i < str_len(sel) {
        if str_byte_at(sel, i) == 58 { k = k + 1; }
        i = i + 1;
    }
    return k;
}

/// Is `sel` a well-formed selector name (identifier parts, each part of a
/// multi-argument selector ending in ':')?
pub fn objc_selector_valid(sel: str) -> bool {
    val n: i64 = str_len(sel);
    if n == 0 { return false; }
    val c0: i64 = str_byte_at(sel, 0);
    if !(char_is_alpha(c0) || c0 == 95) { return false; }
    var i: i64 = 0;
    var prev_colon: bool = false;
    while i < n {
        val c: i64 = str_byte_at(sel, i);
        if c == 58 { prev_colon = true; }
        else if char_is_alpha(c) || char_is_digit(c) || c == 95 { prev_colon = false; }
        else { return false; }
        i = i + 1;
    }
    // "a:b" (an argument-less tail after a colon) is not a selector
    return objc_selector_args(sel) == 0 || prev_colon;
}

/// "" when `types` fits selector `sel`, else why not.
pub fn objc_method_check(sel: str, types: str) -> str {
    if !objc_selector_valid(sel) { return "bad selector " + sel; }
    val p: ObjcTypes = objc_parse_types(types);
    if !p.ok { return "bad type encoding " + types; }
    if p.types.len() < 3 { return "types need return, self and _cmd"; }
    if p.types.get(1).enc != "@" { return "self must be @"; }
    if p.types.get(2).enc != ":" { return "_cmd must be :"; }
    val want: i64 = objc_selector_args(sel);
    if p.types.len() - 3 != want {
        return sel + " takes " + int_to_str(want) + " arguments, types give " + int_to_str(p.types.len() - 3);
    }
    return "";
}

// ─── The runtime seam ──────────────────────────────────────────────────

/// Everything this module asks of libobjc.
pub struct ObjcRuntime {
    pub get_class: fn(str) -> i64,
    pub sel: fn(str) -> i64,
    pub send: fn(i64, i64, Vec<i64>) -> i64,          // receiver, SEL, up to 4 args
    pub allocate_class: fn(i64, str) -> i64,          // superclass, name
    pub register_class: fn(i64) -> void,
    pub get_protocol: fn(str) -> i64,
    pub add_protocol: fn(i64, i64) -> i64,
}

fn objc_rt_get_class(name: str) -> i64 {
    var r: i64 = 0;
    // SAFETY: name is NUL-terminated; objc_getClass only reads it.
    unsafe { r = objc_c_get_class(name); }
    return r;
}

fn objc_rt_sel(name: str) -> i64 {
    var r: i64 = 0;
    // SAFETY: sel_registerName copies the name into the runtime's table.
    unsafe { r = objc_c_sel_register(name); }
    return r;
}

fn objc_rt_send(recv: i64, sel: i64, args: Vec<i64>) -> i64 {
    var a: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 4 {
        if i < args.len() { a.push(args.get(i)); } else { a.push(0); }
        i = i + 1;
    }
    var r: i64 = 0;
    // SAFETY: the message takes at most 4 word-sized arguments and returns
    // a word (see the header); extra argument registers are ignored.
    unsafe { r = objc_c_msg_send(recv, sel, a.get(0), a.get(1), a.get(2), a.get(3)); }
    return r;
}

fn objc_rt_allocate(superclass: i64, name: str) -> i64 {
    var r: i64 = 0;
    // SAFETY: superclass is a Class; the runtime copies the name.
    unsafe { r = objc_c_allocate_class_pair(superclass, name, 0); }
    return r;
}

fn objc_rt_register(cls: i64) {
    // SAFETY: cls came from objc_allocateClassPair and is registered once.
    unsafe { objc_c_register_class_pair(cls); }
}

fn objc_rt_protocol(name: str) -> i64 {
    var r: i64 = 0;
    // SAFETY: read-only lookup by name.
    unsafe { r = objc_c_get_protocol(name); }
    return r;
}

fn objc_rt_add_protocol(cls: i64, proto: i64) -> i64 {
    var r: i64 = 0;
    // SAFETY: cls is an unregistered class pair, proto a Protocol*.
    unsafe { r = objc_c_class_add_protocol(cls, proto); }
    return r;
}

/// The runtime of the device: libobjc.
pub fn objc_runtime_native() -> ObjcRuntime {
    return ObjcRuntime {
        get_class: objc_rt_get_class, sel: objc_rt_sel, send: objc_rt_send,
        allocate_class: objc_rt_allocate, register_class: objc_rt_register,
        get_protocol: objc_rt_protocol, add_protocol: objc_rt_add_protocol,
    };
}

/// Send `sel_name` to `recv` with word arguments.
pub fn objc_msg(rt: &ObjcRuntime, recv: i64, sel_name: str, args: Vec<i64>) -> i64 {
    val selfn: fn(str) -> i64 = rt.sel;
    val send: fn(i64, i64, Vec<i64>) -> i64 = rt.send;
    return send(recv, selfn(sel_name), args);
}

fn objc_v0() -> Vec<i64> { return Vec::new(); }
fn objc_v1(a: i64) -> Vec<i64> { var v: Vec<i64> = Vec::new(); v.push(a); return v; }
fn objc_v2(a: i64, b: i64) -> Vec<i64> { var v: Vec<i64> = objc_v1(a); v.push(b); return v; }

/// Send to a class by name: [ClassName sel...].
pub fn objc_class_msg(rt: &ObjcRuntime, cls_name: str, sel_name: str, args: Vec<i64>) -> i64 {
    val gc: fn(str) -> i64 = rt.get_class;
    return objc_msg(rt, gc(cls_name), sel_name, args);
}

/// [[Class alloc] init]
pub fn objc_new(rt: &ObjcRuntime, cls_name: str) -> i64 {
    val o: i64 = objc_class_msg(rt, cls_name, "alloc", objc_v0());
    return objc_msg(rt, o, "init", objc_v0());
}

pub fn objc_retain(rt: &ObjcRuntime, obj: i64) -> i64 { return objc_msg(rt, obj, "retain", objc_v0()); }
pub fn objc_release(rt: &ObjcRuntime, obj: i64) { objc_msg(rt, obj, "release", objc_v0()); }
pub fn objc_autorelease(rt: &ObjcRuntime, obj: i64) -> i64 { return objc_msg(rt, obj, "autorelease", objc_v0()); }

/// Does `obj` respond to a selector ([obj respondsToSelector:])?
pub fn objc_responds(rt: &ObjcRuntime, obj: i64, sel_name: str) -> bool {
    val selfn: fn(str) -> i64 = rt.sel;
    return objc_msg(rt, obj, "respondsToSelector:", objc_v1(selfn(sel_name))) != 0;
}

// ─── Foundation conversions ────────────────────────────────────────────

/// Text of a NUL-terminated C string at `addr` ("" for NULL).
pub fn objc_cstr_read(addr: i64) -> str {
    if addr == 0 { return ""; }
    var bytes: Vec<i64> = Vec::new();
    // SAFETY: addr is a NUL-terminated buffer the runtime returned.
    unsafe {
        var i: i64 = 0;
        loop {
            val p: *mut u8 = addr + i;
            val c: i64 = *p;
            if c == 0 { break; }
            bytes.push(c);
            i = i + 1;
        }
    }
    return enc_bytes_to_str(bytes);
}

/// An autoreleased NSString with the text of `s`.
pub fn objc_nsstring(rt: &ObjcRuntime, s: str) -> i64 {
    return objc_class_msg(rt, "NSString", "stringWithUTF8String:", objc_v1(s as i64));
}

/// The text of an NSString (its UTF8String), "" for nil.
pub fn objc_str(rt: &ObjcRuntime, ns: i64) -> str {
    if ns == 0 { return ""; }
    return objc_cstr_read(objc_msg(rt, ns, "UTF8String", objc_v0()));
}

/// [NSNumber numberWithLongLong:]
pub fn objc_nsnumber_int(rt: &ObjcRuntime, v: i64) -> i64 {
    return objc_class_msg(rt, "NSNumber", "numberWithLongLong:", objc_v1(v));
}

/// [num longLongValue]
pub fn objc_nsnumber_value(rt: &ObjcRuntime, num: i64) -> i64 {
    return objc_msg(rt, num, "longLongValue", objc_v0());
}

/// An NSMutableArray of objects.
pub fn objc_nsarray(rt: &ObjcRuntime, objs: Vec<i64>) -> i64 {
    val arr: i64 = objc_class_msg(rt, "NSMutableArray", "arrayWithCapacity:", objc_v1(objs.len()));
    var i: i64 = 0;
    while i < objs.len() {
        objc_msg(rt, arr, "addObject:", objc_v1(objs.get(i)));
        i = i + 1;
    }
    return arr;
}

/// Objects of an NSArray (count, objectAtIndex:).
pub fn objc_nsarray_items(rt: &ObjcRuntime, arr: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val n: i64 = objc_msg(rt, arr, "count", objc_v0());
    var i: i64 = 0;
    while i < n {
        out.push(objc_msg(rt, arr, "objectAtIndex:", objc_v1(i)));
        i = i + 1;
    }
    return out;
}

/// An NSMutableDictionary with string keys and values.
pub fn objc_nsdictionary_strs(rt: &ObjcRuntime, keys: Vec<str>, vals: Vec<str>) -> i64 {
    val d: i64 = objc_class_msg(rt, "NSMutableDictionary", "dictionary", objc_v0());
    var i: i64 = 0;
    while i < keys.len() && i < vals.len() {
        objc_msg(rt, d, "setObject:forKey:", objc_v2(objc_nsstring(rt, vals.get(i)), objc_nsstring(rt, keys.get(i))));
        i = i + 1;
    }
    return d;
}

/// [dict objectForKey:@"key"] as text ("" when absent).
pub fn objc_dict_get_str(rt: &ObjcRuntime, dict: i64, key: str) -> str {
    return objc_str(rt, objc_msg(rt, dict, "objectForKey:", objc_v1(objc_nsstring(rt, key))));
}

/// Set a double (CGFloat, NSTimeInterval) property by key-value coding:
/// the value travels as an NSDecimalNumber made from its text.
pub fn objc_set_double(rt: &ObjcRuntime, obj: i64, key: str, v: f64) {
    val num: i64 = objc_class_msg(rt, "NSDecimalNumber", "decimalNumberWithString:", objc_v1(objc_nsstring(rt, float_to_str(v))));
    objc_msg(rt, obj, "setValue:forKey:", objc_v2(num, objc_nsstring(rt, key)));
}

/// Read a double property by key-value coding (valueForKey: boxes it).
pub fn objc_get_double(rt: &ObjcRuntime, obj: i64, key: str) -> f64 {
    val boxed: i64 = objc_msg(rt, obj, "valueForKey:", objc_v1(objc_nsstring(rt, key)));
    if boxed == 0 { return 0.0; }
    return str_parse_float(objc_str(rt, objc_msg(rt, boxed, "stringValue", objc_v0())));
}

// ─── Delegate classes ──────────────────────────────────────────────────

/// One method a delegate class gets.
pub struct ObjcMethodSpec {
    pub sel: str,
    pub types: str,
}

/// A class to create at run time (a delegate, a target for actions).
pub struct ObjcClassSpec {
    pub name: str,
    pub superclass: str,
    pub protocols: Vec<str>,
    pub methods: Vec<ObjcMethodSpec>,
}

pub fn objc_class_spec(name: str, superclass: str) -> ObjcClassSpec {
    return ObjcClassSpec { name: name, superclass: superclass, protocols: Vec::new(), methods: Vec::new() };
}

pub fn objc_spec_add_method(spec: &mut ObjcClassSpec, sel: str, types: str) {
    spec.methods.push(ObjcMethodSpec { sel: sel, types: types });
}

/// Every problem of a spec ("" lines none): a bad class name, a method
/// whose types do not fit its selector, a selector given twice.
pub fn objc_spec_check(spec: &ObjcClassSpec) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    if !objc_selector_valid(spec.name) || objc_selector_args(spec.name) > 0 { errs.push("bad class name " + spec.name); }
    var i: i64 = 0;
    while i < spec.methods.len() {
        val m: ObjcMethodSpec = spec.methods.get(i);
        val e: str = objc_method_check(m.sel, m.types);
        if str_len(e) > 0 { errs.push(e); }
        var j: i64 = 0;
        while j < i {
            if spec.methods.get(j).sel == m.sel { errs.push("duplicate " + m.sel); }
            j = j + 1;
        }
        i = i + 1;
    }
    return errs;
}

/// Allocate the class pair and add its protocols: the class to give
/// methods (class_addMethod) before objc_class_end; 0 when the spec is
/// invalid, the superclass is missing or the name is taken.
pub fn objc_class_begin(rt: &ObjcRuntime, spec: &ObjcClassSpec) -> i64 {
    if objc_spec_check(spec).len() > 0 { return 0; }
    val gc: fn(str) -> i64 = rt.get_class;
    val alloc: fn(i64, str) -> i64 = rt.allocate_class;
    val gp: fn(str) -> i64 = rt.get_protocol;
    val ap: fn(i64, i64) -> i64 = rt.add_protocol;
    val sup: i64 = gc(spec.superclass);
    if sup == 0 { return 0; }
    val cls: i64 = alloc(sup, spec.name);
    if cls == 0 { return 0; }
    var i: i64 = 0;
    while i < spec.protocols.len() {
        val p: i64 = gp(spec.protocols.get(i));
        if p != 0 { ap(cls, p); }
        i = i + 1;
    }
    return cls;
}

/// Register a class made by objc_class_begin; it can be instantiated now.
pub fn objc_class_end(rt: &ObjcRuntime, cls: i64) {
    val reg: fn(i64) -> void = rt.register_class;
    reg(cls);
}

/// Push and pop an autorelease pool around work (device builds).
pub fn objc_pool_push() -> i64 {
    var r: i64 = 0;
    // SAFETY: no arguments; returns the pool token.
    unsafe { r = objc_c_pool_push(); }
    return r;
}

pub fn objc_pool_pop(pool: i64) {
    // SAFETY: pool is the token of the matching push, popped once.
    unsafe { objc_c_pool_pop(pool); }
}
