// Fides Android NDK bindings and a native-activity event loop
//
// What is real (pure Fides, tested in the interpreter):
//   - the constants of the NDK headers: <android/input.h> (event types,
//     sources, motion actions with the pointer-index bits, key actions,
//     key codes, meta state), <android/looper.h> (poll results, fd events),
//     <android/log.h> priorities, <android/native_window.h> formats,
//     <android/asset_manager.h> open modes, and the APP_CMD_* values of
//     android_native_app_glue
//   - the memory layouts of ANativeActivity, ANativeActivityCallbacks and
//     ANativeWindow_Buffer (64-bit offsets) and readers for them
//   - motion event decoding (action, pointer index) and a multi-touch
//     pointer tracker; key event classification
//   - the app state machine of the glue (start/resume/pause/stop, window,
//     focus) deciding when to draw and how long to block in the looper
//   - an event loop skeleton: poll, read the command or input event,
//     update the state, draw when animating
//   - logcat lines (the "D/tag: msg" form) and splitting of long messages
//     at the logger's payload limit; pixel packing for RGBA_8888, RGBX_8888
//     and RGB_565 window buffers with stride
//
// The platform seam:
//   - the NDK C API is declared in the extern "C" blocks below (libandroid,
//     liblog). On a device these are called directly; the interpreter
//     cannot reach them.
//   - the event loop takes an `NdkLoopSeam` of function values: poll the
//     looper (ALooper_pollOnce), read the next glue command, read the next
//     input event (AInputQueue_getEvent + the AInputEvent accessors, filled
//     into an NdkInput the loop passes by &mut). On a device these wrap the
//     extern calls; tests feed scripted events.
//
// Usage:
//   use android_ndk;
//   var app: NdkApp = ndk_app_new();
//   ndk_run_loop(&mut app, seam, -1);       // until destroy
//   ndk_log(ANDROID_LOG_INFO, "game", "started");

module android_ndk;
use vec;
use string;

// ─── NDK C API ─────────────────────────────────────────────────────────

// SAFETY: prototypes of the NDK headers with pointers as i64 words;
// objects are the handles the NDK returned. Device builds only.
extern "C" link "android" {
    fn ALooper_forThread as ndk_c_looper_for_thread() -> i64;
    fn ALooper_prepare as ndk_c_looper_prepare(opts: i64) -> i64;
    fn ALooper_pollOnce as ndk_c_looper_poll_once(timeout_ms: i64, out_fd: i64, out_events: i64, out_data: i64) -> i64;
    fn ALooper_wake as ndk_c_looper_wake(looper: i64) -> void;
    fn ALooper_addFd as ndk_c_looper_add_fd(looper: i64, fd: i64, ident: i64, events: i64, callback: i64, data: i64) -> i64;
    fn ALooper_removeFd as ndk_c_looper_remove_fd(looper: i64, fd: i64) -> i64;
    fn AInputQueue_attachLooper as ndk_c_queue_attach(queue: i64, looper: i64, ident: i64, callback: i64, data: i64) -> void;
    fn AInputQueue_detachLooper as ndk_c_queue_detach(queue: i64) -> void;
    fn AInputQueue_getEvent as ndk_c_queue_get_event(queue: i64, out_event: i64) -> i64;
    fn AInputQueue_preDispatchEvent as ndk_c_queue_predispatch(queue: i64, event: i64) -> i64;
    fn AInputQueue_finishEvent as ndk_c_queue_finish(queue: i64, event: i64, handled: i64) -> void;
    fn AInputEvent_getType as ndk_c_event_type(event: i64) -> i64;
    fn AInputEvent_getSource as ndk_c_event_source(event: i64) -> i64;
    fn AInputEvent_getDeviceId as ndk_c_event_device(event: i64) -> i64;
    fn AMotionEvent_getAction as ndk_c_motion_action(event: i64) -> i64;
    fn AMotionEvent_getPointerCount as ndk_c_motion_pointer_count(event: i64) -> i64;
    fn AMotionEvent_getPointerId as ndk_c_motion_pointer_id(event: i64, index: i64) -> i64;
    fn AMotionEvent_getX as ndk_c_motion_x(event: i64, index: i64) -> f32;
    fn AMotionEvent_getY as ndk_c_motion_y(event: i64, index: i64) -> f32;
    fn AMotionEvent_getPressure as ndk_c_motion_pressure(event: i64, index: i64) -> f32;
    fn AMotionEvent_getEventTime as ndk_c_motion_time(event: i64) -> i64;
    fn AKeyEvent_getAction as ndk_c_key_action(event: i64) -> i64;
    fn AKeyEvent_getKeyCode as ndk_c_key_code(event: i64) -> i64;
    fn AKeyEvent_getMetaState as ndk_c_key_meta(event: i64) -> i64;
    fn AKeyEvent_getRepeatCount as ndk_c_key_repeat(event: i64) -> i64;
    fn ANativeWindow_acquire as ndk_c_window_acquire(window: i64) -> void;
    fn ANativeWindow_release as ndk_c_window_release(window: i64) -> void;
    fn ANativeWindow_getWidth as ndk_c_window_width(window: i64) -> i64;
    fn ANativeWindow_getHeight as ndk_c_window_height(window: i64) -> i64;
    fn ANativeWindow_getFormat as ndk_c_window_format(window: i64) -> i64;
    fn ANativeWindow_setBuffersGeometry as ndk_c_window_set_geometry(window: i64, w: i64, h: i64, format: i64) -> i64;
    fn ANativeWindow_lock as ndk_c_window_lock(window: i64, out_buffer: i64, in_out_dirty: i64) -> i64;
    fn ANativeWindow_unlockAndPost as ndk_c_window_unlock_and_post(window: i64) -> i64;
    fn AAssetManager_fromJava as ndk_c_asset_manager_from_java(env: i64, jmgr: i64) -> i64;
    fn AAssetManager_open as ndk_c_asset_open(mgr: i64, name: str, mode: i64) -> i64;
    fn AAsset_read as ndk_c_asset_read(asset: i64, buf: i64, count: i64) -> i64;
    fn AAsset_getLength64 as ndk_c_asset_length(asset: i64) -> i64;
    fn AAsset_close as ndk_c_asset_close(asset: i64) -> void;
    fn ANativeActivity_finish as ndk_c_activity_finish(activity: i64) -> void;
    fn ANativeActivity_setWindowFlags as ndk_c_activity_set_window_flags(activity: i64, add: i64, remove: i64) -> void;
}

// SAFETY: __android_log_write(int prio, const char* tag, const char* text);
// the variadic __android_log_print is not used: Fides formats the text.
extern "C" link "log" {
    fn __android_log_write as ndk_c_log_write(prio: i64, tag: str, text: str) -> i64;
}

