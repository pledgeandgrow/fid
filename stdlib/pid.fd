// Fides PID controller (robotics / control)
//
// A discrete PID controller for real loops:
//   - derivative on measurement (no kick when the setpoint steps), through a
//     first-order low-pass filter with time constant tau_d
//     (d <- d + dt / (tau_d + dt) * (raw - d));
//   - the integral kept as the I term itself (ki * sum e dt), so changing ki
//     (gain scheduling) does not bump the output;
//   - anti-windup by clamping: while the output is saturated and the error
//     would drive it further into saturation the integral does not grow,
//     and the I term is always held inside [int_min, int_max];
//   - output limits [out_min, out_max];
//   - a gain schedule: a table of (x, kp, ki, kd) rows interpolated linearly
//     in the scheduling variable x (held at the end rows outside the table).
// `FirstOrderPlant` (K / (T s + 1), discretized exactly for a held input)
// is included to simulate loops.
//
// Names are `pidc_*` (`pid_*` is stdlib/ecu's simpler controller).
// Everything here is pure computation; the seam to hardware is the caller:
// it reads the sensor, calls `pidc_update` with the measured value and the
// elapsed time, and writes the returned output to the actuator.
//
// Usage:
//   use pid;
//   var c = pidc_new(2.0, 1.5, 0.1);
//   pidc_set_output_limits(&mut c, -1.0, 1.0);
//   pidc_set_derivative_filter(&mut c, 0.02);
//   loop { val u = pidc_update(&mut c, setpoint, read_sensor(), dt); write_actuator(u); }

module pid;
use math;

/// PID state and settings.
pub struct PidCtl {
    pub kp: f64,
    pub ki: f64,
    pub kd: f64,
    // derivative filter time constant (0: no filtering)
    pub tau_d: f64,
    pub out_min: f64,
    pub out_max: f64,
    pub int_min: f64,
    pub int_max: f64,
    // clamp the integral while the output is saturated
    pub anti_windup: bool,
    // the I term (ki * integral of the error)
    pub i_term: f64,
    // the filtered derivative of -measurement
    pub d_filt: f64,
    pub prev_meas: f64,
    pub started: bool,
    // the terms of the last update
    pub last_p: f64,
    pub last_i: f64,
    pub last_d: f64,
    pub last_out: f64,
    pub saturated: bool,
}

/// A controller with gains kp, ki, kd, no limits (+-1e300), no derivative
/// filter, anti-windup on.
pub fn pidc_new(kp: f64, ki: f64, kd: f64) -> PidCtl {
    return PidCtl {
        kp: kp, ki: ki, kd: kd, tau_d: 0.0, out_min: - 1.0e300, out_max: 1.0e300, int_min: - 1.0e300, int_max: 1.0e300, anti_windup: true, i_term: 0.0, d_filt: 0.0, prev_meas: 0.0, started: false, last_p: 0.0, last_i: 0.0, last_d: 0.0, last_out: 0.0, saturated: false
    };
}

/// Output limits.
pub fn pidc_set_output_limits(c: & mut PidCtl, lo: f64, hi: f64) {
    c.out_min = lo;
    c.out_max = hi;
}

/// Limits of the I term.
pub fn pidc_set_integral_limits(c: & mut PidCtl, lo: f64, hi: f64) {
    c.int_min = lo;
    c.int_max = hi;
    c.i_term = pidc_clamp(c.i_term, lo, hi);
}

/// Time constant of the derivative low-pass filter (seconds; 0 = none).
pub fn pidc_set_derivative_filter(c: & mut PidCtl, tau: f64) {
    c.tau_d = tau;
}

/// Turn anti-windup (conditional integration) on or off.
pub fn pidc_set_anti_windup(c: & mut PidCtl, on: bool) {
    c.anti_windup = on;
}

/// New gains; the I term is kept, so the output does not jump.
pub fn pidc_set_gains(c: & mut PidCtl, kp: f64, ki: f64, kd: f64) {
    c.kp = kp;
    c.ki = ki;
    c.kd = kd;
}

/// Forget the integral, the derivative and the previous measurement.
pub fn pidc_reset(c: & mut PidCtl) {
    c.i_term = 0.0;
    c.d_filt = 0.0;
    c.prev_meas = 0.0;
    c.started = false;
    c.last_p = 0.0;
    c.last_i = 0.0;
    c.last_d = 0.0;
    c.last_out = 0.0;
    c.saturated = false;
}

fn pidc_clamp(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    return x;
}

/// One control step: the output for `setpoint` given `measurement`, dt
/// seconds after the previous step. dt <= 0 holds the integral and the
/// derivative and returns the proportional action on the old terms.
pub fn pidc_update(c: & mut PidCtl, setpoint: f64, measurement: f64, dt: f64) -> f64 {
    val e: f64 = setpoint - measurement;
    val p: f64 = c.kp * e;
    if !c.started {
        c.prev_meas = measurement;
        c.started = true;
    }
    if dt > 0.0 {
        // derivative of -measurement, low-pass filtered
        val raw: f64 = (c.prev_meas - measurement) / dt;
        if c.tau_d > 0.0 {
            c.d_filt = c.d_filt + dt / (c.tau_d + dt) * (raw - c.d_filt);
        } else {
            c.d_filt = raw;
        }
    }
    c.prev_meas = measurement;
    val d: f64 = c.kd * c.d_filt;
    var i_new: f64 = c.i_term;
    if dt > 0.0 {
        i_new = c.i_term + c.ki * e * dt;
    }
    if c.anti_windup {
        val trial: f64 = p + i_new + d;
        if (trial > c.out_max && e * c.ki > 0.0) || (trial < c.out_min && e * c.ki < 0.0) {
            // saturated and integrating would push further out: hold
            i_new = c.i_term;
        }
    }
    c.i_term = pidc_clamp(i_new, c.int_min, c.int_max);
    val raw_out: f64 = p + c.i_term + d;
    val out: f64 = pidc_clamp(raw_out, c.out_min, c.out_max);
    c.saturated = out != raw_out;
    c.last_p = p;
    c.last_i = c.i_term;
    c.last_d = d;
    c.last_out = out;
    return out;
}

// ─── Gain scheduling ───

/// Gains at one operating point.
pub struct PidGains {
    pub kp: f64,
    pub ki: f64,
    pub kd: f64,
}

/// Rows (x, kp, ki, kd), sorted by x.
pub struct GainSchedule {
    pub xs: Vec<f64>,
    pub kps: Vec<f64>,
    pub kis: Vec<f64>,
    pub kds: Vec<f64>,
}

/// An empty schedule.
pub fn gsched_new() -> GainSchedule {
    return GainSchedule {
        xs: Vec::new(), kps: Vec::new(), kis: Vec::new(), kds: Vec::new()
    };
}

/// Add (or replace) the row at x, keeping the rows sorted.
pub fn gsched_add(s: & mut GainSchedule, x: f64, kp: f64, ki: f64, kd: f64) {
    var i: i64 = 0;
    while i < s.xs.len() && s.xs.get(i) < x {
        i = i + 1;
    }
    if i < s.xs.len() && s.xs.get(i) == x {
        s.kps.set(i, kp);
        s.kis.set(i, ki);
        s.kds.set(i, kd);
        return;
    }
    s.xs.insert(i, x);
    s.kps.insert(i, kp);
    s.kis.insert(i, ki);
    s.kds.insert(i, kd);
}

/// The number of rows.
pub fn gsched_len(s: & GainSchedule) -> i64 {
    return s.xs.len();
}

/// The gains at x: linear between the two rows around x, the first or
/// last row outside the table; zero gains for an empty table.
pub fn gsched_lookup(s: & GainSchedule, x: f64) -> PidGains {
    val n: i64 = s.xs.len();
    if n == 0 {
        return PidGains {
            kp: 0.0, ki: 0.0, kd: 0.0
        };
    }
    if x <= s.xs.get(0) {
        return PidGains {
            kp: s.kps.get(0), ki: s.kis.get(0), kd: s.kds.get(0)
        };
    }
    if x >= s.xs.get(n - 1) {
        return PidGains {
            kp: s.kps.get(n - 1), ki: s.kis.get(n - 1), kd: s.kds.get(n - 1)
        };
    }
    var i: i64 = 1;
    while s.xs.get(i) < x {
        i = i + 1;
    }
    val x0: f64 = s.xs.get(i - 1);
    val x1: f64 = s.xs.get(i);
    val t: f64 = (x - x0) / (x1 - x0);
    return PidGains {
        kp: s.kps.get(i - 1) + (s.kps.get(i) - s.kps.get(i - 1)) * t, ki: s.kis.get(i - 1) + (s.kis.get(i) - s.kis.get(i - 1)) * t, kd: s.kds.get(i - 1) + (s.kds.get(i) - s.kds.get(i - 1)) * t
    };
}

/// Set the controller's gains from the schedule at x (bumpless: the I term
/// is kept).
pub fn pidc_apply_schedule(c: & mut PidCtl, s: & GainSchedule, x: f64) {
    val g: PidGains = gsched_lookup(s, x);
    pidc_set_gains(c, g.kp, g.ki, g.kd);
}

// ─── A first-order plant for simulation ───

/// y' = (gain * u - y) / tau.
pub struct FirstOrderPlant {
    pub gain: f64,
    pub tau: f64,
    pub y: f64,
}

/// A plant at rest at y0.
pub fn fop_new(gain: f64, tau: f64, y0: f64) -> FirstOrderPlant {
    return FirstOrderPlant {
        gain: gain, tau: tau, y: y0
    };
}

/// Advance dt seconds with the input held at u (exact for a held input);
/// returns the new output.
pub fn fop_step(p: & mut FirstOrderPlant, u: f64, dt: f64) -> f64 {
    val a: f64 = 1.0 - math_exp(0.0 - dt / p.tau);
    p.y = p.y + a * (p.gain * u - p.y);
    return p.y;
}
