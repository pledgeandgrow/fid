// Fides calendars: arithmetic on days, beyond the proleptic Gregorian
// calendar of module `time`.
//
//   - a day is counted as days since 1970-01-01 (the "epoch day", what
//     time.fd's seconds / 86400 are), and the Julian Day Number
//     (JDN 2440588 = 1970-01-01, noon-based, as astronomers count);
//   - the proleptic Gregorian calendar to and from epoch days;
//   - the Julian calendar (every fourth year leap, the calendar before
//     1582 in the West and of the Orthodox churches), to and from epoch
//     days and Gregorian dates;
//   - ISO 8601 week dates (year, week 1..53, weekday 1 = Monday .. 7):
//     week 1 holds the year's first Thursday, so January 1 can be in the
//     previous ISO year and December 31 in the next;
//   - ordinal dates (year, day of year 1..366);
//   - the date of Easter: Gregorian (the Anonymous Gregorian algorithm) and
//     Julian (Meeus), the Julian one as a Julian date;
//   - the tabular Islamic calendar, with its four arithmetical leap-year
//     rules and both epochs (civil and astronomical);
//   - the Hebrew calendar: the molad of Tishri, the four postponements,
//     deficient, regular and complete years, Adar I and II.
//
// Usage:
//   use calendar;
//   val w: CalIsoWeek = cal_iso_week(2021, 1, 3);   // 2020-W53-7
//   val j: CalDate = cal_gregorian_to_julian(1917, 11, 7);   // 1917-10-25
//   val e: CalDate = cal_easter(2026);               // 2026-04-05
//   val i: CalDate = cal_gregorian_to_islamic(2026, 2, 18);  // 1447-09-01
//   val h: CalDate = cal_gregorian_to_hebrew(2026, 9, 12);   // 5787-07-01
//
// Every function takes and gives whole numbers; nothing reads a clock. The
// Julian conversions hold for years after 4800 BC (year -4799); the others
// for any year time.fd handles.

module calendar;
use time;

/// A calendar date (which calendar depends on the function that made it).
pub struct CalDate {
    pub year: i64,
    pub month: i64,
    pub day: i64,
}

/// An ISO 8601 week date: ISO year, week 1..53, weekday 1 (Monday) .. 7.
pub struct CalIsoWeek {
    pub year: i64,
    pub week: i64,
    pub weekday: i64,
}

/// The Julian Day Number of 1970-01-01.
pub const CAL_JDN_UNIX_EPOCH: i64 = 2440588;

// a / b rounded toward negative infinity (b > 0).
fn cal_fdiv(a: i64, b: i64) -> i64 {
    var q: i64 = a / b;
    if a % b != 0 && a < 0 {
        q = q - 1;
    }
    return q;
}

// a mod b in 0..b-1 (b > 0).
fn cal_fmod(a: i64, b: i64) -> i64 {
    return a - cal_fdiv(a, b) * b;
}

fn cal_date(y: i64, m: i64, d: i64) -> CalDate {
    return CalDate {
        year: y, month: m, day: d,
    };
}

// ─── Gregorian ───────────────────────────────────────────────────────────

/// Days since 1970-01-01 of a proleptic Gregorian date.
///
/// Example:
///   assert_eq(cal_days_from_civil(1970, 1, 2), 1);
///   assert_eq(cal_date_str(cal_civil_from_days(19723)), "2024-01-01");
///   assert(cal_is_valid(2024, 2, 29));
///   assert(!cal_is_valid(2023, 2, 29));
///   assert_eq(cal_iso_weekday(cal_days_from_civil(2024, 1, 1)), 1);
///   val w = cal_iso_week(2021, 1, 3);
///   assert_eq(w.year, 2020);
///   assert_eq(w.week, 53);
///   assert_eq(cal_iso_weeks_in_year(2020), 53);
///   assert(cal_julian_is_leap(1900));
pub fn cal_days_from_civil(year: i64, month: i64, day: i64) -> i64 {
    // midnight of a day is a whole number of days of seconds
    return cal_fdiv(time_from_date(year, month, day).seconds, 86400);
}

/// The proleptic Gregorian date of an epoch day.
pub fn cal_civil_from_days(days: i64) -> CalDate {
    val t: LogicalTime = time_from_timestamp(days * 86400);
    return cal_date(time_get_year(t), time_get_month(t), time_get_day(t));
}

/// Whether year/month/day is a Gregorian date (month 1..12, the day within
/// the month, February 29 only in a leap year).
pub fn cal_is_valid(year: i64, month: i64, day: i64) -> bool {
    if month < 1 || month > 12 || day < 1 {
        return false;
    }
    return day <= days_in_month(year, month);
}

/// "YYYY-MM-DD" (a year below 0 or above 9999 is written as it is).
pub fn cal_date_str(d: CalDate) -> str {
    return cal_pad(d.year, 4) + "-" + cal_pad(d.month, 2) + "-" + cal_pad(d.day, 2);
}

// n with leading zeros to `width` digits ("-" before a negative number).
fn cal_pad(n: i64, width: i64) -> str {
    if n < 0 {
        return "-" + cal_pad(-n, width);
    }
    var s: str = int_to_str(n);
    while str_len(s) < width {
        s = "0" + s;
    }
    return s;
}

/// The ISO weekday of an epoch day: 1 Monday .. 7 Sunday (1970-01-01 was
/// a Thursday, 4).
pub fn cal_iso_weekday(days: i64) -> i64 {
    return cal_fmod(days + 3, 7) + 1;
}

// ─── Julian Day Number ───────────────────────────────────────────────────

/// The Julian Day Number of an epoch day (the JDN of the noon of that day).
pub fn cal_jdn_from_days(days: i64) -> i64 {
    return days + CAL_JDN_UNIX_EPOCH;
}

/// The epoch day of a Julian Day Number.
pub fn cal_days_from_jdn(jdn: i64) -> i64 {
    return jdn - CAL_JDN_UNIX_EPOCH;
}

/// The Julian Day Number of a Gregorian date (2000-01-01 is 2451545).
pub fn cal_jdn(year: i64, month: i64, day: i64) -> i64 {
    return cal_jdn_from_days(cal_days_from_civil(year, month, day));
}

// ─── Julian calendar ─────────────────────────────────────────────────────

/// Whether a Julian-calendar year is a leap year (every fourth one; year 0
/// is 1 BC, a leap year).
pub fn cal_julian_is_leap(year: i64) -> bool {
    return cal_fmod(year, 4) == 0;
}

/// Days in a month of the Julian calendar.
pub fn cal_julian_days_in_month(year: i64, month: i64) -> i64 {
    if month == 2 {
        if cal_julian_is_leap(year) {
            return 29;
        }
        return 28;
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30;
    }
    return 31;
}

/// The epoch day of a Julian-calendar date (the JDN formula of the Julian
/// calendar, years counted from March so that February ends the year).
pub fn cal_julian_to_days(year: i64, month: i64, day: i64) -> i64 {
    val a: i64 = cal_fdiv(14 - month, 12);
    val y: i64 = year + 4800 - a;
    val m: i64 = month + 12 * a - 3;
    val jdn: i64 = day + cal_fdiv(153 * m + 2, 5) + 365 * y + cal_fdiv(y, 4) - 32083;
    return cal_days_from_jdn(jdn);
}

/// The Julian-calendar date of an epoch day.
pub fn cal_days_to_julian(days: i64) -> CalDate {
    val c: i64 = cal_jdn_from_days(days) + 32082;
    val d: i64 = cal_fdiv(4 * c + 3, 1461);
    val e: i64 = c - cal_fdiv(1461 * d, 4);
    val m: i64 = cal_fdiv(5 * e + 2, 153);
    val day: i64 = e - cal_fdiv(153 * m + 2, 5) + 1;
    val month: i64 = m + 3 - 12 * cal_fdiv(m, 10);
    val year: i64 = d - 4800 + cal_fdiv(m, 10);
    return cal_date(year, month, day);
}

/// The Julian-calendar date of a Gregorian date (1582-10-15 is 1582-10-05
/// Julian; 1917-11-07 is 1917-10-25).
pub fn cal_gregorian_to_julian(year: i64, month: i64, day: i64) -> CalDate {
    return cal_days_to_julian(cal_days_from_civil(year, month, day));
}

/// The Gregorian date of a Julian-calendar date.
pub fn cal_julian_to_gregorian(year: i64, month: i64, day: i64) -> CalDate {
    return cal_civil_from_days(cal_julian_to_days(year, month, day));
}

// ─── ISO 8601 week dates ─────────────────────────────────────────────────

/// The ISO week date of an epoch day: the week's Thursday decides the ISO
/// year, and the week number counts from the week of that year's first
/// Thursday.
pub fn cal_iso_week_of_days(days: i64) -> CalIsoWeek {
    val wd: i64 = cal_iso_weekday(days);
    val thursday: i64 = days - wd + 4;
    val y: i64 = cal_civil_from_days(thursday).year;
    val week: i64 = cal_fdiv(thursday - cal_days_from_civil(y, 1, 1), 7) + 1;
    return CalIsoWeek {
        year: y, week: week, weekday: wd,
    };
}

/// The ISO week date of a Gregorian date.
pub fn cal_iso_week(year: i64, month: i64, day: i64) -> CalIsoWeek {
    return cal_iso_week_of_days(cal_days_from_civil(year, month, day));
}

/// How many ISO weeks a year has: 53 when it starts on a Thursday, or on
/// a Wednesday in a leap year; 52 otherwise.
pub fn cal_iso_weeks_in_year(year: i64) -> i64 {
    val wd: i64 = cal_iso_weekday(cal_days_from_civil(year, 1, 1));
    if wd == 4 || (wd == 3 && is_leap_year(year)) {
        return 53;
    }
    return 52;
}

/// The epoch day of an ISO week date (week 1's Monday is the Monday on or
/// before January 4). The week and weekday are not checked: week 0 or
/// weekday 8 count on from there.
pub fn cal_days_from_iso_week(year: i64, week: i64, weekday: i64) -> i64 {
    val jan4: i64 = cal_days_from_civil(year, 1, 4);
    val monday: i64 = jan4 - (cal_iso_weekday(jan4) - 1);
    return monday + (week - 1) * 7 + (weekday - 1);
}

/// Whether an ISO week date exists (week 1..weeks of the year, weekday
/// 1..7).
pub fn cal_iso_week_is_valid(year: i64, week: i64, weekday: i64) -> bool {
    return week >= 1 && week <= cal_iso_weeks_in_year(year) && weekday >= 1 && weekday <= 7;
}

/// "YYYY-Www-D", the ISO 8601 extended form.
pub fn cal_iso_week_str(w: CalIsoWeek) -> str {
    return cal_pad(w.year, 4) + "-W" + cal_pad(w.week, 2) + "-" + int_to_str(w.weekday);
}

// ─── Ordinal dates ───────────────────────────────────────────────────────

/// The day of the year, 1..366, of a Gregorian date.
pub fn cal_day_of_year(year: i64, month: i64, day: i64) -> i64 {
    return cal_days_from_civil(year, month, day) - cal_days_from_civil(year, 1, 1) + 1;
}

/// The epoch day of day `doy` (1..366) of `year`.
pub fn cal_days_from_ordinal(year: i64, doy: i64) -> i64 {
    return cal_days_from_civil(year, 1, 1) + doy - 1;
}

// ─── Easter ──────────────────────────────────────────────────────────────

/// Western Easter Sunday of a year (Gregorian; the Anonymous Gregorian
/// algorithm, years 1583 and later).
pub fn cal_easter(year: i64) -> CalDate {
    val a: i64 = year % 19;
    val b: i64 = year / 100;
    val c: i64 = year % 100;
    val d: i64 = b / 4;
    val e: i64 = b % 4;
    val f: i64 = (b + 8) / 25;
    val g: i64 = (b - f + 1) / 3;
    val h: i64 = (19 * a + b - d - g + 15) % 30;
    val i: i64 = c / 4;
    val k: i64 = c % 4;
    val l: i64 = cal_fmod(32 + 2 * e + 2 * i - h - k, 7);
    val m: i64 = (a + 11 * h + 22 * l) / 451;
    val n: i64 = h + l - 7 * m + 114;
    return cal_date(year, n / 31, n % 31 + 1);
}

/// Orthodox Easter Sunday as a Julian-calendar date (Meeus' Julian
/// algorithm); cal_julian_to_gregorian gives the civil date.
pub fn cal_julian_easter(year: i64) -> CalDate {
    val a: i64 = year % 4;
    val b: i64 = year % 7;
    val c: i64 = year % 19;
    val d: i64 = (19 * c + 15) % 30;
    val e: i64 = cal_fmod(2 * a + 4 * b - d + 34, 7);
    val n: i64 = d + e + 114;
    return cal_date(year, n / 31, n % 31 + 1);
}

// One field of a "|"-separated list of names (0 is the first; "" past the end).
fn cal_field(list: str, idx: i64) -> str {
    val n: i64 = str_len(list);
    var start: i64 = 0;
    var k: i64 = 0;
    var i: i64 = 0;
    while i <= n {
        if i == n || str_byte_at(list, i) == 124 {
            if k == idx {
                return str_slice(list, start, i);
            }
            k = k + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

// ─── Islamic calendar (tabular) ──────────────────────────────────────────
//
// The arithmetical Islamic calendar: twelve months of 30 and 29 days in
// turn (Muharram 30, Safar 29, ...), Dhu al-Hijjah 29 days, or 30 in the 11
// leap years of each 30-year cycle (10631 days). Which 11 years are leap is
// the rule; a year y is leap when (11 * y + rule) mod 30 < 11:
//
//   CAL_ISLAMIC_I   (15): 2 5 7 10 13 15 18 21 24 26 29  (Kushyar ibn Labban)
//   CAL_ISLAMIC_II  (14): 2 5 7 10 13 16 18 21 24 26 29  (the usual one: the
//                         "Kuwaiti algorithm", ICU's islamic-civil and
//                         islamic-tbla, Python convertdate.islamic)
//   CAL_ISLAMIC_III (11): 2 5 8 10 13 16 19 21 24 27 29  (Fatimid, Bohra)
//   CAL_ISLAMIC_IV   (9): 2 5 8 11 13 16 19 21 24 27 30  (Habash al-Hasib,
//                         al-Biruni)
//
// The epoch is 1 Muharram AH 1: Friday 16 July 622 (Julian) for the civil
// calendar, Thursday 15 July 622 for the astronomical one. Months are 1
// Muharram .. 12 Dhu al-Hijjah. This is the calendar of computation, not
// of observation: the months that begin with a sighted crescent (or Umm
// al-Qura's) can start a day or two from these.

/// Leap-year rules of the tabular Islamic calendar (see above).
pub const CAL_ISLAMIC_I: i64 = 15;
pub const CAL_ISLAMIC_II: i64 = 14;
pub const CAL_ISLAMIC_III: i64 = 11;
pub const CAL_ISLAMIC_IV: i64 = 9;

/// 1 Muharram AH 1 as a Julian Day Number: the civil epoch (Friday 16 July
/// 622, Julian) and the astronomical one (Thursday 15 July).
pub const CAL_ISLAMIC_EPOCH_CIVIL: i64 = 1948440;
pub const CAL_ISLAMIC_EPOCH_ASTRONOMICAL: i64 = 1948439;

/// Whether an Islamic year is leap (Dhu al-Hijjah has 30 days) by `rule`
/// (one of CAL_ISLAMIC_I .. CAL_ISLAMIC_IV).
pub fn cal_islamic_is_leap_rule(year: i64, rule: i64) -> bool {
    return cal_fmod(11 * year + rule, 30) < 11;
}

/// Whether an Islamic year is leap by the usual rule (CAL_ISLAMIC_II).
pub fn cal_islamic_is_leap(year: i64) -> bool {
    return cal_islamic_is_leap_rule(year, CAL_ISLAMIC_II);
}

/// Days in a month of the tabular Islamic calendar by `rule`.
pub fn cal_islamic_days_in_month_rule(year: i64, month: i64, rule: i64) -> i64 {
    if month == 12 && cal_islamic_is_leap_rule(year, rule) {
        return 30;
    }
    if cal_fmod(month, 2) == 1 {
        return 30;
    }
    return 29;
}

/// Days in a month of the tabular Islamic calendar (CAL_ISLAMIC_II).
pub fn cal_islamic_days_in_month(year: i64, month: i64) -> i64 {
    return cal_islamic_days_in_month_rule(year, month, CAL_ISLAMIC_II);
}

/// Whether year/month/day is a date of the tabular Islamic calendar by
/// `rule` (month 1..12, Dhu al-Hijjah 30 only in a leap year).
pub fn cal_islamic_is_valid_rule(year: i64, month: i64, day: i64, rule: i64) -> bool {
    if month < 1 || month > 12 || day < 1 {
        return false;
    }
    return day <= cal_islamic_days_in_month_rule(year, month, rule);
}

/// Whether year/month/day is a date of the tabular Islamic calendar
/// (CAL_ISLAMIC_II).
pub fn cal_islamic_is_valid(year: i64, month: i64, day: i64) -> bool {
    return cal_islamic_is_valid_rule(year, month, day, CAL_ISLAMIC_II);
}

// Days from 1 Muharram AH 1 to 1 Muharram of `year`: 354 a year and one
// for each leap year before it; the leap years among 1..n are
// floor((11 n + rule) / 30) of them.
fn cal_islamic_year_start(year: i64, rule: i64) -> i64 {
    return 354 * (year - 1) + cal_fdiv(11 * (year - 1) + cal_fmod(rule, 30), 30);
}

// Days from 1 Muharram to the first of `month` (30 and 29 in turn).
fn cal_islamic_month_start(month: i64) -> i64 {
    return 29 * (month - 1) + cal_fdiv(month, 2);
}

/// The epoch day of a tabular Islamic date by `rule` and `epoch` (a JDN:
/// CAL_ISLAMIC_EPOCH_CIVIL or CAL_ISLAMIC_EPOCH_ASTRONOMICAL). The date is
/// not checked: day 31 counts on into the next month.
pub fn cal_islamic_to_days_rule(year: i64, month: i64, day: i64, rule: i64, epoch: i64) -> i64 {
    return cal_days_from_jdn(epoch) + cal_islamic_year_start(year, rule) + cal_islamic_month_start(month) + day - 1;
}

/// The tabular Islamic date of an epoch day by `rule` and `epoch`. Years
/// before AH 1 count down through 0 (1 BH) and below.
pub fn cal_days_to_islamic_rule(days: i64, rule: i64, epoch: i64) -> CalDate {
    val off: i64 = days - cal_days_from_jdn(epoch);
    val cycle: i64 = cal_fdiv(off, 10631);
    val r: i64 = off - cycle * 10631;
    var y: i64 = 1;
    while y < 30 && cal_islamic_year_start(y + 1, rule) <= r {
        y = y + 1;
    }
    val r2: i64 = r - cal_islamic_year_start(y, rule);
    var m: i64 = 1;
    while m < 12 && cal_islamic_month_start(m + 1) <= r2 {
        m = m + 1;
    }
    return cal_date(30 * cycle + y, m, r2 - cal_islamic_month_start(m) + 1);
}

/// The epoch day of a civil tabular Islamic date (CAL_ISLAMIC_II, the
/// Friday epoch).
pub fn cal_islamic_to_days(year: i64, month: i64, day: i64) -> i64 {
    return cal_islamic_to_days_rule(year, month, day, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL);
}

/// The civil tabular Islamic date of an epoch day (CAL_ISLAMIC_II, the
/// Friday epoch).
pub fn cal_days_to_islamic(days: i64) -> CalDate {
    return cal_days_to_islamic_rule(days, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL);
}

/// The civil tabular Islamic date of a Gregorian date (2026-02-18 is
/// 1447-09-01, 1 Ramadan 1447).
pub fn cal_gregorian_to_islamic(year: i64, month: i64, day: i64) -> CalDate {
    return cal_days_to_islamic(cal_days_from_civil(year, month, day));
}

/// The Gregorian date of a civil tabular Islamic date.
pub fn cal_islamic_to_gregorian(year: i64, month: i64, day: i64) -> CalDate {
    return cal_civil_from_days(cal_islamic_to_days(year, month, day));
}

/// The English name of an Islamic month 1..12, as CLDR spells it
/// ("Muharram", "Rabiʻ I", "Dhuʻl-Hijjah"); "" for any other number.
pub fn cal_islamic_month_name(month: i64) -> str {
    if month < 1 || month > 12 {
        return "";
    }
    return cal_field("Muharram|Safar|Rabiʻ I|Rabiʻ II|Jumada I|Jumada II|Rajab|Shaʻban|Ramadan|Shawwal|Dhuʻl-Qiʻdah|Dhuʻl-Hijjah", month - 1);
}

// ─── Hebrew calendar ─────────────────────────────────────────────────────
//
// The fixed Hebrew calendar (Hillel II): 12 months, or 13 in years 3, 6,
// 8, 11, 14, 17 and 19 of each 19-year cycle; the year starts on 1 Tishri,
// the day of the molad (mean new moon) of Tishri unless one of the four
// postponements (dehiyyot) moves it:
//   - molad zaken: a molad at or after noon (18 hours after 6 p.m.) moves
//     the new year to the next day;
//   - lo ADU rosh: never a Sunday, Wednesday or Friday (one day later);
//   - GaTaRaD: in a common year, a Tuesday molad at or after 9 h 204 p
//     moves it to Thursday (the year would otherwise have 356 days);
//   - BeTUTaKPaT: after a leap year, a Monday molad at or after 15 h 589 p
//     moves it to Tuesday (the year before would otherwise have 382).
// A month is 29 d 12 h 793 p (a part, "heleq", is 1/1080 hour), and the
// molad of Tishri AM 1 is BaHaRaD: Monday 5 h 204 p (counted from 6 p.m.
// Sunday). Heshvan and Kislev take the year to 353..355 days (383..385 in
// a leap year).
//
// Months are numbered as in the Torah and in Reingold and Dershowitz
// ("Calendrical Calculations"), Python convertdate.hebrew: 1 Nisan,
// 2 Iyar, 3 Sivan, 4 Tamuz, 5 Av, 6 Elul, 7 Tishri (the year begins),
// 8 Heshvan, 9 Kislev, 10 Tevet, 11 Shevat, 12 Adar (Adar I in a leap
// year), 13 Adar II (leap years only).

/// 1 Tishri AM 1 as a Julian Day Number (Monday 7 October 3761 BC, Julian).
pub const CAL_HEBREW_EPOCH_JDN: i64 = 347998;

/// Parts (halakim) in a day, and in a mean month (29 d 12 h 793 p).
pub const CAL_HEBREW_DAY_PARTS: i64 = 25920;
pub const CAL_HEBREW_MONTH_PARTS: i64 = 765433;

/// Whether a Hebrew year has 13 months (years 3 6 8 11 14 17 19 of the
/// 19-year cycle).
pub fn cal_hebrew_is_leap(year: i64) -> bool {
    return cal_fmod(7 * year + 1, 19) < 7;
}

/// Months in a Hebrew year: 12, or 13 in a leap year.
pub fn cal_hebrew_months_in_year(year: i64) -> i64 {
    if cal_hebrew_is_leap(year) {
        return 13;
    }
    return 12;
}

// Months from the molad of Tishri AM 1 to the molad of Tishri of `year`.
fn cal_hebrew_months_before(year: i64) -> i64 {
    return cal_fdiv(235 * year - 234, 19);
}

/// The molad of Tishri of a Hebrew year as (day, parts): `day` is the
/// epoch day of the Hebrew day the molad falls in, a day that began at
/// 6 p.m. of the civil day before; `parts` is the time since that 6 p.m.
/// in parts (1080 an hour, 25920 a day). Parts below 6480 (6 hours) are the
/// evening of the civil day `day - 1`; from 6480 on, `parts - 6480` after
/// midnight of `day`. (Jerusalem mean time, as the calendar counts it.)
pub fn cal_hebrew_molad(year: i64) -> (i64, i64) {
    val p: i64 = CAL_HEBREW_DAY_PARTS + 5 * 1080 + 204 + cal_hebrew_months_before(year) * CAL_HEBREW_MONTH_PARTS;
    // day 0 of this count is the Sunday before AM 1, epoch day -2092591
    return (cal_fdiv(p, CAL_HEBREW_DAY_PARTS) - 2092591, cal_fmod(p, CAL_HEBREW_DAY_PARTS));
}

/// The epoch day of 1 Tishri (Rosh Hashanah) of a Hebrew year: the day of
/// its molad, moved by the four postponements.
pub fn cal_hebrew_new_year(year: i64) -> i64 {
    var(mday, mparts) = cal_hebrew_molad(year);
    var day: i64 = mday;
    // weekday 0 Sunday .. 6 Saturday (epoch day 0 was a Thursday)
    val wd: i64 = cal_fmod(mday + 4, 7);
    if mparts >= 18 * 1080 {
        day = day + 1;
    } else if wd == 2 && mparts >= 9 * 1080 + 204 && !cal_hebrew_is_leap(year) {
        day = day + 2;
    } else if wd == 1 && mparts >= 15 * 1080 + 589 && cal_hebrew_is_leap(year - 1) {
        day = day + 1;
    }
    val wd2: i64 = cal_fmod(day + 4, 7);
    if wd2 == 0 || wd2 == 3 || wd2 == 5 {
        day = day + 1;
    }
    return day;
}

/// Days in a Hebrew year: 353, 354 or 355 (deficient, regular, complete),
/// or 383, 384 or 385 in a leap year.
pub fn cal_hebrew_year_length(year: i64) -> i64 {
    return cal_hebrew_new_year(year + 1) - cal_hebrew_new_year(year);
}

// Days in `month` of a year that is `leap` and `ylen` days long.
fn cal_hebrew_month_len(month: i64, leap: bool, ylen: i64) -> i64 {
    if month == 2 || month == 4 || month == 6 || month == 10 || month == 13 {
        return 29;
    }
    if month == 12 && !leap {
        return 29;
    }
    if month == 8 && ylen % 10 != 5 {
        return 29;
    }
    if month == 9 && ylen % 10 == 3 {
        return 29;
    }
    return 30;
}

/// Days in a month of a Hebrew year (0 for a month the year does not
/// have).
pub fn cal_hebrew_days_in_month(year: i64, month: i64) -> i64 {
    if month < 1 || month > cal_hebrew_months_in_year(year) {
        return 0;
    }
    return cal_hebrew_month_len(month, cal_hebrew_is_leap(year), cal_hebrew_year_length(year));
}

/// Whether year/month/day is a Hebrew date (month 13 only in a leap year,
/// the day within the month).
pub fn cal_hebrew_is_valid(year: i64, month: i64, day: i64) -> bool {
    return day >= 1 && day <= cal_hebrew_days_in_month(year, month);
}

/// The epoch day of a Hebrew date. The day is not checked (day 31 counts
/// on); a month the year does not have gives the day after its last month.
pub fn cal_hebrew_to_days(year: i64, month: i64, day: i64) -> i64 {
    val leap: bool = cal_hebrew_is_leap(year);
    val last: i64 = cal_hebrew_months_in_year(year);
    val ny: i64 = cal_hebrew_new_year(year);
    val ylen: i64 = cal_hebrew_new_year(year + 1) - ny;
    var z: i64 = ny;
    var m: i64 = 7;
    var steps: i64 = 0;
    // the months of the year in order: Tishri .. the last Adar, Nisan .. Elul
    while m != month && steps < last {
        z = z + cal_hebrew_month_len(m, leap, ylen);
        if m == last {
            m = 1;
        } else {
            m = m + 1;
        }
        steps = steps + 1;
    }
    return z + day - 1;
}

/// The Hebrew date of an epoch day.
pub fn cal_days_to_hebrew(days: i64) -> CalDate {
    // the mean year is 35975351 / 98496 days: this is the year or the one
    // before
    var y: i64 = cal_fdiv((cal_jdn_from_days(days) - CAL_HEBREW_EPOCH_JDN) * 98496, 35975351);
    while cal_hebrew_new_year(y) > days {
        y = y - 1;
    }
    while cal_hebrew_new_year(y + 1) <= days {
        y = y + 1;
    }
    val leap: bool = cal_hebrew_is_leap(y);
    val last: i64 = cal_hebrew_months_in_year(y);
    val ny: i64 = cal_hebrew_new_year(y);
    val ylen: i64 = cal_hebrew_new_year(y + 1) - ny;
    var z: i64 = ny;
    var m: i64 = 7;
    var len: i64 = cal_hebrew_month_len(m, leap, ylen);
    while days >= z + len {
        z = z + len;
        if m == last {
            m = 1;
        } else {
            m = m + 1;
        }
        len = cal_hebrew_month_len(m, leap, ylen);
    }
    return cal_date(y, m, days - z + 1);
}

/// The Hebrew date of a Gregorian date (2026-09-12 is 5787-07-01, Rosh
/// Hashanah 5787).
pub fn cal_gregorian_to_hebrew(year: i64, month: i64, day: i64) -> CalDate {
    return cal_days_to_hebrew(cal_days_from_civil(year, month, day));
}

/// The Gregorian date of a Hebrew date.
pub fn cal_hebrew_to_gregorian(year: i64, month: i64, day: i64) -> CalDate {
    return cal_civil_from_days(cal_hebrew_to_days(year, month, day));
}

/// The English name of a month of a Hebrew year, as CLDR spells it:
/// "Nisan" .. "Elul", "Tishri" .. "Shevat", then "Adar" in a common year
/// and "Adar I", "Adar II" in a leap year; "" for a month the year does not
/// have.
pub fn cal_hebrew_month_name(year: i64, month: i64) -> str {
    if month < 1 || month > cal_hebrew_months_in_year(year) {
        return "";
    }
    if month == 12 && cal_hebrew_is_leap(year) {
        return "Adar I";
    }
    return cal_field("Nisan|Iyar|Sivan|Tamuz|Av|Elul|Tishri|Heshvan|Kislev|Tevet|Shevat|Adar|Adar II", month - 1);
}
