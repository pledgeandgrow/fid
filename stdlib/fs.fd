// Fides Filesystem standard library
//
// File and directory operations: read, write, list, walk, glob, temp files.
// Implemented over the p_file_*/p_dir_* runtime builtins, so every function
// works identically on the interpreter, C codegen and the PE backend.
//
// Usage:
//   use fs;
//   fs_write_text("hello.txt", "Hello, World!");
//   val content = fs_read_text("hello.txt");
//   println(content);  // "Hello, World!"

module fs;
use vec;
use trace;
use world;
// Under a test's fake file system (stdlib/world.fd, complaint CT1) the
// read/write/exists/size/delete functions, the directory functions
// (list, is_dir, mkdir, mkdir_all, rmdir, rmdir_all, rename, walk, glob,
// temp files) and the File handles below use the fake instead.
// ─── File existence / info ──────────────────────────────────────────────

/// Check if a file exists.
pub fn fs_exists(path: str) -> bool {
    if world_files_faked() {
        return world_file_exists(path) || (str_len(path) > 0 && world_dir_exists(path));
    }
    return p_file_exists(path) != 0;
}

/// Get file size in bytes. Returns -1 if file doesn't exist.
pub fn fs_file_size(path: str) -> i64 {
    if world_files_faked() {
        if !world_file_exists(path) {
            return -1;
        }
        return str_len(world_file_text(path));
    }
    return p_file_size(path);
}

// ─── Read ───────────────────────────────────────────────────────────────

/// Read a file as text. Returns "" if file doesn't exist.
pub fn fs_read_text(path: str) -> str {
    // CO2: a "file.read" span under FIDES_TRACE (the path)
    val t0: i64 = trace_span_begin();
    if world_files_faked() {
        match world_fs_read(path) {
            Option::Some(fc) => {
                trace_span_end(t0, "file.read", path, true);
                return fc;
            }
            Option::None => {
            }
        }
        trace_span_end(t0, "file.read", path, false);
        return "";
    }
    match read_file(path) {
        Option::Some(content) => {
            trace_span_end(t0, "file.read", path, true);
            return content;
        }
        Option::None => {
        }
    }
    trace_span_end(t0, "file.read", path, false);
    return "";
}

/// Read a file as a Vec of bytes. Returns empty Vec if file doesn't exist.
pub fn fs_read_bytes(path: str) -> Vec<i64> {
    val t0: i64 = trace_span_begin();
    if world_files_faked() {
        match world_fs_read(path) {
            Option::Some(fc) => {
                trace_span_end(t0, "file.read", path, true);
                return str_bytes(fc);
            }
            Option::None => {
            }
        }
        trace_span_end(t0, "file.read", path, false);
        return Vec::new();
    }
    val bytes: Vec<i64> = p_file_read_bytes(path);
    trace_span_end(t0, "file.read", path, bytes.len() > 0 || fs_exists(path));
    return bytes;
}

/// Read a file as lines. Returns empty Vec if file doesn't exist.
pub fn fs_read_lines(path: str) -> Vec<str> {
    var content = fs_read_text(path);
    if str_len(content) == 0 {
        return Vec::new();
    }
    return str_split(content, "\n");
}

// ─── Write ──────────────────────────────────────────────────────────────

/// Write text to a file. Overwrites if exists. Returns true on success.
///
/// Example:
///   val p = "fid_doctest_fs.tmp";
///   assert(fs_write_text(p, "a\nb"));
///   assert(fs_exists(p));
///   assert(fs_is_file(p));
///   assert_eq(fs_read_lines(p).len(), 2);
///   assert(fs_append_text(p, "\nc"));
///   assert_eq(fs_read_text(p), "a\nb\nc");
///   assert_eq(fs_file_size(p), 5);
///   assert(fs_delete(p));
///   assert(!fs_exists(p));
pub fn fs_write_text(path: str, content: str) -> bool {
    val t0: i64 = trace_span_begin();
    if world_files_faked() {
        trace_span_end(t0, "file.write", path, true);
        return world_fs_write(path, content);
    }
    val ok: bool = p_file_write(path, content) == 0;
    trace_span_end(t0, "file.write", path, ok);
    return ok;
}

/// Write bytes to a file. Overwrites if exists. Returns true on success.
pub fn fs_write_bytes(path: str, bytes: Vec<i64>) -> bool {
    val t0: i64 = trace_span_begin();
    if world_files_faked() {
        trace_span_end(t0, "file.write", path, true);
        return world_fs_write(path, str_from_bytes(bytes));
    }
    val ok: bool = p_file_write_vec(path, bytes) == 0;
    trace_span_end(t0, "file.write", path, ok);
    return ok;
}

/// Append text to a file. Creates if doesn't exist. Returns true on success.
pub fn fs_append_text(path: str, content: str) -> bool {
    val t0: i64 = trace_span_begin();
    if world_files_faked() {
        trace_span_end(t0, "file.append", path, true);
        return world_fs_append(path, content);
    }
    val ok: bool = p_file_append(path, content) == 0;
    trace_span_end(t0, "file.append", path, ok);
    return ok;
}

// ─── Copy (competitive roadmap RT14) ────────────────────────────────────

/// Copy the file `src` to `dst` (created, or emptied first): the number of
/// bytes copied, or -1 when `src` cannot be read or `dst` written. A file
/// copied onto itself is left as it is.
///
/// Zero-copy where the system allows it: the kernel moves the bytes
/// without passing them through the program -- copy_file_range, then
/// sendfile, on Linux (C builds and native builds), fcopyfile on macOS and
/// CopyFileA on Windows (C builds). Where it cannot (`fid run`, the Windows
/// native runtime, a file system without those calls) the bytes are read
/// and written instead, with the same result.
pub fn fs_copy_file(src: str, dst: str) -> i64 {
    val t0: i64 = trace_span_begin();
    if world_files_faked() {
        match world_fs_read(src) {
            Option::Some(fc) => {
                val ok: bool = world_fs_write(dst, fc);
                trace_span_end(t0, "file.copy", src, ok);
                if ok {
                    return str_len(fc);
                }
                return -1;
            }
            Option::None => {
            }
        }
        trace_span_end(t0, "file.copy", src, false);
        return -1;
    }
    val n: i64 = p_fs_copy_file(src, dst);
    trace_span_end(t0, "file.copy", src, n >= 0);
    return n;
}

/// fs_copy_file's portable body: what `fid run` and a back end without a
/// runtime version run (read every byte, write them). The C back end runs
/// its runtime's __p_zc_copy_file instead (compiler/codegen_c.fd
/// fast_zero_copy_body) and native Linux pert_fs_copy_file
/// (stdlib/linux_runtime/sys.fd).
pub fn p_fs_copy_file(src: str, dst: str) -> i64 {
    if p_file_size(src) < 0 {
        return -1;
    }
    if src == dst {
        return p_file_size(src);
    }
    val bytes: Vec<i64> = p_file_read_bytes(src);
    if p_file_write_vec(dst, bytes) != 0 {
        return -1;
    }
    return bytes.len();
}

// ─── Delete / Rename ────────────────────────────────────────────────────

/// Delete a file. Returns true on success.
pub fn fs_delete(path: str) -> bool {
    if world_files_faked() {
        return world_file_remove(path);
    }
    return p_file_delete(path) == 0;
}

/// Rename/move a file. Returns true on success.
pub fn fs_rename(old_path: str, new_path: str) -> bool {
    if world_files_faked() {
        return world_fs_rename(old_path, new_path);
    }
    return p_rename(old_path, new_path) == 0;
}

// ─── Directory listing ──────────────────────────────────────────────────

/// List entries in a directory (names only, no "." or "..").
/// Returns empty Vec if directory doesn't exist or can't be opened.
/// (Under a fake file system the names are sorted.)
pub fn fs_list_dir(path: str) -> Vec<str> {
    if world_files_faked() {
        return world_dir_list(path);
    }
    var listing: str = p_dir_list(path);
    if str_len(listing) == 0 {
        return Vec::new();
    }
    return str_split(listing, "\n");
}

/// Check if a path is a directory.
pub fn fs_is_dir(path: str) -> bool {
    if world_files_faked() {
        return str_len(path) > 0 && world_dir_exists(path);
    }
    return p_is_dir(path) != 0;
}

/// Check if a path is a file (not a directory).
pub fn fs_is_file(path: str) -> bool {
    return fs_exists(path) && !fs_is_dir(path);
}

// ─── Directory creation / removal ───────────────────────────────────────

/// Create a single directory. Returns true on success (false if it already
/// exists or the parent is missing — use fs_mkdir_all for the recursive
/// form).
pub fn fs_mkdir(path: str) -> bool {
    if world_files_faked() {
        return world_fs_mkdir(path);
    }
    return p_mkdir(path) == 0;
}

/// Create a directory and all missing parents ("mkdir -p").
/// Returns true if the directory exists afterwards.
pub fn fs_mkdir_all(path: str) -> bool {
    if str_len(path) == 0 {
        return false;
    }
    if world_files_faked() {
        return world_fs_mkdir_all(path);
    }
    if fs_is_dir(path) {
        return true;
    }
    // Create each leading component in turn.
    var parts: Vec<str> = str_split(path, "/");
    var cur: str = "";
    var i: i64 = 0;
    // Absolute path: keep a leading "/".
    if str_byte_at(path, 0) == 47 {
        cur = "/";
    }
    while i < parts.len() {
        var seg: str = parts.get(i);
        if str_len(seg) > 0 {
            if str_len(cur) > 0 && str_byte_at(cur, str_len(cur) - 1) != 47 {
                cur = cur + "/";
            }
            cur = cur + seg;
            if !fs_is_dir(cur) {
                if p_mkdir(cur) != 0 && !fs_is_dir(cur) {
                    return false;
                }
            }
        }
        i = i + 1;
    }
    return fs_is_dir(path);
}

/// Remove an empty directory. Returns true on success.
pub fn fs_rmdir(path: str) -> bool {
    if world_files_faked() {
        return world_fs_rmdir(path);
    }
    return p_rmdir(path) == 0;
}

/// Remove a directory and everything inside it ("rm -rf").
/// Returns true when the path no longer exists afterwards.
pub fn fs_rmdir_all(path: str) -> bool {
    if !fs_is_dir(path) {
        // A plain file: just delete it.
        if fs_exists(path) {
            return fs_delete(path);
        }
        return true;
    }
    var entries: Vec<str> = fs_list_dir(path);
    var i: i64 = 0;
    while i < entries.len() {
        var name: str = entries.get(i);
        var child: str = fs_join(path, name);
        if fs_is_dir(child) {
            fs_rmdir_all(child);
        } else {
            fs_delete(child);
        }
        i = i + 1;
    }
    fs_rmdir(path);
    return !fs_is_dir(path);
}

// ─── Recursive walk ─────────────────────────────────────────────────────

/// Append every file/dir path under `dir` (recursively) to `out`.
/// Entries are reported as `dir/name`; `dir` itself is not included.
fn fs_walk_into(dir: str, out: &mut Vec<str>) -> void {
    var entries: Vec<str> = fs_list_dir(dir);
    var i: i64 = 0;
    while i < entries.len() {
        var name: str = entries.get(i);
        var child: str = fs_join(dir, name);
        out.push(child);
        if fs_is_dir(child) {
            fs_walk_into(child, out);
        }
        i = i + 1;
    }
}

/// Recursively list every file and directory under `dir` (depth-first,
/// full paths relative to `dir` as given). Empty Vec when `dir` is not a
/// readable directory.
pub fn fs_walk(dir: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if !fs_is_dir(dir) {
        return out;
    }
    fs_walk_into(dir, &mut out);
    return out;
}

/// Like fs_walk but reports only files, not directories.
pub fn fs_walk_files(dir: str) -> Vec<str> {
    var all: Vec<str> = fs_walk(dir);
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < all.len() {
        var p: str = all.get(i);
        if fs_is_file(p) {
            out.push(p);
        }
        i = i + 1;
    }
    return out;
}

// ─── Glob matching ──────────────────────────────────────────────────────
// `*` and `?` match within a path segment; `**` as a whole segment matches
// any number of segments (including zero).

/// Does `name` match a single-segment glob pattern (`*`, `?`)?
/// This is the same wildcard matcher as regex_match.
pub fn fs_glob_match(name: str, pattern: str) -> bool {
    return p_regex_match(name, pattern) != 0;
}

fn fs_glob_recurse(dir: str, pat: Vec<str>, pi: i64, prefix: str, out: &mut Vec<str>) -> void {
    if pi >= pat.len() {
        // Pattern consumed: `prefix` itself is a match when it exists.
        if fs_exists(prefix) || fs_is_dir(prefix) {
            out.push(prefix);
        }
        return;
    }
    var seg: str = pat.get(pi);
    if str_equal(seg, "**") {
        // Zero segments: match rest at this level.
        fs_glob_recurse(dir, pat, pi + 1, prefix, out);
        // Or descend into every subdirectory (keeping "**" for depth).
        var entries: Vec<str> = fs_list_dir(dir);
        var i: i64 = 0;
        while i < entries.len() {
            var name: str = entries.get(i);
            var child: str = fs_join(dir, name);
            if fs_is_dir(child) {
                fs_glob_recurse(child, pat, pi, child, out);
            }
            i = i + 1;
        }
        return;
    }
    var entries: Vec<str> = fs_list_dir(dir);
    var i: i64 = 0;
    while i < entries.len() {
        var name: str = entries.get(i);
        if fs_glob_match(name, seg) {
            var child: str = fs_join(dir, name);
            fs_glob_recurse(child, pat, pi + 1, child, out);
        }
        i = i + 1;
    }
}

/// Match `pattern` against the directory tree under `dir`.
/// Returns matching paths as `dir`-relative full paths.
///   fs_glob("src", "*.fd")        — direct children ending in .fd
///   fs_glob("src", "**/*.fd")     — .fd files at any depth
///   fs_glob("src", "a/?/b.txt")   — single-char middle component
pub fn fs_glob(dir: str, pattern: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if !fs_is_dir(dir) {
        return out;
    }
    var pat: Vec<str> = str_split(pattern, "/");
    fs_glob_recurse(dir, pat, 0, "", &mut out);
    return out;
}

// ─── Temporary files ────────────────────────────────────────────────────

/// A collision-resistant temp name: prefix + pid + tick + nanos.
fn fs_temp_name(prefix: str, ext: str) -> str {
    return prefix + int_to_str(p_getpid()) + "_" + int_to_str(fs_temp_tick()) + ext;
}

/// The tick a temp name carries: the clock in microseconds (under a test's
/// fake clock, stdlib/world, its reading, not counted as the code's read).
fn fs_temp_tick() -> i64 {
    if world_clock_faked() {
        return world_clock_peek() * 1000;
    }
    return p_clock_now_us();
}

/// Return a fresh temp-file path in `dir` (created on first write).
/// The path does not exist yet — nothing is created.
pub fn fs_temp_path(dir: str, prefix: str) -> str {
    return fs_join(dir, fs_temp_name(prefix + "_", ".tmp"));
}

/// Create an empty temp file in `dir` and return its path, or "" on
/// failure. `prefix` becomes the first characters of the file name.
pub fn fs_temp_file(dir: str, prefix: str) -> str {
    var tries: i64 = 0;
    while tries < 64 {
        var path: str = fs_temp_path_salt(dir, prefix, tries);
        if !fs_exists(path) {
            if fs_write_text(path, "") {
                return path;
            }
            return "";
        }
        tries = tries + 1;
    }
    return "";
}

/// Create a temp directory in `dir` and return its path, or "" on failure.
pub fn fs_temp_dir(dir: str, prefix: str) -> str {
    var tries: i64 = 0;
    while tries < 64 {
        var path: str = fs_temp_path_salt(dir, prefix, tries);
        if !fs_exists(path) && !fs_is_dir(path) {
            if fs_mkdir(path) {
                return path;
            }
            return "";
        }
        tries = tries + 1;
    }
    return "";
}

// The clock may not tick between retries — `salt` keeps names unique.
fn fs_temp_path_salt(dir: str, prefix: str, salt: i64) -> str {
    return fs_join(dir, prefix + "_" + int_to_str(p_getpid()) + "_" + int_to_str(fs_temp_tick() + salt) + ".tmp");
}

// ─── Path helpers ───────────────────────────────────────────────────────

/// Join two path components (handles "/", also treats "\" as separator on
/// the right-hand side for Windows callers).
pub fn fs_join(a: str, b: str) -> str {
    if str_len(a) == 0 {
        return b;
    }
    if str_len(b) == 0 {
        return a;
    }
    var last: i64 = str_byte_at(a, str_len(a) - 1);
    var first: i64 = str_byte_at(b, 0);
    var a_ends = last == 47 || last == 92;
    var b_starts = first == 47 || first == 92;
    if a_ends && b_starts {
        return a + str_slice(b, 1, str_len(b));
    }
    if !a_ends && !b_starts {
        return (a + "/") + b;
    }
    return a + b;
}

/// The last path component (after '/' or '\'); "" for a trailing sep.
pub fn fs_basename(path: str) -> str {
    var n: i64 = str_len(path);
    var i: i64 = n - 1;
    while i >= 0 {
        var c: i64 = str_byte_at(path, i);
        if c == 47 || c == 92 {
            return str_slice(path, i + 1, n);
        }
        i = i - 1;
    }
    return path;
}

/// Everything before the last '/' or '\'; "" when there is none.
pub fn fs_dirname(path: str) -> str {
    var i: i64 = str_len(path) - 1;
    while i >= 0 {
        var c: i64 = str_byte_at(path, i);
        if c == 47 || c == 92 {
            return str_slice(path, 0, i);
        }
        i = i - 1;
    }
    return "";
}

/// The extension including the dot ("a.tar.gz" -> ".gz"); "" when none.
pub fn fs_ext(path: str) -> str {
    var base: str = fs_basename(path);
    var i: i64 = str_len(base) - 1;
    while i >= 0 {
        var c: i64 = str_byte_at(base, i);
        if c == 46 {
            return str_slice(base, i, str_len(base));
        }
        if c == 47 || c == 92 {
            return "";
        }
        i = i - 1;
    }
    return "";
}

/// Path without its final extension.
pub fn fs_stem(path: str) -> str {
    var e: str = fs_ext(path);
    return str_slice(path, 0, str_len(path) - str_len(e));
}

/// Get the full path of a file in a directory.
pub fn fs_path_in(dir: str, filename: str) -> str {
    return fs_join(dir, filename);
}

// ─── Compatibility aliases for file.fd ───────────────────────────────────
// These allow code written for file.fd's API to work with `use fs;`.

/// Alias for file_read — read file contents as a string.
pub fn file_read(path: str) -> str {
    return fs_read_text(path);
}

/// Alias for file_write — write string to a file. Returns 0 on success, -1 on error.
pub fn file_write(path: str, content: str) -> i64 {
    if fs_write_text(path, content) {
        return 0;
    }
    return -1;
}

/// Alias for file_append — append string to a file. Returns 0 on success, -1 on error.
pub fn file_append(path: str, content: str) -> i64 {
    if fs_append_text(path, content) {
        return 0;
    }
    return -1;
}

/// Alias for file_exists — check if a file exists.
pub fn file_exists(path: str) -> bool {
    return fs_exists(path);
}

/// Alias for file_delete — delete a file. Returns 0 on success, -1 on error.
pub fn file_delete(path: str) -> i64 {
    if fs_delete(path) {
        return 0;
    }
    return -1;
}

/// Alias for file_size — get file size in bytes, or -1 if it doesn't exist.
pub fn file_size(path: str) -> i64 {
    return fs_file_size(path);
}

// ─── File handles (open / read / write / close) ─────────────────────────
//
// A `File` is opened once and then read or written in pieces:
//
//   match File::create("out.bin") {
//       Option::Some(f) => {
//           var w: File = f;
//           w.write_str("header\n");
//           w.write(bytes);
//           w.close();
//       }
//       Option::None => { println("cannot create"); }
//   }
//
// Writes are buffered: the pending bytes go to disk when they reach
// FILE_BUF_LIMIT, on flush() and on close(), so a long stream of writes
// keeps at most FILE_BUF_LIMIT bytes in memory; they are appended with
// p_file_append_vec, zero bytes included. Reads stream: a read handle
// holds a window of at most FILE_READ_CHUNK bytes of the file, read with
// p_file_read_at when a read, a line or a byte goes past it, so reading a
// large file keeps one window in memory, whatever its size. Everything runs
// on the p_file_* builtins, so `fid run`, `ccompile` and `emit` behave the
// same. (Under a test's fake file system, stdlib/world.fd, a read handle
// holds the fake file's whole text.)

/// Pending write bytes kept before a File writes them out.
pub const FILE_BUF_LIMIT: i64 = 65536;
/// Bytes a read handle reads from the file at a time.
pub const FILE_READ_CHUNK: i64 = 65536;
/// File modes.
pub const FILE_CLOSED: i64 = 0;
pub const FILE_READ: i64 = 1;
pub const FILE_WRITE: i64 = 2;

/// An open file: a read handle (`File::open`) or a write handle
/// (`File::create`, `File::append`).
pub struct File {
    pub path: str,
    pub mode: i64,
    data: Vec<i64>,  // read: the window (file bytes from buf_at); write: bytes not yet written
    pos: i64,  // read position (an offset in the file)
    written: i64,  // write: bytes handed to write() so far
    failed: bool,  // a write to disk failed
    limit: i64,  // write: pending bytes kept before a write-out
    buf_at: i64,  // read: the file offset of data's first byte
    fsize: i64,  // read: the file's size when it was opened
    whole: bool,  // read: data is the whole file (a fake one)
}

/// The bytes of v from `from` (inclusive) to `to` (exclusive).
fn file_slice(v: &Vec<i64>, from: i64, to: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = from;
    while i < to {
        out.push(v.get(i));
        i = i + 1;
    }
    return out;
}

/// Up to n bytes of the file from byte `at` (none past its end). The
/// runtime's Vec is taken as a raw word and freed here: a builtin's Vec
/// result is not a temporary the caller owns.
fn file_read_chunk(path: str, at: i64, n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val raw: i64 = p_file_read_at(path, at, n) as i64;
    if raw == 0 {
        return out;
    }
    val len: i64 = Vec_len(raw);
    var i: i64 = 0;
    while i < len {
        out.push(Vec_get(raw, i) & 255);
        i = i + 1;
    }
    Vec_drop(raw);
    return out;
}

/// Write `pending` after what `path` already holds (zero bytes included).
fn file_put(path: str, pending: &Vec<i64>) -> bool {
    if world_files_faked() {
        // the fake file system holds text: a NUL byte ends the file
        return world_fs_append(path, str_from_bytes(file_slice(pending, 0, pending.len())));
    }
    return p_file_append_vec(path, file_slice(pending, 0, pending.len())) == 0;
}

/// A fake file's bytes, under a test's fake file system (stdlib/world,
/// complaint CT1).
fn file_load(path: str) -> Vec<i64> {
    match world_fs_read(path) {
        Option::Some(fc) => {
            return str_bytes(fc);
        }
        Option::None => {
        }
    }
    var none: Vec<i64> = Vec::new();
    return none;
}

/// Create (truncate) or, with `at_end`, open-for-append the file a write
/// handle writes: true when it can be written (the fake's under a test).
fn file_start(path: str, at_end: bool) -> bool {
    if world_files_faked() {
        if at_end {
            return world_fs_append(path, "");
        }
        return world_fs_write(path, "");
    }
    if at_end {
        return p_file_append(path, "") == 0;
    }
    return p_file_write(path, "") == 0;
}

impl File {
    /// Open an existing file for reading. None if it does not exist or
    /// is a directory. Nothing is read yet.
    pub fn open(path: str) -> Option<File> {
        if !fs_exists(path) || fs_is_dir(path) {
            return Option::None;
        }
        if world_files_faked() {
            val bytes: Vec<i64> = file_load(path);
            val n: i64 = bytes.len();
            return Option::Some(File {
                path: path, mode: FILE_READ, data: bytes, pos: 0, written: 0, failed: false, limit: FILE_BUF_LIMIT, buf_at: 0, fsize: n, whole: true
            });
        }
        return Option::Some(File {
            path: path, mode: FILE_READ, data: Vec::new(), pos: 0, written: 0, failed: false, limit: FILE_BUF_LIMIT, buf_at: 0, fsize: p_file_size(path), whole: false
        });
    }

    /// Create (or truncate) a file for writing. None if it cannot be
    /// created.
    pub fn create(path: str) -> Option<File> {
        if !file_start(path, false) {
            return Option::None;
        }
        return Option::Some(File {
            path: path, mode: FILE_WRITE, data: Vec::new(), pos: 0, written: 0, failed: false, limit: FILE_BUF_LIMIT, buf_at: 0, fsize: 0, whole: false
        });
    }

    /// Open a file for writing at its end, creating it if missing.
    pub fn append(path: str) -> Option<File> {
        if !file_start(path, true) {
            return Option::None;
        }
        return Option::Some(File {
            path: path, mode: FILE_WRITE, data: Vec::new(), pos: 0, written: 0, failed: false, limit: FILE_BUF_LIMIT, buf_at: 0, fsize: 0, whole: false
        });
    }

    /// True while the handle is open.
    pub fn is_open(self: &File) -> bool {
        return self.mode != FILE_CLOSED;
    }

    /// Keep at most `n` pending write bytes (at least 1) before writing
    /// them out; the default is FILE_BUF_LIMIT.
    pub fn set_buffer_limit(self: &mut File, n: i64) -> void {
        var m: i64 = n;
        if m < 1 {
            m = 1;
        }
        self.limit = m;
    }

    /// Pending write bytes not yet on disk.
    pub fn pending(self: &File) -> i64 {
        if self.mode == FILE_WRITE {
            return self.data.len();
        }
        return 0;
    }

    // ─── Reading ────────────────────────────────────────────────────────

    /// The window holds file byte `at`, read from the file when it did
    /// not: false past the end of the file.
    fn fill(self: &mut File, at: i64) -> bool {
        if at >= self.buf_at && at < self.buf_at + self.data.len() {
            return true;
        }
        if self.whole || at < 0 {
            return false;
        }
        // CO2: each read from disk is a "file.read" span under FIDES_TRACE
        val t0: i64 = trace_span_begin();
        self.data = file_read_chunk(self.path, at, FILE_READ_CHUNK);
        trace_span_end(t0, "file.read", self.path, true);
        self.buf_at = at;
        return self.data.len() > 0;
    }

    /// Up to `n` bytes from the current position; empty at the end of the
    /// file (or on a write handle).
    pub fn read(self: &mut File, n: i64) -> Vec<i64> {
        var out: Vec<i64> = Vec::new();
        if self.mode != FILE_READ || n <= 0 {
            return out;
        }
        while out.len() < n && self.fill(self.pos) {
            var i: i64 = self.pos - self.buf_at;
            while i < self.data.len() && out.len() < n {
                out.push(self.data.get(i));
                i = i + 1;
            }
            self.pos = self.buf_at + i;
        }
        return out;
    }

    /// Up to `n` bytes as text.
    pub fn read_str(self: &mut File, n: i64) -> str {
        return str_from_bytes(self.read(n));
    }

    /// The next byte (0..255), or -1 at the end of the file.
    pub fn read_byte(self: &mut File) -> i64 {
        if self.mode != FILE_READ || !self.fill(self.pos) {
            return -1;
        }
        val b: i64 = self.data.get(self.pos - self.buf_at) & 255;
        self.pos = self.pos + 1;
        return b;
    }

    /// The next line without its newline (and a carriage return before
    /// it); None at the end of the file.
    pub fn read_line(self: &mut File) -> Option<str> {
        if self.mode != FILE_READ || !self.fill(self.pos) {
            return Option::None;
        }
        var line: Vec<i64> = Vec::new();
        var nl: bool = false;
        while !nl && self.fill(self.pos) {
            var i: i64 = self.pos - self.buf_at;
            while i < self.data.len() && !nl {
                val b: i64 = self.data.get(i);
                if b == 10 {
                    nl = true;
                } else {
                    line.push(b);
                }
                i = i + 1;
            }
            self.pos = self.buf_at + i;
        }
        var stop: i64 = line.len();
        if stop > 0 && line.get(stop - 1) == 13 {
            stop = stop - 1;
        }
        return Option::Some(str_from_bytes(file_slice(&line, 0, stop)));
    }

    /// Everything from the current position to the end.
    pub fn read_to_end(self: &mut File) -> Vec<i64> {
        var out: Vec<i64> = Vec::new();
        if self.mode != FILE_READ {
            return out;
        }
        var piece: Vec<i64> = self.read(FILE_READ_CHUNK);
        while piece.len() > 0 {
            var i: i64 = 0;
            while i < piece.len() {
                out.push(piece.get(i));
                i = i + 1;
            }
            piece = self.read(FILE_READ_CHUNK);
        }
        return out;
    }

    /// True when a read handle has nothing left to read (by the size the
    /// file had when it was opened).
    pub fn at_eof(self: &File) -> bool {
        return self.mode != FILE_READ || self.pos >= self.fsize;
    }

    /// The read position; on a write handle, the bytes written so far.
    pub fn tell(self: &File) -> i64 {
        if self.mode == FILE_WRITE {
            return self.written;
        }
        return self.pos;
    }

    /// Move the read position to `offset` (clamped to 0..size). False on a
    /// write or closed handle. Nothing is read until the next read.
    pub fn seek(self: &mut File, offset: i64) -> bool {
        if self.mode != FILE_READ {
            return false;
        }
        var p: i64 = offset;
        if p < 0 {
            p = 0;
        }
        if p > self.fsize {
            p = self.fsize;
        }
        self.pos = p;
        return true;
    }

    /// The size of a read handle's file (when it was opened); on a write
    /// handle, the bytes written so far.
    pub fn size(self: &File) -> i64 {
        if self.mode == FILE_READ {
            return self.fsize;
        }
        return self.written;
    }

    // ─── Writing ────────────────────────────────────────────────────────

    /// Write bytes (each 0..255). False on a read or closed handle, or once
    /// a write to disk has failed.
    pub fn write(self: &mut File, bytes: Vec<i64>) -> bool {
        if self.mode != FILE_WRITE || self.failed {
            return false;
        }
        var i: i64 = 0;
        while i < bytes.len() {
            self.data.push(bytes.get(i) & 255);
            i = i + 1;
        }
        self.written = self.written + bytes.len();
        if self.data.len() >= self.limit {
            return self.flush();
        }
        return true;
    }

    /// Write the bytes of a string.
    pub fn write_str(self: &mut File, s: str) -> bool {
        return self.write(str_bytes(s));
    }

    /// Write a string and a newline.
    pub fn write_line(self: &mut File, s: str) -> bool {
        return self.write(str_bytes(s + "\n"));
    }

    /// Write the pending bytes to disk.
    pub fn flush(self: &mut File) -> bool {
        if self.mode != FILE_WRITE {
            return self.mode == FILE_READ;
        }
        if self.failed {
            return false;
        }
        if self.data.len() == 0 {
            return true;
        }
        // CO2: each write-out is a "file.write" span under FIDES_TRACE
        val t0: i64 = trace_span_begin();
        val put: bool = file_put(self.path, &self.data);
        trace_span_end(t0, "file.write", self.path, put);
        if !put {
            self.failed = true;
            return false;
        }
        self.data.clear();
        return true;
    }

    /// Flush and close. True when every write reached the file. A closed
    /// handle reads and writes nothing.
    pub fn close(self: &mut File) -> bool {
        var ok: bool = true;
        if self.mode == FILE_WRITE {
            ok = self.flush();
        }
        self.mode = FILE_CLOSED;
        self.data.clear();
        self.pos = 0;
        self.buf_at = 0;
        self.fsize = 0;
        return ok;
    }
}

/// The time `path` was last written, in ms since 1970 (UTC); -1 when it
/// does not exist. (A fake file under stdlib/world: 0.)
pub fn fs_modified_ms(path: str) -> i64 {
    if world_files_faked() {
        if world_file_exists(path) {
            return 0;
        }
        return -1;
    }
    return p_file_mtime_ms(path);
}

// ─── Mapped reads (competitive roadmap RT14) ────────────────────────────
//
// A FileView reads a file without copying it into the program: its pages
// are mapped read-only (mmap on Linux and macOS, MapViewOfFile on Windows:
// C builds; mmap on native Linux), and byte() and slice() read them in
// place. Where nothing can be mapped (`fid run`, the Windows native
// runtime, an empty file, the fake file system) the file's bytes are read
// once instead, with the same results.
//
//   match FileView::open("data.bin") {
//       Option::Some(v) => {
//           var view: FileView = v;
//           println(view.slice(0, 4));
//           view.close();
//       }
//       Option::None => { println("cannot read"); }
//   }

/// A file opened for reading in place (`FileView::open`).
pub struct FileView {
    pub path: str,
    pub len: i64,
    addr: i64,  // where the file is mapped; 0 when its bytes are in `data`
    data: Vec<i64>,  // the file's bytes when it is not mapped
}

/// Map `size` bytes of the file `path` read-only: the address, or 0 when
/// it cannot be mapped (then FileView reads it). This portable body maps
/// nothing; the C back end runs its runtime's __p_zc_map instead
/// (compiler/codegen_c.fd fast_zero_copy_body) and native Linux
/// pert_fs_map (stdlib/linux_runtime/sys.fd). It makes a call, so that the
/// IR inliner keeps the call for the native runtime to take over.
pub fn p_fs_map(path: str, size: i64) -> i64 {
    if size <= 0 || p_file_size(path) != size {
        return 0;
    }
    return 0;
}

/// Undo p_fs_map: 0, or -1. Nothing is mapped by the portable body, so
/// reaching it with a mapping is a bug.
pub fn p_fs_unmap(addr: i64, _size: i64) -> i64 {
    if addr != 0 {
        p_panic("p_fs_unmap: nothing is mapped on this back end");
    }
    return 0 - 1;
}

impl FileView {
    /// Open the file `path` for reading in place: None when it does not
    /// exist, is a folder or cannot be read.
    pub fn open(path: str) -> Option<FileView> {
        if world_files_faked() {
            match world_fs_read(path) {
                Option::Some(fc) => {
                    return Option::Some(FileView {
                        path: path, len: str_len(fc), addr: 0, data: str_bytes(fc)
                    });
                }
                Option::None => {
                }
            }
            return Option::None;
        }
        if !fs_exists(path) || fs_is_dir(path) {
            return Option::None;
        }
        val t0: i64 = trace_span_begin();
        val size: i64 = p_file_size(path);
        if size > 0 {
            val a: i64 = p_fs_map(path, size);
            if a != 0 {
                trace_span_end(t0, "file.map", path, true);
                return Option::Some(FileView {
                    path: path, len: size, addr: a, data: Vec::new()
                });
            }
        }
        // every byte, NULs included (a text read would stop at the first)
        val bytes: Vec<i64> = p_file_read_bytes(path);
        val ok: bool = bytes.len() > 0 || size == 0;
        trace_span_end(t0, "file.read", path, ok);
        if !ok {
            return Option::None;
        }
        return Option::Some(FileView {
            path: path, len: bytes.len(), addr: 0, data: bytes
        });
    }

    /// Whether the file's pages are mapped (false: it was read instead).
    pub fn is_mapped(self: &FileView) -> bool {
        return self.addr != 0;
    }

    /// The byte at `i` (0..255), or -1 outside the file.
    pub fn byte(self: &FileView, i: i64) -> i64 {
        if i < 0 || i >= self.len {
            return -1;
        }
        if self.addr == 0 {
            return self.data.get(i) & 255;
        }
        var p: *mut u8 = self.addr + i;
        var b: i64 = 0;
        // SAFETY: 0 <= i < len: a byte of the len bytes mapped at addr,
        // which stay mapped until close() (that sets addr to 0 and len to 0).
        unsafe {
            b = (*p) as i64;
        }
        return b & 255;
    }

    /// The bytes from `from` (inclusive) to `to` (exclusive) as a string,
    /// both clamped to the file.
    pub fn slice(self: &FileView, from: i64, to: i64) -> str {
        var a: i64 = from;
        var b: i64 = to;
        if a < 0 {
            a = 0;
        }
        if b > self.len {
            b = self.len;
        }
        if b <= a {
            return "";
        }
        if self.addr == 0 {
            return str_from_bytes(file_slice(&self.data, a, b));
        }
        val n: i64 = b - a;
        val r: i64 = p_str_buf(n);
        p_str_copy_n(r, self.addr + a, n);
        return p_str_adopt(r);
    }

    /// The whole file as a string.
    pub fn to_str(self: &FileView) -> str {
        return self.slice(0, self.len);
    }

    /// Unmap the file (or drop its bytes). A closed view reads nothing.
    pub fn close(self: &mut FileView) -> void {
        if self.addr != 0 {
            p_fs_unmap(self.addr, self.len);
            self.addr = 0;
        }
        self.len = 0;
        self.data = Vec::new();
    }
}
