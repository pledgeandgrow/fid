// Fides runtime permissions model for Android and iOS
//
// What is real (pure Fides, tested in the interpreter):
//   - the permissions (camera, fine / coarse / background location,
//     microphone, notifications, bluetooth, photos) and their status
//     values, with the platform status codes mapped onto them:
//     PackageManager results, AVAuthorizationStatus, CLAuthorizationStatus
//     plus CLAccuracyAuthorization, PHAuthorizationStatus,
//     UNAuthorizationStatus, CBManagerAuthorization
//   - platform names: the Android manifest permission strings per API
//     level (POST_NOTIFICATIONS from 33, BLUETOOTH_SCAN/CONNECT from 31,
//     READ_MEDIA_IMAGES from 33, ACCESS_BACKGROUND_LOCATION from 29) and
//     which are runtime (dangerous) permissions; the iOS Info.plist usage
//     description keys
//   - the request flow with a rationale: check, show rationale, request,
//     open settings, done; Android's "don't ask again" (no rationale after
//     a denial, or a second denial on API 30+) and iOS's one-shot prompt;
//     background location only after foreground location is granted
//   - manifest <uses-permission> lines (with maxSdkVersion for legacy
//     permissions) and Info.plist entries, with a check that every iOS
//     permission used has its usage description
//
// The platform seam: nothing here calls the OS. The calls a platform
// layer makes are given as data (`perm_android_call`: class, method and
// JNI signature for jni.fd; `perm_ios_call`: class and selector for
// objc.fd); their results come back through perm_flow_result.
//
// Usage:
//   use permissions;
//   var f: PermFlow = perm_flow_new(PERM_CAMERA, PERM_ANDROID, 34);
//   val step = perm_flow_next(&f, should_show_rationale);
//   ... show rationale / request ...
//   perm_flow_result(&mut f, granted, rationale_now);

module permissions;
use vec;
use string;

// Permissions
pub const PERM_CAMERA: i64 = 0;
pub const PERM_LOCATION_FINE: i64 = 1;
pub const PERM_LOCATION_COARSE: i64 = 2;
pub const PERM_LOCATION_BACKGROUND: i64 = 3;
pub const PERM_MICROPHONE: i64 = 4;
pub const PERM_NOTIFICATIONS: i64 = 5;
pub const PERM_BLUETOOTH: i64 = 6;
pub const PERM_PHOTOS: i64 = 7;
pub const PERM_COUNT: i64 = 8;

// Status
pub const PERM_NOT_DETERMINED: i64 = 0;
pub const PERM_GRANTED: i64 = 1;
pub const PERM_DENIED: i64 = 2;  // may be asked again
pub const PERM_PERMANENTLY_DENIED: i64 = 3;  // only the settings app can change it
pub const PERM_RESTRICTED: i64 = 4;  // parental controls / MDM
pub const PERM_LIMITED: i64 = 5;  // approximate location, selected photos
pub const PERM_PROVISIONAL: i64 = 6;  // iOS quiet notifications

pub const PERM_ANDROID: i64 = 0;
pub const PERM_IOS: i64 = 1;

pub fn perm_name(p: i64) -> str {
    val n: Vec<str> = str_split("camera,location-fine,location-coarse,location-background,microphone,notifications,bluetooth,photos", ",");
    if p < 0 || p >= n.len() {
        return "?";
    }
    return n.get(p);
}

pub fn perm_status_name(s: i64) -> str {
    val n: Vec<str> = str_split("not-determined,granted,denied,permanently-denied,restricted,limited,provisional", ",");
    if s < 0 || s >= n.len() {
        return "?";
    }
    return n.get(s);
}

/// May the app use the feature (granted, limited or provisional)?
pub fn perm_usable(status: i64) -> bool {
    return status == PERM_GRANTED || status == PERM_LIMITED || status == PERM_PROVISIONAL;
}

// ─── Android names ─────────────────────────────────────────────────────

/// The manifest permissions to declare and request for `p` on API level
/// `api` (the names the request dialog takes).
pub fn perm_android_names(p: i64, api: i64) -> Vec<str> {
    var v: Vec<str> = Vec::new();
    val pre: str = "android.permission.";
    if p == PERM_CAMERA {
        v.push(pre + "CAMERA");
    } else if p == PERM_LOCATION_FINE {
        v.push(pre + "ACCESS_FINE_LOCATION");
        v.push(pre + "ACCESS_COARSE_LOCATION");
    } else if p == PERM_LOCATION_COARSE {
        v.push(pre + "ACCESS_COARSE_LOCATION");
    } else if p == PERM_LOCATION_BACKGROUND {
        if api >= 29 {
            v.push(pre + "ACCESS_BACKGROUND_LOCATION");
        }
    } else if p == PERM_MICROPHONE {
        v.push(pre + "RECORD_AUDIO");
    } else if p == PERM_NOTIFICATIONS {
        if api >= 33 {
            v.push(pre + "POST_NOTIFICATIONS");
        }
    } else if p == PERM_BLUETOOTH {
        if api >= 31 {
            v.push(pre + "BLUETOOTH_SCAN");
            v.push(pre + "BLUETOOTH_CONNECT");
        } else {
            v.push(pre + "ACCESS_FINE_LOCATION");
        }
    } else if p == PERM_PHOTOS {
        if api >= 33 {
            v.push(pre + "READ_MEDIA_IMAGES");
            v.push(pre + "READ_MEDIA_VIDEO");
        } else {
            v.push(pre + "READ_EXTERNAL_STORAGE");
        }
        if api >= 34 {
            v.push(pre + "READ_MEDIA_VISUAL_USER_SELECTED");
        }
    }
    return v;
}

/// Is `p` asked for at run time on API `api` (a "dangerous" permission)?
/// Below API 23 everything is granted at install; notifications need no
/// request below 33; background location is part of the location
/// request below 29.
pub fn perm_android_is_runtime(p: i64, api: i64) -> bool {
    if api < 23 {
        return false;
    }
    return perm_android_names(p, api).len() > 0;
}

/// <uses-permission> lines for the manifest: every permission the set
/// needs on any API from `min_api` up, legacy ones capped with
/// android:maxSdkVersion.
pub fn perm_android_manifest(perms: Vec<i64>, min_api: i64) -> str {
    var names: Vec<str> = Vec::new();
    var caps: Vec<i64> = Vec::new();  // maxSdkVersion, 0 = none
    var i: i64 = 0;
    while i < perms.len() {
        val p: i64 = perms.get(i);
        val now: Vec<str> = perm_android_names(p, 1000);
        var j: i64 = 0;
        while j < now.len() {
            perm_add_name(&mut names, &mut caps, now.get(j), 0);
            j = j + 1;
        }
        if p == PERM_BLUETOOTH && min_api < 31 {
            perm_add_name(&mut names, &mut caps, "android.permission.BLUETOOTH", 30);
            perm_add_name(&mut names, &mut caps, "android.permission.BLUETOOTH_ADMIN", 30);
            perm_add_name(&mut names, &mut caps, "android.permission.ACCESS_FINE_LOCATION", 30);
        }
        if p == PERM_PHOTOS && min_api < 33 {
            perm_add_name(&mut names, &mut caps, "android.permission.READ_EXTERNAL_STORAGE", 32);
        }
        i = i + 1;
    }
    var out: str = "";
    i = 0;
    while i < names.len() {
        out = out + "<uses-permission android:name=\"" + names.get(i) + "\"";
        if caps.get(i) > 0 {
            out = out + " android:maxSdkVersion=\"" + int_to_str(caps.get(i)) + "\"";
        }
        out = out + " />\n";
        i = i + 1;
    }
    return out;
}

// Add a name once; an uncapped use wins over a capped one.
fn perm_add_name(names: &mut Vec<str>, caps: &mut Vec<i64>, n: str, cap: i64) {
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == n {
            if cap == 0 || caps.get(i) == 0 {
                caps.set(i, 0);
            } else if cap > caps.get(i) {
                caps.set(i, cap);
            }
            return;
        }
        i = i + 1;
    }
    names.push(n);
    caps.push(cap);
}

/// The status from Android results: `granted` per requested name
/// (PackageManager.PERMISSION_GRANTED is 0, DENIED -1) for the names of
/// perm_android_names. Fine location with only coarse granted is LIMITED;
/// photos with only the user-selected subset is LIMITED.
pub fn perm_android_status(p: i64, api: i64, results: Vec<i64>, rationale: bool, denials: i64) -> i64 {
    val names: Vec<str> = perm_android_names(p, api);
    if names.len() == 0 {
        return PERM_GRANTED;
    }
    var all: bool = true;
    var any: bool = false;
    var i: i64 = 0;
    while i < names.len() && i < results.len() {
        if results.get(i) == 0 {
            any = true;
        } else {
            all = false;
        }
        i = i + 1;
    }
    if results.len() < names.len() {
        all = false;
    }
    // photos: the images permission decides; video may be refused alone
    if p == PERM_PHOTOS && results.len() > 0 && results.get(0) == 0 {
        return PERM_GRANTED;
    }
    if all {
        return PERM_GRANTED;
    }
    if p == PERM_LOCATION_FINE && results.len() >= 2 && results.get(1) == 0 {
        return PERM_LIMITED;
    }
    if p == PERM_PHOTOS && api >= 34 && results.len() >= 3 && results.get(2) == 0 {
        return PERM_LIMITED;
    }
    if any {
        return PERM_DENIED;
    }
    if denials == 0 {
        return PERM_NOT_DETERMINED;
    }
    // no rationale after a denial means "don't ask again"; from API 30 a
    // second denial is permanent too
    if !rationale || (api >= 30 && denials >= 2) {
        return PERM_PERMANENTLY_DENIED;
    }
    return PERM_DENIED;
}

// ─── iOS names and statuses ────────────────────────────────────────────

/// The Info.plist usage description key of `p` ("" when none is needed:
/// notifications). Fine and coarse location share the when-in-use key.
pub fn perm_ios_plist_key(p: i64) -> str {
    if p == PERM_CAMERA {
        return "NSCameraUsageDescription";
    }
    if p == PERM_LOCATION_FINE || p == PERM_LOCATION_COARSE {
        return "NSLocationWhenInUseUsageDescription";
    }
    if p == PERM_LOCATION_BACKGROUND {
        return "NSLocationAlwaysAndWhenInUseUsageDescription";
    }
    if p == PERM_MICROPHONE {
        return "NSMicrophoneUsageDescription";
    }
    if p == PERM_BLUETOOTH {
        return "NSBluetoothAlwaysUsageDescription";
    }
    if p == PERM_PHOTOS {
        return "NSPhotoLibraryUsageDescription";
    }
    return "";
}

/// AVAuthorizationStatus (camera, microphone) -> status.
pub fn perm_ios_av_status(code: i64) -> i64 {
    if code == 0 {
        return PERM_NOT_DETERMINED;
    }
    if code == 1 {
        return PERM_RESTRICTED;
    }
    if code == 2 {
        return PERM_PERMANENTLY_DENIED;
    }
    if code == 3 {
        return PERM_GRANTED;
    }
    return PERM_NOT_DETERMINED;
}

/// CLAuthorizationStatus + CLAccuracyAuthorization (0 full, 1 reduced)
/// -> the status of permission `p` (a location permission).
pub fn perm_ios_location_status(p: i64, code: i64, accuracy: i64) -> i64 {
    if code == 0 {
        return PERM_NOT_DETERMINED;
    }
    if code == 1 {
        return PERM_RESTRICTED;
    }
    if code == 2 {
        return PERM_PERMANENTLY_DENIED;
    }
    // 3 authorizedAlways, 4 authorizedWhenInUse
    if p == PERM_LOCATION_BACKGROUND {
        if code == 3 {
            return PERM_GRANTED;
        }
        return PERM_NOT_DETERMINED;  // can still be upgraded once
    }
    if p == PERM_LOCATION_FINE && accuracy == 1 {
        return PERM_LIMITED;
    }
    return PERM_GRANTED;
}

/// PHAuthorizationStatus -> status (4 limited).
pub fn perm_ios_photos_status(code: i64) -> i64 {
    if code == 4 {
        return PERM_LIMITED;
    }
    return perm_ios_av_status(code);
}

/// UNAuthorizationStatus -> status (3 provisional, 4 ephemeral).
pub fn perm_ios_notification_status(code: i64) -> i64 {
    if code == 0 {
        return PERM_NOT_DETERMINED;
    }
    if code == 1 {
        return PERM_PERMANENTLY_DENIED;
    }
    if code == 2 {
        return PERM_GRANTED;
    }
    if code == 3 {
        return PERM_PROVISIONAL;
    }
    if code == 4 {
        return PERM_GRANTED;
    }
    return PERM_NOT_DETERMINED;
}

/// CBManagerAuthorization -> status.
pub fn perm_ios_bluetooth_status(code: i64) -> i64 {
    return perm_ios_av_status(code);
}

/// Info.plist <key>/<string> entries for the permissions, each with its
/// description; `missing` lists the keys without a description.
pub struct PlistEntries {
    pub xml: str,
    pub missing: Vec<str>,
}

pub fn perm_ios_plist(perms: Vec<i64>, descriptions: Vec<str>) -> PlistEntries {
    var keys: Vec<str> = Vec::new();
    var xml: str = "";
    var missing: Vec<str> = Vec::new();
    var bg: bool = false;
    var i: i64 = 0;
    while i < perms.len() {
        val k: str = perm_ios_plist_key(perms.get(i));
        if perms.get(i) == PERM_LOCATION_BACKGROUND {
            bg = true;
        }
        if str_len(k) > 0 && !perm_has_str(&keys, k) {
            keys.push(k);
            val d: str = if i < descriptions.len() {
                str_trim(descriptions.get(i))
            } else {
                ""
            };
            if str_len(d) == 0 {
                missing.push(k);
            } else {
                xml = xml + "<key>" + k + "</key>\n<string>" + perm_xml_escape(d) + "</string>\n";
            }
        }
        i = i + 1;
    }
    // "always" location also requires the when-in-use description
    if bg && !perm_has_str(&keys, "NSLocationWhenInUseUsageDescription") {
        missing.push("NSLocationWhenInUseUsageDescription");
    }
    return PlistEntries {
        xml: xml, missing: missing
    };
}

fn perm_has_str(v: &Vec<str>, s: str) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == s {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn perm_xml_escape(s: str) -> str {
    return str_replace(str_replace(str_replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;");
}

// ─── Platform calls (as data for jni.fd / objc.fd) ─────────────────────

pub struct PermCall {
    pub cls: str,
    pub method: str,
    pub sig: str,  // JNI signature (Android) or the method types (iOS)
}

/// The JNI calls of the Android flow: "check", "rationale", "request".
pub fn perm_android_call(what: str) -> PermCall {
    if what == "check" {
        return PermCall {
            cls: "androidx/core/content/ContextCompat", method: "checkSelfPermission", sig: "(Landroid/content/Context;Ljava/lang/String;)I"
        };
    }
    if what == "rationale" {
        return PermCall {
            cls: "androidx/core/app/ActivityCompat", method: "shouldShowRequestPermissionRationale", sig: "(Landroid/app/Activity;Ljava/lang/String;)Z"
        };
    }
    return PermCall {
        cls: "androidx/core/app/ActivityCompat", method: "requestPermissions", sig: "(Landroid/app/Activity;[Ljava/lang/String;I)V"
    };
}

/// The Objective-C request of `p` on iOS: receiver class and selector.
pub fn perm_ios_call(p: i64) -> PermCall {
    if p == PERM_CAMERA || p == PERM_MICROPHONE {
        return PermCall {
            cls: "AVCaptureDevice", method: "requestAccessForMediaType:completionHandler:", sig: "v@:@@?"
        };
    }
    if p == PERM_LOCATION_FINE || p == PERM_LOCATION_COARSE {
        return PermCall {
            cls: "CLLocationManager", method: "requestWhenInUseAuthorization", sig: "v@:"
        };
    }
    if p == PERM_LOCATION_BACKGROUND {
        return PermCall {
            cls: "CLLocationManager", method: "requestAlwaysAuthorization", sig: "v@:"
        };
    }
    if p == PERM_NOTIFICATIONS {
        return PermCall {
            cls: "UNUserNotificationCenter", method: "requestAuthorizationWithOptions:completionHandler:", sig: "v@:Q@?"
        };
    }
    if p == PERM_PHOTOS {
        return PermCall {
            cls: "PHPhotoLibrary", method: "requestAuthorizationForAccessLevel:handler:", sig: "v@:q@?"
        };
    }
    // CoreBluetooth asks when a CBCentralManager is created
    return PermCall {
        cls: "CBCentralManager", method: "initWithDelegate:queue:", sig: "@@:@@"
    };
}

// ─── The request flow ──────────────────────────────────────────────────

pub const PERM_STEP_DONE: i64 = 0;
pub const PERM_STEP_RATIONALE: i64 = 1;
pub const PERM_STEP_REQUEST: i64 = 2;
pub const PERM_STEP_SETTINGS: i64 = 3;
pub const PERM_STEP_BLOCKED: i64 = 4;  // restricted or a prerequisite missing

pub fn perm_step_name(s: i64) -> str {
    val n: Vec<str> = str_split("done,rationale,request,settings,blocked", ",");
    if s < 0 || s >= n.len() {
        return "?";
    }
    return n.get(s);
}

/// One permission being obtained.
pub struct PermFlow {
    pub perm: i64,
    pub platform: i64,
    pub api: i64,  // Android API level (ignored on iOS)
    pub status: i64,
    pub denials: i64,
    pub requests: i64,
    pub rationale_shown: bool,
    pub prerequisite: i64,  // status of the foreground location (background only)
}

pub fn perm_flow_new(perm: i64, platform: i64, api: i64) -> PermFlow {
    return PermFlow {
        perm: perm, platform: platform, api: api, status: PERM_NOT_DETERMINED, denials: 0, requests: 0, rationale_shown: false, prerequisite: PERM_GRANTED,
    };
}

/// What to do next. `rationale` is what shouldShowRequestPermissionRationale
/// says now (Android; ignored on iOS).
pub fn perm_flow_next(f: &PermFlow, rationale: bool) -> i64 {
    if perm_usable(f.status) {
        return PERM_STEP_DONE;
    }
    if f.status == PERM_RESTRICTED {
        return PERM_STEP_BLOCKED;
    }
    if f.perm == PERM_LOCATION_BACKGROUND && !perm_usable(f.prerequisite) {
        return PERM_STEP_BLOCKED;
    }
    if f.status == PERM_PERMANENTLY_DENIED {
        return PERM_STEP_SETTINGS;
    }
    if f.platform == PERM_ANDROID {
        if !perm_android_is_runtime(f.perm, f.api) {
            return PERM_STEP_DONE;
        }
        if rationale && !f.rationale_shown {
            return PERM_STEP_RATIONALE;
        }
        return PERM_STEP_REQUEST;
    }
    // iOS: one system prompt; after a denial only Settings can grant it
    if f.status == PERM_NOT_DETERMINED {
        return PERM_STEP_REQUEST;
    }
    return PERM_STEP_SETTINGS;
}

/// The rationale was shown to the user.
pub fn perm_flow_rationale_shown(f: &mut PermFlow) {
    f.rationale_shown = true;
}

/// The system dialog answered: on Android `results` per name and the
/// rationale flag read after the answer; on iOS `results` holds the one
/// framework status code (already mapped with perm_ios_*: pass the status).
pub fn perm_flow_result(f: &mut PermFlow, results: Vec<i64>, rationale_after: bool) {
    f.requests = f.requests + 1;
    if f.platform == PERM_ANDROID {
        var granted_all: bool = results.len() > 0;
        var i: i64 = 0;
        while i < results.len() {
            if results.get(i) != 0 {
                granted_all = false;
            }
            i = i + 1;
        }
        if !granted_all {
            f.denials = f.denials + 1;
        }
        f.status = perm_android_status(f.perm, f.api, results, rationale_after, f.denials);
        f.rationale_shown = false;
        return;
    }
    if results.len() > 0 {
        f.status = results.get(0);
    }
    if f.status == PERM_DENIED {
        f.status = PERM_PERMANENTLY_DENIED;
    }
    if !perm_usable(f.status) {
        f.denials = f.denials + 1;
    }
}

/// The order to ask for a set: foreground location before background,
/// each once.
pub fn perm_request_order(perms: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var bg: bool = false;
    var i: i64 = 0;
    while i < perms.len() {
        val p: i64 = perms.get(i);
        if p == PERM_LOCATION_BACKGROUND {
            bg = true;
        } else {
            var dup: bool = false;
            var j: i64 = 0;
            while j < out.len() {
                if out.get(j) == p {
                    dup = true;
                }
                j = j + 1;
            }
            if !dup {
                out.push(p);
            }
        }
        i = i + 1;
    }
    if bg {
        var has_fg: bool = false;
        i = 0;
        while i < out.len() {
            if out.get(i) == PERM_LOCATION_FINE || out.get(i) == PERM_LOCATION_COARSE {
                has_fg = true;
            }
            i = i + 1;
        }
        if !has_fg {
            out.push(PERM_LOCATION_FINE);
        }
        out.push(PERM_LOCATION_BACKGROUND);
    }
    return out;
}
