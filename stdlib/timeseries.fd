// Fides time series: ring storage, downsampling, Gorilla compression
//
// All pure computation, no platform seam:
//   - TsRing: a fixed-capacity ring of (time, value) points, oldest
//     overwritten when full; times must not go backwards; index access
//     oldest first, latest point, range queries by time;
//   - downsampling into fixed buckets: count, sum, average, minimum,
//     maximum, first and last value per bucket (empty buckets say so);
//   - Gorilla compression (Pelkonen et al., "Gorilla: A Fast, Scalable,
//     In-Memory Time Series Database", VLDB 2015, section 4.1): timestamps
//     as delta-of-delta with the '0' / '10'+7 / '110'+9 / '1110'+12 /
//     '1111'+64 bit buckets, values as the XOR with the previous value with
//     the '0' / '10' (same window) / '11'+5+6 (new window) control bits.
//     Differences from the paper, so every i64 time and every f64 bit
//     pattern round-trips: the header is the first time (64 bits) and value
//     (64 bits), the first delta is coded as a delta-of-delta from 0, and
//     the last timestamp bucket holds 64 bits instead of 32. The byte form
//     starts with the point count (4 bytes, big-endian).
//
// Times are i64 (any unit, e.g. milliseconds); values f64.

module timeseries;
use vec;
use string;

// ─── Ring storage ────────────────────────────────────────────────────────

pub struct TsRing {
    pub cap: i64,
    pub times: Vec<i64>,
    pub values: Vec<f64>,
    pub head: i64,  // index of the oldest point
    pub count: i64,
    pub dropped: i64,  // points overwritten so far
}

pub fn ts_ring_new(cap: i64) -> TsRing {
    var c: i64 = cap;
    if c < 1 {
        c = 1;
    }
    var vs: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < c {
        vs.push(0.0);
        i = i + 1;
    }
    return TsRing {
        cap: c, times: Vec::filled(c, 0), values: vs, head: 0, count: 0, dropped: 0
    };
}

pub fn ts_ring_len(r: &TsRing) -> i64 {
    return r.count;
}

/// Add a point; false (and nothing stored) when `t` is before the latest.
pub fn ts_ring_push(r: &mut TsRing, t: i64, v: f64) -> bool {
    if r.count > 0 && t < ts_ring_time(r, r.count - 1) {
        return false;
    }
    if r.count < r.cap {
        val at: i64 = (r.head + r.count) % r.cap;
        r.times.set(at, t);
        r.values.set(at, v);
        r.count = r.count + 1;
    } else {
        r.times.set(r.head, t);
        r.values.set(r.head, v);
        r.head = (r.head + 1) % r.cap;
        r.dropped = r.dropped + 1;
    }
    return true;
}

/// Time of point i (0 is the oldest).
pub fn ts_ring_time(r: &TsRing, i: i64) -> i64 {
    return r.times.get((r.head + i) % r.cap);
}

pub fn ts_ring_value(r: &TsRing, i: i64) -> f64 {
    return r.values.get((r.head + i) % r.cap);
}

pub fn ts_ring_clear(r: &mut TsRing) {
    r.head = 0;
    r.count = 0;
}

/// Index of the first point with time >= t (len when none).
pub fn ts_ring_lower_bound(r: &TsRing, t: i64) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = r.count;
    while lo < hi {
        val mid: i64 = (lo + hi) / 2;
        if ts_ring_time(r, mid) < t {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

/// Times and values of the points with t0 <= time < t1.
pub struct TsSeries {
    pub times: Vec<i64>,
    pub values: Vec<f64>,
}

pub fn ts_series_new() -> TsSeries {
    return TsSeries {
        times: Vec::new(), values: Vec::new()
    };
}

pub fn ts_series_push(s: &mut TsSeries, t: i64, v: f64) {
    s.times.push(t);
    s.values.push(v);
}

pub fn ts_ring_range(r: &TsRing, t0: i64, t1: i64) -> TsSeries {
    var out: TsSeries = ts_series_new();
    var i: i64 = ts_ring_lower_bound(r, t0);
    while i < r.count && ts_ring_time(r, i) < t1 {
        ts_series_push(&mut out, ts_ring_time(r, i), ts_ring_value(r, i));
        i = i + 1;
    }
    return out;
}

/// Every point, oldest first.
pub fn ts_ring_all(r: &TsRing) -> TsSeries {
    var out: TsSeries = ts_series_new();
    var i: i64 = 0;
    while i < r.count {
        ts_series_push(&mut out, ts_ring_time(r, i), ts_ring_value(r, i));
        i = i + 1;
    }
    return out;
}

// ─── Downsampling ────────────────────────────────────────────────────────

/// Bucket b covers [start + b*width, start + (b+1)*width).
pub struct TsBuckets {
    pub start: i64,
    pub width: i64,
    pub counts: Vec<i64>,
    pub sums: Vec<f64>,
    pub mins: Vec<f64>,
    pub maxs: Vec<f64>,
    pub firsts: Vec<f64>,
    pub lasts: Vec<f64>,
}

/// Downsample points (times ascending) into `n` buckets of `width` from
/// `start`; points outside are ignored.
pub fn ts_downsample(s: &TsSeries, start: i64, width: i64, n: i64) -> TsBuckets {
    var b: TsBuckets = TsBuckets {
        start: start, width: width, counts: Vec::filled(n, 0), sums: Vec::new(), mins: Vec::new(), maxs: Vec::new(), firsts: Vec::new(), lasts: Vec::new()
    };
    var i: i64 = 0;
    while i < n {
        b.sums.push(0.0);
        b.mins.push(0.0);
        b.maxs.push(0.0);
        b.firsts.push(0.0);
        b.lasts.push(0.0);
        i = i + 1;
    }
    if width <= 0 {
        return b;
    }
    i = 0;
    while i < s.times.len() {
        val t: i64 = s.times.get(i);
        val v: f64 = s.values.get(i);
        if t >= start {
            val k: i64 = (t - start) / width;
            if k < n {
                if b.counts.get(k) == 0 {
                    b.mins.set(k, v);
                    b.maxs.set(k, v);
                    b.firsts.set(k, v);
                } else {
                    if v < b.mins.get(k) {
                        b.mins.set(k, v);
                    }
                    if v > b.maxs.get(k) {
                        b.maxs.set(k, v);
                    }
                }
                b.lasts.set(k, v);
                b.sums.set(k, b.sums.get(k) + v);
                b.counts.set(k, b.counts.get(k) + 1);
            }
        }
        i = i + 1;
    }
    return b;
}

/// Average of bucket k (0.0 for an empty bucket: check the count).
pub fn ts_bucket_avg(b: &TsBuckets, k: i64) -> f64 {
    if b.counts.get(k) == 0 {
        return 0.0;
    }
    return b.sums.get(k) / (b.counts.get(k) as f64);
}

// ─── Bits ────────────────────────────────────────────────────────────────

pub struct TsBits {
    pub bytes: Vec<i64>,
    pub nbits: i64,
}

pub fn ts_bits_new() -> TsBits {
    return TsBits {
        bytes: Vec::new(), nbits: 0
    };
}

/// Append the low `n` bits of v (0..64), most significant first.
@wrapping
pub fn ts_bits_put(w: &mut TsBits, v: i64, n: i64) {
    var i: i64 = n - 1;
    while i >= 0 {
        val bit: i64 = (((v as u64) >> (i as u64)) & 1) as i64;
        if w.nbits % 8 == 0 {
            w.bytes.push(0);
        }
        if bit == 1 {
            val k: i64 = w.nbits / 8;
            w.bytes.set(k, w.bytes.get(k) | (128 >> (w.nbits % 8)));
        }
        w.nbits = w.nbits + 1;
        i = i - 1;
    }
}

pub struct TsBitReader {
    pub bytes: Vec<i64>,
    pub pos: i64,
    pub nbits: i64,
    pub ok: bool,
}

/// Read `n` bits (0..64) as an unsigned value (its 64 bits for n = 64).
@wrapping
pub fn ts_bits_get(r: &mut TsBitReader, n: i64) -> i64 {
    var v: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if r.pos >= r.nbits {
            r.ok = false;
            return 0;
        }
        val bit: i64 = (r.bytes.get(r.pos / 8) >> (7 - r.pos % 8)) & 1;
        v = (v << 1) | bit;
        r.pos = r.pos + 1;
        i = i + 1;
    }
    return v;
}

@wrapping
fn ts_clz(x: i64) -> i64 {
    if x == 0 {
        return 64;
    }
    var n: i64 = 0;
    var u: u64 = x as u64;
    while (u >> (63 as u64)) == 0 {
        u = u << 1;
        n = n + 1;
    }
    return n;
}

@wrapping
fn ts_ctz(x: i64) -> i64 {
    if x == 0 {
        return 64;
    }
    var n: i64 = 0;
    var u: u64 = x as u64;
    while (u & 1) == 0 {
        u = u >> 1;
        n = n + 1;
    }
    return n;
}

// sign-extend the low n bits
@wrapping
fn ts_sext(v: i64, n: i64) -> i64 {
    if n >= 64 {
        return v;
    }
    if ((v >> (n - 1)) & 1) == 1 {
        return v - (1 << n);
    }
    return v;
}

// A delta-of-delta of an n-bit bucket: the encoder's ranges are the
// paper's [-63, 64], [-255, 256], [-2047, 2048], so the bit pattern that
// sign-extends to -2^(n-1) is +2^(n-1) (BG402).
fn ts_dod_bits(v: i64, n: i64) -> i64 {
    val d: i64 = ts_sext(v, n);
    if d == 0 - (1 << (n - 1)) {
        return 1 << (n - 1);
    }
    return d;
}

// ─── Gorilla ─────────────────────────────────────────────────────────────

/// A compressed block that points can be appended to.
pub struct TsGorilla {
    pub bits: TsBits,
    pub count: i64,
    pub prev_t: i64,
    pub prev_delta: i64,
    pub prev_v: i64,  // bits of the previous value
    pub lead: i64,  // previous XOR window
    pub trail: i64,
}

pub fn ts_gorilla_new() -> TsGorilla {
    return TsGorilla {
        bits: ts_bits_new(), count: 0, prev_t: 0, prev_delta: 0, prev_v: 0, lead: -1, trail: 0
    };
}

/// Append a point (times should not go backwards for good compression;
/// any i64 time is coded exactly).
@wrapping
pub fn ts_gorilla_append(g: &mut TsGorilla, t: i64, v: f64) {
    val vb: i64 = p_f64_to_bits(v);
    if g.count == 0 {
        ts_bits_put(&mut g.bits, t, 64);
        ts_bits_put(&mut g.bits, vb, 64);
        g.prev_t = t;
        g.prev_v = vb;
        g.count = 1;
        return;
    }
    val delta: i64 = t - g.prev_t;
    val dod: i64 = delta - g.prev_delta;
    if dod == 0 {
        ts_bits_put(&mut g.bits, 0, 1);
    } else if dod >= -63 && dod <= 64 {
        ts_bits_put(&mut g.bits, 2, 2);
        ts_bits_put(&mut g.bits, dod, 7);
    } else if dod >= -255 && dod <= 256 {
        ts_bits_put(&mut g.bits, 6, 3);
        ts_bits_put(&mut g.bits, dod, 9);
    } else if dod >= -2047 && dod <= 2048 {
        ts_bits_put(&mut g.bits, 14, 4);
        ts_bits_put(&mut g.bits, dod, 12);
    } else {
        ts_bits_put(&mut g.bits, 15, 4);
        ts_bits_put(&mut g.bits, dod, 64);
    }
    g.prev_delta = delta;
    g.prev_t = t;
    val x: i64 = vb ^ g.prev_v;
    g.prev_v = vb;
    if x == 0 {
        ts_bits_put(&mut g.bits, 0, 1);
    } else {
        var lead: i64 = ts_clz(x);
        val trail: i64 = ts_ctz(x);
        if lead > 31 {
            lead = 31;
        }
        if g.lead >= 0 && lead >= g.lead && trail >= g.trail {
            ts_bits_put(&mut g.bits, 2, 2);
            val n: i64 = 64 - g.lead - g.trail;
            ts_bits_put(&mut g.bits, ((x as u64) >> (g.trail as u64)) as i64, n);
        } else {
            val n: i64 = 64 - lead - trail;
            ts_bits_put(&mut g.bits, 3, 2);
            ts_bits_put(&mut g.bits, lead, 5);
            ts_bits_put(&mut g.bits, n & 63, 6);  // 64 is written as 0
            ts_bits_put(&mut g.bits, ((x as u64) >> (trail as u64)) as i64, n);
            g.lead = lead;
            g.trail = trail;
        }
    }
    g.count = g.count + 1;
}

/// The block as bytes: count (4 bytes, big-endian), then the bits.
pub fn ts_gorilla_bytes(g: &TsGorilla) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push((g.count >> 24) & 255);
    out.push((g.count >> 16) & 255);
    out.push((g.count >> 8) & 255);
    out.push(g.count & 255);
    out.extend(g.bits.bytes);
    return out;
}

/// Compress a whole series.
pub fn ts_gorilla_encode(s: &TsSeries) -> Vec<i64> {
    var g: TsGorilla = ts_gorilla_new();
    var i: i64 = 0;
    while i < s.times.len() {
        ts_gorilla_append(&mut g, s.times.get(i), s.values.get(i));
        i = i + 1;
    }
    return ts_gorilla_bytes(&g);
}

pub struct TsDecoded {
    pub ok: bool,
    pub series: TsSeries,
}

/// Decompress bytes made by ts_gorilla_bytes / ts_gorilla_encode.
@wrapping
pub fn ts_gorilla_decode(b: Vec<i64>) -> TsDecoded {
    var out: TsSeries = ts_series_new();
    if b.len() < 4 {
        return TsDecoded {
            ok: false, series: out
        };
    }
    val count: i64 = (b.get(0) << 24) | (b.get(1) << 16) | (b.get(2) << 8) | b.get(3);
    var body: Vec<i64> = Vec::new();
    var i: i64 = 4;
    while i < b.len() {
        body.push(b.get(i));
        i = i + 1;
    }
    val nb: i64 = body.len() * 8;
    var r: TsBitReader = TsBitReader {
        bytes: body, pos: 0, nbits: nb, ok: true
    };
    if count == 0 {
        return TsDecoded {
            ok: true, series: out
        };
    }
    var t: i64 = ts_bits_get(&mut r, 64);
    var vb: i64 = ts_bits_get(&mut r, 64);
    ts_series_push(&mut out, t, p_f64_from_bits(vb));
    var delta: i64 = 0;
    var lead: i64 = 0;
    var trail: i64 = 0;
    var k: i64 = 1;
    while k < count && r.ok {
        var dod: i64 = 0;
        if ts_bits_get(&mut r, 1) == 1 {
            if ts_bits_get(&mut r, 1) == 0 {
                dod = ts_dod_bits(ts_bits_get(&mut r, 7), 7);
            } else if ts_bits_get(&mut r, 1) == 0 {
                dod = ts_dod_bits(ts_bits_get(&mut r, 9), 9);
            } else if ts_bits_get(&mut r, 1) == 0 {
                dod = ts_dod_bits(ts_bits_get(&mut r, 12), 12);
            } else {
                dod = ts_bits_get(&mut r, 64);
            }
        }
        delta = delta + dod;
        t = t + delta;
        if ts_bits_get(&mut r, 1) == 1 {
            if ts_bits_get(&mut r, 1) == 1 {
                lead = ts_bits_get(&mut r, 5);
                var n: i64 = ts_bits_get(&mut r, 6);
                if n == 0 {
                    n = 64;
                }
                trail = 64 - lead - n;
                if trail < 0 {
                    r.ok = false;
                }
            }
            val n2: i64 = 64 - lead - trail;
            val m: i64 = ts_bits_get(&mut r, n2);
            vb = vb ^ (((m as u64) << (trail as u64)) as i64);
        }
        ts_series_push(&mut out, t, p_f64_from_bits(vb));
        k = k + 1;
    }
    return TsDecoded {
        ok: r.ok, series: out
    };
}
