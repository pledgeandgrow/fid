// ELF64 object file parser — userspace loaders, debuggers, tools.
// All functions take the raw file bytes (Vec<i64>, one byte per element);
// offsets are in bytes. Only the 64-bit little-endian format is parsed.
module elf;

use vec;

// --- little-endian reads ---------------------------------------------------

pub fn elf_u16(b: Vec<i64>, o: i64) -> i64 {
    return b.get(o) + b.get(o + 1) * 256;
}

pub fn elf_u32(b: Vec<i64>, o: i64) -> i64 {
    return elf_u16(b, o) + elf_u16(b, o + 2) * 65536;
}

@wrapping
pub fn elf_u64(b: Vec<i64>, o: i64) -> i64 {
    return elf_u32(b, o) + elf_u32(b, o + 4) * 4294967296;
}

// --- header ----------------------------------------------------------------

pub struct Elf64Ehdr {
    pub valid: bool,
    pub osabi: i64,
    pub etype: i64,
    pub machine: i64,
    pub entry: i64,
    pub phoff: i64,
    pub shoff: i64,
    pub flags: i64,
    pub phentsize: i64,
    pub phnum: i64,
    pub shentsize: i64,
    pub shnum: i64,
    pub shstrndx: i64,
}

/// Parse and validate the 64-byte ELF64 header at offset 0.
pub fn elf_ehdr(b: Vec<i64>) -> Elf64Ehdr {
    var h: Elf64Ehdr = Elf64Ehdr{valid: false, osabi: 0, etype: 0, machine: 0,
        entry: 0, phoff: 0, shoff: 0, flags: 0, phentsize: 0, phnum: 0,
        shentsize: 0, shnum: 0, shstrndx: 0};
    if b.len() < 64 { return h; }
    if b.get(0) != 127 || b.get(1) != 69 || b.get(2) != 76 || b.get(3) != 70 {
        return h;
    }
    if b.get(4) != 2 { return h; }   // ELFCLASS64
    if b.get(5) != 1 { return h; }   // little-endian
    h.valid = true;
    h.osabi = b.get(7);
    h.etype = elf_u16(b, 16);
    h.machine = elf_u16(b, 18);
    h.entry = elf_u64(b, 24);
    h.phoff = elf_u64(b, 32);
    h.shoff = elf_u64(b, 40);
    h.flags = elf_u32(b, 48);
    h.phentsize = elf_u16(b, 54);
    h.phnum = elf_u16(b, 56);
    h.shentsize = elf_u16(b, 58);
    h.shnum = elf_u16(b, 60);
    h.shstrndx = elf_u16(b, 62);
    return h;
}

// --- program headers --------------------------------------------------------

pub struct Elf64Phdr {
    pub ptype: i64,
    pub flags: i64,
    pub offset: i64,
    pub vaddr: i64,
    pub paddr: i64,
    pub filesz: i64,
    pub memsz: i64,
    pub align: i64,
}

/// Program header i (i < ehdr.phnum).
pub fn elf_phdr(b: Vec<i64>, h: Elf64Ehdr, i: i64) -> Elf64Phdr {
    var o: i64 = h.phoff + i * h.phentsize;
    return Elf64Phdr{ptype: elf_u32(b, o), flags: elf_u32(b, o + 4),
        offset: elf_u64(b, o + 8), vaddr: elf_u64(b, o + 16),
        paddr: elf_u64(b, o + 24), filesz: elf_u64(b, o + 32),
        memsz: elf_u64(b, o + 40), align: elf_u64(b, o + 48)};
}

// --- section headers --------------------------------------------------------

pub struct Elf64Shdr {
    pub name_off: i64,
    pub shtype: i64,
    pub flags: i64,
    pub addr: i64,
    pub offset: i64,
    pub size: i64,
    pub link: i64,
    pub info: i64,
    pub addralign: i64,
    pub entsize: i64,
}

/// Section header i (i < ehdr.shnum).
pub fn elf_shdr(b: Vec<i64>, h: Elf64Ehdr, i: i64) -> Elf64Shdr {
    var o: i64 = h.shoff + i * h.shentsize;
    return Elf64Shdr{name_off: elf_u32(b, o), shtype: elf_u32(b, o + 4),
        flags: elf_u64(b, o + 8), addr: elf_u64(b, o + 16),
        offset: elf_u64(b, o + 24), size: elf_u64(b, o + 32),
        link: elf_u32(b, o + 40), info: elf_u32(b, o + 44),
        addralign: elf_u64(b, o + 48), entsize: elf_u64(b, o + 56)};
}

/// Read a NUL-terminated string at offset o within the byte range
/// [start, start+size) — used on the shstrtab and strtab sections.
pub fn elf_str_at(b: Vec<i64>, o: i64) -> str {
    var out: Vec<i64> = Vec::new();
    var i: i64 = o;
    while i < b.len() {
        var c: i64 = b.get(i);
        if c == 0 { break; }
        out.push(c);
        i = i + 1;
    }
    return str_from_bytes(out);
}

/// Section i's name (via the shstrndx string table).
pub fn elf_shdr_name(b: Vec<i64>, h: Elf64Ehdr, i: i64) -> str {
    var tab: Elf64Shdr = elf_shdr(b, h, h.shstrndx);
    var s: Elf64Shdr = elf_shdr(b, h, i);
    return elf_str_at(b, tab.offset + s.name_off);
}
