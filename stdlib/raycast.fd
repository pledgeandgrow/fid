// Fides Raycasting standard library
//
// 2D and 3D raycasting for mouse picking, line of sight,
// and collision queries. Supports ray vs AABB, ray vs sphere,
// and ray vs plane intersection.
//
// Usage:
//   use raycast;
//   use math;
//
//   // 2D: ray from (0,0) going right
//   var r2 = ray2d_create(vec2(0.0, 0.0), vec2(1.0, 0.0));
//   var hit = ray2d_vs_aabb(r2, 10.0, -5.0, 20.0, 5.0);
//   if hit.hit { /* hit.t is distance, hit.point is intersection */ }
//
//   // 3D: mouse picking
//   var r3 = ray3d_create(cam_pos, cam_dir);
//   var hit3 = ray3d_vs_sphere(r3, sphere_center, sphere_radius);
//   if hit3.hit { /* hit3.point is the 3D intersection point */ }

module raycast;

use vec;
use math;

// ─── 2D Raycast ──────────────────────────────────────────────────────────

pub struct Ray2D {
    pub origin: vec2,
    pub direction: vec2,   // normalized
}

pub struct RayHit2D {
    pub hit: bool,
    pub t: f64,            // distance along ray
    pub point: vec2,       // intersection point
    pub normal: vec2,      // surface normal at hit
}

pub fn ray2d_create(origin: vec2, direction: vec2) -> Ray2D {
    return Ray2D {
        origin: origin,
        direction: direction.normalize(),
    };
}

/// Ray vs AABB (axis-aligned bounding box) in 2D.
/// AABB is defined by min corner (minx, miny) and max corner (maxx, maxy).
pub fn ray2d_vs_aabb(ray: Ray2D, minx: f64, miny: f64, maxx: f64, maxy: f64) -> RayHit2D {
    var hit = RayHit2D {
        hit: false, t: 0.0,
        point: vec2(0.0, 0.0),
        normal: vec2(0.0, 0.0),
    };

    var tmin = 0.0;
    var tmax = 999999.0;

    // X axis
    if math_fabs(ray.direction.x) < 0.0001 {
        if ray.origin.x < minx || ray.origin.x > maxx { return hit; }
    } else {
        var t1 = (minx - ray.origin.x) / ray.direction.x;
        var t2 = (maxx - ray.origin.x) / ray.direction.x;
        if t1 > t2 { var tmp = t1; t1 = t2; t2 = tmp; }
        if t1 > tmin { tmin = t1; }
        if t2 < tmax { tmax = t2; }
        if tmin > tmax { return hit; }
    }

    // Y axis
    if math_fabs(ray.direction.y) < 0.0001 {
        if ray.origin.y < miny || ray.origin.y > maxy { return hit; }
    } else {
        var t1 = (miny - ray.origin.y) / ray.direction.y;
        var t2 = (maxy - ray.origin.y) / ray.direction.y;
        if t1 > t2 { var tmp = t1; t1 = t2; t2 = tmp; }
        if t1 > tmin { tmin = t1; }
        if t2 < tmax { tmax = t2; }
        if tmin > tmax { return hit; }
    }

    hit.hit = true;
    hit.t = tmin;
    hit.point = vec2(ray.origin.x + ray.direction.x * tmin, ray.origin.y + ray.direction.y * tmin);

    // Compute normal based on which face was hit
    var hx = hit.point.x;
    var hy = hit.point.y;
    if math_fabs(hx - minx) < 0.001 { hit.normal = vec2(-1.0, 0.0); }
    else if math_fabs(hx - maxx) < 0.001 { hit.normal = vec2(1.0, 0.0); }
    else if math_fabs(hy - miny) < 0.001 { hit.normal = vec2(0.0, -1.0); }
    else { hit.normal = vec2(0.0, 1.0); }

    return hit;
}

/// Ray vs circle (sphere in 2D).
pub fn ray2d_vs_circle(ray: Ray2D, cx: f64, cy: f64, radius: f64) -> RayHit2D {
    var hit = RayHit2D {
        hit: false, t: 0.0,
        point: vec2(0.0, 0.0),
        normal: vec2(0.0, 0.0),
    };

    var dx = ray.origin.x - cx;
    var dy = ray.origin.y - cy;
    var b = dx * ray.direction.x + dy * ray.direction.y;
    var c = dx * dx + dy * dy - radius * radius;

    if c > 0.0 && b > 0.0 { return hit; }  // ray starts outside and points away

    var disc = b * b - c;
    if disc < 0.0 { return hit; }  // no intersection

    var t = -b - pledge_sqrt(disc);
    if t < 0.0 { t = 0.0; }

    hit.hit = true;
    hit.t = t;
    hit.point = vec2(ray.origin.x + ray.direction.x * t, ray.origin.y + ray.direction.y * t);
    var nx = hit.point.x - cx;
    var ny = hit.point.y - cy;
    var len = pledge_sqrt(nx * nx + ny * ny);
    if len > 0.0 {
        hit.normal = vec2(nx / len, ny / len);
    }
    return hit;
}

/// Ray vs line segment.
pub fn ray2d_vs_segment(ray: Ray2D, x1: f64, y1: f64, x2: f64, y2: f64) -> RayHit2D {
    var hit = RayHit2D {
        hit: false, t: 0.0,
        point: vec2(0.0, 0.0),
        normal: vec2(0.0, 0.0),
    };

    var dx = x2 - x1;
    var dy = y2 - y1;
    var denom = ray.direction.x * dy - ray.direction.y * dx;
    if math_fabs(denom) < 0.0001 { return hit; }  // parallel

    var t = ((x1 - ray.origin.x) * dy - (y1 - ray.origin.y) * dx) / denom;
    var u = ((x1 - ray.origin.x) * ray.direction.y - (y1 - ray.origin.y) * ray.direction.x) / denom;

    if t < 0.0 || u < 0.0 || u > 1.0 { return hit; }

    hit.hit = true;
    hit.t = t;
    hit.point = vec2(ray.origin.x + ray.direction.x * t, ray.origin.y + ray.direction.y * t);
    // Normal perpendicular to segment
    var nx = -dy;
    var ny = dx;
    var len = pledge_sqrt(nx * nx + ny * ny);
    if len > 0.0 {
        hit.normal = vec2(nx / len, ny / len);
    }
    return hit;
}

// ─── 3D Raycast ──────────────────────────────────────────────────────────

pub struct Ray3D {
    pub origin: vec3,
    pub direction: vec3,   // normalized
}

pub struct RayHit3D {
    pub hit: bool,
    pub t: f64,
    pub point: vec3,
    pub normal: vec3,
}

pub fn ray3d_create(origin: vec3, direction: vec3) -> Ray3D {
    return Ray3D {
        origin: origin,
        direction: direction.normalize(),
    };
}

/// Ray vs AABB in 3D (slab method).
pub fn ray3d_vs_aabb(ray: Ray3D, minx: f64, miny: f64, minz: f64, maxx: f64, maxy: f64, maxz: f64) -> RayHit3D {
    var hit = RayHit3D {
        hit: false, t: 0.0,
        point: vec3(0.0, 0.0, 0.0),
        normal: vec3(0.0, 0.0, 0.0),
    };

    var tmin = 0.0;
    var tmax = 999999.0;
    var hit_axis = 0;

    // X axis
    if math_fabs(ray.direction.x) < 0.0001 {
        if ray.origin.x < minx || ray.origin.x > maxx { return hit; }
    } else {
        var t1 = (minx - ray.origin.x) / ray.direction.x;
        var t2 = (maxx - ray.origin.x) / ray.direction.x;
        if t1 > t2 { var tmp = t1; t1 = t2; t2 = tmp; }
        if t1 > tmin { tmin = t1; hit_axis = 0; }
        if t2 < tmax { tmax = t2; }
        if tmin > tmax { return hit; }
    }

    // Y axis
    if math_fabs(ray.direction.y) < 0.0001 {
        if ray.origin.y < miny || ray.origin.y > maxy { return hit; }
    } else {
        var t1 = (miny - ray.origin.y) / ray.direction.y;
        var t2 = (maxy - ray.origin.y) / ray.direction.y;
        if t1 > t2 { var tmp = t1; t1 = t2; t2 = tmp; }
        if t1 > tmin { tmin = t1; hit_axis = 1; }
        if t2 < tmax { tmax = t2; }
        if tmin > tmax { return hit; }
    }

    // Z axis
    if math_fabs(ray.direction.z) < 0.0001 {
        if ray.origin.z < minz || ray.origin.z > maxz { return hit; }
    } else {
        var t1 = (minz - ray.origin.z) / ray.direction.z;
        var t2 = (maxz - ray.origin.z) / ray.direction.z;
        if t1 > t2 { var tmp = t1; t1 = t2; t2 = tmp; }
        if t1 > tmin { tmin = t1; hit_axis = 2; }
        if t2 < tmax { tmax = t2; }
        if tmin > tmax { return hit; }
    }

    hit.hit = true;
    hit.t = tmin;
    hit.point = vec3(
        ray.origin.x + ray.direction.x * tmin,
        ray.origin.y + ray.direction.y * tmin,
        ray.origin.z + ray.direction.z * tmin
    );

    // Compute normal based on hit axis
    if hit_axis == 0 {
        if ray.direction.x > 0.0 { hit.normal = vec3(-1.0, 0.0, 0.0); }
        else { hit.normal = vec3(1.0, 0.0, 0.0); }
    } else if hit_axis == 1 {
        if ray.direction.y > 0.0 { hit.normal = vec3(0.0, -1.0, 0.0); }
        else { hit.normal = vec3(0.0, 1.0, 0.0); }
    } else {
        if ray.direction.z > 0.0 { hit.normal = vec3(0.0, 0.0, -1.0); }
        else { hit.normal = vec3(0.0, 0.0, 1.0); }
    }

    return hit;
}

/// Ray vs sphere in 3D.
pub fn ray3d_vs_sphere(ray: Ray3D, center: vec3, radius: f64) -> RayHit3D {
    var hit = RayHit3D {
        hit: false, t: 0.0,
        point: vec3(0.0, 0.0, 0.0),
        normal: vec3(0.0, 0.0, 0.0),
    };

    var oc = ray.origin.sub(center);
    var b = oc.dot(ray.direction);
    var c = oc.dot(oc) - radius * radius;

    if c > 0.0 && b > 0.0 { return hit; }

    var disc = b * b - c;
    if disc < 0.0 { return hit; }

    var t = -b - pledge_sqrt(disc);
    if t < 0.0 { t = 0.0; }

    hit.hit = true;
    hit.t = t;
    hit.point = ray.origin.add(ray.direction.scale(t));
    hit.normal = hit.point.sub(center).normalize();
    return hit;
}

/// Ray vs plane in 3D.
/// Plane is defined by normal and distance from origin.
pub fn ray3d_vs_plane(ray: Ray3D, normal: vec3, distance: f64) -> RayHit3D {
    var hit = RayHit3D {
        hit: false, t: 0.0,
        point: vec3(0.0, 0.0, 0.0),
        normal: vec3(0.0, 0.0, 0.0),
    };

    var denom = ray.direction.dot(normal);
    if math_fabs(denom) < 0.0001 { return hit; }  // parallel to plane

    var t = (distance - ray.origin.dot(normal)) / denom;
    if t < 0.0 { return hit; }  // behind ray

    hit.hit = true;
    hit.t = t;
    hit.point = ray.origin.add(ray.direction.scale(t));
    hit.normal = normal;
    return hit;
}

/// Ray vs triangle in 3D (Möller–Trumbore algorithm).
pub fn ray3d_vs_triangle(ray: Ray3D, v0: vec3, v1: vec3, v2: vec3) -> RayHit3D {
    var hit = RayHit3D {
        hit: false, t: 0.0,
        point: vec3(0.0, 0.0, 0.0),
        normal: vec3(0.0, 0.0, 0.0),
    };

    var edge1 = v1.sub(v0);
    var edge2 = v2.sub(v0);
    var h = ray.direction.cross(edge2);
    var a = edge1.dot(h);

    if math_fabs(a) < 0.0001 { return hit; }  // parallel

    var f = 1.0 / a;
    var s = ray.origin.sub(v0);
    var u = f * s.dot(h);

    if u < 0.0 || u > 1.0 { return hit; }

    var q = s.cross(edge1);
    var v = f * ray.direction.dot(q);

    if v < 0.0 || u + v > 1.0 { return hit; }

    var t = f * edge2.dot(q);
    if t < 0.0 { return hit; }

    hit.hit = true;
    hit.t = t;
    hit.point = ray.origin.add(ray.direction.scale(t));
    hit.normal = edge1.cross(edge2).normalize();
    return hit;
}

/// Get a point along a ray at distance t.
pub fn ray2d_at(ray: Ray2D, t: f64) -> vec2 {
    return vec2(ray.origin.x + ray.direction.x * t, ray.origin.y + ray.direction.y * t);
}

/// Get a point along a 3D ray at distance t.
pub fn ray3d_at(ray: Ray3D, t: f64) -> vec3 {
    return ray.origin.add(ray.direction.scale(t));
}
