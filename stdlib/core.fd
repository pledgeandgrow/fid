// Pledge core standard library — Phase 2
// Auto-included by the compiler. All items are pub.

module core;

// Builtin: print — outputs to stdout
// (Implemented natively in the compiler for Phase 1)

// Builtin: println — print with newline
pub fn println(s: str) -> void {
    print(s);
    print("\n");
}

// Builtin: assert — crash if condition is false
pub fn assert(cond: bool) -> void {
    if !cond {
        print("Assertion failed\n");
    }
}

// Builtin: assert_eq — check equality
pub fn assert_eq<T>(a: T, b: T) -> void {
    if a != b {
        print("Assertion failed: values not equal\n");
    }
}

// ─── Option<T> ──────────────────────────────────────────────────────────
// Represents an optional value: either Some(value) or None.
// Generic over T — the inner value type. Uses uniform i64 representation.

pub enum Option<T> {
    Some(i64),
    None,
}

impl Option {
    pub fn is_some(self: Option) -> bool {
        match self {
            Option::Some(v: i64) => { return true; }
            Option::None => { return false; }
        }
    }

    pub fn is_none(self: Option) -> bool {
        match self {
            Option::Some(v: i64) => { return false; }
            Option::None => { return true; }
        }
    }

    pub fn unwrap(self: Option) -> i64 {
        match self {
            Option::Some(v: i64) => { return v; }
            Option::None => {
                p_panic("called unwrap on None");
            }
        }
    }

    pub fn unwrap_or(self: Option, default: i64) -> i64 {
        match self {
            Option::Some(v: i64) => { return v; }
            Option::None => { return default; }
        }
    }

    pub fn map(self: Option, f: fn(i64) -> i64) -> Option {
        match self {
            Option::Some(v: i64) => { return Option::Some(f(v)); }
            Option::None => { return Option::None; }
        }
    }

    pub fn and_then(self: Option, f: fn(i64) -> i64) -> Option {
        match self {
            Option::Some(v: i64) => { return Option::Some(f(v)); }
            Option::None => { return Option::None; }
        }
    }

    pub fn or_else(self: Option, default: fn() -> i64) -> Option {
        match self {
            Option::Some(v: i64) => { return Option::Some(v); }
            Option::None => { return Option::Some(default()); }
        }
    }

    pub fn unwrap_or_else(self: Option, default: fn() -> i64) -> i64 {
        match self {
            Option::Some(v: i64) => { return v; }
            Option::None => { return default(); }
        }
    }

    pub fn expect(self: Option, msg: str) -> i64 {
        match self {
            Option::Some(v: i64) => { return v; }
            Option::None => {
                p_panic(msg);
            }
        }
    }
}

// ─── Result<T, E> ───────────────────────────────────────────────────────
// Represents a result: either Ok(value) or Err(error).
// Generic over T (value type) and E (error type). Uses uniform i64 representation.

pub enum Result<T, E> {
    Ok(i64),
    Err(i64),
}

impl Result {
    pub fn is_ok(self: Result) -> bool {
        match self {
            Result::Ok(v: i64) => { return true; }
            Result::Err(e: i64) => { return false; }
        }
    }

    pub fn is_err(self: Result) -> bool {
        match self {
            Result::Ok(v: i64) => { return false; }
            Result::Err(e: i64) => { return true; }
        }
    }

    pub fn unwrap(self: Result) -> i64 {
        match self {
            Result::Ok(v: i64) => { return v; }
            Result::Err(e: i64) => {
                p_panic("called unwrap on Err");
            }
        }
    }

    pub fn unwrap_or(self: Result, default: i64) -> i64 {
        match self {
            Result::Ok(v: i64) => { return v; }
            Result::Err(e: i64) => { return default; }
        }
    }

    pub fn ok(self: Result) -> Option {
        match self {
            Result::Ok(v: i64) => { return Option::Some(v); }
            Result::Err(e: i64) => { return Option::None; }
        }
    }

    pub fn err(self: Result) -> Option {
        match self {
            Result::Ok(v: i64) => { return Option::None; }
            Result::Err(e: i64) => { return Option::Some(e); }
        }
    }

    pub fn map(self: Result, f: fn(i64) -> i64) -> Result {
        match self {
            Result::Ok(v: i64) => { return Result::Ok(f(v)); }
            Result::Err(e: i64) => { return Result::Err(e); }
        }
    }

    pub fn map_err(self: Result, f: fn(i64) -> i64) -> Result {
        match self {
            Result::Ok(v: i64) => { return Result::Ok(v); }
            Result::Err(e: i64) => { return Result::Err(f(e)); }
        }
    }

    pub fn and_then(self: Result, f: fn(i64) -> i64) -> Result {
        match self {
            Result::Ok(v: i64) => { return Result::Ok(f(v)); }
            Result::Err(e: i64) => { return Result::Err(e); }
        }
    }

    pub fn unwrap_or_else(self: Result, default: fn() -> i64) -> i64 {
        match self {
            Result::Ok(v: i64) => { return v; }
            Result::Err(e: i64) => { return default(); }
        }
    }

    pub fn expect(self: Result, msg: str) -> i64 {
        match self {
            Result::Ok(v: i64) => { return v; }
            Result::Err(e: i64) => {
                p_panic(msg);
            }
        }
    }
}

// ─── Utility functions ──────────────────────────────────────────────────

pub fn max(a: i64, b: i64) -> i64 {
    if a > b { return a; }
    return b;
}

pub fn min(a: i64, b: i64) -> i64 {
    if a < b { return a; }
    return b;
}

pub fn abs(n: i64) -> i64 {
    if n < 0 { return -n; }
    return n;
}

pub fn clamp(n: i64, lo: i64, hi: i64) -> i64 {
    if n < lo { return lo; }
    if n > hi { return hi; }
    return n;
}

// ─── Allocator (Phase 2A.8) ───
// Explicit allocator-as-parameter, like Zig, but verified at compile time.
// Functions that declare !Alloc must take an Allocator parameter.

// Builtin: p_allocator_create — create a named allocator
// Builtin: p_allocator_alloc — allocate memory from an allocator
// Builtin: p_allocator_free — free memory back to an allocator
// Builtin: p_allocator_stats — get allocation stats (bytes allocated)

pub fn create_allocator(name: str) -> Allocator {
    return p_allocator_create(name);
}

pub fn allocator_alloc(alloc: &Allocator, size: i64) -> i64 {
    return p_allocator_alloc(alloc, size);
}

pub fn allocator_free(alloc: &Allocator, ptr: i64) -> void {
    p_allocator_free(alloc, ptr);
}

pub fn allocator_bytes_used(alloc: &Allocator) -> i64 {
    return p_allocator_stats(alloc);
}

// ─── Iterator capability (Phase 7.7) ───────────────────────────────────
// The Iterator cap defines the interface for lazy iteration.
// Types implementing Iterator can be used in for loops.
// Note: Built-in types (Vec, Range, HashMap) have compiler-level iterator
// support. Custom types can implement this cap to work with for loops.

pub cap Iterator {
    type Item;
    fn next(self: Self) -> Option<Self::Item>;
}

// ─── Error trait (Phase 7.7) ───────────────────────────────────────────
// The Error cap defines the interface for custom error types.
// Any type implementing Error can be used as the E in Result<T, E>.

pub cap Error {
    fn message(self: Self) -> str;
}

// ─── Vec<T> (Phase 10B) ─────────────────────────────────────────────────
// Dynamic array with amortized O(1) push/pop.
// Implemented in pure Fides using raw pointers — no compiler builtins.
//
// Internal layout: 24-byte heap block { data: *i64, len: i64, capacity: i64 }
// The Vec value is an i64 pointer to this block.
// Element data is a separate heap allocation of capacity * 8 bytes.
//
// All functions take the Vec as i64 (the pointer to the block).
// Mutation is in-place through the pointer — no return-and-reassign needed.

pub fn Vec_new() -> i64 {
    val ptr: i64 = p_malloc(24);
    val p0: *mut i64 = ptr;
    val p8: *mut i64 = ptr + 8;
    val p16: *mut i64 = ptr + 16;
    unsafe {
        *p0 = 0;
        *p8 = 0;
        *p16 = 0;
    }
    return ptr;
}

pub fn Vec_push(v: i64, value: i64) {
    val len_ptr: *mut i64 = v + 8;
    val cap_ptr: *mut i64 = v + 16;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    var capacity: i64;
    var data: i64;

    unsafe {
        len = *len_ptr;
        capacity = *cap_ptr;
        data = *data_ptr_ptr;
    }

    if len >= capacity {
        val new_capacity: i64 = 8;
        if capacity > 0 {
            new_capacity = capacity * 2;
        }
        val new_data: i64 = p_malloc(new_capacity * 8);

        val i: i64 = 0;
        while i < len {
            val src_addr: i64 = data + i * 8;
            val src_ptr: *mut i64 = src_addr;
            val dst_addr: i64 = new_data + i * 8;
            val dst_ptr: *mut i64 = dst_addr;
            unsafe {
                val old_val: i64 = *src_ptr;
                *dst_ptr = old_val;
            }
            i = i + 1;
        }

        if data != 0 {
            p_free(data);
        }

        unsafe {
            *data_ptr_ptr = new_data;
            *cap_ptr = new_capacity;
        }
    }

    unsafe {
        data = *data_ptr_ptr;
    }

    val addr: i64 = data + len * 8;
    val elem_ptr: *mut i64 = addr;
    unsafe {
        *elem_ptr = value;
    }

    val new_len: i64 = len + 1;
    unsafe {
        *len_ptr = new_len;
    }
}

pub fn Vec_pop(v: i64) -> i64 {
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if len == 0 {
        return 0;
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    val addr: i64 = data + (len - 1) * 8;
    val elem_ptr: *mut i64 = addr;
    var result: i64;
    unsafe {
        result = *elem_ptr;
    }

    val new_len: i64 = len - 1;
    unsafe {
        *len_ptr = new_len;
    }

    return result;
}

pub fn Vec_len(v: i64) -> i64 {
    val len_ptr: *mut i64 = v + 8;
    var result: i64;
    unsafe {
        result = *len_ptr;
    }
    return result;
}

pub fn Vec_is_empty(v: i64) -> bool {
    val len_ptr: *mut i64 = v + 8;
    var len: i64;
    unsafe {
        len = *len_ptr;
    }
    return len == 0;
}

pub fn Vec_get(v: i64, idx: i64) -> i64 {
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if idx >= len {
        p_panic("Vec index out of bounds");
    }
    if idx < 0 {
        p_panic("Vec index out of bounds");
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    val addr: i64 = data + idx * 8;
    val ptr: *mut i64 = addr;
    val result: i64 = 0;
    unsafe {
        result = *ptr;
    }
    return result;
}

pub fn Vec_set(v: i64, idx: i64, value: i64) {
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if idx >= len {
        p_panic("Vec index out of bounds");
    }
    if idx < 0 {
        p_panic("Vec index out of bounds");
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    val addr: i64 = data + idx * 8;
    val ptr: *mut i64 = addr;
    unsafe {
        *ptr = value;
    }
}

pub fn Vec_clear(v: i64) {
    val len_ptr: *mut i64 = v + 8;
    unsafe {
        *len_ptr = 0;
    }
}

pub fn Vec_capacity(v: i64) -> i64 {
    val cap_ptr: *mut i64 = v + 16;
    var result: i64;
    unsafe {
        result = *cap_ptr;
    }
    return result;
}

pub fn Vec_contains(v: i64, value: i64) -> bool {
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    val i: i64 = 0;
    while i < len {
        val addr: i64 = data + i * 8;
        val ptr: *mut i64 = addr;
        val elem: i64 = 0;
        unsafe {
            elem = *ptr;
        }
        if elem == value {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn Vec_first(v: i64) -> i64 {
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if len == 0 {
        p_panic("Vec is empty");
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    val ptr: *mut i64 = data;
    val result: i64 = 0;
    unsafe {
        result = *ptr;
    }
    return result;
}

pub fn Vec_last(v: i64) -> i64 {
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if len == 0 {
        p_panic("Vec is empty");
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    val addr: i64 = data + (len - 1) * 8;
    val ptr: *mut i64 = addr;
    val result: i64 = 0;
    unsafe {
        result = *ptr;
    }
    return result;
}

pub fn Vec_truncate(v: i64, n: i64) {
    val len_ptr: *mut i64 = v + 8;
    var len: i64;
    unsafe {
        len = *len_ptr;
    }
    if n < len {
        unsafe {
            *len_ptr = n;
        }
    }
}

pub fn Vec_reverse(v: i64) {
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    val i: i64 = 0;
    while i < len / 2 {
        val lo_addr: i64 = data + i * 8;
        val hi_addr: i64 = data + (len - 1 - i) * 8;
        val lo_ptr: *mut i64 = lo_addr;
        val hi_ptr: *mut i64 = hi_addr;
        unsafe {
            val lo_val: i64 = *lo_ptr;
            val hi_val: i64 = *hi_ptr;
            *lo_ptr = hi_val;
            *hi_ptr = lo_val;
        }
        i = i + 1;
    }
}

pub fn Vec_extend(v: i64, other: i64) {
    val other_len_ptr: *mut i64 = other + 8;
    val other_data_ptr_ptr: *mut i64 = other;

    var other_len: i64;
    unsafe {
        other_len = *other_len_ptr;
    }

    var other_data: i64;
    unsafe {
        other_data = *other_data_ptr_ptr;
    }

    val i: i64 = 0;
    while i < other_len {
        val addr: i64 = other_data + i * 8;
        val ptr: *mut i64 = addr;
        val elem: i64 = 0;
        unsafe {
            elem = *ptr;
        }
        Vec_push(v, elem);
        i = i + 1;
    }
}

pub fn Vec_insert(v: i64, idx: i64, value: i64) {
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if idx < 0 {
        p_panic("Vec insert index out of bounds");
    }
    if idx > len {
        p_panic("Vec insert index out of bounds");
    }

    // Push a dummy to grow if needed, then shift elements right
    Vec_push(v, 0);

    // Re-read len and data (push may have reallocated)
    unsafe {
        len = *len_ptr;
    }
    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    // Shift elements right from end to idx
    val i: i64 = len - 1;
    while i > idx {
        val cur_addr: i64 = data + i * 8;
        val prev_addr: i64 = data + (i - 1) * 8;
        val cur_ptr: *mut i64 = cur_addr;
        val prev_ptr: *mut i64 = prev_addr;
        unsafe {
            val prev_val: i64 = *prev_ptr;
            *cur_ptr = prev_val;
        }
        i = i - 1;
    }

    // Store the new value at idx
    val addr: i64 = data + idx * 8;
    val ptr: *mut i64 = addr;
    unsafe {
        *ptr = value;
    }
}

pub fn Vec_remove(v: i64, idx: i64) -> i64 {
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if idx < 0 {
        p_panic("Vec remove index out of bounds");
    }
    if idx >= len {
        p_panic("Vec remove index out of bounds");
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    // Get the value at idx
    val addr: i64 = data + idx * 8;
    val ptr: *mut i64 = addr;
    val result: i64 = 0;
    unsafe {
        result = *ptr;
    }

    // Shift elements left
    val i: i64 = idx;
    while i < len - 1 {
        val cur_addr: i64 = data + i * 8;
        val next_addr: i64 = data + (i + 1) * 8;
        val cur_ptr: *mut i64 = cur_addr;
        val next_ptr: *mut i64 = next_addr;
        unsafe {
            val next_val: i64 = *next_ptr;
            *cur_ptr = next_val;
        }
        i = i + 1;
    }

    // Decrement len
    val new_len: i64 = len - 1;
    unsafe {
        *len_ptr = new_len;
    }

    return result;
}

pub fn Vec_clone(v: i64) -> i64 {
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    val new_v: i64 = Vec_new();
    val i: i64 = 0;
    while i < len {
        val addr: i64 = data + i * 8;
        val ptr: *mut i64 = addr;
        val elem: i64 = 0;
        unsafe {
            elem = *ptr;
        }
        Vec_push(new_v, elem);
        i = i + 1;
    }
    return new_v;
}

pub fn Vec_to_str(v: i64) -> str {
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    // Build string: "[1, 2, 3]"
    val result: str = "[";
    val i: i64 = 0;
    while i < len {
        if i > 0 {
            result = p_str_concat(result, ", ");
        }
        val addr: i64 = data + i * 8;
        val ptr: *mut i64 = addr;
        val elem: i64 = 0;
        unsafe {
            elem = *ptr;
        }
        result = p_str_concat(result, p_to_str(elem));
        i = i + 1;
    }
    result = p_str_concat(result, "]");
    return result;
}

pub fn Vec_sort(v: i64) {
    // Simple bubble sort
    val len_ptr: *mut i64 = v + 8;
    val data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    if len <= 1 {
        return;
    }

    val swapped: bool = true;
    while swapped {
        swapped = false;
        val i: i64 = 0;
        while i < len - 1 {
            val addr0: i64 = data + i * 8;
            val addr1: i64 = data + (i + 1) * 8;
            val ptr0: *mut i64 = addr0;
            val ptr1: *mut i64 = addr1;
            unsafe {
                val v0: i64 = *ptr0;
                val v1: i64 = *ptr1;
                if v0 > v1 {
                    *ptr0 = v1;
                    *ptr1 = v0;
                    swapped = true;
                }
            }
            i = i + 1;
        }
    }
}

// ─── HashMap (Phase 10B) ────────────────────────────────────────────────
// Open-addressing hash map with linear probing.
// Keys are string pointers (i64 addresses to null-terminated strings).
// Values are i64.
//
// Internal layout: 32-byte heap block:
//   offset  0: keys_ptr  (*i64)  — array of key pointers (0 = empty, -1 = tombstone)
//   offset  8: vals_ptr  (*i64)  — array of values
//   offset 16: len        (i64)   — number of live entries
//   offset 24: capacity   (i64)   — size of keys/vals arrays

// FNV-1a hash of a null-terminated string. s is an i64 address.
@wrapping fn p_str_hash(s: i64) -> i64 {
    val hash: i64 = -3750763034362895579;
    val addr: i64 = s;
    val byte_ptr: *mut u8 = addr;
    unsafe {
        val b: i64 = *byte_ptr;
        while b != 0 {
            hash = hash ^ b;
            hash = hash * 1099511628211;
            addr = addr + 1;
            byte_ptr = addr;
            b = *byte_ptr;
        }
    }
    if hash < 0 { return -hash; }
    return hash;
}

// String equality: compare two null-terminated strings byte by byte.
// a and b are i64 addresses.
fn p_str_equal(a: i64, b: i64) -> bool {
    if a == b { return true; }
    if a == 0 { return false; }
    if b == 0 { return false; }
    val ai: i64 = a;
    val bi: i64 = b;
    val pa: *mut u8 = ai;
    val pb: *mut u8 = bi;
    unsafe {
        val ca: i64 = *pa;
        val cb: i64 = *pb;
        while ca != 0 && cb != 0 {
            if ca != cb { return false; }
            ai = ai + 1;
            bi = bi + 1;
            pa = ai;
            pb = bi;
            ca = *pa;
            cb = *pb;
        }
        return ca == cb;
    }
}

// Compare two null-terminated strings (i64 addresses).
// Returns <0 if a<b, 0 if equal, >0 if a>b (lexicographic).
fn p_str_compare(a: i64, b: i64) -> i64 {
    if a == b { return 0; }
    if a == 0 { return -1; }
    if b == 0 { return 1; }
    val ai: i64 = a;
    val bi: i64 = b;
    val pa: *mut u8 = ai;
    val pb: *mut u8 = bi;
    unsafe {
        val ca: i64 = *pa;
        val cb: i64 = *pb;
        while ca != 0 && cb != 0 {
            if ca != cb { return ca - cb; }
            ai = ai + 1;
            bi = bi + 1;
            pa = ai;
            pb = bi;
            ca = *pa;
            cb = *pb;
        }
        return ca - cb;
    }
}

pub fn HashMap_new() -> i64 {
    val ptr: i64 = p_malloc(32);
    val p0: *mut i64 = ptr;
    val p8: *mut i64 = ptr + 8;
    val p16: *mut i64 = ptr + 16;
    val p24: *mut i64 = ptr + 24;
    unsafe {
        *p0 = 0;
        *p8 = 0;
        *p16 = 0;
        *p24 = 0;
    }
    return ptr;
}

// Find the slot index for a key. Returns the index of the key if found,
// or the first empty/tombstone slot if not found.
fn HashMap_find_slot(m: i64, key: i64) -> i64 {
    val cap_ptr: *mut i64 = m + 24;
    val keys_ptr_ptr: *mut i64 = m;
    val capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { return 0; }
    val keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    val hash_val: i64 = p_str_hash(key);
    val idx: i64 = hash_val % capacity;
    val first_tombstone: i64 = -1;
    val i: i64 = 0;
    while i < capacity {
        val key_addr: i64 = keys + idx * 8;
        val key_ptr: *mut i64 = key_addr;
        val slot_key: i64 = 0;
        unsafe {
            slot_key = *key_ptr;
        }
        if slot_key == 0 {
            if first_tombstone >= 0 { return first_tombstone; }
            return idx;
        }
        if slot_key == -1 {
            if first_tombstone < 0 { first_tombstone = idx; }
        } else if p_str_equal(slot_key, key) {
            return idx;
        }
        idx = idx + 1;
        if idx >= capacity { idx = 0; }
        i = i + 1;
    }
    if first_tombstone >= 0 { return first_tombstone; }
    return 0;
}

@wrapping fn HashMap_grow(m: i64) {
    val cap_ptr: *mut i64 = m + 24;
    val keys_ptr_ptr: *mut i64 = m;
    val vals_ptr_ptr: *mut i64 = m + 8;
    val len_ptr: *mut i64 = m + 16;

    val old_capacity: i64 = 0;
    val old_keys: i64 = 0;
    val old_vals: i64 = 0;
    unsafe {
        old_capacity = *cap_ptr;
        old_keys = *keys_ptr_ptr;
        old_vals = *vals_ptr_ptr;
    }

    val new_capacity: i64 = 8;
    if old_capacity > 0 { new_capacity = old_capacity * 2; }

    val new_keys: i64 = p_malloc(new_capacity * 8);
    val new_vals: i64 = p_malloc(new_capacity * 8);

    // Initialize new arrays to 0
    val i: i64 = 0;
    while i < new_capacity {
        val kaddr: i64 = new_keys + i * 8;
        val kptr: *mut i64 = kaddr;
        val vaddr: i64 = new_vals + i * 8;
        val vptr: *mut i64 = vaddr;
        unsafe {
            *kptr = 0;
            *vptr = 0;
        }
        i = i + 1;
    }

    // Rehash all entries
    val count: i64 = 0;
    val old_i: i64 = 0;
    while old_i < old_capacity {
        val old_kaddr: i64 = old_keys + old_i * 8;
        val old_kptr: *mut i64 = old_kaddr;
        val old_key: i64 = 0;
        unsafe {
            old_key = *old_kptr;
        }
        if old_key != 0 && old_key != -1 {
            val old_vaddr: i64 = old_vals + old_i * 8;
            val old_vptr: *mut i64 = old_vaddr;
            val old_val: i64 = 0;
            unsafe {
                old_val = *old_vptr;
            }
            // Insert into new arrays
            val hash_val: i64 = p_str_hash(old_key);
            val new_idx: i64 = hash_val % new_capacity;
            val probe: i64 = 0;
            while probe < new_capacity {
                val nkaddr: i64 = new_keys + new_idx * 8;
                val nkptr: *mut i64 = nkaddr;
                val nk: i64 = 0;
                unsafe {
                    nk = *nkptr;
                }
                if nk == 0 {
                    unsafe {
                        *nkptr = old_key;
                    }
                    val nvaddr: i64 = new_vals + new_idx * 8;
                    val nvptr: *mut i64 = nvaddr;
                    unsafe {
                        *nvptr = old_val;
                    }
                    break;
                }
                new_idx = new_idx + 1;
                if new_idx >= new_capacity { new_idx = 0; }
                probe = probe + 1;
            }
            count = count + 1;
        }
        old_i = old_i + 1;
    }

    if old_keys != 0 { p_free(old_keys); }
    if old_vals != 0 { p_free(old_vals); }

    unsafe {
        *keys_ptr_ptr = new_keys;
        *vals_ptr_ptr = new_vals;
        *len_ptr = count;
        *cap_ptr = new_capacity;
    }
}

pub fn HashMap_insert(m: i64, key: i64, value: i64) {
    val len_ptr: *mut i64 = m + 16;
    val cap_ptr: *mut i64 = m + 24;

    val len: i64 = 0;
    val capacity: i64 = 0;
    unsafe {
        len = *len_ptr;
        capacity = *cap_ptr;
    }

    // Grow if load factor > 0.7
    if capacity == 0 || len * 10 >= capacity * 7 {
        HashMap_grow(m);
        unsafe {
            capacity = *cap_ptr;
        }
    }

    val idx: i64 = HashMap_find_slot(m, key);

    val keys_ptr_ptr: *mut i64 = m;
    val vals_ptr_ptr: *mut i64 = m + 8;
    val keys: i64 = 0;
    val vals: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
        vals = *vals_ptr_ptr;
    }

    val kaddr: i64 = keys + idx * 8;
    val kptr: *mut i64 = kaddr;
    val existing_key: i64 = 0;
    unsafe {
        existing_key = *kptr;
    }

    if existing_key == 0 || existing_key == -1 {
        unsafe {
            *kptr = key;
        }
        val vaddr: i64 = vals + idx * 8;
        val vptr: *mut i64 = vaddr;
        unsafe {
            *vptr = value;
        }
        val new_len: i64 = len + 1;
        unsafe {
            *len_ptr = new_len;
        }
    } else {
        val vaddr: i64 = vals + idx * 8;
        val vptr: *mut i64 = vaddr;
        unsafe {
            *vptr = value;
        }
    }
}

pub fn HashMap_get(m: i64, key: i64) -> i64 {
    val cap_ptr: *mut i64 = m + 24;
    val capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { return 0; }

    val idx: i64 = HashMap_find_slot(m, key);
    val keys_ptr_ptr: *mut i64 = m;
    val keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    val kaddr: i64 = keys + idx * 8;
    val kptr: *mut i64 = kaddr;
    val slot_key: i64 = 0;
    unsafe {
        slot_key = *kptr;
    }
    if slot_key == 0 || slot_key == -1 { return 0; }

    val vals_ptr_ptr: *mut i64 = m + 8;
    val vals: i64 = 0;
    unsafe {
        vals = *vals_ptr_ptr;
    }
    val vaddr: i64 = vals + idx * 8;
    val vptr: *mut i64 = vaddr;
    val result: i64 = 0;
    unsafe {
        result = *vptr;
    }
    return result;
}

pub fn HashMap_contains(m: i64, key: i64) -> bool {
    val cap_ptr: *mut i64 = m + 24;
    val capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { return false; }

    val idx: i64 = HashMap_find_slot(m, key);
    val keys_ptr_ptr: *mut i64 = m;
    val keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    val kaddr: i64 = keys + idx * 8;
    val kptr: *mut i64 = kaddr;
    val slot_key: i64 = 0;
    unsafe {
        slot_key = *kptr;
    }
    return slot_key != 0 && slot_key != -1;
}

pub fn HashMap_remove(m: i64, key: i64) {
    val cap_ptr: *mut i64 = m + 24;
    val len_ptr: *mut i64 = m + 16;
    val capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { return; }

    val idx: i64 = HashMap_find_slot(m, key);
    val keys_ptr_ptr: *mut i64 = m;
    val keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    val kaddr: i64 = keys + idx * 8;
    val kptr: *mut i64 = kaddr;
    val slot_key: i64 = 0;
    unsafe {
        slot_key = *kptr;
    }
    if slot_key == 0 || slot_key == -1 { return; }

    unsafe {
        *kptr = -1;
    }
    val len: i64 = 0;
    unsafe {
        len = *len_ptr;
    }
    val new_len: i64 = len - 1;
    unsafe {
        *len_ptr = new_len;
    }
}

pub fn HashMap_len(m: i64) -> i64 {
    val len_ptr: *mut i64 = m + 16;
    val result: i64 = 0;
    unsafe {
        result = *len_ptr;
    }
    return result;
}

pub fn HashMap_is_empty(m: i64) -> bool {
    val len_ptr: *mut i64 = m + 16;
    val len: i64 = 0;
    unsafe {
        len = *len_ptr;
    }
    return len == 0;
}

pub fn HashMap_clear(m: i64) {
    val len_ptr: *mut i64 = m + 16;
    unsafe {
        *len_ptr = 0;
    }
    val keys_ptr_ptr: *mut i64 = m;
    val cap_ptr: *mut i64 = m + 24;
    val keys: i64 = 0;
    val capacity: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
        capacity = *cap_ptr;
    }
    if keys != 0 && capacity > 0 {
        val i: i64 = 0;
        while i < capacity {
            val kaddr: i64 = keys + i * 8;
            val kptr: *mut i64 = kaddr;
            unsafe {
                *kptr = 0;
            }
            i = i + 1;
        }
    }
}

pub fn HashMap_keys(m: i64) -> i64 {
    val cap_ptr: *mut i64 = m + 24;
    val keys_ptr_ptr: *mut i64 = m;
    val capacity: i64 = 0;
    val keys: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
        keys = *keys_ptr_ptr;
    }
    val result: i64 = Vec_new();
    if keys == 0 || capacity == 0 { return result; }
    val i: i64 = 0;
    while i < capacity {
        val kaddr: i64 = keys + i * 8;
        val kptr: *mut i64 = kaddr;
        val slot_key: i64 = 0;
        unsafe {
            slot_key = *kptr;
        }
        if slot_key != 0 && slot_key != -1 {
            Vec_push(result, slot_key);
        }
        i = i + 1;
    }
    return result;
}

pub fn HashMap_values(m: i64) -> i64 {
    val cap_ptr: *mut i64 = m + 24;
    val keys_ptr_ptr: *mut i64 = m;
    val vals_ptr_ptr: *mut i64 = m + 8;
    val capacity: i64 = 0;
    val keys: i64 = 0;
    val vals: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
        keys = *keys_ptr_ptr;
        vals = *vals_ptr_ptr;
    }
    val result: i64 = Vec_new();
    if keys == 0 || capacity == 0 { return result; }
    val i: i64 = 0;
    while i < capacity {
        val kaddr: i64 = keys + i * 8;
        val kptr: *mut i64 = kaddr;
        val slot_key: i64 = 0;
        unsafe {
            slot_key = *kptr;
        }
        if slot_key != 0 && slot_key != -1 {
            val vaddr: i64 = vals + i * 8;
            val vptr: *mut i64 = vaddr;
            val value: i64 = 0;
            unsafe {
                value = *vptr;
            }
            Vec_push(result, value);
        }
        i = i + 1;
    }
    return result;
}

pub fn HashMap_clone(m: i64) -> i64 {
    val result: i64 = HashMap_new();
    val cap_ptr: *mut i64 = m + 24;
    val keys_ptr_ptr: *mut i64 = m;
    val vals_ptr_ptr: *mut i64 = m + 8;
    val capacity: i64 = 0;
    val keys: i64 = 0;
    val vals: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
        keys = *keys_ptr_ptr;
        vals = *vals_ptr_ptr;
    }
    if keys == 0 || capacity == 0 { return result; }
    val i: i64 = 0;
    while i < capacity {
        val kaddr: i64 = keys + i * 8;
        val kptr: *mut i64 = kaddr;
        val slot_key: i64 = 0;
        unsafe {
            slot_key = *kptr;
        }
        if slot_key != 0 && slot_key != -1 {
            val vaddr: i64 = vals + i * 8;
            val vptr: *mut i64 = vaddr;
            val value: i64 = 0;
            unsafe {
                value = *vptr;
            }
            HashMap_insert(result, slot_key, value);
        }
        i = i + 1;
    }
    return result;
}

pub fn HashMap_get_or(m: i64, key: i64, default: i64) -> i64 {
    val cap_ptr: *mut i64 = m + 24;
    val capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { return default; }

    val idx: i64 = HashMap_find_slot(m, key);
    val keys_ptr_ptr: *mut i64 = m;
    val keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    val kaddr: i64 = keys + idx * 8;
    val kptr: *mut i64 = kaddr;
    val slot_key: i64 = 0;
    unsafe {
        slot_key = *kptr;
    }
    if slot_key == 0 || slot_key == -1 { return default; }

    val vals_ptr_ptr: *mut i64 = m + 8;
    val vals: i64 = 0;
    unsafe {
        vals = *vals_ptr_ptr;
    }
    val vaddr: i64 = vals + idx * 8;
    val vptr: *mut i64 = vaddr;
    val result: i64 = 0;
    unsafe {
        result = *vptr;
    }
    return result;
}

// Format a HashMap as "{key: value, key: value}".
// Keys and values are assumed to be string pointers (i64 addresses).
// Keys are sorted lexicographically for deterministic output.
pub fn HashMap_to_str(m: i64) -> str {
    val keys: i64 = HashMap_keys(m);
    val len: i64 = Vec_len(keys);

    // Sort keys lexicographically (simple bubble sort)
    val i: i64 = 0;
    while i < len {
        val j: i64 = 0;
        while j + 1 < len - i {
            val k1: i64 = Vec_get(keys, j);
            val k2: i64 = Vec_get(keys, j + 1);
            if p_str_compare(k1, k2) > 0 {
                Vec_set(keys, j, k2);
                Vec_set(keys, j + 1, k1);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    val result: str = "{";
    i = 0;
    while i < len {
        if i > 0 {
            result = p_str_concat(result, ", ");
        }
        val key: i64 = Vec_get(keys, i);
        val value: i64 = HashMap_get(m, key);
        // Read key string from memory
        val key_str: *mut u8 = p_str_from_ptr(key);
        result = p_str_concat(result, key_str);
        result = p_str_concat(result, ": ");
        // Value is an i64 — format as number
        result = p_str_concat(result, p_to_str(value));
        i = i + 1;
    }
    result = p_str_concat(result, "}");
    return result;
}

// ─── String (Phase 10B) ─────────────────────────────────────────────────
// Strings are null-terminated byte buffers (i64 pointer to first byte).
// All operations allocate new strings (immutable semantics).
// String value is an i64 pointer to a null-terminated char array.

// Read a null-terminated string from a raw pointer (i64 address) and
// return it as a *mut u8 pointer to a new copy.
fn p_str_from_ptr(s: i64) -> *mut u8 {
    if s == 0 {
        val empty: i64 = p_malloc(1);
        val eptr: *mut u8 = empty;
        unsafe { *eptr = 0; }
        return eptr;
    }
    val addr: i64 = s;
    val ptr: *mut u8 = addr;
    val len: i64 = 0;
    unsafe {
        val b: i64 = *ptr;
        while b != 0 {
            len = len + 1;
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    // Allocate and copy
    val result: i64 = p_malloc(len + 1);
    val dst: *mut u8 = result;
    val src_addr: i64 = s;
    val src_ptr: *mut u8 = src_addr;
    unsafe {
        val i: i64 = 0;
        while i < len {
            val ch: i64 = *src_ptr;
            *dst = ch;
            i = i + 1;
            src_addr = src_addr + 1;
            src_ptr = src_addr;
            val dst_addr: i64 = dst;
            dst_addr = dst_addr + 1;
            dst = dst_addr;
        }
        *dst = 0;
    }
    val result_ptr: *mut u8 = result;
    return result_ptr;
}

// strlen: count bytes until null terminator. s is an i64 address.
fn p_str_length(s: i64) -> i64 {
    if s == 0 { return 0; }
    val addr: i64 = s;
    val ptr: *mut u8 = addr;
    val count: i64 = 0;
    unsafe {
        val b: i64 = *ptr;
        while b != 0 {
            count = count + 1;
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    return count;
}

// str_copy_n: copy n bytes from src to dst. Both are i64 addresses.
fn p_str_copy_n(dst: i64, src: i64, n: i64) {
    val di: i64 = dst;
    val si: i64 = src;
    val i: i64 = 0;
    while i < n {
        val d_ptr: *mut u8 = di;
        val s_ptr: *mut u8 = si;
        unsafe {
            val b: i64 = *s_ptr;
            *d_ptr = b;
        }
        di = di + 1;
        si = si + 1;
        i = i + 1;
    }
}

pub fn String_from(s: i64) -> i64 {
    if s == 0 {
        val result: i64 = p_malloc(1);
        val ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        return result;
    }
    val len: i64 = p_str_length(s);
    val result: i64 = p_malloc(len + 1);
    p_str_copy_n(result, s, len);
    val end_addr: i64 = result + len;
    val end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    return result;
}

pub fn String_len(s: i64) -> i64 {
    return p_str_length(s);
}

pub fn String_is_empty(s: i64) -> bool {
    if s == 0 { return true; }
    val ptr: *mut u8 = s;
    val b: i64 = 0;
    unsafe { b = *ptr; }
    return b == 0;
}

pub fn String_push_str(s: i64, other: i64) -> i64 {
    val s_len: i64 = p_str_length(s);
    val o_len: i64 = p_str_length(other);
    val result: i64 = p_malloc(s_len + o_len + 1);
    p_str_copy_n(result, s, s_len);
    p_str_copy_n(result + s_len, other, o_len);
    val end_addr: i64 = result + s_len + o_len;
    val end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    return result;
}

pub fn String_contains(s: i64, sub: i64) -> bool {
    if s == 0 || sub == 0 { return false; }
    val s_len: i64 = p_str_length(s);
    val sub_len: i64 = p_str_length(sub);
    if sub_len == 0 { return true; }
    if sub_len > s_len { return false; }
    val i: i64 = 0;
    while i <= s_len - sub_len {
        val matched: bool = true;
        val j: i64 = 0;
        while j < sub_len {
            val s_addr: i64 = s + i + j;
            val sub_addr: i64 = sub + j;
            val s_ptr: *mut u8 = s_addr;
            val sub_ptr: *mut u8 = sub_addr;
            val s_byte: i64 = 0;
            val sub_byte: i64 = 0;
            unsafe {
                s_byte = *s_ptr;
                sub_byte = *sub_ptr;
            }
            if s_byte != sub_byte {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched { return true; }
        i = i + 1;
    }
    return false;
}

pub fn String_starts_with(s: i64, prefix: i64) -> bool {
    if s == 0 || prefix == 0 { return false; }
    val s_len: i64 = p_str_length(s);
    val p_len: i64 = p_str_length(prefix);
    if p_len > s_len { return false; }
    val i: i64 = 0;
    while i < p_len {
        val s_addr: i64 = s + i;
        val p_addr: i64 = prefix + i;
        val s_ptr: *mut u8 = s_addr;
        val p_ptr: *mut u8 = p_addr;
        val s_byte: i64 = 0;
        val p_byte: i64 = 0;
        unsafe {
            s_byte = *s_ptr;
            p_byte = *p_ptr;
        }
        if s_byte != p_byte { return false; }
        i = i + 1;
    }
    return true;
}

pub fn String_ends_with(s: i64, suffix: i64) -> bool {
    if s == 0 || suffix == 0 { return false; }
    val s_len: i64 = p_str_length(s);
    val suf_len: i64 = p_str_length(suffix);
    if suf_len > s_len { return false; }
    if suf_len == 0 { return true; }
    val offset: i64 = s_len - suf_len;
    val i: i64 = 0;
    while i < suf_len {
        val s_addr: i64 = s + offset + i;
        val suf_addr: i64 = suffix + i;
        val s_ptr: *mut u8 = s_addr;
        val suf_ptr: *mut u8 = suf_addr;
        val s_byte: i64 = 0;
        val suf_byte: i64 = 0;
        unsafe {
            s_byte = *s_ptr;
            suf_byte = *suf_ptr;
        }
        if s_byte != suf_byte { return false; }
        i = i + 1;
    }
    return true;
}

pub fn String_trim(s: i64) -> i64 {
    if s == 0 {
        val result: i64 = p_malloc(1);
        val ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        return result;
    }
    val len: i64 = p_str_length(s);
    val start: i64 = 0;
    val end: i64 = len;
    // Find first non-whitespace
    val addr: i64 = s;
    val ptr: *mut u8 = addr;
    unsafe {
        val b: i64 = *ptr;
        while b == 32 || b == 9 || b == 10 || b == 13 {
            start = start + 1;
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    if start >= end {
        val result: i64 = p_malloc(1);
        val rptr: *mut u8 = result;
        unsafe { *rptr = 0; }
        return result;
    }
    // Find last non-whitespace
    val end_addr: i64 = s + end - 1;
    val eptr: *mut u8 = end_addr;
    unsafe {
        val b: i64 = *eptr;
        while b == 32 || b == 9 || b == 10 || b == 13 {
            end = end - 1;
            if end <= start { break; }
            end_addr = s + end - 1;
            eptr = end_addr;
            b = *eptr;
        }
    }
    val new_len: i64 = end - start;
    if new_len <= 0 {
        val result: i64 = p_malloc(1);
        val rptr: *mut u8 = result;
        unsafe { *rptr = 0; }
        return result;
    }
    val result: i64 = p_malloc(new_len + 1);
    p_str_copy_n(result, s + start, new_len);
    val rend_addr: i64 = result + new_len;
    val rend_ptr: *mut u8 = rend_addr;
    unsafe { *rend_ptr = 0; }
    return result;
}

pub fn String_to_uppercase(s: i64) -> i64 {
    if s == 0 {
        val result: i64 = p_malloc(1);
        val ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        return result;
    }
    val len: i64 = p_str_length(s);
    val result: i64 = p_malloc(len + 1);
    val i: i64 = 0;
    while i < len {
        val src_addr: i64 = s + i;
        val dst_addr: i64 = result + i;
        val src_ptr: *mut u8 = src_addr;
        val dst_ptr: *mut u8 = dst_addr;
        val b: i64 = 0;
        unsafe { b = *src_ptr; }
        if b >= 97 && b <= 122 { b = b - 32; }
        unsafe { *dst_ptr = b; }
        i = i + 1;
    }
    val end_addr: i64 = result + len;
    val end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    return result;
}

pub fn String_to_lowercase(s: i64) -> i64 {
    if s == 0 {
        val result: i64 = p_malloc(1);
        val ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        return result;
    }
    val len: i64 = p_str_length(s);
    val result: i64 = p_malloc(len + 1);
    val i: i64 = 0;
    while i < len {
        val src_addr: i64 = s + i;
        val dst_addr: i64 = result + i;
        val src_ptr: *mut u8 = src_addr;
        val dst_ptr: *mut u8 = dst_addr;
        val b: i64 = 0;
        unsafe { b = *src_ptr; }
        if b >= 65 && b <= 90 { b = b + 32; }
        unsafe { *dst_ptr = b; }
        i = i + 1;
    }
    val end_addr: i64 = result + len;
    val end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    return result;
}

pub fn String_slice(s: i64, start: i64, end: i64) -> i64 {
    if s == 0 {
        val result: i64 = p_malloc(1);
        val ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        return result;
    }
    val len: i64 = p_str_length(s);
    val st: i64 = start;
    val en: i64 = end;
    if st < 0 { st = 0; }
    if en > len { en = len; }
    if st >= en {
        val result: i64 = p_malloc(1);
        val ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        return result;
    }
    val new_len: i64 = en - st;
    val result: i64 = p_malloc(new_len + 1);
    p_str_copy_n(result, s + st, new_len);
    val end_addr: i64 = result + new_len;
    val end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    return result;
}

pub fn String_find(s: i64, sub: i64) -> i64 {
    if s == 0 || sub == 0 { return -1; }
    val s_len: i64 = p_str_length(s);
    val sub_len: i64 = p_str_length(sub);
    if sub_len == 0 { return 0; }
    if sub_len > s_len { return -1; }
    val i: i64 = 0;
    while i <= s_len - sub_len {
        val matched: bool = true;
        val j: i64 = 0;
        while j < sub_len {
            val s_addr: i64 = s + i + j;
            val sub_addr: i64 = sub + j;
            val s_ptr: *mut u8 = s_addr;
            val sub_ptr: *mut u8 = sub_addr;
            val s_byte: i64 = 0;
            val sub_byte: i64 = 0;
            unsafe {
                s_byte = *s_ptr;
                sub_byte = *sub_ptr;
            }
            if s_byte != sub_byte {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn String_rfind(s: i64, sub: i64) -> i64 {
    if s == 0 || sub == 0 { return -1; }
    val s_len: i64 = p_str_length(s);
    val sub_len: i64 = p_str_length(sub);
    if sub_len == 0 { return s_len; }
    if sub_len > s_len { return -1; }
    val i: i64 = s_len - sub_len;
    while i >= 0 {
        val matched: bool = true;
        val j: i64 = 0;
        while j < sub_len {
            val s_addr: i64 = s + i + j;
            val sub_addr: i64 = sub + j;
            val s_ptr: *mut u8 = s_addr;
            val sub_ptr: *mut u8 = sub_addr;
            val s_byte: i64 = 0;
            val sub_byte: i64 = 0;
            unsafe {
                s_byte = *s_ptr;
                sub_byte = *sub_ptr;
            }
            if s_byte != sub_byte {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched { return i; }
        i = i - 1;
    }
    return -1;
}

pub fn String_replace(s: i64, from: i64, to: i64) -> i64 {
    if s == 0 {
        val result: i64 = p_malloc(1);
        val ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        return result;
    }
    if from == 0 || to == 0 {
        return String_from(s);
    }
    val from_len: i64 = p_str_length(from);
    if from_len == 0 { return String_from(s); }

    // Build result by iterating through s
    val result: i64 = p_malloc(1);
    val rptr: *mut u8 = result;
    unsafe { *rptr = 0; }
    val pos: i64 = 0;
    val s_len: i64 = p_str_length(s);

    while pos < s_len {
        // Check if 'from' matches at pos
        val matched: bool = true;
        val j: i64 = 0;
        while j < from_len {
            if pos + j >= s_len { matched = false; break; }
            val s_addr: i64 = s + pos + j;
            val f_addr: i64 = from + j;
            val s_ptr: *mut u8 = s_addr;
            val f_ptr: *mut u8 = f_addr;
            val s_byte: i64 = 0;
            val f_byte: i64 = 0;
            unsafe {
                s_byte = *s_ptr;
                f_byte = *f_ptr;
            }
            if s_byte != f_byte { matched = false; break; }
            j = j + 1;
        }
        if matched {
            result = String_push_str(result, to);
            pos = pos + from_len;
        } else {
            // Append one byte from s
            val byte_addr: i64 = s + pos;
            val byte_ptr: *mut u8 = byte_addr;
            val b: i64 = 0;
            unsafe { b = *byte_ptr; }
            val tmp: i64 = p_malloc(2);
            val tmp_ptr: *mut u8 = tmp;
            unsafe { *tmp_ptr = b; }
            val tmp_end_addr: i64 = tmp + 1;
            val tmp_end_ptr: *mut u8 = tmp_end_addr;
            unsafe { *tmp_end_ptr = 0; }
            result = String_push_str(result, tmp);
            p_free(tmp);
            pos = pos + 1;
        }
    }
    return result;
}

pub fn String_split(s: i64, delim: i64) -> i64 {
    val result: i64 = Vec_new();
    if s == 0 || delim == 0 { return result; }
    val dlen: i64 = p_str_length(delim);
    if dlen == 0 { return result; }
    val start: i64 = 0;
    val s_len: i64 = p_str_length(s);
    val pos: i64 = 0;
    while pos <= s_len - dlen {
        val matched: bool = true;
        val j: i64 = 0;
        while j < dlen {
            val s_addr: i64 = s + pos + j;
            val d_addr: i64 = delim + j;
            val s_ptr: *mut u8 = s_addr;
            val d_ptr: *mut u8 = d_addr;
            val s_byte: i64 = 0;
            val d_byte: i64 = 0;
            unsafe {
                s_byte = *s_ptr;
                d_byte = *d_ptr;
            }
            if s_byte != d_byte { matched = false; break; }
            j = j + 1;
        }
        if matched {
            val part_len: i64 = pos - start;
            val part: i64 = p_malloc(part_len + 1);
            p_str_copy_n(part, s + start, part_len);
            val part_end_addr: i64 = part + part_len;
            val part_end_ptr: *mut u8 = part_end_addr;
            unsafe { *part_end_ptr = 0; }
            Vec_push(result, part);
            start = pos + dlen;
            pos = start;
        } else {
            pos = pos + 1;
        }
    }
    // Add remaining part
    val remaining: i64 = s_len - start;
    if remaining >= 0 {
        val part: i64 = p_malloc(remaining + 1);
        p_str_copy_n(part, s + start, remaining);
        val part_end_addr: i64 = part + remaining;
        val part_end_ptr: *mut u8 = part_end_addr;
        unsafe { *part_end_ptr = 0; }
        Vec_push(result, part);
    }
    return result;
}

pub fn String_parse_int(s: i64) -> i64 {
    if s == 0 { return 0; }
    val result: i64 = 0;
    val sign: i64 = 1;
    val addr: i64 = s;
    val ptr: *mut u8 = addr;
    unsafe {
        val b: i64 = *ptr;
        // Skip whitespace
        while b == 32 || b == 9 || b == 10 || b == 13 {
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
        // Check sign
        if b == 45 {
            sign = -1;
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        } else if b == 43 {
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
        // Parse digits
        while b >= 48 && b <= 57 {
            result = result * 10 + (b - 48);
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    return result * sign;
}

pub fn String_char_at(s: i64, idx: i64) -> i64 {
    if s == 0 { return 0; }
    val len: i64 = p_str_length(s);
    if idx < 0 || idx >= len { return 0; }
    val addr: i64 = s + idx;
    val ptr: *mut u8 = addr;
    val b: i64 = 0;
    unsafe { b = *ptr; }
    val result: i64 = p_malloc(2);
    val rptr: *mut u8 = result;
    unsafe { *rptr = b; }
    val rend_addr: i64 = result + 1;
    val rend_ptr: *mut u8 = rend_addr;
    unsafe { *rend_ptr = 0; }
    return result;
}

pub fn String_repeat(s: i64, n: i64) -> i64 {
    if s == 0 || n <= 0 {
        val result: i64 = p_malloc(1);
        val ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        return result;
    }
    val len: i64 = p_str_length(s);
    val result: i64 = p_malloc(len * n + 1);
    val i: i64 = 0;
    while i < n {
        p_str_copy_n(result + i * len, s, len);
        i = i + 1;
    }
    val end_addr: i64 = result + len * n;
    val end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    return result;
}

pub fn String_to_string(s: i64) -> i64 {
    return String_from(s);
}

pub fn String_clone(s: i64) -> i64 {
    return String_from(s);
}

pub fn String_bytes(s: i64) -> i64 {
    return p_str_length(s);
}

// ═══════════════════════════════════════════════════════════════════════
// StringBuilder — mutable string builder for efficient concatenation
// ═══════════════════════════════════════════════════════════════════════
//
// Usage:
//   value sb = StringBuilder::new();
//   sb.append_str("hello");
//   sb.append_str(" world");
//   value result = sb.to_str();  // "hello world"
//   print(result);

pub struct StringBuilder {
    buf: str,
    len: i64,
}

impl StringBuilder {
    pub fn new() -> StringBuilder {
        return StringBuilder { buf: "", len: 0 };
    }

    pub fn append_str(self: StringBuilder, s: str) -> void {
        self.buf = p_str_concat(self.buf, s);
        self.len = self.len + String_len(s);
    }

    pub fn append_char(self: StringBuilder, c: i64) -> void {
        self.buf = p_str_concat(self.buf, p_char_to_str(c));
        self.len = self.len + 1;
    }

    pub fn append_int(self: StringBuilder, n: i64) -> void {
        self.buf = p_str_concat(self.buf, p_to_str(n));
        self.len = self.len + 1;
    }

    pub fn to_str(self: StringBuilder) -> str {
        return self.buf;
    }

    pub fn len(self: StringBuilder) -> i64 {
        return self.len;
    }

    pub fn is_empty(self: StringBuilder) -> bool {
        return self.len == 0;
    }

    pub fn clear(self: StringBuilder) -> void {
        self.buf = "";
        self.len = 0;
    }
}

// ═══════════════════════════════════════════════════════════════════════
// Char iteration helpers
// ═══════════════════════════════════════════════════════════════════════

pub fn String_byte_at(s: i64, idx: i64) -> i64 {
    if s == 0 { return -1; }
    val len: i64 = p_str_length(s);
    if idx < 0 || idx >= len { return -1; }
    val addr: i64 = s + idx;
    val ptr: *mut u8 = addr;
    val b: i64 = 0;
    unsafe { b = *ptr; }
    return b;
}

pub fn String_char_count(s: i64) -> i64 {
    return p_str_length(s);
}

pub fn char_to_str(b: i64) -> str {
    return p_char_to_str(b);
}

pub fn char_is_digit(b: i64) -> bool {
    return b >= 48 && b <= 57;
}

pub fn char_is_alpha(b: i64) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
}

pub fn char_is_whitespace(b: i64) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

pub fn char_is_upper(b: i64) -> bool {
    return b >= 65 && b <= 90;
}

pub fn char_is_lower(b: i64) -> bool {
    return b >= 97 && b <= 122;
}

pub fn char_to_upper(b: i64) -> i64 {
    if b >= 97 && b <= 122 { return b - 32; }
    return b;
}

pub fn char_to_lower(b: i64) -> i64 {
    if b >= 65 && b <= 90 { return b + 32; }
    return b;
}

// ═══════════════════════════════════════════════════════════════════════
// ByteBuffer — mutable byte array for binary data
// ═══════════════════════════════════════════════════════════════════════
//
// ByteBuffer uses a Vec internally to store byte values.

pub struct ByteBuffer {
    data: Vec,
    len: i64,
}

impl ByteBuffer {
    pub fn new(init_cap: i64) -> ByteBuffer {
        return ByteBuffer { data: Vec::new(), len: 0 };
    }

    pub fn from_string(s: str) -> ByteBuffer {
        val buf = ByteBuffer::new(0);
        val slen: i64 = String_len(s);
        val i: i64 = 0;
        while i < slen {
            val addr: i64 = s + i;
            val ptr: *mut u8 = addr;
            val b: i64 = 0;
            unsafe { b = *ptr; }
            buf.write_byte(b);
            i = i + 1;
        }
        return buf;
    }

    pub fn write_byte(self: ByteBuffer, b: i64) -> void {
        self.data.push(b);
        self.len = self.len + 1;
    }

    pub fn write_bytes(self: ByteBuffer, src: i64, count: i64) -> void {
        val i: i64 = 0;
        while i < count {
            val src_addr: i64 = src + i;
            val src_ptr: *mut u8 = src_addr;
            val b: i64 = 0;
            unsafe { b = *src_ptr; }
            self.write_byte(b);
            i = i + 1;
        }
    }

    pub fn read_byte(self: ByteBuffer, idx: i64) -> i64 {
        if idx < 0 || idx >= self.len { return -1; }
        return self.data.get(idx);
    }

    pub fn set_byte(self: ByteBuffer, idx: i64, b: i64) -> void {
        if idx < 0 || idx >= self.len { return; }
        self.data.set(idx, b);
    }

    pub fn len(self: ByteBuffer) -> i64 {
        return self.len;
    }

    pub fn is_empty(self: ByteBuffer) -> bool {
        return self.len == 0;
    }

    pub fn clear(self: ByteBuffer) -> void {
        self.data.clear();
        self.len = 0;
    }

    pub fn to_str(self: ByteBuffer) -> str {
        val result: str = "";
        val i: i64 = 0;
        while i < self.len {
            val b: i64 = self.data.get(i);
            result = p_str_concat(result, p_char_to_str(b));
            i = i + 1;
        }
        return result;
    }
}

// ═══════════════════════════════════════════════════════════════════════
// Self-host stdlib gaps — string/byte/parsing utilities needed by the
// lexer, parser, and typechecker when rewritten in Fides.
// ═══════════════════════════════════════════════════════════════════════

/// Iterate over the bytes of a string, returning a Vec of byte values.
/// Usage: `value bytes = str_bytes("hello");  // [104, 101, 108, 108, 111]`
pub fn str_bytes(s: str) -> Vec {
    val result: Vec = Vec::new();
    val slen: i64 = String_len(s);
    val i: i64 = 0;
    while i < slen {
        val addr: i64 = s + i;
        val ptr: *mut u8 = addr;
        val b: i64 = 0;
        unsafe { b = *ptr; }
        result.push(b);
        i = i + 1;
    }
    return result;
}

/// Build a string from a Vec of byte values.
pub fn str_from_bytes(bytes: Vec) -> str {
    val result: str = "";
    val i: i64 = 0;
    val n: i64 = bytes.len();
    while i < n {
        result = p_str_concat(result, p_char_to_str(bytes.get(i)));
        i = i + 1;
    }
    return result;
}

/// Get a substring by byte range [start, end).
pub fn str_slice(s: str, start: i64, end: i64) -> str {
    val slen: i64 = String_len(s);
    val s0: i64 = start;
    val e0: i64 = end;
    if s0 < 0 { s0 = 0; }
    if e0 > slen { e0 = slen; }
    if s0 >= e0 { return ""; }
    return String_slice(s, s0, e0);
}

/// Check if a string starts with a prefix.
pub fn str_starts_with(s: str, prefix: str) -> bool {
    return String_starts_with(s, prefix);
}

/// Check if a string ends with a suffix.
pub fn str_ends_with(s: str, suffix: str) -> bool {
    return String_ends_with(s, suffix);
}

/// Check if a string contains a substring.
pub fn str_contains(s: str, sub: str) -> bool {
    return String_contains(s, sub);
}

/// Find the first index of a substring, or -1 if not found.
pub fn str_find(s: str, sub: str) -> i64 {
    return String_find(s, sub);
}

/// Find the last index of a substring, or -1 if not found.
pub fn str_rfind(s: str, sub: str) -> i64 {
    return String_rfind(s, sub);
}

/// Trim leading whitespace from a string.
pub fn str_trim_start(s: str) -> str {
    val slen: i64 = String_len(s);
    val i: i64 = 0;
    while i < slen {
        val addr: i64 = s + i;
        val ptr: *mut u8 = addr;
        val b: i64 = 0;
        unsafe { b = *ptr; }
        if !char_is_whitespace(b) { break; }
        i = i + 1;
    }
    if i >= slen { return ""; }
    return String_slice(s, i, slen);
}

/// Trim trailing whitespace from a string.
pub fn str_trim_end(s: str) -> str {
    val slen: i64 = String_len(s);
    val end: i64 = slen;
    while end > 0 {
        val addr: i64 = s + end - 1;
        val ptr: *mut u8 = addr;
        val b: i64 = 0;
        unsafe { b = *ptr; }
        if !char_is_whitespace(b) { break; }
        end = end - 1;
    }
    if end <= 0 { return ""; }
    return String_slice(s, 0, end);
}

/// Trim both leading and trailing whitespace.
pub fn str_trim(s: str) -> str {
    return String_trim(s);
}

/// Split a string by delimiter, returning a Vec of string parts.
pub fn str_split(s: str, delim: str) -> Vec {
    val result: Vec = Vec::new();
    if String_len(delim) == 0 {
        result.push(s);
        return result;
    }
    val start: i64 = 0;
    val s_len: i64 = String_len(s);
    val dlen: i64 = String_len(delim);
    val pos: i64 = 0;
    while pos <= s_len - dlen {
        val matched: bool = true;
        val j: i64 = 0;
        while j < dlen {
            val s_addr: i64 = s + pos + j;
            val d_addr: i64 = delim + j;
            val s_ptr: *mut u8 = s_addr;
            val d_ptr: *mut u8 = d_addr;
            val sb: i64 = 0;
            val db: i64 = 0;
            unsafe { sb = *s_ptr; db = *d_ptr; }
            if sb != db { matched = false; break; }
            j = j + 1;
        }
        if matched {
            result.push(String_slice(s, start, pos));
            start = pos + dlen;
            pos = start;
        } else {
            pos = pos + 1;
        }
    }
    result.push(String_slice(s, start, s_len));
    return result;
}

/// Split a string by a single character delimiter, returning a Vec of parts.
/// Faster than str_split for single-char delimiters.
pub fn str_split_char(s: str, delim: i64) -> Vec {
    val result: Vec = Vec::new();
    val start: i64 = 0;
    val s_len: i64 = String_len(s);
    val i: i64 = 0;
    while i < s_len {
        val addr: i64 = s + i;
        val ptr: *mut u8 = addr;
        val b: i64 = 0;
        unsafe { b = *ptr; }
        if b == delim {
            result.push(String_slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    result.push(String_slice(s, start, s_len));
    return result;
}

/// Replace all occurrences of `from` with `to` in a string.
pub fn str_replace(s: str, from: str, to: str) -> str {
    return String_replace(s, from, to);
}

/// Repeat a string n times.
pub fn str_repeat(s: str, n: i64) -> str {
    return String_repeat(s, n);
}

/// Convert a string to uppercase.
pub fn str_to_upper(s: str) -> str {
    return String_to_uppercase(s);
}

/// Convert a string to lowercase.
pub fn str_to_lower(s: str) -> str {
    return String_to_lowercase(s);
}

/// Parse a decimal integer from a string. Returns 0 on failure.
pub fn str_parse_int(s: str) -> i64 {
    return String_parse_int(s);
}

/// Parse a hexadecimal integer from a string. Supports optional "0x" prefix.
/// Returns 0 on failure.
pub fn str_parse_hex(s: str) -> i64 {
    val slen: i64 = String_len(s);
    if slen == 0 { return 0; }
    val i: i64 = 0;
    val result: i64 = 0;
    val negative: bool = false;
    // Skip leading whitespace
    while i < slen {
        val addr: i64 = s + i;
        val ptr: *mut u8 = addr;
        val b: i64 = 0;
        unsafe { b = *ptr; }
        if !char_is_whitespace(b) { break; }
        i = i + 1;
    }
    if i >= slen { return 0; }
    // Check sign
    val addr0: i64 = s + i;
    val ptr0: *mut u8 = addr0;
    val c0: i64 = 0;
    unsafe { c0 = *ptr0; }
    if c0 == 45 { negative = true; i = i + 1; }
    else if c0 == 43 { i = i + 1; }
    // Check for 0x prefix
    if i + 1 < slen {
        val a1: i64 = s + i;
        val p1: *mut u8 = a1;
        val c1: i64 = 0;
        unsafe { c1 = *p1; }
        val a2: i64 = s + i + 1;
        val p2: *mut u8 = a2;
        val c2: i64 = 0;
        unsafe { c2 = *p2; }
        if c1 == 48 && (c2 == 120 || c2 == 88) { i = i + 2; }
    }
    // Parse hex digits
    while i < slen {
        val addr: i64 = s + i;
        val ptr: *mut u8 = addr;
        val b: i64 = 0;
        unsafe { b = *ptr; }
        val digit: i64 = -1;
        if b >= 48 && b <= 57 { digit = b - 48; }
        else if b >= 65 && b <= 70 { digit = b - 55; }
        else if b >= 97 && b <= 102 { digit = b - 87; }
        else { break; }
        result = result * 16 + digit;
        i = i + 1;
    }
    if negative { result = 0 - result; }
    return result;
}

/// Parse an integer from a substring [start, end) of a string.
/// Useful for the lexer which has already extracted digit positions.
pub fn str_parse_int_range(s: str, start: i64, end: i64) -> i64 {
    val slen: i64 = String_len(s);
    val s0: i64 = start;
    val e0: i64 = end;
    if s0 < 0 { s0 = 0; }
    if e0 > slen { e0 = slen; }
    if s0 >= e0 { return 0; }
    val result: i64 = 0;
    val i: i64 = s0;
    while i < e0 {
        val addr: i64 = s + i;
        val ptr: *mut u8 = addr;
        val b: i64 = 0;
        unsafe { b = *ptr; }
        if b < 48 || b > 57 { break; }
        result = result * 10 + (b - 48);
        i = i + 1;
    }
    return result;
}

/// Get the byte at a given index, or -1 if out of bounds.
pub fn str_byte_at(s: str, idx: i64) -> i64 {
    return String_byte_at(s, idx);
}

/// Get the length of a string in bytes.
pub fn str_len(s: str) -> i64 {
    return String_len(s);
}

/// Check if a string is empty.
pub fn str_is_empty(s: str) -> bool {
    return String_is_empty(s);
}

/// Concatenate two strings.
pub fn str_concat(a: str, b: str) -> str {
    return p_str_concat(a, b);
}

/// Compare two strings. Returns 0 if equal, negative if a < b, positive if a > b.
pub fn str_compare(a: str, b: str) -> i64 {
    return p_str_compare(a, b);
}

/// Check if two strings are equal.
pub fn str_equal(a: str, b: str) -> bool {
    return p_str_equal(a, b);
}

/// Convert an integer to a string.
pub fn int_to_str(n: i64) -> str {
    return p_to_str(n);
}

/// Convert a byte value to a single-character string.
pub fn byte_to_str(b: i64) -> str {
    return p_char_to_str(b);
}
