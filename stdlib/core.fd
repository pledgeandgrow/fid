// Pledge core standard library — Phase 2
// Auto-included by the compiler. All items are pub.

module core;

// Builtin: print — outputs to stdout
// (Implemented natively in the compiler for Phase 1)

// Builtin: println — print with newline
pub pf println(s: str) -> void {
    print(s);
    print("\n");
}

// Builtin: assert — crash if condition is false
pub pf assert(cond: bool) -> void {
    if !cond {
        print("Assertion failed\n");
    }
}

// Builtin: assert_eq — check equality
pub pf assert_eq<T>(a: T, b: T) -> void {
    if a != b {
        print("Assertion failed: values not equal\n");
    }
}

// ─── Option<T> ──────────────────────────────────────────────────────────
// Represents an optional value: either Some(value) or None.
// Generic over T — the inner value type. Uses uniform i64 representation.

pub enum Option<T> {
    Some(i64),
    None,
}

impl Option {
    pub pf is_some(self: Option) -> bool {
        match self {
            Option::Some(v: i64) => { ret true; }
            Option::None => { ret false; }
        }
    }

    pub pf is_none(self: Option) -> bool {
        match self {
            Option::Some(v: i64) => { ret false; }
            Option::None => { ret true; }
        }
    }

    pub pf unwrap(self: Option) -> i64 {
        match self {
            Option::Some(v: i64) => { ret v; }
            Option::None => {
                p_panic("called unwrap on None");
            }
        }
    }

    pub pf unwrap_or(self: Option, default: i64) -> i64 {
        match self {
            Option::Some(v: i64) => { ret v; }
            Option::None => { ret default; }
        }
    }

    pub pf map(self: Option, f: pf(i64) -> i64) -> Option {
        match self {
            Option::Some(v: i64) => { ret Option::Some(f(v)); }
            Option::None => { ret Option::None; }
        }
    }

    pub pf and_then(self: Option, f: pf(i64) -> i64) -> Option {
        match self {
            Option::Some(v: i64) => { ret Option::Some(f(v)); }
            Option::None => { ret Option::None; }
        }
    }

    pub pf or_else(self: Option, default: pf() -> i64) -> Option {
        match self {
            Option::Some(v: i64) => { ret Option::Some(v); }
            Option::None => { ret Option::Some(default()); }
        }
    }

    pub pf unwrap_or_else(self: Option, default: pf() -> i64) -> i64 {
        match self {
            Option::Some(v: i64) => { ret v; }
            Option::None => { ret default(); }
        }
    }

    pub pf expect(self: Option, msg: str) -> i64 {
        match self {
            Option::Some(v: i64) => { ret v; }
            Option::None => {
                p_panic(msg);
            }
        }
    }
}

// ─── Result<T, E> ───────────────────────────────────────────────────────
// Represents a result: either Ok(value) or Err(error).
// Generic over T (value type) and E (error type). Uses uniform i64 representation.

pub enum Result<T, E> {
    Ok(i64),
    Err(i64),
}

impl Result {
    pub pf is_ok(self: Result) -> bool {
        match self {
            Result::Ok(v: i64) => { ret true; }
            Result::Err(e: i64) => { ret false; }
        }
    }

    pub pf is_err(self: Result) -> bool {
        match self {
            Result::Ok(v: i64) => { ret false; }
            Result::Err(e: i64) => { ret true; }
        }
    }

    pub pf unwrap(self: Result) -> i64 {
        match self {
            Result::Ok(v: i64) => { ret v; }
            Result::Err(e: i64) => {
                p_panic("called unwrap on Err");
            }
        }
    }

    pub pf unwrap_or(self: Result, default: i64) -> i64 {
        match self {
            Result::Ok(v: i64) => { ret v; }
            Result::Err(e: i64) => { ret default; }
        }
    }

    pub pf ok(self: Result) -> Option {
        match self {
            Result::Ok(v: i64) => { ret Option::Some(v); }
            Result::Err(e: i64) => { ret Option::None; }
        }
    }

    pub pf err(self: Result) -> Option {
        match self {
            Result::Ok(v: i64) => { ret Option::None; }
            Result::Err(e: i64) => { ret Option::Some(e); }
        }
    }

    pub pf map(self: Result, f: pf(i64) -> i64) -> Result {
        match self {
            Result::Ok(v: i64) => { ret Result::Ok(f(v)); }
            Result::Err(e: i64) => { ret Result::Err(e); }
        }
    }

    pub pf map_err(self: Result, f: pf(i64) -> i64) -> Result {
        match self {
            Result::Ok(v: i64) => { ret Result::Ok(v); }
            Result::Err(e: i64) => { ret Result::Err(f(e)); }
        }
    }

    pub pf and_then(self: Result, f: pf(i64) -> i64) -> Result {
        match self {
            Result::Ok(v: i64) => { ret Result::Ok(f(v)); }
            Result::Err(e: i64) => { ret Result::Err(e); }
        }
    }

    pub pf unwrap_or_else(self: Result, default: pf() -> i64) -> i64 {
        match self {
            Result::Ok(v: i64) => { ret v; }
            Result::Err(e: i64) => { ret default(); }
        }
    }

    pub pf expect(self: Result, msg: str) -> i64 {
        match self {
            Result::Ok(v: i64) => { ret v; }
            Result::Err(e: i64) => {
                p_panic(msg);
            }
        }
    }
}

// ─── Utility functions ──────────────────────────────────────────────────

pub pf max(a: i64, b: i64) -> i64 {
    if a > b { ret a; }
    ret b;
}

pub pf min(a: i64, b: i64) -> i64 {
    if a < b { ret a; }
    ret b;
}

pub pf abs(n: i64) -> i64 {
    if n < 0 { ret -n; }
    ret n;
}

pub pf clamp(n: i64, lo: i64, hi: i64) -> i64 {
    if n < lo { ret lo; }
    if n > hi { ret hi; }
    ret n;
}

// ─── Allocator (Phase 2A.8) ───
// Explicit allocator-as-parameter, like Zig, but verified at compile time.
// Functions that declare !Alloc must take an Allocator parameter.

// Builtin: p_allocator_create — create a named allocator
// Builtin: p_allocator_alloc — allocate memory from an allocator
// Builtin: p_allocator_free — free memory back to an allocator
// Builtin: p_allocator_stats — get allocation stats (bytes allocated)

pub pf create_allocator(name: str) -> Allocator {
    ret p_allocator_create(name);
}

pub pf allocator_alloc(alloc: &Allocator, size: i64) -> i64 {
    ret p_allocator_alloc(alloc, size);
}

pub pf allocator_free(alloc: &Allocator, ptr: i64) -> void {
    p_allocator_free(alloc, ptr);
}

pub pf allocator_bytes_used(alloc: &Allocator) -> i64 {
    ret p_allocator_stats(alloc);
}

// ─── Iterator capability (Phase 7.7) ───────────────────────────────────
// The Iterator cap defines the interface for lazy iteration.
// Types implementing Iterator can be used in for loops.
// Note: Built-in types (Vec, Range, HashMap) have compiler-level iterator
// support. Custom types can implement this cap to work with for loops.

pub cap Iterator {
    ty Item;
    pf next(self: Self) -> Option<Self::Item>;
}

// ─── Error trait (Phase 7.7) ───────────────────────────────────────────
// The Error cap defines the interface for custom error types.
// Any type implementing Error can be used as the E in Result<T, E>.

pub cap Error {
    pf message(self: Self) -> str;
}

// ─── Vec<T> (Phase 10B) ─────────────────────────────────────────────────
// Dynamic array with amortized O(1) push/pop.
// Implemented in pure Fides using raw pointers — no compiler builtins.
//
// Internal layout: 24-byte heap block { data: *i64, len: i64, capacity: i64 }
// The Vec value is an i64 pointer to this block.
// Element data is a separate heap allocation of capacity * 8 bytes.
//
// All functions take the Vec as i64 (the pointer to the block).
// Mutation is in-place through the pointer — no return-and-reassign needed.

pub pf Vec_new() -> i64 {
    pv ptr: i64 = p_malloc(24);
    pv p0: *mut i64 = ptr;
    pv p8: *mut i64 = ptr + 8;
    pv p16: *mut i64 = ptr + 16;
    unsafe {
        *p0 = 0;
        *p8 = 0;
        *p16 = 0;
    }
    ret ptr;
}

pub pf Vec_push(v: i64, val: i64) {
    pv len_ptr: *mut i64 = v + 8;
    pv cap_ptr: *mut i64 = v + 16;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    pm capacity: i64;
    pm data: i64;

    unsafe {
        len = *len_ptr;
        capacity = *cap_ptr;
        data = *data_ptr_ptr;
    }

    if len >= capacity {
        pv new_capacity: i64 = 8;
        if capacity > 0 {
            new_capacity = capacity * 2;
        }
        pv new_data: i64 = p_malloc(new_capacity * 8);

        pv i: i64 = 0;
        while i < len {
            pv src_addr: i64 = data + i * 8;
            pv src_ptr: *mut i64 = src_addr;
            pv dst_addr: i64 = new_data + i * 8;
            pv dst_ptr: *mut i64 = dst_addr;
            unsafe {
                pv old_val: i64 = *src_ptr;
                *dst_ptr = old_val;
            }
            i = i + 1;
        }

        if data != 0 {
            p_free(data);
        }

        unsafe {
            *data_ptr_ptr = new_data;
            *cap_ptr = new_capacity;
        }
    }

    unsafe {
        data = *data_ptr_ptr;
    }

    pv addr: i64 = data + len * 8;
    pv elem_ptr: *mut i64 = addr;
    unsafe {
        *elem_ptr = val;
    }

    pv new_len: i64 = len + 1;
    unsafe {
        *len_ptr = new_len;
    }
}

pub pf Vec_pop(v: i64) -> i64 {
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    if len == 0 {
        ret 0;
    }

    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    pv addr: i64 = data + (len - 1) * 8;
    pv elem_ptr: *mut i64 = addr;
    pm result: i64;
    unsafe {
        result = *elem_ptr;
    }

    pv new_len: i64 = len - 1;
    unsafe {
        *len_ptr = new_len;
    }

    ret result;
}

pub pf Vec_len(v: i64) -> i64 {
    pv len_ptr: *mut i64 = v + 8;
    pm result: i64;
    unsafe {
        result = *len_ptr;
    }
    ret result;
}

pub pf Vec_is_empty(v: i64) -> bool {
    pv len_ptr: *mut i64 = v + 8;
    pm len: i64;
    unsafe {
        len = *len_ptr;
    }
    ret len == 0;
}

pub pf Vec_get(v: i64, idx: i64) -> i64 {
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    if idx >= len {
        p_panic("Vec index out of bounds");
    }
    if idx < 0 {
        p_panic("Vec index out of bounds");
    }

    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    pv addr: i64 = data + idx * 8;
    pv ptr: *mut i64 = addr;
    pv result: i64 = 0;
    unsafe {
        result = *ptr;
    }
    ret result;
}

pub pf Vec_set(v: i64, idx: i64, val: i64) {
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    if idx >= len {
        p_panic("Vec index out of bounds");
    }
    if idx < 0 {
        p_panic("Vec index out of bounds");
    }

    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    pv addr: i64 = data + idx * 8;
    pv ptr: *mut i64 = addr;
    unsafe {
        *ptr = val;
    }
}

pub pf Vec_clear(v: i64) {
    pv len_ptr: *mut i64 = v + 8;
    unsafe {
        *len_ptr = 0;
    }
}

pub pf Vec_capacity(v: i64) -> i64 {
    pv cap_ptr: *mut i64 = v + 16;
    pm result: i64;
    unsafe {
        result = *cap_ptr;
    }
    ret result;
}

pub pf Vec_contains(v: i64, val: i64) -> bool {
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    pv i: i64 = 0;
    while i < len {
        pv addr: i64 = data + i * 8;
        pv ptr: *mut i64 = addr;
        pv elem: i64 = 0;
        unsafe {
            elem = *ptr;
        }
        if elem == val {
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

pub pf Vec_first(v: i64) -> i64 {
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    if len == 0 {
        p_panic("Vec is empty");
    }

    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    pv ptr: *mut i64 = data;
    pv result: i64 = 0;
    unsafe {
        result = *ptr;
    }
    ret result;
}

pub pf Vec_last(v: i64) -> i64 {
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    if len == 0 {
        p_panic("Vec is empty");
    }

    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    pv addr: i64 = data + (len - 1) * 8;
    pv ptr: *mut i64 = addr;
    pv result: i64 = 0;
    unsafe {
        result = *ptr;
    }
    ret result;
}

pub pf Vec_truncate(v: i64, n: i64) {
    pv len_ptr: *mut i64 = v + 8;
    pm len: i64;
    unsafe {
        len = *len_ptr;
    }
    if n < len {
        unsafe {
            *len_ptr = n;
        }
    }
}

pub pf Vec_reverse(v: i64) {
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    pv i: i64 = 0;
    while i < len / 2 {
        pv lo_addr: i64 = data + i * 8;
        pv hi_addr: i64 = data + (len - 1 - i) * 8;
        pv lo_ptr: *mut i64 = lo_addr;
        pv hi_ptr: *mut i64 = hi_addr;
        unsafe {
            pv lo_val: i64 = *lo_ptr;
            pv hi_val: i64 = *hi_ptr;
            *lo_ptr = hi_val;
            *hi_ptr = lo_val;
        }
        i = i + 1;
    }
}

pub pf Vec_extend(v: i64, other: i64) {
    pv other_len_ptr: *mut i64 = other + 8;
    pv other_data_ptr_ptr: *mut i64 = other;

    pm other_len: i64;
    unsafe {
        other_len = *other_len_ptr;
    }

    pm other_data: i64;
    unsafe {
        other_data = *other_data_ptr_ptr;
    }

    pv i: i64 = 0;
    while i < other_len {
        pv addr: i64 = other_data + i * 8;
        pv ptr: *mut i64 = addr;
        pv elem: i64 = 0;
        unsafe {
            elem = *ptr;
        }
        Vec_push(v, elem);
        i = i + 1;
    }
}

pub pf Vec_insert(v: i64, idx: i64, val: i64) {
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    if idx < 0 {
        p_panic("Vec insert index out of bounds");
    }
    if idx > len {
        p_panic("Vec insert index out of bounds");
    }

    // Push a dummy to grow if needed, then shift elements right
    Vec_push(v, 0);

    // Re-read len and data (push may have reallocated)
    unsafe {
        len = *len_ptr;
    }
    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    // Shift elements right from end to idx
    pv i: i64 = len - 1;
    while i > idx {
        pv cur_addr: i64 = data + i * 8;
        pv prev_addr: i64 = data + (i - 1) * 8;
        pv cur_ptr: *mut i64 = cur_addr;
        pv prev_ptr: *mut i64 = prev_addr;
        unsafe {
            pv prev_val: i64 = *prev_ptr;
            *cur_ptr = prev_val;
        }
        i = i - 1;
    }

    // Store the new value at idx
    pv addr: i64 = data + idx * 8;
    pv ptr: *mut i64 = addr;
    unsafe {
        *ptr = val;
    }
}

pub pf Vec_remove(v: i64, idx: i64) -> i64 {
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    if idx < 0 {
        p_panic("Vec remove index out of bounds");
    }
    if idx >= len {
        p_panic("Vec remove index out of bounds");
    }

    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    // Get the value at idx
    pv addr: i64 = data + idx * 8;
    pv ptr: *mut i64 = addr;
    pv result: i64 = 0;
    unsafe {
        result = *ptr;
    }

    // Shift elements left
    pv i: i64 = idx;
    while i < len - 1 {
        pv cur_addr: i64 = data + i * 8;
        pv next_addr: i64 = data + (i + 1) * 8;
        pv cur_ptr: *mut i64 = cur_addr;
        pv next_ptr: *mut i64 = next_addr;
        unsafe {
            pv next_val: i64 = *next_ptr;
            *cur_ptr = next_val;
        }
        i = i + 1;
    }

    // Decrement len
    pv new_len: i64 = len - 1;
    unsafe {
        *len_ptr = new_len;
    }

    ret result;
}

pub pf Vec_clone(v: i64) -> i64 {
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    pv new_v: i64 = Vec_new();
    pv i: i64 = 0;
    while i < len {
        pv addr: i64 = data + i * 8;
        pv ptr: *mut i64 = addr;
        pv elem: i64 = 0;
        unsafe {
            elem = *ptr;
        }
        Vec_push(new_v, elem);
        i = i + 1;
    }
    ret new_v;
}

pub pf Vec_to_str(v: i64) -> str {
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    // Build string: "[1, 2, 3]"
    pv result: str = "[";
    pv i: i64 = 0;
    while i < len {
        if i > 0 {
            result = p_str_concat(result, ", ");
        }
        pv addr: i64 = data + i * 8;
        pv ptr: *mut i64 = addr;
        pv elem: i64 = 0;
        unsafe {
            elem = *ptr;
        }
        result = p_str_concat(result, p_to_str(elem));
        i = i + 1;
    }
    result = p_str_concat(result, "]");
    ret result;
}

pub pf Vec_sort(v: i64) {
    // Simple bubble sort
    pv len_ptr: *mut i64 = v + 8;
    pv data_ptr_ptr: *mut i64 = v;

    pm len: i64;
    unsafe {
        len = *len_ptr;
    }

    pm data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    if len <= 1 {
        ret;
    }

    pv swapped: bool = true;
    while swapped {
        swapped = false;
        pv i: i64 = 0;
        while i < len - 1 {
            pv addr0: i64 = data + i * 8;
            pv addr1: i64 = data + (i + 1) * 8;
            pv ptr0: *mut i64 = addr0;
            pv ptr1: *mut i64 = addr1;
            unsafe {
                pv v0: i64 = *ptr0;
                pv v1: i64 = *ptr1;
                if v0 > v1 {
                    *ptr0 = v1;
                    *ptr1 = v0;
                    swapped = true;
                }
            }
            i = i + 1;
        }
    }
}

// ─── HashMap (Phase 10B) ────────────────────────────────────────────────
// Open-addressing hash map with linear probing.
// Keys are string pointers (i64 addresses to null-terminated strings).
// Values are i64.
//
// Internal layout: 32-byte heap block:
//   offset  0: keys_ptr  (*i64)  — array of key pointers (0 = empty, -1 = tombstone)
//   offset  8: vals_ptr  (*i64)  — array of values
//   offset 16: len        (i64)   — number of live entries
//   offset 24: capacity   (i64)   — size of keys/vals arrays

// FNV-1a hash of a null-terminated string. s is an i64 address.
@wrapping pf p_str_hash(s: i64) -> i64 {
    pv hash: i64 = -3750763034362895579;
    pv addr: i64 = s;
    pv byte_ptr: *mut u8 = addr;
    unsafe {
        pv b: i64 = *byte_ptr;
        while b != 0 {
            hash = hash ^ b;
            hash = hash * 1099511628211;
            addr = addr + 1;
            byte_ptr = addr;
            b = *byte_ptr;
        }
    }
    if hash < 0 { ret -hash; }
    ret hash;
}

// String equality: compare two null-terminated strings byte by byte.
// a and b are i64 addresses.
pf p_str_equal(a: i64, b: i64) -> bool {
    if a == b { ret true; }
    if a == 0 { ret false; }
    if b == 0 { ret false; }
    pv ai: i64 = a;
    pv bi: i64 = b;
    pv pa: *mut u8 = ai;
    pv pb: *mut u8 = bi;
    unsafe {
        pv ca: i64 = *pa;
        pv cb: i64 = *pb;
        while ca != 0 && cb != 0 {
            if ca != cb { ret false; }
            ai = ai + 1;
            bi = bi + 1;
            pa = ai;
            pb = bi;
            ca = *pa;
            cb = *pb;
        }
        ret ca == cb;
    }
}

// Compare two null-terminated strings (i64 addresses).
// Returns <0 if a<b, 0 if equal, >0 if a>b (lexicographic).
pf p_str_compare(a: i64, b: i64) -> i64 {
    if a == b { ret 0; }
    if a == 0 { ret -1; }
    if b == 0 { ret 1; }
    pv ai: i64 = a;
    pv bi: i64 = b;
    pv pa: *mut u8 = ai;
    pv pb: *mut u8 = bi;
    unsafe {
        pv ca: i64 = *pa;
        pv cb: i64 = *pb;
        while ca != 0 && cb != 0 {
            if ca != cb { ret ca - cb; }
            ai = ai + 1;
            bi = bi + 1;
            pa = ai;
            pb = bi;
            ca = *pa;
            cb = *pb;
        }
        ret ca - cb;
    }
}

pub pf HashMap_new() -> i64 {
    pv ptr: i64 = p_malloc(32);
    pv p0: *mut i64 = ptr;
    pv p8: *mut i64 = ptr + 8;
    pv p16: *mut i64 = ptr + 16;
    pv p24: *mut i64 = ptr + 24;
    unsafe {
        *p0 = 0;
        *p8 = 0;
        *p16 = 0;
        *p24 = 0;
    }
    ret ptr;
}

// Find the slot index for a key. Returns the index of the key if found,
// or the first empty/tombstone slot if not found.
pf HashMap_find_slot(m: i64, key: i64) -> i64 {
    pv cap_ptr: *mut i64 = m + 24;
    pv keys_ptr_ptr: *mut i64 = m;
    pv capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { ret 0; }
    pv keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    pv hash_val: i64 = p_str_hash(key);
    pv idx: i64 = hash_val % capacity;
    pv first_tombstone: i64 = -1;
    pv i: i64 = 0;
    while i < capacity {
        pv key_addr: i64 = keys + idx * 8;
        pv key_ptr: *mut i64 = key_addr;
        pv slot_key: i64 = 0;
        unsafe {
            slot_key = *key_ptr;
        }
        if slot_key == 0 {
            if first_tombstone >= 0 { ret first_tombstone; }
            ret idx;
        }
        if slot_key == -1 {
            if first_tombstone < 0 { first_tombstone = idx; }
        } else if p_str_equal(slot_key, key) {
            ret idx;
        }
        idx = idx + 1;
        if idx >= capacity { idx = 0; }
        i = i + 1;
    }
    if first_tombstone >= 0 { ret first_tombstone; }
    ret 0;
}

@wrapping pf HashMap_grow(m: i64) {
    pv cap_ptr: *mut i64 = m + 24;
    pv keys_ptr_ptr: *mut i64 = m;
    pv vals_ptr_ptr: *mut i64 = m + 8;
    pv len_ptr: *mut i64 = m + 16;

    pv old_capacity: i64 = 0;
    pv old_keys: i64 = 0;
    pv old_vals: i64 = 0;
    unsafe {
        old_capacity = *cap_ptr;
        old_keys = *keys_ptr_ptr;
        old_vals = *vals_ptr_ptr;
    }

    pv new_capacity: i64 = 8;
    if old_capacity > 0 { new_capacity = old_capacity * 2; }

    pv new_keys: i64 = p_malloc(new_capacity * 8);
    pv new_vals: i64 = p_malloc(new_capacity * 8);

    // Initialize new arrays to 0
    pv i: i64 = 0;
    while i < new_capacity {
        pv kaddr: i64 = new_keys + i * 8;
        pv kptr: *mut i64 = kaddr;
        pv vaddr: i64 = new_vals + i * 8;
        pv vptr: *mut i64 = vaddr;
        unsafe {
            *kptr = 0;
            *vptr = 0;
        }
        i = i + 1;
    }

    // Rehash all entries
    pv count: i64 = 0;
    pv old_i: i64 = 0;
    while old_i < old_capacity {
        pv old_kaddr: i64 = old_keys + old_i * 8;
        pv old_kptr: *mut i64 = old_kaddr;
        pv old_key: i64 = 0;
        unsafe {
            old_key = *old_kptr;
        }
        if old_key != 0 && old_key != -1 {
            pv old_vaddr: i64 = old_vals + old_i * 8;
            pv old_vptr: *mut i64 = old_vaddr;
            pv old_val: i64 = 0;
            unsafe {
                old_val = *old_vptr;
            }
            // Insert into new arrays
            pv hash_val: i64 = p_str_hash(old_key);
            pv new_idx: i64 = hash_val % new_capacity;
            pv probe: i64 = 0;
            while probe < new_capacity {
                pv nkaddr: i64 = new_keys + new_idx * 8;
                pv nkptr: *mut i64 = nkaddr;
                pv nk: i64 = 0;
                unsafe {
                    nk = *nkptr;
                }
                if nk == 0 {
                    unsafe {
                        *nkptr = old_key;
                    }
                    pv nvaddr: i64 = new_vals + new_idx * 8;
                    pv nvptr: *mut i64 = nvaddr;
                    unsafe {
                        *nvptr = old_val;
                    }
                    break;
                }
                new_idx = new_idx + 1;
                if new_idx >= new_capacity { new_idx = 0; }
                probe = probe + 1;
            }
            count = count + 1;
        }
        old_i = old_i + 1;
    }

    if old_keys != 0 { p_free(old_keys); }
    if old_vals != 0 { p_free(old_vals); }

    unsafe {
        *keys_ptr_ptr = new_keys;
        *vals_ptr_ptr = new_vals;
        *len_ptr = count;
        *cap_ptr = new_capacity;
    }
}

pub pf HashMap_insert(m: i64, key: i64, val: i64) {
    pv len_ptr: *mut i64 = m + 16;
    pv cap_ptr: *mut i64 = m + 24;

    pv len: i64 = 0;
    pv capacity: i64 = 0;
    unsafe {
        len = *len_ptr;
        capacity = *cap_ptr;
    }

    // Grow if load factor > 0.7
    if capacity == 0 || len * 10 >= capacity * 7 {
        HashMap_grow(m);
        unsafe {
            capacity = *cap_ptr;
        }
    }

    pv idx: i64 = HashMap_find_slot(m, key);

    pv keys_ptr_ptr: *mut i64 = m;
    pv vals_ptr_ptr: *mut i64 = m + 8;
    pv keys: i64 = 0;
    pv vals: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
        vals = *vals_ptr_ptr;
    }

    pv kaddr: i64 = keys + idx * 8;
    pv kptr: *mut i64 = kaddr;
    pv existing_key: i64 = 0;
    unsafe {
        existing_key = *kptr;
    }

    if existing_key == 0 || existing_key == -1 {
        unsafe {
            *kptr = key;
        }
        pv vaddr: i64 = vals + idx * 8;
        pv vptr: *mut i64 = vaddr;
        unsafe {
            *vptr = val;
        }
        pv new_len: i64 = len + 1;
        unsafe {
            *len_ptr = new_len;
        }
    } else {
        pv vaddr: i64 = vals + idx * 8;
        pv vptr: *mut i64 = vaddr;
        unsafe {
            *vptr = val;
        }
    }
}

pub pf HashMap_get(m: i64, key: i64) -> i64 {
    pv cap_ptr: *mut i64 = m + 24;
    pv capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { ret 0; }

    pv idx: i64 = HashMap_find_slot(m, key);
    pv keys_ptr_ptr: *mut i64 = m;
    pv keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    pv kaddr: i64 = keys + idx * 8;
    pv kptr: *mut i64 = kaddr;
    pv slot_key: i64 = 0;
    unsafe {
        slot_key = *kptr;
    }
    if slot_key == 0 || slot_key == -1 { ret 0; }

    pv vals_ptr_ptr: *mut i64 = m + 8;
    pv vals: i64 = 0;
    unsafe {
        vals = *vals_ptr_ptr;
    }
    pv vaddr: i64 = vals + idx * 8;
    pv vptr: *mut i64 = vaddr;
    pv result: i64 = 0;
    unsafe {
        result = *vptr;
    }
    ret result;
}

pub pf HashMap_contains(m: i64, key: i64) -> bool {
    pv cap_ptr: *mut i64 = m + 24;
    pv capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { ret false; }

    pv idx: i64 = HashMap_find_slot(m, key);
    pv keys_ptr_ptr: *mut i64 = m;
    pv keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    pv kaddr: i64 = keys + idx * 8;
    pv kptr: *mut i64 = kaddr;
    pv slot_key: i64 = 0;
    unsafe {
        slot_key = *kptr;
    }
    ret slot_key != 0 && slot_key != -1;
}

pub pf HashMap_remove(m: i64, key: i64) {
    pv cap_ptr: *mut i64 = m + 24;
    pv len_ptr: *mut i64 = m + 16;
    pv capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { ret; }

    pv idx: i64 = HashMap_find_slot(m, key);
    pv keys_ptr_ptr: *mut i64 = m;
    pv keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    pv kaddr: i64 = keys + idx * 8;
    pv kptr: *mut i64 = kaddr;
    pv slot_key: i64 = 0;
    unsafe {
        slot_key = *kptr;
    }
    if slot_key == 0 || slot_key == -1 { ret; }

    unsafe {
        *kptr = -1;
    }
    pv len: i64 = 0;
    unsafe {
        len = *len_ptr;
    }
    pv new_len: i64 = len - 1;
    unsafe {
        *len_ptr = new_len;
    }
}

pub pf HashMap_len(m: i64) -> i64 {
    pv len_ptr: *mut i64 = m + 16;
    pv result: i64 = 0;
    unsafe {
        result = *len_ptr;
    }
    ret result;
}

pub pf HashMap_is_empty(m: i64) -> bool {
    pv len_ptr: *mut i64 = m + 16;
    pv len: i64 = 0;
    unsafe {
        len = *len_ptr;
    }
    ret len == 0;
}

pub pf HashMap_clear(m: i64) {
    pv len_ptr: *mut i64 = m + 16;
    unsafe {
        *len_ptr = 0;
    }
    pv keys_ptr_ptr: *mut i64 = m;
    pv cap_ptr: *mut i64 = m + 24;
    pv keys: i64 = 0;
    pv capacity: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
        capacity = *cap_ptr;
    }
    if keys != 0 && capacity > 0 {
        pv i: i64 = 0;
        while i < capacity {
            pv kaddr: i64 = keys + i * 8;
            pv kptr: *mut i64 = kaddr;
            unsafe {
                *kptr = 0;
            }
            i = i + 1;
        }
    }
}

pub pf HashMap_keys(m: i64) -> i64 {
    pv cap_ptr: *mut i64 = m + 24;
    pv keys_ptr_ptr: *mut i64 = m;
    pv capacity: i64 = 0;
    pv keys: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
        keys = *keys_ptr_ptr;
    }
    pv result: i64 = Vec_new();
    if keys == 0 || capacity == 0 { ret result; }
    pv i: i64 = 0;
    while i < capacity {
        pv kaddr: i64 = keys + i * 8;
        pv kptr: *mut i64 = kaddr;
        pv slot_key: i64 = 0;
        unsafe {
            slot_key = *kptr;
        }
        if slot_key != 0 && slot_key != -1 {
            Vec_push(result, slot_key);
        }
        i = i + 1;
    }
    ret result;
}

pub pf HashMap_values(m: i64) -> i64 {
    pv cap_ptr: *mut i64 = m + 24;
    pv keys_ptr_ptr: *mut i64 = m;
    pv vals_ptr_ptr: *mut i64 = m + 8;
    pv capacity: i64 = 0;
    pv keys: i64 = 0;
    pv vals: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
        keys = *keys_ptr_ptr;
        vals = *vals_ptr_ptr;
    }
    pv result: i64 = Vec_new();
    if keys == 0 || capacity == 0 { ret result; }
    pv i: i64 = 0;
    while i < capacity {
        pv kaddr: i64 = keys + i * 8;
        pv kptr: *mut i64 = kaddr;
        pv slot_key: i64 = 0;
        unsafe {
            slot_key = *kptr;
        }
        if slot_key != 0 && slot_key != -1 {
            pv vaddr: i64 = vals + i * 8;
            pv vptr: *mut i64 = vaddr;
            pv val: i64 = 0;
            unsafe {
                val = *vptr;
            }
            Vec_push(result, val);
        }
        i = i + 1;
    }
    ret result;
}

pub pf HashMap_clone(m: i64) -> i64 {
    pv result: i64 = HashMap_new();
    pv cap_ptr: *mut i64 = m + 24;
    pv keys_ptr_ptr: *mut i64 = m;
    pv vals_ptr_ptr: *mut i64 = m + 8;
    pv capacity: i64 = 0;
    pv keys: i64 = 0;
    pv vals: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
        keys = *keys_ptr_ptr;
        vals = *vals_ptr_ptr;
    }
    if keys == 0 || capacity == 0 { ret result; }
    pv i: i64 = 0;
    while i < capacity {
        pv kaddr: i64 = keys + i * 8;
        pv kptr: *mut i64 = kaddr;
        pv slot_key: i64 = 0;
        unsafe {
            slot_key = *kptr;
        }
        if slot_key != 0 && slot_key != -1 {
            pv vaddr: i64 = vals + i * 8;
            pv vptr: *mut i64 = vaddr;
            pv val: i64 = 0;
            unsafe {
                val = *vptr;
            }
            HashMap_insert(result, slot_key, val);
        }
        i = i + 1;
    }
    ret result;
}

pub pf HashMap_get_or(m: i64, key: i64, default: i64) -> i64 {
    pv cap_ptr: *mut i64 = m + 24;
    pv capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { ret default; }

    pv idx: i64 = HashMap_find_slot(m, key);
    pv keys_ptr_ptr: *mut i64 = m;
    pv keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    pv kaddr: i64 = keys + idx * 8;
    pv kptr: *mut i64 = kaddr;
    pv slot_key: i64 = 0;
    unsafe {
        slot_key = *kptr;
    }
    if slot_key == 0 || slot_key == -1 { ret default; }

    pv vals_ptr_ptr: *mut i64 = m + 8;
    pv vals: i64 = 0;
    unsafe {
        vals = *vals_ptr_ptr;
    }
    pv vaddr: i64 = vals + idx * 8;
    pv vptr: *mut i64 = vaddr;
    pv result: i64 = 0;
    unsafe {
        result = *vptr;
    }
    ret result;
}

// Format a HashMap as "{key: val, key: val}".
// Keys and values are assumed to be string pointers (i64 addresses).
// Keys are sorted lexicographically for deterministic output.
pub pf HashMap_to_str(m: i64) -> str {
    pv keys: i64 = HashMap_keys(m);
    pv len: i64 = Vec_len(keys);

    // Sort keys lexicographically (simple bubble sort)
    pv i: i64 = 0;
    while i < len {
        pv j: i64 = 0;
        while j + 1 < len - i {
            pv k1: i64 = Vec_get(keys, j);
            pv k2: i64 = Vec_get(keys, j + 1);
            if p_str_compare(k1, k2) > 0 {
                Vec_set(keys, j, k2);
                Vec_set(keys, j + 1, k1);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    pv result: str = "{";
    i = 0;
    while i < len {
        if i > 0 {
            result = p_str_concat(result, ", ");
        }
        pv key: i64 = Vec_get(keys, i);
        pv val: i64 = HashMap_get(m, key);
        // Read key string from memory
        pv key_str: *mut u8 = p_str_from_ptr(key);
        result = p_str_concat(result, key_str);
        result = p_str_concat(result, ": ");
        // Value is an i64 — format as number
        result = p_str_concat(result, p_to_str(val));
        i = i + 1;
    }
    result = p_str_concat(result, "}");
    ret result;
}

// ─── String (Phase 10B) ─────────────────────────────────────────────────
// Strings are null-terminated byte buffers (i64 pointer to first byte).
// All operations allocate new strings (immutable semantics).
// String value is an i64 pointer to a null-terminated char array.

// Read a null-terminated string from a raw pointer (i64 address) and
// return it as a *mut u8 pointer to a new copy.
pf p_str_from_ptr(s: i64) -> *mut u8 {
    if s == 0 {
        pv empty: i64 = p_malloc(1);
        pv eptr: *mut u8 = empty;
        unsafe { *eptr = 0; }
        ret eptr;
    }
    pv addr: i64 = s;
    pv ptr: *mut u8 = addr;
    pv len: i64 = 0;
    unsafe {
        pv b: i64 = *ptr;
        while b != 0 {
            len = len + 1;
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    // Allocate and copy
    pv result: i64 = p_malloc(len + 1);
    pv dst: *mut u8 = result;
    pv src_addr: i64 = s;
    pv src_ptr: *mut u8 = src_addr;
    unsafe {
        pv i: i64 = 0;
        while i < len {
            pv ch: i64 = *src_ptr;
            *dst = ch;
            i = i + 1;
            src_addr = src_addr + 1;
            src_ptr = src_addr;
            pv dst_addr: i64 = dst;
            dst_addr = dst_addr + 1;
            dst = dst_addr;
        }
        *dst = 0;
    }
    pv result_ptr: *mut u8 = result;
    ret result_ptr;
}

// strlen: count bytes until null terminator. s is an i64 address.
pf p_str_length(s: i64) -> i64 {
    if s == 0 { ret 0; }
    pv addr: i64 = s;
    pv ptr: *mut u8 = addr;
    pv count: i64 = 0;
    unsafe {
        pv b: i64 = *ptr;
        while b != 0 {
            count = count + 1;
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    ret count;
}

// str_copy_n: copy n bytes from src to dst. Both are i64 addresses.
pf p_str_copy_n(dst: i64, src: i64, n: i64) {
    pv di: i64 = dst;
    pv si: i64 = src;
    pv i: i64 = 0;
    while i < n {
        pv d_ptr: *mut u8 = di;
        pv s_ptr: *mut u8 = si;
        unsafe {
            pv b: i64 = *s_ptr;
            *d_ptr = b;
        }
        di = di + 1;
        si = si + 1;
        i = i + 1;
    }
}

pub pf String_from(s: i64) -> i64 {
    if s == 0 {
        pv result: i64 = p_malloc(1);
        pv ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        ret result;
    }
    pv len: i64 = p_str_length(s);
    pv result: i64 = p_malloc(len + 1);
    p_str_copy_n(result, s, len);
    pv end_addr: i64 = result + len;
    pv end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    ret result;
}

pub pf String_len(s: i64) -> i64 {
    ret p_str_length(s);
}

pub pf String_is_empty(s: i64) -> bool {
    if s == 0 { ret true; }
    pv ptr: *mut u8 = s;
    pv b: i64 = 0;
    unsafe { b = *ptr; }
    ret b == 0;
}

pub pf String_push_str(s: i64, other: i64) -> i64 {
    pv s_len: i64 = p_str_length(s);
    pv o_len: i64 = p_str_length(other);
    pv result: i64 = p_malloc(s_len + o_len + 1);
    p_str_copy_n(result, s, s_len);
    p_str_copy_n(result + s_len, other, o_len);
    pv end_addr: i64 = result + s_len + o_len;
    pv end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    ret result;
}

pub pf String_contains(s: i64, sub: i64) -> bool {
    if s == 0 || sub == 0 { ret false; }
    pv s_len: i64 = p_str_length(s);
    pv sub_len: i64 = p_str_length(sub);
    if sub_len == 0 { ret true; }
    if sub_len > s_len { ret false; }
    pv i: i64 = 0;
    while i <= s_len - sub_len {
        pv matched: bool = true;
        pv j: i64 = 0;
        while j < sub_len {
            pv s_addr: i64 = s + i + j;
            pv sub_addr: i64 = sub + j;
            pv s_ptr: *mut u8 = s_addr;
            pv sub_ptr: *mut u8 = sub_addr;
            pv s_byte: i64 = 0;
            pv sub_byte: i64 = 0;
            unsafe {
                s_byte = *s_ptr;
                sub_byte = *sub_ptr;
            }
            if s_byte != sub_byte {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched { ret true; }
        i = i + 1;
    }
    ret false;
}

pub pf String_starts_with(s: i64, prefix: i64) -> bool {
    if s == 0 || prefix == 0 { ret false; }
    pv s_len: i64 = p_str_length(s);
    pv p_len: i64 = p_str_length(prefix);
    if p_len > s_len { ret false; }
    pv i: i64 = 0;
    while i < p_len {
        pv s_addr: i64 = s + i;
        pv p_addr: i64 = prefix + i;
        pv s_ptr: *mut u8 = s_addr;
        pv p_ptr: *mut u8 = p_addr;
        pv s_byte: i64 = 0;
        pv p_byte: i64 = 0;
        unsafe {
            s_byte = *s_ptr;
            p_byte = *p_ptr;
        }
        if s_byte != p_byte { ret false; }
        i = i + 1;
    }
    ret true;
}

pub pf String_ends_with(s: i64, suffix: i64) -> bool {
    if s == 0 || suffix == 0 { ret false; }
    pv s_len: i64 = p_str_length(s);
    pv suf_len: i64 = p_str_length(suffix);
    if suf_len > s_len { ret false; }
    if suf_len == 0 { ret true; }
    pv offset: i64 = s_len - suf_len;
    pv i: i64 = 0;
    while i < suf_len {
        pv s_addr: i64 = s + offset + i;
        pv suf_addr: i64 = suffix + i;
        pv s_ptr: *mut u8 = s_addr;
        pv suf_ptr: *mut u8 = suf_addr;
        pv s_byte: i64 = 0;
        pv suf_byte: i64 = 0;
        unsafe {
            s_byte = *s_ptr;
            suf_byte = *suf_ptr;
        }
        if s_byte != suf_byte { ret false; }
        i = i + 1;
    }
    ret true;
}

pub pf String_trim(s: i64) -> i64 {
    if s == 0 {
        pv result: i64 = p_malloc(1);
        pv ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        ret result;
    }
    pv len: i64 = p_str_length(s);
    pv start: i64 = 0;
    pv end: i64 = len;
    // Find first non-whitespace
    pv addr: i64 = s;
    pv ptr: *mut u8 = addr;
    unsafe {
        pv b: i64 = *ptr;
        while b == 32 || b == 9 || b == 10 || b == 13 {
            start = start + 1;
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    if start >= end {
        pv result: i64 = p_malloc(1);
        pv rptr: *mut u8 = result;
        unsafe { *rptr = 0; }
        ret result;
    }
    // Find last non-whitespace
    pv end_addr: i64 = s + end - 1;
    pv eptr: *mut u8 = end_addr;
    unsafe {
        pv b: i64 = *eptr;
        while b == 32 || b == 9 || b == 10 || b == 13 {
            end = end - 1;
            if end <= start { break; }
            end_addr = s + end - 1;
            eptr = end_addr;
            b = *eptr;
        }
    }
    pv new_len: i64 = end - start;
    if new_len <= 0 {
        pv result: i64 = p_malloc(1);
        pv rptr: *mut u8 = result;
        unsafe { *rptr = 0; }
        ret result;
    }
    pv result: i64 = p_malloc(new_len + 1);
    p_str_copy_n(result, s + start, new_len);
    pv rend_addr: i64 = result + new_len;
    pv rend_ptr: *mut u8 = rend_addr;
    unsafe { *rend_ptr = 0; }
    ret result;
}

pub pf String_to_uppercase(s: i64) -> i64 {
    if s == 0 {
        pv result: i64 = p_malloc(1);
        pv ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        ret result;
    }
    pv len: i64 = p_str_length(s);
    pv result: i64 = p_malloc(len + 1);
    pv i: i64 = 0;
    while i < len {
        pv src_addr: i64 = s + i;
        pv dst_addr: i64 = result + i;
        pv src_ptr: *mut u8 = src_addr;
        pv dst_ptr: *mut u8 = dst_addr;
        pv b: i64 = 0;
        unsafe { b = *src_ptr; }
        if b >= 97 && b <= 122 { b = b - 32; }
        unsafe { *dst_ptr = b; }
        i = i + 1;
    }
    pv end_addr: i64 = result + len;
    pv end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    ret result;
}

pub pf String_to_lowercase(s: i64) -> i64 {
    if s == 0 {
        pv result: i64 = p_malloc(1);
        pv ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        ret result;
    }
    pv len: i64 = p_str_length(s);
    pv result: i64 = p_malloc(len + 1);
    pv i: i64 = 0;
    while i < len {
        pv src_addr: i64 = s + i;
        pv dst_addr: i64 = result + i;
        pv src_ptr: *mut u8 = src_addr;
        pv dst_ptr: *mut u8 = dst_addr;
        pv b: i64 = 0;
        unsafe { b = *src_ptr; }
        if b >= 65 && b <= 90 { b = b + 32; }
        unsafe { *dst_ptr = b; }
        i = i + 1;
    }
    pv end_addr: i64 = result + len;
    pv end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    ret result;
}

pub pf String_slice(s: i64, start: i64, end: i64) -> i64 {
    if s == 0 {
        pv result: i64 = p_malloc(1);
        pv ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        ret result;
    }
    pv len: i64 = p_str_length(s);
    pv st: i64 = start;
    pv en: i64 = end;
    if st < 0 { st = 0; }
    if en > len { en = len; }
    if st >= en {
        pv result: i64 = p_malloc(1);
        pv ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        ret result;
    }
    pv new_len: i64 = en - st;
    pv result: i64 = p_malloc(new_len + 1);
    p_str_copy_n(result, s + st, new_len);
    pv end_addr: i64 = result + new_len;
    pv end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    ret result;
}

pub pf String_find(s: i64, sub: i64) -> i64 {
    if s == 0 || sub == 0 { ret -1; }
    pv s_len: i64 = p_str_length(s);
    pv sub_len: i64 = p_str_length(sub);
    if sub_len == 0 { ret 0; }
    if sub_len > s_len { ret -1; }
    pv i: i64 = 0;
    while i <= s_len - sub_len {
        pv matched: bool = true;
        pv j: i64 = 0;
        while j < sub_len {
            pv s_addr: i64 = s + i + j;
            pv sub_addr: i64 = sub + j;
            pv s_ptr: *mut u8 = s_addr;
            pv sub_ptr: *mut u8 = sub_addr;
            pv s_byte: i64 = 0;
            pv sub_byte: i64 = 0;
            unsafe {
                s_byte = *s_ptr;
                sub_byte = *sub_ptr;
            }
            if s_byte != sub_byte {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched { ret i; }
        i = i + 1;
    }
    ret -1;
}

pub pf String_rfind(s: i64, sub: i64) -> i64 {
    if s == 0 || sub == 0 { ret -1; }
    pv s_len: i64 = p_str_length(s);
    pv sub_len: i64 = p_str_length(sub);
    if sub_len == 0 { ret s_len; }
    if sub_len > s_len { ret -1; }
    pv i: i64 = s_len - sub_len;
    while i >= 0 {
        pv matched: bool = true;
        pv j: i64 = 0;
        while j < sub_len {
            pv s_addr: i64 = s + i + j;
            pv sub_addr: i64 = sub + j;
            pv s_ptr: *mut u8 = s_addr;
            pv sub_ptr: *mut u8 = sub_addr;
            pv s_byte: i64 = 0;
            pv sub_byte: i64 = 0;
            unsafe {
                s_byte = *s_ptr;
                sub_byte = *sub_ptr;
            }
            if s_byte != sub_byte {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched { ret i; }
        i = i - 1;
    }
    ret -1;
}

pub pf String_replace(s: i64, from: i64, to: i64) -> i64 {
    if s == 0 {
        pv result: i64 = p_malloc(1);
        pv ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        ret result;
    }
    if from == 0 || to == 0 {
        ret String_from(s);
    }
    pv from_len: i64 = p_str_length(from);
    if from_len == 0 { ret String_from(s); }

    // Build result by iterating through s
    pv result: i64 = p_malloc(1);
    pv rptr: *mut u8 = result;
    unsafe { *rptr = 0; }
    pv pos: i64 = 0;
    pv s_len: i64 = p_str_length(s);

    while pos < s_len {
        // Check if 'from' matches at pos
        pv matched: bool = true;
        pv j: i64 = 0;
        while j < from_len {
            if pos + j >= s_len { matched = false; break; }
            pv s_addr: i64 = s + pos + j;
            pv f_addr: i64 = from + j;
            pv s_ptr: *mut u8 = s_addr;
            pv f_ptr: *mut u8 = f_addr;
            pv s_byte: i64 = 0;
            pv f_byte: i64 = 0;
            unsafe {
                s_byte = *s_ptr;
                f_byte = *f_ptr;
            }
            if s_byte != f_byte { matched = false; break; }
            j = j + 1;
        }
        if matched {
            result = String_push_str(result, to);
            pos = pos + from_len;
        } else {
            // Append one byte from s
            pv byte_addr: i64 = s + pos;
            pv byte_ptr: *mut u8 = byte_addr;
            pv b: i64 = 0;
            unsafe { b = *byte_ptr; }
            pv tmp: i64 = p_malloc(2);
            pv tmp_ptr: *mut u8 = tmp;
            unsafe { *tmp_ptr = b; }
            pv tmp_end_addr: i64 = tmp + 1;
            pv tmp_end_ptr: *mut u8 = tmp_end_addr;
            unsafe { *tmp_end_ptr = 0; }
            result = String_push_str(result, tmp);
            p_free(tmp);
            pos = pos + 1;
        }
    }
    ret result;
}

pub pf String_split(s: i64, delim: i64) -> i64 {
    pv result: i64 = Vec_new();
    if s == 0 || delim == 0 { ret result; }
    pv dlen: i64 = p_str_length(delim);
    if dlen == 0 { ret result; }
    pv start: i64 = 0;
    pv s_len: i64 = p_str_length(s);
    pv pos: i64 = 0;
    while pos <= s_len - dlen {
        pv matched: bool = true;
        pv j: i64 = 0;
        while j < dlen {
            pv s_addr: i64 = s + pos + j;
            pv d_addr: i64 = delim + j;
            pv s_ptr: *mut u8 = s_addr;
            pv d_ptr: *mut u8 = d_addr;
            pv s_byte: i64 = 0;
            pv d_byte: i64 = 0;
            unsafe {
                s_byte = *s_ptr;
                d_byte = *d_ptr;
            }
            if s_byte != d_byte { matched = false; break; }
            j = j + 1;
        }
        if matched {
            pv part_len: i64 = pos - start;
            pv part: i64 = p_malloc(part_len + 1);
            p_str_copy_n(part, s + start, part_len);
            pv part_end_addr: i64 = part + part_len;
            pv part_end_ptr: *mut u8 = part_end_addr;
            unsafe { *part_end_ptr = 0; }
            Vec_push(result, part);
            start = pos + dlen;
            pos = start;
        } else {
            pos = pos + 1;
        }
    }
    // Add remaining part
    pv remaining: i64 = s_len - start;
    if remaining >= 0 {
        pv part: i64 = p_malloc(remaining + 1);
        p_str_copy_n(part, s + start, remaining);
        pv part_end_addr: i64 = part + remaining;
        pv part_end_ptr: *mut u8 = part_end_addr;
        unsafe { *part_end_ptr = 0; }
        Vec_push(result, part);
    }
    ret result;
}

pub pf String_parse_int(s: i64) -> i64 {
    if s == 0 { ret 0; }
    pv result: i64 = 0;
    pv sign: i64 = 1;
    pv addr: i64 = s;
    pv ptr: *mut u8 = addr;
    unsafe {
        pv b: i64 = *ptr;
        // Skip whitespace
        while b == 32 || b == 9 || b == 10 || b == 13 {
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
        // Check sign
        if b == 45 {
            sign = -1;
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        } else if b == 43 {
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
        // Parse digits
        while b >= 48 && b <= 57 {
            result = result * 10 + (b - 48);
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    ret result * sign;
}

pub pf String_char_at(s: i64, idx: i64) -> i64 {
    if s == 0 { ret 0; }
    pv len: i64 = p_str_length(s);
    if idx < 0 || idx >= len { ret 0; }
    pv addr: i64 = s + idx;
    pv ptr: *mut u8 = addr;
    pv b: i64 = 0;
    unsafe { b = *ptr; }
    pv result: i64 = p_malloc(2);
    pv rptr: *mut u8 = result;
    unsafe { *rptr = b; }
    pv rend_addr: i64 = result + 1;
    pv rend_ptr: *mut u8 = rend_addr;
    unsafe { *rend_ptr = 0; }
    ret result;
}

pub pf String_repeat(s: i64, n: i64) -> i64 {
    if s == 0 || n <= 0 {
        pv result: i64 = p_malloc(1);
        pv ptr: *mut u8 = result;
        unsafe { *ptr = 0; }
        ret result;
    }
    pv len: i64 = p_str_length(s);
    pv result: i64 = p_malloc(len * n + 1);
    pv i: i64 = 0;
    while i < n {
        p_str_copy_n(result + i * len, s, len);
        i = i + 1;
    }
    pv end_addr: i64 = result + len * n;
    pv end_ptr: *mut u8 = end_addr;
    unsafe { *end_ptr = 0; }
    ret result;
}

pub pf String_to_string(s: i64) -> i64 {
    ret String_from(s);
}

pub pf String_clone(s: i64) -> i64 {
    ret String_from(s);
}

pub pf String_bytes(s: i64) -> i64 {
    ret p_str_length(s);
}

// ═══════════════════════════════════════════════════════════════════════
// StringBuilder — mutable string builder for efficient concatenation
// ═══════════════════════════════════════════════════════════════════════
//
// Usage:
//   pv sb = StringBuilder::new();
//   sb.append_str("hello");
//   sb.append_str(" world");
//   pv result = sb.to_str();  // "hello world"
//   print(result);

pub struct StringBuilder {
    buf: str,
    len: i64,
}

impl StringBuilder {
    pub pf new() -> StringBuilder {
        ret StringBuilder { buf: "", len: 0 };
    }

    pub pf append_str(self: StringBuilder, s: str) -> void {
        self.buf = p_str_concat(self.buf, s);
        self.len = self.len + String_len(s);
    }

    pub pf append_char(self: StringBuilder, c: i64) -> void {
        self.buf = p_str_concat(self.buf, p_char_to_str(c));
        self.len = self.len + 1;
    }

    pub pf append_int(self: StringBuilder, n: i64) -> void {
        self.buf = p_str_concat(self.buf, p_to_str(n));
        self.len = self.len + 1;
    }

    pub pf to_str(self: StringBuilder) -> str {
        ret self.buf;
    }

    pub pf len(self: StringBuilder) -> i64 {
        ret self.len;
    }

    pub pf is_empty(self: StringBuilder) -> bool {
        ret self.len == 0;
    }

    pub pf clear(self: StringBuilder) -> void {
        self.buf = "";
        self.len = 0;
    }
}

// ═══════════════════════════════════════════════════════════════════════
// Char iteration helpers
// ═══════════════════════════════════════════════════════════════════════

pub pf String_byte_at(s: i64, idx: i64) -> i64 {
    if s == 0 { ret -1; }
    pv len: i64 = p_str_length(s);
    if idx < 0 || idx >= len { ret -1; }
    pv addr: i64 = s + idx;
    pv ptr: *mut u8 = addr;
    pv b: i64 = 0;
    unsafe { b = *ptr; }
    ret b;
}

pub pf String_char_count(s: i64) -> i64 {
    ret p_str_length(s);
}

pub pf char_to_str(b: i64) -> str {
    ret p_char_to_str(b);
}

pub pf char_is_digit(b: i64) -> bool {
    ret b >= 48 && b <= 57;
}

pub pf char_is_alpha(b: i64) -> bool {
    ret (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
}

pub pf char_is_whitespace(b: i64) -> bool {
    ret b == 32 || b == 9 || b == 10 || b == 13;
}

pub pf char_is_upper(b: i64) -> bool {
    ret b >= 65 && b <= 90;
}

pub pf char_is_lower(b: i64) -> bool {
    ret b >= 97 && b <= 122;
}

pub pf char_to_upper(b: i64) -> i64 {
    if b >= 97 && b <= 122 { ret b - 32; }
    ret b;
}

pub pf char_to_lower(b: i64) -> i64 {
    if b >= 65 && b <= 90 { ret b + 32; }
    ret b;
}

// ═══════════════════════════════════════════════════════════════════════
// ByteBuffer — mutable byte array for binary data
// ═══════════════════════════════════════════════════════════════════════
//
// ByteBuffer uses a Vec internally to store byte values.

pub struct ByteBuffer {
    data: Vec,
    len: i64,
}

impl ByteBuffer {
    pub pf new(init_cap: i64) -> ByteBuffer {
        ret ByteBuffer { data: Vec::new(), len: 0 };
    }

    pub pf from_string(s: str) -> ByteBuffer {
        pv buf = ByteBuffer::new(0);
        pv slen: i64 = String_len(s);
        pv i: i64 = 0;
        while i < slen {
            pv addr: i64 = s + i;
            pv ptr: *mut u8 = addr;
            pv b: i64 = 0;
            unsafe { b = *ptr; }
            buf.write_byte(b);
            i = i + 1;
        }
        ret buf;
    }

    pub pf write_byte(self: ByteBuffer, b: i64) -> void {
        self.data.push(b);
        self.len = self.len + 1;
    }

    pub pf write_bytes(self: ByteBuffer, src: i64, count: i64) -> void {
        pv i: i64 = 0;
        while i < count {
            pv src_addr: i64 = src + i;
            pv src_ptr: *mut u8 = src_addr;
            pv b: i64 = 0;
            unsafe { b = *src_ptr; }
            self.write_byte(b);
            i = i + 1;
        }
    }

    pub pf read_byte(self: ByteBuffer, idx: i64) -> i64 {
        if idx < 0 || idx >= self.len { ret -1; }
        ret self.data.get(idx);
    }

    pub pf set_byte(self: ByteBuffer, idx: i64, b: i64) -> void {
        if idx < 0 || idx >= self.len { ret; }
        self.data.set(idx, b);
    }

    pub pf len(self: ByteBuffer) -> i64 {
        ret self.len;
    }

    pub pf is_empty(self: ByteBuffer) -> bool {
        ret self.len == 0;
    }

    pub pf clear(self: ByteBuffer) -> void {
        self.data.clear();
        self.len = 0;
    }

    pub pf to_str(self: ByteBuffer) -> str {
        pv result: str = "";
        pv i: i64 = 0;
        while i < self.len {
            pv b: i64 = self.data.get(i);
            result = p_str_concat(result, p_char_to_str(b));
            i = i + 1;
        }
        ret result;
    }
}

// ═══════════════════════════════════════════════════════════════════════
// Self-host stdlib gaps — string/byte/parsing utilities needed by the
// lexer, parser, and typechecker when rewritten in Fides.
// ═══════════════════════════════════════════════════════════════════════

/// Iterate over the bytes of a string, returning a Vec of byte values.
/// Usage: `pv bytes = str_bytes("hello");  // [104, 101, 108, 108, 111]`
pub pf str_bytes(s: str) -> Vec {
    pv result: Vec = Vec::new();
    pv slen: i64 = String_len(s);
    pv i: i64 = 0;
    while i < slen {
        pv addr: i64 = s + i;
        pv ptr: *mut u8 = addr;
        pv b: i64 = 0;
        unsafe { b = *ptr; }
        result.push(b);
        i = i + 1;
    }
    ret result;
}

/// Build a string from a Vec of byte values.
pub pf str_from_bytes(bytes: Vec) -> str {
    pv result: str = "";
    pv i: i64 = 0;
    pv n: i64 = bytes.len();
    while i < n {
        result = p_str_concat(result, p_char_to_str(bytes.get(i)));
        i = i + 1;
    }
    ret result;
}

/// Get a substring by byte range [start, end).
pub pf str_slice(s: str, start: i64, end: i64) -> str {
    pv slen: i64 = String_len(s);
    pv s0: i64 = start;
    pv e0: i64 = end;
    if s0 < 0 { s0 = 0; }
    if e0 > slen { e0 = slen; }
    if s0 >= e0 { ret ""; }
    ret String_slice(s, s0, e0);
}

/// Check if a string starts with a prefix.
pub pf str_starts_with(s: str, prefix: str) -> bool {
    ret String_starts_with(s, prefix);
}

/// Check if a string ends with a suffix.
pub pf str_ends_with(s: str, suffix: str) -> bool {
    ret String_ends_with(s, suffix);
}

/// Check if a string contains a substring.
pub pf str_contains(s: str, sub: str) -> bool {
    ret String_contains(s, sub);
}

/// Find the first index of a substring, or -1 if not found.
pub pf str_find(s: str, sub: str) -> i64 {
    ret String_find(s, sub);
}

/// Find the last index of a substring, or -1 if not found.
pub pf str_rfind(s: str, sub: str) -> i64 {
    ret String_rfind(s, sub);
}

/// Trim leading whitespace from a string.
pub pf str_trim_start(s: str) -> str {
    pv slen: i64 = String_len(s);
    pv i: i64 = 0;
    while i < slen {
        pv addr: i64 = s + i;
        pv ptr: *mut u8 = addr;
        pv b: i64 = 0;
        unsafe { b = *ptr; }
        if !char_is_whitespace(b) { break; }
        i = i + 1;
    }
    if i >= slen { ret ""; }
    ret String_slice(s, i, slen);
}

/// Trim trailing whitespace from a string.
pub pf str_trim_end(s: str) -> str {
    pv slen: i64 = String_len(s);
    pv end: i64 = slen;
    while end > 0 {
        pv addr: i64 = s + end - 1;
        pv ptr: *mut u8 = addr;
        pv b: i64 = 0;
        unsafe { b = *ptr; }
        if !char_is_whitespace(b) { break; }
        end = end - 1;
    }
    if end <= 0 { ret ""; }
    ret String_slice(s, 0, end);
}

/// Trim both leading and trailing whitespace.
pub pf str_trim(s: str) -> str {
    ret String_trim(s);
}

/// Split a string by delimiter, returning a Vec of string parts.
pub pf str_split(s: str, delim: str) -> Vec {
    pv result: Vec = Vec::new();
    if String_len(delim) == 0 {
        result.push(s);
        ret result;
    }
    pv start: i64 = 0;
    pv s_len: i64 = String_len(s);
    pv dlen: i64 = String_len(delim);
    pv pos: i64 = 0;
    while pos <= s_len - dlen {
        pv matched: bool = true;
        pv j: i64 = 0;
        while j < dlen {
            pv s_addr: i64 = s + pos + j;
            pv d_addr: i64 = delim + j;
            pv s_ptr: *mut u8 = s_addr;
            pv d_ptr: *mut u8 = d_addr;
            pv sb: i64 = 0;
            pv db: i64 = 0;
            unsafe { sb = *s_ptr; db = *d_ptr; }
            if sb != db { matched = false; break; }
            j = j + 1;
        }
        if matched {
            result.push(String_slice(s, start, pos));
            start = pos + dlen;
            pos = start;
        } else {
            pos = pos + 1;
        }
    }
    result.push(String_slice(s, start, s_len));
    ret result;
}

/// Split a string by a single character delimiter, returning a Vec of parts.
/// Faster than str_split for single-char delimiters.
pub pf str_split_char(s: str, delim: i64) -> Vec {
    pv result: Vec = Vec::new();
    pv start: i64 = 0;
    pv s_len: i64 = String_len(s);
    pv i: i64 = 0;
    while i < s_len {
        pv addr: i64 = s + i;
        pv ptr: *mut u8 = addr;
        pv b: i64 = 0;
        unsafe { b = *ptr; }
        if b == delim {
            result.push(String_slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    result.push(String_slice(s, start, s_len));
    ret result;
}

/// Replace all occurrences of `from` with `to` in a string.
pub pf str_replace(s: str, from: str, to: str) -> str {
    ret String_replace(s, from, to);
}

/// Repeat a string n times.
pub pf str_repeat(s: str, n: i64) -> str {
    ret String_repeat(s, n);
}

/// Convert a string to uppercase.
pub pf str_to_upper(s: str) -> str {
    ret String_to_uppercase(s);
}

/// Convert a string to lowercase.
pub pf str_to_lower(s: str) -> str {
    ret String_to_lowercase(s);
}

/// Parse a decimal integer from a string. Returns 0 on failure.
pub pf str_parse_int(s: str) -> i64 {
    ret String_parse_int(s);
}

/// Parse a hexadecimal integer from a string. Supports optional "0x" prefix.
/// Returns 0 on failure.
pub pf str_parse_hex(s: str) -> i64 {
    pv slen: i64 = String_len(s);
    if slen == 0 { ret 0; }
    pv i: i64 = 0;
    pv result: i64 = 0;
    pv negative: bool = false;
    // Skip leading whitespace
    while i < slen {
        pv addr: i64 = s + i;
        pv ptr: *mut u8 = addr;
        pv b: i64 = 0;
        unsafe { b = *ptr; }
        if !char_is_whitespace(b) { break; }
        i = i + 1;
    }
    if i >= slen { ret 0; }
    // Check sign
    pv addr0: i64 = s + i;
    pv ptr0: *mut u8 = addr0;
    pv c0: i64 = 0;
    unsafe { c0 = *ptr0; }
    if c0 == 45 { negative = true; i = i + 1; }
    else if c0 == 43 { i = i + 1; }
    // Check for 0x prefix
    if i + 1 < slen {
        pv a1: i64 = s + i;
        pv p1: *mut u8 = a1;
        pv c1: i64 = 0;
        unsafe { c1 = *p1; }
        pv a2: i64 = s + i + 1;
        pv p2: *mut u8 = a2;
        pv c2: i64 = 0;
        unsafe { c2 = *p2; }
        if c1 == 48 && (c2 == 120 || c2 == 88) { i = i + 2; }
    }
    // Parse hex digits
    while i < slen {
        pv addr: i64 = s + i;
        pv ptr: *mut u8 = addr;
        pv b: i64 = 0;
        unsafe { b = *ptr; }
        pv digit: i64 = -1;
        if b >= 48 && b <= 57 { digit = b - 48; }
        else if b >= 65 && b <= 70 { digit = b - 55; }
        else if b >= 97 && b <= 102 { digit = b - 87; }
        else { break; }
        result = result * 16 + digit;
        i = i + 1;
    }
    if negative { result = 0 - result; }
    ret result;
}

/// Parse an integer from a substring [start, end) of a string.
/// Useful for the lexer which has already extracted digit positions.
pub pf str_parse_int_range(s: str, start: i64, end: i64) -> i64 {
    pv slen: i64 = String_len(s);
    pv s0: i64 = start;
    pv e0: i64 = end;
    if s0 < 0 { s0 = 0; }
    if e0 > slen { e0 = slen; }
    if s0 >= e0 { ret 0; }
    pv result: i64 = 0;
    pv i: i64 = s0;
    while i < e0 {
        pv addr: i64 = s + i;
        pv ptr: *mut u8 = addr;
        pv b: i64 = 0;
        unsafe { b = *ptr; }
        if b < 48 || b > 57 { break; }
        result = result * 10 + (b - 48);
        i = i + 1;
    }
    ret result;
}

/// Get the byte at a given index, or -1 if out of bounds.
pub pf str_byte_at(s: str, idx: i64) -> i64 {
    ret String_byte_at(s, idx);
}

/// Get the length of a string in bytes.
pub pf str_len(s: str) -> i64 {
    ret String_len(s);
}

/// Check if a string is empty.
pub pf str_is_empty(s: str) -> bool {
    ret String_is_empty(s);
}

/// Concatenate two strings.
pub pf str_concat(a: str, b: str) -> str {
    ret p_str_concat(a, b);
}

/// Compare two strings. Returns 0 if equal, negative if a < b, positive if a > b.
pub pf str_compare(a: str, b: str) -> i64 {
    ret p_str_compare(a, b);
}

/// Check if two strings are equal.
pub pf str_equal(a: str, b: str) -> bool {
    ret p_str_equal(a, b);
}

/// Convert an integer to a string.
pub pf int_to_str(n: i64) -> str {
    ret p_to_str(n);
}

/// Convert a byte value to a single-character string.
pub pf byte_to_str(b: i64) -> str {
    ret p_char_to_str(b);
}
