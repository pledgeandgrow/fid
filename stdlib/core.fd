// Pledge core standard library — Phase 2
// Auto-included by the compiler. All items are pub.

module core;

// Builtin: print — outputs to stdout
// (Implemented natively in the compiler for Phase 1)

// Builtin: println — print with newline
pub fn println(s: str) -> void {
    print(s);
    print("\n");
}

// Builtin: assert — crash if condition is false
pub fn assert(cond: bool) -> void {
    if !cond {
        p_panic("Assertion failed");
    }
}

// Builtin: assert with message (SH-1.6) — crash with a custom message
// Use f-strings for formatting: assert_msg(idx < len, f"out of bounds: {idx} >= {len}");
pub fn assert_msg(cond: bool, msg: str) -> void {
    if !cond {
        p_panic(msg);
    }
}

// Builtin: assert_eq — check equality
pub fn assert_eq<T>(a: T, b: T) -> void {
    if a != b {
        p_panic("Assertion failed: values not equal");
    }
}

// Builtin: assert_eq with message (SH-1.6) — crash with a custom message
pub fn assert_eq_msg<T>(a: T, b: T, msg: str) -> void {
    if a != b {
        p_panic(msg);
    }
}

// Builtin: assert_ne — check inequality (L4J)
pub fn assert_ne<T>(a: T, b: T) -> void {
    if a == b {
        p_panic("Assertion failed: values are equal");
    }
}

// Builtin: assert_ne with message (L4J)
pub fn assert_ne_msg<T>(a: T, b: T, msg: str) -> void {
    if a == b {
        p_panic(msg);
    }
}

// Builtin: panic — abort with a message (L4J/L8K)
pub fn panic(msg: str) -> void {
    p_panic(msg);
}

// ─── Option<T> ──────────────────────────────────────────────────────────
// Represents an optional value: either Some(value) or None.
// Generic over T — the inner value type.
// When used without generic args (Option), payloads default to i64 via
// the typechecker's pattern_binding_types fallback.

pub enum Option<T> {
    Some(T),
    None,
}

// The methods are instantiated for each T a program uses (Option<f64>'s
// unwrap returns an f64). On an Option written without its type argument,
// T is i64.
impl<T> Option {
    pub fn is_some(self: Option<T>) -> bool {
        match self {
            Option::Some(v) => { return true; }
            Option::None => { return false; }
        }
    }

    pub fn is_none(self: Option<T>) -> bool {
        match self {
            Option::Some(v) => { return false; }
            Option::None => { return true; }
        }
    }

    pub fn unwrap(self: Option<T>) -> T {
        match self {
            Option::Some(v) => { return v; }
            Option::None => {
                p_panic("called unwrap on None");
            }
        }
    }

    pub fn unwrap_or(self: Option<T>, default: T) -> T {
        match self {
            Option::Some(v) => { return v; }
            Option::None => { return default; }
        }
    }

    pub fn map(self: Option<T>, f: fn(T) -> T) -> Option<T> {
        match self {
            Option::Some(v) => { return Option::Some(f(v)); }
            Option::None => { return Option::None; }
        }
    }

    pub fn and_then(self: Option<T>, f: fn(T) -> T) -> Option<T> {
        match self {
            Option::Some(v) => { return Option::Some(f(v)); }
            Option::None => { return Option::None; }
        }
    }

    pub fn or_else(self: Option<T>, default: fn() -> T) -> Option<T> {
        match self {
            Option::Some(v) => { return Option::Some(v); }
            Option::None => { return Option::Some(default()); }
        }
    }

    pub fn unwrap_or_else(self: Option<T>, default: fn() -> T) -> T {
        match self {
            Option::Some(v) => { return v; }
            Option::None => { return default(); }
        }
    }

    pub fn expect(self: Option<T>, msg: str) -> T {
        match self {
            Option::Some(v) => { return v; }
            Option::None => {
                p_panic(msg);
            }
        }
    }
}

// ─── Result<T, E> ───────────────────────────────────────────────────────
// Represents a result: either Ok(value) or Err(error).
// Generic over T (value type) and E (error type); the methods are
// instantiated per T and E as Option's are.

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result {
    pub fn is_ok(self: Result<T, E>) -> bool {
        match self {
            Result::Ok(v) => { return true; }
            Result::Err(e) => { return false; }
        }
    }

    pub fn is_err(self: Result<T, E>) -> bool {
        match self {
            Result::Ok(v) => { return false; }
            Result::Err(e) => { return true; }
        }
    }

    pub fn unwrap(self: Result<T, E>) -> T {
        match self {
            Result::Ok(v) => { return v; }
            Result::Err(e) => {
                p_panic("called unwrap on Err");
            }
        }
    }

    pub fn unwrap_or(self: Result<T, E>, default: T) -> T {
        match self {
            Result::Ok(v) => { return v; }
            Result::Err(e) => { return default; }
        }
    }

    pub fn ok(self: Result<T, E>) -> Option<T> {
        match self {
            Result::Ok(v) => { return Option::Some(v); }
            Result::Err(e) => { return Option::None; }
        }
    }

    pub fn err(self: Result<T, E>) -> Option<E> {
        match self {
            Result::Ok(v) => { return Option::None; }
            Result::Err(e) => { return Option::Some(e); }
        }
    }

    pub fn map(self: Result<T, E>, f: fn(T) -> T) -> Result<T, E> {
        match self {
            Result::Ok(v) => { return Result::Ok(f(v)); }
            Result::Err(e) => { return Result::Err(e); }
        }
    }

    pub fn map_err(self: Result<T, E>, f: fn(E) -> E) -> Result<T, E> {
        match self {
            Result::Ok(v) => { return Result::Ok(v); }
            Result::Err(e) => { return Result::Err(f(e)); }
        }
    }

    pub fn and_then(self: Result<T, E>, f: fn(T) -> T) -> Result<T, E> {
        match self {
            Result::Ok(v) => { return Result::Ok(f(v)); }
            Result::Err(e) => { return Result::Err(e); }
        }
    }

    pub fn unwrap_or_else(self: Result<T, E>, default: fn() -> T) -> T {
        match self {
            Result::Ok(v) => { return v; }
            Result::Err(e) => { return default(); }
        }
    }

    pub fn expect(self: Result<T, E>, msg: str) -> T {
        match self {
            Result::Ok(v) => { return v; }
            Result::Err(e) => {
                p_panic(msg);
            }
        }
    }

    /// For a Result whose error is a str: Err(e) -> Err("msg: e"), so an
    /// error passed up with `?` says what was being done. Ok is returned
    /// as it is (no allocation): the message is built only on failure.
    pub fn context(self: Result<T, E>, msg: str) -> Result<T, str> {
        match self {
            Result::Ok(v) => { return Result::Ok(v); }
            Result::Err(e: str) => { return Result::Err(msg + ": " + e); }
        }
    }

    /// As context, with the message made by `f`, called only on Err.
    pub fn with_context(self: Result<T, E>, f: fn() -> str) -> Result<T, str> {
        match self {
            Result::Ok(v) => { return Result::Ok(v); }
            Result::Err(e: str) => { return Result::Err(f() + ": " + e); }
        }
    }
}

// After Result: core's methods may only name the variants of an enum
// declared above them.
impl<T> Option {
    /// Some(v) -> Ok(v); None -> Err(msg), so `?` can pass it up as an error.
    pub fn context(self: Option<T>, msg: str) -> Result<T, str> {
        match self {
            Option::Some(v) => { return Result::Ok(v); }
            Option::None => { return Result::Err(msg); }
        }
    }
}

// ─── Utility functions ──────────────────────────────────────────────────

pub fn max(a: i64, b: i64) -> i64 {
    if a > b { return a; }
    return b;
}

pub fn min(a: i64, b: i64) -> i64 {
    if a < b { return a; }
    return b;
}

pub fn abs(n: i64) -> i64 {
    if n < 0 { return -n; }
    return n;
}

pub fn clamp(n: i64, lo: i64, hi: i64) -> i64 {
    if n < lo { return lo; }
    if n > hi { return hi; }
    return n;
}

// ─── Allocator (Phase 2A.8) ───
// Explicit allocator-as-parameter, like Zig, but verified at compile time.
// Functions that declare !Alloc must take an Allocator parameter.

// Builtin: p_allocator_create — create a named allocator
// Builtin: p_allocator_alloc — allocate memory from an allocator
// Builtin: p_allocator_free — free memory back to an allocator
// Builtin: p_allocator_stats — get allocation stats (bytes allocated)

pub fn create_allocator(name: str) -> Allocator {
    return p_allocator_create(name);
}

pub fn allocator_alloc(alloc: &Allocator, size: i64) -> i64 {
    return p_allocator_alloc(alloc, size);
}

pub fn allocator_free(alloc: &Allocator, ptr: i64) -> void {
    p_allocator_free(alloc, ptr);
}

pub fn allocator_bytes_used(alloc: &Allocator) -> i64 {
    return p_allocator_stats(alloc);
}

// ─── Iterator capability (Phase 7.7) ───────────────────────────────────
// The Iterator cap defines the interface for lazy iteration.
// Types implementing Iterator can be used in for loops.
// Note: Built-in types (Vec, Range, HashMap) have compiler-level iterator
// support. Custom types can implement this cap to work with for loops.

pub cap Iterator {
    type Item;
    fn next(self: Self) -> Option<Self::Item>;
}

// ─── Error trait (Phase 7.7) ───────────────────────────────────────────
// The Error cap defines the interface for custom error types.
// Any type implementing Error can be used as the E in Result<T, E>.

pub cap Error {
    fn message(self: Self) -> str;
}

// ─── Vec<T> (Phase 10B) ─────────────────────────────────────────────────
// Dynamic array with amortized O(1) push/pop.
// Implemented in pure Fides using raw pointers — no compiler builtins.
//
// Internal layout: 40-byte heap block { data, len: i64, capacity: i64,
// code: i64, tid: i64 } (one per owner: see Vec_share). The Vec value is an
// i64 pointer to this block. `tid` is the element type (proposal 0004): the
// Vec owns its elements and drops or copies them by it. Element data
// is a separate heap allocation of capacity * size bytes, where the element
// code (release D14) gives the size: 0 = one word per element (8 bytes,
// every Vec but those below), 1/2/4 = an unsigned integer or bool of that
// many bytes, -1/-2/-4 = a signed one (sign-extended when read). Functions
// below keep the word path as it was and hand a sized Vec to vec_sz_*.
//
// All functions take the Vec as i64 (the pointer to the block).
// Mutation is in-place through the pointer — no return-and-reassign needed.

pub fn Vec_new() -> i64 {
    var ptr: i64 = p_malloc(40);
    var p0: *mut i64 = ptr;
    var p8: *mut i64 = ptr + 8;
    var p16: *mut i64 = ptr + 16;
    var p24: *mut i64 = ptr + 24;
    var p32: *mut i64 = ptr + 32;
    unsafe {
        *p0 = 0;
        *p8 = 0;
        *p16 = 0;
        *p24 = 0;
        *p32 = 0;
    }
    return ptr;
}

/// An empty Vec whose elements are stored at `code`'s size (D14; the
/// compiler calls it for a Vec<u8>, Vec<i32>, Vec<bool>, ...).
pub fn Vec_new_sized(code: i64) -> i64 {
    return Vec_new_typed(code, 0);
}

/// An empty Vec of elements stored at `code`'s size that owns them as
/// element type `tid` says (proposal 0004): 0 plain values, P_TID_STR,
/// P_TID_VEC, P_TID_MAP, or a struct/enum type the compiler numbered.
pub fn Vec_new_typed(code: i64, tid: i64) -> i64 {
    var v: i64 = Vec_new();
    if code != 0 {
        var p24: *mut i64 = v + 24;
        unsafe { *p24 = vec_code_word(code); }
    }
    if tid != 0 {
        var p32: *mut i64 = v + 32;
        unsafe { *p32 = P_TID_TAG + tid; }
    }
    return v;
}

// A Vec buffer that core allocates keeps room for its share box in front
// of the data (release item 8): [tag][owners][cap] data..., the tag being
// P_VBUF_KEY + the data's address. The first copy of a Vec then uses that
// room (box = data - 16) instead of allocating a box. A buffer made any
// other way (the C runtime, an older build) has no tag and gets a box of
// its own, as before; every free below handles both.
const VEC_BUF_RC: bool = true;
const P_VBUF_KEY: i64 = 0x5646425546494445;

/// A buffer of `bytes` bytes for a Vec's data, with room for its box.
@wrapping
fn vec_buf_alloc(bytes: i64) -> i64 {
    if !VEC_BUF_RC { return p_malloc(bytes); }
    var b: i64 = p_malloc(bytes + 24);
    if b == 0 { return 0; }
    var d: i64 = b + 24;
    var t0: *mut i64 = b;
    var t8: *mut i64 = b + 8;
    var t16: *mut i64 = b + 16;
    unsafe { *t0 = P_VBUF_KEY + d; *t8 = 0; *t16 = 0; }
    return d;
}

/// Whether the buffer at `d` has room for its box (vec_buf_alloc made it).
@wrapping
fn vec_buf_tagged(d: i64) -> bool {
    if !VEC_BUF_RC || d == 0 { return false; }
    var tp: *mut i64 = d - 24;
    var t: i64 = 0;
    unsafe { t = *tp; }
    return t == P_VBUF_KEY + d;
}

/// Free a Vec's data buffer, made by vec_buf_alloc or not.
pub fn vec_buf_free(d: i64) {
    if d == 0 { return; }
    if vec_buf_tagged(d) {
        var tp: *mut i64 = d - 24;
        unsafe { *tp = 0; }
        p_free(d - 24);
        return;
    }
    p_free(d);
}

/// Free a share box, unless it is the room in front of `data`.
pub fn vec_box_free(bx: i64, data: i64) {
    if bx == data - 16 && vec_buf_tagged(data) { return; }
    p_free(bx);
}

/// `Vec::filled(n, x)`: `n` elements, each `x`, stored at `code`'s size and
/// owned as `tid` says (each element is one more owner of `x`; the caller
/// keeps its own). The C backend replaces the body with a memset or a word
/// loop (codegen_c.fd fast_core_vec_body).
pub fn Vec_filled_typed(n: i64, x: i64, code: i64, tid: i64) -> i64 {
    var v: i64 = Vec_new_typed(code, tid);
    if n <= 0 { return v; }
    var esz: i64 = vec_esz(code);
    var data: i64 = vec_buf_alloc(n * esz);
    if data == 0 { p_panic("out of memory"); }
    var i: i64 = 0;
    if code != 0 {
        while i < n {
            vec_st(data, i, code, x);
            i = i + 1;
        }
    } else {
        while i < n {
            var wp: *mut i64 = data + i * 8;
            var e: i64 = vec_elem_dup(tid, x);
            unsafe { *wp = e; }
            i = i + 1;
        }
    }
    var p0: *mut i64 = v;
    var p8: *mut i64 = v + 8;
    var p16: *mut i64 = v + 16;
    unsafe { *p0 = data; *p8 = n; *p16 = n; }
    return v;
}

/// The element type of a Vec (0: plain values, nothing to drop or copy).
@crashfree
@wrapping
pub fn vec_tid(v: i64) -> i64 {
    if v == 0 { return 0; }
    var p32: *mut i64 = v + 32;
    var w: i64 = 0;
    unsafe { w = *p32; }
    var t: i64 = w - P_TID_TAG;
    if t > 0 && t < 0x10000 { return t; }
    return 0;
}

/// Drop one owner of an element of type `tid` (proposal 0004).
pub fn vec_elem_drop(tid: i64, e: i64) {
    if tid == 0 || e == 0 { return; }
    if tid == P_TID_STR { Str_drop(e); return; }
    if tid == P_TID_VEC { Vec_drop(e); return; }
    if tid == P_TID_MAP { HashMap_drop(e); return; }
    if tid >= P_TID_BOX { Box_drop_t(e, tid - P_TID_BOX); return; }
    __p_elem_drop(tid, e);
}

/// One more owner of an element of type `tid`: the element to store.
pub fn vec_elem_dup(tid: i64, e: i64) -> i64 {
    if tid == 0 || e == 0 { return e; }
    if tid == P_TID_STR { return Str_dup(e); }
    if tid == P_TID_VEC { return Vec_share(e); }
    if tid == P_TID_MAP { return HashMap_share(e); }
    if tid >= P_TID_BOX { return Box_dup(e); }
    return __p_elem_dup(tid, e);
}

// A Box (proposal 0004, ownership of boxes): its block is [count word]
// then what it holds, and a Box is the address after the count. Copying a
// Box counts one more owner (the copies share what they hold, as they
// always did); its last owner drops what it holds and frees the block.
// The count word is P_BOX_RC + owners; anything else (a Box made another
// way) is left alone.
const P_BOX_RC: i64 = 0x464944424F580000;
const P_BOX_RC_MAX: i64 = 0x40000000;
const P_BOX_DEAD: i64 = 0x464944424F57FFFF;
// Element type of a Box: P_TID_BOX + the element type of what it holds
pub const P_TID_BOX: i64 = 0x8000;

/// One more owner of a Box; returns `b`.
@wrapping
pub fn Box_dup(b: i64) -> i64 {
    if b == 0 { return b; }
    var hp: *mut i64 = b - 8;
    var w: i64 = 0;
    unsafe { w = *hp; }
    var c: i64 = w - P_BOX_RC;
    if c >= 1 && c < P_BOX_RC_MAX - 1 {
        unsafe { *hp = w + 1; }
    }
    return b;
}

/// Drop one owner of a Box holding a value of element type `tid`: the last
/// owner drops that value and frees the block.
@wrapping
pub fn Box_drop_t(b: i64, tid: i64) {
    if b == 0 { return; }
    var hp: *mut i64 = b - 8;
    var w: i64 = 0;
    unsafe { w = *hp; }
    var c: i64 = w - P_BOX_RC;
    if c < 1 || c >= P_BOX_RC_MAX { return; }
    if c > 1 {
        unsafe { *hp = w - 1; }
        return;
    }
    unsafe { *hp = P_BOX_DEAD; }
    if tid != 0 {
        if tid == P_TID_STR || tid == P_TID_VEC || tid == P_TID_MAP || tid >= P_TID_BOX {
            // a handle held as one word
            var wp: *mut i64 = b;
            var e: i64 = 0;
            unsafe { e = *wp; }
            vec_elem_drop(tid, e);
        } else {
            // a struct or enum held inline
            __p_mem_drop(tid, b);
        }
    }
    p_free(b - 8);
}

// Structs in a Vec's buffer (release D15): element code 16 + words - 1
// (vec_esz), elements reached by address (vec_ld gives it, vec_st copies
// one in). The lowering puts a struct into a Vec through Vec_push_mem,
// Vec_set_mem and Vec_insert_mem, with its size and element type: an empty
// Vec takes the in-buffer layout, one that holds boxed structs (a pointer
// to a heap copy each) keeps boxing. Reading needs no change: either way
// get gives a pointer to the struct.

/// Drop the struct elements [from, to) of `v` held in buffer `data`.
fn vec_mem_drop_range(v: i64, data: i64, from: i64, to: i64) {
    var code: i64 = vec_code(v);
    var tid: i64 = vec_tid(v);
    if code < 16 || tid < 16 || tid >= P_TID_BOX || data == 0 { return; }
    var esz: i64 = vec_esz(code);
    var i: i64 = from;
    while i < to {
        __p_mem_drop(tid, data + i * esz);
        i = i + 1;
    }
}

/// One more owner of what each struct element [from, to) of `v` in buffer
/// `data` holds (after its bytes were copied).
fn vec_mem_dup_range(v: i64, data: i64, from: i64, to: i64) {
    var code: i64 = vec_code(v);
    var tid: i64 = vec_tid(v);
    if code < 16 || tid < 16 || tid >= P_TID_BOX || data == 0 { return; }
    var esz: i64 = vec_esz(code);
    var i: i64 = from;
    while i < to {
        __p_mem_dup(tid, data + i * esz);
        i = i + 1;
    }
}

/// A heap copy of the `size` bytes at `x` (a boxed struct element; what
/// the struct holds moves with it).
fn vec_mem_box(x: i64, size: i64) -> i64 {
    var b: i64 = p_malloc(size);
    if b == 0 { p_panic("out of memory"); }
    vec_copy_bytes(b, x, size);
    return b;
}

/// Whether `v` holds structs of `size` bytes in its buffer: it does
/// already, or it is empty, not shared and holds words, and takes that
/// layout now (element type `tid`).
fn vec_mem_prepare(v: i64, size: i64, tid: i64) -> bool {
    var code: i64 = vec_code(v);
    if code >= 16 { return true; }
    if code != 0 { return false; }
    if size <= 0 || size % 8 != 0 || size > 232 * 8 { return false; }
    var p0: *mut i64 = v;
    var p8: *mut i64 = v + 8;
    var p16: *mut i64 = v + 16;
    var p24: *mut i64 = v + 24;
    var p32: *mut i64 = v + 32;
    var data: i64 = 0;
    var len: i64 = 0;
    var cap: i64 = 0;
    unsafe { data = *p0; len = *p8; cap = *p16; }
    if len != 0 || cap < 0 { return false; }
    if data != 0 { vec_buf_free(data); }
    unsafe {
        *p0 = 0;
        *p16 = 0;
        *p24 = vec_code_word(15 + size / 8);
    }
    if tid >= 16 && tid < P_TID_BOX { unsafe { *p32 = P_TID_TAG + tid; } }
    return true;
}

/// `v.push(x)` for a struct `x` of `size` bytes (the Vec takes what it
/// holds over).
pub fn Vec_push_mem(v: i64, x: i64, size: i64, tid: i64) {
    vec_own(v);
    if vec_mem_prepare(v, size, tid) {
        vec_sz_push(v, vec_code(v), x);
        return;
    }
    Vec_push(v, vec_mem_box(x, size));
}

/// `v.set(i, x)` / `v[i] = x` for a struct `x` of `size` bytes.
pub fn Vec_set_mem(v: i64, idx: i64, x: i64, size: i64, tid: i64) {
    vec_own(v);
    if vec_code(v) >= 16 {
        vec_sz_set(v, idx, x);
        return;
    }
    Vec_set(v, idx, vec_mem_box(x, size));
}

/// `v.insert(i, x)` for a struct `x` of `size` bytes.
pub fn Vec_insert_mem(v: i64, idx: i64, x: i64, size: i64, tid: i64) {
    vec_own(v);
    if vec_mem_prepare(v, size, tid) {
        vec_sz_insert(v, vec_code(v), idx, x);
        return;
    }
    Vec_insert(v, idx, vec_mem_box(x, size));
}

/// One more owner of what the struct or enum of type `tid` at `p` holds
/// (its bytes were copied). The lowering writes the body.
pub fn __p_mem_dup(tid: i64, p: i64) {
}

/// Drop the owners held by the struct or enum of type `tid` (16 and up) at
/// `p`, which stays allocated. The lowering writes the body.
pub fn __p_mem_drop(tid: i64, p: i64) {
}

/// Drop or copy an element of a struct or enum type the compiler numbered
/// (16 and up). Core leaves these empty; the lowering writes their bodies
/// from the program's types.
pub fn __p_elem_drop(tid: i64, e: i64) {
}

pub fn __p_elem_dup(tid: i64, e: i64) -> i64 {
    return e;
}

// ─── Builtins that can fail (proposal 0004) ─────────────────────────────
// p_file_read, p_getenv, p_argv, p_read_line and p_read_stdin give a raw
// pointer, 0 when they fail: there is no null str. These give an Option.

/// The contents of file `path`, or None when it cannot be read.
pub fn read_file(path: str) -> Option<str> {
    var r: i64 = p_file_read(path);
    if r == 0 { return Option::None; }
    return Option::Some(p_str_adopt(r));
}

/// Environment variable `name`, or None when it is not set.
pub fn env_var(name: str) -> Option<str> {
    var r: i64 = p_getenv(name);
    if r == 0 { return Option::None; }
    return Option::Some(p_str_adopt(r));
}

/// Command-line argument `i` (0 is the program), or None past the last.
pub fn arg_at(i: i64) -> Option<str> {
    var r: i64 = p_argv(i);
    if r == 0 { return Option::None; }
    return Option::Some(p_str_adopt(r));
}

/// The next line of standard input, or None at its end.
pub fn read_line() -> Option<str> {
    var r: i64 = p_read_line();
    if r == 0 { return Option::None; }
    return Option::Some(p_str_adopt(r));
}

/// The next `n` bytes of standard input, or None at its end.
pub fn read_stdin(n: i64) -> Option<str> {
    var r: i64 = p_read_stdin(n);
    if r == 0 { return Option::None; }
    return Option::Some(p_str_adopt(r));
}

/// Zero `n` words at `p` (the compiler clears an owning struct variable
/// with it, proposal 0004).
pub fn p_zero_words(p: i64, n: i64) {
    var i: i64 = 0;
    while i < n {
        var wp: *mut i64 = p + i * 8;
        unsafe { *wp = 0; }
        i = i + 1;
    }
}

/// Drop the elements [from, to) of the buffer at `data` (word elements).
fn vec_drop_range(data: i64, from: i64, to: i64, tid: i64) {
    if tid == 0 || data == 0 { return; }
    var i: i64 = from;
    while i < to {
        var ep: *mut i64 = data + i * 8;
        var e: i64 = 0;
        unsafe { e = *ep; }
        vec_elem_drop(tid, e);
        i = i + 1;
    }
}

/// The word at +24 of a Vec header holding element code `code`: 0 for one
/// word per element, else P_VEC_TAG + code + 8. The tag makes a word that is
/// not one (a 24-byte header from an older runtime, which ends before +24)
/// read as a word Vec.
const P_VEC_TAG: i64 = 0x4649445645430000;

// Element types (proposal 0004): the word at +32 of a Vec header is
// P_TID_TAG + tid, and says how the Vec drops and copies its elements.
// 0 (no tag) is plain values; 16 and up are the program's structs and enums,
// numbered by the lowering (__p_elem_drop / __p_elem_dup).
const P_TID_TAG: i64 = 0x4649445449440000;
pub const P_TID_STR: i64 = 1;
pub const P_TID_VEC: i64 = 2;
pub const P_TID_MAP: i64 = 3;

// Length-headered strings (RT2): p_str_alloc returns data at alloc+16 with
// [magic:i64 at -16][len:i64 at -8] before it, so str_len is O(1) and bytes
// may contain NUL. Non-headered strings (literals, C-returned pointers)
// still work — the magic check misses and we scan.
const P_STR_MAGIC: i64 = 0x4649444553545201;
// The same header on a string literal (release D16): never freed.
const P_STR_STATIC: i64 = 0x4649444553545202;
// A counted heap string (proposal 0004): the word is P_STR_RC + its count of
// owners (1 .. P_STR_RC_MAX - 1). P_STR_MAGIC (above) still marks a headered
// string nobody counts: never freed by a drop.
const P_STR_RC: i64 = 0x4649444500000000;
const P_STR_RC_MAX: i64 = 0x40000000;
// Set in the count word of a string made by p_str_append: its block is the
// power of two at least len + 17, so it has room to grow in place
const P_STR_ROOM: i64 = 0x80000000;
// The header word of a counted string its last owner freed
const P_STR_DEAD: i64 = 0x4649444553545203;

@crashfree
@wrapping
pub fn vec_code_word(code: i64) -> i64 {
    if code == 0 { return 0; }
    return P_VEC_TAG + code + 8;
}

/// The element code of a Vec (0: one word per element).
@crashfree
@wrapping
pub fn vec_code(v: i64) -> i64 {
    if v == 0 { return 0; }
    var p24: *mut i64 = v + 24;
    var c: i64 = 0;
    unsafe { c = *p24; }
    if c == 0 { return 0; }
    var low: i64 = c & 255;
    if c - low != P_VEC_TAG { return 0; }
    return low - 8;
}

/// Bytes per element for an element code.
@crashfree
@wrapping
pub fn vec_esz(code: i64) -> i64 {
    if code == 0 { return 8; }
    if code < 0 { return 0 - code; }
    if code >= 16 { return (code - 15) * 8; }
    return code;
}

/// Element `i` of the data at `data`, stored with element code `code`.
@crashfree
@wrapping
pub fn vec_ld(data: i64, i: i64, code: i64) -> i64 {
    // a struct stored in the buffer (release D15): its address
    if code >= 16 { return data + i * vec_esz(code); }
    if code == 1 {
        var p1: *mut u8 = data + i;
        var x1: u8 = 0;
        unsafe { x1 = *p1; }
        return x1 as i64;
    }
    if code == -1 {
        var sgn1: *mut i8 = data + i;
        var y1: i8 = 0;
        unsafe { y1 = *sgn1; }
        return y1 as i64;
    }
    if code == 2 {
        var p2: *mut u16 = data + i * 2;
        var x2: u16 = 0;
        unsafe { x2 = *p2; }
        return x2 as i64;
    }
    if code == -2 {
        var sgn2: *mut i16 = data + i * 2;
        var y2: i16 = 0;
        unsafe { y2 = *sgn2; }
        return y2 as i64;
    }
    if code == 4 {
        var p4: *mut u32 = data + i * 4;
        var x4: u32 = 0;
        unsafe { x4 = *p4; }
        return x4 as i64;
    }
    if code == -4 {
        var sgn4: *mut i32 = data + i * 4;
        var y4: i32 = 0;
        unsafe { y4 = *sgn4; }
        return y4 as i64;
    }
    var p8: *mut i64 = data + i * 8;
    var x8: i64 = 0;
    unsafe { x8 = *p8; }
    return x8;
}

/// Store `x` (its low bytes) as element `i` of the data at `data`.
@wrapping
pub fn vec_st(data: i64, i: i64, code: i64, x: i64) {
    // a struct stored in the buffer (release D15): its bytes, from `x`
    if code >= 16 {
        if x != 0 { vec_copy_bytes(data + i * vec_esz(code), x, vec_esz(code)); }
        return;
    }
    if code == 1 || code == -1 {
        var p1: *mut u8 = data + i;
        unsafe { *p1 = (x & 255) as u8; }
        return;
    }
    if code == 2 || code == -2 {
        var p2: *mut u16 = data + i * 2;
        unsafe { *p2 = (x & 65535) as u16; }
        return;
    }
    if code == 4 || code == -4 {
        var p4: *mut u32 = data + i * 4;
        unsafe { *p4 = (x & 4294967295) as u32; }
        return;
    }
    var p8: *mut i64 = data + i * 8;
    unsafe { *p8 = x; }
}

/// Copy `n` bytes.
fn vec_copy_bytes(dst: i64, src: i64, n: i64) {
    var off: i64 = 0;
    while off + 8 <= n {
        var s8: *mut i64 = src + off;
        var d8: *mut i64 = dst + off;
        unsafe { *d8 = *s8; }
        off = off + 8;
    }
    while off < n {
        var s1: *mut u8 = src + off;
        var d1: *mut u8 = dst + off;
        unsafe { *d1 = *s1; }
        off = off + 1;
    }
}

fn vec_sz_hdr(v: i64, w: i64) -> i64 {
    var p: *mut i64 = v + w * 8;
    var x: i64 = 0;
    unsafe { x = *p; }
    return x;
}

fn vec_sz_put(v: i64, w: i64, x: i64) {
    var p: *mut i64 = v + w * 8;
    unsafe { *p = x; }
}

/// Room for one more element of a sized Vec (its data is its own: vec_own
/// ran).
fn vec_sz_reserve(v: i64, code: i64, need: i64) {
    var cap: i64 = vec_sz_hdr(v, 2);
    if need <= cap { return; }
    var nc: i64 = 8;
    if cap > 0 { nc = cap * 2; }
    if nc < need { nc = need; }
    var esz: i64 = vec_esz(code);
    var nd: i64 = vec_buf_alloc(nc * esz);
    var od: i64 = vec_sz_hdr(v, 0);
    if od != 0 {
        vec_copy_bytes(nd, od, vec_sz_hdr(v, 1) * esz);
        vec_buf_free(od);
    }
    vec_sz_put(v, 0, nd);
    vec_sz_put(v, 2, nc);
}

pub fn vec_sz_push(v: i64, code: i64, value: i64) {
    var len: i64 = vec_sz_hdr(v, 1);
    vec_sz_reserve(v, code, len + 1);
    vec_st(vec_sz_hdr(v, 0), len, code, value);
    vec_sz_put(v, 1, len + 1);
}

pub fn vec_sz_get(v: i64, idx: i64) -> i64 {
    var len: i64 = vec_sz_hdr(v, 1);
    if idx >= len { p_panic("Vec index out of bounds"); }
    if idx < 0 { p_panic("Vec index out of bounds"); }
    return vec_ld(vec_sz_hdr(v, 0), idx, vec_code(v));
}

pub fn vec_sz_set(v: i64, idx: i64, value: i64) {
    var len: i64 = vec_sz_hdr(v, 1);
    if idx >= len { p_panic("Vec index out of bounds"); }
    if idx < 0 { p_panic("Vec index out of bounds"); }
    var code: i64 = vec_code(v);
    if code >= 16 { vec_mem_drop_range(v, vec_sz_hdr(v, 0), idx, idx + 1); }
    vec_st(vec_sz_hdr(v, 0), idx, code, value);
}

pub fn vec_sz_pop(v: i64) -> i64 {
    var len: i64 = vec_sz_hdr(v, 1);
    if len == 0 { return 0; }
    vec_sz_put(v, 1, len - 1);
    // a struct taken from a buffer other Vecs share stays theirs too: the
    // caller gets owners of its own
    if vec_code(v) >= 16 && vec_sz_hdr(v, 2) < 0 { vec_mem_dup_range(v, vec_sz_hdr(v, 0), len - 1, len); }
    return vec_ld(vec_sz_hdr(v, 0), len - 1, vec_code(v));
}

fn vec_sz_insert(v: i64, code: i64, idx: i64, value: i64) {
    var len: i64 = vec_sz_hdr(v, 1);
    if idx < 0 || idx > len { p_panic("Vec index out of bounds"); }
    vec_sz_reserve(v, code, len + 1);
    var data: i64 = vec_sz_hdr(v, 0);
    var i: i64 = len;
    while i > idx {
        vec_st(data, i, code, vec_ld(data, i - 1, code));
        i = i - 1;
    }
    vec_st(data, idx, code, value);
    vec_sz_put(v, 1, len + 1);
}

fn vec_sz_remove(v: i64, code: i64, idx: i64) -> i64 {
    var len: i64 = vec_sz_hdr(v, 1);
    if idx < 0 || idx >= len { p_panic("Vec index out of bounds"); }
    var data: i64 = vec_sz_hdr(v, 0);
    if code >= 16 {
        // the struct moves to the slot after the new end, where the caller
        // finds it (as after a pop)
        var esz: i64 = vec_esz(code);
        var tmp: i64 = p_malloc(esz);
        vec_copy_bytes(tmp, data + idx * esz, esz);
        var k: i64 = idx;
        while k + 1 < len {
            vec_copy_bytes(data + k * esz, data + (k + 1) * esz, esz);
            k = k + 1;
        }
        vec_copy_bytes(data + (len - 1) * esz, tmp, esz);
        p_free(tmp);
        vec_sz_put(v, 1, len - 1);
        return data + (len - 1) * esz;
    }
    var out: i64 = vec_ld(data, idx, code);
    var i: i64 = idx;
    while i + 1 < len {
        vec_st(data, i, code, vec_ld(data, i + 1, code));
        i = i + 1;
    }
    vec_sz_put(v, 1, len - 1);
    return out;
}

fn vec_sz_sift(data: i64, code: i64, root: i64, n: i64) {
    var r: i64 = root;
    while r * 2 + 1 < n {
        var child: i64 = r * 2 + 1;
        if child + 1 < n && vec_ld(data, child, code) < vec_ld(data, child + 1, code) { child = child + 1; }
        var a: i64 = vec_ld(data, r, code);
        var b: i64 = vec_ld(data, child, code);
        if a >= b { return; }
        vec_st(data, r, code, b);
        vec_st(data, child, code, a);
        r = child;
    }
}

fn vec_sz_sort(v: i64, code: i64) {
    var n: i64 = vec_sz_hdr(v, 1);
    if n <= 1 { return; }
    // structs have no order of their own
    if code >= 16 { return; }
    var data: i64 = vec_sz_hdr(v, 0);
    var start: i64 = n / 2 - 1;
    while start >= 0 {
        vec_sz_sift(data, code, start, n);
        start = start - 1;
    }
    var end: i64 = n - 1;
    while end > 0 {
        var t: i64 = vec_ld(data, 0, code);
        vec_st(data, 0, code, vec_ld(data, end, code));
        vec_st(data, end, code, t);
        vec_sz_sift(data, code, 0, end);
        end = end - 1;
    }
}

/// Drop one owner of a Vec (proposal 0004): its header is freed, and the
/// last owner of the buffer frees the buffer and drops the elements.
pub fn Vec_drop(v: i64) {
    if v == 0 { return; }
    var p: *mut i64 = v;
    var lp: *mut i64 = v + 8;
    var cp: *mut i64 = v + 16;
    var data: i64 = 0;
    var len: i64 = 0;
    var cap: i64 = 0;
    unsafe { data = *p; len = *lp; cap = *cp; }
    var last: bool = true;
    if cap < 0 {
        // Shared data: one fewer owner; freed at the last.
        var bx: i64 = 0 - cap - 1;
        var b0: *mut i64 = bx;
        var n: i64 = 0;
        unsafe { n = *b0; *b0 = n - 1; }
        if n <= 1 { vec_box_free(bx, data); } else { last = false; }
    }
    if last && data != 0 {
        if vec_code(v) == 0 { vec_drop_range(data, 0, len, vec_tid(v)); }
        else { vec_mem_drop_range(v, data, 0, len); }
        vec_buf_free(data);
    }
    p_free(v);
}

/// Whether this Vec is the last owner of its data: sole (cap >= 0) or the
/// only one left in its share group.
pub fn vec_last_owner(v: i64) -> bool {
    var cp: *mut i64 = v + 16;
    var cap: i64 = 0;
    unsafe { cap = *cp; }
    if cap >= 0 { return true; }
    var b0: *mut i64 = 0 - cap - 1;
    var n: i64 = 0;
    unsafe { n = *b0; }
    return n <= 1;
}

/// Older name: a Vec drops what it owns by its element type now.
pub fn Vec_drop_strs(v: i64) {
    Vec_drop(v);
}

/// Older name: a Vec drops what it owns by its element type now.
pub fn Vec_drop_vecs(v: i64) {
    Vec_drop(v);
}

/// Drop one owner of a map (proposal 0004): its header is freed, and the
/// last owner of the tables drops the keys and values it owns.
pub fn HashMap_drop(m: i64) {
    if m == 0 { return; }
    var kp: *mut i64 = m;
    var vp: *mut i64 = m + 8;
    var cp: *mut i64 = m + 24;
    var keys: i64 = 0;
    var vals: i64 = 0;
    var cap: i64 = 0;
    var sp: *mut i64 = m + 32;
    var shared: i64 = 0;
    unsafe { keys = *kp; vals = *vp; cap = *cp; shared = *sp; }
    var last: bool = true;
    if shared != 0 {
        var b0: *mut i64 = shared;
        var n: i64 = 0;
        unsafe { n = *b0; *b0 = n - 1; }
        if n <= 1 { p_free(shared); } else { last = false; }
    }
    if last {
        if keys != 0 && hm_types(m) != 0 {
            var i: i64 = 0;
            while i < cap {
                hm_drop_slot(m, keys, vals, i);
                i = i + 1;
            }
        }
        if keys != 0 { p_free(keys); }
        if vals != 0 { p_free(vals); }
    }
    p_free(m);
}

/// Copy-on-write: a second owner of a Vec's data (proposal 0004). Each owner
/// has its own header; a shared buffer gets a box {owners, capacity}, and the
/// capacity slot of each header holds -box-1 (negative, so cap >= 0 still
/// means "sole owner, real capacity"). The first change through one owner
/// copies the buffer (vec_own), the elements counted again by their type.
pub fn Vec_share(v: i64) -> i64 {
    if v == 0 { return v; }
    var p0: *mut i64 = v;
    var p8: *mut i64 = v + 8;
    var p16: *mut i64 = v + 16;
    var data: i64 = 0;
    var len: i64 = 0;
    var cap: i64 = 0;
    unsafe { data = *p0; len = *p8; cap = *p16; }
    if data == 0 { return Vec_new_typed(vec_code(v), vec_tid(v)); }
    var marked: i64 = cap;
    if cap >= 0 {
        var bx: i64 = 0;
        if vec_buf_tagged(data) { bx = data - 16; } else { bx = p_malloc(16); }
        var b0: *mut i64 = bx;
        var b8: *mut i64 = bx + 8;
        unsafe { *b0 = 2; *b8 = cap; }
        marked = 0 - bx - 1;
        unsafe { *p16 = marked; }
    } else {
        var rc: *mut i64 = 0 - cap - 1;
        var n: i64 = 0;
        unsafe { n = *rc; *rc = n + 1; }
    }
    var nv: i64 = p_malloc(40);
    var nv0: *mut i64 = nv;
    var nv8: *mut i64 = nv + 8;
    var nv16: *mut i64 = nv + 16;
    var nv24: *mut i64 = nv + 24;
    var nv32: *mut i64 = nv + 32;
    unsafe {
        *nv0 = data;
        *nv8 = len;
        *nv16 = marked;
        *nv24 = vec_code_word(vec_code(v));
        *nv32 = 0;
    }
    var t: i64 = vec_tid(v);
    if t != 0 { unsafe { *nv32 = P_TID_TAG + t; } }
    return nv;
}

/// Older name: the element type in the header says how elements are copied.
pub fn Vec_share_deep(v: i64, kind: i64, words: i64, vec_mask: i64) -> i64 {
    return Vec_share(v);
}


/// Before a change that writes a Vec's data (or one of its elements): if
/// another Vec shares the data (negative capacity: a box), this Vec takes the
/// buffer over as its last owner, or gets a copy of its own whose elements
/// have one more owner each, so the change is this Vec's alone.
pub fn vec_own(v: i64) {
    var p16: *mut i64 = v + 16;
    var cap: i64 = 0;
    unsafe { cap = *p16; }
    if cap >= 0 { return; }
    var bx: i64 = 0 - cap - 1;
    var b0: *mut i64 = bx;
    var b8: *mut i64 = bx + 8;
    var owners: i64 = 0;
    unsafe { owners = *b0; cap = *b8; }
    var p0: *mut i64 = v;
    var p8: *mut i64 = v + 8;
    var data: i64 = 0;
    var len: i64 = 0;
    unsafe { data = *p0; len = *p8; }
    if owners <= 1 {
        // Last owner: keep the buffer and its elements, drop the box.
        vec_box_free(bx, data);
        unsafe { *p16 = cap; }
        return;
    }
    unsafe { *b0 = owners - 1; }
    if cap < 8 { cap = 8; }
    if cap < len { cap = len; }
    var vcode: i64 = vec_code(v);
    if vcode != 0 {
        var snd: i64 = vec_buf_alloc(cap * vec_esz(vcode));
        vec_copy_bytes(snd, data, len * vec_esz(vcode));
        // structs in the buffer: the copy is one more owner of each
        vec_mem_dup_range(v, snd, 0, len);
        unsafe {
            *p0 = snd;
            *p16 = cap;
        }
        return;
    }
    var tid: i64 = vec_tid(v);
    var nd: i64 = vec_buf_alloc(cap * 8);
    var i: i64 = 0;
    while i < len {
        var src: *mut i64 = data + i * 8;
        var dst: *mut i64 = nd + i * 8;
        var e: i64 = 0;
        unsafe { e = *src; }
        e = vec_elem_dup(tid, e);
        unsafe { *dst = e; }
        i = i + 1;
    }
    unsafe {
        *p0 = nd;
        *p16 = cap;
    }
}

/// Drop one owner of a string (proposal 0004): its last owner frees a
/// counted string. Literals, uncounted strings and null are left alone; a
/// string already freed through its count stops the program.
pub fn Str_drop(s: i64) {
    if s == 0 { return; }
    var mp: *mut i64 = s - 16;
    var lp: *mut i64 = s - 8;
    var w: i64 = 0;
    var l: i64 = 0;
    unsafe { w = *mp; l = *lp; }
    if !p_str_len_word(l) { return; }
    if w == P_STR_DEAD { p_panic("string used after it was freed"); }
    var c: i64 = p_str_count_of(w);
    if c == 0 { return; }
    if c > 1 {
        unsafe { *mp = w - 1; }
        return;
    }
    unsafe { *mp = P_STR_DEAD; }
    p_free(s - 16);
}

/// One more owner of a string (proposal 0004); returns `s`.
pub fn Str_dup(s: i64) -> i64 {
    if s == 0 { return s; }
    var mp: *mut i64 = s - 16;
    var lp: *mut i64 = s - 8;
    var w: i64 = 0;
    var l: i64 = 0;
    unsafe { w = *mp; l = *lp; }
    if !p_str_len_word(l) { return s; }
    if w == P_STR_DEAD { p_panic("string used after it was freed"); }
    var c: i64 = p_str_count_of(w);
    if c > 0 && c < P_STR_RC_MAX - 1 {
        unsafe { *mp = w + 1; }
    }
    return s;
}

pub fn Vec_push(v: i64, value: i64) {
    vec_own(v);
    var vcode: i64 = vec_code(v);
    if vcode != 0 { vec_sz_push(v, vcode, value); return; }
    var len_ptr: *mut i64 = v + 8;
    var cap_ptr: *mut i64 = v + 16;
    var data_ptr_ptr: *mut i64 = v;

    var len: i64;
    var capacity: i64;
    var data: i64;

    unsafe {
        len = *len_ptr;
        capacity = *cap_ptr;
        data = *data_ptr_ptr;
    }

    if len >= capacity {
        var new_capacity: i64 = 8;
        if capacity > 0 {
            new_capacity = capacity * 2;
        }
        var new_data: i64 = vec_buf_alloc(new_capacity * 8);

        var i: i64 = 0;
        while i < len {
            var src_addr: i64 = data + i * 8;
            var src_ptr: *mut i64 = src_addr;
            var dst_addr: i64 = new_data + i * 8;
            var dst_ptr: *mut i64 = dst_addr;
            unsafe {
                var old_val: i64 = *src_ptr;
                *dst_ptr = old_val;
            }
            i = i + 1;
        }

        if data != 0 {
            vec_buf_free(data);
        }

        unsafe {
            *data_ptr_ptr = new_data;
            *cap_ptr = new_capacity;
        }
    }

    unsafe {
        data = *data_ptr_ptr;
    }

    var addr: i64 = data + len * 8;
    var elem_ptr: *mut i64 = addr;
    unsafe {
        *elem_ptr = value;
    }

    var new_len: i64 = len + 1;
    unsafe {
        *len_ptr = new_len;
    }
}

/// The last element, taken out: the caller owns it (proposal 0004). From a
/// shared buffer the element stays the other owners' too, so it gets one
/// more owner.
pub fn Vec_pop(v: i64) -> i64 {
    if vec_code(v) != 0 { return vec_sz_pop(v); }
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;
    var cap_ptr: *mut i64 = v + 16;
    var len: i64 = 0;
    var data: i64 = 0;
    var cap: i64 = 0;
    unsafe { len = *len_ptr; data = *data_ptr_ptr; cap = *cap_ptr; }
    if len == 0 { return 0; }
    var elem_ptr: *mut i64 = data + (len - 1) * 8;
    var result: i64 = 0;
    unsafe { result = *elem_ptr; }
    unsafe { *len_ptr = len - 1; }
    if cap < 0 { result = vec_elem_dup(vec_tid(v), result); }
    return result;
}

pub fn Vec_len(v: i64) -> i64 {
    var len_ptr: *mut i64 = v + 8;
    var result: i64;
    unsafe {
        result = *len_ptr;
    }
    return result;
}

pub fn Vec_is_empty(v: i64) -> bool {
    var len_ptr: *mut i64 = v + 8;
    var len: i64;
    unsafe {
        len = *len_ptr;
    }
    return len == 0;
}

pub fn Vec_get(v: i64, idx: i64) -> i64 {
    if vec_code(v) != 0 { return vec_sz_get(v, idx); }
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if idx >= len {
        p_panic("Vec index out of bounds");
    }
    if idx < 0 {
        p_panic("Vec index out of bounds");
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    var addr: i64 = data + idx * 8;
    var ptr: *mut i64 = addr;
    var result: i64 = 0;
    unsafe {
        result = *ptr;
    }
    return result;
}

/// The element of `v` at `idx`, or `default` when `idx` is out of bounds.
/// Never panics, so @crashfree code can use it where it cannot loop over
/// `0..v.len()`.
@crashfree
@wrapping
pub fn vec_get_or(v: Vec<i64>, idx: i64, default: i64) -> i64 {
    var h: i64 = v;
    var gcode: i64 = vec_code(h);
    if gcode != 0 {
        var glen_p: *mut i64 = h + 8;
        var gdata_p: *mut i64 = h;
        var glen: i64 = 0;
        var gdata: i64 = 0;
        unsafe { glen = *glen_p; gdata = *gdata_p; }
        if idx < 0 || idx >= glen { return default; }
        return vec_ld(gdata, idx, gcode);
    }
    var len_ptr: *mut i64 = h + 8;
    var len: i64 = 0;
    unsafe {
        len = *len_ptr;
    }
    if idx < 0 || idx >= len {
        return default;
    }
    var data_ptr_ptr: *mut i64 = h;
    var data: i64 = 0;
    unsafe {
        data = *data_ptr_ptr;
    }
    var ptr: *mut i64 = data + idx * 8;
    var result: i64 = 0;
    unsafe {
        result = *ptr;
    }
    return result;
}

/// `==` on two Vecs of numbers or bools (proposal 0001): same length, and
/// equal element by element (word by word).
pub fn Vec_eq_words(a: i64, b: i64) -> bool {
    if a == b { return true; }
    if a == 0 || b == 0 { return false; }
    var n: i64 = Vec_len(a);
    if n != Vec_len(b) { return false; }
    var i: i64 = 0;
    while i < n {
        if Vec_get(a, i) != Vec_get(b, i) { return false; }
        i = i + 1;
    }
    return true;
}

/// `==` on two Vec<str>: same length, and equal strings element by element.
pub fn Vec_eq_strs(a: i64, b: i64) -> bool {
    if a == b { return true; }
    if a == 0 || b == 0 { return false; }
    var n: i64 = Vec_len(a);
    if n != Vec_len(b) { return false; }
    var i: i64 = 0;
    while i < n {
        if !str_equal(Vec_get(a, i), Vec_get(b, i)) { return false; }
        i = i + 1;
    }
    return true;
}

/// Element `idx` becomes `value`, which the Vec now owns; the old element is
/// dropped (proposal 0004).
pub fn Vec_set(v: i64, idx: i64, value: i64) {
    vec_own(v);
    if vec_code(v) != 0 { vec_sz_set(v, idx, value); return; }
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;
    var len: i64 = 0;
    var data: i64 = 0;
    unsafe { len = *len_ptr; data = *data_ptr_ptr; }
    if idx >= len || idx < 0 {
        p_panic("Vec index out of bounds");
    }
    var ptr: *mut i64 = data + idx * 8;
    var old: i64 = 0;
    unsafe { old = *ptr; *ptr = value; }
    if old != value { vec_elem_drop(vec_tid(v), old); }
}

/// Remove every element; a sole owner drops them.
pub fn Vec_clear(v: i64) {
    Vec_truncate(v, 0);
}

pub fn Vec_capacity(v: i64) -> i64 {
    var cap_ptr: *mut i64 = v + 16;
    var result: i64;
    unsafe {
        result = *cap_ptr;
    }
    // shared data stores -box-1; the capacity is the box's second word
    if result < 0 {
        var b8: *mut i64 = 0 - result - 1 + 8;
        unsafe { result = *b8; }
    }
    return result;
}

pub fn Vec_contains(v: i64, value: i64) -> bool {
    if vec_code(v) != 0 {
        var cn: i64 = Vec_len(v);
        var ci: i64 = 0;
        while ci < cn {
            if vec_sz_get(v, ci) == value { return true; }
            ci = ci + 1;
        }
        return false;
    }
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    var i: i64 = 0;
    while i < len {
        var addr: i64 = data + i * 8;
        var ptr: *mut i64 = addr;
        var elem: i64 = 0;
        unsafe {
            elem = *ptr;
        }
        if elem == value {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn Vec_first(v: i64) -> i64 {
    if vec_code(v) != 0 {
        if Vec_len(v) == 0 { p_panic("Vec is empty"); }
        return vec_sz_get(v, 0);
    }
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if len == 0 {
        p_panic("Vec is empty");
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    var ptr: *mut i64 = data;
    var result: i64 = 0;
    unsafe {
        result = *ptr;
    }
    return result;
}

pub fn Vec_last(v: i64) -> i64 {
    if vec_code(v) != 0 {
        if Vec_len(v) == 0 { p_panic("Vec is empty"); }
        return vec_sz_get(v, Vec_len(v) - 1);
    }
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if len == 0 {
        p_panic("Vec is empty");
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    var addr: i64 = data + (len - 1) * 8;
    var ptr: *mut i64 = addr;
    var result: i64 = 0;
    unsafe {
        result = *ptr;
    }
    return result;
}

/// Keep the first `n` elements; a sole owner drops the rest (shared ones
/// stay the other owners').
pub fn Vec_truncate(v: i64, n: i64) {
    var len_ptr: *mut i64 = v + 8;
    var cap_ptr: *mut i64 = v + 16;
    var data_ptr_ptr: *mut i64 = v;
    var len: i64 = 0;
    var cap: i64 = 0;
    var data: i64 = 0;
    unsafe { len = *len_ptr; cap = *cap_ptr; data = *data_ptr_ptr; }
    if n < 0 || n >= len { return; }
    if cap >= 0 && vec_code(v) == 0 { vec_drop_range(data, n, len, vec_tid(v)); }
    if cap >= 0 && vec_code(v) >= 16 { vec_mem_drop_range(v, data, n, len); }
    unsafe { *len_ptr = n; }
}

pub fn Vec_reverse(v: i64) {
    vec_own(v);
    vec_raw_reverse(v);
}

pub fn vec_raw_reverse(v: i64) {
    vec_own(v);
    var rcode: i64 = vec_code(v);
    if rcode != 0 {
        var rn: i64 = Vec_len(v);
        var rd: i64 = vec_sz_hdr(v, 0);
        var ri: i64 = 0;
        while ri < rn / 2 {
            var lo: i64 = vec_ld(rd, ri, rcode);
            vec_st(rd, ri, rcode, vec_ld(rd, rn - 1 - ri, rcode));
            vec_st(rd, rn - 1 - ri, rcode, lo);
            ri = ri + 1;
        }
        return;
    }
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    var i: i64 = 0;
    while i < len / 2 {
        var lo_addr: i64 = data + i * 8;
        var hi_addr: i64 = data + (len - 1 - i) * 8;
        var lo_ptr: *mut i64 = lo_addr;
        var hi_ptr: *mut i64 = hi_addr;
        unsafe {
            var lo_val: i64 = *lo_ptr;
            var hi_val: i64 = *hi_ptr;
            *lo_ptr = hi_val;
            *hi_ptr = lo_val;
        }
        i = i + 1;
    }
}

pub fn Vec_extend(v: i64, other: i64) {
    vec_own(v);
    vec_raw_extend(v, other);
}

/// Append copies of `other`'s elements (each gets one more owner).
pub fn vec_raw_extend(v: i64, other: i64) {
    vec_own(v);
    var tid: i64 = vec_tid(other);
    var ocode: i64 = vec_code(other);
    if ocode >= 16 || vec_code(v) >= 16 {
        // structs: copied into `v`'s buffer (an empty Vec takes that
        // layout), or boxed one by one into a Vec that holds boxes
        var esz: i64 = 0;
        if ocode >= 16 { esz = vec_esz(ocode); } else { esz = vec_esz(vec_code(v)); }
        var stid: i64 = tid;
        if stid == 0 { stid = vec_tid(v); }
        var inl: bool = vec_mem_prepare(v, esz, stid);
        var sn: i64 = Vec_len(other);
        var si: i64 = 0;
        while si < sn {
            var src: i64 = Vec_get(other, si);
            if inl {
                vec_sz_push(v, vec_code(v), src);
                var nl: i64 = Vec_len(v);
                vec_mem_dup_range(v, vec_sz_hdr(v, 0), nl - 1, nl);
            } else {
                var bx: i64 = vec_mem_box(src, esz);
                if stid >= 16 && stid < P_TID_BOX { __p_mem_dup(stid, bx); }
                Vec_push(v, bx);
            }
            si = si + 1;
        }
        return;
    }
    if vec_code(v) != 0 || vec_code(other) != 0 {
        var en: i64 = Vec_len(other);
        var ei: i64 = 0;
        while ei < en {
            Vec_push(v, Vec_get(other, ei));
            ei = ei + 1;
        }
        return;
    }
    var other_len_ptr: *mut i64 = other + 8;
    var other_data_ptr_ptr: *mut i64 = other;
    var other_len: i64 = 0;
    var other_data: i64 = 0;
    unsafe { other_len = *other_len_ptr; other_data = *other_data_ptr_ptr; }
    var i: i64 = 0;
    while i < other_len {
        var ptr: *mut i64 = other_data + i * 8;
        var elem: i64 = 0;
        unsafe { elem = *ptr; }
        Vec_push(v, vec_elem_dup(tid, elem));
        i = i + 1;
    }
}

pub fn Vec_insert(v: i64, idx: i64, value: i64) {
    vec_own(v);
    vec_raw_insert(v, idx, value);
}

pub fn vec_raw_insert(v: i64, idx: i64, value: i64) {
    vec_own(v);
    var icode: i64 = vec_code(v);
    if icode != 0 { vec_sz_insert(v, icode, idx, value); return; }
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if idx < 0 {
        p_panic("Vec insert index out of bounds");
    }
    if idx > len {
        p_panic("Vec insert index out of bounds");
    }

    // Push a dummy to grow if needed, then shift elements right
    Vec_push(v, 0);

    // Re-read len and data (push may have reallocated)
    unsafe {
        len = *len_ptr;
    }
    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    // Shift elements right from end to idx
    var i: i64 = len - 1;
    while i > idx {
        var cur_addr: i64 = data + i * 8;
        var prev_addr: i64 = data + (i - 1) * 8;
        var cur_ptr: *mut i64 = cur_addr;
        var prev_ptr: *mut i64 = prev_addr;
        unsafe {
            var prev_val: i64 = *prev_ptr;
            *cur_ptr = prev_val;
        }
        i = i - 1;
    }

    // Store the new value at idx
    var addr: i64 = data + idx * 8;
    var ptr: *mut i64 = addr;
    unsafe {
        *ptr = value;
    }
}

pub fn Vec_remove(v: i64, idx: i64) -> i64 {
    vec_own(v);
    return vec_raw_remove(v, idx);
}

pub fn vec_raw_remove(v: i64, idx: i64) -> i64 {
    var mcode: i64 = vec_code(v);
    if mcode != 0 { vec_own(v); return vec_sz_remove(v, mcode, idx); }
    vec_own(v);
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    if idx < 0 {
        p_panic("Vec remove index out of bounds");
    }
    if idx >= len {
        p_panic("Vec remove index out of bounds");
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    // Get the value at idx
    var addr: i64 = data + idx * 8;
    var ptr: *mut i64 = addr;
    var result: i64 = 0;
    unsafe {
        result = *ptr;
    }

    // Shift elements left
    var i: i64 = idx;
    while i < len - 1 {
        var cur_addr: i64 = data + i * 8;
        var next_addr: i64 = data + (i + 1) * 8;
        var cur_ptr: *mut i64 = cur_addr;
        var next_ptr: *mut i64 = next_addr;
        unsafe {
            var next_val: i64 = *next_ptr;
            *cur_ptr = next_val;
        }
        i = i + 1;
    }

    // Decrement len
    var new_len: i64 = len - 1;
    unsafe {
        *len_ptr = new_len;
    }

    return result;
}

/// A Vec of its own with the same elements (each gets one more owner).
pub fn Vec_clone(v: i64) -> i64 {
    var kcode: i64 = vec_code(v);
    var tid: i64 = vec_tid(v);
    if kcode != 0 {
        var kv: i64 = Vec_new_typed(kcode, tid);
        var kn: i64 = Vec_len(v);
        var ki: i64 = 0;
        while ki < kn {
            vec_sz_push(kv, kcode, vec_sz_get(v, ki));
            ki = ki + 1;
        }
        vec_mem_dup_range(kv, vec_sz_hdr(kv, 0), 0, kn);
        return kv;
    }
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;
    var len: i64 = 0;
    var data: i64 = 0;
    unsafe { len = *len_ptr; data = *data_ptr_ptr; }
    var new_v: i64 = Vec_new_typed(0, tid);
    var i: i64 = 0;
    while i < len {
        var ptr: *mut i64 = data + i * 8;
        var elem: i64 = 0;
        unsafe { elem = *ptr; }
        Vec_push(new_v, vec_elem_dup(tid, elem));
        i = i + 1;
    }
    return new_v;
}

pub fn Vec_to_str(v: i64) -> str {
    if vec_code(v) != 0 {
        var sr: str = "[";
        var sn: i64 = Vec_len(v);
        var si: i64 = 0;
        while si < sn {
            if si > 0 { sr = sr + ", "; }
            sr = sr + p_to_str(vec_sz_get(v, si));
            si = si + 1;
        }
        return sr + "]";
    }
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    // Build string: "[1, 2, 3]"
    var result: str = "[";
    var i: i64 = 0;
    while i < len {
        if i > 0 {
            result = result + ", ";
        }
        var addr: i64 = data + i * 8;
        var ptr: *mut i64 = addr;
        var elem: i64 = 0;
        unsafe {
            elem = *ptr;
        }
        result = result + p_to_str(elem);
        i = i + 1;
    }
    result = result + "]";
    return result;
}

/// Sort ascending (elements compared as i64), in place: heapsort,
/// O(n log n) time and no extra memory.
pub fn Vec_sort(v: i64) {
    vec_own(v);
    vec_raw_sort(v);
}

pub fn vec_raw_sort(v: i64) {
    vec_own(v);
    var scode: i64 = vec_code(v);
    if scode != 0 { vec_sz_sort(v, scode); return; }
    var len_ptr: *mut i64 = v + 8;
    var data_ptr_ptr: *mut i64 = v;

    var len: i64;
    unsafe {
        len = *len_ptr;
    }

    var data: i64;
    unsafe {
        data = *data_ptr_ptr;
    }

    if len <= 1 {
        return;
    }

    var start: i64 = len / 2 - 1;
    while start >= 0 {
        vec_sift_down(data, start, len);
        start = start - 1;
    }
    var end: i64 = len - 1;
    while end > 0 {
        vec_swap_slots(data, 0, end);
        vec_sift_down(data, 0, end);
        end = end - 1;
    }
}

fn vec_slot(data: i64, i: i64) -> i64 {
    var p: *mut i64 = data + i * 8;
    var x: i64 = 0;
    unsafe { x = *p; }
    return x;
}

fn vec_swap_slots(data: i64, i: i64, j: i64) {
    var pi: *mut i64 = data + i * 8;
    var pj: *mut i64 = data + j * 8;
    unsafe {
        var a: i64 = *pi;
        *pi = *pj;
        *pj = a;
    }
}

/// Restore the max-heap property below `root` among the first `n` slots.
fn vec_sift_down(data: i64, root: i64, n: i64) {
    var r: i64 = root;
    var done: bool = false;
    while !done {
        var child: i64 = 2 * r + 1;
        if child >= n {
            done = true;
        } else {
            if child + 1 < n && vec_slot(data, child) < vec_slot(data, child + 1) {
                child = child + 1;
            }
            if vec_slot(data, r) >= vec_slot(data, child) {
                done = true;
            } else {
                vec_swap_slots(data, r, child);
                r = child;
            }
        }
    }
}

// ─── HashMap (Phase 10B) ────────────────────────────────────────────────
// Open-addressing hash map with linear probing.
// Keys are string pointers (i64 addresses to null-terminated strings).
// Values are i64.
//
// Internal layout: 56-byte heap block (one per owner, see HashMap_share):
//   offset  0: keys_ptr  (*i64)  - array of key pointers (0 = empty, -1 = tombstone)
//   offset  8: vals_ptr  (*i64)  - array of values
//   offset 16: len        (i64)   - number of live entries
//   offset 24: capacity   (i64)   - size of keys/vals arrays
//   offset 32: shared     (i64)   - owner count box of shared tables, or 0
//   offset 40: int keys   (i64)   - 1 for an integer-keyed map
//   offset 48: types      (i64)   - P_TID_TAG + (0x10000 if it owns string
//                                   keys) + value type (proposal 0004)

// FNV-1a hash of a null-terminated string. s is an i64 address.
@wrapping pub fn p_str_hash(s: i64) -> i64 {
    // Byte loop (PE backends override with pert_str_hash's word loop, which
    // needs raw memory reads the interpreter's tagged values don't model).
    var hash: i64 = -3750763034362895579;
    var addr: i64 = s;
    var byte_ptr: *mut u8 = addr;
    unsafe {
        var b: i64 = *byte_ptr;
        while b != 0 {
            hash = hash ^ b;
            hash = hash * 1099511628211;
            addr = addr + 1;
            byte_ptr = addr;
            b = *byte_ptr;
        }
    }
    if hash < 0 { return -hash; }
    return hash;
}

// String equality: compare two null-terminated strings byte by byte.
// a and b are i64 addresses.
pub fn p_str_equal(a: i64, b: i64) -> bool {
    if a == b { return true; }
    if a == 0 { return false; }
    if b == 0 { return false; }
    // Both carry their length (D16): different lengths differ at once, and
    // equal ones compare a word at a time, zero bytes included
    var la: i64 = p_str_hdr_len(a);
    if la >= 0 {
        var lb: i64 = p_str_hdr_len(b);
        if lb >= 0 {
            if la != lb { return false; }
            var off: i64 = 0;
            unsafe {
                while off + 8 <= la {
                    var wa: *mut i64 = a + off;
                    var wb: *mut i64 = b + off;
                    if *wa != *wb { return false; }
                    off = off + 8;
                }
                while off < la {
                    var ba: *mut u8 = a + off;
                    var bb: *mut u8 = b + off;
                    var x: i64 = *ba;
                    var y: i64 = *bb;
                    if x != y { return false; }
                    off = off + 1;
                }
            }
            return true;
        }
    }
    var ai: i64 = a;
    var bi: i64 = b;
    var pa: *mut u8 = ai;
    var pb: *mut u8 = bi;
    unsafe {
        var ca: i64 = *pa;
        var cb: i64 = *pb;
        while ca != 0 && cb != 0 {
            if ca != cb { return false; }
            ai = ai + 1;
            bi = bi + 1;
            pa = ai;
            pb = bi;
            ca = *pa;
            cb = *pb;
        }
        return ca == cb;
    }
}

// Compare two null-terminated strings (i64 addresses).
// Returns <0 if a<b, 0 if equal, >0 if a>b (lexicographic).
fn p_str_compare(a: i64, b: i64) -> i64 {
    if a == b { return 0; }
    if a == 0 { return -1; }
    if b == 0 { return 1; }
    var ai: i64 = a;
    var bi: i64 = b;
    var pa: *mut u8 = ai;
    var pb: *mut u8 = bi;
    unsafe {
        var ca: i64 = *pa;
        var cb: i64 = *pb;
        while ca != 0 && cb != 0 {
            if ca != cb { return ca - cb; }
            ai = ai + 1;
            bi = bi + 1;
            pa = ai;
            pb = bi;
            ca = *pa;
            cb = *pb;
        }
        return ca - cb;
    }
}

// A HashMap header: [0] keys, [8] values, [16] len, [24] capacity,
// [32] shared (copy-on-write, proposal 0001: 1 when another header may hold
// the same arrays), [40] integer keys (1: keys are numbers, hashed and
// compared as numbers; set by the `_i` functions the compiler calls for a
// HashMap<i64, V>).
pub fn HashMap_new() -> i64 {
    var ptr: i64 = p_malloc(56);
    var i: i64 = 0;
    while i < 7 {
        var pw: *mut i64 = ptr + i * 8;
        unsafe { *pw = 0; }
        i = i + 1;
    }
    return ptr;
}

/// An empty map that owns its keys when `kown` (string keys) and its values
/// as element type `vtid` says (proposal 0004).
pub fn HashMap_new_typed(kown: bool, vtid: i64) -> i64 {
    var m: i64 = HashMap_new();
    var w: i64 = vtid;
    if kown { w = w + 0x10000; }
    if w != 0 {
        var tp: *mut i64 = m + 48;
        unsafe { *tp = P_TID_TAG + w; }
    }
    return m;
}

/// The type word of a map: 0x10000 set when it owns string keys, the low
/// 16 bits the value type.
@crashfree
@wrapping
fn hm_types(m: i64) -> i64 {
    if m == 0 { return 0; }
    var tp: *mut i64 = m + 48;
    var w: i64 = 0;
    unsafe { w = *tp; }
    var t: i64 = w - P_TID_TAG;
    if t > 0 && t < 0x80000 { return t & 0x1FFFF; }
    return 0;
}

// Set in a map's type word when its values block holds, after the `cap`
// values, each slot's hash (HashMap_grow makes such a block): a probe then
// compares hashes before keys, and growing hashes no key again.
const HM_HASHED: i64 = 0x40000;

/// Whether the map stores its slots' hashes after its values.
@crashfree
@wrapping
fn hm_hashed(m: i64) -> bool {
    if m == 0 { return false; }
    var tp: *mut i64 = m + 48;
    var w: i64 = 0;
    unsafe { w = *tp; }
    var t: i64 = w - P_TID_TAG;
    if t > 0 && t < 0x80000 { return (t & HM_HASHED) != 0; }
    return false;
}

/// Mark the map as storing hashes, or not.
@wrapping
fn hm_set_hashed(m: i64, on: bool) {
    var tp: *mut i64 = m + 48;
    var w: i64 = 0;
    unsafe { w = *tp; }
    var base: i64 = 0;
    var t: i64 = w - P_TID_TAG;
    if t > 0 && t < 0x80000 { base = t & 0x1FFFF; }
    if on { base = base + HM_HASHED; }
    var nw: i64 = 0;
    if base != 0 { nw = P_TID_TAG + base; }
    unsafe { *tp = nw; }
}

/// Whether the map owns its keys (string keys of a typed map).
fn hm_kown(m: i64) -> bool {
    return hm_types(m) >= 0x10000 && !hm_is_int(m);
}

/// The value type of the map.
fn hm_vtid(m: i64) -> i64 {
    return hm_types(m) % 0x10000;
}

/// Drop the key and value of a live slot `i` (one owner each).
fn hm_drop_slot(m: i64, keys: i64, vals: i64, i: i64) {
    var kp: *mut i64 = keys + i * 8;
    var vp: *mut i64 = vals + i * 8;
    var k: i64 = 0;
    var v: i64 = 0;
    unsafe { k = *kp; v = *vp; }
    if k == 0 || k == -1 { return; }
    if hm_kown(m) { Str_drop(k); }
    vec_elem_drop(hm_vtid(m), v);
}

// Integer keys are stored as key ^ HM_INT_XOR, so that 0 (empty) and -1
// (removed) stay free; the two keys that would map to them panic.
const HM_INT_XOR: i64 = 0x5DEECE66D1234567;

fn hm_is_int(m: i64) -> bool {
    var fp: *mut i64 = m + 40;
    var f: i64 = 0;
    unsafe { f = *fp; }
    return f != 0;
}

@wrapping fn hm_int_hash(k: i64) -> i64 {
    var x: i64 = k;
    x = (x ^ (x >> 31)) * 0x7FB5D329728EA185;
    x = (x ^ (x >> 27)) * 0x1B03738712FAD5C9;
    x = x ^ (x >> 33);
    return x & 0x3FFFFFFFFFFFFFFF;
}

fn hm_hash(m: i64, key: i64) -> i64 {
    if hm_is_int(m) { return hm_int_hash(key); }
    return hm_mix(p_str_hash(key));
}

/// Mix every bit of a string hash into the low ones (murmur3's finalizer):
/// the map takes `hash % capacity` with a power-of-two capacity, and the
/// native word-at-a-time hash left the low bits to the first character, so
/// keys of eight characters all collided.
@wrapping
fn hm_mix(h0: i64) -> i64 {
    var h: i64 = h0;
    h = h ^ ((h >> 33) & 0x7FFFFFFF);
    h = h * -49064778989728563;
    h = h ^ ((h >> 33) & 0x7FFFFFFF);
    return h & 9223372036854775807;
}

/// The slot of a hash (>= 0) in a table of `cap` slots: a mask for the
/// power-of-two capacities HashMap_grow makes, a division otherwise.
@wrapping
fn hm_index(h: i64, cap: i64) -> i64 {
    if (cap & (cap - 1)) == 0 { return h & (cap - 1); }
    return h % cap;
}

fn hm_eq(m: i64, a: i64, b: i64) -> bool {
    if hm_is_int(m) { return a == b; }
    return p_str_equal(a, b);
}

/// The stored form of an integer key; marks the map as integer-keyed.
fn hm_store_i(m: i64, k: i64) -> i64 {
    var fp: *mut i64 = m + 40;
    unsafe { *fp = 1; }
    var sk: i64 = k ^ HM_INT_XOR;
    if sk == 0 || sk == -1 { panic("HashMap: this integer key is reserved by the map's layout"); }
    return sk;
}

pub fn HashMap_insert_i(m: i64, key: i64, value: i64) {
    HashMap_insert(m, hm_store_i(m, key), value);
}

pub fn HashMap_get_i(m: i64, key: i64) -> i64 {
    return HashMap_get(m, hm_store_i(m, key));
}

pub fn HashMap_contains_i(m: i64, key: i64) -> bool {
    return HashMap_contains(m, hm_store_i(m, key));
}

pub fn HashMap_remove_i(m: i64, key: i64) {
    HashMap_remove(m, hm_store_i(m, key));
}

pub fn HashMap_get_or_i(m: i64, key: i64, default: i64) -> i64 {
    return HashMap_get_or(m, hm_store_i(m, key), default);
}

pub fn HashMap_keys_i(m: i64) -> i64 {
    return HashMap_keys(m);
}

pub fn HashMap_values_i(m: i64) -> i64 {
    return HashMap_values(m);
}

pub fn HashMap_share(m: i64) -> i64 {
    if m == 0 { return m; }
    var nm: i64 = p_malloc(56);
    var i: i64 = 0;
    while i < 7 {
        var src: *mut i64 = m + i * 8;
        var dst: *mut i64 = nm + i * 8;
        unsafe { *dst = *src; }
        i = i + 1;
    }
    var sp: *mut i64 = m + 32;
    var nsp: *mut i64 = nm + 32;
    var shared: i64 = 0;
    unsafe { shared = *sp; }
    if shared == 0 {
        var bx: i64 = p_malloc(8);
        var b0: *mut i64 = bx;
        unsafe { *b0 = 2; *sp = bx; *nsp = bx; }
    } else {
        var b0: *mut i64 = shared;
        var n: i64 = 0;
        unsafe { n = *b0; *b0 = n + 1; *nsp = shared; }
    }
    return nm;
}

pub fn map_own(m: i64) {
    var sp: *mut i64 = m + 32;
    var shared: i64 = 0;
    unsafe { shared = *sp; }
    if shared == 0 { return; }
    var b0: *mut i64 = shared;
    var owners: i64 = 0;
    unsafe { owners = *b0; }
    if owners <= 1 {
        p_free(shared);
        unsafe { *sp = 0; }
        return;
    }
    unsafe { *b0 = owners - 1; }
    var kp: *mut i64 = m;
    var vp: *mut i64 = m + 8;
    var cp: *mut i64 = m + 24;
    var keys: i64 = 0;
    var vals: i64 = 0;
    var cap: i64 = 0;
    unsafe { keys = *kp; vals = *vp; cap = *cp; }
    var kown: bool = hm_kown(m);
    var vtid: i64 = hm_vtid(m);
    if cap > 0 && keys != 0 {
        var nk: i64 = p_malloc(cap * 8);
        var hashed: bool = hm_hashed(m);
        var vwords: i64 = cap;
        if hashed { vwords = cap * 2; }
        var nv: i64 = p_malloc(vwords * 8);
        if hashed { vec_copy_bytes(nv + cap * 8, vals + cap * 8, cap * 8); }
        var i: i64 = 0;
        while i < cap {
            var ks: *mut i64 = keys + i * 8;
            var kd: *mut i64 = nk + i * 8;
            var vs: *mut i64 = vals + i * 8;
            var vd: *mut i64 = nv + i * 8;
            var k: i64 = 0;
            var v: i64 = 0;
            unsafe { k = *ks; v = *vs; }
            if k != 0 && k != -1 {
                // The copy is a second owner of each key and value
                if kown { Str_dup(k); }
                v = vec_elem_dup(vtid, v);
            }
            unsafe { *kd = k; *vd = v; }
            i = i + 1;
        }
        unsafe { *kp = nk; *vp = nv; }
    }
    unsafe { *sp = 0; }
}

// Find the slot index for a key. Returns the index of the key if found,
// or the first empty/tombstone slot if not found.
fn HashMap_find_slot(m: i64, key: i64) -> i64 {
    var cap_ptr: *mut i64 = m + 24;
    var capacity: i64 = 0;
    unsafe { capacity = *cap_ptr; }
    if capacity == 0 { return 0; }
    return HashMap_find_slot_h(m, key, hm_hash(m, key));
}

/// HashMap_find_slot with the key's hash already known. A map that stores
/// hashes compares a slot's hash before its key.
fn HashMap_find_slot_h(m: i64, key: i64, hash_val: i64) -> i64 {
    var cap_ptr: *mut i64 = m + 24;
    var keys_ptr_ptr: *mut i64 = m;
    var vals_ptr_ptr: *mut i64 = m + 8;
    var capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { return 0; }
    var keys: i64 = 0;
    var hashes: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
        hashes = *vals_ptr_ptr;
    }
    var hashed: bool = hm_hashed(m);
    hashes = hashes + capacity * 8;
    var idx: i64 = hm_index(hash_val, capacity);
    var first_tombstone: i64 = -1;
    var i: i64 = 0;
    while i < capacity {
        var key_addr: i64 = keys + idx * 8;
        var key_ptr: *mut i64 = key_addr;
        var slot_key: i64 = 0;
        unsafe {
            slot_key = *key_ptr;
        }
        if slot_key == 0 {
            if first_tombstone >= 0 { return first_tombstone; }
            return idx;
        }
        if slot_key == -1 {
            if first_tombstone < 0 { first_tombstone = idx; }
        } else {
            var same_hash: bool = true;
            if hashed {
                var hp: *mut i64 = hashes + idx * 8;
                var sh: i64 = 0;
                unsafe { sh = *hp; }
                same_hash = sh == hash_val;
            }
            if same_hash && hm_eq(m, slot_key, key) { return idx; }
        }
        idx = idx + 1;
        if idx >= capacity { idx = 0; }
        i = i + 1;
    }
    if first_tombstone >= 0 { return first_tombstone; }
    return 0;
}

@wrapping fn HashMap_grow(m: i64) {
    var cap_ptr: *mut i64 = m + 24;
    var keys_ptr_ptr: *mut i64 = m;
    var vals_ptr_ptr: *mut i64 = m + 8;
    var len_ptr: *mut i64 = m + 16;

    var old_capacity: i64 = 0;
    var old_keys: i64 = 0;
    var old_vals: i64 = 0;
    unsafe {
        old_capacity = *cap_ptr;
        old_keys = *keys_ptr_ptr;
        old_vals = *vals_ptr_ptr;
    }

    var new_capacity: i64 = 8;
    if old_capacity > 0 { new_capacity = old_capacity * 2; }

    var new_keys: i64 = p_malloc(new_capacity * 8);
    // the values, then each slot's hash (HM_HASHED)
    var new_vals: i64 = p_malloc(new_capacity * 16);
    var old_hashed: bool = hm_hashed(m);

    // Initialize new arrays to 0
    p_zero_words(new_keys, new_capacity);
    p_zero_words(new_vals, new_capacity * 2);

    // Rehash all entries
    var count: i64 = 0;
    var old_i: i64 = 0;
    while old_i < old_capacity {
        var old_kaddr: i64 = old_keys + old_i * 8;
        var old_kptr: *mut i64 = old_kaddr;
        var old_key: i64 = 0;
        unsafe {
            old_key = *old_kptr;
        }
        if old_key != 0 && old_key != -1 {
            var old_vaddr: i64 = old_vals + old_i * 8;
            var old_vptr: *mut i64 = old_vaddr;
            var old_val: i64 = 0;
            unsafe {
                old_val = *old_vptr;
            }
            // Insert into new arrays (the stored hash, else computed)
            var hash_val: i64 = 0;
            if old_hashed {
                var ohp: *mut i64 = old_vals + (old_capacity + old_i) * 8;
                unsafe { hash_val = *ohp; }
            } else {
                hash_val = hm_hash(m, old_key);
            }
            var new_idx: i64 = hm_index(hash_val, new_capacity);
            var probe: i64 = 0;
            while probe < new_capacity {
                var nkaddr: i64 = new_keys + new_idx * 8;
                var nkptr: *mut i64 = nkaddr;
                var nk: i64 = 0;
                unsafe {
                    nk = *nkptr;
                }
                if nk == 0 {
                    unsafe {
                        *nkptr = old_key;
                    }
                    var nvaddr: i64 = new_vals + new_idx * 8;
                    var nvptr: *mut i64 = nvaddr;
                    var nhptr: *mut i64 = new_vals + (new_capacity + new_idx) * 8;
                    unsafe {
                        *nvptr = old_val;
                        *nhptr = hash_val;
                    }
                    break;
                }
                new_idx = new_idx + 1;
                if new_idx >= new_capacity { new_idx = 0; }
                probe = probe + 1;
            }
            count = count + 1;
        }
        old_i = old_i + 1;
    }

    if old_keys != 0 { p_free(old_keys); }
    if old_vals != 0 { p_free(old_vals); }
    hm_set_hashed(m, true);

    unsafe {
        *keys_ptr_ptr = new_keys;
        *vals_ptr_ptr = new_vals;
        *len_ptr = count;
        *cap_ptr = new_capacity;
    }
}

/// `key` maps to `value`; the map owns both (proposal 0004). An existing key
/// is kept and the new one dropped; the old value is dropped.
pub fn HashMap_insert(m: i64, key: i64, value: i64) {
    map_own(m);
    var len_ptr: *mut i64 = m + 16;
    var cap_ptr: *mut i64 = m + 24;
    var len: i64 = 0;
    var capacity: i64 = 0;
    unsafe { len = *len_ptr; capacity = *cap_ptr; }
    // Grow if load factor > 0.7
    if capacity == 0 || len * 10 >= capacity * 7 {
        HashMap_grow(m);
        unsafe { capacity = *cap_ptr; }
    }
    var ih: i64 = hm_hash(m, key);
    var idx: i64 = HashMap_find_slot_h(m, key, ih);
    var keys_ptr_ptr: *mut i64 = m;
    var vals_ptr_ptr: *mut i64 = m + 8;
    var keys: i64 = 0;
    var vals: i64 = 0;
    unsafe { keys = *keys_ptr_ptr; vals = *vals_ptr_ptr; }
    var kptr: *mut i64 = keys + idx * 8;
    var vptr: *mut i64 = vals + idx * 8;
    var existing_key: i64 = 0;
    unsafe { existing_key = *kptr; }
    if existing_key == 0 || existing_key == -1 {
        unsafe { *kptr = key; *vptr = value; *len_ptr = len + 1; }
        if hm_hashed(m) {
            var hptr: *mut i64 = vals + (capacity + idx) * 8;
            unsafe { *hptr = ih; }
        }
    } else {
        var old: i64 = 0;
        unsafe { old = *vptr; *vptr = value; }
        if old != value { vec_elem_drop(hm_vtid(m), old); }
        if key != existing_key && hm_kown(m) { Str_drop(key); }
    }
}

pub fn HashMap_get(m: i64, key: i64) -> i64 {
    var cap_ptr: *mut i64 = m + 24;
    var capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { return 0; }

    var idx: i64 = HashMap_find_slot(m, key);
    var keys_ptr_ptr: *mut i64 = m;
    var keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    var kaddr: i64 = keys + idx * 8;
    var kptr: *mut i64 = kaddr;
    var slot_key: i64 = 0;
    unsafe {
        slot_key = *kptr;
    }
    if slot_key == 0 || slot_key == -1 { return 0; }

    var vals_ptr_ptr: *mut i64 = m + 8;
    var vals: i64 = 0;
    unsafe {
        vals = *vals_ptr_ptr;
    }
    var vaddr: i64 = vals + idx * 8;
    var vptr: *mut i64 = vaddr;
    var result: i64 = 0;
    unsafe {
        result = *vptr;
    }
    return result;
}

pub fn HashMap_contains(m: i64, key: i64) -> bool {
    var cap_ptr: *mut i64 = m + 24;
    var capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { return false; }

    var idx: i64 = HashMap_find_slot(m, key);
    var keys_ptr_ptr: *mut i64 = m;
    var keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    var kaddr: i64 = keys + idx * 8;
    var kptr: *mut i64 = kaddr;
    var slot_key: i64 = 0;
    unsafe {
        slot_key = *kptr;
    }
    return slot_key != 0 && slot_key != -1;
}

/// Remove `key`; the map drops its key and value.
pub fn HashMap_remove(m: i64, key: i64) {
    map_own(m);
    var cap_ptr: *mut i64 = m + 24;
    var len_ptr: *mut i64 = m + 16;
    var capacity: i64 = 0;
    unsafe { capacity = *cap_ptr; }
    if capacity == 0 { return; }
    var idx: i64 = HashMap_find_slot(m, key);
    var keys: i64 = 0;
    var vals: i64 = 0;
    var keys_ptr_ptr: *mut i64 = m;
    var vals_ptr_ptr: *mut i64 = m + 8;
    unsafe { keys = *keys_ptr_ptr; vals = *vals_ptr_ptr; }
    var kptr: *mut i64 = keys + idx * 8;
    var slot_key: i64 = 0;
    unsafe { slot_key = *kptr; }
    if slot_key == 0 || slot_key == -1 { return; }
    hm_drop_slot(m, keys, vals, idx);
    var len: i64 = 0;
    unsafe { *kptr = -1; len = *len_ptr; *len_ptr = len - 1; }
}

pub fn HashMap_len(m: i64) -> i64 {
    var len_ptr: *mut i64 = m + 16;
    var result: i64 = 0;
    unsafe {
        result = *len_ptr;
    }
    return result;
}

pub fn HashMap_is_empty(m: i64) -> bool {
    var len_ptr: *mut i64 = m + 16;
    var len: i64 = 0;
    unsafe {
        len = *len_ptr;
    }
    return len == 0;
}

/// Remove every entry; the map drops what it owns.
pub fn HashMap_clear(m: i64) {
    map_own(m);
    var len_ptr: *mut i64 = m + 16;
    unsafe { *len_ptr = 0; }
    var keys_ptr_ptr: *mut i64 = m;
    var vals_ptr_ptr: *mut i64 = m + 8;
    var cap_ptr: *mut i64 = m + 24;
    var keys: i64 = 0;
    var vals: i64 = 0;
    var capacity: i64 = 0;
    unsafe { keys = *keys_ptr_ptr; vals = *vals_ptr_ptr; capacity = *cap_ptr; }
    if keys != 0 && capacity > 0 {
        var i: i64 = 0;
        while i < capacity {
            hm_drop_slot(m, keys, vals, i);
            var kptr: *mut i64 = keys + i * 8;
            unsafe { *kptr = 0; }
            i = i + 1;
        }
    }
}

/// The keys in a Vec of their own (sorted for a deterministic order); the
/// Vec owns copies of keys the map owns.
pub fn HashMap_keys(m: i64) -> i64 {
    var cap_ptr: *mut i64 = m + 24;
    var keys_ptr_ptr: *mut i64 = m;
    var capacity: i64 = 0;
    var keys: i64 = 0;
    unsafe { capacity = *cap_ptr; keys = *keys_ptr_ptr; }
    var kown: bool = hm_kown(m);
    var ktid: i64 = 0;
    if kown { ktid = P_TID_STR; }
    var result: i64 = Vec_new_typed(0, ktid);
    if keys == 0 || capacity == 0 { return result; }
    var i: i64 = 0;
    while i < capacity {
        var kptr: *mut i64 = keys + i * 8;
        var slot_key: i64 = 0;
        unsafe { slot_key = *kptr; }
        if slot_key != 0 && slot_key != -1 {
            if hm_is_int(m) {
                Vec_push(result, slot_key ^ HM_INT_XOR);
            } else {
                if kown { Str_dup(slot_key); }
                Vec_push(result, slot_key);
            }
        }
        i = i + 1;
    }
    // SH-3.4: Sort keys for deterministic iteration order
    Vec_sort(result);
    return result;
}

pub fn HashMap_values(m: i64) -> i64 {
    // SH-3.4: Return values in sorted-key order for deterministic iteration.
    // Get sorted keys, then look up each value.
    var keys: i64 = HashMap_keys(m);
    var len: i64 = Vec_len(keys);
    var vtid: i64 = hm_vtid(m);
    var result: i64 = Vec_new_typed(0, vtid);
    var i: i64 = 0;
    while i < len {
        var k: i64 = Vec_get(keys, i);
        var v: i64 = 0;
        if hm_is_int(m) { v = HashMap_get(m, k ^ HM_INT_XOR); } else { v = HashMap_get(m, k); }
        Vec_push(result, vec_elem_dup(vtid, v));
        i = i + 1;
    }
    Vec_drop(keys);
    return result;
}

pub fn HashMap_clone(m: i64) -> i64 {
    var result: i64 = HashMap_new();
    var tw: *mut i64 = m + 48;
    var rtw: *mut i64 = result + 48;
    unsafe { *rtw = *tw; }
    if hm_is_int(m) {
        var rf: *mut i64 = result + 40;
        unsafe { *rf = 1; }
    }
    var kown: bool = hm_kown(m);
    var vtid: i64 = hm_vtid(m);
    var cap_ptr: *mut i64 = m + 24;
    var keys_ptr_ptr: *mut i64 = m;
    var vals_ptr_ptr: *mut i64 = m + 8;
    var capacity: i64 = 0;
    var keys: i64 = 0;
    var vals: i64 = 0;
    unsafe { capacity = *cap_ptr; keys = *keys_ptr_ptr; vals = *vals_ptr_ptr; }
    if keys == 0 || capacity == 0 { return result; }
    var i: i64 = 0;
    while i < capacity {
        var kptr: *mut i64 = keys + i * 8;
        var slot_key: i64 = 0;
        unsafe { slot_key = *kptr; }
        if slot_key != 0 && slot_key != -1 {
            var vptr: *mut i64 = vals + i * 8;
            var value: i64 = 0;
            unsafe { value = *vptr; }
            if kown { Str_dup(slot_key); }
            HashMap_insert(result, slot_key, vec_elem_dup(vtid, value));
        }
        i = i + 1;
    }
    return result;
}

pub fn HashMap_get_or(m: i64, key: i64, default: i64) -> i64 {
    var cap_ptr: *mut i64 = m + 24;
    var capacity: i64 = 0;
    unsafe {
        capacity = *cap_ptr;
    }
    if capacity == 0 { return default; }

    var idx: i64 = HashMap_find_slot(m, key);
    var keys_ptr_ptr: *mut i64 = m;
    var keys: i64 = 0;
    unsafe {
        keys = *keys_ptr_ptr;
    }
    var kaddr: i64 = keys + idx * 8;
    var kptr: *mut i64 = kaddr;
    var slot_key: i64 = 0;
    unsafe {
        slot_key = *kptr;
    }
    if slot_key == 0 || slot_key == -1 { return default; }

    var vals_ptr_ptr: *mut i64 = m + 8;
    var vals: i64 = 0;
    unsafe {
        vals = *vals_ptr_ptr;
    }
    var vaddr: i64 = vals + idx * 8;
    var vptr: *mut i64 = vaddr;
    var result: i64 = 0;
    unsafe {
        result = *vptr;
    }
    return result;
}

// Format a HashMap as "{key: value, key: value}".
// Keys and values are assumed to be string pointers (i64 addresses).
// Keys are sorted lexicographically for deterministic output.
pub fn HashMap_to_str(m: i64) -> str {
    var keys: i64 = HashMap_keys(m);
    var len: i64 = Vec_len(keys);

    // Sort keys lexicographically (simple bubble sort); integer keys are
    // already in numeric order (HashMap_keys sorts them)
    var i: i64 = 0;
    if hm_is_int(m) { i = len; }
    while i < len {
        var j: i64 = 0;
        while j + 1 < len - i {
            var k1: i64 = Vec_get(keys, j);
            var k2: i64 = Vec_get(keys, j + 1);
            if p_str_compare(k1, k2) > 0 {
                Vec_set(keys, j, k2);
                Vec_set(keys, j + 1, k1);
            }
            j = j + 1;
        }
        i = i + 1;
    }

    var result: str = "{";
    i = 0;
    while i < len {
        if i > 0 {
            result = result + ", ";
        }
        var key: i64 = Vec_get(keys, i);
        if hm_is_int(m) {
            result = result + p_to_str(key) + ": " + p_to_str(HashMap_get(m, key ^ HM_INT_XOR));
            i = i + 1;
            continue;
        }
        var value: i64 = HashMap_get(m, key);
        result = p_str_concat(result, key);
        result = result + ": ";
        // Value is an i64 — format as number
        result = result + p_to_str(value);
        i = i + 1;
    }
    result = result + "}";
    return result;
}

// ─── String (Phase 10B) ─────────────────────────────────────────────────
// Strings are null-terminated byte buffers (i64 pointer to first byte).
// All operations allocate new strings (immutable semantics).
// String value is an i64 pointer to a null-terminated char array.

// Read a null-terminated string from a raw pointer (i64 address) and
// return it as a *mut u8 pointer to a new copy.
// A counted copy of the NUL-terminated bytes at `s` ("" for null): how a
// string that came from C becomes a Fides string (proposal 0004).
pub fn p_str_from_ptr(s: i64) -> str {
    if s == 0 { return ""; }
    var len: i64 = p_str_cstr_len(s);
    var r: i64 = p_str_buf(len);
    p_str_copy_n(r, s, len);
    return r;
}

/// Bytes before the NUL at `s`, ignoring any header.
pub fn p_str_cstr_len(s: i64) -> i64 {
    if s == 0 { return 0; }
    var addr: i64 = s;
    var ptr: *mut u8 = addr;
    var count: i64 = 0;
    unsafe {
        var b: i64 = *ptr;
        while b != 0 {
            count = count + 1;
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    return count;
}

// The allocator's block header word, as the C and native runtimes write it
const P_BLOCK_MAGIC_CORE: i64 = 0xF1DE5A0000000000;

/// A str made from `buf`, a raw string its caller owns and gives up (a
/// runtime function's result, proposal 0004): a counted string or a literal
/// is taken over as it is; anything else is copied, and freed when it is a
/// plain block of the allocator.
pub fn p_str_adopt(buf: i64) -> str {
    if buf == 0 { return ""; }
    if buf != 0 {
        var amp: *mut i64 = buf - 16;
        var alp: *mut i64 = buf - 8;
        var aw: i64 = 0;
        var al: i64 = 0;
        unsafe { aw = *amp; al = *alp; }
        if p_str_len_word(al) && (p_str_count_of(aw) > 0 || aw == P_STR_STATIC) { return buf; }
    }
    var r: str = p_str_from_ptr(buf);
    if buf != 0 {
        var hw: *mut i64 = buf - 8;
        var h: i64 = 0;
        unsafe { h = *hw; }
        if (h & -256) == P_BLOCK_MAGIC_CORE { p_free(buf); }
    }
    return r;
}

/// A str of its own for `s`, a raw string the caller borrows (proposal
/// 0004): a counted string gets one more owner, a literal is itself,
/// anything else (a C string, a plain buffer) is copied; "" for null.
pub fn p_str_take(s: i64) -> str {
    if s == 0 { return ""; }
    var mp: *mut i64 = s - 16;
    var lp: *mut i64 = s - 8;
    var w: i64 = 0;
    var l: i64 = 0;
    unsafe { w = *mp; l = *lp; }
    if p_str_len_word(l) && (p_str_count_of(w) > 0 || w == P_STR_STATIC) {
        Str_dup(s);
        return s;
    }
    return p_str_from_ptr(s);
}


/// The length in the header of `s`, or -1 when it has none.
pub fn p_str_hdr_len(s: i64) -> i64 {
    if s == 0 { return -1; }
    var mp: *mut i64 = s - 16;
    var lp: *mut i64 = s - 8;
    var w: i64 = 0;
    var l: i64 = 0;
    unsafe { w = *mp; l = *lp; }
    if !p_str_len_word(l) { return -1; }
    if w == P_STR_MAGIC || w == P_STR_STATIC || p_str_count_of(w) > 0 { return l; }
    return -1;
}

/// The count in the header word of a counted string (P_STR_RC + count), or
/// 0 for any other word.
@crashfree
@wrapping
pub fn p_str_count_of(w: i64) -> i64 {
    var d: i64 = w - P_STR_RC;
    if d < 0 || d >= 0x100000000 { return 0; }
    if (d & P_STR_RC_MAX) != 0 { return 0; }
    var c: i64 = d & 0x3FFFFFFF;
    if c >= 1 { return c; }
    return 0;
}

/// The power of two at least `n` (32 at the least).
fn p_pow2_at_least(n: i64) -> i64 {
    var p: i64 = 32;
    while p < n { p = p * 2; }
    return p;
}

/// `s + x` where the caller gives `s` up (`s = s + x`, `s += x`, proposal
/// 0004): appended in place when `s` has one owner and room, else a new
/// string with room to grow, `s` dropped. The usual `s = s + ...` loop then
/// costs a copy only each time the length doubles.
pub fn p_str_append(s: i64, x: i64) -> str {
    var xl: i64 = p_str_length(x);
    var sl: i64 = p_str_length(s);
    if s != 0 {
        var mp: *mut i64 = s - 16;
        var w: i64 = 0;
        unsafe { w = *mp; }
        if w == P_STR_RC + P_STR_ROOM + 1 {
            var cap: i64 = p_pow2_at_least(sl + 17) - 17;
            if sl + xl <= cap {
                p_str_copy_n(s + sl, x, xl);
                var ep: *mut u8 = s + sl + xl;
                var lp: *mut i64 = s - 8;
                unsafe { *ep = 0; *lp = sl + xl; }
                return s;
            }
        }
    }
    var n: i64 = sl + xl;
    var a: i64 = p_malloc(p_pow2_at_least(n + 17));
    if a == 0 { p_panic("out of memory"); }
    var amp: *mut i64 = a;
    var alp: *mut i64 = a + 8;
    unsafe { *amp = P_STR_RC + P_STR_ROOM + 1; *alp = n; }
    var r: i64 = a + 16;
    p_str_copy_n(r, s, sl);
    p_str_copy_n(r + sl, x, xl);
    var ep2: *mut u8 = r + n;
    unsafe { *ep2 = 0; }
    Str_drop(s);
    return r;
}

// strlen: header len when the magic matches, else count to NUL.
fn p_str_length(s: i64) -> i64 {
    if s == 0 { return 0; }
    var hl: i64 = p_str_hdr_len(s);
    if hl >= 0 { return hl; }
    var addr: i64 = s;
    var ptr: *mut u8 = addr;
    var count: i64 = 0;
    unsafe {
        var b: i64 = *ptr;
        while b != 0 {
            count = count + 1;
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    return count;
}

// Allocate a headered string of `len` bytes: returns the data pointer
// (alloc+16) with magic+len written. Caller fills bytes + NUL.
// A counted string of `len` bytes with one owner (proposal 0004): returns
// the data pointer (alloc+16) with [P_STR_RC + 1][len] before it. The caller
// fills the bytes and the NUL (p_str_buf writes the NUL).
pub fn p_str_alloc(len: i64) -> i64 {
    var a: i64 = p_malloc(len + 17);
    if a == 0 { p_panic("out of memory"); }
    var mp: *mut i64 = a;
    var lp: *mut i64 = a + 8;
    unsafe { *mp = P_STR_RC + 1; *lp = len; }
    return a + 16;
}

/// p_str_alloc with the NUL written: the caller fills `len` bytes.
pub fn p_str_buf(len: i64) -> i64 {
    var r: i64 = p_str_alloc(len);
    var ep: *mut u8 = r + len;
    unsafe { *ep = 0; }
    return r;
}

// Free a possibly-headered string.
// Free a string now, whatever its count (code that manages memory by hand).
// A literal is left alone; a counted or uncounted heap string is freed;
// anything else is taken for a plain allocation.
pub fn p_str_free(s: i64) {
    if s == 0 { return; }
    var mp: *mut i64 = s - 16;
    var lp: *mut i64 = s - 8;
    unsafe {
        if p_str_len_word(*lp) {
            if *mp == P_STR_STATIC { return; } // a literal
            if *mp == P_STR_MAGIC || p_str_count_of(*mp) > 0 {
                *mp = P_STR_DEAD;
                p_free(s - 16);
                return;
            }
        }
    }
    p_free(s);
}

// The word before a headered string's bytes is its length. Before a plain
// allocated string it is the allocator's block header (P_BLOCK_MAGIC | class,
// negative as an i64), so a block that merely ends with the magic value (an
// i64 field holding P_STR_MAGIC, as the compiler's own IR of this file does)
// is not taken for a header: freeing s - 16 then hit "Invalid free".
fn p_str_len_word(w: i64) -> bool {
    return w >= 0 && w < 0x10000000000;
}

// str_copy_n: copy n bytes from src to dst. Both are i64 addresses.
fn p_str_copy_n(dst: i64, src: i64, n: i64) {
    // A word at a time, then the last bytes (every slice, concatenation,
    // replace and split goes through here)
    vec_copy_bytes(dst, src, n);
}

pub fn String_from(s: i64) -> str {
    if s == 0 { return ""; }
    var len: i64 = p_str_length(s);
    var result: i64 = p_str_buf(len);
    p_str_copy_n(result, s, len);
    return result;
}

pub fn String_len(s: i64) -> i64 {
    return p_str_length(s);
}

pub fn String_is_empty(s: i64) -> bool {
    if s == 0 { return true; }
    var ptr: *mut u8 = s;
    var b: i64 = 0;
    unsafe { b = *ptr; }
    return b == 0;
}

pub fn String_push_str(s: i64, other: i64) -> str {
    var s_len: i64 = p_str_length(s);
    var o_len: i64 = p_str_length(other);
    var result: i64 = p_str_buf(s_len + o_len);
    p_str_copy_n(result, s, s_len);
    p_str_copy_n(result + s_len, other, o_len);
    return result;
}

pub fn String_contains(s: i64, sub: i64) -> bool {
    return String_find(s, sub) >= 0;
}

pub fn String_starts_with(s: i64, prefix: i64) -> bool {
    if s == 0 || prefix == 0 { return false; }
    var s_len: i64 = p_str_length(s);
    var p_len: i64 = p_str_length(prefix);
    if p_len > s_len { return false; }
    return p_bytes_eq(s, prefix, p_len);
}

pub fn String_ends_with(s: i64, suffix: i64) -> bool {
    if s == 0 || suffix == 0 { return false; }
    var s_len: i64 = p_str_length(s);
    var suf_len: i64 = p_str_length(suffix);
    if suf_len > s_len { return false; }
    return p_bytes_eq(s + s_len - suf_len, suffix, suf_len);
}

pub fn String_trim(s: i64) -> str {
    if s == 0 { return ""; }
    var len: i64 = p_str_length(s);
    var start: i64 = 0;
    var end: i64 = len;
    while start < end && p_is_space_at(s + start) { start = start + 1; }
    while end > start && p_is_space_at(s + end - 1) { end = end - 1; }
    if end <= start { return ""; }
    return String_slice_len(s, len, start, end);
}

/// Whether the byte at `addr` is a space, tab, LF or CR.
fn p_is_space_at(addr: i64) -> bool {
    var ptr: *mut u8 = addr;
    var b: i64 = 0;
    unsafe { b = *ptr; }
    return b == 32 || b == 9 || b == 10 || b == 13;
}

pub fn String_to_uppercase(s: i64) -> str {
    return p_str_map_case(s, 97, 122, -32);
}

/// A copy of `s` with every byte in [lo, hi] moved by `delta`.
fn p_str_map_case(s: i64, lo: i64, hi: i64, delta: i64) -> str {
    if s == 0 { return ""; }
    var len: i64 = p_str_length(s);
    var result: i64 = p_str_buf(len);
    var i: i64 = 0;
    while i < len {
        var src_ptr: *mut u8 = s + i;
        var dst_ptr: *mut u8 = result + i;
        var b: i64 = 0;
        unsafe { b = *src_ptr; }
        if b >= lo && b <= hi { b = b + delta; }
        unsafe { *dst_ptr = b; }
        i = i + 1;
    }
    return result;
}

pub fn String_to_lowercase(s: i64) -> str {
    return p_str_map_case(s, 65, 90, 32);
}

pub fn String_slice(s: i64, start: i64, end: i64) -> str {
    if s == 0 { return ""; }
    return String_slice_len(s, p_str_length(s), start, end);
}

/// String_slice for a caller that already knows `s` is `len` bytes long:
/// no strlen scan, so slicing a large source token by token stays linear.
pub fn String_slice_len(s: i64, len: i64, start: i64, end: i64) -> str {
    var st: i64 = start;
    var en: i64 = end;
    if st < 0 { st = 0; }
    if en > len { en = len; }
    if st >= en { return ""; }
    var new_len: i64 = en - st;
    var result: i64 = p_str_buf(new_len);
    p_str_copy_n(result, s + st, new_len);
    return result;
}

/// The first position of `sub` in `s`, or -1: the first byte is looked for,
/// then the rest compared a word at a time.
pub fn String_find(s: i64, sub: i64) -> i64 {
    if s == 0 || sub == 0 { return -1; }
    var s_len: i64 = p_str_length(s);
    var sub_len: i64 = p_str_length(sub);
    if sub_len == 0 { return 0; }
    if sub_len > s_len { return -1; }
    var first: i64 = p_byte_of(sub, 0);
    var i: i64 = 0;
    var last: i64 = s_len - sub_len;
    while i <= last {
        if p_byte_of(s, i) == first && p_bytes_eq(s + i, sub, sub_len) { return i; }
        i = i + 1;
    }
    return -1;
}

/// The byte at `s + i`.
fn p_byte_of(s: i64, i: i64) -> i64 {
    var p: *mut u8 = s + i;
    var b: i64 = 0;
    unsafe { b = *p; }
    return b;
}

pub fn String_rfind(s: i64, sub: i64) -> i64 {
    if s == 0 || sub == 0 { return -1; }
    var s_len: i64 = p_str_length(s);
    var sub_len: i64 = p_str_length(sub);
    if sub_len == 0 { return s_len; }
    if sub_len > s_len { return -1; }
    var first: i64 = p_byte_of(sub, 0);
    var i: i64 = s_len - sub_len;
    while i >= 0 {
        if p_byte_of(s, i) == first && p_bytes_eq(s + i, sub, sub_len) { return i; }
        i = i - 1;
    }
    return -1;
}

pub fn String_replace(s: i64, from: i64, to: i64) -> str {
    if s == 0 { return ""; }
    if from == 0 || to == 0 { return String_from(s); }
    var from_len: i64 = p_str_length(from);
    if from_len == 0 { return String_from(s); }
    var to_len: i64 = p_str_length(to);
    var s_len: i64 = p_str_length(s);
    // First pass: the result's length
    var n: i64 = 0;
    var pos: i64 = 0;
    while pos < s_len {
        if pos + from_len <= s_len && p_bytes_eq(s + pos, from, from_len) {
            n = n + to_len;
            pos = pos + from_len;
        } else {
            n = n + 1;
            pos = pos + 1;
        }
    }
    // Second pass: the bytes
    var result: i64 = p_str_buf(n);
    var out: i64 = 0;
    pos = 0;
    while pos < s_len {
        if pos + from_len <= s_len && p_bytes_eq(s + pos, from, from_len) {
            p_str_copy_n(result + out, to, to_len);
            out = out + to_len;
            pos = pos + from_len;
        } else {
            p_str_copy_n(result + out, s + pos, 1);
            out = out + 1;
            pos = pos + 1;
        }
    }
    return result;
}

/// Whether the `n` bytes at `a` and `b` are equal (a word at a time,
/// then byte by byte).
fn p_bytes_eq(a: i64, b: i64, n: i64) -> bool {
    var j: i64 = 0;
    while j + 8 <= n {
        var aw: *mut i64 = a + j;
        var bw: *mut i64 = b + j;
        var xw: i64 = 0;
        var yw: i64 = 0;
        unsafe { xw = *aw; yw = *bw; }
        if xw != yw { return false; }
        j = j + 8;
    }
    while j < n {
        var ap: *mut u8 = a + j;
        var bp: *mut u8 = b + j;
        var x: i64 = 0;
        var y: i64 = 0;
        unsafe { x = *ap; y = *bp; }
        if x != y { return false; }
        j = j + 1;
    }
    return true;
}

// The parts of `s` between the copies of `delim`: a Vec<str> that owns them.
pub fn String_split(s: i64, delim: i64) -> i64 {
    var result: i64 = Vec_new_typed(0, P_TID_STR);
    if s == 0 || delim == 0 { return result; }
    var dlen: i64 = p_str_length(delim);
    if dlen == 0 { return result; }
    var start: i64 = 0;
    var s_len: i64 = p_str_length(s);
    var pos: i64 = 0;
    while pos <= s_len - dlen {
        if p_bytes_eq(s + pos, delim, dlen) {
            var part: i64 = String_slice_len(s, s_len, start, pos);
            Vec_push(result, part);
            start = pos + dlen;
            pos = start;
        } else {
            pos = pos + 1;
        }
    }
    var last: i64 = String_slice_len(s, s_len, start, s_len);
    Vec_push(result, last);
    return result;
}

pub fn String_parse_int(s: i64) -> i64 {
    if s == 0 { return 0; }
    var result: i64 = 0;
    var sign: i64 = 1;
    var addr: i64 = s;
    var ptr: *mut u8 = addr;
    unsafe {
        var b: i64 = *ptr;
        // Skip whitespace
        while b == 32 || b == 9 || b == 10 || b == 13 {
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
        // Check sign
        if b == 45 {
            sign = -1;
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        } else if b == 43 {
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
        // Parse digits
        while b >= 48 && b <= 57 {
            result = result * 10 + (b - 48);
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    return result * sign;
}

// The byte at `idx` as a one-byte string ("" when out of range).
pub fn String_char_at(s: i64, idx: i64) -> str {
    if s == 0 { return ""; }
    var len: i64 = p_str_length(s);
    if idx < 0 || idx >= len { return ""; }
    return String_slice_len(s, len, idx, idx + 1);
}

/// `s + int_to_str(n)` in one allocation: the lowering's form of that
/// expression (no string for the number alone, made and freed again).
pub fn p_str_concat_int(s: i64, n: i64) -> str {
    if n == -9223372036854775807 - 1 {
        var t: str = int_to_str(n);
        return p_str_concat(s, t);
    }
    var sl: i64 = p_str_length(s);
    var u: i64 = n;
    if n < 0 { u = 0 - n; }
    var nd: i64 = 1;
    var q: i64 = u;
    while q >= 10 {
        q = q / 10;
        nd = nd + 1;
    }
    var total: i64 = sl + nd;
    if n < 0 { total = total + 1; }
    var r: i64 = p_str_buf(total);
    if sl > 0 { p_str_copy_n(r, s, sl); }
    if n < 0 {
        var mp: *mut u8 = r + sl;
        unsafe { *mp = 45; }
    }
    var pos: i64 = total - 1;
    q = u;
    var more: bool = true;
    while more {
        var dp: *mut u8 = r + pos;
        unsafe { *dp = (48 + q % 10) as u8; }
        q = q / 10;
        pos = pos - 1;
        more = q != 0;
    }
    return r;
}

pub fn String_repeat(s: i64, n: i64) -> str {
    if s == 0 || n <= 0 { return ""; }
    var len: i64 = p_str_length(s);
    var result: i64 = p_str_buf(len * n);
    var i: i64 = 0;
    while i < n {
        p_str_copy_n(result + i * len, s, len);
        i = i + 1;
    }
    return result;
}

pub fn String_to_string(s: i64) -> str {
    return String_from(s);
}

pub fn String_clone(s: i64) -> str {
    return String_from(s);
}

pub fn String_bytes(s: i64) -> i64 {
    return p_str_length(s);
}

// ═══════════════════════════════════════════════════════════════════════
// StringBuilder — mutable string builder for efficient concatenation
// ═══════════════════════════════════════════════════════════════════════
//
// Usage:
//   value sb = StringBuilder::new();
//   sb.append_str("hello");
//   sb.append_str(" world");
//   value result = sb.to_str();  // "hello world"
//   print(result);

pub struct StringBuilder {
    handle: i64,
    len: i64,
}

impl StringBuilder {
    pub fn new() -> StringBuilder {
        return StringBuilder { handle: p_sb_new(), len: 0 };
    }

    pub fn append_str(self: &mut StringBuilder, s: str) -> void {
        p_sb_append(self.handle, s);
        self.len = self.len + String_len(s);
    }

    pub fn append_char(self: &mut StringBuilder, c: i64) -> void {
        p_sb_append(self.handle, byte_to_str(c));
        self.len = self.len + 1;
    }

    pub fn append_int(self: &mut StringBuilder, n: i64) -> void {
        val text: str = int_to_str(n);
        p_sb_append(self.handle, text);
        self.len = self.len + String_len(text);
    }

    pub fn to_str(self: StringBuilder) -> str {
        return p_sb_to_str(self.handle);
    }

    pub fn len(self: StringBuilder) -> i64 {
        return self.len;
    }

    pub fn is_empty(self: StringBuilder) -> bool {
        return self.len == 0;
    }

    pub fn clear(self: &mut StringBuilder) -> void {
        self.handle = p_sb_new();
        self.len = 0;
    }
}

// ═══════════════════════════════════════════════════════════════════════
// Char iteration helpers
// ═══════════════════════════════════════════════════════════════════════

pub fn String_byte_at(s: i64, idx: i64) -> i64 {
    if s == 0 { return -1; }
    if idx < 0 { return -1; }
    // A string with its length may hold zero bytes (D16)
    var hl: i64 = p_str_hdr_len(s);
    if hl >= 0 {
        if idx >= hl { return -1; }
        var hp: *mut u8 = s + idx;
        var hb: i64 = 0;
        unsafe { hb = *hp; }
        return hb;
    }
    // Direct byte access — skip p_str_length() call (O(n) scan).
    // The caller is responsible for bounds checking via str_len().
    // For safety, we check for null terminator (end of string).
    var addr: i64 = s + idx;
    var ptr: *mut u8 = addr;
    var b: i64 = 0;
    unsafe { b = *ptr; }
    if b == 0 { return -1; }  // hit null terminator = out of bounds
    return b;
}

pub fn String_char_count(s: i64) -> i64 {
    return p_str_length(s);
}

pub fn char_to_str(b: i64) -> str {
    return p_char_to_str(b);
}

pub fn char_is_digit(b: i64) -> bool {
    return b >= 48 && b <= 57;
}

pub fn char_is_alpha(b: i64) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
}

pub fn char_is_whitespace(b: i64) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

pub fn char_is_upper(b: i64) -> bool {
    return b >= 65 && b <= 90;
}

pub fn char_is_lower(b: i64) -> bool {
    return b >= 97 && b <= 122;
}

pub fn char_to_upper(b: i64) -> i64 {
    if b >= 97 && b <= 122 { return b - 32; }
    return b;
}

pub fn char_to_lower(b: i64) -> i64 {
    if b >= 65 && b <= 90 { return b + 32; }
    return b;
}

// ═══════════════════════════════════════════════════════════════════════
// ByteBuffer — mutable byte array for binary data
// ═══════════════════════════════════════════════════════════════════════
//
// ByteBuffer uses a Vec internally to store byte values.

pub struct ByteBuffer {
    data: Vec<i64>,
    len: i64,
}

impl ByteBuffer {
    pub fn new(init_cap: i64) -> ByteBuffer {
        return ByteBuffer { data: Vec::new(), len: 0 };
    }

    pub fn from_string(s: str) -> ByteBuffer {
        var buf = ByteBuffer::new(0);
        var slen: i64 = String_len(s);
        var i: i64 = 0;
        while i < slen {
            var addr: i64 = s + i;
            var ptr: *mut u8 = addr;
            var b: i64 = 0;
            unsafe { b = *ptr; }
            buf.write_byte(b);
            i = i + 1;
        }
        return buf;
    }

    pub fn write_byte(self: &mut ByteBuffer, b: i64) -> void {
        self.data.push(b);
        self.len = self.len + 1;
    }

    pub fn write_bytes(self: ByteBuffer, src: i64, count: i64) -> void {
        var i: i64 = 0;
        while i < count {
            var src_addr: i64 = src + i;
            var src_ptr: *mut u8 = src_addr;
            var b: i64 = 0;
            unsafe { b = *src_ptr; }
            self.write_byte(b);
            i = i + 1;
        }
    }

    pub fn read_byte(self: ByteBuffer, idx: i64) -> i64 {
        if idx < 0 || idx >= self.len { return -1; }
        return self.data.get(idx);
    }

    pub fn set_byte(self: &mut ByteBuffer, idx: i64, b: i64) -> void {
        if idx < 0 || idx >= self.len { return; }
        self.data.set(idx, b);
    }

    pub fn len(self: ByteBuffer) -> i64 {
        return self.len;
    }

    pub fn is_empty(self: ByteBuffer) -> bool {
        return self.len == 0;
    }

    pub fn clear(self: &mut ByteBuffer) -> void {
        self.data.clear();
        self.len = 0;
    }

    pub fn to_str(self: ByteBuffer) -> str {
        var result: str = "";
        var i: i64 = 0;
        while i < self.len {
            var b: i64 = self.data.get(i);
            result = result + p_char_to_str(b);
            i = i + 1;
        }
        return result;
    }
}

// ═══════════════════════════════════════════════════════════════════════
// Self-host stdlib gaps — string/byte/parsing utilities needed by the
// lexer, parser, and typechecker when rewritten in Fides.
// ═══════════════════════════════════════════════════════════════════════

/// Iterate over the bytes of a string, returning a Vec of byte values.
/// Usage: `value bytes = str_bytes("hello");  // [104, 101, 108, 108, 111]`
pub fn str_bytes(s: str) -> Vec<i64> {
    var result: Vec<i64> = Vec::new();
    var slen: i64 = String_len(s);
    var i: i64 = 0;
    while i < slen {
        var addr: i64 = s + i;
        var ptr: *mut u8 = addr;
        var b: i64 = 0;
        unsafe { b = *ptr; }
        result.push(b);
        i = i + 1;
    }
    return result;
}

/// Build a string from a Vec of byte values.
pub fn str_from_bytes(bytes: Vec<i64>) -> str {
    var result: str = "";
    var i: i64 = 0;
    var n: i64 = bytes.len();
    while i < n {
        result = result + p_char_to_str(bytes.get(i));
        i = i + 1;
    }
    return result;
}

/// Get a substring by byte range [start, end).
pub fn str_slice(s: str, start: i64, end: i64) -> str {
    var slen: i64 = String_len(s);
    var s0: i64 = start;
    var e0: i64 = end;
    if s0 < 0 { s0 = 0; }
    if e0 > slen { e0 = slen; }
    if s0 >= e0 { return ""; }
    return String_slice(s, s0, e0);
}

/// str_slice when the length of `s` is already known (`len` bytes).
pub fn str_slice_len(s: str, len: i64, start: i64, end: i64) -> str {
    return String_slice_len(s, len, start, end);
}

/// Check if a string starts with a prefix.
pub fn str_starts_with(s: str, prefix: str) -> bool {
    return String_starts_with(s, prefix);
}

/// Check if a string ends with a suffix.
pub fn str_ends_with(s: str, suffix: str) -> bool {
    return String_ends_with(s, suffix);
}

/// Check if a string contains a substring.
pub fn str_contains(s: str, sub: str) -> bool {
    return String_contains(s, sub);
}

/// Find the first index of a substring, or -1 if not found.
pub fn str_find(s: str, sub: str) -> i64 {
    return String_find(s, sub);
}

/// Find the last index of a substring, or -1 if not found.
pub fn str_rfind(s: str, sub: str) -> i64 {
    return String_rfind(s, sub);
}

/// Trim leading whitespace from a string.
pub fn str_trim_start(s: str) -> str {
    var slen: i64 = String_len(s);
    var i: i64 = 0;
    while i < slen {
        var addr: i64 = s + i;
        var ptr: *mut u8 = addr;
        var b: i64 = 0;
        unsafe { b = *ptr; }
        if !char_is_whitespace(b) { break; }
        i = i + 1;
    }
    if i >= slen { return ""; }
    return String_slice(s, i, slen);
}

/// Trim trailing whitespace from a string.
pub fn str_trim_end(s: str) -> str {
    var slen: i64 = String_len(s);
    var end: i64 = slen;
    while end > 0 {
        var addr: i64 = s + end - 1;
        var ptr: *mut u8 = addr;
        var b: i64 = 0;
        unsafe { b = *ptr; }
        if !char_is_whitespace(b) { break; }
        end = end - 1;
    }
    if end <= 0 { return ""; }
    return String_slice(s, 0, end);
}

/// Trim both leading and trailing whitespace.
pub fn str_trim(s: str) -> str {
    return String_trim(s);
}

/// Split a string into lines by newline (LF).
pub fn str_lines(s: str) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var i: i64 = 0;
    var start: i64 = 0;
    var s_len: i64 = String_len(s);
    while i < s_len {
        if str_byte_at(s, i) == 10 {
            result.push(String_slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    if start < s_len {
        result.push(String_slice(s, start, s_len));
    }
    return result;
}

/// Trim trailing copies of `ch` (plus spaces/tabs) from the end.
pub fn str_trim_end_char(s: str, ch: i64) -> str {
    var end: i64 = String_len(s);
    while end > 0 {
        var b: i64 = str_byte_at(s, end - 1);
        if b == ch || b == 32 || b == 9 {
            end = end - 1;
        } else {
            break;
        }
    }
    if end <= 0 { return ""; }
    return String_slice(s, 0, end);
}

/// Split a string by delimiter, returning a Vec of string parts.
pub fn str_split(s: str, delim: str) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    if String_len(delim) == 0 {
        result.push(s);
        return result;
    }
    var start: i64 = 0;
    var s_len: i64 = String_len(s);
    var dlen: i64 = String_len(delim);
    var pos: i64 = 0;
    while pos <= s_len - dlen {
        var matched: bool = true;
        var j: i64 = 0;
        while j < dlen {
            var s_addr: i64 = s + pos + j;
            var d_addr: i64 = delim + j;
            var s_ptr: *mut u8 = s_addr;
            var d_ptr: *mut u8 = d_addr;
            var sb: i64 = 0;
            var db: i64 = 0;
            unsafe { sb = *s_ptr; db = *d_ptr; }
            if sb != db { matched = false; break; }
            j = j + 1;
        }
        if matched {
            result.push(String_slice(s, start, pos));
            start = pos + dlen;
            pos = start;
        } else {
            pos = pos + 1;
        }
    }
    result.push(String_slice(s, start, s_len));
    return result;
}

/// Split a string by a single character delimiter, returning a Vec of parts.
/// Faster than str_split for single-char delimiters.
pub fn str_split_char(s: str, delim: i64) -> Vec<str> {
    var result: Vec<str> = Vec::new();
    var start: i64 = 0;
    var s_len: i64 = String_len(s);
    var i: i64 = 0;
    while i < s_len {
        var addr: i64 = s + i;
        var ptr: *mut u8 = addr;
        var b: i64 = 0;
        unsafe { b = *ptr; }
        if b == delim {
            result.push(String_slice(s, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    result.push(String_slice(s, start, s_len));
    return result;
}

/// Replace all occurrences of `from` with `to` in a string.
pub fn str_replace(s: str, from: str, to: str) -> str {
    return String_replace(s, from, to);
}

/// An owned copy of a string: how a borrowed `&str` is kept past its owner
/// (release M11). Always a new allocation.
pub fn str_clone(s: str) -> str {
    val n: i64 = str_len(s);
    return String_slice_len(s, n, 0, n);
}

/// Repeat a string n times.
pub fn str_repeat(s: str, n: i64) -> str {
    return String_repeat(s, n);
}

/// Convert a string to uppercase.
pub fn str_to_upper(s: str) -> str {
    return String_to_uppercase(s);
}

/// Convert a string to lowercase.
pub fn str_to_lower(s: str) -> str {
    return String_to_lowercase(s);
}

/// Parse a decimal integer from a string. Returns 0 on failure.
pub fn str_parse_int(s: str) -> i64 {
    return String_parse_int(s);
}

/// Parse a hexadecimal integer from a string. Supports optional "0x" prefix.
/// Returns 0 on failure.
@wrapping
pub fn str_parse_hex(s: str) -> i64 {
    var slen: i64 = String_len(s);
    if slen == 0 { return 0; }
    var i: i64 = 0;
    var result: i64 = 0;
    var negative: bool = false;
    // Skip leading whitespace
    while i < slen {
        var addr: i64 = s + i;
        var ptr: *mut u8 = addr;
        var b: i64 = 0;
        unsafe { b = *ptr; }
        if !char_is_whitespace(b) { break; }
        i = i + 1;
    }
    if i >= slen { return 0; }
    // Check sign
    var addr0: i64 = s + i;
    var ptr0: *mut u8 = addr0;
    var c0: i64 = 0;
    unsafe { c0 = *ptr0; }
    if c0 == 45 { negative = true; i = i + 1; }
    else if c0 == 43 { i = i + 1; }
    // Check for 0x prefix
    if i + 1 < slen {
        var a1: i64 = s + i;
        var p1: *mut u8 = a1;
        var c1: i64 = 0;
        unsafe { c1 = *p1; }
        var a2: i64 = s + i + 1;
        var p2: *mut u8 = a2;
        var c2: i64 = 0;
        unsafe { c2 = *p2; }
        if c1 == 48 && (c2 == 120 || c2 == 88) { i = i + 2; }
    }
    // Parse hex digits
    while i < slen {
        var addr: i64 = s + i;
        var ptr: *mut u8 = addr;
        var b: i64 = 0;
        unsafe { b = *ptr; }
        var digit: i64 = -1;
        if b >= 48 && b <= 57 { digit = b - 48; }
        else if b >= 65 && b <= 70 { digit = b - 55; }
        else if b >= 97 && b <= 102 { digit = b - 87; }
        else { break; }
        result = result * 16 + digit;
        i = i + 1;
    }
    if negative { result = 0 - result; }
    return result;
}

/// Parse an integer from a substring [start, end) of a string.
/// Useful for the lexer which has already extracted digit positions.
pub fn str_parse_int_range(s: str, start: i64, end: i64) -> i64 {
    var slen: i64 = String_len(s);
    var s0: i64 = start;
    var e0: i64 = end;
    if s0 < 0 { s0 = 0; }
    if e0 > slen { e0 = slen; }
    if s0 >= e0 { return 0; }
    var result: i64 = 0;
    var i: i64 = s0;
    while i < e0 {
        var addr: i64 = s + i;
        var ptr: *mut u8 = addr;
        var b: i64 = 0;
        unsafe { b = *ptr; }
        if b < 48 || b > 57 { break; }
        result = result * 10 + (b - 48);
        i = i + 1;
    }
    return result;
}

/// Get the byte at a given index, or -1 if out of bounds.
pub fn str_byte_at(s: str, idx: i64) -> i64 {
    return String_byte_at(s, idx);
}

/// Get the length of a string in bytes.
pub fn str_len(s: str) -> i64 {
    return String_len(s);
}

/// Check if a string is empty.
pub fn str_is_empty(s: str) -> bool {
    return String_is_empty(s);
}

/// Concatenate two strings.
pub fn str_concat(a: str, b: str) -> str {
    return p_str_concat(a, b);
}

/// Compare two strings. Returns 0 if equal, negative if a < b, positive if a > b.
pub fn str_compare(a: str, b: str) -> i64 {
    return p_str_compare(a, b);
}

/// Check if two strings are equal.
pub fn str_equal(a: str, b: str) -> bool {
    return p_str_equal(a, b);
}

/// Convert an integer to a string.
pub fn int_to_str(n: i64) -> str {
    return p_to_str(n);
}

/// A u64 as unsigned decimal text (`print` of a u64 uses this).
pub fn u64_to_str(x: u64) -> str {
    if (x as i64) >= 0 {
        return int_to_str(x as i64);
    }
    val q: u64 = (x >> 1) / 5;
    val r: u64 = x - q * 10;
    return int_to_str(q as i64) + int_to_str(r as i64);
}

/// Convert a float to a string (SH-4.1).
pub fn float_to_str(f: f64) -> str {
    return p_float_to_str(f);
}

/// Parse a float from a string. Returns 0.0 on failure (SH-4.1).
pub fn str_parse_float(s: str) -> f64 {
    return p_str_to_float(s);
}

/// Convert a byte value to a single-character string.
pub fn byte_to_str(b: i64) -> str {
    return p_char_to_str(b);
}
