// Fides typed register blocks (regmap), pure Fides.
//
// A peripheral is described as a RegBlock: a base address and a list of
// RegDesc (name, byte offset, width in bits, access, reset value), each
// with RegFields (name, least significant bit, width, access, optional
// enumerated values). On top of the description:
//   - field get/set on a register value (masking, range checks),
//   - read-modify-write that is safe for registers mixing W1C and RW
//     fields (a plain RMW would write back the 1s it read from a W1C
//     status field and clear pending flags it did not mean to touch),
//   - a consistency check (fields overlapping or beyond the width),
//   - a pretty dump ("CTRL @0x000 = 0x00000105 [EN=1 MODE=FAST(2)]").
//
// What is real and what is the seam. Every access goes through a RegBus.
// A bus made with regbus_mmio() reads and writes memory-mapped I/O with
// the volatile builtins (p_volatile_load8/16/32, p_volatile_load) inside
// @unsafe functions: that path needs real hardware at the address. A bus
// made with regbus_fake() is a register file in a HashMap (address ->
// value) that also models what hardware does with the access kinds:
// writes to RO bits are ignored, writing 1 to a W1C bit clears it, a WO
// register reads back 0; each access is logged. regbus_attach() loads the
// reset values and the access rules of a block into the fake. Tests use
// the fake; drivers use the same functions on the MMIO bus.
//
//   var blk = regblock_new("UART0", 0x40001000);
//   var ctrl = regdesc_new("CTRL", 0x00, 32, REG_RW, 0);
//   regdesc_add_field(&mut ctrl, regfield_new("EN", 0, 1, REG_RW));
//   regblock_add(&mut blk, ctrl);
//   var bus = regbus_fake();
//   regbus_attach(&mut bus, blk);
//   regmap_write_field(&mut bus, blk, "CTRL", "EN", 1);

module regmap;
use vec;
use string;

// ─── Access kinds ───────────────────────────────────────────────────────

/// Read-only: writes are ignored by the hardware.
pub const REG_RO: i64 = 0;
/// Read-write.
pub const REG_RW: i64 = 1;
/// Write-only: reads give 0 (or garbage); the shadow keeps the last write.
pub const REG_WO: i64 = 2;
/// Write-1-to-clear: reading gives the flags, writing 1 clears a flag,
/// writing 0 leaves it.
pub const REG_W1C: i64 = 3;

pub fn regmap_access_name(a: i64) -> str {
    if a == REG_RO {
        return "RO";
    }
    if a == REG_RW {
        return "RW";
    }
    if a == REG_WO {
        return "WO";
    }
    if a == REG_W1C {
        return "W1C";
    }
    return "?";
}

/// Parse "RO", "RW", "WO", "W1C" (also the SVD spellings, see svd.fd);
/// -1 when unknown.
pub fn regmap_access_parse(s: str) -> i64 {
    if str_equal(s, "RO") || str_equal(s, "read-only") {
        return REG_RO;
    }
    if str_equal(s, "RW") || str_equal(s, "read-write") {
        return REG_RW;
    }
    if str_equal(s, "WO") || str_equal(s, "write-only") {
        return REG_WO;
    }
    if str_equal(s, "W1C") || str_equal(s, "oneToClear") {
        return REG_W1C;
    }
    return -1;
}

// ─── Descriptions ───────────────────────────────────────────────────────

/// A bit field: bits lsb .. lsb+width-1 of its register.
pub struct RegField {
    pub name: str,
    pub lsb: i64,
    pub width: i64,
    pub access: i64,
    pub desc: str,
    pub enum_names: Vec<str>,
    pub enum_vals: Vec<i64>,
}

/// A register at `offset` bytes from the block base.
pub struct RegDesc {
    pub name: str,
    pub offset: i64,
    pub width: i64,
    pub access: i64,
    pub reset: i64,
    pub desc: str,
    pub fields: Vec<RegField>,
}

/// A peripheral: a named base address and its registers.
pub struct RegBlock {
    pub name: str,
    pub base: i64,
    pub regs: Vec<RegDesc>,
}

pub fn regfield_new(name: str, lsb: i64, width: i64, access: i64) -> RegField {
    return RegField {
        name: name, lsb: lsb, width: width, access: access, desc: "", enum_names: Vec::new(), enum_vals: Vec::new()
    };
}

/// Add an enumerated value (name, value) to a field.
pub fn regfield_add_enum(f: &mut RegField, name: str, value: i64) {
    f.enum_names.push(name);
    f.enum_vals.push(value);
}

pub fn regdesc_new(name: str, offset: i64, width: i64, access: i64, reset: i64) -> RegDesc {
    return RegDesc {
        name: name, offset: offset, width: width, access: access, reset: reset, desc: "", fields: Vec::new()
    };
}

pub fn regdesc_add_field(r: &mut RegDesc, f: RegField) {
    r.fields.push(f);
}

pub fn regblock_new(name: str, base: i64) -> RegBlock {
    return RegBlock {
        name: name, base: base, regs: Vec::new()
    };
}

pub fn regblock_add(b: &mut RegBlock, r: RegDesc) {
    b.regs.push(r);
}

/// Index of the register named `name`, -1 when absent.
pub fn regblock_find(b: &RegBlock, name: str) -> i64 {
    var i: i64 = 0;
    while i < b.regs.len() {
        if str_equal(b.regs.get(i).name, name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Index of the field named `name` in `r`, -1 when absent.
pub fn regdesc_find_field(r: &RegDesc, name: str) -> i64 {
    var i: i64 = 0;
    while i < r.fields.len() {
        if str_equal(r.fields.get(i).name, name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Absolute address of register `name` (panics when absent).
pub fn regblock_addr(b: &RegBlock, name: str) -> i64 {
    val i: i64 = regblock_find(b, name);
    if i < 0 {
        p_panic("regmap: no register " + name + " in " + b.name);
    }
    return b.base + b.regs.get(i).offset;
}

// ─── Bit math ───────────────────────────────────────────────────────────

/// A mask of `width` ones (width 0..64).
pub fn regmap_ones(width: i64) -> i64 {
    if width >= 64 {
        return -1;
    }
    if width <= 0 {
        return 0;
    }
    return (1 << width) - 1;
}

/// The bits a field covers, in place.
pub fn regfield_mask(f: &RegField) -> i64 {
    return regmap_ones(f.width) << f.lsb;
}

/// The field's value in a register value.
pub fn regfield_get(f: &RegField, regval: i64) -> i64 {
    return (regval >> f.lsb) & regmap_ones(f.width);
}

/// `regval` with the field set to `x` (panics when x does not fit).
pub fn regfield_set(f: &RegField, regval: i64, x: i64) -> i64 {
    if x < 0 || (f.width < 64 && x > regmap_ones(f.width)) {
        p_panic("regmap: value " + int_to_str(x) + " does not fit field " + f.name);
    }
    val m: i64 = regfield_mask(f);
    return (regval & ~m) | ((x << f.lsb) & m);
}

/// Name of the enumerated value `x` of a field, "" when none.
pub fn regfield_enum_name(f: &RegField, x: i64) -> str {
    var i: i64 = 0;
    while i < f.enum_vals.len() {
        if f.enum_vals.get(i) == x {
            return f.enum_names.get(i);
        }
        i = i + 1;
    }
    return "";
}

/// Value of the enumerated name, -1 when none.
pub fn regfield_enum_value(f: &RegField, name: str) -> i64 {
    var i: i64 = 0;
    while i < f.enum_names.len() {
        if str_equal(f.enum_names.get(i), name) {
            return f.enum_vals.get(i);
        }
        i = i + 1;
    }
    return -1;
}

/// Bits of the register that are W1C (from the register's access when it
/// has no fields, else from its W1C fields).
pub fn regdesc_w1c_mask(r: &RegDesc) -> i64 {
    if r.fields.len() == 0 {
        if r.access == REG_W1C {
            return regmap_ones(r.width);
        }
        return 0;
    }
    var m: i64 = 0;
    var i: i64 = 0;
    while i < r.fields.len() {
        val f: RegField = r.fields.get(i);
        if f.access == REG_W1C {
            m = m | regfield_mask(&f);
        }
        i = i + 1;
    }
    return m;
}

/// Bits a write can change (not RO). A register without fields follows
/// its own access.
pub fn regdesc_writable_mask(r: &RegDesc) -> i64 {
    if r.fields.len() == 0 {
        if r.access == REG_RO {
            return 0;
        }
        return regmap_ones(r.width);
    }
    var m: i64 = 0;
    var i: i64 = 0;
    while i < r.fields.len() {
        val f: RegField = r.fields.get(i);
        if f.access != REG_RO {
            m = m | regfield_mask(&f);
        }
        i = i + 1;
    }
    return m;
}

/// The value to write to set field `fi` of `r` to `x`, given the value
/// `old` read from the register: the other RW bits are kept, the W1C
/// bits are written 0 (so no pending flag is cleared by accident) except
/// the target field when it is W1C itself (then `x` is the set of flags
/// to clear).
pub fn regdesc_rmw_value(r: &RegDesc, old: i64, fi: i64, x: i64) -> i64 {
    val f: RegField = r.fields.get(fi);
    var v: i64 = old & ~regdesc_w1c_mask(r);
    v = regfield_set(&f, v, x);
    return v & regmap_ones(r.width);
}

/// Problems of a block: fields overlapping each other, beyond the
/// register width, registers overlapping, offsets not aligned to their
/// width. Empty when consistent.
pub fn regblock_check(b: &RegBlock) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < b.regs.len() {
        val r: RegDesc = b.regs.get(i);
        val bytes: i64 = r.width / 8;
        if r.width != 8 && r.width != 16 && r.width != 32 && r.width != 64 {
            errs.push(r.name + ": width " + int_to_str(r.width));
        } else if r.offset % bytes != 0 {
            errs.push(r.name + ": offset " + regmap_hex(r.offset, 3) + " not aligned");
        }
        var seen: i64 = 0;
        var j: i64 = 0;
        while j < r.fields.len() {
            val f: RegField = r.fields.get(j);
            if f.width <= 0 || f.lsb < 0 || f.lsb + f.width > r.width {
                errs.push(r.name + "." + f.name + ": bits outside the register");
            } else {
                val m: i64 = regfield_mask(&f);
                if (seen & m) != 0 {
                    errs.push(r.name + "." + f.name + ": overlaps another field");
                }
                seen = seen | m;
            }
            j = j + 1;
        }
        var k: i64 = i + 1;
        while k < b.regs.len() {
            val o: RegDesc = b.regs.get(k);
            val a0: i64 = r.offset;
            val a1: i64 = r.offset + bytes;
            val b0: i64 = o.offset;
            val b1: i64 = o.offset + o.width / 8;
            if a0 < b1 && b0 < a1 {
                errs.push(r.name + " and " + o.name + " overlap");
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return errs;
}

// ─── Hex formatting ─────────────────────────────────────────────────────

/// `v` as 0x followed by at least `digits` hex digits (the 64-bit
/// pattern for negative values).
pub fn regmap_hex(v: i64, digits: i64) -> str {
    return "0x" + regmap_hex_digits(v, digits);
}

pub fn regmap_hex_digits(v: i64, digits: i64) -> str {
    val hexd: str = "0123456789ABCDEF";
    var out: str = "";
    var x: i64 = v;
    var n: i64 = 0;
    while n < 16 {
        if n > 0 && n >= digits && x == 0 {
            break;
        }
        val d: i64 = x & 15;
        out = str_slice(hexd, d, d + 1) + out;
        x = (x >> 4) & 0x0FFFFFFFFFFFFFFF;
        n = n + 1;
    }
    return out;
}

// ─── The bus seam ───────────────────────────────────────────────────────

/// Register access. mode 0: fake register file (`mem`, with the access
/// rules of attached registers in `rules`); mode 1: real MMIO.
pub struct RegBus {
    pub mode: i64,
    pub mem: HashMap<i64,
     i64>,
    pub ro_mask: HashMap<i64,
     i64>,
    pub w1c_mask: HashMap<i64,
     i64>,
    pub wo: HashMap<i64,
     i64>,
    pub log: Vec<str>,
    pub logging: bool,
    pub reads: i64,
    pub writes: i64,
}

/// A fake register file: reads of unknown addresses give 0.
pub fn regbus_fake() -> RegBus {
    return RegBus {
        mode: 0, mem: HashMap::new(), ro_mask: HashMap::new(), w1c_mask: HashMap::new(), wo: HashMap::new(), log: Vec::new(), logging: true, reads: 0, writes: 0
    };
}

/// A bus on real memory-mapped I/O (addresses are physical/bus addresses
/// the program can reach).
pub fn regbus_mmio() -> RegBus {
    var b: RegBus = regbus_fake();
    b.mode = 1;
    b.logging = false;
    return b;
}

@unsafe
fn regbus_mmio_read(addr: i64, width: i64) -> i64 {
    if width == 8 {
        return p_volatile_load8(addr);
    }
    if width == 16 {
        return p_volatile_load16(addr);
    }
    if width == 32 {
        return p_volatile_load32(addr);
    }
    return p_volatile_load(addr);
}

@unsafe
fn regbus_mmio_write(addr: i64, width: i64, v: i64) {
    if width == 8 {
        p_volatile_store8(addr, v);
        return;
    }
    if width == 16 {
        p_volatile_store16(addr, v);
        return;
    }
    if width == 32 {
        p_volatile_store32(addr, v);
        return;
    }
    p_volatile_store(addr, v);
}

/// Load a block into a fake bus: reset values, and which bits are RO, W1C
/// or write-only, so the fake behaves as the hardware would.
pub fn regbus_attach(bus: &mut RegBus, b: RegBlock) {
    var i: i64 = 0;
    while i < b.regs.len() {
        val r: RegDesc = b.regs.get(i);
        val a: i64 = b.base + r.offset;
        bus.mem.insert(a, r.reset & regmap_ones(r.width));
        bus.ro_mask.insert(a, regmap_ones(r.width) & ~regdesc_writable_mask(&r));
        bus.w1c_mask.insert(a, regdesc_w1c_mask(&r));
        if r.access == REG_WO {
            bus.wo.insert(a, 1);
        }
        i = i + 1;
    }
}

/// Hardware side of the fake: set bits of a register directly (a status
/// flag rising, a received byte), ignoring the access rules.
pub fn regbus_poke(bus: &mut RegBus, addr: i64, v: i64) {
    bus.mem.insert(addr, v);
}

/// What the fake holds at `addr` (no access rules, no log).
pub fn regbus_peek(bus: &RegBus, addr: i64) -> i64 {
    if bus.mem.contains(addr) {
        return bus.mem.get(addr);
    }
    return 0;
}

/// Read `width` bits at `addr`.
pub fn regbus_read(bus: &mut RegBus, addr: i64, width: i64) -> i64 {
    bus.reads = bus.reads + 1;
    if bus.mode == 1 {
        // SAFETY: mode 1 is the real-device path — bus addresses come from the board's register map, and width is one of 8/16/32 (the bus driver validates), so the MMIO read touches the mapped device only.
        unsafe {
            return regbus_mmio_read(addr, width);
        }
    }
    var v: i64 = 0;
    if bus.mem.contains(addr) && !bus.wo.contains(addr) {
        v = bus.mem.get(addr) & regmap_ones(width);
    }
    if bus.logging {
        bus.log.push("R " + regmap_hex(addr, 8) + " -> " + regmap_hex(v, width / 4));
    }
    return v;
}

/// Write `width` bits at `addr`. On the fake: RO bits keep their value,
/// a 1 written to a W1C bit clears it, other bits take the written value.
pub fn regbus_write(bus: &mut RegBus, addr: i64, width: i64, v: i64) {
    bus.writes = bus.writes + 1;
    val w: i64 = v & regmap_ones(width);
    if bus.mode == 1 {
        // SAFETY: mode 1 is the real-device path — bus addresses come from the board's register map, w is masked to width, and width is one of 8/16/32, so the MMIO write touches the mapped device only.
        unsafe {
            regbus_mmio_write(addr, width, w);
        }
        return;
    }
    if bus.logging {
        bus.log.push("W " + regmap_hex(addr, 8) + " <- " + regmap_hex(w, width / 4));
    }
    var old: i64 = 0;
    if bus.mem.contains(addr) {
        old = bus.mem.get(addr);
    }
    var ro: i64 = 0;
    if bus.ro_mask.contains(addr) {
        ro = bus.ro_mask.get(addr);
    }
    var w1c: i64 = 0;
    if bus.w1c_mask.contains(addr) {
        w1c = bus.w1c_mask.get(addr);
    }
    val normal: i64 = ~(ro | w1c);
    var nv: i64 = (old & ro) | (w & normal);
    // W1C: a bit stays set unless a 1 was written to it.
    nv = nv | (old & w1c & ~w);
    bus.mem.insert(addr, nv & regmap_ones(width));
}

// ─── Register-level operations ──────────────────────────────────────────

fn regmap_reg(b: &RegBlock, name: str) -> RegDesc {
    val i: i64 = regblock_find(b, name);
    if i < 0 {
        p_panic("regmap: no register " + name + " in " + b.name);
    }
    return b.regs.get(i);
}

/// Read register `name` of block `b`.
pub fn regmap_read(bus: &mut RegBus, b: RegBlock, name: str) -> i64 {
    val r: RegDesc = regmap_reg(&b, name);
    return regbus_read(bus, b.base + r.offset, r.width);
}

/// Write register `name` (the whole value).
pub fn regmap_write(bus: &mut RegBus, b: RegBlock, name: str, v: i64) {
    val r: RegDesc = regmap_reg(&b, name);
    if r.access == REG_RO {
        p_panic("regmap: " + name + " is read-only");
    }
    regbus_write(bus, b.base + r.offset, r.width, v);
}

/// Read one field.
pub fn regmap_read_field(bus: &mut RegBus, b: RegBlock, reg: str, field: str) -> i64 {
    val r: RegDesc = regmap_reg(&b, reg);
    val fi: i64 = regdesc_find_field(&r, field);
    if fi < 0 {
        p_panic("regmap: no field " + reg + "." + field);
    }
    val v: i64 = regbus_read(bus, b.base + r.offset, r.width);
    return regfield_get(&r.fields.get(fi), v);
}

/// Read-modify-write one field. A write-only register cannot be read:
/// its reset value is the base (callers of WO registers usually write
/// whole values). W1C bits of other fields are written 0.
pub fn regmap_write_field(bus: &mut RegBus, b: RegBlock, reg: str, field: str, x: i64) {
    val r: RegDesc = regmap_reg(&b, reg);
    val fi: i64 = regdesc_find_field(&r, field);
    if fi < 0 {
        p_panic("regmap: no field " + reg + "." + field);
    }
    if r.fields.get(fi).access == REG_RO {
        p_panic("regmap: " + reg + "." + field + " is read-only");
    }
    val addr: i64 = b.base + r.offset;
    var old: i64 = r.reset;
    if r.access != REG_WO {
        old = regbus_read(bus, addr, r.width);
    }
    regbus_write(bus, addr, r.width, regdesc_rmw_value(&r, old, fi, x));
}

/// Set a field by enumerated name ("FAST").
pub fn regmap_write_enum(bus: &mut RegBus, b: RegBlock, reg: str, field: str, ename: str) {
    val r: RegDesc = regmap_reg(&b, reg);
    val fi: i64 = regdesc_find_field(&r, field);
    if fi < 0 {
        p_panic("regmap: no field " + reg + "." + field);
    }
    val x: i64 = regfield_enum_value(&r.fields.get(fi), ename);
    if x < 0 {
        p_panic("regmap: no value " + ename + " for " + reg + "." + field);
    }
    regmap_write_field(bus, b, reg, field, x);
}

/// Several fields of one register in one read-modify-write.
pub fn regmap_write_fields(bus: &mut RegBus, b: RegBlock, reg: str, fields: Vec<str>, vals: Vec<i64>) {
    val r: RegDesc = regmap_reg(&b, reg);
    val addr: i64 = b.base + r.offset;
    var v: i64 = r.reset;
    if r.access != REG_WO {
        v = regbus_read(bus, addr, r.width);
    }
    v = v & ~regdesc_w1c_mask(&r);
    var i: i64 = 0;
    while i < fields.len() {
        val fi: i64 = regdesc_find_field(&r, fields.get(i));
        if fi < 0 {
            p_panic("regmap: no field " + reg + "." + fields.get(i));
        }
        v = regfield_set(&r.fields.get(fi), v, vals.get(i));
        i = i + 1;
    }
    regbus_write(bus, addr, r.width, v);
}

/// Clear W1C flags: write the mask (only the given bits).
pub fn regmap_clear_flags(bus: &mut RegBus, b: RegBlock, reg: str, mask: i64) {
    val r: RegDesc = regmap_reg(&b, reg);
    regbus_write(bus, b.base + r.offset, r.width, mask & regdesc_w1c_mask(&r));
}

/// Poll a field until it equals `want`, at most `tries` reads. True when
/// it did.
pub fn regmap_wait_field(bus: &mut RegBus, b: RegBlock, reg: str, field: str, want: i64, tries: i64) -> bool {
    var n: i64 = 0;
    while n < tries {
        if regmap_read_field(bus, b, reg, field) == want {
            return true;
        }
        n = n + 1;
    }
    return false;
}

// ─── Pretty dump ────────────────────────────────────────────────────────

/// One register value decoded field by field: "EN=1 MODE=FAST(2)".
pub fn regdesc_decode(r: &RegDesc, v: i64) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < r.fields.len() {
        val f: RegField = r.fields.get(i);
        val x: i64 = regfield_get(&f, v);
        if i > 0 {
            out = out + " ";
        }
        val en: str = regfield_enum_name(&f, x);
        if str_len(en) > 0 {
            out = out + f.name + "=" + en + "(" + int_to_str(x) + ")";
        } else if f.width > 4 {
            out = out + f.name + "=" + regmap_hex(x, (f.width + 3) / 4);
        } else {
            out = out + f.name + "=" + int_to_str(x);
        }
        i = i + 1;
    }
    return out;
}

fn regmap_pad(s: str, n: i64) -> str {
    var out: str = s;
    while str_len(out) < n {
        out = out + " ";
    }
    return out;
}

/// The block, one register per line, read through the bus (write-only
/// registers are shown as "--" and not read).
pub fn regmap_dump(bus: &mut RegBus, b: RegBlock) -> str {
    var w: i64 = 0;
    var i: i64 = 0;
    while i < b.regs.len() {
        if str_len(b.regs.get(i).name) > w {
            w = str_len(b.regs.get(i).name);
        }
        i = i + 1;
    }
    var out: str = b.name + " @ " + regmap_hex(b.base, 8) + "\n";
    i = 0;
    while i < b.regs.len() {
        val r: RegDesc = b.regs.get(i);
        var line: str = "  " + regmap_pad(r.name, w) + " +" + regmap_hex(r.offset, 3) + " " + regmap_pad(regmap_access_name(r.access), 3) + " = ";
        if r.access == REG_WO {
            line = line + "--";
        } else {
            val v: i64 = regbus_read(bus, b.base + r.offset, r.width);
            line = line + regmap_hex(v, r.width / 4);
            if r.fields.len() > 0 {
                line = line + "  [" + regdesc_decode(&r, v) + "]";
            }
        }
        out = out + line + "\n";
        i = i + 1;
    }
    return out;
}
