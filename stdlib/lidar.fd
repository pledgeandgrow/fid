// Fides 2D laser scans (robotics)
//
// A `LaserScan` is what a planar lidar reports, as in ROS's
// sensor_msgs/LaserScan: beam i at angle angle_min + i * angle_inc (radians,
// counter-clockwise, 0 = straight ahead along x) with range ranges[i]
// (metres). A reading is valid when it is a number in
// [range_min, range_max]; drivers report "no return" as 0, a negative
// value, NaN, or something beyond range_max, and all of those are invalid.
//
//   lidar_to_points / _pose      polar to Cartesian (sensor frame or a pose)
//   lidar_filter_range           keep readings in [lo, hi], others set to 0
//   lidar_median_filter          median of the valid readings in a window
//   lidar_extract_lines          split-and-merge line extraction: the points
//                                are cut at gaps, each run split
//                                recursively at the point farthest from the
//                                chord while that distance exceeds a
//                                threshold, neighbouring segments merged
//                                when one line fits both, and every segment
//                                fitted by total least squares in Hesse
//                                form x cos(alpha) + y sin(alpha) = r
//   lidar_match                  scan matching: pointcloud's ICP on the two
//                                scans' points (z = 0) from a pose guess;
//                                point-to-point, so two scans that sample
//                                the walls at different places match to
//                                about a centimetre, not exactly
//
// Everything here is pure computation. The seam is the scan itself: the
// caller's driver fills `ranges` (for example from a serial or UDP packet
// decoder); nothing here talks to a device.
//
// Usage:
//   use math; use quat; use transform3d; use pointcloud; use lidar;
//   val scan = lidar_scan_new(-3.14159, 0.0174533, 0.05, 12.0, ranges);
//   val lines = lidar_extract_lines(&scan, 0.3, 0.02, 5);
//   val m = lidar_match(&previous, &scan, 0.0, 0.0, 0.0, 0.5);

module lidar;
use math;
use quat;
use transform3d;
use pointcloud;

/// A planar laser scan.
pub struct LaserScan {
    pub angle_min: f64,
    pub angle_inc: f64,
    pub range_min: f64,
    pub range_max: f64,
    pub ranges: Vec<f64>,
}

/// A scan from its fields.
pub fn lidar_scan_new(angle_min: f64, angle_inc: f64, range_min: f64, range_max: f64, ranges: Vec<f64>) -> LaserScan {
    return LaserScan {
        angle_min: angle_min, angle_inc: angle_inc, range_min: range_min, range_max: range_max, ranges: ranges
    };
}

/// The number of beams.
pub fn lidar_len(s: &LaserScan) -> i64 {
    return s.ranges.len();
}

/// The angle of beam i.
pub fn lidar_angle(s: &LaserScan, i: i64) -> f64 {
    return s.angle_min + (i as f64) * s.angle_inc;
}

/// True when reading i is a number in [range_min, range_max] and > 0.
pub fn lidar_is_valid(s: &LaserScan, i: i64) -> bool {
    val r: f64 = s.ranges.get(i);
    return r == r && r > 0.0 && r >= s.range_min && r <= s.range_max;
}

/// How many readings are valid.
pub fn lidar_valid_count(s: &LaserScan) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < s.ranges.len() {
        if lidar_is_valid(s, i) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// The valid readings as points in the sensor frame, in beam order.
pub fn lidar_to_points(s: &LaserScan) -> Vec<vec2> {
    return lidar_to_points_pose(s, 0.0, 0.0, 0.0);
}

/// The valid readings as points in the frame where the sensor is at
/// (x, y) facing theta.
pub fn lidar_to_points_pose(s: &LaserScan, x: f64, y: f64, theta: f64) -> Vec<vec2> {
    var out: Vec<vec2> = Vec::new();
    var i: i64 = 0;
    while i < s.ranges.len() {
        if lidar_is_valid(s, i) {
            val a: f64 = theta + lidar_angle(s, i);
            val r: f64 = s.ranges.get(i);
            out.push(vec2(x + r * math_cos(a), y + r * math_sin(a)));
        }
        i = i + 1;
    }
    return out;
}

/// The valid readings as 3D points (z = 0) for pointcloud.
pub fn lidar_to_points3(s: &LaserScan) -> Vec<vec3> {
    val p: Vec<vec2> = lidar_to_points(s);
    var out: Vec<vec3> = Vec::new();
    var i: i64 = 0;
    while i < p.len() {
        out.push(vec3(p.get(i).x, p.get(i).y, 0.0));
        i = i + 1;
    }
    return out;
}

/// A copy of s whose readings outside [lo, hi] (and invalid ones) are 0.
pub fn lidar_filter_range(s: &LaserScan, lo: f64, hi: f64) -> LaserScan {
    var r: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < s.ranges.len() {
        val v: f64 = s.ranges.get(i);
        if lidar_is_valid(s, i) && v >= lo && v <= hi {
            r.push(v);
        } else {
            r.push(0.0);
        }
        i = i + 1;
    }
    return lidar_scan_new(s.angle_min, s.angle_inc, s.range_min, s.range_max, r);
}

/// A copy of s where each valid reading is replaced by the median of the
/// valid readings among beams i - half .. i + half (invalid ones stay).
pub fn lidar_median_filter(s: &LaserScan, half: i64) -> LaserScan {
    var r: Vec<f64> = Vec::new();
    val n: i64 = s.ranges.len();
    var i: i64 = 0;
    while i < n {
        if !lidar_is_valid(s, i) {
            r.push(s.ranges.get(i));
        } else {
            var w: Vec<f64> = Vec::new();
            var j: i64 = i - half;
            while j <= i + half {
                if j >= 0 && j < n && lidar_is_valid(s, j) {
                    // insertion keeps w sorted
                    val v: f64 = s.ranges.get(j);
                    var k: i64 = w.len();
                    while k > 0 && w.get(k - 1) > v {
                        k = k - 1;
                    }
                    w.insert(k, v);
                }
                j = j + 1;
            }
            val m: i64 = w.len();
            if m % 2 == 1 {
                r.push(w.get(m / 2));
            } else {
                r.push(0.5 * (w.get(m / 2 - 1) + w.get(m / 2)));
            }
        }
        i = i + 1;
    }
    return lidar_scan_new(s.angle_min, s.angle_inc, s.range_min, s.range_max, r);
}

// ─── Line extraction ───

/// A fitted line segment: x cos(alpha) + y sin(alpha) = r (r >= 0), its
/// end points projected on the line, and the points it was fitted to.
pub struct LineSeg {
    pub r: f64,
    pub alpha: f64,
    pub start: vec2,
    pub end: vec2,
    pub first: i64,
    pub last: i64,
    pub count: i64,
}

/// The distance from p to the line through a and b (|a - p| if a == b).
fn lidar_chord_dist(p: vec2, a: vec2, b: vec2) -> f64 {
    val d: vec2 = b.sub(a);
    val l: f64 = d.length();
    if l < 0.000000000001 {
        return p.sub(a).length();
    }
    return math_fabs(d.x * (a.y - p.y) - d.y * (a.x - p.x)) / l;
}

/// The total-least-squares line through pts[first..=last].
pub fn lidar_fit_line(pts: &Vec<vec2>, first: i64, last: i64) -> LineSeg {
    val n: f64 = (last - first + 1) as f64;
    var mx: f64 = 0.0;
    var my: f64 = 0.0;
    var i: i64 = first;
    while i <= last {
        mx = mx + pts.get(i).x;
        my = my + pts.get(i).y;
        i = i + 1;
    }
    mx = mx / n;
    my = my / n;
    var sxx: f64 = 0.0;
    var syy: f64 = 0.0;
    var sxy: f64 = 0.0;
    i = first;
    while i <= last {
        val dx: f64 = pts.get(i).x - mx;
        val dy: f64 = pts.get(i).y - my;
        sxx = sxx + dx * dx;
        syy = syy + dy * dy;
        sxy = sxy + dx * dy;
        i = i + 1;
    }
    // the normal angle minimizing the sum of squared distances
    var alpha: f64 = 0.5 * rmath_atan2(0.0 - 2.0 * sxy, syy - sxx);
    var r: f64 = mx * math_cos(alpha) + my * math_sin(alpha);
    if r < 0.0 {
        r = 0.0 - r;
        alpha = alpha + rmath_pi();
    }
    alpha = rmath_wrap_angle(alpha);
    val c: f64 = math_cos(alpha);
    val s: f64 = math_sin(alpha);
    // project the end points onto the line
    val a: vec2 = pts.get(first);
    val b: vec2 = pts.get(last);
    val da: f64 = a.x * c + a.y * s - r;
    val db: f64 = b.x * c + b.y * s - r;
    return LineSeg {
        r: r, alpha: alpha, start: vec2(a.x - da * c, a.y - da * s), end: vec2(b.x - db * c, b.y - db * s), first: first, last: last, count: last - first + 1
    };
}

/// The largest distance of pts[first..=last] from the line of seg.
fn lidar_max_line_dist(pts: &Vec<vec2>, seg: LineSeg) -> f64 {
    val c: f64 = math_cos(seg.alpha);
    val s: f64 = math_sin(seg.alpha);
    var m: f64 = 0.0;
    var i: i64 = seg.first;
    while i <= seg.last {
        m = rmath_max(m, math_fabs(pts.get(i).x * c + pts.get(i).y * s - seg.r));
        i = i + 1;
    }
    return m;
}

/// Split pts[first..=last] recursively; appends (first, last) ranges.
fn lidar_split(pts: &Vec<vec2>, first: i64, last: i64, thresh: f64, out: &mut Vec<i64>) {
    if last - first < 2 {
        out.push(first);
        out.push(last);
        return;
    }
    val a: vec2 = pts.get(first);
    val b: vec2 = pts.get(last);
    var best: i64 = first;
    var bd: f64 = 0.0;
    var i: i64 = first + 1;
    while i < last {
        val d: f64 = lidar_chord_dist(pts.get(i), a, b);
        if d > bd {
            bd = d;
            best = i;
        }
        i = i + 1;
    }
    if bd > thresh {
        lidar_split(pts, first, best, thresh, out);
        lidar_split(pts, best, last, thresh, out);
    } else {
        out.push(first);
        out.push(last);
    }
}

/// Line segments of an ordered point list: runs are cut where consecutive
/// points are more than `gap` apart, split while a point is more than
/// `thresh` from the chord, merged back while one fitted line stays within
/// `thresh` of both neighbours' points; segments with fewer than
/// `min_points` points are dropped.
pub fn lidar_extract_lines_pts(pts: &Vec<vec2>, gap: f64, thresh: f64, min_points: i64) -> Vec<LineSeg> {
    var ranges: Vec<i64> = Vec::new();
    val n: i64 = pts.len();
    var start: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        if i == n || pts.get(i).sub(pts.get(i - 1)).length() > gap {
            if i - 1 > start {
                lidar_split(pts, start, i - 1, thresh, &mut ranges);
            }
            start = i;
        }
        i = i + 1;
    }
    // fit, then merge neighbours that share an end point and one line
    var segs: Vec<LineSeg> = Vec::new();
    i = 0;
    while i < ranges.len() / 2 {
        val f: i64 = ranges.get(2 * i);
        val l: i64 = ranges.get(2 * i + 1);
        val seg: LineSeg = lidar_fit_line(pts, f, l);
        if segs.len() > 0 && segs.get(segs.len() - 1).last == f {
            val prev: LineSeg = segs.get(segs.len() - 1);
            val joined: LineSeg = lidar_fit_line(pts, prev.first, l);
            if lidar_max_line_dist(pts, joined) <= thresh {
                segs.set(segs.len() - 1, joined);
            } else {
                segs.push(seg);
            }
        } else {
            segs.push(seg);
        }
        i = i + 1;
    }
    // a split point belongs to both neighbours: refit each without the
    // shared corner point
    var out: Vec<LineSeg> = Vec::new();
    i = 0;
    while i < segs.len() {
        var s: LineSeg = segs.get(i);
        var f: i64 = s.first;
        var l: i64 = s.last;
        if i > 0 && segs.get(i - 1).last == f {
            f = f + 1;
        }
        if i + 1 < segs.len() && segs.get(i + 1).first == l {
            l = l - 1;
        }
        if l - f + 1 >= min_points && l - f >= 1 {
            out.push(lidar_fit_line(pts, f, l));
        }
        i = i + 1;
    }
    return out;
}

/// Line segments of a scan (sensor frame); see lidar_extract_lines_pts.
pub fn lidar_extract_lines(s: &LaserScan, gap: f64, thresh: f64, min_points: i64) -> Vec<LineSeg> {
    val pts: Vec<vec2> = lidar_to_points(s);
    return lidar_extract_lines_pts(&pts, gap, thresh, min_points);
}

/// The length of a segment.
pub fn lidar_seg_length(seg: &LineSeg) -> f64 {
    return seg.end.sub(seg.start).length();
}

// ─── Scan matching ───

/// The pose of a scan's sensor in a reference scan's frame.
pub struct ScanMatch {
    pub x: f64,
    pub y: f64,
    pub theta: f64,
    pub rmse: f64,
    pub converged: bool,
    pub iterations: i64,
}

/// Where the sensor of `cur` is in the frame of `reference`, by ICP of the
/// two scans' points from the guess (x, y, theta); pairs farther apart than
/// max_dist are ignored.
pub fn lidar_match(reference: &LaserScan, cur: &LaserScan, x: f64, y: f64, theta: f64, max_dist: f64) -> ScanMatch {
    val a: Vec<vec3> = lidar_to_points3(reference);
    val b: Vec<vec3> = lidar_to_points3(cur);
    val guess: Transform3 = tf3_new(qt_from_axis_angle(vec3(0.0, 0.0, 1.0), theta), vec3(x, y, 0.0));
    val r: IcpResult = pcl_icp(&b, &a, guess, 100, max_dist, 0.0000001);
    val e: EulerZYX = qt_to_euler_zyx(r.transform.rot);
    return ScanMatch {
        x: r.transform.trans.x, y: r.transform.trans.y, theta: e.yaw, rmse: r.rmse, converged: r.converged, iterations: r.iterations
    };
}
