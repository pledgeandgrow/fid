// Fides Physics standard library — Phase 8D (S6)
//
// 2D collision detection and rigid body physics.
// Provides AABB collision, circle collision, raycasting, and simple
// rigid body dynamics (velocity, acceleration, gravity).
//
// Usage:
//   use physics;
//   value body = physics_body_create(100.0, 200.0, 32, 32);
//   physics_body_set_velocity(body, 50.0, 0.0);
//   physics_body_update(body, 0.016, 980.0); // dt=16ms, gravity=980px/s²
//   value hit = physics_aabb_collides(a, b);

module physics;

// ─── AABB (Axis-Aligned Bounding Box) ─────────────────────────────────────

pub struct AABB {
    pub x: f64,       // top-left x
    pub y: f64,       // top-left y
    pub width: f64,   // box width
    pub height: f64,  // box height
}

/// Create an AABB.
pub fn physics_aabb_new(x: f64, y: f64, width: f64, height: f64) -> AABB {
    return AABB { x: x, y: y, width: width, height: height };
}

/// Check if two AABBs overlap.
pub fn physics_aabb_collides(a: AABB, b: AABB) -> bool {
    if a.x + a.width <= b.x { return false; }
    if b.x + b.width <= a.x { return false; }
    if a.y + a.height <= b.y { return false; }
    if b.y + b.height <= a.y { return false; }
    return true;
}

/// Check if a point is inside an AABB.
pub fn physics_aabb_contains_point(box: AABB, px: f64, py: f64) -> bool {
    return px >= box.x && px <= box.x + box.width && py >= box.y && py <= box.y + box.height;
}

/// Get the center of an AABB.
pub fn physics_aabb_center(box: AABB) -> (f64, f64) {
    return (box.x + box.width / 2.0, box.y + box.height / 2.0);
}

/// Get the overlap region of two overlapping AABBs. Returns (x, y, w, h).
/// If they don't overlap, returns (0, 0, 0, 0).
pub fn physics_aabb_overlap(a: AABB, b: AABB) -> (f64, f64, f64, f64) {
    var x0 = a.x;
    if b.x > x0 { x0 = b.x; }
    var y0 = a.y;
    if b.y > y0 { y0 = b.y; }
    var x1 = a.x + a.width;
    if b.x + b.width < x1 { x1 = b.x + b.width; }
    var y1 = a.y + a.height;
    if b.y + b.height < y1 { y1 = b.y + b.height; }

    if x1 <= x0 || y1 <= y0 {
        return (0.0, 0.0, 0.0, 0.0);
    }
    return (x0, y0, x1 - x0, y1 - y0);
}

/// Compute the minimum translation vector to separate two overlapping AABBs.
/// Returns (dx, dy) — the direction to push `a` out of `b`.
pub fn physics_aabb_mtv(a: AABB, b: AABB) -> (f64, f64) {
    // Calculate overlap on each axis
    var overlap_left = (a.x + a.width) - b.x;       // a's right edge past b's left
    var overlap_right = (b.x + b.width) - a.x;       // b's right edge past a's left
    var overlap_top = (a.y + a.height) - b.y;        // a's bottom past b's top
    var overlap_bottom = (b.y + b.height) - a.y;     // b's bottom past a's top

    // Find minimum overlap axis
    var min_x = overlap_left;
    if overlap_right < min_x { min_x = overlap_right; }
    var min_y = overlap_top;
    if overlap_bottom < min_y { min_y = overlap_bottom; }

    if min_x < min_y {
        // Push along X axis
        if overlap_left < overlap_right {
            return (-min_x, 0.0);  // push a left
        } else {
            return (min_x, 0.0);   // push a right
        }
    } else {
        // Push along Y axis
        if overlap_top < overlap_bottom {
            return (0.0, -min_y);  // push a up
        } else {
            return (0.0, min_y);   // push a down
        }
    }
}

// ─── Circle Collision ─────────────────────────────────────────────────────

pub struct Circle {
    pub cx: f64,    // center x
    pub cy: f64,    // center y
    pub radius: f64,
}

/// Create a circle.
pub fn physics_circle_new(cx: f64, cy: f64, radius: f64) -> Circle {
    return Circle { cx: cx, cy: cy, radius: radius };
}

/// Check if two circles overlap.
pub fn physics_circle_collides(a: Circle, b: Circle) -> bool {
    var dx = a.cx - b.cx;
    var dy = a.cy - b.cy;
    var r = a.radius + b.radius;
    return dx * dx + dy * dy <= r * r;
}

/// Check if a point is inside a circle.
pub fn physics_circle_contains(c: Circle, px: f64, py: f64) -> bool {
    var dx = px - c.cx;
    var dy = py - c.cy;
    return dx * dx + dy * dy <= c.radius * c.radius;
}

/// Get the distance between two circle centers.
pub fn physics_circle_distance(a: Circle, b: Circle) -> f64 {
    var dx = a.cx - b.cx;
    var dy = a.cy - b.cy;
    // Square root via math_sqrt — but we can't import math in stdlib easily.
    // Use a simple Newton's method approximation.
    var d2 = dx * dx + dy * dy;
    if d2 == 0.0 { return 0.0; }
    var x = d2;
    var i = 0;
    while i < 10 {
        x = (x + d2 / x) * 0.5;
        i = i + 1;
    }
    return x;
}

// ─── Raycasting ───────────────────────────────────────────────────────────

pub struct Ray {
    pub origin_x: f64,
    pub origin_y: f64,
    pub dir_x: f64,    // normalized direction
    pub dir_y: f64,
    pub max_dist: f64, // maximum ray distance
}

/// Create a ray from origin in a direction with max distance.
pub fn physics_ray_new(ox: f64, oy: f64, dx: f64, dy: f64, max_dist: f64) -> Ray {
    // Normalize direction
    var len2 = dx * dx + dy * dy;
    var len = len2;
    if len2 > 0.0 {
        // Newton's method sqrt
        var x = len2;
        var i = 0;
        while i < 10 {
            x = (x + len2 / x) * 0.5;
            i = i + 1;
        }
        len = x;
    } else {
        len = 1.0;
    }
    return Ray {
        origin_x: ox,
        origin_y: oy,
        dir_x: dx / len,
        dir_y: dy / len,
        max_dist: max_dist,
    };
}

/// Ray vs AABB intersection. Returns the hit distance, or -1.0 if no hit.
/// Uses the slab method.
pub fn physics_ray_vs_aabb(ray: Ray, box: AABB) -> f64 {
    var inv_dx = 1.0 / ray.dir_x;
    var inv_dy = 1.0 / ray.dir_y;

    // X slab
    var tx1 = (box.x - ray.origin_x) * inv_dx;
    var tx2 = (box.x + box.width - ray.origin_x) * inv_dx;
    var tmin = tx1;
    var tmax = tx2;
    if tmin > tmax {
        var tmp = tmin;
        tmin = tmax;
        tmax = tmp;
    }

    // Y slab
    var ty1 = (box.y - ray.origin_y) * inv_dy;
    var ty2 = (box.y + box.height - ray.origin_y) * inv_dy;
    if ty1 > ty2 {
        var tmp = ty1;
        ty1 = ty2;
        ty2 = tmp;
    }

    if tmax < ty1 { return -1.0; }
    if ty2 < tmin { return -1.0; }

    if ty1 > tmin { tmin = ty1; }
    if ty2 < tmax { tmax = ty2; }

    if tmax < 0.0 { return -1.0; }
    if tmin > ray.max_dist { return -1.0; }

    if tmin < 0.0 {
        return tmax;  // ray origin is inside the box
    }
    return tmin;
}

/// Ray vs circle intersection. Returns hit distance or -1.0.
pub fn physics_ray_vs_circle(ray: Ray, c: Circle) -> f64 {
    var ox = ray.origin_x - c.cx;
    var oy = ray.origin_y - c.cy;

    // Quadratic: |o + t*d - c|² = r²
    // a = d·d = 1 (normalized)
    // b = 2 * (o · d)
    // c_coeff = o·o - r²
    var b = 2.0 * (ox * ray.dir_x + oy * ray.dir_y);
    var cc = ox * ox + oy * oy - c.radius * c.radius;

    var discriminant = b * b - 4.0 * cc;
    if discriminant < 0.0 { return -1.0; }

    // sqrt via Newton's method
    var d = discriminant;
    var x = d;
    var i = 0;
    while i < 10 {
        x = (x + d / x) * 0.5;
        i = i + 1;
    }
    var sqrt_d = x;

    var t0 = (-b - sqrt_d) / 2.0;
    var t1 = (-b + sqrt_d) / 2.0;

    if t0 >= 0.0 && t0 <= ray.max_dist {
        return t0;
    }
    if t1 >= 0.0 && t1 <= ray.max_dist {
        return t1;
    }
    return -1.0;
}

// ─── Rigid Body ───────────────────────────────────────────────────────────
//
// Simple 2D rigid body with velocity, acceleration, and gravity.
// No rotation (for simplicity — 2D platformer style).

pub struct Body {
    pub x: f64,          // position x
    pub y: f64,          // position y
    pub vx: f64,         // velocity x (px/s)
    pub vy: f64,         // velocity y (px/s)
    pub ax: f64,         // acceleration x (px/s²)
    pub ay: f64,         // acceleration y (px/s²)
    pub width: f64,      // collision box width
    pub height: f64,     // collision box height
    pub mass: f64,       // mass (for collision response)
    pub restitution: f64, // bounciness (0 = no bounce, 1 = perfect bounce)
    pub grounded: bool,   // is the body on the ground?
    pub active: bool,     // is the body being simulated?
}

/// Create a new rigid body.
pub fn physics_body_create(x: f64, y: f64, width: f64, height: f64) -> Body {
    return Body {
        x: x,
        y: y,
        vx: 0.0,
        vy: 0.0,
        ax: 0.0,
        ay: 0.0,
        width: width,
        height: height,
        mass: 1.0,
        restitution: 0.0,
        grounded: false,
        active: true,
    };
}

/// Set the body's velocity.
pub fn physics_body_set_velocity(body: &mut Body, vx: f64, vy: f64) -> void {
    body.vx = vx;
    body.vy = vy;
}

/// Set the body's acceleration.
pub fn physics_body_set_acceleration(body: &mut Body, ax: f64, ay: f64) -> void {
    body.ax = ax;
    body.ay = ay;
}

/// Set the body's mass.
pub fn physics_body_set_mass(body: &mut Body, mass: f64) -> void {
    body.mass = mass;
}

/// Set the body's restitution (bounciness).
pub fn physics_body_set_restitution(body: &mut Body, r: f64) -> void {
    body.restitution = r;
}

/// Apply a force to the body (F = ma → a += F/m).
pub fn physics_body_apply_force(body: &mut Body, fx: f64, fy: f64) -> void {
    if body.mass > 0.0 {
        body.ax = body.ax + fx / body.mass;
        body.ay = body.ay + fy / body.mass;
    }
}

/// Apply an impulse (instant velocity change).
pub fn physics_body_apply_impulse(body: &mut Body, ix: f64, iy: f64) -> void {
    if body.mass > 0.0 {
        body.vx = body.vx + ix / body.mass;
        body.vy = body.vy + iy / body.mass;
    }
}

/// Update the body's physics: integrate velocity and acceleration.
/// gravity = downward acceleration (px/s²), e.g., 980.0 for Earth-like.
pub fn physics_body_update(body: &mut Body, dt: f64, gravity: f64) -> void {
    if !body.active { return; }

    // Apply gravity
    body.ay = body.ay + gravity;

    // Integrate acceleration into velocity
    body.vx = body.vx + body.ax * dt;
    body.vy = body.vy + body.ay * dt;

    // Integrate velocity into position
    body.x = body.x + body.vx * dt;
    body.y = body.y + body.vy * dt;

    // Reset acceleration (forces are per-frame)
    body.ax = 0.0;
    body.ay = 0.0;

    // Clear grounded flag (collision detection sets it)
    body.grounded = false;
}

/// Get the body's AABB.
pub fn physics_body_aabb(body: Body) -> AABB {
    return AABB {
        x: body.x,
        y: body.y,
        width: body.width,
        height: body.height,
    };
}

// ─── Collision Response ───────────────────────────────────────────────────

/// Resolve collision between two bodies using their AABBs.
/// Pushes body `a` out of body `b` and adjusts velocity.
pub fn physics_resolve_collision(a: &mut Body, b: Body) -> void {
    var aabb_a = physics_body_aabb(*a);
    var aabb_b = physics_body_aabb(b);

    if !physics_aabb_collides(aabb_a, aabb_b) {
        return;
    }

    var mtv = physics_aabb_mtv(aabb_a, aabb_b);
    var (dx, dy) = mtv;
    

    // Push body a out
    a.x = a.x + dx;
    a.y = a.y + dy;

    // Adjust velocity based on push direction
    if dx != 0.0 {
        a.vx = 0.0;
    }
    if dy != 0.0 {
        if dy < 0.0 {
            // Pushed up → landed on top of b
            a.grounded = true;
        }
        a.vy = 0.0;
    }
}

/// Resolve collision between a body and a static AABB (e.g., a tile).
/// The body is pushed out and velocity is zeroed in the push direction.
pub fn physics_resolve_vs_static(body: &mut Body, tile: AABB) -> void {
    var body_aabb = physics_body_aabb(*body);
    if !physics_aabb_collides(body_aabb, tile) {
        return;
    }

    var mtv = physics_aabb_mtv(body_aabb, tile);
    var (dx, dy) = mtv;

    // If the MTV pushes against the body's velocity, use the opposite overlap
    // (e.g., body falling down onto floor should be pushed up, not through)
    if dy > 0.0 && body.vy > 0.0 {
        // MTV says push down, but body is moving down — push up instead
        dy = -(body_aabb.y + body_aabb.height - tile.y);
    } else if dy < 0.0 && body.vy < 0.0 {
        // MTV says push up, but body is moving up — push down instead
        dy = (tile.y + tile.height - body_aabb.y);
    }
    if dx > 0.0 && body.vx > 0.0 {
        dx = -(body_aabb.x + body_aabb.width - tile.x);
    } else if dx < 0.0 && body.vx < 0.0 {
        dx = (tile.x + tile.width - body_aabb.x);
    }

    body.x = body.x + dx;
    body.y = body.y + dy;

    if dx != 0.0 {
        body.vx = 0.0;
    }
    if dy != 0.0 {
        if dy < 0.0 {
            body.grounded = true;
        }
        body.vy = 0.0;
    }
}

/// Elastic collision response between two dynamic bodies.
/// Exchanges momentum based on mass and restitution.
pub fn physics_elastic_collision(a: &mut Body, b: &mut Body) -> void {
    var aabb_a = physics_body_aabb(*a);
    var aabb_b = physics_body_aabb(*b);

    if !physics_aabb_collides(aabb_a, aabb_b) {
        return;
    }

    // Separate the bodies
    var mtv = physics_aabb_mtv(aabb_a, aabb_b);
    var (dx, dy) = mtv;
    

    // Split the push based on mass ratio
    var total_mass = a.mass + b.mass;
    if total_mass <= 0.0 { return; }

    var a_push = b.mass / total_mass;
    var b_push = a.mass / total_mass;

    a.x = a.x + dx * a_push;
    a.y = a.y + dy * a_push;
    b.x = b.x - dx * b_push;
    b.y = b.y - dy * b_push;

    // Exchange velocity along the collision normal
    if dx != 0.0 {
        var rvx = a.vx - b.vx;
        var impulse = -(1.0 + a.restitution) * rvx / (1.0 / a.mass + 1.0 / b.mass);
        a.vx = a.vx + impulse / a.mass;
        b.vx = b.vx - impulse / b.mass;
    }
    if dy != 0.0 {
        var rvy = a.vy - b.vy;
        var impulse = -(1.0 + a.restitution) * rvy / (1.0 / a.mass + 1.0 / b.mass);
        a.vy = a.vy + impulse / a.mass;
        b.vy = b.vy - impulse / b.mass;
        if dy < 0.0 {
            a.grounded = true;
        }
    }
}
