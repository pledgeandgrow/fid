// Fides randomness assessment over byte buffers: Shannon entropy, the
// most-common-value min-entropy estimate of NIST SP 800-90B §6.3.1, a
// chi-square test over the 256 byte values, the arithmetic mean and the
// serial correlation coefficient (as the `ent` tool reports them), and a
// subset of the NIST SP 800-22 statistical tests on the bit stream:
// frequency (monobit), frequency within a block, runs, longest run of
// ones in a block (M = 8, 128 or 10^4 per §2.4), and cumulative sums.
//
// Pure computation over f64, no platform seam. The special functions the
// p-values need are written here: erfc (W. J. Cody's rational
// approximations, about 1e-15 relative error), log-gamma (Stirling's series) and the
// regularized upper incomplete gamma function Q(a, x) (series and
// continued fraction, as in SP 800-22's cephes routines). Bits are taken
// most significant first from each byte, as the SP 800-22 tools read
// binary files. A p-value below 0.01 is the usual rejection threshold.
//
// These are screening tests for an entropy source or a DRBG output, not
// a proof of randomness: a cryptographic generator passes them, so do
// many bad ones.
//
// Checked against the worked examples of SP 800-22 §2.1.8, 2.2.8, 2.3.8,
// 2.4.8 and 2.13.8 and against Python's math module in
// tests/bootstrap/test_std_entropy.fd.
//
// Usage:
//   use entropy;
//   val h = entropy_shannon(bytes);                       // bits per byte, 0..8
//   val p = entropy_monobit(entropy_bits(bytes));          // p-value
//   println(entropy_fmt(p, 6));

module entropy;
use vec;
use math;

// ─── Formatting ────────────────────────────────────────────────────────

/// A non-negative-or-negative float with `digits` decimals, rounded half up.
pub fn entropy_fmt(x: f64, digits: i64) -> str {
    var scale: f64 = 1.0;
    var k: i64 = 0;
    while k < digits {
        scale = scale * 10.0;
        k = k + 1;
    }
    var neg: bool = x < 0.0;
    var a: f64 = x;
    if neg {
        a = 0.0 - x;
    }
    val n: i64 = math_floor(a * scale + 0.5) as i64;
    var ip: i64 = n;
    var fp: i64 = 0;
    var den: i64 = 1;
    k = 0;
    while k < digits {
        den = den * 10;
        k = k + 1;
    }
    ip = n / den;
    fp = n % den;
    var fs: str = int_to_str(fp);
    while str_len(fs) < digits {
        fs = "0" + fs;
    }
    var out: str = int_to_str(ip);
    if digits > 0 {
        out = out + "." + fs;
    }
    if neg && n != 0 {
        out = "-" + out;
    }
    return out;
}

// ─── Special functions ─────────────────────────────────────────────────

fn en_poly(x: f64, c: &Vec<f64>) -> f64 {
    var r: f64 = 0.0;
    var i: i64 = c.len() - 1;
    while i >= 0 {
        r = r * x + c.get(i);
        i = i - 1;
    }
    return r;
}

/// The complementary error function erfc(x) (Cody 1969).
pub fn entropy_erfc(x: f64) -> f64 {
    val ax: f64 = math_fabs(x);
    var r: f64 = 0.0;
    if ax < 0.5 {
        // erfc = 1 - erf, erf from a rational function of x^2.
        var p: Vec<f64> = Vec::new();
        p.push(3.20937758913846947e03);
        p.push(3.77485237685302021e02);
        p.push(1.13864154151050156e02);
        p.push(3.16112374387056560e00);
        p.push(1.85777706184603153e-1);
        var q: Vec<f64> = Vec::new();
        q.push(2.84423683343917062e03);
        q.push(1.28261652607737228e03);
        q.push(2.44024637934444173e02);
        q.push(2.36012909523441209e01);
        q.push(1.0);
        val z: f64 = x * x;
        return 1.0 - x * en_poly(z, &p) / en_poly(z, &q);
    }
    if ax < 4.0 {
        var p2: Vec<f64> = Vec::new();
        p2.push(1.23033935479799725e03);
        p2.push(2.05107837782607147e03);
        p2.push(1.71204761263407058e03);
        p2.push(8.81952221241769090e02);
        p2.push(2.98635138197400131e02);
        p2.push(6.61191906371416295e01);
        p2.push(8.88314979438837594e00);
        p2.push(5.64188496988670089e-1);
        p2.push(2.15311535474403846e-8);
        var q2: Vec<f64> = Vec::new();
        q2.push(1.23033935480374942e03);
        q2.push(3.43936767414372164e03);
        q2.push(4.36261909014324716e03);
        q2.push(3.29079923573345963e03);
        q2.push(1.62138957456669019e03);
        q2.push(5.37181101862009858e02);
        q2.push(1.17693950891312499e02);
        q2.push(1.57449261107098347e01);
        q2.push(1.0);
        // The last numerator coefficient belongs to x^8 in Cody's table.
        var num: f64 = p2.get(8);
        var i: i64 = 7;
        while i >= 0 {
            num = num * ax + p2.get(i);
            i = i - 1;
        }
        r = math_exp(0.0 - ax * ax) * num / en_poly(ax, &q2);
    } else {
        var p3: Vec<f64> = Vec::new();
        p3.push(-6.58749161529837803e-4);
        p3.push(-1.60837851487422766e-2);
        p3.push(-1.25781726111229246e-1);
        p3.push(-3.60344899949804439e-1);
        p3.push(-3.05326634961232344e-1);
        p3.push(-1.63153871373020978e-2);
        var q3: Vec<f64> = Vec::new();
        q3.push(2.33520497626869185e-3);
        q3.push(6.05183413124413191e-2);
        q3.push(5.27905102951428412e-1);
        q3.push(1.87295284992346725e00);
        q3.push(2.56852019228982242e00);
        q3.push(1.0);
        val z3: f64 = 1.0 / (ax * ax);
        val rr: f64 = z3 * en_poly(z3, &p3) / en_poly(z3, &q3);
        r = math_exp(0.0 - ax * ax) / ax * (0.564189583547756287 + rr);
    }
    if x < 0.0 {
        return 2.0 - r;
    }
    return r;
}

/// The standard normal distribution function.
pub fn entropy_normal_cdf(x: f64) -> f64 {
    return 0.5 * entropy_erfc(0.0 - x / math_sqrt(2.0));
}

/// ln Gamma(x) for x > 0: Stirling's series from x >= 10 (error below
/// 1e-15), shifted up by the recurrence Gamma(x + 1) = x Gamma(x) below.
pub fn entropy_lgamma(x_in: f64) -> f64 {
    var x: f64 = x_in;
    var shift: f64 = 0.0;
    while x < 10.0 {
        shift = shift + math_log(x);
        x = x + 1.0;
    }
    val z: f64 = 1.0 / (x * x);
    val series: f64 = (1.0 / x) * (1.0 / 12.0 - z * (1.0 / 360.0 - z * (1.0 / 1260.0 - z * (1.0 / 1680.0 - z / 1188.0))));
    return (x - 0.5) * math_log(x) - x + 0.9189385332046727 + series - shift;
}

/// The regularized upper incomplete gamma function Q(a, x) ("igamc").
pub fn entropy_igamc(a: f64, x: f64) -> f64 {
    if x <= 0.0 || a <= 0.0 {
        return 1.0;
    }
    val lg: f64 = entropy_lgamma(a);
    if x < a + 1.0 {
        // Series for P(a, x), then Q = 1 - P.
        var ap: f64 = a;
        var del: f64 = 1.0 / a;
        var sum: f64 = del;
        var n: i64 = 0;
        while n < 1000 {
            ap = ap + 1.0;
            del = del * x / ap;
            sum = sum + del;
            if math_fabs(del) < math_fabs(sum) * 1e-16 {
                n = 1000;
            }
            n = n + 1;
        }
        return 1.0 - sum * math_exp(0.0 - x + a * math_log(x) - lg);
    }
    // Continued fraction (modified Lentz).
    val tiny: f64 = 1e-300;
    var b: f64 = x + 1.0 - a;
    var c: f64 = 1.0 / tiny;
    var d: f64 = 1.0 / b;
    var h: f64 = d;
    var i: i64 = 1;
    while i < 1000 {
        val an: f64 = 0.0 - (i as f64) * ((i as f64) - a);
        b = b + 2.0;
        d = an * d + b;
        if math_fabs(d) < tiny {
            d = tiny;
        }
        c = b + an / c;
        if math_fabs(c) < tiny {
            c = tiny;
        }
        d = 1.0 / d;
        val del2: f64 = d * c;
        h = h * del2;
        if math_fabs(del2 - 1.0) < 1e-16 {
            i = 1000;
        }
        i = i + 1;
    }
    return math_exp(0.0 - x + a * math_log(x) - lg) * h;
}

// ─── Byte statistics ───────────────────────────────────────────────────

/// Counts of each byte value (256 entries).
pub fn entropy_histogram(data: Vec<i64>) -> Vec<i64> {
    var h: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 256 {
        h.push(0);
        i = i + 1;
    }
    i = 0;
    while i < data.len() {
        val b: i64 = data.get(i) & 255;
        h.set(b, h.get(b) + 1);
        i = i + 1;
    }
    return h;
}

fn en_log2(x: f64) -> f64 {
    return math_log(x) / 0.6931471805599453;
}

/// Shannon entropy in bits per byte (0 for empty input, 8 at most).
pub fn entropy_shannon(data: Vec<i64>) -> f64 {
    if data.len() == 0 {
        return 0.0;
    }
    val h: Vec<i64> = entropy_histogram(data);
    val n: f64 = data.len() as f64;
    var e: f64 = 0.0;
    var i: i64 = 0;
    while i < 256 {
        if h.get(i) > 0 {
            val p: f64 = (h.get(i) as f64) / n;
            e = e - p * en_log2(p);
        }
        i = i + 1;
    }
    return e;
}

/// SP 800-90B §6.3.1 most-common-value estimate: -log2 of the 99% upper
/// bound on the probability of the most common byte (bits per byte).
pub fn entropy_min_mcv(data: Vec<i64>) -> f64 {
    val l: i64 = data.len();
    if l < 2 {
        return 0.0;
    }
    val h: Vec<i64> = entropy_histogram(data);
    var top: i64 = 0;
    var i: i64 = 0;
    while i < 256 {
        if h.get(i) > top {
            top = h.get(i);
        }
        i = i + 1;
    }
    val p: f64 = (top as f64) / (l as f64);
    var pu: f64 = p + 2.576 * math_sqrt(p * (1.0 - p) / ((l - 1) as f64));
    if pu > 1.0 {
        pu = 1.0;
    }
    return 0.0 - en_log2(pu);
}

/// Chi-square statistic of the byte counts against a uniform distribution.
pub fn entropy_chi_square(data: Vec<i64>) -> f64 {
    val h: Vec<i64> = entropy_histogram(data);
    val e: f64 = (data.len() as f64) / 256.0;
    if e == 0.0 {
        return 0.0;
    }
    var chi: f64 = 0.0;
    var i: i64 = 0;
    while i < 256 {
        val d: f64 = (h.get(i) as f64) - e;
        chi = chi + d * d / e;
        i = i + 1;
    }
    return chi;
}

/// The p-value of the chi-square statistic with 255 degrees of freedom.
pub fn entropy_chi_square_p(data: Vec<i64>) -> f64 {
    return entropy_igamc(127.5, entropy_chi_square(data) / 2.0);
}

/// Arithmetic mean of the bytes (127.5 for uniform data).
pub fn entropy_mean(data: Vec<i64>) -> f64 {
    if data.len() == 0 {
        return 0.0;
    }
    var s: i64 = 0;
    var i: i64 = 0;
    while i < data.len() {
        s = s + (data.get(i) & 255);
        i = i + 1;
    }
    return (s as f64) / (data.len() as f64);
}

/// Serial correlation coefficient of successive bytes (wrapping around,
/// as `ent` computes it): near 0 for random data, 1 for a constant ramp.
pub fn entropy_serial_correlation(data: Vec<i64>) -> f64 {
    val n: i64 = data.len();
    if n < 2 {
        return 0.0;
    }
    var t1: f64 = 0.0;
    var t2: f64 = 0.0;
    var t3: f64 = 0.0;
    var i: i64 = 0;
    while i < n {
        val a: f64 = (data.get(i) & 255) as f64;
        val b: f64 = (data.get((i + 1) % n) & 255) as f64;
        t1 = t1 + a * b;
        t2 = t2 + a;
        t3 = t3 + a * a;
        i = i + 1;
    }
    val nf: f64 = n as f64;
    val den: f64 = nf * t3 - t2 * t2;
    if den == 0.0 {
        return 1.0;
    }
    return (nf * t1 - t2 * t2) / den;
}

// ─── Bit streams and SP 800-22 tests ───────────────────────────────────

/// The bits of the bytes, most significant first (0 or 1 each).
pub fn entropy_bits(data: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < data.len() {
        var k: i64 = 7;
        while k >= 0 {
            out.push((data.get(i) >> k) & 1);
            k = k - 1;
        }
        i = i + 1;
    }
    return out;
}

/// Bits from a text of '0' and '1' (other characters are skipped).
pub fn entropy_bits_from_str(s: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < str_len(s) {
        val c: i64 = str_byte_at(s, i);
        if c == 48 {
            out.push(0);
        }
        if c == 49 {
            out.push(1);
        }
        i = i + 1;
    }
    return out;
}

/// §2.1 Frequency (monobit) test: p-value.
pub fn entropy_monobit(bits: Vec<i64>) -> f64 {
    val n: i64 = bits.len();
    if n == 0 {
        return 0.0;
    }
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + 2 * bits.get(i) - 1;
        i = i + 1;
    }
    if s < 0 {
        s = 0 - s;
    }
    val sobs: f64 = (s as f64) / math_sqrt(n as f64);
    return entropy_erfc(sobs / math_sqrt(2.0));
}

/// §2.2 Frequency test within blocks of m bits: p-value.
pub fn entropy_block_frequency(bits: Vec<i64>, m: i64) -> f64 {
    val nb: i64 = bits.len() / m;
    if nb == 0 || m < 1 {
        return 0.0;
    }
    var chi: f64 = 0.0;
    var b: i64 = 0;
    while b < nb {
        var ones: i64 = 0;
        var j: i64 = 0;
        while j < m {
            ones = ones + bits.get(b * m + j);
            j = j + 1;
        }
        val pi: f64 = (ones as f64) / (m as f64);
        chi = chi + (pi - 0.5) * (pi - 0.5);
        b = b + 1;
    }
    chi = 4.0 * (m as f64) * chi;
    return entropy_igamc((nb as f64) / 2.0, chi / 2.0);
}

/// §2.3 Runs test: p-value (0 when the frequency prerequisite fails).
pub fn entropy_runs(bits: Vec<i64>) -> f64 {
    val n: i64 = bits.len();
    if n < 2 {
        return 0.0;
    }
    var ones: i64 = 0;
    var i: i64 = 0;
    while i < n {
        ones = ones + bits.get(i);
        i = i + 1;
    }
    val pi: f64 = (ones as f64) / (n as f64);
    if math_fabs(pi - 0.5) >= 2.0 / math_sqrt(n as f64) {
        return 0.0;
    }
    var v: i64 = 1;
    i = 1;
    while i < n {
        if bits.get(i) != bits.get(i - 1) {
            v = v + 1;
        }
        i = i + 1;
    }
    val nf: f64 = n as f64;
    val num: f64 = math_fabs((v as f64) - 2.0 * nf * pi * (1.0 - pi));
    val den: f64 = 2.0 * math_sqrt(2.0 * nf) * pi * (1.0 - pi);
    return entropy_erfc(num / den);
}

/// §2.4 Longest run of ones in a block: p-value. The block size follows
/// the table of §2.4.2: M = 8 (n >= 128), 128 (n >= 6272), 10^4 (n >= 750000).
pub fn entropy_longest_run(bits: Vec<i64>) -> f64 {
    val n: i64 = bits.len();
    var m: i64 = 8;
    var k: i64 = 3;
    var lo: i64 = 1;
    var pis: Vec<f64> = Vec::new();
    if n < 128 {
        return 0.0;
    }
    if n < 6272 {
        pis.push(0.2148);
        pis.push(0.3672);
        pis.push(0.2305);
        pis.push(0.1875);
    } else if n < 750000 {
        m = 128;
        k = 5;
        lo = 4;
        pis.push(0.1174);
        pis.push(0.2430);
        pis.push(0.2493);
        pis.push(0.1752);
        pis.push(0.1027);
        pis.push(0.1124);
    } else {
        m = 10000;
        k = 6;
        lo = 10;
        pis.push(0.0882);
        pis.push(0.2092);
        pis.push(0.2483);
        pis.push(0.1933);
        pis.push(0.1208);
        pis.push(0.0675);
        pis.push(0.0727);
    }
    val nb: i64 = n / m;
    var nu: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i <= k {
        nu.push(0);
        i = i + 1;
    }
    var b: i64 = 0;
    while b < nb {
        var run: i64 = 0;
        var best: i64 = 0;
        var j: i64 = 0;
        while j < m {
            if bits.get(b * m + j) == 1 {
                run = run + 1;
                if run > best {
                    best = run;
                }
            } else {
                run = 0;
            }
            j = j + 1;
        }
        var cls: i64 = best - lo;
        if cls < 0 {
            cls = 0;
        }
        if cls > k {
            cls = k;
        }
        nu.set(cls, nu.get(cls) + 1);
        b = b + 1;
    }
    var chi: f64 = 0.0;
    i = 0;
    while i <= k {
        val e: f64 = (nb as f64) * pis.get(i);
        val d: f64 = (nu.get(i) as f64) - e;
        chi = chi + d * d / e;
        i = i + 1;
    }
    return entropy_igamc((k as f64) / 2.0, chi / 2.0);
}

/// §2.13 Cumulative sums test, forward (reverse = false) or backward:
/// p-value.
pub fn entropy_cusum(bits: Vec<i64>, reverse: bool) -> f64 {
    val n: i64 = bits.len();
    if n == 0 {
        return 0.0;
    }
    var s: i64 = 0;
    var z: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var b: i64 = bits.get(i);
        if reverse {
            b = bits.get(n - 1 - i);
        }
        s = s + 2 * b - 1;
        var a: i64 = s;
        if a < 0 {
            a = 0 - a;
        }
        if a > z {
            z = a;
        }
        i = i + 1;
    }
    if z == 0 {
        return 0.0;
    }
    val sn: f64 = math_sqrt(n as f64);
    val zf: f64 = z as f64;
    var sum1: f64 = 0.0;
    var k: i64 = (0 - n / z + 1) / 4;
    while k <= (n / z - 1) / 4 {
        sum1 = sum1 + entropy_normal_cdf(((4 * k + 1) as f64) * zf / sn);
        sum1 = sum1 - entropy_normal_cdf(((4 * k - 1) as f64) * zf / sn);
        k = k + 1;
    }
    var sum2: f64 = 0.0;
    k = (0 - n / z - 3) / 4;
    while k <= (n / z - 1) / 4 {
        sum2 = sum2 + entropy_normal_cdf(((4 * k + 3) as f64) * zf / sn);
        sum2 = sum2 - entropy_normal_cdf(((4 * k + 1) as f64) * zf / sn);
        k = k + 1;
    }
    return 1.0 - sum1 + sum2;
}

/// A one-line summary of a buffer: entropy, min-entropy, chi-square
/// p-value, monobit and runs p-values (6 decimals each).
pub fn entropy_report(data: Vec<i64>) -> str {
    val bits: Vec<i64> = entropy_bits(data);
    return "shannon=" + entropy_fmt(entropy_shannon(data), 6) + " min=" + entropy_fmt(entropy_min_mcv(data), 6) + " chi2_p=" + entropy_fmt(entropy_chi_square_p(data), 6) + " monobit_p=" + entropy_fmt(entropy_monobit(bits), 6) + " runs_p=" + entropy_fmt(entropy_runs(bits), 6);
}
