fn hp_build_canon() {
    var l: i64 = 0;
    while l <= 30 {
        hp_first.push(-1);
        hp_count.push(0);
        hp_start.push(0);
        l = l + 1;
    }
    var sym: i64 = 0;
    while sym < 257 {
        val len: i64 = hp_huff_len.get(sym);
        val code: i64 = hp_huff_code.get(sym);
        hp_count.set(len, hp_count.get(len) + 1);
        if hp_first.get(len) < 0 || code < hp_first.get(len) {
            hp_first.set(len, code);
        }
        hp_sorted.push(0);
        sym = sym + 1;
    }
    var at: i64 = 0;
    l = 0;
    while l <= 30 {
        hp_start.set(l, at);
        at = at + hp_count.get(l);
        l = l + 1;
    }
    sym = 0;
    while sym < 257 {
        val len: i64 = hp_huff_len.get(sym);
        hp_sorted.set(hp_start.get(len) + hp_huff_code.get(sym) - hp_first.get(len), sym);
        sym = sym + 1;
    }
}

/// The Huffman code of a symbol (0..255, 256 = EOS), right-aligned.
pub fn huffman_code(sym: i64) -> i64 {
    hp_init();
    return hp_huff_code.get(sym);
}

/// The length in bits of a symbol's Huffman code.
pub fn huffman_code_len(sym: i64) -> i64 {
    hp_init();
    return hp_huff_len.get(sym);
}

/// Name of static entry `i` (1..61).
pub fn hpack_static_name(i: i64) -> str {
    hp_init();
    return hp_st_names.get(i - 1);
}

/// Value of static entry `i` (1..61).
pub fn hpack_static_value(i: i64) -> str {
    hp_init();
    return hp_st_vals.get(i - 1);
}

// ─── Huffman (5.2, Appendix B) ────────────────────────────────────────────

/// Bytes the Huffman coding of `bytes` takes.
pub fn huffman_encoded_len(bytes: Vec<i64>) -> i64 {
    hp_init();
    var bits: i64 = 0;
    var i: i64 = 0;
    while i < bytes.len() {
        bits = bits + hp_huff_len.get(bytes.get(i) & 255);
        i = i + 1;
    }
    return (bits + 7) / 8;
}

/// Huffman-code `bytes`; the last byte is padded with the high bits of EOS
/// (ones).
pub fn huffman_encode(bytes: Vec<i64>) -> Vec<i64> {
    hp_init();
    var out: Vec<i64> = Vec::new();
    var acc: i64 = 0;
    // pending bits, the low `nbits` of it
    var nbits: i64 = 0;
    var i: i64 = 0;
    while i < bytes.len() {
        val b: i64 = bytes.get(i) & 255;
        val len: i64 = hp_huff_len.get(b);
        acc = (acc << len) | hp_huff_code.get(b);
        nbits = nbits + len;
        while nbits >= 8 {
            out.push((acc >> (nbits - 8)) & 255);
            nbits = nbits - 8;
        }
        acc = acc & ((1 << nbits) - 1);
        i = i + 1;
    }
    if nbits > 0 {
        val pad: i64 = 8 - nbits;
        out.push(((acc << pad) | ((1 << pad) - 1)) & 255);
    }
    return out;
}

/// Decode `n` Huffman-coded bytes of `b` from `from` into `out`. False when
/// the input holds EOS, is padded with more than 7 bits, or with bits that
/// are not the start of EOS (RFC 7541 5.2): a decoding error.
pub fn huffman_decode_into(b: Vec<i64>, from: i64, n: i64, out: &mut Vec<i64>) -> bool {
    hp_init();
    var code: i64 = 0;
    // bits since the last symbol
    var len: i64 = 0;
    // how many
    var i: i64 = from;
    while i < from + n {
        val byte: i64 = b.get(i);
        var bit: i64 = 7;
        while bit >= 0 {
            code = (code << 1) | ((byte >> bit) & 1);
            len = len + 1;
            if len > 30 {
                return false;
            }
            val cnt: i64 = hp_count.get(len);
            if cnt > 0 {
                val off: i64 = code - hp_first.get(len);
                if off >= 0 && off < cnt {
                    val sym: i64 = hp_sorted.get(hp_start.get(len) + off);
                    if sym == 256 {
                        return false;
                    }
                    out.push(sym);
                    code = 0;
                    len = 0;
                }
            }
            bit = bit - 1;
        }
        i = i + 1;
    }
    // Padding: at most 7 bits, all ones (the start of EOS)
    return len <= 7 && code == (1 << len) - 1;
}

/// Decode a whole Huffman-coded string; Option::None on a decoding error.
pub fn huffman_decode(b: Vec<i64>) -> Option<Vec<i64>> {
    var out: Vec<i64> = Vec::new();
    if huffman_decode_into(b, 0, b.len(), &mut out) {
        return Option::Some(out);
    }
    return Option::None;
}

// ─── Integers (5.1) and string literals (5.2) ─────────────────────────────

/// Append `value` as an integer with an N-bit prefix (`prefix` 1..8); `first`
/// holds the bits above the prefix in the first byte (the representation's
/// pattern, such as 0x80 for an indexed field).
pub fn hpack_put_int(out: &mut Vec<i64>, first: i64, prefix: i64, value: i64) {
    val max: i64 = (1 << prefix) - 1;
    if value < max {
        out.push(first | value);
        return;
    }
    out.push(first | max);
    var v: i64 = value - max;
    while v >= 128 {
        out.push((v % 128) + 128);
        v = v / 128;
    }
    out.push(v);
}

/// Read an integer with an N-bit prefix at `*pos`, moving `*pos` past it.
/// -1 (and `*pos` -1) when the input ends first or the value is too large.
pub fn hpack_get_int(b: Vec<i64>, pos: &mut i64, prefix: i64) -> i64 {
    val at: i64 = *pos;
    if at < 0 || at >= b.len() {
        *pos = -1;
        return -1;
    }
    val max: i64 = (1 << prefix) - 1;
    var v: i64 = b.get(at) & max;
    var p: i64 = at + 1;
    if v == max {
        var shift: i64 = 0;
        var more: bool = true;
        while more {
            if p >= b.len() || shift > 28 {
                *pos = -1;
                return -1;
            }
            val c: i64 = b.get(p);
            p = p + 1;
            v = v + ((c & 127) << shift);
            shift = shift + 7;
            more = (c & 128) != 0;
        }
        if v > HP_INT_MAX {
            *pos = -1;
            return -1;
        }
    }
    * pos = p;
    return v;
}

/// Append a string literal: Huffman-coded when `huffman` and that is not
/// longer, raw otherwise.
pub fn hpack_put_str(out: &mut Vec<i64>, s: str, huffman: bool) {
    val bytes: Vec<i64> = str_bytes(s);
    if huffman && huffman_encoded_len(bytes) <= bytes.len() {
        val coded: Vec<i64> = huffman_encode(bytes);
        hpack_put_int(out, 128, 7, coded.len());
        var i: i64 = 0;
        while i < coded.len() {
            out.push(coded.get(i));
            i = i + 1;
        }
        return;
    }
    hpack_put_int(out, 0, 7, bytes.len());
    var j: i64 = 0;
    while j < bytes.len() {
        out.push(bytes.get(j));
        j = j + 1;
    }
}

/// Read a string literal at `*pos`. On an error `*pos` becomes -1.
pub fn hpack_get_str(b: Vec<i64>, pos: &mut i64) -> str {
    if *pos < 0 || *pos >= b.len() {
        *pos = -1;
        return "";
    }
    val huff: bool = (b.get(*pos) & 128) != 0;
    val n: i64 = hpack_get_int(b, pos, 7);
    if n < 0 {
        return "";
    }
    val at: i64 = *pos;
    if at + n > b.len() {
        *pos = -1;
        return "";
    }
    var bytes: Vec<i64> = Vec::new();
    if huff {
        if !huffman_decode_into(b, at, n, &mut bytes) {
            *pos = -1;
            return "";
        }
    } else {
        var i: i64 = 0;
        while i < n {
            bytes.push(b.get(at + i));
            i = i + 1;
        }
    }
    * pos = at + n;
    return str_from_bytes(bytes);
}

// ─── Dynamic table (2.3.2, 4) ─────────────────────────────────────────────

/// The size an entry takes in the table (4.1).
pub fn hpack_entry_size(name: str, value: str) -> i64 {
    return str_len(name) + str_len(value) + 32;
}

/// Number of entries in the dynamic table.
pub fn hpack_table_len(h: &Hpack) -> i64 {
    return h.names.len();
}

// Evict the oldest entries until `room` more bytes fit (4.4).
fn hp_evict(h: &mut Hpack, room: i64) {
    while h.names.len() > 0 && h.size + room > h.max_size {
        val n: str = h.names.pop();
        val v: str = h.vals.pop();
        h.size = h.size - hpack_entry_size(n, v);
    }
}

/// Add an entry, evicting as needed. One bigger than the whole table
/// leaves it empty (4.4).
pub fn hpack_table_add(h: &mut Hpack, name: str, value: str) {
    val esz: i64 = hpack_entry_size(name, value);
    if esz > h.max_size {
        h.names.clear();
        h.vals.clear();
        h.size = 0;
        return;
    }
    hp_evict(h, esz);
    h.names.insert(0, name);
    h.vals.insert(0, value);
    h.size = h.size + esz;
}

/// Change the table's maximum size, evicting what no longer fits (4.3).
pub fn hpack_table_resize(h: &mut Hpack, max_size: i64) {
    h.max_size = max_size;
    hp_evict(h, 0);
}

/// Is `i` an index of the static or dynamic table?
pub fn hpack_index_valid(h: &Hpack, i: i64) -> bool {
    return i >= 1 && i <= HPACK_STATIC_LEN + h.names.len();
}

/// Name at index `i` of the combined index space (2.3.3).
pub fn hpack_name_at(h: &Hpack, i: i64) -> str {
    if i <= HPACK_STATIC_LEN {
        return hpack_static_name(i);
    }
    return h.names.get(i - HPACK_STATIC_LEN - 1);
}

/// Value at index `i` of the combined index space.
pub fn hpack_value_at(h: &Hpack, i: i64) -> str {
    if i <= HPACK_STATIC_LEN {
        return hpack_static_value(i);
    }
    return h.vals.get(i - HPACK_STATIC_LEN - 1);
}

/// The dynamic table as RFC 7541 Appendix C prints it.
pub fn hpack_table_dump(h: &Hpack) -> str {
    var out: str = "";
    if h.names.len() == 0 {
        out = "  empty.\n";
    }
    var i: i64 = 0;
    while i < h.names.len() {
        val n: str = h.names.get(i);
        val v: str = h.vals.get(i);
        out = out + "[" + str_pad_left(int_to_str(i + 1), 3, 32) + "] (s = " + str_pad_left(int_to_str(hpack_entry_size(n, v)), 3, 32) + ") " + n + ": " + v + "\n";
        i = i + 1;
    }
    return out + "      Table size: " + str_pad_left(int_to_str(h.size), 3, 32) + "\n";
}

// ─── Decoding (3, 6) ──────────────────────────────────────────────────────

fn hp_fail(r: HpackHeaders, why: str) -> HpackHeaders {
    return HpackHeaders {
        ok: false, error: why, names: r.names, vals: r.vals, never: r.never, too_large: r.too_large
    };
}

/// Decode a header block, updating the dynamic table. A header list
/// larger than HPACK_MAX_HEADER_LIST is an error ("header list too
/// large"); use hpack_decode_limit to set the limit and keep the
/// connection.
pub fn hpack_decode(h: &mut Hpack, block: Vec<i64>) -> HpackHeaders {
    val r: HpackHeaders = hpack_decode_limit(h, block, HPACK_MAX_HEADER_LIST);
    if r.ok && r.too_large {
        return hp_fail(r, "header list too large");
    }
    return r;
}

/// The list size of one field (RFC 9113 §6.5.2).
fn hp_field_size(name: str, value: str) -> i64 {
    return str_len(name) + str_len(value) + 32;
}

/// Decode a header block with a limit on the header list size (RFC 9113
/// §6.5.2: each field's name and value lengths plus 32; our
/// SETTINGS_MAX_HEADER_LIST_SIZE). The whole block is still decoded, so
/// the dynamic table stays in step with the peer's encoder (RFC 9113
/// §10.5.1), but once the list passes `max_list` no field is copied out
/// any more: `too_large` is set and names/vals come back empty. The work
/// and memory are bounded by the block's length and the table size, not
/// by how often the block refers to a large entry.
pub fn hpack_decode_limit(h: &mut Hpack, block: Vec<i64>, max_list: i64) -> HpackHeaders {
    hp_init();
    var r: HpackHeaders = HpackHeaders {
        ok: true, error: "", names: Vec::new(), vals: Vec::new(), never: Vec::new(), too_large: false,
    };
    var pos: i64 = 0;
    var fields: i64 = 0;
    var list: i64 = 0;
    while pos < block.len() {
        val b: i64 = block.get(pos);
        if (b & 128) != 0 {
            // Indexed field (6.1)
            val idx: i64 = hpack_get_int(block, &mut pos, 7);
            if pos < 0 || idx == 0 || !hpack_index_valid(h, idx) {
                return hp_fail(r, "bad index");
            }
            if !r.too_large {
                val iname: str = hpack_name_at(h, idx);
                val ivalue: str = hpack_value_at(h, idx);
                list = list + hp_field_size(iname, ivalue);
                if list > max_list {
                    r.too_large = true;
                    r.names = Vec::new();
                    r.vals = Vec::new();
                    r.never = Vec::new();
                } else {
                    r.names.push(iname);
                    r.vals.push(ivalue);
                    r.never.push(false);
                }
            }
            fields = fields + 1;
        } else if (b & 224) == 32 {
            // Dynamic table size update (6.3): only before the first field
            val size: i64 = hpack_get_int(block, &mut pos, 5);
            if pos < 0 {
                return hp_fail(r, "truncated size update");
            }
            if fields > 0 {
                return hp_fail(r, "size update after a field");
            }
            if size > h.limit {
                return hp_fail(r, "size update above the limit");
            }
            hpack_table_resize(h, size);
        } else {
            // Literal (6.2): with incremental indexing (01), without (0000),
            // never indexed (0001)
            var prefix: i64 = 4;
            var mode: i64 = HPACK_NO_INDEX;
            if (b & 192) == 64 {
                prefix = 6;
                mode = HPACK_INDEX;
            } else if (b & 240) == 16 {
                mode = HPACK_NEVER_INDEX;
            }
            val idx: i64 = hpack_get_int(block, &mut pos, prefix);
            if pos < 0 {
                return hp_fail(r, "truncated literal");
            }
            var name: str = "";
            if idx == 0 {
                name = hpack_get_str(block, &mut pos);
            } else {
                if !hpack_index_valid(h, idx) {
                    return hp_fail(r, "bad name index");
                }
                name = hpack_name_at(h, idx);
            }
            if pos < 0 {
                return hp_fail(r, "bad name literal");
            }
            val value: str = hpack_get_str(block, &mut pos);
            if pos < 0 {
                return hp_fail(r, "bad value literal");
            }
            if mode == HPACK_INDEX {
                hpack_table_add(h, name, value);
            }
            if !r.too_large {
                list = list + hp_field_size(name, value);
                if list > max_list {
                    r.too_large = true;
                    r.names = Vec::new();
                    r.vals = Vec::new();
                    r.never = Vec::new();
                } else {
                    r.names.push(name);
                    r.vals.push(value);
                    r.never.push(mode == HPACK_NEVER_INDEX);
                }
            }
            fields = fields + 1;
        }
    }
    return r;
}

// ─── Encoding (6) ─────────────────────────────────────────────────────────

/// Encoder: change the table's maximum size (to at most the peer's
/// SETTINGS_HEADER_TABLE_SIZE). The change is announced at the start of the
/// next header block; when it went down and then up again, both (4.2).
pub fn hpack_set_max_size(h: &mut Hpack, max_size: i64) {
    hpack_table_resize(h, max_size);
    if h.update_min < 0 || max_size < h.update_min {
        h.update_min = max_size;
    }
    h.update = max_size;
}

/// Append the pending size updates, if any. hpack_encode calls it; a caller
/// that writes fields one by one calls it before the first.
pub fn hpack_put_size_updates(h: &mut Hpack, out: &mut Vec<i64>) {
    if h.update < 0 {
        return;
    }
    if h.update_min < h.update {
        hpack_put_int(out, 32, 5, h.update_min);
    }
    hpack_put_int(out, 32, 5, h.update);
    h.update = -1;
    h.update_min = -1;
}

// The index of an entry with this name and value (0: none): the static
// table first, then the dynamic one.
fn hp_find_full(h: &Hpack, name: str, value: str) -> i64 {
    var i: i64 = 0;
    while i < HPACK_STATIC_LEN {
        if hp_st_names.get(i) == name && hp_st_vals.get(i) == value {
            return i + 1;
        }
        i = i + 1;
    }
    var j: i64 = 0;
    while j < h.names.len() {
        if h.names.get(j) == name && h.vals.get(j) == value {
            return HPACK_STATIC_LEN + j + 1;
        }
        j = j + 1;
    }
    return 0;
}

// The index of an entry with this name (0: none), static table first.
fn hp_find_name(h: &Hpack, name: str) -> i64 {
    var i: i64 = 0;
    while i < HPACK_STATIC_LEN {
        if hp_st_names.get(i) == name {
            return i + 1;
        }
        i = i + 1;
    }
    var j: i64 = 0;
    while j < h.names.len() {
        if h.names.get(j) == name {
            return HPACK_STATIC_LEN + j + 1;
        }
        j = j + 1;
    }
    return 0;
}

/// Append one field. With HPACK_INDEX a field already in a table is sent
/// as its index; otherwise as a literal of that kind, its name indexed when
/// a table has it. HPACK_NEVER_INDEX is for values such as passwords that
/// no intermediary may index.
pub fn hpack_encode_field(h: &mut Hpack, out: &mut Vec<i64>, name: str, value: str, mode: i64) {
    hp_init();
    if mode == HPACK_INDEX {
        val full: i64 = hp_find_full(h, name, value);
        if full > 0 {
            hpack_put_int(out, 128, 7, full);
            return;
        }
    }
    val ni: i64 = hp_find_name(h, name);
    if mode == HPACK_INDEX {
        hpack_put_int(out, 64, 6, ni);
    } else if mode == HPACK_NEVER_INDEX {
        hpack_put_int(out, 16, 4, ni);
    } else {
        hpack_put_int(out, 0, 4, ni);
    }
    if ni == 0 {
        hpack_put_str(out, name, h.huffman);
    }
    hpack_put_str(out, value, h.huffman);
    if mode == HPACK_INDEX {
        hpack_table_add(h, name, value);
    }
}

/// The representation hpack_encode picks for a field: never indexed for
/// credentials, without indexing for entries too big for the table, with
/// incremental indexing otherwise.
pub fn hpack_default_mode(h: &Hpack, name: str, value: str) -> i64 {
    if name == "authorization" || name == "proxy-authorization" {
        return HPACK_NEVER_INDEX;
    }
    if hpack_entry_size(name, value) > h.max_size {
        return HPACK_NO_INDEX;
    }
    return HPACK_INDEX;
}

/// Encode a header list (names must be lowercase in HTTP/2).
pub fn hpack_encode(h: &mut Hpack, names: Vec<str>, vals: Vec<str>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    hpack_put_size_updates(h, &mut out);
    var i: i64 = 0;
    while i < names.len() {
        val n: str = names.get(i);
        val v: str = vals.get(i);
        hpack_encode_field(h, &mut out, n, v, hpack_default_mode(h, n, v));
        i = i + 1;
    }
    return out;
}
