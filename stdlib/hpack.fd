    // 16
    hp_st("accept-language", "");
    // 17
    hp_st("accept-ranges", "");
    // 18
    hp_st("accept", "");
    // 19
    hp_st("access-control-allow-origin", "");
    // 20
    hp_st("age", "");
    // 21
    hp_st("allow", "");
