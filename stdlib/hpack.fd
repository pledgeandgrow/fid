// Fides HPACK standard library
//
// RFC 7541 header compression for HTTP/2 (module `http2`): the static
// table (Appendix A), the dynamic table with size updates and eviction
// (section 4), integers with an N-bit prefix (5.1), string literals (5.2),
// and the Huffman code of Appendix B for both decoding and encoding.
//
// Bytes are Vec<i64>, one value 0..255 each (as module `ws` does). A header
// list is two parallel Vec<str>, names and values, as HttpRequest has them.
//
// Usage:
//   use hpack;
//   var enc: Hpack = hpack_new(4096);
//   var dec: Hpack = hpack_new(4096);
//   val block: Vec<i64> = hpack_encode(&mut enc, names, vals);
//   val got: HpackHeaders = hpack_decode(&mut dec, block);
//   if got.ok { println(got.names.get(0) + ": " + got.vals.get(0)); }
//
// The encoder and the decoder of one direction of a connection each keep
// their own Hpack: the dynamic table is state that both ends must update in
// the same order.

module hpack;
use vec;
use string;
/// How a literal field is represented (RFC 7541 6.2).
pub const HPACK_INDEX: i64 = 0;  // literal with incremental indexing
pub const HPACK_NO_INDEX: i64 = 1;  // literal without indexing
pub const HPACK_NEVER_INDEX: i64 = 2;  // literal never indexed

/// The static table has 61 entries (Appendix A); dynamic entries follow.
pub const HPACK_STATIC_LEN: i64 = 61;

/// The header list size hpack_decode allows (RFC 9113 §6.5.2: each
/// field's name and value lengths plus 32): a larger list is an error, so
/// a block of one-byte references to a large table entry (an HPACK bomb)
/// cannot make the decoder copy more than this.
pub const HPACK_MAX_HEADER_LIST: i64 = 1048576;
/// The largest integer a decoder accepts (bigger ones are an error: no
/// table, string or size in HTTP/2 comes near it).
const HP_INT_MAX: i64 = 2147483647;
/// Encoder or decoder state of one direction: the dynamic table.
pub struct Hpack {
    pub names: Vec<str>,
    // dynamic table, newest first (index 62)
    pub vals: Vec<str>,
    pub size: i64,
    // sum of entry sizes (name + value + 32)
    pub max_size: i64,
    // the table's current maximum size
    pub limit: i64,
    // decoder: the largest size update allowed
    // (our SETTINGS_HEADER_TABLE_SIZE)
    pub update: i64,
    // encoder: size to announce in the next block, -1: none
    pub update_min: i64,
    // encoder: smallest size set since the last block
    pub huffman: bool,  // encoder: Huffman-code a string when it is shorter
}

/// A decoded header block. `ok` false: `error` says why (a COMPRESSION_ERROR).
pub struct HpackHeaders {
    pub ok: bool,
    pub error: str,
    pub names: Vec<str>,
    pub vals: Vec<str>,
    pub never: Vec<bool>,  // field was "never indexed" (6.2.3)
    pub too_large: bool,  // hpack_decode_limit: the list passed its limit
}

/// Encoder and decoder state with a dynamic table of `max_size` bytes
/// (4096 is the HTTP/2 default). The encoder Huffman-codes strings.
pub fn hpack_new(max_size: i64) -> Hpack {
    return Hpack {
        names: Vec::new(), vals: Vec::new(), size: 0, max_size: max_size, limit: max_size, update: -1, update_min: -1, huffman: true,
    };
}

// ─── Static table (Appendix A) and Huffman code (Appendix B) ──────────────

var hp_st_names: Vec<str> = Vec::new();
var hp_st_vals: Vec<str> = Vec::new();
var hp_huff_code: Vec<i64> = Vec::new();
var hp_huff_len: Vec<i64> = Vec::new();  // Decoding: the code is canonical (codes of one length are consecutive,
// in symbol order, after those of shorter lengths), so per length L the
// codes are hp_first[L] .. hp_first[L] + hp_count[L] - 1, and the symbols
// in code order start at hp_sorted[hp_start[L]].
var hp_first: Vec<i64> = Vec::new();
var hp_count: Vec<i64> = Vec::new();
var hp_start: Vec<i64> = Vec::new();
var hp_sorted: Vec<i64> = Vec::new();
fn hp_st(name: str, value: str) {
    hp_st_names.push(name);
    hp_st_vals.push(value);
}

fn hp_hc(code: i64, len: i64) {
    hp_huff_code.push(code);
    hp_huff_len.push(len);
}

fn hp_init() {
    if hp_st_names.len() > 0 {
        return;
    }
    hp_init_static();
    hp_init_huffman();
    hp_build_canon();
}

fn hp_init_static() {
    hp_st(":authority", "");
    // 1
    hp_st(":method", "GET");
    // 2
    hp_st(":method", "POST");
    // 3
    hp_st(":path", "/");
    // 4
    hp_st(":path", "/index.html");
    // 5
    hp_st(":scheme", "http");
    // 6
    hp_st(":scheme", "https");
    // 7
    hp_st(":status", "200");
    // 8
    hp_st(":status", "204");
