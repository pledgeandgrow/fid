// Fides DNS standard library
//
// DNS client built on the wire format (RFC 1035) over UDP — no libc
// resolver needed. Builds real query packets, sends them to a
// recursive resolver, and parses A/AAAA/CNAME answers.
//
// Works anywhere net.fd UDP works. The caller supplies the resolver
// IP (defaults to well-known public resolvers) because the runtime
// has no /etc/resolv.conf parser yet.
//
// Usage:
//   use dns;
//   println(dns_resolve("example.com"));              // via 1.1.1.1
//   println(dns_resolve_via("example.com", "8.8.8.8"));
//   val ips = dns_resolve_all("example.com");

module dns;
use vec;
use string;
use net;
// ─── Packet construction ────────────────────────────────────────────────

// BG147 (Nov 24): a fresh random query ID per query, from the operating
// system's random source (was the constant 24817: any reply carrying it
// was taken as the answer, so a spoofed one needed no guessing).
fn dns_qid() -> i64 {
    return p_os_random_u64() & 65535;
}

/// Build a DNS query packet for `hostname` (A record by default), with a
/// random query ID (bytes 0 and 1 of the packet).
/// qtype: 1=A, 28=AAAA, 5=CNAME, 15=MX, 16=TXT.
/// Returns a Vec<i64> of bytes; empty when `hostname` is not a valid name.
pub fn dns_build_query(hostname: str, qtype: i64) -> Vec {
    return dns_build_query_id(hostname, qtype, dns_qid());
}

/// `hostname` as the reply names it: lower case, without the trailing dot
/// of a fully qualified name.
fn dns_norm_name(hostname: str) -> str {
    var name: str = hostname;
    if str_ends_with(name, ".") {
        name = str_slice(name, 0, str_len(name) - 1);
    }
    return str_to_lower(name);
}

/// dns_build_query with the query ID `id` (0..65535) given. BG221 (Nov 24):
/// a fully qualified name's trailing dot ends the name (it was sent as an
/// empty label, which ended the name early and shifted QTYPE/QCLASS); an
/// empty label, a label over 63 bytes or a name over 253 bytes gives an
/// empty Vec (a long label was cut to 63 bytes: another name was asked).
pub fn dns_build_query_id(hostname: str, qtype: i64, id: i64) -> Vec {
    var q: Vec = Vec::new();
    var name: str = hostname;
    if str_ends_with(name, ".") {
        name = str_slice(name, 0, str_len(name) - 1);
    }
    if str_len(name) == 0 || str_len(name) > 253 {
        return q;
    }
    var labels: Vec = str_split(name, ".");
    var li: i64 = 0;
    while li < labels.len() {
        var ll: i64 = str_len(labels.get(li));
        if ll == 0 || ll > 63 {
            return q;
        }
        li = li + 1;
    }
    q.push((id >> 8) & 255);
    q.push(id & 255);
    // ID
    q.push(1);
    q.push(0);
    // flags: RD
    q.push(0);
    q.push(1);
    // QDCOUNT=1
    q.push(0);
    q.push(0);
    // ANCOUNT
    q.push(0);
    q.push(0);
    // NSCOUNT
    q.push(0);
    q.push(0);
    // ARCOUNT
    // QNAME: labels (checked above: 1..63 bytes each)
    var i: i64 = 0;
    while i < labels.len() {
        var lab: str = labels.get(i);
        q.push(str_len(lab));
        var k: i64 = 0;
        while k < str_len(lab) {
            q.push(str_byte_at(lab, k));
            k = k + 1;
        }
        i = i + 1;
    }
    q.push(0);
    // root label
    q.push((qtype >> 8) & 255);
    q.push(qtype & 255);
    // QTYPE
    q.push(0);
    q.push(1);
    // QCLASS=IN
    return q;
}

// ─── Response parsing ───────────────────────────────────────────────────

fn rd_u16(buf: i64, off: i64) -> i64 {
    return (p_volatile_load8(buf + off) << 8) | p_volatile_load8(buf + off + 1);
}

fn rd_u32(buf: i64, off: i64) -> i64 {
    return (rd_u16(buf, off) << 16) | rd_u16(buf, off + 2);
}

// Skip a DNS name (handles 0xC0 compression pointers). Returns offset
// after the name, or -1 when it runs past `end` (a truncated or hostile
// packet: nothing past the buffer is read).
fn dns_skip_name_in(buf: i64, off: i64, end: i64) -> i64 {
    var i: i64 = off;
    while i < end {
        var len: i64 = p_volatile_load8(buf + i);
        if len == 0 {
            return i + 1;
        }
        if (len & 192) == 192 {
            // pointer
            if i + 2 > end {
                return -1;
            }
            return i + 2;
        }
        i = i + len + 1;
    }
    return -1;
}

fn dns_skip_name(buf: i64, off: i64) -> i64 {
    return dns_skip_name_in(buf, off, off + 4096);
}

fn dns_parse_u32_addr(buf: i64, off: i64) -> str {
    return int_to_str(p_volatile_load8(buf + off)) + "." + int_to_str(p_volatile_load8(buf + off + 1)) + "." + int_to_str(p_volatile_load8(buf + off + 2)) + "." + int_to_str(p_volatile_load8(buf + off + 3));
}

fn dns_parse_v6_addr(buf: i64, off: i64) -> str {
    var groups: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 16 {
        groups.push(rd_u16(buf, off + i));
        i = i + 2;
    }
    return dns_v6_text(groups);
}

/// An IPv6 address as text (RFC 5952): lowercase hex groups without
/// leading zeros, the longest run of two or more zero groups as "::".
pub fn dns_v6_text(groups: Vec<i64>) -> str {
    var best: i64 = -1;
    var best_len: i64 = 0;
    var i: i64 = 0;
    while i < groups.len() {
        if groups.get(i) == 0 {
            var j: i64 = i;
            while j < groups.len() && groups.get(j) == 0 {
                j = j + 1;
            }
            if j - i > best_len && j - i >= 2 {
                best = i;
                best_len = j - i;
            }
            i = j;
        } else {
            i = i + 1;
        }
    }
    var out: str = "";
    i = 0;
    while i < groups.len() {
        if i == best {
            out = out + "::";
            i = i + best_len;
            continue;
        }
        if str_len(out) > 0 && !str_ends_with(out, ":") {
            out = out + ":";
        }
        out = out + str_to_lower(int_to_hex(groups.get(i)));
        i = i + 1;
    }
    return out;
}

/// Parse a raw DNS response (malloc'd bytes, `len` long) and return the
/// resolved IPs as Vec<str>. qtype 1 → dotted-quad, 28 → hex groups.
pub fn dns_parse_response(buf: i64, len: i64) -> Vec<str> {
    var ips: Vec<str> = Vec::new();
    var recs: Vec<DnsRecord> = dns_parse_records(buf, len);
    var i: i64 = 0;
    while i < recs.len() {
        ips.push(recs.get(i).addr);
        i = i + 1;
    }
    return ips;
}

/// One answer of a response: its type (1 A, 28 AAAA), time to live in
/// seconds, and address as text.
pub struct DnsRecord {
    pub rtype: i64,
    pub ttl: i64,
    pub addr: str,
}

/// The name at `off` of the `len`-byte packet at `buf` as text: labels
/// joined by ".", ASCII letters in lower case, compression pointers
/// followed (at most 16). "" when it is malformed: a read past `len`, a
/// pointer loop, a reserved label type, a label holding a "." or NUL byte,
/// or more than 255 bytes (and for the root name, which no query asks).
fn dns_read_name(buf: i64, off: i64, len: i64) -> str {
    var bytes: Vec<i64> = Vec::new();
    var i: i64 = off;
    var hops: i64 = 0;
    var total: i64 = 0;
    while true {
        if i < 0 || i >= len {
            return "";
        }
        var l: i64 = p_volatile_load8(buf + i);
        if l == 0 {
            break;
        }
        if (l & 192) == 192 {
            if i + 1 >= len || hops >= 16 {
                return "";
            }
            hops = hops + 1;
            i = ((l & 63) << 8) | p_volatile_load8(buf + i + 1);
            continue;
        }
        if (l & 192) != 0 || i + 1 + l > len {
            return "";
        }
        total = total + l + 1;
        if total > 255 {
            return "";
        }
        if bytes.len() > 0 {
            bytes.push(46);
        }
        var k: i64 = 0;
        while k < l {
            var c: i64 = p_volatile_load8(buf + i + 1 + k);
            if c == 46 || c == 0 {
                return "";
            }
            if c >= 65 && c <= 90 {
                c = c + 32;
            }
            bytes.push(c);
            k = k + 1;
        }
        i = i + 1 + l;
    }
    return str_from_bytes(bytes);
}

fn dns_name_in(names: &Vec<str>, name: str) -> bool {
    var i: i64 = 0;
    while i < names.len() {
        if str_equal(names.get(i), name) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The A and AAAA answers of a raw response (`len` bytes at `buf`). Every
/// read is checked against `len`: a truncated packet gives the answers
/// before the cut.
///
/// BG147 (Nov 24): only a response is read: QR set, a standard query
/// (opcode 0), RCODE 0 (NXDOMAIN or any other error: no answers) and one
/// question. An answer counts only when its class is IN and its owner is
/// the question's name or a name a CNAME answer before it led to (the
/// first datagram from anyone, with any owner, was the answer). The query
/// ID and the question are checked against the query sent by
/// dns_parse_reply, which dns_query_records uses.
pub fn dns_parse_records(buf: i64, len: i64) -> Vec<DnsRecord> {
    var out: Vec<DnsRecord> = Vec::new();
    if len < 12 {
        return out;
    }
    var flags: i64 = rd_u16(buf, 2);
    if (flags & 32768) == 0 || ((flags >> 11) & 15) != 0 || (flags & 15) != 0 {
        return out;
    }
    var qd: i64 = rd_u16(buf, 4);
    var an: i64 = rd_u16(buf, 6);
    if qd != 1 {
        return out;
    }
    var qname: str = dns_read_name(buf, 12, len);
    if str_len(qname) == 0 {
        return out;
    }
    // the names the answers may be about: the question's, then CNAME targets
    var chain: Vec<str> = Vec::new();
    chain.push(qname);
    var off: i64 = dns_skip_name_in(buf, 12, len);
    if off < 0 || off + 4 > len {
        return out;
    }
    off = off + 4;
    // QTYPE + QCLASS
    var i: i64 = 0;
    while i < an && off < len {
        var owner: str = dns_read_name(buf, off, len);
        off = dns_skip_name_in(buf, off, len);
        if off < 0 || off + 10 > len {
            break;
        }
        var rtype: i64 = rd_u16(buf, off);
        var rclass: i64 = rd_u16(buf, off + 2);
        var ttl: i64 = rd_u32(buf, off + 4);
        var rdlen: i64 = rd_u16(buf, off + 8);
        var rdata: i64 = off + 10;
        if rdata + rdlen > len {
            break;
        }
        if rclass == 1 && str_len(owner) > 0 && dns_name_in(&chain, owner) {
            if rtype == 1 && rdlen == 4 {
                out.push(DnsRecord {
                    rtype: 1, ttl: ttl, addr: dns_parse_u32_addr(buf, rdata)
                });
            } else if rtype == 28 && rdlen == 16 {
                out.push(DnsRecord {
                    rtype: 28, ttl: ttl, addr: dns_parse_v6_addr(buf, rdata)
                });
            } else if rtype == 5 && dns_skip_name_in(buf, rdata, rdata + rdlen) == rdata + rdlen {
                var target: str = dns_read_name(buf, rdata, len);
                if str_len(target) > 0 && !dns_name_in(&chain, target) && chain.len() < 16 {
                    chain.push(target);
                }
            }
        }
        off = rdata + rdlen;
        i = i + 1;
    }
    return out;
}

/// BG147: is the `len`-byte packet at `buf` the reply to the query with ID
/// `id` for `hostname` and `qtype`? Its ID, QR bit (a response), opcode
/// (standard query) and its one question (name, ignoring case and a
/// trailing dot; type; class IN) must match. RCODE is not looked at: a
/// matching NXDOMAIN is the answer (with no records).
pub fn dns_reply_matches(buf: i64, len: i64, id: i64, hostname: str, qtype: i64) -> bool {
    if len < 12 || rd_u16(buf, 0) != (id & 65535) {
        return false;
    }
    var flags: i64 = rd_u16(buf, 2);
    if (flags & 32768) == 0 || ((flags >> 11) & 15) != 0 || rd_u16(buf, 4) != 1 {
        return false;
    }
    var qname: str = dns_read_name(buf, 12, len);
    if str_len(qname) == 0 || !str_equal(qname, dns_norm_name(hostname)) {
        return false;
    }
    var off: i64 = dns_skip_name_in(buf, 12, len);
    if off < 0 || off + 4 > len {
        return false;
    }
    return rd_u16(buf, off) == qtype && rd_u16(buf, off + 2) == 1;
}

/// The answers of type `qtype` in the reply to the query with ID `id` for
/// `hostname` (dns_build_query_id): none when the packet is not that reply
/// (dns_reply_matches) or carries an error (dns_parse_records).
pub fn dns_parse_reply(buf: i64, len: i64, id: i64, hostname: str, qtype: i64) -> Vec<DnsRecord> {
    var out: Vec<DnsRecord> = Vec::new();
    if !dns_reply_matches(buf, len, id, hostname, qtype) {
        return out;
    }
    var recs: Vec<DnsRecord> = dns_parse_records(buf, len);
    var i: i64 = 0;
    while i < recs.len() {
        if recs.get(i).rtype == qtype {
            out.push(recs.get(i));
        }
        i = i + 1;
    }
    return out;
}

// ─── Cache ──────────────────────────────────────────────────────────────
// Answers kept for their time to live (competitive SL5): a name asked
// again before it expires costs no packet. Times are seconds, passed in
// (time_now_secs() in a program, any clock in a test).

pub struct DnsCache {
    pub names: Vec<str>,
    pub addrs: Vec<Vec<str>>,
    pub expires: Vec<i64>,
}

pub fn dns_cache_new() -> DnsCache {
    return DnsCache {
        names: Vec::new(), addrs: Vec::new(), expires: Vec::new()
    };
}

fn dns_cache_find(c: &DnsCache, name: str) -> i64 {
    var i: i64 = 0;
    while i < c.names.len() {
        if c.names.get(i) == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// The cached addresses of `name` at time `now`; empty when there are
/// none or they have expired.
pub fn dns_cache_get(c: &DnsCache, name: str, now: i64) -> Vec<str> {
    var i: i64 = dns_cache_find(c, str_to_lower(name));
    if i < 0 || c.expires.get(i) <= now {
        var none: Vec<str> = Vec::new();
        return none;
    }
    return c.addrs.get(i);
}

/// Keep `addrs` for `name` until `now + ttl` (seconds; names are not case
/// sensitive). A ttl of 0 or less keeps nothing.
pub fn dns_cache_put(c: &mut DnsCache, name: str, addrs: Vec<str>, ttl: i64, now: i64) {
    var key: str = str_to_lower(name);
    var i: i64 = dns_cache_find(c, key);
    if ttl <= 0 || addrs.len() == 0 {
        if i >= 0 {
            c.expires.set(i, now);
        }
        return;
    }
    if i < 0 {
        c.names.push(key);
        c.addrs.push(addrs);
        c.expires.push(now + ttl);
        return;
    }
    c.addrs.set(i, addrs);
    c.expires.set(i, now + ttl);
}

/// How many names the cache holds unexpired at `now`.
pub fn dns_cache_size(c: &DnsCache, now: i64) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < c.names.len() {
        if c.expires.get(i) > now {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

/// The A records of `hostname`: from the cache while they last, else a
/// query to `server` (its answers then cached for their smallest TTL).
pub fn dns_cache_resolve(c: &mut DnsCache, hostname: str, server: str, now: i64) -> Vec<str> {
    var hit: Vec<str> = dns_cache_get(c, hostname, now);
    if hit.len() > 0 {
        return hit;
    }
    var recs: Vec<DnsRecord> = dns_query_records(hostname, 1, server, 53, 2000);
    var addrs: Vec<str> = Vec::new();
    var ttl: i64 = -1;
    var i: i64 = 0;
    while i < recs.len() {
        addrs.push(recs.get(i).addr);
        if ttl < 0 || recs.get(i).ttl < ttl {
            ttl = recs.get(i).ttl;
        }
        i = i + 1;
    }
    dns_cache_put(c, hostname, addrs, ttl, now);
    return addrs;
}

// ─── Resolver ───────────────────────────────────────────────────────────

/// Query `server` (dotted-quad) for `hostname` qtype; returns Vec<str> of
/// answer addresses (empty on failure/timeout). Timeout ~2s.
pub fn dns_query(hostname: str, qtype: i64, server: str, port: i64, timeout_ms: i64) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var recs: Vec<DnsRecord> = dns_query_records(hostname, qtype, server, port, timeout_ms);
    var i: i64 = 0;
    while i < recs.len() {
        out.push(recs.get(i).addr);
        i = i + 1;
    }
    return out;
}

/// The answers to a query, with their TTLs (empty on failure or timeout).
pub fn dns_query_records(hostname: str, qtype: i64, server: str, port: i64, timeout_ms: i64) -> Vec<DnsRecord> {
    var out: Vec<DnsRecord> = Vec::new();
    // BG147: a random ID per query; a name that cannot be sent asks nothing
    var qid: i64 = dns_qid();
    var pkt: Vec = dns_build_query_id(hostname, qtype, qid);
    if pkt.len() == 0 {
        return out;
    }
    var sock: i64 = net_socket_create();
    if sock < 0 {
        return out;
    }
    net_set_recv_timeout(sock, timeout_ms);
    var addr: NetAddr = net_addr_create(server, port);
    var n: i64 = pkt.len();
    var buf: i64 = 0;
    // SAFETY: a fresh n-byte block: the loop below writes the n bytes of
    // the query into it.
    unsafe {
        buf = p_malloc(n);
    }
    var i: i64 = 0;
    while i < n {
        p_volatile_store8(buf + i, pkt.get(i));
        i = i + 1;
    }
    var sent: i64 = 0;
    // SAFETY: net_send_to's promise holds: buf holds the n readable bytes
    // just written, owned here until the p_free below.
    unsafe {
        sent = net_send_to(sock, buf, n, &addr);
    }
    if sent < 0 {
        net_close(sock);
        // SAFETY: the query block above; the send has returned.
        unsafe {
            p_free(buf);
        }
        return out;
    }
    var rbuf: i64 = 0;
    // SAFETY: a fresh 4096-byte block for the replies read below.
    unsafe {
        rbuf = p_malloc(4096);
    }
    // BG147: a datagram is the answer only when it comes from the server
    // asked (when the runtime reports the sender: port -1 is "not
    // reported") and is the reply to this query (dns_reply_matches); any
    // other is dropped and the next one read, up to 8, each within the
    // timeout.
    var from: NetAddr = NetAddr {
        ip: 0, port: -1, raw: 0
    };
    var tries: i64 = 0;
    while tries < 8 {
        var got: i64 = 0;
        from.port = -1;
        // SAFETY: rbuf is the 4096-byte block above, so net_recv_from's
        // promise holds: it writes at most the 4096 bytes it is told.
        unsafe {
            got = net_recv_from(sock, rbuf, 4096, &mut from);
        }
        if got <= 0 {
            break;
        }
        var from_ok: bool = from.port == -1 || (from.ip == addr.ip && from.port == port);
        if from_ok && dns_reply_matches(rbuf, got, qid, hostname, qtype) {
            out = dns_parse_reply(rbuf, got, qid, hostname, qtype);
            break;
        }
        tries = tries + 1;
    }
    // SAFETY: the reply and query blocks of this function; the records
    // parsed from the reply are copies (DnsRecord values), so nothing
    // points into either block afterwards.
    unsafe {
        p_free(rbuf);
        p_free(buf);
    }
    net_close(sock);
    return out;
}

/// Resolve `hostname` to all A records via the default resolver.
pub fn dns_resolve_all(hostname: str) -> Vec<str> {
    return dns_resolve_all_via(hostname, "1.1.1.1");
}

/// Resolve via a specific resolver IP.
pub fn dns_resolve_all_via(hostname: str, server: str) -> Vec<str> {
    return dns_query(hostname, 1, server, 53, 2000);
}

/// First A record for `hostname`, or "" on failure.
pub fn dns_resolve(hostname: str) -> str {
    var ips: Vec<str> = dns_resolve_all(hostname);
    if ips.len() == 0 {
        return "";
    }
    return ips.get(0);
}

pub fn dns_resolve_via(hostname: str, server: str) -> str {
    var ips: Vec<str> = dns_resolve_all_via(hostname, server);
    if ips.len() == 0 {
        return "";
    }
    return ips.get(0);
}

/// All AAAA records for `hostname`.
pub fn dns_resolve_v6(hostname: str) -> Vec<str> {
    return dns_query(hostname, 28, "1.1.1.1", 53, 2000);
}

// ─── System-resolver fallback ───────────────────────────────────────────
// When pledge_net UDP isn't linked into the build (the common case —
// ccompile only links named libraries), resolve through the OS resolver
// by shelling out to nslookup (Windows/Unix) or getent (glibc). Output
// is parsed for the first IPv4 answer.

use fs;
use io;
use os;
// Parse dotted quads out of an nslookup/getent text block. Works across
// locales: collects every IPv4-looking token except the resolver's own
// address (the "Server:"/"Serveur :" header and its "Address:" line).
fn dns_extract_ipv4(text: str, hostname: str) -> Vec<str> {
    var ips: Vec<str> = Vec::new();
    var lines: Vec<str> = str_lines(text);
    var skip_next_addr: bool = false;
    var i: i64 = 0;
    while i < lines.len() {
        var line: str = str_trim(lines.get(i));
        var lower: str = str_to_lower(line);
        if str_starts_with(lower, "serveur") || str_starts_with(lower, "server") {
            skip_next_addr = true;
            i = i + 1;
            continue;
        }
        // Candidate: text after ':' on a "ddress"-line, or the whole line.
        var cand: str = "";
        var cpos: i64 = str_find(lower, "ddress");
        if cpos >= 0 {
            var colon: i64 = str_find(line, ":");
            if colon >= 0 {
                cand = str_trim(str_slice(line, colon + 1, str_len(line)));
            }
            if skip_next_addr {
                cand = "";
                skip_next_addr = false;
            }
        } else {
            skip_next_addr = false;
            // whole line or first token (getent: "93.184.216.34 STREAM host")
            var sp: i64 = str_find(line, " ");
            var tab: i64 = str_find(line, "\t");
            var cut: i64 = str_len(line);
            if sp >= 0 && sp < cut {
                cut = sp;
            }
            if tab >= 0 && tab < cut {
                cut = tab;
            }
            cand = str_slice(line, 0, cut);
        }
        if dns_looks_ipv4(cand) {
            ips.push(cand);
        }
        i = i + 1;
    }
    return ips;
}

fn dns_looks_ipv4(s: str) -> bool {
    var parts: Vec = str_split(s, ".");
    if parts.len() != 4 {
        return false;
    }
    var i: i64 = 0;
    while i < 4 {
        var p: str = parts.get(i);
        if !str_is_numeric(p) {
            return false;
        }
        var v: i64 = str_parse_int(p);
        if v < 0 || v > 255 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Is `hostname` safe to pass to a shell resolver command? Only the DNS
/// alphabet is allowed: letters, digits, '.', '-', '_' and ':' (IPv6
/// literals). Anything else (spaces, ';', '&', '$', quotes, ...) makes
/// the name unsafe and the lookup returns "".
pub fn dns_hostname_safe(hostname: str) -> bool {
    var n: i64 = str_len(hostname);
    if n == 0 || n > 253 {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        var c: i64 = str_byte_at(hostname, i);
        var ok: bool = false;
        if c >= 97 && c <= 122 {
            ok = true;
        } else if c >= 65 && c <= 90 {
            ok = true;
        } else if c >= 48 && c <= 57 {
            ok = true;
        } else if c == 46 || c == 45 || c == 95 || c == 58 {
            ok = true;
        }
        if !ok {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Resolve via the OS resolver: nslookup on Windows, getent on Unix.
/// Returns first IPv4 address or "" on failure. Slower than a wire query
/// (process spawn) but needs no socket FFI. Names outside the DNS
/// alphabet are rejected before the command is built (shell injection).
pub fn dns_resolve_system(hostname: str) -> str {
    if !dns_hostname_safe(hostname) {
        return "";
    }
    var tmp: str = "fides_dns_tmp.txt";
    var cmd: str = "";
    if str_equal(os_name(), "windows") {
        cmd = "nslookup " + hostname + " > " + tmp + " 2>&1";
    } else {
        cmd = "getent ahostsv4 " + hostname + " > " + tmp + " 2>&1 || nslookup " + hostname + " > " + tmp + " 2>&1";
    }
    os_system(cmd);
    var out: str = "";
    if file_exists(tmp) {
        out = file_read(tmp);
        file_delete(tmp);
    }
    if str_len(out) == 0 {
        return "";
    }
    var ips: Vec<str> = dns_extract_ipv4(out, hostname);
    if ips.len() == 0 {
        return "";
    }
    return ips.get(0);
}

/// Recommended entry point: resolves through the OS resolver, which
/// works on every backend (the wire-format path needs pledge_net
/// linked and panics under `fid run` if it isn't).
/// Use dns_resolve()/dns_resolve_via() explicitly for the UDP path.
pub fn dns_lookup(hostname: str) -> str {
    if str_equal(str_to_lower(hostname), "localhost") {
        return "127.0.0.1";
    }
    if dns_looks_ipv4(hostname) {
        return hostname;
    }
    return dns_resolve_system(hostname);
}
