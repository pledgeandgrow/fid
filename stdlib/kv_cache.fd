// KV Cache stdlib — ML9
//
// Bounded attention cache for LLM serving.
// Used inside `region kv_cache r with budget(N) { }` blocks
// to prove at compile time that the KV cache can't exceed memory.

module kv_cache;

use tensor;

/// Create a new KV cache.
/// num_layers: number of transformer layers
/// max_seq_len: maximum sequence length (tokens)
/// window_size: sliding window size (0 = no window)
/// head_dim: dimension of each attention head
pub fn kv_cache_new(num_layers: i64, max_seq_len: i64, window_size: i64, head_dim: i64) -> i64 {
    p_kv_cache_new(num_layers, max_seq_len, window_size, head_dim)
}

/// Append K and V tensors for a given layer.
pub fn kv_cache_append(cache: i64, layer: i64, k: Tensor, v: Tensor) -> void {
    p_kv_cache_append(cache, layer, k, v)
}

/// Get K and V for a layer as a concatenated tensor.
pub fn kv_cache_get(cache: i64, layer: i64) -> Tensor {
    p_kv_cache_get(cache, layer)
}

/// Get current sequence length for a layer.
pub fn kv_cache_len(cache: i64, layer: i64) -> i64 {
    p_kv_cache_len(cache, layer)
}

/// Clear all layers.
pub fn kv_cache_clear(cache: i64) -> void {
    p_kv_cache_clear(cache)
}

/// Evict the oldest n tokens from all layers (sliding window).
pub fn kv_cache_evict(cache: i64, n: i64) -> void {
    p_kv_cache_evict(cache, n)
}
