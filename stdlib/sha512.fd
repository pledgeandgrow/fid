    s5_put(& mut k, 0x32caab7b40c72493);
    s5_put(& mut k, 0x3c9ebe0a15c9bebc);
    s5_put(& mut k, 0x431d67c49c100d4c);
    s5_put(& mut k, 0x4cc5d4becb3e42b6);
    s5_put(& mut k, 0x597f299cfc657e2a);
    s5_put(& mut k, 0x5fcb6fab3ad6faec);
    s5_put(& mut k, 0x6c44198c4a475817);
    return k;
}

@wrapping fn s5_rotr(x: u64, n: u64) -> u64 {
    return (x >> n) | (x << (64 - n));
}

/// One 128-byte block of m at `off` into the state h (8 words).
@wrapping fn s5_block(h: & mut Vec<i64>, k: & Vec<i64>, w: & mut Vec<i64>, m: & Vec<i64>, off: i64) {
    var i: i64 = 0;
    while i < 16 {
        var x: u64 = 0;
        var j: i64 = 0;
        while j < 8 {
            x = (x << 8) | ((m.get(off + i * 8 + j) & 255) as u64);
            j = j + 1;
        }
        w.set(i, x as i64);
        i = i + 1;
    } while i < 80 {
        val w15: u64 = w.get(i - 15) as u64;
        val w2: u64 = w.get(i - 2) as u64;
        val s0: u64 = s5_rotr(w15, 1) ^ s5_rotr(w15, 8) ^ (w15 >> 7);
        val s1: u64 = s5_rotr(w2, 19) ^ s5_rotr(w2, 61) ^ (w2 >> 6);
        val nw: u64 = (w.get(i - 16) as u64) + s0 + (w.get(i - 7) as u64) + s1;
        w.set(i, nw as i64);
        i = i + 1;
    }
    var a: u64 = h.get(0) as u64;
    var b: u64 = h.get(1) as u64;
    var c: u64 = h.get(2) as u64;
    var d: u64 = h.get(3) as u64;
    var e: u64 = h.get(4) as u64;
    var f: u64 = h.get(5) as u64;
    var g: u64 = h.get(6) as u64;
    var hh: u64 = h.get(7) as u64;
    i = 0;
    while i < 80 {
        val bs1: u64 = s5_rotr(e, 14) ^ s5_rotr(e, 18) ^ s5_rotr(e, 41);
        val ch: u64 = (e & f) ^ (~e & g);
        val t1: u64 = hh + bs1 + ch + (k.get(i) as u64) + (w.get(i) as u64);
        val bs0: u64 = s5_rotr(a, 28) ^ s5_rotr(a, 34) ^ s5_rotr(a, 39);
        val mj: u64 = (a & b) ^ (a & c) ^ (b & c);
        val t2: u64 = bs0 + mj;
        hh = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
        i = i + 1;
    }
    h.set(0, ((h.get(0) as u64) + a) as i64);
    h.set(1, ((h.get(1) as u64) + b) as i64);
    h.set(2, ((h.get(2) as u64) + c) as i64);
    h.set(3, ((h.get(3) as u64) + d) as i64);
    h.set(4, ((h.get(4) as u64) + e) as i64);
    h.set(5, ((h.get(5) as u64) + f) as i64);
    h.set(6, ((h.get(6) as u64) + g) as i64);
    h.set(7, ((h.get(7) as u64) + hh) as i64);
}

/// SHA-512 of a byte vector (each element 0..255): the 64-byte digest.
pub fn sha512_bytes(msg: Vec<i64>) -> Vec<i64> {
    val n: i64 = msg.len();
    // Padding: 0x80, zeros to 112 mod 128, the bit length as 128-bit BE.
    var m: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        m.push(msg.get(i) & 255);
        i = i + 1;
    }
    m.push(128);
    while m.len() % 128 != 112 {
        m.push(0);
    }
    i = 0;
    while i < 8 {
        m.push(0);
        i = i + 1;
    }
    val bits: i64 = n * 8;
    i = 7;
    while i >= 0 {
        m.push((bits >> (i * 8)) & 255);
        i = i - 1;
    }
    var h: Vec<i64> = Vec::new();
    s5_put(& mut h, 0x6a09e667f3bcc908);
    s5_put(& mut h, 0xbb67ae8584caa73b);
    s5_put(& mut h, 0x3c6ef372fe94f82b);
    s5_put(& mut h, 0xa54ff53a5f1d36f1);
    s5_put(& mut h, 0x510e527fade682d1);
    s5_put(& mut h, 0x9b05688c2b3e6c1f);
    s5_put(& mut h, 0x1f83d9abfb41bd6b);
    s5_put(& mut h, 0x5be0cd19137e2179);
    val k: Vec<i64> = s5_k();
    var w: Vec<i64> = Vec::new();
    i = 0;
    while i < 80 {
        w.push(0);
        i = i + 1;
    }
    var off: i64 = 0;
    while off < m.len() {
        s5_block(& mut h, & k, & mut w, & m, off);
        off = off + 128;
    }
    var out: Vec<i64> = Vec::new();
    i = 0;
    while i < 8 {
        val x: i64 = h.get(i);
        var s: i64 = 56;
        while s >= 0 {
            // >> on i64 is arithmetic; the & keeps the byte either way.
            out.push((x >> s) & 255);
            s = s - 8;
        }
        i = i + 1;
    }
    return out;
}

/// SHA-512 of the bytes of a string.
pub fn sha512_str(s: str) -> Vec<i64> {
    return sha512_bytes(str_bytes(s));
}

/// Lowercase hex of a byte vector.
pub fn sha512_hex(d: Vec<i64>) -> str {
    val digits: str = "0123456789abcdef";
    var out: str = "";
    var i: i64 = 0;
    while i < d.len() {
        val b: i64 = d.get(i) & 255;
        out = out + str_slice(digits, b >> 4, (b >> 4) + 1) + str_slice(digits, b & 15, (b & 15) + 1);
        i = i + 1;
    }
    return out;
}

// ─── HMAC-SHA512 (RFC 2104, RFC 4231) ──────────────────────────────────

/// HMAC-SHA512 of byte vectors (each element 0..255): the 64-byte MAC.
/// The block is 128 bytes: a longer key is hashed first, then padded with
/// zeros. Checked against RFC 4231 in tests/bootstrap/test_hmac_sha512.fd.
/// The key is `@secret` (complaint CO1); the MAC is an audited release.
@declassify pub fn hmac_sha512_bytes(@secret key: Vec<i64>, message: Vec<i64>) -> Vec<i64> {
    var kb: Vec<i64> = Vec::new();
    if key.len() > 128 {
        val kh: Vec<i64> = sha512_bytes(key);
        var hi: i64 = 0;
        while hi < 64 {
            kb.push(kh.get(hi));
            hi = hi + 1;
        }
    } else {
        var ki: i64 = 0;
        while ki < key.len() {
            kb.push(key.get(ki) & 255);
            ki = ki + 1;
        }
    }
    while kb.len() < 128 {
        kb.push(0);
    }
    var inner: Vec<i64> = Vec::new();
    var j: i64 = 0;
    while j < 128 {
        inner.push(kb.get(j) ^ 0x36);
        j = j + 1;
    }
    j = 0;
    while j < message.len() {
        inner.push(message.get(j) & 255);
        j = j + 1;
    }
    val ih: Vec<i64> = sha512_bytes(inner);
    var outer: Vec<i64> = Vec::new();
    j = 0;
    while j < 128 {
        outer.push(kb.get(j) ^ 0x5c);
        j = j + 1;
    }
    j = 0;
    while j < 64 {
        outer.push(ih.get(j));
        j = j + 1;
    }
    return sha512_bytes(outer);
}

/// HMAC-SHA512 of the bytes of two strings.
@declassify pub fn hmac_sha512(@secret key: str, message: str) -> Vec<i64> {
    return hmac_sha512_bytes(str_bytes(key), str_bytes(message));
}
