// Fides SHA-512 (FIPS 180-4 §6.4), pure Fides.
//
// 64-bit words are u64 inside @wrapping functions: + wraps mod 2^64 and
// >> is a logical shift. Between functions a word travels as the same 64
// bits in a Vec<i64> (`as i64` / `as u64` keep the bits). Messages and
// digests are Vec<i64> of bytes 0..255, as in crypto.fd.
//
// Constant time: no branch or index depends on the message contents (only
// on its length), so hashing a secret (an Ed25519 seed) leaks only its
// length. Messages up to 2^61 - 1 bytes.
//
// Usage:
//   use sha512;
//   val d = sha512_bytes(msg);          // 64-byte digest
//   val h = sha512_hex(sha512_str("abc"));

module sha512;
 use vec;
 fn s5_put(v: & mut Vec<i64>, x: u64) {
    v.push(x as i64);
}

/// The 80 round constants K0..K79 (cube roots of the first 80 primes).
fn s5_k() -> Vec<i64> {
    var k: Vec<i64> = Vec::new();
    s5_put(& mut k, 0x428a2f98d728ae22);
    s5_put(& mut k, 0x7137449123ef65cd);
    s5_put(& mut k, 0xb5c0fbcfec4d3b2f);
    s5_put(& mut k, 0xe9b5dba58189dbbc);
    s5_put(& mut k, 0x3956c25bf348b538);
    s5_put(& mut k, 0x59f111f1b605d019);
    s5_put(& mut k, 0x923f82a4af194f9b);
    s5_put(& mut k, 0xab1c5ed5da6d8118);
    s5_put(& mut k, 0xd807aa98a3030242);
    s5_put(& mut k, 0x12835b0145706fbe);
    s5_put(& mut k, 0x243185be4ee4b28c);
    s5_put(& mut k, 0x550c7dc3d5ffb4e2);
    s5_put(& mut k, 0x72be5d74f27b896f);
    s5_put(& mut k, 0x80deb1fe3b1696b1);
    s5_put(& mut k, 0x9bdc06a725c71235);
    s5_put(& mut k, 0xc19bf174cf692694);
    s5_put(& mut k, 0xe49b69c19ef14ad2);
    s5_put(& mut k, 0xefbe4786384f25e3);
    s5_put(& mut k, 0x0fc19dc68b8cd5b5);
    s5_put(& mut k, 0x240ca1cc77ac9c65);
    s5_put(& mut k, 0x2de92c6f592b0275);
    s5_put(& mut k, 0x4a7484aa6ea6e483);
    s5_put(& mut k, 0x5cb0a9dcbd41fbd4);
    s5_put(& mut k, 0x76f988da831153b5);
    s5_put(& mut k, 0x983e5152ee66dfab);
    s5_put(& mut k, 0xa831c66d2db43210);
    s5_put(& mut k, 0xb00327c898fb213f);
    s5_put(& mut k, 0xbf597fc7beef0ee4);
    s5_put(& mut k, 0xc6e00bf33da88fc2);
    s5_put(& mut k, 0xd5a79147930aa725);
    s5_put(& mut k, 0x06ca6351e003826f);
    s5_put(& mut k, 0x142929670a0e6e70);
    s5_put(& mut k, 0x27b70a8546d22ffc);
    s5_put(& mut k, 0x2e1b21385c26c926);
    s5_put(& mut k, 0x4d2c6dfc5ac42aed);
    s5_put(& mut k, 0x53380d139d95b3df);
    s5_put(& mut k, 0x650a73548baf63de);
    s5_put(& mut k, 0x766a0abb3c77b2a8);
    s5_put(& mut k, 0x81c2c92e47edaee6);
    s5_put(& mut k, 0x92722c851482353b);
    s5_put(& mut k, 0xa2bfe8a14cf10364);
    s5_put(& mut k, 0xa81a664bbc423001);
    s5_put(& mut k, 0xc24b8b70d0f89791);
    s5_put(& mut k, 0xc76c51a30654be30);
    s5_put(& mut k, 0xd192e819d6ef5218);
    s5_put(& mut k, 0xd69906245565a910);
    s5_put(& mut k, 0xf40e35855771202a);
    s5_put(& mut k, 0x106aa07032bbd1b8);
    s5_put(& mut k, 0x19a4c116b8d2d0c8);
    s5_put(& mut k, 0x1e376c085141ab53);
    s5_put(& mut k, 0x2748774cdf8eeb99);
    s5_put(& mut k, 0x34b0bcb5e19b48a8);
    s5_put(& mut k, 0x391c0cb3c5c95a63);
    s5_put(& mut k, 0x4ed8aa4ae3418acb);
    s5_put(& mut k, 0x5b9cca4f7763e373);
    s5_put(& mut k, 0x682e6ff3d6b2b8a3);
    s5_put(& mut k, 0x748f82ee5defb2fc);
    s5_put(& mut k, 0x78a5636f43172f60);
    s5_put(& mut k, 0x84c87814a1f0ab72);
    s5_put(& mut k, 0x8cc702081a6439ec);
    s5_put(& mut k, 0x90befffa23631e28);
    s5_put(& mut k, 0xa4506cebde82bde9);
    s5_put(& mut k, 0xbef9a3f7b2c67915);
    s5_put(& mut k, 0xc67178f2e372532b);
    s5_put(& mut k, 0xca273eceea26619c);
    s5_put(& mut k, 0xd186b8c721c0c207);
