// Fides OPC UA binary encoding (IEC 62541 Part 6), secure channels,
// sessions and a client for the Read service
//
// Real (pure computation):
//   - the built-in types of Part 6 section 5.2: Boolean, SByte, Byte,
//     Int16/UInt16, Int32/UInt32, Int64/UInt64, Float (with round-to-
//     nearest-even from f64), Double, String (null as length -1), DateTime
//     (100 ns ticks since 1601), Guid, ByteString, NodeId in all six
//     encodings (TwoByte, FourByte, Numeric, String, Guid, ByteString;
//     the encoder picks the shortest numeric form), QualifiedName,
//     LocalizedText, StatusCode, Variant (scalars and one-dimensional
//     arrays of the types above), DataValue (all mask fields),
//     ExtensionObject headers;
//   - UA Connection Protocol (Part 6 section 7.1): the message header
//     (message type, chunk type, size), Hello, Acknowledge and Error;
//   - secure channels (Part 6 6.7) with SecurityPolicy None and
//     Basic256Sha256 (modes Sign and SignAndEncrypt): OpenSecureChannel
//     request/response bodies (Issue and Renew), OPN messages with the
//     asymmetric security header, RSA-PKCS1-v1.5-SHA256 signatures and
//     RSA-OAEP-SHA1 encryption in k - 42 byte blocks with padding; the
//     P_SHA256 derivation of the symmetric keys (32-byte signing key,
//     32-byte AES key, 16-byte IV for each direction); MSG and CLO chunks
//     with HMAC-SHA256 signatures, padding and AES-256-CBC; sequence
//     numbers (checked +1 per chunk, wrap below 1024); token renewal (the
//     client switches at the response and still accepts the old token, the
//     server switches when the client first uses the new one); chunking of
//     long messages; CloseSecureChannel;
//   - sessions (Part 4 5.6): CreateSession (application descriptions,
//     endpoints with user token policies, the server's signature of the
//     client certificate + nonce), ActivateSession (the client's
//     signature of the server certificate + nonce, anonymous and
//     user name / password identity tokens; with Basic256Sha256 the
//     password secret is RSA-OAEP-SHA1 of length + password + server
//     nonce), CloseSession, ServiceFault;
//   - ReadRequest (encoding id 631) and ReadResponse (634);
//   - a client state machine (UaClient): Hello, OpenSecureChannel,
//     CreateSession, ActivateSession, Read, renewal, CloseSession,
//     CloseSecureChannel, failing with a reason on any check.
// Encryption uses stdlib/aes_gcm.fd's AES block cipher; AES decryption
// (the inverse cipher with its own key schedule) is written here. RSA,
// SHA-1/SHA-256 and HMAC come from rsa.fd and kdf.fd, certificates are
// parsed by x509.fd.
//
// The seams: the transport (the caller owns the TCP connection: the
// client returns the frames to write and takes the bytes read, in any
// split), randomness (a channel's nonces and OAEP seeds come from an
// HMAC-SHA256 generator the caller seeds, with crypto_random_bytes in real
// use), the clock (milliseconds passed in by the caller), and trust: a
// server learns the client certificate from the OPN request and the
// caller must check it against its trust list (x509_verify_chain).
// Not done: other security policies (Aes128_Sha256_RsaOaep,
// Aes256_Sha256_RsaPss, Basic128Rsa15 ...), RSA keys over 2048 bits in
// OPN messages, X.509 identity tokens, services other than Read and the
// session services. Not constant time (rsa.fd says why); the HMAC
// comparison is.
//
// Checked: tests/bootstrap/test_std_opcua.fd (Part 6 examples, P_SHA256
// against Python's hmac, AES-256 against FIPS 197 C.3 and SP 800-38A
// F.2.5/F.2.6, secured MSG chunks, the session bodies) and
// tests/bootstrap/test_std_opcua_secure.fd (a client and a server
// exchanging a Basic256Sha256 SignAndEncrypt session with OpenSSL-made
// RSA-2048 certificates; run compiled, the interpreter runs out of
// memory on RSA-2048).
//
// Bytes are Vec<i64>, one value 0..255 each; multi-byte values are
// little-endian, as Part 6 requires.

module opcua;
use vec;
use string;
use bigint;
use kdf;
use rsa;
use x509;
use aes_gcm;

// Variant type ids (Part 6 table 1)
pub const UA_BOOLEAN: i64 = 1;
pub const UA_SBYTE: i64 = 2;
pub const UA_BYTE: i64 = 3;
pub const UA_INT16: i64 = 4;
pub const UA_UINT16: i64 = 5;
pub const UA_INT32: i64 = 6;
pub const UA_UINT32: i64 = 7;
pub const UA_INT64: i64 = 8;
pub const UA_UINT64: i64 = 9;
pub const UA_FLOAT: i64 = 10;
pub const UA_DOUBLE: i64 = 11;
pub const UA_STRING: i64 = 12;
pub const UA_DATETIME: i64 = 13;
pub const UA_BYTESTRING: i64 = 15;
pub const UA_STATUSCODE: i64 = 19;

// NodeId kinds
pub const UA_ID_NUMERIC: i64 = 0;
pub const UA_ID_STRING: i64 = 1;
pub const UA_ID_GUID: i64 = 2;
pub const UA_ID_OPAQUE: i64 = 3;

// Attribute ids, status codes, encoding ids
pub const UA_ATTR_VALUE: i64 = 13;
pub const UA_GOOD: i64 = 0;
pub const UA_BAD_NODE_ID_UNKNOWN: i64 = 0x80340000;
pub const UA_READ_REQUEST_ID: i64 = 631;
pub const UA_READ_RESPONSE_ID: i64 = 634;

/// Ticks (100 ns) from 1601-01-01 to 1970-01-01.
pub const UA_EPOCH_DELTA: i64 = 116444736000000000;

// ─── Writing primitives ──────────────────────────────────────────────────

@wrapping
pub fn ua_put_uint(out: &mut Vec<i64>, v: i64, width: i64) {
    var i: i64 = 0;
    while i < width {
        out.push(((v as u64) >> ((i * 8) as u64) & 255) as i64);
        i = i + 1;
    }
}

pub fn ua_put_bool(out: &mut Vec<i64>, b: bool) {
    if b {
        out.push(1);
    } else {
        out.push(0);
    }
}

pub fn ua_put_byte(out: &mut Vec<i64>, v: i64) {
    out.push(v & 255);
}

pub fn ua_put_u16(out: &mut Vec<i64>, v: i64) {
    ua_put_uint(out, v, 2);
}

pub fn ua_put_u32(out: &mut Vec<i64>, v: i64) {
    ua_put_uint(out, v, 4);
}

pub fn ua_put_i64(out: &mut Vec<i64>, v: i64) {
    ua_put_uint(out, v, 8);
}

pub fn ua_put_double(out: &mut Vec<i64>, x: f64) {
    ua_put_uint(out, p_f64_to_bits(x), 8);
}

pub fn ua_put_float(out: &mut Vec<i64>, x: f64) {
    ua_put_uint(out, ua_f64_to_f32_bits(x), 4);
}

/// A String: Int32 length, UTF-8 bytes.
pub fn ua_put_string(out: &mut Vec<i64>, s: str) {
    val n: i64 = str_len(s);
    ua_put_u32(out, n);
    var i: i64 = 0;
    while i < n {
        out.push(str_byte_at(s, i));
        i = i + 1;
    }
}

/// The null String (length -1).
pub fn ua_put_null_string(out: &mut Vec<i64>) {
    ua_put_u32(out, -1);
}

pub fn ua_put_bytestring(out: &mut Vec<i64>, b: &Vec<i64>) {
    ua_put_u32(out, b.len());
    var i: i64 = 0;
    while i < b.len() {
        out.push(b.get(i) & 255);
        i = i + 1;
    }
}

/// A DateTime from milliseconds since 1970 (UTC).
pub fn ua_datetime_from_unix_ms(ms: i64) -> i64 {
    return UA_EPOCH_DELTA + ms * 10000;
}

pub fn ua_datetime_to_unix_ms(t: i64) -> i64 {
    return (t - UA_EPOCH_DELTA) / 10000;
}

// ─── Float (binary32) from and to f64 ────────────────────────────────────

/// The 32 bits of x rounded to single precision (nearest, ties to even).
@wrapping
pub fn ua_f64_to_f32_bits(x: f64) -> i64 {
    val bits: i64 = p_f64_to_bits(x);
    val sign: i64 = (((bits as u64) >> (63 as u64)) as i64) << 31;
    val e: i64 = (bits >> 52) & 2047;
    val m: i64 = bits & 4503599627370495;
    if e == 2047 {
        if m == 0 {
            return sign | 0x7f800000;
        }
        return sign | 0x7fc00000 | ((m >> 29) & 4194303);
    }
    if e == 0 {
        return sign;  // f64 subnormals round to zero in binary32
    }
    val ex: i64 = e - 1023;
    var full: i64 = m | 4503599627370496;  // 53 bits
    var shift: i64 = 29;
    var biased: i64 = ex + 127;
    if biased <= 0 {
        shift = 29 + 1 - biased;  // subnormal result
        biased = 0;
        if shift > 54 {
            return sign;
        }
    }
    var mant: i64 = full >> shift;
    val rem: i64 = full & ((1 << shift) - 1);
    val half: i64 = 1 << (shift - 1);
    if rem > half || (rem == half && (mant & 1) == 1) {
        mant = mant + 1;
    }
    if biased == 0 {
        // a subnormal that rounded up into the normals is still right:
        // mant 0x800000 sets the lowest exponent bit
        return sign | mant;
    }
    if mant >= 16777216 {
        mant = mant >> 1;
        biased = biased + 1;
    }
    if biased >= 255 {
        return sign | 0x7f800000;
    }
    return sign | (biased << 23) | (mant & 8388607);
}

pub fn ua_f32_bits_to_f64(s: i64) -> f64 {
    val e: i64 = (s >> 23) & 255;
    val m: i64 = s & 8388607;
    var v: f64 = 0.0;
    if e == 0 {
        v = (m as f64) * ua_pow2(-149);
    } else if e == 255 {
        if m == 0 {
            v = 1.0 / 0.0;
        } else {
            v = 0.0 / 0.0;
        }
    } else {
        v = ((m + 8388608) as f64) * ua_pow2(e - 150);
    }
    if ((s >> 31) & 1) == 1 {
        return p_f64_from_bits(p_f64_to_bits(v) ^ (0 - 9223372036854775807 - 1));
    }
    return v;
}

fn ua_pow2(e: i64) -> f64 {
    var r: f64 = 1.0;
    var i: i64 = 0;
    if e >= 0 {
        while i < e {
            r = r * 2.0;
            i = i + 1;
        }
    } else {
        while i < 0 - e {
            r = r * 0.5;
            i = i + 1;
        }
    }
    return r;
}

// ─── Reading primitives ──────────────────────────────────────────────────

/// A cursor over encoded bytes; `ok` turns false on truncated or bad data.
pub struct UaReader {
    pub b: Vec<i64>,
    pub pos: i64,
    pub ok: bool,
    pub error: str,
}

pub fn ua_reader(b: Vec<i64>) -> UaReader {
    return UaReader {
        b: b, pos: 0, ok: true, error: ""
    };
}

pub fn ua_fail(r: &mut UaReader, why: str) {
    if r.ok {
        r.ok = false;
        r.error = why + " at byte " + int_to_str(r.pos);
    }
}

@wrapping
pub fn ua_get_uint(r: &mut UaReader, width: i64) -> i64 {
    if r.pos + width > r.b.len() {
        ua_fail(r, "truncated");
        r.pos = r.b.len();
        return 0;
    }
    var v: i64 = 0;
    var i: i64 = width - 1;
    while i >= 0 {
        v = (v << 8) | (r.b.get(r.pos + i) & 255);
        i = i - 1;
    }
    r.pos = r.pos + width;
    return v;
}

/// A signed value of `width` bytes.
@wrapping
pub fn ua_get_int(r: &mut UaReader, width: i64) -> i64 {
    val v: i64 = ua_get_uint(r, width);
    if width < 8 && ((v >> (width * 8 - 1)) & 1) == 1 {
        return v - (1 << (width * 8));
    }
    return v;
}

pub fn ua_get_byte(r: &mut UaReader) -> i64 {
    return ua_get_uint(r, 1);
}

pub fn ua_get_u16(r: &mut UaReader) -> i64 {
    return ua_get_uint(r, 2);
}

pub fn ua_get_u32(r: &mut UaReader) -> i64 {
    return ua_get_uint(r, 4);
}

pub fn ua_get_i32(r: &mut UaReader) -> i64 {
    return ua_get_int(r, 4);
}

pub fn ua_get_i64(r: &mut UaReader) -> i64 {
    return ua_get_uint(r, 8);
}

pub fn ua_get_double(r: &mut UaReader) -> f64 {
    return p_f64_from_bits(ua_get_uint(r, 8));
}

pub fn ua_get_float(r: &mut UaReader) -> f64 {
    return ua_f32_bits_to_f64(ua_get_uint(r, 4));
}

/// A ByteString (a null one, length -1, reads as []).
pub fn ua_get_bytestring(r: &mut UaReader) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val n: i64 = ua_get_i32(r);
    if n < 0 {
        return out;
    }
    if r.pos + n > r.b.len() {
        ua_fail(r, "string runs past the end");
        return out;
    }
    var i: i64 = 0;
    while i < n {
        out.push(r.b.get(r.pos + i));
        i = i + 1;
    }
    r.pos = r.pos + n;
    return out;
}

/// A String (a null String reads as "").
pub fn ua_get_string(r: &mut UaReader) -> str {
    return str_from_bytes(ua_get_bytestring(r));
}

// ─── NodeId ──────────────────────────────────────────────────────────────

pub struct UaNodeId {
    pub ns: i64,
    pub kind: i64,  // UA_ID_*
    pub num: i64,  // numeric identifier
    pub text: str,  // string identifier
    pub bytes: Vec<i64>,  // Guid (16 bytes as encoded) or opaque identifier
}

pub fn ua_node_num(ns: i64, id: i64) -> UaNodeId {
    return UaNodeId {
        ns: ns, kind: UA_ID_NUMERIC, num: id, text: "", bytes: Vec::new()
    };
}

pub fn ua_node_str(ns: i64, s: str) -> UaNodeId {
    return UaNodeId {
        ns: ns, kind: UA_ID_STRING, num: 0, text: s, bytes: Vec::new()
    };
}

/// A Guid NodeId from its text form "72962B91-FA75-4AE6-8D28-B404DC7DAF63".
pub fn ua_node_guid(ns: i64, guid: str) -> UaNodeId {
    return UaNodeId {
        ns: ns, kind: UA_ID_GUID, num: 0, text: "", bytes: ua_guid_bytes(guid)
    };
}

fn ua_hexval(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    return -1;
}

/// The 16 encoded bytes of a Guid: Data1 (4), Data2 (2), Data3 (2)
/// little-endian, then Data4 (8) as written.
pub fn ua_guid_bytes(g: str) -> Vec<i64> {
    var hex: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < str_len(g) {
        val v: i64 = ua_hexval(str_byte_at(g, i));
        if v >= 0 {
            hex.push(v);
        }
        i = i + 1;
    }
    var raw: Vec<i64> = Vec::new();
    i = 0;
    while i + 1 < hex.len() {
        raw.push(hex.get(i) * 16 + hex.get(i + 1));
        i = i + 2;
    }
    var out: Vec<i64> = Vec::new();
    if raw.len() != 16 {
        return out;
    }
    out.push(raw.get(3));
    out.push(raw.get(2));
    out.push(raw.get(1));
    out.push(raw.get(0));
    out.push(raw.get(5));
    out.push(raw.get(4));
    out.push(raw.get(7));
    out.push(raw.get(6));
    i = 8;
    while i < 16 {
        out.push(raw.get(i));
        i = i + 1;
    }
    return out;
}

/// The text form of an encoded Guid (uppercase).
pub fn ua_guid_text(b: &Vec<i64>) -> str {
    if b.len() != 16 {
        return "";
    }
    var order: Vec<i64> = Vec::new();
    order.push(3);
    order.push(2);
    order.push(1);
    order.push(0);
    order.push(5);
    order.push(4);
    order.push(7);
    order.push(6);
    var i: i64 = 8;
    while i < 16 {
        order.push(i);
        i = i + 1;
    }
    val digits: str = "0123456789ABCDEF";
    var s: str = "";
    i = 0;
    while i < 16 {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            s = s + "-";
        }
        val v: i64 = b.get(order.get(i));
        s = s + str_slice(digits, v >> 4, (v >> 4) + 1) + str_slice(digits, v & 15, (v & 15) + 1);
        i = i + 1;
    }
    return s;
}

/// Encode a NodeId (shortest numeric form: TwoByte, FourByte, Numeric).
pub fn ua_put_nodeid(out: &mut Vec<i64>, n: &UaNodeId) {
    if n.kind == UA_ID_NUMERIC {
        if n.ns == 0 && n.num >= 0 && n.num <= 255 {
            out.push(0);
            out.push(n.num);
        } else if n.ns <= 255 && n.num >= 0 && n.num <= 65535 {
            out.push(1);
            out.push(n.ns);
            ua_put_u16(out, n.num);
        } else {
            out.push(2);
            ua_put_u16(out, n.ns);
            ua_put_u32(out, n.num);
        }
    } else if n.kind == UA_ID_STRING {
        out.push(3);
        ua_put_u16(out, n.ns);
        ua_put_string(out, n.text);
    } else if n.kind == UA_ID_GUID {
        out.push(4);
        ua_put_u16(out, n.ns);
        var i: i64 = 0;
        while i < 16 {
            out.push(n.bytes.get(i));
            i = i + 1;
        }
    } else {
        out.push(5);
        ua_put_u16(out, n.ns);
        ua_put_bytestring(out, &n.bytes);
    }
}

/// Decode a NodeId (an ExpandedNodeId's namespace URI and server index,
/// if flagged, are read and dropped).
pub fn ua_get_nodeid(r: &mut UaReader) -> UaNodeId {
    val enc: i64 = ua_get_byte(r);
    var n: UaNodeId = ua_node_num(0, 0);
    val form: i64 = enc & 15;
    if form == 0 {
        n.num = ua_get_byte(r);
    } else if form == 1 {
        n.ns = ua_get_byte(r);
        n.num = ua_get_u16(r);
    } else if form == 2 {
        n.ns = ua_get_u16(r);
        n.num = ua_get_u32(r);
    } else if form == 3 {
        n.kind = UA_ID_STRING;
        n.ns = ua_get_u16(r);
        n.text = ua_get_string(r);
    } else if form == 4 {
        n.kind = UA_ID_GUID;
        n.ns = ua_get_u16(r);
        var i: i64 = 0;
        while i < 16 {
            n.bytes.push(ua_get_byte(r));
            i = i + 1;
        }
    } else if form == 5 {
        n.kind = UA_ID_OPAQUE;
        n.ns = ua_get_u16(r);
        n.bytes = ua_get_bytestring(r);
    } else {
        ua_fail(r, "bad NodeId encoding " + int_to_str(enc));
    }
    if (enc & 128) != 0 {
        ua_get_string(r);
    }
    if (enc & 64) != 0 {
        ua_get_u32(r);
    }
    return n;
}

/// "ns=1;s=Hot", "i=85", "ns=4;g=...", "ns=2;b=<hex>" (Part 6 5.3.1.10).
pub fn ua_nodeid_text(n: &UaNodeId) -> str {
    var s: str = "";
    if n.ns != 0 {
        s = "ns=" + int_to_str(n.ns) + ";";
    }
    if n.kind == UA_ID_NUMERIC {
        return s + "i=" + u64_to_str(n.num as u64);
    }
    if n.kind == UA_ID_STRING {
        return s + "s=" + n.text;
    }
    if n.kind == UA_ID_GUID {
        return s + "g=" + ua_guid_text(&n.bytes);
    }
    var h: str = "";
    val digits: str = "0123456789abcdef";
    var i: i64 = 0;
    while i < n.bytes.len() {
        val v: i64 = n.bytes.get(i);
        h = h + str_slice(digits, v >> 4, (v >> 4) + 1) + str_slice(digits, v & 15, (v & 15) + 1);
        i = i + 1;
    }
    return s + "b=" + h;
}

pub fn ua_nodeid_eq(a: &UaNodeId, b: &UaNodeId) -> bool {
    if a.ns != b.ns || a.kind != b.kind || a.num != b.num || a.text != b.text || a.bytes.len() != b.bytes.len() {
        return false;
    }
    var i: i64 = 0;
    while i < a.bytes.len() {
        if a.bytes.get(i) != b.bytes.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ─── QualifiedName, LocalizedText ────────────────────────────────────────

pub fn ua_put_qualified_name(out: &mut Vec<i64>, ns: i64, name: str) {
    ua_put_u16(out, ns);
    ua_put_string(out, name);
}

/// LocalizedText with the fields that are not empty.
pub fn ua_put_localized_text(out: &mut Vec<i64>, locale: str, text: str) {
    var mask: i64 = 0;
    if locale != "" {
        mask = mask | 1;
    }
    if text != "" {
        mask = mask | 2;
    }
    out.push(mask);
    if locale != "" {
        ua_put_string(out, locale);
    }
    if text != "" {
        ua_put_string(out, text);
    }
}

// ─── Variant ─────────────────────────────────────────────────────────────

/// A Variant: type id, scalar or one-dimensional array; values in `ints`
/// (Boolean .. UInt64, DateTime, StatusCode), `floats` (Float, Double),
/// `strs` (String) or `bins` (ByteString). vtype 0 is the null Variant.
pub struct UaVariant {
    pub vtype: i64,
    pub is_array: bool,
    pub ints: Vec<i64>,
    pub floats: Vec<f64>,
    pub strs: Vec<str>,
    pub bins: Vec<Vec<i64>>,
}

pub fn ua_variant(vtype: i64) -> UaVariant {
    return UaVariant {
        vtype: vtype, is_array: false, ints: Vec::new(), floats: Vec::new(), strs: Vec::new(), bins: Vec::new()
    };
}

pub fn ua_var_int(vtype: i64, v: i64) -> UaVariant {
    var x: UaVariant = ua_variant(vtype);
    x.ints.push(v);
    return x;
}

pub fn ua_var_double(v: f64) -> UaVariant {
    var x: UaVariant = ua_variant(UA_DOUBLE);
    x.floats.push(v);
    return x;
}

pub fn ua_var_float(v: f64) -> UaVariant {
    var x: UaVariant = ua_variant(UA_FLOAT);
    x.floats.push(v);
    return x;
}

pub fn ua_var_string(s: str) -> UaVariant {
    var x: UaVariant = ua_variant(UA_STRING);
    x.strs.push(s);
    return x;
}

/// Number of values held.
pub fn ua_var_len(v: &UaVariant) -> i64 {
    val t: i64 = v.vtype;
    if t == UA_FLOAT || t == UA_DOUBLE {
        return v.floats.len();
    }
    if t == UA_STRING {
        return v.strs.len();
    }
    if t == UA_BYTESTRING {
        return v.bins.len();
    }
    return v.ints.len();
}

fn ua_int_width(t: i64) -> i64 {
    if t == UA_BOOLEAN || t == UA_SBYTE || t == UA_BYTE {
        return 1;
    }
    if t == UA_INT16 || t == UA_UINT16 {
        return 2;
    }
    if t == UA_INT32 || t == UA_UINT32 || t == UA_STATUSCODE {
        return 4;
    }
    return 8;
}

fn ua_supported(t: i64) -> bool {
    return (t >= 1 && t <= 13) || t == UA_BYTESTRING || t == UA_STATUSCODE;
}

fn ua_put_value(out: &mut Vec<i64>, v: &UaVariant, i: i64) {
    val t: i64 = v.vtype;
    if t == UA_DOUBLE {
        ua_put_double(out, v.floats.get(i));
    } else if t == UA_FLOAT {
        ua_put_float(out, v.floats.get(i));
    } else if t == UA_STRING {
        ua_put_string(out, v.strs.get(i));
    } else if t == UA_BYTESTRING {
        ua_put_bytestring(out, &v.bins.get(i));
    } else {
        ua_put_uint(out, v.ints.get(i), ua_int_width(t));
    }
}

pub fn ua_put_variant(out: &mut Vec<i64>, v: &UaVariant) {
    if v.vtype == 0 {
        out.push(0);
        return;
    }
    if v.is_array {
        out.push(v.vtype | 128);
        val n: i64 = ua_var_len(v);
        ua_put_u32(out, n);
        var i: i64 = 0;
        while i < n {
            ua_put_value(out, v, i);
            i = i + 1;
        }
    } else {
        out.push(v.vtype);
        ua_put_value(out, v, 0);
    }
}

fn ua_get_value(r: &mut UaReader, v: &mut UaVariant) {
    val t: i64 = v.vtype;
    if t == UA_DOUBLE {
        v.floats.push(ua_get_double(r));
    } else if t == UA_FLOAT {
        v.floats.push(ua_get_float(r));
    } else if t == UA_STRING {
        v.strs.push(ua_get_string(r));
    } else if t == UA_BYTESTRING {
        v.bins.push(ua_get_bytestring(r));
    } else if t == UA_SBYTE || t == UA_INT16 || t == UA_INT32 {
        v.ints.push(ua_get_int(r, ua_int_width(t)));
    } else {
        v.ints.push(ua_get_uint(r, ua_int_width(t)));
    }
}

pub fn ua_get_variant(r: &mut UaReader) -> UaVariant {
    val mask: i64 = ua_get_byte(r);
    var v: UaVariant = ua_variant(mask & 63);
    if mask == 0 {
        return v;
    }
    if !ua_supported(v.vtype) {
        ua_fail(r, "Variant type " + int_to_str(v.vtype) + " not supported");
        return v;
    }
    if (mask & 128) != 0 {
        v.is_array = true;
        val n: i64 = ua_get_i32(r);
        if n > r.b.len() - r.pos {
            ua_fail(r, "array length too large");
            return v;
        }
        var i: i64 = 0;
        while i < n && r.ok {
            ua_get_value(r, &mut v);
            i = i + 1;
        }
        if (mask & 64) != 0 {
            val dims: i64 = ua_get_i32(r);
            var k: i64 = 0;
            while k < dims && r.ok {
                ua_get_i32(r);
                k = k + 1;
            }
        }
    } else {
        ua_get_value(r, &mut v);
    }
    return v;
}

// ─── DataValue ───────────────────────────────────────────────────────────

pub struct UaDataValue {
    pub has_value: bool,
    pub value: UaVariant,
    pub has_status: bool,
    pub status: i64,
    pub has_source_ts: bool,
    pub source_ts: i64,
    pub has_server_ts: bool,
    pub server_ts: i64,
    pub source_pico: i64,  // -1: absent
    pub server_pico: i64,
}

pub fn ua_datavalue(v: UaVariant) -> UaDataValue {
    return UaDataValue {
        has_value: true, value: v, has_status: false, status: 0, has_source_ts: false, source_ts: 0, has_server_ts: false, server_ts: 0, source_pico: -1, server_pico: -1,
    };
}

pub fn ua_put_datavalue(out: &mut Vec<i64>, d: &UaDataValue) {
    var mask: i64 = 0;
    if d.has_value {
        mask = mask | 1;
    }
    if d.has_status {
        mask = mask | 2;
    }
    if d.has_source_ts {
        mask = mask | 4;
    }
    if d.has_server_ts {
        mask = mask | 8;
    }
    if d.source_pico >= 0 {
        mask = mask | 16;
    }
    if d.server_pico >= 0 {
        mask = mask | 32;
    }
    out.push(mask);
    if d.has_value {
        ua_put_variant(out, &d.value);
    }
    if d.has_status {
        ua_put_u32(out, d.status);
    }
    if d.has_source_ts {
        ua_put_i64(out, d.source_ts);
    }
    if d.source_pico >= 0 {
        ua_put_u16(out, d.source_pico);
    }
    if d.has_server_ts {
        ua_put_i64(out, d.server_ts);
    }
    if d.server_pico >= 0 {
        ua_put_u16(out, d.server_pico);
    }
}

pub fn ua_get_datavalue(r: &mut UaReader) -> UaDataValue {
    val mask: i64 = ua_get_byte(r);
    var d: UaDataValue = ua_datavalue(ua_variant(0));
    d.has_value = (mask & 1) != 0;
    if d.has_value {
        d.value = ua_get_variant(r);
    }
    d.has_status = (mask & 2) != 0;
    if d.has_status {
        d.status = ua_get_u32(r);
    }
    d.has_source_ts = (mask & 4) != 0;
    if d.has_source_ts {
        d.source_ts = ua_get_i64(r);
    }
    if (mask & 16) != 0 {
        d.source_pico = ua_get_u16(r);
    }
    d.has_server_ts = (mask & 8) != 0;
    if d.has_server_ts {
        d.server_ts = ua_get_i64(r);
    }
    if (mask & 32) != 0 {
        d.server_pico = ua_get_u16(r);
    }
    return d;
}

/// An ExtensionObject with no body (TypeId i=0, encoding 0).
pub fn ua_put_empty_extension(out: &mut Vec<i64>) {
    out.push(0);
    out.push(0);
    out.push(0);
}

fn ua_skip_extension(r: &mut UaReader) {
    ua_get_nodeid(r);
    val enc: i64 = ua_get_byte(r);
    if enc == 1 || enc == 2 {
        ua_get_bytestring(r);
    } else if enc != 0 {
        ua_fail(r, "bad ExtensionObject encoding");
    }
}

fn ua_skip_diagnostic(r: &mut UaReader, depth: i64) {
    val mask: i64 = ua_get_byte(r);
    if (mask & 1) != 0 {
        ua_get_i32(r);
    }
    if (mask & 2) != 0 {
        ua_get_i32(r);
    }
    if (mask & 8) != 0 {
        ua_get_i32(r);
    }
    if (mask & 4) != 0 {
        ua_get_i32(r);
    }
    if (mask & 16) != 0 {
        ua_get_string(r);
    }
    if (mask & 32) != 0 {
        ua_get_u32(r);
    }
    if (mask & 64) != 0 {
        if depth > 8 {
            ua_fail(r, "DiagnosticInfo nested too deep");
            return;
        }
        ua_skip_diagnostic(r, depth + 1);
    }
}

// ─── Connection protocol: header, Hello, Acknowledge, Error ──────────────

/// A message (or chunk): 3-letter type, chunk type 'F'/'C'/'A' and body;
/// the size field is computed.
pub fn ua_message(mtype: str, chunk: i64, body: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 3 {
        out.push(str_byte_at(mtype, i));
        i = i + 1;
    }
    out.push(chunk);
    ua_put_u32(&mut out, body.len() + 8);
    i = 0;
    while i < body.len() {
        out.push(body.get(i));
        i = i + 1;
    }
    return out;
}

/// The size of the first whole message in `buf`: 0 while incomplete.
pub fn ua_frame_len(buf: &Vec<i64>) -> i64 {
    if buf.len() < 8 {
        return 0;
    }
    var r: UaReader = ua_reader(Vec::new());
    var hdr: Vec<i64> = Vec::new();
    var i: i64 = 4;
    while i < 8 {
        hdr.push(buf.get(i));
        i = i + 1;
    }
    r.b = hdr;
    val n: i64 = ua_get_u32(&mut r);
    if n < 8 {
        return -1;
    }
    if buf.len() < n {
        return 0;
    }
    return n;
}

pub struct UaHello {
    pub version: i64,
    pub recv_buf: i64,
    pub send_buf: i64,
    pub max_msg: i64,
    pub max_chunks: i64,
    pub url: str,  // Hello only
    pub mtype: str,  // "HEL", "ACK" or "ERR"
    pub error: i64,  // ERR: the status code
    pub reason: str,  // ERR: the reason
    pub ok: bool,
}

pub fn ua_hello(url: str, buf_size: i64) -> UaHello {
    return UaHello {
        version: 0, recv_buf: buf_size, send_buf: buf_size, max_msg: 0, max_chunks: 0, url: url, mtype: "HEL", error: 0, reason: "", ok: true
    };
}

/// Encode Hello ("HEL") or Acknowledge ("ACK") per h.mtype, or Error.
pub fn ua_encode_hello(h: &UaHello) -> Vec<i64> {
    var body: Vec<i64> = Vec::new();
    if h.mtype == "ERR" {
        ua_put_u32(&mut body, h.error);
        ua_put_string(&mut body, h.reason);
        return ua_message("ERR", 70, &body);
    }
    ua_put_u32(&mut body, h.version);
    ua_put_u32(&mut body, h.recv_buf);
    ua_put_u32(&mut body, h.send_buf);
    ua_put_u32(&mut body, h.max_msg);
    ua_put_u32(&mut body, h.max_chunks);
    if h.mtype == "HEL" {
        ua_put_string(&mut body, h.url);
    }
    return ua_message(h.mtype, 70, &body);
}

/// Decode a HEL, ACK or ERR message.
pub fn ua_decode_hello(b: Vec<i64>) -> UaHello {
    var h: UaHello = ua_hello("", 0);
    h.ok = false;
    if ua_frame_len(&b) != b.len() || b.len() < 8 {
        return h;
    }
    var mt: str = "";
    var i: i64 = 0;
    while i < 3 {
        mt = mt + char_to_str(b.get(i));
        i = i + 1;
    }
    h.mtype = mt;
    var r: UaReader = ua_reader(b);
    r.pos = 8;
    if mt == "ERR" {
        h.error = ua_get_u32(&mut r);
        h.reason = ua_get_string(&mut r);
    } else if mt == "HEL" || mt == "ACK" {
        h.version = ua_get_u32(&mut r);
        h.recv_buf = ua_get_u32(&mut r);
        h.send_buf = ua_get_u32(&mut r);
        h.max_msg = ua_get_u32(&mut r);
        h.max_chunks = ua_get_u32(&mut r);
        if mt == "HEL" {
            h.url = ua_get_string(&mut r);
        }
        if mt == "ACK" && (h.recv_buf < 8192 || h.send_buf < 8192) {
            return h;  // Part 6: buffers of at least 8192 bytes
        }
    } else {
        return h;
    }
    h.ok = r.ok && r.pos == r.b.len();
    return h;
}

// ─── MSG chunks (SecurityPolicy None) ────────────────────────────────────

/// The chunks of one MSG with body `body`: each at most `max_chunk` bytes
/// (header 8 + security 8 + sequence 8 + part); 'C' then a final 'F'.
/// Sequence numbers start at `seq`.
pub fn ua_msg_chunks(channel: i64, token: i64, seq: i64, request_id: i64, body: &Vec<i64>, max_chunk: i64) -> Vec<Vec<i64>> {
    var out: Vec<Vec<i64>> = Vec::new();
    val room: i64 = max_chunk - 24;
    var pos: i64 = 0;
    var s: i64 = seq;
    loop {
        var part: Vec<i64> = Vec::new();
        ua_put_u32(&mut part, channel);
        ua_put_u32(&mut part, token);
        ua_put_u32(&mut part, s);
        ua_put_u32(&mut part, request_id);
        var n: i64 = 0;
        while n < room && pos < body.len() {
            part.push(body.get(pos));
            pos = pos + 1;
            n = n + 1;
        }
        var chunk: i64 = 67;  // 'C'
        if pos >= body.len() {
            chunk = 70;  // 'F'
        }
        out.push(ua_message("MSG", chunk, &part));
        s = s + 1;
        if chunk == 70 {
            break;
        }
    }
    return out;
}

/// One message joined from its chunks.
pub struct UaMsg {
    pub ok: bool,
    pub error: str,
    pub channel: i64,
    pub token: i64,
    pub first_seq: i64,
    pub request_id: i64,
    pub body: Vec<i64>,
}

/// Join MSG chunks (in order, one request id, consecutive sequence
/// numbers, the last one 'F'). An 'A' chunk aborts the message.
pub fn ua_msg_join(chunks: &Vec<Vec<i64>>) -> UaMsg {
    var m: UaMsg = UaMsg {
        ok: false, error: "", channel: 0, token: 0, first_seq: 0, request_id: 0, body: Vec::new()
    };
    var i: i64 = 0;
    while i < chunks.len() {
        val c: Vec<i64> = chunks.get(i);
        if ua_frame_len(&c) != c.len() || c.len() < 24 || c.get(0) != 77 || c.get(1) != 83 || c.get(2) != 71 {
            m.error = "not a MSG chunk";
            return m;
        }
        var r: UaReader = ua_reader(c);
        r.pos = 8;
        val ch: i64 = ua_get_u32(&mut r);
        val tk: i64 = ua_get_u32(&mut r);
        val sq: i64 = ua_get_u32(&mut r);
        val rid: i64 = ua_get_u32(&mut r);
        if i == 0 {
            m.channel = ch;
            m.token = tk;
            m.first_seq = sq;
            m.request_id = rid;
        } else if ch != m.channel || rid != m.request_id || sq != m.first_seq + i {
            m.error = "chunk of another message or out of sequence";
            return m;
        }
        val kind: i64 = c.get(3);
        if kind == 65 {
            m.error = "message aborted";
            return m;
        }
        var k: i64 = 24;
        while k < c.len() {
            m.body.push(c.get(k));
            k = k + 1;
        }
        if kind == 70 {
            m.ok = i == chunks.len() - 1;
            if !m.ok {
                m.error = "chunks after the final one";
            }
            return m;
        }
        i = i + 1;
    }
    m.error = "no final chunk";
    return m;
}

// ─── Read service ────────────────────────────────────────────────────────

pub struct UaReadRequest {
    pub auth_token: UaNodeId,
    pub timestamp: i64,
    pub handle: i64,
    pub timeout_hint: i64,
    pub max_age: f64,
    pub timestamps: i64,  // 0 source, 1 server, 2 both, 3 neither
    pub nodes: Vec<UaNodeId>,
    pub attrs: Vec<i64>,
    pub ok: bool,
    pub error: str,
}

pub fn ua_read_request(handle: i64, timestamp: i64) -> UaReadRequest {
    return UaReadRequest {
        auth_token: ua_node_num(0, 0), timestamp: timestamp, handle: handle, timeout_hint: 10000, max_age: 0.0, timestamps: 2, nodes: Vec::new(), attrs: Vec::new(), ok: true, error: "",
    };
}

/// Ask for attribute `attr` of `node` (UA_ATTR_VALUE for the value).
pub fn ua_read_add(q: &mut UaReadRequest, node: UaNodeId, attr: i64) {
    q.nodes.push(node);
    q.attrs.push(attr);
}

/// The body of a ReadRequest: its encoding NodeId (i=631) and the request.
pub fn ua_encode_read_request(q: &UaReadRequest) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_READ_REQUEST_ID));
    ua_put_nodeid(&mut out, &q.auth_token);
    ua_put_i64(&mut out, q.timestamp);
    ua_put_u32(&mut out, q.handle);
    ua_put_u32(&mut out, 0);  // returnDiagnostics
    ua_put_null_string(&mut out);  // auditEntryId
    ua_put_u32(&mut out, q.timeout_hint);
    ua_put_empty_extension(&mut out);  // additionalHeader
    ua_put_double(&mut out, q.max_age);
    ua_put_u32(&mut out, q.timestamps);
    ua_put_u32(&mut out, q.nodes.len());
    var i: i64 = 0;
    while i < q.nodes.len() {
        ua_put_nodeid(&mut out, &q.nodes.get(i));
        ua_put_u32(&mut out, q.attrs.get(i));
        ua_put_null_string(&mut out);  // indexRange
        ua_put_qualified_name(&mut out, 0, "");  // dataEncoding
        i = i + 1;
    }
    return out;
}

pub fn ua_decode_read_request(b: Vec<i64>) -> UaReadRequest {
    var q: UaReadRequest = ua_read_request(0, 0);
    var r: UaReader = ua_reader(b);
    val tid: UaNodeId = ua_get_nodeid(&mut r);
    if tid.num != UA_READ_REQUEST_ID || tid.kind != UA_ID_NUMERIC {
        q.ok = false;
        q.error = "not a ReadRequest";
        return q;
    }
    q.auth_token = ua_get_nodeid(&mut r);
    q.timestamp = ua_get_i64(&mut r);
    q.handle = ua_get_u32(&mut r);
    ua_get_u32(&mut r);
    ua_get_string(&mut r);
    q.timeout_hint = ua_get_u32(&mut r);
    ua_skip_extension(&mut r);
    q.max_age = ua_get_double(&mut r);
    q.timestamps = ua_get_u32(&mut r);
    val n: i64 = ua_get_i32(&mut r);
    var i: i64 = 0;
    while i < n && r.ok {
        q.nodes.push(ua_get_nodeid(&mut r));
        q.attrs.push(ua_get_u32(&mut r));
        ua_get_string(&mut r);
        ua_get_u16(&mut r);
        ua_get_string(&mut r);
        i = i + 1;
    }
    q.ok = r.ok && r.pos == r.b.len();
    if !q.ok {
        q.error = r.error;
        if r.ok {
            q.error = "extra bytes";
        }
    }
    return q;
}

pub struct UaReadResponse {
    pub timestamp: i64,
    pub handle: i64,
    pub service_result: i64,
    pub results: Vec<UaDataValue>,
    pub ok: bool,
    pub error: str,
}

pub fn ua_read_response(handle: i64, timestamp: i64) -> UaReadResponse {
    return UaReadResponse {
        timestamp: timestamp, handle: handle, service_result: UA_GOOD, results: Vec::new(), ok: true, error: ""
    };
}

/// The body of a ReadResponse (encoding NodeId i=634).
pub fn ua_encode_read_response(p: &UaReadResponse) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_READ_RESPONSE_ID));
    ua_put_i64(&mut out, p.timestamp);
    ua_put_u32(&mut out, p.handle);
    ua_put_u32(&mut out, p.service_result);
    out.push(0);  // serviceDiagnostics: empty
    ua_put_u32(&mut out, 0);  // stringTable: []
    ua_put_empty_extension(&mut out);
    ua_put_u32(&mut out, p.results.len());
    var i: i64 = 0;
    while i < p.results.len() {
        ua_put_datavalue(&mut out, &p.results.get(i));
        i = i + 1;
    }
    ua_put_u32(&mut out, 0);  // diagnosticInfos: []
    return out;
}

pub fn ua_decode_read_response(b: Vec<i64>) -> UaReadResponse {
    var p: UaReadResponse = ua_read_response(0, 0);
    var r: UaReader = ua_reader(b);
    val tid: UaNodeId = ua_get_nodeid(&mut r);
    if tid.num != UA_READ_RESPONSE_ID || tid.kind != UA_ID_NUMERIC {
        p.ok = false;
        p.error = "not a ReadResponse";
        return p;
    }
    p.timestamp = ua_get_i64(&mut r);
    p.handle = ua_get_u32(&mut r);
    p.service_result = ua_get_u32(&mut r);
    ua_skip_diagnostic(&mut r, 0);
    val ns: i64 = ua_get_i32(&mut r);
    var i: i64 = 0;
    while i < ns && r.ok {
        ua_get_string(&mut r);
        i = i + 1;
    }
    ua_skip_extension(&mut r);
    val n: i64 = ua_get_i32(&mut r);
    i = 0;
    while i < n && r.ok {
        p.results.push(ua_get_datavalue(&mut r));
        i = i + 1;
    }
    val nd: i64 = ua_get_i32(&mut r);
    i = 0;
    while i < nd && r.ok {
        ua_skip_diagnostic(&mut r, 0);
        i = i + 1;
    }
    p.ok = r.ok && r.pos == r.b.len();
    if !p.ok {
        p.error = r.error;
    }
    return p;
}

// ─── Security policies ───────────────────────────────────────────────────

pub const UA_POLICY_NONE: str = "http://opcfoundation.org/UA/SecurityPolicy#None";
pub const UA_POLICY_BASIC256SHA256: str = "http://opcfoundation.org/UA/SecurityPolicy#Basic256Sha256";
pub const UA_ALG_RSA_OAEP: str = "http://www.w3.org/2001/04/xmlenc#rsa-oaep";
pub const UA_ALG_RSA_SHA256: str = "http://www.w3.org/2001/04/xmldsig-more#rsa-sha256";

// MessageSecurityMode
pub const UA_MODE_NONE: i64 = 1;
pub const UA_MODE_SIGN: i64 = 2;
pub const UA_MODE_SIGN_ENCRYPT: i64 = 3;

// encoding ids of the services (DefaultBinary)
pub const UA_OPN_REQUEST_ID: i64 = 446;
pub const UA_OPN_RESPONSE_ID: i64 = 449;
pub const UA_CLO_REQUEST_ID: i64 = 452;
pub const UA_SERVICE_FAULT_ID: i64 = 397;
pub const UA_CREATE_SESSION_REQUEST_ID: i64 = 461;
pub const UA_CREATE_SESSION_RESPONSE_ID: i64 = 464;
pub const UA_ACTIVATE_SESSION_REQUEST_ID: i64 = 467;
pub const UA_ACTIVATE_SESSION_RESPONSE_ID: i64 = 470;
pub const UA_CLOSE_SESSION_REQUEST_ID: i64 = 473;
pub const UA_CLOSE_SESSION_RESPONSE_ID: i64 = 476;
pub const UA_ANONYMOUS_TOKEN_ID: i64 = 321;
pub const UA_USERNAME_TOKEN_ID: i64 = 324;

// UserTokenType
pub const UA_TOKEN_ANONYMOUS: i64 = 0;
pub const UA_TOKEN_USERNAME: i64 = 1;

// status codes
pub const UA_BAD_SECURITY_CHECKS_FAILED: i64 = 0x80130000;
pub const UA_BAD_USER_ACCESS_DENIED: i64 = 0x801F0000;
pub const UA_BAD_IDENTITY_TOKEN_INVALID: i64 = 0x80200000;
pub const UA_BAD_IDENTITY_TOKEN_REJECTED: i64 = 0x80210000;
pub const UA_BAD_SESSION_ID_INVALID: i64 = 0x80250000;

fn ua_cat(a: &Vec<i64>, b: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        out.push(a.get(i));
        i = i + 1;
    }
    i = 0;
    while i < b.len() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}

fn ua_sub(a: &Vec<i64>, from: i64, to: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = from;
    while i < to && i < a.len() {
        out.push(a.get(i));
        i = i + 1;
    }
    return out;
}

fn ua_same(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var diff: i64 = 0;
    var i: i64 = 0;
    while i < a.len() {
        diff = diff | (a.get(i) ^ b.get(i));
        i = i + 1;
    }
    return diff == 0;
}

// ─── Key derivation (Part 6 6.7.5) ───────────────────────────────────────

/// P_SHA256(secret, seed) (RFC 5246 5): HMAC-SHA256(secret, A(i) + seed)
/// with A(0) = seed, A(i) = HMAC-SHA256(secret, A(i-1)), `len` bytes.
pub fn ua_p_sha256(secret: Vec<i64>, seed: Vec<i64>, len: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var a: Vec<i64> = seed;
    while out.len() < len {
        a = kdf_hmac_sha256(secret, a);
        val block: Vec<i64> = kdf_hmac_sha256(secret, ua_cat(&a, &seed));
        var i: i64 = 0;
        while i < block.len() && out.len() < len {
            out.push(block.get(i));
            i = i + 1;
        }
    }
    return out;
}

/// The symmetric keys of one direction of a channel.
pub struct UaKeys {
    pub sign: Vec<i64>,  // HMAC-SHA256 key, 32 bytes
    pub enc: Vec<i64>,  // AES-256 key, 32 bytes
    pub iv: Vec<i64>,  // AES-CBC IV, 16 bytes
}

/// The RsaPrivateKey of a channel end without one (SecurityPolicy None).
pub fn ua_no_private_key() -> RsaPrivateKey {
    return rsa_private_from_der(Vec::new());
}

pub fn ua_no_keys() -> UaKeys {
    return UaKeys {
        sign: Vec::new(), enc: Vec::new(), iv: Vec::new()
    };
}

/// Basic256Sha256 keys: P_SHA256(secret, seed) split 32 / 32 / 16. The
/// client's keys are ua_derive_keys(serverNonce, clientNonce), the
/// server's ua_derive_keys(clientNonce, serverNonce).
pub fn ua_derive_keys(secret: Vec<i64>, seed: Vec<i64>) -> UaKeys {
    val m: Vec<i64> = ua_p_sha256(secret, seed, 80);
    return UaKeys {
        sign: ua_sub(&m, 0, 32), enc: ua_sub(&m, 32, 64), iv: ua_sub(&m, 64, 80)
    };
}

// ─── AES-256-CBC ─────────────────────────────────────────────────────────
// Encryption runs aes_gcm's block cipher; decryption (the inverse cipher
// of FIPS 197 5.3) is written here with its own key schedule.

fn ua_xtime(a: i64) -> i64 {
    return ((a << 1) ^ (((a >> 7) & 1) * 27)) & 255;
}

fn ua_gmul(a_in: i64, b_in: i64) -> i64 {
    var a: i64 = a_in;
    var b: i64 = b_in;
    var p: i64 = 0;
    while b != 0 {
        if (b & 1) != 0 {
            p = p ^ a;
        }
        a = ua_xtime(a);
        b = b >> 1;
    }
    return p;
}

fn ua_rotl8(x: i64, n: i64) -> i64 {
    return ((x << n) | (x >> (8 - n))) & 255;
}

/// The S-box (entries 0..255) and its inverse (256..511), generated from
/// the multiplicative group (powers of 3) and the affine map.
pub fn ua_aes_tables() -> Vec<i64> {
    var t: Vec<i64> = Vec::filled(512, 0);
    var p: i64 = 1;
    var q: i64 = 1;
    loop {
        p = (p ^ ua_xtime(p)) & 255;  // p * 3
        q = q ^ ((q << 1) & 255);  // q / 3
        q = q ^ ((q << 2) & 255);
        q = q ^ ((q << 4) & 255);
        if (q & 128) != 0 {
            q = q ^ 9;
        }
        val x: i64 = q ^ ua_rotl8(q, 1) ^ ua_rotl8(q, 2) ^ ua_rotl8(q, 3) ^ ua_rotl8(q, 4) ^ 99;
        t.set(p, x);
        t.set(256 + x, p);
        if p == 1 {
            break;
        }
    }
    t.set(0, 99);
    t.set(256 + 99, 0);
    return t;
}

/// Round keys as bytes, 16 per round (FIPS 197 5.2); empty for a key that
/// is not 16, 24 or 32 bytes.
pub fn ua_aes_round_keys(key: &Vec<i64>, tab: &Vec<i64>) -> Vec<i64> {
    var w: Vec<i64> = Vec::new();
    val nk: i64 = key.len() / 4;
    if key.len() != 16 && key.len() != 24 && key.len() != 32 {
        return w;
    }
    val nr: i64 = nk + 6;
    var i: i64 = 0;
    while i < key.len() {
        w.push(key.get(i) & 255);
        i = i + 1;
    }
    var rcon: i64 = 1;
    var word: i64 = nk;
    while word < 4 * (nr + 1) {
        var t0: i64 = w.get(4 * word - 4);
        var t1: i64 = w.get(4 * word - 3);
        var t2: i64 = w.get(4 * word - 2);
        var t3: i64 = w.get(4 * word - 1);
        if word % nk == 0 {
            val r0: i64 = t0;
            t0 = tab.get(t1) ^ rcon;
            t1 = tab.get(t2);
            t2 = tab.get(t3);
            t3 = tab.get(r0);
            rcon = ua_xtime(rcon);
        } else if nk > 6 && word % nk == 4 {
            t0 = tab.get(t0);
            t1 = tab.get(t1);
            t2 = tab.get(t2);
            t3 = tab.get(t3);
        }
        val b: i64 = 4 * (word - nk);
        w.push(w.get(b) ^ t0);
        w.push(w.get(b + 1) ^ t1);
        w.push(w.get(b + 2) ^ t2);
        w.push(w.get(b + 3) ^ t3);
        word = word + 1;
    }
    return w;
}

/// Decrypt one 16-byte block with round keys `rk` (FIPS 197 5.3).
pub fn ua_aes_decrypt_block(rk: &Vec<i64>, tab: &Vec<i64>, blk: &Vec<i64>) -> Vec<i64> {
    val nr: i64 = rk.len() / 16 - 1;
    var s: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 16 {
        s.push((blk.get(i) & 255) ^ rk.get(16 * nr + i));
        i = i + 1;
    }
    var round: i64 = nr - 1;
    while round >= 0 {
        // InvShiftRows and InvSubBytes
        var t: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < 16 {
            val r: i64 = k & 3;
            val c: i64 = k >> 2;
            t.push(tab.get(256 + s.get(r + 4 * ((c - r + 4) & 3))));
            k = k + 1;
        }
        // AddRoundKey
        k = 0;
        while k < 16 {
            t.set(k, t.get(k) ^ rk.get(16 * round + k));
            k = k + 1;
        }
        if round > 0 {
            // InvMixColumns
            var c: i64 = 0;
            while c < 4 {
                val a0: i64 = t.get(4 * c);
                val a1: i64 = t.get(4 * c + 1);
                val a2: i64 = t.get(4 * c + 2);
                val a3: i64 = t.get(4 * c + 3);
                t.set(4 * c, ua_gmul(a0, 14) ^ ua_gmul(a1, 11) ^ ua_gmul(a2, 13) ^ ua_gmul(a3, 9));
                t.set(4 * c + 1, ua_gmul(a0, 9) ^ ua_gmul(a1, 14) ^ ua_gmul(a2, 11) ^ ua_gmul(a3, 13));
                t.set(4 * c + 2, ua_gmul(a0, 13) ^ ua_gmul(a1, 9) ^ ua_gmul(a2, 14) ^ ua_gmul(a3, 11));
                t.set(4 * c + 3, ua_gmul(a0, 11) ^ ua_gmul(a1, 13) ^ ua_gmul(a2, 9) ^ ua_gmul(a3, 14));
                c = c + 1;
            }
        }
        s = t;
        round = round - 1;
    }
    return s;
}

/// AES-CBC encryption of whole blocks (no padding added here).
pub fn ua_aes_cbc_encrypt(key: &Vec<i64>, iv: &Vec<i64>, data: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var prev: Vec<i64> = ua_sub(iv, 0, 16);
    var k: Vec<i64> = ua_sub(key, 0, key.len());
    var off: i64 = 0;
    while off + 16 <= data.len() {
        var x: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < 16 {
            x.push((data.get(off + i) ^ prev.get(i)) & 255);
            i = i + 1;
        }
        prev = aes_ecb_encrypt(k, x);
        i = 0;
        while i < 16 {
            out.push(prev.get(i));
            i = i + 1;
        }
        off = off + 16;
    }
    return out;
}

pub fn ua_aes_cbc_decrypt(key: &Vec<i64>, iv: &Vec<i64>, data: &Vec<i64>) -> Vec<i64> {
    val tab: Vec<i64> = ua_aes_tables();
    val rk: Vec<i64> = ua_aes_round_keys(key, &tab);
    var out: Vec<i64> = Vec::new();
    var prev: Vec<i64> = ua_sub(iv, 0, 16);
    var off: i64 = 0;
    while off + 16 <= data.len() {
        val c: Vec<i64> = ua_sub(data, off, off + 16);
        val p: Vec<i64> = ua_aes_decrypt_block(&rk, &tab, &c);
        var i: i64 = 0;
        while i < 16 {
            out.push(p.get(i) ^ prev.get(i));
            i = i + 1;
        }
        prev = c;
        off = off + 16;
    }
    return out;
}

// ─── Randomness ──────────────────────────────────────────────────────────

/// The channel's random generator: HMAC-SHA256(key, counter) blocks. The
/// seam: the caller seeds it (crypto_random_bytes(32) in real use, a
/// fixed seed in tests); nonces and OAEP seeds come from it.
pub struct UaRng {
    pub key: Vec<i64>,
    pub ctr: i64,
}

pub fn ua_rng(seed: Vec<i64>) -> UaRng {
    return UaRng {
        key: kdf_hmac_sha256(seed, str_bytes("fides opcua rng")), ctr: 0
    };
}

pub fn ua_rng_bytes(g: &mut UaRng, n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    while out.len() < n {
        var c: Vec<i64> = Vec::new();
        ua_put_i64(&mut c, g.ctr);
        g.ctr = g.ctr + 1;
        val b: Vec<i64> = kdf_hmac_sha256(g.key, c);
        var i: i64 = 0;
        while i < b.len() && out.len() < n {
            out.push(b.get(i));
            i = i + 1;
        }
    }
    return out;
}

// ─── Request and response headers ────────────────────────────────────────

pub struct UaRequestHeader {
    pub auth: UaNodeId,
    pub timestamp: i64,
    pub handle: i64,
    pub timeout: i64,
}

pub fn ua_request_header(auth: UaNodeId, timestamp: i64, handle: i64) -> UaRequestHeader {
    return UaRequestHeader {
        auth: auth, timestamp: timestamp, handle: handle, timeout: 10000
    };
}

pub fn ua_put_request_header(out: &mut Vec<i64>, h: &UaRequestHeader) {
    ua_put_nodeid(out, &h.auth);
    ua_put_i64(out, h.timestamp);
    ua_put_u32(out, h.handle);
    ua_put_u32(out, 0);  // returnDiagnostics
    ua_put_null_string(out);  // auditEntryId
    ua_put_u32(out, h.timeout);
    ua_put_empty_extension(out);  // additionalHeader
}

pub fn ua_get_request_header(r: &mut UaReader) -> UaRequestHeader {
    val auth: UaNodeId = ua_get_nodeid(r);
    val ts: i64 = ua_get_i64(r);
    val handle: i64 = ua_get_u32(r);
    ua_get_u32(r);
    ua_get_string(r);
    val timeout: i64 = ua_get_u32(r);
    ua_skip_extension(r);
    return UaRequestHeader {
        auth: auth, timestamp: ts, handle: handle, timeout: timeout
    };
}

pub struct UaResponseHeader {
    pub timestamp: i64,
    pub handle: i64,
    pub result: i64,
}

pub fn ua_put_response_header(out: &mut Vec<i64>, h: &UaResponseHeader) {
    ua_put_i64(out, h.timestamp);
    ua_put_u32(out, h.handle);
    ua_put_u32(out, h.result);
    out.push(0);  // serviceDiagnostics
    ua_put_u32(out, 0);  // stringTable
    ua_put_empty_extension(out);
}

pub fn ua_get_response_header(r: &mut UaReader) -> UaResponseHeader {
    val ts: i64 = ua_get_i64(r);
    val handle: i64 = ua_get_u32(r);
    val result: i64 = ua_get_u32(r);
    ua_skip_diagnostic(r, 0);
    val n: i64 = ua_get_i32(r);
    var i: i64 = 0;
    while i < n && r.ok {
        ua_get_string(r);
        i = i + 1;
    }
    ua_skip_extension(r);
    return UaResponseHeader {
        timestamp: ts, handle: handle, result: result
    };
}

/// The numeric encoding id at the start of a service body (-1 if none).
pub fn ua_body_type(b: &Vec<i64>) -> i64 {
    var r: UaReader = ua_reader(ua_sub(b, 0, 8));
    val n: UaNodeId = ua_get_nodeid(&mut r);
    if !r.ok || n.kind != UA_ID_NUMERIC || n.ns != 0 {
        return -1;
    }
    return n.num;
}

fn ua_finish(r: &UaReader) -> str {
    if !r.ok {
        return r.error;
    }
    if r.pos != r.b.len() {
        return "extra bytes after the body";
    }
    return "";
}

/// A ServiceFault (the response to a request a server refuses).
pub fn ua_encode_service_fault(h: &UaResponseHeader) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_SERVICE_FAULT_ID));
    ua_put_response_header(&mut out, h);
    return out;
}

// ─── OpenSecureChannel, CloseSecureChannel ───────────────────────────────

pub struct UaOpnRequest {
    pub hdr: UaRequestHeader,
    pub renew: bool,  // RequestType Renew (else Issue)
    pub mode: i64,
    pub nonce: Vec<i64>,
    pub lifetime: i64,  // requested, ms
    pub error: str,
}

pub fn ua_encode_opn_request(q: &UaOpnRequest) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_OPN_REQUEST_ID));
    ua_put_request_header(&mut out, &q.hdr);
    ua_put_u32(&mut out, 0);  // ClientProtocolVersion
    if q.renew {
        ua_put_u32(&mut out, 1);
    } else {
        ua_put_u32(&mut out, 0);
    }
    ua_put_u32(&mut out, q.mode);
    ua_put_bytestring(&mut out, &q.nonce);
    ua_put_u32(&mut out, q.lifetime);
    return out;
}

pub fn ua_decode_opn_request(b: Vec<i64>) -> UaOpnRequest {
    var r: UaReader = ua_reader(b);
    var q: UaOpnRequest = UaOpnRequest {
        hdr: ua_request_header(ua_node_num(0, 0), 0, 0), renew: false, mode: 0, nonce: Vec::new(), lifetime: 0, error: ""
    };
    if ua_get_nodeid(&mut r).num != UA_OPN_REQUEST_ID {
        q.error = "not an OpenSecureChannelRequest";
        return q;
    }
    q.hdr = ua_get_request_header(&mut r);
    ua_get_u32(&mut r);
    q.renew = ua_get_u32(&mut r) == 1;
    q.mode = ua_get_u32(&mut r);
    q.nonce = ua_get_bytestring(&mut r);
    q.lifetime = ua_get_u32(&mut r);
    q.error = ua_finish(&r);
    return q;
}

pub struct UaOpnResponse {
    pub hdr: UaResponseHeader,
    pub channel_id: i64,
    pub token_id: i64,
    pub created_at: i64,
    pub lifetime: i64,  // revised, ms
    pub nonce: Vec<i64>,
    pub error: str,
}

pub fn ua_encode_opn_response(p: &UaOpnResponse) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_OPN_RESPONSE_ID));
    ua_put_response_header(&mut out, &p.hdr);
    ua_put_u32(&mut out, 0);  // ServerProtocolVersion
    ua_put_u32(&mut out, p.channel_id);
    ua_put_u32(&mut out, p.token_id);
    ua_put_i64(&mut out, p.created_at);
    ua_put_u32(&mut out, p.lifetime);
    ua_put_bytestring(&mut out, &p.nonce);
    return out;
}

pub fn ua_decode_opn_response(b: Vec<i64>) -> UaOpnResponse {
    var r: UaReader = ua_reader(b);
    var p: UaOpnResponse = UaOpnResponse {
        hdr: UaResponseHeader {
            timestamp: 0, handle: 0, result: 0
        }, channel_id: 0, token_id: 0, created_at: 0, lifetime: 0, nonce: Vec::new(), error: ""
    };
    if ua_get_nodeid(&mut r).num != UA_OPN_RESPONSE_ID {
        p.error = "not an OpenSecureChannelResponse";
        return p;
    }
    p.hdr = ua_get_response_header(&mut r);
    ua_get_u32(&mut r);
    p.channel_id = ua_get_u32(&mut r);
    p.token_id = ua_get_u32(&mut r);
    p.created_at = ua_get_i64(&mut r);
    p.lifetime = ua_get_u32(&mut r);
    p.nonce = ua_get_bytestring(&mut r);
    p.error = ua_finish(&r);
    return p;
}

/// The body of a CloseSecureChannelRequest (sent as a CLO message).
pub fn ua_encode_clo_request(h: &UaRequestHeader) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_CLO_REQUEST_ID));
    ua_put_request_header(&mut out, h);
    return out;
}

// ─── Secure channel ──────────────────────────────────────────────────────

/// One end of a secure channel. Tokens: `token_id` with send_keys /
/// recv_keys is current; `old_token` (receive only) is the one a renewal
/// replaced; a server keeps a renewed token in `next_*` until the client
/// first uses it (Part 4 5.5.2: the server switches then).
pub struct UaChannel {
    pub is_client: bool,
    pub policy: str,
    pub mode: i64,
    pub own_cert: Vec<i64>,
    pub own_key: RsaPrivateKey,
    pub peer_cert: Vec<i64>,
    pub peer_key: RsaPublicKey,
    pub rng: UaRng,
    pub channel_id: i64,
    pub token_id: i64,
    pub send_keys: UaKeys,
    pub recv_keys: UaKeys,
    pub old_token: i64,
    pub old_recv: UaKeys,
    pub next_token: i64,
    pub next_send: UaKeys,
    pub next_recv: UaKeys,
    pub local_nonce: Vec<i64>,
    pub remote_nonce: Vec<i64>,
    pub send_seq: i64,
    pub recv_seq: i64,  // -1 before the first message
    pub lifetime: i64,
    pub created: i64,  // caller's clock (ms) when the token was issued
}

/// A channel end. `own_key` / certificates may be empty for
/// SecurityPolicy None; a server learns the client certificate from the
/// first OpenSecureChannel request (and should check it against its trust
/// list: the caller's decision, after ua_opn_open).
pub fn ua_channel(is_client: bool, policy: str, mode: i64, own_cert: Vec<i64>, own_key: RsaPrivateKey, peer_cert: Vec<i64>, rng_seed: Vec<i64>) -> UaChannel {
    var c: UaChannel = UaChannel {
        is_client: is_client, policy: policy, mode: mode, own_cert: own_cert, own_key: own_key, peer_cert: Vec::new(), peer_key: rsa_public_from_der(Vec::new()), rng: ua_rng(rng_seed), channel_id: 0, token_id: 0, send_keys: ua_no_keys(), recv_keys: ua_no_keys(), old_token: -1, old_recv: ua_no_keys(), next_token: -1, next_send: ua_no_keys(), next_recv: ua_no_keys(), local_nonce: Vec::new(), remote_nonce: Vec::new(), send_seq: 1, recv_seq: -1, lifetime: 0, created: 0,
    };
    if peer_cert.len() > 0 {
        ua_channel_set_peer(&mut c, peer_cert);
    }
    return c;
}

/// The RSA public key of a DER certificate.
pub fn ua_cert_public_key(der: Vec<i64>) -> RsaPublicKey {
    val c: X509Cert = x509_parse(der);
    if !c.ok {
        return rsa_public_from_der(Vec::new());
    }
    return rsa_public_from_der(c.spki.key);
}

pub fn ua_channel_set_peer(c: &mut UaChannel, cert: Vec<i64>) {
    c.peer_cert = cert;
    c.peer_key = ua_cert_public_key(c.peer_cert);
}

/// SHA-1 of a DER certificate (the thumbprint OPC UA puts in headers).
pub fn ua_thumbprint(cert: &Vec<i64>) -> Vec<i64> {
    return kdf_sha1(ua_sub(cert, 0, cert.len()));
}

fn ua_secured(c: &UaChannel) -> bool {
    return c.policy != UA_POLICY_NONE && c.mode != UA_MODE_NONE;
}

/// A new nonce for an OpenSecureChannel request or response (32 bytes;
/// empty for SecurityPolicy None).
pub fn ua_channel_nonce(c: &mut UaChannel) -> Vec<i64> {
    if !ua_secured(c) {
        c.local_nonce = Vec::new();
    } else {
        c.local_nonce = ua_rng_bytes(&mut c.rng, 32);
    }
    return c.local_nonce;
}

/// The keys of token `token` from the two nonces: send = P(remote, local),
/// recv = P(local, remote) for both ends.
fn ua_token_keys(c: &UaChannel) -> UaKeys {
    return ua_derive_keys(c.remote_nonce, c.local_nonce);
}

fn ua_token_keys_recv(c: &UaChannel) -> UaKeys {
    return ua_derive_keys(c.local_nonce, c.remote_nonce);
}

/// Client: install the token of an OpenSecureChannel response (the old
/// one stays valid for receiving).
pub fn ua_channel_install(c: &mut UaChannel, p: &UaOpnResponse, now: i64) {
    c.remote_nonce = p.nonce;
    if c.token_id != 0 {
        c.old_token = c.token_id;
        c.old_recv = c.recv_keys;
    }
    c.channel_id = p.channel_id;
    c.token_id = p.token_id;
    c.lifetime = p.lifetime;
    c.created = now;
    if ua_secured(c) {
        c.send_keys = ua_token_keys(c);
        c.recv_keys = ua_token_keys_recv(c);
    }
}

/// Server: issue (renew false) or renew a token from the client's nonce:
/// returns the response to send. A first token is current at once; a
/// renewed one waits in next_* until the client uses it.
pub fn ua_channel_issue(c: &mut UaChannel, q: &UaOpnRequest, channel_id: i64, now: i64, lifetime: i64) -> UaOpnResponse {
    c.remote_nonce = q.nonce;
    ua_channel_nonce(c);
    var token: i64 = c.token_id + 1;
    if c.next_token > 0 {
        token = c.next_token + 1;
    }
    if !q.renew {
        c.channel_id = channel_id;
        c.token_id = token;
        if ua_secured(c) {
            c.send_keys = ua_token_keys(c);
            c.recv_keys = ua_token_keys_recv(c);
        }
    } else {
        c.next_token = token;
        if ua_secured(c) {
            c.next_send = ua_token_keys(c);
            c.next_recv = ua_token_keys_recv(c);
        }
    }
    c.lifetime = lifetime;
    c.created = now;
    return UaOpnResponse {
        hdr: UaResponseHeader {
            timestamp: ua_datetime_from_unix_ms(now), handle: q.hdr.handle, result: UA_GOOD
        }, channel_id: c.channel_id, token_id: token, created_at: ua_datetime_from_unix_ms(now), lifetime: lifetime, nonce: c.local_nonce, error: "",
    };
}

/// A message opened from the wire.
pub struct UaOpened {
    pub ok: bool,
    pub error: str,
    pub mtype: str,  // "OPN", "MSG", "CLO"
    pub channel_id: i64,
    pub token_id: i64,
    pub policy: str,  // OPN: the sender's SecurityPolicyUri
    pub sender_cert: Vec<i64>,
    pub seq: i64,
    pub request_id: i64,
    pub body: Vec<i64>,
}

fn ua_opened_fail(why: str) -> UaOpened {
    return UaOpened {
        ok: false, error: why, mtype: "", channel_id: 0, token_id: 0, policy: "", sender_cert: Vec::new(), seq: 0, request_id: 0, body: Vec::new()
    };
}

/// The 3-letter type of a message.
pub fn ua_message_type(b: &Vec<i64>) -> str {
    if b.len() < 4 {
        return "";
    }
    return char_to_str(b.get(0)) + char_to_str(b.get(1)) + char_to_str(b.get(2));
}

fn ua_check_seq(c: &mut UaChannel, seq: i64) -> bool {
    if c.recv_seq >= 0 {
        val wrap: bool = c.recv_seq > 4294966271 && seq < 1024;
        if seq != c.recv_seq + 1 && !wrap {
            return false;
        }
    }
    c.recv_seq = seq;
    return true;
}

fn ua_next_seq(c: &mut UaChannel) -> i64 {
    val s: i64 = c.send_seq;
    c.send_seq = c.send_seq + 1;
    if c.send_seq > 4294966271 {
        c.send_seq = 1;  // wrap below 1024 (Part 6 6.7.2.4)
    }
    return s;
}

/// The size field of a message header written over bytes 4..8.
fn ua_set_size(m: &mut Vec<i64>, size: i64) {
    m.set(4, size & 255);
    m.set(5, (size >> 8) & 255);
    m.set(6, (size >> 16) & 255);
    m.set(7, (size >> 24) & 255);
}

/// An OPN message with asymmetric security (Part 6 6.7.2): the
/// asymmetric security header (policy URI, the sender's certificate, the
/// receiver's thumbprint), then sequence header, body, padding and an
/// RSA-PKCS1-v1.5-SHA256 signature, RSA-OAEP-SHA1 encrypted for the
/// receiver in blocks of k - 42 bytes. SecurityPolicy None: in clear.
/// Empty if the keys are missing or larger than 2048 bits.
pub fn ua_opn_seal(c: &mut UaChannel, request_id: i64, body: &Vec<i64>) -> Vec<i64> {
    var m: Vec<i64> = Vec::new();
    m.push(79);
    m.push(80);
    m.push(78);
    m.push(70);  // "OPNF"
    ua_put_u32(&mut m, 0);
    ua_put_u32(&mut m, c.channel_id);
    ua_put_string(&mut m, c.policy);
    val sec: bool = c.policy != UA_POLICY_NONE;
    if sec {
        ua_put_bytestring(&mut m, &c.own_cert);
        ua_put_bytestring(&mut m, &ua_thumbprint(&c.peer_cert));
    } else {
        ua_put_null_string(&mut m);
        ua_put_null_string(&mut m);
    }
    var plain: Vec<i64> = Vec::new();
    ua_put_u32(&mut plain, ua_next_seq(c));
    ua_put_u32(&mut plain, request_id);
    var i: i64 = 0;
    while i < body.len() {
        plain.push(body.get(i));
        i = i + 1;
    }
    if !sec {
        m = ua_cat(&m, &plain);
        ua_set_size(&mut m, m.len());
        return m;
    }
    val sig_len: i64 = c.own_key.k;
    val k: i64 = c.peer_key.k;
    if !c.own_key.ok || !c.peer_key.ok || k > 256 {
        return Vec::new();
    }
    val blk: i64 = k - 42;
    val pad: i64 = (blk - ((plain.len() + 1 + sig_len) % blk)) % blk;
    i = 0;
    while i <= pad {
        plain.push(pad);
        i = i + 1;
    }
    val nblocks: i64 = (plain.len() + sig_len) / blk;
    ua_set_size(&mut m, m.len() + nblocks * k);
    val sig: Vec<i64> = rsa_pkcs1_sign(c.own_key, KDF_SHA256, ua_cat(&m, &plain));
    val data: Vec<i64> = ua_cat(&plain, &sig);
    var off: i64 = 0;
    while off < data.len() {
        val seed: Vec<i64> = ua_rng_bytes(&mut c.rng, 20);
        val ct: Vec<i64> = rsa_oaep_encrypt(c.peer_key, KDF_SHA1, ua_sub(&data, off, off + blk), Vec::new(), seed);
        m = ua_cat(&m, &ct);
        off = off + blk;
    }
    return m;
}

/// Open an OPN message: check the policy and the thumbprint of our
/// certificate, decrypt, verify the sender's signature (a server takes the
/// sender certificate as its peer on the first request), check padding
/// and sequence number.
pub fn ua_opn_open(c: &mut UaChannel, msg: Vec<i64>) -> UaOpened {
    if ua_frame_len(&msg) != msg.len() || ua_message_type(&msg) != "OPN" || msg.get(3) != 70 {
        return ua_opened_fail("not an OPN message");
    }
    var r: UaReader = ua_reader(msg);
    r.pos = 8;
    val chan: i64 = ua_get_u32(&mut r);
    val policy: str = ua_get_string(&mut r);
    val cert: Vec<i64> = ua_get_bytestring(&mut r);
    val thumb: Vec<i64> = ua_get_bytestring(&mut r);
    if !r.ok {
        return ua_opened_fail(r.error);
    }
    if policy != c.policy {
        return ua_opened_fail("SecurityPolicy " + policy + " not offered");
    }
    val head: Vec<i64> = ua_sub(&r.b, 0, r.pos);
    var plain: Vec<i64> = ua_sub(&r.b, r.pos, r.b.len());
    if policy != UA_POLICY_NONE {
        if !ua_same(&thumb, &ua_thumbprint(&c.own_cert)) {
            return ua_opened_fail("receiver thumbprint is not ours");
        }
        if c.peer_cert.len() == 0 {
            ua_channel_set_peer(c, cert);
        } else if !ua_same(&cert, &c.peer_cert) {
            return ua_opened_fail("sender certificate changed");
        }
        if !c.peer_key.ok {
            return ua_opened_fail("no RSA key in the sender certificate");
        }
        val k: i64 = c.own_key.k;
        if plain.len() % k != 0 || plain.len() == 0 {
            return ua_opened_fail("ciphertext is not whole RSA blocks");
        }
        var dec: Vec<i64> = Vec::new();
        var off: i64 = 0;
        while off < plain.len() {
            val p: RsaPlain = rsa_oaep_decrypt(c.own_key, KDF_SHA1, ua_sub(&plain, off, off + k), Vec::new());
            if !p.ok {
                return ua_opened_fail("RSA-OAEP decryption failed");
            }
            dec = ua_cat(&dec, &p.data);
            off = off + k;
        }
        val sl: i64 = c.peer_key.k;
        if dec.len() < 9 + sl {
            return ua_opened_fail("message too short");
        }
        val signed: Vec<i64> = ua_cat(&head, &ua_sub(&dec, 0, dec.len() - sl));
        if !rsa_pkcs1_verify(c.peer_key, KDF_SHA256, signed, ua_sub(&dec, dec.len() - sl, dec.len())) {
            return ua_opened_fail("signature does not verify");
        }
        val pad: i64 = dec.get(dec.len() - sl - 1);
        val end: i64 = dec.len() - sl - 1 - pad;
        if end < 8 {
            return ua_opened_fail("bad padding");
        }
        var i: i64 = end;
        while i < dec.len() - sl {
            if dec.get(i) != pad {
                return ua_opened_fail("bad padding");
            }
            i = i + 1;
        }
        plain = ua_sub(&dec, 0, end);
    }
    if plain.len() < 8 {
        return ua_opened_fail("no sequence header");
    }
    var sr: UaReader = ua_reader(plain);
    val seq: i64 = ua_get_u32(&mut sr);
    val rid: i64 = ua_get_u32(&mut sr);
    if !ua_check_seq(c, seq) {
        return ua_opened_fail("sequence number " + int_to_str(seq) + " out of order");
    }
    return UaOpened {
        ok: true, error: "", mtype: "OPN", channel_id: chan, token_id: 0, policy: policy, sender_cert: cert, seq: seq, request_id: rid, body: ua_sub(&sr.b, 8, sr.b.len())
    };
}

/// The chunks of a MSG or CLO message with symmetric security (Part 6
/// 6.7.2): HMAC-SHA256 signature with the current send keys, and in mode
/// SignAndEncrypt padding and AES-256-CBC. Each chunk is at most
/// `max_chunk` bytes. Mode None / policy None: plain chunks.
pub fn ua_sym_seal(c: &mut UaChannel, mtype: str, request_id: i64, body: &Vec<i64>, max_chunk: i64) -> Vec<Vec<i64>> {
    var out: Vec<Vec<i64>> = Vec::new();
    val sec: bool = ua_secured(c);
    val enc: bool = sec && c.mode == UA_MODE_SIGN_ENCRYPT;
    var sig_len: i64 = 0;
    if sec {
        sig_len = 32;
    }
    var room: i64 = max_chunk - 16 - 8 - sig_len;
    if enc {
        room = ((max_chunk - 16) / 16) * 16 - 8 - sig_len - 1;
    }
    var pos: i64 = 0;
    loop {
        var plain: Vec<i64> = Vec::new();
        ua_put_u32(&mut plain, ua_next_seq(c));
        ua_put_u32(&mut plain, request_id);
        var n: i64 = 0;
        while n < room && pos < body.len() {
            plain.push(body.get(pos));
            pos = pos + 1;
            n = n + 1;
        }
        var kind: i64 = 67;  // 'C'
        if pos >= body.len() {
            kind = 70;  // 'F'
        }
        if enc {
            val pad: i64 = (16 - ((plain.len() + 1 + sig_len) % 16)) % 16;
            var i: i64 = 0;
            while i <= pad {
                plain.push(pad);
                i = i + 1;
            }
        }
        var m: Vec<i64> = Vec::new();
        m.push(str_byte_at(mtype, 0));
        m.push(str_byte_at(mtype, 1));
        m.push(str_byte_at(mtype, 2));
        m.push(kind);
        ua_put_u32(&mut m, 16 + plain.len() + sig_len);
        ua_put_u32(&mut m, c.channel_id);
        ua_put_u32(&mut m, c.token_id);
        if sec {
            val mac: Vec<i64> = kdf_hmac_sha256(c.send_keys.sign, ua_cat(&m, &plain));
            val tail: Vec<i64> = ua_cat(&plain, &mac);
            if enc {
                m = ua_cat(&m, &ua_aes_cbc_encrypt(&c.send_keys.enc, &c.send_keys.iv, &tail));
            } else {
                m = ua_cat(&m, &tail);
            }
        } else {
            m = ua_cat(&m, &plain);
        }
        out.push(m);
        if kind == 70 {
            break;
        }
    }
    return out;
}

/// Open the chunks of one MSG/CLO message: token (current, previous, or
/// on a server the renewed one, which then becomes current), decryption,
/// signature, padding, sequence numbers, one request id, a final chunk.
pub fn ua_sym_open(c: &mut UaChannel, chunks: &Vec<Vec<i64>>) -> UaOpened {
    var o: UaOpened = ua_opened_fail("no chunks");
    var body: Vec<i64> = Vec::new();
    val sec: bool = ua_secured(c);
    val enc: bool = sec && c.mode == UA_MODE_SIGN_ENCRYPT;
    var i: i64 = 0;
    while i < chunks.len() {
        val m: Vec<i64> = chunks.get(i);
        val mt: str = ua_message_type(&m);
        if ua_frame_len(&m) != m.len() || m.len() < 16 || (mt != "MSG" && mt != "CLO") {
            return ua_opened_fail("not a MSG or CLO chunk");
        }
        var r: UaReader = ua_reader(m);
        r.pos = 8;
        val chan: i64 = ua_get_u32(&mut r);
        val token: i64 = ua_get_u32(&mut r);
        if chan != c.channel_id {
            return ua_opened_fail("unknown SecureChannelId " + int_to_str(chan));
        }
        var keys: UaKeys = c.recv_keys;
        if token == c.token_id {
            keys = c.recv_keys;
        } else if !c.is_client && token == c.next_token {
            // the client uses the renewed token: switch to it
            c.old_token = c.token_id;
            c.old_recv = c.recv_keys;
            c.token_id = c.next_token;
            c.send_keys = c.next_send;
            c.recv_keys = c.next_recv;
            c.next_token = -1;
            keys = c.recv_keys;
        } else if token == c.old_token && c.old_token > 0 {
            keys = c.old_recv;
        } else {
            return ua_opened_fail("unknown SecurityToken " + int_to_str(token));
        }
        val head: Vec<i64> = ua_sub(&m, 0, 16);
        var plain: Vec<i64> = ua_sub(&m, 16, m.len());
        if sec {
            if enc {
                if plain.len() % 16 != 0 {
                    return ua_opened_fail("ciphertext is not whole AES blocks");
                }
                plain = ua_aes_cbc_decrypt(&keys.enc, &keys.iv, &plain);
            }
            if plain.len() < 8 + 32 {
                return ua_opened_fail("chunk too short");
            }
            val mac: Vec<i64> = kdf_hmac_sha256(keys.sign, ua_cat(&head, &ua_sub(&plain, 0, plain.len() - 32)));
            if !ua_same(&mac, &ua_sub(&plain, plain.len() - 32, plain.len())) {
                return ua_opened_fail("signature does not verify");
            }
            plain = ua_sub(&plain, 0, plain.len() - 32);
            if enc {
                val pad: i64 = plain.get(plain.len() - 1);
                if plain.len() - 1 - pad < 8 {
                    return ua_opened_fail("bad padding");
                }
                var k: i64 = plain.len() - 1 - pad;
                while k < plain.len() {
                    if plain.get(k) != pad {
                        return ua_opened_fail("bad padding");
                    }
                    k = k + 1;
                }
                plain = ua_sub(&plain, 0, plain.len() - 1 - pad);
            }
        }
        if plain.len() < 8 {
            return ua_opened_fail("no sequence header");
        }
        var sr: UaReader = ua_reader(plain);
        val seq: i64 = ua_get_u32(&mut sr);
        val rid: i64 = ua_get_u32(&mut sr);
        if !ua_check_seq(c, seq) {
            return ua_opened_fail("sequence number " + int_to_str(seq) + " out of order");
        }
        if i == 0 {
            o = UaOpened {
                ok: false, error: "", mtype: mt, channel_id: chan, token_id: token, policy: c.policy, sender_cert: Vec::new(), seq: seq, request_id: rid, body: Vec::new()
            };
        } else if rid != o.request_id {
            return ua_opened_fail("chunk of another request");
        }
        body = ua_cat(&body, &ua_sub(&plain, 8, plain.len()));
        val kind: i64 = m.get(3);
        if kind == 65 {
            return ua_opened_fail("message aborted");
        }
        if kind == 70 {
            if i != chunks.len() - 1 {
                return ua_opened_fail("chunks after the final one");
            }
            o.ok = true;
            o.body = body;
            return o;
        }
        i = i + 1;
    }
    return ua_opened_fail("no final chunk");
}

// ─── Sessions: CreateSession, ActivateSession, CloseSession ──────────────

pub fn ua_get_localized_text(r: &mut UaReader) -> str {
    val mask: i64 = ua_get_byte(r);
    if (mask & 1) != 0 {
        ua_get_string(r);
    }
    if (mask & 2) != 0 {
        return ua_get_string(r);
    }
    return "";
}

/// ApplicationDescription: uri, product uri, name, type (0 server,
/// 1 client); gateway and discovery profile null, no discovery URLs.
fn ua_put_app(out: &mut Vec<i64>, uri: str, product: str, name: str, app_type: i64) {
    ua_put_string(out, uri);
    ua_put_string(out, product);
    ua_put_localized_text(out, "", name);
    ua_put_u32(out, app_type);
    ua_put_null_string(out);
    ua_put_null_string(out);
    ua_put_u32(out, 0);
}

/// Read an ApplicationDescription; returns its ApplicationUri.
fn ua_get_app(r: &mut UaReader) -> str {
    val uri: str = ua_get_string(r);
    ua_get_string(r);
    ua_get_localized_text(r);
    ua_get_u32(r);
    ua_get_string(r);
    ua_get_string(r);
    val n: i64 = ua_get_i32(r);
    var i: i64 = 0;
    while i < n && r.ok {
        ua_get_string(r);
        i = i + 1;
    }
    return uri;
}

fn ua_put_signature(out: &mut Vec<i64>, alg: str, sig: &Vec<i64>) {
    if alg == "" {
        ua_put_null_string(out);
        ua_put_u32(out, -1);
    } else {
        ua_put_string(out, alg);
        ua_put_bytestring(out, sig);
    }
}

pub struct UaCreateSessionRequest {
    pub hdr: UaRequestHeader,
    pub app_uri: str,
    pub app_name: str,
    pub endpoint_url: str,
    pub session_name: str,
    pub nonce: Vec<i64>,
    pub cert: Vec<i64>,
    pub timeout: f64,  // requested session timeout, ms
    pub max_response: i64,
    pub error: str,
}

pub fn ua_encode_create_session_request(q: &UaCreateSessionRequest) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_CREATE_SESSION_REQUEST_ID));
    ua_put_request_header(&mut out, &q.hdr);
    ua_put_app(&mut out, q.app_uri, "urn:fides:opcua", q.app_name, 1);
    ua_put_null_string(&mut out);  // serverUri
    ua_put_string(&mut out, q.endpoint_url);
    ua_put_string(&mut out, q.session_name);
    ua_put_bytestring(&mut out, &q.nonce);
    ua_put_bytestring(&mut out, &q.cert);
    ua_put_double(&mut out, q.timeout);
    ua_put_u32(&mut out, q.max_response);
    return out;
}

pub fn ua_decode_create_session_request(b: Vec<i64>) -> UaCreateSessionRequest {
    var r: UaReader = ua_reader(b);
    var q: UaCreateSessionRequest = UaCreateSessionRequest {
        hdr: ua_request_header(ua_node_num(0, 0), 0, 0), app_uri: "", app_name: "", endpoint_url: "", session_name: "", nonce: Vec::new(), cert: Vec::new(), timeout: 0.0, max_response: 0, error: "",
    };
    if ua_get_nodeid(&mut r).num != UA_CREATE_SESSION_REQUEST_ID {
        q.error = "not a CreateSessionRequest";
        return q;
    }
    q.hdr = ua_get_request_header(&mut r);
    q.app_uri = ua_get_app(&mut r);
    ua_get_string(&mut r);
    q.endpoint_url = ua_get_string(&mut r);
    q.session_name = ua_get_string(&mut r);
    q.nonce = ua_get_bytestring(&mut r);
    q.cert = ua_get_bytestring(&mut r);
    q.timeout = ua_get_double(&mut r);
    q.max_response = ua_get_u32(&mut r);
    q.error = ua_finish(&r);
    return q;
}

/// An EndpointDescription with its user token policies (parallel lists).
pub struct UaEndpoint {
    pub url: str,
    pub server_uri: str,
    pub cert: Vec<i64>,
    pub mode: i64,
    pub policy: str,
    pub token_ids: Vec<str>,
    pub token_types: Vec<i64>,
    pub token_policies: Vec<str>,  // SecurityPolicyUri of the token ("" = the channel's)
    pub level: i64,
}

pub fn ua_put_endpoint(out: &mut Vec<i64>, e: &UaEndpoint) {
    ua_put_string(out, e.url);
    ua_put_app(out, e.server_uri, "urn:fides:opcua", "Fides OPC UA server", 0);
    ua_put_bytestring(out, &e.cert);
    ua_put_u32(out, e.mode);
    ua_put_string(out, e.policy);
    ua_put_u32(out, e.token_ids.len());
    var i: i64 = 0;
    while i < e.token_ids.len() {
        ua_put_string(out, e.token_ids.get(i));
        ua_put_u32(out, e.token_types.get(i));
        ua_put_null_string(out);
        ua_put_null_string(out);
        if e.token_policies.get(i) == "" {
            ua_put_null_string(out);
        } else {
            ua_put_string(out, e.token_policies.get(i));
        }
        i = i + 1;
    }
    ua_put_string(out, "http://opcfoundation.org/UA-Profile/Transport/uatcp-uasc-uabinary");
    out.push(e.level & 255);
}

pub fn ua_get_endpoint(r: &mut UaReader) -> UaEndpoint {
    var e: UaEndpoint = UaEndpoint {
        url: "", server_uri: "", cert: Vec::new(), mode: 0, policy: "", token_ids: Vec::new(), token_types: Vec::new(), token_policies: Vec::new(), level: 0
    };
    e.url = ua_get_string(r);
    e.server_uri = ua_get_app(r);
    e.cert = ua_get_bytestring(r);
    e.mode = ua_get_u32(r);
    e.policy = ua_get_string(r);
    val n: i64 = ua_get_i32(r);
    var i: i64 = 0;
    while i < n && r.ok {
        e.token_ids.push(ua_get_string(r));
        e.token_types.push(ua_get_u32(r));
        ua_get_string(r);
        ua_get_string(r);
        e.token_policies.push(ua_get_string(r));
        i = i + 1;
    }
    ua_get_string(r);
    e.level = ua_get_byte(r);
    return e;
}

pub struct UaCreateSessionResponse {
    pub hdr: UaResponseHeader,
    pub session_id: UaNodeId,
    pub auth_token: UaNodeId,
    pub timeout: f64,
    pub nonce: Vec<i64>,
    pub cert: Vec<i64>,
    pub endpoints: Vec<UaEndpoint>,
    pub sig_alg: str,
    pub signature: Vec<i64>,  // server's signature of client certificate + client nonce
    pub max_request: i64,
    pub error: str,
}

pub fn ua_encode_create_session_response(p: &UaCreateSessionResponse) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_CREATE_SESSION_RESPONSE_ID));
    ua_put_response_header(&mut out, &p.hdr);
    ua_put_nodeid(&mut out, &p.session_id);
    ua_put_nodeid(&mut out, &p.auth_token);
    ua_put_double(&mut out, p.timeout);
    ua_put_bytestring(&mut out, &p.nonce);
    ua_put_bytestring(&mut out, &p.cert);
    ua_put_u32(&mut out, p.endpoints.len());
    var i: i64 = 0;
    while i < p.endpoints.len() {
        ua_put_endpoint(&mut out, &p.endpoints.get(i));
        i = i + 1;
    }
    ua_put_u32(&mut out, 0);  // serverSoftwareCertificates
    ua_put_signature(&mut out, p.sig_alg, &p.signature);
    ua_put_u32(&mut out, p.max_request);
    return out;
}

pub fn ua_decode_create_session_response(b: Vec<i64>) -> UaCreateSessionResponse {
    var r: UaReader = ua_reader(b);
    var p: UaCreateSessionResponse = UaCreateSessionResponse {
        hdr: UaResponseHeader {
            timestamp: 0, handle: 0, result: 0
        }, session_id: ua_node_num(0, 0), auth_token: ua_node_num(0, 0), timeout: 0.0, nonce: Vec::new(), cert: Vec::new(), endpoints: Vec::new(), sig_alg: "", signature: Vec::new(), max_request: 0, error: "",
    };
    val tid: i64 = ua_get_nodeid(&mut r).num;
    if tid == UA_SERVICE_FAULT_ID {
        p.hdr = ua_get_response_header(&mut r);
        p.error = "service fault " + int_to_hex(p.hdr.result);
        return p;
    }
    if tid != UA_CREATE_SESSION_RESPONSE_ID {
        p.error = "not a CreateSessionResponse";
        return p;
    }
    p.hdr = ua_get_response_header(&mut r);
    p.session_id = ua_get_nodeid(&mut r);
    p.auth_token = ua_get_nodeid(&mut r);
    p.timeout = ua_get_double(&mut r);
    p.nonce = ua_get_bytestring(&mut r);
    p.cert = ua_get_bytestring(&mut r);
    val n: i64 = ua_get_i32(&mut r);
    var i: i64 = 0;
    while i < n && r.ok {
        p.endpoints.push(ua_get_endpoint(&mut r));
        i = i + 1;
    }
    val nsc: i64 = ua_get_i32(&mut r);
    i = 0;
    while i < nsc && r.ok {
        ua_get_bytestring(&mut r);
        ua_get_bytestring(&mut r);
        i = i + 1;
    }
    p.sig_alg = ua_get_string(&mut r);
    p.signature = ua_get_bytestring(&mut r);
    p.max_request = ua_get_u32(&mut r);
    p.error = ua_finish(&r);
    return p;
}

pub struct UaActivateSessionRequest {
    pub hdr: UaRequestHeader,
    pub sig_alg: str,
    pub signature: Vec<i64>,  // client's signature of server certificate + server nonce
    pub locales: Vec<str>,
    pub token_type: i64,  // UA_ANONYMOUS_TOKEN_ID or UA_USERNAME_TOKEN_ID
    pub policy_id: str,
    pub user: str,
    pub password: Vec<i64>,  // as on the wire (encrypted unless policy None)
    pub enc_alg: str,
    pub error: str,
}

pub fn ua_encode_activate_session_request(q: &UaActivateSessionRequest) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_ACTIVATE_SESSION_REQUEST_ID));
    ua_put_request_header(&mut out, &q.hdr);
    ua_put_signature(&mut out, q.sig_alg, &q.signature);
    ua_put_u32(&mut out, 0);  // clientSoftwareCertificates
    ua_put_u32(&mut out, q.locales.len());
    var i: i64 = 0;
    while i < q.locales.len() {
        ua_put_string(&mut out, q.locales.get(i));
        i = i + 1;
    }
    // UserIdentityToken: an ExtensionObject with a binary body
    var tok: Vec<i64> = Vec::new();
    ua_put_string(&mut tok, q.policy_id);
    if q.token_type == UA_USERNAME_TOKEN_ID {
        ua_put_string(&mut tok, q.user);
        ua_put_bytestring(&mut tok, &q.password);
        if q.enc_alg == "" {
            ua_put_null_string(&mut tok);
        } else {
            ua_put_string(&mut tok, q.enc_alg);
        }
    }
    ua_put_nodeid(&mut out, &ua_node_num(0, q.token_type));
    out.push(1);
    ua_put_bytestring(&mut out, &tok);
    ua_put_signature(&mut out, "", &Vec::new());  // userTokenSignature
    return out;
}

pub fn ua_decode_activate_session_request(b: Vec<i64>) -> UaActivateSessionRequest {
    var r: UaReader = ua_reader(b);
    var q: UaActivateSessionRequest = UaActivateSessionRequest {
        hdr: ua_request_header(ua_node_num(0, 0), 0, 0), sig_alg: "", signature: Vec::new(), locales: Vec::new(), token_type: 0, policy_id: "", user: "", password: Vec::new(), enc_alg: "", error: "",
    };
    if ua_get_nodeid(&mut r).num != UA_ACTIVATE_SESSION_REQUEST_ID {
        q.error = "not an ActivateSessionRequest";
        return q;
    }
    q.hdr = ua_get_request_header(&mut r);
    q.sig_alg = ua_get_string(&mut r);
    q.signature = ua_get_bytestring(&mut r);
    val nsc: i64 = ua_get_i32(&mut r);
    var i: i64 = 0;
    while i < nsc && r.ok {
        ua_get_bytestring(&mut r);
        ua_get_bytestring(&mut r);
        i = i + 1;
    }
    val nl: i64 = ua_get_i32(&mut r);
    i = 0;
    while i < nl && r.ok {
        q.locales.push(ua_get_string(&mut r));
        i = i + 1;
    }
    val tid: UaNodeId = ua_get_nodeid(&mut r);
    q.token_type = tid.num;
    val enc: i64 = ua_get_byte(&mut r);
    if enc == 1 {
        var tr: UaReader = ua_reader(ua_get_bytestring(&mut r));
        q.policy_id = ua_get_string(&mut tr);
        if q.token_type == UA_USERNAME_TOKEN_ID {
            q.user = ua_get_string(&mut tr);
            q.password = ua_get_bytestring(&mut tr);
            q.enc_alg = ua_get_string(&mut tr);
        } else if q.token_type != UA_ANONYMOUS_TOKEN_ID {
            q.error = "identity token type " + int_to_str(q.token_type) + " not supported";
            return q;
        }
        if ua_finish(&tr) != "" {
            q.error = "identity token: " + ua_finish(&tr);
            return q;
        }
    } else if enc != 0 {
        q.error = "bad identity token encoding";
        return q;
    }
    ua_get_string(&mut r);
    ua_get_bytestring(&mut r);
    q.error = ua_finish(&r);
    return q;
}

pub struct UaActivateSessionResponse {
    pub hdr: UaResponseHeader,
    pub nonce: Vec<i64>,
    pub error: str,
}

pub fn ua_encode_activate_session_response(p: &UaActivateSessionResponse) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_ACTIVATE_SESSION_RESPONSE_ID));
    ua_put_response_header(&mut out, &p.hdr);
    ua_put_bytestring(&mut out, &p.nonce);
    ua_put_u32(&mut out, 0);  // results
    ua_put_u32(&mut out, 0);  // diagnosticInfos
    return out;
}

pub fn ua_decode_activate_session_response(b: Vec<i64>) -> UaActivateSessionResponse {
    var r: UaReader = ua_reader(b);
    var p: UaActivateSessionResponse = UaActivateSessionResponse {
        hdr: UaResponseHeader {
            timestamp: 0, handle: 0, result: 0
        }, nonce: Vec::new(), error: ""
    };
    val tid: i64 = ua_get_nodeid(&mut r).num;
    if tid == UA_SERVICE_FAULT_ID {
        p.hdr = ua_get_response_header(&mut r);
        p.error = "service fault " + int_to_hex(p.hdr.result);
        return p;
    }
    if tid != UA_ACTIVATE_SESSION_RESPONSE_ID {
        p.error = "not an ActivateSessionResponse";
        return p;
    }
    p.hdr = ua_get_response_header(&mut r);
    p.nonce = ua_get_bytestring(&mut r);
    val n: i64 = ua_get_i32(&mut r);
    var i: i64 = 0;
    while i < n && r.ok {
        ua_get_u32(&mut r);
        i = i + 1;
    }
    val nd: i64 = ua_get_i32(&mut r);
    i = 0;
    while i < nd && r.ok {
        ua_skip_diagnostic(&mut r, 0);
        i = i + 1;
    }
    p.error = ua_finish(&r);
    return p;
}

pub fn ua_encode_close_session_request(h: &UaRequestHeader, delete_subscriptions: bool) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_CLOSE_SESSION_REQUEST_ID));
    ua_put_request_header(&mut out, h);
    ua_put_bool(&mut out, delete_subscriptions);
    return out;
}

/// The request header of a CloseSessionRequest (error set if not one).
pub fn ua_decode_close_session_request(b: Vec<i64>) -> UaRequestHeader {
    var r: UaReader = ua_reader(b);
    if ua_get_nodeid(&mut r).num != UA_CLOSE_SESSION_REQUEST_ID {
        return ua_request_header(ua_node_num(0, 0), 0, -1);
    }
    val h: UaRequestHeader = ua_get_request_header(&mut r);
    ua_get_byte(&mut r);
    if ua_finish(&r) != "" {
        return ua_request_header(ua_node_num(0, 0), 0, -1);
    }
    return h;
}

pub fn ua_encode_close_session_response(h: &UaResponseHeader) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    ua_put_nodeid(&mut out, &ua_node_num(0, UA_CLOSE_SESSION_RESPONSE_ID));
    ua_put_response_header(&mut out, h);
    return out;
}

/// The response header of a CloseSessionResponse or ServiceFault.
pub fn ua_decode_response_header(b: Vec<i64>, want: i64) -> UaResponseHeader {
    var r: UaReader = ua_reader(b);
    val tid: i64 = ua_get_nodeid(&mut r).num;
    if tid != want && tid != UA_SERVICE_FAULT_ID {
        return UaResponseHeader {
            timestamp: 0, handle: -1, result: UA_BAD_SECURITY_CHECKS_FAILED
        };
    }
    return ua_get_response_header(&mut r);
}

/// The session signature of Basic256Sha256: RSA-PKCS1-v1.5-SHA256 of the
/// peer's certificate followed by the peer's nonce.
pub fn ua_session_sign(key: RsaPrivateKey, peer_cert: &Vec<i64>, peer_nonce: &Vec<i64>) -> Vec<i64> {
    return rsa_pkcs1_sign(key, KDF_SHA256, ua_cat(peer_cert, peer_nonce));
}

pub fn ua_session_verify(key: RsaPublicKey, own_cert: &Vec<i64>, own_nonce: &Vec<i64>, sig: &Vec<i64>) -> bool {
    return rsa_pkcs1_verify(key, KDF_SHA256, ua_cat(own_cert, own_nonce), ua_sub(sig, 0, sig.len()));
}

/// A UserNameIdentityToken secret (Part 4 7.36.2.2): RSA-OAEP-SHA1 of
/// length (UInt32) + password + server nonce under the server's key.
pub fn ua_password_encrypt(key: RsaPublicKey, password: str, server_nonce: &Vec<i64>, seed: Vec<i64>) -> Vec<i64> {
    val pw: Vec<i64> = str_bytes(password);
    var plain: Vec<i64> = Vec::new();
    ua_put_u32(&mut plain, pw.len() + server_nonce.len());
    plain = ua_cat(&plain, &pw);
    plain = ua_cat(&plain, server_nonce);
    return rsa_oaep_encrypt(key, KDF_SHA1, plain, Vec::new(), seed);
}

/// The password from a token secret, or ok false if it does not decrypt
/// or does not end with the server nonce the session sent.
pub fn ua_password_decrypt(key: RsaPrivateKey, secret: &Vec<i64>, server_nonce: &Vec<i64>) -> RsaPlain {
    val bad: RsaPlain = RsaPlain {
        ok: false, data: Vec::new()
    };
    val p: RsaPlain = rsa_oaep_decrypt(key, KDF_SHA1, ua_sub(secret, 0, secret.len()), Vec::new());
    if !p.ok || p.data.len() < 4 {
        return bad;
    }
    var r: UaReader = ua_reader(p.data);
    val n: i64 = ua_get_u32(&mut r);
    if n != p.data.len() - 4 || n < server_nonce.len() {
        return bad;
    }
    val tail: Vec<i64> = ua_sub(&p.data, p.data.len() - server_nonce.len(), p.data.len());
    if !ua_same(&tail, server_nonce) {
        return bad;
    }
    return RsaPlain {
        ok: true, data: ua_sub(&p.data, 4, p.data.len() - server_nonce.len())
    };
}

// ─── Client ──────────────────────────────────────────────────────────────

pub const UA_CL_IDLE: i64 = 0;
pub const UA_CL_HELLO: i64 = 1;  // HEL sent
pub const UA_CL_OPENING: i64 = 2;  // OPN sent
pub const UA_CL_CREATING: i64 = 3;  // CreateSession sent
pub const UA_CL_ACTIVATING: i64 = 4;  // ActivateSession sent
pub const UA_CL_ACTIVE: i64 = 5;  // session active
pub const UA_CL_CLOSING: i64 = 6;  // CloseSession sent
pub const UA_CL_CLOSED: i64 = 7;  // CLO sent
pub const UA_CL_FAILED: i64 = 8;

/// A client: the connection state machine over a byte-stream transport.
/// The seam: the caller owns the TCP connection; ua_client_start and the
/// requests return frames to write, ua_client_feed takes the bytes read
/// (any split) and returns frames to write in reply.
pub struct UaClient {
    pub state: i64,
    pub error: str,
    pub ch: UaChannel,
    pub url: str,
    pub app_uri: str,
    pub user: str,  // "" for an anonymous identity
    pub password: str,
    pub session_id: UaNodeId,
    pub auth_token: UaNodeId,
    pub client_nonce: Vec<i64>,
    pub server_nonce: Vec<i64>,
    pub server_cert: Vec<i64>,
    pub handle: i64,
    pub request_id: i64,
    pub now: i64,  // caller's clock, ms since 1970
    pub renewing: bool,
    pub renewals: i64,
    pub inbox: Vec<i64>,  // bytes not yet framed
    pub parts: Vec<Vec<i64>>,  // chunks of a message in progress
    pub reads: Vec<UaReadResponse>,
    pub max_chunk: i64,
}

pub fn ua_client(url: str, app_uri: str, ch: UaChannel, user: str, password: str) -> UaClient {
    return UaClient {
        state: UA_CL_IDLE, error: "", ch: ch, url: url, app_uri: app_uri, user: user, password: password, session_id: ua_node_num(0, 0), auth_token: ua_node_num(0, 0), client_nonce: Vec::new(), server_nonce: Vec::new(), server_cert: Vec::new(), handle: 0, request_id: 0, now: 0, renewing: false, renewals: 0, inbox: Vec::new(), parts: Vec::new(), reads: Vec::new(), max_chunk: 8192,
    };
}

fn ua_client_fail(c: &mut UaClient, why: str) -> Vec<Vec<i64>> {
    if c.state != UA_CL_FAILED {
        c.state = UA_CL_FAILED;
        c.error = why;
    }
    return Vec::new();
}

fn ua_client_hdr(c: &mut UaClient) -> UaRequestHeader {
    c.handle = c.handle + 1;
    return ua_request_header(c.auth_token, ua_datetime_from_unix_ms(c.now), c.handle);
}

fn ua_client_next_id(c: &mut UaClient) -> i64 {
    c.request_id = c.request_id + 1;
    return c.request_id;
}

/// Connect: the Hello frame.
pub fn ua_client_start(c: &mut UaClient) -> Vec<Vec<i64>> {
    var out: Vec<Vec<i64>> = Vec::new();
    out.push(ua_encode_hello(&ua_hello(c.url, 65536)));
    c.state = UA_CL_HELLO;
    return out;
}

fn ua_client_opn(c: &mut UaClient, renew: bool) -> Vec<Vec<i64>> {
    var out: Vec<Vec<i64>> = Vec::new();
    val nonce: Vec<i64> = ua_channel_nonce(&mut c.ch);
    var hdr: UaRequestHeader = ua_client_hdr(c);
    hdr.auth = ua_node_num(0, 0);
    val q: UaOpnRequest = UaOpnRequest {
        hdr: hdr, renew: renew, mode: c.ch.mode, nonce: nonce, lifetime: 3600000, error: ""
    };
    val rid: i64 = ua_client_next_id(c);
    val m: Vec<i64> = ua_opn_seal(&mut c.ch, rid, &ua_encode_opn_request(&q));
    if m.len() == 0 {
        return ua_client_fail(c, "cannot secure OpenSecureChannel (keys missing)");
    }
    out.push(m);
    return out;
}

fn ua_client_send(c: &mut UaClient, mtype: str, body: &Vec<i64>) -> Vec<Vec<i64>> {
    val rid: i64 = ua_client_next_id(c);
    return ua_sym_seal(&mut c.ch, mtype, rid, body, c.max_chunk);
}

/// Renew the channel's SecurityToken (send when ua_client_needs_renew).
pub fn ua_client_renew(c: &mut UaClient) -> Vec<Vec<i64>> {
    if c.state < UA_CL_CREATING || c.state > UA_CL_ACTIVE {
        return Vec::new();
    }
    c.renewing = true;
    return ua_client_opn(c, true);
}

/// Whether 75 % of the token's lifetime has passed (Part 4 5.5.2).
pub fn ua_client_needs_renew(c: &UaClient) -> bool {
    return c.ch.lifetime > 0 && c.now >= c.ch.created + c.ch.lifetime * 3 / 4;
}

/// A Read of the Value attribute of `nodes`; the response is appended to
/// c.reads when it arrives.
pub fn ua_client_read(c: &mut UaClient, nodes: &Vec<UaNodeId>) -> Vec<Vec<i64>> {
    if c.state != UA_CL_ACTIVE {
        return Vec::new();
    }
    c.handle = c.handle + 1;
    var q: UaReadRequest = ua_read_request(c.handle, ua_datetime_from_unix_ms(c.now));
    q.auth_token = c.auth_token;
    var i: i64 = 0;
    while i < nodes.len() {
        ua_read_add(&mut q, nodes.get(i), UA_ATTR_VALUE);
        i = i + 1;
    }
    return ua_client_send(c, "MSG", &ua_encode_read_request(&q));
}

/// Close the session (then the channel, when the response arrives).
pub fn ua_client_close(c: &mut UaClient) -> Vec<Vec<i64>> {
    if c.state != UA_CL_ACTIVE {
        return Vec::new();
    }
    val h: UaRequestHeader = ua_client_hdr(c);
    c.state = UA_CL_CLOSING;
    return ua_client_send(c, "MSG", &ua_encode_close_session_request(&h, true));
}

/// Take the first whole frame from a byte stream (empty if incomplete).
pub fn ua_take_frame(buf: &mut Vec<i64>) -> Vec<i64> {
    val n: i64 = ua_frame_len(buf);
    if n <= 0 {
        return Vec::new();
    }
    val f: Vec<i64> = ua_sub(buf, 0, n);
    var rest: Vec<i64> = ua_sub(buf, n, buf.len());
    *buf = rest;
    return f;
}

/// Feed bytes read from the connection; returns the frames to write.
pub fn ua_client_feed(c: &mut UaClient, bytes: &Vec<i64>) -> Vec<Vec<i64>> {
    var out: Vec<Vec<i64>> = Vec::new();
    c.inbox = ua_cat(&c.inbox, bytes);
    loop {
        if c.state == UA_CL_FAILED {
            return out;
        }
        if ua_frame_len(&c.inbox) < 0 {
            return ua_client_fail(c, "bad frame");
        }
        val f: Vec<i64> = ua_take_frame(&mut c.inbox);
        if f.len() == 0 {
            return out;
        }
        val more: Vec<Vec<i64>> = ua_client_frame(c, f);
        var i: i64 = 0;
        while i < more.len() {
            out.push(more.get(i));
            i = i + 1;
        }
    }
    return out;
}

fn ua_client_frame(c: &mut UaClient, f: Vec<i64>) -> Vec<Vec<i64>> {
    val mt: str = ua_message_type(&f);
    if mt == "ERR" {
        val e: UaHello = ua_decode_hello(f);
        return ua_client_fail(c, "server error " + int_to_hex(e.error) + ": " + e.reason);
    }
    if mt == "ACK" {
        if c.state != UA_CL_HELLO {
            return ua_client_fail(c, "unexpected Acknowledge");
        }
        val a: UaHello = ua_decode_hello(f);
        if !a.ok {
            return ua_client_fail(c, "bad Acknowledge");
        }
        if a.recv_buf < c.max_chunk {
            c.max_chunk = a.recv_buf;
        }
        c.state = UA_CL_OPENING;
        return ua_client_opn(c, false);
    }
    if mt == "OPN" {
        val o: UaOpened = ua_opn_open(&mut c.ch, f);
        if !o.ok {
            return ua_client_fail(c, "OpenSecureChannel response: " + o.error);
        }
        val p: UaOpnResponse = ua_decode_opn_response(o.body);
        if p.error != "" || p.hdr.result != UA_GOOD {
            return ua_client_fail(c, "OpenSecureChannel refused " + p.error);
        }
        ua_channel_install(&mut c.ch, &p, c.now);
        if c.renewing {
            c.renewing = false;
            c.renewals = c.renewals + 1;
            return Vec::new();
        }
        // CreateSession
        if ua_secured(&c.ch) {
            c.client_nonce = ua_rng_bytes(&mut c.ch.rng, 32);
        }
        val q: UaCreateSessionRequest = UaCreateSessionRequest {
            hdr: ua_client_hdr(c), app_uri: c.app_uri, app_name: "Fides OPC UA client", endpoint_url: c.url, session_name: "fides session", nonce: c.client_nonce, cert: c.ch.own_cert, timeout: 1200000.0, max_response: 0, error: "",
        };
        c.state = UA_CL_CREATING;
        return ua_client_send(c, "MSG", &ua_encode_create_session_request(&q));
    }
    if mt != "MSG" {
        return ua_client_fail(c, "unexpected message " + mt);
    }
    c.parts.push(f);
    if f.get(3) == 67 {
        return Vec::new();  // more chunks follow
    }
    val o: UaOpened = ua_sym_open(&mut c.ch, &c.parts);
    c.parts = Vec::new();
    if !o.ok {
        return ua_client_fail(c, "MSG: " + o.error);
    }
    val ty: i64 = ua_body_type(&o.body);
    if c.state == UA_CL_CREATING {
        val p: UaCreateSessionResponse = ua_decode_create_session_response(o.body);
        if p.error != "" || p.hdr.result != UA_GOOD {
            return ua_client_fail(c, "CreateSession: " + p.error);
        }
        c.server_cert = p.cert;
        c.server_nonce = p.nonce;
        if ua_secured(&c.ch) {
            if !ua_same(&p.cert, &c.ch.peer_cert) {
                return ua_client_fail(c, "CreateSession: server certificate differs from the channel's");
            }
            if !ua_session_verify(c.ch.peer_key, &c.ch.own_cert, &c.client_nonce, &p.signature) {
                return ua_client_fail(c, "CreateSession: server signature does not verify");
            }
        }
        c.session_id = p.session_id;
        c.auth_token = p.auth_token;
        // the user token policy the endpoint offers for our identity
        var want: i64 = UA_TOKEN_ANONYMOUS;
        if c.user != "" {
            want = UA_TOKEN_USERNAME;
        }
        var policy_id: str = "";
        var found: bool = false;
        var i: i64 = 0;
        while i < p.endpoints.len() && !found {
            val e: UaEndpoint = p.endpoints.get(i);
            if e.policy == c.ch.policy && e.mode == c.ch.mode {
                var k: i64 = 0;
                while k < e.token_ids.len() {
                    if e.token_types.get(k) == want && !found {
                        policy_id = e.token_ids.get(k);
                        found = true;
                    }
                    k = k + 1;
                }
            }
            i = i + 1;
        }
        if !found {
            return ua_client_fail(c, "CreateSession: no endpoint takes this identity");
        }
        var q: UaActivateSessionRequest = UaActivateSessionRequest {
            hdr: ua_client_hdr(c), sig_alg: "", signature: Vec::new(), locales: Vec::new(), token_type: UA_ANONYMOUS_TOKEN_ID, policy_id: policy_id, user: "", password: Vec::new(), enc_alg: "", error: "",
        };
        q.locales.push("en");
        if ua_secured(&c.ch) {
            q.sig_alg = UA_ALG_RSA_SHA256;
            q.signature = ua_session_sign(c.ch.own_key, &c.server_cert, &c.server_nonce);
        }
        if c.user != "" {
            q.token_type = UA_USERNAME_TOKEN_ID;
            q.user = c.user;
            if c.ch.policy != UA_POLICY_NONE {
                q.password = ua_password_encrypt(c.ch.peer_key, c.password, &c.server_nonce, ua_rng_bytes(&mut c.ch.rng, 20));
                q.enc_alg = UA_ALG_RSA_OAEP;
            } else {
                q.password = str_bytes(c.password);
            }
        }
        c.state = UA_CL_ACTIVATING;
        return ua_client_send(c, "MSG", &ua_encode_activate_session_request(&q));
    }
    if c.state == UA_CL_ACTIVATING {
        val p: UaActivateSessionResponse = ua_decode_activate_session_response(o.body);
        if p.error != "" || p.hdr.result != UA_GOOD {
            return ua_client_fail(c, "ActivateSession: " + p.error);
        }
        c.server_nonce = p.nonce;
        c.state = UA_CL_ACTIVE;
        return Vec::new();
    }
    if c.state == UA_CL_ACTIVE && ty == UA_READ_RESPONSE_ID {
        val p: UaReadResponse = ua_decode_read_response(o.body);
        if !p.ok {
            return ua_client_fail(c, "Read: " + p.error);
        }
        c.reads.push(p);
        return Vec::new();
    }
    if c.state == UA_CL_CLOSING {
        val h: UaResponseHeader = ua_decode_response_header(o.body, UA_CLOSE_SESSION_RESPONSE_ID);
        if h.result != UA_GOOD {
            return ua_client_fail(c, "CloseSession: " + int_to_hex(h.result));
        }
        val ch: UaRequestHeader = ua_client_hdr(c);
        c.state = UA_CL_CLOSED;
        return ua_client_send(c, "CLO", &ua_encode_clo_request(&ch));
    }
    if ty == UA_SERVICE_FAULT_ID {
        val h: UaResponseHeader = ua_decode_response_header(o.body, UA_SERVICE_FAULT_ID);
        return ua_client_fail(c, "service fault " + int_to_hex(h.result));
    }
    return ua_client_fail(c, "unexpected response " + int_to_str(ty));
}
