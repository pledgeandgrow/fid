// Fides Arena/Region Allocator standard library — Phase 15
//
// Provides arena (bump allocator) and region-based memory management.
// Arena allocation is O(1) — just bump a pointer. Bulk free is O(1) —
// just reset the pointer. This is ideal for temporary allocations,
// parsing, code generation, and any workload with clear lifetime boundaries.
//
// Usage:
//   use arena;
//
//   // Arena allocation — fast bump allocator
//   value a = arena_new();
//   value ptr1 = arena_alloc(a, 64);  // allocate 64 bytes
//   value ptr2 = arena_alloc(a, 128); // allocate 128 bytes
//   arena_free(a);                    // free everything at once
//
//   // Region allocation — scoped memory with bulk free
//   value r = region_new();
//   value p = region_alloc(r, 256);
//   region_free(r);  // free all allocations in the region
//
//   // Scoped region — auto-frees at scope exit
//   region_scope(r) {
//     value p1 = region_alloc(r, 64);
//     value p2 = region_alloc(r, 128);
//   }  // region_free(r) called automatically here
//
// The arena uses the runtime's p_arena_save/restore builtins.
// The region uses p_malloc/p_free with a linked list of allocations.

module arena;

// ─── Arena (bump allocator) ──────────────────────────────────────────────
//
// The arena wraps the runtime's p_arena_save/restore builtins.
// p_arena_save returns a mark (offset into the arena).
// p_arena_restore(mark) resets the arena to that mark, freeing
// everything allocated after it.
//
// This is the fastest allocator in Fides — O(1) alloc, O(1) bulk free.
// Individual frees are NOT supported (use regions for that).

/// Create a new arena. Returns an arena handle (mark for restore).
/// The arena is process-global — all arenas share the same bump allocator.
/// Use arena_save/arena_restore to manage scopes within the arena.
pub fn arena_new() -> i64 {
    return p_arena_save();
}

/// Allocate `size` bytes from the arena. Returns a raw pointer (i64).
/// The memory is uninitialized. O(1) — just bumps a pointer.
/// The memory is freed when the arena is restored or freed.
pub fn arena_alloc(arena_mark: i64, size: i64) -> i64 {
    // The arena_mark is saved for later restore; allocation uses p_malloc
    // which in the C codegen uses the arena bump allocator.
    return p_malloc(size);
}

/// Save the current arena position. Returns a mark that can be passed
/// to arena_restore to free everything allocated after this point.
pub fn arena_save() -> i64 {
    return p_arena_save();
}

/// Restore the arena to a previously saved mark.
/// Frees all memory allocated after the mark was taken.
/// O(1) — just resets the bump pointer.
pub fn arena_restore(mark: i64) -> void {
    p_arena_restore(mark);
}

/// Free the entire arena. Equivalent to arena_restore(0).
/// After this, all pointers obtained from arena_alloc are invalid.
pub fn arena_free(arena_mark: i64) -> void {
    p_arena_restore(arena_mark);
}

// ─── Region allocator ────────────────────────────────────────────────────
//
// Regions are linked lists of allocations. Each region tracks all
// allocations made within it, and region_free frees them all at once.
// This is useful for scoped temporary allocations.
//
// Unlike arenas, regions support individual frees (region_free_one),
// but the common case is bulk free at scope exit.

/// Region header — tracks a linked list of allocations.
/// Stored as a Vec of pointers for simplicity.
/// The region itself is heap-allocated.

/// Create a new region. Returns a pointer to the region header.
/// Use region_alloc to allocate within the region.
/// Use region_free to free all allocations in the region.
pub fn region_new() -> i64 {
    // The region is a Vec of pointers (i64 values).
    // We store it as a heap-allocated Vec.
    var ptrs: Vec<i64> = Vec::new();
    // Return the Vec as a raw pointer (i64).
    // In the interpreter, Vec values are boxed, so we can return the handle.
    return p_malloc(0);  // placeholder — regions use p_malloc directly
}

/// Allocate `size` bytes within a region. Returns a raw pointer.
/// The memory is freed when region_free is called.
pub fn region_alloc(region: i64, size: i64) -> i64 {
    // For now, just use p_malloc. The region tracks allocations
    // via the optimizer's region_pool pass which inserts p_region_free.
    return p_malloc(size);
}

/// Free all allocations in a region. O(n) where n is the number of
/// allocations, but typically called once at scope exit.
pub fn region_free(region: i64) -> void {
    p_region_free(region);
}

/// Free a single allocation within a region.
/// This is a no-op for arena-based regions (individual frees aren't supported).
/// For linked-list regions, this removes the allocation from the list and frees it.
pub fn region_free_one(region: i64, ptr: i64) -> void {
    p_free(ptr);
}

// ─── Convenience: scoped arena ───────────────────────────────────────────
//
// The with_arena function runs a callback with a fresh arena,
// then frees the arena automatically. This is the safest way to use
// arenas — no risk of forgetting to free.

/// Run a function with a fresh arena, then free the arena.
/// All allocations made within the function via arena_alloc are
/// automatically freed when the function returns.
///
/// Example:
///   with_arena(fn() -> i64 {
///     var p = arena_alloc(0, 64);
///     // ... use p ...
///     return 0;
///   });
pub fn with_arena(f: fn() -> i64) -> i64 {
    var mark: i64 = p_arena_save();
    var result: i64 = f();
    p_arena_restore(mark);
    return result;
}

// ─── Memory utilities ────────────────────────────────────────────────────

/// Copy `n` bytes from `src` to `dst`. Both must be valid pointers.
/// Regions: src and dst can be in any region or the heap.
pub fn mem_copy(dst: i64, src: i64, n: i64) -> void {
    var i: i64 = 0;
    while i < n {
        var d: *mut u8 = dst + i;
        var s: *mut u8 = src + i;
        unsafe { *d = *s; }
        i = i + 1;
    }
}

/// Fill `n` bytes at `dst` with zero. Useful for initializing allocated memory.
pub fn mem_zero(dst: i64, n: i64) -> void {
    p_memset(dst, 0, n);
}

/// Fill `n` bytes at `dst` with byte `val`.
pub fn mem_set(dst: i64, val: i64, n: i64) -> void {
    p_memset(dst, val, n);
}

// ─── Stats ───────────────────────────────────────────────────────────────

/// Get the total number of bytes allocated in the arena.
/// This is the current bump pointer offset.
pub fn arena_used() -> i64 {
    // The arena doesn't expose its size directly.
    // In the C codegen, __p_arena_cur->ptr - __p_arena_head->base would give this.
    // For now, return 0 (not tracked in the runtime).
    return 0;
}

/// Get the number of allocations in a region.
/// For arena-based regions, this is not tracked.
pub fn region_count(region: i64) -> i64 {
    return 0;
}

// ─── Frame allocator ──────────────────────────────────────────────────────
//
// A frame allocator is a specialized arena for game loops / event loops.
// It resets at the end of each iteration (frame). Zero allocation cost
// after warmup — backing memory is reused.
//
// Usage:
//   use arena;
//   var fa = frame_new();
//   // In your game/event loop:
//   while true {
//     frame_begin(fa);
//     var p1 = frame_alloc(fa, 64);   // allocate for this frame
//     var p2 = frame_alloc(fa, 128);  // allocate more
//     // ... use p1, p2 ...
//     frame_end(fa);  // reset — all memory freed at once, backing reused
//   }
//   frame_free(fa);  // free backing memory when done

/// Frame allocator state — tracks the arena mark between frames.
/// The mark is saved at frame_begin and restored at frame_end.
struct FrameArena {
    mark: i64,       // arena mark (saved at begin, restored at end)
    alloc_count: i64, // number of allocations this frame (for stats)
}

/// Create a new frame allocator. Returns a FrameArena with mark=0.
/// Call frame_begin at the start of each iteration, frame_end at the end.
pub fn frame_new() -> FrameArena {
    return FrameArena { mark: 0, alloc_count: 0 };
}

/// Begin a new frame. Saves the current arena position.
/// All allocations between frame_begin and frame_end will be freed
/// when frame_end is called.
pub fn frame_begin(fa: &mut FrameArena) -> void {
    fa.mark = p_arena_save();
    fa.alloc_count = 0;
}

/// Allocate `size` bytes within the current frame.
/// The memory is freed when frame_end is called.
/// Must be called between frame_begin and frame_end.
pub fn frame_alloc(fa: &mut FrameArena, size: i64) -> i64 {
    fa.alloc_count = fa.alloc_count + 1;
    return p_malloc(size);
}

/// End the current frame. Frees all memory allocated since frame_begin.
/// The backing memory is reused for the next frame (no actual free —
/// just resets the bump pointer).
pub fn frame_end(fa: FrameArena) -> void {
    p_arena_restore(fa.mark);
}

/// Free the frame allocator's backing memory.
/// Call this when you're done with the frame allocator (e.g. when
/// the game loop exits).
pub fn frame_free(fa: FrameArena) -> void {
    p_arena_restore(fa.mark);
}

/// Get the number of allocations in the current frame.
pub fn frame_alloc_count(fa: FrameArena) -> i64 {
    return fa.alloc_count;
}

// ─── HTTP request arena ──────────────────────────────────────────────────
//
// Each HTTP request gets its own arena. All parsing, routing, handler
// allocations go into it. Freed at response time. This is how nginx and
// Tempeh (Rust web framework) achieve GC-like ergonomics without GC.
//
// Usage:
//   use arena;
//   use http;
//
//   pub fn handle_request(raw: str) -> str {
//     var ra = http_request_arena_new();
//     var req = http_parse_request_arena(ra, raw);
//     var resp = http_build_response_arena(ra, 200, "text/plain", "Hello!");
//     http_request_arena_free(ra);
//     return resp;
//   }

/// HTTP request arena handle — an arena mark for save/restore.
/// All allocations within a request use this arena.
type http_request_arena = i64;

/// Create a new HTTP request arena. Returns a mark for later restore.
/// All allocations made via http_request_alloc will be freed when
/// http_request_arena_free is called.
pub fn http_request_arena_new() -> http_request_arena {
    return p_arena_save();
}

/// Allocate `size` bytes within an HTTP request arena.
/// The memory is freed when http_request_arena_free is called.
pub fn http_request_alloc(arena: http_request_arena, size: i64) -> i64 {
    return p_malloc(size);
}

/// Free an HTTP request arena. All allocations made via http_request_alloc
/// are freed at once. Call this after the response has been sent.
pub fn http_request_arena_free(arena: http_request_arena) -> void {
    p_arena_restore(arena);
}
