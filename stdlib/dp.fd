// Differential Privacy stdlib — ML12
//
// Provides noise-adding primitives for differentially private training.
// @dp(epsilon) functions must use these to add noise to gradients.

module dp;

use tensor;

/// Add Gaussian noise to a tensor for differential privacy.
/// sigma = sqrt(2 * epsilon * sensitivity^2 / num_samples)
pub fn dp_noise(t: Tensor, sigma: f64) -> Tensor {
    p_dp_noise(t, sigma)
}

/// Generate Gaussian noise tensor with given shape and sigma.
pub fn gaussian_noise(shape: Vec<i64>, sigma: f64) -> Tensor {
    p_gaussian_noise(shape, sigma)
}

/// Dropout: randomly zero elements with probability p, scale survivors.
pub fn dropout(t: Tensor, p: f64) -> Tensor {
    p_dropout(t, p)
}
