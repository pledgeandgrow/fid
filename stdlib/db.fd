// Pledge database driver framework — Phase 5D.4
//
// Database driver framework for the "Web & Cloud" platform milestone.
//
// Design: A `Database` capability (trait) defines the query/exec interface.
// Drivers implement this trait for specific databases. A stub `MemoryDB`
// implementation is provided for testing. Real drivers (SQLite, Postgres)
// will be implemented as native builtins in future phases.
//
// Results are represented as JSON strings (rows as JSON arrays, result
// sets as JSON arrays of objects) to work within Pledge's current type
// system. When comptime reflection lands (Phase 3A), this will be
// replaced with typed row mapping.

module db;

use json;

/// Database driver capability — any database connection implements this.
/// Methods:
///   query(sql: str) -> str       — execute SELECT, return JSON array of rows
///   exec(sql: str) -> i64        — execute INSERT/UPDATE/DELETE, return rows affected
///   close() -> void              — close the connection
cap Database {
    fn query(self, sql: str) -> str;
    fn exec(self, sql: str) -> i64;
    fn close(self);
}

/// In-memory database stub for testing.
/// Stores rows in a simple format. Supports basic SELECT/INSERT.
struct MemoryDB {
    dbh: i64,  // opaque handle to native storage
}

impl MemoryDB {
    pub fn new() -> MemoryDB {
        // Create a native in-memory store
        var dbh = p_db_mem_open();
        return MemoryDB { dbh: dbh };
    }
}

/// Convenience function — alias for MemoryDB::new()
pub fn new() -> MemoryDB {
    return MemoryDB::new();
}

impl Database for MemoryDB {
    pub fn query(self: MemoryDB, sql: str) -> str {
        return p_db_mem_query(self.dbh, sql);
    }

    pub fn exec(self: MemoryDB, sql: str) -> i64 {
        return p_db_mem_exec(self.dbh, sql);
    }

    pub fn close(self: MemoryDB) {
        p_db_mem_close(self.dbh);
    }
}

/// Helper: query a single row as a JSON object. Returns "" if no rows.
pub fn query_one<T: Database>(db: T, sql: str) -> str {
    var rows = db.query(sql);
    var count = json_len(rows);
    if count == 0 {
        return "";
    }
    return json_at(rows, 0);
}

/// Helper: query a scalar value (first column of first row).
pub fn query_scalar<T: Database>(db: T, sql: str) -> str {
    var row = query_one(db, sql);
    if row == "" {
        return "";
    }
    // Get the first key's value from the row object
    // Since we can't iterate object keys in the current type system,
    // we return the whole row and let the caller extract what they need.
    return row;
}

/// Helper: execute an INSERT statement and return the number of rows affected.
pub fn insert<T: Database>(db: T, table: str, values: str) -> i64 {
    var sql = "INSERT INTO ";
    sql = sql + table + " VALUES " + values;
    return db.exec(sql);
}

/// Helper: execute a DELETE statement and return rows affected.
pub fn delete<T: Database>(db: T, table: str, condition: str) -> i64 {
    var sql = "DELETE FROM ";
    sql = sql + table + " WHERE " + condition;
    return db.exec(sql);
}

/// Helper: execute an UPDATE statement and return rows affected.
pub fn update<T: Database>(db: T, table: str, set_clause: str, condition: str) -> i64 {
    var sql = "UPDATE ";
    sql = sql + table + " SET " + set_clause + " WHERE " + condition;
    return db.exec(sql);
}

// ─── ORM via comptime (Phase 15.2) ────────────────────────────────────────
//
// In GC languages, ORMs use runtime reflection to map rows to structs.
// Fides uses comptime + @derive to replace reflection entirely.
// Types are known at compile time; code is generated at compile time;
// zero runtime overhead.
//
// Since Fides doesn't yet have full comptime code generation for
// arbitrary schema inference, these functions provide a typed query
// builder API that can be used with comptime in the future.

/// Typed query builder — builds SQL queries with type-safe parameters.
/// Parameters are passed as JSON to avoid SQL injection.
///
/// Example:
///   use db;
///   var conn = db::new();
///   var qb = query_builder("SELECT * FROM users WHERE id = ?");
///   qb = qb_param(qb, "1");
///   var rows = conn.query(qb);
pub fn query_builder(sql: str) -> str {
    return sql;
}

/// Add a parameter to a query builder. Returns the updated query.
/// In a full implementation, this would use prepared statements.
/// For now, it does simple string substitution (safe for integer params).
pub fn qb_param(query: str, param: str) -> str {
    // Replace the first ? with the parameter
    var idx = str_find(query, "?");
    if idx < 0 { return query; }
    var before = str_slice(query, 0, idx);
    var after = str_slice(query, idx + 1, str_len(query));
    return before + param + after;
}

/// Add an integer parameter to a query builder.
pub fn qb_param_i64(query: str, param: i64) -> str {
    return qb_param(query, int_to_str(param));
}

/// Build an INSERT query from a table name and column/value pairs.
/// columns: JSON array of column names (e.g. ["name", "age"])
/// values: JSON array of values (e.g. ["Alice", 30])
/// Returns: INSERT INTO table (col1, col2) VALUES (val1, val2)
pub fn build_insert(table: str, columns: str, values: str) -> str {
    var sql = "INSERT INTO " + table + " (";
    var n = json_len(columns);
    var i = 0;
    while i < n {
        if i > 0 { sql = sql + ", "; }
        sql = sql + json_at(columns, i);
        i = i + 1;
    }
    sql = sql + ") VALUES (";
    i = 0;
    while i < n {
        if i > 0 { sql = sql + ", "; }
        sql = sql + json_at(values, i);
        i = i + 1;
    }
    sql = sql + ")";
    return sql;
}

/// Build a SELECT query from a table name and optional columns.
/// columns: JSON array of column names, or "" for *
/// where_clause: optional WHERE clause (e.g. "id = 1"), or ""
/// Returns: SELECT col1, col2 FROM table [WHERE clause]
pub fn build_select(table: str, columns: str, where_clause: str) -> str {
    var sql = "SELECT ";
    if str_len(columns) == 0 {
        sql = sql + "*";
    } else {
        var n = json_len(columns);
        var i = 0;
        while i < n {
            if i > 0 { sql = sql + ", "; }
            sql = sql + json_at(columns, i);
            i = i + 1;
        }
    }
    sql = sql + " FROM " + table;
    if str_len(where_clause) > 0 {
        sql = sql + " WHERE " + where_clause;
    }
    return sql;
}

/// Build an UPDATE query from a table name, SET clause, and WHERE clause.
pub fn build_update(table: str, set_clause: str, where_clause: str) -> str {
    var sql = "UPDATE " + table + " SET " + set_clause;
    if str_len(where_clause) > 0 {
        sql = sql + " WHERE " + where_clause;
    }
    return sql;
}

/// Build a DELETE query from a table name and WHERE clause.
pub fn build_delete(table: str, where_clause: str) -> str {
    var sql = "DELETE FROM " + table;
    if str_len(where_clause) > 0 {
        sql = sql + " WHERE " + where_clause;
    }
    return sql;
}

// ─── Schema inference (comptime-ready) ───────────────────────────────────
//
// When comptime reflection is fully available, `comptime schema("users")`
// will read the table schema at compile time and generate a typed struct
// + query functions. For now, these functions provide the runtime API
// that comptime code will call.

/// Get the schema of a table as JSON.
/// Returns: [{"name": "id", "type": "INTEGER"}, {"name": "name", "type": "TEXT"}, ...]
pub fn get_schema<T: Database>(db: T, table: str) -> str {
    return db.query("PRAGMA table_info(" + table + ")");
}

/// Check if a table exists.
pub fn table_exists<T: Database>(db: T, table: str) -> bool {
    var result = db.query("SELECT name FROM sqlite_master WHERE type='table' AND name='" + table + "'");
    return json_len(result) > 0;
}

/// Create a table from a schema definition.
/// schema: JSON array of column definitions
///   [{"name": "id", "type": "INTEGER PRIMARY KEY"}, {"name": "name", "type": "TEXT"}]
pub fn create_table<T: Database>(db: T, table: str, schema: str) -> i64 {
    var sql = "CREATE TABLE IF NOT EXISTS " + table + " (";
    var n = json_len(schema);
    var i = 0;
    while i < n {
        if i > 0 { sql = sql + ", "; }
        var col = json_at(schema, i);
        var col_name = json_get(col, "name");
        var col_type = json_get(col, "type");
        sql = sql + col_name + " " + col_type;
        i = i + 1;
    }
    sql = sql + ")";
    return db.exec(sql);
}
