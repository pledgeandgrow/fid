// stdlib/memo.fd — Memoization helper
//
// A simple cache using parallel Vecs for keys and values.
// This is a stdlib helper, not a compiler annotation.
//
// Usage:
//   value cache = Memo::new();
//   value result = Memo::get_or_compute(&cache, 42, fib);

struct Memo {
    keys: Vec<i64>,
    values: Vec<i64>,
}

impl Memo {
    /// An empty cache.
    ///
    /// Example:
    ///   fn square(x: i64) -> i64 { return x * x; }
    ///   fn main() -> i64 {
    ///       var m = Memo::new();
    ///       assert_eq(m.get_or_compute(4, square), 16);
    ///       assert_eq(m.get_or_compute(4, square), 16);
    ///       assert_eq(m.get_or_compute(5, square), 25);
    ///       return 0;
    ///   }
    pub fn new() -> Memo {
        return Memo {
            keys: Vec::new(), values: Vec::new()
        };
    }

    pub fn get_or_compute(self: &mut Memo, key: i64, compute: fn(i64) -> i64) -> i64 {
        // Check if key is already cached
        for i in 0..self.keys.len() {
            if self.keys[i] == key {
                return self.values[i];
            }
        }
        // Not found — compute and cache
        var value = compute(key);
        self.keys.push(key);
        self.values.push(value);
        return value;
    }

    pub fn size(self) -> i64 {
        return self.keys.len();
    }

    pub fn clear(self: &mut Memo) {
        self.keys.clear();
        self.values.clear();
    }
}
