// stdlib/memo.fd — Memoization helper
//
// A simple cache using parallel Vecs for keys and values.
// This is a stdlib helper, not a compiler annotation.
//
// Usage:
//   value cache = Memo::new();
//   value result = Memo::get_or_compute(&cache, 42, fib);

struct Memo {
    keys: Vec<i64>,
    values: Vec<i64>,
}

impl Memo {
    pub fn new() -> Memo {
        return Memo { keys: Vec::new(), values: Vec::new() };
    }

    pub fn get_or_compute(self, key: i64, compute: fn(i64) -> i64) -> i64 {
        // Check if key is already cached
        for i in 0..self.keys.len() {
            if self.keys[i] == key {
                return self.values[i];
            }
        }
        // Not found — compute and cache
        val value = compute(key);
        self.keys.push(key);
        self.values.push(value);
        return value;
    }

    pub fn size(self) -> i64 {
        return self.keys.len();
    }

    pub fn clear(self) {
        self.keys.clear();
        self.values.clear();
    }
}
