// stdlib/memo.fd — Memoization helper
//
// A simple cache using parallel Vecs for keys and values.
// This is a stdlib helper, not a compiler annotation.
//
// Usage:
//   pv cache = Memo::new();
//   pv result = Memo::get_or_compute(&cache, 42, fib);

struct Memo {
    keys: Vec<i64>,
    values: Vec<i64>,
}

impl Memo {
    pub pf new() -> Memo {
        ret Memo { keys: Vec::new(), values: Vec::new() };
    }

    pub pf get_or_compute(self, key: i64, compute: pf(i64) -> i64) -> i64 {
        // Check if key is already cached
        for i in 0..self.keys.len() {
            if self.keys[i] == key {
                ret self.values[i];
            }
        }
        // Not found — compute and cache
        pv value = compute(key);
        self.keys.push(key);
        self.values.push(value);
        ret value;
    }

    pub pf size(self) -> i64 {
        ret self.keys.len();
    }

    pub pf clear(self) {
        self.keys.clear();
        self.values.clear();
    }
}
