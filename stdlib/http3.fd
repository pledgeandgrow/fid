// Fides HTTP/3 (RFC 9114) over stdlib/quic_conn.fd, pure Fides
//
// The HTTP/3 layer of one QUIC connection, client or server, without I/O:
// it reads and writes the connection's streams (quic_stream_read /
// quic_stream_write); the program, or stdlib/http3_udp.fd, moves the
// connection's datagrams. Call h3_poll after every quic_conn_recv /
// quic_conn_on_timeout, and quic_conn_send after h3_poll.
//   - The control stream with SETTINGS (QPACK_MAX_TABLE_CAPACITY 0,
//     MAX_FIELD_SECTION_SIZE, QPACK_BLOCKED_STREAMS 0), and the QPACK
//     encoder and decoder streams (stdlib/qpack.fd: static table only, so
//     both stay empty on our side and are checked on the peer's).
//   - Requests and responses on bidirectional streams: HEADERS, DATA,
//     trailers, interim (1xx) responses, unknown and reserved frame and
//     stream types skipped (§9), the frame-sequence, field and
//     content-length rules of §4 (H3_FRAME_UNEXPECTED, H3_MESSAGE_ERROR,
//     ...), stream errors as RESET_STREAM / STOP_SENDING, connection errors
//     as CONNECTION_CLOSE with the HTTP/3 code (§8).
//   - SETTINGS, GOAWAY, MAX_PUSH_ID and CANCEL_PUSH on the control stream
//     with their checks (§7.2); GOAWAY for a graceful shutdown (§5.2).
//   - Not here: server push (a client never sends MAX_PUSH_ID, so a server
//     may not push; a server never pushes), the QPACK dynamic table,
//     extended CONNECT, HTTP datagrams, priorities (RFC 9218: the
//     `priority` field is passed through untouched).
//
// Usage (client), with q a QuicConn from quic_connect (ALPN "h3"):
//   var h: H3Conn = h3_new(false);
//   ... every time datagrams arrived: h3_poll(& mut h, & mut q);
//   val id: i64 = h3_request(& mut h, & mut q, "GET", "https", "example.org", "/", names, values, body);
//   ... when h3_done(& h, id): val m: H3Message = h3_response(& mut h, id);
//       m.ok, m.status, m.names / m.values, m.body
// Usage (server), with q from quic_accept:
//   var h: H3Conn = h3_new(true);
//   h3_poll(& mut h, & mut q);
//   val ids: Vec<i64> = h3_requests(& mut h);    // complete requests
//   val m: H3Message = h3_message(& h, id);      // m.method, m.path, ...
//   h3_respond(& mut h, & mut q, id, 200, names, values, body);
//
// Checked by tests/bootstrap/test_stdlib_http3.fd (a client and a server
// in one process over a lossy simulated network) and tests/net/http3_*.fd
// (over UDP, against curl and a public HTTP/3 server).

module http3;
 use vec; use string; use qpack; use quic; use quic_conn; use quic_frame;

// ─── Constants ──────────────────────────────────────────────────────────

/// Frame types (§7.2).
pub const H3F_DATA: i64 = 0x00;
pub const H3F_HEADERS: i64 = 0x01;
pub const H3F_CANCEL_PUSH: i64 = 0x03;
pub const H3F_SETTINGS: i64 = 0x04;
pub const H3F_PUSH_PROMISE: i64 = 0x05;
pub const H3F_GOAWAY: i64 = 0x07;
pub const H3F_MAX_PUSH_ID: i64 = 0x0d;

/// Unidirectional stream types (§6.2, RFC 9204 §4.2).
pub const H3_STREAM_CONTROL: i64 = 0x00;
pub const H3_STREAM_PUSH: i64 = 0x01;
pub const H3_STREAM_QPACK_ENCODER: i64 = 0x02;
pub const H3_STREAM_QPACK_DECODER: i64 = 0x03;

/// Settings (§7.2.4.1, RFC 9204 §5).
pub const H3_SETTING_QPACK_MAX_TABLE_CAPACITY: i64 = 0x01;
pub const H3_SETTING_MAX_FIELD_SECTION_SIZE: i64 = 0x06;
pub const H3_SETTING_QPACK_BLOCKED_STREAMS: i64 = 0x07;

/// Error codes (§8.1); QPACK's are in stdlib/qpack.fd.
pub const H3_NO_ERROR: i64 = 0x100;
pub const H3_GENERAL_PROTOCOL_ERROR: i64 = 0x101;
pub const H3_INTERNAL_ERROR: i64 = 0x102;
pub const H3_STREAM_CREATION_ERROR: i64 = 0x103;
pub const H3_CLOSED_CRITICAL_STREAM: i64 = 0x104;
pub const H3_FRAME_UNEXPECTED: i64 = 0x105;
pub const H3_FRAME_ERROR: i64 = 0x106;
pub const H3_EXCESSIVE_LOAD: i64 = 0x107;
pub const H3_ID_ERROR: i64 = 0x108;
pub const H3_SETTINGS_ERROR: i64 = 0x109;
pub const H3_MISSING_SETTINGS: i64 = 0x10a;
pub const H3_REQUEST_REJECTED: i64 = 0x10b;
pub const H3_REQUEST_CANCELLED: i64 = 0x10c;
pub const H3_REQUEST_INCOMPLETE: i64 = 0x10d;
pub const H3_MESSAGE_ERROR: i64 = 0x10e;
pub const H3_CONNECT_ERROR: i64 = 0x10f;
pub const H3_VERSION_FALLBACK: i64 = 0x110;

/// States of a request stream.
pub const H3ST_HEADERS: i64 = 0;
pub const H3ST_BODY: i64 = 1;
pub const H3ST_TRAILERS: i64 = 2;
pub const H3ST_DONE: i64 = 3;
pub const H3ST_FAILED: i64 = 4;

/// The field section size we accept (SETTINGS_MAX_FIELD_SECTION_SIZE).
pub const H3_DEFAULT_MAX_FIELD_SECTION: i64 = 65536;
/// The largest control frame we buffer (SETTINGS with many entries).
const H3_MAX_CONTROL_FRAME: i64 = 16384;

// ─── Types ──────────────────────────────────────────────────────────────

/// A request (at a server) or a response (at a client).
///   - `ok` once the whole message arrived and is well-formed; else
///     `error` is -1 (not complete yet) or the HTTP/3 error code the stream
///     failed with (ours or the peer's RESET_STREAM), `why` says why;
///   - a request's `method`, `scheme`, `authority`, `path`; a response's
///     `status` and how many interim (1xx) responses came before it;
///   - `names` / `values`: the other fields, in order; `body`; trailers.
pub struct H3Message {
    pub ok: bool,
    pub error: i64,
    pub why: str,
    pub status: i64,
    pub interim: i64,
    pub method: str,
    pub scheme: str,
    pub authority: str,
    pub path: str,
    pub names: Vec<str>,
    pub values: Vec<str>,
    pub body: Vec<i64>,
    pub trailer_names: Vec<str>,
    pub trailer_values: Vec<str>,
}

/// A request stream: bytes not parsed yet (`buf` from `pos`), the DATA
/// frame or unknown frame being read (`data_left` / `skip_left` bytes to
/// come), the message so far.
pub struct H3Stream {
    pub id: i64,
    pub buf: Vec<i64>,
    pub pos: i64,
    pub data_left: i64,
    pub skip_left: i64,
    pub state: i64,
    pub msg: H3Message,
    pub content_length: i64,
    pub req_method: str,
    pub given: bool,
}

/// A unidirectional stream the peer opened; `stype` -1 until its type
/// arrived.
pub struct H3Uni {
    pub id: i64,
    pub stype: i64,
    pub buf: Vec<i64>,
    pub pos: i64,
    pub skip_left: i64,
    pub got_settings: bool,
}

/// The HTTP/3 state of one connection.
///   - `error` -1, or the HTTP/3 error code we closed the connection with
///     (`why`); the peer's close is in the QuicConn (`error`, `why`);
///   - `peer_settings` once the peer's SETTINGS arrived, with
///     `peer_max_field_section` (-1: no limit);
///   - `goaway_recv` / `goaway_sent`: -1, or the id of a GOAWAY.
pub struct H3Conn {
    pub server: bool,
    pub started: bool,
    pub ctrl_id: i64,
    pub enc_id: i64,
    pub dec_id: i64,
    pub peer_ctrl: i64,
    pub peer_enc: i64,
    pub peer_dec: i64,
    pub peer_settings: bool,
    pub peer_max_field_section: i64,
    pub peer_qpack_capacity: i64,
    pub peer_blocked_streams: i64,
    pub max_field_section: i64,
    pub huffman: bool,
    pub unis: Vec<H3Uni>,
    pub streams: Vec<H3Stream>,
    pub goaway_recv: i64,
    pub goaway_sent: i64,
    pub max_push_id_peer: i64,
    pub highest_request: i64,
    pub error: i64,
    pub why: str,
}

struct H3Hdr {
    ok: bool,
    ftype: i64,
    len: i64,
    hlen: i64,
}

// ─── Small helpers ──────────────────────────────────────────────────────

fn h3_none() -> Vec<i64> {
    var none: Vec<i64> = Vec::new();
    return none;
}

fn h3_put(out: & mut Vec<i64>, v: Vec<i64>) {
    var i: i64 = 0;
    while i < v.len() {
        out.push(v.get(i) & 255);
        i = i + 1;
    }
}

/// The bytes of `b` from `from` on.
fn h3_tail(b: Vec<i64>, from: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = from;
    while i < b.len() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}

fn h3_msg_new() -> H3Message {
    return H3Message {
        ok: false, error: - 1, why: "", status: 0, interim: 0, method: "", scheme: "", authority: "", path: "",
        names: Vec::new(), values: Vec::new(), body: Vec::new(), trailer_names: Vec::new(), trailer_values: Vec::new(),
    };
}

fn h3_stream_new(id: i64, method: str) -> H3Stream {
    return H3Stream {
        id: id, buf: Vec::new(), pos: 0, data_left: 0, skip_left: 0, state: H3ST_HEADERS, msg: h3_msg_new(),
        content_length: - 1, req_method: method, given: false,
    };
}

/// One frame: its type, length and payload (§7.1).
pub fn h3_frame(ftype: i64, payload: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    h3_put(& mut out, quic_varint_encode(ftype));
    h3_put(& mut out, quic_varint_encode(payload.len()));
    h3_put(& mut out, payload);
    return out;
}

/// A SETTINGS frame from parallel lists of identifiers and values.
pub fn h3_settings_frame(ids: Vec<i64>, vals: Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < ids.len() {
        h3_put(& mut p, quic_varint_encode(ids.get(i)));
        h3_put(& mut p, quic_varint_encode(vals.get(i)));
        i = i + 1;
    }
    return h3_frame(H3F_SETTINGS, p);
}

/// A frame whose payload is one varint (GOAWAY, MAX_PUSH_ID, CANCEL_PUSH).
pub fn h3_varint_frame(ftype: i64, v: i64) -> Vec<i64> {
    return h3_frame(ftype, quic_varint_encode(v));
}

/// A frame header at `pos`: `ok` false while it is cut short.
fn h3_hdr(b: Vec<i64>, pos: i64) -> H3Hdr {
    val t: QuicVarint = quic_varint_decode(b, pos);
    if !t.ok {
        return H3Hdr { ok: false, ftype: 0, len: 0, hlen: 0 };
    }
    val l: QuicVarint = quic_varint_decode(b, pos + t.len);
    if !l.ok {
        return H3Hdr { ok: false, ftype: 0, len: 0, hlen: 0 };
    }
    return H3Hdr { ok: true, ftype: t.value, len: l.value, hlen: t.len + l.len };
}

/// HTTP/2 frame types reserved in HTTP/3 (§7.2.8): receiving one is
/// H3_FRAME_UNEXPECTED.
fn h3_h2_frame(t: i64) -> bool {
    return t == 0x02 || t == 0x06 || t == 0x08 || t == 0x09;
}

/// The name of an HTTP/3 or QPACK error code.
pub fn h3_error_name(code: i64) -> str {
    if code == H3_NO_ERROR { return "H3_NO_ERROR"; }
    if code == H3_GENERAL_PROTOCOL_ERROR { return "H3_GENERAL_PROTOCOL_ERROR"; }
    if code == H3_INTERNAL_ERROR { return "H3_INTERNAL_ERROR"; }
    if code == H3_STREAM_CREATION_ERROR { return "H3_STREAM_CREATION_ERROR"; }
    if code == H3_CLOSED_CRITICAL_STREAM { return "H3_CLOSED_CRITICAL_STREAM"; }
    if code == H3_FRAME_UNEXPECTED { return "H3_FRAME_UNEXPECTED"; }
    if code == H3_FRAME_ERROR { return "H3_FRAME_ERROR"; }
    if code == H3_EXCESSIVE_LOAD { return "H3_EXCESSIVE_LOAD"; }
    if code == H3_ID_ERROR { return "H3_ID_ERROR"; }
    if code == H3_SETTINGS_ERROR { return "H3_SETTINGS_ERROR"; }
    if code == H3_MISSING_SETTINGS { return "H3_MISSING_SETTINGS"; }
    if code == H3_REQUEST_REJECTED { return "H3_REQUEST_REJECTED"; }
    if code == H3_REQUEST_CANCELLED { return "H3_REQUEST_CANCELLED"; }
    if code == H3_REQUEST_INCOMPLETE { return "H3_REQUEST_INCOMPLETE"; }
    if code == H3_MESSAGE_ERROR { return "H3_MESSAGE_ERROR"; }
    if code == H3_CONNECT_ERROR { return "H3_CONNECT_ERROR"; }
    if code == H3_VERSION_FALLBACK { return "H3_VERSION_FALLBACK"; }
    if code == QPACK_DECOMPRESSION_FAILED { return "QPACK_DECOMPRESSION_FAILED"; }
    if code == QPACK_ENCODER_STREAM_ERROR { return "QPACK_ENCODER_STREAM_ERROR"; }
    if code == QPACK_DECODER_STREAM_ERROR { return "QPACK_DECODER_STREAM_ERROR"; }
    return "0x" + h3_hex(code);
}

fn h3_hex(v: i64) -> str {
    if v == 0 {
        return "0";
    }
    val digits: str = "0123456789abcdef";
    var out: Vec<i64> = Vec::new();
    var x: i64 = v;
    while x > 0 {
        out.push(str_byte_at(digits, x & 15));
        x = x >> 4;
    }
    var rev: Vec<i64> = Vec::new();
    var i: i64 = out.len() - 1;
    while i >= 0 {
        rev.push(out.get(i));
        i = i - 1;
    }
    return str_from_bytes(rev);
}

// ─── Fields (§4.2, §4.3) ────────────────────────────────────────────────

/// A field name is lowercase token characters (RFC 9110 §5.6.2); a
/// pseudo-header's starts with ':'.
fn h3_name_ok(n: str) -> bool {
    val len: i64 = str_len(n);
    if len == 0 {
        return false;
    }
    var i: i64 = 0;
    if str_byte_at(n, 0) == 58 {
        i = 1;
        if len == 1 {
            return false;
        }
    }
    while i < len {
        val c: i64 = str_byte_at(n, i);
        val lower: bool = c >= 97 && c <= 122;
        val digit: bool = c >= 48 && c <= 57;
        // ! # $ % & ' * + - . ^ _ ` | ~
        val sym: bool = c == 33 || (c >= 35 && c <= 39) || c == 42 || c == 43 || c == 45 || c == 46
            || c == 94 || c == 95 || c == 96 || c == 124 || c == 126;
        if !lower && !digit && !sym {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// A field value holds no NUL, CR or LF and does not start or end with
/// whitespace (RFC 9110 §5.5).
fn h3_value_ok(v: str) -> bool {
    val len: i64 = str_len(v);
    var i: i64 = 0;
    while i < len {
        val c: i64 = str_byte_at(v, i);
        if c == 0 || c == 10 || c == 13 {
            return false;
        }
        i = i + 1;
    }
    if len > 0 {
        val a: i64 = str_byte_at(v, 0);
        val z: i64 = str_byte_at(v, len - 1);
        if a == 32 || a == 9 || z == 32 || z == 9 {
            return false;
        }
    }
    return true;
}

fn h3_conn_field(n: str) -> bool {
    return n == "connection" || n == "keep-alive" || n == "proxy-connection" || n == "transfer-encoding" || n == "upgrade";
}

/// Check a request's, response's or trailers' fields (§4.2, §4.3): ""
/// when they are fine, else what is wrong (H3_MESSAGE_ERROR).
pub fn h3_check_fields(names: Vec<str>, vals: Vec<str>, request: bool, trailers: bool) -> str {
    var regular: bool = false;
    var method: str = "";
    var scheme: str = "";
    var authority: str = "";
    var host: str = "";
    var n_method: i64 = 0;
    var n_scheme: i64 = 0;
    var n_path: i64 = 0;
    var n_authority: i64 = 0;
    var n_status: i64 = 0;
    var n_host: i64 = 0;
    var i: i64 = 0;
    while i < names.len() {
        val n: str = names.get(i);
        val v: str = vals.get(i);
        if !h3_name_ok(n) {
            return "bad field name '" + n + "'";
        }
        if !h3_value_ok(v) {
            return "bad value of " + n;
        }
        if str_byte_at(n, 0) == 58 {
            if regular || trailers {
                return "pseudo-header " + n + " after a field or in trailers";
            }
            if request {
                if n == ":method" {
                    method = v;
                    n_method = n_method + 1;
                } else if n == ":scheme" {
                    scheme = v;
                    n_scheme = n_scheme + 1;
                } else if n == ":path" {
                    if v == "" {
                        return "empty :path";
                    }
                    n_path = n_path + 1;
                } else if n == ":authority" {
                    authority = v;
                    n_authority = n_authority + 1;
                } else {
                    return "unknown pseudo-header " + n;
                }
            } else {
                if n != ":status" {
                    return "unknown pseudo-header " + n;
                }
                n_status = n_status + 1;
                if str_len(v) != 3 || str_byte_at(v, 0) < 49 || str_byte_at(v, 0) > 53
                    || str_byte_at(v, 1) < 48 || str_byte_at(v, 1) > 57
                    || str_byte_at(v, 2) < 48 || str_byte_at(v, 2) > 57 {
                    return "bad :status " + v;
                }
            }
        } else {
            regular = true;
            if h3_conn_field(n) {
                return "connection-specific field " + n;
            }
            if n == "te" && v != "trailers" {
                return "te other than trailers";
            }
            if n == "host" {
                host = v;
                n_host = n_host + 1;
            }
        }
        i = i + 1;
    }
    if trailers {
        return "";
    }
    if !request {
        if n_status != 1 {
            return "a response needs one :status";
        }
        return "";
    }
    if n_method != 1 || method == "" {
        return "a request needs one :method";
    }
    if n_authority > 1 {
        return "two :authority";
    }
    if method == "CONNECT" {
        if n_scheme != 0 || n_path != 0 || n_authority != 1 || authority == "" {
            return "CONNECT needs :authority and no :scheme or :path";
        }
        return "";
    }
    if n_scheme != 1 || n_path != 1 || scheme == "" {
        return "a request needs one :scheme and one :path";
    }
    if scheme == "http" || scheme == "https" {
        if authority == "" && (n_host == 0 || host == "") {
            return "no :authority or host";
        }
        if authority != "" && n_host > 0 && host != authority {
            return ":authority and host differ";
        }
    }
    return "";
}

/// The content-length of a message (RFC 9110 §8.6): -1 when there is
/// none, -2 when a value is not a number or two values differ.
fn h3_content_length(names: Vec<str>, vals: Vec<str>) -> i64 {
    var cl: i64 = - 1;
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == "content-length" {
            val v: str = vals.get(i);
            val len: i64 = str_len(v);
            if len == 0 || len > 18 {
                return - 2;
            }
            var n: i64 = 0;
            var k: i64 = 0;
            while k < len {
                val c: i64 = str_byte_at(v, k);
                if c < 48 || c > 57 {
                    return - 2;
                }
                n = n * 10 + (c - 48);
                k = k + 1;
            }
            if cl >= 0 && cl != n {
                return - 2;
            }
            cl = n;
        }
        i = i + 1;
    }
    return cl;
}

fn h3_status_of(names: Vec<str>, vals: Vec<str>) -> i64 {
    var i: i64 = 0;
    while i < names.len() {
        if names.get(i) == ":status" {
            return str_parse_int(vals.get(i));
        }
        i = i + 1;
    }
    return 0;
}

/// The first value of field `name` in a message, "" if none.
pub fn h3_field(m: & H3Message, name: str) -> str {
    var i: i64 = 0;
    while i < m.names.len() {
        if m.names.get(i) == name {
            return m.values.get(i);
        }
        i = i + 1;
    }
    return "";
}

// ─── The connection ─────────────────────────────────────────────────────

/// HTTP/3 state for a connection; `server` as the QuicConn's.
pub fn h3_new(server: bool) -> H3Conn {
    return H3Conn {
        server: server, started: false, ctrl_id: - 1, enc_id: - 1, dec_id: - 1,
        peer_ctrl: - 1, peer_enc: - 1, peer_dec: - 1, peer_settings: false,
        peer_max_field_section: - 1, peer_qpack_capacity: 0, peer_blocked_streams: 0,
        max_field_section: H3_DEFAULT_MAX_FIELD_SECTION, huffman: true,
        unis: Vec::new(), streams: Vec::new(), goaway_recv: - 1, goaway_sent: - 1,
        max_push_id_peer: - 1, highest_request: - 1, error: - 1, why: "",
    };
}

/// Close the connection with an HTTP/3 error (§8).
pub fn h3_conn_error(h: & mut H3Conn, q: & mut QuicConn, code: i64, why: str) {
    if h.error >= 0 {
        return;
    }
    h.error = code;
    h.why = why;
    quic_conn_close(q, code, why, q.now);
}

/// Whether the HTTP/3 connection is over (our error or the QUIC
/// connection closing).
pub fn h3_failed(h: & H3Conn, q: & QuicConn) -> bool {
    return h.error >= 0 || quic_conn_done(q);
}

/// Index of request stream `id`, -1 if we do not track it.
pub fn h3_stream_index(h: & H3Conn, id: i64) -> i64 {
    var i: i64 = 0;
    while i < h.streams.len() {
        if h.streams.get(i).id == id {
            return i;
        }
        i = i + 1;
    }
    return - 1;
}

/// Fail a request stream with an HTTP/3 error: STOP_SENDING and
/// RESET_STREAM with `code` (§4.1.2, §8).
fn h3_stream_fail(h: & mut H3Conn, q: & mut QuicConn, k: i64, code: i64, why: str) {
    h3_stream_fail_as(h, q, k, code, code, why);
}

/// As h3_stream_fail, the message failing with `code` and the stream
/// reset with `sent`.
fn h3_stream_fail_as(h: & mut H3Conn, q: & mut QuicConn, k: i64, code: i64, sent: i64, why: str) {
    var s: H3Stream = h.streams.get(k);
    if s.state == H3ST_FAILED {
        return;
    }
    s.state = H3ST_FAILED;
    s.msg.ok = false;
    s.msg.error = code;
    s.msg.why = why;
    h.streams.set(k, s);
    quic_stream_stop(q, s.id, sent);
    quic_stream_reset(q, s.id, sent);
}

/// Open our control stream (with SETTINGS) and QPACK streams once the
/// connection can carry them.
fn h3_start(h: & mut H3Conn, q: & mut QuicConn) {
    if h.started || !quic_conn_established(q) {
        return;
    }
    if q.max_streams_uni_peer - q.local_uni_opened < 3 {
        return;
    }
    h.ctrl_id = quic_open_uni(q);
    h.enc_id = quic_open_uni(q);
    h.dec_id = quic_open_uni(q);
    if h.ctrl_id < 0 || h.enc_id < 0 || h.dec_id < 0 {
        h3_conn_error(h, q, H3_INTERNAL_ERROR, "cannot open the control streams");
        return;
    }
    var ctrl: Vec<i64> = Vec::new();
    ctrl.push(H3_STREAM_CONTROL);
    var ids: Vec<i64> = Vec::new();
    var vals: Vec<i64> = Vec::new();
    ids.push(H3_SETTING_QPACK_MAX_TABLE_CAPACITY);
    vals.push(0);
    ids.push(H3_SETTING_MAX_FIELD_SECTION_SIZE);
    vals.push(h.max_field_section);
    ids.push(H3_SETTING_QPACK_BLOCKED_STREAMS);
    vals.push(0);
    h3_put(& mut ctrl, h3_settings_frame(ids, vals));
    quic_stream_write(q, h.ctrl_id, ctrl, false);
    var enc: Vec<i64> = Vec::new();
    enc.push(H3_STREAM_QPACK_ENCODER);
    quic_stream_write(q, h.enc_id, enc, false);
    var dec: Vec<i64> = Vec::new();
    dec.push(H3_STREAM_QPACK_DECODER);
    quic_stream_write(q, h.dec_id, dec, false);
    h.started = true;
}

/// Move the HTTP/3 state on: open our control streams, take the streams
/// the peer opened, read the control and QPACK streams, read requests or
/// responses. Call after every quic_conn_recv / quic_conn_on_timeout.
pub fn h3_poll(h: & mut H3Conn, q: & mut QuicConn) {
    if h.error >= 0 || quic_conn_done(q) {
        return;
    }
    h3_start(h, q);
    val fresh: Vec<i64> = quic_accept_streams(q);
    var f: i64 = 0;
    while f < fresh.len() && h.error < 0 {
        val id: i64 = fresh.get(f);
        if (id & 2) != 0 {
            h.unis.push(H3Uni { id: id, stype: - 1, buf: Vec::new(), pos: 0, skip_left: 0, got_settings: false });
        } else if !h.server {
            h3_conn_error(h, q, H3_STREAM_CREATION_ERROR, "a server-initiated bidirectional stream");
        } else if h.goaway_sent >= 0 && id >= h.goaway_sent {
            // After our GOAWAY: not processed, the client may retry it
            quic_stream_stop(q, id, H3_REQUEST_REJECTED);
            quic_stream_reset(q, id, H3_REQUEST_REJECTED);
        } else {
            h.streams.push(h3_stream_new(id, ""));
            if id > h.highest_request {
                h.highest_request = id;
            }
        }
        f = f + 1;
    }
    var k: i64 = 0;
    while k < h.unis.len() && h.error < 0 {
        if h3_uni_run(h, q, k) {
            k = k + 1;
        } else {
            h.unis.remove(k);
        }
    }
    k = 0;
    while k < h.streams.len() && h.error < 0 {
        h3_stream_run(h, q, k);
        k = k + 1;
    }
    // A server forgets requests that failed: the application never saw them
    if h.server {
        k = 0;
        while k < h.streams.len() {
            if h.streams.get(k).state == H3ST_FAILED {
                h.streams.remove(k);
            } else {
                k = k + 1;
            }
        }
    }
}

// ─── Unidirectional streams (§6.2) ──────────────────────────────────────

fn h3_critical(t: i64) -> bool {
    return t == H3_STREAM_CONTROL || t == H3_STREAM_QPACK_ENCODER || t == H3_STREAM_QPACK_DECODER;
}

/// Read one of the peer's unidirectional streams. False when it is over
/// and can be forgotten.
fn h3_uni_run(h: & mut H3Conn, q: & mut QuicConn, k: i64) -> bool {
    var u: H3Uni = h.unis.get(k);
    val id: i64 = u.id;
    val gone: bool = quic_stream_index(q, id) < 0;
    val rc: i64 = quic_stream_reset_code(q, id);
    h3_put(& mut u.buf, quic_stream_read(q, id));
    val fin: bool = quic_stream_finished(q, id);
    val closed: bool = gone || fin || rc >= 0;
    if u.stype == - 1 {
        val t: QuicVarint = quic_varint_decode(u.buf, u.pos);
        if !t.ok {
            h.unis.set(k, u);
            // A stream closed before its type is ignored (§6.2)
            return !closed;
        }
        u.pos = u.pos + t.len;
        u.stype = t.value;
        if t.value == H3_STREAM_CONTROL {
            if h.peer_ctrl >= 0 {
                h3_conn_error(h, q, H3_STREAM_CREATION_ERROR, "a second control stream");
                return false;
            }
            h.peer_ctrl = id;
        } else if t.value == H3_STREAM_QPACK_ENCODER {
            if h.peer_enc >= 0 {
                h3_conn_error(h, q, H3_STREAM_CREATION_ERROR, "a second QPACK encoder stream");
                return false;
            }
            h.peer_enc = id;
        } else if t.value == H3_STREAM_QPACK_DECODER {
            if h.peer_dec >= 0 {
                h3_conn_error(h, q, H3_STREAM_CREATION_ERROR, "a second QPACK decoder stream");
                return false;
            }
            h.peer_dec = id;
        } else if t.value == H3_STREAM_PUSH {
            if h.server {
                h3_conn_error(h, q, H3_STREAM_CREATION_ERROR, "a push stream from the client");
            } else {
                h3_conn_error(h, q, H3_ID_ERROR, "a push stream without MAX_PUSH_ID");
            }
            return false;
        } else {
            // Unknown or reserved type: not read (§6.2, §9)
            quic_stream_stop(q, id, H3_STREAM_CREATION_ERROR);
        }
    }
    val t: i64 = u.stype;
    if h3_critical(t) && closed {
        h3_conn_error(h, q, H3_CLOSED_CRITICAL_STREAM, "the peer closed a critical stream");
        return false;
    }
    if t == H3_STREAM_CONTROL {
        h3_control_frames(h, q, & mut u);
    } else if t == H3_STREAM_QPACK_ENCODER {
        val sc: QpackScan = qpack_encoder_stream_scan(u.buf, u.pos, 0);
        if sc.status == QPACK_SCAN_ERROR {
            h3_conn_error(h, q, sc.error, sc.why);
            return false;
        }
        u.pos = u.pos + sc.used;
    } else if t == H3_STREAM_QPACK_DECODER {
        val sc: QpackScan = qpack_decoder_stream_scan(u.buf, u.pos);
        if sc.status == QPACK_SCAN_ERROR {
            h3_conn_error(h, q, sc.error, sc.why);
            return false;
        }
        u.pos = u.pos + sc.used;
    } else {
        u.pos = u.buf.len();
    }
    if h.error >= 0 {
        return false;
    }
    if u.pos >= u.buf.len() {
        u.buf = Vec::new();
        u.pos = 0;
    } else if u.pos > 4096 {
        u.buf = h3_tail(u.buf, u.pos);
        u.pos = 0;
    }
    h.unis.set(k, u);
    if !h3_critical(t) && closed {
        return false;
    }
    return true;
}

/// The payload of a frame whose whole length arrived.
fn h3_payload(b: Vec<i64>, from: i64, len: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < len {
        out.push(b.get(from + i));
        i = i + 1;
    }
    return out;
}

/// A payload that must be exactly one varint: its value, -1 if it is not.
fn h3_one_varint(p: Vec<i64>) -> i64 {
    val v: QuicVarint = quic_varint_decode(p, 0);
    if !v.ok || v.len != p.len() {
        return - 1;
    }
    return v.value;
}

/// The frames of the peer's control stream (§6.2.1, §7.2).
fn h3_control_frames(h: & mut H3Conn, q: & mut QuicConn, u: & mut H3Uni) {
    while h.error < 0 {
        if u.skip_left > 0 {
            var n: i64 = u.buf.len() - u.pos;
            if n > u.skip_left {
                n = u.skip_left;
            }
            u.pos = u.pos + n;
            u.skip_left = u.skip_left - n;
            if u.skip_left > 0 {
                return;
            }
        }
        val hd: H3Hdr = h3_hdr(u.buf, u.pos);
        if !hd.ok {
            return;
        }
        val t: i64 = hd.ftype;
        if !u.got_settings && t != H3F_SETTINGS {
            h3_conn_error(h, q, H3_MISSING_SETTINGS, "the control stream does not start with SETTINGS");
            return;
        }
        if t == H3F_DATA || t == H3F_HEADERS || t == H3F_PUSH_PROMISE || h3_h2_frame(t) {
            h3_conn_error(h, q, H3_FRAME_UNEXPECTED, "frame type " + int_to_str(t) + " on the control stream");
            return;
        }
        val known: bool = t == H3F_SETTINGS || t == H3F_GOAWAY || t == H3F_MAX_PUSH_ID || t == H3F_CANCEL_PUSH;
        if !known {
            u.pos = u.pos + hd.hlen;
            u.skip_left = hd.len;
        } else {
            if hd.len > H3_MAX_CONTROL_FRAME {
                h3_conn_error(h, q, H3_EXCESSIVE_LOAD, "control frame of " + int_to_str(hd.len) + " bytes");
                return;
            }
            if u.pos + hd.hlen + hd.len > u.buf.len() {
                return;
            }
            val p: Vec<i64> = h3_payload(u.buf, u.pos + hd.hlen, hd.len);
            u.pos = u.pos + hd.hlen + hd.len;
            if t == H3F_SETTINGS {
                if u.got_settings {
                    h3_conn_error(h, q, H3_FRAME_UNEXPECTED, "a second SETTINGS");
                    return;
                }
                u.got_settings = true;
                h3_apply_settings(h, q, p);
            } else {
                val v: i64 = h3_one_varint(p);
                if v < 0 {
                    h3_conn_error(h, q, H3_FRAME_ERROR, "malformed frame type " + int_to_str(t));
                    return;
                }
                if t == H3F_GOAWAY {
                    h3_on_goaway(h, q, v);
                } else if t == H3F_MAX_PUSH_ID {
                    if !h.server {
                        h3_conn_error(h, q, H3_FRAME_UNEXPECTED, "MAX_PUSH_ID from the server");
                        return;
                    }
                    if v < h.max_push_id_peer {
                        h3_conn_error(h, q, H3_ID_ERROR, "MAX_PUSH_ID went down");
                        return;
                    }
                    h.max_push_id_peer = v;
                } else {
                    // CANCEL_PUSH: we never push, and a client never
                    // allows a push
                    if !h.server || v > h.max_push_id_peer {
                        h3_conn_error(h, q, H3_ID_ERROR, "CANCEL_PUSH of a push id never allowed");
                        return;
                    }
                }
            }
        }
    }
}

/// The peer's SETTINGS (§7.2.4).
fn h3_apply_settings(h: & mut H3Conn, q: & mut QuicConn, p: Vec<i64>) {
    var seen: Vec<i64> = Vec::new();
    var pos: i64 = 0;
    while pos < p.len() {
        val id: QuicVarint = quic_varint_decode(p, pos);
        if !id.ok {
            h3_conn_error(h, q, H3_FRAME_ERROR, "malformed SETTINGS");
            return;
        }
        val v: QuicVarint = quic_varint_decode(p, pos + id.len);
        if !v.ok {
            h3_conn_error(h, q, H3_FRAME_ERROR, "malformed SETTINGS");
            return;
        }
        pos = pos + id.len + v.len;
        val sid: i64 = id.value;
        if sid == 0x00 || sid == 0x02 || sid == 0x03 || sid == 0x04 || sid == 0x05 {
            h3_conn_error(h, q, H3_SETTINGS_ERROR, "HTTP/2 setting " + int_to_str(sid));
            return;
        }
        var i: i64 = 0;
        while i < seen.len() {
            if seen.get(i) == sid {
                h3_conn_error(h, q, H3_SETTINGS_ERROR, "setting " + int_to_str(sid) + " twice");
                return;
            }
            i = i + 1;
        }
        seen.push(sid);
        if sid == H3_SETTING_QPACK_MAX_TABLE_CAPACITY {
            h.peer_qpack_capacity = v.value;
        } else if sid == H3_SETTING_MAX_FIELD_SECTION_SIZE {
            h.peer_max_field_section = v.value;
        } else if sid == H3_SETTING_QPACK_BLOCKED_STREAMS {
            h.peer_blocked_streams = v.value;
        }
    }
    h.peer_settings = true;
}

/// A GOAWAY from the peer (§5.2): a server's names the first client
/// request it did not and will not process.
fn h3_on_goaway(h: & mut H3Conn, q: & mut QuicConn, v: i64) {
    if !h.server {
        if (v & 3) != 0 {
            h3_conn_error(h, q, H3_ID_ERROR, "GOAWAY with a stream id that is not a client request");
            return;
        }
        if h.goaway_recv >= 0 && v > h.goaway_recv {
            h3_conn_error(h, q, H3_ID_ERROR, "GOAWAY id went up");
            return;
        }
        h.goaway_recv = v;
        var k: i64 = 0;
        while k < h.streams.len() {
            val s: H3Stream = h.streams.get(k);
            if s.id >= v && s.state < H3ST_DONE {
                h3_stream_fail_as(h, q, k, H3_REQUEST_REJECTED, H3_REQUEST_CANCELLED, "not processed by the server (GOAWAY)");
            }
            k = k + 1;
        }
        return;
    }
    if h.goaway_recv >= 0 && v > h.goaway_recv {
        h3_conn_error(h, q, H3_ID_ERROR, "GOAWAY id went up");
        return;
    }
    h.goaway_recv = v;
}

// ─── Request streams (§4.1) ─────────────────────────────────────────────

/// Read a request stream (server) or a response stream (client).
fn h3_stream_run(h: & mut H3Conn, q: & mut QuicConn, k: i64) {
    var s: H3Stream = h.streams.get(k);
    if s.state >= H3ST_DONE {
        return;
    }
    val rc: i64 = quic_stream_reset_code(q, s.id);
    h3_put(& mut s.buf, quic_stream_read(q, s.id));
    val fin: bool = quic_stream_finished(q, s.id);
    if rc >= 0 {
        // Reset by the peer (quic_conn keeps a reset stream until it is
        // read, so the code is there even when our half is done)
        s.state = H3ST_FAILED;
        s.msg.error = rc;
        s.msg.why = "reset by the peer: " + h3_error_name(rc);
        h.streams.set(k, s);
        if h.server {
            quic_stream_reset(q, s.id, H3_REQUEST_CANCELLED);
        }
        return;
    }
    var serr: i64 = - 1;
    var swhy: str = "";
    var looping: bool = true;
    while looping && h.error < 0 && serr < 0 {
        if s.data_left > 0 || s.skip_left > 0 {
            var n: i64 = s.buf.len() - s.pos;
            var want: i64 = s.data_left + s.skip_left;
            if n > want {
                n = want;
            }
            if s.data_left > 0 {
                var i: i64 = 0;
                while i < n {
                    s.msg.body.push(s.buf.get(s.pos + i));
                    i = i + 1;
                }
                s.data_left = s.data_left - n;
                if s.content_length >= 0 && s.msg.body.len() > s.content_length && !h3_no_content(& s) {
                    serr = H3_MESSAGE_ERROR;
                    swhy = "more DATA than content-length";
                }
            } else {
                s.skip_left = s.skip_left - n;
            }
            s.pos = s.pos + n;
            if s.data_left > 0 || s.skip_left > 0 {
                looping = false;
            }
        } else {
            val hd: H3Hdr = h3_hdr(s.buf, s.pos);
            if !hd.ok {
                looping = false;
            } else {
                val t: i64 = hd.ftype;
                if t == H3F_DATA {
                    if s.state != H3ST_BODY {
                        h3_conn_error(h, q, H3_FRAME_UNEXPECTED, "DATA before HEADERS or after trailers");
                    } else {
                        s.pos = s.pos + hd.hlen;
                        s.data_left = hd.len;
                    }
                } else if t == H3F_HEADERS {
                    if hd.len > h.max_field_section + 1024 {
                        serr = H3_EXCESSIVE_LOAD;
                        swhy = "HEADERS of " + int_to_str(hd.len) + " bytes";
                    } else if s.pos + hd.hlen + hd.len > s.buf.len() {
                        looping = false;
                    } else {
                        val p: Vec<i64> = h3_payload(s.buf, s.pos + hd.hlen, hd.len);
                        s.pos = s.pos + hd.hlen + hd.len;
                        val why: str = h3_on_headers(h, q, & mut s, p);
                        if why != "" && h.error < 0 {
                            serr = s.msg.error;
                            swhy = why;
                        }
                    }
                } else if t == H3F_PUSH_PROMISE && !h.server {
                    h3_conn_error(h, q, H3_ID_ERROR, "PUSH_PROMISE without MAX_PUSH_ID");
                } else if t == H3F_PUSH_PROMISE || t == H3F_SETTINGS || t == H3F_GOAWAY || t == H3F_MAX_PUSH_ID
                    || t == H3F_CANCEL_PUSH || h3_h2_frame(t) {
                    h3_conn_error(h, q, H3_FRAME_UNEXPECTED, "frame type " + int_to_str(t) + " on a request stream");
                } else {
                    // Unknown or reserved frame: skipped (§9)
                    s.pos = s.pos + hd.hlen;
                    s.skip_left = hd.len;
                }
            }
        }
    }
    if h.error >= 0 {
        h.streams.set(k, s);
        return;
    }
    if serr < 0 && fin && s.state < H3ST_DONE {
        if s.data_left > 0 || s.skip_left > 0 || s.pos < s.buf.len() {
            h.streams.set(k, s);
            h3_conn_error(h, q, H3_FRAME_ERROR, "a frame cut short by the end of the stream");
            return;
        }
        if s.state == H3ST_HEADERS {
            if h.server {
                serr = H3_REQUEST_INCOMPLETE;
                swhy = "the request stream ended without HEADERS";
            } else {
                serr = H3_MESSAGE_ERROR;
                swhy = "the response stream ended without a final response";
            }
        } else if s.content_length >= 0 && s.msg.body.len() != s.content_length && !h3_no_content(& s) {
            serr = H3_MESSAGE_ERROR;
            swhy = "content-length " + int_to_str(s.content_length) + " but " + int_to_str(s.msg.body.len()) + " bytes";
        } else {
            s.state = H3ST_DONE;
            s.msg.ok = true;
            s.msg.error = - 1;
        }
    }
    if s.pos >= s.buf.len() {
        s.buf = Vec::new();
        s.pos = 0;
    } else if s.pos > 16384 {
        s.buf = h3_tail(s.buf, s.pos);
        s.pos = 0;
    }
    h.streams.set(k, s);
    if serr >= 0 {
        h3_stream_fail(h, q, k, serr, swhy);
    }
}

/// A response that carries no content whatever content-length says: to
/// HEAD, or 204 / 304 (RFC 9110 §6.4.1).
fn h3_no_content(s: & H3Stream) -> bool {
    return s.req_method == "HEAD" || s.msg.status == 204 || s.msg.status == 304;
}

/// A HEADERS frame on a request stream: the message's header section,
/// an interim response, or trailers. "" when fine; else why the stream
/// fails (its code in `s.msg.error`); a connection error closes `h`.
fn h3_on_headers(h: & mut H3Conn, q: & mut QuicConn, s: & mut H3Stream, p: Vec<i64>) -> str {
    if s.state == H3ST_TRAILERS {
        h3_conn_error(h, q, H3_FRAME_UNEXPECTED, "HEADERS after trailers");
        return "frame unexpected";
    }
    val fs: QpackFields = qpack_decode(p, h.max_field_section);
    if !fs.ok {
        if fs.too_large {
            s.msg.error = H3_EXCESSIVE_LOAD;
            return fs.why;
        }
        h3_conn_error(h, q, fs.error, fs.why);
        return fs.why;
    }
    if s.state == H3ST_BODY {
        val bad: str = h3_check_fields(fs.names, fs.values, h.server, true);
        if bad != "" {
            s.msg.error = H3_MESSAGE_ERROR;
            return "trailers: " + bad;
        }
        s.msg.trailer_names = fs.names;
        s.msg.trailer_values = fs.values;
        s.state = H3ST_TRAILERS;
        return "";
    }
    val bad: str = h3_check_fields(fs.names, fs.values, h.server, false);
    if bad != "" {
        s.msg.error = H3_MESSAGE_ERROR;
        return bad;
    }
    if !h.server {
        val st: i64 = h3_status_of(fs.names, fs.values);
        if st >= 100 && st < 200 {
            if st == 101 {
                s.msg.error = H3_MESSAGE_ERROR;
                return "101 Switching Protocols in HTTP/3";
            }
            s.msg.interim = s.msg.interim + 1;
            return "";
        }
        s.msg.status = st;
    }
    var i: i64 = 0;
    while i < fs.names.len() {
        val n: str = fs.names.get(i);
        val v: str = fs.values.get(i);
        if n == ":method" {
            s.msg.method = v;
        } else if n == ":scheme" {
            s.msg.scheme = v;
        } else if n == ":authority" {
            s.msg.authority = v;
        } else if n == ":path" {
            s.msg.path = v;
        } else if n != ":status" {
            s.msg.names.push(n);
            s.msg.values.push(v);
        }
        i = i + 1;
    }
    if h.server {
        s.req_method = s.msg.method;
        if s.msg.authority == "" {
            s.msg.authority = h3_field(& s.msg, "host");
        }
    }
    val cl: i64 = h3_content_length(s.msg.names, s.msg.values);
    if cl == - 2 {
        s.msg.error = H3_MESSAGE_ERROR;
        return "bad content-length";
    }
    s.content_length = cl;
    s.state = H3ST_BODY;
    return "";
}

// ─── Messages for the application ───────────────────────────────────────

/// Server: the requests that arrived whole since the last call.
pub fn h3_requests(h: & mut H3Conn) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < h.streams.len() {
        var s: H3Stream = h.streams.get(k);
        if s.state == H3ST_DONE && !s.given {
            s.given = true;
            out.push(s.id);
            h.streams.set(k, s);
        }
        k = k + 1;
    }
    return out;
}

/// Whether stream `id`'s message is complete or failed (true for a stream
/// we do not track).
pub fn h3_done(h: & H3Conn, id: i64) -> bool {
    val k: i64 = h3_stream_index(h, id);
    if k < 0 {
        return true;
    }
    return h.streams.get(k).state >= H3ST_DONE;
}

/// The message of stream `id` as it stands: a request at a server, a
/// response at a client (`ok` once complete).
pub fn h3_message(h: & H3Conn, id: i64) -> H3Message {
    val k: i64 = h3_stream_index(h, id);
    if k < 0 {
        var m: H3Message = h3_msg_new();
        m.why = "no such stream";
        return m;
    }
    return h.streams.get(k).msg;
}

/// Client: the response of stream `id`; once it is done the stream is
/// forgotten.
pub fn h3_response(h: & mut H3Conn, id: i64) -> H3Message {
    val m: H3Message = h3_message(h, id);
    val k: i64 = h3_stream_index(h, id);
    if k >= 0 && h.streams.get(k).state >= H3ST_DONE {
        h.streams.remove(k);
    }
    return m;
}

/// A field list being built.
struct H3Fields {
    names: Vec<str>,
    values: Vec<str>,
}

/// Lowercase names; pseudo-headers come first.
fn h3_fields(pn: Vec<str>, pv: Vec<str>, names: Vec<str>, values: Vec<str>) -> H3Fields {
    var n: Vec<str> = Vec::new();
    var v: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < pn.len() {
        n.push(pn.get(i));
        v.push(pv.get(i));
        i = i + 1;
    }
    i = 0;
    while i < names.len() {
        n.push(str_to_lower(names.get(i)));
        v.push(values.get(i));
        i = i + 1;
    }
    return H3Fields { names: n, values: v };
}

/// HEADERS (and DATA, and trailers) for a message; [] when a field
/// section is over the peer's limit.
fn h3_encode_message(h: & H3Conn, names: Vec<str>, values: Vec<str>, body: Vec<i64>,
        tnames: Vec<str>, tvalues: Vec<str>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if h.peer_max_field_section >= 0 && (qpack_section_size(names, values) > h.peer_max_field_section
        || qpack_section_size(tnames, tvalues) > h.peer_max_field_section) {
        return out;
    }
    h3_put(& mut out, h3_frame(H3F_HEADERS, qpack_encode(names, values, h.huffman)));
    if body.len() > 0 {
        h3_put(& mut out, h3_frame(H3F_DATA, body));
    }
    if tnames.len() > 0 {
        h3_put(& mut out, h3_frame(H3F_HEADERS, qpack_encode(tnames, tvalues, h.huffman)));
    }
    return out;
}

/// Client: send a request on a new stream. `names` / `values` are the
/// other fields (lowercased here). The id of the stream, or -1: not
/// established yet, after a GOAWAY, at the server's stream limit, or the
/// fields are malformed or over the server's limit.
pub fn h3_request(h: & mut H3Conn, q: & mut QuicConn, method: str, scheme: str, authority: str, path: str,
        names: Vec<str>, values: Vec<str>, body: Vec<i64>) -> i64 {
    if h.server || h.error >= 0 || !quic_conn_established(q) {
        return - 1;
    }
    h3_start(h, q);
    val next: i64 = q.local_bidi_opened << 2;
    if h.goaway_recv >= 0 && next >= h.goaway_recv {
        return - 1;
    }
    var pn: Vec<str> = Vec::new();
    var pv: Vec<str> = Vec::new();
    pn.push(":method");
    pv.push(method);
    if method != "CONNECT" {
        pn.push(":scheme");
        pv.push(scheme);
    }
    pn.push(":authority");
    pv.push(authority);
    if method != "CONNECT" {
        pn.push(":path");
        pv.push(path);
    }
    val f: H3Fields = h3_fields(pn, pv, names, values);
    if h3_check_fields(f.names, f.values, true, false) != "" {
        return - 1;
    }
    var none: Vec<str> = Vec::new();
    val bytes: Vec<i64> = h3_encode_message(h, f.names, f.values, body, none, none);
    if bytes.len() == 0 {
        return - 1;
    }
    val id: i64 = quic_open_bidi(q);
    if id < 0 {
        return - 1;
    }
    quic_stream_write(q, id, bytes, true);
    h.streams.push(h3_stream_new(id, method));
    return id;
}

/// Server: an interim (1xx) response on request `id`, before the final
/// one (103 Early Hints, say). False if it cannot be sent.
pub fn h3_respond_interim(h: & mut H3Conn, q: & mut QuicConn, id: i64, status: i64,
        names: Vec<str>, values: Vec<str>) -> bool {
    if !h.server || status < 100 || status > 199 || status == 101 || h3_stream_index(h, id) < 0 {
        return false;
    }
    var pn: Vec<str> = Vec::new();
    var pv: Vec<str> = Vec::new();
    pn.push(":status");
    pv.push(int_to_str(status));
    val f: H3Fields = h3_fields(pn, pv, names, values);
    if h3_check_fields(f.names, f.values, false, false) != "" {
        return false;
    }
    var none: Vec<str> = Vec::new();
    val bytes: Vec<i64> = h3_encode_message(h, f.names, f.values, h3_none(), none, none);
    if bytes.len() == 0 {
        return false;
    }
    return quic_stream_write(q, id, bytes, false);
}

/// Server: the response to request `id`, with trailers when `tnames` is
/// not empty. The stream is forgotten afterwards; if the request was not
/// complete yet the client is asked to stop sending it (STOP_SENDING
/// H3_NO_ERROR, §4.1). False if it cannot be sent.
pub fn h3_respond_trailers(h: & mut H3Conn, q: & mut QuicConn, id: i64, status: i64,
        names: Vec<str>, values: Vec<str>, body: Vec<i64>, tnames: Vec<str>, tvalues: Vec<str>) -> bool {
    val k: i64 = h3_stream_index(h, id);
    if !h.server || k < 0 || status < 200 || status > 599 {
        return false;
    }
    var pn: Vec<str> = Vec::new();
    var pv: Vec<str> = Vec::new();
    pn.push(":status");
    pv.push(int_to_str(status));
    val f: H3Fields = h3_fields(pn, pv, names, values);
    var en: Vec<str> = Vec::new();
    var ev: Vec<str> = Vec::new();
    val t: H3Fields = h3_fields(en, ev, tnames, tvalues);
    if h3_check_fields(f.names, f.values, false, false) != ""
        || h3_check_fields(t.names, t.values, false, true) != "" {
        return false;
    }
    val bytes: Vec<i64> = h3_encode_message(h, f.names, f.values, body, t.names, t.values);
    if bytes.len() == 0 {
        return false;
    }
    if !quic_stream_write(q, id, bytes, true) {
        return false;
    }
    if h.streams.get(k).state < H3ST_DONE {
        quic_stream_stop(q, id, H3_NO_ERROR);
    }
    h.streams.remove(k);
    return true;
}

/// Server: the response to request `id` (see h3_respond_trailers).
pub fn h3_respond(h: & mut H3Conn, q: & mut QuicConn, id: i64, status: i64,
        names: Vec<str>, values: Vec<str>, body: Vec<i64>) -> bool {
    var none: Vec<str> = Vec::new();
    return h3_respond_trailers(h, q, id, status, names, values, body, none, none);
}

/// Client: read the response of a stream the application opened and wrote
/// itself (a request h3_request does not build); `method` as sent ("HEAD"
/// matters: its response has no content).
pub fn h3_track(h: & mut H3Conn, id: i64, method: str) {
    if h.server || h3_stream_index(h, id) >= 0 {
        return;
    }
    h.streams.push(h3_stream_new(id, method));
}

/// Server: refuse request `id` unprocessed (H3_REQUEST_REJECTED): the
/// client may send it again.
pub fn h3_reject(h: & mut H3Conn, q: & mut QuicConn, id: i64) {
    val k: i64 = h3_stream_index(h, id);
    if k < 0 {
        return;
    }
    h3_stream_fail(h, q, k, H3_REQUEST_REJECTED, "rejected");
    h.streams.remove(k);
}

/// Graceful shutdown (§5.2): a server's GOAWAY names the first request it
/// will not process (the ones it has keep going); a client's says it
/// accepts no push. New requests are refused afterwards.
pub fn h3_goaway(h: & mut H3Conn, q: & mut QuicConn) {
    if h.error >= 0 || !h.started || h.goaway_sent >= 0 {
        return;
    }
    var id: i64 = 0;
    if h.server {
        id = h.highest_request + 4;
        if h.highest_request < 0 {
            id = 0;
        }
    }
    h.goaway_sent = id;
    quic_stream_write(q, h.ctrl_id, h3_varint_frame(H3F_GOAWAY, id), false);
}

/// Close the connection without an error (H3_NO_ERROR).
pub fn h3_close(h: & mut H3Conn, q: & mut QuicConn, now: i64) {
    quic_conn_close(q, H3_NO_ERROR, "", now);
}

/// Whether nothing is in flight: no request waiting for a response
/// (client) or for the application (server).
pub fn h3_idle(h: & H3Conn) -> bool {
    return h.streams.len() == 0;
}
