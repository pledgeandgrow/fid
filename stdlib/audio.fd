// Fides Audio standard library — Phase 8D (S7)
//
// Audio playback via FFI. Provides a simple audio mixer with channels,
// volume control, and looping. The actual audio output is handled by
// the platform (ALSA on Linux, WASAPI on Windows, etc.) via FFI.
//
// In the interpreter, audio functions are stubs (no sound played).
// In native builds, these link against the platform audio library.
//
// Usage:
//   use audio;
//   audio_init();
//   value snd = audio_load("explosion.wav");
//   value ch = audio_play(snd, 1.0);  // play at full volume
//   audio_set_volume(ch, 0.5);     // lower volume
//   audio_stop(ch);
//   audio_shutdown();

module audio;

// ─── Audio Handle Types ───────────────────────────────────────────────────
//
// Sound handles and channel handles are i64 (opaque pointers or indices).

pub const AUDIO_NO_CHANNEL: i64 = -1;
pub const AUDIO_MAX_CHANNELS: i64 = 32;

// ─── FFI Declarations ─────────────────────────────────────────────────────
//
// These are stubs — the actual implementations are in the platform runtime.
// On Linux, the runtime would use ALSA or PulseAudio.
// On Windows, the runtime would use WASAPI or DirectSound.
// For now, these are no-ops that return 0.

extern "C" include "pledge_audio.h" link "" {
    fn pledge_audio_init() -> i64;
    fn pledge_audio_shutdown() -> void;
    fn pledge_audio_load(path: *u8) -> i64;
    fn pledge_audio_play(sound: i64, volume: f64) -> i64;
    fn pledge_audio_stop(channel: i64) -> void;
    fn pledge_audio_set_volume(channel: i64, volume: f64) -> void;
    fn pledge_audio_pause(channel: i64) -> void;
    fn pledge_audio_resume(channel: i64) -> void;
    fn pledge_audio_is_playing(channel: i64) -> i64;
    fn pledge_audio_set_loop(channel: i64, looping: i64) -> void;
    fn pledge_audio_set_pan(channel: i64, pan: f64) -> void;
    fn pledge_audio_stop_all() -> void;
    fn pledge_audio_master_volume(volume: f64) -> void;
}

// ─── Initialization ───────────────────────────────────────────────────────

/// Initialize the audio system. Returns 0 on success, -1 on failure.
pub fn audio_init() -> i64 {
    return pledge_audio_init();
}

/// Shut down the audio system and free all resources.
pub fn audio_shutdown() -> void {
    pledge_audio_shutdown();
}

// ─── Sound Loading ────────────────────────────────────────────────────────

/// Load a sound file. Returns a sound handle (>0) on success, -1 on failure.
pub fn audio_load(path: str) -> i64 {
    return pledge_audio_load(path);
}

// ─── Playback ─────────────────────────────────────────────────────────────

/// Play a sound at the given volume (0.0 to 1.0). Returns a channel handle.
pub fn audio_play(sound: i64, volume: f64) -> i64 {
    return pledge_audio_play(sound, volume);
}

/// Play a sound at full volume. Returns a channel handle.
pub fn audio_play_full(sound: i64) -> i64 {
    return pledge_audio_play(sound, 1.0);
}

/// Stop a playing sound channel.
pub fn audio_stop(channel: i64) -> void {
    pledge_audio_stop(channel);
}

/// Stop all playing sounds.
pub fn audio_stop_all() -> void {
    pledge_audio_stop_all();
}

/// Pause a channel (can be resumed with audio_resume).
pub fn audio_pause(channel: i64) -> void {
    pledge_audio_pause(channel);
}

/// Resume a paused channel.
pub fn audio_resume(channel: i64) -> void {
    pledge_audio_resume(channel);
}

// ─── Channel Control ──────────────────────────────────────────────────────

/// Set the volume of a channel (0.0 to 1.0).
pub fn audio_set_volume(channel: i64, volume: f64) -> void {
    pledge_audio_set_volume(channel, volume);
}

/// Set whether a channel loops (restarts when finished).
pub fn audio_set_loop(channel: i64, looping: bool) -> void {
    if looping {
        pledge_audio_set_loop(channel, 1);
    } else {
        pledge_audio_set_loop(channel, 0);
    }
}

/// Set the stereo pan of a channel (-1.0 = left, 0.0 = center, 1.0 = right).
pub fn audio_set_pan(channel: i64, pan: f64) -> void {
    pledge_audio_set_pan(channel, pan);
}

/// Check if a channel is still playing. Returns true if playing.
pub fn audio_is_playing(channel: i64) -> bool {
    return pledge_audio_is_playing(channel) != 0;
}

// ─── Master Volume ────────────────────────────────────────────────────────

/// Set the master volume (affects all channels). 0.0 to 1.0.
pub fn audio_master_volume(volume: f64) -> void {
    pledge_audio_master_volume(volume);
}

// ─── Audio State Tracking (Fides-side) ────────────────────────────────────
//
// The runtime handles actual playback, but we track some state in Fides
// for game logic (e.g., knowing which sounds are playing without querying
// the audio system every frame).

pub struct AudioState {
    pub master_vol: f64,
    pub muted: bool,
    pub music_channel: i64,  // dedicated music channel
    pub sfx_channels: Vec<i64>, // active SFX channels
}

/// Create an audio state tracker.
pub fn audio_state_create() -> AudioState {
    return AudioState {
        master_vol: 1.0,
        muted: false,
        music_channel: AUDIO_NO_CHANNEL,
        sfx_channels: Vec::new(),
    };
}

/// Set master volume through the state tracker (respects mute).
pub fn audio_state_set_volume(state: &mut AudioState, vol: f64) -> void {
    state.master_vol = vol;
    if !state.muted {
        audio_master_volume(vol);
    }
}

/// Toggle mute. Returns the new mute state.
pub fn audio_state_toggle_mute(state: &mut AudioState) -> bool {
    state.muted = !state.muted;
    if state.muted {
        audio_master_volume(0.0);
    } else {
        audio_master_volume(state.master_vol);
    }
    return state.muted;
}

/// Play music (loops). Stops any previous music.
pub fn audio_state_play_music(state: &mut AudioState, sound: i64) -> void {
    if state.music_channel != AUDIO_NO_CHANNEL {
        audio_stop(state.music_channel);
    }
    state.music_channel = audio_play(sound, state.master_vol);
    audio_set_loop(state.music_channel, true);
}

/// Stop music.
pub fn audio_state_stop_music(state: &mut AudioState) -> void {
    if state.music_channel != AUDIO_NO_CHANNEL {
        audio_stop(state.music_channel);
        state.music_channel = AUDIO_NO_CHANNEL;
    }
}

/// Play a sound effect and track the channel.
pub fn audio_state_play_sfx(state: &mut AudioState, sound: i64, volume: f64) -> i64 {
    val ch = audio_play(sound, volume);
    if ch != AUDIO_NO_CHANNEL {
        state.sfx_channels.push(ch);
    }
    return ch;
}

/// Clean up finished SFX channels from the tracking list.
pub fn audio_state_cleanup_sfx(state: &mut AudioState) -> void {
    val active = Vec::new();
    val i = 0;
    while i < state.sfx_channels.len() {
        val ch = state.sfx_channels.get(i);
        if audio_is_playing(ch) {
            active.push(ch);
        }
        i = i + 1;
    }
    state.sfx_channels = active;
}
