// Fides Audio standard library — Phase 8D (S7)
//
// Audio playback via FFI. Provides a simple audio mixer with channels,
// volume control, and looping. The actual audio output is handled by
// the platform (ALSA on Linux, WASAPI on Windows, etc.) via FFI.
//
// In the interpreter, audio functions are stubs (no sound played).
// In native builds, these link against the platform audio library.
//
// Usage:
//   use audio;
//   audio_init();
//   value snd = audio_load("explosion.wav");
//   value ch = audio_play(snd, 1.0);  // play at full volume
//   audio_set_volume(ch, 0.5);     // lower volume
//   audio_stop(ch);
//   audio_shutdown();

module audio;
use file;
// ─── Audio Handle Types ───────────────────────────────────────────────────
//
// Sound handles and channel handles are i64 (opaque pointers or indices).

pub const AUDIO_NO_CHANNEL: i64 = -1;
pub const AUDIO_MAX_CHANNELS: i64 = 32;
// ─── FFI Declarations ─────────────────────────────────────────────────────
//
// These are stubs — the actual implementations are in the platform runtime.
// On Linux, the runtime would use ALSA or PulseAudio.
// On Windows, the runtime would use WASAPI or DirectSound.
// For now, these are no-ops that return 0.

// SAFETY: pledge_audio.h is the runtime's own header, checked by the C
// compiler; sounds are the handles pledge_audio_load returned and paths are
// NUL-terminated strings.
extern "C" include "pledge_audio.h" link "" {
    fn pledge_audio_init() -> i64;
    fn pledge_audio_shutdown() -> void;
    fn pledge_audio_load(path: *u8) -> i64;
    fn pledge_audio_play(sound: i64, volume: f64) -> i64;
    fn pledge_audio_stop(channel: i64) -> void;
    fn pledge_audio_set_volume(channel: i64, volume: f64) -> void;
    fn pledge_audio_pause(channel: i64) -> void;
    fn pledge_audio_resume(channel: i64) -> void;
    fn pledge_audio_is_playing(channel: i64) -> i64;
    fn pledge_audio_set_loop(channel: i64, looping: i64) -> void;
    fn pledge_audio_set_pan(channel: i64, pan: f64) -> void;
    fn pledge_audio_stop_all() -> void;
    fn pledge_audio_master_volume(volume: f64) -> void;
}

// ─── Initialization ───────────────────────────────────────────────────────

/// Initialize the audio system. Returns 0 on success, -1 on failure.
pub fn audio_init() -> i64 {
    // SAFETY: takes no arguments; the helper opens SDL_mixer and resets its
    // own static channel and sound tables (a second call returns 0 at once).
    unsafe {
        return pledge_audio_init();
    }
}

/// Shut down the audio system and free all resources.
pub fn audio_shutdown() -> void {
    // SAFETY: takes no arguments; the helper frees only the chunks in its
    // own sound table and does nothing when audio was never initialised.
    unsafe {
        pledge_audio_shutdown();
    }
}

// ─── Sound Loading ────────────────────────────────────────────────────────

/// Load a sound file. Returns a sound handle (>0) on success, -1 on failure.
pub fn audio_load(path: str) -> i64 {
    // SAFETY: the helper reads the NUL-terminated text of path (a Fides str
    // alive for the call; it returns -1 for a null one) and returns an index
    // into its own sound table, not an address.
    unsafe {
        return pledge_audio_load(path);
    }
}

// ─── Playback ─────────────────────────────────────────────────────────────

/// Play a sound at the given volume (0.0 to 1.0). Returns a channel handle.
pub fn audio_play(sound: i64, volume: f64) -> i64 {
    // SAFETY: sound is a table index, not an address: the helper returns -1
    // for one outside the sounds loaded so far, and clamps volume.
    unsafe {
        return pledge_audio_play(sound, volume);
    }
}

/// Play a sound at full volume. Returns a channel handle.
pub fn audio_play_full(sound: i64) -> i64 {
    // SAFETY: sound is a table index, not an address: the helper returns -1
    // for one outside the sounds loaded so far.
    unsafe {
        return pledge_audio_play(sound, 1.0);
    }
}

/// Stop a playing sound channel.
pub fn audio_stop(channel: i64) -> void {
    // SAFETY: channel is a number, not an address: the helper
    // (runtime/pledge_audio.c) ignores a channel outside 0..31 and a call
    // before audio_init.
    unsafe {
        pledge_audio_stop(channel);
    }
}

/// Stop all playing sounds.
pub fn audio_stop_all() -> void {
    // SAFETY: takes no arguments; the helper halts every channel and resets
    // its own channel table (nothing before audio_init).
    unsafe {
        pledge_audio_stop_all();
    }
}

/// Pause a channel (can be resumed with audio_resume).
pub fn audio_pause(channel: i64) -> void {
    // SAFETY: channel is a number, not an address: the helper
    // (runtime/pledge_audio.c) ignores a channel outside 0..31 and a call
    // before audio_init.
    unsafe {
        pledge_audio_pause(channel);
    }
}

/// Resume a paused channel.
pub fn audio_resume(channel: i64) -> void {
    // SAFETY: channel is a number, not an address: the helper
    // (runtime/pledge_audio.c) ignores a channel outside 0..31 and a call
    // before audio_init.
    unsafe {
        pledge_audio_resume(channel);
    }
}

// ─── Channel Control ──────────────────────────────────────────────────────

/// Set the volume of a channel (0.0 to 1.0).
pub fn audio_set_volume(channel: i64, volume: f64) -> void {
    // SAFETY: channel is a number, not an address: the helper
    // (runtime/pledge_audio.c) ignores a channel outside 0..31 and a call
    // before audio_init; it clamps volume.
    unsafe {
        pledge_audio_set_volume(channel, volume);
    }
}

/// Set whether a channel loops (restarts when finished).
pub fn audio_set_loop(channel: i64, looping: bool) -> void {
    // SAFETY: channel is a number, not an address: the helper
    // (runtime/pledge_audio.c) ignores a channel outside 0..31 and a call
    // before audio_init.
    unsafe {
        if looping {
            pledge_audio_set_loop(channel, 1);
        } else {
            pledge_audio_set_loop(channel, 0);
        }
    }
}

/// Set the stereo pan of a channel (-1.0 = left, 0.0 = center, 1.0 = right).
pub fn audio_set_pan(channel: i64, pan: f64) -> void {
    // SAFETY: channel is a number, not an address: the helper
    // (runtime/pledge_audio.c) ignores a channel outside 0..31 and a call
    // before audio_init; it clamps pan.
    unsafe {
        pledge_audio_set_pan(channel, pan);
    }
}

/// Check if a channel is still playing. Returns true if playing.
pub fn audio_is_playing(channel: i64) -> bool {
    var playing: i64 = 0;
    // SAFETY: channel is a number, not an address: the helper
    // (runtime/pledge_audio.c) ignores a channel outside 0..31 and a call
    // before audio_init (returning 0).
    unsafe {
        playing = pledge_audio_is_playing(channel);
    }
    return playing != 0;
}

// ─── Master Volume ────────────────────────────────────────────────────────

/// Set the master volume (affects all channels). 0.0 to 1.0.
pub fn audio_master_volume(volume: f64) -> void {
    // SAFETY: takes one value, clamped by the helper to 0..128 for
    // Mix_Volume(-1, ...); nothing before audio_init.
    unsafe {
        pledge_audio_master_volume(volume);
    }
}

// ─── WAV codec (pure Fides) ──────────────────────────────────────────────
//
// Decodes/encodes RIFF/WAVE PCM (8-bit unsigned, 16-bit signed, mono or
// stereo). Samples are stored as signed i64 in interleaved order.
// Playback still goes through the platform runtime — this gives games and
// tools real audio data without it.

pub struct AudioBuffer {
    pub sample_rate: i64,
    pub channels: i64,
    pub bits: i64,
    // 8 or 16
    pub data: Vec<i64>,  // interleaved samples (i16 range for 16-bit, 0-255 for 8-bit)
}

fn aud_u16le(d: &Vec<i64>, at: i64) -> i64 {
    return (d.get(at) & 255) | ((d.get(at + 1) & 255) << 8);
}

fn aud_u32le(d: &Vec<i64>, at: i64) -> i64 {
    return (d.get(at) & 255) | ((d.get(at + 1) & 255) << 8) | ((d.get(at + 2) & 255) << 16) | ((d.get(at + 3) & 255) << 24);
}

fn aud_u32le_into(d: Vec<i64>, at: i64) -> i64 {
    return aud_u32le(&d, at);
}

/// Decode a WAV byte stream. `sample_rate` is 0 on failure.
pub fn audio_wav_decode(d: Vec<i64>) -> AudioBuffer {
    var bad: AudioBuffer = AudioBuffer {
        sample_rate: 0, channels: 0, bits: 0, data: Vec::new(),
    };
    if d.len() < 44 {
        return bad;
    }
    if d.get(0) != 82 || d.get(1) != 73 || d.get(2) != 70 || d.get(3) != 70 {
        return bad;
    }
    // 'RIFF'
    if d.get(8) != 87 || d.get(9) != 65 || d.get(10) != 86 || d.get(11) != 69 {
        return bad;
    }
    // 'WAVE'
    var fmt_rate: i64 = 0;
    var fmt_ch: i64 = 0;
    var fmt_bits: i64 = 0;
    var fmt_tag: i64 = 0;
    var data_off: i64 = -1;
    var data_len: i64 = 0;
    var pos: i64 = 12;
    while pos + 8 <= d.len() {
        val cid: i64 = aud_u32le(&d, pos);
        val clen: i64 = aud_u32le(&d, pos + 4);
        if clen < 0 || pos + 8 + clen > d.len() {
            return bad;
        }
        if cid == 0x20746D66 {
            // 'fmt '
            if clen < 16 {
                return bad;
            }
            fmt_tag = aud_u16le(&d, pos + 8);
            fmt_ch = aud_u16le(&d, pos + 10);
            fmt_rate = aud_u32le(&d, pos + 12);
            fmt_bits = aud_u16le(&d, pos + 22);
        } else if cid == 0x61746164 {
            // 'data'
            data_off = pos + 8;
            data_len = clen;
        }
        pos = pos + 8 + clen + (clen % 2);
        // chunks are word-aligned
    }
    if fmt_tag != 1 || fmt_rate <= 0 || (fmt_ch != 1 && fmt_ch != 2) || (fmt_bits != 8 && fmt_bits != 16) || data_off < 0 {
        return bad;
    }
    var buf: AudioBuffer = AudioBuffer {
        sample_rate: fmt_rate, channels: fmt_ch, bits: fmt_bits, data: Vec::new(),
    };
    var i: i64 = data_off;
    if fmt_bits == 8 {
        while i < data_off + data_len {
            buf.data.push(d.get(i) & 255);
            i = i + 1;
        }
    } else {
        while i + 1 < data_off + data_len {
            var s: i64 = aud_u16le(&d, i);
            if s >= 32768 {
                s = s - 65536;
            }
            buf.data.push(s);
            i = i + 2;
        }
    }
    return buf;
}

/// Load and decode a WAV file. `sample_rate` is 0 on failure.
pub fn audio_load_wav(path: str) -> AudioBuffer {
    return audio_wav_decode(file_read_bytes(path));
}

/// Encode an AudioBuffer as a 16-bit PCM WAV byte stream.
/// 8-bit buffers are widened to 16 bits.
pub fn audio_wav_encode(buf: &AudioBuffer) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val ns: i64 = buf.data.len();
    val data_len: i64 = ns * 2;
    out.push(82);
    out.push(73);
    out.push(70);
    out.push(70);
    aud_push_u32le(&mut out, 36 + data_len);
    out.push(87);
    out.push(65);
    out.push(86);
    out.push(69);
    out.push(102);
    out.push(109);
    out.push(116);
    out.push(32);
    aud_push_u32le(&mut out, 16);
    aud_push_u16le(&mut out, 1);
    aud_push_u16le(&mut out, buf.channels);
    aud_push_u32le(&mut out, buf.sample_rate);
    aud_push_u32le(&mut out, buf.sample_rate * buf.channels * 2);
    aud_push_u16le(&mut out, buf.channels * 2);
    aud_push_u16le(&mut out, 16);
    out.push(100);
    out.push(97);
    out.push(116);
    out.push(97);
    aud_push_u32le(&mut out, data_len);
    var i: i64 = 0;
    while i < ns {
        var s: i64 = buf.data.get(i);
        if buf.bits == 8 {
            s = (s - 128) * 256;
        }
        if s > 32767 {
            s = 32767;
        }
        if s < 0 - 32768 {
            s = 0 - 32768;
        }
        out.push(s & 255);
        out.push((s >> 8) & 255);
        i = i + 1;
    }
    return out;
}

fn aud_push_u16le(v: &mut Vec<i64>, x: i64) -> void {
    v.push(x & 255);
    v.push((x >> 8) & 255);
}

fn aud_push_u32le(v: &mut Vec<i64>, x: i64) -> void {
    v.push(x & 255);
    v.push((x >> 8) & 255);
    v.push((x >> 16) & 255);
    v.push((x >> 24) & 255);
}

/// Save an AudioBuffer as a 16-bit PCM WAV file.
pub fn audio_save_wav(buf: &AudioBuffer, path: str) -> i64 {
    return file_write_bytes(path, audio_wav_encode(buf));
}

// ─── Audio State Tracking (Fides-side) ────────────────────────────────────
//
// The runtime handles actual playback, but we track some state in Fides
// for game logic (e.g., knowing which sounds are playing without querying
// the audio system every frame).

pub struct AudioState {
    pub master_vol: f64,
    pub muted: bool,
    pub music_channel: i64,
    // dedicated music channel
    pub sfx_channels: Vec<i64>,  // active SFX channels
}

/// Create an audio state tracker.
///
/// Example:
///   val st = audio_state_create();
///   assert(!st.muted);
///   assert(st.master_vol == 1.0);
///   assert_eq(st.music_channel, AUDIO_NO_CHANNEL);
///   assert_eq(st.sfx_channels.len(), 0);
pub fn audio_state_create() -> AudioState {
    return AudioState {
        master_vol: 1.0, muted: false, music_channel: AUDIO_NO_CHANNEL, sfx_channels: Vec::new(),
    };
}

/// Set master volume through the state tracker (respects mute).
pub fn audio_state_set_volume(state: &mut AudioState, vol: f64) -> void {
    state.master_vol = vol;
    if !state.muted {
        audio_master_volume(vol);
    }
}

/// Toggle mute. Returns the new mute state.
pub fn audio_state_toggle_mute(state: &mut AudioState) -> bool {
    state.muted = !state.muted;
    if state.muted {
        audio_master_volume(0.0);
    } else {
        audio_master_volume(state.master_vol);
    }
    return state.muted;
}

/// Play music (loops). Stops any previous music.
pub fn audio_state_play_music(state: &mut AudioState, sound: i64) -> void {
    if state.music_channel != AUDIO_NO_CHANNEL {
        audio_stop(state.music_channel);
    }
    state.music_channel = audio_play(sound, state.master_vol);
    audio_set_loop(state.music_channel, true);
}

/// Stop music.
pub fn audio_state_stop_music(state: &mut AudioState) -> void {
    if state.music_channel != AUDIO_NO_CHANNEL {
        audio_stop(state.music_channel);
        state.music_channel = AUDIO_NO_CHANNEL;
    }
}

/// Play a sound effect and track the channel.
pub fn audio_state_play_sfx(state: &mut AudioState, sound: i64, volume: f64) -> i64 {
    var ch = audio_play(sound, volume);
    if ch != AUDIO_NO_CHANNEL {
        state.sfx_channels.push(ch);
    }
    return ch;
}

/// Clean up finished SFX channels from the tracking list.
pub fn audio_state_cleanup_sfx(state: &mut AudioState) -> void {
    var active = Vec::new();
    var i = 0;
    while i < state.sfx_channels.len() {
        var ch = state.sfx_channels.get(i);
        if audio_is_playing(ch) {
            active.push(ch);
        }
        i = i + 1;
    }
    state.sfx_channels = active;
}
