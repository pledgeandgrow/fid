// Fides Vec standard library
//
// Dynamic array with amortized O(1) push/pop.
//
// The basic operations (new, push, pop, len, get, set, insert, remove,
// sort, ...) are core's Vec_* functions, the same on every backend; this
// module adds the higher-order helpers (map, filter, fold, ...).
// Fields are private to prevent direct access — use methods instead.
//
// Usage:
//   use core;
//   value v = Vec::new();
//   v.push(1);
//   v.push(2);
//   print(v.len());  // 2
//   print(v.get(0)); // 1

module vec;
// Vec struct — fields are private, accessed only via methods.
// Runtime layout matches PVec: { void** data; int64_t len; int64_t cap; }
/// A growable array. The basic operations (push, pop, len, get, set, ...)
/// are core's; this module adds map, filter, fold and the other helpers.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(2); v.push(3); v.push(4);
///   var doubled = v.map(fn(x: i64) -> i64 { x * 2 });
///   var evens = v.filter(fn(x: i64) -> bool { x % 2 == 0 });
///   var sum = v.fold(0, fn(acc: i64, x: i64) -> i64 { acc + x });
///   println(int_to_str(sum));
///   assert_eq(doubled.get(3), 8);
///   assert_eq(evens.len(), 2);
///   assert_eq(sum, 10);
///   assert(v.any(fn(x: i64) -> bool { x > 3 }));
///   assert_eq(v.position(fn(x: i64) -> bool { x == 3 }), 2);
pub struct Vec<T> {
    data: i64,  // raw pointer (opaque at Fides level)
    len: i64, cap: i64,
}

impl Vec {
    // Map: apply a function to each element, return new Vec of results
    // Usage: value doubled = v.map(double);
    //        value squares = v.map(fn(x: i64) { x * x });
    pub fn map(self: Vec<i64>, f: fn(i64) -> i64) -> Vec<i64> {
        var result: Vec<i64> = Vec::new();
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            var y: i64 = f(x);
            result.push(y);
            i = i + 1;
        }
        return result;
    }

    // Filter: keep only elements where predicate returns true
    // Usage: value evens = v.filter(fn(x: i64) { x % 2 == 0 });
    pub fn filter(self: Vec<i64>, pred: fn(i64) -> bool) -> Vec<i64> {
        var result: Vec<i64> = Vec::new();
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if pred(x) {
                result.push(x);
            }
            i = i + 1;
        }
        return result;
    }

    // For each: apply a function to each element (side effects only)
    // Usage: v.for_each(fn(x: i64) { print(x); });
    pub fn for_each(self: Vec<i64>, f: fn(i64) -> void) -> void {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            f(x);
            i = i + 1;
        }
    }

    // Fold/reduce: accumulate a result by applying f to each element
    // Usage: value sum = v.fold(0, fn(acc: i64, x: i64) { acc + x });
    pub fn fold(self: Vec<i64>, init: i64, f: fn(i64, i64) -> i64) -> i64 {
        var acc: i64 = init;
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            acc = f(acc, x);
            i = i + 1;
        }
        return acc;
    }

    // Any: returns true if any element satisfies the predicate
    pub fn any(self: Vec<i64>, pred: fn(i64) -> bool) -> bool {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if pred(x) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // All: returns true if all elements satisfy the predicate
    pub fn all(self: Vec<i64>, pred: fn(i64) -> bool) -> bool {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if !pred(x) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // Find: returns the first element satisfying the predicate, or -1
    pub fn find(self: Vec<i64>, pred: fn(i64) -> bool) -> i64 {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if pred(x) {
                return x;
            }
            i = i + 1;
        }
        return - 1;
    }

    // The first element satisfying the predicate, or Option::None
    pub fn find_opt(self: Vec<i64>, pred: fn(i64) -> bool) -> Option<i64> {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if pred(x) {
                return Option::Some(x);
            }
            i = i + 1;
        }
        return Option::None;
    }

    // Index of first element satisfying predicate, or -1
    pub fn position(self: Vec<i64>, pred: fn(i64) -> bool) -> i64 {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if pred(x) {
                return i;
            }
            i = i + 1;
        }
        return - 1;
    }

    // Index of first element satisfying predicate, or Option::None
    pub fn position_opt(self: Vec<i64>, pred: fn(i64) -> bool) -> Option<i64> {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if pred(x) {
                return Option::Some(i);
            }
            i = i + 1;
        }
        return Option::None;
    }

    // ─── Iterator Adapters (Phase 2.3) ──────────────────────────────
    // Note: These delegate to the free function versions (Vec_take, etc.)
    // because Vec_new() returns i64, not Vec, and method calls on i64
    // are not supported by the typechecker.

    pub fn take(self: Vec<i64>, n: i64) -> Vec<i64> {
        return vec_take(self, n);
    }

    pub fn skip(self: Vec<i64>, n: i64) -> Vec<i64> {
        return vec_skip(self, n);
    }

    pub fn zip(self: Vec<i64>, other: Vec<i64>) -> Vec<i64> {
        return vec_zip(self, other);
    }

    pub fn enumerate(self: Vec<i64>) -> Vec<i64> {
        return vec_enumerate(self);
    }

    pub fn flat_map(self: Vec<i64>, f: fn(i64) -> i64) -> Vec<i64> {
        return vec_flat_map(self, f);
    }

    pub fn chunk(self: Vec<i64>, size: i64) -> Vec<i64> {
        return vec_chunk(self, size);
    }

    pub fn window(self: Vec<i64>, size: i64) -> Vec<i64> {
        return vec_window(self, size);
    }

    pub fn dedup(self: & mut Vec<i64>) -> void {
        vec_dedup(self);
    }

    pub fn sort_by(self: & mut Vec<i64>, cmp: fn(i64, i64) -> i64) -> void {
        vec_sort_by(self, cmp);
    }

    pub fn contains_val(self: Vec<i64>, value: i64) -> bool {
        return vec_contains_val(self, value);
    }
}

// ─── Free function wrappers for iterator adapters ───────────────────────
// These allow calling Vec_take(v, 3) instead of v.take(3) when using `use vec;`

/// The first `n` elements (all of them if there are fewer) as a new Vec.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(10); v.push(20); v.push(30);
///   var t = vec_take(v, 2);
///   assert_eq(t.len(), 2);
///   assert_eq(t.get(1), 20);
pub fn vec_take(self: Vec<i64>, n: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec_new();
    var len: i64 = Vec_len(self);
    var count: i64 = n;
    if count > len {
        count = len;
    }
    var i: i64 = 0;
    while i < count {
        Vec_push(result, Vec_get(self, i));
        i = i + 1;
    }
    return result;
}

/// Everything after the first `n` elements, as a new Vec.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(10); v.push(20); v.push(30);
///   var t = vec_skip(v, 1);
///   assert_eq(t.len(), 2);
///   assert_eq(t.get(0), 20);
pub fn vec_skip(self: Vec<i64>, n: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec_new();
    var len: i64 = Vec_len(self);
    var start: i64 = n;
    if start < 0 {
        start = 0;
    }
    var i: i64 = start;
    while i < len {
        Vec_push(result, Vec_get(self, i));
        i = i + 1;
    }
    return result;
}

/// The elements of both Vecs interleaved pairwise (a0, b0, a1, b1, ...),
/// up to the length of the shorter one.
///
/// Example:
///   var a: Vec<i64> = Vec::new();
///   a.push(1); a.push(2);
///   var b: Vec<i64> = Vec::new();
///   b.push(10); b.push(20); b.push(30);
///   var z = vec_zip(a, b);
///   assert_eq(z.len(), 4);
///   assert_eq(z.get(1), 10);
///   assert_eq(z.get(2), 2);
pub fn vec_zip(self: Vec<i64>, other: Vec<i64>) -> Vec<i64> {
    var result: Vec<i64> = Vec_new();
    var n1: i64 = Vec_len(self);
    var n2: i64 = Vec_len(other);
    var n: i64 = n1;
    if n2 < n {
        n = n2;
    }
    var i: i64 = 0;
    while i < n {
        Vec_push(result, Vec_get(self, i));
        Vec_push(result, Vec_get(other, i));
        i = i + 1;
    }
    return result;
}

/// Index and element pairs flattened into one Vec (0, v0, 1, v1, ...).
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(7); v.push(8);
///   var e = vec_enumerate(v);
///   assert_eq(e.len(), 4);
///   assert_eq(e.get(2), 1);
///   assert_eq(e.get(3), 8);
pub fn vec_enumerate(self: Vec<i64>) -> Vec<i64> {
    var result: Vec<i64> = Vec_new();
    var n: i64 = Vec_len(self);
    var i: i64 = 0;
    while i < n {
        Vec_push(result, i);
        Vec_push(result, Vec_get(self, i));
        i = i + 1;
    }
    return result;
}

/// Concatenation of the Vecs that `f` returns for each element (`f`
/// returns a Vec handle as an i64).
pub fn vec_flat_map(self: Vec<i64>, f: fn(i64) -> i64) -> Vec<i64> {
    var result: Vec<i64> = Vec_new();
    var n: i64 = Vec_len(self);
    var i: i64 = 0;
    while i < n {
        var mapped: i64 = f(Vec_get(self, i));
        var m: i64 = Vec_len(mapped);
        var j: i64 = 0;
        while j < m {
            Vec_push(result, Vec_get(mapped, j));
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

/// The start index of each chunk of `size` elements.
/// A size <= 0 gives an empty Vec (never an infinite loop).
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(2); v.push(3); v.push(4); v.push(5);
///   var starts = vec_chunk(v, 2);
///   assert_eq(starts.len(), 3);
///   assert_eq(starts.get(2), 4);
pub fn vec_chunk(self: Vec<i64>, size: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec_new();
    var n: i64 = Vec_len(self);
    if size <= 0 {
        return result;
    }
    var i: i64 = 0;
    while i < n {
        Vec_push(result, i);
        i = i + size;
    }
    return result;
}

/// The start index of every full window of `size` consecutive elements.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(2); v.push(3); v.push(4);
///   var starts = vec_window(v, 3);
///   assert_eq(starts.len(), 2);
///   assert_eq(starts.get(1), 1);
pub fn vec_window(self: Vec<i64>, size: i64) -> Vec<i64> {
    var result: Vec<i64> = Vec_new();
    var n: i64 = Vec_len(self);
    if size <= 0 {
        return result;
    }
    var i: i64 = 0;
    while i + size <= n {
        Vec_push(result, i);
        i = i + 1;
    }
    return result;
}

/// Remove consecutive duplicates in place (sort first to remove all).
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(1); v.push(2); v.push(2); v.push(1);
///   vec_dedup(&mut v);
///   assert_eq(v.len(), 3);
///   assert_eq(v.get(2), 1);
pub fn vec_dedup(self: & mut Vec<i64>) -> void {
    var n: i64 = Vec_len(self);
    if n <= 1 {
        return;
    }
    var write: i64 = 1;
    var i: i64 = 1;
    while i < n {
        if Vec_get(self, i) != Vec_get(self, i - 1) {
            Vec_set(self, write, Vec_get(self, i));
            write = write + 1;
        }
        i = i + 1;
    }
    p_vec_truncate(self, write);
}

/// Sort in place with a comparison function (negative, zero or positive,
/// like `a - b`). Heapsort: O(n log n) worst case, in place, no recursion.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(3); v.push(1); v.push(2);
///   vec_sort_by(&mut v, fn(a: i64, b: i64) -> i64 { b - a });
///   assert_eq(v.get(0), 3);
///   assert_eq(v.get(2), 1);
pub fn vec_sort_by(self: & mut Vec<i64>, cmp: fn(i64, i64) -> i64) -> void {
    var n: i64 = Vec_len(self);
    var i: i64 = n / 2;
    while i > 0 {
        i = i - 1;
        vec_sift_down(self, i, n, cmp);
    }
    var end: i64 = n - 1;
    while end > 0 {
        var tmp: i64 = Vec_get(self, 0);
        Vec_set(self, 0, Vec_get(self, end));
        Vec_set(self, end, tmp);
        vec_sift_down(self, 0, end, cmp);
        end = end - 1;
    }
}

// Restore the max-heap (by cmp) rooted at `root` within the first `n`
// elements of `self`.
fn vec_sift_down(self: & mut Vec<i64>, root: i64, n: i64, cmp: fn(i64, i64) -> i64) -> void {
    var r: i64 = root;
    var running = true;
    while running {
        var child: i64 = 2 * r + 1;
        if child >= n {
            running = false;
        } else {
            var swap_idx: i64 = r;
            if cmp(Vec_get(self, swap_idx), Vec_get(self, child)) < 0 {
                swap_idx = child;
            }
            if child + 1 < n && cmp(Vec_get(self, swap_idx), Vec_get(self, child + 1)) < 0 {
                swap_idx = child + 1;
            }
            if swap_idx == r {
                running = false;
            } else {
                var tmp: i64 = Vec_get(self, r);
                Vec_set(self, r, Vec_get(self, swap_idx));
                Vec_set(self, swap_idx, tmp);
                r = swap_idx;
            }
        }
    }
}

/// Whether the Vec holds `value`.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(4); v.push(5);
///   assert(vec_contains_val(v, 5));
///   assert(!vec_contains_val(v, 6));
pub fn vec_contains_val(self: Vec<i64>, value: i64) -> bool {
    var n: i64 = Vec_len(self);
    var i: i64 = 0;
    while i < n {
        if Vec_get(self, i) == value {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The first element satisfying `pred`, or Option::None.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(4); v.push(5);
///   match vec_find_opt(v, fn(x: i64) -> bool { x == 5 }) {
///     Option::Some(x) => { assert_eq(x, 5); }
///     Option::None => { assert(false); }
///   }
pub fn vec_find_opt(self: Vec<i64>, pred: fn(i64) -> bool) -> Option<i64> {
    var n: i64 = Vec_len(self);
    var i: i64 = 0;
    while i < n {
        var x: i64 = Vec_get(self, i);
        if pred(x) {
            return Option::Some(x);
        }
        i = i + 1;
    }
    return Option::None;
}

/// The index of the first element satisfying `pred`, or Option::None.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(4); v.push(5);
///   match vec_position_opt(v, fn(x: i64) -> bool { x == 5 }) {
///     Option::Some(i) => { assert_eq(i, 1); }
///     Option::None => { assert(false); }
///   }
pub fn vec_position_opt(self: Vec<i64>, pred: fn(i64) -> bool) -> Option<i64> {
    var n: i64 = Vec_len(self);
    var i: i64 = 0;
    while i < n {
        if pred(Vec_get(self, i)) {
            return Option::Some(i);
        }
        i = i + 1;
    }
    return Option::None;
}

/// The element at `idx`, or Option::None when out of bounds — the safe
/// version of v.get (which panics).
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(7);
///   match vec_get_opt(v, 5) {
///     Option::Some(x) => { assert(false); }
///     Option::None => { assert(true); }
///   }
pub fn vec_get_opt(v: Vec<i64>, idx: i64) -> Option<i64> {
    if idx < 0 || idx >= Vec_len(v) {
        return Option::None;
    }
    return Option::Some(Vec_get(v, idx));
}

/// The first element, or Option::None when empty.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   match vec_first_opt(v) {
///     Option::Some(x) => { assert(false); }
///     Option::None => { assert(true); }
///   }
pub fn vec_first_opt(v: Vec<i64>) -> Option<i64> {
    if Vec_len(v) == 0 {
        return Option::None;
    }
    return Option::Some(Vec_get(v, 0));
}

/// The last element, or Option::None when empty.
pub fn vec_last_opt(v: Vec<i64>) -> Option<i64> {
    var n: i64 = Vec_len(v);
    if n == 0 {
        return Option::None;
    }
    return Option::Some(Vec_get(v, n - 1));
}
