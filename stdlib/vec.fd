// Fides Vec standard library
//
// Dynamic array with amortized O(1) push/pop.
//
// The runtime representation is opaque (PVec* in C, Value::Vec in interpreter).
// Methods forward to p_vec_* runtime functions which handle memory management.
// Fields are private to prevent direct access — use methods instead.
//
// Usage:
//   use core;
//   value v = Vec::new();
//   v.push(1);
//   v.push(2);
//   print(v.len());  // 2
//   print(v.get(0)); // 1

module vec;

// Vec struct — fields are private, accessed only via methods.
// Runtime layout matches PVec: { void** data; int64_t len; int64_t cap; }
pub struct Vec<T> {
    data: i64,   // raw pointer (opaque at Fides level)
    len: i64,
    cap: i64,
}

impl Vec {
    // Create a new empty Vec
    pub fn new() -> Vec {
        return p_vec_new();
    }

    // Append an element to the end
    pub fn push(self: Vec, x: i64) -> void {
        p_vec_push(self, x);
    }

    // Remove and return the last element
    pub fn pop(self: Vec) -> i64 {
        return p_vec_pop(self);
    }

    // Number of elements
    pub fn len(self: Vec) -> i64 {
        return p_vec_len(self);
    }

    // Check if empty
    pub fn is_empty(self: Vec) -> bool {
        return p_vec_is_empty(self);
    }

    // Get element at index (with bounds check)
    pub fn get(self: Vec, idx: i64) -> i64 {
        return p_vec_get(self, idx);
    }

    // Set element at index (with bounds check)
    pub fn set(self: Vec, idx: i64, value: i64) -> void {
        p_vec_set(self, idx, value);
    }

    // Remove all elements
    pub fn clear(self: Vec) -> void {
        p_vec_clear(self);
    }

    // Current capacity
    pub fn capacity(self: Vec) -> i64 {
        return p_vec_capacity(self);
    }

    // Insert element at index (shifts subsequent elements right)
    pub fn insert(self: Vec, idx: i64, value: i64) -> void {
        p_vec_insert(self, idx, value);
    }

    // Remove and return element at index (shifts subsequent elements left)
    pub fn remove(self: Vec, idx: i64) -> i64 {
        return p_vec_remove(self, idx);
    }

    // Check if value is in the Vec
    pub fn contains(self: Vec, value: i64) -> bool {
        return p_vec_contains(self, value);
    }

    // Reverse in place
    pub fn reverse(self: Vec) -> void {
        p_vec_reverse(self);
    }

    // Get first element
    pub fn first(self: Vec) -> i64 {
        return p_vec_first(self);
    }

    // Get last element
    pub fn last(self: Vec) -> i64 {
        return p_vec_last(self);
    }

    // Extend with another Vec
    pub fn extend(self: Vec, other: Vec) -> void {
        p_vec_extend(self, other);
    }

    // Truncate to length n
    pub fn truncate(self: Vec, n: i64) -> void {
        p_vec_truncate(self, n);
    }

    // Sort in place
    pub fn sort(self: Vec) -> void {
        p_vec_sort(self);
    }

    // Deep clone
    pub fn clone(self: Vec) -> Vec {
        return p_vec_clone(self);
    }

    // Map: apply a function to each element, return new Vec of results
    // Usage: value doubled = v.map(double);
    //        value squares = v.map(fn(x: i64) { x * x });
    pub fn map(self: Vec, f: fn(i64) -> i64) -> Vec {
        var result: Vec = Vec::new();
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            var y: i64 = f(x);
            result.push(y);
            i = i + 1;
        }
        return result;
    }

    // Filter: keep only elements where predicate returns true
    // Usage: value evens = v.filter(fn(x: i64) { x % 2 == 0 });
    pub fn filter(self: Vec, pred: fn(i64) -> bool) -> Vec {
        var result: Vec = Vec::new();
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if pred(x) {
                result.push(x);
            }
            i = i + 1;
        }
        return result;
    }

    // For each: apply a function to each element (side effects only)
    // Usage: v.for_each(fn(x: i64) { print(x); });
    pub fn for_each(self: Vec, f: fn(i64) -> void) -> void {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            f(x);
            i = i + 1;
        }
    }

    // Fold/reduce: accumulate a result by applying f to each element
    // Usage: value sum = v.fold(0, fn(acc: i64, x: i64) { acc + x });
    pub fn fold(self: Vec, init: i64, f: fn(i64, i64) -> i64) -> i64 {
        var acc: i64 = init;
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            acc = f(acc, x);
            i = i + 1;
        }
        return acc;
    }

    // Any: returns true if any element satisfies the predicate
    pub fn any(self: Vec, pred: fn(i64) -> bool) -> bool {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if pred(x) { return true; }
            i = i + 1;
        }
        return false;
    }

    // All: returns true if all elements satisfy the predicate
    pub fn all(self: Vec, pred: fn(i64) -> bool) -> bool {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if !pred(x) { return false; }
            i = i + 1;
        }
        return true;
    }

    // Find: returns the first element satisfying the predicate, or -1
    pub fn find(self: Vec, pred: fn(i64) -> bool) -> i64 {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if pred(x) { return x; }
            i = i + 1;
        }
        return -1;
    }

    // Index of first element satisfying predicate, or -1
    pub fn position(self: Vec, pred: fn(i64) -> bool) -> i64 {
        var i: i64 = 0;
        var n: i64 = self.len();
        while i < n {
            var x: i64 = self.get(i);
            if pred(x) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // ─── Iterator Adapters (Phase 2.3) ──────────────────────────────
    // Note: These delegate to the free function versions (Vec_take, etc.)
    // because Vec_new() returns i64, not Vec, and method calls on i64
    // are not supported by the typechecker.

    pub fn take(self: Vec, n: i64) -> Vec {
        return vec_take(self, n);
    }

    pub fn skip(self: Vec, n: i64) -> Vec {
        return vec_skip(self, n);
    }

    pub fn zip(self: Vec, other: Vec) -> Vec {
        return vec_zip(self, other);
    }

    pub fn enumerate(self: Vec) -> Vec {
        return vec_enumerate(self);
    }

    pub fn flat_map(self: Vec, f: fn(i64) -> i64) -> Vec {
        return vec_flat_map(self, f);
    }

    pub fn chunk(self: Vec, size: i64) -> Vec {
        return vec_chunk(self, size);
    }

    pub fn window(self: Vec, size: i64) -> Vec {
        return vec_window(self, size);
    }

    pub fn dedup(self: Vec) -> void {
        vec_dedup(self);
    }

    pub fn sort_by(self: Vec, cmp: fn(i64, i64) -> i64) -> void {
        vec_sort_by(self, cmp);
    }

    pub fn contains_val(self: Vec, value: i64) -> bool {
        return vec_contains_val(self, value);
    }
}

// ─── Free function wrappers for iterator adapters ───────────────────────
// These allow calling Vec_take(v, 3) instead of v.take(3) when using `use vec;`

pub fn vec_take(self: Vec, n: i64) -> Vec {
    var result: Vec = Vec_new();
    var len: i64 = Vec_len(self);
    var count: i64 = n;
    if count > len { count = len; }
    var i: i64 = 0;
    while i < count {
        Vec_push(result, Vec_get(self, i));
        i = i + 1;
    }
    return result;
}

pub fn vec_skip(self: Vec, n: i64) -> Vec {
    var result: Vec = Vec_new();
    var len: i64 = Vec_len(self);
    var start: i64 = n;
    if start < 0 { start = 0; }
    var i: i64 = start;
    while i < len {
        Vec_push(result, Vec_get(self, i));
        i = i + 1;
    }
    return result;
}

pub fn vec_zip(self: Vec, other: Vec) -> Vec {
    var result: Vec = Vec_new();
    var n1: i64 = Vec_len(self);
    var n2: i64 = Vec_len(other);
    var n: i64 = n1;
    if n2 < n { n = n2; }
    var i: i64 = 0;
    while i < n {
        Vec_push(result, Vec_get(self, i));
        Vec_push(result, Vec_get(other, i));
        i = i + 1;
    }
    return result;
}

pub fn vec_enumerate(self: Vec) -> Vec {
    var result: Vec = Vec_new();
    var n: i64 = Vec_len(self);
    var i: i64 = 0;
    while i < n {
        Vec_push(result, i);
        Vec_push(result, Vec_get(self, i));
        i = i + 1;
    }
    return result;
}

pub fn vec_flat_map(self: Vec, f: fn(i64) -> i64) -> Vec {
    var result: Vec = Vec_new();
    var n: i64 = Vec_len(self);
    var i: i64 = 0;
    while i < n {
        var mapped: i64 = f(Vec_get(self, i));
        var m: i64 = Vec_len(mapped);
        var j: i64 = 0;
        while j < m {
            Vec_push(result, Vec_get(mapped, j));
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

pub fn vec_chunk(self: Vec, size: i64) -> Vec {
    var result: Vec = Vec_new();
    var n: i64 = Vec_len(self);
    var i: i64 = 0;
    while i < n {
        Vec_push(result, i);
        i = i + size;
    }
    return result;
}

pub fn vec_window(self: Vec, size: i64) -> Vec {
    var result: Vec = Vec_new();
    var n: i64 = Vec_len(self);
    if size <= 0 { return result; }
    var i: i64 = 0;
    while i + size <= n {
        Vec_push(result, i);
        i = i + 1;
    }
    return result;
}

pub fn vec_dedup(self: Vec) -> void {
    var n: i64 = Vec_len(self);
    if n <= 1 { return; }
    var write: i64 = 1;
    var i: i64 = 1;
    while i < n {
        if Vec_get(self, i) != Vec_get(self, i - 1) {
            Vec_set(self, write, Vec_get(self, i));
            write = write + 1;
        }
        i = i + 1;
    }
    p_vec_truncate(self, write);
}

pub fn vec_sort_by(self: Vec, cmp: fn(i64, i64) -> i64) -> void {
    var n: i64 = Vec_len(self);
    var i: i64 = 1;
    while i < n {
        var key: i64 = Vec_get(self, i);
        var j: i64 = i - 1;
        while j >= 0 {
            if cmp(Vec_get(self, j), key) <= 0 { break; }
            Vec_set(self, j + 1, Vec_get(self, j));
            j = j - 1;
        }
        Vec_set(self, j + 1, key);
        i = i + 1;
    }
}

pub fn vec_contains_val(self: Vec, value: i64) -> bool {
    var n: i64 = Vec_len(self);
    var i: i64 = 0;
    while i < n {
        if Vec_get(self, i) == value { return true; }
        i = i + 1;
    }
    return false;
}
