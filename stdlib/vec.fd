// Fides Vec standard library
//
// Dynamic array with amortized O(1) push/pop.
//
// The runtime representation is opaque (PVec* in C, Value::Vec in interpreter).
// Methods forward to p_vec_* runtime functions which handle memory management.
// Fields are private to prevent direct access — use methods instead.
//
// Usage:
//   use core;
//   pv v = Vec::new();
//   v.push(1);
//   v.push(2);
//   print(v.len());  // 2
//   print(v.get(0)); // 1

module vec;

// Vec struct — fields are private, accessed only via methods.
// Runtime layout matches PVec: { void** data; int64_t len; int64_t cap; }
pub struct Vec<T> {
    data: i64,   // raw pointer (opaque at Fides level)
    len: i64,
    cap: i64,
}

impl Vec {
    // Create a new empty Vec
    pub pf new() -> Vec {
        ret p_vec_new();
    }

    // Append an element to the end
    pub pf push(self: Vec, x: i64) -> void {
        p_vec_push(self, x);
    }

    // Remove and return the last element
    pub pf pop(self: Vec) -> i64 {
        ret p_vec_pop(self);
    }

    // Number of elements
    pub pf len(self: Vec) -> i64 {
        ret p_vec_len(self);
    }

    // Check if empty
    pub pf is_empty(self: Vec) -> bool {
        ret p_vec_is_empty(self);
    }

    // Get element at index (with bounds check)
    pub pf get(self: Vec, idx: i64) -> i64 {
        ret p_vec_get(self, idx);
    }

    // Set element at index (with bounds check)
    pub pf set(self: Vec, idx: i64, val: i64) -> void {
        p_vec_set(self, idx, val);
    }

    // Remove all elements
    pub pf clear(self: Vec) -> void {
        p_vec_clear(self);
    }

    // Current capacity
    pub pf capacity(self: Vec) -> i64 {
        ret p_vec_capacity(self);
    }

    // Insert element at index (shifts subsequent elements right)
    pub pf insert(self: Vec, idx: i64, val: i64) -> void {
        p_vec_insert(self, idx, val);
    }

    // Remove and return element at index (shifts subsequent elements left)
    pub pf remove(self: Vec, idx: i64) -> i64 {
        ret p_vec_remove(self, idx);
    }

    // Check if value is in the Vec
    pub pf contains(self: Vec, val: i64) -> bool {
        ret p_vec_contains(self, val);
    }

    // Reverse in place
    pub pf reverse(self: Vec) -> void {
        p_vec_reverse(self);
    }

    // Get first element
    pub pf first(self: Vec) -> i64 {
        ret p_vec_first(self);
    }

    // Get last element
    pub pf last(self: Vec) -> i64 {
        ret p_vec_last(self);
    }

    // Extend with another Vec
    pub pf extend(self: Vec, other: Vec) -> void {
        p_vec_extend(self, other);
    }

    // Truncate to length n
    pub pf truncate(self: Vec, n: i64) -> void {
        p_vec_truncate(self, n);
    }

    // Sort in place
    pub pf sort(self: Vec) -> void {
        p_vec_sort(self);
    }

    // Deep clone
    pub pf clone(self: Vec) -> Vec {
        ret p_vec_clone(self);
    }

    // Map: apply a function to each element, return new Vec of results
    // Usage: pv doubled = v.map(double);
    //        pv squares = v.map(pf(x: i64) { x * x });
    pub pf map(self: Vec, f: pf(i64) -> i64) -> Vec {
        pv result: Vec = Vec::new();
        pv i: i64 = 0;
        pv n: i64 = self.len();
        while i < n {
            pv x: i64 = self.get(i);
            pv y: i64 = f(x);
            result.push(y);
            i = i + 1;
        }
        ret result;
    }

    // Filter: keep only elements where predicate returns true
    // Usage: pv evens = v.filter(pf(x: i64) { x % 2 == 0 });
    pub pf filter(self: Vec, pred: pf(i64) -> bool) -> Vec {
        pv result: Vec = Vec::new();
        pv i: i64 = 0;
        pv n: i64 = self.len();
        while i < n {
            pv x: i64 = self.get(i);
            if pred(x) {
                result.push(x);
            }
            i = i + 1;
        }
        ret result;
    }

    // For each: apply a function to each element (side effects only)
    // Usage: v.for_each(pf(x: i64) { print(x); });
    pub pf for_each(self: Vec, f: pf(i64) -> void) -> void {
        pv i: i64 = 0;
        pv n: i64 = self.len();
        while i < n {
            pv x: i64 = self.get(i);
            f(x);
            i = i + 1;
        }
    }

    // Fold/reduce: accumulate a result by applying f to each element
    // Usage: pv sum = v.fold(0, pf(acc: i64, x: i64) { acc + x });
    pub pf fold(self: Vec, init: i64, f: pf(i64, i64) -> i64) -> i64 {
        pv acc: i64 = init;
        pv i: i64 = 0;
        pv n: i64 = self.len();
        while i < n {
            pv x: i64 = self.get(i);
            acc = f(acc, x);
            i = i + 1;
        }
        ret acc;
    }

    // Any: returns true if any element satisfies the predicate
    pub pf any(self: Vec, pred: pf(i64) -> bool) -> bool {
        pv i: i64 = 0;
        pv n: i64 = self.len();
        while i < n {
            pv x: i64 = self.get(i);
            if pred(x) { ret true; }
            i = i + 1;
        }
        ret false;
    }

    // All: returns true if all elements satisfy the predicate
    pub pf all(self: Vec, pred: pf(i64) -> bool) -> bool {
        pv i: i64 = 0;
        pv n: i64 = self.len();
        while i < n {
            pv x: i64 = self.get(i);
            if !pred(x) { ret false; }
            i = i + 1;
        }
        ret true;
    }

    // Find: returns the first element satisfying the predicate, or -1
    pub pf find(self: Vec, pred: pf(i64) -> bool) -> i64 {
        pv i: i64 = 0;
        pv n: i64 = self.len();
        while i < n {
            pv x: i64 = self.get(i);
            if pred(x) { ret x; }
            i = i + 1;
        }
        ret -1;
    }

    // Index of first element satisfying predicate, or -1
    pub pf position(self: Vec, pred: pf(i64) -> bool) -> i64 {
        pv i: i64 = 0;
        pv n: i64 = self.len();
        while i < n {
            pv x: i64 = self.get(i);
            if pred(x) { ret i; }
            i = i + 1;
        }
        ret -1;
    }

    // ─── Iterator Adapters (Phase 2.3) ──────────────────────────────
    // Note: These delegate to the free function versions (Vec_take, etc.)
    // because Vec_new() returns i64, not Vec, and method calls on i64
    // are not supported by the typechecker.

    pub pf take(self: Vec, n: i64) -> Vec {
        ret vec_take(self, n);
    }

    pub pf skip(self: Vec, n: i64) -> Vec {
        ret vec_skip(self, n);
    }

    pub pf zip(self: Vec, other: Vec) -> Vec {
        ret vec_zip(self, other);
    }

    pub pf enumerate(self: Vec) -> Vec {
        ret vec_enumerate(self);
    }

    pub pf flat_map(self: Vec, f: pf(i64) -> i64) -> Vec {
        ret vec_flat_map(self, f);
    }

    pub pf chunk(self: Vec, size: i64) -> Vec {
        ret vec_chunk(self, size);
    }

    pub pf window(self: Vec, size: i64) -> Vec {
        ret vec_window(self, size);
    }

    pub pf dedup(self: Vec) -> void {
        vec_dedup(self);
    }

    pub pf sort_by(self: Vec, cmp: pf(i64, i64) -> i64) -> void {
        vec_sort_by(self, cmp);
    }

    pub pf contains_val(self: Vec, val: i64) -> bool {
        ret vec_contains_val(self, val);
    }
}

// ─── Free function wrappers for iterator adapters ───────────────────────
// These allow calling Vec_take(v, 3) instead of v.take(3) when using `use vec;`

pub pf vec_take(self: i64, n: i64) -> i64 {
    pv result: i64 = Vec_new();
    pv len: i64 = Vec_len(self);
    pv count: i64 = n;
    if count > len { count = len; }
    pv i: i64 = 0;
    while i < count {
        Vec_push(result, Vec_get(self, i));
        i = i + 1;
    }
    ret result;
}

pub pf vec_skip(self: i64, n: i64) -> i64 {
    pv result: i64 = Vec_new();
    pv len: i64 = Vec_len(self);
    pv start: i64 = n;
    if start < 0 { start = 0; }
    pv i: i64 = start;
    while i < len {
        Vec_push(result, Vec_get(self, i));
        i = i + 1;
    }
    ret result;
}

pub pf vec_zip(self: i64, other: i64) -> i64 {
    pv result: i64 = Vec_new();
    pv n1: i64 = Vec_len(self);
    pv n2: i64 = Vec_len(other);
    pv n: i64 = n1;
    if n2 < n { n = n2; }
    pv i: i64 = 0;
    while i < n {
        Vec_push(result, Vec_get(self, i));
        Vec_push(result, Vec_get(other, i));
        i = i + 1;
    }
    ret result;
}

pub pf vec_enumerate(self: i64) -> i64 {
    pv result: i64 = Vec_new();
    pv n: i64 = Vec_len(self);
    pv i: i64 = 0;
    while i < n {
        Vec_push(result, i);
        Vec_push(result, Vec_get(self, i));
        i = i + 1;
    }
    ret result;
}

pub pf vec_flat_map(self: i64, f: pf(i64) -> i64) -> i64 {
    pv result: i64 = Vec_new();
    pv n: i64 = Vec_len(self);
    pv i: i64 = 0;
    while i < n {
        pv mapped: i64 = f(Vec_get(self, i));
        pv m: i64 = Vec_len(mapped);
        pv j: i64 = 0;
        while j < m {
            Vec_push(result, Vec_get(mapped, j));
            j = j + 1;
        }
        i = i + 1;
    }
    ret result;
}

pub pf vec_chunk(self: i64, size: i64) -> i64 {
    pv result: i64 = Vec_new();
    pv n: i64 = Vec_len(self);
    pv i: i64 = 0;
    while i < n {
        Vec_push(result, i);
        i = i + size;
    }
    ret result;
}

pub pf vec_window(self: i64, size: i64) -> i64 {
    pv result: i64 = Vec_new();
    pv n: i64 = Vec_len(self);
    if size <= 0 { ret result; }
    pv i: i64 = 0;
    while i + size <= n {
        Vec_push(result, i);
        i = i + 1;
    }
    ret result;
}

pub pf vec_dedup(self: i64) -> void {
    pv n: i64 = Vec_len(self);
    if n <= 1 { ret; }
    pv write: i64 = 1;
    pv i: i64 = 1;
    while i < n {
        if Vec_get(self, i) != Vec_get(self, i - 1) {
            Vec_set(self, write, Vec_get(self, i));
            write = write + 1;
        }
        i = i + 1;
    }
    p_vec_truncate(self, write);
}

pub pf vec_sort_by(self: i64, cmp: pf(i64, i64) -> i64) -> void {
    pv n: i64 = Vec_len(self);
    pv i: i64 = 1;
    while i < n {
        pv key: i64 = Vec_get(self, i);
        pv j: i64 = i - 1;
        while j >= 0 {
            if cmp(Vec_get(self, j), key) <= 0 { break; }
            Vec_set(self, j + 1, Vec_get(self, j));
            j = j - 1;
        }
        Vec_set(self, j + 1, key);
        i = i + 1;
    }
}

pub pf vec_contains_val(self: i64, val: i64) -> bool {
    pv n: i64 = Vec_len(self);
    pv i: i64 = 0;
    while i < n {
        if Vec_get(self, i) == val { ret true; }
        i = i + 1;
    }
    ret false;
}
