// Fides JOSE: JSON Web Signature (RFC 7515, compact serialization), JSON
// Web Key and key sets (RFC 7517) with thumbprints (RFC 7638), JSON Web
// Token claim checks (RFC 7519 §4.1, §7.2), and JSON Web Encryption
// (RFC 7516, compact) with direct keys or ECDH-ES key agreement.
//
// Algorithms (RFC 7518, RFC 8037):
//   JWS  HS256 HS384 HS512 (HMAC; SHA-384 from ecdsa.fd), ES256 ES384
//        ES512 (P-256/SHA-256, P-384/SHA-384, P-521/SHA-512, ecdsa.fd; raw
//        r || s), EdDSA (Ed25519, ed25519.fd), RS256 RS512 (PKCS#1 v1.5,
//        rsa.fd), PS256 PS512 (PSS, salt = hash length).
//   JWE  alg "dir", "ECDH-ES" (direct agreement on P-256, P-384, P-521 or
//        X25519, the Concat KDF of NIST SP 800-56A with SHA-256), "A128KW",
//        "A192KW", "A256KW" (AES key wrap, RFC 3394, written here with the
//        AES inverse cipher it needs), "RSA-OAEP" and "RSA-OAEP-256" (RSAES-
//        OAEP with SHA-1 / SHA-256 and MGF1 of the same hash, rsa.fd); enc
//        A128GCM, A192GCM or A256GCM (aes_gcm.fd).
// EdDSA with Ed448, RS384/PS384, RSA1_5, ECDH-ES+A*KW, PBES2, the CBC-HMAC
// "enc" values, the JSON serializations and "zip" are not supported: a
// token using them is rejected, never accepted. RSA-OAEP decryption that
// fails continues with a random CEK (RFC 7516 §11.5), so a bad encrypted
// key and a bad ciphertext give the same error.
//
// Pure computation. The seams are time and randomness: claim checks take
// `now` (Unix seconds) from the caller; JWE encryption takes its IV and,
// for ECDH-ES, the ephemeral secret key, for key wrapping the CEK and for
// RSA-OAEP the seed, as arguments (jwe_encrypt_* with crypto_random_bytes
// in real use, fixed bytes in tests); PS256/PS512
// signing draws its salt from crypto_random_bytes unless jws_sign_salted
// is given one.
//
// Verification is strict: the algorithm must be in the caller's allow
// list ("none" never is), must fit the key type (no HMAC with a public
// key: the alg-confusion attack), the key's own "alg", if any, must
// match, a "crit" header is refused (no extension is understood), and
// base64url must be canonical (no padding, no stray bits). RSA keys of
// 1024 bits and up are accepted (RFC 7518 §3.3 asks 2048 for new keys;
// enforce that in the caller where it matters), HMAC keys must be at
// least as long as the hash.
//
// Checked in tests/bootstrap/test_std_jose.fd against RFC 7515 A.1
// (HS256), RFC 8037 A.4 (EdDSA), RFC 7638 §3.1 (thumbprint), RFC 7518
// Appendix C (ECDH-ES Concat KDF), RFC 3394 §4 (AES key wrap), HS384 and
// A128KW/A256KW JWEs made with Node.js, and ES256/RS256/PS256 tokens and an
// A256GCM JWE made with Node.js (OpenSSL); ES384, ES512 and RSA-OAEP-256
// against Node.js in tests/bootstrap/test_std_jose_pk.fd (C backend).
//
// Usage:
//   use jose;
//   val key = jwk_parse(jwk_json);
//   val token = jws_sign("{\"alg\":\"ES256\",\"kid\":\"k1\"}", str_bytes(payload), & key);
//   val v = jws_verify(token, & key, "ES256");           // v.ok, v.payload
//   val opts = jwt_options(now, "https://issuer", "client-1");
//   val r = jwt_verify(token, & key, "ES256,RS256", & opts);  // r.ok, r.claims

module jose;
use vec;
use string;
use encoding;
use json;
use crypto;
use kdf;
use bigint;
use rsa;
use ecdsa;
use x25519;
use ed25519;
use aes_gcm;

/// Bytes with a validity flag (base64url decoding, key agreement).
pub struct JoseBytes {
    pub ok: bool,
    pub data: Vec<i64>,
}

/// A JSON Web Key. Byte fields hold the decoded base64url members;
/// absent members are empty. `kty` is "oct", "EC", "OKP" or "RSA".
pub struct Jwk {
    pub ok: bool,
    pub kty: str,
    pub kid: str,
    pub alg: str,
    pub usage: str,
    pub crv: str,
    pub k: Vec<i64>,
    pub x: Vec<i64>,
    pub y: Vec<i64>,
    pub d: Vec<i64>,
    pub n: Vec<i64>,
    pub e: Vec<i64>,
    pub p: Vec<i64>,
    pub q: Vec<i64>,
}

/// The parts of a compact JWS before verification.
pub struct JwsParts {
    pub ok: bool,
    pub header: str,
    pub payload: Vec<i64>,
    pub signature: Vec<i64>,
    pub signing_input: Vec<i64>,
}

/// The result of verifying a JWS.
pub struct JwsVerified {
    pub ok: bool,
    pub err: str,
    pub alg: str,
    pub header: str,
    pub payload: Vec<i64>,
}

/// What a JWT check needs: the current time, the allowed clock skew, and
/// the expected issuer and audience ("" = do not check the issuer; an
/// empty audience accepts only tokens without an "aud" claim).
pub struct JwtOptions {
    pub now: i64,
    pub leeway: i64,
    pub iss: str,
    pub aud: str,
    pub require_exp: bool,
}

/// The result of verifying a JWT: the claims set (JSON text) when ok.
pub struct JwtResult {
    pub ok: bool,
    pub err: str,
    pub header: str,
    pub claims: str,
}

/// The result of decrypting a JWE.
pub struct JweDecrypted {
    pub ok: bool,
    pub err: str,
    pub header: str,
    pub plain: Vec<i64>,
}

// ─── Small byte helpers ────────────────────────────────────────────────

fn jose_cat(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = a;
    var i: i64 = 0;
    while i < b.len() { out.push(b.get(i)); i = i + 1; }
    return out;
}

fn jose_u32be(v: i64) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    o.push((v >> 24) & 255);
    o.push((v >> 16) & 255);
    o.push((v >> 8) & 255);
    o.push(v & 255);
    return o;
}

fn jose_slice(v: & Vec<i64>, from: i64, to: i64) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    var i: i64 = from;
    while i < to { o.push(v.get(i)); i = i + 1; }
    return o;
}

/// Left-pad big-endian bytes with zeros to `len` (strips extra leading zeros).
fn jose_pad(b: Vec<i64>, len: i64) -> Vec<i64> {
    var start: i64 = 0;
    while b.len() - start > len && b.get(start) == 0 { start = start + 1; }
    var o: Vec<i64> = Vec::new();
    var i: i64 = b.len() - start;
    while i < len { o.push(0); i = i + 1; }
    i = start;
    while i < b.len() { o.push(b.get(i)); i = i + 1; }
    return o;
}

// ─── base64url without padding (RFC 7515 §2, Appendix C) ───────────────

fn jose_b64_char(v: i64) -> i64 {
    if v < 26 { return 65 + v; }
    if v < 52 { return 97 + v - 26; }
    if v < 62 { return 48 + v - 52; }
    if v == 62 { return 45; }
    return 95;
}

fn jose_b64_val(c: i64) -> i64 {
    if c >= 65 && c <= 90 { return c - 65; }
    if c >= 97 && c <= 122 { return c - 97 + 26; }
    if c >= 48 && c <= 57 { return c - 48 + 52; }
    if c == 45 { return 62; }
    if c == 95 { return 63; }
    return -1;
}

/// base64url of bytes, no padding.
pub fn jose_b64url_encode(b: Vec<i64>) -> str {
    var out: Vec<i64> = Vec::new();
    val n: i64 = b.len();
    var i: i64 = 0;
    while i + 2 < n {
        val w: i64 = ((b.get(i) & 255) << 16) | ((b.get(i + 1) & 255) << 8) | (b.get(i + 2) & 255);
        out.push(jose_b64_char((w >> 18) & 63));
        out.push(jose_b64_char((w >> 12) & 63));
        out.push(jose_b64_char((w >> 6) & 63));
        out.push(jose_b64_char(w & 63));
        i = i + 3;
    }
    if n - i == 1 {
        val w1: i64 = (b.get(i) & 255) << 16;
        out.push(jose_b64_char((w1 >> 18) & 63));
        out.push(jose_b64_char((w1 >> 12) & 63));
    } else if n - i == 2 {
        val w2: i64 = ((b.get(i) & 255) << 16) | ((b.get(i + 1) & 255) << 8);
        out.push(jose_b64_char((w2 >> 18) & 63));
        out.push(jose_b64_char((w2 >> 12) & 63));
        out.push(jose_b64_char((w2 >> 6) & 63));
    }
    return str_from_bytes(out);
}

/// base64url of a string's bytes.
pub fn jose_b64url_str(s: str) -> str {
    return jose_b64url_encode(str_bytes(s));
}

/// Strict base64url decoding: only the URL-safe alphabet, no padding, no
/// length of 1 mod 4, and the unused low bits of the last character zero.
pub fn jose_b64url_decode(s: str) -> JoseBytes {
    val c: Vec<i64> = str_bytes(s);
    val n: i64 = c.len();
    var out: Vec<i64> = Vec::new();
    if n % 4 == 1 { return JoseBytes { ok: false, data: out }; }
    var acc: i64 = 0;
    var bits: i64 = 0;
    var i: i64 = 0;
    while i < n {
        val v: i64 = jose_b64_val(c.get(i));
        if v < 0 { return JoseBytes { ok: false, data: Vec::new() }; }
        acc = ((acc << 6) | v) & 0xffffff;
        bits = bits + 6;
        if bits >= 8 {
            bits = bits - 8;
            out.push((acc >> bits) & 255);
        }
        i = i + 1;
    }
    if bits > 0 && (acc & ((1 << bits) - 1)) != 0 { return JoseBytes { ok: false, data: Vec::new() }; }
    return JoseBytes { ok: true, data: out };
}

/// base64url text to bytes; empty on any error.
pub fn jose_b64url_bytes(s: str) -> Vec<i64> {
    return jose_b64url_decode(s).data;
}

// ─── JWK (RFC 7517, RFC 7518 §6, RFC 8037 §2) ──────────────────────────

/// An empty, invalid key.
pub fn jwk_empty() -> Jwk {
    return Jwk {
        ok: false, kty: "", kid: "", alg: "", usage: "", crv: "",
        k: Vec::new(), x: Vec::new(), y: Vec::new(), d: Vec::new(),
        n: Vec::new(), e: Vec::new(), p: Vec::new(), q: Vec::new()
    };
}

fn jwk_field(json: str, name: str, ok: & mut bool) -> Vec<i64> {
    if !json_has(json, name) { return Vec::new(); }
    val r: JoseBytes = jose_b64url_decode(json_get_str(json, name));
    if !r.ok { *ok = false; }
    return r.data;
}

/// Parse one JWK object. `ok` is false when a member is malformed or a
/// member the key type requires is missing or has the wrong size.
pub fn jwk_parse(json: str) -> Jwk {
    if !str_equal(json_type_safe(json), "object") { return jwk_empty(); }
    var good: bool = true;
    var k: Jwk = jwk_empty();
    k.kty = json_get_str(json, "kty");
    k.kid = json_get_str(json, "kid");
    k.alg = json_get_str(json, "alg");
    k.usage = json_get_str(json, "use");
    k.crv = json_get_str(json, "crv");
    k.k = jwk_field(json, "k", & mut good);
    k.x = jwk_field(json, "x", & mut good);
    k.y = jwk_field(json, "y", & mut good);
    k.d = jwk_field(json, "d", & mut good);
    k.n = jwk_field(json, "n", & mut good);
    k.e = jwk_field(json, "e", & mut good);
    k.p = jwk_field(json, "p", & mut good);
    k.q = jwk_field(json, "q", & mut good);
    if str_equal(k.kty, "oct") {
        if k.k.len() == 0 { good = false; }
    } else if str_equal(k.kty, "EC") {
        val cl: i64 = jose_ec_len(k.crv);
        if cl == 0 || k.x.len() != cl || k.y.len() != cl { good = false; }
        if k.d.len() != 0 && k.d.len() != cl { good = false; }
    } else if str_equal(k.kty, "OKP") {
        if !str_equal(k.crv, "Ed25519") && !str_equal(k.crv, "X25519") { good = false; }
        if k.x.len() != 32 { good = false; }
        if k.d.len() != 0 && k.d.len() != 32 { good = false; }
    } else if str_equal(k.kty, "RSA") {
        if k.n.len() == 0 || k.e.len() == 0 { good = false; }
    } else {
        good = false;
    }
    k.ok = good;
    return k;
}

/// Parse a JWK Set {"keys": [...]}. Keys that do not parse are skipped
/// (RFC 7517 §5: unknown key types are ignored).
pub fn jwks_parse(json: str) -> Vec<Jwk> {
    var out: Vec<Jwk> = Vec::new();
    if !str_equal(json_type_safe(json), "object") { return out; }
    val arr: str = json_get_safe(json, "keys");
    val items: Vec<str> = json_items(arr);
    var i: i64 = 0;
    while i < items.len() {
        val k: Jwk = jwk_parse(items.get(i));
        if k.ok { out.push(k); }
        i = i + 1;
    }
    return out;
}

/// Index of the key with this "kid" in a set, -1 when none.
pub fn jwks_find(keys: & Vec<Jwk>, kid: str) -> i64 {
    var i: i64 = 0;
    while i < keys.len() {
        val k: Jwk = keys.get(i);
        if str_equal(k.kid, kid) { return i; }
        i = i + 1;
    }
    return -1;
}

/// A symmetric key.
pub fn jwk_oct(key: Vec<i64>) -> Jwk {
    var k: Jwk = jwk_empty();
    k.kty = "oct";
    k.k = key;
    k.ok = key.len() > 0;
    return k;
}

/// The coordinate length of a JOSE curve name: 32 (P-256), 48 (P-384),
/// 66 (P-521), 0 for any other.
pub fn jose_ec_len(crv: str) -> i64 {
    if str_equal(crv, "P-256") { return 32; }
    if str_equal(crv, "P-384") { return 48; }
    if str_equal(crv, "P-521") { return 66; }
    return 0;
}

fn jose_ec_curve(crv: str) -> EcCurve {
    if str_equal(crv, "P-384") { return ec_p384(); }
    if str_equal(crv, "P-521") { return ec_p521(); }
    return ec_p256();
}

/// An EC key pair ("P-256", "P-384" or "P-521") from its private scalar.
pub fn jwk_ec_private(crv: str, d: Vec<i64>) -> Jwk {
    var k: Jwk = jwk_empty();
    val l: i64 = jose_ec_len(crv);
    if l == 0 || d.len() != l { return k; }
    val c: EcCurve = jose_ec_curve(crv);
    val pt: Vec<i64> = ec_public_key(& c, d);
    if pt.len() != 2 * l + 1 { return k; }
    k.kty = "EC";
    k.crv = crv;
    k.x = jose_slice(& pt, 1, l + 1);
    k.y = jose_slice(& pt, l + 1, 2 * l + 1);
    k.d = d;
    k.ok = true;
    return k;
}

/// An EC public key from an uncompressed SEC 1 point 04 || X || Y.
pub fn jwk_ec_public(crv: str, point: Vec<i64>) -> Jwk {
    var k: Jwk = jwk_empty();
    val l: i64 = jose_ec_len(crv);
    if l == 0 || point.len() != 2 * l + 1 || point.get(0) != 4 { return k; }
    k.kty = "EC";
    k.crv = crv;
    k.x = jose_slice(& point, 1, l + 1);
    k.y = jose_slice(& point, l + 1, 2 * l + 1);
    k.ok = true;
    return k;
}

/// A P-256 key pair from its 32-byte private scalar.
pub fn jwk_p256_private(d: Vec<i64>) -> Jwk {
    return jwk_ec_private("P-256", d);
}

/// A P-256 public key from an uncompressed SEC 1 point 04 || X || Y.
pub fn jwk_p256_public(point: Vec<i64>) -> Jwk {
    return jwk_ec_public("P-256", point);
}

/// An Ed25519 key pair from its 32-byte seed.
pub fn jwk_ed25519_private(seed: Vec<i64>) -> Jwk {
    var k: Jwk = jwk_empty();
    if seed.len() != 32 { return k; }
    k.kty = "OKP";
    k.crv = "Ed25519";
    k.x = ed25519_public_key(seed);
    k.d = seed;
    k.ok = true;
    return k;
}

/// An X25519 key pair from its 32-byte secret.
pub fn jwk_x25519_private(secret: Vec<i64>) -> Jwk {
    var k: Jwk = jwk_empty();
    if secret.len() != 32 { return k; }
    k.kty = "OKP";
    k.crv = "X25519";
    k.x = x25519_public_key(secret);
    k.d = secret;
    k.ok = true;
    return k;
}

/// An RSA public key from big-endian n and e.
pub fn jwk_rsa_public(n: Vec<i64>, e: Vec<i64>) -> Jwk {
    var k: Jwk = jwk_empty();
    k.kty = "RSA";
    k.n = jose_pad(n, 0);
    k.e = jose_pad(e, 0);
    k.ok = k.n.len() > 0 && k.e.len() > 0;
    return k;
}

/// The public part of a key (private members removed; oct keys have no
/// public part and come back invalid).
pub fn jwk_public(key: & Jwk) -> Jwk {
    var k: Jwk = *key;
    k.d = Vec::new();
    k.p = Vec::new();
    k.q = Vec::new();
    if str_equal(k.kty, "oct") {
        k.k = Vec::new();
        k.ok = false;
    }
    return k;
}

fn jwk_member(name: str, value: str) -> str {
    return json_string(name) + ":" + json_string(value);
}

fn jwk_bmember(name: str, b: & Vec<i64>) -> str {
    return "," + jwk_member(name, jose_b64url_encode(*b));
}

/// The key as JSON. Private members are written only when `private` is
/// true. Member order: kty, crv, the key members, then kid, use, alg.
pub fn jwk_to_json(key: & Jwk, private: bool) -> str {
    var s: str = "{" + jwk_member("kty", key.kty);
    if str_equal(key.kty, "oct") {
        if private { s = s + jwk_bmember("k", & key.k); }
    } else if str_equal(key.kty, "RSA") {
        s = s + jwk_bmember("n", & key.n) + jwk_bmember("e", & key.e);
        if private && key.d.len() > 0 { s = s + jwk_bmember("d", & key.d); }
        if private && key.p.len() > 0 { s = s + jwk_bmember("p", & key.p) + jwk_bmember("q", & key.q); }
    } else {
        s = s + "," + jwk_member("crv", key.crv) + jwk_bmember("x", & key.x);
        if str_equal(key.kty, "EC") { s = s + jwk_bmember("y", & key.y); }
        if private && key.d.len() > 0 { s = s + jwk_bmember("d", & key.d); }
    }
    if str_len(key.kid) > 0 { s = s + "," + jwk_member("kid", key.kid); }
    if str_len(key.usage) > 0 { s = s + "," + jwk_member("use", key.usage); }
    if str_len(key.alg) > 0 { s = s + "," + jwk_member("alg", key.alg); }
    return s + "}";
}

/// A JWK Set holding the public parts of these keys.
pub fn jwks_to_json(keys: & Vec<Jwk>) -> str {
    var s: str = "{\"keys\":[";
    var i: i64 = 0;
    while i < keys.len() {
        if i > 0 { s = s + ","; }
        val k: Jwk = keys.get(i);
        s = s + jwk_to_json(& k, false);
        i = i + 1;
    }
    return s + "]}";
}

/// The RFC 7638 thumbprint input: the required public members in
/// lexicographic order, no white space.
pub fn jwk_thumbprint_input(key: & Jwk) -> str {
    if str_equal(key.kty, "RSA") {
        return "{\"e\":\"" + jose_b64url_encode(key.e) + "\",\"kty\":\"RSA\",\"n\":\"" + jose_b64url_encode(key.n) + "\"}";
    }
    if str_equal(key.kty, "EC") {
        return "{\"crv\":\"" + key.crv + "\",\"kty\":\"EC\",\"x\":\"" + jose_b64url_encode(key.x) + "\",\"y\":\"" + jose_b64url_encode(key.y) + "\"}";
    }
    if str_equal(key.kty, "OKP") {
        return "{\"crv\":\"" + key.crv + "\",\"kty\":\"OKP\",\"x\":\"" + jose_b64url_encode(key.x) + "\"}";
    }
    return "{\"k\":\"" + jose_b64url_encode(key.k) + "\",\"kty\":\"oct\"}";
}

/// SHA-256 JWK thumbprint (RFC 7638 §3).
pub fn jwk_thumbprint(key: & Jwk) -> Vec<i64> {
    return crypto_sha256_bytes(str_bytes(jwk_thumbprint_input(key)));
}

/// The thumbprint as base64url (what ACME and "kid" values use).
pub fn jwk_thumbprint_b64(key: & Jwk) -> str {
    return jose_b64url_encode(jwk_thumbprint(key));
}

fn jwk_rsa_pub(key: & Jwk) -> RsaPublicKey {
    return rsa_public(rsa_os2ip(key.n), rsa_os2ip(key.e));
}

fn jwk_rsa_priv(key: & Jwk) -> RsaPrivateKey {
    return rsa_private_from_primes(rsa_os2ip(key.p), rsa_os2ip(key.q), rsa_os2ip(key.e));
}

/// The uncompressed SEC 1 point of an EC key.
pub fn jwk_ec_point(key: & Jwk) -> Vec<i64> {
    var pt: Vec<i64> = Vec::new();
    pt.push(4);
    return jose_cat(jose_cat(pt, key.x), key.y);
}

// ─── JWS (RFC 7515) ────────────────────────────────────────────────────

/// The hash (kdf.fd id) of an RSA or HMAC algorithm, 0 when not one.
fn jose_alg_hash(alg: str) -> i64 {
    if str_equal(alg, "HS256") || str_equal(alg, "RS256") || str_equal(alg, "PS256") || str_equal(alg, "ES256") { return KDF_SHA256; }
    if str_equal(alg, "HS384") || str_equal(alg, "ES384") { return EC_SHA384; }
    if str_equal(alg, "HS512") || str_equal(alg, "RS512") || str_equal(alg, "PS512") || str_equal(alg, "ES512") { return KDF_SHA512; }
    return 0;
}

/// The curve of an ES algorithm ("" when alg is not one).
fn jose_es_curve(alg: str) -> str {
    if str_equal(alg, "ES256") { return "P-256"; }
    if str_equal(alg, "ES384") { return "P-384"; }
    if str_equal(alg, "ES512") { return "P-521"; }
    return "";
}

/// True when `alg` may be used with this key (type, curve, size).
pub fn jws_alg_fits_key(alg: str, key: & Jwk) -> bool {
    if !key.ok { return false; }
    if str_len(key.alg) > 0 && !str_equal(key.alg, alg) { return false; }
    if str_equal(alg, "HS256") || str_equal(alg, "HS384") || str_equal(alg, "HS512") {
        return str_equal(key.kty, "oct") && key.k.len() >= ec_hash_len(jose_alg_hash(alg));
    }
    val esc: str = jose_es_curve(alg);
    if str_len(esc) > 0 { return str_equal(key.kty, "EC") && str_equal(key.crv, esc); }
    if str_equal(alg, "EdDSA") { return str_equal(key.kty, "OKP") && str_equal(key.crv, "Ed25519"); }
    if str_equal(alg, "RS256") || str_equal(alg, "RS512") || str_equal(alg, "PS256") || str_equal(alg, "PS512") {
        return str_equal(key.kty, "RSA") && key.n.len() >= 128;
    }
    return false;
}

/// True when `alg` is one of the comma-separated names in `allowed`.
pub fn jose_alg_allowed(alg: str, allowed: str) -> bool {
    if str_len(alg) == 0 || str_equal(alg, "none") { return false; }
    val names: Vec<str> = str_split(allowed, ",");
    var i: i64 = 0;
    while i < names.len() {
        if str_equal(str_trim(names.get(i)), alg) { return true; }
        i = i + 1;
    }
    return false;
}

/// Sign the bytes `input` with `alg`; empty when the key does not fit.
/// `salt` is used by PS256/PS512 only (hash-length bytes).
pub fn jws_raw_sign(alg: str, key: & Jwk, input: Vec<i64>, salt: Vec<i64>) -> Vec<i64> {
    if !jws_alg_fits_key(alg, key) { return Vec::new(); }
    val h: i64 = jose_alg_hash(alg);
    if str_starts_with(alg, "HS") { return ec_hmac(h, key.k, input); }
    if str_starts_with(alg, "ES") {
        if key.d.len() != jose_ec_len(key.crv) { return Vec::new(); }
        val c: EcCurve = jose_ec_curve(key.crv);
        return ecdsa_sign(& c, key.d, h, input);
    }
    if str_equal(alg, "EdDSA") {
        if key.d.len() != 32 { return Vec::new(); }
        return ed25519_sign(key.d, input);
    }
    if key.p.len() == 0 || key.q.len() == 0 { return Vec::new(); }
    val sk: RsaPrivateKey = jwk_rsa_priv(key);
    if !sk.ok { return Vec::new(); }
    if str_starts_with(alg, "RS") { return rsa_pkcs1_sign(sk, h, input); }
    return rsa_pss_sign(sk, h, input, salt);
}

/// Check a signature over `input`.
pub fn jws_raw_verify(alg: str, key: & Jwk, input: Vec<i64>, sig: Vec<i64>) -> bool {
    if !jws_alg_fits_key(alg, key) { return false; }
    val h: i64 = jose_alg_hash(alg);
    if str_starts_with(alg, "HS") {
        val mac: Vec<i64> = ec_hmac(h, key.k, input);
        return mac.len() == sig.len() && crypto_constant_time_eq(mac, sig);
    }
    if str_starts_with(alg, "ES") {
        if sig.len() != 2 * jose_ec_len(key.crv) { return false; }
        val c: EcCurve = jose_ec_curve(key.crv);
        return ecdsa_verify(& c, jwk_ec_point(key), h, input, sig);
    }
    if str_equal(alg, "EdDSA") { return ed25519_verify(key.x, input, sig); }
    val pk: RsaPublicKey = jwk_rsa_pub(key);
    if !pk.ok || sig.len() != pk.k { return false; }
    if str_starts_with(alg, "RS") { return rsa_pkcs1_verify(pk, h, input, sig); }
    return rsa_pss_verify(pk, h, input, sig, kdf_hash_len(h));
}

/// Compact JWS with the protected header given as exact JSON text (its
/// bytes are what is signed) and a PSS salt; "" when the header has no
/// usable "alg" or the key does not fit it.
pub fn jws_sign_salted(header_json: str, payload: Vec<i64>, key: & Jwk, salt: Vec<i64>) -> str {
    if !str_equal(json_type_safe(header_json), "object") { return ""; }
    val alg: str = json_get_str(header_json, "alg");
    val input: str = jose_b64url_str(header_json) + "." + jose_b64url_encode(payload);
    val sig: Vec<i64> = jws_raw_sign(alg, key, str_bytes(input), salt);
    if sig.len() == 0 { return ""; }
    return input + "." + jose_b64url_encode(sig);
}

/// Compact JWS; PSS salts come from crypto_random_bytes.
pub fn jws_sign(header_json: str, payload: Vec<i64>, key: & Jwk) -> str {
    var salt: Vec<i64> = Vec::new();
    val alg: str = json_get_str(header_json, "alg");
    if str_starts_with(alg, "PS") { salt = crypto_random_bytes(kdf_hash_len(jose_alg_hash(alg))); }
    return jws_sign_salted(header_json, payload, key, salt);
}

/// A protected header {"alg":..,"typ":..,"kid":..}; empty typ/kid are left out.
pub fn jws_header(alg: str, typ: str, kid: str) -> str {
    var s: str = "{" + jwk_member("alg", alg);
    if str_len(typ) > 0 { s = s + "," + jwk_member("typ", typ); }
    if str_len(kid) > 0 { s = s + "," + jwk_member("kid", kid); }
    return s + "}";
}

fn jws_bad_parts() -> JwsParts {
    return JwsParts { ok: false, header: "", payload: Vec::new(), signature: Vec::new(), signing_input: Vec::new() };
}

/// Split and decode a compact JWS without checking the signature.
pub fn jws_decode(token: str) -> JwsParts {
    val parts: Vec<str> = str_split(token, ".");
    if parts.len() != 3 { return jws_bad_parts(); }
    val h: JoseBytes = jose_b64url_decode(parts.get(0));
    val p: JoseBytes = jose_b64url_decode(parts.get(1));
    val s: JoseBytes = jose_b64url_decode(parts.get(2));
    if !h.ok || !p.ok || !s.ok { return jws_bad_parts(); }
    val header: str = str_from_bytes(h.data);
    if !str_equal(json_type_safe(header), "object") { return jws_bad_parts(); }
    return JwsParts {
        ok: true, header: header, payload: p.data, signature: s.data,
        signing_input: str_bytes(parts.get(0) + "." + parts.get(1))
    };
}

fn jws_fail(err: str) -> JwsVerified {
    return JwsVerified { ok: false, err: err, alg: "", header: "", payload: Vec::new() };
}

fn jws_check_parts(t: & JwsParts, key: & Jwk, allowed: str) -> JwsVerified {
    val alg: str = json_get_str(t.header, "alg");
    if !jose_alg_allowed(alg, allowed) { return jws_fail("algorithm not allowed"); }
    if json_has(t.header, "crit") { return jws_fail("unsupported critical header"); }
    if !jws_alg_fits_key(alg, key) { return jws_fail("key does not fit the algorithm"); }
    if !jws_raw_verify(alg, key, t.signing_input, t.signature) { return jws_fail("bad signature"); }
    return JwsVerified { ok: true, err: "", alg: alg, header: t.header, payload: t.payload };
}

/// Verify a compact JWS with one key, accepting only the algorithms in
/// `allowed` (comma-separated, e.g. "ES256,EdDSA").
pub fn jws_verify(token: str, key: & Jwk, allowed: str) -> JwsVerified {
    val t: JwsParts = jws_decode(token);
    if !t.ok { return jws_fail("malformed token"); }
    return jws_check_parts(& t, key, allowed);
}

/// Verify against a key set: the key named by the header's "kid", or,
/// without a kid, each key in turn.
pub fn jws_verify_jwks(token: str, keys: & Vec<Jwk>, allowed: str) -> JwsVerified {
    val t: JwsParts = jws_decode(token);
    if !t.ok { return jws_fail("malformed token"); }
    if json_has(t.header, "kid") {
        val i: i64 = jwks_find(keys, json_get_str(t.header, "kid"));
        if i < 0 { return jws_fail("unknown kid"); }
        val k: Jwk = keys.get(i);
        return jws_check_parts(& t, & k, allowed);
    }
    var j: i64 = 0;
    while j < keys.len() {
        val k2: Jwk = keys.get(j);
        val r: JwsVerified = jws_check_parts(& t, & k2, allowed);
        if r.ok { return r; }
        j = j + 1;
    }
    return jws_fail("no key verifies the token");
}

// ─── JWT claims (RFC 7519) ─────────────────────────────────────────────

/// Options: the time now, 60 s leeway, issuer and audience, exp required.
pub fn jwt_options(now: i64, iss: str, aud: str) -> JwtOptions {
    return JwtOptions { now: now, leeway: 60, iss: iss, aud: aud, require_exp: true };
}

fn jwt_num(claims: str, name: str, present: & mut bool) -> i64 {
    val v: str = json_get_safe(claims, name);
    if str_equal(json_type_safe(v), "number") {
        *present = true;
        return str_parse_int(v);
    }
    *present = false;
    return 0;
}

fn jwt_num_or_absent(claims: str, name: str) -> bool {
    if !json_has(claims, name) { return true; }
    return str_equal(json_type_safe(json_get_safe(claims, name)), "number");
}

fn jwt_aud_has(claims: str, aud: str) -> bool {
    val v: str = json_get_safe(claims, "aud");
    val t: str = json_type_safe(v);
    if str_equal(t, "string") { return str_equal(json_unescape(v), aud); }
    if str_equal(t, "array") {
        var i: i64 = 0;
        while i < json_len_safe(v) {
            if str_equal(json_at_str(v, i), aud) { return true; }
            i = i + 1;
        }
    }
    return false;
}

/// Check the registered claims; "" when they pass, else the reason.
pub fn jwt_check_claims(claims: str, o: & JwtOptions) -> str {
    if !str_equal(json_type_safe(claims), "object") { return "claims are not a JSON object"; }
    var has: bool = false;
    if !jwt_num_or_absent(claims, "exp") { return "exp is not a number"; }
    if !jwt_num_or_absent(claims, "nbf") { return "nbf is not a number"; }
    if !jwt_num_or_absent(claims, "iat") { return "iat is not a number"; }
    val exp: i64 = jwt_num(claims, "exp", & mut has);
    if has {
        if o.now >= exp + o.leeway { return "token expired"; }
    } else if o.require_exp {
        return "no exp claim";
    }
    val nbf: i64 = jwt_num(claims, "nbf", & mut has);
    if has && o.now + o.leeway < nbf { return "token not yet valid"; }
    val iat: i64 = jwt_num(claims, "iat", & mut has);
    if has && iat > o.now + o.leeway { return "token issued in the future"; }
    if str_len(o.iss) > 0 && !str_equal(json_get_str(claims, "iss"), o.iss) { return "wrong issuer"; }
    if json_has(claims, "aud") {
        if str_len(o.aud) == 0 || !jwt_aud_has(claims, o.aud) { return "wrong audience"; }
    } else if str_len(o.aud) > 0 {
        return "no aud claim";
    }
    return "";
}

fn jwt_fail(err: str) -> JwtResult {
    return JwtResult { ok: false, err: err, header: "", claims: "" };
}

fn jwt_finish(v: JwsVerified, o: & JwtOptions) -> JwtResult {
    if !v.ok { return jwt_fail(v.err); }
    val claims: str = str_from_bytes(v.payload);
    val e: str = jwt_check_claims(claims, o);
    if str_len(e) > 0 { return jwt_fail(e); }
    return JwtResult { ok: true, err: "", header: v.header, claims: claims };
}

/// Verify a JWT's signature with one key, then its claims.
pub fn jwt_verify(token: str, key: & Jwk, allowed: str, o: & JwtOptions) -> JwtResult {
    return jwt_finish(jws_verify(token, key, allowed), o);
}

/// Verify a JWT against a key set, then its claims.
pub fn jwt_verify_jwks(token: str, keys: & Vec<Jwk>, allowed: str, o: & JwtOptions) -> JwtResult {
    return jwt_finish(jws_verify_jwks(token, keys, allowed), o);
}

/// Sign a claims set (JSON text) as a JWT with header {"alg","typ":"JWT","kid"}.
pub fn jwt_sign(claims_json: str, key: & Jwk, alg: str) -> str {
    return jws_sign(jws_header(alg, "JWT", key.kid), str_bytes(claims_json), key);
}

// ─── JWE (RFC 7516) ────────────────────────────────────────────────────

/// Content-encryption key length in bytes of an "enc" value, 0 if unknown.
pub fn jwe_enc_key_len(enc: str) -> i64 {
    if str_equal(enc, "A128GCM") { return 16; }
    if str_equal(enc, "A192GCM") { return 24; }
    if str_equal(enc, "A256GCM") { return 32; }
    return 0;
}

/// The Concat KDF of NIST SP 800-56A §5.8.1 as RFC 7518 §4.6.2 uses it:
/// SHA-256 rounds over counter || Z || OtherInfo, where OtherInfo is
/// AlgorithmID || PartyUInfo || PartyVInfo (each length-prefixed) ||
/// keydatalen in bits.
pub fn jwe_concat_kdf(z: Vec<i64>, alg_id: str, apu: Vec<i64>, apv: Vec<i64>, key_len: i64) -> Vec<i64> {
    val aid: Vec<i64> = str_bytes(alg_id);
    var other: Vec<i64> = jose_cat(jose_u32be(aid.len()), aid);
    other = jose_cat(jose_cat(other, jose_u32be(apu.len())), apu);
    other = jose_cat(jose_cat(other, jose_u32be(apv.len())), apv);
    other = jose_cat(other, jose_u32be(key_len * 8));
    var out: Vec<i64> = Vec::new();
    var counter: i64 = 1;
    while out.len() < key_len {
        val d: Vec<i64> = crypto_sha256_bytes(jose_cat(jose_cat(jose_u32be(counter), z), other));
        var i: i64 = 0;
        while i < d.len() && out.len() < key_len { out.push(d.get(i)); i = i + 1; }
        counter = counter + 1;
    }
    return out;
}

/// The ECDH shared secret Z between a private key and a peer public key
/// of the same curve (P-256, P-384, P-521 or X25519).
pub fn jwe_ecdh(mine: & Jwk, peer: & Jwk) -> JoseBytes {
    if !mine.ok || !peer.ok || mine.d.len() == 0 || !str_equal(mine.crv, peer.crv) {
        return JoseBytes { ok: false, data: Vec::new() };
    }
    val l: i64 = jose_ec_len(mine.crv);
    if l > 0 && str_equal(mine.kty, "EC") && str_equal(peer.kty, "EC") {
        if mine.d.len() != l { return JoseBytes { ok: false, data: Vec::new() }; }
        val c: EcCurve = jose_ec_curve(mine.crv);
        val z: Vec<i64> = ecdh_shared(& c, mine.d, jwk_ec_point(peer));
        return JoseBytes { ok: z.len() == l, data: z };
    }
    if str_equal(mine.crv, "X25519") && mine.d.len() == 32 {
        val z2: Vec<i64> = x25519_scalarmult(mine.d, peer.x);
        if x25519_is_all_zero(z2) { return JoseBytes { ok: false, data: Vec::new() }; }
        return JoseBytes { ok: true, data: z2 };
    }
    return JoseBytes { ok: false, data: Vec::new() };
}

fn jwe_seal(header_json: str, enc_key: Vec<i64>, cek: Vec<i64>, iv: Vec<i64>, plain: Vec<i64>) -> str {
    val h64: str = jose_b64url_str(header_json);
    val sealed: Vec<i64> = aes_gcm_seal(cek, iv, str_bytes(h64), plain);
    if sealed.len() < 16 { return ""; }
    val n: i64 = sealed.len() - 16;
    return h64 + "." + jose_b64url_encode(enc_key) + "." + jose_b64url_encode(iv) + "."
        + jose_b64url_encode(jose_slice(& sealed, 0, n)) + "." + jose_b64url_encode(jose_slice(& sealed, n, sealed.len()));
}

/// Compact JWE with a direct key: the header (exact JSON text) must say
/// "alg":"dir" and an "enc" whose key length matches the oct key. `iv` is
/// 12 random bytes (never reuse one with the same key).
pub fn jwe_encrypt_dir(header_json: str, key: & Jwk, plain: Vec<i64>, iv: Vec<i64>) -> str {
    if !str_equal(json_type_safe(header_json), "object") { return ""; }
    if !str_equal(json_get_str(header_json, "alg"), "dir") || !str_equal(key.kty, "oct") { return ""; }
    if jwe_enc_key_len(json_get_str(header_json, "enc")) != key.k.len() || iv.len() != 12 { return ""; }
    return jwe_seal(header_json, Vec::new(), key.k, iv, plain);
}

/// Compact JWE with ECDH-ES direct key agreement to `recipient` (EC P-256,
/// P-384, P-521 or OKP X25519 public key). `eph_secret` is the ephemeral
/// private key (random, the curve's length), `apu`/`apv` the optional
/// party infos.
pub fn jwe_encrypt_ecdh_es(recipient: & Jwk, enc: str, plain: Vec<i64>, eph_secret: Vec<i64>, iv: Vec<i64>, apu: Vec<i64>, apv: Vec<i64>) -> str {
    val klen: i64 = jwe_enc_key_len(enc);
    if klen == 0 || iv.len() != 12 { return ""; }
    var eph: Jwk = jwk_empty();
    if jose_ec_len(recipient.crv) > 0 {
        eph = jwk_ec_private(recipient.crv, eph_secret);
    } else if str_equal(recipient.crv, "X25519") {
        eph = jwk_x25519_private(eph_secret);
    } else {
        return "";
    }
    val z: JoseBytes = jwe_ecdh(& eph, recipient);
    if !z.ok { return ""; }
    val cek: Vec<i64> = jwe_concat_kdf(z.data, enc, apu, apv, klen);
    var header: str = "{\"alg\":\"ECDH-ES\",\"enc\":" + json_string(enc) + ",\"epk\":" + jwk_to_json(& eph, false);
    if apu.len() > 0 { header = header + "," + jwk_member("apu", jose_b64url_encode(apu)); }
    if apv.len() > 0 { header = header + "," + jwk_member("apv", jose_b64url_encode(apv)); }
    if str_len(recipient.kid) > 0 { header = header + "," + jwk_member("kid", recipient.kid); }
    header = header + "}";
    return jwe_seal(header, Vec::new(), cek, iv, plain);
}

// ─── AES key wrap (RFC 3394) ───────────────────────────────────────────

/// The AES inverse S-box, from the forward one aes_gcm.fd expands.
fn jose_aes_inv_sbox(k: & AesKey) -> Vec<i64> {
    var inv: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 256 { inv.push(0); i = i + 1; }
    i = 0;
    while i < 256 {
        val sv: i64 = (k.sbox.get(i >> 2) >> (24 - 8 * (i & 3))) & 255;
        inv.set(sv, i);
        i = i + 1;
    }
    return inv;
}

fn jose_xt(a: i64) -> i64 {
    return ((a << 1) ^ (((a >> 7) & 1) * 27)) & 255;
}

/// a * b in GF(2^8) for the small constants of InvMixColumns.
fn jose_gmul(a: i64, b: i64) -> i64 {
    var r: i64 = 0;
    var x: i64 = a;
    var y: i64 = b;
    while y > 0 {
        if (y & 1) == 1 { r = r ^ x; }
        x = jose_xt(x);
        y = y >> 1;
    }
    return r;
}

fn jose_add_round_key(st: & mut Vec<i64>, k: & AesKey, round: i64) {
    var c: i64 = 0;
    while c < 4 {
        val w: i64 = k.rk.get(4 * round + c);
        var r: i64 = 0;
        while r < 4 {
            st.set(4 * c + r, st.get(4 * c + r) ^ ((w >> (24 - 8 * r)) & 255));
            r = r + 1;
        }
        c = c + 1;
    }
}

/// InvShiftRows then InvSubBytes.
fn jose_inv_shift_sub(st: & mut Vec<i64>, inv: & Vec<i64>) {
    val old: Vec<i64> = *st;
    var c: i64 = 0;
    while c < 4 {
        var r: i64 = 0;
        while r < 4 {
            st.set(4 * c + r, inv.get(old.get(4 * ((c - r + 4) % 4) + r)));
            r = r + 1;
        }
        c = c + 1;
    }
}

fn jose_inv_mix(st: & mut Vec<i64>) {
    var c: i64 = 0;
    while c < 4 {
        val a0: i64 = st.get(4 * c);
        val a1: i64 = st.get(4 * c + 1);
        val a2: i64 = st.get(4 * c + 2);
        val a3: i64 = st.get(4 * c + 3);
        st.set(4 * c, jose_gmul(a0, 14) ^ jose_gmul(a1, 11) ^ jose_gmul(a2, 13) ^ jose_gmul(a3, 9));
        st.set(4 * c + 1, jose_gmul(a0, 9) ^ jose_gmul(a1, 14) ^ jose_gmul(a2, 11) ^ jose_gmul(a3, 13));
        st.set(4 * c + 2, jose_gmul(a0, 13) ^ jose_gmul(a1, 9) ^ jose_gmul(a2, 14) ^ jose_gmul(a3, 11));
        st.set(4 * c + 3, jose_gmul(a0, 11) ^ jose_gmul(a1, 13) ^ jose_gmul(a2, 9) ^ jose_gmul(a3, 14));
        c = c + 1;
    }
}

/// The AES inverse cipher (FIPS 197 §5.3) on one 16-byte block.
@secret fn jose_aes_decrypt_block(@secret k: & AesKey, inv: & Vec<i64>, block: Vec<i64>) -> Vec<i64> {
    var st: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 16 { st.push(block.get(i) & 255); i = i + 1; }
    jose_add_round_key(& mut st, k, k.nr);
    var round: i64 = k.nr - 1;
    while round >= 1 {
        jose_inv_shift_sub(& mut st, inv);
        jose_add_round_key(& mut st, k, round);
        jose_inv_mix(& mut st);
        round = round - 1;
    }
    jose_inv_shift_sub(& mut st, inv);
    jose_add_round_key(& mut st, k, 0);
    return st;
}

/// AES key wrap (RFC 3394 §2.2.1) of key data (a multiple of 8 bytes, at
/// least 16) under a 16-, 24- or 32-byte KEK; empty on a bad length.
/// Released: the wrapped key is what goes on the wire.
@declassify pub fn jose_aes_kw_wrap(@secret kek: Vec<i64>, @secret data: Vec<i64>) -> Vec<i64> {
    val k: AesKey = aes_key_expand(kek);
    if k.nr == 0 || data.len() < 16 || data.len() % 8 != 0 { return Vec::new(); }
    val n: i64 = data.len() / 8;
    var a: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 8 { a.push(0xa6); i = i + 1; }
    var r: Vec<i64> = data;
    var j: i64 = 0;
    while j < 6 {
        i = 1;
        while i <= n {
            val b: Vec<i64> = aes_encrypt_block(k, jose_cat(a, jose_slice(& r, 8 * (i - 1), 8 * i)));
            val t: i64 = n * j + i;
            a = jose_slice(& b, 0, 8);
            var q: i64 = 0;
            while q < 8 {
                a.set(7 - q, a.get(7 - q) ^ ((t >> (8 * q)) & 255));
                r.set(8 * (i - 1) + q, b.get(8 + q));
                q = q + 1;
            }
            i = i + 1;
        }
        j = j + 1;
    }
    return jose_cat(a, r);
}

/// AES key unwrap (RFC 3394 §2.2.2); ok false when the integrity check
/// value is not A6A6A6A6A6A6A6A6 (wrong KEK or tampered data).
@declassify pub fn jose_aes_kw_unwrap(@secret kek: Vec<i64>, wrapped: Vec<i64>) -> JoseBytes {
    val k: AesKey = aes_key_expand(kek);
    if k.nr == 0 || wrapped.len() < 24 || wrapped.len() % 8 != 0 { return JoseBytes { ok: false, data: Vec::new() }; }
    val inv: Vec<i64> = jose_aes_inv_sbox(& k);
    val n: i64 = wrapped.len() / 8 - 1;
    var a: Vec<i64> = jose_slice(& wrapped, 0, 8);
    var r: Vec<i64> = jose_slice(& wrapped, 8, wrapped.len());
    var j: i64 = 5;
    while j >= 0 {
        var i: i64 = n;
        while i >= 1 {
            val t: i64 = n * j + i;
            var q: i64 = 0;
            while q < 8 {
                a.set(7 - q, a.get(7 - q) ^ ((t >> (8 * q)) & 255));
                q = q + 1;
            }
            val b: Vec<i64> = jose_aes_decrypt_block(& k, & inv, jose_cat(a, jose_slice(& r, 8 * (i - 1), 8 * i)));
            a = jose_slice(& b, 0, 8);
            q = 0;
            while q < 8 {
                r.set(8 * (i - 1) + q, b.get(8 + q));
                q = q + 1;
            }
            i = i - 1;
        }
        j = j - 1;
    }
    var diff: i64 = 0;
    var p: i64 = 0;
    while p < 8 { diff = diff | (a.get(p) ^ 0xa6); p = p + 1; }
    if diff != 0 { return JoseBytes { ok: false, data: Vec::new() }; }
    return JoseBytes { ok: true, data: r };
}

/// KEK length of an AES key-wrap "alg", 0 when not one.
pub fn jwe_kw_key_len(alg: str) -> i64 {
    if str_equal(alg, "A128KW") { return 16; }
    if str_equal(alg, "A192KW") { return 24; }
    if str_equal(alg, "A256KW") { return 32; }
    return 0;
}

/// The OAEP hash (kdf.fd id) of an RSA-OAEP "alg", 0 when not one.
fn jwe_oaep_hash(alg: str) -> i64 {
    if str_equal(alg, "RSA-OAEP") { return KDF_SHA1; }
    if str_equal(alg, "RSA-OAEP-256") { return KDF_SHA256; }
    return 0;
}

/// Compact JWE with AES key wrap: the header (exact JSON text) names
/// "alg" A128KW/A192KW/A256KW and an "enc"; `key` is the oct KEK of that
/// size, `cek` the random content key for "enc", `iv` 12 random bytes.
pub fn jwe_encrypt_kw(header_json: str, key: & Jwk, plain: Vec<i64>, cek: Vec<i64>, iv: Vec<i64>) -> str {
    if !str_equal(json_type_safe(header_json), "object") { return ""; }
    val kl: i64 = jwe_kw_key_len(json_get_str(header_json, "alg"));
    if kl == 0 || !str_equal(key.kty, "oct") || key.k.len() != kl { return ""; }
    if jwe_enc_key_len(json_get_str(header_json, "enc")) != cek.len() || iv.len() != 12 { return ""; }
    val ek: Vec<i64> = jose_aes_kw_wrap(key.k, cek);
    if ek.len() == 0 { return ""; }
    return jwe_seal(header_json, ek, cek, iv, plain);
}

/// Compact JWE with RSAES-OAEP: the header names "alg" RSA-OAEP or
/// RSA-OAEP-256 and an "enc"; `key` is the recipient's RSA public key,
/// `cek` the random content key, `iv` 12 random bytes, `seed` the OAEP
/// seed (hash-length random bytes).
pub fn jwe_encrypt_rsa_oaep(header_json: str, key: & Jwk, plain: Vec<i64>, cek: Vec<i64>, iv: Vec<i64>, seed: Vec<i64>) -> str {
    if !str_equal(json_type_safe(header_json), "object") { return ""; }
    val h: i64 = jwe_oaep_hash(json_get_str(header_json, "alg"));
    if h == 0 || !str_equal(key.kty, "RSA") || key.n.len() < 128 { return ""; }
    if jwe_enc_key_len(json_get_str(header_json, "enc")) != cek.len() || iv.len() != 12 { return ""; }
    val pk: RsaPublicKey = jwk_rsa_pub(key);
    if !pk.ok { return ""; }
    val ek: Vec<i64> = rsa_oaep_encrypt(pk, h, cek, Vec::new(), seed);
    if ek.len() == 0 { return ""; }
    return jwe_seal(header_json, ek, cek, iv, plain);
}

fn jwe_fail(err: str) -> JweDecrypted {
    return JweDecrypted { ok: false, err: err, header: "", plain: Vec::new() };
}

/// Decrypt a compact JWE with `key` (an oct key for "dir" and the AES
/// key-wrap algorithms, the recipient's private EC/OKP key for "ECDH-ES",
/// the recipient's RSA private key with p and q for RSA-OAEP), accepting
/// only the "alg" values in `allowed`.
pub fn jwe_decrypt(token: str, key: & Jwk, allowed: str) -> JweDecrypted {
    val parts: Vec<str> = str_split(token, ".");
    if parts.len() != 5 { return jwe_fail("malformed token"); }
    val h: JoseBytes = jose_b64url_decode(parts.get(0));
    val ek: JoseBytes = jose_b64url_decode(parts.get(1));
    val iv: JoseBytes = jose_b64url_decode(parts.get(2));
    val ct: JoseBytes = jose_b64url_decode(parts.get(3));
    val tag: JoseBytes = jose_b64url_decode(parts.get(4));
    if !h.ok || !ek.ok || !iv.ok || !ct.ok || !tag.ok { return jwe_fail("malformed token"); }
    val header: str = str_from_bytes(h.data);
    if !str_equal(json_type_safe(header), "object") { return jwe_fail("malformed header"); }
    val alg: str = json_get_str(header, "alg");
    val enc: str = json_get_str(header, "enc");
    if !jose_alg_allowed(alg, allowed) { return jwe_fail("algorithm not allowed"); }
    if json_has(header, "crit") || json_has(header, "zip") { return jwe_fail("unsupported header"); }
    val klen: i64 = jwe_enc_key_len(enc);
    if klen == 0 { return jwe_fail("unsupported enc"); }
    val direct: bool = str_equal(alg, "dir") || str_equal(alg, "ECDH-ES");
    if direct && ek.data.len() != 0 { return jwe_fail("unexpected encrypted key"); }
    if iv.data.len() != 12 || tag.data.len() != 16 { return jwe_fail("bad iv or tag length"); }
    var cek: Vec<i64> = Vec::new();
    if jwe_kw_key_len(alg) > 0 {
        if !str_equal(key.kty, "oct") || key.k.len() != jwe_kw_key_len(alg) { return jwe_fail("key does not fit"); }
        val uw: JoseBytes = jose_aes_kw_unwrap(key.k, ek.data);
        if !uw.ok || uw.data.len() != klen { return jwe_fail("decryption failed"); }
        cek = uw.data;
    } else if jwe_oaep_hash(alg) != 0 {
        if !str_equal(key.kty, "RSA") || key.p.len() == 0 || key.q.len() == 0 || key.n.len() < 128 { return jwe_fail("key does not fit"); }
        val sk: RsaPrivateKey = jwk_rsa_priv(key);
        if !sk.ok { return jwe_fail("key does not fit"); }
        val pl: RsaPlain = rsa_oaep_decrypt(sk, jwe_oaep_hash(alg), ek.data, Vec::new());
        // RFC 7516 §11.5: on a bad encrypted key go on with a random CEK,
        // so the failure looks like any other decryption failure.
        cek = crypto_random_bytes(klen);
        if pl.ok && pl.data.len() == klen { cek = pl.data; }
    } else if str_equal(alg, "dir") {
        if !str_equal(key.kty, "oct") || key.k.len() != klen { return jwe_fail("key does not fit"); }
        cek = key.k;
    } else if str_equal(alg, "ECDH-ES") {
        val epk: Jwk = jwk_parse(json_get_safe(header, "epk"));
        if !epk.ok || epk.d.len() != 0 { return jwe_fail("bad epk"); }
        val z: JoseBytes = jwe_ecdh(key, & epk);
        if !z.ok { return jwe_fail("key agreement failed"); }
        val apu: JoseBytes = jose_b64url_decode(json_get_str(header, "apu"));
        val apv: JoseBytes = jose_b64url_decode(json_get_str(header, "apv"));
        if !apu.ok || !apv.ok { return jwe_fail("bad apu/apv"); }
        cek = jwe_concat_kdf(z.data, enc, apu.data, apv.data, klen);
    } else {
        return jwe_fail("unsupported alg");
    }
    val o: GcmOpened = aes_gcm_open(cek, iv.data, str_bytes(parts.get(0)), jose_cat(ct.data, tag.data));
    if !o.ok { return jwe_fail("decryption failed"); }
    return JweDecrypted { ok: true, err: "", header: header, plain: o.plain };
}
