// Transformer inference kernels on flat f64 Vecs — what safetensors
// hands you decoded. Pure Fides: correct-first, vectorizable later.
// Weight layout is row-major [out][in] unless noted.
module infer;

use vec;
use math;

/// y = W x  for W in row-major [rows][cols] f64.
pub fn infer_matvec(w: Vec<f64>, rows: i64, cols: i64, x: Vec<f64>) -> Vec<f64> {
    var y: Vec<f64> = Vec::new();
    var r: i64 = 0;
    while r < rows {
        var acc: f64 = 0.0;
        var base: i64 = r * cols;
        var c: i64 = 0;
        while c < cols {
            acc = acc + w.get(base + c) * x.get(c);
            c = c + 1;
        }
        y.push(acc);
        r = r + 1;
    }
    return y;
}

/// RMSNorm: x / sqrt(mean(x^2) + eps) * weight.
pub fn infer_rmsnorm(x: Vec<f64>, w: Vec<f64>, eps: f64) -> Vec<f64> {
    var ss: f64 = 0.0;
    var i: i64 = 0;
    while i < x.len() { ss = ss + x.get(i) * x.get(i); i = i + 1; }
    var inv: f64 = 1.0 / math_sqrt(ss / x.len() + eps);
    var out: Vec<f64> = Vec::new();
    i = 0;
    while i < x.len() {
        out.push(x.get(i) * inv * w.get(i));
        i = i + 1;
    }
    return out;
}

/// Apply rotary position embedding to a q/k head: pairs
/// (x[2i], x[2i+1]) rotate by pos * theta^(-2i/head_dim). Returns a new
/// Vec so it works on every backend.
pub fn infer_rope(v: Vec<f64>, head_dim: i64, pos: i64, theta: f64) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i * 2 < head_dim {
        var ang: f64 = (pos as f64) / math_pow(theta, (i * 2) as f64 / head_dim);
        var c: f64 = math_cos(ang);
        var s: f64 = math_sin(ang);
        out.push(v.get(i * 2) * c - v.get(i * 2 + 1) * s);
        out.push(v.get(i * 2) * s + v.get(i * 2 + 1) * c);
        i = i + 1;
    }
    var j: i64 = i * 2;
    while j < v.len() { out.push(v.get(j)); j = j + 1; }
    return out;
}

/// Numerically stable softmax (max subtracted).
pub fn infer_softmax(x: Vec<f64>) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    if x.len() == 0 { return out; }
    var m: f64 = x.get(0);
    var i: i64 = 1;
    while i < x.len() {
        if x.get(i) > m { m = x.get(i); }
        i = i + 1;
    }
    var sum: f64 = 0.0;
    i = 0;
    while i < x.len() {
        var e: f64 = math_exp(x.get(i) - m);
        out.push(e);
        sum = sum + e;
        i = i + 1;
    }
    var res: Vec<f64> = Vec::new();
    i = 0;
    while i < out.len() { res.push(out.get(i) / sum); i = i + 1; }
    return res;
}

/// Index of the largest element (ties -> lowest index), -1 when empty.
pub fn infer_argmax(x: Vec<f64>) -> i64 {
    if x.len() == 0 { return -1; }
    var bi: i64 = 0;
    var i: i64 = 1;
    while i < x.len() {
        if x.get(i) > x.get(bi) { bi = i; }
        i = i + 1;
    }
    return bi;
}

/// Single-head attention: q (dim), keys/values flat [seq][dim].
/// Returns sum_i softmax(q.k_i / sqrt(dim)) * v_i — a Vec of dim f64.
pub fn infer_attn(q: Vec<f64>, k: Vec<f64>, v: Vec<f64>, seq: i64,
        dim: i64) -> Vec<f64> {
    var scores: Vec<f64> = Vec::new();
    var inv: f64 = 1.0 / math_sqrt(dim);
    var s: i64 = 0;
    while s < seq {
        var acc: f64 = 0.0;
        var d: i64 = 0;
        while d < dim {
            acc = acc + q.get(d) * k.get(s * dim + d);
            d = d + 1;
        }
        scores.push(acc * inv);
        s = s + 1;
    }
    var probs: Vec<f64> = infer_softmax(scores);
    var out: Vec<f64> = Vec::new();
    var d2: i64 = 0;
    while d2 < dim {
        var acc2: f64 = 0.0;
        s = 0;
        while s < seq {
            acc2 = acc2 + probs.get(s) * v.get(s * dim + d2);
            s = s + 1;
        }
        out.push(acc2);
        d2 = d2 + 1;
    }
    return out;
}

// --- sampling ------------------------------------------------------------------

/// Top-k indices of logits, largest-first (selection sort over k).
pub fn infer_top_k(x: Vec<f64>, k: i64) -> Vec<i64> {
    var order: Vec<i64> = Vec::new();
    var used: Vec<i64> = Vec::new();          // picked flag per index
    var i: i64 = 0;
    while i < x.len() { used.push(0); i = i + 1; }
    var picked: i64 = 0;
    while picked < k && picked < x.len() {
        var bi: i64 = -1;
        var bv: f64 = 0.0;
        i = 0;
        while i < x.len() {
            if used.get(i) == 0 && (bi < 0 || x.get(i) > bv) {
                bi = i; bv = x.get(i);
            }
            i = i + 1;
        }
        if bi < 0 { picked = k; } else {
            used.set(bi, 1);
            order.push(bi);
            picked = picked + 1;
        }
    }
    return order;
}

/// Sample from a probability Vec using u in [0,1). Returns an index.
/// Caller normalizes/softmaxes first (or passes probs from top-k).
pub fn infer_sample(probs: Vec<f64>, u: f64) -> i64 {
    var acc: f64 = 0.0;
    var i: i64 = 0;
    while i < probs.len() {
        acc = acc + probs.get(i);
        if u < acc { return i; }
        i = i + 1;
    }
    if probs.len() == 0 { return -1; }
    return probs.len() - 1;
}

/// Top-p (nucleus): keep the smallest prefix of sorted probs whose
/// mass reaches p, then sample among them. `order` from infer_top_k
/// over the softmax'd logits, `probs` the same softmax values.
/// Returns the chosen LOGIT index.
pub fn infer_sample_top_p(probs: Vec<f64>, order: Vec<i64>, p: f64,
        u: f64) -> i64 {
    var acc: f64 = 0.0;
    var i: i64 = 0;
    var cutoff: i64 = order.len();
    while i < order.len() {
        acc = acc + probs.get(order.get(i));
        if acc >= p { cutoff = i + 1; i = order.len(); }
        i = i + 1;
    }
    // renormalize the kept prefix and sample inside it
    var mass: f64 = 0.0;
    i = 0;
    while i < cutoff { mass = mass + probs.get(order.get(i)); i = i + 1; }
    if mass <= 0.0 { if order.len() > 0 { return order.get(0); } return -1; }
    var r: f64 = u * mass;
    acc = 0.0;
    i = 0;
    while i < cutoff {
        acc = acc + probs.get(order.get(i));
        if r < acc { return order.get(i); }
        i = i + 1;
    }
    return order.get(cutoff - 1);
}
