// Fides LogicalTime standard library — Phase 7.5A (F43)
//
// A timezone-free, clock-free time type for deterministic date math.
//
// LogicalTime represents a point in time as an i64 Unix timestamp (seconds
// since 1970-01-01 00:00:00 UTC). All operations are pure integer arithmetic
// — no system clock, no timezone conversions, no floating-point.
//
// This prevents two classes of bugs that plague financial systems:
//   1. Timezone bugs — a settlement date in New York vs Tokyo
//   2. Clock skew bugs — different servers disagree on "now"
//
// LogicalTime is NOT @linear — it's a value type that can be freely copied.
// All functions are @deterministic (pure integer math, no IO, no randomness).

module time;

/// A logical point in time. Internally stored as Unix seconds (i64).
/// All operations are deterministic — no system clock, no timezones.
pub struct LogicalTime {
    pub seconds: i64,
}

// ─── Construction ─────────────────────────────────────────────────────

/// Create a LogicalTime from a Unix timestamp (seconds since 1970-01-01 UTC).
@deterministic
pub fn time_from_timestamp(ts: i64) -> LogicalTime {
    return LogicalTime { seconds: ts };
}

/// Create a LogicalTime from date components (year, month, day, hour, minute, second).
/// All values are in UTC. No timezone conversion is performed.
/// Uses Howard Hinnant's civil_to_days algorithm for exact date math.
@deterministic
pub fn time_new(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64) -> LogicalTime {
    // civil_to_days: convert (y, m, d) to days since 1970-01-01
    var y = year;
    if month <= 2 {
        y = year - 1;
    }
    var era = 0;
    if y >= 0 {
        era = y / 400;
    } else {
        era = (y - 399) / 400;
    }
    var yoe = y - era * 400;
    var m_adj = 0;
    if month > 2 {
        m_adj = month - 3;
    } else {
        m_adj = month + 9;
    }
    var doy = (153 * m_adj + 2) / 5;
    // doe = day-of-era. doy is the day-of-year for the 1st of the month,
    // so we add (day - 1) to get the actual day.
    var doe = yoe * 365 + yoe / 4 - yoe / 100 + doy + (day - 1);
    var days = era * 146097 + doe - 719468;
    // Convert to seconds and add time
    var secs = days * 86400 + hour * 3600 + minute * 60 + second;
    return LogicalTime { seconds: secs };
}

/// Create a LogicalTime from just a date (year, month, day) at midnight UTC.
@deterministic
pub fn time_from_date(year: i64, month: i64, day: i64) -> LogicalTime {
    return time_new(year, month, day, 0, 0, 0);
}

// ─── Extraction ───────────────────────────────────────────────────────

/// Convert days since epoch to (year, month, day) using Howard Hinnant's
/// days_to_civil algorithm. Returns a tuple.
@deterministic
fn days_to_civil(z_in: i64) -> (i64, i64, i64) {
    var z = z_in + 719468;
    var era = 0;
    if z >= 0 {
        era = z / 146097;
    } else {
        era = (z - 146096) / 146097;
    }
    var doe = z - era * 146097;
    var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    var y = yoe + era * 400;
    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    var mp = (5 * doy + 2) / 153;
    var d = doy - (153 * mp + 2) / 5 + 1;
    var m = 0;
    if mp < 10 {
        m = mp + 3;
    } else {
        m = mp - 9;
    }
    var year = y;
    if m <= 2 {
        year = y + 1;
    }
    return (year, m, d);
}

/// Get the year component of a LogicalTime.
@deterministic
pub fn time_get_year(t: LogicalTime) -> i64 {
    var days = t.seconds / 86400;
    var (year, _, _) = days_to_civil(days);
    return year;
}

/// Get the month component (1-12) of a LogicalTime.
@deterministic
pub fn time_get_month(t: LogicalTime) -> i64 {
    var days = t.seconds / 86400;
    var (_, month, _) = days_to_civil(days);
    return month;
}

/// Get the day-of-month component (1-31) of a LogicalTime.
@deterministic
pub fn time_get_day(t: LogicalTime) -> i64 {
    var days = t.seconds / 86400;
    var (_, _, day) = days_to_civil(days);
    return day;
}

/// Get the hour component (0-23) of a LogicalTime.
@deterministic
pub fn time_get_hour(t: LogicalTime) -> i64 {
    var secs_in_day = t.seconds % 86400;
    var adjusted = secs_in_day;
    if secs_in_day < 0 {
        adjusted = secs_in_day + 86400;
    }
    return adjusted / 3600;
}

/// Get the minute component (0-59) of a LogicalTime.
@deterministic
pub fn time_get_minute(t: LogicalTime) -> i64 {
    var secs_in_day = t.seconds % 86400;
    var adjusted = secs_in_day;
    if secs_in_day < 0 {
        adjusted = secs_in_day + 86400;
    }
    return (adjusted % 3600) / 60;
}

/// Get the second component (0-59) of a LogicalTime.
@deterministic
pub fn time_get_second(t: LogicalTime) -> i64 {
    var secs_in_day = t.seconds % 86400;
    var adjusted = secs_in_day;
    if secs_in_day < 0 {
        adjusted = secs_in_day + 86400;
    }
    return adjusted % 60;
}

/// Get the day of week (0=Sunday, 1=Monday, ..., 6=Saturday).
@deterministic
pub fn time_get_weekday(t: LogicalTime) -> i64 {
    // 1970-01-01 was a Thursday (4)
    var days = t.seconds / 86400;
    // Adjust for negative timestamps (floor division)
    var adjusted = days;
    if t.seconds < 0 {
        if t.seconds % 86400 != 0 {
            adjusted = days - 1;
        }
    }
    // 1970-01-01 is Thursday=4, so (days + 4) % 7 gives weekday
    var wd = (adjusted + 4) % 7;
    if wd < 0 {
        wd = wd + 7;
    }
    return wd;
}

// ─── Arithmetic ───────────────────────────────────────────────────────

/// Add seconds to a LogicalTime.
@deterministic
pub fn time_add_seconds(t: LogicalTime, seconds: i64) -> LogicalTime {
    return LogicalTime { seconds: t.seconds + seconds };
}

/// Subtract seconds from a LogicalTime.
@deterministic
pub fn time_sub_seconds(t: LogicalTime, seconds: i64) -> LogicalTime {
    return LogicalTime { seconds: t.seconds - seconds };
}

/// Add minutes to a LogicalTime.
@deterministic
pub fn time_add_minutes(t: LogicalTime, minutes: i64) -> LogicalTime {
    return LogicalTime { seconds: t.seconds + minutes * 60 };
}

/// Add hours to a LogicalTime.
@deterministic
pub fn time_add_hours(t: LogicalTime, hours: i64) -> LogicalTime {
    return LogicalTime { seconds: t.seconds + hours * 3600 };
}

/// Add days to a LogicalTime.
@deterministic
pub fn time_add_days(t: LogicalTime, days: i64) -> LogicalTime {
    return LogicalTime { seconds: t.seconds + days * 86400 };
}

/// Compute the difference between two LogicalTimes in seconds (a - b).
@deterministic
pub fn time_diff_seconds(a: LogicalTime, b: LogicalTime) -> i64 {
    return a.seconds - b.seconds;
}

/// Compute the difference between two LogicalTimes in days (a - b).
@deterministic
pub fn time_diff_days(a: LogicalTime, b: LogicalTime) -> i64 {
    return (a.seconds - b.seconds) / 86400;
}

// ─── Comparison ───────────────────────────────────────────────────────

/// Check if time a is before time b.
@deterministic
pub fn time_before(a: LogicalTime, b: LogicalTime) -> bool {
    return a.seconds < b.seconds;
}

/// Check if time a is after time b.
@deterministic
pub fn time_after(a: LogicalTime, b: LogicalTime) -> bool {
    return a.seconds > b.seconds;
}

/// Check if two LogicalTimes are equal.
@deterministic
pub fn time_eq(a: LogicalTime, b: LogicalTime) -> bool {
    return a.seconds == b.seconds;
}

/// Check if time a is before or equal to time b.
@deterministic
pub fn time_before_eq(a: LogicalTime, b: LogicalTime) -> bool {
    return a.seconds <= b.seconds;
}

// ─── Formatting ───────────────────────────────────────────────────────

/// Helper: pad a number to 2 digits with leading zero.
@deterministic
fn pad2(n: i64) -> str {
    if n < 10 {
        return "0" + p_to_str(n);
    }
    return p_to_str(n);
}

/// Helper: pad a number to 4 digits with leading zeros.
@deterministic
fn pad4(n: i64) -> str {
    if n < 0 {
        return "-" + pad4(-n);
    }
    if n < 10 {
        return "000" + p_to_str(n);
    }
    if n < 100 {
        return "00" + p_to_str(n);
    }
    if n < 1000 {
        return "0" + p_to_str(n);
    }
    return p_to_str(n);
}

/// Format a LogicalTime as an ISO 8601 string: "YYYY-MM-DDTHH:MM:SSZ"
/// The 'Z' suffix indicates UTC (no timezone).
@deterministic
pub fn time_to_iso(t: LogicalTime) -> str {
    var year = time_get_year(t);
    var month = time_get_month(t);
    var day = time_get_day(t);
    var hour = time_get_hour(t);
    var minute = time_get_minute(t);
    var second = time_get_second(t);

    var s = pad4(year);
    s = s + "-");
    s = s + pad2(month));
    s = s + "-");
    s = s + pad2(day));
    s = s + "T");
    s = s + pad2(hour));
    s = s + ":");
    s = s + pad2(minute));
    s = s + ":");
    s = s + pad2(second));
    s = s + "Z");
    return s;
}

/// Format a LogicalTime as a date string: "YYYY-MM-DD"
@deterministic
pub fn time_to_date_string(t: LogicalTime) -> str {
    var year = time_get_year(t);
    var month = time_get_month(t);
    var day = time_get_day(t);

    var s = pad4(year);
    s = s + "-");
    s = s + pad2(month));
    s = s + "-");
    s = s + pad2(day));
    return s;
}

// ─── Day of Year ──────────────────────────────────────────────────────

/// Check if a year is a leap year.
@deterministic
pub fn is_leap_year(year: i64) -> bool {
    if year % 400 == 0 { return true; }
    if year % 100 == 0 { return false; }
    if year % 4 == 0 { return true; }
    return false;
}

/// Get the day of year (1-366) for a LogicalTime.
@deterministic
pub fn time_get_day_of_year(t: LogicalTime) -> i64 {
    var jan1 = time_from_date(time_get_year(t), 1, 1);
    return time_diff_days(t, jan1) + 1;
}

/// Get the number of days in a given month (1-12) for a given year.
@deterministic
pub fn days_in_month(year: i64, month: i64) -> i64 {
    if month == 1 { return 31; }
    if month == 2 {
        if is_leap_year(year) { return 29; }
        return 28;
    }
    if month == 3 { return 31; }
    if month == 4 { return 30; }
    if month == 5 { return 31; }
    if month == 6 { return 30; }
    if month == 7 { return 31; }
    if month == 8 { return 31; }
    if month == 9 { return 30; }
    if month == 10 { return 31; }
    if month == 11 { return 30; }
    if month == 12 { return 31; }
    return 30;
}

// ─── Wall-clock timing (for profiling and tracing) ─────────────────────
//
// These functions use the system clock (CLOCK_REALTIME) and are NOT
// @deterministic. Use them only for profiling/tracing, not for logic that
// must produce identical results across runs.
//
// For deterministic time math, use LogicalTime above.

/// Get the current wall-clock time in nanoseconds since Unix epoch.
/// NOT deterministic — use for profiling only.
pub fn clock_now_ns() -> i64 {
    return p_clock_now();
}

/// Get the current wall-clock time in microseconds since Unix epoch.
/// NOT deterministic — use for profiling only.
pub fn clock_now_us() -> i64 {
    return p_clock_now_us();
}

/// Get the current wall-clock time in milliseconds since Unix epoch.
/// NOT deterministic — use for profiling only.
pub fn clock_now_ms() -> i64 {
    return p_clock_now_ms();
}

/// Measure elapsed time in nanoseconds between two clock readings.
/// Usage: value start = clock_now_ns(); ...work...; value elapsed = clock_elapsed_ns(start);
pub fn clock_elapsed_ns(start: i64) -> i64 {
    return p_clock_now() - start;
}

/// Measure elapsed time in microseconds between two clock readings.
pub fn clock_elapsed_us(start: i64) -> i64 {
    return p_clock_now_us() - start;
}

/// Measure elapsed time in milliseconds between two clock readings.
pub fn clock_elapsed_ms(start: i64) -> i64 {
    return p_clock_now_ms() - start;
}
