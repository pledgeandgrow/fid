// Fides Regular Expression standard library
//
// Two layers:
//   regex_matches(s, pat) — simple wildcard match (? one char, * any run),
//     unchanged from before; also used by fs.glob.
//   regex_match(s, re)    — a regex engine in pure Fides, linear in the
//     input (a Pike VM, no backtracking): literals, '.', classes [abc] [a-z]
//     [^x], escapes \d \w \s \n \t \\ \. …, quantifiers * + ? {n} {n,} {n,m},
//     anchors ^ $, alternation a|b (inside groups too), grouping ( ).
// Plus find/replace/split helpers built on the engine.
//
// Usage:
//   regex_match("hello123", "h[ae]l+o[0-9]+")     // true
//   regex_find_re("abc123def", "[0-9]+")          // 3
//   regex_replace("a1b2", "[0-9]", "#")           // "a#b#"

module regex;

use vec;

// ─── Wildcard matching (legacy API — unchanged) ─────────────────────────

/// Check if a string matches a simple wildcard pattern.
/// Supports: ? (single char), * (zero or more chars)
pub fn regex_matches(s: str, pattern: str) -> bool {
    return p_regex_match(s, pattern) != 0;
}

// ─── Real regex engine ──────────────────────────────────────────────────
// (The backtracking engine's token layout, kept for its helpers; the Pike
// VM below shares the class, escape and {n,m} parsing.) Tokens, 5 slots:
//   [kind, arg, min, max, -]
//   kind 0 = literal byte          arg = byte
//   kind 1 = '.'                   arg = 0
//   kind 2 = class                 arg = index into cls bitmaps (8 i64s each)
//   kind 3 = '^' anchor            arg = 0
//   kind 4 = '$' anchor            arg = 0
//   kind 5 = group marker          arg = index past the group's body tokens
//        (the group body occupies tokens ti+1 .. arg; the marker itself
//        carries the quantifier and the outer sequence continues at arg)
// Top-level '|' splits the pattern into independent programs; `progs`
// holds (start, end) token-index pairs. '|' inside a group is unsupported
// and fails compilation (ok = false).

const RX_LIT: i64 = 0;
const RX_DOT: i64 = 1;
const RX_CLASS: i64 = 2;
const RX_BOL: i64 = 3;
const RX_EOL: i64 = 4;
const RX_GROUP: i64 = 5;

/// A compiled regex: token Vec + class bitmaps + program ranges + ok flag.
pub struct Regex {
    toks: Vec<i64>,
    cls: Vec<i64>,
    progs: Vec<i64>,
    ok: bool,
}

fn rx_tok_push(v: &mut Vec<i64>, kind: i64, arg: i64, mn: i64, mx: i64) -> void {
    v.push(kind);
    v.push(arg);
    v.push(mn);
    v.push(mx);
    v.push(-1);
}

fn rx_tok(v: Vec<i64>, i: i64) -> i64 {
    return v.get(i * 5);
}
fn rx_arg(v: Vec<i64>, i: i64) -> i64 {
    return v.get(i * 5 + 1);
}
fn rx_min(v: Vec<i64>, i: i64) -> i64 {
    return v.get(i * 5 + 2);
}
fn rx_max(v: Vec<i64>, i: i64) -> i64 {
    return v.get(i * 5 + 3);
}
fn rx_set_arg(v: &mut Vec<i64>, i: i64, a: i64) -> void {
    v.set(i * 5 + 1, a);
}
fn rx_ntoks(v: Vec<i64>) -> i64 {
    return v.len() / 5;
}

fn rx_is_digit(c: i64) -> bool { return c >= 48 && c <= 57; }
fn rx_is_word(c: i64) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}
fn rx_is_space(c: i64) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 12 || c == 11;
}

/// Byte → 256-bit membership bitmap stored as 8 i64s in `bits` at off*8.
fn rx_cls_set(bits: &mut Vec<i64>, off: i64, c: i64) -> void {
    var w: i64 = c / 64;
    var b: i64 = c - w * 64;
    var cur: i64 = bits.get(off * 8 + w);
    bits.set(off * 8 + w, cur | (1 << b));
}
fn rx_cls_get(bits: Vec<i64>, off: i64, c: i64) -> bool {
    var w: i64 = c / 64;
    var b: i64 = c - w * 64;
    return ((bits.get(off * 8 + w) >> b) & 1) != 0;
}
fn rx_new_cls(bits: &mut Vec<i64>) -> i64 {
    var off: i64 = bits.len() / 8;
    var i: i64 = 0;
    while i < 8 {
        bits.push(0);
        i = i + 1;
    }
    return off;
}

fn rx_escape_cls(e: i64) -> i64 {
    // returns 0=digit 1=word 2=space 3=notdigit 4=notword 5=notspace -1=literal
    if e == 100 { return 0; }
    if e == 119 { return 1; }
    if e == 115 { return 2; }
    if e == 68 { return 3; }
    if e == 87 { return 4; }
    if e == 83 { return 5; }
    return -1;
}

fn rx_cls_apply_named(bits: &mut Vec<i64>, off: i64, kind: i64) -> void {
    var c: i64 = 0;
    while c < 256 {
        var mem: bool = false;
        if kind == 0 { mem = rx_is_digit(c); }
        if kind == 1 { mem = rx_is_word(c); }
        if kind == 2 { mem = rx_is_space(c); }
        if kind == 3 { mem = !rx_is_digit(c); }
        if kind == 4 { mem = !rx_is_word(c); }
        if kind == 5 { mem = !rx_is_space(c); }
        if mem { rx_cls_set(bits, off, c); }
        c = c + 1;
    }
}

fn rx_escape_lit(e: i64) -> i64 {
    if e == 110 { return 10; }
    if e == 116 { return 9; }
    if e == 114 { return 13; }
    if e == 48 { return 0; }
    return e;
}

// Parse a class body [ ... ] starting at pattern index i (after '[').
// Fills bitmap at `off`, returns index past ']' or -1 on malformed.
fn rx_parse_class(re: str, i: i64, bits: &mut Vec<i64>, off: i64) -> i64 {
    var n: i64 = str_len(re);
    var j: i64 = i;
    var negate: bool = false;
    if j < n && str_byte_at(re, j) == 94 {
        negate = true;
        j = j + 1;
    }
    var first: bool = true;
    while j < n {
        var c: i64 = str_byte_at(re, j);
        if c == 93 && !first {
            if negate {
                // invert all bits
                var w: i64 = 0;
                while w < 8 {
                    bits.set(off * 8 + w, bits.get(off * 8 + w) ^ (-1));
                    w = w + 1;
                }
            }
            return j + 1;
        }
        first = false;
        if c == 92 {
            if j + 1 >= n { return -1; }
            var e: i64 = str_byte_at(re, j + 1);
            var named: i64 = rx_escape_cls(e);
            if named >= 0 {
                rx_cls_apply_named(bits, off, named);
            } else {
                rx_cls_set(bits, off, rx_escape_lit(e) & 255);
            }
            j = j + 2;
            continue;
        }
        // range a-z
        if j + 2 < n && str_byte_at(re, j + 1) == 45 && str_byte_at(re, j + 2) != 93 {
            var lo: i64 = c;
            var hi: i64 = str_byte_at(re, j + 2);
            var k: i64 = lo;
            while k <= hi {
                rx_cls_set(bits, off, k & 255);
                k = k + 1;
            }
            j = j + 3;
            continue;
        }
        rx_cls_set(bits, off, c & 255);
        j = j + 1;
    }
    return -1;
}

// Parse {n}, {n,}, {n,m} at index i; returns (mn, mx, end) packed into out3
// at slots 0..2, or false.
fn rx_parse_brace(re: str, i: i64, out3: &mut Vec<i64>) -> bool {
    var n: i64 = str_len(re);
    var j: i64 = i;
    var mn: i64 = 0;
    var mx: i64 = -1;
    var has: bool = false;
    while j < n && rx_is_digit(str_byte_at(re, j)) {
        mn = mn * 10 + (str_byte_at(re, j) - 48);
        j = j + 1;
        has = true;
    }
    if !has { return false; }
    if j < n && str_byte_at(re, j) == 44 {
        j = j + 1;
        if j < n && rx_is_digit(str_byte_at(re, j)) {
            mx = 0;
            while j < n && rx_is_digit(str_byte_at(re, j)) {
                mx = mx * 10 + (str_byte_at(re, j) - 48);
                j = j + 1;
            }
        }
    } else {
        mx = mn;
    }
    if j >= n || str_byte_at(re, j) != 125 { return false; }
    out3.push(mn);
    out3.push(mx);
    out3.push(j + 1);
    return true;
}

// ─── The engine: a Pike VM (Thompson NFA) ───────────────────────────────
// Linear in the input (competitive SL7): every position of the subject is
// read once, against at most one thread per instruction, so no pattern
// takes exponential time ((a?){30}a{30} on 30 a's is instant).
//
// Each top-level alternative compiles to its own program of instructions,
// three words each [op, x, y], stored in r.toks; r.progs holds each
// program's entry. Matching is leftmost; at the leftmost start the first
// alternative that matches wins, and within it the longest match (as the
// backtracking engine before it did). Alternation inside groups works too.

const RV_CHAR: i64 = 0;   // x = byte
const RV_ANY: i64 = 1;    // any byte but '\n'
const RV_CLASS: i64 = 2;  // x = class bitmap offset
const RV_BOL: i64 = 3;
const RV_EOL: i64 = 4;
const RV_SPLIT: i64 = 5;  // try x, then y
const RV_JMP: i64 = 6;    // x
const RV_MATCH: i64 = 7;

/// Largest repeat count {n,m} expands to (each copy is code)
const RV_MAX_REPEAT: i64 = 1000;

fn rv_emit(p: &mut Vec<i64>, op: i64, x: i64, y: i64) -> i64 {
    var pc: i64 = p.len() / 3;
    p.push(op);
    p.push(x);
    p.push(y);
    return pc;
}

fn rv_pc(p: &Vec<i64>) -> i64 {
    return p.len() / 3;
}

fn rv_set_x(p: &mut Vec<i64>, pc: i64, x: i64) {
    p.set(pc * 3 + 1, x);
}

fn rv_set_y(p: &mut Vec<i64>, pc: i64, y: i64) {
    p.set(pc * 3 + 2, y);
}

/// Index past the ']' of the class whose body starts at j, or -1.
fn rv_class_end(re: str, j0: i64, n: i64) -> i64 {
    var j: i64 = j0;
    if j < n && str_byte_at(re, j) == 94 { j = j + 1; }
    var first: bool = true;
    while j < n {
        var c: i64 = str_byte_at(re, j);
        if c == 93 && !first { return j + 1; }
        first = false;
        if c == 92 { j = j + 2; } else { j = j + 1; }
    }
    return -1;
}

/// Index past the atom that starts at i (before any quantifier), or -1.
fn rv_atom_end(re: str, i: i64, n: i64) -> i64 {
    if i >= n { return -1; }
    var c: i64 = str_byte_at(re, i);
    if c == 40 {
        var j: i64 = i + 1;
        var d: i64 = 1;
        while j < n {
            var ch: i64 = str_byte_at(re, j);
            if ch == 92 { j = j + 2; continue; }
            if ch == 91 {
                j = rv_class_end(re, j + 1, n);
                if j < 0 { return -1; }
                continue;
            }
            if ch == 40 { d = d + 1; }
            if ch == 41 {
                d = d - 1;
                if d == 0 { return j + 1; }
            }
            j = j + 1;
        }
        return -1;
    }
    if c == 91 { return rv_class_end(re, i + 1, n); }
    if c == 92 {
        if i + 1 < n { return i + 2; }
        return -1;
    }
    if c == 41 || c == 124 || c == 42 || c == 43 || c == 63 { return -1; }
    return i + 1;
}

/// Positions of the '|' at the top level of re[i..end)
fn rv_bars(re: str, i: i64, end: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var j: i64 = i;
    var d: i64 = 0;
    while j < end {
        var c: i64 = str_byte_at(re, j);
        if c == 92 { j = j + 2; continue; }
        if c == 91 {
            var k: i64 = rv_class_end(re, j + 1, end);
            if k < 0 { return out; }
            j = k;
            continue;
        }
        if c == 40 { d = d + 1; }
        if c == 41 { d = d - 1; }
        if c == 124 && d == 0 { out.push(j); }
        j = j + 1;
    }
    return out;
}

/// Code for the single atom re[j..aj)
fn rv_atom(re: str, j: i64, aj: i64, p: &mut Vec<i64>, cls: &mut Vec<i64>, depth: i64) -> bool {
    if depth > 200 { return false; }
    var c: i64 = str_byte_at(re, j);
    if c == 40 { return rv_alt(re, j + 1, aj - 1, p, cls, depth + 1); }
    if c == 91 {
        var off: i64 = rx_new_cls(cls);
        if rx_parse_class(re, j + 1, cls, off) < 0 { return false; }
        rv_emit(p, RV_CLASS, off, 0);
        return true;
    }
    if c == 46 { rv_emit(p, RV_ANY, 0, 0); return true; }
    if c == 94 { rv_emit(p, RV_BOL, 0, 0); return true; }
    if c == 36 { rv_emit(p, RV_EOL, 0, 0); return true; }
    if c == 92 {
        var e: i64 = str_byte_at(re, j + 1);
        var named: i64 = rx_escape_cls(e);
        if named >= 0 {
            var off2: i64 = rx_new_cls(cls);
            rx_cls_apply_named(cls, off2, named);
            rv_emit(p, RV_CLASS, off2, 0);
        } else {
            rv_emit(p, RV_CHAR, rx_escape_lit(e) & 255, 0);
        }
        return true;
    }
    rv_emit(p, RV_CHAR, c & 255, 0);
    return true;
}

/// Code for the sequence re[i..end): atoms and their quantifiers
fn rv_seq(re: str, i: i64, end: i64, p: &mut Vec<i64>, cls: &mut Vec<i64>, depth: i64) -> bool {
    var j: i64 = i;
    var b3: Vec<i64> = Vec::new();
    while j < end {
        var aj: i64 = rv_atom_end(re, j, end);
        if aj < 0 { return false; }
        var q: i64 = aj;
        var mn: i64 = 1;
        var mx: i64 = 1;
        if aj < end {
            var qc: i64 = str_byte_at(re, aj);
            if qc == 42 { mn = 0; mx = -1; q = aj + 1; }
            else if qc == 43 { mn = 1; mx = -1; q = aj + 1; }
            else if qc == 63 { mn = 0; mx = 1; q = aj + 1; }
            else if qc == 123 {
                b3.clear();
                if rx_parse_brace(re, aj + 1, &mut b3) && b3.get(2) <= end {
                    mn = b3.get(0);
                    mx = b3.get(1);
                    q = b3.get(2);
                }
            }
        }
        if mn > RV_MAX_REPEAT || mx > RV_MAX_REPEAT || (mx >= 0 && mx < mn) { return false; }
        var k: i64 = 0;
        while k < mn {
            if !rv_atom(re, j, aj, p, cls, depth) { return false; }
            k = k + 1;
        }
        if mx < 0 {
            // x*: L: split(body, out); body; jmp L
            var l0: i64 = rv_emit(p, RV_SPLIT, 0, 0);
            rv_set_x(p, l0, l0 + 1);
            if !rv_atom(re, j, aj, p, cls, depth) { return false; }
            rv_emit(p, RV_JMP, l0, 0);
            rv_set_y(p, l0, rv_pc(p));
        } else {
            k = mn;
            while k < mx {
                // x?: split(body, out); body
                var l1: i64 = rv_emit(p, RV_SPLIT, 0, 0);
                rv_set_x(p, l1, l1 + 1);
                if !rv_atom(re, j, aj, p, cls, depth) { return false; }
                rv_set_y(p, l1, rv_pc(p));
                k = k + 1;
            }
        }
        j = q;
    }
    return true;
}

/// Code for alternatives re[i..end) separated by '|'
fn rv_alt(re: str, i: i64, end: i64, p: &mut Vec<i64>, cls: &mut Vec<i64>, depth: i64) -> bool {
    var bars: Vec<i64> = rv_bars(re, i, end);
    if bars.len() == 0 { return rv_seq(re, i, end, p, cls, depth); }
    var jumps: Vec<i64> = Vec::new();
    var s0: i64 = i;
    var k: i64 = 0;
    while k < bars.len() {
        var sp: i64 = rv_emit(p, RV_SPLIT, 0, 0);
        rv_set_x(p, sp, sp + 1);
        if !rv_seq(re, s0, bars.get(k), p, cls, depth) { return false; }
        jumps.push(rv_emit(p, RV_JMP, 0, 0));
        rv_set_y(p, sp, rv_pc(p));
        s0 = bars.get(k) + 1;
        k = k + 1;
    }
    if !rv_seq(re, s0, end, p, cls, depth) { return false; }
    k = 0;
    while k < jumps.len() {
        rv_set_x(p, jumps.get(k), rv_pc(p));
        k = k + 1;
    }
    return true;
}

pub fn regex_compile(re: str) -> Regex {
    var r: Regex = Regex { toks: Vec::new(), cls: Vec::new(), progs: Vec::new(), ok: false };
    var n: i64 = str_len(re);
    var bars: Vec<i64> = rv_bars(re, 0, n);
    var s0: i64 = 0;
    var k: i64 = 0;
    while k <= bars.len() {
        var e: i64 = n;
        if k < bars.len() { e = bars.get(k); }
        r.progs.push(rv_pc(&r.toks));
        if !rv_seq(re, s0, e, &mut r.toks, &mut r.cls, 0) { return r; }
        rv_emit(&mut r.toks, RV_MATCH, 0, 0);
        s0 = e + 1;
        k = k + 1;
    }
    r.ok = true;
    return r;
}

/// Add the thread (pc, st) and what it reaches without reading (jumps,
/// splits, anchors that hold at `pos`) to the list, once per instruction.
fn rv_add(r: &Regex, pcs: &mut Vec<i64>, sts: &mut Vec<i64>, mark: &mut Vec<i64>, gen: i64, pc0: i64, st: i64, pos: i64, n: i64, stack: &mut Vec<i64>) {
    stack.clear();
    stack.push(pc0);
    while stack.len() > 0 {
        var pc: i64 = stack.pop();
        if mark.get(pc) == gen { continue; }
        mark.set(pc, gen);
        var op: i64 = r.toks.get(pc * 3);
        if op == RV_JMP {
            stack.push(r.toks.get(pc * 3 + 1));
        } else if op == RV_SPLIT {
            // x first: push y below it
            stack.push(r.toks.get(pc * 3 + 2));
            stack.push(r.toks.get(pc * 3 + 1));
        } else if op == RV_BOL {
            if pos == 0 { stack.push(pc + 1); }
        } else if op == RV_EOL {
            if pos == n { stack.push(pc + 1); }
        } else {
            pcs.push(pc);
            sts.push(st);
        }
    }
}

/// The leftmost-longest match of the program at `entry` in s, starting at
/// `from` (only there when `anchored`; ending only at the end when
/// `whole`): [start, end], or [-1, -1].
fn rv_run(r: &Regex, entry: i64, s: str, from: i64, anchored: bool, whole: bool) -> Vec<i64> {
    var n: i64 = str_len(s);
    var ninst: i64 = r.toks.len() / 3;
    var mark: Vec<i64> = Vec::new();
    while mark.len() < ninst { mark.push(-1); }
    var cp: Vec<i64> = Vec::new();
    var cs: Vec<i64> = Vec::new();
    var np: Vec<i64> = Vec::new();
    var ns: Vec<i64> = Vec::new();
    var stack: Vec<i64> = Vec::new();
    var gen: i64 = 0;
    var best_s: i64 = -1;
    var best_e: i64 = -1;
    rv_add(r, &mut cp, &mut cs, &mut mark, gen, entry, from, from, n, &mut stack);
    var i: i64 = from;
    while true {
        gen = gen + 1;
        np.clear();
        ns.clear();
        var c: i64 = -1;
        if i < n { c = str_byte_at(s, i); }
        var t: i64 = 0;
        while t < cp.len() {
            var pc: i64 = cp.get(t);
            var st: i64 = cs.get(t);
            t = t + 1;
            if best_s >= 0 && st > best_s { continue; }
            var op: i64 = r.toks.get(pc * 3);
            if op == RV_MATCH {
                if whole && i != n { continue; }
                if best_s < 0 || st < best_s || (st == best_s && i > best_e) {
                    best_s = st;
                    best_e = i;
                }
                continue;
            }
            if c < 0 { continue; }
            var ok: bool = false;
            if op == RV_CHAR { ok = c == r.toks.get(pc * 3 + 1); }
            else if op == RV_ANY { ok = c != 10; }
            else if op == RV_CLASS { ok = rx_cls_get(r.cls, r.toks.get(pc * 3 + 1), c & 255); }
            if ok { rv_add(r, &mut np, &mut ns, &mut mark, gen, pc + 1, st, i + 1, n, &mut stack); }
        }
        if i >= n { break; }
        i = i + 1;
        // a new start here, last in priority, while nothing has matched
        if !anchored && best_s < 0 { rv_add(r, &mut np, &mut ns, &mut mark, gen, entry, i, i, n, &mut stack); }
        if np.len() == 0 { break; }
        var tp: Vec<i64> = cp;
        cp = np;
        np = tp;
        var ts: Vec<i64> = cs;
        cs = ns;
        ns = ts;
    }
    var out: Vec<i64> = Vec::new();
    out.push(best_s);
    out.push(best_e);
    return out;
}

/// The first match at or after `from`, the earliest start winning and, at
/// one start, the first alternative: [start, end] or [-1, -1].
fn rv_find(r: &Regex, s: str, from: i64) -> Vec<i64> {
    var bs: i64 = -1;
    var be: i64 = -1;
    var a: i64 = 0;
    while a < r.progs.len() {
        var m: Vec<i64> = rv_run(r, r.progs.get(a), s, from, false, false);
        if m.get(0) >= 0 && (bs < 0 || m.get(0) < bs) {
            bs = m.get(0);
            be = m.get(1);
        }
        a = a + 1;
    }
    var out: Vec<i64> = Vec::new();
    out.push(bs);
    out.push(be);
    return out;
}

/// True when `s` fully matches `re` (anchors implied at both ends).
pub fn regex_match(s: str, re: str) -> bool {
    var r: Regex = regex_compile(re);
    if !r.ok { return false; }
    var a: i64 = 0;
    while a < r.progs.len() {
        var m: Vec<i64> = rv_run(&r, r.progs.get(a), s, 0, true, true);
        if m.get(0) >= 0 { return true; }
        a = a + 1;
    }
    return false;
}

/// True when `re` matches anywhere inside `s`.
pub fn regex_search(s: str, re: str) -> bool {
    return regex_find_re(s, re) >= 0;
}

/// First position where `re` matches inside `s`, or -1.
pub fn regex_find_re(s: str, re: str) -> i64 {
    var r: Regex = regex_compile(re);
    if !r.ok { return -1; }
    return rv_find(&r, s, 0).get(0);
}

/// First match position and end, packed [start, end] in a Vec; [-1,-1] if none.
pub fn regex_find_span(s: str, re: str) -> Vec<i64> {
    var r: Regex = regex_compile(re);
    if !r.ok {
        var bad: Vec<i64> = Vec::new();
        bad.push(-1);
        bad.push(-1);
        return bad;
    }
    return rv_find(&r, s, 0);
}

/// Replace every match of `re` in `s` with `rep` (literal text).
pub fn regex_replace(s: str, re: str, rep: str) -> str {
    var r: Regex = regex_compile(re);
    if !r.ok { return s; }
    var out: str = "";
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i <= n {
        var m: Vec<i64> = rv_find(&r, s, i);
        var found: i64 = m.get(0);
        var fend: i64 = m.get(1);
        if found < 0 {
            out = out + str_slice(s, i, n);
            return out;
        }
        out = out + str_slice(s, i, found) + rep;
        if fend == found {
            // zero-width match: consume one char to keep moving
            if found < n {
                out = out + str_slice(s, found, found + 1);
            }
            i = found + 1;
        } else {
            i = fend;
        }
    }
    return out;
}

/// Split `s` at every match of `re`; returns pieces (not the separators).
pub fn regex_split(s: str, re: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var r: Regex = regex_compile(re);
    if !r.ok {
        out.push(s);
        return out;
    }
    var i: i64 = 0;
    var n: i64 = str_len(s);
    while i <= n {
        var m: Vec<i64> = rv_find(&r, s, i);
        var found: i64 = m.get(0);
        var fend: i64 = m.get(1);
        if found < 0 {
            out.push(str_slice(s, i, n));
            return out;
        }
        out.push(str_slice(s, i, found));
        if fend == found {
            i = found + 1;
        } else {
            i = fend;
        }
    }
    return out;
}

// ─── Literal-string helpers (unchanged from before) ─────────────────────

/// Find the first occurrence of a literal substring in a string.
/// Returns the starting index, or -1 if not found.
pub fn regex_find(s: str, sub: str) -> i64 {
    return str_find(s, sub);
}

/// Check if a string contains a substring.
pub fn regex_contains(s: str, sub: str) -> bool {
    return str_contains(s, sub);
}

/// Check if a string starts with a prefix.
pub fn regex_starts_with(s: str, prefix: str) -> bool {
    return str_starts_with(s, prefix);
}

/// Check if a string ends with a suffix.
pub fn regex_ends_with(s: str, suffix: str) -> bool {
    return str_ends_with(s, suffix);
}

/// Get the length of a string.
pub fn regex_len(s: str) -> i64 {
    return str_len(s);
}
