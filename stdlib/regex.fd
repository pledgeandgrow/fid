// Fides Regular Expression standard library (basic)
//
// Provides simple pattern matching on strings.
// Uses built-in string functions for find/contains/starts_with/ends_with.
// For pattern matching, uses p_regex_match builtin (simple wildcard matching).
//
// Usage:
//   use regex;
//   pv m = regex_matches("hello", "h?llo");    // true
//   pv f = regex_find("hello world", "wor");   // 6

module regex;

/// Check if a string matches a simple wildcard pattern.
/// Supports: ? (single char), * (zero or more chars)
pub pf regex_matches(s: str, pattern: str) -> bool {
    ret p_regex_match(s, pattern);
}

/// Find the first occurrence of a literal substring in a string.
/// Returns the starting index, or -1 if not found.
pub pf regex_find(s: str, sub: str) -> i64 {
    ret p_string_find(s, sub);
}

/// Check if a string contains a substring.
pub pf regex_contains(s: str, sub: str) -> bool {
    ret p_string_contains(s, sub);
}

/// Check if a string starts with a prefix.
pub pf regex_starts_with(s: str, prefix: str) -> bool {
    ret p_string_starts_with(s, prefix);
}

/// Check if a string ends with a suffix.
pub pf regex_ends_with(s: str, suffix: str) -> bool {
    ret p_string_ends_with(s, suffix);
}

/// Get the length of a string.
pub pf regex_len(s: str) -> i64 {
    ret p_string_len(s);
}
