// Fides byte-stream framing: COBS and SLIP, pure Fides.
//
//   - COBS, Consistent Overhead Byte Stuffing (Cheshire and Baker, IEEE/ACM
//     Transactions on Networking, 1999): the encoded data contains no zero
//     byte, so 0x00 can delimit frames; overhead is at most one byte per
//     254. cobs_encode / cobs_decode work on one frame without the
//     delimiter; cobs_frame adds it.
//   - SLIP (RFC 1055): END 0xC0 ends a frame, ESC 0xDB escapes: 0xC0 is
//     sent as DB DC and 0xDB as DB DD. slip_encode puts END before and
//     after the frame (the RFC's advice to flush line noise).
//   - Streaming decoders for both (CobsStream, SlipStream): feed bytes as
//     they arrive from a UART; complete frames come out; a malformed frame
//     (a bad COBS code, a SLIP escape followed by anything but DC/DD) or
//     one longer than the limit is dropped and counted, and decoding
//     resynchronises at the next delimiter. Empty frames (two delimiters
//     in a row) are skipped.
// Bytes are Vec<i64> values 0..255. No platform seam: this is the pure
// part of a serial protocol stack.

module framing;
use vec;

// ─── COBS ───────────────────────────────────────────────────────────────

pub fn cobs_encode(data: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var code_at: i64 = 0;
    out.push(0);
    var code: i64 = 1;
    var i: i64 = 0;
    while i < data.len() {
        val b: i64 = data.get(i) & 0xFF;
        if b == 0 {
            out.set(code_at, code);
            code_at = out.len();
            out.push(0);
            code = 1;
        } else {
            out.push(b);
            code = code + 1;
            // A full block (254 data bytes) closes; a new one starts only
            // when more data follows (so 254 bytes encode as FF + data).
            if code == 0xFF && i + 1 < data.len() {
                out.set(code_at, code);
                code_at = out.len();
                out.push(0);
                code = 1;
            }
        }
        i = i + 1;
    }
    out.set(code_at, code);
    return out;
}

pub struct CobsResult {
    pub ok: bool,
    pub data: Vec<i64>,
    pub error: str,
}

/// Decode one COBS frame (without the 0x00 delimiter).
pub fn cobs_decode(enc: Vec<i64>) -> CobsResult {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    val n: i64 = enc.len();
    while i < n {
        val code: i64 = enc.get(i);
        if code == 0 {
            return CobsResult {
                ok: false, data: out, error: "zero byte inside a COBS frame"
            };
        }
        if i + code > n {
            return CobsResult {
                ok: false, data: out, error: "COBS code runs past the end"
            };
        }
        var k: i64 = 1;
        while k < code {
            val b: i64 = enc.get(i + k);
            if b == 0 {
                return CobsResult {
                    ok: false, data: out, error: "zero byte inside a COBS frame"
                };
            }
            out.push(b);
            k = k + 1;
        }
        i = i + code;
        if code != 0xFF && i < n {
            out.push(0);
        }
    }
    return CobsResult {
        ok: true, data: out, error: ""
    };
}

/// Encoded frame plus the 0x00 delimiter.
pub fn cobs_frame(data: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = cobs_encode(data);
    out.push(0);
    return out;
}

/// Largest encoded size of `n` data bytes (without the delimiter).
pub fn cobs_max_encoded(n: i64) -> i64 {
    return n + n / 254 + 1;
}

// ─── SLIP ───────────────────────────────────────────────────────────────

pub const SLIP_END: i64 = 0xC0;
pub const SLIP_ESC: i64 = 0xDB;
pub const SLIP_ESC_END: i64 = 0xDC;
pub const SLIP_ESC_ESC: i64 = 0xDD;

pub fn slip_encode(data: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(SLIP_END);
    var i: i64 = 0;
    while i < data.len() {
        val b: i64 = data.get(i) & 0xFF;
        if b == SLIP_END {
            out.push(SLIP_ESC);
            out.push(SLIP_ESC_END);
        } else if b == SLIP_ESC {
            out.push(SLIP_ESC);
            out.push(SLIP_ESC_ESC);
        } else {
            out.push(b);
        }
        i = i + 1;
    }
    out.push(SLIP_END);
    return out;
}

/// Decode the bytes of one SLIP frame (END bytes ignored).
pub fn slip_decode(enc: Vec<i64>) -> CobsResult {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < enc.len() {
        val b: i64 = enc.get(i);
        if b == SLIP_ESC {
            if i + 1 >= enc.len() {
                return CobsResult {
                    ok: false, data: out, error: "SLIP escape at the end"
                };
            }
            val c: i64 = enc.get(i + 1);
            if c == SLIP_ESC_END {
                out.push(SLIP_END);
            } else if c == SLIP_ESC_ESC {
                out.push(SLIP_ESC);
            } else {
                return CobsResult {
                    ok: false, data: out, error: "bad SLIP escape"
                };
            }
            i = i + 2;
        } else {
            if b != SLIP_END {
                out.push(b);
            }
            i = i + 1;
        }
    }
    return CobsResult {
        ok: true, data: out, error: ""
    };
}

// ─── Streaming decoders ─────────────────────────────────────────────────

pub struct CobsStream {
    pub buf: Vec<i64>,
    pub max: i64,
    pub overflow: bool,
    pub frames: Vec<Vec<i64>>,
    pub errors: i64,
    pub last_error: str,
}

pub fn cobs_stream_new(max_frame: i64) -> CobsStream {
    return CobsStream {
        buf: Vec::new(), max: max_frame, overflow: false, frames: Vec::new(), errors: 0, last_error: ""
    };
}

/// Feed one byte; true when it completed a frame (in s.frames).
pub fn cobs_stream_feed(s: &mut CobsStream, b: i64) -> bool {
    if b != 0 {
        if s.buf.len() >= cobs_max_encoded(s.max) {
            s.overflow = true;
        } else {
            s.buf.push(b & 0xFF);
        }
        return false;
    }
    var done: bool = false;
    if s.overflow {
        s.errors = s.errors + 1;
        s.last_error = "frame longer than " + int_to_str(s.max);
    } else if s.buf.len() > 0 {
        val r: CobsResult = cobs_decode(s.buf);
        if r.ok && r.data.len() <= s.max {
            s.frames.push(r.data);
            done = true;
        } else {
            s.errors = s.errors + 1;
            if r.ok {
                s.last_error = "frame longer than " + int_to_str(s.max);
            } else {
                s.last_error = r.error;
            }
        }
    }
    s.buf.clear();
    s.overflow = false;
    return done;
}

/// Feed many bytes; the number of frames completed.
pub fn cobs_stream_feed_all(s: &mut CobsStream, bytes: Vec<i64>) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < bytes.len() {
        if cobs_stream_feed(s, bytes.get(i)) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

pub struct SlipStream {
    pub buf: Vec<i64>,
    pub max: i64,
    pub esc: bool,
    pub bad: bool,
    pub frames: Vec<Vec<i64>>,
    pub errors: i64,
    pub last_error: str,
}

pub fn slip_stream_new(max_frame: i64) -> SlipStream {
    return SlipStream {
        buf: Vec::new(), max: max_frame, esc: false, bad: false, frames: Vec::new(), errors: 0, last_error: ""
    };
}

/// Feed one byte (decoding as it goes); true when a frame completed.
pub fn slip_stream_feed(s: &mut SlipStream, b0: i64) -> bool {
    val b: i64 = b0 & 0xFF;
    if b == SLIP_END {
        var done: bool = false;
        if s.esc && !s.bad {
            s.bad = true;
            s.last_error = "SLIP escape before END";
        }
        if s.bad {
            s.errors = s.errors + 1;
        } else if s.buf.len() > 0 {
            s.frames.push(s.buf.clone());
            done = true;
        }
        s.buf.clear();
        s.esc = false;
        s.bad = false;
        return done;
    }
    if s.bad {
        return false;
    }
    var v: i64 = b;
    if s.esc {
        s.esc = false;
        if b == SLIP_ESC_END {
            v = SLIP_END;
        } else if b == SLIP_ESC_ESC {
            v = SLIP_ESC;
        } else {
            s.bad = true;
            s.last_error = "bad SLIP escape";
            return false;
        }
    } else if b == SLIP_ESC {
        s.esc = true;
        return false;
    }
    if s.buf.len() >= s.max {
        s.bad = true;
        s.last_error = "frame longer than " + int_to_str(s.max);
        return false;
    }
    s.buf.push(v);
    return false;
}

pub fn slip_stream_feed_all(s: &mut SlipStream, bytes: Vec<i64>) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < bytes.len() {
        if slip_stream_feed(s, bytes.get(i)) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}
