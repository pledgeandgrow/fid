// stdlib/linux_runtime/win.fd — the Linux runtime on Windows x64
//
// `fid emit --nat` on Windows (compiler/nat_ir.fd, nat_generate_pe): the
// x86-64 code of the machine layer in a PE, with the Linux runtime of this
// directory unchanged. Its system calls (nat_syscall) come here, to
// pe_win_syscall, which does each with kernel32, ws2_32 or bcrypt through
// nat_win_call(k, ...): k is the import's index in ng_win_imports (the
// PE_W_* constants below, in the same order). Merged only for this target.
//
// File descriptors: 0, 1, 2 are the standard handles; a file is its
// HANDLE; a socket is its SOCKET plus PE_WTAG_SOCK; an open directory is
// its listing state plus PE_WTAG_DIR. Errors are -errno as on Linux.
// Threads are Windows threads (their own stacks); signals are a vectored
// exception handler (pe_win_on_exception); futexes are WaitOnAddress.

extern "C" {
    fn nat_win_call(k: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64, j: i64) -> i64;
    fn nat_win_tramp() -> i64;
    fn nat_os() -> i64;
}

// The imports (compiler/nat_ir.fd ng_win_imports): keep the same order
const PE_W_EXIT_PROCESS: i64 = 0;
const PE_W_GET_STD_HANDLE: i64 = 1;
const PE_W_WRITE_FILE: i64 = 2;
const PE_W_READ_FILE: i64 = 3;
const PE_W_CREATE_FILE: i64 = 4;
const PE_W_CLOSE_HANDLE: i64 = 5;
const PE_W_SET_FILE_POINTER: i64 = 6;
const PE_W_DELETE_FILE: i64 = 7;
const PE_W_REMOVE_DIRECTORY: i64 = 8;
const PE_W_CREATE_DIRECTORY: i64 = 9;
const PE_W_MOVE_FILE: i64 = 10;
const PE_W_FILE_ATTRIBUTES: i64 = 11;
const PE_W_FIND_FIRST: i64 = 12;
const PE_W_FIND_NEXT: i64 = 13;
const PE_W_FIND_CLOSE: i64 = 14;
const PE_W_VIRTUAL_ALLOC: i64 = 15;
const PE_W_VIRTUAL_FREE: i64 = 16;
const PE_W_VIRTUAL_PROTECT: i64 = 17;
const PE_W_SYSTEM_TIME: i64 = 18;
const PE_W_QPC: i64 = 19;
const PE_W_QPF: i64 = 20;
const PE_W_SLEEP: i64 = 21;
const PE_W_SWITCH_TO_THREAD: i64 = 22;
const PE_W_PROCESS_ID: i64 = 23;
const PE_W_THREAD_ID: i64 = 24;
const PE_W_CREATE_THREAD: i64 = 25;
const PE_W_EXIT_THREAD: i64 = 26;
const PE_W_TLS_ALLOC: i64 = 27;
const PE_W_ADD_VEH: i64 = 28;
const PE_W_STACK_GUARANTEE: i64 = 29;
const PE_W_COMMAND_LINE: i64 = 30;
const PE_W_ENVIRONMENT: i64 = 31;
const PE_W_SYSTEM_INFO: i64 = 32;
const PE_W_MEMORY_STATUS: i64 = 33;
const PE_W_CREATE_PROCESS: i64 = 34;
const PE_W_WAIT_OBJECT: i64 = 35;
const PE_W_EXIT_CODE: i64 = 36;
const PE_W_LAST_ERROR: i64 = 37;
const PE_W_CURRENT_PROCESS: i64 = 38;
const PE_W_TERMINATE_PROCESS: i64 = 39;
const PE_W_CONSOLE_OUTPUT_CP: i64 = 40;
const PE_W_FILE_TYPE: i64 = 41;
const PE_W_PEEK_PIPE: i64 = 42;
const PE_W_FILE_SIZE: i64 = 43;
const PE_W_WAIT_ON_ADDRESS: i64 = 44;
const PE_W_WAKE_ONE: i64 = 45;
const PE_W_WAKE_ALL: i64 = 46;
const PE_W_GEN_RANDOM: i64 = 47;
const PE_W_WSA_STARTUP: i64 = 48;
const PE_W_SOCKET: i64 = 49;
const PE_W_BIND: i64 = 50;
const PE_W_LISTEN: i64 = 51;
const PE_W_ACCEPT: i64 = 52;
const PE_W_CONNECT: i64 = 53;
const PE_W_SEND: i64 = 54;
const PE_W_RECV: i64 = 55;
const PE_W_CLOSE_SOCKET: i64 = 56;
const PE_W_SETSOCKOPT: i64 = 57;
const PE_W_GETSOCKOPT: i64 = 58;
const PE_W_IOCTL_SOCKET: i64 = 59;
const PE_W_POLL: i64 = 60;
const PE_W_WSA_ERROR: i64 = 61;
const PE_W_GETHOSTBYNAME: i64 = 62;
// epoll over AFD and an I/O completion port (competitive RT11, below)
const PE_W_CREATE_IOCP: i64 = 63;           // kernel32 CreateIoCompletionPort
const PE_W_GQCS_EX: i64 = 64;               // kernel32 GetQueuedCompletionStatusEx
const PE_W_PQCS: i64 = 65;                  // kernel32 PostQueuedCompletionStatus
const PE_W_NT_IOCTL: i64 = 66;              // ntdll NtDeviceIoControlFile
const PE_W_NT_CANCEL: i64 = 67;             // ntdll NtCancelIoFileEx
const PE_W_WSA_IOCTL: i64 = 68;             // ws2_32 WSAIoctl

const PE_WTAG_SOCK: i64 = 281474976710656;    // 1 << 48
const PE_WTAG_DIR: i64 = 562949953421312;     // 2 << 48
const PE_WTAG_MASK: i64 = 0 - 281474976710656;
const PE_WTAG_EVT: i64 = 844424930131968;     // 3 << 48: the eventfd
const PE_WTAG_EP: i64 = 1125899906842624;     // 4 << 48: the epoll instance

// Pseudo system calls of this layer (the runtime makes them only when
// nat_os() == 1)
const PE_WSYS_SHELL: i64 = 1000;
const PE_WSYS_RESOLVE: i64 = 1001;

var pe_win_veh_on: bool = false;
var pe_win_wsa_on: bool = false;
var pe_win_info: i64 = 0;       // the siginfo handed to pe_on_signal
var pe_win_top: i64 = 0;        // the start block (nat_start_sp)

fn pe_w(k: i64, a: i64, b: i64, c: i64, d: i64) -> i64 {
    return nat_win_call(k, a, b, c, d, 0, 0, 0, 0, 0, 0);
}

/// A BOOL / int / DWORD result: its low 32 bits, sign-extended.
fn pe_w32(r: i64) -> i64 {
    return (r << 32) >> 32;
}

fn pe_win_ld32(addr: i64) -> i64 {
    return pe_ld(addr) & 4294967295;
}

fn pe_win_st32(addr: i64, v: i64) {
    var i: i64 = 0;
    while i < 4 {
        pe_stb(addr + i, (v >> (i * 8)) & 255);
        i = i + 1;
    }
}

fn pe_win_st16(addr: i64, v: i64) {
    pe_stb(addr, v & 255);
    pe_stb(addr + 1, (v >> 8) & 255);
}

/// The last Windows error as -errno.
fn pe_win_errno() -> i64 {
    var e: i64 = pe_w(PE_W_LAST_ERROR, 0, 0, 0, 0) & 4294967295;
    if e == 2 || e == 3 || e == 123 || e == 161 { return 0 - 2; }       // ENOENT
    if e == 5 || e == 32 || e == 33 { return 0 - 13; }                  // EACCES
    if e == 80 || e == 183 { return 0 - 17; }                           // EEXIST
    if e == 145 { return 0 - 39; }                                      // ENOTEMPTY
    if e == 8 || e == 14 { return 0 - 12; }                             // ENOMEM
    if e == 6 { return 0 - 9; }                                         // EBADF
    return 0 - 5;                                                       // EIO
}

/// The HANDLE of a file descriptor.
fn pe_win_handle(fd: i64) -> i64 {
    if fd == 0 { return pe_w(PE_W_GET_STD_HANDLE, 0 - 10, 0, 0, 0); }
    if fd == 1 { return pe_w(PE_W_GET_STD_HANDLE, 0 - 11, 0, 0, 0); }
    if fd == 2 { return pe_w(PE_W_GET_STD_HANDLE, 0 - 12, 0, 0, 0); }
    return fd;
}

fn pe_win_is_sock(fd: i64) -> bool { return fd > 2 && (fd & PE_WTAG_MASK) == PE_WTAG_SOCK; }
fn pe_win_is_dir(fd: i64) -> bool { return fd > 2 && (fd & PE_WTAG_MASK) == PE_WTAG_DIR; }

// ─── Start ──────────────────────────────────────────────────────────────

/// One argument of the command line from `at` (Windows' rules: blanks
/// separate; quotes group; 2n backslashes before a quote are n, 2n + 1
/// are n and a literal quote). [the new string, the position after it].
fn pe_win_arg(cmd: i64, at: i64, out: i64) -> i64 {
    var buf: i64 = pert_malloc(pe_len(cmd) + 1);
    var n: i64 = 0;
    var i: i64 = at;
    var quoted: bool = false;
    while pe_ldb(cmd + i) != 0 {
        var c: i64 = pe_ldb(cmd + i);
        if (c == 32 || c == 9) && !quoted { break; }
        if c == 92 {
            var bs: i64 = 0;
            while pe_ldb(cmd + i) == 92 { bs = bs + 1; i = i + 1; }
            if pe_ldb(cmd + i) == 34 {
                var k: i64 = 0;
                while k < bs / 2 { pe_stb(buf + n, 92); n = n + 1; k = k + 1; }
                if (bs % 2) == 1 {
                    pe_stb(buf + n, 34);
                    n = n + 1;
                    i = i + 1;
                }
            } else {
                var k2: i64 = 0;
                while k2 < bs { pe_stb(buf + n, 92); n = n + 1; k2 = k2 + 1; }
            }
        } else if c == 34 {
            if quoted && pe_ldb(cmd + i + 1) == 34 {
                pe_stb(buf + n, 34);
                n = n + 1;
                i = i + 2;
            } else {
                quoted = !quoted;
                i = i + 1;
            }
        } else {
            pe_stb(buf + n, c);
            n = n + 1;
            i = i + 1;
        }
    }
    pe_st(out, pe_dup_range(buf, 0, n));
    pert_free(buf);
    return i;
}

/// The start block the Linux runtime reads at nat_start_sp: argc, argv,
/// 0, envp, 0, 0 — from GetCommandLineA and GetEnvironmentStringsA. Placed
/// high in the address space: the runtime takes the 64 MB below it for the
/// main thread's stack (its overflow test), and nothing else is there.
pub fn pe_win_start() -> i64 {
    pe_w(PE_W_CONSOLE_OUTPUT_CP, 65001, 0, 0, 0);
    var cmd: i64 = pe_w(PE_W_COMMAND_LINE, 0, 0, 0, 0);
    var args: Vec<i64> = Vec::new();
    var slot: i64 = pert_malloc(8);
    var i: i64 = 0;
    while cmd != 0 && pe_ldb(cmd + i) != 0 {
        var c: i64 = pe_ldb(cmd + i);
        if c == 32 || c == 9 {
            i = i + 1;
        } else {
            i = pe_win_arg(cmd, i, slot);
            args.push(pe_ld(slot));
        }
    }
    pert_free(slot);
    var envs: Vec<i64> = Vec::new();
    var env: i64 = pe_w(PE_W_ENVIRONMENT, 0, 0, 0, 0);
    if env != 0 {
        var at: i64 = env;
        while pe_ldb(at) != 0 {
            if pe_ldb(at) != 61 { envs.push(at); }       // not "=C:=C:\..."
            at = at + pe_len(at) + 1;
        }
    }
    var words: i64 = 1 + args.len() + 1 + envs.len() + 3;
    var size: i64 = (words * 8 + 65535) & (0 - 65536);
    // 0x600000000000 + 64 MB: above any heap, below the system DLLs
    var block: i64 = nat_win_call(PE_W_VIRTUAL_ALLOC, 105553116266496 + 67108864, size, 12288, 4, 0, 0, 0, 0, 0, 0);
    if block == 0 {
        block = nat_win_call(PE_W_VIRTUAL_ALLOC, 0, size, 12288, 4, 0, 0, 0, 0, 0, 0);
    }
    pe_st(block, args.len());
    var w: i64 = block + 8;
    var k: i64 = 0;
    while k < args.len() { pe_st(w, args.get(k)); w = w + 8; k = k + 1; }
    pe_st(w, 0);
    w = w + 8;
    k = 0;
    while k < envs.len() { pe_st(w, envs.get(k)); w = w + 8; k = k + 1; }
    pe_st(w, 0);
    pe_st(w + 8, 0);
    pe_st(w + 16, 0);
    pe_win_info = pert_malloc(128);
    pe_zero(pe_win_info, 128);
    pe_win_top = block;
    return block;
}

// ─── Threads ────────────────────────────────────────────────────────────

/// nat_clone_thread: entry(env 0, arg) on a new Windows thread with the
/// thread block tls; *ctid cleared (and woken) when it is done. The stack
/// the runtime made (stack_top) is not used: Windows threads have their
/// own, with the guard page Windows needs.
pub fn pe_win_clone(entry: i64, arg: i64, stack_top: i64, ctid: i64, tls: i64) -> i64 {
    var p: i64 = pert_malloc(32);
    pe_st(p, entry);
    pe_st(p + 8, arg);
    pe_st(p + 16, ctid);
    pe_st(p + 24, tls);
    var tid: i64 = pert_malloc(8);
    pe_st(tid, 0);
    // 8 MB reserved (STACK_SIZE_PARAM_IS_A_RESERVATION)
    var h: i64 = nat_win_call(PE_W_CREATE_THREAD, 0, 8388608, nat_win_tramp(), p, 65536, tid, 0, 0, 0, 0);
    var t: i64 = pe_ld(tid) & 4294967295;
    pert_free(tid);
    if h == 0 {
        pert_free(p);
        return 0 - 11;
    }
    pe_w(PE_W_CLOSE_HANDLE, h, 0, 0, 0);
    return t;
}

/// A thread's first function (nat_win_tramp): never returns.
pub fn pe_win_thread_main(p: i64) {
    var entry: i64 = pe_ld(p);
    var ctid: i64 = pe_ld(p + 16);
    nat_tls_set(pe_ld(p + 24));
    var argv: i64 = pert_malloc(64);
    pe_zero(argv, 64);
    pe_st(argv, pe_ld(p + 8));
    pert_free(p);
    nat_call_fn(entry, 1, argv);
    pert_free(argv);
    nat_atomic_store(ctid, 0);
    pe_w(PE_W_WAKE_ALL, ctid, 0, 0, 0);
    pe_w(PE_W_EXIT_THREAD, 0, 0, 0, 0);
}

// ─── Exceptions ─────────────────────────────────────────────────────────

/// The vectored exception handler (nat_sig_handler's code calls it with
/// the EXCEPTION_POINTERS): a fault becomes the Linux signal pe_on_signal
/// reports — an access violation SIGSEGV at its address, a stack overflow
/// SIGSEGV at an address the runtime takes for the guard of the stack in
/// use, an illegal instruction SIGILL, a breakpoint SIGTRAP, integer
/// division SIGFPE. Anything else goes on to the next handler (0).
pub fn pe_win_on_exception(ptrs: i64) -> i64 {
    var rec: i64 = pe_ld(ptrs);
    var code: i64 = pe_win_ld32(rec);
    var sig: i64 = 0;
    var addr: i64 = pe_ld(rec + 16);
    if code == 3221225477 || code == 2147483649 {          // ACCESS_VIOLATION, GUARD_PAGE
        sig = 11;
        if pe_win_ld32(rec + 24) >= 2 { addr = pe_ld(rec + 40); }
    } else if code == 3221225725 {                         // STACK_OVERFLOW
        sig = 11;
        addr = pe_win_top - 8;
        var t: i64 = nat_tls_get();
        if t != 0 {
            var cur: i64 = pe_ld(t);
            if cur != 0 && pe_ld(cur + 120) != 0 {
                addr = pe_ld(cur + 120);
            } else if pe_ld(t + 16) != 0 {
                addr = pe_ld(t + 16);
            }
        }
    } else if code == 3221225501 || code == 3221225622 {   // ILLEGAL_INSTRUCTION, PRIV_INSTRUCTION
        sig = 4;
    } else if code == 2147483651 {                         // BREAKPOINT
        sig = 5;
    } else if code == 3221225620 || code == 3221225621 {   // INT_DIVIDE_BY_ZERO, INT_OVERFLOW
        sig = 8;
    } else {
        return 0;
    }
    pe_st(pe_win_info + 16, addr);
    pe_on_signal(sig, pe_win_info);
    return 0 - 1;
}

// ─── Directories ────────────────────────────────────────────────────────
// A listing: [0] the FindFirstFile handle (0 before the first read), [8]
// done, [16] the pattern (dir\*), [24] an entry is waiting in the data,
// [32..352) WIN32_FIND_DATAA (cFileName at +44).

fn pe_win_open_dir(path: i64) -> i64 {
    var d: i64 = pert_malloc(352);
    pe_zero(d, 352);
    var n: i64 = pe_len(path);
    var pat: i64 = pe_new_str(n + 2);
    pe_copy(pat, path, n);
    pe_stb(pat + n, 92);
    pe_stb(pat + n + 1, 42);
    pe_st(d + 16, pat);
    return d | PE_WTAG_DIR;
}

fn pe_win_getdents(fd: i64, buf: i64, size: i64) -> i64 {
    var d: i64 = fd & (PE_WTAG_SOCK - 1);
    var data: i64 = d + 32;
    if pe_ld(d) == 0 && pe_ld(d + 8) == 0 {
        var h: i64 = pe_w(PE_W_FIND_FIRST, pe_ld(d + 16), data, 0, 0);
        if h == 0 - 1 {
            pe_st(d + 8, 1);
            return 0;
        }
        pe_st(d, h);
        pe_st(d + 24, 1);
    }
    var off: i64 = 0;
    while true {
        if pe_ld(d + 24) == 0 {
            if pe_ld(d + 8) != 0 { break; }
            if pe_w32(pe_w(PE_W_FIND_NEXT, pe_ld(d), data, 0, 0)) == 0 {
                pe_st(d + 8, 1);
                break;
            }
            pe_st(d + 24, 1);
        }
        var name: i64 = data + 44;
        var len: i64 = 0;
        while pe_ldb(name + len) != 0 { len = len + 1; }
        var reclen: i64 = (19 + len + 1 + 7) & (0 - 8);
        if off + reclen > size { break; }
        var r: i64 = buf + off;
        pe_zero(r, reclen);
        pe_st(r, 1);
        pe_win_st16(r + 16, reclen);
        if (pe_win_ld32(data) & 16) != 0 { pe_stb(r + 18, 4); } else { pe_stb(r + 18, 8); }
        pe_copy(r + 19, name, len);
        off = off + reclen;
        pe_st(d + 24, 0);
    }
    return off;
}

fn pe_win_close(fd: i64) -> i64 {
    if fd >= 0 && fd <= 2 { return 0; }
    if pe_win_is_sock(fd) {
        pe_w(PE_W_CLOSE_SOCKET, fd - PE_WTAG_SOCK, 0, 0, 0);
        return 0;
    }
    if pe_win_is_dir(fd) {
        var d: i64 = fd & (PE_WTAG_SOCK - 1);
        if pe_ld(d) != 0 { pe_w(PE_W_FIND_CLOSE, pe_ld(d), 0, 0, 0); }
        p_str_free(pe_ld(d + 16));
        pert_free(d);
        return 0;
    }
    if pe_w32(pe_w(PE_W_CLOSE_HANDLE, fd, 0, 0, 0)) == 0 { return 0 - 9; }
    return 0;
}

// ─── Files ──────────────────────────────────────────────────────────────

/// Linux paths the runtime names, on Windows.
fn pe_win_path(path: i64) -> i64 {
    if pert_str_equal(path, "/etc/hosts" as i64) { return "C:\\Windows\\System32\\drivers\\etc\\hosts" as i64; }
    if pert_str_equal(path, "/dev/null" as i64) { return "NUL" as i64; }
    return path;
}

/// GetFileAttributesExA: the WIN32_FILE_ATTRIBUTE_DATA (36 bytes) in data,
/// or false.
fn pe_win_attrs(path: i64, data: i64) -> bool {
    return pe_w32(pe_w(PE_W_FILE_ATTRIBUTES, path, 0, data, 0)) != 0;
}

fn pe_win_open(path0: i64, flags: i64) -> i64 {
    var path: i64 = pe_win_path(path0);
    var data: i64 = pert_malloc(40);
    var exists: bool = pe_win_attrs(path, data);
    var attr: i64 = pe_win_ld32(data);
    pert_free(data);
    if exists && (attr & 16) != 0 {
        return pe_win_open_dir(path);
    }
    var acc: i64 = 2147483648;                              // GENERIC_READ
    if (flags & 3) == 1 { acc = 1073741824; }               // GENERIC_WRITE
    if (flags & 3) == 2 { acc = 3221225472; }
    var creat: bool = (flags & 64) != 0;
    var trunc: bool = (flags & 512) != 0;
    var excl: bool = (flags & 128) != 0;
    var disp: i64 = 3;                                      // OPEN_EXISTING
    if creat && excl { disp = 1; }                          // CREATE_NEW
    else if creat && trunc { disp = 2; }                    // CREATE_ALWAYS
    else if creat { disp = 4; }                             // OPEN_ALWAYS
    else if trunc { disp = 5; }                             // TRUNCATE_EXISTING
    var h: i64 = nat_win_call(PE_W_CREATE_FILE, path, acc, 7, 0, disp, 128, 0, 0, 0, 0);
    if h == 0 - 1 { return pe_win_errno(); }
    if (flags & 1024) != 0 {                                // O_APPEND
        pe_w(PE_W_SET_FILE_POINTER, h, 0, 0, 2);
    }
    return h;
}

/// x86-64 Linux's struct stat from the attributes: st_mode at 24, st_size
/// at 48, st_mtime at 88 (nat_arch() is 3 here: the runtime reads that
/// layout).
fn pe_win_stat(path0: i64, st: i64) -> i64 {
    var path: i64 = pe_win_path(path0);
    var data: i64 = pert_malloc(40);
    if !pe_win_attrs(path, data) {
        pert_free(data);
        return pe_win_errno();
    }
    pe_zero(st, 144);
    var attr: i64 = pe_win_ld32(data);
    if (attr & 16) != 0 { pe_win_st32(st + 24, 16877); } else { pe_win_st32(st + 24, 33188); }
    pe_st(st + 16, 1);
    pe_st(st + 48, (pe_win_ld32(data + 28) << 32) | pe_win_ld32(data + 32));
    var ft: i64 = (pe_win_ld32(data + 24) << 32) | pe_win_ld32(data + 20);
    var t: i64 = ft - 116444736000000000;
    pe_st(st + 88, t / 10000000);
    pe_st(st + 96, (t % 10000000) * 100);
    pe_st(st + 72, pe_ld(st + 88));
    pe_st(st + 104, pe_ld(st + 88));
    pert_free(data);
    return 0;
}

fn pe_win_read(fd: i64, buf: i64, n: i64) -> i64 {
    if pe_win_is_sock(fd) { return pe_win_recv(fd, buf, n); }
    var h: i64 = pe_win_handle(fd);
    var got: i64 = pert_malloc(8);
    pe_st(got, 0);
    var ok: i64 = pe_w32(nat_win_call(PE_W_READ_FILE, h, buf, n, got, 0, 0, 0, 0, 0, 0));
    var r: i64 = pe_win_ld32(got);
    pert_free(got);
    if ok == 0 {
        var e: i64 = pe_w(PE_W_LAST_ERROR, 0, 0, 0, 0) & 4294967295;
        if e == 109 || e == 38 { return 0; }               // BROKEN_PIPE, HANDLE_EOF
        return 0 - 5;
    }
    // A console gives CR LF: the program sees LF, as on Linux
    if r > 0 && (pe_w(PE_W_FILE_TYPE, h, 0, 0, 0) & 4294967295) == 2 {
        var j: i64 = 0;
        var i: i64 = 0;
        while i < r {
            var c: i64 = pe_ldb(buf + i);
            if c != 13 { pe_stb(buf + j, c); j = j + 1; }
            i = i + 1;
        }
        r = j;
    }
    return r;
}

fn pe_win_write(fd: i64, buf: i64, n: i64) -> i64 {
    if pe_win_is_sock(fd) { return pe_win_send(fd, buf, n); }
    var w: i64 = pert_malloc(8);
    pe_st(w, 0);
    var ok: i64 = pe_w32(nat_win_call(PE_W_WRITE_FILE, pe_win_handle(fd), buf, n, w, 0, 0, 0, 0, 0, 0));
    var r: i64 = pe_win_ld32(w);
    pert_free(w);
    if ok == 0 { return 0 - 32; }
    return r;
}

fn pe_win_lseek(fd: i64, off: i64, whence: i64) -> i64 {
    var np: i64 = pert_malloc(8);
    pe_st(np, 0);
    var ok: i64 = pe_w32(pe_w(PE_W_SET_FILE_POINTER, pe_win_handle(fd), off, np, whence));
    var r: i64 = pe_ld(np);
    pert_free(np);
    if ok == 0 { return 0 - 29; }
    return r;
}

// ─── Sockets (ws2_32) ───────────────────────────────────────────────────

fn pe_win_wsa() {
    if pe_win_wsa_on { return; }
    pe_win_wsa_on = true;
    var data: i64 = pert_malloc(512);
    pe_w(PE_W_WSA_STARTUP, 514, data, 0, 0);
    pert_free(data);
}

/// The last socket error as -errno: would block is EAGAIN (connect turns
/// it into EINPROGRESS).
fn pe_win_sock_errno() -> i64 {
    var e: i64 = pe_w(PE_W_WSA_ERROR, 0, 0, 0, 0) & 4294967295;
    if e == 10035 { return 0 - 11; }                        // WSAEWOULDBLOCK
    if e == 10061 { return 0 - 111; }                       // ECONNREFUSED
    if e == 10048 { return 0 - 98; }                        // EADDRINUSE
    if e == 10054 { return 0 - 104; }                       // ECONNRESET
    return 0 - 5;
}

fn pe_win_sock(fd: i64) -> i64 { return fd - PE_WTAG_SOCK; }

fn pe_win_recv(fd: i64, buf: i64, n: i64) -> i64 {
    var r: i64 = pe_w32(pe_w(PE_W_RECV, pe_win_sock(fd), buf, n, 0));
    if r < 0 { return pe_win_sock_errno(); }
    return r;
}

fn pe_win_send(fd: i64, buf: i64, n: i64) -> i64 {
    var r: i64 = pe_w32(pe_w(PE_W_SEND, pe_win_sock(fd), buf, n, 0));
    if r < 0 { return pe_win_sock_errno(); }
    return r;
}

/// ppoll of one pollfd (fd as 32 bits, events, revents): the runtime polls
/// sockets only, so the fd is a SOCKET.
fn pe_win_poll(pfd: i64, ts: i64) -> i64 {
    var ms: i64 = 0 - 1;
    if ts != 0 { ms = pe_ld(ts) * 1000 + pe_ld(ts + 8) / 1000000; }
    var w: i64 = pert_malloc(16);
    pe_zero(w, 16);
    pe_st(w, pe_win_ld32(pfd));
    var ev: i64 = (pe_ld(pfd) >> 32) & 65535;
    var wev: i64 = 0;
    if (ev & 1) != 0 { wev = wev | 256; }                   // POLLRDNORM
    if (ev & 4) != 0 { wev = wev | 16; }                    // POLLWRNORM
    pe_win_st16(w + 8, wev);
    var r: i64 = pe_w32(pe_w(PE_W_POLL, w, 1, ms, 0));
    var rev: i64 = (pe_ld(w + 8) >> 16) & 65535;
    pert_free(w);
    if r < 0 { return pe_win_sock_errno(); }
    var lrev: i64 = 0;
    if (rev & 768) != 0 { lrev = lrev | 1; }
    if (rev & 16) != 0 { lrev = lrev | 4; }
    if (rev & 1) != 0 { lrev = lrev | 8; }
    if (rev & 2) != 0 { lrev = lrev | 16; }
    pe_win_st16(pfd + 6, lrev);
    return r;
}

fn pe_win_socket_call(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    pe_win_wsa();
    if n == 198 {                                            // socket
        var fam: i64 = a;
        if a == 10 { fam = 23; }                             // AF_INET6
        var s: i64 = pe_w(PE_W_SOCKET, fam, b & 15, c, 0);
        if s == 0 - 1 { return pe_win_sock_errno(); }
        return s + PE_WTAG_SOCK;
    }
    var s2: i64 = pe_win_sock(a);
    if n == 200 || n == 203 {                                // bind, connect
        var k: i64 = PE_W_BIND;
        if n == 203 { k = PE_W_CONNECT; }
        // Linux's AF_INET6 (10) is Windows' 23; the rest of sockaddr_in6 agrees
        var sa: i64 = b;
        var tmp: i64 = 0;
        if b != 0 && (pe_ld(b) & 65535) == 10 {
            tmp = pert_malloc(c + 8);
            pe_copy(tmp, b, c);
            pe_win_st16(tmp, 23);
            sa = tmp;
        }
        var r: i64 = pe_w32(pe_w(k, s2, sa, c, 0));
        if tmp != 0 { pert_free(tmp); }
        if r == 0 { return 0; }
        var en: i64 = pe_win_sock_errno();
        if n == 203 && en == 0 - 11 { return 0 - 115; }      // EINPROGRESS
        return en;
    }
    if n == 201 {                                            // listen
        if pe_w32(pe_w(PE_W_LISTEN, s2, b, 0, 0)) != 0 { return pe_win_sock_errno(); }
        return 0;
    }
    if n == 202 {                                            // accept
        var cs: i64 = pe_w(PE_W_ACCEPT, s2, b, c, 0);
        if cs == 0 - 1 { return pe_win_sock_errno(); }
        return cs + PE_WTAG_SOCK;
    }
    if n == 206 { return pe_win_send(a, b, c); }             // sendto
    if n == 207 { return pe_win_recv(a, b, c); }             // recvfrom
    if n == 208 {                                            // setsockopt
        if b == 1 && c == 2 { return 0; }                    // SO_REUSEADDR: Windows' differs
        var lvl: i64 = b;
        var o: i64 = c;
        if b == 1 { lvl = 65535; }
        if b == 41 && c == 26 { o = 27; }                    // IPV6_V6ONLY
        if pe_w32(nat_win_call(PE_W_SETSOCKOPT, s2, lvl, o, d, e, 0, 0, 0, 0, 0)) != 0 { return pe_win_sock_errno(); }
        return 0;
    }
    if n == 209 {                                            // getsockopt
        var lv: i64 = b;
        var opt: i64 = c;
        if b == 1 { lv = 65535; }
        if b == 1 && c == 4 { opt = 4103; }                  // SO_ERROR
        if pe_w32(nat_win_call(PE_W_GETSOCKOPT, s2, lv, opt, d, e, 0, 0, 0, 0, 0)) != 0 { return pe_win_sock_errno(); }
        return 0;
    }
    return 0 - 38;
}

fn pe_win_resolve(host: i64) -> i64 {
    pe_win_wsa();
    var he: i64 = pe_w(PE_W_GETHOSTBYNAME, host, 0, 0, 0);
    if he == 0 { return 0 - 1; }
    var list: i64 = pe_ld(he + 24);
    if list == 0 || pe_ld(list) == 0 { return 0 - 1; }
    return pe_win_ld32(pe_ld(list));
}

// ─── Processes ──────────────────────────────────────────────────────────

/// `cmd.exe /C cmd`: its exit code, -1 if it could not start.
fn pe_win_sh(cmd: i64) -> i64 {
    var pre: i64 = "cmd.exe /C " as i64;
    var lp: i64 = pe_len(pre);
    var lc: i64 = pe_len(cmd);
    var line: i64 = pert_malloc(lp + lc + 1);
    pe_copy(line, pre, lp);
    pe_copy(line + lp, cmd, lc);
    pe_stb(line + lp + lc, 0);
    var si: i64 = pert_malloc(104);
    pe_zero(si, 104);
    pe_win_st32(si, 104);
    var pi: i64 = pert_malloc(24);
    pe_zero(pi, 24);
    var ok: i64 = pe_w32(nat_win_call(PE_W_CREATE_PROCESS, 0, line, 0, 0, 1, 0, 0, 0, si, pi));
    pert_free(line);
    pert_free(si);
    if ok == 0 {
        pert_free(pi);
        return 0 - 1;
    }
    var hp: i64 = pe_ld(pi);
    pe_w(PE_W_WAIT_OBJECT, hp, 4294967295, 0, 0);
    var code: i64 = pert_malloc(8);
    pe_st(code, 0);
    pe_w(PE_W_EXIT_CODE, hp, code, 0, 0);
    var r: i64 = pe_win_ld32(code);
    pert_free(code);
    pe_w(PE_W_CLOSE_HANDLE, hp, 0, 0, 0);
    pe_w(PE_W_CLOSE_HANDLE, pe_ld(pi + 8), 0, 0, 0);
    pert_free(pi);
    return r;
}

// ─── Clocks, memory, the rest ───────────────────────────────────────────

fn pe_win_clock(clk: i64, ts: i64) -> i64 {
    var b: i64 = pert_malloc(16);
    pe_zero(b, 16);
    if clk == 0 || clk == 5 || clk == 8 {
        pe_w(PE_W_SYSTEM_TIME, b, 0, 0, 0);
        var t: i64 = pe_ld(b) - 116444736000000000;
        pe_st(ts, t / 10000000);
        pe_st(ts + 8, (t % 10000000) * 100);
    } else {
        pe_w(PE_W_QPC, b, 0, 0, 0);
        pe_w(PE_W_QPF, b + 8, 0, 0, 0);
        var c: i64 = pe_ld(b);
        var f: i64 = pe_ld(b + 8);
        if f <= 0 { f = 1; }
        pe_st(ts, c / f);
        pe_st(ts + 8, (c % f) * 1000000000 / f);
    }
    pert_free(b);
    return 0;
}

fn pe_win_futex(addr: i64, op: i64, val: i64, ts: i64) -> i64 {
    var cmd: i64 = op & 127;
    if cmd == 0 || cmd == 9 {                               // WAIT, WAIT_BITSET
        var ms: i64 = 4294967295;
        if ts != 0 { ms = pe_ld(ts) * 1000 + pe_ld(ts + 8) / 1000000; }
        var cmp: i64 = pert_malloc(8);
        pe_st(cmp, val);
        var ok: i64 = pe_w32(pe_w(PE_W_WAIT_ON_ADDRESS, addr, cmp, 4, ms));
        pert_free(cmp);
        if ok == 0 { return 0 - 110; }                       // ETIMEDOUT
        return 0;
    }
    if cmd == 1 || cmd == 10 {                              // WAKE
        if val == 1 { pe_w(PE_W_WAKE_ONE, addr, 0, 0, 0); } else { pe_w(PE_W_WAKE_ALL, addr, 0, 0, 0); }
        return 0;
    }
    return 0 - 38;
}

fn pe_win_cpus() -> i64 {
    var si: i64 = pert_malloc(64);
    pe_zero(si, 64);
    pe_w(PE_W_SYSTEM_INFO, si, 0, 0, 0);
    var n: i64 = pe_win_ld32(si + 32);
    pert_free(si);
    if n < 1 { n = 1; }
    return n;
}

fn pe_win_affinity(size: i64, mask: i64) -> i64 {
    var n: i64 = pe_win_cpus();
    pe_zero(mask, size);
    var i: i64 = 0;
    while i < n && i < size * 8 {
        pe_stb(mask + i / 8, pe_ldb(mask + i / 8) | (1 << (i % 8)));
        i = i + 1;
    }
    var bytes: i64 = ((n + 63) / 64) * 8;
    if bytes > size { bytes = size; }
    return bytes;
}

fn pe_win_sysinfo(si: i64) -> i64 {
    var m: i64 = pert_malloc(64);
    pe_zero(m, 64);
    pe_win_st32(m, 64);
    pe_w(PE_W_MEMORY_STATUS, m, 0, 0, 0);
    pe_zero(si, 112);
    pe_st(si + 32, pe_ld(m + 8));
    pe_st(si + 40, pe_ld(m + 16));
    pe_win_st32(si + 104, 1);
    pert_free(m);
    return 0;
}

fn pe_win_mprotect(addr: i64, len: i64, prot: i64) -> i64 {
    var p: i64 = 1;                                          // PAGE_NOACCESS
    if (prot & 2) != 0 { p = 4; } else if (prot & 1) != 0 { p = 2; }
    if (prot & 4) != 0 { p = 64; }                           // PAGE_EXECUTE_READWRITE
    var old: i64 = pert_malloc(8);
    var ok: i64 = pe_w32(pe_w(PE_W_VIRTUAL_PROTECT, addr, len, p, old));
    pert_free(old);
    if ok == 0 { return 0 - 22; }
    return 0;
}

fn pe_win_raise(sig: i64) -> i64 {
    if pe_sig_flags != 0 && sig >= 0 && sig < 64 && pe_ld(pe_sig_flags + 512 + sig * 8) != 0 {
        pe_st(pe_sig_flags + sig * 8, 1);
        return 0;
    }
    pe_st(pe_win_info + 16, 0);
    pe_on_signal(sig, pe_win_info);
    return 0;
}

/// Every system call of the Linux runtime (generic numbers), on Windows.
// ─── epoll over AFD (competitive RT11) ──────────────────────────────────
// The runtime's task scheduler (conc.fd) waits for sockets with Linux's
// epoll: eventfd2 (19), epoll_create1 (20), epoll_ctl (21), epoll_pwait
// (22). Here they are what wepoll and mio do on Windows: each socket a
// task waits for has one AFD poll (IOCTL_AFD_POLL on its base handle)
// outstanding, completed on one I/O completion port; epoll_pwait takes
// completions off the port and re-arms the poll (epoll is level-triggered:
// a socket still ready completes again at once). The eventfd is a key
// posted to the port. One epoll instance (the runtime makes one). When
// the AFD device cannot be opened, epoll_create1 says ENOSYS and the
// runtime polls each socket as before.
//
// A registration: [0] its fd (tagged SOCKET), [8] the epoll events wanted,
// [16] the data handed back, [24] its outstanding poll (0: none).
// A poll: [0, 16) IO_STATUS_BLOCK, [16, 48) AFD_POLL_INFO (timeout, count
// 1, the base handle, events | status), [48] its registration (0 once the
// registration is gone), [56] 1 once cancelled, [64, 80) the cancel's
// IO_STATUS_BLOCK.

const PE_WEP_EVT_KEY: i64 = 2;

var pe_wep_port: i64 = 0;       // the completion port (0: none yet)
var pe_wep_afd: i64 = 0;        // the AFD device, on the port
var pe_wep_lock: i64 = 0;       // *i64 spinlock: the table and the polls
var pe_wep_keys: i64 = 0;       // open addressing: fd (0 empty, -1 removed)
var pe_wep_regs: i64 = 0;       // the registration of each key
var pe_wep_cap: i64 = 0;
var pe_wep_used: i64 = 0;
var pe_wep_evt_on: bool = false;    // the eventfd is in the epoll set
var pe_wep_evt_data: i64 = 0;
var pe_wep_ents: i64 = 0;       // OVERLAPPED_ENTRY[64]
var pe_wep_n: i64 = 0;          // *u32: how many GetQueuedCompletionStatusEx took

fn pe_wep_create() -> i64 {
    if pe_wep_port != 0 { return PE_WTAG_EP + 1; }
    var port: i64 = pe_w(PE_W_CREATE_IOCP, 0 - 1, 0, 0, 0);
    if port == 0 { return 0 - 38; }
    // \\.\GLOBALROOT\Device\Afd\Fides: the AFD driver, overlapped
    var afd: i64 = nat_win_call(PE_W_CREATE_FILE, "\\\\.\\GLOBALROOT\\Device\\Afd\\Fides" as i64,
        1048576, 3, 0, 3, 1073741824, 0, 0, 0, 0);       // SYNCHRONIZE, share r/w, OPEN_EXISTING, OVERLAPPED
    if afd == 0 - 1 || afd == 0 {
        pe_w(PE_W_CLOSE_HANDLE, port, 0, 0, 0);
        return 0 - 38;
    }
    if pe_w(PE_W_CREATE_IOCP, afd, port, 0, 0) != port {
        pe_w(PE_W_CLOSE_HANDLE, afd, 0, 0, 0);
        pe_w(PE_W_CLOSE_HANDLE, port, 0, 0, 0);
        return 0 - 38;
    }
    pe_wep_lock = pert_malloc(8);
    pe_st(pe_wep_lock, 0);
    pe_wep_cap = 64;
    pe_wep_keys = pert_malloc(pe_wep_cap * 8);
    pe_zero(pe_wep_keys, pe_wep_cap * 8);
    pe_wep_regs = pert_malloc(pe_wep_cap * 8);
    pe_zero(pe_wep_regs, pe_wep_cap * 8);
    pe_wep_ents = pert_malloc(64 * 32);
    pe_wep_n = pert_malloc(8);
    pe_wep_afd = afd;
    pe_wep_port = port;
    return PE_WTAG_EP + 1;
}

/// The slot of fd in the table, or of where it would go (insert true).
fn pe_wep_slot(fd: i64, insert: bool) -> i64 {
    var mask: i64 = pe_wep_cap - 1;
    var i: i64 = ((fd >> 2) * 40503) & mask;
    var free: i64 = 0 - 1;
    var n: i64 = 0;
    while n < pe_wep_cap {
        var k: i64 = pe_ld(pe_wep_keys + i * 8);
        if k == fd { return i; }
        if k == 0 {
            if insert {
                if free >= 0 { return free; }
                return i;
            }
            return 0 - 1;
        }
        if k == 0 - 1 && free < 0 { free = i; }
        i = (i + 1) & mask;
        n = n + 1;
    }
    if insert { return free; }
    return 0 - 1;
}

fn pe_wep_grow() {
    var old_keys: i64 = pe_wep_keys;
    var old_regs: i64 = pe_wep_regs;
    var old_cap: i64 = pe_wep_cap;
    pe_wep_cap = old_cap * 2;
    pe_wep_keys = pert_malloc(pe_wep_cap * 8);
    pe_zero(pe_wep_keys, pe_wep_cap * 8);
    pe_wep_regs = pert_malloc(pe_wep_cap * 8);
    pe_zero(pe_wep_regs, pe_wep_cap * 8);
    pe_wep_used = 0;
    var i: i64 = 0;
    while i < old_cap {
        var k: i64 = pe_ld(old_keys + i * 8);
        if k != 0 && k != 0 - 1 {
            var j: i64 = pe_wep_slot(k, true);
            pe_st(pe_wep_keys + j * 8, k);
            pe_st(pe_wep_regs + j * 8, pe_ld(old_regs + i * 8));
            pe_wep_used = pe_wep_used + 1;
        }
        i = i + 1;
    }
    pert_free(old_keys);
    pert_free(old_regs);
}

/// The AFD events for the epoll events of a registration.
fn pe_wep_afd_events(ev: i64) -> i64 {
    var a: i64 = 16 | 32 | 256;                          // ABORT, LOCAL_CLOSE, CONNECT_FAIL
    if (ev & (1 | 8192)) != 0 { a = a | 1 | 2 | 8 | 128; }   // RECEIVE, EXPEDITED, DISCONNECT, ACCEPT
    if (ev & 4) != 0 { a = a | 4; }                      // SEND
    return a;
}

/// The epoll events for what an AFD poll reported.
fn pe_wep_epoll_events(a: i64) -> i64 {
    var e: i64 = 0;
    if (a & (1 | 2 | 128)) != 0 { e = e | 1; }           // EPOLLIN
    if (a & 4) != 0 { e = e | 4; }                       // EPOLLOUT
    if (a & 8) != 0 { e = e | 1 | 8192; }                // EPOLLIN | EPOLLRDHUP
    if (a & 16) != 0 { e = e | 8 | 16; }                 // EPOLLERR | EPOLLHUP
    if (a & 32) != 0 { e = e | 16; }                     // EPOLLHUP
    if (a & 256) != 0 { e = e | 8 | 4; }                 // EPOLLERR | EPOLLOUT
    return e;
}

/// Submit the AFD poll of registration r (under the lock).
fn pe_wep_arm(r: i64) {
    var fd: i64 = pe_ld(r);
    var sock: i64 = pe_win_sock(fd);
    var base: i64 = sock;
    var out: i64 = pert_malloc(16);
    pe_zero(out, 16);
    // SIO_BASE_HANDLE: the socket under any layered provider
    if pe_w32(nat_win_call(PE_W_WSA_IOCTL, sock, 1207959586, 0, 0, out, 8, out + 8, 0, 0, 0)) == 0 {
        base = pe_ld(out);
    }
    pert_free(out);
    var op: i64 = pert_malloc(80);
    pe_zero(op, 80);
    pe_st(op + 16, 9223372036854775807);
    pe_st(op + 24, 1);
    pe_st(op + 32, base);
    pe_st(op + 40, pe_wep_afd_events(pe_ld(r + 8)));
    pe_st(op + 48, r);
    var st: i64 = pe_w32(nat_win_call(PE_W_NT_IOCTL, pe_wep_afd, 0, 0, op, op, 73764, op + 16, 32, op + 16, 32));
    if st != 0 && st != 259 {
        // refused: no completion will come; report it ready at the next wait
        pert_free(op);
        pe_st(r + 24, 0);
        pe_w(PE_W_PQCS, pe_wep_port, 0, 3, r);
        return;
    }
    pe_st(r + 24, op);
}

/// Cancel the outstanding poll of r (it is freed when its completion comes).
fn pe_wep_cancel(r: i64) {
    var op: i64 = pe_ld(r + 24);
    if op == 0 { return; }
    pe_st(op + 56, 1);
    pe_st(op + 48, 0);
    pe_st(r + 24, 0);
    nat_win_call(PE_W_NT_CANCEL, pe_wep_afd, op, op + 64, 0, 0, 0, 0, 0, 0, 0);
}

fn pe_wep_ctl(op: i64, fd: i64, ev: i64) -> i64 {
    if pe_wep_port == 0 { return 0 - 9; }                    // EBADF
    var events: i64 = 0;
    var data: i64 = 0;
    if ev != 0 {
        events = pe_win_ld32(ev);
        data = pe_ld(ev + 4);                                // packed on x86-64
    }
    if (fd & PE_WTAG_MASK) == PE_WTAG_EVT {
        if op == 2 { pe_wep_evt_on = false; } else { pe_wep_evt_on = true; pe_wep_evt_data = data; }
        return 0;
    }
    if !pe_win_is_sock(fd) { return 0 - 1; }                 // EPERM: only sockets
    pe_lock(pe_wep_lock);
    var slot: i64 = pe_wep_slot(fd, false);
    var r: i64 = 0;
    if slot >= 0 { r = pe_ld(pe_wep_regs + slot * 8); }
    var res: i64 = 0;
    if op == 1 {                                             // ADD
        if r != 0 {
            res = 0 - 17;                                    // EEXIST
        } else {
            if (pe_wep_used + 1) * 2 > pe_wep_cap { pe_wep_grow(); }
            var ns: i64 = pe_wep_slot(fd, true);
            r = pert_malloc(32);
            pe_zero(r, 32);
            pe_st(r, fd);
            pe_st(r + 8, events);
            pe_st(r + 16, data);
            pe_st(pe_wep_keys + ns * 8, fd);
            pe_st(pe_wep_regs + ns * 8, r);
            pe_wep_used = pe_wep_used + 1;
            pe_wep_arm(r);
        }
    } else if op == 3 {                                      // MOD
        if r == 0 {
            res = 0 - 2;                                     // ENOENT
        } else {
            pe_st(r + 8, events);
            pe_st(r + 16, data);
            pe_wep_cancel(r);
            pe_wep_arm(r);
        }
    } else if op == 2 {                                      // DEL
        if r == 0 {
            res = 0 - 2;
        } else {
            pe_wep_cancel(r);
            pe_st(pe_wep_keys + slot * 8, 0 - 1);
            pe_st(pe_wep_regs + slot * 8, 0);
            pe_wep_used = pe_wep_used - 1;
            pert_free(r);
        }
    }
    pe_unlock(pe_wep_lock);
    return res;
}

fn pe_wep_out(events_out: i64, k: i64, ev: i64, data: i64) {
    var e: i64 = events_out + k * 12;                        // packed epoll_event
    pe_win_st32(e, ev);
    var i: i64 = 0;
    while i < 8 {
        pe_stb(e + 4 + i, (data >> (i * 8)) & 255);
        i = i + 1;
    }
}

fn pe_wep_wait(events_out: i64, maxev: i64, ms: i64) -> i64 {
    if pe_wep_port == 0 { return 0 - 9; }
    var want: i64 = maxev;
    if want > 64 { want = 64; }
    if want < 1 { return 0 - 22; }                           // EINVAL
    var timeout: i64 = ms;
    if ms < 0 { timeout = 4294967295; }                      // INFINITE
    pe_st(pe_wep_n, 0);
    if pe_w32(nat_win_call(PE_W_GQCS_EX, pe_wep_port, pe_wep_ents, want, pe_wep_n, timeout, 0, 0, 0, 0, 0)) == 0 {
        return 0;                                            // the time passed
    }
    var got: i64 = pe_win_ld32(pe_wep_n);
    var k: i64 = 0;
    pe_lock(pe_wep_lock);
    var i: i64 = 0;
    while i < got {
        var ent: i64 = pe_wep_ents + i * 32;
        var key: i64 = pe_ld(ent);
        var ov: i64 = pe_ld(ent + 8);
        if key == PE_WEP_EVT_KEY {
            if pe_wep_evt_on {
                pe_wep_out(events_out, k, 1, pe_wep_evt_data);
                k = k + 1;
            }
        } else if key == 3 {
            // a poll AFD refused: the registration, reported ready
            var r3: i64 = ov;
            if r3 != 0 && pe_wep_slot(pe_ld(r3), false) >= 0 {
                pe_wep_out(events_out, k, pe_ld(r3 + 8) | 8, pe_ld(r3 + 16));
                k = k + 1;
            }
        } else if ov != 0 {
            var op: i64 = ov;
            var r: i64 = pe_ld(op + 48);
            if pe_ld(op + 56) == 0 && r != 0 {
                pe_st(r + 24, 0);
                var got_ev: i64 = pe_wep_epoll_events(pe_win_ld32(op + 40));
                var shown: i64 = got_ev & (pe_ld(r + 8) | 8 | 16);
                if shown != 0 {
                    pe_wep_out(events_out, k, shown, pe_ld(r + 16));
                    k = k + 1;
                }
                // level-triggered: wait again (completes at once if still ready)
                pe_wep_arm(r);
            }
            pert_free(op);
        }
        i = i + 1;
    }
    pe_unlock(pe_wep_lock);
    return k;
}

/// Is fd one of the epoll emulation's own (the eventfd, the instance)?
fn pe_wep_own(fd: i64) -> bool {
    var t: i64 = fd & PE_WTAG_MASK;
    return fd > 2 && (t == PE_WTAG_EVT || t == PE_WTAG_EP);
}

pub fn pe_win_syscall(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    // epoll over AFD (RT11): the eventfd and the epoll instance
    if n == 19 { return PE_WTAG_EVT + 1; }                  // eventfd2
    if n == 20 { return pe_wep_create(); }                   // epoll_create1
    if n == 21 { return pe_wep_ctl(b, c, d); }               // epoll_ctl
    if n == 22 { return pe_wep_wait(b, c, d); }              // epoll_pwait
    if (n == 63 || n == 64 || n == 57) && pe_wep_own(a) {
        if n == 64 && (a & PE_WTAG_MASK) == PE_WTAG_EVT && pe_wep_port != 0 {
            pe_w(PE_W_PQCS, pe_wep_port, 0, PE_WEP_EVT_KEY, 0);
            return 8;
        }
        if n == 63 { pe_st(b, 1); return 8; }
        return 0;
    }
    if n == 63 { return pe_win_read(a, b, c); }
    if n == 64 { return pe_win_write(a, b, c); }
    if n == 56 { return pe_win_open(b, c); }                 // openat
    if n == 57 { return pe_win_close(a); }
    if n == 62 { return pe_win_lseek(a, b, c); }
    if n == 61 {                                             // getdents64
        if !pe_win_is_dir(a) { return 0 - 20; }              // ENOTDIR
        return pe_win_getdents(a, b, c);
    }
    if n == 79 { return pe_win_stat(b, c); }                 // newfstatat
    if n == 35 {                                             // unlinkat
        var p: i64 = pe_win_path(b);
        var ok: i64 = 0;
        if (c & 512) != 0 { ok = pe_w32(pe_w(PE_W_REMOVE_DIRECTORY, p, 0, 0, 0)); }
        else { ok = pe_w32(pe_w(PE_W_DELETE_FILE, p, 0, 0, 0)); }
        if ok == 0 { return pe_win_errno(); }
        return 0;
    }
    if n == 34 {                                             // mkdirat
        if pe_w32(pe_w(PE_W_CREATE_DIRECTORY, b, 0, 0, 0)) == 0 { return pe_win_errno(); }
        return 0;
    }
    if n == 276 || n == 38 {                                 // renameat2, renameat
        if pe_w32(pe_w(PE_W_MOVE_FILE, b, d, 3, 0)) == 0 { return pe_win_errno(); }
        return 0;
    }
    if n == 222 {                                            // mmap
        var m: i64 = pe_w(PE_W_VIRTUAL_ALLOC, 0, b, 12288, 4);
        if m == 0 { return 0 - 12; }
        return m;
    }
    if n == 215 {                                            // munmap
        if pe_w32(pe_w(PE_W_VIRTUAL_FREE, a, 0, 32768, 0)) == 0 {
            pe_w(PE_W_VIRTUAL_FREE, a, b, 16384, 0);
        }
        return 0;
    }
    if n == 226 { return pe_win_mprotect(a, b, c); }
    if n == 113 { return pe_win_clock(a, b); }
    if n == 101 {                                            // nanosleep
        pe_w(PE_W_SLEEP, pe_ld(a) * 1000 + (pe_ld(a + 8) + 999999) / 1000000, 0, 0, 0);
        return 0;
    }
    if n == 124 { pe_w(PE_W_SWITCH_TO_THREAD, 0, 0, 0, 0); return 0; }
    if n == 123 { return pe_win_affinity(b, c); }
    if n == 172 { return pe_w(PE_W_PROCESS_ID, 0, 0, 0, 0) & 4294967295; }
    if n == 178 { return pe_w(PE_W_THREAD_ID, 0, 0, 0, 0) & 4294967295; }
    if n == 173 || n == 174 || n == 175 || n == 176 || n == 177 { return 0; }
    if n == 278 {                                            // getrandom
        if pe_w32(pe_w(PE_W_GEN_RANDOM, 0, a, b, 2)) != 0 { return 0 - 5; }
        return b;
    }
    if n == 93 || n == 94 {                                  // exit, exit_group
        pe_w(PE_W_EXIT_PROCESS, a, 0, 0, 0);
        return 0;
    }
    if n == 98 { return pe_win_futex(a, b, c, d); }
    if n == 134 {                                            // rt_sigaction
        if (a == 11 || a == 7 || a == 8 || a == 4 || a == 5) && !pe_win_veh_on && b != 0 {
            pe_win_veh_on = true;
            pe_w(PE_W_ADD_VEH, 1, pe_ld(b), 0, 0);
        }
        return 0;
    }
    if n == 132 {                                            // sigaltstack: room for the handler
        if a != 0 && (pe_ld(a + 8) & 2) == 0 {
            var g: i64 = pert_malloc(8);
            pe_st(g, 65536);
            pe_w(PE_W_STACK_GUARANTEE, g, 0, 0, 0);
            pert_free(g);
        }
        return 0;
    }
    if n == 129 { return pe_win_raise(b); }                  // kill
    if n == 131 { return pe_win_raise(c); }                  // tgkill
    if n == 179 { return pe_win_sysinfo(a); }
    if n == 25 {                                             // fcntl F_SETFL O_NONBLOCK
        if pe_win_is_sock(a) && b == 4 {
            var on: i64 = pert_malloc(8);
            pe_st(on, 0);
            if (c & 2048) != 0 { pe_st(on, 1); }
            pe_w(PE_W_IOCTL_SOCKET, pe_win_sock(a), 2147772030, on, 0);   // FIONBIO
            pert_free(on);
        }
        return 0;
    }
    if n == 73 { return pe_win_poll(a, c); }                 // ppoll
    if n >= 198 && n <= 209 { return pe_win_socket_call(n, a, b, c, d, e); }
    if n == PE_WSYS_SHELL { return pe_win_sh(a); }
    if n == PE_WSYS_RESOLVE { return pe_win_resolve(a); }
    return 0 - 38;                                           // ENOSYS
}
