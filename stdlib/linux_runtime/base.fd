// stdlib/linux_runtime/base.fd — the Fides runtime of native Linux
// executables for AArch64 and RISC-V 64 (release F8; compiler/nat_ir.fd).
//
// As stdlib/pe_runtime does for Windows: builtin p_X runs pert_X, in Fides,
// merged into the program. Here everything stands on two machine-code
// primitives of the backend: nat_syscall (a Linux system call, generic
// numbering: the same on AArch64 and RISC-V) and nat_start_sp (the stack
// the kernel started the process with: argc, argv, envp). No C library.
// The behaviour is the C backend's and the Windows runtime's: the same
// output, the same panics ("Double free", "Invalid free: ..."), the same
// float text.
//
// Functions named pert_* / pe_* are runtime code: the backend compiles
// their arithmetic wrapping, as pe_ir does for stdlib/pe_runtime.

extern "C" {
    fn nat_syscall(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64;
    fn nat_os() -> i64;
    fn nat_start_sp() -> i64;
    fn nat_atomic_load(addr: i64) -> i64;
    fn nat_atomic_store(addr: i64, v: i64);
    fn nat_atomic_add(addr: i64, v: i64) -> i64;
    fn nat_atomic_cas(addr: i64, expected: i64, nv: i64) -> i64;
    fn nat_ctx_swap(save: i64, sp: i64);
    fn nat_ctx_tramp() -> i64;
    fn nat_clone_thread(entry: i64, arg: i64, stack_top: i64, ctid: i64, tls: i64) -> i64;
    fn nat_call_fn(addr: i64, nargs: i64, argv: i64) -> i64;
    fn nat_fn_table() -> i64;
    fn nat_tls_get() -> i64;
    fn nat_tls_set(v: i64);
    fn nat_frame_fp() -> i64;
    fn nat_frame_ret(fp: i64) -> i64;
    fn nat_frame_next(fp: i64) -> i64;
    fn nat_fn_names() -> i64;
    fn nat_sig_handler() -> i64;
    fn nat_fma(a: i64, b: i64, c: i64) -> i64;
    fn nat_sig_restorer() -> i64;
    fn nat_arch() -> i64;
}

// Linux system calls (asm-generic/unistd.h)
const PE_SYS_UNLINKAT: i64 = 35;
const PE_SYS_OPENAT: i64 = 56;
const PE_SYS_CLOSE: i64 = 57;
const PE_SYS_LSEEK: i64 = 62;
const PE_SYS_READ: i64 = 63;
const PE_SYS_WRITE: i64 = 64;
const PE_SYS_EXIT_GROUP: i64 = 94;
const PE_SYS_CLOCK_GETTIME: i64 = 113;
const PE_SYS_GETPID: i64 = 172;
const PE_SYS_MUNMAP: i64 = 215;
const PE_SYS_MMAP: i64 = 222;
const PE_SYS_GETRANDOM: i64 = 278;
const PE_AT_FDCWD: i64 = -100;

// ─── Words and bytes ────────────────────────────────────────────────────

fn pe_ld(addr: i64) -> i64 {
    var p: *mut i64 = addr;
    var v: i64 = 0;
    // SAFETY: NOT checked here: the runtime's callers read a word of a block
    // they allocated (thread/task blocks, queues, channels, tables), of the
    // initial stack (argv, envp, auxv) or of a struct the kernel filled; the
    // layouts are in each section's comment.
    unsafe {
        v = *p;
    }
    return v;
}

fn pe_st(addr: i64, value: i64) {
    var p: *mut i64 = addr;
    // SAFETY: NOT checked here: as pe_ld, a word of a block of this runtime's.
    unsafe {
        *p = value;
    }
}

fn pe_ldb(addr: i64) -> i64 {
    var p: *mut u8 = addr;
    var v: i64 = 0;
    // SAFETY: NOT checked here: a byte of a string up to its NUL or of a
    // buffer the caller holds.
    unsafe {
        v = *p;
    }
    return v;
}

fn pe_stb(addr: i64, value: i64) {
    var p: *mut u8 = addr;
    // SAFETY: NOT checked here: a byte of a buffer the caller allocated.
    unsafe {
        *p = value;
    }
}

fn pe_copy(dst: i64, src: i64, n: i64) {
    var i: i64 = 0;
    while i + 8 <= n {
        pe_st(dst + i, pe_ld(src + i));
        i = i + 8;
    }
    while i < n {
        pe_stb(dst + i, pe_ldb(src + i));
        i = i + 1;
    }
}

fn pe_zero(dst: i64, n: i64) {
    var i: i64 = 0;
    // RT8: through pointers, four words a turn, not a pe_st call per word
    // (the allocator zeroes every block it hands out again: a large one of
    // the span cache is megabytes)
    while i + 32 <= n {
        var w0: *mut i64 = dst + i;
        var w1: *mut i64 = dst + i + 8;
        var w2: *mut i64 = dst + i + 16;
        var w3: *mut i64 = dst + i + 24;
        // SAFETY: NOT checked here: i + 32 <= n, four words of the n bytes
        // at dst the caller allocated (as pe_st's).
        unsafe {
            *w0 = 0;
            *w1 = 0;
            *w2 = 0;
            *w3 = 0;
        }
        i = i + 32;
    }
    while i + 8 <= n {
        pe_st(dst + i, 0);
        i = i + 8;
    }
    while i < n {
        pe_stb(dst + i, 0);
        i = i + 1;
    }
}

fn pe_sys(n: i64, a: i64, b: i64, c: i64) -> i64 {
    return nat_syscall(n, a, b, c, 0, 0, 0);
}

// ─── Memory: pe_ir's blocks ─────────────────────────────────────────────
// A block is an 8-byte header, then the payload: the header is PE_MAGIC
// plus the size class k (the block is 2^k bytes) plus, in bits 8..31, the
// id of the heap that handed it out (RT8, owner return: 0 for the large and
// debug blocks below), or the freed magic plus k once freed. Either way the
// header reads negative: core's p_str_len_word tells a headered string from
// a plain block by it (AGENTS.md Known Bugs 21, 25). Class 63 is a large
// block of its own mapping, its total size in the word before the header.
// Freed blocks wait on a list per class (the next one in their first
// payload word); a reused block is zeroed, as fresh memory is (but one of
// pert_malloc_uninit, which core asks for when it writes every byte it
// hands out: its bytes are left as they are).
// RT8: each thread has a heap of its own ("Per-thread heaps" below): its
// free lists, the chunk it bumps blocks out of, its span cache. A thread's
// malloc and free take no lock. Once a second thread may run (pe_mt_on),
// the heap lock guards only what threads share: the chunk table and a new
// chunk, the pool of ended threads' lists, the heaps of ended threads,
// --leaks' list, the memory profile (FID_MEM_LIMIT's count has a lock of
// its own). A block freed by a thread that did not allocate it goes back
// to its owner (the heap whose id its header holds): onto that heap's
// remote-free list, an atomic stack the owner empties into its own lists
// on its slow path (as mimalloc's thread-delayed free). A block is in use
// or on exactly one list (a heap's, the pool's or a remote-free list).
//
// The fast paths (pert_malloc, pert_malloc_uninit, pert_free) are one
// function each, with no call but the thread pointer's read: the class of
// a block of up to PE_FAST_MAX bytes from the heap's table (PE_H_CLS), a
// pop off (a push onto) the heap's list of that class, the header, the
// count of free bytes RT7's trim runs by, and the zeroing. Everything else
// (a list that is empty, a larger block, another thread's block, a free
// past the trim's threshold, FID_MEM_LIMIT, --leaks/--checked-alloc/--mem)
// is pe_alloc_slow / pe_free_raw. A task (M:N, conc.fd RT10) may resume on
// another worker thread only at a call that switches tasks, which neither
// path makes: each reads the heap from the thread pointer at its start, so
// a task that allocated on one worker and frees on another frees remotely.

const PE_LARGE: i64 = 63;

/// The live-block magic: negative, low 32 bits 0 (a block header is never
/// a plausible string length, core's p_str_len_word relies on it)
fn pe_magic() -> i64 {
    return 0 - (1515867892 << 32);
}

fn pe_freed() -> i64 {
    return 0 - (1515867893 << 32);
}

/// pe_freed() as a constant, for pert_free's fast path (a call there is
/// not inlined: see pert_malloc)
const PE_FREED_MAGIC: i64 = -6510603025491427328;

/// A null string (a str is its address)
fn pe_null_str() -> i64 {
    return 0;
}

// The size of a chunk pe_bump maps (4 MB). A global, not a literal, so that
// a target with little RAM can give it a smaller initial value by name
// (compiler/nat_thumb.fd th_gen_data overrides runtime globals' values).
var pe_heap_chunk: i64 = 4194304;

fn pe_mmap(n: i64) -> i64 {
    var a: i64 = nat_syscall(PE_SYS_MMAP, 0, n, 3, 34, 0 - 1, 0);  // RW, PRIVATE|ANONYMOUS
    if a < 0 && a > 0 - 4096 {
        pe_write_all(2, "Panic: out of memory\n" as i64, 21);
        pe_sys(PE_SYS_EXIT_GROUP, 1, 0, 0);
    }
    return a;
}

// ─── RT8: per-thread heaps ──────────────────────────────────────────────
// A heap is PE_H_SIZE bytes of pages of its own (zeroed when mapped):
//   [k * 8]       the free list of class k (4..20)
//   [PE_H_CUR], [PE_H_END]  what is left of its chunk to bump blocks from
//   [PE_H_BASE]   that chunk (0: none yet)
//   [PE_H_FL]     the bytes on its lists (resident ones: a decommitted or
//                 known-zero block is not counted)
//   [PE_H_TRIM]   the trim runs when PE_H_FL passes it
//   [PE_H_TS]     16 bytes for clock_gettime (the span cache's clock)
//   [PE_H_SPN], [PE_H_SPB]  the span cache's spans and their bytes
//   [PE_H_BT0], [PE_H_BCNT] the span cache's window: when it began, the
//                 large blocks asked for since
//   [PE_H_ANY]    (the pool) 1 when its lists may hold a block
//   [PE_H_SPM + 8 i], [PE_H_SPAT + 8 i]  cached span i: its mapping, when
//                 it was cached (ms)
//   [PE_H_LIVE]   the header base of its blocks: PE_MAGIC + (its id << 8)
//   [PE_H_ID]     its id (1: pe_h0; 0: the pool, which owns no block)
//   [PE_H_NEXT], [PE_H_STATE]  the list of heaps whose thread ended, 1 on it
//   [PE_H_RF]     its remote-free list (atomic; a cache line of its own):
//                 blocks of its freed by other threads, freed headers
//   [PE_H_CLS + g] the class of a block of 16 (g - 1) + 1 .. 16 g bytes with
//                 its header (g = 1..64: up to 1 KB), a byte each
// Before a second thread may run there is one heap, pe_h0, and no lock;
// the thread pointer is not read (on x86-64 it is not set up before
// pe_rt_init). Then a thread reaches its heap through its block (pe_tls,
// word PE_TLS_HEAP), read from the thread pointer at every call: a task
// may resume on another thread, and then uses that thread's heap. A
// thread's first allocation makes its heap; the first thread's stays
// pe_h0. A thread that ends (pe_heap_thread_end) gives its empty chunks
// back and its lists to a pool: a thread that finds its list of a class
// empty takes the pool's of that class, and a trim takes all of them.
// Its heap is abandoned, not unmapped: the blocks it handed out that are
// still in use carry its id, and their frees go on its remote-free list.
// The next thread to start takes an abandoned heap over (its id, its
// remote frees: pe_heap_attach), and a thread about to map a new chunk,
// or trimming, moves the remote frees of every abandoned heap to the pool
// first (pe_aband_collect): nothing freed to a heap whose thread ended is
// lost, and heaps (and ids) are reused, as many as threads run at once.

const PE_H_SIZE: i64 = 1024;
const PE_H_CUR: i64 = 168;
const PE_H_END: i64 = 176;
const PE_H_BASE: i64 = 184;
const PE_H_FL: i64 = 192;
const PE_H_TRIM: i64 = 200;
const PE_H_TS: i64 = 208;
const PE_H_SPN: i64 = 224;
const PE_H_SPB: i64 = 232;
const PE_H_BT0: i64 = 240;
const PE_H_BCNT: i64 = 248;
const PE_H_ANY: i64 = 256;
const PE_H_SPM: i64 = 264;
const PE_H_SPAT: i64 = 392;
const PE_H_LIVE: i64 = 520;
const PE_H_ID: i64 = 528;
const PE_H_NEXT: i64 = 536;
const PE_H_STATE: i64 = 544;
const PE_H_RF: i64 = 576;
const PE_H_CLS: i64 = 640;
// the word of a thread's block (pe_tls) that holds its heap
const PE_TLS_HEAP: i64 = 88;
// the largest block of the fast paths (with its header: 1 KB, PE_H_CLS)
const PE_FAST_MAX: i64 = 1016;
// heap ids: at most this many heaps at once (threads that allocate)
const PE_HEAP_MAX: i64 = 8192;

var pe_h0: i64 = 0;  // the first thread's heap
var pe_pool: i64 = 0;  // a heap: the lists of threads that ended (under the heap lock)
var pe_aband: i64 = 0;  // the heaps of threads that ended (under the heap lock)
var pe_heap_last: i64 = 1;  // the last heap id given (1: pe_h0's; under the heap lock)
var pe_heap_tab: i64 = 0;  // heap id -> heap (PE_HEAP_MAX words), made for the second heap

/// A new heap with id `id` (0: the pool), its class table filled.
fn pe_heap_new(id: i64) -> i64 {
    val h: i64 = pe_mmap(PE_H_SIZE);
    pe_st(h + PE_H_TRIM, PE_TRIM_MIN);
    pe_st(h + PE_H_ID, id);
    pe_st(h + PE_H_LIVE, pe_magic() + (id << 8));
    var g: i64 = 1;
    while g <= 64 {
        var k: i64 = 4;
        while (1 << k) < g * 16 {
            k = k + 1;
        }
        pe_stb(h + PE_H_CLS + g, k);
        g = g + 1;
    }
    return h;
}

/// The heap of id `id`, 0 when there is none (a header no heap wrote).
fn pe_heap_owner(id: i64) -> i64 {
    if id == 1 {
        return pe_h0;
    }
    if id < 2 || id >= PE_HEAP_MAX || pe_heap_tab == 0 {
        return 0;
    }
    return pe_ld(pe_heap_tab + id * 8);
}

/// This thread's heap.
fn pe_heap() -> i64 {
    if pe_mt == 0 {
        if pe_h0 == 0 {
            pe_h0 = pe_heap_new(1);
        }
        return pe_h0;
    }
    val t: i64 = nat_tls_get();
    if t != 0 {
        val h: i64 = pe_ld(t + PE_TLS_HEAP);
        if h != 0 {
            return h;
        }
    }
    return pe_heap_attach(t);
}

/// The first allocation of a thread (block t, 0 if it has none: a thread
/// the runtime did not start gets one, from pages of its own, kept): its
/// heap. RT8: the heap of a thread that ended when there is one (taken
/// over with its id and its remote frees: they come onto its lists at its
/// first slow path), else a new one with the next id.
fn pe_heap_attach(t0: i64) -> i64 {
    var t: i64 = t0;
    if t == 0 {
        t = pe_mmap(4096);
        pe_st(t + 64, t);
        nat_tls_set(t);
    }
    var h: i64 = 0;
    pe_glock();
    if pe_aband != 0 {
        h = pe_aband;
        pe_aband = pe_ld(h + PE_H_NEXT);
        pe_st(h + PE_H_NEXT, 0);
        pe_st(h + PE_H_STATE, 0);
        pe_st(h + PE_H_TRIM, PE_TRIM_MIN);
        pe_st(h + PE_H_BT0, 0);
        pe_st(h + PE_H_BCNT, 0);
    } else {
        val id: i64 = pe_heap_last + 1;
        if id >= PE_HEAP_MAX {
            // (no panic: printing it may allocate, on this thread)
            pe_write_all(2, "Panic: too many threads allocating at once\n" as i64, 43);
            pe_sys(PE_SYS_EXIT_GROUP, 1, 0, 0);
        }
        if pe_heap_tab == 0 {
            pe_heap_tab = pe_mmap(PE_HEAP_MAX * 8);
            pe_st(pe_heap_tab + 8, pe_h0);
        }
        h = pe_heap_new(id);
        // published before any block of it exists (a thread that frees one
        // learnt of it after it was made)
        nat_atomic_store(pe_heap_tab + id * 8, h);
        pe_heap_last = id;
    }
    pe_gunlock();
    pe_st(t + PE_TLS_HEAP, h);
    return h;
}

// ─── RT8: owner return ──────────────────────────────────────────────────
// A block freed by a thread whose heap did not hand it out is pushed onto
// its owner's remote-free list (pe_rf_push: a lock-free stack; only whole
// lists are taken off it, so no ABA). The owner takes the whole list
// (pe_rf_take) on its slow path, when its list of the class asked for is
// empty, before a trim and at its thread's end, and puts each block on its
// lists (pe_list_into), counted as RT7's trim counts a free. Those of a
// heap whose thread ended are moved to the pool (pe_aband_collect).

/// Block p (its freed header written) onto heap h's remote-free list.
fn pe_rf_push(h: i64, p: i64) {
    val a: i64 = h + PE_H_RF;
    var old: i64 = nat_atomic_load(a);
    pe_st(p, old);
    while nat_atomic_cas(a, old, p) == 0 {
        old = nat_atomic_load(a);
        pe_st(p, old);
    }
}

/// Heap h's remote-free list, taken whole (0: empty).
fn pe_rf_take(h: i64) -> i64 {
    val a: i64 = h + PE_H_RF;
    var l: i64 = nat_atomic_load(a);
    while l != 0 && nat_atomic_cas(a, l, 0) == 0 {
        l = nat_atomic_load(a);
    }
    return l;
}

/// The freed blocks of list l onto heap h's lists of their classes (h is
/// this thread's, or under the heap lock), with the bytes RT7 counts.
fn pe_list_into(h: i64, l0: i64) {
    var l: i64 = l0;
    var fl: i64 = pe_ld(h + PE_H_FL);
    while l != 0 {
        val nx: i64 = pe_ld(l);
        val w: i64 = pe_ld(l - 8);
        val k: i64 = w & 63;
        pe_st(l, pe_ld(h + k * 8));
        pe_st(h + k * 8, l);
        if (w & (PE_DECOMMITTED + PE_ZERO)) == 0 {
            fl = fl + (1 << k);
        }
        l = nx;
    }
    pe_st(h + PE_H_FL, fl);
    pe_st(h + PE_H_ANY, 1);
}

/// This thread's heap h: the blocks other threads freed to it onto its
/// lists.
fn pe_rf_drain(h: i64) {
    if pe_ld(h + PE_H_RF) == 0 {
        return;
    }
    val l: i64 = pe_rf_take(h);
    if l != 0 {
        pe_list_into(h, l);
    }
}

/// The remote frees of the heaps whose thread ended into the pool (under
/// the heap lock).
fn pe_aband_collect() {
    if pe_pool == 0 {
        return;
    }
    var a: i64 = pe_aband;
    while a != 0 {
        val l: i64 = pe_rf_take(a);
        if l != 0 {
            pe_list_into(pe_pool, l);
        }
        a = pe_ld(a + PE_H_NEXT);
    }
}

/// `n` bytes of heap h's chunk (a multiple of 16), a new chunk of
/// pe_heap_chunk bytes (4 MB) when it is full.
fn pe_bump(h: i64, n: i64) -> i64 {
    val b: i64 = pe_ld(h + PE_H_CUR);
    if b != 0 && b + n <= pe_ld(h + PE_H_END) {
        pe_st(h + PE_H_CUR, b + n);
        return b;
    }
    val c: i64 = pe_chunk_new(h, n);
    pe_st(h + PE_H_CUR, c + n);
    return c;
}

/// A new chunk for heap h (at least n bytes). RT8: what is left of the old
/// one goes on h's lists, known zero (pe_carve_tail); RT7: the old one
/// keeps how far it was handed out. The chunk table is shared: under the
/// heap lock.
fn pe_chunk_new(h: i64, n: i64) -> i64 {
    var size: i64 = pe_heap_chunk;
    if n + PE_CHUNK_SKIP > size {
        size = n + PE_CHUNK_SKIP;
    }
    pe_carve_tail(h);
    val c: i64 = pe_mmap(size);
    pe_glock();
    val old: i64 = pe_ld(h + PE_H_BASE);
    if old != 0 {
        pe_chunk_retire(old, pe_ld(h + PE_H_CUR));
    }
    pe_chunk_add(c, size);
    pe_gunlock();
    pe_st(h + PE_H_BASE, c);
    pe_st(h + PE_H_CUR, c + PE_CHUNK_SKIP);
    pe_st(h + PE_H_END, c + size);
    return c + PE_CHUNK_SKIP;
}

/// The first bytes of a chunk are never handed out: a block at the start
/// of a mapping would have its payload 8 bytes in, and core reads the 16
/// bytes before any 8-aligned string (Str_dup, Str_drop, p_str_len: the
/// header of a counted string), which for a plain string there are the
/// page before the mapping (--nat Windows: often not mapped, an access
/// violation in Str_dup). pe_chunk_empty counts them as handed out. (Every
/// other block of this allocator has 16 bytes of its own before its
/// payload: a large block its size word and header, a debug block 80
/// bytes, a checked one its page.)
const PE_CHUNK_SKIP: i64 = 16;

/// RT8: the rest of heap h's chunk, too small for the block asked for,
/// cut into free blocks of the largest classes that fit, each marked
/// PE_ZERO in its freed header: fresh pages, only the link word written, so
/// pe_malloc_raw hands it out without zeroing it. Not counted in PE_H_FL
/// (as a decommitted block is not): its pages are not resident.
fn pe_carve_tail(h: i64) {
    var cur: i64 = pe_ld(h + PE_H_CUR);
    if cur == 0 {
        return;
    }
    val end: i64 = pe_ld(h + PE_H_END);
    var k: i64 = 20;
    while k >= 4 {
        val sz: i64 = 1 << k;
        while end - cur >= sz {
            val b: i64 = cur + 8;
            cur = cur + sz;
            pe_st(b - 8, pe_freed() + k + PE_ZERO);
            pe_st(b, pe_ld(h + k * 8));
            pe_st(h + k * 8, b);
        }
        k = k - 1;
    }
    pe_st(h + PE_H_CUR, cur);
}

/// Move the free lists of heap `from` in front of those of `to`, with their
/// counted bytes (under the heap lock).
fn pe_heap_splice(from: i64, to: i64) {
    var k: i64 = 4;
    while k <= 20 {
        val b: i64 = pe_ld(from + k * 8);
        if b != 0 {
            var tl: i64 = b;
            while pe_ld(tl) != 0 {
                tl = pe_ld(tl);
            }
            pe_st(tl, pe_ld(to + k * 8));
            pe_st(to + k * 8, b);
            pe_st(from + k * 8, 0);
            pe_st(to + PE_H_ANY, 1);
        }
        k = k + 1;
    }
    pe_st(to + PE_H_FL, pe_ld(to + PE_H_FL) + pe_ld(from + PE_H_FL));
    pe_st(from + PE_H_FL, 0);
    pe_st(from + PE_H_ANY, 0);
}

/// The pool's list of class k (threads that ended) becomes heap h's, whose
/// own is empty; false when the pool has none. Only the class missing: the
/// thread that asks for it (the main thread joining, say) does not take
/// the blocks of the others. (The pool's head is read first without the
/// lock: a hint.)
fn pe_pool_adopt(h: i64, k: i64) -> bool {
    if pe_pool == 0 || pe_ld(pe_pool + PE_H_ANY) == 0 || pe_ld(pe_pool + k * 8) == 0 {
        return false;
    }
    var got: bool = false;
    pe_glock();
    val b: i64 = pe_ld(pe_pool + k * 8);
    if b != 0 && pe_ld(h + k * 8) == 0 {
        var res: i64 = 0;
        var x: i64 = b;
        while x != 0 {
            if (pe_ld(x - 8) & (PE_DECOMMITTED + PE_ZERO)) == 0 {
                res = res + (1 << k);
            }
            x = pe_ld(x);
        }
        pe_st(h + k * 8, b);
        pe_st(pe_pool + k * 8, 0);
        pe_st(pe_pool + PE_H_FL, pe_ld(pe_pool + PE_H_FL) - res);
        pe_st(h + PE_H_FL, pe_ld(h + PE_H_FL) + res);
        var any: i64 = 0;
        var j: i64 = 4;
        while j <= 20 {
            if pe_ld(pe_pool + j * 8) != 0 {
                any = 1;
            }
            j = j + 1;
        }
        pe_st(pe_pool + PE_H_ANY, any);
        got = true;
    }
    pe_gunlock();
    return got;
}

/// The OS thread running this ends (conc.fd pe_thread_main on Linux,
/// win.fd / darwin.fd after their thread's last free): its cached spans
/// are unmapped, the blocks other threads freed to it come onto its lists,
/// its chunk is retired (the rest cut into its lists), its empty chunks
/// unmapped, its lists go to the pool and its heap is abandoned (RT8:
/// kept, with its id, for the frees of its blocks still in use and for the
/// next thread that starts). An allocation on this thread afterwards takes
/// a heap again (pe_heap_attach).
pub fn pe_heap_thread_end() {
    if pe_mt == 0 {
        return;
    }
    val t: i64 = nat_tls_get();
    if t == 0 {
        return;
    }
    val h: i64 = pe_ld(t + PE_TLS_HEAP);
    if h == 0 || h == pe_h0 {
        return;
    }
    if pe_ld(h + PE_H_SPN) != 0 {
        pe_span_purge(h, 0, true);
    }
    pe_rf_drain(h);
    pe_carve_tail(h);
    pe_glock();
    val c: i64 = pe_ld(h + PE_H_BASE);
    if c != 0 {
        pe_chunk_retire(c, pe_ld(h + PE_H_CUR));
    }
    pe_gunlock();
    pe_st(h + PE_H_BASE, 0);
    pe_st(h + PE_H_CUR, 0);
    pe_st(h + PE_H_END, 0);
    if pe_mem_return_on() {
        pe_trim_keep(h, 0, false);
    }
    pe_glock();
    if pe_pool == 0 {
        pe_pool = pe_heap_new(0);
    }
    pe_heap_splice(h, pe_pool);
    pe_st(h + PE_H_STATE, 1);
    pe_st(h + PE_H_NEXT, pe_aband);
    pe_aband = h;
    pe_gunlock();
    pe_st(t + PE_TLS_HEAP, 0);
}

// ─── RT8: the span cache ────────────────────────────────────────────────
// As the C runtime's (codegen_c.fd emit_mem_return_runtime): a large
// block's mapping (over 1 MB) is kept for this thread's next large block,
// zeroed then in the bytes asked for instead of mapped again (fresh pages
// cost a page fault each, several times slower than zeroing them in
// place), only while the thread asks for large blocks often (PE_SPAN_WARM
// in PE_SPAN_WARM_MS): one big block freed now and then is unmapped at
// once, as before. At most PE_SPAN_N spans of PE_SPAN_MAX bytes each and
// PE_SPAN_BYTES in all, per thread; a span not reused within
// PE_SPAN_PURGE_MS is unmapped at the next large block, trim or the
// thread's end. A cached span's header is freed (a second free of its
// block panics). FID_SPAN_CACHE=0 turns it off.

const PE_SPAN_N: i64 = 16;
const PE_SPAN_BYTES: i64 = 67108864;
const PE_SPAN_MAX: i64 = 8388608;
const PE_SPAN_PURGE_MS: i64 = 250;
const PE_SPAN_WARM: i64 = 8;
const PE_SPAN_WARM_MS: i64 = 1000;

var pe_span_on: i64 = 0 - 1;  // 1 on, 0 off (FID_SPAN_CACHE=0), -1 not read yet

/// A millisecond clock (only its differences are used), through heap h's
/// scratch words. On --nat Windows the clock allocates a block itself (it
/// may run a trim: callers have h in order first).
fn pe_ms(h: i64) -> i64 {
    pe_st(h + PE_H_TS, 0);
    pe_st(h + PE_H_TS + 8, 0);
    pe_sys(PE_SYS_CLOCK_GETTIME, 1, h + PE_H_TS, 0);
    return pe_ld(h + PE_H_TS) * 1000 + pe_ld(h + PE_H_TS + 8) / 1000000;
}

/// Cached span i out of heap h's cache (its pages stay).
fn pe_span_drop(h: i64, i: i64) {
    val last: i64 = pe_ld(h + PE_H_SPN) - 1;
    pe_st(h + PE_H_SPB, pe_ld(h + PE_H_SPB) - pe_ld(pe_ld(h + PE_H_SPM + i * 8)));
    pe_st(h + PE_H_SPM + i * 8, pe_ld(h + PE_H_SPM + last * 8));
    pe_st(h + PE_H_SPAT + i * 8, pe_ld(h + PE_H_SPAT + last * 8));
    pe_st(h + PE_H_SPN, last);
}

/// The cached spans not reused for PE_SPAN_PURGE_MS (all: every one) back
/// to the system.
fn pe_span_purge(h: i64, now: i64, all: bool) {
    var i: i64 = 0;
    while i < pe_ld(h + PE_H_SPN) {
        if all || now - pe_ld(h + PE_H_SPAT + i * 8) >= PE_SPAN_PURGE_MS {
            val m: i64 = pe_ld(h + PE_H_SPM + i * 8);
            val s: i64 = pe_ld(m);
            pe_span_drop(h, i);
            pe_sys(PE_SYS_MUNMAP, m, s, 0);
        } else {
            i = i + 1;
        }
    }
}

/// A cached span of at least `span` bytes and at most a quarter more (the
/// smallest), out of the cache; 0 when there is none.
fn pe_span_take(h: i64, span: i64) -> i64 {
    var best: i64 = 0 - 1;
    var bs: i64 = 0;
    var i: i64 = 0;
    val cnt: i64 = pe_ld(h + PE_H_SPN);
    while i < cnt {
        val s: i64 = pe_ld(pe_ld(h + PE_H_SPM + i * 8));
        if s >= span && s - span <= span / 4 && (best < 0 || s < bs) {
            best = i;
            bs = s;
        }
        i = i + 1;
    }
    if best < 0 {
        return 0;
    }
    val m: i64 = pe_ld(h + PE_H_SPM + best * 8);
    pe_span_drop(h, best);
    return m;
}

/// A freed large block's mapping m (m[0]: its size), on heap h: cached when
/// the thread is warm and it fits, else unmapped.
fn pe_span_free(h: i64, m: i64) {
    val span: i64 = pe_ld(m);
    if pe_span_on < 0 {
        val e: i64 = pe_env_raw("FID_SPAN_CACHE" as i64);
        if e != 0 && pe_ldb(e) == 48 && pe_ldb(e + 1) == 0 {
            pe_span_on = 0;
        } else {
            pe_span_on = 1;
        }
    }
    if pe_span_on != 0 {
        val now: i64 = pe_ms(h);
        if pe_ld(h + PE_H_SPN) != 0 {
            pe_span_purge(h, now, false);
        }
        if span <= PE_SPAN_MAX && pe_ld(h + PE_H_BCNT) >= PE_SPAN_WARM && now - pe_ld(h + PE_H_BT0) <= PE_SPAN_WARM_MS {
            // room: the oldest spans go first
            while pe_ld(h + PE_H_SPN) > 0 && (pe_ld(h + PE_H_SPN) >= PE_SPAN_N || pe_ld(h + PE_H_SPB) + span > PE_SPAN_BYTES) {
                var o: i64 = 0;
                var i: i64 = 1;
                while i < pe_ld(h + PE_H_SPN) {
                    if pe_ld(h + PE_H_SPAT + i * 8) < pe_ld(h + PE_H_SPAT + o * 8) {
                        o = i;
                    }
                    i = i + 1;
                }
                val om: i64 = pe_ld(h + PE_H_SPM + o * 8);
                val os: i64 = pe_ld(om);
                pe_span_drop(h, o);
                pe_sys(PE_SYS_MUNMAP, om, os, 0);
            }
            val at: i64 = pe_ld(h + PE_H_SPN);
            if at < PE_SPAN_N {
                pe_st(m + 8, pe_freed() + PE_LARGE);
                pe_st(h + PE_H_SPM + at * 8, m);
                pe_st(h + PE_H_SPAT + at * 8, now);
                pe_st(h + PE_H_SPN, at + 1);
                pe_st(h + PE_H_SPB, pe_ld(h + PE_H_SPB) + span);
                return;
            }
        }
    }
    pe_sys(PE_SYS_MUNMAP, m, span, 0);
}

/// A large block of n bytes (over 1 MB with its header): a mapping of its
/// own, [size][header] then the payload, or a cached span zeroed in the
/// bytes asked for (to 16: nothing reads a block past its size; not at all
/// for pert_malloc_uninit, `zero` false).
fn pe_large_alloc(n: i64, zero: bool) -> i64 {
    var total: i64 = (n + 16 + 4095) & (0 - 4096);
    val h: i64 = pe_heap();
    val now: i64 = pe_ms(h);
    if now - pe_ld(h + PE_H_BT0) > PE_SPAN_WARM_MS {
        pe_st(h + PE_H_BT0, now);
        pe_st(h + PE_H_BCNT, 0);
    }
    pe_st(h + PE_H_BCNT, pe_ld(h + PE_H_BCNT) + 1);
    var big: i64 = 0;
    if pe_ld(h + PE_H_SPN) != 0 {
        big = pe_span_take(h, total);
    }
    if big != 0 {
        total = pe_ld(big);
        // roadmap P12: FID_MEM_LIMIT (sys.fd)
        if lrt_lim_mem != 0 {
            pe_lim_take_mt(total);
        }
        if zero {
            pe_zero(big + 16, (n + 15) & (0 - 16));
        }
    } else {
        if lrt_lim_mem != 0 {
            pe_lim_take_mt(total);
        }
        big = pe_mmap(total);
        pe_st(big, total);
    }
    pe_st(big + 8, pe_magic() + PE_LARGE);
    return big + 16;
}

// ─── RT7: chunks back to the system ─────────────────────────────────────
// Every chunk pe_bump maps is in a table, [base, size, handed-out end,
// live] per chunk (PE_CE bytes), sorted by base; live is 1 while a thread
// bumps blocks out of it (its handed-out end is then that thread's
// PE_H_CUR). pe_free_raw counts the bytes on its thread's lists (PE_H_FL; a
// decommitted block is not counted) and past PE_H_TRIM (8 MB, then what is
// left plus a quarter, at least 8 MB) runs pe_trim: a chunk no thread
// bumps from whose every handed-out byte is on this thread's lists (then
// nothing in it is in use, and no other thread has a block of it: a block
// is on one list at most) has its blocks taken off the lists and is
// unmapped, but the two highest empty ones, for the next blocks. As team
// C's pe_ir allocator and the C runtime. FID_MEM_RETURN=0 turns it off, as
// in the C runtime.

var pe_chunk_tab: i64 = 0;
var pe_chunk_n: i64 = 0;
var pe_chunk_cap: i64 = 0;
var pe_mem_return: i64 = 0 - 1;  // 1 on, 0 off, -1 not read yet

const PE_TRIM_MIN: i64 = 8388608;
const PE_KEEP_FREE_CHUNKS: i64 = 2;
const PE_CE: i64 = 32;

/// A new live chunk in the table (under the heap lock).
fn pe_chunk_add(base: i64, size: i64) {
    if pe_chunk_n == pe_chunk_cap {
        var cap: i64 = pe_chunk_cap * 2;
        if cap < 128 {
            cap = 128;
        }  // 4096 bytes: a page
        val t: i64 = pe_mmap(((cap * PE_CE) + 4095) & (0 - 4096));
        var c: i64 = 0;
        while c < pe_chunk_n * (PE_CE / 8) {
            pe_st(t + c * 8, pe_ld(pe_chunk_tab + c * 8));
            c = c + 1;
        }
        if pe_chunk_tab != 0 {
            pe_sys(PE_SYS_MUNMAP, pe_chunk_tab, ((pe_chunk_cap * PE_CE) + 4095) & (0 - 4096), 0);
        }
        pe_chunk_tab = t;
        pe_chunk_cap = cap;
    }
    // after every entry of a lower base
    var j: i64 = pe_chunk_n;
    while j > 0 && pe_ld(pe_chunk_tab + (j - 1) * PE_CE) > base {
        var w: i64 = 0;
        while w < PE_CE {
            pe_st(pe_chunk_tab + j * PE_CE + w, pe_ld(pe_chunk_tab + (j - 1) * PE_CE + w));
            w = w + 8;
        }
        j = j - 1;
    }
    pe_st(pe_chunk_tab + j * PE_CE, base);
    pe_st(pe_chunk_tab + j * PE_CE + 8, size);
    pe_st(pe_chunk_tab + j * PE_CE + 16, base);
    pe_st(pe_chunk_tab + j * PE_CE + 24, 1);
    pe_chunk_n = pe_chunk_n + 1;
}

/// The handed-out end of the chunk at index i (a live one's: its end)
fn pe_chunk_used(i: i64) -> i64 {
    val e: i64 = pe_chunk_tab + i * PE_CE;
    if pe_ld(e + 24) != 0 {
        return pe_ld(e) + pe_ld(e + 8);
    }
    return pe_ld(e + 16);
}

/// The index of the chunk whose handed-out bytes hold address a; -1
fn pe_chunk_at(a: i64) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = pe_chunk_n - 1;
    var at: i64 = 0 - 1;
    while lo <= hi {
        val mid: i64 = lo + (hi - lo) / 2;
        if pe_ld(pe_chunk_tab + mid * PE_CE) <= a {
            at = mid;
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    if at >= 0 && a < pe_chunk_used(at) {
        return at;
    }
    return 0 - 1;
}

/// The chunk at base stops being a thread's: handed out up to `used`
/// (under the heap lock).
fn pe_chunk_retire(base: i64, used: i64) {
    val i: i64 = pe_chunk_at(base);
    if i >= 0 && pe_ld(pe_chunk_tab + i * PE_CE) == base {
        pe_st(pe_chunk_tab + i * PE_CE + 16, used);
        pe_st(pe_chunk_tab + i * PE_CE + 24, 0);
    }
}

/// Is the chunk at index i, with `free` of its bytes on the lists looked
/// at, empty (and no thread's)?
fn pe_chunk_empty(i: i64, free: i64) -> bool {
    val e: i64 = pe_chunk_tab + i * PE_CE;
    if pe_ld(e + 24) != 0 {
        return false;
    }
    return free == pe_ld(e + 16) - pe_ld(e) - PE_CHUNK_SKIP;
}

fn pe_mem_return_on() -> bool {
    if pe_mem_return < 0 {
        pe_mem_return = 1;
        val e: i64 = pe_env_raw("FID_MEM_RETURN" as i64);
        if e != 0 && pe_ldb(e) == 48 && pe_ldb(e + 1) == 0 {
            pe_mem_return = 0;
        }
    }
    return pe_mem_return != 0;
}

/// Heap h passed its threshold: stale cached spans and empty chunks back to
/// the system, the next threshold.
fn pe_trim(h: i64) {
    // (and no trim inside this one: the clock may allocate, --nat Windows)
    pe_st(h + PE_H_TRIM, 0x7FFFFFFFFFFFFFFF);
    // RT8: the blocks other threads freed to h count as its free ones
    pe_rf_drain(h);
    if pe_ld(h + PE_H_SPN) != 0 {
        pe_span_purge(h, pe_ms(h), false);
    }
    // FID_MEM_RETURN=0: never again
    if !pe_mem_return_on() {
        return;
    }
    pe_trim_keep(h, PE_KEEP_FREE_CHUNKS, true);
    val fl: i64 = pe_ld(h + PE_H_FL);
    var step: i64 = fl / 4;
    if step < PE_TRIM_MIN {
        step = PE_TRIM_MIN;
    }
    pe_st(h + PE_H_TRIM, fl + step);
}

/// The chunks every handed-out byte of which is on heap h's lists, but the
/// `keep` highest, unmapped (their blocks off the lists); `adopt`: the
/// pool's lists become h's first. Takes the heap lock (the table is
/// shared; h's lists are its thread's). Allocates nothing.
fn pe_trim_keep(h: i64, keep: i64, adopt: bool) {
    pe_glock();
    // RT8: the remote frees of ended threads' heaps go with the pool
    if adopt && pe_aband != 0 {
        pe_aband_collect();
    }
    if adopt && pe_pool != 0 && pe_ld(pe_pool + PE_H_ANY) != 0 {
        pe_heap_splice(pe_pool, h);
    }
    val n: i64 = pe_chunk_n;
    if n == 0 {
        pe_gunlock();
        return;
    }
    val fb_size: i64 = ((n * 8) + 4095) & (0 - 4096);
    val fb: i64 = pe_mmap(fb_size);  // zeroed
    // the free bytes of each chunk
    var k: i64 = 4;
    while k <= 20 {
        var b: i64 = pe_ld(h + k * 8);
        while b != 0 {
            val at: i64 = pe_chunk_at(b - 8);
            if at >= 0 {
                pe_st(fb + at * 8, pe_ld(fb + at * 8) + (1 << k));
            }
            b = pe_ld(b);
        }
        k = k + 1;
    }
    // the empty ones (-1 from here: to unmap), but the last `keep`
    var empty: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if pe_chunk_empty(i, pe_ld(fb + i * 8)) {
            empty = empty + 1;
        }
        i = i + 1;
    }
    var drop: i64 = empty - keep;
    i = 0;
    while i < n && drop > 0 {
        if pe_chunk_empty(i, pe_ld(fb + i * 8)) {
            pe_st(fb + i * 8, 0 - 1);
            drop = drop - 1;
        }
        i = i + 1;
    }
    // their blocks off the free lists
    var fl: i64 = pe_ld(h + PE_H_FL);
    k = 4;
    while k <= 20 {
        var prev: i64 = 0;
        var b2: i64 = pe_ld(h + k * 8);
        while b2 != 0 {
            val nx: i64 = pe_ld(b2);
            val at2: i64 = pe_chunk_at(b2 - 8);
            if at2 >= 0 && pe_ld(fb + at2 * 8) < 0 {
                if prev != 0 {
                    pe_st(prev, nx);
                } else {
                    pe_st(h + k * 8, nx);
                }
                if (pe_ld(b2 - 8) & (PE_DECOMMITTED + PE_ZERO)) == 0 {
                    fl = fl - (1 << k);
                }
            } else {
                prev = b2;
            }
            b2 = nx;
        }
        k = k + 1;
    }
    pe_st(h + PE_H_FL, fl);
    // unmapped, out of the table
    var w: i64 = 0;
    i = 0;
    while i < n {
        val e2: i64 = pe_chunk_tab + i * PE_CE;
        if pe_ld(fb + i * 8) < 0 {
            pe_sys(PE_SYS_MUNMAP, pe_ld(e2), pe_ld(e2 + 8), 0);
        } else {
            if w != i {
                var c: i64 = 0;
                while c < PE_CE {
                    pe_st(pe_chunk_tab + w * PE_CE + c, pe_ld(e2 + c));
                    c = c + 8;
                }
            }
            w = w + 1;
        }
        i = i + 1;
    }
    pe_chunk_n = w;
    pe_sys(PE_SYS_MUNMAP, fb, fb_size, 0);
    pe_gunlock();
}

var pe_mt: i64 = 0;  // 1 once threads may run
var pe_heap_lock: i64 = 0;  // *i64
var pe_lim_lock: i64 = 0;  // *i64: FID_MEM_LIMIT's count (sys.fd lrt_lim_used)

/// A spinlock word: 0 free, 1 held.
fn pe_lock(l: i64) {
    while nat_atomic_cas(l, 0, 1) == 0 {
        pe_sys(124, 0, 0, 0);  // sched_yield
    }
}

fn pe_unlock(l: i64) {
    nat_atomic_store(l, 0);
}

/// The heap lock, once threads may run.
fn pe_glock() {
    if pe_mt != 0 {
        pe_lock(pe_heap_lock);
    }
}

fn pe_gunlock() {
    if pe_mt != 0 {
        pe_unlock(pe_heap_lock);
    }
}

/// Before a second thread can start: the locks, and the first thread's
/// block keeps pe_h0 as its heap. Called by the only thread there is.
fn pe_mt_on() {
    if pe_mt == 0 {
        val locks: i64 = pe_mmap(4096);
        pe_heap_lock = locks;
        pe_lim_lock = locks + 64;
        val h: i64 = pe_heap();
        var t: i64 = nat_tls_get();
        if t == 0 {
            t = pe_tls();
        }
        pe_st(t + PE_TLS_HEAP, h);
        pe_mt = 1;
    }
}

/// roadmap P12: FID_MEM_LIMIT's count (sys.fd pe_lim_take / pe_lim_give),
/// under a lock of its own once threads run (the heaps take none). Past the
/// limit one thread reports (pe_lim_take: the message, exit code 125), the
/// others wait for it to end the process; the report runs outside the lock,
/// as printing allocates on some layers (--nat Windows) and an allocation
/// takes the lock again (the reporting thread's own goes through).
fn pe_lim_take_mt(n: i64) {
    if pe_mt == 0 {
        pe_lim_take(n);
        return;
    }
    pe_lock(pe_lim_lock);
    if lrt_lim_used + n <= lrt_lim_mem {
        lrt_lim_used = lrt_lim_used + n;
        pe_unlock(pe_lim_lock);
        return;
    }
    pe_unlock(pe_lim_lock);
    var me: i64 = nat_tls_get();
    if me == 0 {
        me = 1;
    }
    val rep: i64 = pe_lim_lock + 8;
    if nat_atomic_cas(rep, 0, me) == 0 && nat_atomic_load(rep) != me {
        while true {
            pe_sys(124, 0, 0, 0);
        }  // sched_yield until the exit
    }
    pe_lim_take(n);
}

fn pe_lim_give_mt(n: i64) {
    if pe_mt == 0 {
        pe_lim_give(n);
        return;
    }
    pe_lock(pe_lim_lock);
    pe_lim_give(n);
    pe_unlock(pe_lim_lock);
}

/// p_malloc: `size` bytes that read zero. RT8 fast path (one function, no
/// call but nat_tls_get once threads run): a block of up to PE_FAST_MAX
/// bytes off the head of this thread's list of its class (PE_H_CLS),
/// zeroed in the bytes asked for (to 16); anything else is pe_alloc_slow.
/// Written with raw loads and stores, nested ifs and shifts, not pe_ld /
/// pe_st / pe_magic(): the mid-end inlines only what main reaches, which
/// the runtime functions a builtin runs are not, so each of those would
/// stay a call here.
pub fn pert_malloc(size: i64) -> i64 {
    if lrt_mem_mode != 0 {
        return pe_dbg_malloc(size, nat_frame_fp());
    }
    var h: i64 = pe_h0;
    if pe_mt != 0 {
        h = 0;
        val t: i64 = nat_tls_get();
        if t != 0 {
            val tp: *mut i64 = t + PE_TLS_HEAP;
            // SAFETY: NOT checked here: t is this thread's block (pe_tls),
            // at least 96 bytes.
            unsafe {
                h = *tp;
            }
        }
    }
    if h != 0 {
        if lrt_lim_mem == 0 {
            if size >= 0 {
                if size <= PE_FAST_MAX {
                    val cp: *mut u8 = h + PE_H_CLS + ((size + 23) >> 4);
                    var k: i64 = 0;
                    // SAFETY: NOT checked here: a byte of heap h's class
                    // table (index 1..64), PE_H_SIZE bytes of its own.
                    unsafe {
                        k = *cp;
                    }
                    val lp: *mut i64 = h + (k << 3);
                    var b: i64 = 0;
                    // SAFETY: NOT checked here: the head word of h's list
                    // of class k (4..10).
                    unsafe {
                        b = *lp;
                    }
                    if b != 0 {
                        val hp: *mut i64 = b - 8;
                        val bp: *mut i64 = b;
                        val livep: *mut i64 = h + PE_H_LIVE;
                        var was: i64 = 0;
                        // SAFETY: NOT checked here: b is a free block of
                        // h's list: its header and link word are its own.
                        unsafe {
                            was = *hp;
                            *lp = *bp;
                            *hp = *livep + k;
                        }
                        if (was & PE_ZERO) != 0 {
                            // cut from fresh pages (pe_carve_tail): zero
                            // but the link
                            // SAFETY: NOT checked here: b's link word.
                            unsafe {
                                *bp = 0;
                            }
                            return b;
                        }
                        val bs: i64 = 1 << k;
                        val flp: *mut i64 = h + PE_H_FL;
                        // SAFETY: NOT checked here: a word of heap h.
                        unsafe {
                            *flp = *flp - bs;
                        }
                        var zn: i64 = (size + 15) & (0 - 16);
                        if zn > bs - 8 {
                            zn = bs - 8;
                        }
                        val ze: i64 = b + zn;
                        var z: i64 = b;
                        while z + 32 <= ze {
                            var w0: *mut i64 = z;
                            var w1: *mut i64 = z + 8;
                            var w2: *mut i64 = z + 16;
                            var w3: *mut i64 = z + 24;
                            // SAFETY: NOT checked here: z + 32 <= b + zn,
                            // and zn is at most the payload of the block
                            // just taken off the list.
                            unsafe {
                                *w0 = 0;
                                *w1 = 0;
                                *w2 = 0;
                                *w3 = 0;
                            }
                            z = z + 32;
                        }
                        while z < ze {
                            var w: *mut i64 = z;
                            // SAFETY: NOT checked here: as above, z < b +
                            // zn (both multiples of 8 from b).
                            unsafe {
                                *w = 0;
                            }
                            z = z + 8;
                        }
                        return b;
                    }
                }
            }
        }
    }
    return pe_alloc_slow(size, true);
}

/// p_malloc_uninit (RT8): a block exactly as pert_malloc's (the same kind,
/// freed by pert_free, the same --leaks / --checked-alloc / FID_MEM_LIMIT
/// treatment) whose bytes are unspecified: for core's producers that write
/// every byte they hand out (strings, Vec buffers). The fast path is
/// pert_malloc's without the zeroing; a block known zero (fresh pages, a
/// debug block) is handed out as it is.
pub fn pert_malloc_uninit(size: i64) -> i64 {
    if lrt_mem_mode != 0 {
        return pe_dbg_malloc(size, nat_frame_fp());
    }
    var h: i64 = pe_h0;
    if pe_mt != 0 {
        h = 0;
        val t: i64 = nat_tls_get();
        if t != 0 {
            val tp: *mut i64 = t + PE_TLS_HEAP;
            // SAFETY: NOT checked here: as in pert_malloc.
            unsafe {
                h = *tp;
            }
        }
    }
    if h != 0 {
        if lrt_lim_mem == 0 {
            if size >= 0 {
                if size <= PE_FAST_MAX {
                    val cp: *mut u8 = h + PE_H_CLS + ((size + 23) >> 4);
                    var k: i64 = 0;
                    // SAFETY: NOT checked here: as in pert_malloc.
                    unsafe {
                        k = *cp;
                    }
                    val lp: *mut i64 = h + (k << 3);
                    var b: i64 = 0;
                    // SAFETY: NOT checked here: as in pert_malloc.
                    unsafe {
                        b = *lp;
                    }
                    if b != 0 {
                        val hp: *mut i64 = b - 8;
                        val bp: *mut i64 = b;
                        val livep: *mut i64 = h + PE_H_LIVE;
                        var was: i64 = 0;
                        // SAFETY: NOT checked here: as in pert_malloc.
                        unsafe {
                            was = *hp;
                            *lp = *bp;
                            *hp = *livep + k;
                        }
                        if (was & PE_ZERO) == 0 {
                            val flp: *mut i64 = h + PE_H_FL;
                            // SAFETY: NOT checked here: a word of heap h.
                            unsafe {
                                *flp = *flp - (1 << k);
                            }
                        }
                        return b;
                    }
                }
            }
        }
    }
    return pe_alloc_slow(size, false);
}

/// A block of the normal allocator.
fn pe_plain_malloc(n: i64) -> i64 {
    return pe_malloc_raw(n);
}

// ─── RL16: --checked-alloc and --leaks ──────────────────────────────────
// As the C runtime's (codegen_c.fd P_CHECKED_ALLOC / P_LEAKS) and pe_ir's
// (release M7). The backend gives lrt_mem_mode its initial value
// (nat_ir.fd ng_mem_mode): bit 1 `--checked-alloc`, bit 2 `--leaks`, bit
// 4 the memory profile (`--mem`, or FID_MEM_PROFILE=1 at run time: roadmap
// L7C, below pe_leak_report); 0 leaves the allocator as above. A debug
// block is class PE_DBG with 80 bytes before the payload p:
//   p-80 bit 1 when on the leak list, bit 2 when counted by the memory
//   profile   p-72, p-64 where it was allocated (the
//   first two program functions on the stack: names, 0 for none)
//   p-56 its entry in lrt_ck_tab + 1 (--checked-alloc; 0: none)
//   p-48 its mapping or plain block   p-40 the mapping's size (0: plain)
//   p-32, p-24 the leak list's previous and next   p-16 the size asked
//   p-8 the header, PE_MAGIC + PE_DBG
// --checked-alloc: each block has pages of its own, its payload ending at
// an inaccessible page, and a freed block's pages become inaccessible and
// are never reused, so an overrun or a use after free faults (with the
// crash trace) where it happens. --leaks: every block the program asks
// for (the runtime's own, asked for by pe_ / pert_ / nat_ code, are left
// out) is on a list; at exit the blocks still on it are reported, grouped
// by where they were allocated. The list is under the heap lock.

const PE_DBG: i64 = 62;
var lrt_mem_mode: i64 = 0;
var lrt_dbg_head: i64 = 0;
var lrt_dbg_count: i64 = 0;
var lrt_fn_count: i64 = 0;

// CM9 (release M7, as pe_ir's checked fault filter): every --checked-alloc
// block, for the report of a fault on its pages. LRT_CK_ENT bytes per
// block, [mapping, its size, payload, size asked, site, freed, fn 1, fn 2],
// site being the return address of the call to the allocator and fn 1,
// fn 2 the first two program functions on the stack then (the names
// --leaks keeps at p-72 / p-64; 0 for none); in pages of their own,
// outside every block (a freed block's pages are unreadable). Blocks are
// never reused, so an address is in at most one entry's mapping.
const LRT_CK_ENT: i64 = 64;
var lrt_ck_tab: i64 = 0;
var lrt_ck_n: i64 = 0;
var lrt_ck_cap: i64 = 0;

/// Note a checked block (takes the heap lock once threads run); returns
/// its entry's index + 1.
fn pe_ck_note(base: i64, span: i64, p: i64, n: i64, site: i64, fn1: i64, fn2: i64) -> i64 {
    if pe_mt != 0 {
        pe_lock(pe_heap_lock);
    }
    if lrt_ck_n == lrt_ck_cap {
        var cap: i64 = lrt_ck_cap * 2;
        if cap == 0 {
            cap = 1024;
        }
        var t: i64 = pe_mmap(cap * LRT_CK_ENT);
        var i: i64 = 0;
        while i < lrt_ck_n * (LRT_CK_ENT / 8) {
            pe_st(t + i * 8, pe_ld(lrt_ck_tab + i * 8));
            i = i + 1;
        }
        if lrt_ck_tab != 0 {
            pe_sys(PE_SYS_MUNMAP, lrt_ck_tab, lrt_ck_cap * LRT_CK_ENT, 0);
        }
        lrt_ck_tab = t;
        lrt_ck_cap = cap;
    }
    var e: i64 = lrt_ck_tab + lrt_ck_n * LRT_CK_ENT;
    pe_st(e, base);
    pe_st(e + 8, span);
    pe_st(e + 16, p);
    pe_st(e + 24, n);
    pe_st(e + 32, site);
    pe_st(e + 40, 0);
    pe_st(e + 48, fn1);
    pe_st(e + 56, fn2);
    lrt_ck_n = lrt_ck_n + 1;
    var r: i64 = lrt_ck_n;
    if pe_mt != 0 {
        pe_unlock(pe_heap_lock);
    }
    return r;
}

/// CM9: a SIGSEGV / SIGBUS at addr on a checked block's pages — a freed
/// block's, or the guard page after a live one — reported with what the
/// block was, in pe_ir's words (its size, address, the offset accessed and
/// the call that allocated it, here the return address and its function).
/// True when it printed the report; anything else is left to the generic
/// message. Allocates nothing.
fn pe_ck_fault(addr: i64) -> bool {
    if (lrt_mem_mode & 1) == 0 || lrt_ck_tab == 0 || pe_sigbuf == 0 {
        return false;
    }
    var i: i64 = lrt_ck_n - 1;
    while i >= 0 {
        var e: i64 = lrt_ck_tab + i * LRT_CK_ENT;
        var base: i64 = pe_ld(e);
        var span: i64 = pe_ld(e + 8);
        if addr >= base && addr < base + span {
            var p: i64 = pe_ld(e + 16);
            var freed: bool = pe_ld(e + 40) != 0;
            // a live block's own pages are readable: not a fault of this kind
            if !freed && addr < base + span - 4096 {
                return false;
            }
            if freed {
                pert_eprint_str("Panic: Use after free (--checked-alloc): the block of " as i64);
            } else {
                pert_eprint_str("Panic: Access past the end of a block (--checked-alloc): the block of " as i64);
            }
            pe_eprint_int(pe_ld(e + 24));
            pert_eprint_str(" bytes at " as i64);
            pe_eprint_hex(p);
            if freed {
                pert_eprint_str(" was freed" as i64);
            }
            pert_eprint_str("; accessed at offset " as i64);
            pe_eprint_int(addr - p);
            var site: i64 = pe_ld(e + 32);
            if site != 0 {
                pert_eprint_str("; allocated by the call returning to " as i64);
                pe_eprint_hex(site);
                var name: i64 = pe_fn_name_at(site - 4);
                if name != 0 {
                    pert_eprint_str(" in " as i64);
                    pert_eprint_str(name);
                }
            }
            // the allocating program functions (as --leaks names them)
            var fn1: i64 = pe_ld(e + 48);
            var fn2: i64 = pe_ld(e + 56);
            if fn1 != 0 {
                pert_eprint_str("; allocated in " as i64);
                pert_eprint_str(fn1);
                if fn2 != 0 {
                    pert_eprint_str(" <- " as i64);
                    pert_eprint_str(fn2);
                }
            }
            pert_eprint_str("\n" as i64);
            return true;
        }
        i = i - 1;
    }
    return false;
}

/// The function a code address is in (its name, 0 when none), from
/// nat_fn_names' table, as pe_trace_from finds it.
fn pe_fn_name_at(pc: i64) -> i64 {
    var tab: i64 = nat_fn_names();
    if lrt_fn_count == 0 {
        var c: i64 = 0;
        while pe_ld(tab + c * 16 + 8) != 0 {
            c = c + 1;
        }
        lrt_fn_count = c;
    }
    var m: i64 = lrt_fn_count;
    if m == 0 {
        return 0;
    }
    if pc < pe_ld(tab) || pc >= pe_ld(tab + m * 16) {
        return 0;
    }
    var lo: i64 = 0;
    var hi: i64 = m - 1;
    while lo < hi {
        var mid: i64 = (lo + hi + 1) / 2;
        if pe_ld(tab + mid * 16) <= pc {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return pe_ld(tab + lo * 16 + 8);
}

/// The `which`-th (0, 1) program function on the stack from frame fp0
/// (runtime functions skipped), 0 when there is none. Only once the
/// runtime is set up (pe_sigbuf), as for a trace.
fn pe_dbg_site(fp0: i64, which: i64) -> i64 {
    if pe_sigbuf == 0 {
        return 0;
    }
    var fp: i64 = fp0;
    var seen: i64 = 0;
    var steps: i64 = 0;
    while fp != 0 && (fp & 7) == 0 && steps < 64 {
        var name: i64 = pe_fn_name_at(nat_frame_ret(fp) - 4);
        fp = nat_frame_next(fp);
        steps = steps + 1;
        if name != 0 && !pe_is_rt_name(name) {
            if seen == which {
                return name;
            }
            seen = seen + 1;
        }
    }
    return 0;
}

/// Did the program ask for this block (pert_malloc's caller, from the
/// frame fp, is not runtime code)?
fn pe_dbg_from_program(fp: i64) -> bool {
    if pe_sigbuf == 0 || fp == 0 || (fp & 7) != 0 {
        return false;
    }
    var name: i64 = pe_fn_name_at(nat_frame_ret(fp) - 4);
    if name == 0 {
        return false;
    }
    return pe_is_rt_name(name) == false;
}

fn pe_dbg_malloc(size: i64, fp: i64) -> i64 {
    // (a store, so the mid-end does not fold the backend's value away)
    if lrt_mem_mode < 0 {
        lrt_mem_mode = 0;
    }
    var n: i64 = size;
    if n < 0 {
        n = 0;
    }
    var track: bool = false;
    if (lrt_mem_mode & 2) != 0 {
        track = pe_dbg_from_program(fp);
    }
    var checked: bool = (lrt_mem_mode & 1) != 0;
    // L7C: the memory profile counts every block, the runtime's too (the
    // C runtime's --mem does), each by the first program function on the
    // stack (s1 below)
    var prof: bool = (lrt_mem_mode & 4) != 0;
    if !checked && !track && !prof {
        return pe_plain_malloc(n);
    }
    var p: i64 = 0;
    var base: i64 = 0;
    var span: i64 = 0;
    var ck_ix: i64 = 0;
    // the first two program functions on the stack (--leaks' places, and
    // CM9's "allocated in f <- g")
    var s1: i64 = pe_dbg_site(fp, 0);
    var s2: i64 = pe_dbg_site(fp, 1);
    if checked {
        var used: i64 = (n + 15) & (0 - 16);
        span = ((used + 80 + 4095) & (0 - 4096)) + 4096;
        base = pe_mmap(span);
        pe_sys(PE_SYS_MPROTECT, base + span - 4096, 4096, 0);  // the guard page
        p = base + span - 4096 - used;
        // CM9: the return address of the call to the allocator
        var site: i64 = 0;
        if fp != 0 && (fp & 7) == 0 {
            site = nat_frame_ret(fp);
        }
        ck_ix = pe_ck_note(base, span, p, n, site, s1, s2);
    } else {
        base = pe_plain_malloc(n + 80);
        p = base + 80;
    }
    pe_st(p - 80, 0);
    pe_st(p - 72, s1);
    pe_st(p - 64, s2);
    pe_st(p - 56, ck_ix);
    pe_st(p - 48, base);
    pe_st(p - 40, span);
    pe_st(p - 32, 0);
    pe_st(p - 24, 0);
    pe_st(p - 16, n);
    pe_st(p - 8, pe_magic() + PE_DBG);
    if track {
        if pe_mt != 0 {
            pe_lock(pe_heap_lock);
        }
        pe_st(p - 80, 1);
        pe_st(p - 24, lrt_dbg_head);
        if lrt_dbg_head != 0 {
            pe_st(lrt_dbg_head - 32, p);
        }
        lrt_dbg_head = p;
        lrt_dbg_count = lrt_dbg_count + 1;
        if pe_mt != 0 {
            pe_unlock(pe_heap_lock);
        }
    }
    if prof {
        if pe_mt != 0 {
            pe_lock(pe_heap_lock);
        }
        pe_st(p - 80, pe_ld(p - 80) | 2);
        pe_mp_note(s1, n);
        if pe_mt != 0 {
            pe_unlock(pe_heap_lock);
        }
    }
    return p;
}

/// pe_free_raw of a debug block. RT8: the lists it is on (--leaks, the
/// memory profile, CM9's table) are shared: under the heap lock once
/// threads run; the block under it goes back to this thread's heap.
fn pe_dbg_free(p: i64) {
    pe_glock();
    // L7C: a block the memory profile counted is no longer live
    if (pe_ld(p - 80) & 2) != 0 {
        lrt_mp_frees = lrt_mp_frees + 1;
        lrt_mp_freed = lrt_mp_freed + pe_ld(p - 16);
        lrt_mp_live = lrt_mp_live - pe_ld(p - 16);
        pe_st(p - 80, pe_ld(p - 80) & (0 - 3));
    }
    if (pe_ld(p - 80) & 1) != 0 {
        var prev: i64 = pe_ld(p - 32);
        var next: i64 = pe_ld(p - 24);
        if prev != 0 {
            pe_st(prev - 24, next);
        } else {
            lrt_dbg_head = next;
        }
        if next != 0 {
            pe_st(next - 32, prev);
        }
        lrt_dbg_count = lrt_dbg_count - 1;
        pe_st(p - 80, 0);
    }
    pe_st(p - 8, pe_freed() + PE_DBG);
    var base: i64 = pe_ld(p - 48);
    var span: i64 = pe_ld(p - 40);
    // CM9: its entry says freed
    var ck_ix: i64 = pe_ld(p - 56);
    if ck_ix > 0 && ck_ix <= lrt_ck_n {
        pe_st(lrt_ck_tab + (ck_ix - 1) * LRT_CK_ENT + 40, 1);
    }
    pe_gunlock();
    if span > 0 {
        // inaccessible for good, a page at a time (the Windows layer takes
        // a longer PROT_NONE region for a stack guard)
        var a: i64 = base;
        while a < base + span {
            pe_sys(PE_SYS_MPROTECT, a, 4096, 0);
            a = a + 4096;
        }
        return;
    }
    pe_free_raw(base);
}

/// v right-aligned in `width` columns on stderr (v >= 0)
fn pe_eprint_pad(v: i64, width: i64) {
    var digits: i64 = 1;
    var t: i64 = v;
    while t >= 10 {
        t = t / 10;
        digits = digits + 1;
    }
    var k: i64 = digits;
    while k < width {
        pe_write_all(2, " " as i64, 1);
        k = k + 1;
    }
    pe_eprint_int(v);
}

/// --leaks at exit: the blocks never freed, by where they were allocated,
/// the most bytes first (the C runtime's report, __p_mc_report).
fn pe_leak_report() {
    if (lrt_mem_mode & 2) == 0 || pe_sigbuf == 0 {
        return;
    }
    if lrt_dbg_head == 0 {
        pert_eprint_str("fid --leaks: every block was freed\n" as i64);
        return;
    }
    // [site 1, site 2, bytes, blocks] per place, in pages of their own
    var cap: i64 = 256;
    var tab: i64 = pe_mmap(cap * 32);
    var places: i64 = 0;
    var blocks: i64 = 0;
    var bytes: i64 = 0;
    var p: i64 = lrt_dbg_head;
    while p != 0 {
        var sz: i64 = pe_ld(p - 16);
        var s1: i64 = pe_ld(p - 72);
        var s2: i64 = pe_ld(p - 64);
        blocks = blocks + 1;
        bytes = bytes + sz;
        var j: i64 = 0;
        while j < places && (pe_ld(tab + j * 32) != s1 || pe_ld(tab + j * 32 + 8) != s2) {
            j = j + 1;
        }
        if j == places && places < cap {
            pe_st(tab + j * 32, s1);
            pe_st(tab + j * 32 + 8, s2);
            places = places + 1;
        }
        if j < places {
            pe_st(tab + j * 32 + 16, pe_ld(tab + j * 32 + 16) + sz);
            pe_st(tab + j * 32 + 24, pe_ld(tab + j * 32 + 24) + 1);
        }
        p = pe_ld(p - 24);
    }
    pert_eprint_str("fid --leaks: " as i64);
    pe_eprint_int(blocks);
    pert_eprint_str(" block(s), " as i64);
    pe_eprint_int(bytes);
    pert_eprint_str(" bytes, never freed; by where they were allocated:\n" as i64);
    var shown: i64 = 0;
    while shown < 20 && shown < places {
        var best: i64 = 0 - 1;
        var j2: i64 = 0;
        while j2 < places {
            if pe_ld(tab + j2 * 32 + 24) > 0 && (best < 0 || pe_ld(tab + j2 * 32 + 16) > pe_ld(tab + best * 32 + 16)) {
                best = j2;
            }
            j2 = j2 + 1;
        }
        if best < 0 {
            shown = places;
        } else {
            pert_eprint_str("  " as i64);
            pe_eprint_pad(pe_ld(tab + best * 32 + 16), 8);
            pert_eprint_str(" bytes in " as i64);
            pe_eprint_pad(pe_ld(tab + best * 32 + 24), 6);
            pert_eprint_str(" block(s): " as i64);
            var n1: i64 = pe_ld(tab + best * 32);
            var n2: i64 = pe_ld(tab + best * 32 + 8);
            if n1 == 0 {
                pert_eprint_str("(no Fides frame)" as i64);
            } else {
                pert_eprint_str(n1);
                if n2 != 0 {
                    pert_eprint_str(" <- " as i64);
                    pert_eprint_str(n2);
                }
            }
            pert_eprint_str("\n" as i64);
            pe_st(tab + best * 32 + 24, 0 - pe_ld(tab + best * 32 + 24));
            shown = shown + 1;
        }
    }
    if places > 20 {
        pert_eprint_str("  ... and " as i64);
        pe_eprint_int(places - 20);
        pert_eprint_str(" more place(s)\n" as i64);
    }
}

// ─── L7C: the memory profile (`fid run --mem` of the C runtime) ─────────
// With lrt_mem_mode bit 4 (the backend's `--mem`, or FID_MEM_PROFILE set
// and not "0" when the program starts: pe_mp_env) every block is a debug
// block counted here: allocations and bytes, frees, the bytes live and
// their peak, and the bytes each function allocated (the first program
// function on the stack, as --leaks names places; "(no Fides frame)"
// before the runtime is set up). At exit pe_mem_report prints them in the
// C runtime's words (codegen_c.fd __p_mp_report; no lines: native code
// keeps no file:line of a call). Counted under the heap lock once threads
// run. LRT_MP_ENT bytes per function, [name, allocations, bytes], in a
// table of LRT_MP_CAP (pages of its own, open addressing by the name's
// address).
const LRT_MP_ENT: i64 = 24;
const LRT_MP_CAP: i64 = 2048;
var lrt_mp_tab: i64 = 0;
var lrt_mp_used: i64 = 0;
var lrt_mp_allocs: i64 = 0;
var lrt_mp_bytes: i64 = 0;
var lrt_mp_frees: i64 = 0;
var lrt_mp_freed: i64 = 0;
var lrt_mp_live: i64 = 0;
var lrt_mp_peak: i64 = 0;
var lrt_mp_lost: i64 = 0;

/// FID_MEM_PROFILE at start (pe_rt_init): the profile without `--mem`.
fn pe_mp_env() {
    var v: i64 = pe_env_ptr("FID_MEM_PROFILE" as i64);
    if v == 0 {
        return;
    }
    if pe_ldb(v) == 48 && pe_ldb(v + 1) == 0 {
        return;
    }
    lrt_mem_mode = lrt_mem_mode | 4;
}

/// A block of n bytes allocated in function `name` (0: none known).
fn pe_mp_note(name: i64, n: i64) {
    lrt_mp_allocs = lrt_mp_allocs + 1;
    lrt_mp_bytes = lrt_mp_bytes + n;
    lrt_mp_live = lrt_mp_live + n;
    if lrt_mp_live > lrt_mp_peak {
        lrt_mp_peak = lrt_mp_live;
    }
    if lrt_mp_tab == 0 {
        lrt_mp_tab = pe_mmap(LRT_MP_CAP * LRT_MP_ENT);
    }
    // name 0 has the slot whose name word is -1
    var key: i64 = name;
    if key == 0 {
        key = 0 - 1;
    }
    var i: i64 = ((key >> 3) * 40503) & (LRT_MP_CAP - 1);
    var k: i64 = 0;
    while k < LRT_MP_CAP {
        var e: i64 = lrt_mp_tab + i * LRT_MP_ENT;
        var en: i64 = pe_ld(e);
        if en == key {
            pe_st(e + 8, pe_ld(e + 8) + 1);
            pe_st(e + 16, pe_ld(e + 16) + n);
            return;
        }
        if en == 0 {
            if lrt_mp_used * 4 >= LRT_MP_CAP * 3 {
                lrt_mp_lost = lrt_mp_lost + n;
                return;
            }
            pe_st(e, key);
            pe_st(e + 8, 1);
            pe_st(e + 16, n);
            lrt_mp_used = lrt_mp_used + 1;
            return;
        }
        i = i + 1;
        if i == LRT_MP_CAP {
            i = 0;
        }
        k = k + 1;
    }
    lrt_mp_lost = lrt_mp_lost + n;
}

/// The profile at exit (pe_rt_exit, pert_exit): the totals and peak, then
/// up to 20 functions, the most bytes first (then the most allocations).
fn pe_mem_report() {
    if (lrt_mem_mode & 4) == 0 || pe_sigbuf == 0 {
        return;
    }
    // what the program did, before printing: printing allocates on some
    // targets (the Windows layer), and those blocks are not counted
    if pe_mt != 0 {
        pe_lock(pe_heap_lock);
    }
    lrt_mem_mode = lrt_mem_mode & (0 - 5);
    val allocs: i64 = lrt_mp_allocs;
    val bytes: i64 = lrt_mp_bytes;
    val frees: i64 = lrt_mp_frees;
    val freed: i64 = lrt_mp_freed;
    val peak: i64 = lrt_mp_peak;
    if pe_mt != 0 {
        pe_unlock(pe_heap_lock);
    }
    pert_eprint_str("fid --mem: " as i64);
    pe_eprint_int(allocs);
    pert_eprint_str(" allocation(s), " as i64);
    pe_eprint_int(bytes);
    pert_eprint_str(" bytes; " as i64);
    pe_eprint_int(frees);
    pert_eprint_str(" freed (" as i64);
    pe_eprint_int(freed);
    pert_eprint_str(" bytes); peak " as i64);
    pe_eprint_int(peak);
    pert_eprint_str(" bytes live\n" as i64);
    if lrt_mp_tab == 0 {
        return;
    }
    pert_eprint_str("  by function:\n" as i64);
    var shown: i64 = 0;
    var more: bool = true;
    while more && shown < 20 {
        var best: i64 = 0 - 1;
        var i: i64 = 0;
        while i < LRT_MP_CAP {
            var e: i64 = lrt_mp_tab + i * LRT_MP_ENT;
            if pe_ld(e) != 0 && pe_ld(e + 8) > 0 {
                if best < 0 {
                    best = i;
                } else {
                    var b: i64 = lrt_mp_tab + best * LRT_MP_ENT;
                    if pe_ld(e + 16) > pe_ld(b + 16) || (pe_ld(e + 16) == pe_ld(b + 16) && pe_ld(e + 8) > pe_ld(b + 8)) {
                        best = i;
                    }
                }
            }
            i = i + 1;
        }
        if best < 0 {
            more = false;
        } else {
            var be: i64 = lrt_mp_tab + best * LRT_MP_ENT;
            pert_eprint_str("  " as i64);
            pe_eprint_pad(pe_ld(be + 16), 10);
            pert_eprint_str(" bytes in " as i64);
            pe_eprint_pad(pe_ld(be + 8), 6);
            pert_eprint_str(" allocation(s): " as i64);
            var nm: i64 = pe_ld(be);
            if nm == 0 - 1 {
                pert_eprint_str("(no Fides frame)" as i64);
            } else {
                pert_eprint_str(nm);
            }
            pert_eprint_str("\n" as i64);
            // shown: its count negative, so it is not picked again
            pe_st(be + 8, 0 - pe_ld(be + 8));
            shown = shown + 1;
        }
    }
    if lrt_mp_used > 20 {
        pert_eprint_str("  ... and " as i64);
        pe_eprint_int(lrt_mp_used - 20);
        pert_eprint_str(" more\n" as i64);
    }
    if lrt_mp_lost > 0 {
        pert_eprint_str("  (" as i64);
        pe_eprint_int(lrt_mp_lost);
        pert_eprint_str(" bytes from places past the table)\n" as i64);
    }
}

/// A zeroed block of the normal allocator (no debug block).
fn pe_malloc_raw(size: i64) -> i64 {
    return pe_alloc_slow(size, true);
}

/// RT8: a block from this thread's heap, no lock: the head of its list of
/// the class, else the blocks other threads freed to it, else the pool's
/// list (threads that ended), else bumped out of its chunk (before a new
/// chunk: the remote frees to heaps of threads that ended, through the
/// pool); a large one (pe_large_alloc) of its own mapping or the span
/// cache. Zeroed in the bytes asked for when `zero` (pert_malloc), as it is
/// otherwise (pert_malloc_uninit).
fn pe_alloc_slow(size: i64, zero: bool) -> i64 {
    var n: i64 = size;
    if n < 0 {
        n = 0;
    }
    var need: i64 = n + 8;
    if need > 1048576 {
        return pe_large_alloc(n, zero);
    }
    val h: i64 = pe_heap();
    var k: i64 = 11;
    if need <= 1024 {
        k = pe_ldb(h + PE_H_CLS + ((need + 15) >> 4));
    } else {
        while (1 << k) < need {
            k = k + 1;
        }
    }
    val bs: i64 = 1 << k;
    // roadmap P12: FID_MEM_LIMIT (sys.fd)
    if lrt_lim_mem != 0 {
        pe_lim_take_mt(bs);
    }
    var head: i64 = pe_ld(h + k * 8);
    if head == 0 && pe_ld(h + PE_H_RF) != 0 {
        pe_rf_drain(h);
        head = pe_ld(h + k * 8);
    }
    if head == 0 {
        if pe_pool != 0 && pe_pool_adopt(h, k) {
            head = pe_ld(h + k * 8);
        }
        if head == 0 {
            val cur: i64 = pe_ld(h + PE_H_CUR);
            if pe_aband != 0 && (cur == 0 || cur + bs > pe_ld(h + PE_H_END)) {
                // a new chunk next: first what was freed to ended threads
                pe_glock();
                pe_aband_collect();
                pe_gunlock();
                if pe_pool_adopt(h, k) {
                    head = pe_ld(h + k * 8);
                }
            }
        }
        if head == 0 {
            var b: i64 = pe_bump(h, bs);
            pe_st(b, pe_ld(h + PE_H_LIVE) + k);
            return b + 8;
        }
    }
    val was: i64 = pe_ld(head - 8);
    pe_st(h + k * 8, pe_ld(head));
    pe_st(head - 8, pe_ld(h + PE_H_LIVE) + k);
    if (was & PE_DECOMMITTED) != 0 {
        // RT7: its inside pages are fresh zero pages: clear around them
        if zero {
            val lo: i64 = pe_page_lo(head);
            val hi: i64 = pe_page_hi(head, bs);
            pe_zero(head, lo - head);
            pe_zero(hi, head - 8 + bs - hi);
        }
    } else if (was & PE_ZERO) != 0 {
        // RT8: cut from fresh pages (pe_carve_tail): zero but the link
        if zero {
            pe_st(head, 0);
        }
    } else {
        // RT8: the bytes asked for (to 16), not the whole class, as the
        // C runtime: nothing reads a block past its size
        pe_st(h + PE_H_FL, pe_ld(h + PE_H_FL) - bs);
        if zero {
            var zn: i64 = (n + 15) & (0 - 16);
            if zn > bs - 8 {
                zn = bs - 8;
            }
            pe_zero(head, zn);
        }
    }
    return head;
}

pub fn pert_alloc(size: i64) -> i64 {
    if lrt_mem_mode != 0 {
        return pe_dbg_malloc(size, nat_frame_fp());
    }
    return pert_malloc(size);
}

/// p_free. RT8 fast path (one function, as pert_malloc's, raw loads and
/// stores): a block this thread's heap handed out (its header is the
/// heap's PE_H_LIVE plus its class: one compare) of a class not decommitted
/// on free goes on the head of the heap's list; anything else is
/// pe_free_raw.
pub fn pert_free(p: i64) {
    if p == 0 {
        return;
    }
    var h: i64 = pe_h0;
    if pe_mt != 0 {
        h = 0;
        val t: i64 = nat_tls_get();
        if t != 0 {
            val tp: *mut i64 = t + PE_TLS_HEAP;
            // SAFETY: NOT checked here: as in pert_malloc.
            unsafe {
                h = *tp;
            }
        }
    }
    if h != 0 {
        if lrt_lim_mem == 0 {
            val hp: *mut i64 = p - 8;
            val livep: *mut i64 = h + PE_H_LIVE;
            var hd: i64 = 0;
            var live: i64 = 0;
            // SAFETY: NOT checked here: p is a block the program frees: the
            // word before it is its header (pe_free_raw panics on anything
            // else; a block's header word is always mapped, PE_CHUNK_SKIP).
            unsafe {
                hd = *hp;
                live = *livep;
            }
            val k: i64 = hd & 255;
            if hd - k == live {
                if k < PE_DECOMMIT_K {
                    val lp: *mut i64 = h + (k << 3);
                    val bp: *mut i64 = p;
                    val flp: *mut i64 = h + PE_H_FL;
                    val trp: *mut i64 = h + PE_H_TRIM;
                    var fl: i64 = 0;
                    var trim: i64 = 0;
                    // SAFETY: NOT checked here: p is this heap's block of
                    // class k (its header said so): header, link word; the
                    // list head and counts are words of heap h.
                    unsafe {
                        *hp = PE_FREED_MAGIC + k;
                        *bp = *lp;
                        *lp = p;
                        fl = *flp + (1 << k);
                        *flp = fl;
                        trim = *trp;
                    }
                    // RT7: past the threshold, empty chunks go back to the
                    // system
                    if fl > trim {
                        pe_trim(h);
                    }
                    return;
                }
            }
        }
    }
    pe_free_raw(p);
}

/// RT8: a block of this thread's heap onto its lists, no lock; another
/// heap's onto that heap's remote-free list (owner return); a large block
/// to this thread's span cache or the system.
fn pe_free_raw(p: i64) {
    var hd: i64 = pe_ld(p - 8);
    var low: i64 = hd & 4294967295;
    var magic: i64 = hd - low;
    if magic == pe_freed() {
        pert_panic("Double free" as i64);
    }
    if magic != pe_magic() {
        pert_panic("Invalid free: not an allocated block" as i64);
    }
    var k: i64 = low & 255;
    if k == PE_DBG {
        pe_dbg_free(p);
        return;
    }
    if k == PE_LARGE {
        if lrt_lim_mem != 0 {
            pe_lim_give_mt(pe_ld(p - 16));
        }
        pe_span_free(pe_heap(), p - 16);
        return;
    }
    val owner: i64 = pe_heap_owner(low >> 8);
    if owner == 0 || k < 4 || k > 20 {
        pert_panic("Invalid free: not an allocated block" as i64);
    }
    // roadmap P12: FID_MEM_LIMIT (sys.fd)
    if lrt_lim_mem != 0 {
        pe_lim_give_mt(1 << k);
    }
    var mark: i64 = 0;
    if k >= PE_DECOMMIT_K && pe_decommit(p, 1 << k) {
        mark = PE_DECOMMITTED;
    }
    pe_st(p - 8, pe_freed() + k + mark);
    val h: i64 = pe_heap();
    if owner != h {
        // another thread's block: back to the heap that handed it out
        pe_rf_push(owner, p);
        return;
    }
    pe_st(p, pe_ld(h + k * 8));
    pe_st(h + k * 8, p);
    // RT7: past the threshold, empty chunks go back to the system
    if mark == 0 {
        val fl: i64 = pe_ld(h + PE_H_FL) + (1 << k);
        pe_st(h + PE_H_FL, fl);
        if fl > pe_ld(h + PE_H_TRIM) {
            pe_trim(h);
        }
    }
}

// RT7: a freed block of 256 KB or more gives its inside pages back to the
// system (large blocks, over 1 MB, are unmapped): a fresh mapping over them
// (mmap MAP_FIXED, the call every OS layer has: Linux drops the old pages,
// win.fd decommits and commits again, darwin.fd maps over, wasi.fd says
// ENOSYS and the block keeps its pages). The block's header and link word
// stay; PE_DECOMMITTED in its freed header says the pages read zero, so a
// reuse clears only the bytes around them.
const PE_DECOMMIT_K: i64 = 18;
const PE_DECOMMITTED: i64 = 64;
// RT8: a free block cut from a chunk's fresh pages (pe_carve_tail)
const PE_ZERO: i64 = 128;

// The range is aligned to 64 KB, a multiple of every page size these
// targets have (4 KB; 16 KB on Apple Silicon and some AArch64 Linux; 64 KB
// on others): a page-unaligned MAP_FIXED fails, and a length that is not a
// whole number of pages would be rounded up over the next block.
const PE_DECOMMIT_ALIGN: i64 = 65536;

/// The first 64 KB boundary after block p's link word
fn pe_page_lo(p: i64) -> i64 {
    return (p + 8 + PE_DECOMMIT_ALIGN - 1) & (0 - PE_DECOMMIT_ALIGN);
}

/// The last 64 KB boundary inside block p of `size` bytes (header included)
fn pe_page_hi(p: i64, size: i64) -> i64 {
    return (p - 8 + size) & (0 - PE_DECOMMIT_ALIGN);
}

fn pe_decommit(p: i64, size: i64) -> bool {
    val lo: i64 = pe_page_lo(p);
    val hi: i64 = pe_page_hi(p, size);
    if hi - lo < PE_DECOMMIT_ALIGN {
        return false;
    }
    // PROT_READ|WRITE, MAP_PRIVATE|MAP_ANONYMOUS|MAP_FIXED
    val r: i64 = nat_syscall(PE_SYS_MMAP, lo, hi - lo, 3, 50, 0 - 1, 0);
    return r == lo;
}

/// RT7: the bytes of the process in physical memory: the second field of
/// /proc/self/statm (resident pages, 4096 bytes each here), -1 where there
/// is no such file (the macOS and WASI layers). On --nat Windows, the
/// working set (win.fd pe_win_mem_resident).
pub fn pert_mem_resident() -> i64 {
    if nat_os() == 1 {
        return nat_syscall(1014, 0, 0, 0, 0, 0, 0);
    }
    val fd: i64 = pe_open("/proc/self/statm" as i64, 0);
    if fd < 0 {
        return 0 - 1;
    }
    val buf: i64 = pert_malloc(128);
    val n: i64 = pe_sys(PE_SYS_READ, fd, buf, 127);
    pe_sys(PE_SYS_CLOSE, fd, 0, 0);
    var i: i64 = 0;
    while i < n && pe_ldb(buf + i) != 32 {
        i = i + 1;
    }
    i = i + 1;
    var pages: i64 = 0;
    var digits: i64 = 0;
    while i < n && pe_ldb(buf + i) >= 48 && pe_ldb(buf + i) <= 57 {
        pages = pages * 10 + (pe_ldb(buf + i) - 48);
        digits = digits + 1;
        i = i + 1;
    }
    pert_free(buf);
    if digits == 0 {
        return 0 - 1;
    }
    return pages * 4096;
}

// ─── Output and exit ────────────────────────────────────────────────────

fn pe_write_all(fd: i64, buf: i64, n: i64) {
    var at: i64 = buf;
    var left: i64 = n;
    while left > 0 {
        var w: i64 = pe_sys(PE_SYS_WRITE, fd, at, left);
        if w <= 0 {
            return;
        }
        at = at + w;
        left = left - w;
    }
}

/// The length of a string: its header's (core's length-headered strings),
/// else up to its NUL.
fn pe_len(s: i64) -> i64 {
    if s == 0 {
        return 0;
    }
    var h: i64 = p_str_hdr_len(s);
    if h >= 0 {
        return h;
    }
    var n: i64 = 0;
    while pe_ldb(s + n) != 0 {
        n = n + 1;
    }
    return n;
}

pub fn pert_print_str(s: i64) {
    if s == 0 {
        return;
    }
    pe_write_all(1, s, pe_len(s));
}

pub fn pert_eprint_str(s: i64) {
    if s == 0 {
        return;
    }
    pe_write_all(2, s, pe_len(s));
}

pub fn pert_print_newline() {
    pe_write_all(1, "\n" as i64, 1);
}

pub fn pert_print_int(v: i64) {
    var buf: i64 = pert_malloc(32);
    var n: i64 = pe_int_digits(v, buf);
    pe_write_all(1, buf, n);
    pert_free(buf);
}

pub fn pert_print_bool(b: bool) {
    if b {
        pe_write_all(1, "true" as i64, 4);
    } else {
        pe_write_all(1, "false" as i64, 5);
    }
}

pub fn pert_print_float(val: f64) {
    var s: i64 = pert_to_str_float(val) as i64;
    pert_print_str(s);
    p_str_free(s);
}

pub fn pert_flush_stdout() {
}

pub fn pert_panic(msg: i64) {
    pe_write_all(2, "Panic: " as i64, 7);
    pert_eprint_str(msg);
    pe_write_all(2, "\n" as i64, 1);
    // CE8: -g: the failing frame's values before the trace
    pe_dbg_frame_print(nat_frame_fp());
    pe_trace_from(nat_frame_fp());
    // CA9: the tasks the panicking one runs for (conc.fd)
    pe_co_print_chain(2);
    // CO9: FID_CRASH_REPORT=<file>: the same in a report `fid inspect` reads
    pe_crash_report(msg, nat_frame_fp());
    pe_sys(PE_SYS_EXIT_GROUP, 1, 0, 0);
}

pub fn pert_exit(code: i64) {
    // roadmap P6: rank 0 waits for the other ranks (pe_runtime/tensor.fd)
    val tp_code: i64 = pert_tp_exit(code);
    pe_prof_report();
    pe_leak_report();
    pe_mem_report();
    pe_sys(PE_SYS_EXIT_GROUP, tp_code, 0, 0);
}

/// Exit immediately without running the entry-point cleanup a second time.
pub fn pert_exit_now(code: i64) {
    pe_sys(PE_SYS_EXIT_GROUP, code, 0, 0);
}

/// main's return (nat_ir.fd's Linux `_start` calls it with main's
/// result): the profiler's report (sys.fd, DB9), --leaks' report (RL16),
/// then exit_group.
pub fn pe_rt_exit(code: i64) {
    // roadmap P6: rank 0 waits for the other ranks, and fails when one did
    // (pe_runtime/tensor.fd pert_tp_exit)
    val tp_code: i64 = pert_tp_exit(code);
    pe_prof_report();
    pe_leak_report();
    // L7C: the memory profile (--mem / FID_MEM_PROFILE)
    pe_mem_report();
    pe_sys(PE_SYS_EXIT_GROUP, tp_code, 0, 0);
}

// ─── Each thread's block, signals, traces ───────────────────────────────
// The thread pointer (nat_tls_get) holds the thread's block: [0] the task
// running on it, [8] its signal stack, [16, 24) its stack's guard region,
// [32] its table of TLS keys, [40] its stack, [48] the stack's size, [56]
// scratch for the scheduler, [64] its own address (x86-64 reads the block
// through fs: fs:[64]), [72] its worker index + 1 on a task worker (its
// run-queue ring, conc.fd RT10), else 0, [80] the token slot of the code
// outside tasks on this thread (conc.fd "Token slot", CA7/CA8), [88] its
// heap (RT8, "Per-thread heaps"; 0 until its first allocation).

const PE_SYS_FUTEX: i64 = 98;
const PE_SYS_SIGALTSTACK: i64 = 132;
const PE_SYS_RT_SIGACTION: i64 = 134;
const PE_SYS_MPROTECT: i64 = 226;
const PE_GUARD: i64 = 65536;

fn pe_tls_new(glo: i64, ghi: i64) -> i64 {
    var t: i64 = pert_malloc(96);
    pe_zero(t, 96);
    pe_st(t + 64, t);
    pe_st(t + 16, glo);
    pe_st(t + 24, ghi);
    return t;
}

/// This thread's block (made the first time a thread without one asks).
fn pe_tls() -> i64 {
    var t: i64 = nat_tls_get();
    // RT8: once threads run, a thread's first allocation gives it a block
    // (pe_heap_attach) and keeps its heap there
    if t == 0 && pe_mt != 0 {
        pe_heap();
        t = nat_tls_get();
    }
    if t == 0 {
        t = pe_tls_new(0, 0);
        nat_tls_set(t);
    }
    return t;
}

/// A stack for the signal handler, so it runs when the stack overflowed.
fn pe_altstack_on(t: i64) {
    var ss: i64 = pe_mmap(65536);
    var st: i64 = pert_malloc(24);
    pe_st(st, ss);
    pe_st(st + 8, 0);
    pe_st(st + 16, 65536);
    pe_sys(PE_SYS_SIGALTSTACK, st, 0, 0);
    pert_free(st);
    pe_st(t + 8, ss);
}

fn pe_altstack_off(t: i64) {
    var ss: i64 = pe_ld(t + 8);
    if ss == 0 {
        return;
    }
    var st: i64 = pert_malloc(24);
    pe_st(st, 0);
    pe_st(st + 8, 2);  // SS_DISABLE
    pe_st(st + 16, 0);
    pe_sys(PE_SYS_SIGALTSTACK, st, 0, 0);
    pert_free(st);
    pe_sys(PE_SYS_MUNMAP, ss, 65536, 0);
    pe_st(t + 8, 0);
}

/// Sleep while the 32-bit word at addr holds val, at most ms (< 0: no
/// limit). `private`: a word only this process waits on.
fn pe_futex_wait(addr: i64, val: i64, ms: i64, private: bool) {
    var op: i64 = 0;
    if private {
        op = 128;
    }
    if ms < 0 {
        nat_syscall(PE_SYS_FUTEX, addr, op, val, 0, 0, 0);
        return;
    }
    var ts: i64 = pert_malloc(16);
    pe_st(ts, ms / 1000);
    pe_st(ts + 8, (ms % 1000) * 1000000);
    nat_syscall(PE_SYS_FUTEX, addr, op, val, ts, 0, 0);
    pert_free(ts);
}

/// Wake up to n waiters of a private futex word.
fn pe_futex_wake(addr: i64, n: i64) {
    nat_syscall(PE_SYS_FUTEX, addr, 129, n, 0, 0, 0);
}

var pe_sig_flags: i64 = 0;  // [0, 64): arrived; [64, 128): registered
var pe_sigbuf: i64 = 0;

fn pe_sig_install(sig: i64) -> i64 {
    var act: i64 = pert_malloc(32);
    pe_zero(act, 32);
    pe_st(act, nat_sig_handler());
    pe_st(act + 8, 134217732);  // SA_SIGINFO | SA_ONSTACK
    // x86-64 returns from a handler through the restorer it is given
    var restorer: i64 = nat_sig_restorer();
    if restorer != 0 {
        pe_st(act + 8, 134217732 | 67108864);  // | SA_RESTORER
        pe_st(act + 16, restorer);
    }
    var r: i64 = nat_syscall(PE_SYS_RT_SIGACTION, sig, act, 0, 8, 0, 0);
    pert_free(act);
    return r;
}

/// Before main: this thread's block, its signal stack, the crash handler
/// (SIGSEGV, SIGBUS, SIGFPE, SIGILL, SIGTRAP).
/// How far below the start sp a fault of the main thread is a stack
/// overflow (pe_on_signal): 64 MB, more once pe_main_stack_raise (sys.fd)
/// let the stack grow further.
var pe_main_stack_win: i64 = 67108864;

pub fn pe_rt_init() {
    // SP16: room for the deep recursion of the compiler built natively
    pe_main_stack_raise();
    var t: i64 = pe_tls_new(0, 0);
    nat_tls_set(t);
    pe_altstack_on(t);
    pe_sigbuf = pert_malloc(32);
    pe_sig_flags = pert_malloc(1024);
    pe_zero(pe_sig_flags, 1024);
    pe_sig_install(11);
    pe_sig_install(7);
    pe_sig_install(8);
    pe_sig_install(4);
    pe_sig_install(5);
    // roadmap P12: FID_MEM_LIMIT / FID_CPU_LIMIT (sys.fd)
    pe_lim_init();
    // FID_PROF: the sampling profiler (sys.fd, DB9)
    pe_prof_start();
    // L7C: FID_MEM_PROFILE, the memory profile without --mem
    pe_mp_env();
}

fn pe_eprint_int(v: i64) {
    pe_fd_int(2, v);
}

/// v in decimal on file descriptor fd (stderr, or a crash report: CO9),
/// allocating nothing.
fn pe_fd_int(fd: i64, v: i64) {
    var n: i64 = pe_int_digits(v, pe_sigbuf);
    pe_write_all(fd, pe_sigbuf, n);
}

/// `0x` and v in lowercase hex on stderr (as C's %p), allocating nothing.
fn pe_eprint_hex(v: i64) {
    pe_fd_hex(2, v);
}

/// pe_eprint_hex on file descriptor fd (CO9: a crash report too).
fn pe_fd_hex(fd: i64, v: i64) {
    pe_stb(pe_sigbuf, 48);
    pe_stb(pe_sigbuf + 1, 120);
    var n: i64 = 2;
    var started: bool = false;
    var i: i64 = 15;
    while i >= 0 {
        var d: i64 = (v >> (i * 4)) & 15;
        if d != 0 || started || i == 0 {
            started = true;
            if d < 10 {
                pe_stb(pe_sigbuf + n, 48 + d);
            } else {
                pe_stb(pe_sigbuf + n, 87 + d);
            }
            n = n + 1;
        }
        i = i - 1;
    }
    pe_write_all(fd, pe_sigbuf, n);
}

/// The signal handler (nat_sig_handler): a registered signal is noted
/// (p_signal_check); anything else is a panic like any other (reference
/// §8.2, the same text on every backend): "Panic: Stack overflow" when the
/// address is in a guard region, "Panic: Invalid memory access (null or
/// dangling pointer) at 0x..." for another SIGSEGV or SIGBUS, else
/// "Panic: signal N (NAME)"; then the trace and exit status 1. Allocates
/// nothing.
pub fn pe_on_signal(sig: i64, info: i64) {
    // roadmap P12: FID_CPU_LIMIT's SIGXCPU (sys.fd pe_lim_init)
    if sig == PE_SIGXCPU && lrt_lim_cpu_msg != 0 {
        pe_lim_cpu_over();
    }
    if sig >= 0 && sig < 64 && pe_sig_flags != 0 && pe_ld(pe_sig_flags + 512 + sig * 8) != 0 {
        pe_st(pe_sig_flags + sig * 8, 1);
        return;
    }
    var addr: i64 = pe_ld(info + 16);
    var over: bool = false;
    if sig == 11 || sig == 7 {
        var t: i64 = nat_tls_get();
        if t != 0 {
            var cur: i64 = pe_ld(t);
            if cur != 0 {
                var base: i64 = pe_ld(cur + 120);
                if base != 0 && addr >= base && addr < base + PE_GUARD {
                    over = true;
                }
            }
            var glo: i64 = pe_ld(t + 16);
            var ghi: i64 = pe_ld(t + 24);
            if glo != 0 && addr >= glo && addr < ghi {
                over = true;
            }
            if glo == 0 && cur == 0 {
                var top: i64 = nat_start_sp();
                if addr < top && addr >= top - pe_main_stack_win {
                    over = true;
                }
            }
        }
    }
    // CM9: a fault on a --checked-alloc block's pages says what the block was
    var ck: bool = false;
    if !over && (sig == 11 || sig == 7) {
        ck = pe_ck_fault(addr);
    }
    if over {
        pert_eprint_str("Panic: Stack overflow\n" as i64);
    } else if ck {
    // (pe_ck_fault printed it)
    } else if sig == 11 || sig == 7 {
        pert_eprint_str("Panic: Invalid memory access (null or dangling pointer) at " as i64);
        pe_eprint_hex(addr);
        pert_eprint_str("\n" as i64);
    } else {
        pert_eprint_str("Panic: signal " as i64);
        pe_eprint_int(sig);
        if sig == 6 {
            pert_eprint_str(" (SIGABRT)\n" as i64);
        } else if sig == 8 {
            pert_eprint_str(" (SIGFPE)\n" as i64);
        } else {
            pert_eprint_str(" (UNKNOWN)\n" as i64);
        }
    }
    // CE8: -g: the values of the frame the trace starts at (as the C
    // backend: an invalid access, not a stack overflow)
    if !over && (sig == 11 || sig == 7) {
        pe_dbg_frame_print(nat_frame_fp());
    }
    pe_trace_from(nat_frame_fp());
    // CA9: the tasks the faulting one runs for (conc.fd)
    pe_co_print_chain(2);
    // CO9: FID_CRASH_REPORT=<file>: the same in a report `fid inspect` reads
    var rfd: i64 = pe_crash_open();
    if rfd >= 0 {
        pe_fd_str(rfd, "message: " as i64);
        if over {
            pe_fd_str(rfd, "Stack overflow" as i64);
        } else if sig == 11 || sig == 7 {
            if ck {
                pe_fd_str(rfd, "Invalid memory access of a --checked-alloc block at " as i64);
            } else {
                pe_fd_str(rfd, "Invalid memory access (null or dangling pointer) at " as i64);
            }
            pe_fd_hex(rfd, addr);
        } else {
            pe_fd_str(rfd, "signal " as i64);
            pe_fd_int(rfd, sig);
            if sig == 6 {
                pe_fd_str(rfd, " (SIGABRT)" as i64);
            } else if sig == 8 {
                pe_fd_str(rfd, " (SIGFPE)" as i64);
            } else {
                pe_fd_str(rfd, " (UNKNOWN)" as i64);
            }
        }
        pe_fd_str(rfd, "\n" as i64);
        pe_crash_close(rfd, nat_frame_fp());
    }
    pe_sys(PE_SYS_EXIT_GROUP, 1, 0, 0);
}

/// The Linux signal handlers' entry (nat_ir.fd ng_sig_fn passes the
/// ucontext too): a SIGPROF of the profiler is one sample (sys.fd
/// pe_prof_tick, DB9; one arriving after the report is dropped), anything
/// else goes to pe_on_signal.
pub fn pe_on_signal_uc(sig: i64, info: i64, uc: i64) {
    if sig == 27 && pe_prof_m != 0 {
        pe_prof_tick(uc);
        return;
    }
    // SIGUSR2 with the profiler on: a report of the running program (SL15)
    if sig == 12 && pe_prof_m != 0 {
        pe_prof_request();
        return;
    }
    pe_on_signal(sig, info);
}

/// A runtime function's name (pe_, pert_, nat_, lrt_): not shown in
/// traces, and its blocks are not the program's (RL16 --leaks: the
/// runtime's own tables, e.g. lrt_sens_table's, are not leaks).
fn pe_is_rt_name(n: i64) -> bool {
    if pe_ldb(n) == 112 && pe_ldb(n + 1) == 101 {
        if pe_ldb(n + 2) == 95 {
            return true;
        }
        if pe_ldb(n + 2) == 114 && pe_ldb(n + 3) == 116 && pe_ldb(n + 4) == 95 {
            return true;
        }
    }
    if pe_ldb(n) == 108 && pe_ldb(n + 1) == 114 && pe_ldb(n + 2) == 116 && pe_ldb(n + 3) == 95 {
        return true;
    }
    return pe_ldb(n) == 110 && pe_ldb(n + 1) == 97 && pe_ldb(n + 2) == 116 && pe_ldb(n + 3) == 95;
}

fn pe_trace_flush(fd: i64, name: i64, reps: i64) {
    if name == 0 {
        return;
    }
    pe_fd_str(fd, "    -| called from " as i64);
    pe_fd_str(fd, name);
    if reps > 1 {
        pe_fd_str(fd, " (" as i64);
        pe_fd_int(fd, reps);
        pe_fd_str(fd, " times)" as i64);
    }
    pe_fd_str(fd, "\n" as i64);
}

/// String s on file descriptor fd (pert_eprint_str's fd 2, or a crash
/// report: CO9). Allocates nothing.
fn pe_fd_str(fd: i64, s: i64) {
    if s == 0 {
        return;
    }
    pe_write_all(fd, s, pe_len(s));
}

/// The C backend's panic trace, from the frame records (nat_frame_ret,
/// nat_frame_next) and the function table (nat_fn_names): each frame named
/// by the function its return address is in, runtime functions left out,
/// repeats counted. Allocates nothing.
fn pe_trace_from(fp0: i64) {
    pe_trace_to(2, fp0, true);
}

/// pe_trace_from on file descriptor fd; `head`: the "stack trace:" line
/// first (a crash report has its own "trace:" line, CO9).
fn pe_trace_to(fd: i64, fp0: i64, head: bool) {
    if pe_sigbuf == 0 {
        return;
    }
    var tab: i64 = nat_fn_names();
    var m: i64 = 0;
    while pe_ld(tab + m * 16 + 8) != 0 {
        m = m + 1;
    }
    if m == 0 {
        return;
    }
    var lo_code: i64 = pe_ld(tab);
    var end_code: i64 = pe_ld(tab + m * 16);
    var fp: i64 = fp0;
    var k: i64 = 0;
    var shown: bool = false;
    var last: i64 = 0;
    var reps: i64 = 0;
    while fp != 0 && (fp & 7) == 0 && k < 256 {
        var pc: i64 = nat_frame_ret(fp) - 4;
        fp = nat_frame_next(fp);
        k = k + 1;
        if pc >= lo_code && pc < end_code {
            var lo: i64 = 0;
            var hi: i64 = m - 1;
            while lo < hi {
                var mid: i64 = (lo + hi + 1) / 2;
                if pe_ld(tab + mid * 16) <= pc {
                    lo = mid;
                } else {
                    hi = mid - 1;
                }
            }
            var name: i64 = pe_ld(tab + lo * 16 + 8);
            if !pe_is_rt_name(name) {
                if !shown {
                    if head {
                        pe_fd_str(fd, "stack trace:\n" as i64);
                    }
                    pe_fd_str(fd, "    - " as i64);
                    pe_fd_str(fd, name);
                    pe_fd_str(fd, "\n" as i64);
                    shown = true;
                } else if last != 0 && pert_str_equal(name, last) {
                    reps = reps + 1;
                } else {
                    pe_trace_flush(fd, last, reps);
                    last = name;
                    reps = 1;
                }
            }
        }
    }
    pe_trace_flush(fd, last, reps);
}

// ─── CO9: crash reports ─────────────────────────────────────────────────
// With FID_CRASH_REPORT=<file> in the environment, a panic (pert_panic) or
// a crash (pe_on_signal: a fault, a stack overflow, a signal) also writes
// a report there, in the format of `fid run --crash-file` (compiler/
// interp.fd interp_crash_report_text) and of programs built through C
// (codegen_c.fd __p_crash_report), which `fid inspect <file>` prints:
//   fid-crash-report 1
//   version: <the fid that built the program> (native)
//   program: <argv[0]>
//   message: <a line of the panic message>     (one per line of it)
//   trace:
//   <pe_trace_to's lines, innermost call first>
//   end
// Allocates nothing on Linux (the --nat Windows layer's open converts the
// path); a fault while writing it ends the program without a second report.

/// The fid that made this runtime's programs: compiler/build_info.fd
/// fid_version (keep the two in step), "(native)" as the C path says "(C)".
fn pe_crash_version() -> i64 {
    return "fid 1.0.0+dev (native)" as i64;
}

/// 1 once a report was started: a fault while writing one writes no other.
var lrt_crash_busy: i64 = 0;

/// The length of the NUL-ended text at s (an argument or an environment
/// string: no header before it to read).
fn pe_cstr_len(s: i64) -> i64 {
    var n: i64 = 0;
    while pe_ldb(s + n) != 0 {
        n = n + 1;
    }
    return n;
}

/// The value of environment variable `name` (a literal): the address of
/// its text in the environment block (nat_start_sp's layout), 0 when it
/// is not set or empty. Allocates nothing (pert_getenv copies it).
fn pe_env_ptr(name: i64) -> i64 {
    var sp: i64 = nat_start_sp();
    if sp == 0 {
        return 0;
    }
    var at: i64 = sp + 8 + (pe_ld(sp) + 1) * 8;
    var n: i64 = pe_len(name);
    while pe_ld(at) != 0 {
        var e: i64 = pe_ld(at);
        var j: i64 = 0;
        while j < n && pe_ldb(e + j) == pe_ldb(name + j) {
            j = j + 1;
        }
        if j == n && pe_ldb(e + n) == 61 {
            if pe_ldb(e + n + 1) == 0 {
                return 0;
            }
            return e + n + 1;
        }
        at = at + 8;
    }
    return 0;
}

/// CO9: the report's file, opened with its head written (version and
/// program), or -1: FID_CRASH_REPORT not set, the file cannot be written
/// (stderr says so), or a report was started already.
fn pe_crash_open() -> i64 {
    if lrt_crash_busy != 0 || pe_sigbuf == 0 {
        return 0 - 1;
    }
    lrt_crash_busy = 1;
    var path: i64 = pe_env_ptr("FID_CRASH_REPORT" as i64);
    if path == 0 {
        return 0 - 1;
    }
    var fd: i64 = pe_open(path, 577);  // WRONLY|CREAT|TRUNC
    if fd < 0 {
        pe_fd_str(2, "crash report: cannot write " as i64);
        pe_write_all(2, path, pe_cstr_len(path));
        pe_fd_str(2, "\n" as i64);
        return 0 - 1;
    }
    pe_fd_str(fd, "fid-crash-report 1\nversion: " as i64);
    pe_fd_str(fd, pe_crash_version());
    pe_fd_str(fd, "\nprogram: " as i64);
    var sp: i64 = nat_start_sp();
    var arg0: i64 = 0;
    if sp != 0 && pe_ld(sp) > 0 {
        arg0 = pe_ld(sp + 8);
    }
    if arg0 != 0 {
        pe_write_all(fd, arg0, pe_cstr_len(arg0));
    } else {
        pe_fd_str(fd, "(unknown)" as i64);
    }
    pe_fd_str(fd, "\n" as i64);
    return fd;
}

/// CO9: the report's end: the trace from frame fp0, "end", the file
/// closed; stderr says where it is.
fn pe_crash_close(fd: i64, fp0: i64) {
    pe_fd_str(fd, "trace:\n" as i64);
    pe_trace_to(fd, fp0, false);
    pe_fd_str(fd, "end\n" as i64);
    pe_sys(PE_SYS_CLOSE, fd, 0, 0);
    var path: i64 = pe_env_ptr("FID_CRASH_REPORT" as i64);
    if path == 0 {
        return;
    }
    var pn: i64 = pe_cstr_len(path);
    pe_fd_str(2, "crash report: " as i64);
    pe_write_all(2, path, pn);
    pe_fd_str(2, " (read it with: fid inspect " as i64);
    pe_write_all(2, path, pn);
    pe_fd_str(2, ")\n" as i64);
}

/// CO9: the report of panic `msg` (a "message:" line per line of it, a CR
/// before a newline left out) with the trace from frame fp0, when
/// FID_CRASH_REPORT asks for one.
fn pe_crash_report(msg: i64, fp0: i64) {
    var fd: i64 = pe_crash_open();
    if fd < 0 {
        return;
    }
    var n: i64 = 0;
    if msg != 0 {
        n = pe_len(msg);
    }
    var at: i64 = 0;
    while true {
        var e: i64 = at;
        while e < n && pe_ldb(msg + e) != 10 {
            e = e + 1;
        }
        var len: i64 = e - at;
        if len > 0 && pe_ldb(msg + at + len - 1) == 13 {
            len = len - 1;
        }
        pe_fd_str(fd, "message: " as i64);
        if len > 0 {
            pe_write_all(fd, msg + at, len);
        }
        pe_fd_str(fd, "\n" as i64);
        if e >= n {
            break;
        }
        at = e + 1;
    }
    pe_crash_close(fd, fp0);
}

// ─── CE8: the failing frame's values (`fid emit -g`) ────────────────────
// nat_ir.fd ng_dbg_frames_data writes, right after the function table's
// [end of code, 0]: [PE_DBG_FRAMES_MAGIC, frames], frames one word per
// function of that table: 0, or the address of its record [code size, n,
// then n entries of [name, kind, place, value]] (kind: the C backend's
// letter, codegen_c.fd cg_dbg_kind; place 1: the word at CFA + value, 2:
// the constant value). A panic prints them as `fid ccompile -g` does
// (codegen_c.fd __p_dbg_print_frame): "values in <fn>:" and one line per
// variable, before the trace. Allocates nothing.

const PE_DBG_FRAMES_MAGIC: i64 = 0x464944464D455331;
/// 1 once the values are being printed: a fault while reading them does
/// not print them again.
var lrt_dbg_frames_busy: i64 = 0;

/// The frames array of the image's frame table, 0 when it has none (a
/// build without -g). `tab` is nat_fn_names(), `m` its function count.
fn pe_dbg_frames_tab(tab: i64, m: i64) -> i64 {
    if pe_ld(tab + m * 16 + 16) != PE_DBG_FRAMES_MAGIC {
        return 0;
    }
    return pe_ld(tab + m * 16 + 24);
}

/// The CFA of the frame whose frame pointer is fp: x86-64 and AArch64
/// keep the frame record [fp, return address] 16 bytes under it, RISC-V's
/// s0 is the CFA itself (nat_ir.fd ng_cfi_saves, nat_frame_ret).
fn pe_dbg_cfa(fp: i64) -> i64 {
    if nat_arch() == 2 {
        return fp;
    }
    return fp + 16;
}

/// One byte on stderr.
fn pe_dbg_ech(c: i64) {
    pe_stb(pe_sigbuf, c);
    pe_write_all(2, pe_sigbuf, 1);
}

/// v as an unsigned 64-bit number in decimal.
fn pe_dbg_eprint_u64(v: i64) {
    if v >= 0 {
        pe_eprint_int(v);
        return;
    }
    // v = 2h + b unsigned, h = 5q + s: v / 10 = q, v % 10 = 2s + b
    var h: i64 = (v >> 1) & 0x7FFFFFFFFFFFFFFF;
    pe_eprint_int(h / 5);
    pe_dbg_ech(48 + 2 * (h % 5) + (v & 1));
}

/// The low `bits` bits of v as a signed number.
fn pe_dbg_sext(v: i64, bits: i64) -> i64 {
    var top: i64 = 1 << (bits - 1);
    if (v & top) != 0 {
        return v - (top << 1);
    }
    return v;
}

/// "." and f as `w` digits (leading zeros kept, trailing ones dropped);
/// nothing when f is 0.
fn pe_dbg_frac(f0: i64, w0: i64) {
    var f: i64 = f0;
    var w: i64 = w0;
    if f == 0 || w <= 0 {
        return;
    }
    while f % 10 == 0 {
        f = f / 10;
        w = w - 1;
    }
    pe_dbg_ech(46);
    var p: i64 = 1;
    var i: i64 = 1;
    while i < w {
        p = p * 10;
        i = i + 1;
    }
    while p > 0 {
        pe_dbg_ech(48 + (f / p) % 10);
        p = p / 10;
    }
}

/// The f64 with bits b as C's %g prints it (six significant digits).
fn pe_dbg_eprint_f64(b: i64) {
    if b < 0 {
        pe_dbg_ech(45);
    }
    var ab: i64 = b & 0x7FFFFFFFFFFFFFFF;
    if (ab >> 52) == 0x7FF {
        if (ab & 0xFFFFFFFFFFFFF) != 0 {
            pert_eprint_str("nan" as i64);
        } else {
            pert_eprint_str("inf" as i64);
        }
        return;
    }
    if ab == 0 {
        pe_dbg_ech(48);
        return;
    }
    var x: f64 = p_f64_from_bits(ab);
    var e: i64 = 0;
    while x >= 10.0 {
        x = x / 10.0;
        e = e + 1;
    }
    while x < 1.0 {
        x = x * 10.0;
        e = e - 1;
    }
    var d: i64 = (x * 100000.0 + 0.5) as i64;
    if d >= 1000000 {
        d = (d + 5) / 10;
        e = e + 1;
    }
    if e < 0 - 4 || e >= 6 {
        pe_dbg_ech(48 + d / 100000);
        pe_dbg_frac(d % 100000, 5);
        pe_dbg_ech(101);
        var ee: i64 = e;
        if ee < 0 {
            pe_dbg_ech(45);
            ee = 0 - ee;
        } else {
            pe_dbg_ech(43);
        }
        if ee < 10 {
            pe_dbg_ech(48);
        }
        pe_eprint_int(ee);
        return;
    }
    var p: i64 = 1;
    var i: i64 = 0;
    while i < 5 - e {
        p = p * 10;
        i = i + 1;
    }
    pe_eprint_int(d / p);
    pe_dbg_frac(d % p, 5 - e);
}

/// The f64 bits of the f32 with bits b0 (exact: every f32 is an f64).
fn pe_dbg_f32_bits(b0: i64) -> i64 {
    var b: i64 = b0 & 0xFFFFFFFF;
    var one: i64 = 1;
    var sign: i64 = 0;
    if ((b >> 31) & 1) != 0 {
        sign = one << 63;
    }
    var ex: i64 = (b >> 23) & 0xFF;
    var mt: i64 = b & 0x7FFFFF;
    if ex == 0xFF {
        return sign | (0x7FF << 52) | (mt << 29);
    }
    if ex == 0 {
        if mt == 0 {
            return sign;
        }
        // a subnormal f32 is a normal f64
        var e: i64 = 0 - 126;
        while mt < 0x800000 {
            mt = mt << 1;
            e = e - 1;
        }
        return sign | ((e + 1023) << 52) | ((mt & 0x7FFFFF) << 29);
    }
    return sign | ((ex - 127 + 1023) << 52) | (mt << 29);
}

/// A str variable: its text in quotes (at most 60 bytes, then "..."),
/// "(null)", or "<pointer 0x...>" for a pointer without a string header.
fn pe_dbg_eprint_str(s: i64) {
    if s == 0 {
        pert_eprint_str("(null)" as i64);
        return;
    }
    var l: i64 = p_str_hdr_len(s);
    if l < 0 {
        pert_eprint_str("<pointer " as i64);
        pe_eprint_hex(s);
        pe_dbg_ech(62);
        return;
    }
    var n: i64 = l;
    if n > 60 {
        n = 60;
    }
    pe_dbg_ech(34);
    pe_write_all(2, s, n);
    pe_dbg_ech(34);
    if l > 60 {
        pert_eprint_str("..." as i64);
    }
}

/// The word v of a variable of kind `kind` (cg_dbg_kind's letters).
fn pe_dbg_eprint_value(kind: i64, v: i64) {
    if kind == 105 {
        pe_eprint_int(v);
    } else if kind == 117 {
        pe_dbg_eprint_u64(v);
    } else if kind == 52 {
        pe_eprint_int(pe_dbg_sext(v & 0xFFFFFFFF, 32));
    } else if kind == 85 {
        pe_eprint_int(v & 0xFFFFFFFF);
    } else if kind == 50 {
        pe_eprint_int(pe_dbg_sext(v & 0xFFFF, 16));
    } else if kind == 119 {
        pe_eprint_int(v & 0xFFFF);
    } else if kind == 49 {
        pe_eprint_int(pe_dbg_sext(v & 0xFF, 8));
    } else if kind == 99 {
        pe_eprint_int(v & 0xFF);
    } else if kind == 98 {
        if (v & 0xFF) != 0 {
            pert_eprint_str("true" as i64);
        } else {
            pert_eprint_str("false" as i64);
        }
    } else if kind == 100 {
        pe_dbg_eprint_f64(v);
    } else if kind == 102 {
        pe_dbg_eprint_f64(pe_dbg_f32_bits(v));
    } else if kind == 115 {
        pe_dbg_eprint_str(v);
    }
}

/// "values in <fn>:" and the variables of record `rec` of the frame whose
/// CFA is cfa.
fn pe_dbg_frame_values(name: i64, rec: i64, cfa: i64) {
    pert_eprint_str("values in " as i64);
    pert_eprint_str(name);
    pert_eprint_str(":\n" as i64);
    var n: i64 = pe_ld(rec + 8);
    if n == 0 {
        pert_eprint_str("    (no word-sized parameters or locals)\n" as i64);
    }
    var i: i64 = 0;
    while i < n && i < 32 {
        var e: i64 = rec + 16 + i * 32;
        var nm: i64 = pe_ld(e);
        var kind: i64 = pe_ld(e + 8);
        var place: i64 = pe_ld(e + 16);
        var v: i64 = pe_ld(e + 24);
        if nm != 0 && (place == 1 || place == 2) {
            if place == 1 {
                v = pe_ld(cfa + v);
            }
            pert_eprint_str("    " as i64);
            pert_eprint_str(nm);
            pert_eprint_str(" = " as i64);
            pe_dbg_eprint_value(kind, v);
            pert_eprint_str("\n" as i64);
        }
        i = i + 1;
    }
}

/// CE8: the values of the failing frame, from frame fp0 up: the first
/// program function on the stack (runtime functions skipped, as in the
/// trace) whose code holds the return address and which has a record.
/// Nothing without a frame table (no -g) or before the runtime is set up.
pub fn pe_dbg_frame_print(fp0: i64) {
    if pe_sigbuf == 0 || lrt_dbg_frames_busy != 0 {
        return;
    }
    var tab: i64 = nat_fn_names();
    var m: i64 = 0;
    while pe_ld(tab + m * 16 + 8) != 0 {
        m = m + 1;
    }
    if m == 0 {
        return;
    }
    var frames: i64 = pe_dbg_frames_tab(tab, m);
    if frames == 0 {
        return;
    }
    lrt_dbg_frames_busy = 1;
    var lo_code: i64 = pe_ld(tab);
    var end_code: i64 = pe_ld(tab + m * 16);
    var fp: i64 = fp0;
    var k: i64 = 0;
    while fp != 0 && (fp & 7) == 0 && k < 256 {
        var pc: i64 = nat_frame_ret(fp) - 4;
        // the frame of the function pc is in
        fp = nat_frame_next(fp);
        k = k + 1;
        if fp != 0 && pc >= lo_code && pc < end_code {
            var lo: i64 = 0;
            var hi: i64 = m - 1;
            while lo < hi {
                var mid: i64 = (lo + hi + 1) / 2;
                if pe_ld(tab + mid * 16) <= pc {
                    lo = mid;
                } else {
                    hi = mid - 1;
                }
            }
            var name: i64 = pe_ld(tab + lo * 16 + 8);
            var rec: i64 = pe_ld(frames + lo * 8);
            // (a panic stub after the function's code is not the function)
            if rec != 0 && !pe_is_rt_name(name) && pc < pe_ld(tab + lo * 16) + pe_ld(rec) {
                pe_dbg_frame_values(name, rec, pe_dbg_cfa(fp));
                return;
            }
        }
    }
}

// ─── Strings ────────────────────────────────────────────────────────────

/// A new length-headered string of n bytes (NUL after them).
fn pe_new_str(n: i64) -> i64 {
    var r: i64 = p_str_alloc(n);
    pe_stb(r + n, 0);
    return r;
}

fn pe_dup(s: i64) -> i64 {
    var n: i64 = pe_len(s);
    var r: i64 = pe_new_str(n);
    pe_copy(r, s, n);
    return r;
}

fn pe_dup_range(s: i64, from: i64, n: i64) -> i64 {
    var r: i64 = pe_new_str(n);
    pe_copy(r, s + from, n);
    return r;
}

// ─── OP23: the 16-byte block routines ────────────────────────────────────
// Each works on the first n & ~15 bytes of its n (whole 16-byte blocks)
// and returns how far it got; its callers below finish the bytes left.
// The bodies are word loops. They are the place a vector loop goes:
// compiler/nat_ir.fd may lower a call of one, by its name, to SSE2/AVX2,
// NEON or RVV code with the same result, as it lowers the simd module's
// simd_lanes_* functions (ng_simd_call). Callers pass 8-byte-aligned
// addresses (RISC-V's vle64/vse64 and word loads need them; x86-64 and
// AArch64 vector loads take any address). The words are read through
// pointers, not pe_ld: a call per word made them 3x slower.

/// Copies the first n & ~15 bytes at src to dst (the areas do not
/// overlap); returns that count.
pub fn pert_vblk_copy(dst: i64, src: i64, n: i64) -> i64 {
    var m: i64 = n & (0 - 16);
    var off: i64 = 0;
    while off < m {
        var s1: *mut i64 = src + off;
        var s2: *mut i64 = src + off + 8;
        var d1: *mut i64 = dst + off;
        var d2: *mut i64 = dst + off + 8;
        // SAFETY: off + 16 <= m <= n, both addresses 8-aligned: two words
        // of the n bytes the caller vouches for at src and at dst.
        unsafe {
            *d1 = *s1;
            *d2 = *s2;
        }
        off = off + 16;
    }
    return m;
}

/// The offset of the first 16-byte block, among the first n & ~15 bytes,
/// in which a and b differ; n & ~15 when none does.
pub fn pert_vblk_diff(a: i64, b: i64, n: i64) -> i64 {
    var m: i64 = n & (0 - 16);
    var off: i64 = 0;
    while off < m {
        var a1: *mut i64 = a + off;
        var a2: *mut i64 = a + off + 8;
        var b1: *mut i64 = b + off;
        var b2: *mut i64 = b + off + 8;
        var x1: i64 = 0;
        var x2: i64 = 0;
        var y1: i64 = 0;
        var y2: i64 = 0;
        // SAFETY: off + 16 <= m <= n, both 8-aligned: two words of the n
        // bytes at a and at b.
        unsafe {
            x1 = *a1;
            x2 = *a2;
            y1 = *b1;
            y2 = *b2;
        }
        if ((x1 ^ y1) | (x2 ^ y2)) != 0 {
            return off;
        }
        off = off + 16;
    }
    return m;
}

/// The offset of the first 16-byte block, among the first n & ~15 bytes,
/// in which a and b differ or a holds a zero byte; n & ~15 when none does
/// (string compare: core's loop stops at a's first NUL).
@wrapping
pub fn pert_vblk_cmpz(a: i64, b: i64, n: i64) -> i64 {
    var m: i64 = n & (0 - 16);
    var lo: i64 = 0x0101010101010101;
    var hi: i64 = 0 - 0x7F7F7F7F7F7F7F80;
    var off: i64 = 0;
    while off < m {
        var a1: *mut i64 = a + off;
        var a2: *mut i64 = a + off + 8;
        var b1: *mut i64 = b + off;
        var b2: *mut i64 = b + off + 8;
        var x1: i64 = 0;
        var x2: i64 = 0;
        var y1: i64 = 0;
        var y2: i64 = 0;
        // SAFETY: off + 16 <= m <= n, both 8-aligned: two words of the n
        // bytes at a and at b.
        unsafe {
            x1 = *a1;
            x2 = *a2;
            y1 = *b1;
            y2 = *b2;
        }
        if ((x1 ^ y1) | (x2 ^ y2) | ((((x1 - lo) & (0 - x1 - 1)) | ((x2 - lo) & (0 - x2 - 1))) & hi)) != 0 {
            return off;
        }
        off = off + 16;
    }
    return m;
}

/// The offset of the first 16-byte block, among the first n & ~15 bytes at
/// p, that holds the byte b & 255; n & ~15 when none does. (A word w holds
/// it when ((w ^ rep) - 0x0101...) & ~(w ^ rep) & 0x8080... is not zero;
/// the test can only err towards a block that does hold it.)
@wrapping
pub fn pert_vblk_find(p: i64, n: i64, b: i64) -> i64 {
    var m: i64 = n & (0 - 16);
    var lo: i64 = 0x0101010101010101;
    var hi: i64 = 0 - 0x7F7F7F7F7F7F7F80;
    var rep: i64 = (b & 255) * lo;
    var off: i64 = 0;
    while off < m {
        var p1: *mut i64 = p + off;
        var p2: *mut i64 = p + off + 8;
        var w1: i64 = 0;
        var w2: i64 = 0;
        // SAFETY: off + 16 <= m <= n, p 8-aligned: two words of the n
        // bytes at p.
        unsafe {
            w1 = *p1;
            w2 = *p2;
        }
        var x1: i64 = w1 ^ rep;
        var x2: i64 = w2 ^ rep;
        if ((((x1 - lo) & (0 - x1 - 1)) | ((x2 - lo) & (0 - x2 - 1))) & hi) != 0 {
            return off;
        }
        off = off + 16;
    }
    return m;
}

// Core's copy, compare and byte search, a word at a time where both
// addresses are aligned (competitive roadmap OP23; RISC-V traps on
// misaligned words), a byte at a time for the rest.
pub fn pert_mem_copy(dst: i64, src: i64, n: i64) {
    var off: i64 = 0;
    if ((dst ^ src) & 7) == 0 {
        // OP23: equally misaligned: bytes up to dst's word boundary, then
        // 16-byte blocks (pert_vblk_copy), then words (both addresses
        // aligned from there on)
        while off < n && ((dst + off) & 7) != 0 {
            pe_stb(dst + off, pe_ldb(src + off));
            off = off + 1;
        }
        if n - off >= 16 {
            off = off + pert_vblk_copy(dst + off, src + off, n - off);
        }
        while off + 8 <= n {
            var s8: *mut i64 = src + off;
            var d8: *mut i64 = dst + off;
            // SAFETY: off + 8 <= n and both addresses 8-aligned: a word of
            // the n bytes core's caller vouches for at src and at dst.
            unsafe {
                *d8 = *s8;
            }
            off = off + 8;
        }
    }
    while off < n {
        var s1: *mut u8 = src + off;
        var d1: *mut u8 = dst + off;
        // SAFETY: off < n: a byte of the n bytes at src and at dst.
        unsafe {
            *d1 = *s1;
        }
        off = off + 1;
    }
}

pub fn pert_str_copy_n(dst: i64, src: i64, n: i64) {
    pert_mem_copy(dst, src, n);
}

pub fn pert_bytes_eq(a: i64, b: i64, n: i64) -> bool {
    var off: i64 = 0;
    if ((a ^ b) & 7) == 0 {
        // OP23: equally misaligned: bytes up to a's word boundary first
        while off < n && ((a + off) & 7) != 0 {
            if pe_ldb(a + off) != pe_ldb(b + off) {
                return false;
            }
            off = off + 1;
        }
        // then 16-byte blocks (pert_vblk_diff), then words
        if n - off >= 16 {
            var left: i64 = n - off;
            var d: i64 = pert_vblk_diff(a + off, b + off, left);
            if d < (left & (0 - 16)) {
                return false;
            }
            off = off + d;
        }
        while off + 8 <= n {
            var a8: *mut i64 = a + off;
            var b8: *mut i64 = b + off;
            var x: i64 = 0;
            var y: i64 = 0;
            // SAFETY: off + 8 <= n, both 8-aligned: a word of the n bytes at a
            // and at b.
            unsafe {
                x = *a8;
                y = *b8;
            }
            if x != y {
                return false;
            }
            off = off + 8;
        }
    }
    while off < n {
        var a1: *mut u8 = a + off;
        var b1: *mut u8 = b + off;
        var xb: i64 = 0;
        var yb: i64 = 0;
        // SAFETY: off < n: a byte of the n bytes at a and at b.
        unsafe {
            xb = *a1;
            yb = *b1;
        }
        if xb != yb {
            return false;
        }
        off = off + 1;
    }
    return true;
}

/// memchr: eight bytes per step once aligned (a word holds `b` when
/// ((w ^ bbbb...) - 0x0101...) & ~(w ^ bbbb...) & 0x8080... is not zero).
@wrapping
pub fn pert_mem_find_byte(p: i64, n: i64, b: i64) -> i64 {
    var i: i64 = 0;
    while i < n && ((p + i) & 7) != 0 {
        var hp: *mut u8 = p + i;
        var hx: i64 = 0;
        // SAFETY: i < n: a byte of the n bytes at p.
        unsafe {
            hx = *hp;
        }
        if hx == b {
            return i;
        }
        i = i + 1;
    }
    var lo: i64 = 0x0101010101010101;
    var hi: i64 = 0 - 0x7F7F7F7F7F7F7F80;
    var rep: i64 = (b & 255) * lo;
    var scanning: bool = true;
    // 16-byte blocks (pert_vblk_find): the block that holds b is searched
    // byte by byte, from its start
    if n - i >= 16 {
        var left: i64 = n - i;
        var f: i64 = pert_vblk_find(p + i, left, b);
        if f < (left & (0 - 16)) {
            return pert_mem_find_byte_tail(p, n, b, i + f);
        }
        i = i + f;
    }
    while scanning && i + 8 <= n {
        var wp: *mut i64 = p + i;
        var w: i64 = 0;
        // SAFETY: i + 8 <= n and p + i 8-aligned: a word of the n bytes at p.
        unsafe {
            w = *wp;
        }
        var x: i64 = w ^ rep;
        // a zero byte in x is a match in w: stop, the tail finds which
        if ((x - lo) & (0 - x - 1) & hi) != 0 {
            scanning = false;
        } else {
            i = i + 8;
        }
    }
    // the bytes left, and the word that held a match, one by one
    return pert_mem_find_byte_tail(p, n, b, i);
}

fn pert_mem_find_byte_tail(p: i64, n: i64, b: i64, from: i64) -> i64 {
    var j: i64 = from;
    while j < n {
        var tp: *mut u8 = p + j;
        var tx: i64 = 0;
        // SAFETY: j < n: a byte of the n bytes at p.
        unsafe {
            tx = *tp;
        }
        if tx == b {
            return j;
        }
        j = j + 1;
    }
    return -1;
}

pub fn pert_str_concat(a: i64, b: i64) -> i64 {
    var la: i64 = pe_len(a);
    var lb: i64 = pe_len(b);
    var r: i64 = pe_new_str(la + lb);
    if la > 0 {
        pe_copy(r, a, la);
    }
    if lb > 0 {
        pe_copy(r + la, b, lb);
    }
    return r;
}

/// The decimal digits of v into buf (at least 21 bytes); returns their count.
fn pe_int_digits(v: i64, buf: i64) -> i64 {
    var tmp: i64 = buf + 31;
    var n: i64 = 0;
    // Work on the negative value: -MIN does not fit
    var x: i64 = v;
    if x > 0 {
        x = 0 - x;
    }
    if x == 0 {
        pe_stb(buf, 48);
        return 1;
    }
    while x != 0 {
        var d: i64 = 0 - (x % 10);
        tmp = tmp - 1;
        pe_stb(tmp, 48 + d);
        n = n + 1;
        x = x / 10;
    }
    var at: i64 = 0;
    if v < 0 {
        pe_stb(buf, 45);
        at = 1;
    }
    var i: i64 = 0;
    while i < n {
        pe_stb(buf + at + i, pe_ldb(tmp + i));
        i = i + 1;
    }
    return at + n;
}

pub fn pert_to_str(v: i64) -> str {
    var buf: i64 = pert_malloc(48);
    var n: i64 = pe_int_digits(v, buf);
    var r: i64 = pe_dup_range(buf, 0, n);
    pert_free(buf);
    return r;
}

pub fn pert_to_str_bool(b: bool) -> str {
    if b {
        return pe_dup("true" as i64);
    }
    return pe_dup("false" as i64);
}

pub fn pert_bool_to_str(b: bool) -> str {
    return pert_to_str_bool(b);
}

pub fn pert_to_str_str(s: i64) -> str {
    return pe_dup(s);
}

/// One byte (the low 8 bits of c), as the C runtime's p_char_to_str, pe_ir
/// and the interpreter make it: StringBuilder.append_char of decoded
/// bytes must give those bytes back, not each one as a code point.
/// RT3: the 256 one-byte strings are static, laid out as literals are
/// ([P_STR_STATIC][1] byte NUL, 24 bytes each), made once and never freed
/// (dropping a static string does nothing), so this and core's one-byte
/// slices never allocate, as on the C path (codegen_c.fd __p_chr1).
var lrt_chr1: i64 = 0;
const LRT_STR_STATIC: i64 = 0x4649444553545202;  // core's P_STR_STATIC

pub fn pert_char_to_str(c: i64) -> str {
    var t: i64 = lrt_chr1;
    if t == 0 {
        t = pert_malloc(256 * 24);
        var i: i64 = 0;
        while i < 256 {
            pe_st(t + i * 24, LRT_STR_STATIC);
            pe_st(t + i * 24 + 8, 1);
            pe_st(t + i * 24 + 16, i);  // the byte, its NUL, zero padding
            i = i + 1;
        }
        // two threads may both build one; either table stays valid
        lrt_chr1 = t;
    }
    return t + (c & 255) * 24 + 16;
}

pub fn pert_to_str_vec(v: i64) -> str {
    return Vec_to_str(v);
}

pub fn pert_print_vec(v: i64) {
    var s: i64 = Vec_to_str(v) as i64;
    pert_print_str(s);
    p_str_free(s);
}

pub fn pert_print_map(m: i64) {
    var s: i64 = HashMap_to_str(m) as i64;
    pert_print_str(s);
    p_str_free(s);
}

const LRT_STR_MAGIC: i64 = 0x4649444553545201;  // core's P_STR_MAGIC
const LRT_STR_RC: i64 = 0x4649444500000000;  // core's P_STR_RC

/// The header length of a non-null string, or -1 when it has no header:
/// core's p_str_hdr_len (with p_str_len_word and p_str_count_of) in one
/// function. string == runs it on both sides, and the three calls through
/// pe_len were 18.6% of a natively built parser's samples. Same tests in
/// the same order: 8-aligned, a plausible length word at s - 8, and at
/// s - 16 the literal magic, a static header or a counted one
/// (P_STR_RC + a count in 1..2^30 with the append bit clear).
@wrapping
fn lrt_hdr_len(s: i64) -> i64 {
    if (s & 7) != 0 {
        return 0 - 1;
    }
    var l: i64 = pe_ld(s - 8);
    if l < 0 || l >= 0x10000000000 {
        return 0 - 1;
    }
    var w: i64 = pe_ld(s - 16);
    if w == LRT_STR_MAGIC || w == LRT_STR_STATIC {
        return l;
    }
    var d: i64 = w - LRT_STR_RC;
    if d < 0 || d >= 0x100000000 {
        return 0 - 1;
    }
    if (d & 0x40000000) != 0 {
        return 0 - 1;
    }
    if (d & 0x3FFFFFFF) >= 1 {
        return l;
    }
    return 0 - 1;
}

pub fn pert_str_equal(a: i64, b: i64) -> bool {
    if a == b {
        return true;
    }
    if a == 0 || b == 0 {
        return false;
    }
    // both lengths from their headers in one call each; a string without
    // one (a C string, a pointer into a buffer) is measured by pe_len
    var la: i64 = lrt_hdr_len(a);
    var lb: i64 = lrt_hdr_len(b);
    if la < 0 {
        la = pe_len(a);
    }
    if lb < 0 {
        lb = pe_len(b);
    }
    if la != lb {
        return false;
    }
    // OP23: a word at a time where the two are equally aligned
    return pert_bytes_eq(a, b, la);
}

/// OP23: core's p_str_compare (bytes up to the first NUL of either; the
/// first difference as a - b, 0 when equal), eight bytes per step where the
/// two are equally aligned: a word that differs or holds a NUL ends the
/// step, and the bytes from there decide (a header length counts bytes past
/// an inner NUL; core's loop stops at it, and so do these). The lengths
/// bound the scan (the shorter one's NUL included), so every word read lies
/// inside both strings.
@wrapping
pub fn pert_str_compare(a: i64, b: i64) -> i64 {
    if a == b {
        return 0;
    }
    if a == 0 {
        return 0 - 1;
    }
    if b == 0 {
        return 1;
    }
    var m: i64 = pe_len(a);
    var lb: i64 = pe_len(b);
    if lb < m {
        m = lb;
    }
    m = m + 1;
    var i: i64 = 0;
    if ((a ^ b) & 7) == 0 {
        var head: bool = true;
        while head && i < m && ((a + i) & 7) != 0 {
            var x0: i64 = pe_ldb(a + i);
            if x0 != pe_ldb(b + i) || x0 == 0 {
                head = false;
            } else {
                i = i + 1;
            }
        }
        if head && m - i >= 16 {
            // the 16-byte blocks that are equal and hold no NUL of a
            // (pert_vblk_cmpz); the one that ends the run, if any, is read
            // on from its start
            i = i + pert_vblk_cmpz(a + i, b + i, m - i);
        }
        var words: bool = head;
        while words && i + 8 <= m {
            var a8: *mut i64 = a + i;
            var b8: *mut i64 = b + i;
            var x: i64 = 0;
            var y: i64 = 0;
            // SAFETY: i + 8 <= m (the shorter length and its NUL), both
            // 8-aligned: a word of each string's own bytes.
            unsafe {
                x = *a8;
                y = *b8;
            }
            // (x - 0x0101010101010101) & ~x & 0x8080808080808080: a NUL in x
            if x != y || ((x - 72340172838076673) & (~x) & -9187201950435737472) != 0 {
                words = false;
            } else {
                i = i + 8;
            }
        }
    }
    while i < m {
        var xa: i64 = pe_ldb(a + i);
        var yb: i64 = pe_ldb(b + i);
        if xa != yb {
            return xa - yb;
        }
        if xa == 0 {
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

/// FNV-1a over 8 bytes at a time: the Windows runtime's p_str_hash, so a
/// HashMap of strings is laid out, and printed, the same.
@wrapping
pub fn pert_str_hash(s: i64) -> i64 {
    var hash: i64 = -3750763034362895579;
    if s == 0 {
        return 0;
    }
    var addr: i64 = s;
    // OP23: the words of each page in a tight loop (one page test per page,
    // one 64-bit zero-byte test per word: the function wraps), then the
    // word that crosses into the next page byte by byte; the same values
    // as pe_runtime's pert_str_hash. The words are read through a pointer:
    // a pe_ld call per word cost more than the hashing.
    var going: bool = true;
    while going {
        // whole words while (addr & 4095) <= 4088
        var lim: i64 = (addr | 4095) - 7;
        while addr <= lim {
            var wp: *mut i64 = addr;
            var w: i64 = 0;
            // SAFETY: s is a NUL-terminated string; addr is at most its
            // NUL's word and lim keeps the word inside the page of bytes
            // already read, so the read cannot fault (pe_ld's read, without
            // a call per word).
            unsafe {
                w = *wp;
            }
            // (w - 0x0101010101010101) & ~w & 0x8080808080808080: a zero byte
            if ((w - 72340172838076673) & (~w) & -9187201950435737472) != 0 {
                going = false;
                lim = addr - 1;
            } else {
                hash = hash ^ w;
                hash = hash * 1099511628211;
                addr = addr + 8;
            }
        }
        if going {
            var wc: i64 = 0;
            var whole: bool = true;
            var k: i64 = 0;
            while k < 8 && whole {
                var b: i64 = pe_ldb(addr + k);
                if b == 0 {
                    whole = false;
                }
                wc = wc | (b << (k * 8));
                k = k + 1;
            }
            if whole {
                hash = hash ^ wc;
                hash = hash * 1099511628211;
                addr = addr + 8;
            } else {
                going = false;
            }
        }
    }
    var last: i64 = pe_ldb(addr);
    while last != 0 {
        hash = hash ^ last;
        hash = hash * 1099511628211;
        addr = addr + 1;
        last = pe_ldb(addr);
    }
    return hash & 9223372036854775807;
}

/// atoll: spaces, a sign, base-10 digits; 0 when there are none.
@wrapping
pub fn pert_str_to_int(s: i64) -> i64 {
    if s == 0 {
        return 0;
    }
    var i: i64 = 0;
    while pe_ldb(s + i) == 32 || pe_ldb(s + i) == 9 || pe_ldb(s + i) == 10 || pe_ldb(s + i) == 13 {
        i = i + 1;
    }
    var neg: bool = false;
    if pe_ldb(s + i) == 45 {
        neg = true;
        i = i + 1;
    } else if pe_ldb(s + i) == 43 {
        i = i + 1;
    }
    var v: i64 = 0;
    while pe_ldb(s + i) >= 48 && pe_ldb(s + i) <= 57 {
        v = v * 10 + (pe_ldb(s + i) - 48);
        i = i + 1;
    }
    if neg {
        return 0 - v;
    }
    return v;
}

fn pe_pow10(k: i64) -> f64 {
    var p: f64 = 1.0;
    var i: i64 = 0;
    while i < k {
        p = p * 10.0;
        i = i + 1;
    }
    return p;
}

/// atof: sign, digits, fraction, exponent. Exact (as strtod) whenever the
/// digits fit in 53 bits and the power of ten is at most 10^22.
pub fn pert_str_to_float(s: i64) -> f64 {
    if s == 0 {
        return 0.0;
    }
    var i: i64 = 0;
    while pe_ldb(s + i) == 32 || pe_ldb(s + i) == 9 || pe_ldb(s + i) == 10 {
        i = i + 1;
    }
    var neg: bool = false;
    if pe_ldb(s + i) == 45 {
        neg = true;
        i = i + 1;
    } else if pe_ldb(s + i) == 43 {
        i = i + 1;
    }
    var mant: i64 = 0;
    var digits: i64 = 0;
    var exp10: i64 = 0;
    while pe_ldb(s + i) >= 48 && pe_ldb(s + i) <= 57 {
        if digits < 18 {
            mant = mant * 10 + (pe_ldb(s + i) - 48);
            digits = digits + 1;
        } else {
            exp10 = exp10 + 1;
        }
        i = i + 1;
    }
    if pe_ldb(s + i) == 46 {
        i = i + 1;
        while pe_ldb(s + i) >= 48 && pe_ldb(s + i) <= 57 {
            if digits < 18 {
                mant = mant * 10 + (pe_ldb(s + i) - 48);
                digits = digits + 1;
                exp10 = exp10 - 1;
            }
            i = i + 1;
        }
    }
    if pe_ldb(s + i) == 101 || pe_ldb(s + i) == 69 {
        i = i + 1;
        var eneg: bool = false;
        if pe_ldb(s + i) == 45 {
            eneg = true;
            i = i + 1;
        } else if pe_ldb(s + i) == 43 {
            i = i + 1;
        }
        var e: i64 = 0;
        while pe_ldb(s + i) >= 48 && pe_ldb(s + i) <= 57 {
            if e < 10000 {
                e = e * 10 + (pe_ldb(s + i) - 48);
            }
            i = i + 1;
        }
        if eneg {
            exp10 = exp10 - e;
        } else {
            exp10 = exp10 + e;
        }
    }
    var v: f64 = mant as f64;
    if exp10 > 0 {
        if exp10 <= 22 {
            v = v * pe_pow10(exp10);
        } else {
            var k: i64 = 0;
            while k < exp10 && k < 400 {
                v = v * 10.0;
                k = k + 1;
            }
        }
    } else if exp10 < 0 {
        var ne: i64 = 0 - exp10;
        if ne <= 22 {
            v = v / pe_pow10(ne);
        } else {
            var k2: i64 = 0;
            while k2 < ne && k2 < 400 {
                v = v / 10.0;
                k2 = k2 + 1;
            }
        }
    }
    if neg {
        return 0.0 - v;
    }
    return v;
}

// ─── Floats as text ─────────────────────────────────────────────────────
// As the interpreter prints them (Rust's Display): the shortest fixed-point
// text that reads back as the same number, no exponent.

/// round(x) for 0 <= x < 2^53, half to even
fn pe_round(x: f64) -> i64 {
    var r: i64 = x as i64;
    var frac: f64 = x - (r as f64);
    if frac > 0.5 {
        return r + 1;
    }
    if frac == 0.5 && (r & 1) == 1 {
        return r + 1;
    }
    return r;
}

/// "-"? digits of r, with its last p digits after a point
fn pe_fixed(neg: bool, r: i64, p: i64) -> i64 {
    var buf: i64 = pert_malloc(400);
    var dig: i64 = pert_malloc(48);
    var nd: i64 = pe_int_digits(r, dig);
    var at: i64 = 0;
    if neg {
        pe_stb(buf, 45);
        at = 1;
    }
    if p == 0 {
        pe_copy(buf + at, dig, nd);
        at = at + nd;
    } else {
        if nd <= p {
            // 0.000ddd
            pe_stb(buf + at, 48);
            pe_stb(buf + at + 1, 46);
            at = at + 2;
            var z: i64 = 0;
            while z < p - nd {
                pe_stb(buf + at, 48);
                at = at + 1;
                z = z + 1;
            }
            pe_copy(buf + at, dig, nd);
            at = at + nd;
        } else {
            pe_copy(buf + at, dig, nd - p);
            at = at + nd - p;
            pe_stb(buf + at, 46);
            at = at + 1;
            pe_copy(buf + at, dig + nd - p, p);
            at = at + p;
        }
        // No trailing zeros after the point
        while pe_ldb(buf + at - 1) == 48 {
            at = at - 1;
        }
        if pe_ldb(buf + at - 1) == 46 {
            at = at - 1;
        }
    }
    var r2: i64 = pe_dup_range(buf, 0, at);
    pert_free(buf);
    pert_free(dig);
    return r2;
}

/// The exact decimal digits of an integral f64 >= 2^53: m * 2^e in base-10^9
/// limbs.
fn pe_big_integer_text(neg: bool, a: f64) -> i64 {
    var bits: i64 = p_f64_to_bits(a);
    var e: i64 = ((bits >> 52) & 2047) - 1075;
    var m: i64 = (bits & 4503599627370495) | 4503599627370496;
    var limbs: Vec<i64> = Vec::new();
    limbs.push(m % 1000000000);
    limbs.push((m / 1000000000) % 1000000000);
    limbs.push(m / 1000000000000000000);
    var k: i64 = 0;
    while k < e {
        var carry: i64 = 0;
        var li: i64 = 0;
        while li < limbs.len() {
            var x: i64 = limbs.get(li) * 2 + carry;
            limbs.set(li, x % 1000000000);
            carry = x / 1000000000;
            li = li + 1;
        }
        if carry > 0 {
            limbs.push(carry);
        }
        k = k + 1;
    }
    var top: i64 = limbs.len() - 1;
    while top > 0 && limbs.get(top) == 0 {
        top = top - 1;
    }
    var buf: i64 = pert_malloc(400);
    var at: i64 = 0;
    if neg {
        pe_stb(buf, 45);
        at = 1;
    }
    var dig: i64 = pert_malloc(48);
    var nd: i64 = pe_int_digits(limbs.get(top), dig);
    pe_copy(buf + at, dig, nd);
    at = at + nd;
    var j: i64 = top - 1;
    while j >= 0 {
        var x2: i64 = limbs.get(j);
        var d: i64 = 100000000;
        while d > 0 {
            pe_stb(buf + at, 48 + (x2 / d) % 10);
            at = at + 1;
            d = d / 10;
        }
        j = j - 1;
    }
    var r: i64 = pe_dup_range(buf, 0, at);
    pert_free(buf);
    pert_free(dig);
    return r;
}

pub fn pert_to_str_float(val: f64) -> str {
    if val != val {
        return pe_dup("NaN" as i64);
    }
    var d: f64 = val - val;
    if d != d {
        if val > 0.0 {
            return pe_dup("inf" as i64);
        }
        return pe_dup("-inf" as i64);
    }
    if val == 0.0 {
        if p_f64_to_bits(val) < 0 {
            return pe_dup("-0" as i64);
        }
        return pe_dup("0" as i64);
    }
    var neg: bool = val < 0.0;
    var a: f64 = val;
    if neg {
        a = 0.0 - a;
    }
    if a >= 9007199254740992.0 {
        return pe_big_integer_text(neg, a);
    }
    // The fewest fraction digits p with round(a * 10^p) / 10^p == a. While
    // the scaled value stays under 2^53 and 10^p is exact (p <= 22), the
    // division is correctly rounded: the test is strtod's.
    var p: i64 = 0;
    var pow: f64 = 1.0;
    while p <= 22 {
        var scaled: f64 = a * pow;
        if scaled >= 9007199254740992.0 {
            break;
        }
        var r: i64 = pe_round(scaled);
        if (r as f64) / pow == a {
            return pe_fixed(neg, r, p);
        }
        p = p + 1;
        pow = pow * 10.0;
    }
    // More digits than 2^53 or an exact 10^p hold (an f32 widened to f64:
    // 1.0000001192092896, 17 digits; before, the 15 digits reached so far
    // were printed, 1.00000011920929, which does not read back as the
    // number): the exact shortest digits
    return pe_float_text_exact(neg, a);
}

// ─── The exact shortest digits (pert_to_str_float's slow path) ──────────
// Steele & White / Burger & Dybvig's free-format algorithm over integers
// in base-10^9 limbs (little-endian Vec<i64>, no zero limb on top), as
// Rust's Display prints a float (core::fmt's flt2dec, Dragon): the fewest
// digits that read back as the number, the closer one of two candidates,
// a tie rounding up; the bounds count as reading back for an even
// mantissa (round half to even reads them so).

fn pe_bn_from(x: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var y: i64 = x;
    v.push(y % 1000000000);
    y = y / 1000000000;
    while y > 0 {
        v.push(y % 1000000000);
        y = y / 1000000000;
    }
    return v;
}

/// a * k for 0 <= k <= 2^30
fn pe_bn_mul_small(a: Vec<i64>, k: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var carry: i64 = 0;
    var i: i64 = 0;
    while i < a.len() {
        var x: i64 = a.get(i) * k + carry;
        out.push(x % 1000000000);
        carry = x / 1000000000;
        i = i + 1;
    }
    while carry > 0 {
        out.push(carry % 1000000000);
        carry = carry / 1000000000;
    }
    while out.len() > 1 && out.get(out.len() - 1) == 0 {
        out.pop();
    }
    return out;
}

/// a * 2^n
fn pe_bn_shl(a: Vec<i64>, n: i64) -> Vec<i64> {
    var out: Vec<i64> = pe_bn_mul_small(a, 1);
    var left: i64 = n;
    while left >= 30 {
        out = pe_bn_mul_small(out, 1073741824);
        left = left - 30;
    }
    if left > 0 {
        out = pe_bn_mul_small(out, 1 << left);
    }
    return out;
}

fn pe_bn_add(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var n: i64 = a.len();
    if b.len() > n {
        n = b.len();
    }
    var carry: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var x: i64 = carry;
        if i < a.len() {
            x = x + a.get(i);
        }
        if i < b.len() {
            x = x + b.get(i);
        }
        out.push(x % 1000000000);
        carry = x / 1000000000;
        i = i + 1;
    }
    if carry > 0 {
        out.push(carry);
    }
    return out;
}

/// a - b for a >= b
fn pe_bn_sub(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var borrow: i64 = 0;
    var i: i64 = 0;
    while i < a.len() {
        var x: i64 = a.get(i) - borrow;
        if i < b.len() {
            x = x - b.get(i);
        }
        if x < 0 {
            x = x + 1000000000;
            borrow = 1;
        } else {
            borrow = 0;
        }
        out.push(x);
        i = i + 1;
    }
    while out.len() > 1 && out.get(out.len() - 1) == 0 {
        out.pop();
    }
    return out;
}

/// -1, 0 or 1 as a <, == or > b
fn pe_bn_cmp(a: Vec<i64>, b: Vec<i64>) -> i64 {
    if a.len() != b.len() {
        if a.len() < b.len() {
            return 0 - 1;
        }
        return 1;
    }
    var i: i64 = a.len() - 1;
    while i >= 0 {
        if a.get(i) != b.get(i) {
            if a.get(i) < b.get(i) {
                return 0 - 1;
            }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

/// r + m reaches the next power s: r + m >= s (inclusive bounds) or > s
fn pe_bn_reach(r: Vec<i64>, m: Vec<i64>, s: Vec<i64>, inclusive: bool) -> bool {
    val c: i64 = pe_bn_cmp(pe_bn_add(r, m), s);
    if inclusive {
        return c >= 0;
    }
    return c > 0;
}

/// The shortest text of a (0 < a < 2^53, finite), fixed-point as
/// pe_fixed writes it
fn pe_float_text_exact(neg: bool, a: f64) -> i64 {
    var bits: i64 = p_f64_to_bits(a);
    var be: i64 = (bits >> 52) & 2047;
    var f: i64 = bits & 4503599627370495;
    var e: i64 = 0 - 1074;
    if be != 0 {
        f = f | 4503599627370496;
        e = be - 1075;
    }
    val inclusive: bool = (f & 1) == 0;
    // the lower neighbour is half as far for a power of two above the
    // smallest normal exponent
    val uneven: bool = f == 4503599627370496 && be > 1;
    // a = r / s; the bounds (halfway to the neighbours) are (r - mm) / s
    // and (r + mp) / s
    var r: Vec<i64> = pe_bn_from(f);
    var s: Vec<i64> = pe_bn_from(1);
    var mp: Vec<i64> = pe_bn_from(1);
    var mm: Vec<i64> = pe_bn_from(1);
    if e >= 0 {
        mm = pe_bn_shl(pe_bn_from(1), e);
        if uneven {
            r = pe_bn_shl(r, e + 2);
            s = pe_bn_from(4);
            mp = pe_bn_shl(pe_bn_from(1), e + 1);
        } else {
            r = pe_bn_shl(r, e + 1);
            s = pe_bn_from(2);
            mp = pe_bn_shl(pe_bn_from(1), e);
        }
    } else {
        if uneven {
            r = pe_bn_shl(r, 2);
            s = pe_bn_shl(pe_bn_from(1), 2 - e);
            mp = pe_bn_from(2);
        } else {
            r = pe_bn_shl(r, 1);
            s = pe_bn_shl(pe_bn_from(1), 1 - e);
        }
    }
    // k: a = 0.d1 d2 ... * 10^k, the upper bound below 10^k
    var k: i64 = 0;
    while pe_bn_reach(r, mp, s, inclusive) {
        s = pe_bn_mul_small(s, 10);
        k = k + 1;
    }
    while !pe_bn_reach(pe_bn_mul_small(r, 10), pe_bn_mul_small(mp, 10), s, inclusive) {
        r = pe_bn_mul_small(r, 10);
        mp = pe_bn_mul_small(mp, 10);
        mm = pe_bn_mul_small(mm, 10);
        k = k - 1;
    }
    var dig: i64 = pert_malloc(800);
    var nd: i64 = 0;
    var going: bool = true;
    while going && nd < 790 {
        r = pe_bn_mul_small(r, 10);
        mp = pe_bn_mul_small(mp, 10);
        mm = pe_bn_mul_small(mm, 10);
        var d: i64 = 0;
        while pe_bn_cmp(r, s) >= 0 {
            r = pe_bn_sub(r, s);
            d = d + 1;
        }
        val cl: i64 = pe_bn_cmp(r, mm);
        var low: bool = cl < 0;
        if inclusive {
            low = cl <= 0;
        }
        val high: bool = pe_bn_reach(r, mp, s, inclusive);
        if low || high {
            going = false;
            if high && (!low || pe_bn_cmp(pe_bn_mul_small(r, 2), s) >= 0) {
                d = d + 1;
            }
        }
        pe_stb(dig + nd, d);
        nd = nd + 1;
    }
    // a last digit rounded up to 10 carries into the ones before it
    var ci: i64 = nd - 1;
    while ci > 0 && pe_ldb(dig + ci) >= 10 {
        pe_stb(dig + ci, 0);
        pe_stb(dig + ci - 1, pe_ldb(dig + ci - 1) + 1);
        ci = ci - 1;
    }
    if pe_ldb(dig) >= 10 {
        pe_stb(dig, 0);
        var sh: i64 = nd;
        while sh > 0 {
            pe_stb(dig + sh, pe_ldb(dig + sh - 1));
            sh = sh - 1;
        }
        pe_stb(dig, 1);
        nd = nd + 1;
        k = k + 1;
    }
    while nd > 1 && pe_ldb(dig + nd - 1) == 0 {
        nd = nd - 1;
    }
    var buf: i64 = pert_malloc(nd + 820);
    var at: i64 = 0;
    if neg {
        pe_stb(buf, 45);
        at = 1;
    }
    if k <= 0 {
        pe_stb(buf + at, 48);
        pe_stb(buf + at + 1, 46);
        at = at + 2;
        var z: i64 = 0;
        while z < 0 - k {
            pe_stb(buf + at, 48);
            at = at + 1;
            z = z + 1;
        }
        var j: i64 = 0;
        while j < nd {
            pe_stb(buf + at, 48 + pe_ldb(dig + j));
            at = at + 1;
            j = j + 1;
        }
    } else {
        var j2: i64 = 0;
        while j2 < nd || j2 < k {
            if j2 == k {
                pe_stb(buf + at, 46);
                at = at + 1;
            }
            var dd: i64 = 0;
            if j2 < nd {
                dd = pe_ldb(dig + j2);
            }
            pe_stb(buf + at, 48 + dd);
            at = at + 1;
            j2 = j2 + 1;
        }
    }
    var out: i64 = pe_dup_range(buf, 0, at);
    pert_free(buf);
    pert_free(dig);
    return out;
}

pub fn pert_float_to_str(val: f64) -> str {
    return pert_to_str_float(val);
}

// ─── String builder (as the Windows runtime) ────────────────────────────

pub fn pert_sb_new() -> i64 {
    var sb: i64 = pert_malloc(24);
    pe_st(sb, pert_malloc(64));
    pe_st(sb + 8, 0);
    pe_st(sb + 16, 64);
    return sb;
}

pub fn pert_sb_append(sb: i64, s: i64) {
    var n: i64 = pe_len(s);
    var len: i64 = pe_ld(sb + 8);
    var cap: i64 = pe_ld(sb + 16);
    if len + n + 1 > cap {
        while len + n + 1 > cap {
            cap = cap * 2;
        }
        var grown: i64 = pert_malloc(cap);
        pe_copy(grown, pe_ld(sb), len);
        pert_free(pe_ld(sb));
        pe_st(sb, grown);
        pe_st(sb + 16, cap);
    }
    pe_copy(pe_ld(sb) + len, s, n);
    pe_st(sb + 8, len + n);
}

pub fn pert_sb_to_str(sb: i64) -> str {
    return pe_dup_range(pe_ld(sb), 0, pe_ld(sb + 8));
}

// ─── Allocators: the general heap ───────────────────────────────────────

pub fn pert_allocator_create(arg: i64) -> i64 {
    return 1;
}

pub fn pert_allocator_alloc(alloc: i64, size: i64) -> i64 {
    if size < 0 {
        return 0;
    }
    return pert_malloc(size);
}

pub fn pert_allocator_free(alloc: i64, ptr: i64) {
    pert_free(ptr);
}

pub fn pert_allocator_stats(alloc: i64) -> i64 {
    return 0;
}

// ─── String builtins (the C runtime's meaning) ──────────────────────────

pub fn pert_string_len(s: i64) -> i64 {
    return pe_len(s);
}

/// The index of `sub` in `s`, or -1
fn pe_find(s: i64, sub: i64, from: i64) -> i64 {
    var n: i64 = pe_len(s);
    var m: i64 = pe_len(sub);
    var i: i64 = from;
    while i + m <= n {
        var j: i64 = 0;
        while j < m && pe_ldb(s + i + j) == pe_ldb(sub + j) {
            j = j + 1;
        }
        if j == m {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

pub fn pert_string_find(s: i64, sub: i64) -> i64 {
    if s == 0 || sub == 0 {
        return 0 - 1;
    }
    return pe_find(s, sub, 0);
}

pub fn pert_string_contains(s: i64, sub: i64) -> bool {
    if s == 0 || sub == 0 {
        return false;
    }
    return pe_find(s, sub, 0) >= 0;
}

pub fn pert_string_starts_with(s: i64, prefix: i64) -> bool {
    if s == 0 || prefix == 0 {
        return false;
    }
    var n: i64 = pe_len(s);
    var m: i64 = pe_len(prefix);
    if m > n {
        return false;
    }
    var i: i64 = 0;
    while i < m {
        if pe_ldb(s + i) != pe_ldb(prefix + i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn pert_string_ends_with(s: i64, suffix: i64) -> bool {
    if s == 0 || suffix == 0 {
        return false;
    }
    var n: i64 = pe_len(s);
    var m: i64 = pe_len(suffix);
    if m > n {
        return false;
    }
    var i: i64 = 0;
    while i < m {
        if pe_ldb(s + n - m + i) != pe_ldb(suffix + i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn pert_string_replace(s: i64, from: i64, to: i64) -> str {
    if s == 0 {
        return pe_new_str(0);
    }
    var m: i64 = pe_len(from);
    if from == 0 || m == 0 {
        return pe_dup(s);
    }
    var sb: i64 = pert_sb_new();
    var n: i64 = pe_len(s);
    var i: i64 = 0;
    while i < n {
        var at: i64 = pe_find(s, from, i);
        if at < 0 {
            var rest: i64 = pe_dup_range(s, i, n - i);
            pert_sb_append(sb, rest);
            i = n;
        } else {
            var part: i64 = pe_dup_range(s, i, at - i);
            pert_sb_append(sb, part);
            pert_sb_append(sb, to);
            i = at + m;
        }
    }
    return pert_sb_to_str(sb);
}

fn pe_is_space(b: i64) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

pub fn pert_string_trim(s: i64) -> str {
    if s == 0 {
        return pe_new_str(0);
    }
    var n: i64 = pe_len(s);
    var a: i64 = 0;
    while a < n && pe_is_space(pe_ldb(s + a)) {
        a = a + 1;
    }
    var b: i64 = n;
    while b > a && pe_is_space(pe_ldb(s + b - 1)) {
        b = b - 1;
    }
    return pe_dup_range(s, a, b - a);
}

pub fn pert_string_to_uppercase(s: i64) -> str {
    var r: i64 = pe_dup(s);
    var n: i64 = pe_len(r);
    var i: i64 = 0;
    while i < n {
        var c: i64 = pe_ldb(r + i);
        if c >= 97 && c <= 122 {
            pe_stb(r + i, c - 32);
        }
        i = i + 1;
    }
    return r;
}

pub fn pert_string_to_lowercase(s: i64) -> str {
    var r: i64 = pe_dup(s);
    var n: i64 = pe_len(r);
    var i: i64 = 0;
    while i < n {
        var c: i64 = pe_ldb(r + i);
        if c >= 65 && c <= 90 {
            pe_stb(r + i, c + 32);
        }
        i = i + 1;
    }
    return r;
}

/// p_string_from(s): a new string with the bytes of s ("" for null).
pub fn pert_string_from(s: i64) -> str {
    if s == 0 {
        return pe_new_str(0);
    }
    return pe_dup(s);
}

/// p_string_substring(s, start, end): the C runtime's p_string_slice
/// (start clamped to 0, end to the length, empty when start > end).
pub fn pert_string_substring(s: i64, start: i64, end: i64) -> str {
    if s == 0 {
        return pe_new_str(0);
    }
    var n: i64 = pe_len(s);
    var a: i64 = start;
    var b: i64 = end;
    if a < 0 {
        a = 0;
    }
    if b > n {
        b = n;
    }
    if a > b {
        a = b;
    }
    return pe_dup_range(s, a, b - a);
}

// ─── Standard input (SP16: the compiler's `fid lsp` and REPL read it) ────
// The C runtime's meaning (fgets / fread / feof): p_read_line is a line
// without its trailing "\n" and "\r", 0 when the input ended before any
// byte; p_read_stdin(n) up to n bytes, 0 when none could be read (n > 0);
// p_stdin_eof is 1 once a read hit the end. Unbuffered, a read system call
// per byte of a line, so they mix with pert_c_getchar (sys.fd), which reads
// fd 0 the same way; win.fd and darwin.fd translate the read.
var pe_stdin_eof_flag: i64 = 0;

pub fn pert_stdin_eof() -> i64 {
    return pe_stdin_eof_flag;
}

pub fn pert_read_line() -> str {
    var cap: i64 = 256;
    var buf: i64 = pert_malloc(cap);
    var b: i64 = pert_malloc(8);
    var n: i64 = 0;
    var any: bool = false;
    while true {
        var k: i64 = pe_sys(PE_SYS_READ, 0, b, 1);
        if k <= 0 {
            pe_stdin_eof_flag = 1;
            break;
        }
        any = true;
        var c: i64 = pe_ldb(b);
        if c == 10 {
            break;
        }
        if n == cap {
            var nb: i64 = pert_malloc(cap * 2);
            pe_copy(nb, buf, n);
            pert_free(buf);
            buf = nb;
            cap = cap * 2;
        }
        pe_stb(buf + n, c);
        n = n + 1;
    }
    pert_free(b);
    if !any {
        pert_free(buf);
        return pe_null_str();
    }
    while n > 0 && (pe_ldb(buf + n - 1) == 13 || pe_ldb(buf + n - 1) == 10) {
        n = n - 1;
    }
    var r: i64 = pe_dup_range(buf, 0, n);
    pert_free(buf);
    return r;
}

pub fn pert_read_stdin(n: i64) -> str {
    var m: i64 = n;
    if m < 0 {
        m = 0;
    }
    var buf: i64 = pert_malloc(m + 8);
    var got: i64 = 0;
    while got < m {
        var k: i64 = pe_sys(PE_SYS_READ, 0, buf + got, m - got);
        if k <= 0 {
            pe_stdin_eof_flag = 1;
            break;
        }
        got = got + k;
    }
    if got == 0 && m > 0 {
        pert_free(buf);
        return pe_null_str();
    }
    var r: i64 = pe_dup_range(buf, 0, got);
    pert_free(buf);
    return r;
}

/// The pieces of s between the delimiters (a trailing empty piece is not
/// kept, as in the C runtime).
pub fn pert_string_split(s: i64, delim: i64) -> i64 {
    var v: i64 = Vec_new();
    if s == 0 || delim == 0 {
        return v;
    }
    var n: i64 = pe_len(s);
    var m: i64 = pe_len(delim);
    var start: i64 = 0;
    while start < n {
        var at: i64 = 0 - 1;
        if m > 0 {
            at = pe_find(s, delim, start);
        }
        if at < 0 {
            Vec_push(v, pe_dup_range(s, start, n - start));
            start = n;
        } else {
            Vec_push(v, pe_dup_range(s, start, at - start));
            start = at + m;
        }
    }
    return v;
}

// ─── The process: arguments, environment, clocks ────────────────────────

pub fn pert_argc() -> i64 {
    return pe_ld(nat_start_sp());
}

pub fn pert_argv(i: i64) -> str {
    var sp: i64 = nat_start_sp();
    if i < 0 || i >= pe_ld(sp) {
        return pe_null_str();
    }
    return pe_ld(sp + 8 + i * 8);
}

pub fn pert_getenv(name: i64) -> str {
    if name == 0 {
        return pe_null_str();
    }
    var sp: i64 = nat_start_sp();
    var at: i64 = sp + 8 + (pe_ld(sp) + 1) * 8;
    var n: i64 = pe_len(name);
    while pe_ld(at) != 0 {
        var e: i64 = pe_ld(at);
        var j: i64 = 0;
        while j < n && pe_ldb(e + j) == pe_ldb(name + j) {
            j = j + 1;
        }
        if j == n && pe_ldb(e + n) == 61 {
            return p_str_from_ptr(e + n + 1);
        }
        at = at + 8;
    }
    return pe_null_str();
}

pub fn pert_getpid() -> i64 {
    return pe_sys(PE_SYS_GETPID, 0, 0, 0);
}

/// CLOCK_REALTIME in nanoseconds since 1970
fn pe_now_ns() -> i64 {
    var ts: i64 = pert_malloc(16);
    pe_sys(PE_SYS_CLOCK_GETTIME, 0, ts, 0);
    var ns: i64 = pe_ld(ts) * 1000000000 + pe_ld(ts + 8);
    pert_free(ts);
    return ns;
}

pub fn pert_clock_now() -> i64 {
    return pe_now_ns();
}

pub fn pert_clock_now_us() -> i64 {
    return pe_now_ns() / 1000;
}

pub fn pert_clock_now_ms() -> i64 {
    return pe_now_ns() / 1000000;
}

/// C6: milliseconds on CLOCK_MONOTONIC (1), the clock of deadlines
/// (timeout blocks, tokens): a change of the wall clock does not move it.
/// On --nat Windows win.fd answers clock 1 from QueryPerformanceCounter.
pub fn pert_clock_mono_ms() -> i64 {
    var ts: i64 = pert_malloc(16);
    pe_sys(PE_SYS_CLOCK_GETTIME, 1, ts, 0);
    var ms: i64 = pe_ld(ts) * 1000 + pe_ld(ts + 8) / 1000000;
    pert_free(ts);
    return ms;
}

/// Regions freed in one step (proposal 0005) need the C runtime's arenas:
/// here no region is ever open, so regions stay scopes and core's region
/// checks fall through.
pub fn pert_region_word(op: i64, x: i64) -> i64 {
    return 0;
}

pub fn pert_os_random_u64() -> i64 {
    var buf: i64 = pert_malloc(8);
    pe_sys(PE_SYS_GETRANDOM, buf, 8, 0);
    var v: i64 = pe_ld(buf);
    pert_free(buf);
    return v;
}

// ─── Files ──────────────────────────────────────────────────────────────

fn pe_open(path: i64, flags: i64) -> i64 {
    return nat_syscall(PE_SYS_OPENAT, PE_AT_FDCWD, path, flags, 420, 0, 0);
}

pub fn pert_file_read(path: i64) -> str {
    if path == 0 {
        return pe_null_str();
    }
    // F4: a directory is not a file, whatever its file system says its
    // size is (ext4 gives a huge end offset, tmpfs/9p an error or 0, which
    // read as ""): stat first (sys.fd pe_mode, S_IFDIR) and give the null
    // that `fid run` and the C runtime give
    val dmode: i64 = pe_mode(path);
    if dmode >= 0 && (dmode & 61440) == 16384 {
        return pe_null_str();
    }
    var fd: i64 = pe_open(path, 0);
    if fd < 0 {
        return pe_null_str();
    }
    var size: i64 = pe_sys(PE_SYS_LSEEK, fd, 0, 2);
    // VF14 (as the C runtime's p_file_read): a directory opens, its end is
    // a huge offset on ext4 and reading it fails (EISDIR); it reads as a
    // missing file, not as an empty string or a huge allocation
    if size < 0 || size >= 281474976710656 {
        pe_sys(PE_SYS_CLOSE, fd, 0, 0);
        return pe_null_str();
    }
    pe_sys(PE_SYS_LSEEK, fd, 0, 0);
    var r: i64 = pe_new_str(size);
    var got: i64 = 0;
    while got < size {
        var k: i64 = pe_sys(PE_SYS_READ, fd, r + got, size - got);
        if k < 0 && got == 0 {
            pe_sys(PE_SYS_CLOSE, fd, 0, 0);
            p_str_free(r);
            return pe_null_str();
        }
        if k <= 0 {
            break;
        }
        got = got + k;
    }
    pe_stb(r + got, 0);
    pe_sys(PE_SYS_CLOSE, fd, 0, 0);
    return r;
}

fn pe_write_file(path: i64, data: i64, n: i64, flags: i64) -> i64 {
    if path == 0 {
        return 0 - 1;
    }
    var fd: i64 = pe_open(path, flags);
    if fd < 0 {
        return 0 - 1;
    }
    pe_write_all(fd, data, n);
    pe_sys(PE_SYS_CLOSE, fd, 0, 0);
    return 0;
}

// p_file_write/p_file_append are text builtins: the content stops at its
// first zero byte, as C's fputs and pe_ir's stub (test_binary_io); a string
// literal can hold one since RT2. p_file_write_bin writes every byte.
fn pe_text_len(s: i64) -> i64 {
    if s == 0 {
        return 0;
    }
    val m: i64 = pe_len(s);
    var n: i64 = 0;
    while n < m && pe_ldb(s + n) != 0 {
        n = n + 1;
    }
    return n;
}

pub fn pert_file_write(path: i64, content: i64) -> i64 {
    return pe_write_file(path, content, pe_text_len(content), 577);  // WRONLY|CREAT|TRUNC
}

pub fn pert_file_write_bin(path: i64, data: i64, n: i64) -> i64 {
    if n < 0 {
        return 0 - 1;
    }  // as the C runtime: nothing is created
    return pe_write_file(path, data, n, 577);
}

pub fn pert_file_append(path: i64, content: i64) -> i64 {
    return pe_write_file(path, content, pe_text_len(content), 1089);  // WRONLY|CREAT|APPEND
}

pub fn pert_file_exists(path: i64) -> bool {
    if path == 0 {
        return false;
    }
    var fd: i64 = pe_open(path, 0);
    if fd < 0 {
        return false;
    }
    pe_sys(PE_SYS_CLOSE, fd, 0, 0);
    return true;
}

pub fn pert_file_delete(path: i64) -> i64 {
    if path == 0 {
        return 0 - 1;
    }
    if pe_sys(PE_SYS_UNLINKAT, PE_AT_FDCWD, path, 0) < 0 {
        return 0 - 1;
    }
    return 0;
}

// ─── J8: sensitive-Vec buffer registry ────────────────────────────────────
// p_sensitive_* calls come from core's Vec functions; on this backend they
// resolve to pert_sensitive_*. Same scheme as pe_runtime/base.fd.

/// OP23: bytes up to a word boundary, then eight bytes per store (the
/// byte repeated), then the bytes left.
@wrapping
pub fn pert_memset(dst: i64, v: i64, n: i64) {
    var i: i64 = 0;
    while i < n && ((dst + i) & 7) != 0 {
        pe_stb(dst + i, v & 255);
        i = i + 1;
    }
    var rep: i64 = (v & 255) * 0x0101010101010101;
    while i + 8 <= n {
        pe_st(dst + i, rep);
        i = i + 8;
    }
    while i < n {
        pe_stb(dst + i, v & 255);
        i = i + 1;
    }
}

// @zeroize: wipe a heap string's bytes and a Vec's element buffer.
// A Fides Vec is a 40-byte block: [0] data [8] len [16] cap, element code
// at [24] (vec_code reads it). Byte stores keep the wipe off the
// optimizer's dead-store list on this backend.
pub fn pert_str_zeroize(s: i64) {
    if s == 0 {
        return;
    }
    var i: i64 = 0;
    while pe_ldb(s + i) != 0 {
        pe_stb(s + i, 0);
        i = i + 1;
    }
}

pub fn pert_vec_zeroize(v: i64) {
    if v == 0 {
        return;
    }
    var data: i64 = pe_ld(v);
    var cap: i64 = pe_ld(v + 16);
    if data != 0 && cap > 0 {
        var n: i64 = cap * vec_esz(vec_code(v));
        var i: i64 = 0;
        while i < n {
            pe_stb(data + i, 0);
            i = i + 1;
        }
    }
    pert_sensitive_unmark(v);
}

// Header-keyed, mirroring the C runtime: entries are (header, current
// buffer, element size). Core's grow/drop paths check the header and wipe
// the outgoing buffer; remark refreshes the tracked buffer after growth.
var lrt_sens_tab: i64 = 0;
var lrt_sens_n: i64 = 0;
var lrt_sens_wipes: i64 = 0;

fn lrt_sens_table() -> i64 {
    if lrt_sens_tab == 0 {
        lrt_sens_tab = pert_malloc(256 * 24);
        var zi: i64 = 0;
        while zi < 256 * 24 {
            pe_stb(lrt_sens_tab + zi, 0);
            zi = zi + 1;
        }
    }
    return lrt_sens_tab;
}

fn lrt_sens_find(hdr: i64) -> i64 {
    var t: i64 = lrt_sens_table();
    var i: i64 = 0;
    while i < lrt_sens_n {
        if pe_ld(t + i * 24) == hdr {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn pert_sensitive_mark(v: i64) {
    if v == 0 || lrt_sens_n >= 256 || lrt_sens_find(v) >= 0 {
        return;
    }
    var e: i64 = lrt_sens_table() + lrt_sens_n * 24;
    pe_st(e, v);
    pe_st(e + 8, pe_ld(v));
    pe_st(e + 16, vec_esz(vec_code(v)));
    lrt_sens_n = lrt_sens_n + 1;
}

pub fn pert_sensitive_remark(v: i64) {
    var i: i64 = lrt_sens_find(v);
    if i < 0 {
        return;
    }
    var e: i64 = lrt_sens_table() + i * 24;
    pe_st(e + 8, pe_ld(v));
    pe_st(e + 16, vec_esz(vec_code(v)));
}

pub fn pert_sensitive_check(v: i64) -> i64 {
    if lrt_sens_find(v) >= 0 {
        return 1;
    }
    return 0;
}

pub fn pert_sensitive_unmark(v: i64) {
    var i: i64 = lrt_sens_find(v);
    if i < 0 {
        return;
    }
    var t: i64 = lrt_sens_table();
    var last: i64 = t + (lrt_sens_n - 1) * 24;
    var e: i64 = t + i * 24;
    pe_st(e, pe_ld(last));
    pe_st(e + 8, pe_ld(last + 8));
    pe_st(e + 16, pe_ld(last + 16));
    lrt_sens_n = lrt_sens_n - 1;
}

pub fn pert_sensitive_free(v: i64, buf: i64, cap: i64) {
    var i: i64 = lrt_sens_find(v);
    if i < 0 || buf == 0 {
        return;
    }
    var esz: i64 = pe_ld(lrt_sens_table() + i * 24 + 16);
    if cap < 0 {
        cap = 0 - cap;
    }
    var j: i64 = 0;
    while j < cap * esz {
        pe_stb(buf + j, 0);
        j = j + 1;
    }
    lrt_sens_wipes = lrt_sens_wipes + 1;
}

pub fn pert_sensitive_wipes() -> i64 {
    return lrt_sens_wipes;
}
