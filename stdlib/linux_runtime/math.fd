// stdlib/linux_runtime/math.fd — exp, log and pow of native Linux
// executables: musl's (src/math/exp.c, log.c, pow.c, from Arm's optimized
// routines; Copyright (c) 2018, Arm Limited; MIT), as musl builds them for
// AArch64 and RISC-V 64 (__FP_FAST_FMA: the fused multiply-adds are
// nat_fma). Correctly rounded in nearly every case (< 0.52 ulp), so the
// output matches the C path's. Every operation is written as musl's C,
// in its order, without contraction.

const PE_MT_WORDS: i64 = 1059;
const PE_MT_LOG: i64 = 264;
const PE_MT_POW: i64 = 538;

/// The tables of musl (src/math/exp_data.c, log_data.c, pow_data.c;
/// Arm Limited, MIT): 16 hex digits per word.
fn pe_mt_hex() -> str {
    return "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "" +
        "";
}

var pe_mtab: i64 = 0;

fn pe_hexdig(c: i64) -> i64 {
    if c >= 97 { return c - 87; }
    if c >= 65 { return c - 55; }
    return c - 48;
}

/// The tables as words (parsed once; two threads at once only build the
/// same table twice).
fn pe_mt() -> i64 {
    if pe_mtab != 0 { return pe_mtab; }
    var h: i64 = pe_mt_hex() as i64;
    var t: i64 = pert_malloc(PE_MT_WORDS * 8);
    var i: i64 = 0;
    while i < PE_MT_WORDS {
        var w: i64 = 0;
        var j: i64 = 0;
        while j < 16 {
            w = (w << 4) | pe_hexdig(pe_ldb(h + i * 16 + j));
            j = j + 1;
        }
        pe_st(t + i * 8, w);
        i = i + 1;
    }
    pe_mtab = t;
    return t;
}

fn pe_mw(t: i64, i: i64) -> i64 { return pe_ld(t + i * 8); }
fn pe_mf(t: i64, i: i64) -> f64 { return p_f64_from_bits(pe_ld(t + i * 8)); }
fn pe_asd(b: i64) -> f64 { return p_f64_from_bits(b); }
fn pe_asu(x: f64) -> i64 { return p_f64_to_bits(x); }

/// a < b as unsigned 64-bit numbers
fn pe_ult(a: i64, b: i64) -> bool {
    var m: i64 = 0 - 9223372036854775807 - 1;
    return (a ^ m) < (b ^ m);
}

fn pe_top12(x: f64) -> i64 {
    return (pe_asu(x) >> 52) & 4095;
}

fn pe_fma(a: f64, b: f64, c: f64) -> f64 {
    return pe_asd(nat_fma(pe_asu(a), pe_asu(b), pe_asu(c)));
}

fn pe_oflow(sign: i64) -> f64 {
    var big: f64 = pe_asd(8070450532247928832);           // 0x1p769
    if sign != 0 { return (0.0 - big) * big; }
    return big * big;
}

fn pe_uflow(sign: i64) -> f64 {
    var tiny: f64 = pe_asd(1152921504606846976);          // 0x1p-767
    if sign != 0 { return (0.0 - tiny) * tiny; }
    return tiny * tiny;
}

/// exp's and pow's specialcase: scale * (1 + tmp) near overflow or
/// underflow (`signed`: pow's, where the scale may be negative).
fn pe_exp_special(tmp: f64, sbits0: i64, ki: i64, signed: bool) -> f64 {
    var sbits: i64 = sbits0;
    if (ki & 2147483648) == 0 {
        sbits = sbits - (1009 << 52);
        var scale: f64 = pe_asd(sbits);
        return pe_asd(9151314442816847872) * (scale + scale * tmp);   // 0x1p1009
    }
    sbits = sbits + (1022 << 52);
    var scale2: f64 = pe_asd(sbits);
    var y: f64 = scale2 + scale2 * tmp;
    var ay: f64 = y;
    if signed && ay < 0.0 { ay = 0.0 - ay; }
    if ay < 1.0 {
        var one: f64 = 1.0;
        if signed && y < 0.0 { one = 0.0 - 1.0; }
        var lo: f64 = scale2 - y + scale2 * tmp;
        var hi: f64 = one + y;
        lo = one - hi + y + lo;
        y = (hi + lo) - one;
        if y == 0.0 {
            if signed { y = pe_asd(sbits & (0 - 9223372036854775807 - 1)); } else { y = 0.0; }
        }
    }
    return pe_asd(4503599627370496) * y;                // 0x1p-1022
}

/// sign * exp(x + xtail) (musl's exp_inline; exp is xtail 0, sign 0).
fn pe_exp_inline(x: f64, xtail: f64, sign_bias: i64, is_pow: bool) -> f64 {
    var t: i64 = pe_mt();
    var abstop: i64 = pe_top12(x) & 2047;
    if ((abstop - 969) & 4294967295) >= 63 {            // top12(0x1p-54), top12(512)
        if ((abstop - 969) & 4294967295) >= 2147483648 {
            var one: f64 = 1.0 + x;
            if sign_bias != 0 { return 0.0 - one; }
            return one;
        }
        if abstop >= 1033 {                             // top12(1024)
            if !is_pow {
                if pe_asu(x) == 0 - 4503599627370496 { return 0.0; }   // -inf
                if abstop >= 2047 { return 1.0 + x; }
            }
            if (pe_asu(x) >> 63) != 0 { return pe_uflow(sign_bias); }
            return pe_oflow(sign_bias);
        }
        abstop = 0;
    }
    var z: f64 = pe_mf(t, 0) * x;
    var kd: f64 = z + pe_mf(t, 1);
    var ki: i64 = pe_asu(kd);
    kd = kd - pe_mf(t, 1);
    var r: f64 = x + kd * pe_mf(t, 2) + kd * pe_mf(t, 3);
    r = r + xtail;
    var idx: i64 = 2 * (ki & 127);
    var top: i64 = (ki + sign_bias) << 45;
    var tail: f64 = pe_mf(t, 8 + idx);
    var sbits: i64 = pe_mw(t, 8 + idx + 1) + top;
    var r2: f64 = r * r;
    var tmp: f64 = tail + r + r2 * (pe_mf(t, 4) + r * pe_mf(t, 5)) + r2 * r2 * (pe_mf(t, 6) + r * pe_mf(t, 7));
    if abstop == 0 { return pe_exp_special(tmp, sbits, ki, is_pow); }
    var scale: f64 = pe_asd(sbits);
    return scale + scale * tmp;
}

pub fn pert_c_exp(x: f64) -> f64 {
    return pe_exp_inline(x, 0.0, 0, false);
}

pub fn pert_c_log(x: f64) -> f64 {
    var t: i64 = pe_mt();
    var L: i64 = PE_MT_LOG;
    var ix: i64 = pe_asu(x);
    var top: i64 = (ix >> 48) & 65535;
    var lo_b: i64 = 4606619468846596096;                 // asuint64(1.0 - 0x1p-4)
    var hi_b: i64 = 4607473789381378048;                 // asuint64(1.0 + 0x1.09p-4)
    if pe_ult(ix - lo_b, hi_b - lo_b) {
        if ix == 4607182418800017408 { return 0.0; }
        var r: f64 = x - 1.0;
        var r2: f64 = r * r;
        var r3: f64 = r * r2;
        var B: i64 = L + 7;
        var y: f64 = r3 * (pe_mf(t, B + 1) + r * pe_mf(t, B + 2) + r2 * pe_mf(t, B + 3)
            + r3 * (pe_mf(t, B + 4) + r * pe_mf(t, B + 5) + r2 * pe_mf(t, B + 6)
            + r3 * (pe_mf(t, B + 7) + r * pe_mf(t, B + 8) + r2 * pe_mf(t, B + 9) + r3 * pe_mf(t, B + 10))));
        var w: f64 = r * pe_asd(4728779608739020800);        // 0x1p27
        var rhi: f64 = r + w - w;
        var rlo: f64 = r - rhi;
        w = rhi * rhi * pe_mf(t, B);
        var hi: f64 = r + w;
        var lo: f64 = r - hi + w;
        lo = lo + pe_mf(t, B) * rlo * (rhi + r);
        y = y + lo;
        y = y + hi;
        return y;
    }
    if ((top - 16) & 4294967295) >= 32736 {             // 0x7ff0 - 0x0010
        if (ix << 1) == 0 { return (0.0 - 1.0) / 0.0; }
        if ix == 9218868437227405312 { return x; }       // inf
        if (top & 32768) != 0 || (top & 32752) == 32752 { return (x - x) / (x - x); }
        ix = pe_asu(x * pe_asd(4841369599423283200));    // 0x1p52
        ix = ix - (52 << 52);
    }
    var tmp: i64 = ix - 4604367669032910848;             // OFF 0x3fe6000000000000
    var i: i64 = (tmp >> 45) & 127;
    var k: i64 = tmp >> 52;
    var iz: i64 = ix - (tmp & (4095 << 52));
    var invc: f64 = pe_mf(t, L + 18 + 2 * i);
    var logc: f64 = pe_mf(t, L + 18 + 2 * i + 1);
    var zz: f64 = pe_asd(iz);
    var rr: f64 = pe_fma(zz, invc, 0.0 - 1.0);
    var kd: f64 = k as f64;
    var ww: f64 = kd * pe_mf(t, L) + logc;
    var hh: f64 = ww + rr;
    var ll: f64 = ww - hh + rr + kd * pe_mf(t, L + 1);
    var rr2: f64 = rr * rr;
    var A: i64 = L + 2;
    return ll + rr2 * pe_mf(t, A) + rr * rr2 * (pe_mf(t, A + 1) + rr * pe_mf(t, A + 2) + rr2 * (pe_mf(t, A + 3) + rr * pe_mf(t, A + 4))) + hh;
}

/// 0: not an integer, 1: odd, 2: even (iy: a non-zero finite double's bits)
fn pe_checkint(iy: i64) -> i64 {
    var e: i64 = (iy >> 52) & 2047;
    if e < 1023 { return 0; }
    if e > 1023 + 52 { return 2; }
    if (iy & ((1 << (1023 + 52 - e)) - 1)) != 0 { return 0; }
    if (iy & (1 << (1023 + 52 - e))) != 0 { return 1; }
    return 2;
}

/// The bits of 0, inf or NaN
fn pe_zeroinfnan(i: i64) -> bool {
    return !pe_ult(2 * i - 1, 2 * 9218868437227405312 - 1);
}

pub fn pert_c_pow(x: f64, y: f64) -> f64 {
    var t: i64 = pe_mt();
    var sign_bias: i64 = 0;
    var ix: i64 = pe_asu(x);
    var iy: i64 = pe_asu(y);
    var topx: i64 = pe_top12(x);
    var topy: i64 = pe_top12(y);
    var one_b: i64 = 4607182418800017408;
    var inf_b: i64 = 9218868437227405312;
    if ((topx - 1) & 4294967295) >= 2046 || (((topy & 2047) - 958) & 4294967295) >= 128 {
        if pe_zeroinfnan(iy) {
            if (iy << 1) == 0 { return 1.0; }
            if ix == one_b { return 1.0; }
            if pe_ult(2 * inf_b, 2 * ix) || pe_ult(2 * inf_b, 2 * iy) { return x + y; }
            if (ix << 1) == (one_b << 1) { return 1.0; }
            if pe_ult(2 * ix, 2 * one_b) == ((iy >> 63) == 0) { return 0.0; }
            return y * y;
        }
        if pe_zeroinfnan(ix) {
            var x2: f64 = x * x;
            if (ix >> 63) != 0 && pe_checkint(iy) == 1 { x2 = 0.0 - x2; }
            if (iy >> 63) != 0 { return 1.0 / x2; }
            return x2;
        }
        if (ix >> 63) != 0 {
            var yint: i64 = pe_checkint(iy);
            if yint == 0 { return (x - x) / (x - x); }
            if yint == 1 { sign_bias = 2048 << 7; }
            ix = ix & 9223372036854775807;
            topx = topx & 2047;
        }
        if (((topy & 2047) - 958) & 4294967295) >= 128 {
            if ix == one_b { return 1.0; }
            if (topy & 2047) < 958 {
                if pe_ult(one_b, ix) { return 1.0 + y; }
                return 1.0 - y;
            }
            if pe_ult(one_b, ix) == (topy < 2048) { return pe_oflow(0); }
            return pe_uflow(0);
        }
        if topx == 0 {
            ix = pe_asu(x * pe_asd(4841369599423283200));
            ix = ix & 9223372036854775807;
            ix = ix - (52 << 52);
        }
    }
    // log_inline: hi + lo = log(x)
    var P: i64 = PE_MT_POW;
    var tmp: i64 = ix - 4604531861337669632;               // OFF 0x3fe6955500000000
    var i: i64 = (tmp >> 45) & 127;
    var k: i64 = tmp >> 52;
    var iz: i64 = ix - (tmp & (4095 << 52));
    var z: f64 = pe_asd(iz);
    var kd: f64 = k as f64;
    var invc: f64 = pe_mf(t, P + 9 + 4 * i);
    var logc: f64 = pe_mf(t, P + 9 + 4 * i + 2);
    var logctail: f64 = pe_mf(t, P + 9 + 4 * i + 3);
    var r: f64 = pe_fma(z, invc, 0.0 - 1.0);
    var t1: f64 = kd * pe_mf(t, P) + logc;
    var t2: f64 = t1 + r;
    var lo1: f64 = kd * pe_mf(t, P + 1) + logctail;
    var lo2: f64 = t1 - t2 + r;
    var A: i64 = P + 2;
    var ar: f64 = pe_mf(t, A) * r;
    var ar2: f64 = r * ar;
    var ar3: f64 = r * ar2;
    var hi: f64 = t2 + ar2;
    var lo3: f64 = pe_fma(ar, r, 0.0 - ar2);
    var lo4: f64 = t2 - hi + ar2;
    var p: f64 = ar3 * (pe_mf(t, A + 1) + r * pe_mf(t, A + 2)
        + ar2 * (pe_mf(t, A + 3) + r * pe_mf(t, A + 4) + ar2 * (pe_mf(t, A + 5) + r * pe_mf(t, A + 6))));
    var lo: f64 = lo1 + lo2 + lo3 + lo4 + p;
    var yl: f64 = hi + lo;
    var ltail: f64 = hi - yl + lo;
    // y * log(x) as ehi + elo, then exp
    var ehi: f64 = y * yl;
    var elo: f64 = y * ltail + pe_fma(y, yl, 0.0 - ehi);
    return pe_exp_inline(ehi, elo, sign_bias, true);
}
