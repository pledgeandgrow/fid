// stdlib/linux_runtime/conc.fd — threads, futures, tasks, atomics,
// mutexes and channels of native Linux executables (AArch64, RISC-V 64).
//
// The semantics of stdlib/pe_runtime/conc.fd, on the backend's primitives
// (compiler/nat_ir.fd): nat_clone_thread starts a thread, nat_ctx_swap
// switches between task stacks, nat_atomic_* are the machines' atomics,
// nat_call_fn calls a program function by address with an argument array,
// nat_fn_table lists the functions named by strings, nat_tls_get/set the
// thread pointer (each thread's block, base.fd pe_tls).
//
// Threads are OS threads (clone) on stacks with a guard region below them
// (an overflow is reported, base.fd pe_on_signal). A thread's stack is freed
// when it is joined, once the kernel says the thread is gone (it clears the
// thread's ctid word: CLONE_CHILD_CLEARTID).
//
// Tasks are green threads, M:N: a task runs on any of the worker threads
// (one per CPU but one, at least one) and on a thread that waits for one
// (await, task_run, scope ends, channels, mutexes run queued tasks
// meanwhile). A task gives control back when it yields, sleeps, awaits an
// unfinished task, waits for a socket, a lock or a channel; it may resume
// on another thread. An idle thread sleeps on a futex, not in a loop.

const PE_SYS_SCHED_YIELD: i64 = 124;
const PE_SYS_NANOSLEEP: i64 = 101;
const PE_SYS_GETTID: i64 = 178;
const PE_SYS_SCHED_GETAFFINITY: i64 = 123;
const PE_THREAD_STACK: i64 = 8388608;
const PE_TASK_STACK: i64 = 262144;
const PE_MAX_WORKERS: i64 = 8;
// RT11: madvise (generic number; x86-64 needs nat_ir's map entry 233 -> 28,
// unmapped numbers return ENOSYS there, as on --nat Windows and macOS)
const PE_SYS_MADVISE: i64 = 233;
const PE_MADV_GUARD_INSTALL: i64 = 102;
var pe_guard_madv: i64 = 1;  // 0 once the kernel refused MADV_GUARD_INSTALL

/// A task's stack, PE_GUARD bytes of guard region at its bottom. Linux
/// 6.13+ installs the guard without a mapping of its own: one mapping per
/// stack instead of two, so vm.max_map_count (65530 stock, 1048576 on some
/// distributions) no longer caps the tasks at half of it (competitive
/// RT11, 1M idle connections). Elsewhere the guard is mprotect'ed.
fn pe_task_stack_new() -> i64 {
    var stack: i64 = pe_mmap(PE_TASK_STACK + PE_GUARD);
    if pe_guard_madv != 0 {
        if pe_sys(PE_SYS_MADVISE, stack, PE_GUARD, PE_MADV_GUARD_INSTALL) == 0 {
            return stack;
        }
        pe_guard_madv = 0;
    }
    pe_sys(PE_SYS_MPROTECT, stack, PE_GUARD, 0);
    return stack;
}

/// What a non-blocking poll returns for a task still running, and a
/// receive on a channel closed and empty (C: 0x8000000000000001).
fn pe_pending() -> i64 {
    return -9223372036854775807;
}

/// n zeroed 8-byte slots.
fn pe_zeroed(n: i64) -> i64 {
    var b: i64 = pert_malloc(n * 8);
    pe_zero(b, n * 8);
    return b;
}

fn pe_tid() -> i64 {
    return pe_sys(PE_SYS_GETTID, 0, 0, 0);
}

/// The address of the program function `name`, 0 if there is none.
fn pe_fn_lookup(name: str) -> i64 {
    var t: i64 = nat_fn_table();
    while pe_ld(t) != 0 {
        if pert_str_equal(pe_ld(t), name as i64) {
            return pe_ld(t + 8);
        }
        t = t + 16;
    }
    return 0;
}

fn pe_sleep_ms(ms: i64) {
    if ms <= 0 {
        pe_sys(PE_SYS_SCHED_YIELD, 0, 0, 0);
        return;
    }
    var ts: i64 = pert_malloc(16);
    pe_st(ts, ms / 1000);
    pe_st(ts + 8, (ms % 1000) * 1000000);
    // The profiler's SIGPROF (sys.fd, DB9) cuts a sleep short with EINTR
    // even under SA_RESTART: then the rest, which the kernel left in ts.
    // Without the profiler a signal still ends the sleep, as before.
    var r: i64 = pe_sys(PE_SYS_NANOSLEEP, ts, ts, 0);
    while r == 0 - 4 && pe_prof_m != 0 {
        r = pe_sys(PE_SYS_NANOSLEEP, ts, ts, 0);
    }
    pert_free(ts);
}

// ─── Random-choice scheduling (competitive RL17) ────────────────────────
// FIDES_SCHED_RANDOM=<seed> (a decimal number, not 0) turns it on, for
// interleaving tests, as in pe_runtime/conc.fd: one worker thread; the
// queue is turned a random number of places before each take, so the next
// task is a random runnable one; a loop safepoint yields one time in two
// while tasks are queued; threads, mutexes, atomics and channels sleep 0 or
// 1 ms one time in four. The scheduler's choices follow from the seed.
// Off, each hook costs one load.
var pe_rnd: i64 = 0;  // *i64: the xorshift state
var pe_rnd_on: i64 = 0;  // 0 not read yet, 1 random mode, 2 off

fn pe_rnd_enabled() -> bool {
    if pe_rnd_on == 0 {
        pe_rnd_init();
    }
    return pe_rnd_on == 1;
}

@wrapping
fn pe_rnd_init() {
    var s: i64 = pe_env_raw("FIDES_SCHED_RANDOM" as i64);
    var seed: i64 = 0;
    if s != 0 {
        var i: i64 = 0;
        while pe_ldb(s + i) >= 48 && pe_ldb(s + i) <= 57 && i < 18 {
            seed = seed * 10 + (pe_ldb(s + i) - 48);
            i = i + 1;
        }
    }
    if seed == 0 {
        pe_rnd_on = 2;
        return;
    }
    var st: i64 = pe_zeroed(1);
    var x: i64 = seed * 2654435761 + 88172645463325252;
    if x == 0 {
        x = 1;
    }
    pe_st(st, x);
    pe_rnd = st;
    pe_rnd_on = 1;
}

/// The next number of the shared xorshift64 sequence, >= 0.
@wrapping
fn pe_rnd_next() -> i64 {
    while true {
        var x: i64 = nat_atomic_load(pe_rnd);
        var y: i64 = x ^ (x << 13);
        y = y ^ ((y >> 7) & 0x01FFFFFFFFFFFFFF);
        y = y ^ (y << 17);
        if nat_atomic_cas(pe_rnd, x, y) != 0 {
            return y & 0x7FFFFFFFFFFFFFFF;
        }
    }
    return 0;
}

/// A random number in [0, n) (0 when n <= 1).
fn pe_rnd_below(n: i64) -> i64 {
    if n <= 1 {
        return 0;
    }
    return pe_rnd_next() % n;
}

/// An OS-thread interleaving point (random mode only).
fn pe_rnd_jitter() {
    if pe_rnd_enabled() {
        var r: i64 = pe_rnd_below(8);
        if r == 0 {
            pe_sleep_ms(1);
        } else if r == 1 {
            pe_sleep_ms(0);
        }
    }
}

/// Atomically: *addr = v; the old value.
fn pe_xchg(addr: i64, v: i64) -> i64 {
    var o: i64 = nat_atomic_load(addr);
    while nat_atomic_cas(addr, o, v) == 0 {
        o = nat_atomic_load(addr);
    }
    return o;
}

/// The CPUs this process may run on.
fn pe_cpu_count() -> i64 {
    var buf: i64 = pe_zeroed(16);
    var n: i64 = pe_sys(PE_SYS_SCHED_GETAFFINITY, 0, 128, buf);
    var count: i64 = 0;
    var i: i64 = 0;
    while i < n * 8 && i < 1024 {
        if (pe_ldb(buf + i / 8) & (1 << (i % 8))) != 0 {
            count = count + 1;
        }
        i = i + 1;
    }
    pert_free(buf);
    if count < 1 {
        count = 1;
    }
    return count;
}

/// Wait a moment for another thread or task: a task gives control back, a
/// thread runs a queued task, or else yields the CPU.
fn pe_relax() {
    if pe_co_self() != 0 {
        pe_co_leave();
        return;
    }
    if pe_co_step(1) {
        return;
    }
    pe_sys(PE_SYS_SCHED_YIELD, 0, 0, 0);
}

/// Wait on the futex word at addr while it holds `seen` (at most ms): a
/// task (or a thread with tasks to run) relaxes instead of sleeping, so
/// that what it waits for can run.
fn pe_wait_word(addr: i64, seen: i64, ms: i64) {
    if pe_co_self() != 0 {
        pe_co_leave();
        return;
    }
    if pe_co_step(1) {
        return;
    }
    pe_futex_wait(addr, seen & 4294967295, ms, true);
}

// ─── Threads ────────────────────────────────────────────────────────────

/// Start entry(env 0, arg) on a new thread: its stack with a guard region
/// below, its own thread block. *ctid is cleared when it is gone. The tid,
/// or < 0.
fn pe_spawn_os(entry: i64, arg: i64, ctid: i64) -> i64 {
    pe_mt_on();
    var size: i64 = PE_THREAD_STACK + PE_GUARD;
    var base: i64 = pe_mmap(size);
    pe_sys(PE_SYS_MPROTECT, base, PE_GUARD, 0);
    var t: i64 = pe_tls_new(base, base + PE_GUARD);
    pe_st(t + 40, base);
    pe_st(t + 48, size);
    pe_st(ctid, 1);
    var tid: i64 = nat_clone_thread(entry, arg, base + size, ctid, t);
    if tid < 0 {
        pe_st(ctid, 0);
        pe_sys(PE_SYS_MUNMAP, base, size, 0);
        pert_free(t);
    }
    return tid;
}

// The thread table. Per thread i: its start block, its result once
// joined, whether it was. Start block: [0] function, [1] nargs, [2..10)
// args, [10] done, [11] result, [12] the kernel's ctid word, [13] the
// thread's block (its stack, freed at the join).

var pert_thread_blocks: i64 = 0;
var pert_task_results: i64 = 0;
var pert_thread_joined: i64 = 0;
var pert_thread_ctr: i64 = 0;  // *i64: threads started
var pert_executor_count: i64 = 0;

fn pe_thread_tables() {
    if pert_thread_blocks == 0 {
        pe_mt_on();
        pert_thread_blocks = pe_zeroed(256);
        pert_task_results = pe_zeroed(256);
        pert_thread_joined = pe_zeroed(256);
        pert_thread_ctr = pe_zeroed(1);
    }
}

fn pe_thread_count() -> i64 {
    if pert_thread_ctr == 0 {
        return 0;
    }
    var n: i64 = nat_atomic_load(pert_thread_ctr);
    if n > 256 {
        n = 256;
    }
    return n;
}

/// Start the program function `name` with argv[0..nargs) on a new thread.
pub fn pert_thread_spawn_v(name: str, nargs: i64, argv: i64) -> i64 {
    // LG11: p_co_stack by name (the C runtime's handshake): -2 here
    if name == "__p_co_stack" {
        return pert_c_p_co_stack(0);
    }
    var fn_addr: i64 = pe_fn_lookup(name);
    if fn_addr == 0 {
        return 0 - 1;
    }
    pe_thread_tables();
    var idx: i64 = nat_atomic_add(pert_thread_ctr, 1);
    if idx >= 256 {
        return 0 - 1;
    }
    var block: i64 = pe_zeroed(14);
    pe_st(block, fn_addr);
    pe_st(block + 8, nargs);
    var i: i64 = 0;
    while i < nargs && i < 8 {
        pe_st(block + 16 + i * 8, pe_ld(argv + i * 8));
        i = i + 1;
    }
    var tid: i64 = pe_spawn_os(pe_fn_lookup("pe_thread_main"), block, block + 96);
    nat_atomic_store(pert_thread_blocks + idx * 8, block);
    if tid < 0 {
        // Could not start: run it here
        pe_thread_body(block);
    }
    return 0 - (idx + 1);
}

pub fn pert_executor_spawn_v(name: str, nargs: i64, argv: i64) -> i64 {
    return pert_thread_spawn_v(name, nargs, argv);
}

fn pe_thread_body(block: i64) -> i64 {
    var result: i64 = nat_call_fn(pe_ld(block), pe_ld(block + 8), block + 16);
    pe_st(block + 88, result);
    nat_atomic_store(block + 80, 1);
    return result;
}

/// Runs on the new thread: its signal stack, the function, its result and
/// done flag.
pub fn pe_thread_main(block: i64) -> i64 {
    var t: i64 = nat_tls_get();
    pe_st(block + 104, t);
    pe_altstack_on(t);
    pe_rnd_jitter();
    var result: i64 = pe_thread_body(block);
    pe_altstack_off(t);
    // RT8: its lists to the pool, its heap abandoned (base.fd
    // pe_heap_thread_end) after its last
    // free; on Windows and macOS the OS layer's thread function frees once
    // more after this returns, and does it then
    if nat_os() == 0 {
        pe_heap_thread_end();
    }
    return result;
}

/// The table index of future f, or -1 (a ready value or an unknown handle).
fn pe_task_index(f: i64) -> i64 {
    if f >= 0 {
        return 0 - 1;
    }
    var idx: i64 = 0 - (f + 1);
    if idx >= pe_thread_count() {
        return 0 - 1;
    }
    return idx;
}

fn pe_thread_block(idx: i64) -> i64 {
    var b: i64 = nat_atomic_load(pert_thread_blocks + idx * 8);
    while b == 0 {
        pe_relax();
        b = nat_atomic_load(pert_thread_blocks + idx * 8);
    }
    return b;
}

fn pe_task_done(idx: i64) -> bool {
    return nat_atomic_load(pe_thread_block(idx) + 80) != 0;
}

fn pe_unjoined(idx: i64) -> bool {
    return pe_ld(pert_thread_joined + idx * 8) == 0;
}

/// Wait for thread idx (once): its result. Its stack is freed once the
/// kernel has cleared its ctid word (the thread is gone).
fn pe_join(idx: i64) -> i64 {
    if pe_unjoined(idx) {
        var block: i64 = pe_thread_block(idx);
        var w: i64 = nat_atomic_load(block + 96) & 4294967295;
        while w != 0 {
            if pe_co_self() != 0 || pe_q_any() {
                pe_relax();
            } else {
                pe_futex_wait(block + 96, w, 0 - 1, false);
            }
            w = nat_atomic_load(block + 96) & 4294967295;
        }
        pe_st(pert_task_results + idx * 8, pe_ld(block + 88));
        pe_st(pert_thread_joined + idx * 8, 1);
        var t: i64 = pe_ld(block + 104);
        if t != 0 {
            pe_sys(PE_SYS_MUNMAP, pe_ld(t + 40), pe_ld(t + 48), 0);
            pert_free(t);
            pe_st(block + 104, 0);
        }
    }
    return pe_ld(pert_task_results + idx * 8);
}

// ─── Tasks: green threads, M:N ──────────────────────────────────────────
// A task's block is a thread's, with [12] = 1, then [13] its saved stack
// pointer, [15] its stack (the guard region at its bottom), [16] the next
// task in the run queue, [19] when its sleep ends (ms, 0: not sleeping),
// [20] detached (freed once done), [21] the stack pointer of whoever
// entered it last (where it goes back to); a socket wait (epoll, below):
// [17] its fd + 1 while the task asks to wait, [18] 1 to wait for writing
// (+ 2 when it has a deadline), [22] the wait's token while it is armed,
// [23] the token's generation, [24] how the wait ended; (CA9) [25] its
// function's name, [26] the task awaiting it (set while it waits), [27] the
// name of the task that started it (1: started off a task on a thread, 0:
// by main); (CA7/CA8) [28] its token slot ("Token slot" below); (CA9) [29]
// the task that entered it, while it runs inside that task's turn.
// A future of a task is its block with the tag 0x7FA5 in the top 16 bits.
// Run queues (competitive RT10, as pe_runtime/conc.fd): each worker owns a
// lock-free ring (below, "Worker rings") of tasks ready to run; the global
// queue is one list under pe_q_lock and holds what threads that are not
// workers queue, every sleeper (a deadline in [19]: the scan below skips it
// until it is due) and everything in random mode (RL17). pe_q_seq is the
// futex idle workers sleep on, pe_done_seq the one waiters for a finished
// task do.

var pe_q_lock: i64 = 0;  // *i64
var pe_q_seq: i64 = 0;  // *i64
var pe_done_seq: i64 = 0;  // *i64
var pe_q_head: i64 = 0;
var pe_q_tail: i64 = 0;
var pe_q_n: i64 = 0;
var pe_q_idle: i64 = 0;  // *i64: workers asleep
var pe_co_live: i64 = 0;  // *i64: unfinished tasks
var pe_co_total: i64 = 0;  // *i64: tasks there have been
var pe_workers: i64 = 0;  // *i64: 0 none, 1 starting or started
var pe_lq: i64 = 0;  // the worker rings: [0] how many, then PE_LQ_REC bytes each

/// The scheduler's words, once (the first task comes from one thread at
/// a time: pe_co_new_block's caller has none running yet).
fn pe_co_init() {
    if pe_q_lock == 0 {
        pe_mt_on();
        pe_q_seq = pe_zeroed(1);
        pe_done_seq = pe_zeroed(1);
        pe_q_idle = pe_zeroed(1);
        pe_co_live = pe_zeroed(1);
        pe_co_total = pe_zeroed(1);
        pe_workers = pe_zeroed(1);
        pe_q_lock = pe_zeroed(1);
        pe_ep_lock = pe_zeroed(1);
        pe_ep_n = pe_zeroed(1);
        pe_ep_polling = pe_zeroed(1);
    }
}

/// The task running on this thread, 0 if none.
fn pe_co_self() -> i64 {
    var t: i64 = nat_tls_get();
    if t == 0 {
        return 0;
    }
    return pe_ld(t);
}

fn pe_q_push(t: i64) {
    pe_q_push2(t, true);
}

/// Queue t; wake an idle worker when `wake` (a task that just yielded is
/// queued again by the thread that will take the next one at once: no
/// wake, or two threads fight over the queue on every yield). On a worker,
/// a task ready to run goes on the worker's own ring (RT10); a full ring
/// moves half of itself to the global queue first, and t follows it there.
fn pe_q_push2(t: i64, wake0: bool) {
    var wake: bool = wake0;
    var wid: i64 = pe_my_wid();
    if wid >= 0 && pe_rnd_on != 1 && pe_ld(t + 152) == 0 {
        var backlog: bool = pe_lq_size(wid) > 0 || pe_q_n > 0;
        if pe_lq_push(t, wid) {
            // the slot is published (a barrier) before pe_q_idle is read:
            // a worker counts itself idle before its last look (no lost
            // wake-up)
            if (wake || backlog) && nat_atomic_load(pe_q_idle) > 0 {
                nat_atomic_add(pe_q_seq, 1);
                pe_futex_wake(pe_q_seq, 1);
            }
            if wake {
                pe_ep_poke();
            }
            return;
        }
        pe_lq_spill(wid);
        wake = true;
    }
    pe_lock(pe_q_lock);
    pe_st(t + 128, 0);
    if pe_q_tail == 0 {
        pe_q_head = t;
    } else {
        pe_st(pe_q_tail + 128, t);
    }
    pe_q_tail = t;
    pe_q_n = pe_q_n + 1;
    pe_unlock(pe_q_lock);
    nat_atomic_add(pe_q_seq, 1);
    if !wake {
        return;
    }
    if nat_atomic_load(pe_q_idle) > 0 {
        pe_futex_wake(pe_q_seq, 1);
    }
    pe_ep_poke();
}

// ─── Worker rings (competitive RT10) ────────────────────────────────────
// As pe_runtime/conc.fd's: each worker owns a bounded Chase-Lev deque taken
// FIFO. Only its worker pushes, at `bottom`, with plain stores and a
// sequentially consistent store that publishes the slot; its worker and the
// thieves take at `top` by compare-and-swap, so a slot is claimed once and
// no lock is taken. A worker whose ring is dry takes from the global queue,
// then steals half of a sibling's ring in one CAS (the slots are copied to
// its own ring's unpublished end first: if the claim fails they are copied
// again). A thread that is not a worker (main waiting for a task) takes one
// task from a ring. A full ring moves its older half to the global queue in
// one lock hold. Indexes only grow; a slot is `index & (PE_LQ_CAP - 1)`.
// pe_lq: [0] the number of workers, then for worker w at 64 + w * PE_LQ_REC:
// [0] top, [64] bottom (another cache line), [128] the ring, [136] where
// its next steal starts. A worker's thread block holds w + 1 at [72].

const PE_LQ_CAP: i64 = 256;
const PE_LQ_REC: i64 = 192;

/// This thread's worker index, -1 when it is not a worker.
fn pe_my_wid() -> i64 {
    var t: i64 = nat_tls_get();
    if t == 0 || pe_lq == 0 {
        return 0 - 1;
    }
    return pe_ld(t + 72) - 1;
}

fn pe_lq_rec(wid: i64) -> i64 {
    return pe_lq + 64 + wid * PE_LQ_REC;
}

fn pe_lq_count() -> i64 {
    var q: i64 = pe_lq;
    if q == 0 {
        return 0;
    }
    return pe_ld(q);
}

/// Tasks on worker wid's ring, a snapshot.
fn pe_lq_size(wid: i64) -> i64 {
    var q: i64 = pe_lq_rec(wid);
    var t: i64 = nat_atomic_load(q);
    var b: i64 = nat_atomic_load(q + 64);
    if b > t {
        return b - t;
    }
    return 0;
}

/// Tasks on every ring.
fn pe_lq_total() -> i64 {
    var n: i64 = pe_lq_count();
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + pe_lq_size(i);
        i = i + 1;
    }
    return s;
}

/// Anything queued, on the global queue or a ring.
fn pe_q_any() -> bool {
    if pe_q_n > 0 {
        return true;
    }
    return pe_lq_total() > 0;
}

/// Worker wid's thread only: t on its ring. False when the ring is full.
fn pe_lq_push(t: i64, wid: i64) -> bool {
    var q: i64 = pe_lq_rec(wid);
    var b: i64 = pe_ld(q + 64);
    if b - nat_atomic_load(q) >= PE_LQ_CAP {
        return false;
    }
    pe_st(pe_ld(q + 128) + (b & (PE_LQ_CAP - 1)) * 8, t);
    nat_atomic_store(q + 64, b + 1);
    return true;
}

/// The oldest task of worker wid's ring (any thread). 0 if it is empty.
fn pe_lq_pop(wid: i64) -> i64 {
    var q: i64 = pe_lq_rec(wid);
    var buf: i64 = pe_ld(q + 128);
    while true {
        var t: i64 = nat_atomic_load(q);
        var b: i64 = nat_atomic_load(q + 64);
        if b - t <= 0 {
            return 0;
        }
        // read the slot, then claim it: if its owner reused it meanwhile,
        // top moved and the claim fails
        var task: i64 = pe_ld(buf + (t & (PE_LQ_CAP - 1)) * 8);
        if nat_atomic_cas(q, t, t + 1) != 0 {
            return task;
        }
    }
    return 0;
}

/// Thief wid (its ring empty) takes half of worker v's ring, rounded up:
/// the last one to run, the others published on its own ring. 0 if v's
/// ring is empty.
fn pe_lq_steal_half(wid: i64, v: i64) -> i64 {
    var q: i64 = pe_lq_rec(v);
    var vbuf: i64 = pe_ld(q + 128);
    var mine: i64 = pe_lq_rec(wid);
    var mbuf: i64 = pe_ld(mine + 128);
    var mb: i64 = pe_ld(mine + 64);
    var mask: i64 = PE_LQ_CAP - 1;
    while true {
        var t: i64 = nat_atomic_load(q);
        var b: i64 = nat_atomic_load(q + 64);
        var n: i64 = b - t;
        if n <= 0 {
            return 0;
        }
        n = n - n / 2;
        if n > PE_LQ_CAP / 2 {
            n = PE_LQ_CAP / 2;
        }
        var i: i64 = 0;
        while i < n {
            pe_st(mbuf + ((mb + i) & mask) * 8, pe_ld(vbuf + ((t + i) & mask) * 8));
            i = i + 1;
        }
        if nat_atomic_cas(q, t, t + n) != 0 {
            if n > 1 {
                nat_atomic_store(mine + 64, mb + n - 1);
            }
            return pe_ld(mbuf + ((mb + n - 1) & mask) * 8);
        }
    }
    return 0;
}

/// A task from another ring: half of the first sibling's that has work
/// (worker wid, its ring dry), or one task (wid < 0: not a worker).
fn pe_lq_steal(wid: i64) -> i64 {
    var n: i64 = pe_lq_count();
    if n == 0 {
        return 0;
    }
    var start: i64 = 0;
    if wid >= 0 {
        if n < 2 {
            return 0;
        }
        var mine: i64 = pe_lq_rec(wid);
        start = pe_ld(mine + 136);
        pe_st(mine + 136, start + 1);
    }
    var i: i64 = 0;
    while i < n {
        var v: i64 = (wid + 1 + n + (start + i) % n) % n;
        var t: i64 = 0;
        if wid < 0 {
            t = pe_lq_pop(v);
        } else if v != wid {
            t = pe_lq_steal_half(wid, v);
        }
        if t != 0 {
            return t;
        }
        i = i + 1;
    }
    return 0;
}

/// Worker wid's thread, its ring full: its older half to the global queue.
/// The half is claimed before it is read (only this thread writes its
/// slots).
fn pe_lq_spill(wid: i64) {
    var q: i64 = pe_lq_rec(wid);
    var buf: i64 = pe_ld(q + 128);
    var b: i64 = pe_ld(q + 64);
    var top: i64 = nat_atomic_load(q);
    var half: i64 = (b - top) / 2;
    var claimed: bool = half <= 0;
    while !claimed {
        if nat_atomic_cas(q, top, top + half) != 0 {
            claimed = true;
        } else {
            top = nat_atomic_load(q);
            half = (b - top) / 2;
            if half <= 0 {
                half = 0;
                claimed = true;
            }
        }
    }
    if half == 0 {
        return;
    }
    pe_lock(pe_q_lock);
    var i: i64 = 0;
    while i < half {
        var t: i64 = pe_ld(buf + ((top + i) & (PE_LQ_CAP - 1)) * 8);
        pe_st(t + 128, 0);
        if pe_q_tail == 0 {
            pe_q_head = t;
        } else {
            pe_st(pe_q_tail + 128, t);
        }
        pe_q_tail = t;
        pe_q_n = pe_q_n + 1;
        i = i + 1;
    }
    pe_unlock(pe_q_lock);
}

/// A task to run, 0 if none: this worker's ring, the global queue (which
/// skips sleepers), then another ring. *wake = when the first sleeper of
/// the global queue wakes (0: none sleeps).
fn pe_q_take(wake: i64) -> i64 {
    var wid: i64 = pe_my_wid();
    if wid >= 0 {
        var r: i64 = pe_lq_pop(wid);
        if r != 0 {
            pe_st(wake, 0);
            return r;
        }
    }
    var t: i64 = pe_gq_take(wake);
    if t != 0 {
        return t;
    }
    return pe_lq_steal(wid);
}

/// A queued task that is not sleeping, taken off the global queue; 0 if
/// none. *wake = when the first sleeper wakes (0: none sleeps).
fn pe_gq_take(wake: i64) -> i64 {
    pe_st(wake, 0);
    if pe_q_n == 0 {
        return 0;
    }
    // the clock only when a queued task sleeps (a system call under qemu)
    var now: i64 = 0;
    pe_lock(pe_q_lock);
    var n: i64 = pe_q_n;
    var found: i64 = 0;
    var first: i64 = 0;
    if pe_rnd_on == 1 {
        // RL17: turn the queue a random number of places
        var r: i64 = pe_rnd_below(n);
        while r > 0 {
            var h: i64 = pe_q_head;
            if pe_ld(h + 128) != 0 {
                pe_q_head = pe_ld(h + 128);
                pe_st(h + 128, 0);
                pe_st(pe_q_tail + 128, h);
                pe_q_tail = h;
            }
            r = r - 1;
        }
    }
    while n > 0 && found == 0 {
        var t: i64 = pe_q_head;
        pe_q_head = pe_ld(t + 128);
        if pe_q_head == 0 {
            pe_q_tail = 0;
        }
        pe_q_n = pe_q_n - 1;
        var dl: i64 = pe_ld(t + 152);
        if dl != 0 && now == 0 {
            now = pert_clock_now_ms();
        }
        if dl == 0 || dl <= now {
            pe_st(t + 152, 0);
            found = t;
        } else {
            if first == 0 || dl < first {
                first = dl;
            }
            pe_st(t + 128, 0);
            if pe_q_tail == 0 {
                pe_q_head = t;
            } else {
                pe_st(pe_q_tail + 128, t);
            }
            pe_q_tail = t;
            pe_q_n = pe_q_n + 1;
        }
        n = n - 1;
    }
    pe_unlock(pe_q_lock);
    pe_st(wake, first);
    return found;
}

/// Start the worker threads, once.
fn pe_co_workers() {
    if nat_atomic_load(pe_workers) != 0 {
        return;
    }
    if nat_atomic_cas(pe_workers, 0, 1) == 0 {
        return;
    }
    var n: i64 = pe_cpu_count() - 1;
    if n < 1 {
        n = 1;
    }
    // CP5: FIDES_WORKERS=<n> (1-16), as pe_runtime's: that many workers
    // instead of one per CPU but one (benchmarks of the switch itself,
    // programs that want fewer threads)
    var wenv: i64 = pe_env_raw("FIDES_WORKERS" as i64);
    if wenv != 0 {
        var wn: i64 = 0;
        var wi: i64 = 0;
        while wi < 3 && pe_ldb(wenv + wi) >= 48 && pe_ldb(wenv + wi) <= 57 {
            wn = wn * 10 + (pe_ldb(wenv + wi) - 48);
            wi = wi + 1;
        }
        if wn >= 1 && wn <= 16 {
            n = wn;
        }
    }
    if n > PE_MAX_WORKERS {
        n = PE_MAX_WORKERS;
    }
    if pe_rnd_enabled() {
        n = 1;
    }  // RL17
    // The rings (RT10), written before pe_lq is: the count's store is a
    // barrier, and readers reach the rest through pe_lq
    var lq: i64 = pe_zeroed(8 + n * (PE_LQ_REC / 8));
    var ri: i64 = 0;
    while ri < n {
        pe_st(lq + 64 + ri * PE_LQ_REC + 128, pe_zeroed(PE_LQ_CAP));
        ri = ri + 1;
    }
    nat_atomic_store(lq, n);
    pe_lq = lq;
    var entry: i64 = pe_fn_lookup("pe_worker_main");
    var i: i64 = 0;
    while i < n {
        var ctid: i64 = pe_zeroed(1);
        pe_spawn_os(entry, i, ctid);
        i = i + 1;
    }
}

/// A worker: run queued tasks for good, asleep while there are none.
pub fn pe_worker_main(id: i64) -> i64 {
    pe_altstack_on(nat_tls_get());
    pe_st(nat_tls_get() + 72, id + 1);  // its ring (RT10)
    var wake: i64 = pe_tls() + 56;
    while true {
        var seen: i64 = nat_atomic_load(pe_q_seq);
        var t: i64 = pe_q_take(wake);
        if t != 0 {
            pe_co_enter(t);
            pe_co_after(t);
        } else {
            var ms: i64 = 50;
            if pe_ld(wake) != 0 {
                ms = pe_ld(wake) - pert_clock_now_ms();
                if ms < 1 {
                    ms = 1;
                }
                if ms > 50 {
                    ms = 50;
                }
            }
            // One idle worker waits on the sockets tasks wait for (an
            // eventfd wakes it for new work), the others on the queue
            if nat_atomic_load(pe_ep_n) > 0 && nat_atomic_cas(pe_ep_polling, 0, 1) != 0 {
                pe_ep_poll(ms);
                nat_atomic_store(pe_ep_polling, 0);
            } else {
                nat_atomic_add(pe_q_idle, 1);
                // A last look at the rings once counted idle: a push to a
                // ring publishes its slot before it reads pe_q_idle, so
                // either it wakes this worker or this worker sees its task
                // (a push to the global queue bumps pe_q_seq: `seen`)
                if pe_lq_total() == 0 {
                    pe_futex_wait(pe_q_seq, seen & 4294967295, ms, true);
                }
                nat_atomic_add(pe_q_idle, 0 - 1);
            }
        }
    }
    return 0;
}

fn pe_co_new_block(name: str, nargs: i64, argv: i64) -> i64 {
    var fn_addr: i64 = pe_fn_lookup(name);
    if fn_addr == 0 {
        pert_panic("task: no such function" as i64);
    }
    pe_co_init();
    var block: i64 = pe_zeroed(30);
    pe_st(block, fn_addr);
    pe_st(block + 8, nargs);
    // CA9: its name and who started it, for a panic's task chain
    pe_st(block + 200, name as i64);
    var starter: i64 = pe_co_self();
    if starter != 0 {
        pe_st(block + 216, pe_ld(starter + 200));
    } else if pe_ld(pe_tls() + 16) != 0 {
        pe_st(block + 216, 1);
    }
    var a: i64 = 0;
    while a < nargs && a < 8 {
        pe_st(block + 16 + a * 8, pe_ld(argv + a * 8));
        a = a + 1;
    }
    pe_st(block + 96, 1);
    var stack: i64 = pe_task_stack_new();
    pe_st(block + 120, stack);
    // The first switch restores the record at s (nat_ctx_swap): registers
    // 0, fp 0, lr the trampoline, which calls [s + 112](env 0, [s + 120])
    var s: i64 = stack + PE_GUARD + PE_TASK_STACK - 128;
    // Windows (nat_ctx_swap there): the TEB's StackBase, StackLimit and
    // DeallocationStack for this stack, so an overflow into its guard page
    // is a stack overflow the handler can run on. Elsewhere these words are
    // callee-saved registers a fresh task does not read.
    pe_st(s + 40, stack + PE_GUARD + PE_TASK_STACK);
    pe_st(s + 48, stack + PE_GUARD);
    pe_st(s + 56, stack);
    pe_st(s + 96, 0);
    pe_st(s + 104, nat_ctx_tramp());
    pe_st(s + 112, pe_fn_lookup("pe_co_main"));
    pe_st(s + 120, block);
    pe_st(block + 104, s);
    nat_atomic_add(pe_co_live, 1);
    nat_atomic_add(pe_co_total, 1);
    pe_co_workers();
    return block;
}

/// The body of every task: its function, its result, then back for good.
pub fn pe_co_main(block: i64) -> i64 {
    var result: i64 = nat_call_fn(pe_ld(block), pe_ld(block + 8), block + 16);
    pe_st(block + 88, result);
    nat_atomic_store(block + 80, 1);
    pe_co_leave();
    return result;
}

/// Run task `block` on this thread until it gives control back or ends.
fn pe_co_enter(block: i64) {
    var t: i64 = pe_tls();
    var prev: i64 = pe_ld(t);
    pe_st(t, block);
    // CA9: the task whose turn this runs in, while it runs
    pe_st(block + 232, prev);
    nat_ctx_swap(block + 168, pe_ld(block + 104));
    pe_st(pe_tls(), prev);
    pe_st(block + 232, 0);
}

/// Give control back to whoever entered the running task.
fn pe_co_leave() {
    var t: i64 = pe_ld(pe_tls());
    nat_ctx_swap(t + 104, pe_ld(t + 168));
}

fn pe_co_finish(t: i64) {
    pe_sys(PE_SYS_MUNMAP, pe_ld(t + 120), PE_TASK_STACK + PE_GUARD, 0);
    nat_atomic_store(t + 120, 0);
    nat_atomic_add(pe_co_live, 0 - 1);
    nat_atomic_add(pe_done_seq, 1);
    pe_futex_wake(pe_done_seq, 2147483647);
    // Detached: whichever of this and pert_co_detach claims it frees it
    if nat_atomic_cas(t + 160, 1, 2) != 0 {
        pert_free(t);
    }
}

/// After entering t: finished, waiting for a socket (registered now that it
/// is off its stack, so a wake cannot resume it before it has left), or
/// back on the queue.
fn pe_co_after(t: i64) {
    if nat_atomic_load(t + 80) != 0 {
        pe_co_finish(t);
    } else if pe_ld(t + 136) != 0 {
        pe_ep_park(t);
    } else {
        pe_q_push2(t, false);
    }
}

/// Run one queued task that is not sleeping; when all of them sleep, wait
/// for the first to wake, at most `limit` ms. False with nothing queued.
fn pe_co_step(limit: i64) -> bool {
    if !pe_q_any() {
        return false;
    }
    var t: i64 = pe_q_take(pe_tls() + 56);
    var first: i64 = pe_ld(pe_tls() + 56);
    if t != 0 {
        pe_co_enter(t);
        pe_co_after(t);
        return true;
    }
    if first == 0 {
        return false;
    }
    var w: i64 = first - pert_clock_now_ms();
    if w > limit {
        w = limit;
    }
    pe_sleep_ms(w);
    return true;
}

/// Wait until no task is left unfinished.
fn pe_co_drain() {
    if pe_co_live == 0 {
        return;
    }
    while nat_atomic_load(pe_co_live) > 0 {
        var seen: i64 = nat_atomic_load(pe_done_seq);
        if !pe_co_step(5) && nat_atomic_load(pe_co_live) > 0 {
            pe_futex_wait(pe_done_seq, seen & 4294967295, 10, true);
        }
    }
}

/// LG11: the C runtime's `extern "C" fn p_co_stack(bytes) -> i64` (the
/// stack of the tasks started from now on; also asked as
/// p_thread_spawn("__p_co_stack", 1, bytes)). Here every task stack is
/// PE_TASK_STACK and tasks run on several workers at once: -2, nothing
/// changes (fid run's interpreter then runs each task to its end when it
/// starts).
pub fn pert_c_p_co_stack(bytes: i64) -> i64 {
    if bytes < 0 {
        return -2;
    }
    return -2;
}

pub fn pert_co_go(name: str, arg: i64) -> i64 {
    var slot: i64 = pe_zeroed(1);
    pe_st(slot, arg);
    var block: i64 = pe_co_new_block(name, 1, slot);
    pert_free(slot);
    pe_q_push(block);
    return block;
}

/// spawn f(args): a green task as a tagged future.
pub fn pert_co_spawn_v(name: str, nargs: i64, argv: i64) -> i64 {
    var block: i64 = pe_co_new_block(name, nargs, argv);
    pe_q_push(block);
    return block | (0x7FA5 << 48);
}

/// async f(args): the task runs at once, here, until it first gives
/// control back.
pub fn pert_co_async_v(name: str, nargs: i64, argv: i64) -> i64 {
    var block: i64 = pe_co_new_block(name, nargs, argv);
    pe_co_enter(block);
    pe_co_after(block);
    return block | (0x7FA5 << 48);
}

pub fn pert_co_yield() {
    if pe_co_self() != 0 {
        pe_co_leave();
    }
}

/// Loop-backedge safepoint: yield only when other tasks are queued (on the
/// global queue or this worker's ring: the other rings have their own
/// workers, and thieves).
pub fn pert_co_tick() {
    var queued: bool = pe_q_n > 0;
    if !queued && pe_lq != 0 {
        var wid: i64 = pe_my_wid();
        queued = wid >= 0 && pe_lq_size(wid) > 0;
    }
    if queued && pe_co_self() != 0 {
        // RL17: in random mode, a preemption point one time in two
        if pe_rnd_on != 1 || pe_rnd_below(2) == 0 {
            pe_co_leave();
        }
    }
}

/// `task_run()`: wait until every task has finished; how many there have
/// been.
pub fn pert_co_run() -> i64 {
    pe_co_drain();
    if pe_co_total == 0 {
        return 0;
    }
    return nat_atomic_load(pe_co_total);
}

fn pe_is_co_future(f: i64) -> bool {
    return ((f >> 48) & 0xFFFF) == 0x7FA5;
}

fn pe_co_await(f: i64) -> i64 {
    var c: i64 = f & 0xFFFFFFFFFFFF;
    // CA9: the task awaiting it, for a panic's task chain
    var me: i64 = pe_co_self();
    if me != 0 && nat_atomic_load(c + 80) == 0 {
        pe_st(c + 208, me);
    }
    // CA7: with a token in the slot, give up (0) once it is cancelled
    var tok: i64 = pert_task_token();
    while nat_atomic_load(c + 80) == 0 {
        if tok != 0 && pe_tok_cancelled(tok) {
            if me != 0 && pe_ld(c + 208) == me {
                pe_st(c + 208, 0);
            }
            return 0;
        }
        var seen: i64 = nat_atomic_load(pe_done_seq);
        if nat_atomic_load(c + 80) != 0 {
            break;
        }
        var wms: i64 = 10;
        if tok != 0 {
            wms = pe_tok_slice(tok, 10);
        }
        pe_wait_word(pe_done_seq, seen, wms);
    }
    return pe_ld(c + 88);
}

/// CA7: sleep, in slices when the slot holds a token: 1 when the token
/// stopped it, 0 when the whole time passed.
pub fn pert_co_sleep(ms: i64) -> i64 {
    var tok: i64 = pert_task_token();
    if tok == 0 {
        return pe_co_sleep_plain(ms);
    }
    var d: i64 = ms;
    if d < 0 {
        d = 0;
    }
    var end: i64 = pert_clock_mono_ms() + d;
    while true {
        if pe_tok_cancelled(tok) {
            return 1;
        }
        var left: i64 = end - pert_clock_mono_ms();
        if left <= 0 {
            return 0;
        }
        pe_co_sleep_plain(pe_tok_slice(tok, left));
    }
    return 0;
}

fn pe_co_sleep_plain(ms: i64) -> i64 {
    var d: i64 = ms;
    if d < 0 {
        d = 0;
    }
    var dl: i64 = pert_clock_now_ms() + d;
    var cur: i64 = pe_co_self();
    if cur != 0 {
        pe_st(cur + 152, dl);
        pe_co_leave();
        return 0;
    }
    // Not a task: run queued tasks meanwhile
    var now: i64 = pert_clock_now_ms();
    while now < dl {
        if !pe_co_step(dl - now) {
            pe_sleep_ms(dl - now);
        }
        now = pert_clock_now_ms();
    }
    return 0;
}

pub fn pert_co_detach(t: i64) {
    var b: i64 = t & 0xFFFFFFFFFFFF;
    nat_atomic_store(b + 160, 1);
    // Already finished and its stack gone: nobody frees it but us
    if nat_atomic_load(b + 80) != 0 && nat_atomic_load(b + 120) == 0 {
        if nat_atomic_cas(b + 160, 1, 2) != 0 {
            pert_free(b);
        }
    }
}

pub fn pert_co_done(t: i64) -> i64 {
    return nat_atomic_load((t & 0xFFFFFFFFFFFF) + 80);
}

pub fn pert_co_result(t: i64) -> i64 {
    return pe_ld((t & 0xFFFFFFFFFFFF) + 88);
}

// ─── Socket waits: epoll (competitive RT11) ─────────────────────────────
// A task waiting for a socket asks for the wait ([17], [18]) and gives
// control back; the thread it left registers the socket with epoll
// (pe_ep_park) and does not requeue it. An idle worker waits in
// epoll_pwait (pe_ep_poll) and requeues the task its socket is ready for:
// a wait costs the same with one socket or 100,000, where polling each one
// on every turn did not. The table holds, for each fd, the task waiting to
// read and the one waiting to write (block | generation << 48); a token
// claimed by compare-and-swap ([22]) wakes the task once, whichever of its
// socket and its deadline comes first. Without epoll, the old loop (ppoll,
// give control back) is the wait.

const PE_SYS_EVENTFD2: i64 = 19;
const PE_SYS_EPOLL_CREATE1: i64 = 20;
const PE_SYS_EPOLL_CTL: i64 = 21;
const PE_SYS_EPOLL_PWAIT: i64 = 22;
const PE_EP_WAKE_DATA: i64 = 2147483647;  // the eventfd's event

var pe_ep: i64 = 0;  // the epoll fd; 0 not yet, -1 none
var pe_ep_efd: i64 = 0;  // the eventfd that ends the poller's wait
var pe_ep_lock: i64 = 0;  // *i64: the table and the epoll set
var pe_ep_tab: i64 = 0;  // pe_ep_ix(fd) * 16: reader token, writer token
var pe_ep_cap: i64 = 0;  // fds the table holds
var pe_ep_n: i64 = 0;  // *i64: armed waits
var pe_ep_polling: i64 = 0;  // *i64: 1 while a worker waits in epoll
var pe_ep_buf: i64 = 0;  // the poller's events

/// epoll and its eventfd, once (under pe_ep_lock): false when the kernel
/// has none.
fn pe_ep_ready() -> bool {
    if pe_ep != 0 {
        return pe_ep > 0;
    }
    var ep: i64 = pe_sys(PE_SYS_EPOLL_CREATE1, 524288, 0, 0);  // EPOLL_CLOEXEC
    var efd: i64 = pe_sys(PE_SYS_EVENTFD2, 0, 526336, 0);  // EFD_CLOEXEC | EFD_NONBLOCK
    if ep < 0 || efd < 0 {
        pe_ep = 0 - 1;
        return false;
    }
    pe_ep_buf = pe_zeroed(64 * 2);
    var ev: i64 = pe_zeroed(2);
    pe_ep_event(ev, 1, PE_EP_WAKE_DATA);
    if pe_sys4(PE_SYS_EPOLL_CTL, ep, 1, efd, ev) < 0 {  // EPOLL_CTL_ADD
        pe_ep = 0 - 1;
        return false;
    }
    pert_free(ev);
    pe_ep_efd = efd;
    pe_ep = ep;
    return true;
}

fn pe_sys4(n: i64, a: i64, b: i64, c: i64, d: i64) -> i64 {
    return nat_syscall(n, a, b, c, d, 0, 0);
}

/// fd's row in pe_ep_tab: its low 48 bits (on Windows a socket fd is the
/// SOCKET under a tag in the high bits, stdlib/linux_runtime/win.fd)
fn pe_ep_ix(fd: i64) -> i64 {
    return fd & 281474976710655;
}

/// An epoll_event: packed (12 bytes) on x86-64, 16 on AArch64 and RISC-V.
fn pe_ep_event(ev: i64, events: i64, data: i64) {
    if nat_arch() == 3 {
        pe_st(ev, (events & 4294967295) | ((data & 4294967295) << 32));
        pe_st(ev + 8, (data >> 32) & 4294967295);
    } else {
        pe_st(ev, events & 4294967295);
        pe_st(ev + 8, data);
    }
}

/// The events and data of entry i of the poller's buffer.
fn pe_ep_entry(i: i64, out: i64) {
    if nat_arch() == 3 {
        var e: i64 = pe_ep_buf + i * 12;
        var w: i64 = pe_ld(e);
        pe_st(out, w & 4294967295);
        pe_st(out + 8, ((w >> 32) & 4294967295) | ((pe_ld(e + 8) & 4294967295) << 32));
    } else {
        var e2: i64 = pe_ep_buf + i * 16;
        pe_st(out, pe_ld(e2) & 4294967295);
        pe_st(out + 8, pe_ld(e2 + 8));
    }
}

/// Bring the epoll registration of fd in line with its two slots (under
/// pe_ep_lock): false when the kernel refused it.
fn pe_ep_sync(fd: i64) -> bool {
    var ix: i64 = pe_ep_ix(fd);
    var rd: i64 = pe_ld(pe_ep_tab + ix * 16);
    var wr: i64 = pe_ld(pe_ep_tab + ix * 16 + 8);
    var events: i64 = 0;
    if rd != 0 {
        events = events | 1 | 8192;
    }  // EPOLLIN | EPOLLRDHUP
    if wr != 0 {
        events = events | 4;
    }  // EPOLLOUT
    var ev: i64 = pe_zeroed(2);
    pe_ep_event(ev, events, fd);
    var ok: bool = true;
    if events == 0 {
        pe_sys4(PE_SYS_EPOLL_CTL, pe_ep, 2, fd, ev);  // DEL
    } else if pe_sys4(PE_SYS_EPOLL_CTL, pe_ep, 3, fd, ev) < 0 {  // MOD
        if pe_sys4(PE_SYS_EPOLL_CTL, pe_ep, 1, fd, ev) < 0 {  // ADD
            ok = false;
        }
    }
    pert_free(ev);
    return ok;
}

/// Wake the task of a claimed token: its wait ended with the socket ready.
fn pe_ep_wake(token: i64) {
    var t: i64 = token & 281474976710655;
    if nat_atomic_cas(t + 176, token, 0) == 0 {
        return;  // its deadline came first
    }
    nat_atomic_add(pe_ep_n, 0 - 1);
    pe_st(t + 192, 1);
    if (pe_ld(t + 144) & 2) != 0 {
        // on the queue as a sleeper: due now
        nat_atomic_store(t + 152, 1);
        nat_atomic_add(pe_q_seq, 1);
        pe_futex_wake(pe_q_seq, 1);
    } else {
        pe_q_push(t);
    }
}

/// Register the socket task t asked to wait for (t is off its stack).
fn pe_ep_park(t: i64) {
    var fd: i64 = pe_ld(t + 136) - 1;
    var w: i64 = pe_ld(t + 144) & 1;
    var timed: bool = (pe_ld(t + 144) & 2) != 0;
    pe_st(t + 136, 0);
    var gen: i64 = (pe_ld(t + 184) + 1) & 65535;
    if gen == 0 {
        gen = 1;
    }
    pe_st(t + 184, gen);
    var token: i64 = t | (gen << 48);
    var armed: bool = false;
    pe_lock(pe_ep_lock);
    var ix: i64 = pe_ep_ix(fd);
    if pe_ep_ready() && fd >= 0 && ix < 1048576 {
        if ix >= pe_ep_cap {
            var cap: i64 = pe_ep_cap * 2;
            if cap < 64 {
                cap = 64;
            }
            while cap <= ix {
                cap = cap * 2;
            }
            var tab: i64 = pe_zeroed(cap * 2);
            var i: i64 = 0;
            while i < pe_ep_cap * 2 {
                pe_st(tab + i * 8, pe_ld(pe_ep_tab + i * 8));
                i = i + 1;
            }
            if pe_ep_tab != 0 {
                pert_free(pe_ep_tab);
            }
            pe_ep_tab = tab;
            pe_ep_cap = cap;
        }
        var slot: i64 = pe_ep_tab + ix * 16 + w * 8;
        if pe_ld(slot) == 0 {
            pe_st(slot, token);
            nat_atomic_store(t + 176, token);
            if pe_ep_sync(fd) {
                armed = true;
                nat_atomic_add(pe_ep_n, 1);
            } else {
                pe_st(slot, 0);
                nat_atomic_store(t + 176, 0);
            }
        }
    }
    pe_unlock(pe_ep_lock);
    if !armed {
        // a second waiter the same way, a file epoll refuses, no epoll:
        // the task polls for itself
        pe_st(t + 192, 2);
        pe_q_push(t);
        return;
    }
    if timed {
        pe_q_push(t);  // a sleeper until its deadline, or due at its event
    } else {
        pe_ep_poke();  // a waiting poller sees the new socket at once
    }
}

/// A new task or socket while a worker sits in epoll_pwait: end its wait.
fn pe_ep_poke() {
    if pe_ep_polling != 0 && nat_atomic_load(pe_ep_polling) != 0 && pe_ep > 0 {
        var one: i64 = pe_zeroed(1);
        pe_st(one, 1);
        pe_sys(PE_SYS_WRITE, pe_ep_efd, one, 8);
        pert_free(one);
    }
}

/// Wait at most ms for sockets; wake the tasks of those that are ready.
fn pe_ep_poll(ms: i64) {
    if pe_ep <= 0 {
        return;
    }
    var k: i64 = nat_syscall(PE_SYS_EPOLL_PWAIT, pe_ep, pe_ep_buf, 64, ms, 0, 8);
    var e: i64 = pe_zeroed(2);
    var woke: i64 = pe_zeroed(2 * 64);
    var nw: i64 = 0;
    var i: i64 = 0;
    pe_lock(pe_ep_lock);
    while i < k {
        pe_ep_entry(i, e);
        var events: i64 = pe_ld(e);
        var fd: i64 = pe_ld(e + 8);
        if fd == PE_EP_WAKE_DATA {
            var drain: i64 = pe_zeroed(1);
            pe_sys(PE_SYS_READ, pe_ep_efd, drain, 8);
            pert_free(drain);
        } else if fd >= 0 && pe_ep_ix(fd) < pe_ep_cap {
            var row: i64 = pe_ep_tab + pe_ep_ix(fd) * 16;
            var rd: i64 = pe_ld(row);
            var wr: i64 = pe_ld(row + 8);
            var changed: bool = false;
            // readable, hung up, an error: the reader; writable, hung up,
            // an error: the writer
            if rd != 0 && (events & (1 | 8 | 16 | 8192)) != 0 {
                pe_st(row, 0);
                pe_st(woke + nw * 8, rd);
                nw = nw + 1;
                changed = true;
            }
            if wr != 0 && (events & (4 | 8 | 16)) != 0 {
                pe_st(row + 8, 0);
                pe_st(woke + nw * 8, wr);
                nw = nw + 1;
                changed = true;
            }
            if changed {
                pe_ep_sync(fd);
            }
        }
        i = i + 1;
    }
    pe_unlock(pe_ep_lock);
    i = 0;
    while i < nw {
        pe_ep_wake(pe_ld(woke + i * 8));
        i = i + 1;
    }
    pert_free(woke);
    pert_free(e);
}

/// The task's wait is over (it runs again): 1 its socket is ready, 0 its
/// deadline came first (the registration is taken back), -1 it was never
/// armed (wait the old way).
fn pe_ep_done(t: i64, fd: i64, w: i64) -> i64 {
    var how: i64 = pe_ld(t + 192);
    pe_st(t + 192, 0);
    if how == 2 {
        return 0 - 1;
    }
    var token: i64 = nat_atomic_load(t + 176);
    if token != 0 && nat_atomic_cas(t + 176, token, 0) != 0 {
        nat_atomic_add(pe_ep_n, 0 - 1);
        pe_lock(pe_ep_lock);
        var slot: i64 = pe_ep_tab + pe_ep_ix(fd) * 16 + w * 8;
        if pe_ep_ix(fd) < pe_ep_cap && pe_ld(slot) == token {
            pe_st(slot, 0);
            pe_ep_sync(fd);
        }
        pe_unlock(pe_ep_lock);
        return 0;
    }
    return 1;
}

/// A socket is being closed: wake whoever waits for it (their next call
/// on it reports the error) and forget it.
fn pe_ep_forget(fd: i64) {
    if pe_ep <= 0 || pe_ep_lock == 0 || fd < 0 {
        return;
    }
    pe_lock(pe_ep_lock);
    var rd: i64 = 0;
    var wr: i64 = 0;
    var row: i64 = pe_ep_tab + pe_ep_ix(fd) * 16;
    if pe_ep_ix(fd) < pe_ep_cap {
        rd = pe_ld(row);
        wr = pe_ld(row + 8);
        if rd != 0 || wr != 0 {
            pe_st(row, 0);
            pe_st(row + 8, 0);
            pe_ep_sync(fd);
        }
    }
    pe_unlock(pe_ep_lock);
    if rd != 0 {
        pe_ep_wake(rd);
    }
    if wr != 0 {
        pe_ep_wake(wr);
    }
}

/// Wait until fd is readable (or writable): 1, or 0 when `timeout_ms`
/// (>= 0) passes first. A task gives control back meanwhile. CA7: with a
/// token in the slot, it waits in slices and gives 0 once it is cancelled.
pub fn pert_co_wait_fd(fd: i64, write: i64, timeout_ms: i64) -> i64 {
    var tok: i64 = pert_task_token();
    if tok == 0 {
        return pe_co_wait_fd_plain(fd, write, timeout_ms);
    }
    var start: i64 = pert_clock_mono_ms();
    while true {
        if pe_tok_cancelled(tok) {
            return 0;
        }
        var left: i64 = 0 - 1;
        if timeout_ms >= 0 {
            left = timeout_ms - (pert_clock_mono_ms() - start);
            if left <= 0 {
                return 0;
            }
        }
        if pe_co_wait_fd_plain(fd, write, pe_tok_slice(tok, left)) != 0 {
            return 1;
        }
    }
    return 0;
}

fn pe_co_wait_fd_plain(fd: i64, write: i64, timeout_ms: i64) -> i64 {
    var cur: i64 = pe_co_self();
    if cur == 0 {
        return pe_poll_fd(fd, write, timeout_ms);
    }
    // Ready already: no wait at all
    if pe_poll_fd(fd, write, 0) > 0 {
        return 1;
    }
    if pe_ep >= 0 && pe_ep_lock != 0 {
        var w: i64 = 0;
        if write != 0 {
            w = 1;
        }
        var how: i64 = w;
        pe_st(cur + 152, 0);
        if timeout_ms >= 0 {
            how = how + 2;
            var dl0: i64 = pert_clock_now_ms() + timeout_ms;
            if dl0 <= 0 {
                dl0 = 1;
            }
            pe_st(cur + 152, dl0);
        }
        pe_st(cur + 144, how);
        pe_st(cur + 192, 0);
        pe_st(cur + 136, fd + 1);
        pe_co_leave();
        var r: i64 = pe_ep_done(cur, fd, w);
        if r >= 0 {
            return r;
        }
    }
    var dl: i64 = 0;
    if timeout_ms >= 0 {
        dl = pert_clock_now_ms() + timeout_ms;
    }
    while true {
        // Nothing else to run: wait in the kernel a moment
        var ms: i64 = 0;
        if !pe_q_any() {
            ms = 1;
        }
        if pe_poll_fd(fd, write, ms) > 0 {
            return 1;
        }
        if dl != 0 && pert_clock_now_ms() >= dl {
            return 0;
        }
        pe_co_leave();
    }
    return 0;
}

// ─── Token slot (complaint CA7, CA8) ────────────────────────────────────
// A timeout block's token (compiler/lower.fd Lowerer_to_enter) is three
// words: [cancelled][deadline on pert_clock_mono_ms's clock, 0 none][the
// token the slot held before]. The slot is word [28] of the running task's
// block, else word [10] of the thread's block (base.fd pe_tls): a new task
// starts with an empty one. The builtin waits (sleep, await, channel send
// and receive, socket waits) look at the slot's token, and at the ones it
// replaced, at least every 10 ms (a channel's or an await's wait, every
// turn), and give up once one is cancelled or past its deadline, as the C
// runtime's do. With an empty slot they wait as before.

/// The token in the running task's slot (p_task_token), 0 if none.
pub fn pert_task_token() -> i64 {
    var t: i64 = nat_tls_get();
    if t == 0 {
        return 0;
    }
    var c: i64 = pe_ld(t);
    if c != 0 {
        return pe_ld(c + 224);
    }
    return pe_ld(t + 80);
}

/// Put `tok` in the slot (p_task_set_token); the token it held.
pub fn pert_task_set_token(tok: i64) -> i64 {
    var t: i64 = pe_tls();
    var c: i64 = pe_ld(t);
    var at: i64 = t + 80;
    if c != 0 {
        at = c + 224;
    }
    var old: i64 = pe_ld(at);
    pe_st(at, tok);
    return old;
}

/// Whether `tok`, or a token it replaced, is cancelled or past its
/// deadline (a token past its deadline is marked cancelled).
fn pe_tok_cancelled(tok: i64) -> bool {
    var t: i64 = tok;
    var depth: i64 = 0;
    var now: i64 = 0;
    while t != 0 && depth < 64 {
        if nat_atomic_load(t) != 0 {
            return true;
        }
        var dl: i64 = nat_atomic_load(t + 8);
        if dl != 0 {
            if now == 0 {
                now = pert_clock_mono_ms();
            }
            if now >= dl {
                nat_atomic_store(t, 1);
                return true;
            }
        }
        t = nat_atomic_load(t + 16);
        depth = depth + 1;
    }
    return false;
}

/// The next slice of a wait of `left` ms (-1: no limit) under `tok`: 10
/// ms at most, and no later than the first deadline of its chain.
fn pe_tok_slice(tok: i64, left: i64) -> i64 {
    var s: i64 = 10;
    if left >= 0 && left < s {
        s = left;
    }
    var now: i64 = pert_clock_mono_ms();
    var t: i64 = tok;
    var depth: i64 = 0;
    while t != 0 && depth < 64 {
        var dl: i64 = nat_atomic_load(t + 8);
        if dl != 0 {
            var r: i64 = 0;
            if dl > now {
                r = dl - now;
            }
            if r < s {
                s = r;
            }
        }
        t = nat_atomic_load(t + 16);
        depth = depth + 1;
    }
    return s;
}

// ─── Task chain of a panic (complaint CA9) ──────────────────────────────
// A panic's trace shows only the running task's own stack. pe_co_print_chain
// (called by base.fd pert_panic and pe_on_signal after the trace) prints the
// tasks it runs for, as the C runtime's __p_co_print_chain: the one
// awaiting it ([26]), else the one whose turn it runs in ([29]; both are
// alive while they wait), up to the code outside tasks (`main`, or
// `(thread)` off the main thread), or to the task that started it and has
// not awaited it (`(started by f)`):
//     task chain: b <- a <- main

/// A task's name to fd, without the `__task` of an adapted task function.
fn pe_co_put_name(fd: i64, name: i64) {
    if name == 0 {
        return;
    }
    var n: i64 = pe_len(name);
    if n > 6 {
        var e: i64 = name + n - 6;
        if pe_ldb(e) == 95 && pe_ldb(e + 1) == 95 && pe_ldb(e + 2) == 116 && pe_ldb(e + 3) == 97 && pe_ldb(e + 4) == 115 && pe_ldb(e + 5) == 107 {
            n = n - 6;
        }
    }
    pe_write_all(fd, name, n);
}

/// `task chain: ...` on fd when a task is running; nothing otherwise.
pub fn pe_co_print_chain(fd: i64) {
    var c: i64 = pe_co_self();
    if c == 0 {
        return;
    }
    pe_write_all(fd, "task chain: " as i64, 12);
    var depth: i64 = 0;
    var more: bool = true;
    while more {
        pe_co_put_name(fd, pe_ld(c + 200));
        var next: i64 = pe_ld(c + 208);
        if next == 0 {
            next = pe_ld(c + 232);
        }
        if next != 0 && depth < 64 {
            pe_write_all(fd, " <- " as i64, 4);
            c = next;
            depth = depth + 1;
        } else {
            var starter: i64 = pe_ld(c + 216);
            if next != 0 {
                pe_write_all(fd, " <- ..." as i64, 7);
            } else if starter > 1 {
                pe_write_all(fd, " (started by " as i64, 13);
                pe_co_put_name(fd, starter);
                pe_write_all(fd, ")" as i64, 1);
            } else if starter == 1 {
                pe_write_all(fd, " <- (thread)" as i64, 12);
            } else {
                pe_write_all(fd, " <- main" as i64, 8);
            }
            more = false;
        }
    }
    pe_write_all(fd, "\n" as i64, 1);
}

// ─── Futures and executors ──────────────────────────────────────────────

pub fn pert_future_ready(value: i64) -> i64 {
    return value;
}

pub fn pert_future_poll(f: i64) -> i64 {
    if pe_is_co_future(f) {
        return pe_co_await(f);
    }
    if f >= 0 {
        return f;
    }
    var idx: i64 = pe_task_index(f);
    if idx < 0 {
        return 0;
    }
    return pe_join(idx);
}

pub fn pert_task_poll(f: i64) -> i64 {
    return pert_future_poll(f);
}

pub fn pert_task_is_ready(f: i64) -> bool {
    if pe_is_co_future(f) {
        return nat_atomic_load((f & 0xFFFFFFFFFFFF) + 80) != 0;
    }
    if f >= 0 {
        return true;
    }
    var idx: i64 = pe_task_index(f);
    if idx < 0 {
        return false;
    }
    return pe_task_done(idx);
}

pub fn pert_task_poll_nonblocking(f: i64) -> i64 {
    if pe_is_co_future(f) {
        if nat_atomic_load((f & 0xFFFFFFFFFFFF) + 80) == 0 {
            return pe_pending();
        }
        return pe_co_await(f);
    }
    if f >= 0 {
        return f;
    }
    var idx: i64 = pe_task_index(f);
    if idx < 0 {
        return 0;
    }
    if !pe_task_done(idx) {
        return pe_pending();
    }
    return pe_join(idx);
}

pub fn pert_executor_new() -> i64 {
    var e: i64 = pert_executor_count;
    pert_executor_count = e + 1;
    return e;
}

pub fn pert_executor_block_on(exec: i64, f: i64) -> i64 {
    return pert_future_poll(f);
}

/// Join every thread and task still running; the number joined. `spawn
/// scope { }` exits through here.
pub fn pert_executor_run_all(exec: i64) -> i64 {
    var count: i64 = 0;
    var n: i64 = pe_thread_count();
    var i: i64 = 0;
    while i < n {
        if pe_unjoined(i) {
            pe_join(i);
            count = count + 1;
        }
        i = i + 1;
    }
    var joined: i64 = 0;
    if pe_co_live != 0 {
        joined = nat_atomic_load(pe_co_live);
    }
    pe_co_drain();
    return count + joined;
}

/// Join the finished threads; the number still running.
pub fn pert_executor_poll_all(exec: i64) -> i64 {
    var pending: i64 = 0;
    var n: i64 = pe_thread_count();
    var i: i64 = 0;
    while i < n {
        if pe_unjoined(i) {
            if pe_task_done(i) {
                pe_join(i);
            } else {
                pending = pending + 1;
            }
        }
        i = i + 1;
    }
    return pending;
}

/// Cancel the tasks of a scope: a task cannot be stopped mid-way, so wait
/// for those still running, drop their results (0), and return how many
/// were cancelled.
pub fn pert_executor_cancel(exec: i64) -> i64 {
    var count: i64 = 0;
    var n: i64 = pe_thread_count();
    var i: i64 = 0;
    while i < n {
        if pe_unjoined(i) {
            var was_done: bool = pe_task_done(i);
            pe_join(i);
            if !was_done {
                pe_st(pert_task_results + i * 8, 0);
                count = count + 1;
            }
        }
        i = i + 1;
    }
    return count;
}

// ─── Shared memory, atomics, mutexes, thread-local storage ─────────────

pub fn pert_shared_alloc(size: i64) -> i64 {
    if size < 0 {
        return 0;
    }
    return pert_malloc(size);
}

pub fn pert_atomic_load(addr: i64) -> i64 {
    pe_rnd_jitter();
    return nat_atomic_load(addr);
}

pub fn pert_atomic_store(addr: i64, value: i64) {
    pe_rnd_jitter();
    nat_atomic_store(addr, value);
}

/// The previous value.
pub fn pert_atomic_add(addr: i64, value: i64) -> i64 {
    pe_rnd_jitter();
    return nat_atomic_add(addr, value);
}

/// The previous value.
pub fn pert_atomic_sub(addr: i64, value: i64) -> i64 {
    return nat_atomic_add(addr, 0 - value);
}

pub fn pert_atomic_cas(addr: i64, expected: i64, new_value: i64) -> bool {
    pe_rnd_jitter();
    return nat_atomic_cas(addr, expected, new_value) != 0;
}

/// A mutex: a futex word, 0 free, 1 held, 2 held with waiters (not
/// recursive). A thread waits asleep in the kernel; a task (or a thread
/// with tasks to run) lets the others run, so a task holding it across a
/// yield gets to release it.
pub fn pert_mutex_init() -> i64 {
    pe_mt_on();
    return pe_zeroed(1);
}

pub fn pert_mutex_lock(m: i64) {
    pe_rnd_jitter();
    if nat_atomic_cas(m, 0, 1) != 0 {
        return;
    }
    while true {
        if pe_co_self() != 0 || pe_q_any() {
            pe_relax();
            if nat_atomic_cas(m, 0, 1) != 0 {
                return;
            }
        } else {
            if pe_xchg(m, 2) == 0 {
                return;
            }
            pe_futex_wait(m, 2, 20, true);
        }
    }
}

pub fn pert_mutex_unlock(m: i64) {
    if nat_atomic_add(m, 0 - 1) != 1 {
        nat_atomic_store(m, 0);
        pe_futex_wake(m, 1);
    }
    pe_rnd_jitter();
}

// Thread-local storage keys: each thread's block holds its table of 64
// values ([32]); key k is 1..63.
var pe_tls_keys: i64 = 0;  // *i64

pub fn pert_tls_create() -> i64 {
    if pe_tls_keys == 0 {
        pe_mt_on();
        pe_tls_keys = pe_zeroed(1);
    }
    var k: i64 = nat_atomic_add(pe_tls_keys, 1) + 1;
    if k >= 64 {
        return 0 - 1;
    }
    return k;
}

fn pe_tls_table() -> i64 {
    var t: i64 = pe_tls();
    if pe_ld(t + 32) == 0 {
        pe_st(t + 32, pe_zeroed(64));
    }
    return pe_ld(t + 32);
}

pub fn pert_tls_get(key: i64) -> i64 {
    if key < 1 || key >= 64 {
        return 0;
    }
    return pe_ld(pe_tls_table() + key * 8);
}

pub fn pert_tls_set(key: i64, value: i64) {
    if key < 1 || key >= 64 {
        return;
    }
    pe_st(pe_tls_table() + key * 8, value);
}

// ─── Channels ───────────────────────────────────────────────────────────
// [0] lock, [1] change counter (a futex), [2] waiters, [3] head (next
// read), [4] tail (next write), [5] count, [6] capacity, [7] closed,
// [8..] buffer. The lock is held only to look and change; a waiter reads
// the counter, looks, and sleeps on the counter if nothing it wants is
// there: a change in between makes the sleep return at once.

pub fn pert_chan_create(capacity: i64) -> i64 {
    var cap: i64 = capacity;
    if cap < 1 {
        cap = 1;
    }
    pe_mt_on();
    var ch: i64 = pe_zeroed(8 + cap);
    pe_st(ch + 48, cap);
    return ch;
}

/// After a change: the counter moves, waiters wake.
fn pe_chan_changed(ch: i64) {
    nat_atomic_add(ch + 8, 1);
    if nat_atomic_load(ch + 16) > 0 {
        pe_futex_wake(ch + 8, 2147483647);
    }
}

fn pe_chan_wait(ch: i64, seen: i64) {
    nat_atomic_add(ch + 16, 1);
    pe_wait_word(ch + 8, seen, 20);
    nat_atomic_add(ch + 16, 0 - 1);
}

/// CA7: pe_chan_wait under token `tok` (0: none), at most a slice of it.
fn pe_chan_wait_tok(ch: i64, seen: i64, tok: i64) {
    if tok == 0 {
        pe_chan_wait(ch, seen);
        return;
    }
    nat_atomic_add(ch + 16, 1);
    pe_wait_word(ch + 8, seen, pe_tok_slice(tok, 20));
    nat_atomic_add(ch + 16, 0 - 1);
}

/// Wait until there is room or the channel is closed; false if closed, or
/// (CA7) once the token in the slot is cancelled.
pub fn pert_chan_send(ch: i64, value: i64) -> bool {
    if ch == 0 {
        return false;
    }
    pe_rnd_jitter();
    var tok: i64 = pert_task_token();
    var seen: i64 = nat_atomic_load(ch + 8);
    pe_lock(ch);
    while pe_ld(ch + 40) == pe_ld(ch + 48) && pe_ld(ch + 56) == 0 {
        pe_unlock(ch);
        if tok != 0 && pe_tok_cancelled(tok) {
            return false;
        }
        pe_chan_wait_tok(ch, seen, tok);
        seen = nat_atomic_load(ch + 8);
        pe_lock(ch);
    }
    if pe_ld(ch + 56) != 0 {
        pe_unlock(ch);
        return false;
    }
    var tail: i64 = pe_ld(ch + 32);
    pe_st(ch + 64 + tail * 8, value);
    pe_st(ch + 32, (tail + 1) % pe_ld(ch + 48));
    pe_st(ch + 40, pe_ld(ch + 40) + 1);
    pe_unlock(ch);
    pe_chan_changed(ch);
    return true;
}

/// The oldest value (the lock held).
fn pe_chan_take(ch: i64) -> i64 {
    var head: i64 = pe_ld(ch + 24);
    var value: i64 = pe_ld(ch + 64 + head * 8);
    pe_st(ch + 24, (head + 1) % pe_ld(ch + 48));
    pe_st(ch + 40, pe_ld(ch + 40) - 1);
    return value;
}

/// Wait until there is a value or the channel is closed and empty (then
/// the pending value; CA7: also once the token in the slot is cancelled).
pub fn pert_chan_recv(ch: i64) -> i64 {
    if ch == 0 {
        return 0;
    }
    pe_rnd_jitter();
    var tok: i64 = pert_task_token();
    var seen: i64 = nat_atomic_load(ch + 8);
    pe_lock(ch);
    while pe_ld(ch + 40) == 0 && pe_ld(ch + 56) == 0 {
        pe_unlock(ch);
        if tok != 0 && pe_tok_cancelled(tok) {
            return pe_pending();
        }
        pe_chan_wait_tok(ch, seen, tok);
        seen = nat_atomic_load(ch + 8);
        pe_lock(ch);
    }
    if pe_ld(ch + 40) == 0 {
        pe_unlock(ch);
        return pe_pending();
    }
    var value: i64 = pe_chan_take(ch);
    pe_unlock(ch);
    pe_chan_changed(ch);
    return value;
}

/// A value if one is waiting; else 0 if closed, the pending value if not.
pub fn pert_chan_try_recv(ch: i64) -> i64 {
    if ch == 0 {
        return pe_pending();
    }
    pe_lock(ch);
    if pe_ld(ch + 40) == 0 {
        var closed: i64 = pe_ld(ch + 56);
        pe_unlock(ch);
        if closed != 0 {
            return 0;
        }
        return pe_pending();
    }
    var value: i64 = pe_chan_take(ch);
    pe_unlock(ch);
    pe_chan_changed(ch);
    return value;
}

pub fn pert_chan_close(ch: i64) {
    if ch == 0 {
        return;
    }
    pe_lock(ch);
    pe_st(ch + 56, 1);
    pe_unlock(ch);
    pe_chan_changed(ch);
}

pub fn pert_chan_is_closed(ch: i64) -> bool {
    if ch == 0 {
        return true;
    }
    return nat_atomic_load(ch + 56) != 0;
}
