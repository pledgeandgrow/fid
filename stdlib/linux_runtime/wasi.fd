// stdlib/linux_runtime/wasi.fd — the Linux runtime under WASI (release F9)
//
// `fid wasm` (compiler/wasm.fd): the Fides runtime of this directory in a
// WebAssembly module, unchanged. Its system calls (nat_syscall) come here,
// to pe_wasi_syscall, which does each with WASI preview 1
// (wasi_snapshot_preview1): the extern "C" functions named wasi_<name> are
// those imports, compiler/wasm.fd passes each argument as the import's
// type (pointers and sizes as i32). The process's arguments and
// environment are laid out as Linux starts a process (nat_start_sp: argc,
// argv, NULL, envp, NULL). Memory: mmap takes from the free regions munmap
// gave back, else grows the linear memory (XT31, "free regions" below); a
// file's mmap is a copy read with fd_read. The builtins, their system
// calls and WASI functions: docs/reference/wasi.md (XT32). Paths go to the
// preopened directories as wasi-libc sends them (scripts/wasm-run.mjs
// preopens ".", "/" and "/tmp"). Errors are -errno as
// on Linux. A task switches stacks (compiler/wasm.fd "Tasks": the WASM
// stack is unwound and rewound, asyncify-style); a thread still runs to
// its end when it starts (compiler/wasm.fd: nat_clone_thread). Processes
// are a panic `not available in WebAssembly: processes (...)`; signals
// and sockets fail with ENOSYS. Merged only for this target.

extern "C" {
    fn wasi_fd_write(fd: i64, iovs: i64, n: i64, nwritten: i64) -> i64;
    fn wasi_fd_read(fd: i64, iovs: i64, n: i64, nread: i64) -> i64;
    fn wasi_fd_close(fd: i64) -> i64;
    fn wasi_fd_seek(fd: i64, offset: i64, whence: i64, newoffset: i64) -> i64;
    fn wasi_fd_readdir(fd: i64, buf: i64, len: i64, cookie: i64, used: i64) -> i64;
    fn wasi_path_open(dirfd: i64, dirflags: i64, path: i64, path_len: i64, oflags: i64, base: i64, inheriting: i64, fdflags: i64, fd_out: i64) -> i64;
    fn wasi_path_filestat_get(fd: i64, flags: i64, path: i64, path_len: i64, buf: i64) -> i64;
    fn wasi_path_unlink_file(fd: i64, path: i64, path_len: i64) -> i64;
    fn wasi_path_remove_directory(fd: i64, path: i64, path_len: i64) -> i64;
    fn wasi_path_create_directory(fd: i64, path: i64, path_len: i64) -> i64;
    fn wasi_path_rename(fd: i64, old: i64, old_len: i64, fd2: i64, new_path: i64, new_len: i64) -> i64;
    fn wasi_proc_exit(code: i64);
    fn wasi_clock_time_get(id: i64, precision: i64, out: i64) -> i64;
    fn wasi_random_get(buf: i64, len: i64) -> i64;
    fn wasi_args_sizes_get(argc: i64, size: i64) -> i64;
    fn wasi_args_get(argv: i64, buf: i64) -> i64;
    fn wasi_environ_sizes_get(n: i64, size: i64) -> i64;
    fn wasi_environ_get(env: i64, buf: i64) -> i64;
    fn wasi_sched_yield() -> i64;
    fn wasi_poll_oneoff(subs: i64, events: i64, n: i64, nevents: i64) -> i64;
    fn wasi_fd_prestat_get(fd: i64, buf: i64) -> i64;
    fn wasi_fd_prestat_dir_name(fd: i64, path: i64, len: i64) -> i64;
    fn nat_wasm_grow(pages: i64) -> i64;
    fn nat_wasm_size() -> i64;
    fn nat_wasm_zero(addr: i64, n: i64);
}

// Scratch words for the calls (iovecs, results), the process image, the
// path of the last call, and the cursor of a directory being read
var pe_wasi_tmp: i64 = 0;
var pe_wasi_sp: i64 = 0;
var pe_wasi_pfd: i64 = 3;
var pe_wasi_pptr: i64 = 0;
var pe_wasi_plen: i64 = 0;
var pe_wasi_dir_fd: i64 = 0 - 1;
var pe_wasi_dir_cookie: i64 = 0;
var pe_wasi_dir_buf: i64 = 0;

/// A page of its own (not the heap: a system call may run with the heap's
/// lock held): scratch words at 0, the free regions at 1024
fn pe_wasi_scratch() -> i64 {
    if pe_wasi_tmp == 0 {
        pe_wasi_tmp = nat_wasm_grow(1) * 65536;
    }
    return pe_wasi_tmp;
}

// XT31: the linear memory's free regions. WASM memory grows (memory.grow)
// and never shrinks, so munmap gives a region back to this list and mmap
// takes from it before it grows the memory: [start, size] pairs of whole
// 64 KB pages at scratch + 1024, sorted by start, neighbours merged (a
// region never touches the next one). mmap takes the smallest region that
// fits (split: the rest stays free), zeroed as fresh pages are; when none
// fits and the last region ends where the memory does, the memory grows
// by what that region lacks. Freed blocks of any size are thus reused by
// blocks of any other (the allocator's chunks, large blocks, task stacks),
// and a program that frees what it allocates does not grow the memory
// again. Out of memory (memory.grow refuses: past 4 GB, or the host's
// limit) is -ENOMEM: the allocator stops the program with "out of memory
// (<n> bytes requested)" (base.fd pe_oom).
const PE_WASI_REGIONS: i64 = 4032;  // (65536 - 1024) / 16
var pe_wasi_nreg: i64 = 0;

/// Region i out of the list
fn pe_wasi_reg_del(tab: i64, i: i64) {
    var j: i64 = i;
    while j + 1 < pe_wasi_nreg {
        pe_st(tab + j * 16, pe_ld(tab + j * 16 + 16));
        pe_st(tab + j * 16 + 8, pe_ld(tab + j * 16 + 24));
        j = j + 1;
    }
    pe_wasi_nreg = pe_wasi_nreg - 1;
}

/// A region [a, a + size) into the list at index i
fn pe_wasi_reg_ins(tab: i64, i: i64, a: i64, size: i64) {
    var j: i64 = pe_wasi_nreg;
    while j > i {
        pe_st(tab + j * 16, pe_ld(tab + j * 16 - 16));
        pe_st(tab + j * 16 + 8, pe_ld(tab + j * 16 - 8));
        j = j - 1;
    }
    pe_st(tab + i * 16, a);
    pe_st(tab + i * 16 + 8, size);
    pe_wasi_nreg = pe_wasi_nreg + 1;
}

/// mmap: a free region (the smallest that fits, zeroed), else the last
/// free region grown at the end of the memory, else new pages
fn pe_wasi_mmap(len: i64) -> i64 {
    if len <= 0 {
        return 0 - 22;
    }  // EINVAL
    // more than wasm32's 4 GB (65536 pages): no page count to ask for
    if len > 4294967296 {
        return 0 - 12;
    }
    var size: i64 = ((len + 65535) / 65536) * 65536;
    var tab: i64 = pe_wasi_scratch() + 1024;
    var best: i64 = 0 - 1;
    var bs: i64 = 0;
    var i: i64 = 0;
    while i < pe_wasi_nreg {
        var s: i64 = pe_ld(tab + i * 16 + 8);
        if s >= size && (best < 0 || s < bs) {
            best = i;
            bs = s;
        }
        i = i + 1;
    }
    if best >= 0 {
        var a: i64 = pe_ld(tab + best * 16);
        if bs == size {
            pe_wasi_reg_del(tab, best);
        } else {
            pe_st(tab + best * 16, a + size);
            pe_st(tab + best * 16 + 8, bs - size);
        }
        nat_wasm_zero(a, size);
        return a;
    }
    if pe_wasi_nreg > 0 {
        var last: i64 = pe_wasi_nreg - 1;
        var la: i64 = pe_ld(tab + last * 16);
        var ls: i64 = pe_ld(tab + last * 16 + 8);
        if la + ls == nat_wasm_size() * 65536 {
            if nat_wasm_grow((size - ls) / 65536) < 0 {
                return 0 - 12;
            }
            pe_wasi_reg_del(tab, last);
            nat_wasm_zero(la, ls);
            return la;
        }
    }
    var old: i64 = nat_wasm_grow(size / 65536);
    if old < 0 {
        return 0 - 12;
    }
    return old * 65536;
}

/// mmap of a file (XT32: WASI has no mappings): `len` new pages holding
/// the file's bytes from `off` (zero past its end), read with fd_read; the
/// descriptor's offset is put back. A private copy: a write to the pages
/// does not reach the file, as MAP_PRIVATE; munmap frees it as any region.
fn pe_wasi_mmap_file(len: i64, fd: i64, off: i64) -> i64 {
    var a: i64 = pe_wasi_mmap(len);
    if a < 0 {
        return a;
    }
    var t: i64 = pe_wasi_scratch();
    if wasi_fd_seek(fd, 0, 1, t) != 0 {
        pe_wasi_munmap(a, len);
        return 0 - 19;
    }  // ENODEV: not a file
    var pos: i64 = pe_ld(t);
    if wasi_fd_seek(fd, off, 0, t) != 0 {
        pe_wasi_munmap(a, len);
        return 0 - 22;
    }
    var got: i64 = 0;
    while got < len {
        var r: i64 = pe_wasi_rw(false, fd, a + got, len - got);
        if r <= 0 {
            break;
        }
        got = got + r;
    }
    wasi_fd_seek(fd, pos, 0, pe_wasi_scratch());
    return a;
}

/// sysinfo (sysconf's _SC_PHYS_PAGES, _SC_AVPHYS_PAGES): the generic Linux
/// struct (totalram at 32, freeram at 40, mem_unit at 104) of the linear
/// memory: wasm32's 4 GB in all, free what it has not grown to yet
fn pe_wasi_sysinfo(si: i64) -> i64 {
    pe_zero(si, 112);
    pe_st(si + 32, 4294967296);
    pe_st(si + 40, 4294967296 - nat_wasm_size() * 65536);
    pe_st(si + 104, 1);
    return 0;
}

/// munmap: the whole pages of [addr, addr + len) back to the free list,
/// merged with the regions next to them (the length to the next 64 KB, as
/// mmap rounded it). A range already free, in part or whole, is left alone.
fn pe_wasi_munmap(addr: i64, len: i64) -> i64 {
    if len <= 0 {
        return 0 - 22;
    }
    var start: i64 = ((addr + 65535) / 65536) * 65536;
    var end: i64 = ((addr + len + 65535) / 65536) * 65536;
    if end <= start || start <= 0 {
        return 0;
    }
    var tab: i64 = pe_wasi_scratch() + 1024;
    // the first region after start
    var i: i64 = 0;
    while i < pe_wasi_nreg && pe_ld(tab + i * 16) < start {
        i = i + 1;
    }
    var join_prev: bool = false;
    if i > 0 {
        var pa: i64 = pe_ld(tab + i * 16 - 16);
        var pend: i64 = pa + pe_ld(tab + i * 16 - 8);
        if pend > start {
            return 0;
        }  // freed twice
        join_prev = pend == start;
    }
    var join_next: bool = false;
    if i < pe_wasi_nreg {
        var na: i64 = pe_ld(tab + i * 16);
        if na < end {
            return 0;
        }  // freed twice
        join_next = na == end;
    }
    if join_prev && join_next {
        pe_st(tab + i * 16 - 8, pe_ld(tab + i * 16) + pe_ld(tab + i * 16 + 8) - pe_ld(tab + i * 16 - 16));
        pe_wasi_reg_del(tab, i);
    } else if join_prev {
        pe_st(tab + i * 16 - 8, end - pe_ld(tab + i * 16 - 16));
    } else if join_next {
        pe_st(tab + i * 16 + 8, pe_ld(tab + i * 16) + pe_ld(tab + i * 16 + 8) - start);
        pe_st(tab + i * 16, start);
    } else if pe_wasi_nreg < PE_WASI_REGIONS {
        pe_wasi_reg_ins(tab, i, start, end - start);
    }
    // (a full list keeps the region out: it stays mapped, unused)
    return 0;
}

fn pe_wasi_ld32(addr: i64) -> i64 {
    return pe_ld(addr) & 4294967295;
}

/// A WASI errno as -errno of Linux
fn pe_wasi_err(e: i64) -> i64 {
    if e == 0 {
        return 0;
    }
    if e == 2 {
        return 0 - 13;
    }  // EACCES
    if e == 6 {
        return 0 - 11;
    }  // EAGAIN
    if e == 8 {
        return 0 - 9;
    }  // EBADF
    if e == 20 {
        return 0 - 17;
    }  // EEXIST
    if e == 27 {
        return 0 - 4;
    }  // EINTR
    if e == 28 {
        return 0 - 22;
    }  // EINVAL
    if e == 29 {
        return 0 - 5;
    }  // EIO
    if e == 31 {
        return 0 - 21;
    }  // EISDIR
    if e == 44 {
        return 0 - 2;
    }  // ENOENT
    if e == 48 {
        return 0 - 12;
    }  // ENOMEM
    if e == 51 {
        return 0 - 28;
    }  // ENOSPC
    if e == 52 {
        return 0 - 38;
    }  // ENOSYS
    if e == 54 {
        return 0 - 20;
    }  // ENOTDIR
    if e == 55 {
        return 0 - 39;
    }  // ENOTEMPTY
    if e == 63 {
        return 0 - 1;
    }  // EPERM
    if e == 76 {
        return 0 - 13;
    }  // ENOTCAPABLE
    return 0 - 5;
}

/// The preopened directories: [n], then [fd, name, length] each (as
/// wasi-libc finds them: fd 3 on, until fd_prestat_get fails)
var pe_wasi_pre: i64 = 0;

fn pe_wasi_preopens() -> i64 {
    if pe_wasi_pre != 0 {
        return pe_wasi_pre;
    }
    var tab: i64 = pert_malloc(8 + 16 * 24);
    var buf: i64 = pert_malloc(16);
    var n: i64 = 0;
    var fd: i64 = 3;
    while n < 16 {
        pe_zero(buf, 16);
        if wasi_fd_prestat_get(fd, buf) != 0 {
            break;
        }
        var len: i64 = pe_wasi_ld32(buf + 4);
        var name: i64 = pert_malloc(len + 1);
        wasi_fd_prestat_dir_name(fd, name, len);
        pe_stb(name + len, 0);
        while len > 1 && pe_ldb(name + len - 1) == 47 {
            len = len - 1;
        }
        pe_st(tab + 8 + n * 24, fd);
        pe_st(tab + 16 + n * 24, name);
        pe_st(tab + 24 + n * 24, len);
        n = n + 1;
        fd = fd + 1;
    }
    pert_free(buf);
    pe_st(tab, n);
    pe_wasi_pre = tab;
    return tab;
}

/// The directory and relative path of `path` for the path calls:
/// pe_wasi_pfd, pe_wasi_pptr, pe_wasi_plen. An absolute path is relative to
/// the preopened directory whose name is its longest prefix ("/tmp" for
/// "/tmp/x", "/" for anything else), a relative one to ".".
fn pe_wasi_path(path: i64) {
    var tab: i64 = pe_wasi_preopens();
    var count: i64 = pe_ld(tab);
    var p: i64 = path;
    var fd: i64 = 3;
    var i: i64 = 0;
    if pe_ldb(p) == 47 {
        var best: i64 = 0 - 1;
        while i < count {
            var name: i64 = pe_ld(tab + 16 + i * 24);
            var len: i64 = pe_ld(tab + 24 + i * 24);
            if pe_ldb(name) == 47 && len > best {
                var j: i64 = 0;
                while j < len && pe_ldb(name + j) == pe_ldb(p + j) {
                    j = j + 1;
                }
                if j == len && (len == 1 || pe_ldb(p + len) == 0 || pe_ldb(p + len) == 47) {
                    best = len;
                    fd = pe_ld(tab + 8 + i * 24);
                }
            }
            i = i + 1;
        }
        if best > 0 {
            p = p + best;
        }
        while pe_ldb(p) == 47 {
            p = p + 1;
        }
    } else {
        while i < count {
            var dname: i64 = pe_ld(tab + 16 + i * 24);
            if pe_ld(tab + 24 + i * 24) == 1 && pe_ldb(dname) == 46 {
                fd = pe_ld(tab + 8 + i * 24);
            }
            i = i + 1;
        }
    }
    while pe_ldb(p) == 46 && pe_ldb(p + 1) == 47 {
        p = p + 2;
        while pe_ldb(p) == 47 {
            p = p + 1;
        }
    }
    var n: i64 = 0;
    while pe_ldb(p + n) != 0 {
        n = n + 1;
    }
    if n == 0 {
        p = "." as i64;
        n = 1;
    }
    pe_wasi_pfd = fd;
    pe_wasi_pptr = p;
    pe_wasi_plen = n;
}

/// The WASI filetype of path (0 when it does not exist)
fn pe_wasi_filetype(path: i64) -> i64 {
    pe_wasi_path(path);
    var buf: i64 = pert_malloc(64);
    var e: i64 = wasi_path_filestat_get(pe_wasi_pfd, 1, pe_wasi_pptr, pe_wasi_plen, buf);
    var t: i64 = 0;
    if e == 0 {
        t = pe_ldb(buf + 16);
    }
    pert_free(buf);
    return t;
}

fn pe_wasi_openat(path: i64, flags: i64) -> i64 {
    // O_DIRECTORY (generic 0x4000), or a directory opened to be read
    var oflags: i64 = 0;
    if (flags & 64) != 0 {
        oflags = oflags | 1;
    }  // O_CREAT
    if (flags & 128) != 0 {
        oflags = oflags | 4;
    }  // O_EXCL
    if (flags & 512) != 0 {
        oflags = oflags | 8;
    }  // O_TRUNC
    if (flags & 16384) != 0 || ((flags & 3) == 0 && pe_wasi_filetype(path) == 3) {
        oflags = oflags | 2;
    }
    var fdflags: i64 = 0;
    if (flags & 1024) != 0 {
        fdflags = 1;
    }  // O_APPEND
    pe_wasi_path(path);
    var out: i64 = pe_wasi_scratch();
    // Rights: every one but sock_shutdown (bits 0..27; Node refuses a file
    // the bit 28 asks for with ENOTCAPABLE). A directory asks for none of
    // the write rights (fd_datasync 0, fd_write 6, fd_allocate 8,
    // fd_filestat_set_size 22): wasmtime refuses a directory opened with
    // them with EISDIR, and the listing came back empty (XT32)
    var base: i64 = 268435455;
    if (oflags & 2) != 0 {
        base = 264240830;
    }
    var e: i64 = wasi_path_open(pe_wasi_pfd, 1, pe_wasi_pptr, pe_wasi_plen, oflags, base, 268435455, fdflags, out);
    if e != 0 {
        return pe_wasi_err(e);
    }
    return pe_wasi_ld32(out);
}

/// The generic Linux struct stat of path (st_mode at 16, st_size at 48,
/// st_mtime at 88)
fn pe_wasi_stat(path: i64, st: i64, flags: i64) -> i64 {
    pe_wasi_path(path);
    var buf: i64 = pert_malloc(64);
    var follow: i64 = 1;
    if (flags & 256) != 0 {
        follow = 0;
    }  // AT_SYMLINK_NOFOLLOW
    var e: i64 = wasi_path_filestat_get(pe_wasi_pfd, follow, pe_wasi_pptr, pe_wasi_plen, buf);
    if e != 0 {
        pert_free(buf);
        return pe_wasi_err(e);
    }
    pe_zero(st, 128);
    var t: i64 = pe_ldb(buf + 16);
    var mode: i64 = 33188;  // S_IFREG | 0644
    if t == 3 {
        mode = 16877;
    }  // S_IFDIR | 0755
    if t == 7 {
        mode = 41471;
    }  // S_IFLNK | 0777
    pe_st(st, pe_ld(buf));
    pe_st(st + 8, pe_ld(buf + 8));
    pe_st(st + 16, mode | (1 << 32));
    pe_st(st + 48, pe_ld(buf + 32));
    pe_st(st + 56, 4096);
    pe_st(st + 64, (pe_ld(buf + 32) + 511) / 512);
    var at: i64 = pe_ld(buf + 40);
    var mt: i64 = pe_ld(buf + 48);
    var ct: i64 = pe_ld(buf + 56);
    pe_st(st + 72, at / 1000000000);
    pe_st(st + 80, at % 1000000000);
    pe_st(st + 88, mt / 1000000000);
    pe_st(st + 96, mt % 1000000000);
    pe_st(st + 104, ct / 1000000000);
    pe_st(st + 112, ct % 1000000000);
    pert_free(buf);
    return 0;
}

/// getdents64 over fd_readdir: Linux records (d_ino, d_off, d_reclen,
/// d_type, d_name NUL) from WASI's (d_next, d_ino, d_namlen, d_type, name)
fn pe_wasi_getdents(fd: i64, out: i64, count: i64) -> i64 {
    if pe_wasi_dir_fd != fd {
        pe_wasi_dir_fd = fd;
        pe_wasi_dir_cookie = 0;
    }
    if pe_wasi_dir_buf == 0 {
        pe_wasi_dir_buf = pert_malloc(4096);
    }
    var buf: i64 = pe_wasi_dir_buf;
    var used_at: i64 = pe_wasi_scratch();
    var e: i64 = wasi_fd_readdir(fd, buf, 4096, pe_wasi_dir_cookie, used_at);
    if e != 0 {
        return pe_wasi_err(e);
    }
    var used: i64 = pe_wasi_ld32(used_at);
    var off: i64 = 0;
    var wrote: i64 = 0;
    while off + 24 <= used {
        var namlen: i64 = pe_wasi_ld32(buf + off + 16);
        if off + 24 + namlen > used {
            break;
        }
        var reclen: i64 = (19 + namlen + 1 + 7) & (0 - 8);
        if wrote + reclen > count {
            break;
        }
        var rec: i64 = out + wrote;
        pe_st(rec, pe_ld(buf + off + 8));
        pe_st(rec + 8, pe_ld(buf + off));
        pe_stb(rec + 16, reclen & 255);
        pe_stb(rec + 17, (reclen >> 8) & 255);
        var t: i64 = pe_ldb(buf + off + 20);
        var dt: i64 = 0;
        if t == 3 {
            dt = 4;
        }
        if t == 4 {
            dt = 8;
        }
        if t == 7 {
            dt = 10;
        }
        pe_stb(rec + 18, dt);
        var i: i64 = 0;
        while i < namlen {
            pe_stb(rec + 19 + i, pe_ldb(buf + off + 24 + i));
            i = i + 1;
        }
        var j: i64 = 19 + namlen;
        while j < reclen {
            pe_stb(rec + j, 0);
            j = j + 1;
        }
        pe_wasi_dir_cookie = pe_ld(buf + off);
        wrote = wrote + reclen;
        off = off + 24 + namlen;
    }
    return wrote;
}

/// nanosleep: poll_oneoff on a relative monotonic clock
fn pe_wasi_sleep(ts: i64) -> i64 {
    var ns: i64 = pe_ld(ts) * 1000000000 + pe_ld(ts + 8);
    if ns <= 0 {
        return 0;
    }
    var sub: i64 = pert_malloc(48);
    pe_zero(sub, 48);
    pe_st(sub + 16, 1);
    pe_st(sub + 24, ns);
    var ev: i64 = pert_malloc(32);
    var n: i64 = pe_wasi_scratch();
    wasi_poll_oneoff(sub, ev, 1, n);
    pert_free(ev);
    pert_free(sub);
    return 0;
}

/// argc, argv[0..argc], NULL, envp..., NULL: as Linux starts a process
pub fn pe_wasi_start_sp() -> i64 {
    if pe_wasi_sp != 0 {
        return pe_wasi_sp;
    }
    var tmp: i64 = pert_malloc(16);
    pe_zero(tmp, 16);
    wasi_args_sizes_get(tmp, tmp + 8);
    var argc: i64 = pe_wasi_ld32(tmp);
    var asize: i64 = pe_wasi_ld32(tmp + 8);
    pe_zero(tmp, 16);
    wasi_environ_sizes_get(tmp, tmp + 8);
    var envc: i64 = pe_wasi_ld32(tmp);
    var esize: i64 = pe_wasi_ld32(tmp + 8);
    pert_free(tmp);
    var abuf: i64 = pert_malloc(asize + 1);
    var aptrs: i64 = pert_malloc(argc * 4 + 8);
    wasi_args_get(aptrs, abuf);
    var ebuf: i64 = pert_malloc(esize + 1);
    var eptrs: i64 = pert_malloc(envc * 4 + 8);
    wasi_environ_get(eptrs, ebuf);
    var sp: i64 = pert_malloc(8 * (argc + envc + 4));
    pe_st(sp, argc);
    var i: i64 = 0;
    while i < argc {
        pe_st(sp + 8 + i * 8, pe_wasi_ld32(aptrs + i * 4));
        i = i + 1;
    }
    pe_st(sp + 8 + argc * 8, 0);
    var at: i64 = sp + 16 + argc * 8;
    i = 0;
    while i < envc {
        pe_st(at + i * 8, pe_wasi_ld32(eptrs + i * 4));
        i = i + 1;
    }
    pe_st(at + envc * 8, 0);
    pe_wasi_sp = sp;
    return sp;
}

/// One iovec {buf, len} at the scratch words; fd_write / fd_read of it
fn pe_wasi_rw(write: bool, fd: i64, buf: i64, n: i64) -> i64 {
    var t: i64 = pe_wasi_scratch();
    pe_st(t, (buf & 4294967295) | (n << 32));
    pe_st(t + 8, 0);
    var e: i64 = 0;
    if write {
        e = wasi_fd_write(fd, t, 1, t + 8);
    } else {
        e = wasi_fd_read(fd, t, 1, t + 8);
    }
    if e != 0 {
        return pe_wasi_err(e);
    }
    return pe_wasi_ld32(t + 8);
}

/// Linux system call n (asm-generic numbering) done with WASI
pub fn pe_wasi_syscall(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    if n == 64 {
        return pe_wasi_rw(true, a, b, c);
    }  // write
    if n == 63 {
        return pe_wasi_rw(false, a, b, c);
    }  // read
    if n == 222 {  // mmap
        // a file (p_fs_map): its bytes read into new pages
        if e >= 0 {
            if (d & 16) != 0 {
                return 0 - 38;
            }
            return pe_wasi_mmap_file(b, e, f);
        }
        // MAP_FIXED (RT7's decommit, base.fd pe_decommit): WASM memory
        // cannot give pages back
        if (d & 16) != 0 {
            return 0 - 38;
        }
        return pe_wasi_mmap(b);
    }
    if n == 215 {
        return pe_wasi_munmap(a, b);
    }  // munmap
    if n == 226 {
        return 0;
    }  // mprotect
    if n == 94 || n == 93 {  // exit_group, exit
        wasi_proc_exit(a);
        return 0;
    }
    if n == 56 {
        return pe_wasi_openat(b, c);
    }  // openat
    if n == 57 {  // close
        if a == pe_wasi_dir_fd {
            pe_wasi_dir_fd = 0 - 1;
        }
        return pe_wasi_err(wasi_fd_close(a));
    }
    if n == 62 {  // lseek
        var t: i64 = pe_wasi_scratch();
        var r: i64 = wasi_fd_seek(a, b, c, t);
        if r != 0 {
            return pe_wasi_err(r);
        }
        return pe_ld(t);
    }
    if n == 113 {  // clock_gettime
        var clk: i64 = 1;
        if a == 0 {
            clk = 0;
        }
        if a == 2 {
            clk = 2;
        }
        if a == 3 {
            clk = 3;
        }
        var t2: i64 = pe_wasi_scratch();
        var r2: i64 = wasi_clock_time_get(clk, 1, t2);
        if r2 != 0 {
            return pe_wasi_err(r2);
        }
        var ns: i64 = pe_ld(t2);
        pe_st(b, ns / 1000000000);
        pe_st(b + 8, ns % 1000000000);
        return 0;
    }
    if n == 278 {  // getrandom
        var r3: i64 = wasi_random_get(a, b);
        if r3 != 0 {
            return pe_wasi_err(r3);
        }
        return b;
    }
    if n == 79 {
        return pe_wasi_stat(b, c, d);
    }  // newfstatat
    if n == 35 {  // unlinkat
        pe_wasi_path(b);
        if (c & 512) != 0 {
            return pe_wasi_err(wasi_path_remove_directory(pe_wasi_pfd, pe_wasi_pptr, pe_wasi_plen));
        }
        return pe_wasi_err(wasi_path_unlink_file(pe_wasi_pfd, pe_wasi_pptr, pe_wasi_plen));
    }
    if n == 34 {  // mkdirat
        pe_wasi_path(b);
        return pe_wasi_err(wasi_path_create_directory(pe_wasi_pfd, pe_wasi_pptr, pe_wasi_plen));
    }
    if n == 276 {  // renameat2
        pe_wasi_path(b);
        var ofd: i64 = pe_wasi_pfd;
        var optr: i64 = pe_wasi_pptr;
        var olen: i64 = pe_wasi_plen;
        pe_wasi_path(d);
        return pe_wasi_err(wasi_path_rename(ofd, optr, olen, pe_wasi_pfd, pe_wasi_pptr, pe_wasi_plen));
    }
    if n == 61 {
        return pe_wasi_getdents(a, b, c);
    }  // getdents64
    if n == 101 {
        return pe_wasi_sleep(a);
    }  // nanosleep
    if n == 124 {
        wasi_sched_yield();
        return 0;
    }  // sched_yield
    if n == 179 {
        return pe_wasi_sysinfo(a);
    }  // sysinfo
    if n == 123 {  // sched_getaffinity
        pe_zero(c, 8);
        pe_stb(c, 1);
        return 8;
    }
    if n == 172 || n == 178 {
        return 1;
    }  // getpid, gettid
    if n == 173 || n == 174 || n == 176 {
        return 0;
    }  // getppid, getuid, getgid
    // rt_sigaction, sigaltstack, futex: nothing to do in one thread
    if n == 134 || n == 132 || n == 98 {
        return 0;
    }
    return 0 - 38;
}

// XT28: a fused multiply-add for math.fd (exp, log, pow are musl's FMA
// variants: pe_fma calls nat_fma). WebAssembly has no fused multiply-add,
// and nat_fma written as a * b + c rounds twice: pow(2, 10) printed
// 1024.0000000000002 (test_ffi). This override of the extern (wasm.fd
// wg_gen_call: pert_c_<C name>) computes a * b exactly as hi + lo
// (Dekker's product over Veltkamp's split), adds c to hi exactly
// (TwoSum) and rounds once at the end: exact where musl relies on it,
// `fma(x, y, -(x * y))` (the product's error) and `fma(z, invc, -1.0)`
// (cancellation), and within one rounding of the fused result otherwise.
// Outside the range where the split is exact (an operand that is not
// finite or is zero, |a| or |b| at 2^995 or more, a product near the
// overflow or the underflow), a * b + c.
pub fn pert_c_nat_fma(ab: i64, bb: i64, cb: i64) -> i64 {
    var a: f64 = p_f64_from_bits(ab);
    var b: f64 = p_f64_from_bits(bb);
    var c: f64 = p_f64_from_bits(cb);
    var ea: i64 = (ab >> 52) & 2047;
    var eb: i64 = (bb >> 52) & 2047;
    var ec: i64 = (cb >> 52) & 2047;
    if ea == 2047 || eb == 2047 || ec == 2047 || ea == 0 || eb == 0 || ea >= 2018 || eb >= 2018 || ea + eb < 1023 + 100 || ea + eb >= 1023 + 2040 {
        return p_f64_to_bits(a * b + c);
    }
    // Veltkamp: x = xh + xl, each half 26 bits or fewer
    var split: f64 = 134217729.0;  // 2^27 + 1
    var ta: f64 = split * a;
    var ah: f64 = ta - (ta - a);
    var al: f64 = a - ah;
    var tb: f64 = split * b;
    var bh: f64 = tb - (tb - b);
    var bl: f64 = b - bh;
    // Dekker: a * b = p + e exactly
    var p: f64 = a * b;
    var e: f64 = ((ah * bh - p) + ah * bl + al * bh) + al * bl;
    // TwoSum: p + c = s + t exactly
    var s: f64 = p + c;
    var v: f64 = s - p;
    var t: f64 = (p - (s - v)) + (c - v);
    return p_f64_to_bits(s + (t + e));
}

// XT28: the 16-bit volatile accesses (stdlib regbus, test_std_cortex_m and
// test_std_aarch64_sys), which the C backend has (codegen_c.fd) and this
// runtime's sys.fd does not: under WASI a plain 2-byte load or store (no
// device memory; one thread). If sys.fd gets them for every target, these
// two go.
pub fn pert_volatile_load16(addr: i64) -> i64 {
    var p: *mut u16 = addr;
    var v: i64 = 0;
    // SAFETY: NOT checked: a raw-address API (MMIO, buffers the caller
    // made), as pert_volatile_load32; the address is the caller's.
    unsafe {
        v = *p;
    }
    return v;
}

pub fn pert_volatile_store16(addr: i64, val: i64) {
    var p: *mut u16 = addr;
    // SAFETY: NOT checked: a raw 2-byte store, as pert_volatile_store32.
    unsafe {
        *p = val;
    }
}
