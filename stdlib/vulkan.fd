// Fides Vulkan: Vulkan 1.3 core bindings plus helpers that need no GPU.
//
// Platform seam: the `extern "C"` block below declares the core entry
// points exported by the Vulkan loader (libvulkan.so.1 on Linux,
// vulkan-1.dll on Windows: link with -lvulkan, or rename vulkan-1.lib;
// MoltenVK's libvulkan on macOS). Running them needs that loader and a
// driver; nothing in the tests calls them. Every Vulkan handle is an i64
// (dispatchable handles are pointers, the others 64-bit integers),
// pointers are i64 addresses, uint32_t parameters are u32, and VkResult
// is i32 (negative values are errors).
//
// Real, tested without a GPU:
//   - the enums and flags of the core API (structure types, results,
//     formats, layouts, access and stage masks, usage flags, ...);
//   - C struct layout: vk_layout(name) computes field offsets, sizes and
//     alignment of the main create-info structs from their field lists
//     (x86-64 / AArch64 C rules: pointers and uint64_t 8 bytes, uint32_t
//     and float 4), and VkBlob writes them, nested arrays and strings
//     included, into one byte image whose internal pointers are
//     relocations; vk_blob_to_mem copies it into C memory and patches the
//     pointers (that is the only unsafe step, done right before a call);
//   - a format table (texel block size and extent, depth/stencil aspects)
//     and image/mip-chain size computation;
//   - image layout transitions: the access masks and pipeline stages of a
//     barrier from one layout to another, and VkImageMemoryBarrier images;
//   - a descriptor set layout builder that checks bindings against the
//     spec's minimum per-stage limits and emits the create-info image;
//   - validation of VkImageCreateInfo / VkBufferCreateInfo parameters
//     against the spec's valid-usage rules (a subset, listed per check).
//
// Usage:
//   use vulkan;
//   var b: VkBlob = vk_blob_new();
//   val ci: i64 = vk_instance_create_info(&mut b, "demo", 1, "fides", 1, VK_API_VERSION_1_3, Vec::new(), exts);
//   val mem: i64 = vk_blob_to_mem(&b);           // C memory, pointers fixed
//   var out: i64 = vk_out_new();
//   val r: i32 = vk_create_instance(mem + ci, 0, out);
//   val instance: i64 = vk_out_read(out);

module vulkan;
use vec;

// ─── Loader entry points (platform seam) ───────────────────────────────────

// SAFETY: each declaration matches the vulkan_core.h prototype it names
// (written by hand: handles and pointers as i64, uint32_t as u32, VkResult
// as i32). Pointer arguments must be live C memory laid out as the API
// requires (vk_blob_to_mem gives such memory).
extern "C" link "vulkan" {
    fn vkEnumerateInstanceVersion as vk_enumerate_instance_version(pApiVersion: i64) -> i32;
    fn vkCreateInstance as vk_create_instance(pCreateInfo: i64, pAllocator: i64, pInstance: i64) -> i32;
    fn vkDestroyInstance as vk_destroy_instance(instance: i64, pAllocator: i64) -> void;
    fn vkGetInstanceProcAddr as vk_get_instance_proc_addr(instance: i64, pName: str) -> i64;
    fn vkEnumeratePhysicalDevices as vk_enumerate_physical_devices(instance: i64, pCount: i64, pDevices: i64) -> i32;
    fn vkGetPhysicalDeviceProperties as vk_get_physical_device_properties(pd: i64, pProperties: i64) -> void;
    fn vkGetPhysicalDeviceQueueFamilyProperties as vk_get_physical_device_queue_family_properties(pd: i64, pCount: i64, pProperties: i64) -> void;
    fn vkGetPhysicalDeviceMemoryProperties as vk_get_physical_device_memory_properties(pd: i64, pProperties: i64) -> void;
    fn vkGetPhysicalDeviceFormatProperties as vk_get_physical_device_format_properties(pd: i64, format: u32, pProperties: i64) -> void;
    fn vkCreateDevice as vk_create_device(pd: i64, pCreateInfo: i64, pAllocator: i64, pDevice: i64) -> i32;
    fn vkDestroyDevice as vk_destroy_device(device: i64, pAllocator: i64) -> void;
    fn vkDeviceWaitIdle as vk_device_wait_idle(device: i64) -> i32;
    fn vkGetDeviceQueue as vk_get_device_queue(device: i64, family: u32, index: u32, pQueue: i64) -> void;
    fn vkQueueSubmit as vk_queue_submit(queue: i64, count: u32, pSubmits: i64, fence: i64) -> i32;
    fn vkQueueSubmit2 as vk_queue_submit2(queue: i64, count: u32, pSubmits: i64, fence: i64) -> i32;
    fn vkQueueWaitIdle as vk_queue_wait_idle(queue: i64) -> i32;
    fn vkAllocateMemory as vk_allocate_memory(device: i64, pInfo: i64, pAllocator: i64, pMemory: i64) -> i32;
    fn vkFreeMemory as vk_free_memory(device: i64, memory: i64, pAllocator: i64) -> void;
    fn vkMapMemory as vk_map_memory(device: i64, memory: i64, offset: i64, size: i64, flags: u32, ppData: i64) -> i32;
    fn vkUnmapMemory as vk_unmap_memory(device: i64, memory: i64) -> void;
    fn vkCreateBuffer as vk_create_buffer(device: i64, pInfo: i64, pAllocator: i64, pBuffer: i64) -> i32;
    fn vkDestroyBuffer as vk_destroy_buffer(device: i64, buffer: i64, pAllocator: i64) -> void;
    fn vkGetBufferMemoryRequirements as vk_get_buffer_memory_requirements(device: i64, buffer: i64, pReq: i64) -> void;
    fn vkBindBufferMemory as vk_bind_buffer_memory(device: i64, buffer: i64, memory: i64, offset: i64) -> i32;
    fn vkCreateImage as vk_create_image(device: i64, pInfo: i64, pAllocator: i64, pImage: i64) -> i32;
    fn vkDestroyImage as vk_destroy_image(device: i64, image: i64, pAllocator: i64) -> void;
    fn vkGetImageMemoryRequirements as vk_get_image_memory_requirements(device: i64, image: i64, pReq: i64) -> void;
    fn vkBindImageMemory as vk_bind_image_memory(device: i64, image: i64, memory: i64, offset: i64) -> i32;
    fn vkCreateImageView as vk_create_image_view(device: i64, pInfo: i64, pAllocator: i64, pView: i64) -> i32;
    fn vkDestroyImageView as vk_destroy_image_view(device: i64, view: i64, pAllocator: i64) -> void;
    fn vkCreateShaderModule as vk_create_shader_module(device: i64, pInfo: i64, pAllocator: i64, pModule: i64) -> i32;
    fn vkDestroyShaderModule as vk_destroy_shader_module(device: i64, module: i64, pAllocator: i64) -> void;
    fn vkCreateDescriptorSetLayout as vk_create_descriptor_set_layout(device: i64, pInfo: i64, pAllocator: i64, pLayout: i64) -> i32;
    fn vkDestroyDescriptorSetLayout as vk_destroy_descriptor_set_layout(device: i64, layout: i64, pAllocator: i64) -> void;
    fn vkCreateDescriptorPool as vk_create_descriptor_pool(device: i64, pInfo: i64, pAllocator: i64, pPool: i64) -> i32;
    fn vkDestroyDescriptorPool as vk_destroy_descriptor_pool(device: i64, pool: i64, pAllocator: i64) -> void;
    fn vkAllocateDescriptorSets as vk_allocate_descriptor_sets(device: i64, pInfo: i64, pSets: i64) -> i32;
    fn vkUpdateDescriptorSets as vk_update_descriptor_sets(device: i64, writeCount: u32, pWrites: i64, copyCount: u32, pCopies: i64) -> void;
    fn vkCreatePipelineLayout as vk_create_pipeline_layout(device: i64, pInfo: i64, pAllocator: i64, pLayout: i64) -> i32;
    fn vkDestroyPipelineLayout as vk_destroy_pipeline_layout(device: i64, layout: i64, pAllocator: i64) -> void;
    fn vkCreateGraphicsPipelines as vk_create_graphics_pipelines(device: i64, cache: i64, count: u32, pInfos: i64, pAllocator: i64, pPipelines: i64) -> i32;
    fn vkCreateComputePipelines as vk_create_compute_pipelines(device: i64, cache: i64, count: u32, pInfos: i64, pAllocator: i64, pPipelines: i64) -> i32;
    fn vkDestroyPipeline as vk_destroy_pipeline(device: i64, pipeline: i64, pAllocator: i64) -> void;
    fn vkCreateCommandPool as vk_create_command_pool(device: i64, pInfo: i64, pAllocator: i64, pPool: i64) -> i32;
    fn vkDestroyCommandPool as vk_destroy_command_pool(device: i64, pool: i64, pAllocator: i64) -> void;
    fn vkAllocateCommandBuffers as vk_allocate_command_buffers(device: i64, pInfo: i64, pBuffers: i64) -> i32;
    fn vkBeginCommandBuffer as vk_begin_command_buffer(cmd: i64, pInfo: i64) -> i32;
    fn vkEndCommandBuffer as vk_end_command_buffer(cmd: i64) -> i32;
    fn vkCmdPipelineBarrier as vk_cmd_pipeline_barrier(cmd: i64, srcStage: u32, dstStage: u32, depFlags: u32, memCount: u32, pMem: i64, bufCount: u32, pBuf: i64, imgCount: u32, pImg: i64) -> void;
    fn vkCmdPipelineBarrier2 as vk_cmd_pipeline_barrier2(cmd: i64, pDependencyInfo: i64) -> void;
    fn vkCmdBindPipeline as vk_cmd_bind_pipeline(cmd: i64, bindPoint: u32, pipeline: i64) -> void;
    fn vkCmdBindDescriptorSets as vk_cmd_bind_descriptor_sets(cmd: i64, bindPoint: u32, layout: i64, firstSet: u32, count: u32, pSets: i64, dynCount: u32, pDynamic: i64) -> void;
    fn vkCmdBindVertexBuffers as vk_cmd_bind_vertex_buffers(cmd: i64, first: u32, count: u32, pBuffers: i64, pOffsets: i64) -> void;
    fn vkCmdDraw as vk_cmd_draw(cmd: i64, vertexCount: u32, instanceCount: u32, firstVertex: u32, firstInstance: u32) -> void;
    fn vkCmdDispatch as vk_cmd_dispatch(cmd: i64, x: u32, y: u32, z: u32) -> void;
    fn vkCmdCopyBuffer as vk_cmd_copy_buffer(cmd: i64, src: i64, dst: i64, count: u32, pRegions: i64) -> void;
    fn vkCmdBeginRendering as vk_cmd_begin_rendering(cmd: i64, pRenderingInfo: i64) -> void;
    fn vkCmdEndRendering as vk_cmd_end_rendering(cmd: i64) -> void;
    fn vkCreateFence as vk_create_fence(device: i64, pInfo: i64, pAllocator: i64, pFence: i64) -> i32;
    fn vkDestroyFence as vk_destroy_fence(device: i64, fence: i64, pAllocator: i64) -> void;
    fn vkWaitForFences as vk_wait_for_fences(device: i64, count: u32, pFences: i64, waitAll: u32, timeout: i64) -> i32;
    fn vkResetFences as vk_reset_fences(device: i64, count: u32, pFences: i64) -> i32;
    fn vkCreateSemaphore as vk_create_semaphore(device: i64, pInfo: i64, pAllocator: i64, pSemaphore: i64) -> i32;
    fn vkDestroySemaphore as vk_destroy_semaphore(device: i64, semaphore: i64, pAllocator: i64) -> void;
}

// ─── Versions, results, structure types ────────────────────────────────────

pub fn vk_make_api_version(variant: i64, major: i64, minor: i64, patch: i64) -> i64 {
    return (variant << 29) | (major << 22) | (minor << 12) | patch;
}

pub const VK_API_VERSION_1_0: i64 = 4194304;
pub const VK_API_VERSION_1_1: i64 = 4198400;
pub const VK_API_VERSION_1_2: i64 = 4202496;
pub const VK_API_VERSION_1_3: i64 = 4206592;

pub fn vk_version_str(v: i64) -> str {
    return int_to_str((v >> 22) & 0x7F) + "." + int_to_str((v >> 12) & 0x3FF) + "." + int_to_str(v & 0xFFF);
}

pub const VK_SUCCESS: i64 = 0;
pub const VK_NOT_READY: i64 = 1;
pub const VK_TIMEOUT: i64 = 2;
pub const VK_INCOMPLETE: i64 = 5;
pub const VK_ERROR_OUT_OF_HOST_MEMORY: i64 = - 1;
pub const VK_ERROR_OUT_OF_DEVICE_MEMORY: i64 = - 2;
pub const VK_ERROR_INITIALIZATION_FAILED: i64 = - 3;
pub const VK_ERROR_DEVICE_LOST: i64 = - 4;
pub const VK_ERROR_MEMORY_MAP_FAILED: i64 = - 5;
pub const VK_ERROR_LAYER_NOT_PRESENT: i64 = - 6;
pub const VK_ERROR_EXTENSION_NOT_PRESENT: i64 = - 7;
pub const VK_ERROR_FEATURE_NOT_PRESENT: i64 = - 8;
pub const VK_ERROR_INCOMPATIBLE_DRIVER: i64 = - 9;
pub const VK_ERROR_TOO_MANY_OBJECTS: i64 = - 10;
pub const VK_ERROR_FORMAT_NOT_SUPPORTED: i64 = - 11;
pub const VK_ERROR_OUT_OF_DATE_KHR: i64 = - 1000001004;
pub const VK_SUBOPTIMAL_KHR: i64 = 1000001003;

pub fn vk_result_name(r: i64) -> str {
    if r == 0 { return "VK_SUCCESS"; }
    if r == 1 { return "VK_NOT_READY"; }
    if r == 2 { return "VK_TIMEOUT"; }
    if r == 5 { return "VK_INCOMPLETE"; }
    if r == - 1 { return "VK_ERROR_OUT_OF_HOST_MEMORY"; }
    if r == - 2 { return "VK_ERROR_OUT_OF_DEVICE_MEMORY"; }
    if r == - 3 { return "VK_ERROR_INITIALIZATION_FAILED"; }
    if r == - 4 { return "VK_ERROR_DEVICE_LOST"; }
    if r == - 5 { return "VK_ERROR_MEMORY_MAP_FAILED"; }
    if r == - 6 { return "VK_ERROR_LAYER_NOT_PRESENT"; }
    if r == - 7 { return "VK_ERROR_EXTENSION_NOT_PRESENT"; }
    if r == - 8 { return "VK_ERROR_FEATURE_NOT_PRESENT"; }
    if r == - 9 { return "VK_ERROR_INCOMPATIBLE_DRIVER"; }
    if r == - 10 { return "VK_ERROR_TOO_MANY_OBJECTS"; }
    if r == - 11 { return "VK_ERROR_FORMAT_NOT_SUPPORTED"; }
    if r == - 1000001004 { return "VK_ERROR_OUT_OF_DATE_KHR"; }
    if r == 1000001003 { return "VK_SUBOPTIMAL_KHR"; }
    return "VkResult(" + int_to_str(r) + ")";
}

