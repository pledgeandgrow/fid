// src/pe_runtime/data.fd — text data formats of native Windows executables
//
// JSON values (p_json_*), HTTP request/response text (p_http_*) and the
// in-memory key-value database (p_db_mem_*), as the C backend
// (src/codegen_c.rs) implements them: a JSON value is its text, parsing
// produces its canonical text (keys sorted, as `fid run`), and the database keeps
// its keys in insertion order. See base.fd for how the runtime works.
//
// Private helpers are ped_* (all runtime files share one namespace).

extern "C" {
    // msvcrt.dll
    fn memcpy as ped_c_memcpy(dst: i64, src: i64, n: i64) -> i64;
}

// ─── Raw memory, text ───────────────────────────────────────────────────

fn ped_ld(addr: i64) -> i64 {
    var p: *mut i64 = addr;
    var v: i64 = 0;
    // SAFETY: NOT checked here: callers read a word of a block they hold (a
    // Vec header, a buffer they allocated, a map's slots).
    unsafe {
        v = *p;
    }
    return v;
}

fn ped_st(addr: i64, v: i64) {
    var p: *mut i64 = addr;
    // SAFETY: NOT checked here: as ped_ld, a word of a block the caller owns.
    unsafe {
        *p = v;
    }
}

/// The length of NUL-terminated text at an address (0 for null).
fn ped_len(addr: i64) -> i64 {
    if addr == 0 {
        return 0;
    }
    var n: i64 = 0;
    while pe_byte_at(addr, n) != 0 {
        n = n + 1;
    }
    return n;
}

/// A new NUL-terminated copy of n bytes at an address.
fn ped_copy(addr: i64, n: i64) -> str {
    var len: i64 = n;
    if len < 0 {
        len = 0;
    }
    var buf: i64 = p_malloc(len + 1);
    if len > 0 {
        ped_c_memcpy(buf, addr, len);
    }
    pe_set_byte(buf, len, 0);
    return p_str_adopt(buf);
}

/// ped_copy for a word kept in a runtime list or table: the string is
/// owned by whoever keeps the word (a `str` temporary would be freed at the
/// end of its statement and leave the word dangling; known-bugs 2g.24).
fn ped_copy_raw(addr: i64, n: i64) -> i64 {
    return ped_copy(addr, n) as i64;
}

/// strcmp: <0, 0 or >0 (bytes compared unsigned).
fn ped_cmp(a: i64, b: i64) -> i64 {
    var i: i64 = 0;
    while true {
        var x: i64 = pe_byte_at(a, i);
        var y: i64 = pe_byte_at(b, i);
        if x != y {
            return x - y;
        }
        if x == 0 {
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

fn ped_eq(a: i64, b: i64) -> bool {
    return ped_cmp(a, b) == 0;
}

/// n bytes at a equal n bytes at b.
fn ped_eq_n(a: i64, b: i64, n: i64) -> bool {
    var i: i64 = 0;
    while i < n {
        if pe_byte_at(a, i) != pe_byte_at(b, i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// strchr from index `from`: the index of byte b, -1 if not found.
fn ped_find_byte(base: i64, from: i64, b: i64) -> i64 {
    var i: i64 = from;
    var c: i64 = pe_byte_at(base, i);
    while c != 0 {
        if c == b {
            return i;
        }
        i = i + 1;
        c = pe_byte_at(base, i);
    }
    return -1;
}

/// strstr from index `from` for text pat: its index, -1 if not found.
fn ped_find_text(base: i64, from: i64, pat: i64) -> i64 {
    var plen: i64 = ped_len(pat);
    var i: i64 = from;
    while pe_byte_at(base, i) != 0 {
        if ped_eq_n(base + i, pat, plen) {
            return i;
        }
        i = i + 1;
    }
    if plen == 0 {
        return i;
    }
    return -1;
}

// ─── Growable lists of i64 (block: data, len, cap) ──────────────────────

fn ped_list_new() -> i64 {
    var l: i64 = p_malloc(24);
    ped_st(l, p_malloc(64));
    ped_st(l + 8, 0);
    ped_st(l + 16, 8);
    return l;
}

fn ped_list_len(l: i64) -> i64 {
    return ped_ld(l + 8);
}

fn ped_list_get(l: i64, i: i64) -> i64 {
    return ped_ld(ped_ld(l) + i * 8);
}

fn ped_list_set(l: i64, i: i64, v: i64) {
    ped_st(ped_ld(l) + i * 8, v);
}

fn ped_list_push(l: i64, v: i64) {
    var len: i64 = ped_ld(l + 8);
    var cap: i64 = ped_ld(l + 16);
    if len >= cap {
        var ncap: i64 = cap * 2;
        var nd: i64 = p_malloc(ncap * 8);
        ped_c_memcpy(nd, ped_ld(l), len * 8);
        ped_st(l, nd);
        ped_st(l + 16, ncap);
    }
    ped_st(ped_ld(l) + len * 8, v);
    ped_st(l + 8, len + 1);
}

// ─── Text builder (block: buf, len, cap) ────────────────────────────────

fn ped_sb_new() -> i64 {
    var sb: i64 = p_malloc(24);
    ped_st(sb, p_malloc(65));
    ped_st(sb + 8, 0);
    ped_st(sb + 16, 64);
    return sb;
}

fn ped_sb_reserve(sb: i64, extra: i64) {
    var len: i64 = ped_ld(sb + 8);
    var cap: i64 = ped_ld(sb + 16);
    if len + extra > cap {
        var ncap: i64 = cap * 2;
        while len + extra > ncap {
            ncap = ncap * 2;
        }
        var nb: i64 = p_malloc(ncap + 1);
        ped_c_memcpy(nb, ped_ld(sb), len);
        ped_st(sb, nb);
        ped_st(sb + 16, ncap);
    }
}

fn ped_sb_byte(sb: i64, b: i64) {
    ped_sb_reserve(sb, 1);
    var len: i64 = ped_ld(sb + 8);
    pe_set_byte(ped_ld(sb), len, b);
    ped_st(sb + 8, len + 1);
}

fn ped_sb_range(sb: i64, addr: i64, n: i64) {
    if n <= 0 {
        return;
    }
    ped_sb_reserve(sb, n);
    var len: i64 = ped_ld(sb + 8);
    ped_c_memcpy(ped_ld(sb) + len, addr, n);
    ped_st(sb + 8, len + n);
}

/// Append NUL-terminated text (given as a str or an address).
fn ped_sb_text(sb: i64, s: i64) {
    ped_sb_range(sb, s, ped_len(s));
}

/// Append a decimal integer.
fn ped_sb_int(sb: i64, v: i64) {
    if v < 0 {
        ped_sb_byte(sb, 45);
        if v == -9223372036854775807 - 1 {
            ped_sb_text(sb, "9223372036854775808");
            return;
        }
        ped_sb_int(sb, 0 - v);
        return;
    }
    if v >= 10 {
        ped_sb_int(sb, v / 10);
    }
    ped_sb_byte(sb, 48 + v % 10);
}

fn ped_sb_spaces(sb: i64, n: i64) {
    var i: i64 = 0;
    while i < n {
        ped_sb_byte(sb, 32);
        i = i + 1;
    }
}

fn ped_sb_finish(sb: i64) -> str {
    ped_sb_reserve(sb, 1);
    pe_set_byte(ped_ld(sb), ped_ld(sb + 8), 0);
    return p_str_from_ptr(ped_ld(sb));
}

// ─── JSON ───────────────────────────────────────────────────────────────

fn ped_is_digit(c: i64) -> bool {
    return c >= 48 && c <= 57;
}

// BG163: a JSON text is read by recursive descent, as compiler/json.fd
// reads it for `fid run` (a flat scan cut a nested object or array at its
// first `,`, lifted its keys to the top level and ended a string at its
// first `"`), and each value is written out canonically as it is read:
// an object's members sorted by key (a later duplicate wins), a string
// unescaped then escaped again (BG162: it stays a string), a number as
// `fid run` prints it, nested values whole. Text that is not JSON panics,
// as under `fid run`. The parser's state q is a block of four words: the
// text's address, its length, the position, the error (0 or a message).

fn ped_sb_free(sb: i64) {
    if sb != 0 {
        p_free(ped_ld(sb));
        p_free(sb);
    }
}

/// The builder's text as a str; the builder is freed.
fn ped_sb_take(sb: i64) -> str {
    var r: str = ped_sb_finish(sb);
    ped_sb_free(sb);
    return r;
}

fn ped_jq_new(base: i64) -> i64 {
    var q: i64 = p_malloc(32);
    ped_st(q, base);
    ped_st(q + 8, ped_len(base));
    ped_st(q + 16, 0);
    ped_st(q + 24, 0);
    return q;
}

fn ped_jq_left(q: i64) -> i64 {
    return ped_ld(q + 8) - ped_ld(q + 16);
}

/// The byte at the position (0 at the end).
fn ped_jq_byte(q: i64) -> i64 {
    if ped_jq_left(q) <= 0 {
        return 0;
    }
    return pe_byte_at(ped_ld(q), ped_ld(q + 16));
}

fn ped_jq_adv(q: i64, n: i64) {
    ped_st(q + 16, ped_ld(q + 16) + n);
}

/// Records the first error (msg: a literal's address); 0, for `return`.
fn ped_jq_fail(q: i64, msg: i64) -> i64 {
    if ped_ld(q + 24) == 0 {
        ped_st(q + 24, msg);
    }
    return 0;
}

fn ped_jq_ws(q: i64) {
    var c: i64 = ped_jq_byte(q);
    while ped_jq_left(q) > 0 && (c == 32 || c == 9 || c == 10 || c == 13) {
        ped_jq_adv(q, 1);
        c = ped_jq_byte(q);
    }
}

/// The text w (a literal) is next: it is skipped.
fn ped_jq_word(q: i64, w: str) -> bool {
    var wa: i64 = pe_str_addr(w);
    var n: i64 = ped_len(wa);
    if ped_jq_left(q) < n || !ped_eq_n(ped_ld(q) + ped_ld(q + 16), wa, n) {
        return false;
    }
    ped_jq_adv(q, n);
    return true;
}

fn ped_hex_val(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    return -1;
}

fn ped_hex_digit(v: i64) -> i64 {
    if v < 10 {
        return 48 + v;
    }
    return 87 + v;
}

/// The bytes of the string at the position (its opening quote), escapes
/// read, as a builder; 0 when it is not a JSON string.
fn ped_jq_str(q: i64) -> i64 {
    var base: i64 = ped_ld(q);
    var len: i64 = ped_ld(q + 8);
    var i: i64 = ped_ld(q + 16) + 1;
    var out: i64 = ped_sb_new();
    while i < len {
        var c: i64 = pe_byte_at(base, i);
        i = i + 1;
        if c == 34 {
            ped_st(q + 16, i);
            return out;
        }
        if c != 92 {
            ped_sb_byte(out, c);
        } else {
            if i >= len {
                ped_sb_free(out);
                return ped_jq_fail(q, pe_str_addr("Unterminated escape sequence"));
            }
            var x: i64 = pe_byte_at(base, i);
            i = i + 1;
            if x == 34 || x == 92 || x == 47 {
                ped_sb_byte(out, x);
            } else if x == 110 {
                ped_sb_byte(out, 10);
            } else if x == 114 {
                ped_sb_byte(out, 13);
            } else if x == 116 {
                ped_sb_byte(out, 9);
            } else if x == 98 {
                ped_sb_byte(out, 8);
            } else if x == 102 {
                ped_sb_byte(out, 12);
            } else if x == 117 {
                if len - i < 4 {
                    ped_sb_free(out);
                    return ped_jq_fail(q, pe_str_addr("Invalid unicode escape"));
                }
                var code: i64 = 0;
                var k: i64 = 0;
                while k < 4 {
                    var h: i64 = ped_hex_val(pe_byte_at(base, i + k));
                    if h < 0 {
                        ped_sb_free(out);
                        return ped_jq_fail(q, pe_str_addr("Invalid unicode escape"));
                    }
                    code = code * 16 + h;
                    k = k + 1;
                }
                i = i + 4;
                if code < 128 {
                    ped_sb_byte(out, code);
                } else if code < 2048 {
                    ped_sb_byte(out, 192 | (code >> 6));
                    ped_sb_byte(out, 128 | (code & 63));
                } else {
                    ped_sb_byte(out, 224 | (code >> 12));
                    ped_sb_byte(out, 128 | ((code >> 6) & 63));
                    ped_sb_byte(out, 128 | (code & 63));
                }
            } else {
                ped_sb_free(out);
                return ped_jq_fail(q, pe_str_addr("Invalid escape character"));
            }
        }
    }
    ped_sb_free(out);
    return ped_jq_fail(q, pe_str_addr("Unterminated string"));
}

/// n bytes at addr as a JSON string literal (quotes, escapes).
fn ped_json_quote(sb: i64, addr: i64, n: i64) {
    ped_sb_byte(sb, 34);
    var i: i64 = 0;
    while i < n {
        var c: i64 = pe_byte_at(addr, i);
        if c == 34 || c == 92 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, c);
        } else if c == 10 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 110);
        } else if c == 13 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 114);
        } else if c == 9 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 116);
        } else if c == 8 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 98);
        } else if c == 12 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 102);
        } else if c < 32 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 117);
            ped_sb_byte(sb, 48);
            ped_sb_byte(sb, 48);
            ped_sb_byte(sb, ped_hex_digit(c >> 4));
            ped_sb_byte(sb, ped_hex_digit(c & 15));
        } else {
            ped_sb_byte(sb, c);
        }
        i = i + 1;
    }
    ped_sb_byte(sb, 34);
}

/// The number at the position, as compiler/json.fd format_number prints
/// it: an integer below 10^15 as one, anything else as `fid run` prints
/// a float.
fn ped_jv_num(q: i64) -> i64 {
    var base: i64 = ped_ld(q);
    var len: i64 = ped_ld(q + 8);
    var st: i64 = ped_ld(q + 16);
    var i: i64 = st;
    if i < len && pe_byte_at(base, i) == 45 {
        i = i + 1;
    }
    while i < len && ped_is_digit(pe_byte_at(base, i)) {
        i = i + 1;
    }
    if i < len && pe_byte_at(base, i) == 46 {
        i = i + 1;
        while i < len && ped_is_digit(pe_byte_at(base, i)) {
            i = i + 1;
        }
    }
    if i < len && (pe_byte_at(base, i) == 101 || pe_byte_at(base, i) == 69) {
        i = i + 1;
        if i < len && (pe_byte_at(base, i) == 43 || pe_byte_at(base, i) == 45) {
            i = i + 1;
        }
        while i < len && ped_is_digit(pe_byte_at(base, i)) {
            i = i + 1;
        }
    }
    ped_st(q + 16, i);
    var text: str = ped_copy(base + st, i - st);
    var d: f64 = pert_str_to_float(text);
    var out: i64 = ped_sb_new();
    if d > -1000000000000000.0 && d < 1000000000000000.0 {
        var iv: i64 = d as i64;
        if (iv as f64) == d {
            ped_sb_int(out, iv);
            return out;
        }
    }
    var f: str = pert_to_str_float(d);
    ped_sb_text(out, pe_str_addr(f));
    return out;
}

/// Appends a member's or element's text (and frees its builder).
fn ped_sb_take_into(sb: i64, part: i64) {
    ped_sb_range(sb, ped_ld(part), ped_ld(part + 8));
    ped_sb_free(part);
}

/// The canonical text of the value at the position, as a builder, written
/// for indentation level ind when pretty; 0 (and q's error) when it is not
/// JSON.
fn ped_jv(q: i64, depth: i64, pretty: bool, ind: i64) -> i64 {
    ped_jq_ws(q);
    if ped_jq_left(q) <= 0 {
        return ped_jq_fail(q, pe_str_addr("Unexpected end of input"));
    }
    if depth > 1000 {
        return ped_jq_fail(q, pe_str_addr("nested too deeply"));
    }
    var c: i64 = ped_jq_byte(q);
    var out: i64 = 0;
    if c == 110 {
        if !ped_jq_word(q, "null") {
            return ped_jq_fail(q, pe_str_addr("Invalid null literal"));
        }
        out = ped_sb_new();
        ped_sb_text(out, pe_str_addr("null"));
        return out;
    }
    if c == 116 || c == 102 {
        out = ped_sb_new();
        if ped_jq_word(q, "true") {
            ped_sb_text(out, pe_str_addr("true"));
            return out;
        }
        if ped_jq_word(q, "false") {
            ped_sb_text(out, pe_str_addr("false"));
            return out;
        }
        ped_sb_free(out);
        return ped_jq_fail(q, pe_str_addr("Invalid boolean literal"));
    }
    if c == 34 {
        var s: i64 = ped_jq_str(q);
        if s == 0 {
            return 0;
        }
        out = ped_sb_new();
        ped_json_quote(out, ped_ld(s), ped_ld(s + 8));
        ped_sb_free(s);
        return out;
    }
    if c == 45 || ped_is_digit(c) {
        return ped_jv_num(q);
    }
    if c == 91 {
        return ped_jv_arr(q, depth, pretty, ind);
    }
    if c == 123 {
        var keys: i64 = ped_list_new();
        var vals: i64 = ped_list_new();
        if !ped_jv_members(q, depth, pretty, ind, keys, vals) {
            ped_jv_lists_free(keys, vals);
            return 0;
        }
        out = ped_jv_obj_text(keys, vals, pretty, ind);
        ped_jv_lists_free(keys, vals);
        return out;
    }
    return ped_jq_fail(q, pe_str_addr("Unexpected character"));
}

fn ped_jv_arr(q: i64, depth: i64, pretty: bool, ind: i64) -> i64 {
    ped_jq_adv(q, 1);
    ped_jq_ws(q);
    var out: i64 = ped_sb_new();
    if ped_jq_left(q) > 0 && ped_jq_byte(q) == 93 {
        ped_jq_adv(q, 1);
        ped_sb_text(out, pe_str_addr("[]"));
        return out;
    }
    ped_sb_byte(out, 91);
    var first: bool = true;
    while true {
        var it: i64 = ped_jv(q, depth + 1, pretty, ind + 1);
        if it == 0 {
            ped_sb_free(out);
            return 0;
        }
        if !first {
            ped_sb_byte(out, 44);
        }
        first = false;
        if pretty {
            ped_sb_byte(out, 10);
            ped_sb_spaces(out, (ind + 1) * 2);
        }
        ped_sb_take_into(out, it);
        ped_jq_ws(q);
        if ped_jq_left(q) <= 0 {
            ped_sb_free(out);
            return ped_jq_fail(q, pe_str_addr("Unterminated array"));
        }
        var d: i64 = ped_jq_byte(q);
        ped_jq_adv(q, 1);
        if d == 93 {
            if pretty {
                ped_sb_byte(out, 10);
                ped_sb_spaces(out, ind * 2);
            }
            ped_sb_byte(out, 93);
            return out;
        }
        if d != 44 {
            ped_sb_free(out);
            return ped_jq_fail(q, pe_str_addr("Expected ',' or ']'"));
        }
    }
    return 0;
}

/// The members of the object at the position (its `{`): each key (a
/// builder of its bytes) into keys, its value's text (a builder) into
/// vals; false when it is not JSON.
fn ped_jv_members(q: i64, depth: i64, pretty: bool, ind: i64, keys: i64, vals: i64) -> bool {
    ped_jq_adv(q, 1);
    ped_jq_ws(q);
    if ped_jq_left(q) > 0 && ped_jq_byte(q) == 125 {
        ped_jq_adv(q, 1);
        return true;
    }
    while true {
        ped_jq_ws(q);
        if ped_jq_left(q) <= 0 || ped_jq_byte(q) != 34 {
            ped_jq_fail(q, pe_str_addr("Expected string key in object"));
            return false;
        }
        var k: i64 = ped_jq_str(q);
        if k == 0 {
            return false;
        }
        ped_jq_ws(q);
        if ped_jq_left(q) <= 0 || ped_jq_byte(q) != 58 {
            ped_sb_free(k);
            ped_jq_fail(q, pe_str_addr("Expected ':' after key in object"));
            return false;
        }
        ped_jq_adv(q, 1);
        var v: i64 = ped_jv(q, depth + 1, pretty, ind + 1);
        if v == 0 {
            ped_sb_free(k);
            return false;
        }
        ped_list_push(keys, k);
        ped_list_push(vals, v);
        ped_jq_ws(q);
        if ped_jq_left(q) <= 0 {
            ped_jq_fail(q, pe_str_addr("Unterminated object"));
            return false;
        }
        var d: i64 = ped_jq_byte(q);
        ped_jq_adv(q, 1);
        if d == 125 {
            return true;
        }
        if d != 44 {
            ped_jq_fail(q, pe_str_addr("Expected ',' or '}'"));
            return false;
        }
    }
    return false;
}

fn ped_jv_lists_free(keys: i64, vals: i64) {
    var i: i64 = 0;
    while i < ped_list_len(keys) {
        ped_sb_free(ped_list_get(keys, i));
        i = i + 1;
    }
    i = 0;
    while i < ped_list_len(vals) {
        ped_sb_free(ped_list_get(vals, i));
        i = i + 1;
    }
    p_free(ped_ld(keys));
    p_free(keys);
    p_free(ped_ld(vals));
    p_free(vals);
}

/// Compares two keys (builders) byte by byte, a prefix first.
fn ped_key_cmp(a: i64, b: i64) -> i64 {
    var al: i64 = ped_ld(a + 8);
    var bl: i64 = ped_ld(b + 8);
    var i: i64 = 0;
    while i < al && i < bl {
        var x: i64 = pe_byte_at(ped_ld(a), i);
        var y: i64 = pe_byte_at(ped_ld(b), i);
        if x != y {
            return x - y;
        }
        i = i + 1;
    }
    return al - bl;
}

/// An object's text from its members, sorted by key (stable, so of equal
/// keys the last one read is the last in its run: that one is written).
fn ped_jv_obj_text(keys: i64, vals: i64, pretty: bool, ind: i64) -> i64 {
    var out: i64 = ped_sb_new();
    var n: i64 = ped_list_len(keys);
    if n == 0 {
        ped_sb_text(out, pe_str_addr("{}"));
        return out;
    }
    var i: i64 = 1;
    while i < n {
        var k: i64 = ped_list_get(keys, i);
        var v: i64 = ped_list_get(vals, i);
        var j: i64 = i - 1;
        while j >= 0 && ped_key_cmp(ped_list_get(keys, j), k) > 0 {
            ped_list_set(keys, j + 1, ped_list_get(keys, j));
            ped_list_set(vals, j + 1, ped_list_get(vals, j));
            j = j - 1;
        }
        ped_list_set(keys, j + 1, k);
        ped_list_set(vals, j + 1, v);
        i = i + 1;
    }
    ped_sb_byte(out, 123);
    var first: bool = true;
    i = 0;
    while i < n {
        var key: i64 = ped_list_get(keys, i);
        var later: bool = i + 1 < n && ped_key_cmp(key, ped_list_get(keys, i + 1)) == 0;
        if !later {
            if !first {
                ped_sb_byte(out, 44);
            }
            first = false;
            if pretty {
                ped_sb_byte(out, 10);
                ped_sb_spaces(out, (ind + 1) * 2);
            }
            ped_json_quote(out, ped_ld(key), ped_ld(key + 8));
            ped_sb_byte(out, 58);
            if pretty {
                ped_sb_byte(out, 32);
            }
            var val: i64 = ped_list_get(vals, i);
            ped_sb_range(out, ped_ld(val), ped_ld(val + 8));
        }
        i = i + 1;
    }
    if pretty {
        ped_sb_byte(out, 10);
        ped_sb_spaces(out, ind * 2);
    }
    ped_sb_byte(out, 125);
    return out;
}

/// Panics `who: <reason>` with q's error (q is freed).
fn ped_jq_panic(q: i64, who: str) {
    var msg: i64 = ped_ld(q + 24);
    p_free(q);
    if msg == 0 {
        msg = pe_str_addr("invalid JSON");
    }
    p_panic(p_str_concat(who, p_str_concat(": ", p_str_from_ptr(msg))));
}

/// The canonical text of the JSON text s (pretty: 2-space indentation).
fn ped_json_canon(s: str, pretty: bool, who: str) -> str {
    var base: i64 = pe_str_addr(s);
    if base == 0 {
        return ped_copy(0, 0);
    }
    var q: i64 = ped_jq_new(base);
    var v: i64 = ped_jv(q, 0, pretty, 0);
    if v != 0 {
        ped_jq_ws(q);
        if ped_jq_left(q) > 0 {
            ped_sb_free(v);
            v = ped_jq_fail(q, pe_str_addr("Unexpected trailing characters"));
        }
    }
    if v == 0 {
        ped_jq_panic(q, who);
        return ped_copy(0, 0);
    }
    p_free(q);
    return ped_sb_take(v);
}

pub fn pert_json_parse(s: str) -> str {
    return ped_json_canon(s, false, "json_parse");
}

pub fn pert_json_dump(j: str) -> str {
    return pert_json_parse(j);
}

pub fn pert_json_dump_pretty(j: str) -> str {
    return pert_json_parse(j);
}

/// The canonical form, one member per line, 2-space indentation.
pub fn pert_json_pretty(j: str) -> str {
    return ped_json_canon(j, true, "json_pretty");
}

/// A string as a JSON string literal: quotes, \" \\ and \n escaped.
pub fn pert_json_string(j: str) -> str {
    var base: i64 = pe_str_addr(j);
    if base == 0 {
        return ped_copy(pe_str_addr("\"\""), 2);
    }
    var sb: i64 = ped_sb_new();
    ped_sb_byte(sb, 34);
    var i: i64 = 0;
    var c: i64 = pe_byte_at(base, 0);
    while c != 0 {
        if c == 34 || c == 92 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, c);
        } else if c == 10 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 110);
        } else {
            ped_sb_byte(sb, c);
        }
        i = i + 1;
        c = pe_byte_at(base, i);
    }
    ped_sb_byte(sb, 34);
    return ped_sb_finish(sb);
}

pub fn pert_json_type(j: str) -> str {
    var base: i64 = pe_str_addr(j);
    if base == 0 {
        return "null";
    }
    var i: i64 = 0;
    while pe_byte_at(base, i) == 32 {
        i = i + 1;
    }
    var c: i64 = pe_byte_at(base, i);
    if c == 123 {
        return "object";
    }
    if c == 91 {
        return "array";
    }
    if c == 34 {
        return "string";
    }
    if c == 116 || c == 102 {
        return "boolean";
    }
    if c == 110 {
        return "null";
    }
    return "number";
}

/// The value of `key` in the top-level object, as `fid run` gives it (a
/// string quoted and escaped, nested values canonical, a later duplicate
/// winning), "null" if there is none; panics when j is not a JSON object.
pub fn pert_json_get(j: str, key: str) -> str {
    var base: i64 = pe_str_addr(j);
    var kaddr: i64 = pe_str_addr(key);
    if base == 0 || kaddr == 0 {
        return ped_copy(pe_str_addr("null"), 4);
    }
    var q: i64 = ped_jq_new(base);
    var keys: i64 = ped_list_new();
    var vals: i64 = ped_list_new();
    ped_jq_ws(q);
    var ok: bool = ped_jq_left(q) > 0 && ped_jq_byte(q) == 123 && ped_jv_members(q, 0, false, 0, keys, vals);
    if ok {
        ped_jq_ws(q);
        ok = ped_jq_left(q) <= 0;
    }
    p_free(q);
    if !ok {
        ped_jv_lists_free(keys, vals);
        p_panic("json_get: not an object");
        return ped_copy(pe_str_addr("null"), 4);
    }
    var klen: i64 = ped_len(kaddr);
    var at: i64 = -1;
    var i: i64 = 0;
    while i < ped_list_len(keys) {
        var k: i64 = ped_list_get(keys, i);
        if ped_ld(k + 8) == klen && ped_eq_n(ped_ld(k), kaddr, klen) {
            at = i;
        }
        i = i + 1;
    }
    var r: str = "null";
    if at >= 0 {
        var v: i64 = ped_list_get(vals, at);
        r = ped_copy(ped_ld(v), ped_ld(v + 8));
    } else {
        r = ped_copy(pe_str_addr("null"), 4);
    }
    ped_jv_lists_free(keys, vals);
    return r;
}

/// The length of [from, to) clipped to the text (stops at the terminator).
fn ped_text_span(base: i64, from: i64, to: i64) -> i64 {
    var n: i64 = 0;
    while from + n < to && pe_byte_at(base, from + n) != 0 {
        n = n + 1;
    }
    return n;
}

pub fn pert_json_get_int(j: str, key: str) -> i64 {
    return pert_str_to_int(pert_json_get(j, key));
}

pub fn pert_json_get_float(j: str, key: str) -> f64 {
    return pert_str_to_float(pert_json_get(j, key));
}

pub fn pert_json_get_bool(j: str, key: str) -> i64 {
    if ped_eq(pe_str_addr(pert_json_get(j, key)), pe_str_addr("true")) {
        return 1;
    }
    return 0;
}

pub fn pert_json_object_get(j: str, key: str) -> str {
    return pert_json_get(j, key);
}

/// Element idx of the first array in the text (strings keep their quotes),
/// "null" past the end.
pub fn pert_json_at(j: str, idx: i64) -> str {
    var base: i64 = pe_str_addr(j);
    if base == 0 || idx < 0 {
        return ped_copy(pe_str_addr("null"), 4);
    }
    var i: i64 = ped_find_byte(base, 0, 91);
    if i < 0 {
        return ped_copy(pe_str_addr("null"), 4);
    }
    i = i + 1;
    var cur: i64 = 0;
    while pe_byte_at(base, i) != 0 {
        while pe_byte_at(base, i) == 32 || pe_byte_at(base, i) == 9 {
            i = i + 1;
        }
        var c: i64 = pe_byte_at(base, i);
        if c == 93 || c == 0 {
            return ped_copy(pe_str_addr("null"), 4);
        }
        if cur == idx {
            if c == 34 {
                var e: i64 = i + 1;
                while pe_byte_at(base, e) != 0 && pe_byte_at(base, e) != 34 {
                    e = e + 1;
                }
                return ped_copy(base + i, ped_text_span(base, i, e + 1));
            }
            var e2: i64 = i;
            while pe_byte_at(base, e2) != 0 && pe_byte_at(base, e2) != 44 && pe_byte_at(base, e2) != 93 {
                e2 = e2 + 1;
            }
            return ped_copy(base + i, e2 - i);
        }
        // Skip this element
        if c == 34 {
            i = i + 1;
            while pe_byte_at(base, i) != 0 && pe_byte_at(base, i) != 34 {
                i = i + 1;
            }
            if pe_byte_at(base, i) != 0 {
                i = i + 1;
            }
        } else {
            while pe_byte_at(base, i) != 0 && pe_byte_at(base, i) != 44 && pe_byte_at(base, i) != 93 {
                i = i + 1;
            }
        }
        if pe_byte_at(base, i) == 44 {
            i = i + 1;
        }
        cur = cur + 1;
    }
    return ped_copy(pe_str_addr("null"), 4);
}

/// Top-level commas + 1 (outside strings).
pub fn pert_json_len(j: str) -> i64 {
    var base: i64 = pe_str_addr(j);
    if base == 0 {
        return 0;
    }
    var count: i64 = 0;
    var depth: i64 = 0;
    var in_str: bool = false;
    var i: i64 = 0;
    var c: i64 = pe_byte_at(base, 0);
    while c != 0 {
        if c == 34 && (i == 0 || pe_byte_at(base, i - 1) != 92) {
            in_str = !in_str;
        }
        if !in_str {
            if c == 123 || c == 91 {
                depth = depth + 1;
            }
            if c == 125 || c == 93 {
                depth = depth - 1;
            }
            if c == 44 && depth == 1 {
                count = count + 1;
            }
        }
        i = i + 1;
        c = pe_byte_at(base, i);
    }
    return count + 1;
}

// ─── HTTP ───────────────────────────────────────────────────────────────

fn ped_reason(status: i64) -> str {
    if status == 201 {
        return "Created";
    }
    if status == 204 {
        return "No Content";
    }
    if status == 301 {
        return "Moved Permanently";
    }
    if status == 302 {
        return "Found";
    }
    if status == 304 {
        return "Not Modified";
    }
    if status == 400 {
        return "Bad Request";
    }
    if status == 401 {
        return "Unauthorized";
    }
    if status == 403 {
        return "Forbidden";
    }
    if status == 404 {
        return "Not Found";
    }
    if status == 405 {
        return "Method Not Allowed";
    }
    if status == 409 {
        return "Conflict";
    }
    if status == 413 {
        return "Payload Too Large";
    }
    if status == 429 {
        return "Too Many Requests";
    }
    if status == 500 {
        return "Internal Server Error";
    }
    if status == 501 {
        return "Not Implemented";
    }
    if status == 502 {
        return "Bad Gateway";
    }
    if status == 503 {
        return "Service Unavailable";
    }
    if status == 504 {
        return "Gateway Timeout";
    }
    return "OK";
}

/// "HTTP/1.1 <status> <reason>\r\nContent-Length: <n>\r\n\r\n<body>"
/// (the content type is not used).
pub fn pert_http_build_response(status: i64, content_type: str, body: str) -> str {
    var b: i64 = pe_str_addr(body);
    var sb: i64 = ped_sb_new();
    ped_sb_text(sb, "HTTP/1.1 ");
    ped_sb_int(sb, status);
    ped_sb_byte(sb, 32);
    ped_sb_text(sb, ped_reason(status));
    ped_sb_text(sb, "\r\nContent-Length: ");
    ped_sb_int(sb, ped_len(b));
    ped_sb_text(sb, "\r\n\r\n");
    ped_sb_text(sb, b);
    return ped_sb_finish(sb);
}

/// The request as JSON text:
/// {"method":..,"path":..,"version":..,"headers":{..},"body":".."}
pub fn pert_http_parse_request(request: str) -> str {
    var base: i64 = pe_str_addr(request);
    if base == 0 {
        return ped_copy(pe_str_addr("{}"), 2);
    }
    var total: i64 = ped_len(base);
    var le: i64 = ped_find_text(base, 0, pe_str_addr("\r\n"));
    if le < 0 {
        le = total;
    }
    // Request line: METHOD PATH HTTP/VERSION
    var sp1: i64 = ped_find_byte(base, 0, 32);
    var mlen: i64 = 0;
    if sp1 >= 0 && sp1 < le {
        mlen = sp1;
        if mlen > 15 {
            mlen = 15;
        }
    }
    var ps: i64 = 0;
    if sp1 >= 0 {
        ps = sp1 + 1;
    }
    var sp2: i64 = ped_find_byte(base, ps, 32);
    var plen: i64 = 0;
    if sp2 >= 0 && sp2 < le {
        plen = sp2 - ps;
        if plen > 1023 {
            plen = 1023;
        }
    }
    var vs: i64 = 0;
    if sp2 >= 0 {
        vs = sp2 + 1;
    }
    var vlen: i64 = 0;
    if vs < le {
        vlen = le - vs;
        if vlen > 15 {
            vlen = 15;
        }
    }
    if vlen >= 5 && ped_eq_n(base + vs, pe_str_addr("HTTP/"), 5) {
        vs = vs + 5;
        vlen = vlen - 5;
    }
    var sb: i64 = ped_sb_new();
    ped_sb_text(sb, "{\"method\":\"");
    ped_sb_range(sb, base, mlen);
    ped_sb_text(sb, "\",\"path\":\"");
    ped_sb_range(sb, base + ps, plen);
    ped_sb_text(sb, "\",\"version\":\"");
    ped_sb_range(sb, base + vs, vlen);
    ped_sb_text(sb, "\",\"headers\":{");
    // Headers, up to the empty line
    var p: i64 = le + 2;
    if p > total {
        p = total;
    }
    var first: bool = true;
    var more: bool = true;
    while more && pe_byte_at(base, p) != 0 {
        var nl: i64 = ped_find_text(base, p, pe_str_addr("\r\n"));
        if nl < 0 {
            more = false;
        } else if nl == p {
            p = p + 2;
            more = false;
        } else {
            var colon: i64 = ped_find_byte(base, p, 58);
            if colon >= 0 && colon < nl {
                var hv: i64 = colon + 1;
                while pe_byte_at(base, hv) == 32 {
                    hv = hv + 1;
                }
                if !first {
                    ped_sb_byte(sb, 44);
                }
                first = false;
                ped_sb_byte(sb, 34);
                ped_sb_range(sb, base + p, colon - p);
                ped_sb_text(sb, "\":\"");
                ped_sb_range(sb, base + hv, nl - hv);
                ped_sb_byte(sb, 34);
            }
            p = nl + 2;
        }
    }
    ped_sb_text(sb, "},\"body\":\"");
    // The body (the rest), escaped
    var c: i64 = pe_byte_at(base, p);
    while c != 0 {
        if c == 34 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 34);
        } else if c == 92 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 92);
        } else if c == 10 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 110);
        } else if c == 13 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 114);
        } else if c == 9 {
            ped_sb_byte(sb, 92);
            ped_sb_byte(sb, 116);
        } else {
            ped_sb_byte(sb, c);
        }
        p = p + 1;
        c = pe_byte_at(base, p);
    }
    ped_sb_text(sb, "\"}");
    return ped_sb_finish(sb);
}

// ─── In-memory database (block: keys list, values list) ─────────────────

pub fn pert_db_mem_open() -> i64 {
    var db: i64 = p_malloc(16);
    ped_st(db, ped_list_new());
    ped_st(db + 8, ped_list_new());
    return db;
}

/// The index of the key of n bytes at k, -1 if absent.
fn ped_db_find(db: i64, k: i64, n: i64) -> i64 {
    var keys: i64 = ped_ld(db);
    var count: i64 = ped_list_len(keys);
    var i: i64 = 0;
    while i < count {
        var key: i64 = ped_list_get(keys, i);
        if ped_len(key) == n && ped_eq_n(key, k, n) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// "INSERT key value" / "SET key value" (any case): 1 when stored.
pub fn pert_db_mem_exec(db: i64, query: str) -> i64 {
    var q: i64 = pe_str_addr(query);
    if db == 0 || q == 0 {
        return 0;
    }
    var i: i64 = 0;
    while pe_byte_at(q, i) == 32 {
        i = i + 1;
    }
    // The command: at most 15 bytes, lowercased
    var cmd: i64 = p_malloc(16);
    var ci: i64 = 0;
    while pe_byte_at(q, i) != 0 && pe_byte_at(q, i) != 32 && ci < 15 {
        var ch: i64 = pe_byte_at(q, i);
        if ch >= 65 && ch <= 90 {
            ch = ch + 32;
        }
        pe_set_byte(cmd, ci, ch);
        ci = ci + 1;
        i = i + 1;
    }
    pe_set_byte(cmd, ci, 0);
    while pe_byte_at(q, i) == 32 {
        i = i + 1;
    }
    var ks: i64 = i;
    while pe_byte_at(q, i) != 0 && pe_byte_at(q, i) != 32 {
        i = i + 1;
    }
    var klen: i64 = i - ks;
    while pe_byte_at(q, i) == 32 {
        i = i + 1;
    }
    var vs: i64 = i;
    var vlen: i64 = ped_len(q + vs);
    if (ped_eq(cmd, pe_str_addr("insert")) || ped_eq(cmd, pe_str_addr("set"))) && klen > 0 {
        var v: i64 = ped_copy_raw(q + vs, vlen);
        var at: i64 = ped_db_find(db, q + ks, klen);
        if at >= 0 {
            ped_list_set(ped_ld(db + 8), at, v);
            return 1;
        }
        ped_list_push(ped_ld(db), ped_copy_raw(q + ks, klen));
        ped_list_push(ped_ld(db + 8), v);
        return 1;
    }
    return 0;
}

/// "... key=K ..." -> K's value ("" if absent); otherwise every key, in
/// insertion order, as a JSON array of strings.
pub fn pert_db_mem_query(db: i64, query: str) -> str {
    if db == 0 {
        return ped_copy(pe_str_addr("[]"), 2);
    }
    var q: i64 = pe_str_addr(query);
    var w: i64 = -1;
    if q != 0 {
        w = ped_find_text(q, 0, pe_str_addr("key="));
    }
    if w >= 0 {
        var k: i64 = w + 4;
        while pe_byte_at(q, k) == 39 || pe_byte_at(q, k) == 34 {
            k = k + 1;
        }
        var kl: i64 = 0;
        var c: i64 = pe_byte_at(q, k);
        while c != 0 && c != 32 && c != 59 && c != 39 && c != 34 {
            kl = kl + 1;
            c = pe_byte_at(q, k + kl);
        }
        var at: i64 = ped_db_find(db, q + k, kl);
        if at >= 0 {
            var v: i64 = ped_list_get(ped_ld(db + 8), at);
            return ped_copy(v, ped_len(v));
        }
        return ped_copy(0, 0);
    }
    var keys: i64 = ped_ld(db);
    var n: i64 = ped_list_len(keys);
    var sb: i64 = ped_sb_new();
    ped_sb_byte(sb, 91);
    var i: i64 = 0;
    while i < n {
        if i > 0 {
            ped_sb_byte(sb, 44);
        }
        ped_sb_byte(sb, 34);
        ped_sb_text(sb, ped_list_get(keys, i));
        ped_sb_byte(sb, 34);
        i = i + 1;
    }
    ped_sb_byte(sb, 93);
    return ped_sb_finish(sb);
}

/// The store's memory is not reclaimed (the program's heap is).
pub fn pert_db_mem_close(db: i64) {
}
