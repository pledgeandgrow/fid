// src/pe_runtime/base.fd — the Fides runtime of native Windows executables
//
// The PE backend (src/pe.rs) has machine code for the core builtins
// (printing, strings, Vec, HashMap, memory). Every other builtin p_X is
// implemented by this runtime as pert_X, in Fides, over:
//   - C functions of msvcrt.dll and kernel32.dll, declared extern "C" (the
//     backend calls each through a thunk: see CThunk in pe.rs)
//   - machine-code primitives pe_* (atomics, float bits, calling a function
//     by address: see gen_pe_primitives in pe.rs)
// A call to p_X runs pert_X with the same arguments; an executable gets only
// the functions it uses. The behaviour is the C backend's (src/codegen_c.rs),
// which matches the interpreter's.
//
// This file: numbers and their text, files, clocks, the environment,
// wildcard matching, volatile memory access, SIMD vectors, simulated
// dynamic loading and allocators, the entity-component store.

extern "C" {
    // msvcrt.dll
    fn fopen as pe_c_fopen(path: str, mode: str) -> i64;
    fn fclose as pe_c_fclose(f: i64) -> i32;
    fn fread as pe_c_fread(buf: i64, size: i64, count: i64, f: i64) -> i64;
    fn fwrite as pe_c_fwrite(buf: i64, size: i64, count: i64, f: i64) -> i64;
    fn fputs as pe_c_fputs(s: str, f: i64) -> i32;
    fn fseek as pe_c_fseek(f: i64, offset: i64, whence: i64) -> i32;
    fn ftell as pe_c_ftell(f: i64) -> i32;
    fn remove as pe_c_remove(path: str) -> i32;
    fn getenv as pe_c_getenv(name: str) -> str;
    fn atof as pe_c_atof(s: str) -> f64;
    fn _strtoi64 as pe_c_strtoi64(s: str, end: i64, base: i64) -> i64;
    fn strtod as pe_c_strtod(s: str, end: i64) -> f64;
    fn _snprintf as pe_c_fmt_prec(buf: i64, size: i64, fmt: str, prec: i64, x: f64) -> i32;
    fn _snprintf as pe_c_fmt_f64(buf: i64, size: i64, fmt: str, x: f64) -> i32;
    fn system as pe_c_system(cmd: str) -> i64;
    fn rename as pe_c_rename(a: str, b: str) -> i32;
    // kernel32.dll
    fn GetSystemTimeAsFileTime as pe_k_system_time(out: i64);
    fn ExitProcess as pe_k_exit_process(code: i64);
    fn GetCurrentProcessId as pe_k_getpid() -> i64;
    fn GetFileAttributesA as pe_k_attrs(path: str) -> i64;
    fn CreateDirectoryA as pe_k_mkdir(path: str, sa: i64) -> i32;
    fn RemoveDirectoryA as pe_k_rmdir(path: str) -> i32;
    fn FindFirstFileA as pe_k_find_first(pat: str, data: i64) -> i64;
    fn FindNextFileA as pe_k_find_next(h: i64, data: i64) -> i32;
    fn FindClose as pe_k_find_close(h: i64) -> i32;
    fn GetStdHandle as pe_k_std_handle(n: i64) -> i64;
    fn ReadFile as pe_k_read_file(h: i64, buf: i64, n: i64, read_out: i64, ovl: i64) -> i32;
    fn fflush as pe_c_fflush(f: i64) -> i32;
    fn strlen as pe_c_strlen(s: i64) -> i64;
    fn memcmp as pe_c_memcmp(a: i64, b: i64, n: i64) -> i32;
    // Machine-code primitives (pe.rs): a float travels as its bits
    fn pe_f64_to_bits(x: f64) -> i64;
    fn pe_bits_to_f64(bits: i64) -> f64;
    fn pe_f64_to_bits as pe_f32_raw_bits(x: f32) -> i64;
    fn pe_f64_to_bits as pe_raw_bits_f32(bits: i64) -> f32;
}

// ─── Numbers ────────────────────────────────────────────────────────────

pub fn pert_int_to_float(x: i64) -> f64 {
    return x as f64;
}

pub fn pert_float_to_int(x: f64) -> i64 {
    return x as i64;
}

pub fn pert_f64_to_bits(x: f64) -> i64 {
    return pe_f64_to_bits(x);
}

pub fn pert_f64_from_bits(bits: i64) -> f64 {
    return pe_bits_to_f64(bits);
}

/// The bits of an f32, sign-extended (C: (int64_t) of an int32_t).
pub fn pert_f32_to_bits(x: f32) -> i64 {
    var b: i64 = pe_f32_raw_bits(x) & 4294967295;
    if b >= 2147483648 {
        b = b - 4294967296;
    }
    return b;
}

pub fn pert_f32_from_bits(bits: i64) -> f32 {
    return pe_raw_bits_f32(bits & 4294967295);
}

/// atof: 0.0 when the text is not a number.
pub fn pert_str_to_float(s: str) -> f64 {
    if pe_str_is_null(s) {
        return 0.0;
    }
    return pe_c_atof(s);
}

/// atoll: base 10, 0 when the text is not a number.
pub fn pert_str_to_int(s: str) -> i64 {
    if pe_str_is_null(s) {
        return 0;
    }
    return pe_c_strtoi64(s, 0, 10);
}

/// p_str_equal for this backend: compare the lengths first, then the
/// memory in one msvcrt memcmp — not byte by byte (pe-roadmap item 74).
pub fn pert_str_equal(a: i64, b: i64) -> bool {
    if a == b { return true; }
    if a == 0 { return false; }
    if b == 0 { return false; }
    var la: i64 = pe_c_strlen(a);
    var lb: i64 = pe_c_strlen(b);
    if la != lb { return false; }
    return pe_c_memcmp(a, b, la) == 0;
}

/// Native-only replacement for `p_str_hash` (pe-roadmap item 77). The
/// interpreter reads `*mut i64` derefs as tagged values, so the byte loop
/// must stay in stdlib/core.fd; here real memory reads are valid and we mix
/// 8 bytes per iteration. The hash depends only on the string's content:
/// near the end of a page, where a word read could fault, the same word is
/// assembled byte by byte (a whole-word read could not fault only because
/// the word stays inside the page of the string's first byte).
@wrapping pub fn pert_str_hash(s: i64) -> i64 {
    var hash: i64 = -3750763034362895579; // FNV-1a offset basis
    if s == 0 { return 0; }
    var addr: i64 = s;
    unsafe {
        while true {
            var w: i64 = 0;
            var whole: bool = true;
            if (addr & 4095) <= 4088 {
                var word_ptr: *mut i64 = addr;
                w = *word_ptr;
                // Zero-byte test per 32-bit half (no i64 overflow):
                // (x - 0x01010101) & ~x & 0x80808080 detects a zero byte.
                var lo: i64 = w & 4294967295;
                var hi: i64 = (w >> 32) & 4294967295;
                if ((lo - 16843009) & (~lo) & 2155905152) != 0
                    || ((hi - 16843009) & (~hi) & 2155905152) != 0 {
                    whole = false;
                }
            } else {
                var k: i64 = 0;
                while k < 8 && whole {
                    var bp: *mut u8 = addr + k;
                    var b: i64 = *bp;
                    if b == 0 { whole = false; }
                    w = w | (b << (k * 8));
                    k = k + 1;
                }
            }
            if !whole { break; }
            hash = hash ^ w;
            hash = hash * 1099511628211;
            addr = addr + 8;
        }
        // The last bytes, fewer than 8
        var byte_ptr: *mut u8 = addr;
        var last: i64 = *byte_ptr;
        while last != 0 {
            hash = hash ^ last;
            hash = hash * 1099511628211;
            addr = addr + 1;
            byte_ptr = addr;
            last = *byte_ptr;
        }
    }
    return hash & 9223372036854775807;
}

/// (A str argument passes as its address.)
fn pe_str_is_null(s: i64) -> bool {
    return s == 0;
}

/// A float as the interpreter prints it (Rust's Display): the shortest
/// fixed-point text that reads back as the same number, no exponent.
pub fn pert_to_str_float(val: f64) -> str {
    if val != val {
        return "NaN";
    }
    // val - val is 0 for a finite value, NaN for an infinite one
    var d: f64 = val - val;
    if d != d {
        if val > 0.0 {
            return "inf";
        }
        return "-inf";
    }
    if val == 0.0 {
        if pe_f64_to_bits(val) < 0 {
            return "-0";
        }
        return "0";
    }
    // Digits needed: 17 significant ones, after any leading zeros
    var a: f64 = val;
    if a < 0.0 {
        a = 0.0 - a;
    }
    var exp: i64 = 0;
    if a >= 1.0 {
        while a >= 10.0 {
            a = a / 10.0;
            exp = exp + 1;
        }
    } else {
        while a < 1.0 {
            a = a * 10.0;
            exp = exp - 1;
        }
    }
    var max_prec: i64 = 17;
    if exp < 0 {
        max_prec = 17 - exp;
    }
    if max_prec > 350 {
        max_prec = 350;
    }
    var buf: i64 = p_malloc(512);
    var prec: i64 = 0;
    while prec <= max_prec {
        pe_c_fmt_prec(buf, 511, "%.*f", prec, val);
        var back: str = pe_buf_str(buf);
        if pe_c_strtod(back, 0) == val {
            return pe_trim_fraction_zeros(buf);
        }
        prec = prec + 1;
    }
    pe_c_fmt_prec(buf, 511, "%.*f", max_prec, val);
    return pe_buf_str(buf);
}

pub fn pert_float_to_str(val: f64) -> str {
    return pert_to_str_float(val);
}

pub fn pert_print_float(val: f64) {
    p_print_str(pert_to_str_float(val));
}

/// A NUL-terminated buffer as a str.
fn pe_buf_str(buf: i64) -> str {
    return buf;
}

/// "10.500" -> "10.5", "10.000" -> "10" (in place).
fn pe_trim_fraction_zeros(buf: i64) -> str {
    var len: i64 = p_str_length(pe_buf_str(buf));
    var dot: i64 = -1;
    var i: i64 = 0;
    while i < len {
        if pe_byte_at(buf, i) == 46 {
            dot = i;
        }
        i = i + 1;
    }
    if dot >= 0 {
        var end: i64 = len - 1;
        while end > dot && pe_byte_at(buf, end) == 48 {
            pe_set_byte(buf, end, 0);
            end = end - 1;
        }
        if end == dot {
            pe_set_byte(buf, dot, 0);
        }
    }
    return pe_buf_str(buf);
}

fn pe_byte_at(buf: i64, i: i64) -> i64 {
    var p: *mut u8 = buf + i;
    var b: i64 = 0;
    unsafe { b = *p; }
    return b;
}

fn pe_set_byte(buf: i64, i: i64, b: i64) {
    var p: *mut u8 = buf + i;
    unsafe { *p = b; }
}

fn pe_str_addr(s: i64) -> i64 {
    return s;
}

// ─── Files (C stdio, binary mode) ───────────────────────────────────────

pub fn pert_file_exists(path: str) -> bool {
    var f: i64 = pe_c_fopen(path, "rb");
    if f == 0 {
        return false;
    }
    pe_c_fclose(f);
    return true;
}

pub fn pert_file_append(path: str, content: str) -> i64 {
    var f: i64 = pe_c_fopen(path, "ab");
    if f == 0 {
        return -1;
    }
    pe_c_fputs(content, f);
    pe_c_fclose(f);
    return 0;
}

pub fn pert_file_delete(path: str) -> i64 {
    if pe_c_remove(path) == 0 {
        return 0;
    }
    return -1;
}

pub fn pert_file_size(path: str) -> i64 {
    var f: i64 = pe_c_fopen(path, "rb");
    if f == 0 {
        return -1;
    }
    pe_c_fseek(f, 0, 2);
    var size: i64 = pe_c_ftell(f);
    pe_c_fclose(f);
    if size < 0 {
        return -1;
    }
    return size;
}

/// Every byte of the file as one element (binary-safe); empty if unreadable.
pub fn pert_file_read_bytes(path: str) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var f: i64 = pe_c_fopen(path, "rb");
    if f == 0 {
        return v;
    }
    var buf: i64 = p_malloc(65536);
    var n: i64 = pe_c_fread(buf, 1, 65536, f);
    while n > 0 {
        var i: i64 = 0;
        while i < n {
            v.push(pe_byte_at(buf, i));
            i = i + 1;
        }
        n = pe_c_fread(buf, 1, 65536, f);
    }
    pe_c_fclose(f);
    return v;
}

/// Each element's low byte, in order.
pub fn pert_file_write_vec(path: str, v: Vec<i64>) -> i64 {
    var f: i64 = pe_c_fopen(path, "wb");
    if f == 0 {
        return -1;
    }
    var n: i64 = v.len();
    if n > 0 {
        var buf: i64 = p_malloc(n);
        var i: i64 = 0;
        while i < n {
            pe_set_byte(buf, i, v.get(i) & 255);
            i = i + 1;
        }
        pe_c_fwrite(buf, 1, n, f);
    }
    pe_c_fclose(f);
    return 0;
}

/// 64-bit FNV-1a of the file's bytes; 0 if it cannot be read.
@wrapping
pub fn pert_file_hash(path: str) -> i64 {
    var f: i64 = pe_c_fopen(path, "rb");
    if f == 0 {
        return 0;
    }
    var h: i64 = -3750763034362895579;
    var buf: i64 = p_malloc(65536);
    var n: i64 = pe_c_fread(buf, 1, 65536, f);
    while n > 0 {
        var i: i64 = 0;
        while i < n {
            h = (h ^ pe_byte_at(buf, i)) * 1099511628211;
            i = i + 1;
        }
        n = pe_c_fread(buf, 1, 65536, f);
    }
    pe_c_fclose(f);
    return h;
}

// ─── C stdio output ─────────────────────────────────────────────────────
// `extern "C"` putchar / puts write through this backend's own stdout, in
// order with print (C stdio would buffer them separately): see c_override
// in pe.rs.

pub fn pert_c_putchar(c: i64) -> i64 {
    p_print_str(p_char_to_str(c & 255));
    return c & 255;
}

pub fn pert_c_puts(s: str) -> i64 {
    p_print_str(s);
    p_print_str("\n");
    return 0;
}

// ─── Clocks, the environment ────────────────────────────────────────────

/// Wall-clock time in 100 ns units since 1970.
fn pe_time_100ns() -> i64 {
    var ft: i64 = p_malloc(8);
    pe_k_system_time(ft);
    var p: *mut i64 = ft;
    var t: i64 = 0;
    unsafe { t = *p; }
    return t - 116444736000000000;
}

pub fn pert_clock_now() -> i64 {
    return pe_time_100ns() * 100;
}

pub fn pert_clock_now_us() -> i64 {
    return pe_time_100ns() / 10;
}

pub fn pert_clock_now_ms() -> i64 {
    return pe_time_100ns() / 10000;
}

/// End the process with this exit code (output is written unbuffered, so
/// nothing is lost).
pub fn pert_exit(code: i64) {
    pe_k_exit_process(code);
}

/// The variable's value; null when it is not set.
pub fn pert_getenv(name: str) -> str {
    return pe_c_getenv(name);
}

// ─── Directories, processes ─────────────────────────────────────────────

pub fn pert_is_dir(path: str) -> bool {
    if pe_str_is_null(path) {
        return false;
    }
    // GetFileAttributesA: DWORD, zero-extended — failure is 0xFFFFFFFF, not -1.
    // Bit 4 (FILE_ATTRIBUTE_DIRECTORY) is set for dirs.
    var a: i64 = pe_k_attrs(path) & 4294967295;
    return a != 4294967295 && (a & 16) != 0;
}

pub fn pert_rename(a: str, b: str) -> i64 {
    if pe_c_rename(a, b) == 0 {
        return 0;
    }
    return -1;
}

pub fn pert_mkdir(path: str) -> i64 {
    if pe_k_mkdir(path, 0) != 0 {
        return 0;
    }
    return -1;
}

/// Remove an EMPTY directory (fs_rmdir_all does the walk-delete).
pub fn pert_rmdir(path: str) -> i64 {
    if pe_k_rmdir(path) != 0 {
        return 0;
    }
    return -1;
}

pub fn pert_getpid() -> i64 {
    return pe_k_getpid();
}

/// Read a whole file into a NUL-terminated heap str; "" on failure.
fn pe_read_all(path: str) -> str {
    var f: i64 = pe_c_fopen(path, "rb");
    if f == 0 {
        return "";
    }
    pe_c_fseek(f, 0, 2);
    var n: i64 = pe_c_ftell(f);
    pe_c_fseek(f, 0, 0);
    if n < 0 {
        n = 0;
    }
    var buf: i64 = p_malloc(n + 1);
    var got: i64 = 0;
    if n > 0 {
        got = pe_c_fread(buf, 1, n, f);
    }
    if got < 0 {
        got = 0;
    }
    pe_set_byte(buf, got, 0);
    pe_c_fclose(f);
    return pe_buf_str(buf);
}

/// Entry names of a directory joined by '\n' (no "./.."); "" on failure.
pub fn pert_dir_list(path: str) -> str {
    if pe_str_is_null(path) {
        return "";
    }
    var pat: str = path + "\\*";
    // WIN32_FIND_DATAA: 318 bytes; cFileName[260] at offset 44.
    var data: i64 = p_malloc(592);
    var h: i64 = pe_k_find_first(pat, data);
    if h == -1 {
        return "";
    }
    var need: i64 = 1;
    var more: i64 = 1;
    while more != 0 {
        var name_len: i64 = 0;
        while pe_byte_at(data + 44, name_len) != 0 {
            name_len = name_len + 1;
        }
        var first_ch: i64 = pe_byte_at(data + 44, 0);
        var is_dot: bool = first_ch == 46 && (name_len == 1 || (name_len == 2 && pe_byte_at(data + 44, 1) == 46));
        if !is_dot {
            need = need + name_len + 1;
        }
        more = pe_k_find_next(h, data);
    }
    pe_k_find_close(h);
    var out: i64 = p_malloc(need);
    pe_set_byte(out, 0, 0);
    var pos: i64 = 0;
    h = pe_k_find_first(pat, data);
    if h == -1 {
        return pe_buf_str(out);
    }
    more = 1;
    while more != 0 {
        var name_len2: i64 = 0;
        while pe_byte_at(data + 44, name_len2) != 0 {
            name_len2 = name_len2 + 1;
        }
        var first_ch2: i64 = pe_byte_at(data + 44, 0);
        var is_dot2: bool = first_ch2 == 46 && (name_len2 == 1 || (name_len2 == 2 && pe_byte_at(data + 44, 1) == 46));
        if !is_dot2 {
            if pos > 0 {
                pe_set_byte(out, pos, 10);
                pos = pos + 1;
            }
            var ci: i64 = 0;
            while ci < name_len2 {
                pe_set_byte(out, pos + ci, pe_byte_at(data + 44, ci));
                ci = ci + 1;
            }
            pos = pos + name_len2;
        }
        more = pe_k_find_next(h, data);
    }
    pe_k_find_close(h);
    pe_set_byte(out, pos, 0);
    return pe_buf_str(out);
}

/// Run a shell command capturing stdout/stderr/exit code. The handle is a
/// heap record [out ptr, err ptr, code]; 0 on failure to start.
pub fn pert_process_run(cmd: str) -> i64 {
    if pe_str_is_null(cmd) || p_str_length(cmd) == 0 {
        return 0;
    }
    var rec: i64 = p_malloc(24);
    // The record address is unique per live call — a safe temp-name tag.
    var of: str = ".fprc_" + int_to_str(rec) + ".out";
    var ef: str = ".fprc_" + int_to_str(rec) + ".err";
    var code: i64 = pe_c_system("( " + cmd + " ) > \"" + of + "\" 2> \"" + ef + "\"");
    var outp: *mut i64 = rec;
    var errp: *mut i64 = rec + 8;
    var codep: *mut i64 = rec + 16;
    var outv: i64 = pe_str_addr(pe_read_all(of));
    var errv: i64 = pe_str_addr(pe_read_all(ef));
    unsafe { *outp = outv; *errp = errv; *codep = code; }
    pe_c_remove(of);
    pe_c_remove(ef);
    return rec;
}

fn pe_proc_field(h: i64, off: i64) -> i64 {
    if h == 0 {
        return 0;
    }
    var p: *mut i64 = h + off;
    var v: i64 = 0;
    unsafe { v = *p; }
    return v;
}

pub fn pert_process_stdout(h: i64) -> str {
    return pe_proc_field(h, 0);
}

pub fn pert_process_stderr(h: i64) -> str {
    return pe_proc_field(h, 8);
}

pub fn pert_process_code(h: i64) -> i64 {
    if h == 0 {
        return -1;
    }
    return pe_proc_field(h, 16);
}

pub fn pert_process_close(h: i64) {
    if h == 0 {
        return;
    }
    // The output strings belong to whoever read them: only the record goes.
    p_free(h);
}

// ─── Wildcard matching ('?' one byte, '*' any run) ──────────────────────

pub fn pert_regex_match(s: str, pattern: str) -> bool {
    if pe_str_is_null(s) || pe_str_is_null(pattern) {
        return false;
    }
    var sa: i64 = pe_str_addr(s);
    var pa: i64 = pe_str_addr(pattern);
    var s_len: i64 = p_str_length(s);
    var p_len: i64 = p_str_length(pattern);
    var si: i64 = 0;
    var pi: i64 = 0;
    var star_s: i64 = -1;
    var star_p: i64 = -1;
    while si < s_len {
        if pi < p_len && (pe_byte_at(pa, pi) == 63 || pe_byte_at(pa, pi) == pe_byte_at(sa, si)) {
            si = si + 1;
            pi = pi + 1;
        } else if pi < p_len && pe_byte_at(pa, pi) == 42 {
            star_p = pi;
            star_s = si;
            pi = pi + 1;
        } else if star_p >= 0 {
            pi = star_p + 1;
            si = star_s + 1;
            star_s = si;
        } else {
            return false;
        }
    }
    while pi < p_len && pe_byte_at(pa, pi) == 42 {
        pi = pi + 1;
    }
    return pi == p_len;
}

// ─── Memory ─────────────────────────────────────────────────────────────

pub fn pert_alloc(size: i64) -> i64 {
    return p_malloc(size);
}

pub fn pert_volatile_load(addr: i64) -> i64 {
    var p: *mut i64 = addr;
    var v: i64 = 0;
    unsafe { v = *p; }
    return v;
}

pub fn pert_volatile_store(addr: i64, val: i64) {
    var p: *mut i64 = addr;
    unsafe { *p = val; }
}

pub fn pert_volatile_load8(addr: i64) -> i64 {
    return pe_byte_at(addr, 0);
}

pub fn pert_volatile_store8(addr: i64, val: i64) {
    pe_set_byte(addr, 0, val);
}

pub fn pert_volatile_load32(addr: i64) -> i64 {
    var p: *mut u32 = addr;
    var v: i64 = 0;
    unsafe { v = *p; }
    return v;
}

pub fn pert_volatile_store32(addr: i64, val: i64) {
    var p: *mut u32 = addr;
    unsafe { *p = val; }
}

// ─── SIMD vectors: Vec<f64> of any length, elementwise ──────────────────

pub fn pert_simd_add(a: Vec<f64>, b: Vec<f64>) -> Vec<f64> {
    var r: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        r.push(a.get(i) + b.get(i));
        i = i + 1;
    }
    return r;
}

pub fn pert_simd_sub(a: Vec<f64>, b: Vec<f64>) -> Vec<f64> {
    var r: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        r.push(a.get(i) - b.get(i));
        i = i + 1;
    }
    return r;
}

pub fn pert_simd_mul(a: Vec<f64>, b: Vec<f64>) -> Vec<f64> {
    var r: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        r.push(a.get(i) * b.get(i));
        i = i + 1;
    }
    return r;
}

/// x / 0 is 0.
pub fn pert_simd_div(a: Vec<f64>, b: Vec<f64>) -> Vec<f64> {
    var r: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        var d: f64 = b.get(i);
        if d != 0.0 {
            r.push(a.get(i) / d);
        } else {
            r.push(0.0);
        }
        i = i + 1;
    }
    return r;
}

pub fn pert_simd_dot(a: Vec<f64>, b: Vec<f64>) -> f64 {
    var s: f64 = 0.0;
    var i: i64 = 0;
    while i < a.len() {
        s = s + a.get(i) * b.get(i);
        i = i + 1;
    }
    return s;
}

pub fn pert_simd_sum(a: Vec<f64>) -> f64 {
    var s: f64 = 0.0;
    var i: i64 = 0;
    while i < a.len() {
        s = s + a.get(i);
        i = i + 1;
    }
    return s;
}

pub fn pert_simd_scale(a: Vec<f64>, k: f64) -> Vec<f64> {
    var r: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        r.push(a.get(i) * k);
        i = i + 1;
    }
    return r;
}

pub fn pert_simd_from_vec(v: Vec<i64>) -> Vec<f64> {
    var r: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < v.len() {
        r.push(v.get(i) as f64);
        i = i + 1;
    }
    return r;
}

/// "[1, 2.5]": whole numbers as integers, others as %g.
pub fn pert_simd_to_str(a: Vec<f64>) -> str {
    var out: str = "[";
    var buf: i64 = p_malloc(64);
    var i: i64 = 0;
    while i < a.len() {
        if i > 0 {
            out = out + ", ";
        }
        var d: f64 = a.get(i);
        var n: i64 = d as i64;
        if d == (n as f64) {
            out = out + int_to_str(n);
        } else {
            pe_c_fmt_f64(buf, 63, "%g", d);
            out = out + pe_buf_str(buf);
        }
        i = i + 1;
    }
    return out + "]";
}

// ─── Dynamic loading: simulated, as in the C backend and interpreter ───

var pert_dl_handles: i64 = 0;

/// Sequential handles 1, 2, ...; 0 for an empty path.
pub fn pert_dl_open(path: str) -> i64 {
    if pe_str_is_null(path) || p_str_length(path) == 0 {
        return 0;
    }
    pert_dl_handles = pert_dl_handles + 1;
    return pert_dl_handles;
}

pub fn pert_dl_sym(handle: i64, symbol: str) -> i64 {
    if handle == 0 || pe_str_is_null(symbol) || p_str_length(symbol) == 0 {
        return 0;
    }
    return 4096 + handle * 256;
}

pub fn pert_dl_close(handle: i64) {
}

/// Simulated: the argument back.
pub fn pert_dl_call(func: i64, arg: i64) -> i64 {
    return arg;
}

// ─── Allocators: the general heap ───────────────────────────────────────

pub fn pert_allocator_create(arg: i64) -> i64 {
    return 1;
}

pub fn pert_allocator_alloc(alloc: i64, size: i64) -> i64 {
    if size < 0 {
        return 0;
    }
    return p_malloc(size);
}

pub fn pert_allocator_free(alloc: i64, ptr: i64) {
    p_free(ptr);
}

pub fn pert_allocator_stats(alloc: i64) -> i64 {
    return 0;
}

// ─── Entity-component store ─────────────────────────────────────────────
// Per component name: a Vec of (entity, value) pairs, flattened.

var pert_ecs_entities: i64 = 0;
var pert_ecs_names: i64 = 0;
var pert_ecs_tables: i64 = 0;

/// The table of component `name`, created when `create` (else 0).
fn pe_ecs_table(name: str, create: bool) -> i64 {
    if pert_ecs_names == 0 {
        pert_ecs_names = Vec_new();
        pert_ecs_tables = Vec_new();
    }
    var i: i64 = 0;
    while i < Vec_len(pert_ecs_names) {
        if p_str_equal(Vec_get(pert_ecs_names, i), name) {
            return Vec_get(pert_ecs_tables, i);
        }
        i = i + 1;
    }
    if !create {
        return 0;
    }
    var table: i64 = Vec_new();
    Vec_push(pert_ecs_names, pe_str_addr(name));
    Vec_push(pert_ecs_tables, table);
    return table;
}

pub fn pert_ecs_create_entity() -> i64 {
    var e: i64 = pert_ecs_entities;
    pert_ecs_entities = e + 1;
    return e;
}

pub fn pert_ecs_entity_count() -> i64 {
    return pert_ecs_entities;
}

pub fn pert_ecs_has(name: str, entity: i64) -> i64 {
    var t: i64 = pe_ecs_table(name, false);
    if t == 0 {
        return 0;
    }
    var i: i64 = 0;
    while i < Vec_len(t) {
        if Vec_get(t, i) == entity {
            return 1;
        }
        i = i + 2;
    }
    return 0;
}

pub fn pert_ecs_get(name: str, entity: i64) -> i64 {
    var t: i64 = pe_ecs_table(name, false);
    if t == 0 {
        return 0;
    }
    var i: i64 = 0;
    while i < Vec_len(t) {
        if Vec_get(t, i) == entity {
            return Vec_get(t, i + 1);
        }
        i = i + 2;
    }
    return 0;
}

/// Set the entity's value (a new entry, or the existing one updated).
pub fn pert_ecs_add(name: str, entity: i64, value: i64) -> i64 {
    var t: i64 = pe_ecs_table(name, true);
    var i: i64 = 0;
    while i < Vec_len(t) {
        if Vec_get(t, i) == entity {
            Vec_set(t, i + 1, value);
            return 0;
        }
        i = i + 2;
    }
    Vec_push(t, entity);
    Vec_push(t, value);
    return 0;
}

/// Remove the entity's entry: the last entry takes its place.
pub fn pert_ecs_remove(name: str, entity: i64) -> i64 {
    var t: i64 = pe_ecs_table(name, false);
    if t == 0 {
        return 0;
    }
    var i: i64 = 0;
    var n: i64 = Vec_len(t);
    while i < n {
        if Vec_get(t, i) == entity {
            Vec_set(t, i, Vec_get(t, n - 2));
            Vec_set(t, i + 1, Vec_get(t, n - 1));
            Vec_pop(t);
            Vec_pop(t);
            return 0;
        }
        i = i + 2;
    }
    return 0;
}

// ─── stdin / stdout ─────────────────────────────────────────────────────

/// feof() semantics: true only after a read hit the end of stdin.
var pert_stdin_eof_flag: i64 = 0;

/// Little-endian dword read (ReadFile's out count is a 32-bit DWORD).
fn pe_dword_at(buf: i64, i: i64) -> i64 {
    return pe_byte_at(buf, i)
        | (pe_byte_at(buf, i + 1) << 8)
        | (pe_byte_at(buf, i + 2) << 16)
        | (pe_byte_at(buf, i + 3) << 24);
}

/// Our prints go straight to WriteFile — unbuffered — so there is nothing
/// pending; flushing all C streams mirrors `fflush(stdout)` anyway.
pub fn pert_flush_stdout() {
    pe_c_fflush(0);
}

pub fn pert_stdin_eof() -> i64 {
    return pert_stdin_eof_flag;
}

/// p_read_stdin(n): up to n raw bytes from stdin as a NUL-terminated str.
/// Sets the eof flag when the stream ends before n bytes.
pub fn pert_read_stdin(n: i64) -> str {
    if n < 0 {
        n = 0;
    }
    var buf: i64 = p_malloc(n + 1);
    if buf == 0 {
        return "";
    }
    var rd_ptr: i64 = p_malloc(8);
    var h: i64 = pe_k_std_handle(-10); // STD_INPUT_HANDLE
    var got: i64 = 0;
    while got < n {
        pe_set_byte(rd_ptr, 0, 0);
        pe_set_byte(rd_ptr, 1, 0);
        pe_set_byte(rd_ptr, 2, 0);
        pe_set_byte(rd_ptr, 3, 0);
        var ok: i64 = pe_k_read_file(h, buf + got, n - got, rd_ptr, 0);
        var rd: i64 = pe_dword_at(rd_ptr, 0);
        if ok == 0 || rd == 0 {
            pert_stdin_eof_flag = 1;
            break;
        }
        got = got + rd;
    }
    pe_set_byte(buf, got, 0);
    return pe_buf_str(buf);
}

/// p_read_line(): one line without the trailing '\n'; "" on EOF or error
/// (eof flag set on end of stream — callers test it like feof()).
/// Byte reads are enough: this serves the REPL/debugger, not bulk input.
pub fn pert_read_line() -> str {
    var buf: i64 = p_malloc(65537);
    if buf == 0 {
        return "";
    }
    var rd_ptr: i64 = p_malloc(8);
    var h: i64 = pe_k_std_handle(-10);
    var got: i64 = 0;
    while got < 65536 {
        pe_set_byte(rd_ptr, 0, 0);
        pe_set_byte(rd_ptr, 1, 0);
        pe_set_byte(rd_ptr, 2, 0);
        pe_set_byte(rd_ptr, 3, 0);
        var ok: i64 = pe_k_read_file(h, buf + got, 1, rd_ptr, 0);
        if ok == 0 || pe_dword_at(rd_ptr, 0) == 0 {
            pert_stdin_eof_flag = 1;
            break;
        }
        if pe_byte_at(buf, got) == 10 {
            break;
        }
        got = got + 1;
    }
    pe_set_byte(buf, got, 0);
    return pe_buf_str(buf);
}
