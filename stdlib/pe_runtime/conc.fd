// src/pe_runtime/conc.fd — threads, futures, executors, atomics, mutexes,
// thread-local storage and channels for native Windows executables (see
// base.fd for how this runtime works). The behaviour is the C backend's:
//   - p_thread_spawn(name, nargs, args...) runs the program function of that
//     name on a new thread and returns a future: -(index + 1) into a table
//     of 256 threads; p_future_poll / p_task_poll join it and return its
//     result (a value >= 0 is an already-ready future)
//   - an executor is only a number: its tasks are threads of the same table
//   - a channel is a bounded queue under a lock with two condition variables
// The backend passes the varargs of p_thread_spawn / p_executor_spawn as an
// array (pert_thread_spawn_v), and starts each thread in pert_thread_main.

extern "C" {
    // kernel32.dll
    fn CreateThread as pe_k_create_thread(attrs: i64, stack: i64, start: i64, arg: i64, flags: i64, id: i64) -> i64;
    fn WaitForSingleObject as pe_k_wait(handle: i64, ms: i64) -> u32;
    fn CreateMutexA as pe_k_create_mutex(attrs: i64, owner: i64, name: str) -> i64;
    fn ReleaseMutex as pe_k_release_mutex(mutex: i64) -> i32;
    fn GetSystemInfo as pe_k_sysinfo(info: i64);
    fn CloseHandle as pe_k_close_handle(handle: i64) -> i32;
    fn InitializeSRWLock as pe_k_lock_init(lock: i64);
    fn AcquireSRWLockExclusive as pe_k_lock(lock: i64);
    fn ReleaseSRWLockExclusive as pe_k_unlock(lock: i64);
    fn InitializeConditionVariable as pe_k_cond_init(cond: i64);
    fn SleepConditionVariableSRW as pe_k_cond_wait(cond: i64, lock: i64, ms: i64, flags: i64) -> i32;
    fn WakeConditionVariable as pe_k_cond_signal(cond: i64);
    fn WakeAllConditionVariable as pe_k_cond_broadcast(cond: i64);
    fn VirtualAlloc as pe_k_valloc(addr: i64, size: i64, kind: i64, prot: i64) -> i64;
    fn VirtualFree as pe_k_vfree(addr: i64, size: i64, kind: i64) -> i32;
    fn CreateIoCompletionPort as pe_k_iocp_create(file: i64, port: i64, key: i64, threads: i64) -> i64;
    fn GetQueuedCompletionStatusEx as pe_k_gqcs_ex(port: i64, entries: i64, count: i64, removed: i64, ms: i64, alertable: i64) -> i32;
    fn PostQueuedCompletionStatus as pe_k_pqcs(port: i64, bytes: i64, key: i64, overlapped: i64) -> i32;
    fn GetTickCount64 as pe_k_ticks() -> i64;
    fn Sleep as pe_k_sleep(ms: i64);
    fn TlsAlloc as pe_k_tls_alloc() -> u32;
    fn TlsGetValue as pe_k_tls_get(key: i64) -> i64;
    fn TlsSetValue as pe_k_tls_set(key: i64, value: i64) -> i32;
    // Machine-code primitives (pe_ir_stubs.fd). MI20: the C name is the
    // machine layer's interface name (prim_interface_names), the Fides
    // name the one this runtime calls; pe_ir gives both the same bytes
    // (PeirGen_nat_alias)
    fn nat_atomic_load as nat_atomic_load(addr: i64) -> i64;
    fn nat_atomic_store as nat_atomic_store(addr: i64, value: i64);
    fn nat_atomic_add as nat_atomic_add(addr: i64, value: i64) -> i64;
    fn nat_atomic_cas as nat_atomic_cas(addr: i64, expected: i64, new_value: i64) -> bool;
    fn pe_fn_lookup(name: str) -> i64;
    fn nat_call_fn as nat_call_fn(addr: i64, nargs: i64, argv: i64) -> i64;
    fn pe_thread_entry_addr() -> i64;
    fn nat_ctx_swap as nat_ctx_swap(save: i64, sp: i64);
    fn nat_ctx_tramp as pe_ctx_tramp_addr() -> i64;
}

// Readiness of a socket through its AFD driver, completed on an I/O
// completion port (competitive RT11): what wepoll, mio and libuv use
extern "C" link "ntdll" {
    fn NtCreateFile as pe_nt_create_file(handle: i64, access: i64, attrs: i64, iosb: i64, alloc: i64, fattrs: i64, share: i64, disposition: i64, options: i64, ea: i64, ealen: i64) -> i32;
    fn NtDeviceIoControlFile as pe_nt_ioctl(file: i64, event: i64, apc: i64, apc_ctx: i64, iosb: i64, code: i64, inb: i64, inlen: i64, outb: i64, outlen: i64) -> i32;
    fn NtCancelIoFileEx as pe_nt_cancel(file: i64, iosb: i64, cancel_iosb: i64) -> i32;
}

extern "C" link "ws2_32" {
    fn WSAIoctl as pe_w_wsaioctl(s: i64, code: i64, inb: i64, inlen: i64, outb: i64, outlen: i64, ret: i64, overlapped: i64, routine: i64) -> i32;
    fn WSAPoll as pe_k_wsa_poll(fds: i64, n: i64, timeout: i32) -> i32;
    fn WSAStartup as pe_w_startup(version: i64, data: i64) -> i32;
    fn WSAGetLastError as pe_w_last_error() -> i32;
    fn socket as pe_w_socket(family: i64, kind: i64, protocol: i64) -> i64;
    fn bind as pe_w_bind(s: i64, addr: i64, len: i64) -> i32;
    fn listen as pe_w_listen(s: i64, backlog: i64) -> i32;
    fn accept as pe_w_accept(s: i64, addr: i64, len: i64) -> i64;
    fn connect as pe_w_connect(s: i64, addr: i64, len: i64) -> i32;
    fn recv as pe_w_recv(s: i64, buf: i64, len: i64, flags: i64) -> i32;
    fn send as pe_w_send(s: i64, buf: i64, len: i64, flags: i64) -> i32;
    fn closesocket as pe_w_close(s: i64) -> i32;
    fn setsockopt as pe_w_setsockopt(s: i64, level: i64, opt: i64, value: i64, len: i64) -> i32;
    fn ioctlsocket as pe_w_ioctl(s: i64, cmd: i64, arg: i64) -> i32;
    fn getaddrinfo as pe_w_getaddrinfo(host: str, service: i64, hints: i64, res: i64) -> i32;
    fn freeaddrinfo as pe_w_freeaddrinfo(res: i64);
}

/// WaitForSingleObject / SleepConditionVariableSRW: no timeout.
fn pe_infinite() -> i64 {
    return 4294967295;
}

/// What a non-blocking poll returns for a task still running, and a
/// receive on a channel closed and empty (C: 0x8000000000000001).
fn pe_pending() -> i64 {
    return -9223372036854775807;
}

fn pe_load(addr: i64) -> i64 {
    var p: *mut i64 = addr;
    var v: i64 = 0;
    // SAFETY: NOT checked here: every caller in this file reads a word of a
    // block it allocated (thread/task blocks, contexts, queues, channels,
    // the timer heap) or one the kernel filled (SYSTEM_INFO, addrinfo);
    // the layouts are in each section's comment.
    unsafe {
        v = *p;
    }
    return v;
}

fn pe_store(addr: i64, value: i64) {
    var p: *mut i64 = addr;
    // SAFETY: NOT checked here: as pe_load, a word of a block of this
    // runtime's.
    unsafe {
        *p = value;
    }
}

/// n zeroed 8-byte slots.
fn pe_zeroed(n: i64) -> i64 {
    var block: i64 = p_malloc(n * 8);
    var i: i64 = 0;
    while i < n {
        pe_store(block + i * 8, 0);
        i = i + 1;
    }
    return block;
}

// ─── Anonymous mappings (CU7, stdlib/mmap.fd) ────────────
// As the C runtime's p_mmap_*: VirtualAlloc'd pages, and a table of 256
// [address, length] pairs (made on first use) for p_mmap_len and
// p_munmap. Like the C runtime's table, not shared safely between threads.

var pe_mmap_tab: i64 = 0;

fn pe_mmap_table() -> i64 {
    if pe_mmap_tab == 0 {
        pe_mmap_tab = pe_zeroed(512);
    }
    return pe_mmap_tab;
}

/// The table index of mapping `addr` (0: a free entry), -1 when none.
fn pe_mmap_find(addr: i64) -> i64 {
    var t: i64 = pe_mmap_table();
    var i: i64 = 0;
    while i < 256 {
        if pe_load(t + i * 16) == addr {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

/// `len` zeroed read/write bytes of their own pages; 0 on failure.
pub fn pert_mmap_anon(len: i64) -> i64 {
    if len <= 0 {
        return 0;
    }
    var s: i64 = pe_mmap_find(0);
    if s < 0 {
        return 0;
    }
    // MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE (pages read zero)
    var p: i64 = pe_k_valloc(0, len, 12288, 4);
    if p == 0 {
        return 0;
    }
    var t: i64 = pe_mmap_table();
    pe_store(t + s * 16, p);
    pe_store(t + s * 16 + 8, len);
    return p;
}

/// The length of mapping `addr`, 0 when it is not one.
pub fn pert_mmap_len(addr: i64) -> i64 {
    if addr == 0 {
        return 0;
    }
    var s: i64 = pe_mmap_find(addr);
    if s < 0 {
        return 0;
    }
    return pe_load(pe_mmap_table() + s * 16 + 8);
}

/// Unmap `addr`: 0, or -1 when it is not a mapping.
pub fn pert_munmap(addr: i64) -> i64 {
    if addr == 0 {
        return 0 - 1;
    }
    var s: i64 = pe_mmap_find(addr);
    if s < 0 {
        return 0 - 1;
    }
    var t: i64 = pe_mmap_table();
    pe_store(t + s * 16, 0);
    pe_store(t + s * 16 + 8, 0);
    pe_k_vfree(addr, 0, 32768);
    // MEM_RELEASE
    return 0;
}

// ─── Random-choice scheduling (competitive RL17) ─────────
// FIDES_SCHED_RANDOM=<seed> (a decimal number, not 0) turns it on, for
// interleaving tests (scripts/verify/interleave.py --sched-random): one
// worker thread, which takes the next task at random among all runnable
// ones instead of the oldest; a task's loop safepoint (pert_co_tick) gives
// up control one time in two whenever another task is runnable; threads
// (p_thread_spawn), mutexes, atomics and channels sleep 0 or 1 ms one time
// in four, so OS-thread interleavings vary too. The scheduler's choices
// follow from the seed (the OS still schedules the threads). Off, each hook
// costs one load. The same switch drives linux_runtime/conc.fd.
var pert_rnd: i64 = 0;  // *i64: the xorshift state
var pert_rnd_on: i64 = 0;  // 0 not read yet, 1 random mode, 2 off

/// Random mode is on (FIDES_SCHED_RANDOM, read once).
fn pe_rnd_enabled() -> bool {
    if pert_rnd_on == 0 {
        pe_rnd_init();
    }
    return pert_rnd_on == 1;
}

fn pe_rnd_byte(p: i64) -> i64 {
    var bp: *mut u8 = p;
    var b: i64 = 0;
    // SAFETY: p is inside the NUL-terminated string getenv returned (the
    // caller stops at its first byte that is not a digit, the NUL included).
    unsafe {
        b = *bp;
    }
    return b;
}

@wrapping
fn pe_rnd_init() {
    var s: i64 = pe_c_getenv("FIDES_SCHED_RANDOM") as i64;
    var seed: i64 = 0;
    if s != 0 {
        var i: i64 = 0;
        var b: i64 = pe_rnd_byte(s);
        while b >= 48 && b <= 57 && i < 18 {
            seed = seed * 10 + (b - 48);
            i = i + 1;
            b = pe_rnd_byte(s + i);
        }
    }
    if seed == 0 {
        pert_rnd_on = 2;
        return;
    }
    // two threads may read it at once: each makes the same state
    var st: i64 = pe_zeroed(1);
    var x: i64 = seed * 2654435761 + 88172645463325252;
    if x == 0 {
        x = 1;
    }
    pe_store(st, x);
    pert_rnd = st;
    pert_rnd_on = 1;
}

/// The next number of the xorshift64 sequence (shared by every thread), >= 0.
@wrapping
fn pe_rnd_next() -> i64 {
    while true {
        var x: i64 = nat_atomic_load(pert_rnd);
        var y: i64 = x ^ (x << 13);
        y = y ^ ((y >> 7) & 0x01FFFFFFFFFFFFFF);
        y = y ^ (y << 17);
        if nat_atomic_cas(pert_rnd, x, y) == true {
            return y & 0x7FFFFFFFFFFFFFFF;
        }
    }
    return 0;
}

/// A random number in [0, n) (0 when n <= 1).
fn pe_rnd_below(n: i64) -> i64 {
    if n <= 1 {
        return 0;
    }
    return pe_rnd_next() % n;
}

/// An OS-thread interleaving point: in random mode, sleep 1 ms one time in
/// eight and give up the CPU one time in eight.
fn pe_rnd_jitter() {
    if pe_rnd_enabled() {
        var r: i64 = pe_rnd_below(8);
        if r == 0 {
            pe_k_sleep(1);
        } else if r == 1 {
            pe_k_sleep(0);
        }
    }
}

// ─── The thread table ───────────────────────────────────────────────────
// Per thread i: its handle (0 once joined), its start block, its result.
// Start block: [0] function, [1] nargs, [2..10) args, [10] done flag,
// [11] result.
// BG110: the table is chunked, as the C runtime's future table (BG9): a
// directory of PE_THR_DIR chunks of PE_THR_CHUNK entries of three words
// (handle, block, result), a chunk allocated when an index in it is first
// handed out and never moved; an index is taken with an atomic add. It was
// three fixed tables of 256 entries and an unlocked count: the 257th thread
// could not start (its future was -1), and two threads spawning at once
// could take one index.

const PE_THR_CHUNK: i64 = 256;
const PE_THR_DIR: i64 = 4096;

var pert_thread_dir: i64 = 0;
var pert_thread_ctr: i64 = 0;  // *i64: indexes handed out
var pert_executor_count: i64 = 0;

fn pe_thread_tables() {
    if pert_thread_dir == 0 {
        pert_thread_dir = pe_zeroed(PE_THR_DIR);
        pert_thread_ctr = pe_zeroed(1);
    }
}

/// How many indexes were handed out (at most the table's size).
fn pe_thread_count() -> i64 {
    if pert_thread_ctr == 0 {
        return 0;
    }
    var n: i64 = nat_atomic_load(pert_thread_ctr);
    if n > PE_THR_CHUNK * PE_THR_DIR {
        n = PE_THR_CHUNK * PE_THR_DIR;
    }
    return n;
}

/// The address of entry idx's three words, 0 while its chunk is not there
/// yet (an index another thread is still handing out).
fn pe_thr_slot(idx: i64) -> i64 {
    if pert_thread_dir == 0 || idx < 0 || idx >= PE_THR_CHUNK * PE_THR_DIR {
        return 0;
    }
    var ch: i64 = nat_atomic_load(pert_thread_dir + (idx / PE_THR_CHUNK) * 8);
    if ch == 0 {
        return 0;
    }
    return ch + (idx % PE_THR_CHUNK) * 24;
}

/// Make the chunk of entry idx (the first thread to need it allocates it;
/// one that loses the race frees its copy).
fn pe_thr_make(idx: i64) {
    var at: i64 = pert_thread_dir + (idx / PE_THR_CHUNK) * 8;
    if nat_atomic_load(at) == 0 {
        var ch: i64 = pe_zeroed(PE_THR_CHUNK * 3);
        if nat_atomic_cas(at, 0, ch) == false {
            p_free(ch);
        }
    }
}

/// Entry idx's handle (0: joined, or not there yet).
fn pe_thr_handle(idx: i64) -> i64 {
    var s: i64 = pe_thr_slot(idx);
    if s == 0 {
        return 0;
    }
    return nat_atomic_load(s);
}

/// Start the program function `name` with argv[0..nargs) on a new thread.
pub fn pert_thread_spawn_v(name: str, nargs: i64, argv: i64) -> i64 {
    // LG11: p_co_stack by name (the C runtime's handshake): -2 here
    if name == "__p_co_stack" {
        return pert_c_p_co_stack(0);
    }
    var fn_addr: i64 = pe_fn_lookup(name);
    if fn_addr == 0 {
        return -1;
    }
    pe_thread_tables();
    var idx: i64 = nat_atomic_add(pert_thread_ctr, 1);
    if idx >= PE_THR_CHUNK * PE_THR_DIR {
        return -1;
    }
    pe_thr_make(idx);
    var block: i64 = pe_zeroed(14);
    pe_store(block, fn_addr);
    pe_store(block + 8, nargs);
    var i: i64 = 0;
    while i < nargs && i < 8 {
        pe_store(block + 16 + i * 8, pe_load(argv + i * 8));
        i = i + 1;
    }
    var slot: i64 = pe_thr_slot(idx);
    pe_store(slot + 8, block);
    var handle: i64 = pe_k_create_thread(0, 0, pe_thread_entry_addr(), block, 0, 0);
    // (the handle last: a scan that sees it finds the block)
    nat_atomic_store(slot, handle);
    return 0 - (idx + 1);
}

pub fn pert_executor_spawn_v(name: str, nargs: i64, argv: i64) -> i64 {
    return pert_thread_spawn_v(name, nargs, argv);
}

/// Runs on the new thread: the function, then its result and done flag.
pub fn pert_thread_main(block: i64) -> i64 {
    pe_rnd_jitter();
    // SL15: every OS thread is one the sampling profiler can look at (a
    // task, entered here too, runs on a thread already registered)
    if pe_load(block + 96) == 0 {
        pe_pf_thread_start(pe_load(block));
    }
    var result: i64 = nat_call_fn(pe_load(block), pe_load(block + 8), block + 16);
    pe_store(block + 88, result);
    // RT7: an OS thread that ends gives its allocator chunk and free lists
    // to the threads that stay (before its joiner can run on)
    if pe_load(block + 96) == 0 {
        pert_alloc_thread_end();
    }
    nat_atomic_store(block + 80, 1);
    // A task runs on its own stack: it ends by giving control back for good,
    // saying it finished (2, BG227: whoever resumes reads that, not [10])
    if pe_load(block + 96) != 0 {
        pe_co_leave_as(2);
    }
    return result;
}

// ─── Task contexts (competitive RT9) ─────────────────────
// Tasks switch with their own machine code (pe_ctx_swap, compiler/
// pe_ir_stubs.fd), not Windows fibers. A context is two words: [0] its saved
// stack pointer, [1] the base of the stack it owns (0: a thread's own), [2]
// busy: 1 while it runs or is still saving its registers (pe_ctx_swap clears
// it once on the new stack, so a context woken on another thread is resumed
// only after that), [3] why the task that last switched to it left: 1 still
// runnable (a yield), 0 blocked, 2 finished (BG227). The task says so itself: its
// state word can already be changed by a wake on another thread. A
// task stack is laid out as Windows lays out a thread's: 1 MB reserved, the
// top 16 KB committed, a guard page under them; the switch carries the TEB's
// stack fields, so the system grows the stack and reports its overflow
// ("Panic: Stack overflow") as on a thread. Finished tasks' stacks are kept
// for the next ones (up to 256).

var pert_stk_lock: i64 = 0;  // SRWLOCK of the stack cache
var pert_stk_free: i64 = 0;  // cached stack bases
var pert_stk_n: i64 = 0;

/// The context of the running thread's own stack. It has a fifth word: [4]
/// the task that last left to it (pe_co_leave_as), which is not always the
/// one the worker resumed: a yield can hand the worker straight to the next
/// task (pe_co_handoff), and that one leaves to the scheduler later. [5] is
/// the worker's id + 1 (0: not a worker's), so a yield finds its queue
/// without a TLS lookup.
fn pe_ctx_thread() -> i64 {
    var ctx: i64 = pe_zeroed(6);
    pe_store(ctx + 16, 1);
    return ctx;
}

/// Claim `to` for this thread: wait until it has saved its registers
/// (pe_ctx_swap clears its busy word), then mark it busy. A task woken on
/// another thread can still be leaving there: claim it before writing its
/// block (where it returns to), or it reads this thread's values on its way out.
fn pe_ctx_claim(to: i64) {
    while nat_atomic_load(to + 16) != 0 {
    }
    pe_store(to + 16, 1);
}

/// Save the running context in `from`, resume `to` (claimed)
fn pe_ctx_resume(from: i64, to: i64) {
    nat_ctx_swap(from, pe_load(to));
}

/// Save the running context in `from`, resume `to` (once it is saved)
fn pe_ctx_switch(from: i64, to: i64) {
    pe_ctx_claim(to);
    pe_ctx_resume(from, to);
}

fn pe_ctx_stack() -> i64 {
    var base: i64 = 0;
    pe_k_lock(pert_stk_lock);
    if pert_stk_n > 0 {
        pert_stk_n = pert_stk_n - 1;
        base = pe_load(pert_stk_free + pert_stk_n * 8);
    }
    pe_k_unlock(pert_stk_lock);
    if base != 0 {
        return base;
    }
    base = pe_k_valloc(0, 1048576, 0x2000, 4);  // MEM_RESERVE
    if base == 0 {
        return 0;
    }
    var top: i64 = base + 1048576;
    if pe_k_valloc(top - 16384, 16384, 0x1000, 4) == 0 {  // MEM_COMMIT
        pe_k_vfree(base, 0, 0x8000);
        return 0;
    }
    pe_k_valloc(top - 20480, 4096, 0x1000, 0x104);  // PAGE_GUARD
    return base;
}

/// A new task's context: its first switch "returns" into the trampoline,
/// which calls entry(arg) (C convention)
fn pe_ctx_new(entry: i64, arg: i64) -> i64 {
    var base: i64 = pe_ctx_stack();
    if base == 0 {
        return 0;
    }
    var top: i64 = base + 1048576;
    var s: i64 = top - 256;
    var i: i64 = 0;
    while i < 32 {
        pe_store(s + i * 8, 0);
        i = i + 1;
    }
    // xmm6-15 [0, 160), the TEB stack fields, r15 r14 r13 r12 rsi rdi rbx
    // rbp, the return address
    pe_store(s + 160, top);
    pe_store(s + 168, top - 16384);
    pe_store(s + 176, base);
    pe_store(s + 200, entry);
    pe_store(s + 208, arg);
    pe_store(s + 248, pe_ctx_tramp_addr());
    var ctx: i64 = pe_zeroed(4);
    pe_store(ctx, s);
    pe_store(ctx + 8, base);
    return ctx;
}

/// Free a finished task's context (never the running one)
fn pe_ctx_free(ctx: i64) {
    var base: i64 = pe_load(ctx + 8);
    if base != 0 {
        pe_k_lock(pert_stk_lock);
        if pert_stk_n < 256 {
            pe_store(pert_stk_free + pert_stk_n * 8, base);
            pert_stk_n = pert_stk_n + 1;
            base = 0;
        }
        pe_k_unlock(pert_stk_lock);
        if base != 0 {
            pe_k_vfree(base, 0, 0x8000);  // MEM_RELEASE
        }
    }
    p_free(ctx);
}

// ─── Tasks: green threads (M:N scheduler) ─────────────────
// A task's block is a thread's, with [12] = 1 and [13] its context, then [14] the
// task it awaits, [15] the task it returns to when it first suspends, [16] the
// socket it waits for (-1: none), [17] 1 to wait for writing, [18] the result
// of the wait, [19] when the wait ends in ms (0: never), [20] freed once done,
// [21] the scheduler context it yields back to, [22] queue links, [23] a pending
// blocking-pool job, [24] the wait state: 0 runnable-or-running, 1 blocked on a
// wait in the registry (fd/join/pool), 2 already requeued by a wake, 3 blocked
// on a deadline in the timer heap only, 4 blocked on a socket poll on the
// completion port; [28] that poll (RT11); [30] its token slot (CA7/CA8,
// "Token slot" below); (CA9) [31] its function's name, [32] the name of the
// task that started it (0: started off a task), [33] the task awaiting it
// (set while it waits); [34] the next task of the list it is parked on (a
// channel's or a mutex's, "Parked tasks" below), [35] the `spawn scope`
// record it counts in (0: none, BG196), [36] its innermost open scope.
// [24] exists because two threads can requeue a task: its worker when it
// yields runnable, the poller/pool when its wait ends. A yielded task leaves
// with [24] = 0 and only its worker requeues it; a blocked task leaves with
// [24] = 1 or 3 and only the poller/pool does, marking it 2 so nobody else
// can. All transitions hold the registry lock, so a task is never on the run
// queue twice.
// A future of a task is its block with the tag 0x7FA5 in the top 16 bits.
//
// M:N: `pert_nworkers` OS worker threads each run a scheduler context that pops
// runnable tasks off its own lock-free ring (RT10), then the global queue
// (`pert_wq`, for tasks woken off a worker), then steals half of a sibling's
// ring, so tasks migrate across CPUs. A dedicated poller thread owns the fd-wait set (WSAPoll),
// timers and task-join wakeups; a small pool runs blocking calls so a task in
// a syscall never stalls its worker. Workers park on a condition variable when
// the queue is empty.

var pert_co_blocks: i64 = 0;  // registry of live tasks (for scans/joins)
var pert_co_count: i64 = 0;
var pert_co_cap: i64 = 0;
var pert_co_total: i64 = 0;

var pert_tls_cur: i64 = 0;  // TLS slot: current task on this thread
var pert_tls_sched: i64 = 0;  // TLS slot: this thread's scheduler context
var pert_tls_wid: i64 = 0;  // TLS slot: worker id + 1 (0 = not a worker)
var pert_lq: i64 = 0;  // per-worker rings: PE_LQ_REC bytes each (RT10)
var pert_dl_streak: i64 = 0;  // consecutive dead-looking poller cycles

var pert_wq: i64 = 0;  // [0] SRWLOCK [8] COND — guards head/tail/n
var pert_wq_head: i64 = 0;
var pert_wq_tail: i64 = 0;
var pert_wq_n: i64 = 0;  // tasks on the global queue

var pert_reg: i64 = 0;  // SRWLOCK guarding the task registry
var pert_done: i64 = 0;  // [0] lock [8] cond — broadcast on task finish
var pert_poll_cond: i64 = 0;  // [0] lock [8] cond — poller idle sleep
var pert_poolq: i64 = 0;  // [0] lock [8] cond — blocking-job queue
var pert_pool_head: i64 = 0;
var pert_pool_tail: i64 = 0;

var pert_live: i64 = 0;  // *i64 — unfinished task count
var pert_offq: i64 = 0;  // *i64 — tasks made but not yet queued or entered
var pert_idle: i64 = 0;  // *i64 — workers parked on wq
var pert_nworkers: i64 = 0;
var pert_started: i64 = 0;  // *i64 — CAS-guarded one-time init
var pert_co_deadlocked: i64 = 0;
var pert_parked: i64 = 0;  // *i64 — tasks parked on a channel, mutex or scope

// Wait registries (RT12). A task blocked on fd / join / pool sits in a
// FIFO intrusive list (head→tail = registration order, matching the old
// blocks-array scan order); one blocked on a deadline sits in pert_timers
// (binary min-heap). Pure sleepers are in neither wait nor work queues, so
// the poller's scans never walk them — a million sleeping tasks cost
// nothing. Both live under pert_reg; each block stores its links and heap
// index ([24] = in-list flag, [25] = heap slot, [26]/[27] = wait links).
var pert_wait_head: i64 = 0;
var pert_wait_tail: i64 = 0;
var pert_wait_n: i64 = 0;
var pert_timers: i64 = 0;  // min-heap entries of 16 bytes: [deadline][block]
var pert_timer_n: i64 = 0;
var pert_timer_cap: i64 = 0;

/// The task running on this thread, or 0 (worker scheduler / main / pool).
pub fn pe_co_cur() -> i64 {
    if pert_tls_cur == 0 {
        return 0;
    }
    return pe_k_tls_get(pert_tls_cur);
}

// ─── Run queues: one lock-free ring per worker + one global (RT10) ───
// Work pushed on a worker stays on its own ring (spawn locality). Each ring
// is a bounded Chase-Lev deque taken FIFO (as Go's runq and Tokio's local
// queue): only its worker pushes, at `bottom`, with plain stores and one
// fenced store that publishes the slot; its worker and the thieves take at
// `top` by compare-and-swap, so each slot is claimed once and no lock is
// taken. FIFO, not the owner-LIFO of the paper, so a task that yields goes
// behind the others on its ring instead of running again at once. A worker
// whose ring is dry takes the global queue's head and a share of the rest in
// one lock hold, then steals half of a sibling's ring in one CAS (Go's
// runqsteal: copy the slots, then claim them; a failed claim retries). A
// full ring moves half of itself to the global queue at once. The global
// queue (`pert_wq`'s lock) holds what threads that are not workers wake
// (the poller, the blocking pool, main); its condition variable parks idle
// workers. Indexes only grow (no ABA); a slot is `index & (PE_LQ_CAP - 1)`.
// A worker's record (PE_LQ_REC bytes, its words on separate cache lines):
// [0] top, [64] bottom, [128] the ring (PE_LQ_CAP words), [136] where its
// next steal starts.

const PE_LQ_CAP: i64 = 256;
const PE_LQ_REC: i64 = 192;

fn pe_lq_rec(wid: i64) -> i64 {
    return pert_lq + wid * PE_LQ_REC;
}

/// Tasks on worker wid's ring, a snapshot (thieves may change it at once).
fn pe_lq_size(wid: i64) -> i64 {
    var q: i64 = pe_lq_rec(wid);
    var t: i64 = nat_atomic_load(q);
    var b: i64 = nat_atomic_load(q + 64);
    if b > t {
        return b - t;
    }
    return 0;
}

/// Tasks on every worker's ring (the deadlock detector's snapshot).
fn pe_lq_total() -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < pert_nworkers {
        n = n + pe_lq_size(i);
        i = i + 1;
    }
    return n;
}

/// Worker wid's thread only: put t on its ring. False when the ring is full.
fn pe_lq_push(t: i64, wid: i64) -> bool {
    var q: i64 = pe_lq_rec(wid);
    var b: i64 = pe_load(q + 64);  // only this thread writes bottom
    if b - nat_atomic_load(q) >= PE_LQ_CAP {
        return false;
    }
    pe_store(pe_load(q + 128) + (b & (PE_LQ_CAP - 1)) * 8, t);
    if pert_nworkers == 1 {
        pe_store(q + 64, b + 1);  // no thief, nobody to wake
    } else {
        // xchg: the slot is visible before the index, and the caller's
        // read of pert_idle after it cannot pass it (no lost wake-up)
        nat_atomic_store(q + 64, b + 1);
    }
    return true;
}

/// Take the oldest task of worker wid's ring (its thread, or RL17's single
/// worker). 0 if the ring is empty.
fn pe_lq_pop(wid: i64) -> i64 {
    var q: i64 = pe_lq_rec(wid);
    var buf: i64 = pe_load(q + 128);
    while true {
        var t: i64 = nat_atomic_load(q);
        var b: i64 = nat_atomic_load(q + 64);
        if b - t <= 0 {
            return 0;
        }
        // Read the slot, then claim it: if the owner reused it meanwhile,
        // top moved and the claim fails
        var task: i64 = pe_load(buf + (t & (PE_LQ_CAP - 1)) * 8);
        if pert_nworkers == 1 {
            pe_store(q, t + 1);
            pe_store(task + 192, 0);
            return task;
        }
        if nat_atomic_cas(q, t, t + 1) == true {
            pe_store(task + 192, 0);
            return task;
        }
    }
    return 0;
}

/// Thief wid (its ring empty) takes half of worker v's ring, rounded up:
/// the slots are copied to its own ring's unpublished end, then claimed on
/// v's ring in one CAS. The last one is returned to run, the others are
/// published on the thief's ring. 0 if v's ring is empty.
fn pe_lq_steal_half(wid: i64, v: i64) -> i64 {
    var q: i64 = pe_lq_rec(v);
    var vbuf: i64 = pe_load(q + 128);
    var mine: i64 = pe_lq_rec(wid);
    var mbuf: i64 = pe_load(mine + 128);
    var mb: i64 = pe_load(mine + 64);
    var mask: i64 = PE_LQ_CAP - 1;
    while true {
        var t: i64 = nat_atomic_load(q);
        var b: i64 = nat_atomic_load(q + 64);
        var n: i64 = b - t;
        if n <= 0 {
            return 0;
        }
        n = n - n / 2;
        if n > PE_LQ_CAP / 2 {
            n = PE_LQ_CAP / 2;
        }
        var i: i64 = 0;
        while i < n {
            pe_store(mbuf + ((mb + i) & mask) * 8, pe_load(vbuf + ((t + i) & mask) * 8));
            i = i + 1;
        }
        if nat_atomic_cas(q, t, t + n) == true {
            var run: i64 = pe_load(mbuf + ((mb + n - 1) & mask) * 8);
            if n > 1 {
                nat_atomic_store(mine + 64, mb + n - 1);
            }
            pe_store(run + 192, 0);
            return run;
        }
    }
    return 0;
}

/// Worker wid's ring is dry: steal half of the first sibling's ring that has
/// work, starting one further each time so thieves spread over victims.
fn pe_lq_steal(wid: i64) -> i64 {
    var n: i64 = pert_nworkers;
    if n < 2 {
        return 0;
    }
    var mine: i64 = pe_lq_rec(wid);
    var start: i64 = pe_load(mine + 136);
    pe_store(mine + 136, start + 1);
    var i: i64 = 0;
    while i < n {
        var v: i64 = (wid + 1 + (start + i) % n) % n;
        if v != wid {
            var t: i64 = pe_lq_steal_half(wid, v);
            if t != 0 {
                return t;
            }
        }
        i = i + 1;
    }
    return 0;
}

// Append t to the global queue (wq lock held).
fn pe_gq_append_locked(t: i64) {
    pe_store(t + 176, 0);
    if pert_wq_tail != 0 {
        pe_store(pert_wq_tail + 176, t);
    } else {
        pert_wq_head = t;
    }
    pert_wq_tail = t;
    pert_wq_n = pert_wq_n + 1;
}

// Unlink the global queue's head (wq lock held). 0 if empty.
fn pe_gq_pop_locked() -> i64 {
    var t: i64 = pert_wq_head;
    if t == 0 {
        return 0;
    }
    pert_wq_head = pe_load(t + 176);
    if pert_wq_head == 0 {
        pert_wq_tail = 0;
    }
    pert_wq_n = pert_wq_n - 1;
    pe_store(t + 176, 0);
    return t;
}

/// Worker wid (its ring empty): the global queue's head to run, and its
/// share of the rest (one worker's part, at most half a ring) moved onto
/// its ring, so the lock is taken once per batch (wq lock held).
fn pe_gq_take_locked(wid: i64) -> i64 {
    var t: i64 = pe_gq_pop_locked();
    if t == 0 {
        return 0;
    }
    pe_store(t + 192, 0);
    var k: i64 = pert_wq_n / pert_nworkers;
    if k > PE_LQ_CAP / 2 {
        k = PE_LQ_CAP / 2;
    }
    while k > 0 {
        var u: i64 = pe_gq_pop_locked();
        if u == 0 {
            k = 0;
        } else if pe_lq_push(u, wid) {
            k = k - 1;
        } else {
            // ring full after all: back at the head
            pe_store(u + 176, pert_wq_head);
            if pert_wq_head == 0 {
                pert_wq_tail = u;
            }
            pert_wq_head = u;
            pert_wq_n = pert_wq_n + 1;
            k = 0;
        }
    }
    return t;
}

/// Worker wid's ring is full: move its older half and t to the global queue
/// in one lock hold (a spawning loop takes the lock once per half ring).
/// The half is claimed before it is read: only this thread writes its slots.
fn pe_lq_spill(t: i64, wid: i64) {
    var q: i64 = pe_lq_rec(wid);
    var buf: i64 = pe_load(q + 128);
    var b: i64 = pe_load(q + 64);
    var top: i64 = nat_atomic_load(q);
    var half: i64 = (b - top) / 2;
    var claimed: bool = half <= 0;
    while !claimed {
        if nat_atomic_cas(q, top, top + half) == true {
            claimed = true;
        } else {
            top = nat_atomic_load(q);
            half = (b - top) / 2;
            if half <= 0 {
                half = 0;
                claimed = true;
            }
        }
    }
    pe_k_lock(pert_wq);
    var i: i64 = 0;
    while i < half {
        pe_gq_append_locked(pe_load(buf + ((top + i) & (PE_LQ_CAP - 1)) * 8));
        i = i + 1;
    }
    pe_gq_append_locked(t);
    pe_k_cond_signal(pert_wq + 8);
    pe_k_unlock(pert_wq);
}

/// Wake one parked worker.
fn pe_wq_signal() {
    pe_k_lock(pert_wq);
    pe_k_cond_signal(pert_wq + 8);
    pe_k_unlock(pert_wq);
}

fn pe_wq_push(t: i64) {
    var wid: i64 = 0;
    if pert_tls_wid != 0 {
        wid = pe_k_tls_get(pert_tls_wid);
    }
    if wid != 0 {
        if !pe_lq_push(t, wid - 1) {
            pe_lq_spill(t, wid - 1);
        } else if nat_atomic_load(pert_idle) > 0 {
            pe_wq_signal();
        }
        return;
    }
    pe_k_lock(pert_wq);
    pe_gq_append_locked(t);
    pe_k_cond_signal(pert_wq + 8);
    pe_k_unlock(pert_wq);
}

/// Requeue a task that yielded on worker `wid` (0-based): its own ring, which
/// the worker pops next. Another worker is woken only for a backlog: waking
/// one per yield made every yield an OS thread switch.
fn pe_wq_push_yielded(t: i64, wid: i64) {
    var backlog: bool = pe_lq_size(wid) != 0 || pert_wq_head != 0;
    if !pe_lq_push(t, wid) {
        pe_lq_spill(t, wid);
    } else if backlog && nat_atomic_load(pert_idle) > 0 {
        pe_wq_signal();
    }
}

/// RL17: take a random one of the tasks on worker wid's queue and the
/// global queue (wq lock held). 0 if both are empty.
fn pe_rnd_take_locked(wid: i64) -> i64 {
    // RL17 runs one worker: no thief touches its ring
    var q: i64 = pe_lq_rec(wid);
    var buf: i64 = pe_load(q + 128);
    var top: i64 = pe_load(q);
    var nl: i64 = pe_load(q + 64) - top;
    var ng: i64 = pert_wq_n;
    if nl + ng == 0 {
        return 0;
    }
    var k: i64 = pe_rnd_below(nl + ng);
    var prev: i64 = 0;
    var cur: i64 = 0;
    var i: i64 = 0;
    if k < nl {
        // the k-th to the top, the ones before it one place down (their
        // order kept), then take the top
        var mask: i64 = PE_LQ_CAP - 1;
        cur = pe_load(buf + ((top + k) & mask) * 8);
        var j: i64 = k;
        while j > 0 {
            pe_store(buf + ((top + j) & mask) * 8, pe_load(buf + ((top + j - 1) & mask) * 8));
            j = j - 1;
        }
        pe_store(buf + (top & mask) * 8, cur);
        nat_atomic_store(q, top + 1);
    } else {
        cur = pert_wq_head;
        while i < k - nl {
            prev = cur;
            cur = pe_load(cur + 176);
            i = i + 1;
        }
        var nx2: i64 = pe_load(cur + 176);
        if prev == 0 {
            pert_wq_head = nx2;
        } else {
            pe_store(prev + 176, nx2);
        }
        if nx2 == 0 {
            pert_wq_tail = prev;
        }
        pert_wq_n = pert_wq_n - 1;
    }
    pe_store(cur + 176, 0);
    pe_store(cur + 192, 0);
    return cur;
}

/// Worker wid's next task: its ring, then the global queue, then half of a
/// sibling's ring; parked on the global queue's condition variable while
/// all are empty. A worker counts itself idle before it looks a last time
/// (the count's lock xadd is a barrier): a push publishes its slot before it
/// reads the count, so either the pusher sees the idle worker and wakes it
/// or the worker sees the task.
fn pe_wq_pop(wid: i64) -> i64 {
    while true {
        if pert_rnd_on == 1 {
            pe_k_lock(pert_wq);
            var rt: i64 = pe_rnd_take_locked(wid);
            pe_k_unlock(pert_wq);
            if rt != 0 {
                return rt;
            }
        }
        var t: i64 = pe_lq_pop(wid);
        if t != 0 {
            return t;
        }
        if pert_wq_head != 0 {
            pe_k_lock(pert_wq);
            t = pe_gq_take_locked(wid);
            pe_k_unlock(pert_wq);
            if t != 0 {
                return t;
            }
        }
        t = pe_lq_steal(wid);
        if t != 0 {
            return t;
        }
        pe_k_lock(pert_wq);
        nat_atomic_add(pert_idle, 1);
        if pert_wq_head == 0 && pe_lq_total() == 0 {
            pe_k_cond_wait(pert_wq + 8, pert_wq, pe_infinite(), 0);
        }
        nat_atomic_add(pert_idle, 0 - 1);
        pe_k_unlock(pert_wq);
    }
    return 0;
}

// ─── Token slot (complaint CA7, CA8) ──────────────────────
// A timeout block's token (compiler/lower.fd Lowerer_to_enter) is three
// words: [cancelled][deadline on pert_clock_mono_ms's clock, 0 none][the
// token the slot held before]. The slot is word [30] of the running task's
// block, else a TLS slot of the thread (pert_tls_tok, made the first time
// code outside tasks sets one): a new task starts with an empty one. The
// builtin waits (sleep, await, channel send and receive, socket waits) look
// at the slot's token, and at the ones it replaced, at least every 10 ms
// (an await or a channel, every millisecond) and give up once one is
// cancelled or past its deadline, as the C runtime's do. With an empty
// slot they wait as before.

var pert_tls_tok: i64 = 0;  // TLS slot + 1: the token outside tasks

/// The TLS slot of the token of code outside tasks (made once).
fn pe_tok_key() -> i64 {
    if pert_tls_tok == 0 {
        var init_lock: i64 = pe_k_create_mutex(0, 0, "fid_co_tok_init");
        if init_lock != 0 {
            pe_k_wait(init_lock, pe_infinite());
        }
        if pert_tls_tok == 0 {
            var k: i64 = pe_k_tls_alloc() as i64;
            pert_tls_tok = k + 1;
        }
        if init_lock != 0 {
            pe_k_release_mutex(init_lock);
            pe_k_close_handle(init_lock);
        }
    }
    return pert_tls_tok - 1;
}

/// The token in the running task's slot (p_task_token), 0 if none.
pub fn pert_task_token() -> i64 {
    var c: i64 = pe_co_cur();
    if c != 0 {
        return pe_load(c + 240);
    }
    if pert_tls_tok == 0 {
        return 0;
    }
    return pe_k_tls_get(pert_tls_tok - 1);
}

/// Put `tok` in the slot (p_task_set_token); the token it held.
pub fn pert_task_set_token(tok: i64) -> i64 {
    var c: i64 = pe_co_cur();
    if c != 0 {
        var old: i64 = pe_load(c + 240);
        pe_store(c + 240, tok);
        return old;
    }
    var key: i64 = pe_tok_key();
    var old2: i64 = pe_k_tls_get(key);
    pe_k_tls_set(key, tok);
    return old2;
}

/// C6: milliseconds since the system started (GetTickCount64), the clock
/// of deadlines (timeout blocks, tokens): a change of the wall clock does
/// not move it.
pub fn pert_clock_mono_ms() -> i64 {
    return pe_k_ticks();
}

/// Whether `tok`, or a token it replaced, is cancelled or past its
/// deadline (a token past its deadline is marked cancelled).
fn pe_tok_cancelled(tok: i64) -> bool {
    var t: i64 = tok;
    var depth: i64 = 0;
    var now: i64 = 0;
    while t != 0 && depth < 64 {
        if nat_atomic_load(t) != 0 {
            return true;
        }
        var dl: i64 = nat_atomic_load(t + 8);
        if dl != 0 {
            if now == 0 {
                now = pert_clock_mono_ms();
            }
            if now >= dl {
                nat_atomic_store(t, 1);
                return true;
            }
        }
        t = nat_atomic_load(t + 16);
        depth = depth + 1;
    }
    return false;
}

/// The next slice of a wait of `left` ms (-1: no limit) under `tok`: 10
/// ms at most, and no later than the first deadline of its chain.
fn pe_tok_slice(tok: i64, left: i64) -> i64 {
    var s: i64 = 10;
    if left >= 0 && left < s {
        s = left;
    }
    var now: i64 = pert_clock_mono_ms();
    var t: i64 = tok;
    var depth: i64 = 0;
    while t != 0 && depth < 64 {
        var dl: i64 = nat_atomic_load(t + 8);
        if dl != 0 {
            var r: i64 = 0;
            if dl > now {
                r = dl - now;
            }
            if r < s {
                s = r;
            }
        }
        t = nat_atomic_load(t + 16);
        depth = depth + 1;
    }
    return s;
}

// ─── Task chain of a panic (complaint CA9) ────────────────
// A panic's trace shows only the running task's own stack. pert_task_chain
// (called by pe_ir's p_panic stub, compiler/pe_ir_stubs.fd, after the
// message) prints the tasks it runs for, as the C runtime's
// __p_co_print_chain: the one awaiting it ([33]), else the one whose turn it
// runs in ([15]; both are alive while they wait), up to the code outside
// tasks (`main`), or to the task that started it and has not awaited it
// (`(started by f)`):
//     task chain: b <- a <- main

var pe_tc_cell: i64 = 0;  // WriteFile's count for the chain's lines

/// A task's name to stderr, without the `__task` of an adapted task
/// function.
fn pe_tc_name(h: i64, name: i64) {
    if name == 0 {
        return;
    }
    var n: i64 = pe_c_strlen(name);
    if n > 6 {
        var e: i64 = n - 6;
        if pe_byte_at(name, e) == 95 && pe_byte_at(name, e + 1) == 95 && pe_byte_at(name, e + 2) == 116 && pe_byte_at(name, e + 3) == 97 && pe_byte_at(name, e + 4) == 115 && pe_byte_at(name, e + 5) == 107 {
            n = e;
        }
    }
    pe_cr_put(h, pe_tc_cell, name, n);
}

/// `task chain: ...` on stderr when a task is running; nothing otherwise.
pub fn pert_task_chain() {
    var c: i64 = pe_co_cur();
    if c == 0 {
        return;
    }
    if pe_tc_cell == 0 {
        pe_tc_cell = pe_zeroed(1);
    }
    var h: i64 = pe_k_std_handle(0 - 12);
    pe_cr_puts(h, pe_tc_cell, "task chain: " as i64);
    var depth: i64 = 0;
    var more: bool = true;
    while more {
        pe_tc_name(h, pe_load(c + 248));
        var next: i64 = pe_load(c + 264);
        if next == 0 {
            next = pe_load(c + 120);
        }
        if next != 0 && depth < 64 {
            pe_cr_puts(h, pe_tc_cell, " <- " as i64);
            c = next;
            depth = depth + 1;
        } else {
            var starter: i64 = pe_load(c + 256);
            if next != 0 {
                pe_cr_puts(h, pe_tc_cell, " <- ..." as i64);
            } else if starter != 0 {
                pe_cr_puts(h, pe_tc_cell, " (started by " as i64);
                pe_tc_name(h, starter);
                pe_cr_puts(h, pe_tc_cell, ")" as i64);
            } else {
                pe_cr_puts(h, pe_tc_cell, " <- main" as i64);
            }
            more = false;
        }
    }
    pe_cr_puts(h, pe_tc_cell, "\n" as i64);
}

// ─── Task lifecycle ────────────────────────────────────────
fn pe_co_new(name: str, nargs: i64, argv: i64) -> i64 {
    var block: i64 = pe_co_new_block(name, nargs, argv);
    pe_wq_push(block);
    nat_atomic_add(pert_offq, 0 - 1);
    return block;
}

/// Create + register a task without queueing it: for p_co_async, whose task
/// is entered immediately and only queued if it yields mid-run.
fn pe_co_new_block(name: str, nargs: i64, argv: i64) -> i64 {
    var fn_addr: i64 = pe_fn_lookup(name);
    if fn_addr == 0 {
        p_panic("task: no such function");
    }
    pe_co_ensure();
    var block: i64 = pe_zeroed(37);
    pe_store(block, fn_addr);
    pe_store(block + 8, nargs);
    // CA9: its name and the task that started it, for a panic's task chain
    pe_store(block + 248, name as i64);
    var starter: i64 = pe_co_cur();
    if starter != 0 {
        pe_store(block + 256, pe_load(starter + 248));
    }
    // BG196: started inside an open `spawn scope` of its starter: the
    // scope's end waits for it (counted before it can run, or finish)
    var scope: i64 = pe_scope_cur();
    if scope != 0 {
        nat_atomic_add(scope, 1);
        pe_store(block + 280, scope);
    }
    var a: i64 = 0;
    while a < nargs && a < 8 {
        pe_store(block + 16 + a * 8, pe_load(argv + a * 8));
        a = a + 1;
    }
    pe_store(block + 96, 1);
    pe_store(block + 128, -1);
    // +192 in-wait-list flag and +208/+216 links stay 0 until registered
    pe_store(block + 200, 0 - 1);  // timer-heap slot
    var ctx: i64 = pe_ctx_new(pe_thread_entry_addr(), block);
    if ctx == 0 {
        p_panic("task: out of memory");
    }
    pe_store(block + 104, ctx);
    pe_k_lock(pert_reg);
    if pert_co_count == pert_co_cap {
        var cap: i64 = pert_co_cap * 2;
        if cap == 0 {
            cap = 64;
        }
        var blocks: i64 = pe_zeroed(cap);
        var i: i64 = 0;
        while i < pert_co_count {
            pe_store(blocks + i * 8, pe_load(pert_co_blocks + i * 8));
            i = i + 1;
        }
        if pert_co_blocks != 0 {
            p_free(pert_co_blocks);
        }
        pert_co_blocks = blocks;
        pert_co_cap = cap;
    }
    pe_store(pert_co_blocks + pert_co_count * 8, block);
    pe_store(block + 232, pert_co_count);
    pert_co_count = pert_co_count + 1;
    pert_co_total = pert_co_total + 1;
    pe_k_unlock(pert_reg);
    // Live but on no queue until its creator queues or enters it: the
    // deadlock detector must not count it as stuck (RT10)
    nat_atomic_add(pert_offq, 1);
    nat_atomic_add(pert_live, 1);
    return block;
}

/// One-time scheduler bring-up: locks, TLS slots, worker threads (one per
/// logical CPU), the fd/timer poller, and the blocking-pool threads.
/// First call is usually the main thread before any task exists; a named
/// mutex serializes the rare race of two threads first-spawning at once.
fn pe_co_ensure() {
    if pert_started != 0 {
        return;
    }
    var init_lock: i64 = pe_k_create_mutex(0, 0, "fid_co_sched_init");
    if init_lock != 0 {
        pe_k_wait(init_lock, pe_infinite());
    }
    if pert_started != 0 {
        if init_lock != 0 {
            pe_k_release_mutex(init_lock);
            pe_k_close_handle(init_lock);
        }
        return;
    }
    pert_tls_cur = pe_k_tls_alloc();
    pert_tls_sched = pe_k_tls_alloc();
    pert_tls_wid = pe_k_tls_alloc();
    pert_stk_lock = pe_zeroed(1);
    pe_k_lock_init(pert_stk_lock);
    pert_stk_free = pe_zeroed(256);
    pe_afd_init();
    pert_wq = pe_zeroed(2);
    pe_k_lock_init(pert_wq);
    pe_k_cond_init(pert_wq + 8);
    pert_reg = pe_zeroed(1);
    pe_k_lock_init(pert_reg);
    pert_done = pe_zeroed(2);
    pe_k_lock_init(pert_done);
    pe_k_cond_init(pert_done + 8);
    pert_poll_cond = pe_zeroed(2);
    pe_k_lock_init(pert_poll_cond);
    pe_k_cond_init(pert_poll_cond + 8);
    pert_poolq = pe_zeroed(2);
    pe_k_lock_init(pert_poolq);
    pe_k_cond_init(pert_poolq + 8);
    pert_live = pe_zeroed(1);
    pert_offq = pe_zeroed(1);
    pert_idle = pe_zeroed(1);
    pert_parked = pe_zeroed(1);

    // Logical CPU count: SYSTEM_INFO.dwNumberOfProcessors at offset 32.
    var info: i64 = pe_zeroed(6);
    pe_k_sysinfo(info);
    var n: i64 = (pe_load(info + 32) & 4294967295);
    p_free(info);
    if n < 1 {
        n = 1;
    }
    if n > 16 {
        n = 16;
    }
    // FIDES_WORKERS=<n> (1-16): that many workers instead of one per CPU,
    // for benchmarks of the switch itself (tests/ctx_switch) and for
    // programs that want fewer threads
    var wenv: i64 = pe_c_getenv("FIDES_WORKERS") as i64;
    if wenv != 0 {
        var wn: i64 = 0;
        var wi: i64 = 0;
        var wb: i64 = pe_rnd_byte(wenv);
        while wb >= 48 && wb <= 57 && wi < 3 {
            wn = wn * 10 + (wb - 48);
            wi = wi + 1;
            wb = pe_rnd_byte(wenv + wi);
        }
        if wn >= 1 && wn <= 16 {
            n = wn;
        }
    }
    // RL17: one worker, so the order tasks run in is the seed's choice
    if pe_rnd_enabled() {
        n = 1;
    }
    pert_nworkers = n;
    pert_lq = pe_zeroed(n * (PE_LQ_REC / 8));
    var ri: i64 = 0;
    while ri < n {
        pe_store(pe_lq_rec(ri) + 128, pe_zeroed(PE_LQ_CAP));
        ri = ri + 1;
    }

    var wid: i64 = 0;
    while wid < n {
        var wblock: i64 = pe_zeroed(14);
        pe_store(wblock, pe_fn_lookup("pert_worker_main"));
        pe_store(wblock + 8, 1);
        pe_store(wblock + 16, wid);
        pe_k_create_thread(0, 0, pe_thread_entry_addr(), wblock, 0, 0);
        wid = wid + 1;
    }
    var pblock: i64 = pe_zeroed(14);
    pe_store(pblock, pe_fn_lookup("pert_poller_main"));
    pe_store(pblock + 8, 1);
    pe_store(pblock + 16, 0);
    pe_k_create_thread(0, 0, pe_thread_entry_addr(), pblock, 0, 0);
    var pool_n: i64 = 0;
    while pool_n < 2 {
        var jblock: i64 = pe_zeroed(14);
        pe_store(jblock, pe_fn_lookup("pert_pool_main"));
        pe_store(jblock + 8, 1);
        pe_store(jblock + 16, pool_n);
        pe_k_create_thread(0, 0, pe_thread_entry_addr(), jblock, 0, 0);
        pool_n = pool_n + 1;
    }
    pert_started = 1;
    if init_lock != 0 {
        pe_k_release_mutex(init_lock);
        pe_k_close_handle(init_lock);
    }
}

/// The running task gives up control, blocked (or finished): back to the
/// task that entered it ([15], the async-chain parent), else to its worker's
/// scheduler context.
fn pe_co_leave() {
    pe_co_leave_as(0);
}

/// Leave, telling the context resumed whether this task is still runnable
fn pe_co_leave_as(runnable: i64) {
    var c: i64 = pe_co_cur();
    if c == 0 {
        return;
    }
    var back: i64 = pe_load(c + 120);
    pe_store(c + 120, 0);
    var to: i64 = pe_load(c + 168);
    if back != 0 {
        pe_k_tls_set(pert_tls_cur, back);
        to = pe_load(back + 104);
    } else {
        pe_k_tls_set(pert_tls_cur, 0);
        // a scheduler context (pe_ctx_thread, five words): who left
        pe_store(to + 32, c);
    }
    pe_store(to + 24, runnable);
    pe_ctx_switch(pe_load(c + 104), to);
}

/// Enter `block` on this thread: the caller's scheduler context becomes its
/// yield target, the caller (task or not) its return target. Restores the
/// caller's task context on the way back — a task can enter another task.
/// Returns 1 if `block` left still runnable (it yielded), else 0.
fn pe_co_enter(block: i64) -> i64 {
    var sched: i64 = pe_k_tls_get(pert_tls_sched);
    if sched == 0 {
        sched = pe_ctx_thread();
        pe_k_tls_set(pert_tls_sched, sched);
    }
    var prev: i64 = pe_k_tls_get(pert_tls_cur);
    pe_ctx_claim(pe_load(block + 104));
    pe_store(block + 168, sched);
    pe_store(block + 120, prev);
    pe_k_tls_set(pert_tls_cur, block);
    // The running context: the task that enters, else the thread's own
    var from: i64 = sched;
    if prev != 0 {
        from = pe_load(prev + 104);
    }
    pe_ctx_resume(from, pe_load(block + 104));
    pe_k_tls_set(pert_tls_cur, prev);
    return pe_load(from + 24);
}

// ─── Parked tasks (BG194, BG195, BG196) ──────────────────
// A task that must wait for a channel, a mutex or the end of a scope does
// not sleep its OS thread (a worker, or the thread an `async fn` started on,
// would stop running every other task): it joins a FIFO list of the object,
// [0] head and [8] tail linked through each block's [34], under the object's
// lock, lets the lock go and leaves blocked. A change takes tasks off the
// list under the same lock and queues them, so none is missed; a task queued
// before it has finished leaving is resumed only once it has (pe_ctx_claim).
// A woken task looks again, and parks again if it still has to wait.

/// Park the running task `cur` on list `lst` of the object whose SRW lock
/// `lock` is held; the lock is held again on return.
fn pe_park(cur: i64, lock: i64, lst: i64) {
    pe_store(cur + 272, 0);
    var tail: i64 = pe_load(lst + 8);
    if tail != 0 {
        pe_store(tail + 272, cur);
    } else {
        pe_store(lst, cur);
    }
    pe_store(lst + 8, cur);
    nat_atomic_add(pert_parked, 1);
    pe_k_unlock(lock);
    pe_co_leave();
    nat_atomic_add(pert_parked, 0 - 1);
    pe_k_lock(lock);
}

/// Queue the first task of list `lst` (its object's lock held), if any.
fn pe_park_wake_one(lst: i64) {
    var t: i64 = pe_load(lst);
    if t != 0 {
        var nx: i64 = pe_load(t + 272);
        pe_store(lst, nx);
        if nx == 0 {
            pe_store(lst + 8, 0);
        }
        pe_store(t + 272, 0);
        pe_wq_push(t);
    }
}

/// Queue every task of list `lst` (its object's lock held).
fn pe_park_wake_all(lst: i64) {
    var t: i64 = pe_load(lst);
    pe_store(lst, 0);
    pe_store(lst + 8, 0);
    while t != 0 {
        // (read before the push: the task can run, and park again, at once)
        var nx: i64 = pe_load(t + 272);
        pe_store(t + 272, 0);
        pe_wq_push(t);
        t = nx;
    }
}

// ─── The tasks of a `spawn scope` (BG196) ────────────────
// p_executor_new opens a scope record on the running context (a task's
// [36], else a TLS slot of the thread): [0] how many tasks started inside
// it are unfinished, [8] the scope it was opened in, [16] the tasks waiting
// for its end (a parked list), [32] the executor (to close the right one).
// A task started while a scope is open counts in it ([35]); the scope's end
// (p_executor_run_all) waits for those only, as the C runtime's
// __p_ft_scan joins only the scope's threads: not for tasks started before
// it or elsewhere, nor for the task the scope is in.

var pert_tls_scope: i64 = 0;  // TLS slot + 1: the open scope outside tasks

fn pe_scope_key() -> i64 {
    if pert_tls_scope == 0 {
        var init_lock: i64 = pe_k_create_mutex(0, 0, "fid_co_scope_init");
        if init_lock != 0 {
            pe_k_wait(init_lock, pe_infinite());
        }
        if pert_tls_scope == 0 {
            var k: i64 = pe_k_tls_alloc() as i64;
            pert_tls_scope = k + 1;
        }
        if init_lock != 0 {
            pe_k_release_mutex(init_lock);
            pe_k_close_handle(init_lock);
        }
    }
    return pert_tls_scope - 1;
}

/// The innermost open scope of the running context, 0 if none.
fn pe_scope_cur() -> i64 {
    var c: i64 = pe_co_cur();
    if c != 0 {
        return pe_load(c + 288);
    }
    if pert_tls_scope == 0 {
        return 0;
    }
    return pe_k_tls_get(pert_tls_scope - 1);
}

fn pe_scope_set(rec: i64) {
    var c: i64 = pe_co_cur();
    if c != 0 {
        pe_store(c + 288, rec);
    } else {
        pe_k_tls_set(pe_scope_key(), rec);
    }
}

/// Open a scope for executor `exec` on the running context.
fn pe_scope_open(exec: i64) {
    var rec: i64 = pe_zeroed(5);
    pe_store(rec + 8, pe_scope_cur());
    pe_store(rec + 32, exec);
    pe_scope_set(rec);
}

/// Close the innermost open scope of executor `exec`: wait until the tasks
/// started inside it have finished (a task waits parked); how many there
/// were still running. 0 when the running context has no such scope.
fn pe_scope_close(exec: i64) -> i64 {
    var prev: i64 = 0;
    var rec: i64 = pe_scope_cur();
    while rec != 0 && pe_load(rec + 32) != exec {
        prev = rec;
        rec = pe_load(rec + 8);
    }
    if rec == 0 {
        return 0;
    }
    if prev == 0 {
        pe_scope_set(pe_load(rec + 8));
    } else {
        pe_store(prev + 8, pe_load(rec + 8));
    }
    var running: i64 = nat_atomic_load(rec);
    if running > 0 {
        var cur: i64 = pe_co_cur();
        pe_k_lock(pert_done);
        while nat_atomic_load(rec) > 0 {
            if cur != 0 {
                pe_park(cur, pert_done, rec + 16);
            } else {
                pe_k_cond_wait(pert_done + 8, pert_done, 50, 0);
            }
        }
        pe_k_unlock(pert_done);
    }
    p_free(rec);
    return running;
}

// ─── Wait registry: tasks blocked on fd / join / pool ─────
// Timer-only tasks live in pert_timers instead and never appear here.
// Everything below runs under pert_reg.

/// Add `block` to the wait registry (idempotent).
fn pe_wait_add(block: i64) {
    if pe_load(block + 192) == 0 {
        pe_store(block + 192, 1);
        pe_store(block + 208, 0);
        pe_store(block + 216, pert_wait_tail);
        if pert_wait_tail != 0 {
            pe_store(pert_wait_tail + 208, block);
        } else {
            pert_wait_head = block;
        }
        pert_wait_tail = block;
        pert_wait_n = pert_wait_n + 1;
    }
}

/// Unlink `block` from the wait list if registered. Only state 1 is linked —
/// timer-blocked tasks (3) and wake-queued ones (2) are not on this list.
fn pe_wait_remove(block: i64) {
    if pe_load(block + 192) == 1 {
        var nx: i64 = pe_load(block + 208);
        var pv: i64 = pe_load(block + 216);
        if pv != 0 {
            pe_store(pv + 208, nx);
        } else {
            pert_wait_head = nx;
        }
        if nx != 0 {
            pe_store(nx + 216, pv);
        } else {
            pert_wait_tail = pv;
        }
        pe_store(block + 192, 0);
        pe_store(block + 208, 0);
        pe_store(block + 216, 0);
        pert_wait_n = pert_wait_n - 1;
    }
}

// ─── Timer heap: binary min-heap of (deadline, block) ─────
// Entry size is 16 bytes. +200 in each block is its heap slot, so expiry,
// disarm and finish all remove in O(log n).

/// Move entry `i` up while it precedes its parent.
fn pe_timer_sift_up(idx: i64) {
    var i: i64 = idx;
    while i > 0 {
        var p: i64 = (i - 1) / 2;
        var di: i64 = pe_load(pert_timers + i * 16);
        var dp: i64 = pe_load(pert_timers + p * 16);
        if di < dp {
            var bi: i64 = pe_load(pert_timers + i * 16 + 8);
            var bp: i64 = pe_load(pert_timers + p * 16 + 8);
            pe_store(pert_timers + i * 16, dp);
            pe_store(pert_timers + i * 16 + 8, bp);
            pe_store(pert_timers + p * 16, di);
            pe_store(pert_timers + p * 16 + 8, bi);
            pe_store(bi + 200, p);
            pe_store(bp + 200, i);
            i = p;
        } else {
            i = 0;
        }
    }
}

/// Move entry `i` down while a child precedes it.
fn pe_timer_sift_down(idx: i64) {
    var i: i64 = idx;
    var done: bool = false;
    while done == false {
        var l: i64 = i * 2 + 1;
        var r: i64 = l + 1;
        var s: i64 = i;
        if l < pert_timer_n && pe_load(pert_timers + l * 16) < pe_load(pert_timers + s * 16) {
            s = l;
        }
        if r < pert_timer_n && pe_load(pert_timers + r * 16) < pe_load(pert_timers + s * 16) {
            s = r;
        }
        if s == i {
            done = true;
        } else {
            var di: i64 = pe_load(pert_timers + i * 16);
            var bi: i64 = pe_load(pert_timers + i * 16 + 8);
            var ds: i64 = pe_load(pert_timers + s * 16);
            var bs: i64 = pe_load(pert_timers + s * 16 + 8);
            pe_store(pert_timers + i * 16, ds);
            pe_store(pert_timers + i * 16 + 8, bs);
            pe_store(pert_timers + s * 16, di);
            pe_store(pert_timers + s * 16 + 8, bi);
            pe_store(bs + 200, i);
            pe_store(bi + 200, s);
            i = s;
        }
    }
}

/// Swap entry `idx` with the last, shrink, then restore heap order.
fn pe_timer_remove_at(idx: i64) {
    var last: i64 = pert_timer_n - 1;
    if idx != last {
        var dl: i64 = pe_load(pert_timers + last * 16);
        var b: i64 = pe_load(pert_timers + last * 16 + 8);
        pe_store(pert_timers + idx * 16, dl);
        pe_store(pert_timers + idx * 16 + 8, b);
        pe_store(b + 200, idx);
    }
    pert_timer_n = last;
    if idx < pert_timer_n {
        if idx > 0 && pe_load(pert_timers + idx * 16) < pe_load(pert_timers + ((idx - 1) / 2) * 16) {
            pe_timer_sift_up(idx);
        } else {
            pe_timer_sift_down(idx);
        }
    }
}

fn pe_timer_grow() {
    var cap: i64 = pert_timer_cap * 2;
    if cap == 0 {
        cap = 64;
    }
    var arr: i64 = pe_zeroed(cap * 2);
    var i: i64 = 0;
    while i < pert_timer_n * 2 {
        pe_store(arr + i * 8, pe_load(pert_timers + i * 8));
        i = i + 1;
    }
    if pert_timers != 0 {
        p_free(pert_timers);
    }
    pert_timers = arr;
    pert_timer_cap = cap;
}

/// Remove `block`'s timer entry if armed.
fn pe_timer_disarm(block: i64) {
    var idx: i64 = pe_load(block + 200);
    if idx >= 0 {
        pe_store(block + 200, 0 - 1);
        pe_timer_remove_at(idx);
    }
}

/// Arm a deadline for `block`; one timer per task, so re-arming replaces.
fn pe_timer_push(dl: i64, block: i64) {
    pe_timer_disarm(block);
    if pert_timer_n == pert_timer_cap {
        pe_timer_grow();
    }
    var idx: i64 = pert_timer_n;
    pert_timer_n = pert_timer_n + 1;
    pe_store(pert_timers + idx * 16, dl);
    pe_store(pert_timers + idx * 16 + 8, block);
    pe_store(block + 200, idx);
    pe_timer_sift_up(idx);
}

/// The soonest armed deadline, or 0 when the heap is empty.
fn pe_timer_peek() -> i64 {
    if pert_timer_n == 0 {
        return 0;
    }
    return pe_load(pert_timers);
}

/// Pop the soonest timer's block.
fn pe_timer_pop() -> i64 {
    var block: i64 = pe_load(pert_timers + 8);
    pe_store(block + 200, 0 - 1);
    pe_timer_remove_at(0);
    return block;
}

/// Task finished: free its context, count down, wake joiners/task_run.
fn pe_co_finish_task(block: i64) {
    pe_k_lock(pert_reg);
    pe_wait_remove(block);
    pe_timer_disarm(block);
    // Its registry slot is in [29] (RT10: a scan per finished task made
    // tasks finishing out of spawn order quadratic, 70 us a task at 200,000)
    var found: i64 = pe_load(block + 232);
    if found >= 0 && found < pert_co_count && pe_load(pert_co_blocks + found * 8) == block {
        var last: i64 = pe_load(pert_co_blocks + (pert_co_count - 1) * 8);
        pe_store(pert_co_blocks + found * 8, last);
        pe_store(last + 232, found);
        pert_co_count = pert_co_count - 1;
        pe_store(block + 232, 0 - 1);
    }
    pe_k_unlock(pert_reg);
    pe_ctx_free(pe_load(block + 104));
    var scope: i64 = pe_load(block + 280);
    pe_k_lock(pert_done);
    nat_atomic_add(pert_live, 0 - 1);
    // BG196: the last task of a scope wakes the task waiting for its end
    if scope != 0 && nat_atomic_add(scope, 0 - 1) == 1 {
        pe_park_wake_all(scope + 16);
    }
    pe_k_cond_broadcast(pert_done + 8);
    pe_k_unlock(pert_done);
    if pe_load(block + 160) != 0 {
        p_free(block);
    }
}

/// Worker OS thread: scheduler context + pop-run loop forever.
pub fn pert_worker_main(id: i64) -> i64 {
    var sched: i64 = pe_ctx_thread();
    pe_store(sched + 40, id + 1);
    pe_k_tls_set(pert_tls_sched, sched);
    pe_k_tls_set(pert_tls_wid, id + 1);
    while true {
        var t: i64 = pe_wq_pop(id);
        pe_ctx_claim(pe_load(t + 104));
        pe_store(t + 168, sched);
        pe_k_tls_set(pert_tls_cur, t);
        pe_ctx_resume(sched, pe_load(t + 104));
        pe_k_tls_set(pert_tls_cur, 0);
        // The task that left: t, or one t's yields handed the worker to.
        // BG227: how it left is the word it wrote here (2 finished, 1
        // runnable, 0 blocked), not its block: a blocked task may already
        // run, or have finished, on another worker
        t = pe_load(sched + 32);
        var why: i64 = pe_load(sched + 24);
        if why == 2 {
            pe_co_finish_task(t);
        } else if why != 0 {
            // It yielded: requeue it. A blocked one is the poller/pool's to
            // wake, and may already be running again on another worker.
            pe_wq_push_yielded(t, id);
        }
    }
    return 0;
}

/// Poller OS thread: the only WSAPoll caller. Each cycle it rebuilds the
/// wait set from the registry, polls with a deadline-bounded timeout, then
/// wakes: fd-ready tasks, expired sleepers/timeouts, and joiners whose
/// awaited task finished. It also owns deadlock detection.
pub fn pert_poller_main(id: i64) -> i64 {
    var fds: i64 = 0;
    var map: i64 = 0;
    var cap: i64 = 0;
    while true {
        var n: i64 = 0;
        var first: i64 = 0;
        var now: i64 = pe_k_ticks();
        var waiters: i64 = 0;

        pe_k_lock(pert_reg);
        if pert_wait_n > cap {
            if fds != 0 {
                p_free(fds);
                p_free(map);
            }
            cap = pert_wait_n * 2;
            fds = pe_zeroed(cap * 2);
            map = pe_zeroed(cap);
        }
        // Scan only tasks blocked on fd / join / pool — timer-only tasks
        // live in the heap and are never walked.
        var c: i64 = pert_wait_head;
        while c != 0 {
            var nx: i64 = pe_load(c + 208);
            // join wakeup: awaited task finished → runnable again
            var awaits: i64 = pe_load(c + 112);
            if awaits != 0 && pe_load(awaits + 80) != 0 {
                pe_store(c + 112, 0);
                pe_wait_remove(c);
                pe_store(c + 192, 2);
                pe_wq_push(c);
            } else {
                // BG226: a task waiting for another task is not a waiter:
                // only what the chain of awaits ends in (a socket, a timer,
                // a pool job, a parked or running task) can wake it, and a
                // chain that ends in itself is the deadlock to report
                if pe_load(c + 128) >= 0 {
                    pe_store(fds + n * 16, pe_load(c + 128));
                    if pe_load(c + 136) != 0 {
                        pe_store(fds + n * 16 + 8, 16);
                    } else {
                        pe_store(fds + n * 16 + 8, 256);
                    }
                    pe_store(map + n * 8, c);
                    n = n + 1;
                    waiters = waiters + 1;
                }
                if pe_load(c + 184) != 0 {
                    waiters = waiters + 1;
                }
            }
            c = nx;
        }
        // Soonest deadline is the heap top; armed timers count as waiters.
        first = pe_timer_peek();
        // Tasks parked on a channel, a mutex or a scope's end wait for
        // code that may run outside tasks (BG194, BG195, BG196)
        waiters = waiters + pert_timer_n + pert_afd_n + nat_atomic_load(pert_parked);
        var live_n: i64 = nat_atomic_load(pert_live);
        var idle_n: i64 = nat_atomic_load(pert_idle);
        var queue_empty: bool = pert_wq_head == 0 && pe_lq_total() == 0;
        pe_k_unlock(pert_reg);

        // Deadlock: live tasks exist but nothing can ever run again —
        // queue empty, every worker parked, no fd/timer/join/pool waiters.
        // With per-worker queues a steal handoff can look empty for an
        // instant, so the state must persist across two poll cycles.
        // A task still being made, or run inline by `async` on a thread that
        // is not a worker, is not stuck: main spawning 200,000 tasks while
        // the workers drained the queue panicked here (RT10 bench)
        var looks_dead: bool = live_n > 0 && queue_empty && idle_n >= pert_nworkers && waiters == 0 && nat_atomic_load(pert_offq) == 0;
        if looks_dead {
            pert_dl_streak = pert_dl_streak + 1;
        } else {
            pert_dl_streak = 0;
        }
        if pert_dl_streak >= 2 && pert_co_deadlocked == 0 {
            pert_co_deadlocked = 1;
            p_panic("Tasks are deadlocked: each one awaits another");
        }

        var timeout: i64 = 25;
        if first != 0 {
            timeout = first - now;
            if timeout < 0 {
                timeout = 0;
            }
            if timeout > 25 {
                timeout = 25;
            }
        }
        var got: i64 = 0;
        if pert_afd != 0 {
            // Socket polls, pokes and the deadline all end this wait
            pe_store(pert_iocp_n, 0);
            if pe_k_gqcs_ex(pert_iocp, pert_iocp_ents, 64, pert_iocp_n, timeout, 0) != 0 {
                got = pe_load(pert_iocp_n) & 0xFFFFFFFF;
            }
            if n > 0 {
                pe_k_wsa_poll(fds, n, 0);
            }
        } else if n > 0 {
            pe_k_wsa_poll(fds, n, timeout);
        } else if waiters > 0 {
            pe_k_sleep(timeout);
        } else {
            // Nothing to watch: park until a task registers a wait.
            pe_k_lock(pert_poll_cond);
            pe_k_cond_wait(pert_poll_cond + 8, pert_poll_cond, timeout, 0);
            pe_k_unlock(pert_poll_cond);
        }
        now = pe_k_ticks();

        // Collect and wake: fd hits + expired deadlines, under the registry
        // lock so a task can't be pushed twice for the same wait. Only the
        // wait registry is walked — sleepers stay in the heap.
        pe_k_lock(pert_reg);
        var ei: i64 = 0;
        while ei < got {
            var op: i64 = pe_load(pert_iocp_ents + ei * 32 + 8);
            if op != 0 {
                pe_afd_done(op);
            }
            ei = ei + 1;
        }
        var c2: i64 = pert_wait_head;
        while c2 != 0 {
            var nx2: i64 = pe_load(c2 + 208);
            var c: i64 = c2;
            var wake_now: bool = false;
            var wres: i64 = 0;
            var fd: i64 = pe_load(c + 128);
            if fd >= 0 {
                // Is c's fd one of this cycle's polled hits?
                var j: i64 = 0;
                var hit: bool = false;
                while j < n {
                    if pe_load(map + j * 8) == c {
                        hit = (pe_load(fds + j * 16 + 8) >> 16) != 0;
                        j = n;
                    }
                    j = j + 1;
                }
                var dl: i64 = pe_load(c + 152);
                if hit {
                    wres = 1;
                    wake_now = true;
                } else if dl != 0 && dl <= now {
                    wres = 0;
                    wake_now = true;
                }
            } else {
                var dl2: i64 = pe_load(c + 152);
                if dl2 != 0 && dl2 <= now {
                    wake_now = true;
                }
            }
            if wake_now && pe_load(c + 184) == 0 {
                pe_store(c + 144, wres);
                pe_store(c + 128, -1);
                pe_store(c + 152, 0);
                pe_timer_disarm(c);
                pe_wait_remove(c);
                pe_store(c + 192, 2);
                pe_wq_push(c);
            }
            c2 = nx2;
        }
        // Expired deadlines fire straight off the heap top.
        var more: bool = pert_timer_n > 0 && pe_timer_peek() <= now;
        while more {
            var tb: i64 = pe_timer_pop();
            if pe_load(tb + 152) != 0 {
                pe_afd_cancel(tb);
                pe_store(tb + 144, 0);
                pe_store(tb + 128, -1);
                pe_store(tb + 152, 0);
                pe_wait_remove(tb);
                pe_store(tb + 192, 2);
                pe_wq_push(tb);
            }
            more = pert_timer_n > 0 && pe_timer_peek() <= now;
        }
        pe_k_unlock(pert_reg);
    }
    return 0;
}

/// A task that just registered a wait pokes the poller out of its idle sleep.
fn pe_poller_poke() {
    if pert_afd != 0 {
        pe_k_pqcs(pert_iocp, 0, 1, 0);
        return;
    }
    if pert_poll_cond != 0 {
        pe_k_lock(pert_poll_cond);
        pe_k_cond_signal(pert_poll_cond + 8);
        pe_k_unlock(pert_poll_cond);
    }
}

// ─── Socket readiness on the completion port (RT11) ──────
// A task waiting for a socket submits one AFD poll (IOCTL_AFD_POLL on the
// socket's base handle) and is woken by its completion: no set of sockets is
// rebuilt or scanned per cycle, so a wait costs the same with one socket or
// 100,000. A poll is [0] its IO_STATUS_BLOCK, [2..6) AFD_POLL_INFO (timeout,
// handle count, the handle, events), [6] the task, [7] 1 once its deadline
// won (cancelled: freed when its completion comes), [8..10) the cancel's
// IO_STATUS_BLOCK. Without the AFD device (pert_afd == 0) the poller polls
// the wait set with WSAPoll as before.

var pert_iocp: i64 = 0;  // the completion port
var pert_afd: i64 = 0;  // \Device\Afd\Fides, on the port (0: none)
var pert_afd_n: i64 = 0;  // polls a task waits on (under pert_reg)
var pert_iocp_ents: i64 = 0;  // OVERLAPPED_ENTRY[64] the poller dequeues into
var pert_iocp_n: i64 = 0;  // *u32: how many it got

fn pe_afd_init() {
    pert_iocp_ents = pe_zeroed(64 * 4);
    pert_iocp_n = pe_zeroed(1);
    pert_iocp = pe_k_iocp_create(0 - 1, 0, 0, 0);
    if pert_iocp == 0 {
        return;
    }
    // L"\Device\Afd\Fides"
    var name: i64 = pe_zeroed(5);
    pe_store(name, 0x7600650044005C);
    pe_store(name + 8, 0x5C006500630069);
    pe_store(name + 16, 0x5C006400660041);
    pe_store(name + 24, 0x65006400690046);
    pe_store(name + 32, 0x73);
    var us: i64 = pe_zeroed(2);  // UNICODE_STRING
    pe_store(us, 34 + (36 << 16));
    pe_store(us + 8, name);
    var oa: i64 = pe_zeroed(6);  // OBJECT_ATTRIBUTES
    pe_store(oa, 48);
    pe_store(oa + 16, us);
    var iosb: i64 = pe_zeroed(2);
    var h: i64 = pe_zeroed(1);
    // SYNCHRONIZE, FILE_SHARE_READ | FILE_SHARE_WRITE, FILE_OPEN
    var st: i32 = pe_nt_create_file(h, 0x100000, oa, iosb, 0, 0, 3, 1, 0, 0, 0);
    if st == 0 {
        var afd: i64 = pe_load(h);
        if pe_k_iocp_create(afd, pert_iocp, 0, 0) == pert_iocp {
            pert_afd = afd;
        } else {
            pe_k_close_handle(afd);
        }
    }
    p_free(h);
    p_free(iosb);
    p_free(oa);
    p_free(us);
    p_free(name);
}

/// The socket under any layered service provider: what AFD polls
fn pe_afd_base(fd: i64) -> i64 {
    var out: i64 = pe_zeroed(2);
    var b: i64 = fd;
    if pe_w_wsaioctl(fd, 0x48000022, 0, 0, out, 8, out + 8, 0, 0) == 0 {  // SIO_BASE_HANDLE
        b = pe_load(out);
    }
    p_free(out);
    return b;
}

fn pe_afd_wait(cur: i64, fd: i64, write: i64, timeout_ms: i64) -> i64 {
    var op: i64 = pe_zeroed(10);
    pe_store(op + 16, 0x7FFFFFFFFFFFFFFF);
    pe_store(op + 24, 1);
    pe_store(op + 32, pe_afd_base(fd));
    // read: receive, expedited, disconnect, abort, local close, accept,
    // connect failed; write: send, abort, local close, connect failed
    if write != 0 {
        pe_store(op + 40, 0x134);
    } else {
        pe_store(op + 40, 0x1BB);
    }
    pe_store(op + 48, cur);
    pe_k_lock(pert_reg);
    pe_store(cur + 128, fd);
    pe_store(cur + 136, write);
    pe_store(cur + 144, 0);
    if timeout_ms >= 0 {
        pe_store(cur + 152, pe_k_ticks() + timeout_ms + 1);
        pe_timer_push(pe_load(cur + 152), cur);
    } else {
        pe_store(cur + 152, 0);
    }
    pe_store(cur + 224, op);
    pe_store(cur + 192, 4);
    pert_afd_n = pert_afd_n + 1;
    var st: i32 = pe_nt_ioctl(pert_afd, 0, 0, op, op, 0x12024, op + 16, 32, op + 16, 32);
    if st != 0 && st != 259 {
        // Refused (no completion comes): ready now, the next call on the
        // socket reports its error
        pert_afd_n = pert_afd_n - 1;
        pe_store(cur + 224, 0);
        pe_store(cur + 192, 0);
        pe_store(cur + 128, -1);
        if pe_load(cur + 152) != 0 {
            pe_store(cur + 152, 0);
            pe_timer_disarm(cur);
        }
        pe_k_unlock(pert_reg);
        p_free(op);
        return 1;
    }
    pe_k_unlock(pert_reg);
    if timeout_ms >= 0 {
        pe_poller_poke();  // its deadline may come before the poller wakes
    }
    pe_co_leave();
    return pe_load(cur + 144);
}

/// A poll completed (poller, under pert_reg): wake its task, unless its
/// deadline already did
fn pe_afd_done(op: i64) {
    if pe_load(op + 56) == 0 {
        var t: i64 = pe_load(op + 48);
        pert_afd_n = pert_afd_n - 1;
        pe_store(t + 224, 0);
        pe_store(t + 144, 1);
        pe_store(t + 128, -1);
        if pe_load(t + 152) != 0 {
            pe_store(t + 152, 0);
            pe_timer_disarm(t);
        }
        pe_store(t + 192, 2);
        pe_wq_push(t);
    }
    p_free(op);
}

/// A task's deadline came first (poller, under pert_reg): cancel its poll;
/// the poll is freed when its completion arrives
fn pe_afd_cancel(t: i64) {
    var op: i64 = pe_load(t + 224);
    if op != 0 {
        pe_store(op + 56, 1);
        pe_store(t + 224, 0);
        pert_afd_n = pert_afd_n - 1;
        pe_nt_cancel(pert_afd, op, op + 64);
    }
}

// ─── Blocking pool: syscalls the poller can't cover ───────
// A task submits a job, parks ([23] = job), and a pool OS thread runs it.
// Completion pushes the task back on the run queue.

/// Run program fn `name` on the blocking pool instead of this worker.
/// Off-task, just calls it directly. Blocking builtins (file IO, DNS) route
/// through here so a syscall never stalls a scheduler worker.
pub fn pert_co_pool_call(name: str, nargs: i64, argv: i64) -> i64 {
    var cur: i64 = pe_co_cur();
    var fn_addr: i64 = pe_fn_lookup(name);
    if cur == 0 || fn_addr == 0 {
        return nat_call_fn(fn_addr, nargs, argv);
    }
    var job: i64 = pe_zeroed(16);
    pe_store(job, fn_addr);
    pe_store(job + 8, nargs);
    var a: i64 = 0;
    while a < nargs && a < 8 {
        pe_store(job + 16 + a * 8, pe_load(argv + a * 8));
        a = a + 1;
    }
    pe_store(job + 96, cur);
    pe_k_lock(pert_poolq);
    pe_store(job + 112, 0);
    if pert_pool_tail != 0 {
        pe_store(pert_pool_tail + 112, job);
    } else {
        pert_pool_head = job;
    }
    pert_pool_tail = job;
    pe_k_cond_signal(pert_poolq + 8);
    pe_k_unlock(pert_poolq);
    pe_k_lock(pert_reg);
    pe_store(cur + 184, job);
    pe_wait_add(cur);
    pe_k_unlock(pert_reg);
    pe_co_leave();
    var r: i64 = pe_load(job + 88);
    pe_k_lock(pert_reg);
    pe_store(cur + 184, 0);
    pe_wait_remove(cur);
    pe_k_unlock(pert_reg);
    p_free(job);
    return r;
}

/// Pool OS thread: run each submitted job, then requeue the waiting task.
pub fn pert_pool_main(id: i64) -> i64 {
    while true {
        pe_k_lock(pert_poolq);
        while pert_pool_head == 0 {
            pe_k_cond_wait(pert_poolq + 8, pert_poolq, pe_infinite(), 0);
        }
        var job: i64 = pert_pool_head;
        pert_pool_head = pe_load(job + 112);
        if pert_pool_head == 0 {
            pert_pool_tail = 0;
        }
        pe_k_unlock(pert_poolq);
        var r: i64 = nat_call_fn(pe_load(job), pe_load(job + 8), job + 16);
        pe_store(job + 88, r);
        nat_atomic_store(job + 80, 1);
        // Wake the waiting task under the registry lock: unlink it if its
        // wait_add already ran, then mark it queued so workers never push it
        // a second time.
        pe_k_lock(pert_reg);
        var tb2: i64 = pe_load(job + 96);
        pe_wait_remove(tb2);
        pe_store(tb2 + 192, 2);
        pe_wq_push(tb2);
        pe_k_unlock(pert_reg);
    }
    return 0;
}

/// LG11: the C runtime's `extern "C" fn p_co_stack(bytes) -> i64` (the
/// stack of the tasks started from now on; also asked as
/// p_thread_spawn("__p_co_stack", 1, bytes)). Here a task's stack has one
/// size and tasks run on several workers at once: -2, nothing changes
/// (fid run's interpreter then runs each task to its end when it starts).
pub fn pert_c_p_co_stack(bytes: i64) -> i64 {
    if bytes < 0 {
        return -2;
    }
    return -2;
}

pub fn pert_co_go(name: str, arg: i64) -> i64 {
    var slot: i64 = pe_zeroed(1);
    pe_store(slot, arg);
    var block: i64 = pe_co_new(name, 1, slot);
    p_free(slot);
    return block;
}

/// spawn f(args): a green task as a tagged future (L3B/M3).
pub fn pert_co_spawn_v(name: str, nargs: i64, argv: i64) -> i64 {
    var block: i64 = pe_co_new(name, nargs, argv);
    return block | (0x7FA5 << 48);
}

pub fn pert_co_async_v(name: str, nargs: i64, argv: i64) -> i64 {
    var block: i64 = pe_co_new_block(name, nargs, argv);
    var runnable: i64 = pe_co_enter(block);
    // BG227: 2 finished (its block may be running again elsewhere if not)
    if runnable == 2 {
        pe_co_finish_task(block);
    } else if runnable != 0 {
        // It yielded: queue it. A blocked one is the poller/pool's to wake.
        pe_wq_push(block);
    }
    nat_atomic_add(pert_offq, 0 - 1);
    return block | (0x7FA5 << 48);
}

pub fn pert_co_yield() {
    var c: i64 = pe_co_cur();
    if c != 0 {
        if !pe_co_handoff(c) {
            pe_co_leave_as(1);
        }
    }
}

/// A yield of task `c` on a worker without going through the scheduler
/// (complaint CP5): the next task of this worker's queue (else of the global
/// queue) runs at once, one switch instead of two, and `c` goes to the back
/// of the worker's queue; when nothing else is runnable `c` goes on without a
/// switch. The worker's scheduler context learns later which task left to it
/// (its word [4], pe_co_leave_as). With one worker (FIDES_WORKERS=1) only the
/// worker's thread touches its queue (wakes from the poller, the pool and
/// non-worker threads go to the global queue), so the queue is used without
/// the lock and the count of local tasks does not change. False: not on a
/// worker, entered by another task (an async chain returns there first), or
/// random scheduling (RL17): take the scheduler's way.
fn pe_co_handoff(c: i64) -> bool {
    if pert_rnd_on != 2 || pe_load(c + 120) != 0 {
        return false;
    }
    // The scheduler context it runs under says which worker this is
    var sched: i64 = pe_load(c + 168);
    if sched == 0 {
        return false;
    }
    var wid1: i64 = pe_load(sched + 40);
    if wid1 == 0 {
        return false;
    }
    var wid: i64 = wid1 - 1;
    // Its ring first (no lock, RT10), then the global queue
    var next: i64 = pe_lq_pop(wid);
    if next == 0 && pert_wq_head != 0 {
        pe_k_lock(pert_wq);
        next = pe_gq_take_locked(wid);
        pe_k_unlock(pert_wq);
    }
    if next == 0 {
        return true;  // nothing else to run
    }
    var backlog: bool = pe_lq_size(wid) != 0 || pert_wq_head != 0;
    if !pe_lq_push(c, wid) {
        pe_lq_spill(c, wid);
    } else if backlog && nat_atomic_load(pert_idle) > 0 {
        pe_wq_signal();
    }
    // `c` is on a queue before its registers are saved: a worker that takes
    // it waits in pe_ctx_claim until the switch below clears its busy word
    var mine: i64 = pe_load(c + 104);
    pe_ctx_claim(pe_load(next + 104));
    pe_store(next + 168, sched);
    pe_k_tls_set(pert_tls_cur, next);
    pe_ctx_resume(mine, pe_load(next + 104));
    return true;
}

/// Loop-backedge safepoint (M5): yield only when work is queued behind us,
/// so tight loops can't starve other tasks but don't pay when uncontended.
pub fn pert_co_tick() {
    if pert_wq_head != 0 && pe_co_cur() != 0 {
        pe_co_leave_as(1);
    } else if pert_rnd_on == 1 && pe_co_cur() != 0 && pe_lq_size(0) > 0 && pe_rnd_below(2) == 0 {
        // RL17: a random preemption point while another task is runnable
        pe_co_leave_as(1);
    }
}

/// `task_run()`: workers are already running every task; wait until the
/// registry drains. Returns how many tasks there have been.
pub fn pert_co_run() -> i64 {
    pe_co_ensure();
    pe_k_lock(pert_done);
    while nat_atomic_load(pert_live) > 0 {
        pe_k_cond_wait(pert_done + 8, pert_done, 50, 0);
    }
    pe_k_unlock(pert_done);
    return pert_co_total;
}

fn pe_co_await(f: i64) -> i64 {
    var c: i64 = f & 0xFFFFFFFFFFFF;
    // CA9: the task awaiting it, for a panic's task chain
    var me: i64 = pe_co_cur();
    if me != 0 && pe_load(c + 80) == 0 {
        pe_store(c + 264, me);
    }
    // CA7: with a token in the slot, wait in slices and give up (0) once it
    // is cancelled; the task awaited goes on
    var tok: i64 = pert_task_token();
    if tok != 0 {
        while pe_load(c + 80) == 0 {
            if pe_tok_cancelled(tok) {
                if me != 0 && pe_load(c + 264) == me {
                    pe_store(c + 264, 0);
                }
                return 0;
            }
            pe_co_sleep_plain(1);
        }
        return pe_load(c + 88);
    }
    while pe_load(c + 80) == 0 {
        var cur: i64 = pe_co_cur();
        if cur != 0 {
            pe_k_lock(pert_reg);
            pe_store(cur + 112, c);
            pe_wait_add(cur);
            pe_k_unlock(pert_reg);
            pe_co_leave();
        } else {
            pe_k_lock(pert_done);
            if pe_load(c + 80) == 0 {
                pe_k_cond_wait(pert_done + 8, pert_done, 50, 0);
            }
            pe_k_unlock(pert_done);
        }
    }
    return pe_load(c + 88);
}

fn pe_is_co_future(f: i64) -> bool {
    return ((f >> 48) & 0xFFFF) == 0x7FA5;
}

/// CA7: sleep, in slices when the slot holds a token: 1 when the token
/// stopped it, 0 when the whole time passed.
pub fn pert_co_sleep(ms: i64) -> i64 {
    var tok: i64 = pert_task_token();
    if tok == 0 {
        return pe_co_sleep_plain(ms);
    }
    var d0: i64 = ms;
    if d0 < 0 {
        d0 = 0;
    }
    var end: i64 = pert_clock_mono_ms() + d0;
    while true {
        if pe_tok_cancelled(tok) {
            return 1;
        }
        var left: i64 = end - pert_clock_mono_ms();
        if left <= 0 {
            return 0;
        }
        pe_co_sleep_plain(pe_tok_slice(tok, left));
    }
    return 0;
}

fn pe_co_sleep_plain(ms: i64) -> i64 {
    var cur: i64 = pe_co_cur();
    if cur != 0 {
        var d: i64 = ms;
        if d < 0 {
            d = 0;
        }
        pe_k_lock(pert_reg);
        pe_store(cur + 152, pe_k_ticks() + d + 1);
        pe_timer_push(pe_load(cur + 152), cur);
        // Timer-blocked: not on the wait list, not runnable. Without this the
        // worker's post-switch check sees [24] == 0 and requeues a sleeper.
        pe_store(cur + 192, 3);
        pe_k_unlock(pert_reg);
        pe_poller_poke();
        pe_co_leave();
        return 0;
    }
    pe_k_sleep(ms);
    return 0;
}

/// CA7: with a token in the slot, the wait goes in slices and gives 0 (not
/// ready) once the token is cancelled.
pub fn pert_co_wait_fd(fd: i64, write: i64, timeout_ms: i64) -> i64 {
    var tok: i64 = pert_task_token();
    if tok == 0 {
        return pe_co_wait_fd_plain(fd, write, timeout_ms);
    }
    var start: i64 = pert_clock_mono_ms();
    while true {
        if pe_tok_cancelled(tok) {
            return 0;
        }
        var left: i64 = 0 - 1;
        if timeout_ms >= 0 {
            left = timeout_ms - (pert_clock_mono_ms() - start);
            if left <= 0 {
                return 0;
            }
        }
        if pe_co_wait_fd_plain(fd, write, pe_tok_slice(tok, left)) != 0 {
            return 1;
        }
    }
    return 0;
}

fn pe_co_wait_fd_plain(fd: i64, write: i64, timeout_ms: i64) -> i64 {
    var cur: i64 = pe_co_cur();
    if cur != 0 && pert_afd != 0 {
        return pe_afd_wait(cur, fd, write, timeout_ms);
    }
    if cur != 0 {
        pe_k_lock(pert_reg);
        pe_store(cur + 128, fd);
        pe_store(cur + 136, write);
        if timeout_ms >= 0 {
            pe_store(cur + 152, pe_k_ticks() + timeout_ms + 1);
            pe_timer_push(pe_load(cur + 152), cur);
        } else {
            pe_store(cur + 152, 0);
        }
        pe_wait_add(cur);
        pe_k_unlock(pert_reg);
        pe_poller_poke();
        pe_co_leave();
        return pe_load(cur + 144);
    }
    var one: i64 = pe_zeroed(2);
    pe_store(one, fd);
    if write != 0 {
        pe_store(one + 8, 16);
    } else {
        pe_store(one + 8, 256);
    }
    var r: i64 = pe_k_wsa_poll(one, 1, timeout_ms);
    p_free(one);
    if r > 0 {
        return 1;
    }
    return 0;
}

// ─── Sockets ─────────────────────────────────

var pert_wsa_ready: i64 = 0;

fn pe_wsa() {
    if pert_wsa_ready == 0 {
        pert_wsa_ready = 1;
        var data: i64 = pe_zeroed(64);
        pe_w_startup(514, data);
        p_free(data);
    }
}

/// The first 8 bytes of a sockaddr_in for `port`, above `rest` (the address).
fn pe_port_word(port: i64, rest: i64) -> i64 {
    return (rest & ~4294901760) | ((port & 255) << 24) | (((port >> 8) & 255) << 16);
}

/// A TCP socket on all addresses, listening, or -1: IPv6 and IPv4 clients on
/// one socket (IPV6_V6ONLY off, Windows has it on by default), IPv4 alone
/// where the system has no IPv6.
pub fn pert_socket_listen(port: i64) -> i64 {
    pe_wsa();
    var s6: i64 = pe_w_socket(23, 1, 0);  // AF_INET6
    if s6 != -1 {
        var opt: i64 = pe_zeroed(1);
        pe_store(opt, 1);
        pe_w_setsockopt(s6, 65535, 4, opt, 4);  // SO_REUSEADDR
        pe_store(opt, 0);
        pe_w_setsockopt(s6, 41, 27, opt, 4);  // IPV6_V6ONLY off
        p_free(opt);
        var a6: i64 = pe_zeroed(4);  // sockaddr_in6, 28 bytes
        pe_store(a6, pe_port_word(port, 23));
        var ok6: bool = pe_w_bind(s6, a6, 28) == 0 && pe_w_listen(s6, 0x7FFFFFFF) == 0;
        p_free(a6);
        if ok6 {
            return s6;
        }
        pe_w_close(s6);
    }
    var s: i64 = pe_w_socket(2, 1, 0);
    if s == -1 {
        return -1;
    }
    var on: i64 = pe_zeroed(1);
    pe_store(on, 1);
    pe_w_setsockopt(s, 65535, 4, on, 4);
    p_free(on);
    var addr: i64 = pe_zeroed(2);
    pe_store(addr, pe_port_word(port, 2));
    var bound: i64 = pe_w_bind(s, addr, 16);
    p_free(addr);
    // SOMAXCONN: the system's longest queue of connections not yet accepted
    if bound != 0 || pe_w_listen(s, 0x7FFFFFFF) != 0 {
        pe_w_close(s);
        return -1;
    }
    return s;
}

/// roadmap L4B (stdlib/unix_socket.fd): a Unix-domain stream socket
/// listening at `path`, or -1 (Windows 10 1803+ has AF_UNIX in ws2_32).
/// pert_socket_accept / read / write / close work on it.
pub fn pert_unix_listen(path: str) -> i64 {
    return pe_unix_open(path, true);
}

/// A Unix-domain stream socket connected to the listener at `path`, or -1.
pub fn pert_unix_connect(path: str) -> i64 {
    return pe_unix_open(path, false);
}

/// socket(AF_UNIX, SOCK_STREAM), then bind + listen or connect to
/// SOCKADDR_UN {16-bit family 1, 108 bytes of path}.
fn pe_unix_open(path: str, listening: bool) -> i64 {
    val n: i64 = str_len(path);
    if n == 0 || n > 107 {
        return -1;
    }
    pe_wsa();
    var s: i64 = pe_w_socket(1, 1, 0);  // AF_UNIX, SOCK_STREAM
    if s == -1 {
        return -1;
    }
    var sa: i64 = pe_zeroed(14);  // 112 bytes
    pe_set_byte(sa, 0, 1);
    var i: i64 = 0;
    while i < n {
        pe_set_byte(sa, 2 + i, pe_byte_at(path as i64, i));
        i = i + 1;
    }
    var ok: bool = false;
    if listening {
        ok = pe_w_bind(s, sa, 110) == 0 && pe_w_listen(s, 0x7FFFFFFF) == 0;
    } else {
        ok = pe_w_connect(s, sa, 110) == 0;
    }
    p_free(sa);
    if !ok {
        pe_w_close(s);
        return -1;
    }
    return s;
}

pub fn pert_socket_accept(fd: i64) -> i64 {
    // On a green task: wait on the poller instead of blocking a worker.
    if pe_co_cur() != 0 {
        return pert_co_accept(fd);
    }
    return pe_w_accept(fd, 0, 0);
}

pub fn pert_socket_read(fd: i64, buf: i64, n: i64) -> i64 {
    if pe_co_cur() != 0 {
        pe_co_nonblock(fd);
        return pert_co_recv(fd, buf, n, -1);
    }
    return pe_w_recv(fd, buf, n, 0);
}

pub fn pert_socket_write(fd: i64, data: str) -> i64 {
    if pe_co_cur() != 0 {
        pe_co_nonblock(fd);
        return pert_co_send(fd, data as i64, str_len(data));
    }
    return pe_w_send(fd, data as i64, str_len(data), 0);
}

pub fn pert_socket_write_str(fd: i64, data: str) -> i64 {
    return pert_socket_write(fd, data);
}

pub fn pert_socket_close(fd: i64) {
    pe_w_close(fd);
}

pub fn pert_net_close(fd: i64) {
    pe_w_close(fd);
}

pub fn pert_socket_recv_str(fd: i64) -> str {
    var buf: i64 = pe_zeroed(512);
    var n: i64 = pe_w_recv(fd, buf, 4095, 0);
    if n <= 0 && pe_co_cur() != 0 {
        pe_co_nonblock(fd);
        n = pert_co_recv(fd, buf, 4095, -1);
    }
    if n <= 0 {
        return "";
    }
    return p_str_adopt(buf);
}

/// Task-aware connect: getaddrinfo + connect can block a worker for seconds,
/// so on a green task the whole call runs on the blocking pool (M4).
pub fn pert_net_connect(host: str, port: i64) -> i64 {
    if pe_co_cur() != 0 {
        var args: i64 = pe_zeroed(2);
        pe_store(args, host as i64);
        pe_store(args + 8, port);
        var r: i64 = pert_co_pool_call("pert_net_connect_sync", 2, args);
        p_free(args);
        if r != -1 {
            pe_co_nonblock(r);
        }
        return r;
    }
    return pert_net_connect_sync(host, port);
}

fn pert_net_connect_sync(host: str, port: i64) -> i64 {
    pe_wsa();
    // Any family (AF_UNSPEC): the host's IPv6 and IPv4 addresses, in the
    // order the system ranks them, each tried until one connects
    var hints: i64 = pe_zeroed(6);
    pe_store(hints + 8, 1);
    var res: i64 = pe_zeroed(1);
    var failed: i64 = pe_w_getaddrinfo(host, 0, hints, res);
    p_free(hints);
    var info: i64 = pe_load(res);
    p_free(res);
    if failed != 0 || info == 0 {
        return -1;
    }
    var first: i64 = info;
    var conn: i64 = -1;
    while info != 0 && conn == -1 {
        // addrinfo: [4] family, [16] address length, [32] the address, [40] next
        var fam: i64 = (pe_load(info) >> 32) & 0xFFFFFFFF;
        var alen: i64 = pe_load(info + 16);
        var from: i64 = pe_load(info + 32);
        if (fam == 2 || fam == 23) && alen > 0 && alen <= 32 {
            var a: i64 = pe_zeroed(4);
            var w: i64 = 0;
            while w * 8 < alen {
                pe_store(a + w * 8, pe_load(from + w * 8));
                w = w + 1;
            }
            pe_store(a, pe_port_word(port, pe_load(a)));
            var sk: i64 = pe_w_socket(fam, 1, 0);
            if sk != -1 {
                if pe_w_connect(sk, a, alen) == 0 {
                    conn = sk;
                } else {
                    pe_w_close(sk);
                }
            }
            p_free(a);
        }
        info = pe_load(info + 40);
    }
    pe_w_freeaddrinfo(first);
    return conn;
}

fn pe_co_nonblock(fd: i64) {
    var on: i64 = pe_zeroed(1);
    pe_store(on, 1);
    pe_w_ioctl(fd, 2147772030, on);
    p_free(on);
}

/// The last socket call failed only because it would have blocked.
fn pe_co_blocked() -> bool {
    return pe_w_last_error() == 10035;
}

pub fn pert_co_accept(fd: i64) -> i64 {
    pert_co_wait_fd(fd, 0, -1);
    var c: i64 = pe_w_accept(fd, 0, 0);
    if c != -1 {
        pe_co_nonblock(c);
    }
    return c;
}

pub fn pert_co_connect(host: str, port: i64) -> i64 {
    var c: i64 = pert_net_connect(host, port);
    if c != -1 {
        pe_co_nonblock(c);
    }
    return c;
}

pub fn pert_co_recv(fd: i64, buf: i64, n: i64, timeout_ms: i64) -> i64 {
    while true {
        var got: i64 = pe_w_recv(fd, buf, n, 0);
        if got >= 0 {
            return got;
        }
        if !pe_co_blocked() {
            return -1;
        }
        if pert_co_wait_fd(fd, 0, timeout_ms) == 0 {
            return -2;
        }
    }
    return -1;
}

pub fn pert_co_send(fd: i64, buf: i64, n: i64) -> i64 {
    var done: i64 = 0;
    while done < n {
        var sent: i64 = pe_w_send(fd, buf + done, n - done, 0);
        if sent > 0 {
            done = done + sent;
        } else if sent < 0 && !pe_co_blocked() {
            return -1;
        } else if pert_co_wait_fd(fd, 1, 30000) == 0 {
            return -1;
        }
    }
    return done;
}

pub fn pert_co_detach(t: i64) {
    // BG119: a thread future is -(index + 1): claim its join, drop the
    // result and let the OS thread end on its own. A scope's scan (the
    // executor's pe_thr_handle test) then skips it, as does a later join.
    if t < 0 {
        var idx: i64 = pe_task_index(t);
        if idx >= 0 {
            var ds: i64 = pe_thr_slot(idx);
            if ds != 0 {
                var dh: i64 = nat_atomic_load(ds);
                while dh != 0 {
                    if dh == 0 - 1 {
                        // a join is under way: its caller owns the thread
                        return;
                    }
                    if nat_atomic_cas(ds, dh, 0) {
                        pe_k_close_handle(dh);
                        pe_store(ds + 16, 0);
                        return;
                    }
                    dh = nat_atomic_load(ds);
                }
            }
        }
        return;
    }
    // Never free here: a finished-but-unreaped block is still in the task
    // registry the poller scans. pe_co_finish_task frees it after removal —
    // the handle is dead to the caller either way.
    pe_store(t + 160, 1);
}

pub fn pert_co_done(t: i64) -> i64 {
    return pe_load(t + 80);
}

pub fn pert_co_result(t: i64) -> i64 {
    return pe_load(t + 88);
}

/// The table index of future f, or -1 (a ready value or an unknown handle).
fn pe_task_index(f: i64) -> i64 {
    if f >= 0 {
        return -1;
    }
    var idx: i64 = 0 - (f + 1);
    if idx >= pe_thread_count() {
        return -1;
    }
    return idx;
}

fn pe_task_done(idx: i64) -> bool {
    return nat_atomic_load(pe_load(pe_thr_slot(idx) + 8) + 80) != 0;
}

/// Join thread idx (once) and return its result. The handle word is the
/// state: >0 a live handle, -1 a join in progress, 0 joined — claimed by
/// compare-and-swap so two callers cannot join it twice (BG110).
fn pe_join(idx: i64) -> i64 {
    var s: i64 = pe_thr_slot(idx);
    if s == 0 {
        return 0;
    }
    var handle: i64 = nat_atomic_load(s);
    while handle != 0 {
        if handle == 0 - 1 {
            // another caller joins it now: wait for the result it stores
            pe_k_sleep(0);
            handle = nat_atomic_load(s);
        } else if nat_atomic_cas(s, handle, 0 - 1) {
            pe_k_wait(handle, pe_infinite());
            pe_k_close_handle(handle);
            pe_store(s + 16, pe_load(pe_load(s + 8) + 88));
            nat_atomic_store(s, 0);
            handle = 0;
        } else {
            handle = nat_atomic_load(s);
        }
    }
    return pe_load(s + 16);
}

pub fn pert_future_ready(value: i64) -> i64 {
    return value;
}

pub fn pert_future_poll(f: i64) -> i64 {
    if pe_is_co_future(f) {
        return pe_co_await(f);
    }
    if f >= 0 {
        return f;
    }
    var idx: i64 = pe_task_index(f);
    if idx < 0 {
        return 0;
    }
    return pe_join(idx);
}

pub fn pert_task_poll(f: i64) -> i64 {
    return pert_future_poll(f);
}

pub fn pert_task_is_ready(f: i64) -> bool {
    if pe_is_co_future(f) {
        return pe_load((f & 0xFFFFFFFFFFFF) + 80) != 0;
    }
    if f >= 0 {
        return true;
    }
    var idx: i64 = pe_task_index(f);
    if idx < 0 {
        return false;
    }
    return pe_task_done(idx);
}

pub fn pert_task_poll_nonblocking(f: i64) -> i64 {
    if pe_is_co_future(f) {
        if pe_load((f & 0xFFFFFFFFFFFF) + 80) == 0 {
            return pe_pending();
        }
        return pe_co_await(f);
    }
    if f >= 0 {
        return f;
    }
    var idx: i64 = pe_task_index(f);
    if idx < 0 {
        return 0;
    }
    if !pe_task_done(idx) {
        return pe_pending();
    }
    return pe_join(idx);
}

pub fn pert_executor_new() -> i64 {
    // The index the first not-yet-spawned thread will take: the scans below
    // join the threads started after this executor, as the C runtime's
    // p_executor_new does (BG45 — a scope joins only the threads it
    // started, and never a detached one)
    var exec: i64 = pe_thread_count();
    // BG196: and the green tasks started inside it ("The tasks of a spawn
    // scope")
    pe_scope_open(exec);
    return exec;
}

pub fn pert_executor_block_on(exec: i64, f: i64) -> i64 {
    return pert_future_poll(f);
}

/// Join every task still running — OS threads and green tasks alike; the
/// number joined. `spawn scope { }` exits through here, so a scope waits for
/// both kinds of work it started (BG196: the green tasks started inside it,
/// not every live one).
pub fn pert_executor_run_all(exec: i64) -> i64 {
    var count: i64 = 0;
    var i: i64 = exec;
    if i < 0 {
        i = 0;
    }
    var n: i64 = pe_thread_count();
    while i < n {
        if pe_thr_handle(i) != 0 {
            pe_join(i);
            count = count + 1;
        }
        i = i + 1;
    }
    count = count + pe_scope_close(exec);
    return count;
}

/// Join the finished tasks; the number still running.
pub fn pert_executor_poll_all(exec: i64) -> i64 {
    var pending: i64 = 0;
    var i: i64 = exec;
    if i < 0 {
        i = 0;
    }
    var n: i64 = pe_thread_count();
    while i < n {
        if pe_thr_handle(i) != 0 {
            if pe_task_done(i) {
                pe_join(i);
            } else {
                pending = pending + 1;
            }
        }
        i = i + 1;
    }
    return pending;
}

/// Cancel the tasks of a scope: a task cannot be stopped mid-way, so wait
/// for those still running (none outlives its scope), drop their results
/// (0), and return how many were cancelled.
pub fn pert_executor_cancel(exec: i64) -> i64 {
    var count: i64 = 0;
    var i: i64 = exec;
    if i < 0 {
        i = 0;
    }
    var n: i64 = pe_thread_count();
    while i < n {
        if pe_thr_handle(i) != 0 {
            var was_done: bool = pe_task_done(i);
            pe_join(i);
            if !was_done {
                pe_store(pe_thr_slot(i) + 16, 0);
                count = count + 1;
            }
        }
        i = i + 1;
    }
    return count;
}

// ─── Shared memory, atomics, mutexes, thread-local storage ─────────────

pub fn pert_shared_alloc(size: i64) -> i64 {
    if size < 0 {
        return 0;
    }
    return p_malloc(size);
}

pub fn pert_atomic_load(addr: i64) -> i64 {
    pe_rnd_jitter();
    return nat_atomic_load(addr);
}

pub fn pert_atomic_store(addr: i64, value: i64) {
    pe_rnd_jitter();
    nat_atomic_store(addr, value);
}

/// The previous value.
pub fn pert_atomic_add(addr: i64, value: i64) -> i64 {
    pe_rnd_jitter();
    return nat_atomic_add(addr, value);
}

/// The previous value.
@wrapping
pub fn pert_atomic_sub(addr: i64, value: i64) -> i64 {
    return nat_atomic_add(addr, 0 - value);
}

pub fn pert_atomic_cas(addr: i64, expected: i64, new_value: i64) -> bool {
    pe_rnd_jitter();
    return nat_atomic_cas(addr, expected, new_value);
}

/// A mutex (not recursive, as a default pthread mutex): [0] an SRW lock
/// held only to look and change, [1] the condition variable threads wait
/// on, [2] 1 while held, [3..5) the tasks parked on it. BG195: it was the
/// SRW lock itself, held by the OS thread: a task holding it across a
/// suspension blocked the next task of its worker inside
/// AcquireSRWLockExclusive, and with it the worker. A task waits parked, so
/// the holder can run on and release it, from any worker.
pub fn pert_mutex_init() -> i64 {
    var m: i64 = pe_zeroed(5);
    pe_k_lock_init(m);
    pe_k_cond_init(m + 8);
    return m;
}

pub fn pert_mutex_lock(m: i64) {
    pe_rnd_jitter();
    pe_k_lock(m);
    while pe_load(m + 16) != 0 {
        var cur: i64 = pe_co_cur();
        if cur != 0 {
            pe_park(cur, m, m + 24);
        } else {
            pe_k_cond_wait(m + 8, m, pe_infinite(), 0);
        }
    }
    pe_store(m + 16, 1);
    pe_k_unlock(m);
}

pub fn pert_mutex_unlock(m: i64) {
    pe_k_lock(m);
    pe_store(m + 16, 0);
    // one waiter of each kind: the one that loses the race waits again,
    // and the winner's unlock wakes the next
    pe_park_wake_one(m + 24);
    pe_k_cond_signal(m + 8);
    pe_k_unlock(m);
    pe_rnd_jitter();
}

pub fn pert_tls_create() -> i64 {
    return pe_k_tls_alloc();
}

pub fn pert_tls_get(key: i64) -> i64 {
    return pe_k_tls_get(key);
}

pub fn pert_tls_set(key: i64, value: i64) {
    pe_k_tls_set(key, value);
}

// ─── Channels ───────────────────────────────────────────────────────────
// [0] lock, [1] not_empty, [2] not_full, [3] head (next read), [4] tail
// (next write), [5] count, [6] capacity, [7] closed, [8..] buffer, then two
// lists of parked tasks: receivers, senders (pe_chan_parked, BG194).

pub fn pert_chan_create(capacity: i64) -> i64 {
    var cap: i64 = capacity;
    if cap < 1 {
        cap = 1;
    }
    // (+ the two lists of parked tasks after the buffer, BG194)
    var ch: i64 = pe_zeroed(12 + cap);
    pe_k_lock_init(ch);
    pe_k_cond_init(ch + 8);
    pe_k_cond_init(ch + 16);
    pe_store(ch + 48, cap);
    return ch;
}

/// BG194: the tasks parked on `ch` for a value; for room the list after it.
/// A task waits parked, not on the condition variables, which would sleep
/// its OS thread: an `async fn` that receives would stop the thread that
/// called it before that thread sends, and a worker would stop running the
/// task that sends.
fn pe_chan_parked(ch: i64) -> i64 {
    return ch + 64 + pe_load(ch + 48) * 8;
}

/// Block until there is room or the channel is closed; false if closed.
pub fn pert_chan_send(ch: i64, value: i64) -> bool {
    if ch == 0 {
        return false;
    }
    pe_rnd_jitter();
    // CA7: with a token in the slot, wait in slices (a task gives its turn)
    // and give up (false, as on a closed channel) once it is cancelled
    var tok: i64 = pert_task_token();
    pe_k_lock(ch);
    while tok != 0 && pe_load(ch + 40) == pe_load(ch + 48) && pe_load(ch + 56) == 0 {
        pe_k_unlock(ch);
        if pe_tok_cancelled(tok) {
            return false;
        }
        pe_co_sleep_plain(1);
        pe_k_lock(ch);
    }
    var cur: i64 = pe_co_cur();
    while pe_load(ch + 40) == pe_load(ch + 48) && pe_load(ch + 56) == 0 {
        if cur != 0 {
            pe_park(cur, ch, pe_chan_parked(ch) + 16);
        } else {
            pe_k_cond_wait(ch + 16, ch, pe_infinite(), 0);
        }
    }
    if pe_load(ch + 56) != 0 {
        pe_k_unlock(ch);
        return false;
    }
    var tail: i64 = pe_load(ch + 32);
    pe_store(ch + 64 + tail * 8, value);
    pe_store(ch + 32, (tail + 1) % pe_load(ch + 48));
    pe_store(ch + 40, pe_load(ch + 40) + 1);
    pe_k_cond_signal(ch + 8);
    // one value: one receiver (one that finds it taken parks again)
    pe_park_wake_one(pe_chan_parked(ch));
    pe_k_unlock(ch);
    return true;
}

/// The oldest value; with the channel closed and empty, the pending value.
fn pe_chan_take(ch: i64) -> i64 {
    var head: i64 = pe_load(ch + 24);
    var value: i64 = pe_load(ch + 64 + head * 8);
    pe_store(ch + 24, (head + 1) % pe_load(ch + 48));
    pe_store(ch + 40, pe_load(ch + 40) - 1);
    pe_k_cond_signal(ch + 16);
    pe_park_wake_one(pe_chan_parked(ch) + 16);
    return value;
}

/// Block until there is a value or the channel is closed and empty.
pub fn pert_chan_recv(ch: i64) -> i64 {
    if ch == 0 {
        return 0;
    }
    pe_rnd_jitter();
    // CA7: as pert_chan_send; a cancelled receive gives what a closed,
    // empty channel gives
    var tok: i64 = pert_task_token();
    pe_k_lock(ch);
    while tok != 0 && pe_load(ch + 40) == 0 && pe_load(ch + 56) == 0 {
        pe_k_unlock(ch);
        if pe_tok_cancelled(tok) {
            return pe_pending();
        }
        pe_co_sleep_plain(1);
        pe_k_lock(ch);
    }
    var cur: i64 = pe_co_cur();
    while pe_load(ch + 40) == 0 && pe_load(ch + 56) == 0 {
        if cur != 0 {
            pe_park(cur, ch, pe_chan_parked(ch));
        } else {
            pe_k_cond_wait(ch + 8, ch, pe_infinite(), 0);
        }
    }
    if pe_load(ch + 40) == 0 {
        pe_k_unlock(ch);
        return pe_pending();
    }
    var value: i64 = pe_chan_take(ch);
    pe_k_unlock(ch);
    return value;
}

/// A value if one is waiting; else 0 if closed, the pending value if not.
pub fn pert_chan_try_recv(ch: i64) -> i64 {
    if ch == 0 {
        return pe_pending();
    }
    pe_k_lock(ch);
    if pe_load(ch + 40) == 0 {
        var closed: i64 = pe_load(ch + 56);
        pe_k_unlock(ch);
        if closed != 0 {
            return 0;
        }
        return pe_pending();
    }
    var value: i64 = pe_chan_take(ch);
    pe_k_unlock(ch);
    return value;
}

pub fn pert_chan_close(ch: i64) {
    if ch == 0 {
        return;
    }
    pe_k_lock(ch);
    pe_store(ch + 56, 1);
    pe_k_cond_broadcast(ch + 8);
    pe_k_cond_broadcast(ch + 16);
    pe_park_wake_all(pe_chan_parked(ch));
    pe_park_wake_all(pe_chan_parked(ch) + 16);
    pe_k_unlock(ch);
}

pub fn pert_chan_is_closed(ch: i64) -> bool {
    if ch == 0 {
        return true;
    }
    pe_k_lock(ch);
    var closed: i64 = pe_load(ch + 56);
    pe_k_unlock(ch);
    return closed != 0;
}

// ─── Zero-copy file and socket I/O (competitive roadmap RT14) ───────────
// fs.fd's fs_copy_file and FileView and net.fd's net_send_file call
// p_fs_copy_file, p_fs_map / p_fs_unmap and p_net_send_file; on native
// Windows these run instead of their portable bodies. The system copies
// the file (CopyFileA), maps it (MapViewOfFile) or sends it from the file
// cache (TransmitFile), so the bytes never pass through the program. What
// it cannot do (a task's socket, which is non-blocking; a file of 2 GB or
// more; a socket without TransmitFile; CopyFileA refused) goes through a
// 64 KB buffer instead, with the same result. kernel32's functions beyond
// the static import list and mswsock's TransmitFile are bound at start-up
// by the program's DLL loader (pe_ir's `link` DLLs).

extern "C" {
    // kernel32.dll (static import list)
    fn CreateFileA as pe_zc_open(path: str, access: i64, share: i64, sa: i64, disposition: i64, flags: i64, tmpl: i64) -> i64;
}

extern "C" link "kernel32.dll" {
    fn CopyFileA as pe_zc_copy(src: str, dst: str, fail_if_exists: i64) -> i32;
    fn GetFileSizeEx as pe_zc_size_ex(h: i64, out: i64) -> i32;
    fn GetFileInformationByHandle as pe_zc_info(h: i64, out: i64) -> i32;
    fn SetFilePointerEx as pe_zc_seek(h: i64, dist: i64, new_pos: i64, method: i64) -> i32;
    fn CreateFileMappingA as pe_zc_mapping(h: i64, sa: i64, protect: i64, size_hi: i64, size_lo: i64, name: i64) -> i64;
    fn MapViewOfFile as pe_zc_view(mapping: i64, access: i64, off_hi: i64, off_lo: i64, n: i64) -> i64;
    fn UnmapViewOfFile as pe_zc_unview(addr: i64) -> i32;
}

extern "C" link "mswsock" {
    fn TransmitFile as pe_zc_transmit(s: i64, file: i64, n: i64, per_send: i64, overlapped: i64, buffers: i64, flags: i64) -> i32;
}

/// CreateFileA of `path` with `access`: the handle, or -1.
fn pe_zc_handle(path: str, access: i64, flags: i64) -> i64 {
    // FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, OPEN_EXISTING
    var h: i64 = pe_zc_open(path, access, 7, 0, 3, flags, 0);
    if h == 0 {
        return -1;
    }
    return h;
}

/// The size of the open file `h`, or -1.
fn pe_zc_handle_size(h: i64) -> i64 {
    var out: i64 = pe_zeroed(1);
    var ok: bool = pe_zc_size_ex(h, out) != 0;
    var n: i64 = pe_load(out);
    p_free(out);
    if !ok {
        return -1;
    }
    return n;
}

/// The size of the file `path` (not a folder), or -1.
fn pe_zc_path_size(path: str) -> i64 {
    // FILE_READ_ATTRIBUTES, FILE_ATTRIBUTE_NORMAL
    var h: i64 = pe_zc_handle(path, 128, 128);
    if h == -1 {
        return -1;
    }
    var n: i64 = pe_zc_handle_size(h);
    pe_k_close_handle(h);
    return n;
}

/// The volume serial number and file index of `path` (BY_HANDLE_FILE_INFORMATION:
/// the serial at byte 28, the index's high half at 44, its low half at 48)
/// into the two words at `out`; false when it cannot be opened.
fn pe_zc_ident(path: str, out: i64) -> bool {
    // FILE_READ_ATTRIBUTES; FILE_FLAG_BACKUP_SEMANTICS (a folder opens too)
    var h: i64 = pe_zc_handle(path, 128, 33554432);
    if h == -1 {
        return false;
    }
    var info: i64 = pe_zeroed(7);
    var ok: bool = pe_zc_info(h, info) != 0;
    pe_k_close_handle(h);
    if ok {
        pe_store(out, (pe_load(info + 24) >> 32) & 4294967295);
        pe_store(out + 8, (((pe_load(info + 40) >> 32) & 4294967295) << 32) | (pe_load(info + 48) & 4294967295));
    }
    p_free(info);
    return ok;
}

/// Are `a` and `b` one file (by another name too)?
fn pe_zc_same_file(a: str, b: str) -> bool {
    var w: i64 = pe_zeroed(4);
    var same: bool = pe_zc_ident(a, w) && pe_zc_ident(b, w + 16) && pe_load(w) == pe_load(w + 16) && pe_load(w + 8) == pe_load(w + 24);
    p_free(w);
    return same;
}

/// `src` to `dst` through a 64 KB buffer (msvcrt stdio): the bytes copied,
/// or -1. No target is made when the source cannot be opened.
fn pe_zc_copy_buffered(src: str, dst: str) -> i64 {
    var inf: i64 = pe_c_fopen(src, "rb");
    if inf == 0 {
        return -1;
    }
    var outf: i64 = pe_c_fopen(dst, "wb");
    if outf == 0 {
        pe_c_fclose(inf);
        return -1;
    }
    var buf: i64 = p_malloc(65536);
    var bad: bool = buf == 0;
    var total: i64 = 0;
    var n: i64 = 0;
    if !bad {
        n = pe_c_fread(buf, 1, 65536, inf);
    }
    while !bad && n > 0 {
        if pe_c_fwrite(buf, 1, n, outf) != n {
            bad = true;
        } else {
            total = total + n;
            n = pe_c_fread(buf, 1, 65536, inf);
        }
    }
    if buf != 0 {
        p_free(buf);
    }
    pe_c_fclose(inf);
    if pe_c_fclose(outf) != 0 {
        bad = true;
    }
    if bad {
        return -1;
    }
    return total;
}

/// p_fs_copy_file: `src` to `dst` (created or emptied first; a file copied
/// onto itself is left as it is): the bytes copied, or -1.
pub fn pert_fs_copy_file(src: str, dst: str) -> i64 {
    if (src as i64) == 0 || (dst as i64) == 0 {
        return -1;
    }
    var size: i64 = pe_zc_path_size(src);
    if size < 0 {
        return -1;
    }
    if pe_zc_same_file(src, dst) {
        return size;
    }
    if pe_zc_copy(src, dst, 0) != 0 {
        var got: i64 = pe_zc_path_size(dst);
        if got >= 0 {
            return got;
        }
    }
    return pe_zc_copy_buffered(src, dst);
}

/// All n bytes at buf on socket `sock` (a task waits while it is full): n,
/// or -1.
fn pe_zc_send_all(sock: i64, buf: i64, n: i64) -> i64 {
    if pe_co_cur() != 0 {
        pe_co_nonblock(sock);
        return pert_co_send(sock, buf, n);
    }
    var done: i64 = 0;
    while done < n {
        var w: i64 = pe_w_send(sock, buf + done, n - done, 0);
        if w > 0 {
            done = done + w;
        } else if w < 0 && (pe_w_last_error() as i64) == 10035 && pert_co_wait_fd(sock, 1, 30000) != 0 {
        // WSAEWOULDBLOCK: a socket the program made non-blocking, now
        // writable again
        } else {
            return -1;
        }
    }
    return done;
}

/// p_net_send_file: the file at `path` on the connected socket `sock`: the
/// bytes sent, or -1.
pub fn pert_net_send_file(sock: i64, path: str) -> i64 {
    if (path as i64) == 0 || sock < 0 {
        return -1;
    }
    // GENERIC_READ; FILE_FLAG_SEQUENTIAL_SCAN | FILE_ATTRIBUTE_NORMAL
    var f: i64 = pe_zc_handle(path, 2147483648, 134217856);
    if f == -1 {
        return -1;
    }
    var size: i64 = pe_zc_handle_size(f);
    if size <= 0 {
        pe_k_close_handle(f);
        if size == 0 {
            return 0;
        }
        return -1;
    }
    if pe_co_cur() == 0 && size < 2147483646 {
        // the whole file, from the system's file cache
        if pe_zc_transmit(sock, f, 0, 0, 0, 0, 0) != 0 {
            pe_k_close_handle(f);
            return size;
        }
        var e: i64 = pe_w_last_error() as i64;
        // WSAEOPNOTSUPP, WSAENOTSOCK: no TransmitFile here, the buffer below
        if e != 10045 && e != 10038 {
            pe_k_close_handle(f);
            return -1;
        }
        pe_zc_seek(f, 0, 0, 0);
    }
    var buf: i64 = p_malloc(65536);
    var got: i64 = pe_zeroed(1);
    var total: i64 = 0;
    var bad: bool = buf == 0;
    var going: bool = !bad;
    while going {
        pe_store(got, 0);
        if pe_k_read_file(f, buf, 65536, got, 0) == 0 {
            bad = true;
            going = false;
        } else {
            var n: i64 = pe_load(got) & 4294967295;
            if n == 0 {
                going = false;
            } else if pe_zc_send_all(sock, buf, n) != n {
                bad = true;
                going = false;
            } else {
                total = total + n;
            }
        }
    }
    if buf != 0 {
        p_free(buf);
    }
    p_free(got);
    pe_k_close_handle(f);
    if bad {
        return -1;
    }
    return total;
}

/// p_fs_map (fs.fd FileView): `size` bytes of the file `path` mapped
/// read-only, or 0 (the file is not that size now, or cannot be mapped).
/// The view keeps the mapping and the file open by itself.
pub fn pert_fs_map(path: str, size: i64) -> i64 {
    if (path as i64) == 0 || size <= 0 {
        return 0;
    }
    // GENERIC_READ, FILE_ATTRIBUTE_NORMAL
    var f: i64 = pe_zc_handle(path, 2147483648, 128);
    if f == -1 {
        return 0;
    }
    if pe_zc_handle_size(f) != size {
        pe_k_close_handle(f);
        return 0;
    }
    // PAGE_READONLY; FILE_MAP_READ
    var m: i64 = pe_zc_mapping(f, 0, 2, 0, 0, 0);
    pe_k_close_handle(f);
    if m == 0 {
        return 0;
    }
    var a: i64 = pe_zc_view(m, 4, 0, 0, 0);
    pe_k_close_handle(m);
    return a;
}

/// p_fs_unmap: undo pert_fs_map: 0, or -1.
pub fn pert_fs_unmap(addr: i64, size: i64) -> i64 {
    if addr == 0 || size <= 0 {
        return -1;
    }
    if pe_zc_unview(addr) == 0 {
        return -1;
    }
    return 0;
}

// ─── The sampling profiler (competitive SL15) ───────────────────────────
// Native Windows (pe_ir), as linux_runtime/sys.fd's on Linux. A sampler
// thread, every millisecond, looks at each thread registered here (every
// OS thread pert_thread_main starts: the task workers, the poller, the
// pool, p_thread_spawn's threads; and the thread that starts the profiler,
// the main one under FID_PROF) and samples each that ran since its last
// look (QueryThreadCycleTime: one sample per ms of its CPU time):
// SuspendThread, GetThreadContext (rip, rsp, rbp), the function the pc is
// in counted "self" and every function on its frame chain once "total",
// ResumeThread. Nothing is allocated and no lock taken while a thread is
// suspended (it may hold the heap's). Functions are named by nat_fn_names
// (pe_ir's MI20 table of [address, name], made when this file reaches
// it). pe_ir's functions all start `push rbp; mov rbp, rsp`, so the frame
// chain is rbp's; it is followed only inside the stack the thread is on
// (StackLimit..StackBase of its TEB, which a task switch keeps current).
//
// Control, the same as Linux: FID_PROF set (not empty, not "0") starts it
// before main (pert_prof_boot, called by the entry point) and prints the
// profile at exit (pert_prof_exit after main, pert_exit);
// FID_PROF_EVERY=<s> prints it every s seconds while the program runs on.
// In place of SIGUSR2: setting the named event Local\fid-prof-<pid> from
// another process (PowerShell: [Threading.EventWaitHandle]::OpenExisting(
// 'Local\fid-prof-1234').Set()), or Ctrl-Break in the program's console,
// prints the profile so far (a watcher thread prints: printing allocates).
// A program drives it itself with p_prof_start / p_prof_stop /
// p_prof_report / p_prof_samples (stdlib/profiler.fd prof_*).

extern "C" {
    fn nat_fn_names() -> i64;
}

extern "C" link "kernel32.dll" {
    fn OpenThread as pe_pf_open_thread(access: i64, inherit: i64, tid: i64) -> i64;
    fn GetCurrentThreadId as pe_pf_thread_id() -> i64;
    fn SuspendThread as pe_pf_suspend(h: i64) -> i64;
    fn ResumeThread as pe_pf_resume(h: i64) -> i64;
    fn GetThreadContext as pe_pf_get_context(h: i64, ctx: i64) -> i32;
    fn QueryThreadCycleTime as pe_pf_cycles(h: i64, out: i64) -> i32;
    fn CreateEventA as pe_pf_create_event(attrs: i64, manual: i64, initial: i64, name: str) -> i64;
}

extern "C" link "ntdll" {
    fn NtQueryInformationThread as pe_pf_thread_info(h: i64, class: i64, buf: i64, len: i64, ret: i64) -> i32;
    fn NtSetTimerResolution as pe_pf_timer_res(want: i64, set: i64, actual: i64) -> i32;
}

const PE_PF_MAXT: i64 = 64;  // threads the sampler can look at
const PE_PF_DEPTH: i64 = 256;  // frames followed per sample

var pe_pf_on: i64 = 0;  // 1 while samples are counted
var pe_pf_m: i64 = 0;  // functions in nat_fn_names (0: no tables yet)
var pe_pf_tab: i64 = 0;  // nat_fn_names(): [address, name]*, [end, 0]
var pe_pf_self: i64 = 0;  // per bucket (m functions, primitives, other)
var pe_pf_total: i64 = 0;  // per bucket: samples with it on the stack
var pe_pf_stamp: i64 = 0;  // per bucket: the sample that counted it last
var pe_pf_n: i64 = 0;  // samples taken (the sampler thread writes it)
var pe_pf_prime: i64 = 0;  // 1: the next round only notes cycle counts
var pe_pf_threads: i64 = 0;  // per thread: [handle][TEB][cycles][thread id]
var pe_pf_tcount: i64 = 0;  // *i64: records claimed
var pe_pf_up: i64 = 0;  // 1 once the sampler (and watcher) started
var pe_pf_sampler_fn: i64 = 0;  // their entry points: not registered
var pe_pf_watch_fn: i64 = 0;
var pe_pf_req: i64 = 0;  // a report asked for (Ctrl-Break)

fn pe_pf_ldb(p: i64) -> i64 {
    var bp: *mut u8 = p;
    var b: i64 = 0;
    // SAFETY: NOT checked here: a byte of a function name of nat_fn_names'
    // table, of the code at a function's start, or of an environment
    // string, up to its NUL.
    unsafe {
        b = *bp;
    }
    return b;
}

/// The registry of threads, made once (a named mutex, as pe_co_ensure).
fn pe_pf_reg_init() {
    if pe_pf_threads != 0 {
        return;
    }
    var lock: i64 = pe_k_create_mutex(0, 0, "fid_prof_registry");
    if lock != 0 {
        pe_k_wait(lock, pe_infinite());
    }
    if pe_pf_threads == 0 {
        pe_pf_tcount = pe_zeroed(1);
        pe_pf_threads = pe_zeroed(PE_PF_MAXT * 4);
    }
    if lock != 0 {
        pe_k_release_mutex(lock);
        pe_k_close_handle(lock);
    }
}

/// Register the running thread with the sampler: a handle of its own
/// (suspend, get context, query) and its TEB. Once per thread id.
fn pe_pf_add_self() {
    pe_pf_reg_init();
    var n: i64 = nat_atomic_load(pe_pf_tcount);
    if n >= PE_PF_MAXT {
        return;
    }
    var tid: i64 = pe_pf_thread_id() & 4294967295;
    var i: i64 = 0;
    while i < n {
        if pe_load(pe_pf_threads + i * 32 + 24) == tid {
            return;
        }
        i = i + 1;
    }
    // THREAD_SUSPEND_RESUME | GET_CONTEXT | QUERY_INFORMATION | QUERY_LIMITED
    var h: i64 = pe_pf_open_thread(2 | 8 | 64 | 2048, 0, tid);
    if h == 0 {
        return;
    }
    // THREAD_BASIC_INFORMATION: TebBaseAddress at 8
    var info: i64 = pe_zeroed(6);
    var teb: i64 = 0;
    if pe_pf_thread_info(h, 0, info, 48, 0) == 0 {
        teb = pe_load(info + 8);
    }
    p_free(info);
    var at: i64 = nat_atomic_add(pe_pf_tcount, 1);
    if at >= PE_PF_MAXT {
        pe_k_close_handle(h);
        return;
    }
    var rec: i64 = pe_pf_threads + at * 32;
    pe_store(rec + 8, teb);
    pe_store(rec + 16, 0);
    pe_store(rec + 24, tid);
    nat_atomic_store(rec, h);
}

/// pert_thread_main, on each new OS thread running `entry`: registered,
/// unless it is the sampler or the watcher.
fn pe_pf_thread_start(entry: i64) {
    if entry == pe_pf_sampler_fn || entry == pe_pf_watch_fn {
        return;
    }
    if pe_pf_tcount != 0 && nat_atomic_load(pe_pf_tcount) >= PE_PF_MAXT {
        return;
    }
    pe_pf_add_self();
}

/// The counting tables (a zeroed word per bucket: m functions, the code
/// before the first, the rest), made once. False when the image has no
/// function table.
fn pe_pf_setup() -> bool {
    if pe_pf_m != 0 {
        return true;
    }
    var tab: i64 = nat_fn_names();
    if tab == 0 {
        return false;
    }
    var m: i64 = 0;
    while pe_load(tab + m * 16 + 8) != 0 {
        m = m + 1;
    }
    if m == 0 {
        return false;
    }
    pe_pf_self = pe_zeroed(m + 2);
    pe_pf_total = pe_zeroed(m + 2);
    pe_pf_stamp = pe_zeroed(m + 2);
    // DB9 (known-bugs 2g.101): the entry point (pe_ir names it __fid_entry
    // in the table) is not one of the program's functions: stacks start at
    // main, as on the other backends. Its return addresses were also
    // counted under the function placed before it (__c_fn_pe_console_ctrl)
    pe_pf_tab = tab;
    pe_pf_m = m;
    return true;
}

/// Every count back to 0.
fn pe_pf_clear() {
    var b: i64 = 0;
    while b < pe_pf_m + 2 {
        pe_store(pe_pf_self + b * 8, 0);
        pe_store(pe_pf_total + b * 8, 0);
        pe_store(pe_pf_stamp + b * 8, 0);
        b = b + 1;
    }
    pe_pf_n = 0;
}

/// The bucket of code address pc: the function of nat_fn_names it is in;
/// m before the first function, m + 1 past the code.
fn pe_pf_bucket(pc: i64) -> i64 {
    var tab: i64 = pe_pf_tab;
    var m: i64 = pe_pf_m;
    if pc < pe_load(tab) {
        return m;
    }
    if pc >= pe_load(tab + m * 16) {
        return m + 1;
    }
    var lo: i64 = 0;
    var hi: i64 = m - 1;
    while lo < hi {
        var mid: i64 = (lo + hi + 1) / 2;
        if pe_load(tab + mid * 16) <= pc {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    // The entry point is outside the program's functions. Its row's own
    // name says so: a bucket cached in a `var` could be lost, as a
    // non-constant initializer runs again when main starts (lower.fd's
    // global_inits), after the boot hook's setup (known-bugs 2g.101).
    if pe_pf_name_is(pe_load(tab + lo * 16 + 8), "__fid_entry") {
        return m + 1;
    }
    return lo;
}

/// Bucket b is on the stack of sample `stamp`: counted once per sample.
fn pe_pf_note(b: i64, stamp: i64) {
    if pe_load(pe_pf_stamp + b * 8) != stamp {
        pe_store(pe_pf_stamp + b * 8, stamp);
        pe_store(pe_pf_total + b * 8, pe_load(pe_pf_total + b * 8) + 1);
    }
}

/// The function at `at` starts with pe_ir's frame prologue: push rbp;
/// mov rbp, rsp (55 48 89 E5).
fn pe_pf_framed(at: i64) -> bool {
    return pe_pf_ldb(at) == 85 && pe_pf_ldb(at + 1) == 72 && pe_pf_ldb(at + 2) == 137 && pe_pf_ldb(at + 3) == 229;
}

// FID_PROF=folded (llvm-roadmap DB9): whole stacks instead of the table,
// as linux_runtime/sys.fd. A sample's stack (its buckets, innermost first,
// at most PE_PF_FDEPTH) is hashed and counted in a table of PE_PF_STACKS
// slots made before sampling starts, [key][count][depth][bucket]*; only
// the sampler thread writes it. Printed root first, `main;work;fib 123`
// (flamegraph.pl, speedscope).
const PE_PF_STACKS: i64 = 4096;
const PE_PF_FDEPTH: i64 = 96;
const PE_PF_SLOT: i64 = 99;  // words per slot: 3 + PE_PF_FDEPTH
var pe_pf_stk: i64 = 0;  // the stack table (0: not folded)
var pe_pf_lost: i64 = 0;  // samples whose stack found no slot

/// FID_PROF's value v is "folded": the stack table, made once.
fn pe_pf_fold_init(v: i64) {
    if v == 0 || pe_pf_stk != 0 {
        return;
    }
    if pe_pf_ldb(v) != 102 || pe_pf_ldb(v + 1) != 111 || pe_pf_ldb(v + 2) != 108 || pe_pf_ldb(v + 3) != 100 {
        return;
    }
    if pe_pf_ldb(v + 4) != 101 || pe_pf_ldb(v + 5) != 100 || pe_pf_ldb(v + 6) != 0 {
        return;
    }
    pe_pf_stk = pe_zeroed(PE_PF_STACKS * PE_PF_SLOT);
}

/// Every stack back to 0.
fn pe_pf_fold_clear() {
    if pe_pf_stk == 0 {
        return;
    }
    var i: i64 = 0;
    while i < PE_PF_STACKS {
        var s: i64 = pe_pf_stk + i * PE_PF_SLOT * 8;
        pe_store(s, 0);
        pe_store(s + 8, 0);
        pe_store(s + 16, 0);
        i = i + 1;
    }
    pe_pf_lost = 0;
}

/// The stack of one sample, walked as pe_pf_tick walks it (the bucket of
/// pc, the caller of a frameless function or a prologue, each frame
/// record's caller inside the thread's stack), at most PE_PF_FDEPTH
/// buckets. slot 0: its key (a hash, > 0); else its buckets written at
/// slot + 24 and their count.
@wrapping
fn pe_pf_chain(pc: i64, fp0: i64, sp: i64, teb: i64, slot: i64) -> i64 {
    var m: i64 = pe_pf_m;
    var h: i64 = 1469598103934665603;
    var b: i64 = pe_pf_bucket(pc);
    if slot != 0 {
        pe_store(slot + 24, b);
    }
    h = (h ^ (b + 1)) * 1099511628211;
    var d: i64 = 1;
    var hi: i64 = 0;
    var lo: i64 = 0;
    if teb != 0 {
        hi = pe_load(teb + 8);
        lo = pe_load(teb + 16);
    }
    if teb != 0 && hi != 0 && sp >= lo && sp + 16 <= hi && (sp & 7) == 0 {
        var start: i64 = 0;
        if b < m {
            start = pe_load(pe_pf_tab + b * 16);
        }
        if b >= m || !pe_pf_framed(start) || pc < start + 4 {
            var ret: i64 = pe_load(sp);
            if b < m && pc > start && pc < start + 4 {
                ret = pe_load(sp + 8);
            }
            var lb: i64 = pe_pf_bucket(ret - 1);
            if lb < m {
                if slot != 0 {
                    pe_store(slot + 24 + d * 8, lb);
                }
                h = (h ^ (lb + 1)) * 1099511628211;
                d = d + 1;
            }
        }
        var fp: i64 = fp0;
        var low: i64 = sp;
        var k: i64 = 0;
        while fp != 0 && (fp & 7) == 0 && fp >= low && fp + 16 <= hi && k < PE_PF_DEPTH && d < PE_PF_FDEPTH {
            var rb: i64 = pe_pf_bucket(pe_load(fp + 8) - 1);
            if rb < m {
                if slot != 0 {
                    pe_store(slot + 24 + d * 8, rb);
                }
                h = (h ^ (rb + 1)) * 1099511628211;
                d = d + 1;
            }
            low = fp + 8;
            fp = pe_load(fp);
            k = k + 1;
        }
    }
    if slot != 0 {
        return d;
    }
    h = h ^ d;
    return (h & 0x7FFFFFFFFFFFFFFF) | 1;
}

/// Count one sample's stack in the stack table (the sampler thread, the
/// thread still suspended: no allocation).
fn pe_pf_fold(pc: i64, fp: i64, sp: i64, teb: i64) {
    var key: i64 = pe_pf_chain(pc, fp, sp, teb, 0);
    var i: i64 = 0;
    while i < PE_PF_STACKS {
        var s: i64 = pe_pf_stk + ((key + i) & (PE_PF_STACKS - 1)) * PE_PF_SLOT * 8;
        var k: i64 = pe_load(s);
        if k == 0 {
            var d: i64 = pe_pf_chain(pc, fp, sp, teb, s);
            pe_store(s + 8, 1);
            pe_store(s, key);
            pe_store(s + 16, d);
            return;
        }
        if k == key {
            pe_store(s + 8, pe_load(s + 8) + 1);
            return;
        }
        i = i + 1;
    }
    pe_pf_lost = pe_pf_lost + 1;
}

/// The name of bucket b.
fn pe_pf_bucket_name(b: i64) -> str {
    if b < pe_pf_m {
        return p_str_from_ptr(pe_load(pe_pf_tab + b * 16 + 8));
    }
    if b == pe_pf_m {
        return "(runtime primitives)";
    }
    return "(outside the functions)";
}

/// FID_PROF=folded: every stack sampled, root first, and its samples, one
/// line each, to stderr.
fn pe_pf_print_folded() {
    var out: str = "";
    var i: i64 = 0;
    while i < PE_PF_STACKS {
        var s: i64 = pe_pf_stk + i * PE_PF_SLOT * 8;
        var d: i64 = pe_load(s + 16);
        var c: i64 = pe_load(s + 8);
        if d > 0 && c > 0 {
            var line: str = "";
            var j: i64 = d - 1;
            while j >= 0 {
                line = line + pe_pf_bucket_name(pe_load(s + 24 + j * 8));
                if j > 0 {
                    line = line + ";";
                }
                j = j - 1;
            }
            out = out + line + " " + int_to_str(c) + "\n";
        }
        i = i + 1;
    }
    if pe_pf_lost > 0 {
        out = out + "(more stacks than the table holds) " + int_to_str(pe_pf_lost) + "\n";
    }
    p_eprint_str(out);
}

/// One sample of a suspended thread from its registers. Reads only its
/// stack, inside [StackLimit, StackBase) of its TEB.
fn pe_pf_tick(pc: i64, fp0: i64, sp: i64, teb: i64) {
    if pe_pf_stk != 0 {
        pe_pf_fold(pc, fp0, sp, teb);
    }
    pe_pf_n = pe_pf_n + 1;
    var stamp: i64 = pe_pf_n;
    var m: i64 = pe_pf_m;
    var b: i64 = pe_pf_bucket(pc);
    pe_store(pe_pf_self + b * 8, pe_load(pe_pf_self + b * 8) + 1);
    pe_pf_note(b, stamp);
    if teb == 0 {
        return;
    }
    var hi: i64 = pe_load(teb + 8);
    var lo: i64 = pe_load(teb + 16);
    // mid-switch between two stacks, or no stack known: the pc only
    if hi == 0 || sp < lo || sp + 16 > hi || (sp & 7) != 0 {
        return;
    }
    // A function without a frame, or the pc still in the prologue: its
    // caller's return address is on top of the stack (a word higher once
    // rbp is pushed), and rbp is still the caller's
    var start: i64 = 0;
    if b < m {
        start = pe_load(pe_pf_tab + b * 16);
    }
    if b >= m || !pe_pf_framed(start) || pc < start + 4 {
        var ret: i64 = pe_load(sp);
        if b < m && pc > start && pc < start + 4 {
            ret = pe_load(sp + 8);
        }
        var lb: i64 = pe_pf_bucket(ret - 1);
        if lb < m {
            pe_pf_note(lb, stamp);
        }
    }
    // The frame records ([rbp] the caller's rbp, [rbp + 8] the return
    // address), upwards on this stack, at most PE_PF_DEPTH of them
    var fp: i64 = fp0;
    var low: i64 = sp;
    var k: i64 = 0;
    while fp != 0 && (fp & 7) == 0 && fp >= low && fp + 16 <= hi && k < PE_PF_DEPTH {
        var rb: i64 = pe_pf_bucket(pe_load(fp + 8) - 1);
        if rb < m {
            pe_pf_note(rb, stamp);
        }
        low = fp + 8;
        fp = pe_load(fp);
        k = k + 1;
    }
}

/// Suspend thread h, count a sample of it, resume it. ctx: a CONTEXT,
/// 16-byte aligned (Rsp at 0x98, Rbp at 0xA0, Rip at 0xF8).
fn pe_pf_sample(h: i64, teb: i64, ctx: i64) {
    if (pe_pf_suspend(h) & 4294967295) == 4294967295 {
        return;
    }
    // ContextFlags: CONTEXT_AMD64 | CONTROL | INTEGER
    pe_store(ctx + 48, 1048579);
    if pe_pf_get_context(h, ctx) != 0 {
        pe_pf_tick(pe_load(ctx + 248), pe_load(ctx + 160), pe_load(ctx + 152), teb);
    }
    pe_pf_resume(h);
}

/// One look at every registered thread: a sample of each that ran since
/// the last look (after a start, the first look only notes the counts).
fn pe_pf_round(ctx: i64, cyc: i64) {
    var prime: bool = pe_pf_prime != 0;
    pe_pf_prime = 0;
    var n: i64 = nat_atomic_load(pe_pf_tcount);
    if n > PE_PF_MAXT {
        n = PE_PF_MAXT;
    }
    var i: i64 = 0;
    while i < n && pe_pf_on != 0 {
        var rec: i64 = pe_pf_threads + i * 32;
        var h: i64 = nat_atomic_load(rec);
        if h != 0 && pe_pf_cycles(h, cyc) != 0 {
            var c: i64 = pe_load(cyc);
            if c != pe_load(rec + 16) {
                pe_store(rec + 16, c);
                if !prime {
                    pe_pf_sample(h, pe_load(rec + 8), ctx);
                }
            }
        }
        i = i + 1;
    }
}

/// The sampler thread: a round every millisecond while the profiler is on
/// (the timer resolution raised to 0.5 ms, as win.fd's), every 20 ms a
/// look whether it is on again.
pub fn pert_prof_sampler_main(id: i64) -> i64 {
    var actual: i64 = pe_zeroed(1);
    pe_pf_timer_res(5000, 1, actual);
    p_free(actual);
    var raw: i64 = p_malloc(1232 + 16);
    var ctx: i64 = (raw + 15) & (0 - 16);
    var cyc: i64 = pe_zeroed(1);
    var alive: bool = true;
    while alive {
        if pe_pf_on == 0 {
            pe_k_sleep(20);
        } else {
            pe_k_sleep(1);
            if pe_pf_on != 0 && pe_pf_threads != 0 {
                pe_pf_round(ctx, cyc);
            }
        }
    }
    return 0;
}

/// The decimal number at environment string v (0 when not set).
fn pe_pf_env_num(v: i64) -> i64 {
    var r: i64 = 0;
    if v == 0 {
        return 0;
    }
    var i: i64 = 0;
    while i < 9 && pe_pf_ldb(v + i) >= 48 && pe_pf_ldb(v + i) <= 57 {
        r = r * 10 + (pe_pf_ldb(v + i) - 48);
        i = i + 1;
    }
    return r;
}

/// The watcher thread: the report on request (the named event
/// Local\fid-prof-<pid>, Ctrl-Break) and every FID_PROF_EVERY seconds.
/// The periodic reports keep their own schedule on the monotonic clock
/// (GetTickCount64): one asked for in between does not move the next.
pub fn pert_prof_watch_main(id: i64) -> i64 {
    var every: i64 = pe_pf_env_num(pe_c_getenv("FID_PROF_EVERY") as i64);
    // auto-reset, not set
    var ev: i64 = pe_pf_create_event(0, 0, 0, "Local\\fid-prof-" + int_to_str(pe_k_getpid()));
    var period: i64 = every * 1000;
    var next: i64 = pe_k_ticks() + period;
    var alive: bool = true;
    while alive {
        // wait at most 100 ms (Ctrl-Break's flag is looked at that often),
        // and not past the next periodic report
        var wait_ms: i64 = 100;
        if period > 0 {
            var left: i64 = next - pe_k_ticks();
            if left < 0 {
                left = 0;
            }
            if left < wait_ms {
                wait_ms = left;
            }
        }
        var hit: bool = false;
        if ev != 0 {
            if (pe_k_wait(ev, wait_ms) as i64) == 0 {
                hit = true;
            }
        } else {
            pe_k_sleep(wait_ms);
        }
        var due: bool = false;
        if period > 0 {
            var now: i64 = pe_k_ticks();
            if now >= next {
                due = true;
                // the next one a period later; past ones (a stalled
                // watcher) are not made up
                next = next + period;
                if next <= now {
                    next = now + period;
                }
            }
        }
        if hit || pe_pf_req != 0 || due {
            pe_pf_req = 0;
            if pe_pf_on != 0 {
                pe_pf_print();
            }
        }
    }
    return 0;
}

/// Start OS thread `entry(0)` (as pe_co_ensure starts its workers).
fn pe_pf_spawn(entry: i64) -> bool {
    var block: i64 = pe_zeroed(14);
    pe_store(block, entry);
    pe_store(block + 8, 1);
    pe_store(block + 16, 0);
    var h: i64 = pe_k_create_thread(0, 0, pe_thread_entry_addr(), block, 0, 0);
    if h == 0 {
        return false;
    }
    pe_k_close_handle(h);
    return true;
}

/// Start counting (from 0) on every registered thread and the calling
/// one: 0, or -1 when the image has no function table or no thread could
/// be started.
fn pe_pf_begin() -> i64 {
    if !pe_pf_setup() {
        return 0 - 1;
    }
    pe_pf_add_self();
    pe_pf_on = 0;
    pe_pf_clear();
    // DB9: FID_PROF=folded keeps whole stacks
    pe_pf_fold_init(pe_c_getenv("FID_PROF") as i64);
    pe_pf_fold_clear();
    pe_pf_prime = 1;
    if pe_pf_up == 0 {
        pe_pf_sampler_fn = pe_fn_lookup("pert_prof_sampler_main");
        pe_pf_watch_fn = pe_fn_lookup("pert_prof_watch_main");
        if pe_pf_sampler_fn == 0 || !pe_pf_spawn(pe_pf_sampler_fn) {
            return 0 - 1;
        }
        if pe_pf_watch_fn != 0 {
            pe_pf_spawn(pe_pf_watch_fn);
        }
        // Ctrl-Break asks for the report (base.fd pe_console_ctrl)
        if pert_sig_installed == 0 {
            if pe_k_set_ctrl_handler(pe_console_ctrl, 1) != 0 {
                pert_sig_installed = 1;
            }
        }
        pe_pf_up = 1;
    }
    pe_pf_on = 1;
    return 0;
}

/// Bucket a goes before bucket b in the report: more self samples, then
/// more total ones.
fn pe_pf_before(a: i64, b: i64) -> bool {
    var sa: i64 = pe_load(pe_pf_self + a * 8);
    var sb: i64 = pe_load(pe_pf_self + b * 8);
    if sa != sb {
        return sa > sb;
    }
    return pe_load(pe_pf_total + a * 8) > pe_load(pe_pf_total + b * 8);
}

/// v right-aligned in `width` columns.
fn pe_pf_num(v: i64, width: i64) -> str {
    var s: str = int_to_str(v);
    while str_len(s) < width {
        s = " " + s;
    }
    return s;
}

/// v of n as a percentage with one decimal, in 8 columns.
fn pe_pf_pct(v: i64, n: i64) -> str {
    var p: i64 = v * 1000 / n;
    return pe_pf_num(p / 10, 6) + "." + int_to_str(p % 10);
}

/// The table of the samples so far, most self time first, at most 40
/// lines (to stderr; the format of linux_runtime/sys.fd pe_prof_print).
fn pe_pf_print() {
    if pe_pf_stk != 0 {
        pe_pf_print_folded();
        return;
    }
    var n: i64 = pe_pf_n;
    var m: i64 = pe_pf_m;
    p_eprint_str("profile (FID_PROF): " + int_to_str(n) + " samples, one per ms of CPU time\n");
    if n == 0 || m == 0 {
        return;
    }
    var out: str = "   self%     self  total%    total  function\n";
    var shown: i64 = pe_zeroed(m + 2);
    var row: i64 = 0;
    while row < 40 {
        var best: i64 = 0 - 1;
        var b: i64 = 0;
        while b < m + 2 {
            if pe_load(shown + b * 8) == 0 && (pe_load(pe_pf_self + b * 8) > 0 || pe_load(pe_pf_total + b * 8) > 0) {
                if best < 0 || pe_pf_before(b, best) {
                    best = b;
                }
            }
            b = b + 1;
        }
        if best < 0 {
            row = 40;
        } else {
            pe_store(shown + best * 8, 1);
            var s: i64 = pe_load(pe_pf_self + best * 8);
            var t: i64 = pe_load(pe_pf_total + best * 8);
            var name: str = "(outside the functions)";
            if best < m {
                name = p_str_from_ptr(pe_load(pe_pf_tab + best * 16 + 8));
            } else if best == m {
                name = "(runtime primitives)";
            }
            out = out + pe_pf_pct(s, n) + pe_pf_num(s, 9) + pe_pf_pct(t, n) + pe_pf_num(t, 9) + "  " + name + "\n";
            row = row + 1;
        }
    }
    p_free(shown);
    p_eprint_str(out);
}

/// The NUL-terminated name at p is s.
fn pe_pf_name_is(p: i64, s: str) -> bool {
    var n: i64 = str_len(s);
    var i: i64 = 0;
    while i < n {
        if pe_pf_ldb(p + i) != str_byte_at(s, i) {
            return false;
        }
        i = i + 1;
    }
    return pe_pf_ldb(p + n) == 0;
}

/// Before main (the entry point): FID_PROF set, not empty and not "0",
/// starts the profiler on the main thread.
pub fn pert_prof_boot() {
    var v: i64 = pe_c_getenv("FID_PROF") as i64;
    if v == 0 || pe_pf_ldb(v) == 0 {
        return;
    }
    if pe_pf_ldb(v) == 48 && pe_pf_ldb(v + 1) == 0 {
        return;
    }
    pe_pf_begin();
}

/// At exit: the profiler stopped and its report printed, when it is on.
fn pe_pf_at_exit() {
    if pe_pf_on == 0 {
        return;
    }
    pe_pf_on = 0;
    pe_k_sleep(2);
    pe_pf_print();
}

/// After main returns (the entry point): the report; main's result back.
pub fn pert_prof_exit(code: i64) -> i64 {
    pe_pf_at_exit();
    return code;
}

/// p_prof_start(): count samples from now on (earlier ones are dropped):
/// 0, or -1 when this program cannot be sampled.
pub fn pert_prof_start() -> i64 {
    return pe_pf_begin();
}

/// p_prof_stop(): stop counting; the samples taken.
pub fn pert_prof_stop() -> i64 {
    if pe_pf_on != 0 {
        pe_pf_on = 0;
        // a round in progress ends within it
        pe_k_sleep(2);
    }
    return pe_pf_n;
}

/// p_prof_report(): the profile so far on stderr; the samples taken.
pub fn pert_prof_report() -> i64 {
    pe_pf_print();
    return pe_pf_n;
}

/// p_prof_samples(name): the samples with function `name` on the stack.
pub fn pert_prof_samples(name: str) -> i64 {
    var m: i64 = pe_pf_m;
    var r: i64 = 0;
    var b: i64 = 0;
    while b < m {
        if pe_pf_name_is(pe_load(pe_pf_tab + b * 16 + 8), name) {
            r = r + pe_load(pe_pf_total + b * 8);
        }
        b = b + 1;
    }
    return r;
}

// ─── Run-time resource limits (roadmap P12) ─────────────────────────────
// Native Windows (pe_ir), as the C runtime's (codegen_c.fd
// emit_limits_runtime) and linux_runtime/sys.fd's: read before main by
// pert_limits_boot (the entry point calls it, as it calls pert_prof_boot:
// compiler/pe_ir_stubs.fd, see docs/reference/runtime-limits.md).
//   FID_MEM_LIMIT=<bytes>[K|M|G]: the live bytes of the heap. pe_ir's
//     p_malloc / p_free are machine code (pe_ir_stubs.fd PeirGen_gen_malloc
//     / gen_free): they call pert_lim_take(block bytes) and
//     pert_lim_give(block bytes), which return at once with no limit set;
//     past the limit "fid: memory limit of N bytes exceeded (FID_MEM_LIMIT):
//     U bytes in use, A more asked for", exit code 125.
//   FID_CPU_LIMIT=<seconds>: user plus kernel time of the whole process: a
//     thread reads GetProcessTimes every 10 ms; past it "fid: CPU time
//     limit of S seconds exceeded (FID_CPU_LIMIT)", exit code 124.
// Unset, empty or 0: no limit; a value that is not a number: exit code 2.
// Nothing here allocates once the program runs (the messages are written
// with WriteFile from a scratch block made at boot), so a stop inside
// p_malloc does not call p_malloc again.

extern "C" link "kernel32.dll" {
    fn GetProcessTimes as pe_lim_times(proc: i64, created: i64, exited: i64, kernel: i64, user: i64) -> i32;
    fn GetCurrentProcess as pe_lim_self() -> i64;
    fn TerminateProcess as pe_lim_kill(proc: i64, code: i64) -> i32;
}

var pe_lim_mem: i64 = 0;  // bytes; 0: no memory limit
var pe_lim_used: i64 = 0;  // *i64: the live counted bytes (atomic)
var pe_lim_cpu: i64 = 0;  // CPU time limit in 100 ns units; 0: none
var pe_lim_cpu_text: i64 = 0;  // FID_CPU_LIMIT's text, for the message
var pe_lim_scratch: i64 = 0;  // [0, 8) WriteFile's count, [8, 40) digits

/// <digits>[.digits]; with `units`, then K, M or G (and a B), the value in
/// bytes; without, in units of 100 ns (seconds). 0 for an empty string, -1
/// when it is not a number (or too large).
fn pe_lim_parse(s: i64, units: bool) -> i64 {
    if pe_byte_at(s, 0) == 0 {
        return 0;
    }
    var i: i64 = 0;
    var whole: i64 = 0;
    var digits: i64 = 0;
    while pe_byte_at(s, i) >= 48 && pe_byte_at(s, i) <= 57 {
        if whole > 1000000000000000 {
            return 0 - 1;
        }
        whole = whole * 10 + (pe_byte_at(s, i) - 48);
        i = i + 1;
        digits = digits + 1;
    }
    var frac: i64 = 0;  // millionths
    if pe_byte_at(s, i) == 46 {
        i = i + 1;
        var scale: i64 = 100000;
        while pe_byte_at(s, i) >= 48 && pe_byte_at(s, i) <= 57 {
            frac = frac + (pe_byte_at(s, i) - 48) * scale;
            scale = scale / 10;
            i = i + 1;
            digits = digits + 1;
        }
    }
    if digits == 0 {
        return 0 - 1;
    }
    if !units {
        if pe_byte_at(s, i) != 0 || whole > 900000000000 {
            return 0 - 1;
        }
        return whole * 10000000 + frac * 10;
    }
    var mult: i64 = 1;
    var c: i64 = pe_byte_at(s, i);
    if c == 75 || c == 107 {
        mult = 1024;
        i = i + 1;
    } else if c == 77 || c == 109 {
        mult = 1048576;
        i = i + 1;
    } else if c == 71 || c == 103 {
        mult = 1073741824;
        i = i + 1;
    }
    if pe_byte_at(s, i) == 66 || pe_byte_at(s, i) == 98 {
        i = i + 1;
    }
    if pe_byte_at(s, i) != 0 || whole > 9223372036854775807 / mult / 2 {
        return 0 - 1;
    }
    var v: i64 = whole * mult + (frac / 1000) * mult / 1000;
    if v == 0 && (whole != 0 || frac != 0) {
        v = 1;
    }
    return v;
}

/// The literal text at s to stderr (no allocation).
fn pe_lim_say(s: i64) {
    pe_cr_puts(pe_k_std_handle(0 - 12), pe_lim_scratch, s);
}

/// A malformed limit: stderr says so, exit code 2.
fn pe_lim_bad(name: i64, v: i64, kind: i64) {
    pe_lim_say("fid: " as i64);
    pe_lim_say(name);
    pe_lim_say(kind);
    pe_lim_say(v);
    pe_lim_say("'\n" as i64);
    pe_k_exit_process(2);
}

/// Before main (the entry point): FID_MEM_LIMIT and FID_CPU_LIMIT, and
/// FID_MEM_RETURN (RT7, pert_alloc_trim).
pub fn pert_limits_boot() {
    var mr: i64 = pe_c_getenv("FID_MEM_RETURN") as i64;
    if mr != 0 && pe_byte_at(mr, 0) == 48 && pe_byte_at(mr, 1) == 0 {
        pe_al_keep = 1;
    }
    pe_lim_scratch = pe_zeroed(8);
    var m: i64 = pe_c_getenv("FID_MEM_LIMIT") as i64;
    if m != 0 {
        var mv: i64 = pe_lim_parse(m, true);
        if mv < 0 {
            pe_lim_bad("FID_MEM_LIMIT" as i64, m, " is not a size (bytes, or with K, M or G): '" as i64);
        }
        if mv > 0 {
            pe_lim_used = pe_zeroed(1);
            pe_lim_mem = mv;
        }
    }
    var t: i64 = pe_c_getenv("FID_CPU_LIMIT") as i64;
    if t == 0 {
        return;
    }
    var cv: i64 = pe_lim_parse(t, false);
    if cv < 0 {
        pe_lim_bad("FID_CPU_LIMIT" as i64, t, " is not a number of seconds: '" as i64);
    }
    if cv == 0 {
        return;
    }
    pe_lim_cpu_text = t;
    pe_lim_cpu = cv;
    var entry: i64 = pe_fn_lookup("pert_lim_watch_main");
    if entry == 0 || !pe_pf_spawn(entry) {
        pe_lim_cpu = 0;
    }
}

/// The CPU watcher's thread: every 10 ms, the process's CPU time.
pub fn pert_lim_watch_main(arg: i64) -> i64 {
    var ft: i64 = pe_zeroed(4);
    while true {
        if pe_lim_times(pe_lim_self(), ft, ft + 8, ft + 16, ft + 24) != 0 {
            if pe_load(ft + 16) + pe_load(ft + 24) >= pe_lim_cpu {
                pe_lim_say("fid: CPU time limit of " as i64);
                pe_lim_say(pe_lim_cpu_text);
                pe_lim_say(" seconds exceeded (FID_CPU_LIMIT)\n" as i64);
                pe_lim_kill(pe_lim_self(), 124);
                pe_k_exit_process(124);
            }
        }
        pe_k_sleep(10);
    }
    return 0;
}

/// p_malloc (machine code) takes a block of n bytes: with FID_MEM_LIMIT
/// set, past the limit the program stops (exit code 125). Returns 0.
pub fn pert_lim_take(n: i64) -> i64 {
    if pe_lim_mem == 0 {
        return 0;
    }
    var before: i64 = nat_atomic_add(pe_lim_used, n);
    if before + n > pe_lim_mem {
        nat_atomic_add(pe_lim_used, 0 - n);
        var h: i64 = pe_k_std_handle(0 - 12);
        pe_lim_say("fid: memory limit of " as i64);
        pe_cr_put_int(h, pe_lim_scratch, pe_lim_scratch + 8, pe_lim_mem);
        pe_lim_say(" bytes exceeded (FID_MEM_LIMIT): " as i64);
        pe_cr_put_int(h, pe_lim_scratch, pe_lim_scratch + 8, before);
        pe_lim_say(" bytes in use, " as i64);
        pe_cr_put_int(h, pe_lim_scratch, pe_lim_scratch + 8, n);
        pe_lim_say(" more asked for\n" as i64);
        pe_k_exit_process(125);
    }
    return 0;
}

/// p_free (machine code) gives a block of n bytes back.
pub fn pert_lim_give(n: i64) -> i64 {
    if pe_lim_mem == 0 {
        return 0;
    }
    nat_atomic_add(pe_lim_used, 0 - n);
    return 0;
}

// ─── Freed memory back to the system (competitive RT7) ──────────────────
// pe_ir's p_malloc / p_free are machine code (compiler/pe_ir_stubs.fd
// PeirGen_gen_malloc / gen_free); the slow parts are here, as the C
// runtime's __p_mem_trim (codegen_c.fd emit_mem_return_runtime) and
// linux_runtime/base.fd pe_trim. None of them allocates: they run inside
// p_malloc / p_free.
//   - A thread bumps blocks of 16 bytes to 1 MB out of a chunk of its own:
//     4 MB, aligned to 4 MB (8 MB reserved, the aligned half committed), so
//     a block's chunk is its address rounded down. Header of a chunk (128
//     bytes): [0] "FIDCHUNK" [8] the reservation [16] bytes handed out
//     (set when it stops being a thread's chunk) [24] 1 while it is one
//     [32] next [40] previous (the list of chunks, at st + 384) [48] the
//     trim's sum [56] the trim's mark [64] its owner slot (RT8).
//   - A thread's list array (512 bytes, its TLS slot, release H8): the free
//     lists of classes 7..40 at class * 8, then [384] bump cursor [392]
//     bump end [400] its chunk [408] bytes on its lists (resident: without
//     the pages a trim took out of big blocks) [416] the next trim.
//   - p_free past [416] calls pert_alloc_trim: under the lock (st + 376, an
//     SRW lock), the chunks whose every handed-out byte is on this thread's
//     lists (none of them any thread's chunk) are taken off the lists and
//     released (MEM_RELEASE), but 2 such empty chunks kept; free blocks of
//     256 KB and more lose their inside pages (MEM_DECOMMIT; the page of
//     their header and list link stays: header bit 7 says so, p_malloc
//     calls pert_alloc_recommit before it reuses one). A block freed by
//     another thread is on that thread's lists, so its chunk is not empty
//     for this one: a chunk is never released while a block of it is in
//     use or on another thread's list. Next trim: what is left plus a
//     quarter, at least 8 MB.
//   - An OS thread that ends (pert_thread_main) gives its chunk up and its
//     lists to a pool (st + 392) that the next thread to trim adopts.
//   - FID_MEM_RETURN=0 (read by pert_limits_boot): no trim, nothing
//     decommitted (large blocks go back with HeapFree either way).
//   - Owner return (RT8, Nov 22): a chunk belongs to the thread that bumps
//     blocks out of it; its header's [64] is that thread's owner slot, a
//     word of the slot table (st + 408, PE_AL_OWNERS_N words, made with
//     the first chunk; word 0 is the pool's slot). p_free of a block whose
//     chunk's slot is not this thread's pushes the block on that slot (an
//     atomic list: lock cmpxchg on the slot, the block's first word the
//     link) and does nothing else; the owner takes the whole list (an
//     exchange) when a class it asks for has no free block, before it
//     bumps, and at each trim, and puts the blocks on its lists, where
//     they are counted. A slot reads 0 (empty), 1 (closed: its thread
//     ended) or the newest block. An ending thread (pert_alloc_thread_end)
//     gives its chunks the pool's slot, then closes its own and takes what
//     was on it: a free that finds a slot closed reads the chunk's slot
//     again and pushes on the pool's, which the next trim takes with the
//     pool's lists, so the chunks of a thread that ended can still be
//     found empty and released. A closed slot goes to the next thread that
//     needs one. Blocks on a slot are on no thread's lists: a trim never
//     releases their chunk. A thread with no slot (the table full) has
//     chunks whose blocks anyone frees into their own lists, as before.
//     The list array's [424] is the thread's slot (its address; 0: none).
//   - st + 400 (written by p_malloc's machine code): the offset in the TEB
//     of the list arrays' TLS slot when its index is below 64, so p_malloc
//     and p_free read the array with one gs: load (0: TlsGetValue).

extern "C" {
    // kernel32.dll (static import list, pe_ir_enc.fd pe_kernel32_imports)
    fn GetProcessHeap as pe_al_heap() -> i64;
    fn HeapFree as pe_al_heap_free(heap: i64, flags: i64, p: i64) -> i32;
}

const PE_AL_CHUNK: i64 = 4194304;  // a chunk's bytes (and alignment)
const PE_AL_HDR: i64 = 128;  // its header; blocks follow
const PE_AL_ST_TLS: i64 = 32;  // allocator state: TLS index + 1 of the list arrays
const PE_AL_ST_LOCK: i64 = 376;  // the chunks' SRW lock
const PE_AL_ST_CHUNKS: i64 = 384;  // the newest chunk
const PE_AL_ST_POOL: i64 = 392;  // lists of ended threads (a list array)
const PE_AL_CUR: i64 = 384;  // list array: bump cursor
const PE_AL_END: i64 = 392;  // bump end
const PE_AL_OWN: i64 = 400;  // the thread's chunk
const PE_AL_FREE: i64 = 408;  // resident bytes on its lists
const PE_AL_NEXT: i64 = 416;  // trim when [408] passes it
const PE_AL_SLOT: i64 = 424;  // its owner slot's address (0: none)
const PE_AL_ST_OWNERS: i64 = 408;  // allocator state: the owner slot table
const PE_AL_ST_HI: i64 = 416;  // the highest slot given out
const PE_AL_OWNERS_N: i64 = 4096;  // slots in the table (0 is the pool's)
const PE_AL_C_OWNER: i64 = 64;  // chunk header: its owner slot
const PE_AL_C_RESV: i64 = 8;
const PE_AL_C_USED: i64 = 16;
const PE_AL_C_LIVE: i64 = 24;
const PE_AL_C_NEXT: i64 = 32;
const PE_AL_C_PREV: i64 = 40;
const PE_AL_C_SUM: i64 = 48;
const PE_AL_C_MARK: i64 = 56;
const PE_AL_FIRST: i64 = 7;  // the classes p_malloc makes
const PE_AL_LAST: i64 = 40;
const PE_AL_BIG: i64 = 36;  // 256 KB and more: decommitted when free
const PE_AL_GONE: i64 = 128;  // header bit: inside pages decommitted
const PE_AL_TRIM_MIN: i64 = 8388608;
const PE_AL_KEEP_EMPTY: i64 = 2;

var pe_al_st: i64 = 0;  // the allocator state (set by the first chunk)
var pe_al_keep: i64 = 0;  // 1: FID_MEM_RETURN=0

/// The bytes of a block of class c (as p_malloc makes them): 1 << (c / 2)
/// for an even c, three quarters of the next power of two for an odd one.
fn pe_al_bytes(c: i64) -> i64 {
    if c % 2 == 0 {
        return 1 << (c / 2);
    }
    return 3 << (c / 2 - 1);
}

/// The chunk of the block whose payload is at p.
fn pe_al_chunk_of(p: i64) -> i64 {
    return (p - 8) & (0 - PE_AL_CHUNK);
}

/// The first page a free block (payload p) can give back: the one after its
/// header and list link.
fn pe_al_lo(p: i64) -> i64 {
    return (p + 8 + 4095) & (0 - 4096);
}

/// The end of the last whole page of the block (payload p, n bytes with
/// its header).
fn pe_al_hi(p: i64, n: i64) -> i64 {
    return (p - 8 + n) & (0 - 4096);
}

/// Zero the words [a, b).
fn pe_al_zero(a: i64, b: i64) {
    var x: i64 = a;
    while x < b {
        pe_store(x, 0);
        x = x + 8;
    }
}

/// The chunk `c` stops being a thread's: its handed-out bytes are final
/// (under the lock).
fn pe_al_retire(c: i64, cur: i64) {
    pe_store(c + PE_AL_C_USED, cur - (c + PE_AL_HDR));
    pe_store(c + PE_AL_C_LIVE, 0);
}

/// The room left at the end of the thread's full chunk becomes free blocks
/// on its lists (the largest classes that fit), so the chunk is not left
/// with up to 1 MB nobody can use, and all of it can be found free.
fn pe_al_carve_tail(arr: i64) {
    var cur: i64 = pe_load(arr + PE_AL_CUR);
    val lim: i64 = pe_load(arr + PE_AL_END);
    var fb: i64 = pe_load(arr + PE_AL_FREE);
    while lim - cur >= 16 {
        var k: i64 = PE_AL_LAST;
        while pe_al_bytes(k) > lim - cur {
            k = k - 1;
        }
        val n: i64 = pe_al_bytes(k);
        pe_store(cur, 0xF1DE5B0000000000 | k);  // a freed block of class k
        pe_store(cur + 8, pe_load(arr + k * 8));
        pe_store(arr + k * 8, cur + 8);
        fb = fb + n;
        cur = cur + n;
    }
    pe_store(arr + PE_AL_FREE, fb);
    pe_store(arr + PE_AL_CUR, cur);
}

/// An owner slot for list array `arr` (under the lock): a closed one
/// again, else the next unused one; none (0) when the table is full or
/// cannot be made.
fn pe_al_take_slot(st: i64, arr: i64) {
    var tab: i64 = pe_load(st + PE_AL_ST_OWNERS);
    if tab == 0 {
        tab = pe_k_valloc(0, PE_AL_OWNERS_N * 8, 0x3000, 4);
        if tab == 0 {
            return;
        }
        pe_store(st + PE_AL_ST_OWNERS, tab);
    }
    val hi: i64 = pe_load(st + PE_AL_ST_HI);
    var k: i64 = 1;
    while k <= hi {
        // a closed slot stays 1 (a free never pushes on it) until the
        // lock's holder opens it again here
        if nat_atomic_load(tab + k * 8) == 1 {
            nat_atomic_store(tab + k * 8, 0);
            pe_store(arr + PE_AL_SLOT, tab + k * 8);
            return;
        }
        k = k + 1;
    }
    if hi + 1 < PE_AL_OWNERS_N {
        pe_store(st + PE_AL_ST_HI, hi + 1);
        nat_atomic_store(tab + (hi + 1) * 8, 0);
        pe_store(arr + PE_AL_SLOT, tab + (hi + 1) * 8);
    }
}

/// The blocks on owner slot `slot`, taken at once; the slot becomes `to`
/// (0: open and empty, 1: closed).
fn pe_al_slot_take(slot: i64, to: i64) -> i64 {
    var v: i64 = nat_atomic_load(slot);
    while nat_atomic_cas(slot, v, to) == false {
        v = nat_atomic_load(slot);
    }
    return v;
}

/// The blocks other threads freed onto `slot` go on the lists of `arr`
/// (each one's header says its class: their p_free wrote it); the slot
/// becomes `to`.
fn pe_al_drain(arr: i64, slot: i64, to: i64) {
    var b: i64 = pe_al_slot_take(slot, to);
    if b == 1 {
        return;
    }
    var fb: i64 = pe_load(arr + PE_AL_FREE);
    while b != 0 {
        val nb: i64 = pe_load(b);
        val k: i64 = pe_load(b - 8) & 63;
        pe_store(b, pe_load(arr + k * 8));
        pe_store(arr + k * 8, b);
        fb = fb + pe_al_bytes(k);
        b = nb;
    }
    pe_store(arr + PE_AL_FREE, fb);
}

/// p_malloc found no room in this thread's chunk (or it has none): a new
/// one for list array `arr`, its old one retired. 0 when the system has no
/// memory left. `st` is the allocator state in .rdata.
pub fn pert_alloc_chunk(st: i64, arr: i64) -> i64 {
    pe_al_st = st;
    var c: i64 = 0;
    // 8 MB reserved (MEM_RESERVE), the 4 MB-aligned half committed
    var r: i64 = pe_k_valloc(0, 2 * PE_AL_CHUNK, 0x2000, 4);
    if r != 0 {
        c = (r + PE_AL_CHUNK - 1) & (0 - PE_AL_CHUNK);
        if pe_k_valloc(c, PE_AL_CHUNK, 0x1000, 4) == 0 {
            pe_k_vfree(r, 0, 0x8000);
            c = 0;
        }
    }
    var old: i64 = pe_load(arr + PE_AL_OWN);
    if old != 0 {
        pe_al_carve_tail(arr);
    }
    pe_k_lock(st + PE_AL_ST_LOCK);
    if old != 0 {
        pe_al_retire(old, pe_load(arr + PE_AL_CUR));
    }
    pe_store(arr + PE_AL_CUR, 0);
    pe_store(arr + PE_AL_END, 0);
    pe_store(arr + PE_AL_OWN, 0);
    if c != 0 {
        if pe_load(arr + PE_AL_SLOT) == 0 {
            pe_al_take_slot(st, arr);
        }
        pe_store(c, 0x4B4E554843444946);  // "FIDCHUNK"
        pe_store(c + PE_AL_C_RESV, r);
        pe_store(c + PE_AL_C_USED, 0);
        pe_store(c + PE_AL_C_LIVE, 1);
        pe_store(c + PE_AL_C_OWNER, pe_load(arr + PE_AL_SLOT));
        var head: i64 = pe_load(st + PE_AL_ST_CHUNKS);
        pe_store(c + PE_AL_C_NEXT, head);
        pe_store(c + PE_AL_C_PREV, 0);
        if head != 0 {
            pe_store(head + PE_AL_C_PREV, c);
        }
        pe_store(st + PE_AL_ST_CHUNKS, c);
        pe_store(arr + PE_AL_CUR, c + PE_AL_HDR);
        pe_store(arr + PE_AL_END, c + PE_AL_CHUNK);
        pe_store(arr + PE_AL_OWN, c);
    }
    pe_k_unlock(st + PE_AL_ST_LOCK);
    if c == 0 {
        return 0;
    }
    return 1;
}

/// p_malloc reuses the free block at payload p (n bytes with its header)
/// whose inside pages a trim gave back: they are committed again (they read
/// zero), the bytes around them are zeroed. 0 when the system has no
/// memory left. The block is off the lists; [408] counted all n bytes off.
pub fn pert_alloc_recommit(arr: i64, p: i64, n: i64) -> i64 {
    val lo: i64 = pe_al_lo(p);
    val hi: i64 = pe_al_hi(p, n);
    if hi > lo {
        if pe_k_valloc(lo, hi - lo, 0x1000, 4) == 0 {
            return 0;
        }
        // those pages were not counted on the lists
        pe_store(arr + PE_AL_FREE, pe_load(arr + PE_AL_FREE) + (hi - lo));
        pe_al_zero(p, lo);
        pe_al_zero(hi, p - 8 + n);
    } else {
        pe_al_zero(p, p - 8 + n);
    }
    return 1;
}

/// The last block of the list that starts at b (not 0).
fn pe_al_tail(b: i64) -> i64 {
    var t: i64 = b;
    while pe_load(t) != 0 {
        t = pe_load(t);
    }
    return t;
}

/// Move the free lists of list array `from` in front of those of `to`
/// (under the lock): its blocks and their counted bytes.
fn pe_al_splice(from: i64, to: i64) {
    var k: i64 = PE_AL_FIRST;
    while k <= PE_AL_LAST {
        var b: i64 = pe_load(from + k * 8);
        if b != 0 {
            pe_store(pe_al_tail(b), pe_load(to + k * 8));
            pe_store(to + k * 8, b);
            pe_store(from + k * 8, 0);
        }
        k = k + 1;
    }
    pe_store(to + PE_AL_FREE, pe_load(to + PE_AL_FREE) + pe_load(from + PE_AL_FREE));
    pe_store(from + PE_AL_FREE, 0);
}

/// p_free put more than [416] bytes on the lists of `arr` (this thread's):
/// release its empty chunks, decommit its big free blocks, set the next
/// threshold. `st` is the allocator state.
pub fn pert_alloc_trim(st: i64, arr: i64) -> i64 {
    pe_al_st = st;
    if pe_al_keep != 0 {
        // FID_MEM_RETURN=0: never again
        pe_store(arr + PE_AL_NEXT, 9223372036854775807);
        return 0;
    }
    if pe_load(arr + PE_AL_NEXT) == 0 {
        // this thread's first free: the first threshold
        pe_store(arr + PE_AL_NEXT, PE_AL_TRIM_MIN);
        return 0;
    }
    pe_k_lock(st + PE_AL_ST_LOCK);
    // the lists of ended threads become this thread's
    val pool: i64 = pe_load(st + PE_AL_ST_POOL);
    if pool != 0 {
        pe_al_splice(pool, arr);
    }
    // RT8: what other threads freed of this thread's chunks, and of the
    // chunks of threads that ended (the pool's slot)
    val myslot: i64 = pe_load(arr + PE_AL_SLOT);
    if myslot != 0 {
        pe_al_drain(arr, myslot, 0);
    }
    val tab: i64 = pe_load(st + PE_AL_ST_OWNERS);
    if tab != 0 {
        pe_al_drain(arr, tab, 0);
    }
    // each chunk's bytes on this thread's lists
    var c: i64 = pe_load(st + PE_AL_ST_CHUNKS);
    while c != 0 {
        pe_store(c + PE_AL_C_SUM, 0);
        pe_store(c + PE_AL_C_MARK, 0);
        c = pe_load(c + PE_AL_C_NEXT);
    }
    var k: i64 = PE_AL_FIRST;
    while k <= PE_AL_LAST {
        val n: i64 = pe_al_bytes(k);
        var b: i64 = pe_load(arr + k * 8);
        while b != 0 {
            val ch: i64 = pe_al_chunk_of(b);
            pe_store(ch + PE_AL_C_SUM, pe_load(ch + PE_AL_C_SUM) + n);
            b = pe_load(b);
        }
        k = k + 1;
    }
    // empty: no thread's chunk, every byte it handed out on these lists
    var kept: i64 = 0;
    var any: bool = false;
    c = pe_load(st + PE_AL_ST_CHUNKS);
    while c != 0 {
        if pe_load(c + PE_AL_C_LIVE) == 0 && pe_load(c + PE_AL_C_SUM) == pe_load(c + PE_AL_C_USED) {
            if kept < PE_AL_KEEP_EMPTY {
                kept = kept + 1;
            } else {
                pe_store(c + PE_AL_C_MARK, 1);
                any = true;
            }
        }
        c = pe_load(c + PE_AL_C_NEXT);
    }
    // the blocks of those chunks off the lists; big free blocks' inside
    // pages back to the system
    var resident: i64 = pe_load(arr + PE_AL_FREE);
    k = PE_AL_FIRST;
    while k <= PE_AL_LAST {
        val n: i64 = pe_al_bytes(k);
        var link: i64 = arr + k * 8;
        var b: i64 = pe_load(link);
        while b != 0 {
            val nb: i64 = pe_load(b);
            val h: i64 = pe_load(b - 8);
            var gone: i64 = 0;
            if (h & PE_AL_GONE) != 0 {
                gone = pe_al_hi(b, n) - pe_al_lo(b);
            }
            if pe_load(pe_al_chunk_of(b) + PE_AL_C_MARK) != 0 {
                pe_store(link, nb);
                resident = resident - (n - gone);
            } else {
                if k >= PE_AL_BIG && gone == 0 {
                    val lo: i64 = pe_al_lo(b);
                    val hi: i64 = pe_al_hi(b, n);
                    if hi > lo && pe_k_vfree(lo, hi - lo, 0x4000) != 0 {
                        pe_store(b - 8, h | PE_AL_GONE);
                        resident = resident - (hi - lo);
                    }
                }
                link = b;
            }
            b = nb;
        }
        k = k + 1;
    }
    pe_store(arr + PE_AL_FREE, resident);
    // and the chunks themselves
    if any {
        c = pe_load(st + PE_AL_ST_CHUNKS);
        while c != 0 {
            val nc: i64 = pe_load(c + PE_AL_C_NEXT);
            if pe_load(c + PE_AL_C_MARK) != 0 {
                val pc: i64 = pe_load(c + PE_AL_C_PREV);
                if pc != 0 {
                    pe_store(pc + PE_AL_C_NEXT, nc);
                } else {
                    pe_store(st + PE_AL_ST_CHUNKS, nc);
                }
                if nc != 0 {
                    pe_store(nc + PE_AL_C_PREV, pc);
                }
                pe_k_vfree(pe_load(c + PE_AL_C_RESV), 0, 0x8000);
            }
            c = nc;
        }
    }
    pe_k_unlock(st + PE_AL_ST_LOCK);
    var next: i64 = resident + resident / 4;
    if next < PE_AL_TRIM_MIN {
        next = PE_AL_TRIM_MIN;
    }
    pe_store(arr + PE_AL_NEXT, next);
    return 0;
}

/// The OS thread running this ends (pert_thread_main): its chunk is retired
/// and its free lists go to the pool the next trim adopts; its list array
/// becomes the pool, or goes back to the heap.
pub fn pert_alloc_thread_end() {
    val st: i64 = pe_al_st;
    if st == 0 {
        return;
    }
    val ix: i64 = pe_load(st + PE_AL_ST_TLS) - 1;
    if ix < 0 {
        return;
    }
    val arr: i64 = pe_k_tls_get(ix);
    if arr == 0 {
        return;
    }
    pe_k_lock(st + PE_AL_ST_LOCK);
    val old: i64 = pe_load(arr + PE_AL_OWN);
    if old != 0 {
        pe_al_retire(old, pe_load(arr + PE_AL_CUR));
    }
    pe_store(arr + PE_AL_CUR, 0);
    pe_store(arr + PE_AL_END, 0);
    pe_store(arr + PE_AL_OWN, 0);
    // RT8: its chunks get the pool's slot first, then its own slot closes
    // (a free that finds it closed reads the chunk's slot again) and what
    // was on it joins its lists, which go to the pool
    val slot: i64 = pe_load(arr + PE_AL_SLOT);
    val tab: i64 = pe_load(st + PE_AL_ST_OWNERS);
    if slot != 0 && tab != 0 {
        var c: i64 = pe_load(st + PE_AL_ST_CHUNKS);
        while c != 0 {
            if pe_load(c + PE_AL_C_OWNER) == slot {
                nat_atomic_store(c + PE_AL_C_OWNER, tab);
            }
            c = pe_load(c + PE_AL_C_NEXT);
        }
        pe_al_drain(arr, slot, 1);
    }
    pe_store(arr + PE_AL_SLOT, 0);
    val pool: i64 = pe_load(st + PE_AL_ST_POOL);
    if pool == 0 {
        pe_store(arr + PE_AL_NEXT, 0);
        pe_store(st + PE_AL_ST_POOL, arr);
    } else {
        pe_al_splice(arr, pool);
    }
    pe_k_unlock(st + PE_AL_ST_LOCK);
    pe_k_tls_set(ix, 0);
    if pool != 0 {
        pe_al_heap_free(pe_al_heap(), 0, arr);
    }
}

// ─── Tensor-parallel ranks (roadmap P6) ─────────────────────────────────
// The OS half of tensor.fd "Tensor parallelism over several ranks", as the
// C runtime's Windows half (codegen_c.fd cg_emit_tp_runtime). p_tp_init(n)
// in rank 0 starts ranks 1..n-1 as copies of this program (CreateProcessA
// of GetModuleFileNameA with GetCommandLineA). A pipe each way between
// every pair of ranks, all made by rank 0 and not inheritable; a rank's
// own ends are made inheritable for its start alone and named in its
// FID_TP_LINKS ("b:in:out;" per other rank b, handles in decimal), so a
// rank holds only its own pipes and sees another rank's exit as the end of
// one. A started rank runs the program from the start with its standard
// output and error on NUL; at its p_tp_init (pe_tp_os_attach) it takes its
// links and the real output (FID_TP_STDIO "out:err"), so what the program
// prints before p_tp_init is printed by rank 0 alone. FID_TP_RANK and
// FID_TP_WORLD give the rank and the number of ranks; all four are removed
// from the environment once read (and from rank 0's once the ranks run).

// SAFETY: kernel32 functions pe_ir does not import by itself (`link`
// makes them extra imports, bound at start-up when the program calls
// them); prototypes as the Windows SDK's: handles and pointers are words,
// BOOL and DWORD results an i32.
extern "C" link "kernel32.dll" {
    fn CreatePipe as pe_tpw_pipe(rd_out: i64, wr_out: i64, sa: i64, size: i64) -> i32;
    fn SetHandleInformation as pe_tpw_set_info(h: i64, mask: i64, flags: i64) -> i32;
    fn GetModuleFileNameA as pe_tpw_module_name(module: i64, buf: i64, size: i64) -> i32;
    fn SetEnvironmentVariableA as pe_tpw_set_env(name: str, value: i64) -> i32;
    fn SetStdHandle as pe_tpw_set_std(which: i64, h: i64) -> i32;
}

// SAFETY: GetCommandLineA is on pe_ir's kernel32 list; it returns the
// process's command line, which this section only copies.
extern "C" {
    fn GetCommandLineA as pe_tpw_command_line() -> i64;
}

/// The decimal numbers in the NUL-ended string s, in order (any other
/// byte separates them).
fn pe_tpw_numbers(s: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    var cur: i64 = 0;
    var digits: i64 = 0;
    var going: bool = true;
    while going {
        var c: i64 = pe_byte_at(s, i);
        if c >= 48 && c <= 57 && digits < 18 {
            cur = cur * 10 + c - 48;
            digits = digits + 1;
        } else {
            if digits > 0 {
                v.push(cur);
            }
            cur = 0;
            digits = 0;
            if c == 0 {
                going = false;
            }
        }
        i = i + 1;
    }
    return v;
}

fn pe_tpw_env_clear() {
    pe_tpw_set_env("FID_TP_RANK", 0);
    pe_tpw_set_env("FID_TP_WORLD", 0);
    pe_tpw_set_env("FID_TP_LINKS", 0);
    pe_tpw_set_env("FID_TP_STDIO", 0);
}

/// The standard handle n (-10, -11, -12), 0 when there is none.
fn pe_tpw_std(n: i64) -> i64 {
    var h: i64 = pe_k_std_handle(n);
    if h == 0 - 1 {
        return 0;
    }
    return h;
}

/// A rank rank 0 started: take the links named in FID_TP_LINKS and the
/// real output. False in any other process.
fn pe_tp_os_attach() -> bool {
    var rs: i64 = pe_c_getenv("FID_TP_RANK") as i64;
    if rs == 0 {
        return false;
    }
    var ws: i64 = pe_c_getenv("FID_TP_WORLD") as i64;
    var ls: i64 = pe_c_getenv("FID_TP_LINKS") as i64;
    if ws == 0 || ls == 0 {
        return false;
    }
    var rv: Vec<i64> = pe_tpw_numbers(rs);
    var wv: Vec<i64> = pe_tpw_numbers(ws);
    if rv.len() != 1 || wv.len() != 1 {
        return false;
    }
    var rank: i64 = rv.get(0);
    var n: i64 = wv.get(0);
    if n < 2 || n > 32 || rank < 1 || rank >= n {
        return false;
    }
    var lv: Vec<i64> = pe_tpw_numbers(ls);
    var ss: i64 = pe_c_getenv("FID_TP_STDIO") as i64;
    var sv: Vec<i64> = Vec::new();
    if ss != 0 {
        sv = pe_tpw_numbers(ss);
    }
    pe_tpw_env_clear();
    if lv.len() != (n - 1) * 3 {
        p_panic("tp: this rank was started with broken FID_TP_LINKS");
    }
    var k: i64 = 0;
    while k + 2 < lv.len() {
        var b: i64 = lv.get(k);
        if b < 0 || b >= n || b == rank {
            p_panic("tp: this rank was started with broken FID_TP_LINKS");
        }
        pe_tpw_set_info(lv.get(k + 1), 1, 0);
        pe_tpw_set_info(lv.get(k + 2), 1, 0);
        pet_tp_set_link(b, lv.get(k + 1), lv.get(k + 2));
        k = k + 3;
    }
    if sv.len() == 2 {
        // the real output: rank 0's standard output and error
        var mute: i64 = pe_tpw_std(0 - 11);
        pe_tpw_set_std(0 - 11, sv.get(0));
        pe_tpw_set_std(0 - 12, sv.get(1));
        if mute != 0 && mute != sv.get(0) && mute != sv.get(1) {
            pe_k_close_handle(mute);
        }
    }
    pet_tp_joined(rank, n, 0);
    return true;
}

/// Rank 0: start ranks 1..n-1 with their pipes.
fn pe_tp_os_spawn(n: i64) -> bool {
    var nn: i64 = n * n;
    var rd: i64 = p_malloc(nn * 8);
    var wr: i64 = p_malloc(nn * 8);
    pe_px_zero(rd, nn * 8);
    pe_px_zero(wr, nn * 8);
    // the pipe from a to b: read end rd[a * n + b], write end wr[a * n + b]
    var a: i64 = 0;
    while a < n {
        var b: i64 = 0;
        while b < n {
            if a != b {
                if (pe_tpw_pipe(rd + (a * n + b) * 8, wr + (a * n + b) * 8, 0, 1048576) as i64) == 0 {
                    p_panic("tp_init: cannot create the pipes between ranks");
                }
            }
            b = b + 1;
        }
        a = a + 1;
    }
    // our standard handles, inheritable: a rank writes its output there
    var hin: i64 = pe_tpw_std(0 - 10);
    var hout: i64 = pe_tpw_std(0 - 11);
    var herr: i64 = pe_tpw_std(0 - 12);
    var std_ok: bool = true;
    if hin != 0 && (pe_tpw_set_info(hin, 1, 1) as i64) == 0 {
        std_ok = false;
    }
    if hout != 0 && (pe_tpw_set_info(hout, 1, 1) as i64) == 0 {
        std_ok = false;
    }
    if herr != 0 && (pe_tpw_set_info(herr, 1, 1) as i64) == 0 {
        std_ok = false;
    }
    // NUL, inheritable: a rank's output until it reaches p_tp_init
    var nul: i64 = 0 - 1;
    if std_ok && hout != 0 && herr != 0 {
        var sa: i64 = p_malloc(24);
        pe_px_zero(sa, 24);
        pe_px_st32(sa, 24);
        pe_px_st32(sa + 16, 1);
        // GENERIC_WRITE, share read|write, OPEN_EXISTING
        nul = pe_cr_create("NUL" as i64, 1073741824, 3, sa, 3, 0, 0);
        p_free(sa);
    }
    var mute: bool = nul != 0 - 1;
    var exe: i64 = p_malloc(4096);
    var el: i64 = (pe_tpw_module_name(0, exe, 4096) as i64) & 4294967295;
    if el == 0 || el >= 4096 {
        p_panic("tp_init: cannot find this program's file");
    }
    var cl: i64 = pe_tpw_command_line();
    var cl_n: i64 = pe_c_strlen(cl);
    var si: i64 = p_malloc(104);
    var pi: i64 = p_malloc(24);
    pe_c_fflush(0);
    var r: i64 = 1;
    while r < n {
        var links: str = "";
        var b2: i64 = 0;
        while b2 < n {
            if b2 != r {
                var hi: i64 = pe_px_ld(rd + (b2 * n + r) * 8);
                var ho: i64 = pe_px_ld(wr + (r * n + b2) * 8);
                links = links + int_to_str(b2) + ":" + int_to_str(hi) + ":" + int_to_str(ho) + ";";
                pe_tpw_set_info(hi, 1, 1);
                pe_tpw_set_info(ho, 1, 1);
            }
            b2 = b2 + 1;
        }
        var rank_s: str = int_to_str(r);
        var world_s: str = int_to_str(n);
        pe_tpw_set_env("FID_TP_RANK", rank_s as i64);
        pe_tpw_set_env("FID_TP_WORLD", world_s as i64);
        pe_tpw_set_env("FID_TP_LINKS", links as i64);
        var stdio_s: str = int_to_str(hout) + ":" + int_to_str(herr);
        if mute {
            pe_tpw_set_env("FID_TP_STDIO", stdio_s as i64);
        }
        // STARTUPINFOA: cb, dwFlags at 60, the standard handles at 80, 88, 96
        pe_px_zero(si, 104);
        pe_px_st32(si, 104);
        if std_ok {
            pe_px_st32(si + 60, 256);  // STARTF_USESTDHANDLES
            pe_px_st(si + 80, hin);
            if mute {
                pe_px_st(si + 88, nul);
                pe_px_st(si + 96, nul);
            } else {
                pe_px_st(si + 88, hout);
                pe_px_st(si + 96, herr);
            }
        }
        pe_px_zero(pi, 24);
        // CreateProcessA may write to the command line: a copy
        var cmd: i64 = p_malloc(cl_n + 1);
        pe_px_copy(cmd, cl, cl_n);
        pe_set_byte(cmd, cl_n, 0);
        var ok: i64 = pe_px_create(exe, cmd, 0, 0, 1, 0, 0, 0, si, pi) as i64;
        p_free(cmd);
        b2 = 0;
        while b2 < n {
            if b2 != r {
                pe_tpw_set_info(pe_px_ld(rd + (b2 * n + r) * 8), 1, 0);
                pe_tpw_set_info(pe_px_ld(wr + (r * n + b2) * 8), 1, 0);
            }
            b2 = b2 + 1;
        }
        if ok == 0 {
            p_panic("tp_init: cannot start rank " + int_to_str(r));
        }
        pe_k_close_handle(pe_px_ld(pi + 8));
        pet_tp_set_child(r, pe_px_ld(pi));
        r = r + 1;
    }
    pe_tpw_env_clear();
    if nul != 0 - 1 {
        pe_k_close_handle(nul);
    }
    // rank 0 keeps the read ends of the pipes to it and the write ends of
    // those from it; the others belong to the ranks now
    var b3: i64 = 1;
    while b3 < n {
        pet_tp_set_link(b3, pe_px_ld(rd + (b3 * n) * 8), pe_px_ld(wr + b3 * 8));
        b3 = b3 + 1;
    }
    a = 0;
    while a < n {
        var b4: i64 = 0;
        while b4 < n {
            if a != b4 {
                if b4 != 0 {
                    pe_k_close_handle(pe_px_ld(rd + (a * n + b4) * 8));
                }
                if a != 0 {
                    pe_k_close_handle(pe_px_ld(wr + (a * n + b4) * 8));
                }
            }
            b4 = b4 + 1;
        }
        a = a + 1;
    }
    p_free(rd);
    p_free(wr);
    p_free(exe);
    p_free(si);
    p_free(pi);
    pet_tp_joined(0, n, n - 1);
    return true;
}

/// All n bytes at buf into the pipe: false when the rank at its other end
/// is gone.
fn pe_tp_os_write(h: i64, buf: i64, n: i64) -> bool {
    var cell: i64 = p_malloc(8);
    var done: i64 = 0;
    var ok: bool = true;
    while ok && done < n {
        var chunk: i64 = n - done;
        if chunk > 1073741824 {
            chunk = 1073741824;
        }
        pe_px_st(cell, 0);
        var r: i64 = pe_cr_write_file(h, buf + done, chunk, cell, 0) as i64;
        var w: i64 = pe_px_ld(cell) & 4294967295;
        if r == 0 || w == 0 {
            ok = false;
        } else {
            done = done + w;
        }
    }
    p_free(cell);
    return ok;
}

/// n bytes from the pipe into buf: false when it ended first.
fn pe_tp_os_read(h: i64, buf: i64, n: i64) -> bool {
    var cell: i64 = p_malloc(8);
    var done: i64 = 0;
    var ok: bool = true;
    while ok && done < n {
        var chunk: i64 = n - done;
        if chunk > 1073741824 {
            chunk = 1073741824;
        }
        pe_px_st(cell, 0);
        var r: i64 = pe_k_read_file(h, buf + done, chunk, cell, 0) as i64;
        var got: i64 = pe_px_ld(cell) & 4294967295;
        if r == 0 || got == 0 {
            ok = false;
        } else {
            done = done + got;
        }
    }
    p_free(cell);
    return ok;
}

fn pe_tp_os_close(inh: i64, outh: i64) {
    pe_k_close_handle(inh);
    if outh != inh {
        pe_k_close_handle(outh);
    }
}

/// The rank's exit code once it ended (-1 when it cannot be had).
fn pe_tp_os_wait(h: i64) -> i64 {
    pe_k_wait(h, 4294967295);
    var cell: i64 = p_malloc(8);
    pe_px_st(cell, 0);
    var got: i64 = pe_px_exit_code(h, cell) as i64;
    var code: i64 = pe_px_ld(cell) & 4294967295;
    p_free(cell);
    pe_k_close_handle(h);
    if got == 0 {
        return 0 - 1;
    }
    return code;
}
