// stdlib/ecs.fd — Entity Component System runtime (Phase 8B: F18)
//
// This module provides the ECS world API. Components are declared with the
// `component` keyword, systems with `system`, and queries with `query`.
// The runtime functions are built into the interpreter and C codegen.
//
// Usage:
//   use ecs
//   component Position { x: f64, y: f64 }
//   component Velocity { dx: f64, dy: f64 }
//   system Move(dt: f64) {
//       query(Position, Velocity) {
//           // `entity` is bound to the current entity ID
//           // Access components via __ecs_get("ComponentName", entity)
//       }
//   }
//   pf main() {
//       pv e = ecs_create_entity();
//       ecs_add("Position", e, Position { x: 0.0, y: 0.0 });
//       Move(0.016);
//   }

// ─── Entity Management ────────────────────────────────────────────────

// Create a new entity and return its ID
pf ecs_create_entity() -> i64 {
    ret __ecs_create_entity();
}

// Get the total number of entities
pf ecs_entity_count() -> i64 {
    ret __ecs_entity_count();
}

// ─── Component Management ─────────────────────────────────────────────

// Check if an entity has a component
pf ecs_has(component_name: str, entity: i64) -> i64 {
    ret __ecs_has(component_name, entity);
}

// Add a component to an entity (value is a struct)
// Note: due to SRET calling convention, the value is passed as a pointer
pf ecs_add(component_name: str, entity: i64, value: i64) {
    __ecs_add(component_name, entity, value);
}

// Get a component value from an entity
// Returns a pointer to the struct data
pf ecs_get(component_name: str, entity: i64) -> i64 {
    ret __ecs_get(component_name, entity);
}

// Remove a component from an entity
pf ecs_remove(component_name: str, entity: i64) {
    __ecs_remove(component_name, entity);
}

// ─── Event Dispatch (F20) ─────────────────────────────────────────────

// Dispatch an event by calling the appropriate handler function
// Event handlers are defined with `on event_name(params) { body }`
// and desugared to `__on_event_name(params)` functions.
// This is a simple dispatch — in a real game engine, this would use
// an event queue and dispatch on the next frame.
pf ecs_dispatch_event(event_name: str) {
    // Event dispatch is handled by calling __on_<event_name> directly
    // This function is a placeholder for future event queue support
}
