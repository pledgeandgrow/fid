// stdlib/ecs.fd — Entity Component System runtime (Phase 8B: F18)
//
// This module provides the ECS world API. Components are declared with the
// `component` keyword, systems with `system`, and queries with `query`.
// The runtime functions are built into the interpreter and C codegen.
//
// Usage:
//   use ecs
//   component Position { x: f64, y: f64 }
//   component Velocity { dx: f64, dy: f64 }
//   system Move(dt: f64) {
//       query(Position, Velocity) {
//           // `entity` is bound to the current entity ID
//           // Access components via __ecs_get("ComponentName", entity)
//       }
//   }
//   fn main() {
//       value e = ecs_create_entity();
//       ecs_add("Position", e, Position { x: 0.0, y: 0.0 });
//       Move(0.016);
//   }

// ─── Entity Management ────────────────────────────────────────────────

// Create a new entity and return its ID
use json;
pub fn ecs_create_entity() -> i64 {
    return __ecs_create_entity();
}

// Get the total number of entities
pub fn ecs_entity_count() -> i64 {
    return __ecs_entity_count();
}

// ─── World tracking ───────────────────────────────────────────────────
// The runtime stores components in per-name tables and hands out entity
// IDs from a monotonic counter. It cannot enumerate component names or
// delete entities, so this module tracks both itself: every component
// name ever passed to ecs_add, and every entity passed to
// ecs_destroy_entity. Entity IDs are never reused, so once an entity is
// dead it stays dead — ecs_reset() clears all component data but the
// ID space keeps advancing (ecs_entity_count() is a high-water mark).

var ECS_COMP_NAMES: Vec<str> = Vec::new();
var ECS_DEAD: Vec<i64> = Vec::new();

fn ecs_track_name(name: str) -> void {
    var i: i64 = 0;
    while i < ECS_COMP_NAMES.len() {
        if str_equal(ECS_COMP_NAMES.get(i), name) {
            return;
        }
        i = i + 1;
    }
    ECS_COMP_NAMES.push(name);
}

fn ecs_is_dead(entity: i64) -> bool {
    var i: i64 = 0;
    while i < ECS_DEAD.len() {
        if ECS_DEAD.get(i) == entity {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// True while the entity has been created and not destroyed.
/// Destroyed IDs are never reused, so this stays false forever after
/// ecs_destroy_entity.
pub fn ecs_is_alive(entity: i64) -> bool {
    return entity >= 0 && entity < ecs_entity_count() && !ecs_is_dead(entity);
}

// ─── Component Management ─────────────────────────────────────────────

// Check if an entity has a component
pub fn ecs_has(component_name: str, entity: i64) -> i64 {
    return __ecs_has(component_name, entity);
}

// Add a component to an entity (value is a struct)
// Note: due to SRET calling convention, the value is passed as a pointer
pub fn ecs_add<T>(component_name: str, entity: i64, value: T) {
    ecs_track_name(component_name);
    __ecs_add(component_name, entity, value);
}

// Get a component value from an entity
// Returns a pointer to the struct data
pub fn ecs_get(component_name: str, entity: i64) -> i64 {
    return __ecs_get(component_name, entity);
}

// Remove a component from an entity
pub fn ecs_remove(component_name: str, entity: i64) {
    __ecs_remove(component_name, entity);
}

// ─── Event Dispatch (F20) ─────────────────────────────────────────────

// Dispatch an event by calling the appropriate handler function
// Event handlers are defined with `on event_name(params) { body }`
// and desugared to `__on_event_name(params)` functions.
// This is a simple dispatch — in a real game engine, this would use
// an event queue and dispatch on the next frame.
pub fn ecs_dispatch_event(_event_name: str) {  // Event dispatch is handled by calling __on_<event_name> directly
// This function is a placeholder for future event queue support
}

// ─── Comptime ECS API (Phase 15.5) ──────────────────────────────────────
//
// In the future, `comptime register_components(Position, Velocity, Health)`
// will generate storage layout + query code at compile time.
// `comptime query(Position, Velocity)` will generate specialized iteration
// code with cache-perfect struct-of-arrays layout.
//
// For now, these functions provide the runtime API that comptime code
// will call. The runtime ECS uses a map-based storage (not SoA), but
// the API is the same.

/// Register a component type. Called once per component type at startup.
/// In comptime mode, this would generate the storage layout.
pub fn ecs_register_component(_component_name: str) -> void {  // The runtime ECS auto-registers components on first use.
// This function is for explicit registration and future comptime support.
}

/// Register a system. A system is a function that runs every frame
/// and queries entities with specific components.
/// In comptime mode, this would generate the query iteration code.
pub fn ecs_register_system(_system_name: str, _handler: fn() -> void) -> void {  // Store the system handler for later execution.
// In comptime mode, the handler would be inlined.
}

/// Run all registered systems. Called once per frame.
pub fn ecs_run_systems() -> void {  // In the runtime, systems are called directly by name.
// In comptime mode, the generated code would inline all systems.
}

/// Query entities that have all of the specified components.
/// Returns a Vec of entity IDs.
/// In comptime mode, this would generate specialized iteration code.
pub fn ecs_query_entities(components: str) -> Vec<i64> {
    // components is a JSON array of component names: ["Position","Velocity"]
    var result = Vec::new();
    var n = ecs_entity_count();
    var i = 0;
    while i < n {
        var has_all = !ecs_is_dead(i);
        var j = 0;
        var num_components = json_len(components);
        while j < num_components {
            var comp = json_at_str(components, j);
            if ecs_has(comp, i) == 0 {
                has_all = false;
            }
            j = j + 1;
        }
        if has_all {
            result.push(i);
        }
        i = i + 1;
    }
    return result;
}

/// Get the number of entities that have a specific component.
pub fn ecs_count_with_component(component_name: str) -> i64 {
    var count = 0;
    var n = ecs_entity_count();
    var i = 0;
    while i < n {
        if ecs_has(component_name, i) != 0 {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/// Destroy an entity and all its components.
/// Removes every registered component and marks the ID dead. The ID is
/// never reused and ecs_entity_count() does not decrease (it is the
/// high-water mark of IDs ever handed out).
pub fn ecs_destroy_entity(entity: i64) -> void {
    if ecs_is_dead(entity) {
        return;
    }
    var i: i64 = 0;
    while i < ECS_COMP_NAMES.len() {
        ecs_remove(ECS_COMP_NAMES.get(i), entity);
        i = i + 1;
    }
    ECS_DEAD.push(entity);
}

/// Reset the ECS world — destroy all entities and components.
/// Every registered component is removed from every entity. The entity
/// ID counter is owned by the runtime and keeps its high-water mark, so
/// post-reset entities get fresh IDs above all previous ones.
pub fn ecs_reset() -> void {
    var n: i64 = ecs_entity_count();
    var i: i64 = 0;
    while i < ECS_COMP_NAMES.len() {
        var e: i64 = 0;
        while e < n {
            ecs_remove(ECS_COMP_NAMES.get(i), e);
            e = e + 1;
        }
        i = i + 1;
    }
    // IDs are never reused; all pre-reset IDs stay dead.
    var d: i64 = 0;
    while d < n {
        if !ecs_is_dead(d) {
            ECS_DEAD.push(d);
        }
        d = d + 1;
    }
}

// ─── Game loop integration (Phase 15.5) ─────────────────────────────────
//
// The game loop calls ecs_run_systems() each frame, then frame_end()
// from the arena module to free per-frame allocations.

/// Run one frame of the ECS: call all systems, then clean up.
/// This is a convenience function for game loops.
pub fn ecs_frame() -> void {
    ecs_run_systems();
    // Per-frame cleanup is handled by the frame allocator (stdlib/arena.fd)
}

/// Create an entity with a single component (convenience function).
///
/// Example:
///   component Health { hp: i64 }
///   fn main() -> i64 {
///       val before = ecs_entity_count();
///       val e = ecs_spawn("Health", Health { hp: 5 });
///       assert_eq(ecs_entity_count(), before + 1);
///       assert_eq(ecs_has("Nothing", e), 0);
///       val e2 = ecs_spawn2("Health", Health { hp: 1 }, "Health", Health { hp: 2 });
///       assert_eq(e2, e + 1);
///       assert_eq(ecs_query_entities("[]").len(), ecs_entity_count());
///       return 0;
///   }
pub fn ecs_spawn<T>(component_name: str, value: T) -> i64 {
    var entity = ecs_create_entity();
    ecs_add(component_name, entity, value);
    return entity;
}

/// Create an entity with two components (convenience function).
pub fn ecs_spawn2<T, U>(comp1: str, val1: T, comp2: str, val2: U) -> i64 {
    var entity = ecs_create_entity();
    ecs_add(comp1, entity, val1);
    ecs_add(comp2, entity, val2);
    return entity;
}

/// Create an entity with three components (convenience function).
pub fn ecs_spawn3<T, U, V>(comp1: str, val1: T, comp2: str, val2: U, comp3: str, val3: V) -> i64 {
    var entity = ecs_create_entity();
    ecs_add(comp1, entity, val1);
    ecs_add(comp2, entity, val2);
    ecs_add(comp3, entity, val3);
    return entity;
}
