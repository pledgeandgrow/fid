// Fides DLMS/COSEM standard library
//
// DLMS/COSEM (IEC 62056) is the smart-meter protocol. This module covers the
// parts that are pure computation on byte vectors (Vec<i64>, bytes 0..255):
//
// Real (implemented and tested on known frames):
//   - OBIS codes: parse "A-B:C.D.E.F" (e.g. "1-0:1.8.0.255") into its 6
//     groups and back, and name the common ones (active energy import/
//     export, voltage, current, clock) (dlms_obis_parse / dlms_obis_name).
//   - COSEM data types in A-XDR: unsigned/signed 8/16/32-bit, enum, boolean,
//     octet-string, visible-string, structure and array (with the type tag
//     and length), and the 12-byte date-time. Encode a value and decode a
//     buffer into a tagged value tree (dlms_axdr_* / dlms_decode).
//   - HDLC framing (IEC 62056-46): the 0x7E flag, the format field (type 3,
//     a 11-bit length and the segmentation bit), the destination and source
//     addresses (upper/lower HDLC addressing), the control byte, the HCS
//     (header check) and FCS (frame check) using CRC-16/X-25 (the "123456789"
//     check value is 0x906E), and building/parsing an information frame
//     (dlms_hdlc_frame / dlms_hdlc_parse).
//   - The association (ACSE) AARQ/AARE basics: build an AARQ with an
//     application context name and an AARE with the association result and a
//     negotiated conformance; and the COSEM GET.request (normal) and
//     GET.response (normal, data or data-access-result)
//     (dlms_aarq / dlms_aare / dlms_get_request / dlms_get_response).
//
// The seam: no serial/TCP transport. A frame is bytes; send it over the
// meter's optical/serial/TCP link and feed received bytes back. Ciphering
// (GCM) and the full xDLMS APDU set beyond GET are out of scope and noted.

module dlms;
use vec;
use string;

// ─── CRC-16/X-25 (HDLC FCS/HCS) ──────────────────────────────────────────

/// CRC-16/X-25: reflected polynomial 0x8408, initial 0xFFFF, final XOR
/// 0xFFFF. "123456789" gives 0x906E.
pub fn dlms_crc(b: &Vec<i64>, start: i64, n: i64) -> i64 {
    var crc: i64 = 65535;
    var i: i64 = 0;
    while i < n {
        crc = crc ^ (b.get(start + i) & 255);
        var k: i64 = 0;
        while k < 8 {
            if (crc & 1) != 0 {
                crc = (crc >> 1) ^ 33800;  // 0x8408
            } else {
                crc = crc >> 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return (crc ^ 65535) & 65535;
}

// ─── OBIS codes ──────────────────────────────────────────────────────────

/// A parsed OBIS code: the six value groups A..F.
pub struct ObisCode {
    pub ok: bool,
    pub a: i64,
    pub b: i64,
    pub c: i64,
    pub d: i64,
    pub e: i64,
    pub f: i64,
}

/// Parse "A-B:C.D.E.F" into its groups.
pub fn dlms_obis_parse(s: str) -> ObisCode {
    val dash: i64 = str_find(s, "-");
    val colon: i64 = str_find(s, ":");
    if dash < 0 || colon < 0 {
        return ObisCode {
            ok: false, a: 0, b: 0, c: 0, d: 0, e: 0, f: 0
        };
    }
    val a: i64 = str_parse_int(str_slice(s, 0, dash));
    val b: i64 = str_parse_int(str_slice(s, dash + 1, colon));
    val rest: str = str_slice(s, colon + 1, str_len(s));
    val parts: Vec<str> = str_split(rest, ".");
    if parts.len() < 4 {
        return ObisCode {
            ok: false, a: a, b: b, c: 0, d: 0, e: 0, f: 0
        };
    }
    return ObisCode {
        ok: true, a: a, b: b, c: str_parse_int(parts.get(0)), d: str_parse_int(parts.get(1)), e: str_parse_int(parts.get(2)), f: str_parse_int(parts.get(3)),
    };
}

/// The 6 OBIS bytes.
pub fn dlms_obis_bytes(o: &ObisCode) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(o.a & 255);
    out.push(o.b & 255);
    out.push(o.c & 255);
    out.push(o.d & 255);
    out.push(o.e & 255);
    out.push(o.f & 255);
    return out;
}

/// Format an OBIS code as "A-B:C.D.E.F".
pub fn dlms_obis_format(o: &ObisCode) -> str {
    return int_to_str(o.a) + "-" + int_to_str(o.b) + ":" + int_to_str(o.c) + "." + int_to_str(o.d) + "." + int_to_str(o.e) + "." + int_to_str(o.f);
}

/// A human name for a common OBIS code, or "" when unknown.
pub fn dlms_obis_name(o: &ObisCode) -> str {
    if o.c == 1 && o.d == 8 {
        return "active energy import";
    }
    if o.c == 2 && o.d == 8 {
        return "active energy export";
    }
    if o.c == 3 && o.d == 8 {
        return "reactive energy import";
    }
    if o.c == 1 && o.d == 7 {
        return "active power import";
    }
    if o.c == 32 && o.d == 7 {
        return "voltage L1";
    }
    if o.c == 31 && o.d == 7 {
        return "current L1";
    }
    if o.c == 0 && o.d == 0 && o.e == 1 {
        return "clock";
    }
    if o.c == 96 && o.d == 1 {
        return "device id";
    }
    return "";
}

// ─── A-XDR COSEM data types ──────────────────────────────────────────────
pub const AXDR_NULL: i64 = 0;
pub const AXDR_ARRAY: i64 = 1;
pub const AXDR_STRUCTURE: i64 = 2;
pub const AXDR_BOOLEAN: i64 = 3;
pub const AXDR_BIT_STRING: i64 = 4;
pub const AXDR_INT32: i64 = 5;  // double-long
pub const AXDR_UINT32: i64 = 6;  // double-long-unsigned
pub const AXDR_OCTET_STRING: i64 = 9;
pub const AXDR_VISIBLE_STRING: i64 = 10;
pub const AXDR_INT8: i64 = 15;  // integer
pub const AXDR_INT16: i64 = 16;  // long
pub const AXDR_UINT8: i64 = 17;  // unsigned
pub const AXDR_UINT16: i64 = 18;  // long-unsigned
pub const AXDR_ENUM: i64 = 22;
pub const AXDR_DATE_TIME: i64 = 25;

/// Encode an A-XDR length (short form < 128, else long form).
pub fn dlms_axdr_len(out: &mut Vec<i64>, n: i64) {
    if n < 128 {
        out.push(n);
        return;
    }
    var tmp: Vec<i64> = Vec::new();
    var v: i64 = n;
    while v > 0 {
        tmp.push(v & 255);
        v = v >> 8;
    }
    out.push(0x80 | tmp.len());
    var i: i64 = tmp.len() - 1;
    while i >= 0 {
        out.push(tmp.get(i));
        i = i - 1;
    }
}

pub fn dlms_axdr_uint8(v: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(AXDR_UINT8);
    out.push(v & 255);
    return out;
}

pub fn dlms_axdr_uint16(v: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(AXDR_UINT16);
    out.push((v >> 8) & 255);
    out.push(v & 255);
    return out;
}

pub fn dlms_axdr_uint32(v: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(AXDR_UINT32);
    out.push((v >> 24) & 255);
    out.push((v >> 16) & 255);
    out.push((v >> 8) & 255);
    out.push(v & 255);
    return out;
}

pub fn dlms_axdr_int32(v: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(AXDR_INT32);
    out.push((v >> 24) & 255);
    out.push((v >> 16) & 255);
    out.push((v >> 8) & 255);
    out.push(v & 255);
    return out;
}

pub fn dlms_axdr_enum(v: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(AXDR_ENUM);
    out.push(v & 255);
    return out;
}

pub fn dlms_axdr_boolean(b: bool) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(AXDR_BOOLEAN);
    if b {
        out.push(1);
    } else {
        out.push(0);
    }
    return out;
}

pub fn dlms_axdr_octet_string(bytes: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(AXDR_OCTET_STRING);
    dlms_axdr_len(&mut out, bytes.len());
    var i: i64 = 0;
    while i < bytes.len() {
        out.push(bytes.get(i));
        i = i + 1;
    }
    return out;
}

pub fn dlms_axdr_visible_string(s: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(AXDR_VISIBLE_STRING);
    dlms_axdr_len(&mut out, str_len(s));
    var i: i64 = 0;
    while i < str_len(s) {
        out.push(str_byte_at(s, i));
        i = i + 1;
    }
    return out;
}

/// Encode a structure from already-encoded element byte vectors.
pub fn dlms_axdr_structure(elements: &Vec<Vec<i64>>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(AXDR_STRUCTURE);
    dlms_axdr_len(&mut out, elements.len());
    var i: i64 = 0;
    while i < elements.len() {
        val e: Vec<i64> = elements.get(i);
        var j: i64 = 0;
        while j < e.len() {
            out.push(e.get(j));
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

/// Encode an array from already-encoded element byte vectors.
pub fn dlms_axdr_array(elements: &Vec<Vec<i64>>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(AXDR_ARRAY);
    dlms_axdr_len(&mut out, elements.len());
    var i: i64 = 0;
    while i < elements.len() {
        val e: Vec<i64> = elements.get(i);
        var j: i64 = 0;
        while j < e.len() {
            out.push(e.get(j));
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

/// Encode a COSEM date-time (12 bytes): year(2), month, day, day-of-week,
/// hour, minute, second, hundredths, deviation(2), clock status.
pub fn dlms_axdr_datetime(year: i64, month: i64, day: i64, dow: i64, hour: i64, minute: i64, second: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(AXDR_DATE_TIME);
    out.push((year >> 8) & 255);
    out.push(year & 255);
    out.push(month & 255);
    out.push(day & 255);
    out.push(dow & 255);
    out.push(hour & 255);
    out.push(minute & 255);
    out.push(second & 255);
    out.push(0xFF);  // hundredths not specified
    out.push(0x80);
    out.push(0x00);  // deviation not specified
    out.push(0x00);  // clock status
    return out;
}

// ─── A-XDR decoding ──────────────────────────────────────────────────────

/// A decoded A-XDR value: its type tag, a scalar `ival` (integers/enum/
/// bool), bytes (octet/visible string), and the position just past it. For
/// structures/arrays, `count` is the element count and `content` the offset
/// of the first element.
pub struct AxdrValue {
    pub ok: bool,
    pub tag: i64,
    pub ival: i64,
    pub bytes: Vec<i64>,
    pub text: str,
    pub count: i64,
    pub content: i64,
    pub next: i64,
}

fn axdr_read_len(b: &Vec<i64>, pos: i64) -> Vec<i64> {
    // returns [length, bytes_consumed]; [-1, 0] when the length is cut
    // short, indefinite (0x80) or wider than 4 bytes
    var out: Vec<i64> = Vec::new();
    if pos < 0 || pos >= b.len() {
        out.push(-1);
        out.push(0);
        return out;
    }
    val l0: i64 = b.get(pos);
    if l0 < 128 {
        out.push(l0);
        out.push(1);
        return out;
    }
    val nbytes: i64 = l0 & 127;
    if nbytes == 0 || nbytes > 4 || pos + 1 + nbytes > b.len() {
        out.push(-1);
        out.push(0);
        return out;
    }
    var length: i64 = 0;
    var i: i64 = 0;
    while i < nbytes {
        length = (length << 8) | b.get(pos + 1 + i);
        i = i + 1;
    }
    out.push(length);
    out.push(1 + nbytes);
    return out;
}

/// How deep dlms_decode follows nested structures/arrays.
pub const DLMS_AXDR_MAX_DEPTH: i64 = 64;

/// Decode one A-XDR value at `pos`. ok is false (and next = pos) when the
/// value is cut short by the end of `b`, its tag is unknown, an element of
/// a structure/array fails, or nesting goes deeper than DLMS_AXDR_MAX_DEPTH.
pub fn dlms_decode(b: &Vec<i64>, pos: i64) -> AxdrValue {
    return axdr_decode_at(b, pos, 0);
}

fn axdr_fail(v: &mut AxdrValue, pos: i64) {
    v.ok = false;
    v.next = pos;
}

fn axdr_decode_at(b: &Vec<i64>, pos: i64, depth: i64) -> AxdrValue {
    var v: AxdrValue = AxdrValue {
        ok: true, tag: 0, ival: 0, bytes: Vec::new(), text: "", count: 0, content: 0, next: pos
    };
    if pos < 0 || pos >= b.len() {
        v.ok = false;
        return v;
    }
    val tag: i64 = b.get(pos);
    v.tag = tag;
    var p: i64 = pos + 1;
    if tag == AXDR_UINT8 || tag == AXDR_ENUM || tag == AXDR_INT8 {
        if p + 1 > b.len() {
            axdr_fail(&mut v, pos);
            return v;
        }
        v.ival = b.get(p);
        if tag == AXDR_INT8 && (v.ival & 0x80) != 0 {
            v.ival = v.ival - 256;
        }
        v.next = p + 1;
    } else if tag == AXDR_BOOLEAN {
        if p + 1 > b.len() {
            axdr_fail(&mut v, pos);
            return v;
        }
        v.ival = b.get(p);
        v.next = p + 1;
    } else if tag == AXDR_UINT16 || tag == AXDR_INT16 {
        if p + 2 > b.len() {
            axdr_fail(&mut v, pos);
            return v;
        }
        v.ival = (b.get(p) << 8) | b.get(p + 1);
        if tag == AXDR_INT16 && (v.ival & 0x8000) != 0 {
            v.ival = v.ival - 65536;
        }
        v.next = p + 2;
    } else if tag == AXDR_UINT32 || tag == AXDR_INT32 {
        if p + 4 > b.len() {
            axdr_fail(&mut v, pos);
            return v;
        }
        v.ival = (b.get(p) << 24) | (b.get(p + 1) << 16) | (b.get(p + 2) << 8) | b.get(p + 3);
        if tag == AXDR_INT32 && (v.ival & 0x80000000) != 0 {
            v.ival = v.ival - 4294967296;
        }
        v.next = p + 4;
    } else if tag == AXDR_OCTET_STRING || tag == AXDR_VISIBLE_STRING {
        val lr: Vec<i64> = axdr_read_len(b, p);
        val length: i64 = lr.get(0);
        if length < 0 || p + lr.get(1) + length > b.len() {
            axdr_fail(&mut v, pos);
            return v;
        }
        p = p + lr.get(1);
        var i: i64 = 0;
        while i < length {
            v.bytes.push(b.get(p + i));
            if tag == AXDR_VISIBLE_STRING {
                v.text = v.text + char_to_str(b.get(p + i));
            }
            i = i + 1;
        }
        v.next = p + length;
    } else if tag == AXDR_STRUCTURE || tag == AXDR_ARRAY {
        if depth >= DLMS_AXDR_MAX_DEPTH {
            axdr_fail(&mut v, pos);
            return v;
        }
        val lr: Vec<i64> = axdr_read_len(b, p);
        val count: i64 = lr.get(0);
        // every element takes at least its tag byte
        if count < 0 || count > b.len() - (p + lr.get(1)) {
            axdr_fail(&mut v, pos);
            return v;
        }
        v.count = count;
        p = p + lr.get(1);
        v.content = p;
        // skip the elements to find next
        var k: i64 = 0;
        var cur: i64 = p;
        while k < v.count {
            val e: AxdrValue = axdr_decode_at(b, cur, depth + 1);
            if !e.ok {
                axdr_fail(&mut v, pos);
                return v;
            }
            cur = e.next;
            k = k + 1;
        }
        v.next = cur;
    } else if tag == AXDR_DATE_TIME {
        if p + 12 > b.len() {
            axdr_fail(&mut v, pos);
            return v;
        }
        var i: i64 = 0;
        while i < 12 {
            v.bytes.push(b.get(p + i));
            i = i + 1;
        }
        v.next = p + 12;
    } else if tag == AXDR_NULL {
        v.next = p;
    } else {
        v.ok = false;
    }
    return v;
}

// ─── HDLC framing ────────────────────────────────────────────────────────

/// Encode an HDLC address (1, 2 or 4 bytes): each byte carries 7 bits, the
/// last has its low bit set. `addr` is the full address value.
pub fn dlms_hdlc_addr(out: &mut Vec<i64>, addr: i64, nbytes: i64) {
    if nbytes == 1 {
        out.push(((addr & 127) << 1) | 1);
    } else if nbytes == 2 {
        out.push(((addr >> 7) & 127) << 1);
        out.push(((addr & 127) << 1) | 1);
    } else {
        out.push(((addr >> 21) & 127) << 1);
        out.push(((addr >> 14) & 127) << 1);
        out.push(((addr >> 7) & 127) << 1);
        out.push(((addr & 127) << 1) | 1);
    }
}

/// Build an HDLC type-3 information frame carrying `info`. `dest_bytes` and
/// `src_bytes` choose the address widths; `control` is the HDLC control
/// byte. The format field encodes the full frame length; HCS covers the
/// header, FCS the whole frame. Flags (0x7E) bracket it.
pub fn dlms_hdlc_frame(dest: i64, dest_bytes: i64, src: i64, src_bytes: i64, control: i64, info: &Vec<i64>) -> Vec<i64> {
    // Build the content between the flags first (without the format field),
    // then compute the length and prepend the format field.
    var addrs: Vec<i64> = Vec::new();
    dlms_hdlc_addr(&mut addrs, dest, dest_bytes);
    dlms_hdlc_addr(&mut addrs, src, src_bytes);
    // Header = format(2) + addresses + control; HCS(2) after it; then info;
    // then FCS(2). Frame length counts everything between the flags.
    val header_after_format: i64 = addrs.len() + 1;  // addresses + control
    val frame_len: i64 = 2 + header_after_format + 2 + info.len() + 2;  // +format+HCS+FCS
    // Format field: type 3 (0xA in top nibble), segmentation 0, 11-bit length
    val fmt_hi: i64 = 0xA0 | ((frame_len >> 8) & 0x07);
    val fmt_lo: i64 = frame_len & 255;
    var body: Vec<i64> = Vec::new();
    body.push(fmt_hi);
    body.push(fmt_lo);
    var i: i64 = 0;
    while i < addrs.len() {
        body.push(addrs.get(i));
        i = i + 1;
    }
    body.push(control & 255);
    // HCS over the header (format + addresses + control)
    val hcs: i64 = dlms_crc(&body, 0, body.len());
    body.push(hcs & 255);
    body.push((hcs >> 8) & 255);
    // info
    var j: i64 = 0;
    while j < info.len() {
        body.push(info.get(j));
        j = j + 1;
    }
    // FCS over everything from the format field through the info
    val fcs: i64 = dlms_crc(&body, 0, body.len());
    body.push(fcs & 255);
    body.push((fcs >> 8) & 255);
    // bracket with flags
    var out: Vec<i64> = Vec::new();
    out.push(0x7E);
    var k: i64 = 0;
    while k < body.len() {
        out.push(body.get(k));
        k = k + 1;
    }
    out.push(0x7E);
    return out;
}

/// A parsed HDLC frame.
pub struct HdlcFrame {
    pub ok: bool,
    pub error: str,
    pub frame_len: i64,
    pub segmentation: bool,
    pub control: i64,
    pub info: Vec<i64>,
}

fn decode_addr(b: &Vec<i64>, pos: i64) -> Vec<i64> {
    // returns [address, bytes_consumed]; reads until a byte with low bit
    // set. bytes_consumed is 0 when no such byte comes within 4 bytes (or
    // before the end of `b`).
    var addr: i64 = 0;
    var consumed: i64 = 0;
    var ended: bool = false;
    var p: i64 = pos;
    while p < b.len() && consumed < 4 {
        val byte: i64 = b.get(p);
        addr = (addr << 7) | ((byte >> 1) & 127);
        consumed = consumed + 1;
        p = p + 1;
        if (byte & 1) == 1 {
            ended = true;
            break;
        }
    }
    var out: Vec<i64> = Vec::new();
    out.push(addr);
    if ended {
        out.push(consumed);
    } else {
        out.push(0);
    }
    return out;
}

fn hdlc_err(msg: str) -> HdlcFrame {
    return HdlcFrame {
        ok: false, error: msg, frame_len: 0, segmentation: false, control: 0, info: Vec::new()
    };
}

/// Parse an HDLC frame, checking HCS and FCS.
pub fn dlms_hdlc_parse(b: &Vec<i64>) -> HdlcFrame {
    if b.len() < 7 || b.get(0) != 0x7E || b.get(b.len() - 1) != 0x7E {
        return HdlcFrame {
            ok: false, error: "missing flags", frame_len: 0, segmentation: false, control: 0, info: Vec::new()
        };
    }
    val fmt_hi: i64 = b.get(1);
    val fmt_lo: i64 = b.get(2);
    val frame_len: i64 = ((fmt_hi & 0x07) << 8) | fmt_lo;
    val seg: bool = (fmt_hi & 0x08) != 0;
    // addresses (dest then src), control; the closing flag is not part of
    // an address
    val last: i64 = b.len() - 1;
    val da: Vec<i64> = decode_addr(b, 3);
    if da.get(1) == 0 || 3 + da.get(1) >= last {
        return hdlc_err("bad destination address");
    }
    val sa: Vec<i64> = decode_addr(b, 3 + da.get(1));
    if sa.get(1) == 0 || 3 + da.get(1) + sa.get(1) > last {
        return hdlc_err("bad source address");
    }
    var p: i64 = 3 + da.get(1) + sa.get(1);
    // control + HCS (the FCS when there is no information field) must
    // fit before the closing flag
    if p + 3 > last {
        return hdlc_err("frame too short");
    }
    // the format field's length counts every byte between the flags
    if frame_len != b.len() - 2 {
        return hdlc_err("frame length mismatch");
    }
    val control: i64 = b.get(p);
    p = p + 1;
    // HCS over format..control (indices 1..p-1)
    val hcs: i64 = dlms_crc(b, 1, p - 1);
    if (b.get(p) | (b.get(p + 1) << 8)) != hcs {
        return HdlcFrame {
            ok: false, error: "HCS mismatch", frame_len: frame_len, segmentation: seg, control: control, info: Vec::new()
        };
    }
    p = p + 2;
    // info runs up to the FCS, which is the 2 bytes before the closing flag
    val info_end: i64 = b.len() - 1 - 2;
    var info: Vec<i64> = Vec::new();
    var i: i64 = p;
    while i < info_end {
        info.push(b.get(i));
        i = i + 1;
    }
    // FCS over format..info (index 1 up to info_end)
    val fcs: i64 = dlms_crc(b, 1, info_end - 1);
    if (b.get(info_end) | (b.get(info_end + 1) << 8)) != fcs {
        return HdlcFrame {
            ok: false, error: "FCS mismatch", frame_len: frame_len, segmentation: seg, control: control, info: info
        };
    }
    return HdlcFrame {
        ok: true, error: "", frame_len: frame_len, segmentation: seg, control: control, info: info
    };
}

// ─── ACSE (AARQ / AARE) basics ───────────────────────────────────────────

/// Build a minimal AARQ APDU (tag 0x60) carrying the application context
/// name (LN referencing, no ciphering: 2.16.756.5.8.1.1). `ctx_last` picks
/// the context (1 = LN, 3 = SN).
pub fn dlms_aarq(ctx_last: i64) -> Vec<i64> {
    // application-context-name [1] = OID 2.16.756.5.8.1.<ctx_last>
    var ctx: Vec<i64> = Vec::new();
    ctx.push(0x06);
    ctx.push(0x07);  // OBJECT IDENTIFIER, length 7
    ctx.push(0x60);
    ctx.push(0x85);
    ctx.push(0x74);
    ctx.push(0x05);
    ctx.push(0x08);
    ctx.push(0x01);
    ctx.push(ctx_last & 255);
    var ctx_field: Vec<i64> = Vec::new();
    ctx_field.push(0xA1);  // [1] application-context-name
    ctx_field.push(ctx.len());
    var i: i64 = 0;
    while i < ctx.len() {
        ctx_field.push(ctx.get(i));
        i = i + 1;
    }
    var out: Vec<i64> = Vec::new();
    out.push(0x60);  // AARQ
    out.push(ctx_field.len());
    var j: i64 = 0;
    while j < ctx_field.len() {
        out.push(ctx_field.get(j));
        j = j + 1;
    }
    return out;
}

/// Build a minimal AARE APDU (tag 0x61) carrying the association result
/// (0 accepted) and a diagnostic.
pub fn dlms_aare(result: i64, diagnostic: i64) -> Vec<i64> {
    var body: Vec<i64> = Vec::new();
    // result [2]
    body.push(0xA2);
    body.push(0x03);
    body.push(0x02);
    body.push(0x01);
    body.push(result & 255);
    // result-source-diagnostic [3] acse-service-user
    body.push(0xA3);
    body.push(0x05);
    body.push(0xA1);
    body.push(0x03);
    body.push(0x02);
    body.push(0x01);
    body.push(diagnostic & 255);
    var out: Vec<i64> = Vec::new();
    out.push(0x61);
    out.push(body.len());
    var i: i64 = 0;
    while i < body.len() {
        out.push(body.get(i));
        i = i + 1;
    }
    return out;
}

/// A parsed AARE result.
pub struct Aare {
    pub ok: bool,
    pub result: i64,
    pub diagnostic: i64,
}

pub fn dlms_aare_parse(b: &Vec<i64>) -> Aare {
    if b.len() < 2 || b.get(0) != 0x61 {
        return Aare {
            ok: false, result: -1, diagnostic: -1
        };
    }
    var result: i64 = -1;
    var diag: i64 = -1;
    var p: i64 = 2;
    while p + 1 < b.len() {
        val tag: i64 = b.get(p);
        val len: i64 = b.get(p + 1);
        if tag == 0xA2 {
            // result [2]: INTEGER inside
            result = b.get(p + 4);
        } else if tag == 0xA3 {
            diag = b.get(p + 6);
        }
        p = p + 2 + len;
    }
    return Aare {
        ok: true, result: result, diagnostic: diag
    };
}

// ─── COSEM GET service (LN) ──────────────────────────────────────────────

/// Build a GET.request (normal): tag 0xC0, type 0x01, invoke-id-and-priority,
/// then the COSEM attribute descriptor (class-id:2, instance OBIS:6,
/// attribute-id:1) and a null access-selection (0x00).
pub fn dlms_get_request(invoke_id: i64, class_id: i64, obis: &ObisCode, attribute_id: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(0xC0);  // GET-Request
    out.push(0x01);  // normal
    out.push(invoke_id & 255);
    out.push((class_id >> 8) & 255);
    out.push(class_id & 255);
    val ob: Vec<i64> = dlms_obis_bytes(obis);
    var i: i64 = 0;
    while i < ob.len() {
        out.push(ob.get(i));
        i = i + 1;
    }
    out.push(attribute_id & 255);
    out.push(0x00);  // no access selection
    return out;
}

pub struct GetRequest {
    pub ok: bool,
    pub invoke_id: i64,
    pub class_id: i64,
    pub obis: ObisCode,
    pub attribute_id: i64,
}

pub fn dlms_get_request_parse(b: &Vec<i64>) -> GetRequest {
    if b.len() < 13 || b.get(0) != 0xC0 || b.get(1) != 0x01 {
        return GetRequest {
            ok: false, invoke_id: 0, class_id: 0, obis: ObisCode {
                ok: false, a: 0, b: 0, c: 0, d: 0, e: 0, f: 0
            }, attribute_id: 0
        };
    }
    val o: ObisCode = ObisCode {
        ok: true, a: b.get(5), b: b.get(6), c: b.get(7), d: b.get(8), e: b.get(9), f: b.get(10)
    };
    return GetRequest {
        ok: true, invoke_id: b.get(2), class_id: (b.get(3) << 8) | b.get(4), obis: o, attribute_id: b.get(11),
    };
}

/// Build a GET.response (normal) carrying data: tag 0xC4, type 0x01,
/// invoke-id, result choice 0 (data) then the A-XDR encoded value.
pub fn dlms_get_response(invoke_id: i64, data: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(0xC4);  // GET-Response
    out.push(0x01);  // normal
    out.push(invoke_id & 255);
    out.push(0x00);  // result = data
    var i: i64 = 0;
    while i < data.len() {
        out.push(data.get(i));
        i = i + 1;
    }
    return out;
}

/// Build a GET.response (normal) carrying a data-access-result error: tag
/// 0xC4, type 0x01, invoke-id, result choice 1 (data-access-result) then the
/// error code.
pub fn dlms_get_response_error(invoke_id: i64, error_code: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(0xC4);
    out.push(0x01);
    out.push(invoke_id & 255);
    out.push(0x01);  // result = data-access-result
    out.push(error_code & 255);
    return out;
}

pub struct GetResponse {
    pub ok: bool,
    pub invoke_id: i64,
    pub is_data: bool,
    pub error_code: i64,
    pub data_start: i64,  // offset of the A-XDR value when is_data
}

pub fn dlms_get_response_parse(b: &Vec<i64>) -> GetResponse {
    if b.len() < 4 || b.get(0) != 0xC4 || b.get(1) != 0x01 {
        return GetResponse {
            ok: false, invoke_id: 0, is_data: false, error_code: 0, data_start: 0
        };
    }
    val choice: i64 = b.get(3);
    if choice == 0 {
        return GetResponse {
            ok: true, invoke_id: b.get(2), is_data: true, error_code: 0, data_start: 4
        };
    }
    return GetResponse {
        ok: true, invoke_id: b.get(2), is_data: false, error_code: b.get(4), data_start: 0
    };
}
