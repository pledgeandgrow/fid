// Generated from Python unicodedata (Unicode 16) — do not hand-edit.
// Tables packed as fixed-width decimal strings: value i of a width-w
// table sits at byte offset i*w, read via udata_get. Hangul is algorithmic.
module unicode_data;

use vec;
pub const UDEC_CANON_KEYS: str = "";
pub const UDEC_CANON_N: i64 = 2081;
pub const UDEC_CANON_OFF: str = "";
pub const UDEC_CANON_LEN: str = "";
pub const UDEC_CANON_POOL: str = "";
pub const UDEC_COMPAT_KEYS: str = "";
pub const UDEC_COMPAT_N: i64 = 3832;
pub const UDEC_COMPAT_OFF: str = "";
pub const UDEC_COMPAT_LEN: str = "";
pub const UDEC_COMPAT_POOL: str = "";
pub const UCCC_KEYS: str = "";
pub const UCCC_N: i64 = 934;
pub const UCCC_VAL: str = "";
pub const UCOMP_KEYS: str = "";
pub const UCOMP_N: i64 = 961;
pub const UCOMP_VALS: str = "";

/// Element `i` of a packed width-`w` decimal table.
fn udata_get(tab: str, i: i64, w: i64) -> i64 {
    var v: i64 = 0;
    var p: i64 = i * w;
    var e: i64 = p + w;
    while p < e {
        v = v * 10 + (str_byte_at(tab, p) - 48);
        p = p + 1;
    }
    return v;
}

fn udata_find_canon(key: i64) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = UDEC_CANON_N - 1;
    while lo <= hi {
        var mid: i64 = (lo + hi) / 2;
        var v: i64 = udata_get(UDEC_CANON_KEYS, mid, 7);
        if v == key { return mid; }
        if v < key { lo = mid + 1; } else { hi = mid - 1; }
    }
    return -1;
}

fn udata_find_compat(key: i64) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = UDEC_COMPAT_N - 1;
    while lo <= hi {
        var mid: i64 = (lo + hi) / 2;
        var v: i64 = udata_get(UDEC_COMPAT_KEYS, mid, 7);
        if v == key { return mid; }
        if v < key { lo = mid + 1; } else { hi = mid - 1; }
    }
    return -1;
}

fn udata_find_ccc(key: i64) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = UCCC_N - 1;
    while lo <= hi {
        var mid: i64 = (lo + hi) / 2;
        var v: i64 = udata_get(UCCC_KEYS, mid, 7);
        if v == key { return mid; }
        if v < key { lo = mid + 1; } else { hi = mid - 1; }
    }
    return -1;
}

fn udata_find_comp(key: i64) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = UCOMP_N - 1;
    while lo <= hi {
        var mid: i64 = (lo + hi) / 2;
        var v: i64 = udata_get(UCOMP_KEYS, mid, 14);
        if v == key { return mid; }
        if v < key { lo = mid + 1; } else { hi = mid - 1; }
    }
    return -1;
}

/// Recursive compatibility decomposition of `cp` into `out` (NFKD side).
pub fn udata_decomp_compat(cp: i64, out: &mut Vec) {
    var i: i64 = udata_find_compat(cp);
    var off: i64 = 0;
    var n: i64 = 0;
    var compat_tab: bool = true;
    if i < 0 {
        var j: i64 = udata_find_canon(cp);
        if j < 0 { out.push(cp); return; }
        off = udata_get(UDEC_CANON_OFF, j, 7);
        n = udata_get(UDEC_CANON_LEN, j, 2);
        compat_tab = false;
    } else {
        off = udata_get(UDEC_COMPAT_OFF, i, 7);
        n = udata_get(UDEC_COMPAT_LEN, i, 2);
    }
    var c: i64 = 0;
    while c < n {
        var dx: i64 = 0;
        if compat_tab { dx = udata_get(UDEC_COMPAT_POOL, off + c, 7); }
        else { dx = udata_get(UDEC_CANON_POOL, off + c, 7); }
        udata_decomp_compat(dx, out);
        c = c + 1;
    }
}

/// Recursive canonical decomposition of `cp` into `out` (NFD side).
pub fn udata_decomp_canon(cp: i64, out: &mut Vec) {
    var j: i64 = udata_find_canon(cp);
    if j < 0 { out.push(cp); return; }
    var off: i64 = udata_get(UDEC_CANON_OFF, j, 7);
    var n: i64 = udata_get(UDEC_CANON_LEN, j, 2);
    var c: i64 = 0;
    while c < n {
        udata_decomp_canon(udata_get(UDEC_CANON_POOL, off + c, 7), out);
        c = c + 1;
    }
}

/// Canonical combining class, 0 when not a combining char.
pub fn udata_ccc(cp: i64) -> i64 {
    var i: i64 = udata_find_ccc(cp);
    if i < 0 { return 0; }
    return udata_get(UCCC_VAL, i, 3);
}

/// Canonical composition of starter `a` + `b`, or -1.
pub fn udata_compose(a: i64, b: i64) -> i64 {
    var i: i64 = udata_find_comp(a * 2097152 + b);
    if i < 0 { return -1; }
    return udata_get(UCOMP_VALS, i, 7);
}
