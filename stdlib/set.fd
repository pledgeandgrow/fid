// set.fd — HashSet: a set of unique strings backed by HashMap<str, i64>.
//
// A HashSet is just a map with a unit value; every operation delegates to the
// built-in HashMap methods, so sets get the same probing table, tombstones,
// and growth policy for free.
//
//   use set;
//   val seen = HashSet_new();
//   HashSet_insert(seen, "alice");
//   if HashSet_contains(seen, "alice") { ... }

/// Create an empty set.
pub fn HashSet_new() -> HashMap<str, i64> {
    return HashMap::new();
}

/// Insert `v` into the set. Idempotent: inserting an existing value is a no-op.
pub fn HashSet_insert(s: HashMap<str, i64>, v: str) -> void {
    s.insert(v, 1);
}

/// True when `v` is a member of the set.
pub fn HashSet_contains(s: HashMap<str, i64>, v: str) -> bool {
    return s.contains(v);
}

/// Remove `v` from the set. No-op when absent.
pub fn HashSet_remove(s: HashMap<str, i64>, v: str) -> void {
    s.remove(v);
}

/// Number of elements in the set.
pub fn HashSet_len(s: HashMap<str, i64>) -> i64 {
    return s.len();
}

/// True when the set is empty.
pub fn HashSet_is_empty(s: HashMap<str, i64>) -> bool {
    return s.is_empty();
}

/// Remove all elements, keeping the allocated table.
pub fn HashSet_clear(s: HashMap<str, i64>) -> void {
    s.clear();
}
