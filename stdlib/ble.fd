// Fides Bluetooth Low Energy: advertising data, UUIDs, ATT, GATT, L2CAP, HCI
//
// What is real (pure Fides, runs everywhere; Bluetooth Core spec 5.x):
//   - UUIDs: 16-bit and 128-bit, the Bluetooth base UUID, text form,
//     little-endian wire form, shortening a base UUID to 16 bits
//   - advertising data: AD structures [length][type][data] encode / parse
//     (flags, UUID lists, names, TX power, service data, manufacturer
//     data), the 31-byte legacy limit, an iBeacon payload
//   - ATT PDUs: error, exchange MTU, find information, read by type, read,
//     read blob, read by group type, write request/command, notification,
//     indication, confirmation
//   - a GATT server: an attribute database with handles (services,
//     characteristic declarations, values, CCCDs), permissions, and the
//     answers to the ATT requests above (service and characteristic
//     discovery, reads, writes, notification subscriptions)
//   - L2CAP basic frames (length, channel id: ATT 0x0004, signaling
//     0x0005, SMP 0x0006)
//   - HCI over UART (H4): command packets (opcode = OGF<<10 | OCF), events
//     (Command Complete, Command Status, Disconnection Complete, LE
//     Advertising Report), ACL data packets, and the LE advertising /
//     scanning commands
//
// The seam: a controller is reached through HciTransport (send one H4
// packet, receive one), which a UART driver or a Linux HCI socket wrapper
// supplies. Pairing / SMP cryptography and link-layer timing are not here.
module ble;
 use vec;
 use string;

// ─── UUIDs ──────────────────────────────────────────────────────────────

/// A UUID as its 16 bytes in wire order (little-endian).
pub struct BleUuid {
    pub b: Vec<i64>,
}

/// 00000000-0000-1000-8000-00805F9B34FB in wire order.
pub fn ble_base_uuid() -> BleUuid {
    var b: Vec<i64> = Vec::new();
    val bytes: Vec<i64> = ble_hex_bytes("fb349b5f800000800010000000000000");
    var i: i64 = 0;
    while i < 16 {
        b.push(bytes.get(i));
        i = i + 1;
    }
    return BleUuid { b: b };
}

pub fn ble_uuid16(u: i64) -> BleUuid {
    var x: BleUuid = ble_base_uuid();
    x.b.set(12, u & 0xFF);
    x.b.set(13, (u >> 8) & 0xFF);
    return x;
}

fn ble_hexval(c: i64) -> i64 {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    return 0 - 1;
}

fn ble_hex_bytes(s: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var hi: i64 = 0 - 1;
    var i: i64 = 0;
    while i < str_len(s) {
        val v: i64 = ble_hexval(str_byte_at(s, i));
        if v >= 0 {
            if hi < 0 {
                hi = v;
            } else {
                out.push(hi * 16 + v);
                hi = 0 - 1;
            }
        }
        i = i + 1;
    }
    return out;
}

/// Parse "0000180d-0000-1000-8000-00805f9b34fb" (or 4 hex digits).
pub fn ble_uuid_parse(s: str) -> BleUuid {
    val be: Vec<i64> = ble_hex_bytes(s);
    if be.len() == 2 {
        return ble_uuid16((be.get(0) << 8) | be.get(1));
    }
    var b: Vec<i64> = Vec::new();
    var i: i64 = 15;
    while i >= 0 {
        if i < be.len() {
            b.push(be.get(i));
        } else {
            b.push(0);
        }
        i = i - 1;
    }
    return BleUuid { b: b };
}

fn ble_hex2(b: i64) -> str {
    val d: str = "0123456789abcdef";
    return char_to_str(str_byte_at(d, (b >> 4) & 15)) + char_to_str(str_byte_at(d, b & 15));
}

pub fn ble_uuid_str(u: & BleUuid) -> str {
    var s: str = "";
    var i: i64 = 15;
    while i >= 0 {
        s = s + ble_hex2(u.b.get(i));
        if i == 12 || i == 10 || i == 8 || i == 6 {
            s = s + "-";
        }
        i = i - 1;
    }
    return s;
}

/// The 16-bit alias when the UUID is on the base, else -1.
pub fn ble_uuid_short(u: & BleUuid) -> i64 {
    val base: BleUuid = ble_base_uuid();
    var i: i64 = 0;
    while i < 16 {
        if i != 12 && i != 13 && u.b.get(i) != base.b.get(i) {
            return 0 - 1;
        }
        i = i + 1;
    }
    if u.b.get(14) != 0 || u.b.get(15) != 0 {
        return 0 - 1;
    }
    return u.b.get(12) | (u.b.get(13) << 8);
}

/// Wire form: 2 bytes for a base UUID, else 16.
pub fn ble_uuid_wire(u: & BleUuid) -> Vec<i64> {
    val s: i64 = ble_uuid_short(u);
    var out: Vec<i64> = Vec::new();
    if s >= 0 {
        out.push(s & 0xFF);
        out.push((s >> 8) & 0xFF);
        return out;
    }
    return u.b;
}

pub fn ble_uuid_from_wire(b: & Vec<i64>, off: i64, n: i64) -> BleUuid {
    if n == 2 {
        return ble_uuid16(b.get(off) | (b.get(off + 1) << 8));
    }
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 16 {
        v.push(b.get(off + i));
        i = i + 1;
    }
    return BleUuid { b: v };
}

pub fn ble_uuid_eq(a: & BleUuid, b: & BleUuid) -> bool {
    var i: i64 = 0;
    while i < 16 {
        if a.b.get(i) != b.b.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ─── Advertising data ───────────────────────────────────────────────────

pub const AD_FLAGS: i64 = 0x01;
pub const AD_UUID16_INCOMPLETE: i64 = 0x02;
pub const AD_UUID16_COMPLETE: i64 = 0x03;
pub const AD_UUID128_INCOMPLETE: i64 = 0x06;
pub const AD_UUID128_COMPLETE: i64 = 0x07;
pub const AD_NAME_SHORT: i64 = 0x08;
pub const AD_NAME_COMPLETE: i64 = 0x09;
pub const AD_TX_POWER: i64 = 0x0A;
pub const AD_APPEARANCE: i64 = 0x19;
pub const AD_SERVICE_DATA16: i64 = 0x16;
pub const AD_MANUFACTURER: i64 = 0xFF;
pub const AD_FLAG_LE_LIMITED: i64 = 0x01;
pub const AD_FLAG_LE_GENERAL: i64 = 0x02;
pub const AD_FLAG_NO_BREDR: i64 = 0x04;
pub const BLE_ADV_MAX: i64 = 31;

pub struct AdStruct {
    pub ad_type: i64,
    pub data: Vec<i64>,
}

pub fn ad_struct(t: i64, data: Vec<i64>) -> AdStruct {
    return AdStruct { ad_type: t, data: data };
}

pub fn ad_flags(f: i64) -> AdStruct {
    var d: Vec<i64> = Vec::new();
    d.push(f & 0xFF);
    return ad_struct(AD_FLAGS, d);
}

pub fn ad_name(name: str) -> AdStruct {
    return ad_struct(AD_NAME_COMPLETE, str_bytes(name));
}

pub fn ad_uuid16_list(uuids: & Vec<i64>) -> AdStruct {
    var d: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < uuids.len() {
        d.push(uuids.get(i) & 0xFF);
        d.push((uuids.get(i) >> 8) & 0xFF);
        i = i + 1;
    }
    return ad_struct(AD_UUID16_COMPLETE, d);
}

pub fn ad_tx_power(dbm: i64) -> AdStruct {
    var d: Vec<i64> = Vec::new();
    d.push(dbm & 0xFF);
    return ad_struct(AD_TX_POWER, d);
}

pub fn ad_manufacturer(company: i64, payload: & Vec<i64>) -> AdStruct {
    var d: Vec<i64> = Vec::new();
    d.push(company & 0xFF);
    d.push((company >> 8) & 0xFF);
    var i: i64 = 0;
    while i < payload.len() {
        d.push(payload.get(i) & 0xFF);
        i = i + 1;
    }
    return ad_struct(AD_MANUFACTURER, d);
}

pub fn ad_service_data16(uuid: i64, payload: & Vec<i64>) -> AdStruct {
    var d: Vec<i64> = Vec::new();
    d.push(uuid & 0xFF);
    d.push((uuid >> 8) & 0xFF);
    var i: i64 = 0;
    while i < payload.len() {
        d.push(payload.get(i) & 0xFF);
        i = i + 1;
    }
    return ad_struct(AD_SERVICE_DATA16, d);
}

/// Encode AD structures; an empty result when they exceed max_len.
pub fn ad_encode(list: & Vec<AdStruct>, max_len: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < list.len() {
        val a: AdStruct = list.get(i);
        out.push(a.data.len() + 1);
        out.push(a.ad_type & 0xFF);
        var j: i64 = 0;
        while j < a.data.len() {
            out.push(a.data.get(j) & 0xFF);
            j = j + 1;
        }
        i = i + 1;
    }
    if out.len() > max_len {
        return Vec::new();
    }
    return out;
}

/// Parse advertising data; stops at a zero length (padding) or at a
/// structure that runs past the end.
pub fn ad_parse(bytes: & Vec<i64>) -> Vec<AdStruct> {
    var list: Vec<AdStruct> = Vec::new();
    var p: i64 = 0;
    while p < bytes.len() {
        val len: i64 = bytes.get(p);
        if len == 0 || p + 1 + len > bytes.len() {
            break;
        }
        var d: Vec<i64> = Vec::new();
        var j: i64 = 2;
        while j <= len {
            d.push(bytes.get(p + j));
            j = j + 1;
        }
        list.push(AdStruct { ad_type: bytes.get(p + 1), data: d });
        p = p + 1 + len;
    }
    return list;
}

/// The data of the first structure of a type (empty if absent).
pub fn ad_find(list: & Vec<AdStruct>, t: i64) -> Vec<i64> {
    var i: i64 = 0;
    while i < list.len() {
        if list.get(i).ad_type == t {
            return list.get(i).data;
        }
        i = i + 1;
    }
    return Vec::new();
}

pub fn ad_find_name(list: & Vec<AdStruct>) -> str {
    var d: Vec<i64> = ad_find(list, AD_NAME_COMPLETE);
    if d.len() == 0 {
        d = ad_find(list, AD_NAME_SHORT);
    }
    return str_from_bytes(d);
}

/// Apple iBeacon manufacturer data (company 0x004C, type 0x02, length
/// 0x15, proximity UUID big-endian, major, minor, measured power).
pub fn ad_ibeacon(uuid_be: & Vec<i64>, major: i64, minor: i64, power: i64) -> AdStruct {
    var p: Vec<i64> = Vec::new();
    p.push(0x02);
    p.push(0x15);
    var i: i64 = 0;
    while i < 16 {
        p.push(uuid_be.get(i));
        i = i + 1;
    }
    p.push((major >> 8) & 0xFF);
    p.push(major & 0xFF);
    p.push((minor >> 8) & 0xFF);
    p.push(minor & 0xFF);
    p.push(power & 0xFF);
    return ad_manufacturer(0x004C, & p);
}

// ─── ATT ────────────────────────────────────────────────────────────────

pub const ATT_ERROR_RSP: i64 = 0x01;
pub const ATT_MTU_REQ: i64 = 0x02;
pub const ATT_MTU_RSP: i64 = 0x03;
pub const ATT_FIND_INFO_REQ: i64 = 0x04;
pub const ATT_FIND_INFO_RSP: i64 = 0x05;
pub const ATT_READ_BY_TYPE_REQ: i64 = 0x08;
pub const ATT_READ_BY_TYPE_RSP: i64 = 0x09;
pub const ATT_READ_REQ: i64 = 0x0A;
pub const ATT_READ_RSP: i64 = 0x0B;
pub const ATT_READ_BLOB_REQ: i64 = 0x0C;
pub const ATT_READ_BLOB_RSP: i64 = 0x0D;
pub const ATT_READ_BY_GROUP_REQ: i64 = 0x10;
pub const ATT_READ_BY_GROUP_RSP: i64 = 0x11;
pub const ATT_WRITE_REQ: i64 = 0x12;
pub const ATT_WRITE_RSP: i64 = 0x13;
pub const ATT_WRITE_CMD: i64 = 0x52;
pub const ATT_NOTIFY: i64 = 0x1B;
pub const ATT_INDICATE: i64 = 0x1D;
pub const ATT_CONFIRM: i64 = 0x1E;

pub const ATT_ERR_INVALID_HANDLE: i64 = 0x01;
pub const ATT_ERR_READ_NOT_PERMITTED: i64 = 0x02;
pub const ATT_ERR_WRITE_NOT_PERMITTED: i64 = 0x03;
pub const ATT_ERR_INVALID_PDU: i64 = 0x04;
pub const ATT_ERR_REQUEST_NOT_SUPPORTED: i64 = 0x06;
pub const ATT_ERR_INVALID_OFFSET: i64 = 0x07;
pub const ATT_ERR_ATTRIBUTE_NOT_FOUND: i64 = 0x0A;
pub const ATT_ERR_INVALID_VALUE_LENGTH: i64 = 0x0D;
pub const ATT_ERR_UNSUPPORTED_GROUP_TYPE: i64 = 0x10;

pub const ATT_DEFAULT_MTU: i64 = 23;

fn ble_u16(out: & mut Vec<i64>, v: i64) {
    out.push(v & 0xFF);
    out.push((v >> 8) & 0xFF);
}

fn ble_get16(b: & Vec<i64>, i: i64) -> i64 {
    return (b.get(i) & 0xFF) | ((b.get(i + 1) & 0xFF) << 8);
}

fn ble_append(out: & mut Vec<i64>, d: & Vec<i64>) {
    var i: i64 = 0;
    while i < d.len() {
        out.push(d.get(i) & 0xFF);
        i = i + 1;
    }
}

pub fn att_error_rsp(req_opcode: i64, handle: i64, code: i64) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(ATT_ERROR_RSP);
    p.push(req_opcode);
    ble_u16(& mut p, handle);
    p.push(code);
    return p;
}

pub fn att_mtu_req(mtu: i64) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(ATT_MTU_REQ);
    ble_u16(& mut p, mtu);
    return p;
}

pub fn att_find_info_req(start: i64, end: i64) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(ATT_FIND_INFO_REQ);
    ble_u16(& mut p, start);
    ble_u16(& mut p, end);
    return p;
}

pub fn att_read_by_type_req(start: i64, end: i64, t: & BleUuid) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(ATT_READ_BY_TYPE_REQ);
    ble_u16(& mut p, start);
    ble_u16(& mut p, end);
    ble_append(& mut p, & ble_uuid_wire(t));
    return p;
}

pub fn att_read_by_group_req(start: i64, end: i64, t: & BleUuid) -> Vec<i64> {
    var p: Vec<i64> = att_read_by_type_req(start, end, t);
    p.set(0, ATT_READ_BY_GROUP_REQ);
    return p;
}

pub fn att_read_req(handle: i64) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(ATT_READ_REQ);
    ble_u16(& mut p, handle);
    return p;
}

pub fn att_read_blob_req(handle: i64, offset: i64) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(ATT_READ_BLOB_REQ);
    ble_u16(& mut p, handle);
    ble_u16(& mut p, offset);
    return p;
}

pub fn att_write_req(handle: i64, value: & Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(ATT_WRITE_REQ);
    ble_u16(& mut p, handle);
    ble_append(& mut p, value);
    return p;
}

pub fn att_write_cmd(handle: i64, value: & Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = att_write_req(handle, value);
    p.set(0, ATT_WRITE_CMD);
    return p;
}

pub fn att_notify(handle: i64, value: & Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(ATT_NOTIFY);
    ble_u16(& mut p, handle);
    ble_append(& mut p, value);
    return p;
}

pub fn att_indicate(handle: i64, value: & Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = att_notify(handle, value);
    p.set(0, ATT_INDICATE);
    return p;
}

/// One attribute of a Read By Type / Read By Group Type response.
pub struct AttEntry {
    pub handle: i64,
    pub end_handle: i64,
    pub value: Vec<i64>,
}

/// Decode a Read By Type (0x09) or Read By Group Type (0x11) response.
pub fn att_decode_list(pdu: & Vec<i64>) -> Vec<AttEntry> {
    var out: Vec<AttEntry> = Vec::new();
    if pdu.len() < 2 {
        return out;
    }
    val group: bool = pdu.get(0) == ATT_READ_BY_GROUP_RSP;
    val len: i64 = pdu.get(1);
    var hdr: i64 = 2;
    if group {
        hdr = 4;
    }
    if len < hdr {
        return out;
    }
    var p: i64 = 2;
    while p + len <= pdu.len() {
        var v: Vec<i64> = Vec::new();
        var j: i64 = hdr;
        while j < len {
            v.push(pdu.get(p + j));
            j = j + 1;
        }
        var e: i64 = 0;
        if group {
            e = ble_get16(pdu, p + 2);
        }
        out.push(AttEntry { handle: ble_get16(pdu, p), end_handle: e, value: v });
        p = p + len;
    }
    return out;
}

// ─── GATT database and server ───────────────────────────────────────────

pub const GATT_PRIMARY_SERVICE: i64 = 0x2800;
pub const GATT_SECONDARY_SERVICE: i64 = 0x2801;
pub const GATT_INCLUDE: i64 = 0x2802;
pub const GATT_CHARACTERISTIC: i64 = 0x2803;
pub const GATT_CCCD: i64 = 0x2902;
pub const GATT_PROP_BROADCAST: i64 = 0x01;
pub const GATT_PROP_READ: i64 = 0x02;
pub const GATT_PROP_WRITE_NR: i64 = 0x04;
pub const GATT_PROP_WRITE: i64 = 0x08;
pub const GATT_PROP_NOTIFY: i64 = 0x10;
pub const GATT_PROP_INDICATE: i64 = 0x20;
pub const GATT_PERM_READ: i64 = 1;
pub const GATT_PERM_WRITE: i64 = 2;

pub struct GattAttr {
    pub handle: i64,
    pub atype: BleUuid,
    pub value: Vec<i64>,
    pub perms: i64,
    pub group_end: i64,
}

pub struct GattDb {
    pub attrs: Vec<GattAttr>,
    pub mtu: i64,
    pub server_mtu: i64,
}

pub fn gatt_db_new(server_mtu: i64) -> GattDb {
    return GattDb { attrs: Vec::new(), mtu: ATT_DEFAULT_MTU, server_mtu: server_mtu };
}

fn gatt_add(db: & mut GattDb, t: BleUuid, value: Vec<i64>, perms: i64) -> i64 {
    val h: i64 = db.attrs.len() + 1;
    db.attrs.push(GattAttr { handle: h, atype: t, value: value, perms: perms, group_end: h });
    var i: i64 = db.attrs.len() - 1;
    // extend the enclosing service's group
    while i >= 0 {
        val a: GattAttr = db.attrs.get(i);
        val s: i64 = ble_uuid_short(& a.atype);
        if s == GATT_PRIMARY_SERVICE || s == GATT_SECONDARY_SERVICE {
            var x: GattAttr = a;
            x.group_end = h;
            db.attrs.set(i, x);
            break;
        }
        i = i - 1;
    }
    return h;
}

/// A primary service; its handle.
pub fn gatt_add_service(db: & mut GattDb, uuid: & BleUuid) -> i64 {
    return gatt_add(db, ble_uuid16(GATT_PRIMARY_SERVICE), ble_uuid_wire(uuid), GATT_PERM_READ);
}

/// A characteristic: its declaration, the value (permissions from the
/// properties) and a CCCD when it notifies or indicates. The value handle.
pub fn gatt_add_characteristic(db: & mut GattDb, uuid: & BleUuid, props: i64, value: Vec<i64>) -> i64 {
    val decl_h: i64 = db.attrs.len() + 1;
    var decl: Vec<i64> = Vec::new();
    decl.push(props & 0xFF);
    ble_u16(& mut decl, decl_h + 1);
    ble_append(& mut decl, & ble_uuid_wire(uuid));
    gatt_add(db, ble_uuid16(GATT_CHARACTERISTIC), decl, GATT_PERM_READ);
    var perms: i64 = 0;
    if (props & GATT_PROP_READ) != 0 {
        perms = perms | GATT_PERM_READ;
    }
    if (props & (GATT_PROP_WRITE | GATT_PROP_WRITE_NR)) != 0 {
        perms = perms | GATT_PERM_WRITE;
    }
    val vh: i64 = gatt_add(db, BleUuid { b: uuid.b }, value, perms);
    if (props & (GATT_PROP_NOTIFY | GATT_PROP_INDICATE)) != 0 {
        var z: Vec<i64> = Vec::new();
        z.push(0);
        z.push(0);
        gatt_add(db, ble_uuid16(GATT_CCCD), z, GATT_PERM_READ | GATT_PERM_WRITE);
    }
    return vh;
}

pub fn gatt_get(db: & GattDb, handle: i64) -> Vec<i64> {
    if handle < 1 || handle > db.attrs.len() {
        return Vec::new();
    }
    return db.attrs.get(handle - 1).value;
}

/// Set a value from the application side (no permission check).
pub fn gatt_set(db: & mut GattDb, handle: i64, value: Vec<i64>) {
    if handle >= 1 && handle <= db.attrs.len() {
        var a: GattAttr = db.attrs.get(handle - 1);
        a.value = value;
        db.attrs.set(handle - 1, a);
    }
}

/// The CCCD bits (1 notify, 2 indicate) of the characteristic whose value
/// is at `handle`.
pub fn gatt_subscription(db: & GattDb, value_handle: i64) -> i64 {
    if value_handle < 1 || value_handle >= db.attrs.len() {
        return 0;
    }
    val next: GattAttr = db.attrs.get(value_handle);
    if ble_uuid_short(& next.atype) != GATT_CCCD {
        return 0;
    }
    return ble_get16(& next.value, 0);
}

/// Update a value and give the PDU to send: a notification or an
/// indication when the client subscribed, else empty.
pub fn gatt_update(db: & mut GattDb, value_handle: i64, value: Vec<i64>) -> Vec<i64> {
    gatt_set(db, value_handle, value);
    val sub: i64 = gatt_subscription(db, value_handle);
    var v: Vec<i64> = value;
    val room: i64 = db.mtu - 3;
    while v.len() > room {
        v.remove(v.len() - 1);
    }
    if (sub & 1) != 0 {
        return att_notify(value_handle, & v);
    }
    if (sub & 2) != 0 {
        return att_indicate(value_handle, & v);
    }
    return Vec::new();
}

fn gatt_range_ok(start: i64, end: i64) -> bool {
    return start >= 1 && start <= end;
}

/// Answer one ATT PDU from the client. Write commands, notifications'
/// confirmations and unknown commands give an empty answer.
pub fn gatt_handle(db: & mut GattDb, pdu: Vec<i64>) -> Vec<i64> {
    if pdu.len() == 0 {
        return Vec::new();
    }
    val op: i64 = pdu.get(0);
    if op == ATT_MTU_REQ {
        if pdu.len() != 3 {
            return att_error_rsp(op, 0, ATT_ERR_INVALID_PDU);
        }
        var client: i64 = ble_get16(& pdu, 1);
        if client < ATT_DEFAULT_MTU {
            client = ATT_DEFAULT_MTU;
        }
        db.mtu = client;
        if db.server_mtu < db.mtu {
            db.mtu = db.server_mtu;
        }
        var r: Vec<i64> = Vec::new();
        r.push(ATT_MTU_RSP);
        ble_u16(& mut r, db.server_mtu);
        return r;
    }
    if op == ATT_READ_REQ || op == ATT_READ_BLOB_REQ {
        if pdu.len() < 3 {
            return att_error_rsp(op, 0, ATT_ERR_INVALID_PDU);
        }
        val h: i64 = ble_get16(& pdu, 1);
        if h < 1 || h > db.attrs.len() {
            return att_error_rsp(op, h, ATT_ERR_INVALID_HANDLE);
        }
        val a: GattAttr = db.attrs.get(h - 1);
        if (a.perms & GATT_PERM_READ) == 0 {
            return att_error_rsp(op, h, ATT_ERR_READ_NOT_PERMITTED);
        }
        var off: i64 = 0;
        var r: Vec<i64> = Vec::new();
        r.push(ATT_READ_RSP);
        if op == ATT_READ_BLOB_REQ {
            off = ble_get16(& pdu, 3);
            if off > a.value.len() {
                return att_error_rsp(op, h, ATT_ERR_INVALID_OFFSET);
            }
            r.set(0, ATT_READ_BLOB_RSP);
        }
        var i: i64 = off;
        while i < a.value.len() && r.len() < db.mtu {
            r.push(a.value.get(i));
            i = i + 1;
        }
        return r;
    }
    if op == ATT_WRITE_REQ || op == ATT_WRITE_CMD {
        if pdu.len() < 3 {
            if op == ATT_WRITE_CMD {
                return Vec::new();
            }
            return att_error_rsp(op, 0, ATT_ERR_INVALID_PDU);
        }
        val h: i64 = ble_get16(& pdu, 1);
        if h < 1 || h > db.attrs.len() {
            if op == ATT_WRITE_CMD {
                return Vec::new();
            }
            return att_error_rsp(op, h, ATT_ERR_INVALID_HANDLE);
        }
        val a: GattAttr = db.attrs.get(h - 1);
        if (a.perms & GATT_PERM_WRITE) == 0 {
            if op == ATT_WRITE_CMD {
                return Vec::new();
            }
            return att_error_rsp(op, h, ATT_ERR_WRITE_NOT_PERMITTED);
        }
        var v: Vec<i64> = Vec::new();
        var i: i64 = 3;
        while i < pdu.len() {
            v.push(pdu.get(i));
            i = i + 1;
        }
        if ble_uuid_short(& a.atype) == GATT_CCCD && v.len() != 2 {
            if op == ATT_WRITE_CMD {
                return Vec::new();
            }
            return att_error_rsp(op, h, ATT_ERR_INVALID_VALUE_LENGTH);
        }
        gatt_set(db, h, v);
        if op == ATT_WRITE_CMD {
            return Vec::new();
        }
        var r: Vec<i64> = Vec::new();
        r.push(ATT_WRITE_RSP);
        return r;
    }
    if op == ATT_FIND_INFO_REQ {
        if pdu.len() != 5 {
            return att_error_rsp(op, 0, ATT_ERR_INVALID_PDU);
        }
        val start: i64 = ble_get16(& pdu, 1);
        val end: i64 = ble_get16(& pdu, 3);
        if !gatt_range_ok(start, end) {
            return att_error_rsp(op, start, ATT_ERR_INVALID_HANDLE);
        }
        var r: Vec<i64> = Vec::new();
        r.push(ATT_FIND_INFO_RSP);
        r.push(0);
        var fmt_len: i64 = 0;
        var h: i64 = start;
        while h <= end && h <= db.attrs.len() {
            val a: GattAttr = db.attrs.get(h - 1);
            val w: Vec<i64> = ble_uuid_wire(& a.atype);
            if fmt_len == 0 {
                fmt_len = w.len();
                if fmt_len == 2 {
                    r.set(1, 1);
                } else {
                    r.set(1, 2);
                }
            }
            if w.len() != fmt_len || r.len() + 2 + fmt_len > db.mtu {
                break;
            }
            ble_u16(& mut r, h);
            ble_append(& mut r, & w);
            h = h + 1;
        }
        if fmt_len == 0 {
            return att_error_rsp(op, start, ATT_ERR_ATTRIBUTE_NOT_FOUND);
        }
        return r;
    }
    if op == ATT_READ_BY_TYPE_REQ || op == ATT_READ_BY_GROUP_REQ {
        if pdu.len() != 7 && pdu.len() != 21 {
            return att_error_rsp(op, 0, ATT_ERR_INVALID_PDU);
        }
        val start: i64 = ble_get16(& pdu, 1);
        val end: i64 = ble_get16(& pdu, 3);
        if !gatt_range_ok(start, end) {
            return att_error_rsp(op, start, ATT_ERR_INVALID_HANDLE);
        }
        val t: BleUuid = ble_uuid_from_wire(& pdu, 5, pdu.len() - 5);
        val group: bool = op == ATT_READ_BY_GROUP_REQ;
        if group {
            val ts: i64 = ble_uuid_short(& t);
            if ts != GATT_PRIMARY_SERVICE && ts != GATT_SECONDARY_SERVICE {
                return att_error_rsp(op, start, ATT_ERR_UNSUPPORTED_GROUP_TYPE);
            }
        }
        var r: Vec<i64> = Vec::new();
        if group {
            r.push(ATT_READ_BY_GROUP_RSP);
        } else {
            r.push(ATT_READ_BY_TYPE_RSP);
        }
        r.push(0);
        var each: i64 = 0 - 1;
        var h: i64 = start;
        while h <= end && h <= db.attrs.len() {
            val a: GattAttr = db.attrs.get(h - 1);
            if ble_uuid_eq(& a.atype, & t) {
                if (a.perms & GATT_PERM_READ) == 0 {
                    if each < 0 {
                        return att_error_rsp(op, h, ATT_ERR_READ_NOT_PERMITTED);
                    }
                    break;
                }
                var vlen: i64 = a.value.len();
                var hdr: i64 = 2;
                if group {
                    hdr = 4;
                }
                if hdr + vlen > 255 {
                    vlen = 255 - hdr;
                }
                if hdr + vlen > db.mtu - 2 {
                    vlen = db.mtu - 2 - hdr;
                }
                if each < 0 {
                    each = hdr + vlen;
                    r.set(1, each);
                } else if hdr + vlen != each {
                    break;
                }
                if r.len() + each > db.mtu {
                    break;
                }
                ble_u16(& mut r, h);
                if group {
                    ble_u16(& mut r, a.group_end);
                }
                var j: i64 = 0;
                while j < vlen {
                    r.push(a.value.get(j));
                    j = j + 1;
                }
                if group {
                    h = a.group_end;
                }
            }
            h = h + 1;
        }
        if each < 0 {
            return att_error_rsp(op, start, ATT_ERR_ATTRIBUTE_NOT_FOUND);
        }
        return r;
    }
    if op == ATT_CONFIRM || op == ATT_WRITE_CMD {
        return Vec::new();
    }
    if (op & 0x40) != 0 {
        return Vec::new();
    }
    return att_error_rsp(op, 0, ATT_ERR_REQUEST_NOT_SUPPORTED);
}

// ─── L2CAP ──────────────────────────────────────────────────────────────

pub const L2CAP_CID_ATT: i64 = 0x0004;
pub const L2CAP_CID_SIGNALING: i64 = 0x0005;
pub const L2CAP_CID_SMP: i64 = 0x0006;

pub fn l2cap_frame(cid: i64, payload: & Vec<i64>) -> Vec<i64> {
    var f: Vec<i64> = Vec::new();
    ble_u16(& mut f, payload.len());
    ble_u16(& mut f, cid);
    ble_append(& mut f, payload);
    return f;
}

/// [cid, payload...] of a complete basic frame; empty if the length
/// field does not match.
pub fn l2cap_unframe(frame: & Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if frame.len() < 4 {
        return out;
    }
    val len: i64 = ble_get16(frame, 0);
    if frame.len() != 4 + len {
        return out;
    }
    out.push(ble_get16(frame, 2));
    var i: i64 = 4;
    while i < frame.len() {
        out.push(frame.get(i));
        i = i + 1;
    }
    return out;
}

// ─── HCI ────────────────────────────────────────────────────────────────

pub const HCI_COMMAND_PKT: i64 = 0x01;
pub const HCI_ACL_PKT: i64 = 0x02;
pub const HCI_EVENT_PKT: i64 = 0x04;
pub const HCI_EV_DISCONN_COMPLETE: i64 = 0x05;
pub const HCI_EV_CMD_COMPLETE: i64 = 0x0E;
pub const HCI_EV_CMD_STATUS: i64 = 0x0F;
pub const HCI_EV_LE_META: i64 = 0x3E;
pub const HCI_LE_ADV_REPORT: i64 = 0x02;
pub const HCI_LE_CONN_COMPLETE: i64 = 0x01;

pub fn hci_opcode(ogf: i64, ocf: i64) -> i64 {
    return ((ogf & 0x3F) << 10) | (ocf & 0x3FF);
}

pub fn hci_op_reset() -> i64 {
    return hci_opcode(0x03, 0x0003);
}

pub fn hci_op_le_set_adv_params() -> i64 {
    return hci_opcode(0x08, 0x0006);
}

pub fn hci_op_le_set_adv_data() -> i64 {
    return hci_opcode(0x08, 0x0008);
}

pub fn hci_op_le_set_scan_rsp_data() -> i64 {
    return hci_opcode(0x08, 0x0009);
}

pub fn hci_op_le_set_adv_enable() -> i64 {
    return hci_opcode(0x08, 0x000A);
}

pub fn hci_op_le_set_scan_params() -> i64 {
    return hci_opcode(0x08, 0x000B);
}

pub fn hci_op_le_set_scan_enable() -> i64 {
    return hci_opcode(0x08, 0x000C);
}

/// An H4 command packet: 0x01, opcode (LE), parameter length, parameters.
pub fn hci_command(opcode: i64, params: & Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(HCI_COMMAND_PKT);
    ble_u16(& mut p, opcode);
    p.push(params.len() & 0xFF);
    ble_append(& mut p, params);
    return p;
}

pub fn hci_reset() -> Vec<i64> {
    return hci_command(hci_op_reset(), & Vec::new());
}

/// LE Set Advertising Parameters: intervals in 0.625 ms units, type
/// (0 ADV_IND, 2 ADV_SCAN_IND, 3 ADV_NONCONN_IND), own address type,
/// channel map 0x07, no filter.
pub fn hci_le_set_adv_params(min_int: i64, max_int: i64, adv_type: i64, own_addr_type: i64) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    ble_u16(& mut p, min_int);
    ble_u16(& mut p, max_int);
    p.push(adv_type);
    p.push(own_addr_type);
    p.push(0);
    var i: i64 = 0;
    while i < 6 {
        p.push(0);
        i = i + 1;
    }
    p.push(0x07);
    p.push(0x00);
    return hci_command(hci_op_le_set_adv_params(), & p);
}

/// LE Set Advertising Data: length byte, then 31 bytes (zero padded).
pub fn hci_le_set_adv_data(ad: & Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(ad.len());
    var i: i64 = 0;
    while i < 31 {
        if i < ad.len() {
            p.push(ad.get(i) & 0xFF);
        } else {
            p.push(0);
        }
        i = i + 1;
    }
    return hci_command(hci_op_le_set_adv_data(), & p);
}

pub fn hci_le_set_adv_enable(on: bool) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    if on {
        p.push(1);
    } else {
        p.push(0);
    }
    return hci_command(hci_op_le_set_adv_enable(), & p);
}

/// LE Set Scan Parameters: active (true) or passive, interval and window
/// in 0.625 ms units.
pub fn hci_le_set_scan_params(active: bool, interval: i64, window: i64) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    if active {
        p.push(1);
    } else {
        p.push(0);
    }
    ble_u16(& mut p, interval);
    ble_u16(& mut p, window);
    p.push(0);
    p.push(0);
    return hci_command(hci_op_le_set_scan_params(), & p);
}

pub fn hci_le_set_scan_enable(on: bool, filter_dup: bool) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    if on {
        p.push(1);
    } else {
        p.push(0);
    }
    if filter_dup {
        p.push(1);
    } else {
        p.push(0);
    }
    return hci_command(hci_op_le_set_scan_enable(), & p);
}

/// A decoded event. kind: the event code; for Command Complete / Status
/// opcode and status (Complete: the first return parameter); for LE Meta
/// the subevent; params are the bytes after the event header.
pub struct HciEvent {
    pub code: i64,
    pub opcode: i64,
    pub status: i64,
    pub subevent: i64,
    pub params: Vec<i64>,
    pub ok: bool,
}

/// Decode an H4 event packet (0x04, code, length, parameters).
pub fn hci_decode_event(pkt: & Vec<i64>) -> HciEvent {
    var e: HciEvent = HciEvent { code: 0, opcode: 0, status: 0, subevent: 0, params: Vec::new(), ok: false };
    if pkt.len() < 3 || pkt.get(0) != HCI_EVENT_PKT {
        return e;
    }
    val len: i64 = pkt.get(2);
    if pkt.len() != 3 + len {
        return e;
    }
    e.code = pkt.get(1);
    var i: i64 = 3;
    while i < pkt.len() {
        e.params.push(pkt.get(i));
        i = i + 1;
    }
    if e.code == HCI_EV_CMD_COMPLETE && len >= 3 {
        e.opcode = ble_get16(& e.params, 1);
        if len >= 4 {
            e.status = e.params.get(3);
        }
    } else if e.code == HCI_EV_CMD_STATUS && len >= 4 {
        e.status = e.params.get(0);
        e.opcode = ble_get16(& e.params, 2);
    } else if e.code == HCI_EV_LE_META && len >= 1 {
        e.subevent = e.params.get(0);
    } else if e.code == HCI_EV_DISCONN_COMPLETE && len >= 4 {
        e.status = e.params.get(0);
    }
    e.ok = true;
    return e;
}

/// One device seen in an LE Advertising Report.
pub struct BleAdvReport {
    pub event_type: i64,
    pub addr_type: i64,
    pub addr: Vec<i64>,
    pub data: Vec<i64>,
    pub rssi: i64,
}

/// The reports of an LE Meta / Advertising Report event's parameters
/// (subevent, num_reports, then the reports one after another).
pub fn hci_decode_adv_reports(params: & Vec<i64>) -> Vec<BleAdvReport> {
    var out: Vec<BleAdvReport> = Vec::new();
    if params.len() < 2 || params.get(0) != HCI_LE_ADV_REPORT {
        return out;
    }
    val n: i64 = params.get(1);
    var p: i64 = 2;
    var k: i64 = 0;
    while k < n && p + 9 <= params.len() {
        val et: i64 = params.get(p);
        val at: i64 = params.get(p + 1);
        var addr: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < 6 {
            addr.push(params.get(p + 2 + i));
            i = i + 1;
        }
        val dl: i64 = params.get(p + 8);
        if p + 9 + dl + 1 > params.len() {
            break;
        }
        var d: Vec<i64> = Vec::new();
        i = 0;
        while i < dl {
            d.push(params.get(p + 9 + i));
            i = i + 1;
        }
        var rssi: i64 = params.get(p + 9 + dl);
        if rssi >= 128 {
            rssi = rssi - 256;
        }
        out.push(BleAdvReport { event_type: et, addr_type: at, addr: addr, data: d, rssi: rssi });
        p = p + 10 + dl;
        k = k + 1;
    }
    return out;
}

/// A device address (6 bytes, wire order) as "AA:BB:CC:DD:EE:FF".
pub fn ble_addr_str(addr: & Vec<i64>) -> str {
    val d: str = "0123456789ABCDEF";
    var s: str = "";
    var i: i64 = addr.len() - 1;
    while i >= 0 {
        val b: i64 = addr.get(i);
        s = s + char_to_str(str_byte_at(d, (b >> 4) & 15)) + char_to_str(str_byte_at(d, b & 15));
        if i > 0 {
            s = s + ":";
        }
        i = i - 1;
    }
    return s;
}

/// An H4 ACL packet: handle (12 bits) | PB flag << 12 | BC flag << 14.
pub fn hci_acl(handle: i64, pb: i64, data: & Vec<i64>) -> Vec<i64> {
    var p: Vec<i64> = Vec::new();
    p.push(HCI_ACL_PKT);
    ble_u16(& mut p, (handle & 0x0FFF) | ((pb & 3) << 12));
    ble_u16(& mut p, data.len());
    ble_append(& mut p, data);
    return p;
}

/// [handle, pb, data...] of an H4 ACL packet; empty when malformed.
pub fn hci_acl_decode(pkt: & Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if pkt.len() < 5 || pkt.get(0) != HCI_ACL_PKT {
        return out;
    }
    val hf: i64 = ble_get16(pkt, 1);
    val len: i64 = ble_get16(pkt, 3);
    if pkt.len() != 5 + len {
        return out;
    }
    out.push(hf & 0x0FFF);
    out.push((hf >> 12) & 3);
    var i: i64 = 5;
    while i < pkt.len() {
        out.push(pkt.get(i));
        i = i + 1;
    }
    return out;
}

/// The controller link: send one H4 packet (0 = sent), receive one (an
/// empty Vec when nothing arrived).
pub struct HciTransport {
    pub handle: i64,
    pub write_pkt: fn(i64, Vec<i64>) -> i64,
    pub read_pkt: fn(i64) -> Vec<i64>,
}

/// Send a command and wait (up to max_packets received) for its Command
/// Complete or Command Status; the event, ok=false on no answer.
pub fn hci_send_command(t: & HciTransport, cmd: Vec<i64>, max_packets: i64) -> HciEvent {
    val tx = t.write_pkt;
    val rx = t.read_pkt;
    val opcode: i64 = ble_get16(& cmd, 1);
    var none: HciEvent = HciEvent { code: 0, opcode: 0, status: 0, subevent: 0, params: Vec::new(), ok: false };
    if tx(t.handle, cmd) != 0 {
        return none;
    }
    var n: i64 = 0;
    while n < max_packets {
        val pkt: Vec<i64> = rx(t.handle);
        if pkt.len() > 0 {
            val e: HciEvent = hci_decode_event(& pkt);
            if e.ok && (e.code == HCI_EV_CMD_COMPLETE || e.code == HCI_EV_CMD_STATUS) && e.opcode == opcode {
                return e;
            }
        }
        n = n + 1;
    }
    return none;
}
