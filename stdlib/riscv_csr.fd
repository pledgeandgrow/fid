// Fides RISC-V machine-level CSRs, PLIC and CLINT, pure Fides.
//
// From the RISC-V Privileged Architecture (version 20211203): CSR numbers
// and their address-space rules (2.1), the fields of mstatus, mie/mip,
// mtvec, mcause, misa, satp and pmpcfg/pmpaddr (3.1, 4.1.11), the trap
// entry and MRET state changes (3.1.6.1, 3.3.2), and the encoding of the
// Zicsr instructions (csrrw/csrrs/csrrc and their immediate forms). The
// PLIC register map follows the RISC-V PLIC specification 1.0.0 and the
// CLINT layout the one of SiFive cores and QEMU virt (msip at +0,
// mtimecmp at +0x4000, mtime at +0xBFF8).
//
// What is real and what is the seam:
//   - CSRs can only be reached with csr* instructions whose CSR number is
//     an immediate, and Fides inline asm is x86 only. So CSR accesses are
//     values: a CsrOp (write / set bits / clear bits of one CSR) and the
//     32-bit instruction that performs it (rv_csr_insn) for the target's
//     trampoline or boot assembly. CsrFile is a software CSR file that
//     applies CsrOps with the WARL masks of the real registers and
//     models trap entry and MRET; tests and simulators use it.
//   - PLIC and CLINT are memory-mapped: their accesses go through a
//     regmap.fd RegBus (regbus_mmio() on hardware, regbus_fake() in tests).
//     PlicSim is the PLIC's arbitration (claim picks the highest-priority
//     pending enabled source above the threshold, lowest ID on a tie).

module riscv_csr;
 use vec; use string; use regmap;

// ─── CSR numbers (Privileged spec tables 2.2-2.6) ───────────────────────

pub const CSR_SSTATUS: i64 = 0x100;
pub const CSR_SIE: i64 = 0x104;
pub const CSR_STVEC: i64 = 0x105;
pub const CSR_SSCRATCH: i64 = 0x140;
pub const CSR_SEPC: i64 = 0x141;
pub const CSR_SCAUSE: i64 = 0x142;
pub const CSR_STVAL: i64 = 0x143;
pub const CSR_SIP: i64 = 0x144;
pub const CSR_SATP: i64 = 0x180;
pub const CSR_MSTATUS: i64 = 0x300;
pub const CSR_MISA: i64 = 0x301;
pub const CSR_MEDELEG: i64 = 0x302;
pub const CSR_MIDELEG: i64 = 0x303;
pub const CSR_MIE: i64 = 0x304;
pub const CSR_MTVEC: i64 = 0x305;
pub const CSR_MCOUNTEREN: i64 = 0x306;
pub const CSR_MSCRATCH: i64 = 0x340;
pub const CSR_MEPC: i64 = 0x341;
pub const CSR_MCAUSE: i64 = 0x342;
pub const CSR_MTVAL: i64 = 0x343;
pub const CSR_MIP: i64 = 0x344;
pub const CSR_PMPCFG0: i64 = 0x3A0;
pub const CSR_PMPADDR0: i64 = 0x3B0;
pub const CSR_MCYCLE: i64 = 0xB00;
pub const CSR_MINSTRET: i64 = 0xB02;
pub const CSR_CYCLE: i64 = 0xC00;
pub const CSR_TIME: i64 = 0xC01;
pub const CSR_INSTRET: i64 = 0xC02;
pub const CSR_MVENDORID: i64 = 0xF11;
pub const CSR_MARCHID: i64 = 0xF12;
pub const CSR_MIMPID: i64 = 0xF13;
pub const CSR_MHARTID: i64 = 0xF14;

pub fn rv_csr_name(c: i64) -> str {
    if c == 0x100 { return "sstatus"; }
    if c == 0x104 { return "sie"; }
    if c == 0x105 { return "stvec"; }
    if c == 0x140 { return "sscratch"; }
    if c == 0x141 { return "sepc"; }
    if c == 0x142 { return "scause"; }
    if c == 0x143 { return "stval"; }
    if c == 0x144 { return "sip"; }
    if c == 0x180 { return "satp"; }
    if c == 0x300 { return "mstatus"; }
    if c == 0x301 { return "misa"; }
    if c == 0x302 { return "medeleg"; }
    if c == 0x303 { return "mideleg"; }
    if c == 0x304 { return "mie"; }
    if c == 0x305 { return "mtvec"; }
    if c == 0x306 { return "mcounteren"; }
    if c == 0x340 { return "mscratch"; }
    if c == 0x341 { return "mepc"; }
    if c == 0x342 { return "mcause"; }
    if c == 0x343 { return "mtval"; }
    if c == 0x344 { return "mip"; }
    if c >= 0x3A0 && c <= 0x3AF { return "pmpcfg" + int_to_str(c - 0x3A0); }
    if c >= 0x3B0 && c <= 0x3EF { return "pmpaddr" + int_to_str(c - 0x3B0); }
    if c == 0xB00 { return "mcycle"; }
    if c == 0xB02 { return "minstret"; }
    if c == 0xC00 { return "cycle"; }
    if c == 0xC01 { return "time"; }
    if c == 0xC02 { return "instret"; }
    if c == 0xF11 { return "mvendorid"; }
    if c == 0xF12 { return "marchid"; }
    if c == 0xF13 { return "mimpid"; }
    if c == 0xF14 { return "mhartid"; }
    return "csr" + regmap_hex(c, 3);
}

/// CSR address bits 11:10 == 0b11: read-only (2.1).
pub fn rv_csr_readonly(c: i64) -> bool {
    return ((c >> 10) & 3) == 3;
}

/// Lowest privilege level that may access the CSR: bits 9:8 (0 U, 1 S,
/// 2 hypervisor, 3 M).
pub fn rv_csr_priv(c: i64) -> i64 {
    return (c >> 8) & 3;
}

// ─── Privilege modes ────────────────────────────────────────────────────

pub const RV_PRIV_U: i64 = 0;
pub const RV_PRIV_S: i64 = 1;
pub const RV_PRIV_M: i64 = 3;

pub fn rv_priv_name(p: i64) -> str {
    if p == 0 { return "U"; }
    if p == 1 { return "S"; }
    if p == 3 { return "M"; }
    return "?";
}

// ─── mstatus (3.1.6) ────────────────────────────────────────────────────

pub const MSTATUS_SIE: i64 = 0x2;
pub const MSTATUS_MIE: i64 = 0x8;
pub const MSTATUS_SPIE: i64 = 0x20;
pub const MSTATUS_MPIE: i64 = 0x80;
pub const MSTATUS_SPP: i64 = 0x100;
pub const MSTATUS_MPP: i64 = 0x1800;
pub const MSTATUS_FS: i64 = 0x6000;
pub const MSTATUS_XS: i64 = 0x18000;
pub const MSTATUS_MPRV: i64 = 0x20000;
pub const MSTATUS_SUM: i64 = 0x40000;
pub const MSTATUS_MXR: i64 = 0x80000;
pub const MSTATUS_TVM: i64 = 0x100000;
pub const MSTATUS_TW: i64 = 0x200000;
pub const MSTATUS_TSR: i64 = 0x400000;

pub fn rv_mstatus_mpp(v: i64) -> i64 {
    return (v >> 11) & 3;
}

pub fn rv_mstatus_with_mpp(v: i64, p: i64) -> i64 {
    return (v & ~MSTATUS_MPP) | ((p & 3) << 11);
}

/// FS/VS/XS states: 0 Off, 1 Initial, 2 Clean, 3 Dirty.
pub fn rv_ext_state_name(s: i64) -> str {
    if s == 0 { return "Off"; }
    if s == 1 { return "Initial"; }
    if s == 2 { return "Clean"; }
    return "Dirty";
}

/// SD for RV64 (bit 63): set when FS, VS or XS is Dirty.
pub fn rv_mstatus_sd(v: i64) -> bool {
    return v < 0;
}

/// Decode mstatus: "MIE=1 MPIE=0 MPP=M SPP=U FS=Dirty SD=1".
pub fn rv_mstatus_decode(v: i64) -> str {
    var out: str = "SIE=" + int_to_str((v >> 1) & 1) + " MIE=" + int_to_str((v >> 3) & 1);
    out = out + " SPIE=" + int_to_str((v >> 5) & 1) + " MPIE=" + int_to_str((v >> 7) & 1);
    out = out + " SPP=" + rv_priv_name((v >> 8) & 1) + " MPP=" + rv_priv_name(rv_mstatus_mpp(v));
    out = out + " FS=" + rv_ext_state_name((v >> 13) & 3);
    if (v & MSTATUS_MPRV) != 0 { out = out + " MPRV"; }
    if (v & MSTATUS_SUM) != 0 { out = out + " SUM"; }
    if (v & MSTATUS_MXR) != 0 { out = out + " MXR"; }
    if (v & MSTATUS_TVM) != 0 { out = out + " TVM"; }
    if (v & MSTATUS_TW) != 0 { out = out + " TW"; }
    if (v & MSTATUS_TSR) != 0 { out = out + " TSR"; }
    if rv_mstatus_sd(v) { out = out + " SD=1"; }
    return out;
}

// ─── mie / mip (3.1.9) ──────────────────────────────────────────────────

pub const RV_IRQ_SSI: i64 = 1;
pub const RV_IRQ_MSI: i64 = 3;
pub const RV_IRQ_STI: i64 = 5;
pub const RV_IRQ_MTI: i64 = 7;
pub const RV_IRQ_SEI: i64 = 9;
pub const RV_IRQ_MEI: i64 = 11;
pub const RV_IRQ_LCOFI: i64 = 13;

pub fn rv_irq_name(code: i64) -> str {
    if code == 1 { return "Supervisor software interrupt"; }
    if code == 3 { return "Machine software interrupt"; }
    if code == 5 { return "Supervisor timer interrupt"; }
    if code == 7 { return "Machine timer interrupt"; }
    if code == 9 { return "Supervisor external interrupt"; }
    if code == 11 { return "Machine external interrupt"; }
    if code == 13 { return "Counter-overflow interrupt"; }
    if code >= 16 { return "Platform interrupt " + int_to_str(code); }
    return "Reserved interrupt " + int_to_str(code);
}

/// The short names of the bits set in mie/mip: "MTIE MEIE" style.
pub fn rv_ip_decode(v: i64) -> str {
    var out: Vec<str> = Vec::new();
    if ((v >> 1) & 1) != 0 { out.push("SSI"); }
    if ((v >> 3) & 1) != 0 { out.push("MSI"); }
    if ((v >> 5) & 1) != 0 { out.push("STI"); }
    if ((v >> 7) & 1) != 0 { out.push("MTI"); }
    if ((v >> 9) & 1) != 0 { out.push("SEI"); }
    if ((v >> 11) & 1) != 0 { out.push("MEI"); }
    if ((v >> 13) & 1) != 0 { out.push("LCOFI"); }
    return str_join(out, " ");
}

/// The interrupt taken among pending & enabled ones, in the priority order
/// of 3.1.9 (MEI, MSI, MTI, SEI, SSI, STI, LCOFI); -1 when none.
pub fn rv_irq_select(mip: i64, mie: i64) -> i64 {
    val p: i64 = mip & mie;
    if p == 0 { return -1; }
    var order: Vec<i64> = Vec::new();
    order.push(11); order.push(3); order.push(7);
    order.push(9); order.push(1); order.push(5); order.push(13);
    var i: i64 = 0;
    while i < order.len() {
        if ((p >> order.get(i)) & 1) != 0 { return order.get(i); }
        i = i + 1;
    }
    var k: i64 = 16;
    while k < 64 {
        if ((p >> k) & 1) != 0 { return k; }
        k = k + 1;
    }
    return -1;
}

// ─── mtvec (3.1.7) ──────────────────────────────────────────────────────

pub const MTVEC_DIRECT: i64 = 0;
pub const MTVEC_VECTORED: i64 = 1;

/// mtvec value: BASE must be 4-byte aligned.
pub fn rv_mtvec(base: i64, mode: i64) -> i64 {
    if (base & 3) != 0 { p_panic("riscv_csr: mtvec base " + regmap_hex(base, 8) + " is not 4-byte aligned"); }
    if mode != 0 && mode != 1 { p_panic("riscv_csr: mtvec mode must be 0 (direct) or 1 (vectored)"); }
    return base | mode;
}

/// Where a trap with `mcause` goes: BASE for exceptions and in direct
/// mode, BASE + 4 * cause for interrupts in vectored mode.
pub fn rv_mtvec_target(mtvec: i64, mcause: i64, xlen: i64) -> i64 {
    val base: i64 = mtvec & ~3;
    if (mtvec & 3) == 1 && rv_mcause_is_interrupt(mcause, xlen) {
        return base + 4 * rv_mcause_code(mcause, xlen);
    }
    return base;
}

// ─── mcause (3.1.15) ────────────────────────────────────────────────────

pub fn rv_mcause_is_interrupt(c: i64, xlen: i64) -> bool {
    return ((c >> (xlen - 1)) & 1) != 0;
}

pub fn rv_mcause_code(c: i64, xlen: i64) -> i64 {
    if xlen == 64 { return c & 0x7FFFFFFFFFFFFFFF; }
    return c & 0x7FFFFFFF;
}

/// mcause for an interrupt `code` on an `xlen` hart.
pub fn rv_mcause_interrupt(code: i64, xlen: i64) -> i64 {
    return (1 << (xlen - 1)) | code;
}

pub fn rv_exception_name(code: i64) -> str {
    if code == 0 { return "Instruction address misaligned"; }
    if code == 1 { return "Instruction access fault"; }
    if code == 2 { return "Illegal instruction"; }
    if code == 3 { return "Breakpoint"; }
    if code == 4 { return "Load address misaligned"; }
    if code == 5 { return "Load access fault"; }
    if code == 6 { return "Store/AMO address misaligned"; }
    if code == 7 { return "Store/AMO access fault"; }
    if code == 8 { return "Environment call from U-mode"; }
    if code == 9 { return "Environment call from S-mode"; }
    if code == 11 { return "Environment call from M-mode"; }
    if code == 12 { return "Instruction page fault"; }
    if code == 13 { return "Load page fault"; }
    if code == 15 { return "Store/AMO page fault"; }
    if code == 18 { return "Software check"; }
    if code == 19 { return "Hardware error"; }
    if code >= 24 && code <= 31 { return "Custom exception " + int_to_str(code); }
    return "Reserved exception " + int_to_str(code);
}

/// The trap named by mcause.
pub fn rv_cause_name(c: i64, xlen: i64) -> str {
    if rv_mcause_is_interrupt(c, xlen) { return rv_irq_name(rv_mcause_code(c, xlen)); }
    return rv_exception_name(rv_mcause_code(c, xlen));
}

/// Exceptions whose mtval holds the faulting address (misaligned, access
/// and page faults; breakpoints may too).
pub fn rv_mtval_is_address(code: i64) -> bool {
    return code == 0 || code == 1 || code == 3 || code == 4 || code == 5 || code == 6 || code == 7
        || code == 12 || code == 13 || code == 15;
}

// ─── misa (3.1.1) ───────────────────────────────────────────────────────

/// "RV64IMAFDCSU": MXL and the extension letters, in alphabet order except
/// that the ISA string puts I/E first as the spec writes it.
pub fn rv_misa_decode(v: i64, xlen: i64) -> str {
    val mxl: i64 = (v >> (xlen - 2)) & 3;
    var out: str = "RV";
    if mxl == 1 { out = out + "32"; }
    if mxl == 2 { out = out + "64"; }
    if mxl == 3 { out = out + "128"; }
    val letters: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    if (v & (1 << 8)) != 0 { out = out + "I"; }
    if (v & (1 << 4)) != 0 { out = out + "E"; }
    var order: str = "MAFDQCBVHSUXN";
    var i: i64 = 0;
    while i < str_len(order) {
        val ch: i64 = str_byte_at(order, i) - 65;
        if (v & (1 << ch)) != 0 { out = out + str_slice(letters, ch, ch + 1); }
        i = i + 1;
    }
    return out;
}

/// Build misa from MXL and a letter string ("IMAC").
pub fn rv_misa(mxl: i64, exts: str, xlen: i64) -> i64 {
    var v: i64 = (mxl & 3) << (xlen - 2);
    var i: i64 = 0;
    while i < str_len(exts) {
        val ch: i64 = str_byte_at(exts, i) - 65;
        if ch >= 0 && ch < 26 { v = v | (1 << ch); }
        i = i + 1;
    }
    return v;
}

// ─── satp (4.1.11) ──────────────────────────────────────────────────────

pub const SATP_BARE: i64 = 0;
pub const SATP_SV39: i64 = 8;
pub const SATP_SV48: i64 = 9;
pub const SATP_SV57: i64 = 10;

/// RV64 satp: MODE[63:60] ASID[59:44] PPN[43:0], from the root page
/// table's physical address.
pub fn rv_satp(mode: i64, asid: i64, root_pa: i64) -> i64 {
    if (root_pa & 0xFFF) != 0 { p_panic("riscv_csr: page table root must be 4 KiB aligned"); }
    return ((mode & 0xF) << 60) | ((asid & 0xFFFF) << 44) | ((root_pa >> 12) & 0xFFFFFFFFFFF);
}

pub fn rv_satp_decode(v: i64) -> str {
    val mode: i64 = (v >> 60) & 0xF;
    var ms: str = "mode" + int_to_str(mode);
    if mode == 0 { ms = "Bare"; }
    if mode == 8 { ms = "Sv39"; }
    if mode == 9 { ms = "Sv48"; }
    if mode == 10 { ms = "Sv57"; }
    return ms + " ASID=" + int_to_str((v >> 44) & 0xFFFF) + " root=" + regmap_hex((v & 0xFFFFFFFFFFF) << 12, 8);
}

// ─── PMP (3.7) ──────────────────────────────────────────────────────────

pub const PMP_R: i64 = 1;
pub const PMP_W: i64 = 2;
pub const PMP_X: i64 = 4;
pub const PMP_OFF: i64 = 0;
pub const PMP_TOR: i64 = 1;
pub const PMP_NA4: i64 = 2;
pub const PMP_NAPOT: i64 = 3;
pub const PMP_L: i64 = 0x80;

/// One pmpNcfg byte.
pub fn rv_pmpcfg(perms: i64, amode: i64, locked: bool) -> i64 {
    var v: i64 = (perms & 7) | ((amode & 3) << 3);
    if locked { v = v | PMP_L; }
    return v;
}

/// pmpaddr for a NAPOT region (size a power of two >= 8, base aligned):
/// (base >> 2) with size/8 - 1 in the low bits.
pub fn rv_pmp_napot(base: i64, size: i64) -> i64 {
    if size < 8 || (size & (size - 1)) != 0 { p_panic("riscv_csr: NAPOT size must be a power of two >= 8"); }
    if (base & (size - 1)) != 0 { p_panic("riscv_csr: NAPOT base not aligned to its size"); }
    return (base >> 2) | ((size >> 3) - 1);
}

/// Decode a NAPOT pmpaddr: base * 2^32-free form "base 0x... size N".
pub fn rv_pmp_napot_decode(addr: i64) -> str {
    var ones: i64 = 0;
    while ones < 62 && ((addr >> ones) & 1) == 1 { ones = ones + 1; }
    val size: i64 = 1 << (ones + 3);
    val base: i64 = (addr & ~((1 << ones) - 1)) << 2;
    return "base " + regmap_hex(base, 8) + " size " + int_to_str(size);
}

/// A pmpcfg byte as text: "NAPOT RW- L".
pub fn rv_pmpcfg_decode(c: i64) -> str {
    val a: i64 = (c >> 3) & 3;
    var out: str = "OFF";
    if a == 1 { out = "TOR"; }
    if a == 2 { out = "NA4"; }
    if a == 3 { out = "NAPOT"; }
    out = out + " ";
    if (c & 1) != 0 { out = out + "R"; } else { out = out + "-"; }
    if (c & 2) != 0 { out = out + "W"; } else { out = out + "-"; }
    if (c & 4) != 0 { out = out + "X"; } else { out = out + "-"; }
    if (c & PMP_L) != 0 { out = out + " L"; }
    return out;
}

// ─── Zicsr instructions ─────────────────────────────────────────────────

pub const CSR_OP_WRITE: i64 = 1;
pub const CSR_OP_SET: i64 = 2;
pub const CSR_OP_CLEAR: i64 = 3;

/// One CSR access: write `value`, set its bits or clear its bits.
pub struct CsrOp {
    pub op: i64,
    pub csr: i64,
    pub value: i64,
}

pub fn csr_op(op: i64, csr: i64, value: i64) -> CsrOp {
    return CsrOp { op: op, csr: csr, value: value };
}

/// Encode csrrw/csrrs/csrrc rd, csr, rs1 (funct3 1/2/3) or, with `imm`,
/// csrrwi/csrrsi/csrrci rd, csr, uimm (funct3 5/6/7, rs1 holds uimm[4:0]).
pub fn rv_csr_insn(op: i64, rd: i64, csr: i64, rs1: i64, imm: bool) -> i64 {
    var f3: i64 = op;
    if imm { f3 = op + 4; }
    return ((csr & 0xFFF) << 20) | ((rs1 & 31) << 15) | (f3 << 12) | ((rd & 31) << 7) | 0x73;
}

/// csrr rd, csr (csrrs rd, csr, x0).
pub fn rv_csrr(rd: i64, csr: i64) -> i64 {
    return rv_csr_insn(CSR_OP_SET, rd, csr, 0, false);
}

/// csrw csr, rs (csrrw x0, csr, rs).
pub fn rv_csrw(csr: i64, rs: i64) -> i64 {
    return rv_csr_insn(CSR_OP_WRITE, 0, csr, rs, false);
}

pub const RV_MRET: i64 = 0x30200073;
pub const RV_SRET: i64 = 0x10200073;
pub const RV_WFI: i64 = 0x10500073;
pub const RV_ECALL: i64 = 0x00000073;
pub const RV_EBREAK: i64 = 0x00100073;

/// Decode a Zicsr instruction: "csrrs a0, mhartid, zero". "" when it is
/// not one.
pub fn rv_csr_disasm(insn: i64) -> str {
    if (insn & 0x7F) != 0x73 { return ""; }
    val f3: i64 = (insn >> 12) & 7;
    if f3 == 0 || f3 == 4 { return ""; }
    val rd: i64 = (insn >> 7) & 31;
    val rs1: i64 = (insn >> 15) & 31;
    val csr: i64 = (insn >> 20) & 0xFFF;
    var names: Vec<str> = str_split("csrrw,csrrs,csrrc", ",");
    var mn: str = names.get((f3 & 3) - 1);
    var src: str = rv_reg_name(rs1);
    if f3 >= 5 { mn = mn + "i"; src = int_to_str(rs1); }
    return mn + " " + rv_reg_name(rd) + ", " + rv_csr_name(csr) + ", " + src;
}

/// ABI register names x0..x31.
pub fn rv_reg_name(r: i64) -> str {
    val names: Vec<str> = str_split("zero,ra,sp,gp,tp,t0,t1,t2,s0,s1,a0,a1,a2,a3,a4,a5,a6,a7,s2,s3,s4,s5,s6,s7,s8,s9,s10,s11,t3,t4,t5,t6", ",");
    return names.get(r & 31);
}

// ─── A software CSR file ────────────────────────────────────────────────

/// CSR values with the write masks (WARL) of the M-mode registers, the
/// current privilege level and the pc for trap modelling.
pub struct CsrFile {
    pub xlen: i64,
    pub vals: HashMap<i64, i64>,
    pub wmask: HashMap<i64, i64>,
    pub priv_: i64,
    pub pc: i64,
}

/// A hart in M-mode after reset: misa as given, mstatus.MPP = M,
/// everything else 0. Writable bits: mstatus (SIE MIE SPIE MPIE SPP MPP
/// FS MPRV SUM MXR TVM TW TSR), mie/mip's standard bits (mip: only the
/// S-level pending bits are writable from software), mtvec with mode 0/1,
/// mepc with bit 0 clear (IALIGN 16, C extension), mscratch, mcause, mtval.
pub fn csrfile_new(xlen: i64, misa: i64, hartid: i64) -> CsrFile {
    var f: CsrFile = CsrFile { xlen: xlen, vals: HashMap::new(), wmask: HashMap::new(), priv_: RV_PRIV_M, pc: 0 };
    f.vals.insert(CSR_MISA, misa);
    f.vals.insert(CSR_MHARTID, hartid);
    f.vals.insert(CSR_MSTATUS, MSTATUS_MPP);
    f.wmask.insert(CSR_MSTATUS, MSTATUS_SIE | MSTATUS_MIE | MSTATUS_SPIE | MSTATUS_MPIE | MSTATUS_SPP | MSTATUS_MPP
        | MSTATUS_FS | MSTATUS_MPRV | MSTATUS_SUM | MSTATUS_MXR | MSTATUS_TVM | MSTATUS_TW | MSTATUS_TSR);
    f.wmask.insert(CSR_MIE, 0x2AAA);
    f.wmask.insert(CSR_MIP, 0x222);
    f.wmask.insert(CSR_MTVEC, ~2);
    f.wmask.insert(CSR_MEPC, ~1);
    f.wmask.insert(CSR_MSCRATCH, -1);
    f.wmask.insert(CSR_MCAUSE, -1);
    f.wmask.insert(CSR_MTVAL, -1);
    f.wmask.insert(CSR_MEDELEG, 0xB3FF);
    f.wmask.insert(CSR_MIDELEG, 0x222);
    f.wmask.insert(CSR_SATP, -1);
    f.wmask.insert(CSR_MCOUNTEREN, 7);
    var i: i64 = 0;
    while i < 16 {
        f.wmask.insert(CSR_PMPADDR0 + i, 0x003FFFFFFFFFFFFF);
        i = i + 1;
    }
    f.wmask.insert(CSR_PMPCFG0, -1);
    f.wmask.insert(CSR_PMPCFG0 + 2, -1);
    return f;
}

pub fn csrfile_get(f: &CsrFile, csr: i64) -> i64 {
    if f.vals.contains(csr) { return f.vals.get(csr); }
    return 0;
}

/// Hardware-side set (a timer or the PLIC raising mip bits).
pub fn csrfile_poke(f: &mut CsrFile, csr: i64, v: i64) {
    f.vals.insert(csr, v);
}

/// Apply one CsrOp as the hart would: an access below the CSR's privilege
/// or a write to a read-only CSR is an illegal-instruction trap (result
/// -1, nothing changed; csrrs/csrrc with value 0 do not write and are
/// allowed on read-only CSRs). Otherwise the old value is returned and
/// the new one stored through the WARL mask (mtvec bit 1 is not
/// writable: modes 2 and 3 are reserved).
pub fn csrfile_apply(f: &mut CsrFile, o: CsrOp) -> i64 {
    if rv_csr_priv(o.csr) > f.priv_ { return -1; }
    val writes: bool = o.op == CSR_OP_WRITE || o.value != 0;
    if writes && rv_csr_readonly(o.csr) { return -1; }
    val old: i64 = csrfile_get(f, o.csr);
    if !writes { return old; }
    var nv: i64 = o.value;
    if o.op == CSR_OP_SET { nv = old | o.value; }
    if o.op == CSR_OP_CLEAR { nv = old & ~o.value; }
    var m: i64 = 0;
    if f.wmask.contains(o.csr) { m = f.wmask.get(o.csr); }
    nv = (old & ~m) | (nv & m);
    f.vals.insert(o.csr, nv);
    return old;
}

/// Run a sequence of ops; the number that trapped.
pub fn csrfile_run(f: &mut CsrFile, ops: Vec<CsrOp>) -> i64 {
    var bad: i64 = 0;
    var i: i64 = 0;
    while i < ops.len() {
        if csrfile_apply(f, ops.get(i)) == -1 { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

/// Trap into M-mode (3.1.6.1): mepc = pc, mcause, mtval, MPIE = MIE,
/// MIE = 0, MPP = the privilege trapped from, privilege = M, pc = the
/// mtvec target. Returns the new pc.
pub fn csrfile_trap(f: &mut CsrFile, mcause: i64, mtval: i64) -> i64 {
    f.vals.insert(CSR_MEPC, f.pc & ~1);
    f.vals.insert(CSR_MCAUSE, mcause);
    f.vals.insert(CSR_MTVAL, mtval);
    var st: i64 = csrfile_get(f, CSR_MSTATUS);
    if (st & MSTATUS_MIE) != 0 { st = st | MSTATUS_MPIE; } else { st = st & ~MSTATUS_MPIE; }
    st = st & ~MSTATUS_MIE;
    st = rv_mstatus_with_mpp(st, f.priv_);
    f.vals.insert(CSR_MSTATUS, st);
    f.priv_ = RV_PRIV_M;
    f.pc = rv_mtvec_target(csrfile_get(f, CSR_MTVEC), mcause, f.xlen);
    return f.pc;
}

/// Take the pending interrupt if mstatus.MIE (or a lower privilege) lets
/// it through: returns the interrupt code taken, -1 when none.
pub fn csrfile_check_irq(f: &mut CsrFile) -> i64 {
    val st: i64 = csrfile_get(f, CSR_MSTATUS);
    val enabled: bool = f.priv_ < RV_PRIV_M || (st & MSTATUS_MIE) != 0;
    if !enabled { return -1; }
    val code: i64 = rv_irq_select(csrfile_get(f, CSR_MIP), csrfile_get(f, CSR_MIE));
    if code < 0 { return -1; }
    csrfile_trap(f, rv_mcause_interrupt(code, f.xlen), 0);
    return code;
}

/// MRET (3.3.2): privilege = MPP, MIE = MPIE, MPIE = 1, MPP = U (the
/// least privileged mode, U supported), MPRV cleared when leaving M;
/// pc = mepc. Returns the new pc, -1 (illegal) outside M-mode.
pub fn csrfile_mret(f: &mut CsrFile) -> i64 {
    if f.priv_ != RV_PRIV_M { return -1; }
    var st: i64 = csrfile_get(f, CSR_MSTATUS);
    val mpp: i64 = rv_mstatus_mpp(st);
    if (st & MSTATUS_MPIE) != 0 { st = st | MSTATUS_MIE; } else { st = st & ~MSTATUS_MIE; }
    st = st | MSTATUS_MPIE;
    st = rv_mstatus_with_mpp(st, RV_PRIV_U);
    if mpp != RV_PRIV_M { st = st & ~MSTATUS_MPRV; }
    f.vals.insert(CSR_MSTATUS, st);
    f.priv_ = mpp;
    f.pc = csrfile_get(f, CSR_MEPC);
    return f.pc;
}

/// The standard M-mode trap setup a boot stub runs: mtvec, mscratch, mie
/// bits, global MIE, as CsrOps (to encode with rv_csr_insn or apply).
pub fn rv_trap_setup_ops(handler: i64, vectored: bool, scratch: i64, mie_bits: i64) -> Vec<CsrOp> {
    var mode: i64 = MTVEC_DIRECT;
    if vectored { mode = MTVEC_VECTORED; }
    var ops: Vec<CsrOp> = Vec::new();
    ops.push(csr_op(CSR_OP_WRITE, CSR_MTVEC, rv_mtvec(handler, mode)));
    ops.push(csr_op(CSR_OP_WRITE, CSR_MSCRATCH, scratch));
    ops.push(csr_op(CSR_OP_SET, CSR_MIE, mie_bits));
    ops.push(csr_op(CSR_OP_SET, CSR_MSTATUS, MSTATUS_MIE));
    return ops;
}

// ─── PLIC (RISC-V PLIC spec 1.0.0, chapter 3) ───────────────────────────

pub fn plic_priority_addr(base: i64, src: i64) -> i64 {
    return base + 4 * src;
}

pub fn plic_pending_addr(base: i64, src: i64) -> i64 {
    return base + 0x1000 + 4 * (src >> 5);
}

pub fn plic_enable_addr(base: i64, ctx: i64, src: i64) -> i64 {
    return base + 0x2000 + 0x80 * ctx + 4 * (src >> 5);
}

pub fn plic_threshold_addr(base: i64, ctx: i64) -> i64 {
    return base + 0x200000 + 0x1000 * ctx;
}

pub fn plic_claim_addr(base: i64, ctx: i64) -> i64 {
    return base + 0x200004 + 0x1000 * ctx;
}

fn plic_check(src: i64) {
    if src < 1 || src > 1023 { p_panic("riscv_csr: PLIC source " + int_to_str(src) + " out of range 1..1023"); }
}

pub fn plic_set_priority(bus: &mut RegBus, base: i64, src: i64, prio: i64) {
    plic_check(src);
    regbus_write(bus, plic_priority_addr(base, src), 32, prio);
}

/// Enable a source for a context (read-modify-write of its enable word).
pub fn plic_enable(bus: &mut RegBus, base: i64, ctx: i64, src: i64) {
    plic_check(src);
    val a: i64 = plic_enable_addr(base, ctx, src);
    regbus_write(bus, a, 32, regbus_read(bus, a, 32) | (1 << (src & 31)));
}

pub fn plic_disable(bus: &mut RegBus, base: i64, ctx: i64, src: i64) {
    plic_check(src);
    val a: i64 = plic_enable_addr(base, ctx, src);
    regbus_write(bus, a, 32, regbus_read(bus, a, 32) & ~(1 << (src & 31)));
}

pub fn plic_set_threshold(bus: &mut RegBus, base: i64, ctx: i64, t: i64) {
    regbus_write(bus, plic_threshold_addr(base, ctx), 32, t);
}

/// Claim: read the claim register (0 when nothing is pending).
pub fn plic_claim(bus: &mut RegBus, base: i64, ctx: i64) -> i64 {
    return regbus_read(bus, plic_claim_addr(base, ctx), 32);
}

/// Complete: write the claimed ID back.
pub fn plic_complete(bus: &mut RegBus, base: i64, ctx: i64, src: i64) {
    regbus_write(bus, plic_claim_addr(base, ctx), 32, src);
}

/// The PLIC's arbitration, as the hardware does it.
pub struct PlicSim {
    pub nsrc: i64,
    pub nctx: i64,
    pub prio: Vec<i64>,
    pub pending: Vec<bool>,
    pub claimed: Vec<bool>,
    pub enable: Vec<bool>,
    pub threshold: Vec<i64>,
}

pub fn plicsim_new(nsrc: i64, nctx: i64) -> PlicSim {
    return PlicSim {
        nsrc: nsrc, nctx: nctx, prio: Vec::filled(nsrc + 1, 0), pending: Vec::filled(nsrc + 1, false),
        claimed: Vec::filled(nsrc + 1, false), enable: Vec::filled((nsrc + 1) * nctx, false),
        threshold: Vec::filled(nctx, 0)
    };
}

pub fn plicsim_set_priority(p: &mut PlicSim, src: i64, prio: i64) { p.prio.set(src, prio); }
pub fn plicsim_enable(p: &mut PlicSim, ctx: i64, src: i64, on: bool) { p.enable.set(ctx * (p.nsrc + 1) + src, on); }
pub fn plicsim_set_threshold(p: &mut PlicSim, ctx: i64, t: i64) { p.threshold.set(ctx, t); }

/// A device raises source `src` (the gateway holds one request until it
/// has been claimed and completed).
pub fn plicsim_raise(p: &mut PlicSim, src: i64) {
    if !p.claimed.get(src) { p.pending.set(src, true); }
}

/// The source the context's claim would return: the pending, enabled
/// source with the highest priority strictly above the threshold, the
/// lowest ID first on a tie; 0 when none. Priority 0 never interrupts.
pub fn plicsim_best(p: &PlicSim, ctx: i64) -> i64 {
    var best: i64 = 0;
    var bp: i64 = 0;
    var s: i64 = 1;
    while s <= p.nsrc {
        val pr: i64 = p.prio.get(s);
        if p.pending.get(s) && p.enable.get(ctx * (p.nsrc + 1) + s) && pr > p.threshold.get(ctx) && pr > bp {
            best = s;
            bp = pr;
        }
        s = s + 1;
    }
    return best;
}

/// The context's external interrupt line (MEIP/SEIP).
pub fn plicsim_eip(p: &PlicSim, ctx: i64) -> bool {
    return plicsim_best(p, ctx) != 0;
}

/// Claim: returns the ID and clears its pending bit.
pub fn plicsim_claim(p: &mut PlicSim, ctx: i64) -> i64 {
    val s: i64 = plicsim_best(p, ctx);
    if s != 0 {
        p.pending.set(s, false);
        p.claimed.set(s, true);
    }
    return s;
}

/// Complete: the gateway may forward the next request of that source.
pub fn plicsim_complete(p: &mut PlicSim, src: i64) {
    if src >= 1 && src <= p.nsrc { p.claimed.set(src, false); }
}

// ─── CLINT ──────────────────────────────────────────────────────────────

pub fn clint_msip_addr(base: i64, hart: i64) -> i64 {
    return base + 4 * hart;
}

pub fn clint_mtimecmp_addr(base: i64, hart: i64) -> i64 {
    return base + 0x4000 + 8 * hart;
}

pub fn clint_mtime_addr(base: i64) -> i64 {
    return base + 0xBFF8;
}

/// Raise / clear a hart's machine software interrupt (MSIP).
pub fn clint_send_ipi(bus: &mut RegBus, base: i64, hart: i64) {
    regbus_write(bus, clint_msip_addr(base, hart), 32, 1);
}

pub fn clint_clear_ipi(bus: &mut RegBus, base: i64, hart: i64) {
    regbus_write(bus, clint_msip_addr(base, hart), 32, 0);
}

/// Set mtimecmp on RV64: one 64-bit store.
pub fn clint_set_timer64(bus: &mut RegBus, base: i64, hart: i64, when: i64) {
    regbus_write(bus, clint_mtimecmp_addr(base, hart), 64, when);
}

/// Set mtimecmp with 32-bit stores (RV32, Privileged spec 3.2.1): low
/// word to all ones first so no spurious interrupt fires between the two
/// halves, then the high word, then the low word.
pub fn clint_set_timer32(bus: &mut RegBus, base: i64, hart: i64, when: i64) {
    val a: i64 = clint_mtimecmp_addr(base, hart);
    regbus_write(bus, a, 32, 0xFFFFFFFF);
    regbus_write(bus, a + 4, 32, (when >> 32) & 0xFFFFFFFF);
    regbus_write(bus, a, 32, when & 0xFFFFFFFF);
}

/// Read mtime with 32-bit loads: high, low, high again, retried until the
/// high word did not change (a carry between the reads).
pub fn clint_read_mtime32(bus: &mut RegBus, base: i64) -> i64 {
    val a: i64 = clint_mtime_addr(base);
    var tries: i64 = 0;
    while tries < 8 {
        val hi: i64 = regbus_read(bus, a + 4, 32);
        val lo: i64 = regbus_read(bus, a, 32);
        val hi2: i64 = regbus_read(bus, a + 4, 32);
        if hi == hi2 { return (hi << 32) | lo; }
        tries = tries + 1;
    }
    p_panic("riscv_csr: mtime kept changing");
}

/// mtimecmp for a tick `ms` milliseconds after `now` on a `freq` Hz
/// timebase.
pub fn clint_deadline(now: i64, ms: i64, freq: i64) -> i64 {
    return now + ms * freq / 1000;
}
