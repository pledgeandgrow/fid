// ahci: the Serial ATA AHCI 1.3.1 host controller interface.
//
// Real: the HBA register map (generic host control, port registers and
// their bit fields), CAP/PxSSTS/PxTFD/signature decoding, the data
// structures in host memory with their exact byte layout (command list
// of 32-byte command headers, command tables with the command FIS and the
// PRD table, the 256-byte received-FIS area), Register FIS Host to Device
// for READ DMA EXT, WRITE DMA EXT, IDENTIFY DEVICE, FLUSH CACHE EXT (and
// any other command), Register FIS Device to Host decoding, IDENTIFY DEVICE
// data parsing (model, serial, firmware, LBA48 capacity, logical sector
// size, NCQ depth), and the driver sequences: port stop/start (ST, FRE,
// CR, FR with bounded polling), port set-up (CLB/FB, SERR/IS clearing),
// free command slot choice, command issue and completion (PxCI, task file
// errors), and a vfs BlockDev over a port.
//
// The seam: an `AhciBus` of function values: 32-bit MMIO reads and writes
// at offsets of the HBA's ABAR (BAR5), and reads/writes of host memory at
// physical addresses (where the command list, tables and buffers live).
// A kernel passes volatile MMIO accessors and its DMA memory; the test
// passes a simulated HBA. Addresses of memory given to the HBA must be
// physical and aligned as the spec requires (CLB 1 KiB, FB 256 B,
// command tables 128 B); ahci_port_setup checks that.
module ahci;
use vec;
use string;
use vfs;

// --- generic host control (offsets in ABAR) -----------------------------------

pub const AHCI_CAP: i64 = 0;
pub const AHCI_GHC: i64 = 4;
pub const AHCI_IS: i64 = 8;
pub const AHCI_PI: i64 = 12;
pub const AHCI_VS: i64 = 16;
pub const AHCI_CCC_CTL: i64 = 20;
pub const AHCI_CCC_PORTS: i64 = 24;
pub const AHCI_EM_LOC: i64 = 28;
pub const AHCI_EM_CTL: i64 = 32;
pub const AHCI_CAP2: i64 = 36;
pub const AHCI_BOHC: i64 = 40;

pub const AHCI_GHC_HR: i64 = 1;
pub const AHCI_GHC_IE: i64 = 2;
pub const AHCI_GHC_AE: i64 = 2147483648;

pub const AHCI_CAP_SNCQ: i64 = 1073741824;
pub const AHCI_CAP_S64A: i64 = 2147483648;
pub const AHCI_CAP_SSS: i64 = 134217728;
pub const AHCI_CAP_SCLO: i64 = 16777216;

// --- port registers (offset within the port's 0x80 bytes) -----------------------

pub const AHCI_PX_CLB: i64 = 0;
pub const AHCI_PX_CLBU: i64 = 4;
pub const AHCI_PX_FB: i64 = 8;
pub const AHCI_PX_FBU: i64 = 12;
pub const AHCI_PX_IS: i64 = 16;
pub const AHCI_PX_IE: i64 = 20;
pub const AHCI_PX_CMD: i64 = 24;
pub const AHCI_PX_TFD: i64 = 32;
pub const AHCI_PX_SIG: i64 = 36;
pub const AHCI_PX_SSTS: i64 = 40;
pub const AHCI_PX_SCTL: i64 = 44;
pub const AHCI_PX_SERR: i64 = 48;
pub const AHCI_PX_SACT: i64 = 52;
pub const AHCI_PX_CI: i64 = 56;
pub const AHCI_PX_SNTF: i64 = 60;
pub const AHCI_PX_FBS: i64 = 64;

pub const AHCI_PXCMD_ST: i64 = 1;
pub const AHCI_PXCMD_SUD: i64 = 2;
pub const AHCI_PXCMD_POD: i64 = 4;
pub const AHCI_PXCMD_CLO: i64 = 8;
pub const AHCI_PXCMD_FRE: i64 = 16;
pub const AHCI_PXCMD_FR: i64 = 16384;
pub const AHCI_PXCMD_CR: i64 = 32768;

// PxIS bits
pub const AHCI_PXIS_DHRS: i64 = 1;
pub const AHCI_PXIS_PSS: i64 = 2;
pub const AHCI_PXIS_DSS: i64 = 4;
pub const AHCI_PXIS_SDBS: i64 = 8;
pub const AHCI_PXIS_DPS: i64 = 32;
pub const AHCI_PXIS_TFES: i64 = 1073741824;

// task file status bits
pub const ATA_SR_ERR: i64 = 1;
pub const ATA_SR_DRQ: i64 = 8;
pub const ATA_SR_DF: i64 = 32;
pub const ATA_SR_DRDY: i64 = 64;
pub const ATA_SR_BSY: i64 = 128;

// signatures (PxSIG)
pub const AHCI_SIG_ATA: i64 = 257;
pub const AHCI_SIG_ATAPI: i64 = 3943956737;
pub const AHCI_SIG_SEMB: i64 = 3275489537;
pub const AHCI_SIG_PM: i64 = 2523463937;

// FIS types
pub const FIS_TYPE_REG_H2D: i64 = 39;
pub const FIS_TYPE_REG_D2H: i64 = 52;
pub const FIS_TYPE_DMA_ACT: i64 = 57;
pub const FIS_TYPE_DMA_SETUP: i64 = 65;
pub const FIS_TYPE_DATA: i64 = 70;
pub const FIS_TYPE_PIO_SETUP: i64 = 95;
pub const FIS_TYPE_DEV_BITS: i64 = 161;

// ATA commands
pub const ATA_CMD_READ_DMA_EXT: i64 = 37;
pub const ATA_CMD_WRITE_DMA_EXT: i64 = 53;
pub const ATA_CMD_IDENTIFY: i64 = 236;
pub const ATA_CMD_FLUSH_EXT: i64 = 234;
pub const ATA_CMD_READ_FPDMA: i64 = 96;

// layout sizes
pub const AHCI_CMD_HEADER_SIZE: i64 = 32;
pub const AHCI_CMD_LIST_SIZE: i64 = 1024;
pub const AHCI_RFIS_SIZE: i64 = 256;
pub const AHCI_CMD_TABLE_PRDT: i64 = 128;
pub const AHCI_PRD_SIZE: i64 = 16;
pub const AHCI_PRD_MAX: i64 = 4194304;
// received FIS area offsets
pub const AHCI_RFIS_DSFIS: i64 = 0;
pub const AHCI_RFIS_PSFIS: i64 = 32;
pub const AHCI_RFIS_RFIS: i64 = 64;
pub const AHCI_RFIS_SDBFIS: i64 = 88;
pub const AHCI_RFIS_UFIS: i64 = 96;

/// Offset of port `p`'s registers in ABAR.
pub fn ahci_port_base(p: i64) -> i64 {
    return 256 + 128 * p;
}

pub fn ahci_port_reg(p: i64, reg: i64) -> i64 {
    return ahci_port_base(p) + reg;
}

// --- register decoding -------------------------------------------------------------

pub fn ahci_cap_nports(cap: i64) -> i64 {
    return (cap & 31) + 1;
}

pub fn ahci_cap_nslots(cap: i64) -> i64 {
    return ((cap >> 8) & 31) + 1;
}

/// Interface speed limit (CAP.ISS): 1 Gen1 1.5 Gb/s, 2 Gen2, 3 Gen3.
pub fn ahci_cap_iss(cap: i64) -> i64 {
    return (cap >> 20) & 15;
}

/// "1.3.1"-style version from the VS register.
pub fn ahci_version_str(vs: i64) -> str {
    val major: i64 = (vs >> 16) & 65535;
    val minor: i64 = vs & 65535;
    var s: str = int_to_str(major) + "." + int_to_str((minor >> 8) & 255);
    if (minor & 255) != 0 {
        s = s + "." + int_to_str(minor & 255);
    }
    return s;
}

/// Device present with Phy communication (DET = 3) and the link active
/// (IPM = 1).
pub fn ahci_ssts_active(ssts: i64) -> bool {
    return (ssts & 15) == 3 && ((ssts >> 8) & 15) == 1;
}

pub fn ahci_ssts_speed(ssts: i64) -> i64 {
    return (ssts >> 4) & 15;
}

pub fn ahci_sig_name(sig: i64) -> str {
    if sig == AHCI_SIG_ATA {
        return "SATA";
    }
    if sig == AHCI_SIG_ATAPI {
        return "SATAPI";
    }
    if sig == AHCI_SIG_SEMB {
        return "SEMB";
    }
    if sig == AHCI_SIG_PM {
        return "PM";
    }
    return "none";
}

// --- bytes ---------------------------------------------------------------------------

fn ahci_put32(b: &mut Vec<i64>, o: i64, v: i64) {
    b.set(o, v & 255);
    b.set(o + 1, (v >> 8) & 255);
    b.set(o + 2, (v >> 16) & 255);
    b.set(o + 3, (v >> 24) & 255);
}

fn ahci_get32(b: &Vec<i64>, o: i64) -> i64 {
    return b.get(o) | (b.get(o + 1) << 8) | (b.get(o + 2) << 16) | (b.get(o + 3) << 24);
}

fn ahci_zeros(n: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        v.push(0);
        i = i + 1;
    }
    return v;
}

// --- FIS ---------------------------------------------------------------------------------

/// Register FIS Host to Device (20 bytes) with the C bit set: a command.
/// `lba` is 48-bit, `count` 16-bit, `device` bit 6 = LBA mode.
pub fn ahci_fis_h2d(command: i64, features: i64, lba: i64, count: i64, device: i64) -> Vec<i64> {
    var f: Vec<i64> = ahci_zeros(20);
    f.set(0, FIS_TYPE_REG_H2D);
    f.set(1, 128);
    f.set(2, command & 255);
    f.set(3, features & 255);
    f.set(4, lba & 255);
    f.set(5, (lba >> 8) & 255);
    f.set(6, (lba >> 16) & 255);
    f.set(7, device & 255);
    f.set(8, (lba >> 24) & 255);
    f.set(9, (lba >> 32) & 255);
    f.set(10, (lba >> 40) & 255);
    f.set(11, (features >> 8) & 255);
    f.set(12, count & 255);
    f.set(13, (count >> 8) & 255);
    return f;
}

/// READ DMA EXT of `count` sectors (1..65536; 65536 is sent as 0).
pub fn ahci_fis_read_dma_ext(lba: i64, count: i64) -> Vec<i64> {
    return ahci_fis_h2d(ATA_CMD_READ_DMA_EXT, 0, lba, count & 65535, 64);
}

pub fn ahci_fis_write_dma_ext(lba: i64, count: i64) -> Vec<i64> {
    return ahci_fis_h2d(ATA_CMD_WRITE_DMA_EXT, 0, lba, count & 65535, 64);
}

pub fn ahci_fis_identify() -> Vec<i64> {
    return ahci_fis_h2d(ATA_CMD_IDENTIFY, 0, 0, 0, 0);
}

pub fn ahci_fis_flush() -> Vec<i64> {
    return ahci_fis_h2d(ATA_CMD_FLUSH_EXT, 0, 0, 0, 64);
}

/// READ FPDMA QUEUED (NCQ): the sector count goes in the features field,
/// the tag in count bits 7:3.
pub fn ahci_fis_read_fpdma(lba: i64, count: i64, tag: i64) -> Vec<i64> {
    return ahci_fis_h2d(ATA_CMD_READ_FPDMA, count & 65535, lba, (tag & 31) << 3, 64);
}

pub struct AhciD2h {
    pub valid: bool,
    pub irq: bool,
    pub status: i64,
    pub error: i64,
    pub lba: i64,
    pub device: i64,
    pub count: i64,
}

/// Decode a Register FIS Device to Host (as found at RFIS+0x40).
pub fn ahci_fis_parse_d2h(f: &Vec<i64>, o: i64) -> AhciD2h {
    var d: AhciD2h = AhciD2h {
        valid: false, irq: false, status: 0, error: 0, lba: 0, device: 0, count: 0
    };
    if f.get(o) != FIS_TYPE_REG_D2H {
        return d;
    }
    d.valid = true;
    d.irq = (f.get(o + 1) & 64) != 0;
    d.status = f.get(o + 2);
    d.error = f.get(o + 3);
    d.lba = f.get(o + 4) | (f.get(o + 5) << 8) | (f.get(o + 6) << 16) | (f.get(o + 8) << 24) | (f.get(o + 9) << 32) | (f.get(o + 10) << 40);
    d.device = f.get(o + 7);
    d.count = f.get(o + 12) | (f.get(o + 13) << 8);
    return d;
}

// --- command list and tables ---------------------------------------------------------------

/// A 32-byte command header: FIS length in dwords, flags, PRDT length and
/// the command table address.
pub fn ahci_cmd_header(fis_len: i64, atapi: bool, write: bool, prefetch: bool, clear_busy: bool, prdtl: i64, ctba: i64) -> Vec<i64> {
    var h: Vec<i64> = ahci_zeros(32);
    var dw0: i64 = (fis_len / 4) & 31;
    if atapi {
        dw0 = dw0 | 32;
    }
    if write {
        dw0 = dw0 | 64;
    }
    if prefetch {
        dw0 = dw0 | 128;
    }
    if clear_busy {
        dw0 = dw0 | 1024;
    }
    dw0 = dw0 | ((prdtl & 65535) << 16);
    ahci_put32(&mut h, 0, dw0);
    ahci_put32(&mut h, 4, 0);
    ahci_put32(&mut h, 8, ctba & 4294967295);
    ahci_put32(&mut h, 12, (ctba >> 32) & 4294967295);
    return h;
}

pub struct AhciCmdHeader {
    pub cfl: i64,
    pub atapi: bool,
    pub write: bool,
    pub prdtl: i64,
    pub prdbc: i64,
    pub ctba: i64,
}

pub fn ahci_cmd_header_parse(h: &Vec<i64>, o: i64) -> AhciCmdHeader {
    val dw0: i64 = ahci_get32(h, o);
    return AhciCmdHeader {
        cfl: dw0 & 31, atapi: (dw0 & 32) != 0, write: (dw0 & 64) != 0, prdtl: (dw0 >> 16) & 65535, prdbc: ahci_get32(h, o + 4), ctba: ahci_get32(h, o + 8) | (ahci_get32(h, o + 12) << 32)
    };
}

/// One PRD entry: data base address, byte count (even, 2..4 MiB), and
/// "interrupt on completion".
pub fn ahci_prd(dba: i64, nbytes: i64, irq: bool) -> Vec<i64> {
    var e: Vec<i64> = ahci_zeros(16);
    ahci_put32(&mut e, 0, dba & 4294967295);
    ahci_put32(&mut e, 4, (dba >> 32) & 4294967295);
    var dw3: i64 = (nbytes - 1) & 4194303;
    if irq {
        dw3 = dw3 | 2147483648;
    }
    ahci_put32(&mut e, 12, dw3);
    return e;
}

/// The command table: the FIS at 0, ATAPI command at 0x40, then the PRDT
/// at 0x80 covering `nbytes` from `buf` in pieces of at most 4 MiB.
pub fn ahci_cmd_table(fis: &Vec<i64>, acmd: &Vec<i64>, buf: i64, nbytes: i64) -> Vec<i64> {
    var nprd: i64 = (nbytes + AHCI_PRD_MAX - 1) / AHCI_PRD_MAX;
    var t: Vec<i64> = ahci_zeros(AHCI_CMD_TABLE_PRDT + 16 * nprd);
    var i: i64 = 0;
    while i < fis.len() && i < 64 {
        t.set(i, fis.get(i));
        i = i + 1;
    }
    i = 0;
    while i < acmd.len() && i < 16 {
        t.set(64 + i, acmd.get(i));
        i = i + 1;
    }
    var k: i64 = 0;
    while k < nprd {
        var len: i64 = nbytes - k * AHCI_PRD_MAX;
        if len > AHCI_PRD_MAX {
            len = AHCI_PRD_MAX;
        }
        val e: Vec<i64> = ahci_prd(buf + k * AHCI_PRD_MAX, len, k == nprd - 1);
        var j: i64 = 0;
        while j < 16 {
            t.set(AHCI_CMD_TABLE_PRDT + 16 * k + j, e.get(j));
            j = j + 1;
        }
        k = k + 1;
    }
    return t;
}

pub fn ahci_prdt_len(nbytes: i64) -> i64 {
    return (nbytes + AHCI_PRD_MAX - 1) / AHCI_PRD_MAX;
}

// --- IDENTIFY DEVICE -------------------------------------------------------------------

pub struct AhciIdentify {
    pub model: str,
    pub serial: str,
    pub firmware: str,
    pub lba48: bool,
    pub sectors: i64,
    pub sector_size: i64,
    pub ncq: bool,
    pub queue_depth: i64,
}

fn ahci_id_word(d: &Vec<i64>, w: i64) -> i64 {
    return d.get(2 * w) | (d.get(2 * w + 1) << 8);
}

/// ATA strings: each word holds two characters, high byte first.
fn ahci_id_string(d: &Vec<i64>, w0: i64, words: i64) -> str {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < words {
        val w: i64 = ahci_id_word(d, w0 + i);
        out.push((w >> 8) & 255);
        out.push(w & 255);
        i = i + 1;
    }
    return str_trim(str_from_bytes(out));
}

pub fn ahci_identify_parse(d: &Vec<i64>) -> AhciIdentify {
    var id: AhciIdentify = AhciIdentify {
        model: "", serial: "", firmware: "", lba48: false, sectors: 0, sector_size: 512, ncq: false, queue_depth: 1
    };
    id.serial = ahci_id_string(d, 10, 10);
    id.firmware = ahci_id_string(d, 23, 4);
    id.model = ahci_id_string(d, 27, 20);
    id.lba48 = (ahci_id_word(d, 83) & 1024) != 0;
    if id.lba48 {
        id.sectors = ahci_id_word(d, 100) | (ahci_id_word(d, 101) << 16) | (ahci_id_word(d, 102) << 32) | (ahci_id_word(d, 103) << 48);
    } else {
        id.sectors = ahci_id_word(d, 60) | (ahci_id_word(d, 61) << 16);
    }
    // word 106: valid (bits 15:14 = 01), bit 12 = sector longer than 256 words
    val w106: i64 = ahci_id_word(d, 106);
    if (w106 & 49152) == 16384 && (w106 & 4096) != 0 {
        id.sector_size = 2 * (ahci_id_word(d, 117) | (ahci_id_word(d, 118) << 16));
    }
    id.ncq = (ahci_id_word(d, 76) & 256) != 0;
    id.queue_depth = (ahci_id_word(d, 75) & 31) + 1;
    return id;
}

// --- the driver over a bus ------------------------------------------------------------

/// MMIO and host memory accessors (the platform seam).
pub struct AhciBus {
    pub mmio_rd: fn(i64) -> i64,
    pub mmio_wr: fn(i64, i64) -> i64,
    pub mem_rd: fn(i64, i64) -> Vec<i64>,
    pub mem_wr: fn(i64, Vec<i64>) -> i64,
}

/// Memory one port uses: the command list, the received-FIS area and the
/// command tables (one per slot, `ctba + slot * 256`).
pub struct AhciPort {
    pub port: i64,
    pub clb: i64,
    pub fb: i64,
    pub ctba: i64,
    pub nslots: i64,
    pub err: str,
    pub last_status: i64,
    pub last_error: i64,
}

pub const AHCI_CT_STRIDE: i64 = 256;
pub const AHCI_POLL_LIMIT: i64 = 100000;

pub fn ahci_rd(bus: &AhciBus, off: i64) -> i64 {
    val f = bus.mmio_rd;
    return f(off) & 4294967295;
}

pub fn ahci_wr(bus: &AhciBus, off: i64, v: i64) {
    val f = bus.mmio_wr;
    f(off, v & 4294967295);
}

fn ahci_mem_wr(bus: &AhciBus, addr: i64, data: Vec<i64>) {
    val f = bus.mem_wr;
    f(addr, data);
}

fn ahci_mem_rd(bus: &AhciBus, addr: i64, n: i64) -> Vec<i64> {
    val f = bus.mem_rd;
    return f(addr, n);
}

/// Wait until (reg & mask) == want; false after AHCI_POLL_LIMIT reads.
pub fn ahci_wait(bus: &AhciBus, off: i64, mask: i64, want: i64) -> bool {
    var i: i64 = 0;
    while i < AHCI_POLL_LIMIT {
        if (ahci_rd(bus, off) & mask) == want {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Turn AHCI mode on (GHC.AE) and return the implemented ports (PI).
pub fn ahci_enable(bus: &AhciBus) -> i64 {
    ahci_wr(bus, AHCI_GHC, ahci_rd(bus, AHCI_GHC) | AHCI_GHC_AE);
    return ahci_rd(bus, AHCI_PI);
}

/// HBA reset (GHC.HR, cleared by the HBA when done), then AE again.
pub fn ahci_reset(bus: &AhciBus) -> bool {
    ahci_wr(bus, AHCI_GHC, ahci_rd(bus, AHCI_GHC) | AHCI_GHC_HR);
    if !ahci_wait(bus, AHCI_GHC, AHCI_GHC_HR, 0) {
        return false;
    }
    ahci_enable(bus);
    return true;
}

/// Ports with an active SATA link and their signatures: [port, sig]...
pub fn ahci_probe(bus: &AhciBus) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val pi: i64 = ahci_rd(bus, AHCI_PI);
    var p: i64 = 0;
    while p < 32 {
        if ((pi >> p) & 1) != 0 && ahci_ssts_active(ahci_rd(bus, ahci_port_reg(p, AHCI_PX_SSTS))) {
            out.push(p);
            out.push(ahci_rd(bus, ahci_port_reg(p, AHCI_PX_SIG)));
        }
        p = p + 1;
    }
    return out;
}

/// Stop the command engine and FIS receive (clear ST, wait CR; clear FRE,
/// wait FR).
pub fn ahci_port_stop(bus: &AhciBus, p: i64) -> bool {
    val r: i64 = ahci_port_reg(p, AHCI_PX_CMD);
    ahci_wr(bus, r, ahci_rd(bus, r) & (4294967295 - AHCI_PXCMD_ST));
    if !ahci_wait(bus, r, AHCI_PXCMD_CR, 0) {
        return false;
    }
    ahci_wr(bus, r, ahci_rd(bus, r) & (4294967295 - AHCI_PXCMD_FRE));
    return ahci_wait(bus, r, AHCI_PXCMD_FR, 0);
}

/// Start it again: wait CR clear, set FRE, then ST.
pub fn ahci_port_start(bus: &AhciBus, p: i64) -> bool {
    val r: i64 = ahci_port_reg(p, AHCI_PX_CMD);
    if !ahci_wait(bus, r, AHCI_PXCMD_CR, 0) {
        return false;
    }
    ahci_wr(bus, r, ahci_rd(bus, r) | AHCI_PXCMD_FRE);
    ahci_wr(bus, r, ahci_rd(bus, r) | AHCI_PXCMD_ST);
    return true;
}

/// Point port `p` at its memory (aligned as required), clear errors and
/// interrupts, start it.
pub fn ahci_port_setup(bus: &AhciBus, p: i64, clb: i64, fb: i64, ctba: i64) -> AhciPort {
    var st: AhciPort = AhciPort {
        port: p, clb: clb, fb: fb, ctba: ctba, nslots: ahci_cap_nslots(ahci_rd(bus, AHCI_CAP)), err: "", last_status: 0, last_error: 0
    };
    if clb % 1024 != 0 || fb % 256 != 0 || ctba % 128 != 0 {
        st.err = "misaligned CLB, FB or command table";
        return st;
    }
    if !ahci_port_stop(bus, p) {
        st.err = "port does not stop";
        return st;
    }
    ahci_wr(bus, ahci_port_reg(p, AHCI_PX_CLB), clb & 4294967295);
    ahci_wr(bus, ahci_port_reg(p, AHCI_PX_CLBU), clb >> 32);
    ahci_wr(bus, ahci_port_reg(p, AHCI_PX_FB), fb & 4294967295);
    ahci_wr(bus, ahci_port_reg(p, AHCI_PX_FBU), fb >> 32);
    ahci_mem_wr(bus, clb, ahci_zeros(AHCI_CMD_LIST_SIZE));
    ahci_mem_wr(bus, fb, ahci_zeros(AHCI_RFIS_SIZE));
    ahci_wr(bus, ahci_port_reg(p, AHCI_PX_SERR), 4294967295);
    ahci_wr(bus, ahci_port_reg(p, AHCI_PX_IS), 4294967295);
    if !ahci_port_start(bus, p) {
        st.err = "port does not start";
    }
    return st;
}

/// A command slot neither in PxSACT nor PxCI, or -1.
pub fn ahci_free_slot(bus: &AhciBus, port: &AhciPort) -> i64 {
    val busy: i64 = ahci_rd(bus, ahci_port_reg(port.port, AHCI_PX_SACT)) | ahci_rd(bus, ahci_port_reg(port.port, AHCI_PX_CI));
    var s: i64 = 0;
    while s < port.nslots {
        if ((busy >> s) & 1) == 0 {
            return s;
        }
        s = s + 1;
    }
    return -1;
}

/// Build the command in a free slot, issue it and wait for completion.
/// Returns 0 or -errno (EIO with the task file in last_status/last_error).
pub fn ahci_exec(bus: &AhciBus, port: &mut AhciPort, fis: Vec<i64>, write: bool, buf: i64, nbytes: i64) -> i64 {
    val p: i64 = port.port;
    if (ahci_rd(bus, ahci_port_reg(p, AHCI_PX_TFD)) & (ATA_SR_BSY | ATA_SR_DRQ)) != 0 {
        return 0 - VFS_EBUSY;
    }
    val slot: i64 = ahci_free_slot(bus, port);
    if slot < 0 {
        return 0 - VFS_EBUSY;
    }
    val ct: i64 = port.ctba + slot * AHCI_CT_STRIDE;
    val none: Vec<i64> = Vec::new();
    ahci_mem_wr(bus, ct, ahci_cmd_table(&fis, &none, buf, nbytes));
    ahci_mem_wr(bus, port.clb + slot * AHCI_CMD_HEADER_SIZE, ahci_cmd_header(20, false, write, false, false, ahci_prdt_len(nbytes), ct));
    ahci_wr(bus, ahci_port_reg(p, AHCI_PX_IS), 4294967295);
    ahci_wr(bus, ahci_port_reg(p, AHCI_PX_CI), 1 << slot);
    var i: i64 = 0;
    while i < AHCI_POLL_LIMIT {
        if (ahci_rd(bus, ahci_port_reg(p, AHCI_PX_IS)) & AHCI_PXIS_TFES) != 0 {
            break;
        }
        if ((ahci_rd(bus, ahci_port_reg(p, AHCI_PX_CI)) >> slot) & 1) == 0 {
            break;
        }
        i = i + 1;
    }
    val tfd: i64 = ahci_rd(bus, ahci_port_reg(p, AHCI_PX_TFD));
    port.last_status = tfd & 255;
    port.last_error = (tfd >> 8) & 255;
    if i >= AHCI_POLL_LIMIT {
        return 0 - VFS_EIO;
    }
    if (ahci_rd(bus, ahci_port_reg(p, AHCI_PX_IS)) & AHCI_PXIS_TFES) != 0 || (tfd & ATA_SR_ERR) != 0 {
        return 0 - VFS_EIO;
    }
    return 0;
}

/// IDENTIFY DEVICE into the 512-byte buffer at `buf`.
pub fn ahci_identify(bus: &AhciBus, port: &mut AhciPort, buf: i64) -> AhciIdentify {
    val r: i64 = ahci_exec(bus, port, ahci_fis_identify(), false, buf, 512);
    if r < 0 {
        port.err = "IDENTIFY failed: " + vfs_errno_name(r);
    }
    val d: Vec<i64> = ahci_mem_rd(bus, buf, 512);
    return ahci_identify_parse(&d);
}

pub fn ahci_read(bus: &AhciBus, port: &mut AhciPort, lba: i64, count: i64, buf: i64, sector: i64) -> i64 {
    if count < 1 || count > 65536 {
        return 0 - VFS_EINVAL;
    }
    return ahci_exec(bus, port, ahci_fis_read_dma_ext(lba, count), false, buf, count * sector);
}

pub fn ahci_write(bus: &AhciBus, port: &mut AhciPort, lba: i64, count: i64, buf: i64, sector: i64) -> i64 {
    if count < 1 || count > 65536 {
        return 0 - VFS_EINVAL;
    }
    return ahci_exec(bus, port, ahci_fis_write_dma_ext(lba, count), true, buf, count * sector);
}

// --- a vfs block device over a port -------------------------------------------------------

var ahci_dev_bus: Vec<AhciBus> = Vec::new();
var ahci_dev_port: Vec<AhciPort> = Vec::new();
var ahci_dev_buf: Vec<i64> = Vec::new();
var ahci_dev_ss: Vec<i64> = Vec::new();

fn ahci_bd_read(h: i64, lba: i64) -> Vec<i64> {
    val bus: AhciBus = ahci_dev_bus.get(h);
    var port: AhciPort = ahci_dev_port.get(h);
    val r: i64 = ahci_read(&bus, &mut port, lba, 1, ahci_dev_buf.get(h), ahci_dev_ss.get(h));
    ahci_dev_port.set(h, port);
    if r < 0 {
        return Vec::new();
    }
    return ahci_mem_rd(&bus, ahci_dev_buf.get(h), ahci_dev_ss.get(h));
}

fn ahci_bd_write(h: i64, lba: i64, data: Vec<i64>) -> i64 {
    val bus: AhciBus = ahci_dev_bus.get(h);
    var port: AhciPort = ahci_dev_port.get(h);
    ahci_mem_wr(&bus, ahci_dev_buf.get(h), data);
    val r: i64 = ahci_write(&bus, &mut port, lba, 1, ahci_dev_buf.get(h), ahci_dev_ss.get(h));
    ahci_dev_port.set(h, port);
    return r;
}

fn ahci_bd_zero(h: i64, lba: i64, count: i64) -> i64 {
    val z: Vec<i64> = ahci_zeros(ahci_dev_ss.get(h));
    var i: i64 = 0;
    while i < count {
        val r: i64 = ahci_bd_write(h, lba + i, z);
        if r < 0 {
            return r;
        }
        i = i + 1;
    }
    return 0;
}

/// A BlockDev over a set-up port: one sector per request through the DMA
/// bounce buffer at `buf` (sector-sized, physical, word aligned).
pub fn ahci_blockdev(bus: AhciBus, port: AhciPort, id: &AhciIdentify, buf: i64) -> BlockDev {
    val h: i64 = ahci_dev_bus.len();
    ahci_dev_bus.push(bus);
    ahci_dev_port.push(port);
    ahci_dev_buf.push(buf);
    ahci_dev_ss.push(id.sector_size);
    return blockdev_new(h, id.sector_size, id.sectors, ahci_bd_read, ahci_bd_write, ahci_bd_zero);
}
