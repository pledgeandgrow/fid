// Fides OpenADR 2.0b standard library
//
// OpenADR is the automated demand-response protocol between a VTN (server)
// and a VEN (client). Payloads are XML (module `xml`). This module is pure
// computation on XML strings:
//
// Real (implemented and tested on spec-shaped payloads):
//   - The EiEvent model: an event descriptor (eventID, modificationNumber,
//     priority, marketContext, createdDateTime, eventStatus), an active
//     period (dtstart, duration), one or more signals (signalName,
//     signalType, one or more intervals each with a duration and a float
//     value), and targets (venID / groupID / resourceID). Build the
//     oadrDistributeEvent payload (openadr_distribute_event) and parse one
//     back into a struct (openadr_parse_distribute_event).
//   - Signal payload accessors: read the signal name, the interval values,
//     and the current active signal value for a given time offset.
//   - Report registration: an oadrRegisterReport with one report
//     description, and the oadrRegisteredReport response
//     (openadr_register_report / openadr_registered_report).
//   - The oadrPoll request and oadrCreatedEvent opt reply (optIn/optOut per
//     event), plus a VEN state machine (unregistered -> registered ->
//     polling -> event-active) that decides the next request and records an
//     opt decision (OadrVen / ven_step).
//
// XML is generated by direct string assembly (OpenADR uses namespaced tags
// like oadr:, ei:, which the xml module keeps whole) and parsed back with
// xml_load. Values are decoded from the parsed tree.
//
// The seam: no HTTP. A payload is an XML string; POST it to the VTN with
// module `http`/`https` and feed responses back through the parsers.
// Timestamps are passed in as ISO-8601 strings, not read from a clock.

module openadr;
use vec;
use string;
use xml;

// EiEvent status values
pub const OADR_STATUS_NONE: i64 = 0;
pub const OADR_STATUS_FAR: i64 = 1;
pub const OADR_STATUS_NEAR: i64 = 2;
pub const OADR_STATUS_ACTIVE: i64 = 3;
pub const OADR_STATUS_COMPLETED: i64 = 4;
pub const OADR_STATUS_CANCELLED: i64 = 5;

pub fn openadr_status_name(s: i64) -> str {
    if s == OADR_STATUS_FAR {
        return "far";
    }
    if s == OADR_STATUS_NEAR {
        return "near";
    }
    if s == OADR_STATUS_ACTIVE {
        return "active";
    }
    if s == OADR_STATUS_COMPLETED {
        return "completed";
    }
    if s == OADR_STATUS_CANCELLED {
        return "cancelled";
    }
    return "none";
}

pub fn openadr_status_parse(s: str) -> i64 {
    if str_equal(s, "far") {
        return OADR_STATUS_FAR;
    }
    if str_equal(s, "near") {
        return OADR_STATUS_NEAR;
    }
    if str_equal(s, "active") {
        return OADR_STATUS_ACTIVE;
    }
    if str_equal(s, "completed") {
        return OADR_STATUS_COMPLETED;
    }
    if str_equal(s, "cancelled") {
        return OADR_STATUS_CANCELLED;
    }
    return OADR_STATUS_NONE;
}

// VEN states
pub const VEN_UNREGISTERED: i64 = 0;
pub const VEN_REGISTERED: i64 = 1;
pub const VEN_POLLING: i64 = 2;
pub const VEN_EVENT_ACTIVE: i64 = 3;

// ─── Event model ─────────────────────────────────────────────────────────

/// One interval of a signal: a duration string and a float payload value.
pub struct OadrInterval {
    pub duration: str,
    pub value: f64,
}

/// A signal: name, type, and its intervals.
pub struct OadrSignal {
    pub name: str,
    pub signal_type: str,
    pub intervals: Vec<OadrInterval>,
}

/// A full EiEvent.
pub struct OadrEvent {
    pub event_id: str,
    pub modification_number: i64,
    pub priority: i64,
    pub market_context: str,
    pub created: str,
    pub status: i64,
    pub dtstart: str,
    pub duration: str,
    pub signal: OadrSignal,
    pub ven_id: str,
    pub group_id: str,
}

fn append_f64(x: f64) -> str {
    return float_to_str(x);
}

// ─── Build oadrDistributeEvent ───────────────────────────────────────────

/// Build an oadrDistributeEvent payload carrying one event.
pub fn openadr_distribute_event(requestID: str, vtnID: str, ev: &OadrEvent) -> str {
    var s: str = "<oadr:oadrDistributeEvent ei:schemaVersion=\"2.0b\">";
    s = s + tag("pyld:requestID", requestID);
    s = s + tag("ei:vtnID", vtnID);
    s = s + "<oadr:oadrEvent><ei:eiEvent>";
    // eventDescriptor
    s = s + "<ei:eventDescriptor>";
    s = s + tag("ei:eventID", ev.event_id);
    s = s + tag("ei:modificationNumber", int_to_str(ev.modification_number));
    s = s + tag("ei:priority", int_to_str(ev.priority));
    s = s + "<ei:eiMarketContext><emix:marketContext>" + xml_escape(ev.market_context) + "</emix:marketContext></ei:eiMarketContext>";
    s = s + tag("ei:createdDateTime", ev.created);
    s = s + "<ei:eventStatus>" + openadr_status_name(ev.status) + "</ei:eventStatus>";
    s = s + "</ei:eventDescriptor>";
    // active period
    s = s + "<ei:eiActivePeriod><xcal:properties>";
    s = s + "<xcal:dtstart><xcal:date-time>" + xml_escape(ev.dtstart) + "</xcal:date-time></xcal:dtstart>";
    s = s + "<xcal:duration><xcal:duration>" + xml_escape(ev.duration) + "</xcal:duration></xcal:duration>";
    s = s + "</xcal:properties></ei:eiActivePeriod>";
    // signals
    s = s + "<ei:eiEventSignals><ei:eiEventSignal>";
    s = s + "<strm:intervals>";
    var i: i64 = 0;
    while i < ev.signal.intervals.len() {
        val iv: OadrInterval = ev.signal.intervals.get(i);
        s = s + "<ei:interval>";
        s = s + "<xcal:duration><xcal:duration>" + xml_escape(iv.duration) + "</xcal:duration></xcal:duration>";
        s = s + "<ei:signalPayload><ei:payloadFloat><ei:value>" + append_f64(iv.value) + "</ei:value></ei:payloadFloat></ei:signalPayload>";
        s = s + "</ei:interval>";
        i = i + 1;
    }
    s = s + "</strm:intervals>";
    s = s + tag("ei:signalName", ev.signal.name);
    s = s + tag("ei:signalType", ev.signal.signal_type);
    s = s + "</ei:eiEventSignal></ei:eiEventSignals>";
    // targets
    s = s + "<ei:eiTarget>";
    if str_len(ev.ven_id) > 0 {
        s = s + tag("ei:venID", ev.ven_id);
    }
    if str_len(ev.group_id) > 0 {
        s = s + tag("ei:groupID", ev.group_id);
    }
    s = s + "</ei:eiTarget>";
    s = s + "</ei:eiEvent></oadr:oadrEvent>";
    s = s + "</oadr:oadrDistributeEvent>";
    return s;
}

fn tag(name: str, value: str) -> str {
    return "<" + name + ">" + xml_escape(value) + "</" + name + ">";
}

// ─── Parse oadrDistributeEvent ───────────────────────────────────────────

/// Find the first descendant with `tag` anywhere in the tree (depth-first).
fn find_deep(node: XmlNode, tag: str) -> XmlNode {
    if str_equal(node.tag, tag) {
        return node;
    }
    var i: i64 = 0;
    while i < node.children.len() {
        val r: XmlNode = find_deep(node.children.get(i), tag);
        if str_len(r.tag) > 0 {
            return r;
        }
        i = i + 1;
    }
    return xml_elem("", "");
}

/// Find the first descendant with `tag` that carries non-empty direct text
/// (skips wrapper elements such as the WS-Calendar double-nested duration).
fn find_deep_text(node: XmlNode, tag: str) -> str {
    if str_equal(node.tag, tag) && str_len(node.text) > 0 {
        return node.text;
    }
    var i: i64 = 0;
    while i < node.children.len() {
        val r: str = find_deep_text(node.children.get(i), tag);
        if str_len(r) > 0 {
            return r;
        }
        i = i + 1;
    }
    return "";
}

/// Parse an oadrDistributeEvent payload into an OadrEvent (the first event).
pub fn openadr_parse_distribute_event(payload: str) -> OadrEvent {
    var ev: OadrEvent = OadrEvent {
        event_id: "", modification_number: 0, priority: 0, market_context: "", created: "", status: OADR_STATUS_NONE, dtstart: "", duration: "", signal: OadrSignal {
            name: "", signal_type: "", intervals: Vec::new()
        }, ven_id: "", group_id: "",
    };
    val doc: XmlDoc = xml_load(payload);
    if !doc.ok {
        return ev;
    }
    val root: XmlNode = doc.root;
    val eiEvent: XmlNode = find_deep(root, "ei:eiEvent");
    if str_len(eiEvent.tag) == 0 {
        return ev;
    }
    ev.event_id = find_deep(eiEvent, "ei:eventID").text;
    ev.modification_number = str_parse_int(find_deep(eiEvent, "ei:modificationNumber").text);
    ev.priority = str_parse_int(find_deep(eiEvent, "ei:priority").text);
    ev.market_context = find_deep(eiEvent, "emix:marketContext").text;
    ev.created = find_deep(eiEvent, "ei:createdDateTime").text;
    ev.status = openadr_status_parse(find_deep(eiEvent, "ei:eventStatus").text);
    ev.dtstart = find_deep(eiEvent, "xcal:date-time").text;
    // duration: the active period has a nested xcal:duration; take the first
    val ap: XmlNode = find_deep(eiEvent, "ei:eiActivePeriod");
    ev.duration = find_deep_text(ap, "xcal:duration");
    ev.signal.name = find_deep(eiEvent, "ei:signalName").text;
    ev.signal.signal_type = find_deep(eiEvent, "ei:signalType").text;
    // intervals
    val intervals: XmlNode = find_deep(eiEvent, "strm:intervals");
    var i: i64 = 0;
    while i < intervals.children.len() {
        val child: XmlNode = intervals.children.get(i);
        if str_equal(child.tag, "ei:interval") {
            val dur: str = find_deep_text(child, "xcal:duration");
            val valstr: str = find_deep(child, "ei:value").text;
            ev.signal.intervals.push(OadrInterval {
                duration: dur, value: str_parse_float(valstr)
            });
        }
        i = i + 1;
    }
    val target: XmlNode = find_deep(eiEvent, "ei:eiTarget");
    ev.ven_id = find_deep(target, "ei:venID").text;
    ev.group_id = find_deep(target, "ei:groupID").text;
    return ev;
}

/// The signal value active at interval index `idx` (0-based). Returns 0.0
/// when out of range.
pub fn openadr_signal_value_at(ev: &OadrEvent, idx: i64) -> f64 {
    if idx < 0 || idx >= ev.signal.intervals.len() {
        return 0.0;
    }
    return ev.signal.intervals.get(idx).value;
}

// ─── Report registration ─────────────────────────────────────────────────

/// Build an oadrRegisterReport with one report description.
pub fn openadr_register_report(requestID: str, venID: str, reportSpecifierID: str, rid: str, reading_type: str) -> str {
    var s: str = "<oadr:oadrRegisterReport ei:schemaVersion=\"2.0b\">";
    s = s + tag("pyld:requestID", requestID);
    s = s + "<oadr:oadrReport>";
    s = s + tag("ei:reportSpecifierID", reportSpecifierID);
    s = s + tag("ei:reportName", "METADATA_TELEMETRY_USAGE");
    s = s + "<oadr:oadrReportDescription><ei:rID>" + xml_escape(rid) + "</ei:rID>";
    s = s + tag("ei:readingType", reading_type);
    s = s + "</oadr:oadrReportDescription>";
    s = s + "</oadr:oadrReport>";
    s = s + tag("ei:venID", venID);
    s = s + "</oadr:oadrRegisterReport>";
    return s;
}

/// Build the oadrRegisteredReport response.
pub fn openadr_registered_report(requestID: str, responseCode: i64, venID: str) -> str {
    var s: str = "<oadr:oadrRegisteredReport ei:schemaVersion=\"2.0b\">";
    s = s + "<ei:eiResponse>";
    s = s + tag("ei:responseCode", int_to_str(responseCode));
    s = s + tag("pyld:requestID", requestID);
    s = s + "</ei:eiResponse>";
    s = s + tag("ei:venID", venID);
    s = s + "</oadr:oadrRegisteredReport>";
    return s;
}

// ─── Poll and opt reply ──────────────────────────────────────────────────

/// Build an oadrPoll request.
pub fn openadr_poll(venID: str) -> str {
    return "<oadr:oadrPoll ei:schemaVersion=\"2.0b\">" + tag("ei:venID", venID) + "</oadr:oadrPoll>";
}

/// Build an oadrCreatedEvent carrying one opt decision for an event.
pub fn openadr_created_event(requestID: str, venID: str, eventID: str, modificationNumber: i64, optIn: bool) -> str {
    var optType: str = "optOut";
    if optIn {
        optType = "optIn";
    }
    var s: str = "<oadr:oadrCreatedEvent ei:schemaVersion=\"2.0b\"><ei:eiCreatedEvent>";
    s = s + "<ei:eiResponse>";
    s = s + tag("ei:responseCode", "200");
    s = s + tag("pyld:requestID", requestID);
    s = s + "</ei:eiResponse>";
    s = s + "<ei:eventResponses><ei:eventResponse>";
    s = s + tag("ei:responseCode", "200");
    s = s + "<ei:qualifiedEventID>";
    s = s + tag("ei:eventID", eventID);
    s = s + tag("ei:modificationNumber", int_to_str(modificationNumber));
    s = s + "</ei:qualifiedEventID>";
    s = s + tag("ei:optType", optType);
    s = s + "</ei:eventResponse></ei:eventResponses>";
    s = s + tag("ei:venID", venID);
    s = s + "</ei:eiCreatedEvent></oadr:oadrCreatedEvent>";
    return s;
}

/// Read the optType from an oadrCreatedEvent payload.
pub fn openadr_parse_opt(payload: str) -> str {
    val doc: XmlDoc = xml_load(payload);
    if !doc.ok {
        return "";
    }
    return find_deep(doc.root, "ei:optType").text;
}

// ─── VEN state machine ───────────────────────────────────────────────────

/// A VEN: its id, state, the id of the active event (if any) and the last
/// opt decision made.
pub struct OadrVen {
    pub ven_id: str,
    pub state: i64,
    pub active_event: str,
    pub last_opt_in: bool,
    pub poll_count: i64,
}

pub fn openadr_ven_new(ven_id: str) -> OadrVen {
    return OadrVen {
        ven_id: ven_id, state: VEN_UNREGISTERED, active_event: "", last_opt_in: false, poll_count: 0
    };
}

/// Register the VEN (after a successful registration response).
pub fn ven_register(v: &mut OadrVen) {
    v.state = VEN_REGISTERED;
}

/// The next request the VEN should send: "oadrCreatePartyRegistration",
/// "oadrPoll", or "oadrCreatedEvent".
pub fn ven_next_request(v: &OadrVen) -> str {
    if v.state == VEN_UNREGISTERED {
        return "oadrCreatePartyRegistration";
    }
    if v.state == VEN_EVENT_ACTIVE {
        return "oadrCreatedEvent";
    }
    return "oadrPoll";
}

/// The VEN polls; counts the poll. Returns the request name.
pub fn ven_poll(v: &mut OadrVen) -> str {
    if v.state == VEN_REGISTERED || v.state == VEN_POLLING {
        v.state = VEN_POLLING;
        v.poll_count = v.poll_count + 1;
    }
    return "oadrPoll";
}

/// The VEN received a distribute-event with the given event id; it becomes
/// event-active awaiting an opt decision.
pub fn ven_on_event(v: &mut OadrVen, event_id: str) {
    v.active_event = event_id;
    v.state = VEN_EVENT_ACTIVE;
}

/// The VEN decides opt-in/opt-out; returns to polling.
pub fn ven_opt(v: &mut OadrVen, opt_in: bool) {
    v.last_opt_in = opt_in;
    v.state = VEN_POLLING;
}
