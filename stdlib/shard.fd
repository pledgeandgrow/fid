// Tensor Parallelism stdlib — ML13
//
// Provides collective communication primitives for multi-GPU training.
// @shard functions use these for cross-rank communication.
// In single-device mode (interpreter), these are no-ops.

module shard;

use tensor;

/// All-reduce: sum tensor across all ranks.
pub fn all_reduce(t: Tensor) -> Tensor {
    p_all_reduce(t)
}

/// Broadcast tensor from rank 0 to all ranks.
pub fn broadcast(t: Tensor) -> Tensor {
    p_broadcast(t)
}

/// All-gather: concatenate tensors from all ranks.
pub fn all_gather(t: Tensor) -> Tensor {
    p_all_gather(t)
}

/// Scatter: split tensor across ranks.
pub fn scatter(t: Tensor) -> Tensor {
    p_scatter(t)
}

/// Send tensor to another rank.
pub fn send_tensor(t: Tensor) -> void {
    p_send_tensor(t)
}

/// Receive tensor from another rank.
pub fn recv_tensor(shape: Vec<i64>) -> Tensor {
    p_recv_tensor(shape)
}
