// Tensor Parallelism stdlib — ML13
//
// Provides collective communication primitives for multi-GPU training.
// @shard functions use these for cross-rank communication.
// In single-device mode (interpreter), these are no-ops.

module shard;
/// All-reduce: sum tensor across all ranks.
///
/// Example:
///   use tensor;
///   var s: Vec<i64> = Vec::new();
///   s.push(4);
///   val t = filled(s, 2.0);
///   assert(sum(all_reduce(t)) == 8.0);
///   assert(sum(broadcast(t)) == 8.0);
pub fn all_reduce(t: Tensor) -> Tensor {
    p_all_reduce(t)
}

/// Broadcast tensor from rank 0 to all ranks.
pub fn broadcast(t: Tensor) -> Tensor {
    p_broadcast(t)
}

/// All-gather: concatenate tensors from all ranks.
pub fn all_gather(t: Tensor) -> Tensor {
    p_all_gather(t)
}

/// Scatter: split tensor across ranks.
pub fn scatter(t: Tensor) -> Tensor {
    p_scatter(t)
}

/// Send tensor to another rank.
pub fn send_tensor(t: Tensor) -> void {
    p_send_tensor(t)
}

/// Receive tensor from another rank.
pub fn recv_tensor(shape: Vec<i64>) -> Tensor {
    p_recv_tensor(shape)
}

/// Start `n` ranks, one process each (docs/reference/tensor-parallel.md):
/// this process's rank, 0 in the process that was started.
/// `FID_TP_WORLD=n` in the environment overrides `n`; `n <= 1` keeps one
/// rank, at most 32. A second call gives the rank again. `fid run` keeps
/// one rank.
pub fn tp_init(n: i64) -> i64 {
    return p_tp_init(n) as i64;
}

/// This process's rank, 0 to tp_world_size() - 1.
pub fn tp_rank() -> i64 {
    return p_tp_rank() as i64;
}

/// The number of ranks (1 until tp_init started more).
pub fn tp_world_size() -> i64 {
    return p_tp_world_size() as i64;
}
