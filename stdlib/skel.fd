// Fides Skeletal Animation standard library
//
// Skeletal (bone-based) animation for 3D characters and objects.
// Supports bone hierarchies, skin weights, and animation blending.
//
// Data structures follow the glTF 2.0 skinning model:
//   - Skeleton: hierarchy of bones with local transforms
//   - Skin: per-vertex bone weights and indices
//   - Animation: keyframe tracks per bone (translation, rotation, scale)
//   - Pose: computed global transforms for each bone
//
// Usage:
//   use skel;
//   use math;
//
//   var skeleton = skel_create();
//   var root = skel_add_bone(&mut skeleton, -1, "root", vec3(0,0,0), quat(1,0,0,0));
//   var child = skel_add_bone(&mut skeleton, root, "spine", vec3(0,1,0), quat(1,0,0,0));
//   skel_finalize(&mut skeleton);
//
//   var anim = skel_create_animation("walk", skeleton.bones.len());
//   skel_set_keyframe(&mut anim, 0, 0.0, vec3(0,0,0), quat(1,0,0,0), vec3(1,1,1));
//   skel_set_keyframe(&mut anim, 0, 0.5, vec3(0,0.2,0), quat(1,0,0,0), vec3(1,1,1));
//
//   var pose = skel_compute_pose(&skeleton, &anim, 0.25);

module skel;

use vec;
use string;
use math;

// ─── Bone ─────────────────────────────────────────────────────────────────

pub struct Bone {
    pub name: str,
    pub parent: i64,         // parent bone index (-1 = root)
    pub local_pos: vec3,     // local position relative to parent
    pub local_rot: quat,     // local rotation relative to parent
    pub local_scale: vec3,   // local scale
    pub global_pos: vec3,    // computed global position
    pub global_rot: quat,    // computed global rotation
    pub global_scale: vec3,  // computed global scale
    pub offset_matrix: mat4, // inverse bind pose matrix
}

pub struct Skeleton {
    pub bones: Vec<Bone>,
    pub finalized: bool,
}

pub fn skel_create() -> Skeleton {
    return Skeleton {
        bones: Vec::new(),
        finalized: false,
    };
}

/// Add a bone to the skeleton. Returns the bone index.
pub fn skel_add_bone(skel: &mut Skeleton, parent: i64, name: str, pos: vec3, rot: quat) -> i64 {
    var bone = Bone {
        name: name,
        parent: parent,
        local_pos: pos,
        local_rot: rot,
        local_scale: vec3(1.0, 1.0, 1.0),
        global_pos: vec3(0.0, 0.0, 0.0),
        global_rot: quat(1.0, 0.0, 0.0, 0.0),
        global_scale: vec3(1.0, 1.0, 1.0),
        offset_matrix: mat4::identity(),
    };
    skel.bones.push(bone);
    return skel.bones.len() - 1;
}

/// Get bone index by name. Returns -1 if not found.
pub fn skel_find_bone(skel: &Skeleton, name: str) -> i64 {
    var i = 0;
    while i < skel.bones.len() {
        if str_equal(skel.bones.get(i).name, name) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Compute global transforms for all bones (forward kinematics).
pub fn skel_compute_globals(skel: &mut Skeleton) -> void {
    var i = 0;
    while i < skel.bones.len() {
        var bone = skel.bones.get(i);
        if bone.parent < 0 {
            // Root bone: global = local
            bone.global_pos = bone.local_pos;
            bone.global_rot = bone.local_rot;
            bone.global_scale = bone.local_scale;
        } else {
            var parent = skel.bones.get(bone.parent);
            // Global = parent_global * local
            // Scale local position by parent's global scale (component-wise)
            var scaled_pos = vec3(
                bone.local_pos.x * parent.global_scale.x,
                bone.local_pos.y * parent.global_scale.y,
                bone.local_pos.z * parent.global_scale.z
            );
            bone.global_pos = parent.global_pos.add(parent.global_rot.rotate_vec3(scaled_pos));
            bone.global_rot = parent.global_rot.mul(bone.local_rot);
            bone.global_scale = vec3(
                parent.global_scale.x * bone.local_scale.x,
                parent.global_scale.y * bone.local_scale.y,
                parent.global_scale.z * bone.local_scale.z
            );
        }
        skel.bones.set(i, bone);
        i = i + 1;
    }
}

/// Finalize the skeleton: compute globals and inverse bind matrices.
pub fn skel_finalize(skel: &mut Skeleton) -> void {
    skel_compute_globals(skel);

    // Compute inverse bind pose matrices
    var i = 0;
    while i < skel.bones.len() {
        var bone = skel.bones.get(i);
        // Build bind pose matrix from global transform
        var t = translate(bone.global_pos);
        var r = bone.global_rot.to_mat4();
        var s = mat_scale(bone.global_scale.x);
        var bind = t.mul(r).mul(s);
        // Store inverse (simplified: just use identity for now)
        bone.offset_matrix = mat4::identity();
        skel.bones.set(i, bone);
        i = i + 1;
    }
    skel.finalized = true;
}

/// Get the number of bones.
pub fn skel_bone_count(skel: &Skeleton) -> i64 {
    return skel.bones.len();
}

// ─── Keyframe Animation ──────────────────────────────────────────────────

pub struct Keyframe {
    pub time: f64,            // timestamp in seconds
    pub translation: vec3,
    pub rotation: quat,
    pub scale: vec3,
}

pub struct AnimationTrack {
    pub keyframes: Vec<Keyframe>,
}

pub struct Animation {
    pub name: str,
    pub bone_count: i64,
    pub tracks: Vec<AnimationTrack>,  // one track per bone
    pub duration: f64,
    pub looping: bool,
}

/// Create an animation with the given name and bone count.
pub fn skel_create_animation(name: str, bone_count: i64) -> Animation {
    var tracks = Vec::new();
    var i = 0;
    while i < bone_count {
        tracks.push(AnimationTrack { keyframes: Vec::new() });
        i = i + 1;
    }
    return Animation {
        name: name,
        bone_count: bone_count,
        tracks: tracks,
        duration: 0.0,
        looping: true,
    };
}

/// Add a keyframe to a bone's track.
pub fn skel_set_keyframe(anim: &mut Animation, bone_idx: i64, time: f64, pos: vec3, rot: quat, scale: vec3) -> void {
    if bone_idx < 0 || bone_idx >= anim.bone_count { return; }

    var kf = Keyframe {
        time: time,
        translation: pos,
        rotation: rot,
        scale: scale,
    };

    var track = anim.tracks.get(bone_idx).keyframes;
    track.push(kf);
    anim.tracks.set(bone_idx, track);

    if time > anim.duration {
        anim.duration = time;
    }
}

/// Interpolate between two keyframes.
fn skel_interp_keyframe(kf0: Keyframe, kf1: Keyframe, t: f64) -> Keyframe {
    var alpha = (t - kf0.time) / (kf1.time - kf0.time);
    if alpha < 0.0 { alpha = 0.0; }
    if alpha > 1.0 { alpha = 1.0; }

    return Keyframe {
        time: t,
        translation: kf0.translation.lerp(kf1.translation, alpha),
        rotation: kf0.rotation.slerp(kf1.rotation, alpha),
        scale: kf0.scale.lerp(kf1.scale, alpha),
    };
}

/// Sample an animation at a given time, producing local transforms per bone.
/// Returns a vector of Keyframe (one per bone).
pub fn skel_sample_animation(anim: &Animation, time: f64) -> Vec<Keyframe> {
    var result = Vec::new();

    // Handle looping
    var t = time;
    if anim.looping && anim.duration > 0.0 {
        t = t % anim.duration;
    }
    if t > anim.duration { t = anim.duration; }
    if t < 0.0 { t = 0.0; }

    var bone_idx = 0;
    while bone_idx < anim.bone_count {
        var track = anim.tracks.get(bone_idx).keyframes;

        if track.len() == 0 {
            // No keyframes for this bone — use identity
            result.push(Keyframe {
                time: t,
                translation: vec3(0.0, 0.0, 0.0),
                rotation: quat(1.0, 0.0, 0.0, 0.0),
                scale: vec3(1.0, 1.0, 1.0),
            });
        } else if track.len() == 1 {
            result.push(track.get(0));
        } else {
            // Find surrounding keyframes
            var kf0 = track.get(0);
            var kf1 = track.get(track.len() - 1);

            var k = 0;
            while k < track.len() - 1 {
                var a = track.get(k);
                var b = track.get(k + 1);
                if t >= a.time && t <= b.time {
                    kf0 = a;
                    kf1 = b;
                    break;
                }
                k = k + 1;
            }

            if t <= track.get(0).time {
                result.push(track.get(0));
            } else if t >= track.get(track.len() - 1).time {
                result.push(track.get(track.len() - 1));
            } else {
                result.push(skel_interp_keyframe(kf0, kf1, t));
            }
        }

        bone_idx = bone_idx + 1;
    }

    return result;
}

// ─── Pose ────────────────────────────────────────────────────────────────

/// Compute the global pose of a skeleton at a given animation time.
/// Updates the skeleton's bone global transforms.
pub fn skel_compute_pose(skel: &mut Skeleton, anim: &Animation, time: f64) -> void {
    // Sample animation to get local transforms
    var samples = skel_sample_animation(anim, time);

    // Apply local transforms to bones
    var i = 0;
    while i < skel.bones.len() && i < samples.len() {
        var bone = skel.bones.get(i);
        var sample = samples.get(i);
        bone.local_pos = sample.translation;
        bone.local_rot = sample.rotation;
        bone.local_scale = sample.scale;
        skel.bones.set(i, bone);
        i = i + 1;
    }

    // Recompute global transforms
    skel_compute_globals(skel);
}

// ─── Skin (Vertex Weights) ──────────────────────────────────────────────

pub struct VertexWeight {
    pub bone_indices: Vec<i64>,   // up to 4 bone indices
    pub bone_weights: Vec<f64>,   // up to 4 bone weights (sum to 1.0)
}

pub struct Skin {
    pub weights: Vec<VertexWeight>,
    pub bone_count: i64,
}

pub fn skel_create_skin(vertex_count: i64, bone_count: i64) -> Skin {
    var weights = Vec::new();
    var i = 0;
    while i < vertex_count {
        var vw = VertexWeight {
            bone_indices: Vec::new(),
            bone_weights: Vec::new(),
        };
        var j = 0;
        while j < 4 {
            vw.bone_indices.push(0);
            vw.bone_weights.push(0.0);
            j = j + 1;
        }
        weights.push(vw);
        i = i + 1;
    }
    return Skin {
        weights: weights,
        bone_count: bone_count,
    };
}

/// Set vertex skin weights.
pub fn skel_set_vertex_weight(skin: &mut Skin, vertex_idx: i64, b0: i64, b1: i64, b2: i64, b3: i64, w0: f64, w1: f64, w2: f64, w3: f64) -> void {
    if vertex_idx < 0 || vertex_idx >= skin.weights.len() { return; }
    var vw = skin.weights.get(vertex_idx);
    vw.bone_indices.set(0, b0);
    vw.bone_indices.set(1, b1);
    vw.bone_indices.set(2, b2);
    vw.bone_indices.set(3, b3);
    vw.bone_weights.set(0, w0);
    vw.bone_weights.set(1, w1);
    vw.bone_weights.set(2, w2);
    vw.bone_weights.set(3, w3);
    skin.weights.set(vertex_idx, vw);
}

/// Skin a vertex: compute final position from bone transforms and weights.
pub fn skel_skin_vertex(skin: &Skin, skel: &Skeleton, vertex_idx: i64, pos: vec3) -> vec3 {
    if vertex_idx < 0 || vertex_idx >= skin.weights.len() { return pos; }

    var vw = skin.weights.get(vertex_idx);
    var result = vec3(0.0, 0.0, 0.0);

    var j = 0;
    while j < 4 {
        var bone_idx = vw.bone_indices.get(j);
        var weight = vw.bone_weights.get(j);
        if weight > 0.0 && bone_idx >= 0 && bone_idx < skel.bones.len() {
            var bone = skel.bones.get(bone_idx);
            // Transform vertex by bone global transform
            var transformed = bone.global_rot.rotate_vec3(pos.sub(bone.global_pos));
            result = result.add(transformed.scale(weight));
        }
        j = j + 1;
    }

    return result;
}

// ─── Animation Blending ─────────────────────────────────────────────────

/// Blend two animation samples with a weight factor.
pub fn skel_blend_samples(a: Vec<Keyframe>, b: Vec<Keyframe>, weight: f64) -> Vec<Keyframe> {
    var result = Vec::new();
    var i = 0;
    while i < a.len() && i < b.len() {
        var ka = a.get(i);
        var kb = b.get(i);
        result.push(Keyframe {
            time: ka.time,
            translation: ka.translation.lerp(kb.translation, weight),
            rotation: ka.rotation.slerp(kb.rotation, weight),
            scale: ka.scale.lerp(kb.scale, weight),
        });
        i = i + 1;
    }
    return result;
}

/// Blend two animations and compute the resulting pose.
pub fn skel_blend_poses(skel: &mut Skeleton, anim_a: &Animation, anim_b: &Animation, time_a: f64, time_b: f64, blend_weight: f64) -> void {
    var samples_a = skel_sample_animation(anim_a, time_a);
    var samples_b = skel_sample_animation(anim_b, time_b);
    var blended = skel_blend_samples(samples_a, samples_b, blend_weight);

    var i = 0;
    while i < skel.bones.len() && i < blended.len() {
        var bone = skel.bones.get(i);
        var sample = blended.get(i);
        bone.local_pos = sample.translation;
        bone.local_rot = sample.rotation;
        bone.local_scale = sample.scale;
        skel.bones.set(i, bone);
        i = i + 1;
    }

    skel_compute_globals(skel);
}
