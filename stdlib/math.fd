// Fides Math standard library
//
// Provides common math functions by wrapping C library functions (libm).
// In the interpreter, these use Rust's f64 methods.
// In native builds, these use hand-encoded x86-64 implementations.
// In C codegen, these link against libm.
//
// Usage:
//   use math;
//   pv x = math_sqrt(16.0);   // 4.0
//   pv y = math_sin(3.14159); // ~0.0

module math;

// Declare FFI functions from C's math.h
// The runtime (runtime_linux.rs) provides pledge_* implementations.
// The C codegen links against libm.
extern "C" include "<math.h>" link "m" {
    pf sqrt as pledge_sqrt(x: f64) -> f64;
    pf sin as pledge_sin(x: f64) -> f64;
    pf cos as pledge_cos(x: f64) -> f64;
    pf floor as pledge_floor(x: f64) -> f64;
    pf ceil as pledge_ceil(x: f64) -> f64;
    pf pow as pledge_pow(base: f64, exp: f64) -> f64;
    pf fabs as pledge_fabs(x: f64) -> f64;
}

// ─── Constants ───

pub pf math_pi() -> f64 {
    ret 3.14159265358979323846;
}

pub pf math_e() -> f64 {
    ret 2.71828182845904523536;
}

// ─── Floating-point math functions ───

/// Square root of x.
pub pf math_sqrt(x: f64) -> f64 {
    ret pledge_sqrt(x);
}

/// Sine of x (x in radians).
pub pf math_sin(x: f64) -> f64 {
    ret pledge_sin(x);
}

/// Cosine of x (x in radians).
pub pf math_cos(x: f64) -> f64 {
    ret pledge_cos(x);
}

/// Floor of x (largest integer <= x).
pub pf math_floor(x: f64) -> f64 {
    ret pledge_floor(x);
}

/// Ceiling of x (smallest integer >= x).
pub pf math_ceil(x: f64) -> f64 {
    ret pledge_ceil(x);
}

/// base raised to the power of exp.
pub pf math_pow(base: f64, exp: f64) -> f64 {
    ret pledge_pow(base, exp);
}

/// Absolute value of a float.
pub pf math_fabs(x: f64) -> f64 {
    ret pledge_fabs(x);
}

/// Absolute value of an integer.
pub pf math_abs_i64(n: i64) -> i64 {
    if n < 0 { ret -n; }
    ret n;
}

/// Maximum of two floats.
pub pf math_max_f64(a: f64, b: f64) -> f64 {
    if a > b { ret a; }
    ret b;
}

/// Minimum of two floats.
pub pf math_min_f64(a: f64, b: f64) -> f64 {
    if a < b { ret a; }
    ret b;
}

/// Clamp a float to a range.
pub pf math_clamp_f64(n: f64, lo: f64, hi: f64) -> f64 {
    if n < lo { ret lo; }
    if n > hi { ret hi; }
    ret n;
}

// ─── Phase 8A: Vec/Mat/Quat Math Types ───────────────────────────

// Vector types
pub struct vec2 { pub x: f64, pub y: f64 }
pub struct vec3 { pub x: f64, pub y: f64, pub z: f64 }
pub struct vec4 { pub x: f64, pub y: f64, pub z: f64, pub w: f64 }

// 4x4 matrix (column-major)
pub struct mat4 {
    pub m00: f64, pub m01: f64, pub m02: f64, pub m03: f64,
    pub m10: f64, pub m11: f64, pub m12: f64, pub m13: f64,
    pub m20: f64, pub m21: f64, pub m22: f64, pub m23: f64,
    pub m30: f64, pub m31: f64, pub m32: f64, pub m33: f64,
}

// Quaternion (w, x, y, z)
pub struct quat { pub w: f64, pub x: f64, pub y: f64, pub z: f64 }

// ─── Constructor functions ───

pub pf vec2(x: f64, y: f64) -> vec2 {
    ret vec2 { x: x, y: y };
}

pub pf vec3(x: f64, y: f64, z: f64) -> vec3 {
    ret vec3 { x: x, y: y, z: z };
}

pub pf vec4(x: f64, y: f64, z: f64, w: f64) -> vec4 {
    ret vec4 { x: x, y: y, z: z, w: w };
}

pub pf quat(w: f64, x: f64, y: f64, z: f64) -> quat {
    ret quat { w: w, x: x, y: y, z: z };
}

// ─── Utility functions ───

pub pf radians(degrees: f64) -> f64 {
    ret degrees * 0.017453292519943295;
}

pub pf degrees(radians: f64) -> f64 {
    ret radians * 57.29577951308232;
}

pub pf lerp(a: f64, b: f64, t: f64) -> f64 {
    ret a + (b - a) * t;
}

pub pf distance(a: vec3, b: vec3) -> f64 {
    pv dx = a.x - b.x;
    pv dy = a.y - b.y;
    pv dz = a.z - b.z;
    ret pledge_sqrt(dx * dx + dy * dy + dz * dz);
}

// ─── vec2 methods ───

impl vec2 {
    pub pf add(self: vec2, other: vec2) -> vec2 {
        ret vec2 { x: self.x + other.x, y: self.y + other.y };
    }

    pub pf sub(self: vec2, other: vec2) -> vec2 {
        ret vec2 { x: self.x - other.x, y: self.y - other.y };
    }

    pub pf scale(self: vec2, s: f64) -> vec2 {
        ret vec2 { x: self.x * s, y: self.y * s };
    }

    pub pf dot(self: vec2, other: vec2) -> f64 {
        ret self.x * other.x + self.y * other.y;
    }

    pub pf length(self: vec2) -> f64 {
        ret pledge_sqrt(self.x * self.x + self.y * self.y);
    }

    pub pf normalize(self: vec2) -> vec2 {
        pv len = self.length();
        if len == 0.0 { ret vec2 { x: 0.0, y: 0.0 }; }
        ret vec2 { x: self.x / len, y: self.y / len };
    }

    pub pf lerp(self: vec2, other: vec2, t: f64) -> vec2 {
        ret vec2 { x: self.x + (other.x - self.x) * t, y: self.y + (other.y - self.y) * t };
    }
}

// ─── vec3 methods ───

impl vec3 {
    pub pf add(self: vec3, other: vec3) -> vec3 {
        ret vec3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z };
    }

    pub pf sub(self: vec3, other: vec3) -> vec3 {
        ret vec3 { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z };
    }

    pub pf scale(self: vec3, s: f64) -> vec3 {
        ret vec3 { x: self.x * s, y: self.y * s, z: self.z * s };
    }

    pub pf dot(self: vec3, other: vec3) -> f64 {
        ret self.x * other.x + self.y * other.y + self.z * other.z;
    }

    pub pf cross(self: vec3, other: vec3) -> vec3 {
        ret vec3 {
            x: self.y * other.z - self.z * other.y,
            y: self.z * other.x - self.x * other.z,
            z: self.x * other.y - self.y * other.x
        };
    }

    pub pf length(self: vec3) -> f64 {
        ret pledge_sqrt(self.x * self.x + self.y * self.y + self.z * self.z);
    }

    pub pf normalize(self: vec3) -> vec3 {
        pv len = self.length();
        if len == 0.0 { ret vec3 { x: 0.0, y: 0.0, z: 0.0 }; }
        ret vec3 { x: self.x / len, y: self.y / len, z: self.z / len };
    }

    pub pf lerp(self: vec3, other: vec3, t: f64) -> vec3 {
        ret vec3 {
            x: self.x + (other.x - self.x) * t,
            y: self.y + (other.y - self.y) * t,
            z: self.z + (other.z - self.z) * t
        };
    }
}

// ─── vec4 methods ───

impl vec4 {
    pub pf add(self: vec4, other: vec4) -> vec4 {
        ret vec4 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z, w: self.w + other.w };
    }

    pub pf sub(self: vec4, other: vec4) -> vec4 {
        ret vec4 { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z, w: self.w - other.w };
    }

    pub pf scale(self: vec4, s: f64) -> vec4 {
        ret vec4 { x: self.x * s, y: self.y * s, z: self.z * s, w: self.w * s };
    }

    pub pf dot(self: vec4, other: vec4) -> f64 {
        ret self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w;
    }

    pub pf length(self: vec4) -> f64 {
        ret pledge_sqrt(self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w);
    }

    pub pf normalize(self: vec4) -> vec4 {
        pv len = self.length();
        if len == 0.0 { ret vec4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
        ret vec4 { x: self.x / len, y: self.y / len, z: self.z / len, w: self.w / len };
    }

    pub pf xyz(self: vec4) -> vec3 {
        ret vec3 { x: self.x, y: self.y, z: self.z };
    }

    pub pf lerp(self: vec4, other: vec4, t: f64) -> vec4 {
        ret vec4 {
            x: self.x + (other.x - self.x) * t,
            y: self.y + (other.y - self.y) * t,
            z: self.z + (other.z - self.z) * t,
            w: self.w + (other.w - self.w) * t
        };
    }
}

// ─── mat4 methods ───

impl mat4 {
    pub pf identity() -> mat4 {
        ret mat4 {
            m00: 1.0, m01: 0.0, m02: 0.0, m03: 0.0,
            m10: 0.0, m11: 1.0, m12: 0.0, m13: 0.0,
            m20: 0.0, m21: 0.0, m22: 1.0, m23: 0.0,
            m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
        };
    }

    pub pf mul(self: mat4, other: mat4) -> mat4 {
        ret mat4 {
            m00: self.m00 * other.m00 + self.m01 * other.m10 + self.m02 * other.m20 + self.m03 * other.m30,
            m01: self.m00 * other.m01 + self.m01 * other.m11 + self.m02 * other.m21 + self.m03 * other.m31,
            m02: self.m00 * other.m02 + self.m01 * other.m12 + self.m02 * other.m22 + self.m03 * other.m32,
            m03: self.m00 * other.m03 + self.m01 * other.m13 + self.m02 * other.m23 + self.m03 * other.m33,
            m10: self.m10 * other.m00 + self.m11 * other.m10 + self.m12 * other.m20 + self.m13 * other.m30,
            m11: self.m10 * other.m01 + self.m11 * other.m11 + self.m12 * other.m21 + self.m13 * other.m31,
            m12: self.m10 * other.m02 + self.m11 * other.m12 + self.m12 * other.m22 + self.m13 * other.m32,
            m13: self.m10 * other.m03 + self.m11 * other.m13 + self.m12 * other.m23 + self.m13 * other.m33,
            m20: self.m20 * other.m00 + self.m21 * other.m10 + self.m22 * other.m20 + self.m23 * other.m30,
            m21: self.m20 * other.m01 + self.m21 * other.m11 + self.m22 * other.m21 + self.m23 * other.m31,
            m22: self.m20 * other.m02 + self.m21 * other.m12 + self.m22 * other.m22 + self.m23 * other.m32,
            m23: self.m20 * other.m03 + self.m21 * other.m13 + self.m22 * other.m23 + self.m23 * other.m33,
            m30: self.m30 * other.m00 + self.m31 * other.m10 + self.m32 * other.m20 + self.m33 * other.m30,
            m31: self.m30 * other.m01 + self.m31 * other.m11 + self.m32 * other.m21 + self.m33 * other.m31,
            m32: self.m30 * other.m02 + self.m31 * other.m12 + self.m32 * other.m22 + self.m33 * other.m32,
            m33: self.m30 * other.m03 + self.m31 * other.m13 + self.m32 * other.m23 + self.m33 * other.m33
        };
    }

    pub pf transform_vec4(self: mat4, v: vec4) -> vec4 {
        ret vec4 {
            x: self.m00 * v.x + self.m01 * v.y + self.m02 * v.z + self.m03 * v.w,
            y: self.m10 * v.x + self.m11 * v.y + self.m12 * v.z + self.m13 * v.w,
            z: self.m20 * v.x + self.m21 * v.y + self.m22 * v.z + self.m23 * v.w,
            w: self.m30 * v.x + self.m31 * v.y + self.m32 * v.z + self.m33 * v.w
        };
    }

    pub pf transform_vec3(self: mat4, v: vec3) -> vec3 {
        pv w = self.m30 * v.x + self.m31 * v.y + self.m32 * v.z + self.m33;
        if w == 0.0 { w = 1.0; }
        ret vec3 {
            x: (self.m00 * v.x + self.m01 * v.y + self.m02 * v.z + self.m03) / w,
            y: (self.m10 * v.x + self.m11 * v.y + self.m12 * v.z + self.m13) / w,
            z: (self.m20 * v.x + self.m21 * v.y + self.m22 * v.z + self.m23) / w
        };
    }
}

// ─── Matrix construction functions ───

pub pf translate(t: vec3) -> mat4 {
    ret mat4 {
        m00: 1.0, m01: 0.0, m02: 0.0, m03: t.x,
        m10: 0.0, m11: 1.0, m12: 0.0, m13: t.y,
        m20: 0.0, m21: 0.0, m22: 1.0, m23: t.z,
        m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    };
}

pub pf mat_scale(s: f64) -> mat4 {
    ret mat4 {
        m00: s,   m01: 0.0, m02: 0.0, m03: 0.0,
        m10: 0.0, m11: s,   m12: 0.0, m13: 0.0,
        m20: 0.0, m21: 0.0, m22: s,   m23: 0.0,
        m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    };
}

// ─── Quaternion methods ───

impl quat {
    pub pf from_axis_angle(axis: vec3, angle: f64) -> quat {
        pv half = angle * 0.5;
        pv s = pledge_sin(half);
        ret quat {
            w: pledge_cos(half),
            x: axis.x * s,
            y: axis.y * s,
            z: axis.z * s
        };
    }

    pub pf rotate_vec3(self: quat, v: vec3) -> vec3 {
        // q * v * q^-1 (simplified for unit quaternion)
        pv qx = self.x;
        pv qy = self.y;
        pv qz = self.z;
        pv qw = self.w;
        pv vx = v.x;
        pv vy = v.y;
        pv vz = v.z;
        // t = 2 * cross(q.xyz, v)
        pv tx = 2.0 * (qy * vz - qz * vy);
        pv ty = 2.0 * (qz * vx - qx * vz);
        pv tz = 2.0 * (qx * vy - qy * vx);
        // result = v + q.w * t + cross(q.xyz, t)
        ret vec3 {
            x: vx + qw * tx + (qy * tz - qz * ty),
            y: vy + qw * ty + (qz * tx - qx * tz),
            z: vz + qw * tz + (qx * ty - qy * tx)
        };
    }
}
