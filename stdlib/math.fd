// Fides Math standard library
//
// Provides common math functions by wrapping C library functions (libm).
// In the interpreter, these use Rust's f64 methods.
// In native builds, these use hand-encoded x86-64 implementations.
// In C codegen, these link against libm.
//
// Usage:
//   use math;
//   pv x = math_sqrt(16.0);   // 4.0
//   pv y = math_sin(3.14159); // ~0.0

module math;

// Declare FFI functions from C's math.h
// The runtime (runtime_linux.rs) provides pledge_* implementations.
// The C codegen links against libm.
extern "C" include "<math.h>" link "m" {
    pf sqrt as pledge_sqrt(x: f64) -> f64;
    pf sin as pledge_sin(x: f64) -> f64;
    pf cos as pledge_cos(x: f64) -> f64;
    pf floor as pledge_floor(x: f64) -> f64;
    pf ceil as pledge_ceil(x: f64) -> f64;
    pf pow as pledge_pow(base: f64, exp: f64) -> f64;
    pf fabs as pledge_fabs(x: f64) -> f64;
}

// ─── Constants ───

pub pf math_pi() -> f64 {
    ret 3.14159265358979323846;
}

pub pf math_e() -> f64 {
    ret 2.71828182845904523536;
}

// ─── Floating-point math functions ───

/// Square root of x.
pub pf math_sqrt(x: f64) -> f64 {
    ret pledge_sqrt(x);
}

/// Sine of x (x in radians).
pub pf math_sin(x: f64) -> f64 {
    ret pledge_sin(x);
}

/// Cosine of x (x in radians).
pub pf math_cos(x: f64) -> f64 {
    ret pledge_cos(x);
}

/// Floor of x (largest integer <= x).
pub pf math_floor(x: f64) -> f64 {
    ret pledge_floor(x);
}

/// Ceiling of x (smallest integer >= x).
pub pf math_ceil(x: f64) -> f64 {
    ret pledge_ceil(x);
}

/// base raised to the power of exp.
pub pf math_pow(base: f64, exp: f64) -> f64 {
    ret pledge_pow(base, exp);
}

/// Absolute value of a float.
pub pf math_fabs(x: f64) -> f64 {
    ret pledge_fabs(x);
}

/// Absolute value of an integer.
pub pf math_abs_i64(n: i64) -> i64 {
    if n < 0 { ret -n; }
    ret n;
}

/// Maximum of two floats.
pub pf math_max_f64(a: f64, b: f64) -> f64 {
    if a > b { ret a; }
    ret b;
}

/// Minimum of two floats.
pub pf math_min_f64(a: f64, b: f64) -> f64 {
    if a < b { ret a; }
    ret b;
}

/// Clamp a float to a range.
pub pf math_clamp_f64(n: f64, lo: f64, hi: f64) -> f64 {
    if n < lo { ret lo; }
    if n > hi { ret hi; }
    ret n;
}
