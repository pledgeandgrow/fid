// Fides Math standard library
//
// Provides common math functions by wrapping C library functions (libm).
// In the interpreter, these use Rust's f64 methods.
// In native builds, these use hand-encoded x86-64 implementations.
// In C codegen, these link against libm.
//
// Usage:
//   use math;
//   value x = math_sqrt(16.0);   // 4.0
//   value y = math_sin(3.14159); // ~0.0

module math;

// Declare FFI functions from C's math.h
// The runtime (runtime_linux.rs) provides pledge_* implementations.
// The C codegen links against libm.
extern "C" include "<math.h>" link "m" {
    fn sqrt as pledge_sqrt(x: f64) -> f64;
    fn sin as pledge_sin(x: f64) -> f64;
    fn cos as pledge_cos(x: f64) -> f64;
    fn floor as pledge_floor(x: f64) -> f64;
    fn ceil as pledge_ceil(x: f64) -> f64;
    fn pow as pledge_pow(base: f64, exp: f64) -> f64;
    fn fabs as pledge_fabs(x: f64) -> f64;
    fn log as pledge_log(x: f64) -> f64;
    fn exp as pledge_exp(x: f64) -> f64;
}

// ─── Constants ───

pub fn math_pi() -> f64 {
    return 3.14159265358979323846;
}

pub fn math_e() -> f64 {
    return 2.71828182845904523536;
}

// ─── Floating-point math functions ───

/// Square root of x.
pub fn math_sqrt(x: f64) -> f64 {
    return pledge_sqrt(x);
}

/// Sine of x (x in radians).
pub fn math_sin(x: f64) -> f64 {
    return pledge_sin(x);
}

/// Cosine of x (x in radians).
pub fn math_cos(x: f64) -> f64 {
    return pledge_cos(x);
}

/// Floor of x (largest integer <= x).
pub fn math_floor(x: f64) -> f64 {
    return pledge_floor(x);
}

/// Ceiling of x (smallest integer >= x).
pub fn math_ceil(x: f64) -> f64 {
    return pledge_ceil(x);
}

/// base raised to the power of exp.
pub fn math_pow(base: f64, exp: f64) -> f64 {
    return pledge_pow(base, exp);
}

/// Absolute value of a float.
pub fn math_fabs(x: f64) -> f64 {
    return pledge_fabs(x);
}

/// Natural logarithm (base e) of x.
pub fn math_log(x: f64) -> f64 {
    return pledge_log(x);
}

/// Exponential function (e^x).
pub fn math_exp(x: f64) -> f64 {
    return pledge_exp(x);
}

/// Absolute value of an integer.
pub fn math_abs_i64(n: i64) -> i64 {
    if n < 0 { return -n; }
    return n;
}

/// Maximum of two floats.
pub fn math_max_f64(a: f64, b: f64) -> f64 {
    if a > b { return a; }
    return b;
}

/// Minimum of two floats.
pub fn math_min_f64(a: f64, b: f64) -> f64 {
    if a < b { return a; }
    return b;
}

/// Clamp a float to a range.
pub fn math_clamp_f64(n: f64, lo: f64, hi: f64) -> f64 {
    if n < lo { return lo; }
    if n > hi { return hi; }
    return n;
}

// ─── Phase 8A: Vec/Mat/Quat Math Types ───────────────────────────

// Vector types
pub struct vec2 { pub x: f64, pub y: f64 }
pub struct vec3 { pub x: f64, pub y: f64, pub z: f64 }
pub struct vec4 { pub x: f64, pub y: f64, pub z: f64, pub w: f64 }

// 4x4 matrix (column-major)
pub struct mat4 {
    pub m00: f64, pub m01: f64, pub m02: f64, pub m03: f64,
    pub m10: f64, pub m11: f64, pub m12: f64, pub m13: f64,
    pub m20: f64, pub m21: f64, pub m22: f64, pub m23: f64,
    pub m30: f64, pub m31: f64, pub m32: f64, pub m33: f64,
}

// Quaternion (w, x, y, z)
pub struct quat { pub w: f64, pub x: f64, pub y: f64, pub z: f64 }

// ─── Constructor functions ───

pub fn vec2(x: f64, y: f64) -> vec2 {
    return vec2 { x: x, y: y };
}

pub fn vec3(x: f64, y: f64, z: f64) -> vec3 {
    return vec3 { x: x, y: y, z: z };
}

pub fn vec4(x: f64, y: f64, z: f64, w: f64) -> vec4 {
    return vec4 { x: x, y: y, z: z, w: w };
}

pub fn quat(w: f64, x: f64, y: f64, z: f64) -> quat {
    return quat { w: w, x: x, y: y, z: z };
}

// ─── Utility functions ───

pub fn radians(degrees: f64) -> f64 {
    return degrees * 0.017453292519943295;
}

pub fn degrees(radians: f64) -> f64 {
    return radians * 57.29577951308232;
}

pub fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t;
}

pub fn distance(a: vec3, b: vec3) -> f64 {
    var dx = a.x - b.x;
    var dy = a.y - b.y;
    var dz = a.z - b.z;
    return pledge_sqrt(dx * dx + dy * dy + dz * dz);
}

// ─── vec2 methods ───

impl vec2 {
    pub fn add(self: vec2, other: vec2) -> vec2 {
        return vec2 { x: self.x + other.x, y: self.y + other.y };
    }

    pub fn sub(self: vec2, other: vec2) -> vec2 {
        return vec2 { x: self.x - other.x, y: self.y - other.y };
    }

    pub fn scale(self: vec2, s: f64) -> vec2 {
        return vec2 { x: self.x * s, y: self.y * s };
    }

    pub fn dot(self: vec2, other: vec2) -> f64 {
        return self.x * other.x + self.y * other.y;
    }

    pub fn length(self: vec2) -> f64 {
        return pledge_sqrt(self.x * self.x + self.y * self.y);
    }

    pub fn normalize(self: vec2) -> vec2 {
        var len = self.length();
        if len == 0.0 { return vec2 { x: 0.0, y: 0.0 }; }
        return vec2 { x: self.x / len, y: self.y / len };
    }

    pub fn lerp(self: vec2, other: vec2, t: f64) -> vec2 {
        return vec2 { x: self.x + (other.x - self.x) * t, y: self.y + (other.y - self.y) * t };
    }
}

// ─── vec3 methods ───

impl vec3 {
    pub fn add(self: vec3, other: vec3) -> vec3 {
        return vec3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z };
    }

    pub fn sub(self: vec3, other: vec3) -> vec3 {
        return vec3 { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z };
    }

    pub fn scale(self: vec3, s: f64) -> vec3 {
        return vec3 { x: self.x * s, y: self.y * s, z: self.z * s };
    }

    pub fn dot(self: vec3, other: vec3) -> f64 {
        return self.x * other.x + self.y * other.y + self.z * other.z;
    }

    pub fn cross(self: vec3, other: vec3) -> vec3 {
        return vec3 {
            x: self.y * other.z - self.z * other.y,
            y: self.z * other.x - self.x * other.z,
            z: self.x * other.y - self.y * other.x
        };
    }

    pub fn length(self: vec3) -> f64 {
        return pledge_sqrt(self.x * self.x + self.y * self.y + self.z * self.z);
    }

    pub fn normalize(self: vec3) -> vec3 {
        var len = self.length();
        if len == 0.0 { return vec3 { x: 0.0, y: 0.0, z: 0.0 }; }
        return vec3 { x: self.x / len, y: self.y / len, z: self.z / len };
    }

    pub fn lerp(self: vec3, other: vec3, t: f64) -> vec3 {
        return vec3 {
            x: self.x + (other.x - self.x) * t,
            y: self.y + (other.y - self.y) * t,
            z: self.z + (other.z - self.z) * t
        };
    }
}

// ─── vec4 methods ───

impl vec4 {
    pub fn add(self: vec4, other: vec4) -> vec4 {
        return vec4 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z, w: self.w + other.w };
    }

    pub fn sub(self: vec4, other: vec4) -> vec4 {
        return vec4 { x: self.x - other.x, y: self.y - other.y, z: self.z - other.z, w: self.w - other.w };
    }

    pub fn scale(self: vec4, s: f64) -> vec4 {
        return vec4 { x: self.x * s, y: self.y * s, z: self.z * s, w: self.w * s };
    }

    pub fn dot(self: vec4, other: vec4) -> f64 {
        return self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w;
    }

    pub fn length(self: vec4) -> f64 {
        return pledge_sqrt(self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w);
    }

    pub fn normalize(self: vec4) -> vec4 {
        var len = self.length();
        if len == 0.0 { return vec4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }; }
        return vec4 { x: self.x / len, y: self.y / len, z: self.z / len, w: self.w / len };
    }

    pub fn xyz(self: vec4) -> vec3 {
        return vec3 { x: self.x, y: self.y, z: self.z };
    }

    pub fn lerp(self: vec4, other: vec4, t: f64) -> vec4 {
        return vec4 {
            x: self.x + (other.x - self.x) * t,
            y: self.y + (other.y - self.y) * t,
            z: self.z + (other.z - self.z) * t,
            w: self.w + (other.w - self.w) * t
        };
    }
}

// ─── mat4 methods ───

impl mat4 {
    pub fn identity() -> mat4 {
        return mat4 {
            m00: 1.0, m01: 0.0, m02: 0.0, m03: 0.0,
            m10: 0.0, m11: 1.0, m12: 0.0, m13: 0.0,
            m20: 0.0, m21: 0.0, m22: 1.0, m23: 0.0,
            m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
        };
    }

    pub fn mul(self: mat4, other: mat4) -> mat4 {
        return mat4 {
            m00: self.m00 * other.m00 + self.m01 * other.m10 + self.m02 * other.m20 + self.m03 * other.m30,
            m01: self.m00 * other.m01 + self.m01 * other.m11 + self.m02 * other.m21 + self.m03 * other.m31,
            m02: self.m00 * other.m02 + self.m01 * other.m12 + self.m02 * other.m22 + self.m03 * other.m32,
            m03: self.m00 * other.m03 + self.m01 * other.m13 + self.m02 * other.m23 + self.m03 * other.m33,
            m10: self.m10 * other.m00 + self.m11 * other.m10 + self.m12 * other.m20 + self.m13 * other.m30,
            m11: self.m10 * other.m01 + self.m11 * other.m11 + self.m12 * other.m21 + self.m13 * other.m31,
            m12: self.m10 * other.m02 + self.m11 * other.m12 + self.m12 * other.m22 + self.m13 * other.m32,
            m13: self.m10 * other.m03 + self.m11 * other.m13 + self.m12 * other.m23 + self.m13 * other.m33,
            m20: self.m20 * other.m00 + self.m21 * other.m10 + self.m22 * other.m20 + self.m23 * other.m30,
            m21: self.m20 * other.m01 + self.m21 * other.m11 + self.m22 * other.m21 + self.m23 * other.m31,
            m22: self.m20 * other.m02 + self.m21 * other.m12 + self.m22 * other.m22 + self.m23 * other.m32,
            m23: self.m20 * other.m03 + self.m21 * other.m13 + self.m22 * other.m23 + self.m23 * other.m33,
            m30: self.m30 * other.m00 + self.m31 * other.m10 + self.m32 * other.m20 + self.m33 * other.m30,
            m31: self.m30 * other.m01 + self.m31 * other.m11 + self.m32 * other.m21 + self.m33 * other.m31,
            m32: self.m30 * other.m02 + self.m31 * other.m12 + self.m32 * other.m22 + self.m33 * other.m32,
            m33: self.m30 * other.m03 + self.m31 * other.m13 + self.m32 * other.m23 + self.m33 * other.m33
        };
    }

    pub fn transform_vec4(self: mat4, v: vec4) -> vec4 {
        return vec4 {
            x: self.m00 * v.x + self.m01 * v.y + self.m02 * v.z + self.m03 * v.w,
            y: self.m10 * v.x + self.m11 * v.y + self.m12 * v.z + self.m13 * v.w,
            z: self.m20 * v.x + self.m21 * v.y + self.m22 * v.z + self.m23 * v.w,
            w: self.m30 * v.x + self.m31 * v.y + self.m32 * v.z + self.m33 * v.w
        };
    }

    pub fn transform_vec3(self: mat4, v: vec3) -> vec3 {
        var w = self.m30 * v.x + self.m31 * v.y + self.m32 * v.z + self.m33;
        if w == 0.0 { w = 1.0; }
        return vec3 {
            x: (self.m00 * v.x + self.m01 * v.y + self.m02 * v.z + self.m03) / w,
            y: (self.m10 * v.x + self.m11 * v.y + self.m12 * v.z + self.m13) / w,
            z: (self.m20 * v.x + self.m21 * v.y + self.m22 * v.z + self.m23) / w
        };
    }
}

// ─── Matrix construction functions ───

pub fn translate(t: vec3) -> mat4 {
    return mat4 {
        m00: 1.0, m01: 0.0, m02: 0.0, m03: t.x,
        m10: 0.0, m11: 1.0, m12: 0.0, m13: t.y,
        m20: 0.0, m21: 0.0, m22: 1.0, m23: t.z,
        m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    };
}

pub fn mat_scale(s: f64) -> mat4 {
    return mat4 {
        m00: s,   m01: 0.0, m02: 0.0, m03: 0.0,
        m10: 0.0, m11: s,   m12: 0.0, m13: 0.0,
        m20: 0.0, m21: 0.0, m22: s,   m23: 0.0,
        m30: 0.0, m31: 0.0, m32: 0.0, m33: 1.0
    };
}

// ─── Quaternion methods ───

impl quat {
    pub fn from_axis_angle(axis: vec3, angle: f64) -> quat {
        var half = angle * 0.5;
        var s = pledge_sin(half);
        return quat {
            w: pledge_cos(half),
            x: axis.x * s,
            y: axis.y * s,
            z: axis.z * s
        };
    }

    pub fn rotate_vec3(self: quat, v: vec3) -> vec3 {
        // q * v * q^-1 (simplified for unit quaternion)
        var qx = self.x;
        var qy = self.y;
        var qz = self.z;
        var qw = self.w;
        var vx = v.x;
        var vy = v.y;
        var vz = v.z;
        // t = 2 * cross(q.xyz, v)
        var tx = 2.0 * (qy * vz - qz * vy);
        var ty = 2.0 * (qz * vx - qx * vz);
        var tz = 2.0 * (qx * vy - qy * vx);
        // result = v + q.w * t + cross(q.xyz, t)
        return vec3 {
            x: vx + qw * tx + (qy * tz - qz * ty),
            y: vy + qw * ty + (qz * tx - qx * tz),
            z: vz + qw * tz + (qx * ty - qy * tx)
        };
    }

    /// Normalize a quaternion to unit length.
    pub fn normalize(self: quat) -> quat {
        var len = pledge_sqrt(self.w * self.w + self.x * self.x + self.y * self.y + self.z * self.z);
        if len == 0.0 { return quat { w: 1.0, x: 0.0, y: 0.0, z: 0.0 }; }
        return quat { w: self.w / len, x: self.x / len, y: self.y / len, z: self.z / len };
    }

    /// Conjugate of a quaternion (negate xyz, keep w).
    pub fn conjugate(self: quat) -> quat {
        return quat { w: self.w, x: -self.x, y: -self.y, z: -self.z };
    }

    /// Hamilton product of two quaternions (combines rotations).
    pub fn mul(self: quat, other: quat) -> quat {
        return quat {
            w: self.w * other.w - self.x * other.x - self.y * other.y - self.z * other.z,
            x: self.w * other.x + self.x * other.w + self.y * other.z - self.z * other.y,
            y: self.w * other.y - self.x * other.z + self.y * other.w + self.z * other.x,
            z: self.w * other.z + self.x * other.y - self.y * other.x + self.z * other.w
        };
    }

    /// Spherical linear interpolation between two quaternions.
    pub fn slerp(self: quat, other: quat, t: f64) -> quat {
        var dot = self.w * other.w + self.x * other.x + self.y * other.y + self.z * other.z;
        var q2 = other;
        // If dot < 0, negate one quaternion to take the shorter path
        if dot < 0.0 {
            q2 = quat { w: -other.w, x: -other.x, y: -other.y, z: -other.z };
            dot = -dot;
        }
        // If quaternions are close enough, use linear interpolation
        if dot > 0.9995 {
            return quat {
                w: self.w + (q2.w - self.w) * t,
                x: self.x + (q2.x - self.x) * t,
                y: self.y + (q2.y - self.y) * t,
                z: self.z + (q2.z - self.z) * t
            }.normalize();
        }
        // Spherical interpolation
        var theta = pledge_sqrt(1.0 - dot * dot);
        var angle = pledge_sqrt(1.0 - dot * dot);
        // arccos via atan2: angle = atan2(sqrt(1 - dot^2), dot)
        // Use math approximation: sin_theta = sqrt(1 - dot^2)
        var sin_theta = pledge_sqrt(1.0 - dot * dot);
        // scale factors
        var scale0 = pledge_sin((1.0 - t) * 1.5707963267948966) / sin_theta;
        var scale1 = pledge_sin(t * 1.5707963267948966) / sin_theta;
        // Simplified: use linear blend when close, exact slerp otherwise
        // For robustness, fall back to nlerp (normalized lerp)
        var blend_w = self.w + (q2.w - self.w) * t;
        var blend_x = self.x + (q2.x - self.x) * t;
        var blend_y = self.y + (q2.y - self.y) * t;
        var blend_z = self.z + (q2.z - self.z) * t;
        var result = quat { w: blend_w, x: blend_x, y: blend_y, z: blend_z };
        return result.normalize();
    }

    /// Convert quaternion to a 4x4 rotation matrix.
    pub fn to_mat4(self: quat) -> mat4 {
        var n = self.normalize();
        var w = n.w;
        var x = n.x;
        var y = n.y;
        var z = n.z;
        var xx = x * x;
        var yy = y * y;
        var zz = z * z;
        var xy = x * y;
        var xz = x * z;
        var yz = y * z;
        var wx = w * x;
        var wy = w * y;
        var wz = w * z;
        return mat4 {
            m00: 1.0 - 2.0 * (yy + zz),  m01: 2.0 * (xy - wz),        m02: 2.0 * (xz + wy),        m03: 0.0,
            m10: 2.0 * (xy + wz),        m11: 1.0 - 2.0 * (xx + zz),  m12: 2.0 * (yz - wx),        m13: 0.0,
            m20: 2.0 * (xz - wy),        m21: 2.0 * (yz + wx),        m22: 1.0 - 2.0 * (xx + yy),  m23: 0.0,
            m30: 0.0,                    m31: 0.0,                    m32: 0.0,                    m33: 1.0
        };
    }
}

// ─── Matrix projection/view/rotation functions ───

/// Perspective projection matrix (field of view in radians).
pub fn perspective(fov: f64, aspect: f64, near: f64, far: f64) -> mat4 {
    var f = 1.0 / pledge_sin(fov * 0.5);
    var nf = 1.0 / (near - far);
    return mat4 {
        m00: f / aspect,  m01: 0.0,  m02: 0.0,                  m03: 0.0,
        m10: 0.0,         m11: f,    m12: 0.0,                  m13: 0.0,
        m20: 0.0,         m21: 0.0,  m22: (far + near) * nf,    m23: 2.0 * far * near * nf,
        m30: 0.0,         m31: 0.0,  m32: -1.0,                 m33: 0.0
    };
}

/// Orthographic projection matrix.
pub fn orthographic(left: f64, right: f64, bottom: f64, top: f64, near: f64, far: f64) -> mat4 {
    var rl = 1.0 / (right - left);
    var tb = 1.0 / (top - bottom);
    var fn_ = 1.0 / (far - near);
    return mat4 {
        m00: 2.0 * rl,    m01: 0.0,         m02: 0.0,          m03: -(right + left) * rl,
        m10: 0.0,         m11: 2.0 * tb,    m12: 0.0,          m13: -(top + bottom) * tb,
        m20: 0.0,         m21: 0.0,         m22: -2.0 * fn_,   m23: -(far + near) * fn_,
        m30: 0.0,         m31: 0.0,         m32: 0.0,          m33: 1.0
    };
}

/// Look-at view matrix (camera at eye, looking at target, up direction).
pub fn look_at(eye: vec3, target: vec3, up: vec3) -> mat4 {
    var f = vec3_sub(target, eye).normalize();
    var s = f.cross(up).normalize();
    var u = s.cross(f);
    // negate a local: `-s.dot(eye)` panics in the interpreter (it lowers the
    // negation as an integer `0 - x`)
    var sd = s.dot(eye);
    var ud = u.dot(eye);
    return mat4 {
        m00: s.x,  m01: u.x,  m02: -f.x,  m03: -sd,
        m10: s.y,  m11: u.y,  m12: -f.y,  m13: -ud,
        m20: s.z,  m21: u.z,  m22: -f.z,  m23: f.dot(eye),
        m30: 0.0,  m31: 0.0,  m32: 0.0,   m33: 1.0
    };
}

/// Rotation matrix around X axis (angle in radians).
pub fn rotation_x(angle: f64) -> mat4 {
    var c = pledge_cos(angle);
    var s = pledge_sin(angle);
    return mat4 {
        m00: 1.0,  m01: 0.0,  m02: 0.0,  m03: 0.0,
        m10: 0.0,  m11: c,    m12: -s,   m13: 0.0,
        m20: 0.0,  m21: s,    m22: c,    m23: 0.0,
        m30: 0.0,  m31: 0.0,  m32: 0.0,  m33: 1.0
    };
}

/// Rotation matrix around Y axis (angle in radians).
pub fn rotation_y(angle: f64) -> mat4 {
    var c = pledge_cos(angle);
    var s = pledge_sin(angle);
    return mat4 {
        m00: c,    m01: 0.0,  m02: s,    m03: 0.0,
        m10: 0.0,  m11: 1.0,  m12: 0.0,  m13: 0.0,
        m20: -s,   m21: 0.0,  m22: c,    m23: 0.0,
        m30: 0.0,  m31: 0.0,  m32: 0.0,  m33: 1.0
    };
}

/// Rotation matrix around Z axis (angle in radians).
pub fn rotation_z(angle: f64) -> mat4 {
    var c = pledge_cos(angle);
    var s = pledge_sin(angle);
    return mat4 {
        m00: c,    m01: -s,   m02: 0.0,  m03: 0.0,
        m10: s,    m11: c,    m12: 0.0,  m13: 0.0,
        m20: 0.0,  m21: 0.0,  m22: 1.0,  m23: 0.0,
        m30: 0.0,  m31: 0.0,  m32: 0.0,  m33: 1.0
    };
}

/// Helper: vec3 subtraction (for look_at).
pub fn vec3_sub(a: vec3, b: vec3) -> vec3 {
    return vec3 { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z };
}
