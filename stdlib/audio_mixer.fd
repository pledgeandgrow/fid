// Fides Audio Mixer standard library
//
// Multi-channel audio mixer with 3D positional audio, volume control,
// and music streaming. Built on top of the SDL_mixer FFI in sdl.fd.
//
// Features:
//   - Channel grouping (SFX, music, voice, ambient)
//   - Per-group and master volume control
//   - 3D positional audio (distance attenuation, panning)
//   - Sound caching (load once, play many times)
//   - Music streaming (loop, fade in/out)
//
// Usage:
//   use audio_mixer;
//   use sdl;
//
//   audio_mixer_init();
//   var snd = audio_mixer_load("explosion.wav");
//   audio_mixer_play_3d(snd, listener_x, listener_y, source_x, source_y, 200.0);
//   audio_mixer_set_group_volume(GROUP_SFX, 0.5);

module audio_mixer;

use vec;
use string;
use math;
use sdl;

use vec;
use string;
use math;

// ─── Channel Groups ──────────────────────────────────────────────────────

pub const GROUP_MASTER: i64 = 0;
pub const GROUP_SFX: i64 = 1;
pub const GROUP_MUSIC: i64 = 2;
pub const GROUP_VOICE: i64 = 3;
pub const GROUP_AMBIENT: i64 = 4;
pub const GROUP_COUNT: i64 = 5;

// ─── Sound Cache ─────────────────────────────────────────────────────────

pub struct SoundEntry {
    pub name: str,
    pub handle: i64,        // SDL_mixer chunk handle
    pub group: i64,
    pub default_volume: f64,
    pub loaded: bool,
}

pub struct AudioMixer {
    pub sounds: Vec<SoundEntry>,
    pub group_volumes: Vec<f64>,   // per-group volume (0..1)
    pub master_volume: f64,
    pub listener_x: f64,
    pub listener_y: f64,
    pub listener_z: f64,
    pub max_distance: f64,        // distance at which sound is inaudible
    pub ref_distance: f64,        // distance at which sound is at full volume
    pub rolloff: f64,             // attenuation curve (1.0 = linear)
    pub initialized: bool,
}

var g_mixer: AudioMixer = AudioMixer {
    sounds: Vec::new(),
    group_volumes: Vec::new(),
    master_volume: 1.0,
    listener_x: 0.0, listener_y: 0.0, listener_z: 0.0,
    max_distance: 500.0,
    ref_distance: 50.0,
    rolloff: 1.0,
    initialized: false,
};

/// Initialize the audio mixer.
pub fn audio_mixer_init() -> void {
    g_mixer.group_volumes.clear();
    var i = 0;
    while i < GROUP_COUNT {
        g_mixer.group_volumes.push(1.0);
        i = i + 1;
    }
    g_mixer.master_volume = 1.0;
    g_mixer.initialized = true;
}

/// Load a sound file into the cache. Returns the sound index or -1 on failure.
pub fn audio_mixer_load(name: str) -> i64 {
    if !g_mixer.initialized { return -1; }

    // Check if already loaded
    var i = 0;
    while i < g_mixer.sounds.len() {
        if str_equal(g_mixer.sounds.get(i).name, name) {
            return i;
        }
        i = i + 1;
    }

    // Load via SDL_mixer
    var handle = sdl_audio_load(name);
    if handle == 0 { return -1; }

    var entry = SoundEntry {
        name: name,
        handle: handle,
        group: GROUP_SFX,
        default_volume: 1.0,
        loaded: true,
    };
    g_mixer.sounds.push(entry);
    return g_mixer.sounds.len() - 1;
}

/// Load a sound into a specific group.
pub fn audio_mixer_load_group(name: str, group: i64) -> i64 {
    var idx = audio_mixer_load(name);
    if idx >= 0 {
        var entry = g_mixer.sounds.get(idx);
        entry.group = group;
        g_mixer.sounds.set(idx, entry);
    }
    return idx;
}

/// Play a sound by index.
pub fn audio_mixer_play(sound_idx: i64) -> i64 {
    if sound_idx < 0 || sound_idx >= g_mixer.sounds.len() { return -1; }
    var entry = g_mixer.sounds.get(sound_idx);
    if !entry.loaded { return -1; }

    var vol = audio_mixer_compute_volume(entry.group, entry.default_volume);
    sdl_audio_volume(-1, (vol * 128.0) as i64);  // SDL volume is 0..128
    return sdl_audio_play(-1, entry.handle, 0);
}

/// Play a sound with a specific volume override.
pub fn audio_mixer_play_volume(sound_idx: i64, volume: f64) -> i64 {
    if sound_idx < 0 || sound_idx >= g_mixer.sounds.len() { return -1; }
    var entry = g_mixer.sounds.get(sound_idx);
    if !entry.loaded { return -1; }

    var vol = audio_mixer_compute_volume(entry.group, volume);
    sdl_audio_volume(-1, (vol * 128.0) as i64);  // SDL volume is 0..128
    return sdl_audio_play(-1, entry.handle, 0);
}

/// Play a sound with 3D positional attenuation.
pub fn audio_mixer_play_3d(sound_idx: i64, sx: f64, sy: f64, sz: f64) -> i64 {
    if sound_idx < 0 || sound_idx >= g_mixer.sounds.len() { return -1; }
    var entry = g_mixer.sounds.get(sound_idx);
    if !entry.loaded { return -1; }

    // Compute distance attenuation
    var dx = sx - g_mixer.listener_x;
    var dy = sy - g_mixer.listener_y;
    var dz = sz - g_mixer.listener_z;
    var dist = pledge_sqrt(dx * dx + dy * dy + dz * dz);

    var att = audio_mixer_distance_attenuation(dist);
    var vol = audio_mixer_compute_volume(entry.group, entry.default_volume * att);
    sdl_audio_volume(-1, (vol * 128.0) as i64);  // SDL volume is 0..128

    return sdl_audio_play(-1, entry.handle, 0);
}

/// Play a sound with 2D positional audio (x, y only).
pub fn audio_mixer_play_2d(sound_idx: i64, sx: f64, sy: f64) -> i64 {
    return audio_mixer_play_3d(sound_idx, sx, sy, 0.0);
}

/// Compute distance attenuation factor (0..1).
pub fn audio_mixer_distance_attenuation(distance: f64) -> f64 {
    if distance <= g_mixer.ref_distance { return 1.0; }
    if distance >= g_mixer.max_distance { return 0.0; }
    // Linear attenuation
    var t = (distance - g_mixer.ref_distance) / (g_mixer.max_distance - g_mixer.ref_distance);
    return 1.0 - t * g_mixer.rolloff;
}

/// Compute the final volume for a group + per-sound volume.
fn audio_mixer_compute_volume(group: i64, sound_vol: f64) -> f64 {
    var group_vol = 1.0;
    if group >= 0 && group < g_mixer.group_volumes.len() {
        group_vol = g_mixer.group_volumes.get(group);
    }
    var vol = sound_vol * group_vol * g_mixer.master_volume;
    if vol < 0.0 { vol = 0.0; }
    if vol > 1.0 { vol = 1.0; }
    return vol;
}

/// Set the master volume (0..1).
pub fn audio_mixer_set_master_volume(vol: f64) -> void {
    if vol < 0.0 { vol = 0.0; }
    if vol > 1.0 { vol = 1.0; }
    g_mixer.master_volume = vol;
}

/// Set the volume for a specific group (0..1).
pub fn audio_mixer_set_group_volume(group: i64, vol: f64) -> void {
    if group < 0 || group >= g_mixer.group_volumes.len() { return; }
    if vol < 0.0 { vol = 0.0; }
    if vol > 1.0 { vol = 1.0; }
    g_mixer.group_volumes.set(group, vol);
}

/// Get the master volume.
pub fn audio_mixer_master_volume() -> f64 {
    return g_mixer.master_volume;
}

/// Get the volume for a specific group.
pub fn audio_mixer_group_volume(group: i64) -> f64 {
    if group < 0 || group >= g_mixer.group_volumes.len() { return 0.0; }
    return g_mixer.group_volumes.get(group);
}

/// Set the listener position for 3D audio.
pub fn audio_mixer_set_listener(x: f64, y: f64, z: f64) -> void {
    g_mixer.listener_x = x;
    g_mixer.listener_y = y;
    g_mixer.listener_z = z;
}

/// Set the 3D audio parameters.
pub fn audio_mixer_set_3d_params(ref_dist: f64, max_dist: f64, rolloff: f64) -> void {
    g_mixer.ref_distance = ref_dist;
    g_mixer.max_distance = max_dist;
    g_mixer.rolloff = rolloff;
}

/// Stop all sounds in a group.
pub fn audio_mixer_stop_group(group: i64) -> void {
    // SDL_mixer doesn't have per-channel group filtering
    // We stop all channels and let the caller manage it
    sdl_audio_stop(-1);
}

/// Stop all sounds.
pub fn audio_mixer_stop_all() -> void {
    sdl_audio_stop(-1);
}

/// Pause all sounds.
pub fn audio_mixer_pause_all() -> void {
    sdl_audio_pause(-1);
}

/// Resume all sounds.
pub fn audio_mixer_resume_all() -> void {
    sdl_audio_resume(-1);
}

/// Unload a sound from the cache.
pub fn audio_mixer_unload(sound_idx: i64) -> void {
    if sound_idx < 0 || sound_idx >= g_mixer.sounds.len() { return; }
    var entry = g_mixer.sounds.get(sound_idx);
    if entry.loaded {
        sdl_audio_free(entry.handle);
        entry.loaded = false;
        g_mixer.sounds.set(sound_idx, entry);
    }
}

/// Unload all sounds.
pub fn audio_mixer_unload_all() -> void {
    var i = 0;
    while i < g_mixer.sounds.len() {
        audio_mixer_unload(i);
        i = i + 1;
    }
    g_mixer.sounds.clear();
}

/// Get the number of loaded sounds.
pub fn audio_mixer_sound_count() -> i64 {
    return g_mixer.sounds.len();
}

/// Check if a sound is loaded.
pub fn audio_mixer_is_loaded(sound_idx: i64) -> bool {
    if sound_idx < 0 || sound_idx >= g_mixer.sounds.len() { return false; }
    return g_mixer.sounds.get(sound_idx).loaded;
}

/// Shutdown the audio mixer.
pub fn audio_mixer_shutdown() -> void {
    audio_mixer_unload_all();
    sdl_audio_shutdown();
    g_mixer.initialized = false;
}
