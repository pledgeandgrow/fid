// Fides Input standard library — Phase 8D (S8)
//
// Input handling for games: keyboard, mouse, and gamepad state tracking.
// Provides both polling (is key held?) and event-based (was key just pressed?)
// interfaces.
//
// In the interpreter, input functions are stubs (no actual input).
// In native builds, these would read from /dev/input, X11, Win32, etc.
//
// Usage:
//   use input;
//   input_init();
//   input_update();  // call once per frame
//   if input_key_pressed(KEY_SPACE) { jump(); }
//   if input_key_held(KEY_LEFT) { move_left(); }
//   value mx = input_mouse_x();
//   value my = input_mouse_y();
//   if input_mouse_pressed(MOUSE_LEFT) { shoot(); }

module input;

