// ─── Input State ──────────────────────────────────────────────────────────
//
// We track two frames of state to detect "just pressed" and "just released":
//   current[key] = key is held this frame
//   previous[key] = key was held last frame
//   pressed = current && !previous
//   released = !current && previous

pub struct InputState {
    pub key_current: Vec<i64>,    // 512 keys
    pub key_previous: Vec<i64>,
    pub mouse_x: i64,
    pub mouse_y: i64,
    pub mouse_delta_x: i64,
    pub mouse_delta_y: i64,
    pub mouse_current: Vec<i64>,  // 5 buttons
    pub mouse_previous: Vec<i64>,
    pub mouse_wheel: i64,          // scroll wheel delta
    pub gamepad_connected: bool,
    pub gamepad_current: Vec<i64>,  // 15 buttons
    pub gamepad_previous: Vec<i64>,
    pub gamepad_left_x: f64,       // -1.0 to 1.0
    pub gamepad_left_y: f64,
    pub gamepad_right_x: f64,
    pub gamepad_right_y: f64,
    pub gamepad_left_trigger: f64,  // 0.0 to 1.0
    pub gamepad_right_trigger: f64,
}

// ─── FFI (platform input) ─────────────────────────────────────────────────
//
// These are stubs — the actual implementations read from the platform.
// On Linux: /dev/input, X11, or evdev.
// On Windows: GetAsyncKeyState, RawInput, XInput.

extern "C" include "pledge_input.h" link "" {
    fn pledge_input_init() -> i64;
    fn pledge_input_poll(key_state: *u8, key_count: i64) -> void;
    fn pledge_input_mouse(x: *u8, y: *u8, buttons: *u8, wheel: *u8) -> void;
    fn pledge_input_gamepad(connected: *u8, buttons: *u8, left_x: *u8, left_y: *u8, right_x: *u8, right_y: *u8, lt: *u8, rt: *u8) -> void;
}

// ─── Initialization ───────────────────────────────────────────────────────

/// Initialize the input system.
pub fn input_init() -> void {
    pledge_input_init();
}

/// Create a new input state tracker.
pub fn input_create() -> InputState {
    val keys = Vec::new();
    val prev_keys = Vec::new();
    val i = 0;
    while i < 512 {
        keys.push(0);
        prev_keys.push(0);
        i = i + 1;
    }

    val mb = Vec::new();
    val prev_mb = Vec::new();
    val j = 0;
    while j < 5 {
        mb.push(0);
        prev_mb.push(0);
        j = j + 1;
    }

    val gb = Vec::new();
    val prev_gb = Vec::new();
    val k = 0;
    while k < 15 {
        gb.push(0);
        prev_gb.push(0);
        k = k + 1;
    }

    return InputState {
        key_current: keys,
        key_previous: prev_keys,
        mouse_x: 0,
        mouse_y: 0,
        mouse_delta_x: 0,
        mouse_delta_y: 0,
        mouse_current: mb,
        mouse_previous: prev_mb,
        mouse_wheel: 0,
        gamepad_connected: false,
        gamepad_current: gb,
        gamepad_previous: prev_gb,
        gamepad_left_x: 0.0,
        gamepad_left_y: 0.0,
        gamepad_right_x: 0.0,
        gamepad_right_y: 0.0,
        gamepad_left_trigger: 0.0,
        gamepad_right_trigger: 0.0,
    };
}

// ─── Update (call once per frame) ─────────────────────────────────────────

/// Update the input state. Call this once per frame before querying input.
/// Copies current state to previous, then polls the platform for new state.
pub fn input_update(state: &mut InputState) -> void {
    // Copy current to previous
    val i = 0;
    while i < state.key_current.len() {
        val v = state.key_current.get(i);
        state.key_previous.set(i, v);
        i = i + 1;
    }

    val j = 0;
    while j < state.mouse_current.len() {
        val v = state.mouse_current.get(j);
        state.mouse_previous.set(j, v);
        j = j + 1;
    }

    val k = 0;
    while k < state.gamepad_current.len() {
        val v = state.gamepad_current.get(k);
        state.gamepad_previous.set(k, v);
        k = k + 1;
    }

    // Reset mouse wheel and deltas
    state.mouse_wheel = 0;
    state.mouse_delta_x = 0;
    state.mouse_delta_y = 0;

    // Poll platform (stub — in native builds this reads real input)
    // pledge_input_poll(...) would fill key_current, mouse, gamepad
    // For now, the state stays as-is (no input in interpreter mode)
}

// ─── Keyboard ─────────────────────────────────────────────────────────────

/// Check if a key is currently held down.
pub fn input_key_held(state: InputState, key: i64) -> bool {
    if key < 0 || key >= state.key_current.len() {
        return false;
    }
    return state.key_current.get(key) != 0;
}

/// Check if a key was just pressed this frame (not held from previous frame).
pub fn input_key_pressed(state: InputState, key: i64) -> bool {
    if key < 0 || key >= state.key_current.len() {
        return false;
    }
    return state.key_current.get(key) != 0 && state.key_previous.get(key) == 0;
}

/// Check if a key was just released this frame.
pub fn input_key_released(state: InputState, key: i64) -> bool {
    if key < 0 || key >= state.key_current.len() {
        return false;
    }
    return state.key_current.get(key) == 0 && state.key_previous.get(key) != 0;
}

/// Set a key state (for testing or platform integration).
pub fn input_set_key(state: &mut InputState, key: i64, held: bool) -> void {
    if key < 0 || key >= state.key_current.len() {
        return;
    }
    val value = 0;
    if held { value = 1; }
    state.key_current.set(key, value);
}

// ─── Mouse ────────────────────────────────────────────────────────────────

/// Get mouse X position.
pub fn input_mouse_x(state: InputState) -> i64 {
    return state.mouse_x;
}

/// Get mouse Y position.
pub fn input_mouse_y(state: InputState) -> i64 {
    return state.mouse_y;
}

/// Get mouse movement delta (change since last frame).
pub fn input_mouse_delta(state: InputState) -> (i64, i64) {
    return (state.mouse_delta_x, state.mouse_delta_y);
}

/// Get mouse wheel scroll delta.
pub fn input_mouse_wheel(state: InputState) -> i64 {
    return state.mouse_wheel;
}

/// Check if a mouse button is held.
pub fn input_mouse_held(state: InputState, button: i64) -> bool {
    if button < 0 || button >= state.mouse_current.len() {
        return false;
    }
    return state.mouse_current.get(button) != 0;
}

/// Check if a mouse button was just pressed this frame.
pub fn input_mouse_pressed(state: InputState, button: i64) -> bool {
    if button < 0 || button >= state.mouse_current.len() {
        return false;
    }
    return state.mouse_current.get(button) != 0 && state.mouse_previous.get(button) == 0;
}

/// Check if a mouse button was just released this frame.
pub fn input_mouse_released(state: InputState, button: i64) -> bool {
    if button < 0 || button >= state.mouse_current.len() {
        return false;
    }
    return state.mouse_current.get(button) == 0 && state.mouse_previous.get(button) != 0;
}

/// Set mouse position (for platform integration).
pub fn input_set_mouse_pos(state: &mut InputState, x: i64, y: i64) -> void {
    state.mouse_delta_x = x - state.mouse_x;
    state.mouse_delta_y = y - state.mouse_y;
    state.mouse_x = x;
    state.mouse_y = y;
}

/// Set mouse button state (for platform integration).
pub fn input_set_mouse_button(state: &mut InputState, button: i64, held: bool) -> void {
    if button < 0 || button >= state.mouse_current.len() {
        return;
    }
    val value = 0;
    if held { value = 1; }
    state.mouse_current.set(button, value);
}

/// Set mouse wheel delta (for platform integration).
pub fn input_set_mouse_wheel(state: &mut InputState, delta: i64) -> void {
    state.mouse_wheel = delta;
}

// ─── Gamepad ──────────────────────────────────────────────────────────────

/// Check if a gamepad is connected.
pub fn input_gamepad_connected(state: InputState) -> bool {
    return state.gamepad_connected;
}

/// Check if a gamepad button is held.
pub fn input_gamepad_held(state: InputState, button: i64) -> bool {
    if button < 0 || button >= state.gamepad_current.len() {
        return false;
    }
    return state.gamepad_current.get(button) != 0;
}

/// Check if a gamepad button was just pressed.
pub fn input_gamepad_pressed(state: InputState, button: i64) -> bool {
    if button < 0 || button >= state.gamepad_current.len() {
        return false;
    }
    return state.gamepad_current.get(button) != 0 && state.gamepad_previous.get(button) == 0;
}

/// Get left stick X axis (-1.0 to 1.0).
pub fn input_gamepad_left_x(state: InputState) -> f64 {
    return state.gamepad_left_x;
}

/// Get left stick Y axis (-1.0 to 1.0).
pub fn input_gamepad_left_y(state: InputState) -> f64 {
    return state.gamepad_left_y;
}

/// Get right stick X axis (-1.0 to 1.0).
pub fn input_gamepad_right_x(state: InputState) -> f64 {
    return state.gamepad_right_x;
}

/// Get right stick Y axis (-1.0 to 1.0).
pub fn input_gamepad_right_y(state: InputState) -> f64 {
    return state.gamepad_right_y;
}

/// Get left trigger (0.0 to 1.0).
pub fn input_gamepad_left_trigger(state: InputState) -> f64 {
    return state.gamepad_left_trigger;
}

/// Get right trigger (0.0 to 1.0).
pub fn input_gamepad_right_trigger(state: InputState) -> f64 {
    return state.gamepad_right_trigger;
}

/// Set gamepad button state (for platform integration).
pub fn input_set_gamepad_button(state: &mut InputState, button: i64, held: bool) -> void {
    if button < 0 || button >= state.gamepad_current.len() {
        return;
    }
    val value = 0;
    if held { value = 1; }
    state.gamepad_current.set(button, value);
}

/// Set gamepad axis values (for platform integration).
pub fn input_set_gamepad_axes(state: &mut InputState, lx: f64, ly: f64, rx: f64, ry: f64, lt: f64, rt: f64) -> void {
    state.gamepad_left_x = lx;
    state.gamepad_left_y = ly;
    state.gamepad_right_x = rx;
    state.gamepad_right_y = ry;
    state.gamepad_left_trigger = lt;
    state.gamepad_right_trigger = rt;
}

/// Set gamepad connected status.
pub fn input_set_gamepad_connected(state: &mut InputState, connected: bool) -> void {
    state.gamepad_connected = connected;
}

// ─── Convenience: Modifier Keys ───────────────────────────────────────────

/// Check if either shift key is held.
pub fn input_shift_held(state: InputState) -> bool {
    return input_key_held(state, KEY_LEFT_SHIFT) || input_key_held(state, KEY_RIGHT_SHIFT);
}

/// Check if either control key is held.
pub fn input_ctrl_held(state: InputState) -> bool {
    return input_key_held(state, KEY_LEFT_CONTROL) || input_key_held(state, KEY_RIGHT_CONTROL);
}

/// Check if either alt key is held.
pub fn input_alt_held(state: InputState) -> bool {
    return input_key_held(state, KEY_LEFT_ALT) || input_key_held(state, KEY_RIGHT_ALT);
}

// ─── Convenience: Directional Input ───────────────────────────────────────

/// Get directional input as a normalized vector (dx, dy).
/// Combines keyboard arrows, WASD, and gamepad left stick.
pub fn input_direction(state: InputState) -> (f64, f64) {
    val dx = 0.0;
    val dy = 0.0;

    // Keyboard arrows
    if input_key_held(state, KEY_LEFT) { dx = dx - 1.0; }
    if input_key_held(state, KEY_RIGHT) { dx = dx + 1.0; }
    if input_key_held(state, KEY_UP) { dy = dy - 1.0; }
    if input_key_held(state, KEY_DOWN) { dy = dy + 1.0; }

    // WASD
    if input_key_held(state, KEY_A) { dx = dx - 1.0; }
    if input_key_held(state, KEY_D) { dx = dx + 1.0; }
    if input_key_held(state, KEY_W) { dy = dy - 1.0; }
    if input_key_held(state, KEY_S) { dy = dy + 1.0; }

    // Gamepad left stick (overrides keyboard if significant)
    val glx = state.gamepad_left_x;
    val gly = state.gamepad_left_y;
    if glx * glx + gly * gly > 0.25 {
        dx = glx;
        dy = gly;
    }

    // Normalize diagonal
    if dx != 0.0 && dy != 0.0 {
        val len2 = dx * dx + dy * dy;
        val len = len2;
        val i = 0;
        while i < 10 {
            len = (len + len2 / len) * 0.5;
            i = i + 1;
        }
        if len > 0.0 {
            dx = dx / len;
            dy = dy / len;
        }
    }

    return (dx, dy);
}
