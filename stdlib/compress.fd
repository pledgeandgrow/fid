// Fides Compression standard library
//
// Pure-Fides DEFLATE (RFC 1951), zlib (RFC 1950), and gzip (RFC 1952).
//
//   decompress: full inflate — stored blocks, fixed Huffman, and
//               dynamic Huffman (puff-style canonical decode)
//   compress:   valid DEFLATE using *stored* blocks only — output is
//               slightly larger than input but every inflater (zlib,
//               gzip, .zip) accepts it. A real Huffman compressor is a
//               future TODO.
//   checksums:  crc32, adler32
//
// Usage:
//   use compress;
//   val gz = gzip_compress("hello world");
//   println(gzip_decompress(gz));            // "hello world"
//   println(zlib_decompress(zlib_compress("abc")));

module compress;

use vec;
use string;

// ─── Checksums ──────────────────────────────────────────────────────────

fn z_crc_table() -> Vec {
    // CRC-32 (IEEE) table, generated once.
    var t: Vec = Vec::new();
    var n: i64 = 0;
    while n < 256 {
        var c: i64 = n;
        var k: i64 = 0;
        while k < 8 {
            if (c & 1) == 1 { c = (c >> 1) ^ 0xEDB88320; }
            else { c = c >> 1; }
            c = c & 0xFFFFFFFF;
            k = k + 1;
        }
        t.push(c);
        n = n + 1;
    }
    return t;
}

/// CRC-32 of a byte Vec.
pub fn crc32_bytes(bytes: Vec) -> i64 {
    var t: Vec = z_crc_table();
    var c: i64 = 0xFFFFFFFF;
    var i: i64 = 0;
    while i < bytes.len() {
        c = t.get((c ^ bytes.get(i)) & 255) ^ (c >> 8);
        i = i + 1;
    }
    return (c ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

/// CRC-32 of a string's bytes.
pub fn crc32(s: str) -> i64 {
    var b: Vec = Vec::new();
    var i: i64 = 0;
    while i < str_len(s) { b.push(str_byte_at(s, i)); i = i + 1; }
    return crc32_bytes(b);
}

/// Adler-32 of a byte Vec.
pub fn adler32_bytes(bytes: Vec) -> i64 {
    var a: i64 = 1;
    var b: i64 = 0;
    var i: i64 = 0;
    while i < bytes.len() {
        a = (a + bytes.get(i)) % 65521;
        b = (b + a) % 65521;
        i = i + 1;
    }
    return ((b << 16) | a) & 0xFFFFFFFF;
}

/// Adler-32 of a string's bytes.
pub fn adler32(s: str) -> i64 {
    var b: Vec = Vec::new();
    var i: i64 = 0;
    while i < str_len(s) { b.push(str_byte_at(s, i)); i = i + 1; }
    return adler32_bytes(b);
}

// ─── Stored-block DEFLATE writer ────────────────────────────────────────

fn st_push_u16(out: Vec, v: i64) -> void {
    out.push(v & 255);
    out.push((v >> 8) & 255);
}

fn st_push_u32(out: Vec, v: i64) -> void {
    out.push(v & 255);
    out.push((v >> 8) & 255);
    out.push((v >> 16) & 255);
    out.push((v >> 24) & 255);
}

/// DEFLATE bitstream (stored blocks only) for `bytes`.
/// Chunked into ≤65535-byte blocks; BTYPE=00.
pub fn deflate_stored(bytes: Vec) -> Vec {
    var out: Vec = Vec::new();
    var n: i64 = bytes.len();
    if n == 0 {
        // single final empty stored block
        out.push(1); out.push(0); out.push(0); out.push(255); out.push(255);
        return out;
    }
    var pos: i64 = 0;
    while pos < n {
        var chunk: i64 = n - pos;
        if chunk > 65535 { chunk = 65535; }
        var last: bool = (pos + chunk) >= n;
        out.push(last);
        st_push_u16(out, chunk);
        st_push_u16(out, 65535 - chunk);
        var i: i64 = 0;
        while i < chunk {
            out.push(bytes.get(pos + i) & 255);
            i = i + 1;
        }
        pos = pos + chunk;
    }
    return out;
}

// ─── zlib wrapper ───────────────────────────────────────────────────────

/// zlib-compress a byte Vec (deflate stored + zlib header + adler32).
pub fn zlib_compress_bytes(bytes: Vec) -> Vec {
    var out: Vec = Vec::new();
    out.push(0x78); out.push(0x01);              // CMF/FLG: 32K window, no dict, check
    var body: Vec = deflate_stored(bytes);
    var i: i64 = 0;
    while i < body.len() { out.push(body.get(i)); i = i + 1; }
    st_push_u32_msb(out, adler32_bytes(bytes));
    return out;
}

fn st_push_u32_msb(out: Vec, v: i64) -> void {
    out.push((v >> 24) & 255);
    out.push((v >> 16) & 255);
    out.push((v >> 8) & 255);
    out.push(v & 255);
}

/// zlib-compress a string's bytes.
pub fn zlib_compress(s: str) -> Vec {
    var b: Vec = Vec::new();
    var i: i64 = 0;
    while i < str_len(s) { b.push(str_byte_at(s, i)); i = i + 1; }
    return zlib_compress_bytes(b);
}

// ─── gzip wrapper ───────────────────────────────────────────────────────

/// gzip-compress a byte Vec (deflate stored + gzip header + crc32/isize).
pub fn gzip_compress_bytes(bytes: Vec) -> Vec {
    var out: Vec = Vec::new();
    // header: magic, CM=8(deflate), FLG=0, MTIME=0, XFL=0, OS=255
    out.push(0x1F); out.push(0x8B); out.push(8); out.push(0);
    st_push_u32(out, 0);
    out.push(0); out.push(255);
    var body: Vec = deflate_stored(bytes);
    var i: i64 = 0;
    while i < body.len() { out.push(body.get(i)); i = i + 1; }
    st_push_u32(out, crc32_bytes(bytes));
    st_push_u32(out, bytes.len() % 4294967296);
    return out;
}

/// gzip-compress a string's bytes.
pub fn gzip_compress(s: str) -> Vec {
    var b: Vec = Vec::new();
    var i: i64 = 0;
    while i < str_len(s) { b.push(str_byte_at(s, i)); i = i + 1; }
    return gzip_compress_bytes(b);
}

// ─── Bit reader ─────────────────────────────────────────────────────────

struct BitR {
    data: Vec,
    byte: i64,      // next byte index
    bit: i64,       // bit position within current byte (0-7)
}

fn br_new(data: Vec, start: i64) -> BitR {
    return BitR { data: data, byte: start, bit: 0 };
}

fn br_bit(r: &mut BitR) -> i64 {
    if r.byte >= r.data.len() { return 0; }
    var b: i64 = (r.data.get(r.byte) >> r.bit) & 1;
    r.bit = r.bit + 1;
    if r.bit == 8 { r.bit = 0; r.byte = r.byte + 1; }
    return b;
}

fn br_bits(r: &mut BitR, n: i64) -> i64 {
    var v: i64 = 0;
    var i: i64 = 0;
    while i < n {
        v = v | (br_bit(r) << i);
        i = i + 1;
    }
    return v;
}

fn br_align(r: &mut BitR) -> void {
    if r.bit != 0 { r.bit = 0; r.byte = r.byte + 1; }
}

fn br_eof(r: BitR) -> bool { return r.byte >= r.data.len(); }

// ─── Huffman (puff-style canonical decode) ──────────────────────────────

struct Huff {
    lens: Vec,       // counts per code length [1..15]
    offs: Vec,       // offsets into symbols for each length
    syms: Vec,       // symbols sorted by (length, symbol order)
}

// Literal + distance code-length vecs for one block.
struct TwoLens {
    lit: Vec,
    dist: Vec,
}

fn huff_build(lengths: Vec, n: i64) -> Huff {
    var lens: Vec = Vec::new();
    var i: i64 = 0;
    while i < 16 { lens.push(0); i = i + 1; }
    i = 0;
    while i < n {
        var l: i64 = lengths.get(i);
        if l > 0 && l < 16 { lens.set(l, lens.get(l) + 1); }
        i = i + 1;
    }
    var offs: Vec = Vec::new();
    offs.push(0); offs.push(0);
    i = 1;
    while i < 15 {
        offs.push(offs.get(i) + lens.get(i));
        i = i + 1;
    }
    var syms: Vec = Vec::new();
    i = 0;
    while i < n { syms.push(0); i = i + 1; }
    var cursor: Vec = Vec::new();
    i = 0;
    while i < offs.len() { cursor.push(offs.get(i)); i = i + 1; }
    var sym_i: i64 = 0;
    while sym_i < n {
        var l2: i64 = lengths.get(sym_i);
        if l2 > 0 && l2 < 16 {
            syms.set(cursor.get(l2), sym_i);
            cursor.set(l2, cursor.get(l2) + 1);
        }
        sym_i = sym_i + 1;
    }
    return Huff { lens: lens, offs: offs, syms: syms };
}

// Decode next symbol; -1 on error/end.
fn huff_decode(r: &mut BitR, h: Huff) -> i64 {
    var code: i64 = 0;
    var first: i64 = 0;
    var index: i64 = 0;
    var len: i64 = 1;
    while len <= 15 {
        code = code | br_bit(r);
        var count: i64 = h.lens.get(len);
        if code - first < count {
            return h.syms.get(index + code - first);
        }
        index = index + count;
        first = first + count;
        first = first << 1;
        code = code << 1;
        len = len + 1;
    }
    return -1;
}

// ─── inflate ────────────────────────────────────────────────────────────

fn z_len_base() -> Vec {
    var v: Vec = Vec::new();
    v.push(3); v.push(4); v.push(5); v.push(6); v.push(7); v.push(8); v.push(9);
    v.push(10); v.push(11); v.push(13); v.push(15); v.push(17); v.push(19);
    v.push(23); v.push(27); v.push(31); v.push(35); v.push(43); v.push(51);
    v.push(59); v.push(67); v.push(83); v.push(99); v.push(115); v.push(131);
    v.push(163); v.push(195); v.push(227); v.push(258);
    return v;
}

fn z_len_extra() -> Vec {
    var v: Vec = Vec::new();
    v.push(0); v.push(0); v.push(0); v.push(0); v.push(0); v.push(0); v.push(0);
    v.push(0); v.push(1); v.push(1); v.push(1); v.push(1); v.push(2); v.push(2);
    v.push(2); v.push(2); v.push(3); v.push(3); v.push(3); v.push(3); v.push(4);
    v.push(4); v.push(4); v.push(4); v.push(5); v.push(5); v.push(5); v.push(5);
    v.push(0);
    return v;
}

fn z_dist_base() -> Vec {
    var v: Vec = Vec::new();
    v.push(1); v.push(2); v.push(3); v.push(4); v.push(5); v.push(7); v.push(9);
    v.push(13); v.push(17); v.push(25); v.push(33); v.push(49); v.push(65);
    v.push(97); v.push(129); v.push(193); v.push(257); v.push(385); v.push(513);
    v.push(769); v.push(1025); v.push(1537); v.push(2049); v.push(3073);
    v.push(4097); v.push(6145); v.push(8193); v.push(12289); v.push(16385);
    v.push(24577);
    return v;
}

fn z_dist_extra() -> Vec {
    var v: Vec = Vec::new();
    v.push(0); v.push(0); v.push(0); v.push(0); v.push(1); v.push(1); v.push(2);
    v.push(2); v.push(3); v.push(3); v.push(4); v.push(4); v.push(5); v.push(5);
    v.push(6); v.push(6); v.push(7); v.push(7); v.push(8); v.push(8); v.push(9);
    v.push(9); v.push(10); v.push(10); v.push(11); v.push(11); v.push(12);
    v.push(12); v.push(13); v.push(13);
    return v;
}

fn z_cl_order() -> Vec {
    var v: Vec = Vec::new();
    v.push(16); v.push(17); v.push(18); v.push(0); v.push(8); v.push(7);
    v.push(9); v.push(6); v.push(10); v.push(5); v.push(11); v.push(4);
    v.push(12); v.push(3); v.push(13); v.push(2); v.push(14); v.push(1);
    v.push(15);
    return v;
}

// Copy match into out; returns false on invalid distance.
fn z_copy(out: &mut Vec, dist: i64, len: i64) -> bool {
    if dist > out.len() || dist < 1 { return false; }
    var i: i64 = 0;
    while i < len {
        var b: i64 = out.get(out.len() - dist);
        out.push(b);
        i = i + 1;
    }
    return true;
}

fn z_fixed() -> TwoLens {
    var lit: Vec = Vec::new();
    var i: i64 = 0;
    while i < 288 {
        if i < 144 { lit.push(8); }
        else if i < 256 { lit.push(9); }
        else if i < 280 { lit.push(7); }
        else { lit.push(8); }
        i = i + 1;
    }
    var dist: Vec = Vec::new();
    i = 0;
    while i < 32 { dist.push(5); i = i + 1; }
    return TwoLens { lit: lit, dist: dist };
}

// Decode a compressed block body given lit/dist huffman tables.
// Appends to out. Returns false on corruption.
fn z_block(r: &mut BitR, out: &mut Vec, lh: Huff, dh: Huff,
           lb: Vec, le: Vec, db: Vec, de: Vec, max_out: i64) -> bool {
    while true {
        var sym: i64 = huff_decode(r, lh);
        if sym < 0 { return false; }
        if sym < 256 {
            out.push(sym);
            if out.len() > max_out { return false; }
        } else if sym == 256 {
            return true;
        } else {
            var li: i64 = sym - 257;
            if li >= lb.len() { return false; }
            var len: i64 = lb.get(li) + br_bits(r, le.get(li));
            var dsym: i64 = huff_decode(r, dh);
            if dsym < 0 || dsym >= db.len() { return false; }
            var dist: i64 = db.get(dsym) + br_bits(r, de.get(dsym));
            if !z_copy(out, dist, len) { return false; }
            if out.len() > max_out { return false; }
        }
    }
    return true;
}

// Parse dynamic table block header. Returns lens in .lit/.dist;
// failure signaled by lit.len() == 0.
fn z_dynamic(r: &mut BitR) -> TwoLens {
    var res: TwoLens = TwoLens { lit: Vec::new(), dist: Vec::new() };
    var hlit: i64 = br_bits(r, 5) + 257;
    var hdist: i64 = br_bits(r, 5) + 1;
    var hclen: i64 = br_bits(r, 4) + 4;
    var order: Vec = z_cl_order();
    var cl_lens: Vec = Vec::new();
    var i: i64 = 0;
    while i < 19 { cl_lens.push(0); i = i + 1; }
    i = 0;
    while i < hclen && i < 19 {
        cl_lens.set(order.get(i), br_bits(r, 3));
        i = i + 1;
    }
    var clh: Huff = huff_build(cl_lens, 19);
    var total: i64 = hlit + hdist;
    var lens: Vec = Vec::new();
    while lens.len() < total {
        var sym: i64 = huff_decode(r, clh);
        if sym < 0 { return res; }
        if sym < 16 {
            lens.push(sym);
        } else if sym == 16 {
            if lens.len() == 0 { return res; }
            var prev: i64 = lens.get(lens.len() - 1);
            var rep: i64 = 3 + br_bits(r, 2);
            var k: i64 = 0;
            while k < rep && lens.len() < total { lens.push(prev); k = k + 1; }
        } else if sym == 17 {
            var rep2: i64 = 3 + br_bits(r, 3);
            var k2: i64 = 0;
            while k2 < rep2 && lens.len() < total { lens.push(0); k2 = k2 + 1; }
        } else if sym == 18 {
            var rep3: i64 = 11 + br_bits(r, 7);
            var k3: i64 = 0;
            while k3 < rep3 && lens.len() < total { lens.push(0); k3 = k3 + 1; }
        } else { return res; }
    }
    var j: i64 = 0;
    while j < hlit { res.lit.push(lens.get(j)); j = j + 1; }
    j = 0;
    while j < hdist {
        if hlit + j < lens.len() { res.dist.push(lens.get(hlit + j)); }
        else { res.dist.push(0); }
        j = j + 1;
    }
    return res;
}

/// Inflate a raw DEFLATE stream starting at byte `start` of `data`.
/// `max_out` caps the output size (decompression-bomb guard); pass a
/// generous limit like 268435456 (256MB). Returns Vec<i64> of bytes
/// (empty on error).
pub fn inflate_from(data: Vec, start: i64, max_out: i64) -> Vec {
    var out: Vec = Vec::new();
    var r: BitR = br_new(data, start);
    var lb: Vec = z_len_base();
    var le: Vec = z_len_extra();
    var db: Vec = z_dist_base();
    var de: Vec = z_dist_extra();
    var last: i64 = 0;
    while last == 0 {
        last = br_bit(&mut r);
        var btype: i64 = br_bits(&mut r, 2);
        if btype == 0 {
            br_align(&mut r);
            if r.byte + 4 > r.data.len() { break; }
            var len: i64 = r.data.get(r.byte) | (r.data.get(r.byte + 1) << 8);
            var nlen: i64 = r.data.get(r.byte + 2) | (r.data.get(r.byte + 3) << 8);
            r.byte = r.byte + 4;
            if ((len ^ 65535) & 65535) != nlen { break; }
            var i: i64 = 0;
            while i < len && r.byte < r.data.len() {
                out.push(r.data.get(r.byte));
                r.byte = r.byte + 1;
                i = i + 1;
            }
        } else if btype == 1 {
            var fx: TwoLens = z_fixed();
            var lh: Huff = huff_build(fx.lit, 288);
            var dh: Huff = huff_build(fx.dist, 32);
            if !z_block(&mut r, &mut out, lh, dh, lb, le, db, de, max_out) {
                break;
            }
        } else if btype == 2 {
            var dyn2: TwoLens = z_dynamic(&mut r);
            if dyn2.lit.len() == 0 { break; }
            var lh2: Huff = huff_build(dyn2.lit, dyn2.lit.len());
            var dh2: Huff = huff_build(dyn2.dist, dyn2.dist.len());
            if !z_block(&mut r, &mut out, lh2, dh2, lb, le, db, de, max_out) {
                break;
            }
        } else {
            break;
        }
        if br_eof(r) { break; }
    }
    return out;
}

/// Inflate a raw DEFLATE stream (whole Vec).
pub fn inflate(data: Vec) -> Vec {
    return inflate_from(data, 0, 268435456);
}

// ─── zlib / gzip decompressors ──────────────────────────────────────────

/// Decompress a zlib stream (validates header, skips optional dict id).
pub fn zlib_decompress(data: Vec) -> Vec {
    if data.len() < 6 { return Vec::new(); }
    var cmf: i64 = data.get(0);
    var flg: i64 = data.get(1);
    if (cmf & 15) != 8 { return Vec::new(); }
    if ((cmf << 8 | flg) % 31) != 0 { return Vec::new(); }
    var start: i64 = 2;
    if (flg & 32) != 0 { start = 6; }         // FDICT: skip 4-byte dict id
    var out: Vec = inflate_from(data, start, 268435456);
    // adler32 check is advisory — return data regardless
    return out;
}

/// Decompress a gzip member (parses header incl. FNAME/FCOMMENT/FEXTRA).
pub fn gzip_decompress(data: Vec) -> Vec {
    if data.len() < 18 { return Vec::new(); }
    if data.get(0) != 0x1F || data.get(1) != 0x8B { return Vec::new(); }
    var flg: i64 = data.get(3);
    var pos: i64 = 10;
    if (flg & 4) != 0 {                        // FEXTRA
        if pos + 2 > data.len() { return Vec::new(); }
        var xlen: i64 = data.get(pos) | (data.get(pos + 1) << 8);
        pos = pos + 2 + xlen;
    }
    if (flg & 8) != 0 {                        // FNAME: NUL-terminated
        while pos < data.len() && data.get(pos) != 0 { pos = pos + 1; }
        pos = pos + 1;
    }
    if (flg & 16) != 0 {                       // FCOMMENT
        while pos < data.len() && data.get(pos) != 0 { pos = pos + 1; }
        pos = pos + 1;
    }
    if (flg & 2) != 0 { pos = pos + 2; }       // FHCRC
    if pos >= data.len() { return Vec::new(); }
    return inflate_from(data, pos, 268435456);
}

// ─── String conveniences ────────────────────────────────────────────────

/// Decompress and interpret the result as a string.
pub fn zlib_decompress_str(data: Vec) -> str {
    return str_from_bytes(zlib_decompress(data));
}

pub fn gzip_decompress_str(data: Vec) -> str {
    return str_from_bytes(gzip_decompress(data));
}
