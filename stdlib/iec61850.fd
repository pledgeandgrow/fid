// Fides IEC 61850 standard library
//
// IEC 61850 is the substation-automation standard. This module covers the
// parts that are pure computation on bytes (Vec<i64>, bytes 0..255):
//
// Real (implemented and tested):
//   - The object-reference naming scheme: an IEC 61850 reference is
//     LD/LN.DO.DA with a functional constraint, e.g.
//     "RelayPIOC1/XCBR1.Pos.stVal" with FC "ST". Parse a reference into its
//     parts and build one back; validate a functional constraint string.
//   - ASN.1 BER helpers: tag-length-value encoding with definite short and
//     long form lengths, encoders for the primitive types GOOSE uses
//     (unsigned/signed integer, boolean, bit-string, floating point, octet
//     string, visible string, UTC time) and a TLV walker that decodes a
//     BER buffer into (tag, length, value-range) triples.
//   - GOOSE (IEC 61850-8-1): the Ethernet frame for GOOSE (type 0x88B8,
//     APPID, length, reserved) and the goosePdu — an APPLICATION 1 SEQUENCE
//     with gocbRef, timeAllowedtoLive, datSet, goID, t (UtcTime), stNum,
//     sqNum, test, confRev, ndsCom, numDatSetEntries and allData (the
//     sequence of data values). Encode a GOOSE PDU and decode it back.
//   - Sampled Values (IEC 61850-9-2 / 9-2LE): the savPdu with one ASDU
//     holding svID, smpCnt, confRev, smpSynch and the sequence of sample
//     data (seqData). Encode and decode an SV ASDU.
//
// Out of scope: MMS (ISO 9506) beyond the identifiers above — this module
// does not implement the MMS association or service layer; it says so here.
//
// The seam: no Ethernet NIC. A GOOSE/SV frame is bytes; put it on a raw
// layer-2 socket (destination 01-0C-CD-01-xx-xx for GOOSE) and feed received
// frames back through the decoders.

module iec61850;
use vec;
use string;

// ─── Functional constraints ──────────────────────────────────────────────
// ST status, MX measured, CO control, SP setpoint, CF configuration,
// DC description, SG setting group, etc.

pub fn iec61850_fc_valid(fc: str) -> bool {
    val known: Vec<str> = Vec::new();
    // compare against the common FCs
    if str_equal(fc, "ST") {
        return true;
    }
    if str_equal(fc, "MX") {
        return true;
    }
    if str_equal(fc, "CO") {
        return true;
    }
    if str_equal(fc, "SP") {
        return true;
    }
    if str_equal(fc, "SV") {
        return true;
    }
    if str_equal(fc, "CF") {
        return true;
    }
    if str_equal(fc, "DC") {
        return true;
    }
    if str_equal(fc, "SG") {
        return true;
    }
    if str_equal(fc, "SE") {
        return true;
    }
    if str_equal(fc, "EX") {
        return true;
    }
    if str_equal(fc, "BR") {
        return true;
    }
    if str_equal(fc, "RP") {
        return true;
    }
    return false;
}

/// A parsed object reference LD/LN.DO.DA.
pub struct Iec61850Ref {
    pub ok: bool,
    pub ld: str,  // logical device
    pub ln: str,  // logical node
    pub do_name: str,  // data object
    pub da: str,  // data attribute path (dot-joined, may be empty)
}

/// Parse "LD/LN.DO.DA.subDA..." into its parts. The LD is before the '/',
/// the LN is the first dotted token after it, the DO the second, the rest
/// the DA path.
pub fn iec61850_parse_ref(s: str) -> Iec61850Ref {
    val slash: i64 = str_find(s, "/");
    if slash < 0 {
        return Iec61850Ref {
            ok: false, ld: "", ln: "", do_name: "", da: ""
        };
    }
    val ld: str = str_slice(s, 0, slash);
    val rest: str = str_slice(s, slash + 1, str_len(s));
    val parts: Vec<str> = str_split(rest, ".");
    if parts.len() < 2 {
        return Iec61850Ref {
            ok: false, ld: ld, ln: "", do_name: "", da: ""
        };
    }
    val ln: str = parts.get(0);
    val do_name: str = parts.get(1);
    var da: str = "";
    var i: i64 = 2;
    while i < parts.len() {
        if i > 2 {
            da = da + ".";
        }
        da = da + parts.get(i);
        i = i + 1;
    }
    return Iec61850Ref {
        ok: true, ld: ld, ln: ln, do_name: do_name, da: da
    };
}

/// Build a reference string from its parts.
pub fn iec61850_build_ref(ld: str, ln: str, do_name: str, da: str) -> str {
    var s: str = ld + "/" + ln + "." + do_name;
    if str_len(da) > 0 {
        s = s + "." + da;
    }
    return s;
}

// ─── ASN.1 BER encoding ──────────────────────────────────────────────────

/// Push a definite BER length (short form < 128, else long form).
pub fn ber_put_len(out: &mut Vec<i64>, n: i64) {
    if n < 128 {
        out.push(n);
        return;
    }
    // long form: how many bytes to hold n
    var tmp: Vec<i64> = Vec::new();
    var v: i64 = n;
    while v > 0 {
        tmp.push(v & 255);
        v = v >> 8;
    }
    out.push(0x80 | tmp.len());
    var i: i64 = tmp.len() - 1;
    while i >= 0 {
        out.push(tmp.get(i));
        i = i - 1;
    }
}

/// A full TLV: tag, length, then the value bytes.
pub fn ber_tlv(tag: i64, value: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(tag & 255);
    ber_put_len(&mut out, value.len());
    var i: i64 = 0;
    while i < value.len() {
        out.push(value.get(i));
        i = i + 1;
    }
    return out;
}

/// Minimal big-endian bytes of an unsigned integer (at least one byte).
pub fn ber_uint_bytes(v: i64) -> Vec<i64> {
    var tmp: Vec<i64> = Vec::new();
    var x: i64 = v;
    if x == 0 {
        tmp.push(0);
        return tmp;
    }
    var stack: Vec<i64> = Vec::new();
    while x > 0 {
        stack.push(x & 255);
        x = x >> 8;
    }
    // If the top byte has bit7 set and this is meant unsigned, BER requires
    // a leading 0x00 so it is not read as negative. GOOSE integers are
    // context-tagged but we keep the convention for INTEGER tags.
    var i: i64 = stack.len() - 1;
    while i >= 0 {
        tmp.push(stack.get(i));
        i = i - 1;
    }
    return tmp;
}

/// Context-tagged unsigned integer TLV (tag already includes 0x80 context
/// class if desired).
pub fn ber_int(tag: i64, v: i64) -> Vec<i64> {
    val body: Vec<i64> = ber_uint_bytes(v);
    return ber_tlv(tag, &body);
}

/// Context-tagged boolean TLV (0xFF true, 0x00 false).
pub fn ber_bool(tag: i64, b: bool) -> Vec<i64> {
    var body: Vec<i64> = Vec::new();
    if b {
        body.push(0xFF);
    } else {
        body.push(0x00);
    }
    return ber_tlv(tag, &body);
}

/// Context-tagged visible string TLV.
pub fn ber_visible_string(tag: i64, s: str) -> Vec<i64> {
    var body: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < str_len(s) {
        body.push(str_byte_at(s, i));
        i = i + 1;
    }
    return ber_tlv(tag, &body);
}

/// IEC 61850 FloatingPoint data value: a 1-byte exponent-width prefix (8)
/// then 4 IEEE-754 binary32 big-endian bytes. Wrapped in the given tag.
pub fn ber_float32(tag: i64, x: f64) -> Vec<i64> {
    var body: Vec<i64> = Vec::new();
    body.push(8);  // number of exponent bits for single precision
    val bits: i64 = iec61850_f32_bits(x);
    body.push((bits >> 24) & 255);
    body.push((bits >> 16) & 255);
    body.push((bits >> 8) & 255);
    body.push(bits & 255);
    return ber_tlv(tag, &body);
}

/// A bit-string value: first byte is the count of unused bits in the last
/// octet, then the octets. For GOOSE quality (13 bits) use 3 unused bits in
/// a 2-octet body.
pub fn ber_bitstring(tag: i64, unused: i64, octets: &Vec<i64>) -> Vec<i64> {
    var body: Vec<i64> = Vec::new();
    body.push(unused & 255);
    var i: i64 = 0;
    while i < octets.len() {
        body.push(octets.get(i));
        i = i + 1;
    }
    return ber_tlv(tag, &body);
}

/// UtcTime (IEC 61850): 8 octets. Seconds since 1970 as a 32-bit big-endian
/// value, 24-bit fraction of a second, and a 1-byte TimeQuality.
pub fn ber_utctime(tag: i64, seconds: i64, fraction24: i64, quality: i64) -> Vec<i64> {
    var body: Vec<i64> = Vec::new();
    body.push((seconds >> 24) & 255);
    body.push((seconds >> 16) & 255);
    body.push((seconds >> 8) & 255);
    body.push(seconds & 255);
    body.push((fraction24 >> 16) & 255);
    body.push((fraction24 >> 8) & 255);
    body.push(fraction24 & 255);
    body.push(quality & 255);
    return ber_tlv(tag, &body);
}

// ─── BER decoding ────────────────────────────────────────────────────────

/// One decoded TLV: tag, content length, offset of the content, and the
/// position just past the whole TLV.
pub struct BerTlv {
    pub ok: bool,
    pub tag: i64,
    pub length: i64,
    pub content: i64,  // index of first content byte
    pub next: i64,  // index just past this TLV
}

/// Read the TLV at `pos`.
pub fn ber_read(b: &Vec<i64>, pos: i64) -> BerTlv {
    if pos + 2 > b.len() {
        return BerTlv {
            ok: false, tag: 0, length: 0, content: pos, next: pos
        };
    }
    val tag: i64 = b.get(pos);
    var p: i64 = pos + 1;
    val l0: i64 = b.get(p);
    p = p + 1;
    var length: i64 = 0;
    if l0 < 128 {
        length = l0;
    } else {
        val nbytes: i64 = l0 & 127;
        var i: i64 = 0;
        while i < nbytes {
            length = (length << 8) | b.get(p);
            p = p + 1;
            i = i + 1;
        }
    }
    return BerTlv {
        ok: true, tag: tag, length: length, content: p, next: p + length
    };
}

/// Decode a big-endian unsigned integer from `len` bytes at `pos`.
pub fn ber_get_uint(b: &Vec<i64>, pos: i64, len: i64) -> i64 {
    var v: i64 = 0;
    var i: i64 = 0;
    while i < len {
        v = (v << 8) | b.get(pos + i);
        i = i + 1;
    }
    return v;
}

// ─── IEEE 754 single precision ───────────────────────────────────────────

@wrapping
pub fn iec61850_f32_bits(x: f64) -> i64 {
    val bits: i64 = p_f64_to_bits(x);
    val sign: i64 = (((bits as u64) >> (63 as u64)) as i64) << 31;
    val e: i64 = (bits >> 52) & 2047;
    val m: i64 = bits & 4503599627370495;
    if e == 2047 {
        if m == 0 {
            return sign | 0x7f800000;
        }
        return sign | 0x7fc00000 | ((m >> 29) & 4194303);
    }
    if e == 0 {
        return sign;
    }
    val ex: i64 = e - 1023;
    var full: i64 = m | 4503599627370496;
    var shift: i64 = 29;
    var biased: i64 = ex + 127;
    if biased <= 0 {
        shift = 29 + 1 - biased;
        biased = 0;
        if shift > 54 {
            return sign;
        }
    }
    var mant: i64 = full >> shift;
    val rem: i64 = full & ((1 << shift) - 1);
    val half: i64 = 1 << (shift - 1);
    if rem > half || (rem == half && (mant & 1) == 1) {
        mant = mant + 1;
    }
    if biased == 0 {
        return sign | mant;
    }
    if mant >= 16777216 {
        mant = mant >> 1;
        biased = biased + 1;
    }
    if biased >= 255 {
        return sign | 0x7f800000;
    }
    return sign | (biased << 23) | (mant & 8388607);
}

pub fn iec61850_f32_to_f64(s: i64) -> f64 {
    val e: i64 = (s >> 23) & 255;
    val m: i64 = s & 8388607;
    var v: f64 = 0.0;
    if e == 0 {
        v = (m as f64) * iec61850_pow2(-149);
    } else if e == 255 {
        if m == 0 {
            v = 1.0 / 0.0;
        } else {
            v = 0.0 / 0.0;
        }
    } else {
        v = ((m + 8388608) as f64) * iec61850_pow2(e - 150);
    }
    if ((s >> 31) & 1) == 1 {
        return p_f64_from_bits(p_f64_to_bits(v) ^ (0 - 9223372036854775807 - 1));
    }
    return v;
}

fn iec61850_pow2(e: i64) -> f64 {
    var r: f64 = 1.0;
    var i: i64 = 0;
    if e >= 0 {
        while i < e {
            r = r * 2.0;
            i = i + 1;
        }
    } else {
        var n: i64 = -e;
        while i < n {
            r = r / 2.0;
            i = i + 1;
        }
    }
    return r;
}

// ─── GOOSE ───────────────────────────────────────────────────────────────

/// The fields of a GOOSE PDU.
pub struct GoosePdu {
    pub gocb_ref: str,
    pub time_allowed_to_live: i64,
    pub dat_set: str,
    pub go_id: str,
    pub t_seconds: i64,
    pub t_fraction: i64,
    pub t_quality: i64,
    pub st_num: i64,
    pub sq_num: i64,
    pub test: bool,
    pub conf_rev: i64,
    pub nds_com: bool,
    pub num_dataset_entries: i64,
    pub all_data: Vec<i64>,  // the already-BER-encoded allData member TLVs
}

/// Encode a GOOSE PDU as an APPLICATION 1 constructed SEQUENCE (tag 0x61),
/// with the context-tagged members [0]..[12]. `all_data` is the
/// concatenation of the BER-encoded data values (each with its own tag).
pub fn goose_encode_pdu(p: &GoosePdu) -> Vec<i64> {
    var body: Vec<i64> = Vec::new();
    ber_append(&mut body, &ber_visible_string(0x80, p.gocb_ref));  // [0] gocbRef
    ber_append(&mut body, &ber_int(0x81, p.time_allowed_to_live));  // [1] timeAllowedtoLive
    ber_append(&mut body, &ber_visible_string(0x82, p.dat_set));  // [2] datSet
    ber_append(&mut body, &ber_visible_string(0x83, p.go_id));  // [3] goID
    ber_append(&mut body, &ber_utctime(0x84, p.t_seconds, p.t_fraction, p.t_quality));  // [4] t
    ber_append(&mut body, &ber_int(0x85, p.st_num));  // [5] stNum
    ber_append(&mut body, &ber_int(0x86, p.sq_num));  // [6] sqNum
    ber_append(&mut body, &ber_bool(0x87, p.test));  // [7] test
    ber_append(&mut body, &ber_int(0x88, p.conf_rev));  // [8] confRev
    ber_append(&mut body, &ber_bool(0x89, p.nds_com));  // [9] ndsCom
    ber_append(&mut body, &ber_int(0x8A, p.num_dataset_entries));  // [10] numDatSetEntries
    // [11] allData is a constructed context tag 0xAB holding the data values
    ber_append(&mut body, &ber_tlv(0xAB, &p.all_data));
    return ber_tlv(0x61, &body);
}

fn ber_append(out: &mut Vec<i64>, src: &Vec<i64>) {
    var i: i64 = 0;
    while i < src.len() {
        out.push(src.get(i));
        i = i + 1;
    }
}

fn ber_str(b: &Vec<i64>, pos: i64, len: i64) -> str {
    var s: str = "";
    var i: i64 = 0;
    while i < len {
        s = s + char_to_str(b.get(pos + i));
        i = i + 1;
    }
    return s;
}

/// Decode a GOOSE PDU from an APPLICATION 1 SEQUENCE buffer.
pub fn goose_decode_pdu(b: &Vec<i64>) -> GoosePdu {
    var p: GoosePdu = GoosePdu {
        gocb_ref: "", time_allowed_to_live: 0, dat_set: "", go_id: "", t_seconds: 0, t_fraction: 0, t_quality: 0, st_num: 0, sq_num: 0, test: false, conf_rev: 0, nds_com: false, num_dataset_entries: 0, all_data: Vec::new(),
    };
    val outer: BerTlv = ber_read(b, 0);
    var pos: i64 = outer.content;
    val endp: i64 = outer.next;
    while pos < endp {
        val t: BerTlv = ber_read(b, pos);
        if !t.ok {
            break;
        }
        val tag: i64 = t.tag;
        if tag == 0x80 {
            p.gocb_ref = ber_str(b, t.content, t.length);
        } else if tag == 0x81 {
            p.time_allowed_to_live = ber_get_uint(b, t.content, t.length);
        } else if tag == 0x82 {
            p.dat_set = ber_str(b, t.content, t.length);
        } else if tag == 0x83 {
            p.go_id = ber_str(b, t.content, t.length);
        } else if tag == 0x84 {
            p.t_seconds = ber_get_uint(b, t.content, 4);
            p.t_fraction = ber_get_uint(b, t.content + 4, 3);
            p.t_quality = b.get(t.content + 7);
        } else if tag == 0x85 {
            p.st_num = ber_get_uint(b, t.content, t.length);
        } else if tag == 0x86 {
            p.sq_num = ber_get_uint(b, t.content, t.length);
        } else if tag == 0x87 {
            p.test = b.get(t.content) != 0;
        } else if tag == 0x88 {
            p.conf_rev = ber_get_uint(b, t.content, t.length);
        } else if tag == 0x89 {
            p.nds_com = b.get(t.content) != 0;
        } else if tag == 0x8A {
            p.num_dataset_entries = ber_get_uint(b, t.content, t.length);
        } else if tag == 0xAB {
            var j: i64 = t.content;
            while j < t.next {
                p.all_data.push(b.get(j));
                j = j + 1;
            }
        }
        pos = t.next;
    }
    return p;
}

/// The Ethernet GOOSE frame: 6-byte dest MAC, 6-byte src MAC, optional
/// 802.1Q tag, EtherType 0x88B8, then APPID, Length, Reserved1, Reserved2,
/// and the goosePdu. This builds the payload from the EtherType onward (the
/// MAC/VLAN header is the caller's to prepend for a raw socket).
pub fn goose_frame_payload(appid: i64, pdu: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    out.push(0x88);
    out.push(0xB8);
    out.push((appid >> 8) & 255);
    out.push(appid & 255);
    // Length = APPID(2)+Length(2)+Reserved1(2)+Reserved2(2)+pdu
    val length: i64 = 8 + pdu.len();
    out.push((length >> 8) & 255);
    out.push(length & 255);
    out.push(0);
    out.push(0);  // Reserved1
    out.push(0);
    out.push(0);  // Reserved2
    var i: i64 = 0;
    while i < pdu.len() {
        out.push(pdu.get(i));
        i = i + 1;
    }
    return out;
}

/// A decoded GOOSE Ethernet payload header.
pub struct GooseFrame {
    pub ok: bool,
    pub appid: i64,
    pub length: i64,
    pub pdu_start: i64,
}

pub fn goose_frame_parse(b: &Vec<i64>) -> GooseFrame {
    if b.len() < 10 || b.get(0) != 0x88 || b.get(1) != 0xB8 {
        return GooseFrame {
            ok: false, appid: 0, length: 0, pdu_start: 0
        };
    }
    return GooseFrame {
        ok: true, appid: (b.get(2) << 8) | b.get(3), length: (b.get(4) << 8) | b.get(5), pdu_start: 10,
    };
}

// ─── Sampled Values (9-2LE) ──────────────────────────────────────────────

/// One SV ASDU's fields. `seq_data` is the BER-encoded sample block.
pub struct SvAsdu {
    pub sv_id: str,
    pub smp_cnt: i64,
    pub conf_rev: i64,
    pub smp_synch: i64,
    pub seq_data: Vec<i64>,
}

/// Encode a savPdu (APPLICATION 2, tag 0x62) carrying noASDU=1 and one ASDU.
/// The ASDU is a context-constructed SEQUENCE (tag 0xA2 -> 0x30 per entry);
/// 9-2LE uses svID[0], smpCnt[2], confRev[3], smpSynch[5], seqData[7].
pub fn sv_encode(a: &SvAsdu) -> Vec<i64> {
    // Build the single ASDU body
    var asdu: Vec<i64> = Vec::new();
    ber_append(&mut asdu, &ber_visible_string(0x80, a.sv_id));  // svID [0]
    ber_append(&mut asdu, &ber_int(0x82, a.smp_cnt));  // smpCnt [2]
    ber_append(&mut asdu, &ber_int(0x83, a.conf_rev));  // confRev [3]
    ber_append(&mut asdu, &ber_int(0x85, a.smp_synch));  // smpSynch [5]
    ber_append(&mut asdu, &ber_tlv(0x87, &a.seq_data));  // seqData [7]
    // Sequence of ASDU: a SEQUENCE (0x30) wrapping the ASDU
    val asdu_seq_entry: Vec<i64> = ber_tlv(0x30, &asdu);
    val seq_of_asdu: Vec<i64> = ber_tlv(0xA2, &asdu_seq_entry);  // [2] sequence of ASDU
    // savPdu body: noASDU [0] = 1, then the sequence of ASDU
    var body: Vec<i64> = Vec::new();
    ber_append(&mut body, &ber_int(0x80, 1));  // noASDU [0]
    ber_append(&mut body, &seq_of_asdu);
    return ber_tlv(0x62, &body);
}

/// Decode the first ASDU from a savPdu.
pub fn sv_decode(b: &Vec<i64>) -> SvAsdu {
    var out: SvAsdu = SvAsdu {
        sv_id: "", smp_cnt: 0, conf_rev: 0, smp_synch: 0, seq_data: Vec::new()
    };
    val outer: BerTlv = ber_read(b, 0);  // savPdu (0x62)
    var pos: i64 = outer.content;
    while pos < outer.next {
        val t: BerTlv = ber_read(b, pos);
        if !t.ok {
            break;
        }
        if t.tag == 0xA2 {
            // sequence of ASDU -> first SEQUENCE entry
            val entry: BerTlv = ber_read(b, t.content);  // 0x30
            var ep: i64 = entry.content;
            while ep < entry.next {
                val f: BerTlv = ber_read(b, ep);
                if !f.ok {
                    break;
                }
                if f.tag == 0x80 {
                    out.sv_id = ber_str(b, f.content, f.length);
                } else if f.tag == 0x82 {
                    out.smp_cnt = ber_get_uint(b, f.content, f.length);
                } else if f.tag == 0x83 {
                    out.conf_rev = ber_get_uint(b, f.content, f.length);
                } else if f.tag == 0x85 {
                    out.smp_synch = ber_get_uint(b, f.content, f.length);
                } else if f.tag == 0x87 {
                    var j: i64 = f.content;
                    while j < f.next {
                        out.seq_data.push(b.get(j));
                        j = j + 1;
                    }
                }
                ep = f.next;
            }
        }
        pos = t.next;
    }
    return out;
}
