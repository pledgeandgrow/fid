// Fides Encoding standard library
//
// Byte-to-text encodings and text transforms used by web, file, and
// crypto code:
//   - base64 encode/decode (RFC 4648, with '=' padding)
//   - hex encode/decode (lowercase and uppercase)
//   - URL percent-encoding (RFC 3986 unreserved set) and form encoding
//   - UTF-8 validation and codepoint decode/encode
//
// All functions are pure string/byte transforms — no IO, deterministic.
//
// Usage:
//   use encoding;
//   value b = b64_encode("hello");          // "aGVsbG8="
//   value s = b64_decode("aGVsbG8=");       // "hello"
//   value h = hex_encode("AB");             // "4142"
//   value u = url_encode("a b&c");          // "a%20b%26c"
//   if utf8_valid(text) { ... }

module encoding;

use vec;
use string;

// ─── Byte-exact strings ────────────────────────────────────────────────
//
// `str_from_bytes` and `char_to_str` convert each element as a *codepoint*
// (Latin-1-ish): 226 becomes "â" (bytes C3 A2), not byte 0xE2. To return a
// string whose bytes are exactly the ones decoded, we write them into a
// malloc'd NUL-terminated buffer — a raw byte string that every backend
// treats as a `str`.

/// Bytes -> a `str` holding exactly those bytes (NUL-terminated heap
/// buffer). This is the right way to turn decoded bytes into a string;
/// `str_from_bytes` re-encodes each element as a codepoint instead.
pub fn enc_bytes_to_str(bytes: Vec) -> str {
    var n = bytes.len();
    var buf = p_malloc(n + 1);
    var i = 0;
    while i < n {
        var p: *mut u8 = buf + i;
        unsafe { *p = bytes.get(i) % 256; }
        i = i + 1;
    }
    var pend: *mut u8 = buf + n;
    unsafe { *pend = 0; }
    return buf;
}

/// A `str` -> its raw bytes (same as str_bytes, kept for API symmetry).
pub fn enc_str_to_bytes(s: str) -> Vec {
    return str_bytes(s);
}

// ─── Base64 ─────────────────────────────────────────────────────────────

fn b64_alphabet() -> str {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
}

/// Encode a byte Vec to base64 text (RFC 4648 with '=' padding).
pub fn b64_encode_bytes(bytes: Vec) -> str {
    var alpha = b64_alphabet();
    var out = "";
    var i = 0;
    var n = bytes.len();
    while i + 3 <= n {
        var b0 = bytes.get(i);
        var b1 = bytes.get(i + 1);
        var b2 = bytes.get(i + 2);
        var v = b0 * 65536 + b1 * 256 + b2;
        out = out + char_to_str(str_byte_at(alpha, (v / 262144) % 64));
        out = out + char_to_str(str_byte_at(alpha, (v / 4096) % 64));
        out = out + char_to_str(str_byte_at(alpha, (v / 64) % 64));
        out = out + char_to_str(str_byte_at(alpha, v % 64));
        i = i + 3;
    }
    if n - i == 1 {
        var v = bytes.get(i) * 65536;
        out = out + char_to_str(str_byte_at(alpha, (v / 262144) % 64));
        out = out + char_to_str(str_byte_at(alpha, (v / 4096) % 64));
        out = out + "==";
    } else if n - i == 2 {
        var v = bytes.get(i) * 65536 + bytes.get(i + 1) * 256;
        out = out + char_to_str(str_byte_at(alpha, (v / 262144) % 64));
        out = out + char_to_str(str_byte_at(alpha, (v / 4096) % 64));
        out = out + char_to_str(str_byte_at(alpha, (v / 64) % 64));
        out = out + "=";
    }
    return out;
}

/// Encode a string's UTF-8 bytes to base64 text.
pub fn b64_encode(s: str) -> str {
    return b64_encode_bytes(str_bytes(s));
}

/// Decode a base64 character to its 6-bit value, or -1 if invalid.
fn b64_value_of(c: i64) -> i64 {
    if c >= 65 && c <= 90 { return c - 65; }        // A-Z
    if c >= 97 && c <= 122 { return c - 71; }       // a-z
    if c >= 48 && c <= 57 { return c + 4; }         // 0-9
    if c == 43 { return 62; }                        // +
    if c == 47 { return 63; }                        // /
    return -1;
}

fn b64_is_space(c: i64) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

/// Decode base64 text to a byte Vec.
/// Whitespace is skipped; '=' ends the stream. Invalid characters make the
/// decode stop at the first bad group (lenient, like most libraries).
pub fn b64_decode_bytes(s: str) -> Vec {
    var out = Vec::new();
    var n = str_len(s);
    // Collect the 6-bit values of the meaningful characters.
    var vals = Vec::new();
    var i = 0;
    var done = false;
    while i < n && !done {
        var c = str_byte_at(s, i);
        if c == 61 {
            done = true;                             // '=' padding ends input
        } else if b64_is_space(c) {
            // skip
        } else {
            var v = b64_value_of(c);
            if v < 0 {
                done = true;                         // stop at first bad char
            } else {
                vals.push(v);
            }
        }
        i = i + 1;
    }
    // Fold groups of 4 sextets into 3 bytes; a tail of 2 or 3 sextets
    // yields 1 or 2 bytes.
    var k = 0;
    var m = vals.len();
    while k + 4 <= m {
        var v = vals.get(k) * 262144 + vals.get(k + 1) * 4096
              + vals.get(k + 2) * 64 + vals.get(k + 3);
        out.push((v / 65536) % 256);
        out.push((v / 256) % 256);
        out.push(v % 256);
        k = k + 4;
    }
    if m - k == 2 {
        var v = vals.get(k) * 262144 + vals.get(k + 1) * 4096;
        out.push((v / 65536) % 256);
    } else if m - k == 3 {
        var v = vals.get(k) * 262144 + vals.get(k + 1) * 4096
              + vals.get(k + 2) * 64;
        out.push((v / 65536) % 256);
        out.push((v / 256) % 256);
    }
    return out;
}

/// Decode base64 text to a string. Returns "" when the decoded bytes are
/// empty or not valid UTF-8 output is not required — bytes are returned
/// verbatim.
pub fn b64_decode(s: str) -> str {
    return enc_bytes_to_str(b64_decode_bytes(s));
}

/// Check that a string is well-formed base64 (optional whitespace and
/// '=' padding allowed).
pub fn b64_valid(s: str) -> bool {
    var n = str_len(s);
    var i = 0;
    var seen_pad = false;
    var data_chars = 0;
    while i < n {
        var c = str_byte_at(s, i);
        if c == 61 {
            seen_pad = true;
        } else if b64_is_space(c) {
            // ok anywhere
        } else if seen_pad {
            return false;                            // data after '='
        } else if b64_value_of(c) < 0 {
            return false;
        } else {
            data_chars = data_chars + 1;
        }
        i = i + 1;
    }
    return data_chars % 4 != 1;                      // len 1 mod 4 is impossible
}

// ─── Hex ────────────────────────────────────────────────────────────────

fn hex_digit_lower(v: i64) -> str {
    return char_to_str(str_byte_at("0123456789abcdef", v % 16));
}

fn hex_digit_upper(v: i64) -> str {
    return char_to_str(str_byte_at("0123456789ABCDEF", v % 16));
}

/// Encode a byte Vec to lowercase hex text ("0a3f...").
pub fn hex_encode_bytes(bytes: Vec) -> str {
    var out = "";
    var i = 0;
    while i < bytes.len() {
        var b = bytes.get(i) % 256;
        if b < 0 { b = b + 256; }
        out = out + hex_digit_lower(b / 16);
        out = out + hex_digit_lower(b % 16);
        i = i + 1;
    }
    return out;
}

/// Encode a byte Vec to uppercase hex text ("0A3F...").
pub fn hex_encode_bytes_upper(bytes: Vec) -> str {
    var out = "";
    var i = 0;
    while i < bytes.len() {
        var b = bytes.get(i) % 256;
        if b < 0 { b = b + 256; }
        out = out + hex_digit_upper(b / 16);
        out = out + hex_digit_upper(b % 16);
        i = i + 1;
    }
    return out;
}

/// Encode a string's bytes to lowercase hex text.
pub fn hex_encode(s: str) -> str {
    return hex_encode_bytes(str_bytes(s));
}

/// Encode a string's bytes to uppercase hex text.
pub fn hex_encode_upper(s: str) -> str {
    return hex_encode_bytes_upper(str_bytes(s));
}

/// Decode one hex digit to its value, or -1 if not a hex digit.
fn hex_value_of(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48; }         // 0-9
    if c >= 97 && c <= 102 { return c - 87; }        // a-f
    if c >= 65 && c <= 70 { return c - 55; }         // A-F
    return -1;
}

/// Decode hex text to a byte Vec. Whitespace is skipped. Stops at the
/// first invalid character (or an odd trailing half-byte).
pub fn hex_decode_bytes(s: str) -> Vec {
    var out = Vec::new();
    var half = -1;
    var i = 0;
    var n = str_len(s);
    while i < n {
        var c = str_byte_at(s, i);
        if b64_is_space(c) {
            i = i + 1;
        } else {
            var v = hex_value_of(c);
            if v < 0 { return out; }
            if half < 0 {
                half = v;
            } else {
                out.push(half * 16 + v);
                half = -1;
            }
            i = i + 1;
        }
    }
    return out;
}

/// Decode hex text to a string.
pub fn hex_decode(s: str) -> str {
    return enc_bytes_to_str(hex_decode_bytes(s));
}

/// Check that a string is well-formed hex (even number of digits,
/// whitespace ignored).
pub fn hex_valid(s: str) -> bool {
    var digits = 0;
    var i = 0;
    var n = str_len(s);
    while i < n {
        var c = str_byte_at(s, i);
        if b64_is_space(c) {
            i = i + 1;
        } else if hex_value_of(c) < 0 {
            return false;
        } else {
            digits = digits + 1;
            i = i + 1;
        }
    }
    return digits % 2 == 0;
}

// ─── URL percent-encoding ───────────────────────────────────────────────

/// RFC 3986 unreserved characters never need escaping:
/// A-Z a-z 0-9 and - _ . ~
fn url_is_unreserved(c: i64) -> bool {
    if c >= 65 && c <= 90 { return true; }           // A-Z
    if c >= 97 && c <= 122 { return true; }          // a-z
    if c >= 48 && c <= 57 { return true; }           // 0-9
    return c == 45 || c == 95 || c == 46 || c == 126; // - _ . ~
}

/// Percent-encode a byte Vec: unreserved bytes pass through, everything
/// else becomes %XX (uppercase hex).
pub fn url_encode_bytes(bytes: Vec) -> str {
    var out = "";
    var i = 0;
    while i < bytes.len() {
        var b = bytes.get(i) % 256;
        if b < 0 { b = b + 256; }
        if url_is_unreserved(b) {
            out = out + char_to_str(b);
        } else {
            out = out + "%";
            out = out + hex_digit_upper(b / 16);
            out = out + hex_digit_upper(b % 16);
        }
        i = i + 1;
    }
    return out;
}

/// Percent-encode a string for use in a URL component
/// (space becomes %20).
pub fn url_encode(s: str) -> str {
    return url_encode_bytes(str_bytes(s));
}

/// Percent-encode a string for use in a URL component (alias).
pub fn url_encode_component(s: str) -> str {
    return url_encode(s);
}

/// Percent-encode with HTML-form rules: like url_encode but a space
/// becomes '+'.
pub fn url_encode_form(s: str) -> str {
    var out = "";
    var bytes = str_bytes(s);
    var i = 0;
    while i < bytes.len() {
        var b = bytes.get(i) % 256;
        if b < 0 { b = b + 256; }
        if b == 32 {
            out = out + "+";
        } else if url_is_unreserved(b) {
            out = out + char_to_str(b);
        } else {
            out = out + "%";
            out = out + hex_digit_upper(b / 16);
            out = out + hex_digit_upper(b % 16);
        }
        i = i + 1;
    }
    return out;
}

/// Decode percent-encoded text to a byte Vec.
/// "%XX" -> byte XX, "+" stays "+", a malformed '%' is passed through.
pub fn url_decode_bytes(s: str) -> Vec {
    var out = Vec::new();
    var i = 0;
    var n = str_len(s);
    while i < n {
        var c = str_byte_at(s, i);
        if c == 37 {                                 // '%'
            if i + 2 < n {
                var hi = hex_value_of(str_byte_at(s, i + 1));
                var lo = hex_value_of(str_byte_at(s, i + 2));
                if hi >= 0 && lo >= 0 {
                    out.push(hi * 16 + lo);
                    i = i + 3;
                } else {
                    out.push(c);
                    i = i + 1;
                }
            } else {
                out.push(c);
                i = i + 1;
            }
        } else {
            out.push(c);
            i = i + 1;
        }
    }
    return out;
}

/// Decode percent-encoded text to a string. '+' is NOT translated
/// (use url_decode_form for query strings).
pub fn url_decode(s: str) -> str {
    return enc_bytes_to_str(url_decode_bytes(s));
}

/// Decode a form/query-encoded string: "%XX" -> byte, '+' -> space.
pub fn url_decode_form(s: str) -> str {
    var raw = str_replace(s, "+", " ");
    return url_decode(raw);
}

// ─── UTF-8 ──────────────────────────────────────────────────────────────

/// Number of bytes in the UTF-8 sequence starting with lead byte `b`,
/// or 0 if `b` is not a valid lead byte.
fn utf8_seq_len(b: i64) -> i64 {
    if b < 128 { return 1; }
    if b >= 194 && b <= 223 { return 2; }            // C0/C1 are overlong
    if b >= 224 && b <= 239 { return 3; }
    if b >= 240 && b <= 244 { return 4; }
    return 0;
}

fn utf8_is_cont(b: i64) -> bool {
    return b >= 128 && b <= 191;
}

/// Check that a byte Vec is valid UTF-8 (no overlongs, no surrogates,
/// no out-of-range codepoints, truncated sequences rejected).
pub fn utf8_valid_bytes(bytes: Vec) -> bool {
    var i = 0;
    var n = bytes.len();
    while i < n {
        var b0 = bytes.get(i) % 256;
        if b0 < 0 { b0 = b0 + 256; }
        var len = utf8_seq_len(b0);
        if len == 0 || i + len > n { return false; }
        if len == 1 {
            i = i + 1;
        } else {
            var j = 1;
            var ok = true;
            while j < len {
                var bj = bytes.get(i + j) % 256;
                if bj < 0 { bj = bj + 256; }
                if !utf8_is_cont(bj) { ok = false; }
                j = j + 1;
            }
            if !ok { return false; }
            // Range checks on the first continuation byte catch overlongs
            // and out-of-range leads without decoding the full codepoint.
            var b1 = bytes.get(i + 1) % 256;
            if b1 < 0 { b1 = b1 + 256; }
            if b0 == 224 && (b1 < 160 || b1 > 191) { return false; } // overlong
            if b0 == 237 && b1 > 159 { return false; }               // surrogate
            if b0 == 240 && (b1 < 144 || b1 > 191) { return false; } // overlong
            if b0 == 244 && b1 > 143 { return false; }               // > U+10FFFF
            i = i + len;
        }
    }
    return true;
}

/// Check that a string's bytes are valid UTF-8.
pub fn utf8_valid(s: str) -> bool {
    return utf8_valid_bytes(str_bytes(s));
}

/// Decode a string to a Vec of Unicode codepoints (i64).
/// Invalid sequences decode as U+FFFD (65533) and consume one byte.
pub fn utf8_decode(s: str) -> Vec {
    var bytes = str_bytes(s);
    var out = Vec::new();
    var i = 0;
    var n = bytes.len();
    while i < n {
        var b0 = bytes.get(i) % 256;
        if b0 < 0 { b0 = b0 + 256; }
        var len = utf8_seq_len(b0);
        if len == 0 || i + len > n {
            out.push(65533);
            i = i + 1;
        } else if len == 1 {
            out.push(b0);
            i = i + 1;
        } else {
            var ok = true;
            var j = 1;
            while j < len {
                var bj = bytes.get(i + j) % 256;
                if bj < 0 { bj = bj + 256; }
                if !utf8_is_cont(bj) { ok = false; }
                j = j + 1;
            }
            if !ok {
                out.push(65533);
                i = i + 1;
            } else {
                var cp = 0;
                if len == 2 {
                    cp = (b0 - 192) * 64 + (bytes.get(i + 1) % 256 - 128);
                } else if len == 3 {
                    cp = (b0 - 224) * 4096
                       + (bytes.get(i + 1) % 256 - 128) * 64
                       + (bytes.get(i + 2) % 256 - 128);
                } else {
                    cp = (b0 - 240) * 262144
                       + (bytes.get(i + 1) % 256 - 128) * 4096
                       + (bytes.get(i + 2) % 256 - 128) * 64
                       + (bytes.get(i + 3) % 256 - 128);
                }
                out.push(cp);
                i = i + len;
            }
        }
    }
    return out;
}

/// Count the number of UTF-8 codepoints (characters) in a string.
/// Invalid bytes each count as one (replacement) character.
pub fn utf8_len(s: str) -> i64 {
    var bytes = str_bytes(s);
    var i = 0;
    var n = bytes.len();
    var count = 0;
    while i < n {
        var b0 = bytes.get(i) % 256;
        if b0 < 0 { b0 = b0 + 256; }
        var len = utf8_seq_len(b0);
        if len == 0 || i + len > n {
            i = i + 1;
        } else {
            i = i + len;
        }
        count = count + 1;
    }
    return count;
}

/// Encode one Unicode codepoint as its UTF-8 string.
/// Codepoints above U+10FFFF and surrogates encode as U+FFFD.
pub fn utf8_encode(cp: i64) -> str {
    var c = cp;
    if c < 0 || c > 1114111 || (c >= 55296 && c <= 57343) {
        c = 65533;
    }
    if c < 256 {
        return char_to_str(c);
    }
    return enc_bytes_to_str(utf8_encode_bytes(c));
}

/// Raw UTF-8 bytes of one codepoint as a Vec<i64> (for byte pipelines).
/// Codepoints above U+10FFFF and surrogates encode as U+FFFD.
pub fn utf8_encode_bytes(cp: i64) -> Vec {
    var bytes = Vec::new();
    var c = cp;
    if c < 0 || c > 1114111 || (c >= 55296 && c <= 57343) {
        c = 65533;
    }
    if c < 128 {
        bytes.push(c);
    } else if c < 2048 {
        bytes.push(192 + c / 64);
        bytes.push(128 + c % 64);
    } else if c < 65536 {
        bytes.push(224 + c / 4096);
        bytes.push(128 + (c / 64) % 64);
        bytes.push(128 + c % 64);
    } else {
        bytes.push(240 + c / 262144);
        bytes.push(128 + (c / 4096) % 64);
        bytes.push(128 + (c / 64) % 64);
        bytes.push(128 + c % 64);
    }
    return bytes;
}

/// Encode a Vec of codepoints as a UTF-8 string.
pub fn utf8_encode_all(cps: Vec) -> str {
    var bytes = Vec::new();
    var i = 0;
    while i < cps.len() {
        var one = utf8_encode_bytes(cps.get(i));
        var j = 0;
        while j < one.len() {
            bytes.push(one.get(j));
            j = j + 1;
        }
        i = i + 1;
    }
    return enc_bytes_to_str(bytes);
}
