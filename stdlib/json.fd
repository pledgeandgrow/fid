// Fides JSON standard library
//
// JSON values are represented as strings (the serialized form) and all
// operations below are implemented in pure Fides: a position-based
// RFC 8259 scanner plus helpers built on it. That makes behavior
// identical on every backend (interpreter, C, PE) — native p_json_*
// builtins exist in the runtime but differ per backend, so nothing here
// calls them.
//
// Semantics:
//   - plain accessors (json_parse/get/at/type/len/pretty) PANIC on input
//     that is not valid JSON, matching the old builtin behavior
//   - *_safe accessors never panic and return a documented fallback
//   - json_parse canonicalizes: whitespace removed, object keys sorted
//     recursively (the historical "canonical form")
//
// Raw-value rule: getters return the raw JSON text of a value (a string
// value still has its quotes); use json_get_str / json_unescape to decode.

module json;
use vec;
use encoding;
// ─── Pure-Fides JSON scanner ────────────────────────────────────────────
// Position-based scanning over a str. Whitespace and literals per RFC 8259.

// NOTE: scanners copy the index parameter to a local `var` before looping —
// clearer, and robust on every backend.
//
// Speed (competitive SL6): the scanners take the text's length `n` from
// their caller instead of asking str_len at every byte, read bytes in
// place (j_b, and inline in the hot loops) instead of through
// str_byte_at's checks, and classify a byte with one load from a 256-byte
// table: JCLASS picks the scanner for a value, JSTRC finds the end of a
// run of plain string bytes (the loop stops only at a quote, a backslash
// or a control byte). Every read is at 0 <= j < n, n = str_len(text).
// A long run of plain string bytes goes 8 bytes at a time in compiled
// code (j_plain_words: one aligned word load, three SWAR tests for a
// quote, a backslash or a byte below 0x20). The interpreter cannot read
// a string a word at a time (a word load at a string's address gives the
// string back): j_words_ok finds that out and it keeps the byte loop.

// JCLASS[b], what byte b starts where a value may begin: 'w' white space,
// 's' a string, 'r' an array, 'o' an object, 't' 'f' 'n' the literals,
// 'd' a number ('-' or a digit), 'x' nothing valid.
const JCLASS: str = "xxxxxxxxxwwxxwxxxxxxxxxxxxxxxxxxwxsxxxxxxxxxxdxxddddddddddxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxrxxxxxxxxxxfxxxxxxxnxxxxxtxxxxxxoxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
// JSTRC[b], byte b inside a string: '.' plain, 'q' the closing quote,
// 'b' a backslash, 'c' a control byte (it must be escaped).
const JSTRC: str = "cccccccccccccccccccccccccccccccc..q.........................................................b...................................................................................................................................................................";

// The byte at j of s, read in place. The caller has 0 <= j < str_len(s)
// (for the tables: 0 <= j < 256).
fn j_b(s: str, j: i64) -> i64 {
    var addr: i64 = (s as i64) + j;
    var p: *mut u8 = addr as *mut u8;
    var c: i64 = 0;
    // SAFETY: every caller passes 0 <= j < str_len(s): a byte of s.
    unsafe {
        c = *p;
    }
    return c;
}

fn j_ws(s: str, i: i64) -> i64 {
    return j_ws_n(s, i, str_len(s));
}

// Skip white space from i; n = str_len(s).
fn j_ws_n(s: str, i: i64, n: i64) -> i64 {
    var j: i64 = i;
    if j < 0 {
        return j;
    }
    val base: i64 = s as i64;
    while j < n {
        var addr: i64 = base + j;
        var p: *mut u8 = addr as *mut u8;
        var c: i64 = 0;
        // SAFETY: 0 <= j < n = str_len(s): a byte of s.
        unsafe {
            c = *p;
        }
        if c > 32 {
            return j;
        }
        if c != 32 && c != 10 && c != 13 && c != 9 {
            return j;
        }
        j = j + 1;
    }
    return j;
}

// The index past `lit` at i, or -1 if it doesn't match; n = str_len(s).
fn j_lit_n(s: str, i: i64, n: i64, lit: str) -> i64 {
    val m: i64 = str_len(lit);
    if i < 0 || i + m > n {
        return -1;
    }
    var k: i64 = 0;
    while k < m {
        if j_b(s, i + k) != j_b(lit, k) {
            return -1;
        }
        k = k + 1;
    }
    return i + m;
}

// Whether an 8-byte load from a string reads its bytes (little-endian).
// True in native and C builds. In the interpreter a word load at a
// string's address gives the string itself back, which is not the number
// below, so it answers false there and the scanners keep their byte loops.
fn j_words_ok() -> bool {
    val probe: str = "01234567";
    var w: i64 = 0;
    // SAFETY: the literal has 8 bytes (and its NUL): the load reads them.
    unsafe {
        var p: *mut i64 = (probe as i64) as * mut i64;
        w = *p;
    }
    // "01234567" as a little-endian word
    return w == 3978425819141910832;
}

// From i inside a string (the bytes before i are plain), the first index
// at or after i whose 8-byte word holds a quote, a backslash or a byte
// below 0x20, a whole word at a time; i itself when words cannot be read
// (j_words_ok). The bytes skipped are all plain, so the byte loop of
// j_scan_str_n resumes at the result. n = str_len(s).
//
// SWAR, on a word w of 8 bytes: (v - 0x01..01) & ~v & 0x80..80 is non-zero
// exactly when a byte of v is 0, so v = w ^ 0x22..22 finds a quote and
// v = w ^ 0x5c..5c a backslash; (w - 0x20..20) & ~w & 0x80..80 finds a
// byte below 0x20. Without such a byte nothing borrows, and no other byte
// (0x80 and up included) sets a bit.
@wrapping
fn j_plain_words(s: str, i: i64, n: i64) -> i64 {
    if !j_words_ok() {
        return i;
    }
    val base: i64 = s as i64;
    var j: i64 = i;
    // to an 8-byte boundary, a byte at a time
    while j < n && ((base + j) & 7) != 0 {
        if j_b(JSTRC, j_b(s, j)) != 46 {
            return j;
        }
        j = j + 1;
    }
    // 0x0101010101010101, 0x2222222222222222, 0x5c5c5c5c5c5c5c5c,
    // 0x2020202020202020 and 0x8080808080808080 (as an i64)
    val ones: i64 = 72340172838076673;
    val quotes: i64 = 2459565876494606882;
    val slashes: i64 = 6655295901103053916;
    val spaces: i64 = 2314885530818453536;
    val highs: i64 = -9187201950435737472;
    while j + 8 <= n {
        var w: i64 = 0;
        // SAFETY: base + j is 8-aligned and j + 8 <= n = str_len(s): the
        // word is 8 bytes of s.
        unsafe {
            var p: *mut i64 = (base + j) as * mut i64;
            w = *p;
        }
        val q: i64 = w ^ quotes;
        val b: i64 = w ^ slashes;
        val hit: i64 = (((q - ones) & (q ^ (-1))) | ((b - ones) & (b ^ (-1))) | ((w - spaces) & (w ^ (-1)))) & highs;
        if hit != 0 {
            return j;
        }
        j = j + 8;
    }
    return j;
}

fn j_scan_str(s: str, i: i64) -> i64 {
    return j_scan_str_n(s, i, str_len(s));
}

// i at '"'; returns the index past the closing quote, or -1 on malformed
// input; n = str_len(s).
fn j_scan_str_n(s: str, i: i64, n: i64) -> i64 {
    if i < 0 || i >= n || j_b(s, i) != 34 {
        return -1;
    }
    val base: i64 = s as i64;
    val tab: i64 = JSTRC as i64;
    var j: i64 = i + 1;
    while j < n {
        // a run of plain bytes: one table load each; after 16 of them, as
        // long as 16 more remain, whole words (j_plain_words)
        var cls: i64 = 46;
        var run: i64 = 0;
        while j < n {
            var addr: i64 = base + j;
            var p: *mut u8 = addr as *mut u8;
            // SAFETY: 0 <= j < n = str_len(s): a byte of s; then 0 <= c
            // < 256 (a u8), a byte of the 256-byte JSTRC.
            unsafe {
                var c: i64 = *p;
                var taddr: i64 = tab + c;
                var tp: *mut u8 = taddr;
                cls = *tp;
            }
            if cls != 46 {
                break;
            }
            j = j + 1;
            run = run + 1;
            if run == 16 && j + 16 <= n {
                j = j_plain_words(s, j, n);
                run = 0;
            }
        }
        if j >= n {
            return -1;
        }
        if cls == 113 {
            return j + 1;
        }
        if cls != 98 {
            // a control byte: it must be escaped
            return -1;
        }
        // only \" \\ \/ \b \f \n \r \t \uXXXX are valid escapes
        if j + 1 >= n {
            return -1;
        }
        val e: i64 = j_b(s, j + 1);
        if e == 117 {
            if j + 6 > n {
                return -1;
            }
            var k: i64 = 2;
            while k < 6 {
                val h: i64 = j_b(s, j + k);
                if !((h >= 48 && h <= 57) || (h >= 97 && h <= 102) || (h >= 65 && h <= 70)) {
                    return -1;
                }
                k = k + 1;
            }
            j = j + 6;
        } else if e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116 {
            j = j + 2;
        } else {
            return -1;
        }
    }
    return -1;
}

// Past the digits from i (i itself when there are none); n = str_len(s).
fn j_digits(s: str, i: i64, n: i64) -> i64 {
    var j: i64 = i;
    val base: i64 = s as i64;
    while j < n {
        var addr: i64 = base + j;
        var p: *mut u8 = addr as *mut u8;
        var c: i64 = 0;
        // SAFETY: 0 <= i <= j < n = str_len(s): a byte of s.
        unsafe {
            c = *p;
        }
        if c < 48 || c > 57 {
            return j;
        }
        j = j + 1;
    }
    return j;
}

// RFC 8259: number = [ "-" ] int [ frac ] [ exp ]; int = "0" / digit1-9
// *DIGIT; frac = "." 1*DIGIT; exp = ("e" / "E") [ "+" / "-" ] 1*DIGIT.
fn j_scan_num_n(s: str, i: i64, n: i64) -> i64 {
    var j: i64 = i;
    if j < 0 {
        return -1;
    }
    if j < n && j_b(s, j) == 45 {
        j = j + 1;
    }
    val first: i64 = j;
    j = j_digits(s, j, n);
    val digits: i64 = j - first;
    if digits == 0 {
        return -1;
    }
    if digits > 1 && j_b(s, first) == 48 {
        return -1;
    }
    if j < n && j_b(s, j) == 46 {
        val f0: i64 = j + 1;
        j = j_digits(s, f0, n);
        if j == f0 {
            return -1;
        }
    }
    if j < n && (j_b(s, j) == 101 || j_b(s, j) == 69) {
        j = j + 1;
        if j < n && (j_b(s, j) == 43 || j_b(s, j) == 45) {
            j = j + 1;
        }
        val e0: i64 = j;
        j = j_digits(s, e0, n);
        if j == e0 {
            return -1;
        }
    }
    return j;
}

fn j_scan_val(s: str, i: i64) -> i64 {
    return j_scan_val_n(s, i, str_len(s));
}

// The end of the value at i (after white space), -1 when it is malformed;
// one JCLASS load picks the scanner. n = str_len(s).
fn j_scan_val_n(s: str, i: i64, n: i64) -> i64 {
    return j_scan_val_d(s, i, n, 0);
}

// j_scan_val_n for a value inside `depth` arrays and objects. BG178: the
// scan recurses once per level, so arrays and objects nested deeper than
// JSON_MAX_DEPTH (as json_index) are malformed (-1) instead of running out
// of stack.
fn j_scan_val_d(s: str, i: i64, n: i64, depth: i64) -> i64 {
    val j: i64 = j_ws_n(s, i, n);
    if j < 0 || j >= n {
        return -1;
    }
    val k: i64 = j_b(JCLASS, j_b(s, j));
    if k == 115 {
        return j_scan_str_n(s, j, n);
    }
    if k == 100 {
        return j_scan_num_n(s, j, n);
    }
    if k == 111 {
        return j_scan_obj_n(s, j, n, depth);
    }
    if k == 114 {
        return j_scan_arr_n(s, j, n, depth);
    }
    if k == 116 {
        return j_lit_n(s, j, n, "true");
    }
    if k == 102 {
        return j_lit_n(s, j, n, "false");
    }
    if k == 110 {
        return j_lit_n(s, j, n, "null");
    }
    return -1;
}

// i at '['; n = str_len(s); `depth` arrays and objects around it. A
// nested array or object is scanned from here directly, not through
// j_scan_val_d, so a level costs one stack frame (the interpreter allows
// 1000 frames).
fn j_scan_arr_n(s: str, i: i64, n: i64, depth: i64) -> i64 {
    if depth >= JSON_MAX_DEPTH {
        return -1;
    }
    var j: i64 = j_ws_n(s, i + 1, n);
    if j < n && j_b(s, j) == 93 {
        return j + 1;
    }
    while true {
        j = j_ws_n(s, j, n);
        if j >= 0 && j < n && j_b(s, j) == 91 {
            j = j_scan_arr_n(s, j, n, depth + 1);
        } else if j >= 0 && j < n && j_b(s, j) == 123 {
            j = j_scan_obj_n(s, j, n, depth + 1);
        } else {
            j = j_scan_val_d(s, j, n, depth + 1);
        }
        if j < 0 {
            return -1;
        }
        j = j_ws_n(s, j, n);
        if j >= n {
            return -1;
        }
        val c: i64 = j_b(s, j);
        if c == 44 {
            j = j + 1;
            continue;
        }
        if c == 93 {
            return j + 1;
        }
        return -1;
    }
    return -1;
}

// i at '{'; n = str_len(s); `depth` as j_scan_arr_n.
fn j_scan_obj_n(s: str, i: i64, n: i64, depth: i64) -> i64 {
    if depth >= JSON_MAX_DEPTH {
        return -1;
    }
    var j: i64 = j_ws_n(s, i + 1, n);
    if j < n && j_b(s, j) == 125 {
        return j + 1;
    }
    while true {
        j = j_ws_n(s, j, n);
        j = j_scan_str_n(s, j, n);
        if j < 0 {
            return -1;
        }
        j = j_ws_n(s, j, n);
        if j >= n || j_b(s, j) != 58 {
            return -1;
        }
        j = j_ws_n(s, j + 1, n);
        if j >= 0 && j < n && j_b(s, j) == 91 {
            j = j_scan_arr_n(s, j, n, depth + 1);
        } else if j >= 0 && j < n && j_b(s, j) == 123 {
            j = j_scan_obj_n(s, j, n, depth + 1);
        } else {
            j = j_scan_val_d(s, j, n, depth + 1);
        }
        if j < 0 {
            return -1;
        }
        j = j_ws_n(s, j, n);
        if j >= n {
            return -1;
        }
        val c: i64 = j_b(s, j);
        if c == 44 {
            j = j + 1;
            continue;
        }
        if c == 125 {
            return j + 1;
        }
        return -1;
    }
    return -1;
}

/// True when `s` is well-formed JSON (RFC 8259 grammar, no trailing junk).
/// Pure Fides — never panics.
///
/// Example:
///   assert(json_is_valid("{\"a\": [1, 2, true]}"));
///   assert(!json_is_valid("{\"a\": }"));
pub fn json_is_valid(s: str) -> bool {
    val n: i64 = str_len(s);
    val end: i64 = j_scan_val_n(s, 0, n);
    if end < 0 {
        return false;
    }
    return j_ws_n(s, end, n) == n;
}

// ─── Member spans / type sniffing ───────────────────────────────────────

// Collect the top-level member spans of the object or array whose '{'
// or '[' is at index `i` of `s` (must already be known-valid).
//   object → flat Vec [key_start, key_end, val_start, val_end] × n
//             (key bounds include the surrounding quotes)
//   array  → flat Vec [val_start, val_end] × n
// Returns an empty Vec for {} / [] / malformed input.
fn j_members(s: str, i: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if str_byte_at(s, i) == 91 {
        var j: i64 = j_ws(s, i + 1);
        if j < str_len(s) && str_byte_at(s, j) == 93 {
            return out;
        }
        while j < str_len(s) {
            j = j_ws(s, j);
            var vs: i64 = j;
            var ve: i64 = j_scan_val(s, j);
            if ve < 0 {
                return Vec::new();
            }
            out.push(vs);
            out.push(ve);
            j = j_ws(s, ve);
            if j >= str_len(s) {
                return Vec::new();
            }
            var c: i64 = str_byte_at(s, j);
            if c == 44 {
                j = j + 1;
                continue;
            }
            if c == 93 {
                return out;
            }
            return Vec::new();
        }
        return Vec::new();
    }
    var j: i64 = j_ws(s, i + 1);
    if j < str_len(s) && str_byte_at(s, j) == 125 {
        return out;
    }
    while j < str_len(s) {
        j = j_ws(s, j);
        if j >= str_len(s) || str_byte_at(s, j) != 34 {
            return Vec::new();
        }
        var ks: i64 = j;
        var ke: i64 = j_scan_str(s, j);
        if ke < 0 {
            return Vec::new();
        }
        j = j_ws(s, ke);
        if j >= str_len(s) || str_byte_at(s, j) != 58 {
            return Vec::new();
        }
        var vs: i64 = j_ws(s, j + 1);
        var ve: i64 = j_scan_val(s, vs);
        if ve < 0 {
            return Vec::new();
        }
        out.push(ks);
        out.push(ke);
        out.push(vs);
        out.push(ve);
        j = j_ws(s, ve);
        if j >= str_len(s) {
            return Vec::new();
        }
        var c: i64 = str_byte_at(s, j);
        if c == 44 {
            j = j + 1;
            continue;
        }
        if c == 125 {
            return out;
        }
        return Vec::new();
    }
    return Vec::new();
}

// Type name of the value whose first non-ws byte is at index `i`.
// Caller must have validated `s`; returns "error" when the leading
// character cannot start a JSON value.
fn j_type_at(s: str, i: i64) -> str {
    if i >= str_len(s) {
        return "error";
    }
    var c: i64 = str_byte_at(s, i);
    if c == 123 {
        return "object";
    }
    if c == 91 {
        return "array";
    }
    if c == 34 {
        return "string";
    }
    if c == 116 || c == 102 {
        return "boolean";
    }
    if c == 110 {
        return "null";
    }
    if c == 45 || (c >= 48 && c <= 57) {
        return "number";
    }
    return "error";
}

// ─── Canonicalizer (minify + recursively sorted object keys) ───────────

fn j_canon(s: str, i: i64) -> str {
    var sb: StringBuilder = StringBuilder::new();
    j_canon_into(s, i, &mut sb);
    return sb.to_str();
}

fn j_canon_into(s: str, i: i64, out: &mut StringBuilder) {
    var j: i64 = j_ws(s, i);
    if j >= str_len(s) {
        return;
    }
    var c: i64 = str_byte_at(s, j);
    if c == 123 {
        j_canon_obj_into(s, j, out);
        return;
    }
    if c == 91 {
        j_canon_arr_into(s, j, out);
        return;
    }
    var e: i64 = j_scan_val(s, j);
    if e < 0 {
        return;
    }
    out.append_str(str_slice(s, j, e));
}

fn j_canon_obj_into(s: str, i: i64, out: &mut StringBuilder) {
    var mem: Vec<i64> = j_members(s, i);
    var n: i64 = mem.len() / 4;
    var keys: Vec<str> = Vec::new();
    var ord: Vec<i64> = Vec::new();
    var m: i64 = 0;
    while m < n {
        var kend: i64 = mem.get(m * 4 + 1);
        keys.push(json_unescape(str_slice(s, mem.get(m * 4), kend)));
        ord.push(m);
        m = m + 1;
    }
    // Insertion sort of member indices by unescaped key text (canonical form)
    var a: i64 = 1;
    while a < n {
        var io: i64 = ord.get(a);
        var kk: str = keys.get(io);
        var b: i64 = a - 1;
        while b >= 0 {
            if str_compare(keys.get(ord.get(b)), kk) <= 0 {
                break;
            }
            ord.set(b + 1, ord.get(b));
            b = b - 1;
        }
        ord.set(b + 1, io);
        a = a + 1;
    }
    out.append_str("{");
    m = 0;
    while m < n {
        if m > 0 {
            out.append_str(",");
        }
        var mm: i64 = ord.get(m);
        out.append_str(json_string(keys.get(mm)));
        out.append_str(":");
        j_canon_into(s, mem.get(mm * 4 + 2), out);
        m = m + 1;
    }
    out.append_str("}");
}

fn j_canon_arr_into(s: str, i: i64, out: &mut StringBuilder) {
    var mem: Vec<i64> = j_members(s, i);
    var n: i64 = mem.len() / 2;
    out.append_str("[");
    var m: i64 = 0;
    while m < n {
        if m > 0 {
            out.append_str(",");
        }
        j_canon_into(s, mem.get(m * 2), out);
        m = m + 1;
    }
    out.append_str("]");
}

// ─── Escaping ───────────────────────────────────────────────────────────

fn j_hex4(c: i64) -> str {
    var d: str = "0123456789abcdef";
    var a: i64 = (c / 4096) % 16;
    var b: i64 = (c / 256) % 16;
    var e: i64 = (c / 16) % 16;
    var f: i64 = c % 16;
    return "\\u" + str_slice(d, a, a + 1) + str_slice(d, b, b + 1) + str_slice(d, e, e + 1) + str_slice(d, f, f + 1);
}

/// Serialize a plain string as a JSON string literal (quotes + escaping).
///
/// Example:
///   var lit = json_string("say \"hi\"");
///   println(lit);
///   assert_eq(lit, "\"say \\\"hi\\\"\"");
pub fn json_string(s: str) -> str {
    var out: str = "\"";
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c == 34 || c == 92 {
            out = out + "\\" + str_slice(s, i, i + 1);
        } else if c == 10 {
            out = out + "\\n";
        } else if c == 13 {
            out = out + "\\r";
        } else if c == 9 {
            out = out + "\\t";
        } else if c < 32 {
            out = out + j_hex4(c);
        } else {
            out = out + str_slice(s, i, i + 1);
        }
        i = i + 1;
    }
    return out + "\"";
}

/// Decode a JSON string literal (with surrounding quotes) to plain text.
/// Handles \" \\ \/ \n \r \t \b \f and \uXXXX (UTF-8 encoded).
/// On malformed input returns the input unchanged.
///
/// Example:
///   assert_eq(json_unescape("\"a\\nb\""), "a\nb");
pub fn json_unescape(lit: str) -> str {
    var n: i64 = str_len(lit);
    if n < 2 || str_byte_at(lit, 0) != 34 || str_byte_at(lit, n - 1) != 34 {
        return lit;
    }
    var out: str = "";
    var i: i64 = 1;
    while i < n - 1 {
        var c: i64 = str_byte_at(lit, i);
        if c != 92 {
            out = out + str_slice(lit, i, i + 1);
            i = i + 1;
            continue;
        }
        i = i + 1;
        if i >= n - 1 {
            return lit;
        }
        var e: i64 = str_byte_at(lit, i);
        if e == 110 {
            out = out + "\n";
        } else if e == 116 {
            out = out + "\t";
        } else if e == 114 {
            out = out + "\r";
        } else if e == 98 {
            out = out + char_to_str(8);
        } else if e == 102 {
            out = out + char_to_str(12);
        } else if e == 117 {
            // \uXXXX — hex codepoint, encode as UTF-8
            var cp: i64 = 0;
            var k: i64 = 1;
            var ok: bool = true;
            while k <= 4 {
                if i + k > n - 1 {
                    ok = false;
                    break;
                }
                var h: i64 = str_byte_at(lit, i + k);
                var d: i64 = -1;
                if h >= 48 && h <= 57 {
                    d = h - 48;
                }
                if h >= 97 && h <= 102 {
                    d = h - 87;
                }
                if h >= 65 && h <= 70 {
                    d = h - 55;
                }
                if d < 0 {
                    ok = false;
                    break;
                }
                cp = cp * 16 + d;
                k = k + 1;
            }
            if !ok {
                return lit;
            }
            i = i + 4;
            // UTF-16 surrogate pair \uD8xx\uDCxx → one codepoint
            if cp >= 55296 && cp <= 56319 && i + 6 < n - 1 && str_byte_at(lit, i + 1) == 92 && str_byte_at(lit, i + 2) == 117 {
                var lo: i64 = 0;
                var k2: i64 = 3;
                while k2 <= 6 {
                    var h2: i64 = str_byte_at(lit, i + k2);
                    var d2: i64 = -1;
                    if h2 >= 48 && h2 <= 57 {
                        d2 = h2 - 48;
                    }
                    if h2 >= 97 && h2 <= 102 {
                        d2 = h2 - 87;
                    }
                    if h2 >= 65 && h2 <= 70 {
                        d2 = h2 - 55;
                    }
                    if d2 < 0 {
                        lo = -1;
                        break;
                    }
                    lo = lo * 16 + d2;
                    k2 = k2 + 1;
                }
                if lo >= 56320 && lo <= 57343 {
                    cp = 65536 + (cp - 55296) * 1024 + (lo - 56320);
                    i = i + 6;
                }
            }
            // byte-exact on every backend (utf8_encode goes through
            // char_to_str for cp < 256, which is one raw byte on C/PE)
            out = out + enc_bytes_to_str(utf8_encode_bytes(cp));
        } else {
            out = out + str_slice(lit, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

// ─── Accessors (panic on invalid input, like the old builtins) ──────────

/// Parse a JSON string and return its canonical (minified, keys sorted
/// recursively) form. PANICS on parse error — use json_parse_safe for a
/// non-panicking version.
///
/// Example:
///   var c = json_parse("{ \"b\": 2, \"a\": [1, 2] }");
///   println(c);
///   assert_eq(c, "{\"a\":[1,2],\"b\":2}");
pub fn json_parse(s: str) -> str {
    if !json_is_valid(s) {
        panic("json_parse: invalid JSON");
    }
    return j_canon(s, 0);
}

/// Alias for json_parse.
pub fn json_dump(s: str) -> str {
    return json_parse(s);
}

/// Extract a field from a JSON object. Returns the raw JSON value as a
/// string, or "null" when the key is absent.
/// PANICS if `s` is not a valid JSON object — use json_get_safe instead.
///
/// Example:
///   var doc = "{\"name\": \"Ada\", \"age\": 36}";
///   assert_eq(json_get(doc, "age"), "36");
///   assert_eq(json_get(doc, "name"), "\"Ada\"");
///   assert_eq(json_get(doc, "missing"), "null");
pub fn json_get(s: str, key: str) -> str {
    if !json_is_valid(s) || !str_equal(j_type_at(s, j_ws(s, 0)), "object") {
        panic("json_get: not an object");
    }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 4;
    var m: i64 = 0;
    while m < n {
        var klit: str = str_slice(s, mem.get(m * 4), mem.get(m * 4 + 1));
        if str_equal(json_unescape(klit), key) {
            return str_slice(s, mem.get(m * 4 + 2), mem.get(m * 4 + 3));
        }
        m = m + 1;
    }
    return "null";
}

/// Extract an element from a JSON array by index.
/// PANICS on out-of-bounds or non-array — use json_at_safe instead.
///
/// Example:
///   assert_eq(json_at("[10, 20, 30]", 1), "20");
pub fn json_at(s: str, idx: i64) -> str {
    if !json_is_valid(s) || !str_equal(j_type_at(s, j_ws(s, 0)), "array") {
        panic("json_at: not an array");
    }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 2;
    if idx < 0 || idx >= n {
        panic("json_at: index out of bounds");
    }
    return str_slice(s, mem.get(idx * 2), mem.get(idx * 2 + 1));
}

/// Type name of a JSON value: "object"|"array"|"string"|"number"|
/// "boolean"|"null". PANICS on invalid JSON — use json_type_safe instead.
///
/// Example:
///   assert_eq(json_type("[1]"), "array");
///   assert_eq(json_type("\"x\""), "string");
///   assert_eq(json_type("3.5"), "number");
pub fn json_type(s: str) -> str {
    if !json_is_valid(s) {
        panic("json_type: invalid JSON");
    }
    return j_type_at(s, j_ws(s, 0));
}

/// Length of a JSON object or array. PANICS for scalar types or invalid
/// JSON — use json_len_safe instead.
///
/// Example:
///   assert_eq(json_len("[1, 2, 3]"), 3);
///   assert_eq(json_len("{\"a\": 1}"), 1);
pub fn json_len(s: str) -> i64 {
    if !json_is_valid(s) {
        panic("json_len: invalid JSON");
    }
    var t: str = j_type_at(s, j_ws(s, 0));
    if str_equal(t, "object") {
        return j_members(s, j_ws(s, 0)).len() / 4;
    }
    if str_equal(t, "array") {
        return j_members(s, j_ws(s, 0)).len() / 2;
    }
    panic("json_len: not array or object");
}

// Indent helper — str_repeat(_, 0) is not reliable on every backend.
fn j_ind(n: i64) -> str {
    if n <= 0 {
        return "";
    }
    return str_repeat("  ", n);
}

/// Pretty-print a JSON string with 2-space indentation (canonical key
/// order). PANICS on invalid JSON — use json_pretty_safe instead.
///
/// Example:
///   var p = json_pretty("{\"a\":1}");
///   println(p);
///   assert_eq(p, "{\n  \"a\": 1\n}");
pub fn json_pretty(s: str) -> str {
    if !json_is_valid(s) {
        panic("json_pretty: invalid JSON");
    }
    var src: str = j_canon(s, 0);
    var out: str = "";
    var ind: i64 = 0;
    var in_str: bool = false;
    var i: i64 = 0;
    while i < str_len(src) {
        var c: i64 = str_byte_at(src, i);
        if in_str && c == 92 {
            // copy an escape pair whole, so "\\" before a quote is not
            // mistaken for an escaped quote
            out = out + str_slice(src, i, i + 2);
            i = i + 2;
            continue;
        }
        if c == 34 {
            in_str = !in_str;
        }
        if !in_str {
            if (c == 123 || c == 91) && i + 1 < str_len(src) && (str_byte_at(src, i + 1) == 125 || str_byte_at(src, i + 1) == 93) {
                // empty {} / []
                out = out + str_slice(src, i, i + 2);
                i = i + 2;
                continue;
            }
            if c == 123 || c == 91 {
                ind = ind + 1;
                out = out + str_slice(src, i, i + 1) + "\n" + j_ind(ind);
                i = i + 1;
                continue;
            }
            if c == 125 || c == 93 {
                ind = ind - 1;
                out = out + "\n" + j_ind(ind) + str_slice(src, i, i + 1);
                i = i + 1;
                continue;
            }
            if c == 44 {
                out = out + ",\n" + j_ind(ind);
                i = i + 1;
                continue;
            }
            if c == 58 {
                out = out + ": ";
                i = i + 1;
                continue;
            }
        }
        out = out + str_slice(src, i, i + 1);
        i = i + 1;
    }
    return out;
}

/// Build a JSON object from a key and raw JSON value. Returns {"key":value}.
///
/// Example:
///   assert_eq(json_pair("n", "1"), "{\"n\":1}");
pub fn json_pair(key: str, value: str) -> str {
    return "{" + json_string(key) + ":" + value + "}";
}

// ─── Safe wrappers (never panic) ────────────────────────────────────────

/// Canonicalize `s`, or "" when it is not valid JSON.
///
/// Example:
///   assert_eq(json_parse_safe("[1, 2]"), "[1,2]");
///   assert_eq(json_parse_safe("[1,"), "");
pub fn json_parse_safe(s: str) -> str {
    if !json_is_valid(s) {
        return "";
    }
    return j_canon(s, 0);
}

/// Type name of a JSON value, or "error" when `s` is not valid JSON.
///
/// Example:
///   assert_eq(json_type_safe("null"), "null");
///   assert_eq(json_type_safe("{oops"), "error");
pub fn json_type_safe(s: str) -> str {
    if !json_is_valid(s) {
        return "error";
    }
    return j_type_at(s, j_ws(s, 0));
}

/// Field of a JSON object as raw JSON text; "" on any failure, "null"
/// when the key is absent (matching historical json_get semantics).
///
/// Example:
///   assert_eq(json_get_safe("{\"a\": true}", "a"), "true");
///   assert_eq(json_get_safe("not json", "a"), "");
pub fn json_get_safe(s: str, key: str) -> str {
    if !str_equal(json_type_safe(s), "object") {
        return "";
    }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 4;
    var m: i64 = 0;
    while m < n {
        var klit: str = str_slice(s, mem.get(m * 4), mem.get(m * 4 + 1));
        if str_equal(json_unescape(klit), key) {
            return str_slice(s, mem.get(m * 4 + 2), mem.get(m * 4 + 3));
        }
        m = m + 1;
    }
    return "null";
}

/// Element of a JSON array as raw JSON text; "" on any failure.
///
/// Example:
///   assert_eq(json_at_safe("[1, 2]", 5), "");
pub fn json_at_safe(s: str, idx: i64) -> str {
    if !str_equal(json_type_safe(s), "array") {
        return "";
    }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 2;
    if idx < 0 || idx >= n {
        return "";
    }
    return str_slice(s, mem.get(idx * 2), mem.get(idx * 2 + 1));
}

/// Length of a JSON object/array; -1 otherwise.
///
/// Example:
///   assert_eq(json_len_safe("[]"), 0);
///   assert_eq(json_len_safe("42"), -1);
pub fn json_len_safe(s: str) -> i64 {
    var t: str = json_type_safe(s);
    if str_equal(t, "object") {
        return j_members(s, j_ws(s, 0)).len() / 4;
    }
    if str_equal(t, "array") {
        return j_members(s, j_ws(s, 0)).len() / 2;
    }
    return -1;
}

/// Pretty-print, or "" on invalid JSON.
pub fn json_pretty_safe(s: str) -> str {
    if !json_is_valid(s) {
        return "";
    }
    return json_pretty(s);
}

// ─── Typed getters ──────────────────────────────────────────────────────

/// Field of an object as a plain (unescaped) string; "" when the field is
/// missing, not a string, or the input is invalid.
///
/// Example:
///   assert_eq(json_get_str("{\"name\": \"Ada\"}", "name"), "Ada");
///   assert_eq(json_get_str("{\"n\": 1}", "n"), "");
pub fn json_get_str(s: str, key: str) -> str {
    var v: str = json_get_safe(s, key);
    if !str_equal(json_type_safe(v), "string") {
        return "";
    }
    return json_unescape(v);
}

/// Field of an object as an integer; `def` when missing/not a number.
///
/// Example:
///   var doc = "{\"port\": 8080}";
///   assert_eq(json_get_int(doc, "port", 80), 8080);
///   assert_eq(json_get_int(doc, "timeout", 30), 30);
pub fn json_get_int(s: str, key: str, def: i64) -> i64 {
    var v: str = json_get_safe(s, key);
    if !str_equal(json_type_safe(v), "number") {
        return def;
    }
    return str_parse_int(v);
}

/// Field of an object as a float; `def` when missing/not a number.
///
/// Example:
///   assert(json_get_num("{\"x\": 2.5}", "x", 0.0) == 2.5);
pub fn json_get_num(s: str, key: str, def: f64) -> f64 {
    var v: str = json_get_safe(s, key);
    if !str_equal(json_type_safe(v), "number") {
        return def;
    }
    return str_parse_float(v);
}

/// Field of an object as a bool; `def` when missing/not a boolean.
///
/// Example:
///   assert(json_get_bool("{\"debug\": true}", "debug", false));
///   assert(!json_get_bool("{}", "debug", false));
pub fn json_get_bool(s: str, key: str, def: bool) -> bool {
    var v: str = json_get_safe(s, key);
    if str_equal(v, "true") {
        return true;
    }
    if str_equal(v, "false") {
        return false;
    }
    return def;
}

/// True when `key` exists on object `s` (even if its value is null).
///
/// Example:
///   assert(json_has("{\"a\": null}", "a"));
///   assert(!json_has("{\"a\": null}", "b"));
pub fn json_has(s: str, key: str) -> bool {
    var keys: Vec<str> = json_keys(s);
    var i: i64 = 0;
    while i < keys.len() {
        var k: str = keys.get(i);
        if str_equal(k, key) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Array element as a plain string; "" when out of bounds or not a string.
///
/// Example:
///   assert_eq(json_at_str("[\"x\", \"y\"]", 1), "y");
pub fn json_at_str(s: str, idx: i64) -> str {
    var v: str = json_at_safe(s, idx);
    if !str_equal(json_type_safe(v), "string") {
        return "";
    }
    return json_unescape(v);
}

/// Array element as an integer; `def` otherwise.
///
/// Example:
///   assert_eq(json_at_int("[4, 5]", 0, -1), 4);
///   assert_eq(json_at_int("[4, 5]", 9, -1), -1);
pub fn json_at_int(s: str, idx: i64, def: i64) -> i64 {
    var v: str = json_at_safe(s, idx);
    if !str_equal(json_type_safe(v), "number") {
        return def;
    }
    return str_parse_int(v);
}

// ─── Key / element enumeration ──────────────────────────────────────────

/// Top-level keys of a JSON object as a Vec of plain strings, in document
/// order. Empty Vec when `s` is not an object.
///
/// Example:
///   var keys = json_keys("{\"b\": 1, \"a\": 2}");
///   assert_eq(keys.len(), 2);
///   assert_eq(keys.get(0), "b");
pub fn json_keys(s: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if !str_equal(json_type_safe(s), "object") {
        return out;
    }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 4;
    var m: i64 = 0;
    while m < n {
        out.push(json_unescape(str_slice(s, mem.get(m * 4), mem.get(m * 4 + 1))));
        m = m + 1;
    }
    return out;
}

/// Top-level elements of a JSON array as a Vec of raw JSON strings.
/// Empty Vec when `s` is not an array.
///
/// Example:
///   var items = json_items("[1, \"two\", [3]]");
///   assert_eq(items.len(), 3);
///   assert_eq(items.get(2), "[3]");
pub fn json_items(s: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if !str_equal(json_type_safe(s), "array") {
        return out;
    }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 2;
    var m: i64 = 0;
    while m < n {
        out.push(str_slice(s, mem.get(m * 2), mem.get(m * 2 + 1)));
        m = m + 1;
    }
    return out;
}

// ─── Path access ────────────────────────────────────────────────────────

/// Navigate a dot-separated path: "a.b.0.c" reads field a, then b, then
/// array index 0, then c. Returns raw JSON text or "" on any miss
/// ("null" when the final lookup lands on a missing key).
///
/// Example:
///   var doc = "{\"users\": [{\"name\": \"Ada\"}]}";
///   assert_eq(json_path(doc, "users.0.name"), "\"Ada\"");
pub fn json_path(s: str, path: str) -> str {
    var cur: str = s;
    var segs: Vec<str> = str_split(path, ".");
    var i: i64 = 0;
    while i < segs.len() {
        var seg: str = segs.get(i);
        var t: str = json_type_safe(cur);
        if str_equal(t, "object") {
            cur = json_get_safe(cur, seg);
        } else if str_equal(t, "array") {
            var idx: i64 = str_parse_int(seg);
            cur = json_at_safe(cur, idx);
        } else {
            return "";
        }
        if str_len(cur) == 0 {
            return "";
        }
        i = i + 1;
    }
    return cur;
}

// ─── Builders ───────────────────────────────────────────────────────────

/// Set (or replace) field `key` on JSON object `obj` with raw JSON `value`.
/// Works on any valid object text; returns obj unchanged if invalid.
///
/// Example:
///   var o = json_obj_set("{\"a\": 1}", "b", "2");
///   assert_eq(json_get_int(o, "b", 0), 2);
///   assert_eq(json_get_int(o, "a", 0), 1);
pub fn json_obj_set(obj: str, key: str, value: str) -> str {
    if !str_equal(json_type_safe(obj), "object") {
        return obj;
    }
    var mem: Vec<i64> = j_members(obj, j_ws(obj, 0));
    var n: i64 = mem.len() / 4;
    var m: i64 = 0;
    while m < n {
        var klit: str = str_slice(obj, mem.get(m * 4), mem.get(m * 4 + 1));
        if str_equal(json_unescape(klit), key) {
            var vs: i64 = mem.get(m * 4 + 2);
            var ve: i64 = mem.get(m * 4 + 3);
            return str_slice(obj, 0, vs) + value + str_slice(obj, ve, str_len(obj));
        }
        m = m + 1;
    }
    var trimmed: str = str_trim(obj);
    if str_len(trimmed) < 2 {
        return obj;
    }
    var inner: str = str_slice(trimmed, 1, str_len(trimmed) - 1);
    inner = str_trim(inner);
    var pair: str = json_string(key) + ":" + value;
    if str_len(inner) == 0 {
        return "{" + pair + "}";
    }
    return "{" + inner + "," + pair + "}";
}

/// Append raw JSON `value` to JSON array `arr`; returns arr if invalid.
///
/// Example:
///   var a = json_arr_push("[1]", "2");
///   assert_eq(json_len(a), 2);
///   assert_eq(json_at(a, 1), "2");
pub fn json_arr_push(arr: str, value: str) -> str {
    if !str_equal(json_type_safe(arr), "array") {
        return arr;
    }
    var trimmed: str = str_trim(arr);
    var inner: str = str_slice(trimmed, 1, str_len(trimmed) - 1);
    inner = str_trim(inner);
    if str_len(inner) == 0 {
        return "[" + value + "]";
    }
    return "[" + inner + "," + value + "]";
}

/// Number literal for building JSON.
///
/// Example:
///   assert_eq(json_num(-5), "-5");
pub fn json_num(n: i64) -> str {
    return int_to_str(n);
}

/// Bool literal for building JSON.
///
/// Example:
///   assert_eq(json_bool(true), "true");
pub fn json_bool(b: bool) -> str {
    if b {
        return "true";
    }
    return "false";
}

/// Null literal.
///
/// Example:
///   assert_eq(json_null(), "null");
pub fn json_null() -> str {
    return "null";
}

// ─── Indexed documents (competitive SL6) ───────────────────────────────
//
// json_index scans a document once and records every value as a node:
// its kind, where its text starts and ends, the node after its subtree
// and its number of children. Lookups then walk the nodes and never scan
// the text again: a field of a big document costs a walk over its
// siblings, not a validation of the whole document as json_get does, and
// a raw value is a slice of the text. Nodes are numbered in document
// order; the root is node 0; -1 is "no such node" and every jd_* function
// takes it. An object's children are pairs: its key (a string node), then
// the value.
//
//   val d: JsonDoc = json_index(text);
//   if !d.ok { ... }
//   val users: i64 = jd_get(& d, jd_root(& d), "users");
//   val name: str = jd_str(& d, jd_get(& d, jd_at(& d, users, 0), "name"));
//   val port: i64 = jd_int(& d, jd_path(& d, jd_root(& d), "server.port"), 80);

/// Node kinds (jd_kind).
pub const JSON_NULL: i64 = 0;
pub const JSON_FALSE: i64 = 1;
pub const JSON_TRUE: i64 = 2;
pub const JSON_NUMBER: i64 = 3;
pub const JSON_STRING: i64 = 4;
pub const JSON_ARRAY: i64 = 5;
pub const JSON_OBJECT: i64 = 6;
/// Arrays and objects nested deeper than this are refused (the scan is
/// recursive).
const JSON_MAX_DEPTH: i64 = 512;

/// A document indexed by json_index.
pub struct JsonDoc {
    pub text: str,
    /// False when the text is not one valid JSON value (RFC 8259)
    pub ok: bool,
    pub kind: Vec<i64>,
    pub start: Vec<i64>,
    pub end: Vec<i64>,
    /// The first node after this node's subtree
    pub next: Vec<i64>,
    /// Elements of an array, members of an object, 0 otherwise
    pub count: Vec<i64>,
}

fn jd_new_node(d: &mut JsonDoc, kind: i64, start: i64) -> i64 {
    val n: i64 = d.kind.len();
    d.kind.push(kind);
    d.start.push(start);
    d.end.push(start);
    d.next.push(n + 1);
    d.count.push(0);
    return n;
}

// A leaf (a string, number or literal) whose end is already known: its
// five words pushed once, without a later d.end.set.
fn jd_new_leaf(d: &mut JsonDoc, kind: i64, start: i64, end: i64) {
    val n: i64 = d.kind.len();
    d.kind.push(kind);
    d.start.push(start);
    d.end.push(end);
    d.next.push(n + 1);
    d.count.push(0);
}

// Index the value at `i` (after white space); returns where it ends, -1
// when it is malformed. n = str_len(d.text).
fn jd_value(d: &mut JsonDoc, i: i64, depth: i64, n: i64) -> i64 {
    // d.text is read in place (a binding would take an owner of it)
    var j: i64 = j_ws_n(d.text, i, n);
    if j < 0 || j >= n {
        return -1;
    }
    val c: i64 = j_b(d.text, j);
    if c == 91 || c == 123 {
        if depth >= JSON_MAX_DEPTH {
            return -1;
        }
        var kind: i64 = JSON_ARRAY;
        var close: i64 = 93;
        if c == 123 {
            kind = JSON_OBJECT;
            close = 125;
        }
        val node: i64 = jd_new_node(d, kind, j);
        var count: i64 = 0;
        j = j_ws_n(d.text, j + 1, n);
        if j < n && j_b(d.text, j) == close {
            j = j + 1;
        } else {
            var more: bool = true;
            while more {
                var e: i64 = -1;
                if kind == JSON_ARRAY {
                    e = jd_value(d, j, depth + 1, n);
                } else {
                    // a key, ':' and a value
                    j = j_ws_n(d.text, j, n);
                    if j >= n || j_b(d.text, j) != 34 {
                        return -1;
                    }
                    val ke: i64 = j_scan_str_n(d.text, j, n);
                    if ke < 0 {
                        return -1;
                    }
                    jd_new_leaf(d, JSON_STRING, j, ke);
                    j = j_ws_n(d.text, ke, n);
                    if j >= n || j_b(d.text, j) != 58 {
                        return -1;
                    }
                    e = jd_value(d, j + 1, depth + 1, n);
                }
                if e < 0 {
                    return -1;
                }
                count = count + 1;
                j = j_ws_n(d.text, e, n);
                if j >= n {
                    return -1;
                }
                val sep: i64 = j_b(d.text, j);
                if sep == 44 {
                    j = j + 1;
                } else if sep == close {
                    j = j + 1;
                    more = false;
                } else {
                    return -1;
                }
            }
        }
        d.end.set(node, j);
        d.next.set(node, d.kind.len());
        d.count.set(node, count);
        return j;
    }
    // one JCLASS load picks the scanner of a leaf
    val cls: i64 = j_b(JCLASS, c);
    var skind: i64 = JSON_NUMBER;
    var se: i64 = -1;
    if cls == 115 {
        skind = JSON_STRING;
        se = j_scan_str_n(d.text, j, n);
    } else if cls == 100 {
        se = j_scan_num_n(d.text, j, n);
    } else if cls == 116 {
        skind = JSON_TRUE;
        se = j_lit_n(d.text, j, n, "true");
    } else if cls == 102 {
        skind = JSON_FALSE;
        se = j_lit_n(d.text, j, n, "false");
    } else if cls == 110 {
        skind = JSON_NULL;
        se = j_lit_n(d.text, j, n, "null");
    }
    if se < 0 {
        return -1;
    }
    jd_new_leaf(d, skind, j, se);
    return se;
}

/// Index a document: one scan that also validates it (`ok`).
///
/// Example:
///   val d: JsonDoc = json_index("[1, 2, \"x\", [true, null]]");
///   assert(d.ok);
///   assert_eq(jd_len(& d, jd_root(& d)), 4);
///   assert_eq(jd_str(& d, jd_at(& d, jd_root(& d), 2)), "x");
///   assert_eq(jd_raw(& d, jd_at(& d, jd_root(& d), 3)), "[true, null]");
pub fn json_index(s: str) -> JsonDoc {
    var d: JsonDoc = JsonDoc {
        text: s, ok: true, kind: Vec::new(), start: Vec::new(), end: Vec::new(), next: Vec::new(), count: Vec::new(),
    };
    val n: i64 = str_len(s);
    val e: i64 = jd_value(&mut d, 0, 0, n);
    if e < 0 || j_ws_n(s, e, n) != n {
        d.ok = false;
    }
    return d;
}

/// The root node: 0, or -1 when the document is not valid.
pub fn jd_root(d: &JsonDoc) -> i64 {
    if !d.ok || d.kind.len() == 0 {
        return -1;
    }
    return 0;
}

/// How many nodes the document has.
pub fn jd_nodes(d: &JsonDoc) -> i64 {
    return d.kind.len();
}

fn jd_valid(d: &JsonDoc, node: i64) -> bool {
    return d.ok && node >= 0 && node < d.kind.len();
}

/// The kind of a node (JSON_NULL .. JSON_OBJECT), -1 for no node.
pub fn jd_kind(d: &JsonDoc, node: i64) -> i64 {
    if !jd_valid(d, node) {
        return -1;
    }
    return d.kind.get(node);
}

/// The kind as json_type names it: "null", "boolean", "number", "string",
/// "array", "object"; "error" for no node.
pub fn jd_type(d: &JsonDoc, node: i64) -> str {
    val k: i64 = jd_kind(d, node);
    if k == JSON_NULL {
        return "null";
    }
    if k == JSON_FALSE || k == JSON_TRUE {
        return "boolean";
    }
    if k == JSON_NUMBER {
        return "number";
    }
    if k == JSON_STRING {
        return "string";
    }
    if k == JSON_ARRAY {
        return "array";
    }
    if k == JSON_OBJECT {
        return "object";
    }
    return "error";
}

/// Elements of an array or members of an object; 0 for anything else.
pub fn jd_len(d: &JsonDoc, node: i64) -> i64 {
    if !jd_valid(d, node) {
        return 0;
    }
    return d.count.get(node);
}

/// The raw text of a node (a string keeps its quotes); "" for no node.
pub fn jd_raw(d: &JsonDoc, node: i64) -> str {
    if !jd_valid(d, node) {
        return "";
    }
    return str_slice(d.text, d.start.get(node), d.end.get(node));
}

/// Element `idx` of an array, -1 when out of range or not an array.
pub fn jd_at(d: &JsonDoc, node: i64, idx: i64) -> i64 {
    if jd_kind(d, node) != JSON_ARRAY || idx < 0 || idx >= d.count.get(node) {
        return -1;
    }
    var c: i64 = node + 1;
    var k: i64 = 0;
    while k < idx {
        c = d.next.get(c);
        k = k + 1;
    }
    return c;
}

// Whether key node `knode` spells `key` (compared in place when the key
// has no escapes).
fn jd_key_is(d: &JsonDoc, knode: i64, key: str) -> bool {
    val ks: i64 = d.start.get(knode) + 1;
    val ke: i64 = d.end.get(knode) - 1;
    val m: i64 = str_len(key);
    // In place up to the first backslash: the bytes before it decode to
    // themselves, so a plain byte that differs (or one past the end of
    // `key`) settles it; an escape decodes the key.
    var i: i64 = 0;
    while ks + i < ke {
        val c: i64 = j_b(d.text, ks + i);
        if c == 92 {
            return str_equal(json_unescape(str_slice(d.text, ks - 1, ke + 1)), key);
        }
        if i >= m || c != j_b(key, i) {
            return false;
        }
        i = i + 1;
    }
    return i == m;
}

/// The value of field `key` of an object (the first, when a key repeats),
/// -1 when it is missing or `node` is not an object.
pub fn jd_get(d: &JsonDoc, node: i64, key: str) -> i64 {
    if jd_kind(d, node) != JSON_OBJECT {
        return -1;
    }
    var c: i64 = node + 1;
    var m: i64 = 0;
    val count: i64 = d.count.get(node);
    while m < count {
        // c is the key, c + 1 its value
        if jd_key_is(d, c, key) {
            return c + 1;
        }
        c = d.next.get(c + 1);
        m = m + 1;
    }
    return -1;
}

/// Whether an object has field `key` (even when it is null).
pub fn jd_has(d: &JsonDoc, node: i64, key: str) -> bool {
    return jd_get(d, node, key) >= 0;
}

// The key node of member `idx` of an object, -1 when out of range.
fn jd_member_key(d: &JsonDoc, node: i64, idx: i64) -> i64 {
    if jd_kind(d, node) != JSON_OBJECT || idx < 0 || idx >= d.count.get(node) {
        return -1;
    }
    var c: i64 = node + 1;
    var m: i64 = 0;
    while m < idx {
        c = d.next.get(c + 1);
        m = m + 1;
    }
    return c;
}

/// The key of member `idx` of an object, decoded; "" when out of range.
pub fn jd_key(d: &JsonDoc, node: i64, idx: i64) -> str {
    val k: i64 = jd_member_key(d, node, idx);
    if k < 0 {
        return "";
    }
    return json_unescape(jd_raw(d, k));
}

/// The value of member `idx` of an object, -1 when out of range.
pub fn jd_member(d: &JsonDoc, node: i64, idx: i64) -> i64 {
    val k: i64 = jd_member_key(d, node, idx);
    if k < 0 {
        return -1;
    }
    return k + 1;
}

/// The elements of an array, or the members' values of an object, in
/// order, found in one walk; empty for anything else. jd_at and jd_member
/// walk from the first child at every call, so a loop over every element
/// should take this once and index it.
///
/// Example:
///   val d: JsonDoc = json_index("[10, 20, 30]");
///   val kids: Vec<i64> = jd_children(& d, jd_root(& d));
///   assert_eq(jd_int(& d, kids.get(2), 0), 30);
pub fn jd_children(d: &JsonDoc, node: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val k: i64 = jd_kind(d, node);
    if k != JSON_ARRAY && k != JSON_OBJECT {
        return out;
    }
    val count: i64 = d.count.get(node);
    var c: i64 = node + 1;
    var m: i64 = 0;
    while m < count {
        if k == JSON_OBJECT {
            // c is the key, c + 1 its value
            out.push(c + 1);
            c = d.next.get(c + 1);
        } else {
            out.push(c);
            c = d.next.get(c);
        }
        m = m + 1;
    }
    return out;
}

/// A string node decoded; "" for anything else.
pub fn jd_str(d: &JsonDoc, node: i64) -> str {
    if jd_kind(d, node) != JSON_STRING {
        return "";
    }
    return json_unescape(jd_raw(d, node));
}

/// A number node as an integer (read as json_get_int reads it); `def` for
/// anything else.
pub fn jd_int(d: &JsonDoc, node: i64, def: i64) -> i64 {
    if jd_kind(d, node) != JSON_NUMBER {
        return def;
    }
    return str_parse_int(jd_raw(d, node));
}

/// A number node as a float; `def` for anything else.
pub fn jd_num(d: &JsonDoc, node: i64, def: f64) -> f64 {
    if jd_kind(d, node) != JSON_NUMBER {
        return def;
    }
    return str_parse_float(jd_raw(d, node));
}

/// A true or false node; `def` for anything else.
pub fn jd_bool(d: &JsonDoc, node: i64, def: bool) -> bool {
    val k: i64 = jd_kind(d, node);
    if k == JSON_TRUE {
        return true;
    }
    if k == JSON_FALSE {
        return false;
    }
    return def;
}

/// Whether a node is null (false for no node).
pub fn jd_is_null(d: &JsonDoc, node: i64) -> bool {
    return jd_kind(d, node) == JSON_NULL;
}

/// Follow a dot-separated path from `node`, as json_path does: "a.b.0.c"
/// is field a, field b, element 0, field c. -1 on any miss.
pub fn jd_path(d: &JsonDoc, node: i64, path: str) -> i64 {
    var cur: i64 = node;
    val segs: Vec<str> = str_split(path, ".");
    var i: i64 = 0;
    while i < segs.len() && cur >= 0 {
        val seg: str = segs.get(i);
        val k: i64 = jd_kind(d, cur);
        if k == JSON_OBJECT {
            cur = jd_get(d, cur, seg);
        } else if k == JSON_ARRAY {
            cur = jd_at(d, cur, str_parse_int(seg));
        } else {
            cur = -1;
        }
        i = i + 1;
    }
    return cur;
}
