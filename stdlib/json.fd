// Fides JSON standard library
//
// JSON values are represented as strings (the serialized form) and all
// operations below are implemented in pure Fides: a position-based
// RFC 8259 scanner plus helpers built on it. That makes behavior
// identical on every backend (interpreter, C, PE) — native p_json_*
// builtins exist in the runtime but differ per backend, so nothing here
// calls them.
//
// Semantics:
//   - plain accessors (json_parse/get/at/type/len/pretty) PANIC on input
//     that is not valid JSON, matching the old builtin behavior
//   - *_safe accessors never panic and return a documented fallback
//   - json_parse canonicalizes: whitespace removed, object keys sorted
//     recursively (the historical "canonical form")
//
// Raw-value rule: getters return the raw JSON text of a value (a string
// value still has its quotes); use json_get_str / json_unescape to decode.

module json;

use vec;
use encoding;

// ─── Pure-Fides JSON scanner ────────────────────────────────────────────
// Position-based scanning over a str. Whitespace and literals per RFC 8259.

// NOTE: scanners copy the index parameter to a local `var` before looping —
// clearer, and robust on every backend.
fn j_ws(s: str, i: i64) -> i64 {
    var j: i64 = i;
    while j < str_len(s) {
        var c: i64 = str_byte_at(s, j);
        if c == 32 || c == 9 || c == 10 || c == 13 { j = j + 1; } else { return j; }
    }
    return j;
}

fn j_lit(s: str, i: i64, lit: str) -> i64 {
    // returns index past the literal, or -1 if it doesn't match
    var k: i64 = 0;
    while k < str_len(lit) {
        if i + k >= str_len(s) { return -1; }
        if str_byte_at(s, i + k) != str_byte_at(lit, k) { return -1; }
        k = k + 1;
    }
    return i + k;
}

fn j_scan_str(s: str, i: i64) -> i64 {
    // i at '"'; returns index past the closing quote, or -1 on malformed
    if i >= str_len(s) || str_byte_at(s, i) != 34 { return -1; }
    var j: i64 = i + 1;
    while j < str_len(s) {
        var c: i64 = str_byte_at(s, j);
        if c == 92 {
            // only \" \\ \/ \b \f \n \r \t \uXXXX are valid escapes
            if j + 1 >= str_len(s) { return -1; }
            var e: i64 = str_byte_at(s, j + 1);
            if e == 117 {
                var k: i64 = 2;
                while k < 6 {
                    if j + k >= str_len(s) { return -1; }
                    var h: i64 = str_byte_at(s, j + k);
                    if !((h >= 48 && h <= 57) || (h >= 97 && h <= 102) || (h >= 65 && h <= 70)) {
                        return -1;
                    }
                    k = k + 1;
                }
                j = j + 6;
                continue;
            }
            if e != 34 && e != 92 && e != 47 && e != 98 && e != 102 && e != 110 && e != 114 && e != 116 {
                return -1;
            }
            j = j + 2;
            continue;
        }
        if c == 34 { return j + 1; }
        if c < 32 { return -1; }  // control chars must be escaped
        j = j + 1;
    }
    return -1;
}

fn j_scan_num(s: str, i: i64) -> i64 {
    var j: i64 = i;
    if j < str_len(s) && str_byte_at(s, j) == 45 { j = j + 1; }
    // RFC 8259: int = "0" / digit1-9 *DIGIT; frac = "." 1*DIGIT
    var digits: i64 = 0;
    var first: i64 = j;
    while j < str_len(s) && str_byte_at(s, j) >= 48 && str_byte_at(s, j) <= 57 {
        j = j + 1;
        digits = digits + 1;
    }
    if digits == 0 { return -1; }
    if digits > 1 && str_byte_at(s, first) == 48 { return -1; }
    if j < str_len(s) && str_byte_at(s, j) == 46 {
        j = j + 1;
        var fd: i64 = 0;
        while j < str_len(s) && str_byte_at(s, j) >= 48 && str_byte_at(s, j) <= 57 {
            j = j + 1;
            fd = fd + 1;
        }
        if fd == 0 { return -1; }
    }
    if j < str_len(s) && (str_byte_at(s, j) == 101 || str_byte_at(s, j) == 69) {
        j = j + 1;
        if j < str_len(s) && (str_byte_at(s, j) == 43 || str_byte_at(s, j) == 45) { j = j + 1; }
        var ed: i64 = 0;
        while j < str_len(s) && str_byte_at(s, j) >= 48 && str_byte_at(s, j) <= 57 {
            j = j + 1;
            ed = ed + 1;
        }
        if ed == 0 { return -1; }
    }
    return j;
}

fn j_scan_val(s: str, i: i64) -> i64 {
    var j: i64 = j_ws(s, i);
    if j >= str_len(s) { return -1; }
    var c: i64 = str_byte_at(s, j);
    if c == 34 { return j_scan_str(s, j); }
    if c == 91 { return j_scan_arr(s, j); }
    if c == 123 { return j_scan_obj(s, j); }
    if c == 116 { return j_lit(s, j, "true"); }
    if c == 102 { return j_lit(s, j, "false"); }
    if c == 110 { return j_lit(s, j, "null"); }
    return j_scan_num(s, j);
}

fn j_scan_arr(s: str, i: i64) -> i64 {
    // i at '['
    var j: i64 = j_ws(s, i + 1);
    if j < str_len(s) && str_byte_at(s, j) == 93 { return j + 1; }
    while true {
        j = j_scan_val(s, j);
        if j < 0 { return -1; }
        j = j_ws(s, j);
        if j >= str_len(s) { return -1; }
        var c: i64 = str_byte_at(s, j);
        if c == 44 { j = j_ws(s, j + 1); continue; }
        if c == 93 { return j + 1; }
        return -1;
    }
    return -1;
}

fn j_scan_obj(s: str, i: i64) -> i64 {
    // i at '{'
    var j: i64 = j_ws(s, i + 1);
    if j < str_len(s) && str_byte_at(s, j) == 125 { return j + 1; }
    while true {
        j = j_ws(s, j);
        j = j_scan_str(s, j);
        if j < 0 { return -1; }
        j = j_ws(s, j);
        if j >= str_len(s) || str_byte_at(s, j) != 58 { return -1; }
        j = j_scan_val(s, j + 1);
        if j < 0 { return -1; }
        j = j_ws(s, j);
        if j >= str_len(s) { return -1; }
        var c: i64 = str_byte_at(s, j);
        if c == 44 { j = j + 1; continue; }
        if c == 125 { return j + 1; }
        return -1;
    }
    return -1;
}

/// True when `s` is well-formed JSON (RFC 8259 grammar, no trailing junk).
/// Pure Fides — never panics.
pub fn json_is_valid(s: str) -> bool {
    var end: i64 = j_scan_val(s, 0);
    if end < 0 { return false; }
    return j_ws(s, end) == str_len(s);
}

// ─── Member spans / type sniffing ───────────────────────────────────────

// Collect the top-level member spans of the object or array whose '{'
// or '[' is at index `i` of `s` (must already be known-valid).
//   object → flat Vec [key_start, key_end, val_start, val_end] × n
//             (key bounds include the surrounding quotes)
//   array  → flat Vec [val_start, val_end] × n
// Returns an empty Vec for {} / [] / malformed input.
fn j_members(s: str, i: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if str_byte_at(s, i) == 91 {
        var j: i64 = j_ws(s, i + 1);
        if j < str_len(s) && str_byte_at(s, j) == 93 { return out; }
        while j < str_len(s) {
            j = j_ws(s, j);
            var vs: i64 = j;
            var ve: i64 = j_scan_val(s, j);
            if ve < 0 { return Vec::new(); }
            out.push(vs);
            out.push(ve);
            j = j_ws(s, ve);
            if j >= str_len(s) { return Vec::new(); }
            var c: i64 = str_byte_at(s, j);
            if c == 44 { j = j + 1; continue; }
            if c == 93 { return out; }
            return Vec::new();
        }
        return Vec::new();
    }
    var j: i64 = j_ws(s, i + 1);
    if j < str_len(s) && str_byte_at(s, j) == 125 { return out; }
    while j < str_len(s) {
        j = j_ws(s, j);
        if j >= str_len(s) || str_byte_at(s, j) != 34 { return Vec::new(); }
        var ks: i64 = j;
        var ke: i64 = j_scan_str(s, j);
        if ke < 0 { return Vec::new(); }
        j = j_ws(s, ke);
        if j >= str_len(s) || str_byte_at(s, j) != 58 { return Vec::new(); }
        var vs: i64 = j_ws(s, j + 1);
        var ve: i64 = j_scan_val(s, vs);
        if ve < 0 { return Vec::new(); }
        out.push(ks);
        out.push(ke);
        out.push(vs);
        out.push(ve);
        j = j_ws(s, ve);
        if j >= str_len(s) { return Vec::new(); }
        var c: i64 = str_byte_at(s, j);
        if c == 44 { j = j + 1; continue; }
        if c == 125 { return out; }
        return Vec::new();
    }
    return Vec::new();
}

// Type name of the value whose first non-ws byte is at index `i`.
// Caller must have validated `s`; returns "error" when the leading
// character cannot start a JSON value.
fn j_type_at(s: str, i: i64) -> str {
    if i >= str_len(s) { return "error"; }
    var c: i64 = str_byte_at(s, i);
    if c == 123 { return "object"; }
    if c == 91 { return "array"; }
    if c == 34 { return "string"; }
    if c == 116 || c == 102 { return "boolean"; }
    if c == 110 { return "null"; }
    if c == 45 || (c >= 48 && c <= 57) { return "number"; }
    return "error";
}

// ─── Canonicalizer (minify + recursively sorted object keys) ───────────

fn j_canon(s: str, i: i64) -> str {
    var sb: StringBuilder = StringBuilder::new();
    j_canon_into(s, i, &mut sb);
    return sb.to_str();
}

fn j_canon_into(s: str, i: i64, out: &mut StringBuilder) {
    var j: i64 = j_ws(s, i);
    if j >= str_len(s) { return; }
    var c: i64 = str_byte_at(s, j);
    if c == 123 { j_canon_obj_into(s, j, out); return; }
    if c == 91 { j_canon_arr_into(s, j, out); return; }
    var e: i64 = j_scan_val(s, j);
    if e < 0 { return; }
    out.append_str(str_slice(s, j, e));
}

fn j_canon_obj_into(s: str, i: i64, out: &mut StringBuilder) {
    var mem: Vec<i64> = j_members(s, i);
    var n: i64 = mem.len() / 4;
    var keys: Vec<str> = Vec::new();
    var ord: Vec<i64> = Vec::new();
    var m: i64 = 0;
    while m < n {
        var kend: i64 = mem.get(m * 4 + 1);
        keys.push(json_unescape(str_slice(s, mem.get(m * 4), kend)));
        ord.push(m);
        m = m + 1;
    }
    // Insertion sort of member indices by unescaped key text (canonical form)
    var a: i64 = 1;
    while a < n {
        var io: i64 = ord.get(a);
        var kk: str = keys.get(io);
        var b: i64 = a - 1;
        while b >= 0 {
            if str_compare(keys.get(ord.get(b)), kk) <= 0 { break; }
            ord.set(b + 1, ord.get(b));
            b = b - 1;
        }
        ord.set(b + 1, io);
        a = a + 1;
    }
    out.append_str("{");
    m = 0;
    while m < n {
        if m > 0 { out.append_str(","); }
        var mm: i64 = ord.get(m);
        out.append_str(json_string(keys.get(mm)));
        out.append_str(":");
        j_canon_into(s, mem.get(mm * 4 + 2), out);
        m = m + 1;
    }
    out.append_str("}");
}

fn j_canon_arr_into(s: str, i: i64, out: &mut StringBuilder) {
    var mem: Vec<i64> = j_members(s, i);
    var n: i64 = mem.len() / 2;
    out.append_str("[");
    var m: i64 = 0;
    while m < n {
        if m > 0 { out.append_str(","); }
        j_canon_into(s, mem.get(m * 2), out);
        m = m + 1;
    }
    out.append_str("]");
}

// ─── Escaping ───────────────────────────────────────────────────────────

fn j_hex4(c: i64) -> str {
    var d: str = "0123456789abcdef";
    var a: i64 = (c / 4096) % 16;
    var b: i64 = (c / 256) % 16;
    var e: i64 = (c / 16) % 16;
    var f: i64 = c % 16;
    return "\\u"
        + str_slice(d, a, a + 1)
        + str_slice(d, b, b + 1)
        + str_slice(d, e, e + 1)
        + str_slice(d, f, f + 1);
}

/// Serialize a plain string as a JSON string literal (quotes + escaping).
pub fn json_string(s: str) -> str {
    var out: str = "\"";
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c == 34 || c == 92 {
            out = out + "\\" + str_slice(s, i, i + 1);
        } else if c == 10 {
            out = out + "\\n";
        } else if c == 13 {
            out = out + "\\r";
        } else if c == 9 {
            out = out + "\\t";
        } else if c < 32 {
            out = out + j_hex4(c);
        } else {
            out = out + str_slice(s, i, i + 1);
        }
        i = i + 1;
    }
    return out + "\"";
}

/// Decode a JSON string literal (with surrounding quotes) to plain text.
/// Handles \" \\ \/ \n \r \t \b \f and \uXXXX (UTF-8 encoded).
/// On malformed input returns the input unchanged.
pub fn json_unescape(lit: str) -> str {
    var n: i64 = str_len(lit);
    if n < 2 || str_byte_at(lit, 0) != 34 || str_byte_at(lit, n - 1) != 34 {
        return lit;
    }
    var out: str = "";
    var i: i64 = 1;
    while i < n - 1 {
        var c: i64 = str_byte_at(lit, i);
        if c != 92 {
            out = out + str_slice(lit, i, i + 1);
            i = i + 1;
            continue;
        }
        i = i + 1;
        if i >= n - 1 { return lit; }
        var e: i64 = str_byte_at(lit, i);
        if e == 110 { out = out + "\n"; }
        else if e == 116 { out = out + "\t"; }
        else if e == 114 { out = out + "\r"; }
        else if e == 98 { out = out + char_to_str(8); }
        else if e == 102 { out = out + char_to_str(12); }
        else if e == 117 {
            // \uXXXX — hex codepoint, encode as UTF-8
            var cp: i64 = 0;
            var k: i64 = 1;
            var ok: bool = true;
            while k <= 4 {
                if i + k > n - 1 { ok = false; break; }
                var h: i64 = str_byte_at(lit, i + k);
                var d: i64 = -1;
                if h >= 48 && h <= 57 { d = h - 48; }
                if h >= 97 && h <= 102 { d = h - 87; }
                if h >= 65 && h <= 70 { d = h - 55; }
                if d < 0 { ok = false; break; }
                cp = cp * 16 + d;
                k = k + 1;
            }
            if !ok { return lit; }
            i = i + 4;
            // UTF-16 surrogate pair \uD8xx\uDCxx → one codepoint
            if cp >= 55296 && cp <= 56319 && i + 6 < n - 1 &&
               str_byte_at(lit, i + 1) == 92 && str_byte_at(lit, i + 2) == 117 {
                var lo: i64 = 0;
                var k2: i64 = 3;
                while k2 <= 6 {
                    var h2: i64 = str_byte_at(lit, i + k2);
                    var d2: i64 = -1;
                    if h2 >= 48 && h2 <= 57 { d2 = h2 - 48; }
                    if h2 >= 97 && h2 <= 102 { d2 = h2 - 87; }
                    if h2 >= 65 && h2 <= 70 { d2 = h2 - 55; }
                    if d2 < 0 { lo = -1; break; }
                    lo = lo * 16 + d2;
                    k2 = k2 + 1;
                }
                if lo >= 56320 && lo <= 57343 {
                    cp = 65536 + (cp - 55296) * 1024 + (lo - 56320);
                    i = i + 6;
                }
            }
            // byte-exact on every backend (utf8_encode goes through
            // char_to_str for cp < 256, which is one raw byte on C/PE)
            out = out + enc_bytes_to_str(utf8_encode_bytes(cp));
        }
        else { out = out + str_slice(lit, i, i + 1); }
        i = i + 1;
    }
    return out;
}

// ─── Accessors (panic on invalid input, like the old builtins) ──────────

/// Parse a JSON string and return its canonical (minified, keys sorted
/// recursively) form. PANICS on parse error — use json_parse_safe for a
/// non-panicking version.
pub fn json_parse(s: str) -> str {
    if !json_is_valid(s) { panic("json_parse: invalid JSON"); }
    return j_canon(s, 0);
}

/// Alias for json_parse.
pub fn json_dump(s: str) -> str {
    return json_parse(s);
}

/// Extract a field from a JSON object. Returns the raw JSON value as a
/// string, or "null" when the key is absent.
/// PANICS if `s` is not a valid JSON object — use json_get_safe instead.
pub fn json_get(s: str, key: str) -> str {
    if !json_is_valid(s) || !str_equal(j_type_at(s, j_ws(s, 0)), "object") {
        panic("json_get: not an object");
    }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 4;
    var m: i64 = 0;
    while m < n {
        var klit: str = str_slice(s, mem.get(m * 4), mem.get(m * 4 + 1));
        if str_equal(json_unescape(klit), key) {
            return str_slice(s, mem.get(m * 4 + 2), mem.get(m * 4 + 3));
        }
        m = m + 1;
    }
    return "null";
}

/// Extract an element from a JSON array by index.
/// PANICS on out-of-bounds or non-array — use json_at_safe instead.
pub fn json_at(s: str, idx: i64) -> str {
    if !json_is_valid(s) || !str_equal(j_type_at(s, j_ws(s, 0)), "array") {
        panic("json_at: not an array");
    }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 2;
    if idx < 0 || idx >= n { panic("json_at: index out of bounds"); }
    return str_slice(s, mem.get(idx * 2), mem.get(idx * 2 + 1));
}

/// Type name of a JSON value: "object"|"array"|"string"|"number"|
/// "boolean"|"null". PANICS on invalid JSON — use json_type_safe instead.
pub fn json_type(s: str) -> str {
    if !json_is_valid(s) { panic("json_type: invalid JSON"); }
    return j_type_at(s, j_ws(s, 0));
}

/// Length of a JSON object or array. PANICS for scalar types or invalid
/// JSON — use json_len_safe instead.
pub fn json_len(s: str) -> i64 {
    if !json_is_valid(s) { panic("json_len: invalid JSON"); }
    var t: str = j_type_at(s, j_ws(s, 0));
    if str_equal(t, "object") { return j_members(s, j_ws(s, 0)).len() / 4; }
    if str_equal(t, "array") { return j_members(s, j_ws(s, 0)).len() / 2; }
    panic("json_len: not array or object");
}

// Indent helper — str_repeat(_, 0) is not reliable on every backend.
fn j_ind(n: i64) -> str {
    if n <= 0 { return ""; }
    return str_repeat("  ", n);
}

/// Pretty-print a JSON string with 2-space indentation (canonical key
/// order). PANICS on invalid JSON — use json_pretty_safe instead.
pub fn json_pretty(s: str) -> str {
    if !json_is_valid(s) { panic("json_pretty: invalid JSON"); }
    var src: str = j_canon(s, 0);
    var out: str = "";
    var ind: i64 = 0;
    var in_str: bool = false;
    var i: i64 = 0;
    while i < str_len(src) {
        var c: i64 = str_byte_at(src, i);
        if in_str && c == 92 {
            // copy an escape pair whole, so "\\" before a quote is not
            // mistaken for an escaped quote
            out = out + str_slice(src, i, i + 2);
            i = i + 2;
            continue;
        }
        if c == 34 { in_str = !in_str; }
        if !in_str {
            if (c == 123 || c == 91) && i + 1 < str_len(src) &&
               (str_byte_at(src, i + 1) == 125 || str_byte_at(src, i + 1) == 93) {
                // empty {} / []
                out = out + str_slice(src, i, i + 2);
                i = i + 2;
                continue;
            }
            if c == 123 || c == 91 {
                ind = ind + 1;
                out = out + str_slice(src, i, i + 1) + "\n" + j_ind(ind);
                i = i + 1;
                continue;
            }
            if c == 125 || c == 93 {
                ind = ind - 1;
                out = out + "\n" + j_ind(ind) + str_slice(src, i, i + 1);
                i = i + 1;
                continue;
            }
            if c == 44 {
                out = out + ",\n" + j_ind(ind);
                i = i + 1;
                continue;
            }
            if c == 58 {
                out = out + ": ";
                i = i + 1;
                continue;
            }
        }
        out = out + str_slice(src, i, i + 1);
        i = i + 1;
    }
    return out;
}

/// Build a JSON object from a key and raw JSON value. Returns {"key":value}.
pub fn json_pair(key: str, value: str) -> str {
    return "{" + json_string(key) + ":" + value + "}";
}

// ─── Safe wrappers (never panic) ────────────────────────────────────────

/// Canonicalize `s`, or "" when it is not valid JSON.
pub fn json_parse_safe(s: str) -> str {
    if !json_is_valid(s) { return ""; }
    return j_canon(s, 0);
}

/// Type name of a JSON value, or "error" when `s` is not valid JSON.
pub fn json_type_safe(s: str) -> str {
    if !json_is_valid(s) { return "error"; }
    return j_type_at(s, j_ws(s, 0));
}

/// Field of a JSON object as raw JSON text; "" on any failure, "null"
/// when the key is absent (matching historical json_get semantics).
pub fn json_get_safe(s: str, key: str) -> str {
    if !str_equal(json_type_safe(s), "object") { return ""; }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 4;
    var m: i64 = 0;
    while m < n {
        var klit: str = str_slice(s, mem.get(m * 4), mem.get(m * 4 + 1));
        if str_equal(json_unescape(klit), key) {
            return str_slice(s, mem.get(m * 4 + 2), mem.get(m * 4 + 3));
        }
        m = m + 1;
    }
    return "null";
}

/// Element of a JSON array as raw JSON text; "" on any failure.
pub fn json_at_safe(s: str, idx: i64) -> str {
    if !str_equal(json_type_safe(s), "array") { return ""; }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 2;
    if idx < 0 || idx >= n { return ""; }
    return str_slice(s, mem.get(idx * 2), mem.get(idx * 2 + 1));
}

/// Length of a JSON object/array; -1 otherwise.
pub fn json_len_safe(s: str) -> i64 {
    var t: str = json_type_safe(s);
    if str_equal(t, "object") { return j_members(s, j_ws(s, 0)).len() / 4; }
    if str_equal(t, "array") { return j_members(s, j_ws(s, 0)).len() / 2; }
    return -1;
}

/// Pretty-print, or "" on invalid JSON.
pub fn json_pretty_safe(s: str) -> str {
    if !json_is_valid(s) { return ""; }
    return json_pretty(s);
}

// ─── Typed getters ──────────────────────────────────────────────────────

/// Field of an object as a plain (unescaped) string; "" when the field is
/// missing, not a string, or the input is invalid.
pub fn json_get_str(s: str, key: str) -> str {
    var v: str = json_get_safe(s, key);
    if !str_equal(json_type_safe(v), "string") { return ""; }
    return json_unescape(v);
}

/// Field of an object as an integer; `def` when missing/not a number.
pub fn json_get_int(s: str, key: str, def: i64) -> i64 {
    var v: str = json_get_safe(s, key);
    if !str_equal(json_type_safe(v), "number") { return def; }
    return str_parse_int(v);
}

/// Field of an object as a float; `def` when missing/not a number.
pub fn json_get_num(s: str, key: str, def: f64) -> f64 {
    var v: str = json_get_safe(s, key);
    if !str_equal(json_type_safe(v), "number") { return def; }
    return str_parse_float(v);
}

/// Field of an object as a bool; `def` when missing/not a boolean.
pub fn json_get_bool(s: str, key: str, def: bool) -> bool {
    var v: str = json_get_safe(s, key);
    if str_equal(v, "true") { return true; }
    if str_equal(v, "false") { return false; }
    return def;
}

/// True when `key` exists on object `s` (even if its value is null).
pub fn json_has(s: str, key: str) -> bool {
    var keys: Vec<str> = json_keys(s);
    var i: i64 = 0;
    while i < keys.len() {
        var k: str = keys.get(i);
        if str_equal(k, key) { return true; }
        i = i + 1;
    }
    return false;
}

/// Array element as a plain string; "" when out of bounds or not a string.
pub fn json_at_str(s: str, idx: i64) -> str {
    var v: str = json_at_safe(s, idx);
    if !str_equal(json_type_safe(v), "string") { return ""; }
    return json_unescape(v);
}

/// Array element as an integer; `def` otherwise.
pub fn json_at_int(s: str, idx: i64, def: i64) -> i64 {
    var v: str = json_at_safe(s, idx);
    if !str_equal(json_type_safe(v), "number") { return def; }
    return str_parse_int(v);
}

// ─── Key / element enumeration ──────────────────────────────────────────

/// Top-level keys of a JSON object as a Vec of plain strings, in document
/// order. Empty Vec when `s` is not an object.
pub fn json_keys(s: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if !str_equal(json_type_safe(s), "object") { return out; }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 4;
    var m: i64 = 0;
    while m < n {
        out.push(json_unescape(str_slice(s, mem.get(m * 4), mem.get(m * 4 + 1))));
        m = m + 1;
    }
    return out;
}

/// Top-level elements of a JSON array as a Vec of raw JSON strings.
/// Empty Vec when `s` is not an array.
pub fn json_items(s: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    if !str_equal(json_type_safe(s), "array") { return out; }
    var mem: Vec<i64> = j_members(s, j_ws(s, 0));
    var n: i64 = mem.len() / 2;
    var m: i64 = 0;
    while m < n {
        out.push(str_slice(s, mem.get(m * 2), mem.get(m * 2 + 1)));
        m = m + 1;
    }
    return out;
}

// ─── Path access ────────────────────────────────────────────────────────

/// Navigate a dot-separated path: "a.b.0.c" reads field a, then b, then
/// array index 0, then c. Returns raw JSON text or "" on any miss
/// ("null" when the final lookup lands on a missing key).
pub fn json_path(s: str, path: str) -> str {
    var cur: str = s;
    var segs: Vec<str> = str_split(path, ".");
    var i: i64 = 0;
    while i < segs.len() {
        var seg: str = segs.get(i);
        var t: str = json_type_safe(cur);
        if str_equal(t, "object") {
            cur = json_get_safe(cur, seg);
        } else if str_equal(t, "array") {
            var idx: i64 = str_parse_int(seg);
            cur = json_at_safe(cur, idx);
        } else {
            return "";
        }
        if str_len(cur) == 0 { return ""; }
        i = i + 1;
    }
    return cur;
}

// ─── Builders ───────────────────────────────────────────────────────────

/// Set (or replace) field `key` on JSON object `obj` with raw JSON `value`.
/// Works on any valid object text; returns obj unchanged if invalid.
pub fn json_obj_set(obj: str, key: str, value: str) -> str {
    if !str_equal(json_type_safe(obj), "object") { return obj; }
    var mem: Vec<i64> = j_members(obj, j_ws(obj, 0));
    var n: i64 = mem.len() / 4;
    var m: i64 = 0;
    while m < n {
        var klit: str = str_slice(obj, mem.get(m * 4), mem.get(m * 4 + 1));
        if str_equal(json_unescape(klit), key) {
            var vs: i64 = mem.get(m * 4 + 2);
            var ve: i64 = mem.get(m * 4 + 3);
            return str_slice(obj, 0, vs) + value + str_slice(obj, ve, str_len(obj));
        }
        m = m + 1;
    }
    var trimmed: str = str_trim(obj);
    if str_len(trimmed) < 2 { return obj; }
    var inner: str = str_slice(trimmed, 1, str_len(trimmed) - 1);
    inner = str_trim(inner);
    var pair: str = json_string(key) + ":" + value;
    if str_len(inner) == 0 {
        return "{" + pair + "}";
    }
    return "{" + inner + "," + pair + "}";
}

/// Append raw JSON `value` to JSON array `arr`; returns arr if invalid.
pub fn json_arr_push(arr: str, value: str) -> str {
    if !str_equal(json_type_safe(arr), "array") { return arr; }
    var trimmed: str = str_trim(arr);
    var inner: str = str_slice(trimmed, 1, str_len(trimmed) - 1);
    inner = str_trim(inner);
    if str_len(inner) == 0 {
        return "[" + value + "]";
    }
    return "[" + inner + "," + value + "]";
}

/// Number literal for building JSON.
pub fn json_num(n: i64) -> str {
    return int_to_str(n);
}

/// Bool literal for building JSON.
pub fn json_bool(b: bool) -> str {
    if b { return "true"; }
    return "false";
}

/// Null literal.
pub fn json_null() -> str {
    return "null";
}
