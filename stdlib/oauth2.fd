// Fides OAuth 2.0 (RFC 6749) and OpenID Connect client side: the
// authorization request URL (§4.1.1, with OIDC nonce), PKCE (RFC 7636:
// S256 and plain), parsing the redirect (code, state, error, RFC 9207
// iss), token request bodies for the authorization code, refresh token
// and client credentials grants with client_secret_basic,
// client_secret_post or a JWT client assertion (RFC 7523 §2.2, signed by
// jose.fd), token revocation (RFC 7009), token and error response parsing
// (§5.1, §5.2), Bearer requests (RFC 6750), OpenID Provider discovery
// (OIDC Discovery 1.0 §3-§4, RFC 8414), and ID token validation (OIDC
// Core §3.1.3.7: signature against the provider's JWKS, iss, aud, azp,
// exp, iat, nonce, auth_time with max_age, at_hash).
//
// Pure computation. The seams: HTTP is the caller's (every request comes
// back as an OAuthHttpRequest: method, URL, headers, form body; every
// response goes in as status and body text), time is injected (`now`,
// Unix seconds), and randomness (state, nonce, PKCE verifier, assertion
// jti) comes from crypto_random_bytes through oauth2_random_token, or
// from the caller.
//
// Checked in tests/bootstrap/test_std_oauth2.fd against RFC 7636
// Appendix B (S256), RFC 6749's form encoding, and ID tokens signed by
// Node.js (OpenSSL) with an RSA key published in a JWKS.
//
// Usage:
//   use oauth2;
//   val cfg = oauth2_parse_discovery(doc_json, "https://idp.example");
//   val pkce = oauth2_pkce(oauth2_random_token(32));
//   val url = oauth2_authorize_url(& cfg, & client, "openid profile", state, nonce, pkce.challenge);
//   val cb = oauth2_parse_redirect(redirect_url, state, & cfg);        // cb.ok, cb.code
//   val req = oauth2_code_request(& cfg, & client, cb.code, pkce.verifier, now);
//   val tok = oauth2_parse_token_response(status, body, now);
//   val idt = oidc_validate_id_token(tok.id_token, & keys, & cfg, & client, nonce, tok.access_token, now, -1);

module oauth2;
use vec;
use string;
use encoding;
use json;
use crypto;
use kdf;
use sha512;
use jose;

/// What a client knows about itself. `auth` is "client_secret_basic",
/// "client_secret_post", "client_secret_jwt" (HS256 assertion with the
/// secret), "private_key_jwt" (assertion signed with `key`) or "none"
/// (public client: client_id in the body).
pub struct OAuthClient {
    pub client_id: str,
    pub client_secret: str,
    pub redirect_uri: str,
    pub auth: str,
    pub key: Jwk,
    pub alg: str,
}

/// The provider's metadata (discovery document).
pub struct OAuthProvider {
    pub ok: bool,
    pub err: str,
    pub issuer: str,
    pub authorization_endpoint: str,
    pub token_endpoint: str,
    pub userinfo_endpoint: str,
    pub jwks_uri: str,
    pub revocation_endpoint: str,
    pub end_session_endpoint: str,
    pub id_token_algs: str,
    pub supports_s256: bool,
    pub iss_parameter: bool,
}

/// An HTTP request to send: headers are "Name: value" lines joined by CR LF.
pub struct OAuthHttpRequest {
    pub method: str,
    pub url: str,
    pub headers: str,
    pub body: str,
}

/// A PKCE pair.
pub struct OAuthPkce {
    pub verifier: str,
    pub challenge: str,
    pub method: str,
}

/// The result of the authorization redirect.
pub struct OAuthRedirect {
    pub ok: bool,
    pub err: str,
    pub code: str,
    pub state: str,
}

/// A token response (or its error).
pub struct OAuthToken {
    pub ok: bool,
    pub err: str,
    pub err_description: str,
    pub access_token: str,
    pub token_type: str,
    pub expires_at: i64,
    pub refresh_token: str,
    pub scope: str,
    pub id_token: str,
}

/// A validated ID token: its claims and the subject.
pub struct OidcIdToken {
    pub ok: bool,
    pub err: str,
    pub sub: str,
    pub claims: str,
}

// ─── Encoding and randomness ───────────────────────────────────────────

fn oauth2_hex_digit(v: i64) -> str {
    return str_slice("0123456789ABCDEF", v, v + 1);
}

/// application/x-www-form-urlencoded encoding of one name or value
/// (RFC 6749 Appendix B): ALPHA DIGIT - . _ ~ kept, space as "+", every
/// other UTF-8 byte as %XX.
pub fn oauth2_form_encode(s: str) -> str {
    val b: Vec<i64> = str_bytes(s);
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < b.len() {
        val c: i64 = b.get(i);
        val keep: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 95 || c == 126;
        if keep {
            out.push(c);
        } else if c == 32 {
            out.push(43);
        } else {
            out.push(37);
            out.push(str_byte_at(oauth2_hex_digit(c >> 4), 0));
            out.push(str_byte_at(oauth2_hex_digit(c & 15), 0));
        }
        i = i + 1;
    }
    return str_from_bytes(out);
}

fn oauth2_hexval(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48; }
    if c >= 65 && c <= 70 { return c - 55; }
    if c >= 97 && c <= 102 { return c - 87; }
    return -1;
}

/// Decode one form-encoded component ("+" is a space).
pub fn oauth2_form_decode(s: str) -> str {
    val b: Vec<i64> = str_bytes(s);
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < b.len() {
        val c: i64 = b.get(i);
        if c == 43 {
            out.push(32);
        } else if c == 37 && i + 2 < b.len() && oauth2_hexval(b.get(i + 1)) >= 0 && oauth2_hexval(b.get(i + 2)) >= 0 {
            out.push(oauth2_hexval(b.get(i + 1)) * 16 + oauth2_hexval(b.get(i + 2)));
            i = i + 2;
        } else {
            out.push(c);
        }
        i = i + 1;
    }
    return str_from_bytes(out);
}

fn oauth2_param(name: str, value: str) -> str {
    return oauth2_form_encode(name) + "=" + oauth2_form_encode(value);
}

fn oauth2_add(body: str, name: str, value: str) -> str {
    if str_len(value) == 0 { return body; }
    if str_len(body) == 0 { return oauth2_param(name, value); }
    return body + "&" + oauth2_param(name, value);
}

/// The value of `name` in a form-encoded string ("" when absent).
pub fn oauth2_form_get(form: str, name: str) -> str {
    val pairs: Vec<str> = str_split(form, "&");
    var i: i64 = 0;
    while i < pairs.len() {
        val p: str = pairs.get(i);
        val eq: i64 = str_find(p, "=");
        if eq > 0 && str_equal(oauth2_form_decode(str_slice(p, 0, eq)), name) {
            return oauth2_form_decode(str_slice(p, eq + 1, str_len(p)));
        }
        if eq < 0 && str_equal(oauth2_form_decode(p), name) { return ""; }
        i = i + 1;
    }
    return "";
}

/// True when the form has the parameter (even empty).
pub fn oauth2_form_has(form: str, name: str) -> bool {
    val pairs: Vec<str> = str_split(form, "&");
    var i: i64 = 0;
    while i < pairs.len() {
        val p: str = pairs.get(i);
        var key: str = p;
        val eq: i64 = str_find(p, "=");
        if eq >= 0 { key = str_slice(p, 0, eq); }
        if str_equal(oauth2_form_decode(key), name) { return true; }
        i = i + 1;
    }
    return false;
}

/// `n` random bytes as base64url text (state, nonce, PKCE verifier).
pub fn oauth2_random_token(n: i64) -> str {
    return jose_b64url_encode(crypto_random_bytes(n));
}

// ─── PKCE (RFC 7636) ───────────────────────────────────────────────────

/// True when a verifier is 43..128 unreserved characters (§4.1).
pub fn oauth2_pkce_verifier_ok(v: str) -> bool {
    val b: Vec<i64> = str_bytes(v);
    if b.len() < 43 || b.len() > 128 { return false; }
    var i: i64 = 0;
    while i < b.len() {
        val c: i64 = b.get(i);
        val ok: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 95 || c == 126;
        if !ok { return false; }
        i = i + 1;
    }
    return true;
}

/// S256: challenge = BASE64URL(SHA-256(ASCII(verifier))).
pub fn oauth2_pkce(verifier: str) -> OAuthPkce {
    if !oauth2_pkce_verifier_ok(verifier) { return OAuthPkce { verifier: "", challenge: "", method: "" }; }
    return OAuthPkce { verifier: verifier, challenge: jose_b64url_encode(crypto_sha256_bytes(str_bytes(verifier))), method: "S256" };
}

/// The plain method (only for providers without S256).
pub fn oauth2_pkce_plain(verifier: str) -> OAuthPkce {
    if !oauth2_pkce_verifier_ok(verifier) { return OAuthPkce { verifier: "", challenge: "", method: "" }; }
    return OAuthPkce { verifier: verifier, challenge: verifier, method: "plain" };
}

/// The server side check of §4.6.
pub fn oauth2_pkce_check(verifier: str, challenge: str, method: str) -> bool {
    if !oauth2_pkce_verifier_ok(verifier) { return false; }
    if str_equal(method, "S256") { return str_equal(oauth2_pkce(verifier).challenge, challenge); }
    if str_equal(method, "plain") { return str_equal(verifier, challenge); }
    return false;
}

// ─── Clients and providers ─────────────────────────────────────────────

/// A client with a secret (client_secret_basic), or a public client when
/// `secret` is empty (auth "none").
pub fn oauth2_client(client_id: str, secret: str, redirect_uri: str) -> OAuthClient {
    var auth: str = "client_secret_basic";
    if str_len(secret) == 0 { auth = "none"; }
    return OAuthClient { client_id: client_id, client_secret: secret, redirect_uri: redirect_uri, auth: auth, key: jwk_empty(), alg: "" };
}

/// The discovery document URL for an issuer (§4).
pub fn oauth2_discovery_url(issuer: str) -> str {
    var base: str = issuer;
    if str_ends_with(base, "/") { base = str_slice(base, 0, str_len(base) - 1); }
    return base + "/.well-known/openid-configuration";
}

fn oauth2_bad_provider(err: str) -> OAuthProvider {
    return OAuthProvider {
        ok: false, err: err, issuer: "", authorization_endpoint: "", token_endpoint: "",
        userinfo_endpoint: "", jwks_uri: "", revocation_endpoint: "", end_session_endpoint: "",
        id_token_algs: "", supports_s256: false, iss_parameter: false
    };
}

fn oauth2_json_list(doc: str, name: str) -> str {
    val v: str = json_get_safe(doc, name);
    var out: str = "";
    var i: i64 = 0;
    val n: i64 = json_len_safe(v);
    while str_equal(json_type_safe(v), "array") && i < n {
        if i > 0 { out = out + ","; }
        out = out + json_at_str(v, i);
        i = i + 1;
    }
    return out;
}

fn oauth2_https(u: str) -> bool {
    return str_starts_with(u, "https://");
}

/// Parse a discovery document fetched for `expected_issuer`: the issuer
/// must be exactly that value (OIDC Discovery §4.3) and every endpoint
/// HTTPS.
pub fn oauth2_parse_discovery(doc: str, expected_issuer: str) -> OAuthProvider {
    if !str_equal(json_type_safe(doc), "object") { return oauth2_bad_provider("not a JSON object"); }
    var p: OAuthProvider = oauth2_bad_provider("");
    p.issuer = json_get_str(doc, "issuer");
    if !str_equal(p.issuer, expected_issuer) { return oauth2_bad_provider("issuer mismatch"); }
    p.authorization_endpoint = json_get_str(doc, "authorization_endpoint");
    p.token_endpoint = json_get_str(doc, "token_endpoint");
    p.userinfo_endpoint = json_get_str(doc, "userinfo_endpoint");
    p.jwks_uri = json_get_str(doc, "jwks_uri");
    p.revocation_endpoint = json_get_str(doc, "revocation_endpoint");
    p.end_session_endpoint = json_get_str(doc, "end_session_endpoint");
    p.id_token_algs = oauth2_json_list(doc, "id_token_signing_alg_values_supported");
    p.supports_s256 = str_contains("," + oauth2_json_list(doc, "code_challenge_methods_supported") + ",", ",S256,");
    p.iss_parameter = json_get_bool(doc, "authorization_response_iss_parameter_supported", false);
    if !oauth2_https(p.issuer) || !oauth2_https(p.authorization_endpoint) || !oauth2_https(p.token_endpoint) || !oauth2_https(p.jwks_uri) {
        return oauth2_bad_provider("missing or non-https endpoint");
    }
    if str_len(p.id_token_algs) == 0 { p.id_token_algs = "RS256"; }
    p.ok = true;
    return p;
}

// ─── Authorization request and redirect (§4.1.1, §4.1.2) ───────────────

/// The URL to send the user's browser to. `nonce` and `challenge` are
/// left out when empty.
pub fn oauth2_authorize_url(p: & OAuthProvider, c: & OAuthClient, scope: str, state: str, nonce: str, challenge: str) -> str {
    var q: str = oauth2_param("response_type", "code");
    q = oauth2_add(q, "client_id", c.client_id);
    q = oauth2_add(q, "redirect_uri", c.redirect_uri);
    q = oauth2_add(q, "scope", scope);
    q = oauth2_add(q, "state", state);
    q = oauth2_add(q, "nonce", nonce);
    if str_len(challenge) > 0 {
        q = oauth2_add(q, "code_challenge", challenge);
        q = oauth2_add(q, "code_challenge_method", "S256");
    }
    var sep: str = "?";
    if str_contains(p.authorization_endpoint, "?") { sep = "&"; }
    return p.authorization_endpoint + sep + q;
}

/// Parse the redirect URL (its query; a fragment is ignored): checks the
/// state and, when present or required, the RFC 9207 iss parameter.
pub fn oauth2_parse_redirect(url: str, expected_state: str, p: & OAuthProvider) -> OAuthRedirect {
    var q: str = "";
    val at: i64 = str_find(url, "?");
    if at >= 0 { q = str_slice(url, at + 1, str_len(url)); }
    val hash: i64 = str_find(q, "#");
    if hash >= 0 { q = str_slice(q, 0, hash); }
    val state: str = oauth2_form_get(q, "state");
    if !str_equal(state, expected_state) || str_len(expected_state) == 0 {
        return OAuthRedirect { ok: false, err: "state mismatch", code: "", state: state };
    }
    if oauth2_form_has(q, "iss") || p.iss_parameter {
        if !str_equal(oauth2_form_get(q, "iss"), p.issuer) {
            return OAuthRedirect { ok: false, err: "issuer mismatch", code: "", state: state };
        }
    }
    if oauth2_form_has(q, "error") {
        var e: str = oauth2_form_get(q, "error");
        if oauth2_form_has(q, "error_description") { e = e + ": " + oauth2_form_get(q, "error_description"); }
        return OAuthRedirect { ok: false, err: e, code: "", state: state };
    }
    val code: str = oauth2_form_get(q, "code");
    if str_len(code) == 0 { return OAuthRedirect { ok: false, err: "no code", code: "", state: state }; }
    return OAuthRedirect { ok: true, err: "", code: code, state: state };
}

// ─── Token requests (§4.1.3, §6, §4.4; RFC 7523; RFC 7009) ─────────────

/// The HTTP Basic header value of §2.3.1 (id and secret form-encoded first).
pub fn oauth2_basic_auth(client_id: str, secret: str) -> str {
    return "Basic " + b64_encode_bytes(str_bytes(oauth2_form_encode(client_id) + ":" + oauth2_form_encode(secret)));
}

/// A client assertion JWT (RFC 7523 §3): iss = sub = client_id, aud = the
/// token endpoint, a jti and a 5-minute lifetime, signed with the client
/// secret (HS256) or the client's key.
pub fn oauth2_client_assertion(c: & OAuthClient, audience: str, jti: str, now: i64) -> str {
    val claims: str = "{\"iss\":" + json_string(c.client_id) + ",\"sub\":" + json_string(c.client_id)
        + ",\"aud\":" + json_string(audience) + ",\"jti\":" + json_string(jti)
        + ",\"iat\":" + int_to_str(now) + ",\"exp\":" + int_to_str(now + 300) + "}";
    if str_equal(c.auth, "client_secret_jwt") {
        val k: Jwk = jwk_oct(str_bytes(c.client_secret));
        return jwt_sign(claims, & k, "HS256");
    }
    return jwt_sign(claims, & c.key, c.alg);
}

fn oauth2_post(url: str, c: & OAuthClient, form: str, now: i64) -> OAuthHttpRequest {
    var body: str = form;
    var headers: str = "Content-Type: application/x-www-form-urlencoded\r\nAccept: application/json";
    if str_equal(c.auth, "client_secret_basic") {
        headers = headers + "\r\nAuthorization: " + oauth2_basic_auth(c.client_id, c.client_secret);
    } else if str_equal(c.auth, "client_secret_post") {
        body = oauth2_add(oauth2_add(body, "client_id", c.client_id), "client_secret", c.client_secret);
    } else if str_equal(c.auth, "client_secret_jwt") || str_equal(c.auth, "private_key_jwt") {
        body = oauth2_add(body, "client_assertion_type", "urn:ietf:params:oauth:client-assertion-type:jwt-bearer");
        body = oauth2_add(body, "client_assertion", oauth2_client_assertion(c, url, oauth2_random_token(16), now));
    } else {
        body = oauth2_add(body, "client_id", c.client_id);
    }
    return OAuthHttpRequest { method: "POST", url: url, headers: headers, body: body };
}

/// Exchange an authorization code (with its PKCE verifier, if any).
pub fn oauth2_code_request(p: & OAuthProvider, c: & OAuthClient, code: str, verifier: str, now: i64) -> OAuthHttpRequest {
    var f: str = oauth2_param("grant_type", "authorization_code");
    f = oauth2_add(f, "code", code);
    f = oauth2_add(f, "redirect_uri", c.redirect_uri);
    f = oauth2_add(f, "code_verifier", verifier);
    return oauth2_post(p.token_endpoint, c, f, now);
}

/// Refresh an access token (scope optional, at most the original).
pub fn oauth2_refresh_request(p: & OAuthProvider, c: & OAuthClient, refresh_token: str, scope: str, now: i64) -> OAuthHttpRequest {
    var f: str = oauth2_param("grant_type", "refresh_token");
    f = oauth2_add(f, "refresh_token", refresh_token);
    f = oauth2_add(f, "scope", scope);
    return oauth2_post(p.token_endpoint, c, f, now);
}

/// The client credentials grant.
pub fn oauth2_client_credentials_request(p: & OAuthProvider, c: & OAuthClient, scope: str, now: i64) -> OAuthHttpRequest {
    var f: str = oauth2_param("grant_type", "client_credentials");
    f = oauth2_add(f, "scope", scope);
    return oauth2_post(p.token_endpoint, c, f, now);
}

/// Revoke a token (RFC 7009 §2.1).
pub fn oauth2_revoke_request(p: & OAuthProvider, c: & OAuthClient, token: str, hint: str, now: i64) -> OAuthHttpRequest {
    var f: str = oauth2_param("token", token);
    f = oauth2_add(f, "token_type_hint", hint);
    return oauth2_post(p.revocation_endpoint, c, f, now);
}

/// A resource request with the access token (RFC 6750 §2.1).
pub fn oauth2_bearer_request(method: str, url: str, access_token: str) -> OAuthHttpRequest {
    return OAuthHttpRequest { method: method, url: url, headers: "Authorization: Bearer " + access_token, body: "" };
}

/// The UserInfo request (OIDC Core §5.3).
pub fn oidc_userinfo_request(p: & OAuthProvider, access_token: str) -> OAuthHttpRequest {
    return oauth2_bearer_request("GET", p.userinfo_endpoint, access_token);
}

fn oauth2_bad_token(err: str, desc: str) -> OAuthToken {
    return OAuthToken {
        ok: false, err: err, err_description: desc, access_token: "", token_type: "",
        expires_at: 0, refresh_token: "", scope: "", id_token: ""
    };
}

/// Parse a token endpoint response (§5.1, error §5.2). `expires_at` is
/// now + expires_in, or 0 when the server gave no lifetime.
pub fn oauth2_parse_token_response(status: i64, body: str, now: i64) -> OAuthToken {
    if !str_equal(json_type_safe(body), "object") { return oauth2_bad_token("invalid_response", "not a JSON object"); }
    if status != 200 || json_has(body, "error") {
        var e: str = json_get_str(body, "error");
        if str_len(e) == 0 { e = "http_" + int_to_str(status); }
        return oauth2_bad_token(e, json_get_str(body, "error_description"));
    }
    val at: str = json_get_str(body, "access_token");
    val tt: str = json_get_str(body, "token_type");
    if str_len(at) == 0 || str_len(tt) == 0 { return oauth2_bad_token("invalid_response", "missing access_token or token_type"); }
    var t: OAuthToken = oauth2_bad_token("", "");
    t.ok = true;
    t.access_token = at;
    t.token_type = tt;
    val ei: i64 = json_get_int(body, "expires_in", -1);
    if ei >= 0 { t.expires_at = now + ei; }
    t.refresh_token = json_get_str(body, "refresh_token");
    t.scope = json_get_str(body, "scope");
    t.id_token = json_get_str(body, "id_token");
    return t;
}

/// True when the token is a Bearer token (case-insensitive, §7.1) not
/// expiring within `margin` seconds.
pub fn oauth2_token_usable(t: & OAuthToken, now: i64, margin: i64) -> bool {
    if !t.ok || !str_equal(str_to_lower(t.token_type), "bearer") { return false; }
    return t.expires_at == 0 || now + margin < t.expires_at;
}

// ─── ID token validation (OIDC Core §3.1.3.7) ──────────────────────────

fn oidc_fail(err: str) -> OidcIdToken {
    return OidcIdToken { ok: false, err: err, sub: "", claims: "" };
}

/// at_hash / c_hash: base64url of the left half of the token's hash with
/// the hash of the ID token's algorithm (SHA-256 for *256, SHA-512 for
/// *512 and EdDSA).
pub fn oidc_half_hash(alg: str, token: str) -> str {
    var d: Vec<i64> = Vec::new();
    if str_ends_with(alg, "512") || str_equal(alg, "EdDSA") {
        d = sha512_bytes(str_bytes(token));
    } else {
        d = crypto_sha256_bytes(str_bytes(token));
    }
    var half: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < d.len() / 2 { half.push(d.get(i)); i = i + 1; }
    return jose_b64url_encode(half);
}

/// Validate an ID token: signature with a key of `keys` and an algorithm
/// the provider announced, iss, aud (and azp), exp/iat at `now` (60 s
/// leeway), the nonce sent in the request, and at_hash when an access
/// token is given and the token carries one. `max_age` < 0 skips the
/// auth_time check.
pub fn oidc_validate_id_token(id_token: str, keys: & Vec<Jwk>, p: & OAuthProvider, c: & OAuthClient, nonce: str, access_token: str, now: i64, max_age: i64) -> OidcIdToken {
    var o: JwtOptions = jwt_options(now, p.issuer, c.client_id);
    val r: JwtResult = jwt_verify_jwks(id_token, keys, p.id_token_algs, & o);
    if !r.ok { return oidc_fail(r.err); }
    val claims: str = r.claims;
    val sub: str = json_get_str(claims, "sub");
    if str_len(sub) == 0 { return oidc_fail("no sub claim"); }
    if !json_has(claims, "iat") { return oidc_fail("no iat claim"); }
    val aud: str = json_get_safe(claims, "aud");
    if str_equal(json_type_safe(aud), "array") && json_len_safe(aud) > 1 && !json_has(claims, "azp") {
        return oidc_fail("several audiences and no azp");
    }
    if json_has(claims, "azp") && !str_equal(json_get_str(claims, "azp"), c.client_id) { return oidc_fail("wrong azp"); }
    if str_len(nonce) > 0 && !str_equal(json_get_str(claims, "nonce"), nonce) { return oidc_fail("wrong nonce"); }
    if max_age >= 0 {
        val at: i64 = json_get_int(claims, "auth_time", -1);
        if at < 0 { return oidc_fail("no auth_time claim"); }
        if now > at + max_age + 60 { return oidc_fail("authentication too old"); }
    }
    if str_len(access_token) > 0 && json_has(claims, "at_hash") {
        val alg: str = json_get_str(r.header, "alg");
        if !str_equal(json_get_str(claims, "at_hash"), oidc_half_hash(alg, access_token)) { return oidc_fail("at_hash mismatch"); }
    }
    return OidcIdToken { ok: true, err: "", sub: sub, claims: claims };
}
