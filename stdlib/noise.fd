// Procedural noise â€” gradient (Perlin) noise, fBm fractal sums, and
// Poisson-disk sampling. Deterministic from a seed; no state tables
// beyond a per-call hash, so results are identical on every backend.
module noise;

use vec;
use math;

// --- hashing -----------------------------------------------------------------
// Integer lattice hash -> uniform [0,1). Deterministic splitmix-ish mix.

@wrapping
fn hash2(x: i64, y: i64, seed: i64) -> i64 {
    var h: i64 = x * 374761393 + y * 668265263 + seed * 974711;
    h = (h ^ (h >> 13)) * 1274126177;
    h = h ^ (h >> 16);
    return h & 0x3FFFFFFF;
}

@wrapping
fn hash3(x: i64, y: i64, z: i64, seed: i64) -> i64 {
    var h: i64 = x * 374761393 + y * 668265263 + z * 2246822519 + seed * 974711;
    h = (h ^ (h >> 13)) * 1274126177;
    h = h ^ (h >> 16);
    return h & 0x3FFFFFFF;
}

// fade(t) = 6t^5 - 15t^4 + 10t^3 (Ken Perlin's improved smootherstep)
fn fade(t: f64) -> f64 { return t * t * t * (t * (t * 6.0 - 15.0) + 10.0); }
fn lerp(a: f64, b: f64, t: f64) -> f64 { return a + t * (b - a); }

@wrapping
fn rng_next(r: i64) -> i64 {
    return (r * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFFFFFFFFFF;
}

fn floori(v: f64) -> i64 { return math_floor(v) as i64; }

// 2D gradient: one of 8 directions chosen by hash bits.
fn grad2(h: i64, dx: f64, dy: f64) -> f64 {
    var g: i64 = h & 7;
    if g == 0 { return dx + dy; }
    if g == 1 { return dx - dy; }
    if g == 2 { return 0.0 - dx + dy; }
    if g == 3 { return 0.0 - dx - dy; }
    if g == 4 { return dx; }
    if g == 5 { return 0.0 - dx; }
    if g == 6 { return dy; }
    return 0.0 - dy;
}

// --- Perlin noise --------------------------------------------------------------

/// Perlin noise at (x,y), roughly [-1,1]. Scale x,y by your feature size.
///
/// Example:
///   println(float_to_str(noise2(1.5, 2.5, 42)));
///   // same call, same output — noise is deterministic

pub fn noise2(x: f64, y: f64, seed: i64) -> f64 {
    var x0: i64 = floori(x);
    var y0: i64 = floori(y);
    var fx: f64 = x - x0;
    var fy: f64 = y - y0;
    var u: f64 = fade(fx);
    var v: f64 = fade(fy);
    var n00: f64 = grad2(hash2(x0, y0, seed), fx, fy);
    var n10: f64 = grad2(hash2(x0 + 1, y0, seed), fx - 1.0, fy);
    var n01: f64 = grad2(hash2(x0, y0 + 1, seed), fx, fy - 1.0);
    var n11: f64 = grad2(hash2(x0 + 1, y0 + 1, seed), fx - 1.0, fy - 1.0);
    return lerp(lerp(n00, n10, u), lerp(n01, n11, u), v);
}

fn grad3(h: i64, dx: f64, dy: f64, dz: f64) -> f64 {
    var g: i64 = h & 15;
    // 16 of the 32 edge-midpoint gradients (Perlin's cube edges)
    var u: f64 = dx;
    var v: f64 = dy;
    if g >= 8 { u = dy; v = dz; }
    if (g & 4) != 0 { v = dz; }
    if (g & 1) != 0 { u = 0.0 - u; }
    if (g & 2) != 0 { v = 0.0 - v; }
    return u + v;
}

/// Perlin noise at (x,y,z), roughly [-1,1].
pub fn noise3(x: f64, y: f64, z: f64, seed: i64) -> f64 {
    var x0: i64 = floori(x);
    var y0: i64 = floori(y);
    var z0: i64 = floori(z);
    var fx: f64 = x - x0;
    var fy: f64 = y - y0;
    var fz: f64 = z - z0;
    var u: f64 = fade(fx);
    var v: f64 = fade(fy);
    var w: f64 = fade(fz);
    var n000: f64 = grad3(hash3(x0,y0,z0,seed), fx, fy, fz);
    var n100: f64 = grad3(hash3(x0+1,y0,z0,seed), fx-1.0, fy, fz);
    var n010: f64 = grad3(hash3(x0,y0+1,z0,seed), fx, fy-1.0, fz);
    var n110: f64 = grad3(hash3(x0+1,y0+1,z0,seed), fx-1.0, fy-1.0, fz);
    var n001: f64 = grad3(hash3(x0,y0,z0+1,seed), fx, fy, fz-1.0);
    var n101: f64 = grad3(hash3(x0+1,y0,z0+1,seed), fx-1.0, fy, fz-1.0);
    var n011: f64 = grad3(hash3(x0,y0+1,z0+1,seed), fx, fy-1.0, fz-1.0);
    var n111: f64 = grad3(hash3(x0+1,y0+1,z0+1,seed), fx-1.0, fy-1.0, fz-1.0);
    var x00: f64 = lerp(n000, n100, u);
    var x10: f64 = lerp(n010, n110, u);
    var x01: f64 = lerp(n001, n101, u);
    var x11: f64 = lerp(n011, n111, u);
    return lerp(lerp(x00, x10, v), lerp(x01, x11, v), w);
}

/// fBm: `oct` octaves of noise2, each octave at 2x frequency and
/// `gain` amplitude. lacunarity is fixed at 2.
pub fn fbm2(x: f64, y: f64, oct: i64, gain: f64, seed: i64) -> f64 {
    var amp: f64 = 1.0;
    var f: f64 = 1.0;
    var sum: f64 = 0.0;
    var norm: f64 = 0.0;
    var i: i64 = 0;
    while i < oct {
        sum = sum + amp * noise2(x * f, y * f, seed + i * 131);
        norm = norm + amp;
        amp = amp * gain;
        f = f * 2.0;
        i = i + 1;
    }
    if norm == 0.0 { return 0.0; }
    return sum / norm;
}

/// fBm 3D, same contract.
pub fn fbm3(x: f64, y: f64, z: f64, oct: i64, gain: f64, seed: i64) -> f64 {
    var amp: f64 = 1.0;
    var f: f64 = 1.0;
    var sum: f64 = 0.0;
    var norm: f64 = 0.0;
    var i: i64 = 0;
    while i < oct {
        sum = sum + amp * noise3(x * f, y * f, z * f, seed + i * 131);
        norm = norm + amp;
        amp = amp * gain;
        f = f * 2.0;
        i = i + 1;
    }
    if norm == 0.0 { return 0.0; }
    return sum / norm;
}

// --- Poisson-disk sampling ------------------------------------------------------
// Bridson's algorithm on a w*h plane with min radius r. Cell grid in a
// Vec for O(1) neighbor checks. Output: [x0,y0,x1,y1,...] i64 pairs.

/// Poisson-disk points in a w x h rect with min spacing r. `tries` per
/// active point (30 is standard). seed randomizes the start + picks.
pub fn poisson2(w: i64, h: i64, r: i64, tries: i64, seed: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if r <= 0 || w <= 0 || h <= 0 { return out; }
    var cell: i64 = r * 7 / 10;               // r / sqrt(2)
    if cell < 1 { cell = 1; }
    var gw: i64 = (w + cell - 1) / cell;
    var gh: i64 = (h + cell - 1) / cell;
    var grid: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < gw * gh { grid.push(-1); i = i + 1; }
    var active: Vec<i64> = Vec::new();        // packed x*100000+y
    var r2: i64 = r * r;
    // first sample: center-ish, seeded
    var x0: i64 = (hash2(7, 3, seed) % 1000) * w / 1000;
    var y0: i64 = (hash2(11, 5, seed) % 1000) * h / 1000;
    out.push(x0); out.push(y0);
    active.push(x0 * 100000 + y0);
    grid.set((y0 / cell) * gw + x0 / cell, x0 * 100000 + y0);
    var rng: i64 = seed;
    while active.len() > 0 {
        rng = rng_next(rng);
        var ai: i64 = active.get((rng / 97) % active.len());
        var ax: i64 = ai / 100000;
        var ay: i64 = ai % 100000;
        var found: bool = false;
        var t: i64 = 0;
        while t < tries {
            rng = rng_next(rng);
            var ang: f64 = (rng % 6283) / 1000.0;
            var rad: f64 = r * (1.0 + ((rng / 7919) % 1000) / 999.0);
            var nx: i64 = ax + (rad * math_cos(ang)) as i64;
            var ny: i64 = ay + (rad * math_sin(ang)) as i64;
            if nx >= 0 && nx < w && ny >= 0 && ny < h {
                var ok: bool = true;
                var cx: i64 = nx / cell;
                var cy: i64 = ny / cell;
                var gy: i64 = cy - 2;
                while gy <= cy + 2 && ok {
                    var gx: i64 = cx - 2;
                    while gx <= cx + 2 && ok {
                        if gx >= 0 && gx < gw && gy >= 0 && gy < gh {
                            var o: i64 = grid.get(gy * gw + gx);
                            if o >= 0 {
                                var ox: i64 = o / 100000 - nx;
                                var oy: i64 = o % 100000 - ny;
                                if ox * ox + oy * oy < r2 { ok = false; }
                            }
                        }
                        gx = gx + 1;
                    }
                    gy = gy + 1;
                }
                if ok {
                    out.push(nx); out.push(ny);
                    active.push(nx * 100000 + ny);
                    grid.set((ny / cell) * gw + nx / cell, nx * 100000 + ny);
                    found = true;
                    t = tries;
                }
            }
            t = t + 1;
        }
        if !found {
            // remove ai from active (swap with last)
            var k: i64 = 0;
            var last: i64 = active.get(active.len() - 1);
            while k < active.len() {
                if active.get(k) == ai {
                    active.set(k, last);
                    active.pop();
                    k = active.len();
                }
                k = k + 1;
            }
        }
    }
    return out;
}
