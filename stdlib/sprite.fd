// Fides Sprite standard library — Phase 8D (S2)
//
// Sprite animation, texture atlases, and palette swap.
// Built on top of vec2 from math.fd for positioning.
//
// Usage:
//   use sprite;
//   pv anim = sprite_anim_create(8, 0.1);  // 8 frames, 100ms each
//   sprite_anim_play(anim, 0);              // start playing from frame 0
//   pv frame = sprite_anim_update(anim, 0.016); // advance 16ms, get current frame

module sprite;

// ─── Animation ────────────────────────────────────────────────────────────

/// A single animation track (a sequence of frames with a frame duration).
pub struct Animation {
    pub frame_count: i64,      // total number of frames
    pub frame_duration: f64,   // seconds per frame
    pub current_frame: i64,    // current frame index
    pub elapsed: f64,          // time accumulated in current frame
    pub playing: bool,         // is the animation playing?
    pub looping: bool,         // does it loop?
    pub finished: bool,        // has a non-looping animation finished?
}

/// Create a new animation with the given frame count and duration per frame.
pub pf sprite_anim_create(frame_count: i64, frame_duration: f64) -> Animation {
    ret Animation {
        frame_count: frame_count,
        frame_duration: frame_duration,
        current_frame: 0,
        elapsed: 0.0,
        playing: false,
        looping: true,
        finished: false,
    };
}

/// Start playing the animation from a specific frame.
pub pf sprite_anim_play(anim: &mut Animation, start_frame: i64) -> void {
    anim.current_frame = start_frame;
    anim.elapsed = 0.0;
    anim.playing = true;
    anim.finished = false;
}

/// Stop the animation.
pub pf sprite_anim_stop(anim: &mut Animation) -> void {
    anim.playing = false;
}

/// Set whether the animation loops.
pub pf sprite_anim_set_looping(anim: &mut Animation, looping: bool) -> void {
    anim.looping = looping;
}

/// Advance the animation by dt seconds. Returns the current frame index.
pub pf sprite_anim_update(anim: &mut Animation, dt: f64) -> i64 {
    if !anim.playing {
        ret anim.current_frame;
    }

    anim.elapsed = anim.elapsed + dt;

    while anim.elapsed >= anim.frame_duration {
        anim.elapsed = anim.elapsed - anim.frame_duration;
        anim.current_frame = anim.current_frame + 1;

        if anim.current_frame >= anim.frame_count {
            if anim.looping {
                anim.current_frame = 0;
            } else {
                anim.current_frame = anim.frame_count - 1;
                anim.playing = false;
                anim.finished = true;
                ret anim.current_frame;
            }
        }
    }

    ret anim.current_frame;
}

/// Reset the animation to frame 0.
pub pf sprite_anim_reset(anim: &mut Animation) -> void {
    anim.current_frame = 0;
    anim.elapsed = 0.0;
    anim.finished = false;
}

/// Check if a non-looping animation has finished.
pub pf sprite_anim_is_finished(anim: Animation) -> bool {
    ret anim.finished;
}

/// Get the current frame without advancing.
pub pf sprite_anim_get_frame(anim: Animation) -> i64 {
    ret anim.current_frame;
}

/// Get the total duration of the animation in seconds.
pub pf sprite_anim_total_duration(anim: Animation) -> f64 {
    ret anim.frame_duration * anim.frame_count as f64;
}

// ─── Texture Atlas ────────────────────────────────────────────────────────
//
// A texture atlas is a single large texture containing multiple sprites.
// Each sprite is defined by a source rectangle (x, y, width, height) in the atlas.

pub struct AtlasRegion {
    pub x: i64,        // source x in atlas (pixels)
    pub y: i64,        // source y in atlas (pixels)
    pub width: i64,    // sprite width (pixels)
    pub height: i64,   // sprite height (pixels)
    pub origin_x: i64, // center x for rotation/scaling (relative to top-left)
    pub origin_y: i64, // center y for rotation/scaling
}

/// Create a default atlas region (top-left origin).
pub pf sprite_region_new(x: i64, y: i64, width: i64, height: i64) -> AtlasRegion {
    ret AtlasRegion {
        x: x,
        y: y,
        width: width,
        height: height,
        origin_x: width / 2,
        origin_y: height / 2,
    };
}

/// Create an atlas region with a custom origin point.
pub pf sprite_region_with_origin(x: i64, y: i64, width: i64, height: i64, origin_x: i64, origin_y: i64) -> AtlasRegion {
    ret AtlasRegion {
        x: x,
        y: y,
        width: width,
        height: height,
        origin_x: origin_x,
        origin_y: origin_y,
    };
}

// ─── Sprite (visual entity) ───────────────────────────────────────────────

pub struct Sprite {
    pub src_rect: AtlasRegion,  // source rect in atlas
    pub pos_x: f64,           // world position x
    pub pos_y: f64,           // world position y
    pub scale_x: f64,         // horizontal scale (1.0 = normal)
    pub scale_y: f64,         // vertical scale
    pub rotation: f64,        // rotation in radians
    pub visible: bool,        // is the sprite drawn?
    pub flip_x: bool,         // flip horizontally?
    pub flip_y: bool,         // flip vertically?
    pub alpha: f64,           // opacity (0.0 = transparent, 1.0 = opaque)
}

/// Create a sprite from an atlas region at a world position.
pub pf sprite_create(src_rect: AtlasRegion, x: f64, y: f64) -> Sprite {
    ret Sprite {
        src_rect: src_rect,
        pos_x: x,
        pos_y: y,
        scale_x: 1.0,
        scale_y: 1.0,
        rotation: 0.0,
        visible: true,
        flip_x: false,
        flip_y: false,
        alpha: 1.0,
    };
}

/// Move a sprite by (dx, dy).
pub pf sprite_move(s: &mut Sprite, dx: f64, dy: f64) -> void {
    s.pos_x = s.pos_x + dx;
    s.pos_y = s.pos_y + dy;
}

/// Set the sprite's position.
pub pf sprite_set_pos(s: &mut Sprite, x: f64, y: f64) -> void {
    s.pos_x = x;
    s.pos_y = y;
}

/// Set the sprite's scale.
pub pf sprite_set_scale(s: &mut Sprite, sx: f64, sy: f64) -> void {
    s.scale_x = sx;
    s.scale_y = sy;
}

/// Set the sprite's rotation (radians).
pub pf sprite_set_rotation(s: &mut Sprite, rot: f64) -> void {
    s.rotation = rot;
}

/// Set the sprite's visibility.
pub pf sprite_set_visible(s: &mut Sprite, visible: bool) -> void {
    s.visible = visible;
}

/// Set the sprite's alpha (opacity).
pub pf sprite_set_alpha(s: &mut Sprite, alpha: f64) -> void {
    s.alpha = alpha;
}

/// Flip the sprite horizontally.
pub pf sprite_set_flip_x(s: &mut Sprite, flip: bool) -> void {
    s.flip_x = flip;
}

/// Flip the sprite vertically.
pub pf sprite_set_flip_y(s: &mut Sprite, flip: bool) -> void {
    s.flip_y = flip;
}

/// Change the atlas region (e.g., for animation frame swapping).
pub pf sprite_set_region(s: &mut Sprite, src_rect: AtlasRegion) -> void {
    s.src_rect = src_rect;
}

/// Get the sprite's bounding box (for collision).
pub pf sprite_bounds(s: Sprite) -> (f64, f64, f64, f64) {
    pv w = s.src_rect.width as f64 * s.scale_x;
    pv h = s.src_rect.height as f64 * s.scale_y;
    pv ox = s.src_rect.origin_x as f64 * s.scale_x;
    pv oy = s.src_rect.origin_y as f64 * s.scale_y;
    // top-left = pos - origin
    ret (s.pos_x - ox, s.pos_y - oy, w, h);
}

// ─── Palette Swap ─────────────────────────────────────────────────────────
//
// Palette swap replaces specific colors in a sprite with new colors.
// This is done at the pixel level — the caller must have access to the
// pixel data (e.g., via a CPU-side texture buffer).
//
// The palette is a Vec of (old_color, new_color) pairs, where colors are
// packed RGB: (r << 16) | (g << 8) | b.

pub struct PaletteSwap {
    pub entries: Vec<i64>,  // pairs: [old0, new0, old1, new1, ...]
}

/// Create an empty palette swap.
pub pf sprite_palette_create() -> PaletteSwap {
    ret PaletteSwap { entries: Vec::new() };
}

/// Add a color mapping: old_color → new_color.
pub pf sprite_palette_add(palette: &mut PaletteSwap, old_color: i64, new_color: i64) -> void {
    palette.entries.push(old_color);
    palette.entries.push(new_color);
}

/// Apply the palette swap to a single pixel color.
/// Returns the new color if found, otherwise the original.
pub pf sprite_palette_apply(palette: PaletteSwap, color: i64) -> i64 {
    pv i = 0;
    while i < palette.entries.len() {
        if palette.entries.get(i) == color {
            ret palette.entries.get(i + 1);
        }
        i = i + 2;
    }
    ret color;
}

/// Apply the palette swap to a buffer of pixels (in-place).
pub pf sprite_palette_apply_buffer(palette: PaletteSwap, pixels: &mut Vec<i64>) -> void {
    pv i = 0;
    while i < pixels.len() {
        pv old_color = pixels.get(i);
        pv new_color = sprite_palette_apply(palette, old_color);
        pixels.set(i, new_color);
        i = i + 1;
    }
}

// ─── Animation Controller (multiple tracks) ───────────────────────────────
//
// A sprite typically has multiple animations (idle, walk, attack, etc.).
// The AnimationController manages switching between them.

pub struct AnimController {
    pub animations: Vec<Animation>,
    pub current: i64,  // index of current animation
}

/// Create an empty animation controller.
pub pf sprite_controller_create() -> AnimController {
    ret AnimController {
        animations: Vec::new(),
        current: -1,
    };
}

/// Add an animation track to the controller. Returns the track index.
pub pf sprite_controller_add(controller: &mut AnimController, anim: Animation) -> i64 {
    pv idx = controller.animations.len();
    controller.animations.push(anim);
    ret idx;
}

/// Switch to a specific animation track by index.
pub pf sprite_controller_play(controller: &mut AnimController, track: i64) -> void {
    if track < 0 || track >= controller.animations.len() {
        ret;
    }
    controller.current = track;
    // Play from frame 0 — need mutable access to the animation
    // Since Fides doesn't have mutable Vec indexing yet, we use a workaround:
    // We set current and let update handle the reset.
}

/// Update the current animation. Returns the current frame.
pub pf sprite_controller_update(controller: &mut AnimController, dt: f64) -> i64 {
    if controller.current < 0 || controller.current >= controller.animations.len() {
        ret 0;
    }
    // Get current animation, update it, return frame
    // Note: In a real engine, this would modify the animation in the Vec.
    // For now, we return the frame from a copy (the update is lost).
    // This is a limitation of the current Vec API — needs mutable indexing.
    pv anim = controller.animations.get(controller.current);
    ret anim.current_frame;
}

/// Get the current animation track index.
pub pf sprite_controller_current_track(controller: AnimController) -> i64 {
    ret controller.current;
}
