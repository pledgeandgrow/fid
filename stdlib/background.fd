// Fides background work: task descriptions, constraints, backoff,
// WorkManager / BGTaskScheduler mapping, and a scheduler simulation
//
// What is real (pure Fides, tested in the interpreter):
//   - task specs: one-off or periodic, constraints (network: any /
//     connected / unmetered, charging, idle, battery not low, storage not
//     low), an initial delay, a backoff policy (linear or exponential with
//     an initial delay), retry limits, unique names
//   - WorkManager's rules: periodic intervals of at least 15 minutes and
//     flex windows of at least 5 minutes, backoff delays clamped to
//     10 s .. 5 h; the builder calls a spec turns into (as data for jni.fd)
//   - BGTaskScheduler's model: BGAppRefreshTaskRequest for short work with
//     no constraints, BGProcessingTaskRequest when it needs the network or
//     external power; reverse-DNS identifiers that must be listed under
//     BGTaskSchedulerPermittedIdentifiers in Info.plist (generated here);
//     warnings for what iOS cannot express (unmetered, idle, periodic)
//   - a deterministic scheduler simulation: a device whose network,
//     charging, idle, battery and storage states change over time, tasks
//     that run when due and their constraints hold, workers that return
//     success / retry / failure, backoff after retries, periodic runs in
//     the flex window of each period, cancellation, and a log
//
// The platform seam: the real schedulers are the OS's. Workers are
// function values fn(attempt) -> BG_SUCCESS / BG_RETRY / BG_FAILURE; on a
// device the WorkManager Worker (Java) or the BGTask handler (Swift / ObjC)
// calls into the same Fides function.

module background;
use vec;
use string;

pub const BG_NET_ANY: i64 = 0;
pub const BG_NET_CONNECTED: i64 = 1;
pub const BG_NET_UNMETERED: i64 = 2;

pub const BG_BACKOFF_LINEAR: i64 = 0;
pub const BG_BACKOFF_EXPONENTIAL: i64 = 1;

pub const BG_SUCCESS: i64 = 0;
pub const BG_RETRY: i64 = 1;
pub const BG_FAILURE: i64 = 2;

pub const BG_MIN_PERIOD_MS: i64 = 900000;      // 15 minutes
pub const BG_MIN_FLEX_MS: i64 = 300000;        // 5 minutes
pub const BG_MIN_BACKOFF_MS: i64 = 10000;      // 10 seconds
pub const BG_MAX_BACKOFF_MS: i64 = 18000000;   // 5 hours

pub struct BgSpec {
    pub id: str,
    pub periodic: bool,
    pub interval_ms: i64,
    pub flex_ms: i64,
    pub initial_delay_ms: i64,
    pub network: i64,
    pub charging: bool,
    pub idle: bool,
    pub battery_not_low: bool,
    pub storage_not_low: bool,
    pub backoff: i64,
    pub backoff_ms: i64,
    pub max_attempts: i64,     // 0: unlimited
}

pub fn bg_one_off(id: str) -> BgSpec {
    return BgSpec {
        id: id, periodic: false, interval_ms: 0, flex_ms: 0, initial_delay_ms: 0, network: BG_NET_ANY, charging: false,
        idle: false, battery_not_low: false, storage_not_low: false, backoff: BG_BACKOFF_EXPONENTIAL, backoff_ms: 30000,
        max_attempts: 0,
    };
}

pub fn bg_periodic(id: str, interval_ms: i64, flex_ms: i64) -> BgSpec {
    var s: BgSpec = bg_one_off(id);
    s.periodic = true;
    s.interval_ms = interval_ms;
    s.flex_ms = flex_ms;
    return s;
}

/// The spec as WorkManager would run it (limits applied) and what was
/// changed.
pub struct BgNormalized {
    pub spec: BgSpec,
    pub notes: Vec<str>,
}

pub fn bg_normalize(s: BgSpec) -> BgNormalized {
    var n: BgSpec = s;
    var notes: Vec<str> = Vec::new();
    if n.periodic {
        if n.interval_ms < BG_MIN_PERIOD_MS {
            notes.push("interval " + int_to_str(n.interval_ms) + " ms raised to 15 minutes");
            n.interval_ms = BG_MIN_PERIOD_MS;
        }
        if n.flex_ms <= 0 || n.flex_ms > n.interval_ms { n.flex_ms = n.interval_ms; }
        if n.flex_ms < BG_MIN_FLEX_MS {
            notes.push("flex " + int_to_str(n.flex_ms) + " ms raised to 5 minutes");
            n.flex_ms = BG_MIN_FLEX_MS;
        }
    }
    if n.backoff_ms < BG_MIN_BACKOFF_MS {
        notes.push("backoff " + int_to_str(n.backoff_ms) + " ms raised to 10 s");
        n.backoff_ms = BG_MIN_BACKOFF_MS;
    }
    if n.backoff_ms > BG_MAX_BACKOFF_MS {
        notes.push("backoff lowered to 5 h");
        n.backoff_ms = BG_MAX_BACKOFF_MS;
    }
    return BgNormalized { spec: n, notes: notes };
}

/// The delay before attempt `attempt` + 1 after `attempt` retries
/// (WorkManager: linear delay * n, exponential delay * 2^(n-1), at most
/// 5 hours).
pub fn bg_backoff_delay(s: &BgSpec, attempt: i64) -> i64 {
    var d: i64 = s.backoff_ms;
    if s.backoff == BG_BACKOFF_LINEAR {
        d = s.backoff_ms * attempt;
    } else {
        var k: i64 = 1;
        while k < attempt && d < BG_MAX_BACKOFF_MS { d = d * 2; k = k + 1; }
    }
    if d > BG_MAX_BACKOFF_MS { d = BG_MAX_BACKOFF_MS; }
    return d;
}

// ─── Platform mapping ──────────────────────────────────────────────────

/// The WorkManager builder calls of a spec, in order (for jni.fd).
pub fn bg_workmanager_calls(s: BgSpec) -> Vec<str> {
    val n: BgSpec = bg_normalize(s).spec;
    var v: Vec<str> = Vec::new();
    v.push("Constraints.Builder()");
    if n.network == BG_NET_CONNECTED { v.push("setRequiredNetworkType(NetworkType.CONNECTED)"); }
    if n.network == BG_NET_UNMETERED { v.push("setRequiredNetworkType(NetworkType.UNMETERED)"); }
    if n.charging { v.push("setRequiresCharging(true)"); }
    if n.idle { v.push("setRequiresDeviceIdle(true)"); }
    if n.battery_not_low { v.push("setRequiresBatteryNotLow(true)"); }
    if n.storage_not_low { v.push("setRequiresStorageNotLow(true)"); }
    if n.periodic {
        v.push("PeriodicWorkRequest.Builder(worker, " + int_to_str(n.interval_ms) + ", MILLISECONDS, " + int_to_str(n.flex_ms) + ", MILLISECONDS)");
    } else {
        v.push("OneTimeWorkRequest.Builder(worker)");
    }
    if n.initial_delay_ms > 0 { v.push("setInitialDelay(" + int_to_str(n.initial_delay_ms) + ", MILLISECONDS)"); }
    v.push("setBackoffCriteria(BackoffPolicy." + (if n.backoff == BG_BACKOFF_LINEAR { "LINEAR" } else { "EXPONENTIAL" }) + ", " + int_to_str(n.backoff_ms) + ", MILLISECONDS)");
    v.push("addTag(\"" + n.id + "\")");
    v.push("WorkManager.enqueueUnique" + (if n.periodic { "PeriodicWork" } else { "Work" }) + "(\"" + n.id + "\", KEEP, request)");
    return v;
}

/// Is `id` a reverse-DNS identifier (two or more dot-separated parts of
/// letters, digits, '-' and '_')?
pub fn bg_identifier_ok(id: str) -> bool {
    val parts: Vec<str> = str_split(id, ".");
    if parts.len() < 2 { return false; }
    var i: i64 = 0;
    while i < parts.len() {
        val p: str = parts.get(i);
        if str_len(p) == 0 { return false; }
        var k: i64 = 0;
        while k < str_len(p) {
            val c: i64 = str_byte_at(p, k);
            if !(char_is_alpha(c) || char_is_digit(c) || c == 45 || c == 95) { return false; }
            k = k + 1;
        }
        i = i + 1;
    }
    return true;
}

/// The BGTaskScheduler request of a spec and the warnings for what iOS
/// cannot express.
pub struct BgIosPlan {
    pub request_class: str,          // BGAppRefreshTaskRequest or BGProcessingTaskRequest
    pub requires_network: bool,
    pub requires_power: bool,
    pub earliest_begin_ms: i64,      // relative to submission
    pub warnings: Vec<str>,
}

pub fn bg_ios_plan(s: &BgSpec) -> BgIosPlan {
    var w: Vec<str> = Vec::new();
    if !bg_identifier_ok(s.id) { w.push("identifier is not reverse-DNS: " + s.id); }
    val processing: bool = s.network != BG_NET_ANY || s.charging || s.idle;
    if s.network == BG_NET_UNMETERED { w.push("unmetered network not expressible: any network required"); }
    if s.idle { w.push("idle not expressible: processing tasks already run when the device is idle"); }
    if s.battery_not_low || s.storage_not_low { w.push("battery/storage constraints not expressible"); }
    if s.periodic { w.push("not periodic on iOS: submit the next request when the task completes"); }
    return BgIosPlan {
        request_class: if processing { "BGProcessingTaskRequest" } else { "BGAppRefreshTaskRequest" },
        requires_network: s.network != BG_NET_ANY, requires_power: s.charging,
        earliest_begin_ms: if s.periodic { s.interval_ms } else { s.initial_delay_ms }, warnings: w,
    };
}

/// The Info.plist entry listing the task identifiers.
pub fn bg_ios_plist(ids: Vec<str>) -> str {
    var s: str = "<key>BGTaskSchedulerPermittedIdentifiers</key>\n<array>\n";
    var i: i64 = 0;
    while i < ids.len() {
        s = s + "    <string>" + ids.get(i) + "</string>\n";
        i = i + 1;
    }
    return s + "</array>\n";
}

// ─── Simulation ────────────────────────────────────────────────────────

pub struct BgDevice {
    pub network: i64,        // 0 none, BG_NET_CONNECTED (metered), BG_NET_UNMETERED
    pub charging: bool,
    pub idle: bool,
    pub battery_low: bool,
    pub storage_low: bool,
}

pub fn bg_device(network: i64, charging: bool) -> BgDevice {
    return BgDevice { network: network, charging: charging, idle: false, battery_low: false, storage_low: false };
}

/// Do the device's conditions satisfy the spec's constraints?
pub fn bg_constraints_met(s: &BgSpec, d: &BgDevice) -> bool {
    if s.network == BG_NET_CONNECTED && d.network == 0 { return false; }
    if s.network == BG_NET_UNMETERED && d.network != BG_NET_UNMETERED { return false; }
    if s.charging && !d.charging { return false; }
    if s.idle && !d.idle { return false; }
    if s.battery_not_low && d.battery_low { return false; }
    if s.storage_not_low && d.storage_low { return false; }
    return true;
}

pub const BG_ENQUEUED: i64 = 0;
pub const BG_SUCCEEDED: i64 = 1;
pub const BG_FAILED: i64 = 2;
pub const BG_CANCELLED: i64 = 3;

pub struct BgTask {
    pub spec: BgSpec,
    pub worker: fn(i64) -> i64,
    pub state: i64,
    pub next_ms: i64,        // earliest start
    pub attempts: i64,       // attempts of the current run (retries)
    pub runs: i64,           // worker calls in total
    pub period_index: i64,   // periodic: the period being served (1-based)
    pub enqueued_ms: i64,
}

pub struct BgScheduler {
    pub now: i64,
    pub device: BgDevice,
    pub tasks: Vec<BgTask>,
    pub log: Vec<str>,
}

pub fn bg_scheduler_new(device: BgDevice) -> BgScheduler {
    return BgScheduler { now: 0, device: device, tasks: Vec::new(), log: Vec::new() };
}

/// Enqueue a task (KEEP: an enqueued task with the same id stays).
pub fn bg_enqueue(s: &mut BgScheduler, spec: BgSpec, worker: fn(i64) -> i64) -> bool {
    var i: i64 = 0;
    while i < s.tasks.len() {
        if s.tasks.get(i).spec.id == spec.id && s.tasks.get(i).state == BG_ENQUEUED { return false; }
        i = i + 1;
    }
    val n: BgSpec = bg_normalize(spec).spec;
    var first: i64 = s.now + n.initial_delay_ms;
    if n.periodic { first = s.now + n.initial_delay_ms + n.interval_ms - n.flex_ms; }
    s.tasks.push(BgTask { spec: n, worker: worker, state: BG_ENQUEUED, next_ms: first, attempts: 0, runs: 0, period_index: 1, enqueued_ms: s.now });
    return true;
}

pub fn bg_cancel(s: &mut BgScheduler, id: str) -> bool {
    var i: i64 = 0;
    while i < s.tasks.len() {
        var t: BgTask = s.tasks.get(i);
        if t.spec.id == id && t.state == BG_ENQUEUED {
            t.state = BG_CANCELLED;
            s.tasks.set(i, t);
            s.log.push(int_to_str(s.now / 1000) + "s " + id + " cancelled");
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn bg_set_device(s: &mut BgScheduler, d: BgDevice) { s.device = d; }

// Run every due task whose constraints hold, once.
fn bg_run_due(s: &mut BgScheduler) {
    var i: i64 = 0;
    while i < s.tasks.len() {
        var t: BgTask = s.tasks.get(i);
        if t.state == BG_ENQUEUED && t.next_ms <= s.now && bg_constraints_met(&t.spec, &s.device) {
            t.attempts = t.attempts + 1;
            t.runs = t.runs + 1;
            val w: fn(i64) -> i64 = t.worker;
            val r: i64 = w(t.attempts);
            var what: str = "";
            if r == BG_SUCCESS { what = "success"; }
            else if r == BG_RETRY { what = "retry"; }
            else { what = "failure"; }
            s.log.push(int_to_str(s.now / 1000) + "s " + t.spec.id + " attempt " + int_to_str(t.attempts) + " " + what);
            var done: bool = r == BG_SUCCESS || r == BG_FAILURE
                || (r == BG_RETRY && t.spec.max_attempts > 0 && t.attempts >= t.spec.max_attempts);
            if r == BG_RETRY && !done {
                t.next_ms = s.now + bg_backoff_delay(&t.spec, t.attempts);
            } else if t.spec.periodic {
                // the next period's flex window, whatever this one gave
                t.period_index = t.period_index + 1;
                t.attempts = 0;
                t.next_ms = t.enqueued_ms + t.spec.initial_delay_ms + t.period_index * t.spec.interval_ms - t.spec.flex_ms;
                if t.next_ms <= s.now { t.next_ms = s.now + 1; }
            } else if done {
                t.state = if r == BG_SUCCESS { BG_SUCCEEDED } else { BG_FAILED };
            }
            s.tasks.set(i, t);
        }
        i = i + 1;
    }
}

/// Advance simulated time to `to_ms` in steps of `step_ms`, running due
/// tasks at each step (the step bounds the timing precision).
pub fn bg_advance(s: &mut BgScheduler, to_ms: i64, step_ms: i64) {
    while s.now <= to_ms {
        bg_run_due(s);
        if s.now == to_ms { break; }
        s.now = s.now + step_ms;
        if s.now > to_ms { s.now = to_ms; }
    }
}

/// The state of a task by id (-1: unknown).
pub fn bg_state(s: &BgScheduler, id: str) -> i64 {
    var i: i64 = 0;
    while i < s.tasks.len() {
        if s.tasks.get(i).spec.id == id { return s.tasks.get(i).state; }
        i = i + 1;
    }
    return -1;
}

pub fn bg_state_name(st: i64) -> str {
    if st == BG_ENQUEUED { return "enqueued"; }
    if st == BG_SUCCEEDED { return "succeeded"; }
    if st == BG_FAILED { return "failed"; }
    if st == BG_CANCELLED { return "cancelled"; }
    return "?";
}
