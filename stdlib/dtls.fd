// Fides DTLS 1.2 (RFC 6347) client and server for WebRTC: ECDHE-ECDSA
// with AES-128-GCM over P-256, DTLS-SRTP keying (RFC 5764).
//
// Real (pure computation):
//   - record layer: content type, version FE FD, epoch, 48-bit sequence
//     number per epoch, several records per datagram; epoch 0 in the
//     clear, epoch 1 under TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
//     (RFC 5288: 4-byte implicit IV || 8-byte explicit nonce = epoch and
//     sequence number, AAD = seq64 || type || version || length); a
//     64-record replay window per epoch; records of the next epoch that
//     arrive before the ChangeCipherSpec are kept and replayed after it;
//     bad records are dropped silently (RFC 6347 §4.1.2.7);
//   - handshake layer: the 12-byte DTLS handshake header, messages split
//     into fragments that fit the MTU and reassembled from fragments in
//     any order (overlaps allowed), processed strictly by message_seq; the
//     transcript hashes the messages as if unfragmented;
//   - flights and retransmission (§4.2.4): every flight is kept; the
//     timer (initial 1 s, doubled up to 60 s, given up after 8 tries) is
//     driven by the caller's clock (`now` in milliseconds); a peer's
//     retransmitted flight makes us resend ours; the server's last flight
//     is resent only on demand, as the RFC says;
//   - HelloVerifyRequest cookie exchange (§4.2.1): the server answers a
//     ClientHello without a valid cookie with a stateless cookie
//     (HMAC-SHA256 over the peer address and the client random);
//   - the full handshake with mutual authentication (what WebRTC does):
//     ClientHello, ServerHello, Certificate, ServerKeyExchange (named
//     curve secp256r1, signed with ecdsa_secp256r1_sha256),
//     CertificateRequest, ServerHelloDone; client Certificate,
//     ClientKeyExchange, CertificateVerify, ChangeCipherSpec, Finished;
//     server ChangeCipherSpec, Finished; fatal alerts on failure,
//     close_notify;
//   - the TLS 1.2 PRF with SHA-256 (RFC 5246 §5), the extended master
//     secret (RFC 7627), the key block, Finished verify_data, the RFC 5705
//     exporter and the DTLS-SRTP keying material (RFC 5764 §4.2: client
//     key, server key, client salt, server salt);
//   - extensions: supported_groups, ec_point_formats,
//     signature_algorithms, extended_master_secret, use_srtp (profile
//     negotiation, no MKI), renegotiation_info (empty: no renegotiation);
//   - certificates through x509.fd: the peer's certificate must carry a
//     P-256 key and its SHA-256 fingerprint must equal the one the remote
//     SDP announced ("sha-256 AB:CD:..."), as WebRTC checks self-signed
//     certificates; no chain or name validation.
//
// The seam: no sockets and no clock. The caller feeds received datagrams
// (dtls_receive), calls dtls_poll with the time, and sends what
// dtls_drain hands back. Entropy comes from DtlsConfig.seed (32 bytes;
// dtls_config fills it from crypto_random_bytes, the OS generator), run
// through an HMAC-SHA256 generator; ECDSA nonces are RFC 6979 ones.
//
// Not done: resumption, renegotiation, other cipher suites or curves,
// DTLS 1.0 and 1.3, connection IDs, PMTU discovery (the MTU is given).
//
// Checked in tests/bootstrap/test_std_dtls.fd: the TLS 1.2 PRF vector,
// OpenSSL's fingerprint of an OpenSSL-made certificate, and a client and
// a server in memory over a channel that drops and reorders datagrams,
// with 100- and 200-byte MTUs, ending with equal SRTP keys on both sides.
// Checked once by hand against OpenSSL 3.5.4 (s_server and s_client
// -dtls1_2 on loopback UDP through a relay; not a repository test): both
// roles, the cookie exchange, mutual certificates, extended master
// secret, all three SRTP profiles, application data both ways, and
// OpenSSL's exported EXTRACTOR-dtls_srtp keying material equal to ours.
//
// Usage:
//   use dtls;
//   var cfg: DtlsConfig = dtls_config(false, cert_pem, key_pem, remote_fp);
//   var c: DtlsConn = dtls_new(cfg);
//   dtls_start(& mut c, now);
//   loop: send each of dtls_drain(& mut c); dtls_receive(& mut c, dg, now);
//         dtls_poll(& mut c, now);
//   if c.state == DTLS_CONNECTED { val k: DtlsSrtpKeys = dtls_srtp_keys(& c); }
module dtls;
use vec;
use string;
use aes_gcm;
use crypto;
use ecdsa;
use kdf;
use pem;
use srtp;
use x509;

pub const DTLS_NEW: i64 = 0;
pub const DTLS_CONNECTING: i64 = 1;
pub const DTLS_CONNECTED: i64 = 2;
pub const DTLS_FAILED: i64 = 3;
pub const DTLS_CLOSED: i64 = 4;

pub const DTLS_CT_CCS: i64 = 20;
pub const DTLS_CT_ALERT: i64 = 21;
pub const DTLS_CT_HANDSHAKE: i64 = 22;
pub const DTLS_CT_APP: i64 = 23;

pub const DTLS_HS_CLIENT_HELLO: i64 = 1;
pub const DTLS_HS_SERVER_HELLO: i64 = 2;
pub const DTLS_HS_HELLO_VERIFY: i64 = 3;
pub const DTLS_HS_CERTIFICATE: i64 = 11;
pub const DTLS_HS_SERVER_KEY_EXCHANGE: i64 = 12;
pub const DTLS_HS_CERTIFICATE_REQUEST: i64 = 13;
pub const DTLS_HS_SERVER_HELLO_DONE: i64 = 14;
pub const DTLS_HS_CERTIFICATE_VERIFY: i64 = 15;
pub const DTLS_HS_CLIENT_KEY_EXCHANGE: i64 = 16;
pub const DTLS_HS_FINISHED: i64 = 20;

pub const DTLS_ALERT_CLOSE_NOTIFY: i64 = 0;
pub const DTLS_ALERT_UNEXPECTED_MESSAGE: i64 = 10;
pub const DTLS_ALERT_HANDSHAKE_FAILURE: i64 = 40;
pub const DTLS_ALERT_BAD_CERTIFICATE: i64 = 42;
pub const DTLS_ALERT_ILLEGAL_PARAMETER: i64 = 47;
pub const DTLS_ALERT_DECODE_ERROR: i64 = 50;
pub const DTLS_ALERT_DECRYPT_ERROR: i64 = 51;
pub const DTLS_ALERT_PROTOCOL_VERSION: i64 = 70;

/// TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
pub const DTLS_SUITE: i64 = 49195;

const DTL_EXT_GROUPS: i64 = 10;
const DTL_EXT_POINT_FORMATS: i64 = 11;
const DTL_EXT_SIG_ALGS: i64 = 13;
const DTL_EXT_USE_SRTP: i64 = 14;
const DTL_EXT_EMS: i64 = 23;
const DTL_EXT_RENEG: i64 = 65281;

const DTL_SECP256R1: i64 = 23;
const DTL_ECDSA_SHA256: i64 = 1027;

// handshake states
const DTL_C_WAIT_SH: i64 = 1;
const DTL_C_WAIT_CERT: i64 = 2;
const DTL_C_WAIT_SKE: i64 = 3;
const DTL_C_WAIT_SHD: i64 = 4;
const DTL_C_WAIT_CCS: i64 = 5;
const DTL_C_WAIT_FIN: i64 = 6;
const DTL_S_WAIT_CH: i64 = 10;
const DTL_S_WAIT_CERT: i64 = 11;
const DTL_S_WAIT_CKE: i64 = 12;
const DTL_S_WAIT_CV: i64 = 13;
const DTL_S_WAIT_CCS: i64 = 14;
const DTL_S_WAIT_FIN: i64 = 15;
const DTL_DONE: i64 = 20;

const DTL_WINDOW: i64 = 64;
const DTL_MAX_RTX: i64 = 8;

/// What one endpoint is: its role, certificate and P-256 private key,
/// the fingerprint the remote SDP gave ("" accepts any certificate: the
/// caller must then check dtls_peer_fingerprint itself), the SRTP
/// profiles it offers or accepts in preference order, the MTU, and 32
/// bytes of entropy. `peer` names the remote transport address (it goes
/// into the server's cookie).
pub struct DtlsConfig {
    pub is_server: bool,
    pub cert_der: Vec<i64>,
    pub key: Vec<i64>,
    pub remote_fingerprint: str,
    pub srtp_profiles: Vec<i64>,
    pub cookie: bool,
    pub cookie_secret: Vec<i64>,
    pub peer: str,
    pub mtu: i64,
    pub seed: Vec<i64>,
    pub require_ems: bool,
    pub require_client_cert: bool,
    pub rto_ms: i64,
}

/// A DTLS connection: state, record and handshake layers, and the I/O
/// queues (`out`: datagrams to send; `app_in`: application data read).
pub struct DtlsConn {
    pub cfg: DtlsConfig,
    pub state: i64,
    pub err: str,
    pub hs: i64,
    pub now: i64,
    // entropy
    pub rng_key: Vec<i64>,
    pub rng_ctr: i64,
    // record layer
    pub r_epoch: i64,
    pub w_epoch: i64,
    pub w_seqs: Vec<i64>,
    pub r_tops: Vec<i64>,
    pub r_wins: Vec<Vec<i64>>,
    pub pending: Vec<Vec<i64>>,
    pub cur_rec_seq: i64,
    pub cw_key: Vec<i64>,
    pub sw_key: Vec<i64>,
    pub cw_iv: Vec<i64>,
    pub sw_iv: Vec<i64>,
    // handshake layer
    pub hs_send_seq: i64,
    pub hs_recv_seq: i64,
    pub rb_seq: Vec<i64>,
    pub rb_type: Vec<i64>,
    pub rb_len: Vec<i64>,
    pub rb_got: Vec<i64>,
    pub rb_data: Vec<Vec<i64>>,
    pub rb_have: Vec<Vec<i64>>,
    pub transcript: Vec<i64>,
    pub client_random: Vec<i64>,
    pub server_random: Vec<i64>,
    pub cookie: Vec<i64>,
    pub eph_key: Vec<i64>,
    pub peer_eph: Vec<i64>,
    pub peer_cert: Vec<i64>,
    pub peer_key: Vec<i64>,
    pub cert_requested: bool,
    pub master: Vec<i64>,
    pub ems: bool,
    pub srtp_profile: i64,
    // flights
    pub fl_types: Vec<i64>,
    pub fl_epochs: Vec<i64>,
    pub fl_msgs: Vec<Vec<i64>>,
    pub fresh_peer_flight: bool,
    pub peer_flight_seq: i64,
    pub timer_at: i64,
    pub rto: i64,
    pub rtx_round: i64,
    pub last_trigger: i64,
    // I/O and counters
    pub out: Vec<Vec<i64>>,
    pub app_in: Vec<Vec<i64>>,
    pub retransmissions: i64,
    pub records_sent: i64,
    pub records_dropped: i64,
    pub hello_verify: i64,
}

/// SRTP master keys and salts from the DTLS-SRTP exporter (RFC 5764 §4.2).
pub struct DtlsSrtpKeys {
    pub ok: bool,
    pub profile: i64,
    pub client_key: Vec<i64>,
    pub client_salt: Vec<i64>,
    pub server_key: Vec<i64>,
    pub server_salt: Vec<i64>,
}

// ─── Bytes ────────────────────────────────────────────────────────────────

fn dtl_slice(b: &Vec<i64>, from: i64, to: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = from;
    while i < to {
        out.push(b.get(i) & 255);
        i = i + 1;
    }
    return out;
}

fn dtl_cat(a: Vec<i64>, b: Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = a;
    var i: i64 = 0;
    while i < b.len() {
        out.push(b.get(i) & 255);
        i = i + 1;
    }
    return out;
}

fn dtl_add(out: &mut Vec<i64>, b: &Vec<i64>) {
    var i: i64 = 0;
    while i < b.len() {
        out.push(b.get(i) & 255);
        i = i + 1;
    }
}

fn dtl_put(out: &mut Vec<i64>, v: i64, n: i64) {
    var i: i64 = n - 1;
    while i >= 0 {
        out.push((v >> (8 * i)) & 255);
        i = i - 1;
    }
}

fn dtl_be(v: i64, n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    dtl_put(&mut out, v, n);
    return out;
}

fn dtl_get(b: &Vec<i64>, at: i64, n: i64) -> i64 {
    var v: i64 = 0;
    var i: i64 = 0;
    while i < n {
        v = (v << 8) | (b.get(at + i) & 255);
        i = i + 1;
    }
    return v;
}

fn dtl_eq(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var d: i64 = 0;
    var i: i64 = 0;
    while i < a.len() {
        d = d | ((a.get(i) ^ b.get(i)) & 255);
        i = i + 1;
    }
    return d == 0;
}

// a vector of 16-bit values with a length prefix of `lb` bytes
fn dtl_list16(vals: &Vec<i64>, lb: i64) -> Vec<i64> {
    var out: Vec<i64> = dtl_be(vals.len() * 2, lb);
    var i: i64 = 0;
    while i < vals.len() {
        dtl_put(&mut out, vals.get(i), 2);
        i = i + 1;
    }
    return out;
}

fn dtl_has(v: &Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// ─── PRF, exporter, fingerprint ───────────────────────────────────────────

/// The TLS 1.2 PRF with SHA-256 (RFC 5246 §5): P_SHA256(secret, label ||
/// seed), `n` bytes.
pub fn dtls_prf(secret: Vec<i64>, label: str, seed: Vec<i64>, n: i64) -> Vec<i64> {
    val ls: Vec<i64> = dtl_cat(str_bytes(label), seed);
    var out: Vec<i64> = Vec::new();
    var a: Vec<i64> = kdf_hmac(KDF_SHA256, secret, ls);
    while out.len() < n {
        val blk: Vec<i64> = kdf_hmac(KDF_SHA256, secret, dtl_cat(a, ls));
        var i: i64 = 0;
        while i < blk.len() && out.len() < n {
            out.push(blk.get(i));
            i = i + 1;
        }
        a = kdf_hmac(KDF_SHA256, secret, a);
    }
    return out;
}

/// "sha-256 AB:CD:..." of a DER certificate (the SDP a=fingerprint value).
pub fn dtls_fingerprint(der: Vec<i64>) -> str {
    val h: Vec<i64> = kdf_hash(KDF_SHA256, der);
    val hx: str = "0123456789ABCDEF";
    var out: str = "sha-256 ";
    var i: i64 = 0;
    while i < h.len() {
        if i > 0 {
            out = out + ":";
        }
        out = out + str_slice(hx, h.get(i) >> 4, (h.get(i) >> 4) + 1) + str_slice(hx, h.get(i) & 15, (h.get(i) & 15) + 1);
        i = i + 1;
    }
    return out;
}

fn dtl_norm_fp(s: str) -> str {
    return str_to_lower(str_trim(s));
}

/// The peer certificate's fingerprint ("" before it arrived).
pub fn dtls_peer_fingerprint(c: &DtlsConn) -> str {
    if c.peer_cert.len() == 0 {
        return "";
    }
    return dtls_fingerprint(c.peer_cert);
}

/// RFC 5705 keying material exporter without a context value; empty
/// before the handshake is done.
pub fn dtls_export(c: &DtlsConn, label: str, n: i64) -> Vec<i64> {
    if c.state != DTLS_CONNECTED {
        var none: Vec<i64> = Vec::new();
        return none;
    }
    return dtls_prf(c.master, label, dtl_cat(c.client_random, c.server_random), n);
}

/// The SRTP master keys and salts of both directions (RFC 5764 §4.2).
pub fn dtls_srtp_keys(c: &DtlsConn) -> DtlsSrtpKeys {
    var k: DtlsSrtpKeys = DtlsSrtpKeys {
        ok: false, profile: c.srtp_profile, client_key: Vec::new(), client_salt: Vec::new(), server_key: Vec::new(), server_salt: Vec::new()
    };
    if c.state != DTLS_CONNECTED || c.srtp_profile == 0 {
        return k;
    }
    val kl: i64 = srtp_profile_key_len(c.srtp_profile);
    val sl: i64 = srtp_profile_salt_len(c.srtp_profile);
    val m: Vec<i64> = dtls_export(c, "EXTRACTOR-dtls_srtp", 2 * (kl + sl));
    k.client_key = dtl_slice(&m, 0, kl);
    k.server_key = dtl_slice(&m, kl, 2 * kl);
    k.client_salt = dtl_slice(&m, 2 * kl, 2 * kl + sl);
    k.server_salt = dtl_slice(&m, 2 * kl + sl, 2 * kl + 2 * sl);
    k.ok = true;
    return k;
}

pub fn dtls_state_name(s: i64) -> str {
    if s == DTLS_NEW {
        return "new";
    }
    if s == DTLS_CONNECTING {
        return "connecting";
    }
    if s == DTLS_CONNECTED {
        return "connected";
    }
    if s == DTLS_FAILED {
        return "failed";
    }
    return "closed";
}

// ─── Configuration and connection ─────────────────────────────────────────

/// A configuration from PEM text: the certificate ("CERTIFICATE") and its
/// P-256 key ("PRIVATE KEY", PKCS#8), the remote fingerprint, the three
/// SRTP profiles in the order WebRTC prefers, a 1200-byte MTU, cookies on
/// for a server, and a seed from the OS random generator. A key that does
/// not parse leaves `key` empty (dtls_new then fails the connection).
pub fn dtls_config(is_server: bool, cert_pem: str, key_pem: str, remote_fingerprint: str) -> DtlsConfig {
    var profiles: Vec<i64> = Vec::new();
    profiles.push(SRTP_AEAD_AES_128_GCM);
    profiles.push(SRTP_AES128_CM_SHA1_80);
    profiles.push(SRTP_AES128_CM_SHA1_32);
    val cb: PemBlock = pem_decode(cert_pem, "CERTIFICATE");
    val kb: PemBlock = pem_decode(key_pem, "PRIVATE KEY");
    var key: Vec<i64> = Vec::new();
    if kb.ok {
        val pk: Pkcs8Key = pkcs8_parse(kb.der);
        if pk.ok && pk.alg == PEM_OID_EC && pk.params == PEM_OID_P256 && pk.secret.len() == 32 {
            key = pk.secret;
        }
    }
    var der: Vec<i64> = Vec::new();
    if cb.ok {
        der = cb.der;
    }
    return DtlsConfig {
        is_server: is_server, cert_der: der, key: key, remote_fingerprint: remote_fingerprint, srtp_profiles: profiles, cookie: is_server, cookie_secret: crypto_random_bytes(32), peer: "", mtu: 1200, seed: crypto_random_bytes(32), require_ems: true, require_client_cert: true, rto_ms: 1000
    };
}

pub fn dtls_new(cfg: DtlsConfig) -> DtlsConn {
    var hs: i64 = DTL_C_WAIT_SH;
    if cfg.is_server {
        hs = DTL_S_WAIT_CH;
    }
    val rk: Vec<i64> = kdf_hmac(KDF_SHA256, cfg.seed, str_bytes("fides dtls drbg"));
    val rto: i64 = cfg.rto_ms;
    var c: DtlsConn = DtlsConn {
        cfg: cfg, state: DTLS_NEW, err: "", hs: hs, now: 0, rng_key: rk, rng_ctr: 0, r_epoch: 0, w_epoch: 0, w_seqs: Vec::filled(2, 0), r_tops: Vec::filled(2, 0 - 1), r_wins: Vec::new(), pending: Vec::new(), cur_rec_seq: 0, cw_key: Vec::new(), sw_key: Vec::new(), cw_iv: Vec::new(), sw_iv: Vec::new(), hs_send_seq: 0, hs_recv_seq: 0, rb_seq: Vec::new(), rb_type: Vec::new(), rb_len: Vec::new(), rb_got: Vec::new(), rb_data: Vec::new(), rb_have: Vec::new(), transcript: Vec::new(), client_random: Vec::new(), server_random: Vec::new(), cookie: Vec::new(), eph_key: Vec::new(), peer_eph: Vec::new(), peer_cert: Vec::new(), peer_key: Vec::new(), cert_requested: false, master: Vec::new(), ems: false, srtp_profile: 0, fl_types: Vec::new(), fl_epochs: Vec::new(), fl_msgs: Vec::new(), fresh_peer_flight: true, peer_flight_seq: 0, timer_at: 0 - 1, rto: rto, rtx_round: 0, last_trigger: 0 - 1000000, out: Vec::new(), app_in: Vec::new(), retransmissions: 0, records_sent: 0, records_dropped: 0, hello_verify: 0
    };
    c.r_wins.push(Vec::filled(DTL_WINDOW, 0 - 1));
    c.r_wins.push(Vec::filled(DTL_WINDOW, 0 - 1));
    if c.cfg.mtu < 100 {
        c.cfg.mtu = 100;
    }
    if c.cfg.key.len() != 32 || c.cfg.cert_der.len() == 0 {
        c.state = DTLS_FAILED;
        c.err = "no certificate or P-256 key";
    }
    if c.cfg.cookie_secret.len() == 0 {
        c.cfg.cookie_secret = dtl_random(&mut c, 32);
    }
    return c;
}

fn dtl_random(c: &mut DtlsConn, n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    while out.len() < n {
        val blk: Vec<i64> = kdf_hmac(KDF_SHA256, c.rng_key, dtl_be(c.rng_ctr, 8));
        c.rng_ctr = c.rng_ctr + 1;
        var i: i64 = 0;
        while i < blk.len() && out.len() < n {
            out.push(blk.get(i));
            i = i + 1;
        }
    }
    return out;
}

/// Datagrams to send, in order; the queue is emptied.
pub fn dtls_drain(c: &mut DtlsConn) -> Vec<Vec<i64>> {
    val o: Vec<Vec<i64>> = c.out;
    c.out = Vec::new();
    return o;
}

/// Application data received, in order; the queue is emptied.
pub fn dtls_read_app(c: &mut DtlsConn) -> Vec<Vec<i64>> {
    val o: Vec<Vec<i64>> = c.app_in;
    c.app_in = Vec::new();
    return o;
}

/// When dtls_poll next has work (-1: no timer running).
pub fn dtls_next_timeout(c: &DtlsConn) -> i64 {
    return c.timer_at;
}

// ─── Record layer ─────────────────────────────────────────────────────────

fn dtl_nonce(iv: &Vec<i64>, epoch: i64, seq: i64) -> Vec<i64> {
    var n: Vec<i64> = dtl_slice(iv, 0, 4);
    dtl_put(&mut n, epoch, 2);
    dtl_put(&mut n, seq, 6);
    return n;
}

fn dtl_aad(epoch: i64, seq: i64, ct: i64, len: i64) -> Vec<i64> {
    var a: Vec<i64> = dtl_be(epoch, 2);
    dtl_put(&mut a, seq, 6);
    a.push(ct);
    a.push(254);
    a.push(253);
    dtl_put(&mut a, len, 2);
    return a;
}

// one record under the current keys of `epoch`, with the next sequence
// number of that epoch
fn dtl_make_record(c: &mut DtlsConn, ct: i64, epoch: i64, plain: Vec<i64>) -> Vec<i64> {
    val seq: i64 = c.w_seqs.get(epoch);
    c.w_seqs.set(epoch, seq + 1);
    return dtl_record_with_seq(c, ct, epoch, seq, plain);
}

fn dtl_record_with_seq(c: &mut DtlsConn, ct: i64, epoch: i64, seq: i64, plain: Vec<i64>) -> Vec<i64> {
    var frag: Vec<i64> = plain;
    if epoch > 0 {
        var key: Vec<i64> = c.cw_key;
        var iv: Vec<i64> = c.cw_iv;
        if c.cfg.is_server {
            key = c.sw_key;
            iv = c.sw_iv;
        }
        val sealed: Vec<i64> = aes_gcm_seal(key, dtl_nonce(&iv, epoch, seq), dtl_aad(epoch, seq, ct, plain.len()), plain);
        frag = dtl_be(epoch, 2);
        dtl_put(&mut frag, seq, 6);
        dtl_add(&mut frag, &sealed);
    }
    var r: Vec<i64> = Vec::new();
    r.push(ct);
    r.push(254);
    r.push(253);
    dtl_put(&mut r, epoch, 2);
    dtl_put(&mut r, seq, 6);
    dtl_put(&mut r, frag.len(), 2);
    dtl_add(&mut r, &frag);
    c.records_sent = c.records_sent + 1;
    return r;
}

/// Feed one received datagram (one or more records).
pub fn dtls_receive(c: &mut DtlsConn, dg: Vec<i64>, now: i64) {
    c.now = now;
    var at: i64 = 0;
    while at + 13 <= dg.len() {
        if c.state == DTLS_FAILED || c.state == DTLS_CLOSED {
            return;
        }
        val len: i64 = dtl_get(&dg, at + 11, 2);
        if at + 13 + len > dg.len() {
            c.records_dropped = c.records_dropped + 1;
            return;
        }
        dtl_record(c, dtl_slice(&dg, at, at + 13 + len));
        at = at + 13 + len;
    }
}

fn dtl_record(c: &mut DtlsConn, rec: Vec<i64>) {
    val ct: i64 = rec.get(0);
    val ver: i64 = dtl_get(&rec, 1, 2);
    val epoch: i64 = dtl_get(&rec, 3, 2);
    val seq: i64 = dtl_get(&rec, 5, 6);
    val frag: Vec<i64> = dtl_slice(&rec, 13, rec.len());
    if (ct < 20 || ct > 23) || (ver != 65277 && ver != 65279) {
        c.records_dropped = c.records_dropped + 1;
        return;
    }
    if epoch == c.r_epoch + 1 && epoch <= 1 {
        if c.pending.len() < 32 {
            c.pending.push(rec);
        }
        return;
    }
    if epoch != c.r_epoch {
        // an older epoch: only a retransmitted handshake flight matters
        if epoch == 0 && ct == DTLS_CT_HANDSHAKE {
            dtl_old_handshake_record(c, frag);
        }
        return;
    }
    // replay window
    val top: i64 = c.r_tops.get(epoch);
    var w: Vec<i64> = c.r_wins.get(epoch);
    if top >= 0 && seq <= top {
        if top - seq >= DTL_WINDOW || w.get(seq % DTL_WINDOW) == seq {
            c.records_dropped = c.records_dropped + 1;
            return;
        }
    }
    var plain: Vec<i64> = frag;
    if epoch > 0 {
        if frag.len() < 24 {
            c.records_dropped = c.records_dropped + 1;
            return;
        }
        var key: Vec<i64> = c.sw_key;
        var iv: Vec<i64> = c.sw_iv;
        if c.cfg.is_server {
            key = c.cw_key;
            iv = c.cw_iv;
        }
        val o: GcmOpened = aes_gcm_open(key, dtl_cat(dtl_slice(&iv, 0, 4), dtl_slice(&frag, 0, 8)), dtl_aad(epoch, seq, ct, frag.len() - 24), dtl_slice(&frag, 8, frag.len()));
        if !o.ok {
            c.records_dropped = c.records_dropped + 1;
            return;
        }
        plain = o.plain;
    }
    w.set(seq % DTL_WINDOW, seq);
    c.r_wins.set(epoch, w);
    if seq > top {
        c.r_tops.set(epoch, seq);
    }
    c.cur_rec_seq = seq;
    if ct == DTLS_CT_HANDSHAKE {
        dtl_handshake_record(c, plain);
    } else if ct == DTLS_CT_CCS {
        dtl_on_ccs(c, plain);
    } else if ct == DTLS_CT_ALERT {
        dtl_on_alert(c, plain);
    } else if ct == DTLS_CT_APP {
        if c.state == DTLS_CONNECTED && epoch >= 1 {
            c.app_in.push(plain);
        }
    }
}

fn dtl_on_alert(c: &mut DtlsConn, p: Vec<i64>) {
    if p.len() < 2 {
        return;
    }
    if p.get(1) == DTLS_ALERT_CLOSE_NOTIFY {
        c.state = DTLS_CLOSED;
        c.err = "closed by peer";
    } else if p.get(0) == 2 {
        c.state = DTLS_FAILED;
        c.err = "alert " + int_to_str(p.get(1)) + " from peer";
    }
    c.timer_at = 0 - 1;
}

fn dtl_send_alert(c: &mut DtlsConn, level: i64, desc: i64) {
    var p: Vec<i64> = Vec::new();
    p.push(level);
    p.push(desc);
    val e: i64 = c.w_epoch;
    val r: Vec<i64> = dtl_make_record(c, DTLS_CT_ALERT, e, p);
    c.out.push(r);
}

fn dtl_fail(c: &mut DtlsConn, desc: i64, why: str) {
    if c.state == DTLS_FAILED {
        return;
    }
    dtl_send_alert(c, 2, desc);
    c.state = DTLS_FAILED;
    c.err = why;
    c.timer_at = 0 - 1;
}

/// Send close_notify and close.
pub fn dtls_close(c: &mut DtlsConn) {
    if c.state == DTLS_CONNECTED || c.state == DTLS_CONNECTING {
        dtl_send_alert(c, 1, DTLS_ALERT_CLOSE_NOTIFY);
    }
    c.state = DTLS_CLOSED;
    c.timer_at = 0 - 1;
}

/// Send application data (one record); false before the handshake is done.
pub fn dtls_send_app(c: &mut DtlsConn, data: Vec<i64>) -> bool {
    if c.state != DTLS_CONNECTED {
        return false;
    }
    c.out.push(dtl_make_record(c, DTLS_CT_APP, 1, data));
    return true;
}

fn dtl_on_ccs(c: &mut DtlsConn, p: Vec<i64>) {
    if p.len() != 1 || p.get(0) != 1 {
        return;
    }
    val want: bool = (c.cfg.is_server && c.hs == DTL_S_WAIT_CCS) || (!c.cfg.is_server && c.hs == DTL_C_WAIT_CCS);
    if !want || c.r_epoch != 0 {
        return;
    }
    c.r_epoch = 1;
    if c.cfg.is_server {
        c.hs = DTL_S_WAIT_FIN;
    } else {
        c.hs = DTL_C_WAIT_FIN;
    }
    val held: Vec<Vec<i64>> = c.pending;
    c.pending = Vec::new();
    var i: i64 = 0;
    while i < held.len() {
        dtl_record(c, held.get(i));
        i = i + 1;
    }
}

// ─── Flights and retransmission ───────────────────────────────────────────

// a handshake message with its 12-byte header, unfragmented
fn dtl_hs_msg(t: i64, seq: i64, body: &Vec<i64>) -> Vec<i64> {
    var m: Vec<i64> = Vec::new();
    m.push(t);
    dtl_put(&mut m, body.len(), 3);
    dtl_put(&mut m, seq, 2);
    dtl_put(&mut m, 0, 3);
    dtl_put(&mut m, body.len(), 3);
    dtl_add(&mut m, body);
    return m;
}

fn dtl_flight_clear(c: &mut DtlsConn) {
    c.fl_types = Vec::new();
    c.fl_epochs = Vec::new();
    c.fl_msgs = Vec::new();
}

// add our next handshake message to the flight and the transcript
fn dtl_flight_add(c: &mut DtlsConn, t: i64, body: Vec<i64>, epoch: i64) -> Vec<i64> {
    val m: Vec<i64> = dtl_hs_msg(t, c.hs_send_seq, &body);
    c.hs_send_seq = c.hs_send_seq + 1;
    c.fl_types.push(DTLS_CT_HANDSHAKE);
    c.fl_epochs.push(epoch);
    c.fl_msgs.push(m);
    return m;
}

fn dtl_flight_add_ccs(c: &mut DtlsConn) {
    var one: Vec<i64> = Vec::new();
    one.push(1);
    c.fl_types.push(DTLS_CT_CCS);
    c.fl_epochs.push(0);
    c.fl_msgs.push(one);
}

// the flight as records, fragmented to the MTU, packed into datagrams
fn dtl_send_flight(c: &mut DtlsConn) {
    var recs: Vec<Vec<i64>> = Vec::new();
    var i: i64 = 0;
    while i < c.fl_msgs.len() {
        val epoch: i64 = c.fl_epochs.get(i);
        val m: Vec<i64> = c.fl_msgs.get(i);
        if c.fl_types.get(i) == DTLS_CT_CCS {
            recs.push(dtl_make_record(c, DTLS_CT_CCS, epoch, m));
        } else {
            val total: i64 = m.len() - 12;
            var room: i64 = c.cfg.mtu - 13 - 12;
            if epoch > 0 {
                room = room - 24;
            }
            var off: i64 = 0;
            var first: bool = true;
            while first || off < total {
                first = false;
                var n: i64 = total - off;
                if n > room {
                    n = room;
                }
                var f: Vec<i64> = dtl_slice(&m, 0, 6);
                dtl_put(&mut f, off, 3);
                dtl_put(&mut f, n, 3);
                dtl_add(&mut f, &dtl_slice(&m, 12 + off, 12 + off + n));
                recs.push(dtl_make_record(c, DTLS_CT_HANDSHAKE, epoch, f));
                off = off + n;
            }
        }
        i = i + 1;
    }
    var dg: Vec<i64> = Vec::new();
    i = 0;
    while i < recs.len() {
        val r: Vec<i64> = recs.get(i);
        if dg.len() > 0 && dg.len() + r.len() > c.cfg.mtu {
            c.out.push(dg);
            dg = Vec::new();
        }
        dtl_add(&mut dg, &r);
        i = i + 1;
    }
    if dg.len() > 0 {
        c.out.push(dg);
    }
}

// send a new flight; `timed` arms the retransmission timer
fn dtl_send_new_flight(c: &mut DtlsConn, timed: bool) {
    dtl_send_flight(c);
    c.fresh_peer_flight = true;
    c.rto = c.cfg.rto_ms;
    c.rtx_round = 0;
    if timed {
        c.timer_at = c.now + c.rto;
    } else {
        c.timer_at = 0 - 1;
    }
}

/// Run the retransmission timer at time `now` (milliseconds).
pub fn dtls_poll(c: &mut DtlsConn, now: i64) {
    c.now = now;
    if c.state != DTLS_CONNECTING || c.timer_at < 0 || now < c.timer_at {
        return;
    }
    if c.rtx_round >= DTL_MAX_RTX {
        c.state = DTLS_FAILED;
        c.err = "handshake timed out";
        c.timer_at = 0 - 1;
        return;
    }
    dtl_send_flight(c);
    c.retransmissions = c.retransmissions + 1;
    c.rtx_round = c.rtx_round + 1;
    c.rto = c.rto * 2;
    if c.rto > 60000 {
        c.rto = 60000;
    }
    c.timer_at = now + c.rto;
}

// a message of the peer's previous flight came again: resend ours
fn dtl_old_message(c: &mut DtlsConn, mseq: i64, foff: i64) {
    if foff != 0 || mseq < c.peer_flight_seq || c.fl_msgs.len() == 0 {
        return;
    }
    if c.state != DTLS_CONNECTING && c.state != DTLS_CONNECTED {
        return;
    }
    if c.now - c.last_trigger < 250 {
        return;
    }
    c.last_trigger = c.now;
    dtl_send_flight(c);
    c.retransmissions = c.retransmissions + 1;
}

fn dtl_old_handshake_record(c: &mut DtlsConn, p: Vec<i64>) {
    var at: i64 = 0;
    while at + 12 <= p.len() {
        val mseq: i64 = dtl_get(&p, at + 4, 2);
        val foff: i64 = dtl_get(&p, at + 6, 3);
        val flen: i64 = dtl_get(&p, at + 9, 3);
        if mseq < c.hs_recv_seq {
            dtl_old_message(c, mseq, foff);
        }
        at = at + 12 + flen;
    }
}

// ─── Handshake reassembly ─────────────────────────────────────────────────

fn dtl_handshake_record(c: &mut DtlsConn, p: Vec<i64>) {
    var at: i64 = 0;
    while at + 12 <= p.len() {
        val mt: i64 = p.get(at);
        val len: i64 = dtl_get(&p, at + 1, 3);
        val mseq: i64 = dtl_get(&p, at + 4, 2);
        val foff: i64 = dtl_get(&p, at + 6, 3);
        val flen: i64 = dtl_get(&p, at + 9, 3);
        if at + 12 + flen > p.len() || foff + flen > len || len > 65536 {
            c.records_dropped = c.records_dropped + 1;
            return;
        }
        dtl_fragment(c, mt, len, mseq, foff, dtl_slice(&p, at + 12, at + 12 + flen));
        if c.state == DTLS_FAILED {
            return;
        }
        at = at + 12 + flen;
    }
}

fn dtl_fragment(c: &mut DtlsConn, mt: i64, len: i64, mseq: i64, foff: i64, frag: Vec<i64>) {
    // a server waiting for a ClientHello takes one at any message_seq (a
    // client retransmits its first one until it gets a cookie), whole or
    // in fragments
    if c.cfg.is_server && c.hs == DTL_S_WAIT_CH {
        if mt != DTLS_HS_CLIENT_HELLO || mseq < c.hs_recv_seq || mseq > c.hs_recv_seq + 16 {
            return;
        }
        if foff == 0 && frag.len() == len {
            dtl_server_on_hello(c, mseq, frag);
            return;
        }
        val k: i64 = dtl_rb_put(c, mt, len, mseq, foff, frag);
        if k >= 0 && c.rb_got.get(k) == c.rb_len.get(k) {
            val body: Vec<i64> = c.rb_data.get(k);
            dtl_rb_remove(c, k);
            dtl_server_on_hello(c, mseq, body);
        }
        return;
    }
    if mseq < c.hs_recv_seq {
        dtl_old_message(c, mseq, foff);
        return;
    }
    if mseq > c.hs_recv_seq + 16 {
        return;
    }
    if dtl_rb_put(c, mt, len, mseq, foff, frag) >= 0 {
        dtl_process_ready(c);
    }
}

// store a fragment in the reassembly buffer of its message; the slot, or
// -1 when the fragment does not agree with what came before
fn dtl_rb_put(c: &mut DtlsConn, mt: i64, len: i64, mseq: i64, foff: i64, frag: Vec<i64>) -> i64 {
    var k: i64 = 0;
    while k < c.rb_seq.len() && c.rb_seq.get(k) != mseq {
        k = k + 1;
    }
    if k == c.rb_seq.len() {
        if c.rb_seq.len() >= 32 {
            return 0 - 1;
        }
        c.rb_seq.push(mseq);
        c.rb_type.push(mt);
        c.rb_len.push(len);
        c.rb_got.push(0);
        c.rb_data.push(Vec::filled(len, 0));
        c.rb_have.push(Vec::filled(len, 0));
    }
    if c.rb_type.get(k) != mt || c.rb_len.get(k) != len {
        return 0 - 1;
    }
    var d: Vec<i64> = c.rb_data.get(k);
    var h: Vec<i64> = c.rb_have.get(k);
    var got: i64 = c.rb_got.get(k);
    var i: i64 = 0;
    while i < frag.len() {
        if h.get(foff + i) == 0 {
            h.set(foff + i, 1);
            d.set(foff + i, frag.get(i));
            got = got + 1;
        }
        i = i + 1;
    }
    c.rb_data.set(k, d);
    c.rb_have.set(k, h);
    c.rb_got.set(k, got);
    return k;
}

fn dtl_rb_remove(c: &mut DtlsConn, k: i64) {
    c.rb_seq.remove(k);
    c.rb_type.remove(k);
    c.rb_len.remove(k);
    c.rb_got.remove(k);
    c.rb_data.remove(k);
    c.rb_have.remove(k);
}

fn dtl_process_ready(c: &mut DtlsConn) {
    var more: bool = true;
    while more && c.state != DTLS_FAILED {
        more = false;
        var k: i64 = 0;
        while k < c.rb_seq.len() {
            if c.rb_seq.get(k) == c.hs_recv_seq && c.rb_got.get(k) == c.rb_len.get(k) {
                val t: i64 = c.rb_type.get(k);
                val body: Vec<i64> = c.rb_data.get(k);
                val mseq: i64 = c.rb_seq.get(k);
                dtl_rb_remove(c, k);
                c.hs_recv_seq = c.hs_recv_seq + 1;
                if c.fresh_peer_flight {
                    c.fresh_peer_flight = false;
                    c.peer_flight_seq = mseq;
                }
                if c.cfg.is_server {
                    dtl_server_message(c, t, mseq, body);
                } else {
                    dtl_client_message(c, t, mseq, body);
                }
                more = true;
                k = c.rb_seq.len();
            } else {
                k = k + 1;
            }
        }
    }
}

// ─── Hello messages and extensions ────────────────────────────────────────

struct DtlsHello {
    ok: bool,
    version: i64,
    random: Vec<i64>,
    session_id: Vec<i64>,
    cookie: Vec<i64>,
    suites: Vec<i64>,
    suite: i64,
    comps: Vec<i64>,
    ext_types: Vec<i64>,
    ext_data: Vec<Vec<i64>>,
}

fn dtl_hello_bad() -> DtlsHello {
    return DtlsHello {
        ok: false, version: 0, random: Vec::new(), session_id: Vec::new(), cookie: Vec::new(), suites: Vec::new(), suite: 0, comps: Vec::new(), ext_types: Vec::new(), ext_data: Vec::new()
    };
}

// ClientHello (client true) or ServerHello
fn dtl_parse_hello(b: &Vec<i64>, client: bool) -> DtlsHello {
    var h: DtlsHello = dtl_hello_bad();
    if b.len() < 35 {
        return h;
    }
    h.version = dtl_get(b, 0, 2);
    h.random = dtl_slice(b, 2, 34);
    var at: i64 = 34;
    val sl: i64 = b.get(at);
    if at + 1 + sl > b.len() || sl > 32 {
        return h;
    }
    h.session_id = dtl_slice(b, at + 1, at + 1 + sl);
    at = at + 1 + sl;
    if client {
        if at + 1 > b.len() {
            return h;
        }
        val cl: i64 = b.get(at);
        if at + 1 + cl > b.len() {
            return h;
        }
        h.cookie = dtl_slice(b, at + 1, at + 1 + cl);
        at = at + 1 + cl;
        if at + 2 > b.len() {
            return h;
        }
        val n: i64 = dtl_get(b, at, 2);
        if n % 2 != 0 || at + 2 + n > b.len() {
            return h;
        }
        var i: i64 = 0;
        while i < n {
            h.suites.push(dtl_get(b, at + 2 + i, 2));
            i = i + 2;
        }
        at = at + 2 + n;
        if at + 1 > b.len() {
            return h;
        }
        val m: i64 = b.get(at);
        if at + 1 + m > b.len() {
            return h;
        }
        h.comps = dtl_slice(b, at + 1, at + 1 + m);
        at = at + 1 + m;
    } else {
        if at + 3 > b.len() {
            return h;
        }
        h.suite = dtl_get(b, at, 2);
        h.comps.push(b.get(at + 2));
        at = at + 3;
    }
    if at < b.len() {
        if at + 2 > b.len() {
            return h;
        }
        val el: i64 = dtl_get(b, at, 2);
        if at + 2 + el != b.len() {
            return h;
        }
        var e: i64 = at + 2;
        while e < b.len() {
            if e + 4 > b.len() {
                return h;
            }
            val t: i64 = dtl_get(b, e, 2);
            val l: i64 = dtl_get(b, e + 2, 2);
            if e + 4 + l > b.len() {
                return h;
            }
            h.ext_types.push(t);
            h.ext_data.push(dtl_slice(b, e + 4, e + 4 + l));
            e = e + 4 + l;
        }
    }
    h.ok = true;
    return h;
}

fn dtl_ext_at(h: &DtlsHello, t: i64) -> i64 {
    var i: i64 = 0;
    while i < h.ext_types.len() {
        if h.ext_types.get(i) == t {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn dtl_ext(out: &mut Vec<i64>, t: i64, data: Vec<i64>) {
    dtl_put(out, t, 2);
    dtl_put(out, data.len(), 2);
    dtl_add(out, &data);
}

// a 16-bit list in an extension: [len2] values (groups, sig algs) or the
// use_srtp profiles; empty when malformed
fn dtl_u16_list(d: &Vec<i64>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if d.len() < 2 {
        return out;
    }
    val n: i64 = dtl_get(d, 0, 2);
    if n % 2 != 0 || 2 + n > d.len() {
        return out;
    }
    var i: i64 = 0;
    while i < n {
        out.push(dtl_get(d, 2 + i, 2));
        i = i + 2;
    }
    return out;
}

fn dtl_use_srtp_ext(profiles: &Vec<i64>) -> Vec<i64> {
    var d: Vec<i64> = dtl_list16(profiles, 2);
    d.push(0);
    return d;
}

fn dtl_client_hello_body(c: &DtlsConn) -> Vec<i64> {
    var b: Vec<i64> = Vec::new();
    b.push(254);
    b.push(253);
    dtl_add(&mut b, &c.client_random);
    b.push(0);
    b.push(c.cookie.len());
    dtl_add(&mut b, &c.cookie);
    dtl_put(&mut b, 2, 2);
    dtl_put(&mut b, DTLS_SUITE, 2);
    b.push(1);
    b.push(0);
    var ex: Vec<i64> = Vec::new();
    var g: Vec<i64> = Vec::new();
    g.push(DTL_SECP256R1);
    dtl_ext(&mut ex, DTL_EXT_GROUPS, dtl_list16(&g, 2));
    var pf: Vec<i64> = Vec::new();
    pf.push(1);
    pf.push(0);
    dtl_ext(&mut ex, DTL_EXT_POINT_FORMATS, pf);
    var sa: Vec<i64> = Vec::new();
    sa.push(DTL_ECDSA_SHA256);
    dtl_ext(&mut ex, DTL_EXT_SIG_ALGS, dtl_list16(&sa, 2));
    var none: Vec<i64> = Vec::new();
    dtl_ext(&mut ex, DTL_EXT_EMS, none);
    if c.cfg.srtp_profiles.len() > 0 {
        dtl_ext(&mut ex, DTL_EXT_USE_SRTP, dtl_use_srtp_ext(&c.cfg.srtp_profiles));
    }
    var rn: Vec<i64> = Vec::new();
    rn.push(0);
    dtl_ext(&mut ex, DTL_EXT_RENEG, rn);
    dtl_put(&mut b, ex.len(), 2);
    dtl_add(&mut b, &ex);
    return b;
}

fn dtl_certificate_body(der: &Vec<i64>) -> Vec<i64> {
    var b: Vec<i64> = dtl_be(der.len() + 3, 3);
    dtl_put(&mut b, der.len(), 3);
    dtl_add(&mut b, der);
    return b;
}

// the first certificate of a Certificate message (empty list: empty)
fn dtl_first_cert(b: &Vec<i64>) -> Vec<i64> {
    var none: Vec<i64> = Vec::new();
    if b.len() < 3 {
        return none;
    }
    val total: i64 = dtl_get(b, 0, 3);
    if 3 + total != b.len() || total < 3 {
        return none;
    }
    val n: i64 = dtl_get(b, 3, 3);
    if 6 + n > b.len() {
        return none;
    }
    return dtl_slice(b, 6, 6 + n);
}

// the peer certificate: P-256 key and the expected fingerprint. "" or why not.
fn dtl_check_cert(c: &mut DtlsConn, der: Vec<i64>) -> str {
    if der.len() == 0 {
        return "no certificate";
    }
    val cert: X509Cert = x509_parse(der);
    if !cert.ok {
        return "certificate does not parse: " + cert.err;
    }
    if cert.spki.alg != PEM_OID_EC || cert.spki.params != PEM_OID_P256 || cert.spki.key.len() != 65 {
        return "certificate key is not P-256";
    }
    val fp: str = dtls_fingerprint(der);
    if str_len(c.cfg.remote_fingerprint) > 0 && dtl_norm_fp(fp) != dtl_norm_fp(c.cfg.remote_fingerprint) {
        return "certificate fingerprint does not match";
    }
    c.peer_cert = der;
    c.peer_key = cert.spki.key;
    return "";
}

fn dtl_sign(c: &DtlsConn, msg: Vec<i64>) -> Vec<i64> {
    val curve: EcCurve = ec_p256();
    return ecdsa_sig_to_der(ecdsa_sign(&curve, c.cfg.key, KDF_SHA256, msg));
}

// SignatureAndHashAlgorithm || signature<2>
fn dtl_signed(c: &DtlsConn, msg: Vec<i64>) -> Vec<i64> {
    val der: Vec<i64> = dtl_sign(c, msg);
    var b: Vec<i64> = dtl_be(DTL_ECDSA_SHA256, 2);
    dtl_put(&mut b, der.len(), 2);
    dtl_add(&mut b, &der);
    return b;
}

fn dtl_verify_signed(c: &DtlsConn, msg: Vec<i64>, b: &Vec<i64>, at: i64) -> bool {
    if at + 4 > b.len() || dtl_get(b, at, 2) != DTL_ECDSA_SHA256 {
        return false;
    }
    val n: i64 = dtl_get(b, at + 2, 2);
    if at + 4 + n != b.len() {
        return false;
    }
    val curve: EcCurve = ec_p256();
    return ecdsa_verify_der(&curve, c.peer_key, KDF_SHA256, msg, dtl_slice(b, at + 4, at + 4 + n));
}

fn dtl_finished(c: &DtlsConn, label: str) -> Vec<i64> {
    return dtls_prf(c.master, label, kdf_hash(KDF_SHA256, c.transcript), 12);
}

// master secret and key block once the premaster secret is known (the
// transcript then ends with ClientKeyExchange)
fn dtl_keys(c: &mut DtlsConn, pms: Vec<i64>) {
    if c.ems {
        c.master = dtls_prf(pms, "extended master secret", kdf_hash(KDF_SHA256, c.transcript), 48);
    } else {
        c.master = dtls_prf(pms, "master secret", dtl_cat(c.client_random, c.server_random), 48);
    }
    val kb: Vec<i64> = dtls_prf(c.master, "key expansion", dtl_cat(c.server_random, c.client_random), 40);
    c.cw_key = dtl_slice(&kb, 0, 16);
    c.sw_key = dtl_slice(&kb, 16, 32);
    c.cw_iv = dtl_slice(&kb, 32, 36);
    c.sw_iv = dtl_slice(&kb, 36, 40);
}

fn dtl_new_eph(c: &mut DtlsConn) -> Vec<i64> {
    c.eph_key = dtl_random(c, 32);
    val curve: EcCurve = ec_p256();
    return ec_public_key(&curve, c.eph_key);
}

// ─── Client ───────────────────────────────────────────────────────────────

/// Start the handshake (a client sends its ClientHello; a server waits).
pub fn dtls_start(c: &mut DtlsConn, now: i64) {
    c.now = now;
    if c.state != DTLS_NEW {
        return;
    }
    c.state = DTLS_CONNECTING;
    if c.cfg.is_server {
        return;
    }
    c.client_random = dtl_random(c, 32);
    dtl_flight_clear(c);
    val m: Vec<i64> = dtl_flight_add(c, DTLS_HS_CLIENT_HELLO, dtl_client_hello_body(c), 0);
    c.transcript = m;
    dtl_send_new_flight(c, true);
}

fn dtl_client_message(c: &mut DtlsConn, t: i64, mseq: i64, body: Vec<i64>) {
    val full: Vec<i64> = dtl_hs_msg(t, mseq, &body);
    if c.hs == DTL_C_WAIT_SH && t == DTLS_HS_HELLO_VERIFY {
        if body.len() < 3 || 3 + body.get(2) != body.len() || body.get(2) > 255 {
            dtl_fail(c, DTLS_ALERT_DECODE_ERROR, "bad HelloVerifyRequest");
            return;
        }
        c.cookie = dtl_slice(&body, 3, body.len());
        c.hello_verify = c.hello_verify + 1;
        dtl_flight_clear(c);
        val m: Vec<i64> = dtl_flight_add(c, DTLS_HS_CLIENT_HELLO, dtl_client_hello_body(c), 0);
        // the first ClientHello and the HelloVerifyRequest are not hashed
        c.transcript = m;
        dtl_send_new_flight(c, true);
        return;
    }
    if c.hs == DTL_C_WAIT_SH && t == DTLS_HS_SERVER_HELLO {
        val h: DtlsHello = dtl_parse_hello(&body, false);
        if !h.ok {
            dtl_fail(c, DTLS_ALERT_DECODE_ERROR, "bad ServerHello");
            return;
        }
        if h.version != 65277 {
            dtl_fail(c, DTLS_ALERT_PROTOCOL_VERSION, "server is not DTLS 1.2");
            return;
        }
        if h.suite != DTLS_SUITE || h.comps.get(0) != 0 {
            dtl_fail(c, DTLS_ALERT_ILLEGAL_PARAMETER, "server chose a suite we did not offer");
            return;
        }
        c.ems = dtl_ext_at(&h, DTL_EXT_EMS) >= 0;
        if c.cfg.require_ems && !c.ems {
            dtl_fail(c, DTLS_ALERT_HANDSHAKE_FAILURE, "no extended master secret");
            return;
        }
        val us: i64 = dtl_ext_at(&h, DTL_EXT_USE_SRTP);
        if c.cfg.srtp_profiles.len() > 0 {
            if us < 0 {
                dtl_fail(c, DTLS_ALERT_HANDSHAKE_FAILURE, "server did not take use_srtp");
                return;
            }
            val ps: Vec<i64> = dtl_u16_list(&h.ext_data.get(us));
            if ps.len() != 1 || !dtl_has(&c.cfg.srtp_profiles, ps.get(0)) {
                dtl_fail(c, DTLS_ALERT_ILLEGAL_PARAMETER, "server chose an SRTP profile we did not offer");
                return;
            }
            c.srtp_profile = ps.get(0);
        }
        c.server_random = h.random;
        dtl_add(&mut c.transcript, &full);
        c.hs = DTL_C_WAIT_CERT;
        return;
    }
    if c.hs == DTL_C_WAIT_CERT && t == DTLS_HS_CERTIFICATE {
        val why: str = dtl_check_cert(c, dtl_first_cert(&body));
        if str_len(why) > 0 {
            dtl_fail(c, DTLS_ALERT_BAD_CERTIFICATE, why);
            return;
        }
        dtl_add(&mut c.transcript, &full);
        c.hs = DTL_C_WAIT_SKE;
        return;
    }
    if c.hs == DTL_C_WAIT_SKE && t == DTLS_HS_SERVER_KEY_EXCHANGE {
        if body.len() < 4 + 65 + 4 || body.get(0) != 3 || dtl_get(&body, 1, 2) != DTL_SECP256R1 || body.get(3) != 65 {
            dtl_fail(c, DTLS_ALERT_ILLEGAL_PARAMETER, "ServerKeyExchange is not ECDHE on secp256r1");
            return;
        }
        val params: Vec<i64> = dtl_slice(&body, 0, 69);
        val signed: Vec<i64> = dtl_cat(dtl_cat(c.client_random, c.server_random), params);
        if !dtl_verify_signed(c, signed, &body, 69) {
            dtl_fail(c, DTLS_ALERT_DECRYPT_ERROR, "ServerKeyExchange signature does not verify");
            return;
        }
        c.peer_eph = dtl_slice(&body, 4, 69);
        dtl_add(&mut c.transcript, &full);
        c.hs = DTL_C_WAIT_SHD;
        return;
    }
    if c.hs == DTL_C_WAIT_SHD && t == DTLS_HS_CERTIFICATE_REQUEST {
        // certificate_types<1> must allow ecdsa_sign (64)
        if body.len() < 1 || body.len() < 1 + body.get(0) || !dtl_has(&dtl_slice(&body, 1, 1 + body.get(0)), 64) {
            dtl_fail(c, DTLS_ALERT_HANDSHAKE_FAILURE, "server does not accept ECDSA certificates");
            return;
        }
        c.cert_requested = true;
        dtl_add(&mut c.transcript, &full);
        return;
    }
    if c.hs == DTL_C_WAIT_SHD && t == DTLS_HS_SERVER_HELLO_DONE {
        dtl_add(&mut c.transcript, &full);
        dtl_client_flight5(c);
        return;
    }
    if c.hs == DTL_C_WAIT_FIN && t == DTLS_HS_FINISHED && c.r_epoch == 1 {
        val want: Vec<i64> = dtl_finished(c, "server finished");
        if !dtl_eq(&want, &body) {
            dtl_fail(c, DTLS_ALERT_DECRYPT_ERROR, "server Finished does not verify");
            return;
        }
        dtl_add(&mut c.transcript, &full);
        c.hs = DTL_DONE;
        c.state = DTLS_CONNECTED;
        c.timer_at = 0 - 1;
        return;
    }
    dtl_fail(c, DTLS_ALERT_UNEXPECTED_MESSAGE, "unexpected handshake message " + int_to_str(t));
}

fn dtl_client_flight5(c: &mut DtlsConn) {
    dtl_flight_clear(c);
    if c.cert_requested {
        val m: Vec<i64> = dtl_flight_add(c, DTLS_HS_CERTIFICATE, dtl_certificate_body(&c.cfg.cert_der), 0);
        dtl_add(&mut c.transcript, &m);
    }
    val pub_key: Vec<i64> = dtl_new_eph(c);
    val curve: EcCurve = ec_p256();
    val pms: Vec<i64> = ecdh_shared(&curve, c.eph_key, c.peer_eph);
    if pms.len() == 0 {
        dtl_fail(c, DTLS_ALERT_ILLEGAL_PARAMETER, "server ECDHE key is not on the curve");
        return;
    }
    var cke: Vec<i64> = Vec::new();
    cke.push(65);
    dtl_add(&mut cke, &pub_key);
    val km: Vec<i64> = dtl_flight_add(c, DTLS_HS_CLIENT_KEY_EXCHANGE, cke, 0);
    dtl_add(&mut c.transcript, &km);
    dtl_keys(c, pms);
    if c.cert_requested {
        val cv: Vec<i64> = dtl_flight_add(c, DTLS_HS_CERTIFICATE_VERIFY, dtl_signed(c, c.transcript), 0);
        dtl_add(&mut c.transcript, &cv);
    }
    dtl_flight_add_ccs(c);
    c.w_epoch = 1;
    val fin: Vec<i64> = dtl_flight_add(c, DTLS_HS_FINISHED, dtl_finished(c, "client finished"), 1);
    dtl_add(&mut c.transcript, &fin);
    c.hs = DTL_C_WAIT_CCS;
    dtl_send_new_flight(c, true);
}

// ─── Server ───────────────────────────────────────────────────────────────

fn dtl_cookie_for(c: &DtlsConn, random: &Vec<i64>) -> Vec<i64> {
    val mac: Vec<i64> = kdf_hmac(KDF_SHA256, c.cfg.cookie_secret, dtl_cat(str_bytes(c.cfg.peer), dtl_slice(random, 0, random.len())));
    return dtl_slice(&mac, 0, 16);
}

fn dtl_server_on_hello(c: &mut DtlsConn, mseq: i64, body: Vec<i64>) {
    val h: DtlsHello = dtl_parse_hello(&body, true);
    if !h.ok {
        dtl_fail(c, DTLS_ALERT_DECODE_ERROR, "bad ClientHello");
        return;
    }
    if h.version > 65277 {
        dtl_fail(c, DTLS_ALERT_PROTOCOL_VERSION, "client does not offer DTLS 1.2");
        return;
    }
    if c.cfg.cookie {
        val want: Vec<i64> = dtl_cookie_for(c, &h.random);
        if !dtl_eq(&want, &h.cookie) {
            // HelloVerifyRequest: stateless, record sequence number of the ClientHello
            var hv: Vec<i64> = Vec::new();
            hv.push(254);
            hv.push(255);
            hv.push(want.len());
            dtl_add(&mut hv, &want);
            val rs: i64 = c.cur_rec_seq;
            c.out.push(dtl_record_with_seq(c, DTLS_CT_HANDSHAKE, 0, rs, dtl_hs_msg(DTLS_HS_HELLO_VERIFY, mseq, &hv)));
            if c.w_seqs.get(0) <= rs {
                c.w_seqs.set(0, rs + 1);
            }
            c.hello_verify = c.hello_verify + 1;
            return;
        }
    }
    if !dtl_has(&h.suites, DTLS_SUITE) || !dtl_has(&h.comps, 0) {
        dtl_fail(c, DTLS_ALERT_HANDSHAKE_FAILURE, "client does not offer ECDHE-ECDSA-AES128-GCM-SHA256");
        return;
    }
    val gi: i64 = dtl_ext_at(&h, DTL_EXT_GROUPS);
    if gi >= 0 && !dtl_has(&dtl_u16_list(&h.ext_data.get(gi)), DTL_SECP256R1) {
        dtl_fail(c, DTLS_ALERT_HANDSHAKE_FAILURE, "client does not offer secp256r1");
        return;
    }
    val si: i64 = dtl_ext_at(&h, DTL_EXT_SIG_ALGS);
    if si >= 0 && !dtl_has(&dtl_u16_list(&h.ext_data.get(si)), DTL_ECDSA_SHA256) {
        dtl_fail(c, DTLS_ALERT_HANDSHAKE_FAILURE, "client does not offer ecdsa_secp256r1_sha256");
        return;
    }
    c.ems = dtl_ext_at(&h, DTL_EXT_EMS) >= 0;
    if c.cfg.require_ems && !c.ems {
        dtl_fail(c, DTLS_ALERT_HANDSHAKE_FAILURE, "no extended master secret");
        return;
    }
    if c.cfg.srtp_profiles.len() > 0 {
        val ui: i64 = dtl_ext_at(&h, DTL_EXT_USE_SRTP);
        var offered: Vec<i64> = Vec::new();
        if ui >= 0 {
            offered = dtl_u16_list(&h.ext_data.get(ui));
        }
        var i: i64 = 0;
        while i < c.cfg.srtp_profiles.len() && c.srtp_profile == 0 {
            if dtl_has(&offered, c.cfg.srtp_profiles.get(i)) {
                c.srtp_profile = c.cfg.srtp_profiles.get(i);
            }
            i = i + 1;
        }
        if c.srtp_profile == 0 {
            dtl_fail(c, DTLS_ALERT_HANDSHAKE_FAILURE, "no common SRTP profile");
            return;
        }
    }
    c.client_random = h.random;
    c.server_random = dtl_random(c, 32);
    while c.rb_seq.len() > 0 {
        dtl_rb_remove(c, 0);
    }
    c.hs_recv_seq = mseq + 1;
    c.hs_send_seq = mseq;
    c.transcript = dtl_hs_msg(DTLS_HS_CLIENT_HELLO, mseq, &body);
    c.peer_flight_seq = mseq;
    c.fresh_peer_flight = false;
    dtl_flight_clear(c);
    // ServerHello
    var sh: Vec<i64> = Vec::new();
    sh.push(254);
    sh.push(253);
    dtl_add(&mut sh, &c.server_random);
    sh.push(0);
    dtl_put(&mut sh, DTLS_SUITE, 2);
    sh.push(0);
    var ex: Vec<i64> = Vec::new();
    var rn: Vec<i64> = Vec::new();
    rn.push(0);
    dtl_ext(&mut ex, DTL_EXT_RENEG, rn);
    if c.ems {
        var none: Vec<i64> = Vec::new();
        dtl_ext(&mut ex, DTL_EXT_EMS, none);
    }
    var pf: Vec<i64> = Vec::new();
    pf.push(1);
    pf.push(0);
    dtl_ext(&mut ex, DTL_EXT_POINT_FORMATS, pf);
    if c.srtp_profile != 0 {
        var one: Vec<i64> = Vec::new();
        one.push(c.srtp_profile);
        dtl_ext(&mut ex, DTL_EXT_USE_SRTP, dtl_use_srtp_ext(&one));
    }
    dtl_put(&mut sh, ex.len(), 2);
    dtl_add(&mut sh, &ex);
    val m1: Vec<i64> = dtl_flight_add(c, DTLS_HS_SERVER_HELLO, sh, 0);
    dtl_add(&mut c.transcript, &m1);
    val m2: Vec<i64> = dtl_flight_add(c, DTLS_HS_CERTIFICATE, dtl_certificate_body(&c.cfg.cert_der), 0);
    dtl_add(&mut c.transcript, &m2);
    // ServerKeyExchange: named curve secp256r1, our ephemeral point, signed
    val pub_key: Vec<i64> = dtl_new_eph(c);
    var params: Vec<i64> = Vec::new();
    params.push(3);
    dtl_put(&mut params, DTL_SECP256R1, 2);
    params.push(65);
    dtl_add(&mut params, &pub_key);
    val ske: Vec<i64> = dtl_cat(params, dtl_signed(c, dtl_cat(dtl_cat(c.client_random, c.server_random), params)));
    val m3: Vec<i64> = dtl_flight_add(c, DTLS_HS_SERVER_KEY_EXCHANGE, ske, 0);
    dtl_add(&mut c.transcript, &m3);
    if c.cfg.require_client_cert {
        var cr: Vec<i64> = Vec::new();
        cr.push(1);
        cr.push(64);
        var sa: Vec<i64> = Vec::new();
        sa.push(DTL_ECDSA_SHA256);
        dtl_add(&mut cr, &dtl_list16(&sa, 2));
        dtl_put(&mut cr, 0, 2);
        val m4: Vec<i64> = dtl_flight_add(c, DTLS_HS_CERTIFICATE_REQUEST, cr, 0);
        dtl_add(&mut c.transcript, &m4);
        c.cert_requested = true;
        c.hs = DTL_S_WAIT_CERT;
    } else {
        c.hs = DTL_S_WAIT_CKE;
    }
    var empty: Vec<i64> = Vec::new();
    val m5: Vec<i64> = dtl_flight_add(c, DTLS_HS_SERVER_HELLO_DONE, empty, 0);
    dtl_add(&mut c.transcript, &m5);
    dtl_send_new_flight(c, true);
}

fn dtl_server_message(c: &mut DtlsConn, t: i64, mseq: i64, body: Vec<i64>) {
    val full: Vec<i64> = dtl_hs_msg(t, mseq, &body);
    if c.hs == DTL_S_WAIT_CERT && t == DTLS_HS_CERTIFICATE {
        val why: str = dtl_check_cert(c, dtl_first_cert(&body));
        if str_len(why) > 0 {
            dtl_fail(c, DTLS_ALERT_BAD_CERTIFICATE, why);
            return;
        }
        dtl_add(&mut c.transcript, &full);
        c.hs = DTL_S_WAIT_CKE;
        return;
    }
    if c.hs == DTL_S_WAIT_CKE && t == DTLS_HS_CLIENT_KEY_EXCHANGE {
        if body.len() != 66 || body.get(0) != 65 {
            dtl_fail(c, DTLS_ALERT_DECODE_ERROR, "bad ClientKeyExchange");
            return;
        }
        val curve: EcCurve = ec_p256();
        val pms: Vec<i64> = ecdh_shared(&curve, c.eph_key, dtl_slice(&body, 1, 66));
        if pms.len() == 0 {
            dtl_fail(c, DTLS_ALERT_ILLEGAL_PARAMETER, "client ECDHE key is not on the curve");
            return;
        }
        dtl_add(&mut c.transcript, &full);
        dtl_keys(c, pms);
        if c.peer_cert.len() > 0 {
            c.hs = DTL_S_WAIT_CV;
        } else {
            c.hs = DTL_S_WAIT_CCS;
        }
        return;
    }
    if c.hs == DTL_S_WAIT_CV && t == DTLS_HS_CERTIFICATE_VERIFY {
        if !dtl_verify_signed(c, c.transcript, &body, 0) {
            dtl_fail(c, DTLS_ALERT_DECRYPT_ERROR, "CertificateVerify does not verify");
            return;
        }
        dtl_add(&mut c.transcript, &full);
        c.hs = DTL_S_WAIT_CCS;
        return;
    }
    if c.hs == DTL_S_WAIT_FIN && t == DTLS_HS_FINISHED && c.r_epoch == 1 {
        val want: Vec<i64> = dtl_finished(c, "client finished");
        if !dtl_eq(&want, &body) {
            dtl_fail(c, DTLS_ALERT_DECRYPT_ERROR, "client Finished does not verify");
            return;
        }
        dtl_add(&mut c.transcript, &full);
        dtl_flight_clear(c);
        dtl_flight_add_ccs(c);
        c.w_epoch = 1;
        val fin: Vec<i64> = dtl_flight_add(c, DTLS_HS_FINISHED, dtl_finished(c, "server finished"), 1);
        dtl_add(&mut c.transcript, &fin);
        c.hs = DTL_DONE;
        c.state = DTLS_CONNECTED;
        // the last flight is resent only when the client's comes again
        dtl_send_new_flight(c, false);
        return;
    }
    dtl_fail(c, DTLS_ALERT_UNEXPECTED_MESSAGE, "unexpected handshake message " + int_to_str(t));
}
