// Fides real-time clock support, pure Fides.
//
//   - RtcTime (year, month, day, hour, minute, second, weekday) and the
//     proleptic Gregorian calendar: leap years, days per month, day of
//     week, day of year, conversion to and from Unix time (days from
//     civil / civil from days, Howard Hinnant's algorithms), adding
//     seconds, ISO 8601 text;
//   - the MC146818-style CMOS RTC of PCs: register indexes (0 seconds,
//     2 minutes, 4 hours, 6 weekday, 7 day, 8 month, 9 year, status A-D,
//     the ACPI century register 0x32), BCD or binary data mode and 12- or
//     24-hour mode from status B, the update-in-progress rule (read when
//     UIP is clear, twice, until two snapshots agree), decoding a register
//     snapshot to an RtcTime and encoding one back;
//   - BCD conversion with validation;
//   - alarms with "don't care" fields (as the CMOS alarm's 0xC0 values or
//     the mask bits of STM32 RTC alarms): matching, and the next time an
//     alarm fires after a given time;
//   - the STM32-style prescaler split of a 32.768 kHz crystal into the
//     1 Hz calendar clock.
//
// The seam: the CMOS registers are read with port I/O (index to 0x70,
// data from 0x71; see x86_cpu.fd cmos_read); this module works on the
// byte snapshot (a Vec of register values indexed by register number) so
// it runs anywhere. Everything else is computation.

module rtc;
 use vec; use string;

pub struct RtcTime {
    pub year: i64,
    pub month: i64,
    pub day: i64,
    pub hour: i64,
    pub minute: i64,
    pub second: i64,
    pub weekday: i64,
}

/// A time; the weekday is computed (0 = Sunday).
pub fn rtc_time(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64) -> RtcTime {
    return RtcTime { year: year, month: month, day: day, hour: hour, minute: minute, second: second, weekday: rtc_weekday(year, month, day) };
}

// ─── BCD ────────────────────────────────────────────────────────────────

/// Packed BCD byte to binary; -1 when a nibble is not a decimal digit.
pub fn rtc_bcd_to_bin(b: i64) -> i64 {
    val hi: i64 = (b >> 4) & 0xF;
    val lo: i64 = b & 0xF;
    if hi > 9 || lo > 9 { return -1; }
    return hi * 10 + lo;
}

/// 0..99 to packed BCD.
pub fn rtc_bin_to_bcd(v: i64) -> i64 {
    if v < 0 || v > 99 { p_panic("rtc: " + int_to_str(v) + " does not fit one BCD byte"); }
    return ((v / 10) << 4) | (v % 10);
}

// ─── Calendar ───────────────────────────────────────────────────────────

pub fn rtc_is_leap(y: i64) -> bool {
    return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
}

pub fn rtc_days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        if rtc_is_leap(y) { return 29; }
        return 28;
    }
    if m == 4 || m == 6 || m == 9 || m == 11 { return 30; }
    return 31;
}

/// 0 = Sunday .. 6 = Saturday (Sakamoto's method).
pub fn rtc_weekday(y0: i64, m: i64, d: i64) -> i64 {
    var t: Vec<i64> = Vec::new();
    t.push(0); t.push(3); t.push(2); t.push(5); t.push(0); t.push(3);
    t.push(5); t.push(1); t.push(4); t.push(6); t.push(2); t.push(4);
    var y: i64 = y0;
    if m < 3 { y = y - 1; }
    var w: i64 = (y + y / 4 - y / 100 + y / 400 + t.get(m - 1) + d) % 7;
    if w < 0 { w = w + 7; }
    return w;
}

pub fn rtc_weekday_name(w: i64) -> str {
    val n: Vec<str> = str_split("Sunday,Monday,Tuesday,Wednesday,Thursday,Friday,Saturday", ",");
    return n.get(((w % 7) + 7) % 7);
}

/// 1-based day of the year.
pub fn rtc_day_of_year(y: i64, m: i64, d: i64) -> i64 {
    var n: i64 = d;
    var k: i64 = 1;
    while k < m {
        n = n + rtc_days_in_month(y, k);
        k = k + 1;
    }
    return n;
}

fn rtc_floor_div(a: i64, b: i64) -> i64 {
    var q: i64 = a / b;
    if (a % b != 0) && ((a < 0) != (b < 0)) { q = q - 1; }
    return q;
}

/// Days since 1970-01-01 (negative before).
pub fn rtc_days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    var y: i64 = y0;
    if m <= 2 { y = y - 1; }
    val era: i64 = rtc_floor_div(y, 400);
    val yoe: i64 = y - era * 400;
    var mp: i64 = m - 3;
    if m <= 2 { mp = m + 9; }
    val doy: i64 = (153 * mp + 2) / 5 + d - 1;
    val doe: i64 = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

/// The date of a day count since 1970-01-01, packed y * 10000 + m * 100 + d.
pub fn rtc_civil_from_days(z0: i64) -> i64 {
    val z: i64 = z0 + 719468;
    val era: i64 = rtc_floor_div(z, 146097);
    val doe: i64 = z - era * 146097;
    val yoe: i64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    var y: i64 = yoe + era * 400;
    val doy: i64 = doe - (365 * yoe + yoe / 4 - yoe / 100);
    val mp: i64 = (5 * doy + 2) / 153;
    val d: i64 = doy - (153 * mp + 2) / 5 + 1;
    var m: i64 = mp + 3;
    if mp >= 10 { m = mp - 9; }
    if m <= 2 { y = y + 1; }
    return y * 10000 + m * 100 + d;
}

/// Unix time (seconds since 1970-01-01T00:00:00Z, no leap seconds).
pub fn rtc_to_unix(t: RtcTime) -> i64 {
    return rtc_days_from_civil(t.year, t.month, t.day) * 86400 + t.hour * 3600 + t.minute * 60 + t.second;
}

pub fn rtc_from_unix(u: i64) -> RtcTime {
    val days: i64 = rtc_floor_div(u, 86400);
    val secs: i64 = u - days * 86400;
    val ymd: i64 = rtc_civil_from_days(days);
    return rtc_time(ymd / 10000, (ymd / 100) % 100, ymd % 100, secs / 3600, (secs / 60) % 60, secs % 60);
}

pub fn rtc_add_seconds(t: RtcTime, s: i64) -> RtcTime {
    return rtc_from_unix(rtc_to_unix(t) + s);
}

/// True when every field is in range for its month and year.
pub fn rtc_valid(t: RtcTime) -> bool {
    if t.month < 1 || t.month > 12 { return false; }
    if t.day < 1 || t.day > rtc_days_in_month(t.year, t.month) { return false; }
    if t.hour < 0 || t.hour > 23 || t.minute < 0 || t.minute > 59 { return false; }
    return t.second >= 0 && t.second <= 59;
}

fn rtc_two(v: i64) -> str {
    if v < 10 { return "0" + int_to_str(v); }
    return int_to_str(v);
}

/// "2024-02-29T13:45:00".
pub fn rtc_iso(t: RtcTime) -> str {
    var y: str = int_to_str(t.year);
    while str_len(y) < 4 { y = "0" + y; }
    return y + "-" + rtc_two(t.month) + "-" + rtc_two(t.day) + "T" + rtc_two(t.hour) + ":" + rtc_two(t.minute) + ":" + rtc_two(t.second);
}

/// Seconds from a to b.
pub fn rtc_diff(a: RtcTime, b: RtcTime) -> i64 {
    return rtc_to_unix(b) - rtc_to_unix(a);
}

// ─── CMOS RTC (MC146818) ────────────────────────────────────────────────

pub const CMOS_SECONDS: i64 = 0x00;
pub const CMOS_ALARM_SECONDS: i64 = 0x01;
pub const CMOS_MINUTES: i64 = 0x02;
pub const CMOS_ALARM_MINUTES: i64 = 0x03;
pub const CMOS_HOURS: i64 = 0x04;
pub const CMOS_ALARM_HOURS: i64 = 0x05;
pub const CMOS_WEEKDAY: i64 = 0x06;
pub const CMOS_DAY: i64 = 0x07;
pub const CMOS_MONTH: i64 = 0x08;
pub const CMOS_YEAR: i64 = 0x09;
pub const CMOS_STATUS_A: i64 = 0x0A;
pub const CMOS_STATUS_B: i64 = 0x0B;
pub const CMOS_STATUS_C: i64 = 0x0C;
pub const CMOS_STATUS_D: i64 = 0x0D;
pub const CMOS_CENTURY: i64 = 0x32;

pub const CMOS_A_UIP: i64 = 0x80;
pub const CMOS_B_SET: i64 = 0x80;
pub const CMOS_B_PIE: i64 = 0x40;
pub const CMOS_B_AIE: i64 = 0x20;
pub const CMOS_B_UIE: i64 = 0x10;
pub const CMOS_B_BINARY: i64 = 0x04;
pub const CMOS_B_24H: i64 = 0x02;
/// Alarm "don't care" values are 0xC0..0xFF.
pub const CMOS_DONT_CARE: i64 = 0xC0;

/// A snapshot may be used only when it was read with UIP clear.
pub fn cmos_update_in_progress(regs: Vec<i64>) -> bool {
    return (regs.get(CMOS_STATUS_A) & CMOS_A_UIP) != 0;
}

/// The read discipline: two snapshots taken back to back are trusted when
/// neither saw UIP and the time registers agree.
pub fn cmos_snapshots_agree(a: Vec<i64>, b: Vec<i64>) -> bool {
    if cmos_update_in_progress(a) || cmos_update_in_progress(b) { return false; }
    var idx: Vec<i64> = Vec::new();
    idx.push(0); idx.push(2); idx.push(4); idx.push(7); idx.push(8); idx.push(9);
    var i: i64 = 0;
    while i < idx.len() {
        if a.get(idx.get(i)) != b.get(idx.get(i)) { return false; }
        i = i + 1;
    }
    if a.len() > CMOS_CENTURY && b.len() > CMOS_CENTURY && a.get(CMOS_CENTURY) != b.get(CMOS_CENTURY) { return false; }
    return true;
}

fn cmos_field(v: i64, binary: bool) -> i64 {
    if binary { return v; }
    return rtc_bcd_to_bin(v);
}

/// Decode a snapshot (index = register number; the century register is
/// used when the snapshot reaches 0x32 and it is non-zero, else years
/// < 70 are 20xx). Hours in 12-hour mode carry PM in bit 7. Returns a
/// time with year 0 when a field is not valid BCD or out of range.
pub fn cmos_decode(regs: Vec<i64>) -> RtcTime {
    val sb: i64 = regs.get(CMOS_STATUS_B);
    val bin: bool = (sb & CMOS_B_BINARY) != 0;
    val h24: bool = (sb & CMOS_B_24H) != 0;
    val bad: RtcTime = RtcTime { year: 0, month: 0, day: 0, hour: 0, minute: 0, second: 0, weekday: 0 };
    val s: i64 = cmos_field(regs.get(CMOS_SECONDS), bin);
    val mi: i64 = cmos_field(regs.get(CMOS_MINUTES), bin);
    val hr: i64 = regs.get(CMOS_HOURS);
    var h: i64 = cmos_field(hr & 0x7F, bin);
    val d: i64 = cmos_field(regs.get(CMOS_DAY), bin);
    val mo: i64 = cmos_field(regs.get(CMOS_MONTH), bin);
    val yy: i64 = cmos_field(regs.get(CMOS_YEAR), bin);
    if s < 0 || mi < 0 || h < 0 || d < 0 || mo < 0 || yy < 0 { return bad; }
    if !h24 {
        if h < 1 || h > 12 { return bad; }
        val pm: bool = (hr & 0x80) != 0;
        if h == 12 { h = 0; }
        if pm { h = h + 12; }
    }
    var year: i64 = 0;
    var cent: i64 = 0;
    if regs.len() > CMOS_CENTURY && regs.get(CMOS_CENTURY) != 0 { cent = cmos_field(regs.get(CMOS_CENTURY), bin); }
    if cent > 0 {
        year = cent * 100 + yy;
    } else if yy < 70 {
        year = 2000 + yy;
    } else {
        year = 1900 + yy;
    }
    val t: RtcTime = rtc_time(year, mo, d, h, mi, s);
    if !rtc_valid(t) { return bad; }
    return t;
}

fn cmos_put(v: i64, binary: bool) -> i64 {
    if binary { return v; }
    return rtc_bin_to_bcd(v);
}

/// Register writes that set the clock, as (register, value) pairs packed
/// reg * 256 + value, in the order a driver issues them: SET in status B
/// first (the clock stops updating), the time, the century, status B with
/// SET clear last.
pub fn cmos_encode(t: RtcTime, status_b: i64) -> Vec<i64> {
    val bin: bool = (status_b & CMOS_B_BINARY) != 0;
    val h24: bool = (status_b & CMOS_B_24H) != 0;
    var out: Vec<i64> = Vec::new();
    out.push(CMOS_STATUS_B * 256 + ((status_b | CMOS_B_SET) & 0xFF));
    out.push(CMOS_SECONDS * 256 + cmos_put(t.second, bin));
    out.push(CMOS_MINUTES * 256 + cmos_put(t.minute, bin));
    var hv: i64 = 0;
    if h24 {
        hv = cmos_put(t.hour, bin);
    } else {
        var h12: i64 = t.hour % 12;
        if h12 == 0 { h12 = 12; }
        hv = cmos_put(h12, bin);
        if t.hour >= 12 { hv = hv | 0x80; }
    }
    out.push(CMOS_HOURS * 256 + hv);
    out.push(CMOS_WEEKDAY * 256 + cmos_put(t.weekday + 1, bin));
    out.push(CMOS_DAY * 256 + cmos_put(t.day, bin));
    out.push(CMOS_MONTH * 256 + cmos_put(t.month, bin));
    out.push(CMOS_YEAR * 256 + cmos_put(t.year % 100, bin));
    out.push(CMOS_CENTURY * 256 + cmos_put(t.year / 100, bin));
    out.push(CMOS_STATUS_B * 256 + ((status_b & ~CMOS_B_SET) & 0xFF));
    return out;
}

/// Apply packed register writes to a snapshot (what the chip would hold).
pub fn cmos_apply(regs: &mut Vec<i64>, writes: Vec<i64>) {
    var i: i64 = 0;
    while i < writes.len() {
        val w: i64 = writes.get(i);
        regs.set(w / 256, w % 256);
        i = i + 1;
    }
}

/// Status C bits: interrupt flags (reading clears them on the chip).
pub fn cmos_irq_flags(c: i64) -> str {
    var out: Vec<str> = Vec::new();
    if (c & 0x40) != 0 { out.push("periodic"); }
    if (c & 0x20) != 0 { out.push("alarm"); }
    if (c & 0x10) != 0 { out.push("update"); }
    return str_join(out, " ");
}

/// Periodic interrupt rate from status A's RS bits (3..15): 32768 >> (rs - 1) Hz.
pub fn cmos_periodic_hz(rs: i64) -> i64 {
    if rs < 3 || rs > 15 { return 0; }
    return 32768 >> (rs - 1);
}

// ─── Alarms ─────────────────────────────────────────────────────────────

/// An alarm: each field -1 means "any". weekday 0 = Sunday.
pub struct RtcAlarm {
    pub day: i64,
    pub weekday: i64,
    pub hour: i64,
    pub minute: i64,
    pub second: i64,
}

pub fn rtc_alarm(day: i64, weekday: i64, hour: i64, minute: i64, second: i64) -> RtcAlarm {
    return RtcAlarm { day: day, weekday: weekday, hour: hour, minute: minute, second: second };
}

fn rtc_f(want: i64, have: i64) -> bool {
    return want < 0 || want == have;
}

pub fn rtc_alarm_matches(a: RtcAlarm, t: RtcTime) -> bool {
    return rtc_f(a.day, t.day) && rtc_f(a.weekday, t.weekday) && rtc_f(a.hour, t.hour) && rtc_f(a.minute, t.minute) && rtc_f(a.second, t.second);
}

/// Earliest second of the day >= h0:m0:s0 matching the alarm's time
/// fields; -1 when none.
fn rtc_alarm_tod(a: RtcAlarm, h0: i64, m0: i64, s0: i64) -> i64 {
    var h: i64 = h0;
    while h < 24 {
        if rtc_f(a.hour, h) {
            var m: i64 = 0;
            if h == h0 { m = m0; }
            while m < 60 {
                if rtc_f(a.minute, m) {
                    var s: i64 = 0;
                    if h == h0 && m == m0 { s = s0; }
                    if a.second >= 0 {
                        if a.second >= s { return h * 3600 + m * 60 + a.second; }
                    } else if s < 60 {
                        return h * 3600 + m * 60 + s;
                    }
                }
                m = m + 1;
            }
        }
        h = h + 1;
    }
    return -1;
}

/// The first time strictly after `from` at which the alarm matches,
/// searched over 4 years (a 31st, or a 29th of February, comes round
/// within that). Year 0 when it does not fire within the window (a
/// field out of range, such as day 32 or hour 24).
pub fn rtc_alarm_next(a: RtcAlarm, from: RtcTime) -> RtcTime {
    val start: RtcTime = rtc_add_seconds(from, 1);
    val day0: i64 = rtc_days_from_civil(start.year, start.month, start.day);
    var k: i64 = 0;
    while k < 1461 {
        val ymd: i64 = rtc_civil_from_days(day0 + k);
        val y: i64 = ymd / 10000;
        val mo: i64 = (ymd / 100) % 100;
        val d: i64 = ymd % 100;
        if rtc_f(a.day, d) && rtc_f(a.weekday, rtc_weekday(y, mo, d)) {
            var tod: i64 = -1;
            if k == 0 {
                tod = rtc_alarm_tod(a, start.hour, start.minute, start.second);
            } else {
                tod = rtc_alarm_tod(a, 0, 0, 0);
            }
            if tod >= 0 { return rtc_time(y, mo, d, tod / 3600, (tod / 60) % 60, tod % 60); }
        }
        k = k + 1;
    }
    return RtcTime { year: 0, month: 0, day: 0, hour: 0, minute: 0, second: 0, weekday: 0 };
}

/// CMOS alarm registers (seconds, minutes, hours) for an alarm in BCD
/// 24-hour mode: a "don't care" field is 0xC0.
pub fn cmos_alarm_regs(a: RtcAlarm) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if a.second < 0 { out.push(CMOS_DONT_CARE); } else { out.push(rtc_bin_to_bcd(a.second)); }
    if a.minute < 0 { out.push(CMOS_DONT_CARE); } else { out.push(rtc_bin_to_bcd(a.minute)); }
    if a.hour < 0 { out.push(CMOS_DONT_CARE); } else { out.push(rtc_bin_to_bcd(a.hour)); }
    return out;
}

// ─── Prescalers ─────────────────────────────────────────────────────────

/// Split a crystal frequency into async (7-bit) and sync (15-bit)
/// prescalers giving exactly 1 Hz, async as large as possible (lowest
/// power): packed async * 65536 + sync, -1 when impossible.
pub fn rtc_prescalers(clk_hz: i64) -> i64 {
    var a: i64 = 128;
    while a >= 1 {
        if clk_hz % a == 0 {
            val s: i64 = clk_hz / a;
            if s >= 1 && s <= 32768 { return (a - 1) * 65536 + (s - 1); }
        }
        a = a - 1;
    }
    return -1;
}
