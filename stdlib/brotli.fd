// Fides Brotli standard library
//
// Pure-Fides Brotli decompressor (RFC 7932), and a compressor
// (brotli_compress, brotli_compress_level, brotli_compress_str; see
// "Compression" at the end of this file).
//
// Implements the whole format:
//   - the stream header (window bits, WBITS 10..24);
//   - meta-blocks: compressed, uncompressed, empty, and metadata (skipped);
//   - simple and complex prefix codes (code-length codes with the repeat
//     codes 16 and 17);
//   - block types and block counts for literals, insert-and-copy commands
//     and distances, with the block-type ring;
//   - the four literal context modes (LSB6, MSB6, UTF8, signed), context
//     maps with run-length codes and the inverse move-to-front transform;
//   - distance codes with NPOSTFIX/NDIRECT, the 16 short codes and the
//     4-entry distance ring buffer;
//   - insert-and-copy commands, overlapping copies;
//   - static dictionary references with all 121 word transforms. The
//     dictionary (122,784 bytes) is compiled into the program from
//     stdlib/brotli_dict.fd (generated by scripts/gen-brotli-dict.py), so
//     native executables need no file at run time.
//
// Limits:
//   - the "large window" extension (WBITS up to 30, not in RFC 7932) and
//     shared dictionaries are rejected as malformed;
//   - the input is one complete stream in memory (no streaming): trailing
//     bytes after the last meta-block are an error, as in the reference
//     decoder;
//   - output is capped (256 MB by default, brotli_decompress_limit to
//     choose); a stream that would exceed the cap is an error;
//   - more than 65536 commands in a row that write nothing (dictionary
//     words cut to zero bytes by their transform) are rejected, so that
//     a hostile stream cannot loop without progress; no encoder makes
//     such commands;
//   - the decoder reads codes bit by bit (canonical decode, no lookup
//     tables): simple and safe, not fast. Under `fid run` (the
//     interpreter) expect about a hundred bytes of output per second.
//
// Malformed input never panics: every read is bounds-checked and a bad
// stream gives an empty result. brotli_error tells why, and tells an
// empty result from an error apart from a valid stream of zero bytes.
//
// Checked against the reference decoder (Python's brotli 1.2.1) on 522
// streams (quality 0-11, both modes, lgwin 10-24, text, UTF-8, binary,
// random data, the dictionary itself) and 1800 corrupted streams: same
// output, and an error exactly where the reference reports one.
//
// Usage:
//   use brotli;
//   val bytes: Vec<i64> = brotli_decompress(stream);   // empty on error
//   if !brotli_ok(stream) { println(brotli_error(stream)); }
//   println(brotli_decompress_str(stream));

module brotli;
 use brotli_dict;
// ─── Decoder state ──────────────────────────────────────────────────────

struct BrS {
    data: Vec<i64>,
    inlen: i64,
    ipos: i64,
    // next input byte to load into acc
    acc: i64,
    // bit buffer, LSB first
    nacc: i64,
    // bits in acc
    out: Vec<i64>,
    max_out: i64,
    err: str,
    // "" while the stream is valid
    // Every prefix code of the current meta-block, canonical form:
    hcnt: Vec<i64>,
    // 16 code-length counts per code
    hcb: Vec<i64>,
    // code -> its counts in hcnt
    hsym: Vec<i64>,
    // symbols ordered by (length, value)
    hbase: Vec<i64>,
    // code -> its symbols in hsym
    hone: Vec<i64>,
    // code -> its only symbol (0-bit code), or -1
    // Distance ring buffer (kept across meta-blocks).
    rb: Vec<i64>,
    rbi: i64,
    // Block switching, per category (0 literal, 1 command, 2 distance).
    nbl: Vec<i64>,
    bt: Vec<i64>,
    rb1: Vec<i64>,
    // second-to-last block type
    rb2: Vec<i64>,
    // last block type
    btt: Vec<i64>,
    // block-type code
    bct: Vec<i64>,
    // block-count code
    // Length tables.
    insb: Vec<i64>,
    inse: Vec<i64>,
    cpyb: Vec<i64>,
    cpye: Vec<i64>,
    blb: Vec<i64>,
    ble: Vec<i64>,
    lut0: Vec<i64>,
    // UTF8 context of the last byte, 0..127 (built on use)
    // Dictionary reader cache.
    dci: i64,
    dcs: str,
    dgi: i64,
    dgv: i64,
}

fn ins_extra(c: i64) -> i64 {
    if c < 6 {
        return 0;
    }
    if c < 16 {
        return (c - 4) >> 1;
    }
    if c < 21 {
        return c - 10;
    }
    if c == 21 {
        return 12;
    }
    if c == 22 {
        return 14;
    }
    return 24;
}

fn cpy_extra(c: i64) -> i64 {
    if c < 8 {
        return 0;
    }
    if c < 18 {
        return (c - 6) >> 1;
    }
    if c < 23 {
        return c - 12;
    }
    return 24;
}

fn bl_extra(c: i64) -> i64 {
    if c < 16 {
        return 2 + (c >> 2);
    }
    if c < 18 {
        return 6;
    }
    if c < 25 {
        return c - 11;
    }
    return 24;
}

fn br_new(data: Vec<i64>, max_out: i64) -> BrS {
    var s: BrS = BrS {
        data: data, inlen: data.len(), ipos: 0, acc: 0, nacc: 0, out: Vec::new(), max_out: max_out, err: "", hcnt: Vec::new(), hcb: Vec::new(), hsym: Vec::new(), hbase: Vec::new(), hone: Vec::new(), rb: Vec::new(), rbi: 4, nbl: Vec::new(), bt: Vec::new(), rb1: Vec::new(), rb2: Vec::new(), btt: Vec::new(), bct: Vec::new(), insb: Vec::new(), inse: Vec::new(), cpyb: Vec::new(), cpye: Vec::new(), blb: Vec::new(), ble: Vec::new(), lut0: Vec::new(), dci: - 1, dcs: "", dgi: - 1, dgv: 0,
    };
    // last distance 4, then 11, 15, 16
    s.rb.push(16);
    s.rb.push(15);
    s.rb.push(11);
    s.rb.push(4);
    var c: i64 = 0;
    while c < 3 {
        s.nbl.push(1);
        s.bt.push(0);
        s.rb1.push(1);
        s.rb2.push(0);
        s.btt.push(- 1);
        s.bct.push(- 1);
        c = c + 1;
    }
    var ib: i64 = 0;
    var cb: i64 = 2;
    c = 0;
    while c < 24 {
        s.insb.push(ib);
        s.inse.push(ins_extra(c));
        ib = ib + (1 << ins_extra(c));
        s.cpyb.push(cb);
        s.cpye.push(cpy_extra(c));
        cb = cb + (1 << cpy_extra(c));
        c = c + 1;
    }
    var bb: i64 = 1;
    c = 0;
    while c < 26 {
        s.blb.push(bb);
        s.ble.push(bl_extra(c));
        bb = bb + (1 << bl_extra(c));
        c = c + 1;
    }
    return s;
}

// Record the first error; returns -1 so callers can `return br_fail(...)`.
fn br_fail(s: & mut BrS, msg: str) -> i64 {
    if str_len(s.err) == 0 {
        s.err = msg;
    }
    return - 1;
}

fn br_failed(s: & mut BrS) -> bool {
    return str_len(s.err) > 0;
}

// ─── Bit reader ─────────────────────────────────────────────────────────
// Bits are read LSB first. Past the end of the input the reader supplies
// zero bits; bs_over tells whether any of them were consumed.

fn bs_fill(s: & mut BrS, n: i64) -> void {
    while s.nacc < n {
        var b: i64 = 0;
        if s.ipos < s.inlen {
            b = s.data[s.ipos] & 255;
        }
        s.acc = s.acc | (b << s.nacc);
        s.ipos = s.ipos + 1;
        s.nacc = s.nacc + 8;
    }
}

fn bs_bits(s: & mut BrS, n: i64) -> i64 {
    if n == 0 {
        return 0;
    }
    bs_fill(s, n);
    val v: i64 = s.acc & ((1 << n) - 1);
    s.acc = s.acc >> n;
    s.nacc = s.nacc - n;
    return v;
}

fn bs_over(s: & mut BrS) -> bool {
    return (s.ipos - s.inlen) * 8 > s.nacc;
}

// Skip to the next byte boundary; the skipped bits must be zero.
fn bs_align(s: & mut BrS) -> bool {
    return bs_bits(s, s.nacc & 7) == 0;
}

// After bs_align: skip n bytes (copy them to the output when keep).
fn bs_bytes(s: & mut BrS, n: i64, keep: bool) -> bool {
    var left: i64 = n;
    while left > 0 && s.nacc > 0 {
        val b: i64 = bs_bits(s, 8);
        if keep {
            s.out.push(b);
        }
        left = left - 1;
    }
    if bs_over(s) {
        return false;
    }
    if s.ipos + left > s.inlen {
        return false;
    }
    if keep {
        var i: i64 = 0;
        while i < left {
            s.out.push(s.data[s.ipos + i] & 255);
            i = i + 1;
        }
    }
    s.ipos = s.ipos + left;
    return true;
}

// ─── Prefix codes ───────────────────────────────────────────────────────

// Add a canonical code from (symbol, length) pairs, symbols ascending.
// One pair makes a 0-bit code. Returns the code's id.
fn h_add(s: & mut BrS, psym: Vec<i64>, plen: Vec<i64>) -> i64 {
    val id: i64 = s.hone.len();
    val n: i64 = psym.len();
    if n == 0 {
        return br_fail(s, "empty prefix code");
    }
    s.hbase.push(s.hsym.len());
    s.hcb.push(s.hcnt.len());
    if n == 1 {
        s.hone.push(psym[0]);
        return id;
    }
    s.hone.push(- 1);
    var cnt: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 16 {
        cnt.push(0);
        i = i + 1;
    }
    i = 0;
    while i < n {
        val l: i64 = plen[i];
        cnt[l] = cnt[l] + 1;
        i = i + 1;
    }
    var offs: Vec<i64> = Vec::new();
    var o: i64 = 0;
    i = 0;
    while i < 16 {
        offs.push(o);
        o = o + cnt[i];
        i = i + 1;
    }
    var place: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        place.push(0);
        i = i + 1;
    }
    i = 0;
    while i < n {
        val l2: i64 = plen[i];
        place[offs[l2]] = psym[i];
        offs[l2] = offs[l2] + 1;
        i = i + 1;
    }
    i = 0;
    while i < 16 {
        s.hcnt.push(cnt[i]);
        i = i + 1;
    }
    i = 0;
    while i < n {
        s.hsym.push(place[i]);
        i = i + 1;
    }
    return id;
}

// Decode one symbol with code t; -1 if the bits match no code.
fn h_dec(s: & mut BrS, t: i64) -> i64 {
    val one: i64 = s.hone[t];
    if one >= 0 {
        return one;
    }
    bs_fill(s, 15);
    var acc: i64 = s.acc;
    var code: i64 = 0;
    var first: i64 = 0;
    var index: i64 = s.hbase[t];
    val cb: i64 = s.hcb[t];
    var len: i64 = 1;
    while len <= 15 {
        code = code | (acc & 1);
        acc = acc >> 1;
        val count: i64 = s.hcnt[cb + len];
        if code - first < count {
            s.acc = acc;
            s.nacc = s.nacc - len;
            return s.hsym[index + code - first];
        }
        index = index + count;
        first = (first + count) << 1;
        code = code << 1;
        len = len + 1;
    }
    return br_fail(s, "invalid prefix code");
}

// Order in which code-length code lengths are stored.
fn cl_order(i: i64) -> i64 {
    if i < 4 {
        return i + 1;
    }
    if i == 4 {
        return 0;
    }
    if i == 5 {
        return 5;
    }
    if i == 6 {
        return 17;
    }
    if i == 7 {
        return 6;
    }
    if i == 8 {
        return 16;
    }
    return i - 2;
}

// Read a prefix code over an alphabet of asize symbols (RFC 7932 3.4-3.5).
// Returns its id, or -1 on a malformed code.
fn read_prefix(s: & mut BrS, asize: i64) -> i64 {
    val hskip: i64 = bs_bits(s, 2);
    var psym: Vec<i64> = Vec::new();
    var plen: Vec<i64> = Vec::new();
    if hskip == 1 {
        // simple prefix code
        var nbits: i64 = 0;
        while (1 << nbits) < asize {
            nbits = nbits + 1;
        }
        val nsym: i64 = bs_bits(s, 2) + 1;
        var i: i64 = 0;
        while i < nsym {
            val v: i64 = bs_bits(s, nbits);
            if v >= asize {
                return br_fail(s, "prefix code symbol out of range");
            }
            var j: i64 = 0;
            while j < i {
                if psym[j] == v {
                    return br_fail(s, "repeated symbol in prefix code");
                }
                j = j + 1;
            }
            psym.push(v);
            i = i + 1;
        }
        if nsym == 1 {
            plen.push(0);
        } else if nsym == 2 {
            plen.push(1);
            plen.push(1);
        } else if nsym == 3 {
            plen.push(1);
            plen.push(2);
            plen.push(2);
        } else if bs_bits(s, 1) == 0 {
            plen.push(2);
            plen.push(2);
            plen.push(2);
            plen.push(2);
        } else {
            plen.push(1);
            plen.push(2);
            plen.push(3);
            plen.push(3);
        }
        // order the pairs by symbol (at most 4)
        var a: i64 = 1;
        while a < nsym {
            var b: i64 = a;
            while b > 0 && psym[b - 1] > psym[b] {
                val ts: i64 = psym[b];
                psym[b] = psym[b - 1];
                psym[b - 1] = ts;
                val tl: i64 = plen[b];
                plen[b] = plen[b - 1];
                plen[b - 1] = tl;
                b = b - 1;
            }
            a = a + 1;
        }
        return h_add(s, psym, plen);
    }
    // complex prefix code: first the code-length code
    var cl: Vec<i64> = Vec::new();
    var i2: i64 = 0;
    while i2 < 18 {
        cl.push(0);
        i2 = i2 + 1;
    }
    var space: i64 = 32;
    var num: i64 = 0;
    i2 = hskip;
    while i2 < 18 {
        bs_fill(s, 4);
        val p: i64 = s.acc & 15;
        var v2: i64 = 0;
        var l: i64 = 2;
        if (p & 3) == 1 {
            v2 = 4;
        } else if (p & 3) == 2 {
            v2 = 3;
        } else if (p & 3) == 3 {
            if (p & 4) == 0 {
                v2 = 2;
                l = 3;
            } else if (p & 8) == 0 {
                v2 = 1;
                l = 4;
            } else {
                v2 = 5;
                l = 4;
            }
        }
        s.acc = s.acc >> l;
        s.nacc = s.nacc - l;
        cl[cl_order(i2)] = v2;
        if v2 != 0 {
            space = space - (32 >> v2);
            num = num + 1;
            if space <= 0 {
                break;
            }
        }
        i2 = i2 + 1;
    }
    if !(num == 1 || space == 0) {
        return br_fail(s, "invalid code-length code");
    }
    var csym: Vec<i64> = Vec::new();
    var clen: Vec<i64> = Vec::new();
    i2 = 0;
    while i2 < 18 {
        if cl[i2] != 0 {
            csym.push(i2);
            clen.push(cl[i2]);
        }
        i2 = i2 + 1;
    }
    val tid: i64 = h_add(s, csym, clen);
    if tid < 0 {
        return - 1;
    }
    // then the code lengths of the symbols
    var sym: i64 = 0;
    var prev: i64 = 8;
    var rep: i64 = 0;
    var replen: i64 = 0;
    var sp: i64 = 32768;
    while sym < asize && sp > 0 {
        val c: i64 = h_dec(s, tid);
        if c < 0 {
            return - 1;
        }
        if bs_over(s) {
            return br_fail(s, "truncated stream");
        }
        if c < 16 {
            rep = 0;
            if c != 0 {
                psym.push(sym);
                plen.push(c);
                prev = c;
                sp = sp - (32768 >> c);
            }
            sym = sym + 1;
        } else {
            var extra: i64 = 3;
            var nl: i64 = 0;
            if c == 16 {
                extra = 2;
                nl = prev;
            }
            if replen != nl {
                rep = 0;
                replen = nl;
            }
            val old: i64 = rep;
            if rep > 0 {
                rep = (rep - 2) << extra;
            }
            rep = rep + bs_bits(s, extra) + 3;
            val delta: i64 = rep - old;
            if sym + delta > asize {
                return br_fail(s, "code length repeat past the alphabet");
            }
            if replen != 0 {
                var k: i64 = 0;
                while k < delta {
                    psym.push(sym + k);
                    plen.push(replen);
                    k = k + 1;
                }
                sp = sp - (delta << (15 - replen));
            }
            sym = sym + delta;
        }
    }
    if sp != 0 {
        return br_fail(s, "incomplete prefix code");
    }
    return h_add(s, psym, plen);
}

// ─── Header fields ──────────────────────────────────────────────────────

fn read_varlen8(s: & mut BrS) -> i64 {
    if bs_bits(s, 1) == 0 {
        return 0;
    }
    val n: i64 = bs_bits(s, 3);
    if n == 0 {
        return 1;
    }
    return (1 << n) + bs_bits(s, n);
}

fn read_blen(s: & mut BrS, code: i64) -> i64 {
    val sym: i64 = h_dec(s, code);
    if sym < 0 || sym >= 26 {
        return br_fail(s, "invalid block count");
    }
    return s.blb[sym] + bs_bits(s, s.ble[sym]);
}

// Switch block type of category c; returns the new block count.
fn blk_switch(s: & mut BrS, c: i64) -> i64 {
    val n: i64 = s.nbl[c];
    if n < 2 {
        return br_fail(s, "block count overrun");
    }
    var t: i64 = h_dec(s, s.btt[c]);
    if t < 0 {
        return - 1;
    }
    if t == 1 {
        t = s.rb2[c] + 1;
    } else if t == 0 {
        t = s.rb1[c];
    } else {
        t = t - 2;
    }
    if t >= n {
        t = t - n;
    }
    s.rb1.set(c, s.rb2[c]);
    s.rb2.set(c, t);
    s.bt.set(c, t);
    return read_blen(s, s.bct[c]);
}

// Context map of `size` entries over `ntrees` codes (RFC 7932 7.3).
fn read_cmap(s: & mut BrS, size: i64, ntrees: i64) -> Vec<i64> {
    var m: Vec<i64> = Vec::new();
    var rlemax: i64 = 0;
    if bs_bits(s, 1) == 1 {
        rlemax = bs_bits(s, 4) + 1;
    }
    val tid: i64 = read_prefix(s, ntrees + rlemax);
    if tid < 0 {
        return m;
    }
    var i: i64 = 0;
    while i < size {
        val code: i64 = h_dec(s, tid);
        if code < 0 {
            return m;
        }
        if bs_over(s) {
            br_fail(s, "truncated stream");
            return m;
        }
        if code == 0 {
            m.push(0);
            i = i + 1;
        } else if code <= rlemax {
            val reps: i64 = (1 << code) + bs_bits(s, code);
            if i + reps > size {
                br_fail(s, "context map run too long");
                return m;
            }
            var k: i64 = 0;
            while k < reps {
                m.push(0);
                k = k + 1;
            }
            i = i + reps;
        } else {
            m.push(code - rlemax);
            i = i + 1;
        }
    }
    if bs_bits(s, 1) == 1 {
        // inverse move-to-front
        var mtf: Vec<i64> = Vec::new();
        var k2: i64 = 0;
        while k2 < ntrees {
            mtf.push(k2);
            k2 = k2 + 1;
        }
        i = 0;
        while i < size {
            val idx: i64 = m[i];
            val v: i64 = mtf[idx];
            m[i] = v;
            var j: i64 = idx;
            while j > 0 {
                mtf[j] = mtf[j - 1];
                j = j - 1;
            }
            mtf[0] = v;
            i = i + 1;
        }
    }
    return m;
}

// ─── Literal context (RFC 7932 7.1) ─────────────────────────────────────

// UTF8 mode, last byte p1 below 128: Lut0[p1] / 4 as hex digits.
fn lut0_hex() -> str {
    return "000000000110010000000000000000002343353467338393bbbbbbbbbb886a733cdddcdddcdddddcdddddcddddd637333efffefffefffffefffffefffff63730";
}

fn build_lut0(s: & mut BrS) -> void {
    val h: str = lut0_hex();
    var i: i64 = 0;
    while i < 128 {
        val c: i64 = str_byte_at(h, i);
        if c <= 57 {
            s.lut0.push((c - 48) * 4);
        } else {
            s.lut0.push((c - 87) * 4);
        }
        i = i + 1;
    }
}

// UTF8 mode, second-to-last byte (Lut1).
fn lut1(p: i64) -> i64 {
    if p < 33 {
        return 0;
    }
    if p < 48 {
        return 1;
    }
    if p < 58 {
        return 2;
    }
    if p < 65 {
        return 1;
    }
    if p < 91 {
        return 2;
    }
    if p < 97 {
        return 1;
    }
    if p < 123 {
        return 3;
    }
    if p < 127 {
        return 1;
    }
    if p < 224 {
        return 0;
    }
    return 2;
}

// Signed mode (Lut2).
fn lut2(p: i64) -> i64 {
    if p == 0 {
        return 0;
    }
    if p < 16 {
        return 1;
    }
    if p < 64 {
        return 2;
    }
    if p < 128 {
        return 3;
    }
    if p < 192 {
        return 4;
    }
    if p < 240 {
        return 5;
    }
    if p < 255 {
        return 6;
    }
    return 7;
}

fn lit_ctx(s: & mut BrS, mode: i64, p1: i64, p2: i64) -> i64 {
    if mode == 0 {
        return p1 & 63;
    }
    if mode == 1 {
        return p1 >> 2;
    }
    if mode == 2 {
        var a: i64 = 0;
        if p1 < 128 {
            a = s.lut0[p1];
        } else if p1 < 192 {
            a = p1 & 1;
        } else {
            a = 2 + (p1 & 1);
        }
        return a | lut1(p2);
    }
    return (lut2(p1) << 3) | lut2(p2);
}

// ─── Static dictionary and transforms (RFC 7932 8, Appendix B) ──────────

fn dict_ndbits(l: i64) -> i64 {
    if l < 6 {
        return 10;
    }
    if l < 8 {
        return 11;
    }
    if l < 13 {
        return 10;
    }
    if l < 15 {
        return 9;
    }
    if l == 15 {
        return 8;
    }
    if l < 18 {
        return 7;
    }
    if l == 18 {
        return 8;
    }
    if l < 21 {
        return 7;
    }
    if l < 23 {
        return 6;
    }
    return 5;
}

fn dict_offset(l: i64) -> i64 {
    var off: i64 = 0;
    var k: i64 = 4;
    while k < l {
        off = off + k * (1 << dict_ndbits(k));
        k = k + 1;
    }
    return off;
}

fn b64v(c: i64) -> i64 {
    if c >= 65 && c <= 90 {
        return c - 65;
    }
    if c >= 97 && c <= 122 {
        return c - 71;
    }
    if c >= 48 && c <= 57 {
        return c + 4;
    }
    if c == 43 {
        return 62;
    }
    return 63;
}

// Byte k of the dictionary, decoded from its base64 chunk.
fn dict_byte(s: & mut BrS, k: i64) -> i64 {
    val gid: i64 = k / 3;
    if gid != s.dgi {
        val cbytes: i64 = brotli_dict_chunk_bytes();
        val ci: i64 = k / cbytes;
        if ci != s.dci {
            s.dcs = brotli_dict_chunk(ci);
            s.dci = ci;
        }
        val p: i64 = ((k - ci * cbytes) / 3) * 4;
        s.dgv = (b64v(str_byte_at(s.dcs, p)) << 18) | (b64v(str_byte_at(s.dcs, p + 1)) << 12) | (b64v(str_byte_at(s.dcs, p + 2)) << 6) | b64v(str_byte_at(s.dcs, p + 3));
        s.dgi = gid;
    }
    return (s.dgv >> ((2 - (k - gid * 3)) * 8)) & 255;
}

// Transform types: 0 identity, 1-9 omit last n, 10 uppercase first,
// 11 uppercase all, 12-20 omit first n-11.
fn tr_type(t: i64) -> i64 {
    return str_byte_at("aaamkaaaakanbaakaaaaaaadaaocaakaaapaaaaqraealaaahbaaaausgakiaaafjkkalkaaaakaaakkaaalalalkaakaalaklakalaaklalkkllllllllklk", t) - 97;
}

fn tr_prefix(t: i64) -> str {
    if t == 2 || t == 6 || t == 15 || t == 30 || t == 33 || t == 52 || t == 65 || t == 71 || t == 81 || t == 83 || t == 85 || t == 89 || t == 91 || t == 96 || t == 98 || t == 103 || t == 109 || t == 110 || t == 111 || t == 115 || t == 117 || t == 118 || t == 119 || t == 120 {
        return " ";
    }
    if t == 7 {
        return "s ";
    }
    if t == 13 {
        return ", ";
    }
    if t == 18 {
        return "e ";
    }
    if t == 32 || t == 67 || t == 77 {
        return ".";
    }
    if t == 41 || t == 62 || t == 73 {
        return " the ";
    }
    if t == 72 {
        return ".com/";
    }
    return "";
    // transform 102 ("\xc2\xa0") is written by dict_word
}

fn tr_suffix(t: i64) -> str {
    if t == 1 || t == 2 || t == 4 || t == 7 || t == 13 || t == 15 || t == 18 || t == 68 || t == 77 || t == 83 {
        return " ";
    }
    if t == 5 {
        return " the ";
    }
    if t == 8 || t == 62 {
        return " of ";
    }
    if t == 10 {
        return " and ";
    }
    if t == 14 || t == 33 || t == 58 || t == 65 || t == 107 || t == 111 {
        return ", ";
    }
    if t == 16 {
        return " in ";
    }
    if t == 17 {
        return " to ";
    }
    if t == 19 || t == 66 || t == 87 {
        return "\"";
    }
    if t == 20 || t == 71 || t == 79 || t == 96 || t == 101 || t == 115 {
        return ".";
    }
    if t == 21 || t == 69 || t == 97 {
        return "\">";
    }
    if t == 22 {
        return "\n";
    }
    if t == 24 {
        return "]";
    }
    if t == 25 {
        return " for ";
    }
    if t == 28 {
        return " a ";
    }
    if t == 29 {
        return " that ";
    }
    if t == 31 || t == 52 || t == 88 || t == 91 || t == 114 || t == 117 {
        return ". ";
    }
    if t == 35 {
        return " with ";
    }
    if t == 36 || t == 74 || t == 94 {
        return "'";
    }
    if t == 37 {
        return " from ";
    }
    if t == 38 {
        return " by ";
    }
    if t == 43 {
        return ". The ";
    }
    if t == 45 {
        return " on ";
    }
    if t == 46 {
        return " as ";
    }
    if t == 47 {
        return " is ";
    }
    if t == 49 {
        return "ing ";
    }
    if t == 50 {
        return "\n\t";
    }
    if t == 51 {
        return ":";
    }
    if t == 53 {
        return "ed ";
    }
    if t == 57 || t == 67 || t == 78 || t == 89 || t == 113 {
        return "(";
    }
    if t == 60 {
        return " at ";
    }
    if t == 61 {
        return "ly ";
    }
    if t == 70 || t == 81 || t == 104 || t == 105 || t == 110 || t == 118 {
        return "=\"";
    }
    if t == 73 {
        return " of the ";
    }
    if t == 75 {
        return ". This ";
    }
    if t == 76 || t == 99 || t == 103 || t == 109 || t == 112 {
        return ",";
    }
    if t == 80 {
        return " not ";
    }
    if t == 82 {
        return "er ";
    }
    if t == 84 {
        return "al ";
    }
    if t == 86 || t == 98 || t == 108 || t == 116 || t == 119 || t == 120 {
        return "='";
    }
    if t == 90 {
        return "ful ";
    }
    if t == 92 {
        return "ive ";
    }
    if t == 93 {
        return "less ";
    }
    if t == 95 {
        return "est ";
    }
    if t == 100 {
        return "ize ";
    }
    if t == 106 {
        return "ous ";
    }
    return "";
}

// Output dictionary word (off, len) under transform t. At most `room`
// bytes may be written. Returns the bytes written, or -1.
fn dict_word(s: & mut BrS, off: i64, len: i64, t: i64, room: i64) -> i64 {
    val ty: i64 = tr_type(t);
    var start: i64 = 0;
    var end: i64 = len;
    if ty >= 1 && ty <= 9 {
        end = len - ty;
    }
    if ty >= 12 {
        start = ty - 11;
    }
    var w: Vec<i64> = Vec::new();
    var k: i64 = start;
    while k < end {
        w.push(dict_byte(s, off + k));
        k = k + 1;
    }
    val n: i64 = w.len();
    if ty == 10 || ty == 11 {
        var i: i64 = 0;
        while i < n {
            val c: i64 = w[i];
            var step: i64 = 1;
            if c < 192 {
                if c >= 97 && c <= 122 {
                    w[i] = c ^ 32;
                }
            } else if c < 224 {
                if i + 1 < n {
                    w[i + 1] = w[i + 1] ^ 32;
                }
                step = 2;
            } else {
                if i + 2 < n {
                    w[i + 2] = w[i + 2] ^ 5;
                }
                step = 3;
            }
            if ty == 10 {
                break;
            }
            i = i + step;
        }
    }
    val pre: str = tr_prefix(t);
    val suf: str = tr_suffix(t);
    var plen: i64 = str_len(pre);
    if t == 102 {
        plen = 2;
    }
    val total: i64 = plen + n + str_len(suf);
    if total > room {
        return br_fail(s, "dictionary word past the meta-block");
    }
    if t == 102 {
        s.out.push(194);
        s.out.push(160);
    }
    k = 0;
    while k < str_len(pre) {
        s.out.push(str_byte_at(pre, k));
        k = k + 1;
    }
    k = 0;
    while k < n {
        s.out.push(w[k]);
        k = k + 1;
    }
    k = 0;
    while k < str_len(suf) {
        s.out.push(str_byte_at(suf, k));
        k = k + 1;
    }
    return total;
}

// ─── Compressed meta-block ──────────────────────────────────────────────

fn ins_cell(cell: i64) -> i64 {
    if cell == 4 || cell == 5 || cell == 8 {
        return 8;
    }
    if cell == 7 || cell == 9 || cell == 10 {
        return 16;
    }
    return 0;
}

fn cpy_cell(cell: i64) -> i64 {
    if cell == 6 || cell == 8 || cell == 10 {
        return 16;
    }
    if cell == 1 || cell == 3 || cell == 5 || cell == 9 {
        return 8;
    }
    return 0;
}

fn mb_compressed(s: & mut BrS, mlen: i64, wsize: i64) -> bool {
    // codes of the previous meta-block are no longer needed
    s.hcnt.clear();
    s.hcb.clear();
    s.hsym.clear();
    s.hbase.clear();
    s.hone.clear();
    var bl0: i64 = 0;
    var bl1: i64 = 0;
    var bl2: i64 = 0;
    var c: i64 = 0;
    while c < 3 {
        val n: i64 = read_varlen8(s) + 1;
        s.nbl.set(c, n);
        s.bt.set(c, 0);
        s.rb1.set(c, 1);
        s.rb2.set(c, 0);
        var cnt: i64 = 16777216;
        if n >= 2 {
            val tt: i64 = read_prefix(s, n + 2);
            if tt < 0 {
                return false;
            }
            val tc: i64 = read_prefix(s, 26);
            if tc < 0 {
                return false;
            }
            s.btt.set(c, tt);
            s.bct.set(c, tc);
            cnt = read_blen(s, tc);
            if cnt < 0 {
                return false;
            }
        }
        if c == 0 {
            bl0 = cnt;
        } else if c == 1 {
            bl1 = cnt;
        } else {
            bl2 = cnt;
        }
        c = c + 1;
    }
    val npost: i64 = bs_bits(s, 2);
    val ndirect: i64 = bs_bits(s, 4) << npost;
    val nbl0: i64 = s.nbl[0];
    var cmodes: Vec<i64> = Vec::new();
    var k: i64 = 0;
    var any_utf8: bool = false;
    while k < nbl0 {
        val m: i64 = bs_bits(s, 2);
        if m == 2 {
            any_utf8 = true;
        }
        cmodes.push(m);
        k = k + 1;
    }
    if any_utf8 && s.lut0.len() == 0 {
        build_lut0(s);
    }
    val ntl: i64 = read_varlen8(s) + 1;
    var cmapl: Vec<i64> = Vec::new();
    if ntl >= 2 {
        cmapl = read_cmap(s, 64 * nbl0, ntl);
        if br_failed(s) {
            return false;
        }
    }
    val ntd: i64 = read_varlen8(s) + 1;
    var cmapd: Vec<i64> = Vec::new();
    if ntd >= 2 {
        cmapd = read_cmap(s, 4 * s.nbl[2], ntd);
        if br_failed(s) {
            return false;
        }
    }
    if bs_over(s) {
        br_fail(s, "truncated stream");
        return false;
    }
    var lit_t: Vec<i64> = Vec::new();
    k = 0;
    while k < ntl {
        val id: i64 = read_prefix(s, 256);
        if id < 0 {
            return false;
        }
        lit_t.push(id);
        k = k + 1;
    }
    var cmd_t: Vec<i64> = Vec::new();
    k = 0;
    while k < s.nbl[1] {
        val id2: i64 = read_prefix(s, 704);
        if id2 < 0 {
            return false;
        }
        cmd_t.push(id2);
        k = k + 1;
    }
    var dst_t: Vec<i64> = Vec::new();
    val dsize: i64 = 16 + ndirect + (48 << npost);
    k = 0;
    while k < ntd {
        val id3: i64 = read_prefix(s, dsize);
        if id3 < 0 {
            return false;
        }
        dst_t.push(id3);
        k = k + 1;
    }
    if bs_over(s) {
        br_fail(s, "truncated stream");
        return false;
    }

    var bt0: i64 = 0;
    var mode0: i64 = cmodes[0];
    var bt1: i64 = 0;
    var bt2: i64 = 0;
    var produced: i64 = 0;
    var empty_cmds: i64 = 0;
    while produced < mlen {
        if bs_over(s) {
            br_fail(s, "truncated stream");
            return false;
        }
        if bl1 == 0 {
            bl1 = blk_switch(s, 1);
            if bl1 < 0 {
                return false;
            }
            bt1 = s.bt[1];
        }
        bl1 = bl1 - 1;
        val sym: i64 = h_dec(s, cmd_t[bt1]);
        if sym < 0 {
            return false;
        }
        val cell: i64 = sym >> 6;
        val ic: i64 = ins_cell(cell) + ((sym >> 3) & 7);
        val cc: i64 = cpy_cell(cell) + (sym & 7);
        val ilen: i64 = s.insb[ic] + bs_bits(s, s.inse[ic]);
        val clen: i64 = s.cpyb[cc] + bs_bits(s, s.cpye[cc]);
        if produced + ilen > mlen {
            br_fail(s, "insert past the meta-block");
            return false;
        }
        var li: i64 = 0;
        while li < ilen {
            if bl0 == 0 {
                bl0 = blk_switch(s, 0);
                if bl0 < 0 {
                    return false;
                }
                bt0 = s.bt[0];
                mode0 = cmodes[bt0];
            }
            bl0 = bl0 - 1;
            val pos: i64 = s.out.len();
            var p1: i64 = 0;
            var p2: i64 = 0;
            if pos > 0 {
                p1 = s.out[pos - 1];
            }
            if pos > 1 {
                p2 = s.out[pos - 2];
            }
            var tree: i64 = 0;
            if ntl >= 2 {
                tree = cmapl[bt0 * 64 + lit_ctx(s, mode0, p1, p2)];
            }
            val lit: i64 = h_dec(s, lit_t[tree]);
            if lit < 0 {
                return false;
            }
            s.out.push(lit);
            li = li + 1;
        }
        produced = produced + ilen;
        if produced >= mlen {
            break;
        }

        var dcode: i64 = 0;
        if cell >= 2 {
            if bl2 == 0 {
                bl2 = blk_switch(s, 2);
                if bl2 < 0 {
                    return false;
                }
                bt2 = s.bt[2];
            }
            bl2 = bl2 - 1;
            var tree2: i64 = 0;
            if ntd >= 2 {
                var cid: i64 = 3;
                if clen <= 4 {
                    cid = clen - 2;
                }
                tree2 = cmapd[bt2 * 4 + cid];
            }
            dcode = h_dec(s, dst_t[tree2]);
            if dcode < 0 {
                return false;
            }
        }
        var dist: i64 = 0;
        if dcode < 4 {
            dist = s.rb[(s.rbi - 1 - dcode) & 3];
        } else if dcode < 16 {
            var basev: i64 = s.rb[(s.rbi - 1) & 3];
            if dcode >= 10 {
                basev = s.rb[(s.rbi - 2) & 3];
            }
            val q: i64 = (dcode - 4) % 6;
            val delta: i64 = (q >> 1) + 1;
            if (q & 1) == 0 {
                dist = basev - delta;
            } else {
                dist = basev + delta;
            }
            if dist <= 0 {
                br_fail(s, "invalid distance");
                return false;
            }
        } else if dcode < 16 + ndirect {
            dist = dcode - 15;
        } else {
            val dc: i64 = dcode - ndirect - 16;
            val nb: i64 = 1 + (dc >> (npost + 1));
            val hcode: i64 = dc >> npost;
            val lcode: i64 = dc & ((1 << npost) - 1);
            val offv: i64 = ((2 + (hcode & 1)) << nb) - 4;
            dist = ((offv + bs_bits(s, nb)) << npost) + lcode + ndirect + 1;
        }
        val outpos: i64 = s.out.len();
        var maxd: i64 = outpos;
        if maxd > wsize {
            maxd = wsize;
        }
        if dist > maxd {
            // static dictionary reference
            if clen < 4 || clen > 24 {
                br_fail(s, "invalid distance");
                return false;
            }
            val nbits: i64 = dict_ndbits(clen);
            val wid: i64 = dist - maxd - 1;
            val widx: i64 = wid & ((1 << nbits) - 1);
            val t: i64 = wid >> nbits;
            if t > 120 {
                br_fail(s, "invalid dictionary transform");
                return false;
            }
            val wrote: i64 = dict_word(s, dict_offset(clen) + widx * clen, clen, t, mlen - produced);
            if wrote < 0 {
                return false;
            }
            produced = produced + wrote;
            if wrote == 0 {
                empty_cmds = empty_cmds + 1;
                if empty_cmds > 65536 {
                    br_fail(s, "no progress");
                    return false;
                }
            } else {
                empty_cmds = 0;
            }
        } else {
            if produced + clen > mlen {
                br_fail(s, "copy past the meta-block");
                return false;
            }
            val src: i64 = outpos - dist;
            var j: i64 = 0;
            while j < clen {
                s.out.push(s.out[src + j]);
                j = j + 1;
            }
            if dcode != 0 {
                s.rb.set(s.rbi & 3, dist);
                s.rbi = s.rbi + 1;
            }
            produced = produced + clen;
            empty_cmds = 0;
        }
    }
    return true;
}

// ─── Stream ─────────────────────────────────────────────────────────────

fn br_run(s: & mut BrS) -> bool {
    var wbits: i64 = 16;
    if bs_bits(s, 1) == 1 {
        val n: i64 = bs_bits(s, 3);
        if n != 0 {
            wbits = 17 + n;
        } else {
            val m: i64 = bs_bits(s, 3);
            if m == 1 {
                br_fail(s, "large-window stream");
                return false;
            }
            if m == 0 {
                wbits = 17;
            } else {
                wbits = 8 + m;
            }
        }
    }
    val wsize: i64 = (1 << wbits) - 16;
    var last: i64 = 0;
    while last == 0 {
        if bs_over(s) {
            br_fail(s, "truncated stream");
            return false;
        }
        last = bs_bits(s, 1);
        if last == 1 {
            if bs_bits(s, 1) == 1 {
                break;
            }
            // ISLASTEMPTY
        }
        val mn: i64 = bs_bits(s, 2);
        if mn == 3 {
            // metadata: skipped
            if bs_bits(s, 1) != 0 {
                br_fail(s, "reserved bit set");
                return false;
            }
            val nb: i64 = bs_bits(s, 2);
            var skip: i64 = 0;
            if nb > 0 {
                var k: i64 = 0;
                while k < nb {
                    val b: i64 = bs_bits(s, 8);
                    if k == nb - 1 && nb > 1 && b == 0 {
                        br_fail(s, "invalid metadata length");
                        return false;
                    }
                    skip = skip | (b << (8 * k));
                    k = k + 1;
                }
                skip = skip + 1;
            }
            if !bs_align(s) {
                br_fail(s, "nonzero padding");
                return false;
            }
            if !bs_bytes(s, skip, false) {
                br_fail(s, "truncated stream");
                return false;
            }
            continue;
        }
        val nn: i64 = mn + 4;
        var mlen: i64 = 0;
        var k2: i64 = 0;
        while k2 < nn {
            val nib: i64 = bs_bits(s, 4);
            if k2 == nn - 1 && nn > 4 && nib == 0 {
                br_fail(s, "invalid meta-block length");
                return false;
            }
            mlen = mlen | (nib << (4 * k2));
            k2 = k2 + 1;
        }
        mlen = mlen + 1;
        if s.out.len() + mlen > s.max_out {
            br_fail(s, "output limit exceeded");
            return false;
        }
        if last == 0 {
            if bs_bits(s, 1) == 1 {
                // uncompressed meta-block
                if !bs_align(s) {
                    br_fail(s, "nonzero padding");
                    return false;
                }
                if !bs_bytes(s, mlen, true) {
                    br_fail(s, "truncated stream");
                    return false;
                }
                continue;
            }
        }
        if !mb_compressed(s, mlen, wsize) {
            br_fail(s, "corrupt stream");
            return false;
        }
    }
    if bs_over(s) {
        br_fail(s, "truncated stream");
        return false;
    }
    if !bs_align(s) {
        br_fail(s, "nonzero padding");
        return false;
    }
    if s.ipos - (s.nacc >> 3) != s.inlen {
        br_fail(s, "data after the end of the stream");
        return false;
    }
    return true;
}

fn br_decode(data: Vec<i64>, max_out: i64) -> BrS {
    var s: BrS = br_new(data, max_out);
    if !br_run(& mut s) {
        br_fail(& mut s, "corrupt stream");
        s.out = Vec::new();
    }
    return s;
}

// ─── Public API ─────────────────────────────────────────────────────────

/// Decompress a Brotli stream (Vec of bytes 0..255). Returns the decoded
/// bytes, or an empty Vec when the stream is malformed, truncated, has
/// data after its end, or would decode to more than 256 MB. A valid
/// stream of zero bytes also gives an empty Vec: use brotli_ok or
/// brotli_error to tell the two apart.
pub fn brotli_decompress(data: Vec<i64>) -> Vec<i64> {
    val s: BrS = br_decode(data, 268435456);
    return s.out;
}

/// Like brotli_decompress, with the output capped at `max_out` bytes
/// (decompression-bomb guard): a stream that decodes to more is an error.
pub fn brotli_decompress_limit(data: Vec<i64>, max_out: i64) -> Vec<i64> {
    val s: BrS = br_decode(data, max_out);
    return s.out;
}

/// Why `data` is not a valid Brotli stream: "" when it is valid (also for
/// a stream that decodes to zero bytes), else a short reason such as
/// "invalid prefix code" or "truncated stream". Decodes the whole stream.
pub fn brotli_error(data: Vec<i64>) -> str {
    val s: BrS = br_decode(data, 268435456);
    return s.err;
}

/// True when `data` is a complete, valid Brotli stream. This decodes the
/// stream; an empty brotli_decompress result with brotli_ok true is an
/// empty stream, with brotli_ok false an error.
///
/// Example:
///   var empty: Vec<i64> = Vec::new();
///   empty.push(59);
///   assert(brotli_ok(empty));
///   assert_eq(brotli_error(empty), "");
///   assert_eq(brotli_decompress(empty).len(), 0);
///   var cut: Vec<i64> = Vec::new();
///   cut.push(27); cut.push(22); cut.push(0);
///   assert(!brotli_ok(cut));
///   assert(str_len(brotli_error(cut)) > 0);
///   assert_eq(brotli_decompress_str(cut), "");
pub fn brotli_ok(data: Vec<i64>) -> bool {
    return str_len(brotli_error(data)) == 0;
}

/// Decompress and interpret the result as a string ("" on error). The
/// bytes are taken as they are (UTF-8 stays UTF-8); the string ends at the
/// first zero byte of the output.
pub fn brotli_decompress_str(data: Vec<i64>) -> str {
    val out: Vec<i64> = brotli_decompress(data);
    var sb: StringBuilder = StringBuilder::new();
    var i: i64 = 0;
    while i < out.len() && out[i] != 0 {
        sb.append_char(out[i]);
        i = i + 1;
    }
    return sb.to_str();
}

// ─── Compression ────────────────────────────────────────────────────────
//
// `brotli_compress_level(bytes, quality)` writes a stream with the
// smallest window (WBITS 16, 18..24) that holds the input, cut into
// meta-blocks of 1 MB. Each meta-block is the shorter of an uncompressed
// one and a compressed one with one block type per category, no context
// modelling (one literal and one distance tree), NPOSTFIX = NDIRECT = 0:
//   matches:   hash chains on 4-byte prefixes over the window (quality 1-2:
//              4 candidates, 3-5: 16, 6-8: 64, 9-11: 256); the last
//              distance is tried first and coded with distance code 0,
//              implicitly when the command's cell allows it
//   codes:     Huffman code lengths of at most 15 bits, sent as simple
//              prefix codes (up to 4 symbols) or complex ones with the
//              repeat codes 16 and 17 (as the reference encoder writes
//              them)
// Quality 0 stores (uncompressed meta-blocks). No static dictionary
// references, block splitting or context maps: the ratio is below the
// reference encoder's at the same quality.

struct BcBits {
    out: Vec<i64>,
    acc: i64,
    n: i64,
}

fn bc_bits_new() -> BcBits {
    return BcBits {
        out: Vec::new(), acc: 0, n: 0
    };
}

// The low `nbits` bits of v, least significant first.
fn bc_put(w: & mut BcBits, v: i64, nbits: i64) -> void {
    if nbits <= 0 {
        return;
    }
    w.acc = w.acc | ((v & ((1 << nbits) - 1)) << w.n);
    w.n = w.n + nbits;
    while w.n >= 8 {
        w.out.push(w.acc & 255);
        w.acc = w.acc >> 8;
        w.n = w.n - 8;
    }
}

// A prefix code: its first bit is the code's most significant one.
fn bc_code(w: & mut BcBits, code: i64, len: i64) -> void {
    var rev: i64 = 0;
    var i: i64 = 0;
    while i < len {
        rev = (rev << 1) | ((code >> i) & 1);
        i = i + 1;
    }
    bc_put(w, rev, len);
}

// A code table entry (code | length << 16).
fn bc_sym(w: & mut BcBits, tab: Vec<i64>, s: i64) -> void {
    val e: i64 = tab[s];
    bc_code(w, e & 65535, e >> 16);
}

fn bc_align(w: & mut BcBits) -> void {
    if w.n > 0 {
        w.out.push(w.acc & 255);
        w.acc = 0;
        w.n = 0;
    }
}

// Append the bits of `src` (not aligned) to w.
fn bc_append(w: & mut BcBits, src: BcBits) -> void {
    var i: i64 = 0;
    while i < src.out.len() {
        bc_put(w, src.out[i], 8);
        i = i + 1;
    }
    bc_put(w, src.acc, src.n);
}

fn bc_bitlen(w: BcBits) -> i64 {
    return w.out.len() * 8 + w.n;
}

// Huffman code lengths of at most `limit` bits for the counts of symbols
// 0..n-1 (two or more non-zero), rebuilt from flattened counts while the
// tree is too deep.
fn bc_lengths(freq: Vec<i64>, n: i64, limit: i64) -> Vec<i64> {
    var f: Vec<i64> = Vec::new();
    var used: i64 = 0;
    var i: i64 = 0;
    while i < n {
        f.push(freq[i]);
        if freq[i] > 0 {
            used = used + 1;
        }
        i = i + 1;
    }
    while true {
        var w: Vec<i64> = Vec::new();
        var parent: Vec<i64> = Vec::new();
        var alive: Vec<i64> = Vec::new();
        var node: Vec<i64> = Vec::filled(n, - 1);
        i = 0;
        while i < n {
            if f[i] > 0 {
                node.set(i, w.len());
                w.push(f[i]);
                parent.push(- 1);
                alive.push(1);
            }
            i = i + 1;
        }
        var left: i64 = used;
        while left > 1 {
            var a: i64 = - 1;
            var b: i64 = - 1;
            var j: i64 = 0;
            while j < w.len() {
                if alive[j] == 1 {
                    if a < 0 || w[j] < w[a] {
                        b = a;
                        a = j;
                    } else if b < 0 || w[j] < w[b] {
                        b = j;
                    }
                }
                j = j + 1;
            }
            alive.set(a, 0);
            alive.set(b, 0);
            parent.set(a, w.len());
            parent.set(b, w.len());
            w.push(w[a] + w[b]);
            parent.push(- 1);
            alive.push(1);
            left = left - 1;
        }
        var lens: Vec<i64> = Vec::filled(n, 0);
        var maxl: i64 = 0;
        i = 0;
        while i < n {
            var nd: i64 = node[i];
            if nd >= 0 {
                var d: i64 = 0;
                while parent[nd] >= 0 {
                    nd = parent[nd];
                    d = d + 1;
                }
                lens.set(i, d);
                if d > maxl {
                    maxl = d;
                }
            }
            i = i + 1;
        }
        if maxl <= limit {
            return lens;
        }
        i = 0;
        while i < n {
            if f[i] > 0 {
                f.set(i, (f[i] >> 1) | 1);
            }
            i = i + 1;
        }
    }
    return Vec::new();
}

// Canonical codes (shorter codes first, symbols in order within a length,
// as h_add lays them out) as table entries code | length << 16.
fn bc_canon(lens: Vec<i64>) -> Vec<i64> {
    val n: i64 = lens.len();
    var count: Vec<i64> = Vec::filled(17, 0);
    var i: i64 = 0;
    while i < n {
        if lens[i] > 0 {
            count.set(lens[i], count[lens[i]] + 1);
        }
        i = i + 1;
    }
    var next: Vec<i64> = Vec::filled(17, 0);
    var code: i64 = 0;
    var b: i64 = 1;
    while b <= 16 {
        code = (code + count[b - 1]) << 1;
        if b - 1 == 0 {
            code = 0;
        }
        next.set(b, code);
        b = b + 1;
    }
    var tab: Vec<i64> = Vec::filled(n, 0);
    i = 0;
    while i < n {
        val l: i64 = lens[i];
        if l > 0 {
            tab.set(i, next[l] | (l << 16));
            next.set(l, next[l] + 1);
        }
        i = i + 1;
    }
    return tab;
}

// Repeat codes for `reps` (3 or more) repetitions: code 16 (2 extra bits)
// or 17 (3), several in a row multiplying (RFC 7932 3.5).
fn bc_rep_tokens(codes: & mut Vec<i64>, extras: & mut Vec<i64>, code: i64, bits: i64, reps: i64) -> void {
    var r: i64 = reps - 3;
    var digits: Vec<i64> = Vec::new();
    while true {
        digits.push(r & ((1 << bits) - 1));
        r = r >> bits;
        if r == 0 {
            break;
        }
        r = r - 1;
    }
    var k: i64 = digits.len() - 1;
    while k >= 0 {
        codes.push(code);
        extras.push(digits[k]);
        k = k - 1;
    }
}

// The fixed code of a code-length code length (RFC 7932 3.5).
fn bc_cl_len(w: & mut BcBits, v: i64) -> void {
    if v == 0 {
        bc_put(w, 0, 2);
    } else if v == 1 {
        bc_put(w, 7, 4);
    } else if v == 2 {
        bc_put(w, 3, 3);
    } else if v == 3 {
        bc_put(w, 2, 2);
    } else if v == 4 {
        bc_put(w, 1, 2);
    } else {
        bc_put(w, 15, 4);
    }
}

// Write the prefix code for symbol counts `freq` over an alphabet of
// `asize` symbols; returns the code table (code | length << 16; a code
// with one symbol has 0 bits).
fn bc_tree(w: & mut BcBits, freq: Vec<i64>, asize: i64) -> Vec<i64> {
    var syms: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < asize {
        if freq[i] > 0 {
            syms.push(i);
        }
        i = i + 1;
    }
    var nbits: i64 = 0;
    while (1 << nbits) < asize {
        nbits = nbits + 1;
    }
    if syms.len() <= 1 {
        var only: i64 = 0;
        if syms.len() == 1 {
            only = syms[0];
        }
        bc_put(w, 1, 2);
        bc_put(w, 0, 2);
        bc_put(w, only, nbits);
        return Vec::filled(asize, 0);
    }
    val lens: Vec<i64> = bc_lengths(freq, asize, 15);
    val tab: Vec<i64> = bc_canon(lens);
    val nsym: i64 = syms.len();
    if nsym <= 4 {
        // simple prefix code: symbols listed shortest code first
        var order: Vec<i64> = Vec::new();
        var l: i64 = 1;
        while l <= 3 {
            var k: i64 = 0;
            while k < nsym {
                if lens[syms[k]] == l {
                    order.push(syms[k]);
                }
                k = k + 1;
            }
            l = l + 1;
        }
        bc_put(w, 1, 2);
        bc_put(w, nsym - 1, 2);
        var k2: i64 = 0;
        while k2 < nsym {
            bc_put(w, order[k2], nbits);
            k2 = k2 + 1;
        }
        if nsym == 4 {
            if lens[order[0]] == 1 {
                bc_put(w, 1, 1);
            } else {
                bc_put(w, 0, 1);
            }
        }
        return tab;
    }
    // complex prefix code: the code lengths with repeat codes, as tokens
    var last: i64 = asize - 1;
    while lens[last] == 0 {
        last = last - 1;
    }
    var tcode: Vec<i64> = Vec::new();
    var textra: Vec<i64> = Vec::new();
    var prev: i64 = 8;
    i = 0;
    while i <= last {
        val v: i64 = lens[i];
        var r: i64 = 1;
        while i + r <= last && lens[i + r] == v {
            r = r + 1;
        }
        if v == 0 {
            var z: i64 = r;
            if z == 11 {
                tcode.push(0);
                textra.push(0);
                z = 10;
            }
            if z < 3 {
                while z > 0 {
                    tcode.push(0);
                    textra.push(0);
                    z = z - 1;
                }
            } else {
                bc_rep_tokens(& mut tcode, & mut textra, 17, 3, z);
            }
        } else {
            var k3: i64 = r;
            if prev != v {
                tcode.push(v);
                textra.push(0);
                k3 = k3 - 1;
            }
            if k3 == 7 {
                tcode.push(v);
                textra.push(0);
                k3 = k3 - 1;
            }
            if k3 < 3 {
                while k3 > 0 {
                    tcode.push(v);
                    textra.push(0);
                    k3 = k3 - 1;
                }
            } else {
                bc_rep_tokens(& mut tcode, & mut textra, 16, 2, k3);
            }
            prev = v;
        }
        i = i + r;
    }
    // the code-length code (lengths at most 5)
    var cfreq: Vec<i64> = Vec::filled(18, 0);
    var cused: i64 = 0;
    i = 0;
    while i < tcode.len() {
        if cfreq[tcode[i]] == 0 {
            cused = cused + 1;
        }
        cfreq.set(tcode[i], cfreq[tcode[i]] + 1);
        i = i + 1;
    }
    var clens: Vec<i64> = Vec::filled(18, 0);
    var ctab: Vec<i64> = Vec::filled(18, 0);
    if cused == 1 {
        // one code-length symbol: a 0-bit code, all 18 lengths written
        clens.set(tcode[0], 1);
    } else {
        clens = bc_lengths(cfreq, 18, 5);
        ctab = bc_canon(clens);
    }
    bc_put(w, 0, 2);
    var space: i64 = 32;
    i = 0;
    while i < 18 {
        val cv: i64 = clens[cl_order(i)];
        bc_cl_len(w, cv);
        if cv != 0 {
            space = space - (32 >> cv);
            if space <= 0 {
                break;
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < tcode.len() {
        val tc: i64 = tcode[i];
        if cused > 1 {
            bc_sym(w, ctab, tc);
        }
        if tc == 16 {
            bc_put(w, textra[i], 2);
        } else if tc == 17 {
            bc_put(w, textra[i], 3);
        }
        i = i + 1;
    }
    return tab;
}

// Compression state: the input, hash chains, search effort, window, the
// last distance (the decoder's ring) and the last match found.
struct BcCtx {
    data: Vec<i64>,
    n: i64,
    head: Vec<i64>,
    prev: Vec<i64>,
    hbits: i64,
    ins: i64,
    depth: i64,
    lazy: bool,
    win: i64,
    last: i64,
    ml_len: i64,
    ml_off: i64,
    insb: Vec<i64>,
    cpyb: Vec<i64>,
}

fn bc_hash(d: Vec<i64>, p: i64, hbits: i64) -> i64 {
    val v: i64 = d[p] | (d[p + 1] << 8) | (d[p + 2] << 16) | (d[p + 3] << 24);
    return ((v * 739982445) >> 20) & ((1 << hbits) - 1);
}

fn bc_insert_upto(c: & mut BcCtx, p: i64) -> void {
    while c.ins < p {
        val q: i64 = c.ins;
        if q + 4 <= c.n {
            val h: i64 = bc_hash(c.data, q, c.hbits);
            c.prev.set(q, c.head[h]);
            c.head.set(h, q);
        }
        c.ins = q + 1;
    }
}

fn bc_mlen(d: Vec<i64>, a: i64, b: i64, max: i64) -> i64 {
    var l: i64 = 0;
    while l < max && d[a + l] == d[b + l] {
        l = l + 1;
    }
    return l;
}

// The longest match at p ending by `end` (c.ml_len, c.ml_off; ml_len is 0
// without one of 4 bytes or more): the last distance first, then the chain.
fn bc_find(c: & mut BcCtx, p: i64, end: i64) -> void {
    c.ml_len = 0;
    c.ml_off = 0;
    val maxlen: i64 = end - p;
    if maxlen < 4 || p + 4 > c.n {
        return;
    }
    var best: i64 = 3;
    if c.last <= p && c.last <= c.win {
        val l: i64 = bc_mlen(c.data, p - c.last, p, maxlen);
        if l > best {
            best = l;
            c.ml_len = l;
            c.ml_off = c.last;
        }
    }
    if best >= maxlen {
        return;
    }
    var cand: i64 = c.head[bc_hash(c.data, p, c.hbits)];
    var depth: i64 = c.depth;
    while cand >= 0 && depth > 0 {
        if p - cand > c.win {
            break;
        }
        if c.data[cand + best] == c.data[p + best] {
            val l2: i64 = bc_mlen(c.data, cand, p, maxlen);
            if l2 > best {
                best = l2;
                c.ml_len = l2;
                c.ml_off = p - cand;
                if l2 >= maxlen {
                    break;
                }
            }
        }
        cand = c.prev[cand];
        depth = depth - 1;
    }
}

// The insert-length or copy-length code of v: the largest whose base is <= v.
fn bc_len_code(bases: Vec<i64>, v: i64) -> i64 {
    var k: i64 = 23;
    while k > 0 && bases[k] > v {
        k = k - 1;
    }
    return k;
}

// The command cell (RFC 7932 5) of insert code base ib and copy code base cb
// (0, 8 or 16) with an explicit distance.
fn bc_cell(ib: i64, cb: i64) -> i64 {
    if ib == 0 {
        if cb == 0 {
            return 2;
        }
        if cb == 8 {
            return 3;
        }
        return 6;
    }
    if ib == 8 {
        if cb == 0 {
            return 4;
        }
        if cb == 8 {
            return 5;
        }
        return 8;
    }
    if cb == 0 {
        return 7;
    }
    if cb == 8 {
        return 9;
    }
    return 10;
}

// One compressed meta-block body for data[ms..me) (from NBLTYPESL on).
fn bc_meta(c: & mut BcCtx, w: & mut BcBits, ms: i64, me: i64) -> void {
    // commands: literals start, insert length, copy length (0: literals
    // only, the meta-block's last), command symbol, distance symbol (-1:
    // none), distance extra bits and their count
    var cpos: Vec<i64> = Vec::new();
    var cins: Vec<i64> = Vec::new();
    var ccpy: Vec<i64> = Vec::new();
    var csym: Vec<i64> = Vec::new();
    var cdst: Vec<i64> = Vec::new();
    var cdx: Vec<i64> = Vec::new();
    var cdn: Vec<i64> = Vec::new();
    var litf: Vec<i64> = Vec::filled(256, 0);
    var cmdf: Vec<i64> = Vec::filled(704, 0);
    var dstf: Vec<i64> = Vec::filled(64, 0);
    var p: i64 = ms;
    var anchor: i64 = ms;
    while p <= me {
        var len: i64 = 0;
        var off: i64 = 0;
        if p + 4 <= me {
            bc_insert_upto(c, p);
            bc_find(c, p, me);
            len = c.ml_len;
            off = c.ml_off;
            if len >= 4 && c.lazy && p + 5 <= me {
                bc_insert_upto(c, p + 1);
                bc_find(c, p + 1, me);
                if c.ml_len > len {
                    p = p + 1;
                    len = c.ml_len;
                    off = c.ml_off;
                }
            }
        }
        if len < 4 && p < me {
            p = p + 1;
            continue;
        }
        if len < 4 && anchor == me {
            break;
        }
        // a command: the literals anchor..p, then the match (if any)
        val ilen: i64 = p - anchor;
        val ic: i64 = bc_len_code(c.insb, ilen);
        var cc: i64 = 0;
        if len >= 4 {
            cc = bc_len_code(c.cpyb, len);
        }
        var sym: i64 = 0;
        var dsym: i64 = - 1;
        var dx: i64 = 0;
        var dn: i64 = 0;
        if len < 4 {
            sym = (bc_cell(ic & 24, 0) << 6) | ((ic & 7) << 3);
        } else if off == c.last && ic < 8 && cc < 16 {
            var cell: i64 = 0;
            if cc >= 8 {
                cell = 1;
            }
            sym = (cell << 6) | ((ic & 7) << 3) | (cc & 7);
        } else {
            sym = (bc_cell(ic & 24, cc & 24) << 6) | ((ic & 7) << 3) | (cc & 7);
            if off == c.last {
                dsym = 0;
            } else {
                val x: i64 = off + 3;
                var h: i64 = 0;
                while (x >> (h + 1)) > 0 {
                    h = h + 1;
                }
                dn = h - 1;
                dsym = 16 + 2 * (dn - 1) + ((x >> dn) & 1);
                dx = x & ((1 << dn) - 1);
                c.last = off;
            }
            dstf.set(dsym, dstf[dsym] + 1);
        }
        cmdf.set(sym, cmdf[sym] + 1);
        var k: i64 = anchor;
        while k < p {
            litf.set(c.data[k], litf[c.data[k]] + 1);
            k = k + 1;
        }
        cpos.push(anchor);
        cins.push(ilen);
        if len >= 4 {
            ccpy.push(len);
        } else {
            ccpy.push(0);
        }
        csym.push(sym);
        cdst.push(dsym);
        cdx.push(dx);
        cdn.push(dn);
        if len < 4 {
            break;
        }
        p = p + len;
        anchor = p;
        if p == me {
            break;
        }
    }
    // header: one block type per category, NPOSTFIX 0, NDIRECT 0, context
    // mode LSB6, one literal tree, one distance tree
    bc_put(w, 0, 1);
    bc_put(w, 0, 1);
    bc_put(w, 0, 1);
    bc_put(w, 0, 2);
    bc_put(w, 0, 4);
    bc_put(w, 0, 2);
    bc_put(w, 0, 1);
    bc_put(w, 0, 1);
    val ltab: Vec<i64> = bc_tree(w, litf, 256);
    val ctab: Vec<i64> = bc_tree(w, cmdf, 704);
    val dtab: Vec<i64> = bc_tree(w, dstf, 64);
    var i: i64 = 0;
    while i < cins.len() {
        val s: i64 = csym[i];
        bc_sym(w, ctab, s);
        val ilen2: i64 = cins[i];
        val ic2: i64 = bc_len_code(c.insb, ilen2);
        bc_put(w, ilen2 - c.insb[ic2], ins_extra(ic2));
        val clen: i64 = ccpy[i];
        if clen > 0 {
            val cc2: i64 = bc_len_code(c.cpyb, clen);
            bc_put(w, clen - c.cpyb[cc2], cpy_extra(cc2));
        }
        var k2: i64 = 0;
        while k2 < ilen2 {
            bc_sym(w, ltab, c.data[cpos[i] + k2]);
            k2 = k2 + 1;
        }
        if clen > 0 && cdst[i] >= 0 {
            bc_sym(w, dtab, cdst[i]);
            bc_put(w, cdx[i], cdn[i]);
        }
        i = i + 1;
    }
}

/// Compress `bytes` (values 0..255; higher bits are dropped) into a Brotli
/// stream (RFC 7932). `quality` 0 only stores (uncompressed meta-blocks);
/// 1 to 11 search for matches, harder at higher qualities (6 is
/// brotli_compress's). Any Brotli decoder reads the result; the ratio is
/// below the reference encoder's (no dictionary, no context modelling).
///
/// Example:
///   var b: Vec<i64> = Vec::new();
///   var i: i64 = 0;
///   while i < 300 { b.push(120 + i % 4); i = i + 1; }
///   val z: Vec<i64> = brotli_compress_level(b, 6);
///   assert(z.len() < 40);
///   assert(brotli_ok(z));
///   assert_eq(brotli_decompress(z).len(), 300);
///   assert_eq(brotli_decompress(brotli_compress_level(b, 0)).len(), 300);
pub fn brotli_compress_level(bytes: Vec<i64>, quality: i64) -> Vec<i64> {
    val n: i64 = bytes.len();
    var data: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        data.push(bytes[i] & 255);
        i = i + 1;
    }
    var w: BcBits = bc_bits_new();
    var wbits: i64 = 16;
    while wbits < 24 && (1 << wbits) - 16 < n {
        wbits = wbits + 1;
    }
    if wbits == 17 {
        wbits = 18;
    }
    if wbits == 16 {
        bc_put(& mut w, 0, 1);
    } else {
        bc_put(& mut w, 1, 1);
        bc_put(& mut w, wbits - 17, 3);
    }
    if n == 0 {
        bc_put(& mut w, 1, 1);
        bc_put(& mut w, 1, 1);
        bc_align(& mut w);
        return w.out;
    }
    var depth: i64 = 0;
    var lazy: bool = false;
    if quality >= 1 {
        depth = 4;
    }
    if quality >= 3 {
        depth = 16;
    }
    if quality >= 5 {
        lazy = true;
    }
    if quality >= 6 {
        depth = 64;
    }
    if quality >= 9 {
        depth = 256;
    }
    var hb: i64 = 8;
    var plen: i64 = 1;
    if depth > 0 {
        while hb < 16 && (1 << hb) < n {
            hb = hb + 1;
        }
        plen = n + 1;
    }
    var insb: Vec<i64> = Vec::new();
    var cpyb: Vec<i64> = Vec::new();
    var ib: i64 = 0;
    var cb: i64 = 2;
    var k: i64 = 0;
    while k < 24 {
        insb.push(ib);
        ib = ib + (1 << ins_extra(k));
        cpyb.push(cb);
        cb = cb + (1 << cpy_extra(k));
        k = k + 1;
    }
    var c: BcCtx = BcCtx {
        data: data, n: n, head: Vec::filled(1 << hb, - 1), prev: Vec::filled(plen, - 1), hbits: hb, ins: 0, depth: depth, lazy: lazy, win: (1 << wbits) - 16, last: 4, ml_len: 0, ml_off: 0, insb: insb, cpyb: cpyb
    };
    var ms: i64 = 0;
    var ended: bool = false;
    while ms < n {
        var me: i64 = ms + 1048576;
        if me > n {
            me = n;
        }
        val islast: bool = me == n;
        val mlen: i64 = me - ms;
        var body: BcBits = bc_bits_new();
        var saved_last: i64 = c.last;
        var packed: bool = false;
        if depth > 0 {
            bc_meta(& mut c, & mut body, ms, me);
            packed = bc_bitlen(body) < 8 * mlen;
        }
        // ISLAST (and ISLASTEMPTY 0); an uncompressed meta-block cannot be
        // the last one, an empty last one follows it
        if islast && packed {
            bc_put(& mut w, 1, 1);
            bc_put(& mut w, 0, 1);
            ended = true;
        } else {
            bc_put(& mut w, 0, 1);
        }
        var nib: i64 = 4;
        if mlen - 1 >= 65536 {
            nib = 5;
        }
        if mlen - 1 >= 1048576 {
            nib = 6;
        }
        bc_put(& mut w, nib - 4, 2);
        bc_put(& mut w, mlen - 1, 4 * nib);
        if packed {
            if !islast {
                bc_put(& mut w, 0, 1);
            }
            bc_append(& mut w, body);
        } else {
            c.last = saved_last;
            bc_put(& mut w, 1, 1);
            bc_align(& mut w);
            var j: i64 = ms;
            while j < me {
                w.out.push(c.data[j]);
                j = j + 1;
            }
        }
        ms = me;
    }
    if !ended {
        bc_put(& mut w, 1, 1);
        bc_put(& mut w, 1, 1);
    }
    bc_align(& mut w);
    return w.out;
}

/// Compress `bytes` into a Brotli stream at quality 6 (see
/// brotli_compress_level).
pub fn brotli_compress(bytes: Vec<i64>) -> Vec<i64> {
    return brotli_compress_level(bytes, 6);
}

/// Compress the bytes of a string at quality 6; brotli_decompress_str gives
/// the string back.
pub fn brotli_compress_str(s: str) -> Vec<i64> {
    var b: Vec<i64> = Vec::new();
    var i: i64 = 0;
    val n: i64 = str_len(s);
    while i < n {
        b.push(str_byte_at(s, i));
        i = i + 1;
    }
    return brotli_compress_level(b, 6);
}
