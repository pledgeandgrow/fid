/// Row `row` (0..15) of the glyph for ch; bit 7 is the leftmost pixel.
/// Characters outside 0x20..0x7E draw as '?'.
pub fn fb_glyph_row(ch: i64, row: i64) -> i64 {
    var c: i64 = ch;
    if c < 32 || c > 126 {
        c = 63;
    }
    return FB_FONT[(c - 32) * 16 + row];
}

/// Draw one character cell at pixel (x, y). opaque=false leaves the
/// background pixels untouched.
pub fn fb_draw_char(fb: & mut Framebuffer, x: i64, y: i64, ch: i64, fg: i64, bg: i64, opaque: bool) {
    var pf: i64 = fb_pack(&fb.fmt, fg);
    var pb: i64 = fb_pack(&fb.fmt, bg);
    var r: i64 = 0;
    while r < FB_FONT_H {
        var bits: i64 = fb_glyph_row(ch, r);
        var yy: i64 = y + r;
        if yy >= 0 && yy < fb.height {
            var c: i64 = 0;
            while c < FB_FONT_W {
                var xx: i64 = x + c;
                if xx >= 0 && xx < fb.width {
                    if ((bits >> (7 - c)) & 1) != 0 {
                        fb_store_px(fb, fb_offset(fb, xx, yy), pf);
                    } else {
                        if opaque {
                            fb_store_px(fb, fb_offset(fb, xx, yy), pb);
                        }
                    }
                }
                c = c + 1;
            }
        }
        r = r + 1;
    }
}

pub fn fb_draw_text(fb: & mut Framebuffer, x: i64, y: i64, s: str, fg: i64, bg: i64) {
    var i: i64 = 0;
    while i < str_len(s) {
        fb_draw_char(fb, x + i * FB_FONT_W, y, str_byte_at(s, i), fg, bg, true);
        i = i + 1;
    }
}

// ─── Console ────────────────────────────────────────────────────────────

/// The 16 VGA text colors as 0xRRGGBB.
pub fn fb_vga_color(i: i64) -> i64 {
    if i == 0 { return 0x000000; }
    if i == 1 { return 0xAA0000; }
    if i == 2 { return 0x00AA00; }
    if i == 3 { return 0xAA5500; }
    if i == 4 { return 0x0000AA; }
    if i == 5 { return 0xAA00AA; }
    if i == 6 { return 0x00AAAA; }
    if i == 7 { return 0xAAAAAA; }
    if i == 8 { return 0x555555; }
    if i == 9 { return 0xFF5555; }
    if i == 10 { return 0x55FF55; }
    if i == 11 { return 0xFFFF55; }
    if i == 12 { return 0x5555FF; }
    if i == 13 { return 0xFF55FF; }
    if i == 14 { return 0x55FFFF; }
    return 0xFFFFFF;
}

pub struct Console {
    pub fb: Framebuffer,
    pub cols: i64,
    pub rows: i64,
    pub cx: i64,
    pub cy: i64,
    pub fg: i64,
    pub bg: i64,
    pub def_fg: i64,
    pub def_bg: i64,
    pub text: Vec<i64>,
    pub esc: i64,
    // 0 normal, 1 after ESC, 2 inside CSI
    pub args: Vec<i64>,
    pub scrolls: i64,
}

pub fn con_new(fb: Framebuffer, fg: i64, bg: i64) -> Console {
    var cols: i64 = fb.width / FB_FONT_W;
    var rows: i64 = fb.height / FB_FONT_H;
    var c: Console = Console {
        fb: fb, cols: cols, rows: rows, cx: 0, cy: 0, fg: fg, bg: bg, def_fg: fg, def_bg: bg, text: Vec::filled(cols * rows, 32), esc: 0, args: Vec::new(), scrolls: 0
    };
    fb_clear(&mut c.fb, bg);
    return c;
}

fn con_scroll(c: & mut Console) {
    fb_scroll_up(&mut c.fb, FB_FONT_H, c.bg);
    var i: i64 = 0;
    var n: i64 = c.cols * (c.rows - 1);
    while i < n {
        c.text.set(i, c.text.get(i + c.cols));
        i = i + 1;
    }
    while i < c.cols * c.rows {
        c.text.set(i, 32);
        i = i + 1;
    }
    c.scrolls = c.scrolls + 1;
}

fn con_newline(c: & mut Console) {
    c.cx = 0;
    c.cy = c.cy + 1;
    if c.cy >= c.rows {
        con_scroll(c);
        c.cy = c.rows - 1;
    }
}

pub fn con_clear(c: & mut Console) {
    fb_clear(&mut c.fb, c.bg);
    var i: i64 = 0;
    while i < c.text.len() {
        c.text.set(i, 32);
        i = i + 1;
    }
    c.cx = 0;
    c.cy = 0;
}

fn con_sgr(c: & mut Console) {
    if c.args.len() == 0 {
        c.args.push(0);
    }
    var i: i64 = 0;
    while i < c.args.len() {
        var a: i64 = c.args.get(i);
        if a == 0 {
            c.fg = c.def_fg;
            c.bg = c.def_bg;
        }
        if a >= 30 && a <= 37 { c.fg = fb_vga_color(a - 30); }
        if a >= 40 && a <= 47 { c.bg = fb_vga_color(a - 40); }
        if a >= 90 && a <= 97 { c.fg = fb_vga_color(a - 90 + 8); }
        if a >= 100 && a <= 107 { c.bg = fb_vga_color(a - 100 + 8); }
        i = i + 1;
    }
}

fn con_csi_final(c: & mut Console, ch: i64) {
    if ch == 109 {
        con_sgr(c);
        // 'm'
    }
    if ch == 74 && c.args.len() > 0 && c.args.get(0) == 2 {
        con_clear(c);
        // 'J'
    }
    if ch == 72 {
        // 'H': row;col, 1-based
        var row: i64 = 1;
        var col: i64 = 1;
        if c.args.len() > 0 && c.args.get(0) > 0 { row = c.args.get(0); }
        if c.args.len() > 1 && c.args.get(1) > 0 { col = c.args.get(1); }
        c.cy = row - 1;
        c.cx = col - 1;
        if c.cy >= c.rows { c.cy = c.rows - 1; }
        if c.cx >= c.cols { c.cx = c.cols - 1; }
    }
}

/// Output one byte to the console.
pub fn con_putc(c: & mut Console, ch: i64) {
    if c.esc == 1 {
        if ch == 91 {
            c.esc = 2;
            c.args = Vec::new();
            c.args.push(0);
        } else {
            c.esc = 0;
        }
        return;
    }
    if c.esc == 2 {
        if ch >= 48 && ch <= 57 {
            var last: i64 = c.args.len() - 1;
            c.args.set(last, c.args.get(last) * 10 + (ch - 48));
            return;
        }
        if ch == 59 {
            c.args.push(0);
            return;
        }
        c.esc = 0;
        con_csi_final(c, ch);
        return;
    }
    if ch == 27 {
        c.esc = 1;
        return;
    }
    if ch == 10 {
        con_newline(c);
        return;
    }
    if ch == 13 {
        c.cx = 0;
        return;
    }
    if ch == 9 {
        c.cx = (c.cx / 8 + 1) * 8;
        if c.cx > c.cols { c.cx = c.cols; }
        return;
    }
    if ch == 8 {
        if c.cx > 0 { c.cx = c.cx - 1; }
        return;
    }
    if c.cx >= c.cols {
        con_newline(c);
    }
    fb_draw_char(&mut c.fb, c.cx * FB_FONT_W, c.cy * FB_FONT_H, ch, c.fg, c.bg, true);
    c.text.set(c.cy * c.cols + c.cx, ch);
    c.cx = c.cx + 1;
}

pub fn con_write(c: & mut Console, s: str) {
    var i: i64 = 0;
    while i < str_len(s) {
        con_putc(c, str_byte_at(s, i));
        i = i + 1;
    }
}

/// Text of a console row, trailing blanks removed.
pub fn con_row_text(c: & Console, row: i64) -> str {
    var end: i64 = c.cols;
    while end > 0 && c.text.get(row * c.cols + end - 1) == 32 {
        end = end - 1;
    }
    var b: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < end {
        b.push(c.text.get(row * c.cols + i));
        i = i + 1;
    }
    return str_from_bytes(b);
}
