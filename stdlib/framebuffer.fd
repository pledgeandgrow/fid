// Linear framebuffer graphics and a text console with a built-in 8x16
// bitmap font (printable ASCII, 0x20..0x7E).
//
// What is real: pixel formats by channel position and size (XRGB8888,
// XBGR8888, 24-bit RGB888/BGR888, RGB565, BGR565, RGB555, or any masks a
// bootloader reports, e.g. the multiboot2 / UEFI GOP framebuffer info),
// color packing and unpacking with bit replication, pitch-aware pixel
// addressing, put/get pixel, clipped rectangles, outlines, lines, clipped
// blits from RGB images, overlapping rectangle copies, scrolling, glyph
// rendering (opaque or transparent background), and a console: cursor,
// newline, carriage return, tab stops, backspace, deferred line wrap,
// scrolling, a text shadow buffer, and ANSI SGR colors (ESC[...m with
// the 16 VGA colors), ESC[2J and ESC[H.
//
// The font is drawn for this module: 5x7 glyphs (descenders one row
// lower) in an 8x8 grid, doubled vertically into 8x16 cells.
//
// The seam: framebuffer memory. fb_new() keeps the pixels in a Vec of
// bytes (tests, off-screen buffers); fb_at(addr, ...) writes a mapped
// framebuffer with byte-wide volatile stores from @unsafe helpers, which
// needs a kernel that mapped it (write-combining).
module framebuffer;
 use vec;

pub const FB_XRGB8888: i64 = 0;
pub const FB_XBGR8888: i64 = 1;
pub const FB_RGB888: i64 = 2;
pub const FB_BGR888: i64 = 3;
pub const FB_RGB565: i64 = 4;
pub const FB_BGR565: i64 = 5;
pub const FB_RGB555: i64 = 6;

pub struct PixelFormat {
    pub bpp: i64,
    pub bytes: i64,
    pub r_shift: i64,
    pub r_len: i64,
    pub g_shift: i64,
    pub g_len: i64,
    pub b_shift: i64,
    pub b_len: i64,
}

/// Format from channel positions and sizes (bit offsets in the
/// little-endian pixel value), as multiboot2 and GOP report them.
pub fn fb_format_masks(bpp: i64, r_shift: i64, r_len: i64, g_shift: i64, g_len: i64, b_shift: i64, b_len: i64) -> PixelFormat {
    return PixelFormat {
        bpp: bpp, bytes: (bpp + 7) / 8, r_shift: r_shift, r_len: r_len, g_shift: g_shift, g_len: g_len, b_shift: b_shift, b_len: b_len
    };
}

pub fn fb_format(kind: i64) -> PixelFormat {
    if kind == FB_XBGR8888 { return fb_format_masks(32, 0, 8, 8, 8, 16, 8); }
    if kind == FB_RGB888 { return fb_format_masks(24, 16, 8, 8, 8, 0, 8); }
    if kind == FB_BGR888 { return fb_format_masks(24, 0, 8, 8, 8, 16, 8); }
    if kind == FB_RGB565 { return fb_format_masks(16, 11, 5, 5, 6, 0, 5); }
    if kind == FB_BGR565 { return fb_format_masks(16, 0, 5, 5, 6, 11, 5); }
    if kind == FB_RGB555 { return fb_format_masks(15, 10, 5, 5, 5, 0, 5); }
    return fb_format_masks(32, 16, 8, 8, 8, 0, 8);
}

fn fb_chan_pack(c: i64, len: i64, shift: i64) -> i64 {
    return ((c & 255) >> (8 - len)) << shift;
}

fn fb_chan_unpack(v: i64, len: i64, shift: i64) -> i64 {
    var x: i64 = (v >> shift) & ((1 << len) - 1);
    if len >= 8 {
        return x >> (len - 8);
    }
    // replicate the top bits into the low ones: 5-bit 31 -> 255
    var r: i64 = x << (8 - len);
    var fill: i64 = 8 - len;
    while fill > 0 {
        var take: i64 = len;
        if take > fill { take = fill; }
        r = r | ((x >> (len - take)) << (fill - take));
        fill = fill - take;
    }
    return r;
}

/// Pixel value of an 0xRRGGBB color.
pub fn fb_pack(f: & PixelFormat, rgb: i64) -> i64 {
    return fb_chan_pack(rgb >> 16, f.r_len, f.r_shift) | fb_chan_pack(rgb >> 8, f.g_len, f.g_shift) | fb_chan_pack(rgb, f.b_len, f.b_shift);
}

/// 0xRRGGBB of a pixel value.
pub fn fb_unpack(f: & PixelFormat, v: i64) -> i64 {
    return (fb_chan_unpack(v, f.r_len, f.r_shift) << 16) | (fb_chan_unpack(v, f.g_len, f.g_shift) << 8) | fb_chan_unpack(v, f.b_len, f.b_shift);
}

// ─── Framebuffer ────────────────────────────────────────────────────────

pub struct Framebuffer {
    pub width: i64,
    pub height: i64,
    pub pitch: i64,
    pub fmt: PixelFormat,
    pub fake: bool,
    pub mem: Vec<i64>,
    pub addr: i64,
}

/// An in-memory framebuffer (lines padded to 4 bytes).
pub fn fb_new(width: i64, height: i64, kind: i64) -> Framebuffer {
    var f: PixelFormat = fb_format(kind);
    var pitch: i64 = (width * f.bytes + 3) / 4 * 4;
    return Framebuffer { width: width, height: height, pitch: pitch, fmt: f, fake: true, mem: Vec::filled(pitch * height, 0), addr: 0 };
}

/// A mapped hardware framebuffer at virtual address addr.
pub fn fb_at(addr: i64, width: i64, height: i64, pitch: i64, f: PixelFormat) -> Framebuffer {
    return Framebuffer { width: width, height: height, pitch: pitch, fmt: f, fake: false, mem: Vec::new(), addr: addr };
}

@unsafe
fn fb_raw_store8(a: i64, v: i64) {
    p_volatile_store8(a, v);
}

@unsafe
fn fb_raw_load8(a: i64) -> i64 {
    return p_volatile_load8(a);
}

fn fb_wbyte(fb: & mut Framebuffer, off: i64, v: i64) {
    if fb.fake {
        fb.mem.set(off, v & 255);
        return;
    }
    unsafe { fb_raw_store8(fb.addr + off, v & 255); }
}

fn fb_rbyte(fb: & Framebuffer, off: i64) -> i64 {
    if fb.fake {
        return fb.mem.get(off);
    }
    unsafe { return fb_raw_load8(fb.addr + off); }
}

/// Byte offset of pixel (x, y).
pub fn fb_offset(fb: & Framebuffer, x: i64, y: i64) -> i64 {
    return y * fb.pitch + x * fb.fmt.bytes;
}

fn fb_store_px(fb: & mut Framebuffer, off: i64, px: i64) {
    var i: i64 = 0;
    while i < fb.fmt.bytes {
        fb_wbyte(fb, off + i, px >> (i * 8));
        i = i + 1;
    }
}

/// Raw pixel value at (x, y).
pub fn fb_get_raw(fb: & Framebuffer, x: i64, y: i64) -> i64 {
    var off: i64 = fb_offset(fb, x, y);
    var v: i64 = 0;
    var i: i64 = fb.fmt.bytes - 1;
    while i >= 0 {
        v = (v << 8) | fb_rbyte(fb, off + i);
        i = i - 1;
    }
    return v;
}

pub fn fb_put_pixel(fb: & mut Framebuffer, x: i64, y: i64, rgb: i64) {
    if x < 0 || y < 0 || x >= fb.width || y >= fb.height {
        return;
    }
    var px: i64 = fb_pack(&fb.fmt, rgb);
    fb_store_px(fb, fb_offset(fb, x, y), px);
}

/// 0xRRGGBB at (x, y), -1 outside.
pub fn fb_get_pixel(fb: & Framebuffer, x: i64, y: i64) -> i64 {
    if x < 0 || y < 0 || x >= fb.width || y >= fb.height {
        return -1;
    }
    return fb_unpack(&fb.fmt, fb_get_raw(fb, x, y));
}

/// Filled rectangle, clipped to the screen.
pub fn fb_fill_rect(fb: & mut Framebuffer, x: i64, y: i64, w: i64, h: i64, rgb: i64) {
    var x0: i64 = x;
    var y0: i64 = y;
    var x1: i64 = x + w;
    var y1: i64 = y + h;
    if x0 < 0 { x0 = 0; }
    if y0 < 0 { y0 = 0; }
    if x1 > fb.width { x1 = fb.width; }
    if y1 > fb.height { y1 = fb.height; }
    if x0 >= x1 || y0 >= y1 {
        return;
    }
    var px: i64 = fb_pack(&fb.fmt, rgb);
    var yy: i64 = y0;
    while yy < y1 {
        var off: i64 = fb_offset(fb, x0, yy);
        var xx: i64 = x0;
        while xx < x1 {
            fb_store_px(fb, off, px);
            off = off + fb.fmt.bytes;
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}

pub fn fb_clear(fb: & mut Framebuffer, rgb: i64) {
    fb_fill_rect(fb, 0, 0, fb.width, fb.height, rgb);
}

/// Rectangle outline one pixel wide.
pub fn fb_rect(fb: & mut Framebuffer, x: i64, y: i64, w: i64, h: i64, rgb: i64) {
    if w <= 0 || h <= 0 {
        return;
    }
    fb_fill_rect(fb, x, y, w, 1, rgb);
    fb_fill_rect(fb, x, y + h - 1, w, 1, rgb);
    fb_fill_rect(fb, x, y + 1, 1, h - 2, rgb);
    fb_fill_rect(fb, x + w - 1, y + 1, 1, h - 2, rgb);
}

/// Bresenham line, clipped per pixel.
pub fn fb_line(fb: & mut Framebuffer, x0: i64, y0: i64, x1: i64, y1: i64, rgb: i64) {
    var dx: i64 = x1 - x0;
    if dx < 0 { dx = 0 - dx; }
    var dy: i64 = y1 - y0;
    if dy > 0 { dy = 0 - dy; }
    var sx: i64 = 1;
    if x0 > x1 { sx = -1; }
    var sy: i64 = 1;
    if y0 > y1 { sy = -1; }
    var err: i64 = dx + dy;
    var x: i64 = x0;
    var y: i64 = y0;
    while true {
        fb_put_pixel(fb, x, y, rgb);
        if x == x1 && y == y1 {
            return;
        }
        var e2: i64 = 2 * err;
        if e2 >= dy {
            err = err + dy;
            x = x + sx;
        }
        if e2 <= dx {
            err = err + dx;
            y = y + sy;
        }
    }
}

/// Copy a w x h image of 0xRRGGBB values (row-major) to (x, y), clipped.
pub fn fb_blit(fb: & mut Framebuffer, x: i64, y: i64, w: i64, h: i64, img: Vec<i64>) {
    var j: i64 = 0;
    while j < h {
        var yy: i64 = y + j;
        if yy >= 0 && yy < fb.height {
            var i: i64 = 0;
            while i < w {
                var xx: i64 = x + i;
                if xx >= 0 && xx < fb.width {
                    fb_store_px(fb, fb_offset(fb, xx, yy), fb_pack(&fb.fmt, img.get(j * w + i)));
                }
                i = i + 1;
            }
        }
        j = j + 1;
    }
}

/// Move a rectangle inside the framebuffer; source and destination may
/// overlap (copies in the safe direction). Both must be on screen.
pub fn fb_copy_rect(fb: & mut Framebuffer, sx: i64, sy: i64, w: i64, h: i64, dx: i64, dy: i64) {
    var nb: i64 = w * fb.fmt.bytes;
    var backwards: bool = dy > sy || (dy == sy && dx > sx);
    var r: i64 = 0;
    while r < h {
        var row: i64 = r;
        if backwards { row = h - 1 - r; }
        var so: i64 = fb_offset(fb, sx, sy + row);
        var dof: i64 = fb_offset(fb, dx, dy + row);
        var k: i64 = 0;
        while k < nb {
            var kk: i64 = k;
            if backwards && dy == sy { kk = nb - 1 - k; }
            fb_wbyte(fb, dof + kk, fb_rbyte(fb, so + kk));
            k = k + 1;
        }
        r = r + 1;
    }
}

/// Scroll the whole screen up by n pixel rows, filling the bottom with bg.
pub fn fb_scroll_up(fb: & mut Framebuffer, n: i64, bg: i64) {
    if n >= fb.height {
        fb_clear(fb, bg);
        return;
    }
    var total: i64 = (fb.height - n) * fb.pitch;
    var src: i64 = n * fb.pitch;
    var i: i64 = 0;
    while i < total {
        fb_wbyte(fb, i, fb_rbyte(fb, src + i));
        i = i + 1;
    }
    fb_fill_rect(fb, 0, fb.height - n, fb.width, n, bg);
}

