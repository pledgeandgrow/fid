// Fides push notifications: APNs and FCM
//
// What is real (pure Fides, tested in the interpreter):
//   - APNs payloads: the "aps" dictionary (alert with title / subtitle /
//     body / localization keys, badge, sound, content-available,
//     mutable-content, category, thread-id, interruption-level,
//     relevance-score) plus custom keys; the 4096-byte limit (5120 for
//     VoIP) with UTF-8-safe truncation of the body to fit; the request
//     line and headers (apns-push-type, apns-priority, apns-topic,
//     apns-expiration, apns-collapse-id) with the rules that tie them
//     (background pushes: content-available only, priority 5)
//   - FCM HTTP v1 messages: token / topic / condition targets,
//     notification, string-only data (reserved keys refused), android
//     (priority, ttl as "Ns", collapse_key, channel_id) and apns
//     overrides; the send URL of a project
//   - device tokens: APNs hex tokens (bytes <-> hex) and FCM registration
//     token checks
//   - the APNs provider token (JWT, ES256): header {"alg","kid"}, claims
//     {"iss","iat"}, base64url without padding, refresh after 50 minutes
//     (Apple accepts a token for an hour and refuses refreshes more often
//     than every 20 minutes), and DER ECDSA signature -> raw r||s
//   - notification categories and actions (UNNotificationCategory) with
//     identifier checks, and parsing a received userInfo / data payload
//
// The seam: ES256 signing is a function value
//   sign: fn(Vec<i64>) -> Vec<i64>   (signing input bytes -> signature)
// returning either the 64-byte raw r||s or a DER signature (converted
// here). On a device or server it is P-256 ECDSA with the .p8 key (a C
// library, the OS keychain, or stdlib ecdsa); sending the HTTP/2 request
// is the caller's.
//
// Usage:
//   use push;
//   var p: ApnsPayload = apns_payload_new();
//   p.title = "Order shipped"; p.body = "Arrives Tuesday"; p.badge = 1;
//   val body: str = apns_payload_json(&p);
//   val jwt: str = apns_provider_token("ABC123DEFG", "DEF123GHIJ", now, my_signer);

module push;
use vec;
use string;
use encoding;
use json;

pub const APNS_MAX_PAYLOAD: i64 = 4096;
pub const APNS_MAX_PAYLOAD_VOIP: i64 = 5120;
pub const APNS_HOST: str = "api.push.apple.com";
pub const APNS_HOST_SANDBOX: str = "api.sandbox.push.apple.com";
pub const APNS_JWT_REFRESH_SECS: i64 = 3000;  // 50 minutes
pub const APNS_JWT_MIN_REFRESH_SECS: i64 = 1200;  // 20 minutes

// ─── base64url ─────────────────────────────────────────────────────────

/// base64url without padding (RFC 7515 §2).
pub fn push_b64url(bytes: Vec<i64>) -> str {
    val b: str = b64_encode_bytes(bytes);
    var out: str = "";
    var i: i64 = 0;
    while i < str_len(b) {
        val c: i64 = str_byte_at(b, i);
        if c == 43 {
            out = out + "-";
        } else if c == 47 {
            out = out + "_";
        } else if c != 61 {
            out = out + char_to_str(c);
        }
        i = i + 1;
    }
    return out;
}

/// Decode base64url (padding optional).
pub fn push_b64url_decode(s: str) -> Vec<i64> {
    var t: str = "";
    var i: i64 = 0;
    while i < str_len(s) {
        val c: i64 = str_byte_at(s, i);
        if c == 45 {
            t = t + "+";
        } else if c == 95 {
            t = t + "/";
        } else if c != 61 {
            t = t + char_to_str(c);
        }
        i = i + 1;
    }
    while str_len(t) % 4 != 0 {
        t = t + "=";
    }
    return b64_decode_bytes(t);
}

// ─── APNs payloads ─────────────────────────────────────────────────────

pub struct ApnsPayload {
    pub title: str,
    pub subtitle: str,
    pub body: str,
    pub loc_key: str,  // title-loc-key is not used; body loc-key
    pub loc_args: Vec<str>,
    pub badge: i64,  // -1: leave the badge alone
    pub sound: str,  // "" none, "default", or a file name
    pub content_available: bool,
    pub mutable_content: bool,
    pub category: str,
    pub thread_id: str,
    pub interruption_level: str,  // passive, active, time-sensitive, critical
    pub relevance: i64,  // relevance-score in percent, -1 none
    pub custom_keys: Vec<str>,
    pub custom_vals: Vec<str>,  // raw JSON values
}

pub fn apns_payload_new() -> ApnsPayload {
    return ApnsPayload {
        title: "", subtitle: "", body: "", loc_key: "", loc_args: Vec::new(), badge: -1, sound: "", content_available: false, mutable_content: false, category: "", thread_id: "", interruption_level: "", relevance: -1, custom_keys: Vec::new(), custom_vals: Vec::new(),
    };
}

/// Add a custom top-level key with a raw JSON value ("aps" is refused).
pub fn apns_payload_custom(p: &mut ApnsPayload, key: str, raw_json: str) -> bool {
    if key == "aps" || !json_is_valid(raw_json) {
        return false;
    }
    p.custom_keys.push(key);
    p.custom_vals.push(raw_json);
    return true;
}

fn push_member(out: str, key: str, raw: str) -> str {
    var o: str = out;
    if str_len(o) > 1 {
        o = o + ",";
    }
    return o + json_string(key) + ":" + raw;
}

fn push_alert_json(p: &ApnsPayload) -> str {
    if str_len(p.title) == 0 && str_len(p.subtitle) == 0 && str_len(p.loc_key) == 0 {
        if str_len(p.body) == 0 {
            return "";
        }
        return json_string(p.body);
    }
    var a: str = "{";
    if str_len(p.title) > 0 {
        a = push_member(a, "title", json_string(p.title));
    }
    if str_len(p.subtitle) > 0 {
        a = push_member(a, "subtitle", json_string(p.subtitle));
    }
    if str_len(p.body) > 0 {
        a = push_member(a, "body", json_string(p.body));
    }
    if str_len(p.loc_key) > 0 {
        a = push_member(a, "loc-key", json_string(p.loc_key));
        var args: str = "[";
        var i: i64 = 0;
        while i < p.loc_args.len() {
            if i > 0 {
                args = args + ",";
            }
            args = args + json_string(p.loc_args.get(i));
            i = i + 1;
        }
        a = push_member(a, "loc-args", args + "]");
    }
    return a + "}";
}

/// The aps dictionary alone.
pub fn apns_aps_json(p: &ApnsPayload) -> str {
    var aps: str = "{";
    val alert: str = push_alert_json(p);
    if str_len(alert) > 0 {
        aps = push_member(aps, "alert", alert);
    }
    if p.badge >= 0 {
        aps = push_member(aps, "badge", int_to_str(p.badge));
    }
    if str_len(p.sound) > 0 {
        aps = push_member(aps, "sound", json_string(p.sound));
    }
    if p.content_available {
        aps = push_member(aps, "content-available", "1");
    }
    if p.mutable_content {
        aps = push_member(aps, "mutable-content", "1");
    }
    if str_len(p.category) > 0 {
        aps = push_member(aps, "category", json_string(p.category));
    }
    if str_len(p.thread_id) > 0 {
        aps = push_member(aps, "thread-id", json_string(p.thread_id));
    }
    if str_len(p.interruption_level) > 0 {
        aps = push_member(aps, "interruption-level", json_string(p.interruption_level));
    }
    if p.relevance >= 0 {
        // relevance-score is a number 0..1
        val r: i64 = if p.relevance > 100 {
            100
        } else {
            p.relevance
        };
        val txt: str = if r == 100 {
            "1"
        } else if r < 10 {
            "0.0" + int_to_str(r)
        } else {
            "0." + int_to_str(r)
        };
        aps = push_member(aps, "relevance-score", txt);
    }
    return aps + "}";
}

/// The full payload: {"aps":{...}, custom...}.
pub fn apns_payload_json(p: &ApnsPayload) -> str {
    var out: str = "{" + json_string("aps") + ":" + apns_aps_json(p);
    var i: i64 = 0;
    while i < p.custom_keys.len() {
        out = out + "," + json_string(p.custom_keys.get(i)) + ":" + p.custom_vals.get(i);
        i = i + 1;
    }
    return out + "}";
}

/// Problems that make APNs refuse or mis-deliver the payload ("" none).
pub fn apns_payload_check(p: &ApnsPayload, voip: bool) -> str {
    val levels: str = ",passive,active,time-sensitive,critical,";
    if str_len(p.interruption_level) > 0 && !str_contains(levels, "," + p.interruption_level + ",") {
        return "bad interruption-level " + p.interruption_level;
    }
    if p.relevance > 100 {
        return "relevance-score above 1";
    }
    val max: i64 = if voip {
        APNS_MAX_PAYLOAD_VOIP
    } else {
        APNS_MAX_PAYLOAD
    };
    val n: i64 = str_len(apns_payload_json(p));
    if n > max {
        return "payload " + int_to_str(n) + " bytes > " + int_to_str(max);
    }
    return "";
}

// Largest k <= n with no UTF-8 continuation byte at s[k].
fn push_utf8_cut(s: str, n: i64) -> i64 {
    var k: i64 = n;
    if k >= str_len(s) {
        return str_len(s);
    }
    while k > 0 && (str_byte_at(s, k) & 0xC0) == 0x80 {
        k = k - 1;
    }
    return k;
}

/// Shorten the body (UTF-8 safe, ending in "...") until the payload fits
/// `max` bytes. Returns false when even an empty body does not fit.
pub fn apns_payload_fit(p: &mut ApnsPayload, max: i64) -> bool {
    var size: i64 = str_len(apns_payload_json(p));
    if size <= max {
        return true;
    }
    val full: str = p.body;
    var keep: i64 = str_len(full) - (size - max) - 3;
    while keep >= 0 {
        val k: i64 = push_utf8_cut(full, keep);
        p.body = str_slice(full, 0, k) + "...";
        size = str_len(apns_payload_json(p));
        if size <= max {
            return true;
        }
        keep = k - (size - max);
        if keep >= k {
            keep = k - 1;
        }
    }
    p.body = "";
    return str_len(apns_payload_json(p)) <= max;
}

// ─── APNs request ──────────────────────────────────────────────────────

pub struct ApnsRequest {
    pub ok: bool,
    pub error: str,
    pub path: str,
    pub header_names: Vec<str>,
    pub header_vals: Vec<str>,
    pub body: str,
}

/// The HTTP/2 request for one device: path, headers, body. `push_type`
/// is alert, background, voip, complication, fileprovider, mdm,
/// location or liveactivity; `expiration` 0 means deliver once or drop.
pub fn apns_request(token_hex: str, topic: str, push_type: str, p: &ApnsPayload, expiration: i64, collapse_id: str, jwt: str) -> ApnsRequest {
    var hn: Vec<str> = Vec::new();
    var hv: Vec<str> = Vec::new();
    val bad: ApnsRequest = ApnsRequest {
        ok: false, error: "", path: "", header_names: Vec::new(), header_vals: Vec::new(), body: ""
    };
    if !apns_token_valid(token_hex) {
        var b: ApnsRequest = bad;
        b.error = "bad device token";
        return b;
    }
    if str_len(collapse_id) > 64 {
        var b: ApnsRequest = bad;
        b.error = "apns-collapse-id longer than 64 bytes";
        return b;
    }
    var priority: str = "10";
    var t: str = topic;
    if push_type == "background" {
        if str_len(push_alert_json(p)) > 0 || p.badge >= 0 || str_len(p.sound) > 0 || !p.content_available {
            var b: ApnsRequest = bad;
            b.error = "background push must carry content-available only";
            return b;
        }
        priority = "5";
    }
    if push_type == "voip" {
        t = topic + ".voip";
    }
    if push_type == "complication" {
        t = topic + ".complication";
    }
    if push_type == "liveactivity" {
        t = topic + ".push-type.liveactivity";
    }
    val chk: str = apns_payload_check(p, push_type == "voip");
    if str_len(chk) > 0 {
        var b: ApnsRequest = bad;
        b.error = chk;
        return b;
    }
    hn.push(":method");
    hv.push("POST");
    hn.push(":path");
    hv.push("/3/device/" + str_to_lower(token_hex));
    if str_len(jwt) > 0 {
        hn.push("authorization");
        hv.push("bearer " + jwt);
    }
    hn.push("apns-push-type");
    hv.push(push_type);
    hn.push("apns-topic");
    hv.push(t);
    hn.push("apns-priority");
    hv.push(priority);
    hn.push("apns-expiration");
    hv.push(int_to_str(expiration));
    if str_len(collapse_id) > 0 {
        hn.push("apns-collapse-id");
        hv.push(collapse_id);
    }
    return ApnsRequest {
        ok: true, error: "", path: "/3/device/" + str_to_lower(token_hex), header_names: hn, header_vals: hv, body: apns_payload_json(p)
    };
}

// ─── Device tokens ─────────────────────────────────────────────────────

/// An APNs device token: an even number of hex digits, 32 bytes today
/// (up to 100 bytes accepted, as Apple asks providers to).
pub fn apns_token_valid(hex: str) -> bool {
    val n: i64 = str_len(hex);
    if n < 64 || n > 200 || n % 2 != 0 {
        return false;
    }
    return hex_valid(hex);
}

/// The token string of the bytes iOS hands to
/// application:didRegisterForRemoteNotificationsWithDeviceToken:.
pub fn apns_token_hex(bytes: Vec<i64>) -> str {
    return hex_encode_bytes(bytes);
}

/// An FCM registration token: [A-Za-z0-9_:-] and at least 100 characters
/// (they are about 150 to 165 long).
pub fn fcm_token_valid(t: str) -> bool {
    val n: i64 = str_len(t);
    if n < 100 || n > 4096 {
        return false;
    }
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(t, i);
        if !(char_is_alpha(c) || char_is_digit(c) || c == 95 || c == 58 || c == 45) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ─── FCM HTTP v1 ───────────────────────────────────────────────────────

pub struct FcmMessage {
    pub token: str,
    pub topic: str,
    pub condition: str,
    pub title: str,
    pub body: str,
    pub image: str,
    pub data_keys: Vec<str>,
    pub data_vals: Vec<str>,
    pub android_priority: str,  // "" , "normal", "high"
    pub ttl_secs: i64,  // -1: none
    pub collapse_key: str,
    pub channel_id: str,
    pub apns: ApnsPayload,  // apns override; used when it has content
    pub apns_priority: str,
}

pub fn fcm_message_new() -> FcmMessage {
    return FcmMessage {
        token: "", topic: "", condition: "", title: "", body: "", image: "", data_keys: Vec::new(), data_vals: Vec::new(), android_priority: "", ttl_secs: -1, collapse_key: "", channel_id: "", apns: apns_payload_new(), apns_priority: "",
    };
}

/// Is `key` allowed in FCM data (not "from", "notification",
/// "message_type", or a "google." / "gcm." prefix)?
pub fn fcm_data_key_ok(key: str) -> bool {
    if str_len(key) == 0 {
        return false;
    }
    if key == "from" || key == "notification" || key == "message_type" {
        return false;
    }
    if str_starts_with(key, "google.") || str_starts_with(key, "gcm.") {
        return false;
    }
    return true;
}

pub fn fcm_add_data(m: &mut FcmMessage, key: str, value: str) -> bool {
    if !fcm_data_key_ok(key) {
        return false;
    }
    m.data_keys.push(key);
    m.data_vals.push(value);
    return true;
}

/// The send URL of a Firebase project.
pub fn fcm_send_url(project_id: str) -> str {
    return "https://fcm.googleapis.com/v1/projects/" + project_id + "/messages:send";
}

/// The request body {"message":{...}}; "" when the target is not exactly
/// one of token, topic, condition.
pub fn fcm_message_json(m: &FcmMessage) -> str {
    var targets: i64 = 0;
    if str_len(m.token) > 0 {
        targets = targets + 1;
    }
    if str_len(m.topic) > 0 {
        targets = targets + 1;
    }
    if str_len(m.condition) > 0 {
        targets = targets + 1;
    }
    if targets != 1 {
        return "";
    }
    var o: str = "{";
    if str_len(m.token) > 0 {
        o = push_member(o, "token", json_string(m.token));
    }
    if str_len(m.topic) > 0 {
        o = push_member(o, "topic", json_string(m.topic));
    }
    if str_len(m.condition) > 0 {
        o = push_member(o, "condition", json_string(m.condition));
    }
    if str_len(m.title) > 0 || str_len(m.body) > 0 || str_len(m.image) > 0 {
        var n: str = "{";
        if str_len(m.title) > 0 {
            n = push_member(n, "title", json_string(m.title));
        }
        if str_len(m.body) > 0 {
            n = push_member(n, "body", json_string(m.body));
        }
        if str_len(m.image) > 0 {
            n = push_member(n, "image", json_string(m.image));
        }
        o = push_member(o, "notification", n + "}");
    }
    if m.data_keys.len() > 0 {
        var d: str = "{";
        var i: i64 = 0;
        while i < m.data_keys.len() {
            d = push_member(d, m.data_keys.get(i), json_string(m.data_vals.get(i)));
            i = i + 1;
        }
        o = push_member(o, "data", d + "}");
    }
    if str_len(m.android_priority) > 0 || m.ttl_secs >= 0 || str_len(m.collapse_key) > 0 || str_len(m.channel_id) > 0 {
        var a: str = "{";
        if str_len(m.android_priority) > 0 {
            a = push_member(a, "priority", json_string(m.android_priority));
        }
        if m.ttl_secs >= 0 {
            a = push_member(a, "ttl", json_string(int_to_str(m.ttl_secs) + "s"));
        }
        if str_len(m.collapse_key) > 0 {
            a = push_member(a, "collapse_key", json_string(m.collapse_key));
        }
        if str_len(m.channel_id) > 0 {
            a = push_member(a, "notification", "{" + json_string("channel_id") + ":" + json_string(m.channel_id) + "}");
        }
        o = push_member(o, "android", a + "}");
    }
    val aps: str = apns_aps_json(&m.apns);
    if aps != "{}" || str_len(m.apns_priority) > 0 {
        var ap: str = "{";
        if str_len(m.apns_priority) > 0 {
            ap = push_member(ap, "headers", "{" + json_string("apns-priority") + ":" + json_string(m.apns_priority) + "}");
        }
        ap = push_member(ap, "payload", apns_payload_json(&m.apns));
        o = push_member(o, "apns", ap + "}");
    }
    return "{" + json_string("message") + ":" + o + "}}";
}

// ─── Provider token (JWT ES256) ────────────────────────────────────────

/// The signing input: base64url(header) "." base64url(claims).
pub fn apns_jwt_signing_input(key_id: str, team_id: str, iat: i64) -> str {
    val header: str = "{" + json_string("alg") + ":" + json_string("ES256") + "," + json_string("kid") + ":" + json_string(key_id) + "}";
    val claims: str = "{" + json_string("iss") + ":" + json_string(team_id) + "," + json_string("iat") + ":" + int_to_str(iat) + "}";
    return push_b64url(str_bytes(header)) + "." + push_b64url(str_bytes(claims));
}

/// A raw 64-byte r||s from a DER ECDSA-Sig-Value (SEQUENCE of two
/// INTEGERs); empty when malformed. A 64-byte input is returned as is.
pub fn push_der_to_raw(sig: Vec<i64>) -> Vec<i64> {
    var empty: Vec<i64> = Vec::new();
    if sig.len() == 64 && sig.get(0) != 0x30 {
        return sig;
    }
    if sig.len() < 8 || sig.get(0) != 0x30 {
        return empty;
    }
    var pos: i64 = 2;
    if sig.get(1) == 0x81 {
        pos = 3;
    }
    var out: Vec<i64> = Vec::new();
    var part: i64 = 0;
    while part < 2 {
        if pos + 2 > sig.len() || sig.get(pos) != 0x02 {
            return empty;
        }
        val len: i64 = sig.get(pos + 1);
        pos = pos + 2;
        if len < 1 || pos + len > sig.len() {
            return empty;
        }
        var start: i64 = pos;
        var n: i64 = len;
        while n > 32 && sig.get(start) == 0 {
            start = start + 1;
            n = n - 1;
        }
        if n > 32 {
            return empty;
        }
        var pad: i64 = 32 - n;
        while pad > 0 {
            out.push(0);
            pad = pad - 1;
        }
        var i: i64 = 0;
        while i < n {
            out.push(sig.get(start + i));
            i = i + 1;
        }
        pos = pos + len;
        part = part + 1;
    }
    return out;
}

/// The provider token: signing input "." base64url(r||s); "" when the
/// signer fails.
pub fn apns_provider_token(key_id: str, team_id: str, iat: i64, sign: fn(Vec<i64>) -> Vec<i64>) -> str {
    val input: str = apns_jwt_signing_input(key_id, team_id, iat);
    val raw: Vec<i64> = push_der_to_raw(sign(str_bytes(input)));
    if raw.len() != 64 {
        return "";
    }
    return input + "." + push_b64url(raw);
}

/// Should a token issued at `iat` be replaced at `now` (seconds)?
pub fn apns_jwt_should_refresh(iat: i64, now: i64) -> bool {
    return now - iat >= APNS_JWT_REFRESH_SECS;
}

// ─── Categories and actions ────────────────────────────────────────────

pub const PUSH_ACTION_FOREGROUND: i64 = 1;  // UNNotificationActionOptionForeground (4)
pub const PUSH_ACTION_DESTRUCTIVE: i64 = 2;  // ...Destructive (2)
pub const PUSH_ACTION_AUTH: i64 = 4;  // ...AuthenticationRequired (1)

pub struct PushAction {
    pub id: str,
    pub title: str,
    pub options: i64,
    pub text_input: bool,
}

pub struct PushCategory {
    pub id: str,
    pub actions: Vec<PushAction>,
}

/// UNNotificationActionOptions bits of PUSH_ACTION_* flags.
pub fn push_action_un_options(opts: i64) -> i64 {
    var r: i64 = 0;
    if (opts & PUSH_ACTION_AUTH) != 0 {
        r = r | 1;
    }
    if (opts & PUSH_ACTION_DESTRUCTIVE) != 0 {
        r = r | 2;
    }
    if (opts & PUSH_ACTION_FOREGROUND) != 0 {
        r = r | 4;
    }
    return r;
}

/// Problems of a category set: empty or duplicate identifiers, more than
/// 10 actions (iOS shows at most 10), reserved identifiers.
pub fn push_categories_check(cats: Vec<PushCategory>) -> Vec<str> {
    var errs: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < cats.len() {
        val c: PushCategory = cats.get(i);
        if str_len(c.id) == 0 {
            errs.push("category without identifier");
        }
        var j: i64 = 0;
        while j < i {
            if cats.get(j).id == c.id {
                errs.push("duplicate category " + c.id);
            }
            j = j + 1;
        }
        if c.actions.len() > 10 {
            errs.push(c.id + ": more than 10 actions");
        }
        var a: i64 = 0;
        while a < c.actions.len() {
            val act: PushAction = c.actions.get(a);
            if str_len(act.id) == 0 || str_len(act.title) == 0 {
                errs.push(c.id + ": action needs identifier and title");
            }
            if str_starts_with(act.id, "com.apple.") {
                errs.push(c.id + ": reserved action " + act.id);
            }
            var b: i64 = 0;
            while b < a {
                if c.actions.get(b).id == act.id {
                    errs.push(c.id + ": duplicate action " + act.id);
                }
                b = b + 1;
            }
            a = a + 1;
        }
        i = i + 1;
    }
    return errs;
}

/// What a response's actionIdentifier means: "open" (default action),
/// "dismiss", or the custom action identifier.
pub fn push_response_action(action_identifier: str) -> str {
    if action_identifier == "com.apple.UNNotificationDefaultActionIdentifier" {
        return "open";
    }
    if action_identifier == "com.apple.UNNotificationDismissActionIdentifier" {
        return "dismiss";
    }
    return action_identifier;
}

// ─── Received payloads ─────────────────────────────────────────────────

pub struct PushReceived {
    pub ok: bool,
    pub title: str,
    pub body: str,
    pub badge: i64,
    pub category: str,
    pub silent: bool,  // content-available without an alert
    pub data_keys: Vec<str>,  // custom keys (APNs) or data keys (FCM)
    pub data_vals: Vec<str>,  // raw JSON values
}

fn push_jstr(obj: str, key: str) -> str {
    val raw: str = json_get_safe(obj, key);
    if str_starts_with(raw, "\"") {
        return json_unescape(raw);
    }
    return "";
}

/// Parse an APNs userInfo or an FCM data message as JSON text.
pub fn push_parse_received(text: str) -> PushReceived {
    var r: PushReceived = PushReceived {
        ok: false, title: "", body: "", badge: -1, category: "", silent: false, data_keys: Vec::new(), data_vals: Vec::new(),
    };
    if json_type_safe(text) != "object" {
        return r;
    }
    r.ok = true;
    val aps: str = json_get_safe(text, "aps");
    if json_type_safe(aps) == "object" {
        val alert: str = json_get_safe(aps, "alert");
        if str_starts_with(alert, "\"") {
            r.body = json_unescape(alert);
        } else if json_type_safe(alert) == "object" {
            r.title = push_jstr(alert, "title");
            r.body = push_jstr(alert, "body");
        }
        val badge: str = json_get_safe(aps, "badge");
        if json_type_safe(badge) == "number" {
            r.badge = str_parse_int(badge);
        }
        r.category = push_jstr(aps, "category");
        r.silent = json_get_safe(aps, "content-available") == "1" && alert == "null";
    }
    // FCM: {"notification":{...},"data":{...}}
    val notif: str = json_get_safe(text, "notification");
    if json_type_safe(notif) == "object" {
        r.title = push_jstr(notif, "title");
        r.body = push_jstr(notif, "body");
    }
    val data: str = json_get_safe(text, "data");
    var src: str = text;
    if json_type_safe(data) == "object" {
        src = data;
    }
    val keys: Vec<str> = json_keys(src);
    var i: i64 = 0;
    while i < keys.len() {
        val k: str = keys.get(i);
        if k != "aps" && !(src == text && (k == "notification" || k == "data")) {
            r.data_keys.push(k);
            r.data_vals.push(json_get_safe(src, k));
        }
        i = i + 1;
    }
    return r;
}
