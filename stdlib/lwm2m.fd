// Fides LwM2M (OMA Lightweight M2M 1.0/1.1) client core over stdlib coap
//
// Real (pure computation):
//   - the object model: objects, object instances, resources and resource
//     instances (/O/I/R/RI) with typed values (string, integer, float,
//     boolean, opaque, time, objlnk) in a Lwm2mStore, plus resource
//     definitions (type, multiple, executable) for writes of untyped data;
//   - the TLV content format (11542, LwM2M 1.0 section 6.4.3): encoding of
//     a resource, an object instance and an object, decoding with all
//     identifier/length forms, integers in 1/2/4/8 bytes, floats in 4 or 8;
//   - the SenML JSON content format (110, LwM2M 1.1 section 7.4.4) with
//     base name "/O/I/", "vlo" for object links;
//   - the CoRE Link Format list of instances (</1/0>,</3/0>) for Register;
//   - the device side of the interfaces: Register (POST /rd?ep=&lt=&lwm2m=
//     &b=, link-format payload, 2.01 with Location-Path), Update (POST to
//     the location, sent at 90% of the lifetime), De-register (DELETE), and
//     the server's Read/Write/Execute/Delete/Discover requests on the store
//     (lwm2m_handle_request), answered over a stdlib coap CoapEndpoint.
//
// The transport seam is coap's: the client owns a CoapEndpoint towards the
// LwM2M server; send what lwm2m_client_take_outbox gives on a UDP socket
// (DTLS, bootstrap and the Security object's keys are out of scope), give
// each datagram received to lwm2m_client_receive, call lwm2m_client_tick
// with the time in milliseconds.

module lwm2m;
use vec;
use string;
use encoding;
use json;
use cbor;
use coap;

// Resource types
pub const LWM2M_STRING: i64 = 0;
pub const LWM2M_INT: i64 = 1;
pub const LWM2M_FLOAT: i64 = 2;
pub const LWM2M_BOOL: i64 = 3;
pub const LWM2M_OPAQUE: i64 = 4;
pub const LWM2M_TIME: i64 = 5;
pub const LWM2M_OBJLNK: i64 = 6;

// Content formats
pub const LWM2M_CF_TEXT: i64 = 0;
pub const LWM2M_CF_LINK: i64 = 40;
pub const LWM2M_CF_OPAQUE: i64 = 42;
pub const LWM2M_CF_SENML_JSON: i64 = 110;
pub const LWM2M_CF_TLV: i64 = 11542;

// TLV identifier types (bits 7..6 of the type byte)
pub const LWM2M_TLV_OBJ_INST: i64 = 0;
pub const LWM2M_TLV_RES_INST: i64 = 1;
pub const LWM2M_TLV_MULTI_RES: i64 = 2;
pub const LWM2M_TLV_RES: i64 = 3;

/// Every value of every resource, sorted by (object, instance, resource,
/// resource instance); ri is -1 for a single resource.
pub struct Lwm2mStore {
    pub objs: Vec<i64>,
    pub insts: Vec<i64>,
    pub ress: Vec<i64>,
    pub ris: Vec<i64>,
    pub types: Vec<i64>,
    pub ints: Vec<i64>,
    pub floats: Vec<f64>,
    pub strs: Vec<str>,
    pub bins: Vec<Vec<i64>>,
    // object instances that exist (also with no resource yet)
    pub inst_obj: Vec<i64>,
    pub inst_id: Vec<i64>,
    // resource definitions
    pub def_obj: Vec<i64>,
    pub def_res: Vec<i64>,
    pub def_type: Vec<i64>,
    pub def_multi: Vec<bool>,
    pub def_exec: Vec<bool>,
    // executed resources, "/3/0/4" (Execute requests)
    pub executed: Vec<str>,
}

pub fn lwm2m_store_new() -> Lwm2mStore {
    return Lwm2mStore {
        objs: Vec::new(), insts: Vec::new(), ress: Vec::new(), ris: Vec::new(), types: Vec::new(), ints: Vec::new(), floats: Vec::new(), strs: Vec::new(), bins: Vec::new(), inst_obj: Vec::new(), inst_id: Vec::new(), def_obj: Vec::new(), def_res: Vec::new(), def_type: Vec::new(), def_multi: Vec::new(), def_exec: Vec::new(), executed: Vec::new(),
    };
}

/// Define resource `res` of object `obj`.
pub fn lwm2m_define(s: &mut Lwm2mStore, obj: i64, res: i64, ty: i64, multiple: bool, executable: bool) {
    s.def_obj.push(obj);
    s.def_res.push(res);
    s.def_type.push(ty);
    s.def_multi.push(multiple);
    s.def_exec.push(executable);
}

fn lw_def(s: &Lwm2mStore, obj: i64, res: i64) -> i64 {
    var i: i64 = 0;
    while i < s.def_obj.len() {
        if s.def_obj.get(i) == obj && s.def_res.get(i) == res {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Definitions of the Device object (3) of LwM2M 1.0 Appendix E.4.
pub fn lwm2m_define_device(s: &mut Lwm2mStore) {
    lwm2m_define(s, 3, 0, LWM2M_STRING, false, false);  // Manufacturer
    lwm2m_define(s, 3, 1, LWM2M_STRING, false, false);  // Model Number
    lwm2m_define(s, 3, 2, LWM2M_STRING, false, false);  // Serial Number
    lwm2m_define(s, 3, 3, LWM2M_STRING, false, false);  // Firmware Version
    lwm2m_define(s, 3, 4, LWM2M_OPAQUE, false, true);  // Reboot
    lwm2m_define(s, 3, 5, LWM2M_OPAQUE, false, true);  // Factory Reset
    lwm2m_define(s, 3, 6, LWM2M_INT, true, false);  // Available Power Sources
    lwm2m_define(s, 3, 7, LWM2M_INT, true, false);  // Power Source Voltage
    lwm2m_define(s, 3, 8, LWM2M_INT, true, false);  // Power Source Current
    lwm2m_define(s, 3, 9, LWM2M_INT, false, false);  // Battery Level
    lwm2m_define(s, 3, 10, LWM2M_INT, false, false);  // Memory Free
    lwm2m_define(s, 3, 11, LWM2M_INT, true, false);  // Error Code
    lwm2m_define(s, 3, 12, LWM2M_OPAQUE, false, true);  // Reset Error Code
    lwm2m_define(s, 3, 13, LWM2M_TIME, false, false);  // Current Time
    lwm2m_define(s, 3, 14, LWM2M_STRING, false, false);  // UTC Offset
    lwm2m_define(s, 3, 15, LWM2M_STRING, false, false);  // Timezone
    lwm2m_define(s, 3, 16, LWM2M_STRING, false, false);  // Supported Binding and Modes
}

// ─── The store ───────────────────────────────────────────────────────────

fn lw_before(s: &Lwm2mStore, i: i64, obj: i64, inst: i64, res: i64, ri: i64) -> bool {
    if s.objs.get(i) != obj {
        return s.objs.get(i) < obj;
    }
    if s.insts.get(i) != inst {
        return s.insts.get(i) < inst;
    }
    if s.ress.get(i) != res {
        return s.ress.get(i) < res;
    }
    return s.ris.get(i) < ri;
}

/// Index of a value, or -1.
pub fn lwm2m_find(s: &Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64) -> i64 {
    var i: i64 = 0;
    while i < s.objs.len() {
        if s.objs.get(i) == obj && s.insts.get(i) == inst && s.ress.get(i) == res && s.ris.get(i) == ri {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Make object instance /obj/inst exist.
pub fn lwm2m_add_instance(s: &mut Lwm2mStore, obj: i64, inst: i64) {
    var i: i64 = 0;
    while i < s.inst_obj.len() {
        if s.inst_obj.get(i) == obj && s.inst_id.get(i) == inst {
            return;
        }
        i = i + 1;
    }
    var at: i64 = s.inst_obj.len();
    while at > 0 && (s.inst_obj.get(at - 1) > obj || (s.inst_obj.get(at - 1) == obj && s.inst_id.get(at - 1) > inst)) {
        at = at - 1;
    }
    s.inst_obj.insert(at, obj);
    s.inst_id.insert(at, inst);
}

pub fn lwm2m_has_instance(s: &Lwm2mStore, obj: i64, inst: i64) -> bool {
    var i: i64 = 0;
    while i < s.inst_obj.len() {
        if s.inst_obj.get(i) == obj && s.inst_id.get(i) == inst {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Instances of object `obj`, ascending.
pub fn lwm2m_instances(s: &Lwm2mStore, obj: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < s.inst_obj.len() {
        if s.inst_obj.get(i) == obj {
            out.push(s.inst_id.get(i));
        }
        i = i + 1;
    }
    return out;
}

/// Delete object instance /obj/inst and its values.
pub fn lwm2m_delete_instance(s: &mut Lwm2mStore, obj: i64, inst: i64) -> bool {
    var found: bool = false;
    var i: i64 = 0;
    while i < s.inst_obj.len() {
        if s.inst_obj.get(i) == obj && s.inst_id.get(i) == inst {
            s.inst_obj.remove(i);
            s.inst_id.remove(i);
            found = true;
        } else {
            i = i + 1;
        }
    }
    i = 0;
    while i < s.objs.len() {
        if s.objs.get(i) == obj && s.insts.get(i) == inst {
            lw_remove_at(s, i);
        } else {
            i = i + 1;
        }
    }
    return found;
}

fn lw_remove_at(s: &mut Lwm2mStore, i: i64) {
    s.objs.remove(i);
    s.insts.remove(i);
    s.ress.remove(i);
    s.ris.remove(i);
    s.types.remove(i);
    s.ints.remove(i);
    s.floats.remove(i);
    s.strs.remove(i);
    s.bins.remove(i);
}

/// Remove resource /obj/inst/res (every instance of it).
pub fn lwm2m_delete_resource(s: &mut Lwm2mStore, obj: i64, inst: i64, res: i64) {
    var i: i64 = 0;
    while i < s.objs.len() {
        if s.objs.get(i) == obj && s.insts.get(i) == inst && s.ress.get(i) == res {
            lw_remove_at(s, i);
        } else {
            i = i + 1;
        }
    }
}

fn lw_put(s: &mut Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64, ty: i64, n: i64, f: f64, st: str, b: Vec<i64>) {
    lwm2m_add_instance(s, obj, inst);
    val k: i64 = lwm2m_find(s, obj, inst, res, ri);
    if k >= 0 {
        s.types.set(k, ty);
        s.ints.set(k, n);
        s.floats.set(k, f);
        s.strs.set(k, st);
        s.bins.set(k, b);
        return;
    }
    var at: i64 = 0;
    while at < s.objs.len() && lw_before(s, at, obj, inst, res, ri) {
        at = at + 1;
    }
    s.objs.insert(at, obj);
    s.insts.insert(at, inst);
    s.ress.insert(at, res);
    s.ris.insert(at, ri);
    s.types.insert(at, ty);
    s.ints.insert(at, n);
    s.floats.insert(at, f);
    s.strs.insert(at, st);
    s.bins.insert(at, b);
}

/// Set a value; `ri` -1 for a single resource, else the resource instance.
pub fn lwm2m_set_str(s: &mut Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64, v: str) {
    lw_put(s, obj, inst, res, ri, LWM2M_STRING, 0, 0.0, v, Vec::new());
}

pub fn lwm2m_set_int(s: &mut Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64, v: i64) {
    lw_put(s, obj, inst, res, ri, LWM2M_INT, v, 0.0, "", Vec::new());
}

pub fn lwm2m_set_time(s: &mut Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64, v: i64) {
    lw_put(s, obj, inst, res, ri, LWM2M_TIME, v, 0.0, "", Vec::new());
}

pub fn lwm2m_set_float(s: &mut Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64, v: f64) {
    lw_put(s, obj, inst, res, ri, LWM2M_FLOAT, 0, v, "", Vec::new());
}

pub fn lwm2m_set_bool(s: &mut Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64, v: bool) {
    var n: i64 = 0;
    if v {
        n = 1;
    }
    lw_put(s, obj, inst, res, ri, LWM2M_BOOL, n, 0.0, "", Vec::new());
}

pub fn lwm2m_set_opaque(s: &mut Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64, v: Vec<i64>) {
    lw_put(s, obj, inst, res, ri, LWM2M_OPAQUE, 0, 0.0, "", v);
}

/// An object link to /lobj/linst.
pub fn lwm2m_set_objlnk(s: &mut Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64, lobj: i64, linst: i64) {
    lw_put(s, obj, inst, res, ri, LWM2M_OBJLNK, (lobj << 16) | (linst & 65535), 0.0, "", Vec::new());
}

pub fn lwm2m_get_int(s: &Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64, def: i64) -> i64 {
    val k: i64 = lwm2m_find(s, obj, inst, res, ri);
    if k < 0 {
        return def;
    }
    return s.ints.get(k);
}

pub fn lwm2m_get_str(s: &Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64) -> str {
    val k: i64 = lwm2m_find(s, obj, inst, res, ri);
    if k < 0 {
        return "";
    }
    return s.strs.get(k);
}

pub fn lwm2m_get_float(s: &Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64, def: f64) -> f64 {
    val k: i64 = lwm2m_find(s, obj, inst, res, ri);
    if k < 0 {
        return def;
    }
    if s.types.get(k) == LWM2M_FLOAT {
        return s.floats.get(k);
    }
    return s.ints.get(k) as f64;
}

// ─── TLV (content format 11542) ──────────────────────────────────────────

fn lw_tlv_head(out: &mut Vec<i64>, kind: i64, id: i64, len: i64) {
    var t: i64 = kind << 6;
    if id > 255 {
        t = t | 32;
    }
    if len < 8 {
        t = t | len;
    } else if len < 256 {
        t = t | 8;
    } else if len < 65536 {
        t = t | 16;
    } else {
        t = t | 24;
    }
    out.push(t);
    if id > 255 {
        out.push((id >> 8) & 255);
    }
    out.push(id & 255);
    if len >= 65536 {
        out.push((len >> 16) & 255);
    }
    if len >= 256 {
        out.push((len >> 8) & 255);
    }
    if len >= 8 {
        out.push(len & 255);
    }
}

fn lw_tlv(out: &mut Vec<i64>, kind: i64, id: i64, value: Vec<i64>) {
    lw_tlv_head(out, kind, id, value.len());
    out.extend(value);
}

/// An integer in the fewest of 1, 2, 4, 8 bytes (two's complement).
@wrapping
pub fn lwm2m_int_bytes(v: i64) -> Vec<i64> {
    var n: i64 = 8;
    if v >= -128 && v <= 127 {
        n = 1;
    } else if v >= -32768 && v <= 32767 {
        n = 2;
    } else if v >= -2147483648 && v <= 2147483647 {
        n = 4;
    }
    var out: Vec<i64> = Vec::new();
    var i: i64 = n - 1;
    while i >= 0 {
        out.push((v >> (i * 8)) & 255);
        i = i - 1;
    }
    return out;
}

/// A big-endian two's complement integer of 1..8 bytes.
@wrapping
pub fn lwm2m_bytes_int(b: &Vec<i64>) -> i64 {
    if b.len() == 0 {
        return 0;
    }
    var x: i64 = 0;
    if b.get(0) >= 128 {
        x = -1;
    }
    var i: i64 = 0;
    while i < b.len() {
        x = (x << 8) | (b.get(i) & 255);
        i = i + 1;
    }
    return x;
}

@wrapping
fn lw_f64_bytes(x: f64) -> Vec<i64> {
    val bits: i64 = p_f64_to_bits(x);
    var out: Vec<i64> = Vec::new();
    var i: i64 = 7;
    while i >= 0 {
        out.push((bits >> (i * 8)) & 255);
        i = i - 1;
    }
    return out;
}

fn lw_value_bytes(s: &Lwm2mStore, k: i64) -> Vec<i64> {
    val ty: i64 = s.types.get(k);
    if ty == LWM2M_STRING {
        return str_bytes(s.strs.get(k));
    }
    if ty == LWM2M_OPAQUE {
        return s.bins.get(k);
    }
    if ty == LWM2M_FLOAT {
        return lw_f64_bytes(s.floats.get(k));
    }
    if ty == LWM2M_BOOL {
        var b: Vec<i64> = Vec::new();
        b.push(s.ints.get(k) & 1);
        return b;
    }
    if ty == LWM2M_OBJLNK {
        val v: i64 = s.ints.get(k);
        var b: Vec<i64> = Vec::new();
        b.push((v >> 24) & 255);
        b.push((v >> 16) & 255);
        b.push((v >> 8) & 255);
        b.push(v & 255);
        return b;
    }
    return lwm2m_int_bytes(s.ints.get(k));
}

fn lw_is_multi(s: &Lwm2mStore, obj: i64, res: i64, k: i64) -> bool {
    val d: i64 = lw_def(s, obj, res);
    if d >= 0 {
        return s.def_multi.get(d);
    }
    return s.ris.get(k) >= 0;
}

// The TLVs of the resources of /obj/inst (only resource `only` if >= 0).
fn lw_tlv_resources(s: &Lwm2mStore, obj: i64, inst: i64, only: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < s.objs.len() {
        if s.objs.get(k) != obj || s.insts.get(k) != inst || (only >= 0 && s.ress.get(k) != only) {
            k = k + 1;
            continue;
        }
        val res: i64 = s.ress.get(k);
        if lw_is_multi(s, obj, res, k) {
            var inner: Vec<i64> = Vec::new();
            while k < s.objs.len() && s.objs.get(k) == obj && s.insts.get(k) == inst && s.ress.get(k) == res {
                lw_tlv(&mut inner, LWM2M_TLV_RES_INST, s.ris.get(k), lw_value_bytes(s, k));
                k = k + 1;
            }
            lw_tlv(&mut out, LWM2M_TLV_MULTI_RES, res, inner);
        } else {
            lw_tlv(&mut out, LWM2M_TLV_RES, res, lw_value_bytes(s, k));
            k = k + 1;
        }
    }
    return out;
}

/// TLV of one resource /obj/inst/res.
pub fn lwm2m_tlv_resource(s: &Lwm2mStore, obj: i64, inst: i64, res: i64) -> Vec<i64> {
    return lw_tlv_resources(s, obj, inst, res);
}

/// TLV of object instance /obj/inst (its resources, as a Read of
/// /obj/inst returns them).
pub fn lwm2m_tlv_instance(s: &Lwm2mStore, obj: i64, inst: i64) -> Vec<i64> {
    return lw_tlv_resources(s, obj, inst, -1);
}

/// TLV of object /obj: one object-instance TLV per instance.
pub fn lwm2m_tlv_object(s: &Lwm2mStore, obj: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val ids: Vec<i64> = lwm2m_instances(s, obj);
    var i: i64 = 0;
    while i < ids.len() {
        lw_tlv(&mut out, LWM2M_TLV_OBJ_INST, ids.get(i), lw_tlv_resources(s, obj, ids.get(i), -1));
        i = i + 1;
    }
    return out;
}

/// TLV entries at one level: kind, id and where the value is.
pub struct Lwm2mTlv {
    pub ok: bool,
    pub kinds: Vec<i64>,
    pub ids: Vec<i64>,
    pub values: Vec<Vec<i64>>,
}

/// Split TLV bytes into their top-level entries.
pub fn lwm2m_tlv_parse(b: &Vec<i64>) -> Lwm2mTlv {
    var t: Lwm2mTlv = Lwm2mTlv {
        ok: true, kinds: Vec::new(), ids: Vec::new(), values: Vec::new()
    };
    var pos: i64 = 0;
    val n: i64 = b.len();
    while pos < n {
        val ty: i64 = b.get(pos);
        pos = pos + 1;
        var idlen: i64 = 1;
        if (ty & 32) != 0 {
            idlen = 2;
        }
        val lt: i64 = (ty >> 3) & 3;
        if pos + idlen + lt > n {
            t.ok = false;
            return t;
        }
        var id: i64 = 0;
        var i: i64 = 0;
        while i < idlen {
            id = (id << 8) | b.get(pos + i);
            i = i + 1;
        }
        pos = pos + idlen;
        var len: i64 = ty & 7;
        if lt > 0 {
            len = 0;
            i = 0;
            while i < lt {
                len = (len << 8) | b.get(pos + i);
                i = i + 1;
            }
            pos = pos + lt;
        }
        if pos + len > n {
            t.ok = false;
            return t;
        }
        var v: Vec<i64> = Vec::new();
        i = 0;
        while i < len {
            v.push(b.get(pos + i));
            i = i + 1;
        }
        pos = pos + len;
        t.kinds.push(ty >> 6);
        t.ids.push(id);
        t.values.push(v);
    }
    return t;
}

// Store a value of resource `res` from its bytes, typed by its definition
// or by the value already there; false when it cannot be typed.
fn lw_store_bytes(s: &mut Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64, v: Vec<i64>) -> bool {
    var ty: i64 = -1;
    val d: i64 = lw_def(s, obj, res);
    if d >= 0 {
        ty = s.def_type.get(d);
    } else {
        var k: i64 = lwm2m_find(s, obj, inst, res, ri);
        if k < 0 {
            k = lwm2m_find(s, obj, inst, res, -1);
        }
        if k >= 0 {
            ty = s.types.get(k);
        }
    }
    if ty < 0 {
        return false;
    }
    if ty == LWM2M_STRING {
        lwm2m_set_str(s, obj, inst, res, ri, str_from_bytes(v));
    } else if ty == LWM2M_OPAQUE {
        lwm2m_set_opaque(s, obj, inst, res, ri, v);
    } else if ty == LWM2M_FLOAT {
        if v.len() == 4 {
            lwm2m_set_float(s, obj, inst, res, ri, cbor_single_to_f64(lwm2m_bytes_int(&v) & 4294967295));
        } else if v.len() == 8 {
            lwm2m_set_float(s, obj, inst, res, ri, p_f64_from_bits(lwm2m_bytes_int(&v)));
        } else {
            return false;
        }
    } else if ty == LWM2M_BOOL {
        if v.len() != 1 || v.get(0) > 1 {
            return false;
        }
        lwm2m_set_bool(s, obj, inst, res, ri, v.get(0) == 1);
    } else if ty == LWM2M_OBJLNK {
        if v.len() != 4 {
            return false;
        }
        lwm2m_set_objlnk(s, obj, inst, res, ri, (v.get(0) << 8) | v.get(1), (v.get(2) << 8) | v.get(3));
    } else {
        if !(v.len() == 1 || v.len() == 2 || v.len() == 4 || v.len() == 8) {
            return false;
        }
        if ty == LWM2M_TIME {
            lwm2m_set_time(s, obj, inst, res, ri, lwm2m_bytes_int(&v));
        } else {
            lwm2m_set_int(s, obj, inst, res, ri, lwm2m_bytes_int(&v));
        }
    }
    return true;
}

/// Write TLV resources into /obj/inst (a Write; `replace` first removes
/// the resources the TLV holds instances of). False on malformed or
/// untyped data, or an Object Instance TLV for another instance than
/// `inst`.
pub fn lwm2m_tlv_write(s: &mut Lwm2mStore, obj: i64, inst: i64, b: &Vec<i64>, replace: bool) -> bool {
    return lwm2m_tlv_write_at(s, obj, inst, -1, b, replace);
}

/// A Write of TLV data to the URI /obj/inst (res < 0) or /obj/inst/res
/// (OMA LwM2M 1.1 §6.3: the Write targets the URI's object instance or
/// resource). False, with nothing written, when a top-level entry is an
/// Object Instance other than `inst`, or (res >= 0) anything but resource
/// `res`.
pub fn lwm2m_tlv_write_at(s: &mut Lwm2mStore, obj: i64, inst: i64, res: i64, b: &Vec<i64>, replace: bool) -> bool {
    val t: Lwm2mTlv = lwm2m_tlv_parse(b);
    if !t.ok {
        return false;
    }
    var i: i64 = 0;
    while i < t.kinds.len() {
        val kind: i64 = t.kinds.get(i);
        if kind == LWM2M_TLV_OBJ_INST {
            if res >= 0 || t.ids.get(i) != inst {
                return false;
            }
        } else if kind == LWM2M_TLV_RES || kind == LWM2M_TLV_MULTI_RES {
            if res >= 0 && t.ids.get(i) != res {
                return false;
            }
        }
        i = i + 1;
    }
    return lw_tlv_write_entries(s, obj, inst, &t, replace);
}

fn lw_tlv_write_entries(s: &mut Lwm2mStore, obj: i64, inst: i64, t: &Lwm2mTlv, replace: bool) -> bool {
    var i: i64 = 0;
    while i < t.kinds.len() {
        val kind: i64 = t.kinds.get(i);
        val id: i64 = t.ids.get(i);
        if kind == LWM2M_TLV_OBJ_INST {
            if !lwm2m_tlv_write(s, obj, id, &t.values.get(i), replace) {
                return false;
            }
        } else if kind == LWM2M_TLV_RES {
            if !lw_store_bytes(s, obj, inst, id, -1, t.values.get(i)) {
                return false;
            }
        } else if kind == LWM2M_TLV_MULTI_RES {
            if replace {
                lwm2m_delete_resource(s, obj, inst, id);
            }
            val inner: Lwm2mTlv = lwm2m_tlv_parse(&t.values.get(i));
            if !inner.ok {
                return false;
            }
            var j: i64 = 0;
            while j < inner.kinds.len() {
                if inner.kinds.get(j) != LWM2M_TLV_RES_INST {
                    return false;
                }
                if !lw_store_bytes(s, obj, inst, id, inner.ids.get(j), inner.values.get(j)) {
                    return false;
                }
                j = j + 1;
            }
        } else {
            return false;
        }
        i = i + 1;
    }
    lwm2m_add_instance(s, obj, inst);
    return true;
}

// ─── SenML JSON (content format 110) ─────────────────────────────────────

fn lw_json_value(s: &Lwm2mStore, k: i64) -> str {
    val ty: i64 = s.types.get(k);
    if ty == LWM2M_STRING {
        return "\"vs\":" + json_string(s.strs.get(k));
    }
    if ty == LWM2M_OPAQUE {
        return "\"vd\":\"" + lw_b64url(s.bins.get(k)) + "\"";
    }
    if ty == LWM2M_FLOAT {
        return "\"v\":" + float_to_str(s.floats.get(k));
    }
    if ty == LWM2M_BOOL {
        return "\"vb\":" + bool_to_str(s.ints.get(k) == 1);
    }
    if ty == LWM2M_OBJLNK {
        val v: i64 = s.ints.get(k);
        return "\"vlo\":\"" + int_to_str(v >> 16) + ":" + int_to_str(v & 65535) + "\"";
    }
    return "\"v\":" + int_to_str(s.ints.get(k));
}

fn lw_b64url(b: Vec<i64>) -> str {
    val std: str = b64_encode_bytes(b);
    var out: str = "";
    var i: i64 = 0;
    while i < str_len(std) {
        val c: i64 = str_byte_at(std, i);
        if c == 43 {
            out = out + "-";
        } else if c == 47 {
            out = out + "_";
        } else if c != 61 {
            out = out + char_to_str(c);
        }
        i = i + 1;
    }
    return out;
}

/// SenML JSON of object instance /obj/inst (res >= 0: that resource only).
pub fn lwm2m_senml_json(s: &Lwm2mStore, obj: i64, inst: i64, res: i64) -> str {
    var o: str = "[";
    var first: bool = true;
    var k: i64 = 0;
    while k < s.objs.len() {
        if s.objs.get(k) == obj && s.insts.get(k) == inst && (res < 0 || s.ress.get(k) == res) {
            if first {
                o = o + "{\"bn\":\"/" + int_to_str(obj) + "/" + int_to_str(inst) + "/\",";
            } else {
                o = o + ",{";
            }
            first = false;
            var name: str = int_to_str(s.ress.get(k));
            if s.ris.get(k) >= 0 {
                name = name + "/" + int_to_str(s.ris.get(k));
            }
            o = o + "\"n\":\"" + name + "\"," + lw_json_value(s, k) + "}";
        }
        k = k + 1;
    }
    return o + "]";
}

// "/3/0/7/1" -> [3, 0, 7, 1]; [] when not a path of numbers.
pub fn lwm2m_parse_path(p: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val parts: Vec<str> = str_split(p, "/");
    var i: i64 = 0;
    while i < parts.len() {
        val seg: str = parts.get(i);
        if seg != "" {
            if !lw_digits(seg) {
                return Vec::new();
            }
            out.push(str_parse_int(seg));
        }
        i = i + 1;
    }
    return out;
}

fn lw_digits(s: str) -> bool {
    if str_len(s) == 0 || str_len(s) > 5 {
        return false;
    }
    var i: i64 = 0;
    while i < str_len(s) {
        val c: i64 = str_byte_at(s, i);
        if c < 48 || c > 57 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Write a SenML JSON pack into the store (names resolve to full paths
/// /O/I/R or /O/I/R/RI). False on bad JSON, paths or types; then nothing is
/// written.
pub fn lwm2m_senml_write(s: &mut Lwm2mStore, text: str) -> bool {
    return lwm2m_senml_write_at(s, text, -1, -1, -1, -1);
}

// The type a value of /obj/inst/res/ri must have: its definition's, else
// that of the value already there; -1 when neither exists.
fn lw_value_type(s: &Lwm2mStore, obj: i64, inst: i64, res: i64, ri: i64) -> i64 {
    val d: i64 = lw_def(s, obj, res);
    if d >= 0 {
        return s.def_type.get(d);
    }
    var k: i64 = lwm2m_find(s, obj, inst, res, ri);
    if k < 0 {
        k = lwm2m_find(s, obj, inst, res, -1);
    }
    if k >= 0 {
        return s.types.get(k);
    }
    return -1;
}

/// A Write of a SenML JSON pack to the URI /obj/inst[/res[/ri]] (-1 = any
/// at that level; OMA LwM2M 1.1 §6.3: the Write targets the URI). False,
/// with nothing written, when a record names a path outside the URI, its
/// value kind (vs/vb/vlo/vd/v) does not match the resource's type, or the
/// JSON or a path is bad: the whole pack is checked before any record is
/// applied.
pub fn lwm2m_senml_write_at(s: &mut Lwm2mStore, text: str, obj: i64, inst: i64, res: i64, ri: i64) -> bool {
    val d: JsonDoc = json_index(text);
    if !d.ok || jd_kind(&d, jd_root(&d)) != JSON_ARRAY {
        return false;
    }
    // pass 0 checks every record, pass 1 applies them
    var pass: i64 = 0;
    while pass < 2 {
        val apply: bool = pass == 1;
        var bn: str = "";
        var i: i64 = 0;
        while i < jd_len(&d, jd_root(&d)) {
            val r: i64 = jd_at(&d, jd_root(&d), i);
            if jd_kind(&d, r) != JSON_OBJECT {
                return false;
            }
            val b: i64 = jd_get(&d, r, "bn");
            if b >= 0 {
                bn = jd_str(&d, b);
            }
            val path: Vec<i64> = lwm2m_parse_path(bn + jd_str(&d, jd_get(&d, r, "n")));
            if path.len() < 3 || path.len() > 4 {
                return false;
            }
            var rri: i64 = -1;
            if path.len() == 4 {
                rri = path.get(3);
            }
            val o: i64 = path.get(0);
            val pinst: i64 = path.get(1);
            val pres: i64 = path.get(2);
            if (obj >= 0 && o != obj) || (inst >= 0 && pinst != inst) || (res >= 0 && pres != res) || (ri >= 0 && rri != ri) {
                return false;
            }
            val ty: i64 = lw_value_type(s, o, pinst, pres, rri);
            if jd_get(&d, r, "vs") >= 0 {
                if ty >= 0 && ty != LWM2M_STRING {
                    return false;
                }
                if apply {
                    lwm2m_set_str(s, o, pinst, pres, rri, jd_str(&d, jd_get(&d, r, "vs")));
                }
            } else if jd_get(&d, r, "vb") >= 0 {
                if ty >= 0 && ty != LWM2M_BOOL {
                    return false;
                }
                if apply {
                    lwm2m_set_bool(s, o, pinst, pres, rri, jd_bool(&d, jd_get(&d, r, "vb"), false));
                }
            } else if jd_get(&d, r, "vlo") >= 0 {
                if ty >= 0 && ty != LWM2M_OBJLNK {
                    return false;
                }
                val lo: Vec<str> = str_split(jd_str(&d, jd_get(&d, r, "vlo")), ":");
                if lo.len() != 2 {
                    return false;
                }
                if apply {
                    lwm2m_set_objlnk(s, o, pinst, pres, rri, str_parse_int(lo.get(0)), str_parse_int(lo.get(1)));
                }
            } else if jd_get(&d, r, "vd") >= 0 {
                if ty >= 0 && ty != LWM2M_OPAQUE {
                    return false;
                }
                if apply {
                    var std: str = "";
                    val raw: str = jd_str(&d, jd_get(&d, r, "vd"));
                    var j: i64 = 0;
                    while j < str_len(raw) {
                        val c: i64 = str_byte_at(raw, j);
                        if c == 45 {
                            std = std + "+";
                        } else if c == 95 {
                            std = std + "/";
                        } else {
                            std = std + char_to_str(c);
                        }
                        j = j + 1;
                    }
                    while str_len(std) % 4 != 0 {
                        std = std + "=";
                    }
                    lwm2m_set_opaque(s, o, pinst, pres, rri, b64_decode_bytes(std));
                }
            } else if jd_get(&d, r, "v") >= 0 {
                if ty >= 0 && ty != LWM2M_INT && ty != LWM2M_FLOAT && ty != LWM2M_TIME {
                    return false;
                }
                if apply {
                    val vn: i64 = jd_get(&d, r, "v");
                    if ty == LWM2M_FLOAT || (ty < 0 && str_contains(jd_raw(&d, vn), ".")) {
                        lwm2m_set_float(s, o, pinst, pres, rri, jd_num(&d, vn, 0.0));
                    } else if ty == LWM2M_TIME {
                        lwm2m_set_time(s, o, pinst, pres, rri, jd_int(&d, vn, 0));
                    } else {
                        lwm2m_set_int(s, o, pinst, pres, rri, jd_int(&d, vn, 0));
                    }
                }
            } else {
                return false;
            }
            i = i + 1;
        }
        pass = pass + 1;
    }
    return true;
}

// ─── Link format, requests from the server ───────────────────────────────

/// "</1/0>,</3/0>": every object instance, for Register and Update.
pub fn lwm2m_links(s: &Lwm2mStore) -> str {
    var o: str = "";
    var i: i64 = 0;
    while i < s.inst_obj.len() {
        if i > 0 {
            o = o + ",";
        }
        o = o + "</" + int_to_str(s.inst_obj.get(i)) + "/" + int_to_str(s.inst_id.get(i)) + ">";
        i = i + 1;
    }
    return o;
}

fn lw_discover(s: &Lwm2mStore, obj: i64, inst: i64) -> str {
    var o: str = "</" + int_to_str(obj) + "/" + int_to_str(inst) + ">";
    var last: i64 = -1;
    var k: i64 = 0;
    while k < s.objs.len() {
        if s.objs.get(k) == obj && s.insts.get(k) == inst && s.ress.get(k) != last {
            last = s.ress.get(k);
            o = o + ",</" + int_to_str(obj) + "/" + int_to_str(inst) + "/" + int_to_str(last) + ">";
        }
        k = k + 1;
    }
    return o;
}

fn lw_has_resource(s: &Lwm2mStore, obj: i64, inst: i64, res: i64) -> bool {
    var k: i64 = 0;
    while k < s.objs.len() {
        if s.objs.get(k) == obj && s.insts.get(k) == inst && s.ress.get(k) == res {
            return true;
        }
        k = k + 1;
    }
    return false;
}

/// Answer a request of the LwM2M server (Device Management interface):
/// GET Read (TLV, or SenML JSON when Accept is 110; Discover when Accept
/// is 40), PUT Write (replace), POST Write (partial) on an instance or
/// Execute on an executable resource, DELETE of an instance. The response
/// has code, options and payload; mid and token are set when it is sent.
pub fn lwm2m_handle_request(s: &mut Lwm2mStore, req: &CoapMsg) -> CoapMsg {
    var resp: CoapMsg = coap_msg(COAP_ACK, COAP_CONTENT, 0);
    val path: Vec<i64> = lwm2m_parse_path(coap_uri_path(req));
    if path.len() == 0 || path.len() > 4 {
        resp.code = COAP_NOT_FOUND;
        return resp;
    }
    val obj: i64 = path.get(0);
    var inst: i64 = -1;
    var res: i64 = -1;
    if path.len() >= 2 {
        inst = path.get(1);
    }
    if path.len() >= 3 {
        res = path.get(2);
    }
    var ri: i64 = -1;
    if path.len() >= 4 {
        ri = path.get(3);
    }
    if inst >= 0 && !lwm2m_has_instance(s, obj, inst) {
        resp.code = COAP_NOT_FOUND;
        return resp;
    }
    if inst < 0 && lwm2m_instances(s, obj).len() == 0 && req.code != COAP_POST {
        resp.code = COAP_NOT_FOUND;
        return resp;
    }
    val accept: i64 = coap_get_uint(req, COAP_O_ACCEPT, LWM2M_CF_TLV);
    if req.code == COAP_GET {
        if accept == LWM2M_CF_LINK {
            if inst < 0 {
                resp.payload = str_bytes("</" + int_to_str(obj) + ">");
            } else {
                resp.payload = str_bytes(lw_discover(s, obj, inst));
            }
            coap_add_uint(&mut resp, COAP_O_CONTENT_FORMAT, LWM2M_CF_LINK);
            return resp;
        }
        if res >= 0 && !lw_has_resource(s, obj, inst, res) {
            resp.code = COAP_NOT_FOUND;
            return resp;
        }
        if accept == LWM2M_CF_SENML_JSON && inst >= 0 {
            resp.payload = str_bytes(lwm2m_senml_json(s, obj, inst, res));
            coap_add_uint(&mut resp, COAP_O_CONTENT_FORMAT, LWM2M_CF_SENML_JSON);
            return resp;
        }
        if accept != LWM2M_CF_TLV {
            resp.code = 134;  // 4.06 Not Acceptable
            return resp;
        }
        if inst < 0 {
            resp.payload = lwm2m_tlv_object(s, obj);
        } else if res < 0 {
            resp.payload = lwm2m_tlv_instance(s, obj, inst);
        } else {
            resp.payload = lwm2m_tlv_resource(s, obj, inst, res);
        }
        coap_add_uint(&mut resp, COAP_O_CONTENT_FORMAT, LWM2M_CF_TLV);
        return resp;
    }
    if req.code == COAP_POST && res >= 0 {
        val d: i64 = lw_def(s, obj, res);
        if d < 0 || !s.def_exec.get(d) {
            resp.code = COAP_METHOD_NOT_ALLOWED;
            return resp;
        }
        s.executed.push(coap_uri_path(req));
        resp.code = COAP_CHANGED;
        return resp;
    }
    if req.code == COAP_PUT || req.code == COAP_POST {
        if inst < 0 {
            resp.code = COAP_METHOD_NOT_ALLOWED;
            return resp;
        }
        val cf: i64 = coap_get_uint(req, COAP_O_CONTENT_FORMAT, LWM2M_CF_TLV);
        var ok: bool = false;
        if cf == LWM2M_CF_TLV {
            ok = lwm2m_tlv_write_at(s, obj, inst, res, &req.payload, req.code == COAP_PUT);
        } else if cf == LWM2M_CF_SENML_JSON {
            ok = lwm2m_senml_write_at(s, str_from_bytes(req.payload), obj, inst, res, ri);
        } else {
            resp.code = 143;  // 4.15 Unsupported Content-Format
            return resp;
        }
        if !ok {
            resp.code = COAP_BAD_REQUEST;
            return resp;
        }
        resp.code = COAP_CHANGED;
        return resp;
    }
    if req.code == COAP_DELETE && inst >= 0 && res < 0 {
        lwm2m_delete_instance(s, obj, inst);
        resp.code = COAP_DELETED;
        return resp;
    }
    resp.code = COAP_METHOD_NOT_ALLOWED;
    return resp;
}

// ─── Registration client ─────────────────────────────────────────────────

pub const LWM2M_UNREGISTERED: i64 = 0;
pub const LWM2M_REGISTERING: i64 = 1;
pub const LWM2M_REGISTERED: i64 = 2;
pub const LWM2M_UPDATING: i64 = 3;
pub const LWM2M_DEREGISTERING: i64 = 4;

pub struct Lwm2mClient {
    pub endpoint: str,
    pub lifetime: i64,  // seconds
    pub binding: str,  // "U"
    pub version: str,  // "1.0"
    pub state: i64,
    pub location: str,  // "/rd/5a3f" from the 2.01's Location-Path
    pub registered_at: i64,
    pub pending: Vec<i64>,  // token of the registration request in flight
    pub error: str,
    pub ep: CoapEndpoint,
}

pub fn lwm2m_client_new(endpoint: str, lifetime: i64, first_mid: i64, seed: i64) -> Lwm2mClient {
    return Lwm2mClient {
        endpoint: endpoint, lifetime: lifetime, binding: "U", version: "1.0", state: LWM2M_UNREGISTERED, location: "", registered_at: 0, pending: Vec::new(), error: "", ep: coap_ep_new(first_mid, seed),
    };
}

/// The Register request: CON POST /rd?ep=..&lt=..&lwm2m=..&b=.. with the
/// instances in link format.
pub fn lwm2m_register_msg(c: &Lwm2mClient, s: &Lwm2mStore) -> CoapMsg {
    var m: CoapMsg = coap_msg(COAP_CON, COAP_POST, 0);
    coap_add_str(&mut m, COAP_O_URI_PATH, "rd");
    coap_add_uint(&mut m, COAP_O_CONTENT_FORMAT, LWM2M_CF_LINK);
    coap_add_str(&mut m, COAP_O_URI_QUERY, "ep=" + c.endpoint);
    coap_add_str(&mut m, COAP_O_URI_QUERY, "lt=" + int_to_str(c.lifetime));
    coap_add_str(&mut m, COAP_O_URI_QUERY, "lwm2m=" + c.version);
    coap_add_str(&mut m, COAP_O_URI_QUERY, "b=" + c.binding);
    m.payload = str_bytes(lwm2m_links(s));
    return m;
}

/// The Update request: CON POST to the registration location (with the
/// links when `with_links`).
pub fn lwm2m_update_msg(c: &Lwm2mClient, s: &Lwm2mStore, with_links: bool) -> CoapMsg {
    var m: CoapMsg = coap_msg(COAP_CON, COAP_POST, 0);
    coap_set_uri(&mut m, c.location);
    if with_links {
        coap_add_uint(&mut m, COAP_O_CONTENT_FORMAT, LWM2M_CF_LINK);
        m.payload = str_bytes(lwm2m_links(s));
    }
    return m;
}

pub fn lwm2m_deregister_msg(c: &Lwm2mClient) -> CoapMsg {
    var m: CoapMsg = coap_msg(COAP_CON, COAP_DELETE, 0);
    coap_set_uri(&mut m, c.location);
    return m;
}

fn lw_send(c: &mut Lwm2mClient, m: &mut CoapMsg, state: i64, now: i64) {
    c.pending = coap_ep_request(&mut c.ep, m, now);
    c.state = state;
}

/// Send Register.
pub fn lwm2m_client_register(c: &mut Lwm2mClient, s: &Lwm2mStore, now: i64) {
    var m: CoapMsg = lwm2m_register_msg(c, s);
    lw_send(c, &mut m, LWM2M_REGISTERING, now);
}

/// Send Update now (also done by lwm2m_client_tick at 90% of the lifetime).
pub fn lwm2m_client_update(c: &mut Lwm2mClient, s: &Lwm2mStore, with_links: bool, now: i64) {
    var m: CoapMsg = lwm2m_update_msg(c, s, with_links);
    lw_send(c, &mut m, LWM2M_UPDATING, now);
}

pub fn lwm2m_client_deregister(c: &mut Lwm2mClient, now: i64) {
    var m: CoapMsg = lwm2m_deregister_msg(c);
    lw_send(c, &mut m, LWM2M_DEREGISTERING, now);
}

pub fn lwm2m_client_take_outbox(c: &mut Lwm2mClient) -> Vec<Vec<i64>> {
    return coap_ep_take_outbox(&mut c.ep);
}

fn lw_events(c: &mut Lwm2mClient, s: &mut Lwm2mStore, now: i64) {
    val evs: Vec<CoapEvent> = coap_ep_take_events(&mut c.ep);
    var i: i64 = 0;
    while i < evs.len() {
        val e: CoapEvent = evs.get(i);
        if e.kind == COAP_EV_REQUEST {
            var resp: CoapMsg = lwm2m_handle_request(s, &e.msg);
            coap_ep_respond(&mut c.ep, &e.msg, &mut resp, now);
        } else if lw_tok_eq(&e.token, &c.pending) {
            lw_result(c, e, now);
        }
        i = i + 1;
    }
}

fn lw_tok_eq(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn lw_result(c: &mut Lwm2mClient, e: CoapEvent, now: i64) {
    c.pending = Vec::new();
    if e.kind != COAP_EV_RESPONSE {
        c.state = LWM2M_UNREGISTERED;
        c.error = "no answer from the server";
        return;
    }
    val code: i64 = e.msg.code;
    if c.state == LWM2M_REGISTERING {
        if code == COAP_CREATED {
            val segs: Vec<str> = coap_get_strs(&e.msg, COAP_O_LOCATION_PATH);
            var loc: str = "";
            var i: i64 = 0;
            while i < segs.len() {
                loc = loc + "/" + segs.get(i);
                i = i + 1;
            }
            c.location = loc;
            c.state = LWM2M_REGISTERED;
            c.registered_at = now;
        } else {
            c.state = LWM2M_UNREGISTERED;
            c.error = "register refused: " + coap_code_str(code);
        }
    } else if c.state == LWM2M_UPDATING {
        if code == COAP_CHANGED {
            c.state = LWM2M_REGISTERED;
            c.registered_at = now;
        } else {
            c.state = LWM2M_UNREGISTERED;  // 4.04: register again
            c.error = "update refused: " + coap_code_str(code);
        }
    } else if c.state == LWM2M_DEREGISTERING {
        c.state = LWM2M_UNREGISTERED;
        c.location = "";
    }
}

/// One datagram from the server.
pub fn lwm2m_client_receive(c: &mut Lwm2mClient, s: &mut Lwm2mStore, bytes: Vec<i64>, now: i64) {
    coap_ep_receive(&mut c.ep, bytes, now);
    lw_events(c, s, now);
}

/// Let time pass: CoAP retransmissions, and Update at 90% of the lifetime.
pub fn lwm2m_client_tick(c: &mut Lwm2mClient, s: &mut Lwm2mStore, now: i64) {
    coap_ep_tick(&mut c.ep, now);
    lw_events(c, s, now);
    if c.state == LWM2M_REGISTERED && now - c.registered_at >= c.lifetime * 900 {
        lwm2m_client_update(c, s, false, now);
    }
}
