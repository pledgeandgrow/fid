// Fides EXI: W3C Efficient XML Interchange 1.0 (Second Edition), the
// bit-packed binary form of XML that ISO 15118 / DIN 70121 put on the wire.
//
// Real (implemented and tested):
//   - the bit stream: bit-packed (most significant bit first) and
//     byte-aligned alignment; n-bit unsigned integers (7.1.9), Unsigned
//     Integer (7-bit groups, 7.1.6), Integer (sign + magnitude, 7.1.5),
//     Boolean, Binary (length + bytes, 7.1.2), String (code points, 7.1.10),
//     Enumeration (n-bit index, 7.2), List (7.1.11);
//   - the header (5): the optional "$EXI" cookie, distinguishing bits, the
//     options presence bit, format version 1, and the EXI Options document
//     (5.4, Appendix C) for alignment, strict, fragment, valueMaxLength,
//     valuePartitionCapacity, blockSize, schemaId (also nil), compression,
//     selfContained and the preserve flags; padding before a byte-aligned
//     body;
//   - string tables (7.3): the URI and local-name partitions with their
//     initial entries (QName encoding of built-in grammars), and the value
//     partitions: local hits (0 + n-bit id of the element's or attribute's
//     own partition), global hits (1 + n-bit id), misses (length + 2 and
//     the characters), valueMaxLength, and a bounded valuePartitionCapacity
//     (the global id wraps and the replaced string's local entry is
//     vacated; ids of the other local entries do not move);
//   - built-in grammars (8.4): document, fragment and element grammars with
//     learning (SE, AT, CH and EE productions added at event code 0, one
//     grammar per element QName, kept for the whole stream);
//   - schema-informed grammars (8.5) driven by grammar tables the caller
//     builds in code (ExiSchema: datatypes, attribute uses, particles with
//     minOccurs/maxOccurs whose terms are one element, a choice or a
//     substitution group, simple-content types, global elements at fixed
//     document positions). From the tables the codec derives each state's
//     productions as XML Schema normalization does: attributes in
//     (local-name, uri) order, then the elements reachable in schema order,
//     wildcards, EE, CH; event code widths follow; non-strict streams (the
//     default, and ISO 15118's) reserve one more first-level code in every
//     element state for the undeclared productions, strict streams do not
//     (and add AT(xsi:type)/AT(xsi:nil) where the tables say so).
//
// Checked: tests/bootstrap/test_std_exi.fd (hand-derived bit sequences for
// the primitive encodings, a built-in grammar document and a strict and a
// non-strict schema-informed one, string table hits, byte alignment and
// options headers), and through stdlib/iso15118.fd against 36 published DIN
// 70121 streams and 2 SupportedAppProtocol requests captured from cars
// (tests/bootstrap/test_std_iso15118.fd), each decoded and re-encoded to
// the same bytes.
//
// Not done (an error is returned, never a wrong stream): compression and
// pre-compression (DEFLATE channels), selfContained, the preserve options
// (comments, PIs, DTD, prefixes, lexical values), datatype representation
// maps, Float/Decimal/date-time datatypes, xsi:type, and the second-level
// ("undeclared") productions of non-strict schema-informed grammars: a
// decoder meets the escape code only for content that is not valid against
// the tables. The options document follows this module's reading of
// Appendix C (strict, schema-informed); it round-trips here but has not
// been compared with another implementation. No platform seam: the bytes
// come from and go to the caller.
//
// Bytes are Vec<i64>, one byte 0..255 each. An XML document is a list of
// events (ExiEvent: SE, AT, CH, EE; SD and ED are implied).
//
// Usage:
//   var s: ExiSchema = exi_schema_new();
//   val t: i64 = exi_type_simple(& mut s, exi_dt(& mut s, EXI_DT_UNSIGNED, 0, 0));
//   ... exi_global(& mut s, "urn:x", "n", t); exi_schema_finish(& mut s);
//   val r: ExiResult = exi_encode(& s, & exi_options(), & events);
//   val d: ExiDoc = exi_decode(& s, & exi_options(), & r.bytes);

module exi;
use vec;
use string;

// Datatypes of the grammar tables
pub const EXI_DT_STRING: i64 = 0;
pub const EXI_DT_BINARY: i64 = 1;    // base64Binary, hexBinary
pub const EXI_DT_BOOLEAN: i64 = 2;
pub const EXI_DT_UNSIGNED: i64 = 3;  // integers with a lower bound >= 0
pub const EXI_DT_INTEGER: i64 = 4;   // other integers
pub const EXI_DT_NBIT: i64 = 5;      // bounded integers, range <= 4096
pub const EXI_DT_ENUM: i64 = 6;
pub const EXI_DT_LIST: i64 = 7;

// Events
pub const EXI_SE: i64 = 1;
pub const EXI_EE: i64 = 2;
pub const EXI_AT: i64 = 3;
pub const EXI_CH: i64 = 4;

pub const EXI_XSI: str = "http://www.w3.org/2001/XMLSchema-instance";
pub const EXI_OPTIONS_NS: str = "http://www.w3.org/2009/exi";

// Alignment option
pub const EXI_BIT_PACKED: i64 = 0;
pub const EXI_BYTE_ALIGNED: i64 = 1;
pub const EXI_PRE_COMPRESS: i64 = 2;

/// Bits needed to tell n values apart: ceil(log2(n)), 0 for n <= 1.
pub fn exi_nbits(n: i64) -> i64 {
    var b: i64 = 0;
    while (1 << b) < n {
        b = b + 1;
    }
    return b;
}

// ─── Bit stream ──────────────────────────────────────────────────────────

pub struct ExiWriter {
    pub out: Vec<i64>,
    pub cur: i64,
    pub fill: i64,
    pub aligned: bool,   // byte-aligned body
}

/// An empty bit-packed EXI writer.
///
/// Example:
///   assert_eq(exi_nbits(5), 3);
///   assert_eq(exi_nbits(1), 0);
///   var w = exi_writer();
///   exi_w_nbit(&mut w, 5, 3);
///   exi_w_uint(&mut w, 300);
///   exi_w_bool(&mut w, true);
///   exi_w_int(&mut w, -7);
///   var r = exi_reader(exi_w_bytes(&w));
///   assert_eq(exi_r_nbit(&mut r, 3), 5);
///   assert_eq(exi_r_uint(&mut r), 300);
///   assert(exi_r_bool(&mut r));
///   assert_eq(exi_r_int(&mut r), -7);
pub fn exi_writer() -> ExiWriter {
    return ExiWriter { out: Vec::new(), cur: 0, fill: 0, aligned: false };
}

/// n bits of v, most significant first, whatever the alignment.
pub fn exi_w_raw(w: & mut ExiWriter, v: i64, n: i64) {
    var i: i64 = n - 1;
    while i >= 0 {
        w.cur = (w.cur << 1) | ((v >> i) & 1);
        w.fill = w.fill + 1;
        if w.fill == 8 {
            w.out.push(w.cur);
            w.cur = 0;
            w.fill = 0;
        }
        i = i - 1;
    }
}

/// An n-bit unsigned integer: n bits, or in a byte-aligned body the
/// fewest whole bytes, least significant first.
pub fn exi_w_nbit(w: & mut ExiWriter, v: i64, n: i64) {
    if n <= 0 {
        return;
    }
    if w.aligned {
        var k: i64 = 0;
        while k * 8 < n {
            exi_w_raw(w, (v >> (k * 8)) & 255, 8);
            k = k + 1;
        }
        return;
    }
    exi_w_raw(w, v, n);
}

/// Pad with zero bits to the next byte boundary.
pub fn exi_w_align(w: & mut ExiWriter) {
    while w.fill != 0 {
        exi_w_raw(w, 0, 1);
    }
}

/// Unsigned Integer: 7 bits per octet, least significant group first, the
/// top bit set on every octet but the last.
pub fn exi_w_uint(w: & mut ExiWriter, v_in: i64) {
    var v: i64 = v_in;
    loop {
        val low: i64 = v & 127;
        v = v >> 7;
        if v != 0 {
            exi_w_raw(w, low | 128, 8);
        } else {
            exi_w_raw(w, low, 8);
            break;
        }
    }
}

pub fn exi_w_bool(w: & mut ExiWriter, b: bool) {
    if b {
        exi_w_nbit(w, 1, 1);
    } else {
        exi_w_nbit(w, 0, 1);
    }
}

/// Integer: a sign bit, then |v| (positive) or |v| - 1 (negative).
pub fn exi_w_int(w: & mut ExiWriter, v: i64) {
    if v < 0 {
        exi_w_bool(w, true);
        exi_w_uint(w, 0 - (v + 1));
    } else {
        exi_w_bool(w, false);
        exi_w_uint(w, v);
    }
}

/// Binary: the length, then the bytes.
pub fn exi_w_binary(w: & mut ExiWriter, b: & Vec<i64>) {
    exi_w_uint(w, b.len());
    var i: i64 = 0;
    while i < b.len() {
        exi_w_raw(w, b.get(i) & 255, 8);
        i = i + 1;
    }
}

/// The bytes written so far, the last one padded with zero bits.
pub fn exi_w_bytes(w: & ExiWriter) -> Vec<i64> {
    var out: Vec<i64> = w.out;
    if w.fill > 0 {
        out.push((w.cur << (8 - w.fill)) & 255);
    }
    return out;
}

/// Append all bits of `src` (unpadded) to `w`.
fn exi_w_append(w: & mut ExiWriter, src: & ExiWriter) {
    var i: i64 = 0;
    while i < src.out.len() {
        exi_w_raw(w, src.out.get(i), 8);
        i = i + 1;
    }
    exi_w_raw(w, src.cur, src.fill);
}

pub struct ExiReader {
    pub b: Vec<i64>,
    pub pos: i64,        // in bits
    pub ok: bool,
    pub error: str,
    pub aligned: bool,
}

pub fn exi_reader(b: Vec<i64>) -> ExiReader {
    return ExiReader { b: b, pos: 0, ok: true, error: "", aligned: false };
}

pub fn exi_r_fail(r: & mut ExiReader, why: str) {
    if r.ok {
        r.ok = false;
        r.error = why + " at bit " + int_to_str(r.pos);
    }
}

pub fn exi_r_raw(r: & mut ExiReader, n: i64) -> i64 {
    var v: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if r.pos >= r.b.len() * 8 {
            exi_r_fail(r, "unexpected end of stream");
            return 0;
        }
        val bv: i64 = r.b.get(r.pos >> 3);
        v = (v << 1) | ((bv >> (7 - (r.pos & 7))) & 1);
        r.pos = r.pos + 1;
        i = i + 1;
    }
    return v;
}

pub fn exi_r_nbit(r: & mut ExiReader, n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    if r.aligned {
        var v: i64 = 0;
        var k: i64 = 0;
        while k * 8 < n {
            v = v | (exi_r_raw(r, 8) << (k * 8));
            k = k + 1;
        }
        return v;
    }
    return exi_r_raw(r, n);
}

pub fn exi_r_align(r: & mut ExiReader) {
    while (r.pos & 7) != 0 {
        r.pos = r.pos + 1;
    }
}

pub fn exi_r_uint(r: & mut ExiReader) -> i64 {
    var v: i64 = 0;
    var shift: i64 = 0;
    loop {
        val octet: i64 = exi_r_raw(r, 8);
        if !r.ok {
            return 0;
        }
        if shift > 56 {
            exi_r_fail(r, "unsigned integer larger than 63 bits");
            return 0;
        }
        v = v | ((octet & 127) << shift);
        shift = shift + 7;
        if octet < 128 {
            break;
        }
    }
    return v;
}

pub fn exi_r_bool(r: & mut ExiReader) -> bool {
    return exi_r_nbit(r, 1) == 1;
}

pub fn exi_r_int(r: & mut ExiReader) -> i64 {
    val neg: bool = exi_r_bool(r);
    val m: i64 = exi_r_uint(r);
    if neg {
        return 0 - m - 1;
    }
    return m;
}

pub fn exi_r_binary(r: & mut ExiReader) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val n: i64 = exi_r_uint(r);
    if n * 8 > r.b.len() * 8 - r.pos {
        exi_r_fail(r, "binary value runs past the end");
        return out;
    }
    var i: i64 = 0;
    while i < n {
        out.push(exi_r_raw(r, 8));
        i = i + 1;
    }
    return out;
}

// ─── Characters ──────────────────────────────────────────────────────────

/// The Unicode code points of a UTF-8 string.
pub fn exi_codepoints(s: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    val n: i64 = str_len(s);
    var i: i64 = 0;
    while i < n {
        val c: i64 = str_byte_at(s, i);
        if c < 128 || i + 1 >= n {
            out.push(c);
            i = i + 1;
        } else if c < 224 {
            out.push(((c & 31) << 6) | (str_byte_at(s, i + 1) & 63));
            i = i + 2;
        } else if c < 240 && i + 2 < n {
            out.push(((c & 15) << 12) | ((str_byte_at(s, i + 1) & 63) << 6) | (str_byte_at(s, i + 2) & 63));
            i = i + 3;
        } else if i + 3 < n {
            out.push(((c & 7) << 18) | ((str_byte_at(s, i + 1) & 63) << 12) | ((str_byte_at(s, i + 2) & 63) << 6) | (str_byte_at(s, i + 3) & 63));
            i = i + 4;
        } else {
            out.push(c);
            i = i + 1;
        }
    }
    return out;
}

/// UTF-8 text of code points.
pub fn exi_from_codepoints(cps: & Vec<i64>) -> str {
    var b: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < cps.len() {
        val c: i64 = cps.get(i);
        if c < 128 {
            b.push(c);
        } else if c < 2048 {
            b.push(192 | (c >> 6));
            b.push(128 | (c & 63));
        } else if c < 65536 {
            b.push(224 | (c >> 12));
            b.push(128 | ((c >> 6) & 63));
            b.push(128 | (c & 63));
        } else {
            b.push(240 | (c >> 18));
            b.push(128 | ((c >> 12) & 63));
            b.push(128 | ((c >> 6) & 63));
            b.push(128 | (c & 63));
        }
        i = i + 1;
    }
    return str_from_bytes(b);
}

fn exi_w_chars(w: & mut ExiWriter, cps: & Vec<i64>) {
    var i: i64 = 0;
    while i < cps.len() {
        exi_w_uint(w, cps.get(i));
        i = i + 1;
    }
}

fn exi_r_chars(r: & mut ExiReader, n: i64) -> str {
    var cps: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n && r.ok {
        if r.pos >= r.b.len() * 8 {
            exi_r_fail(r, "string runs past the end");
            return "";
        }
        cps.push(exi_r_uint(r));
        i = i + 1;
    }
    return exi_from_codepoints(& cps);
}

/// A String literal: the number of code points, then each one.
pub fn exi_w_string(w: & mut ExiWriter, s: str) {
    val cps: Vec<i64> = exi_codepoints(s);
    exi_w_uint(w, cps.len());
    exi_w_chars(w, & cps);
}

// ─── String tables ───────────────────────────────────────────────────────

/// The string table of one stream. QNames are numbered (qn_*) so that
/// local value partitions and built-in grammars can be keyed by number.
pub struct ExiStrings {
    pub uris: Vec<str>,
    pub ln_uri: Vec<i64>,      // local-name partitions, flattened
    pub ln_name: Vec<str>,
    pub qn_uri: Vec<str>,
    pub qn_name: Vec<str>,
    pub gv: Vec<str>,          // global value partition
    pub gv_key: Vec<i64>,      // the QName whose local partition holds it
    pub gv_local: Vec<i64>,    // its id there
    pub lv_key: Vec<i64>,      // local entries, in insertion order
    pub lv_val: Vec<str>,
    pub lv_live: Vec<bool>,
    pub next_g: i64,
    pub max_len: i64,          // valueMaxLength, -1: unbounded
    pub capacity: i64,         // valuePartitionCapacity, -1: unbounded
}

pub fn exi_strings(max_len: i64, capacity: i64) -> ExiStrings {
    var t: ExiStrings = ExiStrings {
        uris: Vec::new(), ln_uri: Vec::new(), ln_name: Vec::new(), qn_uri: Vec::new(), qn_name: Vec::new(),
        gv: Vec::new(), gv_key: Vec::new(), gv_local: Vec::new(), lv_key: Vec::new(), lv_val: Vec::new(), lv_live: Vec::new(),
        next_g: 0, max_len: max_len, capacity: capacity,
    };
    // initial entries (Appendix D.1, D.3)
    t.uris.push("");
    t.uris.push("http://www.w3.org/XML/1998/namespace");
    t.uris.push(EXI_XSI);
    exi_ln_add(& mut t, 1, "base");
    exi_ln_add(& mut t, 1, "id");
    exi_ln_add(& mut t, 1, "lang");
    exi_ln_add(& mut t, 1, "space");
    exi_ln_add(& mut t, 2, "nil");
    exi_ln_add(& mut t, 2, "type");
    return t;
}

fn exi_ln_add(t: & mut ExiStrings, uri: i64, name: str) {
    t.ln_uri.push(uri);
    t.ln_name.push(name);
}

/// The number of a QName (added when new).
pub fn exi_qid(t: & mut ExiStrings, uri: str, name: str) -> i64 {
    var i: i64 = 0;
    while i < t.qn_name.len() {
        if t.qn_name.get(i) == name && t.qn_uri.get(i) == uri {
            return i;
        }
        i = i + 1;
    }
    t.qn_uri.push(uri);
    t.qn_name.push(name);
    return t.qn_name.len() - 1;
}

fn exi_local_count(t: & ExiStrings, key: i64) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < t.lv_key.len() {
        if t.lv_key.get(i) == key {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn exi_local_find(t: & ExiStrings, key: i64, s: str) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < t.lv_key.len() {
        if t.lv_key.get(i) == key {
            if t.lv_live.get(i) && t.lv_val.get(i) == s {
                return n;
            }
            n = n + 1;
        }
        i = i + 1;
    }
    return - 1;
}

/// Flat index of local entry `id` of partition `key`, -1 if none.
fn exi_local_slot(t: & ExiStrings, key: i64, id: i64) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < t.lv_key.len() {
        if t.lv_key.get(i) == key {
            if n == id {
                return i;
            }
            n = n + 1;
        }
        i = i + 1;
    }
    return - 1;
}

fn exi_global_find(t: & ExiStrings, s: str) -> i64 {
    var i: i64 = 0;
    while i < t.gv.len() {
        if t.gv.get(i) == s {
            return i;
        }
        i = i + 1;
    }
    return - 1;
}

/// Add a value that was a miss to its local partition and the global one.
fn exi_value_add(t: & mut ExiStrings, key: i64, s: str, ncp: i64) {
    if ncp == 0 || t.capacity == 0 || (t.max_len >= 0 && ncp > t.max_len) {
        return;
    }
    val local_id: i64 = exi_local_count(t, key);
    t.lv_key.push(key);
    t.lv_val.push(s);
    t.lv_live.push(true);
    if t.capacity < 0 || t.gv.len() < t.capacity {
        t.gv.push(s);
        t.gv_key.push(key);
        t.gv_local.push(local_id);
        t.next_g = t.gv.len();
        if t.capacity > 0 && t.next_g == t.capacity {
            t.next_g = 0;
        }
        return;
    }
    // full: replace the entry at next_g and vacate its local entry
    val slot: i64 = exi_local_slot(t, t.gv_key.get(t.next_g), t.gv_local.get(t.next_g));
    if slot >= 0 {
        t.lv_live.set(slot, false);
    }
    t.gv.set(t.next_g, s);
    t.gv_key.set(t.next_g, key);
    t.gv_local.set(t.next_g, local_id);
    t.next_g = t.next_g + 1;
    if t.next_g == t.capacity {
        t.next_g = 0;
    }
}

/// A string value of QName `key` (7.3.3): a local hit, a global hit or a
/// literal that is then added to the tables.
pub fn exi_w_value(w: & mut ExiWriter, t: & mut ExiStrings, key: i64, s: str) {
    val li: i64 = exi_local_find(t, key, s);
    if li >= 0 {
        exi_w_uint(w, 0);
        exi_w_nbit(w, li, exi_nbits(exi_local_count(t, key)));
        return;
    }
    val gi: i64 = exi_global_find(t, s);
    if gi >= 0 {
        exi_w_uint(w, 1);
        exi_w_nbit(w, gi, exi_nbits(t.gv.len()));
        return;
    }
    val cps: Vec<i64> = exi_codepoints(s);
    exi_w_uint(w, cps.len() + 2);
    exi_w_chars(w, & cps);
    exi_value_add(t, key, s, cps.len());
}

pub fn exi_r_value(r: & mut ExiReader, t: & mut ExiStrings, key: i64) -> str {
    val n: i64 = exi_r_uint(r);
    if !r.ok {
        return "";
    }
    if n == 0 {
        val id: i64 = exi_r_nbit(r, exi_nbits(exi_local_count(t, key)));
        val slot: i64 = exi_local_slot(t, key, id);
        if slot < 0 || !t.lv_live.get(slot) {
            exi_r_fail(r, "local value id " + int_to_str(id) + " not in the table");
            return "";
        }
        return t.lv_val.get(slot);
    }
    if n == 1 {
        val id: i64 = exi_r_nbit(r, exi_nbits(t.gv.len()));
        if id >= t.gv.len() {
            exi_r_fail(r, "global value id " + int_to_str(id) + " not in the table");
            return "";
        }
        return t.gv.get(id);
    }
    if (n - 2) * 8 > r.b.len() * 8 - r.pos {
        exi_r_fail(r, "string runs past the end");
        return "";
    }
    val s: str = exi_r_chars(r, n - 2);
    exi_value_add(t, key, s, n - 2);
    return s;
}

/// A QName (7.1.7): URI (n-bit, 0 = new) and local name (0 + id, or
/// length + 1 and the characters). Prefixes are not preserved.
pub fn exi_w_qname(w: & mut ExiWriter, t: & mut ExiStrings, uri: str, name: str) {
    var ui: i64 = - 1;
    var i: i64 = 0;
    while i < t.uris.len() {
        if t.uris.get(i) == uri {
            ui = i;
        }
        i = i + 1;
    }
    val ubits: i64 = exi_nbits(t.uris.len() + 1);
    if ui >= 0 {
        exi_w_nbit(w, ui + 1, ubits);
    } else {
        exi_w_nbit(w, 0, ubits);
        exi_w_string(w, uri);
        t.uris.push(uri);
        ui = t.uris.len() - 1;
    }
    var id: i64 = - 1;
    var count: i64 = 0;
    i = 0;
    while i < t.ln_name.len() {
        if t.ln_uri.get(i) == ui {
            if t.ln_name.get(i) == name {
                id = count;
            }
            count = count + 1;
        }
        i = i + 1;
    }
    if id >= 0 {
        exi_w_uint(w, 0);
        exi_w_nbit(w, id, exi_nbits(count));
        return;
    }
    val cps: Vec<i64> = exi_codepoints(name);
    exi_w_uint(w, cps.len() + 1);
    exi_w_chars(w, & cps);
    exi_ln_add(t, ui, name);
}

/// Read a QName; returns its number (exi_qid).
pub fn exi_r_qname(r: & mut ExiReader, t: & mut ExiStrings) -> i64 {
    var ui: i64 = exi_r_nbit(r, exi_nbits(t.uris.len() + 1));
    if ui == 0 {
        val n: i64 = exi_r_uint(r);
        t.uris.push(exi_r_chars(r, n));
        ui = t.uris.len() - 1;
    } else {
        ui = ui - 1;
        if ui >= t.uris.len() {
            exi_r_fail(r, "bad URI id");
            return 0;
        }
    }
    val n: i64 = exi_r_uint(r);
    var name: str = "";
    if n == 0 {
        var count: i64 = 0;
        var i: i64 = 0;
        while i < t.ln_name.len() {
            if t.ln_uri.get(i) == ui {
                count = count + 1;
            }
            i = i + 1;
        }
        val id: i64 = exi_r_nbit(r, exi_nbits(count));
        var k: i64 = 0;
        var found: bool = false;
        i = 0;
        while i < t.ln_name.len() {
            if t.ln_uri.get(i) == ui {
                if k == id {
                    name = t.ln_name.get(i);
                    found = true;
                }
                k = k + 1;
            }
            i = i + 1;
        }
        if !found {
            exi_r_fail(r, "bad local-name id");
        }
    } else {
        name = exi_r_chars(r, n - 1);
        exi_ln_add(t, ui, name);
    }
    return exi_qid(t, t.uris.get(ui), name);
}

// ─── Grammar tables ──────────────────────────────────────────────────────

/// Schema-informed grammar tables. Build with exi_dt*, exi_type*,
/// exi_attr, exi_elem / exi_particle + exi_alt, exi_global*, then call
/// exi_schema_finish. An ExiSchema from exi_schema_none() (no globals)
/// selects the built-in grammars.
pub struct ExiSchema {
    pub informed: bool,
    pub dt_kind: Vec<i64>,
    pub dt_lo: Vec<i64>,
    pub dt_hi: Vec<i64>,
    pub dt_first: Vec<i64>,    // enumeration names: enames[first .. first+count]
    pub dt_count: Vec<i64>,
    pub dt_item: Vec<i64>,     // list item datatype
    pub enames: Vec<str>,
    pub ty_dt: Vec<i64>,       // simple content datatype; -1: element content
    pub ty_ok: Vec<bool>,      // false: declared without a grammar here
    pub ty_xsitype: Vec<bool>, // has named sub-types (strict: AT(xsi:type))
    pub ty_attrs: Vec<Vec<i64>>,
    pub ty_parts: Vec<Vec<i64>>,
    pub at_uri: Vec<str>,
    pub at_name: Vec<str>,
    pub at_dt: Vec<i64>,
    pub at_req: Vec<bool>,
    pub pa_min: Vec<i64>,
    pub pa_max: Vec<i64>,      // -1: unbounded
    pub pa_alts: Vec<Vec<i64>>,
    pub el_uri: Vec<str>,
    pub el_name: Vec<str>,     // "*": wildcard
    pub el_type: Vec<i64>,
    pub el_nil: Vec<bool>,
    pub globals: Vec<i64>,     // element declarations
    pub gpos: Vec<i64>,        // their position in the document grammar
    pub nglobals: i64,         // number of global elements of the schema
}

pub fn exi_schema_none() -> ExiSchema {
    return ExiSchema {
        informed: false, dt_kind: Vec::new(), dt_lo: Vec::new(), dt_hi: Vec::new(), dt_first: Vec::new(), dt_count: Vec::new(), dt_item: Vec::new(), enames: Vec::new(),
        ty_dt: Vec::new(), ty_ok: Vec::new(), ty_xsitype: Vec::new(), ty_attrs: Vec::new(), ty_parts: Vec::new(),
        at_uri: Vec::new(), at_name: Vec::new(), at_dt: Vec::new(), at_req: Vec::new(),
        pa_min: Vec::new(), pa_max: Vec::new(), pa_alts: Vec::new(),
        el_uri: Vec::new(), el_name: Vec::new(), el_type: Vec::new(), el_nil: Vec::new(),
        globals: Vec::new(), gpos: Vec::new(), nglobals: 0,
    };
}

pub fn exi_schema_new() -> ExiSchema {
    var s: ExiSchema = exi_schema_none();
    s.informed = true;
    return s;
}

/// A datatype: kind EXI_DT_*, with [lo, hi] for EXI_DT_NBIT.
pub fn exi_dt(s: & mut ExiSchema, kind: i64, lo: i64, hi: i64) -> i64 {
    s.dt_kind.push(kind);
    s.dt_lo.push(lo);
    s.dt_hi.push(hi);
    s.dt_first.push(0);
    s.dt_count.push(0);
    s.dt_item.push(- 1);
    return s.dt_kind.len() - 1;
}

/// An enumeration of the values in `names`, separated by "|", in schema
/// order.
pub fn exi_dt_enum(s: & mut ExiSchema, names: str) -> i64 {
    val d: i64 = exi_dt(s, EXI_DT_ENUM, 0, 0);
    val parts: Vec<str> = str_split(names, "|");
    s.dt_first.set(d, s.enames.len());
    s.dt_count.set(d, parts.len());
    var i: i64 = 0;
    while i < parts.len() {
        s.enames.push(parts.get(i));
        i = i + 1;
    }
    return d;
}

/// A list of `item` values.
pub fn exi_dt_list(s: & mut ExiSchema, item: i64) -> i64 {
    val d: i64 = exi_dt(s, EXI_DT_LIST, 0, 0);
    s.dt_item.set(d, item);
    return d;
}

/// The name of enumeration value `i` of datatype `d`.
pub fn exi_enum_name(s: & ExiSchema, d: i64, i: i64) -> str {
    if i < 0 || i >= s.dt_count.get(d) {
        return "";
    }
    return s.enames.get(s.dt_first.get(d) + i);
}

pub fn exi_enum_index(s: & ExiSchema, d: i64, name: str) -> i64 {
    var i: i64 = 0;
    while i < s.dt_count.get(d) {
        if s.enames.get(s.dt_first.get(d) + i) == name {
            return i;
        }
        i = i + 1;
    }
    return - 1;
}

fn exi_type_add(s: & mut ExiSchema, dt: i64) -> i64 {
    s.ty_dt.push(dt);
    s.ty_ok.push(true);
    s.ty_xsitype.push(false);
    s.ty_attrs.push(Vec::new());
    s.ty_parts.push(Vec::new());
    return s.ty_dt.len() - 1;
}

/// A complex type with element content (particles added with exi_elem /
/// exi_particle) and attributes (exi_attr).
pub fn exi_type(s: & mut ExiSchema) -> i64 {
    return exi_type_add(s, - 1);
}

/// A type with simple content of datatype `dt` (an element of a simple
/// type, or a complex type with simple content and attributes).
pub fn exi_type_simple(s: & mut ExiSchema, dt: i64) -> i64 {
    return exi_type_add(s, dt);
}

/// A type named by the schema but without a grammar here: an element of
/// this type is refused by the encoder and the decoder.
pub fn exi_type_opaque(s: & mut ExiSchema) -> i64 {
    val t: i64 = exi_type_add(s, - 1);
    s.ty_ok.set(t, false);
    return t;
}

/// An attribute use of type `t`; kept sorted by local name, then URI.
pub fn exi_attr(s: & mut ExiSchema, t: i64, uri: str, name: str, dt: i64, required: bool) {
    s.at_uri.push(uri);
    s.at_name.push(name);
    s.at_dt.push(dt);
    s.at_req.push(required);
    val a: i64 = s.at_name.len() - 1;
    val old: Vec<i64> = s.ty_attrs.get(t);
    var list: Vec<i64> = Vec::new();
    var placed: bool = false;
    var i: i64 = 0;
    while i < old.len() {
        val b: i64 = old.get(i);
        if !placed && exi_qname_less(name, uri, s.at_name.get(b), s.at_uri.get(b)) {
            list.push(a);
            placed = true;
        }
        list.push(b);
        i = i + 1;
    }
    if !placed {
        list.push(a);
    }
    s.ty_attrs.set(t, list);
}

/// (local name, URI) order of QNames.
pub fn exi_qname_less(n1: str, u1: str, n2: str, u2: str) -> bool {
    val c: i64 = str_compare(n1, n2);
    if c != 0 {
        return c < 0;
    }
    return str_compare(u1, u2) < 0;
}

/// A particle of type `t` (in schema order); its terms are added with
/// exi_alt. max -1 is unbounded.
pub fn exi_particle(s: & mut ExiSchema, t: i64, min: i64, max: i64) -> i64 {
    s.pa_min.push(min);
    s.pa_max.push(max);
    s.pa_alts.push(Vec::new());
    val p: i64 = s.pa_min.len() - 1;
    var parts: Vec<i64> = s.ty_parts.get(t);
    parts.push(p);
    s.ty_parts.set(t, parts);
    return p;
}

/// Add element `name` of type `et` as a term of particle `p` (choices keep
/// the order of the calls; see exi_alt_sorted for substitution groups).
pub fn exi_alt(s: & mut ExiSchema, p: i64, uri: str, name: str, et: i64) -> i64 {
    s.el_uri.push(uri);
    s.el_name.push(name);
    s.el_type.push(et);
    s.el_nil.push(false);
    val e: i64 = s.el_name.len() - 1;
    var alts: Vec<i64> = s.pa_alts.get(p);
    alts.push(e);
    s.pa_alts.set(p, alts);
    return e;
}

/// Add a member of a substitution group: the terms stay sorted by local
/// name, then URI (8.5.4.1.6).
pub fn exi_alt_sorted(s: & mut ExiSchema, p: i64, uri: str, name: str, et: i64) -> i64 {
    val e: i64 = exi_alt(s, p, uri, name, et);
    val old: Vec<i64> = s.pa_alts.get(p);
    var list: Vec<i64> = Vec::new();
    var placed: bool = false;
    var i: i64 = 0;
    while i < old.len() - 1 {
        val b: i64 = old.get(i);
        if !placed && exi_qname_less(name, uri, s.el_name.get(b), s.el_uri.get(b)) {
            list.push(e);
            placed = true;
        }
        list.push(b);
        i = i + 1;
    }
    if !placed {
        list.push(e);
    }
    s.pa_alts.set(p, list);
    return e;
}

/// A particle holding one element.
pub fn exi_elem(s: & mut ExiSchema, t: i64, uri: str, name: str, et: i64, min: i64, max: i64) -> i64 {
    val p: i64 = exi_particle(s, t, min, max);
    return exi_alt(s, p, uri, name, et);
}

/// Mark element declaration `e` nillable.
pub fn exi_nillable(s: & mut ExiSchema, e: i64) {
    s.el_nil.set(e, true);
}

/// A global element; positions are assigned by exi_schema_finish in
/// (local name, URI) order.
pub fn exi_global(s: & mut ExiSchema, uri: str, name: str, et: i64) -> i64 {
    s.el_uri.push(uri);
    s.el_name.push(name);
    s.el_type.push(et);
    s.el_nil.push(false);
    val e: i64 = s.el_name.len() - 1;
    s.globals.push(e);
    s.gpos.push(- 1);
    return e;
}

/// A global element at a fixed position `pos` of a document grammar with
/// `total` global elements (for schemas whose other globals have no
/// grammar here).
pub fn exi_global_at(s: & mut ExiSchema, pos: i64, total: i64, uri: str, name: str, et: i64) -> i64 {
    val e: i64 = exi_global(s, uri, name, et);
    s.gpos.set(s.gpos.len() - 1, pos);
    s.nglobals = total;
    return e;
}

pub fn exi_schema_finish(s: & mut ExiSchema) {
    // rank the globals without a fixed position
    var n: i64 = 0;
    var i: i64 = 0;
    while i < s.globals.len() {
        if s.gpos.get(i) < 0 {
            n = n + 1;
        }
        i = i + 1;
    }
    if n == 0 {
        return;
    }
    i = 0;
    while i < s.globals.len() {
        if s.gpos.get(i) < 0 {
            val e: i64 = s.globals.get(i);
            var rank: i64 = 0;
            var k: i64 = 0;
            while k < s.globals.len() {
                val f: i64 = s.globals.get(k);
                if k != i && exi_qname_less(s.el_name.get(f), s.el_uri.get(f), s.el_name.get(e), s.el_uri.get(e)) {
                    rank = rank + 1;
                }
                k = k + 1;
            }
            s.gpos.set(i, rank);
        }
        i = i + 1;
    }
    s.nglobals = s.globals.len();
}

// ─── Events ──────────────────────────────────────────────────────────────

/// One XML event. Values (AT, CH): `sval` for strings and enumeration
/// names, `ival` for integers, booleans (0/1) and enumeration indexes,
/// `bval` for binary values and lists of integers (a list of strings is
/// `sval` with the items separated by spaces).
pub struct ExiEvent {
    pub kind: i64,
    pub uri: str,
    pub name: str,
    pub ival: i64,
    pub sval: str,
    pub bval: Vec<i64>,
}

pub fn exi_ev(kind: i64, uri: str, name: str) -> ExiEvent {
    return ExiEvent { kind: kind, uri: uri, name: name, ival: 0, sval: "", bval: Vec::new() };
}

pub fn exi_se(uri: str, name: str) -> ExiEvent {
    return exi_ev(EXI_SE, uri, name);
}

pub fn exi_ee() -> ExiEvent {
    return exi_ev(EXI_EE, "", "");
}

pub fn exi_ch_str(v: str) -> ExiEvent {
    var e: ExiEvent = exi_ev(EXI_CH, "", "");
    e.sval = v;
    return e;
}

pub fn exi_ch_int(v: i64) -> ExiEvent {
    var e: ExiEvent = exi_ev(EXI_CH, "", "");
    e.ival = v;
    return e;
}

pub fn exi_ch_bool(v: bool) -> ExiEvent {
    var e: ExiEvent = exi_ev(EXI_CH, "", "");
    if v {
        e.ival = 1;
    }
    return e;
}

pub fn exi_ch_bin(v: Vec<i64>) -> ExiEvent {
    var e: ExiEvent = exi_ev(EXI_CH, "", "");
    e.bval = v;
    return e;
}

pub fn exi_at_str(uri: str, name: str, v: str) -> ExiEvent {
    var e: ExiEvent = exi_ev(EXI_AT, uri, name);
    e.sval = v;
    return e;
}

pub fn exi_at_int(uri: str, name: str, v: i64) -> ExiEvent {
    var e: ExiEvent = exi_ev(EXI_AT, uri, name);
    e.ival = v;
    return e;
}

/// Push SE(name), CH(value), EE: a simple element.
pub fn exi_push_leaf(evs: & mut Vec<ExiEvent>, uri: str, name: str, value: ExiEvent) {
    evs.push(exi_se(uri, name));
    evs.push(value);
    evs.push(exi_ee());
}

// ─── Options ─────────────────────────────────────────────────────────────

pub struct ExiOptions {
    pub alignment: i64,         // EXI_BIT_PACKED, EXI_BYTE_ALIGNED, EXI_PRE_COMPRESS
    pub compression: bool,
    pub strict: bool,
    pub fragment: bool,
    pub self_contained: bool,
    pub value_max_length: i64,  // -1: unbounded
    pub value_capacity: i64,    // -1: unbounded
    pub block_size: i64,
    pub schema_id: str,
    pub has_schema_id: bool,
    pub schema_id_nil: bool,
    pub preserve_dtd: bool,
    pub preserve_prefixes: bool,
    pub preserve_lexical: bool,
    pub preserve_comments: bool,
    pub preserve_pis: bool,
    pub cookie: bool,           // write the "$EXI" cookie
    pub in_header: bool,        // write the options into the header
}

/// The default options (5.4), not written into the header.
pub fn exi_options() -> ExiOptions {
    return ExiOptions {
        alignment: EXI_BIT_PACKED, compression: false, strict: false, fragment: false, self_contained: false,
        value_max_length: - 1, value_capacity: - 1, block_size: 1000000, schema_id: "", has_schema_id: false, schema_id_nil: false,
        preserve_dtd: false, preserve_prefixes: false, preserve_lexical: false, preserve_comments: false, preserve_pis: false,
        cookie: false, in_header: false,
    };
}

/// A copy of `o`.
pub fn exi_options_copy(o: & ExiOptions) -> ExiOptions {
    return ExiOptions {
        alignment: o.alignment, compression: o.compression, strict: o.strict, fragment: o.fragment, self_contained: o.self_contained,
        value_max_length: o.value_max_length, value_capacity: o.value_capacity, block_size: o.block_size, schema_id: o.schema_id,
        has_schema_id: o.has_schema_id, schema_id_nil: o.schema_id_nil, preserve_dtd: o.preserve_dtd, preserve_prefixes: o.preserve_prefixes,
        preserve_lexical: o.preserve_lexical, preserve_comments: o.preserve_comments, preserve_pis: o.preserve_pis,
        cookie: o.cookie, in_header: o.in_header,
    };
}

/// Why these options cannot be used for a body here ("" when they can).
pub fn exi_options_unsupported(o: & ExiOptions) -> str {
    if o.compression { return "compression is not supported"; }
    if o.alignment == EXI_PRE_COMPRESS { return "pre-compression is not supported"; }
    if o.self_contained { return "selfContained is not supported"; }
    if o.preserve_dtd || o.preserve_prefixes || o.preserve_lexical || o.preserve_comments || o.preserve_pis {
        return "preserve options are not supported";
    }
    return "";
}

// The grammar tables of the EXI Options document (Appendix C).
fn exi_options_schema() -> ExiSchema {
    var s: ExiSchema = exi_schema_new();
    val ns: str = EXI_OPTIONS_NS;
    val emp: i64 = exi_type(& mut s);
    val d_ut: i64 = exi_dt(& mut s, EXI_DT_UNSIGNED, 0, 0);
    val ut: i64 = exi_type_simple(& mut s, d_ut);
    val d_txt: i64 = exi_dt(& mut s, EXI_DT_STRING, 0, 0);
    val txt: i64 = exi_type_simple(& mut s, d_txt);
    s.ty_xsitype.set(txt, true);
    val opaque: i64 = exi_type_opaque(& mut s);
    val align: i64 = exi_type(& mut s);
    val pa: i64 = exi_particle(& mut s, align, 1, 1);
    exi_alt(& mut s, pa, ns, "byte", emp);
    exi_alt(& mut s, pa, ns, "pre-compress", emp);
    val unc: i64 = exi_type(& mut s);
    exi_elem(& mut s, unc, "", "*", opaque, 0, - 1);
    exi_elem(& mut s, unc, ns, "alignment", align, 0, 1);
    exi_elem(& mut s, unc, ns, "selfContained", emp, 0, 1);
    exi_elem(& mut s, unc, ns, "valueMaxLength", ut, 0, 1);
    exi_elem(& mut s, unc, ns, "valuePartitionCapacity", ut, 0, 1);
    exi_elem(& mut s, unc, ns, "datatypeRepresentationMap", opaque, 0, - 1);
    val pres: i64 = exi_type(& mut s);
    exi_elem(& mut s, pres, ns, "dtd", emp, 0, 1);
    exi_elem(& mut s, pres, ns, "prefixes", emp, 0, 1);
    exi_elem(& mut s, pres, ns, "lexicalValues", emp, 0, 1);
    exi_elem(& mut s, pres, ns, "comments", emp, 0, 1);
    exi_elem(& mut s, pres, ns, "pis", emp, 0, 1);
    val less: i64 = exi_type(& mut s);
    exi_elem(& mut s, less, ns, "uncommon", unc, 0, 1);
    exi_elem(& mut s, less, ns, "preserve", pres, 0, 1);
    exi_elem(& mut s, less, ns, "blockSize", ut, 0, 1);
    val common: i64 = exi_type(& mut s);
    exi_elem(& mut s, common, ns, "compression", emp, 0, 1);
    exi_elem(& mut s, common, ns, "fragment", emp, 0, 1);
    val sid: i64 = exi_elem(& mut s, common, ns, "schemaId", txt, 0, 1);
    exi_nillable(& mut s, sid);
    val header: i64 = exi_type(& mut s);
    exi_elem(& mut s, header, ns, "lesscommon", less, 0, 1);
    exi_elem(& mut s, header, ns, "common", common, 0, 1);
    exi_elem(& mut s, header, ns, "strict", emp, 0, 1);
    exi_global(& mut s, ns, "header", header);
    exi_schema_finish(& mut s);
    return s;
}

fn exi_flag(evs: & mut Vec<ExiEvent>, name: str) {
    evs.push(exi_se(EXI_OPTIONS_NS, name));
    evs.push(exi_ee());
}

/// The events of the Options document of `o` (only non-default values).
pub fn exi_options_events(o: & ExiOptions) -> Vec<ExiEvent> {
    val ns: str = EXI_OPTIONS_NS;
    var evs: Vec<ExiEvent> = Vec::new();
    evs.push(exi_se(ns, "header"));
    val unc: bool = o.alignment != EXI_BIT_PACKED || o.self_contained || o.value_max_length >= 0 || o.value_capacity >= 0;
    val pres: bool = o.preserve_dtd || o.preserve_prefixes || o.preserve_lexical || o.preserve_comments || o.preserve_pis;
    val bs: bool = o.block_size != 1000000;
    if unc || pres || bs {
        evs.push(exi_se(ns, "lesscommon"));
        if unc {
            evs.push(exi_se(ns, "uncommon"));
            if o.alignment == EXI_BYTE_ALIGNED {
                evs.push(exi_se(ns, "alignment"));
                exi_flag(& mut evs, "byte");
                evs.push(exi_ee());
            } else if o.alignment == EXI_PRE_COMPRESS {
                evs.push(exi_se(ns, "alignment"));
                exi_flag(& mut evs, "pre-compress");
                evs.push(exi_ee());
            }
            if o.self_contained { exi_flag(& mut evs, "selfContained"); }
            if o.value_max_length >= 0 { exi_push_leaf(& mut evs, ns, "valueMaxLength", exi_ch_int(o.value_max_length)); }
            if o.value_capacity >= 0 { exi_push_leaf(& mut evs, ns, "valuePartitionCapacity", exi_ch_int(o.value_capacity)); }
            evs.push(exi_ee());
        }
        if pres {
            evs.push(exi_se(ns, "preserve"));
            if o.preserve_dtd { exi_flag(& mut evs, "dtd"); }
            if o.preserve_prefixes { exi_flag(& mut evs, "prefixes"); }
            if o.preserve_lexical { exi_flag(& mut evs, "lexicalValues"); }
            if o.preserve_comments { exi_flag(& mut evs, "comments"); }
            if o.preserve_pis { exi_flag(& mut evs, "pis"); }
            evs.push(exi_ee());
        }
        if bs { exi_push_leaf(& mut evs, ns, "blockSize", exi_ch_int(o.block_size)); }
        evs.push(exi_ee());
    }
    if o.compression || o.fragment || o.has_schema_id {
        evs.push(exi_se(ns, "common"));
        if o.compression { exi_flag(& mut evs, "compression"); }
        if o.fragment { exi_flag(& mut evs, "fragment"); }
        if o.has_schema_id {
            evs.push(exi_se(ns, "schemaId"));
            if o.schema_id_nil {
                evs.push(exi_at_int(EXI_XSI, "nil", 1));
            } else {
                evs.push(exi_ch_str(o.schema_id));
            }
            evs.push(exi_ee());
        }
        evs.push(exi_ee());
    }
    if o.strict { exi_flag(& mut evs, "strict"); }
    evs.push(exi_ee());
    return evs;
}

/// Options from the events of an Options document.
pub fn exi_options_from(evs: & Vec<ExiEvent>) -> ExiOptions {
    var o: ExiOptions = exi_options();
    o.in_header = true;
    var parent: str = "";
    var i: i64 = 0;
    while i < evs.len() {
        val e: ExiEvent = evs.get(i);
        if e.kind == EXI_SE {
            val n: str = e.name;
            if n == "byte" { o.alignment = EXI_BYTE_ALIGNED; }
            if n == "pre-compress" { o.alignment = EXI_PRE_COMPRESS; }
            if n == "selfContained" { o.self_contained = true; }
            if n == "dtd" { o.preserve_dtd = true; }
            if n == "prefixes" { o.preserve_prefixes = true; }
            if n == "lexicalValues" { o.preserve_lexical = true; }
            if n == "comments" { o.preserve_comments = true; }
            if n == "pis" { o.preserve_pis = true; }
            if n == "compression" { o.compression = true; }
            if n == "fragment" { o.fragment = true; }
            if n == "strict" { o.strict = true; }
            if n == "schemaId" { o.has_schema_id = true; }
            parent = n;
        } else if e.kind == EXI_CH {
            if parent == "valueMaxLength" { o.value_max_length = e.ival; }
            if parent == "valuePartitionCapacity" { o.value_capacity = e.ival; }
            if parent == "blockSize" { o.block_size = e.ival; }
            if parent == "schemaId" { o.schema_id = e.sval; }
        } else if e.kind == EXI_AT && e.name == "nil" {
            o.schema_id_nil = e.ival != 0;
        }
        i = i + 1;
    }
    return o;
}

// ─── Codec state ─────────────────────────────────────────────────────────

/// Encoder/decoder state: the bit stream, string table, element stack
/// and built-in grammars of one EXI stream.
pub struct ExiCtx {
    pub w: ExiWriter,
    pub r: ExiReader,
    pub st: ExiStrings,
    pub strict: bool,
    pub ok: bool,
    pub error: str,
    // element stack
    pub f_type: Vec<i64>,     // schema type, -1 for a built-in grammar
    pub f_elem: Vec<i64>,     // element declaration (schema)
    pub f_ph: Vec<i64>,       // 0 start tag, 1 content, 2 after CH, 3 nil
    pub f_ai: Vec<i64>,       // next attribute
    pub f_j: Vec<i64>,        // particle
    pub f_c: Vec<i64>,        // occurrences of that particle so far
    pub f_fresh: Vec<bool>,   // no event yet in this element
    pub f_key: Vec<i64>,      // element QName number
    pub f_bg: Vec<i64>,       // built-in grammar
    pub f_bst: Vec<i64>,      // 0 StartTagContent, 1 ElementContent
    // built-in element grammars: learned productions, oldest first
    pub bg_key: Vec<i64>,
    pub bg_st_k: Vec<Vec<i64>>,   // kinds EXI_SE / EXI_AT / EXI_EE / EXI_CH
    pub bg_st_q: Vec<Vec<i64>>,   // QName numbers
    pub bg_ec_k: Vec<Vec<i64>>,
    pub bg_ec_q: Vec<Vec<i64>>,
    pub out: Vec<ExiEvent>,
}

fn exi_ctx(o: & ExiOptions, b: Vec<i64>) -> ExiCtx {
    return ExiCtx {
        w: exi_writer(), r: exi_reader(b), st: exi_strings(o.value_max_length, o.value_capacity), strict: o.strict, ok: true, error: "",
        f_type: Vec::new(), f_elem: Vec::new(), f_ph: Vec::new(), f_ai: Vec::new(), f_j: Vec::new(), f_c: Vec::new(), f_fresh: Vec::new(), f_key: Vec::new(), f_bg: Vec::new(), f_bst: Vec::new(),
        bg_key: Vec::new(), bg_st_k: Vec::new(), bg_st_q: Vec::new(), bg_ec_k: Vec::new(), bg_ec_q: Vec::new(),
        out: Vec::new(),
    };
}

fn exi_fail(c: & mut ExiCtx, why: str) {
    if c.ok {
        c.ok = false;
        c.error = why;
    }
}

fn exi_push_frame(c: & mut ExiCtx, ty: i64, elem: i64, key: i64, bg: i64) {
    c.f_type.push(ty);
    c.f_elem.push(elem);
    c.f_ph.push(0);
    c.f_ai.push(0);
    c.f_j.push(0);
    c.f_c.push(0);
    c.f_fresh.push(true);
    c.f_key.push(key);
    c.f_bg.push(bg);
    c.f_bst.push(0);
}

fn exi_pop_frame(c: & mut ExiCtx) {
    c.f_type.pop();
    c.f_elem.pop();
    c.f_ph.pop();
    c.f_ai.pop();
    c.f_j.pop();
    c.f_c.pop();
    c.f_fresh.pop();
    c.f_key.pop();
    c.f_bg.pop();
    c.f_bst.pop();
}

/// The productions of a schema-informed state, in event-code order.
pub struct ExiCands {
    pub kind: Vec<i64>,   // EXI_AT, EXI_SE, EXI_EE, EXI_CH; 5 AT(xsi:type), 6 AT(xsi:nil)
    pub a: Vec<i64>,      // AT: attribute position; SE: particle position
    pub b: Vec<i64>,      // SE: term position
    pub n: Vec<i64>,      // SE: occurrences after this one
}

fn exi_cand_add(cs: & mut ExiCands, kind: i64, a: i64, b: i64, n: i64) {
    cs.kind.push(kind);
    cs.a.push(a);
    cs.b.push(b);
    cs.n.push(n);
}

/// The productions of the top element's current state.
pub fn exi_cands(s: & ExiSchema, c: & ExiCtx) -> ExiCands {
    var cs: ExiCands = ExiCands { kind: Vec::new(), a: Vec::new(), b: Vec::new(), n: Vec::new() };
    val top: i64 = c.f_type.len() - 1;
    val t: i64 = c.f_type.get(top);
    val ph: i64 = c.f_ph.get(top);
    if ph == 3 {
        exi_cand_add(& mut cs, EXI_EE, 0, 0, 0);
        return cs;
    }
    if c.strict && c.f_fresh.get(top) {
        if s.ty_xsitype.get(t) {
            exi_cand_add(& mut cs, 5, 0, 0, 0);
        }
        if s.el_nil.get(c.f_elem.get(top)) {
            exi_cand_add(& mut cs, 6, 0, 0, 0);
        }
    }
    val attrs: Vec<i64> = s.ty_attrs.get(t);
    if ph == 0 {
        var i: i64 = c.f_ai.get(top);
        while i < attrs.len() {
            exi_cand_add(& mut cs, EXI_AT, i, 0, 0);
            if s.at_req.get(attrs.get(i)) {
                return cs;   // a required attribute comes first
            }
            i = i + 1;
        }
    }
    if s.ty_dt.get(t) >= 0 {
        if ph < 2 {
            exi_cand_add(& mut cs, EXI_CH, 0, 0, 0);
        } else {
            exi_cand_add(& mut cs, EXI_EE, 0, 0, 0);
        }
        return cs;
    }
    val parts: Vec<i64> = s.ty_parts.get(t);
    var wild: ExiCands = ExiCands { kind: Vec::new(), a: Vec::new(), b: Vec::new(), n: Vec::new() };
    var k: i64 = c.f_j.get(top);
    var cc: i64 = c.f_c.get(top);
    var at_end: bool = false;
    loop {
        if k >= parts.len() {
            at_end = true;
            break;
        }
        val p: i64 = parts.get(k);
        if s.pa_max.get(p) < 0 || cc < s.pa_max.get(p) {
            val alts: Vec<i64> = s.pa_alts.get(p);
            var x: i64 = 0;
            while x < alts.len() {
                if s.el_name.get(alts.get(x)) == "*" {
                    exi_cand_add(& mut wild, EXI_SE, k, x, cc + 1);
                } else {
                    exi_cand_add(& mut cs, EXI_SE, k, x, cc + 1);
                }
                x = x + 1;
            }
        }
        if cc >= s.pa_min.get(p) {
            k = k + 1;
            cc = 0;
        } else {
            break;
        }
    }
    var x: i64 = 0;
    while x < wild.kind.len() {
        exi_cand_add(& mut cs, EXI_SE, wild.a.get(x), wild.b.get(x), wild.n.get(x));
        x = x + 1;
    }
    if at_end {
        exi_cand_add(& mut cs, EXI_EE, 0, 0, 0);
    }
    return cs;
}

/// The element declaration of SE production i.
fn exi_cand_elem(s: & ExiSchema, c: & ExiCtx, cs: & ExiCands, i: i64) -> i64 {
    val t: i64 = c.f_type.get(c.f_type.len() - 1);
    val p: i64 = s.ty_parts.get(t).get(cs.a.get(i));
    return s.pa_alts.get(p).get(cs.b.get(i));
}

fn exi_cand_attr(s: & ExiSchema, c: & ExiCtx, cs: & ExiCands, i: i64) -> i64 {
    val t: i64 = c.f_type.get(c.f_type.len() - 1);
    return s.ty_attrs.get(t).get(cs.a.get(i));
}

fn exi_cands_text(s: & ExiSchema, c: & ExiCtx, cs: & ExiCands) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < cs.kind.len() {
        if i > 0 {
            out = out + ", ";
        }
        val k: i64 = cs.kind.get(i);
        if k == EXI_SE {
            out = out + "SE(" + s.el_name.get(exi_cand_elem(s, c, cs, i)) + ")";
        } else if k == EXI_AT {
            out = out + "AT(" + s.at_name.get(exi_cand_attr(s, c, cs, i)) + ")";
        } else if k == EXI_EE {
            out = out + "EE";
        } else if k == EXI_CH {
            out = out + "CH";
        } else if k == 5 {
            out = out + "AT(xsi:type)";
        } else {
            out = out + "AT(xsi:nil)";
        }
        i = i + 1;
    }
    return out;
}

fn exi_code_bits(c: & ExiCtx, n: i64) -> i64 {
    if c.strict {
        return exi_nbits(n);
    }
    return exi_nbits(n + 1);
}

/// Take production i: update the top frame (and push or pop one).
fn exi_apply(s: & ExiSchema, c: & mut ExiCtx, cs: & ExiCands, i: i64) {
    val top: i64 = c.f_type.len() - 1;
    val k: i64 = cs.kind.get(i);
    c.f_fresh.set(top, false);
    if k == EXI_AT {
        c.f_ai.set(top, cs.a.get(i) + 1);
    } else if k == EXI_CH {
        c.f_ph.set(top, 2);
    } else if k == EXI_EE {
        exi_pop_frame(c);
    } else if k == EXI_SE {
        c.f_ph.set(top, 1);
        c.f_j.set(top, cs.a.get(i));
        c.f_c.set(top, cs.n.get(i));
        val e: i64 = exi_cand_elem(s, c, cs, i);
        val key: i64 = exi_qid(& mut c.st, s.el_uri.get(e), s.el_name.get(e));
        exi_push_frame(c, s.el_type.get(e), e, key, - 1);
    }
}

// ─── Typed values ────────────────────────────────────────────────────────

fn exi_w_typed(s: & ExiSchema, c: & mut ExiCtx, dt: i64, key: i64, ev: & ExiEvent) {
    val kind: i64 = s.dt_kind.get(dt);
    if kind == EXI_DT_STRING {
        exi_w_value(& mut c.w, & mut c.st, key, ev.sval);
    } else if kind == EXI_DT_BINARY {
        exi_w_binary(& mut c.w, & ev.bval);
    } else if kind == EXI_DT_BOOLEAN {
        exi_w_bool(& mut c.w, ev.ival != 0);
    } else if kind == EXI_DT_UNSIGNED {
        if ev.ival < 0 {
            exi_fail(c, "negative value " + int_to_str(ev.ival) + " for an unsigned type");
            return;
        }
        exi_w_uint(& mut c.w, ev.ival);
    } else if kind == EXI_DT_INTEGER {
        exi_w_int(& mut c.w, ev.ival);
    } else if kind == EXI_DT_NBIT {
        val lo: i64 = s.dt_lo.get(dt);
        val hi: i64 = s.dt_hi.get(dt);
        if ev.ival < lo || ev.ival > hi {
            exi_fail(c, "value " + int_to_str(ev.ival) + " outside " + int_to_str(lo) + ".." + int_to_str(hi));
            return;
        }
        exi_w_nbit(& mut c.w, ev.ival - lo, exi_nbits(hi - lo + 1));
    } else if kind == EXI_DT_ENUM {
        var idx: i64 = ev.ival;
        if ev.sval != "" {
            idx = exi_enum_index(s, dt, ev.sval);
        }
        if idx < 0 || idx >= s.dt_count.get(dt) {
            exi_fail(c, "'" + ev.sval + "' is not a value of the enumeration");
            return;
        }
        exi_w_nbit(& mut c.w, idx, exi_nbits(s.dt_count.get(dt)));
    } else if kind == EXI_DT_LIST {
        val item: i64 = s.dt_item.get(dt);
        if s.dt_kind.get(item) == EXI_DT_STRING || (s.dt_kind.get(item) == EXI_DT_ENUM && ev.sval != "") {
            val words: Vec<str> = exi_words(ev.sval);
            exi_w_uint(& mut c.w, words.len());
            var i: i64 = 0;
            while i < words.len() {
                exi_w_typed(s, c, item, key, & exi_ch_str(words.get(i)));
                i = i + 1;
            }
        } else {
            exi_w_uint(& mut c.w, ev.bval.len());
            var i: i64 = 0;
            while i < ev.bval.len() {
                exi_w_typed(s, c, item, key, & exi_ch_int(ev.bval.get(i)));
                i = i + 1;
            }
        }
    }
}

fn exi_words(s: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    val parts: Vec<str> = str_split(s, " ");
    var i: i64 = 0;
    while i < parts.len() {
        if parts.get(i) != "" {
            out.push(parts.get(i));
        }
        i = i + 1;
    }
    return out;
}

fn exi_r_typed(s: & ExiSchema, c: & mut ExiCtx, dt: i64, key: i64, ev: & mut ExiEvent) {
    val kind: i64 = s.dt_kind.get(dt);
    if kind == EXI_DT_STRING {
        ev.sval = exi_r_value(& mut c.r, & mut c.st, key);
    } else if kind == EXI_DT_BINARY {
        ev.bval = exi_r_binary(& mut c.r);
    } else if kind == EXI_DT_BOOLEAN {
        if exi_r_bool(& mut c.r) {
            ev.ival = 1;
        }
    } else if kind == EXI_DT_UNSIGNED {
        ev.ival = exi_r_uint(& mut c.r);
    } else if kind == EXI_DT_INTEGER {
        ev.ival = exi_r_int(& mut c.r);
    } else if kind == EXI_DT_NBIT {
        val lo: i64 = s.dt_lo.get(dt);
        ev.ival = lo + exi_r_nbit(& mut c.r, exi_nbits(s.dt_hi.get(dt) - lo + 1));
    } else if kind == EXI_DT_ENUM {
        val idx: i64 = exi_r_nbit(& mut c.r, exi_nbits(s.dt_count.get(dt)));
        if idx >= s.dt_count.get(dt) {
            exi_r_fail(& mut c.r, "enumeration index " + int_to_str(idx) + " out of range");
            return;
        }
        ev.ival = idx;
        ev.sval = exi_enum_name(s, dt, idx);
    } else if kind == EXI_DT_LIST {
        val item: i64 = s.dt_item.get(dt);
        val n: i64 = exi_r_uint(& mut c.r);
        if n > c.r.b.len() * 8 - c.r.pos {
            exi_r_fail(& mut c.r, "list length too large");
            return;
        }
        val texty: bool = s.dt_kind.get(item) == EXI_DT_STRING || s.dt_kind.get(item) == EXI_DT_ENUM;
        var i: i64 = 0;
        while i < n && c.r.ok {
            var one: ExiEvent = exi_ch_int(0);
            exi_r_typed(s, c, item, key, & mut one);
            if texty {
                if i > 0 {
                    ev.sval = ev.sval + " ";
                }
                ev.sval = ev.sval + one.sval;
            }
            ev.bval.push(one.ival);
            i = i + 1;
        }
    }
}

// ─── Built-in element grammars (8.4.3) ───────────────────────────────────

fn exi_bg_find(c: & mut ExiCtx, key: i64) -> i64 {
    var i: i64 = 0;
    while i < c.bg_key.len() {
        if c.bg_key.get(i) == key {
            return i;
        }
        i = i + 1;
    }
    c.bg_key.push(key);
    c.bg_st_k.push(Vec::new());
    c.bg_st_q.push(Vec::new());
    c.bg_ec_k.push(Vec::new());
    c.bg_ec_q.push(Vec::new());
    return c.bg_key.len() - 1;
}

/// Learn a production at event code 0 of state `bst` of grammar g.
fn exi_bg_learn(c: & mut ExiCtx, g: i64, bst: i64, kind: i64, q: i64) {
    if bst == 0 {
        var ks: Vec<i64> = c.bg_st_k.get(g);
        var qs: Vec<i64> = c.bg_st_q.get(g);
        ks.push(kind);
        qs.push(q);
        c.bg_st_k.set(g, ks);
        c.bg_st_q.set(g, qs);
    } else {
        var ks: Vec<i64> = c.bg_ec_k.get(g);
        var qs: Vec<i64> = c.bg_ec_q.get(g);
        ks.push(kind);
        qs.push(q);
        c.bg_ec_k.set(g, ks);
        c.bg_ec_q.set(g, qs);
    }
}

/// The event code (first part) of a learned production, -1 if not learned.
fn exi_bg_lookup(c: & ExiCtx, g: i64, bst: i64, kind: i64, q: i64) -> i64 {
    var ks: Vec<i64> = c.bg_st_k.get(g);
    var qs: Vec<i64> = c.bg_st_q.get(g);
    if bst == 1 {
        ks = c.bg_ec_k.get(g);
        qs = c.bg_ec_q.get(g);
    }
    var i: i64 = 0;
    while i < ks.len() {
        if ks.get(i) == kind && (kind == EXI_EE || kind == EXI_CH || qs.get(i) == q) {
            return ks.len() - 1 - i;   // newest is event code 0
        }
        i = i + 1;
    }
    return - 1;
}

fn exi_bg_count(c: & ExiCtx, g: i64, bst: i64) -> i64 {
    if bst == 0 {
        return c.bg_st_k.get(g).len();
    }
    return c.bg_ec_k.get(g).len();
}

/// Write the event code of a built-in state: a learned production or one
/// of the fixed ones (StartTagContent k.0 EE, k.1 AT(*), k.2 SE(*), k.3 CH;
/// ElementContent k EE, (k+1).0 SE(*), (k+1).1 CH).
fn exi_bg_write(c: & mut ExiCtx, g: i64, bst: i64, kind: i64, q: i64) -> bool {
    val n: i64 = exi_bg_count(c, g, bst);
    val code: i64 = exi_bg_lookup(c, g, bst, kind, q);
    if code >= 0 {
        if bst == 0 {
            exi_w_nbit(& mut c.w, code, exi_nbits(n + 1));
        } else {
            exi_w_nbit(& mut c.w, code, exi_nbits(n + 2));
        }
        return true;
    }
    if bst == 0 {
        exi_w_nbit(& mut c.w, n, exi_nbits(n + 1));
        if kind == EXI_EE { exi_w_nbit(& mut c.w, 0, 2); }
        if kind == EXI_AT { exi_w_nbit(& mut c.w, 1, 2); }
        if kind == EXI_SE { exi_w_nbit(& mut c.w, 2, 2); }
        if kind == EXI_CH { exi_w_nbit(& mut c.w, 3, 2); }
    } else {
        if kind == EXI_EE {
            exi_w_nbit(& mut c.w, n, exi_nbits(n + 2));
            return true;
        }
        if kind == EXI_AT {
            exi_fail(c, "attribute after content");
            return false;
        }
        exi_w_nbit(& mut c.w, n + 1, exi_nbits(n + 2));
        if kind == EXI_SE { exi_w_nbit(& mut c.w, 0, 1); }
        if kind == EXI_CH { exi_w_nbit(& mut c.w, 1, 1); }
    }
    return false;
}

fn exi_bg_enc(c: & mut ExiCtx, ev: & ExiEvent) {
    val top: i64 = c.f_bg.len() - 1;
    val g: i64 = c.f_bg.get(top);
    val bst: i64 = c.f_bst.get(top);
    var q: i64 = - 1;
    if ev.kind == EXI_SE || ev.kind == EXI_AT {
        q = exi_qid(& mut c.st, ev.uri, ev.name);
    }
    val learned: bool = exi_bg_write(c, g, bst, ev.kind, q);
    if !c.ok {
        return;
    }
    if ev.kind == EXI_SE || ev.kind == EXI_AT {
        if !learned {
            exi_w_qname(& mut c.w, & mut c.st, ev.uri, ev.name);
        }
    }
    if !learned && !(ev.kind == EXI_EE && bst == 1) {
        exi_bg_learn(c, g, bst, ev.kind, q);
    }
    if ev.kind == EXI_AT {
        exi_w_value(& mut c.w, & mut c.st, q, ev.sval);
    } else if ev.kind == EXI_CH {
        exi_w_value(& mut c.w, & mut c.st, c.f_key.get(top), ev.sval);
        c.f_bst.set(top, 1);
    } else if ev.kind == EXI_SE {
        c.f_bst.set(top, 1);
        exi_push_frame(c, - 1, - 1, q, exi_bg_find(c, q));
    } else if ev.kind == EXI_EE {
        exi_pop_frame(c);
    }
}

fn exi_bg_dec(c: & mut ExiCtx) {
    val top: i64 = c.f_bg.len() - 1;
    val g: i64 = c.f_bg.get(top);
    val bst: i64 = c.f_bst.get(top);
    val n: i64 = exi_bg_count(c, g, bst);
    var kind: i64 = 0;
    var q: i64 = - 1;
    var learned: bool = false;
    if bst == 0 {
        val code: i64 = exi_r_nbit(& mut c.r, exi_nbits(n + 1));
        if code < n {
            learned = true;
            kind = c.bg_st_k.get(g).get(n - 1 - code);
            q = c.bg_st_q.get(g).get(n - 1 - code);
        } else {
            val sub: i64 = exi_r_nbit(& mut c.r, 2);
            if sub == 0 { kind = EXI_EE; }
            if sub == 1 { kind = EXI_AT; }
            if sub == 2 { kind = EXI_SE; }
            if sub == 3 { kind = EXI_CH; }
        }
    } else {
        val code: i64 = exi_r_nbit(& mut c.r, exi_nbits(n + 2));
        if code < n {
            learned = true;
            kind = c.bg_ec_k.get(g).get(n - 1 - code);
            q = c.bg_ec_q.get(g).get(n - 1 - code);
        } else if code == n {
            kind = EXI_EE;
            learned = true;   // ElementContent's EE is never learned
        } else if code == n + 1 {
            if exi_r_nbit(& mut c.r, 1) == 0 {
                kind = EXI_SE;
            } else {
                kind = EXI_CH;
            }
        } else {
            exi_r_fail(& mut c.r, "bad event code");
            return;
        }
    }
    if !c.r.ok {
        return;
    }
    if (kind == EXI_SE || kind == EXI_AT) && !learned {
        q = exi_r_qname(& mut c.r, & mut c.st);
    }
    if !learned {
        exi_bg_learn(c, g, bst, kind, q);
    }
    var ev: ExiEvent = exi_ev(kind, "", "");
    if q >= 0 {
        ev.uri = c.st.qn_uri.get(q);
        ev.name = c.st.qn_name.get(q);
    }
    if kind == EXI_AT {
        ev.sval = exi_r_value(& mut c.r, & mut c.st, q);
    } else if kind == EXI_CH {
        ev.sval = exi_r_value(& mut c.r, & mut c.st, c.f_key.get(top));
        c.f_bst.set(top, 1);
    } else if kind == EXI_SE {
        c.f_bst.set(top, 1);
    }
    c.out.push(ev);
    if kind == EXI_SE {
        exi_push_frame(c, - 1, - 1, q, exi_bg_find(c, q));
    } else if kind == EXI_EE {
        exi_pop_frame(c);
    }
}

// ─── Encoder ─────────────────────────────────────────────────────────────

pub struct ExiResult {
    pub ok: bool,
    pub error: str,
    pub bytes: Vec<i64>,
}

fn exi_ev_text(e: & ExiEvent) -> str {
    if e.kind == EXI_SE { return "SE(" + e.name + ")"; }
    if e.kind == EXI_AT { return "AT(" + e.name + ")"; }
    if e.kind == EXI_CH { return "CH"; }
    return "EE";
}

/// Encode one event of a schema-informed element.
fn exi_si_enc(s: & ExiSchema, c: & mut ExiCtx, ev: & ExiEvent) {
    val top: i64 = c.f_type.len() - 1;
    val t: i64 = c.f_type.get(top);
    if !s.ty_ok.get(t) {
        exi_fail(c, "no grammar for the content of " + c.st.qn_name.get(c.f_key.get(top)));
        return;
    }
    val cs: ExiCands = exi_cands(s, c);
    var found: i64 = - 1;
    var i: i64 = 0;
    while i < cs.kind.len() && found < 0 {
        val k: i64 = cs.kind.get(i);
        if k == ev.kind && (k == EXI_EE || k == EXI_CH) {
            found = i;
        } else if k == EXI_SE && ev.kind == EXI_SE {
            val e: i64 = exi_cand_elem(s, c, & cs, i);
            if s.el_name.get(e) == ev.name && s.el_uri.get(e) == ev.uri {
                found = i;
            }
        } else if k == EXI_AT && ev.kind == EXI_AT {
            val a: i64 = exi_cand_attr(s, c, & cs, i);
            if s.at_name.get(a) == ev.name && s.at_uri.get(a) == ev.uri {
                found = i;
            }
        } else if k == 6 && ev.kind == EXI_AT && ev.uri == EXI_XSI && ev.name == "nil" {
            found = i;
        }
        i = i + 1;
    }
    if found < 0 {
        exi_fail(c, exi_ev_text(ev) + " is not allowed in " + c.st.qn_name.get(c.f_key.get(top)) + " here (expected " + exi_cands_text(s, c, & cs) + ")");
        return;
    }
    exi_w_nbit(& mut c.w, found, exi_code_bits(c, cs.kind.len()));
    val k: i64 = cs.kind.get(found);
    if k == EXI_AT {
        val a: i64 = exi_cand_attr(s, c, & cs, found);
        exi_apply(s, c, & cs, found);
        exi_w_typed(s, c, s.at_dt.get(a), exi_qid(& mut c.st, s.at_uri.get(a), s.at_name.get(a)), ev);
    } else if k == EXI_CH {
        val dt: i64 = s.ty_dt.get(t);
        exi_apply(s, c, & cs, found);
        exi_w_typed(s, c, dt, c.f_key.get(top), ev);
    } else if k == 6 {
        exi_w_bool(& mut c.w, ev.ival != 0);
        c.f_fresh.set(top, false);
        if ev.ival != 0 {
            c.f_ph.set(top, 3);
        }
    } else {
        exi_apply(s, c, & cs, found);
    }
}

/// Write the header: cookie, distinguishing bits, presence bit, version,
/// options document; then padding for a byte-aligned body.
fn exi_enc_header(c: & mut ExiCtx, o: & ExiOptions) {
    if o.cookie {
        exi_w_raw(& mut c.w, 36, 8);
        exi_w_raw(& mut c.w, 69, 8);
        exi_w_raw(& mut c.w, 88, 8);
        exi_w_raw(& mut c.w, 73, 8);
    }
    exi_w_raw(& mut c.w, 2, 2);
    if o.in_header {
        exi_w_raw(& mut c.w, 1, 1);
    } else {
        exi_w_raw(& mut c.w, 0, 1);
    }
    exi_w_raw(& mut c.w, 0, 5);      // final version, 1 (0000)
    if o.in_header {
        val os: ExiSchema = exi_options_schema();
        var ho: ExiOptions = exi_options();
        ho.strict = true;
        var hc: ExiCtx = exi_ctx(& ho, Vec::new());
        exi_enc_body(& os, & mut hc, & exi_options_events(o), false);
        if !hc.ok {
            exi_fail(c, "options: " + hc.error);
            return;
        }
        exi_w_append(& mut c.w, & hc.w);
    }
    if o.alignment != EXI_BIT_PACKED || o.compression {
        exi_w_align(& mut c.w);
    }
}

fn exi_enc_body(s: & ExiSchema, c: & mut ExiCtx, evs: & Vec<ExiEvent>, fragment: bool) {
    var i: i64 = 0;
    while i < evs.len() && c.ok {
        val ev: ExiEvent = evs.get(i);
        if c.f_type.len() == 0 {
            // document / fragment content
            if ev.kind != EXI_SE {
                exi_fail(c, exi_ev_text(& ev) + " outside the root element");
                return;
            }
            if c.out.len() > 0 && !fragment {
                exi_fail(c, "a second root element");
                return;
            }
            c.out.push(ev);   // marks "root seen"
            val q: i64 = exi_qid(& mut c.st, ev.uri, ev.name);
            if s.informed {
                if fragment {
                    exi_fail(c, "fragments with schema-informed grammars are not supported");
                    return;
                }
                var g: i64 = - 1;
                var k: i64 = 0;
                while k < s.globals.len() {
                    val e: i64 = s.globals.get(k);
                    if s.el_name.get(e) == ev.name && s.el_uri.get(e) == ev.uri {
                        g = k;
                    }
                    k = k + 1;
                }
                if g < 0 {
                    exi_fail(c, ev.name + " is not a global element of the schema");
                    return;
                }
                exi_w_nbit(& mut c.w, s.gpos.get(g), exi_code_bits(c, s.nglobals));
                val e: i64 = s.globals.get(g);
                exi_push_frame(c, s.el_type.get(e), e, q, - 1);
            } else {
                if fragment {
                    exi_w_nbit(& mut c.w, 0, 1);   // SE(*) of FragmentContent
                }
                exi_w_qname(& mut c.w, & mut c.st, ev.uri, ev.name);
                exi_push_frame(c, - 1, - 1, q, exi_bg_find(c, q));
            }
        } else if c.f_bg.get(c.f_bg.len() - 1) >= 0 {
            exi_bg_enc(c, & ev);
        } else {
            exi_si_enc(s, c, & ev);
        }
        i = i + 1;
    }
    if !c.ok {
        return;
    }
    if c.f_type.len() != 0 {
        exi_fail(c, "events end inside an element");
        return;
    }
    if c.out.len() == 0 {
        exi_fail(c, "no root element");
        return;
    }
    if fragment {
        exi_w_nbit(& mut c.w, 1, 1);   // ED of FragmentContent
    }
    // DocEnd: ED is the only production (0 bits)
}

/// Encode a document (or fragment, with o.fragment) of events.
pub fn exi_encode(s: & ExiSchema, o: & ExiOptions, evs: & Vec<ExiEvent>) -> ExiResult {
    var c: ExiCtx = exi_ctx(o, Vec::new());
    val why: str = exi_options_unsupported(o);
    if why != "" {
        return ExiResult { ok: false, error: why, bytes: Vec::new() };
    }
    exi_enc_header(& mut c, o);
    c.w.aligned = o.alignment == EXI_BYTE_ALIGNED;
    if c.ok {
        exi_enc_body(s, & mut c, evs, o.fragment);
    }
    if !c.ok {
        return ExiResult { ok: false, error: c.error, bytes: Vec::new() };
    }
    return ExiResult { ok: true, error: "", bytes: exi_w_bytes(& c.w) };
}

// ─── Decoder ─────────────────────────────────────────────────────────────

pub struct ExiDoc {
    pub ok: bool,
    pub error: str,
    pub events: Vec<ExiEvent>,
    pub options: ExiOptions,
    pub bits: i64,             // bits consumed, header included
}

fn exi_si_dec(s: & ExiSchema, c: & mut ExiCtx) {
    val top: i64 = c.f_type.len() - 1;
    val t: i64 = c.f_type.get(top);
    if !s.ty_ok.get(t) {
        exi_r_fail(& mut c.r, "no grammar for the content of " + c.st.qn_name.get(c.f_key.get(top)));
        return;
    }
    val cs: ExiCands = exi_cands(s, c);
    val code: i64 = exi_r_nbit(& mut c.r, exi_code_bits(c, cs.kind.len()));
    if !c.r.ok {
        return;
    }
    if code >= cs.kind.len() {
        exi_r_fail(& mut c.r, "undeclared production (escape code) in " + c.st.qn_name.get(c.f_key.get(top)) + " is not supported");
        return;
    }
    val k: i64 = cs.kind.get(code);
    if k == EXI_AT {
        val a: i64 = exi_cand_attr(s, c, & cs, code);
        exi_apply(s, c, & cs, code);
        var ev: ExiEvent = exi_ev(EXI_AT, s.at_uri.get(a), s.at_name.get(a));
        exi_r_typed(s, c, s.at_dt.get(a), exi_qid(& mut c.st, s.at_uri.get(a), s.at_name.get(a)), & mut ev);
        c.out.push(ev);
    } else if k == EXI_CH {
        val dt: i64 = s.ty_dt.get(t);
        exi_apply(s, c, & cs, code);
        var ev: ExiEvent = exi_ev(EXI_CH, "", "");
        exi_r_typed(s, c, dt, c.f_key.get(top), & mut ev);
        c.out.push(ev);
    } else if k == EXI_SE {
        val e: i64 = exi_cand_elem(s, c, & cs, code);
        if s.el_name.get(e) == "*" {
            exi_r_fail(& mut c.r, "wildcard content is not supported");
            return;
        }
        exi_apply(s, c, & cs, code);
        c.out.push(exi_se(s.el_uri.get(e), s.el_name.get(e)));
    } else if k == EXI_EE {
        exi_apply(s, c, & cs, code);
        c.out.push(exi_ee());
    } else if k == 6 {
        val isnil: bool = exi_r_bool(& mut c.r);
        c.f_fresh.set(top, false);
        var ev: ExiEvent = exi_ev(EXI_AT, EXI_XSI, "nil");
        if isnil {
            ev.ival = 1;
            c.f_ph.set(top, 3);
        }
        c.out.push(ev);
    } else {
        exi_r_fail(& mut c.r, "xsi:type is not supported");
    }
}

fn exi_dec_body(s: & ExiSchema, c: & mut ExiCtx, fragment: bool) {
    var roots: i64 = 0;
    loop {
        if !c.r.ok {
            return;
        }
        if c.f_type.len() == 0 {
            if roots > 0 && !fragment {
                return;   // DocEnd: ED (0 bits)
            }
            if s.informed {
                if fragment {
                    exi_r_fail(& mut c.r, "fragments with schema-informed grammars are not supported");
                    return;
                }
                val code: i64 = exi_r_nbit(& mut c.r, exi_code_bits(c, s.nglobals));
                var g: i64 = - 1;
                var k: i64 = 0;
                while k < s.gpos.len() {
                    if s.gpos.get(k) == code {
                        g = k;
                    }
                    k = k + 1;
                }
                if g < 0 {
                    exi_r_fail(& mut c.r, "global element " + int_to_str(code) + " has no grammar here");
                    return;
                }
                val e: i64 = s.globals.get(g);
                c.out.push(exi_se(s.el_uri.get(e), s.el_name.get(e)));
                exi_push_frame(c, s.el_type.get(e), e, exi_qid(& mut c.st, s.el_uri.get(e), s.el_name.get(e)), - 1);
            } else {
                if fragment {
                    if exi_r_nbit(& mut c.r, 1) == 1 {
                        return;   // ED
                    }
                }
                val q: i64 = exi_r_qname(& mut c.r, & mut c.st);
                c.out.push(exi_se(c.st.qn_uri.get(q), c.st.qn_name.get(q)));
                exi_push_frame(c, - 1, - 1, q, exi_bg_find(c, q));
            }
            roots = roots + 1;
        } else if c.f_bg.get(c.f_bg.len() - 1) >= 0 {
            exi_bg_dec(c);
        } else {
            exi_si_dec(s, c);
        }
    }
}

/// Read the header; options found there replace `o`.
fn exi_dec_header(c: & mut ExiCtx, o: & ExiOptions) -> ExiOptions {
    var opts: ExiOptions = exi_options_copy(o);
    opts.in_header = false;
    if c.r.b.len() >= 4 && c.r.b.get(0) == 36 {
        if c.r.b.get(1) != 69 || c.r.b.get(2) != 88 || c.r.b.get(3) != 73 {
            exi_r_fail(& mut c.r, "bad EXI cookie");
            return opts;
        }
        c.r.pos = 32;
        opts.cookie = true;
    }
    if exi_r_raw(& mut c.r, 2) != 2 {
        exi_r_fail(& mut c.r, "not an EXI stream (distinguishing bits)");
        return opts;
    }
    val present: bool = exi_r_raw(& mut c.r, 1) == 1;
    val preview: i64 = exi_r_raw(& mut c.r, 1);
    var version: i64 = 1;
    loop {
        val part: i64 = exi_r_raw(& mut c.r, 4);
        version = version + part;
        if part != 15 || !c.r.ok {
            break;
        }
    }
    if preview != 0 || version != 1 {
        exi_r_fail(& mut c.r, "unsupported EXI version " + int_to_str(version));
        return opts;
    }
    if present {
        val os: ExiSchema = exi_options_schema();
        var ho: ExiOptions = exi_options();
        ho.strict = true;
        var hc: ExiCtx = exi_ctx(& ho, c.r.b);
        hc.r.pos = c.r.pos;
        exi_dec_body(& os, & mut hc, false);
        if !hc.r.ok {
            exi_r_fail(& mut c.r, "options: " + hc.r.error);
            return opts;
        }
        c.r.pos = hc.r.pos;
        val cookie: bool = opts.cookie;
        opts = exi_options_from(& hc.out);
        opts.cookie = cookie;
    }
    if opts.alignment != EXI_BIT_PACKED || opts.compression {
        exi_r_align(& mut c.r);
    }
    return opts;
}

/// Decode an EXI stream; `o` gives the options when the header has none.
pub fn exi_decode(s: & ExiSchema, o: & ExiOptions, b: Vec<i64>) -> ExiDoc {
    var c: ExiCtx = exi_ctx(o, b);
    val opts: ExiOptions = exi_dec_header(& mut c, o);
    val why: str = exi_options_unsupported(& opts);
    if c.r.ok && why != "" {
        exi_r_fail(& mut c.r, why);
    }
    if c.r.ok {
        c.strict = opts.strict;
        c.st = exi_strings(opts.value_max_length, opts.value_capacity);
        c.r.aligned = opts.alignment == EXI_BYTE_ALIGNED;
        exi_dec_body(s, & mut c, opts.fragment);
    }
    if !c.r.ok {
        return ExiDoc { ok: false, error: c.r.error, events: c.out, options: opts, bits: c.r.pos };
    }
    return ExiDoc { ok: true, error: "", events: c.out, options: opts, bits: c.r.pos };
}

// ─── Reading decoded documents ───────────────────────────────────────────

/// Index of the SE event of the `nth` (from 0) element at `path` (local
/// names from the root, separated by "/"); -1 if there is none.
pub fn exi_find_nth(evs: & Vec<ExiEvent>, path: str, nth: i64) -> i64 {
    var stack: Vec<str> = Vec::new();
    var seen: i64 = 0;
    var i: i64 = 0;
    while i < evs.len() {
        val e: ExiEvent = evs.get(i);
        if e.kind == EXI_SE {
            stack.push(e.name);
            if str_join(stack, "/") == path {
                if seen == nth {
                    return i;
                }
                seen = seen + 1;
            }
        } else if e.kind == EXI_EE {
            stack.pop();
        }
        i = i + 1;
    }
    return - 1;
}

pub fn exi_find(evs: & Vec<ExiEvent>, path: str) -> i64 {
    return exi_find_nth(evs, path, 0);
}

pub fn exi_count(evs: & Vec<ExiEvent>, path: str) -> i64 {
    var n: i64 = 0;
    while exi_find_nth(evs, path, n) >= 0 {
        n = n + 1;
    }
    return n;
}

/// The CH event of the element whose SE is at `se` (an empty CH if none).
pub fn exi_value_of(evs: & Vec<ExiEvent>, se: i64) -> ExiEvent {
    var i: i64 = se + 1;
    while i >= 1 && i < evs.len() && evs.get(i).kind == EXI_AT {
        i = i + 1;
    }
    if se >= 0 && i < evs.len() && evs.get(i).kind == EXI_CH {
        return evs.get(i);
    }
    return exi_ev(EXI_CH, "", "");
}

pub fn exi_get(evs: & Vec<ExiEvent>, path: str) -> ExiEvent {
    return exi_value_of(evs, exi_find(evs, path));
}

pub fn exi_has(evs: & Vec<ExiEvent>, path: str) -> bool {
    return exi_find(evs, path) >= 0;
}

/// The value of attribute `name` of the element whose SE is at `se`.
pub fn exi_attr_of(evs: & Vec<ExiEvent>, se: i64, name: str) -> ExiEvent {
    var i: i64 = se + 1;
    while se >= 0 && i < evs.len() && evs.get(i).kind == EXI_AT {
        if evs.get(i).name == name {
            return evs.get(i);
        }
        i = i + 1;
    }
    return exi_ev(EXI_AT, "", "");
}

/// A readable line per event (indented by depth), for logs and tests.
pub fn exi_events_text(evs: & Vec<ExiEvent>) -> str {
    var out: str = "";
    var depth: i64 = 0;
    var i: i64 = 0;
    while i < evs.len() {
        val e: ExiEvent = evs.get(i);
        if e.kind == EXI_EE {
            depth = depth - 1;
        } else {
            out = out + str_repeat("  ", depth);
            if e.kind == EXI_SE {
                out = out + "SE " + e.name + "\n";
                depth = depth + 1;
            } else if e.kind == EXI_AT {
                out = out + "AT " + e.name + "=" + e.sval + int_to_str(e.ival) + "\n";
            } else {
                out = out + "CH " + e.sval + " " + int_to_str(e.ival) + " [" + int_to_str(e.bval.len()) + "]\n";
            }
        }
        i = i + 1;
    }
    return out;
}
