// Fides in-app purchases: products, transactions, the purchase state
// machine, App Store Server API and Google Play shapes
//
// What is real (pure Fides, tested in the interpreter):
//   - products (consumable, non-consumable, auto-renewable, non-renewing)
//     with prices in micros formatted per currency exponent, and ISO 8601
//     subscription periods (P1W, P1M, P1Y ...) added to dates with
//     month-end clamping
//   - the purchase state machine: purchasing, pending (Ask to Buy, Play
//     PENDING), purchased, verified, delivered, finished / acknowledged /
//     consumed, failed, canceled, refunded; illegal steps are refused, and
//     the Play rule that an unacknowledged purchase is refunded after three
//     days
//   - App Store Server API: the request URLs (production / sandbox), the
//     API token claims (ES256 JWT with aud appstoreconnect-v1), decoding
//     a JWS transaction (JWSTransactionDecodedPayload fields) and a server
//     notification V2 (notificationType, subtype, signedTransactionInfo),
//     the legacy verifyReceipt status codes and latest_receipt_info fields
//   - Google Play Developer API: purchases.products / subscriptionsv2 URLs,
//     acknowledge / consume endpoints, ProductPurchase and
//     SubscriptionPurchaseV2 fields (RFC 3339 expiry times to epoch ms)
//   - subscription status from the latest transaction: active, grace
//     period, billing retry, expired, revoked
//
// The seams: every signature check is a function value. JWS (ES256 with
// the x5c chain to Apple's root) is fn(str, str, Vec<i64>) -> bool over
// (header b64url, payload b64url, signature bytes); the API token signer
// is fn(Vec<i64>) -> Vec<i64>; Play's local purchase signature (RSA
// SHA1withRSA over the purchase JSON) is fn(str, str) -> bool. Sending the
// HTTPS requests is the caller's (http_client, https). The store UIs are
// reached through jni.fd (BillingClient) and objc.fd / Swift (StoreKit 2).

module iap;
use vec;
use string;
use encoding;
use json;

// ─── Products and prices ───────────────────────────────────────────────

pub const IAP_CONSUMABLE: i64 = 0;
pub const IAP_NON_CONSUMABLE: i64 = 1;
pub const IAP_AUTO_RENEWABLE: i64 = 2;
pub const IAP_NON_RENEWING: i64 = 3;

pub struct IapProduct {
    pub id: str,
    pub kind: i64,
    pub price_micros: i64,  // 4990000 = 4.99
    pub currency: str,  // ISO 4217
    pub period: str,  // ISO 8601 for subscriptions, "" otherwise
    pub intro_period: str,  // free trial / intro offer length, "" none
}

/// Digits after the decimal point of a currency (ISO 4217 minor unit).
pub fn iap_currency_exponent(cur: str) -> i64 {
    val zero: str = ",JPY,KRW,VND,CLP,ISK,UGX,XAF,XOF,PYG,HUF,TWD,IDR,";
    val three: str = ",KWD,BHD,OMR,JOD,TND,LYD,IQD,";
    if str_contains(zero, "," + cur + ",") {
        return 0;
    }
    if str_contains(three, "," + cur + ",") {
        return 3;
    }
    return 2;
}

/// "4.99 USD", "500 JPY", "1.250 KWD" (rounded half up to the exponent).
pub fn iap_format_price(micros: i64, cur: str) -> str {
    val e: i64 = iap_currency_exponent(cur);
    var div: i64 = 1000000;
    var k: i64 = 0;
    while k < e {
        div = div / 10;
        k = k + 1;
    }
    val neg: bool = micros < 0;
    val m: i64 = if neg {
        0 - micros
    } else {
        micros
    };
    val units: i64 = (m + div / 2) / div;  // in minor units
    var scale: i64 = 1;
    k = 0;
    while k < e {
        scale = scale * 10;
        k = k + 1;
    }
    var s: str = int_to_str(units / scale);
    if e > 0 {
        var f: str = int_to_str(units % scale);
        while str_len(f) < e {
            f = "0" + f;
        }
        s = s + "." + f;
    }
    if neg {
        s = "-" + s;
    }
    return s + " " + cur;
}

// ─── Dates ─────────────────────────────────────────────────────────────

/// Days since 1970-01-01 of a civil date (proleptic Gregorian).
pub fn iap_days_from_civil(y: i64, m: i64, d: i64) -> i64 {
    val yy: i64 = if m <= 2 {
        y - 1
    } else {
        y
    };
    val era: i64 = (if yy >= 0 {
        yy
    } else {
        yy - 399
    }) / 400;
    val yoe: i64 = yy - era * 400;
    val mp: i64 = if m > 2 {
        m - 3
    } else {
        m + 9
    };
    val doy: i64 = (153 * mp + 2) / 5 + d - 1;
    val doe: i64 = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

/// The civil date [y, m, d] of a day number.
pub fn iap_civil_from_days(z0: i64) -> Vec<i64> {
    val z: i64 = z0 + 719468;
    val era: i64 = (if z >= 0 {
        z
    } else {
        z - 146096
    }) / 146097;
    val doe: i64 = z - era * 146097;
    val yoe: i64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    val doy: i64 = doe - (365 * yoe + yoe / 4 - yoe / 100);
    val mp: i64 = (5 * doy + 2) / 153;
    val d: i64 = doy - (153 * mp + 2) / 5 + 1;
    val m: i64 = if mp < 10 {
        mp + 3
    } else {
        mp - 9
    };
    var out: Vec<i64> = Vec::new();
    out.push(if m <= 2 {
        yoe + era * 400 + 1
    } else {
        yoe + era * 400
    });
    out.push(m);
    out.push(d);
    return out;
}

fn iap_month_days(y: i64, m: i64) -> i64 {
    if m == 2 {
        if (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 {
            return 29;
        }
        return 28;
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        return 30;
    }
    return 31;
}

/// An ISO 8601 period "PnYnMnWnD" as [years, months, days]; empty when
/// malformed.
pub fn iap_parse_period(p: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if str_len(p) < 3 || str_byte_at(p, 0) != 80 {
        return out;
    }
    var y: i64 = 0;
    var mo: i64 = 0;
    var d: i64 = 0;
    var num: i64 = -1;
    var i: i64 = 1;
    while i < str_len(p) {
        val c: i64 = str_byte_at(p, i);
        if char_is_digit(c) {
            num = (if num < 0 {
                0
            } else {
                num
            }) * 10 + c - 48;
        } else {
            if num < 0 {
                return out;
            }
            if c == 89 {
                y = y + num;
            } else if c == 77 {
                mo = mo + num;
            } else if c == 87 {
                d = d + 7 * num;
            } else if c == 68 {
                d = d + num;
            } else {
                return out;
            }
            num = -1;
        }
        i = i + 1;
    }
    if num >= 0 {
        return out;
    }
    out.push(y);
    out.push(mo);
    out.push(d);
    return out;
}

/// `ms` (UTC epoch) plus a period; a day past the end of the target
/// month is clamped (Jan 31 + P1M = Feb 28/29). -1 when malformed.
pub fn iap_add_period(ms: i64, period: str) -> i64 {
    val p: Vec<i64> = iap_parse_period(period);
    if p.len() == 0 {
        return -1;
    }
    val day: i64 = if ms >= 0 {
        ms / 86400000
    } else {
        (ms - 86399999) / 86400000
    };
    val tod: i64 = ms - day * 86400000;
    val c: Vec<i64> = iap_civil_from_days(day);
    var y: i64 = c.get(0) + p.get(0);
    var m: i64 = c.get(1) + p.get(1);
    while m > 12 {
        m = m - 12;
        y = y + 1;
    }
    var d: i64 = c.get(2);
    val md: i64 = iap_month_days(y, m);
    if d > md {
        d = md;
    }
    return (iap_days_from_civil(y, m, d) + p.get(2)) * 86400000 + tod;
}

/// RFC 3339 "2024-05-01T12:00:00.000Z" (or with +hh:mm) -> epoch ms;
/// -1 when malformed.
pub fn iap_parse_rfc3339(s: str) -> i64 {
    if str_len(s) < 20 || str_byte_at(s, 4) != 45 || str_byte_at(s, 7) != 45 || str_byte_at(s, 13) != 58 {
        return -1;
    }
    val y: i64 = str_parse_int(str_slice(s, 0, 4));
    val mo: i64 = str_parse_int(str_slice(s, 5, 7));
    val d: i64 = str_parse_int(str_slice(s, 8, 10));
    val h: i64 = str_parse_int(str_slice(s, 11, 13));
    val mi: i64 = str_parse_int(str_slice(s, 14, 16));
    val se: i64 = str_parse_int(str_slice(s, 17, 19));
    var i: i64 = 19;
    var ms: i64 = 0;
    if str_byte_at(s, i) == 46 {
        i = i + 1;
        var digits: i64 = 0;
        while i < str_len(s) && char_is_digit(str_byte_at(s, i)) {
            if digits < 3 {
                ms = ms * 10 + str_byte_at(s, i) - 48;
            }
            digits = digits + 1;
            i = i + 1;
        }
        while digits < 3 {
            ms = ms * 10;
            digits = digits + 1;
        }
    }
    var off: i64 = 0;
    if i < str_len(s) && (str_byte_at(s, i) == 43 || str_byte_at(s, i) == 45) && i + 6 <= str_len(s) {
        val oh: i64 = str_parse_int(str_slice(s, i + 1, i + 3));
        val om: i64 = str_parse_int(str_slice(s, i + 4, i + 6));
        off = (oh * 60 + om) * 60000;
        if str_byte_at(s, i) == 45 {
            off = 0 - off;
        }
    } else if i >= str_len(s) || str_byte_at(s, i) != 90 {
        return -1;
    }
    if mo < 1 || mo > 12 || d < 1 || d > iap_month_days(y, mo) {
        return -1;
    }
    return ((iap_days_from_civil(y, mo, d) * 24 + h) * 60 + mi) * 60000 + se * 1000 + ms - off;
}

// ─── The purchase state machine ────────────────────────────────────────

pub const IAP_IDLE: i64 = 0;
pub const IAP_PURCHASING: i64 = 1;
pub const IAP_PENDING: i64 = 2;
pub const IAP_PURCHASED: i64 = 3;
pub const IAP_VERIFIED: i64 = 4;
pub const IAP_DELIVERED: i64 = 5;
pub const IAP_FINISHED: i64 = 6;  // StoreKit finish() / Play acknowledge / consume
pub const IAP_FAILED: i64 = 7;
pub const IAP_CANCELED: i64 = 8;
pub const IAP_REFUNDED: i64 = 9;

pub const IAP_EV_BUY: i64 = 0;
pub const IAP_EV_DEFERRED: i64 = 1;
pub const IAP_EV_STORE_OK: i64 = 2;
pub const IAP_EV_STORE_FAILED: i64 = 3;
pub const IAP_EV_USER_CANCELED: i64 = 4;
pub const IAP_EV_VERIFY_OK: i64 = 5;
pub const IAP_EV_VERIFY_FAILED: i64 = 6;
pub const IAP_EV_DELIVER: i64 = 7;
pub const IAP_EV_FINISH: i64 = 8;
pub const IAP_EV_REFUND: i64 = 9;

pub const IAP_PLAY_ACK_WINDOW_MS: i64 = 259200000;  // 3 days

pub fn iap_state_name(s: i64) -> str {
    val n: Vec<str> = str_split("idle,purchasing,pending,purchased,verified,delivered,finished,failed,canceled,refunded", ",");
    if s < 0 || s >= n.len() {
        return "?";
    }
    return n.get(s);
}

/// The next state, or -1 when the event is not allowed in `s`.
pub fn iap_next(s: i64, ev: i64) -> i64 {
    if ev == IAP_EV_REFUND {
        if s == IAP_PURCHASED || s == IAP_VERIFIED || s == IAP_DELIVERED || s == IAP_FINISHED {
            return IAP_REFUNDED;
        }
        return -1;
    }
    if s == IAP_IDLE || s == IAP_FAILED || s == IAP_CANCELED {
        if ev == IAP_EV_BUY {
            return IAP_PURCHASING;
        }
        return -1;
    }
    if s == IAP_PURCHASING {
        if ev == IAP_EV_DEFERRED {
            return IAP_PENDING;
        }
        if ev == IAP_EV_STORE_OK {
            return IAP_PURCHASED;
        }
        if ev == IAP_EV_STORE_FAILED {
            return IAP_FAILED;
        }
        if ev == IAP_EV_USER_CANCELED {
            return IAP_CANCELED;
        }
        return -1;
    }
    if s == IAP_PENDING {
        if ev == IAP_EV_STORE_OK {
            return IAP_PURCHASED;
        }
        if ev == IAP_EV_STORE_FAILED {
            return IAP_FAILED;
        }
        return -1;
    }
    if s == IAP_PURCHASED {
        if ev == IAP_EV_VERIFY_OK {
            return IAP_VERIFIED;
        }
        if ev == IAP_EV_VERIFY_FAILED {
            return IAP_FAILED;
        }
        return -1;
    }
    if s == IAP_VERIFIED {
        if ev == IAP_EV_DELIVER {
            return IAP_DELIVERED;
        }
        return -1;
    }
    if s == IAP_DELIVERED {
        if ev == IAP_EV_FINISH {
            return IAP_FINISHED;
        }
        return -1;
    }
    if s == IAP_FINISHED {
        if ev == IAP_EV_BUY {
            return IAP_PURCHASING;
        }
        return -1;
    }
    return -1;
}

pub struct IapPurchase {
    pub product: IapProduct,
    pub state: i64,
    pub purchased_ms: i64,
    pub transaction_id: str,
    pub history: Vec<i64>,
    pub refused: i64,
}

pub fn iap_purchase_new(p: IapProduct) -> IapPurchase {
    var h: Vec<i64> = Vec::new();
    h.push(IAP_IDLE);
    return IapPurchase {
        product: p, state: IAP_IDLE, purchased_ms: -1, transaction_id: "", history: h, refused: 0
    };
}

/// Apply an event; false when it is not allowed (a non-consumable that
/// was finished cannot be bought again, a consumable can).
pub fn iap_purchase_event(p: &mut IapPurchase, ev: i64, now: i64) -> bool {
    var n: i64 = iap_next(p.state, ev);
    if p.state == IAP_FINISHED && ev == IAP_EV_BUY && p.product.kind != IAP_CONSUMABLE {
        n = -1;
    }
    if n < 0 {
        p.refused = p.refused + 1;
        return false;
    }
    if n == IAP_PURCHASED {
        p.purchased_ms = now;
    }
    p.state = n;
    p.history.push(n);
    return true;
}

/// Play refunds a purchase not acknowledged within three days.
pub fn iap_play_ack_overdue(p: &IapPurchase, now: i64) -> bool {
    if p.purchased_ms < 0 || p.state == IAP_FINISHED || p.state == IAP_REFUNDED {
        return false;
    }
    return now - p.purchased_ms > IAP_PLAY_ACK_WINDOW_MS;
}

// ─── Transactions and subscription status ──────────────────────────────

pub struct IapTransaction {
    pub ok: bool,
    pub transaction_id: str,
    pub original_id: str,
    pub product_id: str,
    pub bundle_id: str,
    pub kind: i64,
    pub purchase_ms: i64,
    pub expires_ms: i64,  // -1 none
    pub revocation_ms: i64,  // -1 none
    pub quantity: i64,
    pub environment: str,  // Production, Sandbox
    pub ownership: str,  // PURCHASED, FAMILY_SHARED
    pub account_token: str,
}

pub fn iap_transaction_empty() -> IapTransaction {
    return IapTransaction {
        ok: false, transaction_id: "", original_id: "", product_id: "", bundle_id: "", kind: -1, purchase_ms: -1, expires_ms: -1, revocation_ms: -1, quantity: 0, environment: "", ownership: "", account_token: "",
    };
}

pub const IAP_SUB_ACTIVE: i64 = 1;
pub const IAP_SUB_EXPIRED: i64 = 2;
pub const IAP_SUB_BILLING_RETRY: i64 = 3;
pub const IAP_SUB_GRACE_PERIOD: i64 = 4;
pub const IAP_SUB_REVOKED: i64 = 5;

pub fn iap_sub_status_name(s: i64) -> str {
    if s == IAP_SUB_ACTIVE {
        return "active";
    }
    if s == IAP_SUB_EXPIRED {
        return "expired";
    }
    if s == IAP_SUB_BILLING_RETRY {
        return "billing-retry";
    }
    if s == IAP_SUB_GRACE_PERIOD {
        return "grace-period";
    }
    if s == IAP_SUB_REVOKED {
        return "revoked";
    }
    return "?";
}

/// The status (the numbering of the App Store Server API) at `now` from
/// the latest transaction, whether the store is retrying billing, and the
/// end of the grace period (-1: none).
pub fn iap_subscription_status(t: &IapTransaction, now: i64, billing_retry: bool, grace_until_ms: i64) -> i64 {
    if t.revocation_ms >= 0 && t.revocation_ms <= now {
        return IAP_SUB_REVOKED;
    }
    if t.expires_ms < 0 || now < t.expires_ms {
        return IAP_SUB_ACTIVE;
    }
    if billing_retry {
        if grace_until_ms >= 0 && now < grace_until_ms {
            return IAP_SUB_GRACE_PERIOD;
        }
        return IAP_SUB_BILLING_RETRY;
    }
    return IAP_SUB_EXPIRED;
}

/// Does the user get the content now (active or in grace period)?
pub fn iap_entitled(status: i64) -> bool {
    return status == IAP_SUB_ACTIVE || status == IAP_SUB_GRACE_PERIOD;
}

// ─── App Store Server API ──────────────────────────────────────────────

pub fn iap_appstore_host(sandbox: bool) -> str {
    if sandbox {
        return "https://api.storekit-sandbox.itunes.apple.com";
    }
    return "https://api.storekit.itunes.apple.com";
}

pub fn iap_appstore_transaction_url(sandbox: bool, transaction_id: str) -> str {
    return iap_appstore_host(sandbox) + "/inApps/v1/transactions/" + transaction_id;
}

pub fn iap_appstore_subscriptions_url(sandbox: bool, original_id: str) -> str {
    return iap_appstore_host(sandbox) + "/inApps/v1/subscriptions/" + original_id;
}

pub fn iap_appstore_history_url(sandbox: bool, transaction_id: str, revision: str) -> str {
    var u: str = iap_appstore_host(sandbox) + "/inApps/v2/history/" + transaction_id;
    if str_len(revision) > 0 {
        u = u + "?revision=" + url_encode_component(revision);
    }
    return u;
}

fn iap_b64url(bytes: Vec<i64>) -> str {
    val b: str = b64_encode_bytes(bytes);
    return str_replace(str_replace(str_replace(b, "+", "-"), "/", "_"), "=", "");
}

fn iap_b64url_decode(s: str) -> Vec<i64> {
    var t: str = str_replace(str_replace(s, "-", "+"), "_", "/");
    while str_len(t) % 4 != 0 {
        t = t + "=";
    }
    return b64_decode_bytes(t);
}

/// The signing input of an App Store Server API token: header
/// {"alg":"ES256","kid":..,"typ":"JWT"}, payload {"iss","iat","exp",
/// "aud":"appstoreconnect-v1","bid"} (exp at most 60 minutes later).
pub fn iap_api_token_input(key_id: str, issuer_id: str, bundle_id: str, iat: i64, ttl_secs: i64) -> str {
    val ttl: i64 = if ttl_secs > 3600 {
        3600
    } else {
        ttl_secs
    };
    val h: str = "{\"alg\":\"ES256\",\"kid\":" + json_string(key_id) + ",\"typ\":\"JWT\"}";
    val p: str = "{\"iss\":" + json_string(issuer_id) + ",\"iat\":" + int_to_str(iat) + ",\"exp\":" + int_to_str(iat + ttl) + ",\"aud\":\"appstoreconnect-v1\",\"bid\":" + json_string(bundle_id) + "}";
    return iap_b64url(str_bytes(h)) + "." + iap_b64url(str_bytes(p));
}

/// The full token (signature from the seam as 64-byte r||s).
pub fn iap_api_token(key_id: str, issuer_id: str, bundle_id: str, iat: i64, sign: fn(Vec<i64>) -> Vec<i64>) -> str {
    val input: str = iap_api_token_input(key_id, issuer_id, bundle_id, iat, 3600);
    val sig: Vec<i64> = sign(str_bytes(input));
    if sig.len() != 64 {
        return "";
    }
    return input + "." + iap_b64url(sig);
}

/// The decoded parts of a JWS (compact serialization).
pub struct IapJws {
    pub ok: bool,
    pub header: str,
    pub payload: str,
    pub verified: bool,
}

/// Split and decode a JWS; `verify` checks the signature (header b64url,
/// payload b64url, signature bytes); `verified` is its answer.
pub fn iap_jws_decode(jws: str, verify: fn(str, str, Vec<i64>) -> bool) -> IapJws {
    val parts: Vec<str> = str_split(jws, ".");
    if parts.len() != 3 {
        return IapJws {
            ok: false, header: "", payload: "", verified: false
        };
    }
    val h: str = enc_bytes_to_str(iap_b64url_decode(parts.get(0)));
    val p: str = enc_bytes_to_str(iap_b64url_decode(parts.get(1)));
    if !json_is_valid(h) || !json_is_valid(p) {
        return IapJws {
            ok: false, header: "", payload: "", verified: false
        };
    }
    val v: bool = verify(parts.get(0), parts.get(1), iap_b64url_decode(parts.get(2)));
    return IapJws {
        ok: true, header: h, payload: p, verified: v
    };
}

fn iap_jstr(obj: str, key: str) -> str {
    val raw: str = json_get_safe(obj, key);
    if str_starts_with(raw, "\"") {
        return json_unescape(raw);
    }
    return "";
}

fn iap_jint(obj: str, key: str, def: i64) -> i64 {
    val raw: str = json_get_safe(obj, key);
    if json_type_safe(raw) == "number" {
        return str_parse_int(raw);
    }
    if str_starts_with(raw, "\"") {
        val s: str = json_unescape(raw);
        if str_len(s) > 0 && str_is_numeric(s) {
            return str_parse_int(s);
        }
    }
    return def;
}

/// The kind of an App Store "type" string.
pub fn iap_appstore_kind(t: str) -> i64 {
    if t == "Consumable" {
        return IAP_CONSUMABLE;
    }
    if t == "Non-Consumable" {
        return IAP_NON_CONSUMABLE;
    }
    if t == "Auto-Renewable Subscription" {
        return IAP_AUTO_RENEWABLE;
    }
    if t == "Non-Renewing Subscription" {
        return IAP_NON_RENEWING;
    }
    return -1;
}

/// A JWSTransactionDecodedPayload (JSON) as a transaction.
pub fn iap_appstore_transaction(payload: str) -> IapTransaction {
    var t: IapTransaction = iap_transaction_empty();
    if json_type_safe(payload) != "object" {
        return t;
    }
    t.transaction_id = iap_jstr(payload, "transactionId");
    t.original_id = iap_jstr(payload, "originalTransactionId");
    t.product_id = iap_jstr(payload, "productId");
    t.bundle_id = iap_jstr(payload, "bundleId");
    t.kind = iap_appstore_kind(iap_jstr(payload, "type"));
    t.purchase_ms = iap_jint(payload, "purchaseDate", -1);
    t.expires_ms = iap_jint(payload, "expiresDate", -1);
    t.revocation_ms = iap_jint(payload, "revocationDate", -1);
    t.quantity = iap_jint(payload, "quantity", 1);
    t.environment = iap_jstr(payload, "environment");
    t.ownership = iap_jstr(payload, "inAppOwnershipType");
    t.account_token = iap_jstr(payload, "appAccountToken");
    t.ok = str_len(t.transaction_id) > 0 && str_len(t.product_id) > 0;
    return t;
}

/// An App Store Server Notification V2 (the decoded signedPayload).
pub struct IapNotification {
    pub ok: bool,
    pub kind: str,  // SUBSCRIBED, DID_RENEW, EXPIRED, REFUND ...
    pub subtype: str,
    pub uuid: str,
    pub environment: str,
    pub signed_transaction: str,
    pub signed_renewal: str,
}

pub fn iap_appstore_notification(payload: str) -> IapNotification {
    val data: str = json_get_safe(payload, "data");
    return IapNotification {
        ok: json_type_safe(payload) == "object" && str_len(iap_jstr(payload, "notificationType")) > 0, kind: iap_jstr(payload, "notificationType"), subtype: iap_jstr(payload, "subtype"), uuid: iap_jstr(payload, "notificationUUID"), environment: iap_jstr(data, "environment"), signed_transaction: iap_jstr(data, "signedTransactionInfo"), signed_renewal: iap_jstr(data, "signedRenewalInfo"),
    };
}

/// The purchase-state event a notification means (-1: no change).
pub fn iap_notification_event(kind: str) -> i64 {
    if kind == "REFUND" || kind == "REVOKE" {
        return IAP_EV_REFUND;
    }
    if kind == "SUBSCRIBED" || kind == "DID_RENEW" || kind == "ONE_TIME_CHARGE" {
        return IAP_EV_STORE_OK;
    }
    if kind == "DID_FAIL_TO_RENEW" || kind == "EXPIRED" || kind == "GRACE_PERIOD_EXPIRED" {
        return IAP_EV_STORE_FAILED;
    }
    return -1;
}

/// verifyReceipt (legacy) status codes.
pub fn iap_receipt_status(code: i64) -> str {
    if code == 0 {
        return "valid";
    }
    if code == 21000 {
        return "bad request method";
    }
    if code == 21002 {
        return "malformed receipt data";
    }
    if code == 21003 {
        return "receipt not authenticated";
    }
    if code == 21004 {
        return "shared secret mismatch";
    }
    if code == 21005 {
        return "server unavailable";
    }
    if code == 21006 {
        return "subscription expired";
    }
    if code == 21007 {
        return "sandbox receipt: retry in sandbox";
    }
    if code == 21008 {
        return "production receipt: retry in production";
    }
    if code == 21009 {
        return "internal data access error";
    }
    if code == 21010 {
        return "account not found";
    }
    return "unknown";
}

/// Entries of latest_receipt_info (legacy receipts; *_ms fields are
/// strings there).
pub fn iap_receipt_transactions(response: str) -> Vec<IapTransaction> {
    var out: Vec<IapTransaction> = Vec::new();
    val arr: str = json_get_safe(response, "latest_receipt_info");
    if json_type_safe(arr) != "array" {
        return out;
    }
    var i: i64 = 0;
    while i < json_len_safe(arr) {
        val e: str = json_at_safe(arr, i);
        var t: IapTransaction = iap_transaction_empty();
        t.transaction_id = iap_jstr(e, "transaction_id");
        t.original_id = iap_jstr(e, "original_transaction_id");
        t.product_id = iap_jstr(e, "product_id");
        t.purchase_ms = iap_jint(e, "purchase_date_ms", -1);
        t.expires_ms = iap_jint(e, "expires_date_ms", -1);
        t.revocation_ms = iap_jint(e, "cancellation_date_ms", -1);
        t.quantity = iap_jint(e, "quantity", 1);
        t.ok = str_len(t.transaction_id) > 0;
        out.push(t);
        i = i + 1;
    }
    return out;
}

// ─── Google Play ───────────────────────────────────────────────────────

fn iap_play_base(package: str) -> str {
    return "https://androidpublisher.googleapis.com/androidpublisher/v3/applications/" + package + "/purchases/";
}

pub fn iap_play_product_url(package: str, product_id: str, token: str) -> str {
    return iap_play_base(package) + "products/" + product_id + "/tokens/" + token;
}

pub fn iap_play_acknowledge_url(package: str, product_id: str, token: str) -> str {
    return iap_play_product_url(package, product_id, token) + ":acknowledge";
}

pub fn iap_play_consume_url(package: str, product_id: str, token: str) -> str {
    return iap_play_product_url(package, product_id, token) + ":consume";
}

pub fn iap_play_subscription_url(package: str, token: str) -> str {
    return iap_play_base(package) + "subscriptionsv2/tokens/" + token;
}

/// A purchase token looks like Play's: [A-Za-z0-9._-] and long enough.
pub fn iap_play_token_valid(t: str) -> bool {
    if str_len(t) < 20 {
        return false;
    }
    var i: i64 = 0;
    while i < str_len(t) {
        val c: i64 = str_byte_at(t, i);
        if !(char_is_alpha(c) || char_is_digit(c) || c == 46 || c == 95 || c == 45) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// A ProductPurchase resource: purchaseState 0 purchased, 1 canceled,
/// 2 pending; consumptionState and acknowledgementState 0 / 1.
pub struct IapPlayProduct {
    pub ok: bool,
    pub order_id: str,
    pub purchase_state: i64,
    pub consumed: bool,
    pub acknowledged: bool,
    pub purchase_ms: i64,
    pub quantity: i64,
}

pub fn iap_play_product(json_text: str) -> IapPlayProduct {
    return IapPlayProduct {
        ok: json_type_safe(json_text) == "object", order_id: iap_jstr(json_text, "orderId"), purchase_state: iap_jint(json_text, "purchaseState", -1), consumed: iap_jint(json_text, "consumptionState", 0) == 1, acknowledged: iap_jint(json_text, "acknowledgementState", 0) == 1, purchase_ms: iap_jint(json_text, "purchaseTimeMillis", -1), quantity: iap_jint(json_text, "quantity", 1),
    };
}

/// The purchase state of a ProductPurchase.
pub fn iap_play_product_state(p: &IapPlayProduct) -> i64 {
    if p.purchase_state == 1 {
        return IAP_CANCELED;
    }
    if p.purchase_state == 2 {
        return IAP_PENDING;
    }
    if p.consumed || p.acknowledged {
        return IAP_FINISHED;
    }
    return IAP_PURCHASED;
}

/// The SubscriptionPurchaseV2 subscriptionState and first line item's
/// expiry as a status at `now`.
pub fn iap_play_subscription_status(json_text: str, now: i64) -> i64 {
    val st: str = iap_jstr(json_text, "subscriptionState");
    val items: str = json_get_safe(json_text, "lineItems");
    var exp: i64 = -1;
    if json_type_safe(items) == "array" && json_len_safe(items) > 0 {
        exp = iap_parse_rfc3339(iap_jstr(json_at_safe(items, 0), "expiryTime"));
    }
    if st == "SUBSCRIPTION_STATE_IN_GRACE_PERIOD" {
        return IAP_SUB_GRACE_PERIOD;
    }
    if st == "SUBSCRIPTION_STATE_ON_HOLD" {
        return IAP_SUB_BILLING_RETRY;
    }
    if st == "SUBSCRIPTION_STATE_EXPIRED" {
        return IAP_SUB_EXPIRED;
    }
    if st == "SUBSCRIPTION_STATE_ACTIVE" || st == "SUBSCRIPTION_STATE_CANCELED" {
        // canceled: no renewal, but entitled until the expiry
        if exp < 0 || now < exp {
            return IAP_SUB_ACTIVE;
        }
        return IAP_SUB_EXPIRED;
    }
    return IAP_SUB_EXPIRED;
}

/// Check a purchase from BillingClient (Purchase.getOriginalJson() and
/// getSignature()) with the seam, then read its token and product.
pub struct IapPlayLocal {
    pub ok: bool,
    pub verified: bool,
    pub token: str,
    pub product_id: str,
    pub state: i64,
    pub acknowledged: bool,
}

pub fn iap_play_local(original_json: str, signature_b64: str, verify: fn(str, str) -> bool) -> IapPlayLocal {
    val ok: bool = json_type_safe(original_json) == "object";
    var pid: str = iap_jstr(original_json, "productId");
    if str_len(pid) == 0 {
        val ids: str = json_get_safe(original_json, "productIds");
        if json_type_safe(ids) == "array" && json_len_safe(ids) > 0 {
            pid = json_unescape(json_at_safe(ids, 0));
        }
    }
    return IapPlayLocal {
        ok: ok, verified: ok && verify(original_json, signature_b64), token: iap_jstr(original_json, "purchaseToken"), product_id: pid, state: iap_jint(original_json, "purchaseState", -1), acknowledged: json_get_safe(original_json, "acknowledged") == "true",
    };
}
