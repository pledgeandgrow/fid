// Fides Collections standard library
//
// Additional data structures: Deque (double-ended queue) and LinkedList.
// Built on top of Vec for simplicity.
//
// Usage:
//   use collections;
//   value d = Deque::new();
//   d.push_front(1);
//   d.push_back(2);
//   println(d.pop_front());  // 1
//   println(d.pop_back());   // 2

module collections;
use vec;
// ─── Deque (Double-Ended Queue) ─────────────────────────────────────────

/// A double-ended queue of i64 values on a ring buffer: push and pop at
/// both ends are O(1) (growth amortized), with no shifting or compaction
/// passes. Empty/out-of-range reads return Option::None; the `*_or`
/// variants supply a default.
/// Elements are i64 (words); see queue.fd's note on generic element types.
///
/// Example:
///   var d = Deque::new();
///   d.push_back(2);
///   d.push_front(1);
///   d.push_back(3);
///   assert_eq(d.len(), 3);
///   assert_eq(d.get_or(0, 0), 1);
///   assert_eq(d.pop_front_or(0), 1);
///   assert_eq(d.pop_back_or(0), 3);
///   assert_eq(d.peek_front_or(0), 2);
pub struct Deque<T> {
    // `data` is the ring: capacity is data.len(), elements live at
    // (head + i) mod capacity. `count` is the number of live elements.
    pub data: Vec<i64>,
    pub head: i64,
    pub count: i64,
}

impl Deque {
    /// Create a new empty deque.
    pub fn new() -> Deque {
        return Deque {
            data: Vec::new(), head: 0, count: 0
        };
    }

    // Double the ring (8 to start), keeping FIFO order and head at 0.
    fn grow(self: &mut Deque) -> void {
        var old_cap = self.data.len();
        var new_cap = 8;
        if old_cap > 0 {
            new_cap = old_cap * 2;
        }
        var fresh: Vec<i64> = Vec::new();
        var i = 0;
        while i < self.count {
            fresh.push(self.data.get((self.head + i) % old_cap));
            i = i + 1;
        }
        i = self.count;
        while i < new_cap {
            fresh.push(0);
            i = i + 1;
        }
        self.data = fresh;
        self.head = 0;
    }

    /// Add a value to the front. O(1).
    pub fn push_front(self: &mut Deque, value: i64) -> void {
        var cap = self.data.len();
        if self.count >= cap {
            self.grow();
            cap = self.data.len();
        }
        self.head = (self.head + cap - 1) % cap;
        self.data.set(self.head, value);
        self.count = self.count + 1;
    }

    /// Add a value to the back. O(1) amortized.
    pub fn push_back(self: &mut Deque, value: i64) -> void {
        var cap = self.data.len();
        if self.count >= cap {
            self.grow();
            cap = self.data.len();
        }
        self.data.set((self.head + self.count) % cap, value);
        self.count = self.count + 1;
    }

    /// Remove and return the front value, or Option::None if empty.
    pub fn pop_front(self: &mut Deque) -> Option<i64> {
        if self.count == 0 {
            return Option::None;
        }
        var cap = self.data.len();
        var value = self.data.get(self.head);
        self.head = (self.head + 1) % cap;
        self.count = self.count - 1;
        return Option::Some(value);
    }

    /// pop_front, or `default` when the deque is empty.
    pub fn pop_front_or(self: &mut Deque, default: i64) -> i64 {
        match self.pop_front() {
            Option::Some(v) => {
                return v;
            }
            Option::None => {
                return default;
            }
        }
    }

    /// Remove and return the back value, or Option::None if empty.
    pub fn pop_back(self: &mut Deque) -> Option<i64> {
        if self.count == 0 {
            return Option::None;
        }
        var cap = self.data.len();
        var idx = (self.head + self.count - 1) % cap;
        var value = self.data.get(idx);
        self.count = self.count - 1;
        return Option::Some(value);
    }

    /// pop_back, or `default` when the deque is empty.
    pub fn pop_back_or(self: &mut Deque, default: i64) -> i64 {
        match self.pop_back() {
            Option::Some(v) => {
                return v;
            }
            Option::None => {
                return default;
            }
        }
    }

    /// Peek at the front value without removing it, or Option::None.
    pub fn peek_front(self: Deque) -> Option<i64> {
        if self.count == 0 {
            return Option::None;
        }
        return Option::Some(self.data.get(self.head));
    }

    /// peek_front, or `default` when the deque is empty.
    pub fn peek_front_or(self: Deque, default: i64) -> i64 {
        match self.peek_front() {
            Option::Some(v) => {
                return v;
            }
            Option::None => {
                return default;
            }
        }
    }

    /// Peek at the back value without removing it, or Option::None.
    pub fn peek_back(self: Deque) -> Option<i64> {
        if self.count == 0 {
            return Option::None;
        }
        var cap = self.data.len();
        return Option::Some(self.data.get((self.head + self.count - 1) % cap));
    }

    /// peek_back, or `default` when the deque is empty.
    pub fn peek_back_or(self: Deque, default: i64) -> i64 {
        match self.peek_back() {
            Option::Some(v) => {
                return v;
            }
            Option::None => {
                return default;
            }
        }
    }

    /// Check if the deque is empty.
    pub fn is_empty(self: Deque) -> bool {
        return self.count == 0;
    }

    /// Get the number of elements.
    pub fn len(self: Deque) -> i64 {
        return self.count;
    }

    /// Clear all elements, keeping the allocated ring.
    pub fn clear(self: &mut Deque) -> void {
        self.head = 0;
        self.count = 0;
    }

    /// Get element at index (0 = front), or Option::None when out of range.
    pub fn get(self: Deque, idx: i64) -> Option<i64> {
        if idx < 0 || idx >= self.count {
            return Option::None;
        }
        var cap = self.data.len();
        return Option::Some(self.data.get((self.head + idx) % cap));
    }

    /// get, or `default` when out of range.
    pub fn get_or(self: Deque, idx: i64, default: i64) -> i64 {
        match self.get(idx) {
            Option::Some(v) => {
                return v;
            }
            Option::None => {
                return default;
            }
        }
    }

    /// The elements in order (front first) as a Vec.
    pub fn to_vec(self: Deque) -> Vec<i64> {
        var out: Vec<i64> = Vec::new();
        var cap = self.data.len();
        var i = 0;
        while i < self.count {
            out.push(self.data.get((self.head + i) % cap));
            i = i + 1;
        }
        return out;
    }

    /// Drain all elements into a Vec (front first).
    pub fn drain(self: &mut Deque) -> Vec<i64> {
        var out: Vec<i64> = Vec::new();
        while self.count > 0 {
            out.push(self.pop_front_or(0));
        }
        return out;
    }
}

// ─── Linked List (singly linked, using parallel arrays) ────────────────

/// A singly linked list using parallel arrays for values and next pointers.
///
/// Example:
///   var l = LinkedList::new();
///   l.push_back(2);
///   l.push_front(1);
///   l.push_back(3);
///   assert_eq(l.len(), 3);
///   assert_eq(l.get(2), 3);
///   assert_eq(l.find(2), 1);
///   assert_eq(l.pop_front(), 1);
///   assert(l.contains(3));
pub struct LinkedList {
    pub values: Vec<i64>,
    // value of each node
    pub nexts: Vec<i64>,
    // next index of each node (-1 if none)
    pub head: i64,
    // index of head node, -1 if empty
    pub tail: i64,
    // index of tail node, -1 if empty
    pub size: i64,
}

impl LinkedList {
    /// Create a new empty linked list.
    pub fn new() -> LinkedList {
        return LinkedList {
            values: Vec::new(), nexts: Vec::new(), head: -1, tail: -1, size: 0
        };
    }

    /// Add a value to the end of the list.
    pub fn push_back(self: &mut LinkedList, value: i64) -> void {
        var idx = self.values.len();
        self.values.push(value);
        self.nexts.push(-1);
        if self.tail >= 0 {
            // Update old tail's next
            self.nexts.set(self.tail, idx);
        } else {
            self.head = idx;
        }
        self.tail = idx;
        self.size = self.size + 1;
    }

    /// Add a value to the front of the list.
    pub fn push_front(self: &mut LinkedList, value: i64) -> void {
        var idx = self.values.len();
        self.values.push(value);
        self.nexts.push(self.head);
        self.head = idx;
        if self.tail < 0 {
            self.tail = idx;
        }
        self.size = self.size + 1;
    }

    /// Remove and return the front value. Returns 0 if empty.
    pub fn pop_front(self: &mut LinkedList) -> i64 {
        if self.head < 0 {
            return 0;
        }
        var value = self.values.get(self.head);
        self.head = self.nexts.get(self.head);
        if self.head < 0 {
            self.tail = -1;
        }
        self.size = self.size - 1;
        return value;
    }

    /// Peek at the front value. Returns 0 if empty.
    pub fn peek_front(self: LinkedList) -> i64 {
        if self.head < 0 {
            return 0;
        }
        return self.values.get(self.head);
    }

    /// Check if the list is empty.
    pub fn is_empty(self: LinkedList) -> bool {
        return self.head < 0;
    }

    /// Get the number of elements.
    pub fn len(self: LinkedList) -> i64 {
        return self.size;
    }

    /// Get the value at a given index (O(n)).
    pub fn get(self: LinkedList, idx: i64) -> i64 {
        var i = 0;
        var current = self.head;
        while current >= 0 && i < idx {
            current = self.nexts.get(current);
            i = i + 1;
        }
        if current < 0 {
            return 0;
        }
        return self.values.get(current);
    }

    /// Convert to a Vec.
    pub fn to_vec(self: LinkedList) -> Vec<i64> {
        var result = Vec::new();
        var current = self.head;
        while current >= 0 {
            result.push(self.values.get(current));
            current = self.nexts.get(current);
        }
        return result;
    }

    /// Create a linked list from a Vec.
    pub fn from_vec(v: Vec<i64>) -> LinkedList {
        var list = LinkedList::new();
        var i = 0;
        while i < v.len() {
            list.push_back(v.get(i));
            i = i + 1;
        }
        return list;
    }

    /// Find the first index of a value. Returns -1 if not found.
    pub fn find(self: LinkedList, value: i64) -> i64 {
        var idx = 0;
        var current = self.head;
        while current >= 0 {
            if self.values.get(current) == value {
                return idx;
            }
            current = self.nexts.get(current);
            idx = idx + 1;
        }
        return -1;
    }

    /// Check if the list contains a value.
    pub fn contains(self: LinkedList, value: i64) -> bool {
        return self.find(value) >= 0;
    }
}

// ─── Set (using Vec, simple implementation) ─────────────────────────────

/// A simple set of i64 values backed by a Vec.
/// Not efficient for large sets — use HashMap for that.
///
/// Example:
///   var a = Set::new();
///   a.insert(1); a.insert(2); a.insert(2);
///   var b = Set::new();
///   b.insert(2); b.insert(3);
///   assert_eq(a.len(), 2);
///   assert_eq(Set::union(a, b).len(), 3);
///   assert_eq(Set::intersection(a, b).len(), 1);
///   assert(Set::difference(a, b).contains(1));
pub struct Set {
    pub data: Vec<i64>,
}

impl Set {
    /// Create a new empty set.
    pub fn new() -> Set {
        return Set {
            data: Vec::new()
        };
    }

    /// Insert a value into the set (no-op if already present).
    pub fn insert(self: &mut Set, value: i64) -> void {
        if !self.data.contains(value) {
            self.data.push(value);
        }
    }

    /// Remove a value from the set. Returns true if it was present.
    pub fn remove(self: &mut Set, value: i64) -> bool {
        var i = 0;
        while i < self.data.len() {
            if self.data.get(i) == value {
                self.data.remove(i);
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /// Check if the set contains a value.
    pub fn contains(self: Set, value: i64) -> bool {
        return self.data.contains(value);
    }

    /// Get the number of elements.
    pub fn len(self: Set) -> i64 {
        return self.data.len();
    }

    /// Check if the set is empty.
    pub fn is_empty(self: Set) -> bool {
        return self.data.is_empty();
    }

    /// Clear the set.
    pub fn clear(self: &mut Set) -> void {
        self.data.clear();
    }

    /// Convert to a Vec.
    pub fn to_vec(self: Set) -> Vec<i64> {
        return self.data;
    }

    /// Create a set from a Vec.
    pub fn from_vec(v: Vec<i64>) -> Set {
        var s = Set::new();
        var i = 0;
        while i < v.len() {
            s.insert(v.get(i));
            i = i + 1;
        }
        return s;
    }

    /// Union: returns a new set with elements from both sets.
    pub fn union(a: Set, b: Set) -> Set {
        var result = Set::new();
        var i = 0;
        while i < a.data.len() {
            result.insert(a.data.get(i));
            i = i + 1;
        }
        var j = 0;
        while j < b.data.len() {
            result.insert(b.data.get(j));
            j = j + 1;
        }
        return result;
    }

    /// Intersection: returns a new set with elements in both sets.
    pub fn intersection(a: Set, b: Set) -> Set {
        var result = Set::new();
        var i = 0;
        while i < a.data.len() {
            if b.contains(a.data.get(i)) {
                result.insert(a.data.get(i));
            }
            i = i + 1;
        }
        return result;
    }

    /// Difference: returns a new set with elements in a but not in b.
    pub fn difference(a: Set, b: Set) -> Set {
        var result = Set::new();
        var i = 0;
        while i < a.data.len() {
            if !b.contains(a.data.get(i)) {
                result.insert(a.data.get(i));
            }
            i = i + 1;
        }
        return result;
    }
}

// ─── HashSet (hash-based set for i64 keys, O(1) lookup) ────────────────
//
// Uses an open-addressing hash table with integer keys.
// Keys are i64 values (not string pointers like core.fd's HashMap).
// For ordered iteration, use BTreeSet instead.
//
// Internal layout (heap block, 40 bytes):
//   offset  0: keys_ptr    (*i64) — array of keys (any i64 may be stored:
//                             occupancy lives in the states array, so 0
//                             and -1 are valid members)
//   offset  8: states_ptr  (*i64) — per-slot state: 0 empty, 1 occupied,
//                             2 tombstone
//   offset 16: len         (i64)  — number of live entries
//   offset 24: capacity    (i64)  — size of keys/states arrays
//   offset 32: tombs       (i64)  — number of tombstones (drives regrow)

// Integer hash function (FNV-1a variant for i64).
@wrapping
fn int_hash(val: i64) -> i64 {
    var hash: i64 = 0x811c9dc5;
    var i = 0;
    while i < 8 {
        hash = hash ^ ((val >> (i * 8)) & 0xFF);
        hash = (hash * 0x01000193) & 0xFFFFFFFF;
        i = i + 1;
    }
    if hash < 0 {
        return -hash;
    }
    return hash;
}

// Read one word of a slot array (`base` is the array's i64 address).
// pub (compiler method-module quirk): a program that `use`s another
// module defining HashSet_* functions gets impl-HashSet method bodies
// checked under that module's visibility; private helpers and a private
// field then fail — keep them pub like the previous public `table`.
pub fn hs_rd(base: i64, idx: i64) -> i64 {
    var ptr: *mut i64 = base + idx * 8;
    var v: i64 = 0;
    // SAFETY: callers keep idx inside the capacity-word block grow()
    // allocated for `base`.
    unsafe {
        v = *ptr;
    }
    return v;
}

// Write one word of a slot array. pub: see hs_rd.
pub fn hs_wr(base: i64, idx: i64, v: i64) -> void {
    var ptr: *mut i64 = base + idx * 8;
    // SAFETY: callers keep idx inside the capacity-word block grow()
    // allocated for `base`.
    unsafe {
        *ptr = v;
    }
}

// Read one word of the 40-byte table block. pub: see hs_rd.
pub fn hs_twrd(table: i64, word: i64) -> i64 {
    var ptr: *mut i64 = table + word * 8;
    var v: i64 = 0;
    // SAFETY: word < 5 stays inside the table block new() allocated.
    unsafe {
        v = *ptr;
    }
    return v;
}

// Write one word of the 40-byte table block. pub: see hs_rd.
pub fn hs_twwr(table: i64, word: i64, v: i64) -> void {
    var ptr: *mut i64 = table + word * 8;
    // SAFETY: word < 5 stays inside the table block new() allocated.
    unsafe {
        *ptr = v;
    }
}

/// A set of i64 values in a hash table (open addressing).
///
/// Example:
///   var s = HashSet::new();
///   s.insert(10); s.insert(20); s.insert(10);
///   assert_eq(s.len(), 2);
///   assert(s.contains(20));
///   assert(s.remove(10));
///   assert(!s.contains(10));
///   s.insert(0); s.insert(-1);
///   assert(s.contains(0) && s.contains(-1));
pub struct HashSet {
    // pointer to the hash table block. pub (compiler method-module quirk,
    // see hs_rd): methods must reach it under any importing module.
    pub table: i64,
}

impl HashSet {
    /// Create a new empty hash set.
    pub fn new() -> HashSet {
        var ptr: i64 = p_malloc(40);
        var i: i64 = 0;
        // SAFETY: writes the five words of the 40-byte block p_malloc just
        // returned.
        while i < 5 {
            hs_twwr(ptr, i, 0);
            i = i + 1;
        }
        return HashSet {
            table: ptr
        };
    }

    // Find the slot index for a key: the slot holding key, else the first
    // tombstone, else the first empty slot.
    fn find_slot(self: HashSet, key: i64) -> i64 {
        var capacity: i64 = hs_twrd(self.table, 3);
        if capacity == 0 {
            return -1;
        }
        var keys: i64 = hs_twrd(self.table, 0);
        var states: i64 = hs_twrd(self.table, 1);
        var hash_val: i64 = int_hash(key);
        var idx: i64 = hash_val % capacity;
        var first_tombstone: i64 = -1;
        var i: i64 = 0;
        while i < capacity {
            var st: i64 = hs_rd(states, idx);
            if st == 0 {
                if first_tombstone >= 0 {
                    return first_tombstone;
                }
                return idx;
            }
            if st == 2 {
                if first_tombstone < 0 {
                    first_tombstone = idx;
                }
            } else if hs_rd(keys, idx) == key {
                return idx;
            }
            idx = idx + 1;
            if idx >= capacity {
                idx = 0;
            }
            i = i + 1;
        }
        if first_tombstone >= 0 {
            return first_tombstone;
        }
        return -1;
    }

    // Grow the hash table when (live + tombstones) exceeds 3/4 of capacity.
    // Rehashing keeps only occupied slots, so grow() is also how tombstones
    // are reclaimed.
    fn grow(self: HashSet) -> void {
        var old_capacity: i64 = hs_twrd(self.table, 3);
        var old_keys: i64 = hs_twrd(self.table, 0);
        var old_states: i64 = hs_twrd(self.table, 1);

        var new_capacity: i64 = 8;
        if old_capacity > 0 {
            new_capacity = old_capacity * 2;
        }

        var new_keys: i64 = p_malloc(new_capacity * 8);
        var new_states: i64 = p_malloc(new_capacity * 8);
        var i: i64 = 0;
        while i < new_capacity {
            hs_wr(new_keys, i, 0);
            hs_wr(new_states, i, 0);
            i = i + 1;
        }

        // Rehash all entries
        var count: i64 = 0;
        var old_i: i64 = 0;
        while old_i < old_capacity {
            if hs_rd(old_states, old_i) == 1 {
                var old_key: i64 = hs_rd(old_keys, old_i);
                var hash_val: i64 = int_hash(old_key);
                var new_idx: i64 = hash_val % new_capacity;
                while hs_rd(new_states, new_idx) != 0 {
                    new_idx = new_idx + 1;
                    if new_idx >= new_capacity {
                        new_idx = 0;
                    }
                }
                hs_wr(new_keys, new_idx, old_key);
                hs_wr(new_states, new_idx, 1);
                count = count + 1;
            }
            old_i = old_i + 1;
        }

        // Free the old slot arrays; the table words are rewritten below.
        if old_keys != 0 {
            p_free(old_keys);
        }
        if old_states != 0 {
            p_free(old_states);
        }
        hs_twwr(self.table, 0, new_keys);
        hs_twwr(self.table, 1, new_states);
        hs_twwr(self.table, 2, count);
        hs_twwr(self.table, 3, new_capacity);
        hs_twwr(self.table, 4, 0);
    }

    /// Insert a value into the set (no-op if already present). Any i64 is a
    /// valid member, including 0 and -1.
    pub fn insert(self: HashSet, value: i64) -> void {
        var len: i64 = hs_twrd(self.table, 2);
        var cap: i64 = hs_twrd(self.table, 3);
        var tombs: i64 = hs_twrd(self.table, 4);
        // Grow if load factor > 0.75 or no capacity
        if cap == 0 || ((len + tombs) * 4 > cap * 3) {
            self.grow();
        }
        var idx: i64 = self.find_slot(value);
        var keys: i64 = hs_twrd(self.table, 0);
        var states: i64 = hs_twrd(self.table, 1);
        var st: i64 = hs_rd(states, idx);
        if st == 0 {
            // Empty slot: one new live entry.
            hs_wr(states, idx, 1);
            hs_wr(keys, idx, value);
            hs_twwr(self.table, 2, hs_twrd(self.table, 2) + 1);
        } else if st == 2 {
            // Reusing a tombstone: one new live entry, one fewer tombstone.
            hs_wr(states, idx, 1);
            hs_wr(keys, idx, value);
            hs_twwr(self.table, 2, hs_twrd(self.table, 2) + 1);
            hs_twwr(self.table, 4, hs_twrd(self.table, 4) - 1);
        }
        // st == 1 already holds value: no-op.
    }

    /// Check if the set contains a value.
    pub fn contains(self: HashSet, value: i64) -> bool {
        if hs_twrd(self.table, 3) == 0 {
            return false;
        }
        var idx: i64 = self.find_slot(value);
        if idx < 0 {
            return false;
        }
        var states: i64 = hs_twrd(self.table, 1);
        if hs_rd(states, idx) != 1 {
            return false;
        }
        var keys: i64 = hs_twrd(self.table, 0);
        return hs_rd(keys, idx) == value;
    }

    /// Remove a value from the set. Returns true if it was present.
    pub fn remove(self: HashSet, value: i64) -> bool {
        if !self.contains(value) {
            return false;
        }
        var idx: i64 = self.find_slot(value);
        var states: i64 = hs_twrd(self.table, 1);
        hs_wr(states, idx, 2);
        hs_twwr(self.table, 2, hs_twrd(self.table, 2) - 1);
        hs_twwr(self.table, 4, hs_twrd(self.table, 4) + 1);
        return true;
    }

    /// Get the number of elements.
    pub fn len(self: HashSet) -> i64 {
        return hs_twrd(self.table, 2);
    }

    /// Check if the set is empty.
    pub fn is_empty(self: HashSet) -> bool {
        return self.len() == 0;
    }

    /// Clear the set, keeping the allocated table.
    pub fn clear(self: HashSet) -> void {
        var cap: i64 = hs_twrd(self.table, 3);
        var states: i64 = hs_twrd(self.table, 1);
        var i: i64 = 0;
        while i < cap {
            hs_wr(states, i, 0);
            i = i + 1;
        }
        hs_twwr(self.table, 2, 0);
        hs_twwr(self.table, 4, 0);
    }

    /// Free the table's slot arrays. After destroy() the set is empty and
    /// may be reused; the small table block itself is reclaimed with the
    /// set's owner like any struct.
    pub fn destroy(self: HashSet) -> void {
        var keys: i64 = hs_twrd(self.table, 0);
        var states: i64 = hs_twrd(self.table, 1);
        if keys != 0 {
            p_free(keys);
        }
        if states != 0 {
            p_free(states);
        }
        hs_twwr(self.table, 0, 0);
        hs_twwr(self.table, 1, 0);
        hs_twwr(self.table, 2, 0);
        hs_twwr(self.table, 3, 0);
        hs_twwr(self.table, 4, 0);
    }

    /// Convert to a Vec of all elements.
    pub fn to_vec(self: HashSet) -> Vec<i64> {
        var result = Vec::new();
        var cap: i64 = hs_twrd(self.table, 3);
        if cap == 0 {
            return result;
        }
        var keys: i64 = hs_twrd(self.table, 0);
        var states: i64 = hs_twrd(self.table, 1);
        var i: i64 = 0;
        while i < cap {
            if hs_rd(states, i) == 1 {
                result.push(hs_rd(keys, i));
            }
            i = i + 1;
        }
        return result;
    }

    /// Create a hash set from a Vec.
    pub fn from_vec(v: Vec<i64>) -> HashSet {
        var s = HashSet::new();
        var i = 0;
        while i < v.len() {
            s.insert(v.get(i));
            i = i + 1;
        }
        return s;
    }

    /// Union: returns a new set with elements from both sets.
    pub fn union(a: HashSet, b: HashSet) -> HashSet {
        var result = HashSet::new();
        var a_keys = a.to_vec();
        var i = 0;
        while i < a_keys.len() {
            result.insert(a_keys.get(i));
            i = i + 1;
        }
        var b_keys = b.to_vec();
        var j = 0;
        while j < b_keys.len() {
            result.insert(b_keys.get(j));
            j = j + 1;
        }
        return result;
    }

    /// Intersection: returns a new set with elements in both sets.
    pub fn intersection(a: HashSet, b: HashSet) -> HashSet {
        var result = HashSet::new();
        var a_keys = a.to_vec();
        var i = 0;
        while i < a_keys.len() {
            if b.contains(a_keys.get(i)) {
                result.insert(a_keys.get(i));
            }
            i = i + 1;
        }
        return result;
    }

    /// Difference: returns a new set with elements in a but not in b.
    pub fn difference(a: HashSet, b: HashSet) -> HashSet {
        var result = HashSet::new();
        var a_keys = a.to_vec();
        var i = 0;
        while i < a_keys.len() {
            if !b.contains(a_keys.get(i)) {
                result.insert(a_keys.get(i));
            }
            i = i + 1;
        }
        return result;
    }
}

// ─── BTreeMap (ordered key-value map, sorted by key) ───────────────────
//
// Uses a sorted Vec of keys and a parallel Vec of values.
// O(log n) lookup via binary search, O(n) insert/remove.
// For O(1) lookup (unordered), use HashMap from core.fd instead.
// Keys are i64, values are i64.

/// An ordered map from i64 keys to i64 values (a sorted Vec of keys and a
/// parallel Vec of values); keys() and values() come in key order.
///
/// Example:
///   var m = BTreeMap::new();
///   m.insert(30, 300); m.insert(10, 100); m.insert(20, 200);
///   assert_eq(m.get(20), 200);
///   assert_eq(m.get_or(99, -1), -1);
///   assert_eq(m.first_key(), 10);
///   assert_eq(m.last_key(), 30);
///   assert_eq(m.keys().get(1), 20);
pub struct BTreeMap {
    pub keys: Vec<i64>,
    // sorted keys
    pub values: Vec<i64>,  // parallel values (values[i] corresponds to keys[i])
}

impl BTreeMap {
    /// Create a new empty BTreeMap.
    pub fn new() -> BTreeMap {
        return BTreeMap {
            keys: Vec::new(), values: Vec::new()
        };
    }

    /// Binary search for a key. Returns index if found, or -(insertion_point + 1) if not.
    fn binary_search(self: BTreeMap, key: i64) -> i64 {
        var lo = 0;
        var hi = self.keys.len() - 1;
        while lo <= hi {
            var mid = lo + (hi - lo) / 2;
            var mid_key = self.keys.get(mid);
            if mid_key == key {
                return mid;
            }
            if mid_key < key {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        return -(lo + 1);
        // not found: return -(insertion_point + 1)
    }

    /// Insert a key-value pair. If the key exists, updates the value.
    pub fn insert(self: &mut BTreeMap, key: i64, value: i64) -> void {
        var idx = self.binary_search(key);
        if idx >= 0 {
            // Key exists — update value
            self.values.set(idx, value);
        } else {
            // Key doesn't exist — insert at the right position
            var insert_pos = -(idx + 1);
            self.keys.insert(insert_pos, key);
            self.values.insert(insert_pos, value);
        }
    }

    /// Get the value for a key. Returns 0 if not found.
    pub fn get(self: BTreeMap, key: i64) -> i64 {
        var idx = self.binary_search(key);
        if idx >= 0 {
            return self.values.get(idx);
        }
        return 0;
    }

    /// Get the value for a key, or a default if not found.
    pub fn get_or(self: BTreeMap, key: i64, default: i64) -> i64 {
        var idx = self.binary_search(key);
        if idx >= 0 {
            return self.values.get(idx);
        }
        return default;
    }

    /// Check if the key exists.
    pub fn contains(self: BTreeMap, key: i64) -> bool {
        return self.binary_search(key) >= 0;
    }

    /// Remove a key-value pair. Returns true if the key was present.
    pub fn remove(self: &mut BTreeMap, key: i64) -> bool {
        var idx = self.binary_search(key);
        if idx >= 0 {
            self.keys.remove(idx);
            self.values.remove(idx);
            return true;
        }
        return false;
    }

    /// Get the number of entries.
    pub fn len(self: BTreeMap) -> i64 {
        return self.keys.len();
    }

    /// Check if the map is empty.
    pub fn is_empty(self: BTreeMap) -> bool {
        return self.keys.is_empty();
    }

    /// Clear the map.
    pub fn clear(self: &mut BTreeMap) -> void {
        self.keys.clear();
        self.values.clear();
    }

    /// Get all keys in sorted order.
    pub fn keys(self: BTreeMap) -> Vec<i64> {
        return self.keys;
    }

    /// Get all values (in key order).
    pub fn values(self: BTreeMap) -> Vec<i64> {
        return self.values;
    }

    /// Get the first (smallest) key. Returns 0 if empty.
    pub fn first_key(self: BTreeMap) -> i64 {
        if self.keys.is_empty() {
            return 0;
        }
        return self.keys.get(0);
    }

    /// Get the last (largest) key. Returns 0 if empty.
    pub fn last_key(self: BTreeMap) -> i64 {
        if self.keys.is_empty() {
            return 0;
        }
        return self.keys.get(self.keys.len() - 1);
    }

    /// Create a BTreeMap from a Vec of keys and a Vec of values.
    /// Inserts all pairs (does not assume sorted input).
    pub fn from_vecs(ks: Vec<i64>, vs: Vec<i64>) -> BTreeMap {
        var m = BTreeMap::new();
        var i = 0;
        while i < ks.len() {
            m.insert(ks.get(i), vs.get(i));
            i = i + 1;
        }
        return m;
    }
}

// ─── BTreeSet (ordered set, sorted by key) ─────────────────────────────
//
// Uses a sorted Vec of keys with binary search.
// O(log n) lookup, O(n) insert/remove.
// For O(1) lookup (unordered), use HashSet instead.

/// An ordered set of i64 values (a sorted Vec); to_vec() is ascending.
///
/// Example:
///   var s = BTreeSet::new();
///   s.insert(5); s.insert(1); s.insert(3); s.insert(1);
///   assert_eq(s.len(), 3);
///   assert_eq(s.first(), 1);
///   assert_eq(s.last(), 5);
///   assert_eq(s.to_vec().get(1), 3);
pub struct BTreeSet {
    pub data: Vec<i64>,  // sorted keys
}

impl BTreeSet {
    /// Create a new empty BTreeSet.
    pub fn new() -> BTreeSet {
        return BTreeSet {
            data: Vec::new()
        };
    }

    /// Binary search for a key. Returns index if found, or -(insertion_point + 1) if not.
    fn binary_search(self: BTreeSet, key: i64) -> i64 {
        var lo = 0;
        var hi = self.data.len() - 1;
        while lo <= hi {
            var mid = lo + (hi - lo) / 2;
            var mid_key = self.data.get(mid);
            if mid_key == key {
                return mid;
            }
            if mid_key < key {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        return -(lo + 1);
    }

    /// Insert a value into the set (no-op if already present).
    pub fn insert(self: &mut BTreeSet, value: i64) -> void {
        var idx = self.binary_search(value);
        if idx < 0 {
            var insert_pos = -(idx + 1);
            self.data.insert(insert_pos, value);
        }
    }

    /// Check if the set contains a value.
    pub fn contains(self: BTreeSet, value: i64) -> bool {
        return self.binary_search(value) >= 0;
    }

    /// Remove a value from the set. Returns true if it was present.
    pub fn remove(self: &mut BTreeSet, value: i64) -> bool {
        var idx = self.binary_search(value);
        if idx >= 0 {
            self.data.remove(idx);
            return true;
        }
        return false;
    }

    /// Get the number of elements.
    pub fn len(self: BTreeSet) -> i64 {
        return self.data.len();
    }

    /// Check if the set is empty.
    pub fn is_empty(self: BTreeSet) -> bool {
        return self.data.is_empty();
    }

    /// Clear the set.
    pub fn clear(self: &mut BTreeSet) -> void {
        self.data.clear();
    }

    /// Convert to a Vec (sorted order).
    pub fn to_vec(self: BTreeSet) -> Vec<i64> {
        return self.data;
    }

    /// Create a BTreeSet from a Vec.
    pub fn from_vec(v: Vec<i64>) -> BTreeSet {
        var s = BTreeSet::new();
        var i = 0;
        while i < v.len() {
            s.insert(v.get(i));
            i = i + 1;
        }
        return s;
    }

    /// Get the first (smallest) element. Returns 0 if empty.
    pub fn first(self: BTreeSet) -> i64 {
        if self.data.is_empty() {
            return 0;
        }
        return self.data.get(0);
    }

    /// Get the last (largest) element. Returns 0 if empty.
    pub fn last(self: BTreeSet) -> i64 {
        if self.data.is_empty() {
            return 0;
        }
        return self.data.get(self.data.len() - 1);
    }

    /// Union: returns a new set with elements from both sets.
    pub fn union(a: BTreeSet, b: BTreeSet) -> BTreeSet {
        var result = BTreeSet::new();
        var i = 0;
        while i < a.data.len() {
            result.insert(a.data.get(i));
            i = i + 1;
        }
        var j = 0;
        while j < b.data.len() {
            result.insert(b.data.get(j));
            j = j + 1;
        }
        return result;
    }

    /// Intersection: returns a new set with elements in both sets.
    pub fn intersection(a: BTreeSet, b: BTreeSet) -> BTreeSet {
        var result = BTreeSet::new();
        var i = 0;
        while i < a.data.len() {
            if b.contains(a.data.get(i)) {
                result.insert(a.data.get(i));
            }
            i = i + 1;
        }
        return result;
    }

    /// Difference: returns a new set with elements in a but not in b.
    pub fn difference(a: BTreeSet, b: BTreeSet) -> BTreeSet {
        var result = BTreeSet::new();
        var i = 0;
        while i < a.data.len() {
            if !b.contains(a.data.get(i)) {
                result.insert(a.data.get(i));
            }
            i = i + 1;
        }
        return result;
    }
}

// ─── RingBuffer (fixed-size circular buffer) ───────────────────────────
//
// A fixed-capacity circular buffer. O(1) push/pop at both ends.
// Overwrites oldest elements when full (configurable via `push_overwrite`).
// For an unbounded queue, use Deque instead.

/// A fixed-capacity circular buffer: push overwrites the oldest element
/// when full, try_push refuses instead.
///
/// Example:
///   var r = RingBuffer::new(3);
///   r.push(1); r.push(2); r.push(3); r.push(4);
///   assert(r.is_full());
///   assert_eq(r.peek_front(), 2);
///   assert(!r.try_push(5));
///   assert_eq(r.pop_front(), 2);
///   assert_eq(r.to_vec().get(1), 4);
pub struct RingBuffer {
    pub data: Vec<i64>,
    // backing storage
    pub capacity: i64,
    // max elements
    pub head: i64,
    // index of oldest element
    pub len: i64,  // number of live elements
}

impl RingBuffer {
    /// Create a new ring buffer with the given capacity.
    pub fn new(cap: i64) -> RingBuffer {
        var rb = RingBuffer {
            data: Vec::new(), capacity: cap, head: 0, len: 0,
        };
        // Pre-allocate the backing storage.
        var i = 0;
        while i < cap {
            rb.data.push(0);
            i = i + 1;
        }
        return rb;
    }

    /// Push a value to the back. If full, overwrites the oldest element.
    pub fn push(self: &mut RingBuffer, value: i64) -> void {
        var write_idx = (self.head + self.len) % self.capacity;
        if self.len < self.capacity {
            self.data.set(write_idx, value);
            self.len = self.len + 1;
        } else {
            // Buffer full — overwrite oldest, advance head
            self.data.set(self.head, value);
            self.head = (self.head + 1) % self.capacity;
        }
    }

    /// Push a value to the back. If full, returns false (no overwrite).
    pub fn try_push(self: &mut RingBuffer, value: i64) -> bool {
        if self.len >= self.capacity {
            return false;
        }
        var write_idx = (self.head + self.len) % self.capacity;
        self.data.set(write_idx, value);
        self.len = self.len + 1;
        return true;
    }

    /// Remove and return the front (oldest) value. Returns 0 if empty.
    pub fn pop_front(self: &mut RingBuffer) -> i64 {
        if self.len == 0 {
            return 0;
        }
        var value = self.data.get(self.head);
        self.head = (self.head + 1) % self.capacity;
        self.len = self.len - 1;
        return value;
    }

    /// Peek at the front value without removing it. Returns 0 if empty.
    pub fn peek_front(self: RingBuffer) -> i64 {
        if self.len == 0 {
            return 0;
        }
        return self.data.get(self.head);
    }

    /// Peek at the back (newest) value without removing it. Returns 0 if empty.
    pub fn peek_back(self: RingBuffer) -> i64 {
        if self.len == 0 {
            return 0;
        }
        var back_idx = (self.head + self.len - 1) % self.capacity;
        return self.data.get(back_idx);
    }

    /// Check if the buffer is empty.
    pub fn is_empty(self: RingBuffer) -> bool {
        return self.len == 0;
    }

    /// Check if the buffer is full.
    pub fn is_full(self: RingBuffer) -> bool {
        return self.len >= self.capacity;
    }

    /// Get the number of live elements.
    pub fn len(self: RingBuffer) -> i64 {
        return self.len;
    }

    /// Get the capacity.
    pub fn cap(self: RingBuffer) -> i64 {
        return self.capacity;
    }

    /// Get the number of free slots.
    pub fn free(self: RingBuffer) -> i64 {
        return self.capacity - self.len;
    }

    /// Clear all elements.
    pub fn clear(self: &mut RingBuffer) -> void {
        self.head = 0;
        self.len = 0;
    }

    /// Get element at logical index (0 = front).
    pub fn get(self: RingBuffer, idx: i64) -> i64 {
        if idx < 0 || idx >= self.len {
            return 0;
        }
        var real_idx = (self.head + idx) % self.capacity;
        return self.data.get(real_idx);
    }

    /// Set element at logical index (0 = front).
    pub fn set(self: &mut RingBuffer, idx: i64, value: i64) -> void {
        if idx < 0 || idx >= self.len {
            return;
        }
        var real_idx = (self.head + idx) % self.capacity;
        self.data.set(real_idx, value);
    }

    /// Convert to a Vec (front to back order).
    pub fn to_vec(self: RingBuffer) -> Vec<i64> {
        var result = Vec::new();
        var i = 0;
        while i < self.len {
            result.push(self.get(i));
            i = i + 1;
        }
        return result;
    }
}
