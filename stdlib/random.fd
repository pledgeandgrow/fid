// Fides Random standard library
//
// Pseudo-random number generation: a 64-bit xorshift* generator seeded with
// SplitMix64. The process-wide generator seeds itself from the OS entropy
// source (p_os_random_u64) mixed with the clock on first use, so two runs
// see different sequences unless seeded explicitly with random_seed().
// Not cryptographically secure — use crypto.fd (crypto_random) for keys,
// nonces and tokens.
//
// Usage:
//   use random;
//   random_seed(42);              // deterministic sequence for tests
//   println(random_int(100));     // random int in [0, 100)
//   println(random_float());      // random float in [0.0, 1.0)
//   var own = RngState::new(7);   // a generator independent of the global one
//   println(own.next_bounded(6));

module random;
 use vec; use math;

// ─── Core generator ─────────────────────────────────────────────────────

/// RNG state for one generator. `state` is the xorshift64* word; `seeded`
/// is false until the generator has taken a seed (the global one seeds
/// itself from OS entropy on first use).
pub struct RngState {
    pub state: i64,
    pub seeded: bool,
}

// SplitMix64: turns any seed (0 included) into a well-mixed nonzero state.
@wrapping fn sm64(seed: i64) -> i64 {
    var z: i64 = seed + -7046029254386353131; // 0x9E3779B97F4A7C15 as signed
    z = (z ^ (z >> 30)) * -4658895280553007687; // 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) * -7723592293110705685; // 0x94D049BB133111EB
    z = z ^ (z >> 31);
    if z == 0 {
        z = 0x9E3779B97F4A7C15;
    }
    return z;
}

/// Seed from the operating system (p_os_random_u64) mixed with the clock;
/// falls back to the clock alone.
@wrapping fn os_seed() -> i64 {
    var s: i64 = p_os_random_u64();
    s = s ^ (p_clock_now_us() * -7046029254386353131);
    s = s ^ (p_clock_now_ms() << 21);
    return sm64(s);
}

impl RngState {
    /// A generator with a deterministic sequence for `seed`.
    pub fn new(seed: i64) -> RngState {
        return RngState { state: sm64(seed), seeded: true };
    }

    /// A generator seeded from OS entropy (different sequence every run).
    pub fn new_os() -> RngState {
        return RngState { state: os_seed(), seeded: true };
    }

    /// Next raw word of the xorshift64* sequence.
    @wrapping pub fn next(self: & mut RngState) -> i64 {
        if !self.seeded {
            self.state = os_seed();
            self.seeded = true;
        }
        var x: i64 = self.state;
        x = x ^ (x >> 12);
        x = x ^ (x << 25);
        x = x ^ (x >> 27);
        self.state = x;
        return x * 2685821657736338717; // 0x2545F4914F6CDD1D
    }

    /// A value in [0, bound) with no modulo bias: a power-of-two window of
    /// raw bits, resampled on rejection. bound <= 0 gives 0.
    pub fn next_bounded(self: & mut RngState, bound: i64) -> i64 {
        if bound <= 0 {
            return 0;
        }
        var mask: i64 = 1;
        while mask < bound - 1 {
            mask = mask * 2 + 1;
        }
        var r: i64 = self.next() & mask;
        while r >= bound {
            r = self.next() & mask;
        }
        return r;
    }
}

// ─── Global generator ───────────────────────────────────────────────────

/// The process-wide generator. Seeds lazily from OS entropy; random_seed()
/// and random_seed_time() set an explicit sequence.
var RNG_DEFAULT: RngState = RngState {
    state: 0,
    seeded: false
};

// ─── Seeding ────────────────────────────────────────────────────────────

/// Seed the global generator with a fixed seed (deterministic sequence).
///
/// Example:
///   random_seed(42);
///   var a = random_int(1000);
///   random_seed(42);
///   assert_eq(random_int(1000), a);
pub fn random_seed(seed: i64) -> void {
    RNG_DEFAULT.state = sm64(seed);
    RNG_DEFAULT.seeded = true;
}

/// Seed with a per-run seed: FIDES_TEST_SEED when set (test determinism),
/// else OS entropy mixed with the clock.
pub fn random_seed_time() -> void {
    // Complaint CT3: with FIDES_TEST_SEED set (a test run), the "time" seed
    // is that number, so a test that seeds from the clock repeats exactly.
    match env_var("FIDES_TEST_SEED") {
        Option::Some(s) => {
            random_seed(str_parse_int(s));
            return;
        }
        Option::None => {
        }
    }
    RNG_DEFAULT.state = os_seed();
    RNG_DEFAULT.seeded = true;
}

// ─── Integer generation ─────────────────────────────────────────────────

/// Generate the next raw 64-bit word of the global generator.
pub fn random_raw() -> i64 {
    return RNG_DEFAULT.next();
}

/// Generate a random i64 in [0, max) (unbiased; the low bits are not just
/// taken modulo max).
///
/// Example:
///   random_seed(7);
///   var i = 0;
///   while i < 100 {
///     var r = random_int(6);
///     assert(r >= 0 && r < 6);
///     i = i + 1;
///   }
pub fn random_int(max: i64) -> i64 {
    return RNG_DEFAULT.next_bounded(max);
}

/// Generate a random i64 in [min, max].
///
/// Example:
///   random_seed(7);
///   var r = random_int_range(10, 20);
///   assert(r >= 10 && r <= 20);
pub fn random_int_range(min: i64, max: i64) -> i64 {
    if max < min {
        return min;
    }
    return min + RNG_DEFAULT.next_bounded(max - min + 1);
}

/// Generate a random i64 over the whole range (any bits may be set).
pub fn random_i64() -> i64 {
    return RNG_DEFAULT.next();
}

// ─── Float generation ───────────────────────────────────────────────────

/// Generate a random f64 in [0.0, 1.0): 53 raw bits over 2^53, so 1.0 is
/// never returned.
///
/// Example:
///   random_seed(3);
///   var f = random_float();
///   assert(f >= 0.0 && f < 1.0);
pub fn random_float() -> f64 {
    var u: i64 = (RNG_DEFAULT.next() >> 11) & 9007199254740991; // 2^53 - 1
    return (u as f64) / 9007199254740992.0;
}

/// Generate a random f64 in [0.0, max).
pub fn random_float_max(max: f64) -> f64 {
    return random_float() * max;
}

/// Generate a random f64 in [min, max).
pub fn random_float_range(min: f64, max: f64) -> f64 {
    return min + random_float() * (max - min);
}

/// Generate a Gaussian (normal) sample with the given mean and standard
/// deviation (Box-Muller).
///
/// Example:
///   random_seed(3);
///   var g = random_gaussian(0.0, 1.0);
pub fn random_gaussian(mean: f64, stddev: f64) -> f64 {
    var u1: f64 = random_float();
    if u1 <= 0.0 {
        u1 = 0.0000000000000001;
    }
    var u2: f64 = random_float();
    var mag: f64 = math_sqrt(0.0 - 2.0 * math_log(u1));
    return mean + stddev * mag * math_cos(2.0 * math_pi() * u2);
}

// ─── Boolean / choice ───────────────────────────────────────────────────

/// Generate a random boolean (a whole bounded draw, not a fixed bit of the
/// sequence, so consecutive calls do not correlate).
///
/// Example:
///   random_seed(9);
///   var t = 0;
///   var i = 0;
///   while i < 100 {
///     if random_bool() { t = t + 1; }
///     i = i + 1;
///   }
///   assert(t > 0 && t < 100);
pub fn random_bool() -> bool {
    return RNG_DEFAULT.next_bounded(2) == 1;
}

/// Pick a random element from a Vec. Returns 0 if empty.
///
/// Example:
///   random_seed(5);
///   var v: Vec<i64> = Vec::new();
///   v.push(10); v.push(20); v.push(30);
///   var c = random_choice(v);
///   assert(c == 10 || c == 20 || c == 30);
pub fn random_choice(v: Vec<i64>) -> i64 {
    if v.is_empty() {
        return 0;
    }
    return v.get(RNG_DEFAULT.next_bounded(v.len()));
}

/// Pick a random index from a Vec of the given length.
pub fn random_choice_idx(len: i64) -> i64 {
    return RNG_DEFAULT.next_bounded(len);
}

// ─── Shuffle ────────────────────────────────────────────────────────────

/// Shuffle a Vec in place (Fisher-Yates).
///
/// Example:
///   random_seed(11);
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(2); v.push(3); v.push(4);
///   random_shuffle(&mut v);
///   assert_eq(v.len(), 4);
///   assert_eq(v.get(0) + v.get(1) + v.get(2) + v.get(3), 10);
pub fn random_shuffle(v: & mut Vec<i64>) -> void {
    var i = v.len() - 1;
    while i > 0 {
        var j = RNG_DEFAULT.next_bounded(i + 1);
        var tmp = v.get(i);
        v.set(i, v.get(j));
        v.set(j, tmp);
        i = i - 1;
    }
}

// ─── Bytes / hex ────────────────────────────────────────────────────────

/// Generate a random byte (0-255).
///
/// Example:
///   random_seed(2);
///   var b = random_byte();
///   assert(b >= 0 && b <= 255);
pub fn random_byte() -> i64 {
    return RNG_DEFAULT.next_bounded(256);
}

/// Generate `n` random bytes as a Vec of values 0-255.
pub fn random_bytes(n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        out.push(RNG_DEFAULT.next_bounded(256));
        i = i + 1;
    }
    return out;
}

/// Generate a random hex string of the given length.
///
/// Example:
///   random_seed(2);
///   var h = random_hex(8);
///   assert_eq(str_len(h), 8);
pub fn random_hex(length: i64) -> str {
    var hex_chars = "0123456789abcdef";
    var bytes = Vec::new();
    var i = 0;
    while i < length {
        bytes.push(str_byte_at(hex_chars, RNG_DEFAULT.next_bounded(16)));
        i = i + 1;
    }
    return str_from_bytes(bytes);
}
