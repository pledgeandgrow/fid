// Fides Time Zone standard library (competitive SL8)
//
// Named time zones with their daylight-saving rules, over time.fd's
// LogicalTime (Unix seconds, UTC). A zone is a standard offset from UTC and
// an optional DST rule: when daylight time starts and ends each year (the
// month, which weekday of it, the time of day, and whether that time is
// UTC or the local clock), and how far the clock moves. The table holds
// the current rules (2026) of the common IANA zones, so on its own dates
// before a zone's present rules (US before 2007, EU before 1996) use
// today's rules.
//
// Every past change comes from the IANA time zone database itself:
// tz_load(name) reads the system's compiled zone file (TZif, RFC 8536:
// /usr/share/zoneinfo on Linux and macOS, $TZDIR if set) and
// tz_from_tzif(name, bytes) reads one from bytes. Such a zone knows each
// transition, with its offset, abbreviation and whether it is daylight
// time; after the last one it follows the file's own rule (its POSIX TZ
// string, held in the fields below). Where no file is found, tz_load gives
// the built-in table's zone.
//
// Usage:
//   use tz;
//   val ny = tz_find("America/New_York");
//   val t = time_new(2026, 7, 4, 16, 0, 0);          // 16:00 UTC
//   println(tz_format(t, ny, "%Y-%m-%d %H:%M %Z"));  // 2026-07-04 12:00 EDT
//   println(tz_offset_str(tz_offset(ny, t)));        // -04:00
//
// Local times that do not exist (the hour skipped in spring) resolve to
// the moment after the gap; ones that happen twice (the hour repeated in
// autumn) to the first of the two, as most libraries do.

module tz;

use time;
use datetime;
use vec;
use string;
use fs;

/// When a change happens: in `month`, the `week`-th `weekday` (0 Sunday
/// .. 6 Saturday; week 5 = the last one), at `secs` seconds after midnight
/// of the local clock (utc = false) or of UTC (utc = true).
pub struct TzWhen {
    pub month: i64,
    pub week: i64,
    pub weekday: i64,
    pub secs: i64,
    pub utc: bool,
}

/// A zone's past (from a TZif file): the UTC moments the clock changed
/// (`at`, ascending) and the local time type from each one on (`kind`,
/// an index into `off`/`dst`/`abbr`); before the first, type `first`.
/// Empty for a zone of the built-in table.
pub struct TzHist {
    pub at: Vec<i64>,
    pub kind: Vec<i64>,
    pub off: Vec<i64>,
    pub dst: Vec<i64>,
    pub abbr: Vec<str>,
    pub first: i64,
    pub has_rule: bool,
}

fn tz_no_hist() -> TzHist {
    return TzHist { at: Vec::new(), kind: Vec::new(), off: Vec::new(), dst: Vec::new(),
        abbr: Vec::new(), first: 0, has_rule: true };
}

/// A time zone: its name, standard offset (seconds east of UTC), and DST:
/// whether it has one, how far it moves the clock, when it starts and ends;
/// and, for a zone read from the database, its past (`hist`).
pub struct Tz {
    pub name: str,
    pub std_off: i64,
    pub std_abbr: str,
    pub has_dst: bool,
    pub dst_save: i64,
    pub dst_abbr: str,
    pub start: TzWhen,
    pub end: TzWhen,
    pub hist: TzHist,
}

fn tz_when(month: i64, week: i64, weekday: i64, secs: i64, utc: bool) -> TzWhen {
    return TzWhen { month: month, week: week, weekday: weekday, secs: secs, utc: utc };
}

fn tz_fixed(name: str, off: i64, abbr: str) -> Tz {
    return Tz { name: name, std_off: off, std_abbr: abbr, has_dst: false, dst_save: 0, dst_abbr: abbr,
        start: tz_when(1, 1, 0, 0, false), end: tz_when(1, 1, 0, 0, false), hist: tz_no_hist() };
}

// US since 2007: second Sunday of March 02:00 to first Sunday of November 02:00
fn tz_us(name: str, off: i64, sa: str, da: str) -> Tz {
    return Tz { name: name, std_off: off, std_abbr: sa, has_dst: true, dst_save: 3600, dst_abbr: da,
        start: tz_when(3, 2, 0, 7200, false), end: tz_when(11, 1, 0, 7200, false), hist: tz_no_hist() };
}

// EU since 1996: last Sunday of March to last Sunday of October, 01:00 UTC
fn tz_eu(name: str, off: i64, sa: str, da: str) -> Tz {
    return Tz { name: name, std_off: off, std_abbr: sa, has_dst: true, dst_save: 3600, dst_abbr: da,
        start: tz_when(3, 5, 0, 3600, true), end: tz_when(10, 5, 0, 3600, true), hist: tz_no_hist() };
}

const TZ_HOUR: i64 = 3600;

/// The zones this module knows, by IANA name. Unknown names give UTC.
pub fn tz_names() -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var all: Vec<Tz> = tz_table();
    var i: i64 = 0;
    while i < all.len() {
        out.push(all.get(i).name);
        i = i + 1;
    }
    return out;
}

fn tz_table() -> Vec<Tz> {
    var z: Vec<Tz> = Vec::new();
    z.push(tz_fixed("UTC", 0, "UTC"));
    z.push(tz_us("America/New_York", -5 * TZ_HOUR, "EST", "EDT"));
    z.push(tz_us("America/Toronto", -5 * TZ_HOUR, "EST", "EDT"));
    z.push(tz_us("America/Chicago", -6 * TZ_HOUR, "CST", "CDT"));
    z.push(tz_us("America/Denver", -7 * TZ_HOUR, "MST", "MDT"));
    z.push(tz_fixed("America/Phoenix", -7 * TZ_HOUR, "MST"));
    z.push(tz_us("America/Los_Angeles", -8 * TZ_HOUR, "PST", "PDT"));
    z.push(tz_us("America/Vancouver", -8 * TZ_HOUR, "PST", "PDT"));
    z.push(tz_us("America/Anchorage", -9 * TZ_HOUR, "AKST", "AKDT"));
    z.push(tz_fixed("Pacific/Honolulu", -10 * TZ_HOUR, "HST"));
    z.push(tz_fixed("America/Mexico_City", -6 * TZ_HOUR, "CST"));
    z.push(tz_fixed("America/Bogota", -5 * TZ_HOUR, "-05"));
    z.push(tz_fixed("America/Sao_Paulo", -3 * TZ_HOUR, "-03"));
    z.push(tz_fixed("America/Argentina/Buenos_Aires", -3 * TZ_HOUR, "-03"));
    // Chile: first Sunday of September 04:00 UTC to first Sunday of April 03:00 UTC
    z.push(Tz { name: "America/Santiago", std_off: -4 * TZ_HOUR, std_abbr: "-04", has_dst: true, dst_save: 3600, dst_abbr: "-03",
        start: tz_when(9, 1, 0, 4 * TZ_HOUR, true), end: tz_when(4, 1, 0, 3 * TZ_HOUR, true), hist: tz_no_hist() });
    z.push(tz_eu("Europe/London", 0, "GMT", "BST"));
    z.push(tz_eu("Europe/Dublin", 0, "GMT", "IST"));
    z.push(tz_eu("Europe/Lisbon", 0, "WET", "WEST"));
    z.push(tz_eu("Europe/Paris", TZ_HOUR, "CET", "CEST"));
    z.push(tz_eu("Europe/Berlin", TZ_HOUR, "CET", "CEST"));
    z.push(tz_eu("Europe/Madrid", TZ_HOUR, "CET", "CEST"));
    z.push(tz_eu("Europe/Rome", TZ_HOUR, "CET", "CEST"));
    z.push(tz_eu("Europe/Amsterdam", TZ_HOUR, "CET", "CEST"));
    z.push(tz_eu("Europe/Brussels", TZ_HOUR, "CET", "CEST"));
    z.push(tz_eu("Europe/Zurich", TZ_HOUR, "CET", "CEST"));
    z.push(tz_eu("Europe/Stockholm", TZ_HOUR, "CET", "CEST"));
    z.push(tz_eu("Europe/Warsaw", TZ_HOUR, "CET", "CEST"));
    z.push(tz_eu("Europe/Athens", 2 * TZ_HOUR, "EET", "EEST"));
    z.push(tz_eu("Europe/Helsinki", 2 * TZ_HOUR, "EET", "EEST"));
    z.push(tz_eu("Europe/Kyiv", 2 * TZ_HOUR, "EET", "EEST"));
    z.push(tz_fixed("Europe/Istanbul", 3 * TZ_HOUR, "+03"));
    z.push(tz_fixed("Europe/Moscow", 3 * TZ_HOUR, "MSK"));
    z.push(tz_fixed("Africa/Casablanca", TZ_HOUR, "+01"));
    z.push(tz_fixed("Africa/Lagos", TZ_HOUR, "WAT"));
    z.push(tz_fixed("Africa/Johannesburg", 2 * TZ_HOUR, "SAST"));
    z.push(tz_fixed("Africa/Nairobi", 3 * TZ_HOUR, "EAT"));
    z.push(tz_fixed("Asia/Dubai", 4 * TZ_HOUR, "+04"));
    z.push(tz_fixed("Asia/Karachi", 5 * TZ_HOUR, "PKT"));
    z.push(tz_fixed("Asia/Kolkata", 5 * TZ_HOUR + 1800, "IST"));
    z.push(tz_fixed("Asia/Kathmandu", 5 * TZ_HOUR + 2700, "+0545"));
    z.push(tz_fixed("Asia/Dhaka", 6 * TZ_HOUR, "+06"));
    z.push(tz_fixed("Asia/Bangkok", 7 * TZ_HOUR, "+07"));
    z.push(tz_fixed("Asia/Jakarta", 7 * TZ_HOUR, "WIB"));
    z.push(tz_fixed("Asia/Shanghai", 8 * TZ_HOUR, "CST"));
    z.push(tz_fixed("Asia/Hong_Kong", 8 * TZ_HOUR, "HKT"));
    z.push(tz_fixed("Asia/Singapore", 8 * TZ_HOUR, "+08"));
    z.push(tz_fixed("Asia/Taipei", 8 * TZ_HOUR, "CST"));
    z.push(tz_fixed("Asia/Tokyo", 9 * TZ_HOUR, "JST"));
    z.push(tz_fixed("Asia/Seoul", 9 * TZ_HOUR, "KST"));
    z.push(tz_fixed("Australia/Perth", 8 * TZ_HOUR, "AWST"));
    z.push(tz_fixed("Australia/Brisbane", 10 * TZ_HOUR, "AEST"));
    // south-east Australia: first Sunday of October 02:00 to first Sunday of April 03:00 (local)
    z.push(Tz { name: "Australia/Sydney", std_off: 10 * TZ_HOUR, std_abbr: "AEST", has_dst: true, dst_save: 3600, dst_abbr: "AEDT",
        start: tz_when(10, 1, 0, 2 * TZ_HOUR, false), end: tz_when(4, 1, 0, 3 * TZ_HOUR, false), hist: tz_no_hist() });
    z.push(Tz { name: "Australia/Melbourne", std_off: 10 * TZ_HOUR, std_abbr: "AEST", has_dst: true, dst_save: 3600, dst_abbr: "AEDT",
        start: tz_when(10, 1, 0, 2 * TZ_HOUR, false), end: tz_when(4, 1, 0, 3 * TZ_HOUR, false), hist: tz_no_hist() });
    z.push(Tz { name: "Australia/Adelaide", std_off: 9 * TZ_HOUR + 1800, std_abbr: "ACST", has_dst: true, dst_save: 3600, dst_abbr: "ACDT",
        start: tz_when(10, 1, 0, 2 * TZ_HOUR, false), end: tz_when(4, 1, 0, 3 * TZ_HOUR, false), hist: tz_no_hist() });
    // New Zealand: last Sunday of September 02:00 to first Sunday of April 03:00 (local)
    z.push(Tz { name: "Pacific/Auckland", std_off: 12 * TZ_HOUR, std_abbr: "NZST", has_dst: true, dst_save: 3600, dst_abbr: "NZDT",
        start: tz_when(9, 5, 0, 2 * TZ_HOUR, false), end: tz_when(4, 1, 0, 3 * TZ_HOUR, false), hist: tz_no_hist() });
    return z;
}

/// The zone of that IANA name ("Europe/Paris"), "UTC", or a fixed offset
/// written "+05:30" / "-08:00"; anything else is UTC.
pub fn tz_find(name: str) -> Tz {
    var all: Vec<Tz> = tz_table();
    var i: i64 = 0;
    while i < all.len() {
        if all.get(i).name == name { return all.get(i); }
        i = i + 1;
    }
    var n: i64 = str_len(name);
    if n == 6 && (str_byte_at(name, 0) == 43 || str_byte_at(name, 0) == 45) && str_byte_at(name, 3) == 58 {
        var h: i64 = str_parse_int(str_slice(name, 1, 3));
        var m: i64 = str_parse_int(str_slice(name, 4, 6));
        var off: i64 = h * TZ_HOUR + m * 60;
        if str_byte_at(name, 0) == 45 { off = 0 - off; }
        return tz_fixed(name, off, name);
    }
    return all.get(0);
}

/// Is `name` one of the zones this module knows?
pub fn tz_known(name: str) -> bool {
    var all: Vec<Tz> = tz_table();
    var i: i64 = 0;
    while i < all.len() {
        if all.get(i).name == name { return true; }
        i = i + 1;
    }
    return false;
}

/// Midnight UTC of the day `w` names in `year`, as Unix seconds.
fn tz_rule_day(year: i64, w: TzWhen) -> i64 {
    var first: LogicalTime = time_from_date(year, w.month, 1);
    var wd: i64 = time_get_weekday(first);
    var d: i64 = 1 + ((w.weekday - wd + 7) % 7);
    if w.week >= 5 {
        var dim: i64 = days_in_month(year, w.month);
        while d + 7 <= dim { d = d + 7; }
    } else {
        d = d + (w.week - 1) * 7;
    }
    return time_from_date(year, w.month, d).seconds;
}

/// The UTC moment of a change; `before` is the offset in force just
/// before it (the local clock the rule's time is read on).
fn tz_rule_utc(year: i64, w: TzWhen, before: i64) -> i64 {
    var t: i64 = tz_rule_day(year, w) + w.secs;
    if w.utc { return t; }
    return t - before;
}

/// The local time type of the past in force at `t`, or -1 when the rule
/// decides (no past, or after its last change and the file has a rule).
fn tz_hist_kind(h: TzHist, t: i64) -> i64 {
    var n: i64 = h.at.len();
    if h.off.len() == 0 { return -1; }
    if n == 0 || t < h.at.get(0) {
        if n == 0 && h.has_rule { return -1; }
        return h.first;
    }
    if t >= h.at.get(n - 1) {
        if h.has_rule { return -1; }
        return h.kind.get(n - 1);
    }
    // the last change at or before t
    var lo: i64 = 0;
    var hi: i64 = n - 1;
    while lo < hi {
        var mid: i64 = (lo + hi + 1) / 2;
        if h.at.get(mid) <= t { lo = mid; } else { hi = mid - 1; }
    }
    return h.kind.get(lo);
}

/// Is daylight time in force at `t` (UTC seconds)?
pub fn tz_is_dst(z: Tz, t: LogicalTime) -> bool {
    var k: i64 = tz_hist_kind(z.hist, t.seconds);
    if k >= 0 { return z.hist.dst.get(k) != 0; }
    if !z.has_dst { return false; }
    var year: i64 = time_get_year(time_from_timestamp(t.seconds + z.std_off));
    var start: i64 = tz_rule_utc(year, z.start, z.std_off);
    var end: i64 = tz_rule_utc(year, z.end, z.std_off + z.dst_save);
    if start < end {
        // northern hemisphere: summer inside one year
        return t.seconds >= start && t.seconds < end;
    }
    // southern: daylight time spans the new year
    return t.seconds >= start || t.seconds < end;
}

/// The zone's offset from UTC at `t`, in seconds east.
pub fn tz_offset(z: Tz, t: LogicalTime) -> i64 {
    var k: i64 = tz_hist_kind(z.hist, t.seconds);
    if k >= 0 { return z.hist.off.get(k); }
    if tz_is_dst(z, t) { return z.std_off + z.dst_save; }
    return z.std_off;
}

/// The abbreviation in force at `t` (EST or EDT, CET or CEST ...).
pub fn tz_abbr(z: Tz, t: LogicalTime) -> str {
    var k: i64 = tz_hist_kind(z.hist, t.seconds);
    if k >= 0 { return z.hist.abbr.get(k); }
    if tz_is_dst(z, t) { return z.dst_abbr; }
    return z.std_abbr;
}

/// An offset as "+HH:MM" or "-HH:MM".
pub fn tz_offset_str(off: i64) -> str {
    var sign: str = "+";
    var a: i64 = off;
    if a < 0 { sign = "-"; a = 0 - a; }
    var h: i64 = a / TZ_HOUR;
    var m: i64 = (a % TZ_HOUR) / 60;
    var hs: str = int_to_str(h);
    if h < 10 { hs = "0" + hs; }
    var ms: str = int_to_str(m);
    if m < 10 { ms = "0" + ms; }
    return sign + hs + ":" + ms;
}

/// The wall-clock time in zone `z` at the UTC moment `t`, as a LogicalTime
/// whose fields (time_get_hour ...) read as that local clock.
pub fn tz_to_local(t: LogicalTime, z: Tz) -> LogicalTime {
    return time_from_timestamp(t.seconds + tz_offset(z, t));
}

/// The UTC moment at which zone `z`'s clock shows `local` (built with
/// time_new). A local time skipped in spring is read after the gap; one
/// repeated in autumn is its first occurrence.
pub fn tz_from_local(local: LogicalTime, z: Tz) -> LogicalTime {
    // The offsets in force a day either side: a moment t is the answer
    // when the offset at t is the one that maps it to `local`
    var l: i64 = local.seconds;
    var before: i64 = tz_offset(z, time_from_timestamp(l - 86400));
    var cands: Vec<i64> = Vec::new();
    cands.push(before);
    cands.push(tz_offset(z, time_from_timestamp(l)));
    cands.push(tz_offset(z, time_from_timestamp(l + 86400)));
    cands.push(z.std_off);
    cands.push(z.std_off + z.dst_save);
    var best: i64 = 0;
    var found: bool = false;
    var i: i64 = 0;
    while i < cands.len() {
        var t: i64 = l - cands.get(i);
        if tz_offset(z, time_from_timestamp(t)) == cands.get(i) {
            // repeated hour: the first occurrence
            if !found || t < best { best = t; }
            found = true;
        }
        i = i + 1;
    }
    if found { return time_from_timestamp(best); }
    // skipped hour: read with the offset before the gap, so it lands after
    return time_from_timestamp(l - before);
}

// ─── The time zone database (TZif files, RFC 8536) ──────────────────────

fn tzif_u32(b: Vec<i64>, at: i64) -> i64 {
    return (b.get(at) << 24) | (b.get(at + 1) << 16) | (b.get(at + 2) << 8) | b.get(at + 3);
}

fn tzif_i32(b: Vec<i64>, at: i64) -> i64 {
    var v: i64 = tzif_u32(b, at);
    if v >= 2147483648 { v = v - 4294967296; }
    return v;
}

fn tzif_i64(b: Vec<i64>, at: i64) -> i64 {
    return (tzif_u32(b, at) << 32) | tzif_u32(b, at + 4);
}

/// Is `b` a TZif file this module reads (versions 1 to 4)?
pub fn tz_tzif_ok(b: Vec<i64>) -> bool {
    if b.len() < 44 { return false; }
    return b.get(0) == 84 && b.get(1) == 90 && b.get(2) == 105 && b.get(3) == 102;
}

/// The data block's size for the counts at `h` (the header), with times of
/// `w` bytes.
fn tzif_block(b: Vec<i64>, h: i64, w: i64) -> i64 {
    var isut: i64 = tzif_u32(b, h + 20);
    var isstd: i64 = tzif_u32(b, h + 24);
    var leap: i64 = tzif_u32(b, h + 28);
    var tc: i64 = tzif_u32(b, h + 32);
    var ty: i64 = tzif_u32(b, h + 36);
    var ch: i64 = tzif_u32(b, h + 40);
    return tc * w + tc + ty * 6 + ch + leap * (w + 4) + isstd + isut;
}

/// The zone `name` from the bytes of its TZif file. Anything malformed
/// gives UTC (with that name); tz_tzif_ok says whether bytes are TZif.
pub fn tz_from_tzif(name: str, b: Vec<i64>) -> Tz {
    var utc: Tz = tz_fixed(name, 0, "UTC");
    if !tz_tzif_ok(b) { return utc; }
    var ver: i64 = b.get(4);
    var h: i64 = 0;
    var w: i64 = 4;
    if ver >= 50 {
        // version 2+: skip the 32-bit block, read the 64-bit one
        var h2: i64 = 44 + tzif_block(b, 0, 4);
        if h2 + 44 > b.len() { return utc; }
        h = h2;
        w = 8;
    }
    var tc: i64 = tzif_u32(b, h + 32);
    var ty: i64 = tzif_u32(b, h + 36);
    var ch: i64 = tzif_u32(b, h + 40);
    var leap: i64 = tzif_u32(b, h + 28);
    var data: i64 = h + 44;
    var end: i64 = data + tzif_block(b, h, w);
    if ty == 0 || end > b.len() { return utc; }
    var at: Vec<i64> = Vec::new();
    var kind: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < tc {
        if w == 8 { at.push(tzif_i64(b, data + i * 8)); } else { at.push(tzif_i32(b, data + i * 4)); }
        i = i + 1;
    }
    var idx: i64 = data + tc * w;
    i = 0;
    while i < tc {
        var k: i64 = b.get(idx + i);
        if k >= ty { return utc; }
        kind.push(k);
        i = i + 1;
    }
    var types: i64 = idx + tc;
    var chars: i64 = types + ty * 6;
    var off: Vec<i64> = Vec::new();
    var dst: Vec<i64> = Vec::new();
    var abbr: Vec<str> = Vec::new();
    i = 0;
    while i < ty {
        off.push(tzif_i32(b, types + i * 6));
        dst.push(b.get(types + i * 6 + 4));
        var a: i64 = b.get(types + i * 6 + 5);
        var text: str = "";
        while a < ch && b.get(chars + a) != 0 {
            text = text + char_to_str(b.get(chars + a));
            a = a + 1;
        }
        abbr.push(text);
        i = i + 1;
    }
    // before the first change: time type 0 (RFC 8536 3.2)
    var first: i64 = 0;
    var z: Tz = tz_fixed(name, off.get(first), abbr.get(first));
    // version 2+: the footer's POSIX TZ string rules after the last change
    var has_rule: bool = false;
    if w == 8 && end < b.len() && b.get(end) == 10 {
        var j: i64 = end + 1;
        var tzs: str = "";
        while j < b.len() && b.get(j) != 10 {
            tzs = tzs + char_to_str(b.get(j));
            j = j + 1;
        }
        if str_len(tzs) > 0 {
            var r: Tz = tz_from_posix(name, tzs);
            if r.name != "" {
                z = r;
                has_rule = true;
            }
        }
    }
    z.hist = TzHist { at: at, kind: kind, off: off, dst: dst, abbr: abbr, first: first, has_rule: has_rule };
    return z;
}

/// The places a system keeps its compiled zone files
fn tz_dirs() -> Vec<str> {
    var v: Vec<str> = Vec::new();
    match env_var("TZDIR") {
        Option::Some(d) => { if str_len(d) > 0 { v.push(d); } }
        Option::None => {}
    }
    v.push("/usr/share/zoneinfo");
    v.push("/usr/lib/zoneinfo");
    v.push("/usr/share/lib/zoneinfo");
    v.push("/etc/zoneinfo");
    return v;
}

/// The zone `name` ("America/New_York") with its whole past, from the
/// system's time zone database; the built-in table's zone where there is
/// no database (Windows) or no such file.
pub fn tz_load(name: str) -> Tz {
    if str_contains(name, "..") { return tz_find(name); }
    var dirs: Vec<str> = tz_dirs();
    var i: i64 = 0;
    while i < dirs.len() {
        var b: Vec<i64> = fs_read_bytes(dirs.get(i) + "/" + name);
        if tz_tzif_ok(b) { return tz_from_tzif(name, b); }
        i = i + 1;
    }
    return tz_find(name);
}

// ─── POSIX TZ strings: "EST5EDT,M3.2.0,M11.1.0" ─────────────────────────

/// An abbreviation at `i` ("EST", or "<-03>" quoted): [its text, end].
fn tzp_name(s: str, i: i64, out: &mut Vec<str>) -> i64 {
    var n: i64 = str_len(s);
    var j: i64 = i;
    if j < n && str_byte_at(s, j) == 60 {
        var k: i64 = j + 1;
        while k < n && str_byte_at(s, k) != 62 { k = k + 1; }
        out.push(str_slice(s, j + 1, k));
        return k + 1;
    }
    while j < n {
        var c: i64 = str_byte_at(s, j);
        if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { break; }
        j = j + 1;
    }
    out.push(str_slice(s, i, j));
    return j;
}

/// A time "[+-]hh[:mm[:ss]]" at `i` in seconds: [value, end] in `out`.
fn tzp_time(s: str, i: i64, out: &mut Vec<i64>) -> i64 {
    var n: i64 = str_len(s);
    var j: i64 = i;
    var sign: i64 = 1;
    if j < n && (str_byte_at(s, j) == 43 || str_byte_at(s, j) == 45) {
        if str_byte_at(s, j) == 45 { sign = -1; }
        j = j + 1;
    }
    var parts: Vec<i64> = Vec::new();
    var cur: i64 = 0;
    var digits: i64 = 0;
    while j < n {
        var c: i64 = str_byte_at(s, j);
        if c >= 48 && c <= 57 {
            cur = cur * 10 + (c - 48);
            digits = digits + 1;
        } else if c == 58 && digits > 0 {
            parts.push(cur);
            cur = 0;
            digits = 0;
        } else {
            break;
        }
        j = j + 1;
    }
    if digits == 0 { return -1; }
    parts.push(cur);
    var secs: i64 = parts.get(0) * 3600;
    if parts.len() > 1 { secs = secs + parts.get(1) * 60; }
    if parts.len() > 2 { secs = secs + parts.get(2); }
    out.push(sign * secs);
    return j;
}

/// A rule date "Mm.w.d[/time]" at `i`: a TzWhen in `out`, or -1 (the
/// Julian forms "Jn" and "n" are not read).
fn tzp_when(s: str, i: i64, out: &mut Vec<TzWhen>) -> i64 {
    var n: i64 = str_len(s);
    if i >= n || str_byte_at(s, i) != 77 { return -1; }
    var nums: Vec<i64> = Vec::new();
    var j: i64 = i + 1;
    var cur: i64 = 0;
    var digits: i64 = 0;
    while j < n {
        var c: i64 = str_byte_at(s, j);
        if c >= 48 && c <= 57 {
            cur = cur * 10 + (c - 48);
            digits = digits + 1;
        } else if c == 46 && digits > 0 {
            nums.push(cur);
            cur = 0;
            digits = 0;
        } else {
            break;
        }
        j = j + 1;
    }
    if digits == 0 { return -1; }
    nums.push(cur);
    if nums.len() != 3 { return -1; }
    var secs: i64 = 7200;
    if j < n && str_byte_at(s, j) == 47 {
        var tv: Vec<i64> = Vec::new();
        j = tzp_time(s, j + 1, &mut tv);
        if j < 0 { return -1; }
        secs = tv.get(0);
    }
    out.push(TzWhen { month: nums.get(0), week: nums.get(1), weekday: nums.get(2), secs: secs, utc: false });
    return j;
}

/// The zone a POSIX TZ string describes ("CET-1CEST,M3.5.0,M10.5.0/3",
/// "<+0530>-5:30"); a zone whose name is "" when it cannot be read. POSIX
/// offsets count west, so "EST5" is five hours behind UTC.
pub fn tz_from_posix(name: str, s: str) -> Tz {
    var bad: Tz = tz_fixed("", 0, "UTC");
    var names: Vec<str> = Vec::new();
    var tv: Vec<i64> = Vec::new();
    var i: i64 = tzp_name(s, 0, &mut names);
    if str_len(names.get(0)) == 0 { return bad; }
    i = tzp_time(s, i, &mut tv);
    if i < 0 { return bad; }
    var std_off: i64 = 0 - tv.get(0);
    var n: i64 = str_len(s);
    if i >= n { return tz_fixed(name, std_off, names.get(0)); }
    i = tzp_name(s, i, &mut names);
    if str_len(names.get(1)) == 0 { return bad; }
    var dst_off: i64 = std_off + 3600;
    if i < n && str_byte_at(s, i) != 44 {
        i = tzp_time(s, i, &mut tv);
        if i < 0 { return bad; }
        dst_off = 0 - tv.get(1);
    }
    var whens: Vec<TzWhen> = Vec::new();
    if i < n && str_byte_at(s, i) == 44 {
        i = tzp_when(s, i + 1, &mut whens);
        if i < 0 || i >= n || str_byte_at(s, i) != 44 { return bad; }
        i = tzp_when(s, i + 1, &mut whens);
        if i < 0 { return bad; }
    } else {
        // no rule given: the US rule, as POSIX says
        whens.push(tz_when(3, 2, 0, 7200, false));
        whens.push(tz_when(11, 1, 0, 7200, false));
    }
    return Tz { name: name, std_off: std_off, std_abbr: names.get(0), has_dst: true,
        dst_save: dst_off - std_off, dst_abbr: names.get(1),
        start: whens.get(0), end: whens.get(1), hist: tz_no_hist() };
}

/// dt_format of the local time in `z`, plus %Z (abbreviation) and %z
/// (offset, "+HH:MM").
pub fn tz_format(t: LogicalTime, z: Tz, fmt: str) -> str {
    var off: i64 = tz_offset(z, t);
    var f: str = str_replace(fmt, "%Z", tz_abbr(z, t));
    f = str_replace(f, "%z", tz_offset_str(off));
    return dt_format(time_from_timestamp(t.seconds + off), f);
}

/// ISO 8601 with the zone's offset: "2026-07-04T12:00:00-04:00".
pub fn tz_to_iso(t: LogicalTime, z: Tz) -> str {
    return tz_format(t, z, "%Y-%m-%dT%H:%M:%S%z");
}

/// The same moment shown in another zone: wall clock of `to`.
pub fn tz_convert(local: LogicalTime, from: Tz, to: Tz) -> LogicalTime {
    return tz_to_local(tz_from_local(local, from), to);
}
