// Fides fixed-point arithmetic for MCUs without an FPU, pure Fides.
//
// Formats (values held in i64, saturated to the format's width):
//   Q15     16-bit, range [-1, 1 - 2^-15], the DSP sample format
//   Q31     32-bit, range [-1, 1 - 2^-31]
//   Q16.16  32-bit, range [-32768, 32768 - 2^-16], general purpose
// Operations: add, sub, negate, abs (saturating: -1 * -1 in Q15 gives the
// largest value, not an overflow), mul with rounding to nearest, div
// (division by zero saturates towards the dividend's sign), conversion
// to and from f64 and between formats, decimal text, and for Q16.16 the
// square root (integer bit-by-bit square root, exact to the last bit)
// and sine, cosine, atan2 and vector magnitude by CORDIC: 30 shift-and-add
// iterations in Q30 with a table of atan(2^-i), no multiplier needed
// (rotation mode for sin/cos, vectoring mode for atan2/magnitude).
//
// Everything is integer computation; nothing is platform-specific. The
// f64 conversions are for host-side tooling and tests.

module fixed_point;
use vec;
use string;

pub const Q15_ONE: i64 = 32768;
pub const Q15_MAX: i64 = 32767;
pub const Q15_MIN: i64 = -32768;
pub const Q31_MAX: i64 = 2147483647;
pub const Q31_MIN: i64 = -2147483648;
pub const Q16_ONE: i64 = 65536;
pub const Q16_MAX: i64 = 2147483647;
pub const Q16_MIN: i64 = -2147483648;
pub const Q16_PI: i64 = 205887;
pub const Q16_HALF_PI: i64 = 102944;
pub const Q16_TWO_PI: i64 = 411775;

fn fx_sat(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    return v;
}

/// Shift right by `n` rounding to nearest (ties away from zero).
pub fn fx_round_shift(v: i64, n: i64) -> i64 {
    if n <= 0 {
        return v;
    }
    val half: i64 = 1 << (n - 1);
    if v >= 0 {
        return (v + half) >> n;
    }
    return 0 - ((0 - v + half) >> n);
}

/// a / b rounded to nearest (b != 0).
fn fx_div_round(a: i64, b: i64) -> i64 {
    var neg: bool = (a < 0) != (b < 0);
    var x: i64 = a;
    var y: i64 = b;
    if x < 0 {
        x = 0 - x;
    }
    if y < 0 {
        y = 0 - y;
    }
    val q: i64 = (x + y / 2) / y;
    if neg {
        return 0 - q;
    }
    return q;
}

// ─── Q15 ────────────────────────────────────────────────────────────────

pub fn q15_sat(v: i64) -> i64 {
    return fx_sat(v, Q15_MIN, Q15_MAX);
}
pub fn q15_add(a: i64, b: i64) -> i64 {
    return q15_sat(a + b);
}
pub fn q15_sub(a: i64, b: i64) -> i64 {
    return q15_sat(a - b);
}
pub fn q15_neg(a: i64) -> i64 {
    return q15_sat(0 - a);
}
pub fn q15_abs(a: i64) -> i64 {
    if a < 0 {
        return q15_sat(0 - a);
    }
    return a;
}

pub fn q15_mul(a: i64, b: i64) -> i64 {
    return q15_sat(fx_round_shift(a * b, 15));
}

pub fn q15_div(a: i64, b: i64) -> i64 {
    if b == 0 {
        if a < 0 {
            return Q15_MIN;
        }
        return Q15_MAX;
    }
    return q15_sat(fx_div_round(a * 32768, b));
}

/// Multiply-accumulate into a 64-bit accumulator (Q30), as DSP MAC units.
pub fn q15_mac(acc: i64, a: i64, b: i64) -> i64 {
    return acc + a * b;
}

/// The Q15 result of a Q30 accumulator.
pub fn q15_from_acc(acc: i64) -> i64 {
    return q15_sat(fx_round_shift(acc, 15));
}

// ─── Q31 ────────────────────────────────────────────────────────────────

pub fn q31_sat(v: i64) -> i64 {
    return fx_sat(v, Q31_MIN, Q31_MAX);
}
pub fn q31_add(a: i64, b: i64) -> i64 {
    return q31_sat(a + b);
}
pub fn q31_sub(a: i64, b: i64) -> i64 {
    return q31_sat(a - b);
}

pub fn q31_mul(a: i64, b: i64) -> i64 {
    // |a * b| <= 2^62: fits i64.
    return q31_sat(fx_round_shift(a * b, 31));
}

pub fn q31_div(a: i64, b: i64) -> i64 {
    if b == 0 {
        if a < 0 {
            return Q31_MIN;
        }
        return Q31_MAX;
    }
    return q31_sat(fx_div_round(a * 2147483648, b));
}

pub fn q15_to_q31(a: i64) -> i64 {
    return a * 65536;
}
pub fn q31_to_q15(a: i64) -> i64 {
    return q15_sat(fx_round_shift(a, 16));
}

// ─── Q16.16 ─────────────────────────────────────────────────────────────

pub fn q16_sat(v: i64) -> i64 {
    return fx_sat(v, Q16_MIN, Q16_MAX);
}
pub fn q16_from_int(n: i64) -> i64 {
    return q16_sat(n * 65536);
}
pub fn q16_add(a: i64, b: i64) -> i64 {
    return q16_sat(a + b);
}
pub fn q16_sub(a: i64, b: i64) -> i64 {
    return q16_sat(a - b);
}

pub fn q16_mul(a: i64, b: i64) -> i64 {
    return q16_sat(fx_round_shift(a * b, 16));
}

pub fn q16_div(a: i64, b: i64) -> i64 {
    if b == 0 {
        if a < 0 {
            return Q16_MIN;
        }
        return Q16_MAX;
    }
    return q16_sat(fx_div_round(a * 65536, b));
}

/// Integer part, rounding towards minus infinity.
pub fn q16_floor(a: i64) -> i64 {
    return a >> 16;
}

/// Nearest integer.
pub fn q16_round(a: i64) -> i64 {
    return fx_round_shift(a, 16);
}

// ─── Conversions ────────────────────────────────────────────────────────

fn fx_from_f64(x: f64, scale: f64, lo: i64, hi: i64) -> i64 {
    val s: f64 = x * scale;
    if s >= 9.0e18 {
        return hi;
    }
    if s <= -9.0e18 {
        return lo;
    }
    var v: i64 = 0;
    if s >= 0.0 {
        v = (s + 0.5) as i64;
    } else {
        v = 0 - ((0.0 - s + 0.5) as i64);
    }
    return fx_sat(v, lo, hi);
}

pub fn q15_from_f64(x: f64) -> i64 {
    return fx_from_f64(x, 32768.0, Q15_MIN, Q15_MAX);
}
pub fn q31_from_f64(x: f64) -> i64 {
    return fx_from_f64(x, 2147483648.0, Q31_MIN, Q31_MAX);
}
pub fn q16_from_f64(x: f64) -> i64 {
    return fx_from_f64(x, 65536.0, Q16_MIN, Q16_MAX);
}
pub fn q15_to_f64(a: i64) -> f64 {
    return (a as f64) / 32768.0;
}
pub fn q31_to_f64(a: i64) -> f64 {
    return (a as f64) / 2147483648.0;
}
pub fn q16_to_f64(a: i64) -> f64 {
    return (a as f64) / 65536.0;
}

/// A value with `frac` fraction bits as decimal text with `places`
/// decimals, rounded to nearest: fx_to_str(205887, 16, 4) = "3.1416".
pub fn fx_to_str(a: i64, frac: i64, places: i64) -> str {
    var neg: bool = a < 0;
    var v: i64 = a;
    if neg {
        v = 0 - v;
    }
    var p10: i64 = 1;
    var i: i64 = 0;
    while i < places {
        p10 = p10 * 10;
        i = i + 1;
    }
    // round(v * 10^places / 2^frac), done in two parts to avoid overflow.
    val ip: i64 = v >> frac;
    val fr: i64 = v - (ip << frac);
    val fs: i64 = fx_round_shift(fr * p10, frac);
    var whole: i64 = ip;
    var dec: i64 = fs;
    if dec >= p10 {
        whole = whole + 1;
        dec = dec - p10;
    }
    if whole == 0 && dec == 0 {
        neg = false;
    }
    var ds: str = int_to_str(dec);
    while str_len(ds) < places {
        ds = "0" + ds;
    }
    var out: str = int_to_str(whole);
    if places > 0 {
        out = out + "." + ds;
    }
    if neg {
        return "-" + out;
    }
    return out;
}

pub fn q16_to_str(a: i64) -> str {
    return fx_to_str(a, 16, 4);
}
pub fn q15_to_str(a: i64) -> str {
    return fx_to_str(a, 15, 5);
}

/// Parse "-12.375" into a value with `frac` fraction bits (rounded).
pub fn fx_parse(s: str, frac: i64) -> i64 {
    var i: i64 = 0;
    var neg: bool = false;
    if str_len(s) > 0 && str_byte_at(s, 0) == 45 {
        neg = true;
        i = 1;
    }
    var ip: i64 = 0;
    while i < str_len(s) && str_byte_at(s, i) != 46 {
        ip = ip * 10 + (str_byte_at(s, i) - 48);
        i = i + 1;
    }
    var num: i64 = 0;
    var den: i64 = 1;
    if i < str_len(s) {
        i = i + 1;
        while i < str_len(s) && den < 100000000000 {
            num = num * 10 + (str_byte_at(s, i) - 48);
            den = den * 10;
            i = i + 1;
        }
    }
    var v: i64 = (ip << frac) + fx_div_round(num << frac, den);
    if neg {
        v = 0 - v;
    }
    return v;
}

// ─── Square root ────────────────────────────────────────────────────────

/// floor(sqrt(n)) for n >= 0, bit by bit.
pub fn fx_isqrt(n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    var x: i64 = n;
    var res: i64 = 0;
    var bit: i64 = 1 << 62;
    while bit > x {
        bit = bit >> 2;
    }
    while bit != 0 {
        if x >= res + bit {
            x = x - res - bit;
            res = (res >> 1) + bit;
        } else {
            res = res >> 1;
        }
        bit = bit >> 2;
    }
    return res;
}

/// Q16.16 square root (negative input: 0), rounded down to the last bit.
pub fn q16_sqrt(a: i64) -> i64 {
    if a <= 0 {
        return 0;
    }
    return fx_isqrt(a << 16);
}

/// Q15 square root of a non-negative Q15 value.
pub fn q15_sqrt(a: i64) -> i64 {
    if a <= 0 {
        return 0;
    }
    return q15_sat(fx_isqrt(a << 15));
}

// ─── CORDIC ─────────────────────────────────────────────────────────────

/// atan(2^-i) in Q30, i = 0..30.
fn cordic_table() -> Vec<i64> {
    var t: Vec<i64> = Vec::new();
    t.push(843314857);
    t.push(497837829);
    t.push(263043837);
    t.push(133525159);
    t.push(67021687);
    t.push(33543516);
    t.push(16775851);
    t.push(8388437);
    t.push(4194283);
    t.push(2097149);
    t.push(1048576);
    t.push(524288);
    t.push(262144);
    t.push(131072);
    t.push(65536);
    t.push(32768);
    t.push(16384);
    t.push(8192);
    t.push(4096);
    t.push(2048);
    t.push(1024);
    t.push(512);
    t.push(256);
    t.push(128);
    t.push(64);
    t.push(32);
    t.push(16);
    t.push(8);
    t.push(4);
    t.push(2);
    t.push(1);
    return t;
}

/// The CORDIC gain correction 1/K = prod 1/sqrt(1 + 2^-2i), Q30.
pub const CORDIC_K_Q30: i64 = 652032874;
const CORDIC_PI_Q30: i64 = 3373259426;
const CORDIC_ITERS: i64 = 30;

/// sin and cos of a Q16.16 angle in radians, packed in a 2-element Vec
/// [sin, cos] (Q16.16).
pub fn q16_sincos(angle: i64) -> Vec<i64> {
    // Reduce to [-pi, pi] (exactly, in Q30), then to [-pi/2, pi/2].
    var z: i64 = angle * 16384;
    val two_pi: i64 = 2 * CORDIC_PI_Q30;
    z = z % two_pi;
    if z > CORDIC_PI_Q30 {
        z = z - two_pi;
    }
    if z < 0 - CORDIC_PI_Q30 {
        z = z + two_pi;
    }
    var flip: bool = false;
    if z > CORDIC_PI_Q30 / 2 {
        z = z - CORDIC_PI_Q30;
        flip = true;
    } else if z < 0 - CORDIC_PI_Q30 / 2 {
        z = z + CORDIC_PI_Q30;
        flip = true;
    }
    val tab: Vec<i64> = cordic_table();
    var x: i64 = CORDIC_K_Q30;
    var y: i64 = 0;
    var i: i64 = 0;
    while i < CORDIC_ITERS {
        val dx: i64 = y >> i;
        val dy: i64 = x >> i;
        if z >= 0 {
            x = x - dx;
            y = y + dy;
            z = z - tab.get(i);
        } else {
            x = x + dx;
            y = y - dy;
            z = z + tab.get(i);
        }
        i = i + 1;
    }
    if flip {
        x = 0 - x;
        y = 0 - y;
    }
    var out: Vec<i64> = Vec::new();
    out.push(fx_round_shift(y, 14));
    out.push(fx_round_shift(x, 14));
    return out;
}

pub fn q16_sin(angle: i64) -> i64 {
    return q16_sincos(angle).get(0);
}
pub fn q16_cos(angle: i64) -> i64 {
    return q16_sincos(angle).get(1);
}

/// atan2(y, x) in Q16.16 radians, (-pi, pi]; [angle, magnitude] by
/// CORDIC vectoring (magnitude in the inputs' scale).
pub fn q16_polar(y0: i64, x0: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if x0 == 0 && y0 == 0 {
        out.push(0);
        out.push(0);
        return out;
    }
    // Scale the vector into [2^28, 2^29) so the iterations keep precision
    // and cannot overflow (the gain is about 1.65).
    var x: i64 = x0;
    var y: i64 = y0;
    var shift: i64 = 0;
    var m: i64 = x;
    if m < 0 {
        m = 0 - m;
    }
    var my: i64 = y;
    if my < 0 {
        my = 0 - my;
    }
    if my > m {
        m = my;
    }
    while m < 268435456 {
        m = m * 2;
        x = x * 2;
        y = y * 2;
        shift = shift - 1;
    }
    while m >= 536870912 {
        m = m >> 1;
        x = x >> 1;
        y = y >> 1;
        shift = shift + 1;
    }
    var z: i64 = 0;
    if x < 0 {
        if y >= 0 {
            z = CORDIC_PI_Q30;
        } else {
            z = 0 - CORDIC_PI_Q30;
        }
        x = 0 - x;
        y = 0 - y;
    }
    val tab: Vec<i64> = cordic_table();
    var i: i64 = 0;
    while i < CORDIC_ITERS {
        val dx: i64 = y >> i;
        val dy: i64 = x >> i;
        if y > 0 {
            x = x + dx;
            y = y - dy;
            z = z + tab.get(i);
        } else {
            x = x - dx;
            y = y + dy;
            z = z - tab.get(i);
        }
        i = i + 1;
    }
    // magnitude = x * K, back to the input scale.
    var mag: i64 = fx_round_shift(x * CORDIC_K_Q30, 30);
    if shift < 0 {
        mag = fx_round_shift(mag, 0 - shift);
    } else {
        mag = mag << shift;
    }
    out.push(fx_round_shift(z, 14));
    out.push(mag);
    return out;
}

pub fn q16_atan2(y: i64, x: i64) -> i64 {
    return q16_polar(y, x).get(0);
}
pub fn q16_hypot(y: i64, x: i64) -> i64 {
    return q16_polar(y, x).get(1);
}
