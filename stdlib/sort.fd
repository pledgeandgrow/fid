// Fides Sort standard library
//
// Sorting algorithms built on top of Vec.
// All functions sort in-place (modify the Vec) unless otherwise noted.
//
// Usage:
//   use core;
//   use sort;
//   value v = Vec::new();
//   v.push(3); v.push(1); v.push(4); v.push(1); v.push(5);
//   sort_quick(v);
//   // v is now [1, 1, 3, 4, 5]

module sort;

use core;
use vec;

// ─── Comparison-based sorts ─────────────────────────────────────────────

/// Sort a Vec in ascending order using quicksort.
/// In-place, average O(n log n).
pub fn sort_quick(v: Vec) -> void {
    if v.len() <= 1 { return; }
    sort_quick_range(v, 0, v.len() - 1);
}

/// Sort a Vec in descending order using quicksort.
pub fn sort_quick_desc(v: Vec) -> void {
    if v.len() <= 1 { return; }
    sort_quick_desc_range(v, 0, v.len() - 1);
}

/// Sort a Vec using insertion sort. O(n²) but fast for small arrays.
pub fn sort_insertion(v: Vec) -> void {
    var n = v.len();
    var i = 1;
    while i < n {
        var key = v.get(i);
        var j = i - 1;
        var done = 0;
        while j >= 0 && done == 0 {
            if v.get(j) > key {
                v.set(j + 1, v.get(j));
                j = j - 1;
            } else {
                done = 1;
            }
        }
        v.set(j + 1, key);
        i = i + 1;
    }
}

/// Sort a Vec using bubble sort. O(n²), simple but slow.
pub fn sort_bubble(v: Vec) -> void {
    var n = v.len();
    var swapped = true;
    while swapped {
        swapped = false;
        var i = 0;
        while i < n - 1 {
            if v.get(i) > v.get(i + 1) {
                var tmp = v.get(i);
                v.set(i, v.get(i + 1));
                v.set(i + 1, tmp);
                swapped = true;
            }
            i = i + 1;
        }
    }
}

/// Sort a Vec using selection sort. O(n²), minimal swaps.
pub fn sort_selection(v: Vec) -> void {
    var n = v.len();
    var i = 0;
    while i < n - 1 {
        var min_idx = i;
        var j = i + 1;
        while j < n {
            if v.get(j) < v.get(min_idx) {
                min_idx = j;
            }
            j = j + 1;
        }
        if min_idx != i {
            var tmp = v.get(i);
            v.set(i, v.get(min_idx));
            v.set(min_idx, tmp);
        }
        i = i + 1;
    }
}

// ─── Sort with custom comparator ────────────────────────────────────────

/// Sort a Vec using a custom comparator function.
/// Comparator returns: negative if a < b, 0 if equal, positive if a > b.
pub fn sort_by(v: Vec, cmp: fn(i64, i64) -> i64) -> void {
    if v.len() <= 1 { return; }
    sort_by_range(v, 0, v.len() - 1, cmp);
}

// ─── Utility functions ──────────────────────────────────────────────────

/// Check if a Vec is sorted in ascending order.
pub fn sort_is_sorted(v: Vec) -> bool {
    var n = v.len();
    var i = 1;
    while i < n {
        if v.get(i - 1) > v.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Check if a Vec is sorted in descending order.
pub fn sort_is_sorted_desc(v: Vec) -> bool {
    var n = v.len();
    var i = 1;
    while i < n {
        if v.get(i - 1) < v.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Return a sorted copy of a Vec (ascending).
pub fn sort_copy(v: Vec) -> Vec {
    var result = Vec::new();
    var i = 0;
    while i < v.len() {
        result.push(v.get(i));
        i = i + 1;
    }
    sort_quick(result);
    return result;
}

/// Reverse a Vec in place.
pub fn sort_reverse(v: Vec) -> void {
    var n = v.len();
    var i = 0;
    while i < n / 2 {
        var tmp = v.get(i);
        v.set(i, v.get(n - 1 - i));
        v.set(n - 1 - i, tmp);
        i = i + 1;
    }
}

/// Find the index of a value in a sorted Vec using binary search.
/// Returns the index if found, -1 if not found.
pub fn sort_binary_search(v: Vec, target: i64) -> i64 {
    var lo = 0;
    var hi = v.len() - 1;
    while lo <= hi {
        var mid = lo + (hi - lo) / 2;
        var val = v.get(mid);
        if val == target {
            return mid;
        }
        if val < target {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}

/// Find the insertion point for a value in a sorted Vec.
/// Returns the index where the value should be inserted to maintain order.
pub fn sort_lower_bound(v: Vec, target: i64) -> i64 {
    var lo = 0;
    var hi = v.len();
    while lo < hi {
        var mid = lo + (hi - lo) / 2;
        if v.get(mid) < target {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

// ─── Internal helpers ───────────────────────────────────────────────────

pub fn sort_quick_range(v: Vec, lo: i64, hi: i64) -> void {
    if lo >= hi { return; }
    var pivot = v.get(hi);
    var i = lo - 1;
    var j = lo;
    while j < hi {
        if v.get(j) <= pivot {
            i = i + 1;
            var tmp = v.get(i);
            v.set(i, v.get(j));
            v.set(j, tmp);
        }
        j = j + 1;
    }
    i = i + 1;
    var tmp = v.get(i);
    v.set(i, v.get(hi));
    v.set(hi, tmp);
    sort_quick_range(v, lo, i - 1);
    sort_quick_range(v, i + 1, hi);
}

pub fn sort_quick_desc_range(v: Vec, lo: i64, hi: i64) -> void {
    if lo >= hi { return; }
    var pivot = v.get(hi);
    var i = lo - 1;
    var j = lo;
    while j < hi {
        if v.get(j) >= pivot {
            i = i + 1;
            var tmp = v.get(i);
            v.set(i, v.get(j));
            v.set(j, tmp);
        }
        j = j + 1;
    }
    i = i + 1;
    var tmp = v.get(i);
    v.set(i, v.get(hi));
    v.set(hi, tmp);
    sort_quick_desc_range(v, lo, i - 1);
    sort_quick_desc_range(v, i + 1, hi);
}

pub fn sort_by_range(v: Vec, lo: i64, hi: i64, cmp: fn(i64, i64) -> i64) -> void {
    if lo >= hi { return; }
    var pivot = v.get(hi);
    var i = lo - 1;
    var j = lo;
    while j < hi {
        if cmp(v.get(j), pivot) <= 0 {
            i = i + 1;
            var tmp = v.get(i);
            v.set(i, v.get(j));
            v.set(j, tmp);
        }
        j = j + 1;
    }
    i = i + 1;
    var tmp = v.get(i);
    v.set(i, v.get(hi));
    v.set(hi, tmp);
    sort_by_range(v, lo, i - 1, cmp);
    sort_by_range(v, i + 1, hi, cmp);
}
