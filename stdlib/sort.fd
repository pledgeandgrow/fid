// Fides Sort standard library
//
// Sorting algorithms built on top of Vec.
// All functions sort in-place (modify the Vec) unless otherwise noted.
//
// Usage:
//   use core;
//   use sort;
//   value v = Vec::new();
//   v.push(3); v.push(1); v.push(4); v.push(1); v.push(5);
//   sort_quick(v);
//   // v is now [1, 1, 3, 4, 5]

module sort;
use vec;
// ─── Comparison-based sorts ─────────────────────────────────────────────

/// Sort a Vec in ascending order (introsort: median-of-3 quicksort with a
/// heapsort fallback, insertion sort on small ranges, recursion bounded to
/// the smaller side). Worst case O(n log n), recursion depth O(log n) even
/// on sorted or adversarial input.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(3); v.push(1); v.push(4); v.push(1); v.push(5);
///   sort_quick(&mut v);
///   assert_eq(v.get(0), 1);
///   assert_eq(v.get(4), 5);
///   assert(sort_is_sorted(v));
pub fn sort_quick(v: &mut Vec<i64>) -> void {
    if v.len() <= 1 {
        return;
    }
    sort_intro(v, 0, v.len() - 1, sort_depth_limit(v.len()), sort_cmp_asc);
}

/// Sort a Vec in descending order (same introsort, descending comparator).
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(3); v.push(1); v.push(4);
///   sort_quick_desc(&mut v);
///   assert_eq(v.get(0), 4);
///   assert(sort_is_sorted_desc(v));
pub fn sort_quick_desc(v: &mut Vec<i64>) -> void {
    if v.len() <= 1 {
        return;
    }
    sort_intro(v, 0, v.len() - 1, sort_depth_limit(v.len()), sort_cmp_desc);
}

/// Sort a Vec using insertion sort. O(n²) but fast for small arrays.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(2); v.push(-1); v.push(0);
///   sort_insertion(&mut v);
///   assert_eq(v.get(0), -1);
pub fn sort_insertion(v: &mut Vec<i64>) -> void {
    var n = v.len();
    var i = 1;
    while i < n {
        var key = v.get(i);
        var j = i - 1;
        var done = 0;
        while j >= 0 && done == 0 {
            if v.get(j) > key {
                v.set(j + 1, v.get(j));
                j = j - 1;
            } else {
                done = 1;
            }
        }
        v.set(j + 1, key);
        i = i + 1;
    }
}

/// Sort a Vec using bubble sort. O(n²), simple but slow.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(9); v.push(8); v.push(7);
///   sort_bubble(&mut v);
///   assert_eq(v.get(0), 7);
pub fn sort_bubble(v: &mut Vec<i64>) -> void {
    var n = v.len();
    var swapped = true;
    while swapped {
        swapped = false;
        var i = 0;
        while i < n - 1 {
            if v.get(i) > v.get(i + 1) {
                var tmp = v.get(i);
                v.set(i, v.get(i + 1));
                v.set(i + 1, tmp);
                swapped = true;
            }
            i = i + 1;
        }
    }
}

/// Sort a Vec using selection sort. O(n²), minimal swaps.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(5); v.push(2); v.push(8);
///   sort_selection(&mut v);
///   assert_eq(v.get(1), 5);
pub fn sort_selection(v: &mut Vec<i64>) -> void {
    var n = v.len();
    var i = 0;
    while i < n - 1 {
        var min_idx = i;
        var j = i + 1;
        while j < n {
            if v.get(j) < v.get(min_idx) {
                min_idx = j;
            }
            j = j + 1;
        }
        if min_idx != i {
            var tmp = v.get(i);
            v.set(i, v.get(min_idx));
            v.set(min_idx, tmp);
        }
        i = i + 1;
    }
}

// ─── Sort with custom comparator ────────────────────────────────────────

/// Sort a Vec using a custom comparator function.
/// Comparator returns: negative if a < b, 0 if equal, positive if a > b.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(-3); v.push(1); v.push(-2);
///   sort_by(&mut v, fn(a: i64, b: i64) -> i64 { a * a - b * b });
///   assert_eq(v.get(0), 1);
///   assert_eq(v.get(2), -3);
pub fn sort_by(v: &mut Vec<i64>, cmp: fn(i64, i64) -> i64) -> void {
    if v.len() <= 1 {
        return;
    }
    sort_intro(v, 0, v.len() - 1, sort_depth_limit(v.len()), cmp);
}

/// Sort a Vec stably by an integer key extracted from each element
/// (merge sort over a permutation). Elements with equal keys keep their
/// relative order. O(n log n), O(n) extra space.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(30); v.push(12); v.push(21);
///   sort_by_key(&mut v, fn(x: i64) -> i64 { x / 10 });
///   assert_eq(v.get(0), 12);
///   assert_eq(v.get(2), 30);
pub fn sort_by_key(v: &mut Vec<i64>, key: fn(i64) -> i64) -> void {
    var n = v.len();
    if n <= 1 {
        return;
    }
    var keys: Vec<i64> = Vec::new();
    var perm: Vec<i64> = Vec::new();
    var i = 0;
    while i < n {
        keys.push(key(v.get(i)));
        perm.push(i);
        i = i + 1;
    }
    var aux: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        aux.push(0);
        i = i + 1;
    }
    sort_merge_perm(&mut perm, &mut aux, keys, 0, n - 1);
    var tmp: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        tmp.push(v.get(i));
        i = i + 1;
    }
    i = 0;
    while i < n {
        v.set(i, tmp.get(perm.get(i)));
        i = i + 1;
    }
}

/// Find the index of a value in a sorted Vec using binary search, or
/// Option::None if not found.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(3); v.push(5); v.push(7);
///   match sort_binary_search_opt(v, 5) {
///     Option::Some(i) => { assert_eq(i, 2); }
///     Option::None => { assert(false); }
///   }
pub fn sort_binary_search_opt(v: Vec<i64>, target: i64) -> Option<i64> {
    var r = sort_binary_search(v, target);
    if r < 0 {
        return Option::None;
    }
    return Option::Some(r);
}

// ─── Utility functions ──────────────────────────────────────────────────

/// Check if a Vec is sorted in ascending order.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(2); v.push(2);
///   assert(sort_is_sorted(v));
///   v.push(0);
///   assert(!sort_is_sorted(v));
pub fn sort_is_sorted(v: Vec<i64>) -> bool {
    var n = v.len();
    var i = 1;
    while i < n {
        if v.get(i - 1) > v.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Check if a Vec is sorted in descending order.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(3); v.push(3); v.push(1);
///   assert(sort_is_sorted_desc(v));
pub fn sort_is_sorted_desc(v: Vec<i64>) -> bool {
    var n = v.len();
    var i = 1;
    while i < n {
        if v.get(i - 1) < v.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Return a sorted copy of a Vec (ascending).
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(2); v.push(1);
///   var s = sort_copy(v);
///   assert_eq(s.get(0), 1);
///   assert_eq(v.get(0), 2);
pub fn sort_copy(v: Vec<i64>) -> Vec<i64> {
    var result = Vec::new();
    var i = 0;
    while i < v.len() {
        result.push(v.get(i));
        i = i + 1;
    }
    sort_quick(&mut result);
    return result;
}

/// Reverse a Vec in place.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(2); v.push(3);
///   sort_reverse(&mut v);
///   assert_eq(v.get(0), 3);
///   assert_eq(v.get(2), 1);
pub fn sort_reverse(v: &mut Vec<i64>) -> void {
    var n = v.len();
    var i = 0;
    while i < n / 2 {
        var tmp = v.get(i);
        v.set(i, v.get(n - 1 - i));
        v.set(n - 1 - i, tmp);
        i = i + 1;
    }
}

/// Find the index of a value in a sorted Vec using binary search.
/// Returns the index if found, -1 if not found.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(3); v.push(5); v.push(7);
///   assert_eq(sort_binary_search(v, 5), 2);
///   assert_eq(sort_binary_search(v, 4), -1);
pub fn sort_binary_search(v: Vec<i64>, target: i64) -> i64 {
    var lo = 0;
    var hi = v.len() - 1;
    while lo <= hi {
        var mid = lo + (hi - lo) / 2;
        var val = v.get(mid);
        if val == target {
            return mid;
        }
        if val < target {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}

/// Find the insertion point for a value in a sorted Vec.
/// Returns the index where the value should be inserted to maintain order.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(3); v.push(5);
///   assert_eq(sort_lower_bound(v, 4), 2);
///   assert_eq(sort_lower_bound(v, 0), 0);
///   assert_eq(sort_lower_bound(v, 9), 3);
pub fn sort_lower_bound(v: Vec<i64>, target: i64) -> i64 {
    var lo = 0;
    var hi = v.len();
    while lo < hi {
        var mid = lo + (hi - lo) / 2;
        if v.get(mid) < target {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

// ─── Internal helpers ───────────────────────────────────────────────────

/// Sort the elements at indexes lo..=hi in place, ascending (introsort).
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(9); v.push(3); v.push(2); v.push(1);
///   sort_quick_range(&mut v, 1, 3);
///   assert_eq(v.get(0), 9);
///   assert_eq(v.get(1), 1);
pub fn sort_quick_range(v: &mut Vec<i64>, lo: i64, hi: i64) -> void {
    if lo >= hi {
        return;
    }
    sort_intro(v, lo, hi, sort_depth_limit(hi - lo + 1), sort_cmp_asc);
}

/// Sort the elements at indexes lo..=hi in place, descending (introsort).
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(2); v.push(3);
///   sort_quick_desc_range(&mut v, 0, 2);
///   assert_eq(v.get(0), 3);
pub fn sort_quick_desc_range(v: &mut Vec<i64>, lo: i64, hi: i64) -> void {
    if lo >= hi {
        return;
    }
    sort_intro(v, lo, hi, sort_depth_limit(hi - lo + 1), sort_cmp_desc);
}

/// Sort the elements at indexes lo..=hi in place with a comparison
/// function (negative when a comes before b) — introsort.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(3); v.push(2); v.push(1);
///   sort_by_range(&mut v, 0, 1, fn(a: i64, b: i64) -> i64 { a - b });
///   assert_eq(v.get(0), 2);
///   assert_eq(v.get(2), 1);
pub fn sort_by_range(v: &mut Vec<i64>, lo: i64, hi: i64, cmp: fn(i64, i64) -> i64) -> void {
    if lo >= hi {
        return;
    }
    sort_intro(v, lo, hi, sort_depth_limit(hi - lo + 1), cmp);
}

// ─── Introsort internals ────────────────────────────────────────────────

fn sort_cmp_asc(a: i64, b: i64) -> i64 {
    if a < b {
        return -1;
    }
    if a > b {
        return 1;
    }
    return 0;
}

fn sort_cmp_desc(a: i64, b: i64) -> i64 {
    return sort_cmp_asc(b, a);
}

// 2 * floor(log2(n)): the depth at which introsort switches to heapsort.
fn sort_depth_limit(n: i64) -> i64 {
    var d: i64 = 0;
    var m: i64 = n;
    while m > 1 {
        m = m / 2;
        d = d + 1;
    }
    return d * 2;
}

fn sort_swap(v: &mut Vec<i64>, a: i64, b: i64) -> void {
    var tmp = v.get(a);
    v.set(a, v.get(b));
    v.set(b, tmp);
}

// Introsort over [lo..=hi]: median-of-3 Lomuto partition, recursion into
// the smaller side only (so depth is O(log n) even without the fallback),
// heapsort when the depth limit runs out, insertion sort under 17.
fn sort_intro(v: &mut Vec<i64>, lo: i64, hi: i64, depth: i64, cmp: fn(i64, i64) -> i64) -> void {
    var l = lo;
    var h = hi;
    var d = depth;
    while h - l > 16 {
        if d <= 0 {
            sort_heap_range(v, l, h, cmp);
            return;
        }
        d = d - 1;
        var p = sort_partition(v, l, h, cmp);
        if p - l < h - p {
            sort_intro(v, l, p - 1, d, cmp);
            l = p + 1;
        } else {
            sort_intro(v, p + 1, h, d, cmp);
            h = p - 1;
        }
    }
    sort_insertion_range(v, l, h, cmp);
}

// Median-of-3 pivot moved to hi, then Lomuto partition; returns the
// pivot's final index.
fn sort_partition(v: &mut Vec<i64>, lo: i64, hi: i64, cmp: fn(i64, i64) -> i64) -> i64 {
    var mid = lo + (hi - lo) / 2;
    if cmp(v.get(mid), v.get(lo)) < 0 {
        sort_swap(v, mid, lo);
    }
    if cmp(v.get(hi), v.get(mid)) < 0 {
        sort_swap(v, hi, mid);
        if cmp(v.get(mid), v.get(lo)) < 0 {
            sort_swap(v, mid, lo);
        }
    }
    // v[mid] is the median: use it as the pivot at hi.
    sort_swap(v, mid, hi);
    var pivot = v.get(hi);
    var i = lo - 1;
    var j = lo;
    while j < hi {
        if cmp(v.get(j), pivot) <= 0 {
            i = i + 1;
            sort_swap(v, i, j);
        }
        j = j + 1;
    }
    sort_swap(v, i + 1, hi);
    return i + 1;
}

fn sort_insertion_range(v: &mut Vec<i64>, lo: i64, hi: i64, cmp: fn(i64, i64) -> i64) -> void {
    var i = lo + 1;
    while i <= hi {
        var key = v.get(i);
        var j = i - 1;
        var done = false;
        while j >= lo && !done {
            if cmp(v.get(j), key) > 0 {
                v.set(j + 1, v.get(j));
                j = j - 1;
            } else {
                done = true;
            }
        }
        v.set(j + 1, key);
        i = i + 1;
    }
}

// Heapsort over [lo..=hi]: the introsort fallback (no recursion, no
// quadratic case).
fn sort_heap_range(v: &mut Vec<i64>, lo: i64, hi: i64, cmp: fn(i64, i64) -> i64) -> void {
    var n = hi - lo + 1;
    var i = n / 2;
    while i > 0 {
        i = i - 1;
        sort_sift_down(v, lo, i, n, cmp);
    }
    var end = n - 1;
    while end > 0 {
        sort_swap(v, lo, lo + end);
        sort_sift_down(v, lo, 0, end, cmp);
        end = end - 1;
    }
}

// Restore the max-heap (by cmp) rooted at index `root` within
// heap [lo, lo+n).
fn sort_sift_down(v: &mut Vec<i64>, lo: i64, root: i64, n: i64, cmp: fn(i64, i64) -> i64) -> void {
    var r = root;
    var running = true;
    while running {
        var child = 2 * r + 1;
        if child >= n {
            running = false;
        } else {
            var swap_idx = r;
            if cmp(v.get(lo + swap_idx), v.get(lo + child)) < 0 {
                swap_idx = child;
            }
            if child + 1 < n && cmp(v.get(lo + swap_idx), v.get(lo + child + 1)) < 0 {
                swap_idx = child + 1;
            }
            if swap_idx == r {
                running = false;
            } else {
                sort_swap(v, lo + r, lo + swap_idx);
                r = swap_idx;
            }
        }
    }
}

// Stable merge sort over a permutation array: orders perm[lo..=hi] by
// keys[perm[i]] (so sort_by_key stays stable without touching v).
fn sort_merge_perm(perm: &mut Vec<i64>, aux: &mut Vec<i64>, keys: Vec<i64>, lo: i64, hi: i64) -> void {
    if lo >= hi {
        return;
    }
    var mid = lo + (hi - lo) / 2;
    sort_merge_perm(perm, aux, keys, lo, mid);
    sort_merge_perm(perm, aux, keys, mid + 1, hi);
    var i = lo;
    var j = mid + 1;
    var k = lo;
    while i <= mid && j <= hi {
        if keys.get(perm.get(i)) <= keys.get(perm.get(j)) {
            aux.set(k, perm.get(i));
            i = i + 1;
        } else {
            aux.set(k, perm.get(j));
            j = j + 1;
        }
        k = k + 1;
    }
    while i <= mid {
        aux.set(k, perm.get(i));
        i = i + 1;
        k = k + 1;
    }
    while j <= hi {
        aux.set(k, perm.get(j));
        j = j + 1;
        k = k + 1;
    }
    k = lo;
    while k <= hi {
        perm.set(k, aux.get(k));
        k = k + 1;
    }
}
