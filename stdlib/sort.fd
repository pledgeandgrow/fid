// Fides Sort standard library
//
// Sorting algorithms built on top of Vec.
// All functions sort in-place (modify the Vec) unless otherwise noted.
//
// Usage:
//   use core;
//   use sort;
//   value v = Vec::new();
//   v.push(3); v.push(1); v.push(4); v.push(1); v.push(5);
//   sort_quick(v);
//   // v is now [1, 1, 3, 4, 5]

module sort;

use vec;

// ─── Comparison-based sorts ─────────────────────────────────────────────

/// Sort a Vec in ascending order using quicksort.
/// In-place, average O(n log n).
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(3); v.push(1); v.push(4); v.push(1); v.push(5);
///   sort_quick(&mut v);
///   assert_eq(v.get(0), 1);
///   assert_eq(v.get(4), 5);
///   assert(sort_is_sorted(v));
pub fn sort_quick(v: &mut Vec<i64>) -> void {
    if v.len() <= 1 { return; }
    sort_quick_range(v, 0, v.len() - 1);
}

/// Sort a Vec in descending order using quicksort.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(3); v.push(1); v.push(4);
///   sort_quick_desc(&mut v);
///   assert_eq(v.get(0), 4);
///   assert(sort_is_sorted_desc(v));
pub fn sort_quick_desc(v: &mut Vec<i64>) -> void {
    if v.len() <= 1 { return; }
    sort_quick_desc_range(v, 0, v.len() - 1);
}

/// Sort a Vec using insertion sort. O(n²) but fast for small arrays.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(2); v.push(-1); v.push(0);
///   sort_insertion(&mut v);
///   assert_eq(v.get(0), -1);
pub fn sort_insertion(v: &mut Vec<i64>) -> void {
    var n = v.len();
    var i = 1;
    while i < n {
        var key = v.get(i);
        var j = i - 1;
        var done = 0;
        while j >= 0 && done == 0 {
            if v.get(j) > key {
                v.set(j + 1, v.get(j));
                j = j - 1;
            } else {
                done = 1;
            }
        }
        v.set(j + 1, key);
        i = i + 1;
    }
}

/// Sort a Vec using bubble sort. O(n²), simple but slow.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(9); v.push(8); v.push(7);
///   sort_bubble(&mut v);
///   assert_eq(v.get(0), 7);
pub fn sort_bubble(v: &mut Vec<i64>) -> void {
    var n = v.len();
    var swapped = true;
    while swapped {
        swapped = false;
        var i = 0;
        while i < n - 1 {
            if v.get(i) > v.get(i + 1) {
                var tmp = v.get(i);
                v.set(i, v.get(i + 1));
                v.set(i + 1, tmp);
                swapped = true;
            }
            i = i + 1;
        }
    }
}

/// Sort a Vec using selection sort. O(n²), minimal swaps.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(5); v.push(2); v.push(8);
///   sort_selection(&mut v);
///   assert_eq(v.get(1), 5);
pub fn sort_selection(v: &mut Vec<i64>) -> void {
    var n = v.len();
    var i = 0;
    while i < n - 1 {
        var min_idx = i;
        var j = i + 1;
        while j < n {
            if v.get(j) < v.get(min_idx) {
                min_idx = j;
            }
            j = j + 1;
        }
        if min_idx != i {
            var tmp = v.get(i);
            v.set(i, v.get(min_idx));
            v.set(min_idx, tmp);
        }
        i = i + 1;
    }
}

// ─── Sort with custom comparator ────────────────────────────────────────

/// Sort a Vec using a custom comparator function.
/// Comparator returns: negative if a < b, 0 if equal, positive if a > b.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(-3); v.push(1); v.push(-2);
///   sort_by(&mut v, fn(a: i64, b: i64) -> i64 { a * a - b * b });
///   assert_eq(v.get(0), 1);
///   assert_eq(v.get(2), -3);
pub fn sort_by(v: &mut Vec<i64>, cmp: fn(i64, i64) -> i64) -> void {
    if v.len() <= 1 { return; }
    sort_by_range(v, 0, v.len() - 1, cmp);
}

// ─── Utility functions ──────────────────────────────────────────────────

/// Check if a Vec is sorted in ascending order.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(2); v.push(2);
///   assert(sort_is_sorted(v));
///   v.push(0);
///   assert(!sort_is_sorted(v));
pub fn sort_is_sorted(v: Vec<i64>) -> bool {
    var n = v.len();
    var i = 1;
    while i < n {
        if v.get(i - 1) > v.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Check if a Vec is sorted in descending order.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(3); v.push(3); v.push(1);
///   assert(sort_is_sorted_desc(v));
pub fn sort_is_sorted_desc(v: Vec<i64>) -> bool {
    var n = v.len();
    var i = 1;
    while i < n {
        if v.get(i - 1) < v.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// Return a sorted copy of a Vec (ascending).
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(2); v.push(1);
///   var s = sort_copy(v);
///   assert_eq(s.get(0), 1);
///   assert_eq(v.get(0), 2);
pub fn sort_copy(v: Vec<i64>) -> Vec<i64> {
    var result = Vec::new();
    var i = 0;
    while i < v.len() {
        result.push(v.get(i));
        i = i + 1;
    }
    sort_quick(&mut result);
    return result;
}

/// Reverse a Vec in place.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(2); v.push(3);
///   sort_reverse(&mut v);
///   assert_eq(v.get(0), 3);
///   assert_eq(v.get(2), 1);
pub fn sort_reverse(v: &mut Vec<i64>) -> void {
    var n = v.len();
    var i = 0;
    while i < n / 2 {
        var tmp = v.get(i);
        v.set(i, v.get(n - 1 - i));
        v.set(n - 1 - i, tmp);
        i = i + 1;
    }
}

/// Find the index of a value in a sorted Vec using binary search.
/// Returns the index if found, -1 if not found.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(3); v.push(5); v.push(7);
///   assert_eq(sort_binary_search(v, 5), 2);
///   assert_eq(sort_binary_search(v, 4), -1);
pub fn sort_binary_search(v: Vec<i64>, target: i64) -> i64 {
    var lo = 0;
    var hi = v.len() - 1;
    while lo <= hi {
        var mid = lo + (hi - lo) / 2;
        var val = v.get(mid);
        if val == target {
            return mid;
        }
        if val < target {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}

/// Find the insertion point for a value in a sorted Vec.
/// Returns the index where the value should be inserted to maintain order.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(3); v.push(5);
///   assert_eq(sort_lower_bound(v, 4), 2);
///   assert_eq(sort_lower_bound(v, 0), 0);
///   assert_eq(sort_lower_bound(v, 9), 3);
pub fn sort_lower_bound(v: Vec<i64>, target: i64) -> i64 {
    var lo = 0;
    var hi = v.len();
    while lo < hi {
        var mid = lo + (hi - lo) / 2;
        if v.get(mid) < target {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

// ─── Internal helpers ───────────────────────────────────────────────────

/// Quicksort the elements at indexes lo..=hi in place, ascending.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(9); v.push(3); v.push(2); v.push(1);
///   sort_quick_range(&mut v, 1, 3);
///   assert_eq(v.get(0), 9);
///   assert_eq(v.get(1), 1);
pub fn sort_quick_range(v: &mut Vec<i64>, lo: i64, hi: i64) -> void {
    if lo >= hi { return; }
    var pivot = v.get(hi);
    var i = lo - 1;
    var j = lo;
    while j < hi {
        if v.get(j) <= pivot {
            i = i + 1;
            var tmp = v.get(i);
            v.set(i, v.get(j));
            v.set(j, tmp);
        }
        j = j + 1;
    }
    i = i + 1;
    var tmp = v.get(i);
    v.set(i, v.get(hi));
    v.set(hi, tmp);
    sort_quick_range(v, lo, i - 1);
    sort_quick_range(v, i + 1, hi);
}

/// Quicksort the elements at indexes lo..=hi in place, descending.
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(1); v.push(2); v.push(3);
///   sort_quick_desc_range(&mut v, 0, 2);
///   assert_eq(v.get(0), 3);
pub fn sort_quick_desc_range(v: &mut Vec<i64>, lo: i64, hi: i64) -> void {
    if lo >= hi { return; }
    var pivot = v.get(hi);
    var i = lo - 1;
    var j = lo;
    while j < hi {
        if v.get(j) >= pivot {
            i = i + 1;
            var tmp = v.get(i);
            v.set(i, v.get(j));
            v.set(j, tmp);
        }
        j = j + 1;
    }
    i = i + 1;
    var tmp = v.get(i);
    v.set(i, v.get(hi));
    v.set(hi, tmp);
    sort_quick_desc_range(v, lo, i - 1);
    sort_quick_desc_range(v, i + 1, hi);
}

/// Sort the elements at indexes lo..=hi in place with a comparison
/// function (negative when a comes before b).
///
/// Example:
///   var v: Vec<i64> = Vec::new();
///   v.push(3); v.push(2); v.push(1);
///   sort_by_range(&mut v, 0, 1, fn(a: i64, b: i64) -> i64 { a - b });
///   assert_eq(v.get(0), 2);
///   assert_eq(v.get(2), 1);
pub fn sort_by_range(v: &mut Vec<i64>, lo: i64, hi: i64, cmp: fn(i64, i64) -> i64) -> void {
    if lo >= hi { return; }
    var pivot = v.get(hi);
    var i = lo - 1;
    var j = lo;
    while j < hi {
        if cmp(v.get(j), pivot) <= 0 {
            i = i + 1;
            var tmp = v.get(i);
            v.set(i, v.get(j));
            v.set(j, tmp);
        }
        j = j + 1;
    }
    i = i + 1;
    var tmp = v.get(i);
    v.set(i, v.get(hi));
    v.set(hi, tmp);
    sort_by_range(v, lo, i - 1, cmp);
    sort_by_range(v, i + 1, hi, cmp);
}
