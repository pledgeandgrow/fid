// elf_loader: loading ELF64 executables and shared objects into a memory
// image, as a kernel's exec or a dynamic linker does, on top of the stdlib
// elf parser (headers and program headers).
//
// Real: validation (magic, class, byte order, type, machine, segment
// bounds, p_vaddr/p_offset congruence, overlap-free sorted PT_LOAD);
// PT_LOAD segments copied into an image with the .bss part (p_memsz past
// p_filesz) zeroed; a load bias for ET_DYN (ET_EXEC stays where it was
// linked); PT_INTERP and PT_DYNAMIC; the dynamic section (DT_NEEDED,
// DT_SONAME, symbol and string tables, DT_HASH, DT_GNU_HASH, DT_RELA/
// DT_REL, DT_JMPREL with DT_PLTREL, DT_INIT/FINI, DT_INIT_ARRAY);
// relocations for x86-64 (R_X86_64_64, PC32, GLOB_DAT, JUMP_SLOT,
// RELATIVE), AArch64 (R_AARCH64_ABS64, GLOB_DAT, JUMP_SLOT, RELATIVE) and
// RISC-V (R_RISCV_64, RELATIVE, JUMP_SLOT), bound immediately; symbol
// lookup through the SysV hash table and the GNU hash table (bloom filter,
// buckets, chains), both hash functions; segment permissions; the entry
// point; the relocated init array.
//
// The seam: the image is a Vec of bytes standing for memory at
// `base + vmin`; mapping it into an address space with page permissions,
// and jumping to the entry point or the init functions, belong to the
// caller (a kernel or loader that owns memory). Symbols of other objects
// come from `resolve: fn(str) -> i64` (the global scope; -1 when it does
// not know the name), consulted before the object's own definitions, as
// ld.so's lookup order puts the executable and earlier objects first.
// TLS relocations and IRELATIVE (which needs to run code) are reported
// as unsupported.
module elf_loader;
use vec;
use string;
use elf;

pub const PT_NULL: i64 = 0;
pub const PT_LOAD: i64 = 1;
pub const PT_DYNAMIC: i64 = 2;
pub const PT_INTERP: i64 = 3;
pub const PT_PHDR: i64 = 6;
pub const PT_TLS: i64 = 7;
pub const PT_GNU_STACK: i64 = 1685382481;
pub const PT_GNU_RELRO: i64 = 1685382482;

pub const PF_X: i64 = 1;
pub const PF_W: i64 = 2;
pub const PF_R: i64 = 4;

pub const ET_EXEC: i64 = 2;
pub const ET_DYN: i64 = 3;

pub const EM_X86_64: i64 = 62;
pub const EM_AARCH64: i64 = 183;
pub const EM_RISCV: i64 = 243;

pub const DT_NULL: i64 = 0;
pub const DT_NEEDED: i64 = 1;
pub const DT_PLTRELSZ: i64 = 2;
pub const DT_PLTGOT: i64 = 3;
pub const DT_HASH: i64 = 4;
pub const DT_STRTAB: i64 = 5;
pub const DT_SYMTAB: i64 = 6;
pub const DT_RELA: i64 = 7;
pub const DT_RELASZ: i64 = 8;
pub const DT_RELAENT: i64 = 9;
pub const DT_STRSZ: i64 = 10;
pub const DT_SYMENT: i64 = 11;
pub const DT_INIT: i64 = 12;
pub const DT_FINI: i64 = 13;
pub const DT_SONAME: i64 = 14;
pub const DT_REL: i64 = 17;
pub const DT_RELSZ: i64 = 18;
pub const DT_RELENT: i64 = 19;
pub const DT_PLTREL: i64 = 20;
pub const DT_JMPREL: i64 = 23;
pub const DT_INIT_ARRAY: i64 = 25;
pub const DT_FINI_ARRAY: i64 = 26;
pub const DT_INIT_ARRAYSZ: i64 = 27;
pub const DT_FINI_ARRAYSZ: i64 = 28;
pub const DT_GNU_HASH: i64 = 1879047925;

pub const R_X86_64_NONE: i64 = 0;
pub const R_X86_64_64: i64 = 1;
pub const R_X86_64_PC32: i64 = 2;
pub const R_X86_64_GLOB_DAT: i64 = 6;
pub const R_X86_64_JUMP_SLOT: i64 = 7;
pub const R_X86_64_RELATIVE: i64 = 8;
pub const R_AARCH64_NONE: i64 = 0;
pub const R_AARCH64_ABS64: i64 = 257;
pub const R_AARCH64_GLOB_DAT: i64 = 1025;
pub const R_AARCH64_JUMP_SLOT: i64 = 1026;
pub const R_AARCH64_RELATIVE: i64 = 1027;
pub const R_RISCV_NONE: i64 = 0;
pub const R_RISCV_64: i64 = 2;
pub const R_RISCV_RELATIVE: i64 = 3;
pub const R_RISCV_JUMP_SLOT: i64 = 5;

pub const ELF_PAGE: i64 = 4096;

pub struct ElfImage {
    pub err: str,
    pub etype: i64,
    pub machine: i64,
    pub base: i64,
    pub vmin: i64,
    pub mem: Vec<i64>,
    pub entry: i64,
    pub segs: Vec<i64>,
    pub interp: str,
    pub dynamic: i64,
    pub needed: Vec<str>,
    pub soname: str,
    pub strtab: i64,
    pub strsz: i64,
    pub symtab: i64,
    pub syment: i64,
    pub hash: i64,
    pub gnu_hash: i64,
    pub rela: i64,
    pub relasz: i64,
    pub relaent: i64,
    pub rel: i64,
    pub relsz: i64,
    pub relent: i64,
    pub jmprel: i64,
    pub pltrelsz: i64,
    pub pltrel: i64,
    pub init: i64,
    pub fini: i64,
    pub init_array: i64,
    pub init_arraysz: i64,
    pub unresolved: Vec<str>,
}

pub struct ElfSym {
    pub found: bool,
    pub index: i64,
    pub name: str,
    pub value: i64,
    pub size: i64,
    pub info: i64,
    pub shndx: i64,
}

fn el_fail(msg: str) -> ElfImage {
    return ElfImage {
        err: msg, etype: 0, machine: 0, base: 0, vmin: 0, mem: Vec::new(), entry: 0, segs: Vec::new(), interp: "", dynamic: 0, needed: Vec::new(), soname: "", strtab: 0, strsz: 0, symtab: 0, syment: 24, hash: 0, gnu_hash: 0, rela: 0, relasz: 0, relaent: 24, rel: 0, relsz: 0, relent: 16, jmprel: 0, pltrelsz: 0, pltrel: 0, init: 0, fini: 0, init_array: 0, init_arraysz: 0, unresolved: Vec::new()
    };
}

// --- image memory (addresses are link-time virtual addresses) -------------------------

fn el_idx(img: & ElfImage, va: i64) -> i64 {
    return va - img.vmin;
}

pub fn elf_img_in(img: & ElfImage, va: i64, n: i64) -> bool {
    val i: i64 = va - img.vmin;
    return i >= 0 && n >= 0 && i + n <= img.mem.len();
}

pub fn elf_img_u8(img: & ElfImage, va: i64) -> i64 {
    return img.mem.get(el_idx(img, va));
}

pub fn elf_img_u16(img: & ElfImage, va: i64) -> i64 {
    return elf_img_u8(img, va) | (elf_img_u8(img, va + 1) << 8);
}

pub fn elf_img_u32(img: & ElfImage, va: i64) -> i64 {
    return elf_img_u16(img, va) | (elf_img_u16(img, va + 2) << 16);
}

@wrapping pub fn elf_img_u64(img: & ElfImage, va: i64) -> i64 {
    return elf_img_u32(img, va) | (elf_img_u32(img, va + 4) << 32);
}

pub fn elf_img_put64(img: &mut ElfImage, va: i64, v: i64) {
    val i: i64 = el_idx(img, va);
    var k: i64 = 0;
    while k < 8 {
        img.mem.set(i + k, (v >> (8 * k)) & 255);
        k = k + 1;
    }
}

pub fn elf_img_put32(img: &mut ElfImage, va: i64, v: i64) {
    val i: i64 = el_idx(img, va);
    var k: i64 = 0;
    while k < 4 {
        img.mem.set(i + k, (v >> (8 * k)) & 255);
        k = k + 1;
    }
}

/// A NUL-terminated string at link-time address `va`.
pub fn elf_img_str(img: & ElfImage, va: i64) -> str {
    var out: Vec<i64> = Vec::new();
    var a: i64 = va;
    while elf_img_in(img, a, 1) {
        val c: i64 = elf_img_u8(img, a);
        if c == 0 {
            break;
        }
        out.push(c);
        a = a + 1;
    }
    return str_from_bytes(out);
}

/// The run-time address of link-time address `va`.
pub fn elf_addr(img: & ElfImage, va: i64) -> i64 {
    return img.base + va;
}

// --- loading -------------------------------------------------------------------------------

pub fn elf_machine_name(m: i64) -> str {
    if m == EM_X86_64 {
        return "x86-64";
    }
    if m == EM_AARCH64 {
        return "AArch64";
    }
    if m == EM_RISCV {
        return "RISC-V";
    }
    return "machine " + int_to_str(m);
}

/// Load `b` (the file's bytes). `base` is the load bias for ET_DYN (page
/// aligned); ET_EXEC objects load where they were linked.
pub fn elf_load(b: Vec<i64>, base: i64) -> ElfImage {
    val h: Elf64Ehdr = elf_ehdr(b);
    if !h.valid {
        return el_fail("not an ELF64 little-endian file");
    }
    if h.etype != ET_EXEC && h.etype != ET_DYN {
        return el_fail("not an executable or shared object (type " + int_to_str(h.etype) + ")");
    }
    if h.machine != EM_X86_64 && h.machine != EM_AARCH64 && h.machine != EM_RISCV {
        return el_fail("unsupported " + elf_machine_name(h.machine));
    }
    if h.phentsize != 56 || h.phoff + h.phnum * 56 > b.len() {
        return el_fail("bad program header table");
    }
    if base % ELF_PAGE != 0 {
        return el_fail("load base not page aligned");
    }
    var img: ElfImage = el_fail("");
    img.etype = h.etype;
    img.machine = h.machine;
    if h.etype == ET_DYN {
        img.base = base;
    }
    // bounds of the loadable segments
    var vmin: i64 = -1;
    var vmax: i64 = 0;
    var last_end: i64 = -1;
    var i: i64 = 0;
    while i < h.phnum {
        val p: Elf64Phdr = elf_phdr(b, h, i);
        if p.ptype == PT_LOAD {
            if p.filesz > p.memsz || p.offset + p.filesz > b.len() {
                return el_fail("segment " + int_to_str(i) + " out of the file");
            }
            if p.align > 1 && (p.vaddr % p.align) != (p.offset % p.align) {
                return el_fail("segment " + int_to_str(i) + " misaligned");
            }
            if p.vaddr < last_end {
                return el_fail("PT_LOAD segments overlap or are not sorted");
            }
            last_end = p.vaddr + p.memsz;
            val lo: i64 = p.vaddr - p.vaddr % ELF_PAGE;
            if vmin < 0 || lo < vmin {
                vmin = lo;
            }
            if p.vaddr + p.memsz > vmax {
                vmax = p.vaddr + p.memsz;
            }
            img.segs.push(p.vaddr);
            img.segs.push(p.memsz);
            img.segs.push(p.flags);
        } else if p.ptype == PT_INTERP {
            var s: Vec<i64> = Vec::new();
            var k: i64 = 0;
            while k < p.filesz && p.offset + k < b.len() && b.get(p.offset + k) != 0 {
                s.push(b.get(p.offset + k));
                k = k + 1;
            }
            img.interp = str_from_bytes(s);
        } else if p.ptype == PT_DYNAMIC {
            img.dynamic = p.vaddr;
        } else if p.ptype == PT_TLS {
            return el_fail("TLS segments are not supported");
        }
        i = i + 1;
    }
    if vmin < 0 {
        return el_fail("no PT_LOAD segment");
    }
    vmax = (vmax + ELF_PAGE - 1) / ELF_PAGE * ELF_PAGE;
    img.vmin = vmin;
    img.mem = Vec::filled(vmax - vmin, 0);
    i = 0;
    while i < h.phnum {
        val p: Elf64Phdr = elf_phdr(b, h, i);
        if p.ptype == PT_LOAD {
            var k: i64 = 0;
            val d: i64 = p.vaddr - vmin;
            while k < p.filesz {
                img.mem.set(d + k, b.get(p.offset + k));
                k = k + 1;
            }
            // p_memsz - p_filesz: already zero
        }
        i = i + 1;
    }
    img.entry = 0;
    if h.entry != 0 {
        img.entry = img.base + h.entry;
    }
    if img.dynamic != 0 {
        val r: str = elf_read_dynamic(&mut img);
        if str_len(r) > 0 {
            img.err = r;
        }
    }
    return img;
}

/// Read the dynamic section. Returns "" or an error.
fn elf_read_dynamic(img: &mut ElfImage) -> str {
    var a: i64 = img.dynamic;
    var needed_off: Vec<i64> = Vec::new();
    var soname_off: i64 = -1;
    var n: i64 = 0;
    while n < 4096 {
        if !elf_img_in(img, a, 16) {
            return "dynamic section outside the image";
        }
        val tag: i64 = elf_img_u64(img, a);
        val v: i64 = elf_img_u64(img, a + 8);
        if tag == DT_NULL {
            break;
        }
        if tag == DT_NEEDED { needed_off.push(v); }
        else if tag == DT_SONAME { soname_off = v; }
        else if tag == DT_STRTAB { img.strtab = v; }
        else if tag == DT_STRSZ { img.strsz = v; }
        else if tag == DT_SYMTAB { img.symtab = v; }
        else if tag == DT_SYMENT { img.syment = v; }
        else if tag == DT_HASH { img.hash = v; }
        else if tag == DT_GNU_HASH { img.gnu_hash = v; }
        else if tag == DT_RELA { img.rela = v; }
        else if tag == DT_RELASZ { img.relasz = v; }
        else if tag == DT_RELAENT { img.relaent = v; }
        else if tag == DT_REL { img.rel = v; }
        else if tag == DT_RELSZ { img.relsz = v; }
        else if tag == DT_RELENT { img.relent = v; }
        else if tag == DT_JMPREL { img.jmprel = v; }
        else if tag == DT_PLTRELSZ { img.pltrelsz = v; }
        else if tag == DT_PLTREL { img.pltrel = v; }
        else if tag == DT_INIT { img.init = v; }
        else if tag == DT_FINI { img.fini = v; }
        else if tag == DT_INIT_ARRAY { img.init_array = v; }
        else if tag == DT_INIT_ARRAYSZ { img.init_arraysz = v; }
        a = a + 16;
        n = n + 1;
    }
    var i: i64 = 0;
    while i < needed_off.len() {
        img.needed.push(elf_img_str(img, img.strtab + needed_off.get(i)));
        i = i + 1;
    }
    if soname_off >= 0 {
        img.soname = elf_img_str(img, img.strtab + soname_off);
    }
    return "";
}

// --- symbols ---------------------------------------------------------------------------------

/// The SysV ELF hash (DT_HASH).
pub fn elf_sysv_hash(name: str) -> i64 {
    var h: i64 = 0;
    var i: i64 = 0;
    while i < str_len(name) {
        h = (h << 4) + str_byte_at(name, i);
        val g: i64 = h & 4026531840;
        if g != 0 {
            h = h ^ (g >> 24);
        }
        h = h & (4294967295 - g);
        i = i + 1;
    }
    return h;
}

/// The GNU hash (DT_GNU_HASH): djb2, h * 33 + c, 32 bits.
pub fn elf_gnu_hash(name: str) -> i64 {
    var h: i64 = 5381;
    var i: i64 = 0;
    while i < str_len(name) {
        h = (h * 33 + str_byte_at(name, i)) & 4294967295;
        i = i + 1;
    }
    return h;
}

/// Dynamic symbol `idx`.
pub fn elf_sym(img: & ElfImage, idx: i64) -> ElfSym {
    val a: i64 = img.symtab + idx * img.syment;
    if img.symtab == 0 || !elf_img_in(img, a, 24) {
        return ElfSym { found: false, index: idx, name: "", value: 0, size: 0, info: 0, shndx: 0 };
    }
    return ElfSym {
        found: true, index: idx, name: elf_img_str(img, img.strtab + elf_img_u32(img, a)), info: elf_img_u8(img, a + 4), shndx: elf_img_u16(img, a + 6), value: elf_img_u64(img, a + 8), size: elf_img_u64(img, a + 16)
    };
}

fn el_no_sym() -> ElfSym {
    return ElfSym { found: false, index: -1, name: "", value: 0, size: 0, info: 0, shndx: 0 };
}

/// Look a name up through DT_HASH.
pub fn elf_lookup_sysv(img: & ElfImage, name: str) -> ElfSym {
    if img.hash == 0 {
        return el_no_sym();
    }
    val nbucket: i64 = elf_img_u32(img, img.hash);
    val nchain: i64 = elf_img_u32(img, img.hash + 4);
    if nbucket == 0 {
        return el_no_sym();
    }
    val h: i64 = elf_sysv_hash(name);
    var idx: i64 = elf_img_u32(img, img.hash + 8 + 4 * (h % nbucket));
    var guard_v: i64 = 0;
    while idx != 0 && idx < nchain && guard_v <= nchain {
        val s: ElfSym = elf_sym(img, idx);
        if s.name == name {
            return s;
        }
        idx = elf_img_u32(img, img.hash + 8 + 4 * nbucket + 4 * idx);
        guard_v = guard_v + 1;
    }
    return el_no_sym();
}

/// Look a name up through DT_GNU_HASH (bloom filter first).
pub fn elf_lookup_gnu(img: & ElfImage, name: str) -> ElfSym {
    if img.gnu_hash == 0 {
        return el_no_sym();
    }
    val g: i64 = img.gnu_hash;
    val nbuckets: i64 = elf_img_u32(img, g);
    val symoff: i64 = elf_img_u32(img, g + 4);
    val bloom_size: i64 = elf_img_u32(img, g + 8);
    val shift: i64 = elf_img_u32(img, g + 12);
    if nbuckets == 0 || bloom_size == 0 {
        return el_no_sym();
    }
    val h: i64 = elf_gnu_hash(name);
    val word: i64 = elf_img_u64(img, g + 16 + 8 * ((h / 64) % bloom_size));
    val b1: i64 = h % 64;
    val b2: i64 = (h >> shift) % 64;
    if ((word >> b1) & 1) == 0 || ((word >> b2) & 1) == 0 {
        return el_no_sym();
    }
    val buckets: i64 = g + 16 + 8 * bloom_size;
    val chains: i64 = buckets + 4 * nbuckets;
    var idx: i64 = elf_img_u32(img, buckets + 4 * (h % nbuckets));
    if idx < symoff {
        return el_no_sym();
    }
    var guard_v: i64 = 0;
    while guard_v < 1000000 {
        val h2: i64 = elf_img_u32(img, chains + 4 * (idx - symoff));
        if (h | 1) == (h2 | 1) {
            val s: ElfSym = elf_sym(img, idx);
            if s.name == name {
                return s;
            }
        }
        if (h2 & 1) != 0 {
            break;
        }
        idx = idx + 1;
        guard_v = guard_v + 1;
    }
    return el_no_sym();
}

/// A symbol the object defines (GNU hash preferred, SysV otherwise):
/// its run-time address, or -1.
pub fn elf_lookup(img: & ElfImage, name: str) -> i64 {
    var s: ElfSym = elf_lookup_gnu(img, name);
    if !s.found && img.gnu_hash == 0 {
        s = elf_lookup_sysv(img, name);
    }
    if !s.found || s.shndx == 0 {
        return -1;
    }
    return img.base + s.value;
}

/// How many dynamic symbols there are (DT_HASH's nchain, or the end of
/// the last GNU hash chain).
pub fn elf_sym_count(img: & ElfImage) -> i64 {
    if img.hash != 0 {
        return elf_img_u32(img, img.hash + 4);
    }
    if img.gnu_hash == 0 {
        return 0;
    }
    val g: i64 = img.gnu_hash;
    val nbuckets: i64 = elf_img_u32(img, g);
    val symoff: i64 = elf_img_u32(img, g + 4);
    val bloom_size: i64 = elf_img_u32(img, g + 8);
    val buckets: i64 = g + 16 + 8 * bloom_size;
    var last: i64 = 0;
    var i: i64 = 0;
    while i < nbuckets {
        val v: i64 = elf_img_u32(img, buckets + 4 * i);
        if v > last {
            last = v;
        }
        i = i + 1;
    }
    if last < symoff {
        return symoff;
    }
    val chains: i64 = buckets + 4 * nbuckets;
    while (elf_img_u32(img, chains + 4 * (last - symoff)) & 1) == 0 {
        last = last + 1;
    }
    return last + 1;
}

// --- relocation ----------------------------------------------------------------------------

fn el_sym_addr(img: &mut ElfImage, symidx: i64, resolve: fn(str) -> i64) -> i64 {
    if symidx == 0 {
        return 0;
    }
    val s: ElfSym = elf_sym(img, symidx);
    val r: i64 = resolve(s.name);
    if r >= 0 {
        return r;
    }
    if s.shndx != 0 {
        return img.base + s.value;
    }
    // weak undefined symbols resolve to 0
    if (s.info >> 4) == 2 {
        return 0;
    }
    img.unresolved.push(s.name);
    img.err = "unresolved symbol " + s.name;
    return -1;
}

/// Apply one relocation; returns 0, or -1 when unsupported / unresolved.
@wrapping fn el_apply(img: &mut ElfImage, off: i64, rtype: i64, symidx: i64, addend: i64, resolve: fn(str) -> i64) -> i64 {
    if !elf_img_in(img, off, 8) {
        img.err = "relocation outside the image at " + int_to_hex(off);
        return -1;
    }
    val m: i64 = img.machine;
    var kind: i64 = 0;
    // kind: 1 = B + A, 2 = S + A (64-bit), 3 = S (64-bit), 4 = S + A - P (32-bit), 0 = none
    if m == EM_X86_64 {
        if rtype == R_X86_64_RELATIVE { kind = 1; }
        else if rtype == R_X86_64_64 { kind = 2; }
        else if rtype == R_X86_64_GLOB_DAT || rtype == R_X86_64_JUMP_SLOT { kind = 3; }
        else if rtype == R_X86_64_PC32 { kind = 4; }
        else if rtype != R_X86_64_NONE { kind = -1; }
    } else if m == EM_AARCH64 {
        if rtype == R_AARCH64_RELATIVE { kind = 1; }
        else if rtype == R_AARCH64_ABS64 || rtype == R_AARCH64_GLOB_DAT || rtype == R_AARCH64_JUMP_SLOT { kind = 2; }
        else if rtype != R_AARCH64_NONE { kind = -1; }
    } else {
        if rtype == R_RISCV_RELATIVE { kind = 1; }
        else if rtype == R_RISCV_64 { kind = 2; }
        else if rtype == R_RISCV_JUMP_SLOT { kind = 3; }
        else if rtype != R_RISCV_NONE { kind = -1; }
    }
    if kind < 0 {
        img.err = "unsupported relocation type " + int_to_str(rtype);
        return -1;
    }
    if kind == 0 {
        return 0;
    }
    if kind == 1 {
        elf_img_put64(img, off, img.base + addend);
        return 0;
    }
    val s: i64 = el_sym_addr(img, symidx, resolve);
    if s < 0 {
        return -1;
    }
    if kind == 2 {
        elf_img_put64(img, off, s + addend);
    } else if kind == 3 {
        elf_img_put64(img, off, s);
    } else {
        elf_img_put32(img, off, (s + addend - (img.base + off)) & 4294967295);
    }
    return 0;
}

fn el_table(img: &mut ElfImage, start: i64, size: i64, ent: i64, has_addend: bool, resolve: fn(str) -> i64) -> i64 {
    if start == 0 || size == 0 {
        return 0;
    }
    if ent <= 0 {
        img.err = "bad relocation entry size";
        return -1;
    }
    var n: i64 = 0;
    var a: i64 = start;
    while a + ent <= start + size {
        if !elf_img_in(img, a, ent) {
            img.err = "relocation table outside the image";
            return -1;
        }
        val off: i64 = elf_img_u64(img, a);
        val info: i64 = elf_img_u64(img, a + 8);
        var addend: i64 = 0;
        if has_addend {
            addend = elf_img_u64(img, a + 16);
        } else if elf_img_in(img, off, 8) {
            addend = elf_img_u64(img, off);
        }
        if el_apply(img, off, info & 4294967295, (info >> 32) & 4294967295, addend, resolve) < 0 {
            return -1;
        }
        n = n + 1;
        a = a + ent;
    }
    return n;
}

/// Apply every relocation (DT_RELA, DT_REL and the PLT ones) now.
/// Returns how many were applied, or -1 (see img.err and img.unresolved).
pub fn elf_relocate(img: &mut ElfImage, resolve: fn(str) -> i64) -> i64 {
    val a: i64 = el_table(img, img.rela, img.relasz, img.relaent, true, resolve);
    if a < 0 {
        return -1;
    }
    val b: i64 = el_table(img, img.rel, img.relsz, img.relent, false, resolve);
    if b < 0 {
        return -1;
    }
    var c: i64 = 0;
    if img.pltrel == DT_REL {
        c = el_table(img, img.jmprel, img.pltrelsz, img.relent, false, resolve);
    } else {
        c = el_table(img, img.jmprel, img.pltrelsz, img.relaent, true, resolve);
    }
    if c < 0 {
        return -1;
    }
    if img.unresolved.len() > 0 {
        img.err = "unresolved symbol " + img.unresolved.get(0);
        return -1;
    }
    return a + b + c;
}

/// The run-time addresses of the init array (after relocation), to be
/// called in order by whoever runs the object.
pub fn elf_init_functions(img: & ElfImage) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if img.init != 0 {
        out.push(img.base + img.init);
    }
    var i: i64 = 0;
    while i + 8 <= img.init_arraysz {
        out.push(elf_img_u64(img, img.init_array + i));
        i = i + 8;
    }
    return out;
}

/// "R-X"-style permissions of the segment containing `va`, "" outside.
pub fn elf_perms_at(img: & ElfImage, va: i64) -> str {
    var i: i64 = 0;
    while i < img.segs.len() {
        val lo: i64 = img.segs.get(i);
        val f: i64 = img.segs.get(i + 2);
        if va >= lo && va < lo + img.segs.get(i + 1) {
            var s: str = "-";
            if (f & PF_R) != 0 {
                s = "R";
            }
            if (f & PF_W) != 0 {
                s = s + "W";
            } else {
                s = s + "-";
            }
            if (f & PF_X) != 0 {
                s = s + "X";
            } else {
                s = s + "-";
            }
            return s;
        }
        i = i + 3;
    }
    return "";
}
