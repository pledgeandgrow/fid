// Fides Path standard library
//
// File path manipulation utilities. Pure string operations — no filesystem access.
// Handles both Unix (/) and Windows (\) separators, preferring Unix: every
// function reads either, and what it builds uses '/'. A Windows drive
// prefix ("C:") and a UNC prefix ("\\server") are part of the root.
//
// Usage:
//   use path;
//   println(path_join("foo", "bar"));        // "foo/bar"
//   println(path_dirname("/a/b/c.txt"));      // "/a/b"
//   println(path_basename("/a/b/c.txt"));     // "c.txt"
//   println(path_extension("/a/b/c.txt"));    // ".txt"

module path;

use vec;
use string;

// ─── Separator ──────────────────────────────────────────────────────────

/// Path separator (always '/' for portability).
pub const PATH_SEP: str = "/";

/// Get the path separator character.
pub fn path_sep() -> str {
    return "/";
}

fn path_is_sep(c: i64) -> bool {
    return c == 47 || c == 92;
}

/// Index of the last separator ('/' or '\\'), or -1.
fn path_last_sep(path: str) -> i64 {
    var i: i64 = str_len(path) - 1;
    while i >= 0 {
        if path_is_sep(str_byte_at(path, i)) { return i; }
        i = i - 1;
    }
    return -1;
}

/// Length of a Windows drive prefix ("C:"), or 0.
fn path_drive_len(path: str) -> i64 {
    if str_len(path) >= 2 && str_byte_at(path, 1) == 58 {
        var c: i64 = str_byte_at(path, 0);
        if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) { return 2; }
    }
    return 0;
}

/// The root of a path: "/", "C:/", "C:", "//" (UNC), or "" (relative).
pub fn path_root(path: str) -> str {
    var d: i64 = path_drive_len(path);
    var n: i64 = str_len(path);
    if d > 0 {
        if n > d && path_is_sep(str_byte_at(path, d)) { return str_slice(path, 0, d) + "/"; }
        return str_slice(path, 0, d);
    }
    if n >= 2 && path_is_sep(str_byte_at(path, 0)) && path_is_sep(str_byte_at(path, 1)) { return "//"; }
    if n >= 1 && path_is_sep(str_byte_at(path, 0)) { return "/"; }
    return "";
}

// ─── Join ───────────────────────────────────────────────────────────────

/// Join two path components with a separator.
/// path_join("foo", "bar") → "foo/bar"
/// path_join("foo/", "bar") → "foo/bar"
/// path_join("foo", "/bar") → "foo/bar"
pub fn path_join(a: str, b: str) -> str {
    if str_len(a) == 0 { return b; }
    if str_len(b) == 0 { return a; }
    // an absolute b replaces a, as with every OS path API
    if path_drive_len(b) > 0 { return b; }
    var a_ends_sep = path_is_sep(str_byte_at(a, str_len(a) - 1));
    var b_starts_sep = path_is_sep(str_byte_at(b, 0));
    if a_ends_sep && b_starts_sep {
        return a + str_slice(b, 1, str_len(b));
    }
    if !a_ends_sep && !b_starts_sep {
        return (a + "/") + b;
    }
    return a + b;
}

/// Join multiple path components.
/// path_join_many(["a", "b", "c"]) → "a/b/c"
pub fn path_join_many(parts: Vec<str>) -> str {
    if parts.len() == 0 { return ""; }
    var result = parts.get(0);
    var i = 1;
    while i < parts.len() {
        result = path_join(result, parts.get(i));
        i = i + 1;
    }
    return result;
}

// ─── Split ──────────────────────────────────────────────────────────────

/// Split a path into (dirname, basename).
/// path_split("/a/b/c.txt") → ("/a/b", "c.txt")
pub fn path_split(path: str) -> Vec<str> {
    var result = Vec::new();
    var last_sep = path_last_sep(path);
    if last_sep < 0 {
        result.push("");
        result.push(path);
        return result;
    }
    if last_sep == 0 {
        result.push("/");
        result.push(str_slice(path, 1, str_len(path)));
        return result;
    }
    result.push(str_slice(path, 0, last_sep));
    result.push(str_slice(path, last_sep + 1, str_len(path)));
    return result;
}

/// Get the directory name of a path.
/// path_dirname("/a/b/c.txt") → "/a/b"
pub fn path_dirname(path: str) -> str {
    var last_sep = path_last_sep(path);
    if last_sep < 0 {
        // "C:file" -> "C:"
        if path_drive_len(path) > 0 { return str_slice(path, 0, 2); }
        return "";
    }
    if last_sep == 0 { return "/"; }
    // "C:\\x" -> "C:/"
    if last_sep == 2 && path_drive_len(path) > 0 { return str_slice(path, 0, 2) + "/"; }
    return str_slice(path, 0, last_sep);
}

/// Get the base name (file name) of a path.
/// path_basename("/a/b/c.txt") → "c.txt"
pub fn path_basename(path: str) -> str {
    var last_sep = path_last_sep(path);
    if last_sep < 0 {
        var d: i64 = path_drive_len(path);
        if d > 0 { return str_slice(path, d, str_len(path)); }
        return path;
    }
    return str_slice(path, last_sep + 1, str_len(path));
}

// ─── Extension ──────────────────────────────────────────────────────────

/// Get the file extension (including the dot).
/// path_extension("file.txt") → ".txt"
/// path_extension("file") → ""
/// path_extension("file.tar.gz") → ".gz"
pub fn path_extension(path: str) -> str {
    var base = path_basename(path);
    var last_dot = str_rfind(base, ".");
    if last_dot <= 0 { return ""; }  // no dot or leading dot
    return str_slice(base, last_dot, str_len(base));
}

/// Get the file name without extension.
/// path_stem("file.txt") → "file"
/// path_stem("file.tar.gz") → "file.tar"
pub fn path_stem(path: str) -> str {
    var base = path_basename(path);
    var last_dot = str_rfind(base, ".");
    if last_dot <= 0 { return base; }
    return str_slice(base, 0, last_dot);
}

/// Change the extension of a path.
/// path_set_extension("file.txt", ".md") → "file.md"
/// path_set_extension("file", ".txt") → "file.txt"
pub fn path_set_extension(path: str, ext: str) -> str {
    var dir = path_dirname(path);
    var stem = path_stem(path);
    var result = stem + ext;
    if str_len(dir) > 0 {
        return path_join(dir, result);
    }
    return result;
}

// ─── Normalize ──────────────────────────────────────────────────────────

/// Normalize a path by resolving "." and ".." components.
/// path_normalize("a/./b/../c") → "a/c"
/// path_normalize("/a/b/../c") → "/a/c"
pub fn path_normalize(path0: str) -> str {
    if str_len(path0) == 0 { return "."; }
    // Windows separators read as '/', the drive or UNC prefix kept
    var path: str = str_replace(path0, "\\", "/");
    var prefix: str = "";
    var d: i64 = path_drive_len(path);
    if d > 0 {
        prefix = str_slice(path, 0, d);
        path = str_slice(path, d, str_len(path));
        if str_len(path) == 0 { return prefix; }
    } else if str_len(path) >= 2 && str_byte_at(path, 0) == 47 && str_byte_at(path, 1) == 47 {
        prefix = "/";
        path = str_slice(path, 1, str_len(path));
    }
    if str_len(prefix) > 0 {
        return prefix + path_normalize_unix(path);
    }
    return path_normalize_unix(path);
}

fn path_normalize_unix(path: str) -> str {
    if str_len(path) == 0 { return "."; }
    var is_absolute = str_byte_at(path, 0) == 47;
    var parts = str_split(path, "/");
    var stack = Vec::new();
    var i = 0;
    while i < parts.len() {
        var part = parts.get(i);
        if str_equal(part, ".") || str_len(part) == 0 {
            // skip
        } else if str_equal(part, "..") {
            if !stack.is_empty() && !str_equal(stack.last(), "..") {
                stack.pop();
            } else if !is_absolute {
                stack.push("..");
            }
        } else {
            stack.push(part);
        }
        i = i + 1;
    }
    if stack.is_empty() {
        if is_absolute { return "/"; }
        return ".";
    }
    var result = Vec::new();
    if is_absolute {
        result.push("");
    }
    var j = 0;
    while j < stack.len() {
        result.push(stack.get(j));
        j = j + 1;
    }
    return str_join(result, "/");
}

// ─── Predicates ─────────────────────────────────────────────────────────

/// Check if a path is absolute.
pub fn path_is_absolute(path: str) -> bool {
    if str_len(path) == 0 { return false; }
    if path_is_sep(str_byte_at(path, 0)) { return true; }
    // "C:\\x" or "C:/x"; "C:x" is relative to the drive's current directory
    var d: i64 = path_drive_len(path);
    return d > 0 && str_len(path) > d && path_is_sep(str_byte_at(path, d));
}

/// Check if a path is relative.
pub fn path_is_relative(path: str) -> bool {
    return !path_is_absolute(path);
}

/// Check if a path has the given extension.
pub fn path_has_extension(path: str, ext: str) -> bool {
    var actual = path_extension(path);
    return str_equal(actual, ext);
}

// ─── Components ─────────────────────────────────────────────────────────

/// Split a path into its components.
/// path_components("/a/b/c") → ["", "a", "b", "c"]
pub fn path_components(path: str) -> Vec<str> {
    return str_split(str_replace(path, "\\", "/"), "/");
}

/// Get the parent directory (same as dirname but handles trailing slashes).
pub fn path_parent(path: str) -> str {
    var end = str_len(path);
    while end > 1 && path_is_sep(str_byte_at(path, end - 1)) {
        end = end - 1;
    }
    return path_dirname(str_slice(path, 0, end));
}

/// Get the number of path components.
pub fn path_depth(path: str) -> i64 {
    var normalized = path_normalize(path);
    var parts = str_split(normalized, "/");
    var count = 0;
    var i = 0;
    while i < parts.len() {
        var p = parts.get(i);
        if str_len(p) > 0 && !str_equal(p, ".") {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}
