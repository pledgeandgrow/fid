// safetensors loader — the standard weight-file format (HuggingFace).
// Layout: u64le header_len | JSON header | raw tensor data.
// Header maps name -> {"dtype","shape":[...],"data_offsets":[a,b]} plus
// an optional "__metadata__" object. All access is bounds-checked.
module safetensors;

use vec;
use string;
use json;
use math;

pub struct StFile {
    pub ok: bool,
    pub header: str,         // parsed JSON header (string-encoded)
    pub data_off: i64,       // absolute offset of the tensor region
    pub names: Vec<str>,     // tensor names (excluding __metadata__)
}

fn st_u64le(b: Vec<i64>, o: i64) -> i64 {
    var v: i64 = 0;
    var i: i64 = 0;
    while i < 4 { v = v + b.get(o + i) * (1 << (i * 8)); i = i + 1; }
    var hi: i64 = 0;
    while i < 8 { hi = hi + b.get(o + i) * (1 << ((i - 4) * 8)); i = i + 1; }
    if hi > 0 { return -1; }                  // header >4GiB unsupported
    return v;
}

/// Parse the file bytes. Returns ok=false on any malformed field.
pub fn st_open(b: Vec<i64>) -> StFile {
    var st: StFile = StFile{ok: false, header: "", data_off: 0,
        names: Vec::new()};
    if b.len() < 8 { return st; }
    var hlen: i64 = st_u64le(b, 0);
    if hlen <= 0 || 8 + hlen > b.len() { return st; }
    var hb: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < hlen { hb.push(b.get(8 + i)); i = i + 1; }
    var h: str = json_parse_safe(str_from_bytes(hb));
    if !str_equal(json_type_safe(h), "object") { return st; }
    var keys: Vec<str> = json_keys(h);
    var names: Vec<str> = Vec::new();
    i = 0;
    while i < keys.len() {
        var k: str = keys.get(i);
        if !str_equal(k, "__metadata__") { names.push(k); }
        i = i + 1;
    }
    st.header = h;
    st.data_off = 8 + hlen;
    st.names = names;
    st.ok = true;
    return st;
}

/// Names of all tensors in the file.
pub fn st_names(st: StFile) -> Vec<str> { return st.names; }

// --- dtype -------------------------------------------------------------------

/// Bytes per element for a safetensors dtype string, or 0 if unknown.
pub fn st_dtype_size(dt: str) -> i64 {
    if str_equal(dt, "BOOL") || str_equal(dt, "U8") || str_equal(dt, "I8") {
        return 1;
    }
    if str_equal(dt, "F16") || str_equal(dt, "BF16") || str_equal(dt, "U16")
        || str_equal(dt, "I16") { return 2; }
    if str_equal(dt, "F32") || str_equal(dt, "U32") || str_equal(dt, "I32") {
        return 4;
    }
    if str_equal(dt, "F64") || str_equal(dt, "U64") || str_equal(dt, "I64") {
        return 8;
    }
    if str_equal(dt, "F8_E4M3") || str_equal(dt, "F8_E5M2") { return 1; }
    if str_equal(dt, "F4") { return 1; }      // packed nybble — byte count
    return 0;
}

// --- tensor access -----------------------------------------------------------

pub struct StTensor {
    pub found: bool,
    pub dtype: str,
    pub shape: Vec<i64>,
    pub data_begin: i64,     // absolute byte offset in the file
    pub data_end: i64,
}

/// Look up a tensor by name; found=false when absent or malformed.
pub fn st_tensor(b: Vec<i64>, st: StFile, name: str) -> StTensor {
    var t: StTensor = StTensor{found: false, dtype: "", shape: Vec::new(),
        data_begin: 0, data_end: 0};
    if !json_has(st.header, name) { return t; }
    var ent: str = json_get_safe(st.header, name);
    if !str_equal(json_type_safe(ent), "object") { return t; }
    var dt: str = json_get_str(ent, "dtype");
    var sh: str = json_get_safe(ent, "shape");
    var offs: str = json_get_safe(ent, "data_offsets");
    if !str_equal(json_type_safe(sh), "array") { return t; }
    if !str_equal(json_type_safe(offs), "array") { return t; }
    if json_len_safe(offs) != 2 { return t; }
    var shape: Vec<i64> = Vec::new();
    var i: i64 = 0;
    var total: i64 = 1;
    while i < json_len_safe(sh) {
        var d: i64 = json_at_int(sh, i, 0);
        if d <= 0 { return t; }
        shape.push(d);
        total = total * d;
        i = i + 1;
    }
    var a: i64 = json_at_int(offs, 0, -1);
    var e: i64 = json_at_int(offs, 1, -1);
    if a < 0 || e < a { return t; }
    var dsz: i64 = st_dtype_size(dt);
    if dsz == 0 { return t; }
    if e - a != total * dsz { return t; }     // data len must match shape
    if st.data_off + e > b.len() { return t; }
    t.found = true;
    t.dtype = dt;
    t.shape = shape;
    t.data_begin = st.data_off + a;
    t.data_end = st.data_off + e;
    return t;
}

/// Element count implied by the shape.
pub fn st_elems(t: StTensor) -> i64 {
    var n: i64 = 1;
    var i: i64 = 0;
    while i < t.shape.len() { n = n * t.shape.get(i); i = i + 1; }
    return n;
}

// --- element reads ------------------------------------------------------------

fn rd_u16(b: Vec<i64>, o: i64) -> i64 {
    return b.get(o) + b.get(o + 1) * 256;
}
fn rd_u32(b: Vec<i64>, o: i64) -> i64 {
    return rd_u16(b, o) + rd_u16(b, o + 2) * 65536;
}

/// Decode IEEE f32 bits to f64 in pure math (the interp has no
/// f32-from-bits primitive). sign|exp(8)|man(23), normals/subnormals.
/// inf/nan return the largest finite magnitude with sign.
pub fn st_f32bits_f64(bits: i64) -> f64 {
    var sign: f64 = 1.0;
    if (bits & 0x80000000) != 0 { sign = -1.0; }
    var exp: i64 = (bits >> 23) & 255;
    var man: i64 = bits & 0x7FFFFF;
    if exp == 255 {
        return sign * math_pow(2.0, 1024.0);            // inf
    }
    if exp == 0 {
        if man == 0 { return sign * 0.0; }
        return sign * (man as f64) * math_pow(2.0, -149.0);   // subnormal
    }
    return sign * (1.0 + (man as f64) / 8388608.0) * math_pow(2.0, (exp - 127) as f64);
}

/// f32 element i of a tensor whose dtype is F32.
pub fn st_f32(b: Vec<i64>, t: StTensor, i: i64) -> f64 {
    return st_f32bits_f64(rd_u32(b, t.data_begin + i * 4));
}

/// IEEE f16 bits -> f32 bit pattern (pure int math).
fn st_f16_bits32(bits: i64) -> i64 {
    var sign: i64 = (bits >> 15) & 1;
    var exp: i64 = (bits >> 10) & 31;
    var man: i64 = bits & 1023;
    var out: i64 = 0;
    if exp == 31 {
        out = 0x7F800000;
        if man != 0 { out = out + 1; }
    } else {
        if exp == 0 {
            if man == 0 { return sign * 0x80000000; }
            var e: i64 = -15;
            var m: i64 = man;
            while (m & 1024) == 0 { m = m * 2; e = e - 1; }
            m = m & 1023;
            out = (e + 127) * 8388608 + m * 8192;
        } else {
            out = (exp + 112) * 8388608 + man * 8192;
        }
    }
    return sign * 0x80000000 + out;
}

/// IEEE f16 bits -> f64 value.
pub fn st_f16_f32(bits: i64) -> f64 {
    return st_f32bits_f64(st_f16_bits32(bits));
}

/// bf16 -> f64: it's just the top half of the f32 word.
pub fn st_bf16_f32(bits: i64) -> f64 {
    return st_f32bits_f64(bits * 65536);
}

/// f16 element i.
pub fn st_f16(b: Vec<i64>, t: StTensor, i: i64) -> f64 {
    return st_f16_f32(rd_u16(b, t.data_begin + i * 2));
}

/// bf16 element i.
pub fn st_bf16(b: Vec<i64>, t: StTensor, i: i64) -> f64 {
    return st_bf16_f32(rd_u16(b, t.data_begin + i * 2));
}

/// f64 element i.
@wrapping
pub fn st_f64(b: Vec<i64>, t: StTensor, i: i64) -> f64 {
    var lo: i64 = rd_u32(b, t.data_begin + i * 8);
    var hi: i64 = rd_u32(b, t.data_begin + i * 8 + 4);
    return p_f64_from_bits(hi * 4294967296 + lo);
}

/// Integer element i (I8..I64, sign-extended).
pub fn st_int(b: Vec<i64>, t: StTensor, i: i64) -> i64 {
    var o: i64 = t.data_begin + i * st_dtype_size(t.dtype);
    if str_equal(t.dtype, "I8") {
        var v: i64 = b.get(o);
        if v >= 128 { v = v - 256; }
        return v;
    }
    if str_equal(t.dtype, "I16") {
        var v: i64 = rd_u16(b, o);
        if v >= 32768 { v = v - 65536; }
        return v;
    }
    if str_equal(t.dtype, "I32") {
        var v: i64 = rd_u32(b, o);
        if v >= 2147483648 { v = v - 4294967296; }
        return v;
    }
    var v: i64 = rd_u32(b, o);                // I64/U64 lo 32
    var hi: i64 = rd_u32(b, o + 4);
    if hi >= 2147483648 { hi = hi - 4294967296; }
    return hi * 4294967296 + v;
}

/// Unsigned element i (U8..U32; U64 truncated to lo32 — document it).
pub fn st_uint(b: Vec<i64>, t: StTensor, i: i64) -> i64 {
    var o: i64 = t.data_begin + i * st_dtype_size(t.dtype);
    var dsz: i64 = st_dtype_size(t.dtype);
    if dsz == 1 { return b.get(o); }
    if dsz == 2 { return rd_u16(b, o); }
    return rd_u32(b, o);
}

/// __metadata__ object value for key, or "" — metadata stays a JSON
/// string the caller interprets.
pub fn st_meta(st: StFile, key: str) -> str {
    if !json_has(st.header, "__metadata__") { return ""; }
    var m: str = json_get_safe(st.header, "__metadata__");
    if !json_has(m, key) { return ""; }
    return json_get_str(m, key);
}
