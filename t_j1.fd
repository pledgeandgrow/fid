use json;

fn bs(b: bool) -> str { if b { return "t"; } return "f"; }

fn main() -> i64 {
    println("n1=" + bs(json_is_valid("1")));
    println("n2=" + bs(json_is_valid("\"s\"")));
    println("n3=" + bs(json_is_valid("[]")));
    println("n4=" + bs(json_is_valid("{}")));
    println("n5=" + bs(json_is_valid("[1,2]")));
    println("n6=" + bs(json_is_valid("{\"a\":1}")));
    return 0;
}
