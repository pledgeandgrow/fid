use fs;
use process;
use vec;

fn main() -> i64 {
    // temp + write + read
    var tmp: str = fs_temp_dir(".", "fdt");
    println("tmp=" + tmp);
    println("is_dir=" + bool_to_str(fs_is_dir(tmp)));

    fs_mkdir_all(fs_join(tmp, "a/b"));
    fs_write_text(fs_join(tmp, "a/b/x.fd"), "x");
    fs_write_text(fs_join(tmp, "a/y.txt"), "y");
    fs_write_text(fs_join(tmp, "top.txt"), "t");

    // list / walk
    var l: Vec = fs_list_dir(tmp);
    println("list_n=" + int_to_str(l.len()));
    var w: Vec = fs_walk(tmp);
    println("walk_n=" + int_to_str(w.len()));

    // glob
    var g1: Vec = fs_glob(tmp, "**/*.fd");
    var g2: Vec = fs_glob(tmp, "*.txt");
    var g3: Vec = fs_glob(tmp, "a/*/x.fd");
    println("glob_fd=" + int_to_str(g1.len()) + " txt=" + int_to_str(g2.len()) + " pat=" + int_to_str(g3.len()));

    // path helpers
    println("base=" + fs_basename("a/b/c.txt") + " dir=" + fs_dirname("a/b/c.txt") + " ext=" + fs_ext("a/b/c.txt") + " stem=" + fs_stem("a/b/c.txt"));

    // rename + delete
    var from: str = fs_join(tmp, "top.txt");
    var to: str = fs_join(tmp, "renamed.txt");
    println("ren=" + bool_to_str(fs_rename(from, to)) + " exists=" + bool_to_str(fs_exists(to)));

    // process capture
    var h: i64 = process_run("echo hello_proc && echo e_out 1>&2 && exit 3");
    println("pok=" + bool_to_str(process_ok(h)));
    println("out=" + process_stdout(h));
    println("err=" + process_stderr(h));
    println("code=" + int_to_str(process_code(h)));
    process_close(h);
    println("bad_code=" + int_to_str(process_code(0)));

    // cleanup
    fs_delete(to);
    fs_delete(fs_join(tmp, "a/y.txt"));
    fs_delete(fs_join(tmp, "a/b/x.fd"));
    fs_delete(fs_join(tmp, "a/b"));
    fs_delete(fs_join(tmp, "a"));
    fs_delete(tmp);
    return 0;
}
