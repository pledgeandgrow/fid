// A secret reaches a divisor through an `&mut` out-parameter. The
// source-level check follows names, not calls that store through a
// reference, so it accepts this; the C path's check (compiler/codegen_c.fd
// cg_ct_check, LF18) rejects the division: its latency depends on x.
// Run by tests/ct/check_c_ct.sh; expected: "integer division of secret data".

@constant_time
fn ct_store(out: &mut i64, v: i64) {
    *out = v;
}

@constant_time
@wrapping
fn leaky_div(x: i64) -> i64 {
    var d: i64 = 1;
    ct_store(&mut d, x);
    return 1000 / d;
}

fn main() {
    print(leaky_div(5));
    print("\n");
    print(leaky_div(3));
    print("\n");
}
