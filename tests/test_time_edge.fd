use time;

pf main() -> i64 {
    // Test leap day: Feb 29, 2024
    pv t = time_from_date(2024, 2, 29);
    print("Leap day: ");
    print(time_to_iso(t));
    print("\n");
    print("Day of year: ");
    print(time_get_day_of_year(t));
    print("\n");

    // Test Dec 31, 2023
    pv t2 = time_from_date(2023, 12, 31);
    print("Dec 31 2023: ");
    print(time_to_iso(t2));
    print("\n");
    print("Day of year: ");
    print(time_get_day_of_year(t2));
    print("\n");

    // Test Jan 1, 1970 (epoch)
    pv t3 = time_from_date(1970, 1, 1);
    print("Epoch: ");
    print(time_to_iso(t3));
    print("\n");

    // Test Jan 1, 2000 (Y2K)
    pv t4 = time_from_date(2000, 1, 1);
    print("Y2K: ");
    print(time_to_iso(t4));
    print("\n");

    // Test Dec 31, 1999
    pv t5 = time_from_date(1999, 12, 31);
    print("Dec 31 1999: ");
    print(time_to_iso(t5));
    print("\n");

    // Test year boundary: Dec 31 2023 -> Jan 1 2024
    pv t6 = time_add_days(t2, 1);
    print("Dec 31 + 1 day: ");
    print(time_to_iso(t6));
    print("\n");

    // Test weekday for known dates
    // Jan 1, 2024 is Monday (1)
    pv t7 = time_from_date(2024, 1, 1);
    print("Jan 1 2024 weekday (1=Mon): ");
    print(time_get_weekday(t7));
    print("\n");

    // Dec 7, 1941 (Pearl Harbor - Sunday)
    pv t8 = time_from_date(1941, 12, 7);
    print("Dec 7 1941 weekday (0=Sun): ");
    print(time_get_weekday(t8));
    print("\n");

    // Test negative timestamp (before epoch)
    pv t9 = time_from_date(1969, 12, 31);
    print("Dec 31 1969: ");
    print(time_to_iso(t9));
    print("\n");

    // Test 1800 (pre-epoch, non-leap century)
    pv t10 = time_from_date(1800, 1, 1);
    print("Jan 1 1800: ");
    print(time_to_iso(t10));
    print("\n");

    // Test 2100 (non-leap century year)
    print("2100 leap: ");
    print(is_leap_year(2100));
    print("\n");

    ret 0;
}
