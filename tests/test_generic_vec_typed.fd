// Vec<T> carries its element type from a let annotation, not just i64.
//
// Before this worked, `Vec::new()` always returned Vec<i64> regardless of
// the declared type, so `pv v: Vec<Token> = Vec::new();` was a type error.
use core;
use vec;

struct Token {
    kind: i64,
    text: str,
}

pf main() -> i64 {
    // The key test: declared type flows into Vec::new().
    pv toks: Vec<Token> = Vec::new();

    pv t1 = Token { kind: 1, text: "if" };
    pv t2 = Token { kind: 2, text: "else" };
    toks.push(t1);
    toks.push(t2);

    print(toks.len());  // 2

    // get() returns the element type — field access on the result must work.
    pv first: Token = toks.get(0);
    print(first.kind);  // 1
    print(first.text);  // if

    pv second = toks.get(1);
    print(second.kind); // 2
    print(second.text); // else

    // Vec<i64> still works (no annotation, defaults to i64).
    pv nums = Vec::new();
    nums.push(10);
    nums.push(20);
    print(nums.len());   // 2
    print(nums.get(0));  // 10

    ret 0;
}
