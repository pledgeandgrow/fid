// Integer overflow checking — valid arithmetic works (Phase 2D)

fn main() {
    // Normal arithmetic
    val a = 100;
    val b = 200;
    println(a + b);  // 300

    // Near boundary — still valid
    val c = 9223372036854775806;  // i64::MAX - 1
    val d = c + 1;                 // exactly i64::MAX — no overflow
    println(d);                   // 9223372036854775807

    // Subtraction near boundary
    val e = -9223372036854775807;  // i64::MIN + 1
    val f = e - 1;                 // exactly i64::MIN — no overflow
    println(f);                   // -9223372036854775808

    // Multiplication
    val g = 1000000;
    val h = 1000000;
    println(g * h);  // 1000000000000

    // Division
    val i = 100;
    val j = 7;
    println(i / j);  // 14

    // Modulo
    println(i % j);  // 2

    // Negative numbers
    val k = -10;
    val l = 3;
    println(k + l);  // -7
    println(k * l);  // -30
}
