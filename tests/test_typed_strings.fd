// Test: F67 — Typed strings (SQLString, ShellString, HTMLString, JSONString, PathString)
// Verifies that typed string wrappers prevent injection attacks at compile time
// and that escape/bind functions work correctly.

use typed_strings;

fn main() -> i64 {
    // ─── SQLString ───
    val sql = sql_query("SELECT * FROM users WHERE id = ?");
    print(sql.value);
    print("\n");

    // sql_bind replaces ? with escaped parameter
    val sql2 = sql_bind(sql, "42");
    print(sql2.value);
    print("\n");

    // sql_bind_int for integer parameters
    val sql3 = sql_bind_int(sql_query("SELECT * FROM users WHERE id = ?"), 99);
    print(sql3.value);
    print("\n");

    // sql_escape doubles single quotes
    val escaped = sql_escape("O'Brien");
    print(escaped.value);
    print("\n");

    // is_safe detects injection patterns
    print(sql.is_safe());
    print("\n");
    val unsafe_sql = sql_query("SELECT * FROM users WHERE name = 'Robert'; DROP TABLE users; --");
    print(unsafe_sql.is_safe());
    print("\n");

    // ─── ShellString ───
    val cmd = shell_cmd("ls -la");
    print(cmd.value);
    print("\n");
    print(cmd.is_safe());
    print("\n");

    val unsafe_cmd = shell_cmd("ls; rm -rf /");
    print(unsafe_cmd.is_safe());
    print("\n");

    // shell_escape wraps in single quotes
    val esc_cmd = shell_escape("file with spaces.txt");
    print(esc_cmd.value);
    print("\n");

    // ─── HTMLString ───
    val html = html_escape("<script>alert('xss')</script>");
    print(html.value);
    print("\n");

    // ─── JSONString ───
    val json = json_escape("He said \"hello\"\n");
    print(json.value);
    print("\n");

    // ─── PathString ───
    val safe_path = path_safe("data/users.json");
    print(safe_path.value);
    print("\n");
    print(safe_path.is_safe());
    print("\n");

    // Path traversal is rejected — returns empty path
    val traversal = path_safe("../../etc/passwd");
    print("[");
    print(traversal.value);
    print("]");
    print("\n");

    // ─── Struct field access works ───
    // Verify that typed strings work through struct fields
    // (using free function constructors since struct literals require
    //  the parser to know the struct type from the imported module)
    val s = sql_literal("SELECT 1");
    print(s.value);
    print("\n");

    // ─── impl methods work via free function wrappers ───
    val s2 = sql_literal("SELECT 2");
    print(s2.value);
    print("\n");
    print(s2.raw());
    print("\n");

    return 0;
}
