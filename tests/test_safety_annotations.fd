// Test: Composable safety primitives + domain presets
// Verifies @safety-critical, @autosar, @medical, and direct primitive composition

// @safety-critical = @no-alloc + @no-recursion + @no-unbounded + no-panic + @no-indirect
@safety-critical @audit
pf avionics_check(altitude: i64, speed: i64) -> i64 {
    pv safe = 1;
    if altitude < 0 { safe = 0; }
    if speed < 0 { safe = 0; }
    if speed > 900 { safe = 0; }
    ret safe;
}

// @autosar = @no-alloc + @no-recursion + @no-unbounded + no-panic
@autosar
pf ecu_control(throttle: i64, brake: i64) -> i64 {
    pv output = throttle - brake;
    if output < 0 { output = 0; }
    ret output;
}

// @medical = @no-alloc + @no-recursion + @no-unbounded + no-panic + @requires-audit
// (@dal-a was merged into @medical — identical expansion)
@medical @audit
pf flight_control(input: i64) -> i64 {
    pv result = input * 2;
    ret result;
}

// Direct primitive composition — custom safety profile
// @crashfree = no-panic + no-unbounded (replaces @no-panic which is now internal)
@no-alloc @no-recursion @crashfree
pf custom_safety(x: i64) -> i64 {
    pv result = x + 1;
    ret result;
}

// @no-alloc only — just forbid dynamic allocation
@no-alloc
pf no_heap(x: i64) -> i64 {
    ret x * 2;
}

// @no-recursion only — just forbid self-calls
@no-recursion
pf no_self_call(x: i64) -> i64 {
    ret x + 1;
}

pf main() -> i64 {
    pv r1 = avionics_check(10000, 500);
    print(r1);
    print("\n");

    pv r2 = ecu_control(50, 20);
    print(r2);
    print("\n");

    pv r3 = flight_control(42);
    print(r3);
    print("\n");

    pv r4 = custom_safety(41);
    print(r4);
    print("\n");

    pv r5 = no_heap(10);
    print(r5);
    print("\n");

    pv r6 = no_self_call(5);
    print(r6);
    print("\n");

    ret 0;
}
