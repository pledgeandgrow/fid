// XT32 arguments, environment and exit: args_sizes_get / args_get,
// environ_sizes_get / environ_get (the process image laid out as Linux
// starts a process), proc_exit with a code. tests/wasm/wasi-check.sh runs
// it with the arguments alpha, "b c" and an empty one, XT32_VAR=value-1
// and XT32_EQ=a=b=c (an `=` in the value), and checks the output
// (wasi_args_env.expected) and the exit code 7.
use os;

fn main() -> i64 {
    println("argc " + int_to_str(os_argc()));
    var i: i64 = 1;
    while i < os_argc() {
        println("arg " + int_to_str(i) + " [" + os_argv(i) + "]");
        i = i + 1;
    }
    match env_var("XT32_VAR") {
        Option::Some(v) => {
            println("var [" + v + "]");
        }
        Option::None => {
            println("var none");
        }
    }
    match env_var("XT32_EQ") {
        Option::Some(v) => {
            println("eq [" + v + "]");
        }
        Option::None => {
            println("eq none");
        }
    }
    match env_var("XT32_UNSET_NAME") {
        Option::Some(v) => {
            println("unset [" + v + "]");
        }
        Option::None => {
            println("unset none");
        }
    }
    os_exit(7);
    println("not reached");
    return 0;
}
