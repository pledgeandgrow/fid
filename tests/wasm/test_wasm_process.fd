// PL4: WASI has no processes. `fid wasm` makes a command a clear error at
// the call (compiler/wasm.fd wg_is_process_call): the program panics with
// "not available in WebAssembly: processes (p_system)" and exits 1, where
// the runtime used to give -1 as if the shell had failed to start.
// tests/wasm/task-switch-check.sh checks the output before the call, the
// exit code and the message (test_wasm_process.expected*).
//
// Expected output:
//   before
// then on stderr "Panic: not available in WebAssembly: processes (p_system)"
fn main() -> i64 {
    println("before");
    print(p_system("exit 3"));
    println("after");
    return 0;
}
