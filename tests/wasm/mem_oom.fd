// XT31: a block the linear memory cannot hold stops the program with
// "Panic: out of memory (<n> bytes requested)" and exit code 1, as on the
// other targets (stdlib/linux_runtime/base.fd pe_oom): memory.grow refuses
// the 65,532 pages asked for (a wasm32 memory has at most 65,536), and
// nothing is committed. tests/wasm/memory-check.sh checks the output, the
// exit code and the message (mem_oom.expected*). The line after the
// allocation is never printed.
//
// Expected output:
// start
// Expected exit: 1

fn main() -> i64 {
    println("start");
    val n: i64 = 4294967296 - 262144;
    var p: i64 = 0;
    // SAFETY: the block is never read or written; the call does not return.
    unsafe {
        p = p_malloc(n);
    }
    println("got " + int_to_str(p));
    return 0;
}
