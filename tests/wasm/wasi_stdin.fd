// XT32 standard input: fd_read on fd 0 (read_line to the end, then
// read_stdin at the end). tests/wasm/wasi-check.sh feeds it three lines
// and checks the output (wasi_stdin.expected).
fn main() -> i64 {
    var n: i64 = 0;
    var going: bool = true;
    while going {
        match read_line() {
            Option::Some(l) => {
                n = n + 1;
                println("line " + int_to_str(n) + " [" + str_trim(l) + "]");
            }
            Option::None => {
                going = false;
            }
        }
    }
    println("lines " + int_to_str(n));
    match read_stdin(10) {
        Option::Some(s) => {
            println("more [" + s + "]");
        }
        Option::None => {
            println("end");
        }
    }
    return 0;
}
