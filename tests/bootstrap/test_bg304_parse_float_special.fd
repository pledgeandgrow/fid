// Bugs roadmap BG304: `str_parse_float` of "inf", "infinity", "nan" and hex
// text ("0x10") gave inf/NaN/16 on `fid run` and C (strtod) but 0 on both
// native Windows backends: pe_ir's runtime called msvcrt's atof, which
// reads none of them, and the machine layer's parser read only decimal
// text. Both runtimes now read them as strtod does
// (stdlib/pe_runtime/base.fd and stdlib/linux_runtime/base.fd
// pert_str_to_float).
//
// Expected output:
// inf NaN 16 inf
// -inf inf NaN
// 3 0.5 255 -2
// 0 0 1.5 100000

fn p(s: str) -> str {
    return float_to_str(str_parse_float(s));
}

fn main() {
    println(p("inf") + " " + p("nan") + " " + p("0x10") + " " + p("infinity"));
    println(p("-inf") + " " + p("  INF") + " " + p("NaN"));
    println(p("0x1.8p1") + " " + p("0x.8") + " " + p("0XfF") + " " + p("-0x1p1"));
    println(p("0x") + " " + p("abc") + " " + p("1.5") + " " + p("1e5"));
}
