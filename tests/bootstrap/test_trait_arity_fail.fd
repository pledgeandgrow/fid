// expect-error: takes 1 parameter(s); the trait's method takes 0
// LG4: an impl method takes the trait's parameters, no more and no fewer.
cap Grow {
    fn grow(self) -> i64;
}

struct Box1 { v: i64 }

impl Grow for Box1 {
    fn grow(self, by: i64) -> i64 { return self.v + by; }
}

fn main() -> i64 { return 0; }
