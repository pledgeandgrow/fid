// BG211 (docs/roadmap/bugs-roadmap.md): a `}` or `{` inside a string
// literal within an f-string's braces is the string's: `{str_len("a}c")}`
// ended at the quoted brace ("unterminated string" on a later line) and
// `"a{c"` ran to the end of the file ("unterminated f-string"). lexer.fd
// read_fstring and parser.fd parse_fstring_parts skip a string, f-string
// or raw string inside the braces whole.
//
// Expected output:
// 3
// 3
// [}] [{]
// 3|x:y
// in 1 out
// a}b
// }
// 2 {
// after
fn main() -> i64 {
    println(f"{str_len("a}c")}");
    println(f"{str_len("a{c")}");
    println(f"[{"}"}] [{"{"}]");
    val m: str = "x:y";
    println(f"{str_len("k:v")}|{m}");
    println(f"{f"in {str_len("}")}"} out");
    println(f"{r"a}b"}");
    println(f"{if str_len(m) > 1 { "}" } else { "{" }}");
    println(f"{str_len("\"}")} {"{"}");
    println("after");
    return 0;
}
