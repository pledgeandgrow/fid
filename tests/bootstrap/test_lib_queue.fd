// stdlib/queue: FIFO order, empty reads, contains, drain, and the
// compaction that runs when more than 32 values have been taken.
use queue;

fn main() -> i64 {
    var q = Queue::new();
    println(q.is_empty());
    println(q.len());
    println(q.dequeue());
    println(q.peek());

    q.enqueue(10);
    q.enqueue(20);
    q.enqueue(30);
    println(q.len());
    println(q.peek());
    println(q.dequeue());
    println(q.peek());
    println(q.contains(20));
    println(q.contains(10));
    println(q.len());

    var d = q.drain();
    println(d.len());
    println(d.get(0));
    println(d.get(1));
    println(q.is_empty());

    q.enqueue(5);
    q.clear();
    println(q.len());
    println(q.dequeue());

    // 100 values; taking 40 crosses the compaction point (head > 32)
    var i: i64 = 0;
    while i < 100 {
        q.enqueue(i);
        i = i + 1;
    }
    var sum: i64 = 0;
    i = 0;
    while i < 40 {
        sum = sum + q.dequeue();
        i = i + 1;
    }
    println(sum);
    println(q.len());
    println(q.peek());
    println(q.contains(39));
    println(q.contains(40));
    println(q.contains(99));
    return 0;
}
