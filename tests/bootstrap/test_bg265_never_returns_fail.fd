// expect-error: 'die' is declared `-> !` (it never returns) but can return
// Bugs roadmap BG265: a `-> !` function must not reach the end of its body
// (reference §2.1); before, die() came back and pick() fell off its end
// with no value (run printed `void`, ccompile 0).
fn die() -> ! {
    println("not dying");
}

fn pick(x: i64) -> i64 {
    if x > 0 {
        return 1;
    }
    die();
}

fn main() -> i64 {
    println(pick(-1));
    println("after");
    return 0;
}
