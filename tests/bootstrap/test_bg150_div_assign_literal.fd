// Bugs roadmap BG150: `/=` and `%=` count as divisions for @no-panic, as
// `/` and `%` do; a non-zero literal divisor is safe, so these stay
// accepted (the negative cases: test_bg150_*_fail.fd).
//
// Expected output:
// 16
// 2

@no-panic
@wrapping
fn halve(a: i64) -> i64 {
    var x: i64 = a;
    x /= 2;
    return x;
}

@no-panic
@wrapping
fn rem3(a: i64) -> i64 {
    var x: i64 = a;
    x %= 3;
    return x;
}

fn main() -> i64 {
    println(halve(33));
    println(rem3(14));
    return 0;
}
