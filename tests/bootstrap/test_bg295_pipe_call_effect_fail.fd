// expect-error: function 'via_pipe' has inferred effect '!IO'
// Bugs roadmap BG295: `x |> f(a)` is `f(x, a)`; its effects are f's.
fn loud2(x: i64, y: i64) -> i64 {
    println("loud");
    return x + y;
}
fn via_pipe() -> i64 !{} {
    return 5 |> loud2(1);
}
fn main() -> i64 {
    println(via_pipe());
    return 0;
}
