// Complaint roadmap CB9 on the machine layer (compiler/nat_ir.fd): a C
// function no library the program links defines is a Fides link error
// with its declaration's line and its `link` library, as `fid ccompile`
// reports it (compiler/main.fd link_error_report):
//
//   error: link: the C function 'fides_cb9_not_in_libm' is not in any library the program links
//     --> tests/bootstrap/test_nat_link_missing_fail.fd:20: declared in extern "C" link "m"
//
// `fid emit --nat` (Windows) and `--target x86_64-macos|aarch64-macos`
// have no way to bind it (an unresolved call); a Linux target
// (`--target x86_64-linux`) finds it missing from libm and libc when they
// are on this machine (FID_NAT_LIBPATH, or the usual directories on a
// Linux host: compiler/nat_enc.fd nat_elf_link_missing). The default
// Windows backend refuses the call (not available in native Windows
// executables), `fid ccompile` fails at link time, `fid run` cannot call
// it. Expected to fail on every backend; tests/nattools/cb9_native_link_check.sh
// checks the message per target.

extern "C" link "m" {
    fn fides_cb9_not_in_libm(x: f64) -> f64;
}

@unsafe
fn main() -> i64 {
    println("before");
    println(fides_cb9_not_in_libm(2.0));
    return 0;
}
