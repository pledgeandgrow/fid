// expect-error: cannot change s.items while a `for` loop iterates over it
// BG14: a `for` loop over a field path did not mark the field as iterated,
// so changing it in the body (`s.items.push(x)`) was accepted.
struct Bag {
    items: Vec<i64>,
}

fn main() -> i64 {
    var s: Bag = Bag { items: Vec::new() };
    s.items.push(1);
    for x in s.items {
        s.items.push(x);
    }
    println(int_to_str(s.items.len()));
    return 0;
}
