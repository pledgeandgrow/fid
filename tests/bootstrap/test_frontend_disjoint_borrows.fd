// CM2: borrows the borrow checker accepts because they cannot conflict.
// Two `&mut` borrows of different fields of one struct (disjoint fields),
// `&mut v` and `&v` read in the same call (two-phase borrows), and a method
// call whose argument reads the receiver (`v.push(v.len())`).
// Expected output:
// 2
// 1
// 42
// 3
// 3

struct Pair {
    a: i64,
    b: i64,
}

fn swap(x: &mut i64, y: &mut i64) {
    val t: i64 = *x;
    *x = *y;
    *y = t;
}

fn copy_into(dst: &mut i64, src: &i64) {
    *dst = *src;
}

fn main() -> i64 {
    var p = Pair { a: 1, b: 2 };
    swap(&mut p.a, &mut p.b);
    println(p.a);
    println(p.b);

    var t = 42;
    copy_into(&mut t, &t);
    println(t);

    var v: Vec<i64> = Vec::new();
    v.push(v.len());
    v.push(v.len());
    v.push(v.len());
    println(v.len());
    println(v.get(2) + 1);
    return 0;
}
