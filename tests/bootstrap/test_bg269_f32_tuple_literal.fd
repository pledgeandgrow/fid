// BG269 (docs/roadmap/bugs-roadmap.md): a float literal in a tuple literal
// is stored as the f32 the tuple's type says (a returned `(a, 2.5)` of a
// `-> (f32, f32)`, a let's `(f32, f64)`); its f64 bits were read back as 0.
//
// Expected output:
// 1.5 2.5
// 0.5 -4.25
// 3 7.5

fn mk2() -> (f32, f32) {
    val a: f32 = 1.5;
    return (a, 2.5);
}

fn mk3() -> (f32, f32) {
    return (0.5, -4.25);
}

fn main() {
    val (c, d) = mk2();
    println(f"{c} {d}");
    val (e, f) = mk3();
    println(f"{e} {f}");
    val t: (f32, f64) = (3.0, 7.5);
    val (g, h) = t;
    println(f"{g} {h}");
}
