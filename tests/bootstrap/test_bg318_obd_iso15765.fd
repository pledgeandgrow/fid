// BG318 (docs/roadmap/bugs-roadmap.md): OBD-II on CAN (ISO 15765-4):
// obd_request_to_ecu sends to the ECU's physical request ID 0x7E0 + n (the
// ECU answers on 0x7E8 + n), every request is an ISO 15765-2 single frame
// with its PCI length byte first, and the decoders read real replies
// [len, 0x41, pid, A, B] (a reply without the PCI byte is rejected).
//
// Expected output:
// to ecu 0: id 2016 bytes 2 1 12
// to ecu 7: id 2023 bytes 2 1 13
// rpm request: id 2015 bytes 2 1 12
// speed request: bytes 2 1 13
// coolant request: bytes 2 1 5
// supported pids: bytes 2 1 0
// read dtcs: bytes 1 3
// clear dtcs: bytes 1 4
// rpm reply 04 41 0C 1A F8: 1726
// rpm reply padded to 8: 1726
// rpm reply without PCI: -1
// rpm reply for another pid: -1
// rpm reply PCI too short: -1
// speed reply 03 41 0D 64: 100
// coolant reply 03 41 05 5A: 50
// coolant reply without PCI: -1
// reply from ecu 0: true
use can;

fn bs(f: CanFrame) -> str {
    var s: str = "";
    var i: i64 = 0;
    while i < can_frame_dlc(f) {
        if i > 0 {
            s = s + " ";
        }
        s = s + int_to_str(can_frame_byte(f, i));
        i = i + 1;
    }
    return s;
}

fn fr(a: i64, b: i64, c: i64, d: i64, e: i64, n: i64) -> CanFrame {
    var v: Vec<i64> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    if n > 3 {
        v.push(d);
    }
    if n > 4 {
        v.push(e);
    }
    while v.len() < n {
        v.push(0x55);
    }
    return can_frame_standard(0x7E8, v);
}

fn main() {
    // the entry's triggers
    val q0: CanFrame = obd_request_to_ecu(0, 1, 0x0C);
    println("to ecu 0: id " + int_to_str(can_frame_id(q0)) + " bytes " + bs(q0));
    val q7: CanFrame = obd_request_to_ecu(7, 1, 0x0D);
    println("to ecu 7: id " + int_to_str(can_frame_id(q7)) + " bytes " + bs(q7));
    val rq: CanFrame = obd_engine_rpm_request();
    println("rpm request: id " + int_to_str(can_frame_id(rq)) + " bytes " + bs(rq));
    println("speed request: bytes " + bs(obd_vehicle_speed_request()));
    println("coolant request: bytes " + bs(obd_coolant_temp_request()));
    println("supported pids: bytes " + bs(obd_supported_pids()));
    println("read dtcs: bytes " + bs(obd_read_dtcs()));
    println("clear dtcs: bytes " + bs(obd_clear_dtcs()));

    // RPM = (0x1A * 256 + 0xF8) / 4 = 1726
    println("rpm reply 04 41 0C 1A F8: " + int_to_str(obd_decode_engine_rpm(fr(0x04, 0x41, 0x0C, 0x1A, 0xF8, 5))));
    println("rpm reply padded to 8: " + int_to_str(obd_decode_engine_rpm(fr(0x04, 0x41, 0x0C, 0x1A, 0xF8, 8))));
    println("rpm reply without PCI: " + int_to_str(obd_decode_engine_rpm(fr(0x41, 0x0C, 0x1A, 0xF8, 0, 4))));
    println("rpm reply for another pid: " + int_to_str(obd_decode_engine_rpm(fr(0x04, 0x41, 0x0D, 0x1A, 0xF8, 5))));
    println("rpm reply PCI too short: " + int_to_str(obd_decode_engine_rpm(fr(0x03, 0x41, 0x0C, 0x1A, 0xF8, 5))));
    println("speed reply 03 41 0D 64: " + int_to_str(obd_decode_vehicle_speed(fr(0x03, 0x41, 0x0D, 0x64, 0, 4))));
    println("coolant reply 03 41 05 5A: " + int_to_str(obd_decode_coolant_temp(fr(0x03, 0x41, 0x05, 0x5A, 0, 4))));
    println("coolant reply without PCI: " + int_to_str(obd_decode_coolant_temp(fr(0x41, 0x05, 0x5A, 0, 0, 3))));
    var from0: str = "false";
    if obd_is_response_from_ecu(fr(0x04, 0x41, 0x0C, 0x1A, 0xF8, 5), 0) {
        from0 = "true";
    }
    println("reply from ecu 0: " + from0);
}
