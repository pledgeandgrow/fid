// expect-error: Q does not implement Show
// Bugs roadmap BG371: a turbofish with a type that does not implement the
// bound got only the internal "Unknown annotation '@__trait_bound'"; it is
// the bound error.
cap Show {
    fn show(self) -> str;
}
struct Q {
    y: i64,
}
fn pr<T: Show>(v: T) -> i64 {
    return 1;
}
fn main() {
    val q = Q { y: 1 };
    println(pr::<Q>(q));
}
