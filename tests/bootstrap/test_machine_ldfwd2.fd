// Track TG (docs/roadmap/llvm-roadmap.md), TG17: the post-allocation rules
// "ldfwd" and "ldfwdmov" (compiler/nat_ir.fd ng_post_rules, ng_ld_fwd and
// ng_mir_emit_pass). Values are kept live past what any target has
// registers for, so they spill; a value stored to its slot is then read
// right after (ldfwd) or after register moves, such as those that set up
// a call's arguments (ldfwdmov). The output is the same with each rule on
// or off (FID_NAT_OFF=ldfwd, FID_NAT_OFF=ldfwdmov); `fid emit --stats`
// prints "[ldfwd] N slot loads after a store became register moves"
// (tests/nattools/machine_tg17_check.sh).
// Expected output:
// args 500399
// chain 61053
// loop 424649

fn pick3(a: i64, b: i64, c: i64) -> i64 {
    if a > 1000000 {
        return pick3(a - 1000000, b, c) + 1;
    }
    return a * 3 + b * 2 + c;
}

fn args(n: i64) -> i64 {
    var a: i64 = n + 1;
    var b: i64 = n * 3;
    var c: i64 = a + b;
    var d: i64 = c * 2 - a;
    var e: i64 = d + b * 5;
    var f: i64 = e - c + 7;
    var g: i64 = f * 3 + d;
    var h: i64 = g - e + a;
    var i: i64 = h + f * 2;
    var j: i64 = i - g + b;
    var k: i64 = j + h - c;
    var l: i64 = k * 2 + i;
    var m: i64 = l - j + d;
    var o: i64 = m + k - e;
    var p: i64 = o * 2 - l;
    var q: i64 = p + m + f;
    var r1: i64 = pick3(q, p + 1, o);
    var r2: i64 = pick3(r1 + a, b, c + q);
    var r3: i64 = pick3(r2 - d, e + m, f);
    var s: i64 = a + b + c + d + e + f + g + h + i + j + k + l + m + o + p + q;
    return s + r1 + r2 + r3;
}

fn chain(n: i64) -> i64 {
    var t: i64 = 0;
    var x: i64 = n;
    var w: i64 = 1;
    while x > 0 {
        var y: i64 = x * 7 + w;
        var z: i64 = pick3(y % 1000, x, w);
        t = t + z + y % 13;
        w = w + 1;
        x = x - 9;
    }
    return t;
}

fn lp(n: i64) -> i64 {
    var v0: i64 = 1;
    var v1: i64 = 2;
    var v2: i64 = 3;
    var v3: i64 = 4;
    var v4: i64 = 5;
    var v5: i64 = 6;
    var v6: i64 = 7;
    var v7: i64 = 8;
    var v8: i64 = 9;
    var v9: i64 = 10;
    var v10: i64 = 11;
    var v11: i64 = 12;
    var v12: i64 = 13;
    var v13: i64 = 14;
    var v14: i64 = 15;
    var v15: i64 = 16;
    var i: i64 = 0;
    while i < n {
        v0 = v0 + v15 % 7;
        v1 = v1 + v0 % 5;
        v2 = v2 + v1 % 3;
        v3 = v3 + v2 % 11;
        v4 = v4 + v3 % 13;
        v5 = v5 + v4 % 17;
        v6 = v6 + v5 % 19;
        v7 = v7 + v6 % 23;
        v8 = v8 + v7 % 29;
        v9 = v9 + v8 % 31;
        v10 = v10 + v9 % 37;
        v11 = v11 + v10 % 41;
        v12 = v12 + v11 % 43;
        v13 = v13 + v12 % 47;
        v14 = v14 + v13 % 53;
        v15 = v15 + v14 % 59;
        i = i + 1;
    }
    return v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14 + v15;
}

fn main() {
    println("args " + int_to_str(args(17)));
    println("chain " + int_to_str(chain(300)));
    println("loop " + int_to_str(lp(2000)));
}
