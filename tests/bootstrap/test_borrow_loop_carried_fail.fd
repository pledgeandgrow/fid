// expect-error: cannot mutate v: shared borrow(s) are active on it or its fields
// BG15: a loop body was checked once, so the borrow `e = &v[0]` made at
// the end of an iteration was not seen by `v.push(i)` at the top of the
// next one, which then reads `*e` after the push may have moved v.
fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    var w: Vec<i64> = Vec::new();
    v.push(0);
    w.push(7);
    var e: &i64 = &w[0];
    var i: i64 = 0;
    while i < 100 {
        v.push(i);
        print(*e);
        e = &v[0];
        i = i + 1;
    }
    return 0;
}
