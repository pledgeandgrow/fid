// @derive(Serialize) writes the fields' real values, nested structs included,
// and a StringBuilder grows without copying everything it holds.
@derive(Serialize)
struct Inner {
    ok: bool,
}

@derive(Serialize)
struct Outer {
    id: i64,
    small: i32,
    ratio: f64,
    name: str,
    inner: Inner,
}

fn main() -> i64 {
    val o: Outer = Outer { id: 7, small: -2, ratio: 1.5, name: "a\"b", inner: Inner { ok: true } };
    println(Outer_to_json(o));
    var sb: StringBuilder = StringBuilder::new();
    var i: i64 = 0;
    while i < 20000 {
        sb.append_str("ab");
        sb.append_char(99);
        sb.append_int(i % 10);
        i = i + 1;
    }
    println(sb.len());
    val text: str = sb.to_str();
    println(str_len(text));
    println(str_slice(text, 0, 12));
    // A builder stays usable after to_str
    sb.append_str("z");
    println(str_len(sb.to_str()));
    println(sb.len());
    return 0;
}
