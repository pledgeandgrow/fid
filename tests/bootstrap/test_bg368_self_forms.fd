// Bugs roadmap BG368: `self` must be the impl's own type; every accepted
// form (`self`, `self: A`, `&A`, `&mut A`, `Self`, a generic impl's
// `Wrap<T>`, a trait impl) still compiles and runs.
//
// Expected output:
// 3
// 4
// 5
// 6
// 7
// 12
// 9

struct A { a: i64 }
impl A {
    fn plain(self) -> i64 {
        return self.a;
    }
    fn typed(self: A) -> i64 {
        return self.a + 1;
    }
    fn by_ref(self: &A) -> i64 {
        return self.a + 2;
    }
    fn by_mut(self: &mut A) -> i64 {
        self.a = self.a + 3;
        return self.a;
    }
}

struct Wrap<T> { v: T }
impl<T> Wrap<T> {
    fn get(self: Wrap<T>) -> T {
        return self.v;
    }
}

cap Num {
    fn twice(self) -> i64;
}
impl Num for A {
    fn twice(self: A) -> i64 {
        return self.a * 2;
    }
}

fn main() {
    var a = A { a: 3 };
    println(a.plain());
    println(a.typed());
    println(a.by_ref());
    println(a.by_mut());
    val w = Wrap { v: 7 };
    println(w.get());
    println(a.twice());
    println(a.a + 3);
}
