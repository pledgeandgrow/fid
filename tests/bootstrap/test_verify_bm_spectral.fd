// BM3 (competitive roadmap): spectral-norm of the 50 x 50 matrix (1.274193836).
// bench/game/fides/spectral.fd on a small input (spectral(50)), so the suite checks
// the benchmark's code on every backend; the expected value is the one
// the reference algorithm gives (computed in double precision, the same
// operations in the same order).
//
// Expected output:
// 1274193836
use math;

fn eval_a(i: i64, j: i64) -> f64 {
    return 1.0 / ((((i + j) * (i + j + 1)) / 2 + i + 1) as f64);
}

// A v
fn mul_av(v: Vec<f64>, n: i64) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var s: f64 = 0.0;
        var j: i64 = 0;
        while j < n {
            s = s + eval_a(i, j) * v.get(j);
            j = j + 1;
        }
        out.push(s);
        i = i + 1;
    }
    return out;
}

// A^T v
fn mul_atv(v: Vec<f64>, n: i64) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        var s: f64 = 0.0;
        var j: i64 = 0;
        while j < n {
            s = s + eval_a(j, i) * v.get(j);
            j = j + 1;
        }
        out.push(s);
        i = i + 1;
    }
    return out;
}

// A^T A v
fn mul_atav(v: Vec<f64>, n: i64) -> Vec<f64> {
    val t: Vec<f64> = mul_av(v, n);
    return mul_atv(t, n);
}

fn spectral(n: i64) -> i64 {
    var u: Vec<f64> = Vec::new();
    var v: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        u.push(1.0);
        i = i + 1;
    }
    var k: i64 = 0;
    while k < 10 {
        v = mul_atav(u, n);
        u = mul_atav(v, n);
        k = k + 1;
    }
    var vbv: f64 = 0.0;
    var vv: f64 = 0.0;
    i = 0;
    while i < n {
        vbv = vbv + u.get(i) * v.get(i);
        vv = vv + v.get(i) * v.get(i);
        i = i + 1;
    }
    return (math_sqrt(vbv / vv) * 1000000000.0) as i64;
}

fn main() -> i64 {
    println(spectral(50));
    return 0;
}
