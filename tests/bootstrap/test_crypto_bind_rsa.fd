// RSA through the system's crypto library (competitive SL18, release J5):
// crypto_bind is BCrypt (CNG) on Windows and libcrypto (OpenSSL EVP) on
// Linux and macOS; both take the same blobs (crypto_bind_rsa.fd) and must
// give the same answers. Published vectors from Project Wycheproof
// (github.com/C2SP/wycheproof, testvectors_v1, Apache 2.0):
//   rsa_signature_2048_sha256_test.json   RSASSA-PKCS1-v1_5 verify
//   rsa_pss_2048_sha256_mgf1_32_test.json RSASSA-PSS verify
//   rsa_oaep_2048_sha256_mgf1sha256_test.json RSAES-OAEP decrypt
// (each valid vector, and invalid ones of every kind the file names; an
// "acceptable" one is left out), deterministic PKCS#1 v1.5 signatures with
// the OAEP key, then round trips with keys of our own: PSS and OAEP (both
// randomized), and a generated 2048-bit key.
//
// Needs the system library: C and native builds (`fid ccompile`; `fid
// emit` on Windows), not `fid run`. On Linux it needs libcrypto.
//
// Expected output:
// pkcs1 verify: 52 vectors ok (7 valid)
// pss verify: 53 vectors ok (14 valid)
// oaep decrypt: 37 vectors ok (18 valid)
// pkcs1 sign: 3 vectors ok
// key blobs ok
// pss round trip ok
// oaep round trip ok
// generated key ok
// crypto_bind rsa: all ok
use crypto_bind;
use crypto_bind_rsa;
use crypto;
use sha512;
use vec;
use string;

var g_failed: bool = false;

fn hex(h: str) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i + 1 < str_len(h) {
        v.push(str_parse_hex(str_slice(h, i, i + 2)));
        i = i + 2;
    }
    return v;
}

fn eq(a: & Vec, b: & Vec) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn copy_of(a: & Vec) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < a.len() {
        v.push(a.get(i));
        i = i + 1;
    }
    return v;
}

fn fail(what: str) {
    println("FAIL: " + what);
    g_failed = true;
}

// Signature vectors in fours (tcId, result, msg, sig): verify each with
// PKCS#1 v1.5 (salt < 0) or PSS with that salt. Returns how many valid.
fn check_signatures(name: str, pub_blob: & Vec, v: Vec<str>, salt: i64) -> i64 {
    var valid: i64 = 0;
    var bad: i64 = 0;
    var i: i64 = 0;
    while i + 3 < v.len() {
        val want: bool = v.get(i + 1) == "valid";
        val h: Vec<i64> = crypto_sha256_bytes(hex(v.get(i + 2)));
        val sig: Vec<i64> = hex(v.get(i + 3));
        var got: bool = false;
        if salt < 0 {
            got = cb_rsa_verify_pkcs1(pub_blob, "SHA256", & h, & sig);
        } else {
            got = cb_rsa_verify_pss(pub_blob, "SHA256", & h, & sig, salt);
        }
        if got != want {
            fail(name + " tcId " + v.get(i) + ": wanted " + v.get(i + 1));
            bad = bad + 1;
        }
        if want {
            valid = valid + 1;
        }
        i = i + 4;
    }
    if bad == 0 {
        println(name + ": " + int_to_str(v.len() / 4) + " vectors ok (" + int_to_str(valid) + " valid)");
    }
    return valid;
}

fn oaep_key() -> Vec<i64> {
    val n: Vec<i64> = hex(oaep_n());
    val e: Vec<i64> = hex(oaep_e());
    val d: Vec<i64> = hex(oaep_d());
    val p: Vec<i64> = hex(oaep_p());
    val q: Vec<i64> = hex(oaep_q());
    val dp: Vec<i64> = hex(oaep_dp());
    val dq: Vec<i64> = hex(oaep_dq());
    val qi: Vec<i64> = hex(oaep_qi());
    return cb_rsa_private_blob(& n, & e, & d, & p, & q, & dp, & dq, & qi);
}

fn check_oaep(priv_blob: & Vec) {
    val v: Vec<str> = oaep_vectors();
    var valid: i64 = 0;
    var bad: i64 = 0;
    var i: i64 = 0;
    while i + 4 < v.len() {
        val want: bool = v.get(i + 1) == "valid";
        val ct: Vec<i64> = hex(v.get(i + 3));
        val label: Vec<i64> = hex(v.get(i + 4));
        var out: Vec<i64> = Vec::new();
        val got: bool = cb_rsa_decrypt_oaep(priv_blob, "SHA256", & ct, & label, & mut out);
        if got != want {
            fail("oaep tcId " + v.get(i) + ": wanted " + v.get(i + 1));
            bad = bad + 1;
        } else if got {
            val msg: Vec<i64> = hex(v.get(i + 2));
            if !eq(& out, & msg) {
                fail("oaep tcId " + v.get(i) + ": wrong message");
                bad = bad + 1;
            }
        }
        if want {
            valid = valid + 1;
        }
        i = i + 5;
    }
    if bad == 0 {
        println("oaep decrypt: " + int_to_str(v.len() / 5) + " vectors ok (" + int_to_str(valid) + " valid)");
    }
}

fn check_pkcs1_sign(priv_blob: & Vec, pub_blob: & Vec) {
    val v: Vec<str> = pkcs1_sign_vectors();
    var bad: i64 = 0;
    var i: i64 = 0;
    while i + 1 < v.len() {
        val h: Vec<i64> = crypto_sha256_bytes(hex(v.get(i)));
        val want: Vec<i64> = hex(v.get(i + 1));
        val sig: Vec<i64> = cb_rsa_sign_pkcs1(priv_blob, "SHA256", & h);
        if !eq(& sig, & want) {
            fail("pkcs1 sign of " + v.get(i) + ": another signature");
            bad = bad + 1;
        }
        if !cb_rsa_verify_pkcs1(pub_blob, "SHA256", & h, & want) {
            fail("pkcs1 sign of " + v.get(i) + ": does not verify");
            bad = bad + 1;
        }
        i = i + 2;
    }
    if bad == 0 {
        println("pkcs1 sign: " + int_to_str(v.len() / 2) + " vectors ok");
    }
}

fn check_blobs(priv_blob: & Vec) -> Vec<i64> {
    val n: Vec<i64> = hex(oaep_n());
    val e: Vec<i64> = hex(oaep_e());
    val pub_blob: Vec<i64> = cb_rsa_public_blob(& n, & e);
    // header 24, e 3 bytes, n 256 bytes
    if pub_blob.len() != 24 + 3 + 256 || cb_rsa_bits(& pub_blob) != 2048 || cb_rsa_modulus_len(& pub_blob) != 256 {
        fail("public blob size");
    }
    // "RSA1" / "RSA3"
    if pub_blob.get(0) != 82 || pub_blob.get(1) != 83 || pub_blob.get(2) != 65 || pub_blob.get(3) != 49 {
        fail("public blob magic");
    }
    if priv_blob.get(3) != 51 || priv_blob.len() != 24 + 3 + 256 + 128 * 5 + 256 {
        fail("private blob");
    }
    if !eq(& cb_rsa_public_of(priv_blob), & pub_blob) {
        fail("the public part of the private blob");
    }
    val n2: Vec<i64> = cbr_blob_part(priv_blob, 1);
    if !eq(& n2, & cbr_strip(& n)) {
        fail("the modulus read back from the blob");
    }
    // a public blob cannot sign or decrypt; a short one is no key
    val h: Vec<i64> = crypto_sha256("abc");
    if cb_rsa_sign_pkcs1(& pub_blob, "SHA256", & h).len() != 0 {
        fail("signed with a public blob");
    }
    var cut: Vec<i64> = copy_of(& pub_blob);
    cut.pop();
    if cb_rsa_verify_pkcs1(& cut, "SHA256", & h, & h) || cb_rsa_encrypt_oaep(& cut, "SHA256", & h, & h).len() != 0 {
        fail("took a cut blob");
    }
    // a hash of the wrong length
    val short: Vec<i64> = hex("0011");
    if cb_rsa_sign_pkcs1(priv_blob, "SHA256", & short).len() != 0 {
        fail("signed a hash of the wrong length");
    }
    if !g_failed {
        println("key blobs ok");
    }
    return pub_blob;
}

fn check_pss(priv_blob: & Vec, pub_blob: & Vec) {
    val h: Vec<i64> = crypto_sha256("Fides PSS");
    val s1: Vec<i64> = cb_rsa_sign_pss(priv_blob, "SHA256", & h, 32);
    val s2: Vec<i64> = cb_rsa_sign_pss(priv_blob, "SHA256", & h, 32);
    if s1.len() != 256 || s2.len() != 256 {
        fail("pss sign");
        return;
    }
    if eq(& s1, & s2) {
        fail("pss signatures are not randomized");
    }
    if !cb_rsa_verify_pss(pub_blob, "SHA256", & h, & s1, 32) || !cb_rsa_verify_pss(pub_blob, "SHA256", & h, & s2, 32) {
        fail("pss verify");
    }
    var bad: Vec<i64> = copy_of(& s1);
    bad.set(100, bad.get(100) ^ 1);
    if cb_rsa_verify_pss(pub_blob, "SHA256", & h, & bad, 32) {
        fail("pss took a corrupt signature");
    }
    if cb_rsa_verify_pss(pub_blob, "SHA256", & h, & s1, 20) {
        fail("pss took another salt length");
    }
    if cb_rsa_verify_pkcs1(pub_blob, "SHA256", & h, & s1) {
        fail("a pss signature passed as pkcs1");
    }
    // SHA-512 with its own salt length
    val h5: Vec<i64> = sha512_bytes(hex("616263"));
    val s5: Vec<i64> = cb_rsa_sign_pss(priv_blob, "SHA512", & h5, 64);
    if !cb_rsa_verify_pss(pub_blob, "SHA512", & h5, & s5, 64) {
        fail("pss sha512");
    }
    if !g_failed {
        println("pss round trip ok");
    }
}

fn check_oaep_round(priv_blob: & Vec, pub_blob: & Vec) {
    val msg: Vec<i64> = hex("48656c6c6f2c20525341");
    val label: Vec<i64> = hex("6c6162656c");
    val none: Vec<i64> = Vec::new();
    val c1: Vec<i64> = cb_rsa_encrypt_oaep(pub_blob, "SHA256", & msg, & label);
    val c2: Vec<i64> = cb_rsa_encrypt_oaep(pub_blob, "SHA256", & msg, & label);
    if c1.len() != 256 || eq(& c1, & c2) {
        fail("oaep encrypt");
        return;
    }
    var out: Vec<i64> = Vec::new();
    if !cb_rsa_decrypt_oaep(priv_blob, "SHA256", & c1, & label, & mut out) || !eq(& out, & msg) {
        fail("oaep decrypt of our own");
    }
    var out2: Vec<i64> = Vec::new();
    if cb_rsa_decrypt_oaep(priv_blob, "SHA256", & c1, & none, & mut out2) {
        fail("oaep ignored the label");
    }
    // the empty message, and the longest one: 256 - 2 * 32 - 2 = 190 bytes
    val c3: Vec<i64> = cb_rsa_encrypt_oaep(pub_blob, "SHA256", & none, & none);
    var out3: Vec<i64> = Vec::new();
    if !cb_rsa_decrypt_oaep(priv_blob, "SHA256", & c3, & none, & mut out3) || out3.len() != 0 {
        fail("oaep empty message");
    }
    var longest: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 190 {
        longest.push(i & 255);
        i = i + 1;
    }
    var out4: Vec<i64> = Vec::new();
    val c4: Vec<i64> = cb_rsa_encrypt_oaep(pub_blob, "SHA256", & longest, & none);
    if !cb_rsa_decrypt_oaep(priv_blob, "SHA256", & c4, & none, & mut out4) || !eq(& out4, & longest) {
        fail("oaep longest message");
    }
    longest.push(0);
    if cb_rsa_encrypt_oaep(pub_blob, "SHA256", & longest, & none).len() != 0 {
        fail("oaep took a message one byte too long");
    }
    if !g_failed {
        println("oaep round trip ok");
    }
}

fn check_generated() {
    var priv_blob: Vec<i64> = Vec::new();
    var pub_blob: Vec<i64> = Vec::new();
    if cb_rsa_generate(2048, & mut priv_blob, & mut pub_blob) != 0 {
        fail("rsa generate");
        return;
    }
    if cb_rsa_bits(& pub_blob) != 2048 || !cbr_blob_ok(& priv_blob, true) || !eq(& cb_rsa_public_of(& priv_blob), & pub_blob) {
        fail("generated blobs");
        return;
    }
    // e = 65537
    if !eq(& cbr_blob_part(& pub_blob, 0), & hex("010001")) {
        fail("generated exponent");
    }
    val h: Vec<i64> = crypto_sha256("generated");
    val s: Vec<i64> = cb_rsa_sign_pkcs1(& priv_blob, "SHA256", & h);
    if !cb_rsa_verify_pkcs1(& pub_blob, "SHA256", & h, & s) {
        fail("generated key pkcs1");
    }
    val sp: Vec<i64> = cb_rsa_sign_pss(& priv_blob, "SHA256", & h, 32);
    if !cb_rsa_verify_pss(& pub_blob, "SHA256", & h, & sp, 32) {
        fail("generated key pss");
    }
    val m: Vec<i64> = hex("00ff00ff");
    val none: Vec<i64> = Vec::new();
    val c: Vec<i64> = cb_rsa_encrypt_oaep(& pub_blob, "SHA256", & m, & none);
    var out: Vec<i64> = Vec::new();
    if !cb_rsa_decrypt_oaep(& priv_blob, "SHA256", & c, & none, & mut out) || !eq(& out, & m) {
        fail("generated key oaep");
    }
    if !g_failed {
        println("generated key ok");
    }
}

fn main() -> i64 {
    val n1: Vec<i64> = hex(pkcs1_n());
    val e1: Vec<i64> = hex(pkcs1_e());
    val pub1: Vec<i64> = cb_rsa_public_blob(& n1, & e1);
    check_signatures("pkcs1 verify", & pub1, pkcs1_vectors(), - 1);
    val n2: Vec<i64> = hex(pss_n());
    val e2: Vec<i64> = hex(pss_e());
    val pub2: Vec<i64> = cb_rsa_public_blob(& n2, & e2);
    check_signatures("pss verify", & pub2, pss_vectors(), 32);
    val priv: Vec<i64> = oaep_key();
    if priv.len() == 0 {
        fail("the OAEP key's blob");
        return 1;
    }
    check_oaep(& priv);
    val pub3: Vec<i64> = cb_rsa_public_of(& priv);
    check_pkcs1_sign(& priv, & pub3);
    check_blobs(& priv);
    check_pss(& priv, & pub3);
    check_oaep_round(& priv, & pub3);
    check_generated();
    if g_failed {
        println("FAIL");
        return 1;
    }
    println("crypto_bind rsa: all ok");
    return 0;
}

// ─── vectors ────────────────────────────────────────────────────────────

// rsa_signature_2048_sha256_test.json, group 1: e, n
fn pkcs1_e() -> str { return "010001"; }
fn pkcs1_n() -> str {
    return "00a2b451a07d0aa5f96e455671513550514a8a5b462ebef717094fa1fee82224e637f9746d3f7cafd31878d80325b6ef5a17"
        + "00f65903b469429e89d6eac8845097b5ab393189db92512ed8a7711a1253facd20f79c15e8247f3d3e42e46e48c98e254a2f"
        + "e9765313a03eff8f17e1a029397a1fa26a8dce26f490ed81299615d9814c22da610428e09c7d9658594266f5c021d0fceca0"
        + "8d945a12be82de4d1ece6b4c03145b5d3495d4ed5411eb878daf05fd7afc3e09ada0f1126422f590975a1969816f48698bcb"
        + "ba1b4d9cae79d460d8f9f85e7975005d9bc22c4e5ac0f7c1a45d12569a62807d3b9a02e5a530e773066f453d1f5b4c2e9cf7"
        + "820283f742b9d5";
}

