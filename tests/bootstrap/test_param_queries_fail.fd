// expect-error: Injection error (F68): cannot use + to concatenate typed string 'SQLSt
// Test: F68 parameterized queries — string concat on typed strings should fail
//
// This is an expected-fail test: concatenating a SQLString with a raw str
// using + should be a compile error (injection prevention).

use typed_strings;

fn bad_query(user_input: str) -> SQLString {
    // BAD: concatenating SQLString with raw input — injection risk!
    val sql = sql_query("SELECT * FROM users WHERE name = '") ;
    val full = sql + user_input;  // should be compile error
    return full;
}

fn main() {
    val result = bad_query("admin'; DROP TABLE users; --");
    print(result.value);
}
