// A program's own function shadows a generic function of core with the same
// name (release A11: 8 tests of tests/selfhost/ define their own
// `assert_eq(actual: str, expected: str, label: str)`, core has
// `assert_eq<T>(a: T, b: T)`). The call must go to the program's
// three-parameter function; fid instead type-checks it against core's
// generic one and rejects it: "cannot infer the type parameter 'T' of
// 'assert_eq': no argument gives it".
// Expected output:
// ok same
// FAIL differ: got b, wanted c
// ok 7
// shadow ok
fn assert_eq(actual: str, expected: str, label: str) -> void {
    if actual == expected {
        println("ok " + label);
    } else {
        println("FAIL " + label + ": got " + actual + ", wanted " + expected);
    }
}

fn main() -> i64 {
    assert_eq("a", "a", "same");
    assert_eq("b", "c", "differ");
    assert_eq(int_to_str(3 + 4), "7", "7");
    println("shadow ok");
    return 0;
}
