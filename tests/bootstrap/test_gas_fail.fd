// Test: @gas annotation — expected FAIL (exceeds gas budget)
// This function has too many operations for its gas budget.
// The compiler should reject it at compile time.

@gas(3)
fn too_expensive(a: i64, b: i64, c: i64) -> i64 {
    val x = a + b;
    val y = x + c;
    val z = y * 2;
    return z + 1;
}

fn main() {
    val r = too_expensive(1, 2, 3);
    print(r);
}
