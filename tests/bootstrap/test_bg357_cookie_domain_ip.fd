// Bugs roadmap BG357: stdlib/cookie.fd cookie_domain_match applied the
// "host ends with . + domain" rule to IP addresses, so a cookie with
// Domain=168.1.5 was sent to 192.168.1.5. RFC 6265 §5.1.3 allows the
// suffix form only for host names; an IP address matches only itself.
//
// Expected output:
// false false
// true true
// true false
// true true
// false

use cookie;

fn main() {
    println(f"{cookie_domain_match("0.0.1", "10.0.0.1")} {cookie_domain_match("168.1.5", "192.168.1.5")}");
    println(f"{cookie_domain_match("192.168.1.5", "192.168.1.5")} {cookie_domain_match("example.com", "www.Example.com")}");
    println(f"{cookie_domain_match("::1", "::1")} {cookie_domain_match("1", "::1")}");
    println(f"{cookie_domain_match("example.com", "example.com")} {cookie_domain_match("b.c", "a.b.c")}");
    println(f"{cookie_domain_match("example.com", "badexample.com")}");
}
