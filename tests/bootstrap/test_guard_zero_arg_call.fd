// BG83 (docs/roadmap/bugs-roadmap.md): the bounds-check analysis of a
// block guarded by `i < v.len()` (compiler/checks.fd peir_guard_ops) read
// `args.get(at + 1)` of every call in the guarded region before testing
// that the call was a Vec_get/Vec_set (at >= 0): a call with no arguments
// there read args.get(0) of an empty list and the compiler panicked. Now
// the index is read only for a Vec_get/Vec_set. `tick` prints, so the
// mid-end does not inline it and the call stays in the guarded block.
//
// Expected output:
// tick
// 21
// -1
// tick
// 31

fn tick() -> i64 {
    println("tick");
    return 1;
}

fn at(v: &Vec<i64>, i: i64) -> i64 {
    if i < v.len() {
        val t: i64 = tick();
        return v.get(i) + t;
    }
    return 0 - 1;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(10);
    v.push(20);
    v.push(30);
    println(at(&v, 1));
    println(at(&v, 5));
    println(at(&v, 2));
    return 0;
}
