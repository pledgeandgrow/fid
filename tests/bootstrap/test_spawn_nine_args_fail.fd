// expect-error: `spawn w9(...)` passes 9 arguments; a function started as a thread or task takes at most 8
//! error: `spawn w9(...)` passes 9 arguments
// Bugs roadmap BG159: a thread started by name gets its arguments through
// its block, which has room for 8 on every compiled backend. `check`
// accepted a ninth: `fid run` printed 936, C dropped it (later a panic),
// emit read the block's done flag in its place (536874169636). Now refused
// at compile time (typechecker TypeChecker_check_task_arity).
fn w9(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> i64 {
    return a + b + c + d + e + f + g + h + i * 100;
}

fn main() -> i64 {
    println(await spawn w9(1, 2, 3, 4, 5, 6, 7, 8, 9));
    return 0;
}
