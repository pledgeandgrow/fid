// expect-error: cannot read m
// LG3 (docs/roadmap/competitive-roadmap.md): a read beside a named mutable
// borrower is an error inside a call's arguments too (a temporary of the
// same call is not: test_lg3_read_during_mut_borrow).
fn id_mut<'a>(x: &'a mut i64) -> &'a mut i64 {
    return x;
}

fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn main() -> i64 {
    var m: i64 = 1;
    val r = id_mut(&mut m);
    val v = add(m, *r + 1);
    return v;
}
