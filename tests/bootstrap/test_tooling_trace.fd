// CT10 (docs/roadmap/complaint-roadmap.md): `fid run <file> --trace f,g`
// prints each call of f and g, with its arguments and its result, on
// stderr; the program is not changed and its output stays the same.
// scripts/tooling-goals-check.sh runs this file with
// `--trace add,Point::norm2,greet` and checks the trace lines:
//   [trace]   add(3, 4)
//   [trace]   add = 7
//   [trace]   Point_norm2(...)      (a method is traced by T::m or T_m)
//   [trace]   greet("ann")
//   [trace]   greet = "hi ann"
// Expected output:
// 7
// 25
// hi ann

struct Point {
    x: i64,
    y: i64,
}

impl Point {
    fn norm2(self: &Point) -> i64 {
        return self.x * self.x + self.y * self.y;
    }
}

fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn greet(name: str) -> str {
    return "hi " + name;
}

fn main() -> i64 {
    println(add(3, 4));
    val p: Point = Point { x: 3, y: 4 };
    println(p.norm2());
    println(greet("ann"));
    return 0;
}
