// Bugs roadmap BG157: an f32 inside an f-string printed as an integer bit
// pattern (lower.fd Lowerer_lower_fstring_expr sent only f64 parts to
// p_float_to_str; an f32 went to p_to_str: 4608308318706860032 for 1.25).
// It is widened to f64, as `x as f64` does, and shown as a float.
//
// Expected output:
// 1.25
// x=0.5, y=1.25
// 1.25 1.25
// -3

fn id32(x: f32) -> f32 {
    return x;
}

fn main() -> i64 {
    val ff: f32 = id32(1.25 as f32);
    println(f"{ff}");
    val h: f32 = id32(0.5 as f32);
    println(f"x={h}, y={ff}");
    val d: f64 = 1.25;
    println(f"{d} {ff}");
    val n: f32 = id32(0.0 as f32) - id32(3.0 as f32);
    println(f"{n}");
    return 0;
}
