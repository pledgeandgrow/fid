// expect-error: was already consumed
// Bugs roadmap BG186: an enum literal's payload was not consumed, so a
// linear value put in `Option::Some(t)` could be used again.
@linear
struct Tok {
    v: i64,
}

fn use_tok(t: Tok) -> i64 {
    return t.v;
}

fn main() -> i64 {
    val t = Tok { v: 1 };
    val o: Option<Tok> = Option::Some(t);
    println(use_tok(t));
    match o {
        Option::Some(x) => {
            println(use_tok(x));
        }
        Option::None => {
        }
    }
    return 0;
}
