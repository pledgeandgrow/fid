// LG4: `impl<T> Trait for Slot<T>`, default methods, trait objects and
// bounds together.
cap Show {
    fn show(self) -> i64;
    fn twice(self) -> i64 { return self.show() * 2; }
}

struct Slot<T> { v: T, tag: i64 }

impl<T> Show for Slot<T> {
    fn show(self) -> i64 { return self.tag; }
}

struct Pt { x: i64 }

impl Show for Pt {
    fn show(self) -> i64 { return self.x; }
    fn twice(self) -> i64 { return 99; }
}

fn twice_of<T: Show>(x: T) -> i64 { return x.twice(); }

fn main() -> i64 {
    val a: Slot<i64> = Slot { v: 5, tag: 7 };
    val b: Slot<str> = Slot { v: "s", tag: 8 };
    println(a.show());
    println(b.twice());
    println(twice_of(a));
    val p: Pt = Pt { x: 3 };
    println(p.show());
    println(twice_of(p));
    val d = p as dyn Show;
    println(d.show());
    return 0;
}
