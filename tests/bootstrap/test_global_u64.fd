// known-bugs 2g.72: a global u64 was read as signed on the interpreter and
// C: `println(g)` printed -1 and `g >> 60` shifted in the sign bit (-1); a
// local copy shifted right correctly (15). The global's declared type now
// types the expressions it is in, and println prints a u64 as print does.
//
// Expected output:
// 18446744073709551615
// 15
// 15
// 9223372036854775807
// 5
// 1
// 18446744073709551615
// 4294967295
// 15
// 18446744073709551614
// 255
use core;

var g: u64 = 18446744073709551615;
var h: u32 = 4294967295;

fn top_nibble() -> u64 {
    return g >> 60;
}

fn main() -> i64 {
    println(g);
    println(g >> 60);
    println(top_nibble());
    println(g / 2);
    println(g % 10);
    if g > 1 {
        println(1);
    } else {
        println(0);
    }
    val l: u64 = g;
    println(l);
    println(h);
    println(h >> 28);
    g = g - 1;
    println(g);
    println((g >> 56) & 255);
    return 0;
}
