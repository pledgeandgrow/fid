// Test generic functions with monomorphization

fn identity<T>(x: T) -> T {
    return x;
}

fn max_value<T>(a: T, b: T) -> T {
    if a > b {
        return a;
    } else {
        return b;
    }
}

fn main() -> i32 {
    // identity with i32
    val a = identity(42);
    print(a);

    // identity with i64
    val b: i64 = identity(100);
    print(b);

    // max_value with i32
    val m = max_value(10, 20);
    print(m);

    // max_value with i64
    val n: i64 = max_value(50, 30);
    print(n);

    return 0;
}
