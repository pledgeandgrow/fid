// SP10: the borrow checker finds a borrow on a parent path (`&t.m` for a
// use of `t.m.d`) through prefix counts walked from the root down; a
// prefix with no borrow at or under it ends the walk. Here `t.n` is
// mutably borrowed, so the root `t` has a live borrow under it, but no
// parent of `t.m.d` / `t.m.d.x` is borrowed: both borrows are accepted
// (the walk must not stop early with a wrong yes, nor take `t.n` for a
// parent).
// Expected output:
// 3
// 11
// 7
// 12

struct Deep { x: i64 }
struct Mid { d: Deep, k: i64 }
struct Top { m: Mid, n: i64 }

fn rd(r: &Deep) -> i64 { return r.x; }
fn rk(r: &i64) -> i64 { return *r; }
fn bump(r: &mut i64) { *r = *r + 1; }

fn main() -> i64 {
    var t = Top { m: Mid { d: Deep { x: 3 }, k: 7 }, n: 10 };
    val rb = &mut t.n;
    val rdd = &t.m.d;
    val rx = &t.m.d.x;
    println(rd(rdd));
    bump(rb);
    println(t.n);
    val rkk = &t.m.k;
    println(rk(rkk) + rk(rx) - 3);
    t.m.d.x = 12;
    println(t.m.d.x);
    return 0;
}
