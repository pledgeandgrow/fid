// expect-error: Linear type error (line 17): cannot reassign 't'
//! error: Linear type error (line 17): cannot reassign 't'
// TL2: a test per diagnostic of the type, borrow and escape checks.
// Assigning over an unconsumed @linear value would destroy it silently.

@linear
struct Tok {
    a: i64,
}

fn spend(t: Tok) -> i64 {
    return t.a;
}

fn main() -> i64 {
    var t = Tok { a: 1 };
    t = Tok { a: 2 }; // <- here
    println(spend(t));
    return 0;
}
