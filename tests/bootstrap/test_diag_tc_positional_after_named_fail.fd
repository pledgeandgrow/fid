// expect-error: a positional argument after a named one
// Expected to FAIL (CL4): `area(w: 2, 3)` gives a positional argument after
// a named one (TypeChecker_check_named_args). fid at HEAD (before the CL4
// check) accepted it and ran area(2, 0).
fn area(w: i64, h: i64) -> i64 {
    return w * h;
}

fn main() -> i64 {
    val a: i64 = area(w: 2, 3);
    println(a);
    return 0;
}
