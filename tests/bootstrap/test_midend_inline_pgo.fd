// OP5 (competitive roadmap): inline2's size rule weighed by a profile
// (compiler/iropt_me.fd ime_inline_weigh). `hot` is called 5,000 times in
// a profiled run and is bigger than IME_INLINE_MAX for one call site
// nowhere near once: with `--profile-use` it may be inlined (twice the
// limit); `cold` is never called in the run and is not. The result must
// not change: tests/tooling/inline-pgo-check.sh runs it with
// `fid run --profile`, then `FID_IROPT_ON=inline2 fid emit --profile-use`
// and without the profile, and compares the three outputs.
//
// Expected output:
// 37492500
// 0
// 3

fn hot(x: i64) -> i64 {
    var a: i64 = x * 3;
    var b: i64 = a + 7;
    var c: i64 = b % 11;
    var d: i64 = c * c;
    var e: i64 = d + a;
    var f: i64 = e - b;
    var g: i64 = f + c;
    var h: i64 = g * 2;
    var i: i64 = h - d;
    var j: i64 = i + e;
    var k: i64 = j - f;
    var l: i64 = k + g;
    var m: i64 = l - h;
    var n: i64 = m + i;
    var o: i64 = n - j;
    var p: i64 = o + k;
    var q: i64 = p - l;
    var r: i64 = q + m;
    var s: i64 = r - n;
    var t: i64 = s + o;
    var u: i64 = t - p;
    var v: i64 = u + q;
    var w: i64 = v - r;
    var y: i64 = w + s;
    var z: i64 = y - t;
    if z > 1000000000 {
        return 0;
    }
    return x;
}

fn cold(x: i64) -> i64 {
    if x > 100 {
        return x - 100;
    }
    return 0;
}

fn twice(x: i64) -> i64 {
    return x + x - x;
}

fn main() {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 5000 {
        total = total + hot(i) * 3;
        i = i + 1;
    }
    println(total);
    if total < 0 {
        println(cold(total));
    } else {
        println(0);
    }
    println(twice(3));
}
