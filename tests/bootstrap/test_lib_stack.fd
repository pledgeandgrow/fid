// stdlib/stack: LIFO order, empty reads, peek_at depth, contains, drain,
// from_vec and to_vec.
use stack;

fn main() -> i64 {
    var s = Stack::new();
    println(s.is_empty());
    println(s.len());
    println(s.pop());
    println(s.peek());
    println(s.peek_at(0));

    s.push(1);
    s.push(2);
    s.push(3);
    println(s.len());
    println(s.peek());
    println(s.peek_at(0));
    println(s.peek_at(2));
    println(s.peek_at(3));
    println(s.peek_at(-1));
    println(s.contains(2));
    println(s.contains(9));
    println(s.pop());
    println(s.pop());
    println(s.len());

    var t = s.to_vec();
    println(t.len());
    println(t.get(0));

    s.push(7);
    s.push(8);
    var d = s.drain();
    println(d.len());
    println(d.get(0));
    println(d.get(1));
    println(d.get(2));
    println(s.is_empty());

    var v: Vec<i64> = Vec::new();
    v.push(4);
    v.push(5);
    v.push(6);
    var f = Stack::from_vec(v);
    println(f.peek());
    println(f.len());
    f.clear();
    println(f.is_empty());
    println(f.pop());
    return 0;
}
