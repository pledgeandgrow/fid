// expect-error: Ambiguous name: value 'K' used in module 'main' is defined in module
// Bugs roadmap BG142: modules ma and mb both define `pub const K` with
// other values (same_name_lib). Each module keeps its own copy now
// (compiler.fd cc_qualify_shadowed_values), so the program's bare `K` names
// neither: it is an error, and `ma::K` / `mb::K` say which
// (test_module_same_names.fd). Before, it silently read the copy merged
// last.
use same_name_lib::ma;
use same_name_lib::mb;

fn main() -> i64 {
    println(int_to_str(K));
    return 0;
}
