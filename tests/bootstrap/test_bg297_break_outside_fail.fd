// expect-error: `break` outside a loop
// Bugs roadmap BG297: break applies to the innermost loop (reference §5.4);
// with no loop it was dropped and "after break" printed.
fn h(x: i64) -> i64 {
    if x > 0 {
        break;
    }
    println("after break");
    return 1;
}

fn main() -> i64 {
    println(h(5));
    return 0;
}
