// Miscompile log M12 (docs/verification/miscompile-log.md; repro
// tests/verify/bugs/m12_bitnot_narrow_unsigned.fd, promoted here when fixed,
// VF20). `~x` on an unsigned type narrower than 64 bits keeps the declared
// width (§3.5): `~3u8` is 252. Before the fix (compiler/lower.fd, "M12")
// `fid run` and every `fid emit` backend gave the 64-bit complement -4 in an
// expression, so `~a > 200` was false, `(~a) as i64` printed -4 and
// `~a - a` panicked; a store into a typed `var` masked it. Found by
// scripts/fuzz/gen_vs_c.py --backends all, seed 1 (RL1).
//
// Expected output:
// 252
// 249
// 1
// 65534
// 4294967295
// 252
// 249
// 65535
// 1

fn main() -> i64 {
    var a: u8 = 3;
    var n: u8 = ~a;
    println(n);
    var d: u8 = n - a;
    println(d);
    if ~a > 200 {
        println(1);
    } else {
        println(0);
    }
    var w: u16 = 1;
    var nw: u16 = ~w;
    println(nw);
    var x: u32 = 0;
    var nx: u32 = ~x;
    println(nx);
    println((~a) as i64);
    println((~a - a) as i64);
    var z: u16 = 0;
    println((~z) as i64);
    if ~x == 4294967295 {
        println(1);
    } else {
        println(0);
    }
    return 0;
}
