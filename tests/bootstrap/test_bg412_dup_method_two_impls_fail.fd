// expect-error: Duplicate definition: method 'get' of 'Pt' is defined twice
// Bugs roadmap BG412: the same with the two `get`s in two `impl Pt` blocks.
struct Pt {
    x: i64,
}
impl Pt {
    fn get(self) -> i64 {
        return 1;
    }
}
impl Pt {
    fn get(self) -> i64 {
        return 2;
    }
}
fn main() {
    val p = Pt { x: 0 };
    println(p.get());
}
