// expect-error: cannot mutate b: shared borrow(s) are active
// LG3: `make`'s lifetimes tie its result, a struct holding a reference, to
// `x`: `w` borrows `b`.
struct View<'a> {
    r: &'a i64,
    k: i64,
}

fn make<'a>(x: &'a i64, k: i64) -> View<'a> {
    return View { r: x, k: k };
}

fn main() -> i64 {
    var b: i64 = 1;
    val w = make(&b, 10);
    b = 2;
    println(*w.r);
    return 0;
}
