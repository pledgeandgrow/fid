// expect-error: function 'relay' is safety-annotated but calls 'read_sensor'
// Roadmap Phase 9 / F59: a @grid-safe function may call only functions with
// the same guarantees: a helper without them (here one that sleeps) is
// rejected at the call.

fn read_sensor(ch: i64) -> i64 {
    p_co_sleep(5);
    return ch * 10;
}

@grid-safe
fn relay(ch: i64) -> i64 {
    if read_sensor(ch) > 1000 {
        return 1;
    }
    return 0;
}

fn main() -> i64 {
    println(int_to_str(relay(200)));
    return 0;
}
