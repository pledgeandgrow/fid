// A generic struct returned by value, as a literal and through a local,
// is returned through SRET like any struct (its value was a pointer to the
// callee's stack, and a C build crashed reading it). Expected output:
// t
// 5
// u
// 7
// 2

struct Mat<T> { data: Vec<T>, tag: str }

fn mk(k: i64) -> Mat<i64> {
    var d: Vec<i64> = Vec::new();
    d.push(k);
    return Mat { data: d, tag: "t" };
}

fn mk2(k: i64) -> Mat<i64> {
    var d: Vec<i64> = Vec::new();
    d.push(k);
    d.push(k + 1);
    val r: Mat<i64> = Mat { data: d, tag: "u" };
    return r;
}

fn main() -> i64 {
    val m: Mat<i64> = mk(5);
    println(m.tag);
    println(m.data.get(0));
    val q: Mat<i64> = mk2(7);
    println(q.tag);
    println(q.data.get(0));
    println(q.data.len());
    return 0;
}
