// Test (stdlib-agent bugs 8 and 44): `v.extend(r)` with r: &Vec<i64> (the
// escape check refused it: extend copies the elements and keeps nothing
// of r), and HashMap::contains_key, another name of contains.
// Expected output:
// 3 3 2
// k yes
// z no
// 5 yes
fn add_all(v: & mut Vec<i64>, r: & Vec<i64>) {
    v.extend(r);
}

fn main() {
    var a: Vec<i64> = Vec::new();
    a.push(1);
    var b: Vec<i64> = Vec::new();
    b.push(2);
    b.push(3);
    add_all(& mut a, & b);
    println(int_to_str(a.len()) + " " + int_to_str(a.get(2)) + " " + int_to_str(b.len()));
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("k", 1);
    if m.contains_key("k") {
        println("k yes");
    }
    if !m.contains_key("z") {
        println("z no");
    }
    var n: HashMap<i64, i64> = HashMap::new();
    n.insert(5, 50);
    if n.contains_key(5) && !n.contains_key(6) {
        println("5 yes");
    }
}
