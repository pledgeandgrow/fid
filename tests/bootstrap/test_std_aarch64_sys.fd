// stdlib/aarch64_sys: SPSR/ESR decode, MRS/MSR encodings, generic timer math, 4K-granule page tables built and walked, GICv2/v3 register sequences on a fake bus.
// Expected output:
// CurrentEL 0x4 -> EL1, spsr 0x000003C5 EL1h DAIF=1111 NZCV=0000
// EL1t DAIF=0000 NZCV=0110 / AArch32 mode 0x10 DAIF=0000 NZCV=0000
// Data abort from the same EL: Translation fault, level 1, write, FAR 0x0000000000001234
// Data abort from a lower EL: Permission fault, level 3, read, 8 bytes into x1, FAR 0x0000FFFF00001000
// SVC (AArch64) #128 / BRK instruction (AArch64) #1000
// Trapped MSR/MRS/system instruction: MRS S3_3_C14_C0_2 x2
// vector lower-EL IRQ +0x480
// 0xD5384240 mrs x0, CurrentEL
// 0xD518C000 msr VBAR_EL1, x0
// 0xD53BE021 mrs x1, CNTPCT_EL0
// mpidr 0.0.1.1
// tval 1ms @62.5MHz: 62500 read after deadline: -50 fires: true masked: false
// MAIR 0xFF440400 TCR 0x00000005B5103510
// descriptors: 1 1 2 2 1, next table 0x80006000
// 0x40001234 -> 0x40001234 level 1
// 0x09000010 -> 0x09000010 level 3
// 0x80400008 -> 0x80400008 level 2
// 0x80601FFC -> 0x80601FFC level 3
// 0x80602000 -> Translation fault, level 3
// 0x80700000 -> Access flag fault, level 3
// 0x100000000 -> Translation fault, level 1
// 0x1000000000000 -> Translation fault, level 0 (VA outside TTBR0 range)
// L0[0] table -> 0x80001000
// page 0x09000000 attr0 EL1-RW AF PXN UXN
// block 0x40000000 attr3 EL1-RW ISH AF
// EL0 read of UART: EL0 has no access; EL1 exec RAM: ok; EL1 write RO: read-only
// gicv2 init: 21 writes, last W 0x08000000 <- 0x00000001
// W 0x08000C08 <- 0x00000008
// W 0x08000104 <- 0x00000002
// W 0x08000421 <- 0x80
// W 0x08000F00 <- 0x00020001
// ack 0x00000801 intid 1 from cpu 2 SGI
// W 0x08010010 <- 0x00000801
// sgi1r 0x0000000003010005 all-but-self 0x0000010003000000 irouter 0x0000000000000102
// wake: false then true
// W 0x08006140 <- 0x0000000000000102
use aarch64_sys;
use regmap;
use vec;
use string;

fn flush(bus: &mut RegBus) {
    var i: i64 = 0;
    while i < bus.log.len() {
        if str_starts_with(bus.log.get(i), "W") { println(bus.log.get(i)); }
        i = i + 1;
    }
    bus.log.clear();
}

fn bs(b: bool) -> str {
    if b { return "true"; }
    return "false";
}

fn walk(m: &A64Mem, va: i64) {
    val w: A64Walk = a64mem_walk(m, va);
    if w.ok {
        println(regmap_hex(va, 8) + " -> " + regmap_hex(w.pa, 8) + " level " + int_to_str(w.level));
    } else {
        println(regmap_hex(va, 8) + " -> " + w.fault);
    }
}

fn okstr(s: str) -> str {
    if str_len(s) == 0 { return "ok"; }
    return s;
}

fn main() {
    val sp: i64 = a64_spsr(1, PSTATE_D | PSTATE_A | PSTATE_I | PSTATE_F);
    println("CurrentEL 0x4 -> EL" + int_to_str(a64_current_el(4)) + ", spsr " + regmap_hex(sp, 8) + " " + a64_spsr_decode(sp));
    println(a64_spsr_decode(0x60000004) + " / " + a64_spsr_decode(0x10));
    println(a64_esr_decode(0x96000045, 0x1234));
    println(a64_esr_decode(0x93C1000F, 0x0000FFFF00001000));
    println(a64_esr_decode(0x56000080, 0) + " / " + a64_esr_decode(0xF20003E8, 0));
    println(a64_esr_decode(0x6234F841, 0));
    println("vector lower-EL IRQ +" + regmap_hex(a64_vector_offset(2, 1), 3));
    val m1: i64 = a64_mrs(0, A64_CURRENTEL());
    println(regmap_hex(m1, 8) + " " + a64_sysreg_disasm(m1));
    val m2: i64 = a64_msr(A64_VBAR_EL1(), 0);
    println(regmap_hex(m2, 8) + " " + a64_sysreg_disasm(m2));
    val m3: i64 = a64_mrs(1, A64_CNTPCT_EL0());
    println(regmap_hex(m3, 8) + " " + a64_sysreg_disasm(m3));
    println("mpidr " + a64_mpidr_decode(0x80000101));
    val ctl: i64 = a64_timer_ctl(true, false, 100, 150);
    println("tval 1ms @62.5MHz: " + int_to_str(a64_timer_tval(62500000, 1000)) + " read after deadline: " + int_to_str(a64_timer_tval_read(100, 150))
        + " fires: " + bs(a64_timer_fires(ctl)) + " masked: " + bs(a64_timer_fires(a64_timer_ctl(true, true, 100, 150))));
    var attrs: Vec<i64> = Vec::new();
    attrs.push(MAIR_DEVICE_NGNRNE);
    attrs.push(MAIR_DEVICE_NGNRE);
    attrs.push(MAIR_NORMAL_NC);
    attrs.push(MAIR_NORMAL_WB);
    println("MAIR " + regmap_hex(a64_mair(attrs), 8) + " TCR " + regmap_hex(a64_tcr(48, 5), 16));

    var m: A64Mem = a64mem_new(0x80000000);
    val ram: i64 = DESC_SH_INNER | DESC_AF;
    val dev: i64 = DESC_AF | DESC_PXN | DESC_UXN;
    val n1: i64 = a64mem_map(&mut m, 0x40000000, 0x40000000, 0x40000000, 3, ram);
    val n2: i64 = a64mem_map(&mut m, 0x09000000, 0x09000000, 0x1000, 0, dev);
    val n3: i64 = a64mem_map(&mut m, 0x80200000, 0x80200000, 0x400000, 3, ram);
    val n4: i64 = a64mem_map(&mut m, 0x80600000, 0x80600000, 0x2000, 3, ram | DESC_AP_RO_EL1);
    val n5: i64 = a64mem_map(&mut m, 0x80700000, 0x80700000, 0x1000, 3, DESC_SH_INNER);
    println("descriptors: " + int_to_str(n1) + " " + int_to_str(n2) + " " + int_to_str(n3) + " " + int_to_str(n4) + " " + int_to_str(n5)
        + ", next table " + regmap_hex(m.next_pa, 8));
    walk(&m, 0x40001234);
    walk(&m, 0x09000010);
    walk(&m, 0x80400008);
    walk(&m, 0x80601FFC);
    walk(&m, 0x80602000);
    walk(&m, 0x80700000);
    walk(&m, 0x100000000);
    walk(&m, 0x1000000000000);
    println("L0[0] " + a64_desc_decode(m.tables.get(m.root).get(0), 0));
    val wu: A64Walk = a64mem_walk(&m, 0x09000000);
    println(a64_desc_decode(wu.desc, 3));
    val wr: A64Walk = a64mem_walk(&m, 0x40000000);
    println(a64_desc_decode(wr.desc, 1));
    val wro: A64Walk = a64mem_walk(&m, 0x80600000);
    println("EL0 read of UART: " + okstr(a64_check_access(wu.desc, 0, false, false)) + "; EL1 exec RAM: " + okstr(a64_check_access(wr.desc, 1, false, true))
        + "; EL1 write RO: " + okstr(a64_check_access(wro.desc, 1, true, false)));

    var bus: RegBus = regbus_fake();
    val gicd: i64 = 0x08000000;
    val gicc: i64 = 0x08010000;
    regbus_poke(&mut bus, gicd + GICD_TYPER, 1);
    gicv2_init_dist(&mut bus, gicd);
    var nw: i64 = 0;
    var last: str = "";
    var i: i64 = 0;
    while i < bus.log.len() {
        if str_starts_with(bus.log.get(i), "W") {
            nw = nw + 1;
            last = bus.log.get(i);
        }
        i = i + 1;
    }
    println("gicv2 init: " + int_to_str(nw) + " writes, last " + last);
    bus.log.clear();
    gic_set_edge(&mut bus, gicd, 33, true);
    gic_enable(&mut bus, gicd, 33);
    gic_set_priority(&mut bus, gicd, 33, 0x80);
    gicv2_send_sgi(&mut bus, gicd, 1, 0x2);
    flush(&mut bus);
    regbus_poke(&mut bus, gicc + GICC_IAR, (2 << 10) | 1);
    val iar: i64 = gicv2_ack(&mut bus, gicc);
    println("ack " + regmap_hex(iar, 8) + " intid " + int_to_str(iar & 0x3FF) + " from cpu " + int_to_str((iar >> 10) & 7) + " " + gic_kind(iar & 0x3FF));
    bus.log.clear();
    gicv2_eoi(&mut bus, gicc, iar);
    flush(&mut bus);

    println("sgi1r " + regmap_hex(gicv3_sgi1r(3, 0, 0, 1, 5, false), 16) + " all-but-self " + regmap_hex(gicv3_sgi1r(3, 0, 0, 0, 0, true), 16)
        + " irouter " + regmap_hex(gicv3_irouter(0, 0, 1, 2, false), 16));
    val rd: i64 = gicr_base(0x080A0000, 1);
    regbus_poke(&mut bus, rd + GICR_WAKER, 6);
    val w1: bool = gicv3_wake(&mut bus, rd, 3);
    regbus_poke(&mut bus, rd + GICR_WAKER, 0);
    val w2: bool = gicv3_wake(&mut bus, rd, 3);
    println("wake: " + bs(w1) + " then " + bs(w2));
    bus.log.clear();
    gicv3_route_spi(&mut bus, gicd, 40, gicv3_irouter(0, 0, 1, 2, false));
    flush(&mut bus);
}
