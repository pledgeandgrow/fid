// LG4: a default trait method is reached through a trait object, and an
// override wins over the default there too.
// Expected output:
// 9
// 18
// 1000
// 1018

cap Shape {
    fn area(self) -> i64;
    fn double_area(self) -> i64 { return self.area() * 2; }
}

struct Sq { s: i64 }

impl Shape for Sq {
    pub fn area(self: Sq) -> i64 { return self.s * self.s; }
}

struct Rect { w: i64, h: i64 }

impl Shape for Rect {
    pub fn area(self: Rect) -> i64 { return self.w * self.h; }
    pub fn double_area(self: Rect) -> i64 { return 1000; }
}

fn total(a: dyn Shape, b: dyn Shape) -> i64 {
    return a.double_area() + b.double_area();
}

fn main() -> i64 {
    val q = Sq { s: 3 };
    val r = Rect { w: 2, h: 5 };
    val dq = q as dyn Shape;
    val dr = r as dyn Shape;
    println(dq.area());
    println(dq.double_area());
    println(dr.double_area());
    println(total(dq, dr));
    return 0;
}
