// L8E (2g.84): the variable of an unrolled `for x in xs` over a pack has
// its element's type, so a call on it takes that type's overload, also in
// a pack loop nested in another (mono.fd: each copy's variable aliases
// xs__<k>, innermost loop first).
//
// Expected output:
// pairs: int 1/int 1 int 1/yes yes/int 1 yes/yes
// first: str a
// count: 2

fn describe<T>(x: T) -> str {
    return "other";
}

fn describe(x: i64) -> str {
    return "int " + int_to_str(x);
}

fn describe(x: str) -> str {
    return "str " + x;
}

fn describe(x: bool) -> str {
    if x {
        return "yes";
    }
    return "no";
}

fn is_int<T>(x: T) -> bool {
    return false;
}

fn is_int(x: i64) -> bool {
    return true;
}

fn pairs<T>(...xs: T) -> str {
    var out: str = "";
    for a in xs {
        for b in xs {
            if out != "" {
                out = out + " ";
            }
            out = out + describe(a) + "/" + describe(b);
        }
    }
    return out;
}

fn first<T>(...xs: T) -> str {
    var out: str = "";
    for x in xs {
        out = describe(x);
        break;
    }
    return out;
}

fn count_ints<T>(...xs: T) -> i64 {
    var n: i64 = 0;
    for x in xs {
        if !is_int(x) {
            continue;
        }
        n = n + 1;
    }
    return n;
}

fn main() -> i64 {
    println("pairs: " + pairs(1, true));
    println("first: " + first("a", 2));
    println("count: " + int_to_str(count_ints(1, "b", false, 7)));
    return 0;
}
