// BM4 (competitive roadmap): hash, FNV-1a 64 over 1000 bytes, two rounds.
// bench/work/fides/hash.fd on a small input (hash(1000, 2)), so the suite checks
// the benchmark's code on every backend; the expected value is the
// reference algorithm's, computed in Python with the same operations.
//
// Expected output:
// 1876578274799888325
@wrapping
fn fnv(data: Vec<u8>, rounds: i64) -> i64 {
    var h: i64 = -3750763034362895579;
    val n: i64 = data.len();
    var r: i64 = 0;
    while r < rounds {
        var i: i64 = 0;
        while i < n {
            h = (h ^ (data.get(i) as i64)) * 1099511628211;
            i = i + 1;
        }
        r = r + 1;
    }
    return h;
}

fn hash(n: i64, rounds: i64) -> i64 {
    var data: Vec<u8> = Vec::filled(n, 0);
    var i: i64 = 0;
    while i < n {
        data.set(i, ((i * 7 + i / 256) % 256) as u8);
        i = i + 1;
    }
    return fnv(data, rounds);
}

fn main() -> i64 {
    println(hash(1000, 2));
    return 0;
}
