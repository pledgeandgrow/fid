// stdlib/x509 on a chain made with OpenSSL 3.5 (openssl verify accepts it):
// an Ed25519 root, a P-256 intermediate it signs with Ed25519 (pathlen 1),
// an RSA-1024 intermediate signed with ecdsa-with-SHA256 (pathlen 0), and
// an Ed25519 leaf signed with sha256WithRSAEncryption carrying DNS, IP and
// e-mail SANs. Fields are printed; every signature is checked; the chain
// passes at a time inside every validity period and fails for an expired
// leaf, a missing link, a tampered TBS, a leaf in place of its issuer, and with
// no anchor; host names are matched against the SANs.
// Expected output:
// root v3 serial 01 Ed25519 subject C=FR, O=Fides Test, CN=Fides Test Root
// root self-issued true ca true pathlen -1 ku 96 valid 1767225600 2082758400
// int1 EC P-256 issuer CN Fides Test Root ca true pathlen 1 sig Ed25519
// int2 RSA ca true pathlen 0 sig ecdsa-with-SHA256
// leaf serial 0123456789abcdef01 CN example.test sig sha256WithRSAEncryption
// leaf ca false ku 1 valid 1780272000 1811808000
// leaf dns example.test www.example.test ip 127.0.0.1 email ops@example.test
// leaf aki = int2 ski true
// signatures root true int1 true int2 true leaf true wrong issuer false
// chain ok true at 3
// chain with root ok true
// expired false outside its validity period at 0
// missing link false issuer name does not match at 0
// tampered false bad signature at 0
// leaf as issuer false issuer name does not match at 0
// no anchor false no trust anchor at 2
// host www.example.test true EXAMPLE.TEST true 127.0.0.1 true other.test false
// nc root ecdsa-with-SHA384 1.3.132.0.34 self-signed true
// nc int ecdsa-with-SHA384 signed true constraints true critical understood true
// nc permitted dns:example.test email:example.test ip:0a000000ff000000 dn:310b300906035504061302465231133011060355040a0c0a46696465732054657374
// nc excluded dns:bad.example.test
// pss leaf RSASSA-PSS true pss384 leaf RSASSA-PSS true rsa-sha384 leaf sha384WithRSAEncryption true tampered false
// chain ok true at 2
// chain pss384 true s384 true
// chain excl false name excluded: dns:host.bad.example.test at 0
// chain wild false name excluded: dns:*.example.test at 0
// chain dns false name not permitted: dns:www.other.test at 0
// chain ip false name not permitted: ip:c0a80101 at 0
// chain mail false name not permitted: email:root@other.test at 0
// chain dn false name not permitted: dn:310b3009060355040613024445310e300c060355040a0c054f746865723117301506035504030c0e782e6578616d706c652e74657374 at 0
// crl v2 sha256WithRSAEncryption issuer C=FR, O=Fides Test, CN=Fides NC Intermediate
// crl this 1798761600 next 1830297600 number 05 aki is int ski true
// crl revoked 12 1782864000 reason 4, 18 1788220800 reason 1
// crl signed by int true by root false
// root crl ecdsa-with-SHA384 revoked 0 signed by root true
// pss crl RSASSA-PSS signed by int true
// crl check ok "" rev "certificate revoked"
// chain crl ok true
// chain crl revoked false certificate revoked at 0
// chain crl 2029 false CRL expired at 0
// chain crl 2026 false CRL not yet valid at 0
// chain crl none required false no CRL for the issuer at 0 not required true
// chain crl tampered false bad CRL signature at 0
use x509;
use pem;
use vec;
use encoding;

fn main() {
    val root: X509Cert = x509_parse_pem("-----BEGIN CERTIFICATE-----
MIIBaTCCARugAwIBAgIBATAFBgMrZXAwPDELMAkGA1UEBhMCRlIxEzARBgNVBAoM
CkZpZGVzIFRlc3QxGDAWBgNVBAMMD0ZpZGVzIFRlc3QgUm9vdDAeFw0yNjAxMDEw
MDAwMDBaFw0zNjAxMDEwMDAwMDBaMDwxCzAJBgNVBAYTAkZSMRMwEQYDVQQKDApG
aWRlcyBUZXN0MRgwFgYDVQQDDA9GaWRlcyBUZXN0IFJvb3QwKjAFBgMrZXADIQDf
fuS4wrj3PraXVpYX/mPDnHGelrBrxNkpyVafLSJOnaNCMEAwDwYDVR0TAQH/BAUw
AwEB/zAOBgNVHQ8BAf8EBAMCAQYwHQYDVR0OBBYEFBSShCx3RYFTF+E9cC0AW1Bk
v9WUMAUGAytlcANBAHqFSQ5VCKPNpEqZyM/jDBVZVtL5cat177QxnA4Hy08ilYSd
oIcOmW6EAnI9Bzjf3SOODTreQLO8pqsAqQAsOAY=
-----END CERTIFICATE-----");
    val int1: X509Cert = x509_parse_pem("-----BEGIN CERTIFICATE-----
MIIBwjCCAXSgAwIBAgIBAjAFBgMrZXAwPDELMAkGA1UEBhMCRlIxEzARBgNVBAoM
CkZpZGVzIFRlc3QxGDAWBgNVBAMMD0ZpZGVzIFRlc3QgUm9vdDAeFw0yNjAxMDEw
MDAwMDBaFw0zMTAxMDEwMDAwMDBaMEIxCzAJBgNVBAYTAkZSMRMwEQYDVQQKDApG
aWRlcyBUZXN0MR4wHAYDVQQDDBVGaWRlcyBFQyBJbnRlcm1lZGlhdGUwWTATBgcq
hkjOPQIBBggqhkjOPQMBBwNCAASGYn3VpErN/cJiRSPEVikKMlBeoqrhKQMThsev
/2DrbpXfGjRqKVax1WQvo3FQoGHRKrLhqAfllZiuMdW1FGbco2YwZDASBgNVHRMB
Af8ECDAGAQH/AgEBMA4GA1UdDwEB/wQEAwIBBjAdBgNVHQ4EFgQUxeKG01eFTdt9
lKvIWFA36G2ARZcwHwYDVR0jBBgwFoAUFJKELHdFgVMX4T1wLQBbUGS/1ZQwBQYD
K2VwA0EAM7XqzTGZRlw51GieH8e0VErbNYmDz/HO6+9rt957icIf7VRY7aNK5KZC
PNf/N/+IlwGp3cmmfOp8uLHnGCTQCQ==
-----END CERTIFICATE-----");
    val int2: X509Cert = x509_parse_pem("-----BEGIN CERTIFICATE-----
MIICITCCAcegAwIBAgIBAzAKBggqhkjOPQQDAjBCMQswCQYDVQQGEwJGUjETMBEG
A1UECgwKRmlkZXMgVGVzdDEeMBwGA1UEAwwVRmlkZXMgRUMgSW50ZXJtZWRpYXRl
MB4XDTI2MDEwMTAwMDAwMFoXDTMwMDEwMTAwMDAwMFowQzELMAkGA1UEBhMCRlIx
EzARBgNVBAoMCkZpZGVzIFRlc3QxHzAdBgNVBAMMFkZpZGVzIFJTQSBJbnRlcm1l
ZGlhdGUwgZ8wDQYJKoZIhvcNAQEBBQADgY0AMIGJAoGBAKWfanWgdAI+CSctW3d9
MBb0XxZ3PGj1+BKXmL+u1hUC+M1kik8m3LbRqHxEYEjfZbf12U/lG5WXSbegfMdD
wbNEWQmpx/mMoBSdB+DudEaw83vvtJbDl4UDAD6zSKYpsjW4QhpZcoAK1mSOFLCB
f3CpoUpXhSGf6pjKLfmm+rdRAgMBAAGjZjBkMBIGA1UdEwEB/wQIMAYBAf8CAQAw
DgYDVR0PAQH/BAQDAgEGMB0GA1UdDgQWBBT75a2X0ACn+QauIgJPBBvWgtrfeTAf
BgNVHSMEGDAWgBTF4obTV4VN232Uq8hYUDfobYBFlzAKBggqhkjOPQQDAgNIADBF
AiEAuHGljoBIsysrt09hzAvnR9vk8nOsHS8NHdcE8J9sSkECIEiGmca/1fd+gPoD
Fpkl1HFY9934NtY3ec9A1DQMmEn2
-----END CERTIFICATE-----");
    val leaf: X509Cert = x509_parse_pem("-----BEGIN CERTIFICATE-----
MIICKTCCAZKgAwIBAgIJASNFZ4mrze8BMA0GCSqGSIb3DQEBCwUAMEMxCzAJBgNV
BAYTAkZSMRMwEQYDVQQKDApGaWRlcyBUZXN0MR8wHQYDVQQDDBZGaWRlcyBSU0Eg
SW50ZXJtZWRpYXRlMB4XDTI2MDYwMTAwMDAwMFoXDTI3MDYwMTAwMDAwMFowOTEL
MAkGA1UEBhMCRlIxEzARBgNVBAoMCkZpZGVzIFRlc3QxFTATBgNVBAMMDGV4YW1w
bGUudGVzdDAqMAUGAytlcAMhAOShyF5uGrGJDXgvhel6ABiDCSKAfUBJh+I66Jsp
qlxho4GkMIGhMAwGA1UdEwEB/wQCMAAwDgYDVR0PAQH/BAQDAgeAMEEGA1UdEQQ6
MDiCDGV4YW1wbGUudGVzdIIQd3d3LmV4YW1wbGUudGVzdIcEfwAAAYEQb3BzQGV4
YW1wbGUudGVzdDAdBgNVHQ4EFgQUsnu3Jou7LyEwuFqKEh+2+HQ8vowwHwYDVR0j
BBgwFoAU++Wtl9AAp/kGriICTwQb1oLa33kwDQYJKoZIhvcNAQELBQADgYEAKeNt
QynF7UNweMba6DNgGPuEmp8kW6JQCs5MjQ6JQmH6VQCpTfLyGSOOtBVHBMx+wmZ5
ZSFB+MCx0Lhm7lMmI9+6kZIs3nrtRVD1JSd1mPOfeeugPufPcGfV5rAm5VKLyNXv
y0M7VXcAYN+zwuoi3ZwI9qyw6Zvwxq7x1bXispk=
-----END CERTIFICATE-----");
    println("root v" + int_to_str(root.version) + " serial " + x509_serial_hex(root) + " " + pem_oid_name(root.spki.alg) + " subject " + root.subject);
    println("root self-issued " + bool_to_str(x509_self_issued(root)) + " ca " + bool_to_str(root.is_ca) + " pathlen " + int_to_str(root.path_len) + " ku " + int_to_str(root.key_usage) + " valid " + int_to_str(root.not_before) + " " + int_to_str(root.not_after));
    println("int1 " + pem_oid_name(int1.spki.alg) + " " + pem_oid_name(int1.spki.params) + " issuer CN " + root.common_name + " ca " + bool_to_str(int1.is_ca) + " pathlen " + int_to_str(int1.path_len) + " sig " + x509_sig_alg_name(int1.sig_alg));
    println("int2 " + pem_oid_name(int2.spki.alg) + " ca " + bool_to_str(int2.is_ca) + " pathlen " + int_to_str(int2.path_len) + " sig " + x509_sig_alg_name(int2.sig_alg));
    println("leaf serial " + x509_serial_hex(leaf) + " CN " + leaf.common_name + " sig " + x509_sig_alg_name(leaf.sig_alg));
    println("leaf ca " + bool_to_str(leaf.is_ca) + " ku " + int_to_str(leaf.key_usage) + " valid " + int_to_str(leaf.not_before) + " " + int_to_str(leaf.not_after));
    println("leaf dns " + leaf.san_dns.get(0) + " " + leaf.san_dns.get(1) + " ip " + leaf.san_ip.get(0) + " email " + leaf.san_email.get(0));
    println("leaf aki = int2 ski " + bool_to_str(str_equal(hex_encode_bytes(leaf.aki), hex_encode_bytes(int2.ski)) && leaf.aki.len() == 20));
    println("signatures root " + bool_to_str(x509_verify_signed_by(root, root)) + " int1 " + bool_to_str(x509_verify_signed_by(int1, root)) + " int2 " + bool_to_str(x509_verify_signed_by(int2, int1)) + " leaf " + bool_to_str(x509_verify_signed_by(leaf, int2)) + " wrong issuer " + bool_to_str(x509_verify_signed_by(leaf, int1)));

    val now: i64 = 1800000000;
    var chain: Vec<X509Cert> = Vec::new();
    chain.push(leaf); chain.push(int2); chain.push(int1);
    var anchors: Vec<X509Cert> = Vec::new();
    anchors.push(root);
    val r1: X509ChainResult = x509_verify_chain(chain, anchors, now);
    println("chain ok " + bool_to_str(r1.ok) + " at " + int_to_str(r1.at));
    var chain2: Vec<X509Cert> = chain;
    chain2.push(root);
    val r2: X509ChainResult = x509_verify_chain(chain2, anchors, now);
    println("chain with root ok " + bool_to_str(r2.ok));
    val r3: X509ChainResult = x509_verify_chain(chain, anchors, 1850000000);
    println("expired " + bool_to_str(r3.ok) + " " + r3.err + " at " + int_to_str(r3.at));
    var gap: Vec<X509Cert> = Vec::new();
    gap.push(leaf); gap.push(int1);
    val r4: X509ChainResult = x509_verify_chain(gap, anchors, now);
    println("missing link " + bool_to_str(r4.ok) + " " + r4.err + " at " + int_to_str(r4.at));
    var der: Vec<i64> = leaf.raw;
    // Flip a byte inside the subject's common name (TBS offset ~ 150).
    der.set(160, der.get(160) ^ 1);
    var forged: Vec<X509Cert> = Vec::new();
    forged.push(x509_parse(der)); forged.push(int2); forged.push(int1);
    val r5: X509ChainResult = x509_verify_chain(forged, anchors, now);
    println("tampered " + bool_to_str(r5.ok) + " " + r5.err + " at " + int_to_str(r5.at));
    var bad_ca: Vec<X509Cert> = Vec::new();
    bad_ca.push(leaf); bad_ca.push(leaf);
    val r6: X509ChainResult = x509_verify_chain(bad_ca, anchors, now);
    println("leaf as issuer " + bool_to_str(r6.ok) + " " + r6.err + " at " + int_to_str(r6.at));
    val r7: X509ChainResult = x509_verify_chain(chain, Vec::new(), now);
    println("no anchor " + bool_to_str(r7.ok) + " " + r7.err + " at " + int_to_str(r7.at));
    println("host www.example.test " + bool_to_str(x509_matches_host(leaf, "www.example.test")) + " EXAMPLE.TEST " + bool_to_str(x509_matches_host(leaf, "EXAMPLE.TEST")) + " 127.0.0.1 " + bool_to_str(x509_matches_host(leaf, "127.0.0.1")) + " other.test " + bool_to_str(x509_matches_host(leaf, "other.test")));
    nc_crl_tests();
}

fn show(name: str, r: X509ChainResult) {
    if r.ok {
        println("chain " + name + " true at " + int_to_str(r.at));
    } else {
        println("chain " + name + " false " + r.err + " at " + int_to_str(r.at));
    }
}

