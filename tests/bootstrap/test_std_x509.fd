MhUkivlrVInViw35IPNYoaSVF34kIvzu9o9gVDT4KmxhXW1TZyc4Oon0xN2+opDg
EluINYxXezaXxLNs9g==
-----END CERTIFICATE-----");
    println("crl check ok \"" + x509_crl_check(ok, int1, crl, now) + "\" rev \"" + x509_crl_check(rev, int1, crl, now) + "\"");
    var crls: Vec<X509Crl> = Vec::new();
    crls.push(rcrl); crls.push(crl);
    val q1: X509ChainResult = x509_verify_chain_crl(chain, anchors, now, crls, true);
    println("chain crl ok " + bool_to_str(q1.ok));
    var rc: Vec<X509Cert> = Vec::new();
    rc.push(rev); rc.push(int1);
    show("crl revoked", x509_verify_chain_crl(rc, anchors, now, crls, true));
    show("crl 2029", x509_verify_chain_crl(chain, anchors, 1861920000, crls, true));
    show("crl 2026", x509_verify_chain_crl(chain, anchors, 1782864000, crls, true));
    val q5: X509ChainResult = x509_verify_chain_crl(chain, anchors, now, Vec::new(), true);
    println("chain crl none required " + bool_to_str(q5.ok) + " " + q5.err + " at " + int_to_str(q5.at) + " not required " + bool_to_str(x509_verify_chain_crl(chain, anchors, now, Vec::new(), false).ok));
    var tcrl: X509Crl = crl;
    tcrl.sig.set(20, tcrl.sig.get(20) ^ 1);
    var crls2: Vec<X509Crl> = Vec::new();
    crls2.push(rcrl); crls2.push(tcrl);
    show("crl tampered", x509_verify_chain_crl(chain, anchors, now, crls2, true));
}
