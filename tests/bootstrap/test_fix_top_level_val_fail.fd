// expect-error: `val` cannot declare a top-level item
// Test (stdlib-agent bug 9): a module-level item is `const` or `var`
// (reference §2.6, §2.7); `val` exists only inside a function. A top-level
// `val NAME: str = ...` said "expected fn but got 'val'"; the error now
// says what to write instead (`const NAME: str = ...;`).
val NAME: str = "abc";

fn main() {
    println(NAME);
}
