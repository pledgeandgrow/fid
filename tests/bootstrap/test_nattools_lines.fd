// llvm-roadmap DB1: line tables for every instruction and for the other
// files of a program. The lowering gives what it emits outside any
// statement (parameter copies, the drops and return at a function's end)
// the body's first line, and on the native Linux targets functions of the
// imported file nattools/lines_mod.fd get rows against that file
// (nat_enc.fd's file table, DW_LNS_set_file). The output is the same on
// every backend; the native check is
//   fid emit tests/bootstrap/test_nattools_lines.fd --target x86_64-linux -o l
//   readelf --debug-dump=decodedline l   (two files: this one, lines_mod.fd)
// (scripts/nat-tools-check.sh does it).
// Expected output:
// 21
// 8
// 29

use nattools::lines_mod;

fn local_add(a: i64, b: i64) -> i64 {
    val s: i64 = a + b;
    return s;
}

fn main() {
    val t: i64 = lm_triple(7);
    print(t);
    print("\n");
    val b: LmBox = LmBox { v: 7 };
    print(b.bump());
    print("\n");
    print(local_add(t, 8));
    print("\n");
}
