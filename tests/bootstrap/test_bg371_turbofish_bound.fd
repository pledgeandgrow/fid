// Bugs roadmap BG371: a turbofish call of a generic function with a trait
// bound was always rejected ("Unknown annotation '@__trait_bound'"), even
// when the type implements the trait (reference §7.2: `f::<T>(args)`).
//
// Expected output:
// pt
// pt
cap Show {
    fn show(self) -> str;
}
struct Pt {
    x: i64,
}
impl Show for Pt {
    fn show(self: Pt) -> str {
        return "pt";
    }
}
fn pr<T: Show>(v: T) -> str {
    return v.show();
}
fn main() {
    val p = Pt { x: 1 };
    println(pr::<Pt>(p));
    println(pr(p));
}
