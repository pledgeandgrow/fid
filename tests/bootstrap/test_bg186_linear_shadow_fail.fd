// expect-error: is declared again before it was consumed
// Bugs roadmap BG186: a second `val t` hid the first, unconsumed one,
// which was lost silently.
@linear
struct Tok {
    v: i64,
}

fn use_tok(t: Tok) -> i64 {
    return t.v;
}

fn main() -> i64 {
    val t = Tok { v: 1 };
    val t = Tok { v: 2 };
    println(use_tok(t));
    return 0;
}
