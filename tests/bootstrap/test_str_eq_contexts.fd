// Test: `==` / `!=` on str compare contents in every type context (R1.1)

struct Named { name: str, n: i64 }
enum Tok { Ident(str), Num(i64) }

// Build strings at runtime so equal contents live at different addresses.
fn mk(s: str) -> str { return s + ""; }
fn get_name(x: Named) -> str { return x.name; }

fn main() {
    val a = mk("abc");
    val b = mk("abc");
    assert_msg(a == b, "locals");
    assert_msg(!(a != b), "locals !=");
    assert_msg(a != "abd", "local != literal");

    val n1 = Named { name: mk("foo"), n: 1 };
    val n2 = Named { name: mk("foo"), n: 2 };
    assert_msg(n1.name == "foo", "field == literal");
    assert_msg(n1.name == n2.name, "field == field");
    assert_msg(get_name(n1) == "foo", "call result");

    val t = Tok::Ident(mk("let"));
    var matched: bool = false;
    match t {
        Tok::Ident(s) => { matched = s == "let"; }
        Tok::Num(_) => { matched = false; }
    }
    assert_msg(matched, "enum payload");

    var v: Vec<str> = Vec::new();
    v.push(mk("x1"));
    assert_msg(v.get(0) == "x1", "Vec<str>.get() == literal");
    assert_msg(v.get(0) != a, "Vec<str>.get() != local");
    assert_msg(v.get(0) != n1.name, "Vec<str>.get() != field");
    print("str eq contexts OK\n");
}
