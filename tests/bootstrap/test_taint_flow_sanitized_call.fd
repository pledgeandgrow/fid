// Roadmap Phase 12 (rm-P12): the same query path as
// test_taint_flow_callee_fail.fd, but the input goes through sql_escape
// (a builtin-named sanitizer, here written in the program) first, so the
// sink receives a clean value and the program is accepted.
// Expected output:
//   43

fn sql_escape(s: str) -> str {
    return str_replace(s, "'", "''");
}

@sink
fn run_query(q: str) -> i64 {
    return str_len(q);
}

fn lookup(key: str) -> i64 {
    val q: str = "SELECT * FROM users WHERE id = '" + key + "'";
    return run_query(q);
}

fn serve(@tainted id: str) -> i64 {
    val safe: str = sql_escape(id);
    return lookup(safe);
}

fn main() {
    println(int_to_str(serve("O'Brien x")));
}
