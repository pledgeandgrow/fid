// expect-error: in the f-string expression `{"\q"}`: unknown escape sequence \q
// Expected to FAIL (BG210, docs/roadmap/bugs-roadmap.md): a string inside
// an f-string's braces takes the escapes of any string, so `\q` is an
// error there as in a plain string; it was accepted.
fn main() -> i64 {
    println(f"{"\q"}");
    return 0;
}
