// `comptime function_effects(f)` (language guide section 3.5) is the list
// of the effects `f` declares, as string literals. Under the stage-0
// compiler of Nov 17 it printed bad bytes and `ptr(0x12f0)`, and the
// array was empty at run time (test_comptime_reflection2.fd panicked the
// same way): the reflection was not substituted.
// Expected output:
// IO
// IO
// Net
// IO+Net
fn talk() -> i64 !IO {
    println("hi");
    return 1;
}

fn net() -> i64 !{IO, Net} {
    return 3;
}

fn main() -> i64 {
    val a = comptime function_effects(talk);
    println(a[0]);
    val c = comptime function_effects(net);
    println(c[0]);
    println(c[1]);
    println(c[0] + "+" + c[1]);
    return 0;
}
