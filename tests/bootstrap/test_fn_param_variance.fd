// Bugs roadmap BG17: function parameters are contravariant. A function
// that only reads through `&Counter` may stand for a `fn(&mut Counter)` (a
// `&mut` reborrows as `&`), and one of the exact type is accepted as
// before. The reverse, a `fn(&mut T)` where a `fn(&T)` is wanted, is
// refused (test_fn_param_variance_fail.fd).
// Expected output:
// 1
// 2
// 2
struct Counter {
    n: i64,
}

fn peek(c: &Counter) -> i64 {
    return c.n;
}

fn bump(c: &mut Counter) -> i64 {
    c.n = c.n + 1;
    return c.n;
}

fn with_mut(c: &mut Counter, f: fn(&mut Counter) -> i64) -> i64 {
    return f(c);
}

fn main() -> i64 {
    var c: Counter = Counter { n: 1 };
    println(int_to_str(with_mut(&mut c, peek)));
    println(int_to_str(with_mut(&mut c, bump)));
    println(int_to_str(c.n));
    return 0;
}
