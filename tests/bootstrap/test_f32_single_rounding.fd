// BG66 (docs/roadmap/bugs-roadmap.md): an f32 holds a single-precision
// value. The interpreter kept f32 arithmetic, constants and conversions in
// full f64 precision (16777216 + 1 stayed 16777217, 0.1 stayed 0.1);
// compiled code rounds each one to the nearest single. Every backend prints
// the same.
//
// Expected output:
// 16777216
// 16777216
// 16777220
// rounded
// rounded
// 1.5
fn add1(x: f32) -> f32 {
    return x + (1.0 as f32);
}

fn main() -> i64 {
    // arithmetic: 2^24 + 1 is no single
    val a: f32 = 16777216.0 as f32;
    println(int_to_str(add1(a) as i64));
    // an integer converted to f32
    val n: i64 = 16777217;
    val nf: f32 = n as f32;
    println(int_to_str(nf as i64));
    val n3: i64 = 16777219;
    println(int_to_str((n3 as f32) as i64));
    // an f64 converted to f32
    val c: f32 = 0.1 as f32;
    if (c as f64) != 0.1 {
        println("rounded");
    }
    // a quotient
    val third: f32 = (1.0 as f32) / (3.0 as f32);
    if (third as f64) != 1.0 / 3.0 {
        println("rounded");
    }
    // exact values stay exact
    val h: f32 = (3.0 as f32) / (2.0 as f32);
    println(float_to_str(h as f64));
    return 0;
}
