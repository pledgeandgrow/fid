// expect-error: Partition error: the global 'ALT' is shared by partition 'flight_control' (in 'control_loop') and partition 'navigation' ('main' hands it by reference to 'nav_update')
// Roadmap Phase 9 (F47): flight control reads the global ALT, and the
// scheduler hands the same global to navigation by reference: both
// partitions reach its memory.

var ALT: i64 = 0;

@partitioned(navigation)
fn nav_update(alt: & mut i64, v: i64) {
    *alt = v;
}

@partitioned(flight_control)
fn control_loop() -> i64 {
    return ALT / 10;
}

fn main() {
    nav_update(& mut ALT, 1200);
    println(int_to_str(control_loop()));
}
