// stdlib/path: join, split, dirname/basename, extensions, normalize,
// predicates, components, parent and depth. Pure string operations.
use path;

fn check_s(label: str, got: str, want: str) {
    println(label + " = " + got);
    if !str_equal(got, want) {
        p_panic("path: " + label + " gave '" + got + "', want '" + want + "'");
    }
}

fn check_i(label: str, got: i64, want: i64) {
    println(label + " = " + int_to_str(got));
    if got != want {
        p_panic("path: " + label + " wrong");
    }
}

fn check_b(label: str, got: bool, want: bool) {
    println(label + " = " + bool_to_str(got));
    if got != want {
        p_panic("path: " + label + " wrong");
    }
}

fn main() -> i64 {
    check_s("sep", path_sep(), "/");
    check_s("join1", path_join("foo", "bar"), "foo/bar");
    check_s("join2", path_join("foo/", "bar"), "foo/bar");
    check_s("join3", path_join("foo", "/bar"), "foo/bar");
    check_s("join4", path_join("foo/", "/bar"), "foo/bar");
    check_s("join5", path_join("", "bar"), "bar");
    check_s("join6", path_join("foo", ""), "foo");

    var parts = Vec::new();
    parts.push("a");
    parts.push("b/");
    parts.push("c.txt");
    check_s("join_many", path_join_many(parts), "a/b/c.txt");
    var none: Vec<str> = Vec::new();
    check_s("join_many0", path_join_many(none), "");

    var sp = path_split("/a/b/c.txt");
    check_i("split.len", sp.len(), 2);
    check_s("split0", sp.get(0), "/a/b");
    check_s("split1", sp.get(1), "c.txt");
    var sp2 = path_split("c.txt");
    check_s("split2.0", sp2.get(0), "");
    check_s("split2.1", sp2.get(1), "c.txt");
    var sp3 = path_split("/root");
    check_s("split3.0", sp3.get(0), "/");
    check_s("split3.1", sp3.get(1), "root");

    check_s("dirname1", path_dirname("/a/b/c.txt"), "/a/b");
    check_s("dirname2", path_dirname("c.txt"), "");
    check_s("dirname3", path_dirname("/c.txt"), "/");
    check_s("basename1", path_basename("/a/b/c.txt"), "c.txt");
    check_s("basename2", path_basename("c.txt"), "c.txt");

    check_s("ext1", path_extension("file.txt"), ".txt");
    check_s("ext2", path_extension("file"), "");
    check_s("ext3", path_extension("file.tar.gz"), ".gz");
    check_s("ext4", path_extension(".bashrc"), "");
    check_s("ext5", path_extension("/a.dir/file"), "");
    check_s("stem1", path_stem("file.txt"), "file");
    check_s("stem2", path_stem("/x/file.tar.gz"), "file.tar");
    check_s("stem3", path_stem(".bashrc"), ".bashrc");
    check_s("setext1", path_set_extension("file.txt", ".md"), "file.md");
    check_s("setext2", path_set_extension("file", ".txt"), "file.txt");
    check_s("setext3", path_set_extension("/a/b/file.c", ".h"), "/a/b/file.h");

    check_s("norm1", path_normalize("a/./b/../c"), "a/c");
    check_s("norm2", path_normalize("/a/b/../c"), "/a/c");
    check_s("norm3", path_normalize(""), ".");
    check_s("norm4", path_normalize("../x/../.."), "../..");
    check_s("norm5", path_normalize("/../a"), "/a");
    check_s("norm6", path_normalize("a/.."), ".");
    check_s("norm7", path_normalize("/"), "/");
    check_s("norm8", path_normalize("a//b/"), "a/b");

    check_b("abs1", path_is_absolute("/usr"), true);
    check_b("abs2", path_is_absolute("usr"), false);
    check_b("abs3", path_is_absolute(""), false);
    check_b("rel1", path_is_relative("usr/bin"), true);
    check_b("hasext1", path_has_extension("a/b.rs", ".rs"), true);
    check_b("hasext2", path_has_extension("a/b.rs", ".fd"), false);

    var comps = path_components("/a/b/c");
    check_i("comps.len", comps.len(), 4);
    check_i("comps0.len", str_len(comps.get(0)), 0);
    check_s("comps3", comps.get(3), "c");

    check_s("parent1", path_parent("/a/b/c"), "/a/b");
    check_s("parent2", path_parent("/a/b/"), "/a");
    check_s("parent3", path_parent("/a"), "/");

    check_i("depth1", path_depth("/a/b/c"), 3);
    check_i("depth2", path_depth("a/./b/../c"), 2);
    check_i("depth3", path_depth("/"), 0);
    check_i("depth4", path_depth("."), 0);
    println("path ok");
    return 0;
}
