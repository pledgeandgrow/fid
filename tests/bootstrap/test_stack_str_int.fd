// LF13 (compiler/lower.fd lw_rc_stack_strs_fn, stdlib/core.fd
// Int_to_str_into, Nov 21): a local `int_to_str` (p_to_str) that only
// lives in its function is built in a 128-byte stack area, as `a + b`
// strings are (Str_concat_into): [P_STR_STATIC][len] digits NUL, the heap
// p_to_str only when the area cannot be used. The results are the same on
// every backend, `run --checked-alloc` finds no heap allocation for them,
// and INT64_MIN renders (the value stays negative while the digits are
// written from the end).
//
// Expected output:
// n=42
// -7
// 0
// 9223372036854775807
// -9223372036854775808
// 9
// 123456789!
// 3

fn main() {
    var a: i64 = 42;
    var s: str = "n=" + int_to_str(a);
    println(s);
    var t: str = int_to_str(0 - 7);
    println(t);
    var z: str = int_to_str(0);
    println(z);
    var big: str = int_to_str(9223372036854775807);
    println(big);
    var small: str = int_to_str(0 - 9223372036854775807 - 1);
    println(small);
    var u: str = int_to_str(123456789);
    println(str_len(u));
    println(u + "!");
    var neg: str = int_to_str(0 - 451);
    var cut: str = neg + "|";
    println(str_len(cut));
}
