// expect-error: no method 'twice' on Wrap<bool>: 'twice' is a method of `impl Wrap<i64>` only
// L8H: a method of a narrower impl (`impl Wrap<i64> { fn twice }`) exists
// for receivers of that type only. Before, the receiver's type was not
// compared with the impl's, and a Wrap<bool> took it too.

struct Wrap<T> {
    v: T,
}

impl<T> Wrap<T> {
    fn get(self) -> T {
        return self.v;
    }
}

impl Wrap<i64> {
    fn twice(self) -> i64 {
        return self.v * 2;
    }
}

fn main() -> i64 {
    val a: Wrap<i64> = Wrap { v: 4 };
    println(int_to_str(a.twice()));
    val b: Wrap<bool> = Wrap { v: true };
    println(int_to_str(b.twice()));
    return 0;
}
