// Bugs roadmap BG299: on --nat an f64 literal passed to `Vec<f32>.contains`
// or `Vec::filled` was not narrowed: `contains(1.5)` was false for an
// element that is there and `Vec::filled(3, 1.5)` was all zeros.
//
// Expected output:
// true true false
// 1.5 1.5 3
// 4.5
fn main() {
    var g: Vec<f32> = Vec::new();
    g.push(1.5);
    val k: f32 = 1.5;
    println(f"{g.contains(1.5)} {g.contains(k)} {g.contains(2.5)}");
    var f: Vec<f32> = Vec::filled(3, 1.5);
    println(f"{f.get(0)} {f.get(2)} {f.len()}");
    val s: f32 = f.get(0) + f.get(1) + f.get(2);
    println(f"{s}");
}
