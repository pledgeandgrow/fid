// expect-error: is @no-recursion but calls itself
// Bugs roadmap BG152: `val f = r; f(n - 1)` inside `r` is recursion; the
// call through the local was not seen as a call of `r`.
@no-recursion
fn r(n: i64) -> i64 {
    val f = r;
    if n == 0 {
        return 0;
    }
    return f(n - 1);
}

fn main() -> i64 {
    println(r(3));
    return 0;
}
