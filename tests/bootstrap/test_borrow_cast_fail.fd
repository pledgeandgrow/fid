// expect-error: cannot create &mut
// Test (known-bugs 2g.9): two &mut of x in one call are rejected also
// when the call is wrapped in a cast.
fn g(a: &mut i64, b: &mut i64) -> i32 {
    *a = 1;
    *b = 2;
    return 0;
}

fn main() -> i64 {
    var x: i64 = 0;
    val r = g(&mut x, &mut x) as i64;
    print(r);
    return 0;
}
