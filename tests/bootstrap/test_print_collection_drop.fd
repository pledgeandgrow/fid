// BG94 (docs/roadmap/bugs-roadmap.md): printing a Vec or a HashMap
// through C formatted it with core's Vec_to_str / HashMap_to_str and never
// freed that text (one leak per print). Now (compiler/codegen_c.fd, the
// `print`/`println` and Inst::Print cases) the text is dropped after it is
// printed. Run under `scripts/leak-check.sh <fid> <this file>` (fid run
// --leaks) for the leak part: every block is freed at exit.
//
// Expected output:
// [1, 2, 3]
// [1, 2, 3]
// {alice: 30, bob: 25}
// {alice: 30, bob: 25}
// done

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    println(v);
    print(v);
    print("\n");
    val m = HashMap::new();
    m.insert("alice", 30);
    m.insert("bob", 25);
    println(m);
    print(m);
    print("\n");
    println("done");
    return 0;
}
