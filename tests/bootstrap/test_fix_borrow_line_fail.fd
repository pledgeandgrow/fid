// expect-error: borrow error in main (line 11): cannot create &mut x
// Test (stdlib-agent bugs 42/53): a borrow error inside a call's arguments
// names the line of the call. `f(&mut x, g(&mut x))` takes &mut x twice in
// one statement; the error said "line 0".
fn g(a: &mut i64) -> i64 { *a = *a + 1; return *a; }

fn f(a: &mut i64, b: i64) -> i64 { return *a + b; }

fn main() {
    var x: i64 = 1;
    val y: i64 = f(&mut x, g(&mut x));
    println(int_to_str(y));
}
