// rekeyed 9db2e33cd0567aa6b7fcc687b6e2d3159b896d6fd349489eef04d8
// Noise_NNpsk0_25519_ChaChaPoly_SHA256
// msg0 ca35def5ae56cec33dc2036731ab14896bc4c75dbb07a61f879f8e3afa4c794445ad7fa3a9fe0c011d517201f0176690aa22e891c26f1aecec -> payload 0
// msg1 95ebc60d2b1fa672c1f46a8aa265ef51bfe38e7ccb39ec5be34069f144808843eb122c1adbb18050f6d1b650713e426bf4d37467f8972d01ce -> payload 1
// hash 9d77ee65a0e173a5d1bb96ff4eac153665ec6020b5392b5bdcd9074786a17709 same true
// t0 d0758d50474fc96473505fdcf92a7a33617623ce
// t1 57c8a2e8bd19b8174332245c80571f482f2113bf
// rekeyed 0733f51caf7a3e4ee54eceddf30331b4accf9e78927ddf890d67eb
// tampered message rejected true: static key decryption failed
// wrong responder key rejected true: static key decryption failed
// unsupported name: unsupported cipher or hash
// out of turn write: not this side's turn to write
use noise_proto;
use vec;
use encoding;

fn hb(s: str) -> Vec<i64> { return hex_decode_bytes(s); }

fn run(name: str) {
    val si: Vec<i64> = hb("e61ef9919cde45dd5f82166404bd08e38bceb5dfdfded0a34c8df7ed542214d1");
    val sr: Vec<i64> = hb("4a3acbfdb163dec651dfa3194dece676d437029c62a408b4c5ea9114246e4893");
    val prologue: Vec<i64> = str_bytes("John Galt");
    val psk: Vec<i64> = hb("54686973206973206d7920417573747269616e20706572737065637469766521");
    val pattern: str = str_split(name, "_").get(1);
    var rs_i: Vec<i64> = Vec::new();
    if str_starts_with(pattern, "NK") || str_starts_with(pattern, "IK") { rs_i = x25519_public_key(sr); }
    var i: NoiseHandshake = noise_handshake_new(name, true, prologue, si, rs_i, psk);
    var r: NoiseHandshake = noise_handshake_new(name, false, prologue, sr, Vec::new(), psk);
    noise_set_ephemeral(& mut i, hb("893e28b9dc6ca8d611ab664754b8ceb7bac5117349a4439a6b0569da977c464a"));
    noise_set_ephemeral(& mut r, hb("bbdb4cdbd309f1a1f2e1456967fe288cadd6f712d65dc7b7793d5e63da6b375b"));
    println(name);
    var k: i64 = 0;
    while !noise_handshake_done(& i) {
        val payload: Vec<i64> = str_bytes("payload " + int_to_str(k));
        var m: Vec<i64> = Vec::new();
        var p: NoiseBytes = NoiseBytes { ok: false, data: Vec::new() };
        if k % 2 == 0 {
            m = noise_write_message(& mut i, payload);
            p = noise_read_message(& mut r, m);
        } else {
            m = noise_write_message(& mut r, payload);
            p = noise_read_message(& mut i, m);
        }
        if !p.ok { println("failed: " + i.err + " / " + r.err); return; }
        println("msg" + int_to_str(k) + " " + hex_encode_bytes(m) + " -> " + str_from_bytes(p.data));
        k = k + 1;
    }
    val hi: Vec<i64> = noise_handshake_hash(& i);
    val hr: Vec<i64> = noise_handshake_hash(& r);
    println("hash " + hex_encode_bytes(hi) + " same " + bool_to_str(hex_encode_bytes(hi) == hex_encode_bytes(hr)));
    val ti: NoiseTransport = noise_split(& i);
    val tr: NoiseTransport = noise_split(& r);
    var isend: NoiseCipher = ti.send;
    var irecv: NoiseCipher = ti.recv;
    var rsend: NoiseCipher = tr.send;
    var rrecv: NoiseCipher = tr.recv;
    val t0: Vec<i64> = noise_encrypt(& mut isend, Vec::new(), str_bytes("ping"));
    println("t0 " + hex_encode_bytes(t0));
    val t1: Vec<i64> = noise_encrypt(& mut rsend, Vec::new(), str_bytes("pong"));
    println("t1 " + hex_encode_bytes(t1));
    val d0: NoiseBytes = noise_decrypt(& mut rrecv, Vec::new(), t0);
    val d1: NoiseBytes = noise_decrypt(& mut irecv, Vec::new(), t1);
    if !d0.ok || !d1.ok || str_from_bytes(d0.data) != "ping" || str_from_bytes(d1.data) != "pong" { println("transport failed"); }
    noise_rekey(& mut isend);
    noise_rekey(& mut rrecv);
    val t2: Vec<i64> = noise_encrypt(& mut isend, Vec::new(), str_bytes("after rekey"));
    println("rekeyed " + hex_encode_bytes(t2));
    val d2: NoiseBytes = noise_decrypt(& mut rrecv, Vec::new(), t2);
    if !d2.ok { println("rekey decrypt failed"); }
}

fn main() {
    println("blake2s abc " + hex_encode_bytes(noise_blake2s(Vec::new(), str_bytes("abc"), 32)));
    println("blake2s empty " + hex_encode_bytes(noise_blake2s(Vec::new(), Vec::new(), 32)));
    var data: Vec<i64> = Vec::new();
    var key: Vec<i64> = Vec::new();
    var j: i64 = 0;
    while j < 192 { data.push(j % 64); j = j + 1; }
    j = 0;
    while j < 32 { key.push(j); j = j + 1; }
    println("blake2s keyed " + hex_encode_bytes(noise_blake2s(key, data, 32)));
    var k32: Vec<i64> = Vec::new();
    j = 0;
    while j < 32 { k32.push(107); j = j + 1; }
    println("blake2s-128 keyed " + hex_encode_bytes(noise_blake2s(k32, str_bytes("mac1 input"), 16)));

    run("Noise_NN_25519_ChaChaPoly_SHA256");
    run("Noise_NK_25519_ChaChaPoly_SHA256");
    run("Noise_XX_25519_ChaChaPoly_SHA256");
    run("Noise_IK_25519_ChaChaPoly_SHA256");
    run("Noise_XX_25519_AESGCM_SHA512");
    run("Noise_IKpsk2_25519_ChaChaPoly_BLAKE2s");
    run("Noise_NNpsk0_25519_ChaChaPoly_SHA256");

    // a flipped byte in XX message 2
    val name: str = "Noise_XX_25519_ChaChaPoly_SHA256";
    val si: Vec<i64> = hb("e61ef9919cde45dd5f82166404bd08e38bceb5dfdfded0a34c8df7ed542214d1");
    val sr: Vec<i64> = hb("4a3acbfdb163dec651dfa3194dece676d437029c62a408b4c5ea9114246e4893");
    var a: NoiseHandshake = noise_handshake_new(name, true, Vec::new(), si, Vec::new(), Vec::new());
    var b: NoiseHandshake = noise_handshake_new(name, false, Vec::new(), sr, Vec::new(), Vec::new());
    val m0: Vec<i64> = noise_write_message(& mut a, Vec::new());
    val p0: NoiseBytes = noise_read_message(& mut b, m0);
    var m1: Vec<i64> = noise_write_message(& mut b, str_bytes("hello"));
    m1.set(40, m1.get(40) ^ 1);
    val p1: NoiseBytes = noise_read_message(& mut a, m1);
    println("tampered message rejected " + bool_to_str(p0.ok && !p1.ok) + ": " + a.err);
    // IK where the initiator holds the wrong responder key
    var c: NoiseHandshake = noise_handshake_new("Noise_IK_25519_ChaChaPoly_SHA256", true, Vec::new(), si, x25519_public_key(si), Vec::new());
    var d: NoiseHandshake = noise_handshake_new("Noise_IK_25519_ChaChaPoly_SHA256", false, Vec::new(), sr, Vec::new(), Vec::new());
    val p2: NoiseBytes = noise_read_message(& mut d, noise_write_message(& mut c, str_bytes("secret")));
    println("wrong responder key rejected " + bool_to_str(!p2.ok) + ": " + d.err);
    val bad: NoiseHandshake = noise_handshake_new("Noise_XX_25519_ChaChaPoly_BLAKE2b", true, Vec::new(), si, Vec::new(), Vec::new());
    println("unsupported name: " + bad.err);
    var e: NoiseHandshake = noise_handshake_new(name, false, Vec::new(), sr, Vec::new(), Vec::new());
    val w: Vec<i64> = noise_write_message(& mut e, Vec::new());
    println("out of turn write: " + e.err);
}
