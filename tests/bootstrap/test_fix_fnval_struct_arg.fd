// Test (stdlib-agent bugs 14, 29): a struct passed by value to a function
// called through a function value, with a struct, a str and an i64
// result. It crashed ("Invalid memory access"), read zeros, or gave a
// number for the string (the call's result was taken as an i64). Bug 14's
// C build exited 127: also run it through `fid ccompile`.
// Expected output:
// 21
// ann
// 7
// bo 2
struct S {
    v: i64,
    w: i64,
}

struct Q {
    names: Vec<str>,
    k: i64,
}

fn bump(s: S) -> S {
    return S { v: s.v + 1, w: s.w };
}

fn run(s: S, f: fn(S) -> S) -> i64 {
    val n: S = f(s);
    return n.v * 10 + n.w;
}

fn first(q: Q) -> str {
    return q.names.get(0);
}

fn kk(q: Q) -> i64 {
    return q.k + q.names.len();
}

fn last_and(q: Q, f: fn(Q) -> i64) -> str {
    return q.names.get(1) + " " + int_to_str(f(q) - q.k);
}

fn main() {
    println(run(S { v: 1, w: 1 }, bump));
    var ns: Vec<str> = Vec::new();
    ns.push("ann");
    ns.push("bo");
    val q: Q = Q { names: ns, k: 5 };
    val f: fn(Q) -> str = first;
    println(f(q));
    val g: fn(Q) -> i64 = kk;
    println(g(q));
    println(last_and(q, kk));
}
