// Bugs roadmap BG181: `==` compared raw words for Option and other generic
// enums, tuples, arrays and Vec fields (lower.fd Expr::Binary Eq/Neq: no
// `__eq_<Enum>` is made for a generic enum, tuples and arrays reached a
// plain BinOp, and the Vec check did not see a field's type), so each of
// these was false for equal values on run, C and emit; a struct with an
// Option field (which gets no `__eq_<S>`) too, and `@derive(PartialEq)` on
// a struct with a Vec field. Lowerer_eq_rewrite compares the parts.
//
// Expected output:
// true
// true
// false
// true
// true
// true
// true
// true
// false
// true
// true
// false
// true
// true
// false
// true
// false
// true

@derive(PartialEq)
struct V {
    v: Vec<i64>,
}

struct W {
    v: Vec<i64>,
}

struct O {
    m: Option<i64>,
}

struct OS {
    m: Option<str>,
    k: i64,
}

fn mk(s: str) -> Option<str> {
    return Option::Some(s + "");
}

fn main() -> i64 {
    var a: Vec<i64> = Vec::new();
    a.push(1);
    var b: Vec<i64> = Vec::new();
    b.push(1);
    println(Option::Some(3) == Option::Some(3));
    val oa: Option<i64> = Option::Some(3);
    val ob: Option<i64> = Option::Some(3);
    println(oa == ob);
    val on: Option<i64> = Option::None;
    println(oa == on);
    println(oa != on);
    val p = W { v: a };
    val q = W { v: b };
    println(p.v == q.v);
    val x = O { m: oa };
    val y = O { m: ob };
    println(x.m == y.m);
    println(x == y);
    val t1 = (1, "a" + "b");
    val t2 = (1, "ab");
    println(t1 == t2);
    val t3 = (2, "ab");
    println(t1 == t3);
    val ar1: [i64; 2] = [1, 2];
    val ar2: [i64; 2] = [1, 2];
    println(ar1 == ar2);
    println([1, 2] == [1, 2]);
    println([1, 2] == [1, 3]);
    var c: Vec<i64> = Vec::new();
    c.push(1);
    var d: Vec<i64> = Vec::new();
    d.push(1);
    println(V_equals(V { v: c }, V { v: d }));
    val s1 = OS { m: mk("q"), k: 1 };
    val s2 = OS { m: mk("q"), k: 1 };
    val s3 = OS { m: mk("r"), k: 1 };
    println(s1 == s2);
    println(s1 == s3);
    val r1: Result<i64, str> = Result::Ok(1);
    val r2: Result<i64, str> = Result::Ok(1);
    val r3: Result<i64, str> = Result::Err("x");
    println(r1 == r2);
    println(r1 == r3);
    println(r3 != r1);
    return 0;
}
