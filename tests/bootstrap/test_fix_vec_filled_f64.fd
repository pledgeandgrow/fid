// stdlib-agent-bugs 4/43: Vec::filled(n, x) with a non-zero f64 stored x
// converted to an integer (0.5 -> 0, 3.0 -> the bits 3, a denormal), in
// `fid run` and the C build alike: the element is now x's bits, as push
// and set store an f64.
// Expected output:
// 0.5 0.5 0.5
// -2.25 3
// 0 1.25
// sum 7.5
use vec;

fn main() {
    val v: Vec<f64> = Vec::filled(3, 0.5);
    println(float_to_str(v.get(0)) + " " + float_to_str(v.get(1)) + " " + float_to_str(v.get(2)));
    val w: Vec<f64> = Vec::filled(2, 0.0 - 2.25);
    val t: Vec<f64> = Vec::filled(4, 3.0);
    println(float_to_str(w.get(1)) + " " + float_to_str(t.get(3)));
    var z: Vec<f64> = Vec::filled(2, 0.0);
    z.set(1, 1.25);
    println(float_to_str(z.get(0)) + " " + float_to_str(z.get(1)));
    var u: Vec<f64> = Vec::filled(6, 1.25);
    var s: f64 = 0.0;
    var i: i64 = 0;
    while i < u.len() {
        s = s + u.get(i);
        i = i + 1;
    }
    println("sum " + float_to_str(s));
}
