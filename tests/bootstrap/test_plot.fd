// Test for plot.fd — Phase 15.3
use plot;
use vec;
use file;

fn main() -> i64 {
    // Line plot test
    val xs: Vec<f64> = Vec::new();
    val ys: Vec<f64> = Vec::new();
    xs.push(0.0); xs.push(1.0); xs.push(2.0); xs.push(3.0); xs.push(4.0);
    ys.push(1.0); ys.push(4.0); ys.push(9.0); ys.push(16.0); ys.push(25.0);

    var svg = plot_line(xs, ys, "Squares", "x", "y");
    plot_to_file(svg, "test_plot_line.svg");
    print("line plot written, len=");
    print(str_len(svg));

    // Bar chart test
    val vals: Vec<f64> = Vec::new();
    val labels: Vec<str> = Vec::new();
    vals.push(30.0); vals.push(50.0); vals.push(20.0); vals.push(80.0);
    labels.push("A"); labels.push("B"); labels.push("C"); labels.push("D");
    var bar_svg = plot_bar(vals, labels, "Bar Chart");
    plot_to_file(bar_svg, "test_plot_bar.svg");
    print("bar chart written, len=");
    print(str_len(bar_svg));

    // Scatter plot test
    val sxs: Vec<f64> = Vec::new();
    val sys: Vec<f64> = Vec::new();
    sxs.push(1.0); sxs.push(2.0); sxs.push(3.0); sxs.push(4.0); sxs.push(5.0);
    sys.push(2.0); sys.push(3.5); sys.push(2.8); sys.push(5.1); sys.push(4.4);
    var sc_svg = plot_scatter(sxs, sys, "Scatter");
    plot_to_file(sc_svg, "test_plot_scatter.svg");
    print("scatter plot written, len=");
    print(str_len(sc_svg));

    // HTML rendering test
    plot_render_html(svg, "Squares", "test_plot.html");
    var html = file_read("test_plot.html");
    print("html written, len=");
    print(str_len(html));

    return 0;
}
