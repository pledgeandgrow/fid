// expect-error: cannot create &mut v.[0]: shared borrow(s) already active on it or a related path
// Expected to FAIL (known-bugs 2g.73): `&v` borrows the whole Vec, so an
// element of it cannot be borrowed `&mut` in the same call.
fn first_plus(v: &Vec<i64>, a: &mut i64) {
    *a = *a + v.len();
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    first_plus(&v, &mut v[0]);
    println(int_to_str(v[0]));
}
