// Track MI (docs/roadmap/llvm-roadmap.md), the machine layer
// (compiler/nat_ir.fd):
//   MI26 narrow integers with a known extension state (ng_fold_ext_state):
//        every vreg carries the extension kinds all its values satisfy (a
//        narrow load, an EXT, a constant's range, a compare, AND with a
//        small mask, a shift right by a constant, moves), so an EXT of a
//        value that already satisfies it is a move, across blocks: a u8 /
//        u16 / i8 / i32 local stored in a loop, a truncation of a value that
//        fits, a widening of one already wide. Wrapping (@wrapping) and the
//        checked results keep their meaning; FID_NAT_OFF=extstate: every
//        extension emitted as before.
// Native check: bash tests/nattools/machine_batch4_check.sh (fewer `ext`
// in the MIR than with FID_NAT_OFF=extstate; FID_VERIFY=1; the output
// below on every machine-layer target).
// Expected output:
// 0
// 86
// 253
// 16850
// 76
// 705032704
// -24
// -1
// -1
// 255
// 1
// 110
// 3
// 503

@wrapping
fn sum_u8(n: i64) -> u8 {
    var acc: u8 = 0;
    var i: i64 = 0;
    while i < n {
        acc = acc + (i as u8);
        i = i + 1;
    }
    return acc;
}

@wrapping
fn mix_u16(n: i64) -> u16 {
    var h: u16 = 1;
    var i: i64 = 0;
    while i < n {
        h = h * 31 + 7;
        if (h & 1) == 0 {
            h = h >> 1;
        }
        i = i + 1;
    }
    return h;
}

@wrapping
fn down_i8(n: i64) -> i8 {
    var v: i8 = 100;
    var i: i64 = 0;
    while i < n {
        v = v - 7;
        i = i + 1;
    }
    return v;
}

@wrapping
fn wrap_i32(a: i32, n: i64) -> i32 {
    var x: i32 = a;
    var i: i64 = 0;
    while i < n {
        x = x + 1000000000;
        i = i + 1;
    }
    return x;
}

// a byte already masked, truncated and widened again
fn low_byte(x: i64) -> i64 {
    var b: i64 = x & 255;
    var t: u8 = b as u8;
    var w: i64 = t as i64;
    if w > 127 {
        w = w - 256;
    }
    return w;
}

// a value shifted down to 8 bits, then narrowed
fn top_byte(x: u64) -> u8 {
    var t: u64 = x >> 56;
    return t as u8;
}

// checked narrow arithmetic: in range, no panic
fn checked_u8(a: u8, b: u8) -> u8 {
    var s: u8 = a + b;
    if s > 200 {
        s = s - 100;
    }
    return s;
}

fn count_bytes(n: i64) -> i64 {
    var hist: u16 = 0;
    var c: u8 = 0;
    var i: i64 = 0;
    while i < n {
        c = ((i * 37) & 255) as u8;
        if c < 128 {
            hist = hist + 1;
        }
        i = i + 1;
    }
    return hist as i64;
}

fn main() {
    println(0);
    println(sum_u8(100));
    println(sum_u8(23));
    println(mix_u16(50));
    println(down_i8(40));
    println(wrap_i32(2000000000, 3));
    println(low_byte(1000));
    println(low_byte(0 - 1));
    println(low_byte(511));
    println(top_byte(18446744073709551615));
    println(top_byte(72057594037927936));
    println(checked_u8(150, 60));
    println(checked_u8(1, 2));
    println(count_bytes(1000));
}
