// CL6: `comptime splice make(args)` is a macro call in an expression: the
// `comptime fn` runs in the compiler, returns source text, and that text,
// parsed as one expression, takes the call's place before type checking
// (so it is type-checked where it stands). The call's arguments are
// evaluated at compile time too (int_to_str(6) below). The helper local the
// generated block declares comes from gensym, so `square_of("sq")` reads the
// caller's `sq`, not its own temporary. `comptime splice(21)` is still a
// comptime call of a function named `splice` (the word is followed by `(`).
// Expected output:
// 25
// 10
// 36
// 81
// 14
// 42
// 9

comptime fn square_of(e: str) -> str {
    val t = gensym("sq");
    return "{ val " + t + " = " + e + "; " + t + " * " + t + " }";
}

comptime fn add_all(a: str, b: str, c: str) -> str {
    return a + " + " + b + " + " + c;
}

comptime fn splice(n: i64) -> i64 {
    return n * 2;
}

struct Box2 { w: i64, h: i64 }

impl Box2 {
    fn area_sq(self: Box2) -> i64 {
        return comptime splice square_of("self.w * self.h");
    }
}

fn main() -> i64 {
    val x = 4;
    println(comptime splice square_of("x + 1"));
    println(comptime splice square_of("3") + 1);
    println(comptime splice square_of(int_to_str(6)));
    val sq = 9;
    println(comptime splice square_of("sq"));
    println(comptime splice add_all("x", "sq", "1"));
    println(comptime splice(21));
    val b = Box2 { w: 1, h: 3 };
    println(b.area_sq());
    return 0;
}
