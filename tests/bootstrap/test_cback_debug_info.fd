// TL5 / CE8 (C path, `fid ccompile -g`): the generated C has `#line`
// directives back to this file for its functions (free functions and the
// methods of its impl blocks), the C compiler gets -g, and a panic prints
// the values of the failing frame. Run normally, the program prints the
// lines below. Built with -g and run with an argument, it ends with
//     Panic: Division by zero
//     values in ratio:
//         total = 10
//         parts = 0
//         label = "share"
//         scale = 2.5
//         ok = true
// on stderr (exit status 1), and a C debugger stops at this file's lines.
// The scanner that finds this file's functions skips comments, strings,
// character literals and lifetimes: fn in_a_comment() is not one, nor is
// the "fn in_a_string()" below.
//
// Expected output:
// ratio 5
// Meter_scaled 25
// fn in_a_string() 7
// 'x'

struct Meter { v: i64 }

impl Meter {
    pub fn scaled(self: Meter, k: i64) -> i64 {
        return self.v * k;
    }
}

fn ratio(total: i64, parts: i64, label: str) -> i64 {
    var scale: f64 = 2.5;
    var ok: bool = scale > 1.0;
    if ok && str_len(label) > 0 {
        return total / parts;
    }
    return 0;
}

fn first<'a>(x: &'a i64) -> &'a i64 {
    return x;
}

fn main() -> i64 {
    println("ratio " + int_to_str(ratio(10, 2, "share")));
    val m = Meter { v: 5 };
    println("Meter_scaled " + int_to_str(m.scaled(5)));
    var seven: i64 = 7;
    val r = first(&seven);
    println("fn in_a_string() " + int_to_str(*r));
    println("'" + char_to_str(120) + "'");
    if p_argc() > 1 {
        println(int_to_str(ratio(10, 0, "share")));
    }
    return 0;
}
