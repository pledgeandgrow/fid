// Bugs roadmap BG433: a `Vec::new()` written directly as a call argument
// (`fill(Vec::new())`, `m.insert("g", Vec::new())`) was made with no
// element type, so the strings later pushed into it (or into a Vec sharing
// its buffer) were never freed. compiler/lower.fd
// Lowerer_lower_arg_for_param and Lowerer_lower_method_call make it with
// the parameter's (or the map value's) element type (Lowerer_rc_new_coll).
// Leak gate: `fid run tests/bootstrap/test_bg433_vec_new_arg_leak.fd
// --leaks` must report "every block was freed".
//
// Expected output:
// 1
// 1

fn fill(v: Vec<str>) -> Vec<str> {
    var w: Vec<str> = v;
    w.push(f"x{1}");
    return w;
}

fn main() {
    val r: Vec<str> = fill(Vec::new());
    println(r.len());
    var groups: HashMap<str, Vec<str>> = HashMap::new();
    groups.insert("g", Vec::new());
    var g: Vec<str> = groups.get("g");
    g.push(f"m{1}");
    println(g.len());
}
