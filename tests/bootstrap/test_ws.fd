// stdlib/ws: the parts of RFC 6455 a WebSocket needs without a network
// (competitive SL3): the handshake accept key (the RFC's own example),
// SHA-1, and frame encoding: short, 16-bit and masked lengths.
//
// Expected output:
// s3pPLMBiTxaQ9kYGzzhZRbK+xOo=
// a9993e364706816aba3e25717850c26c9cd0d89d
// 129 2 72 105
// 130 126 1 44 300
// masked: 129 130 len 8
// unmasked again: Hi
use ws;
use vec;
use string;
use encoding;

fn main() -> i64 {
    println(ws_accept_key("dGhlIHNhbXBsZSBub25jZQ=="));
    println(hex_encode_bytes(ws_sha1(str_bytes("abc"))));
    var hi: Vec<i64> = ws_frame_encode(1, str_bytes("Hi"), false);
    println(int_to_str(hi.get(0)) + " " + int_to_str(hi.get(1)) + " " + int_to_str(hi.get(2)) + " " + int_to_str(hi.get(3)));
    var payload: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 300 { payload.push(i & 255); i = i + 1; }
    var big: Vec<i64> = ws_frame_encode(2, payload, false);
    println(int_to_str(big.get(0)) + " " + int_to_str(big.get(1)) + " " + int_to_str(big.get(2)) + " " + int_to_str(big.get(3))
        + " " + int_to_str(big.len() - 4));
    var m: Vec<i64> = ws_frame_encode(1, str_bytes("Hi"), true);
    println("masked: " + int_to_str(m.get(0)) + " " + int_to_str(m.get(1)) + " len " + int_to_str(m.len()));
    // the client mask: 4 key bytes, then payload XOR key
    var out: str = "";
    i = 0;
    while i < 2 {
        out = out + char_to_str(m.get(6 + i) ^ m.get(2 + (i % 4)));
        i = i + 1;
    }
    println("unmasked again: " + out);
    return 0;
}
