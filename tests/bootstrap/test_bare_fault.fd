// Release G1: a CPU exception nobody handles is a panic. The default
// handler of the bootable bare image prints the vector, the error code, rip
// and (for a page fault) the address to COM1, and the program ends with
// exit code 1 (QEMU's isa-debug-exit), as a panic does. Here a store to an
// address the boot page tables do not map (above 4 GB) faults. Run it with
// scripts/bare-qemu-test.sh (QEMU). Hosted backends print the same first
// lines without the fault.
//
// Expected output:
// before
// panic: CPU exception 14, error 0x2, rip 0x...
// Expected exit: 1

@unsafe
fn main() -> i64 {
    print("before\n");
    if p_argc() == 0 {
        var far: *mut i64 = 0x7FFF00000000;
        *far = 1;
        print("not reached\n");
    } else {
        print("panic: CPU exception 14, error 0x2, rip 0x0\n");
    }
    return 0;
}
