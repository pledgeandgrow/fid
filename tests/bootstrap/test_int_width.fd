// One meaning for integer arithmetic on every backend: unsigned types are
// unsigned, narrow types keep their range, @wrapping wraps at its width.
@wrapping
fn wrap_i32(a: i32) -> i32 { return a + 1; }
@wrapping
fn wrap_u8(a: u8) -> u8 { return a + 10; }
@wrapping
fn wrap_i64(a: i64, b: i64) -> i64 { return a + b; }
@wrapping
fn wrap_div(a: i64, b: i64) -> i64 { return a / b; }
fn minus_one() -> i64 { return -1; }
fn main() -> i64 {
    var u: u64 = 18446744073709551615;
    print(u); print("\n");
    print(u / 2); print("\n");
    print(u % 10); print("\n");
    print(u >> 60); print("\n");
    if u > 1 { print(1); } else { print(0); }
    print("\n");
    var n: u32 = 4294967295;
    print(n); print("\n");
    print(n / 2); print("\n");
    print(n >> 28); print("\n");
    var x: i32 = 2147483647;
    print(wrap_i32(x)); print("\n");
    var y: u8 = 250;
    print(wrap_u8(y)); print("\n");
    print(y + 5); print("\n");
    print(wrap_i64(9223372036854775807, 1)); print("\n");
    var low: i64 = -9223372036854775807;
    low = low - 1;
    print(wrap_div(low, minus_one())); print("\n");
    print(low % minus_one()); print("\n");
    var s: i64 = -16;
    print(s >> 2); print("\n");
    var w: i32 = 2000000000;
    var b: i64 = 2000000000;
    print(w + b); print("\n");
    return 0;
}
