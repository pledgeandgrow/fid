// expect-error: is @no-recursion but calls itself
// Test: @no-recursion rejects a function that calls itself (release L1:
// one negative test per safety rule).

@no-recursion
fn depth(n: i64) -> i64 {
    if n == 0 { return 0; }
    return 1 + depth(n - 1);
}

fn main() {
    println(depth(3));
}
