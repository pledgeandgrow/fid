// Test struct methods in PE emitter
struct Point {
    x: i64,
    y: i64,
}

impl Point {
    fn new(x: i64, y: i64) -> Point {
        return Point { x: x, y: y };
    }

    fn distance(self: Point) -> i64 {
        return self.x + self.y;
    }
}

fn main() -> i64 {
    val p = Point::new(3, 4);
    print(p.distance());
    print(p.x);
    print(p.y);
    return 0;
}
