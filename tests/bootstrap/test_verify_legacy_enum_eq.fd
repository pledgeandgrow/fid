// Earlier miscompile "known-bugs 1.11": `==` on enum values compared
// pointers, so an enum literal and a matched or passed value of the same
// variant were unequal. Literal vs literal, value vs literal, values through
// a function and a struct field.
//
// Expected output:
// true
// false
// true
// true
// false

enum Op {
    Add,
    Sub,
    Mul,
}

struct Holder {
    op: Op,
}

fn pick(n: i64) -> Op {
    if n == 0 {
        return Op::Add;
    }
    if n == 1 {
        return Op::Sub;
    }
    return Op::Mul;
}

fn show(b: bool) {
    if b {
        println("true");
    } else {
        println("false");
    }
}

fn main() -> i64 {
    show(Op::Add == Op::Add);
    show(Op::Add == Op::Sub);
    var a: Op = pick(1);
    show(a == Op::Sub);
    var h: Holder = Holder { op: pick(2) };
    show(h.op == Op::Mul);
    show(h.op == pick(0));
    return 0;
}
