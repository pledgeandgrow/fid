// expect-error: is a variant of enum 'Option', but the value matched is a 'P', which is no enum
// Bugs roadmap BG393: a variant pattern against a struct value read the
// struct's first word as an enum tag.
struct P { x: i64 }
fn main() {
    val p = P { x: 1 };
    match p {
        Option::Some(v) => {
            println(v);
        }
        _ => {
            println("o");
        }
    }
}
