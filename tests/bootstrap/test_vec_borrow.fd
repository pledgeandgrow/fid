// Vecs passed to functions that keep nothing are freed by the caller, and those
// a function keeps are not.
struct Box2 { items: Vec<i64> }

fn total(v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    for i in 0..v.len() {
        s = s + v.get(i);
    }
    return s;
}

fn total_ref(v: &Vec<i64>) -> i64 {
    return total_again(v) + v.len();
}

fn total_again(v: &Vec<i64>) -> i64 {
    if v.len() == 0 {
        return 0;
    }
    return v.get(0);
}

fn fill(v: &mut Vec<i64>, n: i64) {
    for i in 0..n {
        v.push(i);
    }
}

fn keep(v: Vec<i64>) -> Box2 {
    return Box2 { items: v };
}

fn pass_on(v: Vec<i64>) -> Vec<i64> {
    return v;
}

fn ping(v: &Vec<i64>, n: i64) -> i64 {
    if n == 0 {
        return v.len();
    }
    return pong(v, n - 1);
}

fn pong(v: &Vec<i64>, n: i64) -> i64 {
    return ping(v, n);
}

fn main() -> i64 {
    var sum: i64 = 0;
    var round: i64 = 0;
    while round < 2000 {
        var a: Vec<i64> = Vec::new();
        fill(&mut a, 100);
        sum = sum + total_ref(&a) + ping(&a, 3) + total(a);
        round = round + 1;
    }
    print(sum);
    var b: Vec<i64> = Vec::new();
    b.push(7);
    val held: Box2 = keep(b);
    var c: Vec<i64> = Vec::new();
    c.push(8);
    val same: Vec<i64> = pass_on(c);
    var d: Vec<i64> = Vec::new();
    d.push(9);
    print(held.items.get(0));
    print(same.get(0));
    return 0;
}
