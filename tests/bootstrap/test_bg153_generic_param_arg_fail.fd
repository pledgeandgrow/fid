// expect-error: method 'Cell.put' parameter 1 expects 'i64', got 'str'
// Bugs roadmap BG153: an argument typed as a bare type parameter (`x: T`)
// of a generic impl's method was never checked, though the receiver's
// type gives T: `Cell<i64>.put("oops")` was accepted.
struct Cell<T> {
    v: T,
}

impl<T> Cell<T> {
    fn put(self: &mut Cell<T>, x: T) {
        self.v = x;
    }
    fn take(self: Cell<T>) -> T {
        return self.v;
    }
}

fn main() -> i64 {
    var c: Cell<i64> = Cell { v: 1 };
    c.put("oops");
    println(c.take() + 1);
    return 0;
}
