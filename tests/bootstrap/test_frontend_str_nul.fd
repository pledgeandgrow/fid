// RT2 (fid): a `\0` (or `\x00`, `\u{0}`) inside a string literal is a zero
// byte of the string; it no longer ends the literal. The C string table,
// pe_ir's .rdata and the machine layer's strings take the length from the
// literal ([static magic][length] before the bytes), so every backend sees
// the same five bytes.
// Expected output:
// 5
// 0
// 99
// 3
// different
// 7
// 8

fn main() -> i64 {
    val s: str = "ab\0cd";
    println(str_len(s));
    println(str_byte_at(s, 2));
    println(str_byte_at(s, 3));
    println(str_len("\x00\u{0}\0"));
    if "ab\0cd" != "ab" {
        println("different");
    }
    val t: str = s + "\0z";
    println(str_len(t));
    println(str_len(str_slice(t, 1, 7) + "\0\0"));
    return 0;
}
