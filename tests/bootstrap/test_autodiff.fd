// test_autodiff.fd — ML3: Effect-Traced Autodiff
// Expected: PASS
// Tests @differentiable annotation with effect-traced differentiability.
// The typechecker verifies that @differentiable functions only use Diff-tracked ops.

use tensor;

@differentiable
fn forward(x: Tensor) -> Tensor {
    // matmul produces Diff effect — OK for @differentiable
    val w = zeros(vec2(2, 2));
    val h = matmul(x, w);
    val a = relu(h);
    return a;
}

@differentiable
fn linear(x: Tensor, w: Tensor, b: Tensor) -> Tensor {
    val h = matmul(x, w);
    val out = add(h, b);
    return out;
}

@differentiable
fn pure_helper(x: i64) -> i64 {
    // Pure computation — no side effects, no IO
    return x + 1;
}

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

fn main() {
    val s = vec2(2, 2);
    val x = ones(s);
    val result = forward(x);
    print(to_str(result));
    print("\n");

    val w = ones(s);
    val b = zeros(s);
    val result2 = linear(x, w, b);
    print(to_str(result2));
    print("\n");

    val n = pure_helper(41);
    print(n);
    print("\n");

    return 0;
}
