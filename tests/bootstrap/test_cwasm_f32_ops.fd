// Test (known-bugs 2g.13): `%` on f32 is fmodf on the C path (it wrote
// `a % b`, which C rejects) and a remainder on WASM (it gave 0); a cast
// between f32 and f64 converts the value (C wrote `v = (void*)x`, WASM
// kept the f64's bits as an f32).
//
// Expected output:
// 1.5
// 2.5
// -1.5
// 4.25
// 4
fn main() -> i64 {
    val a: f32 = 7.5 as f32;
    val b: f32 = 3.0 as f32;
    val r: f32 = a % b;
    println(float_to_str(r as f64));
    val c: f64 = 8.5;
    val d: f64 = 3.0;
    println(float_to_str(c % d));
    val e: f32 = (0.0 - 7.5) as f32;
    val er: f32 = e % b;
    println(float_to_str(er as f64));
    val h: f32 = 4.25 as f32;
    val back: f64 = h as f64;
    println(float_to_str(back));
    val n: i64 = back as i64;
    println(int_to_str(n));
    return 0;
}
