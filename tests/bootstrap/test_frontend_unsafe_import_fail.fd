// expect-error: (module 'test_frontend_unsafe_mod', line 7): p_malloc() needs an `unsafe` block
// Release M2: raw allocation outside `unsafe` is rejected in an imported
// module as it is in the program itself (and, since M10 on Nov 22, in the
// standard library's modules too; only core and the runtimes, the trusted
// base the compiler merges in, are exempt). Before, any imported module could call
// p_malloc, p_free or a C function, or make a pointer from an integer,
// without `unsafe`.

use test_frontend_unsafe_mod;

fn main() -> i64 {
    println(um_safe(8));
    return 0;
}
