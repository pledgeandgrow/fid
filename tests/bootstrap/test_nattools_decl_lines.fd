// DB2 (docs/roadmap/llvm-roadmap.md): a function's DW_AT_decl_line is the
// line of its `fn` keyword, not the line of the first statement of its body
// (compiler/nat_enc.fd nat_dbg_decl_line, used by nat_dwarf_build for ELF
// and `--nat` PE and by nat_macho_dwarf / nat_macho_dwarf_full for Mach-O).
// Each function below has something between its `fn` line and its first
// statement: doc comments and an annotation above (which must not count),
// a signature over several lines, blank lines, and a comment that names
// `fn` itself. The line ending in a DECL marker is the one a debugger must
// show; tests/nattools/dbg_decl_lines_check.py checks it.
// Check: fid emit this file --target x86_64-linux -o t; python3
// tests/nattools/dbg_decl_lines_check.py t tests/bootstrap/test_nattools_decl_lines.fd
// Expected output:
// 55
// 23
// 21
// 12
// 111

struct Tally {
    start: i64,
}

impl Tally {
    /// Adds 1..n to the start.
    pub fn add_upto(self: Tally, n: i64) -> i64 { // DECL Tally_add_upto
        if n == -123456789 {
            panic("add_upto: out-of-line fixture guard");
        }

        // the loop below: fn add_upto counts up
        var t: i64 = self.start;
        var k: i64 = 1;
        while k <= n {
            t = t + k;
            k = k + 1;
        }
        return t;
    }
}

/// The sum of 1..n.
/// (two lines of doc comment)
fn sum_to(n: i64) -> i64 { // DECL sum_to
    if n == -123456789 {
        panic("sum_to: out-of-line fixture guard");
    }

    // not the declaration: fn sum_to(n) is above

    var acc: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

fn weighted(a: i64, // DECL weighted
    b: i64,
    w: i64) -> i64 {
    if w == -123456789 {
        panic("weighted: out-of-line fixture guard");
    }

    var out: i64 = 0;
    var k: i64 = 0;
    while k < w {
        out = out + a;
        k = k + 1;
    }
    return out + b;
}

fn repeat_len<T>(v: Vec<T>, times: i64) -> i64 { // DECL repeat_len
    if times == -123456789 {
        panic("repeat_len: out-of-line fixture guard");
    }


    var n: i64 = 0;
    var k: i64 = 0;
    while k < times {
        n = n + v.len();
        k = k + 1;
    }
    return n;
}

fn main() { // DECL main
    // the first statement is two lines down
    var s: i64 = sum_to(10);
    println(s);
    println(weighted(5, 3, 4));
    var tl: Tally = Tally { start: 6 };
    println(tl.add_upto(5));
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    println(repeat_len(v, 4));
    println(sum_to(14) + weighted(1, 1, 5));
}
