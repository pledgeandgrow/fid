// expect-error: function 'relay_trip' is @no-blocking but calls 'p_mutex_lock'
// Roadmap Phase 9 / F59: @grid-safe forbids blocking operations (IEC 61850:
// a trip decision must come in bounded time). Taking a lock can wait for
// another thread, so it is rejected.

@grid-safe
fn relay_trip(lock: i64, current: i64) -> i64 {
    p_mutex_lock(lock);
    var trip: i64 = 0;
    if current > 1000 {
        trip = 1;
    }
    p_mutex_unlock(lock);
    return trip;
}

fn main() -> i64 {
    val m: i64 = p_mutex_init();
    println(int_to_str(relay_trip(m, 1500)));
    return 0;
}
