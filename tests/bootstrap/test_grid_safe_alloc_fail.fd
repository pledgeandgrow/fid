// expect-error: is @no-alloc but uses .push(), which allocates
// Roadmap Phase 9 / F59: @grid-safe forbids heap allocation in the
// protection path.

@grid-safe
fn record_fault(log: & mut Vec<i64>, current: i64) -> i64 {
    log.push(current);
    return 1;
}

fn main() -> i64 {
    var log: Vec<i64> = Vec::new();
    println(int_to_str(record_fault(& mut log, 1500)));
    return 0;
}
