// VF5: constant folding (compiler/iropt.fd iro_fold) must compute what the
// program would at run time: unsigned comparisons and division, narrow
// types, shifts. A fold that used signed i64 arithmetic for these, or
// folded a result that does not fit its type, prints a different line.
// The interpreter does not run iropt, so it is the reference.

fn main() -> i64 {
    // unsigned compare of constants: signed folding gets these wrong
    val big: u64 = 18446744073709551615;
    val one: u64 = 1;
    if big > one { println(1); } else { println(0); }
    if big >= 9223372036854775808 { println(1); } else { println(0); }
    val h: u64 = big / 3;
    print(h); print("\n");
    val r: u64 = big % 10;
    print(r); print("\n");
    val sh: u64 = big >> 60;
    print(sh); print("\n");

    // u32 / u8 arithmetic folded at their width
    val a32: u32 = 4000000000;
    val b32: u32 = 7;
    println(a32 / b32);
    if a32 > 3000000000 { println(1); } else { println(0); }
    val a8: u8 = 250;
    val b8: u8 = 3;
    println(a8 / b8);
    println(a8 % b8);
    println(a8 - b8);

    // signed: truncating division and remainder of negatives
    val n: i64 = 0 - 7;
    val d: i64 = 2;
    println(n / d);
    println(n % d);
    println(n >> 1);
    val m8: i8 = 0 - 100;
    println(m8 / 3);

    // shifts at the type's width
    val s8: u8 = 200;
    val k: u8 = 1;
    val t8: u8 = s8 << k;
    println(t8);
    val one16: i16 = 1;
    val s16: i16 = one16 << 14;
    println(s16);

    // comparisons folded to bools that feed branches
    val x: i64 = 5;
    val y: i64 = 5;
    var c: i64 = 0;
    if x == y { c = c + 1; }
    if x != y { c = c + 10; }
    if x <= y && x >= y { c = c + 100; }
    if !(x < y) { c = c + 1000; }
    println(c);
    return 0;
}
