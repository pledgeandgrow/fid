// Roadmap Phase 16 (UEFI PE32+ emission): `fid emit --uefi` writes this as
// a UEFI application (a PE32+ image of subsystem EFI_APPLICATION, no
// stdlib) that prints through ConOut->OutputString and returns main's
// result as its EFI_STATUS. The str global's slot holds an absolute address:
// a DIR64 base relocation, so the firmware can load the image anywhere.
// Build and boot it (QEMU with OVMF) with tests/uefi/run.sh:
//   fid emit tests/bootstrap/test_uefi_hello.fd --uefi -o hello.efi
// Hosted backends print the same.
//
// Expected output:
// hello from UEFI
// 6765
// -42
// true
// greeting: Fides
// 30
// 12
// done

var g_name: str = "Fides";
var g_count: i64 = 0;

struct Point {
    x: i64,
    y: i64,
}

fn fib(n: i64) -> i64 {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn bump() {
    g_count = g_count + 10;
}

@unsafe
fn main() -> i64 {
    print("hello from UEFI\n");
    print(fib(20)); print("\n");
    print(-42); print("\n");
    print(true); print("\n");
    print("greeting: "); print(g_name); print("\n");
    bump(); bump(); bump();
    print(g_count); print("\n");
    var p = Point { x: 5, y: 7 };
    var block: i64 = p_malloc(16);
    var cell: *mut i64 = block;
    *cell = p.x + p.y;
    print(*cell); print("\n");
    print("done\n");
    return 0;
}
