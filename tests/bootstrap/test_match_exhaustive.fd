// Test: Non-exhaustive match checking (Issue 49)
// This test verifies that exhaustive matches work correctly.

enum Color {
    Red,
    Green,
    Blue,
}

fn color_to_num(c: Color) -> i64 {
    match c {
        Color::Red => { return 0; }
        Color::Green => { return 1; }
        Color::Blue => { return 2; }
    }
}

fn main() {
    val c: Color = Color::Red;
    val n: i64 = color_to_num(c);
    println(n);
}
