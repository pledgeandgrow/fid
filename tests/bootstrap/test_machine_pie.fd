// Track TG (docs/roadmap/llvm-roadmap.md), TG14: a position-independent
// Linux executable (compiler/nat_ir.fd ng_gen_pie_reloc / ng_gen_pie_table,
// compiler/nat_enc.fd g_nat_pie: ET_DYN at link address 0; _start adds the
// load bias to every absolute word). This program reaches the kinds of
// absolute words the image holds: function values, trait objects (their
// method tables), string constants, globals, a HashMap of strings. Its
// output is the same in every build; the PIE check is
//   FID_NAT_ON=pie NATIVE=1 FID=release/fid.exe bash scripts/cross-test.sh x86_64-linux
// (and aarch64-linux, riscv64-linux), where `readelf -h` shows DYN.
// Expected output:
// 10
// 15
// 9
// 910
// 2
// alpha-beta
// 7
// hello, world

var names: Vec<str> = Vec::new();
var base: i64 = 5;

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

fn double(x: i64) -> i64 {
    return x * 2;
}

fn plus_base(x: i64) -> i64 {
    return x + base;
}

cap Shape {
    fn area(self) -> i64;
}

struct Sq { s: i64 }

impl Shape for Sq {
    pub fn area(self: Sq) -> i64 { return self.s * self.s; }
}

struct Rect { w: i64, h: i64 }

impl Shape for Rect {
    pub fn area(self: Rect) -> i64 { return self.w * self.h; }
}

fn total(a: dyn Shape, b: dyn Shape) -> i64 {
    return a.area() * 100 + b.area();
}

fn main() -> i64 {
    println(apply(double, 5));
    println(apply(plus_base, 10));
    val q = Sq { s: 3 };
    val r = Rect { w: 2, h: 5 };
    val dq = q as dyn Shape;
    val dr = r as dyn Shape;
    println(dq.area());
    println(total(dq, dr));
    names.push("alpha");
    names.push("beta");
    println(names.len());
    println(names.get(0) + "-" + names.get(1));
    var table: HashMap<str, i64> = HashMap::new();
    table.insert("k", 7);
    println(table.get("k"));
    val greeting: str = "hello";
    println(greeting + ", world");
    return 0;
}
