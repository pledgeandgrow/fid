// ME2 (compiler/checks.fd): the counted-loop proof (peir_unchecked_ops,
// peir_counted_loop) and the range facts (peir_range_ops) read the shared
// CFG and loop tree (iro_cfg, iro_loops, iro_loop_body) instead of a CFG
// and depth-first back edges of their own; iropt_me's loop passes and
// iropt's strength reduction take their loop bodies from the same tree.
// Index checks a counted loop proves are dropped on every native backend;
// the results below must not change: nested loops, a loop entered from a
// branch, a loop after a loop, an inner loop bounded by the outer index.
//
// Expected output:
// 120
// 6580
// 45 45
// 165
// 0

fn sum_all(v: Vec<i64>) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        t = t + v.get(i);
        i = i + 1;
    }
    return t;
}

fn pairs(v: Vec<i64>) -> i64 {
    // inner loop over the outer index
    var t: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        var j: i64 = 0;
        while j < i {
            t = t + v.get(i) * v.get(j);
            j = j + 1;
        }
        i = i + 1;
    }
    return t;
}

fn branchy(v: Vec<i64>, flag: bool) -> str {
    var a: i64 = 0;
    var b: i64 = 0;
    if flag {
        var i: i64 = 0;
        while i < v.len() {
            a = a + v.get(i);
            i = i + 1;
        }
    }
    var k: i64 = v.len() - 1;
    while k >= 0 {
        b = b + v.get(k);
        k = k - 1;
    }
    return int_to_str(a) + " " + int_to_str(b);
}

fn tri(n: i64) -> i64 {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        v.push(i);
        i = i + 1;
    }
    var t: i64 = 0;
    var r: i64 = 0;
    while r < v.len() {
        var c: i64 = 0;
        while c <= r {
            t = t + v.get(c);
            c = c + 1;
        }
        r = r + 1;
    }
    return t;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 16 {
        v.push(i);
        i = i + 1;
    }
    println(sum_all(v));
    println(pairs(v));
    var w: Vec<i64> = Vec::new();
    i = 0;
    while i < 10 {
        w.push(i);
        i = i + 1;
    }
    println(branchy(w, true));
    println(tri(10));
    var e: Vec<i64> = Vec::new();
    println(sum_all(e));
}
