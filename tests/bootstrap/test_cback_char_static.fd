// RT3 (C part): every one-byte string is one of 256 static strings in the
// C runtime (the literal layout), so p_char_to_str, char_to_str and core's
// one-byte slices never allocate there; freeing one does nothing, so a
// `fid run --leaks` of this program reports no block. The strings behave
// as any other: compared by content, concatenated, sliced, counted.
//
// Expected output:
// e
// A
// 1
// h,e,l,l,o,
// true
// true
// 0
// ab
// 5
// 200

fn main() -> i64 {
    var s: str = "hello";
    println(str_slice(s, 1, 2));
    println(char_to_str(65));
    println(str_len(char_to_str(0)));
    var acc: str = "";
    var i: i64 = 0;
    while i < str_len(s) {
        acc = acc + str_slice(s, i, i + 1) + ",";
        i = i + 1;
    }
    println(acc);
    println(char_to_str(200) == char_to_str(200));
    println(str_slice(s, 2, 3) == str_slice(s, 3, 4));
    println(str_byte_at(char_to_str(0), 0));
    var two: str = char_to_str(97) + char_to_str(98);
    println(two);
    // many one-byte strings: none of them is a new block
    var n: i64 = 0;
    var k: i64 = 0;
    while k < 1000 {
        var c: str = char_to_str(48 + k % 10);
        if c == "5" {
            n = n + 1;
        }
        k = k + 1;
    }
    println(n / 20);
    println(str_byte_at(char_to_str(200), 0));
    return 0;
}
