// expect-error: Duplicate definition: enum 'Kind' is defined differently in module
// Bugs roadmap BG143: two imported modules define `enum Kind` with other
// variants. The merge kept one of them, and the other module's code failed
// with "enum 'Kind' has no variant"; now it is a duplicate-definition error
// naming both modules (compiler.fd cc_find_module_conflicts), as for two
// structs of one name with other fields.
use same_name_lib::ea;
use same_name_lib::eb;

fn main() -> i64 {
    val a: Kind = kind_a();
    return 0;
}
