// expect-error: if condition must be bool, got str (the guard
// Bugs roadmap BG414: the value form of match checks its guards too;
// before, `3 if "yes" => 1` compiled and r was 2.
fn main() {
    val x: i64 = 3;
    val r = match x {
        3 if "yes" => 1,
        _ => 2,
    };
    println(r);
}
