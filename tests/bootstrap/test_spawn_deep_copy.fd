// Test: Vec, Vec<str> and HashMap arguments of spawn are copied whole
// for the thread: the caller keeps changing its own values while the
// threads run, and neither side sees the other's changes.
//
// Expected output:
// thread sum 6
// thread words 3 abc
// thread map 2
// main 5 4 3
fn sum(v: Vec<i64>) -> i64 {
    var w: Vec<i64> = v;
    w.push(0);
    var s: i64 = 0;
    var i: i64 = 0;
    while i < w.len() { s = s + w.get(i); i = i + 1; }
    return s;
}

fn words(ws: Vec<str>) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < ws.len() { out = out + ws.get(i); i = i + 1; }
    return int_to_str(ws.len()) + " " + out;
}

fn count(m: HashMap<str, i64>) -> i64 { return m.len(); }

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    var ws: Vec<str> = Vec::new();
    ws.push("a");
    ws.push("b");
    ws.push("c");
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("x", 1);
    m.insert("y", 2);
    val t1 = spawn sum(v);
    val t2 = spawn words(ws);
    val t3 = spawn count(m);
    v.push(4);
    v.push(5);
    ws.push("d");
    m.insert("z", 3);
    println("thread sum " + int_to_str(await t1));
    println("thread words " + await t2);
    println("thread map " + int_to_str(await t3));
    println("main " + int_to_str(v.len()) + " " + int_to_str(ws.len()) + " " + int_to_str(m.len()));
    return 0;
}
