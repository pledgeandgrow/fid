// Substring search on every backend, natively too (complaint CU7: the
// native-only doc examples of stdlib/bpe.fd and stdlib/db.fd). core's
// String_find skips to the next place the first byte occurs with
// p_mem_find_byte, which the native Windows runtime replaces with msvcrt's
// memchr (stdlib/pe_runtime/base.fd `pert_mem_find_byte`). When memchr is
// not in pe_ir_enc.fd's msvcrt import list, `fid emit` on Windows refuses
// the program: "not available in native Windows executables: pe_c_memchr".
// The searches cross the 8-byte word boundary and hit the first, the last
// and no position.
// Expected output:
// 6
// 0
// 10
// -1
// 41
// -1
// true
// false
// 0
// str find ok
fn main() -> i64 {
    val s: str = "hello world";
    println(str_find(s, "wor"));
    println(str_find(s, "hel"));
    println(str_find(s, "d"));
    println(str_find(s, "xyz"));
    val long: str = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab needle";
    println(str_find(long, "b needle"));
    println(str_find(long, "needles"));
    println(str_contains(long, "ab "));
    println(str_contains(s, "worlds"));
    println(str_find(s, ""));
    println("str find ok");
    return 0;
}
