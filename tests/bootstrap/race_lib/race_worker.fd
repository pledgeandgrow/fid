// Helper of test_race_import_fail.fd: a module (not the program's own
// file, not the stdlib) whose function starts two threads that both
// increment its global. TypeChecker_verify_no_races once counted only the
// writes of the program's main file, so this race passed `fid check`.
module race_worker;

var hits: i64 = 0;

fn work() -> i64 {
    var i: i64 = 0;
    while i < 1000 {
        bump();
        i = i + 1;
    }
    return 0;
}

fn bump() {
    hits = hits + 1;
}

pub fn run_workers() -> i64 {
    val a = spawn work();
    val b = spawn work();
    await a;
    await b;
    return hits;
}
