// Bugs roadmap BG2: `*x = v` is checked now (x is a reference, a raw
// pointer in `unsafe` or a Box, and the value fits what it points to);
// these writes stay accepted: through a `&mut i64` (plain and compound,
// with a narrower literal), a `&mut str`, a `&mut` of a struct and a
// `&mut bool`.
// Expected output:
// 12
// new
// 3 4
// true
struct Pt {
    x: i64,
    y: i64,
}

fn bump(r: &mut i64) {
    *r = 10;
    *r += 2;
}

fn rename(s: &mut str) {
    *s = "new";
}

fn reset(p: &mut Pt) {
    *p = Pt { x: 3, y: 4 };
}

fn mark(f: &mut bool) {
    *f = true;
}

fn main() -> i64 {
    var n: i64 = 0;
    bump(&mut n);
    println(int_to_str(n));
    var s: str = "old";
    rename(&mut s);
    println(s);
    var p: Pt = Pt { x: 0, y: 0 };
    reset(&mut p);
    println(int_to_str(p.x) + " " + int_to_str(p.y));
    var f: bool = false;
    mark(&mut f);
    if f {
        println("true");
    }
    return 0;
}
