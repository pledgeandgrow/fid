// BM4 (competitive roadmap): sort, 1000 pseudo-random integers.
// bench/work/fides/sort.fd on a small input (sortsum(1000)), so the suite checks
// the benchmark's code on every backend; the expected value is the
// reference algorithm's, computed in Python with the same operations.
//
// Expected output:
// 580354036
fn sortsum(n: i64) -> i64 {
    var v: Vec<i64> = Vec::new();
    var x: i64 = 12345;
    var i: i64 = 0;
    while i < n {
        x = (x * 1103515245 + 12345) % 2147483648;
        v.push(x);
        i = i + 1;
    }
    v.sort();
    var s: i64 = 0;
    i = 0;
    while i < n {
        s = (s + v.get(i) * (i % 1000)) % 1000000007;
        i = i + 1;
    }
    return s;
}

fn main() -> i64 {
    println(sortsum(1000));
    return 0;
}
