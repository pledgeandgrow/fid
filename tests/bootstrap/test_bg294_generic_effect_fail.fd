// expect-error: function 'via_generic' has inferred effect '!IO' (through a method it calls)
// Bugs roadmap BG294: the same through a generic bound `T: Logger`.
cap Logger {
    fn log(self) -> i64;
}
struct L { n: i64 }
impl Logger for L {
    pub fn log(self: L) -> i64 {
        println("side effect");
        return 1;
    }
}
fn via_generic<T: Logger>(t: T) -> i64 !{} {
    return t.log();
}
fn main() -> i64 {
    val l = L { n: 1 };
    println(via_generic(l));
    return 0;
}
