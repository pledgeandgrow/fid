// Bugs roadmap BG386: a fixed-array result through a function value
// (`val g = mk; g(3)`, a closure, `apply(mk, 4)`) was garbage on emit,
// --nat and wasm: the IR optimizer's closure devirtualisation
// (compiler/iropt.fd iro_cp_direct_args) put the env before the result
// pointer for an Array result (only a Struct result's went first).
// Check on emit and emit --nat (run and ccompile have no mid-end).
//
// Expected output:
// 18
// 12
// 36

fn mk(k: i64) -> [i64; 3] {
    return [k, k * 2, k * 3];
}

fn apply(g: fn(i64) -> [i64; 3], k: i64) -> [i64; 3] {
    return g(k);
}

fn main() {
    val g = mk;
    val b = g(3);
    println(b[0] + b[1] + b[2]);
    val d = apply(mk, 4);
    println(d[2]);
    val f = fn(k: i64) -> [i64; 3] {
        return [k, k + 10, k + 20];
    };
    val c = f(2);
    println(c[0] + c[1] + c[2]);
}
