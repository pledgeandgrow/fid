// Bugs roadmap BG383: `spawn f(x)` of a plain function returning a struct
// or a fixed array passed no result pointer: the callee took the env as
// its result pointer and its arguments shifted (`fid run` printed `void`,
// the native backends crashed). compiler/lower.fd Lowerer_spawn_call now
// starts such a callee through Lowerer_spawn_ir_wrapper, which passes a
// heap block for the result and returns its address (await copies a struct
// out of it, as for an async task).
//
// Expected output:
// 7
// 15
// 30

struct R2 { a: i64, c: i64 }

fn mk2(n: i64) -> R2 {
    println(n);
    return R2 { a: n, c: n + 1 };
}

fn arr(n: i64) -> [i64; 3] {
    return [n, n * 2, n * 3];
}

fn main() {
    val t = spawn mk2(7);
    val r = await t;
    println(r.a + r.c);
    val t2 = spawn arr(5);
    val b = await t2;
    println(b[0] + b[1] + b[2]);
}
