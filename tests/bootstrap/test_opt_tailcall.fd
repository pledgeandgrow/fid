// VF5: self tail calls turned into jumps (compiler/iropt.fd iro_tailcalls).
// The new parameter values must all be computed from the old ones before
// any is overwritten (gcd swaps its two; rot3 rotates three), and a call
// that is not in tail position must stay a call. Depths stay under the
// interpreter's default limit of 1000 frames (`fid run --max-recursion`).

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { return a; }
    return gcd(b, a % b);
}

fn rot3(a: i64, b: i64, c: i64, n: i64) -> i64 {
    if n == 0 { return a * 100 + b * 10 + c; }
    return rot3(b, c, a, n - 1);
}

fn sum_to(n: i64, acc: i64) -> i64 {
    if n == 0 { return acc; }
    return sum_to(n - 1, acc + n);
}

// not a tail call: the result is used after the call
fn fact(n: i64) -> i64 {
    if n <= 1 { return 1; }
    return n * fact(n - 1);
}

fn count_down(n: i64, steps: i64) -> i64 {
    if n <= 0 { return steps; }
    if n % 2 == 0 { return count_down(n / 2, steps + 1); }
    return count_down(n - 1, steps + 1);
}

fn main() -> i64 {
    println(gcd(1071, 462));
    println(gcd(462, 1071));
    println(gcd(17, 0));
    println(rot3(1, 2, 3, 0));
    println(rot3(1, 2, 3, 1));
    println(rot3(1, 2, 3, 2));
    println(rot3(1, 2, 3, 301));
    println(sum_to(900, 0));
    println(fact(15));
    println(count_down(1000003, 0));
    return 0;
}
