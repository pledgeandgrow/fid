// expect-error: cannot assign str to variable 'n' of type i64
// CL6: a spliced expression is type-checked in place, like one written in
// the source: the generated text `"a" + "b"` is a str, rejected where the
// splice stands (an i64 variable), not accepted because compile-time code
// produced it.
comptime fn joined() -> str {
    return "\"a\" + \"b\"";
}

fn main() -> i64 {
    val n: i64 = comptime splice joined();
    println(n);
    return 0;
}
