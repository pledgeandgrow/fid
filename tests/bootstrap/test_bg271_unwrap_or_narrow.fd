// Bugs roadmap BG271: `Option<f32>.unwrap_or(1.5)` was instantiated as
// `Option__unwrap_or__f64` (T from the f64 literal, not from the receiver's
// Option<f32>), so the f32 payload was read as a double; `Option<i32>` and
// `Result<i32, str>` with an integer literal default read the zero-extended
// word.
//
// Expected output:
// 7.5
// 1.5
// -42
// 5
// -9
// 1
fn idf(x: f32) -> f32 {
    return x;
}
fn id32(x: i32) -> i32 {
    return x;
}
fn main() {
    val o: Option<f32> = Option::Some(idf(7.5));
    println(f"{o.unwrap_or(1.5)}");
    val n: Option<f32> = Option::None;
    println(f"{n.unwrap_or(1.5)}");
    val oi: Option<i32> = Option::Some(id32(-42));
    println(f"{oi.unwrap_or(5)}");
    val ni: Option<i32> = Option::None;
    println(f"{ni.unwrap_or(5)}");
    val r: Result<i32, str> = Result::Ok(id32(-9));
    println(f"{r.unwrap_or(1)}");
    val re: Result<i32, str> = Result::Err("no");
    println(f"{re.unwrap_or(1)}");
}
