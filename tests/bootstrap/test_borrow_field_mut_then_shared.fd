// A mutable borrow of a field ends at its last use (reference section 8.4):
// after it, a shared borrow of the whole struct is accepted, and so is a
// shared borrow of a sibling field while the &mut is live. The negative
// case (the &mut used again after `&g`) is
// test_borrow_field_mut_whole_shared_fail.fd.
// Expected output:
// 2
// 0
// 2
struct Node { name: str, edges: Vec<i64> }

struct Graph { nodes: Vec<Node>, tags: Vec<i64> }

fn size(g: &Graph) -> i64 {
    return g.nodes.len();
}

fn count(t: &Vec<i64>) -> i64 {
    return t.len();
}

fn main() -> i64 {
    var g: Graph = Graph { nodes: Vec::new(), tags: Vec::new() };
    val ns: &mut Vec<Node> = &mut g.nodes;
    ns.push(Node { name: "x", edges: Vec::new() });
    val tags: i64 = count(&g.tags);
    ns.push(Node { name: "y", edges: Vec::new() });
    println(int_to_str(size(&g)));
    println(int_to_str(tags));
    println(int_to_str(g.nodes.len()));
    return 0;
}
