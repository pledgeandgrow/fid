// known-bugs 2g.71: a program that uses crypto builds with `fid emit` (the
// native backends) as it does through C and the interpreter. On a native
// build the runtime is merged into the program, and the @secret check took
// `v.push(x)` inside crypto_hmac_sha256 for a call of the runtime's
// `pe_wq_push(t)` (which writes a global) and rejected it. HMAC-SHA256 of
// RFC 4231 test case 2 (key "Jefe").
// Expected output:
// 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
// ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
use crypto;

fn main() {
    var mac: Vec<i64> = crypto_hmac_sha256("Jefe", "what do ya want for nothing?");
    println(crypto_sha256_hex(mac));
    println(crypto_sha256_hex_str("abc"));
}
