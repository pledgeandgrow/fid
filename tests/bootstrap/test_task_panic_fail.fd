// Expected to fail at run time (competitive RT15): a panic in a spawned
// task ends the whole program, on every backend, as one in main does: it
// prints "Panic: task failed" and the program exits with status 1; "after"
// is never printed.

fn work(x: i64) -> i64 {
    if x == 3 { panic("task failed"); }
    return x;
}

fn main() -> i64 {
    println("start");
    var t: Future<i64> = spawn work(3);
    var r: i64 = await t;
    println("after " + int_to_str(r));
    return 0;
}
