// BM3 (competitive roadmap): pidigits, the first 50 digits of pi folded
// into a 32-bit hash. bench/game/fides/pidigits.fd on a small input (the
// interpreter, which gives the suite's reference output, is slow on big
// integers: 300 digits take hours there), so the suite checks the
// benchmark's code (and stdlib/bigint.fd) on every backend; the expected
// value is bench/game/reference.py's
// (`python3 bench/game/reference.py pidigits 50`, Python integers).
//
// Expected output:
// 2190913643
use bigint;

fn pidigits(count: i64) -> i64 {
    var num: BigInt = bigint_one();
    var acc: BigInt = bigint_zero();
    var den: BigInt = bigint_one();
    var k: i64 = 0;
    var i: i64 = 0;
    var h: i64 = 0;
    while i < count {
        k = k + 1;
        val k2: i64 = 2 * k + 1;
        acc = bigint_mul_i64(bigint_add(acc, bigint_mul_i64(num, 2)), k2);
        den = bigint_mul_i64(den, k2);
        num = bigint_mul_i64(num, k);
        if bigint_gt(num, acc) {
            continue;
        }
        val d: i64 = bigint_to_i64(bigint_div(bigint_add(bigint_mul_i64(num, 3), acc), den));
        val d4: i64 = bigint_to_i64(bigint_div(bigint_add(bigint_mul_i64(num, 4), acc), den));
        if d != d4 {
            continue;
        }
        h = (h * 31 + d) & 4294967295;
        i = i + 1;
        acc = bigint_mul_i64(bigint_sub(acc, bigint_mul_i64(den, d)), 10);
        num = bigint_mul_i64(num, 10);
    }
    return h;
}

fn main() -> i64 {
    println(pidigits(50));
    return 0;
}
