// expect-error: function 'via_pipe' has inferred effect '!IO'
// Bugs roadmap BG295: `x |> f` is `f(x)` (reference §4.8), but a bare
// function name on the right of `|>` added none of f's effects: a `!{}`
// function printed through a pipe.
fn loud(x: i64) -> i64 {
    println("loud");
    return x;
}
fn via_pipe() -> i64 !{} {
    return 5 |> loud;
}
fn main() -> i64 {
    println(via_pipe());
    return 0;
}
