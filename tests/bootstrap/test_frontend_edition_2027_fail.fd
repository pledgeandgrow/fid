// expect-error: edition 2027 does not call deprecated functions
// ST3 (fid): edition 2027 (the next edition, a preview) turns the deprecation
// warning into an error, for this file only: a module in edition 2026 that it
// imports keeps the warning.
#[edition(2027)]

@deprecated(use = "three")
fn old_three() -> i64 {
    return 3;
}

fn three() -> i64 {
    return 3;
}

fn main() -> i64 {
    println(old_three());
    return 0;
}
