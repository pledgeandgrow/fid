// expect-error: is @no-indirect but calls the local 'f'
// Bugs roadmap BG152: @no-indirect flagged calls through function-typed
// parameters only; a call through a local function value was accepted.
@no-indirect
fn inc(x: i64) -> i64 {
    return x + 1;
}

@no-indirect
fn ni(n: i64) -> i64 {
    val f = inc;
    return f(n);
}

fn main() -> i64 {
    println(ni(3));
    return 0;
}
