// LG16 (fid): calling C++ itself. `@import("cppshim.hpp", trusted)` binds
// the header's C++ functions, classes and template instantiations through
// generated extern "C" shims (compiler/cparser.fd cpx_*): a free function
// of namespace shapes is shapes_<name> (an overload shapes_<name>_2), a
// class an opaque handle with shapes_<Class>_new / _delete / _<method> /
// _get_<field> / _set_<field>, `int&` a pointer, std::string a str, and an
// exception the error of cppshim_cpp_failed() / cppshim_cpp_error(). The
// shims and cppshim.cpp beside the header are compiled with the program
// by the link step: build it with `ccompile` and zig (CC="zig cc"); the
// interpreter (`run`) cannot call C++.
// Expected output:
// 42
// 2.5
// 42
// error: division by zero
// 3 failed=0
// hello fid
// 2.5
// 1001
// 7
// 10
// counter 10
// 1
// zero=0 empty=1
// failed=1 counter failed
// 4
// 4
// 9
@import("cppshim.hpp", trusted)

fn main() -> i64 {
    println(int_to_str(shapes_scale(6, 7) as i64));
    println(float_to_str(shapes_half(5.0)));
    var v: i32 = 41;
    shapes_bump(&mut v);
    println(int_to_str(v as i64));
    var q: i32 = shapes_checked_div(7, 0);
    if cppshim_cpp_failed() != 0 {
        println("error: " + cppshim_cpp_error());
    }
    println(int_to_str(shapes_checked_div(9, 3) as i64) + " failed=" + int_to_str(cppshim_cpp_failed() as i64));
    println(shapes_greet("fid"));
    println(float_to_str(shapes_twice_2(1.25)));
    println(int_to_str(shapes_from_cpp_file(1) as i64));
    var c: i64 = shapes_Counter_new(5);
    shapes_Counter_set_n(c, shapes_Counter_get_n(c) + 2);
    println(int_to_str(shapes_Counter_get(c) as i64));
    shapes_Counter_add(c, 3);
    println(int_to_str(shapes_Counter_get(c) as i64));
    println(shapes_Counter_label(c));
    var c2: i64 = shapes_Counter_new_2(0, 4);
    var zero_flag: i64 = 0;
    if shapes_Counter_is_zero(c2) {
        zero_flag = 1;
    }
    println(int_to_str(zero_flag));
    var empty_flag: i64 = 0;
    if q == 0 {
        empty_flag = 1;
    }
    println("zero=" + int_to_str(shapes_Counter_zero() as i64) + " empty=" + int_to_str(empty_flag));
    shapes_Counter_fail(c);
    println("failed=" + int_to_str(cppshim_cpp_failed() as i64) + " " + cppshim_cpp_error());
    shapes_Counter_delete(c);
    shapes_Counter_delete(c2);
    var sq: i64 = shapes_Square_new();
    println(int_to_str(shapes_count_sides(sq) as i64));
    println(int_to_str(shapes_Shape_sides(sq) as i64));
    shapes_Square_delete(sq);
    println(int_to_str(shapes_biggest_i32(3, 9) as i64));
    return 0;
}
