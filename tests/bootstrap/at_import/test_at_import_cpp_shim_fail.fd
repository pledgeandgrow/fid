// expect-error: undefined function 'shapes_Box_new'
// LG16 (fid): a C++ class template is not bound (a function template is,
// for the types named): the bindings note shapes::Box, and a call to a
// constructor of it is an undefined name.
@import("cppshim.hpp", trusted)

fn boxed() -> i64 {
    return shapes_Box_new();
}

fn main() -> i64 {
    println("unreachable");
    return 0;
}
