// LG15 (fid): a header's C-library functions link in a native build with no
// `link`: `@import("clibc.h", trusted)` binds strspn and strcspn (declared
// with glibc's attribute macros); `fid emit` imports them from msvcrt.dll on
// Windows (pe_ir, cparser.fd cparse_system_dll_of) and from libc.so.6 on
// Linux (nat_ir's dynamic imports). `fid ccompile` links them through the C
// compiler. Not for `fid run` (the interpreter calls only a few C
// functions).
// Expected output:
// strspn 3
// strcspn 2
@import("clibc.h", trusted)

fn main() -> i64 {
    println("strspn " + int_to_str(strspn("abcde", "cab") as i64));
    println("strcspn " + int_to_str(strcspn("xyz;w", ";z") as i64));
    return 0;
}
