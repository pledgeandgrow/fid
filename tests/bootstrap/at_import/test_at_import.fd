// LG15: `@import("cdemo.h")` imports a C header beside the program, as
// `use cdemo` does when there is no cdemo.fd: Fides bindings are generated
// from the header (compiler/cparser.fd). Nothing is called here (no C
// library defines these); the import resolving and type-checking is the test.
@import("cdemo.h")

fn main() -> i64 {
    println("import ok");
    return 0;
}
