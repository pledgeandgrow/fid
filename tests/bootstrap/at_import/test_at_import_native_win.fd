// LG15 (fid, Windows): `@import("cwinlib.h", trusted)` declares strspn (the
// C library's) and lstrlenA (kernel32's) with no library named; `fid emit`
// (pe_ir) imports strspn from msvcrt.dll and lstrlenA from kernel32.dll,
// the DLLs whose export tables have them (cparser.fd
// cparse_system_dll_of). `fid ccompile` links them through the C compiler.
// Not for `fid run` (the interpreter calls only a few C functions).
// Expected output:
// strspn 3
// lstrlenA 5
@import("cwinlib.h", trusted)

fn main() -> i64 {
    println("strspn " + int_to_str(strspn("abcde", "cab") as i64));
    println("lstrlenA " + int_to_str(lstrlenA("hello") as i64));
    return 0;
}
