// expect-error: undefined function 'geo_Shape_new'
// LG16 (fid): an abstract C++ class (one with a pure virtual method) gets
// no constructor shim: its methods and destructor are bound for a handle
// made elsewhere, and a call to geo_Shape_new is an undefined name. (Until
// the C++ shims, this test called geo_mangled, a function with C++
// linkage, which is now bound through a shim.)
@import("cppdemo.hpp", trusted)

fn make() -> i64 {
    return geo_Shape_new();
}

fn main() -> i64 {
    println("unreachable");
    return 0;
}
