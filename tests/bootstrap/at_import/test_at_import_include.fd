// LG15 (fid): `@import("cinc.h", trusted)` reads the headers cinc.h
// includes ("cinc_types.h", <cinc_sys_lg15.h> found beside it,
// "cinc_sub/cinc_leaf.h"; compiler/cparser.fd cp_include): their #define
// constants are bound, and so is cinc.h's `toupper`, declared with
// MSVC's and glibc's annotation macros (_Check_return_ _ACRTIMP ... _In_
// ... __THROW __wur) that nothing here defines. Without the include
// following CINC_LIMIT, CINC_SYS and CINC_LEAF are undefined; without the
// annotation words `toupper` is not bound. upper() is never called (the
// interpreter cannot run every C function): its type-checking and linking
// against the C library is the test. The other functions of cinc.h exist
// in no library and are not referenced.
// Expected output:
// limit 42
// sys 5
// leaf 7
// deep 1
@import("cinc.h", trusted)

fn upper(c: i32) -> i32 {
    return toupper(c);
}

fn main() -> i64 {
    println("limit " + int_to_str(CINC_LIMIT));
    println("sys " + int_to_str(CINC_SYS));
    println("leaf " + int_to_str(CINC_LEAF));
    println("deep " + int_to_str(CINC_DEEP));
    return 0;
}
