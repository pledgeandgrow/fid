// LG16 (fid): a C++ function template instantiated for the types the
// program names. cppshim.hpp has `template <typename T> T biggest(T, T)`;
// shapes_biggest_f64 is shapes::biggest<double>, shapes_biggest_str
// shapes::biggest<std::string> and shapes_biggest_i64
// shapes::biggest<long long> (the header itself names only <int>:
// shapes_biggest_i32). compiler/compiler.fd passes the program's source to
// the header import (cparse_header_file_for). Build with `ccompile` and zig
// (CC="zig cc").
// Expected output:
// 2.5
// pear
// 7000000000
// 9
@import("cppshim.hpp", trusted)

fn main() -> i64 {
    println(float_to_str(shapes_biggest_f64(2.5, 1.5)));
    println(shapes_biggest_str("apple", "pear"));
    println(int_to_str(shapes_biggest_i64(7000000000, 5)));
    println(int_to_str(shapes_biggest_i32(9, 3) as i64));
    return 0;
}
