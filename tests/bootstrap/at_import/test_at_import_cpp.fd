// LG16 (fid): C++ interop, first step. `@import("cppdemo.hpp", trusted)`
// binds the header's functions with C linkage (`extern "C" { }` and
// `extern "C" int f(..)`), a function of namespace geo as `geo_<name>` (its
// C symbol is the bare name); a class's methods and the functions with
// C++ linkage go through C++ shims (test_at_import_cpp_shim.fd calls them;
// test_at_import_cpp_fail.fd calls the constructor an abstract class does
// not have). Nothing is called here (the interpreter cannot call C): the
// import resolving and type-checking is the test.
// Expected output:
// cpp ok
@import("cppdemo.hpp", trusted)

fn measure() -> i32 {
    return geo_area(2, 3) + geo_perimeter(2, 3) + geo_volume(1, 2, 3) + geo_mangled(1);
}

fn sides(shape: i64) -> i32 {
    return geo_Shape_sides(shape) + geo_Shape_get_id(shape);
}

fn main() -> i64 {
    println("cpp ok");
    return 0;
}
