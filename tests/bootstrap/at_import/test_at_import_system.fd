// LG15 (fid): a system header. `@import("stdlib.h", trusted)` is not beside
// the program, so the import loop looks in FID_INCLUDE, C_INCLUDE_PATH,
// INCLUDE (MSVC's), /usr/local/include, /usr/include, /opt/homebrew/include;
// the C code then includes <stdlib.h> and calls its functions as it declares
// them (no prototype of ours: `int abs(int)` no longer clashes). Needs a C
// library's headers in one of those directories (not in the suite).
// Expected output:
// 5
@import("stdlib.h", trusted)

fn main() -> i64 {
    println(int_to_str(labs(0 - 5) as i64));
    return 0;
}
