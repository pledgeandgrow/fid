// LG15 (fid): `@import("cupper.h", trusted)`: the header's functions are
// called without `unsafe` (the program vouches for them; the same call from
// an untrusted import is test_at_import_untrusted_fail.fd). The header's
// `#ifdef __cplusplus` and `#if 0` branches are dropped (cparser.fd reads
// #if/#ifdef/#else/#endif), so only `toupper` is bound. upper() is never
// called: the build type-checking and linking is the test (the interpreter
// cannot run every C function).
// Expected output:
// trusted ok
@import("cupper.h", trusted)

fn upper(c: i32) -> i32 {
    return toupper(c);
}

fn main() -> i64 {
    println("trusted ok");
    return 0;
}
