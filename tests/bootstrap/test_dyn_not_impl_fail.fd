// expect-error: Other does not implement Shape
// LG4: `v as dyn Trait` needs v's type to implement Trait (it found no
// method at run time before: "Unknown function 'dyn_area'").
cap Shape {
    fn area(self) -> i64;
}

struct Sq { s: i64 }
struct Other { s: i64 }

impl Shape for Sq {
    fn area(self) -> i64 { return self.s; }
}

fn main() -> i64 {
    val o: Other = Other { s: 1 };
    val d = o as dyn Shape;
    println(d.area());
    return 0;
}
