// expect-error: Event error: 'log_payment' emits 'Transfer' without declaring it
// Roadmap Phase 9 (F34): a function that emits an event lists it with
// @emit(...), so the compiler knows every event each function can emit.
@event
fn Transfer(from: i64, to: i64, amount: i64) {}

fn log_payment(amount: i64) {
    Transfer(1, 2, amount);
}

fn main() -> i64 {
    log_payment(5);
    return 0;
}
