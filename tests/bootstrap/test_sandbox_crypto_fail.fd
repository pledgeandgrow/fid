// expect-error: Sandbox error: 'crypto_sha256_hex_str()' requires 'Crypto' capability
// Roadmap L4F: cryptography needs the Crypto capability, and all
// capabilities are revoked inside sandbox.
use crypto

fn main() -> i64 {
    sandbox {
        val h = crypto_sha256_hex_str("abc");
    }
    return 0;
}
