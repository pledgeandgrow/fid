// expect-error: is @no-indirect but calls the local 'g', a function value
// Bugs roadmap BG378: a local bound to a call's result that is a function
// value (`val g = mk();`) was not taken for one, so `g(x)` passed
// @no-indirect (BG152 recognised only a name, closure, field or index).
@no-indirect
fn inc(x: i64) -> i64 {
    return x + 1;
}
@no-indirect
fn mk() -> fn(i64) -> i64 {
    return inc;
}
@no-indirect
fn f(x: i64) -> i64 {
    val g = mk();
    return g(x);
}
fn main() {
    println(f(1));
}
