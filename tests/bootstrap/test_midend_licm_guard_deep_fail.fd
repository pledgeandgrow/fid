// OP9 (ME25 in part; compiler/iropt_me.fd ime_licm_guard with
// ime_guard_reaches, opt-in FID_IROPT_ON=licmguard): expected to fail at
// run time (division by zero), after printing "0" and "start". The
// division sits after an empty `if` in the loop's body; the first call
// runs the loop no time, so the guarded `t / k` is not made (no panic);
// the second runs it, and the division, moved out of the loop under the
// guard, panics where the first pass would have: after "start".

fn run(n: i64, a: i64, b: i64, t: i64, k: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if a < b {
        }
        acc = acc + t / k;
        i = i + 1;
    }
    return acc;
}

fn main() {
    println(run(0, 1, 2, 1, 0));
    print("start\n");
    println(run(2, 1, 2, 1, 0));
    print("unreachable\n");
}
