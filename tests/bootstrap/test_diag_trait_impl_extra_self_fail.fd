// expect-error: method 'unit' of impl Shape for Square takes self; the trait's method does not
// Expected to FAIL (CE4): the impl's method may not take self when the
// cap's does not (TypeChecker_check_impl_sig).
cap Shape {
    fn unit() -> i64;
}

struct Square {
    side: i64,
}

impl Shape for Square {
    fn unit(self) -> i64 {
        return self.side;
    }
}

fn main() -> i64 {
    val s: Square = Square { side: 2 };
    println(s.side);
    return 0;
}
