// expect-error: is @no-indirect but calls the local 'g'
// Bugs roadmap BG152: @safety-critical (which includes no-indirect)
// accepted a call through a function value read from a struct field.
struct S {
    f: fn(i64) -> i64,
}

@safety-critical
fn inc(x: i64) -> i64 {
    return x;
}

@safety-critical
fn ni(s: S, n: i64) -> i64 {
    val g = s.f;
    return g(n);
}

fn main() -> i64 {
    val s = S { f: inc };
    println(ni(s, 3));
    return 0;
}
