// Bugs roadmap BG490: a generic call whose argument is a method call took
// the type parameter from the method's receiver, not its result. mono
// (compiler/mono.fd infer_expr_type) typed `q.len()` with `q: Vec<str>` as
// a Vec<str>, so `same(0, q.len())` was instantiated as `same__Vec__str`
// (the 0 and the length compared as two vectors: right only while both
// words happened to compare equal, a crash otherwise). A method with a
// known result now gives that result (mono_known_method_ret): a Vec or
// HashMap `len` an i64, `is_empty`/`contains` a bool, a non-generic impl's
// method its declared result.
//
// Expected output:
// true
// true
// false
// true
// true
// 2
// true
// 4

fn same<T>(a: T, b: T) -> bool {
    return a == b;
}

fn pick<T>(a: T, b: T) -> T {
    return b;
}

fn show(b: bool) {
    if b {
        println("true");
    } else {
        println("false");
    }
}

struct Bag {
    n: i64,
}

impl Bag {
    fn count(self) -> i64 {
        return self.n;
    }
}

fn main() -> i64 {
    var q: Vec<str> = Vec::new();
    show(same(0, q.len()));
    q.push("a");
    q.push("b");
    show(same(2, q.len()));
    show(same(3, q.len()));
    show(same(false, q.is_empty()));
    show(same(true, q.contains("a")));
    println(pick(0, q.len()));
    val b: Bag = Bag { n: 4 };
    show(same(4, b.count()));
    println(pick(0, b.count()));
    return 0;
}
