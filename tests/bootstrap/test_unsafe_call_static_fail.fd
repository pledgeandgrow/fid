// expect-error: calling the @unsafe function Volatile::new() needs an `unsafe` block
// Release M10: stdlib/volatile's Volatile::new is @unsafe (every load and
// store of the Volatile goes to the address it is given, which only the
// caller can vouch for), so an associated-function call `Volatile::new(a)`
// needs an `unsafe` block or an @unsafe caller. Here the address is made up
// (0x1000) and the call is in safe code: rejected at compile time
// (test_unsafe_call_ok.fd: the call inside `unsafe` is accepted).
use volatile;

fn main() -> i64 {
    val v: Volatile = Volatile::new(4096);
    println(v.load());
    return 0;
}
