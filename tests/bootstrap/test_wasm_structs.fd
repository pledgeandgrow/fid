// Test: structs by value through the WebAssembly backend (release F9):
// copies, nested structs, struct parameters and results, enums.

struct Point { x: i64, y: i64 }
struct Rect { min: Point, max: Point, name: str }

enum Shape {
    Circle(i64),
    Square(i64),
    Empty,
}

fn add(a: Point, b: Point) -> Point {
    return Point { x: a.x + b.x, y: a.y + b.y };
}

fn area(r: Rect) -> i64 {
    return (r.max.x - r.min.x) * (r.max.y - r.min.y);
}

fn grow(r: Rect, by: i64) -> Rect {
    var out: Rect = r;
    out.max = Point { x: r.max.x + by, y: r.max.y + by };
    out.name = r.name + "+";
    return out;
}

fn shape_size(s: Shape) -> i64 {
    match s {
        Shape::Circle(rad) => { return 3 * rad * rad; }
        Shape::Square(side) => { return side * side; }
        Shape::Empty => { return 0; }
    }
    return 0 - 1;
}

fn main() {
    var p: Point = Point { x: 1, y: 2 };
    var q: Point = p;
    q.x = 10;
    print(p.x);
    print(" ");
    print(q.x);
    print("\n");
    val s = add(p, q);
    print(s.x);
    print(" ");
    print(s.y);
    print("\n");
    var r: Rect = Rect { min: Point { x: 0, y: 0 }, max: Point { x: 3, y: 4 }, name: "r" };
    print(area(r));
    print("\n");
    val r2 = grow(r, 2);
    print(area(r2));
    print(" ");
    print(r2.name);
    print(" ");
    print(area(r));
    print(" ");
    print(r.name);
    print("\n");
    print(shape_size(Shape::Circle(2)));
    print(" ");
    print(shape_size(Shape::Square(5)));
    print(" ");
    print(shape_size(Shape::Empty));
    print("\n");
}
