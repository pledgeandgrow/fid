// L8A: a const generic parameter on a struct. `struct Matrix<T, const N:
// usize>` takes a number as its second argument (`Matrix<i64, 3>`); a
// function generic over N (`fn trace<N: i64>(m: Matrix<i64, N>)`) gets N
// from the argument's type and is instantiated once per size, with N a
// constant in its body; a result type `Matrix<i64, N>` takes N from the
// declared type it is assigned to. Matrix<i64, 3> and Matrix<i64, 2> are
// two instantiations here, and Matrix<i64, 4> a third.
//
// Expected output:
// 3 15
// 2 30
// a*2 3 30
// id4 4 4 16
// 9 4

struct Matrix<T, const N: usize> {
    data: Vec<T>,
    tag: str,
}

fn dim<N: i64>(m: Matrix<i64, N>) -> i64 {
    return N;
}

fn trace<const N: usize>(m: Matrix<i64, N>) -> i64 {
    var s: i64 = 0;
    for i in 0..N {
        s = s + m.data.get(i * N + i);
    }
    return s;
}

fn scale<N: i64>(m: Matrix<i64, N>, k: i64) -> Matrix<i64, N> {
    var d: Vec<i64> = Vec::new();
    for i in 0..N * N {
        d.push(m.data.get(i) * k);
    }
    val r: Matrix<i64, N> = Matrix { data: d, tag: m.tag + "*" + int_to_str(k) };
    return r;
}

fn identity<N: i64>(tag: str) -> Matrix<i64, N> {
    var d: Vec<i64> = Vec::new();
    for i in 0..N {
        for j in 0..N {
            if i == j {
                d.push(1);
            } else {
                d.push(0);
            }
        }
    }
    val r: Matrix<i64, N> = Matrix { data: d, tag: tag };
    return r;
}

fn cells<N: i64>(m: Matrix<i64, N>) -> i64 {
    return N * N;
}

fn main() -> i64 {
    var v3: Vec<i64> = Vec::new();
    for i in 0..9 {
        v3.push(i + 1);
    }
    val a: Matrix<i64, 3> = Matrix { data: v3, tag: "a" };
    var v2: Vec<i64> = Vec::new();
    for i in 0..4 {
        v2.push(i * 10);
    }
    val b: Matrix<i64, 2> = Matrix { data: v2, tag: "b" };
    println(int_to_str(dim(a)) + " " + int_to_str(trace(a)));
    println(int_to_str(dim(b)) + " " + int_to_str(trace(b)));
    val c: Matrix<i64, 3> = scale(a, 2);
    println(c.tag + " " + int_to_str(dim(c)) + " " + int_to_str(trace(c)));
    val e: Matrix<i64, 4> = identity("id4");
    println(e.tag + " " + int_to_str(dim(e)) + " " + int_to_str(trace(e)) + " " + int_to_str(e.data.len()));
    println(int_to_str(cells(a)) + " " + int_to_str(cells(b)));
    return 0;
}
