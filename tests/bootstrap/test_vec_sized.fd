// Release D14: a Vec of small integers or bools keeps its elements at their
// size (a Vec<u8> takes one byte per element). Every operation must give
// the same results as with one word per element; this test runs the same
// on every backend (test_vec_sized_layout checks the layout itself).
//
// Expected output:
// 5 255 0 128
// 1 2 255 3
// -1 -128 127
// 65535 -32768
// 4000000000 -2000000000
// true false true
// [3, 1, 2]
// [1, 2, 3]
// 9 7 5
// 2 1
// 7 8 9 10
// 10000 2550000
// [10, 30]

fn main() -> i64 {
    var b: Vec<u8> = Vec::new();
    b.push(5);
    b.push(255);
    b.push(0);
    b.push(128);
    println(int_to_str(b.get(0) as i64) + " " + int_to_str(b.get(1) as i64) + " " + int_to_str(b.get(2) as i64) + " " + int_to_str(b.get(3) as i64));
    b.set(0, 1);
    b.set(2, 3);
    b.insert(1, 2);
    b.remove(4);
    var line: str = "";
    var i: i64 = 0;
    while i < b.len() {
        if i > 0 { line = line + " "; }
        line = line + int_to_str(b.get(i) as i64);
        i = i + 1;
    }
    println(line);

    var s: Vec<i8> = Vec::new();
    s.push(-1);
    s.push(-128);
    s.push(127);
    println(int_to_str(s.get(0) as i64) + " " + int_to_str(s.get(1) as i64) + " " + int_to_str(s.get(2) as i64));

    var h: Vec<u16> = Vec::new();
    h.push(65535);
    var hs: Vec<i16> = Vec::new();
    hs.push(-32768);
    println(int_to_str(h.get(0) as i64) + " " + int_to_str(hs.get(0) as i64));

    var w: Vec<u32> = Vec::new();
    w.push(4000000000);
    var ws: Vec<i32> = Vec::new();
    ws.push(-2000000000);
    println(int_to_str(w.get(0) as i64) + " " + int_to_str(ws.get(0) as i64));

    var f: Vec<bool> = Vec::new();
    f.push(true);
    f.push(false);
    f.push(true);
    println(bool_to_str(f.get(0)) + " " + bool_to_str(f.get(1)) + " " + bool_to_str(f.get(2)));

    var t: Vec<u8> = Vec::new();
    t.push(3);
    t.push(1);
    t.push(2);
    println(t);
    t.sort();
    println(t);
    t.reverse();
    var sum: Vec<i32> = Vec::new();
    sum.push(9);
    sum.push(7);
    sum.push(5);
    println(int_to_str(sum.get(0) as i64) + " " + int_to_str(sum.get(1) as i64) + " " + int_to_str(sum.get(2) as i64));
    println(int_to_str(t.get(1) as i64) + " " + int_to_str(t.get(2) as i64));

    // for-in and indexing
    var x: Vec<u8> = Vec::new();
    x.push(7);
    x.push(8);
    x.push(9);
    x.push(10);
    var out: str = "";
    for e in x {
        if out != "" { out = out + " "; }
        out = out + int_to_str(e as i64);
    }
    println(out);

    // many elements
    var big: Vec<u8> = Vec::new();
    var k: i64 = 0;
    while k < 10000 {
        big.push(255);
        k = k + 1;
    }
    var total: i64 = 0;
    k = 0;
    while k < big.len() {
        total = total + (big[k] as i64);
        k = k + 1;
    }
    println(int_to_str(big.len()) + " " + int_to_str(total));

    var cl: Vec<u16> = Vec::new();
    cl.push(10);
    cl.push(30);
    var cl2: Vec<u16> = cl.clone();
    println(cl2);
    return 0;
}

fn bool_to_str(v: bool) -> str {
    if v { return "true"; }
    return "false";
}
