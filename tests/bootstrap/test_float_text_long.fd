// Floats that need more digits than 2^53 holds, printed as the shortest
// text that reads back as the number (as the interpreter and the C runtime
// print them). The native runtime (stdlib/linux_runtime/base.fd
// pert_to_str_float) found the fewest fraction digits with integer
// arithmetic only while the scaled value stayed below 2^53, then printed
// the digits it had: 1.00000011920929 for an f32 widened to f64, which does
// not read back as the number. These go through its exact path
// (pe_float_text_exact: Steele & White / Burger & Dybvig over integers):
// 17 significant digits, a number below 10^-18, a fraction past 2^51.
// pe_ir (the default Windows `emit`) still keeps the bits on an f32 <->
// f64 cast (known-bugs 2g.13), so this file names its backends, as
// test_machine_fregs does; the machine layer's lanes (cross-test.sh
// NATIVE=1) run it.
//@ backends: run,ccompile
// Expected output:
// 1.0000001192092896
// 0.10000000149011612
// 0.30000000000000004
// 0.0000000000000000008673617379884035
// 2251799813685247.8
// 3.3333332538604736
// 0.3333333333333333
// -0.30000000000000004
// 0.5 0.25 1.5

fn main() {
    val one: f32 = 1.0 as f32;
    val tiny: f32 = 0.00000011920928955078125 as f32;
    println(float_to_str((one + tiny) as f64));
    val tenth: f32 = 0.1 as f32;
    println(float_to_str(tenth as f64));
    println(float_to_str(0.1 + 0.2));
    var p: f64 = 1.0;
    var i: i64 = 0;
    while i < 60 {
        p = p * 0.5;
        i = i + 1;
    }
    println(float_to_str(p));
    val big: f64 = 9007199254740991.0 / 4.0;
    println(float_to_str(big));
    var third: f32 = 10.0 as f32;
    third = third / (3.0 as f32);
    println(float_to_str(third as f64));
    println(float_to_str(1.0 / 3.0));
    println(float_to_str(0.0 - (0.1 + 0.2)));
    println(float_to_str(0.5) + " " + float_to_str(0.25) + " " + float_to_str(1.5));
}
