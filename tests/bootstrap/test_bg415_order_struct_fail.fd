// expect-error: cannot order two values of struct 'P' with `>`: only `==` and `!=` are defined for a struct or an enum
// Bugs roadmap BG415: `>` on two values of one struct ordered their heap
// addresses (`fid run` and pe_ir disagreed).
struct P { x: i64 }
fn main() {
    val a = P { x: 5 };
    val b = P { x: 2 };
    println(a > b);
}
