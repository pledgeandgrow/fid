// expect-error: function 'count' is @no-recursion but can call itself again through a method call
// Bugs roadmap BG59: the @no-recursion check built its call graph from
// names, and `t.walk(n)` names no function: `count` -> Tree.walk -> `count`
// was not seen as a cycle.
struct Tree {
    depth: i64,
}

impl Tree {
    fn walk(self: Tree, n: i64) -> i64 {
        if n <= 0 {
            return 0;
        }
        return 1 + count(self, n - 1);
    }
}

@no-recursion
fn count(t: Tree, n: i64) -> i64 {
    return t.walk(n);
}

fn main() -> i64 {
    println(int_to_str(count(Tree { depth: 1 }, 3)));
    return 0;
}
