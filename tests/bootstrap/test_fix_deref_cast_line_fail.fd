// expect-error: Type error (line 9): cannot dereference non-reference type f64
// Test (stdlib-agent bugs 5/41): `as` is a postfix operator and binds
// tighter than a prefix `*` (reference §4.1), so `*s as f64` is
// `*(s as f64)`: an error, by design. The error had no line; it now names
// the line and says to write `(*s) as f64`.
// (test_fix_deref_cast.fd has the parenthesized form.)
fn half(s: & i64) -> f64 {
    val two: f64 = 2.0;
    return *s as f64 / two;
}

fn main() {
    val x: i64 = 5;
    println(float_to_str(half(& x)));
}
