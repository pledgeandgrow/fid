// BG27 (bugs roadmap): `inline for` replaces its loop variable in every
// expression form of the body (f-strings, match, tuples, closures, ...),
// and not after the body declares the name again
// (compiler/comptime_eval.fd replace_ident_in_stmts). Before, an f-string
// and a match kept reading the outer `i` (100), and a `val i` in the body
// was read as the loop's literal.
// Expected output:
// i=0
// i=1
// i=2
// zero
// one
// 1 10
// 2 20
// 11
// 12
// 7
// 7

fn main() -> i64 {
    val i = 100;
    inline for i in 0..3 {
        println(f"i={i}");
    }
    inline for i in 0..2 {
        match i {
            0 => {
                println("zero");
            }
            _ => {
                println("one");
            }
        }
    }
    inline for i in 1..3 {
        val (a, b) = (i, i * 10);
        println(int_to_str(a) + " " + int_to_str(b));
    }
    inline for i in 1..3 {
        val f = fn(x: i64) -> i64 => x + i;
        println(int_to_str(f(10)));
    }
    inline for i in 0..2 {
        val i = 7;
        println(int_to_str(i));
    }
    return 0;
}
