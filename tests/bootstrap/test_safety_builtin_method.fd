// A safety-annotated function may call a builtin method whose name a user
// type also has: `v.len()` on a Vec is the builtin, not Ring_len (the check
// guessed by name and rejected stdlib/scada.fd's `data.len()` once core's
// StringBuilder had a `len` method). A call of the user method itself is
// still held to the rules (test_crashfree_method_fail.fd).
//
// Expected output:
// 2
// 7
// builtin method OK

struct Ring { n: i64 }

impl Ring {
    fn len(self: Ring) -> i64 {
        return self.n;
    }
}

@crashfree
fn count(v: Vec<i64>) -> i64 {
    return v.len();
}

@no-alloc
fn empty(v: Vec<i64>) -> bool {
    return v.is_empty();
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(3);
    v.push(4);
    val r = Ring { n: 7 };
    println(count(v));
    println(r.len());
    if !empty(v) {
        println("builtin method OK");
    }
}
