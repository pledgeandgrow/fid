// Test (stdlib-agent bugs 15/33/39/48): the result of a call through a
// function value holds a reference only if the fn type's declared result
// can hold one. Calling `f: fn(&S) -> i64` with a reference argument gives
// an i64, which may go to any parameter.
// Expected output:
// 42
// true
// 5
// 9
// 3
// ok 7!
struct S { a: i64 }

fn g(s: &S) -> i64 { return s.a + 1; }

fn runr(s: &S, f: fn(&S) -> i64) -> i64 { return f(s); }

fn fa(q: i64, r: &mut i64) -> bool { *r = q; return q > 0; }

fn b2s(b: bool) -> str {
    if b {
        return "true";
    }
    return "false";
}

fn run2(q: i64, f: fn(i64, &mut i64) -> bool) -> str {
    var r: i64 = 0;
    val ok: bool = f(q, &mut r);
    return b2s(ok);
}

fn add(n: i64, b: &mut i64) -> i64 {
    *b = *b + n;
    return *b;
}

fn label(s: &S) -> str { return "ok " + int_to_str(s.a); }

fn name_of(s: &S, f: fn(&S) -> str) -> str { return f(s); }

fn shout(x: str) -> str { return x + "!"; }

fn main() {
    val s: S = S { a: 41 };
    println(int_to_str(runr(&s, g)));
    println(run2(3, fa));
    val a: fn(i64, &mut i64) -> i64 = add;
    var b: i64 = 1;
    val r: i64 = a(4, &mut b);
    println(int_to_str(r));
    val a2 = add;
    println(int_to_str(a2(4, &mut b)));
    var c: i64 = 0;
    val h = fn(x: &mut i64) -> i64 { *x = 3; return *x; };
    println(int_to_str(h(&mut c)));
    val t: S = S { a: 7 };
    println(shout(name_of(&t, label)));
}
