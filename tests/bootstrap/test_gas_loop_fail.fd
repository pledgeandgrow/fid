// expect-error: Gas error: function 'sum_to_100' has @gas(50) but total gas cost is
// Test: @gas counts the trips of a loop with literal bounds (release L1:
// a loop's body was counted once whatever its bounds).

@gas(50)
fn sum_to_100() -> i64 {
    var total: i64 = 0;
    for i in 0..100 {
        total = total + i;
    }
    return total;
}

fn main() {
    println(sum_to_100());
}
