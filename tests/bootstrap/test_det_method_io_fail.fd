// expect-error: function 'Meter.read' is @deterministic but has effect '!IO'
// Bugs roadmap BG22: @deterministic (and @realtime, declared effects) were
// verified on free functions only: a method marked @deterministic that
// prints was accepted.
struct Meter {
    v: i64,
}

impl Meter {
    @deterministic fn read(self: Meter) -> i64 {
        println("reading");
        return self.v;
    }
}

fn main() -> i64 {
    val m: Meter = Meter { v: 4 };
    println(int_to_str(m.read()));
    return 0;
}
