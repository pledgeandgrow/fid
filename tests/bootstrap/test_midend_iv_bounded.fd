// OP10 (compiler/iropt.fd iro_iv_loop, checks.fd iro_iv_bounded; pass
// `iv`, on, on the native paths; FID_IROPT_OFF=ivbound keeps it to
// @wrapping code): strength reduction outside @wrapping functions. In a
// loop whose test bounds the induction variable by a constant (`i < 100`,
// `i <= 64`, `i > 0`, either branch order) and whose entry value is a
// constant, `i * c` becomes a second variable stepped by `c * step`:
// no value of it can overflow, so it traps nowhere the multiply did not.
// Every result must be what the multiplies compute.
//
// Expected output:
// 34650
// 3825
// -9880
// 2080
// 405
// 4950 9900 14850

fn up() -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 100 {
        t = t + i * 7;
        i = i + 1;
    }
    return t;
}

fn down() -> i64 {
    var t: i64 = 0;
    var i: i64 = 50;
    while i > 0 {
        t = t + i * 3;
        i = i - 1;
    }
    return t;
}

fn negative() -> i64 {
    // a negative factor, step 2
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 40 {
        t = t + i * (0 - 26);
        i = i + 2;
    }
    return t;
}

fn inclusive() -> i64 {
    var t: i64 = 0;
    var i: i64 = 1;
    while i <= 64 {
        t = t + 1 * i;
        i = i + 1;
    }
    return t;
}

fn until() -> i64 {
    // the loop goes on while the test is false
    var t: i64 = 0;
    var i: i64 = 0;
    while !(i >= 30) {
        t = t + i * 4 - i;
        i = i + 3;
    }
    return t;
}

fn several() -> str {
    var a: i64 = 0;
    var b: i64 = 0;
    var c: i64 = 0;
    var i: i64 = 0;
    while i < 100 {
        a = a + i;
        b = b + i * 2;
        c = c + 3 * i;
        i = i + 1;
    }
    return int_to_str(a) + " " + int_to_str(b) + " " + int_to_str(c);
}

fn main() {
    println(up());
    println(down());
    println(negative());
    println(inclusive());
    println(until());
    println(several());
}
