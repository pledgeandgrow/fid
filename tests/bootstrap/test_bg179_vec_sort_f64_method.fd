// Bugs roadmap BG179: `.sort()` on a Vec<f64> went to core Vec_sort, which
// compares the words as i64 and runs negative doubles backwards
// ([-1.5, -2.5, 1.0, -0.5] came out -0.5 -1.5 -2.5 1). A Vec<f64> has a
// Vec<i64>'s element code, so the lowering picks Vec_sort_f64 by the
// receiver's type (lower.fd method-call lowering, after
// Lowerer_mangle_method); see test_std_vec_sort_f64.fd for the function.
//
// Expected output:
// -2.5 -1.5 -0.5 1
// -3 0.5 2
// ints 1 2 3

fn show(v: Vec<f64>) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 {
            out = out + " ";
        }
        out = out + float_to_str(v.get(i));
        i = i + 1;
    }
    return out;
}

fn sort_it(v: & mut Vec<f64>) {
    v.sort();
}

fn main() {
    var a: Vec<f64> = Vec::new();
    a.push(-1.5);
    a.push(-2.5);
    a.push(1.0);
    a.push(-0.5);
    a.sort();
    println(show(a));

    var b: Vec<f64> = Vec::new();
    b.push(2.0);
    b.push(-3.0);
    b.push(0.5);
    sort_it(& mut b);
    println(show(b));

    var e: Vec<i64> = Vec::new();
    e.push(3);
    e.push(1);
    e.push(2);
    e.sort();
    println("ints " + int_to_str(e.get(0)) + " " + int_to_str(e.get(1)) + " " + int_to_str(e.get(2)));
}
