// L3B: Structured concurrency — spawn scope
// All spawn expressions inside are joined at scope exit

fn task(n: i64) -> i64 {
    println(n);
    n * 2
}

fn main() {
    spawn scope {
        spawn task(1);
        spawn task(2);
        spawn task(3);
        // All tasks joined here
    }
    println(99);
}
