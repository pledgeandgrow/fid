// L3B: Structured concurrency — spawn scope
// All spawn expressions inside are joined at scope exit: after the scope,
// every task has run. (The tasks run at the same time, so they do not
// print: the order of their lines would differ from run to run.)

fn task(total: i64, n: i64) -> i64 {
    p_atomic_add(total, n);
    n * 2
}

fn main() {
    val total = p_shared_alloc(8);
    p_atomic_store(total, 0);
    spawn scope {
        spawn task(total, 1);
        spawn task(total, 2);
        spawn task(total, 3);
        // All tasks joined here
    }
    println(p_atomic_load(total));
    println(99);
}
