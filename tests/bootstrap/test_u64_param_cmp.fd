// Test: a u64 parameter compares unsigned on every backend (natively it
// was compared signed: a parameter has no instruction, so its type was not
// found and taken for i64).
//
// Expected output:
// max > 1: true
// max < 1: false
// 1 < max: true
fn gt(x: u64, y: u64) -> bool { return x > y; }
fn lt(x: u64, y: u64) -> bool { return x < y; }

fn main() -> i64 {
    val max: u64 = 18446744073709551615;
    val one: u64 = 1;
    if gt(max, one) { println("max > 1: true"); } else { println("max > 1: false"); }
    if lt(max, one) { println("max < 1: true"); } else { println("max < 1: false"); }
    if lt(one, max) { println("1 < max: true"); } else { println("1 < max: false"); }
    return 0;
}
