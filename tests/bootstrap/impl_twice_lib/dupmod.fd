// Helper of test_impl_twice_module_fail.fd: one module with two
// `impl Show for P` blocks. The program's own duplicates are caught as
// "defined twice in this program"; a module's pair is the "in module"
// message (compiler.fd cc_find_trait_impl_conflicts, BG218).
module dupmod;

cap Show {
    fn show(self) -> str;
}

pub struct P {
    v: i64,
}

impl Show for P {
    fn show(self) -> str {
        return "first";
    }
}

impl Show for P {
    fn show(self) -> str {
        return "second";
    }
}
