enum Color {
    Red(i64),
    Green(i64),
    Blue(i64),
}

fn test_match(x: Color) -> i64 {
    match x {
        Color::Red(v) => { return v + 1; }
        Color::Green(v) => { return v + 2; }
        Color::Blue(v) => { return v + 3; }
    }
    return 0;
}

fn main() -> i64 {
    var c: Color = Color::Red(10);
    return test_match(c);
}
