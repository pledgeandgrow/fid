// L3E: Cancellation — scope-based and cooperative
// cancel scope; cancels all pending tasks in the current spawn scope
// do Cancel.stop() — cooperative cancellation via effect handler

// Silent: two tasks really run at once, so their output has no fixed order
fn long_task(n: i64) -> i64 {
    return n * 2;
}

fn main() {
    // Scope-based cancellation
    spawn scope {
        spawn long_task(1);
        spawn long_task(2);
        // Cancel all pending tasks
        cancel scope;
    }
    println(99);

    // Cooperative cancellation via effect handler
    handle {
        do Cancel.stop();
        // This should NOT run if handler doesn't resume
        println(888);
    } with {
        Cancel.stop() => {
            println(777);
            // No resume — continuation skipped
        }
    }
    println(100);
}
