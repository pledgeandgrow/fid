// Expected to fail at run time (known bug 2g.60): `task_go` with the name
// of a function the program does not have is a panic on every backend.
// The C runtime (__p_co_new) prints "task: no such function"; `fid run`
// printed "Executor: unknown function 'wroker'", went on, printed 0 and
// exited with status 0. Now it panics too:
//     Panic: task: no such function 'wroker'
// and the program exits with status 1; "after" is never printed.

use task;

fn worker(n: i64) -> i64 {
    return n * 2;
}

fn main() -> i64 {
    println("start");
    val t = task_go("wroker", 21);
    task_run();
    println(task_result(t));
    println("after");
    return 0;
}
