// BG201 (docs/roadmap/bugs-roadmap.md): `& | ^ << >>` and their compound
// forms still work on integers of every width.
//
// Expected output:
// 2
// 16
// 7
// 3
// -1
// 256
fn main() -> i64 {
    println(6 & 3);
    println(1 << 4);
    var x = 5;
    x |= 2;
    println(x);
    var y = 7;
    y &= 3;
    println(y);
    var z = 12;
    z ^= -1;
    println(z);
    var w = 1;
    w <<= 8;
    println(w);
    return 0;
}
