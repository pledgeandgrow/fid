// expect-error: function 'np' uses '%'
// Bugs roadmap BG150: `x %= b` under @crashfree (which includes no-panic)
// was accepted and panicked "Modulo by zero".
@crashfree
fn np(a: i64, b: i64) -> i64 {
    var x: i64 = a;
    x %= b;
    return x;
}

fn main() -> i64 {
    println(np(3, 2));
    return 0;
}
