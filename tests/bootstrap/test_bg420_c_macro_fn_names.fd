// BG420 (docs/roadmap/bugs-roadmap.md), C backend: a user function named
// like a function-like macro of the C headers (math.h's isnan, isinf,
// signbit, isgreaterequal; ctype.h's isblank) was expanded by the macro
// ("too many arguments provided to function-like macro invocation").
// codegen_c.fd cg_libc_clash renames them.
//
// Expected output:
// true false
// false true
// 7 true
// 3
fn isnan(x: f64, tag: i64) -> bool {
    return x != x && tag > 0;
}
fn isinf(x: f64, tag: i64) -> bool {
    return x > 1.0e308 && tag > 0;
}
fn signbit(a: i64, b: i64) -> i64 {
    return a + b;
}
fn isgreaterequal(a: i64, b: i64) -> bool {
    return a >= b;
}
fn isblank(a: i64, b: i64, c: i64) -> i64 {
    return a + b + c;
}
fn main() {
    val z: f64 = 0.0;
    val n = z / z;
    println(f"{isnan(n, 1)} {isnan(1.5, 1)}");
    println(f"{isinf(1.5, 1)} {isinf(1.0e308 * 10.0, 1)}");
    println(f"{signbit(3, 4)} {isgreaterequal(5, 5)}");
    println(f"{isblank(1, 1, 1)}");
}
