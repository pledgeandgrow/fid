// A `parallel` branch of several statements that reads more than 8 outer
// locals: it was lifted into a function with one parameter per local, but
// every runtime's task block holds 8 argument words, so the ninth was
// lost. Such a branch runs in place now, as an assigning branch does
// (lower.fd Lowerer_lift_parallel_branch). Only one branch prints.
//
// Expected output:
// sum 45
// 6765

fn fib(n: i64) -> i64 {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn main() {
    val a1: i64 = 1;
    val a2: i64 = 2;
    val a3: i64 = 3;
    val a4: i64 = 4;
    val a5: i64 = 5;
    val a6: i64 = 6;
    val a7: i64 = 7;
    val a8: i64 = 8;
    val a9: i64 = 9;
    var f: i64 = 0;
    parallel {
        | f = fib(20);
        | val s: i64 = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9;
          println("sum " + int_to_str(s));
    }
    println(f);
}
