// tests/bootstrap/test_attribute_tests.fd — L4J: #[test] attribute execution
//
// Tests that #[test] functions are discovered and executed by `fidesc test`.
// Also tests #[should_panic] and #[ignore] attributes.

#[test]
fn test_addition() {
    val x = 1 + 2;
    assert_eq(x, 3);
}

#[test]
fn test_string_len() {
    val s = "hello";
    val n = str_len(s);
    assert_eq(n, 5);
}

#[test]
fn test_assert_ne() {
    val a = 5;
    val b = 10;
    assert_ne(a, b);
}

#[test]
#[should_panic]
fn test_should_panic() {
    panic("expected panic");
}

#[test]
#[ignore]
fn test_ignored() {
    panic("should never run");
}

fn main() {
    print("=== Attribute Tests ===\n");
    print("test_addition\n");
    test_addition();
    print("test_string_len\n");
    test_string_len();
    print("test_assert_ne\n");
    test_assert_ne();
    print("\n=== All Attribute Tests Passed ===\n");
}
