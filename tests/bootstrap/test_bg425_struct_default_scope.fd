// Bugs roadmap BG425: a struct field default was resolved where the literal
// is written: `Cfg { .. }` in a function with a local `PORT` took the local
// for `port: i64 = PORT` (reference §2.2: the default is the struct's).
//
// Expected output:
// 8080 srv
// 8080 7
// 2 9000
var PORT: i64 = 8080;
fn base() -> i64 {
    return 7;
}
struct Cfg {
    port: i64 = PORT,
    name: str = "srv",
    tries: i64 = base(),
}
fn mk() -> Cfg {
    val PORT = 1;
    return Cfg { .. };
}
fn mk2(base: i64) -> Cfg {
    return Cfg { name: "x", .. };
}
fn mk3() -> Cfg {
    val PORT = 2;
    return Cfg { port: PORT, tries: 9000, .. };
}
fn main() {
    val c = mk();
    println(f"{c.port} {c.name}");
    val d = mk2(3);
    println(f"{d.port} {d.tries}");
    val e = mk3();
    println(f"{e.port} {e.tries}");
}
