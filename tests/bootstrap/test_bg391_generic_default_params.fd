// Bugs roadmap BG391: default parameter values of a generic function were
// dropped at monomorphization, so `idd(1)` passed 0 for `k` and named
// arguments to a generic function got 0 for the defaulted ones.
//
// Expected output:
// 3
// 9
// 48
// 25
// 45
fn idd<T>(x: T, k: i64 = 3) -> i64 {
    return k;
}
fn gsum<T>(a: T, b: i64 = 4, c: i64 = 5) -> i64 {
    return b * 10 + c;
}
fn main() {
    println(idd(1));
    println(idd(1, 9));
    println(gsum(1, c: 8));
    println(gsum("x", b: 2));
    println(gsum(2.5));
}
