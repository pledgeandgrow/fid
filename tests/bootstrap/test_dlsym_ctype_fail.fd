// Roadmap L6C: a looked-up symbol is a C function, so the function type it
// is given must use C types (integers, floats, bool, str, raw pointers).
use core with { FS, IO }

fn main() -> i64 {
    val lib = p_dl_open("libm.so.6");
    val f: fn(Vec<i64>) -> i64 = p_dl_sym(lib, "sum");
    return 0;
}
