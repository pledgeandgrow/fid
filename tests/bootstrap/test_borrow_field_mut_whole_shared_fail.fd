// expect-error: cannot create &g: a mutable borrow is already active on it or a related path
// Expected to FAIL (E080, reference section 8.4): `ns` holds `&mut g.nodes`
// and is used again after `size(&g)`, so the shared borrow of the whole
// `g` overlaps a live mutable borrow of one of its fields. Rule 2 looked
// at `g` and its parents only, not at the paths under it, and accepted
// the program (create_borrow now uses has_mut_borrow_inclusive).
struct Node { name: str, edges: Vec<i64> }

struct Graph { nodes: Vec<Node> }

fn size(g: &Graph) -> i64 {
    return g.nodes.len();
}

fn main() -> i64 {
    var g: Graph = Graph { nodes: Vec::new() };
    val ns: &mut Vec<Node> = &mut g.nodes;
    ns.push(Node { name: "x", edges: Vec::new() });
    println(int_to_str(size(&g)));
    ns.push(Node { name: "y", edges: Vec::new() });
    return 0;
}
