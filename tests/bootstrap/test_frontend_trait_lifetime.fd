// LG3: a trait's method with lifetimes and an impl that keeps them: the
// result borrows the receiver only, so changing the argument while it is
// live is fine, and the receiver is free after its last use.
// Expected output:
// 7
// 3
// 9
cap Pick {
    fn pick<'a>(self: &'a Self, other: &i64) -> &'a i64;
}

struct Two {
    v: i64,
}

impl Pick for Two {
    fn pick<'a>(self: &'a Two, other: &i64) -> &'a i64 {
        if *other > 100 {
            return &self.v;
        }
        return &self.v;
    }
}

fn main() -> i64 {
    var t: Two = Two { v: 7 };
    var x: i64 = 2;
    val r = t.pick(&x);
    x = 3;
    println(*r);
    println(x);
    t.v = 9;
    println(t.v);
    return 0;
}
