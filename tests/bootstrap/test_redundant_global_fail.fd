// expect-error: Redundancy error: @redundant function 'next_command' writes the global 'LAST' (in 'remember')
// Roadmap Phase 9 (F45): the second channel would see the first channel's
// write to a global, so the two channels would not be independent.

var LAST: i64 = 0;

fn remember(v: i64) -> i64 {
    LAST = v;
    return v;
}

@redundant
fn next_command(alpha: i64) -> i64 {
    return remember(alpha + LAST);
}

fn main() {
    println(int_to_str(next_command(3)));
}
