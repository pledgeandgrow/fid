// K10: `@simd` functions give the same results on fidesc and fid (run, C,
// emit). On the C path a @simd function is emitted with P_SIMD_FN (GCC:
// vectorize with the cost model relaxed, as fidesc's @simd asks); `fid
// dump-c` shows `P_SIMD_FN int64_t dot_i(...)`.
// Expected output:
// dot 90
// saxpy 2 4.5 7 9.5 12 14.5 17 19.5
// sum 500500
// max 973
// done

@simd
fn dot_i(a: Vec<i64>, b: Vec<i64>) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < a.len() {
        s = s + a.get(i) * b.get(i);
        i = i + 1;
    }
    return s;
}

@simd
fn saxpy(k: f64, x: Vec<f64>, y: Vec<f64>) -> Vec<f64> {
    var out: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < x.len() {
        out.push(k * x.get(i) + y.get(i));
        i = i + 1;
    }
    return out;
}

@simd
fn sum_to(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        s = s + i;
        i = i + 1;
    }
    return s;
}

@simd
fn max_of(v: Vec<i64>) -> i64 {
    var m: i64 = v.get(0);
    var i: i64 = 1;
    while i < v.len() {
        if v.get(i) > m {
            m = v.get(i);
        }
        i = i + 1;
    }
    return m;
}

fn main() {
    var a: Vec<i64> = Vec::new();
    var b: Vec<i64> = Vec::new();
    var i: i64 = 1;
    while i <= 4 {
        a.push(i);
        b.push(i * 3);
        i = i + 1;
    }
    println("dot " + int_to_str(dot_i(a, b)));
    var x: Vec<f64> = Vec::new();
    var y: Vec<f64> = Vec::new();
    var j: i64 = 0;
    while j < 8 {
        x.push(j as f64);
        y.push(2.0);
        j = j + 1;
    }
    var z: Vec<f64> = saxpy(2.5, x, y);
    var line: str = "saxpy";
    var k: i64 = 0;
    while k < z.len() {
        line = line + " " + float_to_str(z.get(k));
        k = k + 1;
    }
    println(line);
    println("sum " + int_to_str(sum_to(1000)));
    var v: Vec<i64> = Vec::new();
    var t: i64 = 0;
    while t < 100 {
        v.push((t * 37 + 11) % 1000);
        t = t + 1;
    }
    println("max " + int_to_str(max_of(v)));
    println("done");
}
