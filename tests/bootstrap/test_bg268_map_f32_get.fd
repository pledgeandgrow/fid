// BG268 (docs/roadmap/bugs-roadmap.md): `HashMap<K, f32>` get / get_or give
// the f32 value back (they gave the stored word converted as an integer).
//
// Expected output:
// map 3.5
// or 2.5
// or 0.25
// sum 4

fn main() {
    var m: HashMap<i64, f32> = HashMap::new();
    val y: f32 = 3.5;
    m.insert(1, y);
    val g: f32 = m.get(1);
    println(f"map {g}");
    var s: HashMap<str, f32> = HashMap::new();
    s.insert("a", y);
    println(f"or {s.get_or("zz", 2.5)}");
    val d: f32 = 0.25;
    println(f"or {s.get_or("zz", d)}");
    val t: f32 = m.get(1) + s.get_or("q", 0.5);
    println(f"sum {t}");
}
