// expect-error: locks are taken in an inconsistent order
// Bugs roadmap BG413: the classic two-thread deadlock with SyncMutex values:
// t1 takes a then b, t2 takes b then a.
use sync;
fn t1(a: SyncMutex, b: SyncMutex) -> i64 {
    a.lock();
    b.lock();
    b.unlock();
    a.unlock();
    return 1;
}
fn t2(a: SyncMutex, b: SyncMutex) -> i64 {
    b.lock();
    a.lock();
    a.unlock();
    b.unlock();
    return 2;
}
fn main() {
    val a = SyncMutex::new();
    val b = SyncMutex::new();
    val h1 = spawn t1(a, b);
    val h2 = spawn t2(a, b);
    println(await h1 + await h2);
}
