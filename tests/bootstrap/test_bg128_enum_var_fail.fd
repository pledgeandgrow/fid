// expect-error: cannot assign Option<i64> to variable 'b'
// Bugs roadmap BG128: an enum literal with no expected type has the type
// arguments its payload gives (`Option::Some(5)` is an Option<i64>), so it
// cannot be read as an Option<str> through a variable.
fn main() -> i64 {
    val a = Option::Some(5);
    val b: Option<str> = a;
    match b { Option::Some(s) => { println(s); } Option::None => { } }
    return 0;
}
