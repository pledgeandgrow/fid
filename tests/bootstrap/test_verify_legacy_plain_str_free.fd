// Earlier miscompile "AGENTS 21": natively built fid freed `s - 16` of a
// plain string because the length-header magic alone was trusted. Strings
// of every kind (literals, int_to_str, concatenation, slices) are made,
// kept, replaced and dropped in a loop; nothing may crash or free twice.
//
// Expected output:
// 199
// x0-1-2-3-4
// 11
// abc

fn main() -> i64 {
    var keep: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < 200 {
        var s: str = int_to_str(i);
        s = s + "-";
        var t: str = str_slice(s, 0, str_len(s) - 1);
        if i % 40 == 0 {
            keep.push(t);
        }
        i = i + 1;
    }
    println(str_slice(int_to_str(i - 1) + "!", 0, 3));
    var acc: str = "x";
    var j: i64 = 0;
    while j < 5 {
        if j > 0 {
            acc = acc + "-";
        }
        acc = acc + int_to_str(j);
        j = j + 1;
    }
    println(acc);
    var total: i64 = 0;
    var k: i64 = 0;
    while k < keep.len() {
        total = total + str_len(keep[k]);
        k = k + 1;
    }
    println(int_to_str(total));
    var lit: str = "abc";
    var dup: str = lit + "";
    println(dup);
    return 0;
}
