// Bugs roadmap BG387: a trait method returning a fixed array, called
// through `dyn`, crashed (the method took the receiver as its result
// pointer): BG184's `__dsret` wrapper covered struct results only.
// compiler/lower.fd Lowerer_lower_method_call's dyn branch and
// Lowerer_dyn_sret_wrapper now route an Array result the same way.
//
// Expected output:
// 10
// 13

struct H { n: i64 }

cap Tri {
    fn trio(self) -> [i64; 3];
}

impl Tri for H {
    pub fn trio(self: H) -> [i64; 3] {
        return [self.n, self.n + 1, self.n + 2];
    }
}

fn main() {
    val h = H { n: 4 };
    val d = h as dyn Tri;
    val a = d.trio();
    println(a[0] + a[2]);
    val h2 = H { n: 3 };
    val d2 = h2 as dyn Tri;
    val b = d2.trio();
    println(b[0] + b[1] + b[2] + 1);
}
