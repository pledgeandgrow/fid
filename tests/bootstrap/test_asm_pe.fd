// Test: Inline assembly in PE emitter — Phase 5A.1
// Tests that asm!() emits correct raw bytes in the PE/bare backend.
// This test is verified by building with --bare and checking the output binary.

fn main() {
    // Test 1: Zero-operand instructions
    asm!("nop");
    asm!("cli");
    asm!("sti");
    asm!("hlt");
    asm!("pause");
    asm!("mfence");
    asm!("sfence");
    asm!("lfence");
    asm!("cld");
    asm!("leave");

    // Test 2: Multiple instructions in one template
    asm!("nop; cli; hlt; sti");

    // Test 3: Input operands — load value into register
    val x = 42;
    asm!("nop", in("rax") x);
    asm!("nop", in("rcx") x);
    asm!("nop", in("rdx") x);
    asm!("nop", in("r8") x);

    // Test 4: Output operands — store register to variable
    val result = asm!("nop", out("rax") x);
    val result2 = asm!("nop", out("rdx") x);

    // Test 5: Both input and output
    val a = 10;
    val b = 20;
    val c = asm!("nop", in("rax") a, in("rcx") b, out("rdx") b);

    // Test 6: I/O port instructions (for OS development)
    asm!("in al, dx");
    asm!("out dx, al");
    asm!("in al, 0x60");
    asm!("out 0x60, al");

    // Test 7: Control register access (for paging setup)
    asm!("mov rax, cr0");
    asm!("mov cr3, rax");
    asm!("mov rax, cr4");
    asm!("mov cr4, rax");

    // Test 8: Register manipulation
    asm!("xor rax, rax");
    asm!("mov rax, 0x100000");
    asm!("push rax");
    asm!("pop rax");
    asm!("inc rax");
    asm!("dec rax");
    asm!("not rax");
    asm!("neg rax");
    asm!("shl rax, 4");
    asm!("shr rax, 4");
    asm!("sar rax, 4");

    // Test 9: GDT/IDT loading (for OS boot)
    asm!("lgdt [rax]");
    asm!("lidt [rax]");
    asm!("invlpg [rax]");

    // Test 10: Interrupt instructions
    asm!("int 0x20");
    asm!("int 3");
    asm!("iretq");

    // Test 11: CPUID and MSR
    asm!("cpuid");
    asm!("rdtsc");

    // Test 12: Indirect jump/call
    asm!("jmp rax");
    asm!("call rax");

    return 0;
}
