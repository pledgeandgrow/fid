// BG356 (docs/roadmap/bugs-roadmap.md): RingBuffer::new(0).push(x) trapped
// with "Modulo by zero": push computed `(head + len) % capacity` before
// testing whether the ring was full. A ring with no room now keeps nothing
// (the value pushed is the oldest one, overwritten at once), as try_push
// and is_full already said; a negative capacity behaves the same.
//
// Expected output:
// len 0 full true empty true
// try false front 0 back 0 pop 0 get 0
// len 0 cap -2
// 4 2 3 4
// 1 5
use collections;

fn main() {
    var r = RingBuffer::new(0);
    r.push(1);
    r.push(2);
    println(f"len {r.len()} full {r.is_full()} empty {r.is_empty()}");
    val t: bool = r.try_push(3);
    println(f"try {t} front {r.peek_front()} back {r.peek_back()} pop {r.pop_front()} get {r.get(0)}");
    var n = RingBuffer::new(0 - 2);
    n.push(7);
    println(f"len {n.len()} cap {n.cap()}");
    // a normal ring still overwrites its oldest element
    var g = RingBuffer::new(3);
    g.push(1);
    g.push(2);
    g.push(3);
    g.push(4);
    println(f"{g.peek_back()} {g.get(0)} {g.get(1)} {g.get(2)}");
    var one = RingBuffer::new(1);
    one.push(1);
    val first: i64 = one.peek_front();
    one.push(5);
    println(f"{first} {one.peek_front()}");
}
