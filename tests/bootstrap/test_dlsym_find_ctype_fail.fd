// expect-error: a symbol looked up with p_dl_find is a C function: it cannot return
// Roadmap L6C: a symbol found with p_dl_find is a C function, so the
// function type it is bound with must use C types; a Vec result is not one.
use core with { FS, IO }

fn main() -> i64 {
    val lib: i64 = p_dl_load("libm.so.6");
    val f: fn(i64) -> Vec<i64> = p_dl_find(lib, "make");
    return 0;
}
