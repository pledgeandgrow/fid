// Test: an `if` or `match` whose value is a struct (stdlib wav_to_stereo:
// `val m: Wav = if c { f(w) } else { g(w) };`). Each branch copies the
// struct into the result slot; the merge read the slot's first word as
// the struct's address, so the C build crashed reading m's fields (the
// interpreter worked). Its value is now the slot's address.
// Expected output:
// 9 2 0.5 a
// 9 2 0.25 b
// m 7 c
struct W {
    name: str,
    n: i64,
    xs: Vec<f64>,
}

fn mk(n: i64, x: f64, name: str) -> W {
    var w: W = W { name: name, n: n, xs: Vec::new() };
    w.xs.push(x);
    return w;
}

fn pick(w: & W) -> W {
    val m: W = if w.n == 1 { mk(1, 0.5, "a") } else { mk(2, 0.25, "b") };
    var o: W = mk(9, 1.0, m.name);
    o.xs.push(m.xs.get(0));
    return o;
}

fn by_match(k: i64) -> W {
    val m: W = match k {
        1 => mk(7, 2.0, "c"),
        _ => mk(8, 3.0, "d"),
    };
    return m;
}

fn main() {
    val a: W = mk(1, 0.0, "x");
    val b: W = pick(& a);
    println(int_to_str(b.n) + " " + int_to_str(b.xs.len()) + " " + float_to_str(b.xs.get(1)) + " " + b.name);
    val c: W = mk(2, 0.0, "y");
    val d: W = pick(& c);
    println(int_to_str(d.n) + " " + int_to_str(d.xs.len()) + " " + float_to_str(d.xs.get(1)) + " " + d.name);
    val e: W = by_match(1);
    println("m " + int_to_str(e.n) + " " + e.name);
}
