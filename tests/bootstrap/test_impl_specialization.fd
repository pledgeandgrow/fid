// L8H: specialization of methods in impl blocks. A generic impl
// (`impl<T> Wrap<T>`) and narrower impls of the same struct (`impl
// Wrap<i64>`, `impl Wrap<str>`, `impl<U> Wrap<Vec<U>>`, `impl
// Wrap<Vec<i64>>`) each define `show`; a call takes the method of the most
// specific impl whose type takes the receiver's type, and the generic one
// otherwise (Wrap<bool>). A call inside a generic method (`kind` calls
// `self.show()`) is decided per instantiation. A method only the generic
// impl has (`tag`) and one only a narrower impl has (`twice`) are ordinary
// methods. Before, the second `show` of the struct was a duplicate.
//
// Expected output:
// i64 5
// str hi
// any
// vec of 2
// vec of i64, sum 6
// wrap of i64 7
// wrap of any
// i64 9 / x
// any / y
// tag
// 14

struct Wrap<T> {
    v: T,
}

impl<T> Wrap<T> {
    fn show(self) -> str {
        return "any";
    }

    fn kind(self) -> str {
        return "wrap of " + self.show();
    }

    fn show_with(self, sep: str) -> str {
        return "any / " + sep;
    }

    fn tag(self) -> str {
        return "tag";
    }
}

impl Wrap<i64> {
    fn show(self) -> str {
        return "i64 " + int_to_str(self.v);
    }

    fn show_with(self, sep: str) -> str {
        return "i64 " + int_to_str(self.v) + " / " + sep;
    }

    fn twice(self) -> i64 {
        return self.v * 2;
    }
}

impl Wrap<str> {
    fn show(self) -> str {
        return "str " + self.v;
    }
}

impl<U> Wrap<Vec<U>> {
    fn show(self) -> str {
        return "vec of " + int_to_str(self.v.len());
    }
}

impl Wrap<Vec<i64>> {
    fn show(self) -> str {
        var s: i64 = 0;
        var i: i64 = 0;
        while i < self.v.len() {
            s = s + self.v.get(i);
            i = i + 1;
        }
        return "vec of i64, sum " + int_to_str(s);
    }
}

fn main() -> i64 {
    val a: Wrap<i64> = Wrap { v: 5 };
    println(a.show());
    val b: Wrap<str> = Wrap { v: "hi" };
    println(b.show());
    val c: Wrap<bool> = Wrap { v: true };
    println(c.show());
    var vs: Vec<str> = Vec::new();
    vs.push("a");
    vs.push("b");
    val d: Wrap<Vec<str>> = Wrap { v: vs };
    println(d.show());
    var vi: Vec<i64> = Vec::new();
    vi.push(1);
    vi.push(2);
    vi.push(3);
    val e: Wrap<Vec<i64>> = Wrap { v: vi };
    println(e.show());
    val f: Wrap<i64> = Wrap { v: 7 };
    println(f.kind());
    println(c.kind());
    val g: Wrap<i64> = Wrap { v: 9 };
    println(g.show_with("x"));
    println(c.show_with("y"));
    println(c.tag());
    println(int_to_str(f.twice()));
    return 0;
}
