// Bugs roadmap BG367: casting an integer to a function type needs
// `unsafe`; a function value cast to its own type, and to an integer (its
// handle), stay safe.
//
// Expected output:
// 4
// true

fn inc(x: i64) -> i64 {
    return x + 1;
}

fn main() {
    val g = inc as fn(i64) -> i64;
    println(g(3));
    val h: fn(i64) -> i64 = inc;
    val w: i64 = h as i64;
    println(w != 0);
}
