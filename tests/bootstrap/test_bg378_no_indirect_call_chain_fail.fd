// expect-error: is @no-indirect but calls the function value a call returns
// Bugs roadmap BG378: `v.get(0)(x)` calls the function value a call
// returns, an indirect call @no-indirect forbids.
fn inc(x: i64) -> i64 {
    return x + 1;
}
@no-indirect
fn f(x: i64) -> i64 {
    var v: Vec<fn(i64) -> i64> = Vec::new();
    v.push(inc);
    return v.get(0)(x);
}
fn main() {
    println(f(1));
}
