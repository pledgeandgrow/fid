// expect-error: function 'ping' is @no-recursion but is part of (line 7)
//! error: function 'ping' is @no-recursion but is part of (line 7)
// TL2: a test per diagnostic of the type, borrow and escape checks.
// @no-recursion also refuses recursion through other functions.

@no-recursion
fn ping(n: i64) -> i64 { // <- here
    if n == 0 {
        return 0;
    }
    return pong(n - 1);
}

@no-recursion
fn pong(n: i64) -> i64 {
    return ping(n);
}

fn main() -> i64 {
    println(ping(3));
    return 0;
}
