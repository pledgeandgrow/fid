// L8H: methods that only a narrower impl has. `impl<U> Wrap<Vec<U>>`
// (written first, before the generic impl) adds `first`, whose result U
// comes from the receiver's type (a Wrap<Vec<str>> gives a str, a
// Wrap<Vec<i64>> an i64), and specializes `show`; `impl Wrap<i64>` adds
// `twice`. The generic impl `impl<T> Wrap<T>` stays the one whose
// parameter names the struct's (`get` returns T), although a narrower impl
// comes before it in the file. Before, the narrower impl written first was
// taken for the generic one: T was read as U, and `first` was typed U.
//
// Expected output:
// p vec of 2
// 42 vec of 1
// 42 any 21
// z any

struct Wrap<T> {
    v: T,
}

impl<U> Wrap<Vec<U>> {
    fn first(self) -> U {
        return self.v.get(0);
    }

    fn show(self) -> str {
        return "vec of " + int_to_str(self.v.len());
    }
}

impl<T> Wrap<T> {
    fn show(self) -> str {
        return "any";
    }

    fn get(self) -> T {
        return self.v;
    }
}

impl Wrap<i64> {
    fn twice(self) -> i64 {
        return self.v * 2;
    }
}

fn main() -> i64 {
    var vs: Vec<str> = Vec::new();
    vs.push("p");
    vs.push("q");
    val a: Wrap<Vec<str>> = Wrap { v: vs };
    val s: str = a.first();
    println(s + " " + a.show());
    var vi: Vec<i64> = Vec::new();
    vi.push(40);
    val b: Wrap<Vec<i64>> = Wrap { v: vi };
    val n: i64 = b.first() + 2;
    println(int_to_str(n) + " " + b.show());
    val c: Wrap<i64> = Wrap { v: 21 };
    println(int_to_str(c.twice()) + " " + c.show() + " " + int_to_str(c.get()));
    val d: Wrap<str> = Wrap { v: "z" };
    println(d.get() + " " + d.show());
    return 0;
}
