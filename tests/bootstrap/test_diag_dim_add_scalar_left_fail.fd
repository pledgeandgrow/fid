// expect-error: `f64 - Len`: a unit adds only to a value of its own unit (Len).
// Expected to FAIL (CE4): a bare number minus metres has no unit (CL10),
// with the number on the left (TypeChecker_check_dim_scalar_left).
@dimension(m = 1)
struct Len {
    value: f64,
}

fn main() -> i64 {
    val d: Len = Len { value: 3.0 };
    val x: Len = 2.0 - d;
    println(int_to_str(x.value as i64));
    return 0;
}
