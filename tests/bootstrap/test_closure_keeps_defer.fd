// Bugs roadmap BG28: lowering a closure emptied the enclosing function's
// defer stack and its AST parameter types and never restored them, so a
// `defer` written before the closure never ran and a parameter read after
// it lost its type.
// Expected output:
// 2
// hello!
// cleanup g
// 6
// body
// 11
// cleanup main
fn g(s: str, n: i64) -> i64 {
    defer {
        println("cleanup g");
    }
    val f = fn(a: i64) -> i64 => a + 1;
    println(int_to_str(f(1)));
    println(s + "!");
    return n * 2;
}

fn main() -> i64 {
    defer {
        println("cleanup main");
    }
    val h = fn(a: i64) -> i64 => a + 10;
    val r: i64 = g("hello", 3);
    println(int_to_str(r));
    println("body");
    println(int_to_str(h(1)));
    return 0;
}
