// OP25 (compiler/iropt_me.fd ime_guard_moves, `licmguard` with its call
// part `guardcall`; the names come from iropt.fd iropt_native,
// ime_set_call_facts): a call to a function with no effect but a panic, in
// the first block of a loop's body, moves out of the loop under the guard
// (the header's test made once more before the loop), the way `t / k` does.
// - first_block: `tri_div(m, k)` (a loop and a division: it may panic, it
//   reads and writes nothing). With no pass (n = 0) it is not called, so
//   k = 0 raises nothing; with passes it is called once.
// - after_print: the call comes after a print: it stays where it is (the
//   output keeps its order).
// - reads_global: `read_lim()` reads a global the loop writes: it stays,
//   so each pass sees the new value.
// - varying: the argument changes in the loop: the call stays.
// - bool_call: a bool result, tested in the body: moved like the others.
// The program prints the same with the passes on and off
// (tests/tooling/op25-check.sh).
//
// Expected output:
// 0
// 27
// 0
// 1
// 6
// 12
// 4
// 4

var g_lim: i64 = 3;

fn tri_div(m: i64, k: i64) -> i64 {
    var s: i64 = 0;
    var j: i64 = 0;
    while j < m {
        s = s + j;
        j = j + 1;
    }
    return s / k;
}

fn odd_tri(m: i64) -> bool {
    var s: i64 = 0;
    var j: i64 = 0;
    while j < m {
        s = s + j;
        j = j + 1;
    }
    return s % 2 == 1;
}

fn read_lim() -> i64 {
    return g_lim;
}

fn first_block(n: i64, m: i64, k: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        acc = acc + tri_div(m, k);
        i = i + 1;
    }
    return acc;
}

fn after_print(n: i64, m: i64, k: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        println(i);
        acc = acc + tri_div(m, k);
        i = i + 1;
    }
    return acc;
}

fn reads_global(n: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        acc = acc + read_lim();
        g_lim = g_lim + 1;
        i = i + 1;
    }
    return acc;
}

fn varying(n: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        acc = acc + tri_div(i + 1, 1);
        i = i + 1;
    }
    return acc;
}

fn bool_call(n: i64, m: i64) -> i64 {
    var c: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if odd_tri(m) {
            c = c + 1;
        }
        i = i + 1;
    }
    return c;
}

fn main() {
    println(first_block(0, 10, 0));
    // tri_div(10, 5) = 45 / 5 = 9, three passes
    println(first_block(3, 10, 5));
    // prints 0 and 1; tri_div(4, 2) = 6 / 2 = 3, two passes
    println(after_print(2, 4, 2));
    // 3 + 4 + 5
    println(reads_global(3));
    // tri_div(1, 1) + tri_div(2, 1) + tri_div(3, 1) = 0 + 1 + 3
    println(varying(3));
    // tri(6) = 15 is odd: four passes count
    println(bool_call(4, 6));
}
