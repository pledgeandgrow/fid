// Test @cfg conditional compilation
// On Linux, @cfg(linux) items are included, @cfg(windows) items are excluded.
// On Windows, @cfg(windows) items are included, @cfg(linux) items are excluded.

@cfg(linux)
fn linux_only_fn() -> i64 {
    return 42;
}

@cfg(windows)
fn windows_only_fn() -> i64 {
    return 999;
}

@cfg(platform = "linux")
fn linux_platform_fn() -> i64 {
    return 100;
}

@cfg(os = "linux")
fn linux_os_fn() -> i64 {
    return 200;
}

@cfg(platform = "windows")
fn windows_platform_fn() -> i64 {
    return 300;
}

@cfg(os = "windows")
fn windows_os_fn() -> i64 {
    return 400;
}

@cfg(x86_64)
fn x86_64_fn() -> i64 {
    return 64;
}

@cfg(target_arch = "x86_64")
fn x86_64_arch_fn() -> i64 {
    return 128;
}

// This function is always included (no @cfg)
fn always_present() -> i64 {
    return 1;
}

// Platform-specific test runners — only one is included on each platform.
@cfg(linux)
fn test_platform_specific() -> i64 {
    assert(linux_only_fn() == 42);
    assert(linux_platform_fn() == 100);
    assert(linux_os_fn() == 200);
    return 0;
}

@cfg(windows)
fn test_platform_specific() -> i64 {
    assert(windows_only_fn() == 999);
    assert(windows_platform_fn() == 300);
    assert(windows_os_fn() == 400);
    return 0;
}

fn main() {
    assert(always_present() == 1);

    // Platform-specific tests (one of the above is included)
    test_platform_specific();

    // On x86_64, these should be present
    assert(x86_64_fn() == 64);
    assert(x86_64_arch_fn() == 128);

    println("All @cfg tests passed!");
}
