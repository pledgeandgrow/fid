// expect-error: does not fit in 64 bits
// BG61 (docs/roadmap/bugs-roadmap.md): an integer literal of 2^64 or more
// wrapped silently (18446744073709551616 was 0). No integer type holds it:
// the lexer rejects it. u64::MAX itself is still a literal.
fn main() -> i64 {
    val ok: u64 = 18446744073709551615;
    val x: u64 = 18446744073709551616;
    println(int_to_str((ok as i64) + (x as i64)));
    return 0;
}
