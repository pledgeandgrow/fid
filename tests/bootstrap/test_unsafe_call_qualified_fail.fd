// expect-error: ptr_write() needs an `unsafe` block
// Release M10: naming an @unsafe function by its module does not make the
// call safe: `volatile::ptr_write(a, v)` outside `unsafe` is rejected as
// `ptr_write(a, v)` is (test_unsafe_raw_apis_fail.fd), here with an address
// nobody owns (0x1000). test_unsafe_call_ok.fd: inside `unsafe`, accepted.
use volatile;

fn main() -> i64 {
    volatile::ptr_write(4096, 1);
    println("written");
    return 0;
}
