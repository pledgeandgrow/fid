// expect-error: cannot mutate a: shared borrow(s) are active
// LG3: `v` holds a reference to `a` in a field, so changing `a` while `v`
// is still used is the error it is for `val r = &a`.
struct View<'a> {
    r: &'a i64,
    k: i64,
}

fn main() -> i64 {
    var a: i64 = 5;
    val v = View { r: &a, k: 2 };
    a = 9;
    println(*v.r);
    return 0;
}
