// expect-error: method 'area' of impl Shape for Square has no self parameter; the trait's method takes self
// Expected to FAIL (CE4): the impl's method must take self when the cap's
// does (TypeChecker_check_impl_sig).
cap Shape {
    fn area(self) -> i64;
}

struct Square {
    side: i64,
}

impl Shape for Square {
    fn area() -> i64 {
        return 4;
    }
}

fn main() -> i64 {
    val s: Square = Square { side: 2 };
    println(s.side);
    return 0;
}
