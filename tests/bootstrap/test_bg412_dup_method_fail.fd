// expect-error: Duplicate definition: method 'get' of 'Pt' is defined twice
// Bugs roadmap BG412: a method defined twice in one impl block was accepted
// and the later one won (`p.get()` was 2).
struct Pt {
    x: i64,
}
impl Pt {
    fn get(self) -> i64 {
        return 1;
    }
    fn get(self) -> i64 {
        return 2;
    }
}
fn main() {
    val p = Pt { x: 0 };
    println(p.get());
}
