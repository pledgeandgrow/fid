// BG202 (docs/roadmap/bugs-roadmap.md): text compares with `==` and `!=`,
// and its order comes from str_compare.
//
// Expected output:
// true
// false
// true
// false
// true
use string;

fn main() -> i64 {
    val a = "abc";
    val b = "abd";
    println(a == "abc");
    println(a == b);
    println(a != b);
    println(str_compare(a, b) > 0);
    println(str_compare("b", "abc") > 0);
    return 0;
}
