// expect-error: a branch of `parallel { }` uses 'v' of type
// Bugs roadmap BG24: what a `parallel { }` branch reads of the enclosing
// function was not held to @send, as a spawned call's arguments are: two
// branches pushed onto one Vec through a `&mut` at the same time.
fn fill(v: &mut Vec<i64>) {
    parallel {
        | v.push(1);
        | v.push(2);
    }
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    fill(&mut v);
    println(int_to_str(v.len()));
    return 0;
}
