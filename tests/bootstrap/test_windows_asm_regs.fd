// test_windows_asm_regs.fd — competitive LG13 on the default Windows
// backend (compiler/pe_ir.fd PeirGen_gen_asm_process): a Windows process
// runs asm! templates now. The template here overwrites callee-saved
// registers (rbx, rsi, rdi, r12-r15) and the scratch ones: a function with
// asm! keeps its values in their slots and saves every callee-saved
// register, so the caller's values survive. Nothing printed depends on
// what the templates compute (the interpreter and C path run no asm!), so
// every backend prints the same; scripts/pe-win/asm_process.fd checks the
// results of templates on the native build.
//
// Expected output:
// 15
// 120
// 5050

@unsafe
fn clobber(x: i64) -> i64 {
    asm!("xor rbx, rbx; xor rsi, rsi; xor rdi, rdi; xor r12, r12; xor r13, r13; xor r14, r14; xor r15, r15; xor r10, r10; xor r11, r11");
    return x;
}

@unsafe
fn many(n: i64) -> i64 {
    var a: i64 = n + 1;
    var b: i64 = n + 2;
    var c: i64 = n + 3;
    var d: i64 = n + 4;
    var e: i64 = n + 5;
    var t: i64 = clobber(0);
    return a + b + c + d + e + t - 5 * n;
}

@unsafe
fn fact(n: i64) -> i64 {
    var r: i64 = 1;
    var i: i64 = 2;
    while i <= n {
        r = r * i;
        clobber(i);
        i = i + 1;
    }
    return r;
}

@unsafe
fn main() {
    print(many(100));
    print("\n");
    print(fact(5));
    print("\n");
    var s: i64 = 0;
    var i: i64 = 1;
    while i <= 100 {
        s = s + clobber(i);
        i = i + 1;
    }
    print(s);
    print("\n");
    return 0;
}
