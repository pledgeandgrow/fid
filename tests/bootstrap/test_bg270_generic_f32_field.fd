// BG270 (docs/roadmap/bugs-roadmap.md): a type-parameter field holding an
// f32 (`G<f32>`) is read back as the f32 (it was read as an integer word,
// a different bit pattern per backend). Writes to the field keep it too.
//
// Expected output:
// 3.5 4.5
// 2.5
// 3.25
// 1.25

struct G<T> {
    v: T,
}

fn idf(x: f32) -> f32 {
    return x;
}

fn getv<T>(g: G<T>) -> T {
    return g.v;
}

fn main() {
    val g = G { v: idf(3.5) };
    val x: f32 = g.v;
    println(f"{x} {x + idf(1.0)}");
    var h: G<f32> = G { v: idf(1.0) };
    h.v = idf(2.5);
    println(f"{h.v}");
    h.v += idf(0.75);
    println(f"{h.v}");
    val k: G<f32> = G { v: idf(1.25) };
    val r: f32 = getv(k);
    println(f"{r}");
}
