// expect-error: Allocator error: function 'make' has @allocator but no allocator parameter specified
// TL2: a diagnostic per check. @allocator names the allocator the function
// allocates from (`@allocator(arena)`); written bare it names none.

@allocator
fn make() -> i64 {
    return 7;
}

fn main() -> i64 {
    println(int_to_str(make()));
    return 0;
}
