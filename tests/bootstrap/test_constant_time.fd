// test_constant_time.fd — @constant_time annotation (side-channel defense)
// Expected: PASS (no violations)
// These functions are constant-time: no early returns, no IO, no allocation,
// no branches, indexing or division on their (secret) parameters.

@constant_time
fn ct_eq(a: i64, b: i64) -> i64 {
    // Constant-time equality: 1 if equal, 0 if not, without branching on the
    // values (an `if` on them would take a secret-dependent branch).
    // diff | -diff is negative exactly when diff != 0.
    val diff = a ^ b;
    val nonzero = ((diff | (0 - diff)) >> 63) & 1;
    return 1 - nonzero;
}

@constant_time
fn ct_select(condition: i64, a: i64, b: i64) -> i64 {
    // Constant-time select: returns a if condition is 1, b if 0
    // No early return — always computes both
    val mask = 0 - condition;
    var result = (a & mask) | (b & ~mask);
    return result;
}

fn main() {
    val x = ct_eq(5, 5);
    val y = ct_eq(5, 6);
    print(x);
    print(y);
    val z = ct_select(1, 100, 200);
    print(z);
    val w = ct_select(0, 100, 200);
    print(w);
}
