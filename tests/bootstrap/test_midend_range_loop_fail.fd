// LF8 (llvm-roadmap): the loop header fact of test_midend_range_loop.fd
// must hold on every back edge. Here the body also stores a value that
// makes `j * 1000` overflow on the next round: the header fact is then
// j in [0, 9223372036854776] (or none), the multiply keeps its overflow
// check (compiler/checks.fd peir_lf_update), and it fires at k == 6.
// Expected: an overflow panic (exit status not 0), after printing 1.

fn mix(n: i64) -> i64 {
    var j: i64 = 0;
    var t: i64 = 0;
    var k: i64 = 0;
    while k < n {
        t = t + j * 1000;
        j = (j + 7) % 13;
        if k == 5 {
            j = 9223372036854776;
        }
        k = k + 1;
    }
    var last: i64 = j;
    j = t;
    return j + last;
}

fn main() {
    println(1);
    println(mix(20));
}
