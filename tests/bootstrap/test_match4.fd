pub enum Expr {
    IntLit(i64),
    Ident(str),
    Index(Box<Expr>, Box<Expr>),
    Deref(Box<Expr>),
    FieldAccess(Box<Expr>, str),
}

fn test_match(e: Expr) -> i64 {
    match e {
        Expr::Ident(name) => { return 1; }
        Expr::Index(array, index) => { return 2; }
        Expr::Deref(ptr_expr) => { return 3; }
        Expr::FieldAccess(obj_expr, field) => { return 4; }
        _ => {}
    }
    return 0;
}

fn main() -> i64 {
    return test_match(Expr::Ident("x"));
}
