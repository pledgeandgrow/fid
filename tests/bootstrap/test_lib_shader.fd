// stdlib/shader: materials compile their program through gl.fd, so creating
// one needs a GL context. What runs without one: the constants, the built-in
// GLSL sources (checked for the pieces the material code relies on) and an
// empty material cache.
use shader;

fn has(text: str, part: str) -> bool {
    return str_contains(text, part);
}

fn main() -> i64 {
    println(UNIFORM_FLOAT);
    println(UNIFORM_INT);
    println(UNIFORM_VEC3);
    println(UNIFORM_VEC4);
    println(UNIFORM_MAT4);
    println(UNIFORM_TEXTURE);
    println(BLEND_OPAQUE);
    println(BLEND_ALPHA);
    println(BLEND_ADDITIVE);
    println(CULL_NONE);
    println(CULL_BACK);
    println(CULL_FRONT);

    // every built-in source is GLSL 3.30 core and has a main
    println(has(SHADER_UNLIT_VERT, "#version 330 core"));
    println(has(SHADER_UNLIT_FRAG, "#version 330 core"));
    println(has(SHADER_DIFFUSE_VERT, "#version 330 core"));
    println(has(SHADER_DIFFUSE_FRAG, "#version 330 core"));
    println(has(SHADER_TEXT_VERT, "#version 330 core"));
    println(has(SHADER_TEXT_FRAG, "#version 330 core"));
    println(has(SHADER_POST_VERT, "#version 330 core"));
    println(has(SHADER_POST_FRAG, "#version 330 core"));
    println(has(SHADER_UNLIT_VERT, "void main()"));
    println(has(SHADER_UNLIT_FRAG, "void main()"));
    println(has(SHADER_DIFFUSE_VERT, "void main()"));
    println(has(SHADER_DIFFUSE_FRAG, "void main()"));
    println(has(SHADER_TEXT_VERT, "void main()"));
    println(has(SHADER_TEXT_FRAG, "void main()"));
    println(has(SHADER_POST_VERT, "void main()"));
    println(has(SHADER_POST_FRAG, "void main()"));

    // the uniforms the materials set by name exist in their shaders
    println(has(SHADER_UNLIT_VERT, "uniform mat4 model;"));
    println(has(SHADER_UNLIT_VERT, "uniform mat4 view;"));
    println(has(SHADER_UNLIT_VERT, "uniform mat4 projection;"));
    println(has(SHADER_UNLIT_FRAG, "uniform vec3 color;"));
    println(has(SHADER_DIFFUSE_FRAG, "uniform vec3 lightPos;"));
    println(has(SHADER_DIFFUSE_FRAG, "uniform vec3 objectColor;"));
    println(has(SHADER_TEXT_FRAG, "uniform sampler2D text;"));
    println(has(SHADER_POST_FRAG, "uniform sampler2D screenTexture;"));
    // and vertex outputs match fragment inputs
    println(has(SHADER_DIFFUSE_VERT, "out vec3 Normal;"));
    println(has(SHADER_DIFFUSE_FRAG, "in vec3 Normal;"));
    println(has(SHADER_TEXT_VERT, "out vec2 TexCoord;"));
    println(has(SHADER_TEXT_FRAG, "in vec2 TexCoord;"));
    println(has(SHADER_POST_VERT, "out vec2 TexCoord;"));
    println(has(SHADER_POST_FRAG, "in vec2 TexCoord;"));
    // the sources differ
    println(str_equal(SHADER_UNLIT_FRAG, SHADER_POST_FRAG));
    println(str_len(SHADER_UNLIT_VERT) > 100);

    // material cache: empty
    var cache = material_cache_create();
    println(material_cache_count(&cache));
    material_cache_clear(&mut cache);
    println(material_cache_count(&cache));
    println(cache.names.len());
    return 0;
}
