// expect-error: cannot assign to h.a: h is borrowed
// LG3: a method whose result is tied to `self`: `r` borrows the receiver
// `h`, so changing `h.a` while `r` is still used is an error (methods were
// not tracked by the borrow checker before).
struct Holder {
    a: i64,
    b: i64,
}

impl Holder {
    fn peek_a<'a>(self: &'a Holder) -> &'a i64 {
        return &self.a;
    }
}

fn main() -> i64 {
    var h: Holder = Holder { a: 5, b: 6 };
    val r = h.peek_a();
    h.a = 7;
    println(*r);
    return 0;
}
