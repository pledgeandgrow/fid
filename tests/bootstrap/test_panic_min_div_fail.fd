// Expected to fail at run time: i64::MIN / -1 overflows and panics on every
// backend and target (x86-64 traps on it, AArch64 and RISC-V give MIN;
// release F6). Compared across targets by scripts/cross-test.sh.

fn div(a: i64, b: i64) -> i64 {
    return a / b;
}

fn main() {
    val min: i64 = 0 - 9223372036854775807 - 1;
    print("before\n");
    val r = div(min, 0 - 1);
    print(r);
    print("unreachable\n");
}
