// LG3: a struct with a lifetime parameter holds a reference in a field.
// A value of it borrows what its fields point to (the borrow checker) and
// is rooted there (the escape check): it may be built, passed, returned
// from a function whose lifetimes say where it points, and read through.
// Expected output:
// 7
// 3
// 13
// 3
// 6
struct View<'a> {
    r: &'a i64,
    k: i64,
}

fn make<'a>(x: &'a i64, k: i64) -> View<'a> {
    return View { r: x, k: k };
}

fn read<'a>(v: &View<'a>) -> &'a i64 {
    return v.r;
}

impl<'a> View<'a> {
    fn total(self: &View<'a>) -> i64 {
        return *self.r + self.k;
    }
}

fn main() -> i64 {
    var a: i64 = 5;
    var b: i64 = 1;
    val v = View { r: &a, k: 2 };
    println(*v.r + v.k);
    b = 3;
    println(b);
    val w = make(&b, 10);
    println(w.total());
    val q = read(&w);
    println(*q);
    a = 6;
    println(a);
    return 0;
}
