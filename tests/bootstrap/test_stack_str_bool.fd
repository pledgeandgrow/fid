// LF13 (compiler/lower.fd lw_rc_stack_strs_fn, stdlib/core.fd
// Bool_to_str_into, Nov 22): a local bool interpolation (the lowerer's
// p_bool_to_str conversion in an f-string) that only lives in its
// function is built in a 128-byte stack area, as int_to_str strings are
// (Int_to_str_into): [P_STR_STATIC][len] bytes NUL, the heap
// p_bool_to_str only when the area cannot be used. stdlib bool_to_str
// returns the literals directly (no producer); the allocating path is
// f-strings (and printing a bool).
//
// Expected output:
// b=true
// f=false
// 6
// 7
// yes:true!

fn main() {
    var b: bool = true;
    var s: str = f"b={b}";
    println(s);
    var f: bool = 1 == 2;
    var t: str = f"f={f}";
    println(t);
    println(str_len(s));
    println(str_len(t));
    var u: str = f"yes:{b}";
    println(u + "!");
}
