// stdlib/tz: named time zones with daylight saving (competitive SL8),
// checked against Python's zoneinfo (the IANA database): both
// hemispheres, the instants around a change, half-hour offsets, the
// conversion back from a local clock (skipped and repeated hours).
//
// Expected output:
// America/New_York 2026-07-04 12:00 EDT -04:00
// America/New_York 2026-01-15 07:00 EST -05:00
// Europe/Paris 2026-03-29 01:59 CET +01:00
// Europe/Paris 2026-03-29 03:00 CEST +02:00
// Australia/Sydney 2026-01-10 11:00 AEDT +11:00
// Australia/Sydney 2026-06-10 10:00 AEST +10:00
// Asia/Kolkata 2026-06-01 05:30 IST +05:30
// Pacific/Auckland 2026-12-25 13:00 NZDT +13:00
// America/Santiago 2026-01-01 09:00 -03 -03:00
// local 12:00 EDT is 16:00 UTC
// skipped 02:30 reads as 03:30 EDT
// repeated 01:30 reads as 01:30 EDT
// 2026-07-04T18:00:00+02:00
// +05:30 fixed: 2026-06-01 05:30
use tz;
use time;
use datetime;

fn show(zone: str, y: i64, mo: i64, d: i64, h: i64, mi: i64) {
    var z: Tz = tz_find(zone);
    var t: LogicalTime = time_new(y, mo, d, h, mi, 0);
    println(zone + " " + tz_format(t, z, "%Y-%m-%d %H:%M %Z %z"));
}

fn main() -> i64 {
    show("America/New_York", 2026, 7, 4, 16, 0);
    show("America/New_York", 2026, 1, 15, 12, 0);
    show("Europe/Paris", 2026, 3, 29, 0, 59);
    show("Europe/Paris", 2026, 3, 29, 1, 0);
    show("Australia/Sydney", 2026, 1, 10, 0, 0);
    show("Australia/Sydney", 2026, 6, 10, 0, 0);
    show("Asia/Kolkata", 2026, 6, 1, 0, 0);
    show("Pacific/Auckland", 2026, 12, 25, 0, 0);
    show("America/Santiago", 2026, 1, 1, 12, 0);
    var ny: Tz = tz_find("America/New_York");
    var u: LogicalTime = tz_from_local(time_new(2026, 7, 4, 12, 0, 0), ny);
    println("local 12:00 EDT is " + dt_format(u, "%H:%M") + " UTC");
    // 2026-03-08 02:30 does not exist in New York
    var g: LogicalTime = tz_from_local(time_new(2026, 3, 8, 2, 30, 0), ny);
    println("skipped 02:30 reads as " + tz_format(g, ny, "%H:%M %Z"));
    // 2026-11-01 01:30 happens twice
    var rp: LogicalTime = tz_from_local(time_new(2026, 11, 1, 1, 30, 0), ny);
    println("repeated 01:30 reads as " + tz_format(rp, ny, "%H:%M %Z"));
    println(tz_to_iso(time_new(2026, 7, 4, 16, 0, 0), tz_find("Europe/Berlin")));
    println("+05:30 fixed: " + tz_format(time_new(2026, 6, 1, 0, 0, 0), tz_find("+05:30"), "%Y-%m-%d %H:%M"));
    return 0;
}
