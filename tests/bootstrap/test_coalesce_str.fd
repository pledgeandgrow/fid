// known-bugs 2g.54: `a ?? b` has the type of the Option's payload. On an
// Option<str> it was an i64 unless bound to a `str` variable: println
// printed a pointer through C and native, and `"x: " + (o ?? "n")` printed
// an empty line under `fid run` and crashed a C build. An Option<f64>
// printed the bits of its float.
//
// Expected output:
// ann
// x
// name: ann
// name: n
// q
// bob!
// len 3
// 2.5
// 1.25
// z 0.5
// 7
// 99
// w: who
use core;

fn name(k: i64) -> Option<str> {
    if k > 0 {
        return Option::Some("ann");
    }
    return Option::None;
}

fn built(k: i64) -> Option<str> {
    if k > 0 {
        return Option::Some("bo" + "b");
    }
    return Option::None;
}

fn fl(k: i64) -> Option<f64> {
    if k > 0 {
        return Option::Some(2.5);
    }
    return Option::None;
}

fn num(k: i64) -> Option<i64> {
    if k > 0 {
        return Option::Some(k);
    }
    return Option::None;
}

fn main() -> i64 {
    println(name(1) ?? "x");
    println(name(0) ?? "x");
    println("name: " + (name(1) ?? "n"));
    println("name: " + (name(0) ?? "n"));
    val s = name(0) ?? "q";
    println(s);
    val b = built(1) ?? "none";
    println(b + "!");
    println("len " + int_to_str(str_len(name(1) ?? "")));
    println(fl(1) ?? 1.25);
    println(fl(0) ?? 1.25);
    val z = fl(0) ?? 0.5;
    print("z ");
    println(z);
    println(num(7) ?? 99);
    println(num(0) ?? 99);
    var who: str = name(0) ?? "who";
    println("w: " + who);
    return 0;
}
