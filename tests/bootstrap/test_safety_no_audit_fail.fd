// Test: @medical requires @audit (expected FAIL)
// @medical expands to @requires-audit, so missing @audit is a compile error
// (@dal-a was merged into @medical — identical expansion)

@medical
fn flight_control(input: i64) -> i64 {
    return input * 2;
}

fn main() -> i64 {
    val r = flight_control(42);
    print(r);
    return 0;
}
