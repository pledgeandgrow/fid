// == on structs and enums compares content (proposal 0001): fields one by
// one, nested structs and enums through their own ==, strings by text.
struct Pt {
    x: i64,
    y: i64,
}

struct Named {
    name: str,
    at: Pt,
}

enum Shape {
    Dot(Pt),
    Line(Pt, Pt),
    Empty,
}

fn main() -> i64 {
    val a: Pt = Pt { x: 1, y: 2 };
    val b: Pt = Pt { x: 1, y: 2 };
    val c: Pt = Pt { x: 1, y: 3 };
    println(a == b);
    println(a == c);
    println(a != c);
    val n1: Named = Named { name: "home", at: a };
    val n2: Named = Named { name: "ho" + "me", at: b };
    val n3: Named = Named { name: "home", at: c };
    println(n1 == n2);
    println(n1 == n3);
    println(Shape::Line(a, c) == Shape::Line(b, c));
    println(Shape::Line(a, c) == Shape::Line(c, a));
    println(Shape::Dot(a) == Shape::Empty);
    println(Shape::Empty == Shape::Empty);
    return 0;
}
