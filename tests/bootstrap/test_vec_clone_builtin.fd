// A clone owns its elements: changing it leaves the original alone
fn main() -> i64 {
    var a: Vec<i64> = Vec::new();
    a.push(1);
    a.push(2);
    var b: Vec<i64> = a.clone();
    b.set(0, 99);
    b.push(3);
    println(a.get(0));
    println(a.len());
    println(b.get(0));
    println(b.len());
    var c: Vec<i64> = p_vec_clone(a);
    c.set(1, 77);
    println(a.get(1));
    println(c.get(1));
    return 0;
}
