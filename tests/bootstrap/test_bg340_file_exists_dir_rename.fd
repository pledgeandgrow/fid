// Bugs roadmap BG340: on `emit --nat` Windows `p_file_exists` of a
// directory was true and `p_rename` onto an existing file replaced it,
// while run, C and pe_ir say false and fail the rename (Windows rename()).
// The Windows layer of the machine runtime (stdlib/linux_runtime/win.fd
// renameat2: MoveFileEx without MOVEFILE_REPLACE_EXISTING; base.fd
// pert_file_exists: a directory is no file there) now agrees.
// Windows only: on Linux and macOS fopen opens a directory and rename()
// replaces the target on every backend, so those variants print the
// Windows text and every lane agrees.
//
// Expected output:
// false
// -1 1
// true

@cfg(windows)
fn check() {
    p_mkdir("bg340_d");
    println(f"{p_file_exists("bg340_d")}");
    p_file_write("bg340_a.txt", "22");
    p_file_write("bg340_b.txt", "1");
    println(f"{p_rename("bg340_a.txt", "bg340_b.txt")} {p_file_size("bg340_b.txt")}");
    println(f"{p_file_exists("bg340_a.txt")}");
    p_file_delete("bg340_a.txt");
    p_file_delete("bg340_b.txt");
    p_rmdir("bg340_d");
}

@cfg(linux)
fn check() {
    println("false");
    println("-1 1");
    println("true");
}

@cfg(macos)
fn check() {
    println("false");
    println("-1 1");
    println("true");
}

fn main() {
    check();
}
