// expect-error: is a variant of enum 'Option', but the value matched is a 'i64', which is no enum
// Bugs roadmap BG393: an enum pattern against a scrutinee that is no enum
// was accepted: Vec's pop() gives the element, not an Option, so this
// matched the word 7 as an Option (it printed "some 0").
fn main() {
    var w: Vec<i64> = Vec::new();
    w.push(7);
    match w.pop() {
        Option::Some(x) => {
            println(f"some {x}");
        }
        Option::None => {
            println("none");
        }
    }
}
