// A str captured by a returned closure keeps an owner (S4: the closure read
// the string after its scope freed it). Expected output:
// 8
// 9
// 12

fn by_closure() -> fn(i64) -> i64 {
    val s: str = "1234567" + int_to_str(8);
    return fn(x: i64) { str_len(s) + x - 1 };
}

fn churn() -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        val junk: str = "xxxxxxxxxxxx" + int_to_str(i);
        t = t + str_len(junk);
        i = i + 1;
    }
    return t;
}

fn main() -> i64 {
    val add = by_closure();
    println(add(1));
    churn();
    println(add(2));
    println(add(5));
    return 0;
}
