// CD8 (complaint roadmap): comptime code may compute freely; only I/O is
// rejected. A comptime fn with loops and a comptime block of arithmetic and
// strings are evaluated by the compiler.
// Expected output:
// 55
// 36
// fid-2026

comptime fn tri(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fn main() -> i64 {
    println(int_to_str(comptime tri(10)));
    val sq = comptime {
        val a = 6;
        a * a;
    };
    println(int_to_str(sq));
    val tag = comptime "fid-" + "2026";
    println(tag);
    return 0;
}
