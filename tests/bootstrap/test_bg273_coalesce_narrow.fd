// BG273 (docs/roadmap/bugs-roadmap.md): `opt ?? d` on an Option of a narrow
// integer or of bool, used directly, gives the payload as its own type
// (`Some(-1i8) ?? 0` was 255, `Some(-42i32) ?? 5` 4294967254, and a bool
// printed 1 or junk).
//
// Expected output:
// -42 -1
// 5 7
// true false
// -30

fn id32(x: i32) -> i32 {
    return x;
}

fn id8(x: i8) -> i8 {
    return x;
}

fn main() {
    val oi: Option<i32> = Option::Some(id32(-42));
    val o8: Option<i8> = Option::Some(id8(-1));
    println(f"{oi ?? 5} {o8 ?? 0}");
    val ni: Option<i32> = Option::None;
    val n16: Option<u16> = Option::None;
    println(f"{ni ?? 5} {n16 ?? 7}");
    val ob: Option<bool> = Option::Some(true);
    val nb: Option<bool> = Option::None;
    println(f"{ob ?? false} {nb ?? false}");
    val w: i64 = ((o8 ?? 0) as i64) * 30;
    println(f"{w}");
}
