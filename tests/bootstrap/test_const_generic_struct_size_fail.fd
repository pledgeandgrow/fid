// expect-error: function 'first_of_2' parameter 1 expects 'Matrix<i64, __const_2>', got 'Matrix<i64, __const_3>'
// L8A: the number given for a struct's const parameter is part of its
// type: a Matrix<i64, 3> is not a Matrix<i64, 2>. Before, the sizes were
// not compared and the call was accepted.

struct Matrix<T, const N: usize> {
    data: Vec<T>,
}

fn first_of_2(m: Matrix<i64, 2>) -> i64 {
    return m.data.get(0);
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    val a: Matrix<i64, 3> = Matrix { data: v };
    println(first_of_2(a));
    return 0;
}
