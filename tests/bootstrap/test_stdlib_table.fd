// stdlib/test table tests (competitive SL13): named rows, every row run
// after a failure, the failures listed by row, the int/str/bool checks,
// and table_done's summary. The failing table is inspected rather than
// finished (table_done panics on it, as it must under `fid test`).
// FIDES_ROW is not set here, so every row runs.
//
// Expected output:
// table parse_int: 4 passed
// failing table: 2 failed, 1 passed
// broken/minus: got -12, want 12
// broken/upper: got "ABC", want "abd"
// table bools: 2 passed
// table ok
use test;

fn main() -> i64 {
    var t: TableTest = table_new("parse_int");
    table_int(& mut t, "zero", str_parse_int("0"), 0);
    table_int(& mut t, "positive", str_parse_int("42"), 42);
    table_int(& mut t, "negative", str_parse_int("-12"), - 12);
    table_str(& mut t, "trim", str_trim("  a "), "a");
    if table_failed(& t) != 0 {
        p_panic("table: a passing row failed");
    }
    if table_done(t) != 4 {
        p_panic("table: wrong pass count");
    }

    var f: TableTest = table_new("broken");
    val r1: bool = table_int(& mut f, "minus", str_parse_int("-12"), 12);
    val r2: bool = table_str(& mut f, "upper", str_to_upper("abc"), "abd");
    val r3: bool = table_bool(& mut f, "true", 1 < 2, true);
    if r1 || r2 || !r3 {
        p_panic("table: wrong row results");
    }
    println("failing table: " + int_to_str(table_failed(& f)) + " failed, " + int_to_str(f.passed) + " passed");
    var i: i64 = 0;
    while i < f.failures.len() {
        println(f.name + "/" + f.failures.get(i));
        i = i + 1;
    }

    var b: TableTest = table_new("bools");
    table_bool(& mut b, "and", true && false, false);
    table_bool(& mut b, "or", true || false, true);
    table_done(b);
    println("table ok");
    return 0;
}
