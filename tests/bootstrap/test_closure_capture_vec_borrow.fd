// B19: a closure that captures a Vec and changes it is not a borrow
// conflict with its own capture. The borrow checker recorded a shared
// borrow for the capture before checking the body, so `v.push(x)` in the
// body was refused with "cannot mutate v: shared borrow(s) are active".
// Expected output:
// 4
// 6

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    val add = |x: i64| -> i64 {
        v.push(x);
        return v.len();
    };
    println(add(9));
    val total = |k: i64| -> i64 {
        var s: i64 = 0;
        for i in 0..k {
            s = s + v.get(i);
        }
        return s;
    };
    println(total(3));
}
