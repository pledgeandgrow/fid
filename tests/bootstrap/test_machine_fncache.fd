// Track SP (docs/roadmap/llvm-roadmap.md), SP6/SP7/SP20: the per-function
// native cache (FID_FNCACHE, compiler/nat_ir.fd nc_*). A cache hit records
// nothing, so its skeleton asks again, in the recording's order, for the
// labels the recording asked for (nc_log / nc_log_replay): strings, globals,
// functions and functions named by strings (a task's entry, found by name
// at run time). This program has each kind in functions that hit on the
// second build; tests/nattools/machine_batch7_check.sh builds it on a miss
// and on a hit and requires identical bytes, and the same output as
// `fid run`. Before, a hit's strings came later in the data (a different
// image) and a task entry named only by a hit was missing from the
// function table.
// Expected output:
// task 42
// task 84
// red green blue
// 3
// counter 7
// done

var counter: i64 = 4;
var label: str = "counter";

async fn work(x: i64) -> Future<i64> {
    return x * 2;
}

fn colours() -> str {
    return "red" + " " + "green" + " " + "blue";
}

fn bump(n: i64) -> i64 {
    counter = counter + n;
    return counter;
}

fn count_words(s: str) -> i64 {
    var n: i64 = 1;
    var i: i64 = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) == 32 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn run_tasks() {
    val t1 = spawn work(21);
    val t2 = spawn work(42);
    val a = await t1;
    val b = await t2;
    println("task " + int_to_str(a));
    println("task " + int_to_str(b));
}

fn main() -> i64 {
    run_tasks();
    val c = colours();
    println(c);
    println(count_words(c));
    bump(3);
    println(label + " " + int_to_str(counter));
    println("done");
    return 0;
}
