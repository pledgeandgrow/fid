// BG57 (docs/roadmap/bugs-roadmap.md): the machine layer's load-after-store
// forwarding (compiler/nat_ir.fd ng_mir_emit, TG17 "ldfwd") remembers that
// the register a spilled value was just stored from still holds it, so the
// next instruction reads the register instead of the slot. When that
// instruction also took a value from a float register into the same spill
// scratch register (MI25: an operation on general registers reading a
// float), the register no longer held the stored value, yet a later
// operand of the instruction was still forwarded from it. Now the move
// into that register forgets the forward. Here f64 values in float
// registers go to calls and Vec words (general registers) while eight
// integers stay live, so some are spilled next to them.
//
// Expected output:
// 4 6 9 13
// 24 117 141 137
// 2.5 2.75 7.5625 5.0625
// 17.875 7.5625
// 376.75 517
// 451

fn blend(n: i64, x: f64) {
    val a: i64 = n + 1;
    val b: i64 = n * 2;
    val c: i64 = n * 3;
    val d: i64 = n + 10;
    val e: i64 = a * b;
    val f: i64 = c * d;
    val g: i64 = e + f;
    val h: i64 = g - a;
    val p: f64 = x * 2.0;
    val q: f64 = p + 0.25;
    val r: f64 = q * q;
    val s: f64 = r - p;
    var v: Vec<f64> = Vec::new();
    v.push(p);
    v.push(q);
    v.push(r);
    v.push(s);
    var sum: f64 = 0.0;
    var k: i64 = 0;
    while k < v.len() {
        sum = sum + v.get(k);
        k = k + 1;
    }
    val t: f64 = (h as f64) * q;
    val u: i64 = (t as i64) + g;
    print(a);
    print(" ");
    print(b);
    print(" ");
    print(c);
    print(" ");
    println(d);
    print(e);
    print(" ");
    print(f);
    print(" ");
    print(g);
    print(" ");
    println(h);
    print(p);
    print(" ");
    print(q);
    print(" ");
    print(r);
    print(" ");
    println(s);
    print(sum);
    print(" ");
    println(v.get(2));
    print(t);
    print(" ");
    println(u);
    println(a + b + c + d + e + f + g + h);
}

fn main() -> i64 {
    blend(3, 1.25);
    return 0;
}
