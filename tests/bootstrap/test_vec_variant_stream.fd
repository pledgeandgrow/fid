// Proposal 0008 stage 1 (FID_CONTIGUOUS=1): Vec<E..> — a variant stream.
// Each element at exactly its variant's size (Dot is a size word and a tag
// against the fixed mode's 3 payload words), built with push, read with
// get/last/len. The gate: without FID_CONTIGUOUS=1 the type is rejected.
//
// Expected output:
// 3
// dot rect 3x4 circle 1
// 7 42
// true

enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Dot,
}

fn name_of(s: Shape) -> str {
    match s {
        Shape::Circle(r) => {
            return "circle " + int_to_str(r as i64);
        }
        Shape::Rect(w, h) => {
            return "rect " + int_to_str(w as i64) + "x" + int_to_str(h as i64);
        }
        Shape::Dot => {
            return "dot";
        }
    }
    return "";
}

fn main() -> i64 {
    var packed: Vec<Shape..> = VecV::new();
    packed.push(Shape::Dot);
    packed.push(Shape::Rect(3.0, 4.0));
    packed.push(Shape::Circle(1.5));
    println(int_to_str(packed.len()));
    var i: i64 = 0;
    var words: str = "";
    while i < packed.len() {
        if i > 0 {
            words = words + " ";
        }
        words = words + name_of(packed.get(i));
        i = i + 1;
    }
    println(words);
    // last, and match directly on a get
    match packed.last() {
        Shape::Circle(r2) => {
            println("7 " + int_to_str((r2 * 2.0) as i64) + " " + int_to_str((r2 * 28.0) as i64));
        }
        _ => {
            println("not circle");
        }
    }
    var empty_ok: bool = false;
    if !packed.is_empty() {
        match packed.get(0) {
            Shape::Dot => {
                empty_ok = true;
            }
            _ => {
            }
        }
    }
    if empty_ok {
        println("true");
    } else {
        println("false");
    }
    return 0;
}
