// expect-error: a unit combines with an f64 or another unit, got i64
// CL10 (fid): an integer times a unit is an error (a unit holds an f64:
// write `2.0 * d`).

@dimension(m = 1)
struct Len {
    value: f64,
}

fn main() -> i64 {
    val d: Len = Len { value: 3.0 };
    val x: Len = 2 * d;
    println(int_to_str(x.value as i64));
    return 0;
}
