// expect-error: is @realtime but has effect '!IO' which may block
// TL2: a diagnostic per check. A @realtime function may not block, and a
// write to the console can.

@realtime
fn tick(x: i64) -> i64 {
    println("tick");
    return x + 1;
}

fn main() -> i64 {
    println(int_to_str(tick(1)));
    return 0;
}
