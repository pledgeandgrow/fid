// VF5, rematerialization in the machine layer's allocator
// (compiler/nat_ir.fd, `FID_NAT_OFF=remat`): a spilled value defined once
// by a constant (or a global's or a slot's address) is computed again where
// it is used instead of being stored and reloaded. Here more values live at
// once than there are registers, across calls, so some of them spill: the
// constants among them may be rematerialized, but a variable that starts
// as a constant and is changed later must not be (its later value would be
// replaced by the starting constant), and each constant must come back
// with its own value. Every line prints sums that change when either goes
// wrong. scripts/verify/variants.py's mutants remat-value-off-by-one and
// remat-multi-def break it.
//
// Expected output:
// 2310
// 210 4096
// 1260
// 777

fn touch(x: i64) -> i64 {
    return x + 1 - 1;
}

fn many_constants(n: i64) -> i64 {
    val c1: i64 = 11;
    val c2: i64 = 22;
    val c3: i64 = 33;
    val c4: i64 = 44;
    val c5: i64 = 55;
    val c6: i64 = 66;
    val c7: i64 = 77;
    val c8: i64 = 88;
    val c9: i64 = 99;
    val c10: i64 = 110;
    val c11: i64 = 121;
    val c12: i64 = 132;
    val c13: i64 = 143;
    val c14: i64 = 154;
    val c15: i64 = 165;
    val c16: i64 = 176;
    val c17: i64 = 187;
    val c18: i64 = 198;
    val c19: i64 = 209;
    val c20: i64 = 220;
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        acc = acc + touch(i);
        i = i + 1;
    }
    val s: i64 = c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13 + c14 + c15 + c16 + c17 + c18 + c19 + c20;
    return s + acc * 0;
}

fn changed_later(n: i64) -> str {
    // each starts as a constant and is stepped in the loop
    var v1: i64 = 1;
    var v2: i64 = 2;
    var v3: i64 = 3;
    var v4: i64 = 4;
    var v5: i64 = 5;
    var v6: i64 = 6;
    var v7: i64 = 7;
    var v8: i64 = 8;
    var v9: i64 = 9;
    var v10: i64 = 10;
    var v11: i64 = 11;
    var v12: i64 = 12;
    var v13: i64 = 13;
    var v14: i64 = 14;
    var v15: i64 = 15;
    var v16: i64 = 16;
    var v17: i64 = 17;
    var v18: i64 = 18;
    var v19: i64 = 19;
    var v20: i64 = 20;
    var p: i64 = 1;
    var i: i64 = 0;
    while i < n {
        p = touch(p * 2);
        i = i + 1;
    }
    if n > 0 {
        v1 = v1 + p * 0;
        v20 = v20 + 0;
    }
    val s: i64 = v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19 + v20;
    return int_to_str(s) + " " + int_to_str(p);
}

fn stepped(n: i64) -> i64 {
    var a: i64 = 100;
    var b: i64 = 200;
    var c: i64 = 300;
    var d: i64 = 400;
    var e: i64 = 500;
    var f: i64 = 600;
    var g: i64 = 700;
    var h: i64 = 800;
    var k: i64 = 900;
    var m: i64 = 1000;
    var o: i64 = 1100;
    var q: i64 = 1200;
    var r: i64 = 1300;
    var t: i64 = 1400;
    var i: i64 = 0;
    while i < n {
        a = a + touch(1);
        b = b + touch(2);
        c = c + touch(3);
        d = d + touch(4);
        e = e + touch(5);
        f = f + touch(6);
        g = g + touch(7);
        h = h + touch(8);
        k = k + touch(9);
        m = m + touch(10);
        o = o + touch(11);
        q = q + touch(12);
        r = r + touch(13);
        t = t + touch(14);
        i = i + 1;
    }
    return a + b + c + d + e + f + g + h + k + m + o + q + r + t - 10500 + n * 0;
}

fn main() -> i64 {
    println(many_constants(4));
    println(changed_later(12));
    println(stepped(12));
    // a constant spilled across a call, then compared with itself
    val big: i64 = 777;
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < 3 {
        acc = acc + touch(i);
        i = i + 1;
    }
    if big == 777 && acc == 3 {
        println(big);
    } else {
        println(0);
    }
    return 0;
}
