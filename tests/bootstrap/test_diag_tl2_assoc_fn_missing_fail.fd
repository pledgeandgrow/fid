// expect-error: no associated function 'make' on struct 'P'
//! error: no associated function 'make' on struct 'P'
// TL2: a test per diagnostic of the type, borrow and escape checks.
// `S::f(...)` calls a function of an impl of S.

struct P {
    x: i64,
}

impl P {
    pub fn new(x: i64) -> P {
        return P { x: x };
    }
}

fn main() -> i64 {
    val p = P::make(3);
    println(p.x);
    return 0;
}
