// Bugs roadmap BG476: stdlib/encoding.fd utf8_len skipped a whole
// sequence by its lead byte without checking it (utf8_seq_ok, BG215), so
// an overlong, surrogate or out-of-range sequence counted as one
// character while utf8_decode gave one U+FFFD per byte. Each pair below is
// utf8_len and utf8_decode(...).len(); they now agree.
//
// Expected output:
// e09f80 3 3
// eda080 3 3
// f08f8080 4 4
// f4908080 4 4
// c3a9 1 1
// e282ac 1 1
// 61c3 2 2
// c328 2 2

use encoding;

fn both(h: str) -> str {
    val s: str = enc_bytes_to_str(hex_decode_bytes(h));
    return f"{h} {utf8_len(s)} {utf8_decode(s).len()}";
}

fn main() {
    println(both("e09f80"));
    println(both("eda080"));
    println(both("f08f8080"));
    println(both("f4908080"));
    println(both("c3a9"));
    println(both("e282ac"));
    println(both("61c3"));
    println(both("c328"));
}
