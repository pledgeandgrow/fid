// Vec<f64> elements are read back as floats (they were read as raw bits), and
// an integer returned from an `-> f64` function is converted (it was not).
fn sum(v: Vec<f64>) -> f64 {
    var s: f64 = 0.0;
    for x in v { s = s + x; }
    return s;
}

fn one() -> f64 { return 1; }
fn two() -> f64 { 2 }

fn main() {
    var v: Vec<f64> = Vec::new();
    v.push(1.5);
    v.push(2.25);
    v.push(-0.5);
    assert_msg(v[0] == 1.5, "index read");
    assert_msg(v.get(1) == 2.25, "get read");
    val x: f64 = v[2];
    assert_msg(x == -0.5, "read into an f64 local");
    assert_msg(v[0] + v[1] == 3.75, "arithmetic on elements");
    assert_msg(sum(v) == 3.25, "for loop over a Vec<f64>");
    v[0] = 10.0;
    v.set(1, 20.0);
    assert_msg(v[0] + v.get(1) == 30.0, "index assign and set");
    assert_msg(v.pop() == -0.5, "pop");
    assert_msg(v.len() == 2, "len after pop");
    assert_msg(one() + 0.5 == 1.5, "return 1 from -> f64");
    assert_msg(two() + 0.25 == 2.25, "tail 2 from -> f64");
    print("vec f64 OK
");
}
