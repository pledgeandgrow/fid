// stdlib/vorbis: Ogg pages/CRC/packets of real libvorbis files, re-encoded pages, Vorbis headers, codebook and IMDCT checks, mono and coupled-stereo decode vs ffmpeg, floor 0 (bark map, LSP curve vs the spec formula, a generated floor-0 stream vs ffmpeg)
// Expected output:
// ogg crc of 123456789: 89a1897f
// ilog 0 1 2 3 4 7 8 255: 0 1 2 2 3 3 4 8
// lookup1_values 81,4 = 3 80,4 = 2 1000,3 = 10 6561,8 = 3
// float32_unpack 1 -1.5
// spec codebook decodes: 5 0 7 3 0 0 -1
// over-specified lengths 1 1 1 rejected: yes
// imdct 32 matches the direct sum within 1e-12: yes
// mono page 0: type 2 granule 0 serial 00000000 segments 1 body 30 crc 64c1da11 ok
// mono page 1: type 0 granule 0 serial 00000000 segments 11 body 2524 crc 193932d2 ok
// mono page 2: type 4 granule 800 serial 00000000 segments 5 body 80 crc 5d9cab02 ok
// mono pages re-encoded byte for byte: yes
// mono packets: 30 48 2476 18 16 16 17 13 last granule 800
// mono re-paginated into 8 pages, same packets: yes
// stereo page 0: type 2 granule 0 serial 00000000 segments 1 body 30 crc 20007ee7 ok
// stereo page 1: type 0 granule 0 serial 00000000 segments 12 body 2691 crc ca6459ca ok
// stereo page 2: type 4 granule 1323 serial 00000000 segments 7 body 354 crc 0c4eb33f ok
// stereo pages re-encoded byte for byte: yes
// stereo packets: 30 48 2643 55 49 47 45 47 52 59 last granule 1323
// stereo re-paginated into 10 pages, same packets: yes
// damaged: bad CRC on page 1
// junk header: not a Vorbis identification header
// mono: 1 ch 8000 Hz, vendor ffmpeg [encoder=Lavc libvorbis], 5 audio packets, 800 samples per channel
// mono first values: 0.0060 0.1134 0.0736 -0.0715 -0.1214 0.0011 0.1217 0.0721
// mono matches ffmpeg at 20 points within 1e-6: yes
// stereo: 2 ch 11025 Hz, vendor ffmpeg [encoder=Lavc libvorbis], 7 audio packets, 1323 samples per channel
// stereo first values: -0.0009 0.0047 0.2494 -0.2290 -0.3824 0.1649 0.3616 -0.3910
// stereo matches ffmpeg at 46 points within 1e-6: yes
// floor 0 bark maps 128/8000/64: 0 1 5 21 48 63 sum 5422; 256/8000/64: 0 0 2 11 48 63 sum 10873; 1024/44100/256: 0 2 10 41 229 255 sum 214699
// floor 0 curve; order 7: 256 values, spec formula within 1e-12 yes, uniform LSPs flat at 1 yes; order 8: 256 values, spec formula within 1e-12 yes, uniform LSPs flat at 1 yes
// floor 0: 1 ch 8000 Hz, vendor fides floor0 test, 8 audio packets, 1344 samples per channel
// floor 0 first values: -0.0277 -0.0653 -0.0873 0.2423 -0.0939 -0.1420 -0.1242 0.1745
// floor 0 matches ffmpeg at 40 points within 1e-6: yes
use vorbis;
use encoding;
use math;

// x rounded to d decimals ("-" only when the rounded value is not zero)
fn fx(x: f64, d: i64) -> str {
    var scale: i64 = 1;
    var i: i64 = 0;
    while i < d {
        scale = scale * 10;
        i = i + 1;
    }
    var neg: bool = x < 0.0;
    var a: f64 = x;
    if neg { a = 0.0 - x; }
    val n: i64 = (a * (scale as f64) + 0.5) as i64;
    if n == 0 { neg = false; }
    var s: str = int_to_str(n / scale);
    if d > 0 {
        var fr: str = int_to_str(n % scale);
        while str_len(fr) < d { fr = "0" + fr; }
        s = s + "." + fr;
    }
    if neg { return "-" + s; }
    return s;
}

fn hex32(v: i64) -> str {
    var s: str = "";
    var k: i64 = 7;
    while k >= 0 {
        s = s + char_to_str(str_byte_at("0123456789abcdef", (v >> (4 * k)) & 15));
        k = k - 1;
    }
    return s;
}

fn same_bytes(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    if a.len() != b.len() { return false; }
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != b.get(i) { return false; }
        i = i + 1;
    }
    return true;
}

// Ogg layer: pages, CRCs, page re-encoding, packets, re-pagination
fn ogg_checks(name: str, bytes: &Vec<i64>) {
    var at: i64 = 0;
    var all_same: bool = true;
    while at < bytes.len() {
        val p: OggPage = ogg_parse_page(bytes, at);
        println(name + " page " + int_to_str(p.seq) + ": type " + int_to_str(p.header_type) + " granule " + int_to_str(p.granule) + " serial " + hex32(p.serial) + " segments " + int_to_str(p.lacing.len()) + " body " + int_to_str(p.body.len()) + " crc " + hex32(p.crc) + if p.crc_ok { " ok" } else { " BAD" });
        val again: Vec<i64> = ogg_page_encode(&p);
        var orig: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < p.size {
            orig.push(bytes.get(at + k));
            k = k + 1;
        }
        if !same_bytes(&again, &orig) { all_same = false; }
        at = at + p.size;
    }
    println(name + " pages re-encoded byte for byte: " + if all_same { "yes" } else { "NO" });
    val st: OggStream = ogg_read(bytes);
    var sizes: str = "";
    var i: i64 = 0;
    while i < st.packets.len() {
        sizes = sizes + " " + int_to_str(st.packets.get(i).len());
        i = i + 1;
    }
    println(name + " packets:" + sizes + " last granule " + int_to_str(st.last_granule));
    var gr: Vec<i64> = Vec::new();
    i = 0;
    while i < st.packets.len() {
        gr.push(st.granules.get(i));
        i = i + 1;
    }
    val repaged: Vec<i64> = ogg_paginate(&st.packets, &gr, st.serial);
    val st2: OggStream = ogg_read(&repaged);
    var same: bool = st2.ok && st2.packets.len() == st.packets.len();
    i = 0;
    while same && i < st.packets.len() {
        if !same_bytes(&st.packets.get(i), &st2.packets.get(i)) { same = false; }
        i = i + 1;
    }
    println(name + " re-paginated into " + int_to_str(st2.pages) + " pages, same packets: " + if same { "yes" } else { "NO" });
}

fn map_line(n: i64, rate: i64, bs: i64) -> str {
    val m: Vec<i64> = vorbis_floor0_map(n, rate, bs);
    var sum: i64 = 0;
    var i: i64 = 0;
    while i < m.len() {
        sum = sum + m.get(i);
        i = i + 1;
    }
    return int_to_str(n) + "/" + int_to_str(rate) + "/" + int_to_str(bs) + ": " + int_to_str(m.get(0)) + " " + int_to_str(m.get(1)) + " " + int_to_str(m.get(5)) + " " + int_to_str(m.get(20)) + " " + int_to_str(m.get(n / 2)) + " " + int_to_str(m.get(n - 1)) + " sum " + int_to_str(sum);
}

// The spec's floor 0 formula written out literally, one line at a time.
fn spec_floor0(map: &Vec<i64>, i: i64, bark_size: i64, amp_bits: i64, amp_offset: i64, amplitude: i64, c: &Vec<f64>) -> f64 {
    val order: i64 = c.len();
    val omega: f64 = math_pi() * (map.get(i) as f64) / (bark_size as f64);
    val w: f64 = math_cos(omega);
    var p: f64 = 0.0;
    var q: f64 = 0.0;
    if (order & 1) == 1 {
        p = 1.0 - w * w;
        var j: i64 = 0;
        while j <= (order - 3) / 2 {
            p = p * 4.0 * (math_cos(c.get(2 * j + 1)) - w) * (math_cos(c.get(2 * j + 1)) - w);
            j = j + 1;
        }
        q = 0.25;
        j = 0;
        while j <= (order - 1) / 2 {
            q = q * 4.0 * (math_cos(c.get(2 * j)) - w) * (math_cos(c.get(2 * j)) - w);
            j = j + 1;
        }
    } else {
        p = (1.0 - w) / 2.0;
        q = (1.0 + w) / 2.0;
        var j: i64 = 0;
        while j <= (order - 2) / 2 {
            p = p * 4.0 * (math_cos(c.get(2 * j + 1)) - w) * (math_cos(c.get(2 * j + 1)) - w);
            q = q * 4.0 * (math_cos(c.get(2 * j)) - w) * (math_cos(c.get(2 * j)) - w);
            j = j + 1;
        }
    }
    val maxamp: f64 = (math_pow(2.0, amp_bits as f64) - 1.0);
    return math_exp(0.11512925 * ((amplitude as f64) * (amp_offset as f64) / (maxamp * math_sqrt(p + q)) - (amp_offset as f64)));
}

fn floor0_checks() {
    println("floor 0 bark maps " + map_line(128, 8000, 64) + "; " + map_line(256, 8000, 64) + "; " + map_line(1024, 44100, 256));
    val map: Vec<i64> = vorbis_floor0_map(256, 8000, 64);
    var res: str = "";
    var order: i64 = 7;
    while order <= 8 {
        // LSP angles, increasing, a little off the uniform spacing
        var c: Vec<f64> = Vec::new();
        var j: i64 = 0;
        while j < order {
            c.push(((j + 1) as f64) * math_pi() / ((order + 1) as f64) + 0.07 * math_sin((j * 5 + 1) as f64));
            j = j + 1;
        }
        val curve: Vec<f64> = vorbis_floor0_curve(&map, 64, 6, 90, 50, &c);
        var worst: f64 = 0.0;
        var i: i64 = 0;
        while i < map.len() {
            val want: f64 = spec_floor0(&map, i, 64, 6, 90, 50, &c);
            val d: f64 = math_fabs(curve.get(i) - want) / want;
            if d > worst { worst = d; }
            i = i + 1;
        }
        // uniform LSPs (j + 1) pi / (order + 1) are those of A(z) = 1, so
        // p + q = |A|^2 = 1, and full amplitude gives exp(0) = 1
        var u: Vec<f64> = Vec::new();
        j = 0;
        while j < order {
            u.push(((j + 1) as f64) * math_pi() / ((order + 1) as f64));
            j = j + 1;
        }
        val flat: Vec<f64> = vorbis_floor0_curve(&map, 64, 6, 90, 63, &u);
        var fw: f64 = 0.0;
        i = 0;
        while i < flat.len() {
            if math_fabs(flat.get(i) - 1.0) > fw { fw = math_fabs(flat.get(i) - 1.0); }
            i = i + 1;
        }
        res = res + "; order " + int_to_str(order) + ": " + int_to_str(curve.len()) + " values, spec formula within 1e-12 " + if worst < 0.000000000001 { "yes" } else { "NO" } + ", uniform LSPs flat at 1 " + if fw < 0.000000001 { "yes" } else { "NO (" + float_to_str(fw) + ")" };
        order = order + 1;
    }
    println("floor 0 curve" + res);
}

fn decode_check(name: str, bytes: &Vec<i64>, step: i64, want: Vec<f64>) {
    val vf: VorbisFile = vorbis_decode_file(bytes);
    if !vf.ok {
        println(name + " decode ERROR " + vf.error);
        return;
    }
    var cm: str = "";
    var i: i64 = 0;
    while i < vf.comments.len() {
        cm = cm + " [" + vf.comments.get(i) + "]";
        i = i + 1;
    }
    println(name + ": " + int_to_str(vf.channels) + " ch " + int_to_str(vf.rate) + " Hz, vendor " + vf.vendor + cm + ", " + int_to_str(vf.packets) + " audio packets, " + int_to_str(vf.pcm.get(0).len()) + " samples per channel");
    var worst: f64 = 0.0;
    var shown: str = "";
    var k: i64 = 0;
    i = 0;
    while k < want.len() {
        var c: i64 = 0;
        while c < vf.channels {
            val got: f64 = vf.pcm.get(c).get(i);
            val d: f64 = math_fabs(got - want.get(k));
            if d > worst { worst = d; }
            if k < 8 { shown = shown + " " + fx(got, 4); }
            k = k + 1;
            c = c + 1;
        }
        i = i + step;
    }
    println(name + " first values:" + shown);
    println(name + " matches ffmpeg at " + int_to_str(want.len()) + " points within 1e-6: " + if worst < 0.000001 { "yes" } else { "NO (" + float_to_str(worst) + ")" });
}

fn main() {
    println("ogg crc of 123456789: " + hex32(ogg_crc(&str_bytes("123456789"))));
    println("ilog 0 1 2 3 4 7 8 255: " + int_to_str(vorbis_ilog(0)) + " " + int_to_str(vorbis_ilog(1)) + " " + int_to_str(vorbis_ilog(2)) + " " + int_to_str(vorbis_ilog(3)) + " " + int_to_str(vorbis_ilog(4)) + " " + int_to_str(vorbis_ilog(7)) + " " + int_to_str(vorbis_ilog(8)) + " " + int_to_str(vorbis_ilog(255)));
    println("lookup1_values 81,4 = " + int_to_str(vorbis_lookup1_values(81, 4)) + " 80,4 = " + int_to_str(vorbis_lookup1_values(80, 4)) + " 1000,3 = " + int_to_str(vorbis_lookup1_values(1000, 3)) + " 6561,8 = " + int_to_str(vorbis_lookup1_values(6561, 8)));
    // float32_unpack: mantissa 1, exponent 788 -> 1.0; mantissa 3, sign, exponent 787 -> -1.5
    println("float32_unpack " + float_to_str(vorbis_float32_unpack((788 << 21) | 1)) + " " + float_to_str(vorbis_float32_unpack(2147483648 | (787 << 21) | 3)));

    // the codebook example of the spec (section 3.2.1): lengths 2 4 4 4 4 2 3 3
    // give codewords 00 0100 0101 0110 0111 10 110 111
    var lens: Vec<i64> = Vec::new();
    lens.push(2); lens.push(4); lens.push(4); lens.push(4); lens.push(4); lens.push(2); lens.push(3); lens.push(3);
    val bk: VbBook = vorbis_book_from_lengths(lens);
    // bits 10 00 111 0110 then zeros, packed LSB first: 0x71 0x03
    var pk: Vec<i64> = Vec::new();
    pk.push(113);
    pk.push(3);
    var br: VbBits = vorbis_bits(pk);
    var dec: str = "";
    var t: i64 = 0;
    while t < 7 {
        dec = dec + " " + int_to_str(vorbis_book_decode(&bk, &mut br));
        t = t + 1;
    }
    println("spec codebook decodes:" + dec);
    var over: Vec<i64> = Vec::new();
    over.push(1); over.push(1); over.push(1);
    println("over-specified lengths 1 1 1 rejected: " + if vorbis_book_from_lengths(over).entries < 0 { "yes" } else { "no" });

    // the fast IMDCT against the defining sum, n = 32
    var x: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < 16 {
        x.push(math_sin((i as f64) * 1.7) * 0.5 + 0.1 * (i as f64));
        i = i + 1;
    }
    val y: Vec<f64> = vorbis_imdct(&x);
    var worst: f64 = 0.0;
    var n: i64 = 0;
    while n < 32 {
        var s: f64 = 0.0;
        var k: i64 = 0;
        while k < 16 {
            s = s + x.get(k) * math_cos(2.0 * math_pi() / 32.0 * ((n as f64) + 0.5 + 8.0) * ((k as f64) + 0.5));
            k = k + 1;
        }
        val d: f64 = math_fabs(s - y.get(n));
        if d > worst { worst = d; }
        n = n + 1;
    }
    println("imdct 32 matches the direct sum within 1e-12: " + if worst < 0.000000000001 { "yes" } else { "NO" });

    val mono: Vec<i64> = hex_decode_bytes("4f67675300020000000000000000000000000000000011dac164011e01766f726269730000000001401f000000000000b03600000000000099014f67" +
        "6753000000000000000000000000000001000000d23239190b30ffffffffffffffffffb503766f726269730600000066666d70656701000000160000" +
        "00656e636f6465723d4c617663206c6962766f726269730105766f726269731242435601000001000c5214212519534a630895525229051d63505b47" +
        "1d63d4394621641053884919a57b4f2a95584ac811525829451d534c534995529629451d631453482153d63165a173144b864909256c4dae74164be8" +
