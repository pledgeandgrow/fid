// BG49 (docs/roadmap/bugs-roadmap.md): pe_ir's p_str_concat
// (compiler/pe_ir_stubs.fd PeirGen_gen_str_concat) copied len(right) + 1
// bytes from the right operand to bring its NUL along: a null right
// operand (length 0, "" as the C runtime treats it) was read through. Now
// it copies len(right) bytes and writes the NUL itself.
// The interpreter keeps `0 as str` as the number 0 (it is not a string
// there), so this runs on the C path and pe_ir.
//@ backends: ccompile,emit
//
// Expected output:
// [ab]
// [ab]
// [abcd]
// 4

fn main() -> i64 {
    val nul: str = 0 as str;
    val a: str = "ab" + nul;
    println("[" + a + "]");
    val b: str = "ab" + "";
    println("[" + b + "]");
    val c: str = a + "cd";
    println("[" + c + "]");
    println(str_len(c));
    return 0;
}
