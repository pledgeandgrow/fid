// L8J: @derive extensions — PartialEq, Eq, Hash
// Test that @derive(PartialEq), @derive(Eq), and @derive(Hash) generate
// the expected free functions on structs.

@derive(PartialEq, Eq, Hash)
struct Point {
    x: i64,
    y: i64,
}

@derive(PartialEq)
struct Color {
    r: i64,
    g: i64,
    b: i64,
}

fn main() {
    val p1 = Point { x: 1, y: 2 };
    val p2 = Point { x: 1, y: 2 };
    val p3 = Point { x: 3, y: 4 };

    // PartialEq / Eq: equals() function
    val eq_same = Point_equals(p1, p2);
    val eq_diff = Point_equals(p1, p3);
    print(eq_same);
    print(eq_diff);

    // Hash: hash() function
    val h1 = Point_hash(p1);
    val h2 = Point_hash(p2);
    val h3 = Point_hash(p3);
    print(h1);
    print(h2);
    print(h3);

    // Color with only PartialEq
    val c1 = Color { r: 255, g: 0, b: 0 };
    val c2 = Color { r: 255, g: 0, b: 0 };
    val c3 = Color { r: 0, g: 0, b: 0 };
    print(Color_equals(c1, c2));
    print(Color_equals(c1, c3));
}
