// expect-error: pattern Shape::Rect binds 1 field(s) but the variant has 2
//! error: pattern Shape::Rect binds 1 field(s) but the variant has 2
// TL2: a test per diagnostic of the type, borrow and escape checks.
// A pattern binds every value of its variant.

enum Shape {
    Circle(i64),
    Rect(i64, i64),
}

fn area(s: Shape) -> i64 {
    match s {
        Shape::Circle(r) => {
            return r * r * 3;
        }
        Shape::Rect(w) => {
            return w;
        }
    }
}

fn main() -> i64 {
    println(area(Shape::Circle(2)));
    return 0;
}
