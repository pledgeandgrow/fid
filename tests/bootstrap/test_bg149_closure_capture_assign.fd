// Bugs roadmap BG149: an assignment to a captured variable inside a closure
// was dropped, right-hand side included (lower.fd Stmt::Assign: a capture is
// neither a slot nor a local of the closure). Captures are by value
// (reference §4.10): the closure's copy in its environment takes the value,
// later reads and calls of the closure see it, and the variable outside
// keeps its own (Lowerer_assign_capture).
//
// Expected output:
// 11
// 12
// 10
// side ran
// 6
// ab
// abb
// a
// 2.5
// 3.5
// 1.5
// 7

fn side() -> i64 {
    println("side ran");
    return 5;
}

fn main() {
    var count: i64 = 10;
    val f = fn(x: i64) -> i64 {
        count = count + x;
        return count;
    };
    println(int_to_str(f(1)));
    println(int_to_str(f(1)));
    println(int_to_str(count));

    var c2: i64 = 10;
    val g = fn(x: i64) -> i64 {
        c2 = side();
        c2 += x;
        return c2;
    };
    println(int_to_str(g(1)));

    // an owned string: the old value is dropped, the new one kept
    var s: str = "a";
    val h = fn() -> str {
        s = s + "b";
        return s;
    };
    println(h());
    println(h());
    println(s);

    // a float
    var t: f64 = 1.5;
    val k = fn() -> f64 {
        t += 1.0;
        return t;
    };
    println(k());
    println(k());
    println(t);

    // read after the assignment in the same call
    var n: i64 = 3;
    val q = fn() -> i64 {
        n = n * 2;
        val m: i64 = n + 1;
        return m;
    };
    println(int_to_str(q()));
}
