// Tooling (docs/roadmap/llvm-roadmap.md DB7, DB8, SP2, SP18, SP20): the
// input of scripts/tooling-check.sh, which runs `fid explain --stages
// sum_to`, `fid emit --remarks`, `--time` on check/dump-c/emit, `fid serve`
// and scripts/repro-check.sh over this file. As a program it prints the
// sums below on every backend.
//
// Expected output:
// 15
// 6

use vec;

fn sum_to(n: i64) -> i64 {
    var total: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fn sum_vec(v: Vec<i64>) -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        total = total + v.get(i);
        i = i + 1;
    }
    return total;
}

fn main() -> i64 {
    print(sum_to(5));
    print("\n");
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    print(sum_vec(v));
    print("\n");
    return 0;
}
