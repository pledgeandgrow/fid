// Tooling (docs/roadmap/llvm-roadmap.md DB7, DB8, SP2, SP18, SP20): the
// input of scripts/tooling-check.sh, which runs `fid explain --stages
// sum_to`, `fid emit --remarks`, `--time` on check/dump-c/emit, `fid serve`
// and scripts/repro-check.sh over this file. As a program it prints the
// sums below on every backend.
//
// Expected output:
// 15
// 6

use vec;

// Recursive on purpose: the mid-end's inline2 (ime_callee_ok) never inlines
// a function that calls itself, so sum_to keeps its own symbol in the
// emitted image for `fid explain --stages` and `fid disasm` to find
// (rl20-db7-check.sh). Output: 15.
fn sum_to(n: i64) -> i64 {
    if n <= 1 {
        return n;
    }
    return n + sum_to(n - 1);
}

fn sum_vec(v: Vec<i64>) -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        total = total + v.get(i);
        i = i + 1;
    }
    return total;
}

fn main() -> i64 {
    print(sum_to(5));
    print("\n");
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    print(sum_vec(v));
    print("\n");
    return 0;
}
