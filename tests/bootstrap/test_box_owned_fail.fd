// expect-error: Tree::Node field 1 expects 'Box<Tree>', got 'Tree'
// Expected to FAIL: storing a bare value where a Box (an owned heap copy) is
// required -- it would keep a pointer into the current stack frame.
enum Tree { Node(Box<Tree>), Leaf }
fn main() {
    val leaf = Tree::Leaf;
    val t = Tree::Node(leaf);   // must be Tree::Node(Box::new(leaf))
    match t { Tree::Node(_) => { print("node"); } Tree::Leaf => { print("leaf"); } }
}
