// Expected to fail: `flip` is @crashfree but not @wrapping, and `-x`
// overflows for the minimum i64 (run and C panic; nat_ir negates without
// a check). The type checker rejects integer unary `-` in such a function,
// as it rejects `+ - *` and `+= -= *=`.

@crashfree
fn flip(x: i64) -> i64 {
    return -x;
}

fn main() {
    println(flip(5));
}
