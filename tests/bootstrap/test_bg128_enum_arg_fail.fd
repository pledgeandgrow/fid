// expect-error: Option::Some field 1 expects 'str'
// Bugs roadmap BG128: an enum literal argument is checked against the
// parameter's type.
fn take(o: Option<str>) { match o { Option::Some(s) => { println(s); } Option::None => { } } }
fn main() -> i64 {
    take(Option::Some(5));
    return 0;
}
