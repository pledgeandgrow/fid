// Miscompile log V1a and V1e: an integer literal on the left of `<<`/`>>`,
// and an operator tree of literals, take the type of their context (the
// other operand, or the declared type of a `val`/`var`), as a bare literal
// does (§3.5, §4.1); the operation is done and overflow-checked at that
// width. A shift's amount gives no type to the literal it shifts.
// tests/verify/bugs/v1a_shl_literal_left_narrow.fd and
// v1e_literal_tree_widens.fd check the panics; this file the values.

fn main() -> i64 {
    var a: u16 = 15;
    // the declared u16: (2 << 15) keeps 16 bits (0), then + 7
    var b: u16 = (2 << a) + 7;
    println(b);
    // the other operand's u16: 2 << 15 is 0 in u16, | 5 is 5
    var c: u16 = 3;
    println((2 << a) | (c + 2));
    // literal trees: `x % ((31 & 15) | 1)` in u32 is `x % 15`
    var five: u32 = 5;
    var z: u32 = 0;
    println(z + five % ((31 & 15) | 1));
    var t: u8 = 200;
    println(t & (0xF0 | 0x0F));
    // a narrow shift amount does not narrow the literal it shifts
    var s: u8 = 40;
    var m: i64 = 1 << s;
    println(m);
    // a u32 mask written with a shifted literal: (1 << 4) - 1 in u32
    var k: u32 = 20;
    var mask: u32 = (1 << 4) - 1;
    println(k & mask);
    return 0;
}
//> 7
//> 5
//> 5
//> 200
//> 1099511627776
//> 4
