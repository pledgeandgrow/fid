// OP3: the mid-end shares its analyses between passes. The CFG of a
// function shape is built once and handed back while no edit changes a
// block or an edge (compiler/checks.fd iro_cfg), the loop tree is kept with
// it (iro_loops), and the use lists are kept between the passes of one
// function until a pass changes it (compiler/iropt.fd iro_uses_entry).
// FID_IROPT_OFF=cfgcache builds every one of them each time. The functions
// below have loops, nested loops, branches that merge and a loop the passes
// change (so a cache must be dropped in the middle of the pipeline); the
// program must print the same with the caches on and off, and
// tests/tooling/cfgcache-check.sh checks the executables are byte-identical
// and that each cache is hit.
//
// Expected output:
// 45
// 111
// 10
// 7
// 7
// 60
// 3628800
// 30

fn tri(n: i64) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < n {
        t = t + i;
        i = i + 1;
    }
    return t;
}

fn collatz_steps(n: i64) -> i64 {
    var x: i64 = n;
    var s: i64 = 0;
    while x != 1 {
        if x % 2 == 0 {
            x = x / 2;
        } else {
            x = 3 * x + 1;
        }
        s = s + 1;
    }
    return s;
}

fn nested_max(n: i64) -> i64 {
    var best: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var j: i64 = 0;
        while j < n {
            var v: i64 = (i * 7 + j * 3) % 11;
            if v > best {
                best = v;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return best;
}

fn gap(a: i64, b: i64) -> i64 {
    if a > b {
        return a - b;
    }
    return b - a;
}

fn sum_vec(v: Vec<i64>) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        // v.len() is the same each time round: LICM may move it out
        t = t + v.get(i) * 2;
        i = i + 1;
    }
    return t;
}

fn fact(n: i64) -> i64 {
    var r: i64 = 1;
    var k: i64 = 2;
    while k <= n {
        r = r * k;
        k = k + 1;
    }
    return r;
}

fn folded() -> i64 {
    // constants the passes fold: the function changes, the caches go
    var a: i64 = 3;
    var b: i64 = a * 4;
    var c: i64 = b + 18;
    return c;
}

fn main() -> i64 {
    println(tri(10));
    println(collatz_steps(27));
    println(nested_max(5));
    println(gap(3, 10));
    println(gap(10, 3));
    var v: Vec<i64> = Vec::new();
    var i: i64 = 1;
    while i <= 5 {
        v.push(i * 2);
        i = i + 1;
    }
    println(sum_vec(v));
    println(fact(10));
    println(folded());
    return 0;
}
