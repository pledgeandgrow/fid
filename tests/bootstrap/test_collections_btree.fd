// Test BTreeMap, BTreeSet, and HashSet from collections.fd
use collections;

// ─── BTreeMap tests ─────────────────────────────────────────────────────

fn test_btreemap_basic() {
    var m = BTreeMap::new();
    m.insert(3, 30);
    m.insert(1, 10);
    m.insert(2, 20);
    
    assert(m.len() == 3);
    assert(m.get(1) == 10);
    assert(m.get(2) == 20);
    assert(m.get(3) == 30);
    assert(m.get(99) == 0);  // not found
    assert(!m.contains(99));
    assert(m.contains(1));
}

fn test_btreemap_update() {
    var m = BTreeMap::new();
    m.insert(1, 10);
    m.insert(1, 100);  // update
    assert(m.len() == 1);
    assert(m.get(1) == 100);
}

fn test_btreemap_remove() {
    var m = BTreeMap::new();
    m.insert(1, 10);
    m.insert(2, 20);
    m.insert(3, 30);
    
    assert(m.remove(2) == true);
    assert(m.len() == 2);
    assert(!m.contains(2));
    assert(m.remove(99) == false);
}

fn test_btreemap_ordered_keys() {
    var m = BTreeMap::new();
    m.insert(5, 50);
    m.insert(1, 10);
    m.insert(3, 30);
    m.insert(2, 20);
    m.insert(4, 40);
    
    // Keys should be in sorted order
    var ks = m.keys();
    assert(ks.get(0) == 1);
    assert(ks.get(1) == 2);
    assert(ks.get(2) == 3);
    assert(ks.get(3) == 4);
    assert(ks.get(4) == 5);
    
    assert(m.first_key() == 1);
    assert(m.last_key() == 5);
}

fn test_btreemap_get_or() {
    var m = BTreeMap::new();
    m.insert(1, 10);
    assert(m.get_or(1, 999) == 10);
    assert(m.get_or(99, 999) == 999);
}

// ─── BTreeSet tests ─────────────────────────────────────────────────────

fn test_btreeset_basic() {
    var s = BTreeSet::new();
    s.insert(3);
    s.insert(1);
    s.insert(2);
    
    assert(s.len() == 3);
    assert(s.contains(1));
    assert(s.contains(2));
    assert(s.contains(3));
    assert(!s.contains(99));
}

fn test_btreeset_no_duplicates() {
    var s = BTreeSet::new();
    s.insert(1);
    s.insert(1);
    s.insert(1);
    assert(s.len() == 1);
}

fn test_btreeset_remove() {
    var s = BTreeSet::new();
    s.insert(1);
    s.insert(2);
    s.insert(3);
    
    assert(s.remove(2) == true);
    assert(s.len() == 2);
    assert(!s.contains(2));
    assert(s.remove(99) == false);
}

fn test_btreeset_ordered() {
    var s = BTreeSet::new();
    s.insert(5);
    s.insert(1);
    s.insert(3);
    s.insert(2);
    s.insert(4);
    
    var v = s.to_vec();
    assert(v.get(0) == 1);
    assert(v.get(1) == 2);
    assert(v.get(2) == 3);
    assert(v.get(3) == 4);
    assert(v.get(4) == 5);
    
    assert(s.first() == 1);
    assert(s.last() == 5);
}

fn test_btreeset_union() {
    var a = BTreeSet::new();
    a.insert(1);
    a.insert(2);
    a.insert(3);
    
    var b = BTreeSet::new();
    b.insert(3);
    b.insert(4);
    b.insert(5);
    
    var u = BTreeSet::union(a, b);
    assert(u.len() == 5);
    assert(u.contains(1));
    assert(u.contains(5));
}

fn test_btreeset_intersection() {
    var a = BTreeSet::new();
    a.insert(1);
    a.insert(2);
    a.insert(3);
    
    var b = BTreeSet::new();
    b.insert(2);
    b.insert(3);
    b.insert(4);
    
    var i = BTreeSet::intersection(a, b);
    assert(i.len() == 2);
    assert(i.contains(2));
    assert(i.contains(3));
    assert(!i.contains(1));
}

// ─── HashSet tests ──────────────────────────────────────────────────────

fn test_hashset_basic() {
    var s = HashSet::new();
    s.insert(100);
    s.insert(200);
    s.insert(300);
    
    assert(s.len() == 3);
    assert(s.contains(100));
    assert(s.contains(200));
    assert(s.contains(300));
    assert(!s.contains(999));
}

fn test_hashset_no_duplicates() {
    var s = HashSet::new();
    s.insert(1);
    s.insert(1);
    s.insert(1);
    assert(s.len() == 1);
}

fn test_hashset_remove() {
    var s = HashSet::new();
    s.insert(10);
    s.insert(20);
    s.insert(30);
    
    assert(s.remove(20) == true);
    assert(s.len() == 2);
    assert(!s.contains(20));
    assert(s.remove(999) == false);
}

fn test_hashset_from_vec() {
    var v = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    
    var s = HashSet::from_vec(v);
    assert(s.len() == 3);
    assert(s.contains(2));
}

fn test_hashset_union() {
    var a = HashSet::new();
    a.insert(1);
    a.insert(2);
    
    var b = HashSet::new();
    b.insert(2);
    b.insert(3);
    
    var u = HashSet::union(a, b);
    assert(u.len() == 3);
    assert(u.contains(1));
    assert(u.contains(3));
}

// ─── Run all tests ──────────────────────────────────────────────────────

fn main() {
    test_btreemap_basic();
    test_btreemap_update();
    test_btreemap_remove();
    test_btreemap_ordered_keys();
    test_btreemap_get_or();
    
    test_btreeset_basic();
    test_btreeset_no_duplicates();
    test_btreeset_remove();
    test_btreeset_ordered();
    test_btreeset_union();
    test_btreeset_intersection();
    
    test_hashset_basic();
    test_hashset_no_duplicates();
    test_hashset_remove();
    test_hashset_from_vec();
    test_hashset_union();
    
    println("All collection tests passed!");
}
