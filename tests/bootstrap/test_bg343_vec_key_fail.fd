// expect-error: a HashMap key cannot be Vec<i64>: Vec keys are not supported
// BG343 (docs/roadmap/bugs-roadmap.md): a Vec key was hashed and compared as
// its handle, so two equal Vecs were two keys; Vec keys are rejected.
fn main() {
    var m: HashMap<Vec<i64>, i64> = HashMap::new();
    var a: Vec<i64> = Vec::new();
    a.push(1);
    m.insert(a, 1);
    println(f"{m.len()}");
}
