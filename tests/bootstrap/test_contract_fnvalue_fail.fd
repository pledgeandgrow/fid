// expect-error: Contract error: @contract 'pay' calls 'hook', a function value (in 'pay')
// Roadmap Phase 9 (blockchain): the verifier must know every call a
// contract makes; a function value could be any code, including code that
// calls back into the contract.
fn fee(x: i64) -> i64 {
    return x / 100;
}

@contract
@deterministic
@gas(5000)
fn pay(amount: i64, hook: fn(i64) -> i64) -> i64 {
    return amount - hook(amount);
}

fn main() -> i64 {
    println(pay(500, fee));
    return 0;
}
