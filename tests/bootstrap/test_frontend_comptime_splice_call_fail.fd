// expect-error: is not one expression
// CL6: the text a `comptime splice make(args)` call returns must parse as
// exactly one expression, like a splice block's; anything else is an error
// naming the splice's line.
comptime fn half_sum(a: str) -> str {
    return a + " +";
}

fn main() -> i64 {
    val x = comptime splice half_sum("1");
    println(x);
    return 0;
}
