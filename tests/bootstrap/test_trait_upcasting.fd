// L8G: Trait upcasting — supertrait method inheritance
// A subtrait inherits all supertrait methods. Implementing the subtrait
// requires implementing all supertrait methods too.

// Supertrait with a method
cap Greet {
    fn greet(self) -> str;
}

// Subtrait inherits Greet
cap NamedGreet: Greet {
    fn name(self) -> str;
}

// Struct to implement the subtrait
struct Person {
    name: str,
    age: i64,
}

// Implementing NamedGreet requires both name() and inherited greet()
impl NamedGreet for Person {
    pub fn greet(self: Person) -> str {
        return "Hello from " + self.name;
    }
    pub fn name(self: Person) -> str {
        return self.name;
    }
}

// Test: call inherited supertrait method on a concrete type
fn main() {
    val p = Person { name: "Alice", age: 30 };
    // Direct method calls on concrete type
    print(p.name());
    print(p.greet());
}
