// fid lint: unused variables and parameters (roadmap L7E). The program
// runs on every backend; `fid lint` on it reports exactly these three, and
// nothing about the names that are read (also as the end of a range,
// `0..n`) or start with `_`:
//   line 15: unused variable 'leftover' in 'weighted'
//   line 13: unused parameter 'scale' of 'weighted'
//   line 29: unused variable 'k' in 'count_up'
// Expected output:
// 14
// 3
// 6

fn weighted(xs: Vec<i64>, scale: i64, _unused_ok: i64) -> i64 {
    var sum: i64 = 0;
    var leftover: i64 = 99;
    var i: i64 = 0;
    while i < xs.len() {
        sum = sum + xs.get(i) * 2;
        i = i + 1;
    }
    return sum;
}

fn count_up(n: i64) -> i64 {
    var c: i64 = 0;
    var _ignored: i64 = 5;
    for j in 0..n {
        c = c + 1;
        var k: i64 = j;
    }
    return c;
}

fn main() -> i64 {
    var xs: Vec<i64> = Vec::new();
    xs.push(3);
    xs.push(4);
    println(weighted(xs, 10, 0));
    println(count_up(3));
    val total: i64 = 6;
    println(total);
    return 0;
}
