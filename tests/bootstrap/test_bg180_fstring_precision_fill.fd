// BG180 (docs/roadmap/bugs-roadmap.md): an f-string's float precision is
// right for large values (1e17 at two decimals printed the saturated
// 92233720368547758.07), a fill character is honoured ([fill][<|>|^] of
// reference 1.8), and the smallest i64 formats with a spec.
//
// Expected output:
// 100000000000000000.00
// 10.000000000000000000
// -100000000000000000.00
// 123456789012345680.00
// 9007199254740991.00
// 10000000000000000000000.00
// 1.50
// 3 4 0.13 10.00 12345678901234.568 100000000000000.0
// 100000000000000000
// ****7
// 00007
// 7****
// **7***
// -00042
// 000-42
// **ab**
// ff*****
// 00000042
// **-7
// xxxx7
// -9223372036854775808
// -8000000000000000
// 00-9223372036854775808
fn main() -> i64 {
    val a = 1e17;
    val b = 10.0;
    val c = -1e17;
    val d = 123456789012345678.0;
    val e = 9007199254740991.0;
    // (1e25 would do as well, but the native backend's float_to_str loses
    // its low digits: BG247)
    val g = 1e22;
    println(f"{a:.2}");
    println(f"{b:.18}");
    println(f"{c:.2}");
    println(f"{d:.2}");
    println(f"{e:.2}");
    println(f"{g:.2}");
    println(f"{1.5:.2}");
    // halves away from zero, as before; a fraction that rounds up to a whole
    val n1 = 2.5;
    val n2 = 3.5;
    val n3 = 0.125;
    val n4 = 9.999;
    val n5 = 12345678901234.5678;
    val n6 = 99999999999999.99;
    println(f"{n1:.0} {n2:.0} {n3:.2} {n4:.2} {n5:.3} {n6:.1}");
    println(f"{a}");

    // fill and alignment
    println(f"{7:*>5}");
    println(f"{7:0>5}");
    println(f"{7:*<5}");
    println(f"{7:*^6}");
    println(f"{-42:06}");
    println(f"{-42:0>6}");
    val t = "ab";
    println(f"{t:*^6}");
    println(f"{255:*<7x}");
    println(f"{42:08}");
    println(f"{-7:*>4}");
    println(f"{7:x>5}");

    // the smallest i64 with a spec
    val tiny = -9223372036854775807 - 1;
    println(f"{tiny:5}");
    println(f"{tiny:x}");
    println(f"{tiny:0>22}");
    return 0;
}
