// LF10: expected to fail at run time (integer overflow). `bump` is called
// with `i` in [0, 9] from a loop and once with 4e18: the range every call
// gives its parameter is [0, 4e18], so `x * 3` keeps its overflow check
// (compiler/checks.fd peir_note_param_ranges joins every call's argument
// range). A range taken from the loop's calls only would let the
// multiplication wrap instead of panicking.

fn bump(x: i64) -> i64 {
    return x * 3 + 1;
}

fn main() {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 10 {
        t = t + bump(i);
        i = i + 1;
    }
    println(t);
    println(bump(4000000000000000000));
    print("unreachable\n");
}
