// expect-error: the call of 'pick' with (i64, i64) is taken by two definitions, neither more specific than the other: pick<B>(i64, B) and pick<A>(A, i64)
// L8H: the most specific definition wins; when two take the call and
// neither is more specific than the other (one fixes the first parameter,
// the other the second), the call is ambiguous and an error, not a choice
// by declaration order.

fn pick<A, B>(a: A, b: B) -> str {
    return "general";
}

fn pick<B>(a: i64, b: B) -> str {
    return "first is i64";
}

fn pick<A>(a: A, b: i64) -> str {
    return "second is i64";
}

fn main() -> i64 {
    println(pick("x", 1));
    println(pick(1, 2));
    return 0;
}
