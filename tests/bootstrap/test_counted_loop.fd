// A counted loop drops its bounds check only when it is safe: a loop that
// shrinks the Vec, starts below zero or reads after the increment keeps it.
fn sum(v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        s = s + v.get(i);
        i = i + 1;
    }
    return s;
}

fn double_all(v: &mut Vec<i64>) {
    for i in 0..v.len() {
        v.set(i, v.get(i) * 2);
    }
}

fn nested(v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        var j: i64 = 0;
        while j < v.len() {
            s = s + v.get(i) * v.get(j);
            j = j + 1;
        }
        i = i + 1;
    }
    return s;
}

fn skip_odd(v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        val x: i64 = v.get(i);
        i = i + 1;
        if x % 2 == 1 {
            continue;
        }
        s = s + x;
    }
    return s;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 5 {
        v.push(i + 1);
        i = i + 1;
    }
    double_all(&mut v);
    print(sum(v));
    print(nested(v));
    print(skip_odd(v));
    // Reading after the increment goes past the end
    var k: i64 = 0;
    while k < v.len() {
        k = k + 1;
        if k < 5 {
            print(v.get(k));
        }
    }
    // The loop shortens the Vec: its check must stay
    var m: i64 = 0;
    while m < v.len() {
        v.pop();
        if m < v.len() {
            print(v.get(m));
        }
        m = m + 1;
    }
    return 0;
}
