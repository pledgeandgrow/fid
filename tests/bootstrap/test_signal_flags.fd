// stdlib/signal.fd on every backend: a registered signal raised in the
// process is noted, and sig_check returns 1 once per arrival. Native
// Windows (pe_ir) registers SIGINT/SIGTERM through SetConsoleCtrlHandler
// (stdlib/pe_runtime/base.fd); the C backend through signal().
//
// Expected output:
//     register SIGINT: 0
//     register SIGTERM: 0
//     before: 0
//     after raise: 1
//     again: 0
//     shutdown before: false
//     shutdown after SIGTERM: true
//     shutdown again: false

use signal;

fn main() {
    println("register SIGINT: " + int_to_str(sig_register(SIGINT)));
    println("register SIGTERM: " + int_to_str(sig_register(SIGTERM)));
    println("before: " + int_to_str(sig_check(SIGINT)));
    sig_raise(SIGINT);
    println("after raise: " + int_to_str(sig_check(SIGINT)));
    println("again: " + int_to_str(sig_check(SIGINT)));
    if sig_shutdown_requested() {
        println("shutdown before: true");
    } else {
        println("shutdown before: false");
    }
    sig_raise(SIGTERM);
    if sig_shutdown_requested() {
        println("shutdown after SIGTERM: true");
    } else {
        println("shutdown after SIGTERM: false");
    }
    if sig_shutdown_requested() {
        println("shutdown again: true");
    } else {
        println("shutdown again: false");
    }
}
