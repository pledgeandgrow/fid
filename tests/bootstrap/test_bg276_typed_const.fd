// BG276 (docs/roadmap/bugs-roadmap.md): a typed const is its value as the
// declared type, not the bare i64 literal: a u64 const prints and compares
// unsigned, a u8 const adds as a u8, an f32 const is an f32.
//
// Expected output:
// 18446744073709551615 true
// 9223372036854775807
// 250
// 1.5 -3
// 2.5

const CU: u8 = 200;
const CB: u64 = 18446744073709551615;
const CF: f32 = 1.5;
const CI: i8 = -3;
const CD: f64 = 2.5;

fn main() {
    println(f"{CB} {CB > 1}");
    println(f"{CB / 2}");
    val x: u8 = CU + 50;
    println(f"{x}");
    println(f"{CF} {CI}");
    println(f"{CD}");
}
