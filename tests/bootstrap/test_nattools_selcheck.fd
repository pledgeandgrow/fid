// llvm-roadmap RL6: translation validation of instruction selection. With
// FID_VERIFY=1 every native build on the machine layer first runs
// nat_ir.fd nat_sel_check: each integer MIR operation (LI, MOV, ADD..SHR,
// NEG, NOT, DIV, REM, MULH, SETCC with every condition, EXT of every kind,
// ASR63, ADDSHL) is selected alone with physical registers, as the replay
// after allocation selects it, and nat_enc.fd's evaluator runs the bytes on
// edge and pseudo-random values against the operation's meaning; a
// mismatch, or an instruction the evaluator does not know, stops the build.
// This program uses those operations; check it with
//   FID_VERIFY=1 NATIVE=1 bash scripts/cross-test.sh x86_64-linux
// (and aarch64-linux, riscv64-linux; also with --cpu x86-64-v3 and
// rva22u64, whose selections differ). Same output on every backend.
// Expected output:
// 1000040
// 999966
// 37000111
// 27027
// 4
// 1
// 1000039
// 1000038
// 8000024
// 250000
// -250001
// -1000003
// 1
// 0
// 44
// -56
// 37000247

fn lt(a: i64, b: i64) -> i64 {
    if a < b {
        return 1;
    }
    return 0;
}

fn element(base: i64, i: i64) -> i64 {
    return base + i * 8;
}

fn main() {
    var a: i64 = 1000003;
    var b: i64 = 37;
    print(a + b);
    print("\n");
    print(a - b);
    print("\n");
    print(a * b);
    print("\n");
    print(a / b);
    print("\n");
    print(a % b);
    print("\n");
    print(a & b);
    print("\n");
    print(a | b);
    print("\n");
    print(a ^ b);
    print("\n");
    print(a << 3);
    print("\n");
    print(a >> 2);
    print("\n");
    val n: i64 = 0 - a;
    print(n >> 2);
    print("\n");
    print(n);
    print("\n");
    print(lt(b, a));
    print("\n");
    print(lt(a, b));
    print("\n");
    var w: i64 = 300;
    val u: u8 = w as u8;
    print(u as i64);
    print("\n");
    w = 200;
    val s: i8 = w as i8;
    print(s as i64);
    print("\n");
    print(element(a * b, 17));
    print("\n");
}
