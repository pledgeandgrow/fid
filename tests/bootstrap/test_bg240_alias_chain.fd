// BG240 (docs/roadmap/bugs-roadmap.md): an alias that ends in a type, even
// through other aliases or as a generic argument, still resolves.
//
// Expected output:
// 5
// 7
// 3
// 4
type A = B;
type B = i64;
type Pair = Vec<A>;

struct S {
    v: A,
}

fn main() -> i64 {
    val x: A = 5;
    println(x);
    var y: B = 7;
    println(y);
    val p: Pair = Vec::new();
    p.push(4);
    println(p.len() - 1);
    val s = S { v: 4 };
    println(s.v);
    return 0;
}
