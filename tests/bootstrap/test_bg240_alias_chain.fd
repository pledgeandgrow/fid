// BG240 (docs/roadmap/bugs-roadmap.md): an alias that ends in a type, even
// through other aliases, a reference or a generic argument, still resolves.
//
// Expected output:
// 5
// 7
// 3
// 4
type A = B;
type B = i64;
type Ref = &A;
type Pair = Vec<A>;

struct S {
    v: A,
}

fn get(r: Ref) -> A {
    return *r;
}

fn main() -> i64 {
    val x: A = 5;
    println(x);
    var y: B = 7;
    println(y);
    println(get(&y) - 4);
    val p: Pair = Vec::new();
    p.push(4);
    println(p.get(0));
    return 0;
}
