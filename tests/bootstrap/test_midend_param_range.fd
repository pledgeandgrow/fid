// LF10 (compiler/checks.fd peir_note_param_ranges): ranges through function
// boundaries. `bump` is reached only through direct calls, and every call
// passes `i` of a loop `while i < 10` from 0: its parameter is in [0, 9],
// so `x * 3 + 1` cannot overflow. With paramrange (on by default), `fid
// explain` on this file lists both of bump's overflow checks as removed
// (range analysis); FID_IROPT_OFF=paramrange keeps them. `scale` is also called with a
// value the caller does not bound: its check stays.
// tests/tooling/param-range-check.sh runs it; the results must not change.
// test_midend_param_range_fail.fd: one call out of the range keeps the
// checks, and the overflow panics.
//
// Expected output:
// 145
// 90
// 7

fn bump(x: i64) -> i64 {
    return x * 3 + 1;
}

fn scale(x: i64) -> i64 {
    return x * 2;
}

fn main() {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 10 {
        t = t + bump(i);
        i = i + 1;
    }
    println(t);
    var s: i64 = 0;
    i = 0;
    while i < 10 {
        s = s + scale(i);
        i = i + 1;
    }
    println(s);
    var n: i64 = 0;
    var args: Vec<i64> = Vec::new();
    args.push(3);
    args.push(4);
    var k: i64 = 0;
    while k < args.len() {
        n = n + args.get(k);
        k = k + 1;
    }
    println(scale(n) / 2);
}
