// expect-error: Result::Ok field 1 expects 'i64', got 'str'
// Bugs roadmap BG128: the payload of a generic enum constructor was never
// checked: `Result::Ok("no")` returned from a `-> Result<i64, str>` passed,
// and `v + 1` on the Ok value printed an address.
fn h() -> Result<i64, str> { return Result::Ok("no"); }
fn main() -> i64 {
    match h() { Result::Ok(v) => { println(v + 1); } Result::Err(e) => { println(e); } }
    return 0;
}
