// expect-error: is not a valid regular expression: the repeat count at offset 5 is over 1000
// L4E: the checker applies regex_compile's limits too: a repeat expands to
// one copy of its atom per count, at most 1000 (RV_MAX_REPEAT).

use regex;

fn main() -> i64 {
    val r: Regex = regex_compile("[0-9]{4000}");
    println("unreachable");
    return 0;
}
