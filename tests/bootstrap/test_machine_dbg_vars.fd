// Track DB (docs/roadmap/llvm-roadmap.md) on the machine layer
// (compiler/nat_ir.fd ng_dbg_vars_note / ng_dbg_vars_resolve,
// compiler/nat_enc.fd nat_elf_debug):
//   DB2  every function's .debug_info entry has DW_AT_frame_base
//        (DW_OP_call_frame_cfa) and DW_AT_decl_file / DW_AT_decl_line
//   DB4  its parameters (DW_TAG_formal_parameter) and variables
//        (DW_TAG_variable) with a type and a location: a register, a
//        frame slot at CFA + off, or a constant
// Check: fid emit this file --target x86_64-linux (aarch64-linux,
// riscv64-linux) -o t; python3 tests/nattools/dbg_vars_check.py t
// (gdb: `break scale`, `run`, `info args`, `info locals`).
// Expected output:
// 42
// 1250
// 77
// 11
// 600

struct Rect {
    w: i64,
    h: i64,
}

fn scale(base: i64, factor: i64) -> i64 {
    var acc: i64 = 0;
    var step: i64 = 0;
    while step < factor {
        acc = acc + base;
        step = step + 1;
    }
    return acc;
}

fn area(r: Rect) -> i64 {
    var a: i64 = r.w * r.h;
    return a;
}

fn mix(x: i64, flag: bool) -> i64 {
    var out: i64 = x;
    if flag {
        out = out * 7;
    }
    return out;
}

fn count_bytes(s: str) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) != 32 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn main() {
    var total: i64 = scale(6, 7);
    println(total);
    var box: Rect = Rect { w: 25, h: 50 };
    println(area(box));
    println(mix(11, true));
    println(count_bytes("hello  world !"));
    var big: i64 = scale(total, 10) + scale(18, 10);
    println(big);
}
