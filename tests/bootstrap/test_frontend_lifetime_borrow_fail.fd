// expect-error: cannot mutate a: shared borrow(s) are active
// LG3: across a call. `r` borrows what `first`'s signature ties its result
// to (`a`), so changing `a` while `r` is still used is the error it is for
// `val r = &a`.
fn first<'a>(x: &'a i64, y: &i64) -> &'a i64 {
    return x;
}

fn main() -> i64 {
    var a: i64 = 1;
    var b: i64 = 2;
    val r = first(&a, &b);
    a = 5;
    println(*r);
    return 0;
}
