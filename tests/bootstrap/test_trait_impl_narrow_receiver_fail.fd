// expect-error: no method 'show' on Wrap<bool>: 'show' is a method of `impl Wrap<i64>` only
// L8H: an impl of a trait for a narrower type with no generic impl of the
// trait for the struct (`impl Show for Wrap<i64>` alone) gives the method
// to that type only: `self` is a Wrap<i64>, and a Wrap<bool> has no `show`.
// Before, `self` was the bare struct and the call on a Wrap<bool> was
// accepted.

cap Show {
    fn show(self) -> str;
}

struct Wrap<T> {
    v: T,
}

impl Show for Wrap<i64> {
    fn show(self) -> str {
        return "i64 " + int_to_str(self.v);
    }
}

fn main() -> i64 {
    val a: Wrap<i64> = Wrap { v: 5 };
    println(a.show());
    val c: Wrap<bool> = Wrap { v: true };
    println(c.show());
    return 0;
}
