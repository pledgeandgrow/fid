// expect-error: `<` takes two values of one type
// Bugs roadmap BG60: an i64 ordered against an f64 compared the float's
// bits with the int's — the answer depended on the encoding, not the
// values. Numbers of different types do not compare; `x < 3.5` where x
// is f64 stays (the literal takes f64).
fn main() -> i64 {
    val n: i64 = 5;
    val f: f64 = 4.5;
    if n < f {
        println("less");
    }
    return 0;
}
