// expect-error: Partition error: 'main' hands 'shared' by reference to partition 'navigation' (entry 'nav_update') and to partition 'flight_control' (entry 'control_loop')
// Roadmap Phase 9 (F47): spatial partitioning. The scheduler (`main`)
// gives the same variable to two partitions by reference: through it,
// navigation writes what flight control reads, which is memory they share.

struct AirData {
    alt: i64,
}

@partitioned(navigation)
fn nav_update(d: & mut AirData, alt: i64) {
    d.alt = alt;
}

@partitioned(flight_control)
fn control_loop(d: & AirData) -> i64 {
    return d.alt / 10;
}

fn main() {
    var shared: AirData = AirData { alt: 0 };
    nav_update(& mut shared, 1200);
    println(int_to_str(control_loop(& shared)));
}
