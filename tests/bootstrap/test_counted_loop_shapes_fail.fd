// LF7: expected to fail at run time (index out of bounds). The loop's
// bound is `v.len() - 1`, so before the step i is in [0, v.len() - 2]:
// `v.get(i + 1)` is in bounds, `v.get(i + 2)` is not on the last
// iteration. compiler/checks.fd peir_counted_loop proves reads at i + e
// only for e <= d (here d = 1), so this check stays and panics. A proof
// that took any offset would read past the end instead.

fn pairs_far(v: & Vec<i64>) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < v.len() - 1 {
        t = t + v.get(i + 2);
        i = i + 1;
    }
    return t;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    println(pairs_far(& v));
    print("unreachable\n");
}
