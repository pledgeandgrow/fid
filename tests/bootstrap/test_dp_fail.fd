// expect-error: Differential privacy error: function 'bad_dp' is @dp but has no '!Nois
// test_dp_fail.fd — ML12: @dp without Noise effect
// Expected: FAIL (compile error)
// @dp functions must add noise for privacy guarantees.

use tensor;

@dp(epsilon=1.0)
fn bad_dp(x: Tensor, grad: Tensor) -> Tensor {
    // No noise added — privacy is not guaranteed
    val result = add(x, grad);
    return result;
}

fn main() {
    val x = ones(vec2(2, 2));
    val grad = ones(vec2(2, 2));
    val result = bad_dp(x, grad);
    return 0;
}

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}
