// Bugs roadmap BG347: stdlib/semver.fd sv_pre_compare returned
// str_compare's byte difference for two alphanumeric pre-release
// identifiers (-31 for "Beta" vs "alpha"), though semver_compare promises
// -1/0/1, and numeric identifiers past i64 compared equal (str_parse_int
// gave 0 for both). SemVer 2.0.0 §11: identifiers of digits only compare
// numerically, others by ASCII order.
//
// Expected output:
// -1 1 0
// 1 -1
// -1 1

use semver;

fn main() {
    println(f"{semver_compare_str("1.0.0-Beta", "1.0.0-alpha")} {semver_compare_str("1.0.0-alpha", "1.0.0-Beta")} {semver_compare_str("1.0.0-rc", "1.0.0-rc")}");
    println(f"{semver_compare_str("1.0.0-99999999999999999999", "1.0.0-99999999999999999998")} {semver_compare_str("1.0.0-9", "1.0.0-100000000000000000000")}");
    println(f"{semver_compare_str("1.0.0-alpha.1", "1.0.0-alpha.beta")} {semver_compare_str("1.0.0-beta.11", "1.0.0-beta.2")}");
}
