// expect-error: which more than one unit declares (Energy, Torque)
// CL10 (fid): two units of one dimension (energy and torque are both
// m^2 kg s^-2) make `Force * Len` ambiguous: the error says so.

@dimension(m = 1)
struct Len {
    value: f64,
}

@dimension(m = 1, kg = 1, s = -2)
struct Force {
    value: f64,
}

@dimension(m = 2, kg = 1, s = -2)
struct Energy {
    value: f64,
}

@dimension(m = 2, kg = 1, s = -2)
struct Torque {
    value: f64,
}

fn main() -> i64 {
    val f: Force = Force { value: 10.0 };
    val d: Len = Len { value: 3.0 };
    val e: Energy = f * d;
    println(int_to_str(e.value as i64));
    return 0;
}
