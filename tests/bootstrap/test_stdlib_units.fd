// Complaint CL10: stdlib units gives each unit its own type, so the
// arithmetic below is checked at compile time (the rejected mix of units is
// test_stdlib_units_mismatch_fail.fd). Same-unit sums for every unit,
// scaling, comparison, ratio and the inverse derived units.
//
// Expected output:
// speed 10
// travel 250
// travel time 25
// force 20
// mass 4
// kelvin 300
// scaled 300
// longer true
// ratio 3
// units ok
use units;

fn main() -> i64 {
    val d: Meters = meters(100.0);
    val t: Seconds = seconds(10.0);
    val v: MetersPerSecond = velocity(d, t);
    println("speed " + int_to_str(v.value as i64));
    println("travel " + int_to_str(travel(v, seconds(25.0)).value as i64));
    println("travel time " + int_to_str(travel_time(meters(250.0), v).value as i64));
    val a: MetersPerSecond2 = acceleration(v, seconds(2.0));
    val f: Newtons = force(kilograms(4.0), a);
    println("force " + int_to_str(f.value as i64));
    println("mass " + int_to_str(mass_from_force(f, a).value as i64));
    val k: Kelvin = kelvin_add(kelvin(273.0), kelvin(27.0));
    println("kelvin " + int_to_str(k.value as i64));
    val far: Meters = meters_scale(d, 3.0);
    println("scaled " + int_to_str(far.value as i64));
    if meters_lt(d, far) && !meters_lt(far, d) {
        println("longer true");
    } else {
        println("longer false");
    }
    println("ratio " + int_to_str(meters_ratio(far, d) as i64));
    println("units ok");
    return 0;
}
