// BG247 (docs/roadmap/bugs-roadmap.md): a double from 2^53 prints with its
// exact digits on every backend. The default Windows backend's conversion
// went through the C runtime's printf, which keeps 17 significant digits
// of such a value and writes zeros past them (1e25 printed as
// 10000000000000001000000000).
//
// Expected output:
// 10000000000000000905969664
// -10000000000000000905969664
// 9007199254740992
// 18446744073709551616
// 10000000000000000905969664.00
// 4503599627370495.5
// 
// 
fn main() -> i64 {
    val a = 1e25;
    val b = -1e25;
    val c = 9007199254740992.0;
    val d = 18446744073709551616.0;
    val e = 4503599627370495.5;
    val g = 1e300;
    val h = 1.7976931348623157e308;
    println(f"{a}");
    println(f"{b}");
    println(f"{c}");
    println(f"{d}");
    println(f"{a:.2}");
    println(f"{e}");
    println(f"{g}");
    println(f"{h}");
    return 0;
}
