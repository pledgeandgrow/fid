// expect-error: is safety-annotated but calls 'boom'
// Bugs roadmap BG130: the safety scans did not look inside enum literals:
// `Option::Some(boom(n))` in a @crashfree function was accepted.
fn boom(n: i64) -> i64 { panic("boom"); return n; }
@crashfree
fn cf(n: i64) -> Option<i64> {
    return Option::Some(boom(n));
}
fn main() -> i64 { match cf(3) { Option::Some(v) => { println(v); } Option::None => { } } return 0; }
