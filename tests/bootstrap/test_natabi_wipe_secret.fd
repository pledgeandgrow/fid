// test_natabi_wipe_secret.fd — llvm LF20 on the machine layer (Linux,
// macOS, --nat; compiler/nat_ir.fd ng_wipe_frame): a function that holds a
// secret (a @secret parameter or local, a @zeroize local, @constant_time
// code: IrFunction.has_secret) zeroes its whole frame below the register
// save area at every return, spill slots included, so no copy of the
// secret outlives the call; such a function is not inlined into one that
// holds none. `FID_NAT_OFF=wipe` builds it without. The results do not
// change: every backend prints the same.
//
// Expected output:
// 1009
// 0
// 148
// 170
// 85

fn mix(key: i64, x: i64) -> i64 {
    @zeroize
    var k: i64 = key * 31;
    var r: i64 = (x ^ k) + 7;
    return r - (x ^ k) + x;
}

/// A @secret parameter: used, never shown (the result is public)
fn digest(@secret k: i64) -> i64 {
    val t: i64 = k * 7 + 3;
    return 0;
}

/// A larger frame (a loop and a Vec), wiped in a loop
fn checksum(data: Vec<i64>) -> i64 {
    @zeroize
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < data.len() {
        acc = acc + data.get(i) * (i + 1);
        i = i + 1;
    }
    return acc;
}

/// a where mask is all ones, b where it is zero
@constant_time
@wrapping
fn ct_select(mask: i64, a: i64, b: i64) -> i64 {
    return (a & mask) | (b & ~mask);
}

fn main() {
    println(mix(12345, 1002));
    println(digest(42));
    var d: Vec<i64> = Vec::new();
    d.push(10);
    d.push(20);
    d.push(30);
    d.push(2);
    println(checksum(d));
    println(ct_select(0 - 1, 170, 85));
    println(ct_select(0, 170, 85));
}
