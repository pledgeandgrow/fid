// expect-error: @dimension on struct 'Len': 'm' is given twice.
// Expected to FAIL (CE4): a base appears once in a `@dimension(...)`
// (CL10; ast.fd dim_read).
@dimension(m = 1, m = 2)
struct Len {
    value: f64,
}

fn main() -> i64 {
    val d: Len = Len { value: 1.0 };
    println(int_to_str(d.value as i64));
    return 0;
}
