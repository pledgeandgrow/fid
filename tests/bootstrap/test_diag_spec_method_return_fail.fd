// expect-error: returns i64, and the generic impl's returns str for Wrap<i64>
// Expected to FAIL (CE4): a narrower impl's method (`impl Wrap<i64> { fn
// kind }`) specializes the generic impl's (`impl<T> Wrap<T> { fn kind }`)
// for some receivers, so a call `w.kind()` has one type whichever runs: the
// two must return the same type (L8H, TypeChecker_check_mspec_call).
struct Wrap<T> {
    v: T,
}

impl<T> Wrap<T> {
    fn kind(self) -> str {
        return "any";
    }
}

impl Wrap<i64> {
    fn kind(self) -> i64 {
        return 64;
    }
}

fn main() -> i64 {
    val w: Wrap<i64> = Wrap { v: 3 };
    println(w.kind());
    return 0;
}
