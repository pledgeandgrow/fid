// Bugs roadmap BG352: stdlib/json.fd json_path parsed every segment on an
// array with str_parse_int, which gives 0 for text that is not a number:
// json_path("[10,20]", "x") returned the first element "10" instead of ""
// (a schema mismatch was silently answered). Only a segment of digits
// indexes an array now.
//
// Expected output:
// []
// [20]
// []
// []
// ["Ada"]
// []

use json;

fn main() {
    println("[" + json_path("[10,20]", "x") + "]");
    println("[" + json_path("[10,20]", "1") + "]");
    println("[" + json_path("[10,20]", "-1") + "]");
    println("[" + json_path("[10,20]", "") + "]");
    println("[" + json_path("{\"users\": [{\"name\": \"Ada\"}]}", "users.0.name") + "]");
    println("[" + json_path("{\"users\": [{\"name\": \"Ada\"}]}", "users.name") + "]");
}
