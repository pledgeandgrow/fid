// Test: Vec and HashMap through the WebAssembly backend (release F9).

struct Item { id: i64, name: str }

fn sum(v: Vec<i64>) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        t = t + v[i];
        i = i + 1;
    }
    return t;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 100 {
        v.push(i * i);
        i = i + 1;
    }
    print(v.len());
    print(" ");
    print(sum(v));
    print(" ");
    print(v[7]);
    print("\n");
    v.set(7, 0 - 1);
    print(v[7]);
    print(" ");
    print(v.pop());
    print(" ");
    print(v.len());
    print("\n");

    var words: Vec<str> = Vec::new();
    words.push("alpha");
    words.push("beta");
    words.push("gamma");
    var j: i64 = 0;
    while j < words.len() {
        print(words[j]);
        print(";");
        j = j + 1;
    }
    print("\n");

    var items: Vec<Item> = Vec::new();
    items.push(Item { id: 1, name: "one" });
    items.push(Item { id: 2, name: "two" });
    val it = items[1];
    print(it.id);
    print(" ");
    print(it.name);
    print("\n");

    val m = HashMap::new();
    m.insert("alice", 30);
    m.insert("bob", 25);
    m.insert("carol", 41);
    print(m.len());
    print(" ");
    print(m.get("alice"));
    print(" ");
    print(m.contains("bob"));
    print(" ");
    print(m.contains("dave"));
    print("\n");
    m.remove("alice");
    print(m.len());
    print("\n");

    val counts = HashMap::new();
    var k: i64 = 0;
    while k < 500 {
        counts.insert(int_to_str(k % 37), k);
        k = k + 1;
    }
    print(counts.len());
    print(" ");
    print(counts.get("5"));
    print("\n");
}
