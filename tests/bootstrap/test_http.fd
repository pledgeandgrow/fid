// Test: HTTP stdlib — Phase 5D.3
// Tests HTTP request parsing and response building.
// The actual server (serve function) is blocking, so we test the
// parsing/building functions which are the core logic.

use http;
use json;

fn main() {
    // ─── Parse HTTP request ──────────────────────────────────────────
    val raw = "GET /api/users?id=42 HTTP/1.1\r\nHost: localhost:8080\r\nAccept: application/json\r\n\r\n";
    val req = parse_request(raw);
    print(req);
    print("\n");

    // ─── Extract fields from parsed request ──────────────────────────
    val method = json_get(req, "method");
    print(method);
    print("\n");

    val path = json_get(req, "path");
    print(path);
    print("\n");

    val version = json_get(req, "version");
    print(version);
    print("\n");

    // ─── Build HTTP response ─────────────────────────────────────────
    val body = "{\"status\":\"ok\"}";
    val response = build_response(200, "application/json", body);
    print(response);
    print("\n");

    // ─── Status text ─────────────────────────────────────────────────
    val s200 = status_text(200);
    print(s200);
    print("\n");

    val s404 = status_text(404);
    print(s404);
    print("\n");

    // ─── Parse POST request with body ────────────────────────────────
    val post_raw = "POST /api/submit HTTP/1.1\r\nContent-Type: application/json\r\nContent-Length: 15\r\n\r\n{\"name\":\"alice\"}";
    val post_req = parse_request(post_raw);
    val post_method = json_get(post_req, "method");
    print(post_method);
    print("\n");

    val post_body = json_get(post_req, "body");
    print(post_body);
    print("\n");

    return 0;
}
