// expect-error: the closure is declared to return i64 but can reach the end of its body without returning
// Bugs roadmap BG288: a closure with a declared result type must not fall
// off its end, as a named function must not (E047); before, `f(-1)`
// printed `void` (run) or 0 (ccompile).
fn main() -> i64 {
    val f = fn(y: i64) -> i64 {
        if y > 0 {
            return 1;
        }
    };
    println(f(-1));
    return 0;
}
