// stdlib/image: the pixel buffer: create, get/set (bounds, channel count),
// fill, flips, sub-regions, nearest-neighbour resize, colour packing and
// the colour constants. Loading files and making textures go through SDL2
// and are not run here.
use image;

fn say_yes(b: bool) {
    if b { println("yes"); } else { println("no"); }
}

fn px(img: &Image, x: i64, y: i64) {
    println(image_get_pixel(img, x, y));
}

fn main() -> i64 {
    // RGBA starts black and opaque, RGB has no alpha channel
    var a = image_create(3, 2, 4);
    println(a.width);
    println(a.height);
    println(a.channels);
    println(a.data.len());
    px(&a, 0, 0);
    px(&a, 2, 1);
    var rgb = image_create(2, 2, 3);
    println(rgb.data.len());
    px(&rgb, 1, 1);
    // an empty image has no data
    println(image_create(0, 5, 4).data.len());

    // set and get (packed 0xRRGGBBAA)
    image_set_pixel(&mut a, 1, 0, 255, 128, 64, 32);
    px(&a, 1, 0);
    println(image_get_pixel(&a, 1, 0) == color_pack(255, 128, 64, 32));
    // components are masked to a byte
    image_set_pixel(&mut a, 2, 0, 256 + 1, -1, 512, 258);
    px(&a, 2, 0);
    // outside the image: reads give 0, writes are ignored
    px(&a, -1, 0);
    px(&a, 0, -1);
    px(&a, 3, 0);
    px(&a, 0, 2);
    image_set_pixel(&mut a, 3, 0, 1, 1, 1, 1);
    image_set_pixel(&mut a, 0, 2, 1, 1, 1, 1);
    image_set_pixel(&mut a, -1, -1, 1, 1, 1, 1);
    println(a.data.len());
    // RGB images ignore alpha when writing and report 255 when reading
    image_set_pixel(&mut rgb, 0, 1, 10, 20, 30, 99);
    px(&rgb, 0, 1);

    // fill
    image_fill(&mut a, 1, 2, 3, 4);
    px(&a, 0, 0);
    px(&a, 2, 1);
    image_fill(&mut rgb, 9, 8, 7, 6);
    px(&rgb, 1, 0);

    // flips on a 3 x 2 image numbered by x + 10 * y
    var f = image_create(3, 2, 4);
    var y: i64 = 0;
    while y < 2 {
        var x: i64 = 0;
        while x < 3 {
            image_set_pixel(&mut f, x, y, x + 10 * y, 0, 0, 255);
            x = x + 1;
        }
        y = y + 1;
    }
    image_flip_h(&mut f);
    println(f.data.get(0));
    println(f.data.get(4));
    println(f.data.get(8));
    println(f.data.get(12));
    image_flip_h(&mut f);
    println(f.data.get(0));
    image_flip_v(&mut f);
    println(f.data.get(0));
    println(f.data.get(12));
    println(f.data.get(20));
    image_flip_v(&mut f);
    println(f.data.get(0));
    // an odd-height image keeps its middle row
    var odd = image_create(1, 3, 4);
    image_set_pixel(&mut odd, 0, 0, 1, 0, 0, 255);
    image_set_pixel(&mut odd, 0, 1, 2, 0, 0, 255);
    image_set_pixel(&mut odd, 0, 2, 3, 0, 0, 255);
    image_flip_v(&mut odd);
    println(odd.data.get(0));
    println(odd.data.get(4));
    println(odd.data.get(8));

    // sub-region: the 2 x 1 block at (1,1)
    var s = image_subregion(&f, 1, 1, 2, 1);
    println(s.width);
    println(s.height);
    println(s.data.get(0));
    println(s.data.get(4));
    // outside the source gives an empty image
    println(image_subregion(&f, 2, 0, 2, 1).width);
    println(image_subregion(&f, 0, 1, 1, 2).height);
    println(image_subregion(&f, -1, 0, 1, 1).data.len());
    // the whole image is a copy
    println(image_subregion(&f, 0, 0, 3, 2).data.len());

    // nearest-neighbour: 2 x 2 up to 4 x 4 repeats each pixel 2 x 2
    var q = image_create(2, 2, 4);
    image_set_pixel(&mut q, 0, 0, 1, 0, 0, 255);
    image_set_pixel(&mut q, 1, 0, 2, 0, 0, 255);
    image_set_pixel(&mut q, 0, 1, 3, 0, 0, 255);
    image_set_pixel(&mut q, 1, 1, 4, 0, 0, 255);
    var big = image_resize_nn(&q, 4, 4);
    println(big.width);
    println(big.data.len());
    var yy: i64 = 0;
    while yy < 4 {
        var line = "";
        var xx: i64 = 0;
        while xx < 4 {
            line = line + int_to_str(big.data.get((yy * 4 + xx) * 4)) + " ";
            xx = xx + 1;
        }
        println(line);
        yy = yy + 1;
    }
    // and down: 4 x 4 to 2 x 2 takes every other pixel
    var small = image_resize_nn(&big, 2, 2);
    println(small.data.get(0));
    println(small.data.get(4));
    println(small.data.get(8));
    println(small.data.get(12));
    // free empties it
    image_free(&mut small);
    println(small.width);
    println(small.data.len());

    // colours
    println(color_pack(1, 2, 3, 4));
    println(color_pack(255, 255, 255, 255) == COLOR_WHITE);
    println(color_pack(300, -1, 0, 256));
    var c = color_unpack(0x11223344);
    println(c.r);
    println(c.g);
    println(c.b);
    println(c.a);
    var w = color_unpack(COLOR_WHITE);
    println(w.r + w.g + w.b + w.a);
    println(COLOR_BLACK);
    println(COLOR_RED);
    println(COLOR_GREEN);
    println(COLOR_BLUE);
    println(COLOR_TRANSPARENT);
    println(COLOR_GRAY);
    println(COLOR_YELLOW == color_pack(255, 255, 0, 255));
    println(COLOR_CYAN == color_pack(0, 255, 255, 255));
    println(COLOR_MAGENTA == color_pack(255, 0, 255, 255));
    println(COLOR_DARK_GRAY == color_pack(64, 64, 64, 255));
    println(COLOR_LIGHT_GRAY == color_pack(192, 192, 192, 255));
    return 0;
}
