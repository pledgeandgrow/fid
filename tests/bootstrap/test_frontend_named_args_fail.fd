// expect-error: function 'connect' has no parameter 'prot'
// CL4: a named argument must name a parameter of the function (the
// lowering dropped an unknown name and passed 0 for the parameter).

fn connect(host: str, port: i64 = 80) -> i64 {
    println(host);
    return port;
}

fn main() -> i64 {
    println(connect("example.org", prot: 8080));
    return 0;
}
