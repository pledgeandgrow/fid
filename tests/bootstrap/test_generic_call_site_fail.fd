// expect-error: (line 31, in 'main'): 'total_x' is called with T = Label, but Label has no field 'x', which the body of 'total_x' needs.
// CE9: an error that holds only for the type a call chose is reported at
// that call, the line the program wrote, not inside the generic body. The
// body's line follows as a note:
//     note: at <this file>:20, in 'total_x': its body reads the field 'x' of a T

struct Pt {
    x: i64,
    y: i64,
}

struct Label {
    text: str,
}

// A library function: right for any T that has a field x, so nothing in
// it is reported on its own
fn total_x<T>(a: T, b: T) -> i64 {
    var s: i64 = 0;
    s = a.x + b.x;
    return s;
}

fn main() -> i64 {
    // T = Pt: Pt has x
    println(total_x(Pt { x: 1, y: 2 }, Pt { x: 3, y: 4 }));
    val l1: Label = Label { text: "a" };
    val l2: Label = Label { text: "b" };
    println(l1.text + l2.text);
    // T = Label: the error is reported here
    println(total_x(l1, l2));
    return 0;
}
