// Bugs roadmap BG490 (its trigger, stdlib/args.fd doc example 16):
// `assert_eq(0, p.len())` with `p: Vec<str>` was instantiated as
// `assert_eq__Vec__str` (mono typed the method call as its receiver) and
// died "Panic: Invalid memory access" on run, emit and ccompile. The
// length is an i64: assert_eq__i64.
//
// Expected output:
// ok
// ok 0

use args;

fn main() -> i64 {
    val p = args_positionals();
    assert_eq(0, p.len());
    println("ok");
    assert_eq(p.len(), 0);
    println(f"ok {p.len()}");
    return 0;
}
