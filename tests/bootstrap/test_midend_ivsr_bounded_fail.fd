// OP10 (compiler/iropt_me.fd ime_strength_reduce, pass `ivsr`): expected
// to fail at run time (division by zero at i = 5), after printing 0, 1000,
// 2000, 3000, 4000 and 5000. The product `i * 1000` is strength-reduced
// outside @wrapping code (the test `i < 10` bounds i); the panic must come
// where the plain loop has it: after the sixth line, never before it, and
// "unreachable" is never printed (tests/tooling/ivsr-check.sh compares the
// output with ivsr on and off).

fn main() {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 10 {
        println(i * 1000);
        t = t + 100 / (5 - i);
        i = i + 1;
    }
    println(t);
    println("unreachable");
}
