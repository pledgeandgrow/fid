// BG231 (docs/roadmap/bugs-roadmap.md): `p_read_stdin` with a negative
// length is a failure (0), not a write into a 0-byte block. The C runtime
// is the one at fault; stdin is closed here, so nothing is read.
//
// Expected output:
// true
//@ backends: ccompile
fn main() -> i64 {
    val s = p_read_stdin(0 - 1);
    println((s as i64) == 0);
    return 0;
}
