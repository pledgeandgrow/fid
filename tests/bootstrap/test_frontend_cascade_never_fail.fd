// expect-error: struct 'P' has no field 'nope'
// CE6: one mistake, one error. `p.nope` is reported; every later use of
// `g`, whose type is the error's (never), adds nothing: negating it,
// testing it in `if` or `while`, indexing with it or into it, calling a
// method or reading a field on it. Before, each use was one more error
// (nine for this file). tests/cascade/check.sh checks the count.

struct P {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    val p = P { x: 1, y: 2 };
    val g = p.nope;
    val n = -g;
    val b = !g;
    if g {
        println("x");
    }
    while g {
        break;
    }
    val v: Vec<i64> = Vec::new();
    val w = v[g];
    val z = g[0];
    val m = g.len();
    val f = g.z;
    return 0;
}
