fn client_key_pem() -> str {
    return "-----BEGIN PRIVATE KEY-----\n"
        + "MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC1XNnQXg+oic8H\n"
        + "QSwM2h48Y8LGqXmhADhE0Tx2Wg7QNxZ8DkZN/K0+jiUoieLO34msW7+prX7okn5V\n"
        + "ZAKO3jnHELgBMiv4vIB2QqOGvY+W+/L+FzL/mG6kRJvmq7ZRUQoM7YTld9vD4m0u\n"
        + "QgvwC2fdLXEBLgPfUM5dlNxKYuKkm+K/6wYn3assY3SjXiUeUgCqEFdRuaka22kr\n"
        + "T3xXlV/il8sVWQG4+8V2P6uBk2y7YCpZT5CrKmQNODjUhSgQf6eOPX8laoa87Zi/\n"
        + "EMgQPRSZ+WTNjlfxli6LK9CUW2o2YhZiserp1CszeIfNeOjpz/Kc104TRXE813BK\n"
        + "I4Cif14LAgMBAAECggEAAZbC08KsiXH3ozJ3eSoEtMu885zy01hwpcMIMBNBk6Jq\n"
        + "ldim1ge+LtDzqLjDM25y7X8k8o7HZgXj3x9QBGy+/db60wvbpcNlBA7jvDT3R+qE\n"
