// expect-error: cannot assign to 'x' through `&mut x`: it is declared with `val`
// Bugs roadmap BG289: `&mut` of a `val` let it be changed through the
// reference (reference §5.1); before, this printed 6.
fn main() -> i64 {
    val x = 5;
    val r = &mut x;
    *r = 6;
    println(x);
    return 0;
}
