// Bugs roadmap BG130: the safety scans (@crashfree, @no-panic, @no-alloc,
// @no-recursion, @gas) look inside f-strings, enum literals, named
// arguments and `is`. What they allow there still compiles and runs: an
// f-string of values only, a call of another @crashfree function inside one,
// a division by a non-zero constant in an enum literal, `is` on a parameter.
//
// Expected output:
// v=3
// twice=6
// 5
// true
// 7
// done

@crashfree
@wrapping
fn twice(n: i64) -> i64 {
    return n + n;
}

@crashfree
fn show(n: i64) -> str {
    return f"v={n}";
}

@crashfree
fn show_twice(n: i64) -> str {
    return f"twice={twice(n)}";
}

@crashfree
fn half(n: i64) -> Option<i64> {
    return Option::Some(n / 2);
}

@crashfree
fn is_some(o: Option<i64>) -> bool {
    return o is Some;
}

@no-alloc
fn pick(n: i64) -> Option<i64> {
    return Option::Some(n);
}

fn main() -> i64 {
    println(show(3));
    println(show_twice(3));
    match half(10) {
        Option::Some(v) => {
            println(v);
        }
        Option::None => {
        }
    }
    println(is_some(Option::Some(1)));
    match pick(7) {
        Option::Some(v) => {
            println(v);
        }
        Option::None => {
        }
    }
    println("done");
    return 0;
}
