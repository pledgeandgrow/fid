// OP5 (competitive roadmap): inline2 (compiler/iropt_me.fd ime_inline, on
// by default) leaves the calls the backends know by name as calls
// (ime_backend_named): Vec_get, Vec_set, Vec_push and Vec_len are lowered
// by pe_ir and nat_ir themselves, with a fast path, and checks.fd proves
// their bounds checks away in counted loops. Copying core's Vec_get body
// into the loops below made this kind of program 2x slower (sieve) and up
// to 4x (bench/game fannkuch, nbody). main calls nothing but such
// functions: tests/tooling/inline2-vecfast-check.sh emits it with
// FID_NAT_DUMP=main through `emit --nat` with inline2 on and off and
// requires the same number of machine operations in main, and the same
// output from both.
//
// Expected output:
// 2262
// 199990000
// 39998
// 5000

fn main() -> i64 {
    val n: i64 = 20000;
    var is: Vec<u8> = Vec::filled(n, 1);
    is.set(0, 0);
    is.set(1, 0);
    var p: i64 = 2;
    while p * p < n {
        if is.get(p) == 1 {
            var m: i64 = p * p;
            while m < n {
                is.set(m, 0);
                m = m + p;
            }
        }
        p = p + 1;
    }
    var count: i64 = 0;
    var i: i64 = 0;
    while i < n {
        count = count + (is.get(i) as i64);
        i = i + 1;
    }
    println(count);
    var v: Vec<i64> = Vec::new();
    i = 0;
    while i < n {
        v.push(i);
        i = i + 1;
    }
    var sum: i64 = 0;
    i = 0;
    while i < v.len() {
        sum = sum + v.get(i);
        i = i + 1;
    }
    println(sum);
    i = 0;
    while i < v.len() {
        v.set(i, v.get(i) * 2);
        i = i + 1;
    }
    println(v.get(n - 1));
    var w: Vec<f64> = Vec::filled(5000, 0.5);
    var t: f64 = 0.0;
    i = 0;
    while i < w.len() {
        t = t + w.get(i) * 2.0;
        i = i + 1;
    }
    println(t as i64);
    return 0;
}
