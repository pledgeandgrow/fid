// BG210 (docs/roadmap/bugs-roadmap.md): a `:`, `}`, `{` or `"` inside a
// char literal within an f-string's braces is the literal's: `{c == ':'}`
// was split at the `:` as a format spec (it printed `false`), and
// `{d == '}'}` ended at the quoted brace (it printed `false'}`). lexer.fd
// read_fstring and parser.fd parse_fstring_parts skip a char literal
// whole (lex_fstr_expr_end, lex_fstr_lit_end).
//
// Expected output:
// true
// true
// true
// true true
// true|  125
// 7d 7b
// 58:true
fn main() -> i64 {
    val c: i64 = 58;
    val d: i64 = 125;
    val o: i64 = 123;
    val q: i64 = 34;
    println(f"{c == ':'}");
    println(f"{d == '}'}");
    println(f"{o == '{'}");
    println(f"{q == '"'} {q == '\"'}");
    println(f"{c == ':'}|{d:5}");
    println(f"{'}':x} {'{':x}");
    println(f"{c}:{':' == c}");
    return 0;
}
