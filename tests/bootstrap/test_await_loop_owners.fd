// Bugs roadmap BG46: a single `await t` inside a loop body was counted
// once, so each iteration was handed the task's one owner of its result —
// the first round's drop freed what later rounds (and the kept copy)
// still read. An await inside a loop takes an owner of its own each
// iteration now (lower.fd g_lw_roots_loop).
// Expected output:
// v7 v7 v7
// v7
fn mk(n: i64) -> str {
    return "v" + int_to_str(n);
}

fn main() {
    val t = spawn mk(7);
    var s: str = "";
    var i: i64 = 0;
    while i < 3 {
        var r = await t;
        s = s + r + " ";
        i = i + 1;
    }
    println(s);
    val once = await t;
    println(once);
}
