// BG302 (docs/roadmap/bugs-roadmap.md): an f32 with a format specifier
// (`{x:.3}`, `{x:8.2}`) is formatted as a float (BG157 fixed `{x}` only);
// its bit pattern was printed as an integer.
//
// Expected output:
// [1.500] [    1.50]
// [-2.25]

fn idf(x: f32) -> f32 {
    return x;
}

fn main() {
    val f = idf(1.5);
    println(f"[{f:.3}] [{f:8.2}]");
    val g: f32 = idf(-2.25);
    println(f"[{g:.2}]");
}
