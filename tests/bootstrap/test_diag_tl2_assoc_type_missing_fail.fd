// expect-error: is missing associated type 'Item'
//! error: is missing associated type 'Item'
// TL2: a test per diagnostic of the type, borrow and escape checks.
// An impl of a trait (cap) must bind each associated type the trait declares.

cap Container {
    type Item;
    fn count(self) -> i64;
}

struct IntBox {
    value: i64,
}

impl Container for IntBox {
    pub fn count(self: IntBox) -> i64 {
        return 1;
    }
}

fn main() -> i64 {
    val b = IntBox { value: 3 };
    println(b.count());
    return 0;
}
