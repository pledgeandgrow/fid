// CL7 (fid): a program's own impl of a (trait, type) replaces a library's,
// even when two libraries both implement it (no conflict is reported then).
// Expected output:
// 301
// 3
use trait_conflict::shape_base;
use trait_conflict::shape_a;
use trait_conflict::shape_b;

impl Describe for Point {
    pub fn describe(self: Point) -> i64 {
        return 300 + self.x;
    }
}

fn main() -> i64 {
    val p: Point = Point { x: 1, y: 2 };
    println(p.describe());
    println(a_marker() + b_marker());
    return 0;
}
