// expect-error: which is not @send
// Bugs roadmap BG188: every enum counted as @send, whatever its payload:
// a variant holding a struct with a raw pointer reached another thread.
struct Handle {
    p: *mut i64,
}

enum Msg {
    H(Handle),
    N(i64),
}

fn work(m: Msg) -> i64 {
    return 1;
}

fn main() {
    val h: Handle = Handle { p: 0 as *mut i64 };
    val t = spawn work(Msg::H(h));
    println(await t);
}
