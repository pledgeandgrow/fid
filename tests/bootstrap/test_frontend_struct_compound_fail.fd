// expect-error: no operator `-` on struct 'P': it has no method `sub`
// CL10 (fid): `p -= q` on a struct is `p = p - q`: without a `sub`
// method it is the same error as `p - q` (before, it compiled to
// arithmetic on the struct's address).

struct P {
    x: i64,
}

impl P {
    fn add(self: P, o: P) -> P {
        return P { x: self.x + o.x };
    }
}

fn main() -> i64 {
    var a: P = P { x: 1 };
    a -= P { x: 1 };
    println(a.x);
    return 0;
}
