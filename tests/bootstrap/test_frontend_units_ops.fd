// CL10 (fid): operators on unit values: `+`/`-` on one unit, `*`/`/` by an
// f64 (stdlib/units.fd's impls; `a + b` calls `a.add(b)`). Mixing units
// stays a type error (test_frontend_units_ops_fail.fd).
// Expected output:
// 150
// 50
// 300
// 25
// 310
use units;

fn main() -> i64 {
    val a: Meters = meters(100.0);
    val b: Meters = meters(50.0);
    val s: Meters = a + b;
    println(int_to_str(s.value as i64));
    val m: Meters = a - b;
    println(int_to_str(m.value as i64));
    val c: Meters = a * 3.0;
    println(int_to_str(c.value as i64));
    val d: Meters = a / 4.0;
    println(int_to_str(d.value as i64));
    val k: Kelvin = kelvin(300.0) + kelvin(10.0);
    println(int_to_str(k.value as i64));
    return 0;
}
