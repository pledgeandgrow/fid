// CA4 (complaint-roadmap): lock-order analysis — the same order every
// time is fine. Two mutexes are always taken in the same order (a, then
// b) from both paths that hold them, so no cycle exists.
//
// Expected output:
// 3
// 3

use sync;

fn with_both(m1: i64, m2: i64) -> i64 {
    sync_mutex_lock(m1);
    sync_mutex_lock(m2);
    var r: i64 = 1;
    sync_mutex_unlock(m2);
    sync_mutex_unlock(m1);
    return r;
}

fn main() -> i64 {
    var a: i64 = sync_mutex_create();
    var b: i64 = sync_mutex_create();
    // always a then b — the same order
    sync_mutex_lock(a);
    sync_mutex_lock(b);
    sync_mutex_unlock(b);
    sync_mutex_unlock(a);
    println(with_both(a, b) + with_both(a, b) + 1);
    return 0;
}
