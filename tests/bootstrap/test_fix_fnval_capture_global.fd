// Test (stdlib-agent bug 37): a closure reads and writes a global where it
// is, as a named function does. Closures copied the global into their env
// when they were made: `g = 2` afterwards was not seen (1 printed), and a
// closure doing h = h + 1 twice left h at 0. Also run it through
// `fid ccompile`.
// Expected output:
// 2
// 2
// 2
// 6 3
var g: i64 = 1;
var h: i64 = 0;

fn read_g(x: i64) -> i64 {
    return g + x;
}

fn main() {
    val f = fn(x: i64) -> i64 {
        return g + x;
    };
    g = 2;
    println(f(0));
    println(read_g(0));
    val inc = fn(x: i64) -> i64 {
        h = h + x;
        return h;
    };
    inc(1);
    inc(1);
    println(h);
    val add = fn(n: i64) -> i64 {
        h = h + n;
        g = g + 1;
        return h;
    };
    add(4);
    println(int_to_str(h) + " " + int_to_str(g));
}
