// Earlier miscompile "AGENTS 9 / known-bugs 1.6": struct fields after an
// enum-typed field were read at the wrong offset (field index * 8, while an
// enum field takes (1 + payload) words). Fields after one and after two
// enum fields, written and read back, and passed through a function.
//
// Expected output:
// 11
// 22
// b-text
// 33
// 7
// 30
// 44

enum Shape {
    Dot,
    Rect(i64, i64),
    Box3(i64, i64, i64),
}

struct Rec {
    a: i64,
    s: Shape,
    b: i64,
    name: str,
    t: Shape,
    c: i64,
}

fn area(s: Shape) -> i64 {
    match s {
        Shape::Dot => { return 0; }
        Shape::Rect(w, h) => { return w * h; }
        Shape::Box3(x, y, z) => { return x + y + z; }
    }
}

fn last(r: Rec) -> i64 {
    return r.c;
}

fn main() -> i64 {
    var r: Rec = Rec { a: 11, s: Shape::Box3(1, 2, 4), b: 22, name: "b-text", t: Shape::Rect(5, 6), c: 33 };
    println(int_to_str(r.a));
    println(int_to_str(r.b));
    println(r.name);
    println(int_to_str(last(r)));
    println(int_to_str(area(r.s)));
    println(int_to_str(area(r.t)));
    r.c = 44;
    println(int_to_str(r.c));
    return 0;
}
