// expect-error: Sandbox error: 'g()' has effect '!IO'
// Bugs roadmap BG375: a generic function whose bound method does IO,
// called inside `sandbox { }`, passed: g's own inferred effects miss the
// IO of the implementation it calls (known per instance).
cap T {
    fn t(self) -> i64;
}
struct A { a: i64 }
impl T for A {
    fn t(self: A) -> i64 {
        println(5);
        return 1;
    }
}
fn g<X: T>(x: X) -> i64 {
    return x.t();
}
fn main() {
    val a = A { a: 1 };
    sandbox {
        val r = g(a);
    }
}
