// expect-error: ? operator requires Option<T> or Result<T, E>. Found: i64
//! error: ? operator requires Option<T> or Result<T, E>. Found: i64
// TL2: a test per diagnostic of the type, borrow and escape checks.
// `?` unwraps an Option or a Result.

fn half(n: i64) -> Option<i64> {
    val m: i64 = n?;
    return Option::Some(m / 2);
}

fn main() -> i64 {
    println(half(4) ?? 0);
    return 0;
}
