// Bugs roadmap BG168: `fid wasm` kept the bits of a same-width cast
// between unsigned and signed narrow integers (compiler/wasm.fd
// Inst::BitCast, integer branch, loaded the value and nothing else), so a
// zero-extended u16 65535 became an i16 65535 and a u8 250 an i8 250. A
// signed target is now sign-extended (i64.extend8_s / extend16_s /
// extend32_s) and an unsigned one zero-extended (i64.and with the mask), as
// pe_ir's peir_norm_narrow does (BG38). Every backend prints the same.
//
// Expected output:
// -1
// -1
// true
// -6
// -1
// true
// 250
// 65535
// 4294967295
// 3

fn main() -> i64 {
    val g: u16 = 65535;
    println(g as i16);
    val g2: i16 = g as i16;
    println(g2);
    println(g2 < 0);
    val q: u8 = 250;
    println(q as i8);
    val w: u32 = 4294967295;
    val wi: i32 = w as i32;
    println(wi);
    println(wi < 0);
    val b: i8 = q as i8;
    println(b as u8);
    val h: i16 = g as i16;
    println(h as u16);
    println(wi as u32);
    // the signed value takes part in arithmetic with its sign
    val k: i8 = q as i8;
    println(k + 9);
    return 0;
}
