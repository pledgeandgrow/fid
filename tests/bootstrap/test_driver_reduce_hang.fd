// Driver goal RL20 (docs/roadmap/llvm-roadmap.md): the input of the
// timeout check of `fid reduce` in tests/tooling/rl20-db7-check.sh. The
// predicate there fails while `fid run` prints KEEP 42 and then 2. One of
// the reducer's tries removes `t = t - 10;`, and that candidate loops
// forever: without a timeout per try the reducer never ends; with
// `--timeout 5` the try is stopped, counts as another failure ("timeout")
// and is not kept. The helpers and the first prints can go. On any backend
// it is an ordinary program.
// Expected output:
// start
// 10
// KEEP 42
// 2

fn helper_a(x: i64) -> i64 {
    return x * 2;
}

fn main() -> i64 {
    println("start");
    var a: i64 = helper_a(5);
    println(a);
    var t: i64 = 26;
    var keep: i64 = 0;
    while t > 10 {
        t = t - 10;
        keep = keep + 1;
    }
    println("KEEP 42");
    println(keep);
    return 0;
}
