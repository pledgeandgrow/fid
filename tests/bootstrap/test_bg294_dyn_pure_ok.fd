// Bugs roadmap BG294: a `!{}` function may call a trait method through
// `dyn` or a bound when no implementation has an effect.
//
// Expected output:
// 3
// 3

cap Sized2 {
    fn size(self) -> i64;
}
struct Q { n: i64 }
impl Sized2 for Q {
    pub fn size(self: Q) -> i64 {
        return self.n;
    }
}
fn via_dyn(d: dyn Sized2) -> i64 !{} {
    return d.size();
}
fn via_generic<T: Sized2>(t: T) -> i64 !{} {
    return t.size();
}
fn main() -> i64 {
    val q = Q { n: 3 };
    println(via_dyn(q as dyn Sized2));
    println(via_generic(q));
    return 0;
}
