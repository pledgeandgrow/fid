// Minimal Fides kernel — boots via GRUB/multiboot2, prints to serial port
//
// Build: fidesc emit tests/bootstrap/test_kernel_hello.fd --boot -o release/kernel_hello.bin
// Run:   qemu-system-x86_64 -kernel release/kernel_hello.bin -serial stdio -display none

fn main() -> i64 {
    p_serial_init();
    serial_print("Hello from Fides OS!\n");
    p_hlt();
    return 0;
}

// Print a string to COM1 serial port, byte by byte
fn serial_print(s: str) -> i64 {
    var addr: i64 = s as i64;
    unsafe {
        var ptr: *mut u8 = addr;
        var b: i64 = *ptr;
        while b != 0 {
            p_serial_write(b);
            addr = addr + 1;
            ptr = addr;
            b = *ptr;
        }
    }
    return 0;
}
