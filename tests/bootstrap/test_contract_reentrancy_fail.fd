// expect-error: Contract error: @contract 'withdraw' can call itself again before it returns (through 'refund'): reentrancy
// Roadmap Phase 9 (blockchain): the classic contract exploit. `withdraw`
// calls `refund`, which calls `withdraw` again while the first call has
// not finished updating the balance.
fn refund(balance: i64, amount: i64) -> i64 {
    if amount > 1 {
        return withdraw(balance, amount - 1);
    }
    return balance;
}

@contract
@deterministic
@gas(5000)
fn withdraw(balance: i64, amount: i64) -> i64 {
    val left: i64 = refund(balance, amount);
    return left - amount;
}

fn main() -> i64 {
    println(withdraw(100, 3));
    return 0;
}
