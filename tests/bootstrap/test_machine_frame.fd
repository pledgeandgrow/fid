// Alloca data keeps its frame room: a fixed array local
fn arr_sum(n: i64) -> i64 {
    var a = [0, 0, 0, 0, 0, 0, 0, 0];
    for k in 0..8 {
        a[k] = n * k;
    }
    var s: i64 = 0;
    for k in 0..8 {
        s = s + a[k];
    }
    return s;
}

fn main() -> i64 {
    println(big(3));
    println(big(17));
    println(big(0 - 5));
    println(arr_sum(5));
    println(arr_sum(11));
    return 0;
}
