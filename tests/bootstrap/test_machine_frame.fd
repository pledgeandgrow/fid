// Track MI (docs/roadmap/llvm-roadmap.md MI8), the machine layer
// (compiler/nat_ir.fd): one frame layout, slots only for values that need
// one. On the machine IR every IR value lives in its vreg; the frame holds
// the outgoing argument area, Alloca data, the varargs area of spawn
// calls, the allocator's spill slots and the save area — no longer a slot
// per IR value (ng_gen_function: `FID_NAT_OFF=frameslots` keeps the old
// layout, a slot per value, as the comparison). `big` below has a few
// hundred IR values and few live at once: its frame was several KB (pages
// probed one by one, MI29) and is now a few words. Results are the same
// either way. Run tests/nattools/machine_frame_check.sh (the frame sizes
// from `fid emit --stats`) and NATIVE=1 bash scripts/cross-test.sh on the
// machine targets with FID_VERIFY=1.
// Expected output:
// -4976
// 50432
// -44752
// 140
// 308

fn big(x: i64) -> i64 {
    var acc: i64 = 0;
    val a1: i64 = x * 1 + 1;
    val b1: i64 = a1 ^ 3;
    acc = acc + (b1 % 1000) - 1;
    val a2: i64 = x * 2 + 2;
    val b2: i64 = a2 ^ 6;
    acc = acc + (b2 % 1000) - 2;
    val a3: i64 = x * 3 + 3;
