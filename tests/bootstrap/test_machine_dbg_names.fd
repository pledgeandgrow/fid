// CT9 (docs/roadmap/complaint-roadmap.md) on the machine layer: the DWARF
// of a native Linux build (compiler/nat_enc.fd nat_elf_debug,
// nat_dbg_types; compiler/nat_ir.fd ng_dbg_shown_name, ng_dbg_type_descs)
// names the method `Point::len2` as Fides writes it (its symbol `Point_len2`
// is the linkage name) and describes `struct Point` and `struct Seg` with
// their fields by their Fides names and types (`Seg.a` is a Point held
// inline). Check:
//   fid emit tests/bootstrap/test_machine_dbg_names.fd --target x86_64-linux -o t
//   python3 tests/nattools/dbg_names_check.py t
// then `ptype struct Seg` and `break 'Point::len2'` in gdb.
// Expected output:
// 25
// 7
// 3

struct Point {
    x: i64,
    y: i64,
}

struct Seg {
    a: Point,
    b: Point,
    tag: u8,
}

impl Point {
    fn len2(self) -> i64 {
        // (the panic call keeps the mid-end's inline2 from folding it into
        // main — ime_panic_frame — so it keeps a function entry of its own)
        var sq: i64 = self.x * self.x + self.y * self.y;
        if sq > 1000000 {
            panic("too far");
        }
        return sq;
    }
}

fn seg_dx(s: Seg) -> i64 {
    return s.b.x - s.a.x;
}

fn main() {
    val p: Point = Point { x: 3, y: 4 };
    println(p.len2());
    val s: Seg = Seg { a: Point { x: 1, y: 2 }, b: Point { x: 8, y: 9 }, tag: 3 };
    println(seg_dx(s));
    println(s.tag as i64);
}
