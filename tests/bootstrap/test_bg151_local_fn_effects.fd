// Bugs roadmap BG151: a call through a local bound to a named function
// takes that function's effects, one bound to a closure its body's; a pure
// function and a pure closure keep a `!{}` function pure.
//
// Expected output:
// 16

fn twice(x: i64) -> i64 {
    return x * 2;
}

fn calc(n: i64) -> i64 !{} {
    val f = twice;
    val g = fn(x: i64) -> i64 => x + 1;
    return f(n) + g(n);
}

fn main() -> i64 {
    println(calc(5));
    return 0;
}
