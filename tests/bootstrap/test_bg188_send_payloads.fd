// Bugs roadmap BG188 and BG220: an enum is @send when every variant's
// payload is (with the type arguments put in), and a generic struct whose
// fields are all @send is @send (it was rejected).
//
// Expected output:
// 7
// 4
// 9

enum Cmd {
    Add(i64),
    Stop,
}

struct Wrap<T> {
    v: T,
}

fn run(c: Cmd) -> i64 {
    match c {
        Cmd::Add(n) => {
            return n;
        }
        Cmd::Stop => {
            return 0;
        }
    }
}

fn unwrap_it(w: Wrap<i64>) -> i64 {
    return w.v;
}

fn opt(o: Option<i64>) -> i64 {
    return o.unwrap_or(0);
}

fn main() {
    val a = spawn run(Cmd::Add(7));
    println(await a);
    val w: Wrap<i64> = Wrap { v: 4 };
    val b = spawn unwrap_it(w);
    println(await b);
    val c = spawn opt(Option::Some(9));
    println(await c);
}
