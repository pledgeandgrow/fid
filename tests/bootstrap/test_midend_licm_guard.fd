// OP9 (ME25 in part; compiler/iropt_me.fd ime_licm_guard, opt-in
// FID_IROPT_ON=licmguard): arithmetic that may panic, in the first block
// of a loop's body, moves out of the loop under a guard: the header's test
// is computed once more before the loop, and the operation runs (once)
// only when that test would let the loop's first pass reach it.
// - div_body: `t / k` with t, k never stored by the loop. With no pass
//   (n = 0) the division is not made, so k = 0 raises nothing.
// - sub_body: `a - b` may overflow; with no pass it is not made either.
// - after_store: `t / k` comes after a store in the body (not a quiet
//   instruction): it stays where it is.
// The program prints the same with the pass on and off.
//
// Expected output:
// 0
// 30
// 12
// 0
// 6

fn div_body(n: i64, t: i64, k: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        acc = acc + t / k;
        i = i + 1;
    }
    return acc;
}

fn sub_body(n: i64, a: i64, b: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        acc = acc + (a - b);
        i = i + 1;
    }
    return acc;
}

fn after_store(n: i64, t: i64, k: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        i = i + 1;
        acc = acc + t / k;
    }
    return acc;
}

fn main() {
    println(div_body(0, 10, 0));
    println(div_body(3, 20, 2));
    println(sub_body(4, 5, 2));
    var m: i64 = 0 - 9223372036854775807;
    m = m - 1;
    println(sub_body(0, m, 1));
    println(after_store(2, 9, 3));
}
