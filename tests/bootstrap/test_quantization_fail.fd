// expect-error: Quantization error: function 'bad_quantized' is @quantized but (transi
// test_quantization_fail.fd — ML10: @quantized with dequantize
// Expected: FAIL (compile error)
// @quantized functions must not call dequantize_q8.

use tensor;
use quant;

@quantized
fn bad_quantized(w: Tensor, x: Tensor) -> Tensor {
    // Dequantizing inside @quantized defeats the purpose
    val w_dq = dequantize_q8(w, 0.1, 0);
    val result = matmul(x, w_dq);
    return result;
}

fn main() {
    val w = ones(vec2(2, 2));
    val x = ones(vec2(2, 2));
    val result = bad_quantized(w, x);
    return 0;
}

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}
