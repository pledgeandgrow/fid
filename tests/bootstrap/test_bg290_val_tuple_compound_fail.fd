// expect-error: cannot assign to 'b': it is declared with `val`
// Bugs roadmap BG290: a compound assignment to a name `val (a, b) = t`
// binds is rejected as for a plain `val`.
fn pair() -> (i64, i64) {
    return (3, 4);
}
fn main() -> i64 {
    val (a, b) = pair();
    b += 5;
    println(a + b);
    return 0;
}
