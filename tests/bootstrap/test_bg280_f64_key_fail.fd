// expect-error: a HashMap key cannot be f64: float keys are not supported
// Bugs roadmap BG280: a float-keyed map was hashed as a string key: every
// compiled backend crashed in hm_hash and `fid run` merged the keys
// (`3 3 true 1` for `1 2 false 3`).
fn main() {
    var m: HashMap<f64, i64> = HashMap::new();
    m.insert(1.5, 1);
    m.insert(-2.0, 2);
    m.insert(0.5, 3);
    println(f"{m.get(1.5)} {m.get(-2.0)} {m.contains(2.5)} {m.len()}");
}
