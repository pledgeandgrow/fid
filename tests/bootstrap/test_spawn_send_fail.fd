// expect-error: of the spawned call has type
// Test: every argument of a spawned call must be @send (release H4): a
// struct holding a raw pointer would share memory between threads.

struct Handle {
    p: *mut i64,
}

fn work(h: Handle) -> i64 {
    return 1;
}

fn main() {
    val h: Handle = Handle { p: 0 as *mut i64 };
    val t = spawn work(h);
    println(await t);
}
