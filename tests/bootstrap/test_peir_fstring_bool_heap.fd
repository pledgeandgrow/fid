// BG164: an f-string with a bool after the LF13 stack strings (at most 8
// per function) calls p_bool_to_str, whose pe_ir stub gave a plain
// p_malloc buffer with no string header: dropping it panicked "a str
// without a string header" on emit. It is a counted string now.
// Expected output:
// p = (1, 1)
// a=true c
// b 1
// 5
// 5
// 5
// 5
// 5
// 5
// 5
// 5
// true
// false
// kept true

fn keep(s: str) -> str {
    return s;
}

fn first(x: i64) {
    println(f"p = ({x}, {x})");
    val ok: bool = x == 1;
    println(f"a={ok} c");
    println(f"b {x}");
}

fn many(x: i64) {
    val ok: bool = x == 5;
    val no: bool = x == 6;
    println(int_to_str(x));
    println(int_to_str(x));
    println(int_to_str(x));
    println(int_to_str(x));
    println(int_to_str(x));
    println(int_to_str(x));
    println(int_to_str(x));
    println(int_to_str(x));
    println(f"{ok}");
    println(f"{no}");
    val s: str = keep(f"kept {ok}");
    println(s);
}

fn main() -> i64 {
    first(1);
    many(5);
    return 0;
}
