// expect-error: cannot be copied for the new thread
// Test: a spawned thread gets a whole copy of each argument. A struct
// holding a Vec cannot be copied that way (its copies would share the
// Vec's buffer, whose owner counts are not atomic): rejected.
struct Job { id: i64, data: Vec<i64> }

fn run(j: Job) -> i64 { return j.id; }

fn main() -> i64 {
    var d: Vec<i64> = Vec::new();
    d.push(1);
    val j = Job { id: 7, data: d };
    val t = spawn run(j);
    print(await t);
    return 0;
}
