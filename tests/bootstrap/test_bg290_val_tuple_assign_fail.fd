// expect-error: cannot assign to 'a': it is declared with `val`
// Bugs roadmap BG290: the names `val (a, b) = t` binds were assignable (the
// parser dropped val/var for a tuple, and the checker never recorded the
// names as vals): `a = 10` and `b += 5` were accepted and printed 10, 7.
fn main() -> i64 {
    val (a, b) = (1, 2);
    a = 10;
    b += 5;
    println(a);
    println(b);
    return 0;
}
