// expect-error: is generic (fn choose<U>), so it cannot be called through
// LG4: a generic trait method is not object-safe: a `dyn Chooser` holds one
// function per method, and `choose` has one per type it is used with
// (Pos__choose__i64, Pos__choose__str, ...), so a call through the object
// is a type error (typechecker.fd TypeChecker_check_method_call, the
// `dyn` receiver). Its non-generic methods still dispatch.
cap Chooser {
    fn choose<U>(self, a: U, b: U) -> U;
    fn tag(self) -> i64;
}

struct Pos { n: i64 }

impl Chooser for Pos {
    fn choose<U>(self, a: U, b: U) -> U { return a; }
    fn tag(self) -> i64 { return self.n; }
}

fn main() -> i64 {
    val p = Pos { n: 1 };
    val d = p as dyn Chooser;
    println(d.tag());
    println(d.choose(1, 2));
    return 0;
}
