// Earlier miscompile "AGENTS 4" (docs/verification/miscompile-log.md,
// AGENTS.md known bug 4): a `&mut Vec<T>` parameter forwarded to a function
// taking the same `&mut Vec<T>` was read as a header (no `*(void**)` load of
// the handle in the C generator's cast_arg): garbage lengths and crashes.
// Two levels of forwarding, with pushes and reads at each level.
//
// Expected output:
// 3
// 6
// 6
// 21

fn fill(v: &mut Vec<i64>, n: i64) {
    var i: i64 = 1;
    while i <= n {
        v.push(i);
        i = i + 1;
    }
}

fn fill_more(v: &mut Vec<i64>) {
    fill(v, 3);
    println(int_to_str(v.len()));
    v.push(4);
    v.push(5);
    v.push(6);
}

fn total(v: &mut Vec<i64>) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        t = t + v[i];
        i = i + 1;
    }
    return t;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    fill_more(&mut v);
    println(int_to_str(v.len()));
    println(int_to_str(v[5]));
    println(int_to_str(total(&mut v)));
    return 0;
}
