// expect-error: in 'f', a secret value is passed to 'put', which outputs its parameter 'x'
// Expected to FAIL: a method of a user type that prints its argument
// cannot be given a secret. (known-bugs 2g.71 changed how `x.m(..)` finds
// what it calls: an impl method by its name, a free function `T_m` only for
// a type T. This keeps the method case caught.)
struct Log {
    n: i64,
}

impl Log {
    fn put(self: &mut Log, x: i64) {
        println(int_to_str(x));
    }
}

fn f(@secret k: i64) {
    var l: Log = Log { n: 0 };
    l.put(k);
}

fn main() {
    f(42);
}
