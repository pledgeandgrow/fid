// Bugs roadmap BG345: stdlib/string.fd StrView::parse_int built the value
// positive with checked arithmetic, so 20 digits panicked "Integer
// overflow on multiplication" and "-9223372036854775808" panicked too,
// though the doc promises the value or `fallback`. The value is now built
// negative (where i64::MIN fits) with each step checked first.
//
// Expected output:
// -1
// -9223372036854775808
// 9223372036854775807
// -1
// -1
// 42 -42 -1 -1

use string;

fn main() {
    println(f"{str_view_all("99999999999999999999").parse_int(-1)}");
    println(f"{str_view_all("-9223372036854775808").parse_int(-1)}");
    println(f"{str_view_all("9223372036854775807").parse_int(-1)}");
    println(f"{str_view_all("9223372036854775808").parse_int(-1)}");
    println(f"{str_view_all("-9223372036854775809").parse_int(-1)}");
    println(f"{str_view_all("42").parse_int(-1)} {str_view_all("-42").parse_int(-1)} {str_view_all("4x").parse_int(-1)} {str_view_all("-").parse_int(-1)}");
}
