// Bugs roadmap BG156: `!b` on a bool and `await` of a Future<bool> were
// typed i64 in the IR (lower.fd Lowerer_infer_unary_type, Expr::Await), so
// the C build printed them with p_print_int (`1`, `0`) and a `val` holding
// `!b` got an i64 slot (`run` printed `1`). They are bools now.
//
// Expected output:
// false
// true
// true
// true
// false
// true
// false
// ok

fn idf(x: f64) -> f64 {
    return x;
}

fn idi(x: i64) -> i64 {
    return x;
}

fn wb(a: bool) -> bool {
    return !a;
}

fn main() -> i64 {
    println(!(idf(0.5) < 1.0));
    println(!(idi(3) < 1));
    val b: bool = idi(3) < 1;
    println(!b);
    val c = !b;
    println(c);
    println(!c);
    val t = spawn wb(false);
    println(await t);
    val t2 = spawn wb(true);
    println(await t2);
    if !c {
        println("wrong");
    } else {
        println("ok");
    }
    return 0;
}
