// WP12 (docs/roadmap/llvm-roadmap.md; compiler/iropt.fd
// iro_mask_annotated): a call to a @no-alloc function carries no Alloc in
// the effect mask its callers see (the annotation is checked by the
// typechecker), so LICM (OP25) may compute `tri(n)` once before the loop
// even though the loop's body allocates (`v.push`). No backend keeps
// allocator state across a call, so the mask is all the annotation needs
// to give. The program prints the same with FID_IROPT_OFF=licm,licmcall.
//
// Expected output:
// 45
// 10
// 0

@no-alloc
fn tri(n: i64) -> i64 {
    var s: i64 = 0;
    var k: i64 = 0;
    while k < n {
        s = s + k;
        k = k + 1;
    }
    return s;
}

fn count(n: i64) -> i64 {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < tri(n) {
        v.push(i);
        i = i + 1;
    }
    return v.len();
}

fn main() {
    println(tri(10));
    println(count(5));
    println(count(0));
}
