// expect-error: method 'P.set' parameter 1 expects 'i64', got 'str'
// Bugs roadmap BG18: a method's argument types were not checked:
// `p.set("a")` stored a string's address in an integer field.
struct P {
    n: i64,
}

impl P {
    fn set(self: &mut P, n: i64) {
        self.n = n;
    }
}

fn main() -> i64 {
    var p: P = P { n: 1 };
    p.set("a");
    println(int_to_str(p.n));
    return 0;
}
