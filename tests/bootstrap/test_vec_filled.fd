// Vec::filled(n, x) (Rust's vec![x; n]) for numbers, bools and strings, the
// bounds facts it gives a Vec that is never shortened (checks.fd), a local
// Vec kept on the stack (LF13), and a Vec shared only to be read (LF15).
//
// Expected output:
// 5 7 7
// 3 true false
// 2 ab ab
// 168
// 6
// 3 3

fn yes(b: bool) -> str {
    if b { return "true"; }
    return "false";
}

fn count_primes(n: i64) -> i64 {
    var is: Vec<u8> = Vec::filled(n, 1);
    is.set(0, 0);
    is.set(1, 0);
    var p: i64 = 2;
    while p * p < n {
        if is.get(p) == 1 {
            var m: i64 = p * p;
            while m < n { is.set(m, 0); m = m + p; }
        }
        p = p + 1;
    }
    var count: i64 = 0;
    var i: i64 = 0;
    while i < n { count = count + (is.get(i) as i64); i = i + 1; }
    return count;
}

fn local_sum() -> i64 {
    // never leaves this function: its header is on the stack
    var v: Vec<i64> = Vec::new();
    v.push(1); v.push(2); v.push(3);
    var t: i64 = 0;
    var i: i64 = 0;
    while i < v.len() { t = t + v.get(i); i = i + 1; }
    return t;
}

fn main() -> i64 {
    var a: Vec<i64> = Vec::filled(5, 7);
    println(int_to_str(a.len()) + " " + int_to_str(a.get(0)) + " " + int_to_str(a.get(4)));
    var b: Vec<bool> = Vec::filled(3, true);
    b.set(2, false);
    println(int_to_str(b.len()) + " " + yes(b.get(0)) + " " + yes(b.get(2)));
    var s: Vec<str> = Vec::filled(2, "a" + "b");
    println(int_to_str(s.len()) + " " + s.get(0) + " " + s.get(1));
    println(int_to_str(count_primes(1000)));
    println(int_to_str(local_sum()));
    var rows: Vec<Vec<i64>> = Vec::new();
    rows.push(Vec::filled(3, 1));
    var r: Vec<i64> = rows.get(0);
    println(int_to_str(r.len()) + " " + int_to_str(rows.get(0).len()));
    return 0;
}
