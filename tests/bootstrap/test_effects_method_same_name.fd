// Bugs roadmap BG58: a method's effects were stored under its bare name
// too, over a free function of that name: `update` took Game.update's IO
// and the @deterministic `step`, which calls the pure free `update`, was
// rejected. The free function keeps its own effects.
// Expected output:
// tick 1
// 8
struct Game {
    t: i64,
}

impl Game {
    fn update(self: Game) {
        println("tick " + int_to_str(self.t));
    }
}

fn update(x: i64) -> i64 {
    return x + 1;
}

@deterministic
fn step(x: i64) -> i64 {
    return update(x) * 2;
}

fn main() -> i64 {
    val g: Game = Game { t: 1 };
    g.update();
    println(int_to_str(step(3)));
    return 0;
}
