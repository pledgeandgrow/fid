// expect-error: but 'report' returns void
// known-bugs 2g.55: a function without a return type cannot hand None or
// Err back to its caller either: `?` in it is a type error.
use core;

fn parse(s: str) -> Result<i64, str> {
    if s == "" {
        return Result::Err("empty");
    }
    return Result::Ok(str_len(s));
}

fn report(s: str) {
    val n = parse(s)?;
    println(n);
}

fn main() -> i64 {
    report("abc");
    return 0;
}
