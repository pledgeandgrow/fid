// ─── Recursive functions (exercise call stack) ─────────────────────────────

fn fib(n: i64) -> i64 {
    if n <= 1 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn factorial(n: i64) -> i64 {
    if n <= 1 { return 1; }
    return n * factorial(n - 1);
}

fn ackermann(m: i64, n: i64) -> i64 {
    if m == 0 { return n + 1; }
    if n == 0 { return ackermann(m - 1, 1); }
    return ackermann(m - 1, ackermann(m, n - 1));
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { return a; }
    return gcd(b, a % b);
}

// ─── Large string operations ───────────────────────────────────────────────

fn build_large_string(n: i64) -> str {
    var result = "";
    var i = 0;
    while i < n {
        result = result + int_to_str(i % 10);
        i = i + 1;
    }
    return result;
}

fn count_char(s: str, c: str) -> i64 {
    var count: i64 = 0;
    var i = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) == str_byte_at(c, 0) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

// ─── Main test function ────────────────────────────────────────────────────

fn main() -> i64 {
    print("SH-5: Large program test\n");

    // Test 1: Vec with 10K elements
    print("Test 1: Vec 10K elements... ");
    var v = vec_build(10000);
    var sum = vec_sum(v);
    assert_eq(sum, 99990000);  // sum of 0..9999 * 2
    print("OK\n");

    // Test 2: Vec filter and map
    print("Test 2: Vec filter+map... ");
    var evens = vec_filter_even(v);
    var doubled = vec_map_double(evens);
    var dsum = vec_sum(doubled);
    assert(dsum > 0);
    print("OK\n");

    // Test 3: HashMap with 1K entries
    print("Test 3: HashMap 1K entries... ");
    var hsum = hashmap_build(1000);
    // sum of i*i for i=0..999 = 332833500
    assert_eq(hsum, 332833500);
    print("OK\n");

    // Test 4: Deep nesting (50 levels)
    print("Test 4: Deep nesting 50 levels... ");
    var dn = deep_nest_50(50);
    assert_eq(dn, 50);
    var dn2 = deep_nest_50(25);
    assert_eq(dn2, 25);
    print("OK\n");

    // Test 5: Match with 10 arms
    print("Test 5: Match 10 arms... ");
    var i = 0;
    while i <= 10 {
        var r = match_test(i);
        if i < 10 {
            var expected1: i64 = (i + 1) * 100; assert_eq(r, expected1);
        } else {
            var expected2: i64 = i * 100; assert_eq(r, expected2);
        }
        i = i + 1;
    }
    print("OK\n");

    // Test 6: String building (10K chars)
    print("Test 6: String 10K chars... ");
    var s = build_large_string(10000);
    var expected_len: i64 = 10000; assert_eq(str_len(s), expected_len);
    print("OK\n");

    // Test 7: Recursive functions
    print("Test 7: Recursion (fib, factorial, gcd)... ");
    assert_eq(fib(10), 55);
    assert_eq(factorial(5), 120);
    assert_eq(gcd(48, 18), 6);
    print("OK\n");

    // Test 8: Many function calls (100+ functions)
    print("Test 8: 100+ function calls... ");
    var fsum: i64 = 0;
    fsum = fsum + f0(0);
    fsum = fsum + f1(0);
