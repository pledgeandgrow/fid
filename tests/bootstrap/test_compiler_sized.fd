// Functions with loops (exercise codegen loop lowering)
fn loop_sum(count: i64) -> i64 {
    var sum: i64 = 0;
    var i = 0;
    while i < count {
        sum = sum + i;
        i = i + 1;
    }
    return sum;
}

fn loop_nested(rows: i64, cols: i64) -> i64 {
    var total: i64 = 0;
    var r = 0;
    while r < rows {
        var c = 0;
        while c < cols {
            total = total + r * c;
            c = c + 1;
        }
        r = r + 1;
    }
    return total;
}

fn loop_triple(n: i64) -> i64 {
    var total: i64 = 0;
    var i = 0;
    while i < n {
        var j = 0;
        while j < n {
            var k = 0;
            while k < n {
                total = total + 1;
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return total;
}

// Functions with match (exercise codegen match lowering)
fn match_test(n: i64) -> i64 {
    match n {
        0 => { return 100; }
        1 => { return 200; }
        2 => { return 300; }
        3 => { return 400; }
        4 => { return 500; }
        5 => { return 600; }
        6 => { return 700; }
        7 => { return 800; }
        8 => { return 900; }
        9 => { return 1000; }
        _ => { return n * 100; }
    }
}

fn match_range(n: i64) -> i64 {
    if n >= 0 && n < 10 {
        return 1;
    } else if n >= 10 && n < 20 {
        return 2;
    } else if n >= 20 && n < 30 {
        return 3;
    } else if n >= 30 && n < 40 {
        return 4;
    } else if n >= 40 && n < 50 {
        return 5;
    } else if n >= 50 && n < 60 {
        return 6;
    } else if n >= 60 && n < 70 {
        return 7;
    } else if n >= 70 && n < 80 {
        return 8;
    } else if n >= 80 && n < 90 {
        return 9;
    } else if n >= 90 && n < 100 {
        return 10;
    } else {
        return 0;
    }
}

// Functions with string operations
fn str_build(n: i64) -> str {
    var result = "";
    var i = 0;
    while i < n {
        result = result + "x";
        i = i + 1;
    }
    return result;
}

fn str_concat_n(s: str, n: i64) -> str {
    var result = s;
    var i = 0;
    while i < n {
        result = result + s;
        i = i + 1;
    }
    return result;
}

fn str_reverse(s: str) -> str {
    var len = str_len(s);
    var result = "";
    var i = len - 1;
    while i >= 0 {
        result = result + p_char_to_str(str_byte_at(s, i));
        i = i - 1;
    }
    return result;
}

// ─── Vec operations (10K elements) ─────────────────────────────────────────

fn vec_build(n: i64) -> Vec {
    var v = Vec::new();
    var i = 0;
    while i < n {
        v.push(i * 2);
        i = i + 1;
    }
    return v;
}

fn vec_sum(v: Vec<i64>) -> i64 {
    var sum: i64 = 0;
    var i = 0;
    while i < v.len() {
        sum = sum + v.get(i);
        i = i + 1;
    }
    return sum;
}

fn vec_max(v: Vec<i64>) -> i64 {
    if v.len() == 0 { return 0; }
    var max = v.get(0);
    var i = 1;
    while i < v.len() {
        if v.get(i) > max {
            max = v.get(i);
        }
        i = i + 1;
    }
    return max;
}

fn vec_filter_even(v: Vec<i64>) -> Vec {
    var result = Vec::new();
    var i = 0;
    while i < v.len() {
        var val = v.get(i);
        if val % 2 == 0 {
            result.push(val);
        }
        i = i + 1;
    }
    return result;
}

fn vec_map_double(v: Vec<i64>) -> Vec {
    var result = Vec::new();
    var i = 0;
    while i < v.len() {
        result.push(v.get(i) * 2);
        i = i + 1;
    }
    return result;
}

// ─── HashMap operations (1K entries) ───────────────────────────────────────

fn hashmap_build(n: i64) -> i64 {
    var m = HashMap::new();
    var i = 0;
    while i < n {
        var key = "key" + int_to_str(i);
        m.insert(key, i * i);
        i = i + 1;
    }
    // Verify a few entries
    var sum: i64 = 0;
    var j = 0;
    while j < n {
        var key = "key" + int_to_str(j);
        var val = m.get(key);
        sum = sum + val;
        j = j + 1;
    }
    return sum;
}

