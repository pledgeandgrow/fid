    print("OK\n");

    // Test 9: Struct creation and field access
    print("Test 9: 100 structs... ");
    var s0 = make_s0(1, 2, 3, 4);
    var s1 = make_s1(5, 6, 7, 8);
    var s2 = make_s2(9, 10, 11, 12);
    var s3 = make_s3(13, 14, 15, 16);
    var s4 = make_s4(17, 18, 19, 20);
    var s5 = make_s5(21, 22, 23, 24);
    var s6 = make_s6(25, 26, 27, 28);
    var s7 = make_s7(29, 30, 31, 32);
    var s8 = make_s8(33, 34, 35, 36);
    var s9 = make_s9(37, 38, 39, 40);
    assert_eq(s0.x, 1);
    assert_eq(s1.y, 6);
    assert_eq(s2.z, 11);
    assert_eq(s3.w, 16);
    assert_eq(s4.x, 17);
    assert_eq(s5.label, "S5");
    print("OK\n");

    // Test 10: Nested loops
    print("Test 10: Nested loops... ");
    var nl = loop_nested(100, 100);
    // sum of r*c for r=0..99, c=0..99 = (sum 0..99)^2 = 4950^2 = 24502500
    assert_eq(nl, 24502500);
    print("OK\n");

    print("\nSH-5: All tests passed!\n");
    return 0;
}
