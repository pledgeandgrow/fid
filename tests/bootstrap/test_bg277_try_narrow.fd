// BG277 (docs/roadmap/bugs-roadmap.md): `x?` on an Option or Result of a
// narrow integer gives the payload as its type (`Some(-3i8)?` was 253 on
// run/C and junk on the native backends).
//
// Expected output:
// -30
// -700
// 65535
// true

fn id8(x: i8) -> i8 {
    return x;
}

fn id16(x: i16) -> i16 {
    return x;
}

fn o8() -> Option<i8> {
    return Option::Some(id8(-3));
}

fn use8() -> Option<i64> {
    val z = o8()?;
    return Option::Some((z as i64) * 10);
}

fn r16() -> Result<i16, str> {
    return Result::Ok(id16(-7));
}

fn use16() -> Result<i64, str> {
    val z = r16()?;
    return Result::Ok((z as i64) * 100);
}

fn ou16() -> Option<u16> {
    val x: u16 = 65535;
    return Option::Some(x);
}

fn useu16() -> Option<i64> {
    val z = ou16()?;
    return Option::Some(z as i64);
}

fn ob() -> Option<bool> {
    return Option::Some(true);
}

fn useb() -> Option<bool> {
    val b = ob()?;
    return Option::Some(b);
}

fn main() {
    println(f"{use8().unwrap()}");
    println(f"{use16().unwrap()}");
    println(f"{useu16().unwrap()}");
    println(f"{useb().unwrap()}");
}
