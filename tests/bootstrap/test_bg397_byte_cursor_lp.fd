// Bugs roadmap BG397: stdlib/buffer.fd's read_string_lp and
// read_remaining_string advanced the caller's cursor through a by-value
// `self` (the bug); they now take `self: &mut ByteCursor`, so the cursor
// moves as it does for every other read.
//
// Expected output:
// hi
// 6
// rest
// 0

use buffer;

fn main() -> i64 {
    var cur = ByteCursor::new();
    cur.write_u32_le(2);
    cur.write_u8(104);
    cur.write_u8(105);
    cur.write_u8(114);
    cur.write_u8(101);
    cur.write_u8(115);
    cur.write_u8(116);
    cur.rewind();
    println(cur.read_string_lp());
    println(cur.pos);
    println(cur.read_remaining_string());
    println(cur.remaining());
    return 0;
}
