// `v.extend(v)` doubles v (complaint CM10): the count of the Vec being
// appended is read once, so the loop ends, and every element is read from
// the buffer as it is when read (a push that grows v frees the old one).
// Checked on every backend: core's vec_raw_extend and the C runtime's
// p_vec_extend.
//
// Expected output:
// 6: 1 2 3 1 2 3
// 12 last 3
// strings: a b a b
use vec;

fn show(v: Vec<i64>) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < v.len() {
        out = out + " " + int_to_str(v.get(i));
        i = i + 1;
    }
    return out;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    v.extend(v);
    println(int_to_str(v.len()) + ":" + show(v));
    // past the first capacity: the buffer moves while it is read
    v.extend(v);
    println(int_to_str(v.len()) + " last " + int_to_str(v.get(v.len() - 1)));
    var s: Vec<str> = Vec::new();
    s.push("a");
    s.push("b");
    s.extend(s);
    println("strings: " + s.get(0) + " " + s.get(1) + " " + s.get(2) + " " + s.get(3));
    return 0;
}
