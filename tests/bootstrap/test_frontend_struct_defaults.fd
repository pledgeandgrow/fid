// CL5: struct fields with defaults, and literals ending in `..` that take
// them for every field they leave out (no builder needed). A written field
// wins over its default; a default can be a string, a struct literal (with
// its own `..`) or an expression.
// Expected output:
// localhost
// 8080
// 30
// true
// example.org
// 80
// 30
// false
// 3
// 4
// 7
// 0

struct Limits {
    max_conns: i64 = 3,
    max_body: i64 = 4,
}

struct Config {
    host: str = "localhost",
    port: i64 = 8000 + 80,
    timeout_s: i64 = 30,
    verbose: bool = true,
    limits: Limits = Limits { .. },
}

struct Point {
    x: i64,
    y: i64 = 7,
}

fn show(c: Config) {
    println(c.host);
    println(c.port);
    println(c.timeout_s);
    println(c.verbose);
}

fn main() -> i64 {
    val a = Config { .. };
    show(a);
    val b = Config { host: "example.org", port: 80, verbose: false, .. };
    show(b);
    println(b.limits.max_conns);
    println(b.limits.max_body);
    val p = Point { x: 0, .. };
    println(p.y);
    println(p.x);
    return 0;
}
