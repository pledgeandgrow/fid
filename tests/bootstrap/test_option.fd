// Test generic enum: Option<T>

enum Option {
    Some(i64),
    None,
}

fn some_func() -> Option {
    return Option::Some(42);
}

fn none_func() -> Option {
    return Option::None;
}

fn main() -> i32 {
    val a = some_func();
    match a {
        Option::Some(v: i64) => { print(v); }
        Option::None => { print(0); }
    }

    val b = none_func();
    match b {
        Option::Some(v: i64) => { print(v); }
        Option::None => { print(-1); }
    }

    return 0;
}
