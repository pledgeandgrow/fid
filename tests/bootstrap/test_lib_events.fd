// stdlib/events: `on name(params) { body }` handlers become functions named
// __on_name that are called directly, and events_dispatch(name) is the
// placeholder for queued dispatch: it is callable and does nothing yet, so
// a handler runs only when called by its own name.
use events;

on click(x: i64, y: i64) {
    print("click ");
    print(x);
    print(",");
    println(y);
}

on key(name: str) {
    print("key ");
    println(name);
}

on tick() {
    println("tick");
}

fn main() -> i64 {
    __on_click(10, 20);
    __on_key("space");
    __on_tick();
    __on_tick();
    // the placeholder does not call the handlers
    events_dispatch("click");
    events_dispatch("nothing registered");
    println("dispatched");
    __on_click(-1, 0);
    return 0;
}
