// expect-error: It is lost on the path through the `?` on line
// Bugs roadmap BG416: `?` returns from the function on None/Err as a
// `return` does, but only `return` checked the linear values still live:
// `t` was lost whenever g() gave None.
@linear
struct T { v: i64 }
fn eat(t: T) -> i64 { return t.v; }
fn g() -> Option<i64> { return Option::None; }
fn f() -> Option<i64> {
    val t = T { v: 1 };
    val x = g()?;
    return Option::Some(eat(t) + x);
}
fn main() {
    println(f() ?? 7);
}
