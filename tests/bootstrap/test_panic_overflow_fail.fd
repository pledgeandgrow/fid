// Expected to fail at run time: integer overflow panics on every backend and
// target (release F6). What prints before the panic, the panic and the exit
// code are compared across targets by scripts/cross-test.sh (panic tests).

fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn main() {
    val max: i64 = 9223372036854775807;
    print("before\n");
    val r = add(max, 1);
    print(r);
    print("unreachable\n");
}
