// An if/else or match in value position has the value of the branch taken:
// as a function's last statement, after `else if`, nested in a branch, and
// for f64 and str values. These all returned 0 (or garbage) before.

fn max(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn sign(x: i64) -> i64 {
    if x > 0 { 1 } else if x < 0 { -1 } else { 0 }
}

fn half_or_zero(x: f64) -> f64 {
    if x > 0.0 { x / 2.0 } else { 0.0 }
}

fn describe(n: i64) -> str {
    if n == 0 { "zero" } else if n < 10 { "small" } else { "big" }
}

fn bucket(n: i64) -> i64 {
    match n {
        0 => { 100 }
        1 => { 200 }
        _ => { if n > 50 { 300 } else { 400 } }
    }
}

fn main() -> i64 {
    println(max(3, 9));
    println(max(8, 2));
    println(sign(-3));
    println(sign(0));
    println(sign(7));
    println(half_or_zero(5.0));
    println(half_or_zero(-1.0));
    println(describe(0));
    println(describe(4));
    println(describe(40));
    println(bucket(1));
    println(bucket(99));
    println(bucket(7));
    val y: i64 = 5;
    val nested = if y > 0 { if y > 3 { 2 } else { 1 } } else { 0 };
    println(nested);
    val x: i64 = -3;
    val chained = if x > 0 { 1 } else if x < 0 { -1 } else { 0 };
    println(chained);
    return 0;
}
