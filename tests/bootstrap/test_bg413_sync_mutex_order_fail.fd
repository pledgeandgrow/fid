// expect-error: locks are taken in an inconsistent order
// Bugs roadmap BG413: the lock-order check (SR-18) never saw stdlib/sync.fd's
// own SyncMutex: `m.lock()` locks through `self.handle`, a field, so it was
// no named lock and opposite orders in one function passed `fid check`
// (with raw p_mutex_lock handles the same code is E083).
use sync;
fn main() {
    val a = SyncMutex::new();
    val b = SyncMutex::new();
    a.lock();
    b.lock();
    b.unlock();
    a.unlock();
    b.lock();
    a.lock();
    a.unlock();
    b.unlock();
    println("ok");
}
