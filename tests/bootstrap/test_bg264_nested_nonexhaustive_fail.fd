// expect-error: missing variant(s): Result::Err
// Bugs roadmap BG264: the nested-pattern desugaring hid the uncovered
// `Some(Err(..))`: `Some(Ok(x))` + `None` compiled and panicked "nested
// match: no arm matched" at run time (reference §6: a match on an enum
// covers every variant).
fn f(o: Option<Result<i64, str>>) -> i64 {
    match o {
        Option::Some(Result::Ok(x)) => {
            return x;
        }
        Option::None => {
            return 0;
        }
    }
    return 9;
}
fn main() -> i64 {
    println(f(Option::Some(Result::Err("bad"))));
    return 0;
}
