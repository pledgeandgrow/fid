// L3F: No function coloring
// Any function can be called from any context (sync or concurrent)
// No async fn vs fn distinction — effect handlers handle asynchronicity
// No await keyword needed — effect handler resume is implicit

fn regular_fn(x: i64) -> i64 {
    x + 1
}

fn handler_fn(x: i64) -> i64 {
    // This function uses an effect handler internally
    // but can be called from anywhere — no special "async" marker needed
    handle {
        do IO.print(x);
        x * 2
    } with {
        IO.print(v) => {
            println(v);
            resume(cont, 0);
        }
    }
}

fn main() {
    // Call regular function — works
    val a = regular_fn(10);
    println(a);

    // Call function with effect handler — also works, no special syntax
    val b = handler_fn(20);
    println(b);

    // Call from inside a spawn scope — also works
    spawn scope {
        val c = regular_fn(30);
        println(c);
    }

    // Call from inside a handle block — also works
    handle {
        val d = regular_fn(40);
        println(d);
        do IO.print(d);
    } with {
        IO.print(v) => {
            println(v);
            resume(cont, 0);
        }
    }
}
