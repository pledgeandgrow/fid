// test_globals.fd — Test module-level mutable global variables

var g_counter: i64 = 0;
pub var g_debug: bool = false;

fn increment() -> i64 {
    g_counter = g_counter + 1;
    return g_counter;
}

fn main() -> i64 {
    // Test reading initial value
    if g_counter != 0 { return 1; }

    // Test writing
    g_counter = 42;
    if g_counter != 42 { return 2; }

    // Test reading after write
    var x: i64 = g_counter;
    if x != 42 { return 3; }

    // Test incrementing via function call
    g_counter = 0;
    var a: i64 = increment();
    var b: i64 = increment();
    var c: i64 = increment();
    if a != 1 { return 4; }
    if b != 2 { return 5; }
    if c != 3 { return 6; }

    // Test bool global
    g_debug = true;
    if !g_debug { return 7; }
    g_debug = false;
    if g_debug { return 8; }

    // Test compound assignment
    g_counter = 10;
    g_counter += 5;
    if g_counter != 15 { return 9; }
    g_counter -= 3;
    if g_counter != 12 { return 10; }

    return 0;
}
