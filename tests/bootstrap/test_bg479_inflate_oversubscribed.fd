// Bugs roadmap BG479: stdlib/compress.fd inflate built Huffman tables
// from a dynamic block's code lengths without checking that they form a
// prefix code: over-subscribed lengths (literal 65 and 256 of length 1,
// 66 of length 2: 1/2 + 1/2 + 1/4 > 1) decoded "AA" where zlib rejects the
// stream ("invalid literal/lengths set"). Such a block is now an error
// (empty output), as in zlib and puff. The second stream is the same block
// with valid lengths (256 of length 2, a single distance code of length
// 1, allowed): zlib gives "AA". Streams built by hand in Python, checked
// with zlib.decompress(raw, -15).
//
// Expected output:
// bad 0
// good 2 65 65

use compress;
use encoding;

fn main() {
    val bad: Vec<i64> = inflate(hex_decode_bytes("05c081000000008020b6f6872a02"));
    println(f"bad {bad.len()}");
    val good: Vec<i64> = inflate(hex_decode_bytes("05c081000000008020b6f6873a06"));
    println(f"good {good.len()} {good.get(0)} {good.get(1)}");
}
