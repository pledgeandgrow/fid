// expect-error: the result of 'pick' has lifetime 'b, which no parameter carries
// LG3: a result's lifetime must be one a parameter carries (a reference can
// only be returned from a reference parameter).
fn pick<'a, 'b>(x: &'a i64) -> &'b i64 {
    return x;
}

fn main() -> i64 {
    var a: i64 = 1;
    println(*pick(&a));
    return 0;
}
