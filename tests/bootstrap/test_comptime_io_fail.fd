// expect-error: 'p_file_size()' does I/O
// CD8 (complaint roadmap): comptime code runs inside the compiler with no
// I/O. A comptime that reads a file is a compile error (before, it could
// not be evaluated and quietly ran when the program did).

fn main() -> i64 {
    val n = comptime p_file_size("ark.toml");
    println(int_to_str(n));
    return 0;
}
