// BG209 (docs/roadmap/bugs-roadmap.md): a brace written as an escape in
// the text of an f-string (`\x7B`, `\u{7d}`) is a brace of the text, not
// the start of an interpolation (it printed `brace 42 end`). lexer.fd
// read_fstring marks a decoded `\`, `{` or `}` with a `\` in the token,
// and parser.fd parse_fstring_parts reads it back as text.
//
// Expected output:
// {a}
// brace {a} end
// u {a} end
// 42 {42}
// bs \ 42 \42 \42
// {{}}
// 4
// {x:5} 7
fn main() -> i64 {
    val a: i64 = 42;
    println("\x7Ba\x7D");
    println(f"brace \x7Ba\x7D end");
    println(f"u \u{7b}a\u{7d} end");
    println(f"{a} \x7B{a}\x7D");
    println(f"bs \\ {a} \\{a} \x5C{a}");
    println(f"\x7B\x7B\x7D\x7D");
    val s: str = f"\x7B{a}\x7D";
    println(int_to_str(str_len(s)));
    val x: i64 = 7;
    println(f"\u{7B}x:5\u{7D} {x}");
    return 0;
}
