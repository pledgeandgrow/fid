// `self: & mut Vec<i64>` impl methods must mutate the receiver in place.
// Regression: the method-call lowering passed the loaded Vec word where
// the impl forwarder expects the receiver slot's address (`& mut v`),
// so `v.dedup()`/`v.sort_by(cmp)` resolved but silently did nothing.
use vec;

fn cmp_desc(a: i64, b: i64) -> i64 {
    return b - a;
}

fn main() -> i64 {
    var v = Vec::new();
    v.push(3); v.push(3); v.push(1); v.push(1); v.push(2);
    v.dedup();
    println("dedup.len = " + int_to_str(v.len()) + " (expect 3)");
    println("dedup.0 = " + int_to_str(v.get(0)) + " (expect 3)");
    println("dedup.2 = " + int_to_str(v.get(2)) + " (expect 2)");

    var s = Vec::new();
    s.push(3); s.push(1); s.push(2);
    s.sort_by(cmp_desc);
    println("sort.0 = " + int_to_str(s.get(0)) + " (expect 3)");
    println("sort.1 = " + int_to_str(s.get(1)) + " (expect 2)");
    println("sort.2 = " + int_to_str(s.get(2)) + " (expect 1)");

    // the free-function form takes `& mut v` explicitly and always worked
    var f = Vec::new();
    f.push(2); f.push(2); f.push(9);
    vec_dedup(& mut f);
    println("free.len = " + int_to_str(f.len()) + " (expect 2)");
    return 0;
}
