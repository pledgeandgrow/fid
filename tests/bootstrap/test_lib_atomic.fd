// atomic: memory orders (proposal 0003). Release/Acquire publication between
// threads, a Relaxed counter, swap and compare_swap.
use atomic;

fn main() -> i64 {
    val c: Atomic = atomic_new(5);
    if c.fetch_add(2, Order::Relaxed) != 5 { p_panic("fetch_add"); }
    if c.fetch_sub(1, Order::Relaxed) != 7 { p_panic("fetch_sub"); }
    if c.swap(10, Order::AcqRel) != 6 { p_panic("swap"); }
    if !c.compare_swap(10, 11, Order::SeqCst) { p_panic("cas"); }
    if c.compare_swap(10, 12, Order::SeqCst) { p_panic("cas stale"); }
    val data: Atomic = atomic_new(0);
    val ready: Atomic = atomic_new(0);
    data.store(42, Order::Relaxed);
    ready.store(1, Order::Release);
    memory_fence(Order::SeqCst);
    while ready.load(Order::Acquire) == 0 {}
    println(data.load(Order::Relaxed));
    println(c.load(Order::SeqCst));
    return 0;
}
