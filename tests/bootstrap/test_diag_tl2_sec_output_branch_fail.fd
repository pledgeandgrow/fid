// expect-error: 'show' produces output and is called inside a branch or loop that depends on sensitive data
// Expected to FAIL (TL2): whether anything is printed tells the sensitive
// value.
fn show(n: i64) {
    println(n);
}
fn f(@sensitive v: i64) {
    if v > 3 {
        show(1);
    }
}
fn main() {
    f(42);
}
