// BG252 (docs/roadmap/bugs-roadmap.md): an alias of a reference type is a
// reference: it can be dereferenced, its fields read, written through when
// it is `&mut`, and a reference passed to a parameter of that type (the
// type checker's `*r` and the escape check both resolve the alias).
//
// Expected output:
// 42
// 21
// 5
// 10
// 11
struct A { x: i64 }

type Ref = &A;
type MRef = &mut A;
type Ref2 = Ref;

fn both(r: Ref) -> i64 {
    return (*r).x + r.x;
}

fn read(r: Ref2) -> i64 {
    val a: A = *r;
    return a.x;
}

fn set(r: MRef) {
    *r = A { x: 5 };
}

fn twice(r: MRef) {
    (*r).x = (*r).x * 2;
}

fn add_one(r: MRef) {
    r.x = r.x + 1;
}

fn main() {
    var a = A { x: 21 };
    println(both(&a));
    println(read(&a));
    set(&mut a);
    println(a.x);
    twice(&mut a);
    println(a.x);
    add_one(&mut a);
    println(a.x);
}
