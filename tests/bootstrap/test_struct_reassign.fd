// Regression test: reassigning a struct-typed `var` must not corrupt the
// variable slot. The slot holds a *pointer* to the struct; assignment must
// store the new pointer, not memcpy the struct content into the slot.

struct Point { x: i64, y: i64 }

fn make_point(a: i64, b: i64) -> Point {
    return Point { x: a, y: b };
}

fn bump(p: Point) -> Point {
    return Point { x: p.x + 1, y: p.y + 1 };
}

fn main() {
    var p = make_point(1, 2);
    print(p.x);
    print(p.y);
    p = bump(p);
    print(p.x);
    print(p.y);
    p = bump(p);
    print(p.x);
    print(p.y);
}
