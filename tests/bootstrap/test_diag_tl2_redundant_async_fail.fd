//! error: Redundancy error: @redundant function 'pitch' is async. (line 8)
// TL2: a test per diagnostic of the type, borrow and escape checks.
// The voter needs both channels' results at once, so an async @redundant
// function is refused (`@ann async fn` parses as `async fn` does).

@redundant
async fn pitch(alpha: i64) -> i64 { // <- here
    return alpha * 100;
}

fn main() -> i64 {
    return 0;
}
