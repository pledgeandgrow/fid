// stdlib/wfc: simple tiled model (coast rules, fixed cells, validity, determinism), unsatisfiable periodic rules end in failure after backtracking, overlapping model from a sample (pattern extraction, symmetry, every output window is a sample pattern)
// Expected output:
// coast: done true, valid true, sea/coast/land/mountain all used: true
// coast: fixed corners kept: true
// coast: same seed same grid true, other seed differs true
// coast: contradicting fixed cells refused: true
// cycle rules on a 4-wide ring: failed true, backtracks > 0: true
// cycle rules on a 6-wide ring: done true, valid true
// overlapping: 8x8 sample, n=3: patterns found
// overlapping: symmetry 8 gives more patterns: true
// overlapping: done true, every 3x3 window of the 14x14 output is a sample pattern: true
use wfc;

fn yes(b: bool) -> str {
    if b { return "true"; }
    return "false";
}

fn coast() -> WfcModel {
    var m: WfcModel = wfc_tiled_new(4);
    wfc_tiled_allow_all(&mut m, 0, 0);
    wfc_tiled_allow_all(&mut m, 0, 1);
    wfc_tiled_allow_all(&mut m, 1, 1);
    wfc_tiled_allow_all(&mut m, 1, 2);
    wfc_tiled_allow_all(&mut m, 2, 2);
    wfc_tiled_allow_all(&mut m, 2, 3);
    wfc_tiled_allow_all(&mut m, 3, 3);
    wfc_tiled_weight(&mut m, 0, 3.0);
    wfc_tiled_weight(&mut m, 1, 1.0);
    wfc_tiled_weight(&mut m, 2, 3.0);
    wfc_tiled_weight(&mut m, 3, 1.0);
    return m;
}

fn grid_of(s: &WfcSolver) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var y: i64 = 0;
    while y < s.h {
        var x: i64 = 0;
        while x < s.w {
            out.push(wfc_cell(s, x, y));
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}

fn same(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    if a.len() != b.len() { return false; }
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != b.get(i) { return false; }
        i = i + 1;
    }
    return true;
}

fn cycle(w: i64) -> str {
    var m: WfcModel = wfc_tiled_new(3);
    var a: i64 = 0;
    while a < 3 {
        wfc_tiled_allow(&mut m, a, WFC_RIGHT, (a + 1) % 3);
        wfc_tiled_allow(&mut m, a, WFC_DOWN, a);
        a = a + 1;
    }
    var s: WfcSolver = wfc_solver_new(&m, w, 2, true, 3);
    val st: i64 = wfc_run(&mut s, &m);
    if st == WFC_FAILED {
        return "failed true, backtracks > 0: " + yes(s.backtracks > 0);
    }
    return "done " + yes(st == WFC_DONE) + ", valid " + yes(wfc_valid(&s, &m));
}

fn main() {
    val m: WfcModel = coast();
    var s: WfcSolver = wfc_solver_new(&m, 16, 16, false, 5);
    wfc_set(&mut s, &m, 0, 0, 0);
    wfc_set(&mut s, &m, 15, 15, 3);
    val st: i64 = wfc_run(&mut s, &m);
    val g: Vec<i64> = grid_of(&s);
    var used: Vec<bool> = Vec::filled(4, false);
    var i: i64 = 0;
    while i < g.len() {
        if g.get(i) >= 0 { used.set(g.get(i), true); }
        i = i + 1;
    }
    println("coast: done " + yes(st == WFC_DONE) + ", valid " + yes(wfc_valid(&s, &m)) + ", sea/coast/land/mountain all used: " + yes(used.get(0) && used.get(1) && used.get(2) && used.get(3)));
    println("coast: fixed corners kept: " + yes(wfc_cell(&s, 0, 0) == 0 && wfc_cell(&s, 15, 15) == 3));
    var s2: WfcSolver = wfc_solver_new(&m, 16, 16, false, 5);
    wfc_set(&mut s2, &m, 0, 0, 0);
    wfc_set(&mut s2, &m, 15, 15, 3);
    wfc_run(&mut s2, &m);
    var s3: WfcSolver = wfc_solver_new(&m, 16, 16, false, 6);
    wfc_set(&mut s3, &m, 0, 0, 0);
    wfc_set(&mut s3, &m, 15, 15, 3);
    wfc_run(&mut s3, &m);
    println("coast: same seed same grid " + yes(same(&g, &grid_of(&s2))) + ", other seed differs " + yes(!same(&g, &grid_of(&s3))));
    var s4: WfcSolver = wfc_solver_new(&m, 8, 8, false, 1);
    wfc_set(&mut s4, &m, 0, 0, 0);
    println("coast: contradicting fixed cells refused: " + yes(!wfc_set(&mut s4, &m, 1, 0, 3) && s4.status == WFC_FAILED));

    println("cycle rules on a 4-wide ring: " + cycle(4));
    println("cycle rules on a 6-wide ring: " + cycle(6));

    // overlapping: a periodic 8x8 brick sample
    val rows: Vec<str> = str_split("11111111,10001000,10001000,11111111,00100010,00100010,11111111,10001000", ",");
    var sample: Vec<i64> = Vec::new();
    i = 0;
    while i < rows.len() {
        var j: i64 = 0;
        while j < 8 {
            sample.push(str_byte_at(rows.get(i), j) - 48);
            j = j + 1;
        }
        i = i + 1;
    }
    val p: WfcPatterns = wfc_overlapping(&sample, 8, 8, 3, true, 1);
    println("overlapping: 8x8 sample, n=3: " + if p.model.t > 1 { "patterns found" } else { "no patterns" });
    val p8: WfcPatterns = wfc_overlapping(&sample, 8, 8, 3, true, 8);
    println("overlapping: symmetry 8 gives more patterns: " + yes(p8.model.t > p.model.t));
    var so: WfcSolver = wfc_solver_new(&p.model, 12, 12, false, 21);
    val sto: i64 = wfc_run(&mut so, &p.model);
    val img: Vec<i64> = wfc_overlapping_image(&so, &p);
    println("overlapping: done " + yes(sto == WFC_DONE) + ", every 3x3 window of the 14x14 output is a sample pattern: " + yes(wfc_image_windows_ok(&img, 14, 14, &p)));
}
