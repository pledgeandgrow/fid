// A native build imports from any DLL named by `link`, with no C compiler.
extern "C" link "shlwapi" {
    fn PathFileExistsA as path_exists(path: str) -> i32;
}

extern "C" link "bcrypt" {
    fn BCryptGenRandom as gen_random(alg: i64, buf: i64, len: i64, flags: i64) -> i32;
}

@unsafe
fn main() -> i64 {
    println(path_exists("stdlib/core.fd"));
    println(path_exists("no/such/file"));
    var buf: i64 = p_malloc(8);
    // BCRYPT_USE_SYSTEM_PREFERRED_RNG
    println(gen_random(0, buf, 8, 2));
    var p: *mut i64 = buf;
    println(*p != 0);
    p_free(buf);
    return 0;
}
