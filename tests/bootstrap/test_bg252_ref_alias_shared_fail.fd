// expect-error: through a shared reference
//! error: through a shared reference
// BG252 (docs/roadmap/bugs-roadmap.md): an alias of `&A` is a shared
// reference as `&A` is: a field cannot be changed through it (before, the
// alias was not resolved and the write was accepted).
struct A { x: i64 }

type Ref = &A;

fn bump(r: Ref) {
    r.x = r.x + 1;
}

fn main() {
    var a = A { x: 1 };
    bump(&a);
    println(a.x);
}
