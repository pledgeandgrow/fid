// expect-error: while a `for` loop iterates over it
// Test: changing a Vec while a `for` loop walks it (release K4). The push
// can move the buffer the loop reads from.

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    for x in v {
        v.push(x * 10);
    }
    println(v.len());
}
