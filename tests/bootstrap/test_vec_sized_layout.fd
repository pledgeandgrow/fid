// Release D14 (fid only: the frozen fidesc keeps one word per element and
// shares Vec handles): the element code of a Vec, set from its declared
// type, and copy-on-write on a Vec stored at its size.
//
// Expected output:
// codes 1 -1 2 -2 4 -4 1 0 0
// shared: 10 20 / 10 99
// grown 1000 999
// file 4 bytes: 1 2 254 255

fn main() -> i64 {
    var a: Vec<u8> = Vec::new();
    var b: Vec<i8> = Vec::new();
    var c: Vec<u16> = Vec::new();
    var d: Vec<i16> = Vec::new();
    var e: Vec<u32> = Vec::new();
    var f: Vec<i32> = Vec::new();
    var g: Vec<bool> = Vec::new();
    var h: Vec<i64> = Vec::new();
    var k: Vec<str> = Vec::new();
    println("codes " + int_to_str(vec_code(a)) + " " + int_to_str(vec_code(b)) + " " + int_to_str(vec_code(c))
        + " " + int_to_str(vec_code(d)) + " " + int_to_str(vec_code(e)) + " " + int_to_str(vec_code(f))
        + " " + int_to_str(vec_code(g)) + " " + int_to_str(vec_code(h)) + " " + int_to_str(vec_code(k)));

    var s: Vec<u8> = Vec::new();
    s.push(10);
    s.push(20);
    var t = s;
    t.set(1, 99);
    println("shared: " + int_to_str(s.get(0) as i64) + " " + int_to_str(s.get(1) as i64) + " / " + int_to_str(t.get(0) as i64) + " " + int_to_str(t.get(1) as i64));

    var n: Vec<i16> = Vec::new();
    var i: i64 = 0;
    while i < 1000 {
        n.push((i % 1000) as i16);
        i = i + 1;
    }
    println("grown " + int_to_str(n.len()) + " " + int_to_str(n.get(999) as i64));

    var bytes: Vec<u8> = Vec::new();
    bytes.push(1);
    bytes.push(2);
    bytes.push(254);
    bytes.push(255);
    var path: str = "_test_vec_sized_layout.tmp";
    p_file_write_vec(path, bytes);
    var back: str = p_str_take(p_file_read(path));
    println("file " + int_to_str(str_len(back)) + " bytes: " + int_to_str(str_byte_at(back, 0)) + " " + int_to_str(str_byte_at(back, 1))
        + " " + int_to_str(str_byte_at(back, 2)) + " " + int_to_str(str_byte_at(back, 3)));
    p_file_delete(path);
    return 0;
}
