// expect-error: to an element of 'v', whose elements are str
// Bugs roadmap BG1: the value of `v[i] = x` was not checked against the
// element type: `v[0] = 42` with v: Vec<str> stored a number where the Vec
// keeps the owner of a string (dropping it later frees address 42). The
// value must fit the element type, as `val s: str = 42` must.

fn main() -> i64 {
    var v: Vec<str> = Vec::new();
    v.push("a" + "b");
    v[0] = 42;
    println(v[0]);
    return 0;
}
