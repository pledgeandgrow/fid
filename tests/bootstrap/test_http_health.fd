// http: the built-in /health endpoint answers itself (CO8); other paths go
// to the user's handler (the default one returns 404).
use http;

fn req(path: str) -> HttpRequest {
    return http_parse_head("GET " + path + " HTTP/1.1\r\n\r\n");
}

fn main() -> i64 {
    http_state_init();
    var resp: str = http_health_handler(req("/health"));
    println(str_find(resp, "200 OK") >= 0);
    println(str_find(resp, "status") >= 0);

    var other: str = http_health_handler(req("/x"));
    println(str_find(other, "404") >= 0);
    println("health OK");
    return 0;
}
