// stdlib/regex runs in time linear in the input (competitive SL7): a Pike
// VM, no backtracking. A pattern that takes a backtracking engine 2^n
// steps, (a?){n}a{n} on n a's, matches at once; alternation works inside
// groups; leftmost match, first alternative at that start, longest within.
//
// Expected output:
// 1 t
// 2 t
// 3 t
// 4 f
// 5 t
// 6 t
// 7 3 9
// 8 x-y-z
// 9 k=v|a=b||
// 10 t
// 11 0 1
// 12 t
// 13 f
// 14 3 6
use regex;
use vec;

fn bs(b: bool) -> str {
    if b { return "t"; }
    return "f";
}

fn main() -> i64 {
    // (a?){24}a{24} on 24 a's: 2^24 paths for a backtracking engine
    var s: str = "";
    var i: i64 = 0;
    while i < 24 { s = s + "a"; i = i + 1; }
    println("1 " + bs(regex_match(s, "(a?){24}a{24}")));
    // nested stars, a classic blow-up for backtracking: (a*)*b on a's
    println("2 " + bs(!regex_search(s, "(a*)*b")));
    // alternation inside a group
    println("3 " + bs(regex_match("gray", "gr(a|e)y")));
    println("4 " + bs(regex_match("groy", "gr(a|e)y")));
    println("5 " + bs(regex_match("abcd", "(a|ab)(c|bcd)")));
    println("6 " + bs(regex_match("2026-11-07", "\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])")));
    var sp: Vec<i64> = regex_find_span("xx=foobar;", "(foo|f)(bar|o)*");
    println("7 " + int_to_str(sp.get(0)) + " " + int_to_str(sp.get(1)));
    println("8 " + regex_replace("x  y\t z", "\\s+", "-"));
    var parts: Vec<str> = regex_split("k=v;a=b;", ";");
    var out: str = "";
    i = 0;
    while i < parts.len() {
        var x: str = parts.get(i);
        out = out + x + "|";
        i = i + 1;
    }
    println("9 " + out);
    // ^ and $ inside alternatives
    println("10 " + bs(regex_search("end", "^start|end$")));
    // the first alternative that matches at the leftmost start wins
    var sp2: Vec<i64> = regex_find_span("ab", "a|ab");
    println("11 " + int_to_str(sp2.get(0)) + " " + int_to_str(sp2.get(1)));
    // a long subject: linear time
    var big: str = "";
    i = 0;
    while i < 200 { big = big + "ab"; i = i + 1; }
    println("12 " + bs(regex_match(big + "c", "(ab|ba)*c")));
    println("13 " + bs(regex_match(big + "x", "(a|b)*c")));
    var sp3: Vec<i64> = regex_find_span("abcxyz", "x(y|yz)*");
    println("14 " + int_to_str(sp3.get(0)) + " " + int_to_str(sp3.get(1)));
    return 0;
}
