// Bugs roadmap BG338: `p_str_to_int` wrapped on overflow on the machine
// layer (`emit --nat`, Linux targets), where run, C (atoll) and pe_ir
// (_strtoi64) saturate to i64::MAX / i64::MIN. The machine layer's
// pert_str_to_int (stdlib/linux_runtime/base.fd) now saturates too.
//
// Expected output:
// 9223372036854775807 -9223372036854775808 9223372036854775807
// 9223372036854775807 -9223372036854775808 -42 0

fn main() {
    println(f"{p_str_to_int("9223372036854775808")} {p_str_to_int("-9223372036854775809")} {p_str_to_int("99999999999999999999")}");
    println(f"{p_str_to_int("9223372036854775807")} {p_str_to_int("-9223372036854775808")} {p_str_to_int("  -42x")} {p_str_to_int("x")}");
}
