// expect-error: in 'mk', 'mk' returns a reference to local 'x', which is freed when it
// Expected to FAIL: the returned closure captures r, a reference to the local x.
fn mk() -> fn() -> i64 {
    var x: i64 = 1;
    val r: &i64 = &x;
    return fn() { *r };
}
fn main() {
    val f = mk();
    println(f());
}
