// What p_free must keep accepting: null, a block reused after a free, a large
// block and an empty one.
@unsafe
fn main() -> i64 {
    p_free(0);
    var i: i64 = 0;
    while i < 1000 {
        var p: i64 = p_malloc(64);
        p_free(p);
        i = i + 1;
    }
    var big: i64 = p_malloc(2097152);
    p_free(big);
    var empty: i64 = p_malloc(0);
    p_free(empty);
    print("ok\n");
    return 0;
}
