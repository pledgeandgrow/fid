// BG29 (docs/roadmap/bugs-roadmap.md): the move on a last use did not see a
// match guard. `v.push(s)` looked like the last use of `s`, so `s` was
// moved into `v`, and `v.set` freed it, while the guard after them still
// read `s`. A guard counts as a use now: `s` is copied into `v`. Every
// backend prints the same.
//
// Expected output:
// guard saw ab
// 1
fn pick(n: i64) -> i64 {
    var v: Vec<str> = Vec::new();
    val s: str = "a" + "b";
    v.push(s);
    v.set(0, "other");
    match n {
        1 if s == "ab" => {
            println("guard saw ab");
        }
        _ => {
            println("no guard");
        }
    }
    return v.len();
}

fn main() -> i64 {
    println(int_to_str(pick(1)));
    return 0;
}
