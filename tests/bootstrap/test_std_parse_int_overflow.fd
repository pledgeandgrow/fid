// Bugs roadmap BG175: core String_parse_int (str_parse_int) built the
// positive magnitude with checked arithmetic and no digit limit, so
// "-9223372036854775808" and any value past i64 panicked ("Integer overflow
// on multiplication"), where its doc says it returns 0 on failure. It now
// builds the value negative, where i64::MIN fits, and returns 0 for a value
// outside i64. What it accepts is unchanged: white space, a sign, then
// digits up to the first other byte.
//
// Expected output:
// 9223372036854775807
// -9223372036854775808
// 0
// 0
// 0
// 0
// 5
// -7
// 42
// 12
// 0
// 0
// 0
// true

fn main() {
    println(int_to_str(str_parse_int("9223372036854775807")));
    println(int_to_str(str_parse_int("-9223372036854775808")));
    println(int_to_str(str_parse_int("9223372036854775808")));
    println(int_to_str(str_parse_int("-9223372036854775809")));
    println(int_to_str(str_parse_int("18446744073709551626")));
    println(int_to_str(str_parse_int("99999999999999999999999999999999999999")));
    println(int_to_str(str_parse_int("5abc")));
    println(int_to_str(str_parse_int("-7")));
    println(int_to_str(str_parse_int("  +42")));
    println(int_to_str(str_parse_int("0000000000000000000000000000012")));
    println(int_to_str(str_parse_int("")));
    println(int_to_str(str_parse_int("-")));
    println(int_to_str(str_parse_int("abc")));
    println(str_parse_int("-9223372036854775808") == -9223372036854775807 - 1);
}
