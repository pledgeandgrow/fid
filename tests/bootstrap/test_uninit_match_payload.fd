// Test (known-bugs 2g.2): a variable declared without a value and set
// from a match payload owns what it is given; it was freed twice (once
// as `m`, once inside `r`), which crashed `fid veil` and the LSP.
//
// Expected output:
// 2 m
struct M { v: Vec<i64>, name: str }
enum ResM { Ok(M), Err(str) }

fn make(ok: bool) -> ResM {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    if ok { return ResM::Ok(M { v: v, name: "m" }); }
    return ResM::Err("bad");
}

fn main() -> i64 {
    var r: ResM = make(true);
    var m: M;
    match r {
        ResM::Ok(mm) => { m = mm; }
        ResM::Err(e) => { println(e); return 1; }
    }
    println(int_to_str(m.v.len()) + " " + m.name);
    return 0;
}
