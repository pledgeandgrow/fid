// expect-error: p_mem_copy() needs an `unsafe` block
// Bugs roadmap BG10: core's p_mem_copy copies n bytes between two
// addresses its caller passes as integers, as p_memcpy does, but only the
// builtins needed `unsafe`: this program copied 64 bytes from address 8192
// to address 4096 in safe code. Core's raw-memory functions (p_mem_copy,
// p_copy_words, p_zero_words, p_str_copy_n, p_str_free, p_str_append,
// p_str_adopt) need an `unsafe` block now (test_core_raw_memory_unsafe.fd).

fn main() -> i64 {
    p_mem_copy(4096, 8192, 64);
    println("copied");
    return 0;
}
