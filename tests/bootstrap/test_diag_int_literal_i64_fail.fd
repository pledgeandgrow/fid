// expect-error: expects a str socket path, got 'i64'
// 2g.87: a message names an unsuffixed integer literal as an i64, the
// language's type for it, not as the narrowest type the checker gives it
// inside (`5` was named 'i8').

fn main() -> i64 {
    val fd: i64 = p_unix_connect(5);
    println(int_to_str(fd));
    return 0;
}
