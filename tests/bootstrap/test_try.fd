// Test ? operator with Result-like enum
enum Result {
    Ok(i64),
    Err(i64),
}

fn ok_value() -> Result {
    return Result::Ok(42);
}

// `?` returns from the enclosing function, so that function returns the
// enum (known-bugs 2g.55: main returning i32 rejects `?`,
// test_try_ret_i64_fail.fd).
fn take() -> Result {
    val r = ok_value();
    val v = r?;
    print(v);
    return Result::Ok(v);
}

fn main() -> i32 {
    match take() {
        Result::Ok(_) => {
        }
        Result::Err(_) => {
            print(-1);
        }
    }
    return 0;
}
