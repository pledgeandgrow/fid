// expect-error: cannot index type HashMap<str, i64>
// Bugs roadmap BG112: `m["a"]` on a HashMap gave the type `never` with no
// error (the write side, BG1, rejects it), and the lowering loaded a word
// from the map's address plus the index.
fn main() -> i64 {
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("a", 1);
    val x: i64 = m["a"];
    println(int_to_str(x));
    return 0;
}
