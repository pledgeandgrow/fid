// Bugs roadmap BG350: stdlib/mime.fd mime_param split the parameter list
// at every ';' before looking at quotes, so a quoted-string value holding
// ';' came back half-quoted (`"a`), the rest of it could be read as another
// parameter, and backslash escapes were not decoded. RFC 9110 §5.6.4: a
// quoted-string may hold ';', and `\x` stands for x.
//
// Expected output:
// [a;b.txt]
// [utf-8]
// [a"b]
// [x; name=evil]
// []
// [utf-8]
// [plain]
// []

use mime;

fn main() {
    println("[" + mime_param("text/plain; charset=\"utf-8\"; name=\"a;b.txt\"", "name") + "]");
    println("[" + mime_param("text/plain; charset=\"utf-8\"; name=\"a;b.txt\"", "charset") + "]");
    println("[" + mime_param("text/plain; name=\"a\\\"b\"", "name") + "]");
    println("[" + mime_param("text/plain; a=\"x; name=evil\"", "a") + "]");
    println("[" + mime_param("text/plain; a=\"x; name=evil\"", "name") + "]");
    println("[" + mime_param("text/c; CharSet = utf-8 ", "charset") + "]");
    println("[" + mime_param("text/c; flag; kind=plain", "kind") + "]");
    println("[" + mime_param("text/c", "kind") + "]");
}
