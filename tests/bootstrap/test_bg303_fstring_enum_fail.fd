// expect-error: an f-string cannot show a value of enum type 'Color'
// BG303 (docs/roadmap/bugs-roadmap.md, reference §1.8): an enum part of an
// f-string has no text form; it printed an empty string.
enum Color {
    Red,
    Green,
}

fn main() {
    val c: Color = Color::Green;
    println(f"c {c}");
}
