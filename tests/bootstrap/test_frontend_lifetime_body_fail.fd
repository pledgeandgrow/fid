// expect-error: returns a borrow of parameter 'y', but its signature ties the result to 'a
// LG3: the signature says the result borrows from `x` ('a); returning a
// borrow of `y` breaks it (a caller relying on it could outlive `y`).
fn first<'a>(x: &'a i64, y: &i64) -> &'a i64 {
    return y;
}

fn main() -> i64 {
    var a: i64 = 1;
    var b: i64 = 2;
    val r = first(&a, &b);
    println(*r);
    return 0;
}
