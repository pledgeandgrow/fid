// Every p_vec_* builtin, on a Vec from p_vec_new and on one from Vec::new:
// the same answers on every backend (one Vec implementation).
fn show(v: Vec<i64>) {
    var s: str = "[";
    var i: i64 = 0;
    while i < p_vec_len(v) {
        if i > 0 { s = s + " "; }
        s = s + int_to_str(p_vec_get(v, i));
        i = i + 1;
    }
    println(s + "] len " + int_to_str(p_vec_len(v)));
}

fn exercise(v: &mut Vec<i64>) {
    println(p_vec_is_empty(v));
    p_vec_push(v, 5);
    p_vec_push(v, 3);
    p_vec_push(v, 9);
    p_vec_push(v, 1);
    show(v);
    println(p_vec_is_empty(v));
    println(p_vec_capacity(v) >= p_vec_len(v));
    p_vec_set(v, 1, 30);
    println(p_vec_first(v));
    println(p_vec_last(v));
    println(p_vec_contains(v, 30));
    println(p_vec_contains(v, 4));
    p_vec_insert(v, 0, 7);
    show(v);
    println(p_vec_remove(v, 2));
    show(v);
    p_vec_reverse(v);
    show(v);
    var w: Vec<i64> = p_vec_new();
    p_vec_push(w, 100);
    p_vec_push(w, 200);
    p_vec_extend(v, w);
    show(v);
    p_vec_sort(v);
    show(v);
    var c: Vec<i64> = p_vec_clone(v);
    p_vec_set(c, 0, -1);
    show(v);
    show(c);
    p_vec_truncate(v, 2);
    show(v);
    println(p_vec_pop(v));
    show(v);
    p_vec_clear(v);
    show(v);
    var g: i64 = 0;
    while g < 100 { p_vec_push(v, g * g); g = g + 1; }
    println(p_vec_get(v, 99));
    println(p_vec_len(v));
}

fn main() -> i64 {
    var a: Vec<i64> = p_vec_new();
    exercise(&mut a);
    var b: Vec<i64> = Vec::new();
    exercise(&mut b);
    return 0;
}
