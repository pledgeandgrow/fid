// expect-error: returns a reference to local 'x'
// LG3: a struct holding a reference to a local cannot be returned.
struct View<'a> {
    r: &'a i64,
    k: i64,
}

fn mk() -> View {
    var x: i64 = 1;
    return View { r: &x, k: 0 };
}

fn main() -> i64 {
    val v = mk();
    println(v.k);
    return 0;
}
