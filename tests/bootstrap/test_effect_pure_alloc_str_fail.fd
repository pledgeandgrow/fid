// expect-error: Effect error: function 'greet' has inferred effect '!Alloc'
// Expected to FAIL (known-bugs 2g.65): string `+` builds a new string, so a
// `!{}` function may not use it (it inferred no Alloc).
fn greet(name: str) -> str !{} {
    return "hello, " + name;
}

fn main() {
    println(greet("effects"));
}
