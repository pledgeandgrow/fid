// expect-error: cannot create &mut v.[1]: a mutable borrow is already reserved on it or a related path
// Expected to FAIL (known-bugs 2g.73): two `&mut` borrows of the same
// element of a Vec in one call alias.
fn swap(a: &mut i64, b: &mut i64) {
    var t: i64 = *a;
    *a = *b;
    *b = t;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    swap(&mut v[1], &mut v[1]);
    println(int_to_str(v[1]));
}
