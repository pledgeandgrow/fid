// expect-error: cannot mutate a: shared borrow(s) are active
// LG3: a borrow passed on. `q` borrows `a`; `r = only(q)` borrows what `q`
// borrows, so changing `a` while `r` is still used is an error even after
// `q`'s last use.
fn only(p: &i64) -> &i64 {
    return p;
}

fn main() -> i64 {
    var a: i64 = 1;
    val q = &a;
    val r = only(q);
    a = 2;
    println(*r);
    return 0;
}
