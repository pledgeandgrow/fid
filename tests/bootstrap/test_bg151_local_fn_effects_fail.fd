// expect-error: has inferred effect '!IO'
// Bugs roadmap BG151: a call through a local function value took no
// effects, so a `!{}` function could print through `val f = noisy; f()`.
// The call now takes the effects of what the local is bound to.
fn noisy() -> i64 {
    println("io");
    return 1;
}

fn pure_fn() -> i64 !{} {
    val f = noisy;
    return f();
}

fn main() -> i64 {
    println(pure_fn());
    return 0;
}
