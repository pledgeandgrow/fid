// Test SQLite FFI bindings
// Expected: PASS (C codegen only — requires libsqlite3)
// Interpreter: SKIP (no real SQLite in interpreter)
//
// Tests the SQLite FFI module by creating an in-memory database,
// creating a table, inserting rows, and querying them back.
//
// Requirements: libsqlite3-dev installed (or libsqlite3.so.0 + symlink)

use sqlite;

fn main() -> i64 {
    // Open an in-memory SQLite database
    var db = SQLite::open_memory();

    // Create a table
    db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)");

    // Insert some rows
    db.exec("INSERT INTO users (name, age) VALUES ('Alice', 30)");
    db.exec("INSERT INTO users (name, age) VALUES ('Bob', 25)");
    db.exec("INSERT INTO users (name, age) VALUES ('Charlie', 35)");

    // Query all rows
    val rows = db.query("SELECT * FROM users ORDER BY id");
    print(rows);
    print("\n");

    // Query a specific row
    val alice = db.query("SELECT * FROM users WHERE name = 'Alice'");
    print(alice);
    print("\n");

    // Check rows affected by an UPDATE
    val affected = db.exec("UPDATE users SET age = 31 WHERE name = 'Alice'");
    print("Rows affected: ");
    print(p_to_str(affected));
    print("\n");

    // Verify the update
    val updated = db.query("SELECT age FROM users WHERE name = 'Alice'");
    print(updated);
    print("\n");

    // Close the connection
    db.close();

    return 0;
}
