// L3D: Channels and select
// Channel<T> — typed, bounded channels (like Go)
// select { case ch1 => x => ..., default => ... } — multiplexed channel operations
// Channel close semantics

fn main() {
    val ch = p_chan_create(10);

    // Send and receive
    p_chan_send(ch, 42);
    val v1 = p_chan_recv(ch);
    println(v1);

    // Close semantics
    p_chan_send(ch, 100);
    p_chan_close(ch);
    val v2 = p_chan_recv(ch);
    println(v2);
    // After close, recv returns sentinel
    val v3 = p_chan_recv(ch);
    println(v3);

    // Select with try_recv
    val ch2 = p_chan_create(1);
    p_chan_send(ch2, 7);
    select {
        case ch2 => x => {
            println(x);
        }
        default => {
            println(0);
        }
    }
}
