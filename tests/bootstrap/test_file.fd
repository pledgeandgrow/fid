use file;

fn main() -> i64 {
    // Write a file
    val rc = file_write("/tmp/fides_test_file.txt", "Hello, Fides!\n");
    if rc != 0 {
        print("FAIL: write failed\n");
        return 1;
    }
    print("Write OK\n");

    // Check it exists
    if !file_exists("/tmp/fides_test_file.txt") {
        print("FAIL: file doesn't exist\n");
        return 1;
    }
    print("Exists OK\n");

    // Read it back
    val content = file_read("/tmp/fides_test_file.txt");
    print("Content: ");
    print(content);
    print("\n");

    // Append
    val rc2 = file_append("/tmp/fides_test_file.txt", "Appended line.\n");
    if rc2 != 0 {
        print("FAIL: append failed\n");
        return 1;
    }
    print("Append OK\n");

    // Read again
    val content2 = file_read("/tmp/fides_test_file.txt");
    print("Content after append: ");
    print(content2);
    print("\n");

    return 0;
}
