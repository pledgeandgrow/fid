// expect-error: cannot assign str to global 'G' of type i64
// Bugs roadmap BG262: a global's initializer is type-checked against the
// declared type (reference §2.7); before, `var G: i64 = "str"` printed the
// string's address.
var G: i64 = "str";

fn main() -> i64 {
    println(G);
    return 0;
}
