// expect-error: 'self' is a by-value receiver of 'byval' and cannot be changed
// Bugs roadmap BG397: an `&mut self` method called on a by-value `self`
// changed the caller's struct (q.x became 11).
struct Q { x: i64 }
impl Q {
    fn inc(self: &mut Q) {
        self.x = self.x + 10;
    }
    fn byval(self: Q) -> i64 {
        self.inc();
        return self.x;
    }
}
fn main() {
    var q = Q { x: 1 };
    println(q.byval());
    println(q.x);
}
