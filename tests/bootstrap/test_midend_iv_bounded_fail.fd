// OP10 (compiler/checks.fd iro_iv_bounded): expected to fail at run time
// (integer overflow in the multiply), after printing 0 to 4. The
// factor 2^61 is beyond what the bound check accepts (2^20), so the
// multiply is not strength-reduced outside @wrapping code: it overflows
// at i = 4, where the plain loop does, not one iteration early in a
// stepped shadow.

fn main() {
    var big: i64 = 2305843009213693952;
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 10 {
        println(i);
        t = i * 2305843009213693952;
        i = i + 1;
    }
    println(t + big);
}
