// L8H: a specialization in another module than its generic definition.
// The program imports spec_lib::wrap_lib, whose `describe<T>`, `impl<T>
// Wrap<T> { kind }` and `impl<T> Show for Wrap<T>` are generic, and gives
// narrower definitions of its own: `fn describe(x: i64)`, `impl Wrap<i64>
// { kind }`, `impl Show for Wrap<str>`. Each call runs the most specific
// definition for its types, also a call made inside the library
// (`describe_twice`). Before, the program's `describe` was a second
// definition (shadowing the library's for the program's own calls only)
// and its impls replaced the library's impls of Wrap.
//
// Expected output:
// i64 5
// any
// i64 3 / i64 3
// any / any
// kind i64
// kind any
// str hi
// any
use spec_lib::wrap_lib;

fn describe(x: i64) -> str {
    return "i64 " + int_to_str(x);
}

impl Wrap<i64> {
    pub fn kind(self) -> str {
        return "kind i64";
    }
}

impl Show for Wrap<str> {
    fn show(self) -> str {
        return "str " + self.v;
    }
}

fn main() -> i64 {
    println(describe(5));
    println(describe(true));
    println(describe_twice(3));
    println(describe_twice("s"));
    val a: Wrap<i64> = Wrap { v: 9 };
    println(a.kind());
    val c: Wrap<bool> = Wrap { v: true };
    println(c.kind());
    val s: Wrap<str> = Wrap { v: "hi" };
    println(s.show());
    println(c.show());
    return 0;
}
