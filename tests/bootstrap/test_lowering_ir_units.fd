// B1 (inc-roadmap): FID_IR_UNITS=1 cuts the lowered program into one
// IrModule per source module (this file, core, `math`), checks the link
// table (every import defined by one unit, one layout table) and links the
// units back in the original order (lower.fd ir_units_split /
// ir_units_check / ir_units_link), on every command that lowers through
// compiler.fd lower_to_ir_module_with_path. The program's output is the
// same as without the switch; the split's summary goes to stderr.
//@ env: FID_IR_UNITS=1
//
// Expected output:
// 12
// 3
// 7
use math;

struct Pair { a: i64, b: i64 }

fn sum(p: Pair) -> i64 {
    return p.a + p.b;
}

fn main() {
    val p = Pair { a: 5, b: 7 };
    println(sum(p));
    println(math_abs_i64(0 - 3));
    var v: Vec<i64> = Vec::new();
    v.push(3);
    v.push(4);
    println(v.get(0) + v.get(1));
}
