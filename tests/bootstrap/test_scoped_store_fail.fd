// expect-error: cannot be stored in a Vec
// A @scoped struct cannot be kept: not in a collection, a field, a global or
// a result (release M11).

@scoped
struct Msg {
    text: str,
}

fn main() {
    val m: Msg = Msg { text: "a" };
    var all: Vec<Msg> = Vec::new();
    all.push(m);
    println(all.len());
}
