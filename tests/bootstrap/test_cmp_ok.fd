// Bugs roadmap BG60: comparisons are checked now; these stay accepted:
// numbers of different widths, a bool with a bool, a str with a str, an
// enum with one of its variants, and `a < b && b < c` for a range test
// (`1 < x && x < 10`: the left operand of `x < 10` is no comparison).
// Expected output:
// 1
// 2
// 3
// 4
enum Light {
    Red,
    Green,
}

fn main() -> i64 {
    val small: u8 = 3;
    val big: i64 = 3;
    if small == big {
        println("1");
    }
    val ok: bool = true;
    if ok == (big > 2) {
        println("2");
    }
    val s: str = "a";
    if s == "a" {
        println("3");
    }
    val l: Light = Light::Green;
    val x: i64 = 5;
    if l == Light::Green && 1 < x && x < 10 {
        println("4");
    }
    return 0;
}
