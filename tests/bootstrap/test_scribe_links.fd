// TL11: scribe (fid doc) links type names to their sections, items to
// their source lines, and shows doc examples with the doctest.py note.
// Expected output:
// pub fn f(p: <a class="ty" href="geo.html#Point">Point</a>, s: str = &quot;Point&quot;) -&gt; <a class="ty" href="#Local">Local</a> { // Point
// Lower: Pointy i64 point
// <p class="location">Defined at <a class="src" href="src/m.html#L12">lib/m.fd:12</a></p>
// <p class="location">Defined at line 7</p>
// marker 0 1 -1 -1
// <p class="example-note">Example -- run as a test by <code>scripts/doctest.py</code></p>
// <pre class="example"><code>val x: i64 = 1;
// if x == 1 {
//     print(&quot;one&quot;);
// }</code></pre>
// After.
// 2.3.1 geo
// params 2 a Point i64
// span <span id="L2"><a class="ln" href="#L2">2</a>fn b() -&gt; i64 {</span>
use core;
use compiler::scribe;

fn main() -> i64 {
    var ctx: DocCtx = DocCtx_new();
    var geo: Vec<DocItem> = Vec::new();
    geo.push(DocItem_new("struct", "Point", "pub struct Point {", "", 1, true));
    // a private struct is not linked
    geo.push(DocItem_new("struct", "Pointy", "struct Pointy {", "", 2, false));
    scribe_register_types(& mut ctx, geo, "geo");
    var mine: Vec<DocItem> = Vec::new();
    mine.push(DocItem_new("enum", "Local", "pub enum Local {", "", 3, true));
    scribe_register_types(& mut ctx, mine, "m");
    ctx.page = "m";
    // a type of another page, of this page, a string and a comment
    println(scribe_link_types("pub fn f(p: Point, s: str = \"Point\") -> Local { // Point", ctx, "f"));
    println("Lower: " + scribe_link_types("Pointy i64 point", ctx, ""));
    ctx.src_href = "src/m.html";
    ctx.src_label = "lib/m.fd";
    println(str_trim_end(scribe_location_html(12, ctx)));
    println(str_trim_end(scribe_location_html(7, DocCtx_new())));
    println("marker " + int_to_str(scribe_example_marker("Example:")) + " " + int_to_str(scribe_example_marker("Example (native only):")) + " " + int_to_str(scribe_example_marker("Examples:")) + " " + int_to_str(scribe_example_marker("Example of x")));
    // a doc comment as extract_docs keeps it: example lines indented
    var src: str = "/// Example:\n///   val x: i64 = 1;\n///   if x == 1 {\n///       print(\"one\");\n///   }\n/// After.\npub fn g() -> i64 {\n    return 1;\n}\n";
    var items: Vec<DocItem> = extract_docs(src);
    println(scribe_doc_html(items.get(0).doc));
    println(scribe_toml_value("[package]\nname = \"geo\"\nversion = \"2.3.1\"\n[dependencies]\nversion = \"9\"\n", "version") + " " + scribe_toml_value("[package]\nname = \"geo\"\n", "name"));
    var fns: Vec<DocItem> = extract_docs("pub fn h(a: Point, b: i64) -> i64 {\n    return b;\n}\n");
    var ps: Vec<StringPair> = fns.get(0).params;
    println("params " + int_to_str(ps.len()) + " " + ps.get(0).a + " " + ps.get(0).b + " " + ps.get(1).b);
    var page: str = scribe_source_page("fn a() {\nfn b() -> i64 {\n}\n", "x.fd", "x");
    var at: i64 = str_find(page, "<span id=\"L2\">");
    var rest: str = str_slice(page, at, str_len(page));
    println("span " + str_slice(rest, 0, str_find(rest, "\n")));
    return 0;
}
