// expect-error: the arms of this `match` have different types
// Bugs roadmap BG19: a `match` used as a value took the first arm's type;
// an arm giving a bool where the first gives a string was not noticed.
fn label(k: i64) -> str {
    val s: str = match k {
        1 => { "one" }
        _ => { false }
    };
    return s;
}

fn main() -> i64 {
    println(label(1));
    return 0;
}
