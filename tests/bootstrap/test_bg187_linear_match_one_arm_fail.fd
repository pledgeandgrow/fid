// expect-error: is consumed in some branches of this `match`
// Bugs roadmap BG187: match arms were not joined; consuming a linear
// value in one arm only (lost on the other path) was accepted.
@linear
struct Tok {
    v: i64,
}

fn use_tok(t: Tok) -> i64 {
    return t.v;
}

fn main() -> i64 {
    val t = Tok { v: 1 };
    val k: i64 = 3;
    match k {
        1 => {
            println(use_tok(t));
        }
        _ => {
            println(0);
        }
    }
    return 0;
}
