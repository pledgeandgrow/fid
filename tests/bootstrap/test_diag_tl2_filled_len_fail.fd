// expect-error: Vec::filled takes a length (an integer) first, got str
//! error: Vec::filled takes a length (an integer) first, got str
// TL2: a test per diagnostic of the type, borrow and escape checks.
// Vec::filled(n, x) makes n copies of x.

fn main() -> i64 {
    val v: Vec<i64> = Vec::filled("three", 0);
    println(v.len());
    return 0;
}
