// Release D16: strings carry their length. Every string the program makes,
// literals included, has [magic][length] before its bytes: str_len is O(1),
// a comparison of strings of different lengths stops at once, and a zero
// byte inside a string is kept by concatenation, comparison and byte access.
//
// Expected output:
// 5
// 0
// 99
// false
// true
// 5
// 0
// 1000
// true
// false

fn main() -> i64 {
    var z: str = p_char_to_str(0);
    var s: str = "ab" + z + "cd";
    println(str_len(s));
    println(str_byte_at(s, 2));
    println(str_byte_at(s, 3));
    var t: str = "ab" + z + "cX";
    println(s == t);
    println(s == "ab" + z + "cd");
    println(str_len("hello"));
    println(str_len(""));
    var big: str = "";
    var i: i64 = 0;
    while i < 1000 {
        big = big + "x";
        i = i + 1;
    }
    println(str_len(big));
    println(big == str_repeat_x(1000));
    println(big == str_repeat_x(999));
    return 0;
}

fn str_repeat_x(n: i64) -> str {
    var r: str = "";
    var i: i64 = 0;
    while i < n {
        r = r + "x";
        i = i + 1;
    }
    return r;
}
