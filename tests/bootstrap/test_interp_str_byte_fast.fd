// The interpreter answers core's str_byte_at / str_len of a string it holds
// without running core (compiler/interp.fd, Inst::Call: test_lex_par and
// test_parse_par ran past their time limit on ~0.4 ms per byte read). The
// answers must stay core's on every backend: -1 out of range, a byte
// 0..255 (bytes >= 128 and zero bytes inside the string included), the
// counted length; also through a struct field and String_byte_at.
//
// Expected output:
// len 5 0 3 3
// abc: 97 98 99 -1 -1
// empty: -1 -1
// high: 195 169 -1
// nul: 120 0 121 3
// field: 104 105 -1 2
// String_byte_at: 98 -1
// sum 593

use core;
use string;

struct Holder {
    s: str,
    n: i64,
}

fn main() -> i64 {
    var a: str = "abc";
    var e: str = "";
    var h: str = "\u{e9}";
    var z: str = "x" + byte_to_str(0) + "y";
    println("len " + int_to_str(str_len("hello")) + " " + int_to_str(str_len(e)) + " " + int_to_str(str_len(a)) + " " + int_to_str(str_len(z)));
    println("abc: " + int_to_str(str_byte_at(a, 0)) + " " + int_to_str(str_byte_at(a, 1)) + " " + int_to_str(str_byte_at(a, 2)) + " " + int_to_str(str_byte_at(a, 3)) + " " + int_to_str(str_byte_at(a, -1)));
    println("empty: " + int_to_str(str_byte_at(e, 0)) + " " + int_to_str(str_byte_at(e, -1)));
    println("high: " + int_to_str(str_byte_at(h, 0)) + " " + int_to_str(str_byte_at(h, 1)) + " " + int_to_str(str_byte_at(h, 2)));
    println("nul: " + int_to_str(str_byte_at(z, 0)) + " " + int_to_str(str_byte_at(z, 1)) + " " + int_to_str(str_byte_at(z, 2)) + " " + int_to_str(str_len(z)));
    var hd: Holder = Holder { s: "hi", n: 0 };
    println("field: " + int_to_str(str_byte_at(hd.s, 0)) + " " + int_to_str(str_byte_at(hd.s, 1)) + " " + int_to_str(str_byte_at(hd.s, 2)) + " " + int_to_str(str_len(hd.s)));
    println("String_byte_at: " + int_to_str(String_byte_at(a as i64, 1)) + " " + int_to_str(String_byte_at(a as i64, 9)));
    var sum: i64 = 0;
    var i: i64 = 0;
    while i < str_len(a) {
        sum = sum + str_byte_at(a, i) * (i + 1);
        i = i + 1;
    }
    sum = sum + str_len(a) + hd.n;
    println("sum " + int_to_str(sum));
    return 0;
}
