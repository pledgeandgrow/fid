// CU3: `@deprecated(use = "new_fn")` is accepted on a function (it was an
// unknown annotation, and `use` a parse error inside one); each call of it
// gives a warning naming the replacement (shown by `fid lint`), and the
// program still builds and runs.
// Expected output:
// 6
// 6
// 5

@deprecated(use = "area_of")
fn area(w: i64, h: i64) -> i64 {
    return w * h;
}

fn area_of(w: i64, h: i64) -> i64 {
    return w * h;
}

@deprecated("no longer needed")
fn old_five() -> i64 {
    return 5;
}

fn main() -> i64 {
    println(area(2, 3));
    println(area_of(2, 3));
    println(old_five());
    return 0;
}
