// Driver goals (docs/roadmap/llvm-roadmap.md RA14, TG19): the same program
// must print the same with `fid emit --fast-alloc` (RA14's fast allocator
// with the mid-end on: nat_ir g_nat_fast) and with `fid emit --size`
// (TG19: no loop-head padding, no inline Vec calls, no unrolling). On any
// backend it is an ordinary program; scripts/driver-goals-check.sh builds
// it both ways for x86_64-linux and compares (it runs the images on a
// Linux host, and checks the --size image is not larger).
// Expected output:
// 338350
// 6 4 2
// 15
// 1 2 3 5 8
// 120

fn sq_sum(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        s = s + i * i;
        i = i + 1;
    }
    return s;
}

fn fact(n: i64) -> i64 {
    if n <= 1 {
        return 1;
    }
    return n * fact(n - 1);
}

fn main() -> i64 {
    println(sq_sum(100));
    // values swapped around a loop
    var a: i64 = 2;
    var b: i64 = 4;
    var c: i64 = 6;
    var k: i64 = 0;
    while k < 3 {
        var t: i64 = a;
        a = c;
        c = t;
        k = k + 1;
    }
    println(int_to_str(a) + " " + int_to_str(b) + " " + int_to_str(c));
    // a Vec: its calls are inlined unless --size
    var v: Vec<i64> = Vec::new();
    var i: i64 = 1;
    while i <= 5 {
        v.push(i);
        i = i + 1;
    }
    var s: i64 = 0;
    var j: i64 = 0;
    while j < v.len() {
        s = s + v.get(j);
        j = j + 1;
    }
    println(s);
    // fibonacci into a Vec
    var f: Vec<i64> = Vec::new();
    f.push(1);
    f.push(2);
    while f.len() < 5 {
        f.push(f.get(f.len() - 1) + f.get(f.len() - 2));
    }
    var line: str = "";
    var q: i64 = 0;
    while q < f.len() {
        if q > 0 {
            line = line + " ";
        }
        line = line + int_to_str(f.get(q));
        q = q + 1;
    }
    println(line);
    println(fact(5));
    return 0;
}
