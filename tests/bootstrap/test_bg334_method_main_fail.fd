// expect-error: 'main' is declared to return str but can reach the end of its body without returning
// Bugs roadmap BG334: only the program's entry `main` is exempt from the
// missing-return check (reference §2.1), not a method named main; before,
// a.main() printed `void` (run) or an empty line (ccompile).
struct App {
    n: i64,
}

impl App {
    fn main(self) -> str {
        if self.n > 0 {
            return "pos";
        }
    }
}

fn main() -> i64 {
    val a = App { n: -1 };
    println(a.main());
    return 0;
}
