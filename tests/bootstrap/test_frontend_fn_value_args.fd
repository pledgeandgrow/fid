// Roadmap L6C: a call through a function value (a parameter or variable of
// type fn(..)) has each argument checked against the function type, as a
// call of a named function is. Calls whose arguments fit are accepted.
// Expected output:
//   42
//   7
//   hello, fid
//   2.5

fn double(x: i64) -> i64 {
    return x * 2;
}

fn greet(name: str) -> str {
    return "hello, " + name;
}

fn halve(x: f64) -> f64 {
    return x / 2.0;
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

fn apply2(f: fn(i64, i64) -> i64, a: i64, b: i64) -> i64 {
    return f(a, b);
}

fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn main() -> i64 {
    println(int_to_str(apply(double, 21)));
    println(int_to_str(apply2(add, 3, 4)));
    val g: fn(str) -> str = greet;
    println(g("fid"));
    val h: fn(f64) -> f64 = halve;
    println(float_to_str(h(5.0)));
    return 0;
}
