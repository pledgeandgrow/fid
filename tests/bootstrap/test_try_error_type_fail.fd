// expect-error: the error types differ
// Bugs roadmap BG23: `?` passed a Result<i64, i64>'s error on from a
// function returning Result<i64, str>: the lowering copies the payload
// word, so the caller's error string was the address 5.
fn code(n: i64) -> Result<i64, i64> {
    if n < 0 {
        return Result::Err(5);
    }
    return Result::Ok(n);
}

fn run(n: i64) -> Result<i64, str> {
    val v: i64 = code(n)?;
    return Result::Ok(v + 1);
}

fn main() -> i64 {
    match run(-1) {
        Result::Ok(v) => {
            println(int_to_str(v));
        }
        Result::Err(e) => {
            println(e);
        }
    }
    return 0;
}
