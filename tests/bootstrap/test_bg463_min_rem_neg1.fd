// Bugs roadmap BG463: `MIN % -1` is 0 on every backend (run, ccompile,
// emit, --nat, wasm), but docs/verification/semantics.md and the fuzzer's
// C oracle (scripts/fuzz/gen_vs_c.py, tools/fuzz_vs_c.fd) said it panics.
// The remainder is 0, which is in range (only the quotient MIN / -1
// overflows), so the implemented behaviour is the one kept: the semantics,
// reference.md §3.5, the language guide and both oracles now say 0.
//
// Expected output:
// 0
// 0
// 0
// 1
// -1

fn md(a: i64, b: i64) -> i64 {
    return a % b;
}

fn md32(a: i32, b: i32) -> i32 {
    return a % b;
}

fn md8(a: i8, b: i8) -> i8 {
    return a % b;
}

fn main() {
    val m: i64 = -9223372036854775807 - 1;
    println(md(m, -1));
    val m32: i32 = -2147483647 - 1;
    println(md32(m32, -1));
    val m8: i8 = -127 - 1;
    println(md8(m8, -1));
    println(md(7, 3));
    println(md(-7, 3));
}
