// LG14: an `async fn` takes reference arguments. A reference cannot reach
// another task (references are second-class, §8.4), so such a function runs
// on its caller's stack to its end at the call, and its future is ready;
// where it waits, its caller's task waits (reference §10.2). Words, f64 and
// structs make it a task of its own (test_async_float_struct.fd).
// Expected output:
// 7
// 7
// 7
// 42
// 9

async fn total(v: &Vec<i64>) -> Future<i64> {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        s = s + v.get(i);
        i = i + 1;
    }
    return s;
}

async fn bump(x: &mut i64, by: i64) -> Future<i64> {
    *x = *x + by;
    return *x;
}

async fn plain(a: i64) -> Future<i64> {
    return a * 2;
}

async fn outer(v: &Vec<i64>) -> Future<i64> {
    val t = await total(v);
    return t + 2;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(3);
    v.push(4);
    val f = total(&v);
    println(await f);
    var n: i64 = 5;
    val g = bump(&mut n, 2);
    println(await g);
    println(n);
    println(await plain(21));
    println(await outer(&v));
}
