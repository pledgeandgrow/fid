// LF15: a string or Box counted again and dropped, or a Vec shared only
// to be read, with the pair split over blocks that run straight on into
// each other (compiler/lower.fd lw_rc_cancel_pairs, LOWER_CANCEL_ACROSS):
// the pair goes, the values stay right. Expected output:
// hello world 11
// 3 a|b|c
// yes 5
// loop 0 1 2
// kept abc abc

fn len_of(s: str) -> i64 {
    return str_len(s);
}

fn joined(v: Vec<str>) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 {
            out = out + "|";
        }
        out = out + v.get(i);
        i = i + 1;
    }
    return out;
}

fn pick(flag: bool, s: str) -> str {
    var t: str = s;
    if flag {
        return t;
    }
    return "no";
}

fn main() {
    var a: str = "hello";
    var b: str = a + " world";
    println(b + " " + int_to_str(len_of(b)));
    var v: Vec<str> = Vec::new();
    v.push("a");
    v.push("b");
    v.push("c");
    var w: Vec<str> = v;
    println(int_to_str(w.len()) + " " + joined(v));
    var p: str = pick(true, "yes");
    println(p + " " + int_to_str(len_of(a)));
    var out: str = "loop";
    var i: i64 = 0;
    loop {
        if i >= 3 {
            break;
        }
        var n: str = int_to_str(i);
        var m: str = n;
        out = out + " " + m;
        i = i + 1;
    }
    println(out);
    var x: str = "abc";
    var y: str = x;
    {
        var z: str = y;
        println("kept " + z + " " + x);
    }
}
