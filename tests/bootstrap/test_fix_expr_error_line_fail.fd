// expect-error: Type error (line 10): no method 'frobnicate' on Vec
// Test (stdlib-agent bugs 5/41): an error an expression gives without a
// place ("Type error: no method ...") gets the line of the statement it is
// in, here a call nested in another call's arguments.
fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    var n: i64 = 0;
    n = n + v.len() + int_from(v.frobnicate());
    println(int_to_str(n));
}

fn int_from(x: i64) -> i64 {
    return x;
}
