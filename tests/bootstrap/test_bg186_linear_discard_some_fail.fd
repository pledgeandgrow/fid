// expect-error: holds a linear value and is thrown away
// Bugs roadmap BG186: `Option::Some(t);` as a statement consumes `t` into
// a value that is thrown away (it was reported as `t` never consumed).
@linear
struct Tok {
    v: i64,
}

fn main() -> i64 {
    val t = Tok { v: 1 };
    Option::Some(t);
    return 0;
}
