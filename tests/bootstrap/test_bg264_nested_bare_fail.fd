// expect-error: missing variant(s): Option::None
// Bugs roadmap BG264: the same with bare variant names and the nested
// position second: `Pair(x, Some(y))` leaves `Pair(_, None)` uncovered.
enum P {
    Pair(i64, Option<i64>),
    Empty,
}
fn g(p: P) -> i64 {
    match p {
        P::Pair(x, Some(y)) => {
            return x + y;
        }
        P::Empty => {
            return 0;
        }
    }
    return 9;
}
fn main() -> i64 {
    println(g(P::Pair(1, Option::None)));
    return 0;
}
