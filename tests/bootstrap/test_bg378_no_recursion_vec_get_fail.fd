// expect-error: is @no-recursion but calls the local 'g', a function value whose target is not known
// Bugs roadmap BG378: `val g = v.get(0); g(x - 1)` recursed through a
// function value taken out of a Vec, and passed @no-recursion.
@no-recursion
fn f(x: i64) -> i64 {
    var v: Vec<fn(i64) -> i64> = Vec::new();
    v.push(f);
    val g = v.get(0);
    if x <= 0 {
        return 0;
    }
    return g(x - 1);
}
fn main() {
    println(f(3));
}
