// Release H3 / M5: a Vec given to another task is a copy (copy-on-write,
// proposal 0001), so a task changing it cannot race with, or change, the
// caller's Vec. Before copy-on-write the task got the same handle.
//
// Expected output:
// task sees 3
// async sees 4
// main still has 2
// 1 2
// parallel 5 7

async fn grow(v: Vec<i64>) -> Future<i64> {
    var w: Vec<i64> = v;
    w.push(30);
    w.push(40);
    return w.len();
}

fn add_one(v: Vec<i64>) -> i64 {
    var w: Vec<i64> = v;
    w.push(99);
    return w.len();
}

fn sum_plus(v: Vec<i64>, k: i64) -> i64 {
    var w: Vec<i64> = v;
    w.push(k);
    var s: i64 = 0;
    var i: i64 = 0;
    while i < w.len() { s = s + w.get(i); i = i + 1; }
    return s;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    val t = spawn add_one(v);
    println("task sees " + int_to_str(await t));
    val f = grow(v);
    println("async sees " + int_to_str(await f));
    println("main still has " + int_to_str(v.len()));
    println(int_to_str(v.get(0)) + " " + int_to_str(v.get(1)));
    // two tasks at once, each changing its own copy
    val a = spawn sum_plus(v, 2);
    val b = spawn sum_plus(v, 4);
    println("parallel " + int_to_str(await a) + " " + int_to_str(await b));
    return 0;
}
