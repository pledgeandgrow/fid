// test_gpu_region_fail.fd — ML1: GPU region budget exceeded
// Expected: FAIL (compile error — GPU region exceeds memory budget)
// 4 i64 variables = 32 bytes, budget = 16 → compile error

fn main() {
    region gpu weights with budget(16) {
        val a: i64 = 1;
        val b: i64 = 2;
        val c: i64 = 3;
        val d: i64 = 4;
    }
    return 0;
}
