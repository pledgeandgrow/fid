// BG439 (docs/roadmap/bugs-roadmap.md): oidc_half_hash takes the hash of
// the ID token's algorithm (OIDC Core §3.1.3.6): SHA-384 for ES384, HS384,
// PS384 and RS384, so at_hash of a *384 token is the 24-byte left half of
// SHA-384, not the 16-byte half of SHA-256. Values from Python hashlib.
//
// Expected output:
// qijbNZLJUenLNKW0AjL6YizBFf1l_j4t
// qijbNZLJUenLNKW0AjL6YizBFf1l_j4t
// qijbNZLJUenLNKW0AjL6YizBFf1l_j4t
// qijbNZLJUenLNKW0AjL6YizBFf1l_j4t
// PdkM--iZlIdDdi-0vOgawA
// PdkM--iZlIdDdi-0vOgawA
// auBh6RHmiKzZuzxS8l1d5u8I30aUMwJz3wa18JeYH-8
// auBh6RHmiKzZuzxS8l1d5u8I30aUMwJz3wa18JeYH-8
// OLBgp1GsljhM2TJ-sbHjaiH9txEUvgdD
use oauth2;

fn main() -> i64 {
    val t: str = "abc-access-token";
    // the entry's trigger, and the other *384 algorithms
    println(oidc_half_hash("ES384", t));
    println(oidc_half_hash("HS384", t));
    println(oidc_half_hash("PS384", t));
    println(oidc_half_hash("RS384", t));
    // SHA-256 and SHA-512 algorithms are unchanged
    println(oidc_half_hash("RS256", t));
    println(oidc_half_hash("ES256", t));
    println(oidc_half_hash("ES512", t));
    println(oidc_half_hash("EdDSA", t));
    // an empty token
    println(oidc_half_hash("ES384", ""));
    return 0;
}
