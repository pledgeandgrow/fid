// expect-error: 'self' is a by-value receiver of 'add' and cannot be changed
// Bugs roadmap BG397: a Vec field of a bare (by-value) `self` pushed to was
// visible in the caller.
struct P { v: Vec<i64> }
impl P {
    fn add(self, x: i64) {
        self.v.push(x);
    }
}
fn main() {
    var p = P { v: Vec::new() };
    p.add(9);
    println(p.v.len());
}
