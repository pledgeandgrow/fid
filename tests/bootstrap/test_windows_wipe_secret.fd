// test_windows_wipe_secret.fd — llvm LF20 on the default Windows backend
// (compiler/pe_ir.fd PeirGen_wipe_frame): a function that holds secrets
// (an @zeroize local, or @constant_time) clears its whole frame (every
// slot, spill and temporary) and the scratch registers before it returns,
// the result kept in rax. The results do not change: every backend prints
// the same. The bytes are checked by scripts/pe-win-check.sh.
//
// Expected output:
// 170
// 85
// 1009
// 1234
// 3

/// a where mask is all ones, b where it is zero.
@constant_time
@wrapping
fn ct_select(mask: i64, a: i64, b: i64) -> i64 {
    return (a & mask) | (b & ~mask);
}

fn mix(key: i64, x: i64) -> i64 {
    @zeroize
    var k: i64 = key * 31;
    var r: i64 = (x ^ k) + 7;
    return r - (x ^ k) + x;
}

/// The caller's values in registers survive the call.
fn caller(n: i64) -> i64 {
    var a: i64 = n + 1;
    var b: i64 = n + 2;
    var c: i64 = n + 3;
    var s: i64 = mix(99, n);
    return a + b + c + s - 3 * n - 6 + ct_select(0, 5, 3) - 3;
}

fn main() {
    print(ct_select(0 - 1, 170, 85));
    print("\n");
    print(ct_select(0, 170, 85));
    print("\n");
    print(mix(12345, 1002));
    print("\n");
    print(caller(1234) - 7);
    print("\n");
    print(ct_select(0 - 1, 3, 4));
    print("\n");
    return 0;
}
