// expect-error: a branch of `parallel { }` in 'main' runs on another thread and writes the global 'total' with no lock
// Bugs roadmap BG24: a `parallel { }` branch writing a global itself was
// code of `main` for the race check, which runs on the main thread only.
var total: i64 = 0;

fn main() -> i64 {
    parallel {
        | total = total + 1;
          println("one");
        | total = total + 2;
          println("two");
    }
    println(int_to_str(total));
    return 0;
}
