// expect-error: 'noisy' produces output and is called inside a branch or loop that depends on a secret
// BG170: the right operand of `&&` runs only when the secret left side
// is true, so the output in it depends on the secret (as in an if).
fn noisy() -> bool { println("hi"); return true; }
fn check(@secret pin: i64) -> bool {
    val b: bool = pin == 1234 && noisy();
    return true;
}
fn main() -> i64 { check(1234); return 0; }
