// test_persist_weights.fd — ML4: Hot-swappable model weights via persist
// Expected: PASS
// Tests that persist variables work with different types (int, float, string).
// In watch mode, these survive hot reloads — model weights and KV cache
// persist across code changes.

fn main() {
    // Persist an integer (e.g., step counter)
    persist var step: i64 = 0;
    step += 1;
    print(f"step={step}");
    print("\n");

    // Persist a float (e.g., learning rate)
    persist val lr: f64 = 0.001;
    print(f"lr={lr}");
    print("\n");

    // Persist a string (e.g., model name)
    persist val model_name = "transformer_v1";
    print(f"model={model_name}");
    print("\n");

    // Persist a boolean (e.g., training mode)
    persist val is_training: bool = true;
    print(f"training={is_training}");
    print("\n");

    return 0;
}
