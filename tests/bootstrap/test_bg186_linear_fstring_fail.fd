// expect-error: was already consumed
// Bugs roadmap BG186: what an f-string's parts consume was not counted.
@linear
struct Tok {
    v: i64,
}

fn use_tok(t: Tok) -> i64 {
    return t.v;
}

fn main() -> i64 {
    val t = Tok { v: 1 };
    println(f"{use_tok(t)}");
    println(use_tok(t));
    return 0;
}
