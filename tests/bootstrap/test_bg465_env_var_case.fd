// Bugs roadmap BG465: on `emit --nat` Windows `env_var` compared names byte
// by byte, so `env_var("SYSTEMROOT")` missed the `SystemRoot` the
// environment holds (Windows names ignore case: getenv, pe_ir and the C
// runtime find it). stdlib/linux_runtime/base.fd pert_getenv now folds
// ASCII case on Windows. On Linux and macOS names keep their case: those
// variants look up variables by their exact names.
//
// Expected output:
// set set set
// none

fn has(name: str) -> str {
    match env_var(name) {
        Option::Some(v) => {
            return "set";
        }
        Option::None => {
            return "none";
        }
    }
}

@cfg(windows)
fn names() -> str {
    return has("SYSTEMROOT") + " " + has("systemroot") + " " + has("SystemRoot");
}

@cfg(linux)
fn names() -> str {
    return has("PATH") + " " + has("PATH") + " " + has("PATH");
}

@cfg(macos)
fn names() -> str {
    return has("PATH") + " " + has("PATH") + " " + has("PATH");
}

fn main() {
    println(names());
    println(has("BG465_NO_SUCH_VARIABLE_X"));
}
