// Test: ?? coalescing operator (Phase 7A — F9)
// expr ?? default — if expr is None, return default; else unwrap and return value

use core;

fn maybe_value(x: i64) -> Option {
    if x > 0 {
        return Option::Some(x);
    }
    return Option::None;
}

fn main() -> i64 {
    // Some value ?? default → unwrapped value
    val a = maybe_value(42) ?? 0;
    print(a);
    print("\n");

    // None ?? default → default
    val b = maybe_value(-1) ?? 99;
    print(b);
    print("\n");

    // Chain with function call
    val c = maybe_value(10) ?? -1;
    print(c);
    print("\n");

    // None with negative default
    val d = maybe_value(0) ?? -100;
    print(d);
    print("\n");

    // Direct Option literal
    val e = Option::Some(7) ?? 0;
    print(e);
    print("\n");

    val f = Option::None ?? 55;
    print(f);
    print("\n");

    return 0;
}
