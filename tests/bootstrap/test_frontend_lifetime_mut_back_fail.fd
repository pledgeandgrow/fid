// expect-error: cannot mutate a: a mutable borrow is active
// LG3: when the borrower a `&mut` was handed to ends first, the borrow goes
// back to the variable it came from: `m` is used again below, so `a` is
// still mutably borrowed after `r`'s last use.
fn id_mut(p: &mut i64) -> &mut i64 {
    return p;
}

fn main() -> i64 {
    var a: i64 = 1;
    val m = &mut a;
    val r = id_mut(m);
    *r = 3;
    a = 9;
    *m = 4;
    println(a);
    return 0;
}
