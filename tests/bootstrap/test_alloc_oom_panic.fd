// An allocation the system refuses stops the program with a panic that
// says so: "out of memory (1099511627776 bytes requested)", exit code 1.
// Before, the native allocators returned NULL (pe_ir's p_malloc stub in
// compiler/pe_ir_stubs.fd: its HeapAlloc, chunk and --checked-alloc
// paths), and the caller faulted later at some other place ("Invalid
// memory access (null or dangling pointer)"); the Linux / --nat runtime
// (stdlib/linux_runtime/base.fd pe_mmap_for, pe_oom) now names the size
// too. The line after the allocation is never printed.
//
// Expected output:
// start
// Expected exit: 1

fn main() -> i64 {
    println("start");
    val n: i64 = 1 << 40;
    var p: i64 = 0;
    // SAFETY: the block is never read or written; the call does not return.
    unsafe {
        p = p_malloc(n);
    }
    println("got " + int_to_str(p));
    return 0;
}
