// Bugs roadmap BG204 (what was left): a p_json_parse result held in a
// variable (`val j = p_json_parse(..)`, typed i64) leaked one string per
// parse; only a result passed straight to a JSON reader was dropped. Every
// p_json_parse/get/at result is a temporary of its statement now (lower.fd
// Lowerer_rc_note_call, lw_json_fresh_call): a variable keeps it and drops
// it with its scope, an argument is dropped at the statement's end. Leak
// gate:
//   fid run tests/bootstrap/test_bg204_json_var_drop.fd --leaks
//
// Expected output:
// "value"
// 12345678
// 2
// [1,2,3]
// done

fn name_of(text: str) -> str {
    val j = p_json_parse(text);
    val n = p_json_get(j, "name");
    return p_json_dump(n);
}

fn main() -> i64 {
    var i: i64 = 0;
    var last: str = "";
    var k: i64 = 0;
    while i < 500 {
        val j = p_json_parse("{\"name\": \"value\", \"k\": 12345678}");
        last = p_json_dump(p_json_get(j, "name"));
        k = p_json_get_int(j, "k");
        i = i + 1;
    }
    println(last);
    println(k);
    var a: i64 = 0;
    var s: str = "";
    i = 0;
    while i < 300 {
        var arr = p_json_parse("[1, 2, 3]");
        val second = p_json_at(arr, 1);
        a = p_json_len(arr) - 1;
        s = p_json_dump(arr);
        arr = p_json_parse("[4]");
        i = i + 1;
    }
    println(a);
    println(s);
    i = 0;
    while i < 200 {
        last = name_of("{\"name\": \"x\"}");
        i = i + 1;
    }
    println("done");
    return 0;
}
