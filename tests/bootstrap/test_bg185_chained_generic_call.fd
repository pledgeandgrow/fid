// Bugs roadmap BG185 (its trigger): `Slot { v: 7, n: 3 }.wrap().get()`
// gave `7 7` on every backend. mono (compiler/mono.fd infer_expr_type)
// typed a call of a generic impl's method as its receiver, so `wrap()` was
// a Slot<i64> and `get` was instantiated for Slot<i64> (returning the
// inner Slot's address as T = i64) instead of Slot<Slot<i64>>. A call of a
// user generic impl's method now has its result type (mono_gm_ret_type).
//
// Expected output:
// 7 3
// 42
// 7
// 5 1

struct Slot<T> {
    v: T,
    n: i64,
}

impl<T> Slot<T> {
    fn get(self) -> T {
        return self.v;
    }
    fn wrap(self) -> Slot<Slot<T>> {
        return Slot { v: self, n: 42 };
    }
    fn count(self) -> i64 {
        return self.n;
    }
}

fn main() -> i64 {
    val g = Slot { v: 7, n: 3 }.wrap().get();
    println(f"{g.v} {g.n}");
    println(Slot { v: 7, n: 3 }.wrap().count());
    println(Slot { v: 7, n: 3 }.wrap().get().get());
    val a: Slot<i64> = Slot { v: 5, n: 1 };
    val h = a.wrap().get();
    println(f"{h.v} {h.n}");
    return 0;
}
