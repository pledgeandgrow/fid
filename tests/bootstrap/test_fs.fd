// Test: stdlib/fs — file io via p_file_*, dir walk, glob, mkdir/rmdir, temp files.
use fs;
use vec;

fn bs(b: bool) -> str {
    if b { return "t"; }
    return "f";
}

fn join_all(v: Vec) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < v.len() {
        var x: str = v.get(i);
        out = out + x + "|";
        i = i + 1;
    }
    return out;
}

fn main() -> i64 {
    var ok: i64 = 0;

    // ── temp dir + mkdir -p ──
    var tmp: str = fs_temp_dir(".", "fdt");
    println("m1 " + bs(fs_is_dir(tmp)));
    println("m2 " + bs(fs_mkdir_all(fs_join(tmp, "a/b"))));

    fs_write_text(fs_join(tmp, "a/b/x.fd"), "x");
    fs_write_text(fs_join(tmp, "a/y.txt"), "y");
    fs_write_text(fs_join(tmp, "top.txt"), "t");

    // ── read back ──
    println("r1 " + fs_read_text(fs_join(tmp, "top.txt")));
    println("r2 " + int_to_str(fs_file_size(fs_join(tmp, "top.txt"))));
    println("r3 " + bs(fs_exists(fs_join(tmp, "top.txt"))));
    println("r4 " + bs(fs_is_file(fs_join(tmp, "top.txt"))));
    println("r5 " + bs(!fs_is_file(tmp)));

    // ── list / walk ──
    var l: Vec = fs_list_dir(tmp);
    println("l1 " + int_to_str(l.len()));
    var w: Vec = fs_walk(tmp);
    println("w1 " + int_to_str(w.len()));
    var wf: Vec = fs_walk_files(tmp);
    println("w2 " + int_to_str(wf.len()));

    // ── glob ──
    println("g1 " + int_to_str(fs_glob(tmp, "**/*.fd").len()));
    println("g2 " + int_to_str(fs_glob(tmp, "*.txt").len()));
    println("g3 " + int_to_str(fs_glob(tmp, "a/*/x.fd").len()));
    println("g4 " + bs(fs_glob_match("file.fd", "*.fd")));
    println("g5 " + bs(fs_glob_match("fileXfd", "file?fd")));

    // ── path helpers ──
    println("p1 " + fs_basename("a/b/c.txt"));
    println("p2 " + fs_dirname("a/b/c.txt"));
    println("p3 " + fs_ext("a/b/c.txt"));
    println("p4 " + fs_stem("a/b/c.txt"));
    println("p5 " + fs_join("a", "b"));
    println("p6 " + fs_join("a/", "/b"));

    // ── rename / delete ──
    var from: str = fs_join(tmp, "top.txt");
    var to: str = fs_join(tmp, "renamed.txt");
    println("d1 " + bs(fs_rename(from, to)));
    println("d2 " + bs(fs_exists(to)));

    // ── temp file ──
    var tf: str = fs_temp_file(tmp, "pref");
    println("t1 " + bs(fs_exists(tf)));
    fs_delete(tf);

    // ── recursive delete ──
    println("z1 " + bs(fs_rmdir_all(tmp)));
    println("z2 " + bs(!fs_exists(tmp)));

    return 0;
}
