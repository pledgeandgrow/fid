// expect-error: Borrow error: global 'g_view' holds a @scoped struct, which cannot be kept.
//! error: Borrow error: global 'g_view' holds a @scoped struct, which cannot be kept.
// TL2: a test per diagnostic of the type, borrow and escape checks.
// A @scoped struct cannot be kept in a global (release M11).

@scoped
struct View {
    text: str,
}

var g_view: View = View { text: "a" };

fn main() -> i64 {
    return 0;
}
