// expect-error: Effect error: function 'fill' has inferred effect '!Alloc'
// Expected to FAIL (known-bugs 2g.65): pushing onto a Vec parameter may grow
// its buffer, so `fill` allocates although it builds no Vec itself.
fn fill(v: &mut Vec<i64>, n: i64) -> i64 !{} {
    var i: i64 = 0;
    while i < n {
        v.push(i);
        i = i + 1;
    }
    return n;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    println(int_to_str(fill(&mut v, 3)));
}
