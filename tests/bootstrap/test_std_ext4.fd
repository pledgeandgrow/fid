// A RAM disk of 1 KiB blocks from "offset:hex;offset:hex..." (zeros elsewhere).
fn disk_from_sparse(s: str, nblocks: i64) -> BlockDev {
    val d: BlockDev = memdisk_new(1024, nblocks);
    val parts: Vec<str> = str_split(s, ";");
    var i: i64 = 0;
    while i < parts.len() {
        val kv: Vec<str> = str_split(parts.get(i), ":");
        val off: i64 = str_parse_int(kv.get(0));
        val bs: Vec<i64> = hex_decode_bytes(kv.get(1));
        var lba: i64 = off / 1024;
        var blk: Vec<i64> = blk_read(&d, lba);
        var j: i64 = 0;
        while j < bs.len() {
            val o: i64 = off + j;
            if o / 1024 != lba {
                blk_write(&d, lba, blk);
                lba = o / 1024;
                blk = blk_read(&d, lba);
            }
            blk.set(o % 1024, bs.get(j));
            j = j + 1;
        }
        blk_write(&d, lba, blk);
        i = i + 1;
    }
    return d;
}

fn poke(d: & BlockDev, off: i64, value: i64) {
    var blk: Vec<i64> = blk_read(d, off / 1024);
    blk.set(off % 1024, value);
    blk_write(d, off / 1024, blk);
}

fn peek(d: & BlockDev, off: i64) -> i64 {
    return blk_read(d, off / 1024).get(off % 1024);
}

fn line_at(b: Vec<i64>, off: i64) -> str {
    var out: Vec<i64> = Vec::new();
    var i: i64 = off;
    while i < b.len() && b.get(i) != 10 && b.get(i) != 0 {
        out.push(b.get(i));
        i = i + 1;
    }
    return str_from_bytes(out);
}

fn names(fs: & Ext4Fs, path: str) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    val n: Ext4Inode = ext4_inode(fs, ext4_lookup(fs, path, true));
    val es: Vec<Ext4Dirent> = ext4_readdir(fs, &n);
    var i: i64 = 0;
    while i < es.len() {
        val nm: str = es.get(i).name;
        if nm != "." && nm != ".." {
            out.push(nm);
        }
        i = i + 1;
    }
    return out;
}

fn e4_depth(n: & Ext4Inode) -> i64 {
    return n.iblock.get(6) + n.iblock.get(7) * 256;
}

fn main() {
    var e2: Ext4Fs = ext4_open(disk_from_sparse(EXT2_IMG(), 128));
    println("ext2 \"" + e2.label + "\": block " + int_to_str(e2.bs) + ", " + int_to_str(e2.blocks_count) + " blocks, " + int_to_str(e2.inodes_count) + " inodes, " + int_to_str(e2.ngroups) + " groups, inode size " + int_to_str(e2.inode_size) + ", metadata_csum " + bool_to_str(e2.csum));
    println("ls /: " + str_join(names(&e2, "/"), " "));
    println("/hello.txt: " + line_at(ext4_read_file(&mut e2, "/hello.txt"), 0));
    val big: Vec<i64> = ext4_read_file(&mut e2, "/big.txt");
    println("/big.txt: " + int_to_str(big.len()) + " bytes, block 0 \"" + line_at(big, 0) + "\", block 12 (single indirect) \"" + line_at(big, 12 * 1024) + "\", block 14 \"" + line_at(big, 14 * 1024) + "\"");
    val sp: Vec<i64> = ext4_read_file(&mut e2, "/sparse.bin");
    var nz: i64 = 0;
    var i: i64 = 0;
    while i < sp.len() {
        if sp.get(i) != 0 {
            nz = nz + 1;
        }
        i = i + 1;
    }
    println("/sparse.bin: " + int_to_str(sp.len()) + " bytes, hole byte 1000 = " + int_to_str(sp.get(1000)) + ", byte 6144 = " + int_to_str(sp.get(6144)) + ", non-zero bytes " + int_to_str(nz));
    val ln: Ext4Inode = ext4_inode(&e2, ext4_lookup(&e2, "/link", false));
    println("/link -> " + ext4_readlink(&e2, &ln) + ", read through it: " + line_at(ext4_read_file(&mut e2, "/link"), 0));
    val ll: Ext4Inode = ext4_inode(&e2, ext4_lookup(&e2, "/longlink", false));
    println("/longlink: " + int_to_str(str_len(ext4_readlink(&e2, &ll))) + " byte target (slow symlink), following it: " + vfs_errno_name(ext4_lookup(&e2, "/longlink", true)));
    println("/docs/../docs/readme: " + line_at(ext4_read_file(&mut e2, "/docs/../docs/readme"), 0));

    val d4: BlockDev = disk_from_sparse(EXT4_IMG(), 256);
    val e4: Ext4Fs = ext4_open(d4);
    println("ext4 \"" + e4.label + "\": block " + int_to_str(e4.bs) + ", " + int_to_str(e4.blocks_count) + " blocks, " + int_to_str(e4.inodes_count) + " inodes, 64-bit descriptors " + int_to_str(e4.desc_size) + ", metadata_csum " + bool_to_str(e4.csum) + ", superblock checksum " + str_replace(bool_to_str(e4.sb_csum_ok), "true", "ok"));
    var all_ok: bool = true;
    var ino: i64 = 1;
    while ino <= e4.inodes_count {
        val n: Ext4Inode = ext4_inode(&e4, ino);
        if n.mode != 0 && !n.csum_ok {
            all_ok = false;
        }
        ino = ino + 1;
    }
    println("every inode checksum ok: " + bool_to_str(all_ok));
    val sn: Ext4Inode = ext4_inode(&e4, ext4_lookup(&e4, "/sparse.bin", true));
    val ex: Vec<i64> = ext4_extents(&e4, &sn);
    var starts: Vec<i64> = Vec::new();
    i = 0;
    while i < ex.len() {
        starts.push(ex.get(i));
        i = i + 4;
    }
    val sp4: Vec<i64> = ext4_read(&e4, &sn, 0, sn.size);
    var same: bool = sp4.len() == sp.len();
    i = 0;
    while same && i < sp.len() {
        if sp.get(i) != sp4.get(i) {
            same = false;
        }
        i = i + 1;
    }
    println("/sparse.bin: " + int_to_str(starts.len()) + " extents (tree depth " + int_to_str(e4_depth(&sn)) + "), logical " + str_join_ints(starts, " ") + ", same bytes as on ext2: " + bool_to_str(same));
    val many: Vec<str> = names(&e4, "/many");
    println("/many: " + int_to_str(many.len()) + " entries, first " + many.get(0));

    var v: Vfs = vfs_new();
    vfs_mount(&mut v, "/", ramfs_ops(), ramfs_new());
    vfs_mkdir(&mut v, "/mnt", 493);
    ext4_mount(&mut v, "/mnt", e4);
    println("vfs /mnt/docs/readme: " + line_at(vfs_read_file(&mut v, "/mnt/docs/readme"), 0) + ", /mnt/link: " + line_at(vfs_read_file(&mut v, "/mnt/link"), 0) + ", ls /mnt/docs: " + str_join(vfs_list(&mut v, "/mnt/docs"), " "));

    // inode 15 (hello.txt) is in the inode table at block 35
    val off15: i64 = 35 * 1024 + 14 * 256;
    poke(&d4, off15 + 4, peek(&d4, off15 + 4) ^ 1);
    val bad: Ext4Fs = ext4_open(d4);
    val b15: Ext4Inode = ext4_inode(&bad, 15);
    var v2: Vfs = vfs_new();
    ext4_mount(&mut v2, "/", bad);
    println("corrupted inode 15: checksum ok " + bool_to_str(b15.csum_ok) + ", vfs stat " + vfs_errno_name(vfs_stat(&mut v2, "/hello.txt").err));

    val d2: BlockDev = disk_from_sparse(EXT2_IMG(), 128);
    poke(&d2, 1024 + 97, 128);
    println("unknown feature: " + ext4_open(d2).err);
    poke(&d2, 1024 + 56, 0);
    println("bad magic: " + ext4_open(d2).err);
    write_ext2();
    write_ext4();
    journal_tests();
}

// ─── Writing ──────────────────────────────────────────────────────────────

fn bytes_of(s: str) -> Vec<i64> {
    return str_bytes(s);
}

fn pattern(n: i64, seed: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        out.push((i * 7 + seed + i / 1024) & 255);
        i = i + 1;
    }
    return out;
}

fn same_bytes(a: & Vec<i64>, b: & Vec<i64>) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var i: i64 = 0;
    while i < a.len() {
        if a.get(i) != b.get(i) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn stat_of(fs: & Ext4Fs, path: str) -> Ext4Inode {
    return ext4_inode(fs, ext4_lookup(fs, path, false));
}

fn errno_of(r: i64) -> str {
    if r >= 0 {
        return "ok";
    }
    return vfs_errno_name(r);
}

fn counts(fs: & Ext4Fs) -> str {
    return int_to_str(fs.free_blocks) + " free blocks, " + int_to_str(fs.free_inodes) + " free inodes";
}

// Every inode in use has a good checksum, and every group's counts agree
// with its bitmaps.
fn audit(fs: & Ext4Fs) -> str {
    var bad: i64 = 0;
    var ino: i64 = 1;
    while ino <= fs.inodes_count {
        val n: Ext4Inode = ext4_inode(fs, ino);
        if n.mode != 0 && n.links > 0 && !n.csum_ok {
            bad = bad + 1;
        }
        ino = ino + 1;
    }
    var fb: i64 = 0;
    var fi: i64 = 0;
    var mism: i64 = 0;
    var g: i64 = 0;
    while g < fs.ngroups {
        val r: Ext4Group = ext4_group(fs, g);
        val bm: Vec<i64> = ext4_block(fs, r.block_bitmap);
        var free: i64 = 0;
        var i: i64 = 0;
        val nb: i64 = e4_min_t(fs.bpg, fs.blocks_count - fs.first_data_block - g * fs.bpg);
        while i < nb {
            if (bm.get(i / 8) & (1 << (i % 8))) == 0 {
                free = free + 1;
            }
            i = i + 1;
        }
        if free != r.free_blocks {
            mism = mism + 1;
        }
        val im: Vec<i64> = ext4_block(fs, r.inode_bitmap);
        var ifree: i64 = 0;
        i = 0;
        while i < fs.ipg {
            if (im.get(i / 8) & (1 << (i % 8))) == 0 {
                ifree = ifree + 1;
            }
            i = i + 1;
        }
        if ifree != r.free_inodes {
            mism = mism + 1;
        }
        fb = fb + r.free_blocks;
        fi = fi + r.free_inodes;
        g = g + 1;
    }
    return "bad inode checksums " + int_to_str(bad) + ", bitmap/count mismatches " + int_to_str(mism) + ", groups say " + int_to_str(fb) + "/" + int_to_str(fi) + " free";
}

fn e4_min_t(a: i64, b: i64) -> i64 {
    if a < b {
        return a;
    }
    return b;
}

fn write_ext2() {
    val d: BlockDev = disk_from_sparse(EXT2_IMG(), 128);
    var fs: Ext4Fs = ext4_open(d);
    println("ext2 writable " + bool_to_str(fs.writable) + ", " + counts(&fs));
    println("create /new.txt: " + errno_of(ext4_write_file(&mut fs, "/new.txt", bytes_of("written on ext2\n"))) + ", reads " + line_at(ext4_read_file(&mut fs, "/new.txt"), 0));
    val g14: Vec<i64> = pattern(14 * 1024 + 100, 3);
    ext4_write_file(&mut fs, "/grow.bin", g14);
    val gi: Ext4Inode = stat_of(&fs, "/grow.bin");
    println("/grow.bin: 15 blocks through the single indirect block, i_blocks " + int_to_str(gi.blocks) + ", same bytes " + bool_to_str(same_bytes(&g14, &ext4_read_file(&mut fs, "/grow.bin"))));
    // sparse writes reaching the double and triple indirect trees
    val before: i64 = fs.free_blocks;
    val far: i64 = ext4_create(&mut fs, EXT4_ROOT_INO, "far.bin", 420);
    ext4_write(&mut fs, far, 300 * 1024, bytes_of("dind"));
    ext4_write(&mut fs, far, 65804 * 1024 + 10, bytes_of("tind"));
    val fi: Ext4Inode = ext4_inode(&fs, far);
    println("/far.bin: size " + int_to_str(fi.size) + ", " + int_to_str(before - fs.free_blocks) + " blocks (2 data, 2 for the double tree, 3 for the triple), read back \"" + str_from_bytes(ext4_read(&fs, &fi, 300 * 1024, 4)) + "\" \"" + str_from_bytes(ext4_read(&fs, &fi, 65804 * 1024 + 10, 4)) + "\", hole byte " + int_to_str(ext4_read(&fs, &fi, 5000, 1).get(0)));
    ext4_truncate(&mut fs, far, 1000);
    println("  truncated to 1000: " + int_to_str(before - fs.free_blocks) + " blocks left, i_blocks " + int_to_str(ext4_inode(&fs, far).blocks));
    // directories, rename, links
    println("mkdir /dir2: " + errno_of(ext4_mkdir_path(&mut fs, "/dir2", 493)) + ", links of / " + int_to_str(ext4_inode(&fs, EXT4_ROOT_INO).links));
    ext4_write_file(&mut fs, "/dir2/a", bytes_of("A\n"));
    println("rename /dir2/a -> /docs/a2: " + errno_of(ext4_rename_path(&mut fs, "/dir2/a", "/docs/a2")) + ", /docs/a2 reads " + line_at(ext4_read_file(&mut fs, "/docs/a2"), 0));
    println("rename /dir2 -> /docs/dir2: " + errno_of(ext4_rename_path(&mut fs, "/dir2", "/docs/dir2")) + ", .. is /docs " + bool_to_str(ext4_lookup(&fs, "/docs/dir2/..", true) == ext4_lookup(&fs, "/docs", true)) + ", links / " + int_to_str(ext4_inode(&fs, EXT4_ROOT_INO).links) + " /docs " + int_to_str(stat_of(&fs, "/docs").links));
    println("rename /docs into itself: " + errno_of(ext4_rename_path(&mut fs, "/docs", "/docs/dir2/x")) + ", rmdir /docs: " + errno_of(ext4_rmdir_path(&mut fs, "/docs")) + ", unlink /docs: " + errno_of(ext4_unlink_path(&mut fs, "/docs")));
    val hl: i64 = ext4_link(&mut fs, ext4_lookup(&fs, "/hello.txt", true), EXT4_ROOT_INO, "hello2.txt");
    println("hard link /hello2.txt: " + errno_of(hl) + ", links " + int_to_str(stat_of(&fs, "/hello.txt").links) + ", reads " + line_at(ext4_read_file(&mut fs, "/hello2.txt"), 0));
    val fb0: i64 = fs.free_blocks;
    ext4_unlink_path(&mut fs, "/big.txt");
    println("unlink /big.txt: " + int_to_str(fs.free_blocks - fb0) + " blocks freed (15 data + 1 indirect), lookup " + vfs_errno_name(ext4_lookup(&fs, "/big.txt", true)));
    ext4_symlink_path(&mut fs, "docs/a2", "/short");
    ext4_symlink_path(&mut fs, str_repeat("../docs/", 10) + "a2", "/long");
    println("symlinks: /short -> " + ext4_readlink(&fs, &stat_of(&fs, "/short")) + " reads " + line_at(ext4_read_file(&mut fs, "/short"), 0) + ", /long (" + int_to_str(stat_of(&fs, "/long").size) + " bytes, slow) reads " + line_at(ext4_read_file(&mut fs, "/long"), 0));
    println("rmdir /docs/dir2: " + errno_of(ext4_rmdir_path(&mut fs, "/docs/dir2")) + ", links /docs " + int_to_str(stat_of(&fs, "/docs").links) + ", " + counts(&fs));
    // fill the inodes
    var made: i64 = 0;
    var r: i64 = 0;
    while r >= 0 && made < 50 {
        r = ext4_create(&mut fs, EXT4_ROOT_INO, "f" + int_to_str(made), 420);
        if r >= 0 {
            made = made + 1;
        }
    }
    println("created until " + vfs_errno_name(r) + ": " + int_to_str(made) + " files");
    var k: i64 = 0;
    while k < made {
        ext4_unlink(&mut fs, EXT4_ROOT_INO, "f" + int_to_str(k));
        k = k + 1;
    }
    // e2fsck: ext2
    val again: Ext4Fs = ext4_open(d);
    println("reopened: " + str_join(names(&again, "/"), " ") + "; " + counts(&again) + "; " + audit(&again));
    println("  /docs: " + str_join(names(&again, "/docs"), " "));
}

fn write_ext4() {
    val d: BlockDev = disk_from_sparse(EXT4_IMG(), 256);
    var fs: Ext4Fs = ext4_open(d);
    val start_free: i64 = fs.free_blocks;
    println("ext4 writable " + bool_to_str(fs.writable) + ", " + counts(&fs));
    // fragmented: one block at every other logical block
    val fr: i64 = ext4_create(&mut fs, EXT4_ROOT_INO, "frag.bin", 420);
    var lb: i64 = 0;
    while lb < 18 {
        ext4_write(&mut fs, fr, lb * 1024, bytes_of("x" + int_to_str(lb)));
        lb = lb + 2;
    }
    val fn1: Ext4Inode = ext4_inode(&fs, fr);
    println("/frag.bin: " + int_to_str(ext4_extents(&fs, &fn1).len() / 4) + " extents, depth " + int_to_str(e4_depth(&fn1)) + ", i_blocks " + int_to_str(fn1.blocks) + ", block 16 reads " + line_at(ext4_read(&fs, &fn1, 16 * 1024, 4), 0));
    // 90 extents: the leaf splits
    val sp: i64 = ext4_create(&mut fs, EXT4_ROOT_INO, "split.bin", 420);
    lb = 0;
    while lb < 180 {
        ext4_write(&mut fs, sp, lb * 1024 + 1, bytes_of("s"));
        lb = lb + 2;
    }
    val sn: Ext4Inode = ext4_inode(&fs, sp);
    println("/split.bin: " + int_to_str(ext4_extents(&fs, &sn).len() / 4) + " extents, depth " + int_to_str(e4_depth(&sn)) + ", root entries " + int_to_str(sn.iblock.get(2)) + ", tree blocks " + int_to_str(ext4_extent_tree_blocks(&fs, &sn).len()) + ", i_blocks " + int_to_str(sn.blocks) + ", byte at 178K+1 " + str_from_bytes(ext4_read(&fs, &sn, 178 * 1024 + 1, 1)));
    ext4_truncate(&mut fs, sp, 100 * 1024);
    val sn2: Ext4Inode = ext4_inode(&fs, sp);
    println("  truncated to 100 KiB: " + int_to_str(ext4_extents(&fs, &sn2).len() / 4) + " extents, depth " + int_to_str(e4_depth(&sn2)) + ", i_blocks " + int_to_str(sn2.blocks));
    // overwrite in place and append
    ext4_write(&mut fs, fr, 1, bytes_of("YZ"));
    ext4_write(&mut fs, fr, 18 * 1024, bytes_of("tail"));
    val fn2: Ext4Inode = ext4_inode(&fs, fr);
    println("/frag.bin overwritten and appended: " + line_at(ext4_read(&fs, &fn2, 0, 8), 0) + " / " + line_at(ext4_read(&fs, &fn2, 18 * 1024, 8), 0) + ", " + int_to_str(ext4_extents(&fs, &fn2).len() / 4) + " extents, size " + int_to_str(fn2.size));
    // directories with checksums
    var i: i64 = 0;
    while i < 6 {
        ext4_write_file(&mut fs, "/many/added_file_with_another_long_name_" + int_to_str(i), bytes_of(int_to_str(i)));
        i = i + 1;
    }
    val mn: Ext4Inode = stat_of(&fs, "/many");
    println("/many: " + int_to_str(names(&fs, "/many").len()) + " entries in " + int_to_str(mn.size / 1024) + " blocks, added_..._5 reads " + line_at(ext4_read_file(&mut fs, "/many/added_file_with_another_long_name_5"), 0));
    println("rename /many/file_with_a_fairly_long_name_number_1 -> /renamed: " + errno_of(ext4_rename_path(&mut fs, "/many/file_with_a_fairly_long_name_number_1", "/renamed")) + ", replace /hello.txt by /renamed: " + errno_of(ext4_rename_path(&mut fs, "/renamed", "/hello.txt")) + ", /hello.txt reads " + line_at(ext4_read_file(&mut fs, "/hello.txt"), 0));
    // through the vfs
    var v: Vfs = vfs_new();
    vfs_mount(&mut v, "/", ramfs_ops(), ramfs_new());
    vfs_mkdir(&mut v, "/mnt", 493);
    val h: i64 = ext4_mount(&mut v, "/mnt", fs);
    println("vfs: mkdir " + errno_of(vfs_mkdir(&mut v, "/mnt/vdir", 493)) + ", write " + errno_of(vfs_write_file(&mut v, "/mnt/vdir/v.txt", bytes_of("through the vfs\n"))) + ", rename " + errno_of(vfs_rename(&mut v, "/mnt/vdir/v.txt", "/mnt/v.txt")) + ", truncate " + errno_of(vfs_truncate(&mut v, "/mnt/v.txt", 7)) + ", reads " + str_from_bytes(vfs_read_file(&mut v, "/mnt/v.txt")) + ", rmdir " + errno_of(vfs_rmdir(&mut v, "/mnt/vdir")) + ", unlink " + errno_of(vfs_unlink(&mut v, "/mnt/link")));
    fs = ext4_mounted(h);
    // fill the disk, then free it again
    val big: i64 = ext4_create(&mut fs, EXT4_ROOT_INO, "fill.bin", 420);
    val wrote: i64 = ext4_write(&mut fs, big, 0, pattern(400 * 1024, 1));
    val bn: Ext4Inode = ext4_inode(&fs, big);
    println("fill: wrote " + int_to_str(wrote / 1024) + " KiB of 400, free blocks " + int_to_str(fs.free_blocks) + ", another write " + errno_of(ext4_write(&mut fs, fr, 40 * 1024, bytes_of("z"))) + ", extents " + int_to_str(ext4_extents(&fs, &bn).len() / 4) + ", same bytes " + bool_to_str(same_bytes(&ext4_read(&fs, &bn, 0, wrote), &pattern(wrote, 1))));
    ext4_unlink_path(&mut fs, "/fill.bin");
    ext4_unlink_path(&mut fs, "/split.bin");
    ext4_unlink_path(&mut fs, "/frag.bin");
    println("after unlinking them: " + int_to_str(fs.free_blocks - start_free) + " blocks from the start");
    // e2fsck: ext4
    val again: Ext4Fs = ext4_open(d);
    println("reopened: superblock checksum " + bool_to_str(again.sb_csum_ok) + ", " + counts(&again) + "; " + audit(&again));
    println("  /: " + str_join(names(&again, "/"), " "));
}

fn journal_tests() {
    val d: BlockDev = disk_from_sparse(JRN_IMG(), 3072);
    val ro: Ext4Fs = ext4_open_opts(d, false);
    var rof: Ext4Fs = ro;
    println("journal image without recovery: writable " + bool_to_str(ro.writable) + " (" + ro.ro_reason + "), write " + errno_of(ext4_write_file(&mut rof, "/x", bytes_of("x"))) + ", /note.txt " + line_at(ext4_read_file(&mut rof, "/note.txt"), 0));
    var fs: Ext4Fs = ext4_open(d);
    println("recovered: " + bool_to_str(fs.recovered) + ", " + int_to_str(fs.replayed_transactions) + " transactions, " + int_to_str(fs.replayed_blocks) + " blocks replayed, " + int_to_str(fs.revoked_blocks) + " revoked, bad checksums " + int_to_str(fs.journal_bad_checksums) + ", writable " + bool_to_str(fs.writable));
    println("  /note.txt " + line_at(ext4_read_file(&mut fs, "/note.txt"), 0) + ", block 2000 " + hex_encode_bytes(e4_first(ext4_block(&fs, 2000), 6)) + " (escaped magic restored), block 2002 " + hex_encode_bytes(e4_first(ext4_block(&fs, 2002), 4)) + " (revoked), block 2003 " + line_at(ext4_block(&fs, 2003), 0));
    val jn: Ext4Inode = ext4_inode(&fs, 8);
    val jsb: Vec<i64> = ext4_block(&fs, ext4_block_map(&fs, &jn).get(0));
    println("  journal start " + int_to_str(be32(&jsb, 28)) + ", sequence " + int_to_str(be32(&jsb, 24)) + ", needs_recovery " + bool_to_str((fs.incompat & 4) != 0) + ", second open recovers again " + bool_to_str(ext4_open(d).recovered));
    // an htree directory written to
    val bi: Ext4Inode = stat_of(&fs, "/big");
    println("/big: indexed " + bool_to_str((bi.flags & 4096) != 0) + ", " + int_to_str(names(&fs, "/big").len()) + " entries");
    ext4_write_file(&mut fs, "/big/added", bytes_of("added to an htree directory\n"));
    ext4_unlink_path(&mut fs, "/big/entry_with_a_long_name_5");
    val bi2: Ext4Inode = stat_of(&fs, "/big");
    println("  after a create and an unlink: indexed " + bool_to_str((bi2.flags & 4096) != 0) + ", " + int_to_str(names(&fs, "/big").len()) + " entries, entry_with_a_long_name_70 reads " + line_at(ext4_read_file(&mut fs, "/big/entry_with_a_long_name_70"), 0) + ", added reads " + line_at(ext4_read_file(&mut fs, "/big/added"), 0));
    // a tree of depth 2
    val dp: i64 = ext4_create(&mut fs, EXT4_ROOT_INO, "deep.bin", 420);
    val free0: i64 = fs.free_blocks;
    var lb: i64 = 0;
    while lb < 800 {
        ext4_write(&mut fs, dp, lb * 1024, bytes_of("d"));
        lb = lb + 2;
    }
    val dn: Ext4Inode = ext4_inode(&fs, dp);
    println("/deep.bin: " + int_to_str(ext4_extents(&fs, &dn).len() / 4) + " extents, depth " + int_to_str(e4_depth(&dn)) + ", tree blocks " + int_to_str(ext4_extent_tree_blocks(&fs, &dn).len()) + ", " + int_to_str(free0 - fs.free_blocks) + " blocks used, byte at 798K " + str_from_bytes(ext4_read(&fs, &dn, 798 * 1024, 1)));
    ext4_truncate(&mut fs, dp, 300 * 1024);
    val dn2: Ext4Inode = ext4_inode(&fs, dp);
    println("  truncated to 300 KiB: " + int_to_str(ext4_extents(&fs, &dn2).len() / 4) + " extents, depth " + int_to_str(e4_depth(&dn2)) + ", " + int_to_str(free0 - fs.free_blocks) + " blocks used");
    ext4_mkdir_path(&mut fs, "/newdir", 493);
    ext4_write_file(&mut fs, "/newdir/inside", bytes_of("inside\n"));
    // e2fsck: journal
    val again: Ext4Fs = ext4_open(d);
    println("reopened: recovered " + bool_to_str(again.recovered) + ", " + counts(&again) + "; " + audit(&again));
    // a damaged commit block ends the log: transaction 4 is not replayed
    val d2: BlockDev = disk_from_sparse(JRN_IMG(), 3072);
    val j0: Ext4Fs = ext4_open_opts(d2, false);
    val jn0: Ext4Inode = ext4_inode(&j0, 8);
    val commit4: i64 = ext4_block_map(&j0, &jn0).get(12);
    poke(&d2, commit4 * 1024 + 100, 1);
    var f2: Ext4Fs = ext4_open(d2);
    println("bad commit checksum in transaction 4: " + int_to_str(f2.replayed_transactions) + " transactions, " + int_to_str(f2.replayed_blocks) + " blocks, block 2003 " + hex_encode_bytes(e4_first(ext4_block(&f2, 2003), 4)) + ", /note.txt " + line_at(ext4_read_file(&mut f2, "/note.txt"), 0));
    // no journal but needs_recovery
    val d3: BlockDev = disk_from_sparse(EXT2_IMG(), 128);
    poke(&d3, 1024 + 96, peek(&d3, 1024 + 96) | 4);
    println("needs_recovery without a journal: " + ext4_open(d3).err);
}

fn e4_first(b: Vec<i64>, n: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n && i < b.len() {
        out.push(b.get(i));
        i = i + 1;
    }
    return out;
}

fn be32(b: & Vec<i64>, o: i64) -> i64 {
    return ((b.get(o) * 256 + b.get(o + 1)) * 256 + b.get(o + 2)) * 256 + b.get(o + 3);
}

// A 3 MiB ext4 image with a journal, made in WSL with e2fsprogs 1.47.4:
//   mkdir -p root/big; echo "journal test" > root/note.txt
//   for i in $(seq 1 70); do echo "f$i" > root/big/entry_with_a_long_name_$i; done
//   mke2fs -q -F -t ext4 -b 1024 -L fides-j -U 11111111-2222-3333-4444-555555555555 //     -E hash_seed=11111111-2222-3333-4444-555555555555,lazy_itable_init=0 -J size=1 -N 128 -d root j.img 3072
//   e2fsck -fyD j.img            (indexes /big: an htree directory)
//   debugfs -w -f cmds j.img     with cmds: jo -c / jw -b 1203,2000 t1.blk / jw -b 2002 x.blk /
//                                jw -r 2002 /dev/null / jw -b 2003 y.blk / jc
// (t1.blk: "replayed by the journal" for /note.txt's block 1203, then a block
// starting with the jbd2 magic, logged escaped; x.blk "revoked: must not
// appear"; y.blk "third transaction"). The image needs recovery; e2fsck -fy
// replays it to the same blocks the test reads. "offset:hex" runs of
// non-zero bytes.
fn JRN_IMG() -> str {
    return "1024:80000000000c0000990000004b0700002c00000001;1057:2000000020000080;1072:6755fc6a0000ffff53ef01000" +
        "10000000d55fc6a;1100:01;1108:0b000000000100003c100000c62200006b0400001111111122223333444455555555555" +
