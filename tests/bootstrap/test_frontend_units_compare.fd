// CL10 (fid): `<`, `<=`, `>`, `>=` on two values of one unit compare the
// f64 each holds (before, two structs compared their addresses); `==`
// compares contents as on any struct. `-d` is the same unit negated.
// Expected output:
// less
// not greater
// at most
// at least
// equal
// -2
// 3
// 3

@dimension(m = 1)
struct Len {
    value: f64,
}

fn longest(v: Vec<Len>) -> i64 {
    var best: i64 = 0;
    var i: i64 = 1;
    while i < v.len() {
        if v.get(i) > v.get(best) {
            best = i;
        }
        i = i + 1;
    }
    return best;
}

fn main() -> i64 {
    // b is declared first: its struct may sit below a's in memory
    val b: Len = Len { value: 5.0 };
    val a: Len = Len { value: 2.0 };
    if a < b {
        println("less");
    }
    if !(a > b) {
        println("not greater");
    }
    val two: Len = Len { value: 2.0 };
    if a <= two {
        println("at most");
    }
    if b >= a {
        println("at least");
    }
    if a == two {
        println("equal");
    }
    val n: Len = -a;
    println(int_to_str(n.value as i64));
    val back: Len = b + -a;
    println(int_to_str(back.value as i64));
    var v: Vec<Len> = Vec::new();
    v.push(Len { value: 1.0 });
    v.push(Len { value: 4.0 });
    v.push(Len { value: 3.0 });
    v.push(Len { value: 9.0 });
    v.push(Len { value: 2.0 });
    println(longest(v));
    return 0;
}
