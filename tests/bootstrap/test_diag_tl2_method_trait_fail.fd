// expect-error: no method 'perimeter' on trait 'Shape'
//! error: no method 'perimeter' on trait 'Shape'
// TL2: a test per diagnostic of the type, borrow and escape checks.
// A `dyn Trait` value has only the trait's methods.

cap Shape {
    fn area(self) -> i64;
}

struct Sq {
    s: i64,
}

impl Shape for Sq {
    fn area(self) -> i64 {
        return self.s * self.s;
    }
}

fn main() -> i64 {
    val q: Sq = Sq { s: 2 };
    val d = q as dyn Shape;
    println(d.perimeter());
    return 0;
}
