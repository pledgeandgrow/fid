// known-bugs 2g.66: a Vec.map whose function returns another element type
// (str -> i64) gives a Vec of what the function returns. With `use vec;`
// (Vec's map is stdlib/vec.fd's) it runs on every backend.
// Expected output:
// 3
// 1 3 5
// 10
// 2
use vec;

fn size(w: str) -> i64 {
    return str_len(w);
}

fn main() {
    var words: Vec<str> = Vec::new();
    words.push("a");
    words.push("bcd");
    words.push("efghi");
    var lens: Vec<i64> = words.map(size);
    println(int_to_str(lens.len()));
    println(int_to_str(lens.get(0)) + " " + int_to_str(lens.get(1)) + " " + int_to_str(lens.get(2)));
    var total: i64 = lens.get(0) + lens.get(1) + lens.get(2) + 1;
    println(int_to_str(total));
    var nums: Vec<i64> = Vec::new();
    nums.push(1);
    var dbl: Vec<i64> = nums.map(fn(x: i64) -> i64 { return x * 2; });
    println(int_to_str(dbl.get(0)));
}
