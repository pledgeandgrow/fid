// A library the machine does not have (release E4). `fid emit` warns when
// it builds this; the program runs ("main ran") until its first call into
// the library, which stops it with, on stderr:
//
//   error: this program needs fides_no_such_lib.dll, which Windows could not load.
//     Install the library, or put fides_no_such_lib.dll beside the program or in a folder on PATH.
//
// and exit code 1, where a static import would make Windows refuse to start
// it at all, with no message on a console. `fid ccompile` fails at link time
// (no fides_no_such_lib library). Expected to fail on every backend.
extern "C" link "fides_no_such_lib" {
    fn fides_no_such_fn as no_such_fn(x: i64) -> i64;
}

@unsafe
fn main() -> i64 {
    println("main ran");
    println(no_such_fn(1));
    return 0;
}
