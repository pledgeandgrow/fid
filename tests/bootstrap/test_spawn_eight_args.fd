// Bugs roadmap BG159: a function started by name as a thread or a task
// gets its arguments through the task's block, which holds 8 on every
// compiled backend. Eight arguments, the most there is room for, reach the
// thread, the async task and a `parallel` branch in order on every backend
// (a ninth is refused by `check`: test_spawn_nine_args_fail and the two
// beside it).
//
// Expected output:
// 87654321
// 87654321
// 87654321
// 87654321
fn w8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    return a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000 + h * 10000000;
}

async fn t8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> Future<i64> {
    return a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000 + h * 10000000;
}

fn main() -> i64 {
    println(w8(1, 2, 3, 4, 5, 6, 7, 8));
    val t = spawn w8(1, 2, 3, 4, 5, 6, 7, 8);
    println(await t);
    println(await t8(1, 2, 3, 4, 5, 6, 7, 8));
    var x: i64 = 0;
    var y: i64 = 0;
    parallel {
        | x = w8(1, 2, 3, 4, 5, 6, 7, 8);
        | y = w8(0, 0, 0, 0, 0, 0, 0, 0);
    }
    println(x + y);
    return 0;
}
