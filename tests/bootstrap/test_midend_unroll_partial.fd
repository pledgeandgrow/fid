// ME24 partial unrolling (compiler/iropt_me.fd ime_unroll_one, opt-in:
// FID_IROPT_ON=unroll on the native paths). A loop of one header and one
// body block with a trip count known on entry, more than 8 and a multiple
// of 4 (or 2), keeps its header and runs 4 (or 2) copies of its body per
// test. Every result must be what the loop computes without it; the loops
// of 3 and 5 trips below are unrolled fully, the 9-trip one not at all.
//
// Expected output:
// 66
// 240
// 285
// 60
// 12
// 198
// 12
// 3
// 10
// 36

fn sum12() -> i64 {
    // 12 trips: by 4
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 12 {
        t = t + i;
        i = i + 1;
    }
    return t;
}

fn evens16() -> i64 {
    // step 2, 16 trips: by 4
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 32 {
        t = t + i;
        i = i + 2;
    }
    return t;
}

fn squares10() -> i64 {
    // `<=`, 10 trips: by 2
    var t: i64 = 0;
    var i: i64 = 0;
    while i <= 9 {
        t = t + i * i;
        i = i + 1;
    }
    return t;
}

fn ne20() -> i64 {
    // `!=`, 20 trips: by 4
    var t: i64 = 0;
    var i: i64 = 0;
    while i != 20 {
        t = t + 3;
        i = i + 1;
    }
    return t;
}

fn small3() -> i64 {
    // 3 trips: fully unrolled
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 3 {
        t = t + 1;
        i = i + 1;
    }
    return t;
}

fn small5() -> i64 {
    // 5 trips: fully unrolled
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 5 {
        t = t + 2;
        i = i + 1;
    }
    return t;
}

fn odd9() -> i64 {
    // 9 trips: neither factor divides it, so the loop stays
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 9 {
        t = t + 4;
        i = i + 1;
    }
    return t;
}

fn main() -> i64 {
    print(sum12());
    print("\n");
    print(evens16());
    print("\n");
    print(squares10());
    print("\n");
    print(ne20());
    print("\n");
    // a body with calls: the pushes run in order, 12 of them
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 12 {
        v.push(i * 3);
        i = i + 1;
    }
    print(v.len());
    print("\n");
    var s: i64 = 0;
    var j: i64 = 0;
    while j < v.len() {
        s = s + v.get(j);
        j = j + 1;
    }
    print(s);
    print("\n");
    // the counter after the loop holds its last value
    print(i);
    print("\n");
    print(small3());
    print("\n");
    print(small5());
    print("\n");
    print(odd9());
    print("\n");
    return 0;
}
