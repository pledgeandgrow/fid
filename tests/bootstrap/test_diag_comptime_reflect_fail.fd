// expect-error: field_count_of() reads the program's declarations while compiling: call it in comptime code.
// expect-error: field_names_of() reads the program's declarations while compiling: call it in comptime code.
// The comptime reflection builtins (field_count_of, field_names_of,
// field_annotations, struct_annotations) read the program's declarations,
// so they may only run in comptime code.
struct P { x: i64, y: i64 }
fn main() -> i64 {
    val n: i64 = field_count_of("P");
    val names: Vec<str> = field_names_of("P");
    println(n);
    return 0;
}
