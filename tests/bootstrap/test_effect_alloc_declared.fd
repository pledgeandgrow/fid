// known-bugs 2g.65: Vec::new, push, string `+` and f-strings infer the
// Alloc effect. A function that declares it (`!Alloc`, `!{IO, Alloc}`) is
// accepted; `!{}` stays usable for code that allocates nothing, including a
// call of a user method named `push` (a user type's method is not a Vec's).
// Expected output:
// 3
// hello, effects!
// n = 7
// 6
// 5
struct Tally {
    total: i64,
}

impl Tally {
    fn push(self: &mut Tally, x: i64) {
        self.total = self.total + x;
    }
}

fn make() -> i64 !Alloc {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    return v.len();
}

fn greet(name: str) -> str !{Alloc} {
    var s: str = "hello, " + name;
    s += "!";
    return s;
}

fn show(n: i64) !{IO, Alloc} {
    println(f"n = {n}");
}

fn tally3() -> i64 !{} {
    var t: Tally = Tally { total: 0 };
    t.push(1);
    t.push(2);
    t.push(3);
    return t.total;
}

fn add(a: i64, b: i64) -> i64 !{} {
    return a + b;
}

fn main() {
    println(int_to_str(make()));
    println(greet("effects"));
    show(7);
    println(int_to_str(tally3()));
    println(int_to_str(add(2, 3)));
}
