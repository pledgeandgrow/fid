// Translation validation (compiler/tv.fd, llvm-roadmap RL5, competitive
// roadmap VF6): with FID_VALIDATE=1 (or --validate) every iropt pass that
// changes a function, and the SSA round trip, is checked against the
// function before it (witnesses for fold, dce, gvn and ssa; random inputs
// for any pass the evaluator can run) and a rejected result is undone. The
// program must print the same with validation on; the checker's report
// goes to stderr ("tv: N pass results checked, ..."). Native `emit` only
// (`run` and the C path run no IR optimizer).
//@ env: FID_IROPT_ON=ssa,ssaexit
//@ env: FID_VALIDATE=1
//
// Expected output:
// 30
// 7
// 1
// 120
// 45
// -6

fn fold_me() -> i64 {
    // fold: 2 * 3 * 5 at compile time
    var a: i64 = 2;
    var b: i64 = a * 3;
    return b * 5;
}

fn gvn_me(x: i64, y: i64) -> i64 {
    // gvn: x + y once
    var p: i64 = x + y;
    var q: i64 = x + y;
    return p * q - (x + y) * (x + y) + p;
}

fn clamp(v: i64, lo: i64, hi: i64) -> i64 {
    var r: i64 = v;
    if r < lo {
        r = lo;
    }
    if r > hi {
        r = hi;
    }
    return r;
}

fn fact(n: i64) -> i64 {
    var acc: i64 = 1;
    var i: i64 = 1;
    while i <= n {
        acc = acc * i;
        i = i + 1;
    }
    return acc;
}

fn tri() -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < 10 {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fn neg_sum(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        s = s - i;
        i = i + 1;
    }
    return s;
}

fn main() -> i64 {
    println(fold_me());
    println(gvn_me(3, 4));
    println(clamp(-5, 1, 9));
    println(fact(5));
    println(tri());
    println(neg_sum(3));
    return 0;
}
