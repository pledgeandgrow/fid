// Test (stdlib-agent bug 22): a function returning Result called through
// an unannotated variable (`val g = cntr;`). The arguments were shifted by
// one (Vec_len panicked "Integer overflow on addition"): the variable had
// no type, and a Result comes back through the caller's memory. Also run
// it through `fid ccompile`.
// Expected output:
// ok 2
// err empty
// some 5
fn cntr(ms: Vec<i64>) -> Result<i64, str> {
    if ms.len() == 0 {
        return Result::Err("empty");
    }
    return Result::Ok(ms.len());
}

fn half(n: i64) -> Option<i64> {
    if n % 2 == 1 {
        return Option::None;
    }
    return Option::Some(n / 2);
}

fn report(r: Result<i64, str>) {
    match r {
        Result::Ok(n) => {
            println("ok " + int_to_str(n));
        }
        Result::Err(e) => {
            println("err " + e);
        }
    }
}

fn main() {
    var d: Vec<i64> = Vec::new();
    d.push(1);
    d.push(2);
    val g = cntr;
    report(g(d));
    val e: Vec<i64> = Vec::new();
    report(g(e));
    val h = half;
    match h(10) {
        Option::Some(x) => {
            println("some " + int_to_str(x));
        }
        Option::None => {
            println("none");
        }
    }
}
