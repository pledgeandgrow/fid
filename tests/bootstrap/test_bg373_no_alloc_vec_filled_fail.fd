// expect-error: is @no-alloc but calls 'Vec_filled'
// Bugs roadmap BG373: `Vec::filled(n, x)` allocates a Vec of n elements,
// yet a @no-alloc function calling it was accepted (the call is recorded as
// "Vec_filled", which the list of allocating builtins did not name).
@no-alloc
fn f(x: i64) -> i64 {
    val v = Vec::filled(100, 0);
    return v.len() + x;
}
fn main() -> i64 { println(f(1)); return 0; }
