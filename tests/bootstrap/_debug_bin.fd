use core;
use vec;
use file;

fn main() -> i64 {
    val bytes = Vec::new();
    bytes.push(0x50);
    bytes.push(0x00);
    bytes.push(0xFF);
    println(bytes.len());
    val rc = file_write_bytes("_dbg.tmp", bytes);
    println(rc);
    val sz = file_size("_dbg.tmp");
    println(sz);
    val back = file_read_bytes("_dbg.tmp");
    println(back.len());
    var i: i64 = 0;
    while i < back.len() {
        println(back.get(i));
        i = i + 1;
    }
    val drc = file_delete("_dbg.tmp");
    println(drc);
    return 0;
}
