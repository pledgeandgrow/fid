// expect-error: 'v' is a by-value parameter of 'add_one' and cannot be changed
//! error: 'v' is a by-value parameter of 'add_one' and cannot be changed
// TL2: a test per diagnostic of the type, borrow and escape checks.
// A by-value Vec parameter is the caller's: changing it is refused.

fn add_one(v: Vec<i64>) {
    v.push(1);
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    add_one(v);
    println(v.len());
    return 0;
}
