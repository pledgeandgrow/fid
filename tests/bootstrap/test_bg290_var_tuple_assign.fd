// Bugs roadmap BG290: `val (a, b) = t` now binds vals; `var (a, b) = t`
// stays assignable, and a `var (x, ..)` shadowing an outer `val x` makes
// that x assignable (as `var x` does).
//
// Expected output:
// 10
// 7
// 3
// 100
fn main() -> i64 {
    var (a, b) = (1, 2);
    a = 10;
    b += 5;
    println(a);
    println(b);
    val x = 1;
    val (p, q) = (x, 2);
    println(p + q);
    {
        var (x, y) = (5, 6);
        x = 100;
        y = y + 1;
        println(x);
    }
    return 0;
}
