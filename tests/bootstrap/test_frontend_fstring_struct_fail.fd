// expect-error: an f-string cannot show a value of struct type 'Point'
// CL8: f-string interpolation is checked at compile time. A struct has no
// text form: the lowering read its address as the bytes of a string.

struct Point {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    val p = Point { x: 1, y: 2 };
    println(f"p = {p}");
    return 0;
}
