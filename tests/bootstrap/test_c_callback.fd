// C calls Fides functions: qsort takes a Fides comparison, and so does bsearch.
// A function may come after its use, and the four-byte result reaches C intact.
extern "C" include "<stdlib.h>" {
    fn qsort as c_qsort(base: *u8, n: i64, size: i64, cmp: fn(*u8, *u8) -> i32);
    fn bsearch as c_bsearch(key: *u8, base: *u8, n: i64, size: i64, cmp: fn(*u8, *u8) -> i32) -> *u8;
}

@unsafe
fn slot(base: *u8, i: i64) -> *i64 {
    return (base as i64 + i * 8) as *i64;
}

@unsafe
fn main() -> i64 {
    val base: *u8 = p_malloc(40);
    var i: i64 = 0;
    while i < 5 {
        *slot(base, i) = (7 * i + 3) % 5;
        i = i + 1;
    }
    c_qsort(base, 5, 8, descending);
    i = 0;
    while i < 5 {
        print(*slot(base, i));
        i = i + 1;
    }
    c_qsort(base, 5, 8, ascending);
    val key: *u8 = p_malloc(8);
    *(key as *i64) = 3;
    val found: *u8 = c_bsearch(key, base, 5, 8, ascending);
    print((found as i64 - base as i64) / 8);
    p_free(key);
    p_free(base);
    return 0;
}

@unsafe
fn ascending(a: *u8, b: *u8) -> i32 {
    val x: i64 = *(a as *i64);
    val y: i64 = *(b as *i64);
    if x < y { return -1; }
    if x > y { return 1; }
    return 0;
}

@unsafe
fn descending(a: *u8, b: *u8) -> i32 {
    return ascending(b, a);
}
