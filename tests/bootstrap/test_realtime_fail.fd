// test_realtime_fail.fd — Real-Time Effect Enforcement (violation)
// Expected: FAIL (compile error — @realtime function calls malloc)
// @realtime functions cannot allocate memory — allocation has
// non-deterministic timing.

@realtime
fn bad_rt_process(size: i64) -> i64 {
    // ERROR: Vec::new() allocates on the heap — forbidden in @realtime
    val buf = Vec::new();
    buf.push(42);
    return buf.len();
}

fn main() {
    val x = bad_rt_process(10);
    print(x);
    return 0;
}
