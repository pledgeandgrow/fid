// Test (known-bugs 2g.3): copying a struct copies its Vec fields too
// (copy-on-write): changing the copy leaves the original alone.
//
// Expected output:
// 1 2 1
// 1 9
struct S { a: i64, v: Vec<i64> }

fn main() -> i64 {
    var s = S { a: 1, v: Vec::new() };
    s.v.push(1);
    var t = s;
    t.v.push(2);
    t.a = 5;
    println(int_to_str(s.v.len()) + " " + int_to_str(t.v.len()) + " " + int_to_str(s.a));
    var u = s;
    u.v.set(0, 9);
    println(int_to_str(s.v.get(0)) + " " + int_to_str(u.v.get(0)));
    return 0;
}
