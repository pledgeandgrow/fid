// expect-error: which is not @send
// Bugs roadmap BG188: `Option::Some(h)` with `h` holding a raw pointer was
// sent to a task.
struct Handle {
    p: *mut i64,
}

fn work(h: Option<Handle>) -> i64 {
    return 1;
}

fn main() {
    val h: Handle = Handle { p: 0 as *mut i64 };
    val t = spawn work(Option::Some(h));
    println(await t);
}
