use log;

fn main() -> i64 {
    // text format, no timestamps (deterministic output)
    log_set_level(LOG_DEBUG);

    log_trace("hidden");                  // below level — not printed
    log_debug("booting");
    log_info("server up");

    var f = Vec::new();
    f.push("port"); f.push("8080");
    f.push("host"); f.push("local host"); // value with space -> quoted
    log_infof("listening", f);

    log_set_level(LOG_ERROR);
    log_warn("suppressed");               // not printed
    log_error("disk full");

    // JSON lines
    log_set_level(LOG_TRACE);
    log_set_json(true);
    var g = Vec::new();
    g.push("user"); g.push("ad \"min\""); // escaping exercised
    g.push("attempts"); g.push("3");      // numeric stays unquoted
    g.push("cached"); g.push("true");     // bool stays unquoted
    log_infof("login", g);
    log_warn("plain warning");

    // level parsing
    print(log_level_from_str("WARN"));
    print(log_level_from_str("debug"));
    print(log_level_from_str("nope"));

    return 0;
}
