// VF5: global value numbering (compiler/iropt.fd iro_gvn). A pure value
// computed in a dominating block may be reused; one computed in only one
// branch may not be reused after the join, and a read of a local or a
// Vec's length may not be reused across a write to it. Each case prints a
// value that differs when the wrong computation is reused.

fn main() -> i64 {
    var a: i64 = 6;
    var b: i64 = 7;
    val x1: i64 = a * b + 1;
    val x2: i64 = a * b + 1;
    println(x1 + x2);

    // the same expression after `a` changes
    a = 10;
    val x3: i64 = a * b + 1;
    println(x3);

    // computed in one branch only
    var r: i64 = 0;
    if b > 100 {
        r = a * b;
    }
    val after: i64 = a * b;
    println(r + after);

    // a Vec's length across a push
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    val l1: i64 = v.len();
    v.push(3);
    val l2: i64 = v.len();
    println(l1 * 10 + l2);

    // loads of an element across a set
    val e1: i64 = v.get(0);
    v.set(0, 99);
    val e2: i64 = v.get(0);
    println(e1 + e2);

    // in a loop: the expression changes every iteration
    var s: i64 = 0;
    var i: i64 = 0;
    while i < 10 {
        val q: i64 = i * b;
        s = s + q + i * b;
        i = i + 1;
    }
    println(s);

    // narrow types: the same bits, other types
    val u: u8 = 200;
    val w1: i64 = (u as i64) + 1;
    val w2: i64 = (u as i64) + 1;
    println(w1 + w2);
    return 0;
}
