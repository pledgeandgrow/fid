// L3C: Compile-time data race safety
// Functions with !{} (no effects) cannot spawn threads
// @send types can be safely sent to other threads
// @sync types can be safely shared via &T

fn pure_fn(x: i64) -> i64 !{} {
    // No IO, no Spawn, no Alloc — pure computation
    x * 2
}

fn main() {
    val result = pure_fn(21);
    println(result);

    // Channels are @send + @sync (internal synchronization)
    val ch = p_chan_create(1);
    p_chan_send(ch, 42);
    val v = p_chan_recv(ch);
    println(v);
}
