// iropt promote (compiler/iropt.fd iro_promote) replaces a load of a local
// with the value last stored to it only when both have the same IR type. A
// u64 local stored from an integer literal holds an i64-typed constant; the
// load is u64. Replacing it made `u > 1` and `u / 2` signed on every native
// target (and the e-graph then folded them as signed): u is 2^64 - 1, which
// is -1 as an i64. The same for u32 / u8 locals and a u64 that a branch
// stores on one path only.
//
// Expected output:
// 18446744073709551615
// 9223372036854775807
// 5
// 15
// 1
// 2147483647
// 125
// 1
// 9223372036854775807

fn pick(flag: bool) -> u64 {
    var u: u64 = 18446744073709551615;
    if flag {
        u = 3;
    }
    return u / 2;
}

fn main() -> i64 {
    var u: u64 = 18446744073709551615;
    print(u); print("\n");
    print(u / 2); print("\n");
    print(u % 10); print("\n");
    print(u >> 60); print("\n");
    if u > 1 { print(1); } else { print(0); }
    print("\n");
    var n: u32 = 4294967295;
    print(n / 2); print("\n");
    var b: u8 = 250;
    print(b / 2); print("\n");
    print(pick(true)); print("\n");
    print(pick(false)); print("\n");
    return 0;
}
