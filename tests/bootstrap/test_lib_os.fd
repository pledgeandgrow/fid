// stdlib/os: environment lookups (a variable that is certainly unset, so
// the answer does not depend on the machine), argument accessors agreeing
// with each other, the system information helpers (never empty: each has a
// fallback), path separators, the env/args aliases, and system() on a
// command that only exits with status 0. os_exit* are not called.
use os;

fn say_yes(b: bool) {
    if b { println("yes"); } else { println("no"); }
}

fn main() -> i64 {
    var unset = "FIDES_TEST_LIB_OS_SURELY_NOT_SET_9d3f";
    println(os_getenv(unset) == "");
    println(os_getenv_or(unset, "fallback"));
    say_yes(os_hasenv(unset));
    println(env_get(unset) == "");
    say_yes(env_exists(unset));

    // arguments
    say_yes(os_argc() >= 1);
    println(os_args().len() == os_argc());
    println(args_len() == os_argc());
    println(os_argv(0) == args_program_name());
    println(args_get(0) == os_argv(0));
    say_yes(str_len(args_program_name()) > 0);

    // information with fallbacks is never empty
    say_yes(str_len(os_name()) > 0);
    say_yes(str_len(os_home_dir()) > 0);
    say_yes(str_len(os_cwd()) > 0);
    say_yes(str_len(os_user()) > 0);
    say_yes(str_len(os_hostname()) > 0);
    say_yes(str_len(os_shell()) > 0);
    say_yes(str_len(os_term()) > 0);
    say_yes(str_len(os_tmp_dir()) > 0);

    // the PATH list has the same number of entries as separators + 1
    // (or none when PATH is unset)
    var p = os_path();
    say_yes(p.len() >= 0);

    println(os_path_sep());
    println(os_path_list_sep());
    println(os_system("exit 0"));

    return 0;
}
