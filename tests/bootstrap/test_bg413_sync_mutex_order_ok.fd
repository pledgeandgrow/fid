// Bugs roadmap BG413: SyncMutex locks taken in one order everywhere still
// pass the lock-order check.
//
// Expected output:
// ok

use sync;
fn main() {
    val a = SyncMutex::new();
    val b = SyncMutex::new();
    a.lock();
    b.lock();
    b.unlock();
    a.unlock();
    a.lock();
    b.lock();
    b.unlock();
    a.unlock();
    println("ok");
}
