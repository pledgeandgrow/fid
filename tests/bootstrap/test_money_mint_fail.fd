// expect-error: Conservation error: function 'double' is @conserve but calls 'Money_from_cents'
// Test: Money_from_cents makes Money from a number, so it mints: a
// @conserve function may not call it (nor Money_new, Money_from_dollars).
// Without the check, double() turns 100 cents into 200.

use money;

@conserve
fn double(a: Money) -> Money {
    val c = Money_to_cents(a);
    return Money_from_cents(c * 2);
}

fn main() -> i64 {
    println(Money_to_cents(double(Money_new(100))));
    return 0;
}
