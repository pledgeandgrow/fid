// expect-error: function 'f' has @gas(20) but total gas cost is
// Bugs roadmap BG382 / BG295: `x |> heavy` calls heavy and costs what it
// costs; a bare name on the right of a pipe was not recorded as a call.
fn heavy(x: i64) -> i64 {
    var t: i64 = 0;
    for i in 0..1000 {
        t = t + i * i + i * 3 + x;
    }
    return t;
}
@gas(20)
fn f(x: i64) -> i64 {
    return x |> heavy;
}
fn main() {
    println(f(1));
}
