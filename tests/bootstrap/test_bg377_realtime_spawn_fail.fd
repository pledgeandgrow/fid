// expect-error: starts a thread with `spawn`
// Bugs roadmap BG377: @realtime (reference §11: no Spawn, no blocking call)
// accepted `spawn` and `await`: they are expressions, not calls of a
// listed name.
fn work(x: i64) -> i64 {
    return x * 2;
}
@realtime
fn f(x: i64) -> i64 {
    val h = spawn work(x);
    return await h;
}
fn main() {
    println(f(1));
}
