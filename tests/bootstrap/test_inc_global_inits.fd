// Test: module-level globals keep their initial values in a program built
// per module (`fid ccompile --inc`, inc-roadmap B8), as in one built
// whole. scripts/inc-check.sh (SUITE=1) and
// tests/tooling/inc-globals-check.sh build it both ways and compare.
// Two bugs of compiler/compiler.fd split_c_units, both fixed: main's unit
// defined each global without its initializer (`var g_seven: i64 = 7`
// read 0, a str global read ""), and the function that runs the other
// initializers (`__init_globals`: a Vec, a map, a computed value) was
// copied into every unit's prelude, before the globals and the prototypes
// it names, so no program with such a global (or importing a stdlib module
// with one) compiled per module.
// Expected output:
//   7
//   fid
//   true
//   2.5
//   5
//   0
//   2 b
//   9
var g_seven: i64 = 7;
var g_name: str = "fid";
var g_on: bool = true;
var g_half: f64 = 2.5;
var g_sum: i64 = 2 + 3;
var g_names: Vec<str> = Vec::new();
var g_table: HashMap<str, i64> = HashMap::new();

fn note(s: str) {
    g_names.push(s);
}

fn main() {
    println(int_to_str(g_seven));
    println(g_name);
    if g_on {
        println("true");
    } else {
        println("false");
    }
    println(g_half);
    println(int_to_str(g_sum));
    println(int_to_str(g_names.len()));
    note("a");
    note("b");
    println(int_to_str(g_names.len()) + " " + g_names.get(1));
    g_table.insert("k", g_seven + 2);
    println(int_to_str(g_table.get("k")));
}
