// CA5: what a spawned task returns keeps its whole type after `await`,
// with or without an annotation on the let: a Vec<str> result's elements
// are strings, a map's values are what the map holds. (The Nov 16 compiler
// lost the element type of an unannotated `val r = await t` of a Vec<str>
// and printed the strings' addresses as numbers.) The task's argument is
// its own copy: the caller's Vec is unchanged.
//
// Expected output:
// a! b2! 2
// a! annotated
// a!
// 3 2 2
// 6
// x-y

fn words_up(ws: Vec<str>) -> Vec<str> {
    var out: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < ws.len() {
        out.push(ws.get(i) + "!");
        i = i + 1;
    }
    return out;
}

fn count_keys(m: HashMap<str, i64>, extra: str) -> HashMap<str, i64> {
    var m = m;
    m.insert(extra, m.len());
    return m;
}

fn lens(ws: Vec<str>) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < ws.len() {
        out.push(str_len(ws.get(i)));
        i = i + 1;
    }
    return out;
}

fn joined(a: str, b: str) -> str {
    return a + "-" + b;
}

fn main() -> i64 {
    var ws: Vec<str> = Vec::new();
    ws.push("a");
    ws.push("b" + int_to_str(2));
    val t1 = spawn words_up(ws);
    val r1 = await t1;
    println(r1.get(0) + " " + r1.get(1) + " " + int_to_str(ws.len()));
    val t2 = spawn words_up(ws);
    val r2: Vec<str> = await t2;
    println(r2.get(0) + " annotated");
    val t3 = spawn words_up(ws);
    println((await t3).get(0));

    var m: HashMap<str, i64> = HashMap::new();
    m.insert("one", 1);
    m.insert("t" + "wo", 2);
    val t4 = spawn count_keys(m, "three");
    val r4 = await t4;
    println(int_to_str(r4.len()) + " " + int_to_str(r4.get("three")) + " " + int_to_str(m.len()));

    ws.push("xyz");
    val t5 = spawn lens(ws);
    val r5 = await t5;
    println(int_to_str(r5.get(0) + r5.get(1) + r5.get(2)));

    val t6 = spawn joined("x", "y");
    println(await t6);
    return 0;
}
