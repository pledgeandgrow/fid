// known-bugs 2g.89 (RA14, SP11): the mid-end's constant propagation
// (compiler/iropt.fd iro_sccp) folded `~x` as `0 - x - 1`, which overflows
// in the compiler for x = i64::MIN: `fid emit` of a program with
// ~(i64::MIN) as a constant (compiler/main.fd has one) panicked "Integer
// overflow on subtraction" in iro_sccp. The fold is x ^ -1 now; every
// backend prints what the program computes.
//
// Expected output:
// 9223372036854775807
// -9223372036854775808
// 9223372036854775807
// 0
// -6
// 255
// 4

fn main() -> i64 {
    val m: i64 = 0 - 9223372036854775807 - 1;
    val n: i64 = ~m;
    println(n);
    println(~n);
    val u: u64 = 9223372036854775808;
    println(~u);
    val all: i64 = 0 - 1;
    println(~all);
    println(~5);
    val b: u8 = 0;
    println(~b);
    // a loop counting down from i64::MIN + 4 by a negated step
    var i: i64 = m + 4;
    var c: i64 = 0;
    while i > m {
        i = i - 1;
        c = c + 1;
    }
    println(c);
    return 0;
}
