// stdlib/brotli: the Brotli compressor (complaint CD2; competitive SL10,
// "Left: compressing encoders for zstd and brotli"). brotli_compress_level,
// brotli_compress and brotli_compress_str on inputs chosen to reach each
// part of the writer: the empty stream (one byte, as the reference
// encoder's), one byte, a run (the initial last distance 4 does not
// apply, distance 1 is coded), text with matches (complex prefix codes with
// repeat codes 16 and 17, explicit and implicit last-distance commands),
// simple prefix codes (2, 3 and 4 symbols), 256 literal values once each
// (every code length 8: a code-length code of one symbol, 0 bits), an
// uncompressed meta-block when nothing compresses (and the empty last one
// after it), quality 0 (stored). Every stream decodes back to its input
// with brotli_decompress and is pinned by its CRC-32. When written, each
// stream printed here was decoded by the reference decoder (Python's
// brotli 1.2) to the same bytes, as was a stream of 1.2 MB (two
// meta-blocks); sizes are within 10% of the reference encoder's at
// qualities 1-9.
//
// Expected output:
// empty.6: 0 -> 1 ok crc 996231864
// one.6: 1 -> 5 ok crc 2859432851
// run.6: 300 -> 10 ok crc 3469963963
// two.6: 200 -> 15 ok crc 1631095870
// three.6: 300 -> 106 ok crc 1862223486
// four.6: 300 -> 122 ok crc 1791326045
// text.0: 772 -> 776 ok crc 2299762323
// text.1: 772 -> 160 ok crc 4082383272
// text.6: 772 -> 160 ok crc 4082383272
// text.11: 772 -> 160 ok crc 4082383272
// skew.5: 500 -> 239 ok crc 1533480610
// letters.6: 800 -> 415 ok crc 687691878
// all256.6: 512 -> 272 ok crc 2155404322
// noise.6: 300 -> 304 ok crc 2832362094
// masked: 44 1
// str: Hello, Brotli! Hello, Brotli!
// default is quality 6: true

use brotli;
use compress;
use vec;
use string;

// Set to true to print each stream and its input as hex (to check them
// with another decoder).
const DUMP: bool = false;

fn hex(v: Vec<i64>) -> str {
    var sb: StringBuilder = StringBuilder::new();
    val digits: str = "0123456789abcdef";
    var i: i64 = 0;
    while i < v.len() {
        val b: i64 = v.get(i) & 255;
        sb.append_char(str_byte_at(digits, b >> 4));
        sb.append_char(str_byte_at(digits, b & 15));
        i = i + 1;
    }
    return sb.to_str();
}

// Pseudo-random bytes: kind 0 any byte, 1 skewed letters, 3 the 16
// letters a..p evenly, 5 three letters, 6 four letters.
fn gen(n: i64, seed: i64, kind: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var x: i64 = seed;
    var i: i64 = 0;
    while i < n {
        x = (x * 1103515245 + 12345) & 2147483647;
        var r: i64 = (x >> 8) & 255;
        if kind == 1 {
            val k: i64 = r & 15;
            if k < 6 {
                r = 97;
            } else if k < 10 {
                r = 98;
            } else if k < 12 {
                r = 99;
            } else {
                r = 100 + (r >> 4);
            }
        } else if kind == 3 {
            r = 97 + (r & 15);
        } else if kind == 5 {
            r = 97 + (r % 3);
        } else if kind == 6 {
            r = 97 + (r & 3);
        }
        out.push(r);
        i = i + 1;
    }
    return out;
}

fn check(name: str, data: Vec<i64>, quality: i64) -> void {
    val z: Vec<i64> = brotli_compress_level(data, quality);
    val back: Vec<i64> = brotli_decompress(z);
    var same: bool = brotli_ok(z) && back.len() == data.len();
    var i: i64 = 0;
    while same && i < data.len() {
        if back.get(i) != data.get(i) {
            same = false;
        }
        i = i + 1;
    }
    var verdict: str = "ok";
    if !same {
        verdict = "MISMATCH " + brotli_error(z);
    }
    println(name + "." + int_to_str(quality) + ": " + int_to_str(data.len()) + " -> " + int_to_str(z.len()) + " " + verdict + " crc " + int_to_str(crc32_bytes(z)));
    if DUMP {
        println("hex " + name + " " + int_to_str(quality) + " " + hex(z) + " " + hex(data));
    }
}

fn main() -> i64 {
    val para: str = "It is a truth universally acknowledged, that a single program in possession of a good standard library, must be in want of a compressor. ";
    var text: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 4 {
        val s: str = para + "Section " + int_to_str(i) + ": the quick brown fox jumps over the lazy dog. ";
        var k: i64 = 0;
        while k < str_len(s) {
            text.push(str_byte_at(s, k));
            k = k + 1;
        }
        i = i + 1;
    }
    var one: Vec<i64> = Vec::new();
    one.push(65);
    var run: Vec<i64> = Vec::new();
    var all256: Vec<i64> = Vec::new();
    var two: Vec<i64> = Vec::new();
    i = 0;
    while i < 512 {
        if i < 300 {
            run.push(120);
        }
        if i < 200 {
            two.push(65 + ((i * 7) % 11) % 2);
        }
        all256.push(i & 255);
        i = i + 1;
    }
    check("empty", Vec::new(), 6);
    check("one", one, 6);
    check("run", run, 6);
    check("two", two, 6);
    check("three", gen(300, 5, 5), 6);
    check("four", gen(300, 17, 6), 6);
    check("text", text, 0);
    check("text", text, 1);
    check("text", text, 6);
    check("text", text, 11);
    check("skew", gen(500, 7, 1), 5);
    check("letters", gen(800, 13, 3), 6);
    check("all256", all256, 6);
    check("noise", gen(300, 3, 0), 6);
    var big: Vec<i64> = Vec::new();
    big.push(300);
    big.push(1);
    val back: Vec<i64> = brotli_decompress(brotli_compress(big));
    println("masked: " + int_to_str(back.get(0)) + " " + int_to_str(back.get(1)));
    println("str: " + brotli_decompress_str(brotli_compress_str("Hello, Brotli! Hello, Brotli!")));
    val a: Vec<i64> = brotli_compress(text);
    val b: Vec<i64> = brotli_compress_level(text, 6);
    println("default is quality 6: " + bool_to_str(hex(a) == hex(b)));
    return 0;
}
