// expect-error: non-exhaustive match
// Test (known-bugs 2g.7): an arm with a guard covers nothing, since the
// guard may be false: Some(x) with x <= 0 matched no arm and ran none.
fn sign(o: Option<i64>) -> i64 {
    match o {
        Option::Some(x) if x > 0 => { return 1; }
        Option::None => { return 0; }
    }
    return -1;
}

fn main() -> i64 {
    print(sign(Option::Some(-3)));
    return 0;
}
