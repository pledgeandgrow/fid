// expect-error: inferred effect '!IO'
// Effect-row polymorphism: IO from the passed function escapes a !{} decl.
fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

fn io_inc(x: i64) -> i64 !IO {
    print(x);
    return x + 1;
}

fn use_io() -> i64 !{} {
    return apply(io_inc, 1);
}

fn main() -> i64 !IO {
    print(use_io());
    return 0;
}
