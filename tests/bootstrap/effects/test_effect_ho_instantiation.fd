// Effect-row polymorphism: a higher-order function's effects are
// instantiated at each call site from the function actually passed.
fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

fn pure_inc(x: i64) -> i64 {
    return x + 1;
}

fn io_inc(x: i64) -> i64 !IO {
    print(x);
    return x + 1;
}

// apply(pure_inc, ...) is pure — the !{} annotation verifies.
fn use_pure() -> i64 !{} {
    return apply(pure_inc, 41);
}

// apply(io_inc, ...) gets io_inc's IO effect.
fn use_io() -> i64 !IO {
    return apply(io_inc, 1);
}

// Closures are scanned directly: the effect comes from the body.
fn use_closure() -> i64 !IO {
    return apply(fn(x: i64) -> i64 { print(x); return x; }, 7);
}

fn main() -> i64 !IO {
    print(use_pure());
    print(use_io());
    print(use_closure());
    return 0;
}
