// Effect system test: effect propagation through call graph.
// helper() has IO effect (calls print).
// caller() calls helper() — should infer IO effect.
// main() calls caller() — should also infer IO effect.
fn helper() !IO {
    print("helper");
}

fn caller() !IO {
    helper();
}

fn main() -> i64 !IO {
    caller();
    return 0;
}
