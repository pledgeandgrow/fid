// expect-error: cannot compare Meters with Seconds
// Bugs roadmap BG60: comparisons were not type-checked beyond a str with a
// number: two different structs were compared (by their addresses).
struct Meters {
    v: i64,
}

struct Seconds {
    v: i64,
}

fn main() -> i64 {
    val d: Meters = Meters { v: 3 };
    val t: Seconds = Seconds { v: 3 };
    if d == t {
        println("same");
    }
    return 0;
}
