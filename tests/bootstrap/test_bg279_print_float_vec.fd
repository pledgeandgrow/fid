// BG279 (docs/roadmap/bugs-roadmap.md): printing a Vec or HashMap of f64,
// f32, bool or u64 (println, and an f-string part) shows each element as its
// text; doubles printed as their bits, bools as 1/0, a u64 as signed.
//
// Expected output:
// [1.5, -2.25]
// [true]
// [18446744073709551615]
// {a: 2.5}
// v [1.5, -2.25] m {a: 2.5}
// [0.5, 4]
// {1: true, 2: false}

fn idf(x: f32) -> f32 {
    return x;
}

fn main() {
    var h: Vec<f64> = Vec::new();
    h.push(1.5);
    h.push(-2.25);
    println(h);
    var b: Vec<bool> = Vec::new();
    b.push(true);
    println(f"{b}");
    var u: Vec<u64> = Vec::new();
    u.push(18446744073709551615);
    println(f"{u}");
    var n: HashMap<str, f64> = HashMap::new();
    n.insert("a", 2.5);
    println(n);
    println(f"v {h} m {n}");
    var g: Vec<f32> = Vec::new();
    g.push(idf(0.5));
    g.push(idf(4.0));
    println(g);
    var t: HashMap<i64, bool> = HashMap::new();
    t.insert(2, false);
    t.insert(1, true);
    println(t);
}
