// expect-error: expected an integer type (i64, usize, ...) after an impl's const parameter
// Expected to FAIL (CE4): an impl's const parameter is a number, so its type
// is an integer type; `bool` is not one.
struct Buf<const N: i64> {
    len: i64,
}

impl<const N: bool> Buf<N> {
    fn size(self) -> i64 {
        return self.len;
    }
}

fn main() -> i64 {
    return 0;
}
