// Release D16: string functions use the stored length, so a zero byte in
// the middle of a string is kept by length, find, split, replace and trim.
fn main() -> i64 {
    var z: str = char_to_str(0);
    var s: str = "ab" + z + "cd" + z + "ef";
    println(s.len());                                  // 8
    println(s.find("cd"));                             // 3
    println(s.contains("ef"));                         // true
    var parts: Vec<str> = s.split(z);
    println(parts.len());                              // 3
    println(parts.get(2));                             // ef
    var r: str = s.replace(z, "-");
    println(r);                                        // ab-cd-ef
    println(r.len());                                  // 8
    var t: str = (" x" + z + "y ").trim();
    println(t.len());                                  // 3
    println(s.ends_with("ef"));                        // true
    println(s.starts_with("ab" + z));                  // true
    return 0;
}
