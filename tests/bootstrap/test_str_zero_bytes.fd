// Release D16: string functions use the stored length, so a zero byte in
// the middle of a string is kept by length, find, split, replace and trim.
fn main() -> i64 {
    var z: str = char_to_str(0);
    var s: str = "ab" + z + "cd" + z + "ef";
    println(str_len(s));                               // 8
    println(str_find(s, "cd"));                        // 3
    println(str_contains(s, "ef"));                    // true
    var parts: Vec<str> = str_split(s, z);
    println(parts.len());                              // 3
    println(parts.get(2));                             // ef
    var r: str = str_replace(s, z, "-");
    println(r);                                        // ab-cd-ef
    println(str_len(r));                               // 8
    var t: str = str_trim(" x" + z + "y ");
    println(str_len(t));                               // 3
    println(str_ends_with(s, "ef"));                   // true
    println(str_starts_with(s, "ab" + z));             // true
    println(str_len(str_to_upper(s)));                 // 8
    return 0;
}
