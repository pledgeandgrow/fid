// Proposal 0002 end to end: payloads keep their type with no annotation,
// struct payloads outlive the function that made them, Result carries a
// Vec, map keeps the payload type, turbofish gives type arguments, and a
// parameter may have several bounds.
cap Show {
    fn show(self) -> str;
}

cap Size {
    fn size(self) -> i64;
}

struct Pt {
    x: i64,
    y: i64,
}

impl Show for Pt {
    pub fn show(self: Pt) -> str { return "pt" + int_to_str(self.x); }
}

impl Size for Pt {
    pub fn size(self: Pt) -> i64 { return self.x + self.y; }
}

fn mk(n: i64) -> Option<Pt> {
    return Option::Some(Pt { x: n, y: n + 1 });
}

fn evens(n: i64) -> Result<Vec<i64>, str> {
    if n < 0 { return Result::Err("negative"); }
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n { v.push(i * 2); i = i + 1; }
    return Result::Ok(v);
}

fn ident<T>(x: T) -> T { return x; }
fn zero<T>() -> T { return 0; }
fn dbl(x: f64) -> f64 { return x * 2.0; }

fn describe<T: Show + Size>(v: T) -> str {
    return v.show() + "/" + int_to_str(v.size());
}

fn main() -> i64 {
    val o = Option::Some(2.5);
    match o {
        Option::Some(v) => { println(v); }
        Option::None => {}
    }
    val p: Option<Pt> = mk(4);
    match p {
        Option::Some(q) => { println(q.x + q.y); }
        Option::None => {}
    }
    println(mk(7).unwrap().y);
    match evens(4) {
        Result::Ok(v) => { println(v.len()); println(v.get(3)); }
        Result::Err(e) => { println(e); }
    }
    match evens(-1) {
        Result::Ok(v) => { println(v.len()); }
        Result::Err(e) => { println(e); }
    }
    val m: Option<f64> = Option::Some(1.25);
    println(m.map(dbl).unwrap());
    println(ident::<f64>(0.5));
    println(ident("s"));
    println(zero::<i64>());
    println(describe(Pt { x: 2, y: 3 }));
    return 0;
}
