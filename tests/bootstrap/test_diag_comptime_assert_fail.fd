// expect-error: comptime_assert() checks while compiling: call it in comptime code
// expect-error: comptime_assert takes a bool and an optional message (a str)
// comptime_assert checks at compile time (comptime only), and takes a bool
// plus an optional str message.
fn main() -> i64 {
    comptime_assert(1 == 2, "unreachable");
    comptime { comptime_assert("yes") };
    return 0;
}
