// Closer reproduction: Vec<Token> in struct, extract Ident string, return via ResultStr

use core;
use vec;

enum ResultStr {
    Ok(str),
    Err(str),
}

enum TokenKind {
    Ident(str),
    Fn,
    Eof,
}

struct Token {
    kind: TokenKind,
}

struct Parser {
    tokens: Vec<Token>,
    pos: i64,
}

pub fn Parser_new(tokens: Vec<Token>) -> Parser {
    return Parser { tokens: tokens, pos: 0 };
}

impl Parser {
    fn peek_token(self: &Parser) -> Token {
        return self.tokens.get(self.pos);
    }

    fn advance(self: &mut Parser) {
        self.pos = self.pos + 1;
    }
}

fn expect_ident_or_keyword(self: &mut Parser) -> ResultStr {
    var tok: Token = self.peek_token();
    match tok.kind {
        TokenKind::Ident(s: str) => {
            var saved: str = s;
            self.advance();
            return ResultStr::Ok(saved);
        }
    }
    return ResultStr::Err("not ident");
}

fn parse_func(self: &mut Parser) -> i64 {
    // Skip Fn token
    self.advance();

    var name: str = "";
    match expect_ident_or_keyword(self) {
        ResultStr::Ok(s: str) => {
            print("Ok s='");
            print(s);
            print("'\n");
            name = s;
            print("after assign name='");
            print(name);
            print("'\n");
        }
        ResultStr::Err(e: str) => {
            print("Err: ");
            print(e);
            print("\n");
            return 1;
        }
    }
    print("final name='");
    print(name);
    print("'\n");
    return 0;
}

fn main() -> i64 {
    var tokens: Vec<Token> = Vec::new();
    tokens.push(Token { kind: TokenKind::Fn });
    tokens.push(Token { kind: TokenKind::Ident("main") });
    tokens.push(Token { kind: TokenKind::Eof });

    var parser: Parser = Parser_new(tokens);
    return parse_func(parser);
}
