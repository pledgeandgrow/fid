// expect-error: expected type name but got
// Expected to FAIL (CE4): a typed binding in a pattern, `Some(x: T)`, needs
// a type name after the colon; `5` is not one.
fn main() -> i64 {
    val o: Option<i64> = Option::Some(3);
    match o {
        Option::Some(x: 5) => {
            print(x);
        }
        Option::None => {
        }
    }
    return 0;
}
