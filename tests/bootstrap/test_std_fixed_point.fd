// stdlib/fixed_point: Q15/Q31/Q16.16 saturation, rounding multiply and divide, text conversion, square roots, CORDIC sine/cosine/atan2/magnitude against known values.
// Expected output:
// q15 0.5=16384 0.5*0.5=8192 -1*-1=32767 sat add 32767 sat sub -32768
// q15 div 16384 32767 32767, -0.5 = -0.50000, mac 4096
// q31 0.5*0.5=536870912 q15->q31 1073741824
// q16 1.5*2.25=3.3750 7/2=3.5000 -1/3=-0.3333 1/0=2147483647
// pi 3.1416 parse -12.375 = -811008 -> -12.3750 floor(-1.5)=-2 round(2.5)=3
// sqrt 2=1.4142 16=4.0000 0.25=0.5000 isqrt 1000000000 9
// sin/cos 0: 0.0000 1.0000
// sin/cos pi/6: 0.5000 0.8660
// sin/cos pi/2: 1.0000 0.0000
// sin/cos pi: 0.0000 -1.0000
// sin/cos -pi/4: -0.7071 0.7071
// sin/cos 10: -0.5440 -0.8391
// sin^2+cos^2 within 4 LSB over 64 angles: true
// atan2 0.7854 2.3562 -2.3562 3.1416 -1.5708, hypot(3,4)=5.0000 hypot(0.003,0.004)=0.0050
use fixed_point;
use vec;
use string;

fn sc(label: str, a: i64) {
    val v: Vec<i64> = q16_sincos(a);
    println("sin/cos " + label + ": " + q16_to_str(v.get(0)) + " " + q16_to_str(v.get(1)));
}

fn main() {
    val h: i64 = q15_from_f64(0.5);
    println("q15 0.5=" + int_to_str(h) + " 0.5*0.5=" + int_to_str(q15_mul(h, h)) + " -1*-1=" + int_to_str(q15_mul(Q15_MIN, Q15_MIN))
        + " sat add " + int_to_str(q15_add(30000, 10000)) + " sat sub " + int_to_str(q15_sub(-30000, 10000)));
    var acc: i64 = 0;
    acc = q15_mac(acc, 16384, 16384);
    acc = q15_mac(acc, 16384, -8192);
    println("q15 div " + int_to_str(q15_div(8192, 16384)) + " " + int_to_str(q15_div(16384, 8192)) + " " + int_to_str(q15_div(100, 0))
        + ", -0.5 = " + q15_to_str(-16384) + ", mac " + int_to_str(q15_from_acc(acc)));
    println("q31 0.5*0.5=" + int_to_str(q31_mul(0x40000000, 0x40000000)) + " q15->q31 " + int_to_str(q15_to_q31(16384)));
    val a: i64 = q16_from_f64(1.5);
    val b: i64 = q16_from_f64(2.25);
    println("q16 1.5*2.25=" + q16_to_str(q16_mul(a, b)) + " 7/2=" + q16_to_str(q16_div(q16_from_int(7), q16_from_int(2)))
        + " -1/3=" + q16_to_str(q16_div(q16_from_int(-1), q16_from_int(3))) + " 1/0=" + int_to_str(q16_div(Q16_ONE, 0)));
    val p: i64 = fx_parse("-12.375", 16);
    println("pi " + q16_to_str(Q16_PI) + " parse -12.375 = " + int_to_str(p) + " -> " + q16_to_str(p) + " floor(-1.5)=" + int_to_str(q16_floor(q16_from_f64(-1.5)))
        + " round(2.5)=" + int_to_str(q16_round(q16_from_f64(2.5))));
    println("sqrt 2=" + q16_to_str(q16_sqrt(q16_from_int(2))) + " 16=" + q16_to_str(q16_sqrt(q16_from_int(16))) + " 0.25=" + q16_to_str(q16_sqrt(16384))
        + " isqrt " + int_to_str(fx_isqrt(1000000000000000000)) + " " + int_to_str(fx_isqrt(99)));
    sc("0", 0);
    sc("pi/6", fx_parse("0.5235987756", 16));
    sc("pi/2", Q16_HALF_PI);
    sc("pi", Q16_PI);
    sc("-pi/4", fx_parse("-0.7853981634", 16));
    sc("10", q16_from_int(10));
    var ok: bool = true;
    var k: i64 = 0;
    while k < 64 {
        val ang: i64 = (k - 32) * 13000;
        val v: Vec<i64> = q16_sincos(ang);
        val n: i64 = q16_mul(v.get(0), v.get(0)) + q16_mul(v.get(1), v.get(1));
        if n - Q16_ONE > 4 || Q16_ONE - n > 4 { ok = false; }
        k = k + 1;
    }
    var okstr: str = "false";
    if ok { okstr = "true"; }
    println("sin^2+cos^2 within 4 LSB over 64 angles: " + okstr);
    val one: i64 = Q16_ONE;
    println("atan2 " + q16_to_str(q16_atan2(one, one)) + " " + q16_to_str(q16_atan2(one, 0 - one)) + " " + q16_to_str(q16_atan2(0 - one, 0 - one))
        + " " + q16_to_str(q16_atan2(0, 0 - one)) + " " + q16_to_str(q16_atan2(0 - one, 0))
        + ", hypot(3,4)=" + q16_to_str(q16_hypot(q16_from_int(3), q16_from_int(4))) + " hypot(0.003,0.004)=" + q16_to_str(q16_hypot(q16_from_f64(0.003), q16_from_f64(0.004))));
}
