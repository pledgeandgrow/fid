// expect-error: Partition error: the global 'SHARED_ALT' is shared by partition 'navigation' (in 'store_alt') and partition 'flight_control' (in 'control_loop')
// Roadmap Phase 9 (F47): spatial partitioning. Navigation writes a global
// through a helper and flight control reads it: memory shared between two
// partitions.

var SHARED_ALT: i64 = 0;

fn store_alt(v: i64) {
    SHARED_ALT = v;
}

@partitioned(navigation)
fn nav_update(alt: i64) {
    store_alt(alt);
}

@partitioned(flight_control)
fn control_loop() -> i64 {
    return SHARED_ALT / 10;
}

fn main() {
    nav_update(1200);
    println(int_to_str(control_loop()));
}
