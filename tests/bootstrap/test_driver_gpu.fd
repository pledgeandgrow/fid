// Driver goal MI18 (docs/roadmap/llvm-roadmap.md): `fid gpu` reads the IR
// (compiler/gpu.fd), not PIR's L3. The kernel keeps its running sum in a
// local variable (an Alloca with loads and stores in the IR): both
// generators keep such a scalar slot as a register or a variable of its
// own, so the loop is translated, not skipped. scripts/driver-goals-check.sh
// runs `fid gpu test_driver_gpu.fd --target ptx` (an `.entry k_sum` with
// `add.s64`, no "not translated: load") and `--target spirv -o k.spv`
// (scripts/spirv-check.py). On any backend it is an ordinary program.
// Expected output:
// 30
// 12

@kernel(64, 1, 1)
fn k_sum(n: i64, step: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + step * i;
        i = i + 1;
    }
    return s;
}

fn main() -> i64 {
    println(k_sum(5, 3));
    println(k_sum(4, 2));
    return 0;
}
