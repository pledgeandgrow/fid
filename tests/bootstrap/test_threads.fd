// Test: OS threads + atomics + mutex (Phase 8A)
//
// spawn <call> creates a real OS thread that runs concurrently.
// await <future> joins the thread and returns its result.
// Atomics provide lock-free shared memory.
// Mutex provides mutual exclusion.

/// Worker function — increments a shared counter 100 times using a mutex.
fn worker(counter: i64, m: i64) -> i64 {
    var i = 0;
    while i < 100 {
        p_mutex_lock(m);
        var old = p_atomic_add(counter, 1);
        p_mutex_unlock(m);
        i = i + 1;
    }
    return 0;
}

/// Simple worker that just returns a value (no shared state).
fn simple_worker(x: i64) -> i64 {
    return x * 3;
}

fn main() {
    // Test 1: Simple thread spawn + join
    val fut = spawn simple_worker(7);
    val result = await fut;
    print("simple = ");
    print(result);
    print("\n");

    // Test 2: Atomic operations
    val counter = p_shared_alloc(8);
    p_atomic_store(counter, 42);
    val loaded = p_atomic_load(counter);
    print("atomic_load = ");
    print(loaded);
    print("\n");

    var old = p_atomic_add(counter, 8);
    print("atomic_add old = ");
    print(old);
    print("\n");
    val new_val = p_atomic_load(counter);
    print("atomic_add new = ");
    print(new_val);
    print("\n");

    // Test 3: CAS
    var cas_ok = p_atomic_cas(counter, 50, 100);
    print("cas_ok = ");
    print(cas_ok);
    print("\n");
    var after_cas = p_atomic_load(counter);
    print("after_cas = ");
    print(after_cas);
    print("\n");

    // Test 4: Mutex
    val m = p_mutex_init();
    p_mutex_lock(m);
    p_mutex_unlock(m);
    print("mutex_ok\n");

    // Test 5: Multiple threads with shared counter + mutex
    val counter2 = p_shared_alloc(8);
    p_atomic_store(counter2, 0);
    val m2 = p_mutex_init();

    // Spawn 3 threads, each increments 100 times
    val t1 = spawn worker(counter2, m2);
    val t2 = spawn worker(counter2, m2);
    val t3 = spawn worker(counter2, m2);

    // Join all threads
    val r1 = await t1;
    val r2 = await t2;
    val r3 = await t3;

    val final = p_atomic_load(counter2);
    print("final_counter = ");
    print(final);
    print("\n");

    print("OK\n");
}
