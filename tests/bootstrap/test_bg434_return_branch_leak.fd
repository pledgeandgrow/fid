// Bugs roadmap BG434: `return match x { .. => f"..", .. }` and `return if c
// { f".." } else { f".." }` leaked the returned string on every call: the
// arms' values were not owned as the function's result type, so the
// result was no temporary and the return took a copy. compiler/lower.fd
// Stmt::Return gives the if/match the function's result type as its hint
// (as a let's declared type does, Lowerer_rc_result_type).
// Leak gate: `fid run tests/bootstrap/test_bg434_return_branch_leak.fd
// --leaks` must report "every block was freed".
//
// Expected output:
// many3
// pos3
// zero0
// neg0

fn label(i: i64) -> str {
    return match i {
        0 => f"zero{i}",
        _ => f"many{i}"
    };
}

fn label2(i: i64) -> str {
    return if i > 0 { f"pos{i}" } else { f"neg{i}" };
}

fn main() {
    val a: str = label(3);
    println(a);
    val b: str = label2(3);
    println(b);
    println(label(0));
    println(label2(0));
}
