// Bugs roadmap BG419: `fid wasm` did not sign-extend a narrowing cast to a
// signed type: `(-3 as i64) as i8` printed 253 and `(-300 as i16) as i8`
// 212 (M7, fixed on pe_ir and --nat). Unsigned targets still mask.
//
// Expected output:
// -44 -3 -4464 -705032704
// 212 253 61072 3589934592
// true
fn main() {
    val q: i16 = -300;
    val x: i64 = -3;
    val y: i64 = -70000;
    val z: i64 = -5000000000;
    println(f"{q as i8} {x as i8} {y as i16} {z as i32}");
    println(f"{q as u8} {x as u8} {y as u16} {z as u32}");
    val k: i8 = x as i8;
    println(f"{k < 0}");
}
