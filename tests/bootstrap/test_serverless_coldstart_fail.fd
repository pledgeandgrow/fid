// expect-error: Serverless error: @serverless handler 'handle_request' reads the global 'TABLE' (in 'lookup'), whose initializer runs code at start-up
// Roadmap Phase 9 (F32, cold start): a global built by running code at
// start-up makes every cold start pay for it before the first request.

fn build_table() -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < 1000 {
        s = s + i * i;
        i = i + 1;
    }
    return s;
}

var TABLE: i64 = build_table();

fn lookup(k: i64) -> i64 {
    return TABLE % (k + 1);
}

@serverless
fn handle_request(k: i64) -> i64 {
    return lookup(k);
}

fn main() {
    println(int_to_str(handle_request(7)));
}
