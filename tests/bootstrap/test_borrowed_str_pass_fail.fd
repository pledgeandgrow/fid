// expect-error: takes an owned str, and it is given a borrowed string
// A function taking an owned str may keep it, so a borrowed string cannot be
// passed to it (release M11): pass str_clone(s), or take &str.

@scoped
struct Msg {
    text: str,
}

fn remember(s: str) -> i64 {
    return str_len(s);
}

fn main() {
    val m: Msg = Msg { text: "a" };
    println(remember(m.text));
}
