// expect-error: p_malloc() needs an `unsafe` block
// Release M2: helper module of test_frontend_unsafe_import_fail.fd. It
// allocates raw memory outside `unsafe`; compiled by itself, the error is
// this file's own.

pub fn um_alloc(n: i64) -> i64 {
    val p: i64 = p_malloc(n);
    return p;
}

pub fn um_safe(n: i64) -> i64 {
    unsafe {
        val q: i64 = p_malloc(n);
        p_free(q);
    }
    return n;
}
