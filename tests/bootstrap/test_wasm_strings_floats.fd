// Test: strings and floats through the WebAssembly backend (release F9).

fn describe(n: i64) -> str {
    if n % 2 == 0 { return "even " + int_to_str(n); }
    return "odd " + int_to_str(n);
}

fn mean(xs: Vec<f64>) -> f64 {
    var t: f64 = 0.0;
    var i: i64 = 0;
    while i < xs.len() {
        t = t + xs[i];
        i = i + 1;
    }
    return t / (xs.len() as f64);
}

fn main() {
    var s: str = "Hello";
    s = s + ", " + "WebAssembly";
    print(s);
    print("\n");
    print(str_len(s));
    print(" ");
    print(str_slice(s, 7, 11));
    print(" ");
    print(str_contains(s, "Assembly"));
    print(" ");
    print(s == "Hello, WebAssembly");
    print("\n");
    print(describe(7));
    print(" | ");
    print(describe(10));
    print("\n");
    var acc: str = "";
    var i: i64 = 0;
    while i < 20 {
        acc = acc + int_to_str(i);
        i = i + 1;
    }
    print(acc);
    print("\n");

    val a: f64 = 1.5;
    val b: f64 = 0.25;
    print(a + b);
    print(" ");
    print(a * b);
    print(" ");
    print(a / b);
    print(" ");
    print(a - b * 8.0);
    print("\n");
    print(a > b);
    print(" ");
    print((7.9 as i64));
    print(" ");
    print(((0 - 3) as f64) / 2.0);
    print("\n");
    var xs: Vec<f64> = Vec::new();
    xs.push(1.0);
    xs.push(2.5);
    xs.push(4.0);
    print(mean(xs));
    print("\n");
    print(sqrt(2.0));
    print(" ");
    print(floor(2.7));
    print(" ");
    print(ceil(2.2));
    print("\n");
    print(float_to_str(3.25));
    print("\n");
}
