// expect-error: Redundancy error: @redundant function 'pitch_command' has effect '!IO'
// Roadmap Phase 9 (F45): each channel of a @redundant function runs its
// body, so an outside effect (here a print) would happen twice and cannot
// be voted on.

@redundant
fn pitch_command(alpha: i64) -> i64 {
    println("computing");
    return alpha * 100;
}

fn main() {
    println(int_to_str(pitch_command(3)));
}
