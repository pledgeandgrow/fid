// expect-error: cannot dereference non-reference type i64 to assign to '*a'
// Bugs roadmap BG2: `*x = v` matched only a raw pointer (which needs
// `unsafe`) and a shared reference (refused); any other x was accepted and
// the lowering stored through its value: here 5 written to address 4096 in
// safe code. Only a reference, a raw pointer (in `unsafe`) or a Box can be
// written through, as the read side `*a` says.

fn main() -> i64 {
    var a: i64 = 4096;
    *a = 5;
    println(int_to_str(a));
    return 0;
}
