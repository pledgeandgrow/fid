// stdlib/compress (competitive SL10): inflating real gzip and zlib streams
// made by another implementation (Python's zlib, level 9: fixed and
// dynamic Huffman blocks with back references), the checksums, and a
// round trip through this module's own (stored-block) compressor.
//
// Expected output:
// 348 bytes, ends with: the end.
// aaaaaaaaaabbbbbbbbbbaaaaaaaaaa
// 907060870 103547413
// round trip 21 bytes ok
use compress;
use vec;
use string;

fn bytes(csv_list: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var parts: Vec<str> = str_split(csv_list, ",");
    var i: i64 = 0;
    while i < parts.len() {
        out.push(str_parse_int(parts.get(i)));
        i = i + 1;
    }
    return out;
}

fn main() -> i64 {
    var gz: Vec<i64> = bytes("31,139,8,0,0,0,0,0,2,255,115,203,76,73,45,86,72,206,207,45,40,74,45,46,6,50,221,70,5,40,21,40,201,72,85,72,205,75,209,3,0,132,56,191,173,92,1,0,0");
    var text: str = gzip_decompress_str(gz);
    println(int_to_str(str_len(text)) + " bytes, ends with: " + str_slice(text, str_len(text) - 8, str_len(text)));
    var zl: Vec<i64> = bytes("120,218,75,76,132,129,36,56,128,11,37,2,0,176,234,11,105");
    println(zlib_decompress_str(zl));
    println(int_to_str(crc32("hello")) + " " + int_to_str(adler32("hello")));
    var msg: str = "round trip, round trip";
    var back: str = gzip_decompress_str(gzip_compress(msg));
    if back == msg { println("round trip " + int_to_str(str_len(msg) - 1) + " bytes ok"); }
    else { println("round trip DIFFERS: " + back); }
    return 0;
}
