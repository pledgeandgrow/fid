// Bugs roadmap BG155: an expression body is checked against the declared
// return type (as the expected type, as for a `return`); bodies of the
// declared type stay accepted.
//
// Expected output:
// 4
// 7
// 2.5
// yes

fn main() -> i64 {
    val inc = fn(x: i64) -> i64 => x + 1;
    println(inc(3));
    val wrap = fn(x: i64) -> Option<i64> => Option::Some(x);
    match wrap(7) {
        Option::Some(n) => {
            println(n);
        }
        Option::None => {
            println(0);
        }
    }
    val half = fn(x: i64) -> f64 => (x as f64) / 2.0;
    println(half(5));
    val word = fn(b: bool) -> str => if b { "yes" } else { "no" };
    println(word(true));
    return 0;
}
