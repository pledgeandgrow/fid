// expect-error: Determinism error: function 'ratio' is @deterministic but uses floating-point
// Expected to FAIL: @deterministic forbids floating point (reference
// section 11). The function has no float literal and integer parameters,
// but `as f64` makes floats from them, so it is rejected all the same
// (TypeChecker_verify_deterministic, scan_expr_for_floats' Cast arm).
@deterministic
fn ratio(a: i64, b: i64) -> i64 {
    val q = (a as f64) / (b as f64);
    return q as i64;
}

fn main() -> i64 {
    println(int_to_str(ratio(7, 2)));
    return 0;
}
