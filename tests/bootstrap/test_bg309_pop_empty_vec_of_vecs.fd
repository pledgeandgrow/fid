// Bugs roadmap BG309: `pop()` on an empty `Vec<Vec<T>>` gave the word 0, a
// null Vec handle: `fid run` read its length as 0, every compiled backend
// faulted at address 8 (stdlib/core.fd Vec_pop). An empty Vec of Vecs (or
// of maps) now pops an empty Vec (map) the caller owns.
//
// Expected output:
// len 0
// pushed 1
// len 0
// map 0
// back 2 0

fn main() {
    var vv: Vec<Vec<i64>> = Vec::new();
    val x: Vec<i64> = vv.pop();
    println(f"len {x.len()}");
    var y: Vec<i64> = vv.pop();
    y.push(7);
    println(f"pushed {y.len()}");
    var inner: Vec<i64> = Vec::new();
    inner.push(1);
    vv.push(inner);
    val got: Vec<i64> = vv.pop();
    val again: Vec<i64> = vv.pop();
    println(f"len {again.len()}");
    var vm: Vec<HashMap<str, i64>> = Vec::new();
    val m: HashMap<str, i64> = vm.pop();
    println(f"map {m.len()}");
    println(f"back {got.len() + 1} {vv.len()}");
}
