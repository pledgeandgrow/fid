    return "-----BEGIN CERTIFICATE-----
MIIBijCCAS+gAwIBAgIUCHxZir9785/S5itlOHU0H9A/ALwwCgYIKoZIzj0EAwIw
GTEXMBUGA1UEAwwOZmlkZXMtd2VicnRjLWEwIBcNMjYxMTE3MTI1NDI4WhgPMjEy
NjEwMjQxMjU0MjhaMBkxFzAVBgNVBAMMDmZpZGVzLXdlYnJ0Yy1hMFkwEwYHKoZI
zj0CAQYIKoZIzj0DAQcDQgAE7GH3n0uqZR4gvasJ3qV/74ehakkuDJHuwplvRdAC
vMpUM68RU5N96vIOc3K2BKNgulrSTUJ+ByKqmqCmQneNoKNTMFEwHQYDVR0OBBYE
FBoZ55wljiyOyGz5PRA06kr4qkaUMB8GA1UdIwQYMBaAFBoZ55wljiyOyGz5PRA0
