    return "-----BEGIN CERTIFICATE-----
MIIBijCCAS+gAwIBAgIURELEswHdMI4PSM21hWI/fnBZC80wCgYIKoZIzj0EAwIw
GTEXMBUGA1UEAwwOZmlkZXMtd2VicnRjLWIwIBcNMjYxMTE3MTI1NDI5WhgPMjEy
NjEwMjQxMjU0MjlaMBkxFzAVBgNVBAMMDmZpZGVzLXdlYnJ0Yy1iMFkwEwYHKoZI
zj0CAQYIKoZIzj0DAQcDQgAEEl87SExeJTzUgLBDfpSPQXjzeKaZKCPMy5SswdEf
gn7myeZqVOl8hP+jAs4grvmmCBQoRrUWKKgfpC66NZv8V6NTMFEwHQYDVR0OBBYE
FE1+NvlOV0DPAEBkypVk7ePXXNfHMB8GA1UdIwQYMBaAFE1+NvlOV0DPAEBkypVk
7ePXXNfHMA8GA1UdEwEB/wQFMAMBAf8wCgYIKoZIzj0EAwIDSQAwRgIhAM/4091C
