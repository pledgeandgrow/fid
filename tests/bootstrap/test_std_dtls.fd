// stdlib/dtls: the TLS 1.2 PRF vector, OpenSSL's SHA-256 fingerprint of an OpenSSL-made P-256 certificate, then DTLS 1.2 handshakes between a client and a server in memory (OpenSSL-made self-signed P-256 certificates checked by fingerprint): clean, then with 100- and 200-byte MTUs (fragmented ClientHello and certificates) over a channel that drops and reorders datagrams, SRTP keys equal on both sides and used, application data, tampered and replayed records, a wrong fingerprint, no common SRTP profile, an unanswered client timing out, close_notify. P-256 is too slow for the interpreter (docs/reference/stdlib-agent-bugs.md 20, 51): run it through the C backend.
// Expected output:
// prf e3f229ba727be17b8d122620557cd453c2aab21d07c3d495329b52d4e61edb5a6b301791e90d35c9c9a46b4e14baf9af0fa022f7077def17abfd3797c0564bab4fbc91666e9def9b97fce34f796789baa48082d122ee42c5a72e5a5110fff70187347b66
// fingerprint a sha-256 37:EE:79:9A:11:0B:4E:A5:13:09:08:CD:82:D0:8A:73:24:02:D2:60:B6:08:D6:E9:32:E0:54:64:D9:78:4D:7D
// fingerprint b sha-256 1A:D7:57:7C:F8:74:C9:88:C8:09:D9:46:08:A2:92:F9:27:94:10:97:38:86:33:A0:50:8E:18:F6:55:AC:4D:33
// clean: client connected, server connected, hello verify 1/1, profile SRTP_AEAD_AES_128_GCM, ems true true, retransmissions 0/0
// clean: srtp keys equal true (16+12 each way), exporter equal true, peer fingerprints true true
// app data: server read ping, client read pong
// lossy: client connected, server connected, profile SRTP_AES128_CM_HMAC_SHA1_80
// lossy: dropped 10, reordered 9, retransmissions 5/3, largest datagram 200, srtp keys equal true
// srtp with dtls keys: client to server true, server to client true
// tampered record dropped true, replayed record dropped true, still connected true
// wrong fingerprint: client failed (certificate fingerprint does not match), server failed (alert 42 from peer)
// no common profile: server failed (no common SRTP profile), client failed (alert 40 from peer)
// unanswered: client failed (handshake timed out) at 243000 ms after 8 retransmissions
// close: client closed, server closed (closed by peer)
use dtls;
use encoding;
use srtp;
use string;
use vec;

fn hb(h: str) -> Vec<i64> {
    return hex_decode_bytes(h);
}

fn hx(v: Vec<i64>) -> str {
    return hex_encode_bytes(v);
}

