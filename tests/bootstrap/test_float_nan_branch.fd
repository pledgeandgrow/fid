// Test (known-bugs 2g.12): on the false edge of `a < b` with a NaN,
// `a >= b` is false too; the optimizer must not decide it is true.
//
// Expected output:
// not less
// not greater-or-equal
fn main() -> i64 {
    val zero: f64 = 0.0;
    val a: f64 = zero / zero;
    val b: f64 = 1.0;
    if a < b {
        println("less");
    } else {
        println("not less");
        if a >= b { println("greater-or-equal"); } else { println("not greater-or-equal"); }
    }
    return 0;
}
