// stdlib/sdl: the input-state tracker and the constants. Window, renderer,
// texture and audio calls go through the SDL2 libraries and are not run
// here. Key and mouse state is filled by sdl_poll_events in a real program;
// the test sets the pub fields by hand to play the frames.
use sdl;

fn say_yes(b: bool) {
    if b { println("yes"); } else { println("no"); }
}

fn main() -> i64 {
    var st = sdl_input_create();
    println(st.keys.len());
    println(st.prev_keys.len());
    println(st.mouse_x);
    println(st.mouse_y);
    println(st.mouse_buttons);
    say_yes(sdl_quit_requested(&st));
    say_yes(sdl_key_held(&st, SDL_SCANCODE_A));

    // frame 1: A goes down
    st.keys.set(SDL_SCANCODE_A, 1);
    say_yes(sdl_key_held(&st, SDL_SCANCODE_A));
    say_yes(sdl_key_pressed(&st, SDL_SCANCODE_A));
    say_yes(sdl_key_released(&st, SDL_SCANCODE_A));
    // frame 2: still down, no longer "just pressed"
    st.prev_keys.set(SDL_SCANCODE_A, 1);
    say_yes(sdl_key_held(&st, SDL_SCANCODE_A));
    say_yes(sdl_key_pressed(&st, SDL_SCANCODE_A));
    say_yes(sdl_key_released(&st, SDL_SCANCODE_A));
    // frame 3: released
    st.keys.set(SDL_SCANCODE_A, 0);
    say_yes(sdl_key_held(&st, SDL_SCANCODE_A));
    say_yes(sdl_key_pressed(&st, SDL_SCANCODE_A));
    say_yes(sdl_key_released(&st, SDL_SCANCODE_A));
    // other keys are unaffected
    say_yes(sdl_key_held(&st, SDL_SCANCODE_B));

    // scancodes outside 0..511 are never held
    st.keys.set(511, 1);
    say_yes(sdl_key_held(&st, 511));
    say_yes(sdl_key_pressed(&st, 511));
    say_yes(sdl_key_held(&st, 512));
    say_yes(sdl_key_pressed(&st, 512));
    say_yes(sdl_key_released(&st, 512));
    say_yes(sdl_key_held(&st, -1));
    say_yes(sdl_key_pressed(&st, -1));
    say_yes(sdl_key_released(&st, -1));

    // mouse: bit 0 left, bit 1 middle, bit 2 right
    st.mouse_x = 120;
    st.mouse_y = 45;
    println(sdl_mouse_x(&st));
    println(sdl_mouse_y(&st));
    st.mouse_buttons = 1;
    say_yes(sdl_mouse_held(&st, SDL_BUTTON_LEFT));
    say_yes(sdl_mouse_pressed(&st, SDL_BUTTON_LEFT));
    say_yes(sdl_mouse_held(&st, SDL_BUTTON_RIGHT));
    st.prev_mouse_buttons = 1;
    say_yes(sdl_mouse_held(&st, SDL_BUTTON_LEFT));
    say_yes(sdl_mouse_pressed(&st, SDL_BUTTON_LEFT));
    st.mouse_buttons = 5;
    say_yes(sdl_mouse_held(&st, SDL_BUTTON_LEFT));
    say_yes(sdl_mouse_held(&st, SDL_BUTTON_MIDDLE));
    say_yes(sdl_mouse_held(&st, SDL_BUTTON_RIGHT));
    say_yes(sdl_mouse_pressed(&st, SDL_BUTTON_RIGHT));
    say_yes(sdl_mouse_pressed(&st, SDL_BUTTON_LEFT));
    st.quit_requested = true;
    say_yes(sdl_quit_requested(&st));

    // constants
    println(SDL_INIT_VIDEO | SDL_INIT_AUDIO);
    println(SDL_SCANCODE_A);
    println(SDL_SCANCODE_Z);
    println(SDL_SCANCODE_0);
    println(SDL_SCANCODE_ESCAPE);
    println(SDL_SCANCODE_SPACE);
    println(SDL_SCANCODE_LEFT);
    println(SDL_SCANCODE_RIGHT);
    println(SDL_SCANCODE_UP);
    println(SDL_SCANCODE_DOWN);
    println(SDL_BUTTON_LEFT);
    println(SDL_BUTTON_RIGHT);
    println(SDL_QUIT);
    println(SDL_KEYDOWN);
    println(SDL_MOUSEBUTTONDOWN);
    println(SDL_WINDOW_SHOWN);
    println(AUDIO_S16SYS);
    return 0;
}
