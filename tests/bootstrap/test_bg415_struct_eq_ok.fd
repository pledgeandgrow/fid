// Bugs roadmap BG415: ordering two structs or enums is an error; `==` and
// `!=` on them, and ordering their fields, still work.
//
// Expected output:
// true
// false
// true
// true

enum E { A, B }
struct P { x: i64 }

fn main() {
    val a = P { x: 5 };
    val b = P { x: 5 };
    println(a == b);
    println(E::A == E::B);
    println(E::A != E::B);
    println(a.x >= b.x);
}
