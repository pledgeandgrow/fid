var g: i64 = 100;

fn shadowed() -> i64 {
    var g: i64 = 5;
    g = g + 1;
    return g;
}

fn loop_then_global() -> i64 {
    // `g` here is the global; the loop var must not leak past the loop
    var acc = 0;
    for g in 0..3 {
        acc = acc + g;
    }
    g = g + 1;   // writes the GLOBAL (101), reads global too
    return g;
}

fn nested_same_var() -> i64 {
    var total: i64 = 0;
    for i in 0..3 {
        for i in 10..12 {
            total = total + i;
        }
        total = total + i;   // outer i must still be visible
    }
    return total;
}

fn main() -> i64 {
    val a = shadowed();          // 6
    val b = loop_then_global();  // 101
    val c = nested_same_var();   // (10+11)*3 + (0+1+2) = 69
    if a != 6 { return 1; }
    if b != 101 { return 2; }
    if c != 66 { return 3; }
    if g != 101 { return 4; }    // global updated only by loop_then_global
    return 0;
}
