// test_machine_secret_param.fd — llvm LF20 on the machine layer
// (compiler/nat_ir.fd ng_secret_ids): the values nat_ir keeps in registers
// first start at the front end's per-value list (IrFunction.secret_values,
// compiler/lower.fd): the values of @secret / @sensitive parameters and the
// slots of @secret / @sensitive / @zeroize locals, not only @zeroize ones.
//   press_param: 24 values busy in a loop and one value computed from a
//     @secret parameter live across it, used once: `--stats` prints
//     `[lf20] press_param: S secret values, S in registers` with S > 0
//     (before the list, S was 0: no @zeroize local, no seed);
//   press_local: the same with a @sensitive local instead;
//   assigned: a @secret parameter the body assigns (its slot is listed).
// Both are @declassify (an audited release), so their results print. The
// results do not change: every backend prints the same
// (tests/nattools/machine_lf20_param_check.sh).
//
// Expected output:
// 839019
// 26867
// 666185
// 27

@declassify
fn press_param(n: i64, @secret key: i64) -> i64 {
    val k: i64 = key * 31 + 7;
    var s: i64 = k ^ 5;
    var a0: i64 = n + 1;
    var a1: i64 = n + 2;
    var a2: i64 = n + 3;
    var a3: i64 = n + 4;
    var a4: i64 = n + 5;
    var a5: i64 = n + 6;
    var a6: i64 = n + 7;
    var a7: i64 = n + 8;
    var a8: i64 = n + 9;
    var a9: i64 = n + 10;
    var a10: i64 = n + 11;
    var a11: i64 = n + 12;
    var a12: i64 = n + 13;
    var a13: i64 = n + 14;
    var a14: i64 = n + 15;
    var a15: i64 = n + 16;
    var a16: i64 = n + 17;
    var a17: i64 = n + 18;
    var a18: i64 = n + 19;
    var a19: i64 = n + 20;
    var a20: i64 = n + 21;
    var a21: i64 = n + 22;
    var a22: i64 = n + 23;
    var a23: i64 = n + 24;
    var i: i64 = 0;
    while i < n {
        a0 = a0 * 3 + a1;
        a1 = a1 * 3 + a2;
        a2 = a2 * 3 + a3;
        a3 = a3 * 3 + a4;
        a4 = a4 * 3 + a5;
        a5 = a5 * 3 + a6;
        a6 = a6 * 3 + a7;
        a7 = a7 * 3 + a8;
        a8 = a8 * 3 + a9;
        a9 = a9 * 3 + a10;
        a10 = a10 * 3 + a11;
        a11 = a11 * 3 + a12;
        a12 = a12 * 3 + a13;
        a13 = a13 * 3 + a14;
        a14 = a14 * 3 + a15;
        a15 = a15 * 3 + a16;
        a16 = a16 * 3 + a17;
        a17 = a17 * 3 + a18;
        a18 = a18 * 3 + a19;
        a19 = a19 * 3 + a20;
        a20 = a20 * 3 + a21;
        a21 = a21 * 3 + a22;
        a22 = a22 * 3 + a23;
        a23 = a23 * 3 + a0;
        i = i + 1;
    }
    val t1: i64 = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7;
    val t2: i64 = a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15;
    val t3: i64 = a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23;
    return (t1 + t2 + t3) % 1000003 + s;
}

@declassify
fn press_local(n: i64, key: i64) -> i64 {
    @sensitive
    val k: i64 = key * 17 + 3;
    var s: i64 = k ^ 5;
    var a0: i64 = n + 1;
    var a1: i64 = n + 2;
    var a2: i64 = n + 3;
    var a3: i64 = n + 4;
    var a4: i64 = n + 5;
    var a5: i64 = n + 6;
    var a6: i64 = n + 7;
    var a7: i64 = n + 8;
    var a8: i64 = n + 9;
    var a9: i64 = n + 10;
    var a10: i64 = n + 11;
    var a11: i64 = n + 12;
    var a12: i64 = n + 13;
    var a13: i64 = n + 14;
    var a14: i64 = n + 15;
    var a15: i64 = n + 16;
    var a16: i64 = n + 17;
    var a17: i64 = n + 18;
    var a18: i64 = n + 19;
    var a19: i64 = n + 20;
    var a20: i64 = n + 21;
    var a21: i64 = n + 22;
    var a22: i64 = n + 23;
    var a23: i64 = n + 24;
    var i: i64 = 0;
    while i < n {
        a0 = a0 * 3 + a1;
        a1 = a1 * 3 + a2;
        a2 = a2 * 3 + a3;
        a3 = a3 * 3 + a4;
        a4 = a4 * 3 + a5;
        a5 = a5 * 3 + a6;
        a6 = a6 * 3 + a7;
        a7 = a7 * 3 + a8;
        a8 = a8 * 3 + a9;
        a9 = a9 * 3 + a10;
        a10 = a10 * 3 + a11;
        a11 = a11 * 3 + a12;
        a12 = a12 * 3 + a13;
        a13 = a13 * 3 + a14;
        a14 = a14 * 3 + a15;
        a15 = a15 * 3 + a16;
        a16 = a16 * 3 + a17;
        a17 = a17 * 3 + a18;
        a18 = a18 * 3 + a19;
        a19 = a19 * 3 + a20;
        a20 = a20 * 3 + a21;
        a21 = a21 * 3 + a22;
        a22 = a22 * 3 + a23;
        a23 = a23 * 3 + a0;
        i = i + 1;
    }
    val t1: i64 = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7;
    val t2: i64 = a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15;
    val t3: i64 = a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23;
    return (t1 + t2 + t3) % 1000003 + s;
}

@declassify
fn assigned(@secret key: i64, x: i64) -> i64 {
    key = key * 3 + x;
    key = key ^ 99;
    return key + x;
}

fn main() {
    println(press_param(5, 12345));
    println(press_param(3, 77));
    println(press_local(5, 12345));
    println(assigned(40, 2));
}
