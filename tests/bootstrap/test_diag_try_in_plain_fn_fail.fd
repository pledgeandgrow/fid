// expect-error: the ? operator returns None or Err from the enclosing function, but 'first' returns i64
// Expected to FAIL (CE4): `?` returns early with None or Err, so the
// function that holds it must return Option or Result.
fn first(n: i64) -> i64 {
    val o: Option<i64> = Option::Some(n);
    val x: i64 = o?;
    return x;
}

fn main() -> i64 {
    println(first(1));
    return 0;
}
