//! error: Conservation error: method 'Ledger::bonus' is @conserve but calls mint function 'Money_new'.
// TL2: a test per diagnostic of the type, borrow and escape checks.
// A @conserve method may not create money.

use money;

struct Ledger {
    total: i64,
}

impl Ledger {
    @conserve
    fn bonus(self: Ledger, cents: i64) -> Money {
        return Money_new(cents);
    }
}

fn main() -> i64 {
    return 0;
}
