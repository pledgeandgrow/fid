// expect-error: Rc<T> does not hold a fixed array ([T; N] is the address of its data).
// Expected to FAIL (TL2): a [T; N] value is the address of its data, so an
// Rc has no cell of its own to count the owners of.
fn main() -> i64 {
    val a: [i64; 3] = [1, 2, 3];
    val r = Rc::new(a);
    return 0;
}
