// Bugs roadmap BG372/BG412: what is not a duplicate still compiles: two
// impl blocks with different methods, a method name shared by two types,
// a narrower impl of a generic type specializing a method.
//
// Expected output:
// 1 2 3
// 10 20
struct Pt {
    x: i64,
}
struct Qt {
    y: i64,
}
impl Pt {
    fn a(self) -> i64 {
        return 1;
    }
}
impl Pt {
    fn b(self) -> i64 {
        return 2;
    }
}
impl Qt {
    fn a(self) -> i64 {
        return 3;
    }
}
struct W<T> {
    v: T,
}
impl<T> W<T> {
    fn tag(self) -> i64 {
        return 10;
    }
}
impl W<i64> {
    fn tag(self) -> i64 {
        return 20;
    }
}
fn main() {
    val p = Pt { x: 0 };
    val q = Qt { y: 0 };
    println(f"{p.a()} {p.b()} {q.a()}");
    val w1 = W { v: "s" };
    val w2 = W { v: 5 };
    println(f"{w1.tag()} {w2.tag()}");
}
