// BG305 (docs/roadmap/bugs-roadmap.md): f"{x:.N}" of a NaN or an infinity
// printed "0.00", "inf.0" and "-inf.000": fstr_fmt_f64 never tested for
// them. With a precision they now print the text the unformatted path
// prints ("NaN", "inf", "-inf"), padded to the width like any number;
// finite values keep their digits.
//
// Expected output:
// [NaN] [inf] [-inf] [     inf]
// [NaN] [NaN]
// [inf] [-inf] [+inf] [inf     ]
// [NaN] [inf] [-inf]
// [1.50] [-2.250] [3] [  0.1]
fn main() {
    var z: f64 = 0.0;
    val n: f64 = z / z;
    val i: f64 = 1.0 / z;
    println(f"[{n:.2}] [{i:.1}] [{0.0 - i:.3}] [{i:8.2}]");
    println(f"[{n:.0}] [{0.0 - n:.5}]");
    println(f"[{i:.0}] [{0.0 - i:.18}] [{i:+.2}] [{i:<8.2}]");
    // without a precision (the unchanged path)
    println(f"[{n}] [{i}] [{0.0 - i}]");
    println(f"[{1.5:.2}] [{0.0 - 2.25:.3}] [{3.0:.0}] [{0.1:5.1}]");
}
