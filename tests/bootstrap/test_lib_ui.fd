// stdlib/ui: the immediate-mode context. Widgets draw through SDL and are
// not run here; this covers the context defaults, ui_begin reading the
// mouse state from an SdlInputState (position, held, pressed this frame),
// ui_end clearing the active widget when the button is up, and ui_next_row.
use ui;
use sdl;

fn say_yes(b: bool) {
    if b { println("yes"); } else { println("no"); }
}

fn main() -> i64 {
    var ctx = ui_create();
    println(ctx.ren);
    println(ctx.mouse_x);
    say_yes(ctx.mouse_down);
    say_yes(ctx.mouse_pressed);
    println(ctx.hot);
    println(ctx.active);
    println(ctx.next_id);
    println(ctx.text_color_r);
    println(ctx.bg_color_b);
    println(ctx.hover_color_g);
    println(ctx.active_color_b);

    var input = sdl_input_create();
    input.mouse_x = 33;
    input.mouse_y = 44;
    input.mouse_buttons = 1;

    // first frame with the button down: pressed and held
    ctx.hot = 5;
    ctx.next_id = 9;
    ui_begin(&mut ctx, 777, &input);
    println(ctx.ren);
    println(ctx.mouse_x);
    println(ctx.mouse_y);
    say_yes(ctx.mouse_down);
    say_yes(ctx.mouse_pressed);
    // widget ids and hot start again each frame
    println(ctx.hot);
    println(ctx.next_id);

    // the button stays down: held, not pressed again
    input.prev_mouse_buttons = 1;
    ui_begin(&mut ctx, 777, &input);
    say_yes(ctx.mouse_down);
    say_yes(ctx.mouse_pressed);

    // ui_end keeps the active widget while the button is down
    ctx.active = 3;
    ui_end(&mut ctx);
    println(ctx.active);
    // and clears it once the button is up
    input.mouse_buttons = 0;
    ui_begin(&mut ctx, 777, &input);
    say_yes(ctx.mouse_down);
    ui_end(&mut ctx);
    println(ctx.active);

    // layout
    println(ui_next_row(10, 30, 5));
    println(ui_next_row(0, 0, 0));
    println(ui_next_row(100, 20, -4));
    return 0;
}
