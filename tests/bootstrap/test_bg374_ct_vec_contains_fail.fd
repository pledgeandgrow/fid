// expect-error: searches or compares secret data with `.contains()`, which stops at the first match or difference
// Bugs roadmap BG374: `v.contains(secret)` stops at the first match, yet a
// @constant_time function using it was accepted.
@constant_time
@wrapping
fn f(a: Vec<i64>, b: i64) -> bool {
    return a.contains(b);
}
fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(3);
    println(f(v, 3));
}
