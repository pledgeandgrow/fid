// expect-error: cannot assign to s.a.z
// Test (known-bugs 2g.9): `s.a.z = ..` changes what `&s.a` refers to,
// so it is rejected while that borrow is alive.
struct In { z: i64 }
struct Out { a: In, b: i64 }

fn read(r: &In) -> i64 { return r.z; }

fn main() -> i64 {
    var s = Out { a: In { z: 1 }, b: 2 };
    val r = &s.a;
    s.a.z = 5;
    print(read(r));
    return 0;
}
