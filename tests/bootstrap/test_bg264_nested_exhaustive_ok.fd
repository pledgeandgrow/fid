// Bugs roadmap BG264: exhaustive matches with nested patterns still compile
// (the exhaustiveness probe of the nested positions accepts them).
//
// Expected output:
// 7 -1 0
// 3 30 0
// 11 1 2
// big 5 neg
fn f(o: Option<Result<i64, str>>) -> i64 {
    match o {
        Option::Some(Result::Ok(x)) => {
            return x;
        }
        Option::Some(Result::Err(_)) => {
            return -1;
        }
        Option::None => {
            return 0;
        }
    }
    return 9;
}
enum P {
    Pair(i64, Option<i64>),
    Empty,
}
fn g(p: P) -> i64 {
    match p {
        P::Pair(x, Some(y)) => {
            return x + y;
        }
        P::Pair(x, None) => {
            return x * 10;
        }
        P::Empty => {
            return 0;
        }
    }
    return 9;
}
fn h(o: Option<Option<bool>>) -> i64 {
    match o {
        Some(Some(true)) => {
            return 11;
        }
        Some(Some(false)) => {
            return 1;
        }
        Some(None) => {
            return 2;
        }
        None => {
            return 3;
        }
    }
    return 9;
}
fn k(o: Option<Result<i64, str>>) -> str {
    match o {
        Some(Ok(x)) if x > 10 => {
            return "big";
        }
        Some(Ok(x)) => {
            return int_to_str(x);
        }
        Some(_) => {
            return "neg";
        }
        None => {
            return "none";
        }
    }
    return "?";
}
fn main() -> i64 {
    println(f"{f(Option::Some(Result::Ok(7)))} {f(Option::Some(Result::Err("e")))} {f(Option::None)}");
    println(f"{g(P::Pair(1, Option::Some(2)))} {g(P::Pair(3, Option::None))} {g(P::Empty)}");
    println(f"{h(Option::Some(Option::Some(true)))} {h(Option::Some(Option::Some(false)))} {h(Option::Some(Option::None))}");
    println(f"{k(Option::Some(Result::Ok(50)))} {k(Option::Some(Result::Ok(5)))} {k(Option::Some(Result::Err("x")))}");
    return 0;
}
