// expect-error: method 'P.set' expects 1 args, got 0
// Bugs roadmap BG18: a method call checked neither the number nor the
// types of its arguments: `p.set()` was accepted, and the method read a
// parameter the call never passed. The arguments after the receiver are
// checked now as a function call's are.
struct P {
    n: i64,
}

impl P {
    fn set(self: &mut P, n: i64) {
        self.n = n;
    }
}

fn main() -> i64 {
    var p: P = P { n: 1 };
    p.set();
    println(int_to_str(p.n));
    return 0;
}
