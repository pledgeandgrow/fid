// BG4 (docs/roadmap/bugs-roadmap.md): the counted-loop proof
// (compiler/checks.fd, peir_counted_loop) dropped the overflow check of
// `i = i + 1` because the outer test `i < n` held, although the step sits
// in an inner loop and runs five times per test. Started 7 below i64::MAX
// with n = i64::MAX, the 8th step overflows: that must panic, not wrap.
//
// Expected output:
// 15
// start
// Expected exit: 1

fn count(start: i64, n: i64) -> i64 {
    var i: i64 = start;
    while i < n {
        var j: i64 = 0;
        while j < 5 {
            i = i + 1;
            j = j + 1;
        }
    }
    return i;
}

fn main() {
    // 0 -> 5 -> 10 -> 15: the loop itself still counts
    println(count(0, 12));
    println("start");
    val max: i64 = 9223372036854775807;
    println(count(max - 7, max));
    println("not reached");
}
