// expect-error: the branches of this `if` have different types
// Bugs roadmap BG19: an `if` used as a value took the first branch's type
// and never looked at the other's: n held the address of "five".
fn main() -> i64 {
    val c: bool = false;
    val n: i64 = if c { 5 } else { "five" };
    println(int_to_str(n));
    return 0;
}
