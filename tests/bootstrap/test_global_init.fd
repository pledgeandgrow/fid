// A global's initializer runs before main, whatever it is.
var names: Vec<str> = Vec::new();
var start: i64 = 2 + 3;
var table: HashMap<str, i64> = HashMap::new();

fn add(s: str) {
    names.push(s);
}

fn main() -> i64 {
    add("a");
    add("b");
    println(names.len());
    println(start);
    table.insert("k", 7);
    println(table.get("k"));
    return 0;
}
