// expect-error: casting i64 to str needs an `unsafe` block
// String header by construction (Nov 22): every str carries its string
// header, and core's Str_drop/Str_dup stop on one without it. `x as str` of
// a number only reinterprets the word, so outside `unsafe` it is rejected;
// a C string becomes a str through p_str_from_ptr (a counted copy), and a
// literal `0 as str` (the null str) stays allowed.

fn main() -> i64 {
    val n: i64 = 4096;
    val s: str = n as str;
    println(s);
    return 0;
}
