// Bugs roadmap BG146: `x is Variant` needs an enum x that has the variant
// (type checker), and tests the variant of x's own enum (lowering): with
// two enums declaring the same names in another order, or a user enum
// named like Result's variants, each value is tested against its own enum.
// A primitive (`n is i64`) or a type name stays a type test.
//
// Expected output:
// true
// false
// true
// false
// true
// true
// false
// true
// true
// done

enum Light {
    Red,
    Green,
}

enum Flag {
    Green,
    Red,
}

enum Reply {
    Err(str),
    Ok(i64),
}

fn main() -> i64 {
    val l = Light::Red;
    println(l is Red);
    println(l is Green);
    val f = Flag::Red;
    println(f is Red);
    println(f is Green);
    val r: Result<i64, str> = Result::Ok(1);
    println(r is Ok);
    val p = Reply::Ok(3);
    println(p is Ok);
    println(p is Err);
    val o: Option<str> = Option::Some("s");
    println(o is Some);
    val n: i64 = 4;
    println(n is i64);
    println("done");
    return 0;
}
