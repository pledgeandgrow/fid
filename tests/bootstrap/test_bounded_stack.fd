// @bounded-stack: everything the function reaches is non-recursive and
// called directly, so its stack depth has a bound. (A safety-annotated
// function calls only safety-annotated functions.)
@bounded-stack
fn square(x: i64) -> i64 {
    return x * x;
}

@bounded-stack
fn sum_squares(n: i64) -> i64 {
    var total: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        total = total + square(i);
        i = i + 1;
    }
    return total;
}

@bounded-stack
fn report(n: i64) -> i64 {
    val s: i64 = sum_squares(n);
    println(s);
    return s;
}

fn main() -> i64 {
    report(10);
    return 0;
}
