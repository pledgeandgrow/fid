// test_gpu_region.fd — ML1: Region-scoped GPU memory
// Expected: PASS
// `region gpu r { }` allocates in GPU memory, freed at block exit.
// Variables allocated inside cannot escape the block.

fn main() -> i64 !IO {
    // GPU region — allocations go to GPU memory, freed at block exit
    region gpu weights {
        val w = 42;
        val b = 99;
        print(w + b);
        print("\n");
    }

    // CPU region — regular region (for comparison)
    region cpu_buf {
        val x = 10;
        print(x);
        print("\n");
    }

    // GPU region with budget
    region gpu activations with budget(4096) {
        val a = 100;
        val b = 200;
        print(a + b);
        print("\n");
    }

    return 0;
}
