// expect-error: Partition error: 'control_loop' (partition 'flight_control') calls 'nav_position', an entry of partition 'navigation'
// Roadmap Phase 9 (F47): partitions communicate only through ports, never
// by calling into each other.

@partitioned(navigation)
fn nav_position() -> i64 {
    return 42;
}

@partitioned(flight_control)
fn control_loop() -> i64 {
    return nav_position() * 2;
}

fn main() {
    println(int_to_str(control_loop()));
}
