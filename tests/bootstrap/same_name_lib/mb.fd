// BG142/BG143/BG173: helper of test_module_same_names.fd (see ma.fd).
module mb;

pub const K: i64 = 2;
const LIMIT: i64 = 200;
pub var COUNT: i64 = 200;
pub type Num = f64;

pub fn b() -> i64 {
    return K;
}

pub fn limit_b() -> i64 {
    return LIMIT;
}

pub fn bump_b() -> i64 {
    COUNT = COUNT + 1;
    return COUNT;
}

pub fn half_b() -> Num {
    val n: Num = 1.5;
    return n;
}
