// BG142/BG143/BG173: helper of test_module_same_names.fd. Module mb
// defines a const, a private const, a global and a type alias of the same
// names, with other values: each module keeps its own.
module ma;

pub const K: i64 = 1;
const LIMIT: i64 = 100;
pub var COUNT: i64 = 100;
pub type Num = i64;

pub fn a() -> i64 {
    return K;
}

pub fn limit_a() -> i64 {
    return LIMIT;
}

pub fn bump_a() -> i64 {
    COUNT = COUNT + 1;
    return COUNT;
}

pub fn half_a() -> Num {
    val n: Num = 7;
    return n / 2;
}

// a local of the same name hides the module's const
pub fn shadow_a() -> i64 {
    val K: i64 = 40;
    return K + 2;
}
