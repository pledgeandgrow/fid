// expect-error: in 'check', output 'println' runs inside a branch or loop that depends on a secret
// Expected to FAIL (BG77, docs/roadmap/bugs-roadmap.md): the `return`
// under the secret condition decides whether the `println` after the `if`
// runs, so "wrong pin" tells whether the pin was 1234. The check looked
// only at code inside the branch; the rest of a function after an exit
// taken under a secret condition (the rest of a loop after a `break` or
// `continue`) now depends on that secret too.
fn check(@secret pin: i64) {
    if pin == 1234 {
        return;
    }
    println("wrong pin");
}

fn main() -> i64 {
    check(1234);
    return 0;
}
