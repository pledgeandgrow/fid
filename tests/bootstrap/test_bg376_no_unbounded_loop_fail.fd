// expect-error: is @no-unbounded but uses a 'loop' loop
// Bugs roadmap BG376: SR-3 forbids `while` or `loop` without a bound, but
// only `while` was looked for: a `loop { }` passed @no-unbounded.
@no-unbounded
fn f(x: i64) -> i64 {
    var i: i64 = 0;
    loop {
        i = i + 1;
        if i > x {
            break;
        }
    }
    return i;
}
fn main() -> i64 { println(f(3)); return 0; }
