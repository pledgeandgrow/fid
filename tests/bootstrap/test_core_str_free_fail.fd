// expect-error: p_str_free() needs an `unsafe` block
// Bugs roadmap BG10: core's p_str_free frees a string whatever owns it.
// Called in safe code on a string the program still owns, it freed the
// block that `s` frees again when it is dropped (a double free). It needs
// an `unsafe` block now, as p_free does.

fn main() -> i64 {
    val s: str = "a" + "b";
    p_str_free(s as i64);
    println(s);
    return 0;
}
