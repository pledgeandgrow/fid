// expect-error: cannot store i64 in a Vec<str> (insert)
// Bugs roadmap BG154: Vec.insert's element was not checked (only push and
// set were): an integer inserted in a Vec<str> panicked on the next get.
fn main() -> i64 {
    var v: Vec<str> = Vec::new();
    v.push("a");
    v.insert(0, 12345);
    println(v.get(0));
    return 0;
}
