// BG238 (docs/roadmap/bugs-roadmap.md): Money_print writes a negative amount
// with one minus sign in front. Money_new(-5) printed "$0.0-5" and
// Money_new(-105) printed "$-1.0-5".
//
// Expected output:
// -$0.05
// -$1.05
// $0.00
// $12.34
// $0.07
// -$92233720368547758.08
use money;

fn main() -> i64 {
    Money_print(Money_new(-5));
    print("\n");
    Money_print(Money_new(-105));
    print("\n");
    Money_print(Money_new(0));
    print("\n");
    Money_print(Money_new(1234));
    print("\n");
    Money_print(Money_new(7));
    print("\n");
    // the smallest i64, where negating the cents first would overflow
    Money_print(Money_new(-9223372036854775807 - 1));
    print("\n");
    return 0;
}
