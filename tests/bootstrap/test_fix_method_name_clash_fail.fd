// expect-error: function 'pt_twice' has the name of method 'pt.twice'
// Test (stdlib-agent bug 1): a free function named like an impl method
// (`pt_twice` and `impl pt { fn twice }`, which is compiled as pt_twice)
// was silently merged with it: `pt_twice(p)` ran the method. Now an error.
struct pt { x: i64 }
impl pt {
    pub fn twice(self: pt) -> i64 { return self.x * 2; }
}
fn pt_twice(p: pt) -> i64 { return p.x * 3; }
fn main() {
    val p: pt = pt { x: 5 };
    println(int_to_str(pt_twice(p)));
    println(int_to_str(p.twice()));
}
