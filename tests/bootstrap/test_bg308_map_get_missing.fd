// BG308 (docs/roadmap/bugs-roadmap.md): `m.get(k)` of a missing key in a map
// whose values are structs or Vecs gives a zeroed struct / an empty Vec on
// every backend, as `fid run` does (compiled code read through address 0).
//
// Expected output:
// x 0
// len 0
// x 1
// len 2

struct P {
    x: i64,
    n: i64,
}

fn main() {
    var w: HashMap<str, P> = HashMap::new();
    w.insert("a", P { x: 1, n: 2 });
    val p: P = w.get("q");
    println(f"x {p.x}");
    var vv: HashMap<str, Vec<i64>> = HashMap::new();
    var one: Vec<i64> = Vec::new();
    one.push(7);
    one.push(8);
    vv.insert("k", one);
    println(f"len {vv.get("q").len()}");
    val p2: P = w.get("a");
    println(f"x {p2.x}");
    println(f"len {vv.get("k").len()}");
}
