// expect-error: Type error (line 9): cannot dereference non-reference type f64
// Test (stdlib-agent bugs 5/41, the location part): E079 "cannot
// dereference non-reference type" names the line of the statement that
// holds it (the error had no line). `x` is an f64, not a reference.
fn scale(x: f64) -> f64 {
    val k: f64 = 2.0;
    var y: f64 = k;
    y = y + 1.0;
    return *x * y;
}

fn main() {
    println(float_to_str(scale(1.5)));
}
