// Test FFI — extern "C" declarations and calling C library functions
// Phase 3D

// Declare extern C functions from the C standard library
// Using `as` to map C names to Fides names (avoids conflicts with stdlib)
extern "C" include "<math.h>" link "m" {
    fn sqrt as pledge_sqrt(x: f64) -> f64;
    fn pow as pledge_pow(base: f64, exp: f64) -> f64;
    fn floor as pledge_floor(x: f64) -> f64;
    fn ceil as pledge_ceil(x: f64) -> f64;
}

extern "C" include "<string.h>" {
    fn strlen as pledge_strlen(s: str) -> u64;
}

fn main() -> i64 {
    // Call C's sqrt function (from libm)
    val s = pledge_sqrt(16.0);
    print(s);  // 4

    // Call C's pow function
    val p = pledge_pow(2.0, 10.0);
    print(p);  // 1024

    // Call C's floor function
    val f = pledge_floor(3.7);
    print(f);  // 3

    // Call C's strlen function
    val len = pledge_strlen("hello world");
    print(len);  // 11

    return 0;
}
