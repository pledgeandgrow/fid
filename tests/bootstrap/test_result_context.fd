// .context(msg) on Result and Option: an error passed up with ? says what
// was being done; Ok goes through unchanged
use file;

fn parse_port(s: str) -> Result<i64, str> {
    if str_len(s) == 0 { return Result::Err("empty"); }
    return Result::Ok(str_parse_int(s));
}

fn load_port(s: str) -> Result<i64, str> {
    val p: i64 = parse_port(s).context("reading the port")?;
    return Result::Ok(p + 1);
}

fn find(xs: Vec<i64>, x: i64) -> Option<i64> {
    var i: i64 = 0;
    while i < xs.len() {
        if xs.get(i) == x { return Option::Some(i); }
        i = i + 1;
    }
    return Option::None;
}

fn where_is(xs: Vec<i64>, x: i64) -> Result<i64, str> {
    val at: i64 = find(xs, x).context("not in the list")?;
    return Result::Ok(at);
}

fn label() -> str {
    return "loading the config";
}

fn show(r: Result<i64, str>) {
    match r {
        Result::Ok(v: i64) => { println(v); }
        Result::Err(e: str) => { println("error: " + e); }
    }
}

fn main() -> i64 {
    show(load_port("8080"));
    show(load_port(""));
    var xs: Vec<i64> = Vec::new();
    xs.push(3);
    xs.push(7);
    show(where_is(xs, 7));
    show(where_is(xs, 9));
    show(parse_port("").with_context(label));
    match file_read_result("no/such/file.txt") {
        Result::Ok(s: str) => { println(s); }
        Result::Err(e: str) => { println(e); }
    }
    return 0;
}
