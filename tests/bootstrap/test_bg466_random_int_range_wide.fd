// BG466 (docs/roadmap/bugs-roadmap.md): random_int_range(min, max) panicked
// with an integer overflow when the range held 2^63 values or more:
// `max - min + 1` overflowed on the `+ 1` for (0, i64::MAX) and already on
// the subtraction for (i64::MIN, i64::MAX). Every min <= max now gives a
// value in [min, max]; ranges of fewer values are unchanged.
//
// Expected output:
// true
// full range: in range true, negatives true, positives true
// [0, MAX]: true
// [-1, MAX - 1]: true
// [MIN, -1]: true
// [MIN, 0]: true
// [-2, MAX]: true
// [MIN + 1, MAX]: true
// [MAX, MAX]: 9223372036854775807
// [MIN, MIN]: -9223372036854775808
// [10, 20]: true
// max < min: 5
use random;

fn check(min: i64, max: i64) -> bool {
    var ok: bool = true;
    var i: i64 = 0;
    while i < 200 {
        val r: i64 = random_int_range(min, max);
        if r < min || r > max {
            ok = false;
        }
        i = i + 1;
    }
    return ok;
}

fn main() {
    val imax: i64 = 9223372036854775807;
    val imin: i64 = 0 - imax - 1;
    random_seed(12345);
    // the entry's trigger
    println(f"{random_int_range(0, 9223372036854775807) >= 0}");
    var neg: bool = false;
    var pos: bool = false;
    var i: i64 = 0;
    while i < 200 {
        val r: i64 = random_int_range(imin, imax);
        if r < 0 {
            neg = true;
        }
        if r > 0 {
            pos = true;
        }
        i = i + 1;
    }
    println(f"full range: in range {check(imin, imax)}, negatives {neg}, positives {pos}");
    println(f"[0, MAX]: {check(0, imax)}");
    println(f"[-1, MAX - 1]: {check(0 - 1, imax - 1)}");
    println(f"[MIN, -1]: {check(imin, 0 - 1)}");
    println(f"[MIN, 0]: {check(imin, 0)}");
    println(f"[-2, MAX]: {check(0 - 2, imax)}");
    println(f"[MIN + 1, MAX]: {check(imin + 1, imax)}");
    println(f"[MAX, MAX]: {random_int_range(imax, imax)}");
    println(f"[MIN, MIN]: {random_int_range(imin, imin)}");
    println(f"[10, 20]: {check(10, 20)}");
    println(f"max < min: {random_int_range(5, 3)}");
}
