// expect-error: a variadic argument expects 'i64', got 'str' in 'main'
// Expected to FAIL (CE4): each trailing argument of `...xs: i64` is an
// i64 (L8E: the arguments are pushed on the pack's Vec).
fn sum(...xs: i64) -> i64 {
    var t: i64 = 0;
    for x in xs {
        t = t + x;
    }
    return t;
}

fn main() -> i64 {
    println(sum(1, "two", 3));
    return 0;
}
