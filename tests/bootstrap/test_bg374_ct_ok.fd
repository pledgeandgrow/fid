// Bugs roadmap BG374: @constant_time rejects `==` on secret text,
// searching secret data and branching closures; masks, lengths and a
// branch-free closure still compile and run. Not on the C backend: the C
// generator's own @constant_time check on the IR rejects any indirect call
// (`twice_plus` calls its closure through a function value), which the type
// checker and the pe_ir / --nat machine-code checks accept.
//@ backends: run,emit,nat
//
// Expected output:
// 1
// 3
// 9

@constant_time
@wrapping
fn select(mask: i64, a: i64, b: i64) -> i64 {
    return (a & mask) | (b & (0 - 1 - mask));
}

@constant_time
@wrapping
fn length_of(a: Vec<i64>) -> i64 {
    return a.len();
}

@constant_time
@wrapping
fn twice_plus(a: i64, b: i64) -> i64 {
    val g = fn(x: i64) -> i64 {
        return x * 2;
    };
    return g(a) + b;
}

fn main() {
    println(select(0 - 1, 1, 2));
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    println(length_of(v));
    println(twice_plus(4, 1));
}
