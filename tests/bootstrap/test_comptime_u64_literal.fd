// BG47 (bugs roadmap): the comptime fit check (§4.11) applies to values
// comptime computed, not to every literal of a function that holds a
// comptime expression. A u64 literal above i64::MAX is held as its raw
// bits, so it was rejected as "does not fit in u64".
// Expected output:
// 5
// max

fn main() -> i64 {
    val m: u64 = 18446744073709551615;
    val k = comptime 2 + 3;
    println(int_to_str(k));
    if m == 18446744073709551615 {
        println("max");
    }
    return 0;
}
