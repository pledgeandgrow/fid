// BG267 (docs/roadmap/bugs-roadmap.md): an f64 literal given to an f32 enum
// payload is converted to f32 when stored (`E::F(2.5)` read back as 0), and
// so is the literal of an `Option<f32>` the let gives its type.
//
// Expected output:
// F 2.5
// D 1.25
// 1.5
// F 0.75
// 6.5

enum E {
    F(f32),
    D(f64),
}

fn show(e: E) -> str {
    match e {
        E::F(x) => {
            return f"F {x}";
        }
        E::D(d) => {
            return f"D {d}";
        }
    }
}

fn mk() -> Option<f32> {
    return Option::Some(6.5);
}

fn main() {
    println(show(E::F(2.5)));
    println(show(E::D(1.25)));
    val o2: Option<f32> = Option::Some(1.5);
    println(f"{o2.unwrap()}");
    val y: f32 = 1.5;
    println(show(E::F(y / 2.0)));
    println(f"{mk().unwrap()}");
}
