// Bugs roadmap BG422: `comptime f(1)` of a function with a default
// parameter was rejected ("expects 2 args, got 1") and `comptime h(b: 3,
// a: 4)` failed ("cannot evaluate binop on non-literal"); the same calls
// without `comptime` are valid (reference §2.1).
//
// Expected output:
// 110
// 403
// 105
// 1020
// 110 403
fn f(a: i64, b: i64 = 10) -> i64 {
    return a * 100 + b;
}
fn h(a: i64, b: i64) -> i64 {
    return a * 100 + b;
}
fn k(a: i64, b: i64 = a * 2) -> i64 {
    return a * 100 + b;
}
fn main() {
    val x = comptime f(1);
    println(x);
    println(comptime h(b: 3, a: 4));
    println(comptime f(b: 5, a: 1));
    println(comptime k(10));
    println(f"{f(1)} {h(b: 3, a: 4)}");
}
