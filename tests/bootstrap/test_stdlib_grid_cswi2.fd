// stdlib/grid (release B19): every logical-node constant has its IEC 61850
// class name; LN_CSWI2, a second control switch, is a CSWI (it was
// "UNKNOWN"). An unknown type still says so.
//
// Expected output:
// CSWI
// CSWI
// CILO
// UNKNOWN
use grid;

fn main() -> i64 {
    println(iec61850_ln_name(LN_CSWI));
    println(iec61850_ln_name(LN_CSWI2));
    println(iec61850_ln_name(LN_CILO));
    println(iec61850_ln_name(42));
    if iec61850_ln_name(LN_CSWI2) == "UNKNOWN" {
        p_panic("grid: LN_CSWI2 has no name");
    }
    return 0;
}
