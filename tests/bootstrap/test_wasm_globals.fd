// Test: module globals through the WebAssembly backend (release F9,
// scripts/wasm-test.sh compares `fid wasm` + Node with `fid run`):
// integer, bool, float and string globals, read and changed by functions.

var counter: i64 = 10;
var flag: bool = false;
var ratio: f64 = 0.5;
var label: str = "start";
var total: i64 = 0;

fn bump(by: i64) {
    counter = counter + by;
    total = total + 1;
}

fn toggle() {
    flag = !flag;
}

fn main() {
    print(counter);
    print("\n");
    bump(5);
    bump(0 - 3);
    print(counter);
    print("\n");
    print(total);
    print("\n");
    toggle();
    print(flag);
    print("\n");
    ratio = ratio * 3.0;
    print(ratio);
    print("\n");
    print(label);
    print("\n");
    label = label + " -> end";
    print(label);
    print("\n");
    var i: i64 = 0;
    while i < 1000 {
        bump(1);
        i = i + 1;
    }
    print(counter);
    print("\n");
}
