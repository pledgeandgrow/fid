    hny(5999, "2238-09-10", 385);
    // dates by .NET HebrewCalendar (its month 1 is Tishri; here Nisan is 1)
    heb(1583, 1, 1, "5343-10-07");
    heb(1900, 3, 1, "5660-12-30");
    heb(1970, 1, 1, "5730-10-23");
    heb(2000, 1, 1, "5760-10-23");
    heb(2023, 9, 16, "5784-07-01");
    heb(2024, 2, 10, "5784-12-01");
    heb(2024, 3, 11, "5784-13-01");
    heb(2024, 3, 24, "5784-13-14");
    heb(2024, 4, 23, "5784-01-15");
    heb(2025, 3, 14, "5785-12-14");
    heb(2025, 9, 22, "5785-06-29");
    heb(2025, 9, 23, "5786-07-01");
    heb(2025, 11, 21, "5786-09-01");
    heb(2025, 12, 21, "5786-10-01");
    heb(2026, 11, 17, "5787-09-07");
    heb(2027, 3, 23, "5787-13-14");
    heb(2045, 11, 12, "5806-09-03");
