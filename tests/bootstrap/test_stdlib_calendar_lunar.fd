    check_i("CAL_ISLAMIC_IV 1 Muharram 61", cal_islamic_to_days_rule(61, 1, 1, CAL_ISLAMIC_IV, CAL_ISLAMIC_EPOCH_CIVIL), -470886);
    check_i("CAL_ISLAMIC_IV 1 Muharram 1000", cal_islamic_to_days_rule(1000, 1, 1, CAL_ISLAMIC_IV, CAL_ISLAMIC_EPOCH_CIVIL), -138136);
    check_i("CAL_ISLAMIC_IV 1 Muharram 1445", cal_islamic_to_days_rule(1445, 1, 1, CAL_ISLAMIC_IV, CAL_ISLAMIC_EPOCH_CIVIL), 19557);
    check_i("CAL_ISLAMIC_IV 1 Muharram 1446", cal_islamic_to_days_rule(1446, 1, 1, CAL_ISLAMIC_IV, CAL_ISLAMIC_EPOCH_CIVIL), 19912);
    check_i("CAL_ISLAMIC_IV 1 Muharram 1447", cal_islamic_to_days_rule(1447, 1, 1, CAL_ISLAMIC_IV, CAL_ISLAMIC_EPOCH_CIVIL), 20266);
    check_i("CAL_ISLAMIC_IV 1 Muharram 1448", cal_islamic_to_days_rule(1448, 1, 1, CAL_ISLAMIC_IV, CAL_ISLAMIC_EPOCH_CIVIL), 20620);
    check_i("CAL_ISLAMIC_IV 1 Muharram 1450", cal_islamic_to_days_rule(1450, 1, 1, CAL_ISLAMIC_IV, CAL_ISLAMIC_EPOCH_CIVIL), 21329);
    check("CAL_ISLAMIC_IV day after 29 Dhu al-Hijjah 1447", cal_date_str(cal_days_to_islamic_rule(20620, CAL_ISLAMIC_IV, CAL_ISLAMIC_EPOCH_CIVIL)), "1448-01-01");
    check("1 Ramadan 1447", cal_date_str(cal_gregorian_to_islamic(2026, 2, 18)), "1447-09-01");
    check("1 Shawwal 1447", cal_date_str(cal_islamic_to_gregorian(1447, 10, 1)), "2026-03-20");
    check_b("1445 leap", cal_islamic_is_leap(1445), true);
    check_b("1446 common", cal_islamic_is_leap(1446), false);
    check_b("30 Dhu al-Hijjah 1445", cal_islamic_is_valid(1445, 12, 30), true);
    check_b("30 Dhu al-Hijjah 1446", cal_islamic_is_valid(1446, 12, 30), false);
    check_b("30 Safar", cal_islamic_is_valid(1446, 2, 30), false);
    check_b("30 Muharram", cal_islamic_is_valid(1446, 1, 30), true);
    check_b("month 13", cal_islamic_is_valid(1446, 13, 1), false);
    check_b("rule IV year 30", cal_islamic_is_valid_rule(1440, 12, 30, CAL_ISLAMIC_IV), true);
    check_b("rule II year 30", cal_islamic_is_valid_rule(1440, 12, 30, CAL_ISLAMIC_II), false);
    check_i("days in Ramadan", cal_islamic_days_in_month(1447, 9), 30);
    check_i("days in Shawwal", cal_islamic_days_in_month(1447, 10), 29);
    check("month 9", cal_islamic_month_name(9), "Ramadan");
    check("month 12", cal_islamic_month_name(12), "Dhuʻl-Hijjah");
    check("month 13 name", cal_islamic_month_name(13), "");
    check_i("civil epoch", cal_jdn_from_days(cal_islamic_to_days(1, 1, 1)), CAL_ISLAMIC_EPOCH_CIVIL);
    check("the epoch is Julian 622-07-16", cal_date_str(cal_days_to_julian(cal_islamic_to_days(1, 1, 1))), "0622-07-16");
    check_i("the epoch is a Friday", cal_iso_weekday(cal_islamic_to_days(1, 1, 1)), 5);
    check("the day before the epoch", cal_date_str(cal_days_to_islamic(cal_islamic_to_days(1, 1, 1) - 1)), "0000-12-29");
    islamic_round_trip("rule I", CAL_ISLAMIC_I);
    islamic_round_trip("rule II", CAL_ISLAMIC_II);
    islamic_round_trip("rule III", CAL_ISLAMIC_III);
    islamic_round_trip("rule IV", CAL_ISLAMIC_IV);
    println("islamic ok");

