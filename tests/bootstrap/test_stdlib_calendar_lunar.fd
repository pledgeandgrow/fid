    check("fr long", dt_format_lang(aug15, "%A %d %B %Y", "fr"), "samedi 15 août 2026");
    check("fr medium", dt_format_lang(aug15, "%a %d %b %Y", "fr"), "sam. 15 août 2026");
    parsed_lang("fr long back", "samedi 15 août 2026", "%A %d %B %Y", "fr", 1786752000);
    parsed_lang("fr medium back", "sam. 15 août 2026", "%a %d %b %Y", "fr", 1786752000);
    check("de long", dt_format_lang(aug15, "%A, %d. %B %Y", "de"), "Samstag, 15. August 2026");
    check("de medium", dt_format_lang(aug15, "%a, %d. %b %Y", "de"), "Sa., 15. Aug. 2026");
    parsed_lang("de long back", "Samstag, 15. August 2026", "%A, %d. %B %Y", "de", 1786752000);
    parsed_lang("de medium back", "Sa., 15. Aug. 2026", "%a, %d. %b %Y", "de", 1786752000);
    check("es long", dt_format_lang(aug15, "%A, %d de %B de %Y", "es"), "sábado, 15 de agosto de 2026");
    check("es medium", dt_format_lang(aug15, "%a, %d %b %Y", "es"), "sáb, 15 ago 2026");
    parsed_lang("es long back", "sábado, 15 de agosto de 2026", "%A, %d de %B de %Y", "es", 1786752000);
    parsed_lang("es medium back", "sáb, 15 ago 2026", "%a, %d %b %Y", "es", 1786752000);
    check("it long", dt_format_lang(aug15, "%A %d %B %Y", "it"), "sabato 15 agosto 2026");
    check("it medium", dt_format_lang(aug15, "%a %d %b %Y", "it"), "sab 15 ago 2026");
    parsed_lang("it long back", "sabato 15 agosto 2026", "%A %d %B %Y", "it", 1786752000);
    parsed_lang("it medium back", "sab 15 ago 2026", "%a %d %b %Y", "it", 1786752000);
    check("pt long", dt_format_lang(aug15, "%A, %d de %B de %Y", "pt"), "sábado, 15 de agosto de 2026");
    check("pt medium", dt_format_lang(aug15, "%a, %d de %b de %Y", "pt"), "sáb., 15 de ago. de 2026");
    parsed_lang("pt long back", "sábado, 15 de agosto de 2026", "%A, %d de %B de %Y", "pt", 1786752000);
    parsed_lang("pt medium back", "sáb., 15 de ago. de 2026", "%a, %d de %b de %Y", "pt", 1786752000);
    check("english", dt_format_lang(aug15, "%A %B %a %b %h", "en"), "Saturday August Sat Aug Aug");
    check("english is dt_format", dt_format_lang(aug15, "%A %d %B %Y", "en-GB"), dt_format(aug15, "%A %d %B %Y"));
    check("unknown language", dt_format_lang(aug15, "%A %B", "xx"), "Saturday August");
    check("region", dt_format_lang(aug15, "%A %B", "fr-CA"), "samedi août");
    check("region underscore", dt_format_lang(aug15, "%A %B", "DE_at"), "Samstag August");
    check("other codes unchanged", dt_format_lang(time_new(2026, 8, 15, 14, 5, 9), "%F %T %p %j %u", "es"), "2026-08-15 14:05:09 PM 227 6");
    check_b("fr supported", dt_lang_supported("fr"), true);
    check_b("en-US supported", dt_lang_supported("en-US"), true);
    check_b("ar supported", dt_lang_supported("ar"), true);
    check_b("xx not supported", dt_lang_supported("xx"), false);
    check("fr month 13", dt_month_name_in("fr", 13), "?");
    check("de weekday 7", dt_weekday_name_in("de", 7), "?");
    check("de März short", dt_month_short_in("de", 3), "März");
    check("es miércoles", dt_weekday_name_in("es", 3), "miércoles");
    check("pt sexta-feira", dt_weekday_name_in("pt", 5), "sexta-feira");
    check("ar weekday", dt_weekday_name_in("ar", 5), "الجمعة");
    parsed_lang("fr dot optional", "janv 2026", "%b %Y", "fr", 1767225600);
    parsed_lang("fr with dot", "janv. 2026", "%b %Y", "fr", 1767225600);
    parsed_lang("fr ASCII case", "SAMEDI 15 août 2026", "%A %d %B %Y", "fr", 1786752000);
    parsed_lang("de März", "15. März 2026", "%d. %b %Y", "de", 1773532800);
    parsed_lang("es miércoles", "miércoles, 4 de febrero de 2026", "%A, %e de %B de %Y", "es", 1770163200);
    parsed_lang("pt full weekday over short", "sábado, 15 de agosto de 2026", "%A, %d de %B de %Y", "pt", 1786752000);
    parsed_lang("ar", "السبت 15 أغسطس 2026", "%A %d %B %Y", "ar", 1786752000);
    parsed_lang("english still", "Sat, 15 Aug 2026 00:00:00 +0000", "%a, %d %b %Y %T %z", "en", 1786752000);
    refused_lang("fr wrong weekday", "dimanche 15 août 2026", "%A %d %B %Y", "fr");
    refused_lang("fr English month", "15 August 2026", "%d %B %Y", "fr");
    refused_lang("fr non-ASCII case", "15 AOÛT 2026", "%d %B %Y", "fr");
    refused_lang("de unknown month", "15. Mär 2026", "%d. %b %Y", "de");
    println("names ok");
    println("lunar calendars ok");
    return 0;
