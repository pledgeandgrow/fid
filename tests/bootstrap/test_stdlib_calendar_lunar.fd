// stdlib/calendar's lunar calendars and datetime's localized names
// (competitive SL8): the tabular Islamic calendar with its four leap-year
// rules and both epochs, the Hebrew calendar (molad, postponements,
// Adar I/II), and the month and weekday names of fr de es it pt ar in
// dt_format_lang / dt_parse_format_lang.
//
// Expected values (generated, not computed by Fid): ICU 77.1 through Node
// 24 (islamic-civil, islamic-tbla, CLDR 47 names: the CLDR babel 2.17
// ships); .NET's HebrewCalendar and HijriCalendar; the other Islamic rules
// counted year by year from their lists of leap years; the molad of Tishri
// 5786..5790 as chabad.org publishes it. (ICU's Hebrew calendar is not
// used: it puts 1 Tishri 5807 on 2046-10-02, a day after .NET, Reingold's
// algorithm and the four postponements.) A wrong answer panics.
//
// Expected output:
// islamic ok
// hebrew ok
// names ok
// lunar calendars ok
use calendar;
use datetime;
use time;

fn check(label: str, got: str, want: str) {
    if !str_equal(got, want) {
        println(label + ": got " + got + ", want " + want);
        p_panic("lunar: wrong " + label);
    }
}

fn check_i(label: str, got: i64, want: i64) {
    if got != want {
        println(label + ": got " + int_to_str(got) + ", want " + int_to_str(want));
        p_panic("lunar: wrong " + label);
    }
}

fn check_b(label: str, got: bool, want: bool) {
    if got != want {
        p_panic("lunar: wrong " + label);
    }
}

// ── Islamic helpers ──

fn isl(g: str, z: i64, civil: str, astro: str) {
    check("gregorian " + g, cal_date_str(cal_civil_from_days(z)), g);
    val c: CalDate = cal_days_to_islamic(z);
    check("civil islamic of " + g, cal_date_str(c), civil);
    check_i("civil islamic back " + g, cal_islamic_to_days(c.year, c.month, c.day), z);
    val a: CalDate = cal_days_to_islamic_rule(z, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL);
    check("astronomical islamic of " + g, cal_date_str(a), astro);
    check_i("astronomical islamic back " + g, cal_islamic_to_days_rule(a.year, a.month, a.day, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), z);
}

fn islamic_year_length(y: i64, rule: i64) -> i64 {
    return cal_islamic_to_days_rule(y + 1, 1, 1, rule, CAL_ISLAMIC_EPOCH_CIVIL) - cal_islamic_to_days_rule(y, 1, 1, rule, CAL_ISLAMIC_EPOCH_CIVIL);
}

fn leap_years(name: str, rule: i64, want: str) {
    var s: str = "";
    var y: i64 = 1;
    while y <= 30 {
        if cal_islamic_is_leap_rule(y, rule) {
            if str_len(s) > 0 {
                s = s + " ";
            }
            s = s + int_to_str(y);
        }
        // the cycle repeats, below year 1 too
        check_b(name + " cycle", cal_islamic_is_leap_rule(y + 1410, rule), cal_islamic_is_leap_rule(y, rule));
        check_b(name + " cycle below 1", cal_islamic_is_leap_rule(y - 60, rule), cal_islamic_is_leap_rule(y, rule));
        var ylen: i64 = 354;
        if cal_islamic_is_leap_rule(y, rule) {
            ylen = 355;
        }
        check_i(name + " year length", islamic_year_length(y, rule), ylen);
        y = y + 1;
    }
    check(name + " leap years", s, want);
    // a 30-year cycle is 10631 days
    check_i(name + " cycle length", cal_islamic_to_days_rule(1471, 1, 1, rule, CAL_ISLAMIC_EPOCH_CIVIL) - cal_islamic_to_days_rule(1441, 1, 1, rule, CAL_ISLAMIC_EPOCH_CIVIL), 10631);
}

fn islamic_round_trip(name: str, rule: i64) {
    var z: i64 = cal_islamic_to_days_rule(1445, 1, 1, rule, CAL_ISLAMIC_EPOCH_CIVIL);
    val stop: i64 = cal_islamic_to_days_rule(1448, 1, 1, rule, CAL_ISLAMIC_EPOCH_CIVIL);
    var firsts: i64 = 0;
    while z < stop {
        val d: CalDate = cal_days_to_islamic_rule(z, rule, CAL_ISLAMIC_EPOCH_CIVIL);
        if !cal_islamic_is_valid_rule(d.year, d.month, d.day, rule) {
            p_panic("lunar: " + name + ": invalid date " + cal_date_str(d));
        }
        if cal_islamic_to_days_rule(d.year, d.month, d.day, rule, CAL_ISLAMIC_EPOCH_CIVIL) != z {
            p_panic("lunar: " + name + ": round trip broke at day " + int_to_str(z));
        }
        if d.day == 1 {
            firsts = firsts + 1;
        }
        z = z + 1;
    }
    check_i(name + " months in 3 years", firsts, 36);
}

// ── Hebrew helpers ──

fn hny(y: i64, want: str, len: i64) {
    check("1 Tishri " + int_to_str(y), cal_date_str(cal_civil_from_days(cal_hebrew_new_year(y))), want);
    check_i("length of " + int_to_str(y), cal_hebrew_year_length(y), len);
    check_i("1 Tishri " + int_to_str(y) + " as a date", cal_hebrew_to_days(y, 7, 1), cal_hebrew_new_year(y));
}

fn heb(y: i64, m: i64, d: i64, want: str) {
    val g: str = cal_date_str(cal_date_of(y, m, d));
    val h: CalDate = cal_gregorian_to_hebrew(y, m, d);
    check("hebrew of " + g, cal_date_str(h), want);
    check("gregorian of " + want, cal_date_str(cal_hebrew_to_gregorian(h.year, h.month, h.day)), g);
}

fn cal_date_of(y: i64, m: i64, d: i64) -> CalDate {
    return cal_civil_from_days(cal_days_from_civil(y, m, d));
}

fn molad(y: i64, day: str, parts: i64) {
    var(md, mp) = cal_hebrew_molad(y);
    check("molad day " + int_to_str(y), cal_date_str(cal_civil_from_days(md)), day);
    check_i("molad parts " + int_to_str(y), mp, parts);
}

// ── Name helpers ──

fn names(lang: str, y: i64, m: i64, d: i64, want: str) {
    check(lang + " names of " + int_to_str(m) + "/" + int_to_str(d), dt_format_lang(time_from_date(y, m, d), "%A|%B|%a|%b", lang), want);
}

fn parsed_lang(label: str, s: str, fmt: str, lang: str, want: i64) {
    var(ok, ts) = dt_parse_format_lang(s, fmt, lang);
    if !ok {
        p_panic("lunar: " + label + ": \"" + s + "\" was refused");
    }
    check_i(label, ts, want);
}

fn refused_lang(label: str, s: str, fmt: str, lang: str) {
    var(ok, ts) = dt_parse_format_lang(s, fmt, lang);
    if ok {
        p_panic("lunar: " + label + ": \"" + s + "\" was accepted as " + int_to_str(ts));
    }
}

fn main() -> i64 {
    // ── Islamic ──
    // the civil calendar (ICU islamic-civil) and the astronomical one (ICU islamic-tbla, .NET HijriCalendar)
    isl("0622-07-19", -492148, "0001-01-01", "0001-01-02");
    isl("0622-07-18", -492149, "0000-12-29", "0001-01-01");
    isl("1900-01-01", -25567, "1317-08-28", "1317-08-29");
    isl("1970-01-01", 0, "1389-10-22", "1389-10-23");
    isl("2000-01-01", 10957, "1420-09-24", "1420-09-25");
    isl("2024-03-11", 19793, "1445-09-01", "1445-09-02");
    isl("2026-02-18", 20502, "1447-09-01", "1447-09-02");
    isl("2026-03-20", 20532, "1447-10-01", "1447-10-02");
    isl("2026-11-17", 20774, "1448-06-06", "1448-06-07");
    isl("2027-05-16", 20954, "1448-12-09", "1448-12-10");
    isl("2052-02-20", 30000, "1474-06-19", "1474-06-20");
    isl("1582-10-15", -141427, "0990-09-17", "0990-09-18");
    isl("1000-01-01", -354285, "0390-01-15", "0390-01-16");
    isl("2100-12-31", 47846, "1524-10-29", "1524-11-01");
    isl("2077-11-16", 39401, "1500-12-29", "1501-01-01");
    // 1 Muharram by .NET HijriCalendar (the Thursday epoch) and the year lengths
    check_i("hijri new year 1", cal_islamic_to_days_rule(1, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), -492149);
    check_i("hijri year length 1", islamic_year_length(1, CAL_ISLAMIC_II), 354);
    check_i("hijri new year 2", cal_islamic_to_days_rule(2, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), -491795);
    check_i("hijri year length 2", islamic_year_length(2, CAL_ISLAMIC_II), 355);
    check_i("hijri new year 100", cal_islamic_to_days_rule(100, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), -457067);
    check_i("hijri year length 100", islamic_year_length(100, CAL_ISLAMIC_II), 355);
    check_i("hijri new year 1000", cal_islamic_to_days_rule(1000, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), -138137);
    check_i("hijri year length 1000", islamic_year_length(1000, CAL_ISLAMIC_II), 355);
    check_i("hijri new year 1389", cal_islamic_to_days_rule(1389, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), -288);
    check_i("hijri year length 1389", islamic_year_length(1389, CAL_ISLAMIC_II), 354);
    check_i("hijri new year 1444", cal_islamic_to_days_rule(1444, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), 19202);
    check_i("hijri year length 1444", islamic_year_length(1444, CAL_ISLAMIC_II), 354);
    check_i("hijri new year 1445", cal_islamic_to_days_rule(1445, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), 19556);
    check_i("hijri year length 1445", islamic_year_length(1445, CAL_ISLAMIC_II), 355);
    check_i("hijri new year 1446", cal_islamic_to_days_rule(1446, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), 19911);
    check_i("hijri year length 1446", islamic_year_length(1446, CAL_ISLAMIC_II), 354);
    check_i("hijri new year 1447", cal_islamic_to_days_rule(1447, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), 20265);
    check_i("hijri year length 1447", islamic_year_length(1447, CAL_ISLAMIC_II), 355);
    check_i("hijri new year 1448", cal_islamic_to_days_rule(1448, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), 20620);
    check_i("hijri year length 1448", islamic_year_length(1448, CAL_ISLAMIC_II), 354);
    check_i("hijri new year 1500", cal_islamic_to_days_rule(1500, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_ASTRONOMICAL), 39047);
    check_i("hijri year length 1500", islamic_year_length(1500, CAL_ISLAMIC_II), 354);
    // the other leap-year rules: 1 Muharram counted year by year from the lists of leap years
    leap_years("CAL_ISLAMIC_I", CAL_ISLAMIC_I, "2 5 7 10 13 15 18 21 24 26 29");
    check_i("CAL_ISLAMIC_I 1 Muharram 2", cal_islamic_to_days_rule(2, 1, 1, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL), -491794);
    check_i("CAL_ISLAMIC_I 1 Muharram 9", cal_islamic_to_days_rule(9, 1, 1, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL), -489313);
    check_i("CAL_ISLAMIC_I 1 Muharram 30", cal_islamic_to_days_rule(30, 1, 1, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL), -481871);
    check_i("CAL_ISLAMIC_I 1 Muharram 31", cal_islamic_to_days_rule(31, 1, 1, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL), -481517);
    check_i("CAL_ISLAMIC_I 1 Muharram 61", cal_islamic_to_days_rule(61, 1, 1, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL), -470886);
    check_i("CAL_ISLAMIC_I 1 Muharram 1000", cal_islamic_to_days_rule(1000, 1, 1, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL), -138136);
    check_i("CAL_ISLAMIC_I 1 Muharram 1445", cal_islamic_to_days_rule(1445, 1, 1, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL), 19557);
    check_i("CAL_ISLAMIC_I 1 Muharram 1446", cal_islamic_to_days_rule(1446, 1, 1, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL), 19912);
    check_i("CAL_ISLAMIC_I 1 Muharram 1447", cal_islamic_to_days_rule(1447, 1, 1, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL), 20266);
    check_i("CAL_ISLAMIC_I 1 Muharram 1448", cal_islamic_to_days_rule(1448, 1, 1, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL), 20621);
    check_i("CAL_ISLAMIC_I 1 Muharram 1450", cal_islamic_to_days_rule(1450, 1, 1, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL), 21329);
    check("CAL_ISLAMIC_I day after 29 Dhu al-Hijjah 1447", cal_date_str(cal_days_to_islamic_rule(20620, CAL_ISLAMIC_I, CAL_ISLAMIC_EPOCH_CIVIL)), "1447-12-30");
    leap_years("CAL_ISLAMIC_II", CAL_ISLAMIC_II, "2 5 7 10 13 16 18 21 24 26 29");
    check_i("CAL_ISLAMIC_II 1 Muharram 2", cal_islamic_to_days_rule(2, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL), -491794);
    check_i("CAL_ISLAMIC_II 1 Muharram 9", cal_islamic_to_days_rule(9, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL), -489313);
    check_i("CAL_ISLAMIC_II 1 Muharram 30", cal_islamic_to_days_rule(30, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL), -481871);
    check_i("CAL_ISLAMIC_II 1 Muharram 31", cal_islamic_to_days_rule(31, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL), -481517);
    check_i("CAL_ISLAMIC_II 1 Muharram 61", cal_islamic_to_days_rule(61, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL), -470886);
    check_i("CAL_ISLAMIC_II 1 Muharram 1000", cal_islamic_to_days_rule(1000, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL), -138136);
    check_i("CAL_ISLAMIC_II 1 Muharram 1445", cal_islamic_to_days_rule(1445, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL), 19557);
    check_i("CAL_ISLAMIC_II 1 Muharram 1446", cal_islamic_to_days_rule(1446, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL), 19912);
    check_i("CAL_ISLAMIC_II 1 Muharram 1447", cal_islamic_to_days_rule(1447, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL), 20266);
    check_i("CAL_ISLAMIC_II 1 Muharram 1448", cal_islamic_to_days_rule(1448, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL), 20621);
    check_i("CAL_ISLAMIC_II 1 Muharram 1450", cal_islamic_to_days_rule(1450, 1, 1, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL), 21329);
    check("CAL_ISLAMIC_II day after 29 Dhu al-Hijjah 1447", cal_date_str(cal_days_to_islamic_rule(20620, CAL_ISLAMIC_II, CAL_ISLAMIC_EPOCH_CIVIL)), "1447-12-30");
    leap_years("CAL_ISLAMIC_III", CAL_ISLAMIC_III, "2 5 8 10 13 16 19 21 24 27 29");
    check_i("CAL_ISLAMIC_III 1 Muharram 2", cal_islamic_to_days_rule(2, 1, 1, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL), -491794);
    check_i("CAL_ISLAMIC_III 1 Muharram 9", cal_islamic_to_days_rule(9, 1, 1, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL), -489313);
    check_i("CAL_ISLAMIC_III 1 Muharram 30", cal_islamic_to_days_rule(30, 1, 1, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL), -481871);
    check_i("CAL_ISLAMIC_III 1 Muharram 31", cal_islamic_to_days_rule(31, 1, 1, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL), -481517);
    check_i("CAL_ISLAMIC_III 1 Muharram 61", cal_islamic_to_days_rule(61, 1, 1, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL), -470886);
    check_i("CAL_ISLAMIC_III 1 Muharram 1000", cal_islamic_to_days_rule(1000, 1, 1, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL), -138136);
    check_i("CAL_ISLAMIC_III 1 Muharram 1445", cal_islamic_to_days_rule(1445, 1, 1, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL), 19557);
    check_i("CAL_ISLAMIC_III 1 Muharram 1446", cal_islamic_to_days_rule(1446, 1, 1, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL), 19912);
    check_i("CAL_ISLAMIC_III 1 Muharram 1447", cal_islamic_to_days_rule(1447, 1, 1, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL), 20266);
    check_i("CAL_ISLAMIC_III 1 Muharram 1448", cal_islamic_to_days_rule(1448, 1, 1, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL), 20620);
    check_i("CAL_ISLAMIC_III 1 Muharram 1450", cal_islamic_to_days_rule(1450, 1, 1, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL), 21329);
    check("CAL_ISLAMIC_III day after 29 Dhu al-Hijjah 1447", cal_date_str(cal_days_to_islamic_rule(20620, CAL_ISLAMIC_III, CAL_ISLAMIC_EPOCH_CIVIL)), "1448-01-01");
    leap_years("CAL_ISLAMIC_IV", CAL_ISLAMIC_IV, "2 5 8 11 13 16 19 21 24 27 30");
    check_i("CAL_ISLAMIC_IV 1 Muharram 2", cal_islamic_to_days_rule(2, 1, 1, CAL_ISLAMIC_IV, CAL_ISLAMIC_EPOCH_CIVIL), -491794);
    check_i("CAL_ISLAMIC_IV 1 Muharram 9", cal_islamic_to_days_rule(9, 1, 1, CAL_ISLAMIC_IV, CAL_ISLAMIC_EPOCH_CIVIL), -489313);
    check_i("CAL_ISLAMIC_IV 1 Muharram 30", cal_islamic_to_days_rule(30, 1, 1, CAL_ISLAMIC_IV, CAL_ISLAMIC_EPOCH_CIVIL), -481872);
