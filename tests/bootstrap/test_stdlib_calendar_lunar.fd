    heb(2100, 12, 31, "5861-09-29");
    heb(2239, 9, 29, "5999-06-29");
    // the molad of Tishri, as chabad.org publishes it (Jerusalem time):
    // 5786 Monday 18 h 187 p (from 6 p.m. Sunday), 5787 Friday 2026-09-11 8:59 p.m. and 1 part,
    // 5788 Thursday 2027-09-30 6:31 p.m. and 14, 5789 Tuesday 2028-09-19 3:20 a.m. and 8,
    // 5790 Saturday 2029-09-08 12:09 p.m. and 2 (a minute is 18 parts)
    molad(5786, "2025-09-22", 19627);
    molad(5787, "2026-09-12", 3223);
    molad(5788, "2027-10-01", 572);
    molad(5789, "2028-09-19", 10088);
    molad(5790, "2029-09-08", 19604);
    check_b("5784 leap", cal_hebrew_is_leap(5784), true);
    check_b("5785 common", cal_hebrew_is_leap(5785), false);
    check_b("5787 leap", cal_hebrew_is_leap(5787), true);
    check_i("months of 5784", cal_hebrew_months_in_year(5784), 13);
    check_i("months of 5785", cal_hebrew_months_in_year(5785), 12);
    check("Adar I", cal_hebrew_month_name(5784, 12), "Adar I");
    check("Adar II", cal_hebrew_month_name(5784, 13), "Adar II");
    check("Adar", cal_hebrew_month_name(5785, 12), "Adar");
    check("no Adar II", cal_hebrew_month_name(5785, 13), "");
    check("Tishri", cal_hebrew_month_name(5785, 7), "Tishri");
    check_b("13th month of a common year", cal_hebrew_is_valid(5785, 13, 1), false);
    check_b("30 Adar I", cal_hebrew_is_valid(5784, 12, 30), true);
    check_b("30 Adar", cal_hebrew_is_valid(5785, 12, 30), false);
    // 5785 is complete (355 days): Heshvan and Kislev have 30; 5784 is deficient (383): both 29
    check_i("Heshvan 5785", cal_hebrew_days_in_month(5785, 8), 30);
    check_i("Kislev 5785", cal_hebrew_days_in_month(5785, 9), 30);
    check_i("Heshvan 5784", cal_hebrew_days_in_month(5784, 8), 29);
    check_i("Kislev 5784", cal_hebrew_days_in_month(5784, 9), 29);
    check_i("Elul", cal_hebrew_days_in_month(5785, 6), 29);
    check_i("month 0", cal_hebrew_days_in_month(5785, 0), 0);
    check_i("epoch", cal_jdn_from_days(cal_hebrew_new_year(1)), CAL_HEBREW_EPOCH_JDN);
    check("epoch in Julian", cal_date_str(cal_days_to_julian(cal_hebrew_new_year(1))), "-3760-10-07");
    // a Rosh Hashanah is never on a Sunday, Wednesday or Friday, and every
    // year is 353..355 or 383..385 days, its months adding up to it
    var y: i64 = 5600;
    while y < 5900 {
        val wd: i64 = cal_iso_weekday(cal_hebrew_new_year(y));
        if wd == 7 || wd == 3 || wd == 5 {
            p_panic("lunar: Rosh Hashanah " + int_to_str(y) + " on weekday " + int_to_str(wd));
        }
        val len: i64 = cal_hebrew_year_length(y);
        var want_months: i64 = 12;
        if cal_hebrew_is_leap(y) {
            want_months = 13;
        }
        if !((len >= 353 && len <= 355 && want_months == 12) || (len >= 383 && len <= 385 && want_months == 13)) {
            p_panic("lunar: year " + int_to_str(y) + " has " + int_to_str(len) + " days");
        }
        if y % 10 == 0 {
            var sum: i64 = 0;
            var m: i64 = 1;
            while m <= want_months {
                sum = sum + cal_hebrew_days_in_month(y, m);
                m = m + 1;
            }
            check_i("months of " + int_to_str(y), sum, len);
        }
        y = y + 1;
    }
    // every day of five years, 5783..5787, round trips
    var z: i64 = cal_hebrew_new_year(5783);
    val stop: i64 = cal_hebrew_new_year(5788);
    var firsts: i64 = 0;
    while z < stop {
        val h: CalDate = cal_days_to_hebrew(z);
        if !cal_hebrew_is_valid(h.year, h.month, h.day) {
            p_panic("lunar: invalid Hebrew date " + cal_date_str(h));
        }
        if cal_hebrew_to_days(h.year, h.month, h.day) != z {
            p_panic("lunar: Hebrew round trip broke at day " + int_to_str(z));
        }
        if h.day == 1 {
            firsts = firsts + 1;
        }
        z = z + 1;
    }
    // 5784 and 5787 are leap years
    check_i("months in five years", firsts, 62);
    println("hebrew ok");

