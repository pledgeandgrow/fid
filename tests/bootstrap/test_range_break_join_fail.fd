// BG132 (Nov 24): expected to fail at run time (integer overflow). The
// block after the loop is entered from the loop test (`x >= 10` there) and
// from the early `break`, a forward edge laid out after it, which never
// carries `x >= 10`. compiler/checks.fd peir_join_set took that `break`
// block for a back edge and kept the fact (x is a parameter, defined in no
// block), so `x - 10` lost its overflow check: the C build printed
// 9223372036854775798 for f(i64::MIN, 0). Only a predecessor the join
// dominates is a back edge now; the `break` empties the join.

fn f(x: i64, y: i64) -> i64 {
    var k: i64 = 0;
    while x < 10 {
        if k == y {
            break;
        }
        k = k + 1;
    }
    return x - 10;
}

fn main() {
    println(f(20, 0));
    println(f(0 - 9223372036854775807 - 1, 0));
    print("unreachable\n");
}
