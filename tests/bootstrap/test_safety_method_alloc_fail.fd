// expect-error: is @no-alloc but uses .push(), which allocates
// Test: @no-alloc sees method calls (release L1). `v.push(x)` and
// `Vec::new()` used to pass because the check read only free-function
// names.

@no-alloc
fn fill(v: &mut Vec<i64>, n: i64) {
    var i: i64 = 0;
    while i < n {
        v.push(i);
        i = i + 1;
    }
}

fn main() {
    var v: Vec<i64> = Vec::new();
    fill(&mut v, 3);
    println(v.len());
}
