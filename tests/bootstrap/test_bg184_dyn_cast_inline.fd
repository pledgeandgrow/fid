// Bugs roadmap BG184 (its note): a method called on a cast to `dyn` used
// inline, `(q as dyn Corner).corner()`, did not build for any result type
// (C: "call to undeclared function 'dyn_get'"; run: "Unknown function
// 'dyn_get'"). The dyn value MakeDyn makes was typed a bare `dyn`, so the
// call was not seen as a dynamic one and went to `dyn_<method>`. lower.fd
// Expr::Cast types it `dyn:<Trait>`, as a `dyn` variable is.
//
// Expected output:
// 8
// 4 7
// 5 9
// 3

cap Corner {
    fn get(self) -> i64;
    fn corner(self) -> V2;
}

struct V2 {
    x: i64,
    y: i64,
}

struct Sq {
    s: i64,
}

struct Re {
    w: i64,
    h: i64,
}

impl Corner for Sq {
    fn get(self) -> i64 {
        return self.s * 2;
    }
    fn corner(self) -> V2 {
        return V2 { x: self.s, y: 7 };
    }
}

impl Corner for Re {
    fn get(self) -> i64 {
        return self.w - self.h;
    }
    fn corner(self) -> V2 {
        return V2 { x: self.w, y: self.h };
    }
}

fn main() -> i64 {
    val q = Sq { s: 4 };
    val r = Re { w: 5, h: 2 };
    println((q as dyn Corner).get());
    val c = (q as dyn Corner).corner();
    println(f"{c.x} {c.y}");
    val d = (Re { w: 5, h: 9 } as dyn Corner).corner();
    println(f"{d.x} {d.y}");
    println((r as dyn Corner).get());
    return 0;
}
