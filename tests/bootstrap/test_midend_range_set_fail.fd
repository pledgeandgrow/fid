// LF8 (llvm-roadmap, Nov 17): the range set's join of
// test_midend_range_set.fd keeps a fact only when every way in carries
// one. Here the second way in bounds i from below only (i >= 10), so the
// join gives i no upper bound (compiler/checks.fd peir_join_set): the
// multiply keeps its overflow check, and it fires for i = 100000.
// Expected: prints 7000000000000000, then an overflow panic (exit status
// not 0).

fn hull(i: i64, flag: bool) -> i64 {
    if flag {
        if i < 0 {
            return 0;
        }
        if i > 1000 {
            return 0;
        }
    } else {
        if i < 10 {
            return 1;
        }
    }
    // the second way in gives no upper bound
    return i * 1000000000000000;
}

fn main() {
    println(hull(7, true));
    println(hull(100000, false));
}
