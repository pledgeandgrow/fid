// OP9, OP25 (compiler/iropt.fd iro_licm_loop, pass `licm`; calls:
// FID_IROPT_OFF=licmcall): what moves out of a loop on the native path.
// - header_arith: `n - 1` in the loop's test is integer arithmetic that
//   may panic; it sits in the header with nothing before it that a program
//   could see, so it moves to the block before the loop, with its constant.
// - header_call: `tri(n)` in the test calls a function that, transitively,
//   reads, writes and allocates nothing (iro_effect_masks): it is computed
//   once before the loop instead of on every test.
// - header_reads: `read_lim()` reads a global the loop writes: it stays,
//   so the loop runs to the new limit.
// - body_div: `100 / k` is in the body, which may not run (k is 0): it
//   stays, so no division by zero is raised.
// - header_after_print: `tri(n)` comes after a call that prints in the
//   header, so it does not move ahead of it (the output keeps its order).
// The program prints the same with the passes on and off.
//
// Expected output:
// 9
// 45
// 6
// 0
// 300
// test 0
// test 1
// test 2
// test 3
// 3

var g_lim: i64 = 3;

fn tri(n: i64) -> i64 {
    var s: i64 = 0;
    var k: i64 = 0;
    while k < n {
        s = s + k;
        k = k + 1;
    }
    return s;
}

fn read_lim() -> i64 {
    return g_lim;
}

fn note(i: i64) -> i64 {
    print("test ");
    println(i);
    return i;
}

fn header_arith(n: i64) -> i64 {
    var i: i64 = 0;
    while i < n - 1 {
        i = i + 1;
    }
    return i;
}

fn header_call(n: i64) -> i64 {
    var i: i64 = 0;
    var c: i64 = 0;
    while i < tri(n) {
        i = i + 1;
        c = c + 1;
    }
    return c;
}

fn header_reads() -> i64 {
    var i: i64 = 0;
    while i < read_lim() {
        i = i + 1;
        if i == 3 {
            g_lim = 6;
        }
    }
    return i;
}

fn body_div(n: i64, k: i64) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if k != 0 {
            t = t + 100 / k;
        }
        i = i + 1;
    }
    return t;
}

fn header_after_print(n: i64) -> i64 {
    var i: i64 = 0;
    while note(i) < tri(n) {
        i = i + 1;
    }
    return i;
}

fn main() {
    println(header_arith(10));
    println(header_call(10));
    println(header_reads());
    println(body_div(5, 0));
    println(body_div(3, 1));
    println(header_after_print(3));
}
