// expect-error: Taint error: function 'normalize' is @tainted: it returns a value derived from its parameter 'raw' without a sanitizer
// Roadmap Phase 12 (rm-P12): returning a value derived from @tainted input
// from a function not marked @tainted would hand the caller untrusted data
// that looks clean.

fn normalize(@tainted raw: str) -> str {
    val t: str = str_trim(raw);
    return str_to_lower(t);
}

fn main() {
    println(normalize("  ABC "));
}
