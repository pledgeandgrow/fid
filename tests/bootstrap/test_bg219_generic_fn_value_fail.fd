// expect-error: cannot be taken as a value
// BG219 (docs/roadmap/bugs-roadmap.md): a generic function taken as a
// value skips its bound and failed at run time ("CallPtr: null function
// value"). Its type parameters would never be chosen: an error.
cap A {
    fn ok(self) -> i64;
}

struct N {
    v: i64,
}

impl A for N {
    fn ok(self) -> i64 {
        return self.v;
    }
}

fn need<T: A>(x: T) -> i64 {
    return x.ok();
}

fn main() -> i64 {
    val f = need;
    println(f(N { v: 5 }));
    return 0;
}
