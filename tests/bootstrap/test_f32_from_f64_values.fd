// Bugs roadmap BG137 and BG165: lowering leaves a float literal an f64
// ConstFloat where the target is f32 (`val ff: f32 = 0.1`, `takes(1.5)`,
// `return 2.5;` from an f32 function, `v.push(1.5)` on a Vec<f32>, `a * 2.0`
// with a: f32). `fid wasm` stored, passed and computed with the f64's low 32
// bits (0, NaN, false) and the machine layer (nat_ir) passed and returned
// them (0): each now narrows the f64 to f32 there (wasm f32.demote_f64; the
// f32 operation with an f64 operand computed in f64, then narrowed, as C).
// No `as f32` anywhere.
//
// Expected output:
// 1.5
// 2.5
// 1.5
// 0.10000000149011612
// 3
// true
// 0.25
// 1.5
// 3.5
// 4.5
// 5.5
// 2.5
// 3
// 9.5
fn takes(x: f32) -> f64 {
    return x as f64;
}

fn mk() -> f32 {
    return 2.5;
}

fn half(x: f32) -> f32 {
    return x / 2.0;
}

fn sum3(a: f32, b: i64, c: f32) -> f64 {
    return (a as f64) + (b as f64) + (c as f64);
}

fn main() -> i64 {
    println(takes(1.5));
    println(mk() as f64);
    println(half(3.0) as f64);
    val ff: f32 = 0.1;
    println(ff);
    val a: f32 = 1.5;
    val b: f32 = a * 2.0;
    println(b as f64);
    println(b > a);
    val q: f32 = 0.5;
    val r: f32 = q * q;
    println(r as f64);
    val v: Vec<f32> = Vec::new();
    v.push(1.5);
    v.push(2.5);
    println(v[0] as f64);
    v.set(0, 3.5);
    println(v[0] as f64);
    v.insert(0, 4.5);
    println(v[0] as f64);
    v[1] = 5.5;
    println(v[1] as f64);
    println(v[2] as f64);
    println(v.len());
    println(sum3(1.5, 3, 5.0));
    return 0;
}
