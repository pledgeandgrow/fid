// BG362 (docs/roadmap/bugs-roadmap.md): `fid run`'s panic trace (and the
// --crash-file report) printed each function with the line of its call in
// the caller: "c at line 6" when line 6 is in b, and main with no line.
// Now each frame shows the line it is at: c at line 14 (the division), b at
// line 18, a at line 22, main at line 27. stdout and the exit code are
// checked here; the trace (stderr) is checked by
// tests/tooling/bg362-trace-lines-check.sh.
//
// Expected output:
// start
// Expected exit: 1

fn c(x: i64) -> i64 {
    return 10 / x;
}

fn b(x: i64) -> i64 {
    return c(x) + 1;
}

fn a(x: i64) -> i64 {
    return b(x) + 1;
}

fn main() {
    println("start");
    val r: i64 = a(0);
    println(f"{r}");
}
