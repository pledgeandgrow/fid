// Bugs roadmap BG153: arguments of a bare type parameter are checked
// against the receiver's type arguments; ones of the right type stay
// accepted.
//
// Expected output:
// 6
// ok
// 5
// 7

struct Cell<T> {
    v: T,
}

impl<T> Cell<T> {
    fn or_this(self: Cell<T>, x: T) -> T {
        return x;
    }
}

fn main() -> i64 {
    val c: Cell<i64> = Cell { v: 1 };
    println(c.or_this(5) + 1);
    val d: Cell<str> = Cell { v: "no" };
    println(d.or_this("ok"));
    val o: Option<i64> = Option::None;
    println(o.unwrap_or(5));
    val r: Result<i64, str> = Result::Ok(7);
    println(r.unwrap_or(0));
    return 0;
}
