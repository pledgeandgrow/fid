// expect-error: function 'meters_add' parameter 2 expects
// Expected to FAIL (complaint CL10): metres added to seconds. Each unit of
// stdlib units is its own type, so the mix is a compile error.
use units;

fn main() -> i64 {
    val d: Meters = meters(100.0);
    val t: Seconds = seconds(10.0);
    val wrong: Meters = meters_add(d, t);
    println(int_to_str(wrong.value as i64));
    return 0;
}
