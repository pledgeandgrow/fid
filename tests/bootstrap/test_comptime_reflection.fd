// L8F: Comptime reflection — field_offset, struct_size, enum_discriminant
// Tests the new comptime reflection operations.

struct Point {
    x: i64,
    y: i64,
    label: str,
}

enum Color {
    Red,
    Green,
    Blue,
}

fn main() {
    // struct_size — total size of Point (x:8 + y:8 + label:8 = 24)
    val sz = comptime struct_size(Point);
    print(sz);

    // field_offset — offset of Point.y (x is 8 bytes, so y is at offset 8)
    val off_y = comptime field_offset(Point.y);
    print(off_y);

    // field_offset — offset of Point.label (x:8 + y:8 = 16, aligned to 8 = 16)
    val off_label = comptime field_offset(Point.label);
    print(off_label);

    // enum_discriminant — discriminant of Color.Green (index 1)
    val disc = comptime enum_discriminant(Color.Green);
    print(disc);

    // enum_discriminant — discriminant of Color.Blue (index 2)
    val disc2 = comptime enum_discriminant(Color.Blue);
    print(disc2);
}
