// 2g.19: assignments inside an `if` of a `comptime fn` are kept. The old
// evaluator ran an if branch in a copy of the variables, so `pick(true)`
// gave 1, not 7. Also: break / continue in for, while and loop, every
// compound assignment operator (only +=, -=, *= were known), a `val` in an
// inner block hides an outer one instead of overwriting it, and a statement
// the evaluator does not run (here a `match`) leaves the call to run with
// the program instead of being skipped (classify(0) gave 0).
// Expected output:
// 7
// 3
// 206
// 10
// 9
// 17
// 15
// 100
// 200

comptime fn pick(b: bool) -> i64 {
    var r: i64 = 1;
    if b {
        r = 7;
    } else {
        r = 3;
    }
    return r;
}

comptime fn acc(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if i % 2 == 0 {
            s = s + i;
        } else {
            s += 100;
        }
        i = i + 1;
    }
    return s;
}

comptime fn first_over(limit: i64) -> i64 {
    var found: i64 = 0;
    for i in 0..100 {
        if i * i > limit {
            found = i;
            break;
        }
    }
    return found;
}

comptime fn sum_odd(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    loop {
        i += 1;
        if i > n {
            break;
        }
        if i % 2 == 0 {
            continue;
        }
        s += i;
    }
    return s;
}

comptime fn ops() -> i64 {
    var x: i64 = 100;
    x /= 7;
    x %= 5;
    x <<= 3;
    x |= 1;
    x ^= 3;
    x &= 62;
    x >>= 1;
    return x;
}

comptime fn shadow(b: bool) -> i64 {
    var x: i64 = 1;
    var seen: i64 = 0;
    if b {
        val x: i64 = 5;
        seen = x;
    }
    return x * 10 + seen;
}

comptime fn classify(n: i64) -> i64 {
    var r: i64 = 0;
    match n {
        0 => {
            r = 100;
        }
        _ => {
            r = 200;
        }
    }
    return r;
}

fn main() -> i64 {
    val a = comptime pick(true);
    val b = comptime pick(false);
    val c = comptime acc(5);
    val d = comptime first_over(99);
    val e = comptime sum_odd(6);
    val f = comptime ops();
    val g = comptime shadow(true);
    println(a);
    println(b);
    println(c);
    println(d);
    println(e);
    println(f);
    println(g);
    println(classify(0));
    println(classify(4));
    return 0;
}
