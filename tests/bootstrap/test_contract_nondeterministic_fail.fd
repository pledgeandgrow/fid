// expect-error: Contract error: @contract 'pay' is not @deterministic
// Roadmap Phase 9 (blockchain): every node runs a contract and must reach
// the same state, so a @contract entry point is @deterministic.
@contract
@gas(1000)
fn pay(balance: i64, amount: i64) -> i64 {
    return balance - amount;
}

fn main() -> i64 {
    println(pay(10, 3));
    return 0;
}
