// VF5, expected to fail at run time. The machine layer drops the bounds
// and overflow checks compiler/checks.fd proves (`FID_NAT_OFF=unchecked`)
// and moves the panic paths of the others to cold blocks
// (`FID_NAT_OFF=coldpanic`). A loop to `v.len()` may lose its check; the
// same loop to a bound given by the caller may not: called with one more
// than the length, it must stop with the out-of-bounds panic (exit 1), not
// read the word after the buffer and print a sum. (`v.get(i)`: `v[i]`
// past the end reads 0 on the C path, miscompile V1c.)
//
// Expected output:
// 45
// 45
// 285
// Expected exit: 1

fn sum_upto(v: Vec<i64>, n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + v.get(i);
        i = i + 1;
    }
    return s;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 10 {
        v.push(i);
        i = i + 1;
    }
    var s: i64 = 0;
    for k in 0..v.len() {
        s = s + v[k];
    }
    println(s);
    println(sum_upto(v, 10));
    var q: i64 = 0;
    for k in 0..v.len() {
        q = q + v[k] * v[k];
    }
    println(q);
    println(sum_upto(v, 11));
    return 0;
}
