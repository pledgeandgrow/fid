// BG34 (bugs roadmap): an imported module's `component` (and `layer`,
// `model`, `system`, `state_machine`, `on`) declarations are kept when the
// modules are merged (compiler.fd merge_programs). Before, they were
// dropped: decl_lib::shapes's `Point` was no struct, and its functions
// over it did not type-check.
//
// Expected output:
// 3 4
// 7
use decl_lib::shapes;

fn main() -> i64 {
    val p: Point = point_at(3, 4);
    println(int_to_str(p.x) + " " + int_to_str(p.y));
    println(int_to_str(point_sum(p)));
    return 0;
}
