// LG9: `==` on a struct or enum that `comptime gen` creates compares by
// content, as on a declared one: the `__eq_` helpers are synthesized after
// the gen blocks run (compiler.fd), not only before. Before, both
// comparisons below that should hold printed false.
// Expected output:
// true
// false
// true
// false
// true
// true

fn main() -> i64 {
    comptime gen {
        return "struct GenPt { x: i64, name: str } enum GenShape { Dot(i64), Line(i64, i64), Empty }";
    }
    val a = GenPt { x: 1, name: "p" + "q" };
    val b = GenPt { x: 1, name: "pq" };
    val c = GenPt { x: 2, name: "pq" };
    println(a == b);
    println(a == c);
    val s1 = GenShape::Line(1, 2);
    val s2 = GenShape::Line(1, 2);
    val s3 = GenShape::Line(1, 3);
    println(s1 == s2);
    println(s1 == s3);
    println(GenShape::Empty == GenShape::Empty);
    println(a != c);
    return 0;
}
