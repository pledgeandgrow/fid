// BG84 (bugs roadmap): the comptime loop unroller (I-5D) counts the
// iterations of a literal range without overflow. A range ending at
// i64::MAX ran to `e + 1`, which wrapped, and every iteration was dropped.
// Expected output:
// 9223372036854775805
// 9223372036854775806
// 9223372036854775807
// done

fn main() -> i64 {
    for i in 9223372036854775805..=9223372036854775807 {
        println(int_to_str(i));
    }
    println("done");
    return 0;
}
