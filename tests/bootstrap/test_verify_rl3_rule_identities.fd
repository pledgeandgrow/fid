// RL3 (llvm-roadmap, the pass on/off matrix): one use of each rewrite rule
// of compiler/rules.fd (ru_rules, in its order), on a value the mid-end
// cannot know, so on the machine layer (`fid emit --nat`, the Linux
// targets) every rule fires at least once here (FID_RULE_STATS=1 prints
// "[rules] <rule>: <hits>"). tests/tooling/rl3-rules-off-check.sh builds it
// with each rule switched off on its own (FID_RULES_OFF=<index>) and checks
// that the rule's count drops to 0 and the output stays the same; the pass
// matrix (scripts/pass-matrix.sh round 5) does the same over the suite.
// Every backend must print the lines below, with every rule on or off.
//
// Expected output:
// x + 0 = 5
// 0 + x = 5
// x - 0 = 5
// x - x = 0
// x * 1 = 5
// 1 * x = 5
// x * 0 = 0
// 0 * x = 0
// x / 1 = 5
// x & 0 = 0
// 0 & x = 0
// x & -1 = 5
// x & x = 5
// x | 0 = 5
// 0 | x = 5
// x | x = 5
// x ^ 0 = 5
// 0 ^ x = 5
// x ^ x = 0
// x << 0 = 5
// x >> 0 = 5
// x == x: true
// x != x: false
// x < x: false
// x <= x: true
// x > x: false
// x >= x: true
// y: 13 0 13 13 0 13
// done

/// A value the optimizer cannot compute: the number of digits of `n`, plus
/// `n - 1` (5 for 5, 13 for 12).
fn opaque(n: i64) -> i64 {
    return str_len(int_to_str(n)) + n - 1;
}

fn yes(b: bool) -> str {
    if b {
        return "true";
    }
    return "false";
}

/// The same identities in a function of its own, called with a second value
fn more(y: i64) -> str {
    var a: i64 = y + 0;
    var b: i64 = y - y;
    var c: i64 = y * 1;
    var d: i64 = y | y;
    var e: i64 = y ^ y;
    var f: i64 = y >> 0;
    return int_to_str(a) + " " + int_to_str(b) + " " + int_to_str(c) + " " + int_to_str(d) + " " + int_to_str(e) + " " + int_to_str(f);
}

fn main() -> i64 {
    var x: i64 = opaque(5);
    var m1: i64 = 0 - 1;
    println("x + 0 = " + int_to_str(x + 0));
    println("0 + x = " + int_to_str(0 + x));
    println("x - 0 = " + int_to_str(x - 0));
    println("x - x = " + int_to_str(x - x));
    println("x * 1 = " + int_to_str(x * 1));
    println("1 * x = " + int_to_str(1 * x));
    println("x * 0 = " + int_to_str(x * 0));
    println("0 * x = " + int_to_str(0 * x));
    println("x / 1 = " + int_to_str(x / 1));
    println("x & 0 = " + int_to_str(x & 0));
    println("0 & x = " + int_to_str(0 & x));
    println("x & -1 = " + int_to_str(x & m1));
    println("x & x = " + int_to_str(x & x));
    println("x | 0 = " + int_to_str(x | 0));
    println("0 | x = " + int_to_str(0 | x));
    println("x | x = " + int_to_str(x | x));
    println("x ^ 0 = " + int_to_str(x ^ 0));
    println("0 ^ x = " + int_to_str(0 ^ x));
    println("x ^ x = " + int_to_str(x ^ x));
    println("x << 0 = " + int_to_str(x << 0));
    println("x >> 0 = " + int_to_str(x >> 0));
    println("x == x: " + yes(x == x));
    println("x != x: " + yes(x != x));
    println("x < x: " + yes(x < x));
    println("x <= x: " + yes(x <= x));
    println("x > x: " + yes(x > x));
    println("x >= x: " + yes(x >= x));
    println("y: " + more(opaque(12)));
    println("done");
    return 0;
}
