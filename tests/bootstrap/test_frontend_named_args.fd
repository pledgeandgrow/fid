// CL4: default and named arguments. Named arguments go to the parameter of
// their name in any order, after the positional ones; a parameter left out
// takes its default.
// Expected output:
// 111
// 211
// 1012
// 3021
// 7
// 40

fn mix(a: i64, b: i64 = 10, c: i64 = 100) -> i64 {
    return a + b * 1 + c;
}

fn place(x: i64, y: i64, z: i64 = 0) -> i64 {
    return x * 1000 + y * 10 + z;
}

fn area(w: i64, h: i64 = 4) -> i64 {
    return w * h;
}

fn main() -> i64 {
    println(mix(1));
    println(mix(1, c: 200));
    println(place(1, 1, z: 2));
    println(place(y: 2, x: 3, z: 1));
    println(mix(a: 7, b: 0, c: 0));
    println(area(h: 4, w: 10));
    return 0;
}
