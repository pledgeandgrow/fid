//! error: Borrow error: field 'v' of struct 'Holder' holds a @scoped struct, which cannot be kept.
// TL2: a test per diagnostic of the type, borrow and escape checks.
// A @scoped struct cannot be a field of another struct (release M11).

@scoped
struct View {
    text: str,
}

struct Holder {
    v: View,
}

fn main() -> i64 {
    return 0;
}
