// CL10 (fid): `+ - * / %` on a struct call its `add`, `sub`, `mul`, `div`,
// `rem` method (Rust's names), as vec2/3/4 do: `a + b` is `a.add(b)`. The
// right operand may be another type (`Money * 3`); the result is whatever
// the method returns.
// Expected output:
// 4 6
// -2 -2
// 3 8
// 12
// 1
// 6 10

struct P {
    x: i64,
    y: i64,
}

impl P {
    fn add(self: P, o: P) -> P {
        return P { x: self.x + o.x, y: self.y + o.y };
    }
    fn sub(self: P, o: P) -> P {
        return P { x: self.x - o.x, y: self.y - o.y };
    }
    fn mul(self: P, o: P) -> P {
        return P { x: self.x * o.x, y: self.y * o.y };
    }
}

struct Money {
    cents: i64,
}

impl Money {
    fn mul(self: Money, k: i64) -> Money {
        return Money { cents: self.cents * k };
    }
    fn div(self: Money, k: i64) -> Money {
        return Money { cents: self.cents / k };
    }
    fn rem(self: Money, k: i64) -> i64 {
        return self.cents % k;
    }
}

fn main() -> i64 {
    val a: P = P { x: 1, y: 2 };
    val b: P = P { x: 3, y: 4 };
    val c: P = a + b;
    println(int_to_str(c.x) + " " + int_to_str(c.y));
    val d: P = a - b;
    println(int_to_str(d.x) + " " + int_to_str(d.y));
    val e: P = a * b;
    println(int_to_str(e.x) + " " + int_to_str(e.y));
    val m: Money = Money { cents: 4 };
    val t: Money = m * 3;
    println(t.cents);
    val q: Money = t / 4;
    println(q.cents % 2 + 0 * (t % 5));
    val f: P = a + b + a + a;
    println(int_to_str(f.x) + " " + int_to_str(f.y));
    return 0;
}
