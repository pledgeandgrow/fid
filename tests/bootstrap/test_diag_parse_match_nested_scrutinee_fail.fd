// expect-error: nested patterns in match expressions need a variable scrutinee
// Expected to FAIL (CE4): a match used as a value with a nested pattern
// (`Some(Some(v))`) must match a variable; here it matches a call.
fn make() -> Option<Option<i64>> {
    return Option::Some(Option::Some(4));
}

fn main() -> i64 {
    val v: i64 = match make() {
        Option::Some(Option::Some(x)) => x,
        _ => 0,
    };
    print(v);
    return 0;
}
