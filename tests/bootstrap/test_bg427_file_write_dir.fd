// Bugs roadmap BG427: on the machine layer `p_file_write` / `p_file_append`
// reported success (0) when nothing was written: pe_write_file ignored a
// failed write, and on --nat Windows a directory opened for writing (the
// shim opened it for listing). Both are -1 now, as on run, C and pe_ir
// (stdlib/linux_runtime/base.fd pe_write_file, win.fd pe_win_open).
//
// Expected output:
// -1 -1
// 0 0 4

fn main() {
    p_mkdir("bg427_dd");
    println(f"{p_file_write("bg427_dd", "x")} {p_file_append("bg427_dd", "x")}");
    println(f"{p_file_write("bg427_f.txt", "ab")} {p_file_append("bg427_f.txt", "cd")} {p_file_size("bg427_f.txt")}");
    p_file_delete("bg427_f.txt");
    p_rmdir("bg427_dd");
}
