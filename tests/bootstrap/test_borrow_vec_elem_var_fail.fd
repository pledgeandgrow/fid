// expect-error: cannot create &mut v: a mutable borrow is already reserved on it or a related path
// Expected to FAIL (known-bugs 2g.73): `&mut v[i]` with an index that is not
// a constant may be the same element as `&mut v[0]`, so it borrows the whole
// Vec and conflicts with the element borrow.
fn swap(a: &mut i64, b: &mut i64) {
    var t: i64 = *a;
    *a = *b;
    *b = t;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    var i: i64 = 0;
    swap(&mut v[0], &mut v[i]);
    println(int_to_str(v[0]));
}
