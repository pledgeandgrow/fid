// Earlier miscompile "AGENTS 10 / known-bugs 1.7": natively built tests
// (test_collections, test_db, test_match_range, test_matrix_mul) printed
// wrong values; the cause was one wrong REX prefix byte in a hand-coded
// runtime routine. This test runs the same kinds of code on every backend:
// range patterns, a 3x3 integer matrix product, map lookups.
//
// Expected output:
// small
// medium
// large
// 30 24 18
// 84 69 54
// 138 114 90
// 2
// 0

fn size_of(n: i64) -> str {
    match n {
        0..=9 => { return "small"; }
        10..=99 => { return "medium"; }
        _ => { return "large"; }
    }
}

fn main() -> i64 {
    println(size_of(5));
    println(size_of(42));
    println(size_of(1000));
    var a: Vec<i64> = Vec::new();
    var b: Vec<i64> = Vec::new();
    var k: i64 = 1;
    while k <= 9 {
        a.push(k);
        b.push(10 - k);
        k = k + 1;
    }
    var i: i64 = 0;
    while i < 3 {
        var line: str = "";
        var j: i64 = 0;
        while j < 3 {
            var s: i64 = 0;
            var m: i64 = 0;
            while m < 3 {
                s = s + a[i * 3 + m] * b[m * 3 + j];
                m = m + 1;
            }
            if j > 0 {
                line = line + " ";
            }
            line = line + int_to_str(s);
            j = j + 1;
        }
        println(line);
        i = i + 1;
    }
    var h: HashMap<str, i64> = HashMap::new();
    h.insert("one", 1);
    h.insert("two", 2);
    println(int_to_str(h.get_or("two", 0)));
    println(int_to_str(h.get_or("three", 0)));
    return 0;
}
