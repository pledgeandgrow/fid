// VF5: removal of bounds checks in counted loops (compiler/checks.fd,
// PEIR_RANGES; the C and native paths). Indexes a loop proves in range may
// skip the check; the program must still compute the same values. The
// cases where the check must stay (the loop shrinks the Vec, the index runs
// past the end) are test_opt_ranges_pop_fail.fd and
// tests/verify/bugs/m4_c_range_check_dropped_fail.fd (fails on the C path).

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 32 { v.push(i * 3 + 1); i = i + 1; }

    var s: i64 = 0;
    for k in 0..v.len() { s = s + v[k]; }
    println(s);

    // counting down
    var d: i64 = v.len() - 1;
    var s2: i64 = 0;
    while d >= 0 {
        s2 = s2 * 3 % 1000003 + v.get(d);
        d = d - 1;
    }
    println(s2);

    // a stride of two, and an offset that stays in range
    var s3: i64 = 0;
    i = 0;
    while i + 1 < v.len() {
        s3 = s3 + v[i] * v[i + 1];
        i = i + 2;
    }
    println(s3);

    // writes in a counted loop
    for k in 0..v.len() { v.set(k, v.get(k) * 2); }
    println(v.get(0) + v.get(31));
    // (a fixed array in a counted loop: tests/verify/bugs/m5_fixed_array_literal.fd)
    return 0;
}
