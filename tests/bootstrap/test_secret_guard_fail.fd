// expect-error: depends on
// Test (known-bugs 2g.10): a match guard on a secret decides which arm
// runs, so printing in the arm reveals the secret (implicit flow).
fn f(@secret k: i64) {
    match 1 {
        1 if k > 5 => { println(1); }
        _ => { println(0); }
    }
}

fn main() { f(42); }
