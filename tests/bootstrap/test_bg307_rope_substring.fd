// BG307 (docs/roadmap/bugs-roadmap.md): rope_substring uses core's
// str_slice instead of the legacy p_string_substring builtin, which the
// default Windows backend (pe_ir) does not have, so a program that uses it
// builds with `fid emit`. The result is the bytes [start, end), clamped to
// the text.
//
// Expected output:
// el
// hello
//
// lo world
// 11
use string;

fn main() -> i64 {
    // the entry's trigger
    val r = rope_substring(rope_new("hello"), 1, 3);
    println(rope_to_str(r));
    // the whole text, an empty range, and a rope of several parts
    println(rope_to_str(rope_substring(rope_new("hello"), 0, 5)));
    println(rope_to_str(rope_substring(rope_new("hello"), 3, 3)));
    val two = rope_concat(rope_new("hello"), rope_new(" world"));
    println(rope_to_str(rope_substring(two, 3, 11)));
    println(f"{rope_len(two)}");
    return 0;
}
