// expect-error: Event error: @event 'Transfer' has a body
// Roadmap Phase 9 (F34): the compiler writes an event's body (it appends
// the event to the log), so an event is declared with an empty body.
@event
fn Transfer(from: i64, to: i64, amount: i64) {
    println(amount);
}

@emit(Transfer)
fn pay(amount: i64) {
    Transfer(1, 2, amount);
}

fn main() -> i64 {
    pay(5);
    return 0;
}
