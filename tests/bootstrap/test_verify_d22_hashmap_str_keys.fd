// Reference/compiler disagreement D22 (docs/verification/miscompile-log.md;
// repro tests/verify/bugs/d22_hashmap_str_keys_order.fd, reference §13.3,
// decided Nov 17): `keys()` gives the keys in ascending order, string keys
// byte by byte as `str_compare` (so "Zebra" < "app" < "apple"), and
// `values()` the values in that order. Before the fix (stdlib/core.fd
// HashMap_keys, "D22") string keys were sorted as words, their addresses:
// `fid run` and `fid ccompile` printed them in allocation order.
//
// Expected output:
// keys apple=2 banana=4 fig=3 pear=1
// Zebra app apple apples b
// 5 1 2 3 4
// 0

fn main() -> i64 {
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("pear", 1);
    m.insert("apple", 2);
    m.insert("fig", 3);
    m.insert("banana", 4);
    val ks: Vec<str> = m.keys();
    val vs: Vec<i64> = m.values();
    var line: str = "keys";
    var i: i64 = 0;
    while i < ks.len() {
        line = line + " " + ks.get(i) + "=" + int_to_str(vs.get(i));
        i = i + 1;
    }
    println(line);

    var w: HashMap<str, i64> = HashMap::new();
    w.insert("b", 4);
    w.insert("apples", 3);
    w.insert("apple", 2);
    w.insert("app", 1);
    w.insert("Zebra", 5);
    val wk: Vec<str> = w.keys();
    var l2: str = "";
    i = 0;
    while i < wk.len() {
        if i > 0 {
            l2 = l2 + " ";
        }
        l2 = l2 + wk.get(i);
        i = i + 1;
    }
    println(l2);
    val wv: Vec<i64> = w.values();
    var l3: str = "";
    i = 0;
    while i < wv.len() {
        if i > 0 {
            l3 = l3 + " ";
        }
        l3 = l3 + int_to_str(wv.get(i));
        i = i + 1;
    }
    println(l3);

    var e: HashMap<str, i64> = HashMap::new();
    val ek: Vec<str> = e.keys();
    println(ek.len());
    return 0;
}
