// Earlier miscompile "known-bugs 1.30": float constants lost their bit
// pattern on the C path (emitted through a short decimal text). Constants
// that a 6-digit print would change are checked through exact integer
// arithmetic.
//
// Expected output:
// 123456789012345
// 1
// 1
// 299792458
// 4503599627370497

fn main() -> i64 {
    var a: f64 = 0.123456789012345;
    println(int_to_str((a * 1000000000000000.0 + 0.5) as i64));
    var big: f64 = 1.0e300;
    var back: f64 = big / 1.0e299;
    println(int_to_str((back / 10.0 + 0.5) as i64));
    var tiny: f64 = 1.0e-300;
    println(int_to_str((tiny * 1.0e300 + 0.5) as i64));
    var c: f64 = 299792458.0;
    println(int_to_str(c as i64));
    var odd: f64 = 4503599627370497.0;
    println(int_to_str(odd as i64));
    return 0;
}
