// expect-error: `self` of method 'm' of A must be A, &A or &mut A, got B
// Bugs roadmap BG368: a method's `self` could be declared with any type:
// `impl A { fn m(self: B) }` read A's memory as a B (a header read from an
// arbitrary address on pe_ir).
struct A { a: i64, n: i64 }
struct B { b: Vec<i64> }
impl A {
    fn m(self: B) -> i64 {
        return self.b.len();
    }
}
fn main() {
    val a = A { a: 4198400, n: 2 };
    println(a.m());
}
