// stdlib/odometry: differential, mecanum and Ackermann kinematics, exact arc integration against Euler, full circle closure, covariance propagation (values from a numpy replica)
// Expected output:
// diff forward (10, 12 rad/s): v=0.5500 w=0.3333
// diff inverse: 10.0000 12.0000
// exact arc, 100 steps: (0.6366, 0.6366, 1.5708)
// exact arc, 1 step: (0.6366, 0.6366, 1.5708)
// euler, 100 steps: (0.6416, 0.6316, 1.5708)
// four quarter turns: (0.0000, 0.0000, 0.0000)
// sideways arc: (-0.6366, 0.6366, 1.5708)
// mecanum inverse: 3.2000 16.8000 11.2000 8.8000
// mecanum forward: 0.5000 0.2000 0.4000
// mecanum saturated: 1.9048 10.0000 6.6667 5.2381
// ackermann w=0.405420 delta back=0.200000
// ackermann radius=12.3329 left=0.2126 right=0.1888
// rear speeds: 4.6959 5.3041
// odom pose: (1.2986, 0.3287, 1.6667) dist=1.5000
// odom cov: 0.033650 -0.061417 -0.091408 0.164670 0.194806 0.333333
// 1000 ticks = 0.076699 m
use math;
use quat;
use lqr;
use odometry;

fn v4(v: & Vec<f64>) -> str {
    return rmath_fmt(v.get(0), 4) + " " + rmath_fmt(v.get(1), 4) + " " + rmath_fmt(v.get(2), 4) + " " + rmath_fmt(v.get(3), 4);
}

fn main() -> i64 {
    val dd: DiffDrive = DiffDrive { r: 0.05, track: 0.3 };
    val t: Twist2 = diff_forward(&dd, 10.0, 12.0);
    println("diff forward (10, 12 rad/s): v=" + rmath_fmt(t.vx, 4) + " w=" + rmath_fmt(t.wz, 4));
    val wi: Vec<f64> = diff_inverse(&dd, t.vx, t.wz);
    println("diff inverse: " + rmath_fmt(wi.get(0), 4) + " " + rmath_fmt(wi.get(1), 4));

    val pi: f64 = rmath_pi();
    var p: Pose2 = pose2(0.0, 0.0, 0.0);
    var e: Pose2 = pose2(0.0, 0.0, 0.0);
    var i: i64 = 0;
    while i < 100 {
        p = odom_integrate_vw(p, 1.0, pi / 2.0, 0.01);
        e = odom_integrate_euler(e, 1.0, pi / 2.0, 0.01);
        i = i + 1;
    }
    println("exact arc, 100 steps: " + pose2_to_str(p, 4));
    println("exact arc, 1 step: " + pose2_to_str(odom_integrate_vw(pose2(0.0, 0.0, 0.0), 1.0, pi / 2.0, 1.0), 4));
    println("euler, 100 steps: " + pose2_to_str(e, 4));
    var c: Pose2 = pose2(0.0, 0.0, 0.0);
    i = 0;
    while i < 4 {
        c = odom_integrate_vw(c, 1.0, pi / 2.0, 1.0);
        i = i + 1;
    }
    println("four quarter turns: " + pose2_to_str(c, 4));
    println("sideways arc: " + pose2_to_str(odom_integrate(pose2(0.0, 0.0, 0.0), Twist2 { vx: 0.0, vy: 1.0, wz: pi / 2.0 }, 1.0), 4));

    val mc: Mecanum = Mecanum { r: 0.05, lx: 0.2, ly: 0.15 };
    val mw: Vec<f64> = mecanum_inverse(&mc, Twist2 { vx: 0.5, vy: 0.2, wz: 0.4 });
    println("mecanum inverse: " + v4(&mw));
    val mt: Twist2 = mecanum_forward(&mc, &mw);
    println("mecanum forward: " + rmath_fmt(mt.vx, 4) + " " + rmath_fmt(mt.vy, 4) + " " + rmath_fmt(mt.wz, 4));
    val ms: Vec<f64> = mecanum_saturate(&mw, 10.0);
    println("mecanum saturated: " + v4(&ms));

    val ak: Ackermann = Ackermann { wheelbase: 2.5, track: 1.5, max_steer: 0.6 };
    val at: Twist2 = ackermann_forward(&ak, 5.0, 0.2);
    println("ackermann w=" + rmath_fmt(at.wz, 6) + " delta back=" + rmath_fmt(ackermann_inverse(&ak, 5.0, at.wz), 6));
    val wa: Vec<f64> = ackermann_wheel_angles(&ak, 0.2);
    println("ackermann radius=" + rmath_fmt(ackermann_radius(&ak, 0.2), 4) + " left=" + rmath_fmt(wa.get(0), 4) + " right=" + rmath_fmt(wa.get(1), 4));
    val rs: Vec<f64> = ackermann_rear_speeds(&ak, 5.0, 0.2);
    println("rear speeds: " + rmath_fmt(rs.get(0), 4) + " " + rmath_fmt(rs.get(1), 4));

    var o: DiffOdom = odom_diff_new(0.3, 0.01, 0.01);
    i = 0;
    while i < 10 {
        odom_diff_update(&mut o, 0.1, 0.1);
        i = i + 1;
    }
    i = 0;
    while i < 5 {
        odom_diff_update(&mut o, 0.05, 0.15);
        i = i + 1;
    }
    println("odom pose: " + pose2_to_str(o.pose, 4) + " dist=" + rmath_fmt(o.dist, 4));
    var cs: str = "odom cov:";
    var r: i64 = 0;
    while r < 3 {
        var k: i64 = r;
        while k < 3 {
            cs = cs + " " + rmath_fmt(dm_get(&o.cov, r, k), 6);
            k = k + 1;
        }
        r = r + 1;
    }
    println(cs);
    println("1000 ticks = " + rmath_fmt(odom_ticks_to_m(1000, 4096, 0.05), 6) + " m");
    return 0;
}
