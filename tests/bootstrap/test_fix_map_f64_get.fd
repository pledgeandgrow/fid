// stdlib-agent-bugs 40: HashMap<str, f64>.get used directly (an argument,
// a comparison, arithmetic) was the stored word, not the f64:
// float_to_str(h.get("Q")) printed "" in `fid run`, comparing it with an
// f64 panicked, and the C build converted the word as a number. The map
// keeps an f64's bits: get and get_or now give the f64 back.
// Expected output:
// 1.5
// 1.5
// gt
// 3.5
// 1.5
// 2.5
// -0.125
fn show(x: f64) -> str {
    return float_to_str(x);
}

struct Holder {
    m: HashMap<str, f64>,
}

fn main() {
    var h: HashMap<str, f64> = HashMap::new();
    h.insert("Q", 1.5);
    println(float_to_str(h.get("Q")));
    println(show(h.get("Q")));
    if h.get("Q") > 1.0 {
        println("gt");
    }
    val y: f64 = h.get("Q") + 2.0;
    println(float_to_str(y));
    val q: f64 = h.get("Q");
    println(float_to_str(q));
    println(float_to_str(h.get_or("Z", 2.5)));
    var hd: Holder = Holder { m: HashMap::new() };
    hd.m.insert("n", 0.0 - 0.125);
    println(float_to_str(hd.m.get("n")));
}
