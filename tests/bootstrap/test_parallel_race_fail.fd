// expect-error: 'bump' runs on another thread and writes the global 'hits' with no lock
// Bugs roadmap BG24: the branches of `parallel { }` run on OS threads,
// but the race check did not take them as threads: two branches calling
// `bump`, which writes a global with no lock, were accepted.
var hits: i64 = 0;

fn bump() -> i64 {
    hits = hits + 1;
    return hits;
}

fn main() -> i64 {
    var a: i64 = 0;
    var b: i64 = 0;
    parallel {
        | a = bump();
        | b = bump();
    }
    println(int_to_str(a + b));
    return 0;
}
