// B19: `var v = Vec::new()` written without a type takes its element type
// from a pushed variable declared earlier in the same block (not only from
// a pushed literal, RT6): a str, bool or float variable. Before, the Vec
// stayed a Vec<i64>.
// Expected output:
// hello
// true
// 2.5
// 3

fn main() {
    val word: str = "hello";
    var words = Vec::new();
    words.push(word);
    println(words.get(0));

    val flag: bool = true;
    var flags = Vec::new();
    flags.push(flag);
    println(flags.get(0));

    val half = 2.5;
    var xs = Vec::new();
    xs.push(half);
    println(xs.get(0));

    var n = Vec::new();
    n.push(3);
    println(n.get(0));
}
