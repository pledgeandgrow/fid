// stdlib/path: path text on every platform (competitive SL17): Unix and
// Windows separators, drive and UNC roots, normalization, extensions.
//
// Expected output:
// a/b
// /a/b
// c.txt|/a/b|.txt|c
// file.tar|.gz
// a/c|/a/c|..|/
// t t f f t
// C:/Users/b|C:/|C:
// //server/share/x
// report.md|C:/docs
// C:/|/|//|
// 3
use path;
use vec;

fn bs(b: bool) -> str {
    if b { return "t"; }
    return "f";
}

fn main() -> i64 {
    println(path_join("a", "b"));
    println(path_join("/a/", "/b"));
    println(path_basename("/a/b/c.txt") + "|" + path_dirname("/a/b/c.txt") + "|" + path_extension("/a/b/c.txt") + "|" + path_stem("c.txt"));
    println(path_stem("file.tar.gz") + "|" + path_extension("file.tar.gz"));
    println(path_normalize("a/./b/../c") + "|" + path_normalize("/a/b/../c") + "|" + path_normalize("../x/..") + "|" + path_normalize("/.."));
    println(bs(path_is_absolute("/x")) + " " + bs(path_is_absolute("C:\\x")) + " " + bs(path_is_absolute("C:x"))
        + " " + bs(path_is_absolute("rel/x")) + " " + bs(path_is_absolute("\\\\server\\share")));
    println(path_normalize("C:\\Users\\a\\..\\b") + "|" + path_dirname("C:\\x") + "|" + path_dirname("C:x"));
    println(path_normalize("\\\\server\\share\\.\\x"));
    println(path_basename("C:\\docs\\report.md") + "|" + path_dirname(path_normalize("C:\\docs\\report.md")));
    println(path_root("C:\\x") + "|" + path_root("/etc") + "|" + path_root("\\\\srv\\s") + "|" + path_root("rel"));
    println(path_depth("/a/b/c"));
    return 0;
}
