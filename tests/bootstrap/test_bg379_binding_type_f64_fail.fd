// expect-error: binding 'v' of pattern Option::Some is written as f64, but the payload is a i64
// Bugs roadmap BG379: `Option::Some(v: f64)` on an Option<i64> read the
// integer's bits as a float (3 printed as a denormal), in a value match too.
fn main() {
    val o: Option<i64> = Option::Some(3);
    val r: i64 = match o {
        Option::Some(v: f64) => 1,
        _ => 0,
    };
    println(r);
}
