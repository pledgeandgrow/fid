// expect-error: 'println()' does I/O (files, the console, the clock, random numbers or the environment).
// expect-error: Comptime code runs inside the compiler with no I/O: it may only compute.
// Expected to FAIL (CE4): a comptime block runs inside the compiler, so it
// may not print (CD8). The whole message: what the call does and why.
fn main() -> i64 {
    val n: i64 = comptime {
        println("compiling");
        3
    };
    println(n);
    return 0;
}
