// expect-error: allocates on the heap: string `+=`
// Bugs roadmap BG417: a region with a budget counts string `+` but did not
// count `s += t`, the same concatenation: 16 KB of text was appended in a
// region of budget(64) with no error.
fn main() -> i64 {
    var s: str = "a";
    region r with budget(64) {
        var i: i64 = 0;
        while i < 1000 {
            s += "xxxxxxxxxxxxxxxx";
            i = i + 1;
        }
    }
    println(str_len(s));
    return 0;
}
