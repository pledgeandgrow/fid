// Test: F68 parameterized queries — typed string concatenation prevention
//
// Typed strings (SQLString, ShellString, etc.) cannot be concatenated with +
// This prevents injection attacks at compile time.
// Use sql_bind(), shell_escape(), etc. instead.

use typed_strings;

fn main() {
    // SAFE: construct SQLString via sql_query()
    var sql = sql_query("SELECT * FROM users WHERE id = ?");
    print("sql = ");
    print(sql.value);
    print("\n");

    // SAFE: construct ShellString via shell_cmd()
    var cmd = shell_cmd("echo hello");
    print("cmd = ");
    print(cmd.value);
    print("\n");

    // SAFE: construct HTMLString via html_literal()
    var html = html_literal("<b>bold</b>");
    print("html = ");
    print(html.value);
    print("\n");

    // SAFE: construct PathString via path_literal()
    var path = path_literal("/usr/bin");
    print("path = ");
    print(path.value);
    print("\n");

    print("OK\n");
}
