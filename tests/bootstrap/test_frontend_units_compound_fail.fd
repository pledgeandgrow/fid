// expect-error: units of different dimensions (m and s) do not add
// CL10 (fid): `d += t` on units is `d = d + t`: metres plus seconds is the
// dimension error, through a struct field too.

@dimension(m = 1)
struct Len {
    value: f64,
}

@dimension(s = 1)
struct Time {
    value: f64,
}

struct Trip {
    dist: Len,
}

fn main() -> i64 {
    var trip: Trip = Trip { dist: Len { value: 3.0 } };
    trip.dist += Time { value: 2.0 };
    println(int_to_str(trip.dist.value as i64));
    return 0;
}
