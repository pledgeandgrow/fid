// BG428 (docs/roadmap/bugs-roadmap.md): under `fid run`, env_var of a
// variable set to the empty string and arg_at of an empty argument were
// None: the interpreter gave p_getenv / p_argv a plain empty Str, which
// compares equal to 0, so core's `r == 0` test took it for "not set"
// (known-bugs 2g.42's class). C and both native backends give Some("").
// Run plainly (as the suite does) it prints the lines below; run as
// `FID_BG428_EMPTY= fid run test_bg428_empty_env_arg.fd ''` it must print
// "some 0" and "arg 0" (tests/tooling/bg428-empty-env-arg-check.sh).
//
// Expected output:
// none
// noarg

fn main() {
    match env_var("FID_BG428_EMPTY") {
        Option::Some(v) => {
            println(f"some {str_len(v)}");
        }
        Option::None => {
            println("none");
        }
    }
    match arg_at(1) {
        Option::Some(a) => {
            println(f"arg {str_len(a)}");
        }
        Option::None => {
            println("noarg");
        }
    }
}
