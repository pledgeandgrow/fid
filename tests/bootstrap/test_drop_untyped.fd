// Test: a struct's `drop` runs at scope exit for a local with no type
// annotation, as for an annotated one (compiler/lower.fd
// Lowerer_lower_let_stmt): `val g = Guard { id: 5 };` and `val g =
// make(7);` dropped nothing (seen on pe_ir and the interpreter), while
// `val g: Guard = ...` did (test_drop.fd).
//
// Expected output:
//   in untyped 5
//   drop 5
//   in typed 6
//   drop 6
//   in call 7
//   drop 7
//   copied 5
//   drop 5
//   done

struct Guard {
    id: i64,
}

impl Guard {
    fn drop(self: &mut Guard) {
        println("drop " + int_to_str(self.id));
    }
}

fn make(id: i64) -> Guard {
    return Guard { id: id };
}

fn untyped() {
    val g = Guard { id: 5 };
    println("in untyped " + int_to_str(g.id));
}

fn typed() {
    val g: Guard = Guard { id: 6 };
    println("in typed " + int_to_str(g.id));
}

fn from_call() {
    val g = make(7);
    println("in call " + int_to_str(g.id));
}

fn copied() {
    // one drop: the copy of a variable takes no second one
    val g: Guard = Guard { id: 5 };
    val h = g;
    println("copied " + int_to_str(h.id));
}

fn main() {
    untyped();
    typed();
    from_call();
    copied();
    println("done");
}
