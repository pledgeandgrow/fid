// expect-error: cannot assign to p.x: p is borrowed
// Test: assigning a field while the struct is borrowed (release K5:
// field assignments were not checked against borrows).

struct Point {
    x: i64,
    y: i64,
}

fn main() {
    var p: Point = Point { x: 1, y: 2 };
    val r: &Point = &p;
    p.x = 5;
    println(r.x);
}
