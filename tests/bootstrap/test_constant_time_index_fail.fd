// expect-error: function 'lookup' indexes memory with secret data.
// Expected to FAIL: indexing memory with a secret leaks it through the cache.
@constant_time
fn lookup(table: Vec<i64>, k: i64) -> i64 {
    return table.get(k);
}
fn main() {
    var t: Vec<i64> = Vec::new();
    t.push(9);
    print(lookup(t, 0));
}
