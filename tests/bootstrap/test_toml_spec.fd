// valid cases (toml-test tests/valid/...)
fn valid_0() {
    ok("spec-1.0.0/array-0", "integers = [ 1, 2, 3 ]\ncolors = [ \"red\", \"yellow\", \"green\" ]\nnested_arrays_of_ints = [ [ 1, 2 ], [3, 4, 5] ]\nnested_mixed_array = [ [ 1, 2 ], [\"a\", \"b\", \"c\"] ]\nstring_array = [ \"all\", 'strings', \"\"\"are the same\"\"\", '''type''' ]\n\n# Mixed-type arrays are allowed\nnumbers = [ 0.1, 0.2, 0.5, 1, 2, 5 ]\ncontributors = [\n  \"Foo Bar <foo@example.com>\",\n  \x7b name = \"Baz Qux\", email = \"bazqux@example.com\", url = \"https://example.com/bazqux\" \x7d\n]\n",
       "\x7b\"colors\":[\x7b\"type\":\"string\",\"value\":\"red\"\x7d,\x7b\"type\":\"string\",\"value\":\"yellow\"\x7d,\x7b\"type\":\"string\",\"value\":\"green\"\x7d],\"contributors\":[\x7b\"type\":\"string\",\"value\":\"Foo Bar <foo@example.com>\"\x7d,\x7b\"email\":\x7b\"type\":\"string\",\"value\":\"bazqux@example.com\"\x7d,\"name\":\x7b\"type\":\"string\",\"value\":\"Baz Qux\"\x7d,\"url\":\x7b\"type\":\"string\",\"value\":\"https://example.com/bazqux\"\x7d\x7d],\"integers\":[\x7b\"type\":\"integer\",\"value\":\"1\"\x7d,\x7b\"type\":\"integer\",\"value\":\"2\"\x7d,\x7b\"type\":\"integer\",\"value\":\"3\"\x7d],\"nested_arrays_of_ints\":[[\x7b\"type\":\"integer\",\"value\":\"1\"\x7d,\x7b\"type\":\"integer\",\"value\":\"2\"\x7d],[\x7b\"type\":\"integer\",\"value\":\"3\"\x7d,\x7b\"type\":\"integer\",\"value\":\"4\"\x7d,\x7b\"type\":\"integer\",\"value\":\"5\"\x7d]],\"nested_mixed_array\":[[\x7b\"type\":\"integer\",\"value\":\"1\"\x7d,\x7b\"type\":\"integer\",\"value\":\"2\"\x7d],[\x7b\"type\":\"string\",\"value\":\"a\"\x7d,\x7b\"type\":\"string\",\"value\":\"b\"\x7d,\x7b\"type\":\"string\",\"value\":\"c\"\x7d]],\"numbers\":[\x7b\"type\":\"float\",\"value\":\"0.1\"\x7d,\x7b\"type\":\"float\",\"value\":\"0.2\"\x7d,\x7b\"type\":\"float\",\"value\":\"0.5\"\x7d,\x7b\"type\":\"integer\",\"value\":\"1\"\x7d,\x7b\"type\":\"integer\",\"value\":\"2\"\x7d,\x7b\"type\":\"integer\",\"value\":\"5\"\x7d],\"string_array\":[\x7b\"type\":\"string\",\"value\":\"all\"\x7d,\x7b\"type\":\"string\",\"value\":\"strings\"\x7d,\x7b\"type\":\"string\",\"value\":\"are the same\"\x7d,\x7b\"type\":\"string\",\"value\":\"type\"\x7d]\x7d");
    ok("spec-1.0.0/array-1", "integers2 = [\n  1, 2, 3\n]\n\nintegers3 = [\n  1,\n  2, # this is ok\n]\n",
       "\x7b\"integers2\":[\x7b\"type\":\"integer\",\"value\":\"1\"\x7d,\x7b\"type\":\"integer\",\"value\":\"2\"\x7d,\x7b\"type\":\"integer\",\"value\":\"3\"\x7d],\"integers3\":[\x7b\"type\":\"integer\",\"value\":\"1\"\x7d,\x7b\"type\":\"integer\",\"value\":\"2\"\x7d]\x7d");
    ok("spec-1.0.0/array-of-tables-0", "[[products]]\nname = \"Hammer\"\nsku = 738594937\n\n[[products]]  # empty table within the array\n\n[[products]]\nname = \"Nail\"\nsku = 284758393\n\ncolor = \"gray\"\n",
       "\x7b\"products\":[\x7b\"name\":\x7b\"type\":\"string\",\"value\":\"Hammer\"\x7d,\"sku\":\x7b\"type\":\"integer\",\"value\":\"738594937\"\x7d\x7d,\x7b\x7d,\x7b\"color\":\x7b\"type\":\"string\",\"value\":\"gray\"\x7d,\"name\":\x7b\"type\":\"string\",\"value\":\"Nail\"\x7d,\"sku\":\x7b\"type\":\"integer\",\"value\":\"284758393\"\x7d\x7d]\x7d");
    ok("spec-1.0.0/array-of-tables-1", "[[fruits]]\nname = \"apple\"\n\n[fruits.physical]  # subtable\ncolor = \"red\"\nshape = \"round\"\n\n[[fruits.varieties]]  # nested array of tables\nname = \"red delicious\"\n\n[[fruits.varieties]]\nname = \"granny smith\"\n\n\n[[fruits]]\nname = \"banana\"\n\n[[fruits.varieties]]\nname = \"plantain\"\n",
       "\x7b\"fruits\":[\x7b\"name\":\x7b\"type\":\"string\",\"value\":\"apple\"\x7d,\"physical\":\x7b\"color\":\x7b\"type\":\"string\",\"value\":\"red\"\x7d,\"shape\":\x7b\"type\":\"string\",\"value\":\"round\"\x7d\x7d,\"varieties\":[\x7b\"name\":\x7b\"type\":\"string\",\"value\":\"red delicious\"\x7d\x7d,\x7b\"name\":\x7b\"type\":\"string\",\"value\":\"granny smith\"\x7d\x7d]\x7d,\x7b\"name\":\x7b\"type\":\"string\",\"value\":\"banana\"\x7d,\"varieties\":[\x7b\"name\":\x7b\"type\":\"string\",\"value\":\"plantain\"\x7d\x7d]\x7d]\x7d");
    ok("spec-1.0.0/array-of-tables-2", "points = [ \x7b x = 1, y = 2, z = 3 \x7d,\n           \x7b x = 7, y = 8, z = 9 \x7d,\n           \x7b x = 2, y = 4, z = 8 \x7d ]\n",
       "\x7b\"points\":[\x7b\"x\":\x7b\"type\":\"integer\",\"value\":\"1\"\x7d,\"y\":\x7b\"type\":\"integer\",\"value\":\"2\"\x7d,\"z\":\x7b\"type\":\"integer\",\"value\":\"3\"\x7d\x7d,\x7b\"x\":\x7b\"type\":\"integer\",\"value\":\"7\"\x7d,\"y\":\x7b\"type\":\"integer\",\"value\":\"8\"\x7d,\"z\":\x7b\"type\":\"integer\",\"value\":\"9\"\x7d\x7d,\x7b\"x\":\x7b\"type\":\"integer\",\"value\":\"2\"\x7d,\"y\":\x7b\"type\":\"integer\",\"value\":\"4\"\x7d,\"z\":\x7b\"type\":\"integer\",\"value\":\"8\"\x7d\x7d]\x7d");
    ok("spec-1.0.0/boolean-0", "bool1 = true\nbool2 = false\n",
       "\x7b\"bool1\":\x7b\"type\":\"bool\",\"value\":\"true\"\x7d,\"bool2\":\x7b\"type\":\"bool\",\"value\":\"false\"\x7d\x7d");
    ok("spec-1.0.0/comment-0", "# This is a full-line comment\nkey = \"value\"  # This is a comment at the end of a line\nanother = \"# This is not a comment\"\n",
       "\x7b\"another\":\x7b\"type\":\"string\",\"value\":\"# This is not a comment\"\x7d,\"key\":\x7b\"type\":\"string\",\"value\":\"value\"\x7d\x7d");
    ok("spec-1.0.0/float-0", "# fractional\nflt1 = +1.0\nflt2 = 3.1415\nflt3 = -0.01\n\n# exponent\nflt4 = 5e+22\nflt5 = 1e06\nflt6 = -2E-2\n\n# both\nflt7 = 6.626e-34\n",
       "\x7b\"flt1\":\x7b\"type\":\"float\",\"value\":\"1.0\"\x7d,\"flt2\":\x7b\"type\":\"float\",\"value\":\"3.1415\"\x7d,\"flt3\":\x7b\"type\":\"float\",\"value\":\"-0.01\"\x7d,\"flt4\":\x7b\"type\":\"float\",\"value\":\"5e22\"\x7d,\"flt5\":\x7b\"type\":\"float\",\"value\":\"1e06\"\x7d,\"flt6\":\x7b\"type\":\"float\",\"value\":\"-2e-2\"\x7d,\"flt7\":\x7b\"type\":\"float\",\"value\":\"6.626e-34\"\x7d\x7d");
    ok("spec-1.0.0/float-1", "flt8 = 224_617.445_991_228\n",
       "\x7b\"flt8\":\x7b\"type\":\"float\",\"value\":\"224617.445991228\"\x7d\x7d");
    ok("spec-1.0.0/float-2", "# infinity\nsf1 = inf  # positive infinity\nsf2 = +inf # positive infinity\nsf3 = -inf # negative infinity\n\n# not a number\nsf4 = nan  # actual sNaN/qNaN encoding is implementation-specific\nsf5 = +nan # same as `nan`\nsf6 = -nan # valid, actual encoding is implementation-specific\n",
       "\x7b\"sf1\":\x7b\"type\":\"float\",\"value\":\"inf\"\x7d,\"sf2\":\x7b\"type\":\"float\",\"value\":\"inf\"\x7d,\"sf3\":\x7b\"type\":\"float\",\"value\":\"-inf\"\x7d,\"sf4\":\x7b\"type\":\"float\",\"value\":\"nan\"\x7d,\"sf5\":\x7b\"type\":\"float\",\"value\":\"nan\"\x7d,\"sf6\":\x7b\"type\":\"float\",\"value\":\"nan\"\x7d\x7d");
    ok("spec-1.0.0/inline-table-0", "name = \x7b first = \"Tom\", last = \"Preston-Werner\" \x7d\npoint = \x7b x = 1, y = 2 \x7d\nanimal = \x7b type.name = \"pug\" \x7d\n",
       "\x7b\"animal\":\x7b\"type\":\x7b\"name\":\x7b\"type\":\"string\",\"value\":\"pug\"\x7d\x7d\x7d,\"name\":\x7b\"first\":\x7b\"type\":\"string\",\"value\":\"Tom\"\x7d,\"last\":\x7b\"type\":\"string\",\"value\":\"Preston-Werner\"\x7d\x7d,\"point\":\x7b\"x\":\x7b\"type\":\"integer\",\"value\":\"1\"\x7d,\"y\":\x7b\"type\":\"integer\",\"value\":\"2\"\x7d\x7d\x7d");
    ok("spec-1.0.0/inline-table-1", "[name]\nfirst = \"Tom\"\nlast = \"Preston-Werner\"\n\n[point]\nx = 1\ny = 2\n\n[animal]\ntype.name = \"pug\"\n",
       "\x7b\"animal\":\x7b\"type\":\x7b\"name\":\x7b\"type\":\"string\",\"value\":\"pug\"\x7d\x7d\x7d,\"name\":\x7b\"first\":\x7b\"type\":\"string\",\"value\":\"Tom\"\x7d,\"last\":\x7b\"type\":\"string\",\"value\":\"Preston-Werner\"\x7d\x7d,\"point\":\x7b\"x\":\x7b\"type\":\"integer\",\"value\":\"1\"\x7d,\"y\":\x7b\"type\":\"integer\",\"value\":\"2\"\x7d\x7d\x7d");
    ok("spec-1.0.0/inline-table-2", "[product]\ntype = \x7b name = \"Nail\" \x7d\n# type.edible = false  # INVALID\n",
