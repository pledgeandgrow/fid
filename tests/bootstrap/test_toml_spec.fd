       "\x7b\"product\":\x7b\"type\":\x7b\"name\":\x7b\"type\":\"string\",\"value\":\"Nail\"\x7d\x7d\x7d\x7d");
    ok("spec-1.0.0/integer-0", "int1 = +99\nint2 = 42\nint3 = 0\nint4 = -17\n",
       "\x7b\"int1\":\x7b\"type\":\"integer\",\"value\":\"99\"\x7d,\"int2\":\x7b\"type\":\"integer\",\"value\":\"42\"\x7d,\"int3\":\x7b\"type\":\"integer\",\"value\":\"0\"\x7d,\"int4\":\x7b\"type\":\"integer\",\"value\":\"-17\"\x7d\x7d");
    ok("spec-1.0.0/integer-1", "int5 = 1_000\nint6 = 5_349_221\nint7 = 53_49_221  # Indian number system grouping\nint8 = 1_2_3_4_5  # VALID but discouraged\n",
       "\x7b\"int5\":\x7b\"type\":\"integer\",\"value\":\"1000\"\x7d,\"int6\":\x7b\"type\":\"integer\",\"value\":\"5349221\"\x7d,\"int7\":\x7b\"type\":\"integer\",\"value\":\"5349221\"\x7d,\"int8\":\x7b\"type\":\"integer\",\"value\":\"12345\"\x7d\x7d");
    ok("spec-1.0.0/integer-2", "# hexadecimal with prefix `0x`\nhex1 = 0xDEADBEEF\nhex2 = 0xdeadbeef\nhex3 = 0xdead_beef\n\n# octal with prefix `0o`\noct1 = 0o01234567\noct2 = 0o755 # useful for Unix file permissions\n\n# binary with prefix `0b`\nbin1 = 0b11010110\n",
       "\x7b\"bin1\":\x7b\"type\":\"integer\",\"value\":\"214\"\x7d,\"hex1\":\x7b\"type\":\"integer\",\"value\":\"3735928559\"\x7d,\"hex2\":\x7b\"type\":\"integer\",\"value\":\"3735928559\"\x7d,\"hex3\":\x7b\"type\":\"integer\",\"value\":\"3735928559\"\x7d,\"oct1\":\x7b\"type\":\"integer\",\"value\":\"342391\"\x7d,\"oct2\":\x7b\"type\":\"integer\",\"value\":\"493\"\x7d\x7d");
    ok("spec-1.0.0/key-value-pair-0", "key = \"value\"\n",
       "\x7b\"key\":\x7b\"type\":\"string\",\"value\":\"value\"\x7d\x7d");
    ok("spec-1.0.0/keys-0", "key = \"value\"\nbare_key = \"value\"\nbare-key = \"value\"\n1234 = \"value\"\n",
       "\x7b\"1234\":\x7b\"type\":\"string\",\"value\":\"value\"\x7d,\"bare-key\":\x7b\"type\":\"string\",\"value\":\"value\"\x7d,\"bare_key\":\x7b\"type\":\"string\",\"value\":\"value\"\x7d,\"key\":\x7b\"type\":\"string\",\"value\":\"value\"\x7d\x7d");
    ok("spec-1.0.0/keys-1", "\"127.0.0.1\" = \"value\"\n\"character encoding\" = \"value\"\n\"ʎǝʞ\" = \"value\"\n'key2' = \"value\"\n'quoted \"value\"' = \"value\"\n",
       "\x7b\"127.0.0.1\":\x7b\"type\":\"string\",\"value\":\"value\"\x7d,\"character encoding\":\x7b\"type\":\"string\",\"value\":\"value\"\x7d,\"key2\":\x7b\"type\":\"string\",\"value\":\"value\"\x7d,\"quoted \\\"value\\\"\":\x7b\"type\":\"string\",\"value\":\"value\"\x7d,\"ʎǝʞ\":\x7b\"type\":\"string\",\"value\":\"value\"\x7d\x7d");
}

// valid cases (toml-test tests/valid/...)
fn valid_1() {
    ok("spec-1.0.0/keys-3", "name = \"Orange\"\nphysical.color = \"orange\"\nphysical.shape = \"round\"\nsite.\"google.com\" = true\n",
       "\x7b\"name\":\x7b\"type\":\"string\",\"value\":\"Orange\"\x7d,\"physical\":\x7b\"color\":\x7b\"type\":\"string\",\"value\":\"orange\"\x7d,\"shape\":\x7b\"type\":\"string\",\"value\":\"round\"\x7d\x7d,\"site\":\x7b\"google.com\":\x7b\"type\":\"bool\",\"value\":\"true\"\x7d\x7d\x7d");
    ok("spec-1.0.0/keys-4", "fruit.name = \"banana\"     # this is best practice\nfruit. color = \"yellow\"    # same as fruit.color\nfruit . flavor = \"banana\"   # same as fruit.flavor\n",
       "\x7b\"fruit\":\x7b\"color\":\x7b\"type\":\"string\",\"value\":\"yellow\"\x7d,\"flavor\":\x7b\"type\":\"string\",\"value\":\"banana\"\x7d,\"name\":\x7b\"type\":\"string\",\"value\":\"banana\"\x7d\x7d\x7d");
    ok("spec-1.0.0/keys-5", "# VALID BUT DISCOURAGED\n\napple.type = \"fruit\"\norange.type = \"fruit\"\n\napple.skin = \"thin\"\norange.skin = \"thick\"\n\napple.color = \"red\"\norange.color = \"orange\"\n",
       "\x7b\"apple\":\x7b\"color\":\x7b\"type\":\"string\",\"value\":\"red\"\x7d,\"skin\":\x7b\"type\":\"string\",\"value\":\"thin\"\x7d,\"type\":\x7b\"type\":\"string\",\"value\":\"fruit\"\x7d\x7d,\"orange\":\x7b\"color\":\x7b\"type\":\"string\",\"value\":\"orange\"\x7d,\"skin\":\x7b\"type\":\"string\",\"value\":\"thick\"\x7d,\"type\":\x7b\"type\":\"string\",\"value\":\"fruit\"\x7d\x7d\x7d");
    ok("spec-1.0.0/keys-6", "# RECOMMENDED\n\napple.type = \"fruit\"\napple.skin = \"thin\"\napple.color = \"red\"\n\norange.type = \"fruit\"\norange.skin = \"thick\"\norange.color = \"orange\"\n",
       "\x7b\"apple\":\x7b\"color\":\x7b\"type\":\"string\",\"value\":\"red\"\x7d,\"skin\":\x7b\"type\":\"string\",\"value\":\"thin\"\x7d,\"type\":\x7b\"type\":\"string\",\"value\":\"fruit\"\x7d\x7d,\"orange\":\x7b\"color\":\x7b\"type\":\"string\",\"value\":\"orange\"\x7d,\"skin\":\x7b\"type\":\"string\",\"value\":\"thick\"\x7d,\"type\":\x7b\"type\":\"string\",\"value\":\"fruit\"\x7d\x7d\x7d");
    ok("spec-1.0.0/keys-7", "3.14159 = \"pi\"\n",
       "\x7b\"3\":\x7b\"14159\":\x7b\"type\":\"string\",\"value\":\"pi\"\x7d\x7d\x7d");
    ok("spec-1.0.0/local-date-0", "ld1 = 1979-05-27\n",
       "\x7b\"ld1\":\x7b\"type\":\"date-local\",\"value\":\"1979-05-27\"\x7d\x7d");
    ok("spec-1.0.0/local-date-time-0", "ldt1 = 1979-05-27T07:32:00\nldt2 = 1979-05-27T00:32:00.999\n",
       "\x7b\"ldt1\":\x7b\"type\":\"datetime-local\",\"value\":\"1979-05-27T07:32:00\"\x7d,\"ldt2\":\x7b\"type\":\"datetime-local\",\"value\":\"1979-05-27T00:32:00.999\"\x7d\x7d");
    ok("spec-1.0.0/local-time-0", "lt1 = 07:32:00\nlt2 = 00:32:00.999\n",
       "\x7b\"lt1\":\x7b\"type\":\"time-local\",\"value\":\"07:32:00\"\x7d,\"lt2\":\x7b\"type\":\"time-local\",\"value\":\"00:32:00.999\"\x7d\x7d");
    ok("spec-1.0.0/offset-date-time-0", "odt1 = 1979-05-27T07:32:00Z\nodt2 = 1979-05-27T00:32:00-07:00\nodt3 = 1979-05-27T00:32:00.999-07:00\n",
       "\x7b\"odt1\":\x7b\"type\":\"datetime\",\"value\":\"1979-05-27T07:32:00Z\"\x7d,\"odt2\":\x7b\"type\":\"datetime\",\"value\":\"1979-05-27T00:32:00-07:00\"\x7d,\"odt3\":\x7b\"type\":\"datetime\",\"value\":\"1979-05-27T00:32:00.999-07:00\"\x7d\x7d");
    ok("spec-1.0.0/offset-date-time-1", "odt4 = 1979-05-27 07:32:00Z\n",
       "\x7b\"odt4\":\x7b\"type\":\"datetime\",\"value\":\"1979-05-27T07:32:00Z\"\x7d\x7d");
    ok("spec-1.0.0/string-0", "str = \"I'm a string. \\\"You can quote me\\\". Name\\tJos\\u00E9\\nLocation\\tSF.\"\n",
       "\x7b\"str\":\x7b\"type\":\"string\",\"value\":\"I'm a string. \\\"You can quote me\\\". Name\\tJosé\\nLocation\\tSF.\"\x7d\x7d");
    ok("spec-1.0.0/string-1", "str1 = \"\"\"\nRoses are red\nViolets are blue\"\"\"\n",
       "\x7b\"str1\":\x7b\"type\":\"string\",\"value\":\"Roses are red\\nViolets are blue\"\x7d\x7d");
    ok("spec-1.0.0/string-2", "# On a Unix system, the above multi-line string will most likely be the same as:\nstr2 = \"Roses are red\\nViolets are blue\"\n\n# On a Windows system, it will most likely be equivalent to:\nstr3 = \"Roses are red\\r\\nViolets are blue\"\n",
       "\x7b\"str2\":\x7b\"type\":\"string\",\"value\":\"Roses are red\\nViolets are blue\"\x7d,\"str3\":\x7b\"type\":\"string\",\"value\":\"Roses are red\\r\\nViolets are blue\"\x7d\x7d");
    ok("spec-1.0.0/string-3", "# The following strings are byte-for-byte equivalent:\nstr1 = \"The quick brown fox jumps over the lazy dog.\"\n\nstr2 = \"\"\"\nThe quick brown \\\n\n\n  fox jumps over \\\n    the lazy dog.\"\"\"\n\nstr3 = \"\"\"\\\n       The quick brown \\\n       fox jumps over \\\n       the lazy dog.\\\n       \"\"\"\n",
       "\x7b\"str1\":\x7b\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"\x7d,\"str2\":\x7b\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"\x7d,\"str3\":\x7b\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"\x7d\x7d");
    ok("spec-1.0.0/string-4", "str4 = \"\"\"Here are two quotation marks: \"\". Simple enough.\"\"\"\n# str5 = \"\"\"Here are three quotation marks: \"\"\".\"\"\"  # INVALID\nstr5 = \"\"\"Here are three quotation marks: \"\"\\\".\"\"\"\nstr6 = \"\"\"Here are fifteen quotation marks: \"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\".\"\"\"\n\n# \"This,\" she said, \"is just a pointless statement.\"\nstr7 = \"\"\"\"This,\" she said, \"is just a pointless statement.\"\"\"\"\n",
       "\x7b\"str4\":\x7b\"type\":\"string\",\"value\":\"Here are two quotation marks: \\\"\\\". Simple enough.\"\x7d,\"str5\":\x7b\"type\":\"string\",\"value\":\"Here are three quotation marks: \\\"\\\"\\\".\"\x7d,\"str6\":\x7b\"type\":\"string\",\"value\":\"Here are fifteen quotation marks: \\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\".\"\x7d,\"str7\":\x7b\"type\":\"string\",\"value\":\"\\\"This,\\\" she said, \\\"is just a pointless statement.\\\"\"\x7d\x7d");
    ok("spec-1.0.0/string-5", "# What you see is what you get.\nwinpath  = 'C:\\Users\\nodejs\\templates'\nwinpath2 = '\\\\ServerX\\admin$\\system32\\'\nquoted   = 'Tom \"Dubs\" Preston-Werner'\nregex    = '<\\i\\c*\\s*>'\n",
       "\x7b\"quoted\":\x7b\"type\":\"string\",\"value\":\"Tom \\\"Dubs\\\" Preston-Werner\"\x7d,\"regex\":\x7b\"type\":\"string\",\"value\":\"<\\\\i\\\\c*\\\\s*>\"\x7d,\"winpath\":\x7b\"type\":\"string\",\"value\":\"C:\\\\Users\\\\nodejs\\\\templates\"\x7d,\"winpath2\":\x7b\"type\":\"string\",\"value\":\"\\\\\\\\ServerX\\\\admin$\\\\system32\\\\\"\x7d\x7d");
    ok("spec-1.0.0/string-6", "regex2 = '''I [dw]on't need \\d\x7b2\x7d apples'''\nlines  = '''\nThe first newline is\ntrimmed in raw strings.\n   All other whitespace\n   is preserved.\n'''\n",
       "\x7b\"lines\":\x7b\"type\":\"string\",\"value\":\"The first newline is\\ntrimmed in raw strings.\\n   All other whitespace\\n   is preserved.\\n\"\x7d,\"regex2\":\x7b\"type\":\"string\",\"value\":\"I [dw]on't need \\\\d\x7b2\x7d apples\"\x7d\x7d");
    ok("spec-1.0.0/string-7", "quot15 = '''Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"\"'''\n\n# apos15 = '''Here are fifteen apostrophes: ''''''''''''''''''  # INVALID\napos15 = \"Here are fifteen apostrophes: '''''''''''''''\"\n\n# 'That,' she said, 'is still pointless.'\nstr = ''''That,' she said, 'is still pointless.''''\n",
       "\x7b\"apos15\":\x7b\"type\":\"string\",\"value\":\"Here are fifteen apostrophes: '''''''''''''''\"\x7d,\"quot15\":\x7b\"type\":\"string\",\"value\":\"Here are fifteen quotation marks: \\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\"\x7d,\"str\":\x7b\"type\":\"string\",\"value\":\"'That,' she said, 'is still pointless.'\"\x7d\x7d");
    ok("spec-1.0.0/table-0", "[table]\n",
       "\x7b\"table\":\x7b\x7d\x7d");
    ok("spec-1.0.0/table-1", "[table-1]\nkey1 = \"some string\"\nkey2 = 123\n\n[table-2]\nkey1 = \"another string\"\nkey2 = 456\n",
       "\x7b\"table-1\":\x7b\"key1\":\x7b\"type\":\"string\",\"value\":\"some string\"\x7d,\"key2\":\x7b\"type\":\"integer\",\"value\":\"123\"\x7d\x7d,\"table-2\":\x7b\"key1\":\x7b\"type\":\"string\",\"value\":\"another string\"\x7d,\"key2\":\x7b\"type\":\"integer\",\"value\":\"456\"\x7d\x7d\x7d");
}

// valid cases (toml-test tests/valid/...)
fn valid_2() {
    ok("spec-1.0.0/table-2", "[dog.\"tater.man\"]\ntype.name = \"pug\"\n",
       "\x7b\"dog\":\x7b\"tater.man\":\x7b\"type\":\x7b\"name\":\x7b\"type\":\"string\",\"value\":\"pug\"\x7d\x7d\x7d\x7d\x7d");
    ok("spec-1.0.0/table-3", "[a.b.c]            # this is best practice\n[ d.e.f ]          # same as [d.e.f]\n[ g .  h  . i ]    # same as [g.h.i]\n[ j . \"ʞ\" . 'l' ]  # same as [j.\"ʞ\".'l']\n",
       "\x7b\"a\":\x7b\"b\":\x7b\"c\":\x7b\x7d\x7d\x7d,\"d\":\x7b\"e\":\x7b\"f\":\x7b\x7d\x7d\x7d,\"g\":\x7b\"h\":\x7b\"i\":\x7b\x7d\x7d\x7d,\"j\":\x7b\"ʞ\":\x7b\"l\":\x7b\x7d\x7d\x7d\x7d");
    ok("spec-1.0.0/table-4", "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\n\n[x] # defining a super-table afterward is ok\n",
       "\x7b\"x\":\x7b\"y\":\x7b\"z\":\x7b\"w\":\x7b\x7d\x7d\x7d\x7d\x7d");
    ok("spec-1.0.0/table-5", "# VALID BUT DISCOURAGED\n[fruit.apple]\n[animal]\n[fruit.orange]\n",
       "\x7b\"animal\":\x7b\x7d,\"fruit\":\x7b\"apple\":\x7b\x7d,\"orange\":\x7b\x7d\x7d\x7d");
    ok("spec-1.0.0/table-6", "# RECOMMENDED\n[fruit.apple]\n[fruit.orange]\n[animal]\n",
       "\x7b\"animal\":\x7b\x7d,\"fruit\":\x7b\"apple\":\x7b\x7d,\"orange\":\x7b\x7d\x7d\x7d");
    ok("spec-1.0.0/table-7", "# Top-level table begins.\nname = \"Fido\"\nbreed = \"pug\"\n\n# Top-level table ends.\n[owner]\nname = \"Regina Dogman\"\nmember_since = 1999-08-04\n",
       "\x7b\"breed\":\x7b\"type\":\"string\",\"value\":\"pug\"\x7d,\"name\":\x7b\"type\":\"string\",\"value\":\"Fido\"\x7d,\"owner\":\x7b\"member_since\":\x7b\"type\":\"date-local\",\"value\":\"1999-08-04\"\x7d,\"name\":\x7b\"type\":\"string\",\"value\":\"Regina Dogman\"\x7d\x7d\x7d");
    ok("spec-1.0.0/table-8", "fruit.apple.color = \"red\"\n# Defines a table named fruit\n# Defines a table named fruit.apple\n\nfruit.apple.taste.sweet = true\n# Defines a table named fruit.apple.taste\n# fruit and fruit.apple were already created\n",
       "\x7b\"fruit\":\x7b\"apple\":\x7b\"color\":\x7b\"type\":\"string\",\"value\":\"red\"\x7d,\"taste\":\x7b\"sweet\":\x7b\"type\":\"bool\",\"value\":\"true\"\x7d\x7d\x7d\x7d\x7d");
    ok("spec-1.0.0/table-9", "[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n# [fruit.apple]  # INVALID\n# [fruit.apple.taste]  # INVALID\n\n[fruit.apple.texture]  # you can add sub-tables\nsmooth = true\n",
       "\x7b\"fruit\":\x7b\"apple\":\x7b\"color\":\x7b\"type\":\"string\",\"value\":\"red\"\x7d,\"taste\":\x7b\"sweet\":\x7b\"type\":\"bool\",\"value\":\"true\"\x7d\x7d,\"texture\":\x7b\"smooth\":\x7b\"type\":\"bool\",\"value\":\"true\"\x7d\x7d\x7d\x7d\x7d");
}

// invalid cases (toml-test tests/invalid/...)
fn invalid_0() {
    bad("spec-1.0.0/inline-table-2-0", "[product]\ntype = \x7b name = \"Nail\" \x7d\ntype.edible = false  # INVALID\n");
    bad("spec-1.0.0/inline-table-3-0", "[product]\ntype.name = \"Nail\"\ntype = \x7b edible = false \x7d  # INVALID\n");
    bad("spec-1.0.0/key-value-pair-1", "key = # INVALID\n");
    bad("spec-1.0.0/keys-2", "= \"no key name\"  # INVALID\n\"\" = \"blank\"     # VALID but discouraged\n'' = 'blank'     # VALID but discouraged\n");
    bad("spec-1.0.0/string-4-0", "str4 = \"\"\"Here are two quotation marks: \"\". Simple enough.\"\"\"\nstr5 = \"\"\"Here are three quotation marks: \"\"\".\"\"\"  # INVALID\nstr5 = \"\"\"Here are three quotation marks: \"\"\\\".\"\"\"\nstr6 = \"\"\"Here are fifteen quotation marks: \"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\".\"\"\"\n\n# \"This,\" she said, \"is just a pointless statement.\"\nstr7 = \"\"\"\"This,\" she said, \"is just a pointless statement.\"\"\"\"\n");
    bad("spec-1.0.0/string-7-0", "quot15 = '''Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"\"'''\n\napos15 = '''Here are fifteen apostrophes: ''''''''''''''''''  # INVALID\napos15 = \"Here are fifteen apostrophes: '''''''''''''''\"\n\n# 'That,' she said, 'is still pointless.'\nstr = ''''That,' she said, 'is still pointless.''''\n");
    bad("spec-1.0.0/table-9-0", "[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n[fruit.apple]  # INVALID\n# [fruit.apple.taste]  # INVALID\n\n[fruit.apple.texture]  # you can add sub-tables\nsmooth = true\n");
    bad("spec-1.0.0/table-9-1", "[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n# [fruit.apple]  # INVALID\n[fruit.apple.taste]  # INVALID\n\n[fruit.apple.texture]  # you can add sub-tables\nsmooth = true\n");
}

fn main() -> i64 {
    spec_keys();
    spec_strings();
    spec_numbers();
    spec_dates();
    spec_arrays_tables();
    api_and_errors();
    valid_0();
    valid_1();
    valid_2();
    invalid_0();
    println("test_toml_spec ok");
    return 0;
}
