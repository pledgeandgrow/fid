// Test (stdlib-agent bug 17): a generic struct with a Vec<V> field. The
// field lowered as a Vec of inline structs named V: a push stored a boxed
// copy and a get read back its address.
// Expected output:
// 5 6 2
// b a 2
// 7
struct Slot<V> { vals: Vec<V> }

fn count(s: & Slot<i64>) -> i64 { return s.vals.len(); }

fn main() {
    var a: Slot<i64> = Slot { vals: Vec::new() };
    a.vals.push(5);
    a.vals.push(6);
    println(int_to_str(a.vals.get(0)) + " " + int_to_str(a.vals.get(1)) + " " + int_to_str(count(& a)));
    var s: Slot<str> = Slot { vals: Vec::new() };
    s.vals.push("b");
    s.vals.push("a");
    println(s.vals.get(0) + " " + s.vals.get(1) + " " + int_to_str(s.vals.len()));
    var t: i64 = 0;
    var i: i64 = 0;
    while i < a.vals.len() {
        t = t + a.vals.get(i);
        i = i + 1;
    }
    println(int_to_str(t - 4));
}
