// test_windows_cold_layout.fd — competitive OP15 on the default Windows
// backend (compiler/pe_ir.fd PeirGen_block_order): blocks that panic are
// laid out after the rest of their function, so the hot path runs
// straight through. `fail` only panics, so a block that calls it is cold
// too (PeirGen_find_cold_fns). Every backend prints the same; no panic
// happens.
//
// Expected output:
// 14850
// 14
// 4459
// 3

fn fail(msg: str) {
    panic(msg);
}

fn checked_div(a: i64, b: i64) -> i64 {
    if b == 0 {
        fail("division by zero");
    }
    return a / b;
}

fn sum_checked(v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        if v.get(i) < 0 {
            fail("negative");
        }
        s = s + v.get(i);
        i = i + 1;
    }
    return s;
}

fn pick(k: i64) -> i64 {
    if k == 1 {
        return 1;
    } else if k == 2 {
        return 2;
    } else if k == 3 {
        return 3;
    }
    fail("no such case");
    return 0;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 100 {
        v.push(i * 3);
        i = i + 1;
    }
    print(sum_checked(v));
    print("\n");
    print(checked_div(100, 7));
    print("\n");
    var t: i64 = 0;
    var k: i64 = 1;
    while k < 50 {
        t = t + checked_div(1000, k);
        k = k + 1;
    }
    print(t);
    print("\n");
    print(pick(3));
    print("\n");
    return 0;
}
