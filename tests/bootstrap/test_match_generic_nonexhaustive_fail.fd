// expect-error: non-exhaustive match
// Test (known-bugs 2g.7): a match on a generic enum is checked by its
// variants: this one has no arm for Err.
enum Res<T> { Ok(T), Err(str) }

fn get(r: Res<i64>) -> i64 {
    match r {
        Res::Ok(v) => { return v; }
    }
    return 0;
}

fn main() -> i64 {
    print(get(Res::Ok(4)));
    return 0;
}
