// stdlib/multipart: the RFC 2046 §5.1.1 multipart/mixed example (preamble, a part without headers, epilogue), the HTML 4 / RFC 2388 form-data example, a built body with a binary file round-tripped, streaming in chunks of 1, 3 and 7 bytes (boundaries split across chunks), filename*, and malformed bodies.
// Expected output:
// boundary: [simple boundary]
// rfc 2046:
//   ok=true parts=2 
//   [0] name= filename= type=text/plain data="This is implicitly typed plain US-ASCII text.\r\nIt does NOT end with a linebreak."
//   [1] name= filename= type=text/plain; charset=us-ascii data="This is explicitly typed plain US-ASCII text.\r\nIt DOES end with a linebreak.\r\n"
// form-data:
//   ok=true parts=2 
//   [0] name=submit-name filename= type=text/plain data="Larry"
//   [1] name=files filename=file1.txt type=text/plain data="... contents of file1.txt ..."
//   find files: 1 header: form-data; name="files"; filename="file1.txt"
// boundary XyZ ok: true
// boundary in data ok: false
// built: 478 bytes, content-type multipart/form-data; boundary=XyZ
// head: "--XyZ\r\nContent-Disposition: form-data; name="title"\r\n\r\nReport "Q3"\r\n--XyZ\r\nContent-Disposition: f"
// round trip: ok=true parts=2 title=Report "Q3" file same=true type=application/octet-stream
// stream 1: true
// stream 3: true
// stream 7: true
// stream rfc 2046 in 5s: parts 2 ended true digest 
// filename*: € rates.txt
// unclosed: the body ended before the closing boundary
// no boundary: no boundary found
// bad boundary: a boundary is 1 to 70 characters (RFC 2046)
// new boundary: ----FidesBoundaryfedcba9876543210
use multipart;
use encoding;
use vec;
use string;

fn crlf(s: str) -> Vec<i64> { return str_bytes(str_replace(s, "\n", "\r\n")); }

fn show(b: & MpBody) {
    println("  ok=" + bool_to_str(b.ok) + " parts=" + int_to_str(b.parts.len()) + " " + b.error);
    var i: i64 = 0;
    while i < b.parts.len() {
        val p: MpPart = b.parts.get(i);
        println("  [" + int_to_str(i) + "] name=" + p.name + " filename=" + p.filename + " type=" + p.content_type + " data=" + json_like(str_from_bytes(p.data)));
        i = i + 1;
    }
}

fn json_like(s: str) -> str {
    return "\"" + str_replace(str_replace(s, "\r", "\\r"), "\n", "\\n") + "\"";
}

fn chunked(body: Vec<i64>, boundary: str, size: i64) -> str {
    // stream in fixed-size chunks; rebuild every part's data
    var s: MpStream = mp_stream_new(boundary);
    var datas: Vec<str> = Vec::new();
    var cur: Vec<i64> = Vec::new();
    var starts: i64 = 0;
    var events: i64 = 0;
    var off: i64 = 0;
    var ended: bool = false;
    while off < body.len() {
        var chunk: Vec<i64> = Vec::new();
        var k: i64 = 0;
        while k < size && off + k < body.len() { chunk.push(body.get(off + k)); k = k + 1; }
        off = off + size;
        val evs: Vec<MpEvent> = mp_feed(& mut s, chunk);
        var i: i64 = 0;
        while i < evs.len() {
            val e: MpEvent = evs.get(i);
            events = events + 1;
            if e.kind == MP_PART_START { starts = starts + 1; cur = Vec::new(); }
            if e.kind == MP_DATA {
                var j: i64 = 0;
                while j < e.data.len() { cur.push(e.data.get(j)); j = j + 1; }
            }
            if e.kind == MP_PART_END { datas.push(hex_encode_bytes(cur)); }
            if e.kind == MP_END { ended = true; }
            i = i + 1;
        }
    }
    val fin: Vec<MpEvent> = mp_finish(& mut s);
    return "parts " + int_to_str(starts) + " ended " + bool_to_str(ended && fin.len() == 0) + " digest " + str_join(datas, "/");
}

fn main() -> i64 {
    // RFC 2046 §5.1.1
    val mixed: Vec<i64> = crlf("This is the preamble.  It is to be ignored, though it\nis a handy place for composition agents to include an\nexplanatory note to non-MIME conformant readers.\n\n--simple boundary\n\nThis is implicitly typed plain US-ASCII text.\nIt does NOT end with a linebreak.\n--simple boundary\nContent-type: text/plain; charset=us-ascii\n\nThis is explicitly typed plain US-ASCII text.\nIt DOES end with a linebreak.\n\n--simple boundary--\n\nThis is the epilogue.  It is also to be ignored.\n");
    val ct: str = "multipart/mixed; boundary=\"simple boundary\"";
    println("boundary: [" + mp_boundary_of(ct) + "]");
    println("rfc 2046:");
    val m: MpBody = mp_parse(mixed, mp_boundary_of(ct));
    show(& m);

    // the HTML 4.01 / RFC 2388 form example
    val form: Vec<i64> = crlf("--AaB03x\nContent-Disposition: form-data; name=\"submit-name\"\n\nLarry\n--AaB03x\nContent-Disposition: form-data; name=\"files\"; filename=\"file1.txt\"\nContent-Type: text/plain\n\n... contents of file1.txt ...\n--AaB03x--\n");
    println("form-data:");
    val f: MpBody = mp_parse(form, mp_boundary_of("multipart/form-data; boundary=AaB03x"));
    show(& f);
    println("  find files: " + int_to_str(mp_find_part(& f, "files")) + " header: " + mp_header(& f.parts.get(1), "Content-Disposition"));

    // build: a field and a binary file holding a near-boundary sequence
    var bin: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 256 { bin.push(i); i = i + 1; }
    // prefixes of the delimiter, never the whole of it
    val tricky: Vec<i64> = str_bytes("\r\n--Xy not the end\r\n-\r\n--X");
    i = 0;
    while i < tricky.len() { bin.push(tricky.get(i)); i = i + 1; }
    var parts: Vec<MpPart> = Vec::new();
    parts.push(mp_field("title", "Report \"Q3\""));
    parts.push(mp_file("upload", "data.bin", "application/octet-stream", bin));
    val boundary: str = "XyZ";
    println("boundary XyZ ok: " + bool_to_str(mp_boundary_ok(& parts, boundary)));
    var clash: Vec<MpPart> = Vec::new();
    clash.push(mp_field("x", "a\r\n--XyZ b"));
    println("boundary in data ok: " + bool_to_str(mp_boundary_ok(& clash, boundary)));
    val built: Vec<i64> = mp_build(& parts, boundary);
    println("built: " + int_to_str(built.len()) + " bytes, content-type " + mp_content_type(boundary));
    println("head: " + json_like(str_from_bytes(mp_take_n(built, 97))));
    val back: MpBody = mp_parse(built, boundary);
    println("round trip: ok=" + bool_to_str(back.ok) + " parts=" + int_to_str(back.parts.len()) + " title=" + str_from_bytes(back.parts.get(0).data) + " file same=" + bool_to_str(hex_encode_bytes(back.parts.get(1).data) == hex_encode_bytes(bin)) + " type=" + back.parts.get(1).content_type);

    // streaming gives the same parts at every chunk size
    val whole: str = chunked(built, boundary, 100000);
    println("stream 1: " + bool_to_str(chunked(built, boundary, 1) == whole));
    println("stream 3: " + bool_to_str(chunked(built, boundary, 3) == whole));
    println("stream 7: " + bool_to_str(chunked(built, boundary, 7) == whole));
    println("stream rfc 2046 in 5s: " + chunked(mixed, "simple boundary", 5));

    // filename* (RFC 5987) wins over filename
    val star: MpBody = mp_parse(crlf("--b\nContent-Disposition: form-data; name=\"f\"; filename=\"a.txt\"; filename*=UTF-8''%E2%82%AC%20rates.txt\n\nx\n--b--\n"), "b");
    println("filename*: " + star.parts.get(0).filename);

    // malformed
    println("unclosed: " + mp_parse(crlf("--b\n\nabc\n"), "b").error);
    println("no boundary: " + mp_parse(crlf("hello\n"), "b").error);
    println("bad boundary: " + mp_parse(crlf("x"), "").error);
    println("new boundary: " + mp_new_boundary(0x0123456789abcdef));
    return 0;
}

fn mp_take_n(b: Vec<i64>, n: i64) -> Vec<i64> {
    var o: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n && i < b.len() { o.push(b.get(i)); i = i + 1; }
    return o;
}
