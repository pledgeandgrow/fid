// expect-error: Real-time error: function 'f' uses string `+=`, which allocates
// Bugs roadmap BG377 (with BG373): `s += t` on a str builds a new string;
// @realtime forbids allocating.
@realtime
fn f(x: str, y: str) -> str {
    var s = x;
    s += y;
    return s;
}
fn main() {
    println(f("q", "r"));
}
