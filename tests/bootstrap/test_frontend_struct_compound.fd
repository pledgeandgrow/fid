// CL10 (fid): `x op= e` on a struct is `x = x op e`: `+=` calls the
// struct's `add`, `*=` on a unit scales it by the dimension rule, and a
// struct field (`b.pos += step`) works the same way. Before, the compound
// assignment did arithmetic on the struct's address. A struct holding a
// string made by `+` is owned like any value a method returns (`val u =
// t + t` with no type written).
// Expected output:
// 4 6
// 2 2
// 15
// 24
// 3 5
// 9
// ab 3
// abab 6
// 6

@dimension(m = 1)
struct Len {
    value: f64,
}

struct P {
    x: i64,
    y: i64,
}

impl P {
    fn add(self: P, o: P) -> P {
        return P { x: self.x + o.x, y: self.y + o.y };
    }
    fn sub(self: P, o: P) -> P {
        return P { x: self.x - o.x, y: self.y - o.y };
    }
}

struct Body {
    pos: P,
    dist: Len,
}

struct Tag {
    name: str,
    n: i64,
}

impl Tag {
    fn add(self: Tag, o: Tag) -> Tag {
        return Tag { name: self.name + o.name, n: self.n + o.n };
    }
}

fn show(x: f64) {
    println(int_to_str(x as i64));
}

fn main() -> i64 {
    var p: P = P { x: 1, y: 2 };
    p += P { x: 3, y: 4 };
    println(int_to_str(p.x) + " " + int_to_str(p.y));
    p -= P { x: 2, y: 4 };
    println(int_to_str(p.x) + " " + int_to_str(p.y));
    var d: Len = Len { value: 5.0 };
    d *= 3.0;
    show(d.value);
    d += Len { value: 9.0 };
    show(d.value);
    var b: Body = Body { pos: P { x: 1, y: 1 }, dist: Len { value: 4.0 } };
    b.pos += P { x: 2, y: 4 };
    println(int_to_str(b.pos.x) + " " + int_to_str(b.pos.y));
    b.dist += Len { value: 5.0 };
    show(b.dist.value);
    var t: Tag = Tag { name: "a", n: 1 };
    t += Tag { name: "b", n: 2 };
    println(t.name + " " + int_to_str(t.n));
    val u = t + t;
    println(u.name + " " + int_to_str(u.n));
    var total: Len = Len { value: 0.0 };
    var i: i64 = 0;
    while i < 3 {
        total += Len { value: 2.0 };
        i = i + 1;
    }
    show(total.value);
    return 0;
}
