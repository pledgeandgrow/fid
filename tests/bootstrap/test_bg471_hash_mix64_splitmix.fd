// Bugs roadmap BG471: stdlib/hash.fd hash_mix64, documented as the
// splitmix64 finalizer, shifted with `>>` (arithmetic on an i64), so it
// computed another function: hash_mix64(0) was 2447048557682778308, its
// doc example claimed -280303742238208354. The reference splitmix64 with
// logical shifts (Python, values as signed i64) gives the values below.
//
// Expected output:
// -2152535657050944081
// -7995527694508729151
// -1956407806741107680
// 2454886589211414944

use hash;

fn main() {
    println(f"{hash_mix64(0)}");
    println(f"{hash_mix64(1)}");
    println(f"{hash_mix64(-1)}");
    println(f"{hash_mix64(12345)}");
}
