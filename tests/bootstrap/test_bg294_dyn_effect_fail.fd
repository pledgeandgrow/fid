// expect-error: function 'via_dyn' has inferred effect '!IO' (through a method it calls)
// Bugs roadmap BG294: `!{}` was bypassed by a method call through `dyn
// Trait`: the call added no effect, although every implementation of the
// method (here the only one) prints.
cap Logger {
    fn log(self) -> i64;
}
struct L { n: i64 }
impl Logger for L {
    pub fn log(self: L) -> i64 {
        println("side effect");
        return 1;
    }
}
fn via_dyn(d: dyn Logger) -> i64 !{} {
    return d.log();
}
fn main() -> i64 {
    val l = L { n: 1 };
    println(via_dyn(l as dyn Logger));
    return 0;
}
