// `fid parse-header` output for a real header set (release E5): the SDL2
// API of stdlib/sdl2_h.fd, generated from SDL.h 2.32.10 and the 60 headers
// it includes (852 functions, 1413 constants). The whole module type-checks
// and builds with `fid emit`; this test reads its constants and calls
// nothing, so it needs no SDL2.dll. examples/sdl_window.fd opens a window.
//
// Expected output:
// 32
// 805240832
// 4
// 256 768
// 41 97 27
// 1
use sdl2_h;

fn main() -> i64 {
    println(SDL_INIT_VIDEO);
    println(SDL_WINDOWPOS_CENTERED);
    println(SDL_WINDOW_SHOWN);
    println(int_to_str(SDL_QUIT) + " " + int_to_str(SDL_KEYDOWN));
    println(int_to_str(SDL_SCANCODE_ESCAPE) + " " + int_to_str(SDLK_a) + " " + int_to_str(SDLK_ESCAPE));
    println(SDL_TRUE);
    return 0;
}
