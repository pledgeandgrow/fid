// expect-error: function 'relay_dispatch' is @no-indirect but calls its parameter 'decide'
// Roadmap Phase 9 / F59: @grid-safe requires deterministic dispatch: a call
// through a function value (which function runs is known only at run
// time) is rejected.

fn over(current: i64) -> i64 {
    if current > 1000 {
        return 1;
    }
    return 0;
}

@grid-safe
fn relay_dispatch(decide: fn(i64) -> i64, current: i64) -> i64 {
    return decide(current);
}

fn main() -> i64 {
    println(int_to_str(relay_dispatch(over, 1500)));
    return 0;
}
