// expect-error: Budget error
// Test: a region budget counts heap growth through a user method called
// by a helper: `fill` calls `b.grow()`, whose push allocates.
struct Bag { items: Vec<i64> }

impl Bag {
    fn grow(self: &mut Bag) { self.items.push(1); }
}

fn fill(b: &mut Bag) { b.grow(); }

fn main() -> i64 {
    var b = Bag { items: Vec::new() };
    region r with budget(64) {
        fill(&mut b);
    }
    return 0;
}
