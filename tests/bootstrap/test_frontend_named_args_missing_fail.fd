// expect-error: leaves out parameter 'host', which has no default
// CL4: with named arguments, a parameter without a default must still be
// given (the lowering passed 0 for it: a null string here).

fn connect(host: str, port: i64 = 80) -> i64 {
    println(host);
    return port;
}

fn main() -> i64 {
    println(connect(port: 8080));
    return 0;
}
