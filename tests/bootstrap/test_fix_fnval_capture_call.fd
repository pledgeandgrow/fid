// Test (stdlib-agent bug 27): a closure that calls a function value it
// captured (a variable or a parameter of the function that made it). The
// interpreter said "Unknown function 'nx'" and the C build called the
// undeclared name nx: the callee was not captured, and the call did not go
// through the closure's env. Also run it through `fid ccompile`.
// Expected output:
// a!
// b!?
// [c!]
// 15
fn up(s: str) -> str {
    return s + "!";
}

fn w(next: fn(str) -> str) -> fn(str) -> str {
    val nx = next;
    return fn(s: str) -> str {
        return nx(s);
    };
}

fn w2(next: fn(str) -> str) -> fn(str) -> str {
    return fn(s: str) -> str {
        return next(s) + "?";
    };
}

// a closure in a closure: the inner one calls what the outer one captured
fn w3(next: fn(str) -> str) -> fn(str) -> str {
    return fn(s: str) -> str {
        val inner = fn(t: str) -> str {
            return "[" + next(t) + "]";
        };
        return inner(s);
    };
}

fn twice(f: fn(i64) -> i64) -> fn(i64) -> i64 {
    return fn(x: i64) -> i64 {
        return f(f(x));
    };
}

fn main() {
    val f = w(up);
    println(f("a"));
    val g = w2(up);
    println(g("b"));
    val h = w3(up);
    println(h("c"));
    val add5 = fn(x: i64) -> i64 {
        return x + 5;
    };
    val t = twice(add5);
    println(t(5));
}
