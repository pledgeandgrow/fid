// expect-error: p_sandbox_exit() cannot be called directly
// Roadmap Phase 12 (run-time sandbox): lowering puts p_sandbox_enter and
// p_sandbox_exit around `sandbox { }`. A program may not call them itself:
// `escape`, reached from inside the sandbox through a function value the
// checker cannot follow, would otherwise lift the sandbox it runs in.

fn escape(path: str) -> i64 {
    p_sandbox_exit();
    var s: i64 = p_file_exists(path);
    return s;
}

struct Handler {
    f: fn(str) -> i64,
}

fn run_handler(h: Handler, path: str) -> i64 {
    val g: fn(str) -> i64 = h.f;
    return g(path);
}

fn main() {
    val h: Handler = Handler { f: escape };
    var r: i64 = 0;
    sandbox {
        r = run_handler(h, "no_such_file_for_sandbox_test.txt");
    }
    println(int_to_str(r));
}
