fn unsparse(s: str, total: i64) -> Vec<i64> {
    var out: Vec<i64> = Vec::filled(total, 0);
    val parts: Vec<str> = str_split(s, ";");
    var i: i64 = 0;
    while i < parts.len() {
        val kv: Vec<str> = str_split(parts.get(i), ":");
        val off: i64 = str_parse_int(kv.get(0));
        val bs: Vec<i64> = hex_decode_bytes(kv.get(1));
        var j: i64 = 0;
        while j < bs.len() {
            out.set(off + j, bs.get(j));
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}

fn host_symbols(name: str) -> i64 {
    if name == "ext_var" {
        return 6295552;
    }
    if name == "ext_func" {
        return 6295808;
    }
    return -1;
}

fn no_symbols(name: str) -> i64 {
    return -1;
}

fn hx(v: i64) -> str {
    return str_to_lower(int_to_hex(v));
}

fn count_loads(img: & ElfImage) -> i64 {
    return img.segs.len() / 3;
}

fn main() {
    println("gnu hash: " + hx(elf_gnu_hash("")) + " " + hx(elf_gnu_hash("printf")) + " " + hx(elf_gnu_hash("exit")) + " " + hx(elf_gnu_hash("syscall")) + " " + hx(elf_gnu_hash("flapenguin.me")));
    println("sysv hash: " + hx(elf_sysv_hash("")) + " " + hx(elf_sysv_hash("printf")) + " " + hx(elf_sysv_hash("exit")));

    val base: i64 = 139637976727552;
    var img: ElfImage = elf_load(unsparse(LIB_X64(), 2960), base);
    println(elf_machine_name(img.machine) + " DYN: " + int_to_str(count_loads(&img)) + " PT_LOAD, image " + int_to_str(img.mem.len()) + " bytes at base " + hx(img.base) + ", entry " + hx(img.entry));
    println("x86-64 relocations applied: " + int_to_str(elf_relocate(&mut img, host_symbols)));
    println("pp -> priv: " + bool_to_str(elf_img_u64(&img, 9512) == base + 9508) + ", *greeting = " + elf_img_str(&img, elf_img_u64(&img, 9520) - base));
    println("GOT ext_var " + hx(elf_img_u64(&img, 9768)) + ", GOT counter (own definition) " + hx(elf_img_u64(&img, 9776)) + ", PLT slot ext_func " + hx(elf_img_u64(&img, 9808)));
    println("lookup add: gnu " + hx(base + elf_lookup_gnu(&img, "add").value) + " sysv " + hx(base + elf_lookup_sysv(&img, "add").value) + " elf_lookup " + hx(elf_lookup(&img, "add")));
    println("lookup missing " + int_to_str(elf_lookup(&img, "missing")) + ", undefined ext_var " + int_to_str(elf_lookup(&img, "ext_var")) + ", " + int_to_str(elf_sym_count(&img)) + " dynamic symbols");
    println("segment permissions: text " + elf_perms_at(&img, 5328) + " data " + elf_perms_at(&img, 9504) + " rodata " + elf_perms_at(&img, 1000));

    val b2: i64 = 139706696204288;
    var a64: ElfImage = elf_load(unsparse(LIB_A64(), 2928), b2);
    val n2: i64 = elf_relocate(&mut a64, host_symbols);
    println(elf_machine_name(a64.machine) + " DYN: relocations " + int_to_str(n2) + ", pp -> priv " + bool_to_str(elf_img_u64(&a64, 9480) == b2 + 9476) + ", ext_func slot " + hx(elf_img_u64(&a64, 9776)) + ", add at " + hx(elf_lookup(&a64, "add")));
    var u: ElfImage = elf_load(unsparse(LIB_X64(), 2960), base);
    elf_relocate(&mut u, no_symbols);
    println("unresolved: " + u.err);

    val exe: ElfImage = elf_load(unsparse(EXE_X64(), 1136), base);
    println("EXEC: entry " + hx(exe.entry) + ", base " + hx(exe.base) + ", image from " + hx(exe.vmin) + ", data_word " + int_to_str(elf_img_u32(&exe, 16785924)) + ", bss zero " + bool_to_str(elf_img_u64(&exe, 16785936) == 0 && elf_img_u64(&exe, 16786000) == 0));

    var bad: Vec<i64> = unsparse(EXE_X64(), 1136);
    bad.set(1, 0);
    println("bad magic: " + elf_load(bad, 0).err);
    bad.set(1, 69);
    bad.set(18, 3);
    println("other machine: " + elf_load(bad, 0).err);
}
