// Bugs roadmap BG429: on Windows the runtimes passed UTF-8 path text to the
// ANSI file API (`p_file_write("é.txt", ..)` made `Ã©.txt`, an existing
// `ü.txt` could not be opened). Paths are UTF-8 (reference §1); the C
// runtime now opens them through the wide API. A round trip through the
// runtime alone (write, exists, size, read, rename, list, delete) holds on
// every platform; what the directory holds is the name as written.
//
// Expected output:
// 0 true 2
// hi
// 0 false true
// bg429_dir_ü.txt
// 0 0
fn main() {
    p_mkdir("bg429_dir");
    println(f"{p_file_write("bg429_dir/bg429_é.txt", "hi")} {p_file_exists("bg429_dir/bg429_é.txt")} {p_file_size("bg429_dir/bg429_é.txt")}");
    match read_file("bg429_dir/bg429_é.txt") {
        Option::Some(s) => {
            println(s);
        }
        Option::None => {
            println("none");
        }
    }
    println(f"{p_rename("bg429_dir/bg429_é.txt", "bg429_dir/bg429_dir_ü.txt")} {p_file_exists("bg429_dir/bg429_é.txt")} {p_file_exists("bg429_dir/bg429_dir_ü.txt")}");
    println(p_dir_list("bg429_dir"));
    println(f"{p_file_delete("bg429_dir/bg429_dir_ü.txt")} {p_rmdir("bg429_dir")}");
}
