// LF8/LF9: expected to fail at run time (integer overflow). The fact
// `y < 100` holds on only one of the two ways into the join after
// `if flag { y = MAX }`: the arm that stores into `y` ends it, so the join
// has no fact and `y + 1` keeps its overflow check
// (compiler/checks.fd, peir_join_fact). A join that kept the fact would
// wrap to a negative number instead of panicking.

fn bump(x: i64, flag: bool) -> i64 {
    var y: i64 = x;
    if y < 100 {
        if flag {
            y = 9223372036854775807;
        }
        return y + 1;
    }
    return 0;
}

fn main() {
    println(bump(5, false));
    println(bump(5, true));
    print("unreachable\n");
}
