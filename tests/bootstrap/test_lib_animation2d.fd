// stdlib/animation2d: states, playback, looping and one-shot clips,
// speed, source rectangle, duration and progress. Times are powers of
// two so every sum is exact.
use animation2d;

fn main() -> i64 {
    var a = anim2d_create(16, 32);
    println(anim2d_state_count(&a));
    println(anim2d_current_frame(&a));
    println(anim2d_duration(&a));
    println(anim2d_progress(&a));
    println(anim2d_current_state_name(&a));

    var idle = anim2d_add_state(&mut a, "idle", 0, 4, 0.25, true);
    var jump = anim2d_add_state_row(&mut a, "jump", 8, 3, 0.5, false, 2);
    println(idle);
    println(jump);
    println(anim2d_state_count(&a));
    println(anim2d_find_state(&a, "jump"));
    println(anim2d_find_state(&a, "nope"));
    println(anim2d_play(&mut a, "nope"));

    // idle: 4 frames of 0.25s, looping
    println(anim2d_play(&mut a, "idle"));
    println(anim2d_current_state_name(&a));
    println(anim2d_duration(&a));
    anim2d_update(&mut a, 0.25);
    println(anim2d_current_frame(&a));
    anim2d_update(&mut a, 0.125);
    println(anim2d_current_frame(&a));
    println(anim2d_progress(&a));
    anim2d_update(&mut a, 0.125);
    println(anim2d_current_frame(&a));
    anim2d_update(&mut a, 0.25);
    anim2d_update(&mut a, 0.25);
    println(anim2d_current_frame(&a));
    anim2d_update(&mut a, 0.25);
    println(anim2d_current_frame(&a));
    println(anim2d_is_finished(&a));

    // playing the current state again does not restart it
    anim2d_update(&mut a, 0.25);
    println(anim2d_play(&mut a, "idle"));
    println(anim2d_current_frame(&a));

    // jump: row 2, frames 8..10, one shot
    anim2d_play_idx(&mut a, 1);
    println(anim2d_current_state_name(&a));
    println(anim2d_current_row(&a));
    anim2d_play_idx(&mut a, 7);
    anim2d_play_idx(&mut a, -1);
    println(anim2d_current_state_name(&a));
    var r = anim2d_source_rect(&a, 4);
    println(r.x);
    println(r.y);
    println(r.z);
    println(r.w);
    anim2d_update(&mut a, 0.5);
    anim2d_update(&mut a, 0.5);
    println(anim2d_current_frame(&a));
    anim2d_update(&mut a, 0.5);
    println(anim2d_current_frame(&a));
    println(anim2d_is_finished(&a));
    // a finished clip stays on its last frame
    anim2d_update(&mut a, 4.0);
    println(anim2d_current_frame(&a));
    var r2 = anim2d_source_rect(&a, 4);
    println(r2.x);
    println(r2.y);

    anim2d_reset(&mut a);
    println(anim2d_current_frame(&a));
    println(anim2d_is_finished(&a));

    // speed: 2x halves the time per frame, negative speed clamps to 0
    anim2d_set_speed(&mut a, 2.0);
    anim2d_update(&mut a, 0.25);
    println(anim2d_current_frame(&a));
    anim2d_set_speed(&mut a, -3.0);
    println(a.speed);
    anim2d_update(&mut a, 10.0);
    println(anim2d_current_frame(&a));
    return 0;
}
