// expect-error: binds associated types, so it cannot specialize the generic impl of Holder for Wrap
// Expected to FAIL (CE4): a narrower trait impl (`impl Holder for
// Wrap<i64>`) specializes the generic one (`impl<T> Holder for Wrap<T>`)
// method by method; the generic impl binds the associated types for every
// type, so the narrower one may not bind them again (parser.fd
// pd_timpl_as_spec_impl).
cap Holder {
    type Item;
    fn kind(self) -> str;
}

struct Wrap<T> {
    v: T,
}

impl<T> Holder for Wrap<T> {
    type Item = T;
    fn kind(self) -> str {
        return "any";
    }
}

impl Holder for Wrap<i64> {
    type Item = i64;
    fn kind(self) -> str {
        return "i64";
    }
}

fn main() -> i64 {
    val w: Wrap<i64> = Wrap { v: 3 };
    println(w.kind());
    return 0;
}
