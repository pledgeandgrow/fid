// DB1 (llvm-roadmap): helper of test_nattools_lines_files.fd, a second
// file of the program. lgf_count is generic: its instance lgf_count__i64
// (mono.fd mangle) has no file of its own recorded, and gets its line rows
// against this file, its generic's (ir.fd ir_fn_src_file). lgf_add1 is one
// straight-line block, so iropt inlines it into main: the instructions it
// leaves in main keep this file (ir.fd ir_copy_value_file), and main's
// code has rows against lines_files_mod.fd at lgf_add1's line.
module lines_files_mod;

pub fn lgf_count<T>(x: T, n: i64) -> T {
    // a loop, so the inliner leaves the instance a function of its own
    var k: i64 = 0;
    var acc: i64 = 0;
    while k < n {
        acc = acc + k;
        k = k + 1;
    }
    print(acc);
    print("\n");
    return x;
}

// Straight-line and small: iropt's inliner (iro_body) copies it into its
// caller. Its body's line is not a line main's own file has code on
// (dbg_db1_files_check.py looks for this file at this line inside main),
// so a row with the right number against the wrong file is not taken for
// one of main's own: test_nattools_lines_files.fd ends before this line.
//
// Without DB1's inlined-code files, main's rows show this line number
// against test_nattools_lines_files.fd, a line past that file's end.
//
pub fn lgf_add1(x: i64) -> i64 {
    val y: i64 = x * 3 + 1;
    return y;
}
