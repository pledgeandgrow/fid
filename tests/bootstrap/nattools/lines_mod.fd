// DB1: helper of test_nattools_lines.fd, a second file of the program. On
// the native Linux targets its functions get line rows against this file
// (the .debug_line file table has both files; readelf
// --debug-dump=decodedline shows lines_mod.fd for lm_triple; LmBox_bump
// is small enough to be inlined into main).
module lines_mod;

pub fn lm_triple(x: i64) -> i64 {
    // a loop, so the inliner leaves it a function of its own (code inlined
    // from this file into the caller is in the caller's rows)
    var y: i64 = 0;
    var k: i64 = 0;
    while k < 3 {
        y = y + x;
        k = k + 1;
    }
    return y;
}

pub struct LmBox {
    pub v: i64,
}

impl LmBox {
    pub fn bump(self: LmBox) -> i64 {
        val w: i64 = self.v + 1;
        return w;
    }
}
