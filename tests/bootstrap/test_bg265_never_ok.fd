// Bugs roadmap BG265: `-> !` functions that cannot return still compile:
// ending in panic, in another `-> !` call, in an endless loop, or in an
// if/else and a match whose branches all do not return.
//
// Expected output:
// 1
// 2
fn die(msg: str) -> ! {
    panic(msg);
}

fn die_twice(msg: str) -> ! {
    if msg == "" {
        die("empty");
    } else {
        die(msg);
    }
}

fn spin() -> ! {
    loop {
    }
}

fn pick_die(k: i64) -> ! {
    match k {
        0 => {
            die("zero");
        }
        _ => {
            spin();
        }
    }
}

fn pick(x: i64) -> i64 {
    if x > 0 {
        return x;
    }
    die_twice("negative");
}

fn main() -> i64 {
    println(pick(1));
    println(pick(2));
    if pick(3) < 0 {
        pick_die(0);
    }
    return 0;
}
