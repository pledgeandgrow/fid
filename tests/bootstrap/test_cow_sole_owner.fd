// LF16: Vec_set on a Vec with one owner provably (made here, kept in one
// variable, only given to core's Vec functions) skips the copy-on-write
// test in the C fast path (compiler/codegen_c.fd cg_mark_sole_vecs); a
// Vec that is shared keeps it. Both must still give these lines:
// sole 0 10 20 30 40
// shared a 1 2 3
// shared b 99 2 3
// moved 7 8
// sum 100

fn fill_sole() -> str {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 5 {
        v.push(0);
        i = i + 1;
    }
    i = 0;
    while i < 5 {
        v.set(i, i * 10);
        i = i + 1;
    }
    var out: str = "sole";
    i = 0;
    while i < v.len() {
        out = out + " " + int_to_str(v.get(i));
        i = i + 1;
    }
    return out;
}

fn show(name: str, v: Vec<i64>) -> str {
    var out: str = name;
    var i: i64 = 0;
    while i < v.len() {
        out = out + " " + int_to_str(v.get(i));
        i = i + 1;
    }
    return out;
}

fn give() -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(8);
    v.set(0, 7);
    return v;
}

fn main() {
    println(fill_sole());
    var a: Vec<i64> = Vec::new();
    a.push(1);
    a.push(2);
    a.push(3);
    var b: Vec<i64> = a;
    b.set(0, 99);
    println(show("shared a", a));
    println(show("shared b", b));
    println(show("moved", give()));
    var s: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < 4 {
        s.push(k);
        k = k + 1;
    }
    s.set(0, 25);
    s.set(1, 25);
    s.set(2, 25);
    s.set(3, 25);
    var t: i64 = 0;
    k = 0;
    while k < s.len() {
        t = t + s.get(k);
        k = k + 1;
    }
    println("sum " + int_to_str(t));
}
