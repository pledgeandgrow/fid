// stdlib/bigint: arbitrary-precision integers (competitive SL16):
// parsing and printing, arithmetic across limb boundaries, division with
// remainder, powers, modular exponentiation, comparisons, hex.
//
// Expected output:
// 30414093201713378043612608166064768844377641568960512000000000000
// 1000000000000000000000000000000
// 999999999999999999999999999999
// -123456789012345678901234567890
// 121932631137021795226185032733622923332237463801111263526900
// 123456789012345678901234567890 r 0
// 41152263004115226300411522630 r 0
// 1267650600228229401496703205376
// 4
// true true false
// 0xff 9007199254740993
use bigint;

fn main() -> i64 {
    // 50!
    var f: BigInt = bigint_one();
    var i: i64 = 2;
    while i <= 50 {
        f = bigint_mul_i64(f, i);
        i = i + 1;
    }
    println(bigint_to_str(f));
    var big: BigInt = bigint_from_str("1000000000000000000000000000000");
    println(bigint_to_str(big));
    println(bigint_to_str(bigint_sub(big, bigint_one())));
    var a: BigInt = bigint_from_str("123456789012345678901234567890");
    println(bigint_to_str(bigint_neg(a)));
    println(bigint_to_str(bigint_mul(a, bigint_from_str("987654321098765432109876543210"))));
    var dm: BigDiv = bigint_divmod(bigint_mul(a, bigint_from_i64(7)), bigint_from_i64(7));
    println(bigint_to_str(dm.q) + " r " + bigint_to_str(dm.r));
    var dm3: BigDiv = bigint_divmod(a, bigint_from_i64(3));
    println(bigint_to_str(dm3.q) + " r " + bigint_to_str(dm3.r));
    println(bigint_to_str(bigint_pow(bigint_from_i64(2), 100)));
    // 4^13 mod 497 = 445; 3^200 mod 13 = 3^(200 mod 12) = 3^8 mod 13 = 9
    println(bigint_to_str(bigint_modpow(bigint_from_i64(2), bigint_from_i64(10), bigint_from_i64(17))));
    println(bs(bigint_lt(bigint_from_i64(-5), bigint_from_i64(3))) + " " + bs(bigint_eq(bigint_from_str("00042"), bigint_from_i64(42)))
        + " " + bs(bigint_gt(bigint_zero(), bigint_one())));
    println(bigint_to_hex(bigint_from_i64(255)) + " " + bigint_to_str(bigint_add_i64(bigint_pow(bigint_from_i64(2), 53), 1)));
    return 0;
}

fn bs(b: bool) -> str {
    if b { return "true"; }
    return "false";
}
