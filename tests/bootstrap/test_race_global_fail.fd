// expect-error: 'bump' runs on another thread and writes the global 'counter' with no
// Two threads incrementing a global lose updates: rejected at compile time.
var counter: i64 = 0;

fn work() -> i64 {
    var i: i64 = 0;
    while i < 1000 {
        bump();
        i = i + 1;
    }
    return 0;
}

fn bump() {
    counter = counter + 1;
}

fn main() -> i64 {
    val a = spawn work();
    val b = spawn work();
    await a;
    await b;
    print(counter);
    return 0;
}
