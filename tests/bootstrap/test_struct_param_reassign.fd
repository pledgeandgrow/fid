// Bugs roadmap BG82: a by-value struct parameter the body assigns (`p =
// P { .. }`) had a slot holding a pointer to its copy; the assignment put
// the new value's pointer there and nothing dropped the new value (its
// string and Vec leaked; the first copy was dropped instead). The copy is
// the parameter's slot now, held inline as `var p: P = p;` holds it: the
// assignment drops the old fields and keeps the new ones (with `fid run
// --leaks` every block is freed). The caller's struct is not changed.
// Since Nov 23 a by-value parameter is not assigned (reference §5.3, as
// for a Vec parameter): the body changes a copy, `var p = p;`.
// Expected output:
// new1
// 1
// a0
// a0xxx
// a0 0

struct P {
    name: str,
    v: Vec<i64>,
}

fn reset(param: P) -> i64 {
    var nv: Vec<i64> = Vec::new();
    nv.push(3);
    var p: P = param;
    p = P { name: "new" + int_to_str(1), v: nv };
    println(p.name);
    return p.v.len();
}

fn grow(param: P, n: i64) -> str {
    var p: P = param;
    var i: i64 = 0;
    while i < n {
        p = P { name: p.name + "x", v: Vec::new() };
        i = i + 1;
    }
    return p.name;
}

fn main() -> i64 {
    var a: P = P { name: "a" + int_to_str(0), v: Vec::new() };
    println(int_to_str(reset(a)));
    println(a.name);
    println(grow(a, 3));
    println(a.name + " " + int_to_str(a.v.len()));
    return 0;
}
