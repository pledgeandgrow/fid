// Roadmap L6C (type-safe function pointer lookup): a C function looked up
// at run time with p_dl_find and bound with a function type
// (`val sq: fn(f64) -> f64 = p_dl_find(libm, "sqrt")`) is called through
// that type as a plain C function: no closure env, each argument and the
// result passed with its own C type (f64 in a float register, str as a
// pointer). The type checker checks the type (C types only) and every call
// through it (TypeChecker_check_dl_sym); lowering makes the binding a C
// function pointer (lower.fd Lowerer_dl_fn_let_type), which a call reaches
// through codegen_c's CallPtr. It can also be handed to a function taking
// a `fn(..)` parameter.
// Needs the OS loader: fid ccompile only, like test_dl_find.fd and
// test_fix_fnval_c_ptr.fd (the interpreter cannot call machine code).
// Expected output:
//     llabs(-42) = 42
//     strlen("hello") = 5
//     sqrt(2.25) * 100 = 150
//     pow(2, 10) = 1024
//     through a parameter: 7
//     untyped: 9

fn open_first(names: Vec<str>) -> i64 {
    var i: i64 = 0;
    while i < names.len() {
        val h: i64 = p_dl_load(names.get(i));
        if h != 0 {
            return h;
        }
        i = i + 1;
    }
    return 0;
}

fn open_libc() -> i64 {
    var names: Vec<str> = Vec::new();
    names.push("ucrtbase.dll");
    names.push("msvcrt.dll");
    names.push("libc.so.6");
    names.push("libc.so");
    names.push("/usr/lib/libSystem.B.dylib");
    return open_first(names);
}

fn open_libm() -> i64 {
    var names: Vec<str> = Vec::new();
    names.push("ucrtbase.dll");
    names.push("msvcrt.dll");
    names.push("libm.so.6");
    names.push("libm.so");
    names.push("/usr/lib/libSystem.B.dylib");
    return open_first(names);
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

fn main() {
    val libc: i64 = open_libc();
    val libm: i64 = open_libm();
    if libc == 0 || libm == 0 {
        println("no C library");
        return;
    }
    val ab: fn(i64) -> i64 = p_dl_find(libc, "llabs");
    println("llabs(-42) = " + int_to_str(ab(0 - 42)));
    val slen: fn(str) -> i64 = p_dl_find(libc, "strlen");
    println("strlen(\"hello\") = " + int_to_str(slen("hello")));
    val sq: fn(f64) -> f64 = p_dl_find(libm, "sqrt");
    val r: f64 = sq(2.25);
    println("sqrt(2.25) * 100 = " + int_to_str((r * 100.0) as i64));
    val pw: fn(f64, f64) -> f64 = p_dl_find(libm, "pow");
    println("pow(2, 10) = " + int_to_str(pw(2.0, 10.0) as i64));
    println("through a parameter: " + int_to_str(apply(ab, 0 - 7)));
    val raw: i64 = p_dl_find(libc, "llabs");
    println("untyped: " + int_to_str(p_dl_call(raw, 0 - 9)));
    p_dl_unload(libm);
    p_dl_unload(libc);
}
