// Test: Bare-metal kernel with serial output — Phase 5A.6
// Tests serial port init, GDT setup, IDT setup, and serial output.
// This program runs in --bare mode (no stdlib, no OS).

// Forward declarations for bare-metal builtins
extern fn p_serial_init();
extern fn p_serial_write(c: i64);
extern fn p_cli();
extern fn p_sti();
extern fn p_hlt();
extern fn p_lgdt(gdt_desc: i64);
extern fn p_gdt_set_entry(gdt_ptr: i64, index: i64, base: i64, limit: i64, flags: i64);
extern fn p_lidt(idt_desc: i64);
extern fn p_idt_set_entry(idt_ptr: i64, vector: i64, handler: i64, flags: i64);

// GDT flags
const GDT_CODE: i64 = 0x9A;
const GDT_DATA: i64 = 0x92;
const GDT_GRAN: i64 = 0x0C00;

// IDT flags
const IDT_PRESENT: i64 = 0x80;
const IDT_INTERRUPT: i64 = 0x0E;

// Serial output helper (writes a single character)
fn serial_putc(c: i64) {
    p_serial_write(c);
}

// Write "OK" to serial
fn serial_ok() {
    p_serial_write(79);  // 'O'
    p_serial_write(75);  // 'K'
    p_serial_write(10);  // '\n'
}

// Interrupt handler: timer (IRQ0)
interrupt fn timer_handler() {
    // In a real OS, this would handle the timer tick
    return 0;
}

fn main() {
    // 1. Disable interrupts during setup
    p_cli();

    // 2. Initialize serial port (COM1, 115200 baud)
    p_serial_init();

    // 3. Send boot message
    serial_ok();

    // 4. Set up GDT (flat model: null + code + data)
    // In a real kernel, GDT would be in a fixed memory location
    // For this test, we just call the builtins
    // p_gdt_set_entry calls would go here with real memory addresses

    // 5. Set up IDT
    // p_idt_set_entry calls would go here with real memory addresses

    // 6. Enable interrupts
    p_sti();

    // 7. Halt
    p_hlt();

    return 0;
}
