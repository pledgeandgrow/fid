// BG213 (docs/roadmap/bugs-roadmap.md), compiler/cparser.fd (what `fid
// parse-header` and `@import("x.h")` use), on at_import/cunsigned_bg213.h:
// a #define constant is evaluated with C's integer types. `-1u / 2` was 0
// (want 2147483647), `-1u` and `~0u` -1 (want 4294967295): the `u` suffix
// was dropped and every value was a signed 64-bit one. Now each value has
// its C type (int, unsigned int, long long, unsigned long long), the
// operands of an operator are converted to their common type, and `?:`,
// comparisons, `&&`/`||` and `0b` literals are evaluated (they were
// dropped with no note); an #if computes in 64 bits.
//
// Expected output:
// UDIV ok
// UNEG ok
// MASK ok
// NESTED ok
// COND ok
// CMP ok
// BIN ok
// HEXWRAP ok
// DECBIG ok
// ULLDIV ok
// ULLSHR ok
// MIXED ok
// WIDEMIX ok
// SHIFTU ok
// SHIFTS ok
// LOGIC ok
// SKIPDIV ok
// REM ok
// UREM ok
// CHARS ok
// TERNU ok
// NE ok
// PP_UNSIGNED ok
// PP_SKIP ok

use core;
use vec;
use string;
use compiler::cparser;

fn check(out: str, name: str, value: str) {
    if str_contains(out, "pub const " + name + ": i64 = " + value + ";") {
        println(name + " ok");
    } else {
        println(name + " MISSING: " + value);
    }
}

fn main() -> i64 {
    val out: str = cparse_header_file("tests/bootstrap/at_import/cunsigned_bg213.h", "", "");
    check(out, "UDIV", "2147483647");
    check(out, "UNEG", "4294967295");
    check(out, "MASK", "4294967295");
    check(out, "NESTED", "2147483647");
    check(out, "COND", "1");
    check(out, "CMP", "0");
    check(out, "BIN", "10");
    check(out, "HEXWRAP", "0");
    check(out, "DECBIG", "4294967296");
    check(out, "ULLDIV", "9223372036854775807");
    check(out, "ULLSHR", "9223372036854775807");
    check(out, "MIXED", "0");
    check(out, "WIDEMIX", "1");
    check(out, "SHIFTU", "1");
    check(out, "SHIFTS", "-4");
    check(out, "LOGIC", "1");
    check(out, "SKIPDIV", "0");
    check(out, "REM", "-1");
    check(out, "UREM", "9");
    check(out, "CHARS", "66");
    check(out, "TERNU", "4294967295");
    check(out, "NE", "0");
    check(out, "PP_UNSIGNED", "1");
    check(out, "PP_SKIP", "1");
    return 0;
}
