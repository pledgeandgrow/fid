// expect-error: spread source expected Point, got Size
//! error: spread source expected Point, got Size
// TL2: a test per diagnostic of the type, borrow and escape checks.
// `S { .., ..src }` copies the other fields from a value of type S.

struct Point {
    x: i64,
    y: i64,
}

struct Size {
    w: i64,
    h: i64,
}

fn main() -> i64 {
    val s = Size { w: 1, h: 2 };
    val p = Point { x: 5, ..s };
    println(p.x);
    return 0;
}
