// expect-error: cannot order two str values
// BG202 (docs/roadmap/bugs-roadmap.md): `< > <= >=` on two str values are
// an error in a program (the reference defines only `==` and `!=` for
// text). Before, the interpreter panicked "Arithmetic error (str, str)"
// and C compared addresses.
fn main() -> i64 {
    val a = "abc";
    val b = "abd";
    if a < b {
        println("lt");
    }
    return 0;
}
