// expect-error: the task whose handle is 't' in 'start' is never awaited, joined or detached
// CA6: a handle kept in a variable that is never read again is a task
// left behind as much as `spawn f(x);` is: `start` returns while the
// task may still run. A handle that is awaited, passed on or returned is
// accepted (test_spawn_detached.fd, test_async_threads.fd).

fn work(n: i64) -> i64 {
    return n * 2;
}

fn start(n: i64) -> i64 {
    val t = spawn work(n);
    return n;
}

fn main() {
    println(start(3));
}
