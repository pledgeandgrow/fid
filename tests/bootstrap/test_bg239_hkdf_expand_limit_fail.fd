// BG239 (docs/roadmap/bugs-roadmap.md): hkdf_expand refuses a length over
// 255 * 32 bytes. RFC 5869 allows at most 255 blocks of the hash's size;
// before, the counter byte reached 256 and the output was not HKDF.
//
// Expected to fail at run time: the last call panics.
//
//> rfc 5869 vector 1: true
//> 8161 bytes:
//! panic
use encoding;
use tls_crypto;

/// hkdf_* give key material, which is @secret: the test reads the RFC
/// vector through this audited release.
@declassify fn reveal(v: Vec) -> Vec { return v; }

fn main() {
    var salt: Vec = hex_decode_bytes("000102030405060708090a0b0c");
    var ikm: Vec = hex_decode_bytes("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");
    var prk: Vec = reveal(hkdf_extract(salt, ikm));
    var info: Vec = hex_decode_bytes("f0f1f2f3f4f5f6f7f8f9");

    // RFC 5869 test case 1
    print("rfc 5869 vector 1: ");
    println(hex_encode_bytes(reveal(hkdf_expand(prk, info, 42))) == "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865");

    // one byte over the limit is not HKDF any more
    print("8161 bytes:\n");
    var too_long: Vec = reveal(hkdf_expand(prk, info, 8161));
    print(too_long.len());
    print("\n");
    print("unreachable\n");
}
