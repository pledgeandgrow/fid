// expect-error: Init error: variable 'x' is used before being assigned a value.
// Bugs roadmap BG20: an `if` used as a value let an assignment in one of
// its branches count for both.
fn main() -> i64 {
    val c: bool = false;
    var x: i64;
    val n: i64 = if c {
        x = 1;
        2
    } else {
        3
    };
    println(int_to_str(x + n));
    return 0;
}
