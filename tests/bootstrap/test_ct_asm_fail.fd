// expect-error: function 'leaky_eq' branches on secret data (`if`).
// test_ct_asm_fail.fd — an `if` on data in @constant_time code: rejected by
// the source-level check (TypeChecker::verify_constant_time). What only the
// post-codegen assembly verifier can see is covered by the unit test
// `ct_asm_checked_add_is_rejected` in src/codegen_x64.rs.

@constant_time
fn leaky_eq(a: i64, b: i64) -> i64 {
    var result = 0;
    if a == b {
        result = 1;
    } else {
        result = 0;
    }
    return result;
}

fn main() {
    print(leaky_eq(5, 5));
    print(leaky_eq(5, 6));
}
