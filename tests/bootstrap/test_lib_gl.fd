// stdlib/gl: the OpenGL bindings are all calls into libGL, so a program
// cannot create buffers, textures or shaders without a GL context. What
// can run without one: the constants (checked against the values in the
// OpenGL headers) and gl_error_string.
use gl;

fn main() -> i64 {
    println(gl_error_string(GL_NO_ERROR));
    println(gl_error_string(GL_INVALID_ENUM));
    println(gl_error_string(GL_INVALID_VALUE));
    println(gl_error_string(GL_INVALID_OPERATION));
    println(gl_error_string(GL_OUT_OF_MEMORY));
    println(gl_error_string(0x0506));
    println(gl_error_string(-1));

    println(GL_NO_ERROR);
    println(GL_INVALID_ENUM);
    println(GL_INVALID_VALUE);
    println(GL_INVALID_OPERATION);
    println(GL_OUT_OF_MEMORY);
    println(GL_ARRAY_BUFFER);
    println(GL_ELEMENT_ARRAY_BUFFER);
    println(GL_STATIC_DRAW);
    println(GL_DYNAMIC_DRAW);
    println(GL_STREAM_DRAW);
    println(GL_FLOAT);
    println(GL_UNSIGNED_INT);
    println(GL_UNSIGNED_BYTE);
    println(GL_RGB);
    println(GL_RGBA);
    println(GL_LINEAR);
    println(GL_NEAREST);
    println(GL_CLAMP_TO_EDGE);
    println(GL_REPEAT);
    println(GL_TEXTURE_MIN_FILTER);
    println(GL_TEXTURE_MAG_FILTER);
    println(GL_FRONT);
    println(GL_BACK);
    println(GL_CW);
    println(GL_CCW);
    println(GL_SRC_ALPHA);
    println(GL_ONE_MINUS_SRC_ALPHA);
    return 0;
}
