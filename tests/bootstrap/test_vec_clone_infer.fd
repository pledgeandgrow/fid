// A variable declared without a type from `v.clone()` is a Vec (it held
// the clone as a number: println printed an address).
//
// Expected output:
// [1, 2]
// [1, 2, 3]
// 3

fn main() -> i64 {
    var a: Vec<i64> = Vec::new();
    a.push(1);
    a.push(2);
    var b = a.clone();
    b.push(3);
    println(a);
    println(b);
    println(b.len());
    return 0;
}
