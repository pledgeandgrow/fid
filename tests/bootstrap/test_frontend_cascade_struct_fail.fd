// expect-error: unknown struct 'Pointt'
// CE6: a misspelt struct name written three times in one function is one
// error, not three.

struct Point {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    val a = Pointt { x: 1, y: 2 };
    val b = Pointt { x: 3, y: 4 };
    val c = Pointt { x: 5, y: 6 };
    return 0;
}
