// expect-error: indexes with `[...]`
// Bugs roadmap BG130: the panic-risk scan missed f-strings: `f"{v[b]}"` in a
// @crashfree function read out of bounds.
@crashfree
@wrapping
fn cf(v: Vec<i64>, b: i64) -> str {
    return f"{v[b]}";
}
fn main() -> i64 { var v: Vec<i64> = Vec::new(); println(cf(v, 0)); return 0; }
