// Bugs roadmap BG288: closures that return on every path still compile.
//
// Expected output:
// 1 0
// pos neg
// 5
fn main() -> i64 {
    val f = fn(y: i64) -> i64 {
        if y > 0 {
            return 1;
        }
        return 0;
    };
    val g = fn(y: i64) -> str {
        if y > 0 {
            return "pos";
        } else {
            return "neg";
        }
    };
    val h = fn(y: i64) -> i64 { y + 1 };
    println(f"{f(3)} {f(-3)}");
    println(f"{g(1)} {g(-1)}");
    println(h(4));
    return 0;
}
