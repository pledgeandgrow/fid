// SP5 (docs/roadmap/llvm-roadmap.md): code generation by workers
// (compiler/nat_ir.fd ng_par_finish, FID_NAT_PAR=1). The program has what
// a worker's buffer has to carry into the image: loops (x86-64 pads loop
// heads to 16 bytes, so some functions are emitted again in place), calls
// to functions placed before and after, recursion, functions with the same
// code (folded into one), checked division and indexing (panic stubs with
// a line, shared between functions), strings, a struct result and floats.
// tests/nattools/par_emit_check.sh builds it with and without
// FID_NAT_PAR=1 on every machine-layer target and requires identical
// images; this output is what every backend prints.
// Expected output:
// 5050
// 5050
// 5050
// 55
// 3628800
// 7 2
// 4 9
// par-emit ok
// 11
// 2.5
// 36
// 8

struct Pair {
    a: i64,
    b: i64,
}

fn sum_to(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        s = s + i;
        i = i + 1;
    }
    return s;
}

// Same code as sum_to: folded into it
fn sum_to_again(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fn sum_by_vec(n: i64) -> i64 {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 1;
    while i <= n {
        v.push(i);
        i = i + 1;
    }
    var s: i64 = 0;
    var k: i64 = 0;
    while k < v.len() {
        s = s + v.get(k);
        k = k + 1;
    }
    return s;
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn fact(n: i64) -> i64 {
    if n <= 1 {
        return 1;
    }
    return n * fact(n - 1);
}

fn divmod(a: i64, b: i64) -> Pair {
    return Pair { a: a / b, b: a % b };
}

fn mix(x: i64, y: i64) -> Pair {
    var p: Pair = divmod(x * 3, y);
    return Pair { a: p.a + p.b, b: x + y };
}

fn word(n: i64) -> str {
    if n > 0 {
        return "par-emit ok";
    }
    return "par-emit wrong";
}

fn count_bytes(s: str) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) != 32 {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn halve(x: f64) -> f64 {
    return x / 2.0;
}

fn squares(n: i64) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < n {
        var j: i64 = 0;
        while j < n {
            t = t + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    return t;
}

fn main() -> i64 {
    println(sum_to(100));
    println(sum_to_again(100));
    println(sum_by_vec(100));
    println(fib(10));
    println(fact(10));
    var p: Pair = divmod(23, 3);
    println(int_to_str(p.a) + " " + int_to_str(p.b));
    var q: Pair = mix(4, 5);
    println(int_to_str(q.a) + " " + int_to_str(q.b));
    var w: str = word(1);
    println(w);
    println(count_bytes("par-emit ok  x"));
    println(halve(5.0));
    println(squares(6));
    println(sum_to(3) + 2);
    return 0;
}
