// OP21 / TG11 (known-bugs 2g.96): integers of 16 to 20 characters as text,
// with values kept live across the conversions. pe_ir's p_to_str stub (the
// default Windows `fid emit`) built the digits in a 16-byte stack buffer
// under its saved r14: a long number overwrote the caller's r14 and
// test_simd_i64 crashed printing i64::MIN in its `wrap:` line. Every
// backend prints the same.
//
// Expected output:
// -9223372036854775808 9223372036854775807
// 0 -1 1000000000000000 -1000000000000000
// [-9223372036854775808, 9223372036854775807, 0, -2]
// 1234567890123456789 -1234567890123456789
// sum 176 kept 7 11 13
// 99999999999999999 len 17
// -100000000000000000 len 19
fn big(i: i64) -> i64 {
    if i == 0 {
        return 0 - 9223372036854775807 - 1;
    }
    if i == 1 {
        return 9223372036854775807;
    }
    return i * 1234567890123456789 / i;
}

fn main() -> i64 {
    // values live in callee-saved registers across every conversion
    var a: i64 = 7;
    var b: i64 = 11;
    var c: i64 = 13;
    println(int_to_str(big(0)) + " " + int_to_str(big(1)));
    println(int_to_str(0) + " " + int_to_str(0 - 1) + " " + int_to_str(1000000000000000) + " " + int_to_str(0 - 1000000000000000));
    var v: Vec<i64> = Vec::new();
    v.push(big(0));
    v.push(big(1));
    v.push(0);
    v.push(0 - 2);
    println(v);
    println(int_to_str(big(5)) + " " + int_to_str(0 - big(5)));
    var sum: i64 = 0;
    var i: i64 = 0;
    while i < 9 {
        val s: str = int_to_str(big(i % 2) / 3);
        sum = sum + str_len(s) + a - b + c - 9;
        i = i + 1;
    }
    println("sum " + int_to_str(sum) + " kept " + int_to_str(a) + " " + int_to_str(b) + " " + int_to_str(c));
    val n1: str = int_to_str(99999999999999999);
    println(n1 + " len " + int_to_str(str_len(n1)));
    val n2: str = int_to_str(0 - 100000000000000000);
    println(n2 + " len " + int_to_str(str_len(n2)));
    return 0;
}
