// expect-error: cannot destructure i64 as a tuple
//! error: cannot destructure i64 as a tuple
// TL2: a test per diagnostic of the type, borrow and escape checks.
// Only a tuple can be destructured into names.

fn main() -> i64 {
    var n: i64 = 5;
    val (a, b) = n;
    println(a);
    return 0;
}
