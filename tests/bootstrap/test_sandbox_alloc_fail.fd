// expect-error: Sandbox error: 'p_malloc()' requires 'Alloc' capability
// test_sandbox_alloc_fail.fd -- Verify sandbox { } blocks allocation
//
// This test should FAIL to compile: p_malloc inside sandbox { } should
// produce a "Sandbox error: requires 'Alloc' capability" error.

module test_sandbox_alloc_fail;

use core;

pub fn main() -> i64 {
    sandbox {
        // This should be rejected: allocation inside sandbox
        var ptr: i64 = p_malloc(100);
        p_free(ptr);
    }
    return 0;
}
