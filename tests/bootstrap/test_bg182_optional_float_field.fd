// Bugs roadmap BG182: `a?.f` of an f64 (or f32) field read the field into
// an i64 slot (lower.fd Expr::OptionalFieldAccess): run printed the bits
// (4612811918334230528 for 2.5), C the truncation (2), emit
// 4612811918334230500. The result slot has the field's float type now,
// and a None gives 0.0. The struct is taken from the receiver's Option
// type when it is known, so another struct with a field of the same name
// does not decide the layout.
//
// Expected output:
// 2.5
// 0
// 3.5
// 7
// 1.25
// hi
// 9

struct Q {
    k: i64,
    f: i64,
}

struct P {
    x: i64,
    f: f64,
    s: str,
    g: f32,
}

fn mk(b: bool) -> Option<P> {
    if b {
        return Option::Some(P { x: 7, f: 2.5, s: "hi", g: 1.25 as f32 });
    }
    return Option::None;
}

fn main() -> i64 {
    val q = Q { k: 9, f: 4 };
    val a = mk(true);
    val n = mk(false);
    val f: f64 = a?.f;
    println(f);
    val z: f64 = n?.f;
    println(z);
    println(a?.f + 1.0);
    println(a?.x);
    val g: f32 = a?.g;
    println(g as f64);
    val s: str = a?.s;
    println(s);
    println(q.k);
    return 0;
}
