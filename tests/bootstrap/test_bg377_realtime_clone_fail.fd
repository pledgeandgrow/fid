// expect-error: calls '.clone()', which allocates
// Bugs roadmap BG377: @realtime accepted `v.clone()` ("clone" was in no
// list), which copies the Vec into a new buffer.
@realtime
fn f(v: Vec<i64>) -> i64 {
    val w = v.clone();
    return w.len();
}
fn main() {
    var v: Vec<i64> = Vec::new();
    println(f(v));
}
