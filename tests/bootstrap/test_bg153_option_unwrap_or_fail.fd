// expect-error: parameter 1 expects 'i64', got 'str'
// Bugs roadmap BG153: `Option<i64>.unwrap_or("d")` was accepted and
// monomorphization made Option__unwrap_or__str, which panicked at run time.
fn main() -> i64 {
    val o: Option<i64> = Option::Some(1);
    val s: i64 = o.unwrap_or("d");
    println(s);
    return 0;
}
