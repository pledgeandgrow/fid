// expect-error: function 'np' uses '/'
// Bugs roadmap BG150: `x /= b` divides as `x / b` does; @no-panic only
// looked at the right-hand side of an assignment, not at `/=`, so this
// was accepted and panicked "Division by zero".
@no-panic
fn np(a: i64, b: i64) -> i64 {
    var x: i64 = a;
    x /= b;
    return x;
}

fn main() -> i64 {
    println(np(3, 1));
    return 0;
}
