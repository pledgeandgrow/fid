// expect-error: is consumed in some branches of this `match`
// Bugs roadmap BG187: a match value with one consuming arm was accepted.
@linear
struct Tok {
    v: i64,
}

fn use_tok(t: Tok) -> i64 {
    return t.v;
}

fn main() -> i64 {
    val t = Tok { v: 1 };
    val k: i64 = 1;
    val n: i64 = match k {
        1 => use_tok(t),
        _ => 0,
    };
    println(n);
    return 0;
}
