// Driver goal MI18 (docs/roadmap/llvm-roadmap.md): `fid build <file>
// --native` with the default target is the machine layer's x86-64 Linux
// executable (compiler/nat_ir.fd), no longer the old PIR path (compiler.fd
// build_executable: opt.fd, codegen_x64.fd, peephole.fd, elf64.fd), which
// crashed in opt.fd pass_jump_thread. scripts/driver-goals-check.sh builds
// this with `fid build test_driver_native.fd --native -o <out>`, checks it
// is an x86-64 ELF, and runs it on a Linux x86-64 host.
// Expected output:
// 5050
// fizz 3 buzz 5
// done

fn sum_to(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 1;
    while i <= n {
        s = s + i;
        i = i + 1;
    }
    return s;
}

fn label(i: i64) -> str {
    if i % 3 == 0 {
        return "fizz " + int_to_str(i);
    }
    if i % 5 == 0 {
        return "buzz " + int_to_str(i);
    }
    return "";
}

fn main() -> i64 {
    println(sum_to(100));
    println(label(3) + " " + label(5));
    println("done");
    return 0;
}
