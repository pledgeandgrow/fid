// test_shard_fail.fd — ML13: @shard without Comm effect
// Expected: FAIL (compile error)
// @shard functions must have Comm effect for cross-rank communication.

use tensor;

@shard(dim=0)
fn bad_shard(a: Tensor, b: Tensor) -> Tensor {
    // No communication — each rank computes independently, wrong result
    val result = matmul(a, b);
    return result;
}

fn main() {
    val a = ones(vec2(2, 2));
    val b = ones(vec2(2, 2));
    val result = bad_shard(a, b);
    return 0;
}

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}
