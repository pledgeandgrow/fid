// expect-error: function 'f' has @gas(20) but total gas cost is
// Bugs roadmap BG382: @gas(N) charged nothing for a method call: callees
// were looked up by the bare method name, but methods are registered as
// `Type_method`, so `s.heavy()` (cost ~12,000) was free.
struct S { a: i64 }
impl S {
    fn heavy(self) -> i64 {
        var t: i64 = 0;
        for i in 0..1000 {
            t = t + i * i + i * 3 + 7;
        }
        return t;
    }
}
@gas(20)
fn f(s: S) -> i64 {
    return s.heavy();
}
fn main() {
    println(f(S { a: 1 }));
}
