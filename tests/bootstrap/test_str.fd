use vec;

fn test_simple() -> str {
    var s = "<svg width=\"";
    s = s + "600";
    s = s + "\">";
    return s;
}

fn test_int() -> str {
    var s = "<svg width=\"";
    s = s + int_to_str(600);
    s = s + "\">";
    return s;
}

fn main() -> i64 {
    var a = test_simple();
    print("simple: ");
    print(a);
    var b = test_int();
    print("int: ");
    print(b);
    return 0;
}
