// Test: a fixed-size array bound with its type written out
// (`var a: [i64; 3] = [1, 2, 3]`) reads back the same elements as one
// whose type is inferred (`val b = [1, 2, 3]`), on every backend.
// Found by CI5 (scripts/wasm-test.sh): lowering gave the typed variable a
// slot of type `[i64; 3]` and stored the array's address into it
// (compiler/lower.fd Lowerer_lower_let_stmt), where the inferred one gets
// a `*[i64; 3]` slot. The interpreter then read the address as element 0
// and zeros after it (it printed 4808 for the sum, 0 for a[1]); `fid wasm`
// loaded the address and printed the right values.
// Expected output:
//   6
//   2
//   3
//   6
//   24
//   9
//   typed arrays ok

fn sum3(v: [i64; 3]) -> i64 {
    var t: [i64; 3] = v;
    return t[0] + t[1] + t[2];
}

fn main() {
    var a: [i64; 3] = [1, 2, 3];
    var s: i64 = 0;
    var i: i64 = 0;
    while i < 3 {
        s = s + a[i];
        i = i + 1;
    }
    print(s);
    print("\n");
    print(a[1]);
    print("\n");
    var k: i64 = 2;
    print(a[k]);
    print("\n");
    val b = [1, 2, 3];
    print(sum3(b));
    print("\n");
    var w: [i64; 4] = [3, 5, 7, 9];
    var t: i64 = 0;
    for x in w {
        t = t + x;
    }
    print(t);
    print("\n");
    a[2] = 9;
    print(a[2]);
    print("\n");
    println("typed arrays ok");
}
