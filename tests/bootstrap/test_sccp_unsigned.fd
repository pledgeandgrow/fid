// Test (known-bugs 2g.11): constant folding keeps the arithmetic of the
// operands' type: a u64 above i64's range compares and divides unsigned.
//
// Expected output:
// big > 1: true
// big / 2 > 1: true
// 255
fn main() -> i64 {
    val big: u64 = 18446744073709551615;
    if big > 1 { println("big > 1: true"); } else { println("big > 1: false"); }
    val half: u64 = big / 2;
    if half > 1 { println("big / 2 > 1: true"); } else { println("big / 2 > 1: false"); }
    val b: u8 = 200;
    val c: u8 = 55;
    println(int_to_str((b + c) as i64));
    return 0;
}
