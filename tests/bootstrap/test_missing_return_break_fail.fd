// expect-error: 'f' is declared to return i64 but can reach the end of its body withou
// Expected to FAIL: the break inside `unsafe` leaves the loop, so f can fall
// off its end without returning an i64 (missing return).
fn f(n: i64) -> i64 {
    loop {
        unsafe {
            if n > 0 { break; }
        }
        return 1;
    }
}
fn main() { println(f(5)); }
