// expect-error: in 'main', a secret value reaches output 'assert'
// Expected to FAIL (BG98, docs/roadmap/bugs-roadmap.md): a failed
// assertion, a panic and an exit end the program where anyone can see it,
// so their condition, message and status are outputs. `assert(key != 7)`
// tells whether the key is 7; panic, assert and exit were not sinks.
fn main() -> i64 {
    @secret val key: i64 = 42;
    assert(key != 7);
    println("done");
    return 0;
}
