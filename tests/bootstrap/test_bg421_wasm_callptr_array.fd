// Bugs roadmap BG421: `fid wasm` passed the env as the result pointer of a
// call through a function value whose result is a fixed array (BG135's fix
// covered pe_ir and nat_ir for arrays, wasm only for structs): 8650776
// instead of 18.
//
// Expected output:
// 18
// 7 14 21
fn mk(n: i64) -> [i64; 3] {
    return [n, n * 2, n * 3];
}
fn main() {
    val g = mk;
    val b = g(3);
    println(b[0] + b[1] + b[2]);
    val c = g(7);
    println(f"{c[0]} {c[1]} {c[2]}");
}
