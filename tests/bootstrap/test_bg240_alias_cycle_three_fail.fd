// expect-error: a cycle of type aliases
// BG240 (docs/roadmap/bugs-roadmap.md): an alias of itself, three aliases
// in a ring, and a cycle that passes through a reference: each is an
// error, named once.
type S = S;
type P = Q;
type Q = &R;
type R = P;

fn main() -> i64 {
    val x: S = 1;
    return x;
}
