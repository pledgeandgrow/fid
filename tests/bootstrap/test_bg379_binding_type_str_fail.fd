// expect-error: binding 'v' of pattern Option::Some is written as str, but the payload is a i64
// Bugs roadmap BG379: a typed pattern binding was never checked against the
// payload: `Option::Some(v: str)` on an Option<i64> was typed i64 by the
// checker and lowered as a str (an empty line, or a fault on pe_ir).
fn main() {
    val o: Option<i64> = Option::Some(3);
    match o {
        Option::Some(v: str) => {
            println(v);
        }
        _ => {
            println("o");
        }
    }
}
