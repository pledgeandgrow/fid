// Bugs roadmap BG379: a typed binding must name the payload's type; the
// written types that do (a number, a str, a struct, a generic payload)
// still compile and run.
//
// Expected output:
// 3
// hi
// 7
// 2.5

struct P { x: i64 }

enum Shape {
    Dot(P),
    Round(f64),
}

fn main() {
    val o: Option<i64> = Option::Some(3);
    match o {
        Option::Some(v: i64) => {
            println(v);
        }
        _ => {
            println("none");
        }
    }
    val r: Result<str, i64> = Result::Ok("hi");
    match r {
        Result::Ok(s: str) => {
            println(s);
        }
        Result::Err(e: i64) => {
            println(e);
        }
    }
    val d = Shape::Dot(P { x: 7 });
    match d {
        Shape::Dot(p: P) => {
            println(p.x);
        }
        Shape::Round(f: f64) => {
            println(f);
        }
    }
    val c = Shape::Round(2.5);
    match c {
        Shape::Dot(p: P) => {
            println(p.x);
        }
        Shape::Round(f: f64) => {
            println(f);
        }
    }
}
