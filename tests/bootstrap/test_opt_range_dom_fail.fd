// OP24: expected to fail at run time (integer overflow). `p * p < n`
// bounds p at the top of the loop body, but the branch stores a huge value
// to p before the latch's `p = p + 1`: the fact of the body's entry must
// not reach that load (compiler/checks.fd peir_dom_killed: a store between
// the fact's block and the load). If it did, the add would lose its check
// and wrap instead of panicking.

fn main() {
    var n: i64 = 100;
    var p: i64 = 2;
    var t: i64 = 0;
    while p * p < n {
        if p == 7 {
            p = 9223372036854775807;
        }
        t = t + 1;
        p = p + 1;
    }
    println(t);
    print("unreachable\n");
}
