// expect-error: has 0 type parameter(s); the trait's method has 1
// LG4: an impl's method must have as many type parameters as the trait's
// generic method: a call through a bound `T: Chooser` binds U, and an impl
// fixed to i64 would be handed a string (typechecker.fd
// TypeChecker_check_impl_sig).
cap Chooser {
    fn choose<U>(self, a: U, b: U) -> U;
}

struct Pos { n: i64 }

impl Chooser for Pos {
    fn choose(self, a: i64, b: i64) -> i64 { return a; }
}

fn main() -> i64 {
    val p = Pos { n: 1 };
    println(p.choose(1, 2));
    return 0;
}
