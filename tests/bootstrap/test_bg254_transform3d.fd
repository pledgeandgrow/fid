// BG254 (docs/roadmap/bugs-roadmap.md): `use transform3d;` did not parse
// (the literal of math's lowercase `mat4` in tf3_to_mat4), so lidar and
// pointcloud did not build either. The three modules import, and
// tf3_to_mat4 builds the matrix it says.
//
// Expected output:
// true
// true
// true
// true
// true
use core;
use math;
use transform3d;
use lidar;
use pointcloud;

fn main() -> i64 {
    val m = tf3_to_mat4(tf3_identity());
    println(m.m00 == 1.0 && m.m11 == 1.0 && m.m22 == 1.0 && m.m33 == 1.0);
    println(m.m01 == 0.0 && m.m02 == 0.0 && m.m03 == 0.0 && m.m10 == 0.0 && m.m12 == 0.0 && m.m13 == 0.0 && m.m20 == 0.0 && m.m21 == 0.0 && m.m23 == 0.0 && m.m30 == 0.0 && m.m31 == 0.0 && m.m32 == 0.0);
    val n = tf3_to_mat4(tf3_translation(vec3(2.5, 0.0 - 1.0, 4.0)));
    println(n.m00 == 1.0 && n.m11 == 1.0 && n.m22 == 1.0 && n.m33 == 1.0 && n.m03 == 2.5 && n.m13 == 0.0 - 1.0 && n.m23 == 4.0 && n.m30 == 0.0 && n.m31 == 0.0 && n.m32 == 0.0);
    val back = tf3_from_mat4(n);
    println(back.trans.x == 2.5 && back.trans.y == 0.0 - 1.0 && back.trans.z == 4.0);
    // pointcloud is reached too
    var pts: Vec<vec3> = Vec::new();
    pts.push(vec3(1.0, 2.0, 3.0));
    pts.push(vec3(3.0, 2.0, 3.0));
    val c = pcl_centroid(&pts);
    println(c.x == 2.0 && c.y == 2.0 && c.z == 3.0);
    return 0;
}
