// Test (stdlib-agent bugs 13/26): only an exact type keyword is a type
// token. Words that start like one (`i8x`, `u16v`, `f64s`, `q4a`) are
// identifiers, and `q4` / `q8` (other spellings of i8, reference §1.4) are
// type names rather than reserved words: they name variables too, and
// still mean i8 in a type. (`f32`, `i64`, `str`, ... stay reserved; see
// test_fix_type_word_name_fail.fd.)
// Expected output:
// 10
// 5 9
// -128 127
fn widen(x: q8) -> i64 {
    return x as i64;
}

fn main() {
    val i8x: i64 = 1;
    val u16v: i64 = 2;
    val f64s: i64 = 3;
    val q4a: i64 = 4;
    println(int_to_str(i8x + u16v + f64s + q4a));
    val q4: i64 = 5;
    var q8: i64 = 8;
    q8 = q8 + 1;
    println(int_to_str(q4) + " " + int_to_str(q8));
    val lo: q4 = -128;
    val hi: q8 = 127;
    println(int_to_str(widen(lo)) + " " + int_to_str(widen(hi)));
}
