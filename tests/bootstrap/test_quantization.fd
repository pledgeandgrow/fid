// test_quantization.fd — ML10: Real Quantization
// Expected: PASS
// Tests ~> cast operator, quantize/dequantize, and @quantized annotation.

use tensor;
use quant;

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

@quantized
fn quantized_inference(w: Tensor, x: Tensor) -> Tensor {
    // Only use quantized ops — no dequantize_q8
    val result = qmatmul(x, w);
    return result;
}

fn main() {
    // Create a simple weight matrix
    val w = from_vec(vec1(1, 2, 3, 4), vec2(2, 2));
    val x = from_vec(vec1(1, 0, 0, 1), vec2(2, 2));

    // Find quantization parameters
    val params = find_quant_params(w);
    print(params);
    print("\n");

    // Quantize and dequantize to verify round-trip
    val scale = 0.1;
    val zp = 0;
    val w_q = quantize_q8(w, scale, zp);
    val w_dq = dequantize_q8(w_q, scale, zp);
    print(to_str(w_dq));
    print("\n");

    // Run quantized inference
    val result = quantized_inference(w, x);
    print(to_str(result));
    print("\n");

    return 0;
}

fn vec1(a: i64, b: i64, c: i64, d: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    v.push(d);
    return v;
}
