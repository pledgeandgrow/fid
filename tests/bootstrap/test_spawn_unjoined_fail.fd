// expect-error: is never awaited, joined or detached
// CA6: a task started by a bare `spawn f(x);` outside a `spawn scope { }`
// drops its handle: nothing waits for it, and it could outlive the function
// that started it. Rejected; the fix is to await the handle, start the task
// in a scope, or say `spawn detached f(x)` (test_spawn_detached.fd).

fn work(n: i64) -> i64 {
    return n * 2;
}

fn main() {
    spawn work(1);
    println(1);
}
