// Compiler-inserted string frees: every way a string can outlive the place it
// was built in must keep it alive (release roadmap C1, C2, M6).
struct Box {
    s: str,
}

fn keep(s: str) -> str {
    return s;
}

fn build(n: i64) -> str {
    var s = "";
    var i: i64 = 0;
    while i < n {
        s = s + int_to_str(i) + ",";
        i = i + 1;
    }
    return s;
}

fn first_of(a: str, b: str) -> str {
    var t = a + b;
    t = t + "!";
    return t + "?";
}

fn main() -> i64 {
    // Built in a loop, and returned
    println(build(5));
    println(first_of("x", "y"));

    // Read by every call the pass knows
    var r = "abc" + "def";
    print(str_len(r)); print(" ");
    print(str_byte_at(r, 1)); print(" ");
    print(str_equal(r, "abcdef")); print(" ");
    print(str_contains(r, "cd")); print(" ");
    print(str_find(r, "e")); print("\n");

    // Copied to another variable, then the first is overwritten
    var a = "x" + "y";
    var b = a;
    a = a + "z";
    println(b);
    println(a);

    // Stored in a field
    var f = "p" + "q";
    val box = Box { s: f };
    f = "r" + "s";
    println(box.s);
    println(f);

    // Pushed to a Vec
    var v: Vec<str> = Vec::new();
    var e = "e" + "1";
    v.push(e);
    e = "e" + "2";
    var got: str = v.get(0);
    println(got);
    println(e);

    // Through a function that hands it back
    var k = "k" + "1";
    var k2 = keep(k);
    k = "k" + "2";
    println(k2);
    println(k);

    // Captured by a closure
    var c = "c" + "1";
    val g = fn(n: i64) { str_len(c) + n };
    c = "c" + "22";
    print(g(1)); print("\n");

    // Reassigned on one branch only, and to a literal
    var m = "m" + "1";
    if str_len(m) == 2 { m = "literal"; }
    println(m);
    m = m + "2";
    println(m);

    // A temporary read twice is not a temporary
    var i: i64 = 0;
    while i < 3 {
        val t = "t" + int_to_str(i);
        if str_equal(t, "t1") { println(t); }
        i = i + 1;
    }
    return 0;
}
