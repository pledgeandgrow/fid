// LF13 (llvm roadmap): a local Vec made by `Vec::filled(n, x)` (core's
// Vec_init_filled, when core has it) or by `Vec::new()` of a narrow element
// type (Vec_new_sized) keeps its 40-byte header on the stack while it never
// leaves its function (lower.fd lw_rc_stack_vecs_fn). The results must be
// those of a heap header: in a loop the header is filled again each time,
// strings in a filled Vec are each their own copy, a Vec that is returned
// or kept in a struct stays on the heap.
//
// Expected output:
//     dp 89
//     row 0 sum 0
//     row 1 sum 4
//     row 2 sum 8
//     bytes 3 104 105 33
//     words x x y
//     kept 4 7
//     made 5 2
//     flags 2
//     done

struct Keep {
    v: Vec<i64>,
}

fn fib_dp(n: i64) -> i64 {
    var dp: Vec<i64> = Vec::filled(n + 1, 0);
    dp.set(0, 1);
    dp.set(1, 1);
    var i: i64 = 2;
    while i <= n {
        dp.set(i, dp.get(i - 1) + dp.get(i - 2));
        i = i + 1;
    }
    return dp.get(n);
}

fn row_sums() {
    var r: i64 = 0;
    while r < 3 {
        var row: Vec<i64> = Vec::filled(4, r);
        var s: i64 = 0;
        var j: i64 = 0;
        while j < row.len() {
            s = s + row.get(j);
            j = j + 1;
        }
        println("row " + int_to_str(r) + " sum " + int_to_str(s));
        r = r + 1;
    }
}

fn bytes() {
    var b: Vec<u8> = Vec::new();
    b.push(104 as u8);
    b.push(105 as u8);
    b.push(33 as u8);
    println("bytes " + int_to_str(b.len()) + " " + int_to_str(b.get(0) as i64) + " " + int_to_str(b.get(1) as i64) + " " + int_to_str(b.get(2) as i64));
}

fn words() {
    var w: Vec<str> = Vec::filled(3, "x");
    w.set(2, "y");
    println("words " + w.get(0) + " " + w.get(1) + " " + w.get(2));
}

// kept in a struct: the header stays on the heap
fn keep() -> Keep {
    var v: Vec<i64> = Vec::filled(4, 7);
    return Keep { v: v };
}

// returned: the header stays on the heap
fn make() -> Vec<i64> {
    var v: Vec<i64> = Vec::filled(5, 2);
    return v;
}

fn flags() -> i64 {
    var f: Vec<bool> = Vec::filled(4, false);
    f.set(1, true);
    f.set(3, true);
    var n: i64 = 0;
    var i: i64 = 0;
    while i < f.len() {
        if f.get(i) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn main() {
    println("dp " + int_to_str(fib_dp(10)));
    row_sums();
    bytes();
    words();
    var k: Keep = keep();
    println("kept " + int_to_str(k.v.len()) + " " + int_to_str(k.v.get(3)));
    var m: Vec<i64> = make();
    println("made " + int_to_str(m.len()) + " " + int_to_str(m.get(4)));
    println("flags " + int_to_str(flags()));
    println("done");
}
