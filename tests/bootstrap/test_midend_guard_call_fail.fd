// OP25 (compiler/iropt_me.fd ime_guard_moves, `licmguard` with `guardcall`):
// expected to fail at run time (division by zero), after printing "0" and
// "start". The first call runs the loop no time, so the guarded call to
// `tri_div` (no effect but a panic) is not made; the second runs it, and
// the call, moved out of the loop under the guard, panics where the
// loop's first pass would have: after "start", never before it.

fn tri_div(m: i64, k: i64) -> i64 {
    var s: i64 = 0;
    var j: i64 = 0;
    while j < m {
        s = s + j;
        j = j + 1;
    }
    return s / k;
}

fn run(n: i64, m: i64, k: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        acc = acc + tri_div(m, k);
        i = i + 1;
    }
    return acc;
}

fn main() {
    println(run(0, 4, 0));
    print("start\n");
    println(run(2, 4, 0));
    print("unreachable\n");
}
