// Earlier miscompile "known-bugs 1.19": statements were silently dropped in
// long functions (calls vanished from the generated C of a long function).
// One function of 300 statements, each of which changes the result: a
// dropped statement changes the printed sum or the count of calls.
// (Generated: statement i adds i to `s` and calls `tick`.)
//
// Expected output:
// 45150
// 300

fn tick(c: &mut Vec<i64>) {
    c.push(1);
}

