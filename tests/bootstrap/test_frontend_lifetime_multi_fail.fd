// expect-error: cannot mutate y: shared borrow(s) are active
// LG3: `pick` ties its result to both arguments, so `m` borrows `x` and
// `y`. Before, only the first tied argument was recorded and changing `y`
// while `m` was live went unnoticed.
fn pick<'a>(x: &'a i64, y: &'a i64) -> &'a i64 {
    if *x > *y {
        return x;
    }
    return y;
}

fn main() -> i64 {
    var x: i64 = 1;
    var y: i64 = 3;
    val m = pick(&x, &y);
    y = 0;
    println(*m);
    return 0;
}
