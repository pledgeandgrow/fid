// A library that is there but lacks a function the program calls (release
// E4). The native program prints "main ran", and the call stops it with,
// on stderr:
//
//   error: shlwapi.dll has no function FidesNoSuchFunction (another version of the library?)
//
// and exit code 1. `fid ccompile` fails at link time. Expected to fail on
// every backend.
extern "C" link "shlwapi" {
    fn FidesNoSuchFunction as no_such_fn(x: i64) -> i64;
}

@unsafe
fn main() -> i64 {
    println("main ran");
    println(no_such_fn(1));
    return 0;
}
