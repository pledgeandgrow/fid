// Roadmap Phase 12 (rm-P12): data-flow taint tracking in fid. A @tainted
// parameter may be used freely as long as its value reaches no sink before
// a sanitizer: here it is sanitized before printing, only its length (via
// a @sanitizer) decides a branch, and untainted values are printed. The
// old coarse rule (a @tainted parameter forbids any IO in the function)
// rejected all of this.
// Expected output:
//   hello [ALICE]
//   user input 5 bytes
//   long
//   7

@sanitizer
fn clean(s: str) -> str {
    return "[" + str_to_upper(s) + "]";
}

@sanitizer
fn byte_count(s: str) -> i64 {
    return str_len(s);
}

fn twice(n: i64) -> i64 {
    return n * 2;
}

fn greet(@tainted name: str) {
    val safe: str = clean(name);
    var msg: str = "hello ";
    msg = msg + safe;
    println(msg);
    val n: i64 = byte_count(name);
    println("user input " + int_to_str(n) + " bytes");
    if byte_count(name) > 3 {
        println("long");
    }
    val k: i64 = 7;
    println(int_to_str(k));
}

fn main() {
    greet("alice");
}
