// Test: region with budget (F3)
// Allocations under the budget should compile fine.

fn main() {
    // 4 i64 variables = 32 bytes, budget = 64 → OK
    region r with budget(64) {
        val a: i64 = 1;
        val b: i64 = 2;
        val c: i64 = 3;
        val d: i64 = 4;
        print(f"sum={a + b + c + d}");
        print("\n");
    }
    return 0;
}
