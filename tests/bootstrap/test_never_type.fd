// L8K: Never type — divergent functions with `-> !` return type
// A function returning `!` never returns (panics, infinite loops, etc.).
// The never type coerces to any type, so calls to divergent functions
// can be used in any context.

// A divergent function that panics
fn fail(msg: str) -> ! {
    print("FATAL: ");
    print(msg);
    // Use the runtime panic
    p_panic(msg);
}

// A divergent function can be called where any type is expected
fn guarded_div(x: i64, y: i64) -> i64 {
    if y == 0 {
        // fail() returns !, which coerces to i64
        fail("division by zero");
    }
    return x / y;
}

fn main() {
    val result = guarded_div(10, 2);
    print(result);

    // This would panic:
    // val bad = guarded_div(10, 0);
    // print(bad);
}
