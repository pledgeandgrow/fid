// Bugs roadmap BG30: `+=` on a string that is not an owned local (a
// global, a struct field, a Vec element) lowered to a BinOp that added
// the two pointers. It is a concatenation now, as `a + b` is; the place
// keeps the new string and drops the old one. A match arm's string
// binding the arm assigns is a variable of its own (the assignment to the
// binding was lost); the scrutinee keeps its string.
// Expected output:
// g!2
// pat!pat!
// abc bc
// g!2...
// 4
// hi1?
// hi1
// hi1!!
var G: str = "g";

struct P {
    name: str,
    n: i64,
}

enum Msg {
    Text(str),
    Num(i64),
}

fn grow(p: &mut P) {
    p.name += "!";
    p.n += 1;
}

fn main() -> i64 {
    G += "!";
    G += int_to_str(2);
    println(G);
    var p: P = P { name: "pat", n: 3 };
    grow(&mut p);
    p.name += p.name;
    println(p.name);
    var v: Vec<str> = Vec::new();
    v.push("a");
    v.push("b");
    v[1] += "c";
    v[0] += v[1];
    println(v[0] + " " + v[1]);
    var i: i64 = 0;
    while i < 3 {
        G += ".";
        i = i + 1;
    }
    println(G);
    println(int_to_str(p.n));
    val m: Msg = Msg::Text("hi" + int_to_str(1));
    match m {
        Msg::Text(t) => {
            t += "?";
            println(t);
        }
        Msg::Num(_) => {
        }
    }
    match m {
        Msg::Text(t2) => {
            println(t2);
        }
        Msg::Num(_) => {
        }
    }
    val r: str = match m {
        Msg::Text(t3) => {
            t3 += "!";
            t3 += "!";
            t3
        }
        Msg::Num(_) => {
            "none"
        }
    };
    println(r);
    return 0;
}
