// expect-error: Comptime error (line 7): 'println()' does I/O
//! error: Comptime error (line 7): 'println()' does I/O
// TL2: a test per diagnostic of the type, borrow and escape checks.
// Comptime code runs inside the compiler and may only compute.

comptime fn greet() -> i64 {
    println("hello"); // <- here
    return 1;
}

fn main() -> i64 {
    val x = comptime greet();
    println(x);
    return 0;
}
