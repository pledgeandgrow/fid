// Regression test: collection printing (vec, map)
// Tests that print/println correctly format Vec and HashMap

fn main() -> i64 {
    val v = Vec::new();
    v.push(42);
    print(v);                   // [42]

    val m = HashMap::new();
    m.insert("alice", 30);
    m.insert("bob", 25);
    print(m);                   // {alice: 30, bob: 25}

    return 0;
}
