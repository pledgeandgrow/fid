// Bugs roadmap BG438: the machine-layer runtime's `p_os_random_u64`
// (stdlib/linux_runtime/base.fd pert_os_random_u64) ignored a failed
// getrandom and returned the leftover bytes of a fresh heap block. It now
// reads until it has 8 bytes (EINTR, short reads) and panics "no random
// source in the operating system" as the C runtime and pe_ir do. This test
// only checks the working path: draws still differ and nothing panics.
//
// Expected output:
// distinct 64

fn main() {
    var seen: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 64 {
        seen.push(p_os_random_u64());
        i = i + 1;
    }
    var distinct: i64 = 0;
    var a: i64 = 0;
    while a < 64 {
        var dup: bool = false;
        var b: i64 = 0;
        while b < a {
            if seen.get(a) == seen.get(b) {
                dup = true;
            }
            b = b + 1;
        }
        if !dup {
            distinct = distinct + 1;
        }
        a = a + 1;
    }
    println(f"distinct {distinct}");
}
