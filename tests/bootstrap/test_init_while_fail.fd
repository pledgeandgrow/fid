// expect-error: Init error: variable 'y' is used before being assigned a value.
// Bugs roadmap BG20: an assignment inside a `while` body counted as done
// after the loop, though the body may run zero times (here it does).
fn main() -> i64 {
    var n: i64 = 0;
    var y: i64;
    while n > 0 {
        y = n;
        n = n - 1;
    }
    println(int_to_str(y));
    return 0;
}
