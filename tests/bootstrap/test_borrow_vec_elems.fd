// known-bugs 2g.73: `swap(&mut v[0], &mut v[1])` borrows two elements of one
// Vec in one call. The indices are distinct constants, so the borrows do not
// overlap and the call is accepted (it was rejected: "a mutable borrow is
// already reserved"). Both still borrow the Vec, so a push or `&mut v[i]`
// with an unknown i in the same call is rejected (the _fail tests).
// Expected output:
// 3 2 1
// 10 30 20
// 7 5
struct Pair {
    xs: Vec<i64>,
}

fn swap(a: &mut i64, b: &mut i64) {
    var t: i64 = *a;
    *a = *b;
    *b = t;
}

fn add_to(a: &mut i64, b: &mut i64, n: i64) {
    *a = *a + n;
    *b = *b + n;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    swap(&mut v[0], &mut v[2]);
    println(int_to_str(v[0]) + " " + int_to_str(v[1]) + " " + int_to_str(v[2]));
    var p: Pair = Pair { xs: Vec::new() };
    p.xs.push(10);
    p.xs.push(20);
    p.xs.push(30);
    swap(&mut p.xs[1], &mut p.xs[2]);
    println(int_to_str(p.xs[0]) + " " + int_to_str(p.xs[1]) + " " + int_to_str(p.xs[2]));
    var w: Vec<i64> = Vec::new();
    w.push(5);
    w.push(3);
    add_to(&mut w[1], &mut w[0], 2);
    println(int_to_str(w[0]) + " " + int_to_str(w[1]));
}
