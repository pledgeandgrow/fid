// PL3 (competitive-roadmap): `@cfg(freebsd)`, `@cfg(unix)` and
// `@cfg(wasi)` are known conditions (compiler.fd cfg_os_cond, check_cfg):
// `unix` holds on Linux, macOS and FreeBSD, `freebsd` only on FreeBSD
// (the target of `fid ccompile --target x86_64-freebsd`, or a FreeBSD
// host). Before, an unknown condition held everywhere: on Windows the
// `freebsd` and `unix` variants below (written last) were kept beside the
// Windows ones and won, so `os_tag()` was "freebsd" and `is_unix()` true.
// The check uses a fact @cfg cannot change: Windows sets OS=Windows_NT.
// (fidesc, frozen, does not know these conditions: fid only.)
// Expected output:
// os: ok
// unix: ok
// freebsd: ok

@cfg(linux)
fn os_tag() -> str {
    return "linux";
}

@cfg(windows)
fn os_tag() -> str {
    return "windows";
}

@cfg(macos)
fn os_tag() -> str {
    return "macos";
}

@cfg(wasi)
fn os_tag() -> str {
    return "wasi";
}

@cfg(freebsd)
fn os_tag() -> str {
    return "freebsd";
}

@cfg(windows)
fn is_unix() -> bool {
    return false;
}

@cfg(wasi)
fn is_unix() -> bool {
    return false;
}

@cfg(unix)
fn is_unix() -> bool {
    return true;
}

@cfg(linux)
fn freebsd_mark() -> i64 {
    return 0;
}

@cfg(windows)
fn freebsd_mark() -> i64 {
    return 0;
}

@cfg(macos)
fn freebsd_mark() -> i64 {
    return 0;
}

@cfg(wasi)
fn freebsd_mark() -> i64 {
    return 0;
}

@cfg(os = "freebsd")
fn freebsd_mark() -> i64 {
    return 1;
}

fn on_windows() -> bool {
    match env_var("OS") {
        Option::Some(v) => {
            return v == "Windows_NT";
        }
        Option::None => {
            return false;
        }
    }
    return false;
}

fn main() {
    val os: str = os_tag();
    val win: bool = on_windows();
    if os == "wasi" || (os == "windows") == win {
        println("os: ok");
    } else {
        println("os: wrong (" + os + ")");
    }
    if os == "wasi" || is_unix() == !win {
        println("unix: ok");
    } else {
        println("unix: wrong");
    }
    if (freebsd_mark() == 1) == (os == "freebsd") {
        println("freebsd: ok");
    } else {
        println("freebsd: wrong");
    }
}
