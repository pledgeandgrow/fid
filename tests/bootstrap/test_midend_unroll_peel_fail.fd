// OP11 (compiler/iropt_me.fd ime_unroll_one, pass `unroll`, on by default
// on the native paths since Nov 17): expected to fail at run time
// (division by zero at i = 9), after printing 0 to 9. The loop has 13
// trips, a constant: 1 is peeled in front of the header, then groups of 4
// copies of the body per test (i = 1..4, 5..8, 9..12). The panic must come
// where the plain loop has it, in the first copy of the third group: after
// the line 9, never before it, and "unreachable" is never printed
// (tests/tooling/unroll-check.sh compares the output with unroll on and
// off).

fn main() {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 13 {
        println(i);
        t = t + 100 / (9 - i);
        i = i + 1;
    }
    println(t);
    println("unreachable");
}
