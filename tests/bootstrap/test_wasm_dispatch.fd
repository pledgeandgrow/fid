// Test: function values, closures and trait objects through the
// WebAssembly backend (release F9): calls through the module's table.

cap Animal {
    fn legs(self) -> i64;
}

struct Dog { age: i64 }
struct Spider { venom: i64 }

impl Animal for Dog {
    pub fn legs(self: Dog) -> i64 { return 4; }
}

impl Animal for Spider {
    pub fn legs(self: Spider) -> i64 { return 8 + self.venom; }
}

fn count(a: dyn Animal) -> i64 {
    return a.legs();
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

fn double(x: i64) -> i64 {
    return x * 2;
}

fn make_adder(n: i64) -> fn(i64) -> i64 {
    return fn(x: i64) { x + n };
}

fn fib(n: i64) -> i64 {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn main() {
    print(apply(double, 21));
    print("\n");
    val add5 = make_adder(5);
    print(add5(10));
    print("\n");
    print(count(Dog { age: 3 }));
    print(" ");
    print(count(Spider { venom: 1 }));
    print("\n");
    print(fib(20));
    print("\n");
}
