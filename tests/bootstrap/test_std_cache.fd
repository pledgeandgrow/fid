// stdlib/cache: LRU eviction order and recency, the LeetCode 146/460 reference sequences for LRU and LFU, LFU tie-breaking by recency, TTL expiry with injected time (sweep before evict), slot reuse, and hit/miss stats.
// Expected output:
// lru 146: 1 -1 -1 3 4
// lru order: 4,3
// lru stats: hits=3 misses=2 evictions=2 expired=0 ratio=60%
// evicted: b then c
// replace keeps size: 3 peek a=A2 order a,e,d
// remove d: true again false len 2
// slot reused: slots 3 order f,a,e
// lfu 460: 1 -1 3 -1 3 4
// lfu counts: 3=3 4=2 1=0
// lfu stats: hits=4 misses=2 evictions=2 expired=0 ratio=66%
// lfu evicts least used: y, then the only count-1 entry: w
// at 1050: s1=alice left 50
// at 1100: s1=-1 s2=bob
// full put at 1200 evicted: [s2] len 2
// s4 at 1250: dave, s2: -1
// sweep at 1360: 1 left 1 s3=carol2
// sweep before evict: evicted [] b=2 c=3
// ttl stats: hits=4 misses=2 evictions=1 expired=2 ratio=66%
use cache;
use vec;
use string;

fn g(v: str) -> str {
    if str_len(v) == 0 { return "-1"; }
    return v;
}

fn main() -> i64 {
    // LeetCode 146 example: capacity 2
    var c: LruCache = lru_new(2);
    lru_put(& mut c, "1", "1");
    lru_put(& mut c, "2", "2");
    var line: str = g(lru_get(& mut c, "1"));
    lru_put(& mut c, "3", "3");             // evicts 2
    line = line + " " + g(lru_get(& mut c, "2"));
    lru_put(& mut c, "4", "4");             // evicts 1
    line = line + " " + g(lru_get(& mut c, "1")) + " " + g(lru_get(& mut c, "3")) + " " + g(lru_get(& mut c, "4"));
    println("lru 146: " + line);
    println("lru order: " + str_join(lru_keys(& c), ","));
    println("lru stats: " + cache_stats_str(& c.stats));

    var l: LruCache = lru_new(3);
    lru_put(& mut l, "a", "A");
    lru_put(& mut l, "b", "B");
    lru_put(& mut l, "c", "C");
    lru_get(& mut l, "a");
    println("evicted: " + lru_put(& mut l, "d", "D") + " then " + lru_put(& mut l, "e", "E"));
    lru_put(& mut l, "a", "A2");
    println("replace keeps size: " + int_to_str(lru_len(& l)) + " peek a=" + lru_peek(& l, "a") + " order " + str_join(lru_keys(& l), ","));
    println("remove d: " + bool_to_str(lru_remove(& mut l, "d")) + " again " + bool_to_str(lru_remove(& mut l, "d")) + " len " + int_to_str(lru_len(& l)));
    lru_put(& mut l, "f", "F");
    println("slot reused: slots " + int_to_str(l.keys.len()) + " order " + str_join(lru_keys(& l), ","));

    // LeetCode 460 example: capacity 2
    var f: LfuCache = lfu_new(2);
    lfu_put(& mut f, "1", "1");
    lfu_put(& mut f, "2", "2");
    var out: str = g(lfu_get(& mut f, "1"));
    lfu_put(& mut f, "3", "3");             // evicts 2 (count 1)
    out = out + " " + g(lfu_get(& mut f, "2")) + " " + g(lfu_get(& mut f, "3"));
    lfu_put(& mut f, "4", "4");             // 1 and 3 have count 2: 1 is older
    out = out + " " + g(lfu_get(& mut f, "1")) + " " + g(lfu_get(& mut f, "3")) + " " + g(lfu_get(& mut f, "4"));
    println("lfu 460: " + out);
    println("lfu counts: 3=" + int_to_str(lfu_count(& f, "3")) + " 4=" + int_to_str(lfu_count(& f, "4")) + " 1=" + int_to_str(lfu_count(& f, "1")));
    println("lfu stats: " + cache_stats_str(& f.stats));

    var h: LfuCache = lfu_new(3);
    lfu_put(& mut h, "x", "1");
    lfu_put(& mut h, "y", "2");
    lfu_put(& mut h, "z", "3");
    lfu_get(& mut h, "x");
    lfu_get(& mut h, "x");
    lfu_get(& mut h, "z");
    println("lfu evicts least used: " + lfu_put(& mut h, "w", "4") + ", then the only count-1 entry: " + lfu_put(& mut h, "v", "5"));

    // TTL: lifetime 100 time units, capacity 2
    var t: TtlCache = ttl_new(2, 100);
    ttl_put(& mut t, "s1", "alice", 1000);
    ttl_put_for(& mut t, "s2", "bob", 1000, 500);
    println("at 1050: s1=" + g(ttl_get(& mut t, "s1", 1050)) + " left " + int_to_str(ttl_remaining(& t, "s1", 1050)));
    println("at 1100: s1=" + g(ttl_get(& mut t, "s1", 1100)) + " s2=" + g(ttl_get(& mut t, "s2", 1100)));
    ttl_put(& mut t, "s3", "carol", 1200);
    println("full put at 1200 evicted: [" + ttl_put(& mut t, "s4", "dave", 1200) + "] len " + int_to_str(ttl_len(& t)));
    println("s4 at 1250: " + g(ttl_get(& mut t, "s4", 1250)) + ", s2: " + g(ttl_get(& mut t, "s2", 1250)));
    ttl_put(& mut t, "s3", "carol2", 1290);  // a write refreshes the lifetime
    println("sweep at 1360: " + int_to_str(ttl_sweep(& mut t, 1360)) + " left " + int_to_str(ttl_len(& t)) + " s3=" + g(ttl_get(& mut t, "s3", 1360)));
    var t2: TtlCache = ttl_new(2, 1000);
    ttl_put(& mut t2, "a", "1", 0);
    ttl_put(& mut t2, "b", "2", 0);
    ttl_put_for(& mut t2, "a", "1", 0, 10);
    println("sweep before evict: evicted [" + ttl_put(& mut t2, "c", "3", 50) + "] b=" + g(ttl_get(& mut t2, "b", 50)) + " c=" + g(ttl_get(& mut t2, "c", 50)));
    println("ttl stats: " + cache_stats_str(& t.stats));
    return 0;
}
