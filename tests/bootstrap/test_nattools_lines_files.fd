// llvm-roadmap DB1: every instruction has a line and a file, including
// those of the files a program does not name. On the native Linux targets
// (and --nat Windows with DWARF) the .debug_line rows of
//   - a core function (str_trim_start, stdlib/core.fd) are against core.fd
//     (compiler.fd records the library's functions as it parses it, and
//     the binary artifact keeps the records: ir.fd ir_note_lib_program,
//     ir_lib_file_pairs),
//   - the instance lgf_count__i64 of a generic of nattools/lines_files_mod.fd
//     are against that file (ir.fd ir_fn_src_file),
//   - the code of lgf_add1 inlined into main are against
//     lines_files_mod.fd at lgf_add1's line, inside main's rows (ir.fd
//     ir_copy_value_file; nat_ir.fd ng_note_line, MO_LINE's file).
// The output is the same on every backend; the native check is
//   python3 tests/nattools/dbg_db1_files_check.py --fid $FID
// (decodes .debug_line itself; no readelf needed).
// Expected output:
// 6
// 7
// 22
// hi

use nattools::lines_files_mod;

fn main() {
    val t: i64 = lgf_count(7, 4);
    print(t);
    print("\n");
    print(lgf_add1(t));
    print("\n");
    print(str_trim_start("  hi"));
    print("\n");
}
