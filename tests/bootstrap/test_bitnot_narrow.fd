// `~x` on u8/u16/u32 keeps the declared width inside an expression (M12:
// it gave the 64-bit complement, -4 for ~3u8). Expected output:
// 252
// 249
// 1
// 65534
// 4294967295
// 252

fn main() -> i64 {
    var a: u8 = 3;
    var n: u8 = ~a;
    println(n);
    var d: u8 = n - a;
    println(d);
    if ~a > 200 { println(1); } else { println(0); }
    var w: u16 = 1;
    var nw: u16 = ~w;
    println(nw);
    var x: u32 = 0;
    var nx: u32 = ~x;
    println(nx);
    println((~a) as i64);
    return 0;
}
