// expect-error: cannot assign *mut i64 to variable 'lo' of type u16
// Bugs roadmap BG80: a raw pointer given where a narrow integer is wanted
// was accepted and cut to 16 bits.
fn main() -> i64 {
    unsafe {
        val p: *mut i64 = p_malloc(8);
        val lo: u16 = p;
        println(int_to_str(lo as i64));
        p_free(p);
    }
    return 0;
}
