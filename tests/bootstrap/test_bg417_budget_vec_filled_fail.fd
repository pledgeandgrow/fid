// expect-error: allocates on the heap: 'Vec_filled()'
// Bugs roadmap BG417: `Vec::filled(100000, 0)` allocates 800 KB, yet a
// region of budget(64) allowed it (the call "Vec_filled" was in no list of
// allocating builtins).
fn main() -> i64 {
    region r with budget(64) {
        val v = Vec::filled(100000, 0);
        println(v.len());
    }
    return 0;
}
