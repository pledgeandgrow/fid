// expect-error: Partition error: 'schedule' hands 'state' by reference to partition 'navigation' (entry 'nav_step') and to partition 'flight_control' (entry 'ctrl_step')
// Roadmap Phase 9 (F47): a pointer the scheduler holds (`state`, a
// `&mut` parameter) passed on to two partitions is memory they share,
// even though neither call takes a reference itself.

struct Shared {
    pitch: i64,
}

@partitioned(navigation)
fn nav_step(s: & mut Shared) {
    s.pitch = s.pitch + 5;
}

@partitioned(flight_control)
fn ctrl_step(s: & mut Shared) -> i64 {
    s.pitch = s.pitch * 2;
    return s.pitch;
}

fn schedule(state: & mut Shared) -> i64 {
    nav_step(state);
    return ctrl_step(state);
}

fn main() {
    var s: Shared = Shared { pitch: 1 };
    println(int_to_str(schedule(& mut s)));
}
