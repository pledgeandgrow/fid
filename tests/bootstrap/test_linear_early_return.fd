// A @linear value consumed on every path, early returns included, is
// accepted (reference section 8.7; the negative case is
// test_linear_early_return_fail.fd). A `return` in a closure leaves the
// closure only: it does not ask for the enclosing function's linear values.
// Expected output:
// 30
// 7
// 40
// 3
@linear
struct Tx { id: i64, amount: i64 }

fn commit(t: Tx) -> i64 { return t.amount; }

fn settle(t: Tx, rush: bool) -> i64 {
    if rush {
        return commit(t) + 10;
    }
    return commit(t);
}

fn first_or_second(v: Vec<i64>, t: Tx) -> i64 {
    if v.len() == 0 {
        return commit(t);
    } else if v.get(0) > 5 {
        val early: i64 = commit(t);
        return early - early + v.get(0);
    }
    val got: i64 = commit(t);
    return got - got + v.get(1);
}

fn main() -> i64 {
    val a: Tx = Tx { id: 1, amount: 30 };
    if a.id == 2 {
        return commit(a);
    }
    println(int_to_str(settle(a, false)));
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(7);
    println(int_to_str(first_or_second(v, Tx { id: 2, amount: 0 })));
    val b: Tx = Tx { id: 3, amount: 30 };
    val pick = fn(x: i64) -> i64 {
        val y: i64 = x - 6;
        return y;
    };
    println(int_to_str(settle(b, true)));
    println(int_to_str(pick(9)));
    return 0;
}
