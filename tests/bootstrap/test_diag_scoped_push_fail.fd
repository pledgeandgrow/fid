// expect-error: a @scoped value (View) cannot be stored in a Vec
// Expected to FAIL (CE4): a @scoped struct's strings are freed when its
// scope ends, so it may not be kept in a Vec, which outlives the scope.
@scoped
struct View {
    text: str,
}

fn main() -> i64 {
    var keep: Vec<View> = Vec::new();
    val v: View = View { text: "a" };
    keep.push(v);
    println(keep.len());
    return 0;
}
