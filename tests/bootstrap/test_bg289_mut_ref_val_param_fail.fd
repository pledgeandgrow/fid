// expect-error: cannot assign to 'x' through `&mut x`: it is declared with `val`
// Bugs roadmap BG289: the same through a `&mut` parameter; before, this
// printed 105.
fn bump(p: &mut i64) {
    *p = *p + 100;
}

fn main() -> i64 {
    val x = 5;
    bump(&mut x);
    println(x);
    return 0;
}
