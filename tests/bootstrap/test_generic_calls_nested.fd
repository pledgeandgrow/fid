// Test (known-bugs 2g.8): a generic call inside a closure, an f-string,
// a pipe, sandbox, txn and region is given its instance's name like any
// other (they ran "Unknown function" or called the unmangled name).
//
// Expected output:
// closure 6
// fstring 8
// pipe 10
// sandbox 12
// txn 14
// region 16
fn twice<T>(x: T, f: fn(T) -> T) -> T { return f(f(x)); }
fn inc<T>(x: T) -> T { return x; }
fn double<T>(x: T) -> T { return x; }

fn add1(x: i64) -> i64 { return x + 1; }

fn main() -> i64 {
    val c = fn(v: i64) -> i64 { return inc(v) * 2; };
    println("closure " + int_to_str(c(3)));
    println(f"fstring {inc(8)}");
    val p = 10 |> inc;
    println("pipe " + int_to_str(p));
    sandbox {
        val s = inc(12);
        if s == 12 { val t = 0; }
    }
    println("sandbox " + int_to_str(double(12)));
    var n: i64 = 0;
    txn { n = inc(14); }
    println("txn " + int_to_str(n));
    var m: i64 = 0;
    region r { m = double(16); }
    println("region " + int_to_str(m));
    return 0;
}
