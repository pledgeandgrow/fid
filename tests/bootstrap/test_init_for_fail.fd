// expect-error: Init error: variable 'last' is used before being assigned a value.
// Bugs roadmap BG20: an assignment inside a `for` body counted as done
// after the loop, though an empty Vec runs it zero times.
fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    var last: i64;
    for x in v {
        last = x;
    }
    println(int_to_str(last));
    return 0;
}
