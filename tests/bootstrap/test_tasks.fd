// Tasks: every result arrives, on every backend.
use task;

fn worker(n: i64) -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < 3 {
        total = total + n;
        task_yield();
        i = i + 1;
    }
    return total;
}

fn main() -> i64 {
    var ids: Vec<i64> = Vec::new();
    var i: i64 = 1;
    while i <= 10000 {
        ids.push(task_go("worker", i));
        i = i + 1;
    }
    task_run();
    var sum: i64 = 0;
    i = 0;
    while i < ids.len() {
        sum = sum + task_result(ids.get(i));
        i = i + 1;
    }
    println(sum);
    println(task_done(ids.get(0)));
    return 0;
}
