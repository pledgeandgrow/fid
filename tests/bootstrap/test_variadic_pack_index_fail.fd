// expect-error: the pack 'xs' (`...xs: T`) has no single type
// L8E: the elements of a pack (`...xs: T`, T typing nothing else) have
// types of their own, so a pack is read with a constant index only:
// xs.get(K) for a literal K, xs.len(), or `for x in xs`, or passed on
// whole to a variadic function. An index known only at run time would not
// have one type (mono.fd mono_pack_misuse).

fn pick<T>(i: i64, ...xs: T) -> i64 {
    return xs.get(i);
}

fn main() -> i64 {
    println(int_to_str(pick(0, 1, 2)));
    return 0;
}
