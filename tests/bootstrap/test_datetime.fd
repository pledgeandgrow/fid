use datetime;
use time;

fn main() -> i64 {
    // ── ISO 8601 parse ──
    var (ok, ts) = dt_parse("2026-10-27T14:30:00Z");
    print(ok);
    print("|");
    var t = time_from_timestamp(ts);
    print(dt_to_iso(t));
    print("|");

    // variants
    var (ok2, ts2) = dt_parse("2026-10-27");
    print(ok2);
    print(time_to_iso(time_from_timestamp(ts2)));
    print("|");

    var (ok3, ts3) = dt_parse("2026-10-27T14:30:00+02:00");
    print(ok3);
    print(dt_to_iso(time_from_timestamp(ts3)));   // shifted back 2h
    print("|");

    var (ok4, ts4) = dt_parse("2026-10-27 14:30:00-05:30");
    print(ok4);
    print(dt_to_iso(time_from_timestamp(ts4)));
    print("|");

    // invalid inputs
    print(dt_is_valid("2026-13-01"));             // month 13
    print(dt_is_valid("2026-02-30"));             // Feb 30
    print(dt_is_valid("2024-02-29"));             // leap ok
    print(dt_is_valid("garbage"));
    print("|");

    // ── formatting ──
    print(dt_format(t, "%Y-%m-%d %H:%M:%S"));
    print("|");
    print(dt_format(t, "%F %T"));
    print("|");
    print(dt_format(t, "%A, %B %e, %Y"));
    print("|");
    print(dt_format(t, "%a %b %d - %j day"));
    print("|");
    print(dt_format(t, "%I:%M %p"));
    print("|");
    print(dt_format(t, "%D"));
    print("|");
    print(dt_to_rfc2822(t));
    print("|");

    // ── duration ──
    var (dok, dsec) = dur_parse("1h30m");
    print(dok);
    print(dsec);
    print("|");
    var (dok2, dsec2) = dur_parse("2d3h");
    print(dsec2);
    print("|");
    print(dur_format(dur_parse_or_zero("1w2d3h4m5s")));
    print("|");
    var later = dt_add(t, dur_parse_or_zero("2h15m"));
    print(dt_to_iso(later));
    print("|");
    print(dur_format_hms(dur_seconds(3661)));
    print(dur_format(dur_seconds(0 - 5400)));
    print("|");
    print(dur_to_seconds(dt_diff(later, t)));
    print("\n");
    return 0;
}
