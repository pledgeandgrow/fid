// Bugs roadmap BG99: `parallel { | x = f(..) }` with a string x stored the
// task's result into x's slot and left x's old string allocated (a leak
// per join). x keeps the new string (the task's `return` took an owner of
// it) and drops the old one now (with `fid run --leaks` every block is
// freed). Only the main thread prints.
// Expected output:
// w4 w5
// w6 w7
// done 3

fn word(n: i64) -> str {
    return "w" + int_to_str(n);
}

fn main() {
    var a: str = "a" + int_to_str(0);
    var b: str = "b" + int_to_str(0);
    val n: i64 = 4;
    parallel {
        | a = word(n);
        | b = word(n + 1);
    }
    println(a + " " + b);
    parallel {
        | a = word(n + 2);
        | b = word(n + 3);
    }
    println(a + " " + b);
    var k: i64 = 0;
    var i: i64 = 0;
    while i < 3 {
        parallel {
            | a = word(i);
        }
        k = k + str_len(a) - 1;
        i = i + 1;
    }
    println("done " + int_to_str(k));
}
