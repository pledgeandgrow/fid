// Test (stdlib-agent bug 3): a returned closure capturing an f64 parameter
// read its bits as an integer (mk(3.0)(2.0) gave 9227875636482146304): a
// parameter has no slot, and its capture was typed i64; now it takes the
// parameter's declared type. A local f64 (which worked) and a str
// parameter too. Also run it through `fid ccompile`.
// Expected output:
// 60
// 35
// 45
// hi there
fn mk(k: f64) -> fn(f64) -> f64 {
    return fn(x: f64) -> f64 {
        return x * k;
    };
}

fn mk_local(k: f64) -> fn(f64) -> f64 {
    val m: f64 = k + 0.5;
    return fn(x: f64) -> f64 {
        return x * m;
    };
}

fn greeter(g: str) -> fn(str) -> str {
    return fn(who: str) -> str {
        return g + " " + who;
    };
}

fn main() {
    val f = mk(3.0);
    println((f(2.0) * 10.0) as i64);
    val h = mk_local(3.0);
    println((h(1.0) * 10.0) as i64);
    val f2: fn(f64) -> f64 = mk(4.5);
    println((f2(1.0) * 10.0) as i64);
    val gr = greeter("hi");
    println(gr("there"));
}
