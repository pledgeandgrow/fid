// BG272 (docs/roadmap/bugs-roadmap.md): `spawn` of a function taking or
// returning an f32: the argument arrives and `await` gives the result on
// every backend (compiled backends gave 0 for the result, pe_ir also lost
// the argument).
//
// Expected output:
// param 125
// ret 3.5
// both 6.25
// lit 250

fn pin(a: f32) -> i64 {
    return (a * 100.0) as i64;
}

fn pout(b: i64) -> f32 {
    return (b as f32) * 0.5;
}

fn pboth(a: f32, n: i32) -> f32 {
    return a * (n as f32);
}

fn idf(x: f32) -> f32 {
    return x;
}

fn main() {
    val t = spawn pin(idf(1.25));
    println(f"param {await t}");
    val t2 = spawn pout(7);
    val r: f32 = await t2;
    println(f"ret {r}");
    val t3 = spawn pboth(idf(1.25), 5);
    val r3: f32 = await t3;
    println(f"both {r3}");
    val t4 = spawn pin(2.5);
    println(f"lit {await t4}");
}
