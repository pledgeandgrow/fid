// L8H: helper of test_cross_module_specialization.fd. A library with
// generic definitions that the program importing it specializes: a generic
// function, a generic impl's method and a generic trait impl.
module wrap_lib;

pub cap Show {
    fn show(self) -> str;
}

pub struct Wrap<T> {
    pub v: T,
}

impl<T> Wrap<T> {
    pub fn kind(self) -> str {
        return "kind any";
    }
}

impl<T> Show for Wrap<T> {
    fn show(self) -> str {
        return "any";
    }
}

pub fn describe<T>(x: T) -> str {
    return "any";
}

// a call inside the library: it runs the program's specialization too
pub fn describe_twice<T>(x: T) -> str {
    return describe(x) + " / " + describe(x);
}
