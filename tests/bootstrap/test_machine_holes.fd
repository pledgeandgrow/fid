// Track RA (docs/roadmap/llvm-roadmap.md), the machine layer's register
// allocator (compiler/nat_ir.fd):
//   RA2 live ranges as segments with holes (ng_alloc_holes): a range the
//       linear scan over hulls spilled gets a register that is only busy
//       where it is not live. Here six values made at the top are read
//       only on the `else` path, so between their definition and that
//       path they are dead over the whole `then` block, which needs every
//       register for values of its own; the loop keeps both paths hot.
//       `FID_NAT_OFF=holes`: the hull allocation alone (more spills in
//       `[stats]` with `fid emit --stats`; tests/nattools/
//       machine_batch4_check.sh compares, with FID_VERIFY=1).
// Expected output:
// 1289
// 2427
// 6804
// 77765

fn holes(n: i64, k: i64) -> i64 {
    var a: i64 = n * 3 + 1;
    var b: i64 = n * 5 + 2;
    var c: i64 = n * 7 + 3;
    var d: i64 = n * 11 + 4;
    var e: i64 = n * 13 + 5;
    var f: i64 = n * 17 + 6;
    var r: i64 = 0;
    if k % 2 == 0 {
        var p: i64 = k * 2;
        var q: i64 = k * 3 + 1;
        var s: i64 = k * 5 + 2;
        var t: i64 = k * 7 + 3;
        var u: i64 = k * 9 + 4;
        var w: i64 = k * 11 + 5;
        r = p * q - s * t + u * w + p * w - q * u + s * 3 - t;
    } else {
        r = a * b - c + d * e - f + a * f - b * e + c * d;
    }
    return r;
}

fn run(m: i64) -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < m {
        total = total + holes(i, i + m);
        i = i + 1;
    }
    return total;
}

fn main() {
    println(holes(3, 4));
    println(holes(3, 5));
    println(run(4));
    println(run(9));
}
