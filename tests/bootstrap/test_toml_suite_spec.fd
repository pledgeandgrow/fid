// stdlib/toml against a selection of the toml-test suite
// (https://github.com/toml-lang/toml-test, main branch, files listed in
// tests/files-toml-1.0.0): 24 files of tests/valid (strings and escapes,
// integers, floats, date-times, arrays and tables, keys, comments), each
// compared with its .json file (the same JSON with keys sorted), and every
// fourth file of each tests/invalid directory (129), each of which must be
// rejected. The specification's own examples are in test_toml_spec.fd.
//
// In the strings below `\x7b` and `\x7d` are braces (a brace in a Fides
// string literal may start an interpolation) and tb("hex") builds a text
// from bytes (control characters, invalid UTF-8).
use toml;

fn tb(hex: str) -> str {
    var out: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i + 1 < str_len(hex) {
        out.push(str_parse_hex("0x" + str_slice(hex, i, i + 2)));
        i = i + 2;
    }
    return str_from_bytes(out);
}

fn ok(name: str, text: str, want: str) {
    val d: TomlDoc = toml_load(text);
    if !d.ok {
        println(name + ": rejected: " + d.error);
        p_panic("toml spec: " + name + " should be valid");
    }
    val got: str = toml_to_json(d);
    if !str_equal(got, want) {
        println(name + ": got  " + got);
        println(name + ": want " + want);
        p_panic("toml spec: " + name + " parsed wrong");
    }
    println(name + ": ok");
}

fn bad(name: str, text: str) {
    val d: TomlDoc = toml_load(text);
    if d.ok {
        println(name + ": accepted: " + toml_to_json(d));
        p_panic("toml spec: " + name + " should be rejected");
    }
    println(name + ": rejected (" + d.error + ")");
}


// ─── toml-test cases ─────────────────────────────────────────────────────

// valid cases (toml-test tests/valid/...)
fn valid_0() {
    ok("string/escapes", "backspace     = \"|\\b.\"\ntab           = \"|\\t.\"\nnewline       = \"|\\n.\"\nformfeed      = \"|\\f.\"\ncarriage      = \"|\\r.\"\nquote         = \"|\\\".\"\nbackslash     = \"|\\\\.\"\ndelete        = \"|\\u007F.\"\nunitseparator = \"|\\u001F.\"\n\n# \\u is escaped, so should NOT be interperted as a \\u escape.\nnotunicode1   = \"|\\\\u.\"\nnotunicode2   = \"|\\u005Cu.\"\nnotunicode3   = \"|\\\\u0075.\"\nnotunicode4   = \"|\\\\\\u0075.\"\n",
       "\x7b\"backslash\":\x7b\"type\":\"string\",\"value\":\"|\\\\.\"\x7d,\"backspace\":\x7b\"type\":\"string\",\"value\":\"|\\u0008.\"\x7d,\"carriage\":\x7b\"type\":\"string\",\"value\":\"|\\r.\"\x7d,\"delete\":\x7b\"type\":\"string\",\"value\":\"|\\u007f.\"\x7d,\"formfeed\":\x7b\"type\":\"string\",\"value\":\"|\\u000c.\"\x7d,\"newline\":\x7b\"type\":\"string\",\"value\":\"|\\n.\"\x7d,\"notunicode1\":\x7b\"type\":\"string\",\"value\":\"|\\\\u.\"\x7d,\"notunicode2\":\x7b\"type\":\"string\",\"value\":\"|\\\\u.\"\x7d,\"notunicode3\":\x7b\"type\":\"string\",\"value\":\"|\\\\u0075.\"\x7d,\"notunicode4\":\x7b\"type\":\"string\",\"value\":\"|\\\\u.\"\x7d,\"quote\":\x7b\"type\":\"string\",\"value\":\"|\\\".\"\x7d,\"tab\":\x7b\"type\":\"string\",\"value\":\"|\\t.\"\x7d,\"unitseparator\":\x7b\"type\":\"string\",\"value\":\"|\\u001f.\"\x7d\x7d");
    ok("string/escape-tricky", "end_esc = \"String does not end here\\\" but ends here\\\\\"\nlit_end_esc = 'String ends here\\'\n\nmultiline_unicode = \"\"\"\n\\u00a0\"\"\"\n\nmultiline_not_unicode = \"\"\"\n\\\\u0041\"\"\"\n\nmultiline_end_esc = \"\"\"When will it end? \\\"\"\"...\"\"\\\" should be here\\\"\"\"\"\n\nlit_multiline_not_unicode = '''\n\\u007f'''\n\nlit_multiline_end = '''There is no escape\\'''\n",
       "\x7b\"end_esc\":\x7b\"type\":\"string\",\"value\":\"String does not end here\\\" but ends here\\\\\"\x7d,\"lit_end_esc\":\x7b\"type\":\"string\",\"value\":\"String ends here\\\\\"\x7d,\"lit_multiline_end\":\x7b\"type\":\"string\",\"value\":\"There is no escape\\\\\"\x7d,\"lit_multiline_not_unicode\":\x7b\"type\":\"string\",\"value\":\"\\\\u007f\"\x7d,\"multiline_end_esc\":\x7b\"type\":\"string\",\"value\":\"When will it end? \\\"\\\"\\\"...\\\"\\\"\\\" should be here\\\"\"\x7d,\"multiline_not_unicode\":\x7b\"type\":\"string\",\"value\":\"\\\\u0041\"\x7d,\"multiline_unicode\":\x7b\"type\":\"string\",\"value\":\" \"\x7d\x7d");
    ok("string/multiline", "# NOTE: this file includes some literal tab characters.\n\nequivalent_one = \"The quick brown fox jumps over the lazy dog.\"\nequivalent_two = \"\"\"\nThe quick brown \\\n\n\n  fox jumps over \\\n    the lazy dog.\"\"\"\n\nequivalent_three = \"\"\"\\\n       The quick brown \\\n       fox jumps over \\\n       the lazy dog.\\\n       \"\"\"\n\nwhitespace-after-bs = \"\"\"\\\n       The quick brown \\\n       fox jumps over \\   \n       the lazy dog.\\\t\n       \"\"\"\n\nno-space = \"\"\"a\\\n    b\"\"\"\n\n# Has tab character.\nkeep-ws-before = \"\"\"a   \t\\\n   b\"\"\"\n\nescape-bs-1 = \"\"\"a \\\\\nb\"\"\"\n\nescape-bs-2 = \"\"\"a \\\\\\\nb\"\"\"\n\nescape-bs-3 = \"\"\"a \\\\\\\\\n  b\"\"\"\n",
       "\x7b\"equivalent_one\":\x7b\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"\x7d,\"equivalent_three\":\x7b\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"\x7d,\"equivalent_two\":\x7b\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"\x7d,\"escape-bs-1\":\x7b\"type\":\"string\",\"value\":\"a \\\\\\nb\"\x7d,\"escape-bs-2\":\x7b\"type\":\"string\",\"value\":\"a \\\\b\"\x7d,\"escape-bs-3\":\x7b\"type\":\"string\",\"value\":\"a \\\\\\\\\\n  b\"\x7d,\"keep-ws-before\":\x7b\"type\":\"string\",\"value\":\"a   \\tb\"\x7d,\"no-space\":\x7b\"type\":\"string\",\"value\":\"ab\"\x7d,\"whitespace-after-bs\":\x7b\"type\":\"string\",\"value\":\"The quick brown fox jumps over the lazy dog.\"\x7d\x7d");
    ok("string/multiline-quotes", "# Make sure that quotes inside multiline strings are allowed, including right\n# after the opening '''/\"\"\" and before the closing '''/\"\"\"\n\nlit_one = ''''one quote''''\nlit_two = '''''two quotes'''''\nlit_one_space = ''' 'one quote' '''\nlit_two_space = ''' ''two quotes'' '''\n\none = \"\"\"\"one quote\"\"\"\"\ntwo = \"\"\"\"\"two quotes\"\"\"\"\"\none_space = \"\"\" \"one quote\" \"\"\"\ntwo_space = \"\"\" \"\"two quotes\"\" \"\"\"\n\nmismatch1 = \"\"\"aaa'''bbb\"\"\"\nmismatch2 = '''aaa\"\"\"bbb'''\n\n# Three opening \"\"\", then one escaped \", then two \"\" (allowed), and then three\n# closing \"\"\"\nescaped = \"\"\"lol\\\"\"\"\"\"\"\n\nfive-quotes = \"\"\"\nClosing with five quotes\n\"\"\"\"\"\nfour-quotes = \"\"\"\nClosing with four quotes\n\"\"\"\"\n",
       "\x7b\"escaped\":\x7b\"type\":\"string\",\"value\":\"lol\\\"\\\"\\\"\"\x7d,\"five-quotes\":\x7b\"type\":\"string\",\"value\":\"Closing with five quotes\\n\\\"\\\"\"\x7d,\"four-quotes\":\x7b\"type\":\"string\",\"value\":\"Closing with four quotes\\n\\\"\"\x7d,\"lit_one\":\x7b\"type\":\"string\",\"value\":\"'one quote'\"\x7d,\"lit_one_space\":\x7b\"type\":\"string\",\"value\":\" 'one quote' \"\x7d,\"lit_two\":\x7b\"type\":\"string\",\"value\":\"''two quotes''\"\x7d,\"lit_two_space\":\x7b\"type\":\"string\",\"value\":\" ''two quotes'' \"\x7d,\"mismatch1\":\x7b\"type\":\"string\",\"value\":\"aaa'''bbb\"\x7d,\"mismatch2\":\x7b\"type\":\"string\",\"value\":\"aaa\\\"\\\"\\\"bbb\"\x7d,\"one\":\x7b\"type\":\"string\",\"value\":\"\\\"one quote\\\"\"\x7d,\"one_space\":\x7b\"type\":\"string\",\"value\":\" \\\"one quote\\\" \"\x7d,\"two\":\x7b\"type\":\"string\",\"value\":\"\\\"\\\"two quotes\\\"\\\"\"\x7d,\"two_space\":\x7b\"type\":\"string\",\"value\":\" \\\"\\\"two quotes\\\"\\\" \"\x7d\x7d");
    ok("string/unicode-escape", "delta-1 = \"\\u03B4\"\ndelta-2 = \"\\U000003B4\"\na       = \"\\u0061\"\nb       = \"\\u0062\"\nc       = \"\\U00000063\"\nnull-1  = \"\\u0000\"\nnull-2  = \"\\U00000000\"\n\nml-delta-1 = \"\"\"\\u03B4\"\"\"\nml-delta-2 = \"\"\"\\U000003B4\"\"\"\nml-a       = \"\"\"\\u0061\"\"\"\nml-b       = \"\"\"\\u0062\"\"\"\nml-c       = \"\"\"\\U00000063\"\"\"\nml-null-1  = \"\"\"\\u0000\"\"\"\nml-null-2  = \"\"\"\\U00000000\"\"\"\n",
       "\x7b\"a\":\x7b\"type\":\"string\",\"value\":\"a\"\x7d,\"b\":\x7b\"type\":\"string\",\"value\":\"b\"\x7d,\"c\":\x7b\"type\":\"string\",\"value\":\"c\"\x7d,\"delta-1\":\x7b\"type\":\"string\",\"value\":\"δ\"\x7d,\"delta-2\":\x7b\"type\":\"string\",\"value\":\"δ\"\x7d,\"ml-a\":\x7b\"type\":\"string\",\"value\":\"a\"\x7d,\"ml-b\":\x7b\"type\":\"string\",\"value\":\"b\"\x7d,\"ml-c\":\x7b\"type\":\"string\",\"value\":\"c\"\x7d,\"ml-delta-1\":\x7b\"type\":\"string\",\"value\":\"δ\"\x7d,\"ml-delta-2\":\x7b\"type\":\"string\",\"value\":\"δ\"\x7d,\"ml-null-1\":\x7b\"type\":\"string\",\"value\":\"\\u0000\"\x7d,\"ml-null-2\":\x7b\"type\":\"string\",\"value\":\"\\u0000\"\x7d,\"null-1\":\x7b\"type\":\"string\",\"value\":\"\\u0000\"\x7d,\"null-2\":\x7b\"type\":\"string\",\"value\":\"\\u0000\"\x7d\x7d");
