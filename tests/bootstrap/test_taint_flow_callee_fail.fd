// expect-error: Taint error: function 'serve' is @tainted: its parameter 'id' reaches the sink 'run_query' (in 'lookup')
// Roadmap Phase 12 (rm-P12): taint crosses calls. `serve` passes its
// tainted input to `lookup`, which builds a query from it and hands it to
// a @sink function without a sanitizer.

@sink
fn run_query(q: str) -> i64 {
    return str_len(q);
}

fn lookup(key: str) -> i64 {
    val q: str = "SELECT * FROM users WHERE id = '" + key + "'";
    return run_query(q);
}

fn serve(@tainted id: str) -> i64 {
    val n: i64 = lookup(id);
    if n > 0 {
        return 1;
    }
    return 0;
}

fn main() {
    println(int_to_str(serve("42")));
}
