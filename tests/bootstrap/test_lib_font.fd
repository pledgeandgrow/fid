// stdlib/font: the built-in 8x8 bitmap font, which needs no library. TrueType
// loading and glyph rasterisation go through the native pledge_font
// functions (stb_truetype) and are not run here, and a Font value can only
// come from font_load.
use font;
use image;

fn lit(img: &Image) -> i64 {
    // pixels that are set: alpha 255 with a white pixel
    var n: i64 = 0;
    var i: i64 = 0;
    while i < img.data.len() {
        if img.data.get(i) == 255 && img.data.get(i + 1) == 255 && img.data.get(i + 2) == 255 && img.data.get(i + 3) == 255 {
            n = n + 1;
        }
        i = i + 4;
    }
    return n;
}

fn main() -> i64 {
    println(BITMAP_FONT_WIDTH);
    println(BITMAP_FONT_HEIGHT);

    // a printable character is an outlined 8x8 box: 28 pixels
    var a = font_bitmap_char(65);
    println(a.width);
    println(a.height);
    println(a.channels);
    println(lit(&a));
    println(image_get_pixel(&a, 0, 0));
    println(image_get_pixel(&a, 7, 7));
    println(image_get_pixel(&a, 3, 3));
    println(image_get_pixel(&a, 0, 4));
    println(image_get_pixel(&a, 3, 7));
    // the printable range is 32..126
    println(lit(&font_bitmap_char(32)));
    println(lit(&font_bitmap_char(126)));
    println(lit(&font_bitmap_char(31)));
    println(lit(&font_bitmap_char(127)));
    println(lit(&font_bitmap_char(10)));
    println(lit(&font_bitmap_char(-5)));
    // an unprintable character is a blank, opaque-black 8x8 image
    println(image_get_pixel(&font_bitmap_char(10), 0, 0));

    // text: 8 pixels per character
    var t = font_bitmap_text("AB");
    println(t.width);
    println(t.height);
    println(lit(&t));
    println(image_get_pixel(&t, 8, 0));
    println(image_get_pixel(&t, 7, 0));
    println(image_get_pixel(&t, 9, 1));
    println(image_get_pixel(&t, 15, 7));
    var one = font_bitmap_text("x");
    println(one.width);
    println(lit(&one));
    // a character outside the printable range leaves its cell blank
    var mix = font_bitmap_text("a\nb");
    println(mix.width);
    println(lit(&mix));
    // the empty string gives a single pixel
    var e = font_bitmap_text("");
    println(e.width);
    println(e.height);
    println(lit(&e));
    return 0;
}
