// expect-error: in 'mk', a closure returns a reference to 'a', its own copy of a captured variable
// BG138: the same closure returned from the function that owns `a`: the
// reference it gives back outlives both the call and `mk` (read after
// another call, it printed 5400).
fn mk() -> fn() -> &i64 {
    var a: i64 = 41;
    return fn() -> &i64 => &a;
}

fn clobber(n: i64) -> i64 {
    var x: i64 = n * 7;
    var y: i64 = x + 3;
    return x + y;
}

fn main() {
    val f = mk();
    val r: &i64 = f();
    println(int_to_str(clobber(5)));
    println(int_to_str(*r));
}
