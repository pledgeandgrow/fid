// Bugs roadmap BG289: `&mut` of a `var`, and of a `val` Vec (whose
// contents may change, as by its methods), still compile.
//
// Expected output:
// 105
// 2
fn bump(p: &mut i64) {
    *p = *p + 100;
}

fn add(v: &mut Vec<i64>) {
    v.push(1);
}

fn main() -> i64 {
    var x = 5;
    bump(&mut x);
    println(x);
    val v: Vec<i64> = Vec::new();
    add(&mut v);
    add(&mut v);
    println(v.len());
    return 0;
}
