// expect-error: uses '/'
// Bugs roadmap BG130: the division scan missed enum literals:
// `Option::Some(a / b)` in a @crashfree function divided by zero.
@crashfree
@wrapping
fn cf(a: i64, b: i64) -> Option<i64> {
    return Option::Some(a / b);
}
fn main() -> i64 { match cf(3, 0) { Option::Some(v) => { println(v); } Option::None => { } } return 0; }
