// L8E: `...xs: T` takes any number of trailing arguments, packed into a
// Vec<T> by the caller (compiler/lower.fd Lowerer_pack_variadic).
// Expected output:
// 0
// 5
// 10
// 7
// 107
// [a] x|y|z|
// [b] (none)
// [c] ab|
// [] 0|0x|[] 1|1x|[] 2|2x|
// 3

fn sum(...xs: i64) -> i64 {
    var t: i64 = 0;
    for x in xs {
        t = t + x;
    }
    return t;
}

fn sum_from(base: i64, ...xs: i64) -> i64 {
    var t: i64 = base;
    for x in xs {
        t = t + x;
    }
    return t;
}

fn tag(name: str, ...parts: str) -> str {
    if parts.len() == 0 {
        return "[" + name + "] (none)";
    }
    var t: str = "[" + name + "] ";
    for p in parts {
        t = t + p + "|";
    }
    return t;
}

fn count(...xs: str) -> i64 {
    return xs.len();
}

fn main() {
    println(int_to_str(sum()));
    println(int_to_str(sum(5)));
    println(int_to_str(sum(1, 2, 3, 4)));
    println(int_to_str(sum_from(7)));
    println(int_to_str(sum_from(7, 50, 50)));
    println(tag("a", "x", "y", "z"));
    println(tag("b"));
    var s: str = "a";
    println(tag("c", s + "b"));
    var i: i64 = 0;
    var acc: str = "";
    while i < 3 {
        var n: str = int_to_str(i);
        acc = acc + tag("", n, n + "x");
        i = i + 1;
    }
    println(acc);
    println(int_to_str(count("p", "q", "r")));
}
