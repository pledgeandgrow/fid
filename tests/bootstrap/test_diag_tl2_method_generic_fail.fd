// expect-error: no method 'frobnicate' on generic type 'Box2'
//! error: no method 'frobnicate' on generic type 'Box2'
// TL2: a test per diagnostic of the type, borrow and escape checks.
// An unknown method of a generic struct.

struct Box2<T> {
    v: T,
}

impl<T> Box2<T> {
    pub fn get(self: Box2<T>) -> T {
        return self.v;
    }
}

fn main() -> i64 {
    val b = Box2 { v: 3 };
    println(b.frobnicate());
    return 0;
}
