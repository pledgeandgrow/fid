// expect-error: returns i64; the trait's method returns Pt
// LG4: a trait type naming `Self` is compared with the impl's, `Self` being
// the implementing type (such types were not compared before).
cap Make {
    fn make(self) -> Self;
}

struct Pt { x: i64 }

impl Make for Pt {
    fn make(self) -> i64 { return 1; }
}

fn main() -> i64 {
    return 0;
}
