// Bugs roadmap BG142, BG143, BG173: consts, globals and type aliases of
// the same name in two modules, or in the program and a module, were merged
// by name (compiler.fd merge_programs: the one merged later won), so `ma`
// read mb's `K`, both modules bumped one `COUNT`, ma's `Num` (i64) became
// mb's f64 (7 / 2 gave 3.5), and a private `LIMIT` in two modules (or in
// the program and a module) was a false "private to module" error. Each
// keeps its own now (compiler.fd cc_qualify_shadowed_values); `ma::K`
// names module ma's copy.
//
// Expected output:
// 1 2
// 101 201 102
// 102 201
// 3 1.5
// 100 200 5
// 1 2
// 42
use same_name_lib::ma;
use same_name_lib::mb;

const LIMIT: i64 = 5;

fn main() -> i64 {
    println(f"{ma::a()} {mb::b()}");
    val x: i64 = ma::bump_a();
    val y: i64 = mb::bump_b();
    val z: i64 = ma::bump_a();
    println(f"{x} {y} {z}");
    println(f"{ma::COUNT} {mb::COUNT}");
    println(f"{ma::half_a()} {mb::half_b()}");
    println(f"{ma::limit_a()} {mb::limit_b()} {LIMIT}");
    println(f"{ma::K} {mb::K}");
    println(f"{ma::shadow_a()}");
    return 0;
}
