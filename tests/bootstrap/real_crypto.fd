// Test: real crypto (SHA-256, HMAC) — pure Fides implementation
use crypto;
use io;

fn main() {
    // Test SHA-256
    val hash_hex = crypto_sha256_hex_str("hello");
    io_println("SHA-256(hello) = " + hash_hex);

    // Expected: 2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824
    if hash_hex == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" {
        io_println("SHA-256 verified correctly!");
    } else {
        p_panic("SHA-256 MISMATCH!");
    }

    // Test SHA-256 of empty string
    val empty_hash = crypto_sha256_hex_str("");
    io_println("SHA-256('') = " + empty_hash);
    // Expected: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

    // Test HMAC-SHA256
    val hmac = crypto_hmac_sha256("key", "The quick brown fox jumps over the lazy dog");
    val hmac_hex = crypto_sha256_hex(hmac);
    io_println("HMAC-SHA256 = " + hmac_hex);
    // RFC 4231-style reference (Python: hmac.new(b"key", msg, sha256))
    if hmac_hex == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8" {
        io_println("HMAC-SHA256 verified correctly!");
    } else {
        p_panic("HMAC-SHA256 MISMATCH!");
    }

    // A message longer than one 64-byte block
    val long_hex = crypto_sha256_hex_str("The quick brown fox jumps over the lazy dog, then over the lazy cat, and then sleeps.");
    io_println("SHA-256(long) = " + long_hex);

    // Test nonce tracker
    val tracker = crypto_nonce_tracker_new();
    val n1 = crypto_nonce_next(&mut tracker);
    val n2 = crypto_nonce_next(&mut tracker);
    val n3 = crypto_nonce_next(&mut tracker);
    io_println("Nonces: ");
    io_print_int(n1); io_println("");
    io_print_int(n2); io_println("");
    io_print_int(n3); io_println("");

    // Test constant-time comparison
    val a = crypto_sha256("test");
    val b = crypto_sha256("test");
    val c = crypto_sha256("different");
    if crypto_constant_time_eq(a, b) {
        io_println("Constant-time eq: same hashes match (correct)");
    }
    if !crypto_constant_time_eq(a, c) {
        io_println("Constant-time eq: different hashes don't match (correct)");
    }

    io_println("Crypto test passed!");
}
