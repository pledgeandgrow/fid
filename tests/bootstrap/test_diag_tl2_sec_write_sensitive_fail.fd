// expect-error: writes a sensitive value through reference parameter 'out'; mark the function @sensitive or @declassify
// Expected to FAIL (TL2): the sensitive value leaves through a `&mut`
// parameter.
fn put(@sensitive k: i64, out: &mut i64) {
    *out = k;
}
fn main() -> i64 {
    var o: i64 = 0;
    put(7, &mut o);
    return 0;
}
