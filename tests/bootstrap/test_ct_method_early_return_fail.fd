// expect-error: function 'Key.eq' has an early return
// Bugs roadmap BG21: the @constant_time rules were checked on free
// functions only: this method returns as soon as the secret differs, so
// its running time tells how much of it matched, and it was accepted.
struct Key {
    k: i64,
}

impl Key {
    @constant_time fn eq(self: Key, guess: i64) -> bool {
        if self.k != guess {
            return false;
        }
        return true;
    }
}

fn main() -> i64 {
    val key: Key = Key { k: 42 };
    if key.eq(41) {
        println("match");
    }
    return 0;
}
