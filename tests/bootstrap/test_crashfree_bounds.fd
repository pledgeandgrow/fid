// Crashfree indexing that cannot fail: within `for i in 0..v.len()`, and
// through vec_get_or elsewhere.
@crashfree @wrapping
fn total(v: Vec<i64>) -> i64 {
    var s: i64 = 0;
    for i in 0..v.len() {
        s = s + v.get(i);
    }
    return s;
}

// v.len() - 1 is -1 for an empty Vec, which vec_get_or turns into 0.
@crashfree @wrapping
fn last_or_zero(v: Vec<i64>) -> i64 {
    return vec_get_or(v, v.len() - 1, 0);
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(2);
    v.push(5);
    assert_msg(total(v) == 7, "loop-bounded indexing");
    assert_msg(last_or_zero(v) == 5, "vec_get_or in bounds");
    var e: Vec<i64> = Vec::new();
    assert_msg(last_or_zero(e) == 0, "vec_get_or out of bounds");
    print("crashfree bounds OK
");
}
