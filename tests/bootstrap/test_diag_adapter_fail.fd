// expect-error: Adapter error: function 'wrap' is @adapter but has no parameters
// TL2: a diagnostic per check. An @adapter converts what it is given, so
// one with no parameter has nothing to adapt.

@adapter
fn wrap() -> i64 {
    return 1;
}

fn main() -> i64 {
    println(int_to_str(wrap()));
    return 0;
}
