// Earlier miscompile "AGENTS 12": zero-valued struct fields printed garbage
// in optimized native builds (SROA turned field loads into copies, then CSE
// dropped the shared zero constant without rewriting the copies).
// Several fields hold the same zero constant; others the same nonzero one.
//
// Expected output:
// 0 0 0
// 5 0 5
// 10

struct P3 {
    x: i64,
    y: i64,
    z: i64,
}

fn sum(p: P3) -> i64 {
    return p.x + p.y + p.z;
}

fn main() -> i64 {
    var p: P3 = P3 { x: 0, y: 0, z: 0 };
    println(int_to_str(p.x) + " " + int_to_str(p.y) + " " + int_to_str(p.z));
    var q: P3 = P3 { x: 5, y: 0, z: 5 };
    println(int_to_str(q.x) + " " + int_to_str(q.y) + " " + int_to_str(q.z));
    println(int_to_str(sum(q)));
    return 0;
}
