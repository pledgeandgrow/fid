// expect-error: cannot mutate v: shared borrow(s) are active on it or its fields
// BG139: `&w[0]` with `w = &v` points into v's buffer, so r borrows v, not
// only w: the borrow of v must not end at w's last use while r still lives
// (the pushes moved the buffer and `*r` printed 0, not 111).
fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(111);
    val w: &Vec<i64> = &v;
    val r: &i64 = &w[0];
    var i: i64 = 0;
    while i < 100000 {
        v.push(i);
        i = i + 1;
    }
    println(int_to_str(*r));
}
