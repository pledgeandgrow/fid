// expect-error: does not implement Show (required by V: Show in method 'Pos.label')
// LG4: a bound on a generic method's own type parameter is checked at the
// call (typechecker.fd TypeChecker_lg4_method_call): an i64 has no `show`.
cap Show {
    fn show(self) -> str;
}

cap Labeler {
    fn label<V: Show>(self, v: V) -> str;
}

struct Pos { n: i64 }

impl Labeler for Pos {
    fn label<V: Show>(self, v: V) -> str { return "pos " + v.show(); }
}

fn main() -> i64 {
    val p = Pos { n: 1 };
    println(p.label(5));
    return 0;
}
