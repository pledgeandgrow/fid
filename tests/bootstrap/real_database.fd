// Test: real database operations
use db;
use io;
use json;

fn main() {
    // Test in-memory database
    val database = MemoryDB::new();

    // Insert data
    database.exec("SET name Alice");
    database.exec("SET age 30");
    database.exec("SET city NYC");

    // Query data
    val name = database.query("SELECT val FROM data WHERE key=name");
    io_println("Name: " + name);

    val all = database.query("SELECT * FROM data");
    io_println("All data: " + all);

    database.close();

    io_println("Database test passed!");
}
