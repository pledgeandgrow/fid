// Track MI (docs/roadmap/llvm-roadmap.md MI8), the machine layer
// (compiler/nat_ir.fd ng_mir_alloc): a spilled vreg that is rematerialized
// (RA8: defined once by a constant, a global's address or a slot's
// address, and computed again at each use) is never stored, so it gets no
// spill slot. `keys` keeps more large constants live across the call in
// its loop than there are registers, so several of them are spilled; its
// frame (`fid emit --stats`, "[stats] keys: ..., frame N") must be
// smaller than with FID_NAT_OFF=remat, where each one is stored in a slot
// of its own (tests/nattools/machine_frame_check.sh). Results are the same
// either way.
// Expected output:
// -1730256124581889688
// 1260
// 130727975327263461

@wrapping fn step(a: i64, b: i64) -> i64 {
    var r: i64 = a;
    var j: i64 = 0;
    while j < 3 {
        r = (r * 31 + b) ^ (r >> 7);
        j = j + 1;
    }
    if r < 0 && b == 0 - 99 {
        println("never");
    }
    return r;
}

@wrapping fn keys(n: i64) -> i64 {
    val k1: i64 = 81985529216486895;
    val k2: i64 = 1311768467463790320;
    val k3: i64 = 2541551405711093505;
    val k4: i64 = 3771334343958396690;
    val k5: i64 = 5001117282205699875;
    val k6: i64 = 6230900220453003060;
    val k7: i64 = 7460683158700306245;
    val k8: i64 = 8690466096947609430;
    val k9: i64 = 1229782938247303441;
    val k10: i64 = 2459565876494606882;
    val k11: i64 = 3689348814741910323;
    val k12: i64 = 4919131752989213764;
    val k13: i64 = 6148914691236517205;
    val k14: i64 = 7378697629483820646;
    val k15: i64 = 8608480567731124087;
    val k16: i64 = 1152921504606846977;
    val k17: i64 = 2305843009213693955;
    val k18: i64 = 3458764513820540929;
    val k19: i64 = 4611686018427387905;
    val k20: i64 = 5764607523034234881;
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < n {
        acc = step(acc, i);
        acc = acc ^ k1;
        acc = acc + k2;
        acc = acc ^ k3;
        acc = acc + k4;
        acc = acc ^ k5;
        acc = acc + k6;
        acc = acc ^ k7;
        acc = acc + k8;
        acc = acc ^ k9;
        acc = acc + k10;
        acc = acc ^ k11;
        acc = acc + k12;
        acc = acc ^ k13;
        acc = acc + k14;
        acc = acc ^ k15;
        acc = acc + k16;
        acc = acc ^ k17;
        acc = acc + k18;
        acc = acc ^ k19;
        acc = acc + k20;
        i = i + 1;
    }
    return acc;
}

fn small(n: i64) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < n {
        t = t + i * 2;
        i = i + 1;
    }
    return t;
}

fn main() {
    println(keys(10));
    println(small(36));
    println(keys(25));
}
