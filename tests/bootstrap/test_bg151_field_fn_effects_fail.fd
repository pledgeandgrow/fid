// expect-error: is @deterministic but has effect
// Bugs roadmap BG151: a function value read from a struct field may be
// anything, so a call through it has every effect (reference §9.1, as for
// a function value passed to a higher-order call); @deterministic missed it.
struct S {
    f: fn(i64) -> i64,
}

fn noisy(x: i64) -> i64 {
    println("io");
    return x;
}

@deterministic
fn det(s: S) -> i64 {
    val g = s.f;
    return g(3);
}

fn main() -> i64 {
    val s = S { f: noisy };
    println(det(s));
    return 0;
}
