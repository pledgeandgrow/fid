// BM3 (competitive roadmap): mandelbrot, the points of a 64 x 64 grid in the set.
// bench/game/fides/mandelbrot.fd on a small input (mandelbrot(64)), so the suite checks
// the benchmark's code on every backend; the expected value is the one
// the reference algorithm gives (computed in double precision, the same
// operations in the same order).
//
// Expected output:
// 1626
fn mandelbrot(n: i64) -> i64 {
    var count: i64 = 0;
    val nf: f64 = n as f64;
    var y: i64 = 0;
    while y < n {
        val ci: f64 = 2.0 * (y as f64) / nf - 1.0;
        var x: i64 = 0;
        while x < n {
            val cr: f64 = 2.0 * (x as f64) / nf - 1.5;
            var zr: f64 = 0.0;
            var zi: f64 = 0.0;
            var tr: f64 = 0.0;
            var ti: f64 = 0.0;
            var i: i64 = 0;
            while i < 50 && tr + ti <= 4.0 {
                zi = 2.0 * zr * zi + ci;
                zr = tr - ti + cr;
                tr = zr * zr;
                ti = zi * zi;
                i = i + 1;
            }
            if tr + ti <= 4.0 {
                count = count + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return count;
}

fn main() -> i64 {
    println(mandelbrot(64));
    return 0;
}
