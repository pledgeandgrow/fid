// test_machine_secret_regs.fd — llvm LF20 on the machine layer
// (compiler/nat_ir.fd): a function holding a secret zeroes, at every
// return, the registers no call keeps (ng_wipe_regs: argument, scratch and
// address registers, the float and vector registers no call keeps, a
// caller-saved pool register only when it wrote one) except the result's,
// and its secret values (a @zeroize local, what is loaded from it or
// computed from it) are the last the allocator spills (ng_secret_weights).
// The results do not change: every backend prints the same.
//   pressure: 24 values busy in a loop and one secret value live across
//     it, used once: without LF20 the secret is the cheapest to spill;
//     `--stats` prints `[lf20] pressure: S secret values, S in registers`
//     (tests/nattools/machine_lf20_check.sh);
//   split_key: a secret function returning a two-word struct in two
//     registers (ME27): argument register 1 is a result, not wiped;
//   ct_pick: a @constant_time leaf (no frame) still wipes its registers;
//   fmix: a float secret (MI25 float registers), the result kept;
//   keep_across: values live across a call to a secret function stay
//     intact (IPRA callers keep values in pool registers the callee's
//     clobber mask leaves out: those are not wiped).
//
// Expected output:
// 839019
// 701
// 579
// 170
// 85
// 325
// 777

struct Pair {
    a: i64,
    b: i64,
}

fn pressure(n: i64, key: i64) -> i64 {
    @zeroize
    var k: i64 = key * 31 + 7;
    var s: i64 = k ^ 5;
    var a0: i64 = n + 1;
    var a1: i64 = n + 2;
    var a2: i64 = n + 3;
    var a3: i64 = n + 4;
    var a4: i64 = n + 5;
    var a5: i64 = n + 6;
    var a6: i64 = n + 7;
    var a7: i64 = n + 8;
    var a8: i64 = n + 9;
    var a9: i64 = n + 10;
    var a10: i64 = n + 11;
    var a11: i64 = n + 12;
    var a12: i64 = n + 13;
    var a13: i64 = n + 14;
    var a14: i64 = n + 15;
    var a15: i64 = n + 16;
    var a16: i64 = n + 17;
    var a17: i64 = n + 18;
    var a18: i64 = n + 19;
    var a19: i64 = n + 20;
    var a20: i64 = n + 21;
    var a21: i64 = n + 22;
    var a22: i64 = n + 23;
    var a23: i64 = n + 24;
    var i: i64 = 0;
    while i < n {
        a0 = a0 * 3 + a1;
        a1 = a1 * 3 + a2;
        a2 = a2 * 3 + a3;
        a3 = a3 * 3 + a4;
        a4 = a4 * 3 + a5;
        a5 = a5 * 3 + a6;
        a6 = a6 * 3 + a7;
        a7 = a7 * 3 + a8;
        a8 = a8 * 3 + a9;
        a9 = a9 * 3 + a10;
        a10 = a10 * 3 + a11;
        a11 = a11 * 3 + a12;
        a12 = a12 * 3 + a13;
        a13 = a13 * 3 + a14;
        a14 = a14 * 3 + a15;
        a15 = a15 * 3 + a16;
        a16 = a16 * 3 + a17;
        a17 = a17 * 3 + a18;
        a18 = a18 * 3 + a19;
        a19 = a19 * 3 + a20;
        a20 = a20 * 3 + a21;
        a21 = a21 * 3 + a22;
        a22 = a22 * 3 + a23;
        a23 = a23 * 3 + a0;
        i = i + 1;
    }
    val t1: i64 = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7;
    val t2: i64 = a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15;
    val t3: i64 = a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23;
    return (t1 + t2 + t3) % 1000003 + s;
}

fn split_key(key: i64) -> Pair {
    @zeroize
    var k: i64 = key * 7;
    return Pair { a: k + 1, b: k ^ 255 };
}

/// a where mask is all ones, b where it is zero
@constant_time
@wrapping
fn ct_pick(mask: i64, a: i64, b: i64) -> i64 {
    return (a & mask) | (b & ~mask);
}

fn fmix(x: f64) -> f64 {
    @zeroize
    var k: f64 = x * 1.5;
    return k + 0.25;
}

fn mixk(key: i64, x: i64) -> i64 {
    @zeroize
    var k: i64 = key * 13;
    return (x ^ k) - k + x;
}

fn keep_across(n: i64) -> i64 {
    var a: i64 = n + 1;
    var b: i64 = n * 2;
    var c: i64 = n + 3;
    var d: i64 = n * 4;
    var e: i64 = n + 5;
    var f: i64 = n * 6;
    val m: i64 = mixk(n, 9);
    return a + b + c + d + e + f + m + a * b - c * d + e * f;
}

fn main() {
    println(pressure(5, 12345));
    val p: Pair = split_key(100);
    println(p.a);
    println(p.b);
    println(ct_pick(0 - 1, 170, 85));
    println(ct_pick(0, 170, 85));
    println((fmix(2.0) * 100.0) as i64);
    println(keep_across(10));
}
