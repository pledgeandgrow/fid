// Test (stdlib-agent bug 38): the result of a call (or of any postfix
// expression) can be called: `pick(1)(5)`, `adder(2)(3)(4)`, a closure
// called where it is written. It did not parse ("expected ) but got
// 'LParen'"). A `(` on the next line still starts a new statement.
// (Calling a fn value read from a Vec, `fs.get(1)(5)`, parses the same way;
// that it runs is bug 31's, not tested here.)
// Expected output:
// 10 6
// many
// 9
// 49
// 3
fn inc(x: i64) -> i64 {
    return x + 1;
}

fn dbl(x: i64) -> i64 {
    return x * 2;
}

fn name(x: i64) -> str {
    if x == 0 {
        return "zero";
    }
    return "many";
}

fn pick(n: i64) -> fn(i64) -> i64 {
    if n == 0 {
        return inc;
    }
    return dbl;
}

fn namer() -> fn(i64) -> str {
    return name;
}

fn twice(f: fn(i64) -> i64) -> fn(i64) -> i64 {
    return f;
}

fn main() {
    println(int_to_str(pick(1)(5)) + " " + int_to_str(pick(0)(5)));
    println(namer()(3));
    val t: i64 = twice(pick(0))(7) + 1;
    println(int_to_str(t));
    val sq: i64 = (fn(x: i64) -> i64 { return x * x; })(7);
    println(int_to_str(sq));
    val v: i64 = 3
    (v)
    println(int_to_str(v));
}
