// expect-error: Duplicate definition: enum 'E' is defined twice in module
// Bugs roadmap BG372: a duplicate enum gave a cascade of misleading errors
// pointing at the first declaration instead of one "defined twice".
enum E {
    A,
    B,
}
enum E {
    A,
    C,
}
fn main() {
    val e = E::A;
    match e {
        E::A => {
            println("a");
        }
        _ => {
            println("other");
        }
    }
}
