// known-bugs 2g.38: a struct literal of a struct declared in an imported
// module parses in the importing program.
use semver;

fn main() -> i64 {
    val v: SemVer = SemVer { major: 1, minor: 2, patch: 3, pre: "rc.1", build: "" };
    println(semver_to_str(v));
    println(v.minor);
    return 0;
}
