// expect-error: expected a name but got the type name `f32`
// Test (stdlib-agent bug 26): `f32` is a reserved type name (reference
// §1.4) and cannot name a variable. The error said "expected identifier
// but got 'F32'"; it now names the word and says type names are reserved.
fn main() {
    val f32: i64 = 1;
    println(int_to_str(f32));
}
