// expect-error: cannot mutate c: shared borrow(s) are active
// LG3: a user method taking `&mut self` still changes its receiver: calling
// it while `r` borrows `c` is an error.
struct Counter {
    n: i64,
}

impl Counter {
    fn peek(self: &Counter) -> i64 {
        return self.n;
    }
    fn bump(self: &mut Counter) -> void {
        self.n = self.n + 1;
    }
}

fn main() -> i64 {
    var c: Counter = Counter { n: 4 };
    val r = &c;
    c.bump();
    println(r.n);
    return 0;
}
