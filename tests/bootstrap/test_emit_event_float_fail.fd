// expect-error: Event error: @event 'Price' has parameter 'value' of type f64, which an event cannot carry
// Roadmap Phase 9 (F34): an event's parameters are integers, bool or str:
// floating point is not reproducible across the nodes reading the log.
@event
fn Price(value: f64) {}

@emit(Price)
fn quote(v: f64) {
    Price(v);
}

fn main() -> i64 {
    quote(1.5);
    return 0;
}
