// expect-error: cannot assign to t.m.d.x
// SP10: `t.m.d.x = 5` while `&t.m` is alive changes what the borrow sees.
// The parent borrow is two levels up; `t.n` is borrowed as well, so the
// prefix counts of `t` are not 0 and the walk goes on to `t.m`.
struct Deep { x: i64 }
struct Mid { d: Deep, k: i64 }
struct Top { m: Mid, n: i64 }

fn rmid(r: &Mid) -> i64 { return r.d.x + r.k; }
fn rk(r: &i64) -> i64 { return *r; }

fn main() -> i64 {
    var t = Top { m: Mid { d: Deep { x: 3 }, k: 7 }, n: 10 };
    val rn = &t.n;
    val rm = &t.m;
    t.m.d.x = 5;
    print(rmid(rm) + rk(rn));
    return 0;
}
