// expect-error: field 'y' expected i64, got str
//! error: field 'y' expected i64, got str
// TL2: a test per diagnostic of the type, borrow and escape checks.
// A struct literal's field values have the fields' types.

struct Point {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    val p = Point { x: 5, y: "six" };
    println(p.x);
    return 0;
}
