// Bugs roadmap BG266: in-range narrow signed comptime arithmetic, and i64
// arithmetic on values from an i32 parameter (cast first), still evaluate.
//
// Expected output:
// 2147395600
// -128
// 2500000000
// 120
comptime fn sq(x: i32) -> i32 {
    return x * x;
}
comptime fn lo(a: i8) -> i8 {
    return a - 28;
}
comptime fn wide(x: i32) -> i64 {
    val w: i64 = x as i64;
    return w * w;
}
comptime fn fact(n: i32) -> i32 {
    var r: i32 = 1;
    var i: i32 = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}
fn main() -> i64 {
    println(comptime sq(46340));
    println(comptime lo(-100));
    println(comptime wide(50000));
    println(comptime fact(5));
    return 0;
}
