// LF11/ME25 (native, FID_IROPT_ON=version): `while i < n { v.get(i) }` with
// n a parameter gets a copy entered when `n > 0 && n <= v.len() && i >= 0`
// (iropt.fd iro_version), whose bounds checks checks.fd proves away
// (peir_entry_guard). The original loop, with its checks, runs otherwise.
// Every backend, with versioning on or off, prints the same; the last call
// takes the original loop (n > v.len()) and stops before the end.
// Expected output:
// 15
// 0
// 12
// 2 4 6 8 10
// 9

fn sum_first(v: Vec<i64>, n: i64) -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < n {
        total = total + v.get(i);
        i = i + 1;
    }
    return total;
}

fn sum_from(v: Vec<i64>, start: i64, n: i64) -> i64 {
    var total: i64 = 0;
    var i: i64 = start;
    while i < n {
        total = total + v.get(i);
        i = i + 1;
    }
    return total;
}

fn double_first(v: & mut Vec<i64>, n: i64) {
    var i: i64 = 0;
    while i < n {
        v.set(i, v.get(i) * 2);
        i = i + 1;
    }
}

// The guard fails (n > len): the checked loop runs, and stops at the end of
// the Vec itself.
fn sum_safe(v: Vec<i64>, n: i64) -> i64 {
    var total: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if i >= v.len() {
            return total;
        }
        total = total + v.get(i);
        i = i + 1;
    }
    return total;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    var k: i64 = 1;
    while k <= 5 {
        v.push(k);
        k = k + 1;
    }
    println(sum_first(v, 5));
    println(sum_first(v, 0));
    println(sum_from(v, 2, 5));
    double_first(& mut v, 5);
    println(int_to_str(v.get(0)) + " " + int_to_str(v.get(1)) + " " + int_to_str(v.get(2)) + " " + int_to_str(v.get(3)) + " " + int_to_str(v.get(4)));
    var w: Vec<i64> = Vec::new();
    w.push(4);
    w.push(5);
    println(sum_safe(w, 10));
    return 0;
}
