// L8E: a variadic over a type parameter is a comptime tuple (a pack).
// `...xs: T` where T types nothing else takes arguments of different
// types; each call shape (the number and types of the arguments) gets its
// own instance (mono.fd mono_desugar_variadics: `f__pack<m>`, then
// ordinary monomorphization per argument types). xs.len() is a constant,
// xs.get(K) with a literal K is that element, and `for x in xs` is
// unrolled, x having each element's own type, so `describe(x)` takes the
// specialization of that type (L8H).
//
// Expected output:
// mixed (3): int 1 str two yes
// none (0):
// ints (2): int 5 int 6
// again (2): no other
// int 7 .. no
// 4
// 0

fn describe<T>(x: T) -> str {
    return "other";
}

fn describe(x: i64) -> str {
    return "int " + int_to_str(x);
}

fn describe(x: str) -> str {
    return "str " + x;
}

fn describe(x: bool) -> str {
    if x {
        return "yes";
    }
    return "no";
}

fn show_all<T>(label: str, ...xs: T) -> str {
    var out: str = label + " (" + int_to_str(xs.len()) + "):";
    for x in xs {
        out = out + " " + describe(x);
    }
    return out;
}

fn first_last<T>(...xs: T) -> str {
    return describe(xs.get(0)) + " .. " + describe(xs.get(2));
}

fn count<T>(...xs: T) -> i64 {
    return xs.len();
}

fn main() -> i64 {
    println(show_all("mixed", 1, "two", true));
    println(show_all("none"));
    println(show_all("ints", 5, 6));
    println(show_all("again", false, 3.5));
    println(first_last(7, "mid", false));
    println(int_to_str(count(1, "a", true, 2)));
    println(int_to_str(count()));
    return 0;
}
