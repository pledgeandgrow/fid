// expect-error: pattern 3 is an integer, but the value matched is a 'f64': a float has no pattern form
// Bugs roadmap BG380: an integer pattern on an f64 scrutinee was accepted;
// `fid run` panicked, C matched (it converts) and pe_ir did not (it compared
// 3 with the bits of 3.0).
fn main() {
    val x: f64 = 3.0;
    match x {
        3 => {
            println("three");
        }
        _ => {
            println("o");
        }
    }
}
