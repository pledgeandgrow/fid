// expect-error: function value 'sq' parameter 1 expects 'f64', got 'str'
// Roadmap L6C (type-safe function pointer lookup): a symbol found with
// p_dl_find (the OS loader) takes the function type it is declared with,
// as one from p_dl_sym does, so a call through it with a wrong argument
// type is a compile error.
use core with { FS, IO }

fn main() -> i64 {
    val lib: i64 = p_dl_load("libm.so.6");
    val sq: fn(f64) -> f64 = p_dl_find(lib, "sqrt");
    val r = sq("sixteen");
    return 0;
}
