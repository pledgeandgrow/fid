// The textkit library of tests/projects/library (release-roadmap N11) and
// its app in one file, so every backend of the suite runs them; the
// project itself is built through ark by scripts/ark-check.sh. Keep the
// functions the same as tests/projects/library/textkit/src/lib.fd.
//
// Expected output:
// desserts
// palindrome
// not a palindrome
// 4
// Khoor, Ilghv!
// Hello, Fides!

/// `s` with its bytes in reverse order.
pub fn tk_reverse(s: str) -> str {
    var out: str = "";
    var i: i64 = str_len(s) - 1;
    while i >= 0 {
        out = out + str_slice(s, i, i + 1);
        i = i - 1;
    }
    return out;
}

/// `s` lowered to its letters and digits, in lower case.
fn tk_letters(s: str) -> str {
    var out: str = "";
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c >= 65 && c <= 90 {
            c = c + 32;
        }
        if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
            out = out + char_to_str(c);
        }
        i = i + 1;
    }
    return out;
}

/// True when `s` reads the same both ways, ignoring case, spaces and
/// punctuation.
pub fn tk_is_palindrome(s: str) -> bool {
    val letters: str = tk_letters(s);
    return letters == tk_reverse(letters);
}

/// The number of words of `s`: runs of bytes other than spaces.
pub fn tk_word_count(s: str) -> i64 {
    var words: i64 = 0;
    var in_word: bool = false;
    var i: i64 = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) == 32 {
            in_word = false;
        } else if !in_word {
            in_word = true;
            words = words + 1;
        }
        i = i + 1;
    }
    return words;
}

/// Each letter of `s` moved `shift` places along the alphabet (a Caesar
/// cipher; a negative shift moves back). Other bytes are kept.
pub fn tk_caesar(s: str, shift: i64) -> str {
    val k: i64 = (shift % 26 + 26) % 26;
    var out: str = "";
    var i: i64 = 0;
    while i < str_len(s) {
        var c: i64 = str_byte_at(s, i);
        if c >= 97 && c <= 122 {
            c = 97 + (c - 97 + k) % 26;
        } else if c >= 65 && c <= 90 {
            c = 65 + (c - 65 + k) % 26;
        }
        out = out + char_to_str(c);
        i = i + 1;
    }
    return out;
}

fn main() -> i64 {
    println(tk_reverse("stressed"));
    if tk_is_palindrome("Never odd or even") {
        println("palindrome");
    } else {
        println("not a palindrome");
    }
    if tk_is_palindrome("Fides") {
        println("palindrome");
    } else {
        println("not a palindrome");
    }
    println(int_to_str(tk_word_count("  the quick  brown fox ")));
    val secret: str = tk_caesar("Hello, Fides!", 3);
    println(secret);
    println(tk_caesar(secret, -3));
    return 0;
}
