// expect-error: this `comptime splice { }` was not expanded
//! error: this `comptime splice { }` was not expanded
// TL2: a test per diagnostic of the type, borrow and escape checks.
// LG9: a splice may stand in a function body or a constant's initializer;
// one inside a closure is not expanded and is reported.

fn main() -> i64 {
    val f = fn(x: i64) { comptime splice { return "x + 1"; } };
    println(f(1));
    return 0;
}
