// Test: @conserve violation (should fail to compile)
// A @conserve function cannot call Money_new (the mint function).

use money;

@conserve
fn bad_transfer(to_cents: i64) -> Money {
    // ERROR: @conserve function calls Money_new, which creates money.
    // Money can only be moved, split, or merged inside @conserve functions.
    return Money_new(to_cents);
}

fn main() -> i64 {
    val result = bad_transfer(5000);
    print(Money_to_cents(result));
    return 0;
}
