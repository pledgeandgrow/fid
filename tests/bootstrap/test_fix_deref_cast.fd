// Test (stdlib-agent bugs 5/41 and 7): the precedence of reference §4.1.
// `as` binds tighter than prefix `*`, so a dereference is cast with
// `(*s) as f64`; `-x as i64` is `-(x as i64)`. `&` and `>>` bind more
// loosely than `==`/`!=` (C's rule for `&`), so a masked or shifted value
// is compared in parentheses: `((x & 255) >> 5) != m`.
// Expected output:
// 2.5
// -7
// 6 eq
// 1
fn half(s: & i64) -> f64 {
    return (*s) as f64 / 2.0;
}

fn main() {
    val x: i64 = 5;
    println(float_to_str(half(& x)));
    val y: i32 = 7;
    println(int_to_str(-y as i64));
    val v: i64 = 200;
    val m: i64 = 6;
    val top: i64 = (v & 255) >> 5;
    if ((v & 255) >> 5) != m {
        println(int_to_str(top) + " ne");
    } else {
        println(int_to_str(top) + " eq");
    }
    val flags: i64 = 3;
    if (flags & 1) != 0 {
        println("1");
    }
}
