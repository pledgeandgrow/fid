module compiler::test_enum;

pub enum Color {
    Red,
    Green,
    Blue,
}

pub fn color_to_str(c: Color) -> str {
    match c {
        Color::Red => { return "red"; }
        Color::Green => { return "green"; }
        Color::Blue => { return "blue"; }
    }
    return "";
}

fn main() -> i64 {
    val c = Color::Red;
    print(color_to_str(c));
    print("\n");
    return 0;
}
