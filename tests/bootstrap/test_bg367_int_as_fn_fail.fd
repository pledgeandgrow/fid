// expect-error: casting an integer to fn(i64) -> i64 needs an `unsafe` block
// Bugs roadmap BG367: `12345 as fn(i64) -> i64` made a function value out
// of any integer in safe code; calling it jumped to address 0x3039. A raw
// pointer made from an integer cannot be used without `unsafe`, but a
// function value can, so the cast needs `unsafe` (reference §4.6, §8.5).
fn main() {
    val g = 12345 as fn(i64) -> i64;
    println(g(3));
}
