// Test (known-bugs 2g.18): `5e3` is the float 5000 (it lexed as 5 and the
// name e3); `e3` alone is still a name.
//
// Expected output:
// 5000
// 0.002
// 7
fn main() -> i64 {
    val a: f64 = 5e3;
    val b: f64 = 2E-3;
    val e3: i64 = 7;
    println(float_to_str(a));
    println(float_to_str(b));
    println(int_to_str(e3));
    return 0;
}
