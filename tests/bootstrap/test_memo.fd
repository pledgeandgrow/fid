// Test: Memoization stdlib helper (stdlib/memo.fd)
use memo;

fn fib(n: i64) -> i64 {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn main() {
    val cache = Memo::new();

    // First call — computes and caches
    val r1 = cache.get_or_compute(10, fib);
    print("fib(10) = ");
    print(r1);
    print("\n");

    // Second call — should be a cache hit
    val r2 = cache.get_or_compute(10, fib);
    print("fib(10) cached = ");
    print(r2);
    print("\n");

    // Cache size
    val sz = cache.size();
    print("cache size = ");
    print(sz);
    print("\n");

    // Different key — cache miss
    val r3 = cache.get_or_compute(5, fib);
    print("fib(5) = ");
    print(r3);
    print("\n");

    val sz2 = cache.size();
    print("cache size2 = ");
    print(sz2);
    print("\n");

    print("OK\n");
}
