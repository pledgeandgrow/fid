// Bugs roadmap BG263: defaults of the parameter's type still compile, and
// are used where the argument is left out.
//
// Expected output:
// 255 7
// 3 7
// hi
// true
fn j(x: u8 = 255, y: i64 = 7) -> str {
    return f"{x} {y}";
}

fn s(t: str = "hi") -> str {
    return t;
}

fn b(v: bool = true) -> bool {
    return v;
}

fn main() -> i64 {
    println(j());
    println(j(3));
    println(s());
    println(b());
    return 0;
}
