// expect-error: array index must be an integer, got str
// Bugs roadmap BG1: the index of `v[i] = x` was not checked: a string's
// address was used as the element number. It must be an integer.

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    val k: str = "0";
    v[k] = 5;
    println(int_to_str(v[0]));
    return 0;
}
