// expect-error: cannot create &x: a mutable borrow is already active
// Expected to FAIL (BG79, docs/roadmap/bugs-roadmap.md): the borrow check
// did not look into a tuple, so `(&mut x, &x)` -- a mutable and a shared
// reference to the same variable at once -- was accepted, and the names a
// `val (a, b) = ...` binds recorded no borrow. (It did not look into `is`
// or a comptime block either.)
fn main() -> i64 {
    var x: i64 = 1;
    val (a, b) = (&mut x, &x);
    *a = 2;
    println(int_to_str(*b));
    return 0;
}
