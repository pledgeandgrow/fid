// CL10 (fid): stdlib/units.fd's units carry `@dimension(...)`, so `*` and
// `/` between two of them make the unit of the combined dimension through
// the type checker's dimension rule (Newtons * Meters is Joules) with no
// function per pair. The units' own `mul`/`div` by an f64 still win when
// the operand is an f64, and `+` keeps one unit.
// Expected output:
// 6
// 5
// 10
// 4
// 2
// 3
// 300
// 15
use units;

fn main() -> i64 {
    val w: Joules = newtons(2.0) * meters(3.0);
    println(int_to_str(w.value as i64));
    val v: MetersPerSecond = meters(100.0) / seconds(20.0);
    println(int_to_str(v.value as i64));
    val p: Watts = joules(50.0) / seconds(5.0);
    println(int_to_str(p.value as i64));
    val a: SquareMeters = meters(2.0) * meters(2.0);
    println(int_to_str(a.value as i64));
    val pa: Pascals = newtons(8.0) / a;
    println(int_to_str(pa.value as i64));
    val ratio: f64 = meters(9.0) / meters(3.0);
    println(int_to_str(ratio as i64));
    val scaled: Meters = meters(100.0) * 3.0;
    println(int_to_str(scaled.value as i64));
    val sum: Joules = w + w + joules(3.0);
    println(int_to_str(sum.value as i64));
    return 0;
}
