// D21 (docs/verification/miscompile-log.md; reference §4.6, decided
// Nov 17; repro tests/verify/bugs/d21_float_to_int_saturates.fd): a float
// cast to an integer type truncates toward zero, goes to the nearest end of
// the type's range when out of range (±∞ included), gives 0 for NaN and
// never panics. compiler/lower.fd Lowerer_lower_f2i_sat compares against
// the range and runs the backend's conversion only in range.
//
// Expected output:
// 9223372036854775807
// -9223372036854775808
// 9223372036854775807
// -9223372036854775808
// 0
// 255
// 0
// 2147483647
// -2147483648
// 200
// 127
// -128
// 65535
// 4294967295
// 0
// 5
// -7
// 0
// 0
// 3

fn main() -> i64 {
    val z: f64 = 0.0;
    val big: f64 = 1.0e300;
    val inf = 1.0 / z;
    val nan = z / z;
    println(big as i64);
    println((0.0 - big) as i64);
    println(inf as i64);
    println((0.0 - inf) as i64);
    println(nan as i64);
    val u: f64 = 300.7;
    val neg: f64 = -5.5;
    println(u as u8);
    println(neg as u8);
    println(3.0e9 as i32);
    println((0.0 - 3.0e9) as i32);
    val ok: f64 = 200.9;
    println(ok as u8);
    println(1000.0 as i8);
    println((0.0 - 1000.0) as i8);
    println(70000.0 as u16);
    println(1.0e12 as u32);
    println(nan as u32);
    println(5.9 as u64);
    println((0.0 - 7.9) as i64);
    println((0.0 - 0.5) as u8);
    println((0.0 - 3.0) as u64);
    // in a loop: the cast's blocks inside a loop body
    var n: i64 = 0;
    var i: i64 = 0;
    while i < 3 {
        val x: f64 = (i as f64) * 1.0e300;
        if (x as i32) == 2147483647 {
            n = n + 1;
        }
        i = i + 1;
    }
    println(n + 1);
    return 0;
}
