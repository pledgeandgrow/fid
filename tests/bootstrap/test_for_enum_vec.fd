// Known bug 2g.60: `for s in v` over a Vec of enums (or structs) gave the
// loop variable no payload under `fid run`: the loop's element is the
// address of the value held in the Vec's buffer (p_vec_get), and the
// interpreter stored that address into the loop variable instead of
// copying the value, as C does (compiler/interp.fd, Store). Every backend
// prints:
//   circle 3
//   rect 4 5
//   dot
//   circle 3
//   rect 4 5
//   dot
//   area sum 37
//   p 1 2
//   p 30 40
//   sum 73

enum Shape { Circle(i64), Rect(i64, i64), Dot }

struct Point { x: i64, y: i64 }

fn show(s: Shape) {
    match s {
        Shape::Circle(r) => {
            println("circle " + int_to_str(r));
        }
        Shape::Rect(w, h) => {
            println("rect " + int_to_str(w) + " " + int_to_str(h));
        }
        Shape::Dot => {
            println("dot");
        }
    }
}

fn area(s: Shape) -> i64 {
    match s {
        Shape::Circle(r) => {
            return r * r;
        }
        Shape::Rect(w, h) => {
            return w * h;
        }
        Shape::Dot => {
            return 8;
        }
    }
    return 0;
}

fn main() -> i64 {
    var v: Vec<Shape> = Vec::new();
    v.push(Shape::Circle(3));
    v.push(Shape::Rect(4, 5));
    v.push(Shape::Dot);
    var i: i64 = 0;
    while i < v.len() {
        show(v.get(i));
        i = i + 1;
    }
    for s in v {
        show(s);
    }
    var total: i64 = 0;
    for s2 in v {
        total = total + area(s2);
    }
    println("area sum " + int_to_str(total));
    var ps: Vec<Point> = Vec::new();
    ps.push(Point { x: 1, y: 2 });
    ps.push(Point { x: 30, y: 40 });
    var sum: i64 = 0;
    for p in ps {
        println("p " + int_to_str(p.x) + " " + int_to_str(p.y));
        sum = sum + p.x + p.y;
    }
    println("sum " + int_to_str(sum));
    return 0;
}
