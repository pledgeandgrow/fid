// Bugs roadmap BG426: `read_file` of a file holding a zero byte returned the
// text cut at the first zero on run, C and pe_ir (p_file_read handed a
// headerless buffer to p_str_own_c, which took its strlen); strings are
// counted (reference §1.8) and p_file_write writes the zero (BG81).
//
// Expected output:
// 5
// 5
// 99 100
fn main() {
    p_file_write("bg426_nul.dat", "ab\0cd");
    println(f"{p_file_size("bg426_nul.dat")}");
    match read_file("bg426_nul.dat") {
        Option::Some(s) => {
            println(f"{str_len(s)}");
            println(f"{str_byte_at(s, 3)} {str_byte_at(s, 4)}");
        }
        Option::None => {
            println("none");
        }
    }
    p_file_delete("bg426_nul.dat");
}
