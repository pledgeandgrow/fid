// expect-error: Taint error: function 'greet' is @tainted: its parameter 'name' reaches the sink 'println' (in 'greet')
// Roadmap Phase 12 (rm-P12): taint follows the value through variables,
// string building and reassignment into a sink.

fn greet(@tainted name: str) {
    val upper: str = str_to_upper(name);
    var msg: str = "hello ";
    msg = msg + upper;
    println(msg);
}

fn main() {
    greet("alice");
}
