// Roadmap L4F: with Crypto granted, the crypto module may be called; its own
// calls to each other (and to the OS random source) need nothing more.
// Expected output:
//   ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
//   16 random bytes
use core with { IO, Crypto }
use crypto

fn main() -> i64 {
    println(crypto_sha256_hex_str("abc"));
    val bytes = crypto_random_bytes(16);
    println(int_to_str(bytes.len()) + " random bytes");
    return 0;
}
