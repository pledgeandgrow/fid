// Capability test: effects propagate through call graph (Phase 2C)
// helper() calls print(), so helper() has IO effect.
// main() calls helper(), so main() requires IO capability.
// With IO granted, this should work.
use core with { IO }

fn helper() -> i64 {
    print("from helper");
    return 0;
}

fn main() -> i64 {
    val r = helper();
    return r;
}
