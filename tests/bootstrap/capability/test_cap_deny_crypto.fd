// expect-error: 'crypto_sha256_hex_str()' requires 'Crypto' capability
// Roadmap L4F: cryptography is gated by the Crypto capability. `with { IO }`
// makes the capabilities strict and grants only IO: calling into the
// crypto module is rejected, the print is not.
use core with { IO }
use crypto

fn main() -> i64 {
    val h = crypto_sha256_hex_str("abc");
    println(h);
    return 0;
}
