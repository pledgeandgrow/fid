// expect-error: 'p_os_random_u64()' requires 'Crypto' capability
// Roadmap L4F: the operating system's random source is cryptography too:
// called directly, it needs the Crypto capability.
use core with { IO }

fn main() -> i64 {
    val r = p_os_random_u64();
    if r == 0 {
        println("zero");
    }
    return 0;
}
