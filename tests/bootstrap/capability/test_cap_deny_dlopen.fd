// expect-error: 'p_dl_open()' requires 'FS' capability
// Roadmap L6C: loading a shared library reads a file, so p_dl_open needs
// the FS capability. `with { IO }` makes the capabilities strict and grants
// only IO: the load is rejected, the print is not.
use core with { IO }

fn main() -> i64 {
    val lib = p_dl_open("libm.so.6");
    print(lib);
    return 0;
}
