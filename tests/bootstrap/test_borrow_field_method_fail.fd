// expect-error: cannot mutate s.items: shared borrow(s) are active on it or its fields
// BG14: a changing method called through a field path was never checked:
// `s.items.push(2)` was accepted while `r` borrows s.items and is read
// afterwards.
struct Bag {
    items: Vec<i64>,
}

fn main() -> i64 {
    var s: Bag = Bag { items: Vec::new() };
    s.items.push(1);
    val r: &Vec<i64> = &s.items;
    s.items.push(2);
    println(int_to_str(r.len()));
    return 0;
}
