// BG209-BG211 (docs/roadmap/bugs-roadmap.md): ordinary f-strings print as
// before the fixes of lexer.fd read_fstring and parser.fd
// parse_fstring_parts: plain interpolation, format specs, nested braces
// (a block), nested calls and f-strings, `::` paths, escapes in the text.
//
// Expected output:
// 7
// x=7, s=hi
// 1.50
// [    7]
// [7    ]
// 0xff ff 101
// 7
// a5b
// 3
// 14
// 3
// quote "hi" end
// true -7
// hihi
// no braces
// 77
// 008
// **hi**
// a	b7
// back\slash 7
// }7
struct Pt {
    x: i64,
}

impl Pt {
    fn three() -> i64 {
        return 3;
    }
}

fn twice(n: i64) -> i64 {
    return n * 2;
}

fn main() -> i64 {
    val x: i64 = 7;
    val f: f64 = 1.5;
    val s: str = "hi";
    println(f"{x}");
    println(f"x={x}, s={s}");
    println(f"{f:.2}");
    println(f"[{x:5}]");
    println(f"[{x:<5}]");
    println(f"{255:#x} {255:x} {5:b}");
    println(f"{{x}}");
    println(f"a{ {5} }b");
    println(f"{str_len(int_to_str(x * 100))}");
    println(f"{twice(twice(x) / 2)}");
    println(f"{Pt::three()}");
    println(f"quote \"{s}\" end");
    println(f"{x > 3} {-x}");
    println(f"{s}{s}");
    println(f"no braces");
    println(f"{f"{x}{x}"}");
    println(f"{x + 1:03}");
    println(f"{s:*^6}");
    println(f"a\tb{x}");
    println(f"back\\slash {x}");
    println(f"}{x}");
    return 0;
}
