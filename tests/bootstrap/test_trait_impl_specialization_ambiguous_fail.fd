// expect-error: the call of method 'which' on Pair<i64, i64> is taken by two impls, neither more specific than the other: impl<B> Pair<i64, B> and impl<A> Pair<A, i64>
// L8H: for trait impls too, the most specific impl wins, and two impls of
// the trait for narrower types that both take the receiver, neither more
// specific than the other (one fixes the first argument, the other the
// second), make the call an error, not a choice by declaration order.
// Pair<str, i64> is taken by the generic impl and `impl<A> Which for
// Pair<A, i64>` only: no tie.

cap Which {
    fn which(self) -> str;
}

struct Pair<A, B> {
    a: A,
    b: B,
}

impl<A, B> Which for Pair<A, B> {
    fn which(self) -> str {
        return "general";
    }
}

impl<B> Which for Pair<i64, B> {
    fn which(self) -> str {
        return "first is i64";
    }
}

impl<A> Which for Pair<A, i64> {
    fn which(self) -> str {
        return "second is i64";
    }
}

fn main() -> i64 {
    val p: Pair<str, i64> = Pair { a: "x", b: 1 };
    println(p.which());
    val q: Pair<i64, i64> = Pair { a: 1, b: 2 };
    println(q.which());
    return 0;
}
