// Test: is type/variant check (Phase 7B — F11)
// expr is Type — compile-time type check
// expr is Variant — runtime enum tag check

use core;

fn check_option(x: Option) -> i64 {
    if x is Some {
        return 1;
    }
    if x is None {
        return 0;
    }
    return -1;
}

fn main() -> i64 {
    // Enum variant checks
    val a = Option::Some(42);
    val a_check = a is Some;
    print(a_check);
    print("\n");

    val b = Option::None;
    val b_check = b is None;
    print(b_check);
    print("\n");

    // Negated: not Some = None
    val not_some = !(a is Some);
    print(not_some);
    print("\n");

    // Using is in if condition
    val r1 = check_option(Option::Some(10));
    print(r1);
    print("\n");

    val r2 = check_option(Option::None);
    print(r2);
    print("\n");

    // Type checks (compile-time, always constant)
    val n = 42;
    val n_is_i64 = n is i64;
    print(n_is_i64);
    print("\n");

    val s = "hello";
    val s_is_str = s is str;
    print(s_is_str);
    print("\n");

    val flag = true;
    val flag_is_bool = flag is bool;
    print(flag_is_bool);
    print("\n");

    return 0;
}
