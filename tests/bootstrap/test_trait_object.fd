// Phase 3B.3 — Trait objects (dynamic dispatch).
// A dyn Trait value can hold any type that implements the trait,
// and method calls are dispatched at runtime.

cap Animal {
    fn sound(self) -> i64;
    fn legs(self) -> i64;
}

struct Dog {
    age: i64,
}

impl Animal for Dog {
    pub fn sound(self: Dog) -> i64 {
        return 1;
    }
    pub fn legs(self: Dog) -> i64 {
        return 4;
    }
}

struct Spider {
    venom: i64,
}

impl Animal for Spider {
    pub fn sound(self: Spider) -> i64 {
        return 2;
    }
    pub fn legs(self: Spider) -> i64 {
        return 8;
    }
}

// A function that takes a trait object and calls methods on it.
fn describe(a: dyn Animal) -> i64 {
    val s = a.sound();
    val l = a.legs();
    print(s);
    print(l);
    return s + l;
}

fn main() -> i64 {
    val d = Dog { age: 3 };
    val s = Spider { venom: 10 };

    // Cast concrete types to trait objects
    val da = d as dyn Animal;
    val sa = s as dyn Animal;

    // Call the same function with different types
    val r1 = describe(da);
    val r2 = describe(sa);

    print(r1);
    print(r2);

    return 0;
}
