// L8E: a pack (`...xs: T`) passed on whole as the last argument of another
// variadic function: `show_all("log", xs)` calls it with the pack's
// elements as its last arguments (mono.fd subst_expr, mono_pack_fwd_ok),
// whether that function takes a pack or a Vec variadic (`...ns: i64`).
//
// Expected output:
// log (3): int 1 str two yes
// log (0):
// 4
// 6
// 0

fn describe<T>(x: T) -> str {
    return "other";
}

fn describe(x: i64) -> str {
    return "int " + int_to_str(x);
}

fn describe(x: str) -> str {
    return "str " + x;
}

fn describe(x: bool) -> str {
    if x {
        return "yes";
    }
    return "no";
}

fn show_all<T>(label: str, ...xs: T) -> str {
    var out: str = label + " (" + int_to_str(xs.len()) + "):";
    for x in xs {
        out = out + " " + describe(x);
    }
    return out;
}

fn log_all<T>(...xs: T) -> str {
    return show_all("log", xs);
}

fn count<T>(...xs: T) -> i64 {
    return xs.len();
}

fn twice<T>(...xs: T) -> i64 {
    return count(xs) + count(xs);
}

fn add_all(...ns: i64) -> i64 {
    var t: i64 = 0;
    for n in ns {
        t = t + n;
    }
    return t;
}

fn total<T>(...xs: T) -> i64 {
    return add_all(xs);
}

fn main() -> i64 {
    println(log_all(1, "two", true));
    println(log_all());
    println(int_to_str(twice("a", 2)));
    println(int_to_str(total(1, 2, 3)));
    println(int_to_str(total()));
    return 0;
}
