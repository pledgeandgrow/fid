// Test (known-bugs 2f.11): a literal of a generic struct infers its type
// arguments from its fields; a field reads back with its instance type.
//
// Expected output:
// 1 one
// 3
// 2.5 two
struct Pair<A, B> { first: A, second: B }

fn swap_sum(p: Pair<i64, i64>) -> i64 { return p.first + p.second; }

fn main() -> i64 {
    val p = Pair { first: 1, second: "one" };
    println(int_to_str(p.first) + " " + p.second);
    val q: Pair<i64, i64> = Pair { first: 1, second: 2 };
    println(int_to_str(swap_sum(q)));
    val r = Pair { first: 2.5, second: "two" };
    println(float_to_str(r.first) + " " + r.second);
    return 0;
}
