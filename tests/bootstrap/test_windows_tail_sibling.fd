// test_windows_tail_sibling.fd — competitive OP13 on the default Windows
// backend (compiler/pe_ir.fd): `return g(x)` to another function whose
// arguments all go in registers, from a function whose frame no argument
// points into, is a jump to g (the frame goes first); g returns to our
// caller. Every backend prints the same. The depths stay small for the
// interpreter; scripts/pe-win-check.sh runs a 50-million-deep chain that
// only fits the stack because of the jumps.
//
// Expected output:
// true
// true
// 45150
// 4321
// 7

fn is_even(n: i64) -> bool {
    if n == 0 {
        return true;
    }
    return is_odd(n - 1);
}

fn is_odd(n: i64) -> bool {
    if n == 0 {
        return false;
    }
    return is_even(n - 1);
}

fn sum_to(n: i64, acc: i64) -> i64 {
    if n == 0 {
        return acc;
    }
    return step(n, acc);
}

fn step(n: i64, acc: i64) -> i64 {
    return sum_to(n - 1, acc + n);
}

fn four(a: i64, b: i64, c: i64, d: i64) -> i64 {
    return a * 1000 + b * 100 + c * 10 + d;
}

/// The arguments change places on the way: each is read before any is set.
fn shuffle(a: i64, b: i64, c: i64, d: i64) -> i64 {
    return four(d, c, b, a);
}

fn count_down(n: i64, seen: & mut Vec<i64>) -> i64 {
    seen.push(n);
    return n + 0;
}

/// A local's address goes to the call: this one stays a call.
fn keeps_frame(n: i64) -> i64 {
    var v: Vec<i64> = Vec::new();
    count_down(n, & mut v);
    return v.len() + 6;
}

fn main() {
    print(is_even(600));
    print("\n");
    print(is_odd(777));
    print("\n");
    print(sum_to(300, 0));
    print("\n");
    print(shuffle(1, 2, 3, 4));
    print("\n");
    print(keeps_frame(3));
    print("\n");
    return 0;
}
