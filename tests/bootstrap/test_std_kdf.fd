// stdlib/kdf: SHA-1 (FIPS 180 examples), HMAC-SHA1 (RFC 2202 cases 1-2),
// HKDF-SHA256 (RFC 5869 test cases 1-3) and HKDF-SHA512, PBKDF2-HMAC-SHA1
// (RFC 6070, c = 1, 2 and the long-password case), PBKDF2-HMAC-SHA256
// (RFC 7914 §11, first vector), PBKDF2-HMAC-SHA512, HMAC-SHA512 with a
// key longer than the block, scrypt (RFC 7914 §12 first vector, and a
// small N=32 r=2 p=2 case checked against Python's hashlib.scrypt).
// Expected output:
// sha1 abc a9993e364706816aba3e25717850c26c9cd0d89d
// sha1 empty da39a3ee5e6b4b0d3255bfef95601890afd80709
// sha1 448 84983e441c3bd26ebaae4aa1f95129e5e54670f1
// hmac-sha1 b617318655057264e28bc0b6fb378c8ef146be00
// hmac-sha1 effcdf6ae5eb2fa2d27416d5f184df9c259a7c79
// hkdf1 prk 077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5
// hkdf1 3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865
// hkdf2 b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87
// hkdf3 8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8
// hkdf512 832390086cda71fb47625bb5ceb168e4c8e26a1a16ed34d9fc7fe92c1481579338da362cb8d9f925d7cb
// pbkdf2-sha1 c1 0c60c80f961f0e71f3a9b524af6012062fe037a6
// pbkdf2-sha1 c2 ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957
// pbkdf2-sha1 long 8f2c3482e40bdbe537935153ef1692de0c7f4740bef78dd940
// pbkdf2-sha256 55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783
// pbkdf2-sha512 e1d9c16aa681708a45f5c7c4e215ceb66e011a2e9f0040713f18aefdb866d53cf76cab2868a39b9f7840edce4fef5a82be67335c77a6068e04112754f27ccf4e
// hmac-sha512 long key b5245971beb52a5a986812c4666a05c7
// scrypt1 77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906
// scrypt small b034a96734ebdc650fca132f40ffde0823c2f780d675eb81c85ec337d3b11760
// scrypt bad n 0
use kdf;
use vec;
use encoding;

fn hx(v: Vec<i64>) -> str { return hex_encode_bytes(v); }
fn hb(s: str) -> Vec<i64> { return hex_decode_bytes(s); }
fn sb(s: str) -> Vec<i64> { return str_bytes(s); }

fn rep(b: i64, n: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n { v.push(b); i = i + 1; }
    return v;
}

fn range(a: i64, b: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = a;
    while i < b { v.push(i); i = i + 1; }
    return v;
}

fn main() {
    println("sha1 abc " + hx(kdf_sha1(sb("abc"))));
    println("sha1 empty " + hx(kdf_sha1(Vec::new())));
    println("sha1 448 " + hx(kdf_sha1(sb("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))));
    println("hmac-sha1 " + hx(kdf_hmac_sha1(rep(11, 20), sb("Hi There"))));
    println("hmac-sha1 " + hx(kdf_hmac_sha1(sb("Jefe"), sb("what do ya want for nothing?"))));
    val prk: Vec<i64> = kdf_hkdf_extract(KDF_SHA256, range(0, 13), rep(11, 22));
    println("hkdf1 prk " + hx(prk));
    println("hkdf1 " + hx(kdf_hkdf_expand(KDF_SHA256, prk, range(240, 250), 42)));
    println("hkdf2 " + hx(kdf_hkdf(KDF_SHA256, range(96, 176), range(0, 80), range(176, 256), 82)));
    println("hkdf3 " + hx(kdf_hkdf(KDF_SHA256, Vec::new(), rep(11, 22), Vec::new(), 42)));
    println("hkdf512 " + hx(kdf_hkdf(KDF_SHA512, range(0, 13), rep(11, 22), range(240, 250), 42)));
    println("pbkdf2-sha1 c1 " + hx(kdf_pbkdf2(KDF_SHA1, sb("password"), sb("salt"), 1, 20)));
    println("pbkdf2-sha1 c2 " + hx(kdf_pbkdf2(KDF_SHA1, sb("password"), sb("salt"), 2, 20)));
    println("pbkdf2-sha1 long " + hx(kdf_pbkdf2(KDF_SHA1, sb("passwordPASSWORDpassword"), sb("saltSALTsaltSALTsaltSALTsaltSALTsalt"), 2, 25)));
    println("pbkdf2-sha256 " + hx(kdf_pbkdf2(KDF_SHA256, sb("passwd"), sb("salt"), 1, 64)));
    println("pbkdf2-sha512 " + hx(kdf_pbkdf2(KDF_SHA512, sb("password"), sb("salt"), 2, 64)));
    val mac: Vec<i64> = kdf_hmac_sha512(rep(107, 200), sb("msg"));
    var first: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 16 { first.push(mac.get(i)); i = i + 1; }
    println("hmac-sha512 long key " + hx(first));
    println("scrypt1 " + hx(kdf_scrypt(Vec::new(), Vec::new(), 16, 1, 1, 64)));
    println("scrypt small " + hx(kdf_scrypt(sb("password"), sb("NaCl"), 32, 2, 2, 32)));
    println("scrypt bad n " + int_to_str(kdf_scrypt(sb("p"), sb("s"), 24, 1, 1, 32).len()));
}
