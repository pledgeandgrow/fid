// stdlib/webrtc: SHA-1/HMAC-SHA1 (RFC 2202) and CRC-32 checks, the three RFC 5769 STUN test vectors decoded, verified and the request rebuilt byte for byte, message types, XOR addresses, a binding exchange, ICE candidate parsing, priorities and pairing, an SDP offer parsed and answered; then two peer connections in memory (OpenSSL-made P-256 certificates): offer/answer, ICE checks, DTLS, SRTP media both ways, close; with lost datagrams; blocked (ICE fails); a wrong fingerprint (DTLS fails). The DTLS part needs P-256, too slow for the interpreter (docs/stdlib-agent-bugs.md 20, 51): run it through the C backend.
// Expected output:
// sha1 abc: a9993e364706816aba3e25717850c26c9cd0d89d
// hmac rfc2202 #1: b617318655057264e28bc0b6fb378c8ef146be00
// hmac rfc2202 #2: effcdf6ae5eb2fa2d27416d5f184df9c259a7c79
// hmac long key: aa4ae5e15272d00e95705637ce8a3b55ed402112
// crc32: cbf43926
// request: ok true method 1 class 0 user evtj:h6vY software STUN test client priority 6e0001ff controlled 932ff9b151263b36
//   integrity true wrong key false fingerprint true
//   rebuilt same: true
// ipv4 response: class 2 mapped 192.0.2.1:32853 integrity true fingerprint true
// ipv6 response: mapped [2001:db8:1234:5678:11:2233:4455:6677]:32853 integrity true fingerprint true
// tampered: integrity false fingerprint false
// not stun: false, bad length: bad length
// types: 1 11 101 111 allocate-error 113
// ip: 2001:db8::1 fe80:0:0:1:: ::1 2001:db8:0:1::1
// error response: 487 Role Conflict, checks true
// check: 104 bytes, integrity true use-candidate true controlling true
// response: same txid true mapped 203.0.113.7:54321 checks true
// candidate: ok true srflx 198.51.100.4:46154 base 192.168.1.10:46154 ext [generation 0 network-cost 999]
//   back: candidate:842163049 1 udp 1677729535 198.51.100.4 46154 typ srflx raddr 192.168.1.10 rport 46154 generation 0 network-cost 999
//   bad: false
// priority: host 2130706431 srflx 1694498815 relay rtcp 16777214
// pair: 7277816997797167103 7277816997797167102
// pairs: 5
//   1:a 192.168.1.10 -> 10.0.0.5 9151314442783293438
//   3:c 2001:db8::10 -> 2001:db8::99 9115038255631187454
//   1:b 192.168.1.10 -> 192.0.2.9 7277816997797167103
//   4:a 203.0.113.50 -> 10.0.0.5 72057594004373502
//   4:b 203.0.113.50 -> 192.0.2.9 72057593131958270
// offer: ok true 3 sections, bundle BUNDLE 0 1 2, round trip same true
//   audio mid 0 sendrecv ufrag EsAw codecs 111 opus/48000/2, 103 ISAC/16000, 0 PCMU/8000 candidates 1
//   video mid 1 sendonly ufrag EsAw codecs 96 VP8/90000, 98 VP9/90000 candidates 0
//   application mid 2 sendrecv ufrag  codecs webrtc-datachannel  candidates 0
//   first candidate: 192.168.1.10:46154 host
// | v=0
// | o=- 99 1 IN IP4 127.0.0.1
// | s=-
// | t=0 0
// | a=group:BUNDLE 0 1 2
// | a=msid-semantic: WMS stream
// | m=audio 9 UDP/TLS/RTP/SAVPF 111 0
// | c=IN IP4 0.0.0.0
// | a=ice-ufrag:Ufr4
// | a=ice-pwd:an-answer-password-22c
// | a=fingerprint:sha-256 AB:CD
// | a=setup:active
// | a=mid:0
// | a=sendrecv
// | a=rtcp-mux
// | a=rtpmap:111 opus/48000/2
// | a=fmtp:111 minptime=10;useinbandfec=1
// | a=rtpmap:0 PCMU/8000
// | m=video 9 UDP/TLS/RTP/SAVPF 98
// | c=IN IP4 0.0.0.0
// | a=ice-ufrag:Ufr4
// | a=ice-pwd:an-answer-password-22c
// | a=fingerprint:sha-256 AB:CD
// | a=setup:active
// | a=mid:1
// | a=recvonly
// | a=rtcp-mux
// | a=rtpmap:98 VP9/90000
// | a=fmtp:98 profile-id=0
// | m=application 9 UDP/DTLS/SCTP webrtc-datachannel
// | c=IN IP4 0.0.0.0
// | a=ice-ufrag:Ufr4
// | a=ice-pwd:an-answer-password-22c
// | a=fingerprint:sha-256 AB:CD
// | a=setup:active
// | a=mid:2
// | a=sctp-port:5000
// nothing in common: ports 0 0 0, bundle false
// bad sdp: bad line: hello; no v= line
// peer offer: setup actpass, fingerprint of a true, codecs 111 opus/48000/2, 0 PCMU/8000, candidate 1 1 udp 2130706431 10.0.0.1 5000 typ host
// peer answer: setup active, fingerprint of b true, codecs 111 opus/48000/2, 0 PCMU/8000, candidate 1 1 udp 2130706431 10.0.0.2 6000 typ host
// a: new > checking > connected (ice controlling, dtls server)
// b: new > checking > connected (ice controlled, dtls client)
// selected: 10.0.0.1:5000 -> 10.0.0.2:6000 and 10.0.0.2:6000 -> 10.0.0.1:5000, srtp SRTP_AEAD_AES_128_GCM
// media: a->b rtp same true, b->a rtp same true, a->b rtcp same true, encrypted on the wire true
// close: a new > checking > connected > closed; b new > checking > connected > closed
// lossy: a new > checking > connected, b new > checking > connected, dropped 6, checks sent 1/3, dtls retransmissions 2/4
// blocked: a new > checking > failed (ICE failed: no candidate pair answered), b new > checking > failed, after 19550 ms, 7 checks each way true
// bad fingerprint: a new > checking > failed (DTLS: certificate fingerprint does not match), b new > checking > failed (DTLS: alert 42 from peer)
use dtls;
use encoding;
use srtp;
use string;
use vec;
use webrtc;

fn hb(h: str) -> Vec<i64> {
    return hex_decode_bytes(h);
}

fn hx(v: Vec<i64>) -> str {
    return hex_encode_bytes(v);
}

