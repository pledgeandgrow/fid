// expect-error: Hermetic error: 'test_load' is @hermetic but reaches files directly: 'read_file' calls 'p_file_read' (effect IO), on the path test_load -> load_config -> read_file
// Complaint CT1: a @hermetic test may reach the files only through what
// stdlib/world fakes. `load_config` reads its file with core's read_file,
// a direct runtime call (p_file_read) that no fake can replace: under
// world_hermetic() it would still read the real disk. The error names the
// call and the path to it; fs_read_text (which consults stdlib/world)
// would be accepted.
use world;

fn load_config(path: str) -> str {
    match read_file(path) {
        Option::Some(s) => {
            return s;
        }
        Option::None => {
            return "";
        }
    }
    return "";
}

@hermetic
fn test_load() -> i64 {
    world_hermetic();
    world_file_put("app.cfg", "level=3\n");
    println(load_config("app.cfg"));
    return 0;
}

fn main() -> i64 {
    return test_load();
}
