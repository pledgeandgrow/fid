// stdlib/test: the runner counters, every assertion helper on a passing
// and a failing input (the failing ones print their message and return
// false), and the summary output. The two abort helpers are only called
// with true conditions, since a failure would panic.
use test;

fn main() -> i64 {
    var r = test_runner_new();
    println(r.passed);
    println(r.failed);
    println(test_all_passed(r));

    test_begin(&mut r, "counters");
    println(r.current_test);
    test_pass(&mut r);
    test_pass(&mut r);
    test_fail(&mut r, "boom");
    println(r.passed);
    println(r.failed);
    println(test_all_passed(r));

    // integer comparisons
    println(test_assert_eq(3, 3, "eq ok"));
    println(test_assert_eq(3, 4, "eq bad"));
    println(test_assert_ne(3, 4, "ne ok"));
    println(test_assert_ne(5, 5, "ne bad"));
    println(test_assert_gt(5, 4, "gt ok"));
    println(test_assert_gt(4, 4, "gt bad"));
    println(test_assert_lt(4, 5, "lt ok"));
    println(test_assert_lt(5, 5, "lt bad"));
    println(test_assert_in_range(5, 5, 9, "range low edge"));
    println(test_assert_in_range(9, 5, 9, "range high edge"));
    println(test_assert_in_range(10, 5, 9, "range bad"));
    println(test_assert_in_range(4, 5, 9, "range below"));

    // booleans
    println(test_assert_true(true, "true ok"));
    println(test_assert_true(false, "true bad"));
    println(test_assert_false(false, "false ok"));
    println(test_assert_false(true, "false bad"));

    // floats: within epsilon in either direction
    println(test_assert_approx_eq(1.0, 1.05, 0.1, "approx ok"));
    println(test_assert_approx_eq(1.05, 1.0, 0.1, "approx ok reversed"));
    println(test_assert_approx_eq(1.0, 2.0, 0.1, "approx bad"));

    // strings
    println(test_assert_str_eq("abc", "abc", "str ok"));
    println(test_assert_str_eq("abc", "abd", "str bad"));
    println(test_assert_str_eq("", "", "empty strings"));

    // vectors
    var v: Vec<i64> = Vec::new();
    println(test_assert_empty(v, "empty ok"));
    println(test_assert_len(v, 0, "len 0"));
    v.push(7);
    v.push(8);
    println(test_assert_empty(v, "empty bad"));
    println(test_assert_len(v, 2, "len ok"));
    println(test_assert_len(v, 3, "len bad"));
    println(test_assert_contains(v, 8, "contains ok"));
    println(test_assert_contains(v, 9, "contains bad"));

    test_assert_or_abort(true, "never printed");
    test_assert_eq_or_abort(2, 2, "never printed");

    test_summary(r);
    var clean = test_runner_new();
    test_pass(&mut clean);
    test_summary(clean);
    println(test_all_passed(clean));
    return 0;
}
