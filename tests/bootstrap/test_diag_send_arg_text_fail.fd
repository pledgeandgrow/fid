// expect-error: is not @send. Only @send types can be safely sent through channels.
// expect-error: Fix: add @send to the struct definition, or send only
// Expected to FAIL (CE4): a value sent on a channel crosses threads, so its
// type must be @send; a reference is not (its referent may be freed on the
// other thread). The whole message, its explanation and Fix line included
// (test_send_fail.fd checks its first line).
fn main() -> i64 {
    val x: i64 = 42;
    val r = &x;
    val ch = p_chan_create(10);
    p_chan_send(ch, r);
    println(p_chan_recv(ch));
    return 0;
}
