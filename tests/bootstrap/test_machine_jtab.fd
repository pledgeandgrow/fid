// MI27 (docs/roadmap/llvm-roadmap.md): jump tables for dense `match`. A
// Switch (ME28, compiler/ir.fd) whose keys fill at least 40% of their span
// (4 keys or more, a span of at most 1024, not a case the bit tests cover)
// is one bounds check and one indirect jump through a table of 4-byte
// self-relative entries on the machine layer (compiler/nat_ir.fd
// ng_jt_span, ng_gen_jtab, ng_jtab_emit; MO_JTAB / MO_JTE in
// compiler/mir.fd; NATFIX_SELF32 in nat_enc.fd). Covered: a table from 0,
// one from a positive base with holes (the default), one from a negative
// base, values below, inside and above the range and the extreme i64
// values (the bounds check is unsigned after the subtraction), enum tags,
// a value live across the table into the arms and after them, a table in
// a loop, arms that share a block, a larger table (64 entries); and for
// comparison a sparse switch (the tree) and one the bit tests take.
// Native check: tests/nattools/machine_jtab_check.sh (x86-64, AArch64,
// RISC-V, --nat Windows; FID_NAT_OFF=jtab and FID_SWITCH=off print the
// same; FID_VERIFY=1; the dispatch is in the MIR dump and the binary).
// Expected output:
// zero one two three four five six seven eight nine ? ?
// 110 111 0 113 114 0 116 117 0
// -50 -40 -30 -20 -10 0 10 0
// 0 0 0 0
// 3 1 4 1 5 9 2 6
// 1359
// 17 144 30 27 0
// 1 2 2 3 3 3 0
// 0 64 4096 9
// 7 1 1 0 0
// 4 4 4 0 0

enum Op {
    Add,
    Sub,
    Mul,
    Div,
    Neg,
    Abs,
    Min,
    Max,
}

fn digit_name(d: i64) -> str {
    match d {
        0 => {
            return "zero";
        }
        1 => {
            return "one";
        }
        2 => {
            return "two";
        }
        3 => {
            return "three";
        }
        4 => {
            return "four";
        }
        5 => {
            return "five";
        }
        6 => {
            return "six";
        }
        7 => {
            return "seven";
        }
        8 => {
            return "eight";
        }
        9 => {
            return "nine";
        }
        _ => {
            return "?";
        }
    }
    return "!";
}

// keys 10..17 with holes at 12, 15 (the default)
fn holes(k: i64) -> i64 {
    match k {
        10 => {
            return 110;
        }
        11 => {
            return 111;
        }
        13 => {
            return 113;
        }
        14 => {
            return 114;
        }
        16 => {
            return 116;
        }
        17 => {
            return 117;
        }
        _ => {
            return 0;
        }
    }
    return 0 - 1;
}

// a negative base (an if/else-if chain on one value is a Switch too)
fn neg_base(n: i64) -> i64 {
    if n == 0 - 5 {
        return 0 - 50;
    } else if n == 0 - 4 {
        return 0 - 40;
    } else if n == 0 - 3 {
        return 0 - 30;
    } else if n == 0 - 2 {
        return 0 - 20;
    } else if n == 0 - 1 {
        return 0 - 10;
    } else if n == 0 {
        return 0;
    } else if n == 1 {
        return 10;
    }
    return 0;
}

fn apply(op: Op, a: i64, b: i64) -> i64 {
    match op {
        Op::Add => {
            return a + b;
        }
        Op::Sub => {
            return a - b;
        }
        Op::Mul => {
            return a * b;
        }
        Op::Div => {
            return a / b;
        }
        Op::Neg => {
            return 0 - a;
        }
        Op::Abs => {
            if a < 0 {
                return 0 - a;
            }
            return a;
        }
        Op::Min => {
            if a < b {
                return a;
            }
            return b;
        }
        Op::Max => {
            if a > b {
                return a;
            }
            return b;
        }
    }
    return 0;
}

// `base` and `scale` live across the table into every arm and after it
fn live_across(k: i64, base: i64, scale: i64) -> i64 {
    var r: i64 = 0;
    match k {
        1 => {
            r = base + 1;
        }
        2 => {
            r = base * 2;
        }
        3 => {
            r = base - 3;
        }
        4 => {
            r = scale;
        }
        5 => {
            r = base + scale;
        }
        _ => {
            r = 0;
        }
    }
    return r * scale + base;
}

// arms sharing a block: 1 -> 1, 2 and 3 -> 2, 4..6 -> 3 (6 keys, 3 blocks,
// span 6: the bit tests take it; 7 and 8 -> 4 make it 4 blocks: a table)
fn grouped(k: i64) -> i64 {
    if k == 1 {
        return 1;
    } else if k == 2 || k == 3 {
        return 2;
    } else if k == 4 || k == 5 || k == 6 {
        return 3;
    } else if k == 7 || k == 8 {
        return 4;
    }
    return 0;
}

// sparse: the tree of compares (no table)
fn sparse(k: i64) -> i64 {
    match k {
        1 => {
            return 1;
        }
        100 => {
            return 2;
        }
        1000 => {
            return 3;
        }
        10000 => {
            return 4;
        }
        _ => {
            return 0;
        }
    }
    return 0 - 1;
}

// three blocks within 64 values: the bit tests (no table)
fn bits3(k: i64) -> i64 {
    match k {
        1 => {
            return 7;
        }
        3 => {
            return 1;
        }
        5 => {
            return 1;
        }
        9 => {
            return 0;
        }
        _ => {
            return 0;
        }
    }
    return 0 - 1;
}

// 64 entries: the low six bits picked out one by one
fn wide64(k: i64) -> i64 {
    if k == 0 {
        return 0;
    } else if k == 1 {
        return 1;
    } else if k == 2 {
        return 4;
    } else if k == 3 {
        return 9;
    } else if k == 4 {
        return 16;
    } else if k == 5 {
        return 25;
    } else if k == 6 {
        return 36;
    } else if k == 7 {
        return 49;
    } else if k == 8 {
        return 64;
    } else if k == 16 {
        return 256;
    } else if k == 24 {
        return 576;
    } else if k == 32 {
        return 1024;
    } else if k == 40 {
        return 1600;
    } else if k == 48 {
        return 2304;
    } else if k == 56 {
        return 3136;
    } else if k == 63 {
        return 3969;
    } else if k == 60 {
        return 3600;
    } else if k == 50 {
        return 2500;
    } else if k == 30 {
        return 900;
    } else if k == 20 {
        return 400;
    } else if k == 10 {
        return 100;
    } else if k == 12 {
        return 144;
    } else if k == 14 {
        return 196;
    } else if k == 18 {
        return 324;
    } else if k == 22 {
        return 484;
    } else if k == 26 {
        return 676;
    } else if k == 28 {
        return 784;
    } else if k == 34 {
        return 1156;
    } else if k == 36 {
        return 1296;
    } else if k == 38 {
        return 1444;
    } else if k == 42 {
        return 1764;
    } else if k == 44 {
        return 1936;
    }
    return 9;
}

fn main() -> i64 {
    var line: str = "";
    var d: i64 = 0;
    while d < 12 {
        if d > 0 {
            line = line + " ";
        }
        line = line + digit_name(d);
        d = d + 1;
    }
    println(line);
    line = "";
    var k: i64 = 10;
    while k <= 18 {
        if k > 10 {
            line = line + " ";
        }
        if k == 18 {
            line = line + int_to_str(holes(12));
        } else {
            line = line + int_to_str(holes(k));
        }
        k = k + 1;
    }
    println(line);
    line = "";
    k = 0 - 5;
    while k <= 2 {
        if k > 0 - 5 {
            line = line + " ";
        }
        line = line + int_to_str(neg_base(k));
        k = k + 1;
    }
    println(line);
    // far outside every range: below, above, the extreme values
    val lo: i64 = 0 - 9223372036854775807 - 1;
    val hi: i64 = 9223372036854775807;
    println(int_to_str(holes(lo)) + " " + int_to_str(holes(hi)) + " " + int_to_str(neg_base(lo)) + " " + int_to_str(neg_base(hi)));
    // enum tags
    line = int_to_str(apply(Op::Add, 1, 2)) + " " + int_to_str(apply(Op::Sub, 5, 4)) + " " + int_to_str(apply(Op::Mul, 2, 2)) + " " + int_to_str(apply(Op::Div, 7, 7));
    line = line + " " + int_to_str(apply(Op::Neg, 0 - 5, 0)) + " " + int_to_str(apply(Op::Abs, 0 - 9, 0)) + " " + int_to_str(apply(Op::Min, 2, 8)) + " " + int_to_str(apply(Op::Max, 6, 1));
    println(line);
    var i: i64 = 0;
    // a table in a loop, the sum live across it
    var sum: i64 = 0;
    i = 0;
    while i < 30 {
        sum = sum + live_across(i % 7, i, 3);
        i = i + 1;
    }
    println(int_to_str(sum));
    println(int_to_str(live_across(1, 5, 2)) + " " + int_to_str(live_across(4, 0, 12)) + " " + int_to_str(live_across(2, 6, 2)) + " " + int_to_str(live_across(3, 15, 1)) + " " + int_to_str(live_across(9, 0, 7)));
    line = "";
    k = 1;
    while k <= 7 {
        if k > 1 {
            line = line + " ";
        }
        if k == 7 {
            line = line + int_to_str(grouped(0));
        } else {
            line = line + int_to_str(grouped(k));
        }
        k = k + 1;
    }
    println(line);
    println(int_to_str(wide64(0)) + " " + int_to_str(wide64(8)) + " " + int_to_str(wide64(64) + wide64(33) + 4078) + " " + int_to_str(wide64(0 - 1)));
    println(int_to_str(bits3(1)) + " " + int_to_str(bits3(3)) + " " + int_to_str(bits3(5)) + " " + int_to_str(bits3(9)) + " " + int_to_str(bits3(2)));
    println(int_to_str(sparse(10000)) + " " + int_to_str(grouped(7)) + " " + int_to_str(grouped(8)) + " " + int_to_str(sparse(5)) + " " + int_to_str(grouped(9)));
    return 0;
}
