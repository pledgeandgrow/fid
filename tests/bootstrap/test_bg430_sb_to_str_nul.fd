// Bugs roadmap BG430: on pe_ir (`emit`) `StringBuilder.to_str()` stopped at
// the first zero byte: pert_sb_to_str (stdlib/pe_runtime/base.fd) handed a
// plain buffer to p_str_adopt, which measured it up to its NUL, so
// `str_len(sb.to_str())` was 3 where `sb.len()` was 8. It now makes a
// counted string of the whole length, as run, C and the machine layer do.
//
// Expected output:
// 8 8
// 121 45
// 0 0

fn main() {
    var sb = StringBuilder::new();
    sb.append_str("ab");
    sb.append_str("x\0y");
    sb.append_int(-12);
    val s: str = sb.to_str();
    println(f"{sb.len()} {str_len(s)}");
    println(f"{str_byte_at(s, 4)} {str_byte_at(s, 5)}");
    var e = StringBuilder::new();
    val t: str = e.to_str();
    println(f"{e.len()} {str_len(t)}");
}
