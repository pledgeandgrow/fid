// Test: @conserve with Money_take (split), Money_cents (read through a
// borrow) and Money_add (merge): the total is kept.
//
// Expected output:
// 70 30
// 100
use money;

@conserve
fn pay(from: &mut Money, cents: i64) -> Money {
    return Money_take(from, cents);
}

@conserve
fn rejoin(a: Money, b: Money) -> Money {
    return Money_add(a, b);
}

fn main() -> i64 {
    var purse = Money_new(100);
    val paid = pay(&mut purse, 30);
    println(int_to_str(Money_cents(&purse)) + " " + int_to_str(Money_cents(&paid)));
    val all = rejoin(purse, paid);
    println(int_to_str(Money_to_cents(all)));
    return 0;
}
