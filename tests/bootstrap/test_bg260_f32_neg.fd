// Bugs roadmap BG260: pe_ir negated an f32 by flipping bit 63 (the f64
// sign bit), so `-x` of an f32 kept its sign: `-2.0` gave 2 and
// `1.0 / -0.0` gave inf on `fid emit`.
//
// Expected output:
// neg -2
// -inf
// 3.5
// -1.25
fn idf(x: f32) -> f32 {
    return x;
}
fn main() {
    val neg: f32 = -idf(2.0);
    println(f"neg {neg}");
    val nz: f32 = -idf(0.0);
    println(f"{idf(1.0) / nz}");
    val back: f32 = -(-idf(3.5));
    println(f"{back}");
    val m: f32 = idf(1.25);
    val nm: f32 = -m;
    println(f"{nm}");
}
