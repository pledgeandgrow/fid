// expect-error: matmul: inner dimension mismatch
// test_shape_verify_fail.fd — ML2: Shape mismatch is a compile error
// Expected: FAIL (compile error — matmul shape mismatch)
// matmul(A, B) requires A's last dim == B's first dim.
// Here: A is 2x3, B is 2x3 — 3 != 2, so matmul is incompatible.

use tensor;

fn main() {
    val shape_2x3 = Vec::new();
    shape_2x3.push(2); shape_2x3.push(3);
    val a_data = Vec::new();
    a_data.push(1); a_data.push(2); a_data.push(3);
    a_data.push(4); a_data.push(5); a_data.push(6);
    val a = from_vec(a_data, shape_2x3);

    val b_data = Vec::new();
    b_data.push(1); b_data.push(2); b_data.push(3);
    b_data.push(4); b_data.push(5); b_data.push(6);
    val b = from_vec(b_data, shape_2x3);

    // ERROR: matmul(2x3, 2x3) — 3 != 2
    val c = matmul(a, b);
    print(to_str(c));

    return 0;
}
