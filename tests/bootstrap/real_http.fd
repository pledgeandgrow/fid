// Test: real HTTP server using sockets
use http;
use json;

fn main() {
    // Test JSON parsing (real implementation)
    val parsed = json_parse("{\"name\":\"fides\",\"version\":42}");
    val name = json_get(parsed, "name");
    print("JSON name: " + name + "\n");

    val version = json_get(parsed, "version");
    print("JSON version: " + version + "\n");

    // Test HTTP response building (real implementation)
    val resp = build_response(200, "text/plain", "Hello from Fides!");
    print("HTTP response built, length: ");
    println(str_len(resp));

    // Test HTTP request parsing
    val req = "GET /api HTTP/1.1\r\nHost: localhost\r\n\r\n";
    val parsed_req = parse_request(req);
    print("Parsed request: " + parsed_req + "\n");

    // Test status text
    val s200 = status_text(200);
    print("Status 200: " + s200 + "\n");

    val s404 = status_text(404);
    print("Status 404: " + s404 + "\n");

    print("HTTP test passed!\n");
    return 0;
}
