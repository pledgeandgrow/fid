// expect-error: 'p_system()' does I/O
// CD8 (complaint roadmap): a `comptime fn` is comptime code: it may not run
// a process (a build script in disguise), even when the call to it is not
// written in a comptime block.

comptime fn git_revision() -> i64 {
    return p_system("git rev-parse HEAD");
}

fn main() -> i64 {
    val r = comptime git_revision();
    println(int_to_str(r));
    return 0;
}
