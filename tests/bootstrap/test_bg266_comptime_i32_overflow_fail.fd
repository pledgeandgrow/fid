// expect-error: 50000 * 50000 does not fit in i32
// Bugs roadmap BG266: comptime arithmetic on i32 was checked at 64 bits, so
// `comptime f(50000)` with `x * x` gave 2500000000 (at run time the same
// call panics "Integer overflow on multiplication"); reference §4.11:
// comptime overflow is an error.
comptime fn f(x: i32) -> i32 {
    return x * x;
}
fn main() -> i64 {
    val a = comptime f(50000);
    println(a);
    return 0;
}
