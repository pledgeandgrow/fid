// expect-error: Visibility error: type 'PrivAlias' is private to module
// Bugs roadmap BG292: a type alias without `pub` cannot be named from
// another module; before, `val z: PrivAlias = 3` compiled.
use vis_lib::vmod;

fn main() -> i64 {
    val z: PrivAlias = 3;
    println(z);
    return 0;
}
