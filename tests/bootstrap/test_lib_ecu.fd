// stdlib/ecu: state names, sensor readings and range validation, ADC
// scaling, actuator clamping and rate limits, the PID controller (gains,
// anti-windup, output limits, reset), calibration parameters and the
// watchdog. Every value is a binary fraction so floats print exactly.
use ecu;

fn main() -> i64 {
    println(ecu_state_name(ECU_STATE_INIT));
    println(ecu_state_name(ECU_STATE_RUN));
    println(ecu_state_name(ECU_STATE_SHUTDOWN));
    println(ecu_state_name(ECU_STATE_FAULT));
    println(ecu_state_name(ECU_STATE_LIMP_HOME));
    println(ecu_state_name(9));

    // sensors
    var ok = sensor_ok(21.5, 215, 1000);
    println(ok.is_valid);
    println(ok.value);
    println(ok.raw_value);
    println(ok.timestamp);
    println(ok.error_code);
    var bad = sensor_fault(7, 2000);
    println(bad.is_valid);
    println(bad.error_code);
    println(bad.value);
    // validate: inside the range is unchanged, the ends count as inside
    println(sensor_validate(ok, 0.0, 50.0).is_valid);
    println(sensor_validate(ok, 21.5, 21.5).is_valid);
    var low = sensor_validate(ok, 30.0, 50.0);
    println(low.is_valid);
    println(low.error_code);
    println(low.value);
    println(low.raw_value);
    println(low.timestamp);
    println(sensor_validate(ok, 0.0, 10.0).is_valid);
    // an invalid reading keeps its own error code
    var kept = sensor_validate(bad, 0.0, 50.0);
    println(kept.is_valid);
    println(kept.error_code);

    // ADC counts to engineering units: 0..1024 -> -40..60
    println(sensor_raw_to_value(0, 0, 1024, -40.0, 60.0));
    println(sensor_raw_to_value(512, 0, 1024, -40.0, 60.0));
    println(sensor_raw_to_value(1024, 0, 1024, -40.0, 60.0));
    println(sensor_raw_to_value(256, 0, 1024, 0.0, 100.0));
    println(sensor_raw_to_value(2048, 0, 1024, 0.0, 100.0));
    println(sensor_raw_to_value(-1024, 0, 1024, 0.0, 100.0));
    println(sensor_raw_to_value(300, 200, 400, 0.0, 8.0));
    // reversed engineering range
    println(sensor_raw_to_value(512, 0, 1024, 10.0, 0.0));
    // an empty raw range gives the lower engineering limit
    println(sensor_raw_to_value(5, 7, 7, 1.5, 9.0));

    // actuator clamping
    var a1 = actuator_command(50.0, 0.0, 100.0);
    println(a1.value);
    println(a1.clamped);
    var a2 = actuator_command(150.0, 0.0, 100.0);
    println(a2.value);
    println(a2.clamped);
    println(a2.limited);
    var a3 = actuator_command(-5.0, 0.0, 100.0);
    println(a3.value);
    println(a3.clamped);
    println(actuator_command(100.0, 0.0, 100.0).clamped);
    // rate limit: move at most max_rate per step
    println(actuator_rate_limit(10.0, 0.0, 2.0));
    println(actuator_rate_limit(-10.0, 0.0, 2.0));
    println(actuator_rate_limit(1.0, 0.0, 2.0));
    println(actuator_rate_limit(-1.0, 0.0, 2.0));
    println(actuator_rate_limit(5.0, 3.0, 2.0));
    println(actuator_rate_limit(2.0, 3.0, 2.0));

    // PID: kp 2, ki 1, kd 0.5, step 0.5 s, setpoint 10
    var pid = pid_new(2.0, 1.0, 0.5);
    println(pid.output_min);
    println(pid.output_max);
    // error 4: integral 2, derivative 8 -> 8 + 2 + 4
    println(pid_compute(&mut pid, 10.0, 6.0, 0.5));
    println(pid.integral);
    println(pid.prev_error);
    // error 2: integral 3, derivative -4 -> 4 + 3 - 2
    println(pid_compute(&mut pid, 10.0, 8.0, 0.5));
    println(pid.integral);
    // reset clears the memory
    pid_reset(&mut pid);
    println(pid.integral);
    println(pid.prev_error);
    println(pid_compute(&mut pid, 10.0, 6.0, 0.5));
    // dt = 0: no derivative, no integral growth
    pid_reset(&mut pid);
    println(pid_compute(&mut pid, 10.0, 6.0, 0.0));
    println(pid.integral);
    // output limits
    pid_reset(&mut pid);
    pid_set_limits(&mut pid, -5.0, 10.0);
    println(pid_compute(&mut pid, 10.0, 6.0, 0.5));
    pid_reset(&mut pid);
    println(pid_compute(&mut pid, -10.0, 6.0, 0.5));
    // anti-windup: the integral stops at its limit
    pid_reset(&mut pid);
    pid_set_limits(&mut pid, -1000.0, 1000.0);
    pid_set_integral_limits(&mut pid, -3.0, 3.0);
    pid_compute(&mut pid, 100.0, 0.0, 1.0);
    println(pid.integral);
    pid_compute(&mut pid, 100.0, 0.0, 1.0);
    println(pid.integral);
    pid_compute(&mut pid, -100.0, 0.0, 1.0);
    pid_compute(&mut pid, -100.0, 0.0, 1.0);
    pid_compute(&mut pid, -100.0, 0.0, 1.0);
    println(pid.integral);

    // calibration parameters clamp to their range
    var cp = cal_param_new("idle_rpm", 800.0, 600.0, 1200.0, "rpm");
    println(cp.name);
    println(cp.unit);
    println(cal_param_get(cp));
    println(cal_param_is_valid(cp));
    cal_param_set(&mut cp, 1000.0);
    println(cal_param_get(cp));
    cal_param_set(&mut cp, 5000.0);
    println(cal_param_get(cp));
    cal_param_set(&mut cp, 0.0);
    println(cal_param_get(cp));
    println(cal_param_is_valid(cp));
    cp.value = 50.0;
    println(cal_param_is_valid(cp));

    // watchdog: expires only when the timeout is passed
    var wd = watchdog_new(100);
    println(wd.timeout_ms);
    println(watchdog_is_expired(wd));
    watchdog_kick(&mut wd, 1000);
    println(watchdog_check(&mut wd, 1050));
    println(watchdog_check(&mut wd, 1100));
    println(watchdog_check(&mut wd, 1101));
    println(watchdog_is_expired(wd));
    // once expired it stays expired until it is kicked
    println(watchdog_check(&mut wd, 1102));
    watchdog_kick(&mut wd, 1200);
    println(watchdog_is_expired(wd));
    println(watchdog_check(&mut wd, 1250));
    return 0;
}
