// expect-error: Serverless error: @serverless handler 'handle_request' starts a background task (in 'handle_request')
// Roadmap Phase 9 (F32): once a serverless handler returns, its instance
// can be frozen, so a task it started may never finish.

fn send_metrics(n: i64) -> i64 {
    return n + 1;
}

@serverless
fn handle_request(n: i64) -> i64 {
    val t = spawn send_metrics(n);
    return n * 2;
}

fn main() {
    println(int_to_str(handle_request(4)));
}
