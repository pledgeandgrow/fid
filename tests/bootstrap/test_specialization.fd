// L8H: specialization. A generic function and definitions of the same name
// for narrower types coexist (no duplicate-definition error); a call takes
// the most specific definition whose parameters take its argument types:
// i64 and str have their own, any Vec<T> has one, and Vec<i64> one more
// specific still. A call inside a generic function is decided per
// instantiation (`wrap(7)` reaches the i64 one, `wrap(false)` the general).
//
// Expected output:
// i64 5
// str hi
// any
// vec of 2
// vec of i64, sum 6
// i64 7
// any
// pair of i64 3
// pair 2

fn describe<T>(x: T) -> str {
    return "any";
}

fn describe(x: i64) -> str {
    return "i64 " + int_to_str(x);
}

fn describe(x: str) -> str {
    return "str " + x;
}

fn describe<T>(v: Vec<T>) -> str {
    return "vec of " + int_to_str(v.len());
}

fn describe(v: Vec<i64>) -> str {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        s = s + v.get(i);
        i = i + 1;
    }
    return "vec of i64, sum " + int_to_str(s);
}

fn wrap<T>(x: T) -> str {
    return describe(x);
}

fn pair<A, B>(a: A, b: B) -> str {
    return "pair 2";
}

fn pair(a: i64, b: i64) -> str {
    return "pair of i64 " + int_to_str(a + b);
}

fn main() -> i64 {
    println(describe(5));
    println(describe("hi"));
    println(describe(true));
    var vs: Vec<str> = Vec::new();
    vs.push("a");
    vs.push("b");
    println(describe(vs));
    var vi: Vec<i64> = Vec::new();
    vi.push(1);
    vi.push(2);
    vi.push(3);
    println(describe(vi));
    println(wrap(7));
    println(wrap(false));
    println(pair(1, 2));
    println(pair("x", 2));
    return 0;
}
