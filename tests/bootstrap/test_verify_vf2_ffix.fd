// VF2 (competitive roadmap): `ffix`, the fixed-precision float printer of
// scripts/fuzz/gen_vs_c.py --ext2, on chosen values. It rounds |x| * 1000
// half up with `+ 0.5` and `as i64` and prints sign, integer part and three
// digits; C prints the same with "%s%lld.%03lld" (the generator's `pfix`).
// The expected lines are what C (IEEE doubles, each operation rounded on
// its own) prints for the same operations; a backend that parses a float
// literal to another double, fuses `a * 1000.0 + 0.5`, truncates a float
// cast wrongly or prints an integer wrongly prints another line.
//
// Expected output:
// 0.500
// 2.000
// -1.500
// 0.000
// 0.000
// 1234.568
// 0.300
// 1000000.000
// -1000000.000
// 0.667
// 0.005
// 0.001
// -1.000
// 14.286
// 0.003
// -0.006

fn ffix(x: f64) -> str {
    val neg: bool = x < 0.0;
    var a: f64 = x;
    if neg { a = 0.0 - x; }
    val m: i64 = (a * 1000.0 + 0.5) as i64;
    val f: i64 = m % 1000;
    var s: str = int_to_str(m / 1000) + ".";
    if f < 100 { s = s + "0"; }
    if f < 10 { s = s + "0"; }
    s = s + int_to_str(f);
    if neg && m != 0 { s = "-" + s; }
    return s;
}

fn main() -> i64 {
    var fa: f64 = 0.5;
    var fb: f64 = 2.0;
    println(ffix(fa));
    println(ffix(fb));
    println(ffix(0.0 - 1.5));
    println(ffix(0.0));
    println(ffix(0.0 - 0.0004));
    println(ffix(1234.5675));
    fa = 0.1;
    fb = 0.2;
    println(ffix(fa + fb));
    println(ffix(1000000.0));
    println(ffix(0.0 - 999999.9995));
    fa = 2.0;
    println(ffix(fa / 3.0));
    println(ffix(0.0045));
    println(ffix(0.0005));
    var n: i32 = 0 - 7;
    println(ffix((n as f64) / 7.0));
    n = 100;
    println(ffix((n as f64) / 7.0));
    fa = 0.001;
    println(ffix(fa * 3.0));
    fa = 1999.5;
    fb = 0.0 - 3.25;
    println(ffix((fa * fb) / 1000000.0));
    return 0;
}
