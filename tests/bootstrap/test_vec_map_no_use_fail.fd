// expect-error: Vec has no method 'map' in this program: `map` is defined by stdlib/vec.fd
// Expected to FAIL (known-bugs 2g.66): Vec's map is stdlib/vec.fd's
// `impl Vec`, and this file has no `use vec;`. It type-checked, then
// `fid run` panicked with "Unknown function 'Vec_map'" (and the C compiler
// stopped on an undeclared Vec_map).
fn size(w: str) -> i64 {
    return str_len(w);
}

fn main() {
    var words: Vec<str> = Vec::new();
    words.push("a");
    words.push("bcd");
    var lens: Vec<i64> = words.map(size);
    println(int_to_str(lens.len()));
}
