// expect-error: 'record' runs on another thread and writes the global 'seen' with no lock
// Bugs roadmap BG25: the race check recorded assignments to a global
// (`g = v`, `g[i] = v`) but not a change through a method: two threads
// pushing onto one global Vec with no lock were accepted.
var seen: Vec<i64> = Vec::new();

fn record(x: i64) -> i64 {
    seen.push(x);
    return x;
}

fn main() -> i64 {
    val a = spawn record(1);
    val b = spawn record(2);
    await a;
    await b;
    println(int_to_str(seen.len()));
    return 0;
}
