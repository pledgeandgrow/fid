// L3A: Effect handler — handler doesn't resume (continuation skipped)
fn main() {
    handle {
        println(1);
        do IO.print(42);
        // This should NOT run because handler doesn't resume
        println(999);
    } with {
        IO.print(v) => {
            println(v);
            // No resume — continuation is skipped
        }
    }
    println(2);
}
