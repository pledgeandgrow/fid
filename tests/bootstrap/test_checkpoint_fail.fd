// test_checkpoint_fail.fd — ML11: @checkpoint without @deterministic
// Expected: FAIL (compile error)
// @checkpoint requires @deterministic for correct recompute.

use tensor;

@differentiable
@checkpoint
fn bad_checkpoint(x: Tensor) -> Tensor {
    val w = ones(vec2(2, 2));
    val h = matmul(x, w);
    return h;
}

fn main() {
    val x = ones(vec2(2, 2));
    val result = bad_checkpoint(x);
    return 0;
}

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}
