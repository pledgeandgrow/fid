// expect-error: `self` of method 'sh' of A must be A, &A or &mut A, got B
// Bugs roadmap BG368: the same hole in a trait impl: `impl Sh for A { fn
// sh(self: B) }` read an i64 field of A as B's str.
cap Sh {
    fn sh(self) -> str;
}
struct A { a: i64 }
struct B { b: str }
impl Sh for A {
    fn sh(self: B) -> str {
        return self.b;
    }
}
fn main() {
    val a = A { a: 7 };
    println(a.sh());
}
