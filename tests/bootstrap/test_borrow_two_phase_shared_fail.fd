// expect-error: a mutable borrow of the Vec is reserved by another argument of this call
// BG13: `g(&mut v, &v[0])` hands g a `&mut v` and a reference into v's
// buffer at once. The shared temporary was released before the reserved
// `&mut` was activated, so the call was accepted; g's push can move the
// buffer and leave `y` dangling. `g(&mut a, &a)` stays accepted: a
// two-phase borrow of the variable itself (CM2, test_borrowck.fd).
fn g(x: &mut Vec<i64>, y: &i64) -> i64 {
    var i: i64 = 0;
    while i < 64 {
        x.push(i);
        i = i + 1;
    }
    return *y;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(7);
    println(int_to_str(g(&mut v, &v[0])));
    return 0;
}
