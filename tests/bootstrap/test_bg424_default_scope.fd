// Bugs roadmap BG424: a default parameter value was pasted into the call
// and evaluated in the caller's scope: a caller's local `LIMIT` hid the
// global `LIMIT` the default names, and `b: i64 = a * 2` read the caller's
// `a`. compiler/lower.fd Lowerer_dflt_helpers computes a default that
// names something in a function of its own (`__dflt_<fn>_<i>`), given the
// earlier parameters it names (lw_dflt_bind), so its names resolve where
// the callee is declared.
//
// Expected output:
// 1002
// 11
// 11
// 3006
// 15

var LIMIT: i64 = 10;

fn f(a: i64, b: i64 = a * 2) -> i64 {
    return a * 1000 + b;
}

fn g(x: i64, k: i64 = LIMIT) -> i64 {
    return x + k;
}

fn h(n: i64) -> i64 {
    var LIMIT = 500;
    return g(n) + LIMIT - LIMIT;
}

struct C { k: i64 }

impl C {
    fn add(self, x: i64, k: i64 = LIMIT) -> i64 {
        return self.k + x + k;
    }
}

fn hm(c: C) -> i64 {
    val LIMIT = 900;
    return c.add(2) + LIMIT - LIMIT;
}

fn main() {
    val a = 100;
    println(f(1));
    println(h(1));
    println(g(x: 1));
    println(f(a: 3) + a - a);
    println(hm(C { k: 3 }));
}
