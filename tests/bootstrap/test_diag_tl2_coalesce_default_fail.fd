// expect-error: ?? default value type mismatch
//! error: ?? default value type mismatch
// TL2: a test per diagnostic of the type, borrow and escape checks.
// The default of `??` has the Option's element type.

fn find(n: i64) -> Option<i64> {
    if n > 0 {
        return Option::Some(n);
    }
    return Option::None;
}

fn main() -> i64 {
    val v = find(3) ?? "none";
    println(v);
    return 0;
}
