// expect-error: Sandbox error: 'logit()' has effect '!IO'
// Test: sandbox counts the effects of the functions it calls.
// logit() prints, so calling it inside sandbox { } is IO and is rejected,
// as a direct print(...) is (test_sandbox_fail.fd).

fn logit() {
    println("IO via a helper");
}

fn main() {
    sandbox {
        logit();
    }
    return 0;
}
