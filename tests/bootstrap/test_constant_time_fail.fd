// expect-error: function 'bad_ct_eq' has an early return.
// test_constant_time_fail.fd — @constant_time violation (early return)
// Expected: FAIL (compile error — early return leaks timing)
// This function has an early return, which creates a timing side channel.

@constant_time
fn bad_ct_eq(a: i64, b: i64) -> i64 {
    if a == b {
        return 1;  // Early return — timing leak!
    }
    return 0;
}

fn main() {
    val x = bad_ct_eq(5, 5);
    print(x);
}
