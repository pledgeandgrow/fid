// Bugs roadmap BG145: a field written through `&mut` to a generic struct's
// instance was not stored (lower.fd Stmt::FieldAssign took the struct name
// only from Ptr(Struct) or Struct; a `&mut Slot<T>` lowers to Ptr(Generic)):
// `s.v = x` changed nothing, with no error. An f64 in a type-parameter field
// is stored as its bits, as a struct literal stores it (C stored 2.25 as 2).
//
// Expected output:
// 5
// 1
// 8
// 2
// 2.25
// 1
// 9
// 1
// 3.5
// 2
// 4.5
// 7

struct Slot<T> {
    v: T,
    n: i64,
}

impl<T> Slot<T> {
    fn get(self) -> T {
        return self.v;
    }

    fn put(self: &mut Slot<T>, x: T) {
        self.v = x;
        self.n = self.n + 1;
    }
}

fn put<T>(s: &mut Slot<T>, x: T) {
    s.v = x;
    s.n = s.n + 1;
}

fn put2(s: &mut Slot<i64>, x: i64) {
    s.v = x;
    s.n += 1;
}

fn main() {
    var a: Slot<i64> = Slot {
        v: 1, n: 0
    };
    put(&mut a, 5);
    println(a.v);
    println(a.n);
    put2(&mut a, 8);
    println(a.v);
    println(a.n);

    var f: Slot<f64> = Slot {
        v: 1.5, n: 0
    };
    f.put(2.25);
    println(f.get());
    println(f.n);
    var b: Slot<i64> = Slot {
        v: 1, n: 0
    };
    b.put(9);
    println(b.get());
    println(b.n);

    // a local generic instance, an f64 field, a compound assignment
    var c: Slot<f64> = Slot {
        v: 1.0, n: 0
    };
    c.v = 3.5;
    c.n = 2;
    println(c.v);
    println(c.n);
    c.v += 1.0;
    println(c.v);
    c.n += 5;
    println(c.n);
}
