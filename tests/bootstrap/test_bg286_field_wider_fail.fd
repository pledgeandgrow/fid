// expect-error: a i64 may not fit in i32
// Bugs roadmap BG286: a wider integer assigned to a narrower field needs
// `as` (as `S { a: big }` and `var c: i32 = big` do); before, it printed
// 705032704.
struct S {
    a: i32,
}

fn main() -> i64 {
    var big: i64 = 5000000000;
    var s = S { a: 1 };
    s.a = big;
    println(s.a);
    return 0;
}
