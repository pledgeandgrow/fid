// expect-error: method 'make' of `impl Make for Wrap<i64>` has no `self`: a specialization is chosen by the receiver's type
// L8H: an impl of a trait for a narrower type specializes the generic
// impl's methods by the receiver's type; a method without `self` has no
// receiver to choose by, so a narrower impl cannot give one.

cap Make {
    fn make() -> i64;
    fn get(self) -> i64;
}

struct Wrap<T> {
    v: T,
}

impl<T> Make for Wrap<T> {
    fn make() -> i64 {
        return 0;
    }

    fn get(self) -> i64 {
        return 1;
    }
}

impl Make for Wrap<i64> {
    fn make() -> i64 {
        return 64;
    }

    fn get(self) -> i64 {
        return self.v;
    }
}

fn main() -> i64 {
    val a: Wrap<i64> = Wrap { v: 5 };
    println(a.get());
    return 0;
}
