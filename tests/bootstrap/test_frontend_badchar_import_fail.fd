// expect-error: unexpected character '$'
// 2g.18: an unknown character in an imported module is an error. The lexer
// ended the token stream there (an Eof token), and compiler.fd does not look
// at an imported module's lex errors, so everything after the `$` was
// dropped without a word: here bc_three would have been "undefined". Now
// the lexer gives an error token and the module fails to parse at the `$`.
// Nov 16: the import loop shows the lexer's own message, against the
// module's file (test_frontend_badchar_mod.fd), not the parser's.
use test_frontend_badchar_mod;

fn main() -> i64 {
    println(bc_one() + bc_three());
    return 0;
}
