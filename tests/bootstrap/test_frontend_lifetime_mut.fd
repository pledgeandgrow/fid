// LG3: a `&mut` passed on and handed back. `r` takes over `m`'s mutable
// borrow of `a`; after `r`'s last use `m` holds it again, and after `m`'s
// last use `a` is free to change.
// Expected output:
// 4
// 5
fn id_mut(p: &mut i64) -> &mut i64 {
    return p;
}

fn main() -> i64 {
    var a: i64 = 1;
    val m = &mut a;
    val r = id_mut(m);
    *r = 3;
    *m = 4;
    println(a);
    a = 5;
    println(a);
    return 0;
}
