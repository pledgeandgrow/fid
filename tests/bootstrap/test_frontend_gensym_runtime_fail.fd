// expect-error: gensym() names what compile-time code generates
// LG9: gensym is for compile-time code (a comptime fn, a comptime block, a
// `comptime gen` or `comptime splice` block); an ordinary function calling
// it is an error.
fn name_for(p: str) -> str {
    return gensym(p);
}

fn main() -> i64 {
    println(name_for("x"));
    return 0;
}
