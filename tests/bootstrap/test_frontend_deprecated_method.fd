// CU3: `@deprecated` on a method. A call through `.m()` or `T::m()` gives a
// warning on stderr ("Warning (line N, in 'main'): 'Meter.old_value' is
// deprecated: use `value` instead."), and the program still builds and runs.
// `fid fix` renames plain calls only, so a method call is left to its author.
// Expected output:
// 7
// 7
// 3

struct Meter {
    n: i64,
}

impl Meter {
    @deprecated(use = "value")
    fn old_value(self: Meter) -> i64 {
        return self.n;
    }

    fn value(self: Meter) -> i64 {
        return self.n;
    }

    @deprecated("make it with a struct literal")
    fn three() -> Meter {
        return Meter { n: 3 };
    }
}

fn main() -> i64 {
    val m: Meter = Meter { n: 7 };
    println(m.old_value());
    println(m.value());
    val t: Meter = Meter::three();
    println(t.n);
    return 0;
}
