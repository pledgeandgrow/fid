// metrics: counters, gauges and histograms in the Prometheus text format
use metrics;

fn main() -> i64 {
    val m: Metrics = metrics_new();
    val req: i64 = metrics_counter(m, "http_requests_total", "Requests served");
    val inflight: i64 = metrics_gauge(m, "http_in_flight", "Requests being served");
    var bounds: Vec<i64> = Vec::new();
    bounds.push(10);
    bounds.push(100);
    val lat: i64 = metrics_histogram(m, "http_latency_ms", "Latency in ms", bounds);
    metrics_inc(m, req, 1);
    metrics_inc(m, req, 2);
    metrics_set(m, inflight, 4);
    metrics_inc(m, inflight, -1);
    metrics_observe(m, lat, 5);
    metrics_observe(m, lat, 10);
    metrics_observe(m, lat, 50);
    metrics_observe(m, lat, 500);
    if metrics_get(m, req) != 3 { p_panic("counter"); }
    if metrics_get(m, inflight) != 3 { p_panic("gauge"); }
    if metrics_get(m, lat) != 565 || metrics_count(m, lat) != 4 { p_panic("histogram"); }
    if metrics_valid_name("9lives") || metrics_valid_name("a-b") || !metrics_valid_name("ok_name:x") {
        p_panic("names");
    }
    print(metrics_text(m));
    return 0;
}
