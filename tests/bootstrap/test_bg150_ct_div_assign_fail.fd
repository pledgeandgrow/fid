// expect-error: divides secret data
// Bugs roadmap BG150: @constant_time rejected `x = x / k` but accepted
// `x /= k`, the same variable-time division of secret data.
@constant_time
fn ct(a: i64, k: i64) -> i64 {
    var x: i64 = a;
    x /= k;
    return x;
}

fn main() -> i64 {
    println(ct(10, 3));
    return 0;
}
