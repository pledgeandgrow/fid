// CE8 (docs/roadmap/complaint-roadmap.md): a panic prints the values of
// the failing frame (its word-sized parameters and locals) before the
// trace, in a debug build:
//   fid ccompile -g (codegen_c.fd cg_dbg_prologue, __p_dbg_print_frame),
//   fid emit -g / FID_NAT_FRAMES=1 on the machine layer (nat_ir.fd
//   ng_dbg_frames_data, stdlib/linux_runtime/base.fd pe_dbg_frame_print).
// Run normally, it prints the lines below. Built that way and run with
// FID_FRAME_PANIC=1 in the environment, it panics in `ratio` (the
// interpreter and plain builds too, without the values) and stderr has,
// after the "Panic: Division by zero" line and before the trace,
//     values in ratio:
//         total = 10
//         parts = 0
//         label = "share"
//         scale = 2.5
//         ok = true
// (in some order); the exit status is 1.
// Check: tests/nattools/frame_values_check.sh.
// Expected output:
// ratio 5
// ratio 0
// done

fn ratio(total: i64, parts: i64, label: str) -> i64 {
    var scale: f64 = (total as f64) / 4.0;
    var ok: bool = scale > 1.0;
    if ok && str_len(label) > 0 {
        return total / parts;
    }
    return 0;
}

fn main() -> i64 {
    println("ratio " + int_to_str(ratio(10, 2, "share")));
    println("ratio " + int_to_str(ratio(0, 2, "")));
    match env_var("FID_FRAME_PANIC") {
        Option::Some(_) => {
            println(int_to_str(ratio(10, 0, "share")));
        }
        Option::None => {}
    }
    println("done");
    return 0;
}
