// expect-error: conflicting implementations of `impl Describe for Point`
// CL7 (fid): two imported libraries implement the same trait for the same
// type. The one merged later used to win silently; now it is an error naming
// both modules, with the fix (implement it in the program, which replaces
// both: test_frontend_trait_override.fd).
use trait_conflict::shape_base;
use trait_conflict::shape_a;
use trait_conflict::shape_b;

fn main() -> i64 {
    val p: Point = Point { x: 1, y: 2 };
    println(p.describe() + a_marker() + b_marker());
    return 0;
}
