// OP11 (compiler/iropt_me.fd ime_unroll_one, pass `unroll`, on by default
// on the native paths since Nov 17): expected to fail at run time
// (division by zero at i = 9), after printing 0 to 9. The bound `n` is a
// parameter (a trip count known only at run time): a guard after the
// header runs 4 copies of the body while n - i > 3, the old body for the
// trips left. With n = 20 the copies run i = 0..3, 4..7, 8..11, so the
// panic must come in the second copy of the third group, where the plain
// loop has it: after the line 9, never before it, and "unreachable" is
// never printed (tests/tooling/unroll-check.sh compares the output with
// unroll on and off).

fn run(n: i64) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < n {
        println(i);
        t = t + 100 / (9 - i);
        i = i + 1;
    }
    return t;
}

fn main() {
    // 20, from a call: not a constant even when `run` is inlined here
    var n: i64 = str_len("0123456789") * 2;
    println(run(n));
    println("unreachable");
}
