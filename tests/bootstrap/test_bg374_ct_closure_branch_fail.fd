// expect-error: branches on secret data (`if`)
// Bugs roadmap BG374: a closure defined in a @constant_time function and
// called with the secret branched (and returned early) on it, and was
// accepted: the checks did not take the closure's parameters for secret.
@constant_time
@wrapping
fn f(a: i64, b: i64) -> i64 {
    val g = fn(x: i64) -> i64 {
        if x > 3 {
            return 1;
        }
        return 0;
    };
    return g(a) + b;
}
fn main() {
    println(f(5, 1));
}
