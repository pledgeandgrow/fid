// Roadmap Phase 9 (serverless, F32): a @serverless handler keeps request
// state in locals, reads only globals whose initializers cost nothing at
// start-up (constants, literals), and starts no task, so it is accepted:
// it can run cold, be frozen after the response, or run many times at
// once.
// Expected output:
//   200 /hello 11
//   404 /missing 0
//   handled 2

const MAX_BODY: i64 = 1024;
var GREETING: str = "hello world";

fn route(path: str) -> i64 {
    if path == "/hello" {
        return 200;
    }
    return 404;
}

@serverless
fn handle_request(path: str) -> str {
    val status: i64 = route(path);
    var body_len: i64 = 0;
    if status == 200 {
        body_len = str_len(GREETING);
    }
    if body_len > MAX_BODY {
        body_len = MAX_BODY;
    }
    return int_to_str(status) + " " + path + " " + int_to_str(body_len);
}

fn main() {
    var n: i64 = 0;
    println(handle_request("/hello"));
    n = n + 1;
    println(handle_request("/missing"));
    n = n + 1;
    println("handled " + int_to_str(n));
}
