// stdlib/csv: RFC 4180 parsing and serialization (competitive SL11):
// quoted fields with commas, quotes and newlines inside, CRLF and LF,
// header records, a dialect with another delimiter, and a round trip.
//
// Expected output:
// 3 rows, 3 cols
// name|age|note
// Ann|31|likes, commas
// Bob|42|says "hi"
// multi
// line
// age=42
// x;y|1;2
// round trip ok
// 2 1
use csv;
use vec;
use string;

fn main() -> i64 {
    var text: str = "name,age,note\r\nAnn,31,\"likes, commas\"\r\nBob,42,\"says \"\"hi\"\"\"\r\n";
    var rows: Vec<CsvRow> = csv_parse(text);
    println(int_to_str(csv_row_count(rows)) + " rows, " + int_to_str(csv_col_count(rows, 0)) + " cols");
    var r: i64 = 0;
    while r < csv_row_count(rows) {
        println(csv_field(rows, r, 0) + "|" + csv_field(rows, r, 1) + "|" + csv_field(rows, r, 2));
        r = r + 1;
    }
    var nl: Vec<CsvRow> = csv_parse("a,\"multi\nline\"\n");
    println(csv_field(nl, 0, 1));
    var recs: Vec<CsvRecord> = csv_parse_records("name,age\nBob,42\n");
    println("age=" + csv_record_get(recs.get(0), "age"));
    var semi: Vec<CsvRow> = csv_parse_dialect("x;y\n1;2\n", 59, 34);
    println(csv_field(semi, 0, 0) + ";" + csv_field(semi, 0, 1) + "|" + csv_field(semi, 1, 0) + ";" + csv_field(semi, 1, 1));
    var again: Vec<CsvRow> = csv_parse(csv_serialize(rows));
    var same: bool = csv_row_count(again) == csv_row_count(rows);
    r = 0;
    while r < csv_row_count(rows) && same {
        var c: i64 = 0;
        while c < 3 {
            if csv_field(again, r, c) != csv_field(rows, r, c) { same = false; }
            c = c + 1;
        }
        r = r + 1;
    }
    if same { println("round trip ok"); } else { println("round trip DIFFERS"); }
    var col: Vec<str> = csv_column(rows, 1);
    println(int_to_str(col.len() - 1) + " " + int_to_str(str_len(csv_quote_field("x"))));
    return 0;
}
