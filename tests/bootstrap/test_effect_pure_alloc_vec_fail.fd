// expect-error: Effect error: function 'make' has inferred effect '!Alloc'
// Expected to FAIL (known-bugs 2g.65): `!{}` declares no effect, and
// `Vec::new()` and `push` allocate. They inferred no Alloc, so a `!{}`
// function could build Vecs freely.
fn make() -> i64 !{} {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    return v.len();
}

fn main() {
    println(int_to_str(make()));
}
