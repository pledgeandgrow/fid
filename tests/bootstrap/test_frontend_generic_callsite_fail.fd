// expect-error: (line 25, in 'main'): 'first_x' is called with T = i64, but i64 has no field 'x', which the body of 'first_x' needs.
// CE9: a generic body is checked once, with T abstract; a field it reads on
// a T holds only for some types. The error is reported at the call that
// chose T, with the type it chose. Before, `first_x(7)` was accepted and
// read a field an i64 does not have (it printed 0).

struct Pt {
    x: i64,
    y: i64,
}

fn first_x<T>(v: T) -> i64 {
    // fine for Pt, not for i64
    return v.x;
}

fn main() -> i64 {
    // this call chooses T = Pt, which has x: no error here
    println(first_x(Pt { x: 4, y: 5 }));
    val a: i64 = 1;
    val b: i64 = 2;
    println(a + b);
    // this one chooses T = i64
    val n: i64 = 7;
    println(first_x(n));
    return 0;
}
