// LF10 (compiler/checks.fd peir_note_param_ranges, peir_ret_join,
// peir_ret_seed; on by default: FID_IROPT_OFF=paramrange, and
// FID_IROPT_OFF=retrange keeps the parameter ranges only): ranges through function
// boundaries. `cell` is reached only through direct calls, all with `i` of
// a loop `while i < 8` from 0: its parameter is in [0, 7], so the bounds
// checks on its table of 8 (Vec::filled) can go, `7 - i` included. Every
// return of `digit` gives `x % 10` of a value >= 0, in [0, 9], so the
// caller's `digit(..) * 1000 + 7` needs no overflow check. `wide` is also
// called once with 10^15: the range of its calls is [0, 10^15] and its
// multiplication keeps its check. `down` calls itself with `n - 1`: no
// range for it (each round of the analysis uses only what the round
// before proved). The output is the same with the facts on and off.
//
// Expected output:
// 172
// 110175
// 1
// 35
// 3000000000000001
// 10

fn cell(i: i64) -> i64 {
    var t: Vec<i64> = Vec::filled(8, 3);
    t.set(i, i * 5 + 1);
    return t.get(i) + t.get(7 - i);
}

fn digit(x: i64) -> i64 {
    if x < 0 {
        return 0;
    }
    return x % 10;
}

fn wide(x: i64) -> i64 {
    return x * 3 + 1;
}

fn down(n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    return down(n - 1) + 2;
}

fn main() {
    var c: i64 = 0;
    var i: i64 = 0;
    while i < 8 {
        c = c + cell(i);
        i = i + 1;
    }
    println(c);
    var d: i64 = 0;
    var k: i64 = 0;
    while k < 25 {
        d = d + digit(k * 7) * 1000 + 7;
        k = k + 1;
    }
    println(d);
    println(digit(987654321));
    var w: i64 = 0;
    i = 0;
    while i < 5 {
        w = w + wide(i);
        i = i + 1;
    }
    println(w);
    println(wide(1000000000000000));
    println(down(5));
}
