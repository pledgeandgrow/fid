// expect-error: Type error (line 9): arithmetic requires numeric types. Left: bool, Right: i64
// Expected to FAIL (known-bugs 2g.64): `bool * i64` is not arithmetic. The
// error names the line of the statement that holds it (it named none: the
// error was "Type error: arithmetic requires numeric types. Left: bool,
// Right: i64" with no place).
fn scale(b: bool, n: i64) -> i64 {
    var k: i64 = 1;
    k = k + n;
    return b * k;
}

fn main() {
    println(scale(true, 2));
}
