// Bugs roadmap BG394: on pe_ir (`emit`) `read_stdin(n)` never returned None
// at the end of the input: pert_read_stdin (stdlib/pe_runtime/base.fd) gave
// Some("") forever, so the usual loop over read_stdin chunks never ended
// (the cap below stops it at 1000). It now returns the null str when
// nothing was read, as the C runtime and the machine layer do.
//
// Run with empty (or closed) stdin, as the test harness runs it. With a
// 10-byte file on stdin it prints "total 10 chunks 3".
//
// Expected output:
// total 0 chunks 0

fn main() {
    var total: i64 = 0;
    var chunks: i64 = 0;
    var go: bool = true;
    while go && chunks < 1000 {
        match read_stdin(4) {
            Option::Some(c) => {
                total = total + str_len(c);
                chunks = chunks + 1;
            }
            Option::None => {
                go = false;
            }
        }
    }
    println(f"total {total} chunks {chunks}");
}
