// expect-error: cannot assign *mut i64 to variable 'f' of type f64
// Bugs roadmap BG80: a raw pointer was accepted wherever a number is, so
// it silently became a float (or was cut to a narrower integer), and a
// float became a pointer. An address converts to and from integers only.
fn main() -> i64 {
    unsafe {
        val p: *mut i64 = p_malloc(8);
        val f: f64 = p;
        println(f);
        p_free(p);
    }
    return 0;
}
