// Bugs roadmap BG432: on Windows `p_file_size` of a file of 2 GiB or more
// was -1 ("missing") on run, C and pe_ir: the size came from 32-bit ftell.
// The 3 GiB file is made by the system's tool (fsutil on Windows, truncate
// elsewhere; neither writes the data) and deleted at the end.
//
// Expected output:
// 3221225472 true
fn main() {
    var made: i64 = p_system("fsutil file createnew bg432_big.bin 3221225472 >NUL 2>&1");
    if made != 0 {
        made = p_system("truncate -s 3221225472 bg432_big.bin");
    }
    println(f"{p_file_size("bg432_big.bin")} {p_file_exists("bg432_big.bin")}");
    p_file_delete("bg432_big.bin");
}
