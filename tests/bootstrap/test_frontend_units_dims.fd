// CL10 (fid): units of measure whose dimensions the compiler computes.
// A struct marked `@dimension(...)` is a unit holding one f64. `*` and `/`
// on two units make the unit of the combined dimension (Force * Len is
// Energy) with no function per pair, an f64 when the dimensions cancel;
// an f64 scales a unit from either side (`5.0 * d`), `1.0 / t` is the
// inverse unit; `+`/`-` keep one unit. A method that takes the operand
// still wins (Area.mul), and a struct's `rmul` serves `4 * money`.
// Expected output:
// 30
// 12
// 5
// 2
// 15
// 7
// 9
// 4
// 21
// 43
// 10
// 24
// 160

@dimension(m = 1)
struct Len {
    value: f64,
}

@dimension(s = 1)
struct Time {
    value: f64,
}

@dimension(m = 1, s = -1)
struct Speed {
    value: f64,
}

@dimension(s = -1)
struct Freq {
    value: f64,
}

@dimension(m = 1, kg = 1, s = -2)
struct Force {
    value: f64,
}

@dimension(m = 2, kg = 1, s = -2)
struct Energy {
    value: f64,
}

@dimension(m = 2)
struct Area {
    value: f64,
}

impl Area {
    // takes the operand of `a * 2.0`: called instead of the rule
    fn mul(self: Area, k: f64) -> Area {
        return Area { value: self.value * k + 1.0 };
    }
}

struct Money {
    cents: i64,
}

impl Money {
    // `k * m` with k not a struct calls `m.rmul(k)`
    fn rmul(self: Money, k: i64) -> Money {
        return Money { cents: self.cents * k };
    }
}

fn show(x: f64) {
    println(int_to_str(x as i64));
}

fn main() -> i64 {
    val f: Force = Force { value: 10.0 };
    val d: Len = Len { value: 3.0 };
    val e: Energy = f * d;
    show(e.value);
    val t: Time = Time { value: 2.0 };
    val far: Len = Len { value: 24.0 };
    val v: Speed = far / t;
    show(v.value);
    val ten: Len = Len { value: 10.0 };
    val two: Len = Len { value: 2.0 };
    val r: f64 = ten / two;
    show(r);
    val half: Time = Time { value: 0.5 };
    val hz: Freq = 1.0 / half;
    show(hz.value);
    val l2: Len = 5.0 * d;
    show(l2.value);
    val four: Len = Len { value: 4.0 };
    val s: Len = d + four;
    show(s.value);
    val l3: Len = d * 3.0;
    show(l3.value);
    val eight: Len = Len { value: 8.0 };
    val l4: Len = eight / 2.0;
    show(l4.value);
    val seven: Len = Len { value: 7.0 };
    val a: Area = d * seven;
    show(a.value);
    val a2: Area = a * 2.0;
    show(a2.value);
    val back: Force = f * d / d;
    show(back.value);
    show((v * t).value);
    val m: Money = 4 * Money { cents: 40 };
    println(m.cents);
    return 0;
}
