// stdlib-agent-bugs 35: in `fid run`, concatenating a string that holds a
// zero byte cut it at that byte (str_from_bytes([65, 0, 66]) + "y" had
// length 2): the interpreter read a counted string up to its first NUL
// instead of by the length in its header.
// Expected output:
// 3
// 4 65 0 66 121
// 4 120 65 0 66
// 7
fn main() {
    var bs: Vec<i64> = Vec::new();
    bs.push(65);
    bs.push(0);
    bs.push(66);
    val s: str = str_from_bytes(bs);
    println(int_to_str(str_len(s)));
    val t: str = s + "y";
    println(int_to_str(str_len(t)) + " " + int_to_str(str_byte_at(t, 0)) + " " + int_to_str(str_byte_at(t, 1)) + " " + int_to_str(str_byte_at(t, 2)) + " " + int_to_str(str_byte_at(t, 3)));
    val u: str = "x" + s;
    println(int_to_str(str_len(u)) + " " + int_to_str(str_byte_at(u, 0)) + " " + int_to_str(str_byte_at(u, 1)) + " " + int_to_str(str_byte_at(u, 2)) + " " + int_to_str(str_byte_at(u, 3)));
    val w: str = s + s + "z";
    println(int_to_str(str_len(w)));
}
