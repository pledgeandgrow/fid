// expect-error: 'twice' is not a generic function, so it takes no type arguments.
// Expected to FAIL (CE4): a turbofish on a function without type
// parameters (mono.fd mono_turbofish_name).
fn twice(x: i64) -> i64 {
    return x * 2;
}

fn main() -> i64 {
    println(twice::<i64>(4));
    return 0;
}
