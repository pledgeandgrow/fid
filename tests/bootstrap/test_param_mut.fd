// Test: assignment to function parameters, especially across control-flow
// joins (while/for/if). A bare SSA binding cannot be updated across blocks —
// assigned params must be spilled to an alloca at entry.

fn bump(i: i64) -> i64 {
    while i < 5 { i = i + 1; }
    return i;
}

fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { x = lo; }
    if x > hi { x = hi; }
    return x;
}

fn sum_to(n: i64) -> i64 {
    var total: i64 = 0;
    while n > 0 {
        total = total + n;
        n = n - 1;
    }
    return total;
}

fn abs_shift(v: i64, s: i64) -> i64 {
    if v < 0 { v = 0 - v; }
    for _i in 0..s { v = v + v; }
    return v;
}

fn toggle(b: bool) -> bool {
    if b { b = false; } else { b = true; }
    return b;
}

fn twiddle(s: str) -> str {
    if str_len(s) == 0 { s = "?"; }
    s = s + "!";
    return s;
}

fn main() -> i64 {
    println("a " + int_to_str(bump(0)));      // 5
    println("b " + int_to_str(bump(9)));      // 9
    println("c " + int_to_str(clamp(12, 0, 10)));  // 10
    println("d " + int_to_str(clamp(-3, 0, 10)));  // 0
    println("e " + int_to_str(sum_to(5)));    // 15
    println("f " + int_to_str(abs_shift(-3, 2)));  // 12
    println("g " + int_to_str(clamp(4, 0, 10)));   // 4
    if toggle(true) { println("h f"); } else { println("h t"); }
    if toggle(false) { println("i t"); } else { println("i f"); }
    println("j " + twiddle(""));             // ?!
    println("k " + twiddle("x"));            // x!
    return 0;
}
