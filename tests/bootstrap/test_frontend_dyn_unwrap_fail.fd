// expect-error: cannot assign dyn Animal to variable 'back' of type Dog
// LG4: a `dyn Trait` is not the struct it was made from; reading it back as
// that struct reinterpreted the object's representation.
cap Animal {
    fn legs(self) -> i64;
}

struct Dog { age: i64 }

impl Animal for Dog {
    pub fn legs(self: Dog) -> i64 { return 4; }
}

fn main() -> i64 {
    val d = Dog { age: 3 };
    val a = d as dyn Animal;
    val back: Dog = a;
    println(back.age);
    return 0;
}
