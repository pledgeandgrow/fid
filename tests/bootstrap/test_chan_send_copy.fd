// Test: a Vec or string sent over a channel is copied whole, as a spawn
// argument is: the sender changing its own value afterwards does not
// change what the receiver gets, and both can drop theirs.
//
// Expected output:
// received 3 [1, 2, 3]
// sender 4
// received text abc
fn main() -> i64 {
    val ch = p_chan_create(4);
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    p_chan_send(ch, v);
    v.push(4);
    v.set(0, 99);
    val got: Vec<i64> = p_chan_recv(ch) as Vec<i64>;
    println("received " + int_to_str(got.len()) + " " + Vec_to_str(got));
    println("sender " + int_to_str(v.len()));
    var s: str = "ab";
    s = s + "c";
    p_chan_send(ch, s);
    s = "changed";
    val gs: str = p_str_take(p_chan_recv(ch));
    println("received text " + gs);
    return 0;
}
