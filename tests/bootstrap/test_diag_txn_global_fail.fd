// expect-error: Transaction error (line 11): global 'total' is assigned inside txn { }.
// TL2: a diagnostic per check. `abort;` rolls back the function's local
// variables; a global assigned inside txn { } would keep its new value, so
// the assignment is rejected.

var total: i64 = 0;

fn main() -> i64 {
    var n: i64 = 1;
    txn {
        total = total + n;
    }
    println(int_to_str(total));
    return 0;
}
