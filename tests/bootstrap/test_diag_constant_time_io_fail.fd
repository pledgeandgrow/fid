// expect-error: Constant-time error: function 'leak' is @constant_time but has effect '!IO'
// TL2: a diagnostic per check. A @constant_time function may not do I/O:
// how long a write takes depends on more than its inputs.

@constant_time
fn leak(a: i64, b: i64) -> i64 {
    println("comparing");
    return a ^ b;
}

fn main() -> i64 {
    println(int_to_str(leak(3, 5)));
    return 0;
}
