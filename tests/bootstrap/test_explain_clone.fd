// CP4 (docs/roadmap/complaint-roadmap.md; compiler/checks.fd
// explain_clone_reason): the input of tests/tooling/explain-clone-check.sh,
// which runs `fid explain --alloc` over this file and looks, under each
// second owner the lowering inserted (proposal 0004), for a line
// "line N: clone required here because ...": who still owns the value,
// what keeps the copy, what it costs.
// - keep_both: `b = a` while `a` is still read later: `a` still owns the
//   Vec, the copy is kept in `b` (a share: the buffer is copied only when
//   one of them changes it, here when `b` is pushed to).
// - into_field: a parameter kept in a struct field: parameters are
//   borrowed, so the field takes its own owner.
// - copy_str: `t = s` for a string `s` still printed later: `s` still
//   owns it, the copy is kept in `t` (an owner count: no bytes copied).
// As a program it prints the same on every backend.
//
// Expected output:
// 3 4
// ada 3
// 42 42

struct Named {
    name: str,
    size: i64,
}

fn keep_both() -> i64 {
    var a: Vec<i64> = Vec::new();
    a.push(1);
    a.push(2);
    a.push(3);
    var b: Vec<i64> = a;
    b.push(4);
    print(a.len());
    print(" ");
    println(b.len());
    return a.len() + b.len();
}

fn into_field(name: str) -> Named {
    var n: Named = Named { name: name, size: str_len(name) };
    return n;
}

fn copy_str() -> i64 {
    var s: str = int_to_str(42);
    var t: str = s;
    print(s);
    print(" ");
    println(t);
    return str_len(t);
}

fn main() -> i64 {
    keep_both();
    var n: Named = into_field("ada");
    print(n.name);
    print(" ");
    println(n.size);
    copy_str();
    return 0;
}
