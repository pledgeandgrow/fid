// expect-error: reads or changes the amount of a Money directly
// Test: a @conserve function may not change a Money's amount in place
// (doubling it here creates money); only stdlib/money.fd's operations,
// each checked to keep the total, touch `cents`.
use money;

@conserve
fn double_it(m: &mut Money) {
    m.cents = m.cents * 2;
}

fn main() -> i64 {
    var m = Money_new(100);
    double_it(&mut m);
    print(Money_to_cents(m));
    return 0;
}
