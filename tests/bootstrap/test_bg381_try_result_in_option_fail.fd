// expect-error: the ? operator on a Result returns its Err, but 'b' returns Option<i64>
// Bugs roadmap BG381: `?` on a Result inside a function returning an Option
// silently dropped the error into None.
fn a() -> Result<i64, str> { return Result::Err("lost"); }
fn b() -> Option<i64> {
    val x = a()?;
    return Option::Some(x);
}
fn main() {
    println(b() ?? 7);
}
