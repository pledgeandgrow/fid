// Test enum/Option/Result in PE emitter
fn main() -> i64 {
    val o = Option::Some(42);
    match o {
        Some(x: i64) => { print(x); }
        None => { print(0); }
    }

    val r = Result::Ok(100);
    match r {
        Ok(v: i64) => { print(v); }
        Err(e: i64) => { print(e); }
    }

    val n = Option::None;
    match n {
        Some(x: i64) => { print(x); }
        None => { print(-1); }
    }

    return 0;
}
