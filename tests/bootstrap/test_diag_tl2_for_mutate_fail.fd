// expect-error: cannot change v while a `for` loop iterates over it
//! error: cannot change v while a `for` loop iterates over it
// TL2: a test per diagnostic of the type, borrow and escape checks.
// compiler/borrowck.fd: a Vec may not change while a for loop walks it.

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    for x in v {
        v.push(x);
    }
    println(v.len());
    return 0;
}
