// Expected-fail test: sending a reference through a channel
// References (&T) are NOT @send because the referent may be freed
// on another thread, causing a use-after-free.
fn main() {
    val x = 42;
    val r = &x;
    val ch = p_chan_create(10);
    p_chan_send(ch, r);  // ERROR: &i8 is not @send
    val result = p_chan_recv(ch);
    println(result);
}
