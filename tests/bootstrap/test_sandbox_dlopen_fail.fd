// expect-error: Sandbox error: 'p_dl_open()' requires 'FS' capability
// Roadmap L6C: loading a shared library is filesystem access (FS), and all
// capabilities are revoked inside sandbox. Before L6C the load was rejected
// only as code of unknown effects; now it is the FS capability it lacks.

fn main() -> i64 {
    sandbox {
        val lib = p_dl_open("libm.so.6");
    }
    return 0;
}
