// expect-error: cannot assign str to variable 'r' of type i64
// Bugs roadmap BG182: `a?.s` of a str field was typed i64, so binding it
// to an i64 gave the string's address.
struct P {
    x: i64,
    s: str,
}

fn mk() -> Option<P> {
    return Option::Some(P { x: 4, s: "hi" });
}

fn main() -> i64 {
    val a = mk();
    val r: i64 = a?.s;
    println(r);
    return 0;
}
