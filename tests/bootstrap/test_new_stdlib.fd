use core;
use vec;
use sort;
use string;
use bits;
use fmt;
use result;
use hash;
use iter;
use path;
use units;
use uuid;
use random;

fn main() -> i64 !{IO, Diverge} {
    // ─── sort ───
    val v = Vec::new();
    v.push(3); v.push(1); v.push(4); v.push(1); v.push(5);
    sort_quick(v);
    assert(v.get(0) == 1);
    assert(v.get(4) == 5);
    assert(sort_is_sorted(v));
    
    val v2 = Vec::new();
    v2.push(3); v2.push(1); v2.push(4);
    sort_insertion(v2);
    assert(v2.get(0) == 1);
    
    val v3 = Vec::new();
    v3.push(5); v3.push(3); v3.push(8);
    sort_bubble(v3);
    assert(v3.get(0) == 3);
    
    assert(sort_binary_search(v, 4) >= 0);
    assert(sort_binary_search(v, 99) == -1);
    println("sort OK");

    // ─── string ───
    assert(str_equal(str_reverse("hello"), "olleh"));
    assert(str_equal(str_capitalize("hello"), "Hello"));
    assert(str_equal(str_pad_left("42", 5, 48), "00042"));
    assert(str_equal(str_pad_right("42", 5, 32), "42   "));
    assert(str_count("a,b,a,c,a", "a") == 3);
    assert(str_is_numeric("12345"));
    assert(str_equal(int_to_hex(255), "ff"));
    assert(str_equal(int_to_bin(5), "101"));
    assert(str_equal(bool_to_str(true), "true"));
    println("string OK");

    // ─── bits ───
    assert(bit_popcount(0xFF) == 8);
    assert(bit_get(0b1010, 1) == 1);
    assert(bit_get(0b1010, 0) == 0);
    assert(bit_set(0, 3) == 8);
    assert(bit_clear(0xFF, 0) == 0xFE);
    assert(bit_is_power_of_two(8));
    assert(bit_next_power_of_two(5) == 8);
    assert(bit_leading_zeros(1) == 63);
    assert(bit_trailing_zeros(8) == 3);
    assert(bit_mask(4) == 15);
    println("bits OK");

    // ─── fmt ───
    assert(str_equal(fmt_int(42), "42"));
    assert(str_equal(fmt_hex(255), "ff"));
    assert(str_equal(fmt_hex_prefix(255), "0xff"));
    assert(str_equal(fmt_bool(true), "true"));
    assert(str_equal(fmt_commas(1234567), "1,234,567"));
    assert(str_equal(fmt_pad_right("hi", 5), "hi   "));
    assert(str_equal(fmt_pad_left("hi", 5), "   hi"));
    println("fmt OK");

    // ─── result ───
    val ok = ResultValue_ok(42);
    assert(resultvalue_is_ok(ok));
    assert(resultvalue_unwrap(ok) == 42);
    assert(resultvalue_unwrap_or(ok, 0) == 42);
    val err = ResultValue_err(99);
    assert(resultvalue_is_err(err));
    assert(resultvalue_unwrap_or(err, 0) == 0);
    println("result OK");

    // ─── hash ───
    val h1 = hash_str("hello");
    val h2 = hash_str("hello");
    assert(h1 == h2);
    val h3 = hash_str("world");
    assert(h1 != h3);
    println("hash OK");

    // ─── iter ───
    val iv = Vec::new();
    iv.push(1); iv.push(2); iv.push(3); iv.push(4); iv.push(5);
    assert(iter_sum(iv) == 15);
    assert(iter_min(iv) == 1);
    assert(iter_max(iv) == 5);
    assert(iter_product(iv) == 120);
    val range = iter_range(0, 5);
    assert(range.len() == 5);
    assert(range.get(0) == 0);
    assert(range.get(4) == 4);
    println("iter OK");

    // ─── path ───
    assert(str_equal(path_join("foo", "bar"), "foo/bar"));
    assert(str_equal(path_join("foo/", "bar"), "foo/bar"));
    assert(str_equal(path_basename("/a/b/c.txt"), "c.txt"));
    assert(str_equal(path_dirname("/a/b/c.txt"), "/a/b"));
    assert(str_equal(path_extension("file.txt"), ".txt"));
    assert(str_equal(path_stem("file.txt"), "file"));
    assert(path_is_absolute("/home"));
    println("path OK");

    // ─── units ───
    val d = meters(100.0);
    val t = seconds(10.0);
    val vel = velocity(d, t);
    assert(vel.value == 10.0);
    val m = kilograms(2.0);
    val e = meters_per_second2(9.8);
    val f = force(m, e);
    assert(f.value == 19.6);
    println("units OK");

    // ─── uuid ───
    val u = uuid_v4();
    val ustr = uuid_to_string(u);
    assert(str_len(ustr) == 36);
    assert(uuid_version(u) == 4);
    val nil = uuid_nil();
    assert(uuid_is_nil(nil));
    println("uuid OK");

    // ─── random ───
    random_seed(42);
    val r1 = random_int(100);
    val r2 = random_int(100);
    assert(r1 >= 0 && r1 < 100);
    assert(r2 >= 0 && r2 < 100);
    println("random OK");

    println("\nAll new stdlib tests passed!");
    return 0;
}
