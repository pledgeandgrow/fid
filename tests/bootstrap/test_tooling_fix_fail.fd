// expect-error: it is declared with `val`
// TL3 (docs/roadmap/competitive-roadmap.md): the input of `fid fix` in
// scripts/tl-check.sh. As written it is rejected: `total` is declared with
// `val` and then changed, and `totl` is misspelled. `fid fix` on a copy
// changes `val total` to `var total` and `totl` to `total`, and removes the
// unused `use string;`; the fixed program prints:
//   6

use string;

fn main() -> i64 {
    val total: i64 = 0;
    var i: i64 = 1;
    while i <= 3 {
        total = total + i;
        i = i + 1;
    }
    print(totl);
    print("\n");
    return 0;
}
