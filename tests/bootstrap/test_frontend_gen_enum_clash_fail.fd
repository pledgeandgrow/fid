// expect-error: generated enum 'Color' collides with a type already declared
// LG9: a generated enum never silently replaces or shadows a type the
// program declares (generated enums were dropped without a word before).
enum Color { Red, Blue }

fn main() -> i64 {
    comptime gen {
        return "enum Color { Green }";
    }
    println(1);
    return 0;
}
