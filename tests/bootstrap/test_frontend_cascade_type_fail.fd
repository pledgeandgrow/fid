// expect-error: unknown type 'Foo'
// CE6: an annotation naming a type that does not exist is one error, an
// unknown type, not also "cannot assign i64 to variable 'a' of type Foo".
// The same misspelt type written again in the function is not reported
// again, and every use of the variables (an operand, a condition, a field,
// a method, a call, a tuple, `?`, a range bound) adds nothing.
// tests/cascade/check.sh checks the count (one error).

fn mk() -> i64 {
    return 3;
}

fn half(n: i64) -> i64 {
    return n / 2;
}

fn main() -> i64 {
    val a: Foo = mk();
    val b: Foo = 4;
    val c: Vec<Foo> = 5;
    val d = a + 1;
    val e = -b;
    if a {
        println("a");
    }
    if a == 1 && b {
        println("b");
    }
    val f = a.x;
    val g = b.len();
    val h = half(a);
    val (p, q) = c;
    val r = p + q;
    for i in 0..a {
        println("i");
    }
    val s = a();
    return 0;
}
