// Bugs roadmap BG261/BG262: consts and globals whose initializers have
// their declared types still compile: a negative literal in a signed
// type, a float, a string, a bool, a Vec and a function value.
//
// Expected output:
// 255 -128 2.5 hi true
// 0 3
// 42
const C8: u8 = 255;
const CN: i8 = -128;
const CF: f64 = 2.5;
const CS: str = "hi";
var GB: bool = true;
var GV: Vec<i64> = Vec::new();
var GT: i64 = 3;

fn answer(x: i64) -> i64 {
    return x + 40;
}

var GF: fn(i64) -> i64 = answer;

fn main() -> i64 {
    println(f"{C8} {CN} {CF} {CS} {GB}");
    println(f"{GV.len()} {GT}");
    val g = GF;
    println(g(2));
    return 0;
}
