// expect-error: the pack 'xs' (`...xs: T`) has no single type
// L8E: a pack can be passed on only to a variadic function (whose last
// arguments its elements become); handed to an ordinary parameter it would
// need one type, which its elements do not share (mono.fd mono_pack_misuse).

fn takes_one(v: i64) -> i64 {
    return v;
}

fn pass_on<T>(...xs: T) -> i64 {
    return takes_one(xs);
}

fn main() -> i64 {
    println(int_to_str(pass_on(1)));
    return 0;
}
