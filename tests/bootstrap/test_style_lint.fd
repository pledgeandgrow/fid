// fid lint: naming conventions and import order (roadmap L7E). The
// program runs on every backend; `fid lint` on it reports:
//   line 15: imports are not sorted: 'use core' should come before 'use string'
//   line 17: constant 'maxItems' should be SCREAMING_SNAKE_CASE: MAX_ITEMS
//   line 19: struct 'point_pair' should be UpperCamelCase: PointPair
//   line 24: function 'computeTotal' should be snake_case: compute_total
//   line 25: variable 'runningSum' in 'computeTotal' should be snake_case: running_sum
// (and, from the unused-import lint, that 'string' is imported unused).
// Names that follow the conventions, `Type_method` free functions and
// constant-like functions (`fn LIMIT_DEFAULT()`) are not reported.
// Expected output:
// 7
// 3
use string;
use core;

const maxItems: i64 = 3;

struct point_pair {
    a: i64,
    b: i64,
}

fn computeTotal(p: point_pair) -> i64 {
    var runningSum: i64 = p.a;
    runningSum = runningSum + p.b;
    return runningSum;
}

fn PointPair_first(p: point_pair) -> i64 {
    return p.a;
}

fn LIMIT_DEFAULT() -> i64 {
    return maxItems;
}

fn main() -> i64 {
    val p: point_pair = point_pair { a: 3, b: 4 };
    println(computeTotal(p) + PointPair_first(p) - 3);
    println(LIMIT_DEFAULT());
    return 0;
}
