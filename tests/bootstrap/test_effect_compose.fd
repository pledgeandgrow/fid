// L3A: Composable handlers — handler A delegates to handler B
fn main() {
    handle {
        handle {
            do IO.print(1);
        } with {
            IO.print(v) => {
                println(v);
                // Resume inner continuation
                resume(cont, 0);
            }
        }
        // After inner handle, continue
        println(3);
    } with {
        IO.print(v) => {
            println(v);
            resume(cont, 0);
        }
    }
}
