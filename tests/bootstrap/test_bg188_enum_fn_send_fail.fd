// expect-error: which is not @send
// Bugs roadmap BG188: an enum payload holding a function value (which may
// be a closure sharing its captures, BG75) was taken as @send.
enum Job {
    Run(fn(i64) -> i64),
    Nop,
}

fn work(j: Job) -> i64 {
    match j {
        Job::Run(f) => {
            return f(1);
        }
        Job::Nop => {
            return 0;
        }
    }
}

fn add1(n: i64) -> i64 {
    return n + 1;
}

fn main() {
    val t = spawn work(Job::Run(add1));
    println(await t);
}
