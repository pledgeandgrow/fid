// LG3: a user method is treated by its receiver: `peek` takes `&self`, so
// calling it while `r` borrows `c` is a read, not a change (every method
// outside a fixed list of builtin readers counted as changing its receiver).
// Expected output:
// 4
// 4
// 5
struct Counter {
    n: i64,
}

impl Counter {
    fn peek(self: &Counter) -> i64 {
        return self.n;
    }
    fn bump(self: &mut Counter) -> void {
        self.n = self.n + 1;
    }
}

fn main() -> i64 {
    var c: Counter = Counter { n: 4 };
    val r = &c;
    val v = c.peek();
    println(r.n);
    println(v);
    c.bump();
    println(c.n);
    return 0;
}
