// expect-error: cannot create &t.m.d
// SP10: `&t.m.d` while `&mut t.m` is alive: a parent path is mutably
// borrowed. `t.n` is borrowed too, so the walk from the root passes a
// prefix (`t`) that has borrows under it but none on it, and must go on
// to `t.m`.
struct Deep { x: i64 }
struct Mid { d: Deep, k: i64 }
struct Top { m: Mid, n: i64 }

fn rd(r: &Deep) -> i64 { return r.x; }
fn bump(r: &mut i64) { *r = *r + 1; }
fn bump_mid(r: &mut Mid) { r.k = r.k + 1; }

fn main() -> i64 {
    var t = Top { m: Mid { d: Deep { x: 3 }, k: 7 }, n: 10 };
    val rb = &mut t.n;
    val rm = &mut t.m;
    val rdd = &t.m.d;
    bump(rb);
    bump_mid(rm);
    print(rd(rdd));
    return 0;
}
