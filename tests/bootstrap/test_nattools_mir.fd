// llvm-roadmap DB7: the MIR after each machine stage. `fid explain <file>
// --stages square` (also `fid emit ... --explain square`) sets nat_ir.fd's
// g_nat_dump, and the machine layer prints square's MIR on stderr after
// selection, after the cold-path layout, the peephole and branch fusion,
// then with its registers after allocation, between the IR stages and the
// machine code main.fd already prints. FID_NAT_DUMP=square does the same
// for any native build. scripts/nat-tools-check.sh checks the headings
// ("[mir] square after selection" ...). Same output on every backend.
// Expected output:
// 49
// 3

fn square(x: i64) -> i64 {
    // a loop, so the inliner leaves it a function of its own
    var n: i64 = x;
    if n < 0 {
        n = 0 - n;
    }
    var total: i64 = 0;
    var i: i64 = 0;
    while i < n {
        total = total + n;
        i = i + 1;
    }
    return total;
}

fn main() {
    print(square(7));
    print("\n");
    print(square(0 - 1) + 2);
    print("\n");
}
