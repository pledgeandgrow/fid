// Bugs roadmap BG420: the opt-in `simplify` pass (FID_IROPT_ON=simplify or
// all) folded a float compared with itself: `x != x` became false and
// `x == x` / `x <= x` true, so a NaN test was always false (semantics-2 §5:
// every comparison with NaN is false except `!=`). Run it with
// FID_IROPT_ON=simplify on emit and --nat to check the pass; an integer
// compared with itself is still folded.
//
// Expected output:
// true false
// false false true
// false true
fn isnan(x: f64) -> bool {
    return x != x;
}
fn le_self(x: f64) -> bool {
    return x <= x;
}
fn eq_self(x: f64) -> bool {
    return x == x;
}
fn ieq(n: i64) -> bool {
    return n == n;
}
fn ilt(n: i64) -> bool {
    return n < n;
}
fn main() {
    val z: f64 = 0.0;
    val n = z / z;
    println(f"{isnan(n)} {isnan(1.5)}");
    println(f"{le_self(n)} {eq_self(n)} {eq_self(2.0)}");
    println(f"{ilt(4)} {ieq(4)}");
}
