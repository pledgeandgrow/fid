// expect-error: variadic
// Expected to FAIL (L8E): every extra argument of `...xs: i64` must be an
// i64; a str among them is a type error.
fn sum(...xs: i64) -> i64 {
    var t: i64 = 0;
    for x in xs {
        t = t + x;
    }
    return t;
}

fn main() {
    println(int_to_str(sum(1, "two", 3)));
}
