// OP24: expected to fail at run time (integer overflow). Vec::filled(n, ..)
// bounds n by 2^48 only after it returned: here it runs in one branch, so
// after the `if` n is only known >= 0 and n * 1000 keeps its check
// (compiler/checks.fd: the call's fact is recorded for its own block and
// the blocks it dominates). If the fact leaked past the join, the multiply
// of 92233720368547758 would wrap instead of panicking.

fn scale(n: i64, make: bool) -> i64 {
    if n < 0 {
        return 0;
    }
    var t: i64 = 0;
    if make {
        var v: Vec<i64> = Vec::filled(n, 0);
        t = v.len();
    }
    return n * 1000 + t;
}

fn main() {
    println(scale(3, true));
    println(scale(92233720368547758, false));
    print("unreachable\n");
}
