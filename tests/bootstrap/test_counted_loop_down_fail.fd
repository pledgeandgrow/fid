// LF7: expected to fail at run time (index out of bounds). In a loop
// counting down with the test `i > 0`, `i` is in [1, v.len()] before the
// decrement: `v.get(i)` read there is out of bounds on the first iteration
// (i == v.len()), so its check stays (compiler/checks.fd peir_counted_down
// proves only the reads after the decrement). A proof that took every read
// of `i` in the loop would read past the end instead of panicking.

fn sum_down_early(v: & Vec<i64>) -> i64 {
    var t: i64 = 0;
    var i: i64 = v.len();
    while i > 0 {
        t = t + v.get(i);
        i = i - 1;
    }
    return t;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    println(sum_down_early(& v));
    print("unreachable\n");
}
