// Test: char literals lex to their Unicode scalar value (R1.7)

fn count_slashes(s: str) -> i64 {
    var n: i64 = 0;
    var i: i64 = 0;
    while i < str_len(s) {
        if str_byte_at(s, i) == '/' { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn main() {
    assert_msg('a' == 97, "'a' == 97");
    assert_msg('/' == 47, "'/' == 47");
    assert_msg('z' - 'a' == 25, "char arithmetic");
    assert_msg('\n' == 10, "newline escape");
    assert_msg('\t' == 9, "tab escape");
    assert_msg('\r' == 13, "carriage return escape");
    assert_msg('\0' == 0, "NUL escape");
    assert_msg('\\' == 92, "backslash escape");
    assert_msg('\'' == 39, "quote escape");
    assert_msg('"' == 34, "double quote needs no escape");
    assert_msg('\x41' == 65, "hex escape");
    assert_msg('\u{1F600}' == 128512, "unicode escape");
    assert_msg('é' == 233, "multi-byte UTF-8 char");
    assert_msg(count_slashes("a/b/c") == 2, "compare against str_byte_at");
    print("char literals OK\n");
}
