// Test: Heap allocation builtins (Phase 10A)
// Tests the alloc stdlib module — __alloc, __free, __alloc_array.
// We only check that allocations succeed (non-zero) and frees don't crash.
// Pointer values differ between backends (interpreter vs real malloc), so
// we don't print them.

use alloc;

fn main() {
    // Basic allocation
    val ptr = __alloc(1024);
    if ptr == 0 {
        print("FAIL: alloc returned null\n");
        return;
    }

    // Array allocation
    val arr = __alloc_array(100, 8);
    if arr == 0 {
        print("FAIL: alloc_array returned null\n");
        return;
    }

    // Free (no-op in interpreter, but should not crash)
    __free(ptr);
    __free(arr);

    print("OK\n");
}
