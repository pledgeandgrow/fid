// Bugs roadmap BG414: bool and integer guards still compile.
//
// Expected output:
// big
// one
// 1
fn main() {
    val x: i64 = 30;
    match x {
        n if n > 10 => {
            println("big");
        }
        _ => {
            println("small");
        }
    }
    val flag: i64 = 1;
    match 1 {
        1 if flag => {
            println("one");
        }
        _ => {
            println("other");
        }
    }
    val r = match x {
        30 if x == 30 => 1,
        _ => 2,
    };
    println(r);
}
