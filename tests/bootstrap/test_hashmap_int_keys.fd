// A HashMap with integer keys hashes and compares the keys as numbers (it
// read them as string pointers and crashed). 0 and -1 are ordinary keys.

fn main() {
    var m: HashMap<i64, i64> = HashMap::new();
    m.insert(0, 10);
    m.insert(-1, 20);
    m.insert(42, 30);
    m.insert(42, 31);
    var i: i64 = 100;
    while i < 200 {
        m.insert(i, i * 2);
        i = i + 1;
    }
    println(m.get(42));
    println(m.get(-1));
    println(m.contains(0));
    println(m.len());
    m.remove(0);
    println(m.contains(0));
    println(m.get(150));
    println(m.get_or(7, 99));
    val ks: Vec<i64> = m.keys();
    println(ks.get(0));
    println(ks.len());
}
