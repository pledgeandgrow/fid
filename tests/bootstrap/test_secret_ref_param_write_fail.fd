// expect-error: in 'main', a secret value reaches output 'println'
// Expected to FAIL (BG33, docs/roadmap/bugs-roadmap.md): `put` writes its
// argument into the Vec its `&mut` parameter names. Its summary did not
// say so, so after `put(&mut v, key)` the Vec looked public and printing
// its element was accepted. The summary now records what each reference
// parameter receives: `v` holds the secret.
fn put(v: &mut Vec<i64>, k: i64) {
    v.push(k);
}

fn main() -> i64 {
    @secret val key: i64 = 42;
    var v: Vec<i64> = Vec::new();
    put(&mut v, key);
    println(int_to_str(v.get(0)));
    return 0;
}
