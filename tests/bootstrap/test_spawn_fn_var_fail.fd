// expect-error: not @send
// Bugs roadmap BG75: closures and `dyn Trait` are not @send — a closure
// literal's captures are checked directly, but a `fn` value held in a
// variable still counted as @send, though it may be a closure whose
// captured state would be shared across threads, not copied.
fn apply(f: fn(i64) -> i64, x: i64) -> i64 { return f(x); }
fn add1(n: i64) -> i64 { return n + 1; }
fn main() -> i64 {
    val cb: fn(i64) -> i64 = add1;
    var t = spawn apply(cb, 5);
    println(await t);
    return 0;
}
