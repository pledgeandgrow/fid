// BG453 (docs/roadmap/bugs-roadmap.md): JSON Schema multipleOf rejects a
// negative number that is not a multiple (the remainder of a negative
// quotient was negative, so the test never fired and -3 was a "multiple of
// 2"). JSON Schema 2020-12 section 6.2.1; the values are Python
// jsonschema's (Draft202012Validator.is_valid).
//
// Expected output:
// false
// false
// false
// true
// true
// false
// false
// true
// true
// true
use jsonschema;

fn yn(b: bool) -> str {
    if b {
        return "true";
    }
    return "false";
}

fn main() -> i64 {
    // the entry's triggers
    println(yn(jsonschema_valid("{\"type\":\"integer\",\"multipleOf\":2}", "-3")));
    println(yn(jsonschema_valid("{\"type\":\"integer\",\"multipleOf\":2}", "-7")));
    println(yn(jsonschema_valid("{\"type\":\"integer\",\"multipleOf\":2}", "3")));
    // negative multiples and zero still pass
    println(yn(jsonschema_valid("{\"type\":\"integer\",\"multipleOf\":2}", "-4")));
    println(yn(jsonschema_valid("{\"type\":\"integer\",\"multipleOf\":2}", "0")));
    // a fractional divisor
    println(yn(jsonschema_valid("{\"multipleOf\":0.5}", "-0.75")));
    println(yn(jsonschema_valid("{\"multipleOf\":0.5}", "0.75")));
    println(yn(jsonschema_valid("{\"multipleOf\":0.5}", "-1.5")));
    println(yn(jsonschema_valid("{\"multipleOf\":0.5}", "2.5")));
    // a quotient far outside i64 is an integer
    println(yn(jsonschema_valid("{\"multipleOf\":3}", "-1e300")));
    return 0;
}
