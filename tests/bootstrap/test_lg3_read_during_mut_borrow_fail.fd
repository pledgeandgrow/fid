// expect-error: cannot read m
// LG3 (docs/roadmap/competitive-roadmap.md): a read is checked against a
// live mutable borrow, as a mutation is (reference 8.4, rule 4). `r` holds
// a mutable borrow of `m` and is used after the read, so `m` cannot be
// read in between.
fn id_mut<'a>(x: &'a mut i64) -> &'a mut i64 {
    return x;
}

fn main() -> i64 {
    var m: i64 = 1;
    val r = id_mut(&mut m);
    val v = m;
    *r = v + 1;
    println(*r);
    return 0;
}
