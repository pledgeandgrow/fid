// stdlib-agent-bugs 6: float_to_str of an infinity never returned (the C
// runtime's formatting, which `fid run` uses too, divided it by 10 forever)
// and println of a NaN printed "-nan(ind)". Now "inf", "-inf" and "NaN",
// the native runtimes' text.
// Expected output:
// inf
// -inf
// NaN
// NaN
// inf
// -inf
// 1.5 -0.25 3
fn main() {
    val z: f64 = 0.0;
    println(float_to_str(1.0 / z));
    println(float_to_str(0.0 - 1.0 / z));
    println(float_to_str(z / z));
    println(z / z);
    println(1.0 / z);
    println(0.0 - 1.0 / z);
    println(float_to_str(1.5) + " " + float_to_str(0.0 - 0.25) + " " + float_to_str(3.0));
}
