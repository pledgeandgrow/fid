// WP11 (docs/roadmap/llvm-roadmap.md) on the machine layer
// (compiler/nat_ir.fd ng_crashfree_check): a @crashfree function's checks
// are verified after the MIR folds, so correct @crashfree code builds as
// before. Here: @wrapping arithmetic (no overflow checks at all), a
// division by a literal (its zero check folds away), a loop and
// vec_get_or. The wrong annotation is test_machine_crashfree_fail.fd.
// Check: fid emit --target x86_64-linux|aarch64-linux|riscv64-linux builds
// this and the output matches `fid run`.
// Expected output:
// 42
// 9
// 15
// 0
// -9223372036854775808
// crashfree OK

@crashfree @wrapping
fn mix(a: i64, b: i64) -> i64 {
    return a * b + 2;
}

@crashfree @wrapping
fn tenth(a: i64) -> i64 {
    return a / 10;
}

@crashfree @wrapping
fn sum_to(n: i64) -> i64 {
    var s: i64 = 0;
    for i in 1..6 {
        s = s + i;
    }
    return s + n - 5;
}

@crashfree @wrapping
fn first_or_zero(v: Vec<i64>) -> i64 {
    return vec_get_or(v, 0, 0);
}

@crashfree @wrapping
fn wrap_add(a: i64) -> i64 {
    return a + 1;
}

fn main() {
    println(mix(5, 8));
    println(tenth(95));
    println(sum_to(5));
    var e: Vec<i64> = Vec::new();
    println(first_or_zero(e));
    println(wrap_add(9223372036854775807));
    print("crashfree OK\n");
}
