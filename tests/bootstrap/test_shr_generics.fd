// Test: `>>` closes nested generic lists and still works as a shift (R1.5)

struct Grid {
    rows: Vec<Vec<i64>>,
}

fn make_grid() -> Vec<Vec<i64>> {
    var g: Vec<Vec<i64>> = Vec::new();
    var row: Vec<i64> = Vec::new();
    row.push(7);
    g.push(row);
    return g;
}

fn main() {
    // `>>` in type position
    var g: Vec<Vec<i64>> = make_grid();
    assert_msg(g.len() == 1, "Vec<Vec<i64>> holds one row");
    var deep: Vec<Vec<Vec<i64>>> = Vec::new();
    assert_msg(deep.len() == 0, "triple-nested generic parses");
    val grid = Grid { rows: make_grid() };
    assert_msg(grid.rows.len() == 1, "generic struct field");

    // `>>=` and `>=` right after a generic list
    var h: Vec<Vec<i64>>= make_grid();
    assert_msg(h.len() == 1, "Vec<Vec<i64>>= splits into > and >=");

    // `>>` as an arithmetic (sign-preserving) shift
    val a: i64 = 1000;
    assert_msg((a >> 3) == 125, "1000 >> 3 == 125");
    var b: i64 = 256;
    b >>= 2;
    assert_msg(b == 64, "256 >>= 2 == 64");
    assert_msg((-16 >> 2) == -4, "-16 >> 2 == -4");
    assert_msg((-1 >> 1) == -1, "-1 >> 1 == -1 (arithmetic shift)");
    assert_msg((-3 >> 1) == -2, "-3 >> 1 == -2 (floor, not truncation)");
    print("shr generics OK\n");
}
