// Test (stdlib-agent bugs 31, 38, 47): function values kept in a Vec, taken
// out with get() and called. The interpreter panicked "CallPtr: function
// pointer is not a string or pointer": an element comes back as a plain
// word, which is the same closure env. Named functions and closures (one
// capturing a local) both. Also run it through `fid ccompile`.
// Expected output:
// 7
// 12
// 11
// add mul
fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn mul(a: i64, b: i64) -> i64 {
    return a * b;
}

fn name_add(x: i64) -> str {
    return "add";
}

fn name_mul(x: i64) -> str {
    return "mul";
}

fn main() {
    var v: Vec<fn(i64, i64) -> i64> = Vec::new();
    v.push(add);
    v.push(mul);
    var i: i64 = 0;
    while i < v.len() {
        val f = v.get(i);
        println(f(3, 4));
        i = i + 1;
    }
    val k: i64 = 10;
    var w: Vec<fn(i64) -> i64> = Vec::new();
    w.push(fn(x: i64) -> i64 {
        return x + k;
    });
    val g = w.get(0);
    println(g(1));
    var names: Vec<fn(i64) -> str> = Vec::new();
    names.push(name_add);
    names.push(name_mul);
    val n0: fn(i64) -> str = names.get(0);
    val n1 = names.get(1);
    println(n0(0) + " " + n1(0));
}
