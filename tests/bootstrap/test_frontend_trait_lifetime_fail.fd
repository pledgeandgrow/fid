// expect-error: ties its result to parameter 'other', but the trait's method ties it to 'self'
// LG3: lifetimes on a trait's method are part of its signature: the trait
// says the result borrows from `self`, so an impl returning a borrow of
// `other` breaks what a caller through the trait relies on.
cap Pick {
    fn pick<'a>(self: &'a Self, other: &i64) -> &'a i64;
}

struct Two {
    v: i64,
}

impl Pick for Two {
    fn pick<'a, 'b>(self: &'a Two, other: &'b i64) -> &'b i64 {
        return other;
    }
}

fn main() -> i64 {
    var t: Two = Two { v: 1 };
    var x: i64 = 2;
    println(*t.pick(&x));
    return 0;
}
