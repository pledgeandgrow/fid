// stdlib/decimal: exact decimals of any size (competitive SL16): parsing
// with scale and exponent, exact add/sub/mul, division and rounding in
// every mode (half-even ties to the even digit), comparison by value.
//
// Expected output:
// 0.3
// 12.50 + 0.005 = 12.505
// 1.5 * 1.5 = 2.25
// 1/3 = 0.33333
// 2/3 = 0.66667
// -2/3 down = -0.66666
// 2.5 -> 2 3 2 3 2 3
// -2.5 -> -2 -3 -2 -3 -3 -2
// 1.2345e3 = 1234.5
// 99999999999999999999.99 + 0.01 = 100000000000000000000.00
// equal true, 2.500 normalizes to 2.5
// 7
use decimal;

fn main() -> i64 {
    println(dec_to_str(dec_add(dec_parse("0.1"), dec_parse("0.2"))));
    println("12.50 + 0.005 = " + dec_to_str(dec_add(dec_parse("12.50"), dec_parse("0.005"))));
    println("1.5 * 1.5 = " + dec_to_str(dec_mul(dec_parse("1.5"), dec_parse("1.5"))));
    println("1/3 = " + dec_to_str(dec_div(dec_from_i64(1), dec_from_i64(3), 5, DEC_HALF_EVEN)));
    println("2/3 = " + dec_to_str(dec_div(dec_from_i64(2), dec_from_i64(3), 5, DEC_HALF_EVEN)));
    println("-2/3 down = " + dec_to_str(dec_div(dec_from_i64(-2), dec_from_i64(3), 5, DEC_DOWN)));
    var x: Decimal = dec_parse("2.5");
    println("2.5 -> " + modes(x));
    println("-2.5 -> " + modes(dec_parse("-2.5")));
    println("1.2345e3 = " + dec_to_str(dec_parse("1.2345e3")));
    println("99999999999999999999.99 + 0.01 = " + dec_to_str(dec_add(dec_parse("99999999999999999999.99"), dec_parse("0.01"))));
    var e: bool = dec_eq(dec_parse("2.500"), dec_parse("2.5"));
    println("equal " + bs(e) + ", 2.500 normalizes to " + dec_to_str(dec_normalize(dec_parse("2.500"))));
    println(dec_to_i64(dec_parse("7.99")));
    return 0;
}

/// x rounded to 0 places: half-even, half-up, down, up, floor, ceiling
fn modes(x: Decimal) -> str {
    return dec_to_str(dec_round(x, 0, DEC_HALF_EVEN)) + " " + dec_to_str(dec_round(x, 0, DEC_HALF_UP)) + " "
        + dec_to_str(dec_round(x, 0, DEC_DOWN)) + " " + dec_to_str(dec_round(x, 0, DEC_UP)) + " "
        + dec_to_str(dec_round(x, 0, DEC_FLOOR)) + " " + dec_to_str(dec_round(x, 0, DEC_CEILING));
}

fn bs(b: bool) -> str {
    if b { return "true"; }
    return "false";
}
