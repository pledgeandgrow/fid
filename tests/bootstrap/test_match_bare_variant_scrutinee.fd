// Test (BG11): a variant pattern written without its enum (`X(n)`,
// `Ok(v)`) takes its tag from the scrutinee's enum. A and B have X and Y
// at swapped indexes: the lowering took the tag from the last enum with a
// variant of that name (B) and the payload types from the first (A), so
// `match a { X(n) => .. }` on an A::X took the Y arm. Reply has an `Ok`
// at another index than Result's: a bare `Ok(v)` on a Result still reads
// Result's tag. Both the statement match and the match value are checked.
//
// Expected output:
// X 5
// Y 6
// b X 7
// b Y 8
// 105
// 206
// ok 21
// err odd
// reply ok 3
// reply busy

enum A { X(i64), Y(i64) }

enum B { Y(i64), X(i64) }

enum Reply { Busy, Ok(i64) }

fn show_a(a: A) {
    match a {
        X(n) => { println("X " + int_to_str(n)); }
        Y(n) => { println("Y " + int_to_str(n)); }
    }
}

fn show_b(b: B) {
    match b {
        X(n) => { println("b X " + int_to_str(n)); }
        Y(n) => { println("b Y " + int_to_str(n)); }
    }
}

fn code_a(a: A) -> i64 {
    val c = match a {
        X(n) => { 100 + n }
        Y(n) => { 200 + n }
    };
    return c;
}

fn half(x: i64) -> Result<i64, str> {
    if x % 2 == 0 {
        return Result::Ok(x / 2);
    }
    return Result::Err("odd");
}

fn show_r(x: i64) {
    val r: Result<i64, str> = half(x);
    match r {
        Ok(v) => { println("ok " + int_to_str(v)); }
        Err(e) => { println("err " + e); }
    }
}

fn show_reply(p: Reply) {
    match p {
        Ok(n) => { println("reply ok " + int_to_str(n)); }
        _ => { println("reply busy"); }
    }
}

fn main() -> i64 {
    val a: A = A::X(5);
    show_a(a);
    show_a(A::Y(6));
    show_b(B::X(7));
    show_b(B::Y(8));
    println(code_a(A::X(5)));
    println(code_a(A::Y(6)));
    show_r(42);
    show_r(7);
    show_reply(Reply::Ok(3));
    show_reply(Reply::Busy);
    return 0;
}
