// stdlib/pqc: SHA3-256/512 and SHAKE128/256 against FIPS 202 examples
// and Python's hashlib (including a message longer than the rate and an
// output longer than one squeeze); ML-KEM-768 against OpenSSL 3.5:
// keygen from the seed 00 01 .. 3f gives OpenSSL's encapsulation key
// (compared through its SHA3-256), OpenSSL's ciphertext decapsulates to
// OpenSSL's shared secret, a ciphertext with one bit flipped gives the
// implicit-rejection key OpenSSL gives, our encapsulation round trips
// (OpenSSL decapsulates it to the same key: checked when the test was
// written), and an encapsulation key with a coefficient >= q is refused.
// Expected output:
// sha3-256 abc 3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532
// sha3-256 empty a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a
// sha3-512 abc b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0
// shake128 empty 7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26
// shake256 abc 483366601360a8771c6863080cc4114d8db44530f8f1e1ee4f94ea37e78b5739d5a15bef186a5386c75744c0527e1faa9f8726e462a12a4feb06bd8801e751e4
// sha3-256 200 zeros 2b43036c229ba512995f91fdb46fcd5327a4dc834d86d6e0f58a08053346dc2e
// shake128 400 bytes tail 3396020392e85506d2042fffff5a39e0
// ek 1184 dk 2400 H(ek) a24e16d8f8f9383a95b77050f4d9fd2f5733eec1d63ef3c23ebf9918173669a7
// openssl ct decaps 662356d60a1bdef889d166773389ff6cfd5caab8751d98f4361c1eca8e190e1f
// tampered ct c47292390e56c89a62543b21c940c729dd6545e50b7a7dbd718a58db4d1bb816
// our encaps ct 1088 round trip true
// bad ek refused true
use pqc;
use vec;
use encoding;

fn hx(v: Vec<i64>) -> str { return hex_encode_bytes(v); }

fn main() {
    println("sha3-256 abc " + hx(sha3_256(str_bytes("abc"))));
    println("sha3-256 empty " + hx(sha3_256(Vec::new())));
    println("sha3-512 abc " + hx(sha3_512(str_bytes("abc"))));
    println("shake128 empty " + hx(shake128(Vec::new(), 32)));
    println("shake256 abc " + hx(shake256(str_bytes("abc"), 64)));
    var z: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 200 { z.push(0); i = i + 1; }
    println("sha3-256 200 zeros " + hx(sha3_256(z)));
    var r: Vec<i64> = Vec::new();
    i = 0;
    while i < 256 { r.push(i); i = i + 1; }
    val long: Vec<i64> = shake128(r, 400);
    var t: Vec<i64> = Vec::new();
    i = 384;
    while i < 400 { t.push(long.get(i)); i = i + 1; }
    println("shake128 400 bytes tail " + hx(t));
    var seed: Vec<i64> = Vec::new();
    i = 0;
    while i < 64 { seed.push(i); i = i + 1; }
    val kp: MlkemKeyPair = mlkem768_keygen(seed);
    println("ek " + int_to_str(kp.ek.len()) + " dk " + int_to_str(kp.dk.len()) + " H(ek) " + hx(sha3_256(kp.ek)));
    val ct: Vec<i64> = hex_decode_bytes("");
    println("openssl ct decaps " + hx(mlkem768_decaps(kp.dk, ct)));
    var bad: Vec<i64> = ct;
    bad.set(0, bad.get(0) ^ 1);
    println("tampered ct " + hx(mlkem768_decaps(kp.dk, bad)));
    var m: Vec<i64> = Vec::new();
    i = 0;
    while i < 32 { m.push(0x55); i = i + 1; }
    val e: MlkemEncap = mlkem768_encaps(kp.ek, m);
    match env_var("FIDES_PQC_DUMP") {
        Option::Some(x) => { println("dump ct " + hx(e.ct)); println("dump key " + hx(e.key)); }
        Option::None => { }
    }
    println("our encaps ct " + int_to_str(e.ct.len()) + " round trip " + bool_to_str(str_equal(hx(mlkem768_decaps(kp.dk, e.ct)), hx(e.key))));
    var bek: Vec<i64> = kp.ek;
    bek.set(0, 255);
    bek.set(1, 255);
    val be: MlkemEncap = mlkem768_encaps(bek, m);
    println("bad ek refused " + bool_to_str(!be.ok));
}
