// Test: Derive macros — @derive(Debug) and @derive(Clone) (Phase 7.7)
//
// @derive(Debug) generates a debug_str() method that returns a string representation.
// @derive(Clone) generates a clone() method that copies the struct.

@derive(Debug)
@derive(Clone)
struct Point {
    x: i64,
    y: i64,
}

@derive(Debug)
struct Person {
    name: str,
    age: i64,
}

fn main() {
    // Test 1: @derive(Debug) — debug_str method
    val p = Point { x: 10, y: 20 };
    var debug = Point_debug_str(p);
    print("debug = ");
    print(debug);
    print("\n");

    // Test 2: @derive(Clone) — clone method
    val p2 = Point_clone(p);
    print("clone x = ");
    print(p2.x);
    print("\n");
    print("clone y = ");
    print(p2.y);
    print("\n");

    // Test 3: @derive(Debug) on Person
    var person = Person { name: "Alice", age: 30 };
    val person_debug = Person_debug_str(person);
    print("person = ");
    print(person_debug);
    print("\n");

    // Test 4: Verify original is unchanged after clone
    print("original x = ");
    print(p.x);
    print("\n");

    print("OK\n");
}
