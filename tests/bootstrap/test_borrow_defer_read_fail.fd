// expect-error: cannot mutate v: shared borrow(s) are active on it or its fields
// BG140: a `defer` body runs when the scope ends, so reading r there keeps
// r's borrow of v to the scope's end, not to the `defer` statement: the
// pushes after it moved the buffer and the deferred `*r` printed 0.
fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(111);
    val r: &i64 = &v[0];
    defer {
        println(int_to_str(*r));
    }
    var i: i64 = 0;
    while i < 100000 {
        v.push(i);
        i = i + 1;
    }
}
