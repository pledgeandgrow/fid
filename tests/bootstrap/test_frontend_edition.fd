// ST3 (fid): a file states its edition with `#[edition(N)]`. In edition 2026
// (the default) a call of a @deprecated function is a warning, and the
// program runs; test_frontend_edition_2027_fail.fd is the same call in
// edition 2027, where it is an error.
// Expected output:
// 3
#[edition(2026)]

@deprecated(use = "three")
fn old_three() -> i64 {
    return 3;
}

fn three() -> i64 {
    return 3;
}

fn main() -> i64 {
    println(old_three());
    return 0;
}
