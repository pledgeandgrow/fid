// expect-error: function variable 'f' expects 1 args, got 2
//! error: function variable 'f' expects 1 args, got 2
// TL2: a test per diagnostic of the type, borrow and escape checks.
// A closure held in a local is called with its declared parameters.

fn main() -> i64 {
    val f = fn(x: i64) { x + 1 };
    println(f(1, 2));
    return 0;
}
