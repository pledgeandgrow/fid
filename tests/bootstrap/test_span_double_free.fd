// RT8: a large block freed twice panics "Double free" also when its first
// free kept its pages in the span cache (the thread asked for 10 large
// blocks just before, so the cache keeps them).
//
// Expected output:
//   (nothing on stdout; stderr "Panic: Double free", exit code 1)
@unsafe
fn main() -> i64 {
    var i: i64 = 0;
    while i < 10 {
        val b: i64 = p_malloc(2097152);
        p_free(b);
        i = i + 1;
    }
    val c: i64 = p_malloc(2097152);
    p_free(c);
    p_free(c);
    return 0;
}
