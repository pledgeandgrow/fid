// Bugs roadmap BG275: Rc/Arc methods on a local bound without an
// annotation (`val r2 = r.clone();`) were lowered as plain calls: `.get()`
// became Vec_get (index out of bounds), `.count()` an unknown function.
// compiler/lower.fd Lowerer_infer_expr_ast_type now types `r.clone()` of an
// Rc<T> as Rc<T> (and `r.get()` as T, `r.count()` as i64), and
// `Rc::new(x)` as Rc<type of x>, so the variable keeps the Rc type and
// Lowerer_lower_method_call takes its Rc branch.
//
// Expected output:
// 5 2
// 2
// 3

fn main() {
    val r = Rc::new(5);
    val r2 = r.clone();
    println(f"{r2.get()} {r.count()}");
    val a = Rc::new(41);
    val b = a.clone();
    println(b.count());
    val c = b.clone();
    println(a.count());
}
