// expect-error: Linear type error (line 15): variable 'a' is linear but was never consumed
// Expected to FAIL (reference section 8.7): a @linear value is consumed
// exactly once on every path. The `return 5` inside the `if` (no `else`)
// leaves main with `a` unconsumed; only the path past the `if` consumes it.
// The end-of-scope check saw that path alone and accepted the program
// (the if/else form was rejected). Every `return` now checks the linear
// values still live (TypeChecker_linear_check_return).
@linear
struct Tx { id: i64, amount: i64 }

fn commit(t: Tx) -> i64 { return t.amount; }

fn main() -> i64 {
    // the next line is line 15
    val a: Tx = Tx { id: 1, amount: 30 };
    if a.id == 2 {
        return 5;
    }
    return commit(a);
}
