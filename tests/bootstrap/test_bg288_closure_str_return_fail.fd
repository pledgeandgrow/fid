// expect-error: the closure is declared to return str but can reach the end of its body without returning
// Bugs roadmap BG288: with a str result, `fid run` panicked in Str_drop.
fn main() -> i64 {
    val g = fn(y: i64) -> str {
        if y > 0 {
            return "pos";
        }
    };
    println(g(-1));
    return 0;
}
