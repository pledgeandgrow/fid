// expect-error: a Vec of P is made with push
//! error: a Vec of P is made with push
// TL2: a test per diagnostic of the type, borrow and escape checks.
// Vec::filled makes Vecs of numbers, bools, strings, Vecs or maps.

struct P {
    x: i64,
}

fn main() -> i64 {
    val v: Vec<P> = Vec::filled(3, P { x: 1 });
    println(v.len());
    return 0;
}
