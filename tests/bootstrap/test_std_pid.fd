// stdlib/pid: PID on a first-order plant 2/(s+1) with a saturated actuator, anti-windup against plain integration (values from a Python replica), no derivative kick on a setpoint step, integral limits, gain schedule interpolation
// Expected output:
// anti-windup y(1s)=1.2642 y(2s)=1.5591 y(5s)=1.5999 y(10s)=1.6000 peak=1.6000
// plain       y(1s)=1.2642 y(2s)=1.7293 y(5s)=1.6777 y(10s)=1.6000 peak=1.9597
// first output after a step = 2.1000 (P 2.0000 I 0.1000 D 0.0000)
// derivative on measurement = -10.0000
// integral limited to 0.2500: 0.2500
// schedule x=-1: 1.0000 0.1000 0.0000
// schedule x=2.5: 1.5000 0.1500 0.0250
// schedule x=10: 3.0000 0.3000 0.1000
// schedule x=15: 3.5000 0.3000 0.0500
// schedule x=99: 4.0000 0.3000 0.0000
// rows = 3
// bumpless gain change: 0.5000 -> 0.5000
use pid;
use quat;

fn sim(aw: bool) -> str {
    var c: PidCtl = pidc_new(4.0, 6.0, 0.2);
    pidc_set_derivative_filter(&mut c, 0.02);
    pidc_set_output_limits(&mut c, -1.0, 1.0);
    pidc_set_anti_windup(&mut c, aw);
    var plant: FirstOrderPlant = fop_new(2.0, 1.0, 0.0);
    var y: f64 = 0.0;
    var peak: f64 = 0.0;
    var out: str = "";
    var k: i64 = 1;
    while k <= 1000 {
        val u: f64 = pidc_update(&mut c, 1.6, y, 0.01);
        y = fop_step(&mut plant, u, 0.01);
        peak = rmath_max(peak, y);
        if k == 100 || k == 200 || k == 500 || k == 1000 {
            out = out + " y(" + int_to_str(k / 100) + "s)=" + rmath_fmt(y, 4);
        }
        k = k + 1;
    }
    return out + " peak=" + rmath_fmt(peak, 4);
}

fn g(s: & GainSchedule, x: f64) -> str {
    val r: PidGains = gsched_lookup(s, x);
    return rmath_fmt(r.kp, 4) + " " + rmath_fmt(r.ki, 4) + " " + rmath_fmt(r.kd, 4);
}

fn main() -> i64 {
    println("anti-windup" + sim(true));
    println("plain      " + sim(false));

    // a setpoint step: the derivative acts on the measurement, so no kick
    var c: PidCtl = pidc_new(2.0, 1.0, 5.0);
    val u0: f64 = pidc_update(&mut c, 1.0, 0.0, 0.1);
    println("first output after a step = " + rmath_fmt(u0, 4) + " (P " + rmath_fmt(c.last_p, 4) + " I " + rmath_fmt(c.last_i, 4) + " D " + rmath_fmt(c.last_d, 4) + ")");
    // the measurement rises by 0.2 in 0.1 s: D = -kd * 2 = -10
    pidc_update(&mut c, 1.0, 0.2, 0.1);
    println("derivative on measurement = " + rmath_fmt(c.last_d, 4));

    var ci: PidCtl = pidc_new(0.0, 1.0, 0.0);
    pidc_set_integral_limits(&mut ci, -0.25, 0.25);
    var i: i64 = 0;
    while i < 100 {
        pidc_update(&mut ci, 1.0, 0.0, 0.01);
        i = i + 1;
    }
    println("integral limited to 0.2500: " + rmath_fmt(ci.i_term, 4));

    var s: GainSchedule = gsched_new();
    gsched_add(&mut s, 10.0, 3.0, 0.3, 0.1);
    gsched_add(&mut s, 0.0, 1.0, 0.1, 0.0);
    gsched_add(&mut s, 20.0, 5.0, 0.3, 0.0);
    gsched_add(&mut s, 20.0, 4.0, 0.3, 0.0);
    println("schedule x=-1: " + g(&s, -1.0));
    println("schedule x=2.5: " + g(&s, 2.5));
    println("schedule x=10: " + g(&s, 10.0));
    println("schedule x=15: " + g(&s, 15.0));
    println("schedule x=99: " + g(&s, 99.0));
    println("rows = " + int_to_str(gsched_len(&s)));

    // changing the gains keeps the I term: at zero error the output stays
    var cb: PidCtl = pidc_new(0.0, 1.0, 0.0);
    var j: i64 = 0;
    while j < 50 {
        pidc_update(&mut cb, 1.0, 0.0, 0.01);
        j = j + 1;
    }
    val before: f64 = cb.last_out;
    pidc_apply_schedule(&mut cb, &s, 2.5);
    val after: f64 = pidc_update(&mut cb, 0.0, 0.0, 0.01);
    println("bumpless gain change: " + rmath_fmt(before, 4) + " -> " + rmath_fmt(after, 4));
    return 0;
}
