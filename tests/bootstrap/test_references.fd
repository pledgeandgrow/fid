// References are second-class: what the escape check accepts.
struct Point { x: i64, y: i64 }
enum Shape { Circle(i64), Square(i64) }

// A returned reference may come from a reference parameter.
fn x_of(p: &Point) -> &i64 { return &p.x; }

// Option passes a reference through.
fn pick(a: &i64, b: &i64, first: bool) -> Option<&i64> {
    if first { return Option::Some(a); }
    return Option::Some(b);
}

// Matching through a reference binds plain payload values.
fn area(s: &Shape) -> i64 {
    match s {
        Shape::Circle(r) => { return r * r * 3; }
        Shape::Square(w) => { return w * w; }
    }
    return 0;
}

// A closure may capture a reference parameter and be returned.
fn reader(p: &i64) -> fn() -> i64 {
    return fn() { *p };
}

fn main() {
    val pt: Point = Point { x: 3, y: 4 };
    val r: &i64 = x_of(&pt);
    assert_msg(*r == 3, "reference returned from a reference parameter");

    var a: i64 = 1;
    var b: i64 = 2;
    var which: i64 = 0;
    match pick(&a, &b, false) {
        Option::Some(v) => { which = *v; }
        Option::None => { which = -1; }
    }
    assert_msg(which == 2, "Option<&T> passes the reference through");

    var q: &i64 = &a;
    q = &b;
    assert_msg(*q == 2, "reassigning a reference in the same block");

    val c: Shape = Shape::Circle(2);
    assert_msg(area(&c) == 12, "match through a reference");

    var seven: i64 = 7;
    val f = reader(&seven);
    assert_msg(f() == 7, "closure capturing a reference parameter");
    print("references OK
");
}
