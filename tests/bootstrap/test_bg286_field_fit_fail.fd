// expect-error: the literal does not fit in u8
// Bugs roadmap BG286: a literal assigned to a field must fit the field's
// type (reference §3.4); before, `s.a = 1000` on a u8 field stored 232.
struct S {
    a: u8,
}

fn main() -> i64 {
    var s = S { a: 1 };
    s.a = 1000;
    println(s.a);
    return 0;
}
