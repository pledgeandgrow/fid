// stdlib/regex: word boundaries \b \B, the leading (?i) flag (letters,
// classes, negated classes and ranges made case-blind; group numbering
// unchanged), regex_find_all, and regex_replace_groups with $0..$9, ${n}
// and $$ (complaint CD2, SL7 depth). Each answer agrees with Python's re
// on the same pattern (re.findall / re.fullmatch / re.sub with \g<n>).
//
// Expected output:
// wordb.count = 2
// wordb.span = 7 10
// nonwordb.count = 2
// wordb.match = true false
// wordb.edges = true false false
// icase.literal = true false
// icase.findall = 4
// icase.class = true true
// icase.negated = false true true
// icase.dash = true true
// icase.escape = true
// icase.brace = true
// icase.group = Ann
// icase.groups = 2 3
// findall = 1,22,333
// findall.empty = 4
// findall.none = 0
// replace.swap = 17/11/2026
// replace.braces = 1:a, 2:b
// replace.dollar = cost $5
// replace.unset = [a][b]
// replace.literal = $x ${1
// replace.wordb = [one] [two], [three]!
// regex flags ok

use regex;
use string;

fn join(v: Vec<str>) -> str {
    var out = "";
    var i: i64 = 0;
    while i < v.len() {
        if i > 0 {
            out = out + ",";
        }
        out = out + v.get(i);
        i = i + 1;
    }
    return out;
}

fn b(x: bool) -> str {
    return bool_to_str(x);
}

fn main() -> i64 {
    println("wordb.count = " + int_to_str(regex_find_all("cat concat cat's bobcat", "\\bcat\\b").len()));
    var sp: Vec<i64> = regex_find_span("concat cat", "\\bcat\\b");
    println("wordb.span = " + int_to_str(sp.get(0)) + " " + int_to_str(sp.get(1)));
    println("nonwordb.count = " + int_to_str(regex_find_all("concat cat bobcat", "\\Bcat").len()));
    println("wordb.match = " + b(regex_match("hello world", "hello\\b.*")) + " " + b(regex_match("helloworld", "hello\\b.*")));
    println("wordb.edges = " + b(regex_search("x", "^\\b")) + " " + b(regex_search("", "\\b")) + " " + b(regex_search(" ", "\\b")));

    println("icase.literal = " + b(regex_match("HeLLo", "(?i)hello")) + " " + b(regex_match("HeLLo", "hello")));
    println("icase.findall = " + int_to_str(regex_find_all("Ab aB ab AB", "(?i)ab").len()));
    println("icase.class = " + b(regex_match("Q", "(?i)[a-z]")) + " " + b(regex_match("q", "(?i)[A-Z]")));
    println("icase.negated = " + b(regex_match("A", "(?i)[^a]")) + " " + b(regex_match("b", "(?i)[^a]")) + " " + b(regex_match("B", "(?i)[^a]")));
    println("icase.dash = " + b(regex_match("A", "(?i)[a-]")) + " " + b(regex_match("-", "(?i)[a-]")));
    println("icase.escape = " + b(regex_match("ID42", "(?i)id\\d+")));
    println("icase.brace = " + b(regex_match("AAA", "(?i)a{3}")));
    match regex_group("Name=Ann", "(?i)name=(\\w+)", 1) {
        Option::Some(v) => {
            println("icase.group = " + v);
        }
        Option::None => {
            println("icase.group = none");
        }
    }
    println("icase.groups = " + int_to_str(regex_group_count("(?i)(a)(b)")) + " " + int_to_str(regex_captures("XY", "(?i)(x)(y)").len()));

    println("findall = " + join(regex_find_all("a1 b22 c333", "\\d+")));
    println("findall.empty = " + int_to_str(regex_find_all("abc", "x*").len()));
    println("findall.none = " + int_to_str(regex_find_all("abc", "\\d").len()));

    println("replace.swap = " + regex_replace_groups("2026-11-17", "(\\d+)-(\\d+)-(\\d+)", "$3/$2/$1"));
    println("replace.braces = " + regex_replace_groups("a=1, b=2", "(\\w)=(\\d)", "${2}:$1"));
    println("replace.dollar = " + regex_replace_groups("cost 5", "\\d", "$$$0"));
    println("replace.unset = " + regex_replace_groups("ab", "(a)|(b)", "[$1$2]"));
    println("replace.literal = " + regex_replace_groups("a", "a", "$x") + " " + regex_replace_groups("a", "a", "${1"));
    println("replace.wordb = " + regex_replace_groups("one two, three!", "\\b(\\w+)\\b", "[$1]"));
    println("regex flags ok");
    return 0;
}
