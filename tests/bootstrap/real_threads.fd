// Test: real threading with channels
use sync;
use io;
use channel;

fn worker() -> i64 {
    io_println("Worker thread running!");
    return 42;
}

fn main() {
    // Test mutex (real on Windows now)
    val m = sync_mutex_create();
    sync_mutex_lock(m);
    io_println("Mutex locked");
    sync_mutex_unlock(m);
    io_println("Mutex unlocked");

    // Test atomics (real on Windows now)
    val addr = sync_atomic_alloc(0);
    sync_atomic_store(addr, 100);
    val loaded = sync_atomic_load(addr);
    io_println("Atomic loaded: ");
    io_print_int(loaded);
    io_newline();

    val old_val = sync_atomic_add(addr, 50);
    io_println("Atomic add old value: ");
    io_print_int(old_val);
    io_newline();

    val new_val = sync_atomic_load(addr);
    io_println("Atomic new value: ");
    io_print_int(new_val);
    io_newline();

    // Test CAS
    val cas_result = sync_atomic_cas(addr, 150, 200);
    io_println("CAS result: ");
    if cas_result { io_print_int(1); } else { io_print_int(0); }
    io_newline();

    // Test channel (real on Windows now)
    val ch = channel_create(10);
    channel_send(ch, 100);
    channel_send(ch, 200);
    channel_send(ch, 300);

    val v1 = channel_recv(ch);
    val v2 = channel_recv(ch);
    val v3 = channel_recv(ch);

    io_println("Channel values: ");
    io_print_int(v1); io_println("");
    io_print_int(v2); io_println("");
    io_print_int(v3); io_println("");

    channel_close(ch);
    if channel_is_closed(ch) {
        io_println("Channel closed correctly");
    }

    io_println("Threading test passed!");
}
