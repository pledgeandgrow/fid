// Phase 3A — comptime functions.
// `comptime fn` marks a function intended for compile-time evaluation.
// Calls to it from within `comptime { }` blocks are evaluated by the
// comptime engine; the result is substituted as a constant.

comptime fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

comptime fn fib(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() -> i64 {
    // 5! = 120, computed entirely at compile time.
    val f = comptime factorial(5);
    print(f);

    // fib(10) = 55, computed at compile time.
    val g = comptime fib(10);
    print(g);

    // A comptime block that calls a comptime function.
    val h = comptime {
        val a = factorial(3);
        val b = factorial(4);
        a + b;
    };
    print(h);

    return 0;
}
