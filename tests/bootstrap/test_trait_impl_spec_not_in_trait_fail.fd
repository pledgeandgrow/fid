// expect-error: method 'shout' of `impl Show for Wrap<i64>` is not a method of trait 'Show'
// L8H: an impl of a trait for a narrower type (`impl Show for Wrap<i64>`
// beside `impl<T> Show for Wrap<T>`) specializes the trait's methods; a
// method the trait does not have is an error, as in any impl of the trait.

cap Show {
    fn show(self) -> str;
}

struct Wrap<T> {
    v: T,
}

impl<T> Show for Wrap<T> {
    fn show(self) -> str {
        return "any";
    }
}

impl Show for Wrap<i64> {
    fn show(self) -> str {
        return "i64";
    }

    fn shout(self) -> str {
        return "I64";
    }
}

fn main() -> i64 {
    val a: Wrap<i64> = Wrap { v: 5 };
    println(a.show());
    return 0;
}
