// expect-error: is defined twice in module 'dupmod'
// BG218: two `impl Show for P` blocks in one imported module. The program
// itself has none (its own pair is "defined twice in this program"), so
// the module's pair is the conflict the merge reports
// (compiler.fd cc_find_trait_impl_conflicts): before it, the impl merged
// later won silently.
use impl_twice_lib::dupmod;

fn main() -> i64 {
    println("unreachable");
    return 0;
}
