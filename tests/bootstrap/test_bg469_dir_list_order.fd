// Bugs roadmap BG469 (and BG435): `p_dir_list` listed a directory in a
// different order per backend: the machine layer sorted names by bytes,
// the C runtime (so `fid run`) and pe_ir gave the file system's order
// (NTFS: case-insensitive; ext4: hash order). Every runtime now sorts by
// bytes (compiler/codegen_c.fd p_dir_list, stdlib/pe_runtime/base.fd
// pert_dir_list). BG435: pe_ir's pert_dir_list walks the directory once
// and copies each name as it comes (a second, unbounded walk could write
// past the buffer the first walk sized); the race itself is not provoked
// here.
//
// Expected output:
// B.txt,Z.txt,_u.txt,a.txt
// 4
// 0

fn main() {
    p_mkdir("bg469_d4");
    p_file_write("bg469_d4/B.txt", "1");
    p_file_write("bg469_d4/a.txt", "1");
    p_file_write("bg469_d4/_u.txt", "1");
    p_file_write("bg469_d4/Z.txt", "1");
    val l: str = p_dir_list("bg469_d4");
    println(str_replace(l, "\n", ","));
    println(f"{str_split(l, "\n").len()}");
    p_file_delete("bg469_d4/B.txt");
    p_file_delete("bg469_d4/a.txt");
    p_file_delete("bg469_d4/_u.txt");
    p_file_delete("bg469_d4/Z.txt");
    p_rmdir("bg469_d4");
    p_mkdir("bg469_e");
    println(f"{str_len(p_dir_list("bg469_e"))}");
    p_rmdir("bg469_e");
}
