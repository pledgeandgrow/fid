// Bugs roadmap BG187: a linear value consumed in every branch of a match
// (statement or value) or of an if-expression is consumed once; before,
// each further arm counted as a second use. An arm that leaves (return)
// does not count against the others.
//
// Expected output:
// 1
// 20
// 3
// 4
// 5

@linear
struct Tok {
    v: i64,
}

fn use_tok(t: Tok) -> i64 {
    return t.v;
}

fn pick(t: Tok, k: i64) -> i64 {
    match k {
        1 => {
            return use_tok(t) * 10;
        }
        _ => {
            println(use_tok(t));
        }
    }
    return 0;
}

fn main() -> i64 {
    val t = Tok { v: 1 };
    val k: i64 = 1;
    match k {
        1 => {
            println(use_tok(t));
        }
        _ => {
            println(use_tok(t) + 1);
        }
    }
    println(pick(Tok { v: 2 }, 1));
    val u = Tok { v: 3 };
    val c: bool = str_len("ab") == 2;
    val n: i64 = if c { use_tok(u) } else { use_tok(u) + 100 };
    println(n);
    val w = Tok { v: 4 };
    val m: i64 = match k {
        1 => use_tok(w),
        _ => use_tok(w) - 1,
    };
    println(m);
    val z = Tok { v: 5 };
    if c {
        println(use_tok(z));
    } else {
        println(use_tok(z) + 1);
    }
    return 0;
}
