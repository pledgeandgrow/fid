use vec;

fn main() -> i64 {
    var v = Vec::new();
    v.push(1.0);
    v.push(4.0);
    v.push(9.0);
    print("len: ");
    print(v.len());
    var a = v.get(0);
    print("get(0): ");
    print(a);
    var b = v.get(1);
    print("get(1): ");
    print(b);
    var c = v.get(2);
    print("get(2): ");
    print(c);
    return 0;
}
