// expect-error: in 'main', a secret value reaches output 'println'
// Expected to FAIL (complaint CO1): env_secret's result is @secret, so
// printing the API key read from the environment is a compile error.
use env;

fn main() -> i64 {
    val key: str = env_secret("API_KEY");
    println("using key " + key);
    return 0;
}
