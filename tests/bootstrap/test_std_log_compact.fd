// stdlib/log_compact: LEB128/zigzag vectors, format interning, compact records (exact bytes), level filtering, table export/import, host-side decoding and broken-stream detection.
// Expected output:
// uvarint 0=00 127=7F 128=80 01 300=AC 02 -1=FF FF FF FF FF FF FF FF FF 01
// zigzag 0 1 2 3 4294967294, back -1 2147483647
// indexes 0 1 2 3 4, again 1; kinds uux qd s  bc
// record 0: 00 E8 07 01 04 2A
// record 1: 01 FA 01 80 80 AC 05 4F
// 4 records, 1 dropped, 25 bytes for 152 bytes of text
// [1000] INFO boot v1.4 reset cause 0x2a
// [1250] WARN temp 85.5000 C over limit -40
// [1300] INFO task net started
// [2000] ERROR flag true char Z braces {ok}
// [2500] INFO boot v18446744073709551615.0 reset cause 0xffffffffffffffff
// imported table decodes the same: true
// cut stream: ! truncated record
// bad index: ! unknown format index 9
use log_compact;
use vec;
use string;

fn hx(b: i64) -> str {
    val d: str = "0123456789ABCDEF";
    return str_slice(d, (b >> 4) & 15, ((b >> 4) & 15) + 1) + str_slice(d, b & 15, (b & 15) + 1);
}

fn hexs(v: Vec<i64>, from: i64, n: i64) -> str {
    var p: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < n {
        p.push(hx(v.get(from + i)));
        i = i + 1;
    }
    return str_join(p, " ");
}

fn uv(v: i64) -> str {
    var b: Vec<i64> = Vec::new();
    log_put_uvarint(&mut b, v);
    return hexs(b, 0, b.len());
}

fn ints(s: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    if str_len(s) == 0 { return out; }
    val p: Vec<str> = str_split(s, ",");
    var i: i64 = 0;
    while i < p.len() {
        out.push(str_parse_int(p.get(i)));
        i = i + 1;
    }
    return out;
}

fn main() {
    println("uvarint 0=" + uv(0) + " 127=" + uv(127) + " 128=" + uv(128) + " 300=" + uv(300) + " -1=" + uv(-1));
    println("zigzag " + int_to_str(log_zigzag(0)) + " " + int_to_str(log_zigzag(-1)) + " " + int_to_str(log_zigzag(1)) + " " + int_to_str(log_zigzag(-2))
        + " " + int_to_str(log_zigzag(2147483647)) + ", back " + int_to_str(log_unzigzag(1)) + " " + int_to_str(log_unzigzag(4294967294)));
    var t: LogTable = logtable_new();
    val i0: i64 = logtable_register(&mut t, LOG_INFO, "boot v{u}.{u} reset cause {x}");
    val i1: i64 = logtable_register(&mut t, LOG_WARN, "temp {q} C over limit {}");
    val i2: i64 = logtable_register(&mut t, LOG_INFO, "task {s} started");
    val i3: i64 = logtable_register(&mut t, LOG_DEBUG, "tick");
    val i4: i64 = logtable_register(&mut t, LOG_ERROR, "flag {b} char {c} braces {{ok}}");
    val again: i64 = logtable_register(&mut t, LOG_WARN, "temp {q} C over limit {}");
    println("indexes " + int_to_str(i0) + " " + int_to_str(i1) + " " + int_to_str(i2) + " " + int_to_str(i3) + " " + int_to_str(i4) + ", again " + int_to_str(again)
        + "; kinds " + str_join(t.kinds, " "));
    var e: LogEncoder = logenc_new(LOG_INFO);
    var none: Vec<str> = Vec::new();
    var net: Vec<str> = Vec::new();
    net.push("net");
    logenc_emit(&mut e, &t, i0, 1000, ints("1,4,42"), none);
    val r0: i64 = e.out.len();
    logenc_emit(&mut e, &t, i1, 1250, ints("5603328,-40"), none);
    val r1: i64 = e.out.len();
    logenc_emit(&mut e, &t, i2, 1300, ints(""), net);
    logenc_emit(&mut e, &t, i3, 1400, ints(""), none);
    logenc_emit(&mut e, &t, i4, 2000, ints("1,90"), none);
    println("record 0: " + hexs(e.out, 0, r0));
    println("record 1: " + hexs(e.out, r0, r1 - r0));
    val lines: Vec<str> = log_decode_all(&t, e.out);
    var textlen: i64 = 0;
    var i: i64 = 0;
    while i < lines.len() {
        textlen = textlen + str_len(lines.get(i)) + 1;
        i = i + 1;
    }
    println(int_to_str(e.records) + " records, " + int_to_str(e.dropped) + " dropped, " + int_to_str(e.out.len()) + " bytes for " + int_to_str(textlen) + " bytes of text");
    var big: Vec<i64> = Vec::new();
    big.push(-1);
    big.push(0);
    big.push(-1);
    logenc_emit(&mut e, &t, i0, 2500, big, none);
    val all: Vec<str> = log_decode_all(&t, e.out);
    i = 0;
    while i < all.len() {
        println(all.get(i));
        i = i + 1;
    }
    val t2: LogTable = logtable_import(logtable_export(&t));
    val all2: Vec<str> = log_decode_all(&t2, e.out);
    var same: bool = all2.len() == all.len();
    i = 0;
    while same && i < all.len() {
        if !str_equal(all.get(i), all2.get(i)) { same = false; }
        i = i + 1;
    }
    println("imported table decodes the same: " + bool_to_str(same));
    var cut: Vec<i64> = e.out.clone();
    cut.pop();
    val cl: Vec<str> = log_decode_all(&t, cut);
    println("cut stream: " + cl.get(cl.len() - 1));
    var bad: Vec<i64> = Vec::new();
    bad.push(9);
    bad.push(0);
    println("bad index: " + log_decode_all(&t, bad).get(0));
}
