// LG9: gensym is known inside a `comptime fn` (the type checker treats its
// body as compile-time code), so a gen block can take its helper names from
// a comptime function: the generated helper never collides with the
// program's own `helper`.
// Expected output:
// 15
// 101
// 8

comptime fn helper_name(p: str) -> str {
    return gensym(p);
}

comptime fn make_quad() -> str {
    val h = helper_name("helper");
    return "fn " + h + "(n: i64) -> i64 { return n * 2; } fn quad(n: i64) -> i64 { return " + h + "(" + h + "(n)); }";
}

fn helper(n: i64) -> i64 { return n + 100; }

fn main() -> i64 {
    comptime gen {
        val h = helper_name("helper");
        return "fn " + h + "(n: i64) -> i64 { return n * 3; } fn triple(n: i64) -> i64 { return " + h + "(n); }";
    }
    comptime gen {
        return make_quad();
    }
    println(triple(5));
    println(helper(1));
    println(quad(2));
    return 0;
}
