// BG158 (Nov 24): expected to fail at run time (integer overflow). The
// branch `x < (if reset { x = 100; ten } else { ten })` compares the x
// loaded before the store `x = 100` in its condition. compiler/checks.fd
// peir_range_refine put the fact `x < 10` on the local x itself, though x
// holds 100 when the branch is taken with `reset`, so `x * 10^17` lost its
// overflow check: the C build printed -8446744073709551616 for g(3, true).
// The fact is on the local only when its load is in the branching block
// with no store to it after the load (as peir_square_local checks).

fn g(x0: i64, reset: bool) -> i64 {
    var x: i64 = x0;
    var r: i64 = 0;
    val ten: i64 = 10;
    if x < (if reset { x = 100; ten } else { ten }) {
        if x >= 0 {
            r = x * 100000000000000000;
        }
    }
    return r;
}

fn main() {
    println(g(3, false));
    println(g(3, true));
    print("unreachable\n");
}
