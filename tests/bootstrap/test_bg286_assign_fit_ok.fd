// Bugs roadmap BG286: values that fit, or are converted with `as`, may
// still be stored in a field, an element and through a reference.
//
// Expected output:
// 255 200 7
// 44
struct S {
    a: u8,
    b: i32,
}

fn main() -> i64 {
    var s = S { a: 1, b: 2 };
    s.a = 255;
    var v: Vec<u8> = Vec::new();
    v.push(1);
    v[0] = 200;
    var x: u8 = 3;
    val r = &mut x;
    *r = 7;
    println(f"{s.a} {v[0]} {x}");
    var big: i64 = 44;
    s.b = big as i32;
    println(s.b);
    return 0;
}
