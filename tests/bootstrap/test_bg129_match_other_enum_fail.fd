// expect-error: is a variant of enum 'B', but the value matched is a 'A'
// Bugs roadmap BG129: a match pattern naming another enum than the
// scrutinee's matched on the tag number and bound B's payload type
// (run printed an empty line, C read address 0x5).
enum A { X(i64), Y }
enum B { P(str), Q }
fn main() -> i64 {
    val a = A::X(5);
    match a { B::P(s) => { println(s); } _ => { println("o"); } }
    return 0;
}
