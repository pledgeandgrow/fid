// LG3 (docs/roadmap/competitive-roadmap.md): a read is checked against a
// live mutable borrow, as a mutation is. These stay legal: the borrower's
// last use is behind, the borrow is in a block that ended, the read is of
// another field, a shared borrower reads beside the reader, a method's
// arguments read its receiver, and a call's later arguments read beside a
// mutable borrow an earlier argument made (the compiler's own source does
// it: `f(&mut g.e, read(g))`).
//
// Expected output:
// 5
// 7
// 10
// 1 5
// 18
// 2
// 10
struct E {
    c: Vec<i64>,
}

struct G {
    e: E,
    n: i64,
}

fn align(e: &mut E, k: i64) -> i64 {
    return k + e.c.len();
}

fn want(g: &G, x: i64) -> i64 {
    return g.n + x;
}

fn start(g: &mut G, x: i64) -> i64 {
    // g is read in later arguments, also after a nested call has finished
    return align(&mut g.e, want(g, x) + want(g, x));
}

struct S {
    x: i64,
    y: i64,
}

fn id_mut<'a>(x: &'a mut i64) -> &'a mut i64 {
    return x;
}

fn main() -> i64 {
    // the borrower's last use is behind the read
    var m: i64 = 1;
    val r = &mut m;
    *r = 5;
    val v = m;
    println(v);
    m = 7;
    println(m);

    // the borrow is in a block that ended
    {
        val r2 = id_mut(&mut m);
        *r2 = 9;
    }
    println(m + 1);

    // a mutable borrow of another field
    var s = S { x: 1, y: 2 };
    val ry = &mut s.y;
    *ry = 5;
    val yv = *ry;
    println(f"{s.x} {yv}");

    // a shared borrower beside the reader
    val rs = &m;
    val w = m;
    println(w + *rs);

    // a method's arguments read its receiver
    var vec = Vec::new();
    vec.push(1);
    vec.push(vec.len());
    println(vec.len());

    // a call's later arguments read beside a mutable borrow an earlier
    // argument made
    var g2 = G { e: E { c: Vec::new() }, n: 4 };
    println(start(&mut g2, 1));
    return 0;
}
