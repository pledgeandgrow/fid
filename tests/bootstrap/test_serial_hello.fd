// Kernel: Serial Hello World
// Boots via Multiboot2, transitions to 64-bit long mode, writes to COM1 serial.
// Test with: qemu-system-x86_64 -kernel test_serial_hello.bin -m 256M -serial stdio

fn main() {
    // COM1 serial port base = 0x3F8
    // QEMU's serial port is ready by default — no init needed.

    // Load port number into DX
    asm!("mov dx, 0x3F8");

    // Write "Hello from Fides!\n" to serial, one char at a time
    // H=72  e=101 l=108 l=108 o=111
    asm!("mov al, 72; out dx, al");
    asm!("mov al, 101; out dx, al");
    asm!("mov al, 108; out dx, al");
    asm!("mov al, 108; out dx, al");
    asm!("mov al, 111; out dx, al");

    // space=32
    asm!("mov al, 32; out dx, al");

    // f=102 r=114 o=111 m=109
    asm!("mov al, 102; out dx, al");
    asm!("mov al, 114; out dx, al");
    asm!("mov al, 111; out dx, al");
    asm!("mov al, 109; out dx, al");

    // space=32
    asm!("mov al, 32; out dx, al");

    // F=70 i=105 d=100 e=101 s=115
    asm!("mov al, 70; out dx, al");
    asm!("mov al, 105; out dx, al");
    asm!("mov al, 100; out dx, al");
    asm!("mov al, 101; out dx, al");
    asm!("mov al, 115; out dx, al");

    // !=33
    asm!("mov al, 33; out dx, al");

    // \n=10 \r=13
    asm!("mov al, 10; out dx, al");
    asm!("mov al, 13; out dx, al");

    // Halt the CPU
    asm!("hlt");
    return 0;
}
