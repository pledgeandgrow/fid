// OP15 (fid): the language's unlikely hints. `@cold` on a function, and a
// call of core's `cold_path()` in a branch, mark that code as the unlikely
// side: compiler/ast.fd `is_cold_fn_hint` answers for the native backends'
// block layout (the cold block goes after the hot code). The hint changes no
// result; this test checks that both forms build and run on every backend.
// Expected output:
// 10
// bad input: -1
// 0

@cold
fn report(v: i64) -> i64 {
    println("bad input: " + int_to_str(v));
    return 0;
}

fn check(v: i64) -> i64 {
    if v < 0 {
        cold_path();
        return report(v);
    }
    return v * 2;
}

fn main() -> i64 {
    println(check(5));
    println(check(0 - 1));
    return 0;
}
