// expect-error: Sandbox error: 'measure()' calls C code
// Test: C code reached from a sandbox is rejected, also through a helper:
// the effect system cannot see what a C function does (it could open a
// file or a socket), so revoking all capabilities must include it.
extern "C" include "<string.h>" {
    fn strlen as c_strlen(s: str) -> u64;
}

@unsafe
fn measure(s: str) -> u64 {
    return c_strlen(s);
}

fn main() -> i64 {
    sandbox {
        val n = measure("abc");
    }
    return 0;
}
