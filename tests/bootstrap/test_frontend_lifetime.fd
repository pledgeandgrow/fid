// LG3: named lifetimes. `fn first<'a>(x: &'a i64, y: &i64) -> &'a i64`
// ties the result to `x` only: a caller may return it when `x` is its own
// reference parameter even though `y` is a local, and may change `b` while
// the result is live (it borrows `a`, not `b`).
// Expected output:
// 5
// 5
// 9

fn first<'a>(x: &'a i64, y: &i64) -> &'a i64 {
    if *y > *x {
        return x;
    }
    return x;
}

fn keep<'a>(p: &'a i64) -> &'a i64 {
    var local: i64 = 7;
    return first(p, &local);
}

fn main() -> i64 {
    var a: i64 = 5;
    var b: i64 = 3;
    val r = first(&a, &b);
    b = 4;
    println(*r);
    val k = keep(&a);
    println(*k);
    a = 9;
    println(a);
    return 0;
}
