// Bugs roadmap BG389: a method call that left out a parameter with a
// default (`c.m(2)` for `fn m(self, a: i64, b: i64 = 7)`), or an
// associated function called by its path (`C::add(1)`), was called without
// it. compiler/lower.fd Lowerer_method_call_args / Lowerer_lower_assoc_call
// fill defaults and put named arguments in order (Lowerer_args_for_params,
// as Lowerer_resolve_call_args does for a function). Reference §2.1.
//
// Expected output:
// 1027
// 3
// 5
// 1027

struct C { k: i64 }

impl C {
    fn m(self, a: i64, b: i64 = 7) -> i64 {
        return self.k + a * 10 + b;
    }
    fn add(a: i64, b: i64 = 2) -> i64 {
        return a + b;
    }
    fn mk(k: i64 = 5) -> C {
        return C { k: k };
    }
}

fn main() {
    val c = C { k: 1000 };
    println(c.m(2));
    println(C::add(1));
    println(C::mk().k);
    println(C::m(c, 2));
}
