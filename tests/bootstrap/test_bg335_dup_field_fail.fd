// expect-error: field 'x' given twice in the struct literal of 'P'
// Bugs roadmap BG335: a struct literal may name each field once; before,
// `P { x: 1, x: 5, y: 2 }` built x = 5 (run and ccompile).
struct P {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    val p = P { x: 1, x: 5, y: 2 };
    println(p.x);
    return 0;
}
