// stdlib/secrets: PBKDF2-HMAC-SHA512 against Python reference vectors, an AES-256-GCM vault round trip (reproducible with a fixed salt/IV), tamper and wrong-passphrase detection, and zeroizing. Iteration counts are small so the interpreter test is fast; each iteration is one HMAC-SHA512 and the algorithm is the same at any count.
// Expected output:
// pbkdf2 c=1:    867f70cf1ade02cff3752599a3a53dc4af34c7a669815ae5d513554e1c8cf252c02d470a285a0501bad999bfe943c08f050235d7d68b1da55e63f73b60a57fce
// pbkdf2 c=2:    e1d9c16aa681708a45f5c7c4e215ceb66e011a2e9f0040713f18aefdb866d53cf76cab2868a39b9f7840edce4fef5a82be67335c77a6068e04112754f27ccf4e
// pbkdf2 c=2/32: e1d9c16aa681708a45f5c7c4e215ceb66e011a2e9f0040713f18aefdb866d53c
// pbkdf2 20 bytes: c74319d99499fc3e9013acff597c23c5baf0a0be
// labels: github,aws,pin (3)
// sealed length: 122 bytes, starts FIDVAULT
// open ok: true
// github: ghp_token_abc
// aws: AKIA...secret
// pin: 4242
// has slack: false
// wrong pass: ok=false (wrong passphrase or tampered vault)
// tampered: ok=false
// junk: bad magic
// random seal round trip: true
// two seals differ: true
// plain decode: true entries 3
// zeroized: true len 9
// after remove: aws,pin
use secrets;
use encoding;
use vec;
use string;

fn main() -> i64 {
    // PBKDF2-HMAC-SHA512, checked against Python's hashlib.pbkdf2_hmac
    println("pbkdf2 c=1:    " + hex_encode_bytes(pbkdf2_sha512_str("password", "salt", 1, 64)));
    println("pbkdf2 c=2:    " + hex_encode_bytes(pbkdf2_sha512_str("password", "salt", 2, 64)));
    println("pbkdf2 c=2/32: " + hex_encode_bytes(pbkdf2_sha512_str("password", "salt", 2, 32)));
    println("pbkdf2 20 bytes: " + hex_encode_bytes(pbkdf2_sha512_str("passwd", "salt", 1, 20)));

    // vault round trip with a fixed salt and IV (reproducible)
    var salt: Vec<i64> = hex_decode_bytes("000102030405060708090a0b0c0d0e0f");
    var iv: Vec<i64> = hex_decode_bytes("101112131415161718191a1b");
    var v: Vault = vault_new();
    vault_set(& mut v, "github", str_bytes("ghp_token_abc"));
    vault_set(& mut v, "aws", str_bytes("AKIA...secret"));
    vault_set(& mut v, "pin", hex_decode_bytes("0000"));
    vault_set(& mut v, "pin", str_bytes("4242"));  // replace
    println("labels: " + str_join(vault_labels(& v), ",") + " (" + int_to_str(v.entries.len()) + ")");

    val blob: Vec<i64> = vault_seal_with(& v, "correct horse battery staple", 3, salt, iv);
    println("sealed length: " + int_to_str(blob.len()) + " bytes, starts " + str_from_bytes(hex_decode_bytes("4649445641554c54")));

    val o: VaultOpened = vault_open(blob, "correct horse battery staple");
    println("open ok: " + bool_to_str(o.ok));
    println("github: " + str_from_bytes(vault_get(& o.vault, "github")));
    println("aws: " + str_from_bytes(vault_get(& o.vault, "aws")));
    println("pin: " + str_from_bytes(vault_get(& o.vault, "pin")));
    println("has slack: " + bool_to_str(vault_has(& o.vault, "slack")));

    // wrong passphrase fails
    val bad: VaultOpened = vault_open(blob, "wrong passphrase");
    println("wrong pass: ok=" + bool_to_str(bad.ok) + " (" + bad.error + ")");

    // a tampered ciphertext byte fails the tag
    var tampered: Vec<i64> = blob;
    tampered.set(blob.len() - 20, tampered.get(blob.len() - 20) ^ 1);
    val t: VaultOpened = vault_open(tampered, "correct horse battery staple");
    println("tampered: ok=" + bool_to_str(t.ok));

    // bad magic
    var junk: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 60 { junk.push(i); i = i + 1; }
    println("junk: " + vault_open(junk, "x").error);

    // seal/open with a random salt+IV still round-trips
    val blob2: Vec<i64> = vault_seal(& v, "pw", 2);
    val o2: VaultOpened = vault_open(blob2, "pw");
    println("random seal round trip: " + bool_to_str(o2.ok && str_from_bytes(vault_get(& o2.vault, "aws")) == "AKIA...secret"));
    println("two seals differ: " + bool_to_str(hex_encode_bytes(vault_seal(& v, "pw", 2)) != hex_encode_bytes(blob2)));

    // encode/decode without encryption
    val enc: Vec<i64> = vault_encode(& v);
    val dec: VaultOpened = vault_decode(enc);
    println("plain decode: " + bool_to_str(dec.ok) + " entries " + int_to_str(dec.vault.entries.len()));

    // zeroize
    var sec: Vec<i64> = str_bytes("topsecret");
    zeroize(& mut sec);
    var allzero: bool = true;
    i = 0;
    while i < sec.len() { if sec.get(i) != 0 { allzero = false; } i = i + 1; }
    println("zeroized: " + bool_to_str(allzero) + " len " + int_to_str(sec.len()));

    // remove
    vault_remove(& mut v, "github");
    println("after remove: " + str_join(vault_labels(& v), ","));
    return 0;
}
