// stdlib/pqc ML-DSA (FIPS 204) against OpenSSL 3.5: ML-DSA-44 from the
// seed 00 01 .. 1f and ML-DSA-65 from the seed (7 i + 3) mod 256 give
// OpenSSL's public and private keys (compared through SHA3-256);
// deterministic signatures with and without a context string, and hedged
// ones with rnd = 42 .. 42 (OpenSSL's test-entropy), are byte-exact with
// OpenSSL's; a signature OpenSSL made with fresh randomness verifies, and
// fails with another context, another message, a flipped bit, a bad hint
// encoding or a short signature. Heavy for the interpreter (about five
// minutes per sign and verify of ML-DSA-44): run it through the C backend.
// Expected output:
// ML-DSA-44 pk 1312 373c7bf2cac5bd2a6c35933bab0fa1c951f22247e1333383fcb618822080373f
// ML-DSA-44 sk 2560 da0665a6d807669d06aeb7010507aa6bd4640641055462e38e37344a274f36a6
// ML-DSA-44 deterministic 97dc168d4ec0a6fbb43811b57a4b42396b095c57575830867006ceda9083b933
// ML-DSA-44 deterministic ctx 56f5762e6601c7c5d7eb45a825623d7b628fb80b98d3a2d92d9154ba47cea8a2
// ML-DSA-44 hedged 5dd0db916e98dddd2992cb7c529cf9182e6ed19937427ff220520203dee8f65f
// ML-DSA-44 verify ours true openssl true
// ML-DSA-44 wrong ctx false wrong msg false flipped false bad hint false short false
// ML-DSA-65 pk 1952 297001eb812de564c85c9ce5bad83662b51863471d4d5079071fd1020bf90de6
// ML-DSA-65 sk 4032 c3172779d3160dbe27453f8e8b43b53fc3cd552276d46368749a73c4495a0ff3
// ML-DSA-65 deterministic 6e7b2f6013be0aad1f1e278e2cd4230f1394b7c455416fadbad78feb455c9877
// ML-DSA-65 deterministic ctx 5d40094730cfbdb77d9659f5e1579f913c1932236b154971eff0965b2e0e1fad
// ML-DSA-65 hedged f2fe61cc4b5796abcaf2a2387c852026d33a27b9cfdfb5c4173daffa77b5faaf
// ML-DSA-65 verify ours true openssl true
// ML-DSA-65 wrong ctx false wrong msg false flipped false bad hint false short false
// bad seed false long ctx 0
use pqc;
use vec;
use encoding;

fn hx(v: Vec<i64>) -> str { return hex_encode_bytes(v); }

fn fill(n: i64, b: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n { v.push(b); i = i + 1; }
    return v;
}

fn check(p: & MldsaParams, seed: Vec<i64>, msg: Vec<i64>, osig: Vec<i64>) {
    val kp: MldsaKeyPair = mldsa_keygen(p, seed);
    val n: str = p.name;
    println(n + " pk " + int_to_str(kp.pk.len()) + " " + hx(sha3_256(kp.pk)));
    println(n + " sk " + int_to_str(kp.sk.len()) + " " + hx(sha3_256(kp.sk)));
    val det: Vec<i64> = mldsa_sign_deterministic(p, kp.sk, msg, Vec::new());
    println(n + " deterministic " + hx(sha3_256(det)));
    println(n + " deterministic ctx " + hx(sha3_256(mldsa_sign_deterministic(p, kp.sk, msg, str_bytes("fides")))));
    println(n + " hedged " + hx(sha3_256(mldsa_sign(p, kp.sk, msg, Vec::new(), fill(32, 0x42)))));
    println(n + " verify ours " + bool_to_str(mldsa_verify(p, kp.pk, msg, Vec::new(), det)) + " openssl " + bool_to_str(mldsa_verify(p, kp.pk, msg, Vec::new(), osig)));
    var flipped: Vec<i64> = osig;
    flipped.set(p.ctilde + 5, flipped.get(p.ctilde + 5) ^ 16);
    var badhint: Vec<i64> = osig;
    badhint.set(osig.len() - 1, p.omega + 1);
    var short: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k + 1 < osig.len() { short.push(osig.get(k)); k = k + 1; }
    var other: Vec<i64> = msg;
    other.push(33);
    println(n + " wrong ctx " + bool_to_str(mldsa_verify(p, kp.pk, msg, str_bytes("x"), osig))
        + " wrong msg " + bool_to_str(mldsa_verify(p, kp.pk, other, Vec::new(), osig))
        + " flipped " + bool_to_str(mldsa_verify(p, kp.pk, msg, Vec::new(), flipped))
        + " bad hint " + bool_to_str(mldsa_verify(p, kp.pk, msg, Vec::new(), badhint))
        + " short " + bool_to_str(mldsa_verify(p, kp.pk, msg, Vec::new(), short)));
}

fn main() {
    val p44: MldsaParams = mldsa44_params();
    var s44: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 32 { s44.push(i); i = i + 1; }
    check(& p44, s44, str_bytes("abc"), hex_decode_bytes(""));
    val p65: MldsaParams = mldsa65_params();
    var s65: Vec<i64> = Vec::new();
    i = 0;
    while i < 32 { s65.push((i * 7 + 3) % 256); i = i + 1; }
    check(& p65, s65, str_bytes("The quick brown fox jumps over the lazy dog"), hex_decode_bytes(""));
    val bad: MldsaKeyPair = mldsa_keygen(& p44, fill(31, 1));
    println("bad seed " + bool_to_str(bad.ok) + " long ctx " + int_to_str(mldsa_sign_deterministic(& p44, fill(2560, 0), str_bytes("m"), fill(256, 1)).len()));
}
