// WP7, WP6, WP15 (native mid-end, iropt.fd): a HashMap printed by value
// goes through HashMap_to_str, which the backends call by name with a null
// env and the platform's registers (pe_ir and nat_ir Print), so envtrim
// must not drop its env and WP6 must not give it the internal convention;
// a global nothing reads is removed by deadf with its stores, a read one
// stays. Run natively with FID_IROPT_ON=envtrim,deadf as well: every run
// prints the same.
// Expected output:
// {alice: 30, bob: 25}
// 7
// 12
// 3

var g_written: i64 = 5;
var g_read: i64 = 3;

fn add3(a: i64, b: i64, c: i64) -> i64 {
    return a + b + c;
}

fn twice(x: i64) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < 2 {
        t = t + x;
        i = i + 1;
    }
    return t;
}

fn main() -> i64 {
    val m = HashMap::new();
    m.insert("alice", 30);
    m.insert("bob", 25);
    println(m);
    g_written = add3(1, 2, 4);
    println(add3(1, 2, 4));
    println(twice(6));
    println(g_read);
    return 0;
}
