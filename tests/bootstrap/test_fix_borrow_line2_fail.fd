// expect-error: borrow error in main (line 17): cannot create &mut c
// Test (stdlib-agent bug 53): the borrow error for a statement-level call
// whose arguments take &mut c twice names that call's line, not "line 0".
struct C { n: i64 }

struct St { m: i64 }

fn ssh_rekey(c: &mut C) -> i64 { c.n = c.n + 1; return c.n; }

fn pump(c: &mut C, s: &mut St, k: i64, v: Vec<i64>) { c.n = c.n + k + s.m + v.len(); }

fn main() {
    var c: C = C { n: 1 };
    var s: St = St { m: 2 };
    println(int_to_str(c.n));
    // the error is on the next line
    pump(& mut c, & mut s, ssh_rekey(& mut c), Vec::new());
    println(int_to_str(c.n));
}
