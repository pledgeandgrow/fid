// Roadmap L6C: `val f: fn(f64) -> f64 = p_dl_sym(lib, "sqrt")` gives the
// looked-up symbol a function type (checked: C types only), and an untyped
// lookup is still the i64 address. The load is simulated (sequential
// handles) on the interpreter and C backends, so the symbol is not called.
// Expected output:
//   typed lookup ok
//   untyped lookup ok
use core with { FS, IO }

fn main() -> i64 {
    val lib = p_dl_open("libm.so.6");
    if lib != 0 {
        val sq: fn(f64) -> f64 = p_dl_sym(lib, "sqrt");
        println("typed lookup ok");
        val raw = p_dl_sym(lib, "sqrt");
        if raw != 0 {
            println("untyped lookup ok");
        }
        p_dl_close(lib);
    }
    return 0;
}
