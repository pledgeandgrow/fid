// RT6: `var v = Vec::new()` written without a type takes its element type
// from a later push of a float, string or bool literal (it was i64, and a
// float printed as its bits).
fn main() -> i64 {
    var v = Vec::new();
    v.push(1.5);
    v.push(-2.25);
    println(v.get(0));
    println(v.get(1));
    var total: f64 = 0.0;
    var i: i64 = 0;
    while i < v.len() {
        total = total + v.get(i);
        i = i + 1;
    }
    println(total);
    var names = Vec::new();
    if true { names.push("ada"); }
    names.push("grace");
    println(names.get(0));
    println(names.len());
    var flags = Vec::new();
    flags.push(true);
    println(flags.get(0));
    var ints = Vec::new();
    ints.push(4);
    println(ints.get(0) + 1);
    return 0;
}
