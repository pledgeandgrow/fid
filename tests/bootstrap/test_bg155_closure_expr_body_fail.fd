// expect-error: returns i64 but is declared to return str
// Bugs roadmap BG155: an expression-bodied closure's declared return type
// was not compared with its body: `fn(x: i64) -> str => x` was accepted
// and panicked "a str without a string header".
fn main() -> i64 {
    val f = fn(x: i64) -> str => x;
    println(f(3));
    return 0;
}
