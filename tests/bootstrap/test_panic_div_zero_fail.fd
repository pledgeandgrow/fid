// Expected to fail at run time: division by zero panics on every backend and
// target, also where the CPU does not trap on it (AArch64, RISC-V return 0
// or -1; release F6). Compared across targets by scripts/cross-test.sh.

fn div(a: i64, b: i64) -> i64 {
    return a / b;
}

fn main() {
    print("before\n");
    var zero: i64 = 0;
    val r = div(42, zero);
    print(r);
    print("unreachable\n");
}
