// expect-error: Visibility error: enum 'PrivE' is private to module
// Bugs roadmap BG292: an enum without `pub` cannot be built from another
// module; before, `PrivE::Two(4)` compiled.
use vis_lib::vmod;

fn main() -> i64 {
    val e = PrivE::Two(4);
    match e {
        PrivE::Two(n) => {
            println(n);
        }
        PrivE::One => {
        }
    }
    return 0;
}
