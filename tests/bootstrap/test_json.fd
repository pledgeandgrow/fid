// Test: JSON stdlib — Phase 5D.2
// Tests parse, dump, get, at, type, len, pretty, and string escaping.

use json;

fn main() {
    // ─── Parse + canonical dump ──────────────────────────────────────
    val input = "{\"name\":\"pledge\",\"version\":1,\"active\":true}";
    val canonical = json_parse(input);
    print(canonical);
    print("\n");

    // ─── Get field ───────────────────────────────────────────────────
    val name = json_get(input, "name");
    print(name);
    print("\n");

    val version = json_get(input, "version");
    print(version);
    print("\n");

    // ─── Type detection ──────────────────────────────────────────────
    val t1 = json_type(input);
    print(t1);
    print("\n");

    val t2 = json_type("42");
    print(t2);
    print("\n");

    val t3 = json_type("\"hello\"");
    print(t3);
    print("\n");

    val t4 = json_type("null");
    print(t4);
    print("\n");

    // ─── Array operations ────────────────────────────────────────────
    val arr = "[10,20,30,40,50]";
    val len = json_len(arr);
    print(len);
    print("\n");

    val elem = json_at(arr, 2);
    print(elem);
    print("\n");

    // ─── Pretty print ────────────────────────────────────────────────
    val pretty = json_pretty(input);
    print(pretty);
    print("\n");

    // ─── String escaping ─────────────────────────────────────────────
    val escaped = json_string("hello\nworld");
    print(escaped);
    print("\n");

    // ─── Object length ───────────────────────────────────────────────
    val objlen = json_len(input);
    print(objlen);
    print("\n");

    // ─── Nested access ───────────────────────────────────────────────
    val nested = "{\"user\":{\"name\":\"alice\",\"age\":30},\"tags\":[\"a\",\"b\"]}";
    val user = json_get(nested, "user");
    print(user);
    print("\n");

    val username = json_get(user, "name");
    print(username);
    print("\n");

    return 0;
}
