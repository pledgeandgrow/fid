// MI17 (known-bugs 2g.95): an environment variable that is not set is
// None. On pe_ir (the default Windows `fid emit`) stdlib/pe_runtime
// base.fd declared C's getenv as returning a str, so its result was owned
// through p_str_take, which turns the null of an unset variable into "":
// env_var gave Some("") and test_crash_frame_values took its panic branch.
// Every backend prints the same.
//
// Expected output:
// none
// set
// no argument 1000
// done

fn main() -> i64 {
    match env_var("FID_TEST_UNSET_2G95_Q7") {
        Option::Some(v) => {
            println("some [" + v + "]");
        }
        Option::None => {
            println("none");
        }
    }
    match env_var("PATH") {
        Option::Some(_) => {
            println("set");
        }
        Option::None => {
            println("unset");
        }
    }
    match arg_at(1000) {
        Option::Some(a) => {
            println("argument 1000 [" + a + "]");
        }
        Option::None => {
            println("no argument 1000");
        }
    }
    println("done");
    return 0;
}
