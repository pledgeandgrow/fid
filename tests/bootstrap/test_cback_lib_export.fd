// CI7 / CI6: `@export` marks a function of the C API that
// `fid ccompile --lib` builds: a shared library whose wrappers have the
// functions' own names (add, greet, ...), a generated header declaring them,
// fides_init, and fides_call(name, caps, nargs, args, &result), which runs
// an export with only the capabilities in `caps` (FIDES_CAP_FS, _NET,
// _PROC, _ENV) and returns FIDES_E_PANIC instead of ending the host on a
// panic. tests/projects/embed has a C host for this kind of library. As a
// program, the exports are ordinary functions:
//
// Expected output:
// 5
// hello, C
// 2.5
// true
// read without FS: true

use string;

@export
fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

@export
fn greet(name: str) -> str {
    return "hello, " + name;
}

@export
fn half(x: f64) -> f64 {
    return x / 2.0;
}

@export
fn is_even(n: i64) -> bool {
    return n % 2 == 0;
}

// Under fides_call without FIDES_CAP_FS the read fails as for a missing
// file, so this is true there; run directly, the file does not exist.
@export
fn missing_or_denied() -> bool {
    return p_file_exists("no_such_file_cback.txt") == false;
}

fn main() -> i64 {
    println(add(2, 3));
    println(greet("C"));
    println(half(5.0));
    println(is_even(4));
    println("read without FS: " + bool_to_str(missing_or_denied()));
    return 0;
}
