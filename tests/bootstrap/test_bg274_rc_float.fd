// BG274 (docs/roadmap/bugs-roadmap.md): `Rc::new(x)` / `Arc::new(x)` of a
// float keep the whole number (its bits): `Rc::new(4.25).get()` was 4.
//
// Expected output:
// 4.25 4.75
// 4.5
// -2.75
// 0.125

fn idd(x: f64) -> f64 {
    return x;
}

fn idf(x: f32) -> f32 {
    return x;
}

fn main() {
    val rd: Rc<f64> = Rc::new(idd(4.25));
    val x: f64 = rd.get();
    println(f"{x} {x + 0.5}");
    val rf: Rc<f32> = Rc::new(idf(4.5));
    val y: f32 = rf.get();
    println(f"{y}");
    val a: Arc<f64> = Arc::new(-2.75);
    val z: f64 = a.get();
    println(f"{z}");
    val rl: Rc<f64> = Rc::new(0.125);
    val rl2: Rc<f64> = rl.clone();
    val w: f64 = rl2.get();
    println(f"{w}");
}
