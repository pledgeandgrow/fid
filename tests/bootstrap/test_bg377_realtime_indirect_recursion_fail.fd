// expect-error: is part of a recursion cycle
// Bugs roadmap BG377: @realtime rejected only a direct self-call: `f`
// calling `g` calling `f` passed.
fn g(x: i64) -> i64 {
    if x <= 0 {
        return 0;
    }
    return f(x - 1);
}
@realtime
fn f(x: i64) -> i64 {
    return g(x);
}
fn main() {
    println(f(3));
}
