// expect-error: 'leak' returns a reference to local 'x', which is freed when it returns
// BG16: `unwrap` returns the type parameter T, which before
// monomorphization holds no reference, so the receiver's roots did not
// reach the result and a reference to the local x could be returned.
fn leak(p: &i64) -> &i64 {
    var x: i64 = 5;
    val o: Option<&i64> = Option::Some(&x);
    return o.unwrap();
}

fn main() -> i64 {
    val y: i64 = 1;
    println(int_to_str(*leak(&y)));
    return 0;
}
