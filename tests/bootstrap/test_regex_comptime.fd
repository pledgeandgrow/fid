// L4E: literal patterns are checked when the program is checked; valid
// ones compile and match as before. A pattern built at run time is not
// checked (it is compiled when the program runs), and the functions that
// compile their own pattern (regex_match, ...) still answer false for a
// bad literal one (a warning, so a test of the rejection keeps working).
//
// Expected output:
// 1 true
// 2 false
// 3 true
// 4 3
// 5 a#b#
// 6 false
// 7 false

use regex;

fn bs(b: bool) -> str {
    if b {
        return "true";
    }
    return "false";
}

fn main() -> i64 {
    val r: Regex = regex_compile("\\d{4}-(0[1-9]|1[0-2])");
    println("1 " + bs(regex_match("2026-11", "\\d{4}-(0[1-9]|1[0-2])")));
    println("2 " + bs(regex_match("2026-13", "\\d{4}-(0[1-9]|1[0-2])")));
    println("3 " + bs(regex_search("key=v1", "(?:\\w+)=[a-z]\\d")));
    println("4 " + int_to_str(regex_find_re("abc123", "[0-9]+")));
    println("5 " + regex_replace("a1b2", "[0-9]", "#"));
    // checked when it runs: the pattern is not a literal
    val open: str = "(";
    println("6 " + bs(regex_match("x", open + "x")));
    // a bad literal for regex_match: a warning, and false at run time
    println("7 " + bs(regex_match("a", "[a")));
    return 0;
}
