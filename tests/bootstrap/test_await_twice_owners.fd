// Bugs roadmap BG46: awaiting the same future twice gave both awaits the
// task's one owner of its result (a str, a Vec), and both lets kept it: a
// double free when they were dropped. A future the function awaits more
// than once gives each await an owner of its own; awaited once, the
// result is still handed over (tests/leaks/await_results.fd).
// Expected output:
// v7 v7
// 2 3
// once v1
fn mk(n: i64) -> str {
    return "v" + int_to_str(n);
}

fn mkv(n: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    v.push(n);
    return v;
}

fn main() {
    val t = spawn mk(7);
    val a = await t;
    val b = await t;
    println(a + " " + b);
    val tv = spawn mkv(3);
    val x = await tv;
    val y = await tv;
    println(int_to_str(x.len() + y.len()) + " " + int_to_str(y.get(0)));
    val t1 = spawn mk(1);
    val c = await t1;
    println("once " + c);
}
