// expect-error: expects 'i64', got 'str'
// BG242 (docs/roadmap/bugs-roadmap.md): a str is not accepted for an i64
// parameter (the checker passed the string's address). The entry's example
// was a `str_find_char(s, "x")` call; that function is gone from the
// library, so the rule is pinned on a plain function.
fn take(c: i64) -> i64 {
    return c + 1;
}

fn main() -> i64 {
    val s = "x";
    println(take(s));
    return 0;
}
