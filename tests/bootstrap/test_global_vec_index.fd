// known-bugs 2g.74: indexing a global Vec failed: `g[i] = x` was rejected
// with "cannot index undefined variable 'g'" (only `g.get(i)` and
// `g.set(i, x)` worked). Reading `g[i]`, writing `g[i] = x` and
// `g[i] += x` now work on a global Vec of numbers and of strings, from
// main and from other functions.
//
// Expected output:
// 7
// 9 7
// 19
// 12
// sum 31
// names ann zed
// first item1
// count 3
use core;

var g: Vec<i64> = Vec::new();
var names: Vec<str> = Vec::new();

fn set_at(i: i64, x: i64) {
    g[i] = x;
}

fn add_at(i: i64, x: i64) {
    g[i] += x;
}

fn sum_all() -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < g.len() {
        t = t + g[i];
        i = i + 1;
    }
    return t;
}

fn rename(i: i64, n: i64) {
    names[i] = "item" + int_to_str(n);
}

fn main() -> i64 {
    g.push(5);
    g.push(7);
    println(g[1]);
    g[0] = 9;
    println(int_to_str(g[0]) + " " + int_to_str(g.get(1)));
    set_at(0, 19);
    println(g[0]);
    add_at(1, 5);
    println(g[1]);
    println("sum " + int_to_str(sum_all()));
    names.push("bob");
    names.push("zed");
    names[0] = "ann";
    println("names " + names[0] + " " + names[1]);
    rename(0, 1);
    println("first " + names[0]);
    names.push("x");
    println("count " + int_to_str(names.len()));
    return 0;
}
