// BG395 (docs/roadmap/bugs-roadmap.md): name constraints apply to the
// subject CN of a leaf without DNS or IP SANs, since x509_matches_host
// takes the CN as the host name then. An intermediate constrained to
// permitted DNS:.example.test can no longer issue a SAN-less leaf with
// CN=bank.test that x509_verify_chain accepts. openssl verify gives the
// same answers for these certificates (made with openssl 3.5): bank and
// banksan "permitted subtree violation", good and humansp OK.
// Not on run: the ECDSA verifications take minutes in the interpreter.
//@ backends: ccompile,emit
//
// Expected output:
// parsed true true true true true true
// bank (CN=bank.test, no SAN): ok false, name not permitted: dns:bank.test
// bank matches bank.test: true
// banksan (SAN bank.test): ok false, name not permitted: dns:bank.test
// good (CN=www.example.test, no SAN): ok true
// humansp (CN=Device in room 42, no SAN): ok true
use x509;
use string;

fn root_pem() -> str {
    return "-----BEGIN CERTIFICATE-----\n" +
        "MIIBajCCARCgAwIBAgIUa3PPIkzPm+6unRMJTcwu76rkRdgwCgYIKoZIzj0EAwIw\n" +
        "EjEQMA4GA1UEAwwHTkMgUm9vdDAgFw0yNjExMjcxOTM1MTdaGA8yMTI2MTEwMzE5\n" +
        "MzUxN1owEjEQMA4GA1UEAwwHTkMgUm9vdDBZMBMGByqGSM49AgEGCCqGSM49AwEH\n" +
        "A0IABBWU/jVNhorg85AVpm1sxy321ThK+gfQgxKFBn7DmhRYObPSYRxFEpeWboCt\n" +
        "C7QrW0OWhl+1uFB2EXVsVpCxlvKjQjBAMA8GA1UdEwEB/wQFMAMBAf8wDgYDVR0P\n" +
        "AQH/BAQDAgEGMB0GA1UdDgQWBBQyczKaQudfVYa2/CVsOMGsnOKv/jAKBggqhkjO\n" +
        "PQQDAgNIADBFAiAstKibWdbGKw8udWL+1TVRy/iE55IUGrk82zg2970j7wIhAIvF\n" +
        "lYGE/eG+usgXZjsm58sGd5pGLaWkiDB5tw98Mh9n\n" +
        "-----END CERTIFICATE-----\n";
}

