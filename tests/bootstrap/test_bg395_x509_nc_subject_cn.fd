fn humansp_pem() -> str {
    return "-----BEGIN CERTIFICATE-----\n" +
        "MIIBdDCCARqgAwIBAgIBDDAKBggqhkjOPQQDAjAaMRgwFgYDVQQDDA9OQyBJbnRl\n" +
        "cm1lZGlhdGUwIBcNMjYxMTI3MTkzNTE4WhgPMjEyNTA2MjExOTM1MThaMBwxGjAY\n" +
        "BgNVBAMMEURldmljZSBpbiByb29tIDQyMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcD\n" +
        "QgAEROjO37zW+Ap3xlXswQBxpBOfuUGpJ/+Fid6s3aZCXjG5eVqC0dIu4rdCS8rO\n" +
        "xZg/Tsl4IRTiYzibf2qv+/w3jqNNMEswCQYDVR0TBAIwADAdBgNVHQ4EFgQUl9MM\n" +
        "DImq5GEeCyl2kaxZtdIoSkYwHwYDVR0jBBgwFoAUyQv9iKz/tv6CQBAo8YVhOG7e\n" +
        "9EcwCgYIKoZIzj0EAwIDSAAwRQIhAI1i+f20x2AV6SJ9mQ5HzgOMtO8kaQlcSAkX\n" +
        "8lLi1twqAiBOB/vGa+iatgIwvemBRJQFV7IVEOfT62013w3PjNeP3g==\n" +
        "-----END CERTIFICATE-----\n";
}

fn check(label: str, leaf: X509Cert, inter: X509Cert, root: X509Cert) -> void {
    var chain: Vec<X509Cert> = Vec::new();
    chain.push(leaf);
    chain.push(inter);
    var anchors: Vec<X509Cert> = Vec::new();
    anchors.push(root);
    val r: X509ChainResult = x509_verify_chain(chain, anchors, 1800000000);
    if r.ok {
        println(label + ": ok true");
    } else {
        println(label + ": ok false, " + r.err);
    }
}

fn main() -> i64 {
    val root: X509Cert = x509_parse_pem(root_pem());
    val inter: X509Cert = x509_parse_pem(inter_pem());
    val bank: X509Cert = x509_parse_pem(bank_pem());
    val banksan: X509Cert = x509_parse_pem(banksan_pem());
    val good: X509Cert = x509_parse_pem(good_pem());
    val humansp: X509Cert = x509_parse_pem(humansp_pem());
    println("parsed " + bool_to_str(root.ok) + " " + bool_to_str(inter.ok) + " " + bool_to_str(bank.ok) + " " + bool_to_str(banksan.ok) + " " + bool_to_str(good.ok) + " " + bool_to_str(humansp.ok));
    // the entry's trigger
    check("bank (CN=bank.test, no SAN)", bank, inter, root);
    println("bank matches bank.test: " + bool_to_str(x509_matches_host(bank, "bank.test")));
    // the same name as a SAN (rejected before the fix too)
    check("banksan (SAN bank.test)", banksan, inter, root);
    // a CN inside the permitted subtree, and a CN that is not a host name
    check("good (CN=www.example.test, no SAN)", good, inter, root);
    check("humansp (CN=Device in room 42, no SAN)", humansp, inter, root);
    return 0;
}
