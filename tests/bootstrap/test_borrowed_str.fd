// Owned and borrowed strings (release M11): `str` is owned, `&str` borrowed.
// A string read out of a @scoped struct is borrowed. A borrowed string can be
// read, compared, printed, joined with `+` (the result is owned) and passed
// to `&str` parameters; str_clone makes an owned copy that can be kept.

@scoped
struct Msg {
    text: str,
    from: str,
}

fn greet(name: &str) -> str {
    return "hi " + name;
}

fn count(m: Msg) -> i64 {
    return str_len(m.text) + str_len(m.from);
}

fn keep(m: Msg) -> str {
    return str_clone(m.from);
}

fn main() {
    val owned: str = "ann" + int_to_str(1);
    println(greet(&owned));
    val m: Msg = Msg { text: "hello", from: owned };
    println(count(m));
    println(keep(m));
    println(m.text == "hello");
    println(greet(m.from));
    var kept: Vec<str> = Vec::new();
    kept.push(str_clone(m.text));
    println(kept.get(0));
}
