use encoding;

fn main() -> i64 {
    // ── base64 ──
    print("b64: ");
    print(b64_encode("hello"));
    print("|");
    print(b64_decode("aGVsbG8="));
    print("|");
    print(b64_encode("h"));
    print("|");
    print(b64_decode("aA=="));
    print("|");
    print(b64_valid("aGVsbG8="));
    print(b64_valid("not!b64"));
    print("\n");

    // binary roundtrip through bytes (incl. 0x00 and 0xFF)
    var bytes = Vec::new();
    bytes.push(0);
    bytes.push(255);
    bytes.push(104);
    var enc = b64_encode_bytes(bytes);
    var dec = b64_decode_bytes(enc);
    print("b64-bytes: ");
    print(enc);
    print("|");
    print(dec.len() == bytes.len());
    var i = 0;
    var same = true;
    while i < bytes.len() {
        if dec.get(i) != bytes.get(i) { same = false; }
        i = i + 1;
    }
    print(same);
    print("\n");

    // ── hex ──
    print("hex: ");
    print(hex_encode("ABz"));
    print("|");
    print(hex_encode_upper("ABz"));
    print("|");
    print(hex_decode("41427a"));
    print("|");
    print(hex_valid("4142"));
    print(hex_valid("414"));
    print("\n");

    // ── url ──
    print("url: ");
    print(url_encode("a b&c/d?e=f"));
    print("|");
    print(url_decode("a%20b%26c%2Fd%3Fe%3Df"));
    print("|");
    print(url_decode_form("a+b%3D2"));
    print("|");
    print(url_encode("abc-_.~"));
    print("\n");

    // ── utf-8 (literal UTF-8 source text) ──
    print("utf8: ");
    print(utf8_valid("hello"));
    print(utf8_valid("h€"));
    print(utf8_len("h€cllo"));
    print("|");
    var cps = utf8_decode("h€");
    print(cps.len());
    print("|");
    print(cps.get(0));
    print("|");
    print(cps.get(1));
    print("|");
    print(str_equal(utf8_encode(8364), "€"));
    print("|");
    print(str_equal(utf8_encode_all(cps), "h€"));
    print("|");
    // invalid UTF-8: lone continuation byte 0x80
    var bad = Vec::new();
    bad.push(104);
    bad.push(128);
    print(utf8_valid_bytes(bad));
    print("\n");

    return 0;
}
