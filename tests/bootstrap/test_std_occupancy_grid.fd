// stdlib/occupancy_grid: Bresenham lines in several octants, log-odds updates with clamping, a laser scan of a rectangular room inserted twice, probability queries, a simulated range sensor on the map, and merging two maps (map checked against a Python replica)
// Expected output:
// line (0,0)-(5,2): (0,0) (1,0) (2,1) (3,1) (4,2) (5,2)
// line (3,4)-(2,0): (3,4) (3,3) (2,2) (2,1) (2,0)
// line (4,1)-(0,1): (4,1) (3,1) (2,1) (1,1) (0,1)
// cell of (1.3, 2.0) = (2, 4) center (1.25, 2.25)
// prob after 1 hit 0.7000, after 10 hits 0.9700, after 10 misses 0.1200
// map:
// ##########?#
// #..........#
// #..........#
// #..........#
// #..........#
// #..........#
// #..........#
// ##########?#
// occupied 34 free 60 unknown 2
// p at (4.0, 2.0) = 0.1200, p at (5.75, 2.0) = 0.9700
// raycast east = 4.250 north = 1.500
// merge: occupied 34 free 60 unknown 2
// merge geometry: ogrid_merge: grids differ in geometry
// merge_at: occupied 1 at (4, 5): 1
use occupancy_grid;
use quat;
use math;

fn line(x0: i64, y0: i64, x1: i64, y1: i64) -> str {
    val c: Vec<i64> = ogrid_bresenham(x0, y0, x1, y1);
    var out: str = "";
    var i: i64 = 0;
    while i < c.len() / 2 {
        if i > 0 {
            out = out + " ";
        }
        out = out + "(" + int_to_str(c.get(2 * i)) + "," + int_to_str(c.get(2 * i + 1)) + ")";
        i = i + 1;
    }
    return out;
}

// distance from (px, py) along angle a to the walls of the box
// [0.25, 5.75] x [0.25, 3.75]
fn room_range(px: f64, py: f64, a: f64) -> f64 {
    val c: f64 = math_cos(a);
    val s: f64 = math_sin(a);
    var best: f64 = 1.0e9;
    if c > 0.000000001 {
        best = rmath_min(best, (5.75 - px) / c);
    }
    if c < - 0.000000001 {
        best = rmath_min(best, (0.25 - px) / c);
    }
    if s > 0.000000001 {
        best = rmath_min(best, (3.75 - py) / s);
    }
    if s < - 0.000000001 {
        best = rmath_min(best, (0.25 - py) / s);
    }
    return best;
}

fn counts(g: & OccGrid) -> str {
    return "occupied " + int_to_str(ogrid_count(g, 1)) + " free " + int_to_str(ogrid_count(g, 0)) + " unknown " + int_to_str(ogrid_count(g, -1));
}

fn main() -> i64 {
    println("line (0,0)-(5,2): " + line(0, 0, 5, 2));
    println("line (3,4)-(2,0): " + line(3, 4, 2, 0));
    println("line (4,1)-(0,1): " + line(4, 1, 0, 1));

    var g: OccGrid = ogrid_new(12, 8, 0.5, 0.0, 0.0);
    val c: GridCell = ogrid_world_to_cell(&g, 1.3, 2.0);
    val cc: vec2 = ogrid_cell_center(&g, c.x, c.y);
    println("cell of (1.3, 2.0) = (" + int_to_str(c.x) + ", " + int_to_str(c.y) + ") center (" + rmath_fmt(cc.x, 2) + ", " + rmath_fmt(cc.y, 2) + ")");

    var t: OccGrid = ogrid_new(2, 1, 1.0, 0.0, 0.0);
    ogrid_update_cell(&mut t, 0, 0, t.l_occ);
    val p1: f64 = ogrid_prob(&t, 0, 0);
    var i: i64 = 0;
    while i < 9 {
        ogrid_update_cell(&mut t, 0, 0, t.l_occ);
        ogrid_update_cell(&mut t, 1, 0, t.l_free);
        i = i + 1;
    }
    ogrid_update_cell(&mut t, 1, 0, t.l_free);
    println("prob after 1 hit " + rmath_fmt(p1, 4) + ", after 10 hits " + rmath_fmt(ogrid_prob(&t, 0, 0), 4) + ", after 10 misses " + rmath_fmt(ogrid_prob(&t, 1, 0), 4));

    // a 360 degree scan, 2 degrees apart, from (1.3, 2.0); range_max 5
    val px: f64 = 1.3;
    val py: f64 = 2.0;
    var ranges: Vec<f64> = Vec::new();
    val inc: f64 = rmath_pi() / 90.0;
    i = 0;
    while i < 180 {
        ranges.push(room_range(px, py, (i as f64) * inc));
        i = i + 1;
    }
    ogrid_insert_scan(&mut g, px, py, 0.0, &ranges, 0.0, inc, 5.0);
    ogrid_insert_scan(&mut g, px, py, 0.0, &ranges, 0.0, inc, 5.0);
    println("map:");
    println(ogrid_to_ascii(&g));
    println(counts(&g));
    println("p at (4.0, 2.0) = " + rmath_fmt(ogrid_prob_at(&g, 4.0, 2.0), 4) + ", p at (5.75, 2.0) = " + rmath_fmt(ogrid_prob_at(&g, 5.75, 2.0), 4));
    println("raycast east = " + rmath_fmt(ogrid_raycast(&g, px, py, 0.0, 8.0), 3) + " north = " + rmath_fmt(ogrid_raycast(&g, px, py, rmath_pi() / 2.0, 8.0), 3));

    // two maps of one scan each merge to a map like the two-scan one
    var h1: OccGrid = ogrid_new(12, 8, 0.5, 0.0, 0.0);
    var h2: OccGrid = ogrid_new(12, 8, 0.5, 0.0, 0.0);
    ogrid_insert_scan(&mut h1, px, py, 0.0, &ranges, 0.0, inc, 5.0);
    ogrid_insert_scan(&mut h2, px, py, 0.0, &ranges, 0.0, inc, 5.0);
    match ogrid_merge(&h1, &h2) {
        Result::Ok(m) => {
            println("merge: " + counts(&m));
        }
        Result::Err(e) => {
            println(e);
        }
    }
    val other: OccGrid = ogrid_new(12, 8, 0.25, 0.0, 0.0);
    match ogrid_merge(&h1, &other) {
        Result::Ok(m) => {
            println("merge geometry: merged?");
        }
        Result::Err(e) => {
            println("merge geometry: " + e);
        }
    }
    var small: OccGrid = ogrid_new(2, 2, 0.5, 0.0, 0.0);
    ogrid_update_cell(&mut small, 1, 1, small.l_occ);
    var big: OccGrid = ogrid_new(12, 8, 0.5, 0.0, 0.0);
    ogrid_merge_at(&mut big, &small, 3, 4);
    println("merge_at: occupied " + int_to_str(ogrid_count(&big, 1)) + " at (4, 5): " + int_to_str(ogrid_state(&big, 4, 5)));
    return 0;
}
