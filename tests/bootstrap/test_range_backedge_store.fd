// BG3 (docs/roadmap/bugs-roadmap.md): the range analysis
// (compiler/checks.fd, peir_join_set / peir_join_stored) kept the fact a
// loop header had on the way in (n = 1) across the back edge although the
// header itself stores n, so `n * 3` lost its overflow check and the
// product wrapped to a negative number ("wrapped" was printed). n * 3
// overflows at the 40th multiply (3^40 > 2^63): that must panic.
//
// Expected output:
// start
// Expected exit: 1

fn grow() -> i64 {
    var n: i64 = 1;
    loop {
        n = n * 3;
        if n < 0 {
            println("wrapped");
            return n;
        }
    }
}

fn main() {
    println("start");
    println(grow());
    println("not reached");
}
