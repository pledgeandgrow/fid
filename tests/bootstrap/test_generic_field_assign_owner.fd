// Test (BG6): assigning to a type-parameter field of a generic struct
// instance owns the new value and drops the old one, as the instance's
// type argument says. The field's ownership type was the declared `T`
// (owning nothing), while the instance's drop dropped it as a str: `s`
// was freed twice and "ab" leaked. A struct in such a field is a pointer
// to a heap copy (as a literal stores it), not the local's stack address.
//
// Expected output:
// xy
// xy
// lit
// rs
// rs
// 2
// uv
// 3
// ab
// done

struct H<T> { v: T }

struct Inner { s: str, n: i64 }

fn main() -> i64 {
    var h: H<str> = H { v: "a" + "b" };
    val s = "x" + "y";
    h.v = s;
    println(s);
    println(h.v);
    h.v = "lit";
    println(h.v);

    var g: H<Inner> = H { v: Inner { s: "p" + "q", n: 1 } };
    val inner = Inner { s: "r" + "s", n: 2 };
    g.v = inner;
    println(inner.s);
    println(g.v.s);
    println(g.v.n);
    g.v = Inner { s: "u" + "v", n: 3 };
    println(g.v.s);
    println(g.v.n);

    var k: H<str> = H { v: "a" + "b" };
    k.v = k.v;
    println(k.v);
    println("done");
    return 0;
}
