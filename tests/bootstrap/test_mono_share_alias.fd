// WP19 (compiler/mono.fd mono_share_key): a generic's instances are keyed
// by their type arguments as lowering sees them. A type alias lowers as its
// target (lower.fd Lowerer_resolve_type), so `pick(m, ..)` with m: Meters
// and `pick(4, ..)` use one instance, pick__i64, built once; the same for
// Label and str, Pt and Point, Vec<Meters> and Vec<i64>, and the generic
// impl method Wrap<Meters>.get and Wrap<i64>.get (Wrap__get__i64). The
// shared bodies must behave as the separate ones did: type_name_of reads
// the type lowering sees in both. Score has an impl of its own name, so it
// is not resolved and keeps its own instance (the program prints the same
// either way). tests/mono_share/check.sh checks which instances exist;
// FID_MONO_SHARE_OFF=1 builds them as spelled and must print the same.
//
// Expected output:
// 7
// 9
// right
// a
// 3
// 2
// 1
// i64
// i64
// 11
// 12
// 3
// 5
// 40

type Meters = i64;
type Label = str;
type Pt = Point;
type Score = i64;

struct Point {
    x: i64,
    y: i64,
}

struct Wrap<T> {
    v: T,
}

impl<T> Wrap<T> {
    fn get(self) -> T {
        return self.v;
    }
}

struct Board {
    n: i64,
}

impl Score {
    fn doubled(self) -> i64 {
        return self * 2;
    }
}

fn pick<T>(a: T, b: T, first: bool) -> T {
    if first {
        return a;
    }
    return b;
}

fn count_of<T>(v: Vec<T>) -> i64 {
    return v.len();
}

fn name_of<T>(x: T) -> str {
    return type_name_of(x);
}

fn keep<T>(x: T) -> T {
    return x;
}

fn main() {
    val m: Meters = 7;
    println(pick(m, 3, true));
    println(pick(4, 9, false));
    val l: Label = "left";
    println(pick(l, "right", false));
    println(pick("a", "b", true));
    val p: Pt = Point { x: 1, y: 2 };
    val q: Point = Point { x: 3, y: 4 };
    val r: Point = pick(p, q, true);
    println(r.x + r.y);
    var v: Vec<Meters> = Vec::new();
    v.push(m);
    v.push(m);
    var w: Vec<i64> = Vec::new();
    w.push(1);
    println(count_of(v));
    println(count_of(w));
    println(name_of(m));
    println(name_of(5));
    val c: Wrap<Meters> = Wrap { v: 11 };
    val d: Wrap<i64> = Wrap { v: 12 };
    println(c.get());
    println(d.get());
    val b: Board = Board { n: 3 };
    println(b.n);
    val s: Score = 5;
    println(keep(s));
    val t: i64 = keep(20);
    println(t * 2);
}
