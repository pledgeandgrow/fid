// expect-error: generated function 'double' collides with a function already declared
// LG9: a name generated by `comptime gen` never silently replaces or
// shadows one the program declares.
fn double(n: i64) -> i64 { return n + n; }

fn main() -> i64 {
    comptime gen {
        return "fn double(n: i64) -> i64 { return n * 3; }";
    }
    println(double(2));
    return 0;
}
