// CU3 (docs/roadmap/complaint-roadmap.md): calls of a function marked
// `@deprecated(use = "new_fn")` are warnings on every build and run (on
// stderr; before, only `fid lint` showed them), and `fid fix` replaces
// each call with the named function (compiler/lsp.fd fix_for, the
// "is deprecated: use" case). scripts/tooling-goals-check.sh runs
// `fid fix` on a copy and checks that no call of `area(` is left in main
// and that the fixed program prints the same.
// Expected output:
// 6
// 20

@deprecated(use = "area_of")
fn area(w: i64, h: i64) -> i64 {
    return w * h;
}

fn area_of(w: i64, h: i64) -> i64 {
    return w * h;
}

fn main() -> i64 {
    println(area(2, 3));
    val big: i64 = area(4, 5);
    println(big);
    return 0;
}
