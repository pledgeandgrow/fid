// LF7: expected to fail at run time (index out of bounds). A loop counting
// down by 2 with the test `i > 0` lets i be 1 at the test, so the read
// `v.get(i)` after the decrement can be at -1 (v.len() == 3: i = 3, 1,
// then -1). compiler/checks.fd peir_counted_down proves a read after a
// decrement by c only when the test keeps i >= c, so this check stays and
// panics. A proof that ignored the step would read before the start.

fn sum_by_two(v: & Vec<i64>) -> i64 {
    var t: i64 = 0;
    var i: i64 = v.len();
    while i > 0 {
        i = i - 2;
        t = t + v.get(i);
    }
    return t;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    println(sum_by_two(& v));
    print("unreachable\n");
}
