// expect-error: `i64 * Vec2`: `Vec2.rmul` must take self and one operand of type i64.
// Expected to FAIL (CE4): `2 * v` runs `v.rmul(2)`; Vec2's rmul takes an
// f64, not an i64 (TypeChecker_check_struct_operator_named).
struct Vec2 {
    x: f64,
    y: f64,
}

impl Vec2 {
    fn rmul(self, k: f64) -> Vec2 {
        return Vec2 { x: self.x * k, y: self.y * k };
    }
}

fn main() -> i64 {
    val v: Vec2 = Vec2 { x: 1.0, y: 2.0 };
    val w: Vec2 = 2 * v;
    println(int_to_str(w.x as i64));
    return 0;
}
