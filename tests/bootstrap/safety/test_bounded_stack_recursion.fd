// expect-error: is @bounded-stack but can recurse
// A helper that recurses makes the annotated function's stack unbounded
@bounded-stack
fn depth(n: i64) -> i64 {
    if n == 0 { return 0; }
    return 1 + depth(n - 1);
}

@bounded-stack
fn measure(n: i64) -> i64 {
    return depth(n);
}

fn main() -> i64 {
    println(measure(5));
    return 0;
}
