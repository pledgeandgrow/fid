// expect-error: cannot assign f64 to variable 'n' of type i64
// A float never becomes an integer without `as`.
fn first<T>(xs: Vec<T>) -> T {
    return xs.get(0);
}

fn main() -> i64 {
    var fs: Vec<f64> = Vec::new();
    fs.push(1.5);
    val n: i64 = first(fs);
    println(n);
    return 0;
}
