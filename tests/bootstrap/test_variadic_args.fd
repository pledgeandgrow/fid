// L8E / L8 exit criteria (complaint CL4): variadic arguments. The
// arguments after the fixed parameters of `...xs: T` arrive as one Vec<T>
// (any number, none included); calls nest, take expressions, strings, and
// mix with named and default arguments of other functions.
//
// Expected output:
// 6
// 0
// 42
// 150
// (a-b-c)
// ()
// 3 x 11
// 22
// 7
// 115

fn sum(...xs: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < xs.len() {
        s = s + xs.get(i);
        i = i + 1;
    }
    return s;
}

fn join(sep: str, ...parts: str) -> str {
    var out: str = "(";
    var i: i64 = 0;
    while i < parts.len() {
        if i > 0 {
            out = out + sep;
        }
        out = out + parts.get(i);
        i = i + 1;
    }
    return out + ")";
}

fn count_and_max(label: str, ...xs: i64) -> str {
    var m: i64 = 0;
    var i: i64 = 0;
    while i < xs.len() {
        if xs.get(i) > m {
            m = xs.get(i);
        }
        i = i + 1;
    }
    return int_to_str(xs.len()) + " " + label + " " + int_to_str(m);
}

fn scaled(x: i64, factor: i64 = 2, offset: i64 = 1) -> i64 {
    return x * factor + offset;
}

fn main() -> i64 {
    println(sum(1, 2, 3));
    println(sum());
    println(sum(42));
    println(sum(10, 20, sum(30, 40), 50));
    println(join("-", "a", "b", "c"));
    println(join(", "));
    println(count_and_max("x", 4, 11, 7));
    println(sum(scaled(5), scaled(x: 3, offset: 0), scaled(1, factor: 4)));
    println(scaled(offset: 1, x: 3));
    println(scaled(x: sum(50, 7), offset: 1));
    return 0;
}
