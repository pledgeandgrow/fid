// Miscompile log V1d: a `break` or `continue` inside a `match` arm inside
// a `for` loop over a literal range is the loop's. The comptime unroller (comptime_eval.fd, I-5D) unrolled such a
// body because stmt_has_break_or_continue did not look inside `match`, so
// the `break` left only the arm and the loop went on.

fn first_break() -> i64 {
    var a: i64 = 0;
    for k in 0..3 {
        match k {
            _ => { break; }
        }
        a = a + 1;
    }
    return a;
}

fn break_on_zero() -> i64 {
    var c: i64 = 0;
    for k in 0..3 {
        match k {
            0 => { if k == 0 { break; } }
            _ => { }
        }
        c = c + 1;
    }
    return c;
}

fn continue_in_match() -> i64 {
    var n: i64 = 0;
    for k in 0..4 {
        match k {
            1 => { continue; }
            _ => { }
        }
        n = n + 10;
    }
    return n;
}

fn main() -> i64 {
    println(first_break());
    println(break_on_zero());
    println(continue_in_match());
    return 0;
}
//> 0
//> 0
//> 30
