// Bugs roadmap BG339: `f"{x:.N}"` rounded the double twice
// (stdlib/core.fd fstr_fmt_f64: `(frac * 10^N + 0.5) as i64`, the product
// rounded to a double first), so a value whose exact binary value is just
// below a half-way point rounded up: 0.0055 (0.005499999...) printed
// "0.006". It now rounds the exact product once (__fstr_round_scaled);
// values exactly half-way still round away from zero. Expected values are
// the exact binary value rounded (Python Decimal, ROUND_HALF_UP).
//
// Expected output:
// [0.005] [0.019]
// [2.67] [1.00] [9.99]
// [0.13] [3] [0.5]
// [-0.005] [-3]
// [0.333333333333333315]
// [1000000000000000.250]
// [0.000123457]

fn main() {
    println(f"[{0.0055:.3}] [{0.0195:.3}]");
    println(f"[{2.675:.2}] [{1.005:.2}] [{9.995:.2}]");
    println(f"[{0.125:.2}] [{2.5:.0}] [{0.5:.1}]");
    val a: f64 = -0.0055;
    val b: f64 = -2.5;
    println(f"[{a:.3}] [{b:.0}]");
    val t: f64 = 1.0 / 3.0;
    println(f"[{t:.18}]");
    println(f"[{1000000000000000.25:.3}]");
    println(f"[{0.000123456789:.9}]");
}
