// expect-error: Budget error (line 6): region 'r' with budget(64) allocates on the heap
// Test: a region budget counts heap allocations too. A Vec that grows
// (push in a loop) has no size known at compile time, so it cannot be
// proved to fit in budget(64).
fn main() -> i64 {
    region r with budget(64) {
        var v: Vec<i64> = Vec::new();
        var i: i64 = 0;
        while i < 100000 {
            v.push(i);
            i = i + 1;
        }
        println(v.len());
    }
    return 0;
}
