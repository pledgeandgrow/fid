// expect-error: takes integers
// BG201 (docs/roadmap/bugs-roadmap.md): `& | ^ << >>` take integers. A
// float operand was given f64: `check` passed, the interpreter printed 0
// and C failed to compile.
fn main() -> i64 {
    var f: f64 = 1.5;
    val g = f & 2.0;
    println(g);
    return 0;
}
