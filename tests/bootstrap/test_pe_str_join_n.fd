// BG93 (docs/roadmap/bugs-roadmap.md): pe_ir's p_str_join_n
// (compiler/pe_ir_stubs.fd PeirGen_gen_str_join_n) returned a plain
// p_malloc block, not the counted string the builtin promises (lower.fd
// lists it among those that return a fresh owned str: proposal 0004's
// [P_STR_RC + 1][len] header), counted each part with strlen (a part
// with a zero byte was cut), and for an empty Vec wrote no NUL at all.
// Now it builds a counted string like p_str_concat, counts each part by
// its header's length, and ends the result with a NUL itself.
// p_str_join_n is a C-path and pe_ir builtin, and the machine layer's
// (BG251: stdlib/linux_runtime/base.fd pert_str_join_n; before, `emit
// --nat` stopped with "not available in native Windows executables
// yet"); the interpreter has no such builtin.
//@ backends: ccompile,emit,nat
//
// Expected output:
// [abcdef]
// 6
// []
// 0
// [x-0x-1x-2]
// 9

fn main() -> i64 {
    var parts: Vec<str> = Vec::new();
    parts.push("ab");
    parts.push("cd");
    parts.push("ef");
    val s: str = p_str_join_n(parts);
    println("[" + s + "]");
    println(str_len(s));
    var none: Vec<str> = Vec::new();
    val e: str = p_str_join_n(none);
    println("[" + e + "]");
    println(str_len(e));
    var built: Vec<str> = Vec::new();
    var i: i64 = 0;
    while i < 3 {
        built.push("x-" + int_to_str(i));
        i = i + 1;
    }
    val j: str = p_str_join_n(built);
    println("[" + j + "]");
    println(str_len(j));
    return 0;
}
