// Bugs roadmap BG227: in native Windows executables (pe_runtime) a worker
// read how a task had left (`t + 80`) after the switch back, when a task
// that blocked may already have been woken, run to its end on another
// worker and finished: the first worker then finished it a second time
// (pert_live decremented twice, so task_run returned with tasks still
// running; its context freed twice; its stack cached twice, so two later
// tasks shared one). stdlib/pe_runtime/conc.fd: a task writes how it left
// (2 finished, 1 runnable, 0 blocked) and whoever resumes it reads that.
//
// The stress: many short tasks park on a contended mutex (BG195: a task
// waits for it parked and the holder wakes it from its own worker), so a
// task is often woken and finished elsewhere right after it blocks. Each
// round checks that task_run returned only after every task finished, and
// each task that its locals survived the switches (a shared stack breaks
// them). With the race, a round comes back short or a check fails (or the
// program crashes on a double free).
//@ backends: emit
//
// Expected output:
// rounds 300
// short 0
// bad 0
// total 307200

use task;

var M: i64 = 0;
var TOTAL: i64 = 0;
var DONE: i64 = 0;
var BAD: i64 = 0;

fn worker(id: i64) -> i64 {
    // locals that must come back intact from every switch
    var a: i64 = id * 7 + 3;
    var b: i64 = id * 13 + 5;
    var s: i64 = 0;
    var i: i64 = 0;
    while i < 4 {
        p_mutex_lock(M);
        val v = p_atomic_load(TOTAL);
        p_atomic_store(TOTAL, v + 1);
        p_mutex_unlock(M);
        s = s + a + b;
        if i == 1 {
            task_yield();
        }
        i = i + 1;
    }
    if a != id * 7 + 3 || b != id * 13 + 5 || s != 4 * (a + b) {
        p_atomic_add(BAD, 1);
    }
    p_atomic_add(DONE, 1);
    return id;
}

fn main() -> i64 {
    M = p_mutex_init();
    TOTAL = p_shared_alloc(8);
    DONE = p_shared_alloc(8);
    BAD = p_shared_alloc(8);
    p_atomic_store(TOTAL, 0);
    p_atomic_store(BAD, 0);
    val n: i64 = 256;
    var short: i64 = 0;
    var r: i64 = 0;
    while r < 300 {
        p_atomic_store(DONE, 0);
        var k: i64 = 0;
        while k < n {
            val t = task_go("worker", r * n + k);
            task_detach(t);
            k = k + 1;
        }
        task_run();
        // every task of the round has finished when task_run returns
        if p_atomic_load(DONE) != n {
            short = short + 1;
        }
        r = r + 1;
    }
    println("rounds " + int_to_str(r));
    println("short " + int_to_str(short));
    println("bad " + int_to_str(p_atomic_load(BAD)));
    println("total " + int_to_str(p_atomic_load(TOTAL)));
    return 0;
}
