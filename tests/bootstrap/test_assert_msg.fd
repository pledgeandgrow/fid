// Test: assert with message (SH-1.6)
// Tests assert_msg and assert_eq_msg with custom messages.

fn main() -> i64 {
    // assert_msg with true condition — should not panic
    assert_msg(1 < 2, "1 should be less than 2");
    print("assert_msg(true) OK\n");

    // assert_eq_msg with equal values — should not panic
    assert_eq_msg(42, 42, "42 should equal 42");
    print("assert_eq_msg(equal) OK\n");

    // assert_msg with f-string formatting and true condition
    val x = 10;
    val y = 20;
    assert_msg(x < y, f"x={x} should be less than y={y}");
    print("assert_msg(f-string) OK\n");

    // assert_eq_msg with f-string formatting and equal values
    assert_eq_msg(x + 10, y, f"x+10={x+10} should equal y={y}");
    print("assert_eq_msg(f-string) OK\n");

    // Verify the original assert still works
    assert(true);
    print("assert(true) OK\n");

    // Verify the original assert_eq still works
    assert_eq(1, 1);
    print("assert_eq(equal) OK\n");

    print("OK\n");
    return 0;
}
