// expect-error: is @firmware but calls 'p_getenv'
// Test: @firmware rejects OS-dependent calls (release L1: runtime calls
// were skipped before the @firmware check looked at them).

@firmware
fn read_config() -> i64 {
    val home: str = p_str_take(p_getenv("HOME"));
    return str_len(home);
}

fn main() {
    println(read_config());
}
