// expect-error: compares secret text or a secret collection with `==`/`!=`, which stops at the first difference
// Bugs roadmap BG374: `a == b` on secret strings compares byte by byte and
// stops at the first difference (the textbook MAC/password timing leak),
// yet a @constant_time function using it was accepted.
@constant_time
@wrapping
fn f(a: str, b: str) -> bool {
    return a == b;
}
fn main() {
    println(f("abc", "abd"));
}
