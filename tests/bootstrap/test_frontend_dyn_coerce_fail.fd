// expect-error: expects 'dyn Animal', got 'Dog'
// LG4: a trait object is made only by `v as dyn Trait` (the lowering builds
// the object at that cast). Passing a plain struct where a `dyn Trait` is
// wanted was accepted ("dyn is compatible with anything") and the call
// through it then read the struct as an object.
cap Animal {
    fn legs(self) -> i64;
}

struct Dog { age: i64 }

impl Animal for Dog {
    pub fn legs(self: Dog) -> i64 { return 4; }
}

fn count(a: dyn Animal) -> i64 {
    return a.legs();
}

fn main() -> i64 {
    val d = Dog { age: 3 };
    println(count(d));
    return 0;
}
