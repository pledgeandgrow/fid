// Test (stdlib-agent bugs 10, 18): a function value returning Vec<str> or
// Vec<Struct>, and one taking a Vec. The elements read back as garbage
// (f(1).get(0) printed 5000, not "abc"): the call's result type was only
// known for a function-typed parameter, not for a variable. Also run it
// through `fid ccompile`.
// Expected output:
// abc 1
// 7 x
// 3
// 2
struct R {
    n: i64,
    s: str,
}

fn mk(k: i64) -> Vec<str> {
    var v: Vec<str> = Vec::new();
    v.push("abc");
    v.push(int_to_str(k));
    return v;
}

fn mr(k: i64) -> Vec<R> {
    var v: Vec<R> = Vec::new();
    v.push(R { n: k, s: "x" });
    return v;
}

fn total(v: Vec<i64>) -> i64 {
    var t: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        t = t + v.get(i);
        i = i + 1;
    }
    return t;
}

fn apply(v: Vec<i64>, f: fn(Vec<i64>) -> i64) -> i64 {
    return f(v);
}

fn main() {
    val f: fn(i64) -> Vec<str> = mk;
    val v = f(1);
    println(v.get(0) + " " + v.get(1));
    val g: fn(i64) -> Vec<R> = mr;
    val w = g(7);
    println(int_to_str(w.get(0).n) + " " + w.get(0).s);
    var d: Vec<i64> = Vec::new();
    d.push(1);
    d.push(2);
    println(apply(d, total));
    val h = total;
    println(h(d) - 1);
}
