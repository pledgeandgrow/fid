// A `handle` ending a function gives the function its value.
fn after_do(x: i64) -> i64 {
    handle {
        do Log.note(x);
        x * 2
    } with {
        Log.note(v) => {
            println(v);
            resume(cont, 0);
        }
    }
}

fn no_do(x: i64) -> i64 {
    handle {
        x + 1
    } with {
        Log.note(v) => {
            resume(cont, 0);
        }
    }
}

fn main() -> i64 {
    val a = after_do(20);
    val b = no_do(5);
    println(a);
    println(b);
    if a != 40 || b != 6 { p_panic("a handle lost its value"); }
    return 0;
}
