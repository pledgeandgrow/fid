// `continue` in every `for` form goes on with the next element (M13: the
// continue target was the condition block, past the index increment, so the
// loop never ended). Expected output:
// 5
// 40
// 3
// 4

fn main() -> i64 {
    var n: i64 = 0;
    for k in 0..4 {
        if k == 1 { continue; }
        n = n + k;
    }
    println(n);
    var v: Vec<i64> = Vec::new();
    v.push(10);
    v.push(20);
    v.push(30);
    var s: i64 = 0;
    for x in v {
        if x == 20 { continue; }
        s = s + x;
    }
    println(s);
    var c: i64 = 0;
    for ch in "a-b-c" {
        if ch == "-" { continue; }
        c = c + 1;
    }
    println(c);
    var m: i64 = 0;
    for j in 0..=4 {
        if j % 2 == 1 { continue; }
        m = m + 1;
        if j == 4 { m = m + 1; }
    }
    println(m);
    return 0;
}
