// BG310 (docs/roadmap/bugs-roadmap.md): bigint_from_i64 takes every i64,
// i64::MIN included (it negated the argument with checked arithmetic and
// panicked on the one value whose negation does not fit).
//
// Expected output:
// -9223372036854775808
// -9223372036854775807
// 9223372036854775807
// -1000000000
// -999999999
// 0
// -42
// -9223372036854775808
// -9223372036854775809
use bigint;

fn main() -> i64 {
    // the entry's trigger
    println(bigint_to_str(bigint_from_i64(-9223372036854775807 - 1)));
    // around it, and limb boundaries (base 10^9)
    println(bigint_to_str(bigint_from_i64(-9223372036854775807)));
    println(bigint_to_str(bigint_from_i64(9223372036854775807)));
    println(bigint_to_str(bigint_from_i64(-1000000000)));
    println(bigint_to_str(bigint_from_i64(-999999999)));
    println(bigint_to_str(bigint_from_i64(0)));
    println(bigint_to_str(bigint_from_i64(-42)));
    // the value is usable: back to i64 and in arithmetic
    val m = bigint_from_i64(-9223372036854775807 - 1);
    println(f"{bigint_to_i64(m)}");
    println(bigint_to_str(bigint_sub(m, bigint_one())));
    return 0;
}
