// Test: Iterator support — HashMap iteration, Vec iteration, Range iteration (Phase 7.7)
//
// for k in map { ... } iterates over HashMap keys.
// for x in vec { ... } iterates over Vec elements.
// for i in start..end { ... } iterates over a range.

fn main() {
    // Test 1: HashMap iteration — iterate over keys
    val m = HashMap::new();
    m.insert("apple", 1);
    m.insert("banana", 2);
    m.insert("cherry", 3);

    // Iterate over keys and sum the values
    var total = 0;
    for k in m {
        val v = m.get(k);
        total = total + v;
    }
    print("total = ");
    print(total);
    print("\n");

    // Test 2: Vec iteration
    val v = Vec::new();
    v.push(10);
    v.push(20);
    v.push(30);

    var vsum = 0;
    for x in v {
        vsum = vsum + x;
    }
    print("vsum = ");
    print(vsum);
    print("\n");

    // Test 3: Range iteration
    var rsum = 0;
    for i in 1..=5 {
        rsum = rsum + i;
    }
    print("rsum = ");
    print(rsum);
    print("\n");

    // Test 4: Vec iteration with string elements
    val names = Vec::new();
    names.push("Alice");
    names.push("Bob");
    names.push("Charlie");

    var count = 0;
    for name in names {
        count = count + 1;
    }
    print("count = ");
    print(count);
    print("\n");

    // Test 5: Empty HashMap iteration
    val empty = HashMap::new();
    var empty_count = 0;
    for k in empty {
        empty_count = empty_count + 1;
    }
    print("empty_count = ");
    print(empty_count);
    print("\n");

    // Test 6: Empty Vec iteration
    val empty_vec = Vec::new();
    var empty_vec_count = 0;
    for x in empty_vec {
        empty_vec_count = empty_vec_count + 1;
    }
    print("empty_vec_count = ");
    print(empty_vec_count);
    print("\n");

    // Test 7: Nested iteration
    val matrix = Vec::new();
    val row0 = Vec::new();
    row0.push(1);
    row0.push(2);
    val row1 = Vec::new();
    row1.push(3);
    row1.push(4);
    matrix.push(row0);
    matrix.push(row1);

    var grand_sum = 0;
    for row in matrix {
        for elem in row {
            grand_sum = grand_sum + elem;
        }
    }
    print("grand_sum = ");
    print(grand_sum);
    print("\n");

    print("OK\n");
}
