// expect-error: shape mismatch in binary operation.
// Test: vec3 + vec2 should fail with a shape error (not a generic type error).
// This is a compile-time error detection test — failing is the correct behavior.

use math;

fn main() {
    val a = vec3(1.0, 2.0, 3.0);
    val b = vec2(4.0, 5.0);
    val c = a + b;  // Shape error: vec3 + vec2
    print(c.x);
    return 0;
}
