// CL8: f-string interpolation of the values it can show (text, numbers,
// bools, a struct's fields, a call), each checked at compile time.
// Expected output:
// p = (1, 2)
// name=ada len=3 ok=true
// sum 7

struct Point {
    x: i64,
    y: i64,
}

fn add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn main() -> i64 {
    val p = Point { x: 1, y: 2 };
    println(f"p = ({p.x}, {p.y})");
    val name: str = "ada";
    val ok: bool = str_len(name) == 3;
    println(f"name={name} len={str_len(name)} ok={ok}");
    println(f"sum {add(3, 4)}");
    return 0;
}
