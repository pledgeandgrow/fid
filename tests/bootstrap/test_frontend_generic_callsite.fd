// CE9: calls whose chosen types have the fields the generic body reads
// are accepted, directly and through another generic function.
// Expected output:
// 4
// 3
// 9

struct Pt {
    x: i64,
    y: i64,
}

struct Wide {
    w: i64,
    x: i64,
}

fn first_x<T>(v: T) -> i64 {
    return v.x;
}

fn outer_x<V>(v: V) -> i64 {
    return first_x(v);
}

fn main() -> i64 {
    println(first_x(Pt { x: 4, y: 5 }));
    println(outer_x(Wide { w: 1, x: 3 }));
    println(first_x(Pt { x: 4, y: 5 }) + outer_x(Pt { x: 5, y: 0 }));
    return 0;
}
