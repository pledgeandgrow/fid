// Random bytes come from the OS: in range, and not all the same.
use crypto;

fn main() -> i64 {
    val bytes: Vec<i64> = crypto_random_bytes(256);
    var in_range: bool = true;
    var distinct: i64 = 0;
    var seen: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 256 { seen.push(0); i = i + 1; }
    i = 0;
    while i < bytes.len() {
        val b: i64 = bytes.get(i);
        if b < 0 || b > 255 { in_range = false; }
        if in_range && seen.get(b) == 0 { seen.set(b, 1); distinct = distinct + 1; }
        i = i + 1;
    }
    println(bytes.len());
    println(in_range);
    // 256 uniform bytes take over 100 distinct values with near certainty
    println(distinct > 100);
    println(crypto_random_u64() != crypto_random_u64());
    return 0;
}
