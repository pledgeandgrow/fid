// expect-error: is @no-alloc but uses an f-string or string `+`
// Bugs roadmap BG130: an f-string that interpolates builds a new string: a
// @no-alloc function returning `f"value {n}"` was accepted.
@no-alloc
fn na(n: i64) -> str {
    return f"value {n}";
}
fn main() -> i64 { println(na(3)); return 0; }
