// fid lint: unwrap() outside tests is flagged (CE2). The program itself runs
// on every backend; `fid lint` on it warns about 'first_or_panic'.
fn first(xs: Vec<i64>) -> Option<i64> {
    if xs.len() == 0 { return Option::None; }
    return Option::Some(xs.get(0));
}

fn first_or_panic(xs: Vec<i64>) -> i64 {
    return first(xs).unwrap();
}

fn first_or_zero(xs: Vec<i64>) -> i64 {
    return first(xs).unwrap_or(0);
}

fn main() -> i64 {
    var xs: Vec<i64> = Vec::new();
    println(first_or_zero(xs));
    xs.push(9);
    println(first_or_panic(xs));
    return 0;
}
