// Driver goal RL20 (docs/roadmap/llvm-roadmap.md): the input of `fid
// reduce` in scripts/driver-goals-check.sh, which shrinks it while a
// predicate still fails: `fid run` must still print KEEP 42. Everything
// else (the helpers, the loop, the other prints) can go, so the reduced
// file is a few lines: main, the print of KEEP and its return. On any
// backend it is an ordinary program.
// Expected output:
// start
// 10
// 6
// KEEP 42
// end

fn helper_a(x: i64) -> i64 {
    return x * 2;
}

fn helper_b(x: i64) -> i64 {
    var t: i64 = x;
    while t > 10 {
        t = t - 10;
    }
    return t;
}

fn main() -> i64 {
    println("start");
    var a: i64 = helper_a(5);
    println(a);
    var b: i64 = helper_b(26);
    println(b);
    var unused: Vec<i64> = Vec::new();
    unused.push(1);
    unused.push(2);
    println("KEEP 42");
    println("end");
    return 0;
}
