// expect-error: no operator `-` on struct 'P': it has no method `sub`
// CL10 (fid): an operator on a struct without its method is an error that
// names the method to write.

struct P {
    x: i64,
}

impl P {
    fn add(self: P, o: P) -> P {
        return P { x: self.x + o.x };
    }
}

fn main() -> i64 {
    val a: P = P { x: 1 };
    val b: P = a - a;
    println(b.x);
    return 0;
}
