// BG258 (docs/roadmap/bugs-roadmap.md): an assignment to a match-pattern
// binding changes it for the rest of the arm (it was dropped: the binding
// had no slot, and every read saw the payload again).
//
// Expected output:
// 6
// 7
// 13
// 30
// 9

enum E {
    A(i64),
    B,
}

fn val_form(o: Option<i64>) -> i64 {
    val r: i64 = match o {
        Option::Some(x) => {
            x = x * 10;
            x
        }
        Option::None => {
            0
        }
    };
    return r;
}

fn main() -> i64 {
    val e = E::A(3);
    match e {
        E::A(x) => {
            x = x * 2;
            println(x);
            x += 1;
            println(x);
        }
        E::B => {
        }
    }
    val o: Option<i64> = Option::Some(4);
    match o {
        Option::Some(y) => {
            y = y * 3 + 1;
            println(y);
        }
        Option::None => {
        }
    }
    println(val_form(Option::Some(3)));
    val f: Option<f64> = Option::Some(4.5);
    match f {
        Option::Some(z) => {
            z = z * 2.0;
            println(z);
        }
        Option::None => {
        }
    }
    return 0;
}
