// Earlier miscompile "AGENTS 13": the first stack slot of a function
// overlapped the stack canary, and float conversion used the same scratch
// word. A function whose first local is live across int <-> float
// conversions must keep it.
//
// Expected output:
// 1234
// 7.5
// 14
// 1234

fn mix(n: i64) -> i64 {
    var first: i64 = n;
    var f: f64 = (n as f64) / 4.0;
    var g: f64 = f * 2.0 + 0.5;
    var back: i64 = (g / 1000.0) as i64;
    var h: f64 = 7.5;
    println(int_to_str(first));
    println(float_to_str(h));
    var k: i64 = (h * 2.0) as i64;
    println(int_to_str(k + back - 1));
    return first;
}

fn main() -> i64 {
    println(int_to_str(mix(1234)));
    return 0;
}
