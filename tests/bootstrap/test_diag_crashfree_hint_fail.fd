// expect-error: function 'nth' calls `.get()`, which panics when the index is out of bounds (or the Vec is empty); index with `i` from `for i in 0..v.len()` (known in bounds)
// Expected to FAIL (known-bugs 2g.64): v.get(i) may panic in a @crashfree
// function. The hint names a form @crashfree accepts; it suggested
// `.get_or(i, default)`, which Vec does not have.
@crashfree
fn nth(v: Vec<i64>, i: i64) -> i64 {
    return v.get(i);
}

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    println(nth(v, 0));
}
