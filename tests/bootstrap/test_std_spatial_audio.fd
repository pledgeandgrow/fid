// stdlib/spatial_audio: distance models, azimuth and equal-power pan, Doppler, Woodworth ITD, head shadow, rendering a clip
// Expected output:
// model 0: 1.0000 1.0000 0.5000 0.1000 0.0100
// model 1: 1.0000 1.0000 0.9899 0.9091 0.0000
// model 2: 1.0000 1.0000 0.5000 0.1000 0.0100
// inverse rolloff 2 at 3 m: 0.2000
// exponential rolloff 0.5 at 4 m: 0.5000
// atan2 checks: 0.785398 -2.356194 2.896614 3.700000
// azimuth ahead 0.0 right 90.0 left-back -135.0
// elevation above 45.0 gain right 0.2500
// pan centre 0.7071/0.7071 right 0.0000/1.0000 half left 0.9239/0.3827 power 1.0000
// channel params left-back volume 0.2357 pan -0.7071
// doppler approaching 1.1111
// doppler leaving 0.9091
// doppler listener moving in 1.1000 factor 0 1.0000
// itd 90 deg 655.2 us, 30 deg 260.9 us, lateral right 90.0
// alpha 0 2.000 90 0.756 150 0.100 180 0.281
// near ear gain dc 1.000 1k 1.474 10k 1.992
// far ear gain dc 1.000 1k 0.783 10k 0.145
// binaural right louder than left: yes
// ear delays: left 31.45 right 0.00 samples
// left lags right by 40 samples at 500 Hz
// stereo left 0.5000 right 0.0000 playing yes
// after the clip: playing no frame 30 left 0.5000 frame 34 left 0.0000
// cursor after 100 frames 111.111
use spatial_audio;
use math;

// x rounded to d decimals ("-" only when the rounded value is not zero)
fn fx(x: f64, d: i64) -> str {
    var scale: i64 = 1;
    var i: i64 = 0;
    while i < d {
        scale = scale * 10;
        i = i + 1;
    }
    var neg: bool = x < 0.0;
    var a: f64 = x;
    if neg { a = 0.0 - x; }
    val n: i64 = (a * (scale as f64) + 0.5) as i64;
    if n == 0 { neg = false; }
    var s: str = int_to_str(n / scale);
    if d > 0 {
        var fr: str = int_to_str(n % scale);
        while str_len(fr) < d { fr = "0" + fr; }
        s = s + "." + fr;
    }
    if neg { return "-" + s; }
    return s;
}

fn main() {
    // distance models at 0.5, 1, 2, 10, 200 m (ref 1, max 100, rolloff 1)
    var m: i64 = 0;
    while m < 3 {
        var s: str = "model " + int_to_str(m) + ":";
        s = s + " " + fx(spatial_attenuation(m, 0.5, 1.0, 100.0, 1.0), 4);
        s = s + " " + fx(spatial_attenuation(m, 1.0, 1.0, 100.0, 1.0), 4);
        s = s + " " + fx(spatial_attenuation(m, 2.0, 1.0, 100.0, 1.0), 4);
        s = s + " " + fx(spatial_attenuation(m, 10.0, 1.0, 100.0, 1.0), 4);
        s = s + " " + fx(spatial_attenuation(m, 200.0, 1.0, 100.0, 1.0), 4);
        println(s);
        m = m + 1;
    }
    println("inverse rolloff 2 at 3 m: " + fx(spatial_attenuation(SPATIAL_INVERSE, 3.0, 1.0, 100.0, 2.0), 4));
    println("exponential rolloff 0.5 at 4 m: " + fx(spatial_attenuation(SPATIAL_EXPONENTIAL, 4.0, 1.0, 100.0, 0.5), 4));

    println("atan2 checks: " + fx(spatial_atan2(1.0, 1.0), 6) + " " + fx(spatial_atan2(-1.0, -1.0), 6) + " " + fx(spatial_atan2(0.5, -2.0), 6) + " " + fx(math_sin(spatial_atan(3.7)) / math_cos(spatial_atan(3.7)), 6));

    // directions around a listener looking along -z
    val lis: SpatialListener = spatial_listener(vec3(0.0, 0.0, 0.0));
    val ahead: SpatialEmitter = spatial_emitter(vec3(0.0, 0.0, -5.0));
    val right: SpatialEmitter = spatial_emitter(vec3(4.0, 0.0, 0.0));
    val left_back: SpatialEmitter = spatial_emitter(vec3(-3.0, 0.0, 3.0));
    val above: SpatialEmitter = spatial_emitter(vec3(0.0, 2.0, -2.0));
    val k: f64 = 180.0 / math_pi();
    println("azimuth ahead " + fx(spatial_azimuth(&lis, &ahead) * k, 1) + " right " + fx(spatial_azimuth(&lis, &right) * k, 1) + " left-back " + fx(spatial_azimuth(&lis, &left_back) * k, 1));
    println("elevation above " + fx(spatial_elevation(&lis, &above) * k, 1) + " gain right " + fx(spatial_gain(&lis, &right), 4));
    val p0: SpatialGains = spatial_equal_power(0.0);
    val p1: SpatialGains = spatial_equal_power(spatial_pan(&lis, &right));
    val p2: SpatialGains = spatial_equal_power(-0.5);
    println("pan centre " + fx(p0.left, 4) + "/" + fx(p0.right, 4) + " right " + fx(p1.left, 4) + "/" + fx(p1.right, 4) + " half left " + fx(p2.left, 4) + "/" + fx(p2.right, 4) + " power " + fx(p2.left * p2.left + p2.right * p2.right, 4));
    val cp: SpatialChannel = spatial_channel_params(&lis, &left_back);
    println("channel params left-back volume " + fx(cp.volume, 4) + " pan " + fx(cp.pan, 4));

    // Doppler: source coming at a tenth of the speed of sound, then leaving
    var car: SpatialEmitter = spatial_emitter(vec3(0.0, 0.0, -50.0));
    car.vel = vec3(0.0, 0.0, 34.33);
    println("doppler approaching " + fx(spatial_doppler(&lis, &car, 1.0, SPATIAL_SPEED_OF_SOUND), 4));
    car.vel = vec3(0.0, 0.0, -34.33);
    println("doppler leaving " + fx(spatial_doppler(&lis, &car, 1.0, SPATIAL_SPEED_OF_SOUND), 4));
    var runner: SpatialListener = spatial_listener(vec3(0.0, 0.0, 0.0));
    runner.vel = vec3(0.0, 0.0, -34.33);
    car.vel = vec3(0.0, 0.0, 0.0);
    println("doppler listener moving in " + fx(spatial_doppler(&runner, &car, 1.0, SPATIAL_SPEED_OF_SOUND), 4) + " factor 0 " + fx(spatial_doppler(&runner, &car, 0.0, SPATIAL_SPEED_OF_SOUND), 4));

    // binaural: ITD and head shadow
    println("itd 90 deg " + fx(spatial_itd(math_pi() / 2.0) * 1000000.0, 1) + " us, 30 deg " + fx(spatial_itd(math_pi() / 6.0) * 1000000.0, 1) + " us, lateral right " + fx(spatial_lateral(&lis, &right) * k, 1));
    println("alpha 0 " + fx(spatial_shadow_alpha(0.0), 3) + " 90 " + fx(spatial_shadow_alpha(math_pi() / 2.0), 3) + " 150 " + fx(spatial_shadow_alpha(150.0 / k), 3) + " 180 " + fx(spatial_shadow_alpha(math_pi()), 3));
    var near: SpatialShadow = spatial_shadow();
    var far: SpatialShadow = spatial_shadow();
    spatial_shadow_set(&mut near, 2.0, 48000.0);
    spatial_shadow_set(&mut far, 0.1, 48000.0);
    println("near ear gain dc " + fx(spatial_shadow_gain(&near, 0.0, 48000.0), 3) + " 1k " + fx(spatial_shadow_gain(&near, 1000.0, 48000.0), 3) + " 10k " + fx(spatial_shadow_gain(&near, 10000.0, 48000.0), 3));
    println("far ear gain dc " + fx(spatial_shadow_gain(&far, 0.0, 48000.0), 3) + " 1k " + fx(spatial_shadow_gain(&far, 1000.0, 48000.0), 3) + " 10k " + fx(spatial_shadow_gain(&far, 10000.0, 48000.0), 3));

    // render a 500 Hz tone from the right, binaural: right louder, left late
    var clip: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < 800 {
        clip.push(math_sin(2.0 * math_pi() * 500.0 * (i as f64) / 48000.0));
        i = i + 1;
    }
    var em: SpatialEmitter = spatial_emitter(vec3(2.0, 0.0, 0.0));
    var voice: SpatialVoice = spatial_voice(SPATIAL_BINAURAL);
    var bus: Vec<f64> = Vec::new();
    spatial_render(&mut voice, &lis, &em, &clip, &mut bus, 256, 48000.0);
    var el: f64 = 0.0;
    var er: f64 = 0.0;
    i = 100;
    while i < 256 {
        el = el + bus.get(2 * i) * bus.get(2 * i);
        er = er + bus.get(2 * i + 1) * bus.get(2 * i + 1);
        i = i + 1;
    }
    println("binaural right louder than left: " + if er > el * 1.5 { "yes" } else { "no" });
    println("ear delays: left " + fx(voice.delay_l, 2) + " right " + fx(voice.delay_r, 2) + " samples");
    // the lag where left best matches right: the ITD (31.5 samples) plus the
    // low-frequency phase delay the head-shadow filters add (Brown-Duda)
    var best: i64 = 0;
    var best_c: f64 = -1000.0;
    var lag: i64 = 20;
    while lag < 44 {
        var c: f64 = 0.0;
        i = 60;
        while i < 200 {
            c = c + bus.get(2 * (i + lag)) * bus.get(2 * i + 1);
            i = i + 1;
        }
        if c > best_c { best_c = c; best = lag; }
        lag = lag + 1;
    }
    println("left lags right by " + int_to_str(best) + " samples at 500 Hz");

    // stereo mode, a source to the left at 2 m: gain 0.5, left only
    var em2: SpatialEmitter = spatial_emitter(vec3(-2.0, 0.0, 0.0));
    var v2: SpatialVoice = spatial_voice(SPATIAL_STEREO);
    var bus2: Vec<f64> = Vec::new();
    var flat: Vec<f64> = Vec::new();
    i = 0;
    while i < 64 { flat.push(1.0); i = i + 1; }
    val more: bool = spatial_render(&mut v2, &lis, &em2, &flat, &mut bus2, 32, 48000.0);
    println("stereo left " + fx(bus2.get(20), 4) + " right " + fx(bus2.get(21), 4) + " playing " + if more { "yes" } else { "no" });
    var bus3: Vec<f64> = Vec::new();
    val more2: bool = spatial_render(&mut v2, &lis, &em2, &flat, &mut bus3, 40, 48000.0);
    println("after the clip: playing " + if more2 { "yes" } else { "no" } + " frame 30 left " + fx(bus3.get(60), 4) + " frame 34 left " + fx(bus3.get(68), 4));

    // Doppler in rendering: an approaching source reads the clip faster
    var em3: SpatialEmitter = spatial_emitter(vec3(0.0, 0.0, -10.0));
    em3.vel = vec3(0.0, 0.0, 34.33);
    var v3: SpatialVoice = spatial_voice(SPATIAL_STEREO);
    var bus4: Vec<f64> = Vec::new();
    spatial_render(&mut v3, &lis, &em3, &clip, &mut bus4, 100, 48000.0);
    println("cursor after 100 frames " + fx(v3.cursor, 3));
}
