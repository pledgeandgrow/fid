// Test user-defined functions
fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

fn factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

fn main() {
    val result = add(3, 4);
    print(result);

    val fact5 = factorial(5);
    print(fact5);
}
