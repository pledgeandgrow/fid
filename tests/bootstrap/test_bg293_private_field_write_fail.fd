// expect-error: field 'y' of struct 'Pt' is private
// Bugs roadmap BG293: a private field of another module's struct cannot be
// written (reference §2.2), as it cannot be read; before, `p.y = 99`
// compiled and shown() then printed 109.
use vis_lib::vmod;

fn main() -> i64 {
    var p = mk();
    p.y = 99;
    println(p.shown());
    return 0;
}
