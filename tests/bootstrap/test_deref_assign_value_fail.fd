// expect-error: cannot assign str to '*r' of type i64
// Bugs roadmap BG2: the value of `*r = v` was not checked against what r
// refers to: `*r = "text"` through r: &mut i64 stored a string's address in
// the caller's integer. It must fit the pointee type.

fn set(r: &mut i64) {
    *r = "text";
}

fn main() -> i64 {
    var n: i64 = 1;
    set(&mut n);
    println(int_to_str(n));
    return 0;
}
