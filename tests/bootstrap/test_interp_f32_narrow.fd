// `fid run` kept an f64 literal passed to an f32 parameter, or returned
// from an f32 function, as the f64: `takes(0.1)` printed 0.1 on run but
// 0.10000000149011612 on C and emit (an f32 has no exact 0.1; the compiled
// backends are right). compiler/interp.fd rounds to the nearest single when
// it binds an f32 parameter and when an f32 function returns.
//
// Expected output:
// 0.10000000149011612
// 0.10000000149011612
// 0.20000000298023224
// 2.5

fn takes(x: f32) -> f64 {
    return x as f64;
}

fn gives() -> f32 {
    return 0.1;
}

fn twice(x: f32) -> f32 {
    return x + x;
}

fn main() -> i64 {
    println(takes(0.1));
    println(gives() as f64);
    println(twice(0.1) as f64);
    println(takes(2.5));
    return 0;
}
