// Bugs roadmap BG291: a `for` variable, a closure parameter and a match
// binding that shadow an outer `val` are assignable, as they are with no
// outer `val`; before, each assignment was E044 "cannot assign to 'x': it
// is declared with `val`".
//
// Expected output:
// 10 11 12
// 5
// 8
// 1
fn main() -> i64 {
    val x = 1;
    var out = "";
    for x in 0..3 {
        x = x + 10;
        out = out + f"{x} ";
    }
    println(str_trim(out));
    val f = fn(x: i64) -> i64 {
        x = x + 1;
        return x;
    };
    println(f(4));
    val o: Option<i64> = Option::Some(7);
    match o {
        Option::Some(x) => {
            val y = x + 1;
            x = y;
            println(y);
        }
        Option::None => {
        }
    }
    println(x);
    return 0;
}
