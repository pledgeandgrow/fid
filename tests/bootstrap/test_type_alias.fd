// Test type aliases — `type X = T;`
type Int = i64;
type Float = f64;
type Str = str;

struct Pair { first: i64, second: i64, }
type PairAlias = Pair;

fn main() -> i64 {
    // Basic alias to primitive
    val x: Int = 42;
    print(x);

    // Alias to float
    val y: Float = 3.14;
    print(y);

    // Alias to string
    val s: Str = "hello";
    print(s);

    // Alias to struct type
    val p = PairAlias { first: 10, second: 20, };
    print(p.first + p.second);

    // Alias in function return type
    val result = add(5, 3);
    print(result);

    return 0;
}

fn add(a: Int, b: Int) -> Int {
    return a + b;
}
