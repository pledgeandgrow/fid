// Bare builds have defined integer semantics (release G3): arithmetic is
// checked as on every other backend, and a failed check, like any panic,
// calls the program's @panic_handler with the message, then the CPU halts.
// Without a handler the message goes to COM1 as "panic: <message>".
// `@wrapping` functions wrap, as elsewhere. Bare-only (a hosted build
// panics instead):
//   fid emit tests/bootstrap/test_bare_panic_handler.fd --bare -o p.bin
//   ./bare-run p.bin          (scripts/bare-run.c, Linux x86-64)
//
// Expected output:
// wrapped: -9223372036854775808
// before
// handler: Integer overflow on addition

@panic_handler fn on_panic(msg: str) {
    print("handler: ");
    print(msg);
    print("\n");
}

fn one() -> i64 { return 1; }

@wrapping fn wrap_add(a: i64, b: i64) -> i64 {
    return a + b;
}

fn main() -> i64 {
    var big: i64 = 9223372036854775807;
    print("wrapped: ");
    print(wrap_add(big, one())); print("\n");
    print("before"); print("\n");
    big = big + one();
    print("not reached"); print("\n");
    return 0;
}
