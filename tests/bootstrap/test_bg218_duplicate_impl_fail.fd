// expect-error: is defined twice in this program
// BG218 (docs/roadmap/bugs-roadmap.md): two `impl Show for P` in one file
// were accepted and the later one won silently.
cap Show {
    fn show(self) -> str;
}

struct P {
    v: i64,
}

impl Show for P {
    fn show(self) -> str {
        return "first";
    }
}

impl Show for P {
    fn show(self) -> str {
        return "second";
    }
}

fn main() -> i64 {
    val p = P { v: 1 };
    println(p.show());
    return 0;
}
