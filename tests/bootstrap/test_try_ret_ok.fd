// known-bugs 2g.55: where `e?` stays allowed once a function returning
// neither Option nor Result rejects it: a function returning Option or
// Result (also through a type alias), and a `try { }` block inside any
// function.
//
// Expected output:
// 6
// none
// ok 30
// err bad
// alias 12
// try 50
// try err 42
use core;

type Parsed = Result<i64, str>;

fn get(k: i64) -> Option<i64> {
    if k > 0 {
        return Option::Some(k);
    }
    return Option::None;
}

fn plus_one(k: i64) -> Option<i64> {
    val v = get(k)?;
    return Option::Some(v + 1);
}

fn check(k: i64) -> Result<i64, str> {
    if k < 0 {
        return Result::Err("bad");
    }
    return Result::Ok(k * 10);
}

fn twice(k: i64) -> Result<i64, str> {
    val v = check(k)?;
    return Result::Ok(v);
}

fn via_alias(k: i64) -> Parsed {
    val v = check(k)?;
    return Result::Ok(v + 2);
}

fn risky(x: i64) -> Result<i64, i64> {
    if x == 0 {
        return Result::Err(42);
    }
    return Result::Ok(x * 10);
}

fn main() -> i64 {
    match plus_one(5) {
        Option::Some(v) => { println(v); }
        Option::None => { println("none"); }
    }
    match plus_one(0) {
        Option::Some(v) => { println(v); }
        Option::None => { println("none"); }
    }
    match twice(3) {
        Result::Ok(v) => { println("ok " + int_to_str(v)); }
        Result::Err(e) => { println("err " + e); }
    }
    match twice(-1) {
        Result::Ok(v) => { println("ok " + int_to_str(v)); }
        Result::Err(e) => { println("err " + e); }
    }
    match via_alias(1) {
        Result::Ok(v) => { println("alias " + int_to_str(v)); }
        Result::Err(e) => { println("alias err " + e); }
    }
    // a try block in a function returning i64
    val r1 = try { risky(5)? };
    match r1 {
        Result::Ok(v) => { println("try " + int_to_str(v)); }
        Result::Err(e) => { println("try err " + int_to_str(e)); }
    }
    val r2 = try { risky(0)? };
    match r2 {
        Result::Ok(v) => { println("try " + int_to_str(v)); }
        Result::Err(e) => { println("try err " + int_to_str(e)); }
    }
    return 0;
}
