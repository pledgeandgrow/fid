// expect-error: Vec.map (stdlib/vec.fd) carries each element as an integer word, so it cannot take a Vec<f64>
// Expected to FAIL (known-bugs 2g.66): stdlib/vec.fd's map calls its
// function as fn(i64) -> i64, so an f64 element (passed in a float
// register) would reach the function as garbage.
use vec;

fn half(x: f64) -> f64 {
    return x / 2.0;
}

fn main() {
    var xs: Vec<f64> = Vec::new();
    xs.push(3.0);
    var hs: Vec<f64> = xs.map(half);
    println(int_to_str(hs.len()));
}
