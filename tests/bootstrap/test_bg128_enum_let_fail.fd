// expect-error: Option::Some field 1 expects 'str'
// Bugs roadmap BG128: `val o: Option<str> = Option::Some(5)` was accepted
// (the payload against the declared type's argument) and panicked "a str
// without a string header".
fn main() -> i64 {
    val o: Option<str> = Option::Some(5);
    match o { Option::Some(s) => { println(s); } Option::None => { } }
    return 0;
}
