// Test: Double-credit bug — COBOL allows this, Fides rejects at compile time.
//
// THE BUG: A programmer accidentally deposits the same money twice.
// In COBOL, this is a runtime error (if caught at all). In Fides, the
// linear type system catches it at compile time — Money can only be
// used once.
//
// Real-world example: Knight Capital lost $440 million in 45 minutes
// when a deployment bug caused their trading system to double-process
// orders. This kind of bug is impossible in Fides — the compiler
// rejects it before the program runs.

use banking;
use money;

fn main() -> i64 {
    val acc = Account_open(1, 100000);

    // Create a deposit of $500.00
    val deposit = Money_new(50000);

    // Deposit it into the account (consumes deposit)
    val acc_after = Account_deposit(acc, deposit);

    // BUG: Try to deposit the same money again.
    // In COBOL: this would silently double-credit the account.
    // In Fides: compile error — 'deposit' was already consumed.
    val acc_double = Account_deposit(acc_after, deposit);

    val balance = Account_balance_cents(acc_double);
    print(balance);
    return 0;
}
