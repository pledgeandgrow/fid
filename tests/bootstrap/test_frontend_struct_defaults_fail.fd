// expect-error: leaves out field 'host', which has no default
// CL5: a literal ending in `..` may leave out only fields that have a
// default; `host` has none.

struct Config {
    host: str,
    port: i64 = 8080,
}

fn main() -> i64 {
    val c = Config { .. };
    println(c.port);
    return 0;
}
