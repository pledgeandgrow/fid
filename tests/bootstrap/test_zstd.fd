    show("multi", multi, 0);
    // Huffman weights stored directly
    val direct: Vec<i64> = bytes("40,181,47,253,96,94,0,53,6,0,230,149,48,142,17,17,17,17,17,17,17,16,45,0,45,0,45,0,2,87,187,17,29,118,72,115,24,49,6,42,251,150,157,249,88,122,239,235,190,143,127,206,229,187,219,94,75,165,5,119,85,205,234,11,129,190,220,21,134,89,43,18,1,233,14,54,87,48,115,50,213,28,4,216,184,39,40,126,23,231,83,69,129,65,208,136,74,250,76,14,163,114,79,140,225,9,175,57,11,65,23,12,85,132,11,1,50,1,33,210,84,43,35,141,95,199,249,253,143,75,190,249,241,48,198,42,51,56,188,228,188,99,127,146,11,9,98,254,29,14,150,51,13,185,185,3,251,83,29,208,109,198,1,21,132,92,43,224,232,250,242,176,98,94,248,13,244,134,198,99,108,12,83,238,10,204,118,162,251,141,140,31,92,12,238,180,124,94,133,167,211,52,89,174,199,73,1,0");
    show("direct", direct, 0);
    // a raw block (40 random bytes)
    val rawblk: Vec<i64> = bytes("40,181,47,253,32,40,65,1,0,68,32,130,60,253,230,241,194,107,48,249,14,199,221,1,228,136,117,52,162,15,11,13,4,195,110,216,14,113,224,253,119,176,118,112,235,148,11,213,51");
