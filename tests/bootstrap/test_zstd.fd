    show("m19ck", m19ck, 0);
    // 4000 bytes of text, level 19, no checksum: repeat offsets
    val long: Vec<i64> = bytes("40,181,47,253,96,160,14,109,21,0,114,133,16,18,160,187,1,32,146,196,50,109,107,145,108,246,171,222,93,253,223,65,255,255,255,255,91,121,87,177,142,2,82,162,221,70,78,50,237,114,156,26,169,56,68,169,172,25,141,80,39,92,79,200,70,34,58,17,42,74,182,168,34,105,91,202,56,154,95,129,88,168,161,47,74,246,218,12,33,8,1,131,145,168,244,210,7,17,32,4,20,145,24,34,224,2,86,65,154,166,208,1,242,28,240,66,82,103,185,25,233,223,62,191,78,70,206,36,160,156,66,178,49,237,164,239,10,169,241,217,91,163,119,182,188,173,115,116,16,8,71,51,51,81,201,94,169,135,172,44,12,138,95,103,240,134,203,114,41,72,247,7,93,23,245,122,88,245,75,9,217,45,109,232,64,80,209,86,225,113,9,39,61,111,23,220,112,172,5,71,106,198,93,55,186,24,179,115,52,254,179,247,187,255,144,249,99,187,22,35,229,185,155,62,245,132,108,209,118,141,149,119,154,65,1,216,110,115,123,133,29,24,249,234,159,118,157,31,145,176,245,152,81,89,39,171,16,38,19,243,4,117,70,86,120,128,45,50,152,184,43,89,56,8,181,220,251,163,81,99,18,247,147,145,176,136,185,227,206,97,29,196,83,146,126,146,175,251,210,222,205,131,254,199,83,119,195,100,229,28,238,162,107,101,40,59,71,27,149,154,183,205,117,232,57,19,204,215,196,133,164,208,117,107,86,221,214,14,207,225,56,79,100,22,233,95,56,131,105,102,111,95,101,170,7,226,221,67,39,26,174,164,186,193,91,24,54,7,62,222,171,67,150,152,238,24,195,22,140,68,223,58,196,211,84,73,151,45,47,20,204,9,142,163,7,202,24,182,62,36,1,123,138,238,182,4,233,185,207,192,175,143,32,33,130,98,197,188,48,67,105,69,11,178,8,82,242,251,138,181,111,139,109,104,78,192,214,196,80,22,38,21,8,177,101,131,87,10,19,142,121,5,6,166,118,231,132,138,29,94,70,150,130,36,126,121,36,110,139,13,244,79,96,163,108,173,45,163,16,227,155,94,110,241,224,231,52,170,117,78,231,110,120,154,234,229,254,139,13,210,47,122,117,130,136,137,238,35,226,252,239,179,211,57,197,181,248,191,248,74,167,184,178,97,20,246,60,89,8,160,68,248,58,69,160,6,35,170,4,63,90,162,145,98,188,96,147,56,206,241,89,146,144,103,129,178,3