// stdlib/zstd (competitive SL10): decoding Zstandard streams (RFC 8878)
// made by another implementation (Python 3.14's compression.zstd, levels
// 1, 3 and 19): raw, RLE and compressed blocks; raw, RLE, Huffman (FSE or
// direct weights, 1 or 4 streams) and treeless literals; predefined, RLE,
// FSE and repeat sequence tables; repeat offsets; a 1 KB window over
// several blocks; the content checksum; two frames; a skippable frame; an
// empty frame; and corrupted streams, which give the error result.
// Inputs are kept small: `fid run` takes about two and a half minutes.
//
// Expected output:
// short: ok 35 bytes, crc32 2146050500
// Hello, Zstandard! Hello, Zstandard!
// m1: ok 1199 bytes, crc32 2670791882
// m3: ok 1199 bytes, crc32 2670791882
// m19ck: ok 1199 bytes, crc32 2670791882
// long: ok 4000 bytes, crc32 458487204
// able Fides sequence literal match huffma
// multi: ok 2250 bytes, crc32 1294701652
// direct: ok 350 bytes, crc32 3791839369
// rawblk: ok 40 bytes, crc32 3116645007
// rleblk: ok 2500 bytes, crc32 1416777192
// rlelit: ok 10 bytes, crc32 870007992
// zzzzzzzzzz
// two: ok 81 bytes, crc32 452012397
// first frame, first frame, first frame. second frame: second, second, second frame
// skipped: ok 23 bytes, crc32 3017822107
// after a skippable frame
// empty: ok 0 bytes, crc32 0
// flipped byte: error (sequence uses more literals than decoded)
// bad checksum: error (content checksum mismatch)
// truncated: error (truncated compressed block)
// bad magic: error (bad magic number)
// garbage after a frame: error (bad magic number)
// dictionary: error (dictionaries are not supported)
// empty input: error (empty input)
// zstd_ok: empty frame true, bad magic false, empty input false
// zstd_decompress of bad magic: 0 bytes
// zstd_decompress_str: Hello, Zstandard! Hello, Zstandard!
// zstd_error of an empty frame: ""

use zstd;
use compress;
use vec;
use string;

fn bytes(csv_list: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var parts: Vec<str> = str_split(csv_list, ",");
    var i: i64 = 0;
    while i < parts.len() {
        out.push(str_parse_int(parts.get(i)));
        i = i + 1;
    }
    return out;
}

// mode 0: length and crc32; 1: also the text; 2: also 40 bytes from 1000.
fn show(name: str, data: Vec<i64>, mode: i64) -> void {
    val r: ZstdResult = zstd_decode(data);
    if !r.ok {
        println(name + ": error " + r.error);
        return;
    }
    print(name + ": ok ");
    print(r.bytes.len());
    print(" bytes, crc32 ");
    print(crc32_bytes(r.bytes));
    println("");
    if mode == 1 { println(str_from_bytes(r.bytes)); }
    if mode == 2 {
        var part: Vec<i64> = Vec::new();
        var i: i64 = 1000;
        while i < 1040 { part.push(r.bytes.get(i)); i = i + 1; }
        println(str_from_bytes(part));
    }
}

fn bad(name: str, data: Vec<i64>) -> void {
    val r: ZstdResult = zstd_decode(data);
    if r.ok { println(name + ": decoded, which it should not"); }
    else { println(name + ": error (" + r.error + ")"); }
}

fn yes(b: bool) -> str {
    if b { return "true"; }
    return "false";
}

fn main() -> i64 {
