    val rlelit: Vec<i64> = bytes("40,181,47,253,32,10,29,0,0,81,122,0");
    show("rlelit", rlelit, 1);
    // two frames, the second with a checksum
    val two: Vec<i64> = bytes("40,181,47,253,32,39,173,0,0,120,102,105,114,115,116,32,102,114,97,109,101,44,32,46,32,1,0,0,206,47,40,181,47,253,36,42,245,0,0,168,115,101,99,111,110,100,32,102,114,97,109,101,58,32,44,32,102,114,97,109,101,2,0,43,93,136,97,42,1,77,51,212,157");
    show("two", two, 1);
    // a skippable frame in front
    val skipped: Vec<i64> = bytes("83,42,77,24,5,0,0,0,1,2,3,4,5,40,181,47,253,32,23,185,0,0,97,102,116,101,114,32,97,32,115,107,105,112,112,97,98,108,101,32,102,114,97,109,101");
    show("skipped", skipped, 1);
    // a frame with empty content
    val empty: Vec<i64> = bytes("40,181,47,253,32,0,1,0,0");
    show("empty", empty, 0);

    // corrupted streams
    var flip: Vec<i64> = m19ck.clone();
    flip.set(150, flip.get(150) ^ 32);
    bad("flipped byte", flip);
    var ck: Vec<i64> = two.clone();
    ck.set(ck.len() - 1, ck.get(ck.len() - 1) ^ 1);
    bad("bad checksum", ck);
    var cut: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < m1.len() - 10 { cut.push(m1.get(i)); i = i + 1; }
    bad("truncated", cut);
    var magic: Vec<i64> = short.clone();
    magic.set(0, 41);
    bad("bad magic", magic);
    var trail: Vec<i64> = short.clone();
    trail.push(1); trail.push(2); trail.push(3); trail.push(4); trail.push(5);
    bad("garbage after a frame", trail);
    bad("dictionary", bytes("40,181,47,253,33,7,5,41,0,0,104,101,108,108,111"));
    bad("empty input", Vec::new());
    // the convenience functions
    println("zstd_ok: empty frame " + yes(zstd_ok(empty)) + ", bad magic " + yes(zstd_ok(magic))
        + ", empty input " + yes(zstd_ok(Vec::new())));
    print("zstd_decompress of bad magic: ");
    print(zstd_decompress(magic).len());
    println(" bytes");
    println("zstd_decompress_str: " + zstd_decompress_str(short));
    println("zstd_error of an empty frame: \"" + zstd_error(empty) + "\"");
    return 0;
}
