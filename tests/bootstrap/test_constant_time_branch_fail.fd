// expect-error: function 'ct_eq' branches on secret data (`if`).
// Expected to FAIL: an `if` on secret data takes a secret-dependent branch,
// even when both arms only assign.
@constant_time
fn ct_eq(a: i64, b: i64) -> i64 {
    var r: i64 = 0;
    if a == b { r = 1; } else { r = 0; }
    return r;
}
fn main() { print(ct_eq(5, 5)); }
