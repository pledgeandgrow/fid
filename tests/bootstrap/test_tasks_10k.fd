// Release H10: 10,000 concurrent tasks on a few threads. Every task sleeps
// first, so all of them are alive at once; natively they are green tasks on
// the M:N scheduler of stdlib/pe_runtime/conc.fd (one worker thread per
// core), not 10,000 OS threads.
//
// Expected output:
// spawned 10000
// sum 50005000
// done

use task;

async fn work(i: i64) -> Future<i64> {
    task_sleep(10);
    return i;
}

fn main() -> i64 {
    val n: i64 = 10000;
    var futures: Vec<Future<i64>> = Vec::new();
    var i: i64 = 1;
    while i <= n {
        futures.push(work(i));
        i = i + 1;
    }
    println("spawned " + int_to_str(futures.len()));
    var sum: i64 = 0;
    var j: i64 = 0;
    while j < futures.len() {
        sum = sum + await futures.get(j);
        j = j + 1;
    }
    println("sum " + int_to_str(sum));
    println("done");
    return 0;
}
