// Test (known-bugs 2g.69): user functions named like a type or a macro the
// C runtime's headers declare get C names of their own, as functions named
// like libc functions do (codegen_c.fd cg_libc_clash). On Windows,
// <windows.h> brings in rpcndr.h's `typedef unsigned char byte` and
// `boolean`, `#define small char` and `hyper`, and winnt.h / minwindef.h
// the upper-case types (BYTE, WORD, DWORD, BOOL, HANDLE): `fn byte` failed
// with 9 C errors. POSIX headers declare FILE, DIR and the fd_set family.
// Calls, a function value and a function passed on reach the user's
// functions.
//
// Expected output:
// byte 65
// boolean 1
// small 3
// hyper 2000000000000
// BYTE 255
// WORD 7
// DWORD 12
// BOOL 0
// HANDLE 41
// FILE 3
// DIR 5
// SOCKET 9
// value 66
// done

fn byte(s: str, i: i64) -> i64 {
    return str_byte_at(s, i);
}

fn boolean(x: i64) -> i64 {
    if x != 0 {
        return 1;
    }
    return 0;
}

fn small(a: i64, b: i64) -> i64 {
    if a < b {
        return a;
    }
    return b;
}

fn hyper(x: i64) -> i64 {
    return x * 1000000000000;
}

fn BYTE(x: i64) -> i64 {
    return x % 256;
}

fn WORD(a: i64, b: i64) -> i64 {
    return a + b;
}

fn DWORD(x: i64) -> i64 {
    return x * 4;
}

fn BOOL(x: i64) -> i64 {
    return boolean(x);
}

fn HANDLE(x: i64) -> i64 {
    return x + 1;
}

fn FILE(n: i64) -> i64 {
    return n;
}

fn DIR(n: i64) -> i64 {
    return n + 2;
}

fn SOCKET(n: i64) -> i64 {
    return n * n;
}

fn apply(f: fn(str, i64) -> i64, s: str, i: i64) -> i64 {
    return f(s, i);
}

fn main() -> i64 {
    println("byte " + int_to_str(byte("A", 0)));
    println("boolean " + int_to_str(boolean(7)));
    println("small " + int_to_str(small(3, 8)));
    println("hyper " + int_to_str(hyper(2)));
    println("BYTE " + int_to_str(BYTE(511)));
    println("WORD " + int_to_str(WORD(3, 4)));
    println("DWORD " + int_to_str(DWORD(3)));
    println("BOOL " + int_to_str(BOOL(0)));
    println("HANDLE " + int_to_str(HANDLE(40)));
    println("FILE " + int_to_str(FILE(3)));
    println("DIR " + int_to_str(DIR(3)));
    println("SOCKET " + int_to_str(SOCKET(3)));
    println("value " + int_to_str(apply(byte, "AB", 1)));
    println("done");
    return 0;
}
