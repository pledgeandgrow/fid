// expect-error: is @no-alloc but uses string `+=`, which allocates
// Bugs roadmap BG373: `s += t` on a str builds a new string as `s = s + t`
// does, yet a @no-alloc function using it was accepted (only the `+`
// expression was looked at).
@no-alloc
fn f(x: str, y: str) -> str {
    var s = x;
    s += y;
    return s;
}
fn main() -> i64 { println(f("q", "r")); return 0; }
