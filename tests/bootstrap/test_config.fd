// config (CO6): one declaration feeds file, env and flags — file values win
// over defaults here, required keys are enforced, dotted names read INI
// sections.
use config;
use file;
use env;

fn temp_root() -> str {
    var t: str = env_get("TEMP");
    if str_len(t) == 0 { t = env_get("TMP"); }
    if str_len(t) == 0 { t = env_get("TMPDIR"); }
    if str_len(t) == 0 { t = "."; }
    return t;
}

fn main() -> i64 {
    var path: str = temp_root() + "/fides_test_config.ini";
    file_write(path, "port = 9090\nname = fides\n[db]\nport = 5432\n");

    var c = config_new();
    config_opt(&mut c, "port", CONFIG_INT, "8080");
    config_opt(&mut c, "host", CONFIG_STR, "localhost");
    config_opt(&mut c, "db.port", CONFIG_INT, "0");
    config_req(&mut c, "name", CONFIG_STR);
    config_load(&mut c, path, "FTESTCFG_");

    println(config_int(c, "port"));      // 9090 — from the file
    println(config_str(c, "host"));      // localhost — default
    println(config_int(c, "db.port"));   // 5432 — [db] section
    println(config_str(c, "name"));      // fides — required, from file
    println(config_given(c, "port"));    // true — file supplied it
    println(config_given(c, "host"));    // false — just the default
    println("config OK");
    return 0;
}
