// L3G: Async I/O via effect handlers
// do IO.read(file) — yields to IO handler, handler does I/O, resumes with result
// do Net.accept(socket) — yields to Net handler, handler does accept, resumes with connection
// Built-in IO/Net handlers wrap existing builtins

fn main() {
    // IO handler — wraps p_fs_read/p_fs_write in effect handler semantics
    handle {
        // do IO.write("hello") — handler does the actual write
        do IO.write(42);
        println(1);
        // do IO.read() — handler reads and resumes with the value
        do IO.read(0);
        println(2);
    } with {
        IO.write(v) => {
            println(v);
            resume(cont, 0);
        },
        IO.read(v) => {
            // Handler does the actual I/O and resumes with the result
            // For this test, just resume with a constant
            resume(cont, 100);
        }
    }

    // Net handler — wraps p_net_accept in effect handler semantics
    handle {
        do Net.accept(0);
        println(3);
    } with {
        Net.accept(socket) => {
            // Handler does the actual accept and resumes with the connection
            // For this test, just resume with a constant
            resume(cont, 0);
        }
    }
    println(4);
}
