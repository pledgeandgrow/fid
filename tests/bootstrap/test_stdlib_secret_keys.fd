// Complaint CO1, adoption in the stdlib: the stdlib functions that take a
// key mark it `@secret` and release their result with `@declassify`
// (crypto_hmac_sha256_bytes, crypto_pbkdf2_sha256, chacha20poly_encrypt /
// _decrypt, x25519_public_key, ed25519_sign); env_secret and config_secret
// hand out a credential as a secret. A secret key flows into each of them
// and the released results print: the program is accepted. The rejected
// side is test_stdlib_secret_env_fail.fd and test_stdlib_secret_config_fail.fd.
//
// Expected output:
// hmac 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
// config hmac 5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843
// env hmac bytes 32
// pbkdf2 ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43
// aead sealed 19
// aead opened 3 97
// x25519 public 8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
// secret keys ok
use crypto;
use tls_crypto;
use x25519;
use encoding;
use config;
use env;

fn he(v: Vec<i64>) -> str {
    return crypto_sha256_hex(v);
}

fn main() -> i64 {
    // RFC 4231 test case 2, the key held in a @secret local
    @secret val key: str = "Jefe";
    val mac: Vec<i64> = crypto_hmac_sha256_bytes(str_bytes(key), str_bytes("what do ya want for nothing?"));
    println("hmac " + he(mac));

    // The same key from config: config_secret's result is secret
    var c: Config = config_new();
    config_opt(& mut c, "api_key", CONFIG_STR, "Jefe");
    config_load(& mut c, "", "FIDES_TEST_CO1_");
    val api: str = config_secret(c, "api_key");
    val mac2: Vec<i64> = crypto_hmac_sha256_bytes(str_bytes(api), str_bytes("what do ya want for nothing?"));
    println("config hmac " + he(mac2));

    // An unset variable is "", still secret; only the MAC's length prints
    val token: str = env_secret("FIDES_TEST_CO1_SURELY_UNSET");
    val mac3: Vec<i64> = crypto_hmac_sha256_bytes(str_bytes(token), str_bytes("x"));
    println("env hmac bytes " + int_to_str(mac3.len()));

    // RFC 7914 §11-style vector (c = 2), password secret
    @secret val pw: str = "password";
    println("pbkdf2 " + he(crypto_pbkdf2_sha256(str_bytes(pw), str_bytes("salt"), 2, 32)));

    // ChaCha20-Poly1305 under a secret key: the sealed bytes and the
    // opened plaintext are released by the AEAD functions
    @secret var k: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 32 {
        k.push(i);
        i = i + 1;
    }
    var nonce: Vec<i64> = Vec::new();
    i = 0;
    while i < 12 {
        nonce.push(7);
        i = i + 1;
    }
    val aad: Vec<i64> = Vec::new();
    val sealed: Vec = chacha20poly_encrypt(k, nonce, aad, str_bytes("abc"));
    println("aead sealed " + int_to_str(sealed.len()));
    val opened: Vec = chacha20poly_decrypt(k, nonce, aad, sealed);
    println("aead opened " + int_to_str(opened.len()) + " " + int_to_str(opened.get(0)));

    // RFC 7748 §6.1: Alice's public key from her secret key
    @secret val a_sk: Vec<i64> = hex_decode_bytes("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a");
    println("x25519 public " + he(x25519_public_key(a_sk)));
    println("secret keys ok");
    return 0;
}
