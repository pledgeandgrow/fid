// LF8 (llvm-roadmap): facts over a loop's back edge. A loop header gets a
// fact about one local (compiler/checks.fd peir_lf_update): the hull of
// its values on the ways in from outside the loop and of every value the
// loop body stores to it, found by iterating the range scan (from the
// ways in, widened after two rounds, narrowed back) until the assumption
// holds on every back edge. The fact reaches the body's loads through the
// dominating-block facts (OP24). FID_IROPT_OFF=rangeloop turns it off.
//
// In `mix`, j is 0 before the loop and (j + 7) % 13 in it: j in [-12, 12]
// at the header, so `j * 1000` and `j + 7` lose their overflow checks
// (j's flow-insensitive bounds say nothing: `j = t` after the loop).
// In `walk`, x is 5, then x + 3 under `x < 50` or 0: x in [0, 52], so
// `x * 100000` loses its check (widened to [0, max], narrowed to [0, 52]).
// test_midend_range_loop_fail.fd: a store of a large value in the loop
// keeps the multiply's check, and it fires.
//
// Expected output:
// 108000
// 118
// 71300000
// 42

fn mix(n: i64) -> i64 {
    var j: i64 = 0;
    var t: i64 = 0;
    var k: i64 = 0;
    while k < n {
        t = t + j * 1000;
        j = (j + 7) % 13;
        k = k + 1;
    }
    var last: i64 = j;
    j = t;
    println(j);
    return t / 1000 + last;
}

fn walk(n: i64) -> i64 {
    var x: i64 = 5;
    var s: i64 = 0;
    var k: i64 = 0;
    while k < n {
        s = s + x * 100000;
        if x < 50 {
            x = x + 3;
        } else {
            x = 0;
        }
        k = k + 1;
    }
    var last: i64 = x;
    x = s;
    println(x);
    return last;
}

fn main() {
    println(mix(20));
    println(walk(30));
}
