// expect-error: cannot read s.x
// LG3 (docs/roadmap/competitive-roadmap.md): a mutable borrow of a whole
// variable covers its fields: `s.x` cannot be read while `rs`, a mutable
// borrow of `s`, is still used (reference 8.4, rule 4). The other way is
// legal: a mutable borrow of `s.y` does not stop a read of `s.x`
// (test_lg3_read_during_mut_borrow.fd).
struct S {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    var s = S { x: 1, y: 2 };
    val rs = &mut s;
    val v = s.x;
    rs.y = v + 1;
    println(rs.y);
    return 0;
}
