// BG42 (docs/roadmap/bugs-roadmap.md): SCCP (compiler/iropt.fd iro_sccp)
// folded a same-width BitCast of a constant without normalising it to the
// new type, so `(m as i32) as i64` of u32::MAX gave 4294967295 on emit
// (the i32 constant still held the u32 bits, and the IntExtend after it
// kept them). Now the folded value is the same bits read as the new type,
// as IntExtend/IntTrunc fold theirs. The C path and `run` run no IR
// optimizer and were right already.
//
// Expected output:
// -1
// 4294967295
// -56
// 200
// -2147483648

fn main() -> i64 {
    val m: u32 = 4294967295;
    val a: i64 = (m as i32) as i64;
    println(a);
    val n: i32 = 0 - 1;
    val b: i64 = (n as u32) as i64;
    println(b);
    val c: u8 = 200;
    val d: i64 = (c as i8) as i64;
    println(d);
    val e: i8 = 0 - 56;
    val f: i64 = (e as u8) as i64;
    println(f);
    val g: u32 = 2147483648;
    val h: i64 = (g as i32) as i64;
    println(h);
    return 0;
}
