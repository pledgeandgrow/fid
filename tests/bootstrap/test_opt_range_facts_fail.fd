// OP24: expected to fail at run time (integer overflow). `x < 1000` holds
// in the then-block only; the return after the `if` is not dominated by
// it, so x is unbounded there and x * x keeps its check
// (compiler/checks.fd peir_dom_enter: only the facts of blocks that
// strictly dominate a block are in force in it). If the fact leaked past
// the join, the multiply would wrap instead of panicking.

fn after_join(x: i64) -> i64 {
    var y: i64 = 0;
    if x >= 0 {
        if x < 1000 {
            y = 1;
        }
        return x * x + y;
    }
    return 0;
}

fn main() {
    println(after_join(5));
    println(after_join(4000000000));
    print("unreachable\n");
}
