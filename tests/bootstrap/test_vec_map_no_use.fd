// Vec's map, filter, fold, ... are in core (reference §13.3): a call works
// with no `use vec;`. Before (known-bugs 2g.66) this file was an
// expect-error one: the call type-checked, then `fid run` panicked with
// "Unknown function 'Vec_map'".
// Expected output:
// 2
fn size(w: str) -> i64 {
    return str_len(w);
}

fn main() {
    var words: Vec<str> = Vec::new();
    words.push("a");
    words.push("bcd");
    var lens: Vec<i64> = words.map(size);
    println(int_to_str(lens.len()));
}
