// Bugs roadmap BG344: stdlib/string.fd int_to_str_padded padded the text
// "-7" on the left with '0', giving "00-7" (not a number). The zeros now go
// after the sign, as f"{n:04}" does: the width counts the sign.
//
// Expected output:
// -007
// 0007
// -7
// -12345
// 007
// -9223372036854775808
// [-007] [-007]

use string;

fn main() {
    println(int_to_str_padded(-7, 4));
    println(int_to_str_padded(7, 4));
    println(int_to_str_padded(-7, 1));
    println(int_to_str_padded(-12345, 3));
    println(int_to_str_padded(7, 3));
    println(int_to_str_padded(-9223372036854775807 - 1, 5));
    val m: i64 = -7;
    println("[" + int_to_str_padded(m, 4) + "] [" + f"{m:04}" + "]");
}
