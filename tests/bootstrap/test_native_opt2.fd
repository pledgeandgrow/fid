// The native optimizer, second round (competitive OP7, OP13, OP18, OP19):
// self tail calls run as loops, repeated pure expressions are computed
// once, and Vecs of bytes (u8, bool) are read, written and pushed in place.
// Every backend prints the same.
//
// Expected output:
// 125250 21
// 6 9 8
// 255 0 7 3000
// 1229
// true false 3
// 1 2 3 4 5

fn sum_to(n: i64, acc: i64) -> i64 {
    if n == 0 { return acc; }
    return sum_to(n - 1, acc + n);
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { return a; }
    return gcd(b, a % b);
}

fn exprs(x: i64, y: i64) -> i64 {
    var a: i64 = x * y + 1;
    var b: i64 = x * y + 1;
    var c: i64 = 0;
    if x > 0 {
        c = x * y + 1 - a;
    }
    return a + b + c - (x * y + 1);
}

fn sieve(n: i64) -> i64 {
    var is: Vec<u8> = Vec::new();
    var i: i64 = 0;
    while i < n { is.push(1); i = i + 1; }
    is.set(0, 0);
    is.set(1, 0);
    var p: i64 = 2;
    while p * p < n {
        if is.get(p) == 1 {
            var m: i64 = p * p;
            while m < n { is.set(m, 0); m = m + p; }
        }
        p = p + 1;
    }
    var count: i64 = 0;
    i = 0;
    while i < n { count = count + (is.get(i) as i64); i = i + 1; }
    return count;
}

fn main() -> i64 {
    println(int_to_str(sum_to(500, 0)) + " " + int_to_str(gcd(1071, 462)));
    println(int_to_str(exprs(1, 5)) + " " + int_to_str(exprs(2, 4)) + " " + int_to_str(exprs(-1, -7) - 0));
    var b: Vec<u8> = Vec::new();
    var k: i64 = 0;
    while k < 3000 {
        b.push((k % 256) as u8);
        k = k + 1;
    }
    b.set(2, 7);
    println(int_to_str(b.get(255) as i64) + " " + int_to_str(b.get(256) as i64) + " " + int_to_str(b.get(2) as i64) + " " + int_to_str(b.len()));
    println(sieve(10000));
    var f: Vec<bool> = Vec::new();
    f.push(true);
    f.push(false);
    f.push(true);
    var c: Vec<u8> = b.clone();
    c.set(0, 9);
    println(bool_str(f.get(0)) + " " + bool_str(f.get(1)) + " " + int_to_str(f.len()));
    var w: Vec<u8> = Vec::new();
    var q: i64 = 1;
    while q <= 5 { w.push(q as u8); q = q + 1; }
    var line: str = "";
    q = 0;
    while q < w.len() {
        if q > 0 { line = line + " "; }
        line = line + int_to_str(w.get(q) as i64);
        q = q + 1;
    }
    println(line);
    return 0;
}

fn bool_str(v: bool) -> str {
    if v { return "true"; }
    return "false";
}
