// expect-error: cannot mutate v: shared borrow(s) are active on it or its fields
// BG12: a borrower read only under a cast had no last use, so its borrow
// ended where it was made and the push below was accepted (a dangling
// read). The cast's operand counts as a use: `e` borrows v until the
// println, so `v.push(2)` is rejected.
fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    val e: &i64 = &v[0];
    v.push(2);
    println(int_to_str((*e) as i64));
    return 0;
}
