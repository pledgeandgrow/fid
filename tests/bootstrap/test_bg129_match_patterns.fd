// Bugs roadmap BG129: a pattern naming an enum must name the scrutinee's,
// and a literal pattern must be of the scrutinee's type. The well-typed
// matches below (numbers of every width, strings, bools, ranges, enums
// matched by value, through a reference and in a Box, generic enums)
// still compile and run.
//
// Expected output:
// two
// small
// b
// yes
// x 5
// q
// some 3
// ok 4
// ref y
// boxed 8
// done

enum A {
    X(i64),
    Y,
}

enum B {
    P(str),
    Q,
}

fn name_of(n: i64) -> str {
    match n {
        1 => {
            return "one";
        }
        2 => {
            return "two";
        }
        _ => {
            return "many";
        }
    }
    return "";
}

fn size_of(b: u8) -> str {
    match b {
        0..10 => {
            return "small";
        }
        _ => {
            return "big";
        }
    }
    return "";
}

fn letter(s: str) -> str {
    match s {
        "a" => {
            return "a";
        }
        "b" => {
            return "b";
        }
        _ => {
            return "?";
        }
    }
    return "";
}

fn by_ref(a: &A) -> str {
    match a {
        A::X(_) => {
            return "ref x";
        }
        A::Y => {
            return "ref y";
        }
    }
    return "";
}

fn main() -> i64 {
    println(name_of(2));
    val small: u8 = 4;
    println(size_of(small));
    println(letter("b"));
    val flag: bool = true;
    match flag {
        true => {
            println("yes");
        }
        false => {
            println("no");
        }
    }
    val a: A = A::X(5);
    match a {
        A::X(n) => {
            println("x " + int_to_str(n));
        }
        A::Y => {
            println("y");
        }
    }
    val b: B = B::Q;
    match b {
        B::P(s) => {
            println(s);
        }
        B::Q => {
            println("q");
        }
    }
    val o: Option<i64> = Option::Some(3);
    match o {
        Option::Some(v) => {
            println("some " + int_to_str(v));
        }
        Option::None => {
            println("none");
        }
    }
    val r: Result<i64, str> = Result::Ok(4);
    match r {
        Result::Ok(v) => {
            println("ok " + int_to_str(v));
        }
        Result::Err(e) => {
            println(e);
        }
    }
    val y: A = A::Y;
    println(by_ref(&y));
    val bx: Box<A> = Box::new(A::X(8));
    match bx {
        A::X(n) => {
            println("boxed " + int_to_str(n));
        }
        A::Y => {
            println("boxed y");
        }
    }
    println("done");
    return 0;
}
