// BG31 (docs/roadmap/bugs-roadmap.md): the IR lock-order check
// (compiler/lockcheck.fd, run by `fid check`) named a lock by its slot's
// value id and put every function's ids into one graph. `first` and
// `second` below have the same shape, so their slots got the same ids:
// `first` locking x then y and `second` locking q then p read as one lock
// taken in both orders, and `fid check` stopped with a lock-order cycle.
// They are four different mutexes: no cycle. Locks are named per function
// now (a global by its name, a parameter by what the caller passes), and
// p_mutex_lock is seen too (BG64): `both` takes its two arguments in the
// order main passes them, the same order every time.
//
// Expected output:
// 1
// 2
// 3
use sync;

fn first() -> i64 {
    var x: i64 = sync_mutex_create();
    var y: i64 = sync_mutex_create();
    sync_mutex_lock(x);
    sync_mutex_lock(y);
    sync_mutex_unlock(y);
    sync_mutex_unlock(x);
    return 1;
}

fn second() -> i64 {
    var p: i64 = sync_mutex_create();
    var q: i64 = sync_mutex_create();
    sync_mutex_lock(q);
    sync_mutex_lock(p);
    sync_mutex_unlock(p);
    sync_mutex_unlock(q);
    return 2;
}

fn both(m1: i64, m2: i64) -> i64 {
    p_mutex_lock(m1);
    p_mutex_lock(m2);
    p_mutex_unlock(m2);
    p_mutex_unlock(m1);
    return 1;
}

fn main() -> i64 {
    println(first());
    println(second());
    var a: i64 = sync_mutex_create();
    var b: i64 = sync_mutex_create();
    println(both(a, b) + both(a, b) + 1);
    return 0;
}
