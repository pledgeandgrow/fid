// BG219 (docs/roadmap/bugs-roadmap.md): a generic function is called, not
// taken as a value (test_bg219_generic_fn_value_fail); a plain function is
// still a value.
//
// Expected output:
// 5
// 42
// 7
cap A {
    fn ok(self) -> i64;
}

struct N {
    v: i64,
}

impl A for N {
    fn ok(self) -> i64 {
        return self.v;
    }
}

fn need<T: A>(x: T) -> i64 {
    return x.ok();
}

fn twice(x: i64) -> i64 {
    return x * 2;
}

fn apply(g: fn(i64) -> i64, x: i64) -> i64 {
    return g(x);
}

fn main() -> i64 {
    println(need(N { v: 5 }));
    println(apply(twice, 21));
    val g = twice;
    println(g(3) + 1);
    return 0;
}
