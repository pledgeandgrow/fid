// CM10: a Vec extended by itself ends, with every element twice. The C
// runtime's p_vec_extend read other->len each round, and other == v grows
// with each push, so `p_vec_extend(v, v)` never ended on the C backend; it
// now reads the count once. Core's vec_raw_extend (native backends) re-reads
// the buffer each round, since a push that grows `v` frees the old one.
//
// Expected output:
// [1 2 3 1 2 3] len 6
// [1 2 3 1 2 3 1 2 3 1 2 3] len 12
// [] len 0
// [7] len 1
// [7 7] len 2

fn show(v: Vec<i64>) {
    var s: str = "[";
    var i: i64 = 0;
    while i < p_vec_len(v) {
        if i > 0 { s = s + " "; }
        s = s + int_to_str(p_vec_get(v, i));
        i = i + 1;
    }
    println(s + "] len " + int_to_str(p_vec_len(v)));
}

fn main() {
    var v: Vec<i64> = Vec::new();
    p_vec_push(v, 1);
    p_vec_push(v, 2);
    p_vec_push(v, 3);
    p_vec_extend(v, v);
    show(v);
    p_vec_extend(v, v);
    show(v);
    var e: Vec<i64> = Vec::new();
    p_vec_extend(e, e);
    show(e);
    var one: Vec<i64> = Vec::new();
    p_vec_push(one, 7);
    show(one);
    p_vec_extend(one, one);
    show(one);
}
