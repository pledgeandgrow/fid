// Bugs roadmap BG388: `spawn f(..)` (and a `parallel` branch) ignored
// default parameters and named arguments: `spawn f(1)` passed no `b`,
// `spawn g(b: 2, a: 1)` passed the values in source order.
// compiler/lower.fd Lowerer_lower_expr Expr::Spawn and the Stmt::Parallel
// branches now resolve the arguments as a call does
// (Lowerer_resolve_call_args).
//
// Expected output:
// 110
// 110
// 102
// 210
// 403

fn f(a: i64, b: i64 = 10) -> i64 {
    return a * 100 + b;
}

fn g(a: i64, b: i64) -> i64 {
    return a * 100 + b;
}

fn main() {
    println(f(1));
    val t = spawn f(1);
    println(await t);
    val t2 = spawn g(b: 2, a: 1);
    println(await t2);
    var x: i64 = 0;
    var y: i64 = 0;
    parallel {
        | x = f(2);
        | y = g(b: 3, a: 4);
    }
    println(x);
    println(y);
}
