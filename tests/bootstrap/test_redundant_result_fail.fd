// expect-error: Redundancy error: @redundant function 'pitch_label' does not return a scalar
// Roadmap Phase 9 (F45): the voter compares the channels' results, so a
// @redundant function returns an integer, a float or a bool.

@redundant
fn pitch_label(alpha: i64) -> str {
    return "pitch " + int_to_str(alpha);
}

fn main() {
    println(pitch_label(3));
}
