// Release M10 (complaint CM10): core's ByteBuffer.write_bytes reads a raw
// address, so it is @unsafe; write_vec is its safe form (the low byte of
// each element). write_bytes takes the buffer by `& mut`: by value, its
// writes went to a copy and the buffer stayed empty.
//
// Expected output:
// 3
// hi!
// 6
// hi!xyz
// 120
fn main() -> i64 {
    var b = ByteBuffer::new(0);
    var v: Vec<i64> = Vec::new();
    v.push(104);
    v.push(105);
    v.push(256 + 33);
    b.write_vec(v);
    println(int_to_str(b.len()));
    println(b.to_str());
    val s: str = "xyz";
    // SAFETY: s is a live literal of 3 bytes; write_bytes reads only those.
    unsafe {
        b.write_bytes(s as i64, 3);
    }
    println(int_to_str(b.len()));
    println(b.to_str());
    println(int_to_str(b.read_byte(3)));
    return 0;
}
