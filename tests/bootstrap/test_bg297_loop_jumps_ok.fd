// Bugs roadmap BG297: break and continue inside loops (nested in if and
// match, and in a nested loop) still compile.
//
// Expected output:
// 0 2 4
// 3
fn main() -> i64 {
    var out = "";
    for i in 0..10 {
        if i % 2 == 1 {
            continue;
        }
        match i {
            6 => {
                break;
            }
            _ => {
            }
        }
        out = out + f"{i} ";
    }
    println(str_trim(out));
    var n = 0;
    while true {
        loop {
            break;
        }
        n = n + 1;
        if n == 3 {
            break;
        }
    }
    println(n);
    return 0;
}
