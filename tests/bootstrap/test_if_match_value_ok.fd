// Bugs roadmap BG19/BG20: the branches of an `if` or `match` used as a
// value are compared now; these stay accepted: numbers of different
// widths, a branch that leaves with return, strings, an Option built in
// one arm and passed in another, and a variable assigned in every arm
// that reaches the end of a match (the arm that returns assigns nothing).
// Expected output:
// 300
// big
// 7
// 12
fn pick(c: bool, small: u8, big: i64) -> i64 {
    val r: i64 = if c { small } else { big };
    return r;
}

fn size(n: i64) -> str {
    val s: str = if n > 10 { "big" } else { "small" };
    return s;
}

fn first(o: Option<i64>, fallback: i64) -> i64 {
    val got: Option<i64> = match fallback {
        0 => { o }
        _ => { Option::Some(fallback) }
    };
    return got.unwrap_or(0);
}

fn twice(k: i64) -> i64 {
    var x: i64;
    match k {
        1 => {
            x = 10;
        }
        2 => {
            x = 12;
        }
        _ => {
            return 0;
        }
    }
    return x;
}

fn main() -> i64 {
    println(int_to_str(pick(false, 3, 300)));
    println(size(20));
    println(int_to_str(first(Option::None, 7)));
    println(int_to_str(twice(2)));
    return 0;
}
