            s = s + (i + 17) % 7;
            s = s + (i + 18) % 7;
            s = s + (i + 19) % 7;
            s = s + (i + 20) % 7;
            s = s + (i + 21) % 7;
            s = s + (i + 22) % 7;
            s = s + (i + 23) % 7;
            s = s + (i + 24) % 7;
            s = s + (i + 25) % 7;
            s = s + (i + 26) % 7;
            s = s + (i + 27) % 7;
            s = s + (i + 28) % 7;
            s = s + (i + 29) % 7;
