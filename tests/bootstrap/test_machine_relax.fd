// Track TG (docs/roadmap/llvm-roadmap.md), the machine layer
// (compiler/nat_ir.fd):
//   TG6 branch relaxation: ng_mir_emit emits a function with every branch
//       long, then again with the branches whose target stays in reach
//       short (x86-64 jmp/jcc rel8, RISC-V one B<cc>, RISC-V calls to
//       placed callees as one JAL). `big` has a loop body of a few KB
//       (its back edge and the jump over the else stay long: rel32 on
//       x86-64, more than 4 KB on RISC-V), `small` and `classify` only
//       short branches, `sq_sum` calls a placed callee in a loop.
//       FID_NAT_OFF=relax: every branch long, the same output.
// Native check: NATIVE=1 bash scripts/cross-test.sh x86_64-linux (and
// riscv64-linux, aarch64-linux), also with FID_VERIFY=1.
// Expected output:
// 7061
// 1000
// 100
// 8585
// 8
// 32
// -1
// 0
// 1
// 2
// 3

fn big(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if i % 3 == 0 {
            s = s + 1000;
        } else {
            s = s + (i + 1) % 7;
            s = s + (i + 2) % 7;
            s = s + (i + 3) % 7;
            s = s + (i + 4) % 7;
            s = s + (i + 5) % 7;
            s = s + (i + 6) % 7;
            s = s + (i + 7) % 7;
            s = s + (i + 8) % 7;
            s = s + (i + 9) % 7;
