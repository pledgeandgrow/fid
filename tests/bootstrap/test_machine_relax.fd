            s = s + (i + 164) % 7;
            s = s + (i + 165) % 7;
            s = s + (i + 166) % 7;
            s = s + (i + 167) % 7;
            s = s + (i + 168) % 7;
            s = s + (i + 169) % 7;
            s = s + (i + 170) % 7;
        }
        i = i + 1;
    }
    return s;
}

fn small(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        if i % 2 == 0 {
            s = s + i;
        } else {
            s = s - 1;
        }
        i = i + 1;
    }
    return s;
}

fn sq1(x: i64) -> i64 {
    return x * x + 1;
}

fn sq_sum(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + sq1(i);
        i = i + 1;
    }
    return s;
}

// A loop left only by a return (the loop's own test is a constant)
fn find(lim: i64) -> i64 {
    var i: i64 = 0;
    while true {
        if i * i > lim {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn classify(x: i64) -> i64 {
    if x < 0 {
        return 0 - 1;
    }
    if x == 0 {
        return 0;
    }
    if x < 10 {
        return 1;
    }
    if x < 100 {
        return 2;
    }
    return 3;
}

fn main() -> i64 {
    println(big(10));
    println(big(1));
    println(small(21));
    println(sq_sum(30));
    println(find(50));
    println(find(1000));
    println(classify(0 - 5));
    println(classify(0));
    println(classify(7));
    println(classify(42));
    println(classify(512));
    return 0;
}
