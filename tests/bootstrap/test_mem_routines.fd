// Test (competitive roadmap OP23): substring search, copies and byte
// compares (msvcrt memchr/memcpy/memcmp natively on Windows, word at a
// time on Linux) give the same results as byte by byte, including at
// the start, the end, across word boundaries and for misses.
//
// Expected output:
// 0 4 26 -1 -1 33
// true false
// 4000 x
// 64 63 0 1 0 64 8 32
use bits;

fn main() -> i64 {
    val s: str = "abcdefghijklmnopqrstuvwxyz0123456789";
    println(int_to_str(str_find(s, "abc")) + " " + int_to_str(str_find(s, "efg")) + " "
        + int_to_str(str_find(s, "0")) + " " + int_to_str(str_find(s, "zz")) + " "
        + int_to_str(str_find(s, "9a")) + " " + int_to_str(str_find(s, "789")));
    val a: str = "the quick brown fox jumps over the lazy dog";
    val b: str = "the quick brown fox jumps over the lazy dog";
    val c: str = "the quick brown fox jumps over the lazy cog";
    var eq1: str = "false";
    if a == b { eq1 = "true"; }
    var eq2: str = "false";
    if a == c { eq2 = "true"; }
    println(eq1 + " " + eq2);
    var big: str = "";
    var i: i64 = 0;
    while i < 1000 { big = big + "abcd"; i = i + 1; }
    val big2: str = big + "x";
    println(int_to_str(str_len(big)) + " " + str_slice(big2, 4000, 4001));
    println(int_to_str(bit_popcount(0 - 1)) + " " + int_to_str(bit_leading_zeros(1)) + " "
        + int_to_str(bit_leading_zeros(0 - 5)) + " " + int_to_str(bit_leading_zeros(0x4000000000000000)) + " "
        + int_to_str(bit_trailing_zeros(1)) + " " + int_to_str(bit_trailing_zeros(0)) + " "
        + int_to_str(bit_popcount(0xFF)) + " " + int_to_str(bit_trailing_zeros(0x100000000)));
    return 0;
}
