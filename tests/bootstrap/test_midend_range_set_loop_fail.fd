// LF8 (llvm-roadmap, Nov 17): a loop header's further assumed facts
// (compiler/checks.fd PeirBackFacts.m_*, test_midend_range_set.fd `walk2`)
// must hold on every back edge, like the first. Here the body also stores
// a value into y that makes `y * 100000` overflow on the next round: the
// assumption on y cannot hold (it grows to no bound and is dropped,
// peir_lf_step), the multiply keeps its overflow check, and it fires at
// k == 6. x's assumption still holds and its multiply loses its check.
// Expected: prints 1, then an overflow panic (exit status not 0).

fn walk2(n: i64) -> i64 {
    var x: i64 = 5;
    var y: i64 = 1;
    var s: i64 = 0;
    var k: i64 = 0;
    while k < n {
        s = s + x * 100000 + y * 100000;
        if x < 50 {
            x = x + 3;
        } else {
            x = 0;
        }
        if y < 70 {
            y = y + 4;
        } else {
            y = 1;
        }
        if k == 5 {
            y = 92233720368548;
        }
        k = k + 1;
    }
    var lx: i64 = x;
    var ly: i64 = y;
    x = s;
    y = s;
    return lx * 1000 + ly;
}

fn main() {
    println(1);
    println(walk2(30));
}
