// Test (known-bugs 2g.13): user functions named like functions the C
// runtime's headers declare (fopen, puts, read, send, index) get C names
// of their own (codegen_c.fd sanitize_c_name / cg_libc_clash), so the C
// path compiles them ("conflicting types for 'fopen'" before); calls and
// a function value reach the user's function.
//
// Expected output:
// 6
// 21
// 7
// 12
// 30
fn fopen(x: i64) -> i64 { return x + 1; }
fn puts(x: i64) -> i64 { return x * 7; }
fn read(a: i64, b: i64) -> i64 { return a + b; }
fn send(x: i64) -> i64 { return x * 2; }
fn index(v: Vec<i64>, i: i64) -> i64 { return v.get(i); }
fn apply(f: fn(i64) -> i64, x: i64) -> i64 { return f(x); }

fn main() -> i64 {
    println(int_to_str(fopen(5)));
    println(int_to_str(puts(3)));
    println(int_to_str(read(3, 4)));
    println(int_to_str(apply(send, 6)));
    var v: Vec<i64> = Vec::new();
    v.push(10);
    v.push(30);
    println(int_to_str(index(v, 1)));
    return 0;
}
