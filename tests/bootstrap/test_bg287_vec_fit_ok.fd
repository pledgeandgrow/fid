// Bugs roadmap BG287: literals that fit the element type are still stored.
//
// Expected output:
// 255 0 -128 127 9
fn main() -> i64 {
    var v: Vec<u8> = Vec::new();
    v.push(255);
    v.push(0);
    var w: Vec<i8> = Vec::new();
    w.push(-128);
    w.push(127);
    w.insert(0, 9);
    println(f"{v[0]} {v[1]} {w[1]} {w[2]} {w[0]}");
    return 0;
}
