// Bugs roadmap BG468: on `emit --nat` Windows `p_system` returned a negative
// exit code zero-extended (`exit -1` gave 4294967295), where C's system()
// and pe_ir give the signed int (-1). The Windows layer's shell runner
// (stdlib/linux_runtime/win.fd pe_win_sh) now sign-extends the DWORD.
// A negative exit code exists only on Windows: the other variants print
// the same text so every lane agrees.
//
// Expected output:
// -1
// 3

@cfg(windows)
fn neg_code() -> i64 {
    return p_system("exit -1");
}

@cfg(linux)
fn neg_code() -> i64 {
    return -1;
}

@cfg(macos)
fn neg_code() -> i64 {
    return -1;
}

fn main() {
    println(f"{neg_code()}");
    println(f"{p_system("exit 3")}");
}
