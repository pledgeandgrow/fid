// test_checkpoint.fd — ML11: Gradient Checkpointing
// Expected: PASS
// Tests @checkpoint annotation on @differentiable + @deterministic functions.

use tensor;

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

@differentiable
@deterministic
@checkpoint
fn checkpointed_forward(x: Tensor) -> Tensor {
    // This function is checkpointed: activations are saved during forward,
    // freed after backward, and recomputed during backward pass.
    val w = ones(vec2(2, 2));
    val h = matmul(x, w);
    val a = relu(h);
    return a;
}

fn main() {
    val x = ones(vec2(2, 2));
    val result = checkpointed_forward(x);
    print(to_str(result));
    print("\n");
    return 0;
}
