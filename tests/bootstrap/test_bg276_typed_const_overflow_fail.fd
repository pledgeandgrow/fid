// expect-error: Integer overflow on addition
// BG276 (docs/roadmap/bugs-roadmap.md): `const CU: u8 = 200; CU + CU` is a
// u8 add (reference §3.5: overflow panics at the declared width); it was an
// i64 add whose 400 was truncated to 144.
const CU: u8 = 200;

fn main() {
    val x: u8 = CU + CU;
    println(f"{x}");
}
