// LG3: a result tied to several arguments, a method's result tied to its
// receiver, and a function without lifetimes (its result may borrow from
// any reference parameter). Each borrow ends at the result's last use, so
// changing the borrowed variables after that is fine, and changing a
// variable the result does not borrow is fine while it is live.
// Expected output:
// 3
// 9
// 4
// 8
// 20
// 5
// 10
// 6

struct Holder {
    a: i64,
    b: i64,
}

impl Holder {
    fn peek_a<'a>(self: &'a Holder) -> &'a i64 {
        return &self.a;
    }
}

fn pick<'a>(x: &'a i64, y: &'a i64) -> &'a i64 {
    if *x > *y {
        return x;
    }
    return y;
}

fn only(p: &i64) -> &i64 {
    return p;
}

fn main() -> i64 {
    var x: i64 = 1;
    var y: i64 = 3;
    var c: i64 = 0;
    val m = pick(&x, &y);
    c = 9;
    println(*m);
    println(c);
    x = 4;
    y = 2;
    val m2 = pick(&x, &y);
    println(*m2);

    var z: i64 = 8;
    val o = only(&z);
    println(*o);
    z = 20;
    println(z);

    var h: Holder = Holder { a: 5, b: 6 };
    val r = h.peek_a();
    println(*r);
    h.a = 10;
    println(h.a);
    println(h.b);
    return 0;
}
