// A9' (inc-roadmap): the C generator registers by name only the functions
// the program names (a string constant or a function reference), and the
// panic-trace table __p_fns lists only the functions a run can reach, so a
// dead function's address is never taken and it can be dropped. Spawning
// by name, function values and trait objects keep working.
// (`fid dump-c` of this file: no p_thread_register("never_called", ...) and
// no __p_fns entry for never_called.)
//
// Expected output:
// spawned 42
// twice 14
// area 12
// done

use sync;

async fn work(x: i64) -> Future<i64> {
    return x * 2;
}

fn twice(x: i64) -> i64 {
    return x * 2;
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x);
}

fn never_called(x: i64) -> i64 {
    return x + 1000;
}

cap Area {
    fn area(self) -> i64;
}

struct Box2 { w: i64, h: i64 }

impl Area for Box2 {
    pub fn area(self: Box2) -> i64 { return self.w * self.h; }
}

fn main() -> i64 {
    val t = spawn work(21);
    val r = await t;
    println("spawned " + int_to_str(r));
    println("twice " + int_to_str(apply(twice, 7)));
    val b = Box2 { w: 3, h: 4 };
    val d = b as dyn Area;
    println("area " + int_to_str(d.area()));
    println("done");
    return 0;
}
