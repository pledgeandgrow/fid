// `return <expr>` evaluates <expr> before defers (and drops and @zeroize
// wipes) run. They used to run first, so the value read cleared state.
fn doubled() -> i64 {
    var x: i64 = 5;
    defer { x = 0; }
    return x * 2;
}

fn early(flag: bool) -> i64 {
    var y: i64 = 7;
    defer { y = -1; }
    if flag { return y + 1; }
    return y;
}

fn main() {
    assert_msg(doubled() == 10, "return value computed before defer");
    assert_msg(early(true) == 8, "early return computed before defer");
    assert_msg(early(false) == 7, "final return computed before defer");
    print("return order OK
");
}
