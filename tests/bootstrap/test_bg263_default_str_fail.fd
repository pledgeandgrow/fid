// expect-error: cannot assign str to parameter 'x' of type i64 (its default value in 'h')
// Bugs roadmap BG263: a default parameter value is type-checked against
// the parameter's type; before, `h()` returned the string's address.
fn h(x: i64 = "hello") -> i64 {
    return x;
}

fn main() -> i64 {
    println(h());
    return 0;
}
