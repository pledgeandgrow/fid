// expect-error: Str_drop() needs an `unsafe` block
// Bugs roadmap BG113: BG10 made core's raw-memory functions need `unsafe`,
// but only those named `p_*`: Str_drop, which frees the string at the
// address it is given, was callable in safe code (here twice on one
// string's word).
fn main() -> i64 {
    val s: str = "a" + "b";
    Str_drop(s as i64);
    Str_drop(s as i64);
    return 0;
}
