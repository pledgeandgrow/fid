// expect-error: function variable 'f' expects 1 args, got 2
//! error: function variable 'f' expects 1 args, got 2
// TL2: a test per diagnostic of the type, borrow and escape checks.
// A function-typed parameter is called with its declared parameters.

fn apply(f: fn(i64) -> i64) -> i64 {
    return f(1, 2);
}

fn inc(x: i64) -> i64 {
    return x + 1;
}

fn main() -> i64 {
    println(apply(inc));
    return 0;
}
