// Bugs roadmap BG478: stdlib/cbor.fd cbor_float_diag printed an integral
// float of 2^53 or more as float_to_str's integer digits
// ("340282346638528859811704183484516925440", 1e300 as 301 digits), which
// diagnostic notation reads as an integer (RFC 8949 §8). It is now written
// with an exponent, in the fewest digits that read back as the double, as
// RFC 8949 Appendix A shows them.
//
// Expected output:
// 3.4028234663852886e+38
// 1.0e+300
// -1.0e+300
// 9007199254740992.0
// 1.8446744073709552e+19
// 100000.0
// 1.5

use cbor;
use encoding;

fn diag_hex(hex: str) -> str {
    val d: CborDoc = cbor_decode_all(hex_decode_bytes(hex));
    return cbor_diag(&d, d.root);
}

fn main() {
    println(diag_hex("fa7f7fffff"));
    println(diag_hex("fb7e37e43c8800759c"));
    println(cbor_float_diag(-1.0e+300));
    println(cbor_float_diag(9007199254740992.0));
    println(cbor_float_diag(18446744073709551616.0));
    println(diag_hex("fa47c35000"));
    println(cbor_float_diag(1.5));
}
