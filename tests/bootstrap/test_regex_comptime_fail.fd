// expect-error: given to regex_compile() is not a valid regular expression: the '(' at offset 4 is not closed by ')'
// L4E: a literal pattern is parsed when the program is checked
// (typechecker.fd TypeChecker_check_regex_literal, the same scan as
// stdlib/regex.fd regex_compile). One regex_compile would reject is a
// compile error, not a Regex that silently never matches.

use regex;

fn main() -> i64 {
    val r: Regex = regex_compile("key=(\\w+");
    println("unreachable");
    return 0;
}
