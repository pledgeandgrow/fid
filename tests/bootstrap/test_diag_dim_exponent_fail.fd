// expect-error: `Vol * Vol`: an exponent of the result leaves -8..7.
// Expected to FAIL (CE4): m^6 times m^6 is m^12, which a dimension cannot
// hold (each exponent is -8..7; CL10 TypeChecker_dim_result).
@dimension(m = 6)
struct Vol {
    value: f64,
}

fn main() -> i64 {
    val a: Vol = Vol { value: 2.0 };
    val b: Vol = Vol { value: 3.0 };
    val c: f64 = (a * b).value;
    println(int_to_str(c as i64));
    return 0;
}
