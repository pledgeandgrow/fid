// expect-error: calling the @unsafe function ptr_read() needs an `unsafe` block
// Release M10 (complaint CM10): stdlib/volatile's ptr_read takes a raw
// address, so it is @unsafe, and a program may call it only from an
// `unsafe` block or an @unsafe function. Here `peek` calls it with an
// address it made up (0x1000): the call is rejected at compile time,
// before it could read memory nobody owns. Wrapping the call in
// `unsafe { }`, with a `// SAFETY:` comment saying why the address is
// live, is accepted (test_unsafe_raw_apis.fd).
use volatile;

fn peek(addr: i64) -> i64 {
    return ptr_read(addr);
}

fn main() -> i64 {
    println(int_to_str(peek(4096)));
    return 0;
}
