// expect-error: function 'read_with' parameter 2 expects
// Bugs roadmap BG17: a function value's parameters were compared the way
// arguments are, so `bump`, which changes its Counter through `&mut`, was
// accepted where a `fn(&Counter)` is wanted: read_with lends it a shared
// reference and the counter changed through it. Parameters go the other
// way (contravariance): a function taking `&T` may stand for a
// `fn(&mut T)` (test_fn_param_variance.fd), not the reverse.
struct Counter {
    n: i64,
}

fn bump(c: &mut Counter) -> i64 {
    c.n = c.n + 1;
    return c.n;
}

fn read_with(c: &Counter, f: fn(&Counter) -> i64) -> i64 {
    return f(c);
}

fn main() -> i64 {
    val c: Counter = Counter { n: 1 };
    println(int_to_str(read_with(&c, bump)));
    return 0;
}
