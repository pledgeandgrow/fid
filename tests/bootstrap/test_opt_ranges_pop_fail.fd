// VF5: expected to fail at run time. The bound is the length before the
// loop, and the loop shrinks the Vec: a check removed on the strength of
// the starting length would read a popped element instead of panicking.

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 10 { v.push(i); i = i + 1; }
    val n: i64 = v.len();
    var s: i64 = 0;
    i = 0;
    while i < n {
        s = s + v.get(i);
        v.pop();
        i = i + 1;
    }
    println(s);
    return 0;
}
