// expect-error: units of different dimensions (m and s) do not add
// CL10 (fid): metres added to seconds is a type error, with no `add`
// method written: the units' dimensions differ.

@dimension(m = 1)
struct Len {
    value: f64,
}

@dimension(s = 1)
struct Time {
    value: f64,
}

fn main() -> i64 {
    val d: Len = Len { value: 3.0 };
    val t: Time = Time { value: 2.0 };
    val x: Len = d + t;
    println(int_to_str(x.value as i64));
    return 0;
}
