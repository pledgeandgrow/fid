// expect-error: Duplicate definition: struct 'Pt' is defined twice in module
// Bugs roadmap BG372: two `struct Pt` in one module were accepted; the type
// checker used the first and lowering the second, so `p.x + 1` printed the
// bits of 4.0.
struct Pt {
    x: i64,
}
struct Pt {
    x: f64,
}
fn main() {
    val p = Pt { x: 3 };
    val k: i64 = p.x + 1;
    println(k);
}
