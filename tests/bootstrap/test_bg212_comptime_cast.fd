// BG212 (docs/roadmap/bugs-roadmap.md): comptime evaluates casts between
// floats and integers. Before, `7 as f64` stayed a cast node (so
// `(a + b) as f64 / 2.0` was "cannot evaluate binop on non-literal") and a
// cast of a float was returned as it was (so `-(7.9 as i64)` was "cannot
// negate non-number").
//
// Expected output:
// 3.5
// -7
// 7 -7
// 0.5
// 300
// 2.5
comptime fn avg(a: i64, b: i64) -> f64 {
    return (a + b) as f64 / 2.0;
}

fn main() -> i64 {
    val a = comptime avg(3, 4);
    println(f"{a}");
    val b = comptime (-(7.9 as i64));
    println(f"{b}");
    val c = comptime (7.9 as i64);
    val d = comptime (-7.9 as i64);
    println(f"{c} {d}");
    val e = comptime ((1 as f64) / 2.0);
    println(f"{e}");
    // an unsigned target tags the truncated value, as for an integer
    val u: u16 = comptime (300.7 as u16);
    println(f"{u}");
    // a float to a float is itself
    val g = comptime (2.5 as f64);
    println(f"{g}");
    return 0;
}
