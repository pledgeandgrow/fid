// BG423 (docs/roadmap/bugs-roadmap.md): `==` on two HashMaps compares them
// by content (proposal 0001 rule 5), and so does a struct holding one: a
// struct was not even equal to its own copy (the copy has its own handle).
//
// Expected output:
// true
// true
// false
// false
// true
// true

struct M {
    m: HashMap<str, i64>,
    n: i64,
}

fn main() {
    var a: HashMap<str, i64> = HashMap::new();
    a.insert("x", 1);
    var b: HashMap<str, i64> = HashMap::new();
    b.insert("x", 1);
    println(a == b);
    val p = M { m: a, n: 1 };
    val q = p;
    println(p == q);
    b.insert("y", 2);
    println(a == b);
    var c: HashMap<i64, str> = HashMap::new();
    c.insert(7, "seven");
    var d: HashMap<i64, str> = HashMap::new();
    d.insert(7, "SEVEN");
    println(c == d);
    d.insert(7, "seven");
    println(c == d);
    println(a != b);
}
