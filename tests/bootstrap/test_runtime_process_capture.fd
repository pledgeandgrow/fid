// Process capture in the native runtimes (known-bugs 2g.43, 2g.44,
// competitive SL17): stdout and stderr are two strings that both live as
// long as the handle (the second read no longer reuses the first one's
// block), a handle of 0 gives "" rather than a null string, and the capture
// files go in the temp directory, so nothing is left in the current one.
//
// Expected output:
// out [first] err [second] code 2
// null handle: [] [] -1
// again: [third]
use process;

fn main() -> i64 {
    var h: i64 = process_run("echo first && echo second 1>&2 && exit 2");
    var o: str = str_trim(process_stdout(h));
    var e: str = str_trim(process_stderr(h));
    println("out [" + o + "] err [" + e + "] code " + int_to_str(process_code(h)));
    process_close(h);
    println("null handle: [" + process_stdout(0) + "] [" + process_stderr(0) + "] " + int_to_str(process_code(0)));
    var h2: i64 = process_run("echo third");
    println("again: [" + str_trim(process_stdout(h2)) + "]");
    process_close(h2);
    return 0;
}
