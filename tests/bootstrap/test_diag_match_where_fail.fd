// "in main" (the module of the user's file) whatever the function was.
enum Color {
    Red,
    Green,
    Blue,
}

fn shade(c: Color) -> i64 {
    var v: i64 = 0;
    // the match below is line 14
    match c {
        Color::Red => {
            v = 1;
        }
        Color::Green => {
            v = 2;
        }
    }
    return v;
}

fn main() {
    println(shade(Color::Red));
}
