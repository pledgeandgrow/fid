// Driver goals TG5 and MI11 (docs/roadmap/llvm-roadmap.md): the input of
// `fid disasm` and `fid dump-mir` in scripts/driver-goals-check.sh, which
// runs, for x86_64-linux, aarch64-linux and riscv64-linux,
//   fid disasm test_driver_disasm.fd --target <t> --fn mix
//     (the instructions of `mix`: a multiply, a compare and branch, a
//     shift, a return; no `.word`/`.byte` lines in it)
//   fid dump-mir test_driver_disasm.fd --target <t> --fn mix
//     (`[mir] mix: N operations` on stderr, no image written)
// and scripts/disasm-check.sh, which compares `fid disasm` with
// llvm-objdump on the same image. On any backend it is an ordinary program.
// Expected output:
// 27
// -40
// 1
// 255

fn mix(a: i64, b: i64) -> i64 {
    var r: i64 = a * b;
    if r > 20 {
        r = r + (a << 1);
    } else {
        r = r - (b >> 1);
    }
    return r;
}

fn neg_sum(a: i64, b: i64) -> i64 {
    return 0 - (a + b);
}

fn flag(x: i64) -> i64 {
    if x == 7 {
        return 1;
    }
    return 0;
}

fn main() -> i64 {
    println(mix(3, 7));
    println(neg_sum(15, 25));
    println(flag(7));
    println((1 << 8) - 1);
    return 0;
}
