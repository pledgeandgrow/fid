// expect-error: Serverless error: @serverless handler 'handle_request' writes the global 'HITS' (in 'count_hit')
// Roadmap Phase 9 (F32): module state does not reliably survive between
// serverless invocations (instances are recycled, frozen or run in
// parallel), so a handler must not write a global.

var HITS: i64 = 0;

fn count_hit() -> i64 {
    HITS = HITS + 1;
    return HITS;
}

@serverless
fn handle_request(path: str) -> str {
    return path + " " + int_to_str(count_hit());
}

fn main() {
    println(handle_request("/a"));
}
