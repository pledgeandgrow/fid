// VF5, PEIR_XMM_RA (compiler/pe_ir.fd): f64 values and locals in xmm
// registers. Eighteen f64 locals live at once, more than the xmm registers
// the allocator hands out, so some stay in memory and some move; calls
// that take and return four f64 arguments sit between their definitions
// and uses; f64 values are converted to integers and compared. Every value
// is a multiple of 0.5, so the arithmetic is exact and the sums are the
// same on every backend.
//
// Expected output:
// 33744
// 99
// 12840
// 13

fn mix(a: f64, b: f64, c: f64, d: f64) -> f64 {
    return a * 1.0 + b * 2.0 + c * 3.0 + d * 4.0;
}

fn main() -> i64 {
    var f1: f64 = 1.0;
    var f2: f64 = 2.0;
    var f3: f64 = 3.0;
    var f4: f64 = 4.0;
    var f5: f64 = 5.0;
    var f6: f64 = 6.0;
    var f7: f64 = 7.0;
    var f8: f64 = 8.0;
    var f9: f64 = 9.0;
    var f10: f64 = 10.0;
    var f11: f64 = 11.0;
    var f12: f64 = 12.0;
    var f13: f64 = 13.0;
    var f14: f64 = 14.0;
    var f15: f64 = 15.0;
    var f16: f64 = 16.0;
    var f17: f64 = 17.0;
    var f18: f64 = 18.0;
    var acc: i64 = 0;
    var mixsum: f64 = 0.0;
    var r: i64 = 0;
    while r < 6 {
        val m: f64 = mix(f1, f2, f3, f4);
        f1 = f1 + 1.0 * 0.5;
        f2 = f2 + 2.0 * 0.5;
        f3 = f3 + 3.0 * 0.5;
        f4 = f4 + 4.0 * 0.5;
        f5 = f5 + 5.0 * 0.5;
        f6 = f6 + 6.0 * 0.5;
        f7 = f7 + 7.0 * 0.5;
        f8 = f8 + 8.0 * 0.5;
        f9 = f9 + 9.0 * 0.5;
        f10 = f10 + 10.0 * 0.5;
        f11 = f11 + 11.0 * 0.5;
        f12 = f12 + 12.0 * 0.5;
        f13 = f13 + 13.0 * 0.5;
        f14 = f14 + 14.0 * 0.5;
        f15 = f15 + 15.0 * 0.5;
        f16 = f16 + 16.0 * 0.5;
        f17 = f17 + 17.0 * 0.5;
        f18 = f18 + 18.0 * 0.5;
        acc = acc + ((f3 * 2.0) as i64);
        val m2: f64 = mix(f15, f16, f17, f18);
        mixsum = mixsum + m + m2;
        r = r + 1;
    }
    var tot: f64 = 0.0;
    tot = tot + f1 * 1.0;
    tot = tot + f2 * 2.0;
    tot = tot + f3 * 3.0;
    tot = tot + f4 * 4.0;
    tot = tot + f5 * 5.0;
    tot = tot + f6 * 6.0;
    tot = tot + f7 * 7.0;
    tot = tot + f8 * 8.0;
    tot = tot + f9 * 9.0;
    tot = tot + f10 * 10.0;
    tot = tot + f11 * 11.0;
    tot = tot + f12 * 12.0;
    tot = tot + f13 * 13.0;
    tot = tot + f14 * 14.0;
    tot = tot + f15 * 15.0;
    tot = tot + f16 * 16.0;
    tot = tot + f17 * 17.0;
    tot = tot + f18 * 18.0;
    println((tot * 4.0) as i64);
    println(acc);
    println((mixsum * 4.0) as i64);
    // how many ended above 20
    var above: i64 = 0;
    if f1 > 20.0 { above = above + 1; }
    if f2 > 20.0 { above = above + 1; }
    if f3 > 20.0 { above = above + 1; }
    if f4 > 20.0 { above = above + 1; }
    if f5 > 20.0 { above = above + 1; }
    if f6 > 20.0 { above = above + 1; }
    if f7 > 20.0 { above = above + 1; }
    if f8 > 20.0 { above = above + 1; }
    if f9 > 20.0 { above = above + 1; }
    if f10 > 20.0 { above = above + 1; }
    if f11 > 20.0 { above = above + 1; }
    if f12 > 20.0 { above = above + 1; }
    if f13 > 20.0 { above = above + 1; }
    if f14 > 20.0 { above = above + 1; }
    if f15 > 20.0 { above = above + 1; }
    if f16 > 20.0 { above = above + 1; }
    if f17 > 20.0 { above = above + 1; }
    if f18 > 20.0 { above = above + 1; }
    println(above);
    return 0;
}
