// expect-error: function 'url_decode' is ambiguous
// 2g.37: encoding and url both define url_decode, so each copy is renamed
// per module (encoding__url_decode, url__url_decode) and the bare name
// matches neither. The error says so and names the modules, instead of
// "undefined function 'url_decode'".
use encoding;
use url;

fn main() -> i64 {
    println(url_decode("a%20b"));
    return 0;
}
