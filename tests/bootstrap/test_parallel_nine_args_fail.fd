// expect-error: the `parallel` branch `w9(...)` passes 9 arguments; a function started as a thread or task takes at most 8
//! error: the `parallel` branch `w9(...)` passes 9 arguments
// Bugs roadmap BG159: a `parallel { }` branch that is one call starts that
// function on a thread by name, whose block keeps at most 8 arguments on
// every compiled backend: `fid run` printed 936, emit 536871428836, --nat
// garbage and C panicked. Now refused (TypeChecker_check_par_branch_arity).
fn w9(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> i64 {
    return a + b + c + d + e + f + g + h + i * 100;
}

fn main() -> i64 {
    var x: i64 = 0;
    var y: i64 = 0;
    parallel {
        | x = w9(1, 2, 3, 4, 5, 6, 7, 8, 9);
        | y = w9(0, 0, 0, 0, 0, 0, 0, 0, 0);
    }
    println(x + y);
    return 0;
}
