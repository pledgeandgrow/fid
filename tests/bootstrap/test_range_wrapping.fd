// BG5 (docs/roadmap/bugs-roadmap.md): the range analysis
// (compiler/checks.fd) assumed checked arithmetic in `@wrapping` code too:
// `s = s + c` with c >= 0 "never lowers s", so s stayed in [0, MAX], s % 10
// in [0, 9], and the bounds check of `v.set(s % 10, i)` on a Vec of 10 was
// removed. Here s wraps on the second step to -4354685564936845354, whose
// remainder is -4: the set must panic "Vec index out of bounds", not write
// before the buffer.
//
// Expected output:
// start
// 1
// -4
// Expected exit: 1

@wrapping fn scatter(n: i64) -> i64 {
    var v: Vec<i64> = Vec::filled(10, 0);
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n {
        s = s + 7046029254386353131;
        println(s % 10);
        v.set(s % 10, i);
        i = i + 1;
    }
    return v.get(1);
}

fn main() {
    println("start");
    println(scatter(4));
    println("not reached");
}
