// Bugs roadmap BG128: the payload of a generic enum constructor is checked
// against the expected type's arguments (a declared variable, return,
// parameter or field type, a Vec's element, the variable assigned), and a
// literal with no expected type has the arguments its payload gives. The
// well-typed uses below still compile and run.
//
// Expected output:
// 7
// 41
// bad
// 200
// hi
// 3
// 12
// 5
// 9
// 6
// none
// done

enum W<T> {
    V(T),
    N,
}

struct Holder {
    small: Option<u8>,
    name: Option<str>,
}

fn parse(n: i64) -> Result<i64, str> {
    if n < 0 {
        return Result::Err("bad");
    }
    return Result::Ok(n + 1);
}

fn first<T>(v: Vec<T>) -> Option<T> {
    if v.len() == 0 {
        return Option::None;
    }
    return Option::Some(v.get(0));
}

fn show(o: Option<str>) {
    match o {
        Option::Some(s) => {
            println(s);
        }
        Option::None => {
            println("none");
        }
    }
}

fn wrap(n: i64) -> W<i64> {
    return W::V(n * 2);
}

fn main() -> i64 {
    // a declared type: the literal 7 is an i64
    val a: Option<i64> = Option::Some(7);
    match a {
        Option::Some(x) => {
            println(x);
        }
        Option::None => {
        }
    }
    // the return type
    match parse(40) {
        Result::Ok(v) => {
            println(v);
        }
        Result::Err(e) => {
            println(e);
        }
    }
    match parse(-1) {
        Result::Ok(v) => {
            println(v);
        }
        Result::Err(e) => {
            println(e);
        }
    }
    // a narrower declared argument: 200 fits a u8
    val b: Option<u8> = Option::Some(200);
    match b {
        Option::Some(x) => {
            println(x as i64);
        }
        Option::None => {
        }
    }
    // a parameter
    show(Option::Some("hi"));
    // a generic function's result
    var nums: Vec<i64> = Vec::new();
    nums.push(3);
    match first(nums) {
        Option::Some(x) => {
            println(x);
        }
        Option::None => {
        }
    }
    // (a Vec<Option<str>> push is checked too, test_bg128_enum_push_fail.fd;
    // it is not run here: BG131)
    // a user generic enum
    val w: W<i64> = wrap(6);
    match w {
        W::V(n) => {
            println(n);
        }
        W::N => {
        }
    }
    // struct fields
    val h: Holder = Holder { small: Option::Some(5), name: Option::None };
    match h.small {
        Option::Some(x) => {
            println(x as i64);
        }
        Option::None => {
        }
    }
    // no expected type: Option<i64> from the payload, then assigned
    var c = Option::Some(4);
    c = Option::Some(9);
    val d: Option<i64> = c;
    match d {
        Option::Some(x) => {
            println(x);
        }
        Option::None => {
        }
    }
    var e: Option<i64> = Option::None;
    e = Option::Some(6);
    match e {
        Option::Some(x) => {
            println(x);
        }
        Option::None => {
        }
    }
    show(h.name);
    println("done");
    return 0;
}
