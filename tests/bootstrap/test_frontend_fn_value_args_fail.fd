// expect-error: function value 'f' parameter 1 expects 'i64', got 'str'
// Roadmap L6C: a call through a function value checks its argument types
// (before, only their number): a str given to a fn(i64) -> i64 is rejected.

fn apply(f: fn(i64) -> i64, x: str) -> i64 {
    return f(x);
}

fn double(x: i64) -> i64 {
    return x * 2;
}

fn main() -> i64 {
    println(int_to_str(apply(double, "21")));
    return 0;
}
