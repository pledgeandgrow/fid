// BG399 (docs/roadmap/bugs-roadmap.md): md_safe_url sees through what a
// browser's URL parser drops before it reads the scheme (WHATWG URL: every
// ASCII tab and newline, leading C0 controls and spaces), so
// "java<TAB>script:" and "\x01javascript:" become "#" like "javascript:".
// Ordinary links are unchanged.
//
// Expected output:
// <p><a href="#">a</a></p>
//
// <p><a href="#">b</a></p>
//
// #
// #
// #
// #
// #
// #
// https://example.com/a?b=c
// /docs/page
// mailto:x@example.com
// <p><a href="https://example.com">ok</a></p>
//
use markdown;

fn main() -> i64 {
    // the entry's triggers
    println(md_to_html("[a](java\tscript:alert(1))"));
    println(md_to_html("[b](" + byte_to_str(1) + "javascript:alert(1))"));
    // md_safe_url directly: newline, CR, tab, controls, case
    println(md_safe_url("java\nscript:alert(1)"));
    println(md_safe_url("java\rscript:alert(1)"));
    println(md_safe_url(" \t" + byte_to_str(31) + "JavaScript:alert(1)"));
    println(md_safe_url("vb\tscript:msgbox(1)"));
    println(md_safe_url("da\nta:text/html,x"));
    println(md_safe_url(byte_to_str(8) + "javascript:x"));
    // ordinary URLs stay as they are
    println(md_safe_url("https://example.com/a?b=c"));
    println(md_safe_url("/docs/page"));
    println(md_safe_url("mailto:x@example.com"));
    println(md_to_html("[ok](https://example.com)"));
    return 0;
}
