// Competitive roadmap OP23: the runtime's copy, compare, byte search and
// fill a word (or four) at a time where both addresses are equally
// aligned (stdlib/linux_runtime/base.fd pert_mem_copy, pert_bytes_eq,
// pert_str_equal, pert_mem_find_byte, pert_memset; sys.fd memmove and
// memcmp), a byte at a time at the ends. The cases put the compared and
// copied bytes at every offset 0..8 and lengths around the word sizes, so
// the head, the 32-byte loop, the word loop and the tail each run; the
// results must be the same as byte-wise ones on every backend.
// Expected output:
// find 0 true true 9
// find 1 true true 10
// find 2 true true 11
// find 3 true true 12
// find 4 true true 13
// find 5 true true 14
// find 6 true true 15
// find 7 true true 16
// find 8 true true 17
// eq 0 true false
// eq 1 true false
// eq 7 true false
// eq 8 true false
// eq 9 true false
// eq 31 true false
// eq 32 true false
// eq 33 true false
// eq 65 true false
// copy 71 abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrs
// slice 3 40 defghijklmnopqrstuvwxyzabcdefghijklmn
// slice 5 6 f
// replace xx-defghijklmnopqrstuvwxyz-xx
// split 4 abc|defghijklmnop|qrstuvwxyzabcdefghij|klm
// vec 37 19 816
// byte 3 -1 0

fn b2s(b: bool) -> str {
    if b {
        return "true";
    }
    return "false";
}

fn text(n: i64) -> str {
    var s: str = "";
    var i: i64 = 0;
    while i < n {
        s = s + str_slice("abcdefghijklmnopqrstuvwxyz", i % 26, i % 26 + 1);
        i = i + 1;
    }
    return s;
}

fn main() {
    // A needle at every offset of the haystack (p_bytes_eq at s + i)
    var off: i64 = 0;
    while off <= 8 {
        val hay: str = str_repeat("-", off) + "abcdefghijklmnopqrstuvwxyz0123456789";
        val pos: i64 = String::from(hay).find("jklmnopqrstuvwxyz0123");
        val sw: bool = String::from(hay).ends_with("z0123456789");
        val st: bool = String::from(hay).starts_with(str_repeat("-", off) + "abcdefghijk");
        println("find " + int_to_str(off) + " " + b2s(sw) + " " + b2s(st) + " " + int_to_str(pos));
        off = off + 1;
    }
    // Equal and unequal strings of lengths around 8 and 32 (last byte differs)
    var lens: Vec<i64> = Vec::new();
    lens.push(0);
    lens.push(1);
    lens.push(7);
    lens.push(8);
    lens.push(9);
    lens.push(31);
    lens.push(32);
    lens.push(33);
    lens.push(65);
    var li: i64 = 0;
    while li < lens.len() {
        val n: i64 = lens.get(li);
        val a: str = text(n) + "!";
        val b: str = text(n) + "!";
        val c: str = text(n) + "?";
        println("eq " + int_to_str(n) + " " + b2s(a == b) + " " + b2s(a == c));
        li = li + 1;
    }
    val t: str = text(71);
    val t2: str = t + "";
    println("copy " + int_to_str(str_len(t2)) + " " + t2);
    println("slice 3 40 " + str_slice(t, 3, 40));
    println("slice 5 6 " + str_slice(t, 5, 6));
    println("replace " + str_replace("abc-defghijklmnopqrstuvwxyz-abc", "abc", "xx"));
    val parts: Vec<str> = str_split("abc,defghijklmnop,qrstuvwxyzabcdefghij,klm", ",");
    var joined: str = "";
    var pi: i64 = 0;
    while pi < parts.len() {
        if pi > 0 {
            joined = joined + "|";
        }
        joined = joined + parts.get(pi);
        pi = pi + 1;
    }
    println("split " + int_to_str(parts.len()) + " " + joined);
    // A Vec copied whole (its buffer through the runtime's copy)
    var v: Vec<i64> = Vec::new();
    var k: i64 = 0;
    while k < 37 {
        v.push(k * 37 % 101);
        k = k + 1;
    }
    var w: Vec<i64> = v.clone();
    var sum: i64 = 0;
    k = 0;
    while k < w.len() {
        sum = sum + w.get(k);
        k = k + 1;
    }
    println("vec " + int_to_str(w.len()) + " " + int_to_str(w.get(36)) + " " + int_to_str(sum % 1000));
    // A byte far into a string, one that is not there, the first one
    val big: str = text(50);
    println("byte " + int_to_str(String::from(big).find("d")) + " " + int_to_str(String::from(big).find("#")) + " " + int_to_str(String::from(big).find("a")));
}
