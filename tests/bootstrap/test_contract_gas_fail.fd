// expect-error: Contract error: @contract 'pay' has no gas limit
// Roadmap Phase 9 (blockchain): a contract's cost is bounded before it
// runs, so a @contract entry point has @gas(N).
@contract
@deterministic
fn pay(balance: i64, amount: i64) -> i64 {
    return balance - amount;
}

fn main() -> i64 {
    println(pay(10, 3));
    return 0;
}
