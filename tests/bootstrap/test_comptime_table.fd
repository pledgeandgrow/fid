// Test (competitive roadmap OP28): comptime builds whole tables. A Vec a
// comptime fn fills is computed by the compiler and the program only gets
// its entries; `while` loops and constants are evaluated too.
//
// Expected output:
// 256 0 1996959894 755167117
// 10 10
// 9 81 81
comptime fn crc_entry(n: i64) -> i64 {
    var c: i64 = n;
    var k: i64 = 0;
    while k < 8 {
        if (c & 1) != 0 { c = 0xEDB88320 ^ (c >> 1); } else { c = c >> 1; }
        k = k + 1;
    }
    return c;
}

comptime fn crc_table() -> Vec<i64> {
    var t: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 256 {
        t.push(crc_entry(i));
        i = i + 1;
    }
    return t;
}

comptime fn wsum(n: i64) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < n { s = s + i; i = i + 1; }
    return s;
}

comptime fn squares(n: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new();
    for i in 1..n { v.push(i * i); }
    return v;
}

const TEN: i64 = comptime wsum(5);

fn main() -> i64 {
    val t: Vec<i64> = comptime crc_table();
    println(int_to_str(t.len()) + " " + int_to_str(t.get(0)) + " " + int_to_str(t.get(1)) + " " + int_to_str(t.get(255)));
    println(int_to_str(TEN) + " " + int_to_str(comptime wsum(5)));
    val sq: Vec<i64> = comptime squares(10);
    println(int_to_str(sq.get(2)) + " " + int_to_str(sq.get(2) * sq.get(2)) + " " + int_to_str(sq.get(8)));
    return 0;
}
