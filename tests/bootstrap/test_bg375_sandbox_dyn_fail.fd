// expect-error: Sandbox error: '.t()' on dyn T has effect '!IO'
// Bugs roadmap BG375: `sandbox { }` let IO through a `dyn Trait` method
// call: a compiled program printed inside the sandbox (only `fid run`
// stopped it at run time).
cap T {
    fn t(self) -> i64;
}
struct A { a: i64 }
impl T for A {
    fn t(self: A) -> i64 {
        println(5);
        return 1;
    }
}
fn main() {
    val a = A { a: 1 };
    val d = a as dyn T;
    sandbox {
        val r = d.t();
    }
}
