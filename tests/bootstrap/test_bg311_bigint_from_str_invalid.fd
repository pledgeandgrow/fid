// BG311 (docs/roadmap/bugs-roadmap.md): bigint_from_str returns 0 for
// invalid input, as its doc says (it skipped non-digit characters, so
// "12a34" became 1234 and "1e9" became 19). An optional sign and blanks
// around the number are still accepted.
//
// Expected output:
// 0
// 0
// 0
// 0
// 0
// 0
// 0
// 0
// 123456789012345678901234567890
// -1000000000000
// 42
// 7
// 0
use bigint;

fn main() -> i64 {
    // the entry's trigger and the other examples it names
    println(bigint_to_str(bigint_from_str("12a34")));
    println(bigint_to_str(bigint_from_str("1e9")));
    println(bigint_to_str(bigint_from_str("1,000")));
    // more malformed input
    println(bigint_to_str(bigint_from_str("-")));
    println(bigint_to_str(bigint_from_str("--5")));
    println(bigint_to_str(bigint_from_str("1 2")));
    println(bigint_to_str(bigint_from_str("12.5")));
    println(bigint_to_str(bigint_from_str("")));
    // well-formed input
    println(bigint_to_str(bigint_from_str("123456789012345678901234567890")));
    println(bigint_to_str(bigint_from_str("-1000000000000")));
    println(bigint_to_str(bigint_from_str("+42")));
    println(bigint_to_str(bigint_from_str("  7  ")));
    println(bigint_to_str(bigint_from_str("-0")));
    return 0;
}
