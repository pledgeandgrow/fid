// expect-error: 'tick' runs on another thread and writes the global 'clock' with no lock
// Bugs roadmap BG25: `G.n = G.n + 1` on a global struct was no write of
// the global for the race check (only `G = v` and `G[i] = v` were).
struct Clock {
    n: i64,
}

var clock: Clock = Clock { n: 0 };

fn tick() -> i64 {
    clock.n = clock.n + 1;
    return 0;
}

fn main() -> i64 {
    val a = spawn tick();
    val b = spawn tick();
    await a;
    await b;
    println(int_to_str(clock.n));
    return 0;
}
