// BG43 (docs/roadmap/bugs-roadmap.md): the mid-end's inliner
// (compiler/iropt.fd iro_inline_function) put the caller's argument in
// place of the callee's parameter as it was: an I64 literal passed to a
// `u64` parameter made the inlined body's compare and division signed
// (they take their operands' type), so u64::MAX > i64::MAX was false.
// Now an argument of another type of the same width goes through a
// BitCast to the parameter's type. The C path and `run` do not inline.
//
// Expected output:
// true
// false
// true
// 9223372036854775807
// 2

fn above_half(x: u64) -> bool {
    return x > 9223372036854775807;
}

fn halve(x: u64) -> u64 {
    return x / 2;
}

fn top_bit(x: u64) -> u64 {
    return x >> 62;
}

fn main() -> i64 {
    println(above_half(18446744073709551615));
    println(above_half(5));
    println(above_half(9223372036854775808));
    val h: u64 = halve(18446744073709551614);
    println(h);
    val t: u64 = top_bit(9223372036854775808);
    println(t);
    return 0;
}
