// expect-error: has dimension m kg s^-1, and no unit declares it
// CL10 (fid): a product of units whose dimension no unit declares is a
// type error that names the dimension and the annotation to write.

@dimension(s = 1)
struct Time {
    value: f64,
}

@dimension(m = 1, kg = 1, s = -2)
struct Force {
    value: f64,
}

fn main() -> i64 {
    val f: Force = Force { value: 10.0 };
    val t: Time = Time { value: 2.0 };
    val p: f64 = (f * t).value;
    println(int_to_str(p as i64));
    return 0;
}
