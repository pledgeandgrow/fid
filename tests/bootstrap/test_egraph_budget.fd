fn b2i(b: bool) -> i64 {
    if b {
        return 1;
    }
    return 0;
}

fn chain_checked(x: i64, y: i64) -> i64 {
    var t: i64 = 0;
    t = t + (x + 0) * 1 + (y - y) + (x | 0) + (y ^ 0) + b2i(!(!(x < y))) + (x * 2);
