// x - x and x ^ x are 0 only after a round joins their classes; w's
// constant is then read from the root of z's class
fn via_union(x: i64) -> i64 {
    var z: i64 = x - x;
    var w: i64 = z + 5;
    var v: i64 = w * 3;
    return v + (x ^ x);
}

// (x + 3) + 4 is x + 7 in wrapping code; a chain of them
@wrapping
fn reassoc(x: i64) -> i64 {
    var a: i64 = (x + 3) + 4;
    var b: i64 = (a + 1) + 2;
    return (b + 0) + 0;
}

// x * 1.0, x / 1.0, x - 0.0 and -(-x) are x for every float
fn float_ids(f: f64) -> i64 {
    var g: f64 = ((f * 1.0) / 1.0) - 0.0;
    var h: f64 = -(-g);
    return h as i64;
}

fn small(x: i64) -> i64 {
    return ~(~x) + (x * 0);
}

fn main() -> i64 {
    print(chain_wrapping(7, 11));
    print("\n");
    print(chain_checked(7, 11));
    print("\n");
    print(via_union(9));
    print("\n");
    print(reassoc(19));
    print("\n");
    print(float_ids(9.0));
    print("\n");
    print(small(3));
    print("\n");
    return 0;
}
