// BG281 (docs/roadmap/bugs-roadmap.md): regex_split with a pattern that can
// match the empty string keeps every byte of the input, as Python's re.split
// (3.7+): an empty match splits the text, the byte at that position starts
// the next piece, and an empty match right after another empty match at the
// same place does not count.
//
// Expected output:
// 5 [] [a] [b] [c] []
// 5 [] [one] [ ] [two] []
// 7 [] [a] [b] [] [c] [d] []
// 4 [a] [b] [] [c]
// 2 [] []
// 3 [a] [b] []
// 4 [] [a] [b] []
// 5 [] [a] [] [b] []
use regex;

fn show(parts: Vec<str>) {
    var line: str = f"{parts.len()}";
    var i: i64 = 0;
    while i < parts.len() {
        line = line + " [" + parts.get(i) + "]";
        i = i + 1;
    }
    println(line);
}

fn main() -> i64 {
    // the entry's triggers
    show(regex_split("abc", "x*"));
    show(regex_split("one two", "\\b"));
    show(regex_split("ab1cd", "\\d*"));
    // a pattern that never matches empty is unchanged
    show(regex_split("a, b,,c", ",\\s*"));
    // edge cases (Python re.split)
    show(regex_split("", "x*"));
    show(regex_split("a-b-", "-"));
    show(regex_split("ab", ""));
    show(regex_split("a b", "\\s*"));
    return 0;
}
