// expect-error: returns str; the trait's method returns i64
// LG4: an impl method's signature must match the trait's (parameter count,
// parameter types and return type, wherever the trait writes a concrete type).
cap Shape {
    fn area(self) -> i64;
}

struct Sq { s: i64 }

impl Shape for Sq {
    fn area(self) -> str { return "x"; }
}

fn main() -> i64 { return 0; }
