// Bugs roadmap BG292/BG293: helper module of test_bg292_*.fd and
// test_bg293_*.fd. Pt is pub with a private field y; Priv, PrivE,
// PrivAlias and the method Pt.hid have no `pub`.
module vmod;

pub struct Pt {
    pub x: i64,
    y: i64,
}

pub fn mk() -> Pt {
    return Pt { x: 1, y: 2 };
}

struct Priv {
    pub a: i64,
}

enum PrivE {
    One,
    Two(i64),
}

type PrivAlias = i64;

impl Pt {
    fn hid(self) -> i64 {
        return self.y;
    }

    pub fn shown(self) -> i64 {
        return self.y + 10;
    }
}
