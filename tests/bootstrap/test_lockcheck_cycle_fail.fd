// CA4 (complaint-roadmap): lock-order analysis — the opposite order is a
// deadlock. Path 1 takes a then b; path 2 takes b then a. The lock graph
// has edges a->b and b->a, a cycle; `fid check` reports the error.
// `fid run` never reaches here (this is an expected-fail test: the
// compile-time check rejects it).
//
// Expected: rejected by `fid check` with "lock-order cycle"

use sync;

fn path_one(a: i64, b: i64) {
    sync_mutex_lock(a);
    sync_mutex_lock(b);
    sync_mutex_unlock(b);
    sync_mutex_unlock(a);
}

fn path_two(a: i64, b: i64) {
    sync_mutex_lock(b);
    sync_mutex_lock(a);
    sync_mutex_unlock(a);
    sync_mutex_unlock(b);
}

fn main() -> i64 {
    var a: i64 = sync_mutex_create();
    var b: i64 = sync_mutex_create();
    path_one(a, b);
    path_two(a, b);
    println("unreachable");
    return 0;
}
