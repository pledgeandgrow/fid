// expect-error: is a variant of enum 'Result', but the value matched is a 'str', which is no enum
// Bugs roadmap BG489 (the same hole as BG393): an enum-variant pattern
// against a str checked clean and crashed at run time; the BG129 guard
// fired only when the scrutinee was a known enum.
fn main() -> i64 {
    val s: str = "hello";
    match s {
        Result::Ok(v: i64) => {
            println(v);
            return v;
        }
        _ => {
            return 0;
        }
    }
}
