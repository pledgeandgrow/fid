// CA8: `timeout` is a contextual word: only `timeout( .. ) {` starts a
// timeout block. A function, a variable or a field named timeout keeps
// working, and a statement that is a call of it stays a call.
//
// Expected output:
// 4
// 7
// 12
use string;

struct Conn {
    timeout: i64,
}

fn timeout(ms: i64) -> i64 {
    println(int_to_str(ms + 1));
    return ms + 1;
}

fn main() -> i64 {
    timeout(3);
    val t: i64 = timeout(6) - 1;
    val c: Conn = Conn { timeout: t + 5 };
    val timeout_ms: i64 = c.timeout + 1;
    println(int_to_str(timeout_ms));
    return 0;
}
