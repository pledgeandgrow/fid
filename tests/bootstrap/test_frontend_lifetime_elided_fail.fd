// expect-error: cannot mutate z: shared borrow(s) are active
// LG3: a function without lifetimes whose result is a reference borrows
// from its reference parameters: `o` borrows `z`, so changing `z` while
// `o` is still used is an error (only functions with lifetimes were
// tracked by the borrow checker before).
fn only(p: &i64) -> &i64 {
    return p;
}

fn main() -> i64 {
    var z: i64 = 8;
    val o = only(&z);
    z = 3;
    println(*o);
    return 0;
}
