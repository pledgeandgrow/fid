// Bugs roadmap BG1: `name[i] = v` is checked now (the target is a Vec or
// an array, the index an integer, the value fits the element type); these
// index assignments stay accepted: a Vec of numbers and of strings, a
// fixed-size array, a compound assignment, a Vec reached through a `&mut`
// parameter and a narrower element type.
// Expected output:
// 10 22 3
// x b
// 7 2 9
// 5 6
// 200
fn set_first(v: &mut Vec<i64>, x: i64) {
    v[0] = x;
}

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    v[0] = 10;
    v[1] += 20;
    println(int_to_str(v[0]) + " " + int_to_str(v[1]) + " " + int_to_str(v[2]));
    var s: Vec<str> = Vec::new();
    s.push("a");
    s.push("b");
    s[0] = "x";
    println(s[0] + " " + s[1]);
    var a: [i64; 3] = [1, 2, 3];
    a[0] = 7;
    a[2] *= 3;
    println(int_to_str(a[0]) + " " + int_to_str(a[1]) + " " + int_to_str(a[2]));
    var w: Vec<i64> = Vec::new();
    w.push(0);
    w.push(6);
    set_first(&mut w, 5);
    println(int_to_str(w[0]) + " " + int_to_str(w[1]));
    var b: Vec<u8> = Vec::new();
    b.push(1 as u8);
    val k: i64 = 199;
    b[0] = (k + 1) as u8;
    println(int_to_str(b[0] as i64));
    return 0;
}
