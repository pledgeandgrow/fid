pub struct Small {
    pub a: i64,
    pub b: i64,
    pub c: i64,
}

pub enum OptSmall {
    Some(Small),
    None,
}

pub fn make_some(s: Small) -> OptSmall {
    return OptSmall::Some(s);
}

pub fn extract(opt: OptSmall) -> i64 {
    match opt {
        OptSmall::Some(s) => {
            return s.a + s.b + s.c;
        }
        OptSmall::None => {
            return 0;
        }
    }
}

fn main() {
    var s: Small = Small { a: 1, b: 2, c: 3 };
    var opt: OptSmall = make_some(s);
    var result: i64 = extract(opt);
    print(result);
}
