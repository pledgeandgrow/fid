// stdlib/ecs: entity ids and counts, spawn helpers, and the queries on a
// world that has no component data. Component lookups through the
// wrappers (ecs_has, ecs_count_with_component, ecs_query_entities after
// ecs_add) are not covered: in the interpreter the wrapper functions never
// see the components (a `str` parameter is passed on to __ecs_has as a
// pointer, which the builtin does not accept), while the C and native
// backends find them. ecs_destroy_entity and ecs_reset are not implemented
// by any backend and panic.
use ecs;

component Position { x: f64, y: f64 }
component Health { hp: i64 }

fn hook() {
    println("hook");
}

fn main() -> i64 {
    println(ecs_entity_count());
    var a = ecs_create_entity();
    var b = ecs_create_entity();
    println(a);
    println(b);
    println(ecs_entity_count());

    // an entity with no components
    println(ecs_has("Position", a));
    println(ecs_has("Health", b));
    println(ecs_count_with_component("Position"));
    println(ecs_query_entities("[\"Position\"]").len());
    println(ecs_query_entities("[\"Position\",\"Health\"]").len());

    // an empty component list matches every entity
    var all = ecs_query_entities("[]");
    println(all.len());
    println(all.get(0));
    println(all.get(1));

    // spawn helpers make new entities and return their ids
    var s1 = ecs_spawn("Health", Health { hp: 5 });
    var s2 = ecs_spawn2("Position", Position { x: 1.0, y: 2.0 }, "Health", Health { hp: 9 });
    var s3 = ecs_spawn3("Position", Position { x: 0.0, y: 0.0 }, "Health", Health { hp: 1 }, "Position", Position { x: 3.0, y: 4.0 });
    println(s1);
    println(s2);
    println(s3);
    println(ecs_entity_count());

    // placeholders that must be callable
    ecs_register_component("Position");
    ecs_register_system("hook", hook);
    ecs_run_systems();
    ecs_frame();
    ecs_dispatch_event("on_nothing");
    println(ecs_entity_count());
    return 0;
}
