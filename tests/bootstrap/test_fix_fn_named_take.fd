// Test (stdlib-agent bug 32): a program's function named like a method of
// an imported module (`take`; stdlib/vec.fd has `Vec.take`) has its own
// result type. The lowering looked up the method's (Vec<i64>) for a call
// `take(b)`, dropped the result as a Vec and freed what the caller's
// struct held ("Invalid free" / "Double free").
// Expected output:
// x3! 2
// x3 2
use vec;

struct Bag { name: str, items: Vec<i64> }

fn take(b: Bag) -> Bag { return Bag { name: b.name + "!", items: b.items }; }

fn main() {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    val b: Bag = Bag { name: "x" + int_to_str(3), items: v };
    val c: Bag = take(b);
    println(c.name + " " + int_to_str(c.items.len()));
    println(b.name + " " + int_to_str(b.items.len()));
}
