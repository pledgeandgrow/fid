// A word keyword may name a function (docs/reference/reference.md §1.4):
// `handle(x)` calls it in an expression and as a statement; `handle {`
// still starts an effect handler. Before, the parser read `handle` alone
// and left `("a")` as the next statement ('cannot assign fn(str) -> str').
// Expected output:
// a!
// c!
// b!
// 3

var g_last: str = "";

fn handle(x: str) -> str {
    g_last = x + "!";
    return x + "!";
}

fn main() {
    val r: str = handle("a");
    println(r);
    var s: str = "";
    s = handle("c");
    println(s);
    handle("b");
    println(g_last);
    println(str_len(handle("ab")));
}
