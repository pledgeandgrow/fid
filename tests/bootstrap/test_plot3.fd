use plot;
use vec;

fn main() -> i64 {
    // Test plot_header indirectly via a simple path
    var xs = Vec::new();
    var ys = Vec::new();
    xs.push(0.0);
    ys.push(1.0);

    print("about to call plot_line");
    var svg = plot_line(xs, ys, "T", "x", "y");
    print("called plot_line");
    print(svg);

    return 0;
}
