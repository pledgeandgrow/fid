// BG223 (docs/roadmap/bugs-roadmap.md): url_resolve keeps the authority it
// resolves against (userinfo, IPv6 brackets), and a path keeps its percent
// escapes: Url.path is the path as written, so %2F stays data in a segment
// and a round trip through url_to_str gives the same URL.
//
// Expected output:
// http://[::1]:8080/a/c
// http://user:pw@a.com/b/d
// http://h/a%2Fb/c
// http://h/a%2Fb/c
// /files/..%2F..%2Fetc%2Fpasswd
// http://h/files/..%2F..%2Fetc%2Fpasswd
// http://[::1]:8080/x
// http://user:pw@a.com:443/x
// http://u@[ff02::1]:9/x?q#f
// http://g
// http://g/x
// http://g/x?q
// http://a/b/c/g
// /a b/c
// http://h/a/my%20file
// http://h/docs/my%20file.txt
// /100%25
// /a%2Fb/c%20d
// 100%
use url;

fn main() -> i64 {
    // the entry's triggers
    println(url_resolve(url_parse("http://[::1]:8080/a/b"), "c"));
    println(url_resolve(url_parse("http://user:pw@a.com/b/c"), "d"));
    println(url_to_str(url_parse("http://h/a%2Fb/c")));
    println(url_resolve(url_parse("http://h/a%2Fb/c"), "c"));
    var trav: Url = url_parse("http://h/files/..%2F..%2Fetc%2Fpasswd");
    println(trav.path);
    println(url_to_str(trav));
    // the authority of either side, in both branches
    println(url_resolve(url_parse("http://[::1]:8080/a/b"), "/x"));
    println(url_resolve(url_parse("http://user:pw@a.com:443/b/c"), "/x"));
    println(url_resolve(url_parse("http://a/b"), "//u@[ff02::1]:9/x?q#f"));
    // a reference that writes no path (RFC 3986 section 5.3)
    println(url_resolve(url_parse("http://a/b/c"), "//g"));
    println(url_resolve(url_parse("http://a/b/c"), "//g/x"));
    println(url_resolve(url_parse("http://a/b/c"), "//g/x?q"));
    // RFC 3986 section 5.4 still holds
    println(url_resolve(url_parse("http://a/b/c/d;p?q"), "g"));
    // the decoded form is one call away
    var spaced: Url = url_parse("http://h/a%20b/c");
    println(url_decode(spaced.path));
    println(url_resolve(url_parse("http://h/a/b"), "my%20file"));
    // a path set by hand is still encoded, and a lone "%" too
    var u: Url = url_parse("http://h/");
    u.path = "/docs/my file.txt";
    println(url_to_str(u));
    println(url_path_escape("/100%"));
    println(url_path_escape("/a%2Fb/c d"));
    println(url_decode("/100%25"));
    return 0;
}
