// expect-error: is a variant of enum 'Option', but the value matched is a 'str', which is no enum
// Bugs roadmap BG393: `match s { Option::Some(y) => .. }` with s a str read
// the string's word as an enum tag and crashed ("Invalid memory access").
fn main() {
    val s: str = "hi";
    match s {
        Option::Some(y) => {
            println("s");
        }
        Option::None => {
            println("n");
        }
    }
}
