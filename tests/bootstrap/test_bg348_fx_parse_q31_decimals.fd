// Bugs roadmap BG348: stdlib/fixed_point.fd fx_parse kept up to 11
// decimals and computed `num << frac`: at frac 31 an 11-digit fraction
// passed 2^63 and wrapped, so fx_parse("0.12345678901", 31) was 80653995.
// The fraction is now num * 2^frac / 10^digits by long division, rounded
// to nearest (values computed exactly with Python fractions).
//
// Expected output:
// 265121436 265121436 265121436
// -811008 49152
// 0 262144

use fixed_point;

fn main() {
    println(f"{fx_parse("0.12345678901", 31)} {fx_parse("0.123456789", 31)} {fx_parse("0.1234567890", 31)}");
    println(f"{fx_parse("-12.375", 16)} {fx_parse("1.5", 15)}");
    println(f"{fx_parse("0.00000000001", 31)} {fx_parse("3.99999999999", 16)}");
}
