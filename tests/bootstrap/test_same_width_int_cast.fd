// BG38 (docs/roadmap/bugs-roadmap.md): a cast between a signed and an
// unsigned integer type of the same width reinterprets the bits. Under
// `fid run` the interpreter kept the unsigned value (`200u8 as i8` stayed
// 200, and the `+ 1` after it reported an overflow); compiled code gave -56.
// Every backend prints the same.
//
// Expected output:
// -56
// -55
// 200
// -1
// 65535
// -2147483648
// 4294967295
fn main() -> i64 {
    val a: u8 = 200;
    val b: i8 = a as i8;
    println(int_to_str(b as i64));
    val c: i8 = b + 1;
    println(int_to_str(c as i64));
    val d: u8 = b as u8;
    println(int_to_str(d as i64));
    val e: u16 = 65535;
    val f: i16 = e as i16;
    println(int_to_str(f as i64));
    println(int_to_str((f as u16) as i64));
    val g: u32 = 2147483648;
    val h: i32 = g as i32;
    println(int_to_str(h as i64));
    val m: i32 = 0 - 1;
    println(int_to_str((m as u32) as i64));
    return 0;
}
