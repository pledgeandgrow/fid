// competitive-roadmap PL2/PL3: `@cfg` picks one variant on every tier-1 and
// tier-2 platform. Each function below exists once per OS or architecture;
// a target none of them names leaves the function undefined and the
// program does not build. The C lanes of scripts/tier1.sh and
// scripts/tier2.sh build it for Windows x64/ARM64, Linux x64/ARM64/RISC-V,
// macOS ARM64/x64 and FreeBSD x64, and the interpreter runs the host's
// variant. What it prints does not depend on the platform, so every lane
// agrees with `fid run`. (Until compiler.fd check_cfg knows `freebsd`, the
// condition holds everywhere and the FreeBSD variant is a second
// definition that the first one wins over; on FreeBSD it is the only one.)
// Expected output:
// os: ok
// arch: ok
// path separator: ok

@cfg(linux)
fn os_name() -> str {
    return "linux";
}

@cfg(windows)
fn os_name() -> str {
    return "windows";
}

@cfg(macos)
fn os_name() -> str {
    return "macos";
}

@cfg(freebsd)
fn os_name() -> str {
    return "freebsd";
}

@cfg(x86_64)
fn word_bits() -> i64 {
    return 64;
}

@cfg(aarch64)
fn word_bits() -> i64 {
    return 64;
}

@cfg(riscv64)
fn word_bits() -> i64 {
    return 64;
}

@cfg(windows)
fn path_sep() -> str {
    return "\\";
}

@cfg(linux)
fn path_sep() -> str {
    return "/";
}

@cfg(macos)
fn path_sep() -> str {
    return "/";
}

@cfg(freebsd)
fn path_sep() -> str {
    return "/";
}

fn main() {
    val os: str = os_name();
    if str_len(os) > 0 {
        println("os: ok");
    } else {
        println("os: none");
    }
    if word_bits() == 64 {
        println("arch: ok");
    } else {
        println("arch: wrong");
    }
    if str_len(path_sep()) == 1 {
        println("path separator: ok");
    } else {
        println("path separator: none");
    }
}
