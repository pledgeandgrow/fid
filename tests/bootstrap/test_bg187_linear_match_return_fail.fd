// expect-error: It is lost on the path through the `return`
// Bugs roadmap BG187: a `return` inside a match arm left the linear value
// unconsumed on that path; the arms' consumption is joined now, and the
// return checks what is still live.
@linear
struct Tok {
    v: i64,
}

fn use_tok(t: Tok) -> i64 {
    return t.v;
}

fn main() -> i64 {
    val t = Tok { v: 1 };
    val k: i64 = 3;
    match k {
        1 => {
            println(use_tok(t));
        }
        _ => {
            return 0;
        }
    }
    return 0;
}
