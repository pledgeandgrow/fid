// CL7: helper of test_frontend_trait_conflict_fail.fd and
// test_frontend_trait_override.fd. Library B implements Describe for Point
// as well, differently.
module shape_b;
use trait_conflict::shape_base;

impl Describe for Point {
    pub fn describe(self: Point) -> i64 {
        return 200 + self.x;
    }
}

pub fn b_marker() -> i64 {
    return 2;
}
