// A string's hash depends only on its content, wherever it sits: the same
// text at every offset across a page boundary hashes alike.
fn main() -> i64 {
    var buf: i64 = p_malloc(16384);
    var text: str = "abcdefghijklmnopqrst";
    var n: i64 = str_len(text);
    var first: i64 = 0;
    var off: i64 = 0;
    while off < 8200 {
        var i: i64 = 0;
        while i <= n {
            var p: *mut u8 = buf + off + i;
            var b: i64 = 0;
            if i < n { b = str_byte_at(text, i); }
            unsafe { *p = b; }
            i = i + 1;
        }
        var h: i64 = p_str_hash(buf + off);
        if off == 0 { first = h; }
        if h != first {
            print("hash changed at offset ");
            print(off);
            return 1;
        }
        off = off + 1;
    }
    print("ok");
    return 0;
}
