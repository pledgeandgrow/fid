// expect-error: function 'f' has @gas(20) but total gas cost is
// Bugs roadmap BG382: the same for a trait-impl method.
cap Work {
    fn heavy(self) -> i64;
}
struct S { a: i64 }
impl Work for S {
    fn heavy(self: S) -> i64 {
        var t: i64 = 0;
        for i in 0..1000 {
            t = t + i * i + i * 3 + 7;
        }
        return t;
    }
}
@gas(20)
fn f(s: S) -> i64 {
    return s.heavy();
}
fn main() {
    println(f(S { a: 1 }));
}
