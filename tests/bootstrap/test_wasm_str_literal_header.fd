// Bugs roadmap BG167: `fid wasm` wrote a string literal into the data
// segment as its bytes and a NUL with no [P_STR_STATIC][len] words in
// front (compiler/wasm.fd wg_str), unlike nat_ir, pe_ir and the C string
// table (AGENTS.md Known Bug 25). Core's strict Str_drop / Str_dup panic on
// a str without a string header, so the program stopped ("a str without a
// string header") as soon as ownership dropped or copied a literal: one a
// function returns, one str_repeat is given, a struct field or Vec element
// holding one. Every backend prints the same.
//
// Expected output:
// abc
// ababab
// <>
// cdcdcd
// bob 1
// 4
// x yz!
// 5
// done

struct P {
    name: str,
    n: i64,
}

fn f(n: i64) -> str {
    if n <= 0 {
        return "";
    }
    return "abc";
}

fn keep(p: P) -> i64 {
    return str_len(p.name) + p.n;
}

fn show() {
    val p = P { name: "bob", n: 1 };
    println(p.name + " " + int_to_str(p.n));
    println(int_to_str(keep(p)));
}

fn main() -> i64 {
    println(f(1));
    println(str_repeat("ab", 3));
    val e: str = f(0);
    println("<" + e + ">");
    println(str_repeat("cd", 3));
    show();
    var v: Vec<str> = Vec::new();
    v.push("x");
    v.push("yz");
    var s: str = v.get(1);
    s = s + "!";
    println(v.get(0) + " " + s);
    println(int_to_str(str_len("hello")));
    println("done");
    return 0;
}
