// expect-error: if condition must be bool, got P (the guard
// Bugs roadmap BG414: a match guard is a condition (reference §4.2, §5.4);
// before, a struct guard compiled and its arm silently never ran.
struct P {
    a: i64,
}

fn main() {
    val x: i64 = 3;
    val p = P { a: 0 };
    match x {
        3 if p => {
            println("struct guard");
        }
        _ => {
            println("o");
        }
    }
}
