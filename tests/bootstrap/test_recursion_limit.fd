// Test: Recursion depth limit (SH-1.4)
// This test verifies that the interpreter catches infinite/deep recursion
// with a clear error message instead of segfaulting.

fn recurse(n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    return recurse(n - 1);
}

fn main() -> i64 {
    // Normal recursion should work fine (well within default 1000 limit)
    val result = recurse(100);
    if result == 0 {
        print("OK\n");
    } else {
        print("FAIL\n");
    }

    return 0;
}
