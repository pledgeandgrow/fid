// Tasks really suspend: each yield hands over to the next task.
use task;

var log: Vec<i64> = Vec::new();

fn worker(n: i64) -> i64 {
    log.push(n);
    task_yield();
    log.push(n + 10);
    task_yield();
    log.push(n + 20);
    return 0;
}

fn main() -> i64 {
    task_go("worker", 1);
    task_go("worker", 2);
    task_run();
    var i: i64 = 0;
    while i < log.len() {
        println(log.get(i));
        i = i + 1;
    }
    if log.get(1) != 2 { p_panic("tasks did not interleave"); }
    return 0;
}
