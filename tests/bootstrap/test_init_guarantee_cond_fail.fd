// expect-error: Init error: variable 'x' is used before being assigned a value.
// Test: F63 — Init guarantee, conditional assignment (expected FAIL)
// If only one branch of an if/else assigns, the variable might be
// uninitialized after the branch. Reading it is a compile error.

fn main() -> i64 {
    var x: i64;
    val cond = 0;
    if cond > 0 {
        x = 42;
    }
    // ERROR: x might not be initialized (else branch doesn't assign)
    print(x);
    return 0;
}
