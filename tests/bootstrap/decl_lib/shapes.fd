// BG34: helper of test_import_component_decls.fd. A module whose
// declarations are desugared after the merge (compiler.fd desugar_phase8b):
// a component, which becomes a struct.
module shapes;

pub component Point {
    x: i64,
    y: i64,
}

pub fn point_at(x: i64, y: i64) -> Point {
    return Point { x: x, y: y };
}

pub fn point_sum(p: Point) -> i64 {
    return p.x + p.y;
}
