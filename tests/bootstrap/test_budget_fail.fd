// expect-error: region 'r' used 32 bytes but budget is 16 bytes (16 bytes over).
// Test: region budget exceeded (F3)
// 4 i64 variables = 32 bytes, budget = 16 → compile error

fn main() {
    region r with budget(16) {
        val a: i64 = 1;
        val b: i64 = 2;
        val c: i64 = 3;
        val d: i64 = 4;
    }
    return 0;
}
