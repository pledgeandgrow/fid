// An async function with f64 and struct arguments runs as a task (release
// H9): the arguments travel as words (f64 bits, a heap copy of the struct)
// through a generated adapter. Before, such a call ran to completion where
// it was made.

struct Point {
    x: i64,
    y: i64,
}

async fn scaled_sum(p: Point, f: f64) -> Future<i64> {
    val s: f64 = (p.x + p.y) as f64;
    return (s * f) as i64;
}

fn make_task(k: i64) -> Future<i64> {
    // the struct is a local of this function, gone when the task runs
    val q: Point = Point { x: k, y: k * 10 };
    return scaled_sum(q, 0.5);
}

fn main() {
    val p: Point = Point { x: 2, y: 3 };
    val t1 = scaled_sum(p, 2.5);
    val t2 = make_task(4);
    println(await t1);
    println(await t2);
}
