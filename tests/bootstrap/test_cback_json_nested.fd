// BG97 (docs/roadmap/bugs-roadmap.md): the C runtime's p_json_parse (and
// p_json_dump, which parses again) read a value that is an object or an
// array as if it were a number, up to the next `,`, `}` or blank:
// {"a": {"b": 1}} came out as {"a":"{\"b\":","b":1}, which is not JSON.
// Now (compiler/codegen_c.fd _json_skip_nested, BG97) a nested object is
// canonicalized as the outer one is (keys sorted, no blanks) and an array
// is kept as written, less its blanks.
// C runtime only: the interpreter and the native runtimes have JSON of
// their own.
//@ backends: ccompile
//
// Expected output:
// {"a":{"x":1,"y":2},"b":[1,2,{"c":3}],"n":5}
// {"a":{"x":1,"y":2},"b":[1,2,{"c":3}],"n":5}
// {"deep":{"in":{"s":"t"}},"z":true}

fn main() -> i64 {
    val text: str = "{\"n\": 5, \"a\": {\"y\": 2, \"x\": 1}, \"b\": [1, 2, {\"c\": 3}]}";
    val once: str = p_json_dump(p_json_parse(text));
    println(once);
    // canonical text parses to itself
    println(p_json_dump(p_json_parse(once)));
    println(p_json_dump(p_json_parse("{\"z\": true,\n \"deep\": {\"in\": {\"s\": \"t\"}}}")));
    return 0;
}
