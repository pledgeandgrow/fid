pub struct Pair {
    pub key: str,
    pub val: i64,
}

pub fn Pair_new(key: str, val: i64) -> Pair {
    return Pair { key: key, val: val };
}

pub fn get_key(p: Pair) -> str {
    return p.key;
}

fn main() {
    val p = Pair_new("hello", 42);
    val k = get_key(p);
    print(k);
    print("\n");
}
