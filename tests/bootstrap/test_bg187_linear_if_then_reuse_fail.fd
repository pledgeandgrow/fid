// expect-error: is consumed in some branches of this `if`
// Bugs roadmap BG187: `if c { use_tok(t); } use_tok(t);` consumed `t` twice
// on the path through the `if` and was accepted (a variable consumed in
// one branch only counted as not consumed).
@linear
struct Tok {
    v: i64,
}

fn use_tok(t: Tok) -> i64 {
    return t.v;
}

fn main() -> i64 {
    val t = Tok { v: 1 };
    val c: bool = str_len("a") < 3;
    if c {
        println(use_tok(t));
    }
    println(use_tok(t));
    return 0;
}
