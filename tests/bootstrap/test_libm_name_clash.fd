// B19: user functions named like a <math.h>/<stdlib.h> function (yn, j0 are
// libm's Bessel functions) compile through C: codegen_c.fd
// `cg_libc_clash` renames them, as sanitize_c_name did for sin, cos, ...
// Expected output:
// yn 7
// j0 10
// hypot 25
// trunc 3
// log2 6
// qsort 3
// done

fn yn(a: i64, b: i64) -> i64 {
    return a + b;
}

fn j0(x: i64) -> i64 {
    return x * 10;
}

fn hypot(a: i64, b: i64) -> i64 {
    return a * a + b * b;
}

fn trunc(x: i64) -> i64 {
    return x / 10;
}

fn log2(x: i64) -> i64 {
    var n: i64 = 0;
    var v: i64 = x;
    while v > 1 {
        v = v / 2;
        n = n + 1;
    }
    return n;
}

fn qsort(v: Vec<i64>) -> i64 {
    return v.len();
}

fn main() {
    println("yn " + int_to_str(yn(3, 4)));
    println("j0 " + int_to_str(j0(1)));
    println("hypot " + int_to_str(hypot(3, 4)));
    println("trunc " + int_to_str(trunc(35)));
    println("log2 " + int_to_str(log2(64)));
    var v: Vec<i64> = Vec::new();
    v.push(3);
    v.push(1);
    v.push(2);
    println("qsort " + int_to_str(qsort(v)));
    println("done");
}
