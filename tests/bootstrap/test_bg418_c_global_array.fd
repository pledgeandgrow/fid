// Bugs roadmap BG418: the C backend could not compile a global fixed array
// (`static int64_t[4] _g_GA = 0;`, then `_g_GA = 0;` in the global init);
// run, emit and --nat print 31.
//
// Expected output:
// 31
// 1 2 30 4
// 0 7
// -1 6
var GA: [i64; 4] = [1, 2, 3, 4];
var GB: [i64; 2] = [0, 0];
var GC: [i64; 2] = [-1, 2 * 3];
fn seta(i: i64, v: i64) {
    GA[i] = v;
}
fn main() {
    seta(2, 30);
    println(GA[0] + GA[2]);
    println(f"{GA[0]} {GA[1]} {GA[2]} {GA[3]}");
    GB[1] = 7;
    println(f"{GB[0]} {GB[1]}");
    println(f"{GC[0]} {GC[1]}");
}
