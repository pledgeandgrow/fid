// test_deterministic.fd — @deterministic function that should compile successfully.
// A deterministic function: same inputs → same outputs, always.
// No IO, no Net, no Spawn, no Diverge, no floating-point.

@deterministic
fn compound_interest(principal: i64, rate_bps: i64, days: i64) -> i64 {
    // Integer-only arithmetic — deterministic across all CPUs
    // interest = principal * rate_bps * days / (10000 * 365)
    return (principal * rate_bps * days) / (10000 * 365)
}

@deterministic
fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

@deterministic
fn sum_range(start: i64, end: i64) -> i64 {
    var total = 0
    var i = start
    while i < end {
        total = total + i
        i = i + 1
    }
    return total
}

fn main() {
    val interest = compound_interest(10000, 500, 365)
    println(interest)

    val fact = factorial(5)
    println(fact)

    val sum = sum_range(1, 10)
    println(sum)
}
