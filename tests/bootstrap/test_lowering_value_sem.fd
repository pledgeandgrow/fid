// LG1: Vec, HashMap and str are values (reference §8.1, proposal 0004).
// Assigning one, storing it in a struct or passing it by value gives an
// independent value: a write through one name never shows through another.
// Expected output:
// 1
// 2
// 1
// 1
// 3
// 1
// 2
// 1

struct Holder { v: Vec<i64> }

fn grow(v: Vec<i64>) -> i64 {
    var w = v;
    w.push(5);
    w.push(6);
    return w.len();
}

fn main() -> i64 {
    var a: Vec<i64> = Vec::new();
    a.push(1);
    var b = a;
    b.push(2);
    println(a.len());
    println(b.len());

    var m: HashMap<str, i64> = HashMap::new();
    m.insert("k", 1);
    var n = m;
    n.insert("k", 9);
    n.insert("j", 2);
    println(m.len());
    println(m.get_or("k", 0));

    println(grow(a));
    println(a.len());

    var h = Holder { v: a };
    var g = h;
    g.v.push(7);
    println(g.v.len());
    println(h.v.len());
    return 0;
}
