// BG255 (docs/roadmap/bugs-roadmap.md): `use quic;` did not compile, a
// @secret error in quic_updated_keys (the public AEAD id was read out of
// the secret keys and handed to a parameter a secret may not reach). The
// keys after a key update keep the header-protection key and take key and
// IV from the next secret.
//
// Expected output:
// true
// true
// true
// true
use core;
use quic;

@declassify
fn keep_client_secret(dcid: Vec<i64>) -> Vec<i64> {
    return quic_client_initial_secret(dcid);
}

@declassify
fn keep_next(secret: Vec<i64>) -> Vec<i64> {
    return quic_next_secret(secret);
}

@declassify
fn keep_initial(dcid: Vec<i64>, server: bool) -> QuicKeys {
    return quic_initial_keys(dcid, server);
}

@secret
fn updated(@secret old: QuicKeys, @secret next_secret: Vec<i64>) -> QuicKeys {
    return quic_updated_keys(old, next_secret, QUIC_AEAD_AES_128_GCM);
}

@declassify
fn keep_updated(old: QuicKeys, next_secret: Vec<i64>) -> QuicKeys {
    return updated(old, next_secret);
}

fn main() -> i64 {
    var dcid: Vec<i64> = Vec::new();
    dcid.push(0x83);
    dcid.push(0x94);
    dcid.push(0xc8);
    dcid.push(0xf0);
    dcid.push(0x3e);
    dcid.push(0x51);
    dcid.push(0x57);
    dcid.push(0x08);
    val old = keep_initial(dcid, false);
    val next_secret = keep_next(keep_client_secret(dcid));
    val upd = keep_updated(old, next_secret);
    println(upd.aead == QUIC_AEAD_AES_128_GCM);
    println(upd.hp.len() == 16 && upd.hp.get(0) == old.hp.get(0) && upd.hp.get(7) == old.hp.get(7) && upd.hp.get(15) == old.hp.get(15));
    println(upd.key.len() == 16 && upd.iv.len() == 12);
    println(upd.key.get(0) != old.key.get(0) || upd.key.get(1) != old.key.get(1));
    return 0;
}
