// A large frame below another large frame
fn both(x: i64) -> i64 {
    return big(x) + mid(x + 1);
}

fn main() -> i64 {
    println(big(1));
    println(big(2));
    println(big(3));
    println(mid(1));
    println(mid(5));
    println(both(1));
    return 0;
}
