fn mid(x: i64) -> i64 {
    var s: i64 = 0;
    val w0: i64 = x * 3 - 0;
    s = s + w0;
    val w1: i64 = x * 4 - 1;
    s = s + w1;
    val w2: i64 = x * 5 - 2;
    s = s + w2;
    val w3: i64 = x * 6 - 3;
    s = s + w3;
    val w4: i64 = x * 7 - 4;
    s = s + w4;
    val w5: i64 = x * 8 - 5;
    s = s + w5;
    val w6: i64 = x * 9 - 6;
    s = s + w6;
    val w7: i64 = x * 10 - 7;
    s = s + w7;
    val w8: i64 = x * 11 - 8;
    s = s + w8;
    val w9: i64 = x * 12 - 9;
    s = s + w9;
    val w10: i64 = x * 13 - 10;
    s = s + w10;
