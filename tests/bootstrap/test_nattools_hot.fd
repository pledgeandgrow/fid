// llvm-roadmap WP17: hot functions together. With a profile of a run
// (`fid run <file> --profile p.prof`), `fid emit <file> --profile-use
// p.prof` lays the machine layer's functions out most called first
// (nat_ir.fd ng_mir_finish takes its post-order roots in profile order,
// nat_enc.fd nat_hot_first), so `hot_step` and what it calls come before
// `main` and the cold `report`; without a profile the order is the call
// graph's, as before. scripts/nat-tools-check.sh compares `nm -n` of the
// two builds. Same output on every backend.
// Expected output:
// 499500
// done

fn hot_step(acc: i64, i: i64) -> i64 {
    // a loop, so the inliner leaves it a function of its own
    var t: i64 = acc;
    var k: i64 = 0;
    while k < 2 {
        t = t + i * k;
        k = k + 1;
    }
    return t;
}

fn report(v: i64) {
    print(v);
    print("\n");
}

fn main() {
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < 1000 {
        acc = hot_step(acc, i);
        i = i + 1;
    }
    report(acc);
    print("done\n");
}
