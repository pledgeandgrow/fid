// expect-error: 'warn' produces output and is called inside a branch or loop that depends on a secret
// BG170: the same for `||`: warn prints only when the pin is wrong.
fn warn() -> bool { println("wrong"); return false; }
fn check(@secret pin: i64) -> bool {
    val b: bool = pin == 1234 || warn();
    return true;
}
fn main() -> i64 { check(1); return 0; }
