// Test: stdlib/regex — wildcard (legacy) + real backtracking engine.
use regex;
use vec;

fn bs(b: bool) -> str {
    if b { return "t"; }
    return "f";
}

fn main() -> i64 {
    // legacy wildcard
    println("w1 " + bs(regex_matches("hello", "h*o")));
    println("w2 " + bs(!regex_matches("hello", "h*z")));

    // literals / classes / quantifiers
    println("1 " + bs(regex_match("hello", "h.llo")));
    println("2 " + bs(regex_match("hello123", "h[ae]l+o[0-9]+")));
    println("3 " + bs(regex_match("aaa", "a{3}")));
    println("4 " + bs(!regex_match("aa", "a{3,5}")));
    println("5 " + bs(regex_match("color", "colou?r")));
    println("6 " + bs(regex_match("colour", "colou?r")));
    println("7 " + bs(regex_match("x9y", "x\\dy")));
    println("8 " + bs(regex_match("  hi", "\\s+\\w+")));
    println("9 " + bs(regex_match("abc", "[^0-9]+")));
    println("10 " + bs(regex_match("a.c", "a\\.c")));
    println("11 " + bs(regex_match("abc", "a.c$")));

    // anchors
    println("12 " + bs(regex_match("abc", "^abc$")));
    println("13 " + bs(!regex_match("xabc", "^abc")));

    // top-level alternation
    println("14 " + bs(regex_match("cat", "cat|dog")));
    println("15 " + bs(regex_match("dog", "cat|dog|fish")));

    // groups
    println("16 " + bs(regex_match("ababab", "(ab)+")));
    println("17 " + bs(regex_match("abcabc", "(abc){2}")));
    println("18 " + bs(!regex_match("ab", "(ab){2}")));

    // search / find / replace / split
    println("19 " + int_to_str(regex_find_re("abc123def", "[0-9]+")));
    println("20 " + bs(!regex_search("no digits", "\\d")));
    println("21 " + regex_replace("a1b22c", "[0-9]+", "#"));

    var sp: Vec = regex_split("a1b2c3", "[0-9]");
    var out: str = "";
    var i: i64 = 0;
    while i < sp.len() {
        var x: str = sp.get(i);
        out = out + x + "|";
        i = i + 1;
    }
    println("22 " + out);

    // invalid pattern → no match, no panic
    println("23 " + bs(regex_match("x", "(unclosed")));
    println("24 " + bs(regex_match("x", "a|(b")));

    return 0;
}
