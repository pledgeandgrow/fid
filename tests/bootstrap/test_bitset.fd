use bitset;

fn main() -> i64 {
    var bs = bitset_new(100);
    print(bitset_get(bs, 0));
    print(bitset_get(bs, 99));
    print(bitset_get(bs, 100));
    print("|");

    bitset_set(&mut bs, 0);
    bitset_set(&mut bs, 62);      // last bit of word 0
    bitset_set(&mut bs, 63);      // first bit of word 1
    bitset_set(&mut bs, 99);      // last bit
    print(bitset_get(bs, 0));
    print(bitset_get(bs, 62));
    print(bitset_get(bs, 63));
    print(bitset_get(bs, 64));
    print(bitset_get(bs, 99));
    print(bitset_count(bs));
    print("|");

    bitset_clear(&mut bs, 62);
    print(bitset_get(bs, 62));
    print(bitset_count(bs));
    bitset_flip(&mut bs, 62);
    bitset_flip(&mut bs, 63);
    print(bitset_get(bs, 62));
    print(bitset_get(bs, 63));
    print(bitset_count(bs));
    print("|");

    print(bitset_next_set(bs, 0));
    print(bitset_next_set(bs, 1));
    print(bitset_next_set(bs, 64));
    print(bitset_next_clear(bs, 0));
    print("|");

    // set algebra
    var a = bitset_new(8);
    var b = bitset_new(8);
    bitset_set(&mut a, 0); bitset_set(&mut a, 1); bitset_set(&mut a, 2);
    bitset_set(&mut b, 1); bitset_set(&mut b, 3);
    var ab = bitset_and(a, b);
    var ao = bitset_or(a, b);
    var ax = bitset_xor(a, b);
    var an = bitset_andnot(a, b);
    print(bitset_to_string(ab));
    print(bitset_to_string(ao));
    print(bitset_to_string(ax));
    print(bitset_to_string(an));
    print(bitset_intersects(a, b));
    print(bitset_contains_all(a, b));
    print("|");

    var r = bitset_from_string("101001");
    print(bitset_to_vec(r).len());
    print(bitset_to_string(r));
    print(bitset_to_string(bitset_not(r)));
    print(bitset_equals(r, bitset_from_string("101001")));
    print("|");

    var full = bitset_new_full(5);
    print(bitset_all(full));
    print(bitset_none(full));
    print(bitset_any(bs));
    print("\n");

    return 0;
}
