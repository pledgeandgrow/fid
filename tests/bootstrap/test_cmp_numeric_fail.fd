// expect-error: `==` takes two values of one type
// Bugs roadmap BG60: numbers of different types were compared as they
// lay — `u8 == i64` widened one side, `i64 < f64` ordered an int's bits
// against a float's. Two numbers of different types are an error now
// (cast one side with `as`); a literal still takes the other side's type.
fn main() -> i64 {
    val small: u8 = 3;
    val big: i64 = 3;
    if small == big {
        println("same");
    }
    return 0;
}
