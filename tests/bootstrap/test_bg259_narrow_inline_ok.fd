// Bugs roadmap BG259: narrow-integer arithmetic of an inlined function with
// literal arguments, in range, keeps its type (the inliner narrows the
// literal to the parameter's type).
//
// Expected output:
// 250 200
// -32000 32767
// 1073741824
// 255
fn a4(x: u8) -> u8 {
    val y: u8 = x + 50;
    return y;
}
fn m2(x: u8) -> u8 {
    return x * 2;
}
fn b4(x: i16) -> i16 {
    return x - 1000;
}
fn b5(x: i16) -> i16 {
    return x + 767;
}
fn c4(x: i32) -> i32 {
    return x * 16;
}
fn nb(x: u8) -> u8 {
    return ~x;
}
fn main() {
    println(f"{a4(200)} {m2(100)}");
    println(f"{b4(-31000)} {b5(32000)}");
    println(f"{c4(67108864)}");
    println(f"{nb(0)}");
}
