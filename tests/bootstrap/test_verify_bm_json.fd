// BM4 (competitive roadmap): the JSON benchmark, a hand-written parser into
// an arena of nodes and a compact printer (bench/work/fides/json.fd, the
// same code). First a document written by hand (spaces everywhere, empty
// object and array, negative numbers, escaped newline, tab, quote,
// backslash and unicode) printed back compact with its node count, then
// the benchmark's own run on 20 generated values of depth up to 4, 2 rounds.
// The expected value of the run is a Python reference of the same
// generator, parser and printer.
//
// Expected output:
// {"a":[1,-20,true,false,null],"b\n\t":"A\"\\x\u0001","c":{},"d":[]}
// 10
// 1800755282
fn rnd(s: &mut Vec<i64>) -> i64 {
    val x: i64 = (s.get(0) * 1103515245 + 12345) % 2147483648;
    s.set(0, x);
    return x >> 8;
}

fn put_dec(out: &mut Vec<u8>, v: i64) {
    if v >= 10 {
        put_dec(out, v / 10);
    }
    out.push((48 + v % 10) as u8);
}

fn put_int(out: &mut Vec<u8>, v: i64) {
    if v < 0 {
        out.push(45);
        put_dec(out, 0 - v);
    } else {
        put_dec(out, v);
    }
}

fn put_lit(out: &mut Vec<u8>, s: str) {
    val n: i64 = str_len(s);
    var i: i64 = 0;
    while i < n {
        out.push(str_byte_at(s, i) as u8);
        i = i + 1;
    }
}

fn gen_string(out: &mut Vec<u8>, s: &mut Vec<i64>) {
    out.push(34);
    val n: i64 = rnd(s) % 12;
    var i: i64 = 0;
    while i < n {
        val c: i64 = rnd(s) % 40;
        if c < 26 {
            out.push((97 + c) as u8);
        } else if c == 26 {
            put_lit(out, "\\n");
        } else if c == 27 {
            put_lit(out, "\\\"");
        } else if c == 28 {
            put_lit(out, "\\\\");
        } else if c == 29 {
            put_lit(out, "\\u00e9");
        } else if c == 30 {
            put_lit(out, "\\t");
        } else if c == 31 {
            put_lit(out, "\\u0041");
        } else if c < 36 {
            out.push(32);
        } else {
            out.push((48 + c - 36) as u8);
        }
        i = i + 1;
    }
    out.push(34);
}

fn gen_value(out: &mut Vec<u8>, s: &mut Vec<i64>, d: i64) {
    var r: i64 = rnd(s) % 8;
    if d == 0 {
        r = r % 5;
    }
    if r == 0 {
        val v: i64 = rnd(s) % 2000000 - 1000000;
        put_int(out, v);
    } else if r == 1 || r == 4 {
        gen_string(out, s);
    } else if r == 2 {
        val t: i64 = rnd(s) % 3;
        if t == 0 {
            put_lit(out, "true");
        } else if t == 1 {
            put_lit(out, "false");
        } else {
            put_lit(out, "null");
        }
    } else if r == 3 {
        val v: i64 = rnd(s) % 100;
        put_int(out, v);
    } else if r == 5 || r == 6 {
        val n: i64 = rnd(s) % 5;
        out.push(91);
        var i: i64 = 0;
        while i < n {
            if i > 0 {
                put_lit(out, ", ");
            }
            gen_value(out, s, d - 1);
            i = i + 1;
        }
        out.push(93);
    } else {
        val n: i64 = rnd(s) % 5;
        out.push(123);
        var i: i64 = 0;
        while i < n {
            if i > 0 {
                put_lit(out, ",\n  ");
            }
            gen_string(out, s);
            put_lit(out, ": ");
            gen_value(out, s, d - 1);
            i = i + 1;
        }
        out.push(125);
    }
}

fn generate(items: i64, depth: i64) -> Vec<u8> {
    var out: Vec<u8> = Vec::new();
    var s: Vec<i64> = Vec::new();
    s.push(1);
    out.push(91);
    var i: i64 = 0;
    while i < items {
        if i > 0 {
            put_lit(&mut out, ",\n");
        }
        gen_value(&mut out, &mut s, depth);
        i = i + 1;
    }
    out.push(93);
    out.push(10);
    return out;
}

// The parsed document. Node kinds: 0 null, 1 false, 2 true, 3 number,
// 4 string, 5 array, 6 object; `num` is the number or the string id, `key`
// the string id of an object member's key (-1 otherwise). String id k is
// the bytes pool[ps[k] .. ps[k] + pl[k]].
struct JDoc {
    pos: i64,
    kind: Vec<i64>,
    num: Vec<i64>,
    first: Vec<i64>,
    next: Vec<i64>,
    key: Vec<i64>,
    pool: Vec<u8>,
    ps: Vec<i64>,
    pl: Vec<i64>,
}

fn jd_new() -> JDoc {
    return JDoc {
        pos: 0,
        kind: Vec::new(),
        num: Vec::new(),
        first: Vec::new(),
        next: Vec::new(),
        key: Vec::new(),
        pool: Vec::new(),
        ps: Vec::new(),
        pl: Vec::new(),
    };
}

fn at(t: &Vec<u8>, i: i64) -> i64 {
    return t.get(i) as i64;
}

fn jp_ws(d: &mut JDoc, t: &Vec<u8>) {
    var c: i64 = at(t, d.pos);
    while c == 32 || c == 10 || c == 13 || c == 9 {
        d.pos = d.pos + 1;
        c = at(t, d.pos);
    }
}

fn jp_node(d: &mut JDoc, k: i64, v: i64) -> i64 {
    d.kind.push(k);
    d.num.push(v);
    d.first.push(-1);
    d.next.push(-1);
    d.key.push(-1);
    return d.kind.len() - 1;
}

fn hex_val(h: i64) -> i64 {
    if h >= 48 && h <= 57 {
        return h - 48;
    }
    if h >= 97 && h <= 102 {
        return h - 87;
    }
    return h - 55;
}

fn jp_string(d: &mut JDoc, t: &Vec<u8>) -> i64 {
    d.pos = d.pos + 1;
    val st: i64 = d.pool.len();
    var going: bool = true;
    while going {
        val c: i64 = at(t, d.pos);
        if c == 34 {
            d.pos = d.pos + 1;
            going = false;
        } else if c == 92 {
            val e: i64 = at(t, d.pos + 1);
            d.pos = d.pos + 2;
            if e == 110 {
                d.pool.push(10);
            } else if e == 116 {
                d.pool.push(9);
            } else if e == 114 {
                d.pool.push(13);
            } else if e == 98 {
                d.pool.push(8);
            } else if e == 102 {
                d.pool.push(12);
            } else if e == 117 {
                var cp: i64 = 0;
                var j: i64 = 0;
                while j < 4 {
                    cp = cp * 16 + hex_val(at(t, d.pos));
                    d.pos = d.pos + 1;
                    j = j + 1;
                }
                if cp < 128 {
                    d.pool.push(cp as u8);
                } else if cp < 2048 {
                    d.pool.push((192 | (cp >> 6)) as u8);
                    d.pool.push((128 | (cp & 63)) as u8);
                } else {
                    d.pool.push((224 | (cp >> 12)) as u8);
                    d.pool.push((128 | ((cp >> 6) & 63)) as u8);
                    d.pool.push((128 | (cp & 63)) as u8);
                }
            } else {
                d.pool.push(e as u8);
            }
        } else {
            d.pool.push(c as u8);
            d.pos = d.pos + 1;
        }
    }
    d.ps.push(st);
    d.pl.push(d.pool.len() - st);
    return d.ps.len() - 1;
}

fn jp_value(d: &mut JDoc, t: &Vec<u8>) -> i64 {
    jp_ws(d, t);
    val c: i64 = at(t, d.pos);
    if c == 123 || c == 91 {
        var close: i64 = 93;
        var nk: i64 = 5;
        if c == 123 {
            close = 125;
            nk = 6;
        }
        val n: i64 = jp_node(d, nk, 0);
        d.pos = d.pos + 1;
        var prev: i64 = -1;
        jp_ws(d, t);
        if at(t, d.pos) == close {
            d.pos = d.pos + 1;
            return n;
        }
        while true {
            var k: i64 = -1;
            if c == 123 {
                jp_ws(d, t);
                k = jp_string(d, t);
                jp_ws(d, t);
                // ':'
                d.pos = d.pos + 1;
            }
            val ch: i64 = jp_value(d, t);
            d.key.set(ch, k);
            if prev < 0 {
                d.first.set(n, ch);
            } else {
                d.next.set(prev, ch);
            }
            prev = ch;
            jp_ws(d, t);
            if at(t, d.pos) == 44 {
                d.pos = d.pos + 1;
            } else {
                d.pos = d.pos + 1;
                return n;
            }
        }
        return n;
    }
    if c == 34 {
        val sid: i64 = jp_string(d, t);
        return jp_node(d, 4, sid);
    }
    if c == 116 {
        d.pos = d.pos + 4;
        return jp_node(d, 2, 0);
    }
    if c == 102 {
        d.pos = d.pos + 5;
        return jp_node(d, 1, 0);
    }
    if c == 110 {
        d.pos = d.pos + 4;
        return jp_node(d, 0, 0);
    }
    var neg: bool = false;
    if c == 45 {
        neg = true;
        d.pos = d.pos + 1;
    }
    var v: i64 = 0;
    var b: i64 = at(t, d.pos);
    while b >= 48 && b <= 57 {
        v = v * 10 + b - 48;
        d.pos = d.pos + 1;
        b = at(t, d.pos);
    }
    if neg {
        v = 0 - v;
    }
    return jp_node(d, 3, v);
}

fn hex_digit(v: i64) -> u8 {
    if v < 10 {
        return (48 + v) as u8;
    }
    return (87 + v) as u8;
}

fn jw_str(out: &mut Vec<u8>, d: &JDoc, sid: i64) {
    out.push(34);
    val st: i64 = d.ps.get(sid);
    val end: i64 = st + d.pl.get(sid);
    var i: i64 = st;
    while i < end {
        val b: i64 = d.pool.get(i) as i64;
        if b == 34 {
            out.push(92);
            out.push(34);
        } else if b == 92 {
            out.push(92);
            out.push(92);
        } else if b == 10 {
            out.push(92);
            out.push(110);
        } else if b == 9 {
            out.push(92);
            out.push(116);
        } else if b < 32 {
            put_lit(out, "\\u00");
            out.push(hex_digit(b >> 4));
            out.push(hex_digit(b & 15));
        } else {
            out.push(b as u8);
        }
        i = i + 1;
    }
    out.push(34);
}

fn jw_node(out: &mut Vec<u8>, d: &JDoc, n: i64) {
    val k: i64 = d.kind.get(n);
    if k == 0 {
        put_lit(out, "null");
    } else if k == 1 {
        put_lit(out, "false");
    } else if k == 2 {
        put_lit(out, "true");
    } else if k == 3 {
        put_int(out, d.num.get(n));
    } else if k == 4 {
        jw_str(out, d, d.num.get(n));
    } else {
        if k == 5 {
            out.push(91);
        } else {
            out.push(123);
        }
        var c: i64 = d.first.get(n);
        var f: bool = true;
        while c >= 0 {
            if !f {
                out.push(44);
            }
            f = false;
            if k == 6 {
                jw_str(out, d, d.key.get(c));
                out.push(58);
            }
            jw_node(out, d, c);
            c = d.next.get(c);
        }
        if k == 5 {
            out.push(93);
        } else {
            out.push(125);
        }
    }
}

fn json_run(items: i64, depth: i64, rounds: i64) -> i64 {
    var text: Vec<u8> = generate(items, depth);
    var total: i64 = 0;
    var r: i64 = 0;
    while r < rounds {
        var d: JDoc = jd_new();
        val root: i64 = jp_value(&mut d, &text);
        var out: Vec<u8> = Vec::new();
        jw_node(&mut out, &d, root);
        var h: i64 = 0;
        val n: i64 = out.len();
        var i: i64 = 0;
        while i < n {
            h = (h * 31 + (out.get(i) as i64)) % 1000000007;
            i = i + 1;
        }
        total = total + h + d.kind.len();
        text = out;
        r = r + 1;
    }
    return total;
}

fn crafted() {
    var t: Vec<u8> = Vec::new();
    put_lit(&mut t, " { \"a\" : [ 1, -20 , true,false, null ],\n \"b\\n\\t\": \"\\u0041\\\"\\\\x\\u0001\", \"c\": { }, \"d\":[] } \n");
    var d: JDoc = jd_new();
    val root: i64 = jp_value(&mut d, &t);
    var out: Vec<u8> = Vec::new();
    jw_node(&mut out, &d, root);
    var b: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < out.len() {
        b.push(out.get(i) as i64);
        i = i + 1;
    }
    println(str_from_bytes(b));
    println(d.kind.len());
}

fn main() -> i64 {
    crafted();
    println(json_run(20, 4, 2));
    return 0;
}
