// expect-error: but 'plus_one' returns i64
// known-bugs 2g.55: `e?` returns None or Err from the enclosing function,
// so that function must return an Option or a Result. In a function
// returning i64 it was accepted: `fid run` exited 0 and a C build exited
// 192 on the None path. Now it is a type error naming the function and its
// return type.
use core;

fn get(k: i64) -> Option<i64> {
    if k > 0 {
        return Option::Some(k);
    }
    return Option::None;
}

fn plus_one(k: i64) -> i64 {
    val v = get(k)?;
    return v + 1;
}

fn main() -> i64 {
    println(plus_one(0));
    return 0;
}
