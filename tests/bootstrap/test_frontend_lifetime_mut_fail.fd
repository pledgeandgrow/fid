// expect-error: cannot mutate a: a mutable borrow is active
// LG3: a `&mut` passed on. `r = id_mut(m)` takes over the mutable borrow
// `m` holds, so changing `a` while `r` is still used is an error even
// after `m`'s last use (it was not followed before: only shared borrows
// were passed on).
fn id_mut(p: &mut i64) -> &mut i64 {
    return p;
}

fn main() -> i64 {
    var a: i64 = 1;
    val m = &mut a;
    val r = id_mut(m);
    a = 2;
    *r = 3;
    println(a);
    return 0;
}
