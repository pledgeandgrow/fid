// expect-error: function value 'sq' parameter 1 expects 'f64', got 'str'
// Roadmap L6C (type-safe function pointer lookup): a symbol looked up with
// p_dl_sym takes the function type it is declared with, so a call through
// it with the wrong argument types is a compile error.
use core with { FS, IO }

fn main() -> i64 {
    val lib = p_dl_open("libm.so.6");
    val sq: fn(f64) -> f64 = p_dl_sym(lib, "sqrt");
    val r = sq("sixteen");
    return 0;
}
