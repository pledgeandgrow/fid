// expect-error: Event error: 'pay' declares @emit(Transfr), but 'Transfr' is not an @event function
// Roadmap Phase 9 (F34): each name in @emit(...) is an event declared with
// `@event fn`.
@event
fn Transfer(from: i64, to: i64, amount: i64) {}

@emit(Transfr)
fn pay(amount: i64) {
    Transfer(1, 2, amount);
}

fn main() -> i64 {
    pay(5);
    return 0;
}
