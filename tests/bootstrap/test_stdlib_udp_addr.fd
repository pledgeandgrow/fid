// stdlib/udp.fd addresses (competitive SL2: UDP over IPv4 and IPv6):
// parsing dotted IPv4 and every IPv6 text form (RFC 4291 §2.2: "::",
// a dotted IPv4 tail, brackets, a zone index), the RFC 5952 text form,
// v4-mapped addresses, and the malformed inputs that must be refused.
// No socket is opened: the sockets themselves are tests/net/udp_loopback.fd.
//
// Expected output:
// 192.0.2.1:443
// [2001:db8::1]:443
// [::1]:4433
// [::]:0
// [::ffff:192.0.2.7]:80
// [fe80::1%3]:9
// [2001:db8:0:1:1:1:1:1]:1
// [2001:0:0:1::1]:1
// [2001:db8::1:0:0:1]:1
// mapped: [::ffff:10.1.2.3]:53 back: 10.1.2.3:53
// loopback: 127.0.0.1:7 [::1]:7
// rejected: 12
// same: true false
// udp addresses ok

use udp;

fn show(t: str, port: i64) {
    val a: UdpAddr = udp_addr(t, port);
    if !udp_addr_ok(& a) {
        println("FAILED to parse " + t);
        panic("udp_addr");
    }
    println(udp_addr_text(& a));
}

fn main() {
    show("192.0.2.1", 443);
    show("2001:DB8:0:0:0:0:0:1", 443);
    show("[::1]", 4433);
    show("::", 0);
    show("::ffff:192.0.2.7", 80);
    show("fe80::1%3", 9);
    show("2001:db8:0:1:1:1:1:1", 1);
    show("2001:0:0:1:0:0:0:1", 1);
    show("2001:db8:0:0:1:0:0:1", 1);
    val v4: UdpAddr = udp_addr("10.1.2.3", 53);
    val m: UdpAddr = udp_addr_mapped(& v4);
    val back: UdpAddr = udp_addr_unmapped(& m);
    println("mapped: " + udp_addr_text(& m) + " back: " + udp_addr_text(& back));
    val l4: UdpAddr = udp_addr_loopback(UDP_V4, 7);
    val l6: UdpAddr = udp_addr_loopback(UDP_V6, 7);
    println("loopback: " + udp_addr_text(& l4) + " " + udp_addr_text(& l6));
    var bad: Vec<str> = Vec::new();
    bad.push("");
    bad.push("1.2.3");
    bad.push("1.2.3.256");
    bad.push("01.2.3.4");
    bad.push("1:2:3:4:5:6:7:8:9");
    bad.push("1::2::3");
    bad.push(":1:2");
    bad.push("1:2:3:4:5:6:7:");
    bad.push("12345::1");
    bad.push("::g");
    bad.push("fe80::1%");
    bad.push("example.org");
    var rejected: i64 = 0;
    var i: i64 = 0;
    while i < bad.len() {
        val a: UdpAddr = udp_addr(bad.get(i), 1);
        if udp_addr_ok(& a) {
            println("FAILED: accepted " + bad.get(i));
            panic("udp_addr accepted bad text");
        }
        rejected = rejected + 1;
        i = i + 1;
    }
    println("rejected: " + int_to_str(rejected));
    val x: UdpAddr = udp_addr("::1", 5);
    val y: UdpAddr = udp_addr("0:0:0:0:0:0:0:1", 5);
    val z: UdpAddr = udp_addr("::1", 6);
    println("same: " + bool_to_str(udp_addr_same(& x, & y)) + " " + bool_to_str(udp_addr_same(& x, & z)));
    println("udp addresses ok");
}
