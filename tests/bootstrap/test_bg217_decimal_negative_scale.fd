// BG217 (docs/roadmap/bugs-roadmap.md): a decimal with a negative scale
// prints its value. dec_round and dec_div keep a negative scale (a mantissa
// of 12 at scale -2 is 1200); dec_to_str printed the mantissa alone, and
// dec_from_units dropped the factor of a negative scale.
//
// Expected output:
// 1200
// 330
// 1300
// 1200
// -1200
// 0
// 1201
// 30
// 1200
// 12.50
// 1200
use decimal;

fn main() -> i64 {
    // the entry's two triggers
    println(dec_to_str(dec_round(dec_parse("1234"), -2, DEC_HALF_UP)));
    println(dec_to_str(dec_div(dec_from_i64(1000), dec_from_i64(3), -1, DEC_HALF_UP)));
    // a tie at a negative scale, both ways
    println(dec_to_str(dec_round(dec_parse("1250"), -2, DEC_HALF_UP)));
    println(dec_to_str(dec_round(dec_parse("1250"), -2, DEC_HALF_EVEN)));
    // a negative value, and one that rounds to zero
    println(dec_to_str(dec_round(dec_parse("-1234"), -2, DEC_HALF_UP)));
    println(dec_to_str(dec_round(dec_parse("2.345"), -1, DEC_HALF_UP)));
    // arithmetic with a negative scale keeps the value
    println(dec_to_str(dec_add(dec_round(dec_parse("1234"), -2, DEC_HALF_UP), dec_parse("1"))));
    println(dec_to_str(dec_mul(dec_round(dec_from_i64(15), -1, DEC_HALF_UP), dec_parse("1.5"))));
    // units / 10^scale for a negative scale
    println(dec_to_str(dec_from_units(12, -2)));
    println(dec_to_str(dec_from_units(1250, 2)));
    val whole = dec_to_i64(dec_round(dec_parse("1234"), -2, DEC_HALF_UP));
    println(f"{whole}");
    return 0;
}
