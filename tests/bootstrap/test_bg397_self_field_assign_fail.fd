// expect-error: 'self' is a by-value receiver of 'setx' and cannot be changed
// Bugs roadmap BG397: a by-value `self: T` struct parameter could be
// changed, and since the struct is passed by address the change leaked into
// the caller's variable (`q.setx()` set the caller's q.x to 5), against
// reference §5.3 (a by-value struct parameter may not be changed).
struct Q { x: i64 }
impl Q {
    fn setx(self: Q) -> i64 {
        self.x = 5;
        return self.x;
    }
}
fn main() {
    var q = Q { x: 1 };
    println(q.setx());
    println(q.x);
}
