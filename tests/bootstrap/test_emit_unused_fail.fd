// expect-error: Event error: 'pay' declares @emit(Approval) but never emits it
// Roadmap Phase 9 (F34): an event listed in @emit must be emitted on some
// path, or a log reader waiting for it would wait forever.
@event
fn Transfer(from: i64, to: i64, amount: i64) {}

@event
fn Approval(owner: i64, spender: i64, allowed: bool) {}

@emit(Transfer, Approval)
fn pay(amount: i64) {
    Transfer(1, 2, amount);
}

fn main() -> i64 {
    pay(5);
    return 0;
}
