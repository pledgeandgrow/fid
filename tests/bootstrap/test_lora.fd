// test_lora.fd — ML14: LoRA/Adapter Hot-Swap
// Expected: PASS
// Tests @adapter annotation and persist for LoRA weights.

use tensor;

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

@adapter
@differentiable
fn lora_forward(x: Tensor, lora_a: Tensor, lora_b: Tensor) -> Tensor {
    // LoRA: output = x + (x @ A) @ B
    // Only adapter weights (A, B) are modified during training.
    // Base weights are frozen.
    val ax = matmul(x, lora_a);
    val result = matmul(ax, lora_b);
    return result;
}

fn main() {
    val x = ones(vec2(2, 2));
    val lora_a = ones(vec2(2, 2));
    val lora_b = ones(vec2(2, 2));

    // Run LoRA forward pass
    val result = lora_forward(x, lora_a, lora_b);
    print(to_str(result));
    print("\n");

    // Simulate hot-swap: persist adapter weights
    persist val lora_a_saved = lora_a;
    persist val lora_b_saved = lora_b;

    print("adapter weights persisted\n");
    return 0;
}
