// test_autodiff_fail.fd — ML3: Effect-Traced Autodiff
// Expected: FAIL (compile error)
// Tests that @differentiable functions cannot have IO effects.

use tensor;

@differentiable
fn bad_forward(x: Tensor) -> Tensor {
    // IO effect breaks gradient computation — should be a compile error
    print("computing forward...\n");
    val w = zeros(vec2(2, 2));
    val h = matmul(x, w);
    return h;
}

fn vec2(a: i64, b: i64) -> Vec<i64> {
    val v = Vec::new();
    v.push(a);
    v.push(b);
    return v;
}

fn main() {
    val s = vec2(2, 2);
    val x = ones(s);
    val result = bad_forward(x);
    print(to_str(result));
    return 0;
}
