// SHA-256 against the NIST FIPS 180-4 examples, HMAC-SHA-256 against RFC 4231
// (test case 2) and a key longer than a block. A wrong value panics: every
// backend agreeing on a wrong hash must still fail.
use crypto;

fn check(label: str, got: str, want: str) {
    if got != want {
        p_panic(label + ": got " + got + ", want " + want);
    }
    println(label + " ok");
}

fn main() -> i64 {
    check("sha256 empty", crypto_sha256_hex_str(""),
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    check("sha256 abc", crypto_sha256_hex_str("abc"),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    check("sha256 448 bits", crypto_sha256_hex_str("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
    check("sha256 896 bits", crypto_sha256_hex_str("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"),
        "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1");
    check("hmac rfc4231 case 2", crypto_sha256_hex(crypto_hmac_sha256("Jefe", "what do ya want for nothing?")),
        "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
    check("hmac long key", crypto_sha256_hex(crypto_hmac_sha256(
        "This key is longer than the 64-byte block of SHA-256, so it is hashed first.", "Fides")),
        "00b462e76a65f60c9caee4af56a7fcf80f7971bb7b61acdc36c02de861dbd2a0");
    check("hmac fox", crypto_sha256_hex(crypto_hmac_sha256("key", "The quick brown fox jumps over the lazy dog")),
        "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8");
    return 0;
}
