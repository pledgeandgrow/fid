// Competitive roadmap RT5: a HashMap keeps struct values in its values
// block (HashMap_insert_mem / HashMap_insert_i_mem, as Vec_push_mem does
// for a Vec) and takes struct keys hashed and compared field by field
// (HashMap_insert_k / HashMap_insert_k_mem; a lookup passes the key's
// address). The structs here are plain words written through pointers, so
// the test needs nothing from the lowering: it calls core's functions as
// the compiler does. Checked: the map's type word says its values are
// inline (3 words) and HashMap_get lends an address inside the values
// block, through growing, overwriting, removing, copy-on-write (share),
// clone, values() and keys(); struct keys found from a different buffer
// with the same fields, absent ones not found. Every "bad" count must be
// 0. Every block is freed (scripts/leak-check.sh).
// Expected output:
// inline 3 inside 1 bad 0
// len 1000 overwrite 7 bad 0
// removed len 500 bad 0
// share 501 500 bad 0
// clone 500 bad 0
// values 500 inline 1 bad 0
// skeys len 900 bad 0
// skeys removed 870 keys 870 sum 25455 bad 0
// skey values 64 bad 0
// text words 3
// str keys 3 bad 0
// done

@unsafe
fn ld(a: i64) -> i64 {
    var p: *mut i64 = a;
    return *p;
}

@unsafe
fn st(a: i64, v: i64) {
    var p: *mut i64 = a;
    *p = v;
}

// the bits of a map's type word (core's P_TID_TAG)
@unsafe
fn tword(m: i64) -> i64 {
    return ld(m + 48) - 0x4649445449440000;
}

// a 24-byte struct {a, b, c} at x
@unsafe
fn put3(x: i64, a: i64, b: i64, c: i64) {
    st(x, a);
    st(x + 8, b);
    st(x + 16, c);
}

@unsafe
fn check3(p: i64, a: i64, b: i64, c: i64) -> i64 {
    if p == 0 {
        return 1;
    }
    if ld(p) != a || ld(p + 8) != b || ld(p + 16) != c {
        return 1;
    }
    return 0;
}

// whether p is inside the values block of the map m (structs of ms bytes)
@unsafe
fn inside(m: i64, p: i64, ms: i64) -> bool {
    val vals: i64 = ld(m + 8);
    val cap: i64 = ld(m + 24);
    return p >= vals && p + ms <= vals + cap * 17 + cap * ms;
}

@unsafe
fn main() -> i64 {
    val x: i64 = p_malloc(24);
    val m: i64 = HashMap_new();
    var bad: i64 = 0;
    var i: i64 = 0;
    while i < 1000 {
        put3(x, i, i * 2, i * 3);
        HashMap_insert_i_mem(m, i, x, 24, 0);
        i = i + 1;
    }
    val t: i64 = tword(m);
    val words: i64 = (t >> 20) & 255;
    var ins: i64 = 1;
    i = 0;
    while i < 1000 {
        val p: i64 = HashMap_get_i(m, i);
        bad = bad + check3(p, i, i * 2, i * 3);
        if !inside(m, p, 24) {
            ins = 0;
        }
        i = i + 1;
    }
    println("inline " + int_to_str(words) + " inside " + int_to_str(ins) + " bad " + int_to_str(bad));

    // overwrite: the old struct is replaced in its slot
    put3(x, 7, 70, 700);
    HashMap_insert_i_mem(m, 7, x, 24, 0);
    bad = check3(HashMap_get_i(m, 7), 7, 70, 700);
    if HashMap_len(m) != 1000 {
        bad = bad + 1;
    }
    println("len " + int_to_str(HashMap_len(m)) + " overwrite " + int_to_str(ld(HashMap_get_i(m, 7))) + " bad " + int_to_str(bad));

    // remove the first half
    i = 0;
    while i < 500 {
        HashMap_remove_i(m, i);
        i = i + 1;
    }
    bad = 0;
    i = 0;
    while i < 1000 {
        if i < 500 {
            if HashMap_contains_i(m, i) {
                bad = bad + 1;
            }
        } else {
            bad = bad + check3(HashMap_get_i(m, i), i, i * 2, i * 3);
        }
        i = i + 1;
    }
    println("removed len " + int_to_str(HashMap_len(m)) + " bad " + int_to_str(bad));

    // copy-on-write: a share changed alone (map_own copies the structs)
    val s: i64 = HashMap_share(m);
    put3(x, 1, 2, 3);
    HashMap_insert_i_mem(s, 5000, x, 24, 0);
    put3(x, 9, 9, 9);
    HashMap_insert_i_mem(s, 600, x, 24, 0);
    bad = check3(HashMap_get_i(m, 600), 600, 1200, 1800);
    bad = bad + check3(HashMap_get_i(s, 600), 9, 9, 9);
    bad = bad + check3(HashMap_get_i(s, 5000), 1, 2, 3);
    if HashMap_contains_i(m, 5000) {
        bad = bad + 1;
    }
    println("share " + int_to_str(HashMap_len(s)) + " " + int_to_str(HashMap_len(m)) + " bad " + int_to_str(bad));
    HashMap_drop(s);

    // clone: a map of its own, also inline
    val c: i64 = HashMap_clone(m);
    put3(x, 0, 0, 0);
    HashMap_insert_i_mem(m, 700, x, 24, 0);
    bad = check3(HashMap_get_i(c, 700), 700, 1400, 2100);
    bad = bad + check3(HashMap_get_i(m, 700), 0, 0, 0);
    if ((tword(c) >> 20) & 255) != 3 {
        bad = bad + 1;
    }
    if !inside(c, HashMap_get_i(c, 999), 24) {
        bad = bad + 1;
    }
    println("clone " + int_to_str(HashMap_len(c)) + " bad " + int_to_str(bad));
    HashMap_drop(c);

    // values(): copies in key order, in the Vec's buffer
    val vs: i64 = HashMap_values(m);
    bad = 0;
    var vinl: i64 = 0;
    // element code 16 and up: structs in the buffer
    if vec_code(vs) >= 16 {
        vinl = 1;
    }
    i = 0;
    while i < Vec_len(vs) {
        val k: i64 = 500 + i;
        if k == 700 {
            bad = bad + check3(Vec_get(vs, i), 0, 0, 0);
        } else {
            bad = bad + check3(Vec_get(vs, i), k, k * 2, k * 3);
        }
        i = i + 1;
    }
    println("values " + int_to_str(Vec_len(vs)) + " inline " + int_to_str(vinl) + " bad " + int_to_str(bad));
    Vec_drop(vs);
    HashMap_drop(m);

    // struct keys {a, b}: hashed and compared by their words
    val kb: i64 = p_malloc(16);
    val probe: i64 = p_malloc(16);
    val sk: i64 = HashMap_new();
    var a: i64 = 0;
    while a < 30 {
        var b: i64 = 0;
        while b < 30 {
            st(kb, a);
            st(kb + 8, b);
            HashMap_insert_k(sk, kb, a * 100 + b, 16, 0);
            b = b + 1;
        }
        a = a + 1;
    }
    bad = 0;
    a = 0;
    while a < 31 {
        var b2: i64 = 0;
        while b2 < 31 {
            st(probe, a);
            st(probe + 8, b2);
            if a < 30 && b2 < 30 {
                if !HashMap_contains(sk, probe) || HashMap_get(sk, probe) != a * 100 + b2 {
                    bad = bad + 1;
                }
            } else if HashMap_contains(sk, probe) {
                bad = bad + 1;
            }
            b2 = b2 + 1;
        }
        a = a + 1;
    }
    println("skeys len " + int_to_str(HashMap_len(sk)) + " bad " + int_to_str(bad));

    // remove the keys {a, 0} and {a, 29} for a < 15: 30 keys
    a = 0;
    while a < 15 {
        st(probe, a);
        st(probe + 8, 0);
        HashMap_remove(sk, probe);
        st(probe + 8, 29);
        HashMap_remove(sk, probe);
        a = a + 1;
    }
    bad = 0;
    st(probe, 3);
    st(probe + 8, 0);
    if HashMap_contains(sk, probe) {
        bad = bad + 1;
    }
    st(probe + 8, 1);
    if HashMap_get(sk, probe) != 301 {
        bad = bad + 1;
    }
    // keys(): copies of the structs; their fields add up
    val ks: i64 = HashMap_keys(sk);
    var sum: i64 = 0;
    i = 0;
    while i < Vec_len(ks) {
        val kp: i64 = Vec_get(ks, i);
        sum = sum + ld(kp) + ld(kp + 8);
        i = i + 1;
    }
    println("skeys removed " + int_to_str(HashMap_len(sk)) + " keys " + int_to_str(Vec_len(ks)) + " sum " + int_to_str(sum) + " bad " + int_to_str(bad));
    Vec_drop(ks);
    HashMap_drop(sk);

    // struct keys and inline struct values together
    val kv: i64 = HashMap_new();
    i = 0;
    while i < 64 {
        st(kb, i);
        st(kb + 8, 0 - i);
        put3(x, i, i + 1, i + 2);
        HashMap_insert_k_mem(kv, kb, x, 16, 0, 24, 0);
        i = i + 1;
    }
    bad = 0;
    i = 0;
    while i < 64 {
        st(probe, i);
        st(probe + 8, 0 - i);
        val p2: i64 = HashMap_get(kv, probe);
        bad = bad + check3(p2, i, i + 1, i + 2);
        if !inside(kv, p2, 24) {
            bad = bad + 1;
        }
        i = i + 1;
    }
    println("skey values " + int_to_str(HashMap_len(kv)) + " bad " + int_to_str(bad));
    HashMap_drop(kv);

    // a key word that holds a string (bit 1 of the mask: word 1) is
    // hashed and compared as text, not as the string's address
    val s1: str = "al" + "pha";
    val s2: str = "alp" + "ha";
    st(kb, 5);
    st(kb + 8, s1 as i64);
    st(probe, 5);
    st(probe + 8, s2 as i64);
    var txt: i64 = 0;
    if hm_fields_eq(kb, probe, 16, 2) && hm_fields_hash(kb, 16, 2) == hm_fields_hash(probe, 16, 2) {
        txt = txt + 1;
    }
    if !hm_fields_eq(kb, probe, 16, 0) {
        txt = txt + 1;
    }
    st(probe + 8, "beta" as i64);
    if !hm_fields_eq(kb, probe, 16, 2) {
        txt = txt + 1;
    }
    println("text words " + int_to_str(txt));

    // string keys (literals: the untyped map does not own them)
    val sm: i64 = HashMap_new();
    put3(x, 1, 1, 1);
    HashMap_insert_mem(sm, "alpha" as i64, x, 24, 0);
    put3(x, 2, 2, 2);
    HashMap_insert_mem(sm, "beta" as i64, x, 24, 0);
    put3(x, 3, 3, 3);
    HashMap_insert_mem(sm, "gamma" as i64, x, 24, 0);
    bad = check3(HashMap_get(sm, "beta" as i64), 2, 2, 2);
    bad = bad + check3(HashMap_get(sm, "gamma" as i64), 3, 3, 3);
    if HashMap_get(sm, "delta" as i64) != 0 {
        bad = bad + 1;
    }
    println("str keys " + int_to_str(HashMap_len(sm)) + " bad " + int_to_str(bad));
    HashMap_drop(sm);

    p_free(x);
    p_free(kb);
    p_free(probe);
    println("done");
    return 0;
}
