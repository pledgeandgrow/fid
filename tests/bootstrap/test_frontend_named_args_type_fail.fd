// expect-error: function 'connect' parameter 'port' expects 'i64'
// CL4: a named argument is type-checked against the parameter it names
// (it was not checked at all).

fn connect(host: str, port: i64 = 80) -> i64 {
    println(host);
    return port;
}

fn main() -> i64 {
    println(connect(port: "8080", host: "example.org"));
    return 0;
}
