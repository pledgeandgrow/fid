// Release D15: `&v[i]` and `&mut v[i]` refer to the element where it is
// stored, so a write through the reference changes the container.
struct P { x: i64, y: i64 }

fn bump(p: &mut i64) { *p = *p + 10; }
fn setx(p: &mut P) { p.x = 99; }
fn sum(p: &P) -> i64 { return p.x + p.y; }
fn first_byte_plus(b: &mut u8) { *b = *b + 1; }

fn main() -> i64 {
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    bump(&mut v[1]);
    println(v.get(1));                 // 12

    var ps: Vec<P> = Vec::new();
    ps.push(P { x: 1, y: 2 });
    ps.push(P { x: 3, y: 4 });
    setx(&mut ps[1]);
    println(ps[1].x);                  // 99
    println(sum(&ps[1]));              // 103
    println(sum(&ps[0]));              // 3

    var bytes: Vec<u8> = Vec::new();
    bytes.push(65);
    first_byte_plus(&mut bytes[0]);
    println(bytes.get(0));             // 66

    // a copy of the Vec is not changed by a write through the original
    var w: Vec<i64> = Vec::new();
    w.push(5);
    var c = w;
    bump(&mut w[0]);
    println(w.get(0));                 // 15
    println(c.get(0));                 // 5
    return 0;
}
