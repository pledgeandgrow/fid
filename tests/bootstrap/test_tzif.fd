// stdlib/tz reading the IANA time zone database (competitive SL8): TZif
// files (RFC 8536) of four zones, from the tzdata Python package, checked
// against Python's zoneinfo on the same files: historical offsets
// (Kolkata, Phoenix, New York before 2007), a half-hour southern DST
// (Lord Howe), and the file's POSIX rule after its last change (New York
// 2040). Then POSIX TZ strings alone: negative DST (Dublin) and change
// times of 24:00 (Santiago).
//
// Expected output:
// Asia/Kolkata 1900-01-01 00:00 -> +05:21 MMT std
// Asia/Kolkata 1942-09-15 00:00 -> +06:30 +0630 dst
// Asia/Kolkata 1945-10-15 00:00 -> +05:30 IST std
// Asia/Kolkata 2026-07-01 00:00 -> +05:30 IST std
// America/Phoenix 1918-06-01 12:00 -> -06:00 MDT dst
// America/Phoenix 1944-01-01 15:00 -> -07:00 MST std
// America/Phoenix 1967-07-01 12:00 -> -06:00 MDT dst
// America/Phoenix 1968-01-01 12:00 -> -07:00 MST std
// America/Phoenix 2026-07-01 12:00 -> -07:00 MST std
// Australia/Lord_Howe 1980-01-01 00:00 -> +10:00 AEST std
// Australia/Lord_Howe 2026-01-15 00:00 -> +11:00 +11 dst
// Australia/Lord_Howe 2026-07-15 00:00 -> +10:30 +1030 std
// Australia/Lord_Howe 2031-12-25 00:00 -> +11:00 +11 dst
// America/New_York 1883-01-01 12:00 -> -04:56 LMT std
// America/New_York 1945-07-01 12:00 -> -04:00 EWT dst
// America/New_York 1974-01-15 12:00 -> -04:00 EDT dst
// America/New_York 2000-07-01 12:00 -> -04:00 EDT dst
// America/New_York 2026-03-08 06:59 -> -05:00 EST std
// America/New_York 2026-03-08 07:00 -> -04:00 EDT dst
// America/New_York 2040-11-04 05:59 -> -04:00 EDT dst
// America/New_York 2040-11-04 06:00 -> -05:00 EST std
// local 2026-03-08 02:30 New York = 2026-03-08 07:30 UTC
// local 2026-11-01 01:30 New York = 2026-11-01 05:30 UTC
// local 1974-01-15 12:00 New York = 1974-01-15 16:00 UTC
// Europe/Dublin 2031-01-15 12:00 -> +00:00 GMT dst
// Europe/Dublin 2031-07-15 12:00 -> +01:00 IST std
// America/Santiago 2031-01-15 12:00 -> -03:00 -03 dst
// America/Santiago 2031-07-15 12:00 -> -04:00 -04 std
// not tzif: false
use tz;
use time;
use vec;
use string;

fn bytes(csv_list: str) -> Vec<i64> {
    var out: Vec<i64> = Vec::new();
    var parts: Vec<str> = str_split(csv_list, ",");
    var i: i64 = 0;
    while i < parts.len() {
        out.push(str_parse_int(parts.get(i)));
        i = i + 1;
    }
    return out;
}

fn two(n: i64) -> str {
    if n < 10 { return "0" + int_to_str(n); }
    return int_to_str(n);
}

fn stamp(y: i64, mo: i64, d: i64, h: i64, mi: i64) -> str {
    return int_to_str(y) + "-" + two(mo) + "-" + two(d) + " " + two(h) + ":" + two(mi);
}

fn show(label: str, z: Tz, y: i64, mo: i64, d: i64, h: i64, mi: i64) {
    var t: LogicalTime = time_new(y, mo, d, h, mi, 0);
    var kind: str = "std";
    if tz_is_dst(z, t) { kind = "dst"; }
    println(label + " " + stamp(y, mo, d, h, mi) + " -> " + tz_offset_str(tz_offset(z, t)) + " " + tz_abbr(z, t) + " " + kind);
}

fn back(z: Tz, y: i64, mo: i64, d: i64, h: i64, mi: i64) {
    var u: LogicalTime = tz_from_local(time_new(y, mo, d, h, mi, 0), z);
    println("local " + stamp(y, mo, d, h, mi) + " New York = " + stamp(time_get_year(u), time_get_month(u), time_get_day(u), time_get_hour(u), time_get_minute(u)) + " UTC");
}

