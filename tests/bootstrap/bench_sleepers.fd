// Timer-heap benchmark: N tasks all sleeping on the deadline heap must not
// cost the poller an O(N) scan per tick. With the heap, N pure sleepers are
// ~free until they expire. Run via emit:
//   fidesc emit tests/bootstrap/bench_sleepers.fd -o bench_sleepers.exe
use task;

async fn sleeper(id: i64) -> Future<i64> {
    task_sleep(3000);
    return id;
}

fn main() -> i64 {
    var n: i64 = 100000;
    var futs: Vec<Future<i64>> = Vec::new();
    var i: i64 = 0;
    while i < n {
        futs.push(sleeper(i));
        i = i + 1;
    }
    println("armed");
    var sum: i64 = 0;
    i = 0;
    while i < futs.len() {
        sum = sum + await futs.get(i);
        i = i + 1;
    }
    println(sum);
    return 0;
}
