// test_natabi_tailcall.fd — llvm / competitive OP13 (sibling calls): on the
// machine layer `return g(x)` to another function becomes a jump after the
// epilogue (compiler/nat_ir.fd ng_tail_at, ng_epilogue_tail;
// `FID_NAT_OFF=tailcall` to compare), so mutual recursion runs in constant
// stack there. A call with arguments on the stack, or from a function that
// hands out the address of its frame, stays a call. The depths stay small
// enough for every backend: the C path and the interpreter keep their
// frames.
//
// Expected output:
// true
// false
// 5050
// 42
// 3
// 15

fn is_even(n: i64) -> bool {
    if n == 0 {
        return true;
    }
    return is_odd(n - 1);
}

fn is_odd(n: i64) -> bool {
    if n == 0 {
        return false;
    }
    return is_even(n - 1);
}

fn sum_a(n: i64, acc: i64) -> i64 {
    if n == 0 {
        return acc;
    }
    return sum_b(n - 1, acc + n);
}

fn sum_b(n: i64, acc: i64) -> i64 {
    if n == 0 {
        return acc;
    }
    return sum_a(n - 1, acc + n);
}

/// Six arguments: some travel on the stack on x86-64 (not a jump there)
fn six(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    return a + b + c + d + e + f;
}

fn via_six(n: i64) -> i64 {
    return six(n, n, n, n, n, n);
}

fn add1(x: i64) -> i64 {
    return x + 1;
}

/// The inner call is not in tail position; the outer one is
fn twice_then(x: i64) -> i64 {
    return add1(add1(x));
}

/// A local's address goes to the callee: this function keeps its frame
fn total(xs: Vec<i64>) -> i64 {
    var s: i64 = 0;
    var i: i64 = 0;
    while i < xs.len() {
        s = s + xs.get(i);
        i = i + 1;
    }
    return s;
}

fn with_local(n: i64) -> i64 {
    var xs: Vec<i64> = Vec::new();
    var i: i64 = 1;
    while i <= n {
        xs.push(i);
        i = i + 1;
    }
    return total(xs);
}

fn flag_text(b: bool) -> str {
    if b {
        return "true";
    }
    return "false";
}

fn main() {
    println(flag_text(is_even(1000)));
    println(flag_text(is_odd(1000)));
    println(sum_a(100, 0));
    println(via_six(7));
    println(twice_then(1));
    println(with_local(5));
}
