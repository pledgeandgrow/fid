// stdlib/mp3: frame headers, Huffman tables as prefix codes, synthesis window and filterbank reconstruction, Layer III (LAME files, MPEG-2 intensity stereo), Layers I and II, free-format framing, all decoded vs ffmpeg
// Expected output:
// FFFB9064: MPEG-1 layer 3 128 kbit/s 44100 Hz mode 1 ext 2 crc no pad 0 frame 417 bytes 1152 samples side 32
// FFFB92C4: MPEG-1 layer 3 128 kbit/s 44100 Hz mode 3 ext 0 crc no pad 1 frame 418 bytes 1152 samples side 17
// FFFA9044: MPEG-1 layer 3 128 kbit/s 44100 Hz mode 1 ext 0 crc yes pad 0 frame 417 bytes 1152 samples side 32
// FFF38844: MPEG-2 layer 3 64 kbit/s 16000 Hz mode 1 ext 0 crc no pad 0 frame 288 bytes 576 samples side 17
// FFE31864: MPEG-2.5 layer 3 8 kbit/s 8000 Hz mode 1 ext 2 crc no pad 0 frame 72 bytes 576 samples side 17
// FFFD9004: MPEG-1 layer 2 160 kbit/s 44100 Hz mode 0 ext 0 crc no pad 0 frame 522 bytes 1152 samples side 0
// FFFBF064: not a frame header
// 00112233: not a frame header
// table 1 decodes (0,0) (0,1) (1,0) (1,1), table 16 then (0,0) at bit 10
// linbits of tables 16 23 24 31: 1 13 4 13
// imdct36 matches the direct sum within 1e-12: yes
// mono 44.1 kHz: id3 45 bytes; frames 208 208 209 209 209 = 5, ends at 1088 of 1088
// stereo 22.05 kHz: id3 45 bytes; frames 182 104 105 104 105 104 105 = 7, ends at 854 of 854
// no frames: no MPEG audio frame found
// layer II frame of zeros: ok yes, 2 channels of 1152 samples, all zero yes
// free-format header: ok yes, free yes, frame length 0 until the next header is found
// mono 44.1 kHz: MPEG-1 44100 Hz 1 ch, Info frame yes, delay 576 padding 1386, 4 frames, 2646 samples per channel after trimming
// mono 44.1 kHz values: 0.0728 -0.0050 -0.0650 0.1106 -0.1152 0.0770 -0.0101 -0.0604
// mono 44.1 kHz matches ffmpeg at 45 points within 1e-5: yes
// stereo 22.05 kHz: MPEG-2 22050 Hz 2 ch, Info frame yes, delay 576 padding 675, 6 frames, 2205 samples per channel after trimming
// stereo 22.05 kHz values: -0.2777 -0.0626 0.1417 -0.2699 0.1003 0.1202 -0.2696 0.2429
// stereo 22.05 kHz matches ffmpeg at 46 points within 1e-5: yes
// huffman tables (ISO 11172-3 Table 3-B.7): 16 tables, 1394 codewords, longest 19 bits, complete prefix codes: 16
// code {0, 01, 11}: prefix-free no; code {0, 10}: prefix-free yes, complete no
// window D[1] D[64] D[128] D[256] D[320] x 65536: -1 213 2037 75038 6574
// analysis + synthesis: 576 samples, input back after 481 within 1e-4: yes
// free format: frame lengths found 313 314 0 (the last has no next header)
// Layer I joint stereo + CRC: layer 1 MPEG-1 48000 Hz 2 ch, 1 frames, 384 samples per channel
// Layer I joint stereo + CRC matches ffmpeg at 42 points within 1e-5: yes
// Layer II joint stereo + CRC: layer 2 MPEG-1 48000 Hz 2 ch, 1 frames, 1152 samples per channel
// Layer II joint stereo + CRC matches ffmpeg at 46 points within 1e-5: yes
// Layer III MPEG-2 intensity stereo: layer 3 MPEG-2 24000 Hz 2 ch, 1 frames, 576 samples per channel
// Layer III MPEG-2 intensity stereo matches ffmpeg at 40 points within 1e-5: yes
use mp3;
use encoding;
use math;

// x rounded to d decimals ("-" only when the rounded value is not zero)
fn fx(x: f64, d: i64) -> str {
    var scale: i64 = 1;
    var i: i64 = 0;
    while i < d {
        scale = scale * 10;
        i = i + 1;
    }
    var neg: bool = x < 0.0;
    var a: f64 = x;
    if neg { a = 0.0 - x; }
    val n: i64 = (a * (scale as f64) + 0.5) as i64;
    if n == 0 { neg = false; }
    var s: str = int_to_str(n / scale);
    if d > 0 {
        var fr: str = int_to_str(n % scale);
        while str_len(fr) < d { fr = "0" + fr; }
        s = s + "." + fr;
    }
    if neg { return "-" + s; }
    return s;
}

fn show_header(label: str, hex: str) {
    val h: Mp3Header = mp3_parse_header(&hex_decode_bytes(hex), 0);
    if !h.ok {
        println(label + ": not a frame header");
        return;
    }
    println(label + ": MPEG-" + if h.version == 25 { "2.5" } else { int_to_str(h.version) } + " layer " + int_to_str(h.layer) + " " + int_to_str(h.bitrate) + " kbit/s " + int_to_str(h.rate) + " Hz mode " + int_to_str(h.mode) + " ext " + int_to_str(h.mode_ext) + " crc " + if h.has_crc { "yes" } else { "no" } + " pad " + int_to_str(h.padding) + " frame " + int_to_str(h.frame_len) + " bytes " + int_to_str(h.samples) + " samples side " + int_to_str(h.side_len));
}

// Walk the frames of a file: offsets, lengths, bitrates.
fn frames(label: str, b: &Vec<i64>) {
    var at: i64 = mp3_id3_size(b);
    var s: str = label + ": id3 " + int_to_str(at) + " bytes; frames";
    var n: i64 = 0;
    while at + 4 <= b.len() {
        val h: Mp3Header = mp3_parse_header(b, at);
        if !h.ok {
            s = s + " (junk at " + int_to_str(at) + ")";
            break;
        }
        s = s + " " + int_to_str(h.frame_len);
        at = at + h.frame_len;
        n = n + 1;
    }
    println(s + " = " + int_to_str(n) + ", ends at " + int_to_str(at) + " of " + int_to_str(b.len()));
}

fn decode_check(label: str, b: &Vec<i64>, step: i64, want: Vec<f64>) {
    val f: Mp3File = mp3_decode_stream(b, true);
    if !f.ok {
        println(label + ": ERROR " + f.error);
        return;
    }
    println(label + ": MPEG-" + if f.version == 25 { "2.5" } else { int_to_str(f.version) } + " " + int_to_str(f.rate) + " Hz " + int_to_str(f.channels) + " ch, Info frame " + if f.info_frame { "yes" } else { "no" } + ", delay " + int_to_str(f.delay) + " padding " + int_to_str(f.padding) + ", " + int_to_str(f.frames) + " frames, " + int_to_str(f.pcm.get(0).len()) + " samples per channel after trimming");
    var worst: f64 = 0.0;
    var shown: str = "";
    var k: i64 = 0;
    var i: i64 = 0;
    while k < want.len() {
        var c: i64 = 0;
        while c < f.channels {
            val got: f64 = f.pcm.get(c).get(i);
            val d: f64 = math_fabs(got - want.get(k));
            if d > worst { worst = d; }
            if k >= 4 && k < 12 { shown = shown + " " + fx(got, 4); }
            k = k + 1;
            c = c + 1;
        }
        i = i + step;
    }
    println(label + " values:" + shown);
    println(label + " matches ffmpeg at " + int_to_str(want.len()) + " points within 1e-5: " + if worst < 0.00001 { "yes" } else { "NO (" + float_to_str(worst) + ")" });
}

// Decode a Layer I/II/III stream without trimming and compare with
// ffmpeg's float decoder at every `step`-th sample of each channel.
fn layer_check(label: str, b: &Vec<i64>, step: i64, want: Vec<f64>) {
    val f: Mp3File = mp3_decode(b);
    if !f.ok {
        println(label + ": ERROR " + f.error);
        return;
    }
    println(label + ": layer " + int_to_str(f.layer) + " MPEG-" + int_to_str(f.version) + " " + int_to_str(f.rate) + " Hz " + int_to_str(f.channels) + " ch" + if f.free_format { " free format" } else { "" } + ", " + int_to_str(f.frames) + " frames, " + int_to_str(f.pcm.get(0).len()) + " samples per channel");
    var worst: f64 = 0.0;
    var k: i64 = 0;
    var i: i64 = 0;
    while k < want.len() {
        var c: i64 = 0;
        while c < f.channels {
            val d: f64 = math_fabs(f.pcm.get(c).get(i) - want.get(k));
            if d > worst { worst = d; }
            k = k + 1;
            c = c + 1;
        }
        i = i + step;
    }
    println(label + " matches ffmpeg at " + int_to_str(want.len()) + " points within 1e-5: " + if worst < 0.00001 { "yes" } else { "NO (" + float_to_str(worst) + ")" });
}

// The Huffman tables as codes, and two codes that are not complete prefix codes.
fn huffman_checks() {
    var ids: Vec<i64> = Vec::new();
    ids.push(1);
    ids.push(2);
    ids.push(3);
    var t: i64 = 5;
    while t <= 13 {
        ids.push(t);
        t = t + 1;
    }
    ids.push(15);
    ids.push(16);
    ids.push(24);
    ids.push(32);
    var codes: i64 = 0;
    var longest: i64 = 0;
    var good: i64 = 0;
    var i: i64 = 0;
    while i < ids.len() {
        val h: Mp3HuffCheck = mp3_huff_check(ids.get(i));
        codes = codes + h.codes;
        if h.max_len > longest { longest = h.max_len; }
        if h.prefix_free && h.complete { good = good + 1; }
        i = i + 1;
    }
    println("huffman tables (ISO 11172-3 Table 3-B.7): " + int_to_str(ids.len()) + " tables, " + int_to_str(codes) + " codewords, longest " + int_to_str(longest) + " bits, complete prefix codes: " + int_to_str(good));
    var c1: Vec<i64> = Vec::new();
    var l1: Vec<i64> = Vec::new();
    c1.push(0);
    l1.push(1);
    c1.push(1);
    l1.push(2);
    c1.push(3);
    l1.push(2);
    val a: Mp3HuffCheck = mp3_prefix_code_check(&c1, &l1);
    var c2: Vec<i64> = Vec::new();
    var l2: Vec<i64> = Vec::new();
    c2.push(0);
    l2.push(1);
    c2.push(2);
    l2.push(2);
    val b: Mp3HuffCheck = mp3_prefix_code_check(&c2, &l2);
    println("code {0, 01, 11}: prefix-free " + if a.prefix_free { "yes" } else { "no" } + "; code {0, 10}: prefix-free " + if b.prefix_free { "yes" } else { "no" } + ", complete " + if b.complete { "yes" } else { "no" });
}

// The synthesis window, and the ISO analysis filterbank (11172-3 Annex
// C.1.3, window C[i] = D[i] / 32) followed by the decoder's synthesis:
// near-perfect reconstruction, delayed by 481 samples.
fn window_checks() {
    println("window D[1] D[64] D[128] D[256] D[320] x 65536: " + int_to_str((mp3_synth_window(1) * 65536.0) as i64) + " " + int_to_str((mp3_synth_window(64) * 65536.0) as i64) + " " + int_to_str((mp3_synth_window(128) * 65536.0) as i64) + " " + int_to_str((mp3_synth_window(256) * 65536.0) as i64) + " " + int_to_str((mp3_synth_window(320) * 65536.0) as i64));
    val nblk: i64 = 18;
    var x: Vec<f64> = Vec::new();
    var n: i64 = 0;
    while n < nblk * 32 {
        val fn_: f64 = n as f64;
        x.push(0.5 * math_sin(0.05 * fn_) + 0.3 * math_sin(1.3 * fn_ + 0.2) + 0.1 * math_cos(2.9 * fn_));
        n = n + 1;
    }
    var cw: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < 512 {
        cw.push(mp3_synth_window(i) / 32.0);
        i = i + 1;
    }
    var m: Vec<f64> = Vec::new();
    var k: i64 = 0;
    while k < 32 {
        i = 0;
        while i < 64 {
            m.push(math_cos(((2 * k + 1) * (i - 16)) as f64 * math_pi() / 64.0));
            i = i + 1;
        }
        k = k + 1;
    }
    // sub[k * nblk + b]
    var sub: Vec<f64> = Vec::new();
    i = 0;
    while i < 32 * nblk {
        sub.push(0.0);
        i = i + 1;
    }
    var b: i64 = 0;
    while b < nblk {
        var y: Vec<f64> = Vec::new();
        i = 0;
        while i < 64 {
            var s: f64 = 0.0;
            var j: i64 = 0;
            while j < 8 {
                val at: i64 = b * 32 + 31 - i - 64 * j;
                if at >= 0 {
                    s = s + cw.get(i + 64 * j) * x.get(at);
                }
                j = j + 1;
            }
            y.push(s);
            i = i + 1;
        }
        k = 0;
        while k < 32 {
            var s: f64 = 0.0;
            i = 0;
            while i < 64 {
                s = s + m.get(k * 64 + i) * y.get(i);
                i = i + 1;
            }
            sub.set(k * nblk + b, s);
            k = k + 1;
        }
        b = b + 1;
    }
    var dec: Mp3Decoder = mp3_decoder();
    val out: Vec<f64> = mp3_synthesize(&mut dec, 0, &sub, nblk);
    var worst: f64 = 0.0;
    n = 0;
    while n + 481 < out.len() {
        val d: f64 = math_fabs(out.get(n + 481) - x.get(n));
        if d > worst { worst = d; }
        n = n + 1;
    }
    println("analysis + synthesis: " + int_to_str(out.len()) + " samples, input back after 481 within 1e-4: " + if worst < 0.0001 { "yes" } else { "NO (" + float_to_str(worst) + ")" });
}

fn main() {
    show_header("FFFB9064", "fffb9064");
    show_header("FFFB92C4", "fffb92c4");
    show_header("FFFA9044", "fffa9044");
    show_header("FFF38844", "fff38844");
    show_header("FFE31864", "ffe31864");
    show_header("FFFD9004", "fffd9004");
    show_header("FFFBF064", "fffbf064");
    show_header("00112233", "00112233");

    // Huffman table 1: (0,0) = 1, (0,1) = 001, (1,0) = 01, (1,1) = 000;
    // bits 1 001 01 000 then table 16 code 1 (0,0): 1001 0100 0100 0000
    var hb: Vec<i64> = Vec::new();
    hb.push(148);
    hb.push(64);
    var hr: Mp3Bits = mp3_bits(hb);
    var hs: str = "";
    var t: i64 = 0;
    while t < 4 {
        val v: i64 = mp3_huff_pair(1, &mut hr);
        hs = hs + " (" + int_to_str(v / 16) + "," + int_to_str(v % 16) + ")";
        t = t + 1;
    }
    val v16: i64 = mp3_huff_pair(16, &mut hr);
    println("table 1 decodes" + hs + ", table 16 then (" + int_to_str(v16 / 16) + "," + int_to_str(v16 % 16) + ") at bit " + int_to_str(hr.pos));
    println("linbits of tables 16 23 24 31: " + int_to_str(mp3_linbits(16)) + " " + int_to_str(mp3_linbits(23)) + " " + int_to_str(mp3_linbits(24)) + " " + int_to_str(mp3_linbits(31)));

    // IMDCT-36 against its defining sum
    var x: Vec<f64> = Vec::new();
    var i: i64 = 0;
    while i < 18 {
        x.push(math_cos((i as f64) * 0.9) - 0.05 * (i as f64));
        i = i + 1;
    }
    val y: Vec<f64> = mp3_imdct36(&x);
    var worst: f64 = 0.0;
    i = 0;
    while i < 36 {
        var s: f64 = 0.0;
        var k: i64 = 0;
        while k < 18 {
            s = s + x.get(k) * math_cos(math_pi() / 72.0 * ((2 * i + 19) * (2 * k + 1)) as f64);
            k = k + 1;
        }
        val d: f64 = math_fabs(s - y.get(i));
        if d > worst { worst = d; }
        i = i + 1;
    }
    println("imdct36 matches the direct sum within 1e-12: " + if worst < 0.000000000001 { "yes" } else { "NO" });

    val m1: Vec<i64> = hex_decode_bytes("49443304000000000023545353450000000f0000034c61766636322e31322e3130320000000000000000000000fffb50c00000000000000000000000" +
        "000000000000496e666f0000000f00000004000004130066666666666666666666666666666666666666666666666699999999999999999999999999" +
        "999999999999999999999999ccccccccccccccccccccccccccccccccccccccccccccccccccffffffffffffffffffffffffffffffffffffffffffffff" +
        "ffff000000004c61766336322e323800000000000000000000000024056a0000000000000413e8788e1e000000000000000000000000000000000000" +
        "00000000000000000000000000fffb50c400000a2c432e55948001811566233ad00007aac38e3385d364f1a1c1081c581f5e1f181c46041e89e5b32e" +
        "5a0fa83b136bf0f860501404030282440c4e68d1a36c1f7880100431383fc1074e74f9ce5fce72feee9f772e0f83e0f87c100c4a00c1fd2001080001" +
        "0400186a3a187b7108004314e4646831b4ca35b8850081c6fb074a76733038a2662584c611848b7bafd6c11d01d3e03944982d5f85a8768c2896ff8e" +
        "e18612e2447affe4899178bc625dfff2e99178bc8974bbfc4415054447bfe0aa00000004796f37ba5bfffb52c404820870212dfdd100217f8ae151cf" +
        "d448594b293000051c00042061b83bc9ab46198b01798380680406300c0201014cebbf65cea5599a75faa84a387bf2adffad76ff57eafde9c6fbfffe" +
        "f00106050498e88067f479be2646128879667b33ac66784879a612e02a807157081a3d4206804701a05fa064b2280a010596450be68827dbf2f295fb" +
        "a8ea0675ee4a75ba62f4e5de8ebd468b6af72bed45bfb8dfba74c1942deeb4edf317f5a135303040713010c04530158182309882de310f07ec334021" +
        "543403c0c73009c0d910fffb52c410800c2c570a15f10001c21e2e7716b00280882401a84012e6003821a602d006a601380125c773e92c211ed5e90a" +
        "7ff60636561bf756ecd2cc7794a5546fe415db7eb66ce4a3db7f5d5b073eff546735b500000ebb5dad1b0d86c361b0b441884f36da732d62991f1a07" +
        "5801005560e0c47a046eb1d6461def497ff04f22823d8f2e5476ffe1ecf1307f2449a9d44efff8f86c3b0e120e24d61b697ffef262a4f58dcf9b41e9" +
        "75a3ffffaa6f9bb8e1f40e728894680bea0c0601c1380e788a7ffbd2004aa00a0020144588e842fffb52c40583c9185b003cc3000000003480000004" +
        "119d3a328ce4c623a12940c020ad99f5eaaab5e51d99f55b2440a0a961e74150d48e0a963c0d4e88941dfc4b7256744bffc44a3dffcef42c35f88ba8" +
        "f08a4c414d45332e313030aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" +
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" +
        "aaaaaaaaaaaaaaaa");
    val m2: Vec<i64> = hex_decode_bytes("49443304000000000023545353450000000f0000034c61766636322e31322e3130320000000000000000000000fff370000000000000000000000000" +
        "000000000000496e666f0000000f0000000600000329005a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b9c9c9c9c" +
        "9c9c9c9c9c9c9c9c9c9c9c9cbdbdbdbdbdbdbdbdbdbdbdbdbdbdbdbdbddededededededededededededededededeffffffffffffffffffffffffffff" +
        "ffff000000004c61766336322e32380000000000000000000000002402a300000000000003295b8a5ddf0000000000fff340640005b0016c3fa08c01" +
