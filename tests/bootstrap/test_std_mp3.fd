        "20164ed8c20841987f820180c65c1f46e2cf4c25bcca760d63988921a14299fff342441005883d5000cd94000ac89ea8019a3800b05882a839ed752e" +
        "e9075eee00a00803f890783dc15097834253bf069d261dfffe5d60a01f1d1de3a04f43a2e10865c107a572d7012012037f1e1b0dbf3488e9ee582a0a" +
        "fc44796a829b740281003c04038606e0fff340440c058c292c00ef000009505a6401dd00009460fa28c66761326b3c38261ee340608218860b60341c" +
        "0148dab565b129755bdffff836a5f50100a8e214024c2014cc80214c82fcce48490c4b03c1412820015a8e836d4d9d626c21150b8801027303705530" +
        "fff342440d0554232e00af00008a685a60015e0000bb14f31596951e625302f08e30400563070042301e0104092c76bf23213fffeaa32c2ea3252eb9" +
        "80400105807cc20432cc33d08cd378510c490290c0f004098004be6b9e3cfe4515d4af38833555c0e953a4c378fff340640c0538495c00cc9c000ad0" +
        "8ea4019a500030e32155a273030203d785ad05bfcfb80704a33f8d889de0c835f6857fab076f369102b5237c340064d1d22264652798d1878ce2f73d" +
        "4317005859100e498208b45bf2539dca9e3bea0ba004c2103627467224fff342440a047c393c1ce6040008a0728439cc08008924d84250223ab8b9e4" +
        "a62f32b6b369aad625c4bd677897ac3617400d191f5d6bb0084091368b973dec9898c6b4c56f5beab4425744afd677897ac36a4c414d45332e313030" +
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaa");
    frames("mono 44.1 kHz", &m1);
    frames("stereo 22.05 kHz", &m2);
    var junk: Vec<i64> = Vec::new();
    junk.push(1);
    junk.push(2);
    println("no frames: " + mp3_decode(&junk).error);
    var dec: Mp3Decoder = mp3_decoder();
    var l2: Vec<i64> = hex_decode_bytes("fffd9004");
    while l2.len() < 600 {
        l2.push(0);
    }
    val zf: Mp3Frame = mp3_decode_frame(&mut dec, &l2, 0);
    var zmax: f64 = 0.0;
    var zi: i64 = 0;
    while zi < zf.pcm.get(0).len() {
        if math_fabs(zf.pcm.get(0).get(zi)) > zmax { zmax = math_fabs(zf.pcm.get(0).get(zi)); }
        zi = zi + 1;
    }
    println("layer II frame of zeros: ok " + if zf.ok { "yes" } else { "no" } + ", " + int_to_str(zf.pcm.len()) + " channels of " + int_to_str(zf.pcm.get(0).len()) + " samples, all zero " + if zmax == 0.0 { "yes" } else { "no" });
    val fh: Mp3Header = mp3_parse_header(&hex_decode_bytes("fffd00c4"), 0);
    println("free-format header: ok " + if fh.ok { "yes" } else { "no" } + ", free " + if fh.free { "yes" } else { "no" } + ", frame length " + int_to_str(fh.frame_len) + " until the next header is found");

    var w1: Vec<f64> = Vec::new();
    w1.push(0.000922308);
    w1.push(-0.068824723);
