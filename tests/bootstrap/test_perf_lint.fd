// fid lint --perf: quadratic patterns in loops are flagged (CP9). The program
// itself runs on every backend; `fid lint --perf` on it warns about
// concat_in_loop (str + str), pop_front (remove(0)), and linear_find
// (contains in a loop). concat_once and remove_tail do not warn.
fn concat_in_loop(v: Vec<str>) -> str {
    var s: str = "";
    var i: i64 = 0;
    while i < v.len() {
        s = s + v.get(i);
        i = i + 1;
    }
    return s;
}

fn pop_front(v: &mut Vec<i64>) -> i64 {
    var n: i64 = 0;
    while v.len() > 0 && n < 3 {
        var x: i64 = v.remove(0);
        n = n + x;
    }
    return n;
}

fn linear_find(v: Vec<i64>, want: i64) -> i64 {
    var hits: i64 = 0;
    var i: i64 = 0;
    while i < v.len() {
        if v.contains(i + want) { hits = hits + 1; }
        i = i + 1;
    }
    return hits;
}

fn concat_once(a: str, b: str) -> str {
    return a + b;  // outside a loop: not quadratic, no warning
}

fn remove_tail(v: &mut Vec<i64>) -> i64 {
    var n: i64 = 0;
    while v.len() > 0 && n < 3 {
        var x: i64 = v.remove(v.len() - 1);  // not index 0: no warning
        n = n + x;
    }
    return n;
}

fn main() -> i64 {
    var vs: Vec<str> = Vec::new();
    vs.push("ab");
    vs.push("cd");
    println(concat_in_loop(vs));
    var v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);
    println(pop_front(&mut v));
    v.push(5);
    println(remove_tail(&mut v));
    var w: Vec<i64> = Vec::new();
    w.push(2);
    println(linear_find(w, 0));
    println(concat_once("x", "y"));
    return 0;
}
