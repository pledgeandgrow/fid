// B19 (RT6's rest): `var v = Vec::new()` written without a type, filled with
// float values that are not literals (a variable, a call), is a Vec<f64>:
// `print(v.get(0))` prints the float, not its bits (lower.fd
// `Lowerer_retype_untyped_vec`; the parser types it from literals only).
// Expected output:
// 2.5
// 3.5
// 6
// 1.25
// done

fn half(x: f64) -> f64 {
    return x / 2.0;
}

fn main() {
    var a: f64 = 2.5;
    var w = Vec::new();
    w.push(a);
    print(w.get(0));
    println("");
    var u = Vec::new();
    u.push(half(7.0));
    u.push(half(5.0));
    print(u.get(0));
    println("");
    var s: f64 = u.get(0) + u.get(1);
    print(s);
    println("");
    var q = Vec::new();
    var k: i64 = 0;
    while k < 3 {
        q.push(half(a));
        k = k + 1;
    }
    print(q.get(2));
    println("");
    println("done");
}
