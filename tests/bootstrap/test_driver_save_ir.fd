// Driver goal RL10 (docs/roadmap/llvm-roadmap.md): the module codec of
// compiler/ir_ser.fd. scripts/driver-goals-check.sh builds this with
// `fid emit --target x86_64-linux --save-ir t.fir`, then `fid emit-ir
// t.fir` (the machine layer alone on the IR read back) and, on a Linux
// host, checks that both images print the lines below. The program uses
// what the file must carry besides functions: a global, a struct layout,
// string constants, an enum payload and a HashMap.
// Expected output:
// counter 3
// point 7 -2
// hello, ir
// some 42
// map 2 30

struct Point {
    x: i64,
    y: i64,
}

enum Maybe {
    Some(i64),
    Nothing,
}

var g_count: i64 = 0;

fn bump() {
    g_count = g_count + 1;
}

fn shift(p: Point, dx: i64) -> Point {
    return Point { x: p.x + dx, y: p.y };
}

fn find(v: i64) -> Maybe {
    if v > 0 {
        return Maybe::Some(v);
    }
    return Maybe::Nothing;
}

fn main() -> i64 {
    bump();
    bump();
    bump();
    println("counter " + int_to_str(g_count));
    var p: Point = Point { x: 2, y: 0 - 2 };
    p = shift(p, 5);
    println("point " + int_to_str(p.x) + " " + int_to_str(p.y));
    println("hello, " + "ir");
    match find(42) {
        Maybe::Some(x) => {
            println("some " + int_to_str(x));
        }
        Maybe::Nothing => {
            println("nothing");
        }
    }
    var m: HashMap<str, i64> = HashMap::new();
    m.insert("a", 10);
    m.insert("b", 20);
    println("map " + int_to_str(m.len()) + " " + int_to_str(m.get("a") + m.get("b")));
    return 0;
}
