// expect-error: of the spawned call is a closure that captures 'name' of type str
// Bugs roadmap BG75: a function value counted as @send whatever it
// captures: this closure shares the string `name` (and its owner count)
// with the spawned thread, while the main thread keeps using it.
fn run(f: fn(i64) -> i64) -> i64 {
    return f(1);
}

fn main() -> i64 {
    val name: str = "w" + int_to_str(7);
    val t = spawn run(|x: i64| x + str_len(name));
    println(name);
    println(int_to_str(await t));
    return 0;
}
