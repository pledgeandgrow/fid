// expect-error: if condition must be bool, got str
// Bugs roadmap BG19: the condition of an `if` used as a value was not
// checked (an `if` statement's is): a string was taken as the condition.
fn main() -> i64 {
    val s: str = "yes";
    val n: i64 = if s { 1 } else { 2 };
    println(int_to_str(n));
    return 0;
}
