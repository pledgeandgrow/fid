// expect-error: through `dyn`, a dynamic dispatch
// Bugs roadmap BG377: @realtime accepted a call through `dyn T`, a dynamic
// dispatch (reference §11).
cap T {
    fn t(self) -> i64;
}
struct A { a: i64 }
impl T for A {
    fn t(self: A) -> i64 {
        return self.a;
    }
}
@realtime
fn f(d: dyn T) -> i64 {
    return d.t();
}
fn main() {
    val a = A { a: 1 };
    println(f(a as dyn T));
}
