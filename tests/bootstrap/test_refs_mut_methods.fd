// Test: &mut T auto-deref for method calls (Issue 45)
// Methods on &mut T should work without explicit deref.

struct Counter {
    count: i64,
}

impl Counter {
    fn increment(self: &mut Counter) {
        self.count = self.count + 1;
    }

    fn get(self: &Counter) -> i64 {
        return self.count;
    }

    fn add(self: &mut Counter, n: i64) {
        self.count = self.count + n;
    }
}

fn main() {
    var c: Counter = Counter { count: 0 };
    c.increment();
    c.increment();
    c.add(10);
    val result: i64 = c.get();
    println(result);
}
