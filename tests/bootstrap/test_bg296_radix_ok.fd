// Bugs roadmap BG296: valid radix literals still lex, and `_` after a hex
// literal still ends it (reference §1.5: `0xFF_FF` is `0xFF` then `_FF`).
//
// Expected output:
// 255 10 15 0 1 0
// 5
fn main() -> i64 {
    println(f"{0xFF} {0b1010} {0o17} {0x0} {0b1} {0o0}");
    val _F: i64 = 5;
    val k = 0xF + _F - 15;
    println(k);
    return 0;
}
