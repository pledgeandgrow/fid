// stdlib/http status_text: every common status code has its reason phrase,
// so build_response never writes `HTTP/1.1 503 Unknown` for a code a
// service really sends (AD6, docs/book/09-service.md).
// Expected output:
// 200 OK
// 206 Partial Content
// 307 Temporary Redirect
// 308 Permanent Redirect
// 410 Gone
// 411 Length Required
// 414 URI Too Long
// 415 Unsupported Media Type
// 416 Range Not Satisfiable
// 422 Unprocessable Content
// 501 Not Implemented
// 502 Bad Gateway
// 503 Service Unavailable
// 504 Gateway Timeout
// 599 Unknown
// HTTP/1.1 503 Service Unavailable
use http;

fn show(code: i64) {
    println(int_to_str(code) + " " + status_text(code));
}

fn main() -> i64 {
    show(200);
    show(206);
    show(307);
    show(308);
    show(410);
    show(411);
    show(414);
    show(415);
    show(416);
    show(422);
    show(501);
    show(502);
    show(503);
    show(504);
    show(599);
    val resp: str = build_response(503, "text/plain", "down");
    val first: str = str_slice(resp, 0, 32);
    println(first);
    return 0;
}
