// LG14: an async method of a generic impl runs as a task: it runs until it
// first waits, then its caller goes on, as an async function does (before,
// each instance ran to its end at the call: start, end, called). The
// interpreter runs a task to its end at once (LG11), so this order is
// checked on the compiled backends only.
//@ backends: ccompile,emit
// Expected output:
// start
// called
// end
// hi
// 3
use task;

struct Cell<T> { v: T, k: i64 }

impl<T> Cell<T> {
    async fn get(self) -> Future<T> {
        println("start");
        task_yield();
        println("end");
        return self.v;
    }
    fn plain(self) -> i64 {
        return self.k;
    }
}

fn main() {
    val b: Cell<str> = Cell { v: "hi", k: 3 };
    val f = b.get();
    println("called");
    println(await f);
    println(b.plain());
}
