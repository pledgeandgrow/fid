// BG224 (docs/roadmap/bugs-roadmap.md): xml and toml refuse input nested
// deeper than their limit instead of overflowing the stack. A document at
// the limit still parses and is destroyed; the limit follows the backend
// where the stack is small (xml_max_depth: 48 on WebAssembly, where the
// parser overflows at 64; 128 elsewhere), so this prints what holds on
// every backend. The large inputs of the entry (400,000 elements, a
// million brackets) were checked through ccompile: too slow in the
// interpreter for a suite test.
//
// Expected output:
// xml, 150 unclosed elements, lenient: a
// xml, a document at the limit parses to its depth: true
// xml, one deeper is refused and names the limit: true
// toml, a document at the limit parses: true
// toml, one deeper is refused and names the limit: true
// toml, 140 inline tables deep, strict: false
// toml, 400 arrays deep, lenient: 1
use string;
use toml;
use xml;

fn rep(s: str, n: i64) -> str {
    var out = "";
    var i = 0;
    while i < n {
        out = out + s;
        i = i + 1;
    }
    return out;
}

fn levels(node: XmlNode) -> i64 {
    var r: XmlNode = node;
    var k: i64 = 1;
    while r.children.len() > 0 {
        r = r.children.get(0);
        k = k + 1;
    }
    return k;
}

fn main() -> i64 {
    var root: XmlNode = xml_parse(rep("<a>", 150));
    print("xml, 150 unclosed elements, lenient: ");
    print(root.tag);
    print("\n");

    val xl = xml_max_depth();
    var d_at: XmlDoc = xml_load(rep("<a>", xl) + rep("</a>", xl));
    print("xml, a document at the limit parses to its depth: ");
    println(d_at.ok && levels(d_at.root) == xl);
    var d_over: XmlDoc = xml_load(rep("<a>", xl + 1) + rep("</a>", xl + 1));
    print("xml, one deeper is refused and names the limit: ");
    println(!d_over.ok && str_contains(d_over.error, "nested deeper than " + int_to_str(xl)));

    val tl = toml_max_depth();
    var t_at: TomlDoc = toml_load("x = " + rep("[", tl) + rep("]", tl) + "\n");
    print("toml, a document at the limit parses: ");
    println(t_at.ok);
    var t_over: TomlDoc = toml_load("x = " + rep("[", tl + 1) + rep("]", tl + 1) + "\n");
    print("toml, one deeper is refused and names the limit: ");
    println(!t_over.ok && str_contains(t_over.error, "nested deeper than " + int_to_str(tl)));

    var t140: TomlDoc = toml_load("x = " + rep("{a = ", 140) + "1" + rep("}", 140) + "\n");
    print("toml, 140 inline tables deep, strict: ");
    println(t140.ok);

    // the lenient parser keeps the failed key as one "invalid" entry
    var tl_entries: Vec<TomlEntry> = toml_parse("x = " + rep("[", 400) + "\n");
    print("toml, 400 arrays deep, lenient: ");
    println(tl_entries.len());
    return 0;
}
