// expect-error: associated function 'P::make' parameter 1 expects 'i64', got 'str'
// Bugs roadmap BG18: an associated function call (`P::make(..)`) checked
// only how many arguments it had, not their types.
struct P {
    n: i64,
}

impl P {
    fn make(n: i64) -> P {
        return P { n: n };
    }
}

fn main() -> i64 {
    val p: P = P::make("str");
    println(int_to_str(p.n));
    return 0;
}
