// Bugs roadmap BG390: a variadic method (`fn tot(self, ...ns: i64)`)
// called with several arguments got the raw words, never packed into the
// Vec (`ns` was the first extra argument). compiler/lower.fd
// Lowerer_method_call_args packs them (Lowerer_args_for_params), as
// Lowerer_pack_variadic does for a function. Reference §2.1.
//
// Expected output:
// 103
// 100
// 110

struct C { k: i64 }

impl C {
    fn tot(self, ...ns: i64) -> i64 {
        var s = self.k;
        for n in ns {
            s = s + n;
        }
        return s;
    }
}

fn main() {
    val c = C { k: 100 };
    println(c.tot(1, 2));
    println(c.tot());
    println(c.tot(1, 2, 3, 4));
}
