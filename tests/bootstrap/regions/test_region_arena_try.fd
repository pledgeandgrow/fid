// Regions freed in one step (proposal 0005): `?` inside a region. The
// error is made in region mode; `?` leaves the function's regions before it
// takes its owner, so the error is copied out of the region's arena before
// the arena goes. Same output with FID_REGION_ARENA=1 (C build) as without.
// Expected output:
// 7
// not a number: bad
// 8

fn parse_num(s: str) -> Result<i64, str> {
    if s == "bad" {
        return Result::Err("not a number: " + s);
    }
    return Result::Ok(str_len(s));
}

fn sum_lens(xs: Vec<str>) -> Result<i64, str> {
    var total: i64 = 0;
    region r {
        for x in xs {
            val t: str = x + "d";
            val n: i64 = parse_num(t)?;
            total = total + n;
        }
    }
    return Result::Ok(total);
}

fn show(r: Result<i64, str>) {
    match r {
        Result::Ok(n) => { println(n); }
        Result::Err(e) => { println(e); }
    }
}

fn main() {
    var a: Vec<str> = Vec::new();
    a.push("ab");
    a.push("cde");
    show(sum_lens(a));
    var b: Vec<str> = Vec::new();
    b.push("xy");
    b.push("ba");
    show(sum_lens(b));
    var c: Vec<str> = Vec::new();
    c.push("abcd");
    c.push("ef");
    show(sum_lens(c));
}
