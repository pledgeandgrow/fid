// expect-error: undefined variable 'x'
// Region inference test: variable escape from region (should fail).
// value x is allocated in region r, but we try to use it after the block.
// This should produce a region error.
fn main() -> i64 !IO {
    region r {
        val x = 42;
    }
    // x is no longer valid here — use-after-free
    print(x);
    return 0;
}
