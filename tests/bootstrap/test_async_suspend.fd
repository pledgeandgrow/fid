// `async fn` is a task: it runs until it first waits, then its caller goes on.
use task;

async fn slow(id: i64, ms: i64) -> Future<i64> {
    print(id);
    task_sleep(ms);
    print(id + 10);
    return id * 2;
}

async fn outer(id: i64) -> Future<i64> {
    val a = slow(id, 20);
    val b = slow(id + 1, 5);
    return (await a) + (await b);
}

async fn word(s: str) -> Future<str> {
    task_yield();
    return s + "!";
}

async fn fails_never(a: i64, b: i64, c: i64, d: i64, e: i64) -> Future<i64> {
    task_yield();
    return a + b * 10 + c * 100 + d * 1000 + e * 10000;
}

fn main() -> i64 {
    val f = outer(1);
    print(100);
    print(await f);
    print(await word("hi"));
    print(await fails_never(1, 2, 3, 4, 5));
    return 0;
}
