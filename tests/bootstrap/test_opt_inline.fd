// VF5: inlining (compiler/iropt.fd iro_inline). Small one-block callees
// are copied into their callers; the copy must map each parameter to its
// own argument (order matters for `-`, `/`, `<<`), keep the callee's
// constants, work inside loops and when an inlined callee's result feeds
// another inlined call. Any wrong mapping changes the printed checksum.

fn sub(a: i64, b: i64) -> i64 { return a - b; }
fn div(a: i64, b: i64) -> i64 { return a / b; }
fn shl(a: i64, b: i64) -> i64 { return a << b; }
fn pick3(a: i64, b: i64, c: i64) -> i64 { return a * 100 + b * 10 + c; }
fn twice(x: i64) -> i64 { return x + x; }
fn k7() -> i64 { return 7; }
fn same(a: i64, b: i64) -> i64 { return a * a - b; }
fn narrow(a: u8, b: u8) -> u8 { return a - b; }
fn mix(a: i32, b: i64) -> i64 { return (a as i64) * 3 - b; }

fn main() -> i64 {
    println(sub(10, 3));
    println(sub(3, 10));
    println(div(100, 7));
    println(div(7, 100));
    println(shl(3, 4));
    println(pick3(1, 2, 3));
    println(pick3(3, 2, 1));
    println(twice(twice(twice(5))));
    println(sub(twice(k7()), k7()));
    println(same(9, 4));
    println(narrow(200, 55));
    println(mix(7, 4));
    var acc: i64 = 0;
    var i: i64 = 0;
    while i < 50 {
        acc = acc + pick3(i % 10, sub(i, 3) % 10, div(i, 4) % 10);
        acc = acc - same(i % 5, i % 3);
        i = i + 1;
    }
    println(acc);
    // the same callee with the same argument twice
    val z: i64 = 6;
    println(sub(z, z));
    println(pick3(z, z, z));
    return 0;
}
