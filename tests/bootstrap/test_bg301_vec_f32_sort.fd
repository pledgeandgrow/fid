// BG301 (docs/roadmap/bugs-roadmap.md): `Vec<f32>.sort()` orders the
// elements as numbers (BG179 did it for Vec<f64> only): negative values
// came out backwards, and on --nat after every positive one.
//
// Expected output:
// -7.5 -1.25 0.5 9
// -3 -0.5 0 2.5 100

fn idf(x: f32) -> f32 {
    return x;
}

fn main() {
    var v: Vec<f32> = Vec::new();
    v.push(idf(-1.25));
    v.push(idf(0.5));
    v.push(idf(9.0));
    v.push(idf(-7.5));
    v.sort();
    println(f"{v[0]} {v[1]} {v[2]} {v[3]}");
    var w: Vec<f32> = Vec::new();
    w.push(idf(100.0));
    w.push(idf(0.0));
    w.push(idf(-3.0));
    w.push(idf(2.5));
    w.push(idf(-0.5));
    w.sort();
    println(f"{w[0]} {w[1]} {w[2]} {w[3]} {w[4]}");
}
