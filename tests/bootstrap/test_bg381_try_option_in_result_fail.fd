// expect-error: the ? operator on an Option returns its None, but 'b' returns Result<i64, E>
// Bugs roadmap BG381: `?` on an Option inside a function returning a Result
// was accepted; None came back as an Err holding the word 0, so `e.msg` was
// a null dereference on pe_ir.
struct E { code: i64, msg: str }
fn a() -> Option<i64> { return Option::None; }
fn b() -> Result<i64, E> {
    val x = a()?;
    return Result::Ok(x);
}
fn main() {
    match b() {
        Result::Ok(v) => { println(v); }
        Result::Err(e) => { println(e.code); println(e.msg); }
    }
}
