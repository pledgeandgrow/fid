// expect-error: a unit compares only with a value of its own unit (Len)
// CL10 (fid): metres compared with seconds is a type error.

@dimension(m = 1)
struct Len {
    value: f64,
}

@dimension(s = 1)
struct Time {
    value: f64,
}

fn main() -> i64 {
    val d: Len = Len { value: 3.0 };
    val t: Time = Time { value: 2.0 };
    if d < t {
        println("less");
    }
    return 0;
}
