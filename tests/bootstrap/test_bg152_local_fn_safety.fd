// Bugs roadmap BG152: a local bound to a named function is checked as a
// call of that function: under @no-recursion a call through `val f = step`
// is accepted when `step` itself keeps the rule, and a local closure's
// calls are checked where they are written.
//
// Expected output:
// 8
// 9

@no-recursion
fn step(x: i64) -> i64 {
    return x + 1;
}

@no-recursion
fn run(n: i64) -> i64 {
    val f = step;
    return f(n);
}

@no-recursion
fn run2(n: i64) -> i64 {
    val g = fn(x: i64) -> i64 => x * 3;
    return g(n);
}

fn main() -> i64 {
    println(run(7));
    println(run2(3));
    return 0;
}
