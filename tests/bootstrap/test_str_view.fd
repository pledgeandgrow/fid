// Release D16: string views slice without copying; zero bytes are bytes.
use string;

fn main() -> i64 {
    var line: str = "  key = value ; k2 = 42  ";
    var v: StrView = str_view_all(line);
    var parts: Vec<StrView> = v.split(";");
    println(parts.len());                          // 2
    var kv: Vec<StrView> = parts.get(0).split("=");
    println(kv.get(0).trim().to_str());            // key
    println(kv.get(1).trim().eq_str("value"));     // true
    var kv2: Vec<StrView> = parts.get(1).split("=");
    println(kv2.get(1).trim().parse_int(-1));      // 42
    var s: StrView = str_view("hello world", 6, 11);
    println(s.length());                           // 5
    println(s.starts_with("wor"));                 // true
    println(s.ends_with("ld"));                    // true
    println(s.find("rl"));                         // 2
    println(s.slice(1, 3).to_str());               // or
    println(s.eq(&str_view("a world", 2, 7)));     // true
    println(s.byte_at(0));                         // 119
    println(s.byte_at(9));                         // -1
    return 0;
}
