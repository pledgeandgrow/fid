// BG298 (docs/roadmap/bugs-roadmap.md): under `fid run`, a global f32 with
// a float initializer read as 0: Interpreter_init_globals stored the f64
// (8 bytes) whatever the global's type, and the f32 load read its low half
// (0 for 1.5). The compiled backends store the f32.
//
// Expected output:
// 1.5
// 2.5
// -0.25
// 3

var gf: f32 = 1.5;
var gneg: f32 = -0.25;
var gd: f64 = 3.0;

fn main() {
    println(f"{gf}");
    gf = gf + 1.0;
    println(f"{gf}");
    println(f"{gneg}");
    println(f"{gd}");
}
