// expect-error: compile_error() reports while compiling: call it in comptime code
// expect-error: compile_error takes one argument, the message (a str)
// compile_error reports at compile time (comptime only), and takes exactly
// one str.
fn main() -> i64 {
    compile_error("not allowed here");
    comptime { compile_error(41 + 1) };
    return 0;
}
