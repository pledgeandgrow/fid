// Test stdlib functions needed for self-hosting.
// Covers: str_bytes, str_from_bytes, str_split, str_split_char, str_trim_start,
// str_trim_end, str_parse_hex, str_parse_int_range, file_write_bytes,
// file_read_bytes, file_delete, file_size.
use core;
use vec;
use file;

fn test_str_bytes() -> i64 {
    val bytes = str_bytes("AB");
    if bytes.len() != 2 { return 0; }
    if bytes.get(0) != 65 { return 0; }
    if bytes.get(1) != 66 { return 0; }
    return 1;
}

fn test_str_from_bytes() -> i64 {
    val bytes = Vec::new();
    bytes.push(72);
    bytes.push(105);
    val s = str_from_bytes(bytes);
    if !str_equal(s, "Hi") { return 0; }
    return 1;
}

fn test_str_split() -> i64 {
    val parts = str_split("a,b,c", ",");
    if parts.len() != 3 { return 0; }
    if !str_equal(parts.get(0), "a") { return 0; }
    if !str_equal(parts.get(1), "b") { return 0; }
    if !str_equal(parts.get(2), "c") { return 0; }
    return 1;
}

fn test_str_split_char() -> i64 {
    val parts = str_split_char("x.y.z", 46);
    if parts.len() != 3 { return 0; }
    if !str_equal(parts.get(0), "x") { return 0; }
    if !str_equal(parts.get(1), "y") { return 0; }
    if !str_equal(parts.get(2), "z") { return 0; }
    return 1;
}

fn test_str_trim_start() -> i64 {
    val s = str_trim_start("  hello");
    if !str_equal(s, "hello") { return 0; }
    val s2 = str_trim_start("no_trim");
    if !str_equal(s2, "no_trim") { return 0; }
    return 1;
}

fn test_str_trim_end() -> i64 {
    val s = str_trim_end("hello  ");
    if !str_equal(s, "hello") { return 0; }
    val s2 = str_trim_end("no_trim");
    if !str_equal(s2, "no_trim") { return 0; }
    return 1;
}

fn test_str_parse_hex() -> i64 {
    if str_parse_hex("ff") != 255 { return 0; }
    if str_parse_hex("0xFF") != 255 { return 0; }
    if str_parse_hex("0x1A") != 26 { return 0; }
    if str_parse_hex("DEAD") != 57005 { return 0; }
    if str_parse_hex("0x") != 0 { return 0; }
    return 1;
}

fn test_str_parse_int_range() -> i64 {
    if str_parse_int_range("abc123def", 3, 6) != 123 { return 0; }
    if str_parse_int_range("42", 0, 2) != 42 { return 0; }
    if str_parse_int_range("x999y", 1, 4) != 999 { return 0; }
    return 1;
}

fn test_str_slice() -> i64 {
    val s = str_slice("hello world", 0, 5);
    if !str_equal(s, "hello") { return 0; }
    val s2 = str_slice("hello world", 6, 11);
    if !str_equal(s2, "world") { return 0; }
    return 1;
}

fn test_file_write_read_bytes() -> i64 {
    val bytes = Vec::new();
    bytes.push(72);
    bytes.push(101);
    bytes.push(108);
    bytes.push(108);
    bytes.push(111);
    val rc = file_write_bytes("/tmp/_fides_test_bin", bytes);
    if rc != 0 { return 0; }
    val sz = file_size("/tmp/_fides_test_bin");
    if sz != 5 { return 0; }
    val read_back = file_read_bytes("/tmp/_fides_test_bin");
    if read_back.len() != 5 { return 0; }
    if read_back.get(0) != 72 { return 0; }
    if read_back.get(4) != 111 { return 0; }
    val drc = file_delete("/tmp/_fides_test_bin");
    if drc != 0 { return 0; }
    if file_exists("/tmp/_fides_test_bin") { return 0; }
    return 1;
}

fn main() -> i64 {
    if test_str_bytes() != 1 { println("FAIL: str_bytes"); return 1; }
    if test_str_from_bytes() != 1 { println("FAIL: str_from_bytes"); return 1; }
    if test_str_split() != 1 { println("FAIL: str_split"); return 1; }
    if test_str_split_char() != 1 { println("FAIL: str_split_char"); return 1; }
    if test_str_trim_start() != 1 { println("FAIL: str_trim_start"); return 1; }
    if test_str_trim_end() != 1 { println("FAIL: str_trim_end"); return 1; }
    if test_str_parse_hex() != 1 { println("FAIL: str_parse_hex"); return 1; }
    if test_str_parse_int_range() != 1 { println("FAIL: str_parse_int_range"); return 1; }
    if test_str_slice() != 1 { println("FAIL: str_slice"); return 1; }
    if test_file_write_read_bytes() != 1 { println("FAIL: file_write_read_bytes"); return 1; }
    println("All self-host stdlib tests passed");
    return 0;
}
