// Expected to fail at run time (MI6, docs/roadmap/llvm-roadmap.md): the
// division by zero on the third checked line of `step` panics through the
// function's cold block for that line, past the cold blocks of the checks
// before it (an addition and a multiplication on their own lines), which
// do not fire. The output before the panic is "before" and "7"; the panic
// is "Division by zero" (with " at line N" where the backend adds lines).

fn step(a: i64, b: i64) -> i64 {
    val s: i64 = a + b;
    val p: i64 = s * 3;
    val q: i64 = p / b;
    return q;
}

fn main() {
    print("before\n");
    println(step(4, 3));
    var zero: i64 = 0;
    println(step(5, zero));
    print("unreachable\n");
}
