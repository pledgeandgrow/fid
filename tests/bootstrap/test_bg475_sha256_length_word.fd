// Bugs roadmap BG475: stdlib/crypto.fd crypto_sha256_bytes wrote four
// zeros for the high 32 bits of the message bit length (FIPS 180-4
// §5.1.1 appends all 64 bits), so every message of 2^29 bytes or more
// hashed a wrong final block. A 512 MiB input is too large for the suite:
// this checks that the full 64-bit length word leaves the digests of
// short messages (high word 0) as they were, at the padding edges 55, 56
// and 64 bytes (first 8 digest bytes, from Python hashlib).
//
// Expected output:
// e3b0c44298fc1c14
// ba7816bf8f01cfea
// 9f4390f8d30c2dd9
// b35439a4ac6f0948
// ffe054fe7ae0cb6d
// 41edece42d63e8d9

use crypto;
use encoding;

fn head(n: i64, c: i64) -> str {
    var m: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < n {
        m.push(c);
        i = i + 1;
    }
    val d: Vec<i64> = crypto_sha256_bytes(m);
    var h: Vec<i64> = Vec::new();
    i = 0;
    while i < 8 {
        h.push(d.get(i));
        i = i + 1;
    }
    return hex_encode_bytes(h);
}

fn main() {
    println(head(0, 97));
    var abc: Vec<i64> = Vec::new();
    abc.push(97);
    abc.push(98);
    abc.push(99);
    val d: Vec<i64> = crypto_sha256_bytes(abc);
    var h: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 8 {
        h.push(d.get(i));
        i = i + 1;
    }
    println(hex_encode_bytes(h));
    println(head(55, 97));
    println(head(56, 97));
    println(head(64, 97));
    println(head(1000, 97));
}
