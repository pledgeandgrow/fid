// expect-error: associated function 'P::new' expects 1 args, got 2
//! error: associated function 'P::new' expects 1 args, got 2
// TL2: a test per diagnostic of the type, borrow and escape checks.
// An associated function takes its declared parameters.

struct P {
    x: i64,
}

impl P {
    pub fn new(x: i64) -> P {
        return P { x: x };
    }
}

fn main() -> i64 {
    val p = P::new(1, 2);
    println(p.x);
    return 0;
}
