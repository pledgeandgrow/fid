// expect-error: cannot store i64 in a Vec<str>
// Expected to FAIL (RT6): `var v = Vec::new()` written without a type is a
// Vec<str> from its first push of a string (here a call's result, which only
// the type checker knows), so pushing an integer onto it later is a type
// error. Before, the Vec stayed untyped and took both, and the string was
// read back as an integer.
fn word() -> str {
    return "w" + int_to_str(1);
}

fn main() {
    var v = Vec::new();
    v.push(word());
    val n: i64 = 42;
    v.push(n);
    println(v.len());
}
