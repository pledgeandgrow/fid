// `&&` and `||` evaluate their right operand only when it decides the result.

var calls: i64 = 0;

fn touch(result: bool) -> bool {
    calls = calls + 1;
    return result;
}

fn contains(v: Vec<i64>, x: i64) -> bool {
    var i: i64 = 0;
    // The guard keeps v.get(i) in bounds: i == v.len() stops before get.
    while i <= v.len() {
        if i < v.len() && v.get(i) == x {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn main() {
    val a = false && touch(true);
    val b = true || touch(false);
    print(a); print(" "); print(b); print(" calls="); print(calls); print("\n");

    val c = true && touch(false);
    val d = false || touch(true);
    print(c); print(" "); print(d); print(" calls="); print(calls); print("\n");

    // Nested and mixed.
    val e = (false && touch(true)) || (true && touch(true));
    print(e); print(" calls="); print(calls); print("\n");

    val v: Vec<i64> = Vec::new();
    v.push(4); v.push(7);
    print(contains(v, 7)); print(" "); print(contains(v, 9)); print("\n");
}
