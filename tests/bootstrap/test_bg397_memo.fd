// Bugs roadmap BG397: stdlib/memo.fd's get_or_compute and clear changed a
// by-value `self`; they now take `self: &mut Memo`.
//
// Expected output:
// 16
// 16
// 25
// 2
// 0

use memo;

fn square(x: i64) -> i64 {
    return x * x;
}

fn main() -> i64 {
    var m = Memo::new();
    println(m.get_or_compute(4, square));
    println(m.get_or_compute(4, square));
    println(m.get_or_compute(5, square));
    println(m.size());
    m.clear();
    println(m.size());
    return 0;
}
