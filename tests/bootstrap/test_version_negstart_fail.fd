// ME25 (compiler/iropt.fd iro_version, `version`, on by default on the
// native paths since Nov 17): expected to fail at run time (index out of
// bounds: -1), after printing 12. `sum_from`'s loop starts at a parameter;
// its versioned copy, without bounds checks, runs only when `n > 0` and
// then `n <= v.len() && i >= 0`. The second call starts at i = -1: the
// guard's `i >= 0` fails, so the original, checked loop runs and panics
// reading v[-1] (the copy would read before the buffer). "unreachable" is
// never printed. tests/tooling/version-default-check.sh runs this with
// version on and off: the same output and a failing exit status both times.

fn sum_from(v: & Vec<i64>, start: i64, n: i64) -> i64 {
    var total: i64 = 0;
    var i: i64 = start;
    while i < n {
        total = total + v.get(i);
        i = i + 1;
    }
    return total;
}

fn main() {
    var v: Vec<i64> = Vec::new();
    var k: i64 = 1;
    while k <= 5 {
        v.push(k);
        k = k + 1;
    }
    var two: i64 = str_len("ab");
    var five: i64 = str_len("abcde");
    println(sum_from(& v, two, five));
    println(sum_from(& v, two - 3, five));
    println("unreachable");
}
