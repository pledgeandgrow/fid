// expect-error: pattern 300 does not fit the value matched, a 'u8': the arm can never match
// Bugs roadmap BG380: a literal pattern that cannot fit the scrutinee's type
// (300 against a u8) was accepted, an arm that can never match.
fn main() {
    val b: u8 = 44;
    match b {
        300 => {
            println("never");
        }
        _ => {
            println("o");
        }
    }
}
