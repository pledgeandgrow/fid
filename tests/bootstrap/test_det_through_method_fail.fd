// expect-error: function 'total' is @deterministic but has effect '!IO' through a method it calls
// Bugs roadmap BG22: effect inference scans names, and a method call
// `l.log(..)` names no function: `total` reached IO through `helper`,
// which calls a method that prints, and was accepted as @deterministic.
// The method calls the type checker resolved are followed now.
struct Logger {
    n: i64,
}

impl Logger {
    fn log(self: Logger, v: i64) {
        println(int_to_str(v));
    }
}

fn helper(v: i64) -> i64 {
    val l: Logger = Logger { n: 0 };
    l.log(v);
    return v + 1;
}

@deterministic
fn total(v: i64) -> i64 {
    return helper(v) * 2;
}

fn main() -> i64 {
    println(int_to_str(total(3)));
    return 0;
}
