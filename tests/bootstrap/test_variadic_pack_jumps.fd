// L8E: `break` and `continue` in a loop over a pack (`for x in xs`, which
// is unrolled at compile time, one copy per element) act as in any loop:
// `continue` goes on to the next element, `break` skips the rest
// (mono.fd mono_pack_unroll_jumps: each copy in a one-pass loop, a flag
// set by `break`). A break of a loop inside the body stays that loop's.
//
// Expected output:
// until_stop: [int 1][yes]
// until_stop: [int 2][str go]
// until_stop: ''
// skip_bools: [int 1][str a][int 9] seen 5
// inner: [str a/2][int 3/2]
// first_two: [str p][int 1]

fn describe<T>(x: T) -> str {
    return "other";
}

fn describe(x: i64) -> str {
    return "int " + int_to_str(x);
}

fn describe(x: str) -> str {
    return "str " + x;
}

fn describe(x: bool) -> str {
    if x {
        return "yes";
    }
    return "no";
}

fn is_stop<T>(x: T) -> bool {
    return false;
}

fn is_stop(x: str) -> bool {
    return x == "stop";
}

fn is_bool<T>(x: T) -> bool {
    return false;
}

fn is_bool(x: bool) -> bool {
    return true;
}

fn until_stop<T>(...xs: T) -> str {
    var out: str = "";
    for x in xs {
        if is_stop(x) {
            break;
        }
        out = out + "[" + describe(x) + "]";
    }
    return out;
}

fn skip_bools<T>(...xs: T) -> str {
    var out: str = "";
    var seen: i64 = 0;
    for x in xs {
        seen = seen + 1;
        if is_bool(x) {
            continue;
        }
        out = out + "[" + describe(x) + "]";
    }
    return out + " seen " + int_to_str(seen);
}

fn inner<T>(...xs: T) -> str {
    var out: str = "";
    for x in xs {
        var j: i64 = 0;
        while true {
            j = j + 1;
            if j == 2 {
                break;
            }
        }
        if is_bool(x) {
            continue;
        }
        out = out + "[" + describe(x) + "/" + int_to_str(j) + "]";
    }
    return out;
}

fn first_two<T>(...xs: T) -> str {
    var out: str = "";
    var n: i64 = 0;
    for x in xs {
        match n {
            2 => {
                break;
            }
            _ => {
                out = out + "[" + describe(x) + "]";
                n = n + 1;
            }
        }
    }
    return out;
}

fn main() -> i64 {
    println("until_stop: " + until_stop(1, true, "stop", 5));
    println("until_stop: " + until_stop(2, "go"));
    println("until_stop: '" + until_stop() + "'");
    println("skip_bools: " + skip_bools(1, false, "a", true, 9));
    println("inner: " + inner("a", true, 3));
    println("first_two: " + first_two("p", 1, false, "q"));
    return 0;
}
