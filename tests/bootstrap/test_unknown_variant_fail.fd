// expect-error: enum 'Op' has no variant 'Ne'
// Expected to FAIL: matching on / constructing a variant the enum does not have.
enum Op { Add, Neq }
fn f(o: Op) -> i64 {
    match o {
        Op::Add => { return 1; }
        Op::Ne => { return 2; }   // no such variant (the real one is Neq)
        _ => { return 0; }
    }
    return 0;
}
fn main() { print(int_to_str(f(Op::Add))); }
