// Real generics (proposal 0002): type arguments inferred at each call,
// payloads keep their type (an Option<f64> holds an f64), generic impls
// are instantiated per receiver type, bounds are checked.
cap Show {
    fn show(self) -> str;
}

struct Pt {
    x: i64,
}

impl Show for Pt {
    pub fn show(self: Pt) -> str { return "pt" + int_to_str(self.x); }
}

enum Slot<T> {
    Full(T),
    Empty,
}

impl<T> Slot<T> {
    pub fn get_or(self: Slot<T>, other: T) -> T {
        match self {
            Slot::Full(v) => { return v; }
            Slot::Empty => { return other; }
        }
    }
}

fn first<T>(xs: Vec<T>) -> T {
    return xs.get(0);
}

fn zero<T>() -> T {
    return 0;
}

fn twice<T: Show>(v: T) -> str {
    return v.show() + v.show();
}

fn half(x: f64) -> Result<f64, str> {
    if x < 0.0 { return Result::Err("negative"); }
    return Result::Ok(x / 2.0);
}

fn quarter(x: f64) -> Result<f64, str> {
    val h: f64 = half(x).context("first half")?;
    return half(h);
}

fn main() -> i64 {
    var fs: Vec<f64> = Vec::new();
    fs.push(1.5);
    println(first(fs));
    var names: Vec<str> = Vec::new();
    names.push("ada");
    println(first(names));
    val z: i64 = zero();
    println(z);
    println(twice(Pt { x: 7 }));
    val o: Option<f64> = Option::Some(2.5);
    println(o.unwrap());
    println(o.unwrap_or(0.0) + 1.0);
    match o {
        Option::Some(v) => { println(v * 2.0); }
        Option::None => {}
    }
    val a: Slot<f64> = Slot::Full(0.25);
    val b: Slot<str> = Slot::Empty;
    println(a.get_or(9.0));
    println(b.get_or("empty"));
    match quarter(10.0) {
        Result::Ok(v) => { println(v); }
        Result::Err(e) => { println(e); }
    }
    match quarter(-1.0) {
        Result::Ok(v) => { println(v); }
        Result::Err(e) => { println(e); }
    }
    return 0;
}
