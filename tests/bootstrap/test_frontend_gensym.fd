// LG9: hygiene for `comptime gen`. `gensym("helper")` gives a name nothing
// in the program declares, so a generated helper cannot collide with (or
// replace) the program's own `helper`. Generated enums, constants and impl
// blocks are added to the program too (they were dropped silently).
// Expected output:
// 15
// 101
// 2
// 7
// 11

fn helper(n: i64) -> i64 { return n + 100; }

struct Counter { n: i64 }

fn main() -> i64 {
    comptime gen {
        val h = gensym("helper");
        return "fn " + h + "(n: i64) -> i64 { return n * 3; } fn triple(n: i64) -> i64 { return " + h + "(n); }";
    }
    println(triple(5));
    println(helper(1));

    comptime gen {
        return "enum Color { Red, Green } fn color_code(c: Color) -> i64 { var r: i64 = 0; match c { Color::Red => { r = 1; } Color::Green => { r = 2; } } return r; } fn green_code() -> i64 { return color_code(Color::Green); }";
    }
    println(green_code());

    comptime gen {
        return "const GEN_SEVEN: i64 = 7;";
    }
    println(GEN_SEVEN);

    comptime gen {
        return "impl Counter { pub fn bumped(self: Counter) -> i64 { return self.n + 1; } }";
    }
    val c = Counter { n: 10 };
    println(c.bumped());
    return 0;
}
