// MI17 (known-bugs 2g.95): an f32 value converted `as i64` / `as i32`.
// The saturating conversion compares the value with f32 constants (the
// i64 range's ends); pe_ir (the default Windows `fid emit`) wrote an f32
// constant as the low 32 bits of the f64's pattern (0.0 for 2^63), so every
// f32 went to i64::MAX or i64::MIN: id32(2.0) as i64 printed
// 9223372036854775807. Every backend prints the same.
//
// Expected output:
// 2
// 3
// -7
// 16777216
// 2147483647
// 9223372036854775807
// -9223372036854775808
// 0
// 41
// -41
// 1.5
// 0.10000000149011612
fn id32(x: f32) -> f32 {
    return x;
}

fn half(x: f32) -> f32 {
    return x / (2.0 as f32);
}

fn main() -> i64 {
    println(int_to_str(id32(2.0 as f32) as i64));
    println(int_to_str(id32(3.75 as f32) as i64));
    println(int_to_str(id32((0.0 - 7.5) as f32) as i64));
    println(int_to_str(id32(16777216.0 as f32) as i64));
    // out of range: saturated
    println(int_to_str(id32(1.0e10 as f32) as i32 as i64));
    println(int_to_str(id32(1.0e30 as f32) as i64));
    println(int_to_str(id32((0.0 - 1.0e30) as f32) as i64));
    val z: f32 = id32(0.0 as f32);
    // NaN goes to 0
    println(int_to_str((z / z) as i64));
    println(int_to_str(half(82.0 as f32) as i64));
    println(int_to_str(half((0.0 - 82.0) as f32) as i32 as i64));
    // an f32 constant read back as f64
    println(float_to_str(half(3.0 as f32) as f64));
    val c: f32 = 0.1 as f32;
    println(float_to_str(c as f64));
    return 0;
}
