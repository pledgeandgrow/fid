// llvm-roadmap TG12: object files from the machine layer's writer.
// nat_ir.fd nat_emit_object builds the image as for an executable and
// nat_enc.fd nat_elf_object writes it as a relocatable ELF64 object: one
// .text (code and data), a RELA relocation per absolute word, a local
// symbol per function and the global `fid_main`, the program's entry.
// Linked alone it is the program `fid emit` builds:
//   fid emit tests/bootstrap/test_nattools_object.fd --obj --target x86_64-linux -o o.o
//   ld -e fid_main o.o -o o && ./o
// (scripts/nat-tools-check.sh; the driver's --obj flag is main.fd's). The
// string table and the function-name table hold absolute words, so the
// output proves the relocations. Same output on every backend.
// Expected output:
// object: 3 parts
// sum 60

fn part(i: i64) -> i64 {
    return (i + 1) * 10;
}

fn main() {
    var parts: Vec<i64> = Vec::new();
    var i: i64 = 0;
    while i < 3 {
        parts.push(part(i));
        i = i + 1;
    }
    print("object: " + int_to_str(parts.len()) + " parts\n");
    var s: i64 = 0;
    var k: i64 = 0;
    while k < parts.len() {
        s = s + parts.get(k);
        k = k + 1;
    }
    print("sum " + int_to_str(s) + "\n");
}
