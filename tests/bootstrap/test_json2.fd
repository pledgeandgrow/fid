// Test: stdlib/json — validator, safe wrappers, keys/items, path, builders.
use json;
use vec;

fn bs(b: bool) -> str {
    if b { return "t"; }
    return "f";
}

fn main() -> i64 {
    // pure-Fides validator (never panics)
    println("v1 " + bs(json_is_valid("{\"a\":1,\"b\":[2,3]}")));
    println("v2 " + bs(!json_is_valid("{\"a\":1,")));
    println("v3 " + bs(!json_is_valid("{}x")));
    println("v4 " + bs(json_is_valid("  [ 1 , \"x\" , null ] ")));
    println("v5 " + bs(json_is_valid("\"esc \\\" q\"")));

    // safe wrappers
    println("t1 " + json_type_safe("{\"a\":1}"));
    println("t2 " + json_type_safe("nope"));

    var doc: str = "{\"user\":{\"name\":\"ada \\\"x\\\" lovelace\",\"age\":36},\"tags\":[\"a\",\"b\"],\"ok\":true}";
    println("g1 " + json_path(doc, "user.name"));
    println("g2 " + int_to_str(json_get_int(json_get_safe(doc, "user"), "age", 0)));
    println("g3 " + json_path(doc, "tags.1"));
    println("g4 " + bs(json_get_bool(doc, "ok", false)));
    println("g5 " + bs(str_len(json_path(doc, "user.zzz")) == 0));
    println("g6 " + json_get_str(doc, "missing"));
    println("g7 " + int_to_str(json_get_int(doc, "missing", 7)));

    // keys + items
    var ks: Vec = json_keys(doc);
    println("k1 " + int_to_str(ks.len()));
    var acc: str = "";
    var i: i64 = 0;
    while i < ks.len() {
        var k: str = ks.get(i);
        acc = acc + k + ",";
        i = i + 1;
    }
    println("k2 " + acc);
    println("k3 " + bs(json_has(doc, "tags")) + "|" + bs(json_has(doc, "zz")));

    var it: Vec = json_items("[1,\"a b\",{\"k\":2}]");
    println("i1 " + int_to_str(it.len()));

    // unescape
    println("u1 " + json_unescape("\"a\\nb\""));

    // builders
    var o: str = "{}";
    o = json_obj_set(o, "n", "1");
    o = json_obj_set(o, "s", json_string("hi \"q\""));
    o = json_obj_set(o, "n", "42");
    println("b1 " + o);
    var a: str = "[]";
    a = json_arr_push(a, "1");
    a = json_arr_push(a, "\"x\"");
    println("b2 " + a);

    println("p1 " + bs(str_len(json_pretty_safe("{}")) > 0));
    return 0;
}
